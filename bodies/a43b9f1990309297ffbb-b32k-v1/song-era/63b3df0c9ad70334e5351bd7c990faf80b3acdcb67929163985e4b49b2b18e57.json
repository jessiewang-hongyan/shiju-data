[{"title":"后苑赏花钓鱼应制","author":"宋祁","text":"清籞披兰路，雕舆眷蕙辰。\n汉池平浴日，温树暗留春。\n乐石来威凤，恩波上翠鳞。\n成文传睿唱，赓曲遍华绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吏上","author":"宋祁","text":"吏上重门钥，楼喧叠鼓挝。\n翠沈遥岭树，红敛暝丛花。\n杼促虫声急，眉拖月魄斜。\n烦心销热尽，不待镇嘉瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回郡将东还献梁相公","author":"宋祁","text":"留滞符鱼素领垂，十年方喜觐彤闱。\n平台雪罢邹阳老，宣室釐残贾谊归。\n疲马有情依枥叹，倦禽知困傍林飞。\n相君门下馀尘在，拥彗应容一叩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回堞","author":"宋祁","text":"回堞巑岏极，长天苍莽中。\n远溪寒不浪，高木暝饶风。\n栈廥休王马，枪累隔苑熊。\n残霞牵望眼，时到夕阳东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙抗寺丞宰晋陵","author":"宋祁","text":"旧笔刑丹燥，新辞苑雪妍。\n一名迟上月，再击始垂天。\n鹢首凌波稳，凫翁赐绶鲜。\n邑歌丰暇日，擿句暮争传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙沆从事宰吴兴邑","author":"宋祁","text":"舳尾东衔鸟羽轻，沧浪馀沫恣沾缨。\n尚沈幕府千人俊，却劝疁田二耦耕。\n莲有艳歌邀夕泛，蔗留佳境析朝酲。\n行行正及吴蚕咡，脆尽商弦别曲声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙景赴怀宁尉","author":"宋祁","text":"一行为吏日，千里背淮人。\n兰助朝昏膳，丝垂宛转纶。\n云容侵驿晓，江态引帆春。\n静治龙舒邑，氂生盗向秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙景随侍赴举","author":"宋祁","text":"蜡凤当筵占美名，文斋大被集时英。\n人同颍水将车乐，赋待尚书给笔成。\n乡酒出郊浮蚁釂，故林驰雾暝猿惊。\n省知唱第丛云幄，归梦因君到斗城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙集仙世领东海","author":"宋祁","text":"云岊苍郁照城郛，奕叶乡州拥使符。\n昼绣愈知今日贵，子庭犹忆向时趋。\n故新笥绶薰相续，前后郊棠影不孤。\n绛帐诸生今史氏，炙青容补世家无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守岁","author":"宋祁","text":"已觉新杓动，犹闻促漏馀。\n夜寒穷腊尾，春色并年初。\n事往成追计，身羁况索居。\n明朝为寿酒，无奈故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁除","author":"宋祁","text":"彫节真如借，良宵此向阑。\n家储宿岁酒，乡送大傩寒。\n旧卉回新物，来情续往欢。\n匆匆馀几刻，催具五辛盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚私感","author":"宋祁","text":"已嗟官落魄，更值岁峥嵘。\n一絓区中累，千惭谷口耕。\n休文偏恨瘦，夷甫太钟情。\n借问长安米，侏儒有底荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁稔务閒因美成都繁富","author":"宋祁","text":"岷峨俗美汉条宽，野实呈秋照露寒。\n卖剑得牛人息盗，乞浆逢酒里馀欢。\n锦波濯綵霞湔浦，硙浪催轮雪沸滩。\n告稔不须腾驿奏，自应铜爵报长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"州举俊民以艺中第为诗驰贺","author":"宋祁","text":"曾联郡将署乡书，目见函关卖出符。\n奏颂一挥云落纸，赐袍三浴蕙飘炉。\n高轩并照连乾锦，饮膳分颁萐莆厨。\n病幕日期迎昼绣，尘容甘预弩前驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"州将按行堤上","author":"宋祁","text":"十万堤封限迅流，腾装清晓径春畴。\n驻车楚老浆盈野，劝筑睢阳杵有讴。\n梅暖晚香薰宿馆，雪天零霰犯轻裘。\n桑郊剋日迎归旆，遥认骊驹最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巡视河防置酒晚归作二首 其二","author":"宋祁","text":"夹石双堤转，逍遥千骑留。\n川昏多昼雾，水落足寒洲。\n岸石危相倚，桥澌暮不流。\n风烟非渭曲，谁有钓璜钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巡视河防置酒晚归作二首 其一","author":"宋祁","text":"古戍连沙曲，层阿属岸隈。\n天长倦鸟没，山晚跛牂回。\n斜日低官树，轻寒犯客杯。\n还城闻暮角，三叠落江梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庄懿皇太后哀挽应制二首 其二","author":"宋祁","text":"遗馔行将彻，哀笳咽不前。\n风惊长乐树，月苦鲋隅天。\n恤典袆章备，神涂騩驾联。\n故奁脂泽具，留待上陵年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庄懿皇太后哀挽应制二首 其一","author":"宋祁","text":"国启重雍祚，天推太极尊。\n夏祠今化石，尧母旧题门。\n不待寒泉养，空流渭水恩。\n烝哉王者孝，别庙奉姜嫄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆历初召为学士岁馀罢久之出守凡三十年还拜承旨感而成咏","author":"宋祁","text":"十八年前玷玉堂，当时绿发此苍苍。\n伤禽纵奋愁疮重，厩马虽还笑齿长。\n薰罢山炉飘暗烬，漱馀铜碗冰寒浆。\n须惭清切銮坡地，不是吾人得性场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"当直偶题所见","author":"宋祁","text":"凛序闲缇籥，轻寒著黼帷。\n仙盘迎日早，温树得霜迟。\n风触趋朝佩，霞缠放仗旗。\n殿廊聊暴背，谁讶子云衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都","author":"宋祁","text":"风物繁雄古奥区，十年伧父巧论都。\n云藏海客星间石，花识文君酒处垆。\n两剑作关屏对绕，二江联派练平铺。\n此时全盛超西汉，还有渊云抒颂无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬雄墨池","author":"宋祁","text":"宅废经池在，人亡墨溜乾。\n蟾蜍兼滴破，科斗共书残。\n蠹罢芸犹翠，蒸馀竹自寒。\n他杨无可问，抚物费长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早发","author":"宋祁","text":"征客怀周道，飘然望日畿。\n天开阊阖近，星隐建章微。\n王囿刍荛往，駉原騋牝归。\n讵能同野鸟，朝夕向台飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早发途中","author":"宋祁","text":"六幕星翻斗转车，揽衣王粲更离家。\n孤城随月三挝鼓，碧树啼烟九子鸦。\n独望残云愁霰雪，暂闻长笛忆京华。\n霞朝莫问离怀苦，带眼愁多只有赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春 其二","author":"宋祁","text":"鹍雪锁平苑，乌风袅迥竿。\n暖容侵柳动，寒意向梅残。\n云薄来无定，天晴望更宽。\n杯霞莫辞醉，朝野日多欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春出近郊","author":"宋祁","text":"回望三条接上兰，野霏山秀似堪餐。\n冰翻断影回鱼暖，云作轻阴借雁寒。\n即席缥清宜玉斝，何人苏合费金丸。\n风长麦浅如皋路，雉子斑斑锦羽乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春夙兴","author":"宋祁","text":"晓参横没月沉烟，寺鼓军刀隐隐连。\n初暖欲归池中地，剩寒犹属陇梅天。\n遥帷曙气春篝烛，病榻邪风袭贡绵。\n犹意王筠斋壁咏，玉蝫霏溜破霞笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋","author":"宋祁","text":"脱叶惊彫岁，翻车送落晖。\n蔗浆晨渴减，桃簟夜凉归。\n怨月收纨扇，轻云怯纻衣。\n沈愁知几许，带眼不胜围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋二首 其二","author":"宋祁","text":"落照临风细细寒，已收纹簟未收纨。\n山中桂老初含紫，泽上枫多并是丹。\n月过河桥低映榭，露从霄极暗供盘。\n何人刻意离忧苦，不字灵均即姓潘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋二首 其一","author":"宋祁","text":"月夜亭皋秋气生，又从摇落到峥嵘。\n寒花尚作茸茸密，晚叶偏能飒飒鸣。\n对把蟹螯何处酒，怅怀莼菜此时羹。\n西风万里吹斑鬓，可待中郎丽赋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋夜坐","author":"宋祁","text":"穹旻炎?歇，颢气袭中闺。\n倦鹊兼河转，初蟾共月西。\n客愁无处所，世虑足端倪。\n清客才成泫，皋禽且稳栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旬休 其一","author":"宋祁","text":"火云叠影抱炎曦，沾沐身閒与胜宜。\n卷叶初开芰荷沼，轻房半系石榴枝。\n茶枪早翠吟魂适，蔗境馀佳渴肺知。\n汗马属鞬非我事，到头攘臂是支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旬休 其三","author":"宋祁","text":"散带家居首任蓬，闭关穷巷避雌风。\n官非言责如馀裕，流在儒家觉少功。\n慢态已成书几积，黠姿无半画厨空。\n此生信有天年乐，堪置蒙庄大社中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旬休 其二","author":"宋祁","text":"门依北郭最閒坊，休令归来白昼长。\n司马苦消非我事，次公无酒是真狂。\n午鸡初下繁阴合，梦蝶徐翻倦枕凉。\n自笑此生疲挟筴，不知呼塞亦亡羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旬沐二首 其二","author":"宋祁","text":"待诏官非急，还家体不勤。\n里无休汝骑，窗有上羲人。\n密树稍迎夏，晚花犹及春。\n幽怀谁与晤，杯酒强相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旬沐二首 其一","author":"宋祁","text":"薄浣还私室，陶嘉属小园。\n笋馀林向密，花后果初繁。\n燕口将泥重，蜂脾抱蜜喧。\n此时萧散意，都欲忘乘轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲幌","author":"宋祁","text":"曲幌囊风入，前轩峡雨收。\n醉罗初解夕，珍簟暗知秋。\n衰柳金城恨，幽兰楚国愁。\n更堪闻短笛，圭月在西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀旧隐","author":"宋祁","text":"官事未易了，田家胡不归。\n烟原射雉乐，春糁养鱼肥。\n菜密成岩幄，萝长代石衣。\n无为落吾事，坐老故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀宫保庞相公","author":"宋祁","text":"木正乘春肯告劳，并持葱郁护神皋。\n晓风递暖何妨细，宿雨留云未许高。\n向密垂杨能碍箭，斗长芳草欲争袍。\n东城胜具应撩治，就趁寻花作宴醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀寄同舍","author":"宋祁","text":"不为秋归人未归，淮南又见叶丹时。\n汉皇好少身今老，楚客愁醒啜始醨。\n夕栈长风惊代马，晓天团露怨江蓠。\n夫君去我犹千里，万虑劳劳欲语谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀谢炳宗先辈","author":"宋祁","text":"凄霜刮野转蓬乾，永忆江湖旅鬓残。\n身有支离求病粟，爵无公乘免旒冠。\n柴车路迥骖驴蹇，栗坞人稀溜鹊寒。\n日暮浮云遍西北，客心悽断向长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有诏换淮阳","author":"宋祁","text":"比出淮阳守，今移寰内州。\n真无弱翁治，只是茂陵求。\n换节矜新假，循襟释故愁。\n桑榆知未晚，前失庶能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有诏解郡作 其二","author":"宋祁","text":"尘晦荷囊裂旧缝，惊闻台召计匆匆。\n忽从楚水枫林下，还入甘泉豹尾中。\n即日遂收西望涕，方春便趁北归鸿。\n休誇四入高凉地，已是人间素领翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有诏解郡作 其一","author":"宋祁","text":"二年憔悴拥州旂，尺诏初容觐帝晖。\n何幸复燃灰不死，未应为失马重归。\n蛟螭对舞瞻层阁，翁仲双扶识故扉。\n病骨多忧黧黑甚，豫惭台史与薰衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"宋祁","text":"车辙无声巷次閒，畸人愁卧鬓毛班。\n月囊罢食侏儒米，岁计深依嵔垒山。\n风薄回林秋蒂老，天围荒堞暝乌还。\n举头却望长安日，已在浮云沆漭閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"宋祁","text":"力守高皇约，祈还司隶章。\n翻身去殿槛，忍死出缣囊。\n豕突埋轮路，豺骄择肉场。\n霜毫墨犹湿，迢递窜遐方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱舜卿归自别墅","author":"宋祁","text":"逍遥初服偃郊扉，学舍经旬望贡綦。\n庾信移谈思讲树，周颙回驾避低枝。\n摛华更喜联新唱，散秩犹烦瑩旧疑。\n欲序三都先自愧，士安风痹素清羸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱舜卿南游有寄","author":"宋祁","text":"汉皋烟浪泼醅春，弭节江干一问津。\n南浦草平偏送客，大堤花晚欲留人。\n归心怨逐摇摇旆，尺素愁迷六六鳞。\n湘册聚萤嵇几静，露轩香粉暗书筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次江都 其一","author":"宋祁","text":"道险疑无地，岩高欲近天。\n家收代田粟，官铸即山钱。\n云变阴晴候，林容旦暮烟。\n落花真有意，时解拂行鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次江都 其二","author":"宋祁","text":"江溜滩滩急，崖腰栈栈新。\n天深罕见日，路险不容尘。\n远草夤缘绿，幽花落漠春。\n逢津何必问，夫我自知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次剑门","author":"宋祁","text":"昔驱千骑往，今解五鱼还。\n谁惮老销髀，自怜生入关。\n春风来迥野，晓斗挂空山。\n却整康成帢，依然愧腻颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次梓潼","author":"宋祁","text":"行行芳序深，秀色媚诸岑。\n早叶易经吹，暖云难久阴。\n拥条孤狖啸，戏荇一凫沈。\n不是无樽酒，其谁共献斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵天平观文庞相公以久留塞下见寄","author":"宋祁","text":"昔驾轺封北护边，已惭星鬓久凋年。\n御炉香外抛晨谒，刁斗声中废夜眠。\n梁雪送残他日赋，郭舟谁共此时仙。\n思归未敢贻公念，更办秋怀敌露蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宫师相公答太傅相公秋书","author":"宋祁","text":"岩树萧萧秋兴归，师臣仍此褫朝衣。\n羽觞聊欲同宾寿，玉体何曾待战肥。\n风圃薄寒浮醉衽，雨荥新浪拍渔矶。\n清篇自有夔龙旧，方外相从屏世机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上送客","author":"宋祁","text":"十里长皋五里亭，天涯送月泪缘缨。\n洛辞但许凌波渡，桃曲犹烦用楫迎。\n远信即时劳裂素，客心何日免摇旌。\n芳晨莫遣归期晚，碧草江南正乱莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江休复潞掾","author":"宋祁","text":"君家能赋别，释褐重凄然。\n客袂移缁素，离杯并圣贤。\n坐曹烦折狱，奏牍伫怀铅。\n十载青袍困，须饶草色鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南木芙蓉张子春云其高如树中山地寒才数尺花瘠色淡八月已开","author":"宋祁","text":"江南高比树，塞北仅成丛。\n向晚谁争艳，防寒浅作红。\n弄条风淅淅，衔蕊蝶匆匆。\n且作黄花伴，无令叹斝空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江夏黄孝恭数遗新诗因以是答","author":"宋祁","text":"万里江南客，三年泽畔身。\n惊弦已疮雁，涸辙欲穷鳞。\n日月奔腾晚，烟花感慨春。\n谁能为此曲，无乃数奇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江渎池亭","author":"宋祁","text":"一翚掀翅压溪隅，吏事初閒此晏居。\n断岸有时通略彴，轻风尽日战栟榈。\n云鸿送目挥弦后，客板看山拄颊馀。\n芰碧蒲青来更数，江人多识使君旟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上 其一","author":"宋祁","text":"晚瞩西池上，池清暑气微。\n云烟互明灭，蒲荇两因依。\n戏鰋来无定，眠凫久自飞。\n纷吾刀笔虑，逢此憺忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上 其二","author":"宋祁","text":"雨止菰蒲老，风生杜若秋。\n水光晴动日，莲气晚薰舟。\n暗坞飞萤出，疏丛白鸟留。\n此时成丽赋，宁减玩游鯈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕在告闻游人甚盛","author":"宋祁","text":"火树缯山凤阙前，皇都美景属新年。\n烟花并作长春国，日月潜移不夜天。\n道上落梅飘脆管，陌头繁杏著游鞯。\n须知钧会人同乐，莫叹秦侯抱疾眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老去","author":"宋祁","text":"老去惯摇落，第看芳岁阴。\n穗残饥鸟集，荷破曝龟沈。\n远岫多馀紫，寒溪有定浔。\n残蝉何所畏，缄口抱秋林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老还","author":"宋祁","text":"老还东观复怀铅，坐对秋风鬓飒然。\n怨曲未平曾破瑟，故疮虽愈尚惊弦。\n萧条门巷张罗外，阒寂曹司搁笔前。\n借问不才为累否，古来山水尽天年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自讼 其一","author":"宋祁","text":"史藁虽残得自随，兵符未解定堪蚩。\n淹留正似周南老，戏剧何争灞上儿。\n铅笔用多毛秃落，鬓髯愁罢雪纷垂。\n十年尚滞成书奏，可验相如属思迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自讼 其二","author":"宋祁","text":"有人多病卧遥帷，误舍寒耕失故畦。\n每畏宾朋嘲乘雁，宁教子弟爱家鸡。\n淹中学废心都塞，辕下鸣馀耳更低。\n自顾上恩无一报，何颜岁晚望金闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]