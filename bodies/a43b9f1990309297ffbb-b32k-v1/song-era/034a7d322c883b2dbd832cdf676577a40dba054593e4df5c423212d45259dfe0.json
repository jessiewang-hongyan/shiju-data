[{"title":"杨备永嘉市征","author":"宋祁","text":"汉祀坛边望画衣，故人杯酒怨歌骊。\n几枝北道梅传信，一味南方桂补羸。\n后雨蒸青贻素业，旧塘生草继妍辞。\n他年第颂归何处，名应唐家十二时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨都官日严赴郓州","author":"宋祁","text":"连年三换左朱轮，正用台郎第二人。\n帷殿程书清刻永，家床添笏赐袍新。\n润波仍跨洪河曲，敏政将肥瘠鲁民。\n趣引前旌向桑野，汉皇恩诏重方春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步药北园","author":"宋祁","text":"倦持尘簿著纶巾，清眺城隅夏物新。\n幽鹭仪容高似客，晚莺言语巧于人。\n雨边斜照犹衔岭，风后馀凉自舞蘋。\n天借使君仁智地，此来山水更相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"宋祁","text":"逃腊藏深柢，乘春发故荄。\n雨障单盖侧，风偃半旗开。\n脆理缯争裂，斜规扇欲裁。\n无坚喻浮世，金粟信多才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"言志","author":"宋祁","text":"志岂观非圣，才犹耻壮夫。\n穷愁五经笥，感慨八驺呼。\n昔隐思投耒，今行誓裂繻。\n莫邪方有请，谁为鼓洪炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还都","author":"宋祁","text":"一封东走罢州麾，却趁清班上赤墀。\n侍史香炉留直夜，王孙春草见归时。\n虚名所赖天藏拙，晚岁无如病与衰。\n要在属车何所用，只堪盛酒比鸱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远行","author":"宋祁","text":"平原已超忽，山径亦纡馀。\n匹练迷征马，孤蓬伴客车。\n江枫极目外，陇水断肠初。\n行行不顾返，秋露泫人裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连秀才东归","author":"宋祁","text":"烟树遍云中，迎君马首东。\n鸣鸡关下晓，归鸟汉阳穷。\n倦客辞城阙，深耕托灌丛。\n还将数日恶，故故恼衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邑外晚景","author":"宋祁","text":"林梢规日透霞鲜，滞穗累累遍大田。\n豺口祭馀开猎禁，豚蹄祝罢得逢年。\n云容不动寒垂地，陂影无涯静合天。\n一国似狂予独尔，长吟饥腹伴残蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邑居","author":"宋祁","text":"暖褫貂裘病骨轻，茨檐穷伏废将迎。\n庖人投刃喧羊肆，溪子擎牙近禁营。\n云破日痕絙巘道，雨残烟脚媚荑英。\n传闻内史轻租契，私约吾农对耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邻亭真","author":"宋祁","text":"蕊馆何年记旧封，宴亭此日驻凭熊。\n佛螺近作临窗岫，仙驭遥添拂衽风。\n谈树憩棠交结荫，飞翚贺雀并翻空。\n使君邀胜留千骑，可在秦楼更向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰九月九日登高有感","author":"宋祁","text":"隔霜云叶绕天愁，闰节重来续旧游。\n赋客岂辞聊暇日，楚人无奈剩悲秋。\n寒萸实老犹薰佩，晚菊香残不占瓯。\n怅忆故园归信断，渚鸿川鲤两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰月晦日","author":"宋祁","text":"春物都城晚，欢游一倍慵。\n轻风生树态，暖日淡云容。\n小阁时翻燕，閒花更少蜂。\n幽襟真濩落，所得是无悰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰正月二十五日送客寻春集裴氏园","author":"宋祁","text":"寻春送客共留连，雨罢春郊物物妍。\n黄抹柳梢初遍后，紫粘花萼未开前。\n朋襟自为交欢悴，醉斝谁能辨圣贤。\n犹赖斜阳催跋马，不然离恨损丝弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陇州鱼龙川石鱼","author":"宋祁","text":"纤鳞藏介石，物化自何年。\n无复西江水，长依东海田。\n苔纹堪代藻，云叶即成莲。\n琥珀藏蚊影，佳名共此传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陇西都尉禅会图","author":"宋祁","text":"宴场禅集盛，霜幅绘毫工。\n竺社同开叶，嵇姿宛送鸿。\n法身宁滞相，世眼愿瞻风。\n厨钥方传宝，非专岩壑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈奉礼宰四明","author":"宋祁","text":"大庭联袂掞英华，龙凤池名在一家。\n雁塔墨痕鸰继序，桂林春色棣交花。\n袍薰茂草萋萋远，樯竖归风栉栉斜。\n灵越弦歌皆胜践，递赓清思赋馀霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈济赴举兼省觐","author":"宋祁","text":"相从同是日边人，两见江南碧草生。\n冯铗车鱼初倦客，梁山风雨苦思亲。\n虹桥刻柱前盟苦，兽锦裁囊丽曲新。\n袍雪纷纷君莫顾，汉皇终自识平津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侨庑","author":"宋祁","text":"瞿昙少病否，司寇正归欤。\n不凿墙坯遁，犹烦里旅居。\n饭舂霜棱粟，羹糁雪畦蔬。\n愿受为氓籍，閒披种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侨居二首 其二","author":"宋祁","text":"公宇静寥寥，居然俗意销。\n屐閒谁记齿，带适自忘腰。\n亩首秋残穫，城西日暮樵。\n比来行乐熟，随意度溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侨居二首 其一","author":"宋祁","text":"抱病苦幽忧，都城困倦游。\n身抛秃翁版，言入稗家流。\n世路风波恶，天涯日月遒。\n危心正无泊，持底喻穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侨屋睹燕葺旧巢因赠","author":"宋祁","text":"穷檐双越燕，一再共年华。\n巢户差眠尾，泥痕燥哺花。\n惜无文杏庇，犹免翠帘遮。\n所赖同鸡德，新丰遂识家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兔","author":"宋祁","text":"脱兔驰冈地，饥鹰厉吻天。\n为烦麋狗顾，遂给兽人鲜。\n狂目兼槐落，惊毫共月捐。\n可嗟多狡穴，归肉助庖膻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到官三岁四首 其四","author":"宋祁","text":"塞下静无事，军中奚告劳。\n青山侧身远，白日举头高。\n作奏閒双笔，流年耗二毛。\n惟应不能饮，元解读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到官三岁四首 其三","author":"宋祁","text":"儒帅非真帅，瓜时定几时。\n丹心虽许壮，白发不藏衰。\n罟密游鳞骇，山遥倦翼迟。\n岁成无奏最，准拟雁门踦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到官三岁四首 其二","author":"宋祁","text":"一忝中山守，仍班第四春。\n老应无所事，少尚不如人。\n适野愚谋短，将芜旧产贫。\n须惭丈二组，羁束最慵身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到官三岁四首 其一","author":"宋祁","text":"芳岁已三换，宠名仍再迁。\n生平一丘壑，衰晚右櫜鞬。\n客眼登楼外，乡愁把酒前。\n巾箱多旧赋，只是欠归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十九日湖上与张集贤饯提刑张都官韵","author":"宋祁","text":"共凭高榭眺云波，使节将归可奈何。\n醇酒暂留丞相饮，骊驹愁对主人歌。\n千岩日下催云合，万里风长送雁过。\n兹会难言须惜别，岁阴光景玩蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和三司晏尚书西园暇日","author":"宋祁","text":"阴阴嘉树杂花残，下畹行吟静更欢。\n草叶参差聊藉带，竹皮纷堕即为冠。\n馀杯更辨浮冰酎，小衽初思御月纨。\n公有吾庐无限爱，海图周传不同看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和小饮","author":"宋祁","text":"天帟暮云消，飞觞夜正遥。\n洛吟聊拥鼻，陶舞惜回腰。\n露晓蝉嘶树，河秋鹊映桥。\n客欢殊未几，离恨又霞朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天休舍人奉祠太一宫见寄","author":"宋祁","text":"顺祝斋琳馆，翛然隔世埃。\n空歌灵鹄下，祠节宝鸡来。\n瑞木千寻竦，仙图几卷开。\n如无清夜唱，谁识帝车回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王龙图七夕直宿","author":"宋祁","text":"二星秋早驾云车，此夕闻君寓直庐。\n月在宫中穿线处，香传楼下曝衣馀。\n桥乌径度明河近，巢凤归翻暝阁虚。\n寂寞潜郎谁晤语，只应藜烛伴雠书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶道卿连日阴曀坐曹无绪见寄","author":"宋祁","text":"雾著青旗燕尾斜，轻阴连日遍天涯。\n上林已暖先催雁，细柳犹疏不碍鸦。\n积润未妨铿画瑟，薄寒仍欲定流霞。\n问君何事贪官事，只倚雕章念岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丞相小园雨霁","author":"宋祁","text":"霁碧凝天宙，规红转日车。\n鹊轻来燥蘖，蜂湿抱寒花。\n林果高仍在，菹菘晚自嘉。\n须知穷僻处，要是酂侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丞相晨谒书所见","author":"宋祁","text":"北阙天深报漏迟，台鸾雍鹭共逶迤。\n廷风细引趋班佩，宫日遥烘簇仗旗。\n侍史有香来洞案，直郎无奏伏丹墀。\n殊邻竞献朝正玉，定是东风入律时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和延州庞龙图见寄","author":"宋祁","text":"交戟多年著皂衣，乞州初逐阮咸麾。\n惊残鸟翮虚弓笑，倾尽葵心白日知。\n宿莽骚人传丽赋，女萝山鬼赛丛祠。\n自惭念旧殊非计，正是朋游掉臂时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱少府苦雨","author":"宋祁","text":"滞淹连春晦，层阴接夜分。\n骁壶惟发电，愁栋但生云。\n里突居无爨，官蛙坐厌闻。\n遥知霖唱罢，客思转相纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯氏小疾原韵","author":"宋祁","text":"握臂苦愔愔，苍华倦昼簪。\n悟非蘧瑗早，达想净名深。\n齐鹿闲三㰅，仙图戏一禽。\n独应吴客问，眉宇识侵淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴侍郎朝谒天庆宫","author":"宋祁","text":"上路鸣驺远，丛霄故馆开。\n华簪尧豸出，轻舄汉凫来。\n探妙云敷笈，蠲烦露溢杯。\n直须重缔约，飞盖一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李屯田西湖寻春","author":"宋祁","text":"把酒同寻湖畔春，赏心何况更良辰。\n留阴岸雨溥红杏，送暖汀风恼绿蘋。\n低写卧虹桥齿密，小装文鹢舫头新。\n聚星亭上华簪客，即是高阳旧里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨学士同晏尚书西园对菊","author":"宋祁","text":"岁秋无异卉，佳菊自成妍。\n薄采称觞客，繁开落帽天。\n抱池閒沮洳，留蝶小翩翾。\n为结胡公赏，并怀郦水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和季长学士绵汉道中作","author":"宋祁","text":"一辔澄清暂按州，却因风景独夷犹。\n弦残汉月驺前晓，粉叠巴云盖外秋。\n持节频年烦出使，富民虚日待封侯。\n省纡丽藻嗟行役，正恐才多剩四愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和枢密晏太尉元日雪","author":"宋祁","text":"寒云万里送残宵，面旋祥霙集岁朝。\n繁影未能藏夜燎，薄花仍欲伴春椒。\n光含象阙苍龙舞，气勒交衢卓马骄。\n丰兆欢歌谁不尔，百官兼放五门朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宫师陈相公","author":"宋祁","text":"公辞四辅贵，才营三亩园。\n此地山林乐，当年廊庙尊。\n庭蘤有新复，郊禽无近翻。\n孰喻治穷僻，乃符萧相言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宫师相公待制庞学士贤年二韵续川然两字","author":"宋祁","text":"龙楼一品亚台联，佚老归来帝养贤。\n商皓岭芝追隐伴，胡公潭菊得高年。\n客盘梅熟经调鼎，宴渚舟横旧济川。\n延阁裁章纡和曲，玉音风驭共泠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和待制庞学士寄献宫师相公之作","author":"宋祁","text":"溢荥清溜接家田，白首辞荣铉席贤。\n直使斯人歌画法，后容吾党记归年。\n五禽习戏探仙术，万法观空證佛缘。\n闻道岩溪春更好，许谁飞盖奉周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵南正溪上二首 其二","author":"宋祁","text":"一樽狂计即留春，更把诗篇恼使君。\n绕岸正摇千步柳，归山曾约万重云。\n孤怀欲写情空感，佳句相酬自不群。\n怯见杜潘无处避，便知优劣此间分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵南正溪上二首 其一","author":"宋祁","text":"年少青春苦惜春，溪头风物更留君。\n无花地展如茵草，欲雨天垂似鹤云。\n船近鹅儿频引颈，水清鱼子忽分群。\n吟情饮量皆豪俊，酒盏须斟一百分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和夏推官奉太夫人就养仲氏次韵","author":"宋祁","text":"盛府从军日，大家随子初。\n伯兮均洁膳，仲也庆将舆。\n雾舍嵩尘薄，霜程巩树疏。\n循陔传咏切，匪夕伫归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏公圜丘诗","author":"宋祁","text":"仗外鲜云敛夕容，跸声遥下紫营东。\n迎神秘座摐金密，啜食清坛烈火红。\n七萃禁戈攒月冷，万侯朝璧照霜空。\n天心帝意通欢豫，并在柴薰缥缈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉早夏","author":"宋祁","text":"寂寥春蘤尽，岑蔚夏阴稠。\n舌反禽稀弄，头昂麦并秋。\n直宜处台榭，稍欲厌巾㡚。\n可待蒲葵直，思从谢傅游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉怀寄燕侍郎","author":"宋祁","text":"赐车高挂得长闲，犹寄南宫事下官。\n招隐新君无怨鹤，趋朝旧路记翔鸾。\n沧浪濯罢垂缨懒，礧磈浇馀著酒宽。\n行到昔人知足地，羡君容膝易为安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉晚夏","author":"宋祁","text":"炎威不可度，永昼坐南轩。\n蚁过閒占雨，蝇来自厌樊。\n林披众果熟，池静数荷翻。\n早晚鞲鹰习，乘秋击迥原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏尚书海棠","author":"宋祁","text":"媚柯攒仄倚春晖，封植宁同北枳移。\n台岭分霞争抱萼，蜀宫裁锦斗缠枝。\n不忧轻露蒙时润，正恨炎风猎处危。\n把酒凭栏堪并赏，莫容私恨为披离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏相公夜归遇雪","author":"宋祁","text":"孝王台下糅花飞，草草归骖骤碧啼。\n斗作暝寒凌冒絮，更回馀舞拂鄣泥。\n城连迥阙迷苍凤，人度长桥压素霓。\n颓玉正酣天幕静，不妨清思入新题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏相公乘舆宿殿致斋日巡仗遇雪","author":"宋祁","text":"天京飞雪洒车装，九九清尘御路长。\n斜影不迷宣曲骑，薄花才点羽林枪。\n观边丽色含鳷鹊，盖外轻阴亚凤凰。\n谁识宪驺巡趠盛，赐袍冲霰入林光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和致政燕侍郎舟中寄晏尚书","author":"宋祁","text":"异时仙阁对三休，顿首辞荣动邃旒。\n疏广故僚供祖帐，鸱夷尽室付归舟。\n谢阶生玉怀欢宴，燕壁图山代远游。\n新句渐高尘累少，紫微岩曲要相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道卿舍人奉祠太一斋宫 其一","author":"宋祁","text":"素秋来蕊馆，瑞祝达霄晨。\n蘋荐祠无饩，楼居地不尘。\n掷波琴鲤乐，傍畤汉鸡驯。\n此际清怀极，盈杯沆瀣津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道卿舍人奉祠太一斋宫 其二","author":"宋祁","text":"尘氛不可到，深注五城楼。\n素瑟少今韵，仙春无俗秋。\n晨杯三秀洁，夜檠九光流。\n顺报通霄极，纷纶瑞福遒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道卿舍人奉祠太一斋宫 其三","author":"宋祁","text":"地占丛霄胜，人持禁橐来。\n诗长清夜遍，祠罢素秋回。\n爽籁天中发，虚弦月际开。\n无容以风解，身自到蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遥见归舟","author":"宋祁","text":"帆在天边客倚楼，此时相望最离忧。\n星槎路远迷全影，绣被香遥认半讴。\n不见鲛盘休坠涕，莫逢莲叶更障羞。\n石城艇子知非是，始信无愁果有愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和鉴宗游南禅别墅","author":"宋祁","text":"鹿园开别墅，牛驾此回轮。\n花识庄严界，林容宴坐人。\n远烟时误晚，静坞若遗春。\n共照前溪水，烦师洗六尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏怀二首 其二","author":"宋祁","text":"尽信书奚信，难言命敢言。\n竟谁成简册，无客问乾坤。\n值狩麟犹泣，遭君鹤乃轩。\n滔滔千古事，惟有付芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏怀二首 其一","author":"宋祁","text":"荣愿日云暮，安论轻且肥。\n嵇慵元抱病，蘧晚况知非。\n饵落愁鱼嗅，巢成羡鸟归。\n吾生江海志，终不与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏苔","author":"宋祁","text":"雨墙苍晕合，烟渚碧纹通。\n赋阁并尘掩，诗阶伴药红。\n萍流烦结实，絮乱枉因风。\n少閟回肠恨，春闺隔岁空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏酒壶","author":"宋祁","text":"刻像小蹁跹，无情是所怜。\n客欢迎指顾，觞冷寄回旋。\n屡转疑投节，将休似取妍。\n劳君戢深意，醒者勿须传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏菊","author":"宋祁","text":"寿客若为情，风流友曲生。\n殿秋安晚节，为隐被香名。\n曼衍南阳种，凄凉楚泽英。\n见山应自语，今古几渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]