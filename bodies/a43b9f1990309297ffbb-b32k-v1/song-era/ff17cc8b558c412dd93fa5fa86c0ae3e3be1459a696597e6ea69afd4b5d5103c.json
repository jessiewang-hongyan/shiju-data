[{"title":"寄空禅师","author":"曾几","text":"江西句法空公得，一向逃禅挽不回。\n深密伽陀妙天下，无人知道派中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅坡","author":"曾几","text":"被雪一枝好，令人双眼明。\n未须贪结子，对汝不胜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿毛龟","author":"曾几","text":"若为介物成毛物，颜色挼蓝省见稀。\n定是多生捕鱼子，至今犹著绿蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后月窗戏题","author":"曾几","text":"青女翻空一笑开，天花散尽更徘徊。\n嫦娥相与有瓜葛，也向读书窗下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴","author":"曾几","text":"未快溪桥踏雪心，朝阳已复上遥岑。\n可怜昨夜琼瑶迹，化作春泥尺许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄香梅","author":"曾几","text":"雪里何人作道装，冰绡重叠色鹅黄。\n染时定著蔷薇露，雨洗风吹故自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食日诵老杜示宗文宗武诗寄二子","author":"曾几","text":"衰年寒食又清明，攲枕诗成字不成。\n欲寄宗文与宗武，一春风雨大江横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓轩","author":"曾几","text":"故国例卜宅，他乡多惜居。\n短长三万日，何处是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾宏甫见过因问讯鞓红花则云已落矣惊呼之馀戏成三首 其三","author":"曾几","text":"南渡年来两鬓霜，牡丹芍药但他乡。\n即从江水浮淮水，便上维扬向洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾宏甫见过因问讯鞓红花则云已落矣惊呼之馀戏成三首 其二","author":"曾几","text":"不令老眼看鞓红，岂是青春不负公。\n尚有扬州风物在，亦防此段并成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾宏甫见过因问讯鞓红花则云已落矣惊呼之馀戏成三首 其一","author":"曾几","text":"茶山老子竟成痴，漫说寻芳去不迟。\n浪蕊飘残犹自可，名花落尽不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾宏甫饷溪山堂南坡胯新茶","author":"曾几","text":"溪山宝胯能分我，不但禅房破睡魔。\n便觉胸中有丘壑，免教辛苦上南坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游张公善权二洞四首 其四","author":"曾几","text":"善权石状说不尽，怪怪奇奇惊倒人。\n大屋脩廊岩下路，凄风冷雨洞中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游张公善权二洞四首 其三","author":"曾几","text":"自疑身是洞中仙，才出张公又善权。\n只道石田无用处，种成玉粒至今传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游张公善权二洞四首 其二","author":"曾几","text":"缦缨乳盖张公洞，风驭云軿定不无。\n勿以衰翁作生客，旧时相识选仙图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游张公善权二洞四首 其一","author":"曾几","text":"此邦胜处名天下，今日争来入眼中。\n筇杖一枝舟一叶，山行冲雨水冲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏山一览亭","author":"曾几","text":"青云梯尽得朱栏，不但令人六月寒。\n无限江南好山水，庵摩勒果掌中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽声四首 其四","author":"曾几","text":"有酒如淮肉如坻，何如麦饭滑流匙。\n但看此物丰登日，即是侬家快活时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽声四首 其三","author":"曾几","text":"春泥滑滑强知时，野日荒荒已露机。\n政与鹁鸠同一律，朝来唤得阿姑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽声四首 其二","author":"曾几","text":"幽禽竟日引圆吭，脱裤催人有底忙。\n不但春天无衣著，凄风冷雨绝须防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽声四首 其一","author":"曾几","text":"劝我行沽聒昼眠，看人烂醉买江天。\n兴来亦欲提壶去，未有苏公乞酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢宜春宰黄时举惠冬笋二首 其二","author":"曾几","text":"竹底春从雪底归，烦君抱送玉婴儿。\n白头无复迎船喜，只供江鱼作许悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢宜春宰黄时举惠冬笋二首 其一","author":"曾几","text":"此君老去犹停雪，稚子生来亦耐寒。\n记得长蔬山谷老，三珍错落粲同盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑侍郎饷酒二首 其二","author":"曾几","text":"鸣鞭走送徒纷然，开尝政足甜中边。\n甘辛未省有如许，气压烂柯山下泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢郑侍郎饷酒二首 其一","author":"曾几","text":"尊中政尔空空然，忽有一壶来眼边。\n君知情快何所似，石涧怒流深夜泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢送蜡梅二首 其二","author":"曾几","text":"化工团蜡作寒梅，绝胜牛酥点滴开。\n不是前村深雪里，蜜蜂应认暗香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢送蜡梅二首 其一","author":"曾几","text":"天将何物染江梅，白玉花成栗玉开。\n一种暗香全似旧，小罂和雪送春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢寄端砚四首 其四","author":"曾几","text":"管城子挟秋霜气，绛县人含松壑风。\n不是端溪石居士，分甘弃置一生中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢寄端砚四首 其三","author":"曾几","text":"治中长啸得石砚，乞与衰翁一笑开。\n小试松煤便终日，必知渠是下碞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢寄端砚四首 其二","author":"曾几","text":"名声藉甚端溪砚，何况珍材琢下碞。\n兔颖麝煤俱惬当，使君裁鉴果超凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢寄端砚四首 其一","author":"曾几","text":"我居南楚君南越，遣骑持书致石泓。\n未识松煤先一笑，向人鸲鹆眼能明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢路宪送蟹","author":"曾几","text":"从来叹赏内黄侯，风味尊前第一流。\n秖合蹒跚赴汤鼎，不须辛苦上糟丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道逢王左丞不及避谢之二首 其二","author":"曾几","text":"黄童白叟趁虚回，左辖车前拨不开。\n记得绿槐阴御路，万人辟易绣鞍来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道逢王左丞不及避谢之二首 其一","author":"曾几","text":"西风黄叶北门街，有句无人为剪裁。\n冲突前驱公会否，要求一语定敲推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遗直堂 其六","author":"曾几","text":"柏叶松其身，在时公手植。\n杂树谁所栽，一钱初不直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"置酒签厅观荷徐判官携家酿四首 其四","author":"曾几","text":"休看红药咏翻阶，极目荷花照酒杯。\n静濯明妆何所待，风标公子远飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"置酒签厅观荷徐判官携家酿四首 其三","author":"曾几","text":"白白红红花映阶，高高下下叶成杯。\n娇娆似不禁长夏，故就团圞扇影来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"置酒签厅观荷徐判官携家酿四首 其二","author":"曾几","text":"鄣日青圆自拥阶，绉风绿净可添杯。\n被花恼处君知否，罗袜凌波笑不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"置酒签厅观荷徐判官携家酿四首 其一","author":"曾几","text":"绿水波深欲上阶，红蕖香动要传杯。\n幕中自有两佳客，又载青州从事来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墨竹梅","author":"曾几","text":"的皪江梅竹外枝，能将幻法转生机。\n凭君莫作风垂绿，便恐飘零学雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题天衣寺","author":"曾几","text":"布袜青鞋踏欲无，登山临水未成疏。\n十峰双涧天衣寺，万壑千岩总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题无热轩","author":"曾几","text":"一溪乔木阴，六月火云冷。\n门外有行人，寒泉思汲井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陆务观草堂","author":"曾几","text":"草堂人去客来游，竹笕泉鸣山更幽。\n向使经营无陆子，残僧古寺不宜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题意大师房","author":"曾几","text":"头白高僧心已灰，石菖蒲长水蕉开。\n庄严茗事炉烟起，不用关防俗子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠王明清","author":"曾几","text":"吾宗择婿得羲之，令子传家又绝奇。\n甥舅从来多酷似，弟兄如此信难为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢僧送新茶","author":"曾几","text":"斋肠得饱又逐去，午梦欲成还唤回。\n定是僧家不堪此，满奁青箬送春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯岁江南大旱七月六日临川得雨奉呈程伯禹待制","author":"曾几","text":"缥缈炉烟上帝阍，朝来一洗旱如焚。\n垄头无复成龟兆，水面初看起縠纹。\n政使夏畦炊白玉，未妨秋稼割黄云。\n使君闵雨心犹在，化得邦人不茹荤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日小圃菊花有开者病疡不能泛一杯把玩而已","author":"曾几","text":"黄菊开何许，疏篱小隐家。\n似知重九日，故放两三花。\n病著杯无渌，衰年发半华。\n佳辰辜负汝，满把但成嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二儿次韵予亦复次韵二首 其二","author":"曾几","text":"幽居有忙事，为竹绕墙隅。\n雨后青葱否，风前安稳无。\n井深时汲引，架倒复持扶。\n只欠江梅树，君应婿玉奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二儿次韵予亦复次韵二首 其一","author":"曾几","text":"此君今日醉，不复记方隅。\n窈窕因吾有，恢台到尔无。\n青犹须雨沐，直不要人扶。\n旁舍连高柳，何堪与作奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儿辈次复热诗韵再次韵示之","author":"曾几","text":"蓐收何在渺层空，三伏炎蒸尚未中。\n况复今宵无好月，不知底处有清风。\n看云暮暮不为雨，畏日朝朝还自东。\n忆昔给孤园里梦，褰裳觅路踏泥融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十五夜月二首 其二","author":"曾几","text":"云日晶荧固自佳，幽人有待至昏鸦。\n远分岩际松枫树，复乱洲前芦荻花。\n曳履商声怜此老，倚楼长笛问谁家。\n霜螯玉柱姚江上，作意三年醉月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十五夜月二首 其一","author":"曾几","text":"玉露金波不可孤，相瞻今夕定何如。\n氛埃未净雨湔洗，阴翳小留风扫除。\n丹桂看来元了了，白榆种得许疏疏。\n一杯浊酒非难事，未有新诗报答渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月六日大雪","author":"曾几","text":"薄晚蓬山下直馀，笑看六出点衣裾。\n絮飞帘外无萦绊，花落阶前不扫除。\n松鬣垂身全类我，竹头抢地最怜渠。\n短檠便可捐墙角，剩有窗光映读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月一日","author":"曾几","text":"屋角羲娥转两轮，今朝水帝又司辰。\n山家尝稻知良月，野径寻梅见小春。\n一岁坐看除得尽，百年正与死为邻。\n谁能思许无穷事，闭閤开炉但饮醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又二首 其二","author":"曾几","text":"政喜溪南宅，还乘剡县船。\n归来知底日，老去惜馀年。\n觞咏虽休矣，音书未寂然。\n省郎君旧物，消息已真传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又二首 其一","author":"曾几","text":"一纸寝丘书，僧窗屡卷舒。\n无因浮左蠡，况复度匡庐。\n政以相望远，非关自作疏。\n梦成飞鸟去，千里不踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又咏荔子","author":"曾几","text":"百年中半饱闻渠，名下亲承果不虚。\n可爱风流元有种，自然富贵乃其馀。\n肯随妃子红尘驿，甘伴先生白鹤居。\n可惜不经山谷赏，照红鸭绿定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三霄亭和韵","author":"曾几","text":"新亭崛起最高峰，无数遥岑翠扫空。\n恐有谢公留屐齿，为闻摩诘画屏风。\n倚江杨柳自高下，照水杏花能白红。\n正欠渭川千亩竹，清阴分借赖邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上方","author":"曾几","text":"前朝兰若旧闻名，绝顶禅房日月邻。\n木润山辉应有物，锡飞杯渡不无神。\n郊坰行去仅百里，郡郭往来今十春。\n未踏青云梯一级，会当齐侣个中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨","author":"曾几","text":"谁言春雨散如丝，一月垂空似绠縻。\n云去云来何日了，花开花落不曾知。\n直愁排荡根荄尽，安用栽培桃李为。\n政恐东君不无意，十分妍暖乞酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨","author":"曾几","text":"荒院已无趣，愁霖终不开。\n檐声喧客语，屋漏逐人来。\n桥报今朝断，墙闻昨夜摧。\n尚馀汤饼具，积潦未为灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨有怀曾宏甫","author":"曾几","text":"欲访溪山老，无如此雨何。\n一春判弃置，十日断经过。\n灯火相看放，莺花即渐多。\n晴暄如有意，数数上南坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞笔","author":"曾几","text":"市上无佳笔，营求亦已劳。\n护持空雪竹，束缚欠霜毫。\n此物藏三穴，须公拔一毛。\n不堪髯主簿，取用价能高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏秀道中自七月二十五日夜大雨三日秋苗以苏喜而有作","author":"曾几","text":"一夕骄阳转作霖，梦回凉冷润衣襟。\n不愁屋漏床床湿，且喜溪流岸岸深。\n千里稻花应秀色，五更桐叶最佳音。\n无田似我犹欣舞，何况田间望岁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大热欲过广寿寺谒韩子苍追凉先之以诗","author":"曾几","text":"执热今如此，追凉定若何。\n长廊受风远，广殿得阴多。\n盛欲扶筇去，还能下榻么。\n近公如玉雪，未厌数经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大暑","author":"曾几","text":"赤日几时过，清风无处寻。\n经书聊枕籍，瓜李漫浮沈。\n兰若静复静，茅茨深又深。\n炎蒸乃如许，那更惜分阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大藤峡","author":"曾几","text":"一洗干戈眼，舟穿乱石间。\n不因深避地，何得饱看山。\n江溃重围急，天横一线悭。\n人言三峡险，此路足追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子苍携和章见过用韵为谢","author":"曾几","text":"胡岭三年自窜流，归来差慰此生浮。\n政缘天下无双士，非为江东第一州。\n悬榻坐中难入眼，设罗门外少回头。\n袖诗不意高轩过，问里人曾到此不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月六日为丛珍之集于南池呈座中诸公","author":"曾几","text":"今日携壶地，南池信杖行。\n红蕖争入眼，白鹭最关情。\n待得跳珠雨，来听打叶声。\n菰蒲最深处，只欠小舟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公廨莲池","author":"曾几","text":"浪说吾邦小，清池思有馀。\n水风凉枕簟，荷气馥衣裾。\n客位经过少，官曹簿领疏。\n良辰不行乐，秋水落芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬戌岁除作明朝六十岁矣","author":"曾几","text":"禅榻萧然丈室空，薰销火冷闭门中。\n光阴又似烛见跋，学问只如船逆风。\n一岁临分惊老大，五更相守笑儿童。\n休言四十明朝过，看取霜髯六十翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尹少稷寄顾渚茶","author":"曾几","text":"骎骎要路津，旧日水南人。\n尚记茶山老，能分顾渚春。\n江淮劳庙算，河路暗胡尘。\n忧国惟生睡，降魔固有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]