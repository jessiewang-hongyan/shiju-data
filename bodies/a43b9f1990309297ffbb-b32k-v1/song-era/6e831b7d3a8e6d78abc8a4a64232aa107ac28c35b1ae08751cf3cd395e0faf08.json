[{"title":"依韵和查许国二首 其一","author":"陆佃","text":"重渊谁道探珠难，恰值骊龙睡重间。\n工部藩篱今梦草，司空门馆旧衔环。\n心肠何啻吞云梦，身手犹堪擘华山。\n况有旧家仙桂在，姮娥留著待君攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国二首 其二","author":"陆佃","text":"谁作明堂一柱看，谪官犹诖罪中间。\n名成何必频看镜，道在终须得赐环。\n一片灵台江上月，七株仙果海中山。\n回头为报姮娥道，拟把高枝次第攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄龚深之曾子开","author":"陆佃","text":"先生官冷久京华，衣有尘埃饭有沙。\n半夜尚闻亲旧草，一春长是负新花。\n两龚清洁推君子，二陆文章属当家。\n更忆巷南曾学士，坐将盘诰解聱牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国梅花六首 其一","author":"陆佃","text":"腊月狐裘尚御黄，靓妆先了为谁忙。\n与春不足都缘淡，教雪难知祇为香。\n曾拥旌旗闻鼓角，终随彝鼎见烝尝。\n少陵赖尔牵诗思，得向诗中号帝王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国梅花六首 其二","author":"陆佃","text":"水天清浅月昏黄，传语诸花未要忙。\n词客尽应相识早，玉人谁有自然香。\n祇承雨露尤消得，况乃冰霜已备尝。\n未用夜寒吹玉笛，切须丁嘱与宁王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国梅花六首 其三","author":"陆佃","text":"平日栽培土尽黄，看来人自有閒忙。\n池台直下疏疏影，帘箔中间淡淡香。\n命说梦魂犹未破，说汤滋味得先尝。\n凭谁为访桃花浪，何路能酬百谷王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国梅花六首 其四","author":"陆佃","text":"妆阁无端画月黄，见他閒淡转苍忙。\n陇头惆怅经年别，衣上慇勤尽日香。\n期刻莫将蓬鬓插，思量消得瓠犀尝。\n若教梵竺诸天有，何必龙华引象王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国梅花六首 其五","author":"陆佃","text":"北窗高卧识羲黄，静看东君职事忙。\n短帽上垂年少事，净瓶中养月馀香。\n镜鸾羞愧临梳裹，盐虎推先在飨尝。\n试问古来谁可伴，风流东晋有诸王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和查许国梅花六首 其六","author":"陆佃","text":"共月新成榜字黄，使君霜鬓未须忙。\n春前腊后千回顾，天上人间一分香。\n庄子梦魂休道识，太公牙齿要须尝。\n论功纵在姚黄下，果子花中合是王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和许安石","author":"陆佃","text":"风和鹊喜就中灵，忽报轩车到驿亭。\n解得礼经归指掌，弄成诗笔胜丹青。\n早年花萼光原隰，今日芝兰满户庭。\n闻说龙州佳阙近，蜀人先已望流星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从驾幸龙德宫","author":"陆佃","text":"玉锁晨开厚载门，人家随处著彫轮。\n潜龙宫邸来惟旧，复辟帘帏卷尚新。\n深巷尽言窥日月，粗官难得后埃尘。\n戴恩自觉丘山重，愿放鳌更六万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宁节口号","author":"陆佃","text":"九天宫阙五云新，共向中间望紫宸。\n几杖一千年父老，衣冠三万里君臣。\n濑乡老子如今桧，蒙县庄生上古椿。\n就祝圣君千万岁，过于天上寿星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄彦猷阁老某前岁奉使还领扬州今彦猷亦自境外归得姑苏","author":"陆佃","text":"相望持节出卢龙，继踵分符别紫宫。\n汲黯虽嫌弃为郡，袁丝应惮久居中。\n文章不见于时益，出处何知与子同。\n红药万株天下绝，谢公来肯醉薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周邠朝奉","author":"陆佃","text":"相见还如颍水滨，不应衰迈久风尘。\n几回醉里成狂客，一向诗中作贵人。\n故国生涯元自薄，老来情分剩相亲。\n荐贤况有诸公在，早晚除书下玉宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新桥","author":"陆佃","text":"碧光新近跨长桥，免使游人隔岸招。\n想像蓬瀛今彷佛，丁宁风雨莫漂摇。\n少浮蛟蜃平生气，才露虹霓一半腰。\n明月满天天似水，直疑霄汉路非遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题周中散至乐堂","author":"陆佃","text":"一瓢到底胜珠玉，万籁由来当管弦。\n尽日海鸥陪燕坐，有时溪柳伴閒眠。\n不知萱草忧何事，今见蟠桃定几年。\n回首真人足官府，刘安何苦要升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丞相荆公挽歌词","author":"陆佃","text":"惯识无心有海鸥，行藏须向古人求。\n皋陶一死随神禹，孟子平生学圣丘。\n雕篹想陪清庙食，玉杯应从裕陵游。\n遥瞻旧馆知难报，绛帐横经二十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕申公挽歌词","author":"陆佃","text":"家世从来耸具瞻，平生僚友惮方严。\n挂閒麈尾清谈罕，傅尽龙髭老病添。\n共惜一朝埋玉树，正当双日下珠帘。\n自惭曾借风雷便，初与鱼龙出滞淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩康公挽歌词三首 其一","author":"陆佃","text":"熙宁初见筑堤沙，曾与千官听白麻。\n常棣行中排宰相，梧桐名上识韩家。\n平生事业留青史，一夜尘埃暗碧纱。\n闻说手栽桃李在，春来应有万株花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩康公挽歌词三首 其二","author":"陆佃","text":"三台光耀紫微中，康国仍兼万户封。\n有子晨昏长侍膳，谁家兄弟尽登庸。\n非关庚日曾占鵩，自是辰年并值龙。\n他日凌烟求绘匠，愿凭丹笔为形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩康公挽歌词三首 其三","author":"陆佃","text":"龙虎常瞻榜上名，识公初向凤凰城。\n三千宾客知毛遂，五百人家待晏婴。\n拟看玉书容拔宅，安知金鼎误垂成。\n后园履迹今芜没，惟有清风伴月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕尚书挽歌词","author":"陆佃","text":"祸患相仍涕泪频，司空坟上草犹新。\n鹡鸰花萼空馀子，龙马图书并失人。\n遍历名藩今始老，长如寒士本非贫。\n如何一日埋金碗，独向清时不秉钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蹇翁待制挽歌词","author":"陆佃","text":"仕宦声名四十年，归心日夜望林泉。\n文移竟负登山屐，笺记空随过海船。\n花坞夕阳今逝矣，锦江春色谩依然。\n传家况有珠玑在，会向人间月夜圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程给事挽歌词","author":"陆佃","text":"桃花坟坞土新乾，叹息高才又玉棺。\n竟逐两翁谈笑尽，空留三老画图看。\n异书会见传吴市，妙斲何知失郢墁。\n闻说锦囊佳句在，光芒犹伴夜珠寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王圣美学士挽歌词","author":"陆佃","text":"使君政事与文章，忧患平生亦备尝。\n资善故人今白发，邯郸一梦已黄粱。\n田园倚仗千株橘，花萼飘零一树棠。\n闻说异书奇字在，不妨分付与诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏国太夫人陈氏挽歌词","author":"陆佃","text":"门户同归太史评，传芳消息在瑶琼。\n凤衔诰诏从夫贵，龙负图书识父清。\n金鸭火销香自远，玉奁珠在月空明。\n也知欲向华胥问，炊尽黄粱梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李劭县令","author":"陆佃","text":"长官衫色暗，玉雪久甘贫。\n为问江西月，如君有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡二首 其一","author":"陆佃","text":"门巷雨萧萧，黄昏掩寂寥。\n曲终人不见，花落梦无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡二首 其二","author":"陆佃","text":"灯火夜寥寥，残香不可招。\n朱扉寒半掩，金鸭煖全消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏史","author":"陆佃","text":"珠履三千两，金椎四十斤。\n阿谁知狗盗，却解脱田文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景德寺考试秋日即事四首 其一","author":"陆佃","text":"朝来爽气雨初乾，乔木阴阴锁昼寒。\n深院下帘风不动，夕阳幽鸟傍阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景德寺考试秋日即事四首 其二","author":"陆佃","text":"秋声一夜满长安，密雨疏风次第寒。\n幽草落花归思乱，寂寥终日倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景德寺考试秋日即事四首 其三","author":"陆佃","text":"西风吹绉一池秋，故殿疏帘半上钩。\n满眼夕阳归未得，菊花桐叶伴人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景德寺考试秋日即事四首 其四","author":"陆佃","text":"看尽斜阳夕未还，夜天如水断云閒。\n玉楼咫尺无人去，月上珠帘第几间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又景德再考试秋日即事","author":"陆佃","text":"重来时节又秋深，黄菊香中一炷沈。\n浑觉去年无限恨，物华人意总如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试院夜雨思秦叔仲至呈信道","author":"陆佃","text":"秋声秋色总无聊，千里相思鬓欲凋。\n独绕曲廊花院闭，夜深灯火雨萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和程给事赠法云长老重喜","author":"陆佃","text":"识字如今尚未深，扫廊才悟便能吟。\n法云香火修行久，夜半潮声避梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送俞括知贡州","author":"陆佃","text":"太守官清著破衫，祇应泉水误名贪。\n遥知雁足书难到，州在衡阳尽近南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其一","author":"陆佃","text":"索寞还寻静处行，物华如旧岁华更。\n绿槐苍桧曾相识，想见英雄讶瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其二","author":"陆佃","text":"深炷炉香浅点茶，午庭愁寂下寒鸦。\n佳人仙去无消息，肠断春风一院花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其三","author":"陆佃","text":"雪消姑射丰肌尽，云入阳台短梦频。\n可惜舞衣犹粉黛，不堪歌扇已埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其四","author":"陆佃","text":"春远落花随水尽，夜深明月向人圆。\n昆崙欲使知无路，仙苑分明隔洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其五","author":"陆佃","text":"风月相望也不多，祇应清浅隔天河。\n欲凭乌鹊传消息，一度逢秋一度过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其六","author":"陆佃","text":"忽地轻红四散飞，寻常春色未应稀。\n东风大是无情思，吹落馀香便不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其七","author":"陆佃","text":"百花流转逐浮萍，柔质那堪殒妙龄。\n画手若能图列女，玉颜应许上丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡八首 其八","author":"陆佃","text":"淡红浓紫总销魂，春恨无人可共论。\n徙倚暮寒襟袖薄，落花门巷月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李门下江行初雪图二首 其一","author":"陆佃","text":"渔翁披得一渔蓑，物色虽幽奈冷何。\n长怪高宗问霖雨，元来黔首要中和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李门下江行初雪图二首 其二","author":"陆佃","text":"须知元化仗丹青，移得沧江在画屏。\n看取乾坤一般色，可怜长短谩相形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王允中至乐堂","author":"陆佃","text":"颜巷虽贫乐有馀，箪瓢终不换金珠。\n长安大第连云起，还有君家此乐无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"传神诗","author":"陆佃","text":"富贵从来我自知，商岩霖雨偶愆期。\n祇应须鬓年来改，不及高宗梦里时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈初道录","author":"陆佃","text":"巉岩瘦骨欲成金，云锁三茅洞府深。\n莫遣桃花流水出，等閒应被客相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陆佃","text":"辂从元朔朝时破，花是高秋宴后萎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陆佃","text":"润色圣猷双孔子，调燮元化两周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"高遵惠","text":"上林供王宴，圣母赐金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游九仙阁","author":"傅楫","text":"偶有寻真兴，携琴扣竹关。\n岩头青嶂合，洞口白云閒。\n火伏丹犹湿，棋残局已斑。\n游人迷去路，疑是霍童山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次祥卿焦山韵","author":"翟思","text":"窗影江光四面开，虚空无处得生埃。\n依依山顶云飞去，隐隐海门潮上来。\n喷雪浪搥藏鹤冢，落花风扫炼丹台。\n吸江亭上多时坐，谁信茶瓯胜酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次董野迂焦山韵","author":"翟思","text":"四面江光不住尘，中流拥护有波神。\n画家点染图多赝，诗老形容语最真。\n丹井泉来冰熨齿，石床云卧浪摇身。\n碧桃湾里花狼藉，一夜狂风断送春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登华顶峰","author":"马珹","text":"游山须览胜，八百里天台。\n若不登华顶，浑如不到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遗偈","author":"俨和尚","text":"四大之身，水月空云。\n一轮湛湛，廓落乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游太虚观","author":"安惇","text":"昔年游历访霓旌，多谢仙师数里迎。\n今日重来知有意，此身应不为公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游仙馆","author":"安惇","text":"梦游仙馆逢真侣，为说生前与此身。\n本是富陵朱隐士，暂来人世秉陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涤虑轩","author":"虞策","text":"禅翁自说逢迎懒，向此开轩最所宜。\n地僻风尘非我事，夜深水月几人知。\n沈观万境皆无物，笑指三乘亦有为。\n行客暂来良自省，不堪勤瘁鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李时亭","text":"石柱虹梁势入云，玉鸾金凤锁丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉阁煎茶应供","author":"刘珵","text":"宝炉香散晓烟寒，净几供茶绕座看。\n已爱六花金缕异，更惊三啜翠痕乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 花屿","author":"刘珵","text":"浅深艳冶一枝枝，带露临风不自持。\n水上红云真缥渺，多才却忆退之诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 芳草洲","author":"刘珵","text":"春水池塘空苒苒，长安古道倍依依。\n争如绿向芳洲遍，不怨王孙去未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 柳汀","author":"刘珵","text":"江渡隋堤千万缕，年年折尽最长条。\n谁知烟雨汀洲晚，閒舞东风拂画桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 竹屿","author":"刘珵","text":"翠云摇曳波心起，清影扶疏月际来。\n结实终期丹凤至，虚心聊映小桃开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 烟屿","author":"刘珵","text":"閒伴晓云笼浅濑，半和秋雨羃寒沙。\n溶溶泄泄拖轻素，遮尽渔蓑与钓槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 芙蓉洲","author":"刘珵","text":"翠幄临流结绛囊，多情长伴菊花芳。\n谁怜冷落清秋后，能把柔姿独拒霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 菊花洲","author":"刘珵","text":"金蕊含香冒雨开，清无俗格绝尘埃。\n休嗟不及东篱下，也有幽人载酒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 月岛","author":"刘珵","text":"众乐亭前月满洲，雨馀风静正中秋。\n桂华冷射千寻碧，十顷湖光烂不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏西湖十洲 雪汀","author":"刘珵","text":"六出花轻巧剪裁，瑶林玉砌映南台。\n冰澌四面寒光合，疑有飞仙月下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]