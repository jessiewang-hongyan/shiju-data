[{"title":"绝句 其一","author":"黄文雷","text":"乳燕飞飞帘影迟，不晴不雨晚春时。\n开窗纵目消书困，风送杨花落砚池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句 其四","author":"黄文雷","text":"莫怪人言济叔痴，东行西去又思归。\n儿童旧读从温故，一笑今朝到式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句 其二","author":"黄文雷","text":"琴剑平生叹薄游，云间春晚思如秋。\n梦回月浸书窗冷，身在吴松江尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱氏故园 其二","author":"黄文雷","text":"中兴次辅巧玲珑，尚带承平艮岳风。\n一朵庆云飞不去，游人眼冷夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱氏故园 其一","author":"黄文雷","text":"几年闻此好名围，平地黔巫翠扫天。\n萧岸半摧林影暗，乱萤閒自点湖烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上天池寺 其一","author":"黄文雷","text":"蟠际均衡岳，千峰独出群。\n鲲鹏从水击，翼轸验天文。\n旷野风行雨，曾霄日贯云。\n僧言兴废事，因念福王勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上天池寺 其三","author":"黄文雷","text":"今古无穷恨，山林只自豪。\n云行地欲尽，风立天相高。\n灵草如堪饵，浮生计可逃。\n人间何扰扰，万里一秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无恙","author":"黄文雷","text":"北去初无恙，传疑路不通。\n戈鋋亭障密，榜牍训辞工。\n落日鸟飞急，空山花自红。\n若为能诅盗，桑匕斗星中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东塘舟中","author":"黄文雷","text":"初识东塘路，言寻槜李船。\n鱼盐千古地，吴越一家天。\n梦觉何为者，行藏不偶然。\n半溪疏竹影，相送海云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古石","author":"黄文雷","text":"赑屃窗前石，参差类虎螭。\n秋晴藓可剥，岁晏竹相宜。\n要自山川出，那知陵谷移。\n摩挲群玉瘦，风助马王悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄存之东皋韵 其二","author":"黄文雷","text":"抱膝东皋下，春风又草庐。\n海仙将可见，溪友未宜疏。\n楷著祈年疏，闲笺种树书。\n西山颒烟雨，容易长嘉蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄存之东皋韵 其四","author":"黄文雷","text":"挟册东皋下，从人笑未玄。\n传真秧马帖，参透牧牛篇。\n列岫窗前月，平湖坞外烟。\n似蒙稽古力，钟鼎岂其然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄存之东皋韵 其一","author":"黄文雷","text":"艺木东皋下，新荣冒水涯。\n锦机分箔闹，青子亚枝斜。\n犊角初生笋，龙须正引瓜。\n汲清双玉井，留客品尝茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄存之东皋韵 其三","author":"黄文雷","text":"负耒东皋下，沟塍稻秫分。\n污邪争一溉，台笠事重耘。\n豳雅春称寿，秦讴岁劳勤。\n无功虚作传，农绩未如君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自广","author":"黄文雷","text":"今古纷纷孰控抟，太平方寸豁忧端。\n后千年去人何似，外九州来天更宽。\n风雨南山飞霹雳，江湖北斗挂阑干。\n要知元命真消息，沧海神龙自屈蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近报 其一","author":"黄文雷","text":"入春风雨恶情怀，谈柄谁资近报来。\n比岁时闻通国信，新年又说建行台。\n难言铁冶飞灰烬，易见铜驼出草莱。\n羌筦夜吹梅落尽，倚墙缭乱野花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往年因读岳王传尝为之赋今过东林睹其遗像感而申颂之 其一","author":"黄文雷","text":"将军英爽冠人豪，眼底山河累宝刀。\n青女护香天亦误，黑龙饮渭数何逃。\n当时僧说松楸犯，今日人推阀阅高。\n珍重王孙方鼎贵，莫将歌舞替征袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往年因读岳王传尝为之赋今过东林睹其遗像感而申颂之 其二","author":"黄文雷","text":"欲坏长城岂自由，江人重唱白符鸠。\n熏天富贵还须尽，从古忠良类若仇。\n狱吏但能书牍背，相公终欲割鸿沟。\n书生志念闲无用，长想朱云地下游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰道中 其四","author":"黄文雷","text":"想见承平日，兹为富庶乡。\n门庭存位置，井臼隔垣墙。\n草市宜区种，空村又夕阳。\n谁欤真致此，盗贼已天亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰道中 其五","author":"黄文雷","text":"大村三伯辈，同此就天诛。\n锐欲取禾耳，那知暴骨乎。\n云疑鹅鹳阵，风想虎狼都。\n掩骼行春令，毋令长媚狐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰道中 其一","author":"黄文雷","text":"此县闻天下，披图且万家。\n螭头馀佛屋，鹿角卧江沙。\n好与苏凋瘵，谁令息叹嗟。\n春风多少意，残竹映疏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南纪","author":"黄文雷","text":"南纪沾王泽，涵濡已百年。\n故应逢小劫，何得怨苍天。\n旧观宁无日，浮生自可怜。\n永怀千古事，感慨泪涟涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偕周伯弜题天申宫苏文忠公画像","author":"黄文雷","text":"大泽沾荒裔，灵山识老臣。\n微茫云外迹，衰病瘴中身。\n湿草寒碑夕，晴花午殿春。\n高檐风雨断，犹避六丁神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登楼有感","author":"黄文雷","text":"顾陆风流几夕阳，桑畴麦陇自凄凉。\n山从地尽云垂海，水共天浮日射洋。\n门卒何年隐吴市，啬夫当日爱桐乡。\n蚁封未敢誇荣策，芳草无人且自芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二桥图","author":"黄文雷","text":"翔龙下卷江东土，孙郎初得桥家女。\n桥家本自重曹瞒，只鸡斗酒空酸楚。\n衿情正用留阿瑜，尚得人前称肺腑。\n百年王气竟销沉，妙写丹青娇欲语。\n香闺搦管记何书，并蒂芙蓉按花谱。\n那知不是未嫁时，本末无从勘彤史。\n词人多事管闲愁，铜雀纷纷底歌舞。\n尽强被发向黄垆，只与东阿传洛浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上天池寺 其二","author":"黄文雷","text":"始从平地望，宛在九霄中。\n不意身能到，平生心并空。\n江淮通好雨，日月会刚风。\n三伏凉如水，蟠拿想白龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长歌行","author":"黄文雷","text":"君不见游尘着空生九州，人其中间悬两眸。\n杨花化萍无根蒂，风消水长东西流。\n红南下湿人易老，过尽岁年还草草。\n长留白日照人间，榆柳浮生转枯槁。\n毬纹带绕千花黄，青娥攒眉眉细长。\n莫言一尊千万寿，乃翁身命属渠手。\n长安城中鬼笑人，水底纸钱能不朽。\n今人不见古人心，古人不见今人事。\n天上若无长生人，即是古人都尽死。\n金凫银雁满江湖，神光夜夜开黄垆。\n年经月纬三百卷，平生欲作何人书。\n古人去去留不得，我些古人三太息。\n今人莫诧山石牢，更后十年人不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬郊","author":"黄文雷","text":"冬郊见初晴，空林夕阳软。\n归牛无人驱，欲涉行转缓。\n新藁明屋山，失喜鹊争唤。\n绝胜门外人，流冗及岁乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石头怀古","author":"黄文雷","text":"长江日浩浩，跂予望淮南。\n禹画足广轮，王气分殽函。\n朝市一以建，蟠踞诚匪惭。\n中躔胡尘悲，六龙此停骖。\n衣冠幸有地，喙息赖未歼。\n岂惟时贤力，要是天险参。\n颇闻京洛墟，不救狐兔馋。\n厌难故有道，往悔宁非贪。\n前登石头路，得共北客谭。\n新秋带归鸿，落日随征帆。\n吊古意未厌，鼓钟已酣酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚归自临川","author":"黄文雷","text":"半世生群盗，穷年见乱离。\n出门偏念母，挟策欲干谁。\n雪重人踪绝，山寒火气低。\n平时来往地，满目尽忧疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈刚父见简韵 其三","author":"黄文雷","text":"呦呦苹野春，我友二三子。\n归山睡初足，涧壑秋风起。\n一瓣无尽香，黄云绕书几。\n别吟极隽永，形魂清九耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈刚父见简韵 其一","author":"黄文雷","text":"我居深山中，细哦求友篇。\n解后潮海滨，得此璧一联。\n山立古先民，期君能拍肩。\n茫茫宇宙心，楚楚东南贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次陈刚父见简韵 其二","author":"黄文雷","text":"读书知姓名，心死非貌敬。\n昭回不在小，中天揭西柄。\n空山三木榻，绿满风雨径。\n岁寒毋忘我，细意匡山咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西域图","author":"黄文雷","text":"大哉天地间，品类不可齐。\n谁为好事人，貌此县度西。\n松花琐碎沙草肥，是间可牧羊千蹄。\n可怜群鹿正走险，或尔剥割衣其皮。\n啜湩树桦尚有理，穴?插齿吁何为。\n吾闻中原全盛时，重译解辫朝京师。\n怀方象胥饬乃事，幻人诡伎何能奇。\n煌煌烈祖鉴古作，玉斧画地分华夷。\n羌浑何者宅荥洛，蠕蠕异类方纷披。\n或为盘瓠孙，或为天狼妻。\n冠带之国尽狐兔，玉门万里那得知。\n还君此画双涕洟，愿赋周官王会诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观化","author":"黄文雷","text":"屋角有蜘蛛，结网大如箕。\n有来者蜻蜓，飞飞堕其围。\n嗟汝水之生，爬沙自足嬉。\n忽然凌空游，蜂虿避路驰。\n一朝婴祸罗，羽翼安所施。\n蜘蛛虽未出，狼狈已可期。\n我欲起救汝，正坐手足疲。\n噫吁嚱，悲弗悲，蜘蛛亦有黄雀随。\n百虫相残人不管，人兮食人天岂知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近报 其二","author":"黄文雷","text":"青青塞草始知春，又见平林枣颊赪。\n蛇起天津流枉矢，鸟飞淮甸覆行尘。\n漆城按堵宁辞荫，石马沾沟会有神。\n千古睢阳无处觅，不知臧质是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陶 其一","author":"黄文雷","text":"志士方进身，恨不以羽飞。\n束缚归山冈，竟为人所悲。\n白杨夜萧萧，顾此何足依。\n百岁会有尽，智愚同所归。\n奈此后之人，未老形已衰。\n有酒不暇饮，而恐心事违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陶 其二","author":"黄文雷","text":"林表有宿霭，谷鸟相啾喧。\n听此心烦劳，启窗西南偏。\n天气总未佳，白云生陇山。\n欲访云间人，雨至或未还。\n拨灰书且住，首肯心中言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陶 其四","author":"黄文雷","text":"上有碧松林，下有白石道。\n中有学仙人，自号枯松老。\n蜕身千岁馀，坐息如木槁。\n面目剧严冷，但道空虚好。\n袖出天甲书，意色轻鸿宝。\n此老诚可人，吾欲从师表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陶 其三","author":"黄文雷","text":"黄河一再清，似是上古时。\n风雅久已降，后来无文辞。\n清风日沦落，世道皆如兹。\n工华不工实，此话我所疑。\n文章有心印，昔人端不欺。\n但恨智者少，吾亦少卑之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陶 其五","author":"黄文雷","text":"牧牛上阳坡，角挂上下经。\n吴童歌且谣，旨趣皆混成。\n东西两山间，饱见日月更。\n归来松阴凉，夕阳满前庭。\n黄叶从风翻，萧飒草际鸣。\n再拜谢天公，赋此小人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰道中 其三","author":"黄文雷","text":"此路通南国，于今人少行。\n遗民依庙住，旷野用锄耕。\n古木刀痕熟，空山鬼火惊。\n犹闻宿师处，仓猝又招兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰道中 其二","author":"黄文雷","text":"此亦勤农者，畬田半入云。\n龙蛇因尔杂，玉石故难分。\n天地其如数，江山未返魂。\n茅茨倦行李，何自戒重门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭君行","author":"黄文雷","text":"君不见未央前殿罗九宾，汉皇南面呼韩臣。\n无人作歌继大雅，至今遗恨悲昭君。\n丙殿春闲斗冯傅，掖庭新花隔烟雾。\n票姚枉夺燕支山，玉颜竟上毡车去。\n人生流落那得知，不应画史嫌蛾眉。\n痴心只共琵琶语，归梦空随鸿雁飞。\n穹庐随分薄梳洗，世间祸福还相倚。\n上流厌人能几时，后来燕啄皇孙死。\n野狐落中高台倾，宫人斜边曲池平。\n千秋万岁总如此，谁似青冢年年青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送故","author":"黄文雷","text":"履霜著馀悲，送故或古风。\n幸会草木长，土脉验隐隆。\n共惟青鸟仙，倘亦知吾穷。\n落日起秀色，军峰在云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽程孺人","author":"黄文雷","text":"有炜遵彤管，无嫌各紫枢。\n清心能敏悟，雅性谢骄舒。\n奉诰期鸾彩，传经嘱凤雏。\n妙年仙格迅，琬琰不胜书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓行","author":"黄文雷","text":"一水来不极，两山青欲连。\n夜雨瀑初涨，晓云路难缘。\n此宁有人迹，四顾风竹喧。\n渡桥复何归，倚崖桃初然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史感兴 其四","author":"黄文雷","text":"断鳌几何年，八极俨不动。\n当是有枢纽，铁网络纤空。\n偷儿睨斗柄，赤手掣天栋。\n愁杀地上人，覆压万古痛。\n书生见事浅，十算九不中。\n岂徒书生罪，要与六籍共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史感兴 其六","author":"黄文雷","text":"仙栖固多名，世但知蓬莱。\n九州复九州，广大莫可该。\n翩翩牧鹤童，巧笑如婴孩。\n授我紫玄章，归路玉笛哀。\n苍寒不可觅，但有清风来。\n偪仄宁久居，浮生多尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史感兴 其二","author":"黄文雷","text":"空山有大木，琅玕叶敷腴。\n末至更摧落，岂复润朽株。\n东西四百载，天明拱黄图。\n哀哀李杜死，诸贤亦沦胥。\n庸蜀反初燃，大厦终难扶。\n长怀追爽鸠，谁复来此居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史感兴 其一","author":"黄文雷","text":"人为五行精，二气相循环。\n阳明发天秀，隐约超龙蟠。\n如何椒兰芳，苦厄萧艾繁。\n良玉必火浴，利刃因崖刓。\n大钧虽无垠，岳降亦甚难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史感兴 其五","author":"黄文雷","text":"子胡讥神仙，仙人轻薄俗。\n轩冕既非荣，刀锯况多辱。\n惟能小万物，是以超五欲。\n栖琼得轻安，镂玉记华馥。\n一咏太始音，灵芝悟前夙。\n小谪未可遗，裁书系鹤足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史感兴 其三","author":"黄文雷","text":"典午固薄德，南风扇群污。\n痴儿各翻覆，血刃起相屠。\n老羝作人语，海上生羊鱼。\n山东二百州，白日栖群胡。\n更擅年代足，文皇受乾符。\n泰少否则长，岂亦天意欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚立","author":"黄文雷","text":"独游得荒蹊，晚意与心会。\n水声远才闻，山色静可对。\n鸟语林塘边，犬鸣篱落外。\n柴门未须关，月在东峰背。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题醉僧图","author":"黄文雷","text":"僧之饮酒，地狱咫尺。\n此僧饮酒，天龙辟易。\n僧之饮酒，背面抵讳。\n此僧饮酒，口角觱沸。\n披毛带角即不理，倒阶卧路而已矣。\n一生般若几杯汤，个是逃禅真法子。\n不忧兜率不着渠，只忧兜率无酒酤。\n临行自谤不羞耻，至今留与人画图。\n画图得龙眠，画形兼画意。\n君看阿堵中，如如元不死。\n是卧是死谁得知，手中尚记携鸱夷。\n翻河倒海不救渴，安得馀沥流于斯。\n我观此僧面孔真滑稽，醉中定解草圣并赋诗。\n当其幕天席地时，惜无人以笔墨随。\n纷纷散圣今何为，赖有一醉留其奇。\n君不见夜雨闭门难学柳下惠，又不见背水置阵古来惟有韩将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒋时举归养","author":"黄无悔","text":"秋风起兮白云飞，南国远兮心欲归。\n归心切兮亲庭闱，复相见兮在何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋燕","author":"黄月湖","text":"主人情熟已忘机，帘幕中间自在飞。\n昨夜西风凉信早，岂无归梦到乌衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠潘用中","author":"黄氏女","text":"栏杆閒倚日偏长，短笛无情苦断肠。\n安得身轻如燕子，随风容易到君傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赠","author":"黄氏女","text":"自从闻笛苦匆匆，魄散魂飞似梦中。\n最恨粉墙高几许，蓬莱弱水隔千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解连环 春梦","author":"黄水村","text":"凤楼倚倦。\n正海棠睡足，锦香衾软。\n似不似、雾阁云窗，拥绝妙灵君，霎时曾见。\n屏里吴山，又依约、兽环半掩。\n到教人觑了，非假非真，一种春怨。\n游丝落花满院。\n料当时、错怪杏梁归燕。\n记得栩栩多情，似蝴蝶飞来，扑翻轻扇。\n偷眼帘帷，早不见、画眉人面。\n但凝红生半脸，枕痕一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄世长","text":"溪上接秦头，远江分楚尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李制干","author":"黄刍","text":"先生云卧在梅峰，胸饱珠玑貌自丰。\n端坐浑如乔岳象，传经足并化工同。\n门前桃李春长在，身后勋名远更通。\n见说义兵扶社稷，千年国史纪元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]