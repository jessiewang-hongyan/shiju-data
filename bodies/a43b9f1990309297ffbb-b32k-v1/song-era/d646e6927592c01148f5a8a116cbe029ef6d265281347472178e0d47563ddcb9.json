[{"title":"雪中寻梅二首 其二","author":"陆游","text":"幽香淡淡影疏疏，雪虐风饕亦自如。\n正是花中巢许辈，人间富贵不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中忽起从戎之兴戏作四首 其二","author":"陆游","text":"铁马渡河风破肉，云梯攻垒雪平壕。\n兽奔鸟散何劳逐，直斩单于衅宝刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中忽起从戎之兴戏作四首 其三","author":"陆游","text":"十万貔貅出羽林，横空杀气结层阴。\n桑乾沙土初飞雪，未到幽州一丈深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中忽起从戎之兴戏作四首 其四","author":"陆游","text":"群胡束手仗天亡，弃甲纵横满战场。\n雪上急追奔马迹，官军夜半入辽阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后","author":"陆游","text":"雪消已断虚檐溜，日暖初催百草生。\n射的山前春水绿，笙歌又满会稽城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其十","author":"陆游","text":"清霜夜夜奈寒何，赖是知心有素娥。\n枉道疏枝不禁笑，主人欢意自无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其九","author":"陆游","text":"蕊殿仙姝下界游，偶来税驾剡溪头。\n君看月里横枝影，尽是苍龙与翠虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其八","author":"陆游","text":"春近山中日渐长，重重云崦閟幽香。\n神仙不饮尘凡酒，素面看人醉后狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其七","author":"陆游","text":"相逢未易可疏亲，不是登墙宋玉邻。\n林下风标许谁比，直须江左谢夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其六","author":"陆游","text":"竹篱曲曲水边村，月澹霜清欲断魂。\n商略前身是飞燕，玉肌无粟立黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其五","author":"陆游","text":"双鹊飞来噪午晴，一枝梅影向窗横。\n幽人宿醉闲攲枕，不待闻香已解酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其四","author":"陆游","text":"雪里芬芳亦偶然，世人便谓占春前。\n饱知桃李俗到骨，何至与渠争著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其三","author":"陆游","text":"银烛檀槽醉海棠，老来非复锦城狂。\n疏梅对影太清淡，为拂焦桐弹履霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其二","author":"陆游","text":"青帝宫中第一妃，宝香熏彻素绡衣。\n定知谪堕不容久，万斛玉尘来聘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后寻梅偶得绝句十首 其一","author":"陆游","text":"雪晴萧散曳筇枝，小坞寻梅正及时。\n临水登山一年恨，十分说似要渠知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后煎茶","author":"陆游","text":"雪液清甘涨井泉，自携茶灶就烹煎。\n一毫无复关心事，不枉人间住百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜二首 其一","author":"陆游","text":"书卷纷纷杂药囊，拥衾时炷海南香。\n衰迟自笑壮心在，喜听北风吹雪床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜","author":"陆游","text":"雪屋透窗明，风帘撮夜声。\n披衣拥炉坐，忘却在都城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜二首 其二","author":"陆游","text":"村路雪泥人断行，佛灯一点绛纱明。\n山前栖鹤归何晚，磔磔风传劲翮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴至后园二首 其二","author":"陆游","text":"宝马东风拥犊车，碧鸡坊里擅豪华。\n南来强作寻春梦，何处如今更有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴至后园二首 其一","author":"陆游","text":"病扶藤杖觅残梅，牢落情怀怕酒杯。\n约束园丁勤洒扫，新年作意待春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴欲出而路泞未通戏作二首 其二","author":"陆游","text":"雪消重作雨，冰释又成泥。\n已败筇枝兴，高眠听午鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴欲出而路泞未通戏作二首 其一","author":"陆游","text":"欲觅溪头路，春泥不可行。\n归来小窗下，袖手看新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馆中营缮方一新而右文殿生芝草甚异","author":"陆游","text":"丹碧参差盛一时，殿楹三秀见金芝。\n汉庭漫道多才杰，天马何劳作颂诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄亭夜雨","author":"陆游","text":"未到名山梦已新，千峰拔地玉嶙峋。\n黄亭一夜风吹雨，似为游人洗俗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","p