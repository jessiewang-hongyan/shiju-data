try","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山舟中遇风雨戏作","author":"陆游","text":"龙骧万斛去如鸿，巨浪惟能窘短篷。\n不是山灵嫌俗驾，一生常值打头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山遇雨","author":"陆游","text":"千秋观前雨湿衣，石帆山下叩渔扉。\n鹧鸪苦道行不得，杜鹃更劝不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仙五首 其四","author":"陆游","text":"初珥金貂谒紫皇，仙班最近玉炉香。\n为怜未惯丛霄冷，独赐流霞九酝觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仙五首 其五","author":"陆游","text":"玉殿吹笙第一仙，花前奏罢色悽然。\n忆曾偷学春愁曲，谪在人间五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仙五首 其一","author":"陆游","text":"飘飘鸾鹤杳难攀，万里东游海上山。\n应有世人遥稽首，紫箫馀调落云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仙五首 其三","author":"陆游","text":"玄圃春风赐宴时，双成独奏玉参差。\n侍晨饮釂虚皇喜，一段龙绡索进诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","