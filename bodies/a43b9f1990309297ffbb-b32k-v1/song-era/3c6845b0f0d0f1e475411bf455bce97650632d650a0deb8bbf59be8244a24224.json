[{"title":"定海甲寅口号七首 其五","author":"陈造","text":"父子分头上海船，今年海熟胜常年。\n官中可但追呼少，不质田输折米钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海甲寅口号七首 其四","author":"陈造","text":"水泛沟塍意欲餍，凌晨还复雨廉纤。\n早秧未颔犹须插，晚谷无多不更㘱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海甲寅口号七首 其三","author":"陈造","text":"已抄口数报隅官，岁后朝餔定不难。\n且愿眼前彊健在，趁坊讨海过冬寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海甲寅口号七首 其二","author":"陈造","text":"田租有约不相违，比著丰年数已亏。\n一饱分明郎首赐，几曾刺口问抽卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定海甲寅口号七首 其一","author":"陈造","text":"长官清苦旧传闻，检放禾苗近四分。\n毕竟不缘胥吏手，旱头科敛枉纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子冬望雪二首 其一","author":"陈造","text":"冬尽风霜只薄寒，人将雨雪卜新年。\n痴儿不问丰凶事，但快茆檐炙背眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其十","author":"陈造","text":"翁媪同围老瓦盆，倒篘新酒杂清浑。\n枧南枧北皆春社，且放乌犍卧晏温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其九","author":"陈造","text":"刈罢秋禾未敢慵，更须趁逐过残冬。\n城中竹筊今年贵，盐茗新来免阙供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其八","author":"陈造","text":"农闲闾里有逢迎，白饮傍边骨在羹。\n老稚不妨顽过日，边头难得是升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其七","author":"陈造","text":"杯酒清浓肉更肥，咸言趁社极欢嬉。\n丁宁向去坐年日，要似如今敛脯时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其六","author":"陈造","text":"跨牛待得夕阳回，在处诸嫲笑口开。\n已借蜡钱输麦税，免教缉捕闯门来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其五","author":"陈造","text":"夏田少雨富来年，多雨何妨穑事秋。\n已戒日供皮子面，更教晚稻饱霜收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其四","author":"陈造","text":"竹屋高低正复斜，蔚蓝影里著人家。\n底消山峡三分瘴，争课卢仝七椀茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其三","author":"陈造","text":"雩坛歌舞杂嗟吁，下酉犹濡上酉枯。\n谁谓朝来一拆雨，欢声已觉沸通衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其二","author":"陈造","text":"阴晴未敢捲帘看，苦雾濛濛鼻为酸。\n政使病馀刚制酒，一杯要敌涝朝寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"房陵十首 其一","author":"陈造","text":"似闻仙伯厌乘龙，常混红尘市井中。\n觌面未须趄避我，褰衣无计䟕寻公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招山阳高徐二生饮二首 其二","author":"陈造","text":"欲作山阴兴尽回，良思与子共衔杯。\n要须人境俱清绝，好抱瑶琴踏雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招山阳高徐二生饮二首 其一","author":"陈造","text":"梅花时节屡开樽，欲赠梅花欠可人。\n今日有人梅样好，迟君同赏雪中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊上虞驿来日行四首 其一","author":"陈造","text":"秋雨歇复下，西风微自凉。\n不妨舟系柳，已贷汗反浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊上虞驿来日行四首 其四","author":"陈造","text":"龙公底戏剧，长啸暝江天。\n雨鹊翻仍语，风舟舞不前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊上虞驿来日行四首 其三","author":"陈造","text":"溪山可图画，风物忆吾乡。\n渔艇鸥鹜乱，茅茨菱芡香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊上虞驿来日行四首 其二","author":"陈造","text":"梁湖莽苍外，后去未云迟。\n县市容吾恋，江潮不汝期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祈雨而应范簿有诗次韵四首 其四","author":"陈造","text":"山城粗满望霓心，老去私忧念自深。\n更祝今宵继畴昔，并烦鲁史纪为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祈雨而应范簿有诗次韵四首 其三","author":"陈造","text":"久无音信日边来，忧国谁怜怆老怀。\n想见天颜欢喜甚，鸳鸿入贺满尧街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祈雨而应范簿有诗次韵四首 其二","author":"陈造","text":"瓣香亲谒睡岩龙，高卧逶迤岂自公。\n岩下望龙须一怒，向来作止系凶丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祈雨而应范簿有诗次韵四首 其一","author":"陈造","text":"苍黄日日冒黄尘，敢意诚通主雨神。\n晓起遽听沾足报，天心政尔念疲民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙壬子劝耕妙胜四首 其四","author":"陈造","text":"桑条麦陇接比邻，社酒家炊丐路人。\n风俗尚如它日否，凭谁细问故园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙壬子劝耕妙胜四首 其三","author":"陈造","text":"胜日乘闲觉半仙，笑摩老眼向风烟。\n平章春事禽能语，媚妩韶光柳未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙壬子劝耕妙胜四首 其二","author":"陈造","text":"每愧敲榜办赋租，会心还喜劝耕初。\n渠侬嗣飨金穰庆，老子长捐柱后书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍熙壬子劝耕妙胜四首 其一","author":"陈造","text":"县曹文墨厌拘缠，野饭山行旧所便。\n祇道穷涂难措足，朝来风日为谁妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨次前韵四首 其四","author":"陈造","text":"骚窣松筠听夜喧，淙潺盆盎骇朝翻。\n衰翁危坐追交态，旧雨轩车尚到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨次前韵四首 其三","author":"陈造","text":"安排看驾趁游人，禁籞犹迟汉帝巡。\n留取晚香天一笑，倩谁寄语主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨次前韵四首 其二","author":"陈造","text":"墨云筛雨密还疏，欲出涂泥恐溅裾。\n恶况横陈费料理，枯棋浊酒有驱除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦雨次前韵四首 其一","author":"陈造","text":"雨脚波头远接连，衣寒础润犯梅天。\n谁怜旅食缁尘客，日问珠炊与桂然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中题柏氏壁二首 其二","author":"陈造","text":"苏端颇惯招新客，御叔何烦讶圣人。\n未用平章旧新雨，一樽聊喜对情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中题柏氏壁二首 其一","author":"陈造","text":"行寻诘屈蹑崎岖，已谢邻翁果下驹。\n北走松楸无数里，杖藜筋力尚枝梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临泽寺留题","author":"陈造","text":"发冢诗书谩一官，旧游重到鬓毛斑。\n尘埃可是山灵意，不待文移始厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侯拉客归置饮再次韵","author":"陈造","text":"将军恩意为谁长，酒未阑残日脚黄。\n傥有春风四弦手，真成留客醉浔阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵四首 其四","author":"陈造","text":"病肺还孤竹叶青，小园春去尚深扃。\n春衫红药强相比，婢子可怜无性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵四首 其三","author":"陈造","text":"十里髻鬟谁绾结，半天苍翠自嶙峋。\n教儿莫惮依山住，阔领裁衣尽土人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵四首 其二","author":"陈造","text":"昔上瞿塘滟预堆，盘涡如井放船开。\n山行欢喜今非错，备见梢濆撇漩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵四首 其一","author":"陈造","text":"诸李辞章推李白，向来蜀道赋噫吁。\n房陵山险犹如许，石穴巴邛定不诬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客夜不寐四首 其四","author":"陈造","text":"飞腾志意老来休，却听鸡声吟掉头。\n催雪忆梅还得句，到家准拟阿儒求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客夜不寐四首 其三","author":"陈造","text":"清樽黄卷交期绝，芋火前头老懒残。\n赖有平生短檠在，一灯明灭伴更阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客夜不寐四首 其二","author":"陈造","text":"阵鸿轇轕上云衢，梦欲成时每破除。\n少睡更堪寒夜永，新来熟遍少时书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客夜不寐四首 其一","author":"陈造","text":"久客情悰苦鲜欢，园林摇落菊花残。\n北风作意吹霜晓，又报江梅一信寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客枕不寐二首 其二","author":"陈造","text":"嗢喔邻鸡几番鸣，琤撞江浪欲无声。\n拥衾宁复还家梦，望杀东窗未肯明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客枕不寐二首 其一","author":"陈造","text":"老羡平生睡作魔，矧因多病覆金荷。\n起凭曲几频搔首，如此迢迢良夜何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴二首 其二","author":"陈造","text":"园林桃杏已无馀，雨挟春寒擅晓晡。\n芍药红悭犹料理，海棠娇甚可枝梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒六首 其三","author":"陈造","text":"衰年心绪自低摧，可是青春昧一来。\n几日不教书作祟，为留病眼向花抬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒六首 其二","author":"陈造","text":"稍稍春光到眼中，冲寒试与小支筇。\n杏花已尾樱桃拆，正要深红间淡红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒六首 其一","author":"陈造","text":"扫雪阶头晓未乾，东风作恶鼻仍酸。\n西园点检江梅后，祇有樱桃不避寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒六首 其六","author":"陈造","text":"平明欲敛云复厚，薄晚未休风更颠。\n老怯春寒不宜出，下帷添火拥书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒六首 其五","author":"陈造","text":"清明寒食经旬是，笑问风寒更几馀。\n小杏惜香春恰恰，新杨弄影午疏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒六首 其四","author":"陈造","text":"去年秫地伤秋潦，春酒浇醨不可亲。\n红树梢头山鸟语，祇应笑我独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暖赠梅喜作二首 其二","author":"陈造","text":"手撚芳枝酹渌樽，东君乃有发生恩。\n即今省暖铜瓶水，罗幕围香共晏温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暖赠梅喜作二首 其一","author":"陈造","text":"晴日烘开栗玉葩，懒随霰雪送年华。\n淮乡地冷开虽晚，竟是人间第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼过荷叶浦二首 其二","author":"陈造","text":"一舟失得关生死，中夜何人肆夺攘。\n外此湖江多乐土，忆常通夕听渔榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼过荷叶浦二首 其一","author":"陈造","text":"荷叶浦边支港多，凶人出没土人窝。\n故人饭我非留滞，月黑天阴免夜过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相如二首 其二","author":"陈造","text":"逸德狂情赖补苴，文君端合婿相如。\n白头曲里殷勤意，不愧先生谏猎书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相如二首 其一","author":"陈造","text":"中宵卒卒去临邛，卖酒垆边混僦佣。\n想见令君醒后意，向人深悔谬为恭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵介卿见简解嘲二首 其二","author":"陈造","text":"酒家旧识玄真子，街吏尝随杜牧之。\n回首昔游堪一笑，暮年茶果祇僧期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵介卿见简解嘲二首 其一","author":"陈造","text":"复閤朱楼绣箔褰，蕙兰风处各婵娟。\n诗翁它日扬州梦，回施京华美少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵园饮三首 其三","author":"陈造","text":"酒边容角少年狂，扶路归来兴未央。\n羡杀雄蜂雌蛱蝶，月膏烟腻宿花房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵园饮三首 其二","author":"陈造","text":"收藏春色驻年华，珍重王孙好事家。\n肯挽归骖共良夜，一天风露一林花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵园饮三首 其一","author":"陈造","text":"不谓东君雨后春，尚多红紫待游人。\n天香更有西京种，来伴宾筵笑脸新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵通判有诗次韵二首 其二","author":"陈造","text":"短歌对酒不能长，犹胜车尘扑面黄。\n我自关门宝崇鼎，从渠睎价尚咸阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵通判有诗次韵二首 其一","author":"陈造","text":"霍王无短似无长，惊见新诗写硬黄。\n鱼在九渊终玉食，世间濡足羡浮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴子隆节推之官信州五首 其五","author":"陈造","text":"连城照乘动分珍，他日词坛著散人。\n诗笔有神官有暇，楚鳞燕翼要频频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴子隆节推之官信州五首 其四","author":"陈造","text":"幕中婉画得斯人，郡政应从到日新。\n银錵金苗休刺口，祇将耕稼富州民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴子隆节推之官信州五首 其三","author":"陈造","text":"共把离杯柳影边，柳枝如线拂归船。\n枝枝似恨人轻别，颦不成眠更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴子隆节推之官信州五首 其二","author":"陈造","text":"行行幕府泛莲初，井井官曹游刃馀。\n当路急贤饥渴似，不须衔袖子公书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴子隆节推之官信州五首 其一","author":"陈造","text":"人生穷达后愚贤，宦路何妨小著鞭。\n三釜吾今嗟弗洎，奉亲东下羡登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送鹌鸭腊龚养正二首 其二","author":"陈造","text":"骚人茹粥耐支离，过眼风光不到诗。\n乡味慇勤劝开肉，未妨新句解人颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送鹌鸭腊龚养正二首 其一","author":"陈造","text":"霜湖风草自徜徉，夜网晨弦不易防。\n作意分甘资一饱，为撩清梦到江阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋鹤飞来作三诗还之 其一","author":"陈造","text":"倒颊翘然望四遐，芝田悬圃不应赊。\n仙仙飞傍茅茨下，误认西湖处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋鹤飞来作三诗还之 其三","author":"陈造","text":"君家矫矫乘轩骨，闻道今成赵璧回。\n却拟黄堂掣铃问，夜光论斗几时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郢州守风二首 其二","author":"陈造","text":"瓮盎轰豗恣击撞，佩环时亦奏铿锵。\n风涛欲静犹须怒，一付天吴自抑扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]