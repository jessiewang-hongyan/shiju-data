[{"title":"白苧岭雨大作云此道可免舟行","author":"陈宓","text":"空囊带雨肩山重，滑屦登高上壁难。\n遵陆乘桴俱有恨，都缘何事不求安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凫茈饷王丞","author":"陈宓","text":"仙溪剩得紫琅玕，风味仍同荔子看。\n何似清漳霜后橘，野人还敢荐君盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同柯兄游东湖","author":"陈宓","text":"荷张万盖迎仙舰，葵卷千旗拥将坛。\n顾我从来嗤羽化，饱看仍不负空餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同潘丈游东平瀑 其三","author":"陈宓","text":"水深厉涉祇肩舆，未信当年子产疏。\n到得中流心不竞，等闲一叶去凌虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同潘丈游东平瀑 其二","author":"陈宓","text":"喧天动地作惊霆，生定中扃转更宁。\n三叠飞泉凝似雾，却疑石转解过灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同潘丈游东平瀑 其一","author":"陈宓","text":"天公特地放初晴，许我联镳琬琰行。\n新著茅亭凭到晚，难将一字扁佳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后堂木芙蓉","author":"陈宓","text":"红葩翠竹与齐肩，为问霜枝已几年。\n一色碧天红烂熳，卧看疑在鉴湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回吴信可谢寄唐人诗","author":"陈宓","text":"忽传佳句到深林，总是铿金戛玉音。\n长恨古人今不见，由来今古一般心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"在旅不在家书","author":"陈宓","text":"无心览卷谩舒卷，有念盈怀日往来。\n十日离家劳梦远，一行无字彊颜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 劝孝养","author":"陈宓","text":"父母辛勤养汝身，直须五鼎奉双亲。\n有田若不勤耕稼，菽水犹亏岂是人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 劝种植","author":"陈宓","text":"是处荒山欲接天，土膏如面草如毡。\n及时便种松杉子，远计收功只十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 劝息讼","author":"陈宓","text":"田夫所入最为艰，终岁辛勤不得闲。\n劝尔小争须隐忍，破家只在片时间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 劝耕荒田","author":"陈宓","text":"七闽寸土直钱多，况是泉山价倍高。\n怪尔小民无别业，如何荒亩长蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪鹿鸣呈诸先辈","author":"陈宓","text":"威凤来翔羽翼新，蓝溪风气益温醇。\n彤墀看唱三名外，璧水犹登四十人。\n仙李蟠根连月窟，桂枝平步折天津。\n雪窗莫忘辛勤日，省酒簪花曲水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平书院落成柬诸友 其一","author":"陈宓","text":"当日二程门下士，独分此道过来南。\n百年世事相传处，书院天生著剑镡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平书院落成柬诸友 其二","author":"陈宓","text":"群峰九叠势来雄，直作吾儒五亩宫。\n隔断市廛才一水，读书如坐万山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平六月祈雨感应赓林堂长韵","author":"陈宓","text":"唤起神龙百里来，中肠一夜九萦回。\n天心自为民心动，多谢诸贤举贺杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平凤山","author":"陈宓","text":"洞中流水云门乐，崖上寒莎伏帝裳。\n觌面突高三百尺，拟将金薤托琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其三 流杯石","author":"陈宓","text":"清波映文石，置此亦奇事。\n年年上巳时，聊将姓名记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其十 第一溪山","author":"陈宓","text":"溪山号清绝，自古产奇人。\n可惜吾夫子，南来不到闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其八 绿净","author":"陈宓","text":"清池绿如染，到此颜为破。\n幸有诗仙来，珠玑剩教唾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其十三 紫气","author":"陈宓","text":"三尺有正气，外邪何可干。\n功用虽未见，韬藏谁将看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其七 群仙观","author":"陈宓","text":"北山尽环合，柔岚轻杂云。\n一峰自能好，况此玉成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其十一 熙春台","author":"陈宓","text":"我乘凋瘵后，未省见花开。\n安得一千里，同携登此台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其二 橘轩","author":"陈宓","text":"当年初种时，四老戏其中。\n何如与我辈，坐对霜天红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平呈潘王二丈 其二","author":"陈宓","text":"一水萦纡玉带环，杂花妆点四时间。\n欲知招演堂中境，便是水栀盆里山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平呈潘王二丈 其一","author":"陈宓","text":"小楼中峙万峰环，正值青螺取巧间。\n坐待清风送明月，等闲高枕对溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平郡学有小阁予名之曰穹林云壑和叶教韵 其二","author":"陈宓","text":"山水胡为仁智好，正缘真味少人知。\n曲肱饮水忘言处，更著胸中此段奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平郡学有小阁予名之曰穹林云壑和叶教韵 其三","author":"陈宓","text":"雨过岚光偏澒洞，月来林影更清深。\n幽禽忽坠铿然韵，便是天然绿绮琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平郡斋分韵","author":"陈宓","text":"百年琢就流杯石，来泛清波未半时。\n幸有九贤俱毕集，却嫌当坐欠羲之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平得雪 其三","author":"陈宓","text":"凌晨讼牒如山积，呵手移时为破除。\n幸有清溪明似镜，忍休偷眼雪晴馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平得雪 其二","author":"陈宓","text":"丰穰已喜新年瑞，冻馁还思卒岁难。\n安得长缣并广庾，为渠千里作衾箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平得雪 其四","author":"陈宓","text":"衍山先自无尘土，更著飞琼细糁看。\n可笑一生缘好事，却将衰鬓敌隆寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平得雪 其一","author":"陈宓","text":"连年疾疠缘何事，祇为天时太暖生。\n今日六花初献瑞，定知田里顿身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平倅厅十咏 其六 飞霞","author":"陈宓","text":"小阁本非宽，宇宙在其内。\n心与太初邻，不假飞霞佩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平倅厅十咏 其九 天开图画","author":"陈宓","text":"通衢亘其南，危楼冠其北。\n如何境日新，烟云为笔墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平倅厅十咏 其二 尘表","author":"陈宓","text":"南山正相值，虚阁出林杪。\n不待清风生，脩然游八表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a2