[{"title":"吉水夜泊","author":"真山民","text":"入夜始维舟，黄芦古渡头。\n眠鸥知让客，飞过蓼花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年少春游","author":"真山民","text":"锦袍朱带玉花骢，著意追欢紫陌东。\n只道春风属杨柳，不知杨柳有秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百舌","author":"真山民","text":"花间报晓晴，巧弄百般声。\n未可嫌饶舌，犹胜雁不鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观书自叹","author":"真山民","text":"皓首抱遗经，堪怜误一生。\n空共蠹虫饱，自作忍饥声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴王夜宴图","author":"真山民","text":"银漏迢迢夜未晨，管弦声里绮罗春。\n饮阑方拥名娃醉，岂料稽山正卧薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨妃","author":"真山民","text":"三郎掩面马嵬坡，生死恩深可奈何。\n瘗土驿傍何足恨，潼关战处骨埋多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春闺词","author":"真山民","text":"愁锁眉尖未肯消，何心更待两蛾娇。\n一春螺黛浑无用，付与东风染柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游阻雨次韵","author":"真山民","text":"田里熙熙便是春，追游何必艳阳辰。\n打门吏少花村静，听雨高眠亦可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草","author":"真山民","text":"草枯根不死，春到又敷荣。\n独有愁根在，非春亦自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高帝","author":"真山民","text":"未央前殿养亲时，想记当年俎上危。\n借问杯羹何等语，如今安用玉卮为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"真山民","text":"未暝先啼草际蛩，石桥暗度晚花风。\n归鸦不带残阳老，留得林梢一抹红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅仙山","author":"真山民","text":"西都不知寿，安用独长年。\n纵有丹炉在，难吹汉火燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萤火","author":"真山民","text":"微踪一腐草，霜重不禁秋。\n想悟浮生短，常为秉烛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新年","author":"真山民","text":"妆点春光到眼边，冻消残雪暖生烟。\n杏桃催换新颜色，惟有寒梅老一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉馀再赋","author":"真山民","text":"堪叹诗翁酒兴豪，醉馀犹复一登高。\n西风抵死相摇撼，争奈儒冠裹得牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山旅夜","author":"真山民","text":"独坐本无况，凄凉更旅中。\n槛低檐碍月，窗破纸吟风。\n邻馆笛三弄，谯楼鼓二通。\n半觞聊自适，新荔擘轻红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山人家","author":"真山民","text":"片云隔断嶂西峰，三两山花屋角红。\n几亩桑麻春社后，数家鸡犬夕阳中。\n拾薪涧底青裙妇，倚杖檐间白发翁。\n我亦愿来同隐者，种桃早晚趁东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"真山民","text":"林梢初日弄阴晴，露浥溪花笑欲迎。\n涧暗只闻泉滴沥，山青剩见鹭分明。\n远峰忽转还如绕，险径徐行亦似平。\n莫谓诗成无与和，风篁也解作吟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山亭避暑","author":"真山民","text":"怕碍清风入，丁宁莫下帘。\n地皆宜避暑，人自要趋炎。\n竹色水千顷，松声风四檐。\n此中有幽致，多取未伤廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹山书堂","author":"真山民","text":"作室悬知要肯堂，而翁家学颇增光。\n一朝衿佩儒簪合，千古诗书屋壁香。\n鉴曲烟霞归羽馆，钟山风月落僧房。\n如何只揭精庐扁，解续斯文气燄长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王廉使","author":"真山民","text":"鼻祖名高三谏官，耳孙玉立又台端。\n气增浙左霜威动，面带终南山色寒。\n揽辔肯教狼卧地，归班便合豸峨冠。\n公馀诗兴清于雪，细嚼梅花入肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东粤庙","author":"真山民","text":"颓阑斜照网蛛丝，陈迹凄凉万古悲。\n柘水尚鸣亡国怨，山松曾见受封时。\n碑因苔蚀无完字，城为田侵失旧基。\n当日东瓯知几战，如今赢得一荒祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰溪舟中","author":"真山民","text":"一舸下中流，西风两岸秋。\n橹声摇客梦，帆影挂离愁。\n落日鱼虾市，长烟芦荻洲。\n篙人夜相语，明发又严州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬雪","author":"真山民","text":"雪冻飞禽少，林深落叶多。\n寒塘倒山影，空谷答樵歌。\n不有梅花在，其如诗思何。\n霜风吹落帽，应叹鬓丝皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬暮小斋","author":"真山民","text":"布袜青鞋敝絮袍，松扉柴几小衡茅。\n云酣才酿臈三月，梅吐又横春一梢。\n炭为骤寒偏索价，酒因不饮懒论交。\n穷年兀兀从人笑，未用多方作解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣果院访忠上人不值","author":"真山民","text":"管领东风入杖藜，落梅香里已招提。\n苔痕一径白云湿，花影半窗红日低。\n欲见高僧聊尔耳，便乘馀兴去来兮。\n葛藤有话无人共，付与隔林幽鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平章命","author":"真山民","text":"万甲蟠胸老气雄，将星光照海云东。\n声名宣尉裴中立，地步平章韩魏公。\n大纛高牙山水县，褒衣博带藻芹宫。\n书生端为斯文喜，俎豆先行军旅中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永嘉秋夕","author":"真山民","text":"风战枯桐敲纸窗，拥裘无寐夜偏长。\n樵楼三鼓夜将午，云雁数声天正霜。\n寓世此身惊逆旅，宽怀何处不吾乡。\n江头风景日堪醉，酒美蟹肥橙橘香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光霁阁晚望","author":"真山民","text":"一阁纳万象，危阑俯渺茫。\n白沙难认月，黄叶易为霜。\n宿鸟投烟屿，归樵趁野航。\n孤吟谁是伴，渔笛起沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴福寺","author":"真山民","text":"为厌市喧杂，携诗来此吟。\n鸟声山路静，花影寺门深。\n楼阁庄严界，池塘清净心。\n松风亦好事，送客出前林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁除寄王中斋","author":"真山民","text":"徂岁已匆匆，何人似此翁。\n事虽随世异，道不与冬穷。\n身老心犹壮，髯斑脸自红。\n椒花一杯酒，明日又春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱溪涧","author":"真山民","text":"路转峰回又一村，天寒大半掩柴门。\n云融山脊岚生翠，水嚼沙洲树出根。\n任拥重裘风亦冷，未投荒店月先昏。\n今宵只傍梅花宿，赢得清芬入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次李林居春晓游园","author":"真山民","text":"灭没晨曦弄淡晴，追随杖履竹间亭。\n花逢酒侣容先醉，柳见诗人眼剩青。\n三月光阴半流水，百年身世一浮萍。\n啼鹃只管催春去，不道衰翁已怕听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵章剑溪山居","author":"真山民","text":"想无书赴陇，林鹤莫惊猜。\n曳杖云同出，开帘山自来。\n池堪供洗砚，篱不碍观梅。\n静倚长松立，藤花点翠苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘恕堂见寄","author":"真山民","text":"抱瓮区区老汉阴，空斋拥鼻日长吟。\n青山隔截市朝面，白发消磨豪杰心。\n书既无成休学剑，贵无可买耻言金。\n情知不入鸳鸾侣，赖有鸥盟尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江头春日","author":"真山民","text":"风煖旗亭煮酒香，醉醒始悟是他乡。\n驾言行迈路千里，岂不怀归天一方。\n春事渐消莺语老，离愁偏胜柳丝长。\n无聊莫向城南宿，淡月梨花正断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江楼秋夕","author":"真山民","text":"楼高古城绕，无奈漏声催。\n幽梦风吹断，新吟月送来。\n江长渔唱远，云冷雁声哀。\n明日重阳酒，黄花开未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自适","author":"真山民","text":"年来心迹两悠悠，若比孤云尽自由。\n既不贪荣安有辱，纵饶无乐亦何忧。\n一丝风月严陵钓，千里关山季子裘。\n到底行藏定谁是，试将心事问沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中峡口","author":"真山民","text":"乱山如碧玉，处处见鹃花。\n水涨傍分港，舟行倒走沙。\n宿依沽酒市，饭过钓鱼家。\n喜脱风波险，推篷数暝鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖图","author":"真山民","text":"两袖春风一杖藜，等閒踏破柳桥西。\n云开远嶂碧千叠，雨过落花红半溪。\n青旆有情邀我醉，黄莺无恨为谁啼。\n东城正在桃林外，多少游人逐马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵后刘秀宽见过","author":"真山民","text":"冉冉岁云暮，閒居安所之。\n途穷身是累，痛定语犹悲。\n衰鬓数茎雪，空囊一卷诗。\n儒衣例如此，惜也不逢时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵后寓舍送春","author":"真山民","text":"触景多怀旧，凭栏易怆神。\n飞花游荡子，古木老成人。\n世换山如醉，田荒草自新。\n乡关渺何处，回首暗风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初冬","author":"真山民","text":"林叶新经数夜霜，地炉独拥一山房。\n尘书邀我共高阁，浊酒劝人归醉乡。\n费省家贫还似富，身閒日短亦如长。\n梅花苦欲催吟兴，又破梢头半点香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"真山民","text":"一叶薰风带暑回，雨添浓翠暗庭槐。\n不随春去莺犹在，好竞时妆榴又开。\n剪尺旋栽新白苧，杯盘聊荐旧青梅。\n箧中敝扇投閒久，依旧团团入手来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏访刘道士","author":"真山民","text":"白云随杖履，伴我到山房。\n暑薄疑天别，林深见路长。\n朮芝皆道味，花竹亦诗香。\n更待荷花后，来分半榻凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙因寺次施敬所韵","author":"真山民","text":"松萝一径阴，踏破白云深。\n约客分茶供，逢僧倚竹吟。\n鼠留香篆迹，禽和阁铃音。\n话久不知晚，新萤照出林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李修伯山居 其二","author":"真山民","text":"寒灯几拨尽，借问夜何其。\n旧梦青灯在，新愁白发知。\n昔为三绕鹊，今作五藏龟。\n多谢梅梢月，留人得睡迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李修伯山居 其一","author":"真山民","text":"俗子自不到，幽扉何必扃。\n苔衣和月卧，山雨杂泉听。\n有发徒斑白，无名入汗青。\n未应閒此事，尚可扫玄经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜鹃花得红字","author":"真山民","text":"愁锁巴云往事空，只将遗恨寄芳丛。\n归心千古终难白，啼血万山多是红。\n枝带翠烟深夜月，魂飞锦水旧东风。\n至今染出怀乡恨，长挂行人望眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连城春夜留别张建溪","author":"真山民","text":"飞絮游丝客子心，连城那忍遽分襟。\n青灯应见诗情苦，浊酒不如交味深。\n一榻暖风栖竹屋，半阑淡月立花阴。\n离怀今夜先收拾，尽付明朝马上吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒中","author":"真山民","text":"敢咎章缝解误人，甘于閒处著閒身。\n腹中书在温仍熟，梦里诗成记不真。\n引鹤徐行三径晓，约梅同醉一壶春。\n今朝有喜谁知得，新换衔头号散民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒吟初冬","author":"真山民","text":"一架琴书一笔床，杜门荏苒送年光。\n囊空尽可偿诗债，脚倦犹能入醉乡。\n既老菊花偏耐久，未开梅蕊已先香。\n眼边管领閒风景，不识人间更有忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居","author":"真山民","text":"虚明两竹窗，济楚一书房。\n风动鸟移树，花香蝶过墙。\n身安知病少，昼静觉春长。\n未必全无事，终焉也胜忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居漫赋","author":"真山民","text":"纷纷裘马走红尘，赖得閒边可著身。\n商岭定无屠狗客，云台岂有钓鱼人。\n溪山萧散青芒履，风月夷犹乌角巾。\n万事如棋君看取，一番局面一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐","author":"真山民","text":"匹马平生汗漫游，如今寂寞老林楸。\n小窗半夜青灯雨，幽树一庭黄叶秋。\n懒看世情宁睡去，怕伤时事莫吟休。\n寒蛩可是知人意，未到莎根只说愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮赵园次徐君实韵","author":"真山民","text":"银台绛蜡泪成堆，四面轩窗尽放开。\n花影忽生知月到，竹梢微响觉风来。\n豪挥彩笔诗千首，醉倚红妆酒百杯。\n游玩未阑归未得，高城漏箭几相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜话无上人房","author":"真山民","text":"蒲团一榻上，坐到夜将分。\n窗月灯昏见，岩泉雨歇闻。\n茶瓯胜饮酒，禅语当论文。\n只恐红尘迹，涴师松下云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和颇动游兴呈云耕叔祖","author":"真山民","text":"节遇中和景渐暄，自摩倦眼望前村。\n雕锼花柳春无迹，沐浴山川雨有恩。\n忆昔踏青终日醉，如今垂白几人存。\n未应便作衰翁看，藉草犹堪倒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上偶成","author":"真山民","text":"长夜更难晓，天寒吟思清。\n梦魂山馆枕，灯影雪窗檠。\n守拙疏生理，安贫识世情。\n凄风响檐竹，岂是不平声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊白沙渡","author":"真山民","text":"日暮片帆落，渡头生暝烟。\n与鸥分渚泊，邀月共船眠。\n灯影渔舟外，湍声客枕边。\n离怀正无奈，况复听啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊舟严滩","author":"真山民","text":"天色微茫入暝钟，严陵滩上系孤篷。\n水禽与我共明月，芦叶同谁吟晚风。\n隔浦人家渔火外，满江愁思笛声中。\n云开休望飞鸿影，身即天涯一断鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述怀","author":"真山民","text":"不敢尤人敢怨天，愁来觅酒醉来眠。\n五穷有鬼遍相虐，九转无丹别自全。\n游食惧违新下令，力耕苦乏旧存田。\n灵台坐受忧兵触，荏苒霜华剥鬓玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江晓行","author":"真山民","text":"茅舍乱鸡声，疏林淡见星。\n霜轻留草绿，雾暗失山青。\n踪迹去来燕，交游聚散萍。\n浮生原是客，不必恨飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"修真院访崔道士","author":"真山民","text":"竹扉苍藓墙，林下小丹房。\n风定香烟直，月斜帘影长。\n瀹茶泉味别，点易露痕香。\n安得栖尘外，求师却老方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中临归仍送游教谕","author":"真山民","text":"建括相望天一涯，快哉此地话襟期。\n芹边春煖几杯酒，门外月高千首诗。\n去去先生此休矣，栖栖游子暮何之。\n送行折了邮亭柳，归卧白云歌紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中遇乡友季芳远归省亲","author":"真山民","text":"河梁邂逅话襟期，猎猎西风透裌衣。\n酒脸未随红叶醉，乡心先逐白云飞。\n客中送客难为别，山上安山胡不归。\n借使家书君可寄，此间无复问庭帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽兴","author":"真山民","text":"不赋千钟赋一箪，天公有意养痴顽。\n书犹能看未曾老，诗亦莫吟方是閒。\n宽著庭除贪贮月，少栽竹树要观山。\n空阶两日无行迹，又上苔花几点斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居杂兴","author":"真山民","text":"松桂小菟裘，山扉幽更幽。\n蜂王衙早晚，燕子社春秋。\n鬓秃难遮老，心宽不贮愁。\n年来把锄手，无复揖公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖","author":"真山民","text":"鹤护松扉久不开，蒲团端坐思悠哉。\n故交只向梦中见，閒事不经心上来。\n双屐蹑云春采药，一筇拄月夜观梅。\n东风似见山童懒，自与幽人扫径苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"真山民","text":"韶光今几许，我欲问流莺。\n花影扫不去，草根锄又生。\n心空诸妄息，身老万缘轻。\n正是春风好，幽兰不肯争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]