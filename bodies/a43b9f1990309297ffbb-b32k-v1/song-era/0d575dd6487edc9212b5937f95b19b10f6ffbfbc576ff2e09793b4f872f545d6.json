[{"title":"偈颂七十二首 其三","author":"释祖钦","text":"玉树琼林，宝阶银阙。\n皓若芦花，恍然明月。\n直钩垂钓，自有金鳞上钩。\n地平如掌，依旧七凹八凸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其三十","author":"释祖钦","text":"量外机，格外句。\n凡圣迷魂，佛祖罔措。\n有来由，无本据，声前切忌错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其五十一","author":"释祖钦","text":"洪蒙未判绝疏亲，毕竟难将事理分。\n夜半正明还不露，金刚脑后铁昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释祖钦","text":"尪羸面孔，蹊跷肚肠。\n忧愁苦恼，诈病在床。\n说离生死妙法，一默无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠性上人","author":"释祖钦","text":"惠性忽通，差别无碍。\n七纵八横，得大自在。\n向微尘里转浑身，影落五湖云水外。\n问时人，会不会。\n明白一句子，卞璧无瑕，骊珠绝颣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠洪上人","author":"释祖钦","text":"洪濛既判，惠然红日。\n天地开明，即心是佛。\n尘沙刹海，遍界发辉。\n一丝毫头，昧之不得。\n却须直下掀翻，休为知见所执。\n受用只此平常，更无玄妙奇特。\n若是衲僧门下，难免痛棒三十。\n目今且赠四藤，任便东西南北。\n回首集云峰，面前青突兀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普义上人","author":"释祖钦","text":"云门普，赵州无。\n二字一义，茄子落苏。\n提起便会，直入圣贤阃域。\n声前拟议，未免者也之乎。\n且听端的下个注脚，俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智远上人","author":"释祖钦","text":"智聪则远，机圆自转。\n似走盘珠，如万花苑。\n开落不在春秋，动静不滞去留。\n云悠悠，水悠悠。\n天外月如钩，雪峰衮出三个木毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智坦西堂请","author":"释祖钦","text":"大智洞明，大道坦平。\n生铁面具，不近人情。\n云峰日朗，雪谷雷鸣。\n激起曝腮焦尾，同跃天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳赞二首 其二","author":"释祖钦","text":"离离披披破骨董，补一孔了又一孔。\n三竿红日透篱边，看来何止七斤重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳赞二首 其一","author":"释祖钦","text":"穴鼻针，无缝袄。\n一线红日头，联得似恰好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋圆觉经","author":"释祖钦","text":"大虚圆满，妙觉混融。\n如春化物，和而不同，力不在东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道可道者","author":"释祖钦","text":"道可道，非常道。\n名可名，非常名。\n名既非常，如器中锽。\n道既非常，如日之光。\n如器中锽，声出于内。\n如日之光，光照无方。\n夫如是乃可称有道之者，非独善一身，而达之万邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嗣牧上人","author":"释祖钦","text":"先以放，嗣以牧。\n两鼻穿，四蹄秃。\n有阑圈，无拘束。\n山自青，水自绿。\n从来饥饱不相干，幻泡影中休碌碌，单单赢得这题目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德富藏主请","author":"释祖钦","text":"巍巍堂堂，炜炜煌煌。\n佩小释迦悬记，身穿御赐衣黄。\n人言有德可富，自羞伎俩寻常，萧萧两鬓风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题罗汉手轴","author":"释祖钦","text":"松风浩浩，涧水潺潺。\n白云影里，枯木寒岩。\n十八高人，行住坐卧，神通游戏其间。\n龙耳无听，虎体元班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖机上人","author":"释祖钦","text":"灵妙之机，佛祖莫知。\n疾则蹉过，迟非所宜。\n灵在自己，妙在日用。\n吃饭著衣，一静一动。\n动静两忘，波停岳耸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十六","author":"释祖钦","text":"水不洗水，金不博金。\n青天白日，自古自今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十四","author":"释祖钦","text":"万化之源，万物之母。\n德被河沙，量包海宇。\n圣中之圣，主中之主。\n庆会一时，寿崇千古。\n以坤自贵，月朗太虚。\n以乾为子，红日卓午。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十九","author":"释祖钦","text":"丁一卓二，见三下三。\n和盘掇转，地覆天翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十八","author":"释祖钦","text":"皇图更统，佛运亦新。\n四海八蛮，咸倾化日，穷岩绝壑，共舞阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十七","author":"释祖钦","text":"事有万殊，法无异说。\n寒但言寒，热但言热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十","author":"释祖钦","text":"闰月月望，月即寻常。\n云埋即闇，云散即光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五","author":"释祖钦","text":"济北之道，出乎平常。\n语默动静，脱体全彰。\n三玄三要，松直棘曲。\n四宾四主，凫短鹤长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十四","author":"释祖钦","text":"元宵令节，且喜天晴。\n高烧银烛，照佛光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十五","author":"释祖钦","text":"群阴剥尽，一阳复来。\n万顷清湘，寒冰发焰。\n千年古柏，枯干花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十三","author":"释祖钦","text":"只闻子声，不见子形，忒煞分明。\n只得其体，不得其用，可煞现成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十一","author":"释祖钦","text":"黄面老子，六载辛勤。\n寻得鼻孔，打失眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十","author":"释祖钦","text":"晓天月白，古岸舟横。\n一阳来复，吾道大亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十五","author":"释祖钦","text":"南薰入奏，殿阁生凉。\n西来祖意，切忌商量。\n向下文长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其十七","author":"释祖钦","text":"发越朕兆，未形消息。\n提持佛祖，未行号令。\n虚空斫额，万象拱听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其四十五","author":"释祖钦","text":"动即影现，觉即冰生。\n见闻俱尽，视听如盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其六十三","author":"释祖钦","text":"形名未立，朕兆未分。\n全无巴鼻，彻底浑崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其二十八","author":"释祖钦","text":"电光莫追，石火犹迟。\n搆弗及处，心不可识，智不可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其九","author":"释祖钦","text":"白衣拜相，平地登仙。\n是人知有，别无秘传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其四十七","author":"释祖钦","text":"本无位次，不涉安排。\n泯然自尽，一种平怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其二十二","author":"释祖钦","text":"吃饭著衣，事事成现。\n俯仰折旋，一见便见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其二十四","author":"释祖钦","text":"山花似锦，涧水如蓝。\n面目现在，谁是同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其七十二","author":"释祖钦","text":"一种平怀，泯然自尽。\n明闇情忘，事理平等。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其六十一","author":"释祖钦","text":"动即影现，拂即成痕。\n听其自在，万法无根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其六十九","author":"释祖钦","text":"一有多种，二无两般。\n钩头识取，莫认定盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其六十七","author":"释祖钦","text":"寸长尺短，三平二满。\n觌面相呈，语言道断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十二首 其三十四","author":"释祖钦","text":"人与境空，境与人会。\n百尺竿头，一采两赛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啸岩居士请","author":"释祖钦","text":"湖山影里，水月光中。\n似我非我，朦朦胧胧。\n两眼平生四海空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智贤上人","author":"释祖钦","text":"智者必贤，正者不偏。\n平坦性地，朗我心天。\n折旋俯仰，诸佛现前。\n一光同照，万象枞然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道从上人","author":"释祖钦","text":"惟道是从，惟心是宗。\n空即是色，色即是空。\n梦幻了了，来去匆匆。\n水中之月，树上之风。\n作如是观，无塞不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"原妙侍者请","author":"释祖钦","text":"上大今已无人，雪岩可知礼也。\n虚名塞破乾坤，分付原妙侍者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一七","author":"释祖钦","text":"集云峰头独立，仰祝圣寿无极。\n百千甲子春秋，臣僧今日七十，乙酉正月初一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一九","author":"释祖钦","text":"一夜雨声滴滴，元是檐前雪消。\n冷地令人忆著，相国寺里芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十二","author":"释祖钦","text":"洗面摸著鼻孔，不知打破漆桶。\n园里蓬头道者，全无供养之心，烂却瓜秧瓠种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十九","author":"释祖钦","text":"修造工夫已辨，龙神土地亦安。\n因甚水云来往，尚如月晓星残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十","author":"释祖钦","text":"不冷不热炉鞴，半真半假金鍮。\n铸作瓶盘钗钏，却成品字柴头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十八","author":"释祖钦","text":"我此泼天门户，大地一网俱收。\n若是祥麟瑞凤，从教戴角擎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十三","author":"释祖钦","text":"海水不可斗量，虚空不可尺度。\n净地不可撒沙，烂泥不可著脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十三","author":"释祖钦","text":"丛林虽未整肃，更点却要分明。\n粒米须还粒饭，八两定要半斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞","author":"释祖珠","text":"月色照幽谷，泉声落断崖。\n水光山色里，一块烂枯柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题出山相","author":"释祖珠","text":"半夜逾城往雪山，龙楼凤阁绝跻攀。\n如今辊出草窠里，一个闲人天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释祖珠","text":"玉露垂青草，金风动白蘋。\n一声寒雁叫，唤起未惶人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释祖珠","text":"不是心，不是佛，不是物。\n沥尽野狐涎，趯翻山鬼窟。\n平田浅草里，露出焦尾大虫。\n太虚寥廓中，放出辽天俊鹘。\n阿呵呵，露风骨。\n等闲拈出众人前，毕竟分明是何物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释祖珠","text":"机前一句子，用处不留情。\n如撞幢子弩，箭箭中红心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其六","author":"释祖璿","text":"石羊头子向东看，大地茫茫被眼谩。\n月映寒潭清彻底，云收华岳露巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其三","author":"释祖璿","text":"直下是非著不得，著不得处好承当。\n木人昨夜通消息，南海波斯过大唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其四","author":"释祖璇","text":"大悲手眼问来亲，王老酬机列主宾。\n倒转钥头来快便，从兹六国绝烟尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其五","author":"释祖璿","text":"指出长生地不迷，造成无缝塔巍巍。\n大家从此无馀事，渴饮饥餐且度时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其一","author":"释祖璿","text":"尽却耳根并眼底，不知何处见如来。\n数声幽鸟啼寒木，一片闲云铺断崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其二","author":"释祖璿","text":"道吾作舞，一曲无谱。\n若将耳闻，未敢相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释祖璿","text":"吃粥了也未，赵州无忌讳。\n更令洗钵盂，太煞没巴鼻。\n悟去由来不丈夫，这僧那免受糊涂。\n有指示，无指示，韶石四楞浑塌地。\n入地狱，如箭射，云岫清风生大厦。\n相逢携手上高山，作者应须辨真假。\n真假分，若为论，午夜寒蟾出海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其七","author":"释胜","text":"乙巳大人丘，丛林为寇雠。\n利牙如剑戟，生杀有来由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其四","author":"释胜","text":"借路经过无面目，因邪打正有拳头。\n衲僧门下无干涉，徒用精金换得鍮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其三","author":"释胜","text":"脚踏清波分华岳，手擎红日转重云。\n徒劳谩费干戈力，究竟还归有道君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其五","author":"释胜","text":"无业何太切，白云何太孤。\n胡须将谓赤，更有赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其一","author":"释胜","text":"摩天鸩鸟九头毒，护世那吒八臂长。\n水自竹边流出冷，风从花里过来香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其十二","author":"释胜","text":"握七星刀寻作者，倒司农印对冤雠。\n当阳一句分宾主，九曲黄河水逆流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其十九","author":"释胜","text":"展事无回互，投机通一线。\n洞山无眼筋，入地狱如箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其十五","author":"释胜","text":"佛法无情报尔曹，忽生忽杀在吹毛。\n若教韩信得妙诀，自是深明防汉高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其十","author":"释胜","text":"问端如箭透垣墙，赖值灵云手段长。\n骏马蹇驴皆控勒，鞭教战胜出沙场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十四首 其八","author":"释胜","text":"行者失却眼，南泉破却锅。\n满堂僧不厌，一个俗人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]