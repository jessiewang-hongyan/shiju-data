[{"title":"题劳劳亭","author":"胡仲弓","text":"流水无情去不还，白杨青草满前山。\n古今多少兴亡事，人自劳劳亭自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题寿星寺杯泉","author":"胡仲弓","text":"勺水原来亦自多，便盈科后要如何。\n老龙岂是杯中物，放出长江与大河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈希夷睡图","author":"胡仲弓","text":"形睡神非睡，心閒身亦閒。\n是非都不管，高卧华州山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题宝叶笑端","author":"胡仲弓","text":"碧潭秋月句尤奇，系竹拈花总是诗。\n说著推敲便堪笑，问师端的笑何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题武适安宁卷","author":"胡仲弓","text":"听琴未了听吟声，泻出冰壶一片清。\n学到唐人超绝处，前身便是武元衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题高伯寿墨梅 其二","author":"胡仲弓","text":"生来洁白本无瑕，剪雪裁冰擅一家。\n堪叹俗流刚点涴，故将水墨写梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题高伯寿墨梅 其一","author":"胡仲弓","text":"才见梅花喜溢眉，无声诗索有声诗。\n自从即墨移来种，莫辨南枝与北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠岳仁叔","author":"胡仲弓","text":"不学弓刀破敌围，却拈刀笔学儿嬉。\n世间多少真豪杰，飘落江湖人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠易数朱俊甫","author":"胡仲弓","text":"三绝韦编及太玄，潜虚象数究先天。\n前人推算空劳力，不似而今卖得钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠郑琰","author":"胡仲弓","text":"狂风吹覆凤凰巢，鸮鬼朝翔狐夜号。\n君有胸中千古鉴，世间妍丑想难逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一第","author":"胡仲弓","text":"六年收一第，不特为荣身。\n殿下拜明主，堂前有老亲。\n衣冠新进士，湖海旧诗人。\n误入功名网，归来负钓纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"胡仲弓","text":"客中逢九日，此日倍思家。\n野店刍无味，疏篱菊未花。\n龙山孤节物，雁影各天涯。\n一路看秋色，微吟解叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元观灯","author":"胡仲弓","text":"月挂墙头杨柳枝，繁灯烂漫玉琉璃。\n绮罗尽学宫妆样，歌舞休传外国词。\n满路竞看花灼灼，故京谁念黍离离。\n他年同侍传柑宴，记取楼前掷果时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与石壁诸友山行分得山字","author":"胡仲弓","text":"藤萝纡古径，努力共跻攀。\n佛屋泉声落，僧窗云影閒。\n经残香篆冷，杯短锦囊悭。\n兴尽未归去，夕阳犹在山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与社友定花朝之约","author":"胡仲弓","text":"花朝曾有约，来此定诗盟。\n隐几江湖梦，闭门风雨情。\n身名千载共，心事一般清。\n且尽吟樽乐，徂徕不用赓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与瞻甫同访际书记","author":"胡仲弓","text":"销閒寻静处，古寺与居同。\n坐语僧窗日，行吟塔树风。\n香随薝卜化，句到葛藤空。\n未必西来者，能知一苇功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久客","author":"胡仲弓","text":"久作他州客，飘飘若转蓬。\n物华秋色里，心事杵声中。\n读易因知命，吟诗不讳穷。\n遣愁犹未了，一雁叫西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"胡仲弓","text":"世情纷醉梦，抱独入山林。\n有竹堪医俗，无弦谁赏音。\n松萝青嶂合，鸡犬白云深。\n未必幽居者，能赓梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中归呈友人","author":"胡仲弓","text":"拟结岩边草，怀君夜梦刀。\n山林胜朝市，道谊寄风骚。\n壮志贫难折，吟肩病越高。\n主人有公论，清气属吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中访枯崖归偶成","author":"胡仲弓","text":"寻僧归路远，策杖点苔痕。\n坐醉松间石，行吟郭外村。\n天风翻贝叶，海气润墙根。\n醉撚梅花笑，心期与子论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山台赴召","author":"胡仲弓","text":"世道今如许，先生亦肯来。\n一番新诏命，只是旧山台。\n心事云间鹤，诗情雪后梅。\n诸公兴党论，未可荐人材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行观紫云洞","author":"胡仲弓","text":"浪游知几载，久不到山巅。\n泉石曾留意，烟霞未有缘。\n松阴长匝地，塔颖欲钻天。\n待洗尘埃脚，重来访紫仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山村即事","author":"胡仲弓","text":"春风无厚薄，随分到山村。\n歌吹行南陌，鞦韆出短垣。\n稻田喧鸟雀，社鼓赛鸡豚。\n何事条桑月，人家紧闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居 其二","author":"胡仲弓","text":"山扉风自掩，地僻少将迎。\n奇字挑灯看，新吟击钵成。\n凤花开自落，萤草腐还生。\n静听邻琴响，疑调慢角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居 其一","author":"胡仲弓","text":"懒踏红尘路，山居世念轻。\n浇兰清夜气，撼竹引秋声。\n缺月当栏挂，閒云贴水轻。\n不知何处鹤，亦作太平鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山庵","author":"胡仲弓","text":"蒲团清夜话，吟鬓任鬅鬙。\n瀹茗迟留客，焚香静对僧。\n岚蒸侵砚版，月冷逼禅灯。\n万籁俱岑寂，呼童亦不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己酉上元诗同日立春","author":"胡仲弓","text":"又是京华见上元，一番灯火夺春寒。\n花蛾巧剪禁风扑，綵燕新裁带月看。\n客里无家愁对酒，吟边索句夜凭栏。\n寄言云雨休相妒，天下人人欲纵观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不饮","author":"胡仲弓","text":"之子青州裔，生来契分疏。\n难从将进酒，屡下绝交书。\n瓮面空浮蚁，樽前但取鱼。\n任他贤与圣，清浊不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为续芸赋","author":"胡仲弓","text":"芸居老衣钵，付与宁馨儿。\n旧种无多叶，生香不断枝。\n折芳归艺圃，剩馥入诗脾。\n粉省他年事，清名当自期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为源上人题宝叶","author":"胡仲弓","text":"宝莲千万叶，叶叶是如来。\n净土社中得，无波水上栽。\n根头藏舍利，香气避尘埃。\n移向松湾去，山花不敢开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"胡仲弓","text":"贫居无外事，图得念头清。\n冷眼观时政，平心阅世情。\n好花临水种，瘦竹傍墙生。\n自足供幽致，何须隐姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五峰岩","author":"胡仲弓","text":"开到荼蘼春事阑，又寻杖履看青山。\n人行瘦石枯藤上，路入蛮风瘴雨间。\n佛地平分天界限，道场元属鬼门关。\n野僧不会游人意，日未晡时及早还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"胡仲弓","text":"元日复元日，吟边阅岁华。\n浅斟浮柏叶，清坐对梅花。\n人事年年改，生涯步步差。\n诗情无厚薄，春意又萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"胡仲弓","text":"元日山堂罗俎豆，潜知木主亦悲辛。\n土瓜溪笋非乡物，脔肉村醪拟降神。\n尽日閒门无贺客，侵晨官道有行人。\n喜将弟妹同漂梗，綵服团栾寿老亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日次韵","author":"胡仲弓","text":"才书元旦帖，清事绕吟身。\n杖履堪行乐，箪瓢不似贫。\n灯花天外喜，池草梦中春。\n强饮酴酥酒，陶陶太古民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浴温泉","author":"胡仲弓","text":"万水皆清冷，温泉独尔奇。\n硫黄闻俗论，礜石见唐诗。\n鸥鹭何曾下，鱼龙定不知。\n无人发根本，空使世常疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分得台字走笔","author":"胡仲弓","text":"白云最深处，屐齿破苍苔。\n借榻寻僧话，携樽领客来。\n禽声喧竹坞，日影过花台。\n长啸下山去，犹倾凿落杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尤溪山中","author":"胡仲弓","text":"山中寒意足，自笑索裘迟。\n野店鸡声饭，颓垣鸦字诗。\n雨馀松径滑，溪涨板桥危。\n问讯恬轩老，乡邻总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昔","author":"胡仲弓","text":"忆昔岁云暮，狂吟天一涯。\n江湖聊寄迹，时节最思家。\n有担空行李，无盘可颂花。\n寒梅带香味，相伴守年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无尘殿","author":"胡仲弓","text":"劫灰飞不到，人迹少曾来。\n浪说珊瑚树，空涵玉镜台。\n洞虚风度竹，泉冷石无苔。\n汩汩樊笼者，何因避世埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王用和归从莆水寄呈后村","author":"胡仲弓","text":"江湖从学者，尽欲倚刘墙。\n自笑尘埃眯，难薰衣钵香。\n薜萝缘古树，桃李背春场。\n萤爝飘流去，能依万丈光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"车中遥观五峰","author":"胡仲弓","text":"五峰天外立，驴脚惯经过。\n十载身萍梗，今朝面薜萝。\n云低山色暗，风急树声多。\n蜡屐何时办，来听樵子歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长人诗","author":"胡仲弓","text":"裙长难掩膝，绝似汉金人。\n楼志幻全体，天丁现后身。\n眼高倾四海，力大引千钧。\n手挽银河水，来涓衣上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世途","author":"胡仲弓","text":"世途犹炙热，一雨便成秋。\n长啸风生腋，孤吟人倚楼。\n生涯付杯酒，清梦绕鱼舟。\n壮士悲何事，湖山忆旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙霞岭","author":"胡仲弓","text":"未了江湖债，风霜鬓欲华。\n吟身长是客，旅舍不如家。\n山色笼晴昼，湍声漱浅沙。\n不因缰锁絷，来此老烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代寿圆峤颜文昌","author":"胡仲弓","text":"长命新诗恰剪裁，瓣香南望祝蓬莱。\n千龄椿算从天与，九节蒲根著地栽。\n范不待年甘引去，文虽告老召还来。\n肉芝幸有丹书在，留取他年荐寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬雨即事寄赵默庵","author":"胡仲弓","text":"梅尚花时便作霖，儿童造化本无心。\n保身独鹤归华表，噤口群鸦集禁林。\n物态尽随时改变，天公不管世晴阴。\n绝怜西北风寒地，万骑屯中雪正深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行即事","author":"胡仲弓","text":"踏破几重云，来寻别墅春。\n促装童仆懒，题壁主人嗔。\n瘦岭盘山骨，枯藤络树身。\n野花长满地，不犯软红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"可山席上","author":"胡仲弓","text":"炉亭镇上坐书痴，不似山居得自怡。\n倾竹叶杯延旧友，倚梅花树看新诗。\n嚼来此味清于水，语对乡情甘似饴。\n外此不须谈近事，相逢一笑且舒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失脚","author":"胡仲弓","text":"失脚江湖久，忧时鬓欲皤。\n壮心驰北阙，痴梦绕南柯。\n万里关山远，一春风雨多。\n穷檐茅屋下，忍听扊扅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊午天基圣节口号","author":"胡仲弓","text":"瓣香三舞蹈，咫尺是天颜。\n雨露涵濡下，风云际会间。\n寸心瞻北阙，万寿祝南山。\n可是儒毡冷，堪陪玉笋班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧题宝胜寺壁","author":"胡仲弓","text":"十里湖光镜样平，银潢一带向东倾。\n寺从杨柳阴中出，僧在莲花会上行。\n佛地也容担板汉，梵音莫近采菱声。\n我来借榻醒尘梦，归去吟诗韵更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用后村韵送陈先辈","author":"胡仲弓","text":"休将心事问西邻，原宪长贫岂是贫。\n黄叶落边迷去路，白云飞处倍思亲。\n世间那得埋金者，原上空惭负土人。\n苦语只堪吾与汝，倚庐抱恨此情均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"胡仲弓","text":"移文火急报花神，好趁阳和去问津。\n未转头间犹是腊，一弹指顷便为春。\n梅先得志求专宠，柳亦趋时愿效颦。\n造化但随人事改，几回妆点几回新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和抱拙清源洞韵","author":"胡仲弓","text":"泉声一路和吟声，可是山云未放晴。\n倦客难攀千丈壁，游仙空负十年盟。\n草庐不信无龙卧，松径微闻有鹤鸣。\n此举羡君高著脚，山肴野蔌荐杯羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回文体二首 其二","author":"胡仲弓","text":"湾前过渡小舟虚，好景妆成天画图。\n山列翠屏开户牖，麦翻黄浪滚田圩。\n閒鸥乐处晴波细，暮鸟归边残日晡。\n攀柳共人人恨别，绵绵落絮有情无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回文体二首 其一","author":"胡仲弓","text":"红花濯锦织前山，日暖啼莺春昼閒。\n空院古廊风寂寂，僻居幽谷水潺潺。\n宫移旧曲新翻谱，酒晕浓愁浅带颜。\n同调赋诗吟思苦，匆匆急递走囊悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平舟中","author":"胡仲弓","text":"双桨去夷犹，延平津上州。\n英雄三尺剑，今古一潭秋。\n市近人争渡，山回水急流。\n前头风浪恶，莫放钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早过毫光岭","author":"胡仲弓","text":"轻烟护日晓霞明，身在毫光岭上行。\n虎过新蹄看未了，犬逢旧客喜相迎。\n摘来山栗连蓬买，采得溪芹带叶羹。\n一字推敲犹未稳，奚奴知我有诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感时事 其二","author":"胡仲弓","text":"近闻怒发欲冲冠，便有骅骝懒驾鞍。\n入洛几年为计密，擎天八柱果谁安。\n力排魏阙扶公论，人谓膺门出好官。\n犹幸甘陵无部党，不然世事不堪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感时事 其一","author":"胡仲弓","text":"湖滨别去五经秋，喜得閒居无悔尤。\n华藻不因焚砚弃，功名直待盖棺休。\n北山何假移文檄，西事犹堪借箸筹。\n四海茫茫才思竭，如君尚向古人求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次云心韵赠臞仙","author":"胡仲弓","text":"清修如野鹤，心性在云间。\n蔬食从来瘦，林居耐得閒。\n炉分真造化，梦绕旧乡关。\n汩汩尘樊者，闻风想厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次心泉卜隐韵","author":"胡仲弓","text":"诛茅法石巅，知己有青天。\n猿鹤寻前约，山林续旧缘。\n烟霞来枕上，风月绕吟边。\n窗户多栽竹，相期晚节坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次冯深居韵赠原上人","author":"胡仲弓","text":"净洗尘埃脚，时来访道林。\n但知谋隐是，何用入山深。\n瀹茗延新话，撞钟动苦吟。\n夜分僧出定，静听海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次同叔见寄二首 其二","author":"胡仲弓","text":"昔年三笑地，目断虎溪桥。\n立雪腰难折，凌云气尚飘。\n乾坤双辙迹，湖海一诗瓢。\n樽酒何时共，论文坐半宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中杂兴四首 其三","author":"胡仲弓","text":"怪得檐前溜，原来是雪消。\n山枯空有骨，水涸不成潮。\n寒雁鸣沙碛，饥鸦啄柳条。\n物情总如此，吟鬓任萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中杂兴四首 其四","author":"胡仲弓","text":"穷通俱莫问，久远是前程。\n涉世事多俗，吟诗人较清。\n论心欠兰友，知己有梅兄。\n不被虚名缚，江湖得散行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中杂兴四首 其二","author":"胡仲弓","text":"独坐看诗话，瓶梅相对清。\n瓦灯寒不晕，雪屋夜偏明。\n煨栗填饥腹，煎茶长道情。\n睡魔排遣尽，窗外听鸡声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中杂兴四首 其一","author":"胡仲弓","text":"六花正零乱，却与雨相和。\n地面频频化，山头渐渐皤。\n歌楼寒较少，穷巷积偏多。\n百卉归根后，惟松不改柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次同叔见寄二首 其一","author":"胡仲弓","text":"归期何日卜，雁不到天涯。\n谤有书盈箧，愁无地种花。\n吟梅销旅况，刻竹记年华。\n心事凭谁说，凭栏数暝鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]