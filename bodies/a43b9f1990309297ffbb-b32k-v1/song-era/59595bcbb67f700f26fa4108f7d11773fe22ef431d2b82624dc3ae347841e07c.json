[{"title":"题宗室大年画扇四首 其四","author":"晁补之","text":"柳动燕初来，波生雁将去。\n惟有小崧高，苍苍自如故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题段吉先小景三首 其三","author":"晁补之","text":"碧天无际日悠悠，风静沙平不见洲。\n彭浪矶边亦如此，危峰独木系扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题段吉先小景三首 其二","author":"晁补之","text":"人生何事踏尘埃，閒处胸襟足自开。\n不作终南养高价，小山幽桂好归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题段吉先小景三首 其一","author":"晁补之","text":"惨澹天云欲雨低，秋山人静鸟声稀。\n似闻谷响飞黄叶，恐有孙登半岭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题袁耕道所收小飞来","author":"晁补之","text":"藏山常恐负而走，壶中九华安在哉。\n忆似冷泉亭畔见，为君题作小飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题彭郎小姑祠","author":"晁补之","text":"山与矶名从地志，姑兼郎号出江民。\n世间称谓无真实，闻说双祠自有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题僧法芝钟山诗后","author":"晁补之","text":"明珠出袖四百琲，座有烟霞草木香。\n断取钟山擎石掌，那知不下净名床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠许体之","author":"晁补之","text":"楼下无心卧许公，求田已约暮年同。\n诗来正值花如雪，心事春风浩荡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与昙秀师别垂二十年而后相会于金山作","author":"晁补之","text":"诗笔多生习气牵，老来经呗亦随缘。\n何妨偶入东坡梦，未害闲依北固禅。\n万里波涛凭槛语，一山风雨并窗眠。\n未甘白首尘埃地，更约相逢二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岭上","author":"晁补之","text":"永日倦高跻，盘回四望迷。\n松根危抱石，岭路曲随溪。\n马腹飞云薄，山腰过雨低。\n阴崖不可度，谁此构长梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己卯六月赴上饶之谪醇臣以诗送行次韵留别","author":"晁补之","text":"小雅思深志不悲，反骚未与昔人违。\n五车谩苦君何益，三径都荒我未归。\n要过香垆䨥履步，却从彭蠡一帆飞。\n它年笑向张公子，应带烟霞满客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元符戊寅与无斁弟卜居缗城东述情","author":"晁补之","text":"四海一居何处卜，北窗祗取见家山。\n要无名利来心曲，便有园林出世间。\n拙宦莫兴三黜叹，老归未厌百年闲。\n先君馀庆期之子，吾驾如今不可还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆庐山示无斁弟","author":"晁补之","text":"湖口西江外，庐山已目前。\n太虚藏不极，彭蠡浸无边。\n五老宁行地，香垆自供天。\n芝田隔人世，应有读书仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对雪和王仲至","author":"晁补之","text":"鸾凤交横逐雨华，玉城银涧共萦斜。\n且看雾散千峰瘴，未觉雷惊万谷芽。\n碧落高情元物外，金闺清梦自天涯。\n宁知夜半寒歌客，烟断邻墙四五家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用评字韵和答府教授十二弟","author":"晁补之","text":"君诗飘举似鸿惊，书入扬州子弟评。\n圣世由来升俊造，少年已自得声名。\n六经正可三冬足，万里聊堪一日行。\n更约弥敦同姓乐，能来触咏畅幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日呈通守资中通直","author":"晁补之","text":"摇轩柳态未应还，正在凭高望远间。\n一夜春风吹北渚，清晨佳气满南山。\n动头乐事从今数，信手诗章莫放闲。\n但惜濉阳蔡公子，莺花烂漫向京关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵和答","author":"晁补之","text":"当时同赴饮城西，倾盖论心已恨迟。\n湖海可无年少气，雪霜还有岁寒枝。\n功传汗竹藏王府，诗入文韬动岛夷。\n不会书生安用此，眼前睫固未曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵答之道弟府教授","author":"晁补之","text":"文辞便是升堂贾，谈辩宁非入幕超。\n已谓囊中能出颖，那知车下正哀谣。\n但从袁盎无何饮，莫笑冯公不见招。\n伴我河山访陈迹，明年红紫满阳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和嘉父见贻","author":"晁补之","text":"使君心赏在高山，栎社宁烦匠石看。\n能似鼠多愁渡谷，仕如鲇钝笑缘竿。\n威仪披雾窥文豹，音韵当衢听玉鸾。\n曾共广陵花下醉，绨袍应叹一何寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再寄定国","author":"晁补之","text":"河南少尹古臞仙，销尽新缘窘旧缘。\n草字更无千载圣，谈言自有一家天。\n远游轻世唯何甚，少贬求容否不然。\n选壮坐狂俱龃龉，社樗元自可忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同鲁直和普安院壁上苏公诗","author":"晁补之","text":"畏暑聊寻寺，追凉故绕池。\n雨园鸠唤妇，风径燕将儿。\n散篆萦帘额，留云暗井眉。\n龙蛇动屋壁，知有长公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守蒲次新安西先寄府教授之道弟","author":"晁补之","text":"文章之子日翘翘，恐不能如岂有超。\n助我彤襜问民俗，烦君泮水采风谣。\n预知薄宦妨同处，且可清樽约屡招。\n十月驱车汉函谷，冷云高处望中条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廷贤求赋先春亭","author":"晁补之","text":"筑圃名亭尽可人，东皋百卉故先春。\n丘原满目皆安在，桃李成蹊又一新。\n薙草烦君开蒋径，漱醪容我著陶巾。\n青门瓜好平生事，欲遣朱轓便卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵八弟西园课经二首 其一","author":"晁补之","text":"禾熟秋原静，高蝉尚远音。\n半荒愁雨菊，独秀畏风林。\n老觉田原好，慵疏里巷寻。\n心知阿连胜，新向佛乘深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王正甫马陵感事","author":"晁补之","text":"风雨关河浩荡愁，骚人憭慄对清秋。\n追君旧事何堪听，投我新诗不易酬。\n纸上安知百年后，酒中聊可一生浮。\n言归款段谁能约，正有疏顽马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其九","author":"晁补之","text":"前世诸生选，平居数路开。\n乡闾自相与，岩穴亦时来。\n射雉空亡矢，为蛇更夺杯。\n千金曾市骨，聊用作龙媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其八","author":"晁补之","text":"气入中秋劲，更传午夜长。\n青灯蛾舞急，白月雁啼凉。\n羁旅生来惯，淹留久却忘。\n吟诗酬邓子，毕昴出东方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其七","author":"晁补之","text":"风云日夕改，秋气袭堂闱。\n映叶无蜩响，依丛有蝶归。\n官壶催赐酎，邻杵急成衣。\n留滞真何补，莼鲈兴又违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其六","author":"晁补之","text":"忆卧蓬莱阁，同听午唱鸡。\n星辰望天北，簪组隔城西。\n几日宣鱼钥，长驱响月题。\n更凭催邓子，要剸玉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其五","author":"晁补之","text":"辍直雠书馆，联裾校艺场。\n腾骧来万匹，挺拔出千章。\n直钓何妨得，餐风未必香。\n搜才赖公等，要助俗成康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其四","author":"晁补之","text":"高堂置书几，连幕与云齐。\n暑服犹便葛，秋槃已饤梨。\n官醪聊足醉，古锦不成题。\n空对灯花喜，重城隔夜闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其三","author":"晁补之","text":"蔡侯南国秀，经纬耿昭回。\n文史蛙生甑，风云蛰起隈。\n吾君求助意，之子为时来。\n万缕防秋费，何如一士才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其二","author":"晁补之","text":"雄深张子句，山水发天光。\n黄鹄愁严道，玄龟困吕梁。\n爱君豪颖脱，嗟我病伧囊。\n骥尾何当附，西风万里长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邓正字慎思秋日同文馆九首 其一","author":"晁补之","text":"平生邓夫子，文墨晚相依。\n台阁佳声在，湖湘爽气归。\n诗誇束笋密，发叹耨苗稀。\n勤苦千秋事，川明水孕玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵四叔父寄贺二叔父少监入馆并见寄诗","author":"晁补之","text":"琅邪太守鲁儒英，典校还高刘更生。\n已似诸荀并才子，复如群窦占诗名。\n尚吟河水怜孤侄，应与乡人痛伯兄。\n老鹤长鸣近天汉，可容丛灌和骊庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邠倅王正夫","author":"晁补之","text":"函谷鸡鸣满面尘，夫君泛爱尚为亲。\n清时有味俱吾党，黄发相看更几人。\n物理未惊翁丧马，世情应笑子知津。\n似闻绝塞风沙苦，只约觥船莫负春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张著作文潜休日不出二首 其二","author":"晁补之","text":"文史平昔契，淮山别离心。\n省中并日直，天上青春深。\n买屋近城坞，往来成竹林。\n诗模黄著作，吾亦意骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张著作文潜休日不出二首 其一","author":"晁补之","text":"张侯经济术，见遇未容心。\n扬子执戟老，蒋生开径深。\n予亦拙造请，素怀爱园林。\n闭门鸟雀喜，朝日上骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬双头牡丹","author":"晁补之","text":"寒食春光欲尽头，谁抛两两路傍毬。\n二乔新获吴宫怯，双隗初临晋帐羞。\n月底故应相伴语，风前各是一般愁。\n使君腹有诗千首，为尔情如篆印缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬约赏牡丹","author":"晁补之","text":"夭红浓绿总教回，更待清明谷雨催。\n一朵故应偏晚出，百花浑似不曾开。\n常誇西洛青屏簇，久说南滁紫线堆。\n任是无情还有意，不知千里为谁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬灵山亭宴集宠戏之句","author":"晁补之","text":"胜游谁继竹林贤，岘首高情自邈然。\n宝刹千寻出天半，灵山三面落樽前。\n梅花摘得宁烦驿，桃叶呼来不用船。\n南楚何须说穷巷，且陪铃閤听鹍弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬重修宴亭","author":"晁补之","text":"壁间双记快沉冥，山畔谯门水畔亭。\n相国名因稽古白，使君眼为好贤青。\n废堤不复风摇柳，新槛依然月满汀。\n羁旅从公厌游乐，欲图佳致作幽屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬祥符轩","author":"晁补之","text":"云端红粉拊雕栏，谢守纶巾语笑间。\n游客乍惊人外境，居僧初识面前山。\n暂来犹足留公赏，借与真堪著我顽。\n铃閤多馀宾从少，谁教瓶盎不曾闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬梅花","author":"晁补之","text":"寒岩幽雾不曾开，残雪犹封宿草荄。\n一萼故应先腊破，百花浑未觉春来。\n惭非上苑青房比，误作唐昌碎月猜。\n常恨清溪照疏影，横斜还许落金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬赏花","author":"晁补之","text":"天香国色竞新奇，初过清明未觉稀。\n困舞尚迎风袅袅，醉妆犹弄日晖晖。\n飘零洛下千金价，惭愧江南百草菲。\n谢守多才最怜尔，百篇能伴羽觞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬新庵","author":"晁补之","text":"无心何用说心灰，庵在青萝绿筱隈。\n自可谈间公事了，不妨闲处道书开。\n更携邀月清樽上，只著登山小屐来。\n桃李他年应勿剪，使君嘉誉在闺台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬新移牡丹二首 其一","author":"晁补之","text":"史君著意与深培，为向吴宫好处来。\n得地且从三月暖，明年应更十分开。\n溱傍芍药羞香骨，江里芙蓉妒艳腮。\n云雨鸿龙总非比，沉香亭北漫相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬新移牡丹二首 其二","author":"晁补之","text":"笑倚东风几百般，忽疑洛渚在江干。\n玉容可得朝朝好，金盏须教一一乾。\n送目汉皋行已失，断魂巫峡梦将残。\n七闽溪畔防偷本，四照亭边更著栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李秬酴醾","author":"晁补之","text":"夭红琐碎竞春娇，后出何妨便夺标。\n云鹤嬉晴来万只，玉龙惊震上千条。\n蓐收晃荡风前仗，萼绿飘翩月下绡。\n曾向琼林亭畔见，天涯相遇一魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜天达见寄","author":"晁补之","text":"冷屋寒舟两处怀，一封归信隔年开。\n愁容顿与河冰泮，佳思先随岸柳来。\n射雉便甘忘我矢，画蛇何怪夺君杯。\n端知雪里清吟好，未减山阴兴尽回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苏中丞喜文潜病间","author":"晁补之","text":"携筇过子约朝朝，况是门无百步遥。\n午卧檐曦茶可煮，夜谈窗霰栗堪烧。\n范鱼何用惊生釜，郑鹿应知梦覆蕉。\n试作文殊问居士，从今一饭久如消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苏注承议天钵元长老像前捻香","author":"晁补之","text":"萧然方丈病仪成，蓑笠忘来一境清。\n应作是观宁有相，实无得度即非情。\n日当居士行时午，月在生公讲处明。\n能识微言只夫子，可怜惟我最初程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和求仁不赴照碧堂会呈无愧之作","author":"晁补之","text":"政成欢诵沸田莱，留钥雍容更上才。\n缭郭平湖从昔好，倚天朱槛为谁开。\n曳裾况是他年旧，倒载何妨尽日陪。\n自有登高能赋客，可容清坐咏南台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵练定祥符听法","author":"晁补之","text":"弥天一滴水，何处是曹溪。\n若作声来解，还成瞪发迷。\n白云遮刹远，翠竹向檐低。\n是物元非物，庄周未可齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵金乡宰韩宗恕寺丞见赠三首 其三","author":"晁补之","text":"公子翩翩出世贤，少时术业已成全。\n闲中道义轻三事，醉里文章敌八仙。\n客舍寒垆聊可拥，县楼昏鼓不须传。\n河阳花发期相过，即是新年换故年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵金乡宰韩宗恕寺丞见赠三首 其二","author":"晁补之","text":"蜀客高词诧割鲜，直吞云梦气仍全。\n自怜单阏穷为赋，不向元和共得仙。\n嘉论一朝倾盖合，新诗半夜叩关传。\n西窗却话巴山事，它日相逢忆此年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵金乡宰韩宗恕寺丞见赠三首 其一","author":"晁补之","text":"乘涛无意犯星躔，好在琴尊且乐全。\n彭泽孤吟成小隐，苏门双啸剧登仙。\n平时主父言多困，晚节扬雄学始传。\n鲍叔可能知管子，劳君相许寄忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵信守李秬二首 其一","author":"晁补之","text":"谁榜铃斋作面山，晦明终日卷帘看。\n赋成夜烛才销寸，衙退朝曦未半竿。\n枉渚孤吟愁旅雁，苏门双啸骇朱鸾。\n平生五裤何须咏，一借黄钟变谷寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵信守李秬二首 其二","author":"晁补之","text":"爱山何必俟归山，簿领忙时拨置看。\n阊阖自应行发轫，珊瑚终未拂垂竿。\n樽中屡许陪文举，庑下犹堪寄伯鸾。\n便作功成同范蠡，白鸥盟誓不教寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵信倅练定梦雪中过王侍郎","author":"晁补之","text":"梦觅毗耶看雨华，玉城银涧过萦斜。\n乍疑雾廓千峰障，未觉雷惊万谷芽。\n碧落清谈元物外，金闺高兴共天涯。\n寒鸡唤起新诗就，谁忆袁安正卧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵校理盛居中上元","author":"晁补之","text":"四见都城灯火春，看驱肥马走朱轮。\n天传九奏虚群籁，海踊三山跨万鳞。\n追赏谩逃深禁直，拜迎祗望属车尘。\n预知短发非欢事，只有觥船未愧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵留守王公喜春","author":"晁补之","text":"午窗垆火不应残，春许花期特地宽。\n塞雁初惊池藻暖，谷莺犹怯井梧寒。\n未须园里幽寻去，且更楼前远望看。\n四牡行春定何日，亦闻钟鼓满城欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁畴耕道见贻","author":"晁补之","text":"阅世纷纷共旅亭，归来眼为里人明。\n老夫未叹尝三已，吾子何忧取一名。\n仁义夙心成自误，文章小道得高评。\n曲池远市偏宜暑，携卷同来看月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄奉议序致仕作","author":"晁补之","text":"闻道家书至，山中不厌寒。\n近臣多白发，此老独黄冠。\n金少从供具，身轻莫据鞍。\n劳心为功业，持与世人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩求仁南台朝请晚过南湖见寄","author":"晁补之","text":"浮花浪蕊信东西，何许寻芳去自迟。\n流景不须惊石火，寸田应已长琼枝。\n想君清兴聊堪发，遣我忧心久欲夷。\n便作崔丞日临水，凫行擿尾不须知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]