[{"title":"阻风次衡元度韵","author":"傅察","text":"水柳缆孤舟，飘飘万里秋。\n远风来不断，高浪去还收。\n菰苇萧疏折，烟云惨淡浮。\n赖知师德在，舟子亦多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯时往河东戏与廉夫分韵道相思之意三首 其三","author":"傅察","text":"之子何磊落，本是青云才。\n委翅蓬蒿下，黧面垂䯱䰄。\n卜邻与我游，肝胆向人开。\n酒酣遗世累，谑浪绝嫌猜。\n西风换烦燠，四野无纤埃。\n方当共临眺，公兮胡不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯时往河东戏与廉夫分韵道相思之意三首 其二","author":"傅察","text":"朝氛霁西山，晚日明髣髴。\n摇怜太行上，陟巘眩可畏。\n王侯眇小夫，中盘凌云气。\n端如车公贤，谈笑出真味。\n胡为久崎岖，使我重歔欷。\n王事有程期，来归惧其未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伯时往河东戏与廉夫分韵道相思之意三首 其一","author":"傅察","text":"日月剧跳丸，暂别亦已久。\n青山缭层巅，道里阻且右。\n今晨登南楼，会此同志友。\n思公聊北望，伫立但搔首。\n秋风八月天，霁色明朝牖。\n轩车何时来，迟尔一杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余父子妻孥各在一方欲归未得因感成诗","author":"傅察","text":"皎皎明河汉，悠悠度女牛。\n奔驰空岁月，南北尚淹留。\n所愿各千里，此身兼百忧。\n如何有羽翼，来往亦遨游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和鲍守次韵林德祖十四首 其七","author":"傅察","text":"十年尘土坐才轻，五斗犹堪佐县亭。\n鼎贵敢歆新绶紫，固穷唯有旧毡青。\n已甘终作轮囷木，未忍翻同屈曲屏。\n犹喜膺门被容接，常瞻郎位蔚然星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和鲍守次韵林德祖十四首 其三","author":"傅察","text":"五月黄尘去传轻，褰裳几处宿邮亭。\n共知向日输心赤，莫叹微霜点鬓青。\n每傍重霄求宝剑，欲令新木作枯屏。\n流传剩有风骚句，摇想群公若会星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜登清微亭云阴掩翳东北有雨少顷月出皎然复次前韵","author":"傅察","text":"融融暑未阑，悄悄夜方午。\n命驾聊叩门，寻幽得兹土。\n俯瞩但苍茫，前瞻何卤莽。\n万籁正虚无，群生各安堵。\n蝉啸作笙箫，蛙鸣当钟鼓。\n凫舄正参差，诙谐惧狎侮。\n岂惟冠盖倾，已觉肝胆吐。\n坐久隐奔雷，天边垂密雨。\n疏木列宾朋，众峰自臣主。\n萤火落明星，炉烟袅青缕。\n那能胜酒杯，所欣瞻德宇。\n高歌屡激昂，失喜或俛偻。\n萧飒濯尘襟，清虚湛灵府。\n快如仙爪爬，洒若头风愈。\n须臾出金盘，照曜开玉户。\n映浪杂琼瑰，穿帘间璧组。\n斯游岂前谋，后会难逆数。\n欢馀岸纶巾，语约挥松麈。\n可能伴鸡栖，亦复随蝶栩。\n广寒会可升，试为刷翎羽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"傅察","text":"旧国日已远，东秦安在哉。\n水云波浩荡，林日影摧颓。\n野色撩诗兴，秋风动旅怀。\n繫舟还信步，不觉咏归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱熙载改官还乡","author":"傅察","text":"陶唐名臣有朱虎，揖逊夔夷尊文祖。\n后来杰出汉云孙，折槛当时谁敢侮。\n煌煌圣代见斯人，凛凛遗风振千古。\n乘牛不数鲁家侠，衣锦何妨买臣窭。\n十年牢落困胶庠，五斗栖迟尚环堵。\n唯余豪气自不除，倾盖向人肝胆吐。\n忽然结束事征鞍，轩轩气色浮眉宇。\n谓余倚门亲久待，况复枫宸拜明主。\n朝廷公卿重荐延，骞腾一鹗生毛羽。\n高义如君世所稀，早据要路思禆补。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜守口号","author":"傅察","text":"九重丹诏锡恩荣，袅袅秋风卷旆旌。\n藉甚搢绅争颂德，烂然衣锦得徐行。\n一钱选受群翁送，三径归来万事轻。\n宣室异时思贾傅，蒲轮应复召枚生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送承祖赴定州幕府","author":"傅察","text":"中山控北陲，强弩号百万。\n单于衔国恩，方且事逃遁。\n谋帅得真儒，不烦一戟顿。\n风流本江左，亹亹有馀论。\n幕府极妙选，参谋不容逊。\n藉甚丞相孙，凌云气豪健。\n所怀社稷计，尝愿窃有献。\n蹭蹬三十年，羁旅颇自困。\n因人作远游，实亦乖素愿。\n谈笑青油幕，聊复可排闷。\n嗟余谬从学，尘根苦迟钝。\n一官联事久，矜式每自劝。\n但觉有不如，未见有进寸。\n公亦不吾厌，叩击愧烦溷。\n念当为远别，怅然亦多恨。\n时方苦炎蒸，行矣期强饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逍摇堂五咏 其三","author":"傅察","text":"堂上薰风至，阳曦午更骄。\n玩阴欣叶密，引饮快冰消。\n乳燕飞还堕，鸣蝉咽复调。\n清谈能却暑，应不费招邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚发","author":"傅察","text":"理棹频看溪水分，岸移不觉转孤村。\n渔翁醉卧滩沙稳，樵子行歌岸草昏。\n白鹭成行低欲落，清蝉无数断还闻。\n自将野色并秋色，都付诗魂与醉魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其九","author":"傅察","text":"盈尺兆嘉祥，三登贺时泰。\n我虽无寸田，一饭犹足赖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其四","author":"傅察","text":"高堂连夜赏，蛾眉映珠栊。\n谁怜闭门客，衣穿履亦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其三","author":"傅察","text":"晚风扫连氛，客被憎夜峭。\n明朝赴看烛，更把昆山照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其二","author":"傅察","text":"天公亦戏人，奇幻惊倏忽。\n朝来檐霤间，一一缀明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其一","author":"傅察","text":"都城一日雪，庭户浩已盈。\n呼儿试轻扫，留伴小窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廉夫有会当归去来之句复次前韵","author":"傅察","text":"少小尚奇伟，长年病莫兴。\n折腰仕五斗，讵敢论好憎。\n居然畏罪罟，局如履春冰。\n每怀鹰隼翮，韝上看锋棱。\n追随缙绅后，糠籺杂肴烝。\n泮宫天下士，藉甚得儒称。\n巍巍众峰上，跛足岂易凌。\n朝廷重荐延，拔茅馀空塍。\n公孙富经术，非子谁能胜。\n坐见万顷波，罂缶汲逾澄。\n沛然下膏泽，蓊若朝云升。\n勿云叹留滞，青史他年登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毛彦谟容膝轩","author":"傅察","text":"夫子负异才，端若会稽笴。\n平生怀刚肠，于世少许可。\n文词类激昂，议论耻媕婀。\n高名三十年，坐此常坎坷。\n同时英俊流，往往步青琐。\n归来乐箪瓢，琳宫得安坐。\n小轩仅容膝，陋巷生堀堁。\n唯馀豪侠气，屡折每不挫。\n却视利名场，终身系缰锁。\n生虽华屋居，死或翳蓬颗。\n固知宇宙间，所有终非我。\n但当清吾心，馀事等么么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张季良适性斋","author":"傅察","text":"扬雄家无甔石储，闭门作赋拟相如。\n邺侯插架多异书，牙签万卷吞石渠。\n吾友张子斯人徒，嗜好酸咸与众殊。\n被褐怀宝老不癯，收拾万卷以自娱。\n但愿生为蠹书鱼，咀嚼英华味道腴。\n挥毫落纸惊群儒，佳处往往凌子虚。\n网罗秦汉包唐虞，上下千载归指呼。\n自言此乐世所无，不羡潭潭卿相居。\n方今清庙收璠玙，肯使沧海遗明珠。\n高名他日播天衢，行看旌帛来庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送傅倅","author":"傅察","text":"洺之水兮，其流舒舒。\n公之来兮，朱服熊车。\n士元展骥，仲举题舆。\n公之来兮，民斯乐胥。\n洺之水兮，其流洋洋。\n公之化兮，春雨秋阳。\n裤襦颂洽，禾黍岁穰。\n公之化兮，民斯悦康。\n洺之水兮，其流瀰瀰。\n公之去兮，旌旂旖旎。\n父老攀辕，缙绅方轨。\n公之去兮，瞻望徙倚。\n洺之水兮，其流泄泄。\n公之德兮，此邦所愒。\n吏遵其画，人怀其惠。\n公之德兮，久而勿替。\n洺之水兮，其流活活。\n公之名兮，兹其弥达。\n翔于朝宁，骞于省闼。\n公之名兮，莫我敢遏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题五曲溪","author":"傅壅","text":"五曲溪流深复深，数椽茅屋旧书林。\n市朝山泽皆堪隐，谁识先生出处心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东京道上口占","author":"傅諴","text":"宫阙岧峣俯碧空，九门未晓月朦胧。\n马嘶南陌东风远，回首神京一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使金","author":"傅諴","text":"霜明玉节映寒流，马渡芦沟向上头。\n万里河山观古塞，百年荆棘叹神州。\n要临瀚海铭燕石，莫上新亭作楚囚。\n多少遗民思旧俗，可怜金帛岁包羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁","author":"傅霖","text":"寒蛬入夜忙催织，戴胜春深苦劝耕。\n人若无心济天下，不知虫鸟有何情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张咏","author":"傅霖","text":"忍把浮名卖却闲，门前流水对青山。\n青山不语人无事，门外风花任往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红药","author":"储泳","text":"红药阶前半吐葩，露枝已入贵人家。\n不如庭下无名草，一度春风一度花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日郊行","author":"储泳","text":"东风吹著便成花，妆点园林卖酒家。\n田野可栽闲草木，十分春色在桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬藏一","author":"储泳","text":"灵竺山前满径苔，游春车马可曾来。\n共君便欲携尊去，一树海棠花正开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春昼","author":"储泳","text":"亭院深深春昼长，度窗蜂影去来忙。\n自从野菜花开后，一月熏炉不炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人","author":"储泳","text":"昨日含愁始送春，今朝又复送行人。\n江头杨柳不须折，那与愁眉替得颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涵虚阁","author":"储泳","text":"菊秋梅腊百花春，过眼年华醉梦身。\n今日不因登此阁，不知人世是红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅坞画推蓬梅","author":"储泳","text":"冰魂销不尽，招得上南枝。\n依约横斜影，纱窗月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩","author":"储泳","text":"天然合成璧，落月透岩晖。\n不尽团圆影，应知晦蚀机。\n骑蟾人已去，捣药兔忘归。\n惟有婆娑桂，吹香度客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕怀友","author":"储泳","text":"楼高不敢眺，愁思满沧洲。\n有梦隔千里，无书过一秋。\n晴风吹野树，落日照寒流。\n客里添萧索，何时得共游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游边","author":"储泳","text":"边风吹雁至，君却向边游。\n正立功名日，去防关塞秋。\n看雕因撚箭，调马试呈毬。\n奏凯归时节，应须万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送兄潮举","author":"储泳","text":"老来偏惜别，此别更关情。\n水陆三千里，舟车一月程。\n雁声乡思远，鸾影旅魂惊。\n杨柳彫零尽，无枝可赠行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送卢萍斋","author":"储泳","text":"当春雁北飞，之子独南归。\n寒暑本无定，去来应有机。\n柳烟迷客棹，花露湿征衣。\n明月人千里，相思消息稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈云崖","author":"储泳","text":"出门即远道，君去有谁令。\n诗价侯门贱，时情客路轻。\n晚云归独树，寒雨暗荒城。\n此地还相别，谁能不动情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻采石分司芸隐讣","author":"储泳","text":"忽闻千里讣，涕泪已交横。\n遽夺英雄去，不教功业成。\n人疑藏六甲，天使伴长庚。\n惆怅青山梦，分明坐两楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兄玉老","author":"储泳","text":"雷阳路迢递，回首亦关心。\n重别因轻诺，远行多近吟。\n客怀秋色早，归梦岭云深。\n莫以书无益，人来惜万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼古镜果佛慧法师","author":"储泳","text":"霜毛垂半顶，说法国王前。\n定里修千劫，佛中添一员。\n谥尊终后赐，真谛在时传。\n讲下诸徒弟，焚香石塔边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登涟漪阁","author":"储泳","text":"杰阁枕平川，秋光淡远烟。\n窗开林外景，影占水中天。\n野色归吟笛，征帆过客船。\n危栏人徙倚，缥缈十洲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淀山寺","author":"储泳","text":"无路接尘寰，中流拥翠鬟。\n望中疑有寺，游处若无山。\n过雨行云湿，冲风钓艇还。\n龟边旧鸥鹭，心事颇相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题胡琴窗方径","author":"储泳","text":"诗穷推不去，终有恶圆心。\n楼倚风烟外，琴横星斗沉。\n行看花四面，坐对竹千寻。\n却笑陶彭泽，归来荒草深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题隐者所居","author":"储泳","text":"尽日掩柴门，何人得见君。\n只因喧寂异，似有圣凡分。\n瀑近夜疑雨，山深晴亦云。\n传闻九霄翮，落羽正纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"储泳","text":"垦苇栽花柳，园林小小成。\n旋分黄菊本，新扁草堂名。\n池水通湖活，江风过竹清。\n不期车马到，足自称幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光风霁月亭","author":"储泳","text":"一段风流出自然，中和气候嫩凉天。\n百年心事无人会，付与茅亭伴吕仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亭下","author":"储泳","text":"亭下冷泉清，松深地绝尘。\n细看门外树，几换寺中人。\n别嶂孤猿晓，幽花百鸟春。\n坐来危石上，疑是比丘身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"储泳","text":"客楼高处望，独立对斜晖。\n负郭有田在，故山何日归。\n秋深杨柳薄，水阔鹭鸶飞。\n风景正萧索，何堪闻捣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觉来","author":"储泳","text":"西风吹梦过钱塘，独上孤山叩冷香。\n纸帐四垂灯影薄，觉来疑是月昏黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"储泳","text":"送春归去后，身却在天涯。\n有梦忘为客，见书如到家。\n楼空初入燕，柳暗欲藏鸦。\n故苑新桃李，闲开一度花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清閟轩","author":"储泳","text":"万竹中央住，清心自爱持。\n不除伤砌笋，慵洗宿禽枝。\n影落翻经处，声敲入定时。\n重泥新雪壁，留待客题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐","author":"储泳","text":"东风一夜吹寒食，枝头片红犹恋。\n宿酒初醒，新吟未稳，凭久栏杆留暖。\n将春买断。\n恨苔径榆阶，翠钱难贯。\n陌上秋千，相逢谁认旧时伴。\n轻衫粉痕褪了，丝缘馀梦在，良宵偏短。\n柳线经烟，莺梭织雾，一片旧愁新怨。\n慵拈象管。\n待寄与深情，难凭双燕。\n不似杨花，解随人去远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二 九日登钓台怀思溪旧游","author":"善珍","text":"七十二年翁。\n曾客吴中。\n清游占断水晶宫。\n几度藕花归棹晚，月渚烟钟。\n追记已陈踪。\n回首空濛。\n凭高荒草夕阳同。\n欲问谢公歌舞地，落叶鸣蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一 寄剑阁","author":"善珍","text":"相对两衰翁。\n身似枯蓬。\n分飞吹聚谢天风。\n零落交游无一个，五十年中。\n生客语藏锋。\n不答阳聋。\n心期难话与儿童。\n共结庵招猿鹤侣，烟锁云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望梅词/望梅","author":"善珍","text":"寸阴堪惜。\n趁身强健去，结茅苍壁。\n错料事、临老方知，国师与高僧，二途俱失。\n识字吟诗，数不得、死生何益。\n看寒山着语，李杜也输，莫道元白。\n千年过如瞬息。\n共飞鸿缥缈，沉没空碧。\n问懒瓒、因甚遭逢，芋魁亦联翩，著名金石。\n遗臭流芳，老子勿、许多心力。\n旋消磨、数百瓮齑，掩关入寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"征夫","author":"喻汝楫","text":"白骨茫茫散不收，朔风吹雪度瓜州。\n残阳欲落未落处，照尽行人今古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙未咏梅","author":"喻良能","text":"疏枝倚竹更临池，一饷清寒瘦雪肌。\n恰似玉儿初识面，朱唇苏颊总相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未二月十三日延和轮对","author":"喻良能","text":"六年不获面虞皇，重对彤墀昼漏长。\n玉色粹温天一笑，归来满袖有浓香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕戏咏","author":"喻良能","text":"别多会少两情深，风幌云屏喜不禁。\n谁道初秋清夜永，须知一刻直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月晦日闻莺","author":"喻良能","text":"忆得东风汎蕙兰，晓窗红树听绵蛮。\n如何却到深秋节，尽日犹啼修竹间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七峰亭独坐","author":"喻良能","text":"屿岫新亭好，悠然见七峰。\n凭栏吟不尽，春色与秋容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]