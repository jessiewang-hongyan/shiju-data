[{"title":"夜分","author":"宋祁","text":"夜分群动息，秋意久劳劳。\n林净月华上，河明天界高。\n街风遥叠鼓，园露暗僵桃。\n万事蹉跎外，惟应得二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜出溪上","author":"宋祁","text":"陇首孤云断，坳塘绿水周。\n萤光不欺夜，虫织自悲秋。\n早雁离离度，归舟泛泛流。\n萱苏共摇落，底处是忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宴","author":"宋祁","text":"卜夜金华逼绮寮，星河垂地漏声遥。\n吟龙递怨先供舞，留凤愁寒不傍箫。\n隔坐联章催镂管，分行度曲认金翘。\n平明便是骊驹别，莫使衣香即日消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜绪","author":"宋祁","text":"炎氛歇层宇，清气肃重帷。\n籁远天人杂，宵閒甲乙迟。\n江湖牵客虑，日月与人衰。\n经国谋安在，悠悠空我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉节朱尉","author":"宋祁","text":"初命东南尉，征途上下弦。\n传家万石贵，结绶半纶鲜。\n邑籍饶岷芋，公囊满邓钱。\n仙才今有助，铭阁待新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和圣制清明","author":"宋祁","text":"解律调元品汇春，青阳右个启初辰。\n庖烟息禁农耕盛，蚕器增修岁务新。\n迟日东门催柳色，微寒南陌敛车尘。\n柏梁侍从瞻天什，拜手赓歌轧思频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和圣制清明日","author":"宋祁","text":"璇杓临乙位，羲御届娄初。\n碧浪桃花涌，珍丛锦段舒。\n轮蹄晴缥缈，钟漏夕虚徐。\n穆穆宣温殿，披文日有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和宫师相公流杯亭诗并太傅相公枢密太尉和章次韵","author":"宋祁","text":"筑岩春脉下飞泉，林阁留宾敞庆筵。\n流水环阶智者乐，醇醪饮吏相君权。\n和歌远属钧枢旧，禊帖间存爵里贤。\n此地胜游谁复见，醉波深映六符天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和晏相公摄事圜丘中书致斋","author":"宋祁","text":"相阁斋居政事西，兹辰正值朔云低。\n雪园鹍冷应先舞，雀树鸡閒欲早栖。\n搁笔暂停黄纸尾，解骖犹放紫茸题。\n仙谣唱罢微阳动，谁见林间荔甲齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉檄汉上和兄长廷评喜于邂逅","author":"宋祁","text":"弥年宾牒叹离居，始得还家奉板舆。\n出沐恩深汤吊虮，校文官冷字成鱼。\n三杯旅案馨羞切，百末凝醅献寿馀。\n缰锁空名堪自笑，又随轺马趣移书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季秋十九日追还学士院回舟入都作二首 其二","author":"宋祁","text":"得麾初出守，趋召遽言旋。\n露藿元倾日，秋槎却上天。\n丹涂容蹇步，星弁许华颠。\n再奏皆闻罢，惭妨此路贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季秋十九日追还学士院回舟入都作二首 其一","author":"宋祁","text":"上恩留不遣，仍棹越船回。\n人忝玉堂署，鱼还符节台。\n危心摧橹罢，病眼刮云开。\n读遍淮南诏，惭非视草才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍石榴","author":"宋祁","text":"曾见芳英上舞裙，缘何此地寄轮囷。\n烟滋黛叶千条困，露裂星房百子匀。\n未羡扶南收作酿，曾经骑省赋为珍。\n须知博望来时晚，莫促幽芳趁暮春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍直归晚霁三首 其三","author":"宋祁","text":"密雾披层宙，浓云霁四溟。\n乱流初漱玉，红日不藏萍。\n万叶张晴幄，千山卓翠屏。\n无烦事铙吹，蛙响自堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍直归晚霁三首 其二","author":"宋祁","text":"雨罢残阳在，风微酷暑收。\n馀昏淡云翳，聚沫泛河流。\n桃簟双纹展，盘瓜五色浮。\n潘郎最多感，庭树莫先秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍直归晚霁三首 其一","author":"宋祁","text":"骤雨挫炎威，归轩广陌西。\n渠声流作瀑，日脚侧成霓。\n换锦龙媒埒，淹花燕子泥。\n比来巾角垫，李郭定相携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍诸生罕至或累旬倚席不讲愧而成咏","author":"宋祁","text":"直舍沈沈掩回廊，古坛槐柳对苍凉。\n一囊有客愁饥死，三尺无人问喙长。\n瞑据槁梧真用拙，束归高阁分深藏。\n日斜广陌驱归鞅，更似笭箵作漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官下","author":"宋祁","text":"东泊骖驔一驻车，騩云芣木澹扶疏。\n风经禦寇仙游外，野识裨谌草创馀。\n颍谷寒烟仍井邑，侯门残日但丘墟。\n两都大道过从盛，不称支离佩左鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍二首 其二","author":"宋祁","text":"病骨支离釜粟丰，卧看暾采照墙东。\n不材天与山中养，饱食人嗤柱下工。\n大府翩翩惭奏记，闲斋咄咄厌书空。\n翛然慵态知难画，手按鸣弦目送鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍二首 其一","author":"宋祁","text":"南荣坐炙野人暄，官谤心知鹤有轩。\n画饼窃名真不食，衔枚邀宠更无言。\n嵇斋书簏吹尘度，蒋径宾綦晕藓斑。\n事国爱君精未已，此生疏蹻负丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官廪月钱不足经费","author":"宋祁","text":"俸微才给斗升储，炀灶烟沈乏爨苏。\n下泽出游无款段，长安饱死羡侏儒。\n病杯残蚁分蛇影，梦管流尘晦鼠须。\n天极包荒恩未报，敢随张翰忆秋鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宛丘作","author":"宋祁","text":"宛丘真善地，承诏幸班春。\n铃下听无讼，日边来有人。\n吟馀多感客，睡足本慵身。\n虮虱休相贺，吾今汤沐频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屈原祠","author":"宋祁","text":"楚江南望见脩门，灵鼓声沈蕙捲樽。\n五日长蛟虚望祭，九关彫虎枉招魂。\n兰苕猎翠凄寒露，枫叶摇丹啸暝猿。\n贾谊扬生成感后，沈沙投阁两衔冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"废郑河","author":"宋祁","text":"当年食溱洧，此地控长津。\n却见为陵日，难寻病涉人。\n落霞遥送鹜，荐草暗留麇。\n代往诗风变，田渠数报春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明月湖","author":"宋祁","text":"湖色淡无际，月华相与閒。\n临波双璧映，照浦一珠还。\n宿火汀洲外，横烟桑柘间。\n不妨清思剧，举国尽溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松","author":"宋祁","text":"冒雪虬枝密，凌空麈影匀。\n叶倾秦帝雨，华老宓妃尘。\n不见栖鸾客，多逢系马人。\n寄声遭匠石，千尺谢轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林下","author":"宋祁","text":"林下追凉久，山西反照初。\n兰苕香自怨，蝉腹饱犹虚。\n李暗倾冠外，棋残折屐馀。\n萧然皋壤乐，何必羡池鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林鸦","author":"宋祁","text":"林鸦泊泊飞，剩欲送斜规。\n城头八九子，月中三匝枝。\n向晨常自警，邻暝不应移。\n王孙无巧弹，此夜正羁雌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林缺","author":"宋祁","text":"林缺榛苞绽，溪平芡嘴开。\n衰烟稍辞柳，寒雨并饶苔。\n天意凄凄早，乡愁衮衮来。\n此时论四戚，方验楚人材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武安侯","author":"宋祁","text":"贵甚宫中势，轩然帝右趋。\n所贪惟狗马，宁是学盘盂。\n骄取武库地，气凌辕下驹。\n淮南他日语，悔不共严诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"河南希深学士","author":"宋祁","text":"洛雾嵩云满眼春，仙郎清路拥双轮。\n却陪宾客趋东阁，已为阳秋得素臣。\n渊秘图书探汉旧，地交风雨访周人。\n岁时献寿严君府，谁见家庭玉树新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"物外亭","author":"宋祁","text":"飞宇冠苍岑，盘盘上百寻。\n风含太虚爽，云作下方阴。\n坞桂寒仍燠，岩猿暝始吟。\n知君有高兴，天壤共登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玩晚菊","author":"宋祁","text":"佳节虽云晚，繁英尚独开。\n新醪相伴熟，寒蝶不空来。\n细折愁香破，长吟恐暝催。\n自嫌霜白鬓，将插重裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直讲周岁","author":"宋祁","text":"本自悲凉葆发多，何缘末至滥中阿。\n马肝不食非论味，狗曲犹轻枉为歌。\n旧学空疏缘病废，壮情牢落伴年过。\n终然野鹿江鱼性，长在云林与素波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍","author":"宋祁","text":"南荣曝腹饫黄粱，卧看春晖上缥墙。\n有位乘轩惭野鹤，出钱邀沐羡山郎。\n神交自爱蘧蘧适，怪事非论咄咄狂。\n瓠窍不穿樗质散，只应何用是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"肃简鲁公挽词四首 其三","author":"宋祁","text":"忧国神无爱，呼医体寖臞。\n人忧一台坼，帝遣两驺扶。\n临视回襄御，遗言入舜谟。\n七兵荣赠册，沉础贲龟趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"肃简鲁公挽词四首 其二","author":"宋祁","text":"震邸陪翔凤，天坛侍祭牲。\n参谋大丞相，别对小延英。\n上栋方隆国，颓山遽奠楹。\n武公年不至，辅德是功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"肃简鲁公挽词四首 其一","author":"宋祁","text":"拂世谟谋盛，端朝载采熙。\n上前推汲直，天下咏曹随。\n密启多焚草，加餐餍嗜葵。\n不图霜露疾，奄忽丧元龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨中作","author":"宋祁","text":"云阵穷天雨足低，阴霞不照露盘西。\n城高已蔽觚棱凤，水浊先愁独漉泥。\n战蚁争封缘暗穴，怒蛙邀轼沸空蹊。\n斋窗病枕迷昏晏，只有喈喈托曙鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"转运李宥学士","author":"宋祁","text":"栈外秋高荠树繁，一星飞影伴輶轩。\n属城导骑賨歌密，近野迎浆蜀老喧。\n濯锦万梭催贡箧，熬盐千井算牢盆。\n行台自昔书林宠，不为伤离更黯魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑子产庙","author":"宋祁","text":"不知东里叟，遗迹但堪寻。\n语爱东家泪，论交季子心。\n故坟犹有石，遗鼎遂无金。\n谬政为邦久，千秋谢所钦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陕府祖择之学士","author":"宋祁","text":"白发书林作丈人，陕郊迢递驾朱轮。\n谩誇燕许文章手，未得严徐侍从臣。\n列岫倚窗吟榭晓，乱花窥酒宴堂春。\n几篇新咏留珉刻，首记銮舆八月巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨夜","author":"宋祁","text":"滞雨兼兰夕，遥帷更烛房。\n疾雷方破柱，惊电或生墙。\n易断幽衾梦，频回逐客肠。\n新欢谁复得，最是楚高唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冒雪马上作","author":"宋祁","text":"大雪浃天畿，晨骖望禁扉。\n二仪连皓气，万物共清辉。\n楼迥标银阙，台寒压粉围。\n瑞花真有意，偏著入朝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南岘候馆晚春有感献郡守","author":"宋祁","text":"春晖明淡上三竿，风菀愁红迈蒂残。\n梦后单衾凌晚薄，体中馀酒向醒寒。\n山梁嗅雉晨羞饫，楯鼻磨铅藻思乾。\n深愧府公宾礼厚，不教持版预粗官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南国","author":"宋祁","text":"南国豪华地，东风骀荡天。\n露兰薰夕梦，烟柳重春眠。\n歌断云空度，书长燕未传。\n吟成休自许，芳草更绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南斋二首 其二","author":"宋祁","text":"曩宦缘三釜，今归分一丘。\n杯棬非柳性，涂尾是龟谋。\n薪意矜来仕，瓜名托故侯。\n恍然桑下计，蚕妾讵相尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南斋二首 其一","author":"宋祁","text":"隐有山林愿，閒非江海身。\n孔书罕言命，庄意闇同人。\n敢衒能鸣雁，须惭不猎鹑。\n缘何无丽句，多病极漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀故文节公 其二","author":"宋祁","text":"顺采思忠荩，宣谋叹巧劳。\n慭遗无一老，投吊剩三号。\n撤奠哀笳引，追荣敛衮褒。\n欲知凭厚庆，弟览得传刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哀故文节公 其三","author":"宋祁","text":"霜露才婴疾，龙蛇已丧贤。\n神骑尾星次，家托寝丘田。\n长乐申君吊，东堂罢禊筵。\n佳城白日掩，从此即千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城外","author":"宋祁","text":"次舍梁陈外，风烟周郑间。\n徐驱四郊路，遍识属城山。\n野雪融残素，岑霞就暝殷。\n几宵星影动，知伴传车还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城西晚眺","author":"宋祁","text":"北榭风轻爽醉襟，天涯摇落对登临。\n一篙寒浪船移浦，千尾残阳鸟赴林。\n倦客亭皋时远笛，早寒墟里渐疏砧。\n凭栏不觉休边角，暝气苍茫失半岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城隅晚意","author":"宋祁","text":"寥寥天意晚，稍觉井闾閒。\n水落呈全屿，云生失半山。\n牛羊樵路暗，灯火客舟还。\n暝思输凫鹄，归飞沆漭閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客自茂来言元礼日观棋剧饮","author":"宋祁","text":"寒山倒影入楼扉，铃唱愔愔少诤辞。\n左手持螯人嗜饮，一斑窥豹客争棋。\n萍游倦斝伤酲夕，星落残枰斗劫迟。\n日日忘怀还忆否，戍时瓜老是归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣徽太尉郑公挽词二首 其二","author":"宋祁","text":"谁为云亡恨，曾无可赎身。\n江山归国路，桃李泣蹊人。\n追册君恩厚，题功史笔新。\n所嗟经济事，不及相平津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣徽太尉郑公挽词二首 其一","author":"宋祁","text":"秘幄留高议，雄边倚茂勋。\n风流自南国，礼乐得中军。\n卧疾初无损，遗忠忍遽闻。\n寝门今日恸，长作死生分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫保庞丞相以诗见寄次韵和答","author":"宋祁","text":"本乏微功辅斗枢，避贤仍忝领州旟。\n病依一室由旬坐，老愧专城四十居。\n憩石雨苔同发短，啸轩霜竹伴心虚。\n挂冠尚有三年调，高躅空瞻广武庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将归二首 其二","author":"宋祁","text":"云栈短长亭，今兹重作经。\n邛崃叱残驭，蜀分使回星。\n旅鬓双垂雪，羁怀一泛萍。\n骊驹在门久，此曲若为听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将归二首 其一","author":"宋祁","text":"远假西南守，三逢梅柳新。\n衰令宦情薄，老惜岁华频。\n郫酿供销日，巴禽巧唤春。\n离家何所恨，雁后作归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将还都寄献臣","author":"宋祁","text":"茂陵移病在穷年，尚省长安在日边。\n生意不随枯树尽，危心重伴死灰燃。\n秋风压苑檀栾近，夕斗横台睥睨连。\n侧注旧冠尘满屋，定须弹拂故人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将到都先献枢密太尉相公","author":"宋祁","text":"再试州旟验不才，却将憔悴到中台。\n相车问罢同牛喘，大厦成时与燕来。\n今日谋猷须丙魏，他年宾客但邹枚。\n西园闻道馀春在，尚及花前滟滟杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将道洛先寄太师文相公","author":"宋祁","text":"两鬓蓬飞岁月侵，收还秘殿上恩深。\n鸟毛落尽那胜弹，桐尾烧焦敢望琴。\n前日化工依大冶，今兹旧物恃遗簪。\n尘容喜接荧煌座，未忍公然动越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将解职抒怀上郡守","author":"宋祁","text":"空函檄草聚浮埃，日愧西园缀上才。\n著帽每容司马进，脱巾多伴使君来。\n孤根易变江南橘，归梦先随陇首梅。\n惟有酬恩无限泪，异时应溅别离杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屏居寄献侍讲孙尚书","author":"宋祁","text":"侨版农廛陋，飞灰岁琯周。\n危疴负薪困，生事播精求。\n雨露遗幽谷，乾坤占一丘。\n惟馀道边树，独为报春游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡中逢雪","author":"宋祁","text":"峡内逢霏霰，凌辰望已迷。\n寒花才集栈，斜片旋沈溪。\n户入垂缯壤，田成种玉畦。\n速乾殊未惜，山道润无泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽禽","author":"宋祁","text":"已伴传书燕，休随匝树鸦。\n春鸣变高柳，暮散落馀花。\n格磔林烟迥，啁啾观月斜。\n宁同七十二，镇在莫愁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庭石","author":"宋祁","text":"嗟尔一拳质，块生天地中。\n柱云蒸作润，山溜滴成空。\n松盖何年化，星槎此路穷。\n无邀什袭裹，近出宋台东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思归","author":"宋祁","text":"刻意伤春属暮楼，江皋归棹怅夷犹。\n青萝怨鹤英山晓，疏笛吟龙卧坞秋。\n掩泣泥阳思祖庙，长怀彭泽废先畴。\n裂繻前誓风霜苦，早晚怀黄识汉侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]