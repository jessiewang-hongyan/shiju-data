[{"title":"贺范安抚上事十绝 其三","author":"项安世","text":"忽引风帆下玉京，傍人惟见此身荣。\n君侯未解眉间摺，元是忠文去国情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其四","author":"项安世","text":"泥仙高退故难量，国子先生更善藏。\n不枉中朝推范吕，小申公畔有荥阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其五","author":"项安世","text":"太史当年责了翁，二程佳处似春风。\n固应却有诸孙在，重把阳春教郢中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其六","author":"项安世","text":"涨江迎造忽吞天，说与江神莫太颠。\n公是乘槎天上客，曾经倒海试孤骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其七","author":"项安世","text":"十日焚云七泽焦，六千里楚未开窑。\n使君恰与秋同到，一箑风吹万愠消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其八","author":"项安世","text":"因声调笑古扬州，下水如何占上流。\n却倩枚回洲上月，照将馀润到瓜州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其九","author":"项安世","text":"东观归来病史官，枕棱刓尽席痕斑。\n自从公去关门睡，直到公来未启关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其十","author":"项安世","text":"是人从古为秋悲，病骨逢秋更可知。\n说与世人应未信，今年新有羡秋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北张总领六绝句 其一","author":"项安世","text":"故人天上厌晨趋，走向人间看五湖。\n已煮太湖东畔海，更飞青草北边刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北张总领六绝句 其二","author":"项安世","text":"六千里楚旧堂堂，六十年来尔许荒。\n败券殃民为第一，诸馀报发总寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北张总领六绝句 其三","author":"项安世","text":"只道军储入较量，谁知民命更禁当。\n增钱新有梁肤使，破产旧遭周侍郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北张总领六绝句 其四","author":"项安世","text":"券贱官家币日轻，券高民失旧家生。\n靴中运指何年了，一度称提一度惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北张总领六绝句 其五","author":"项安世","text":"杭州之券每新抄，行地仍宽价自豪。\n不出荆州三十载，烂如袍絮若为高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖北张总领六绝句 其六","author":"项安世","text":"吴楚如今共一天，两州分券亦堪怜。\n若教尽展杭州券，应不秤提自直钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵帐干","author":"项安世","text":"晦明风雨朝朝出，远近高低寺寺行。\n汉体八分唐七字，王孙题处总关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹小口候风","author":"项安世","text":"河边高柳种成帷，隔尽朝阳与夕曦。\n卧看绿阴凉吹里，纷纷黄叶下如筛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其一","author":"项安世","text":"六朝宫殿台城古，千徼貔貅幕府尊。\n消得能诗如小谢，去吟佳句张辕门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其二","author":"项安世","text":"美人去作江东云，此酒何时共一樽。\n若上高楼望吴越，亦须回首念荆门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其三","author":"项安世","text":"坐中无子不复乐，幕下得君应更尊。\n相思不似此江水，日日解到西州门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其四","author":"项安世","text":"商妇唱歌歌断魂，吴姬压酒酒盈樽。\n金陵子弟相呼唤，醉著轻衫过市门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其五","author":"项安世","text":"且可勤买抛青春，酌以瘿藤之文樽。\n与君只欲醉中别，切莫更歌驹在门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其六","author":"项安世","text":"风急柳丝飞漠漠，雨馀花片落阴阴。\n行人正用此时去，忍听逢逢船鼓音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其七","author":"项安世","text":"桃花逐水水初长，草色迷春春正阴。\n客子带将春色去，离歌肠断不成音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送刘都干赴金陵 其八","author":"项安世","text":"涌金门外青莲荡，朱雀桁边细柳阴。\n小艇年年寄湖海，教成儿女作吴音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以霜柿饷郑检法","author":"项安世","text":"发毛似霜纷纷白，心地如砂炯炯丹。\n细数诸公谁称此，陶窗居士最宜餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠石首李令 其一","author":"项安世","text":"风荻点头如我助，江豚吐气欲谁冤。\n岸边有客来求脍，只与餐鱼莫与言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠石首李令 其二","author":"项安世","text":"老子头颅新似雪，元兄邱垄旧成阴。\n莫谈三十年前事，愁损河阳一县心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过彭泽县","author":"项安世","text":"去家百里便言归，犹道无成白首非。\n万里青天行蜀道，此心何日得无违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南康刘知录惠贶诗编","author":"项安世","text":"枫疏栗雏康山老，石出舟横汇泽贫。\n挂钵西街三十日，不知邻屋是诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡季履鹅梨绝句","author":"项安世","text":"饤坐只供儿女爱，蒸来堪与俗人言。\n故应世上逃名者，火枣同功赴一原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵和罗机宜探梅不果 其一","author":"项安世","text":"边头无事最高閒，十日沙泥不肯乾。\n走马看花虽未得，笔端风味似曾看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵和罗机宜探梅不果 其二","author":"项安世","text":"小梅风味最高閒，净洗铅华粉面乾。\n试问吟诗向东阁，如何骑马竹西看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春来","author":"项安世","text":"杨柳梢头金穟重，酴醾枝上玉针长。\n春来小院才三日，花女林神有许忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东冶寻梅未开","author":"项安世","text":"东冶亭西红白梅，贮琼藏玉为谁开。\n一枝不遣幽人赋，忍待春浓醉客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰月二十一日作落梅花 其一","author":"项安世","text":"十亩寒林一树梅，自妍自笑已堪哀。\n朝来更被风吹却，拟遣春从底处回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰月二十一日作落梅花 其二","author":"项安世","text":"野外篱边烂漫香，晚风孤影弄霓裳。\n飞花满地无人管，却趁春泥上燕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芜湖县阻雨","author":"项安世","text":"江南五月作秋阴，杜若洲前十日霖。\n卧听儿童说风雨，老来元自不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿建康府沙河夹","author":"项安世","text":"晚风横起沙河夹，落日正明瓜步山。\n夹里人家似苕霅，稻田荷荡水云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵雨花台感僧云光事自警","author":"项安世","text":"横经处处客诸侯，一上高台愧不休。\n讲罢直饶花自雨，未妨辕下作官牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋蝇","author":"项安世","text":"凭暖欺人扑面飞，天寒堕案却相依。\n世间冷热情何限，怜汝为生独细微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沿江烟突","author":"项安世","text":"日乞烘江水气暄，杏花饧粥并淮天。\n望楼烟突清于水，平世边城自禁烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡仲方送周退傅杨待制二像","author":"项安世","text":"九霄仙鹤平园像，大室神龟野客真。\n不是胡郎相介绍，草间麋鹿得相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜闻风竹有怀","author":"项安世","text":"竹客源头逆旅间，道人同此听潺湲。\n小窗夜半闻风竹，梦著征袍绕故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹客源二首 其一","author":"项安世","text":"乡人见客面颜开，客子还乡意极哀。\n白发老亲情最切，阿姑阿姒不同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹客源二首 其二","author":"项安世","text":"白头祖母命相依，此地当年共食薇。\n二十五年如昨日，伤心同去不同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敝庐毕工","author":"项安世","text":"心折半生行道路，眼明今日见茆茨。\n梦魂犹在风波处，月黑江喧下缆时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月旦上冢诗 其一","author":"项安世","text":"当时飞鞚得金堤，掣电惊风过马蹄。\n今日笋舆摇醉帽，城东一日到城西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月旦上冢诗 其二","author":"项安世","text":"敝车羸马袅荒陂，十步蹒跚九步攲。\n不恨傍人骑马过，病夫曾有少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月旦上冢诗 其三","author":"项安世","text":"流莺飞絮满城时，曾踏春风看柳枝。\n却到枯条黄叶下，人生老去更何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月旦上冢诗 其四","author":"项安世","text":"一年两度过城隅，似读皇王万古书。\n看罢春花与秋叶，人间万事更何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田间晓竹","author":"项安世","text":"稻花香里泉声滑，草露梢头日影圆。\n唤起东中十年梦，山阴道上早秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至日早起","author":"项安世","text":"儿童吹火注油灯，起著新衣坐到明。\n病里已知时节换，夜阑龟息见阳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅花","author":"项安世","text":"香如江路晚风腾，色似蜂房晓露凝。\n姓蜡名梅俱是假，世间多少墨成蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗中有醉字","author":"项安世","text":"年来不饮杯中物，减却诗材淡却伊。\n诗里有时须说醉，一生诚实此为欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨怀承甫兄 其一","author":"项安世","text":"夜深风霰入油疏，小院灯明自勘书。\n料得系舟低柳下，一江烟雨怨离居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨怀承甫兄 其二","author":"项安世","text":"轻寒剪剪透罗衣，正是行人二月时。\n重下翠帷犹不隔，短篷疏雨更相欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初夏偶作","author":"项安世","text":"一天浓绿点残霞，百摺湘裙血染纱。\n刚道春归无觅处，十分妖艳在榴花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫兴四绝 其一","author":"项安世","text":"赤日烧云汗满衫，一年还却十年闲。\n男儿不是忧家国，水簟冰幮正掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫兴四绝 其二","author":"项安世","text":"平生竹帛最关心，未免干戈老系身。\n可共儿曹争染刺，大书衔位诧比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫兴四绝 其三","author":"项安世","text":"报国虽贪死后名，还家亦慰老来情。\n钓鱼船上湾湾月，何用辕门报五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫兴四绝 其四","author":"项安世","text":"兵馀初傍碧钩栏，青杏垂垂绿荫团。\n手接叶条成太息，一春花好不曾看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又前韵 其一","author":"项安世","text":"得来棚下脱衣衫，筵席初收戏士闲。\n君相恩深何以报，班超生入玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又前韵 其二","author":"项安世","text":"桃花扇底画楼心，个个三千只一身。\n可是从来多薄命，枉将颜色似东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又前韵 其三","author":"项安世","text":"何须纸上十分名，且乐尊前现在情。\n两鬓雪霜心尚骇，万般情伪老方更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又前韵 其四","author":"项安世","text":"庭前黄耳卧花栏，瘦胁长腰骏尾团。\n壁上朱弓双鹊面，寂寥终日两相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤仙花","author":"项安世","text":"紫凤生儿未解啼，三三五五并头栖。\n爱花未识花枝在，随干随根著处迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临邛试士","author":"程公许","text":"沉沉锁棘春风晚，漠漠重帘昼景移。\n白纻晓寒疑梦事，袖间犹记墨淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"内机知府郎官再和示教清拔遒美手不能置用韵以答嘉贶愧不足以当琼瑶之报也 其三","author":"程公许","text":"长怜杞菊老天随，未必无才可济时。\n盖代功成一炊黍，清名过取恐非宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"原酒","author":"项安世","text":"惟天降命，造此芳醇。\n以养老疾，以奉祭宾。\n少壮强艾，学仕耕耘。\n食焉不暇，何酒之云。\n世衰道降，礼丧法沦。\n以酒为膳，每食必陈。\n童稚拟老，闺闼僣神。\n心钳废虑，体缓妨勤。\n业荒弗竟，行毁弗成。\n俊才中画，毅志早惛。\n勿谓有常，异于湎沉。\n亵天慢性，其罪则均。\n作此自谕，谕我子孙。\n恐干众怒，勿示外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其一","author":"项安世","text":"昊芒布政，律吕旋阳。\n草衰化绿，木瘁回苍。\n老惊岁换，少喜年芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其二","author":"项安世","text":"藻动鱼戏，泥衔燕忙。\n早莺喜谷，回雁惊湘。\n缫敷丽苑，和风海翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其三","author":"项安世","text":"夭夭申禁，庆惠迎祥。\n扫花风暖，飞絮日长。\n道盈士女，胜赏交相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其四","author":"项安世","text":"宝珠簪珥，黛粉匀妆。\n讨探赏玩，赋咏盈箱。\n恼客云阴，愁人雨凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其五","author":"项安世","text":"好鸟窥檐，戏蝶逾墙。\n倒醉人归，歌行客狂。\n岛幽含淑，波远浮光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其六","author":"项安世","text":"槁枯滋泽，偃屈抽芒。\n稻畦远翠，蕙径幽香。\n皂舆喜洽，风流激扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 其七","author":"项安世","text":"皞皞情适，熙熙俗康。\n媪富流形，物阜舆方。\n造回坱圠，元化施张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转轮八花诗 钩枝上四十八句左旋阳字韵右旋昊字韵","author":"项安世","text":"缟夜李积，炫昼桃缃。\n皓梨斗雪，金柳敷黄。\n杲日天丽，和风海翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]