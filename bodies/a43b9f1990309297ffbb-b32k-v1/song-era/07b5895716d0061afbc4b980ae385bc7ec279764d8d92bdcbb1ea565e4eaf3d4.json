[{"title":"句 其五","author":"冯坦","text":"飘风惊日月，落叶满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"冯坦","text":"井在丹谁炼，碑残墨欲枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"冯坦","text":"多应河畔骨，便是屋中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其八","author":"冯坦","text":"无钱难得酒，有菊自开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"冯坦","text":"鸥趁湍流下，鱼藏石罅间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十","author":"冯坦","text":"郡乘纪春申，山因号曰君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十一","author":"冯坦","text":"非关前哲真难及，自是今人不肯高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十二","author":"冯坦","text":"道人已是九分清，双鹤飞来凑十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十三","author":"冯坦","text":"万里远来寻屋住，四边先问有梅无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十四","author":"冯坦","text":"古庙荧荧多鬼火，荒村寂寂少人烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十五","author":"冯坦","text":"可怜门外新归燕，不见堂前旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十六","author":"冯坦","text":"店荒任客来争席，郊迥无人可问程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十七","author":"冯坦","text":"每向宋清求善药，闲从詹尹卜新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十八","author":"冯坦","text":"灯影照残孤枕梦，雨声滴碎两年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十九","author":"冯坦","text":"兴亡有数从千古，寒暑无情又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十","author":"冯坦","text":"问天底是资身策，度日应收卖卜钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"练裙带中诗 其二","author":"韩希孟","text":"宋未有天下，坚正臣礼秉。\n开国百战功，每阵惟雄整。\n及侍周幼主，臣心常烱烱。\n帝曰卿北伐，山戎今有警。\n死狗莫击尾，此行当系颈。\n即日辞陛下，尽敌心欲逞。\n陈桥忽兵变，不得守箕颍。\n禅让法尧舜，民物普安静。\n有国三百年，仁义道驰骋。\n未改祖宗法，天胡肆大眚。\n细思天地理，中有幸不幸。\n天果丧中原，大似裂冠衽。\n君诚不独活，臣实无魏丙。\n失人焉得人，垂戒尝耿耿。\n江南无谢安，塞北有王猛。\n所以戎马来，飞渡巴陵境。\n大江限南北，今此一舴艋。\n本期固封疆，谁谓如画饼。\n烈火燎昆冈，不辨金玉矿。\n妾本良家子，性僻守孤梗。\n嫁与尚书儿，衔署紫兰省。\n直以才德合，不弃宿瘤瘿。\n初结合欢带，誓比日月炳。\n鸳鸯会双飞，比目愿长并。\n岂期金石坚，化作桑榆景。\n旄头势正然，蚩尤气先屏。\n不意风马牛，复及此燕郢。\n一方遭劫虏，六族死俄顷。\n退鹢落迅风，孤鸾吊空影。\n簪坚折白玉，瓶沉断青绠。\n一死空冥府，忧心长炳炳。\n意坚志不移，改邑不改井。\n我本瑚琏器，安肯作溺皿。\n志节匪转石，气噎如吞鲠。\n不作爝火燃，愿为死灰冷。\n贪生念曲蛾，乞怜羞虎阱。\n借此清江水，葬我全首领。\n皇天如有知，定作血面请。\n愿魂化精卫，填海使成岭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧门","author":"林景熙","text":"一閒每笑不如僧，及到僧门閒未能。\n昨夜褐袍风雪里，隔溪犬吠入林灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中?泉旧在扬子江心今题金山寺井曰第一名泉余疑而问僧僧谓神龙所移尝示梦方丈亦愚世也然江心风涛茫渺纵有泉不复可取 其二","author":"林景熙","text":"金鳌背上汲清泠，僧说龙移远脉灵。\n若定此泉为第一，惠山未必服中?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汪东岩为余写容求赠诗余以其学佛者也故后章及之 其二","author":"林景熙","text":"因形有像转支离，妙笔从君压画师。\n若向禅中参一指，写余父母未生时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言 其二","author":"林景熙","text":"流水独吟花径，好山重约云门。\n茶瓯疏竹孤寺，桐角斜阳远村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十三首 其六","author":"释云岫","text":"春山叠乱青，春水漾虚碧。\n寥寥天地间，独立望何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"朱焕文","text":"江山千里俱头白，骨肉十年终眼青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠卖墨吕云叔访陈烟山 其二","author":"朱浚","text":"蓬莱仙子世偏珍，琮璧多携问楚津。\n若向积烟峰下过，殷勤传语卧楼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金樱子 其二","author":"丘葵","text":"采采金樱子，芒刺钩我衣。\n天寒衫袖薄，日暮将安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙湖归","author":"丘葵","text":"策蹇下平岗，挂帆渡安流。\n平生不行险，间道旋故丘。\n高堂有鹤发，安敢事远游。\n负米虽不多，过冬亦稍优。\n所愧无甘旨，一饱良易谋。\n兢兢保遗体，无遗慈颜忧。\n读书茅檐下，庶几少愆尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿黄花馆","author":"杨发","text":"孤馆萧条槐叶稀，暮蝉声隔水声微。\n年年为客路无尽，日日送人身未归。\n何处离鸿迷浦月，谁家愁妇捣霜衣。\n夜深不卧帘犹捲，数点残萤入户飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绵","author":"王梦应","text":"绵绵瓜瓞，施于中林。\n顾于烝尝，匪今斯今。\n既庶既繁，既多受祉。\n厥胤维何，宜兄宜弟。\n兄弟求矣，以燕翼子。\n子兮子兮，继序其皇之。\n螟蛉有子，式谷似之。\n建尔元子，勿替引之。\n谷旦于差，惠于宗公。\n工祝致告，神罔时恫。\n是烝是飨，何天之宠。\n酒醴维醹，殽核维旅。\n吹笙鼓篁，和乐且孺。\n式序在位，以速诸父。\n天锡公纯嘏，洵美且仁。\n如南山之寿，展也大成。\n从以孙子，绳其祖武。\n自今以始，日就月将。\n遹观厥成，为龙为光，长发其祥。\n兄及弟矣，乃生男子。\n维其有之，是以似之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"郑德普","text":"石润黏苍藓，涧高流白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"郑德普","text":"雁断风仍急，鸟啼天正阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"界牌铺","author":"彭九万","text":"地僻人家早掩关，行人忙逐暮鸦还。\n急风花落隔墙树，暗雨鸟啼何处山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牛山之木四章","author":"赵友直","text":"牛山之木，于彼空谷。\n悠悠我思，孰云勿谷。\n牛山之木，欣欣其荣。\n我有好爵，君子攸宁。\n木其荣矣，繁霜瘁之。\n静言思之，中心怆而。\n木之瘁矣，益厚其根。\n我之怀矣，匪善奚敦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题壁","author":"赵友直","text":"三北谁人知管仲，五湖何处觅陶朱。\n壁间遗墨还堪睹，吊罢灵魂一束刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刺贾秋壑诗 其二","author":"咸淳士人","text":"事到穷时计亦穷，此行难倚鄂州功。\n木棉庵上千年恨，秋壑堂中一梦空。\n石砌苔稠猿步月，松庭叶落鸟呼风。\n客来未用多惆怅，试向吴山望故宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其一","author":"谢翱","text":"日离海，青曈昽。\n沃以积水，涵苍穹。\n神光隐，豹雾空。\n气呼吸，为蛇龙。\n赤云衣，紫霓从。\n吹白众宿，歌大风。\n天吴遁，清海宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其二","author":"谢翱","text":"天马黄，产异方。\n龙为马，白照夜。\n气汗云，声彗野。\n备法衣，引宸驾。\n腾天垠，倏变化。\n闰之馀，劘以霸。\n阅八姓，瞬代谢。\n驱祥灵，入罟擭。\n皇上帝，监于下。\n誓无哗，出既祃。\n市日中，不易贾。\n坐明堂，朝诸夏。\n赉万方，锡纯嘏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其三","author":"谢翱","text":"黎之野，弥苍莽。\n迤壶关，属上党。\n有雄矫健，曰馀宿将。\n于故之思，泣示厥像。\n倚孽狐，势方张。\n辨臣献议，劝下太行。\n趋怀孟虎牢，计之上。\n争洛邑，以东乡。\n王师奄至，扼其吭。\n帝授方略，中厥状。\n兽穷骇突，死卒以炀。\n胁从已逮，孥肆放。\n凯歌回，皇威畅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其四","author":"谢翱","text":"上临墉，戈耀日。\n韎韦指顾，流电疾。\n罪止其魁，不及卒。\n其魁则顽，曰予虢自出。\n坐于辕门，斧以率归。\n子往谕，泣股栗。\n语中其肝，至毕述。\n侍不及屏，沮回遹鞠。\n投于燎，甘所即。\n皇仁闵下，焉止跸。\n貔貅彻灶，归数实。\n获其棘矢，纳世室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其五","author":"谢翱","text":"军澧南，溃飞鸟。\n鹰隼北来，龙蛇夭矫。\n帝有初命，奉致讨。\n临于荆，妖孽既扫。\n胡驱而孕雉，入苍莽以保。\n王旅长驱，飒振槁。\n以仁易暴，戒击剽。\n惟荆衡及郴，士如林，磔其节蟊。\n春葩秋阴，我有造于南。\n式敷德音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其六","author":"谢翱","text":"邻之震，震于户。\n戒登陴，彻守御。\n神威掩至，不及拒。\n沿楚以南，菁茅宿莽。\n献于王吏，奉厥土。\n天子有诏，侯西楚。\n自南北东，皆我疆。\n龙旗虎节，拜降王。\n秦戈巩甲，期韬藏。\n冕旒当中，垂衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其七","author":"谢翱","text":"母思悲，母于归。\n母闻帝语，妾归无所。\n妾生并土，蜀野芒芒，奄失其疆。\n初帝谓母，子昶来，小者侯，大者王。\n有痍其肌，载粟于创。\n毕有下土，方归母于乡。\n天不女夺，朕言不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其八","author":"谢翱","text":"象之奔斯，惟迹蹶蹶。\n鱼丽驾空，云鸟溃。\n南草浮浮，顺于貔貅。\n焚其帑，实弃厥陬。\n皇风播，平?瞀。\n星辰起，皆北走。\n唐季以来，逆雏来咮。\n岭海肃清，无留后。\n于汴献囚，凯歌奏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其九","author":"谢翱","text":"帝命将臣，誓师于征。\n伯牙于庭，曰无刘我人。\n曲阿惟唐，以及豫章。\n孽于南国，楚粤是疆。\n我师孔武，聿禽其王。\n始怒皋皋，将臣不怿。\n曰如上命，即起予疾。\n弓韬于衣，刃以不血。\n收其石程，焚其侈淫。\n视于丁宁，筈羽不饮。\n取其镈磬，以献于京。\n于庙告成，垓埏既平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其十","author":"谢翱","text":"版图归，归职方。\n昔服跗注，备戎行。\n帝锡之旆，龙鸟章。\n酬献命与胥，今上及秦王。\n外臣拜稽首，笑颔帝色康。\n毕同轨，来于梁。\n晔灵奕奕，敷重光。\n愿止剑履，觐带裳。\n四海臣妾，配虞唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其十一","author":"谢翱","text":"清源无诸邦，力弱臣秣陵。\n间道遣进表，九门望日旌。\n愿齿邹与郳，自达天子庭。\n四邻彫霸业，国除洗天兵。\n皇灵畅遐外，蜑俗迩声明。\n归其所隶州，乞身奉朝请。\n帝命得陪祀，汤沐在王城。\n从兹附庸毕，歌以颂河清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋铙歌鼓吹曲 其十二","author":"谢翱","text":"上之回，舞干戚。\n鸣鸾在镳，士饱力。\n桴鼓轰腾，罕山北。\n馀刃恢恢，军容肃穆。\n王畿主辰，参后服神。\n继圣伐功，卒扼以偏师，断北狄。\n矢菆鸣房，猬集的。\n质子援绝，亲衔璧。\n并俗嚬嚬，附于化，以安得。\n其屈产，归帝闲。\n四夷君长，来称藩。\n籥节夷乐，示子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 亲征曲第一","author":"谢翱","text":"云屯列灶驱貔貅，殿前杀马祭蚩尤。\n勾陈苍苍太白湿，贼帐梦惊绕营日。\n军呼万岁摧太行，华留东抹流电光。\n重华继尧坐垂拱，并土再驾无葛疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其一 回銮曲第二","author":"谢翱","text":"徂暑黎阳车驾归，扫清氛翳兵更衣。\n江都朔云车驾出，凯歌消冰供尚食。\n都人引领望翠华，征人一月俱还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其二 回銮曲第二","author":"谢翱","text":"长堤夜幸士素饱，孤城沈灶无飞鸟。\n从征卤簿拜上恩，太常朝上回銮表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其三 回銮曲第二","author":"谢翱","text":"都人望气归瑶阙，星扫茸头落参伐。\n西人冉冉留紫云，六飞拥日歌回军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其一 遣将曲第三","author":"谢翱","text":"天门雷动开风云，内前尽给羽林军。\n圣人神武授方略，斩将搴旗各骏奔。\n王师所过如时雨，洗濯焦枯向荆楚。\n重宣德意吊遗黎，素服军前释俘虏。\n全家到阙拜上恩，诏书为筑先臣墓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其二 遣将曲第三","author":"谢翱","text":"神风流霆驱偃草，天兵夜下西南道。\n虎贲长戟来凤州，归峡衔枚疾如扫。\n庙谟万里谂诸将，山川曲折图形状。\n天同鬼授契若符，坐减罘罳虏供帐。\n归来论功授节镇，铙鼓殿前歌破阵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其一 归朝曲第四","author":"谢翱","text":"荆南万里朝天道，巫女云荒产芳草。\n锦鞯道赐带盘雕，方物南来进龙脑。\n愿陪郊祀依日光，供张归朝亲奉表。\n勋阶邑食及隶人，移镇徐戎作家庙。\n人生富贵侯与王，四海为家皆故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 其二 归朝曲第四","author":"谢翱","text":"勾吴月令牵牛中，翟茀乘风来閟宫。\n随王剑履朝上殿，黄门夜趣长春宴。\n昭容引班入内朝，龙衮当中开雉扇。\n宴罢朝辞生局促，诏赐离宫作汤沐。\n先王烝尝泽有差，上恩许歌陌上花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 谕归朝曲第五","author":"谢翱","text":"淮南草湿网虫露，家在先朝父尚主。\n真人御极四海归，偃蹇不朝称节度。\n夜持铁券为尔赐，上恩特遣仪銮使。\n神离魄夺取族夷，功臣效命锡龙旂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 李侍中妾歌第六","author":"谢翱","text":"李筠爱将唯儋圭，美人姓刘筠侍儿。\n城危抢拨不得力，雨损铅华帐下啼。\n拥髻前言马有几，犹说闺中那问此。\n赤龙从东乘日车，火绕城门内蛇死。\n英雄际会风云奔，妇人思报罗裳恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 孟蜀李夫人词第七","author":"谢翱","text":"春荒曲薄蚕丛土，屈狄归朝辞庙主。\n官家呼母恩许归，剑阁并门无处所。\n故衣升屋棺四绕，出门哭子汴州道。\n回肠酹酒三致辞，巴蜀如归化啼鸟。\n老身不食追尔魂，卤簿临门拜上恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 南唐奉使曲第八","author":"谢翱","text":"孤城围中拜右史，侍书犹对重瞳子。\n请行忼慨期缓师，奉命日驰三百里。\n河流溯风车北首，便殿蒙恩引天袖。\n臣肝有血不溅衣，寸舌欲存建王后。\n奇胸如江涌崔嵬，恸哭不得天颜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 伎女洗蓝曲第九","author":"谢翱","text":"后庭朱黄作衣里，伎女帐帷青曳地。\n碧绿夜挂寒不收，缘此洗蓝渟露水。\n外间学染因得名，不省归朝为国氏。\n他年寄生产鸱尾，空忆宫中鸟衔子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋骑吹曲 邸吏谒故主曲第十","author":"谢翱","text":"岭南使鹤日教战，巫女才人谑相见。\n南桡欲载远游冠，卫士盗船去不还。\n梦见随俘上江邱，道谒凄凉唯故吏。\n自言置邸本先王，方物入朝缘此至。\n闻言含咽涕洒江，况乃园人旧姓庞。\n泪辞岭海无归处，蒙恩祇向江陵住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芳草怨","author":"谢翱","text":"湘云离离沉晓月，疏麻夏死白水发。\n传芭楚女辞帐中，夜逐霓旌南过越。\n荆岑越峤殊百草，恨结柔丝香不老。\n红英捣盐实斧创，青子满地枝如扫。\n刺桐树朽猩猩在，佩杂芳蕤散秋海。\n乡来青凤食花去，瞻望灵均涕零雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春江曲","author":"谢翱","text":"妾身生长临江边，幼嫁酒家学数钱。\n自从夫婿去为贾，别妾初下武昌船。\n涔阳归雁不寄影，巂州书到已三年。\n别时梦指水为誓，惟有海凫见妾泪。\n愁抛锦字下中流，却见海凫泪如水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子夜吴歌","author":"谢翱","text":"玄发照秋水，茱萸香未歇。\n风吹夜合花，露湿衣上月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌栖曲拟张司业","author":"谢翱","text":"吴宫草深四五月，破楚门开乌啼歇。\n美人军装多在船，归来把弓堕弓弦。\n越罗如粟越王献，宫中养蚕不作线。\n辘轳出屋井水浅，栀树花萎子如茧。\n乌栖乌啼宫烛秋，越女入宫吴女愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]