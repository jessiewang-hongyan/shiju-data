[{"title":"和丁端叔月窟韵","author":"袁说友","text":"几度飘零满地金，移根堂下豁尘襟。\n主翁自是曾修月，更为人间著翠阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子长见招韵四首 其四","author":"袁说友","text":"飞香雨过双溪阁，舞翠荷开十丈花。\n佳处正须供一赏，相从吾亦岂匏瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子长见招韵四首 其三","author":"袁说友","text":"清游已恨期年别，胜处能消一日情。\n莫对浮山无好语，相逢草木有佳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子长见招韵四首 其二","author":"袁说友","text":"青林绿幄春归后，翠岫苍崖雨过初。\n作意寻幽还得笑，随宜供客莫求馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子长见招韵四首 其一","author":"袁说友","text":"攻击愁城从事里，消磨日月手谈中。\n不缘我辈真风味，安得尊前笑语同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和友人秋日韵二首 其二","author":"袁说友","text":"了无风雨夕阳低，多少诗翁问白衣。\n把酒西风暗相约，年年篱下菊时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和友人秋日韵二首 其一","author":"袁说友","text":"楼外西山日脚低，萸觞新唱缕金衣。\n十年为客秋风里，空负黄花几赋归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲躬赠轮道者韵","author":"袁说友","text":"孤峰顶上阿谁能，苦竹怜渠著意曾。\n他日林间重勘辨，我身元是在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年张季良少卿馈家酿韵三首 其三","author":"袁说友","text":"拭目高吟陋戴盆，续貂何敢曳诗门。\n百壶荡桨惟公尔，此外应无说尹村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年张季良少卿馈家酿韵三首 其二","author":"袁说友","text":"与君昔日赋斜阳，绮语曾窥万丈光。\n节物撩人人更老，篱边犹是去年黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年张季良少卿馈家酿韵三首 其一","author":"袁说友","text":"六十衰颓愧鬓蓬，黄花更负一年中。\n白衣谁荐红萸酒，吸尽残荷碧玉筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年春日韵五首 其五","author":"袁说友","text":"雄篇多幸到柴扉，祇恨空留最后枝。\n收拾愧同螬食李，侯生谁复敢言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年春日韵五首 其四","author":"袁说友","text":"雨膏风软草烟低，处处春来处处知。\n尤喜梅花未轻褪，枝头一朵尚凝脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年春日韵五首 其三","author":"袁说友","text":"一川晴草竞春光，绿抹红匀日日忙。\n榼酒莫辞花下醉，相将堤上柳花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年春日韵五首 其二","author":"袁说友","text":"伤心客里子规啼，自笑情怀更小儿。\n短策强随杨柳去，归来却喜燕衔泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年春日韵五首 其一","author":"袁说友","text":"寻花喜见去年人，点检枝头次第春。\n踏遍云塘旧游处，漾波涨碧更粼粼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和成父过宝应县韵","author":"袁说友","text":"趁得花封八月凉，相家有子绾铜章。\n习华指日神京路，此地方知宝应祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和艮斋赠轮道者韵","author":"袁说友","text":"血指濡毫字字工，赤髭白足会常同。\n从今定了沙弥相，总为先生一语中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陆成父司户过淮阴县韵三首 其三","author":"袁说友","text":"论功久已冠群侯，更欲王齐愿自留。\n从此朝家若惩创，王侯应得戒非刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陆成父司户过淮阴县韵三首 其二","author":"袁说友","text":"当年三杰共封侯，谁念淮阴为汉留。\n不是向来曾蹑足，未容平勃独安刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陆成父司户过淮阴县韵三首 其一","author":"袁说友","text":"谁云追信属酂侯，政为高皇意欲留。\n岁晚不疑云梦计，那知大业已兴刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范石湖咏双莲三首 其三","author":"袁说友","text":"鉴湖一曲记蓬莱，棹入红蕖挽不回。\n今日池光少公事，好怀聊复为渠开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范石湖咏双莲三首 其二","author":"袁说友","text":"天泉池上舞晴晖，一别人家未肯归。\n千载却随湘女泣，风前时学凤凰飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范石湖咏双莲三首 其一","author":"袁说友","text":"江妃瑟里恨沈沈，万点红边意转深。\n拥出三千歌舞罢，翠绡萦得两同心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康叔探梅韵三首 其三","author":"袁说友","text":"寻梅著语乐清閒，已觉孤山气象还。\n未办轻舟行百里，也须踏脚法华山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康叔探梅韵三首 其二","author":"袁说友","text":"诗坛传檄未应虚，忍负东君自作疏。\n急急花前岩下看，横斜清浅两何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康叔探梅韵三首 其一","author":"袁说友","text":"今年人忆去年梅，试问今年花已开。\n见说春风正料理，不应小雨便花摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梁转运判官韵","author":"袁说友","text":"古括人豪醉墨鲜，一樽宁怯酒如船。\n新诗磊磊珠玑落，不记梅花在眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程阁学送小春茶韵四首 其四","author":"袁说友","text":"家山历历未归来，投老江湖祇自咍。\n赖有年年乡信好，一瓯浮玉饱春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程阁学送小春茶韵四首 其三","author":"袁说友","text":"七椀由来厌八珍，犹堪代酒亦生春。\n个中风味须知趣，惭愧刘公独倚新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程阁学送小春茶韵四首 其二","author":"袁说友","text":"物物呈祥岂偶然，新芽新味更新年。\n灵苗却解为人寿，请为君谟续此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程阁学送小春茶韵四首 其一","author":"袁说友","text":"眼看节物去重来，又见寒梢数点梅。\n草木已随新岁好，冬芽豫占一年魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程泰之阁学咏雪十二题 其九 打雪","author":"袁说友","text":"庭柯风动还筛玉，稍稍柔条醉欲持。\n刚道琼瑶未轻扫，晚鸦栖处已摇枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程泰之阁学咏雪十二题 其十一 弄雪","author":"袁说友","text":"天与骚人景物宜，风流嘲戏恰相知。\n长安道上吟诗罢，笑里骑驴缓勒羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程泰之阁学咏雪十二题 其八 饮雪","author":"袁说友","text":"饮冰受命元非僻，齧雪充饥岂是狂。\n何似催班仙仗里，一堂均宴近臣觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程泰之阁学咏雪十二题 其六 招雪","author":"袁说友","text":"一别瑶池辄去思，明年农事要先知。\n天风夜半幡旂动，便欲欺梅更压枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程泰之阁学咏雪十二题 其十二 挂雪","author":"袁说友","text":"一庭冰柱初融湿，满阵飞沙又压檐。\n夺得琼花消息早，扬州十里上珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe