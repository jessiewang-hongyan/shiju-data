rneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊吴江食莼鲈菰菜二首 其二","author":"袁说友","text":"一舸清风四牡还，垂虹亭上几栏干。\n季鹰命驾劳千里，如我清游却不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊吴江食莼鲈菰菜二首 其一","author":"袁说友","text":"青丝簇饤莼羹味，白雪堆盘缕鲙鲈。\n我向松江饫鲜美，菜肠今更食新菰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊金山观虞仲房书云峰扁榜","author":"袁说友","text":"平生笔法蔡中郎，到处标名忆仲房。\n一涕无从人不见，云峰亭下水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊荆南二首 其二","author":"袁说友","text":"可怜吴蜀爱荆州，胜赏相当卒罢休。\n何地无城堪保障，此城端为据咽喉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊荆南二首 其一","author":"袁说友","text":"荆州天险大江蟠，坐制金陵自不难。\n却遣千艘沉赤壁，至今耆老笑曹瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泊真州沙岸","author":"袁说友","text":"终朝百尺掣风槎，半夜将星到白沙。\n休说元戎誇十乘，且随商橹傍村家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵","author":"袁说友","text":"青衫往事几经秋，白首重来忆旧游。\n今夜台城无限月，更凭樽酒豁羁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其十二","author":"袁说友","text":"男儿弧矢四方居，何以家为莫念渠。\n打扑精神希一遇，书来不必问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其十一","author":"袁说友","text":"万瓦丛中客里身，可怜虚度一番春。\n日长寻得宽心术，唤取门前卖卜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其十","author":"袁说友","text":"挑灯拭眼聚诗材，撚断须时句欲裁。\n判却三更犹不寐，待渠明月过楼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其九","author":"袁说友","text":"急雨斜风一夜狂，客衾愁枕五更长。\n问君个里情怀恶，不听鹃啼也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其八","author":"袁说友","text":"只作离家一月程，如今一月正飘零。\n定非官禄星临命，想见流年是客星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其七","author":"袁说友","text":"世事全无只恁閒，光阴閒里故相关。\n欲将睡去消磨日，睡得醒时日未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其六","author":"袁说友","text":"有愁无睡照灯青，鼠齧虫吟到五更。\n不分小黥同作祟，呼牌也作百般声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其五","author":"袁说友","text":"闷杀楼居隘似囚，一楼四壁障双眸。\n趁晴下得楼来看，又被西风赶上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其四","author":"袁说友","text":"一去重来发已星，八年归老卧漳滨。\n似曾相识满天下，不信怜渠未有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其三","author":"袁说友","text":"老来无复梦清都，到得清都却守株。\n些子行期犹自拙，个中能巧定应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其二","author":"袁说友","text":"东风一夜转西南，分外羁愁分外寒。\n秋里酒肠浑不放，一杯全似十杯宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安邸中即事且谢诚斋惠诗十二首 其一","author":"袁说友","text":"犹得十篇慰旅思，坐吟行咏只相随。\n岂无一个閒宾客，便有谁来得似诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出郊","author":"虞俦","text":"万山深处长官贫，不惯将迎懒是真。\n谁解移文回俗驾，漫劳举扇障风尘。\n碧云日暮还无信，白眼途穷易见嗔。\n归去荒村望灯火，是何鸡狗亦惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至慎邑寄鼎","author":"郭祥正","text":"踏尽琼瑶百里山，欲投城郭暮云间。\n红炉速置一壶酒，故岁离家新岁还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其十","author":"袁说友","text":"千里山行一月程，攀层蹑级几宵征。\n明朝猛入遂宁路，闻说夷途砥样平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其九","author":"袁说友","text":"浩荡东风晚更严，黄埃得得上霜髯。\n细题今日山中景，更有前头万点尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其八","author":"袁说友","text":"倚风修竹叶滋繁，穿石湍流浪吐吞。\n薄暮柴门人影寂，晓风烟树鸟鸣喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其七","author":"袁说友","text":"鼙鼓鸣山绿叶摇，繁声嚣杂漫终朝。\n不如涧下一杯水，沃起行人心肺焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其六","author":"袁说友","text":"老去纡行盍罢休，忙身閒虑足搔头。\n林烟岩雾鸟声远，独对遥山无限愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]