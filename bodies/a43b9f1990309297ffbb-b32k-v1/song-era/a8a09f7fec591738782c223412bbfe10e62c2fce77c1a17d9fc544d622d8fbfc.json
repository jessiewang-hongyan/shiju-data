[{"title":"钦圣宪肃皇后挽词二首 其一","author":"陈师道","text":"二妃端协帝，三后共兴周。\n决策天同力，收功语不流。\n权宜从杀礼，末命尚深忧。\n郁郁佳城闭，终天配寿丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钦慈皇后挽词二首 其二","author":"陈师道","text":"灵岳占佳气，琳宫閟宝衣。\n应祈符圣历，锡号焕皇扉。\n日月尧同数，讴歌启与归。\n伤心五云去，不见六龙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钦慈皇后挽词二首 其一","author":"陈师道","text":"二祧从孝祀，五典载虞嫔。\n显号追先志，阴功见后人。\n承颜亲不待，罔极痛如新。\n未有如椽笔，光容可得陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜","author":"陈师道","text":"七十已强半，所馀能几何。\n悬知暮景促，更觉后生多。\n遁世名为累，留年睡作魔。\n西归端著便，老子不婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜对酒赠少章","author":"陈师道","text":"岁晚身何托，灯前客未空。\n半生忧患里，一梦有无中。\n发短愁催白，颜衰酒借红。\n我歌君起舞，潦倒略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日书事","author":"陈师道","text":"花絮随风尽，欢娱过眼空。\n穷多诗有债，愁极酒无功。\n家在斜阳下，人归满月中。\n肝肠浑欲破，魂梦更无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜有怀","author":"陈师道","text":"卧念张居士，逃名老石根。\n学诗真得瘦，识字即空樽。\n鸣笛夜宜远，灯花晓更繁。\n未须哀老子，也复守丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏杪","author":"陈师道","text":"一室青芜长，终朝静不哗。\n圣贤开美酒，子母破新瓜。\n绿筱初翻箨，红蕖稍荐花。\n咄嗟功业晚，览照鬓初华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴黄提刑致语口号","author":"陈师道","text":"当年天下无双誉，此日朝中第一人。\n坐使黄流随指顾，即看丹阁画精神。\n天威行复朝三接，和气今如物再春。\n肯驻行轩慰离索，听歌举白莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐氏闲轩","author":"陈师道","text":"倦游梁楚爱吾庐，老寄山林孰与娱。\n想见杖藜临过鸟，更能赤手缚于菟。\n君宁平世轻三釜，我亦东原有一区。\n拟买婵娟作归计，可无堆玉斗量珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"捕狼","author":"陈师道","text":"一狼将四子，二岭走千羊。\n意得无前敌，时乖阙后防。\n宁知射生手，已发弩机张。\n会使乌鸢饱，空令豺虎伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晁无咎张文潜见过","author":"陈师道","text":"白社双林去，高轩二妙来。\n排门冲鸟雀，挥壁带尘埃。\n不惮除堂费，深愁载酒回。\n功名付公等，归路在蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桓山","author":"陈师道","text":"平江如抱贯秦洪，双岭驰来欲并雄。\n是物皆为万世计，阖棺犹有一朝穷。\n林峦特起终为污，美恶千年竟不空。\n尚有风流羊叔子，稍经湔洗与清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"藻侄比课五言诗已有意趣老怀甚喜因吟病中十二首示之可率昆季赓和胜终日饱閒也 其三","author":"范成大","text":"日煖衣犹袭，宵长被有棱。\n朝晡三楪饭，昏晓一釭灯。\n伴坐跧如几，扶行瘦比藤。\n生缘堪入画，寂寞憩松僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏古十六首 其三","author":"华镇","text":"黄河天上来，一曲一千里。\n冯夷值海若，反顾忘秋水。\n通川不足多，支流宁复纪。\n大朴久已丧，群言乱如麻。\n儒墨及刑名，交流自名家。\n曲士殉所察，纷纷摘其华。\n伯阳究宗本，为言天地初。\n蟪蛄惊春秋，格言落玄虚。\n华颠困章句，强识家人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起","author":"陈师道","text":"今日秋风里，何乡一病翁。\n力微须杖起，心在与谁同。\n灾疾资千悟，冤亲并一空。\n百年先得老，三败未为穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离颍","author":"陈师道","text":"河市千人聚，寒江百丈牵。\n吾生能几日，此地费三年。\n丛竹防供爨，池鱼已割鲜。\n拙勤终不补，他日愧无传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘寓居","author":"陈师道","text":"山水如相识，豪华异昔闻。\n声言随地改，吴越到江分。\n门闭萧萧雨，风催缓缓云。\n会随麋鹿去，长谢犬羊群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿合清口","author":"陈师道","text":"风叶初疑雨，晴窗误作明。\n穿林出去鸟，举棹有来声。\n深渚鱼犹得，寒沙雁自惊。\n卧家还就道，自计岂苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿齐河","author":"陈师道","text":"烛暗人初寂，寒生夜向深。\n潜鱼聚沙窟，坠鸟滑霜林。\n稍作他方计，初回万里心。\n还家只有梦，更著晓寒侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿泊口","author":"陈师道","text":"弱柳经寒色，悬流尽夜声。\n更长疑睡少，霜落怯寒生。\n急急占星度，摇摇苦舫倾。\n风涛兼盗贼，恩重觉身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿柴城","author":"陈师道","text":"卧埋尘叶走风烟，齿豁头童不记年。\n起倒不供聊应俗，高低莫可只随缘。\n鼕鼕远鼓三行夜，隐隐平湖四接天。\n枕底涛波蓬上雨，故将羁老到愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿深明阁二首 其二","author":"陈师道","text":"缥缈金华伯，人间第一人。\n剧谈连昼夜，应俗费精神。\n时要平安报，反愁消息真。\n墙根霜下草，又作一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿深明阁二首 其一","author":"陈师道","text":"窈窕深明阁，晴寒是去年。\n老将灾疾至，人与岁时迁。\n默坐元如在，孤灯共不眠。\n暮年身万里，赖有故人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄子开","author":"陈师道","text":"道山清绝况真仙，杜曲风流最近天。\n曹濮于今真乐国，股肱从昔著时贤。\n今回不辨终朝语，此去无端久疾痊。\n可念卧时遭末劫，新陈埋没不知年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄子开","author":"陈师道","text":"致君意气日方中，许国精诚月贯虹。\n一代英豪出门第，当时毁誉岂穷通。\n风流身致羲黄上，日夜心随汴洛东。\n从使少年轻我辈，只留颜面对吾公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄文潜无咎少游三学士","author":"陈师道","text":"北来消息不真传，南度相忘更记年。\n湖海一舟须此老，蓬瀛方丈自飞仙。\n数临黄卷聊遮眼，稳上青云小著鞭。\n李杜齐名吾岂敢，晚风无树不鸣蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄无斁","author":"陈师道","text":"敬问晁夫子，官池几许深。\n已应飞鸟下，复作卧龙吟。\n待我中痾愈，同君把臂临。\n泥涂无去马，夏木有来禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄外舅郭大夫二首 其一","author":"陈师道","text":"巴蜀通归使，妻孥且旧居。\n深知报消息，不忍问何如。\n身健何妨远，情亲未肯疏。\n功名欺老病，泪尽数行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄君玉","author":"陈师道","text":"不见紫霄翁，侵寻鬓已蓬。\n倦游乡域异，归梦夙宵同。\n爱酒贫应甚，吟诗老更工。\n清时公道在，未足叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张大夫","author":"陈师道","text":"只应青眼老，尚记白头翁。\n一别今何向，三年信不通。\n不应书字倦，未有北来鸿。\n肯作彭城守，何时马首东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张文潜舍人","author":"陈师道","text":"今代张平子，雄深次子长。\n名高三俊上，官立右螭旁。\n车笠吾何恨，飞腾子莫量。\n时平身早达，未用梦凝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张学士","author":"陈师道","text":"湖海三年别，谯徐一日间。\n经时犹未见，凡事信多艰。\n理极那须说，情生不自还。\n从来阙声问，相见若为颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张宣州","author":"陈师道","text":"与世情将尽，怀仁老未忘。\n故人今五马，高处谩三长。\n诗岂江山助，名成沈鲍行。\n肯为文俗事，打鸭起鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李学士","author":"陈师道","text":"眼看游旧半东都，五岁曾无一纸书。\n平日齐名多早达，暮年同国未情疏。\n稍寻东刹论兹事，赖有西方托后车。\n说与杜郎须著便，不应濠上始知鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杜择之","author":"陈师道","text":"诗家两杜昔无邻，文采传家世有人。\n疾置送诗惊老丑，坐曹得句自清新。\n兴来不假江山助，目过浑如草木春。\n农马智专吾不让，衡阳纸贵子能频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄沛县姜承议","author":"陈师道","text":"平生鲁国老先生，晚见诸郎识老成。\n怪有武功蒙宠锡，果缘阴德贯神明。\n金池已作归田计，玉版方书济物情。\n百里饥寒独颜阖，忍令一物不敷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兖州张龙图文潜二首 其二","author":"陈师道","text":"剩喜开三面，旋闻乞一州。\n力难随鸟翼，行复立螭头。\n今日骐驎阁，当年鹦鹉洲。\n寄书愁不达，书达得无愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兖州张龙图文潜二首 其一","author":"陈师道","text":"去国遭前政，还家未白头。\n百年当晚遇，一辱独先收。\n齿脱空馀舌，颜衰早著秋。\n三为郡文学，大胜邓元侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄单州吕侍讲","author":"陈师道","text":"往时三吕共脩途，拟上青云近玉除。\n中道勒回奔电足，今年还直迩英庐。\n纵谈尚记华严夜，枉道难随刺史车。\n遣兴宽为七字语，寻人聊代一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄单州张朝请","author":"陈师道","text":"平生天上张公子，尚记门间半面人。\n声烈与风来不尽，音书无使去难频。\n一言悟主心犹壮，百巧成穷发自新。\n闻说监河收贷粟，定倾东海活穷鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送定州苏尚书","author":"陈师道","text":"初闻简策侍前旒，又见衣冠送作州。\n北府时清惟可饮，西山气爽更宜秋。\n功名不朽聊通袖，海道无违具一舟。\n枉读平生三万卷，貂蝉当复自兜牟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄亳州何郎中二首 其二","author":"陈师道","text":"西原追送未成旬，赫赫传声已迫人。\n剩欲抄诗寄来使，尚能拂席致佳宾。\n孰知简易归刘向，谁使循良作寇恂。\n他日入东专一壑，少留馀地许为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄亳州何郎中二首 其一","author":"陈师道","text":"西南日下共浮云，人事难群喜劝分。\n已度城阴先得句，不应从俗未忘荤。\n松篁有节元宜晚，桃李无蹊只自薰。\n欲入帝城须帝力，且寻诗社著诗勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄亳州林待制","author":"陈师道","text":"湖海相望阙寄声，云林过雨未全晴。\n青衫作吏非前日，白首论文笑后生。\n似听儿童迎五马，稍修书札问专城。\n一闻苦李蒙庄句，不复人间世后名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐吉父学士","author":"陈师道","text":"卧龙山上摘黄花，曾共西风醉帽斜。\n当日已应天下乐，无人传入画图誇。\n低头强笑今何似，多病难堪懒自嗟。\n闻道承明方厌直，几时来伴访山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄晁无斁","author":"陈师道","text":"稍听春鸟语丁宁，又见官池出断冰。\n雪后踏青谁与共，花边著语老犹能。\n笑谈莫倦寻常听，山院终同一再登。\n今日已知他日恨，抢榆况得及飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄晁说之","author":"陈师道","text":"阅世真难记，如君自不忘。\n尚于书太简，正以懒相妨。\n与有还家乐，终无却老方。\n莫须忧潦倒，未许细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄泰州曾侍郎","author":"陈师道","text":"八年门第故违离，千里河山费梦思。\n淮海风涛真有道，麒麟图画岂无时。\n今朝有客传河尹，是处逢人说项斯。\n三径未成心已具，世间惟有白鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄寇十一","author":"陈师道","text":"邻里相望信不通，时因得句寄匆匆。\n画楼著燕薰风里，杨柳藏鸦白下东。\n度日守窗令节换，经旬无使觉门空。\n锦囊佳丽邻徐庾，剩欲同君赋恼公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄寇元弼","author":"陈师道","text":"朱樱青子已尝新，白帢黄衫见未频。\n载酒对棋无俗士，闭门高枕有闲人。\n有底百年须薄禄，相看一笑却关身。\n肯留恶客开家酿，惊坐何人更姓陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄寇荆山","author":"陈师道","text":"旷士三年别，荆山一顾中。\n百千人欲死，四六老能工。\n脱帽头应白，求田意欲东。\n口须论世事，目已失飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曹州晁大夫","author":"陈师道","text":"东方千骑贵当年，白发居头也自贤。\n肯费精神修客主，稍回功誉入章篇。\n虚名不救空肠厄，晚岁仍遭末疾缠。\n死去不为天下惜，镜中当有故人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄提刑李学士","author":"陈师道","text":"石渠金马青云上，东里西门济水边。\n上冢过家真乐事，平时持节贵当年。\n成家旧学诸儒问，脱手新诗众口传。\n范叔一寒今若此，相逢犹得故人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄曾公权","author":"陈师道","text":"超世功名子有凭，过人才艺我何曾。\n诗书废忘难支敌，门馆光华怯再登。\n捐弃妻儿逃世累，扫除须发伴禅僧。\n待君持节东南日，试问当年杜伯升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄答李方叔","author":"陈师道","text":"平生经世策，寄食不资身。\n孰使文章著，能辞辙迹频。\n帝城分不入，书札诇何人。\n子未知吾懒，吾宁觉子贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄答泰州曾侍郎","author":"陈师道","text":"千里驰诗慰别离，诗来吟咏转悲思。\n静中取适庸非计，林下相从会有时。\n生理只今那得说，交情从昔见于斯。\n含毫欲下还休去，怀抱何由得细知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄答颜长道 其一","author":"陈师道","text":"薄命犹多难，浮生未定居。\n故人忧已矣，千里问何如。\n白发羞明镜，青灯怯细书。\n不曾知史馆，何用索枯鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄酬咸平朱宣德","author":"陈师道","text":"冥冥超世网，蔚蔚秀儒林。\n他日熟看面，今诗初得心。\n白头无故意，异代有同音。\n绠短徒施巧，终然莫汲深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潭州张芸叟二首 其二","author":"陈师道","text":"去国如前日，为邦得旧游。\n霜甘先落手，春雁几回头。\n只道风沙恶，宁知贾宋留。\n赋诗真有助，吊古不同忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潭州张芸叟二首 其一","author":"陈师道","text":"湖岭一都会，西南更上游。\n秋盘堆鸭脚，春味荐猫头。\n宣室来何暮，蒸池得借留。\n孰知为郡乐，莫作越乡忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题披云楼","author":"陈师道","text":"使君高会答清秋，增饰披云作胜游。\n九日再逢堪一笑，终朝百过更深忧。\n落霞孤鹜知才尽，疏雨微云怯语遒。\n宾主纵贤终少在，只今未可压黄楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄襄州程大夫","author":"陈师道","text":"中年为吏晚专城，不独身荣府亦荣。\n江汉风流见羊杜，相门经术有韦平。\n十年一别音书绝，万里相看骨肉情。\n今代庞公入城府，定将悬榻与逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚出","author":"陈师道","text":"应俗敢辞疾，冲风宁小驱。\n聊为一日役，不惮百金躯。\n雪路无行迹，冰枝有落乌。\n寒门闭萧瑟，穷里听嚱吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚立","author":"陈师道","text":"绕舍苔衣积，倚墙梨颊红。\n地平宜落日，野旷自多风。\n禹迹千年后，家山一顾中。\n未休嗤土偶，已复逐飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚坐","author":"陈师道","text":"柳弱留春色，梅寒让雪花。\n溪明数积石，月过恋平沙。\n病减还憎药，年侵却累家。\n后归栖未定，不但只昏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚泊","author":"陈师道","text":"清切临风笛，深明隔水灯。\n堆场穿鸟雀，暗溜入沟塍。\n年使扶行老，船催趁渡僧。\n兹游恐未已，著句续先曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]