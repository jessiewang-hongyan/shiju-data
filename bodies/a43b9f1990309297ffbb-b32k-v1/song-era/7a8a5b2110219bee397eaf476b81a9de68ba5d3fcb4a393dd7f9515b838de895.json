[{"title":"浪淘沙令 其二 赋虞美人草","author":"辛弃疾","text":"不肯过江东。\n玉帐匆匆。\n至今草木忆英雄。\n唱著虞兮当日曲，便舞春风。\n儿女此情同。\n往事朦胧。\n湘娥竹上泪痕浓。\n舜盖重瞳堪痛恨，羽又重瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其一","author":"辛弃疾","text":"掷地刘郎玉斗，挂帆西子扁舟。\n千古风流今在此，万里功名莫放休。\n君王三百州。\n燕雀岂知鸿鹄，貂蝉元出兜鍪。\n却笑泸溪如斗大，肯把牛刀试手不。\n寿君双玉瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其一 赠行","author":"辛弃疾","text":"少日春风满眼，而今秋叶辞柯。\n便好消磨心下事，莫忆寻常醉后歌。\n可怜白发多。\n明日扶头颠倒，倩谁伴舞婆娑。\n我定思君拼瘦损，君不思兮可奈何。\n天寒将息呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 赵晋臣敷文幼女县主觅词","author":"辛弃疾","text":"菩萨丛中惠眼，硕人诗里娥眉。\n天上人间真福相，画就描成好靥儿。\n行时娇更迟。\n劝酒偏他最劣，笑时犹有些痴。\n更著十年君看取，两国夫人更是谁。\n殷勤秋水词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其二 硖石道中有怀子似","author":"辛弃疾","text":"宿麦畦中雉鷕，柔桑陌上蚕生。\n骑火须防花月暗，玉唾长携彩笔行。\n隔墙人笑声。\n莫说弓刀事业，依然诗酒功名。\n千载图中今古事，万石溪头长短亭。\n小塘风浪平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破阵子 其二 为陈同甫赋壮语以寄","author":"辛弃疾","text":"醉里挑灯看剑，梦回吹角连营。\n八百里分麾下炙，五十弦翻塞外声。\n沙场秋点兵。\n马作的卢飞快，弓如霹雳弦惊。\n了却君王天下事，赢得生前身后名。\n可怜白发生！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"粉蝶儿    和晋臣赋落花","author":"辛弃疾","text":"昨日春如十三女儿学绣，一枝枝、不教花瘦。\n甚无情，便下得、雨僝风僽。\n向园林、铺作地衣红绉。\n而今春似轻薄荡子难久。\n记前时、送春归后。\n把春波都酿作、一江醇酎。\n约清愁、杨柳岸边相候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酒泉子 无题","author":"辛弃疾","text":"流水无情，潮到空城头尽白，离歌一曲怨残阳。\n断人肠。\n东风官柳舞雕墙。\n三十六宫花溅泪，春声何处说兴亡。\n燕双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 纪壁间题","author":"辛弃疾","text":"盈盈泪眼。\n往日青楼天样远。\n秋月春花。\n输与寻常姊妹家。\n水村山驿。\n日暮行云无气力。\n锦字偷裁。\n立尽西风雁不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一 宿僧房有作","author":"辛弃疾","text":"僧窗夜雨。\n茶鼎熏炉宜小住。\n却恨春风。\n勾引诗来恼杀翁。\n狂歌未可。\n且把一尊料理我。\n我到亡何。\n却听侬家陌上歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"辛弃疾","text":"昨朝官告。\n一百五年村父老。\n更莫惊疑。\n刚道人生七十稀。\n使君喜见。\n恰限华堂开寿宴。\n问寿如何。\n百代儿孙拥太婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆罗门引 其三 晋臣张灯甚盛，索赋。偶忆旧游，未章因及之","author":"辛弃疾","text":"落星万点，一天宝焰下层霄。\n人间叠作仙鳌。\n最爱金莲侧畔，红粉袅花梢。\n更鸣鼍击鼓，喷玉吹箫。\n曲江画桥。\n记花月、可怜宵。\n想见闲愁未了，宿酒才消。\n东风摇荡，似杨柳、十五女儿腰。\n人共柳、那个无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆罗门引 用韵答傅先之","author":"辛弃疾","text":"龙泉佳处，种花满县却东归。\n腰间玉若金累。\n须信功名富贵，长与少年期。\n怅高山流水，古调今悲。\n卧龙暂而。\n算天上、有人知。\n最好五十学易，三百篇诗。\n男儿事业，看一日、须有致君时。\n端的了、休更寻思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆罗门引 其二 用韵别郭逢道","author":"辛弃疾","text":"绿阴啼鸟，阳关未彻早催归。\n歌珠凄断累累。\n回首海山何处，千里共襟期。\n叹高山流水，弦断堪悲。\n中心怅而。\n似风雨、落花知。\n更拟停云君去，细□陶诗。\n见君何日，待琼林、宴罢醉归时。\n人争看、宝马来思。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆罗门引 用韵答赵晋臣敷文","author":"辛弃疾","text":"不堪鶗鴂，早教百草放春归。\n江头愁杀吾累。\n却觉君侯雅句，千载共心期。\n便留春甚乐，乐了须悲。\n琼而素而。\n被花恼、只莺知。\n正要千钟角酒，五字裁诗。\n江东日暮，道绣斧、人去未多时。\n还又要、玉殿论思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜分飞 春思","author":"辛弃疾","text":"翡翠楼前芳草路。\n宝马坠鞭曾驻。\n最是周郎顾。\n尊前几度歌声误。\n望断碧云空日暮。\n流水桃源何处。\n闻道春归去。\n更无人管飘红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜奴娇 戏同官","author":"辛弃疾","text":"风骨萧然，称独立、群仙首。\n春江雪、一枝梅秀。\n小样香檀，映朗玉、纤纤手。\n未久。\n转新声、泠泠山溜。\n曲里传情，更浓似、尊中酒。\n信倾盖、相逢如旧。\n别后相思，记敏政堂前柳。\n知否。\n又拼了、一场消瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"添字浣溪沙 其二 三山戏作","author":"辛弃疾","text":"记得瓢泉快活时。\n长年耽酒更吟诗。\n蓦地捉将来断送，老头皮。\n绕屋人扶行不得，闲窗学得鹧鸪啼。\n却有杜鹃能劝道，不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"添字浣溪沙/山花子 其四 用前韵谢传岩叟馈名花鲜蕈","author":"辛弃疾","text":"杨柳温柔是故乡。\n纷纷蜂蝶去年场。\n大率一春风雨事，最难量。\n满把携来红粉面，堆盘更觉紫芝香。\n幸自曲生闲去了，又教忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"添字浣溪沙/山花子 其一 用前韵谢傅岩叟瑞香之惠","author":"辛弃疾","text":"句里明珠字字排。\n多情应也被春催。\n怪得名花和泪送，雨中栽。\n赤脚未安芳斛稳，娥眉早把橘枝来。\n报道锦薰笼底下，麝脐开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"添字浣溪沙/山花子 其三","author":"辛弃疾","text":"日日闲看燕子飞。\n旧巢新垒画帘低。\n玉历今朝推戊己，住衔泥。\n先自春光留不住，那堪更著子规啼。\n一阵晚香吹不断，落花溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 博山道中即事","author":"辛弃疾","text":"柳边飞鞚。\n露湿征衣重。\n宿鹭惊窥沙影动。\n应有鱼虾入梦。\n一川淡月疏星。\n浣沙人影娉婷。\n笑背行人归去，门前稚子啼声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"辛弃疾","text":"东园向晓。\n阵阵西风好。\n唤起仙人金小小。\n翠羽玲珑装了。\n一枝枕畔开时。\n罗帏翠幕低垂。\n恁地十分遮护，打窗早有蜂儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 呈昌父，时仆以病止酒，昌父日作诗数遍，末章及之","author":"辛弃疾","text":"云烟草树。\n山北山南雨。\n溪上行人相背去。\n惟有啼鸦一处。\n门前万斛春寒。\n梅花可㬠摧残。\n使我长忘酒易，要君不作诗难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 书王德由主簿扇","author":"辛弃疾","text":"溪回沙浅。\n红杏都开遍。\n鸂鶒不知春水暖。\n犹傍垂杨春岸。\n片帆千里轻船。\n行人想见敧眠。\n谁似先生高举，一行白鹭青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其五 检校山园书所见","author":"辛弃疾","text":"连云松竹，万事从今足。\n拄杖东家分社肉，白酒床头初熟。\n西风梨枣山园，儿童偷把长竿。\n莫遣旁人惊去，老夫静处闲看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 寿赵民则提刑，时新除，且素不喜饮","author":"辛弃疾","text":"诗书万卷。\n合上明光殿。\n案上文书看未遍。\n眉里阴功早见。\n十分竹瘦松坚。\n看君自是长年。\n若解尊前痛饮，精神便是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三","author":"辛弃疾","text":"春宵睡重。\n梦里还相送。\n枕畔起寻双玉凤。\n半日才知是梦。\n一从卖翠人还。\n又无音信经年。\n却把泪来做水，流也流到伊边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 为儿铁柱作","author":"辛弃疾","text":"灵皇醮罢。\n福禄都来也。\n试引鹓雏花树下。\n断了惊惊怕怕。\n从今日日聪明。\n更宜潭妹嵩兄。\n看取辛家铁柱，无灾无难公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三 赋木犀词","author":"辛弃疾","text":"月明秋晓。\n翠盖团团好。\n碎剪黄金教恁小。\n都著叶儿遮了。\n折来休似年时。\n小窗能有高低。\n无顿许多香处，只消三两枝儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三 检校山园书所见","author":"辛弃疾","text":"断崖修竹。\n竹里藏冰玉。\n路绕清溪三百曲。\n香满黄昏雪屋。\n行人系马疏篱。\n折残犹有高枝。\n留得东风数点，只缘娇懒春迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其四 独宿博山王氏庵","author":"辛弃疾","text":"绕床饥鼠，蝙蝠翻灯舞。\n屋上松风吹急雨，破纸窗间自语。\n平生塞北江南，归来华发苍颜。\n布被秋宵梦觉，眼前万里江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一","author":"辛弃疾","text":"清词索笑。\n莫厌银杯小。\n应是天孙新与巧。\n剪恨裁愁句好。\n有人梦断关河。\n小窗日饮亡何。\n想见重帘不卷，泪痕滴尽湘娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其三 题上卢桥","author":"辛弃疾","text":"清溪奔快。\n不管青山碍。\n千里盘盘平世界。\n更著溪山襟带。\n古今陵谷茫茫。\n市朝往往耕桑。\n此地居然形胜，似曾小小兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 寿道夫","author":"辛弃疾","text":"此身长健。\n还却功名愿。\n枉读平生三万卷。\n满酌金杯听劝。\n男儿玉带金鱼。\n能消几许诗书。\n料得今宵醉也，两行红袖争扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 忆吴江赏木樨","author":"辛弃疾","text":"少年痛饮。\n忆向吴江醒。\n明月团圆高树影。\n十里蔷薇水冷。\n大都一点宫黄。\n人间直恁芳芬。\n怕是九天风露，染教世界都香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 村居","author":"辛弃疾","text":"茅檐低小，溪上青青草。\n醉里吴音相媚好，白发谁家翁媪。\n大儿锄豆溪东，中儿正织鸡笼，最喜小儿无赖，溪头卧剥莲蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"辛弃疾","text":"道德文章传几世。\n到君合上三台位。\n自是君家门户事。\n当此际。\n龟山正抱西江水。\n三万六千排日醉。\n鬓毛只恁青青地。\n江里石头争献瑞。\n分明是。\n中间有个长生字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 湖州幕官作舫室","author":"辛弃疾","text":"风月小斋模画舫。\n绿窗朱户江湖样。\n酒是短桡歌是桨。\n和情放。\n醉乡稳到无风浪。\n自有拍浮千斛酿。\n从教日日蒲桃涨。\n门外独醒人也访。\n同俯仰。\n赏心却在鸱夷上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 妓","author":"辛弃疾","text":"烟花丛里不宜他。\n绝似好人家。\n淡妆娇面，轻注朱唇，一朵梅花。\n相逢比著年时节，顾意又争些。\n来朝去也，莫因别个，忘了人咱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿头鸭/多丽 七夕","author":"辛弃疾","text":"叹飘零。\n离多会少堪惊。\n又争如、天人有信，不同浮世难凭。\n占秋初、桂花散采，向夜久、银汉无声。\n凤驾催云，红帷卷月，泠泠一水会双星。\n素杼冷，临风休织，深诉隔年诚。\n飞光浅，青童语款，丹鹊桥平。\n看人间、争求新巧，纷纷女伴欢迎。\n避灯时、彩丝未整，拜月处、蛛网先成。\n谁念监州，萧条官舍，烛摇秋扇坐中庭。\n笑此夕、金钗无据，遗恨满蓬瀛。\n欹高枕，梧桐听雨，如是天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五 坐中赋樱桃","author":"辛弃疾","text":"香浮乳酪玻璃碗。\n年年醉里尝新惯。\n何物比春风。\n歌唇一点红。\n江湖清梦断。\n翠笼明光殿。\n万颗写轻匀。\n低头愧野人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六 雪楼赏牡丹席上用杨民瞻韵","author":"辛弃疾","text":"红牙签上群仙格。\n翠罗盖底倾城色。\n和雨泪阑干。\n沈香亭北看。\n东风休放去。\n怕有流莺诉。\n试问赏花人。\n晓妆匀未匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"辛弃疾","text":"功名饱听儿童说。\n看公两眼明如月。\n万里勒燕然。\n老人书一编。\n玉阶方寸地。\n好趁风云会。\n他日赤松游。\n依然万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五 送曹君之庄所","author":"辛弃疾","text":"人间岁月堂堂去。\n劝君快上青云路。\n圣处一灯传。\n工夫萤雪边。\n曲生风味恶。\n辜负西窗约。\n沙岸片帆开。\n寄书无雁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三 双韵赋摘阮","author":"辛弃疾","text":"阮琴斜挂香罗绶。\n玉纤初试琵琶手。\n桐叶雨声乾。\n真珠落玉盘。\n朱弦调未惯。\n笑倩春风伴。\n莫作别离声。\n且听双凤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 和夏中玉","author":"辛弃疾","text":"与君欲赴西楼约。\n西楼风急征衫薄。\n且莫上兰舟。\n怕人清泪流。\n临风横玉管。\n声散江天满。\n一夜旅中愁。\n蛩吟不忍休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四 晋臣张菩提叶灯，席上赋","author":"辛弃疾","text":"看灯元是菩提叶。\n依然会说菩提法。\n法似一灯明。\n须叟千万灯。\n灯边花更满。\n谁把空花散。\n说与病维摩。\n而今天女歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六 昼眠秋水","author":"辛弃疾","text":"葛巾自向沧浪濯。\n朝来漉酒那堪著。\n高树莫鸣蝉。\n晚凉秋水眠。\n竹床能几尺。\n上有华胥国。\n山上咽飞泉。\n梦中琴断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"辛弃疾","text":"西风都是行人恨。\n马头渐喜归期近。\n试上小红楼。\n飞鸿字字愁。\n阑干闲倚处。\n一带山无数。\n不似远山横。\n秋波相共明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 赠周国辅侍人","author":"辛弃疾","text":"画楼影蘸清溪水。\n歌声响彻行云里。\n帘幕燕双双。\n绿杨低映窗。\n曲中特地误。\n要试周郎顾。\n醉里客魂消。\n春风大小乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"辛弃疾","text":"江摇病眼昏如雾。\n送愁直到津头路。\n归念乐天诗。\n人生足别离。\n云屏深夜语。\n梦到君知否。\n玉箸莫偷垂。\n断肠天不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"辛弃疾","text":"淡黄弓样鞋儿小。\n腰肢只怕风吹倒。\n蓦地管弦催。\n一团红雪飞。\n曲终娇欲诉。\n定忆梨园谱。\n指日按新声。\n主人朝玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三 赠张医道服为别，且令馈河豚","author":"辛弃疾","text":"万金不换囊中术。\n上医元自能医国。\n软语到更阑。\n绨袍范叔寒。\n江头杨柳路。\n马踏春风去。\n快趁两三杯。\n河豚欲上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五 题云岩","author":"辛弃疾","text":"游人占却岩中屋。\n白云只向檐头宿。\n谁解探玲珑。\n青山十里空。\n松篁通一径。\n噤嘇山花冷。\n今古几千年。\n西乡小有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其七 重到云岩戏徐斯远","author":"辛弃疾","text":"君家玉雪花如屋。\n未应山下成三宿。\n啼鸟几曾催。\n西风犹未来。\n山房连石径。\n云卧衣裳冷。\n倩得李延年。\n清歌送上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"辛弃疾","text":"稼轩日向儿童说。\n带湖买得新风月。\n头白早归来。\n种花花已开。\n功名浑是错。\n更莫思量着。\n见说小楼东。\n好山千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"辛弃疾","text":"旌旗依旧长亭路。\n尊前试点莺花数。\n何处捧心颦。\n人间别样春。\n功名君自许。\n少日闻鸡舞。\n诗句到梅花。\n春风十万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 乙巳冬前间举似前作，因和之","author":"辛弃疾","text":"锦书谁寄相思语。\n天边数遍飞鸿数。\n一夜梦千回。\n梅花入梦来。\n涨痕纷树发。\n霜落沙洲白。\n心事莫惊鸥。\n人间千万愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四 送郑守厚卿赴阙","author":"辛弃疾","text":"送君直上金銮殿。\n情知不久须相见。\n一日甚三秋。\n愁来不自由。\n九重天一笑。\n定是留中了。\n白发少经过。\n此时愁奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三 送祐之弟归浮梁","author":"辛弃疾","text":"无情最是江头柳。\n长条折尽还依旧。\n木叶下平湖。\n雁来书有无。\n雁无书尚可。\n妙语凭谁和。\n风雨断肠时。\n小山生桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 书江西造口壁","author":"辛弃疾","text":"郁孤台下清江水，中间多少行人泪。\n西北望长安，可怜无数山。\n青山遮不住，毕竟东流去。\n江晚正愁予，山深闻鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]