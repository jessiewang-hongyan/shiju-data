[{"title":"蝶恋花 情景","author":"宋祁","text":"绣幕茫茫罗帐卷。\n春睡腾腾，困入娇波慢。\n隐隐枕痕留玉脸。\n腻云斜溜钗头燕。\n远梦无端欢又散。\n泪落胭脂，界破蜂黄浅。\n整了翠鬟匀了面。\n芳心一寸情何限。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"宋祁","text":"雨过蒲萄新涨绿。\n苍玉盘倾，堕碎珠千斛。\n姬监拥前红簇簇。\n温泉初试真妃浴。\n驿使南来丹荔熟。\n故剪轻绡，一色颁时服。\n娇汗易晞凝醉玉。\n清凉不用香绵扑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"宋祁","text":"画毂雕鞍狭路逢。\n一声肠断绣帘中。\n身无彩凤双飞翼，心有灵犀一点通。\n金作屋，玉为笼。\n车如流水马游龙。\n刘郎已恨蓬山远，更隔蓬山几万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"宋祁","text":"金衣瑞羽迎风展，琮栗仙杯压雾斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"宋祁","text":"归从鹤翘六六间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"宋祁","text":"北雁为南客，衔之以避缴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十二","author":"宋祁","text":"珠帘约住牡丹风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"宋祁","text":"云路旧扶黄道日，霞觞新映六符天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"宋祁","text":"谢病归装能办未，葛洪丹灶景山铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"宋祁","text":"晓日侵帘押，春寒到被池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十一","author":"宋祁","text":"既多九穗谷，复有三秀芝。\n芝以保万寿，谷以庆东菑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"宋祁","text":"无色真国色，有韵自天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"宋祁","text":"色映堋云烂，声迎羽月迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十","author":"宋祁","text":"细栽烟外叶，繁并暖前枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"宋祁","text":"至公三籍在储胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读僧长吉诗","author":"胡宿","text":"生民类能言，兹文特渊邈。\n精韫在希微，幽通资写托。\n状物无遁形，舒情有至乐。\n自非妙解机，谁抽神奥籥。\n大士栖绿岩，门前即台岳。\n翠屏何峨峨，千仞拂寥廓。\n芝朮被诸峰，烟霞兴众壑。\n中安仁智居，旁研华竺学。\n观法识非空，了心无少著。\n人境既相于，神明信超若。\n作诗三百篇，平淡犹古乐。\n于言虽未忘，在理已能觉。\n天质自然美，亦如和氏璞。\n贮之古锦囊，访我杼山郭。\n杼山空崔嵬，然公久寂寞。\n中间三百年，寂寞无人作。\n何意正始音，绪馀在清角。\n山旁夏欲休，林英春稍落。\n吟登苍卞馀，归梦华顶数。\n驾言整巾瓶，仍前侣猿鹤。\n谁言云无心，还依故山泊。\n顾予禽鹿姿，缪此縻人爵。\n居常眩韶音，几骇顿金络。\n比将亲椒兰，端欲甘藜藿。\n缅怀净名庵，终寻香火约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"宋祁","text":"可但鱼知丙，非徒字识丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"宋祁","text":"碧云谩有三年信，明月空为两地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"宋祁","text":"再来戴公宅，客过孝王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"宋祁","text":"磨沙漉水莩谷滑，砍柱煮釜风波声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"宋祁","text":"要待花馀见秋实，缥肌细肉荐盘珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"宋祁","text":"雪中林卉皆相似，认得清香寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"宋祁","text":"都缘赋色浅，燧不趁春繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"宋祁","text":"药有不龟方，击絮管无妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"宋自适","text":"西郊云起白漫漫，近树遥峰欲辨难。\n山下几多迷路者，人间方梦大槐安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳","author":"朱端常","text":"丝丝烟雨弄轻柔，偏称黄鹂与白鸥。\n才著一蝉嘶晚日，西风容易便成秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谦父弟","author":"宋自适","text":"日用功夫在细微，行逢碍处便须疑。\n高言怕被空虚笑，阔步先防堕落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠医齿道人","author":"宋自适","text":"病欺年去故相加，要害先攻两辅车。\n解后神工如掇拾，愧无樽酒对榴花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠画士陈兄","author":"宋自适","text":"解衣盘礴任猜疑，神悟如狂又似痴。\n学到却须坚自守，世间绝艺少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏猿","author":"宋自适","text":"生长楩楠紫翠间，攀翻接手饮潺湲。\n卧惊落叶霜华重，叫彻山空月影闲。\n蹭蹬失身拘竹栅，飘萧飞梦绕松关。\n平生捷巧何由逞，缩臂无言看远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢馈药","author":"宋自适","text":"投老如僧不出家，羸躯无奈病相加。\n头旋似倚当风柳，目眩如看隔雾花。\n高束诗书参素问，尽抛琴剑学丹砂。\n旧时载酒今怀药，解识扬雄独有巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠胡季昭","author":"宋自适","text":"凛凛庐陵一澹翁，飞扬复起振高风。\n周无二叔圣何别，商有三仁道则同。\n孤迹本如云出岫，清名应比日行空。\n翩翩雁影梅花外，雪片飞来酒对中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"宋自适","text":"老去放令心胆健，后来留得姓名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"宋自适","text":"江湖多少盟鸥地，莫近平津阁畔行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"宋自适","text":"阴阳消长风闻际，堂陛尊严山立时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"宋自适","text":"三圣传心惟主一，六经载道不言真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书报先生壁","author":"宋自逊","text":"一盏清灯到夜深，掩书趺坐学禅心。\n山猿白日无踪迹，夜夜来啼松树林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月菊","author":"宋自逊","text":"东篱千古属重阳，此本偏宜夏日长。\n会得渊明高卧意，故来同占北窗凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买马","author":"宋自逊","text":"世求骏马事驱驰，我买人间钝马骑。\n不是爱他行路稳，好山多处要寻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾子实题画笺韵","author":"宋自逊","text":"鹭引归船犬吠篱，片时风景万千诗。\n向来柳下曾沽酒，不似如今看画时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雪","author":"宋自逊","text":"雪眼羞明夜转飞，梅花未觉竹先知。\n一炉柴火三杯酒，谁记山阴有戴逵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"店翁送花","author":"宋自逊","text":"店翁排日送春花，老去情怀感物华。\n翁欲殷勤留客住，客因花恼转思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种柳","author":"宋自逊","text":"短研深煨倒插宜，明年便有绿垂垂。\n只因造化大容易，不见岁寒冰雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚊","author":"宋自逊","text":"朋比趋炎态度轻，禦人口给屡憎人。\n虽然暗里能钻刺，贪不知几竟杀身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萍","author":"宋自逊","text":"苦无根蒂逐波流，风约才稀雨复稠。\n旧说杨花能变此，是他种子亦轻浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一室","author":"宋自逊","text":"一室冷如冰，梅花相对清。\n残年日易晚，夹雪雨难晴。\n身计茧千绪，世纷棋一枰。\n曲生差解事，谈笑破愁城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山家","author":"宋自逊","text":"一片青山水四围，家家有竹护柴扉。\n养成猿鹤通人语，放去牛羊识路归。\n紫蕨甘肥轻鼎味，绿蓑安稳胜朝衣。\n浮云遮断人间事，浪说桃源今世稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿铁石翁","author":"宋自逊","text":"梅传春信伴持觥，寿数新年满六庚。\n长与白云分屋住，閒骑黄犊趁山行。\n不因问药深深隐，除却能诗事事生。\n看到阿咸俱白发，百年门户共支撑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲地","author":"宋自逊","text":"一片宽闲地，半生江海情。\n有梅添月色，无竹欠秋声。\n酒热浑家醉，诚诗逐字评。\n拙疏尘事少，贫贱也身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶磨","author":"宋自逊","text":"韫质他山带玉挥，乾旋坤载妙玄机。\n转时隐隐海风起，落处纷纷春雪飞。\n圆体外通常不碍，贞心中立动无违。\n世间多少槐安梦，信手频推为解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂花","author":"宋自逊","text":"揭纸糊窗莫放开，园丁新送木犀来。\n绕屏著色无非画，尽日烘香不用煤。\n同气相求唯径菊，后生可畏独江梅。\n月中一本应灵异，待向仙娥觅种栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隐逸","author":"宋自逊","text":"五鼎生封事不难，此身当与道相关。\n天高地下日易晚，古往今来人少闲。\n靖节早辞彭泽县，子陵终老富春山。\n当时若为虚名起，未必有名留世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答客问","author":"宋自逊","text":"岂是林逋放鹤迟，习闲成懒静相宜。\n落花时节人中酒，夜雨轩窗客赌棋。\n身外浮名何用觅，人间多事不须知。\n屋边梅树梅边石，岁岁春风日日诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢深道问近况答之","author":"宋自逊","text":"芃芃秋草闭门深，世事年来口欲瘖。\n文欠官衔谁著眼，命无时彩自劳心。\n收书祇愿儿能读，得酒惟须客共斟。\n幸有无弦琴挂壁，不容声处是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠隐者","author":"宋自逊","text":"或居岩谷或居廛，未作天仙且地仙。\n诗只半联人寡和，画才数笔世争传。\n弹琴无谱自成曲，卖药资身不较钱。\n或问先生今几岁，笑言谁解记生年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌鹊引","author":"宋自逊","text":"彼乌鹊兮，无异众禽之鸣。\n吉凶在人兮，彼鸣何心。\n吁嗟人兮，万物之灵。\n不能自信兮，占吉凶于二禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田家谣","author":"宋自逊","text":"清溪绕山流，茅屋瞰溪住。\n山田虽不多，荒年亦禾黍。\n有园不栽花，但种桑与苧。\n有儿只为农，不士不商旅。\n老翁雪满头，煮茗相劳抚。\n问我从何来，今将去何所。\n日月如飞梭，人生几寒暑。\n浮名底须求，求之亦何补。\n我见贪名人，名成隔千古。\n微利不足营，营之徒自苦。\n我见嗜利人，甘作守钱虏。\n青山冢累累，今古一抔土。\n勉我勤归鞯，风雪岁云暮。\n因作田家谣，备述老翁语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看人取木绵","author":"宋自逊","text":"绿杨有花飞作絮，黄芦有花亦为絮。\n此絮天寒不可衣，但解随风乱飞舞。\n木绵蒙茸入机杼，妙胜春蚕茧中缕。\n均为世上一草木，有用无用乃如许。\n木绵有用称者稀，杨花芦花千古传声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲","author":"宋自逊","text":"采花莫掣叶，掣叶伤莲根。\n食子莫弃心，味苦生意存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"啄木吟","author":"宋自逊","text":"志非啄木在啄虫，利觜似染虫血红。\n木外无虫虫在中，外视一啄殊不空。\n人嗟木皮遭齧毁，岂知虫多木心死。\n木心无蠹木乃荣，安得去国之蠹如此觜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"照镜辞","author":"宋自逊","text":"匣中青镜秋月明，妍嗤毫发无遁形。\n人心不同有如面，青铜照面不照心。\n人心本灵本虚静，谁实昏之私欲胜。\n匣取青铜且勿开，自照心中大圆镜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠戴石屏","author":"宋自逊","text":"又是六年别，浑无一字书。\n性宽难得老，交久只如初。\n白发添诗集，黄金散酒垆。\n行程遍江海，何处是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"宋自逊","text":"何敢笑人干禄，自知无分弹冠。\n只将贫贱博清閒。\n留取书遮老眼。\n世上风波任险，门前路径须宽。\n心无妄想梦魂安。\n万事鹤长凫短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼锦堂 上李真州","author":"宋自逊","text":"荷叶龟游，庭皋鹤舞，应是秋满淮涯。\n昨夜将星明处，仿佛峨眉。\n干戈已净银河淡，尘沙不动翠烟微。\n邦人道，半月中秋，当歌不饮何为。\n谁知。\n心事远，但感慨登临，白羽频挥。\n恨不明朝出塞，猎猎旌旗。\n文南一矢澶渊劲，夔门三箭武关奇。\n挑灯看，龙吼传家旧剑，曾斩吴曦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 七夕","author":"宋自逊","text":"灵鹊桥初就。\n记迢迢、重湖风浪，去年时候。\n岁月不留人易老，万事茫茫宇宙。\n但独对、西风搔首。\n巧拙岂关今夕事，奈痴儿、騃女流传谬。\n添话柄，柳州柳。\n道人识破灰心久。\n只好风、凉月佳时，疏狂如旧。\n休笑双星经岁别，人到中年已后。\n云雨梦、可曾常有。\n雪藕调冰花熏茗，正梧桐、雨过新凉透。\n且随分，一杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 题雪堂","author":"宋自逊","text":"唤起东坡老。\n问雪堂、几番兴废，斜阳衰草。\n一月有钱三十块，何苦抽身不早。\n又底用、北门摛藻。\n儋雨蛮烟添老色，和陶诗、翻被渊明恼。\n到底是，忘言好。\n周郎英发人间少。\n谩依然、乌鹊南飞，山高月小。\n岁月堂堂留不住，此世何时是了。\n算不满、英雄一笑。\n我有丰淮千斗酒，把新愁、旧恨都倾倒。\n三弄笛，楚天晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 愁感","author":"宋自逊","text":"举扇西风，又十载、重游秋浦。\n对旧日、江山错愕，鬓丝如许。\n世事兴亡空感慨，男儿事业谁堪数。\n被老天、开眼看人忙，成今古。\n江上路，喧鼙鼓。\n山中地，纷豺虎。\n谩乾坤许大，著身何处。\n名利等成狂梦寐，文章亦是閒言语。\n赖双投、酒熟蟹螯肥，忘羁旅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 自述","author":"宋自逊","text":"壶山居士，未老心先懒。\n爱学道人家，办竹几、蒲团茗碗。\n青山可买，小结屋三间，开一径，俯清溪，修竹栽教满。\n客来便请，随分家常饭。\n若肯小留连，更薄酒、三杯两盏。\n吟诗度曲，风月任招呼，身外事，不关心，自有天公管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"宋自道","text":"山雨初晴，馀寒犹在东风软。\n满庭苔藓。\n青子无人见。\n好客不来，门外芳菲遍。\n难消遣。\n流莺声啭。\n坐看芭蕉展。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"宋齐愈","text":"霏霏疏影转征鸿。\n人语暗香中。\n小桥斜渡，西亭深院，水月朦胧。\n人间不是藏春处，玉笛晓霜空。\n江南树树，黄垂密雨，绿涨薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兀坐","author":"宋伯仁","text":"坐对清清一穗香，悄无人语日偏长。\n砚盘数点梅花片，暗引游蜂度粉墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小舟晚赏荷花","author":"宋伯仁","text":"天浮月影水浮天，路绕山头树绕烟。\n船小小行人意适，藕花新索酒杯传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]