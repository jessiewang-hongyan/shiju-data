[{"title":"赏柳吟","author":"金朋说","text":"舞翠垂丝夹小桥，春风庭院鸟声娇。\n自从靖节萧疏后，复许谁人不折腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋即事","author":"金朋说","text":"池塘高柳噪新蝉，庭馆秋风初入弦。\n抚罢瑶琴金井畔，不堪梧叶落翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"歇后宰相","author":"金朋说","text":"歇后诗人何志诚，自量心迹甚详明。\n世多觊窦穿窬者，对尔宁无愧赧情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"裴垍","author":"金朋说","text":"竭诚佐理奖言司，先正君心帝者师。\n举荐不为盲宰相，尽供乃职日孜孜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴表兄雪鹤山茶图","author":"金朋说","text":"飘然六出舞长空，四顾楼台玉砌中。\n却被两般来点破，鹤呈丹顶树头红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋夜偕朱表侄题月","author":"金朋说","text":"晴空光溢玉盘鲜，银汉斓斑斗柄旋。\n此夕共为攀桂问，姮娥著付与谁先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五季相冯道","author":"金朋说","text":"历代成规知谨守，五朝八姓诰封新。\n改辞易面何无耻，视古夷齐不愧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木槿花","author":"金朋说","text":"夜合朝开秋露新，幽庭雅称画屏清。\n果然蠲得人间忿，何必当年宠太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木樨吟","author":"金朋说","text":"月窟移来种异常，金英玉糁散天香。\n年年八月中秋节，赏尽诗翁酒几缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"止斋吟","author":"金朋说","text":"知止于至善，修身止用诚。\n五伦止此定，明德日新民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐牧吟","author":"金朋说","text":"牛背日高方睡熟，横吹短笛不成腔。\n毛球打罢归来晚，古木寒鸦又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐耕吟","author":"金朋说","text":"黄鹂语后麦初熟，鸿雁来时稻正香。\n但获新仓丰稔足，床头新酿酒盈缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日忆友","author":"金朋说","text":"寥落园林度小春，枝头橙橘摘黄金。\n蟹螯樽俎新礼美，剪烛连宵忆故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正心吟","author":"金朋说","text":"明诚道不离，知格无邪伪。\n中正著吾心，毋为私欲蔽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉党锢","author":"金朋说","text":"坑士焚书已促秦，前途覆辙又因循。\n范滂一命何须惜，可叹颠危汉室倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芍药吟","author":"金朋说","text":"画阑倚玉对偎红，娜袅翻阶放艳秾。\n自笑主人无个事，年年携酒祝东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐家吟","author":"金朋说","text":"齐家先正己，标准自吾身。\n动息从心里，规模卫武箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲花吟","author":"金朋说","text":"夐出涟漪不染泥，浓妆淡抹总相宜。\n六郎莫恃人怜惜，君子名称更绝奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武则天","author":"金朋说","text":"唐代司晨有牝鸡，灭残宗室殆无遗。\n若非仁杰擎天力，李鼎将移属武媚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诚意吟","author":"金朋说","text":"正心谨独时，笃实惟精一。\n克念寸不欺，充然四端立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"修身吟","author":"金朋说","text":"克己工夫熟，磋磨日日新。\n形端仪表正，汤圣自盘铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"持敬斋吟","author":"金朋说","text":"恭己时存养，敬以充四端。\n唯狂能克念，作圣抑何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋山吟","author":"金朋说","text":"浓淡霜林入望中，天工施巧染秋容。\n秋容犹胜春光好，翠叶烧丹绿树红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日书怀","author":"金朋说","text":"夜合花开放晓晴，凉飙新爽小池亭。\n幽人雅称林泉兴，弄月吟风乐更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种豆吟","author":"金朋说","text":"南亩种豆苗，苗稀草犹胜。\n农人费锄耘，凶秽何不净。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种松吟","author":"金朋说","text":"人皆爱桃李，我爱种青松。\n桃李易凋谢，青松却耐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种桃吟","author":"金朋说","text":"分种玄都观，移根出武陵。\n河阳花满县，曾历避狂秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐太宗","author":"金朋说","text":"唐世闺门少谨严，三纲浊乱有由然。\n晋阳挟父私宫妾，巢剌王妃不可言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐宪宗","author":"金朋说","text":"能询天宝乱从生，林甫专权罢九龄。\n刺史权才除柳泌，金丹燥发命随倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日山居","author":"金朋说","text":"时当夏日临，酷暑避无地。\n唯对碧岩山，清凉又安逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泰伯虞仲祠","author":"金朋说","text":"阅墙兄弟不相容，尺布犹怜尚可缝。\n让位介然如弃屣，盛哉至德厚无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠吟","author":"金朋说","text":"艳质妖娜放早春，谁教帝主溺初心。\n椒房一睡才扶起，彻动渔阳鼙鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书吟","author":"金朋说","text":"读书本卫道，何以道欺人。\n古害称杨墨，而今害益深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨鸡吟","author":"金朋说","text":"司晨兼五德，曾伴宋宗窗。\n日攘能防慎，终当免镬汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葵花吟","author":"金朋说","text":"绛萼累累承晓露，含英蕴质并朱云。\n庙廊忠梗谁堪比，能展丹心向日倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏竹吟","author":"金朋说","text":"放鹤空庭竹似宾，轻风晴日绿筛金。\n幽人宁使食无肉，不可轩墀少此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏桃吟","author":"金朋说","text":"瑶池结实几千春，曾种河阳花满城。\n若问武陵先日事，相逢俱是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩昌黎","author":"金朋说","text":"世降文衰失正儒，韩公卫道辟杨朱。\n诚通衡岳开云阵，义信遐荒化鳄鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漂母堂","author":"金朋说","text":"恻隐殊无一念仁，谁能推食食王孙。\n纷纷天下奇男子，不及淮阴一妇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧岩吟","author":"金朋说","text":"苍苍岩上树，夜气积而然。\n念彼人之学，盈科为有源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔷薇吟","author":"金朋说","text":"涂朱抹粉吐芳馨，倚架依阑承露新。\n腻白妖红谁不惜，樽前莫负插花吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡侯雪天开宴即席以填字韵索诗","author":"金梁之","text":"昨夜嫦娥弄玉纤，也应掐月作花钿。\n为嫌梅影太清瘦，几片飞来疏处填。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠郡士张梦锡赴南宫试","author":"金梁之","text":"秧针刺水麦锋齐，漠漠平沙白鹭飞。\n尽道春光已归去，清香犹有野蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答郡守赵师夔","author":"金梁之","text":"王侯门户懒开颜，斗酒千钱一笑间。\n无雪可欺青桧老，有天难管白云闲。\n丹霄作客曾骑鹤，紫府为家不买山。\n京口相逢又相别，只琴孤剑几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"金梁之","text":"寄语月溪朱逸士，他年同赏水仙花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 丰城道中","author":"金淑柔","text":"雨溜和风铃。\n滴滴丁丁。\n酿成一枕别离情。\n可惜当年陶学士，孤负邮亭。\n边雁带秋声。\n音信难凭。\n花须偷数卜归程。\n料得到家秋正晚，菊满寒城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荔枝","author":"金暕","text":"金狄门前拜诏新，白龙台下拥朱轮。\n蕉花雨里千兵路，荔子风中万马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题净乐院壁","author":"薛仲邕","text":"再到招提已六年，溪山云雾总依然。\n飘零莫笑浑无用，自谓功名可著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吕公岩","author":"金靖","text":"护田绿水转山樊，滴翠群峰列巨杉。\n洞外僧蓝侵斗汉，涧边人迹隔仙凡。\n深深云谷春长在，寂寂松扉夜不缄。\n此处得名爰自我，要须题作吕公岩。\n不用湔厅向水边，乘风宜坐此岩巅。\n山阴乐事真何似，觞咏终能胜管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鱼簖","author":"金嘉谟","text":"芒苇织帘箔，横当湖水秋。\n寄言鱼与蟹，机阱在中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月丁亥与诸友奠何先生毕退游北山智者寺书二十八言","author":"金履祥","text":"来往师门十五年，此山曾近未跻扳。\n于今始至滋怀恨，不见先生却见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上灵洞栖真寺听琴赠立公","author":"金履祥","text":"为访高人入山去，迢迢山路不知劳。\n此身已到山高处，更听琴声山更高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东津旅中同徐改之馆清溪源招之同游","author":"金履祥","text":"见说君居幽更幽，客中相望两悠悠。\n愿言携手高峰去，俯瞰苍茫尽睦州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"术士求书往横山复以诗赠","author":"金履祥","text":"钱君杖履到横山，为我传声谈话间。\n术动诸君应一笑，不教垂橐怨空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"术士求诗","author":"金履祥","text":"自分迂疏已遁思，君言造化有他奇。\n吾生果赴功名会，不使勋庸愧鼎彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵赠小张兄新娶","author":"金履祥","text":"洞房佳气比椒兰，刑至工夫自古难。\n莫使家人誇羯末，杨花飞处北风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵赠诸友","author":"金履祥","text":"临别哦诗比赠兰，圣贤学问贵先难。\n归与休用嗟离索，来岁时时到岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"金履祥","text":"佳人早幸已从良，好治丝麻理素妆。\n休向人前售歌舞，春风宁得几时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛免口占","author":"金履祥","text":"皇家科目喜宏开，试比抽拈不择才。\n多少官人无着处，不知能得几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热和徐山甫韵","author":"金履祥","text":"地捲槁苗尽，人居沸鼎中。\n何时霖雨相，梦到武丁宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳夏五求王先生墨戏梅竹二首 其二 竹","author":"金履祥","text":"图书阅罢独高斋，撰杖油然午荫回。\n楮颖从容侍函丈，不妨閒引此君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳夏五求王先生墨戏梅竹二首 其一 梅","author":"金履祥","text":"溽暑初蒸日正长，人间何处有清凉。\n先生笔下风威劲，便放寒梅次第香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客严陵赠星史","author":"金履祥","text":"七里滩头眼为青，秋风许我快南溟。\n东京太史知谁氏，不算庄光是客星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其七 小龙门","author":"金履祥","text":"两崖叠叠水中分，瀑布飞流漱石根。\n伊阙西河天一角，山间号此小龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其十 中峰","author":"金履祥","text":"高岩南下走群龙，两小源头合一峰。\n问道是中人不识，先生信善择中庸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其六 中涧","author":"金履祥","text":"雪液风来自石峰，金华众壑此为中。\n须知流出此山外，更会群流共入东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其八 五叠泉","author":"金履祥","text":"时行时止石高下，或见或闻云有无。\n五叠何妨转奇伟，终然万折必东趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其四 双龙洞","author":"金履祥","text":"天镵鬼凿匪人间，涌雪轰雷震地寒。\n石上双龙盖形似，更深须有老龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其三 冰壶洞","author":"金履祥","text":"洞外烟云肤寸合，洞中冰雪百寻飞。\n壶中日月凭谁记，水自飞淙云自归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其九 老梅岩","author":"金履祥","text":"片石崎嵚斜插涧，横枝愁绝净无尘。\n从兹石上栽冰玉，寒谷年年递早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其一 高石岩","author":"金履祥","text":"山到金盆共绕回，势高群岫独崔嵬。\n那更绝顶又拳石，真似飞从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其二 朝真洞","author":"金履祥","text":"洞府高深对月开，长疑底里閟龙雷。\n天窗不照人间世，限尽游人自此回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞山十咏 其五 椒庭","author":"金履祥","text":"洞泉喷薄雨鸣霤，竹石参差风绕楹。\n好障波流浸山影，飞来灵隐一般清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐山甫夜话有诗言别次韵","author":"金履祥","text":"一榻萧然竹与兰，拥衾话别转留难。\n明朝又渡湘江去，细雨斜风分外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下赋归奉别天台金彦如惠子明沈新之马景昭赵寅仲并呈于晦仲时与寅仲以上诸兄初相识诸兄又约便道至王先生岁寒堂相会也 其二","author":"金履祥","text":"客中相见别匆匆，论学无由意独浓。\n赖是岁寒来有约，不妨归去又相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下赋归奉别天台金彦如惠子明沈新之马景昭赵寅仲并呈于晦仲时与寅仲以上诸兄初相识诸兄又约便道至王先生岁寒堂相会也 其一","author":"金履祥","text":"多士趋京我亦东，不排阊阖不南宫。\n此行识得天台彦，谁道归舟载月空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雨书怀并唁汪功父","author":"金履祥","text":"雨意萧萧重客愁，如何五月便成秋。\n士无禄养农无地，早恐秋风惨黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游赤松口占","author":"金履祥","text":"苍虬夹岸几重重，灵液飞流碧涧通。\n可是神人易忘世，人间争得此山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽莲塘吴孺人 其三","author":"金履祥","text":"细雨西窗展画筒，江山杳霭几重重。\n檐花飞动衣裳冷，疑在云间第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]