[{"title":"和张仲巽过瀛州感旧","author":"苏颂","text":"览君关外感怀篇，重到藩城倍怆然。\n岂为宦游无定止，却思世故易推迁。\n流年忽复龙周纪，急景仍逢雁去燕。\n物是人非重惆怅，空馀陈迹吏民传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子仪学士上元","author":"苏颂","text":"倾都繁盛数宵中，知是钧天第几重。\n岧阙开筵纡警跸，綵山张乐戏鱼龙。\n月华高下随灯丽，春色融和入酒浓。\n拟逐胜游行乐去，长年于事亦无悰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子仪寄吴仲庶","author":"苏颂","text":"并驰绝塞待燕邻，喜过重关值故人。\n阔别经年劳远梦，留连此日奉清尘。\n威行列郡连营肃，恩浃诸戎异域春。\n愿学子云承汉诏，未央宫壁颂功臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子仪瀛州借马寄安抚待制","author":"苏颂","text":"塞草黄明畜牧肥，外闲千驷气增威。\n权奇毛骨森相映，騕袅精神动若飞。\n暂借行人持玉节，屡陪方伯展朱旂。\n料君早晚趋严召，安稳乘归从六騑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李少卿寄吴仲庶","author":"苏颂","text":"延阁儒臣出抚边，指纵胡虏坐挥鞭。\n歌谣早已留南楚，唱和今还到北燕。\n使客过从车结辙，耕夫安佚土开阡。\n更将佳句刊斋壁，留作河间故事传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨直讲寒食感怀","author":"苏颂","text":"永日轻风起暝阴，伤春情绪苦难禁。\n流连节物游人意，怅惜时光志士心。\n桃李新芳添远思，龙蛇遗事感悲吟。\n知君退直饶欢趣，每向尊前赏奏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陆农师侍郎三和前韵","author":"苏颂","text":"主人满酌玉东西，坐客无辞醉似泥。\n此日逢迎皆笑语，几年南北叹暌携。\n早登鸡省先诸彦，合入鳌坡试五题。\n雅道寂寥今复振，士风一变始于齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈和叔秋寒","author":"苏颂","text":"夕雨初开霁，晨霜已结寒。\n增裘肌怯重，对酒面生丹。\n急节惊收潦，归心念采兰。\n昕趋更清栗，委佩缀公桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈彦升学士九月校书怀旧之作","author":"苏颂","text":"京国重阳册府家，正披坟史猎菁华。\n思飘昔日龙山帽，阻看残秋上苑花。\n怅惜岁华霜染鬓，滞留归思角生车。\n自怜高阁穷年业，青简刊雠未有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和兖弟到郡先寄","author":"苏颂","text":"虽非禄厚与官尊，多幸名都遂出藩。\n访旧遍游江北路，提封连接海西门。\n六年往复头先白，四郡推迁席不温。\n衰病早宜归畎亩，君恩未报自难言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和兖弟游湖上诸寺二首 其二","author":"苏颂","text":"湖山不到每驰情，与客逢迎暂驻旌。\n鹫岭飞来询慧理，龙宫吟就续延清。\n僧房有竹循门见，磴道攀萝尽日行。\n交臂晤言欣得侣，上台专使对仙瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和兖弟游湖上诸寺二首 其一","author":"苏颂","text":"丛林四百见州经，尽在钱塘旧县坰。\n十里湖光连北郭，千寻岩翠绕南屏。\n松间幽径迎冠盖，竹里飞泉入户庭。\n胜境无因朝日到，羡他禅伯老林扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和府推官冬菊","author":"苏颂","text":"经冬寒菊已离披，梁苑残英尚满墀。\n尊酒还思元亮醉，秋香又过子愚期。\n寻芳意思人尤厚，耐冷枝条土所宜。\n墨客有谁偏好事，留将乐府著新辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林乔年学士","author":"苏颂","text":"高阁清寒夜未暝，独持铅笔校中经。\n灯残短檠人初静，月上虚廊户不扃。\n倚盖星河檐际直，玉晨钟磬枕边听。\n归来欲记通宵景，恍若曾游上帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林成之五题 其三 江上","author":"苏颂","text":"何处偏伤江上春，天涯失意未归人。\n片云极望添乡思，孤棹随波寄客身。\n塞雁来时凭远信，海鸥驯处见吾真。\n休嗟进取无成去，幸有荣名足慰亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林成之五题 其二 城南","author":"苏颂","text":"心乐郊原景，人应似我稀。\n城南时一到，山寺几忘归。\n新竹当行径，飞云恋客衣。\n谁能咏招隐，向此息尘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和欧阳永叔少师会老唱和诗三首 其三 和汝阴侍读","author":"苏颂","text":"出守尝希阮仲容，剖符仍继夏侯公。\n金华旧侣三贤并，绿野先归二老同。\n宴会莫如今日盛，唱酬还有古人风。\n自嗟流落江湖外，不得尊前听燕鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和俞仲素太博游茅山二首 其二 马上初望茅峰","author":"苏颂","text":"三士隐沦地，上林句曲前。\n朅来思访道，属望赋游仙。\n松引飞轮路，云收积玉巅。\n华阳不知远，趣驾似行天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和俞仲素太博游茅山二首 其一 宿明真观","author":"苏颂","text":"平林行尽到岩扃，一昔恬然道味生。\n爽籁远随林谷响，飞云时拂栋梁轻。\n閒倾仙斝流琼液，高论神方鍊日精。\n更想真游成不寐，坐听松韵到黎明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前三篇 其二","author":"苏颂","text":"山公偏爱习家池，每出游时醉不知。\n既见国侨如旧识，何须阮籍乃吾师。\n亭边菡萏铺新锦，水际闾阎近布棋。\n欲作宣城十日饮，留连梦得似敦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前三篇 其一","author":"苏颂","text":"孟郊篇什况咸池，夫子文章我所知。\n岂特曹刘同品目，固将苏李是宗师。\n语如转弹逢真赏，喻到鏖兵诧国棋。\n所集若携归阙下，诸公应序盛山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前三篇 其三","author":"苏颂","text":"百雉金城十仞池，天声遐憺远戎知。\n剖符但报三年政，推毂无劳六月师。\n胡马逸归常见画，塞鸿征尽著残棋。\n欲歌盛业赓周雅，须假清风吉甫诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宣甫叔读白傅丁相诗集","author":"苏颂","text":"二公清尚固难偕，迁谪襟怀亦洞开。\n得志已观邪与正，寓言宁校福兼灾。\n恬然委顺诚高识，展矣文华信雅才。\n珍重佳篇堪继美，咏歌中遣待时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和神水馆逢齐叶二国信","author":"苏颂","text":"几旬驰传困风埃，忽听南轺病眼开。\n千里边疆难际遇，一封京信况同来。\n论情不异声投谷，适遇过于渴望梅。\n谈笑未经催命驾，归心虽切且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡完夫侍郎再次前韵见寄","author":"苏颂","text":"荷橐相从两掖西，清尘自不间污泥。\n恩颁玉醴同沾醉，坐簇宫花任折携。\n幸接剧曹联四选，曾观大笔赋三题。\n因吟将相门生咏，牛白声名便欲齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和通判白同朝散见别","author":"苏颂","text":"乐土民勤不带牛，观农时得看耕楼。\n老惭卧阁思投绂，恩假祠宫换典州。\n就第未荒三径菊，过江无俟五湖舟。\n题舆别乘方腾逸，讵肯相从物外游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱塘周寺丞游南山","author":"苏颂","text":"两寺临湖共一山，名传四五百年间。\n台前康乐翻千叶，井上仙翁鍊九还。\n挂壁空存游客咏，掩关都属野僧閒。\n欣同僚友寻幽趣，岩石云萝永日攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和惟晤师游鹤林寺寄颖长老","author":"苏颂","text":"黄鹄山前古梵宫，参差楼殿倚岩中。\n群峰重叠围松径，三伏嬉游爱竹风。\n牛首禅宗怀马素，襄阳耆旧忆庞翁。\n长思胜会真幽适，谁使句婴不与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晨发柳河馆憩长源邮舍","author":"苏颂","text":"君逢嘉景思如泉，欲和惭无笔似椽。\n山谷水多流乳石，旃裘人鲜被纯绵。\n服章几类南冠系，星土难分列宿躔。\n安得华风变殊俗，免教辛有叹伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和清明后一日游西池","author":"苏颂","text":"万家供帐集西明，綵舰芳林酒屡行。\n强对莺花无奈老，时闻歌吹不胜情。\n轮囷佳气城头近，炰喔清风语下生。\n休沐傥閒须数往，水边庭际解朝缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和富谷馆书事","author":"苏颂","text":"迢迢归驭指榆津，日日西风起塞尘。\n沙底暗冰频踠马，岭头危径罕逢人。\n客心牢落偏多感，天意融怡渐发春。\n珍重诗翁饶藻思，剪裁风物见长新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和就日馆","author":"苏颂","text":"戎疆迢递戴星行，驿骑奔驰刺火迎。\n人向万山峰外过，月从双石岭间生。\n马蹄看即三千里，客舍今逾四十程。\n每念皇华承命重，愧无才誉副群情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和游中京镇国寺","author":"苏颂","text":"塔庙奚山麓，乘轺偶共登。\n青松如拱揖，栋宇欲骞腾。\n夷礼多依佛，居人亦贵僧。\n纵观无限意，纪述恨无能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和签判早秋见寄","author":"苏颂","text":"沧海西垠浙水头，人生不到负吴讴。\n剖符何幸来都会，坐閤俄惊陟夏秋。\n每按吏条惭汉诏，未丰民食念箕畴。\n所欣幕府多才彦，樽俎时时接宴游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和签判郡圃早梅","author":"苏颂","text":"绿萼丹跗炫素光，东园先见一枝芳。\n凌晨霜点铅胡粉，满槛风飘水麝香。\n味入和羹来傅野，声随边角动渔阳。\n山亭最好通宵赏，微雪相辉映月廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国史龙图侍郎宋次道挽辞五首 其五","author":"苏颂","text":"君尝龃龉更三已，我亦邅回再下迁。\n趣舍既同高谊在，升沈虽异素交全。\n斤从质丧知何用，蕙为芝焚亦自怜。\n重咏十年情味句，吁嗟生意转翛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国史龙图侍郎宋次道挽辞五首 其四","author":"苏颂","text":"前日闻君撤瑟初，伤心悲愤不能舒。\n平生鲍叔偏知我，垂老庄龙独弃予。\n人物风流今已矣，交游零落痛何如。\n从兹道义谁相告，每欲临文辄废书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国史龙图侍郎宋次道挽辞五首 其三","author":"苏颂","text":"告卧春明日，灾逢本命年。\n英灵百人敌，奄忽一朝捐。\n妙墨宗祧秘，遗文太史编。\n家书四世学，嗣子复能传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国史龙图侍郎宋次道挽辞五首 其二","author":"苏颂","text":"接武由童冠，论年并巳庚。\n切磨三友益，终始一交情。\n少别才经夏，何言遂隔生。\n空深寝门恸，不见穗帷旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国史龙图侍郎宋次道挽辞五首 其一","author":"苏颂","text":"台阁三朝旧，丝纶载世承。\n早年钦妙誉，末路愧同升。\n论议无吾间，文章岂众能。\n二经垂绝笔，天丧沈吴兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"坤成节集英殿宴教坊口号","author":"苏颂","text":"首秋初望敛阶蓂，侍宴千官拱大庭。\n法部重翻慈寿曲，译场初上贝多经。\n宝邻双节遥驰传，玉塞重关尽撤扃。\n企望璇宫同祝圣，天南已见老人星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉使还至近畿先寄史院诸同舍二首 其二","author":"苏颂","text":"倏忽经冬又涉春，年光冉冉暗催人。\n要荒一去三千里，晦朔俄惊十二旬。\n绝代方言空问俗，蓬山直舍已凝尘。\n汗青何日成书去，头白常惭窃禄频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉使还至近畿先寄史院诸同舍二首 其一","author":"苏颂","text":"书林轻别紫云边，轺传重行北斗间。\n正类子卿悲异国，不同太史访名山。\n鞍韂腾踏双腨重，风日煎熬两鬓班。\n待得使回翻旧稿，只应新例又刊删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尚书左丞赠开府仪同三司邓公挽辞三首 其三","author":"苏颂","text":"贡部抡才选，高风素所钦。\n方闻二道策，献纳百官箴。\n荣滞登台晚，周爰注意深。\n有时无命叹，遗恨古犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尚书左丞赠开府仪同三司邓公挽辞三首 其二","author":"苏颂","text":"未正阶槐位，先登省辖崇。\n帝方咨傅野，天遽夺杨公。\n黻冕恩褒德，箫笳礼送终。\n淮滨故人在，一恸向西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit