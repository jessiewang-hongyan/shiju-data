[{"title":"證道歌 其一六九","author":"释印肃","text":"建法幢，立宗旨，语默风云处处是。\n莫言止道有曹溪，失汝元常何益利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一四○","author":"释印肃","text":"三乘五性皆醒悟，方知自有珍珠库。\n临时分付与儿孙，不劳更倚他门户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一五","author":"释印肃","text":"却被如来苦诃责，尔我真心何间隔。\n贪忙只欲外边寻，直至如今连眼塞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一七","author":"释印肃","text":"从来蹭蹬觉虚行，不辞山远与深坑。\n一担须弥难放下，爱观峰顶秀崚嶒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二","author":"释印肃","text":"君不见，日面金仙如月面。\n见非是见见无能，霜天月映琉璃殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二三七","author":"释印肃","text":"狮子吼，无畏说，直言恰似翻成拙。\n问渠何处住居家，遥指前坡无处诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一七三","author":"释印肃","text":"历江海，入此土，万水千山同一路。\n来时无物去时空，稽首牟尼悉加护。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一四","author":"释印肃","text":"入海算沙徒自困，无本随商过海门。\n眼睹千珍并万宝，归来不得一文分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十七","author":"释印肃","text":"自从顿悟了无生，动寂无非共佛行。\n人问正因无可表，扬眉之外更无能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四一","author":"释印肃","text":"有二比丘犯淫杀，自嗟自怨无觉察。\n远栖林野望成真，自业茫茫谁摆脱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六四","author":"释印肃","text":"谁见螳螂能拒辙，萤虫七夕吞明月。\n织女心宽不作声，牵牛一棒和空折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一八三","author":"释印肃","text":"痕垢尽除光始现，照见不似娘生面。\n无头无尾一般般，千眼大悲也不见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五十一","author":"释印肃","text":"无价珍，用无尽，刹刹尘尘光迥迥。\n超腾今古绝形名，四七二三宗慧命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一六三","author":"释印肃","text":"有人问我解何宗，只堪摇手报伊聋。\n灵利衲僧须瞥地，何劳更说五家宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三","author":"释印肃","text":"绝学无为闲道人，不曾礼拜不看经。\n不动遍周尘刹海，卓尔孤身混白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六一","author":"释印肃","text":"日可冷，月可热，凡夫倒用成磨灭。\n大道圆明一性通，春夏秋冬谁辨别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一三六","author":"释印肃","text":"早曾落却天魔胆，添不添兮减不减。\n冻死不著贱人裈，饿死不吃须边糁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一六八","author":"释印肃","text":"不是等闲相诳惑，一失人身难再得。\n善根微细恶因多，地狱阿鼻无间隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十一","author":"释印肃","text":"镜里看形见不难，徒劳渡水与登山。\n演若达多头不失，狂怖自歇快平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六○","author":"释印肃","text":"定慧圆明终不失，天回地转光澄寂。\n劫火洞然转转新，个事如如谁委悉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五五","author":"释印肃","text":"了了见，无一物，唯有天真一如佛。\n普贤腹里接观音，善财稽首称奇特。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○二","author":"释印肃","text":"百年妖怪虚开口，五伯生亲狐兔走。\n百丈峰前一句新，不昧光中犹未了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五二","author":"释印肃","text":"河沙如来同共證，光光相彻无馀剩。\n各申右手摩其顶，龙天万亿咸归命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五一","author":"释印肃","text":"法中王，最高胜，一微尘里光无尽。\n无边身相入微尘，转大法轮常普应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四八","author":"释印肃","text":"万两黄金也消得，道人有甚相交涉。\n家中祖代没分文，广度河沙三界客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○一","author":"释印肃","text":"但得本，莫愁末，远远寻师多赚脱。\n君子务本道须生，不用牵麻并拽葛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其十三","author":"释印肃","text":"若将妄语诳众生，永劫不来世上行。\n无缝塔中非相貌，劈头坐却老卢能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九十","author":"释印肃","text":"岑崟幽邃长松下，月朗风高寒溜泻。\n潺潺古韵实希奇，卖向人前谁著价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六五","author":"释印肃","text":"大象不游于兔径，针锋头上礼观音。\n百尺竿头犹进步，十方沙界现全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一七一","author":"释印肃","text":"第一迦叶首传灯，百万人天耸耳听。\n金色头陀闻不会，拈花起处笑尖新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十七","author":"释印肃","text":"六般神通空不空，眼耳鼻舌身意同。\n无皮鼓子教谁打，古今分付与雷公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其十一","author":"释印肃","text":"證实相，无人法，不用尺刀并寸甲。\n魔军尽总證菩提，大地须弥一芥纳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十六","author":"释印肃","text":"何表无生慈忍力，洞庭撞倒虚空吃。\n不留丝发与人知，摩诃般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十二","author":"释印肃","text":"假饶毒药也闲闲，一吸西江尚不难。\n达磨曾经无损缺，后遗只履葬熊山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二○","author":"释印肃","text":"不达如来圆顿制，丈六金身即我是。\n离知名相更无知，日夜烧香空自礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十五","author":"释印肃","text":"几回生，几回死，汩没海中如泡子。\n猛风击浪了无休，风静源平非我所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十五","author":"释印肃","text":"不因讪谤起冤亲，斩却猫儿不作声。\n尤赖赵州收得橛，草鞋搭脑笑忻忻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四五","author":"释印肃","text":"不思议，解脱力，不是思量心外得。\n一句当天八万门，野桥金柳依依色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十九","author":"释印肃","text":"净五眼，得五力，五通曾告瞿昙觅。\n證知见觉不相干，因邪打正连天碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六七","author":"释印肃","text":"莫将管见谤苍苍，井底蛙牛逞巨江。\n乾坤大地一只眼，用来还似一毫芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五○","author":"释印肃","text":"一句了然超百亿，如如不动纤毫力。\n普眼当观如□□，春晴晓雾连天碧。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○五","author":"释印肃","text":"江月照，松风吹，不是渠侬更是谁。\n参禅学道波波走，岂知自有颗明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十一","author":"释印肃","text":"师子吼，无畏说，巍巍不动威光摄。\n十方法界现全身，且无伴侣相交涉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五十九","author":"释印肃","text":"从他谤，任他非，体若虚空物物齐。\n无异孩童争瓦砾，更加黄叶止伊啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一八","author":"释印肃","text":"多年枉作风尘客，不问东西与南北。\n只应好住便安身，闻举汝身心似墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二十九","author":"释印肃","text":"诸行无常一切空，一切空处合元宗。\n如如莫作身边见，法界无他一性同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六三","author":"释印肃","text":"象驾峥嵘谩进途，气冲牛斗耀昏衢。\n日月失光谁敢顾，万邪冰烁绝名模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十八","author":"释印肃","text":"一颗圆光色非色，记剑何劳舟上刻。\n色即是空空不空，取相凡夫当面隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十四","author":"释印肃","text":"摘叶寻枝我不能，和根拔出示众生。\n只这菩提本无树，撩天映岳碧层层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一四六","author":"释印肃","text":"一切水月一月摄，翳眼盲夫胡指决。\n都卢只这一心光，年年来叫桃花月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一○","author":"释印肃","text":"两铦金镮鸣历历，大似檐头雨滴滴。\n试问参方什么声，迷心未达菩提力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九十三","author":"释印肃","text":"觉即了，不施功，绕旋三匝叩卢公。\n虽留一宿非他得，自己灵光本廓通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十","author":"释印肃","text":"河沙诸佛体皆同，如今端坐大雄峰。\n森罗万象无藏隐，元来只在一尘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一三","author":"释印肃","text":"不求真，不断妄，自古迄今无两样。\n真妄犹如六月霜，杲日炎天唯妙相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十四","author":"释印肃","text":"此即成吾善知识，道有说无真利益。\n眉下纵横放白光，不动分身千百亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十一","author":"释印肃","text":"纵遇锋刀常坦坦，只因得只金刚眼。\n一相光中无二形，劫火洞然无退返。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十三","author":"释印肃","text":"常独行，常独步，步步不离佛国土。\n不曾见有一众生，皆入无馀涅槃户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一八","author":"释印肃","text":"廓然瑩彻周沙界，言语难诠无可解。\n别传一句了非言，妙契圆通观自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五六","author":"释印肃","text":"亦无人，亦无佛，广大楼台弥勒宅。\n豁开门户接群生，一念无心全用得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十三","author":"释印肃","text":"观恶言，是功德，妙明岂假旃檀刻。\n一言一喝彻圆音，不用耳闻须得得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一七","author":"释印肃","text":"心镜明，鉴无碍，十方刹土无边背。\n打破镜来相见伊，祇这圆光会不会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十二","author":"释印肃","text":"水中捉月争拈得，渠应不苟诸颜色。\n吴道僧繇画不成，痴猿彻夜空拿搦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○三","author":"释印肃","text":"我今解此如意珠，贫儿衣里灿光辉。\n行行到处不曾失，再逢亲友始无疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○六","author":"释印肃","text":"永夜清宵何所为，辽天宝月共相辉。\n泥牛入海无消息，一声木马大阳随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二十三","author":"释印肃","text":"谁无念，谁无生，过现未来心不停。\n一念不生无我所，即是弥陀亲老兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二一","author":"释印肃","text":"二乘精进勿道心，南宗北祖乱纷纭。\n虽是善因招恶果，几时解得见天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五四","author":"释印肃","text":"与吾灵觉何交涉，云门有客三机接。\n语论千春不昧真，深明此性无时劫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十八","author":"释印肃","text":"实是身贫道不贫，七斤衫里不容针。\n摇头只许无心得，入水元来不动冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十","author":"释印肃","text":"把火烧天徒自疲，坚持十力助他非。\n烦恼息时全体是，速令直下发菩提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十七","author":"释印肃","text":"穷释子，口称贫，雪曲高歌和没人。\n往来问道无言说，月在青天水在瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十二","author":"释印肃","text":"销融顿入不思议，子细推详我不是。\n无相光中古佛传，尽被真空穿却鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一七七","author":"释印肃","text":"真不立，妄本空，劝君贼过莫施弓。\n越古超今无可有，纤毫窒碍不能通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其十八","author":"释印肃","text":"觉后空空无大千，今年不离旧时天。\n春夏秋冬花木节，皆标实相耀心源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二六","author":"释印肃","text":"根境法中虚捏怪，见说是师便礼拜。\n汝从甚处到其间，且作街坊兼化菜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五十四","author":"释印肃","text":"八解六通心地印，晃晃恢恢非远近。\n六通八解者全彰，念彼劳生提后进。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○○","author":"释印肃","text":"一超直入如来地，自是众生不了利。\n行住坐卧总皆真，逐末兴心成执滞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十九","author":"释印肃","text":"行亦禅，坐亦禅，面壁淹淹过九年。\n失钱遭罪神光骇，分皮分髓过西天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五十六","author":"释印肃","text":"中下多闻多不信，文章学解增心病。\n阎公未肯便饶伊，碓捣磨磨终不静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十七","author":"释印肃","text":"宗亦通，说亦通，两处由来剑刃锋。\n八还要义漫天诀，七处徵心理一同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]