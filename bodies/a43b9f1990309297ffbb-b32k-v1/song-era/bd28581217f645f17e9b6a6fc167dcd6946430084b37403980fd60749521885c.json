[{"title":"林子长录旧诗来觅酒因送似之","author":"虞俦","text":"酒者忘忧物，难教与愿违。\n未能聊尔耳，时复一中之。\n全醉无乘坠，偏醒有是非。\n兵厨那可恋，州绂屡交驰。\n莫讶台无馈，相逢盖有时。\n留髡从昔惯，舍盖有谁知。\n短棹能来往，经年慰别离。\n何尝有此客，了事笑痴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代黄仲本贺赵漕","author":"虞俦","text":"岳镇凝华久，天潢析派初。\n长庚秋入梦，佳气夜充闾。\n奕叶兰同茂，怀珠玉不如。\n词章贺白右，经术向歆馀。\n已近长安日，聊登使者车。\n著鞭先禁路，储宝镇皇居。\n家世曾重席，王门昔曳裾。\n弹冠惭似续，入幕借吹嘘。\n愿献长生箓，何须鸿宝书。\n黑头须两地，玉带拥金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潘簿食笋诗","author":"虞俦","text":"平生爱竹几成癖，到处成阴已足嘉。\n潇洒未输彭泽柳，檀栾偏映杜林花。\n园林日日饶春事，红紫纷纷尽岁华。\n清节抱萌初入眼，金盘当馈莫摇牙。\n从渠燕颔誇千尺，还我鳌竿是一家。\n须信直钩终有用，渭川元不钓烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新辟东轩夜间月色满床可爱简耘老弟","author":"虞俦","text":"偃息飞檐下，开轩适向东。\n满床今夜月，只欠与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其一","author":"虞俦","text":"年华纷代谢，时态几沉浮。\n天末凉风起，何人不感秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其二","author":"虞俦","text":"已是诗成集，何妨酒拍浮。\n人生不行乐，空惜鬓惊秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其三","author":"虞俦","text":"向道鲈鱼美，须渠太白浮。\n季鹰归未得，空忆五湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其四","author":"虞俦","text":"柏寺官联谬，萍踪宦海浮。\n向来苕霅梦，罪我亦春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其五","author":"虞俦","text":"故里经年别，虚舟尽日浮。\n有书谁与寄，目送雁横秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其六","author":"虞俦","text":"窗暗灯花结，帘疏露气浮。\n晚来城上角，吹断一天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管感秋七首 其七","author":"虞俦","text":"诗到齐梁后，名多李杜浮。\n谁能追正始，蟪小岂知秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨过","author":"虞俦","text":"处处村舂急，家家晚爨烟。\n青山映丹杏，过雨转嫣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡杂兴","author":"虞俦","text":"寒食无多日，梨花又一春。\n鹿门山下路，真有姓庞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"轿中疲甚作绝句","author":"虞俦","text":"谢雨还如祷雨时，篮舆顿撼不胜疲。\n两回往返千馀里，禄马交驰恐应之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归途轿上口占","author":"虞俦","text":"三尺苍头佩酒壶，篮舆稳度白毡铺。\n凭谁为把无尘笔，画取先生看雪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和主簿郁同年","author":"虞俦","text":"紫鸾合在烟霄上，敛翅聊栖枳棘间。\n若向两途分上下，可能句里有江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登舟往瓜州护使客回程","author":"虞俦","text":"冬来长夜数更筹，耿耿青灯照客愁。\n底事舟中能好睡，觉来身已抵瓜州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋前一日风雨大作林子长辄动归兴赋二绝因次其韵 其一","author":"虞俦","text":"桂华天上正扶疏，万里清光散有馀。\n厚约本期今夕共，翻云覆雨独何欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋前一日风雨大作林子长辄动归兴赋二绝因次其韵 其二","author":"虞俦","text":"故人别来不作疏，扁舟访我得三馀。\n一杯相属岂易得，兴尽而返其然欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丛陵仲秋荐献毕回舟过鉴湖遇雨 其一","author":"虞俦","text":"丛陵蒇事谨秋尝，归路扁舟泛渺茫。\n剡雪无由访安道，鉴湖空复忆知章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丛陵仲秋荐献毕回舟过鉴湖遇雨 其二","author":"虞俦","text":"早禾割尽晚禾青，地下知章果有灵。\n岂忆鉴湖曾敕赐，连山云雾雨冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春 其一","author":"虞俦","text":"土牛迟重小加鞭，无限春风才管弦。\n好事东君真敏捷，也能雪里散红莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春 其二","author":"虞俦","text":"綵胜华灯共一回，新年乐事并相催。\n天公预借今宵景，更放团圆好月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春 其三","author":"虞俦","text":"花柳争春岁岁同，美人剪綵莫言功。\n谁知造物初无物，只在洪钧一转中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春 其四","author":"虞俦","text":"腊雪初消柳眼寒，春风才入酒杯宽。\n一年佳节知多少，屈指从今是履端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓶中梅二绝 其一","author":"虞俦","text":"铜瓶沁水泫微温，便许争春雪里村。\n应为诗人太幽独，西窗和月伴黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓶中梅二绝 其二","author":"虞俦","text":"旧样宫黄羞半额，新番绛领衬陪腮。\n待簪宝髻连云重，且插铜壶借水开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小轩四围织短篱因成绝句","author":"虞俦","text":"自插笆篱当药栏，旋移花木向中间。\n东偏只要疏疏竹，开牖莫教遮却山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归途庖人先去远甚饥甚戏书二绝句 其一","author":"虞俦","text":"庖人先去几多时，赖是先生惯忍饥。\n扪腹只堪供一笑，穷途何事不差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归途庖人先去远甚饥甚戏书二绝句 其二","author":"虞俦","text":"旌旗小队引朝官，白叟黄童也聚观。\n我似仙人正骑虎，饥肠过午未朝餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林子长惠芡实走笔为谢","author":"虞俦","text":"珠玑璀璨忽堆盘，浴罢追凉得饱餐。\n不似来禽空有帖，直须同竹问平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"往年分教是邦当芡实初出时每承沈君得远少卿旋采以相饷其味芳鲜与市中所买者大不相侔至今尚能记忆近因与林子长语及之后乃蒙其分惠亟以绝句谢之今又承少卿和章但旧目录不讲恐亦似未安也","author":"虞俦","text":"溪毛秋后亟登盘，山色朝来并可餐。\n但得长为南荡客，何须索米向长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨晚目录之句盖聊以为戏耳何分惠之甚速耶得非乞诸其邻乎","author":"虞俦","text":"累累火齐忽堆盘，水里硫黄得饫餐。\n忆得旧时风味在，故人唯有一任安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长送芡实诗韵 其一","author":"虞俦","text":"芡实尝新又一年，溪堂风物想依然。\n软温初剥浑如旧，只欠高谈惊四筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长送芡实诗韵 其二","author":"虞俦","text":"裹送头颅慰隔年，书传鸿雁正翩然。\n诗成更想挥毫处，无数珠玑落满筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长送芡实诗韵 其三","author":"虞俦","text":"百琲明珠富有年，不须鲛客更潸然。\n斛量自是君家事，买取双鬟当舞筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长送芡实诗韵 其四","author":"虞俦","text":"目送归鸿不记年，书来系帛正茫然。\n也知函首初无罪，应为怀珠供四筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长送芡实诗韵 其五","author":"虞俦","text":"华池同咽足延年，枵腹新来忽果然。\n再遣金罂来入社，不妨朱袖镇当筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林子长送芡实诗韵 其六","author":"虞俦","text":"皓齿君家二八年，歌珠曾许听累然。\n双眉松子元同味，更唾馀花傍绮筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢友人寄芡实 其一","author":"虞俦","text":"芡盘新采辱分珍，远胜溪毛咏采蘋。\n老去何心温软味，漫将空想调诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢友人寄芡实 其二","author":"虞俦","text":"鸿头??竞怀珍，南荡风光胜白蘋。\n试捣明珠三万斛，与君换取坠楼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过半山亭","author":"虞俦","text":"跃马青罗步幛间，松林尽处是前山。\n玉梅刚障春风面，残雪融时见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"憩东山驿","author":"虞俦","text":"征车又抵东山驿，屈指前回仅两旬。\n多少路人相借问，不知何事往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蕲守李智仲惠簟","author":"虞俦","text":"黄琉璃色縠波纹，持赠多惭李使君。\n一枕凉风吹梦去，楚山脩竹正如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻六月十五日厅屋以二绝句寄衢 其一","author":"虞俦","text":"履道宅图还似否，乐天归计但茫然。\n人生閒适须闻早，屈指今过本命年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻六月十五日厅屋以二绝句寄衢 其二","author":"虞俦","text":"想见榱题高数尺，莫愁囊里费千金。\n明年便合多裁柳，绕屋连墙易得阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枕畔木犀","author":"虞俦","text":"屏里一斑窥豹管，钗头千粟缀鹅黄。\n角巾堕晓花同梦，月帐含秋影亦香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"目痛废看藏经","author":"虞俦","text":"毗卢华藏浩无涯，菩萨何妨且在家。\n近日不应魔事起，看经顿觉眼昏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴文炳报载藏经船坏已为曝晒毕二首 其一","author":"虞俦","text":"石濑沈舟事可吁，万签出水已沾濡。\n本来一卷无成坏，为问冯夷浸得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴文炳报载藏经船坏已为曝晒毕二首 其二","author":"虞俦","text":"贝叶琅函免浸淫，贤侯料理意何深。\n慨然忧物如忧己，已得他时援溺心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以蕲簟石枕送耘老弟有诗因和来韵并分送蒸沈以助其雅趣","author":"虞俦","text":"北窗枕簟称高眠，沉水还须起篆烟。\n老子平生无长物，殷勤分送敢论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"廨舍堂前仅有木犀一株今亦开矣为赋二绝句 其一","author":"虞俦","text":"淮山丛桂知名久，金粟离离玉露团。\n老子婆娑宁办此，秋来仅得一枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"廨舍堂前仅有木犀一株今亦开矣为赋二绝句 其二","author":"虞俦","text":"维摩丈室无人到，散尽天花结习空。\n犹有一枝秋色在，明窗净几胆瓶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"法妙观","author":"虞俦","text":"钟山畴昔愧移文，俗驾宁容更浃辰。\n忽有片云池上起，元来却是雨留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书 其一","author":"虞俦","text":"淮南猪肉不论钱，下舍应须数击鲜。\n过午食单毋溷我，饭来开口亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书 其二","author":"虞俦","text":"软炊香饭杜陵老，烂煮葵羹玉局仙。\n饱喜饥嗔吾未免，何当辟谷去求玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余家旧养二鹤今不复存因和林子长悼鹤长篇遂恻然有感口占二十八字","author":"虞俦","text":"倏然尸解去何之，玄圃昆崙定不疑。\n华表重来千载后，谁人不是冢累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成二首 其一","author":"虞俦","text":"一为饥驱三十年，近收朝牍赋归田。\n尚赊瓶粟开三径，敢羡庖珍食万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成二首 其二","author":"虞俦","text":"春菊秋花毋久溷，粗茶淡饭且随缘。\n除须甘旨供慈母，自合长斋绣佛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郁簿以职事出城且有登临之胜小诗戏之","author":"虞俦","text":"想见先生喜见颜，登临今在翠微间。\n兹游便是扬州鹤，不用持钱更买山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和耘老弟玉簪花韵","author":"虞俦","text":"香在幽兰伯仲间，出尘标格自清閒。\n黄冠野服真相称，掠我招词赋小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡做牡丹坛二绝 其一","author":"虞俦","text":"卵石周围砌作坛，更须面面作栏杆。\n瓜期未用相催迫，准拟来年看牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡做牡丹坛二绝 其二","author":"虞俦","text":"向阳姚魏动芳馨，傍砌尤宜架小亭。\n围坐俯窥群品秀，入檐平视远山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管送牡丹","author":"虞俦","text":"东君探借小春天，珍重霜馀晓更妍。\n岂是阳和私拙守，也应春色属诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管食菜羹 其一","author":"虞俦","text":"筠筒吹火鼎烹油，小摘朝来露已浮。\n烂煮香粳供玉糁，更须春味荐猫头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管食菜羹 其二","author":"虞俦","text":"未必烝壶输鸭味，谁云湩酪敌莼羹。\n先春已拟尝新韭，最爱萧萧夜雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姜总管食菜羹 其三","author":"虞俦","text":"膏粱馀习言无味，藜苋枯肠语转工。\n染鼎不应孤指动，来诗却得愈头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读某人江行诗轴","author":"虞俦","text":"介叟从来仆命骚，吟魂招得楚江涛。\n也知笔力千钧重，莫怪山城纸价高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过石湖关","author":"虞俦","text":"北关险处绝攀跻，牧马休教识玉溪。\n他日君王如有问，固应曾说到淮西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答吴钦孺","author":"虞俦","text":"桃李向人何许懒，春风用事不教閒。\n羁愁先自深如海，诗债那堪积似山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人六绝 其一","author":"虞俦","text":"天香国艳胆瓶中，眼界增明鼻观通。\n多谢高轩肯相顾，家贫不办一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人六绝 其二","author":"虞俦","text":"江南二十四番风，浪蕊浮花一洗空。\n断送春归可无恨，酒垆谁复过黄公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人六绝 其三","author":"虞俦","text":"未数骚人赋落英，新诗贻我底能清。\n笔端挽得东风住，侯喜真惭浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人六绝 其四","author":"虞俦","text":"沧浪未濯软红尘，捧檄东来祇为亲。\n天女不知摩诘病，云何却现宰官身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人六绝 其五","author":"虞俦","text":"杜宇声声苦唤人，应怜书剑走风尘。\n家山有约蚤归去，莫待来呼祈孔宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人六绝 其六","author":"虞俦","text":"排闷浑无酒十旬，落红铺绣未嫌贫。\n一壶饷我勾诗兴，大胜云安曲米春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]