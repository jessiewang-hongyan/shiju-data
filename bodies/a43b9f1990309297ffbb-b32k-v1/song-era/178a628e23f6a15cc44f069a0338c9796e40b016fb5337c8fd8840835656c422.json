[{"title":"和张文裕初寒十首 其四","author":"司马光","text":"何处初寒好，初寒太室山。\n晴空烟澹泊，返照雪孱颜。\n极目雁稍没，无心云自还。\n犹馀拜表累，不得坐松间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其三","author":"司马光","text":"何处初寒好，初寒洛水桥。\n沙痕水清浅，风叶柳萧条。\n关塞长涂直，嵩丘倒影遥。\n凤楼虽在北，车马不尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其二","author":"司马光","text":"何处初寒好，初寒洛汭宫。\n翠华虽脉脉，佳气自葱葱。\n阙角月华白，苑墙霜叶红。\n都人心望幸，注目不离东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其一","author":"司马光","text":"何处初寒好，初寒郏鄏城。\n垂绅多俊彦，列第尽公卿。\n裘马过从盛，门阑洒扫清。\n谁家拥兽炭，尽日管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李八丈小雪同会有怀邻几","author":"司马光","text":"天禄淹回德齿尊，暂留汾曲两朱轓。\n闲轩坐啸正飞雪，同舍倦游来及门。\n空叹高歌如郢客，愧无佳赋似文园。\n坐中犹欠邻几在，深负棋枰与酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李殿丞仓中对菊 其三","author":"司马光","text":"凉风正萧瑟，好月复徘徊。\n幽兴眇不尽，芳樽时一开。\n馀英盖红叶，坠露湿苍苔。\n从此东篱下，应忘归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李殿丞仓中对菊 其二","author":"司马光","text":"文案渐消散，仓闲吏已稀。\n庭空数蝶下，夜静一萤飞。\n爱赏忽成句，淹留时忘归。\n高情虽不系，遇此独依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李殿丞仓中对菊 其一","author":"司马光","text":"高士寄朝市，迥然心迹殊。\n秋风太仓里，黄菊满庭隅。\n陶令成诗后，王公送酒无。\n遥知厌俗事，未免强踌蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨卿中秋月","author":"司马光","text":"秋气平分夜，沈阴乍散天。\n窥林初淡薄，照席忽孤圆。\n泠入诗毫健，光浮醉弁偏。\n嘉宾勿轻去，桂影正娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和运使舍人北园饯别行憩三交僧舍冒雪宿百井关见寄","author":"司马光","text":"骊驹北上雪孱颜，韊矢前驱度汉关。\n僧室松杉清照眼，驿亭烟火迥依山。\n马衔边草枯犹瘦，雁怯胡云冷未还。\n贱子不须回首问，鬓毛萧飒簿书间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邵尧夫安乐窝中职事吟","author":"司马光","text":"灵台无事日休休，安乐由来不外求。\n细雨寒风宜独坐，暖天佳景即闲游。\n松篁亦足开青眼，桃李何妨插白头。\n我以著书为职业，为君偷暇上高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邵尧夫年老逢春","author":"司马光","text":"年老逢春春莫咍，朱颜不肯似春回。\n酒因多病无心醉，花不解愁随意开。\n荒径倦游从碧草，空庭慵扫自苍苔。\n相逢谈笑犹能在，坐待牵车陌上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和江邻几金铃菊","author":"司马光","text":"何处见佳菊，秋风汶水阳。\n酒浮金铎细，露泛蜜房香。\n不谓红尘地，相逢君子堂。\n依然故人意，不减旧芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和国子夏主簿李花","author":"司马光","text":"儒宫岑寂觉春闲，仙李繁花重压栏。\n碎锦不飞蒙树合，素云攲亚举枝难。\n能诗此日当推谢，捧赐他年足继桓。\n更约雕盘荐秋实，岂徒秾艳一朝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和始平公长句寄汉州何学士","author":"司马光","text":"势交倏忽易萧条，赖有伊人尚建标。\n须信松筠凌雪茂，肯为蒲柳望秋凋。\n钦贤高馆三年别，广汉专城百舍遥。\n书纸如云诗叩玉，数凭疾翼度青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和始平公郡斋偶书二首 其二","author":"司马光","text":"平安候火出云间，区脱无尘刁斗闲。\n汉相威声遥制敌，胡兵远迹夜开关。\n赤松雅意思轻举，黄阁群心望复还。\n玉帐牙旗空壮观，谢公高兴在东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和始平公郡斋偶书二首 其一","author":"司马光","text":"文武从容两有馀，公槐将幕往来居。\n已安四海如三杰，欲散千金比二疏。\n今日监边亲跪毂，佗年入殿赐乘车。\n武侯暂为苍生起，长忆隆中卧旧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和始平公梦中有怀归之念作诗始得两句而寤因足成一章","author":"司马光","text":"元宰抚洪钧，四海可熏灼。\n至人养天真，视此犹婴缚。\n出入金鼓威，寤寐琴樽乐。\n乃知伊吕心，未始忘丘壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和昌言官舍十题 其四 萱草","author":"司马光","text":"叶濯宿露翠，花迎朝日黄。\n昔谁封殖此，俨列侍高堂。\n达士隐于吏，孰为行与藏。\n逍遥玩永日，自无忧可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和明叔九日","author":"司马光","text":"不奈衰须白，羞看朝鉴明。\n聊凭佳节酒，强作少年情。\n雨冷弊裘薄，风高醉帽倾。\n如何不行乐，况复值秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和明叔游白龙溪","author":"司马光","text":"溪深荒径微，寻胜不知疲。\n寒月影随马，晓风冰满髭。\n行歌被褐叟，聚戏拾薪儿。\n外野饶真趣，令人怀抱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范景仁谢寄西游行记 其二","author":"司马光","text":"八水三川路渺茫，翠微深处白云乡。\n目■懒拭如松液，领发频抓似栗房。\n林壑不嫌无用物，形骸难入少年场。\n缘苔蹑蔓知多少，千里归来屐齿苍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范景仁谢寄西游行记 其一","author":"司马光","text":"洛川秦野郁相望，风物山河旧帝乡。\n涧底逢人问樵径，松间系马宿僧房。\n恨无同好携三雅，共讲前闻醉百场。\n历遍胜游翻怅望，日边回首远烟苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和复古小园书事","author":"司马光","text":"饱食复闲眠，风清雨霁天。\n叶深时坠果，岸曲乍藏莲。\n波面秋光净，林梢夕照鲜。\n东家近亦富，满地布苔钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵子舆龙州吏隐堂","author":"司马光","text":"四望逶迤万叠山，微通云栈落尘寰。\n谁知吏道自可隐，未必仙家有此闲。\n酒熟何人能共醉，诗成无事复相关。\n浮生适意即为乐，安用腰金鼎鼐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴朝议同年谢光与景仁同年见过","author":"司马光","text":"结绶东堂同发策，白头相值益相亲。\n却思景祐无多日，共见元丰有几人。\n天下高名归广受，古来交道重雷陈。\n谢公身老才方壮，落笔成章字字新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和留守相公九月八日与潞公宴赵令园有怀去年与景仁秉国游赏","author":"司马光","text":"今岁台星聚洛中，甘棠前后雨阴浓。\n英辞唱和诗千首，高宴游陪禄万钟。\n木末霜繁花未落，云间字小雁相从。\n西湖在望亲朋远，节物那堪处处逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和聂之美重游东郡","author":"赵鼎","text":"跃马津亭未几何，宦游容易十年过。\n飘摇空似随流梗，寂寞犹如挂壁梭。\n西岭应馀当日翠，南湖直减几分波。\n输君尚得飞征盖，重向东园听楚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和聂之美雁","author":"司马光","text":"汲汲复栖栖，往来谁与期。\n映云才可见，入雾杳难追。\n羁枕梦初断，寒闺涕已危。\n冥冥远缯缴，愧尔独知时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱学士呈邵兴宗","author":"司马光","text":"霜露苍苍宰树高，累茵列鼎重鸿毛。\n蒹葭自幸犹依玉，髋髀何能学奏刀。\n才薄无由禆覆焘，命奇不得报劬劳。\n平生念此心先乱，蓼蓼难分莪与蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景仁卜居许下","author":"司马光","text":"壮齿相知约岁寒，索居今日鬓俱斑。\n拂衣已解虞卿印，筑室何须谢傅山。\n许下田园虽有素，洛中花卉足供闲。\n他年决意归何处，便见交情厚薄间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范景仁夜读试卷","author":"司马光","text":"案前官烛堕花频，满目高文妙入神。\n勇气先登势无敌，巧心后发语尤新。\n好贤何啻三薰贵，求宝方知百汰真。\n愚鲁自非凭骥发，昆山千里到无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景仁闻蝉","author":"司马光","text":"春林满岩绿，谁信已鸣蝉。\n叶上正多露，山中别有天。\n心闲宁感物，道合况忘年。\n坐听生秋思，何须膝上弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景仁琼林席上偶成","author":"司马光","text":"念昔琼林赐宴归，綵衣绿绶正相宜。\n将雏虽复慰心喜，负米翻成触目悲。\n殿角花犹红胜火，樽前发自白如丝。\n桂林衰朽何须恨，幸有新枝续旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景仁答才元寄示花图","author":"司马光","text":"高士闲居旧，名花独步今。\n移从洛浦远，濯自锦江深。\n传得巫山貌，非因延寿金。\n不须天女散，已解动禅心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道矩送客汾西村舍杏花盛开置酒其下","author":"司马光","text":"田家繁杏压枝红，远胜桃夭与李秾。\n何事偏宜闲处植，无端复向别时逢。\n林间暂系黄金勒，花下聊飞码碯钟。\n会待重来醉嘉树，只愁风雨不相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王道粹垂拱早朝王范二直阁班列在前戏成小诗","author":"司马光","text":"霁日扶霜仗，祥烟覆晓班。\n帝居回北斗，天阙竦南山。\n紫殿鸿鸾肃，金门虎豹环。\n蓬莱两仙伯，迥立白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道粹春寒趋馆马上口占","author":"司马光","text":"残腊尚要春，清寒更著人。\n雪华犹惜别，物意倍添新。\n云压宫城重，风调玉漏匀。\n行游宜结辔，九陌未多尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和道粹雪夜直宿","author":"司马光","text":"天禄凝严近紫台，书帏夜对雪华开。\n层楼直倚寒空出，清漏还从深殿来。\n薄梦不成冰柱折，晓光先到玉花催。\n兔园终是诸侯事，虚费相如能赋才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和潞公与昌言正叔游独乐园徘徊久之主人不至","author":"司马光","text":"茂勋成亮采，胜赏寄风流。\n闲引翘林客，同为独乐游。\n厌居华宇盛，翻爱弊庐幽。\n愧不先操彗，迎尘立道周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和潞公真率会诗","author":"司马光","text":"洛下衣冠爱惜春，相从小饮任天真。\n随家所有自可乐，为具更微谁笑贫。\n不待珍羞方下箸，只将佳景便娱宾。\n庾公此兴知非浅，藜藿终难继主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史 其三","author":"司马光","text":"春风三阁上，珠翠日纷纷。\n乐饮陶江月，清歌遏海云。\n醉中失陈国，梦里入隋军。\n玉树庭花曲，凄凉不可闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史 其一","author":"司马光","text":"不事王侯者，翛然郑子真。\n开田谷口美，荷锸白渠春。\n德化移乡曲，声光动搢绅。\n一时钟鼎贵，磨灭彼何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史 其二","author":"司马光","text":"延陵腰利剑，上国使初通。\n待我周游遍，逢君遣奠终。\n晶荧系高树，萧瑟动寒风。\n谁敢欺生死，苍苍照尔衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏寒士","author":"司马光","text":"洋洋泌水侧，蓬室苦萧条。\n衣薄难胜夜，厨闲空过朝。\n笑谈东郭履，歌诵买臣樵。\n但问才何似，无疑卿相遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜发长垣","author":"司马光","text":"长涂暑气剧，永日卧邮亭。\n画伏如墙鼠，宵行似野萤。\n歇鞍沙月白，拂面柳风醒。\n历历瞻云汉，谁为二使星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉同运使陈殿丞惜洛阳牡丹为霜风所损","author":"司马光","text":"名花多种欲纷敷，一夕霜风非所虞。\n节物偶然何足道，人情遗恨不能无。\n飘飖健笔诗千首，惆怅东风酒百壶。\n纵使前春满朱槛，使车那复滞西都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉同道矩谢始平公惠砚","author":"司马光","text":"爵台今已倾，飘瓦出芜城。\n还入缣缃用，尤资笔墨精。\n相君怜古物，内史擅书名。\n聊用飞军檄，何愁楯鼻平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和始平公忆东平 其一","author":"司马光","text":"相印东临汶水阳，两看春叶与秋霜。\n登山置酒延邹湛，上马回鞭问葛强。\n溪竹低垂寒滴翠，露荷相倚净交香。\n宵衣深念长城固，肯得从容傲醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和始平公忆东平 其二","author":"司马光","text":"千岩秀色拥晴川，万顷陂光上下天。\n委地鱼盐随处市，蔽空桑柘不容田。\n讼庭虚静官曹乐，儒服宽长邑里贤。\n不为从知方负羽，独乘鱼艇老风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和始平公喜闻昌言修注","author":"司马光","text":"凤口除书下九阍，簪绅拭目仰殊恩。\n晓提麟笔依华盖，日就螭坳记圣言。\n桃李新阴方蔼蔼，骅骝老志更轩轩。\n主人喜见相如达，趣召邹枚洗玉樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和御制龙图等阁观三圣御书","author":"司马光","text":"积厚丕丕业，重光郁郁文。\n宝书垂列宿，玉字切浮云。\n散帙鸣銮驻，充庭杂佩分。\n愿移天纵艺，似续圣功勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景仁西湖泛舟","author":"司马光","text":"满船歌吹拂春湾，天外晴霞水底斑。\n谁信飞觞临绮席，独能回首望青山。\n东门车马匆匆别，西洛风烟寂寂闲。\n叠石溪头应更好，却输野叟坐林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"始平公以光得免使北赐之以诗谨依韵酬和","author":"司马光","text":"皇华将命得人难，专对非才辄自言。\n幸免驱车涉沙漠，尚容载笔侍宣温。\n不唯羞屈穹庐膝，无奈常游魏阙魂。\n衮职区区未能补，何时馀论奉清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"始平公新作双樗庵命光为诗","author":"司马光","text":"间气生王佐，多才秉国钧。\n栋隆凭杞梓，节劲仰松筠。\n底绩承平业，遗荣寿考身。\n结庐依散木，退让乐天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜甫东楼晚饮","author":"司马光","text":"宾主俱欢醉，高楼迥倚空。\n形忘羁检外，酒散笑谈中。\n晚市烟初白，秋园叶半红。\n登临不厌数，朝夕是寒风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忝职谏垣日负忧畏缅思云夫处士老兄萧然物外何乐如之因成浮槎诗寄献以抒鄙怀","author":"司马光","text":"秋水浮槎客，漂如一叶轻。\n鸥群须仗信，鲸口几忘生。\n耿耿天津阔，滔滔海浪惊。\n何时还故土，怀糈问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"或谓光嗤景仁谈禅而自谈又因用前韵为景仁解禅","author":"司马光","text":"贱子悟已久，景仁迷自今。\n良因拯溺急，是致涉波深。\n到岸何须筏，挥锄不见金。\n浮云任来往，明月在天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枇杷洲","author":"司马光","text":"周官敛珍味，汉苑结芳根。\n何意荒洲上，犹馀嘉树存。\n犯寒花已发，迎暑实尤繁。\n愿逐蒲萄使，离宫奉至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨","author":"司马光","text":"积雨欲侵旬，朝晡漫不分。\n苍凉微露日，惨澹已生云。\n地半成泥滓，天应厌垢氛。\n时闻度鸧鸹，空外自为群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"英宗皇帝挽歌辞三首 其三","author":"司马光","text":"谏省臣无状，龙鳞昔屡婴。\n恩深忘位贱，义重觉生轻。\n不正诛锄法，仍蒙奖叹荣。\n百身何足报，天造固难名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"英宗皇帝挽歌辞三首 其二","author":"司马光","text":"虹瑞流朱邸，童髦侍紫宸。\n简心天与子，授位帝知人。\n学古功时敏，钩深道日新。\n宜然三百载，民物仰威神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"英宗皇帝挽歌辞三首 其一","author":"司马光","text":"盛德师尧舜，英姿肖祖宗。\n太阳光遍照，沧海量兼容。\n鸿业知能继，齐民望可封。\n如何未五载，已上鼎湖龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎牢关","author":"司马光","text":"天险限西东，难知造化功。\n路邀三晋会，势压两河雄。\n馀雪沾枯草，惊飙卷断蓬。\n徒观争战处，今古索然空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗寄云夫处士老兄兼呈知府待制八丈","author":"司马光","text":"一鹗曾飞奏，中林下鹤书。\n今乘使君马，重到逸人居。\n松竹过从久，闾阎惠爱馀。\n只应棠树影，比旧更扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]