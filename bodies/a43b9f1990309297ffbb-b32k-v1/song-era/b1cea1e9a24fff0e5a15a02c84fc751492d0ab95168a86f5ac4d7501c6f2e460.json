[{"title":"笋 其二","author":"王禹称","text":"绿玉脩脩冷罩烟，一溪春雨洗婵娟。\n不知徐福归何处，丱女童男泣海田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笋 其一","author":"王禹称","text":"数里春蹊独自寻，迸犀抽锦乱森森。\n田文死去宾朋散，抛掷三千玳瑁簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史记列传","author":"王禹称","text":"西山薇蕨蜀山铜，可见夷齐与邓通。\n佞倖圣贤俱饿死，若无史笔等头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题三首 其三","author":"王禹称","text":"白头厌郎署，病眼欲分司。\n寸心犹未决，所顾在妻儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题三首 其二","author":"王禹称","text":"郑兴亲未葬，张籍眼多昏。\n何时解印绶，归去卧山村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题三首 其一","author":"王禹称","text":"贾谊因才逐，桓谭以谶疏。\n古今常似此，吾道竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得昭文李学士书报以二绝 其二","author":"王禹称","text":"左宦寂寥惟上洛，穷愁依约似长沙。\n乐天诗什虽堪读，奈有春深迁客家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得昭文李学士书报以二绝 其一","author":"王禹称","text":"谪居不敢咏江蓠，日永门闲何所为。\n为谢昭文李学士，劝教枕藉乐天诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望熊耳山","author":"王禹称","text":"谪居多与俗为邻，熊耳当门入望频。\n感谢双峰对双眼，也胜逢见等闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明感事 其一","author":"王禹称","text":"无花无酒过清明，兴味萧然似野僧。\n昨夜邻家乞新火，晓窗分与读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明感事 其三","author":"王禹称","text":"榆钱零落麦开芒，魂断南轩蝶影双。\n多谢东风相管顾，解将花片入书窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明感事 其二","author":"王禹称","text":"日转鞦韆影渐斜，忍闻弦管在邻家。\n儿童不惯贫滋味，刚拾榆钱索买花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼疾","author":"王禹称","text":"古人功业甘无分，往圣诗书合有缘。\n何事病来花满眼，祇将简策枕头眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阌乡旅夜","author":"王禹称","text":"行尽两京路，将登六里山。\n全家空洒泪，知是几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后登灵果寺阁","author":"王禹称","text":"雪引诗情不敢慵，来登高阁犯晨钟。\n山僧莫怪多时望，玉立南山万万峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜看竹","author":"王禹称","text":"梦断闲窗酒半醺，月华薄薄雪纷纷。\n莫言官散无拘束，一夜披衣见此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御书钱","author":"王禹称","text":"谪官无俸突无烟，惟拥琴书尽日眠。\n还有一般胜赵壹，囊中犹贮御书钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙娥峰后戏题","author":"王禹称","text":"为爱一峰形窈窕，岂辞十里路崎岖。\n谁知不似阳台女，别后经宵梦也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"畬田词 其一","author":"王禹称","text":"大家齐力斸孱颜，耳听田歌手莫闲。\n各愿种成千百索，豆萁禾穗满青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"畬田词 其三","author":"王禹称","text":"鼓声猎猎酒醺醺，斫上高山入乱云。\n自种自收还自足，不知尧舜是吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"畬田词 其五","author":"王禹称","text":"畬田鼓笛乐熙熙，空有歌声未有词。\n从此商于为故事，满山皆唱舍人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"畬田词 其四","author":"王禹称","text":"北山种了种南山，相助刀耕岂有偏。\n愿得人间皆似我，也应四海少荒田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"量移后自嘲","author":"王禹称","text":"可怜踪迹转如蓬，随例量移近陕东。\n便似人家养鹦鹉，旧笼腾倒入新笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"量移自解","author":"王禹称","text":"商山五百五十日，若比昔贤非滞留。\n试看江陵元相国，四年移得向通州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新月","author":"王禹称","text":"禁鼓楼头第一敲，弯弯新月上林梢。\n谁家宝镜新磨出，玉匣参差盖未交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"稠桑坡车覆","author":"王禹称","text":"稠桑坡险忽摧车，悔戴儒冠出敝庐。\n已被文章相错误，谪官犹载一车书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锡宴清明日","author":"王禹称","text":"宴罢回来日欲斜，平康坊里那人家。\n几多红袖迎门笑，争乞钗头利市花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阙题 其二","author":"王禹称","text":"不知鸣玉溪山下，何似仙娥水石间。\n免被寻常桃李妒，自开自落隐商山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"樱桃渐熟牡丹已凋恨不同时辄题二韵","author":"王禹称","text":"红芳落尽正无憀，吟绕空枝首重搔。\n最恨东君才思少，不留檀口待樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题响屧廊壁","author":"王禹称","text":"廊坏空留响屧名，为因西子绕廊行。\n可怜伍相终朝谏，谁记当时曳履声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钱塘县罗江东手植海棠","author":"王禹称","text":"江东遗迹在钱塘，手植庭花满县香。\n若使当年居显位，海棠今日是甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题滁州怀嵩楼","author":"王禹称","text":"昔是优贤地，今为省过州。\n非贤亦非过，醉卧怀嵩楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"磨诗","author":"王禹称","text":"但存心里正，无愁眼下迟。\n若人轻著力，便是转身时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠孙何丁谓","author":"王禹称","text":"三百年来文不振，直从韩柳到孙丁。\n如今便可令修史，二子文章似六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠草庵禅师","author":"王禹称","text":"阳山山下草庵深，寂寂香灯对远岑。\n莫怪相看总无语，坐禅为政一般心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕应制","author":"王禹称","text":"斜汉横空瑞气浮，桥边乌鹊待牵牛。\n长生殿冷时无事，乞巧楼多岁有秋。\n菡萏晚花清露湿，婵娟新月暮烟收。\n华封祷祝华胥梦，谁道神仙不可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和仲咸谑成口号以代优人之句","author":"王禹称","text":"就转专城喜气舒，开筵应待雨晴初。\n又淹駮正春坊笔，为重循良刺史车。\n事简郡斋唯捡药，夜长铃閤只看书。\n好倾官酝招闲客，篱畔金英尚有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和曾秘丞见赠 其一","author":"王禹称","text":"非才误受帝恩深，报国空存一片心。\n命薄任从官进退，道孤难与众浮沉。\n日边信断无归梦，滁上公馀且醉吟。\n劳寄新诗远相唁，野云何处望为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和曾秘丞见赠 其三","author":"王禹称","text":"箧中经岁锁朝衣，自觉心闲少梦思。\n失马叟言徒喻道，牧猪奴戏任争棋。\n且持使节安黔首，莫爱恩波沃漏卮。\n况是无功头已白，此身长恐负明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和曾秘丞见赠 其二","author":"王禹称","text":"谬因文字立虚名，寓直金銮冒宠荣。\n两度黜官谁是援，二毛侵鬓自堪惊。\n宫花谩役春来梦，山蕨聊供醉后羹。\n身外浮华尽闲物，不将穷达问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月廿七日偶作简仲咸","author":"王禹称","text":"一未量移一转勋，貂冠羊胃总非真。\n韶光祇有两三日，浮世稀逢七十人。\n青杏劝君重酌酒，牡丹邀我且寻春。\n请看富贵赵中令，已作北邙山下尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元夜作","author":"王禹称","text":"去年正月十五夜，乾元门上奉乘舆。\n今年正月十五夜，商洛郡中为贰车。\n谪宦门栏偏冷落，山城灯火苦萧疏。\n炉灰画尽不成寐，赖有逍遥一帙书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上寺留题","author":"王禹称","text":"松杉疏瘦簇山根，楼殿参差对郭门。\n不惜马蹄来北寺，为怜熊耳在西轩。\n云生石砌摇寒影，泉汲铜瓶露冻痕。\n迁客频来何所得，一丛修竹拂吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与嘉祐同游宝应寺","author":"王禹称","text":"滁阳领郡经三月，宝应游山始一回。\n屐齿免忧岩下折，簿书长苦案头堆。\n潾潾泉石吟魂健，漠漠烟岚病眼开。\n尽日引渠寻胜境，读碑看篆扫苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中元夜宿馀杭仙泉寺留题","author":"王禹称","text":"祭庙回来略问禅，苏墙莎径碧山前。\n风疏远磬秋开讲，水响寒车夜救田。\n蓝绶有香花菡萏，竹窗无寐月婵娟。\n自惭政术贻枯旱，忍卧松阴漱石泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中牟县旅舍喜同年高绅著作见访","author":"王禹称","text":"古县日初沉，轺车忽见寻。\n不将迁客累，方认故人心。\n无酒销寒漏，挑灯听远砧。\n郏郊千里路，并辔未妨吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月","author":"王禹称","text":"明可鉴秋毫，供吟属我曹。\n隔年方得见，终夕敢辞劳。\n冷向天心白，清临露掌高。\n霜台相照处，寒色满蓝袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月","author":"王禹称","text":"何处见清辉，登楼正午时。\n莫辞终夕看，动是隔年期。\n冷湿流萤草，光凝宿鹤枝。\n不禁鸡唱晓，轻别下天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丹河闲步","author":"王禹称","text":"谁爱潺湲到水滨，春来唯有我来频。\n沙边坐惯渔翁识，岸上行多白鸟驯。\n髭发照看添霰雪，冠缨濯后少埃尘。\n今秋更拟营蓑笠，冒雨冲风把钓纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为郡","author":"王禹称","text":"为郎为郡意何阑，羞拂朝缨盖病颜。\n赐笔任分双管赤，梳头已是二毛斑。\n道孤自合先归隐，俸薄无由便买山。\n出坐两衙皆勉强，此心长在水云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书孙仅甘棠集后","author":"王禹称","text":"新集甘棠尽雅言，独疑陈杜指根源。\n一飞事往名虽屈，六义功成道更尊。\n骨气向人蹲獬豸，波涛无敌泻昆崙。\n明年再就尧阶试，应被人呼小状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀送田二舍人自吏部郎中出典泰州","author":"王禹称","text":"共叹蹉跎两鬓苍，立朝为郡是寻常。\n重归谢客中书省，又送山涛吏部郎。\n三入承明身最忝，十年兄事分偏长。\n喜闻辞日留前席，莫算多时住水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀简孙何丁谓","author":"王禹称","text":"三入承明已七年，自惭踪迹久妨贤。\n吾子几时归凤阁，病夫方欲买渔船。\n季路旨甘知已矣，潘安毛鬓更皤然。\n举人自代何由得，归去东皋种黍田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书斋","author":"王禹称","text":"年年赁宅住闲坊，也作幽斋著道装。\n守静便为生白室，著书兼是草玄堂。\n屏山独卧千峰雪，御札时开一炷香。\n莫笑未归田里去，宦途机巧尽能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更睡","author":"王禹称","text":"数载直承明，宠深还若惊。\n趁朝鸡唤起，残梦马驮行。\n左宦离双阙，高眠尽五更。\n如将闲比贵，此味敌公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"今冬","author":"王禹称","text":"休思官职落青云，且算今冬养病身。\n白纸糊窗堪听雪，红炉著火别藏春。\n旋篘官酝漂浮蚁，时取溪鱼削白鳞。\n况是丰年公事少，为郎为郡似闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日作","author":"王禹称","text":"献岁在商州，依然想旧游。\n前年捧玉册，此日对珠旒。\n御酒尧樽畔，仙韶舜殿头。\n自惭非贾傅，宣室讵重求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公馀对竹","author":"王禹称","text":"冠褐飘飘乍退公，引吟留坐一丛丛。\n买添幽景浑无价，洗却繁阴别有风。\n曾任雪欺终古绿，也从桃映暂时红。\n此君合是吾庐物，会种婵娟伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公退言怀","author":"王禹称","text":"吏胥围绕簿书堆，病眼昏昏素发垂。\n已觉文章无用处，不归田里待何时。\n两衙决事官差我，五日延英诏问谁。\n赖有古人踪迹在，只应蘧宁是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内翰毕学士外制柴舍人故兵部阁老王公之门生又与第五厅舍人同在两制追思馀庆因赋短章寄于三君子","author":"王禹称","text":"掌贡司言耀圣朝，宦途屯否数难逃。\n雄文自贮胸中甲，直气谁防笑里刀。\n黄阁不登名甚屈，紫垣终老道弥高。\n君看身后荣多少，两制门生伴凤毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其六","author":"王禹称","text":"空留遗像在凌烟，谁继堂堂命世贤。\n将相位高三十载，风云道合一千年。\n霖收傅说岩前雨，石陨娲皇补后天。\n见说吾君举哀处，重瞳挥洒泪潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其七","author":"王禹称","text":"君恩虽听罢居留，官拜维师命更优。\n异物忽随黄石葬，晚年终负赤松游。\n凭谁借箸论归马，无复停车问喘牛。\n唯有功名书信史，肯同尘土一时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其五","author":"王禹称","text":"麟丧虚灵囿，凤衰空帝梧。\n陶镕存庶汇，霖雨润寰区。\n旧疏同伊训，遗章入禹谟。\n九原何所恨，犹未灭匈奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其一","author":"王禹称","text":"玄象中台坼，皇家上相薨。\n大功铭玉铉，密事在金縢。\n无复同鱼水，空嗟失股肱。\n若言丰沛旧，陪葬近长陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其四","author":"王禹称","text":"国丧三台首，家藏五庙尊。\n纪功谁秉笔，册赠帝临轩。\n盛德留千古，贞魂闭九原。\n皇情弥轸悼，天柱折昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其三","author":"王禹称","text":"重位经三入，高年过七旬。\n有言皆为国，无日不忧民。\n温树萧萧影，甘棠漠漠春。\n遥知神德庙，配飨更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其八","author":"王禹称","text":"曾拜四章辞相府，又陈三表罢留司。\n朝廷年德刘仁轨，终始功名郭子仪。\n印锁黄金尘暗澹，堂闲绿野草离披。\n吾君若念先朝旧，应似文贞御制碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其九","author":"王禹称","text":"忍听咚咚窆鼓声，笳箫呜咽暮云凝。\n勋劳自合同萧相，谥法还须比魏徵。\n晓月暗垂丹旐露，夜风轻触穗帷灯。\n三川父老知何限，尽逐灵輀泪满膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其十","author":"王禹称","text":"元老令终归葬日，有司重奏辍朝时。\n骈罗卤簿三公礼，告赴同盟五月期。\n何处更求廊庙器，是谁重作帝王师。\n商山副使偏垂泪，未报当年国士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太师中书令魏国公册赠尚书令追封真定王赵挽歌 其二","author":"王禹称","text":"经纬千年业，陶镕万物功。\n藩垣龙节在，禁掖凤池空。\n卤簿蒙寒雨，铭旌飏晓风。\n太常草仪注，全似葬周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太宗皇帝挽歌 其三","author":"王禹称","text":"日到虞泉落，天从杞国崩。\n去年寿宁节，今夕永熙陵。\n薤露悲风起，松阡苦雾凝。\n龙髯攀不及，千古恨难胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]