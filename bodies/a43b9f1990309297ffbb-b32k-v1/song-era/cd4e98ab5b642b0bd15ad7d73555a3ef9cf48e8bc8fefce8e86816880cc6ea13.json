[{"title":"摘玉堂红皱玉 其二","author":"刘克庄","text":"珍贵均摩勒，甘滋过醴泉。\n谓天不吾享，岂不厚诬天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春","author":"刘克庄","text":"燕子来时春事空，杖藜来往绿阴中。\n静怜朱槿无根蒂，开落惟销一阵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榕台二绝 其一","author":"刘克庄","text":"拔地高崖如铁色，拂天老树作寒声。\n他年记宿榕台夜，便是南归第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榕台二绝 其二","author":"刘克庄","text":"囊无金累贫如故，镜有丝生老柰何。\n一事尚堪誇北客，来时诗少去时多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榕溪阁","author":"刘克庄","text":"榕声竹影一溪风，迁客曾来系短篷。\n我与竹君俱晚出，两榕犹及识涪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其三","author":"刘克庄","text":"几树繁红映碧湾，苧萝山下见芳颜。\n分明消得黄金屋，却堕荒蹊野径间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其六","author":"刘克庄","text":"特以秾纤压众芳，痴人痴杀恨无香。\n问渠妩媚房栊里，何似庄严几研傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其五","author":"刘克庄","text":"梅太酸寒兰太清，海棠方可入丹青。\n赵昌骨朽徐熙死，谁写春风上锦屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其一","author":"刘克庄","text":"万蕊千葩染似红，停杯无语恨东风。\n薄寒且为花愁恼，何况开时值雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其八","author":"刘克庄","text":"归骑何须抵死催，且拈落蕊藉苍苔。\n平生酷喜坡长句，笔力今谁可夺胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其七","author":"刘克庄","text":"共倒残尊过日西，重来花事想参差。\n建阳主簿今才子，焉可无诗补杜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其十","author":"刘克庄","text":"海棠洞下醉忘归，岁月如驰不可追。\n想得千株今合抱，此生未卜再游时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其九","author":"刘克庄","text":"暮雨廉纤似入梅，一春花月欠攀陪。\n草生后圃深三尺，也道身为县令来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熊主簿示梅花十绝诗至梅花已过因观海棠辄次其韵 其二","author":"刘克庄","text":"红点霏霏似撒沙，荒园幻作五侯家。\n自怜改尽青青鬓，无力栽花且看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧波亭","author":"刘克庄","text":"了却文书上马迟，白蘋洲畔有心期。\n斜阳忽到传觞处，落尽梨花啼子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孺子祠","author":"刘克庄","text":"孺子祠堂插酒旗，游人那解荐江蓠。\n白鸥欲下还惊起，曾见陈蕃解榻时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午五言三首 其三","author":"刘克庄","text":"杂遝今观渡，依稀昔浴沂。\n居人空巷出，几个咏而归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午五言三首 其二","author":"刘克庄","text":"士女匆匆散，溪山寂寂然。\n龙舟闲似我，阁起向沙边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午五言三首 其一","author":"刘克庄","text":"绮纨贵家子，旗鼓少年场。\n屡舞众人醉，鲜妆一国狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其二十","author":"刘克庄","text":"秺侯世世袭蝉冠，庾氏人人筑将坛。\n但见门中俱贵盛，谁怜陛下最孤寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十九","author":"刘克庄","text":"元子置人防壁后，穰侯搜客到车中。\n鸩杯定不疑羊傅，匕首何曾害魏公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十八","author":"刘克庄","text":"苏卫灭胡同拜爵，裴韩平蔡亦联镳。\n祇今光范门前客，太半河阳幕下寮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十七","author":"刘克庄","text":"拥旄佩印各荣华，已贵无官可复加。\n若不扫门丞相府，必曾养马侍中家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十六","author":"刘克庄","text":"胡来如鬼去如风，哨骑何曾待枣红。\n岘首一春无使至，兴元六月在围中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十五","author":"刘克庄","text":"说向丁男与小姑，各勤耕织了军需。\n莫教塞北同文轨，却为江南减赋输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十四","author":"刘克庄","text":"蠲除一倍台符下，权借三分督檄传。\n赖已夺麾耕垄上，不然伏锧徇军前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十三","author":"刘克庄","text":"不妨割肉喂豺狼，和约依然堕渺茫。\n未必与吾盟夹谷，且须防彼劫平凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十二","author":"刘克庄","text":"一番旗鼓建行台，勇者投躯富辇财。\n边将不消横草战，国王祇要撒花回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十一","author":"刘克庄","text":"势穷斯变变斯通，局面初更便不同。\n西北怕他小老子，东南有个太平翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其十","author":"刘克庄","text":"全众回军未可非，反旗鸣鼓亦兵机。\n不知三帅扬鞭际，谁为君王殿后归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其九","author":"刘克庄","text":"倴僝将军约早回，楚材相国更频催。\n江东将相真如虎，去报胡雏莫过来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其八","author":"刘克庄","text":"鞠躬解作华人语，辫发来持虏帐书。\n祇合索绹牵畜狗，不烦伐鼓享鶢鶋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其七","author":"刘克庄","text":"苌尤桀点于坚者，勒固奸雄奈虎何。\n剩制赭袍添曲盖，中原假帝不胜多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其六","author":"刘克庄","text":"巩洛山川几过兵，汉家初遣使修陵。\n可无神物呵豺虎，直护香烟到柏城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其五","author":"刘克庄","text":"少年意气慕横行，不觉蹉跎过一生。\n便脱深衣笼窄袖，去参留守看东京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其四","author":"刘克庄","text":"不及生前见虏亡，放翁易箦愤堂堂。\n遥知小陆羞时荐，定告王师入洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端嘉杂诗二十首 其三","author":"刘克庄","text":"由北图南有混并，自南取北费经营。\n从今束起书生论，啖饭看人致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe529