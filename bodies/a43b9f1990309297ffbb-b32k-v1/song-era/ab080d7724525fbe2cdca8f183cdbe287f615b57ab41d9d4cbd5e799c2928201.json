[{"title":"郊行","author":"陆游","text":"小雨东郊气象新，萧萧清吹爽衣巾。\n并溪密竹巧藏寺，夹道新麻高没人。\n老厌簿书愁欲睡，病疏杯酌渴生尘。\n桐君山路无多远，元自知津莫问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行夜归书触目","author":"陆游","text":"老翁病起厌端居，随意东西不问途。\n霜野草枯鹰欲下，江天云湿雁相呼。\n空垣破灶逃租屋，青帽红灯卖酒垆。\n未畏还家踏泥潦，园丁持炬小儿扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行夜归有感","author":"陆游","text":"小市歌呼散，幽人悄独行。\n断鸿沙际冷，重露草根明。\n信古痴常绝，酬恩命本轻。\n还家掩屏卧，衰涕浩纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居二首 其二","author":"陆游","text":"索米官仓例坐愚，东方未可戏侏儒。\n行藏要付他年看，富贵真堪一笑无。\n等死不过赊岁月，长闲勿更问妻孥。\n狂豪尽道非平昔，老胆轮囷尚满躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居二首 其一","author":"陆游","text":"平生万事不容求，惟有郊居志已酬。\n更漏远城鸡唱晓，岁时无历叶知秋。\n潮生小舫行收荻，月落长歌起饭牛。\n已作幸民仍醉死，人间毁誉判悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采药","author":"陆游","text":"篢子编成细箬新，独穿空翠上嶙峋。\n丹砂岩际朝暾日，狗杞云间夜吠人。\n络石菖蒲蒙绿发，缠松薜荔长苍鳞。\n金貂谒帝我未暇，且作人间千岁身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金丹","author":"陆游","text":"子有金丹鍊即成，人人各自具长生。\n施行要使俗仁寿，收敛犹能心太平。\n剧饮似鲸身不倦，细书如蚁眼常明。\n更馀一事君难学，富贵真同涕唾轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金牛道中遇寒食","author":"陆游","text":"乍换春衫一倍轻，况逢寒食十分晴。\n莺穿驿树惺愡语，马过溪桥蹀躞行。\n画柱綵绳喧笑乐，艳妆丽服角鲜明。\n谁知此日金牛道，非复当时铁马声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金溪道中","author":"陆游","text":"云闇苦竹市，雨来乌石冈。\n驾犁双犊健，煮茧一村香。\n天地君恩重，风埃吏责忙。\n敢辞坡路滑，且领笋舆凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陌上","author":"陆游","text":"陌上长歌任笑狂，此生得丧略相当。\n天将耄齿偿贫悴，身坐虚名掇谤伤。\n溪水渐生朱舫活，野梅半落绿苔香。\n新晴快上兰亭路，莫待春残始一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"降魔","author":"陆游","text":"老阅人间久，曾降百万魔。\n悲忧诚害性，喜悦亦伤和。\n省事常须勉，忘怀得最多。\n当年未知此，无奈月明何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨二首 其二","author":"曾几","text":"薄晚初沾洒，清晨更惨悽。\n鱼寒抛饵去，鸦湿就檐栖。\n幽涧溅溅溜，长堤浅浅泥。\n一杯持自贺，吾事在锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"陆游","text":"映空初作茧丝微，掠地俄成箭镞飞。\n纸帐光迟饶晓梦，铜炉香润覆春衣。\n池鱼鱍鱍随沟出，梁燕翩翩接翅归。\n惟有落花吹不去，数枝红湿自相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"陆游","text":"晓望横斜映水亭，暮看飘洒湿帘旌。\n不嫌平野苍茫色，实厌空阶点滴声。\n上策莫如常熟睡，少安毋躁会当晴。\n且将穑事传童稚，未插秧时正好耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"陆游","text":"家近蓬莱白玉京，草堂登望不胜清。\n初惊野色昏昏至，已见波纹细细生。\n残醉顿消迎乱点，微吟渐苦入寒声。\n只愁今夕虚檐滴，又对清灯梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夕枕上作","author":"陆游","text":"鬓毛日夜雪霜稠，冉冉年光逝肯留。\n酒力但资愁作祟，雨声偏与睡为仇。\n铭旌官职眼前事，史册姓名身后忧。\n毕竟此生何处是，江湖万里有孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夕独酌书感","author":"陆游","text":"数掩芦藩常不开，饥鸦两两啄青苔。\n雨来十日未成雪，岁尽一枝初见梅。\n池上晚行携独鹤，灯前夜酌拨新醅。\n渔村老景今如许，骏马旧游安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夕排闷二首 其二","author":"陆游","text":"烟雨暗郊墟，颓然卧草庐。\n虫喧梦回枕，灯伴读残书。\n短褐频关念，荒畦久废锄。\n更堪湖水涨，累日食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨夕排闷二首 其一","author":"陆游","text":"买牛耕剡曲，举世笑迂疏。\n流落愈忧国，衰残犹读书。\n滔滔安税驾，耿耿独愁余。\n破屋秋多雨，情怀用底摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中小酌","author":"陆游","text":"晨起占云日日西，吾庐烟雨正凄迷。\n愁看场上禾生耳，且泥杯中酒到脐。\n窗日几时飞野马，瓮天惟是舞醯鸡。\n前村著屐犹通路，自摘金橙捣鲙齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中出门闲望有作","author":"陆游","text":"急雨初来已泻檐，清香欲散更穿帘。\n年开九秩尚不死，坐对一编殊未餍。\n人笑黠痴俱得半，自怜贫病每相兼。\n说梅古谓能蠲渴，戏出街头望酒帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中出谒归昼卧","author":"陆游","text":"宿雨盈车辙，秋风涨帽裙。\n爱闲惟兀兀，应俗苦纷纷。\n病眼添花晕，酡颜散缬纹。\n归来炷香卧，窗底看微云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中出游夜归","author":"陆游","text":"小雨南山路，今朝思出游。\n难从子规请，宁遣竹鸡忧。\n野店寒饶柿，烟津晚唤舟。\n归来对灯火，未恨湿衣裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中示子聿","author":"陆游","text":"穷阎父子自相依，寂寂茅庐映竹扉。\n瓜蔓水生初抹岸，楝花寒动却添衣。\n吾玄自笑岂尚白，汝瘦元知能胜肥。\n苦学勿为干禄计，宦途虽乐不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中买酒镜湖酒楼","author":"陆游","text":"阴风号大泽，暮雨上高楼。\n愁忆新丰酒，寒思季子裘。\n登临天地迮，老病岁时遒。\n安得急装去，北平防盛秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中至西林寺","author":"陆游","text":"胸中荆棘费锄耘，正藉幽寻暂解纷。\n不尽长江来画玉，半空飞阁对凌云。\n昏昏横霭凭轩见，杳杳疏钟隔岸闻。\n珍重山僧迎客意，螭奁一缕起微熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中过东村","author":"陆游","text":"小雨空濛物象奇，偶扶藤杖过东陂。\n垫巾风度人争看，蜡屐年光我自悲。\n穷鬼有灵挥不去，死魔多力到无期。\n归来笑向应门说，且了浮生一首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"山雨时时急，溪流日日添。\n湿苔缘暗壁，腐瓦落颓檐。\n老至那容却，狂来未易砭。\n泥深村路绝，烟树出青帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"湖曲雨凄凄，茆檐触额低。\n衡门元少客，穷巷况多泥。\n解渴黄粱粥，尝新白苣齑。\n吾生真自足，不恨老锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"雨声一滴不肯住，客梦欲成还自惊。\n白水陂边破茅屋，乱书堆里老儒生。\n出行岂复有流辈，未死尚能躬钓耕。\n十日无鱼亦何叹，新菰幸可配吴粳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作三首 其一","author":"陆游","text":"三日雨频作，昏昏饶睡眠。\n泥深散酒市，风恶恼灯天。\n茅屋松明照，茶铛雪水煎。\n山家自成趣，抚枕寄悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作三首 其二","author":"陆游","text":"淅淅连江雨，愔愔一室幽。\n茶甘留齿颊，香润上衣裘。\n泥滓将雏鸭，林樊唤妇鸠。\n短章虽漫兴，聊足散吾愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"社瓮醅香燕子归，阴风吹雨暗郊扉。\n疏沟园叟方携锸，采药蛮童已湿衣。\n山雉尾垂冲霭去，水鸡翅重蹋波飞。\n凭阑一笑君知否，肺渴秋来势渐微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"础润云生五月中，山城细雨晚空濛。\n读书虽恨此身老，把酒尚思吾辈同。\n积润画图昏素壁，渍香衣帻覆熏笼。\n新晴不用占钟鼓，卧听林梢淅淅风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作三首 其三","author":"陆游","text":"短鬓白如丝，梅花似旧时。\n掩屏愁入梦，隐几雨催诗。\n病为阴天剧，春缘闰岁迟。\n非关畏车马，衰甚实难支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"野外偏于看雨宜，映空渡水细如丝。\n川云借润支琴石，涧水分流洗药池。\n未肯高眠成老态，却缘危坐得新诗。\n悠然更助邻丁喜，渐近收荞下麦时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中作","author":"陆游","text":"空濛初喜洒檐楹，忽听空阶点滴声。\n高枕便知宜夕睡，丰年不叹负春耕。\n多情幽草沿墙绿，无赖群蛙绕舍鸣。\n屈指清秋两旬近，却愁徂岁又峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中别同朝诸公二首 其二","author":"陆游","text":"雨点万珠落，水声群马奔。\n才能脱危路，未遽定惊魂。\n一扫枕中梦，即归江上村。\n村醪莫嫌薄，随事有鸡豚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中别同朝诸公二首 其一","author":"陆游","text":"今日别交旧，街泥盈尺深。\n极知当作恶，追恨阙相寻。\n笑语关幽梦，江山入苦吟。\n新秋才一月，留句待清砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中卧病有感","author":"陆游","text":"病卧穷山白发新，不堪风雨过中春。\n歌呼空倚一尊酒，零落渐无吾辈人。\n千载诗书成长物，两京宫阙委胡尘。\n非熊老子不复见，谁吊遗魂清渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中泊舟萧山县驿","author":"洪适","text":"端居无策散闲愁，聊作人间汗漫游。\n晚笛随风来倦枕，春潮带雨送孤舟。\n店家菰饭香初熟，市担莼丝滑欲流。\n自笑劳生成底事，黄尘陌上雪蒙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中泊赵屯有感","author":"陆游","text":"归燕羁鸿共断魂，荻花枫叶泊孤村。\n风吹暗浪重添缆，雨送新寒半掩门。\n鱼市人烟横惨淡，龙祠箫鼓闹黄昏。\n此身且健无馀恨，行路虽难莫更论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中独酌","author":"陆游","text":"僻郡荒山下，高斋寒雨中。\n微波生酒绿，短焰拥炉红。\n学废悲身老，民穷祝岁丰。\n厨人羞雉兔，更忆唤邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中宿石帆山下民家","author":"陆游","text":"老觉山行倦，闲便水宿幽。\n雨泥看放鸭，烟草听呼牛。\n槃箸烦频劝，窗扉喜小留。\n馀年竟何事，高枕送悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中排闷","author":"陆游","text":"润入盆山绿叶稠，倦摊书帙小窗幽。\n浮云不卷时时雨，薄酒无功日日愁。\n积潦涨来妨蹑屐，好山遮尽罢登楼。\n青秧摇荡湖堤决，一饱前知未易谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中睡起","author":"陆游","text":"磔磔寒禽无定栖，纤纤小雨欲成泥。\n松鸣汤鼎茶初熟，雪积炉灰火渐低。\n一气推移均野马，百年蒙覆等醯鸡。\n青山黄叶兰亭路，忆唤邻翁共架犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中遣怀","author":"陆游","text":"秋稼连云饱不疑，宁期一败莫支持。\n雨如梅子初黄日，水似桃花欲动时。\n正昼蚊虻驱不去，终宵蛙黾怒何为。\n凶年气象堪流涕，禾把纷纷满竹篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中遣怀二首 其二","author":"陆游","text":"霏霏春雨细如丝，正是春寒欺客时。\n心向宦途元淡薄，梦寻乡国苦参差。\n楼前新涨绿三尺，墙外尚馀红几枝。\n摆拨簿书呼酒榼，南湖西塔有幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中遣怀二首 其一","author":"陆游","text":"病中草草度年华，睡起匆匆日易斜。\n抵死愁禁千斛酒，薄情雨送一城花。\n镜湖烟水摇朱舫，锦里香尘走钿车。\n此梦即今都打破，不妨寂寞住天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨止顿寒遂有晴意","author":"陆游","text":"雾雨昏昏地气腾，盘中朝暮厌驱蝇。\n未看霁色排阴翳，先觉清寒洗郁蒸。\n唤客喜倾新熟酒，读书贪趁欲残灯。\n明朝乐事真当贺，山北山南曳瘦藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后","author":"陆游","text":"甘澍慰群望，浮云还故墟。\n新凉生枕簟，馀润入犁锄。\n帘上翩翩燕，蒲新鱍鱍鱼。\n素秋犹半月，团扇意先疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后二首 其一","author":"陆游","text":"小筑涛江外，微凉暑雨馀。\n倾囊致欢伯，信脚到华胥。\n芳草翩翩蝶，清池泼泼鱼。\n此翁虽耄矣，作计未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后","author":"陆游","text":"础润还成雨，云收旋作晴。\n岩花分日发，林笋逐番生。\n笔砚行常具，轩窗晚更明。\n尘埃幸不到，那得废诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后二首 其二","author":"陆游","text":"一夜茅檐雨，晨兴乃尔凉。\n禽鱼皆遂性，草木自吹香。\n微润生琴荐，纤尘避笔床。\n悠然北窗兴，真欲傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后出门散步二首 其二","author":"陆游","text":"病叶常先霣，寒潮只暗生。\n扶衰赖药石，随意出柴荆。\n细路牛栏湿，疏篱绩火明。\n枯荣不须计，千古一棋枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后出门散步二首 其一","author":"陆游","text":"细水穿沙溜，残云扶雨归。\n不成游酒市，且作倚渔扉。\n老大徂年速，羁穷壮志违。\n破裘虽百结，犹胜泣牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后至近村二首 其一","author":"陆游","text":"夜雨晓方止，朝云犹作阴。\n山馀一寸碧，溪长半篙深。\n卧泛白鸥渚，行穿黄叶林。\n老农能共语，真率会人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后至近村二首 其二","author":"陆游","text":"年耄身犹健，秋高疾已平。\n邻翁思问讯，蔬圃要巡行。\n竹杖轻无迹，芒鞋捷有声。\n相逢无别语，努力事冬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后过近村","author":"陆游","text":"赋罢渊明归去来，纻衣桐帽一时裁。\n岁华新笋初成竹，天气停云未断梅。\n江路醉归常嵬峨，僧窗闲过即徘徊。\n老人剩有凋年感，寄语城笳莫苦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后快晴步至湖塘","author":"陆游","text":"齿豁从教道字讹，负薪陌上且行歌。\n古人亦自逢时少，吾辈何疑忤俗多。\n山扫黛痕如尚湿，湖开镜面似新磨。\n亦知大有掀髯处，无奈西流白日何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后复小雪","author":"陆游","text":"雨雪来无已，冬春忽欲交。\n贱贫安淡薄，老钝耐讥嘲。\n村酒儿能取，农书手自钞。\n莫年真个懒，屋漏旋添茆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后绝凉偶作","author":"陆游","text":"槐阴日色薄，桐叶雨声长。\n林下有馀适，城中无此凉。\n浮瓜寒水碧，斸药小锄香。\n未许陶潜达，华簪何足忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后凉甚","author":"陆游","text":"并海宽闲野，清秋摇落天。\n微凉供美睡，稳字入新联。\n陋屋萧萧雨，修筒细细泉。\n晚窗生酒兴，洗酌一陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后殊有秋意","author":"陆游","text":"天地新秋入苦吟，诗书万古付孤斟。\n爱君忧国孤臣泪，临水登山节士心。\n只叹鼻端无妙斲，岂知弦外有遗音。\n剡中胜践今犹昔，安得高人支道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后寒甚","author":"陆游","text":"陂泽连山脚，风烟接海滨。\n孤鸿悲远客，残菊伴陈人。\n酒尽瓶枵腹，炉寒客曲身。\n老翁殊耐事，一笑自回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后登西楼独酌","author":"陆游","text":"老觉人间无一欣，强寻高处看归云。\n天空列嶂开图画，水落寒江学篆文。\n四海道途行大半，百年光景近中分。\n交游赖有曲生在，正向愁时能策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后集湖上","author":"陆游","text":"野水交流自满畦，芳池新涨恰平堤。\n花藏密叶多时在，莺占高枝尽日啼。\n绣袂宝裙催结束，金尊翠杓共提携。\n白头自喜能狂在，笑襞蛮笺落醉题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]