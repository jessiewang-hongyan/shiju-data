[{"title":"再和入省宿","author":"苏颂","text":"雕龙辞辨干时才，重赞甘泉屈壮怀。\n被拥绫香归汉直，食荤忘茹似颜斋。\n休嗟簿领书堆案，况是鸿鸾序渐阶。\n公论共推资望久，春云高步信难排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和三篇 其三","author":"苏颂","text":"兵厨酿酒宅连池，为郡优悠每自知。\n铃下文移归幕府，案前颐指走签师。\n农桑课罢聊行乐，朱墨閒来好序棋。\n饱食将何报丰禄，歌时惟咏阜财诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和三篇 其二","author":"苏颂","text":"闻君八法擅临池，擪押工夫世少知。\n学者伏膺虞秘监，时贤求范永禅师。\n流传异日须悬帐，交质何人敢对棋。\n敛手姜芽柳家样，解嘲几困老刘诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和三篇 其一","author":"苏颂","text":"莫叹潜鳞久在池，已喧才誉满朝知。\n雄辞自可吞云梦，博识应能对仲师。\n荣辱早谙真采选，竞谦不校古儒棋。\n使还即见金门召，况有中和乐职诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和暮春","author":"苏颂","text":"黄莺初啭燕新还，林馆清虚景未阑。\n瓮拨金膏倾腊脚，封开绿绢试春团。\n条风吹笋苞犹嫩，谷雨催花色渐乾。\n若待休閒频宴集，牵拘人事恐多般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再酬三次前韵","author":"苏颂","text":"千里江山昔霸基，百年文物憺皇威。\n闾阎栉比于今盛，塔寺鳞差自古稀。\n极目烟霞时显晦，忘情鱼鸟自潜飞。\n何须远慕岩居者，乘兴还来兴尽归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同吕缙叔诸君寄怀希用师","author":"苏颂","text":"方袍为佛者，学术以儒兼。\n迹慕山林逸，心从典籍潜。\n白云中寄趣，浮世外安恬。\n遐想观书室，焚香正下帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同事閤使见问奚国山水何如江乡以诗答之","author":"苏颂","text":"奚疆山水比东吴，物色虽同土俗殊。\n万壑千岩南地有，扁舟短棹此间无。\n因嗟好景当边塞，却动归心忆具区。\n终待使还酬雅志，左符重乞守江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吏部顿郎中起陆尚书佃与同年因迎哲宗神主集班西苑追思昔预闻喜逮今三十一年再至感旧赓唱长言远垂寄示老病读之不觉感叹强次前韵以答嘉贶","author":"苏颂","text":"集英亲策际天人，曾见诸贤解褐巾。\n荐棘校文钦藻思，华林颁宴接车尘。\n年光世故推移久，士论朝咨宠遇新。\n老病忽纡怀旧作，长吟犹忆曲江春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行新馆道中","author":"苏颂","text":"经旬霜雪倦晨征，重到胡疆百感生。\n日上东扶千嶂影，风来空谷万号声。\n人心自觉悲殊土，物色偏能动旅情。\n况是天恩怀景俗，不妨游览趁严程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次行奚山","author":"苏颂","text":"奚山缭绕百重深，握节何妨马上吟。\n当路牛羊眠荐草，避人鸟鹊噪寒林。\n羸肌已怯旃裘重，衰鬓宁禁霜雪侵。\n独爱潺湲溪涧水，无人知此有清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刁景纯学士将至郡见寄","author":"苏颂","text":"偃伏声名三十年，当时伦辈有谁前。\n曾随贡籍逢标鉴，更向词林接俊躔。\n上馆久违牵梦寐，归舟将至想神仙。\n襟怀旷达应如旧，迟对清尊一问焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵久雨言怀","author":"苏颂","text":"久雨涔■浃甸圻，层云晻暧压城低。\n沈灰将恐蛙生灶，负土深防蚁漏堤。\n避冷竹窗烘炭兽，祷晴琳馆抗旌霓。\n知君方欲行千里，早晚残霞却照西。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻锁院赐酒烛","author":"苏颂","text":"暮召从容对浴堂，归来院吏写宣忙。\n郢醪独赐尊常满，龙烛初然泪有香。\n起草才多封卷速，把麻人众引声长。\n百官班里听恩制，争诵雄文出未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孔学士密云龙茶","author":"苏颂","text":"精芽巧制自元丰，漠漠飞云绕戏龙。\n北焙新成圆月样，内廷初启绛囊封。\n先春入贡来千里，中使传宣下九重。\n自省何功蒙上赐，青蒿应为倚长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵开府太师留别诸公","author":"苏颂","text":"经济才谟沛有馀，幡然高谢意何如。\n青云路尽寻归鞅，绿野堂成忆旧庐。\n汉苑宴游联魏丙，邺都宾客记应徐。\n他时若到城南第，入副宸衷对绮疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王正仲蒲传正二月十五日奉祠高禖二首 其二","author":"苏颂","text":"涤牢宫醴被禋时，物吐华心睡景迟。\n禁掖嘉祥开覆燕，祠官先兆应维罴。\n阳郊类帝重封土，宣室思贤正受釐。\n天锡子孙千亿报，年年玉叶长新枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王正仲蒲传正二月十五日奉祠高禖二首 其一","author":"苏颂","text":"视草名臣奉汉祠，祝禖才胜长卿迟。\n诗成雅类占宜芾，乐阕欣同梦射罴。\n宫殿肄仪临百子，神明歆德荐三釐。\n凌晨拜胙归天阙，杲日煌煌照上枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王伯益同年留别二首 其一","author":"苏颂","text":"桂籍昔叨联署等，莲帷今幸接芳尘。\n埙篪契合均天属，金石交深过古人。\n直向岁寒期茂悦，肯同时俗论甘辛。\n优游且作江南令，惠爱于民此最亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王伯益同年留别二首 其二 再次前韵","author":"苏颂","text":"从宦飘飘九见春，共嗟名迹尚埃尘。\n相逢梁苑留趋幕，不鄙池阳去长人。\n蚤向文科分甲乙，尝于命历校庚辛。\n穷通定分非婴虑，惟有交情久益亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王都尉团练押赐高丽归使宴射赠馆伴舍人兼呈诸公","author":"苏颂","text":"通侯年少侍中郎，主客名园满国香。\n赐酒九行勤貊使，一帆千里送吴航。\n鸣弦屡奏前筹捷，摛藻俄传秀句长。\n更与诗翁相属和，骊珠数百透函光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘叔贡舍人从驾","author":"苏颂","text":"鳌头星掖贵兼清，不似南宫散六卿。\n继踵棣华联禁直，并时兰玉占高名。\n甘泉法从皆才杰，皇祐孤臣独老生。\n自叹荆枝半凋落，若论宗戚亦沾荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘莘老学士惜别言怀兼呈次中察院二首 其二","author":"苏颂","text":"诗侣方逢梦与微，摅怀未尽遽言归。\n正思玉鲙将登俎，应笑缁尘又染衣。\n金石交情知不改，辅车形体自相依。\n何时得遂江湖乐，薄宦牵羁甚纆徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘莘老学士惜别言怀兼呈次中察院二首 其一","author":"苏颂","text":"梁园寒早雪霏微，亲友将分一棹归。\n客舍萧条风送柳，离筵凄惨酒沾衣。\n霜台二妙君相继，幕府三端我所依。\n况是汴渠今不涸，留连犹得奉音徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孙莘老司谏见寄","author":"苏颂","text":"虽非文史足三冬，岂类无心但有胸。\n曾读丘坟叨典领，再分符竹荷矜容。\n君恩欲报微萤爝，亲禄方营苟釜钟。\n平日交情今楚越，徒劳瞻望景山松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵次中寄莘老学士","author":"苏颂","text":"曾见台乌朝夕飞，尚稽双凤浴天池。\n远方随牒应难久，同好弹冠即有期。\n佐幕暂来光右席，还家聊去植芳篱。\n睢阳老尹钦才望，待看同升赞盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵江南感事","author":"苏颂","text":"京洛倦游后，江南感慨多。\n壮怀伤岁月，醉眼小山河。\n无路通谈说，穷年谩揣摩。\n知音如有遇，终采击辕歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵阳行先游招隐","author":"苏颂","text":"古屋萧森数十间，禅扉幽寂叩常关。\n少微处士遗尘远，灵鹫高僧得地閒。\n穿石到池泉滴滴，磨崖生藓字斑斑。\n山林真趣谁能辨，乘兴时来兴尽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵阳孝本游翟家湾书院二首又一绝 其一","author":"苏颂","text":"淮上陂陀百亩冈，谁言形势占高强。\n郊居拟卜东阳宅，屋壁将营阙里堂。\n四面松篁分种艺，百家图籍待收藏。\n何人欲课三冬学，向此潜心事素王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵阳孝本游翟家湾书院二首又一绝 其二","author":"苏颂","text":"翟市西傍一径开，偶携亲友陟崔嵬。\n莫言第舍衡门陋，已有仙翁步屧来。\n日欲衔山回返照，风还吹雨压浮埃。\n才归便得诗盈轴，气猛才豪岂易陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋次道庆黄安中李邦直二舍人皆自史院拜命","author":"苏颂","text":"右垣更直宠新班，便坐通名听别宣。\n词训已高长庆代，事权不下永明年。\n除官草罢诸番制，执简研馀万岁烟。\n曾向兰台陪笔削，喜闻严近擢班迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋次道学士重过礼院","author":"苏颂","text":"斋居永日坐重帘，共叹清才久滞淹。\n诗格转精缘大手，风情不薄早斑髯。\n曲台论议于今美，东观翻雠载世兼。\n孤学尸官犹有赖，繄君馀润远相沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李希荀寄念七侄庄并用前韵和十七侄彀送其行 其一","author":"苏颂","text":"初从童丱祝千春，俄见骞腾祝更频。\n已喜吏资能可问，又嘉文笔速如神。\n室堂宜念承先构，乡里须教号善人。\n我待儿曹上霄汉，便归林下岸仙巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李希荀寄念七侄庄并用前韵和十七侄彀送其行 其二","author":"苏颂","text":"里闬相从秋复春，矜怜几类党频频。\n摛词已识言浮物，学艺兼知义入神。\n纵使声名高世俗，直须慈惠及生人。\n吾家自有青毡在，岂羡林宗垫角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨立之十一官府馆二篇 其二","author":"苏颂","text":"楚客登临悲素秋，感时风物自飕飕。\n潦收远水清堪鉴，雨过群山翠欲浮。\n月露往来羁旅恨，仓箱千万里民讴。\n鬓毛衰飒欢游少，珍重嘉篇写我忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨立之十一官府馆二篇 其一","author":"苏颂","text":"固无政术效前贤，又乏诗名继乐天。\n连岁出藩居善地，何时负郭有良田。\n回风已隔三山路，讲德难偕四子篇。\n满目胜游都未到，且将图画与人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨立之观韵海","author":"苏颂","text":"六学先声病，群书欲备详。\n摛文资引据，结字辨偏旁。\n篆楷颜毫妙，编联蜀纸光。\n残篇虽脱落，犹可挹遗芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨立之怀旧","author":"苏颂","text":"秋卷昔观宾，同游上苑春。\n归轩今取道，共食浙江珍。\n俛仰周三纪，文章了十人。\n穷通不复问，一以付天均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨立之赠京","author":"苏颂","text":"小子方承学，初心未见功。\n雕虫徒好赋，舞象仅成童。\n率尔多惭路，师哉远慕雄。\n颛侗如可教，丈席冀趋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈元舆待制新怀州吕侍讲见寄","author":"苏颂","text":"缮性虽知众射标，颓年无奈羽谯谯。\n覃怀新守纡高旆，宁海元侯驻累乔。\n忆拟曹鞭涡水赋，尝陪戴席德阳朝。\n郡斋继日听馀论，不复牢愁咏大招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵兖弟忠懿王祠","author":"苏颂","text":"五君相继擅吴方，坐视群雄取乱亡。\n侍子奔驰先入贡，邻邦旅拒独勤王。\n岂惟佛刹传遗像，自有孙谋袭懿芳。\n应似窦融归汉日，功名累世到瑰章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和前漳守马郎中三篇 其三 续观潮","author":"苏颂","text":"江皋空阔见东溟，两讯潮随远近生。\n夹岸炎天迷雪岭，居人晴日骇雷声。\n客帆朝暮乘风去，渔罟东西逐浪行。\n尽道波神久恬静，应缘四海正清平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和前漳守马郎中三篇 其一 游山","author":"苏颂","text":"西山高下极深幽，十里清波一棹游。\n喜逐御风真造适，遍题僧壁更迟留。\n松间觅径因穷险，亭际披云尽露秋。\n却羡官閒无检束，徜徉何异五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和前漳守马郎中三篇 其二 碧波亭感事","author":"苏颂","text":"华堂直北望云烟，劳远勤归此待贤。\n下榻喜逢徐稚至，登舟常羡李膺仙。\n知君将奉三年最，感旧曾歌一夜怜。\n红粉若能留客醉，不辞飞盏共陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和宣甫叔父迁谪过都见寄","author":"苏颂","text":"解组从戎五筦城，壮谋期欲荡蛮腥。\n数奇不意同飞将，肺腑何因学卫青。\n报国有心犹慷慨，谪官无闷但沈冥。\n竹林此日重相过，高论时欣侧耳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和钱穆甫答签判殿丞临安道中作","author":"苏颂","text":"吴越开基旧土疆，鉴山仍是种瓜乡。\n七朝赐履加尊宠，五世苴茅奉宪章。\n里社依然题昼锦，昆云不绝佩鞶囊。\n人怀馀德能封殖，犹有当时似盖桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉和次中叙别","author":"苏颂","text":"嘉句连篇惠好音，愧无琼玉报南金。\n几年漂泊离群恨，此日逢迎话旧心。\n气类自应怜茂悦，世情谁复拟高深。\n且将怀抱还尊酒，莫为思归动越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉酬通判姚郎中宴望湖楼过昭庆院暮归偶作","author":"苏颂","text":"山半楼台绕曲堤，水风当夏却炎威。\n常思遍览前朝迹，自恨劳生暇日稀。\n偶到上方凭槛久，恍如员峤蹑云飞。\n白莲旧社空遗址，有几人从此路归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉酬签判吕殿丞燕集西湖","author":"苏颂","text":"江海为藩地绝尘，湖山寻胜坐邀宾。\n消除袢暑忘三伏，追忆曾游隔五春。\n极望林峦横紫翠，旋供肴核剥青皴。\n常时欲到喧嚣阻，偶得相陪似宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林次中九日都下感事二首 其二","author":"苏颂","text":"登高能赋属诗家，况值嘉辰对菊花。\n乍感商飙流素籥，故摛鸿藻艳春华。\n边关礼命行看至，淮海归期亦有涯。\n早晚霜寒侵旅榻，又悬复帐换青纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林次中九日都下感事二首 其一","author":"苏颂","text":"桃杏初开已去家，又逢兰菊绽新花。\n感时谩缀茱萸佩，惜别应怜棠棣华。\n迢递宦游来日下，悠扬归思绕天涯。\n一尊重到平津閤，惆怅文窗旧绿纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林次中察院经过南都见寄","author":"苏颂","text":"都府曾为入幕宾，玉符重忝守藩臣。\n几年流落甘閒散，平日交游半要津。\n簿领沉迷千虑耗，鬓颐衰飒二毛新。\n圣恩休养深知幸，厚禄华堂许便亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵姚倅正月三日游山道中口占","author":"苏颂","text":"车马西郊踏晓光，城隅一径绕羊肠。\n泉流带雪添膏脉，山色逢春变郁苍。\n云外楼台晴挂影，风前松桧远飘香。\n仁祠久祷蒙嘉应，预庆农畴岁袭祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵柳郎中二咏 其一 地炉","author":"苏颂","text":"蒲条围坐雪添瓶，侧理糊窗炽炭明。\n常对图书堆四壁，却思裘褐胜双旌。\n道心生后安休息，事局閒来怕践更。\n睡足定应输杜守，穷愁何必学虞卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵柳郎中二咏 其二 纸帐","author":"苏颂","text":"百幅敲冰密属连，寝甘谁复诮便便。\n心閒好隐忘言几，官冷宜铺坐客毡。\n乌布任宽忘道韵，绛纱徒侈怯霜天。\n休嗟抛掷缣绫贵，据榻犹胜枕杫眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵敖侄书怀","author":"苏颂","text":"传家累世奉遗经，窃禄清朝足代耕。\n虽是丹心比葵藿，其如黧貌点冠缨。\n时乎易失年加我，来者安知畏后生。\n戒饬尔曹惟道术，逢辰须用佐安平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晁美叔游山见寄","author":"苏颂","text":"已践修涂到急流，暂回俗驾喜同游。\n名为外物知难必，学悟无生信若浮。\n骚雅深情追李杜，林泉高兴拉巢由。\n迟留更爱灵峰境，青桂风来不待秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵致政华殿丞怀旧见寄","author":"苏颂","text":"佩韘相从四纪前，鲤庭论契荷忘年。\n文如潘陆倾江海，学造重黎绝地天。\n簪绂弃来名已厌，乡闾归后乐应全。\n冥飞尚隐樊笼旧，未副初心愧昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵诸公从驾景灵宫二首 其二","author":"苏颂","text":"太清宫庙近蓬莱，连日天门六扇开。\n万乘旌旗冲晓过，两宫舆辇诘朝来。\n城中三水河通汉，庭下千官棘映槐。\n老稚扶携同祝圣，年年常此望昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵诸公从驾景灵宫二首 其一","author":"苏颂","text":"青鹓如跂万椽匀，地接璇流隔世尘。\n三后在天歌下武，一人膺福见君陈。\n珠旒漆漆怀濡露，玉案年年侍荐新。\n庑下丹青从臣列，左趋萧丙右甘辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵祷雪有感","author":"苏颂","text":"终过元朝欲首春，条风先度海东门。\n寒凝一雨成飞雪，泰长三阳应上坤。\n疵沴渐消和气满，咏歌频发味言温。\n人情共喜年光好，不向樽前未易论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵曾子固舍人上元从驾游幸","author":"苏颂","text":"雪霁蓬莱瑞景新，槐枫迎日丽重宸。\n钟残长乐千门晓，辇过章街九陌春。\n星列从官齐拱极，风驱前跸旋清尘。\n一篇未易歌鸿业，三愿还将祝圣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]