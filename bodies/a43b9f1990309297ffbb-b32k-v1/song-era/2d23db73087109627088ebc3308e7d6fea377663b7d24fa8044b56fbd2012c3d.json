[{"title":"吴提干之官浙东","author":"释居简","text":"叔季振华裾，晶晶照上都。\n对床风送雨，隔岸越分吴。\n池草冰澌煖，庭萱玉色腴。\n綵帆飞晓镜，拂拭贺家湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴状元赴阙属陈兼佥催送行语","author":"释居简","text":"细把前朝圣政推，娄教龙首到黄扉。\n自南渡后从头数，比旧京时过眼稀。\n磊砢固当为世用，风云端不与人违。\n采薇只在丁山下，亟伫青鸾入翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋前一日蛩响","author":"释居简","text":"火孕金英眇未抽，学吟先报短檠秋。\n傍窗袅袅清如缕，明日西风一样愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁国奉圣寺有许浑旧题","author":"释居简","text":"题擅玉台宾，山名益著闻。\n禽珍腾逸响，草异荐奇芬。\n壁可曾留锡，檐栖欲去云。\n尘嚣避三舍，不度碧溪濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次复斋奚左藏补陁岩寺韵寺有象鼻岩渴霓皆佳致","author":"释居简","text":"当年聚石赋全提，断处飞梁险处梯。\n铁展霓腰疑水竭，玉伸象准卷云低。\n危于汉使回车坂，深似秦人避乱溪。\n钟梵殷床连夜旦，相忘猿鸟各安栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石如虹至水际余名之曰渴霓","author":"释居简","text":"直舒千尺怒谽谺，高贴云根枕水涯。\n水竭欲飞仍小住，砰轰欲跨阿香车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复斋坟前左顾石龟","author":"释居简","text":"宽罾密罔断江流，好在云藏莫浪游。\n我欲黄金如斗大，斩新左顾铸馀不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清隐寺乳泉","author":"释居简","text":"脉通九地各东西，洗钵曾分牧女糜。\n万斛从来不择地，试看一滴汎华池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仁寿堂","author":"释居简","text":"阔开荡荡城中天，朝菌灵椿总大年。\n凿井耕田皆帝力，不知谁党复谁偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉圣寺江阁","author":"释居简","text":"散衣江阁抚疏檐，吹彻西凉已属餍。\n得陇未终还望蜀，半规更待月纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐山","author":"释居简","text":"小岭明明属小支，傍山论价与山违。\n巢由去后箕山老，夜夜天云隐少微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬当涂何户曹畏斋金陵三篇见寄兼柬饷台上幕许从道 其一","author":"释居简","text":"山木凌秋似鬓苍，静观浮俗饱炎凉。\n唤回猿鹤弹三叠，话到陈隋笑几场。\n云度闲情疑路断，草生奇馥染林香。\n莫乘残照催归骑，白下留门惯漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬当涂何户曹畏斋金陵三篇见寄兼柬饷台上幕许从道 其二","author":"释居简","text":"笔耕白首不逢年，间得新题似得仙。\n磨透铁泓空费力，吟残金薤弗成篇。\n未忘陋巷希瞠若，不信长虹死浩然。\n小驻行云聊寄恨，莫为愁雨湿吴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬当涂何户曹畏斋金陵三篇见寄兼柬饷台上幕许从道 其三","author":"释居简","text":"松根葛藟亟扳缘，势极青冥恨不前。\n莺閟好音春不响，鹤嫌遗臭夜移眠。\n回头华表一千载，开眼檀萝十九年。\n想见息阴羞恶木，断魂岭海吊诸贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"克己斋","author":"释居简","text":"罔念圣为狂，医狂亦有方。\n正逵遵稳审，私孽殄微茫。\n蜕俗嗟封壳，耘心破畛疆。\n它山石攻玉，日用细平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪屋","author":"释居简","text":"霰集夜来寒，楼宽楮幌鲜。\n花温新换水，栗爆旧存毡。\n梦草疑非蝶，吟肩冻耸鸢。\n蓬婆界天白，皎皎五云连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丽云阁","author":"释居简","text":"零云闲占地，飞阁小侵天。\n目与孤鸿去，帆驱短艇还。\n绿芜秋野外，乌戍夕阳边。\n只尺阑干曲，丹青色色全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西菩寺三题 其一","author":"释居简","text":"蹱息如龟小作巢，霜零竺子绿云交。\n六爻动著如云变，辄莫其中动一爻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西菩寺三题 其二","author":"释居简","text":"本来无垢亦无尘，尘垢皆从洗处生。\n衮衮潢流湛华月，朣胧无夜不鲜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西菩寺三题 其三","author":"释居简","text":"蚤觉元龙不足豪，泠然步武老嫌高。\n刺天娄见群蜚下，欲驷晴霓看抃鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江东李仓使节制移浙东仓使","author":"释居简","text":"千辐纹边著意深，龙门檀越谶重临。\n旋螺数发为公寿，卐字扪胸印此心。\n玉节生风淮岸曲，金轮碾雾越山阴。\n诚明空觉曾无间，磁石岩岩一寸针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雪贺赵守 其一","author":"释居简","text":"不见鲜明剪绿漪，焦劳夙夜动精祈。\n腊残虽缺三回白，岁闰何妨十日迟。\n孰谓天高催不得，自知心感弗曾疑。\n静中觑破玄冥巧，留作新春第一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雪贺赵守 其二","author":"释居简","text":"拟絮因风又拟盐，只今此话可曾拈。\n待将巧思形容尽，合避新条比类嫌。\n褪煖已先云懵澒，挟寒相次雨廉纤。\n落梅声里浑如昼，囧囧横陈透玉蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送春","author":"释居简","text":"历头恰恰三月小，销减欲去未行春。\n祖帐不知春去处，清苕拍拍柳晶晶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开田","author":"释居简","text":"曩说琛师迈往贤，不将大义答开田。\n欲惩后世人尸素，敢昧前修自弃捐。\n把似诞谩规信施，何如勤苦佐丰年。\n钁头边事超今古，侥倖逢年是偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孺子祠堂","author":"释居简","text":"钩党开端惨弗舒，悬知隐逸未全疏。\n奸谀孔炽吾何与，名节虽高弊不除。\n盟鹭相忘寻水宿，冥鸿那复死巢居。\n澜翻平地浑漂汩，柰此悠然一叶虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹里","author":"释居简","text":"一亩摇湘绿，漪漪与静宜。\n避人酬橘隐，延月赋襟期。\n鹤至自华表，客来歌竹枝。\n谢家兰玉富，不似锦绷儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬卢直院新荷","author":"释居简","text":"爱此青钱小，移舟傍浅湄。\n团青迎浴佛，脆绿未巢龟。\n翠幄钿孤镜，瑶田葑四维。\n微风翻嫩紫，半捲欲开时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣杨承奉","author":"释居简","text":"车才闭户成，轮未碾青冥。\n兰夭腾馀馥，萧荣独欠馨。\n方看过秦手，续草太玄经。\n早惜黄陈死，无人哭小邢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"任大卿出龙眠度水罗汉","author":"释居简","text":"故家寻钓鳌，遗俗问佛世。\n喜逢十六人，不闻四句偈。\n风姿如隐槃，服御乃古制。\n开卷发遐想，瞪目得熟睨。\n绝溪将安之，深厉浅则揭。\n岸登植瘦策，石踞整坏毳。\n预流逮无学，劝进惮劳勚。\n岿然望等妙，迢递苦跋疐。\n悠悠马不前，亹亹驾辄税。\n弗悟燕安毒，遂失远大计。\n双林受遗托，久视不得逝。\n岂知古龙象，所向必超诣。\n弗践极则处，弗到弗小憩。\n朅来吊形影，相与话情契。\n丁宁勇著鞭，同振木方袂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出入韵寄陆溧阳","author":"释居简","text":"溧阳令尹果谁欤，陆少蓬翁小伯鱼。\n佳客来时须问字，丈人好处略瞻乌。\n俸钱撙节开家集，官事那容读父书。\n独欠旧时穷少府，琴堂相对撚吟须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"插田","author":"释居简","text":"秧撒才成后，沟塍莅事初。\n浅车防岸缺，密插趁行疏。\n处处邻相馌，乔乔莠旋除。\n夕阳归牧竖，牛背数舂锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刈麦","author":"释居简","text":"恨入崆峒渺，偏于麦熟时。\n谬将勤补拙，愧在素仍尸。\n仰识阴阳足，丰酬饼饵思。\n秋高禾黍实，不与宿根期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵隐方丈新阁接泗洲妙崧毁之","author":"释居简","text":"乡来屋老拊岩棱，欲上看山谢不能。\n衡跨半天开复道，直从平地到危层。\n上方近听婴儿语，前塔遥分竺寺灯。\n昨晚乱云收急雨，凭高如望海涛崩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长兴大雄寺陈朝桧","author":"释居简","text":"霜皮重复裹莓苔，不见君王过沛来。\n好处莫非前辈道，后生知是几时栽。\n阴分背乡青如旧，心愈刚明死弗灰。\n却恐登坛骚雅绝，亭亭似把碧油开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣钱长官竹岩 其一","author":"释居简","text":"十年同约故园归，指点云西凤翥奇。\n锦绣裹山怀旧俗，琅玕披腹吐新诗。\n更无人悼淹翔屈，只有天为慷慨知。\n令尹子丈三已矣，悠然喜愠不曾移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣钱长官竹岩 其二","author":"释居简","text":"掉鞅英躔并隽游，大巫皇恤小巫羞。\n未将所学酬知己，先与他人作忌囮。\n谮舌不中投虎兕，络头长恨死骅骝。\n山林独有男儿泪，可是无情涕泗流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵仁和","author":"释居简","text":"剧繁迎刃听裁剸，化自京师守令宣。\n处默有声长殷殷，所闻无善不拳拳。\n戚联阊阖天虽近，下若沧溟德更渊。\n任是灵椿根力浅，也应凡草不齐年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"释居简","text":"竹扉半掩不须敲，掠面融风著柳梢。\n燕子不知春寂寞，自衔泥补去年巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一庵","author":"释居简","text":"太极含三示极谈，初无一字可名庵。\n明明未画前消息，才落思惟便别参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和睡翁巩仲至赋颐蒙斋赠澄元妙","author":"释居简","text":"静倚松门掩夕霏，不知求己去求谁。\n翳花旋扫无留蒂，蒙吝才消即善颐。\n彖象尚堪明古意，茅茨聊复傍寒漪。\n是中馀地藏缄默，何处人间更有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹岩赋孙谷桥墦间图人徒知献谀可罪竹岩取受谀者并按","author":"释居简","text":"宁图豕负涂，毋写乞墦图。\n枉著迂奇思，徒将愧贱夫。\n矫情工谄媚，失计堕窥阈。\n逐鹿身忘反，亡羊口谩糊。\n饱虽令己王，饥解把人驱。\n毫发无新计，朝晡只故吾。\n有如扳佞倖，宁复顾揶揄。\n竭泽先崇货，倾城后进姝。\n匿瑕彰外洁，饰诈护中洿。\n豕燎难逃虱，城崩孰纵狐。\n知几属明哲，先物在斯须。\n宠数占忘醴，归心忆脍鲈。\n东篱怀醉令，故态舍狂奴。\n鸿听云沈迹，龟宁尾曳涂。\n盍观薇蕨瘦，弗与割烹殊。\n不智方能谄，非愚肯受谀。\n欲邀天爵贵，廉耻乃菑畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拙斋","author":"释居简","text":"大巧曾闻窃得灵，主司关籥镇随身。\n巧还有尽无如拙，却笑天孙未识真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢玉堂报遣人问讯水心","author":"释居简","text":"用舍见人物，抑见天地心。\n生人于此时，所系亦以深。\n时哉薄其祐，全力吾不任。\n向来邹鲁人，抱此空沉吟。\n此身眇如芥，列国纷于针。\n芥针求抵当，机括常差参。\n没身虽不遭，道在终不沉。\n朣朣千丈光，照耀不啻今。\n公乎邹鲁传，轩冕如山林。\n我亦山中人，不忍凤鸟瘖。\n加餐为公祷，以答天地心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻谢司直晦斋赴阙","author":"释居简","text":"谢老久不见，引领溪云隅。\n想随鹓鹭行，华簪小踟蹰。\n薄俸不暇给，素约不愿馀。\n棋局消日长，局终还拥书。\n书中有何好，剔抉排根株。\n飞电老逾碧，分毫惜居诸。\n一灯伊洛传，囧囧分庭除。\n乡来鲸吸川，今也川泳鱼。\n靖节老止酒，亦复自荷锄。\n悠然羲皇上，不知今何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢晦斋倅嘉兴","author":"释居简","text":"春风艺兰茝，采采山之阿。\n广庭拓馀地，华风日编摩。\n芳洁渐可冀，榛莽常婆娑。\n紫芽茁新馥，薰莸相错摩。\n引类连根株，图蔓费斧柯。\n何知种植勤，苦心忘鬓皤。\n九畹与百亩，恨少不恨多。\n薿薿谢庭玉，比德元同科。\n馀光烛槜李，散采摇清波。\n太湖跨三州，如此明月何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净照律师葬母冢上生芝十二茎关子长演倚松饶德操赋诗后九十馀载余亦赋","author":"释居简","text":"尸罗为源孝为根，一根岂止十二茎。\n沉香亭北烂缯绮，浪花浮蕊争欣荣。\n喑喑泪滴冢上土，只有天知此心苦。\n地灵荐瑞天不靳，付与千人万人睹。\n诗人史法语不浮，旌孝笔端回万牛。\n紫芝不老亦不槁，两公之诗更新好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棹歌","author":"释居简","text":"后夜朣胧魄载生，官塘犹自有人行。\n十年滴尽征人泪，不尽弯弯月子声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼志首座","author":"释居简","text":"花雨散初筵，归来耨寸田。\n行空梁复道，拓地阁诸天。\n木槁春长在，炉冰火不然。\n旦评溪上寺，犹自说耆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵栖岩分司池阳总干","author":"释居简","text":"九华空众山，尤物在尘寰。\n迥出云雨上，朝来眉睫间。\n有人皆毓胜，无豹不藏斑。\n官舍轩楹豁，凭阑莫掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤翥行","author":"释居简","text":"破舆不窗帘不旌，短长后先白四丁。\n旋牵毳衲裹秋鬓，月露点滴垂青冥。\n平明驱入三家市，市人惊见左右视。\n笑云非病亦非狂，不与人同与人异。\n抑非湖海空橘陈，不老不死亦不灵。\n不然天台石桥寺，丹碧剥落泥应真。\n须臾一棹脩门去，却遣破舆归凤翥。\n谓言只借此样僧，非此样僧莫借与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"于潜尉陈时斋获贼","author":"释居简","text":"小队气晶晶，平常白面生。\n沈冤资大勇，凶胆折先声。\n山鬼晨犹寐，邻厖夜不惊。\n历阳穷少府，此话恐难并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日","author":"释居简","text":"西风只识黄花面，不识登临吊古心。\n空打孟嘉乌帽落，挂人唇齿到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄寒泉","author":"释居简","text":"贫则安之岂病焉，乘桴未暇况笺天。\n翰林足避将军污，内史灰从廷尉然。\n口伐固应无大敌，笔耕元自有丰年。\n讲明人爵君何欠，只欠苏司业酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后潘","author":"释居简","text":"后潘水上竺仙家，领客来分竹里茶。\n明日归时须记取，白蘋剩采半开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前弯","author":"释居简","text":"反关蓬荜了残书，弗到前弯一月馀。\n不见蓼花红照水，安知秋色到西余。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日","author":"释居简","text":"瓦鼎松声涨苦荼，替杯中物泛茱萸。\n白衣不识缁衣客，自撷寒英插古壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜晓","author":"释居简","text":"江枫霜后醉痕朝，商略随风趁落潮。\n勾引梧桐三四树，不留一叶到今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广教不厌亭","author":"释居简","text":"眼挂层峦醉益青，旋疑身是出山云。\n一泉一石忘情地，都作鸿沟与俗分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵府录官满 其一","author":"释居简","text":"平反固尽情，此话久弥新。\n动以中为的，居嫌恕寡邻。\n暗萤方自照，屈蠖倩谁伸。\n好在庭前树，长怀雪后春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵府录官满 其二","author":"释居简","text":"萧洒宣城掾，仙源似布韦。\n欲疏伊洛正，不与父兄违。\n雾隐虽如晦，胎仙弗愿肥。\n暮云无限思，金溜一竿微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沈少卿","author":"释居简","text":"怀哉小隐侯，如水秋练练。\n又若廉泉廉，练江腼言面。\n一介不取人，振滞亦赈贫。\n秉彝不可夺，实德无虚名。\n我欲借寇君，九虎限天海。\n不知穹壤间，谁是寇君代。\n行行拜新渥，新纫紫荷橐。\n何以为双寿，扬州一双鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"移梅","author":"释居简","text":"雪消时候带花移，花笑移迟不振奇。\n今岁弗须嫌早计，趁它一点未开时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"移梅竹谢彰教寺事","author":"释居简","text":"苍玉根连白玉条，湿云冉冉碧萧萧。\n花含鼎实宜先发，节笑心空贵后凋。\n友此双清同日种，听它六出几时飘。\n不如杨柳江边树，惠浅恩疏怨不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画虎行","author":"释居简","text":"是中毒厉无停辀，更复外为物我谋。\n汝宁残暴我宁尔，爪距铦利何从投。\n形与气侔天所命，阳荡阴摩成厥性。\n划然残暴反其初，一瞬回头如失影。\n影不随形竟何有，直与太虚为户牖。\n李生解衣盘礴时，笔端别有百步威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]