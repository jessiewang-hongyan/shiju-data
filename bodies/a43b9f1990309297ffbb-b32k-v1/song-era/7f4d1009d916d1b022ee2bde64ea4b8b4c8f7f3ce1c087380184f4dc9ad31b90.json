[{"title":"性之寻梅归来有诗因感一绝","author":"胡仲参","text":"处士庐前门径深，仅留佳句与人吟。\n孤山近日无行路，疏影暗香何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上得句寄潜君升","author":"胡仲参","text":"无奈篷窗雪打声，梦魂才稳又还惊。\n枕衾如许犹嫌冷，多少阎闾睡不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑女","author":"胡仲参","text":"叶满筐箱花满簪，低头微笑出桑阴。\n后来若有秋胡子，说与黄金必动心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中","author":"胡仲参","text":"愁坐黄昏掩客扉，风翻霜叶满庭飞。\n孤灯挑到寒更尽，犹有行人带雨归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫怨","author":"胡仲参","text":"泪粉羞临宝鉴前，淡妆争似旧婵娟。\n一言曾忤君王意，闭在长门十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚见山茶花一枝独开","author":"胡仲参","text":"荼蘼开尽见山茶，血色娇春带雨斜。\n莫是今年逢闰月，东风吹到背时花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺中词 其二","author":"胡仲参","text":"听尽芭蕉雨，愁人夜不眠。\n凭谁将此意，为妾到郎边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺中词 其一","author":"胡仲参","text":"写就相思字，灯前带泪看。\n欲缄还未忍，少待泪痕乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读秦纪","author":"胡仲参","text":"万雉云边万马屯，筑来直欲障胡尘。\n谁知斩木为干者，只是长城里面人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陵上","author":"胡仲参","text":"身为功名役，因思隐者贤。\n只行山后路，羞过钓台前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得","author":"胡仲参","text":"挑灯伴寒夜，兀坐竹炉边。\n赤脚知吟苦，时将山茗煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得家书","author":"胡仲参","text":"手剥鳞缄细细看，北堂垂白喜平安。\n为怜客里多霜雪，寄得衣来正及寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚雨","author":"胡仲参","text":"勃姑鸦舅叫楼西，春色阴晴景不齐。\n浓墨四垂收未起，明边一片夕阳低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明","author":"胡仲参","text":"杯酒浓浇垄上春，东风吹起纸灰尘。\n可堪肠断中原路，草掩荒丘不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔梁岭禹庙","author":"胡仲参","text":"古今陈迹几兴亡，闽岭何因祀夏王。\n莫是当年平水日，曾驱鱼鳖渡渔梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜郭希范自上庠归","author":"胡仲参","text":"马蹄明日是君家，千里归来傍节华。\n几夜深闺寒寂寂，有人和泪卜灯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒中偶题","author":"胡仲参","text":"酒对红炉暖，香凝绣被温。\n老天有私意，寒不到朱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游白石山观音寺","author":"胡仲参","text":"绿阴深处石桥横，才入山门意便清。\n林下一僧无个事，时来倚树听泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入京第一程","author":"胡仲参","text":"六载馆杭州，重来访旧游。\n山中才过雨，客里又惊秋。\n岚气蒸衣湿，泉声激石流。\n功名苦行役，羞见渡头鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与生上人","author":"胡仲参","text":"久住深山里，相忘物外形。\n逢人出好语，入定掩残经。\n古字碑成轴，名诗榜作屏。\n欲知祖师意，柏树在中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中作","author":"胡仲参","text":"村居便野性，况复是清秋。\n为爱山间好，因成旬日留。\n林深喧鸟雀，露重滴松楸。\n昨夜新寒入，篝灯覆弊裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀呈曾性之","author":"胡仲参","text":"览镜叹头颅，梅花一样臞。\n病因吟后有，愁到醉边无。\n心事归梁燕，年华过隙驹。\n世途难著脚，况复是江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用冯深居韵题莆阳章氏环翠楼","author":"胡仲参","text":"百尺危梯眇海寰，栏干十二尽青山。\n烟光浓淡藏多景，野水周遭匝四环。\n胜地只宜骚客住，老天未放主人闲。\n凭谁说与九仙道，方丈移来在此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用伯氏韵柬梅臞","author":"胡仲参","text":"榾柮炉前坐夜深，寒侵窗户月西沉。\n冥搜天地无穷趣，写尽江湖一片心。\n霜叶落边添客思，梅花瘦处动高吟。\n访君欲问推敲诀，拟把清樽共细斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夹河中有矮道人自住小舟持咒为生人莫不异之者","author":"胡仲参","text":"道人神貌古，双鬓欲垂肩。\n坐席容三尺，浮家住一船。\n养生凭佛果，持钵信人缘。\n早泊桥梁下，蓬头起白烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早发","author":"胡仲参","text":"早发六七里，前途曙未分。\n渔舟依岸立，水碓隔溪闻。\n独树支残月，空山半白云。\n清晨那可驻，日出又如焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次林庭植留别韵","author":"胡仲参","text":"曲生皆可醉，何必问醇醨。\n浩气长看剑，愁肠半贮诗。\n归舟无麦载，去路有梅随。\n瘴海风波恶，此行君自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖会上和赵靖轩韵","author":"胡仲参","text":"不著人间半点愁，每于胜处一凭楼。\n吟边只欠林和靖，坐上追思马少游。\n晕脸芙蕖酣薄暮，低眉杨柳拂新秋。\n酒阑拍掌狂歌舞，自是忘机可狎鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过千顷寺访谷隐老","author":"胡仲参","text":"别久交情淡，重来似旧时。\n人生云聚散，世事月盈亏。\n茶具权行酒，禅床借看诗。\n漫天多雪意，预约探梅期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过永春县","author":"胡仲参","text":"距城才百里，世路便难平。\n碣石唐人墓，桃源晋地名。\n危谯依岳势，荒市带溪声。\n往日罹兵火，颓垣蔓草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问性之病","author":"胡仲参","text":"莫向推敲苦用心，闻君病里亦沉吟。\n书灯挑尽无人共，药鼎煎残到夜深。\n霜后菊花方寂寂，腊前梅事又骎骎。\n相看咫尺如千里，几度逢人问信音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王和礼留别韵","author":"胡仲参","text":"归骑匆匆十日程，客身犹自恋桐城。\n未应江左追王建，且去隆中卧孔明。\n鸡黍几番陪夜话，莺花一路伴伶声。\n秦溪溪上无风浪，好与白鸥寻旧盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林梅臞西淙瀑布图韵","author":"胡仲参","text":"瀑驶惊风雨，危悬峭壁前。\n临流清客耳，入夜搅幽眠。\n旁是龙为庙，高疑山有仙。\n一尘飞不到，长似九秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐与伯氏苇航对床阅江湖诗偶成一首","author":"胡仲参","text":"对床因话弟兄情，话到山林世念轻。\n几上江湖诗一卷，窗前灯火夜三更。\n茶经未展神先爽，香片才烧味较清。\n吟罢忽闻谯角动，石桥霜晓有人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐即事","author":"胡仲参","text":"午夜空庭寂，心闲坐亦忘。\n竹间风动静，云里月行藏。\n惊鹊出幽树，寒螀语废廊。\n瓯茶聊当酒，清气入诗肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐偶成","author":"胡仲参","text":"一字吟难稳，沉沉夜向阑。\n灯明妨短梦，衣薄犯新寒。\n千里家山远，三年客路难。\n明朝有佳便，尺纸报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行暮归","author":"胡仲参","text":"吟罢归来兴欲狂，重城半掩傍昏黄。\n钟声遥动山灵答，月魄未高人影长。\n竹叶浅斟杯量窄，梅花满插帽檐香。\n不妨竟日酬心赏，才到明朝事又忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思家","author":"胡仲参","text":"夜梦到山居，回头千里馀。\n屡传归去信，不得寄来书。\n小径应添笋，荒畦欠理蔬。\n客程频得雨，田里事何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柬竹院孚老","author":"胡仲参","text":"别来旬日许，又过一分春。\n因感尘中事，空惭物外人。\n吟清便境静，语苦见情真。\n近况知何似，篇诗得细询。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚泛湖","author":"胡仲参","text":"载酒湖边买小舟，水光山色解人愁。\n短篱寂寂菊花晚，两岸萧萧杨柳秋。\n落日波间收戏鼓，暮烟林外出歌楼。\n倚栏长啸西风里，惊起前汀双白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋意","author":"胡仲参","text":"梧叶飘残客梦惊，拥衾危坐到天明。\n片心除是眉头识，万感都从念脚生。\n江上鲈肥销旅况，楼前雁过带边声。\n挑灯无语闲商略，谋国谋家底计成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送诸葛春卿还里","author":"胡仲参","text":"扁舟分袂出湖滨，我向吴中君向闽。\n自笑吟身犹是客，却来远道送行人。\n家山会友凭传语，旅舍逢诗为拂尘。\n天北天南相忆处，梅花毋惜一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅臞还三山","author":"胡仲参","text":"十年湖海上，此日值梅兄。\n一见才倾盖，相逢又问程。\n新编联画卷，清话入诗评。\n从此云山别，因风时寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳","author":"胡仲参","text":"漫浪江湖已十霜，一秋强半又重阳。\n可怜白日浑闲度，偶对黄花觉自伤。\n客舍题诗书感遇，市楼沽酒慰凄凉。\n登高不为酬心赏，直欲凭栏望故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别社友","author":"胡仲参","text":"漫浪归来六换秋，又携书剑入皇州。\n得些湖海元龙气，作个山川司马游。\n奔走客城因念脚，勾牵时事上眉头。\n中朝满目皆知己，还有篇诗遣寄不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留宿陈氏书斋","author":"胡仲参","text":"因访吟朋到竹居，春寒策策动窗虚。\n几番好雨偏留客，一盏青灯共读书。\n徐孺旧曾亲下榻，陈遵见说好投车。\n与君静夜评心事，万斛闲愁尽扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读岳鄂王行实","author":"胡仲参","text":"飞鹄来何意，英雄此日生。\n山河张胆气，宇宙载风声。\n一片堂中纸，千年身后名。\n至今坟上木，犹作不平鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得","author":"胡仲参","text":"欲问梅花信，山寒去未能。\n静思天外句，坐对夜深灯。\n戒酒频添衲，煎茶旋凿冰。\n月残霜又落，无复叩门僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄竹院方丈孚师","author":"胡仲参","text":"江湖岁月易销磨，振锡归来鬓欲皤。\n性懒吟编多散逸，门闲俗客少经过。\n虚檐破处悬蛛网，落叶空中见鸟窠。\n一片师心谁会得，半窗竹影绿婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄梅臞","author":"胡仲弓","text":"别去忽经旬，春风阅二分。\n几番吟对雨，独自暗思君。\n客里加频病，愁边骇近闻。\n倚栏商不得，心目乱于云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄黄云心","author":"胡仲弓","text":"竹屋少行迹，闭门春昼长。\n天时半晴湿，人意共炎凉。\n苔藓侵阶绿，荼蘼压架香。\n冥搜寻杖履，不为看花忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"胡仲参","text":"凝云商作雪，顷刻满天涯。\n片片疏还密，霏霏整复斜。\n映窗疑月影，著地似杨花。\n四望浑同色，微茫认点鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜作","author":"胡仲参","text":"生计尚茫茫，微吟思故乡。\n羁愁消不尽，寒夜未为长。\n门掩梅花月，禽翻竹叶霜。\n挑灯裁锦字，明发有归航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山中","author":"胡仲参","text":"世途平处起波澜，输与高僧占好山。\n竹麈直为挥俗具，槿篱虚设掩尘关。\n林泉有分酬清供，瓶锡无人伴此闲。\n摆脱名缰须早计，半生犹得住云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中早发","author":"胡仲参","text":"未晓催行色，微吟独据鞍。\n露垂星影湿，月淡水光寒。\n犬吠知村近，鸡鸣觉夜残。\n亲闱在何许，谁念客衣单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题雪舟云心二友吟卷","author":"胡仲参","text":"君诗何所似，绝似晚唐诗。\n写出春云状，融成白雪词。\n百篇多态度，二妙一襟期。\n与我为三友，他年题品谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题墨梅竹","author":"胡仲参","text":"洗尽丹青料，清高绝点埃。\n数竿无韵竹，一树不香梅。\n与可今已矣，补之安在哉。\n千年好风致，唤上笔头来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薄暮","author":"胡仲参","text":"薄暮抱幽独，无言倚小楼。\n日沉千树晚，风起一天秋。\n警枕团新梦，寒衣带旧愁。\n祇因吟太苦，馀病未全瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"胡仲参","text":"石磴手难攀，林深去复还。\n人行啼鸟外，僧住白云间。\n野兴平秋水，吟魂绕暮山。\n马头风作恶，潘鬓任阑珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑妇吟","author":"胡仲参","text":"君不见汉殿丹青未漫灭，马上琵琶向谁说。\n又不见华清舞破霓裳衣，凌波竟堕嵬山血。\n从来艳色多累身，妾貌虽丑心自悦。\n幽闺到老无人知，白发如丝镜如铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"胡仲参","text":"露重湿征衣，风急翻纱帽。\n山下灌园人，倚锄看马过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜听琴效渔父辞","author":"胡仲参","text":"风入古松成节奏，泉奔幽磴响琮琤，琴中弹意不弹声。\n猛拂朱弦灯焰落，细敲玉版梦魂清，啼乌枝上月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王用和屡言别而未归颐斋有诗戏之次韵奉寄","author":"胡仲参","text":"几度西郊饯马尘，曾将尺素托文鳞。\n荷杯酌尽开怀酒，柳线萦回有脚春。\n瘴海自多流落客，阳关少见别离人。\n出门有碍何为者，徒负江湖老大身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伯氏包山观桃花韵","author":"胡仲参","text":"因访桃花到岭根，御林春色此平分。\n千株未数栽唐观，一幅犹堪画晋源。\n仙在云间无处觅，人行风外有香闻。\n笙箫隐隐宫城隔，立尽黄昏更断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上偶成","author":"胡仲参","text":"客楼萧索抱愁眠，雁过声声到枕边。\n念脚动如鱼拨剌，吟身寒似鹭联拳。\n匣中幸有刘琨剑，囊里犹馀杜老钱。\n忽忆西山山下路，夜深霜露滴松阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试后书怀","author":"胡仲参","text":"踏遍天涯路，春三秋又三。\n文章与时背，言语对人惭。\n湖海气何馁，山林分未甘。\n闲僧时过我，挥麈共玄谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴泛湖","author":"胡仲参","text":"雪后湖清浅，令人心眼开。\n林疏知寺近，冰合碍舟回。\n寒色欺吟鬓，斜阳入酒杯。\n山行已清绝，况复是寻梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午","author":"胡仲参","text":"千年流水去滔滔，此日人来吊汨罗。\n江上画船无买处，闭门风雨读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穿山月岩","author":"胡仲威","text":"石磴?嵚□□□，坐来心迹自双清。\n不知浑沌何年凿，便有婵娟一镜明。\n周穆马蹄何寂寞，谢公屐齿□□□。\n□然欲御长风□，□□烟云脚底生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙都山","author":"胡份","text":"鸟道盘空上，松根抱石生。\n羽人分两舍，鸡犬自闻声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雁门山","author":"胡份","text":"羲和前珥节，云锁已先开。\n仙鹤迎人至，山花拂酒来。\n问奇缘石室，伐阴出层台。\n人影半空落，归鹞足下回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"胡份","text":"绝艳更无花得似，暗香惟有月明知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]