[{"title":"咏史五言二首 其二 唐季","author":"刘克庄","text":"虽化家为国，其如夏变夷。\n可汗僭天子，萧后作阏氏。\n玉检无升顶，珠襦有裸尸。\n未应长乐老，饮酒又吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史五言二首 其一 汉初","author":"刘克庄","text":"西都生昴宿，东井聚奎星。\n仅可尊秦陛，安能肃汉廷。\n收图惩灭籍，起蕝欠嵇经。\n何况杯羹语，书之涴汗青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜过瑞香庵作","author":"刘克庄","text":"夜深扪绝顶，童子旋开扉。\n问客来何暮，云僧去未归。\n山空闻瀑泻，林黑见萤飞。\n此境惟予爱，他人到想稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐二首 其二","author":"刘克庄","text":"并拥三重絮，犹新二尺檠。\n屋高先见月，城远忽闻更。\n藜杖光芒歇，茅柴力量轻。\n若非檐铁响，淡杀老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐二首 其一","author":"刘克庄","text":"坐久乌薪尽，呼童扫叶忙。\n海风过雪冷，冬夜抵年长。\n故纸真糟粕，枯骴孰臭香。\n老无闲记性，读罢转头忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐二首 其一","author":"刘克庄","text":"依约前生是蠹鱼，坐窗不觉晓钟馀。\n都忘还笏休官了，浑是担簦应举初。\n亥豕安能承谬误，雪萤尚欲补空疏。\n玄花生眼蜩鸣耳，贪校新抄数板书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐二首 其二","author":"刘克庄","text":"世法人情已尽抛，深林自占一枝巢。\n病来不饮疏欢伯，老去惟书作淡交。\n马尾动烦刊笔误，蝇头尚可就灯抄。\n山空月落商歌起，不管秋风捲屋茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜饮方湖","author":"刘克庄","text":"贪听月下小丛歌，掷去金蕉吸碧荷。\n四面凉如浮震泽，五更渴欲挽斜河。\n古称贤达谁存者，今不欢娱柰老何。\n长笑岘山空感慨，羊公湛辈两消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜读乐平吴燊书钞用与伯纪韵","author":"刘克庄","text":"病思羁怀少豫忻，暮年犹幸友多闻。\n千枝管秃因稽古，一啜芹甘欲献君。\n明主何曾轻朴学，后儒大率读今文。\n藏山俟圣吾侪事，何必时人好子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜检故书得孙季蕃词有怀其人二首 其二","author":"刘克庄","text":"中年豪宕以词行，醉墨淋漓一座倾。\n昔竞捧笺求少蕴，今谁沥酒吊耆卿。\n戴花起舞生无闷，荐菊为肴死亦清。\n愁绝水仙祠畔路，萋萋原草几枯荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜检故书得孙季蕃词有怀其人二首 其一","author":"刘克庄","text":"贪听谯更夜未眠，偶拈一卷向灯前。\n凤箫按谱声声叶，鲛帕盛珠颗颗圆。\n洛叟曾规秦学士，蜀公晚喜柳屯田。\n江湖冷落词人少，难起花翁傍酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬吴洪二公三和之什 其二","author":"刘克庄","text":"衰容懒镊白髭须，新咏难追纪少瑜。\n攀槛公曾排禹佞，下帷我亦鄙弘谀。\n瓶沽何必太玄也，褐博尝闻大勇乎。\n捽茹脍肝均一饱，不知谁圣复谁愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬吴洪二公三和之什 其一","author":"刘克庄","text":"千层坠为一毫差，还了鱼须脱革华。\n数尺了无怀内锦，三斤空有话头麻。\n早曾谒帝吟薰殿，晚欲逃儒入墨家。\n自笑老人心尚骏，故吾不换换新花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟夏汎方湖得同字","author":"刘克庄","text":"长笛横吹露满空，柂行浑不辨西东。\n岸回初见遥峰出，浦尽新疏别港通。\n月照鹭身明石畔，风翻萤影没荷中。\n书生此乐关时命，叹息无因夜夜同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟浩然骑驴图","author":"刘克庄","text":"坏墨残缣阅几春，灞桥风味尚如真。\n摩挲只可誇同社，装饰应难奉贵人。\n旧向集中窥一面，今于画里识前身。\n世间老手惟工部，曾伏先生句句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季父习静哀诗四首 其四","author":"刘克庄","text":"易学纷纷各著书，独于师说著功夫。\n涪翁旧传七分止，邵子先天一画无。\n不遣耆英陪讲读，空留章句授生徒。\n即今黄策方施用，姑可藏山待后儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季父习静哀诗四首 其三","author":"刘克庄","text":"习静先生子刘子，新阡即此是标题。\n便无华表翔双鹤，不有生刍藉只鸡。\n在昔陶潜书处士，从它孟德揭征西。\n原头一恸关伦纪，始信彭殇未易齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季父习静哀诗四首 其二","author":"刘克庄","text":"忆在婴儿日，常依少父傍。\n不嗔仲容小，犹记阿宜长。\n诲语祛蒙吝，埋辞愧惰荒。\n从今有疑义，无复叩山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季父习静哀诗四首 其一","author":"刘克庄","text":"关洛源流远，乾淳辈行尊。\n一檠常对卷，贰簋亦开樽。\n缟素几空巷，玄纁不及门。\n异时遗逸传，谁定访丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚不果行次韵二首 其二","author":"刘克庄","text":"祖帐方涓吉，公车已尼行。\n若非露消息，未免迫期程。\n水菽姑娱母，茅柴且酌兄。\n未应天禄阁，便欠一更生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚不果行次韵二首 其一","author":"刘克庄","text":"物色来林下，安排起海滨。\n居然蒙锦阱，幸未驾蒲轮。\n非我瑕疵女，云谁毁誉臣。\n只愁从此去，未易致虞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟乞以碍止法官回授公朝特俞所请族子有诗志喜居厚次韵邀某同作效颦一首既拙且钝录献家庙","author":"刘克庄","text":"回貤异渥未之闻，凛凛乾淳生气存。\n频对青藜真济美，虽埋玉树尚追尊。\n奉新鸾诰陈幽壤，距小麟台只近村。\n太息琰玄皆耄矣，诔成姑以寝为园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟生日","author":"刘克庄","text":"赤帝虽然张火伞，素娥亦自涌冰轮。\n门无宾客临罗爵，庭有儿孙贺绂麟。\n晚节抽身还故里，他时留面见先人。\n星翁未解吾侪意，犹说君王猎渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟改提举鸿禧一首","author":"刘克庄","text":"召来未及拥青绫，麾去何妨拄赤藤。\n粉署冯唐无辈行，镜湖贺老有交承。\n吏柂月给帮虚设，客怪冰衔字稍增。\n犹胜亳州前管辖，鬒毛秃尽欲归僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其八","author":"刘克庄","text":"雪埋磴道古坛夷，畴昔兹游境绝奇。\n石上犹存周故辙，山尖难访禹残碑。\n云开天柱峰虽出，血作陈清水可悲。\n帝赏战功无吝色，定分宝枕疗金痍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其四","author":"刘克庄","text":"麾下偏裨尽拜侯，执俘已漆月氐头。\n饮江马去黄旗捷，巢幕乌来黑眚收。\n上不解衣常北顾，公宜归衮勿东留。\n几时四野狼烟息，烂醉花间秉烛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其三","author":"刘克庄","text":"久抛弓冶作耕夫，故步人犹记铁炉。\n已老安能歌竞病，从初不合识之无。\n房帷那复伶玄妾，部曲惟馀颖士奴。\n春暖小车时一出，绝胜朝士典西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其五","author":"刘克庄","text":"曾厌承明儤直劳，中宵麻卷揽衣操。\n退闲久已袖双手，老懒渠能注二螯。\n云水生涯今易足，人天供养昔非饕。\n三家村未闻戎捷，但见樗翁又出遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其七","author":"刘克庄","text":"光尧仓卒幸山阴，或者讹传跸再临。\n长算决于春思殿，捷书来自杀胡林。\n奔逃尤甚骑猪窘，惩创从前饮马心。\n强作凯歌殊下俚，不如商颂有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其二","author":"刘克庄","text":"闻说朝家念履簪，朵颐安肯学羊斟。\n批涂曾举词臣职，芹曝终怀野老心。\n晓镜鬓须难染摘，夜檠手口尚披吟。\n世间蚓窍更鸣和，未识王孙半岭音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其十","author":"刘克庄","text":"得丧傍观有悴荣，此翁勘破一毫轻。\n宴披香殿犹前日，出大槐宫已隔生。\n未许季咸觇老态，旋呼伯雅解春酲。\n不知触氏并蛮氏，胜负元因底事争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其六","author":"刘克庄","text":"列城若个是张巡，拊髀方思志义臣。\n怀印绶亡多委郡，援鍪弧死更无人。\n肆鸡竿赦还迁客，出袅蹄金聚散民。\n待得玄冥解严了，东皇太乙又行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其一","author":"刘克庄","text":"用世文章莫太高，空言讵有补丝毫。\n呼来谁遣批黄敕，谪去何须著锦袍。\n齿耋自应陪九老，诗低不足列三豪。\n仆家梦得无标致，爱说玄都观里桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟和七十四吟再赋 其九","author":"刘克庄","text":"占断溪山不纪年，俗开谤道是呆仙。\n马迟甘殿他人后，棋劣常输敌手先。\n饥咬菜根美熊掌，穷烧柏子当龙涎。\n可怜陈窦无精识，欲以绳维大厦颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟诗将活鹿寿余次韵一首","author":"刘克庄","text":"从猎曾陪汉建章，肄歌遣寿鲁灵光。\n山林放去全渠性，町疃归来获此祥。\n却笑缋皮资少府，底须折角向朝堂。\n残年不作蕉中梦，得丧冥心付一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"居厚弟得玉局祠","author":"刘克庄","text":"忆昔端平初去国，署衔窃喜似坡仙。\n衰翁鬓雪年华晚，贤季条冰敕墨鲜。\n饮马胡儿来杂沓，犹龙老子去翩跹。\n何时剑阁妖氛扫，重炷荒祠一缕烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"录颜鲁公事","author":"刘克庄","text":"世乱朝危节少全，鲁公大义薄云天。\n悯忠亲以舌舐血，骂贼尸犹爪透拳。\n曾饵仙丹元不死，求容鬼质岂其然。\n郎君自有翘材客，焉识堂堂父执贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忿欲一首","author":"刘克庄","text":"忿欲伤生甚斧斨，易言惩窒味尤长。\n古人明著佩韦戒，前辈犹烦按剑防。\n养似斗鸡逢纪渻，避如决鹿见毛嫱。\n小斋扫去闲书画，专揭吾诗置座傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明道祠满","author":"刘克庄","text":"初作衡山香火缘，不教俗事到吟边。\n清狂畴昔有三藁，警策即今无一联。\n汝辈未宜轻宿士，此翁犹及见先贤。\n丁宁稚子收残草，他日笺家要谱年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔与仙游傅常博父子游从识其幼子方总角晚归田里忽袖二诗见访余开八秩君亦六十矣感叹之馀因次其韵 其一","author":"刘克庄","text":"议郎座上识郎君，窃意趋庭有异闻。\n客屦今无同辈在，书灯昔与长公分。\n虫冰寒暑余侵耄，萤雪光阴子尚勤。\n见说架签犹万卷，肯将浊臭博清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔与仙游傅常博父子游从识其幼子方总角晚归田里忽袖二诗见访余开八秩君亦六十矣感叹之馀因次其韵 其二","author":"刘克庄","text":"窗下陈编懒更窥，还丹难染镜中丝。\n后生可畏前贤远，妄校皆封老将奇。\n辟谷差贤东郭乞，归耕莫待北山移。\n凤凰池听渠侬夺，不夺溪边放鸭池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其一 五爱","author":"刘克庄","text":"天不生斯物，将如冻者何。\n为谁忙作茧，到底化为蛾。\n种至春还育，功于世最多。\n香闺不知织，岁岁赐香罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其四 五爱","author":"刘克庄","text":"未省吞腥腐，惟承晚露餐。\n三生齐女怨，千首孟郊寒。\n腹馁鸣尤激，身轻蜕不难。\n何须珥华冕，吾欲挂吾冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其三 五爱","author":"刘克庄","text":"占断十分清，飞来一点轻。\n死还为腐草，生怕傍长檠。\n扇扑随风远，囊盛彻夜明。\n藜灯与莲炬，不似尔多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其二 五爱","author":"刘克庄","text":"兹虫虽小物，一一抱微忠。\n多士从先主，群臣立悼公。\n献花朝贡谨，酿蜜国储丰。\n处仲目空露，名居畔逆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其五 五爱","author":"刘克庄","text":"古云龟与鹤，阅世寿尤长。\n试问刳肠卜，何如曳尾藏。\n有灵宁毁椟，无用且支床。\n吸视堪传否，仙家不死方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其二 五憎","author":"刘克庄","text":"绛帕妖方士，青襟小茂才。\n集瓜讥汝否，止棘刺谁哉。\n倏忽寻声去，曾无濯足来。\n吾衰臂力短，驱去复飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其五 五憎","author":"刘克庄","text":"不觉渠泥臭，偏依井干蹲。\n声尤粗水鸟，腹欲大河豚。\n焚鞠存经训，如簧避谮言。\n主人方戒杀，毋怪尔徒喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其一 五憎","author":"刘克庄","text":"伺夜偏乘隙，逢人辄噬肤。\n不饶豫让炭，肯恕玉环酥。\n闇空愁逢蝠，虚檐巧避蛛。\n吾无红拂妓，姑命小奴驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其四 五憎","author":"刘克庄","text":"物理或难诘，疑经多未通。\n蜚虽笔麟史，荔不产龟蒙。\n记异因同蜮，为灾岂减螽。\n恨余非博识，安敢注鱼虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昔陈北山赵南塘二老各有观物十咏笔力高妙暮年偶效颦为之韵险不复和也 其三 五憎","author":"刘克庄","text":"么么常情忽，潜形未易知。\n嗅香太尉足，起粟婕妤肌。\n醯瓮偏常集，纱厨巧似窥。\n平生长麈尾，至此竟难麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林贡士哀诗","author":"刘克庄","text":"秋赋空高荐，春官辄报闻。\n坡公遗李廌，合辈愧刘蕡。\n铁砚三升墨，银袍四尺坟。\n自言阴骘远，鹤表会干云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林知录和余梅百咏","author":"刘克庄","text":"一已为多况百哉，得君诗卷久惊猜。\n乍疑姑射山头比，谁唤勾芒雪里回。\n委壤可怜渠有命，倾城岂是子无媒。\n直须著意描香影，和靖宗人合咏梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林贵州哀诗二首 其二","author":"刘克庄","text":"岁晚淹留潦雾间，朱幡虽宠变苍颜。\n颍川凤下来何晚，浪泊鸢飞去不还。\n道远返丧新燧改，州贫无赙旅囊悭。\n新邱莫叹封茔俭，绝胜痴人锦裹山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林贵州哀诗二首 其一","author":"刘克庄","text":"四壁空留宅，双旌漫典州。\n无钱堆别屋，有石压归舟。\n纵未封孙叔，犹当庙柳侯。\n吾铭皆实录，亦足继前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林卿劝开酒禁次韵一首","author":"刘克庄","text":"新沐发浑如雪白，大开眼只见天青。\n称觥乍可同邠俗，锡爵安能效卫伶。\n过眼神奇俄臭腐，到头浊醉胜清醒。\n闹蓝不是安身处，且向糟邱寄暮龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林卿见访食槟榔而醉明日示诗次韵一首","author":"刘克庄","text":"壮于蒳子大于榛，咀嚼全胜曲糵春。\n俚俗相传祛瘴厉，方书或谓健脾神。\n素知鲸量安能醉，但取鸡心未必真。\n一笑何妨玉山倒，贫家幸自有苔茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武冈叶使君寄诗次韵二首 其二","author":"刘克庄","text":"北戍逢君岁建寅，岂知今作落南人。\n瘴来客病邻山鬼，舶去乡书托海神。\n目送飞鸢偏恋土，梦随画隼共行春。\n谢家兄弟如双璧，交契宁非有宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武冈叶使君寄诗次韵二首 其一","author":"刘克庄","text":"词客纷纷载后车，谁能远寄病相如。\n双旌已拜湖南牧，尺素犹题岭外书。\n诗句骑驴游蜀后，情怀赋鵩吊湘馀。\n似闻阖郡春风暖，便拟移家占籍居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武涉道中","author":"刘克庄","text":"一路荒凉极，无端过此频。\n官于盐起税，俗事蛊为神。\n暝色初逢驿，溪声只隔林。\n留题空满壁，不见有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"空村","author":"刘克庄","text":"弃置在空村，浮名岂复论。\n因思戎服窄，方悟缊袍尊。\n城远鸡司晓，家贫犬守阍。\n常怜刘越石，辛苦戍并门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"空寂院","author":"刘克庄","text":"院名谁遣称空寂，入得门来寂又空。\n旧有田园官户占，别无衣钵老尼穷。\n砌倾苔色侵堂上，厨废炊烟起草中。\n或说古碑巢寇写，栖禽不下似伤弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]