[{"title":"稼村诗帖 其一","author":"蔡襄","text":"隐居何事可谋生，尧舜难周畎亩情。\n若得一犁膏雨足，石田茅屋起歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稼村诗帖 其二","author":"蔡襄","text":"布谷声中雨满篱，催耕不独野人知。\n荷锄莫道春耘早，正是披蓑叱犊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月二十四日射弓","author":"蔡襄","text":"破的心仍在，争豪力不堪。\n开弓初觉颤，盈贯未离贪。\n衰病先期老，中年岂分甘。\n唯应樽酒在，万事一醺酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日许当世以诗见率登高","author":"蔡襄","text":"霜云明净海山隈，一岁登临始此回。\n堂上寿觞淋浪满，栏边佳菊似疑开。\n故乡情味人人好，今日荣恩节节来。\n正是秋风洗烦暑，力将衰飒上高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二十二日山堂小饮和元郎中牡丹向谢之什","author":"蔡襄","text":"几家园馆见千枝，白发虽多意不衰。\n香泽最深风静处，醉红须在月明时。\n已知佳节无馀日，更向残芳卷一卮。\n拟放春归还自语，来年老信莫先期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日立春舟行寄福州燕二司封","author":"蔡襄","text":"清溪潮上送行船，回望高城隔晓烟。\n景色似看名画展，醉魂犹忆寿杯传。\n春盘食菜思三九，人日书幡诵百千。\n南国逢君唯道旧，后时何处笑今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十八日陪提刑郎中吉祥院看牡丹","author":"蔡襄","text":"节候初临谷雨期，满天风日助芳菲。\n生来已占妙香国，开处全烘直指衣。\n揽照尽从乌帽重，放歌须遣羽觞飞。\n前驺不用传呼宠，待与游人一路归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十五日游龙华净明两院值雨","author":"蔡襄","text":"垂杨修竹半藏山，一径纡回暮雨间。\n绿满野田看渺渺，白飞岩溜自潺潺。\n空村鲐背行歌去，古寺头陀乞食还。\n却羡幽人在深僻，断无来客扣禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十日西湖晚归","author":"蔡襄","text":"清晨出郭又晴曛，已见空枝嫩叶新。\n争得山头能阁日，且容湖上不归春。\n人随百戏波翻海，酒到三桥月满身。\n只有牡丹才半拆，未知何处可娱宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又寄兴化徐虞部","author":"蔡襄","text":"梅花狼籍拂轻舟，人日溪行动客愁。\n上昼去程初北首，故山归思满东流。\n垂垂朝雨随双桨，草草春蔬送一瓯。\n不独怀乡便多感，看人难似府君侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月再还家","author":"蔡襄","text":"晓树乡关路，春衣使者轺。\n江眠闻落霰，野饭掇新苗。\n入里威棱减，宁亲喜气饶。\n勤勤父师教，民病若为消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月诣陈逋民","author":"蔡襄","text":"振衣凌晓色，霁野纵游缰。\n莓润溪云重，春深山露香。\n林幽风更细，院静日偏长。\n曾是天皇外，相从识酒乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳日州园东楼","author":"蔡襄","text":"地上多于枝上花，东楼凝望惜年华。\n潮头正对伍员庙，燕子争归百姓家。\n粉箨渐高山径笋，绿旗初展石岩茶。\n流芳自与人兼老，樽酒相逢莫重嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元至南剑州大雨寄泉州许通判","author":"蔡襄","text":"路绕溪回不计程，行邮今复宿延平。\n阴云藏月不知处，急雨落天无数声。\n病起尚疑群蚁斗，梦馀初听一鸡鸣。\n泉山去岁同游赏，惟有神君识此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元进诗","author":"蔡襄","text":"叠耸青峰宝炬森，端门初晚翠华临。\n宸游不为三元夜，乐事全归万众心。\n天上清光开夜色，人间和气阁春阴。\n要知尽作华封祝，四十年来惠爱深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久寓悟空院刹行而书之","author":"蔡襄","text":"寂寂精庐切半空，古原高下稻花中。\n莲趺披素轻云梵，花萼雕红细雨宫。\n孤鹤睡迷千树月，断蝉吟绕五更风。\n心縻尺组遥相谢，归马南蹄疾似蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大湖驿寄建州同年窦职方","author":"蔡襄","text":"别驿临溪曲，清寒结晓阴。\n滩声生乱石，雨意在閒林。\n登第年华久，相逢礼爱深。\n茶山春物近，那得共追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广陵","author":"蔡襄","text":"广陵归客叹飞蓬，怀古伤离向此中。\n前世翻波那复问，十年弹指已成空。\n楼头画角催残日，城上寒鸦噪晚风。\n井径萧条人不见，又随潮信度江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其七","author":"蔡襄","text":"攒宫开七月，隧路闭千秋。\n地带三川拆，天含万国愁。\n鸟云知圣没，龙驾想神游。\n厚禄将无报，惭恩更白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其六","author":"蔡襄","text":"俭勤追禹绩，恭让体尧仁。\n措枉朝多直，除苛吏尽循。\n遵儒恩礼异，左戚赏刑均。\n立子知天意，超然即上宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其五","author":"蔡襄","text":"万世威神在，多方惠泽隆。\n密音通虏壤，行哭亦儿童。\n画翣离丹阙，幽堂对紫嵩。\n孤城空雨泣，白首抱遗弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其四","author":"蔡襄","text":"俭薄留遗诏，遵行在继承。\n桐棺会稽冢，瓦器孝文陵。\n阙外秋萤度，林端晓月澄。\n须知无可欲，终古不骞崩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其三","author":"蔡襄","text":"声教中原泰，恩仁万国临。\n忧勤符帝梦，付与得天心。\n箫吹凝寒气，云山敛夕阴。\n还期千载后，歌颂莫知深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其二","author":"蔡襄","text":"向近千秋节，何言七月期。\n遗恩群玉宴，往事荷宫祠。\n仙路云龙会，秋风鼓角悲。\n万人瞻彩仗，犹认吉行时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁宗皇帝挽词七首 其一","author":"蔡襄","text":"道德由来太古同，生灵休养至仁中。\n五兵不试归神武，万物无私是化工。\n玉座忽逢春月尽，金旌遥指洛川穷。\n年年翠辇长陪扈，那向西城别梓宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开州园纵民游乐二首 其二","author":"蔡襄","text":"节候近清明，游人已踏青。\n插花穿戟户，酤酒向旗亭。\n日迥林光润，风回海气腥。\n未知何处乐，归路已严扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开州园纵民游乐二首 其一","author":"蔡襄","text":"风日朝来好，园林雨后清。\n游鱼知水乐，戏蝶见春晴。\n草软迷行迹，花深隐笑声。\n观民聊自适，不用管弦迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙申五月游兴化西门上溪","author":"蔡襄","text":"寻溪因过上溪游，雨后溪浑水乱流。\n因傍堤松却飞盖，为闻山鸟辍鸣驺。\n平田䆉稏青云合，满谷芭蕉碧玉抽。\n开济无功须早去，故时瓜陇有通侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙申元日过浦城西阳岭","author":"蔡襄","text":"曾侍天王玉几傍，捲帘袍色殿中央。\n重霄未彻宫县乐，上宰初持万寿觞。\n晓日半临幡影转，春风遍送佩声长。\n今朝千里穿云岭，喜奉亲舆返故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬温","author":"蔡襄","text":"海曲封疆僻，冬温气序差。\n虫蛇谁闭户，草木自开花。\n雾重朝迷日，风号夕卷沙。\n可怜天地雪，偏解舞京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园登高即事呈诸同僚","author":"蔡襄","text":"江云寒薄不成霜，九月登高菊未黄。\n飞镝有声弓已力，小槽分溜酒初尝。\n秋容行见丹枫老，客意难胜紫陌长。\n曾是禁园风物好，故乡时节可能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司徒侍中宋宣献公挽词五首 其四","author":"蔡襄","text":"洛宅初开府，非才辱顾隆。\n遗思谣俗在，馀论宴堂空。\n已矣苍生望，嗟乎吾道穷。\n岂惟怀旧德，一恸向春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司徒侍中宋宣献公挽词五首 其三","author":"蔡襄","text":"怀道初名世，乘时遂致君。\n平分百年算，中据两台文。\n行翣连寒树，凝笳上晚云。\n路人那得识，挥涕指幽坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司徒侍中宋宣献公挽词五首 其二","author":"蔡襄","text":"申命增华衮，遗忠动紫宸。\n世风存令子，暮哭有慈亲。\n复辟前言在，论兵密疏陈。\n如何年不永，无路问苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司徒侍中宋宣献公挽词五首 其一","author":"蔡襄","text":"重器推隆栋，驰光逐逝川。\n人应骑尾宿，岁亦在辰年。\n文思精天下，忠谋尽帝前。\n唯无丰室累，清白是家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月池上","author":"蔡襄","text":"风下平池水晕开，池边露坐水风来。\n草香冉冉生吟席，云影飞飞度酒杯。\n荷叶偶成双翠盖，荔枝才似小青梅。\n人间物静两相得，月色苍凉始肯回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月巡历部郡侍亲还家","author":"蔡襄","text":"养亲方解郡，奉使又还家。\n远岫乡关近，前旌父老遮。\n挥金贫自愧，舞綵喜仍誇。\n特地延宾友，相期咏白华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰寒日游公谨园池","author":"蔡襄","text":"二月名园蓊郁青，为怜佳节此閒行。\n偶因觞咏心还适，暂离尘埃眼倍明。\n风静落花深一寸，日迟啼鸟度千声。\n主公高意何须道，芳物于人自有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴化军曹殿丞寄荔支","author":"蔡襄","text":"厚叶先枝新绛囊，使君分寄驿人忙。\n彩毫封处曾留意，筠笼开时不见香。\n风色甚豪应少损，路程差近得分尝。\n闽州纵有千千树，未抵家园气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因书答河东转运杨乐道","author":"蔡襄","text":"前岁君提岭外兵，国门南路送君行。\n由来成事多天幸，直向危时见世情。\n勉力朝廷论大计，甘心江海就私荣。\n牢愁应解侵人骨，未老先教白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵翠岩寺","author":"蔡襄","text":"揽蔓岩扃峻，交绳宝界平。\n斜峰约云势，乾树起秋声。\n泉槛妨蛩响，霜楼助月明。\n冥筌兼洒落，警句一何清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江头别杜殿丞","author":"蔡襄","text":"扬子江头南北路，木兰船上往来人。\n年华衮衮东流水，世事劳劳薄宦身。\n回首天涯成远别，忘怀物外自相亲。\n津亭共起忧时叹，重记津亭泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西郊","author":"蔡襄","text":"晓盖西郊道，春光极太虚。\n村风香晚稻，溪日曝寒鱼。\n雀噪饥鹰下，山空病木疏。\n归期侵杪岁，友思望吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观三圣御书应制","author":"蔡襄","text":"圣业存功德，宸毫冠艺文。\n势开千里浪，光动九天云。\n法驾乘时至，仙都与世分。\n皇心钦宝训，求治益精勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过天津桥","author":"蔡襄","text":"日暖溪平冰渐销，水声才下内前桥。\n山川满眼閒宫殿，草树迷人旧市朝。\n每向寻春偏有意，却成怀古更无聊。\n洛阳平昔多豪俊，惆怅埋魂不可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过杨乐道宅西桃花盛开","author":"蔡襄","text":"城隈绕舍似山家，舍下新桃已放花。\n无限幽香风正好，不胜狂艳日初斜。\n自怜马上空愁望，谁向樽前与醉誇。\n京国难逢春气味，莫随尘事度年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过泗州岭","author":"蔡襄","text":"二十五年间，三回共往还。\n那知临白首，相失向青山。\n想像音容在，侵寻鬓发斑。\n平生多善行，应不下尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过真慧素上人院见红薇盛开因思西阁后轩数株遂成短章寄翰林原叔八丈禹玉阁长兼书真慧壁间以记所遇","author":"蔡襄","text":"八月吴天觉早凉，翠丛初拆碎朱房。\n繁枝欲卧不胜力，落片将飞犹是香。\n西阁二年临昼梦，金刀一夕掩春芳。\n栏边想像频回首，渐觉星垣迥汉傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别邵武长史朱照邻","author":"蔡襄","text":"窃比君侯病駃騠，时看云路忽长嘶。\n十年还此同杯酒，三驿刚来踏雨泥。\n士行满乡元自好，官名当世不胜低。\n未沾釜粟荣新禄，应上亨衢别有梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴屯驿晓起","author":"蔡襄","text":"残月依山明胧?，长烟浮水白模胡。\n竹林绕舍啼鸦臼，石井当窗下辘轳。\n迎吏远传空状小，仆奴潜报一钱无。\n驺兵不管晨炊绝，呵叫苁笼意气粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋君辅许当世陈彦谦苏宣甫自远还乡上元同饮","author":"蔡襄","text":"故国逢君慰喜偏，清宵行宴重留连。\n山楼上火人初合，天汉无云月自圆。\n乐色时闻花院里，春风都在酒旗边。\n莫辞彻晓须沈醉，后会还应不计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋宣献公夫人毕氏哀词二首 其二","author":"蔡襄","text":"国赋虽千乘，身期未百年。\n箴图遗旧机，箫吹向新阡。\n行哭追前日，超生定几天。\n寂寥原上树，薄晚起寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋宣献公夫人毕氏哀词二首 其一","author":"蔡襄","text":"世阀推台路，嫔贤秉国钧。\n生缘随迹化，归处觉空真。\n训子清风在，传家令德新。\n九原终一致，悲喜尽成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汾阳夫人挽词二首 其二","author":"蔡襄","text":"借有百年在，都如一梦回。\n幻生还复灭，仙去不重来。\n乐色閒宵院，衣香秘夜台。\n行人知令淑，哭送侍儿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汾阳夫人挽词二首 其一","author":"蔡襄","text":"福偶天家出，贤名戚里推。\n朱颜不待老，万事却成悲。\n宿露沾新陇，秋风过旧帷。\n谁歌均一德，传继召南诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芜阴楼上","author":"蔡襄","text":"野马沈寒气，神禽度细风。\n断霞天共紫，斜日树齐红。\n山口横虚钓，江隈跋远艐。\n解穷千里目，争奈思无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诏贡士","author":"蔡襄","text":"星骑翩翩鹤诏来，旋闻欢语沸春雷。\n天闲未减真龙种，沧海还空老蚌胎。\n拂纸半毫含意劲，摩云双翅待风开。\n寄言商颍辟荣客，好致吾君放道回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮薛老亭晚归","author":"蔡襄","text":"终日行山不出城，城中山势与云平。\n万家市井鱼盐合，千里川原彩画明。\n坐上潮风醒酒力，晚来岩雾盖钟声。\n归时休更燃官烛，在处纱灯夹道迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王介夫游西禅兼呈黄承制","author":"蔡襄","text":"山城只有四围青，海国都无一点尘。\n荔子风标全占夏，荷花颜色未饶春。\n水边清吹传觞久，路上残阳立马频。\n不是閒来誇景物，欲将谣俗寄王人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和古寺偃松","author":"蔡襄","text":"古寺无人野藓滋，空庭永日雪风吹。\n横柯圆若张青盖，老干孤如植紫芝。\n万乘未轻蟠木器，千年终与大椿期。\n须知才短为天幸，江上婆娑得所宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙推官忆径山游","author":"蔡襄","text":"三十年前浙右行，径山才称爱山情。\n油幢??丝杉翠，环佩涓涓石涧鸣。\n极峻只疑天上党，遥临初觉地东倾。\n分符不得重游赏，碣石岩边记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和江上观潮","author":"蔡襄","text":"地卷天回出海东，人间何事可争雄。\n千年浪说鸱夷怒，一信全疑渤澥空。\n寂静最宜闻夜枕，峥嵘须待驾秋风。\n寻思物理真难测，随月亏圆亦未通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和许寺丞泊钓龙台见寄","author":"蔡襄","text":"钓龙台下舣行桡，猎猎船旗待晚潮。\n万里征人应怅望，一川秋色正萧条。\n雨云来去山明灭，风浪高低日动摇。\n有志四方男子事，莫怀乡国便魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴省副北轩湖山之什","author":"蔡襄","text":"谁于素壁写江流，云树疏疏映荻洲。\n尽日清虚全却暑，一川摇落似轻秋。\n暂逢明画心犹在，终向扁舟老去休。\n只有游鯈能自适，莫怀香饵重迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张唐公约游名园遇雪辄止","author":"蔡襄","text":"京尘官事日区区，拟出芳郊佩一壶。\n楼外阴云迎晓合，陌头霏霰与风俱。\n翩翩珍骑曾来否，种种名花更在无。\n若得纵游休秉烛，月中沈醉倩人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杜相公谢寄茶","author":"蔡襄","text":"破春龙焙走新茶，尽是西溪近社芽。\n才拆缄封思退傅，为留甘旨减藏家。\n鲜明香色凝云液，清彻神情敌露华。\n却笑虚名陆鸿渐，曾无贤相作诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]