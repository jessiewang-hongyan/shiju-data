[{"title":"望","author":"韦骧","text":"木落望始远，阴沈其奈何。\n遥山云四闭，飞雪两相和。\n天惨景愈短，楼高寒更多。\n凝然空引睇，鸿鹄不知过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴常甫移石","author":"韦骧","text":"千夫挽车载，无计奈人灵。\n惊起蛟蟠迹，空遗鸟篆腥。\n莫歌山有栲，始信物如萍。\n只爱坚姿峭，予眸为尔青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"韦骧","text":"突兀见升平，前非望汝灵。\n尘途虽阖眼，血刃不磨腥。\n气格希神岳，漂浮贱水萍。\n遇迁何足计，唯守自然青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残春 其一","author":"韦骧","text":"家近西湖日往还，恬然不觉到春阑。\n水边花发华丹尽，水面清光终未残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残春 其二","author":"韦骧","text":"休王其如各有时，开荣方遍又春归。\n东君忧在阳功乏，多少閒云天上飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞上","author":"韦骧","text":"塞草游驹犊，边城夜不关。\n健儿心亦礼，老将没于閒。\n岂见兵符走，唯闻象贡还。\n从兹徐绩比，不得冢前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初上汴舟思归","author":"韦骧","text":"夜气凄清星斗全，倚樯引望东南天。\n怀归重念秋垂尽，倦目羞看月又圆。\n况是汴流投浅涸，夫何单舸尚留连。\n京华岂谓无心恋，自恨孤踪远邃延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小饮楼上作","author":"韦骧","text":"西风吹酒面，楼阁近重阳。\n悔把菊枝插，幡思乡路长。\n比来求熟醉，到了减清狂。\n不是纷华少，纷华我所忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟晚行","author":"韦骧","text":"汴水日就浅，篙师心不皇。\n扁舟若无滞，旧里亦非长。\n残叶馀秋色，明霞接暮光。\n黄昏未停泊，独自倚危樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴上榆柳","author":"韦骧","text":"栽培芟治责官曹，官牒书为第一劳。\n擢干不知多少树，施功唯系万千艘。\n斧斤畏法谁能近，雨露流恩气转豪。\n今岁河堤新决坏，森然安用拂云高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归兴","author":"韦骧","text":"船头破浪疾如云，船上篙工勇力分。\n行色纵无笳鼓竞，归心急在旨甘勤。\n远山偶向斜阳见，幽雁偏从半夜闻。\n安得巨觥为大饮，乱浇乡思作醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入淮上","author":"韦骧","text":"汴水方穷到淮水，大船蹇蹇拒风行。\n不知静里千帆过，唯喜空中一派清。\n秋气已残山态老，夕阳未尽浪花明。\n牧儿随队閒无事，强作歌声和橹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自守","author":"韦骧","text":"薄仕功名未计高，懒随时辈强譊譊。\n推诚本在求诸内，害义何如寡所交。\n岂为初官寻要路，唯忧旧学长心茅。\n清贫我乐人毋诮，不独扬雄解解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"骧每恶晏起强酒二癖因作诗自警","author":"韦骧","text":"晏起已嗟为惰甚，讵堪酒病复相婴。\n未忧居养能移气，当念怀安实败名。\n便腹亦尝嘲睡癖，腐肠非是醉时清。\n辰乎径去谁能止，壮志毋宜恃晚成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感梦","author":"韦骧","text":"真人无梦梦非真，自愧通宵所梦频。\n凶吉有来皆系命，岂须占讯复劳神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴富川","author":"韦骧","text":"去年乾没道途间，今岁官期日月悭。\n学古虽然非为禄，食贫宁不厌居閒。\n利心汲汲人皆是，巧宦悠悠我不关。\n三尺若能多所活，尘泥何必贱青纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驻轩亭","author":"韦骧","text":"下马得危亭，江晴气象清。\n潮头千顷白，柳色万株明。\n风物应如古，登临独有情。\n行春始今日，今日不虚行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过桐庐县","author":"韦骧","text":"舟倚桐庐岸，春风草树明。\n经由今假道，潇洒旧闻名。\n山势侵云上，溪流见底清。\n兹行得佳味，夜枕听滩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过七里泷","author":"韦骧","text":"溪流一道突群峰，耆旧传为七里泷。\n唯喜幽佳忘世俗，不忧湍险赖篙工。\n鸟声喧滑春风里，人影稀疏翠色中。\n却惜扁舟不停泊，全输好趣属山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和红蕉","author":"韦骧","text":"欲赋红蕉拟象难，等夷未必下芝兰。\n霞飞翠岭分馀彩，凤宿青梧半露冠。\n举目尽知惊特秀，推诚谁解比含丹。\n莫教俗笔空传画，也作寻常润色看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公馀言怀","author":"韦骧","text":"荆扉栖息久，壮志未能摅。\n昨被半通绶，新持三尺书。\n虽然烦听讯，何足挠冲虚。\n伺隙馀公局，开编入燕居。\n敢希成大器，唯恐近污渠。\n心欲平冤狱，情奚病猾胥。\n贤门不多地，贱子幸投裾。\n每得高文贶，翻嗟旧业疏。\n自滋忘弃学，岂复怅离蔬。\n若使华无实，宁为蔽芾樗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和访古","author":"韦骧","text":"古人抱道重行志，未肯轻从碌碌居。\n孟子历为侯国客，退之三上相君书。\n心忘险阨高苏武，言极兴衰仰仲舒。\n试问渭滨如不遇，直钩何日得生鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月到官七月八日始并得家问二","author":"韦骧","text":"琐琐尘泥迹，悠悠远宦心。\n一朝何喜甚，连客得家音。\n义训通千里，人情贱万金。\n斜阳复东望，依旧暮云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红文苋","author":"韦骧","text":"色若栖文雉，圆如插绣幢。\n春葩应有并，秋卉合无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和董公肃十日菊二首 其一","author":"韦骧","text":"自是重阳过，重阳菊不迟。\n幽芳始经宿，群好奈随时。\n未减黄金蕊，何妨白玉卮。\n赏花非赏节，衰谢直为期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和董公肃十日菊二首 其二","author":"韦骧","text":"昨日堕乌纱，游欢等孟嘉。\n今晨举青眼，独自竞黄花。\n香冷朝犹盛，人疏势可嗟。\n明年又重九，何以面芳葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苦吟二首 其一","author":"韦骧","text":"夫子吟何切，辞源泻不枯。\n秋山凿寒玉，夜蚌抉明珠。\n感叹通前古，风情满五湖。\n只忧长寡和，白雪本高孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苦吟二首 其二","author":"韦骧","text":"骧也饶诗癖，才疏思每艰。\n持毫欲临纸，逐兽不知山。\n著意穷三百，唯时见一班。\n羡他唐老杜，气格独优閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"厅前丛竹","author":"韦骧","text":"软枝轻翠近檐垂，朝暮清风不失期。\n明月满庭无隐伏，夜深惟有此君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十四日夜月","author":"韦骧","text":"中秋垂一宿，延颈望金波。\n素魄虽微缺，清光已觉多。\n圆来殊俯近，观者尚蹉跎。\n明夕当如鉴，光华更几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十五夜","author":"韦骧","text":"八月得中节，今宵秋又中。\n由来金气王，向尽月华充。\n玩与多方共，清非别夜同。\n明皇如未死，依旧惑蟾宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六夜","author":"韦骧","text":"明月上天稽，中秋已过期。\n十分初减处，万目共怜时。\n不见昨宵盛，安知今夜衰。\n清光比他夕，犹胜满如规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏萤","author":"韦骧","text":"诗作东山事已赊，宵行今复动谁嗟。\n秋高党类纵横出，月黑光芒斗顿加。\n风触群飞迸星火，水澄乱影漾金沙。\n区区曾有分辉客，晋室寒儒本姓车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏水","author":"韦骧","text":"泽物施工讵可名，涓涓以及大川成。\n更逢卑处须流惠，有不平时即发声。\n倾侧祇将盈上准，毫釐宁向外边明。\n宣尼所取尤深远，盖取原充昼夜行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏竹","author":"韦骧","text":"此君坚直本天然，岂学妖花艳主轩。\n筠带轻霜凝不落，干磋圆玉碧无痕。\n非春长自繁枝叶，有地终须大本根。\n谁为裁音荐清庙，定胜嘉木就牺樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残灯","author":"韦骧","text":"寒窗夜将艾，一点映萧萧。\n燄向鸡声短，花随蝶梦凋。\n何须惜馀照，且喜近清朝。\n老婢不知此，荆钗屡屡挑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢董都官见寄","author":"韦骧","text":"区区贱质耻无闻，深荷明公曲爱存。\n谈席方忻接馀论，诗筒多谢遗佳言。\n辞源浩若江河泻，文意过于布帛温。\n听狱平反愿承教，异时安敢议高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再贶诗复以前韵答之","author":"韦骧","text":"愧将鄙句报多闻，操纸安能蔽所存。\n砚墨未乾忧见罪，笺封还枉却酬言。\n长吟不觉手之舞，熟览方知即也温。\n长者如兴起予叹，摄齐时愿一登门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏草","author":"韦骧","text":"萋萋广原上，苒苒曲江湄。\n人迹不到处，春风似有期。\n句牵碧成阵，蒙蔽密如丝。\n待看野火烈，百虫悲不悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻新雁","author":"韦骧","text":"夜堂危坐气凄清，秋月光中新雁鸣。\n出塞不知多少路，穿云才听两三声。\n归时行列应如旧，来处风烟合认程。\n今夕沙汀好栖息，弋人诡计未能成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙掌峰","author":"韦骧","text":"巨灵前事杳难评，融结皆由造化成。\n山历古今常似掌，地当西北是扶倾。\n擘开太华几千仞，指出飞鹏数万程。\n岁旱定须先展效，力推云雨救苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剪刀","author":"韦骧","text":"一身分二首，一首一铦铓。\n遇物无微细，交锋即断伤。\n剪齐繄汝锐，任用在君详。\n大抵便柔脆，毋令过所长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀","author":"韦骧","text":"西风潇洒作轻寒，黄叶楼中强解颜。\n画角几声催晚照，乱云何处是家山。\n宦途有立宁辞贱，局事无多岂厌閒。\n浊酒一杯休万虑，长林烟暝暮鸦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴河","author":"韦骧","text":"通济名渠古到今，当时疏导用功深。\n源高直接黄河泻，流去遥归碧海浔。\n护冢尚存芳草乱，隋舟安在绿杨阴。\n年年漕运无穷已，谁谓东南力不任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄河","author":"韦骧","text":"四载收功故道循，滔滔千古势无垠。\n流知江海涵容大，静觉乾坤覆焘均。\n未必昆崙独倾注，祇安河汉共濆沦。\n如何骑得鲸鱼背，直到天涯一问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和聂充甫晨霜","author":"韦骧","text":"勿异繁霜早，园林已具腓。\n陨时兼夜气，凝处张寒威。\n月落初分白，阳升还尽晞。\n棱棱不终日，由此识天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东庵院","author":"韦骧","text":"闻说东庵在庐岳，浮屠百数独无双。\n堂阴翠色连危嶂，门外清光挹大江。\n怪石巑岏坐龙虎，老松突兀树旌幢。\n何时得对幽佳趣，摆脱尘襟酒满缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和聂充甫冬晓初起","author":"韦骧","text":"霜月孤光在，寒鸡一唱催。\n晨兴衣未煖，夜诵帙犹开。\n乡梦还千里，愁肠过九回。\n浚明何所立，缇室又飞灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"习曹何君屡有引年之语而未暇请今兹官满解去骧作诗言其荣以壮其志惟僚友不异幸同辞以助之","author":"韦骧","text":"容容贵富此胡为，可止能归即可师。\n家住岭南谋退老，官休江左正其时。\n相从禄仕材诸子，得谢乡闾似者谁。\n赢取林泉长日月，为君潜计乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司马南楼纳凉","author":"韦骧","text":"溪外层楼入翠微，登临炎酷杳如遗。\n千山相掩云争出，万浪欲光风倒吹。\n摆脱尘纷得危坐，牢笼清旷就新诗。\n短衣野老遥相目，应怪官閒亦有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾中甫送庆甫弟来尉永兴久之告归仆多其来而重其去乃为诗以送之","author":"韦骧","text":"仲弟安居后，先庐忆故乡。\n暌离何足惜，气义已为光。\n远址他年见，归心千里长。\n西风吹别酒，为赋脊令章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾庆甫以局事乘小船犯风波感其危而为诗且以相示仆亦于舟字韵和呈其卒章盖言有俟以慰贤劳之叹也","author":"韦骧","text":"万顷风波一苇浮，发巢犹稳羡蒙鸠。\n唯余忘胆惊其说，况子轻身坐此舟。\n轲戒立墙虽孝节，尊曾驱阪本忠谋。\n小官辛苦宜无念，自古高贤达以忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公閒念诗社之废寄陶贾二同僚一首","author":"韦骧","text":"地僻少将迎，溪山一概清。\n秋深孟嘉宅，岁古阖闾城。\n吏隐全输我，诗豪半属卿。\n社坛何冷落，濡笔请寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后","author":"韦骧","text":"西风吹雨过江城，林馆秋浓气转清。\n扫叶堆枯阶半没，步畦经润履无声。\n拒霜欲蕊扶疏翠，暮雀争栖格磔鸣。\n贱局安閒出天幸，未须多口论功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见省符知有代官一首","author":"韦骧","text":"寸禄固拘挛，区区顿豁然。\n比来符檄至，代者姓名传。\n公事多閒日，归期不及年。\n喜情通梦寐，累夕拜亲前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陶掾见寄","author":"韦骧","text":"寂默公閒外，新诗忽见撞。\n比来知燕坐，时得近秋窗。\n临弈誇能胜，持杯学诈降。\n相逢怯此病，继晷请然釭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待拒霜开一首","author":"韦骧","text":"予怜拒霜好，独立冠彫穷。\n故腊新移至，今年曲爱隆。\n栽培曾倩圃，灌溉每呼僮。\n覆护障炎日，枝撑禦暴风。\n欲高歼隘叶，待盛拓芳丛。\n不取蒿莱蔽，那妨雨露濛。\n翠行疏密等，微径往来通。\n恐折频驱雀，忧衰屡灭虫。\n清秋方淡薄，碧蕊已玲珑。\n占表如争胜，藏身若养蒙。\n绿幢擎蓶扈，圆玉琢青葱。\n美操寒中辨，丹心日已充。\n不甘为菊后，渐见出篱东。\n虽本生成力，宁非养治功。\n从容延晚节，次第待轻红。\n肯学杨花雪，悠悠负主翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陶掾书斋小饮","author":"韦骧","text":"学非焉用赘多多，养浩当须继孟轲。\n把酒相欢外纷扰，吟诗大句破妖魔。\n坐中谁作向隅泣，天下今无扣角歌。\n圭绂巍巍君勿羡，安知此乐不如他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日即事呈同僚","author":"韦骧","text":"潇洒临霜夕，清居守决曹。\n严城吹角罢，隔垄听猿号。\n警卒持更切，呼囚报钥牢。\n讼庭澄一水，尘事戢千毛。\n檐阒蚊雷绝，池虚蛙吹逃。\n逍遥静襟虑，抖擞敞袛裯。\n树木彫零尽，星辰气燄豪。\n月微棕影薄，风急雁声高。\n忆昔随群学，当时髧二髦。\n读书图皦皦，感古动忉忉。\n意趣青云近，煇光白玉韬。\n百钱宁问卜，一钓冀连鳌。\n直谅谋相与，回邪欲尽鏖。\n自期非干蛊，幸遇岂屯膏。\n翻愧彫文陋，难逢异数褒。\n葳蕤从末宦，淟涊著青袍。\n敛翅鹰栖臂，垂头骥伏槽。\n安能枉寻尺，犹得饱藜蒿。\n但恃心如砥，那矜目察毫。\n穷通任甄治，险恶远波涛。\n养浩虽潜孟，折腰诚愧陶。\n常咍强蛇足，敢叹抑牛刀。\n衮衮途泥里，悠悠日月慆。\n居然成俗态，何足谓贤劳。\n贫贱非无赖，清平况夙遭。\n边隅虚障候，弓矢载鞬櫜。\n途易家音数，官閒坐食叨。\n人皆讥野僻，我独固持操。\n寂寞几尘甑，包并或餔糟。\n趋时聊勉勉，乐道每嚣嚣。\n肺腑兹尤慰，朋从义不謟。\n相逢甚优渥，得兴且游遨。\n胜赏当随地，秋郊况附壕。\n山溪正堪屐，溪曲尚容舠。\n莫计空清俸，须令贳浊醪。\n菊香分嚼蕊，蟹美共持螯。\n谈席争挥麈，诗坛让拥旄。\n纵横新义论，嗣绝旧风骚。\n气锐千戈立，辞抽万茧缫。\n功名休挂齿，志业本夔皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣赦回马上口占","author":"韦骧","text":"黄纸恩书下紫宸，岂惟群罪许从新。\n其间多少宽民意，四海承宣有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月暮登延寿阁","author":"韦骧","text":"湖水渐如带，扁舟渡亦艰。\n山空翠屏浅，荻老雪花残。\n立马寒烟际，登楼霭暮间。\n严闉促回辔，吏隐乐终悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓坐","author":"韦骧","text":"晓鼓韸韸日欲升，寒厅危坐对前楹。\n霜威著树琼瑶色，雁阵横空风雨声。\n自喜优游服王事，那嗟寂寞滞山城。\n栖栖院吏公衙退，却就书帷万虑清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜射通叔虞曹圃","author":"韦骧","text":"束苇然膏百炬红，夜堂寒气变春融。\n流星半没飞金镞，缺月初圆引角弓。\n赏罚明如棘门上，和融远过泽宫中。\n平心不为长眉醉，慷慨真成壮士风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辨诈","author":"韦骧","text":"远俗无知祗慕恩，凿山踰岭献麒麟。\n诸儒不用区区辨，多少难明伪似真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]