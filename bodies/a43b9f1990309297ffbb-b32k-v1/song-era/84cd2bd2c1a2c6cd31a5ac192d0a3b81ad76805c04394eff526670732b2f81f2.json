[{"title":"晓步","author":"李缯","text":"晓步閒随蛱蝶行，村南村北雨新晴。\n山花野草自幽意，布谷一声春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郢州堂唱和","author":"李褒","text":"不离雉堞似山家，消得诗翁著意誇。\n水界葱芊成畎浍，天将平远入烟霞。\n沙禽暂落分明见，村径相通取次斜。\n且莫向南舒望眼，尘埃阛阓事如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"李遵勖","text":"雷海谭音出世雄，台岩香社冠禅丛。\n红炉点雪灵机密，翠径斑苔道步通。\n珠水滤罗晨漱净，豉莼萦箸午斋丰。\n归帆已应王臣供，金地天龙绕旧宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望汉月/忆汉月","author":"李遵勖","text":"黄菊一丛临砌。\n颗颗露珠装缀。\n独教冷落向秋天，恨东君不曾留意。\n雕阑新雨霁。\n绿藓上，乱铺金蕊。\n此花开后更无花，愿爱惜、莫同桃李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滴滴金","author":"李遵勖","text":"帝城五夜宴游歇。\n残灯外、看残月。\n都人犹在醉乡中，听更漏初彻。\n行乐已成闲话说。\n如春梦、觉时节。\n大家同约探春行，问甚花先发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 题高克恭夜山图","author":"李震","text":"楼据湖山背。\n倚高寒、尘飞不到，越山相对。\n老月腾辉群动息，独坐清分沆瀣。\n更满听、潮声澎湃。\n醉里诗成神鬼泣，景苍凉、又在新诗外。\n浑忘却、功名债。\n凭谁妙笔能图绘。\n羡中郎、前身摩诘，宛然心会。\n拈出清宵无限意，半幅溪藤光怪。\n方信有、人间仙界。\n云淡天低奇绝处，笑僧殊、未识丹青在。\n留此轴，夸千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟泊太湖","author":"李颙","text":"旋经义兴境，顿棹石兰渚。\n震泽为何在，今惟太湖浦。\n圆经萦五百，盼目眇无睹。\n高天淼著岸，长津杂如缕。\n窈窕寻湾埼，迢递望峦屿。\n惊飙扬飞湍，浮霄漾悬岨。\n轻禽翔云汉，游鳞憩中浒。\n暗霭天时阴，峣岧舟航舞。\n冯河安可徇，静观戒行旅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李颙","text":"黯䨴重云阴，碎棱震雷咤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登中梁山 其二","author":"李儒用","text":"路入梁州如砥平，登高远目更增明。\n霜清木落千山瘦，潦尽江空一水横。\n岁稳未宽忧国志，时危转切望乡情。\n英雄千载兴王地，孺子堪怜此曳兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登中梁山 其一","author":"李儒用","text":"浩荡秋风使节归，南山重与北山违。\n自来人物瞻乌帽，更共宾僚款绿衣。\n秦地关河才咫尺，汉都风景尚依稀。\n壶浆迎处多遗老，绝叹登坛往事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又口占小诗五首 其五","author":"李壁","text":"少年缪许忧时策，万里空怀报主心。\n毕竟穷通吾有命，鸥盟未冷且重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又口占小诗五首 其四","author":"李壁","text":"四海同心阎贰卿，两公相对眼长青。\n从今太史灵台夜，定奏梁州聚德星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又口占小诗五首 其三","author":"李壁","text":"岁月翩翩比掷梭，从公能几别离多。\n梁州此去千山阻，病鹤无因借一柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又口占小诗五首 其二","author":"李壁","text":"蝉连夜语不胜清，攲枕僧窗蜡炬明。\n早是宋公怀抱恶，更禁庭树作离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又口占小诗五首 其一","author":"李壁","text":"归传匆匆一过家，驿亭回首见梅花。\n绝知天汉朝宗近，去去方乘犯斗槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子金舅出示雁湖和章走笔为谢三首 其三","author":"李壁","text":"龙山仙去参谋死，纵有奇文欲似谁。\n前辈风流只公在，不才我定愧牢之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子金舅出示雁湖和章走笔为谢三首 其二","author":"李壁","text":"词源病起不全枯，一滴犹堪涨雁湖。\n祇我少强宜末减，老人笔力更敷腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子金舅出示雁湖和章走笔为谢三首 其一","author":"李壁","text":"运数从来略相似，人人总道疾堪忧。\n岂知不死还相对，更把新诗互唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东山精舍","author":"李壁","text":"木落天清远岭多，水平烟尽镜新磨。\n周公谢傅皆尘土，病鹤闲来借一柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石中二首 其二","author":"李壁","text":"梅阴渐密雨晴时，静看花砖日影稀。\n向晚啼鸦来又去，上林知占那边枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石中二首 其一","author":"李壁","text":"云影沈沈玉一方，倚栏人意似濠梁。\n独怜雪里山茶树，也向春风伴海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买花","author":"李壁","text":"风格孤高却后时，夜来律管已灰吹。\n无端红紫偷先发，未见琼瑶第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"在唐安郡圃作","author":"李壁","text":"当年张李国长城，翻向天涯问大钧。\n争似圣朝公道在，庙堂端要读书人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题","author":"李壁","text":"深院锁蛾眉，黄花一两枝。\n晚来天气好，浑似早春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观雁湖经行留题","author":"李壁","text":"溪作玉膏色，洞如天琢成。\n倩谁呼白鹿，将我上瑶京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邢台","author":"李壁","text":"北地霜浓九月寒，驼裘破晓上征鞍。\n也知骨相非麟凤，惭愧州人向掌看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赤壁","author":"李壁","text":"赤壁危矶几度过，沙头江上郁嵯峨。\n今人误信黄州是，犹赖水经能正讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"使金诗","author":"李壁","text":"天连海岱压中州，暖翠浮岚夜不收。\n如此山河落人手，西风残照懒回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"李壁","text":"沙上翩翩两白鸥，西风想见芰荷秋。\n晚来十幅冰纨净，断取潇湘一片愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青云亭 其二","author":"李壁","text":"青云歧路休回首，扁榜看来也自惊。\n何日深山更深处，只留黄犊伴春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青云亭 其一","author":"李壁","text":"谁人此地著危栏，城郭江山表里看。\n时节不知春已半，天围稍觉目前宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青云亭 其三","author":"李壁","text":"平林野水带孤城，倦客登临太瘦生。\n过眼千花竞红紫，可怜霜鬓转分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临川节中寄季和弟 其一","author":"李壁","text":"敕使传宣泛食时，去年今日侍龙墀。\n江城牢落追前事，一寸丹心只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临川节中寄季和弟 其二","author":"李壁","text":"平生旷达慕庄周，老觉悲来不自由。\n节里忆君频梦见，遥传掬泪过江州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌丹亭","author":"李壁","text":"犹忆儿时共酒杯，今看灵骨琐苍苔。\n祇应解化元非死，万一排空为我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题东屯诗四首 其四","author":"李壁","text":"早日皋夔许致身，最怜一饭不忘君。\n飘零岂意穷山里，目断长安隔戍云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题东屯诗四首 其三","author":"李壁","text":"作意元非谷口耕，后来更说以诗鸣。\n慇勤只有香溪在，曾照先生白发茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题东屯诗四首 其二","author":"李壁","text":"连峰叠嶂拥峥嵘，个里谁知掌样平。\n还有人家留客醉，石榴花下听啼莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题东屯诗四首 其一","author":"李壁","text":"千载风流表出师，帅龙山寺已题诗。\n两贤心迹元无异，更谒东屯老拾遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笼鹄山房","author":"李壁","text":"萧条白石闭严扃，留作游人万古情。\n犹有山中旧麋鹿，举头如听读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"距建德县十里绝一小湖滨湖小山多可爱作诗记作见三首 其三","author":"李壁","text":"苍崖古木插奫沦，薄暮丛祠亦恐人。\n波面时闻声扑碌，祇应神物是游鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"距建德县十里绝一小湖滨湖小山多可爱作诗记作见三首 其二","author":"李壁","text":"小山低映碧璘珣，十顷平湖蹙簟纹。\n可惜地偏人到少，西风白乌自成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"距建德县十里绝一小湖滨湖小山多可爱作诗记作见三首 其一","author":"李壁","text":"肩舆触热汗沾衣，晚渡呼舟去若飞。\n两腋飕飕清镜里，分明列子御风归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩和韵三首 其三","author":"李壁","text":"萧然陈迹寄林坰，千古谁分伪与真。\n惟有离宫歌舞地，遗簪坠珥付耕人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩和韵三首 其二","author":"李壁","text":"选胜宁辞屐齿尖，摩挲墨妙半儒先。\n八年两到人争问，香火灵山似有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩和韵三首 其一","author":"李壁","text":"觚棱木杪梵王宫，路转峰回翠扫空。\n胸次净无尘一点，乱云堆里听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其七","author":"李壁","text":"方琮分润作幽姿，一点檀心说向谁。\n正使持来供鼎事，输他雪外两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其六","author":"李壁","text":"姑射仙人尔匹侪，若为涂额效宫娃。\n从来定价须平子，速剪繁枝送郡斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其三","author":"李壁","text":"剪蜡霜前色太深，何如万萼占春阴。\n今朝懒不行花径，插遍铜彝供石林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其五","author":"李壁","text":"天留孤艳照青春，横目何人解识真。\n蒸栗琢成渠不爱，内间栀貌几番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其二","author":"李壁","text":"春风一树斩新开，尽日花边转几回。\n怪底玉颜含瘴色，谪仙曾住夜郎来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其一","author":"李壁","text":"树绕高花兀老苍，风流旧日汉黄香。\n虽非有意争妍暖，岂是无心避雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其四","author":"李壁","text":"满园春物正关情，忽到梅边眼倍明。\n别有醉馀霞脸在，大都风格尽飞琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈姥岩","author":"李壁","text":"洗尽一春歌酒尘，苍江吹破碧粼粼。\n繁华过眼都如梦，祇有三峰是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬曾景建","author":"李壁","text":"新有千丝明晓镜，旧无一画赞宵衣。\n閒吟此外惟须饮，老觉人间万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅数枝托悟上人持供南囿","author":"李壁","text":"色染蔷薇水麝薰，静中时有暗香闻。\n上人生怕花料理，未信真能恼石君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清虚庵皇甫真人坦之隐居","author":"李壁","text":"翠麓依然似梦中，拨云轩槛正春风。\n安知松外双飞鹤，不是桃椎与吕翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题跋黄鲁直读书岩字二十言","author":"李壁","text":"笔法推黄子，钟王共一机。\n试摹三大字，归榜旧岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十九日游桃李村分韵得春字","author":"李壁","text":"东风吹我出城闉，邂逅相逢得可人。\n踏雨先从沙路稳，怯寒更觉酒壶亲。\n江山有意如违俗，桃李无心亦自春。\n便可名为锦绣谷，匡庐东望隔烟尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下岩","author":"李壁","text":"破晓樯竿插钓矶，一生几度扣禅扉。\n心如尊者岩中定，身比涪翁僰道归。\n阅世云藤那解老，近人空翠欲成围。\n祇怜岁晚龙方卧，不放银涛百尺飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中岩","author":"李壁","text":"尘土污人绝可怜，宝坊聊共炷炉烟。\n高怀已属三峰上，旧事重寻千载前。\n暖吹静翻花漠漠，晚云深护竹娟娟。\n祇应难见惟神物，留取新诗结旧缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予赋雁湖诗蒙友社诸文继声不一辄复自和四首 其四","author":"李壁","text":"栏楯相望咫尺间，翻沟送水助潺潺。\n王家传里乌衣巷，梦得诗中碧玉环。\n好看画船来泛月，何须蜡屐去寻山。\n时人不解开湖意，便道渠侬苦爱閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予赋雁湖诗蒙友社诸文继声不一辄复自和四首 其三","author":"李壁","text":"闲来日日理荒馀，剩引涟漪一派俱。\n试把渔竿临断岸，从教画手貌成图。\n啼春不到莺无友，警夜谁知雁有奴。\n出处须将时运看，莫分廊庙与江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予赋雁湖诗蒙友社诸文继声不一辄复自和四首 其二","author":"李壁","text":"比屋弦歌说此间，诗来清似玉潺潺。\n论交有道须簪盍，经世无才敢辄环。\n剡上最怜分一曲，海边空自说三山。\n谁能伴我湖亭宿，夜静遥占斗柄閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予赋雁湖诗蒙友社诸文继声不一辄复自和四首 其一","author":"李壁","text":"少年努力在三馀，暇日那无水石俱。\n自昔空传盘谷引，祇今何似辋川图。\n伴人寂寞为鹇客，登俎横斜有蟹奴。\n便学天随君信否，夜来春涨欲平湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十四日二首 其二","author":"李壁","text":"为问微园绮，何如唤孔宾。\n好山时步屧，幽涧或垂纶。\n尘远知仙近，人疏觉道亲。\n晚来微雨过，翠色媚松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十四日二首 其一","author":"李壁","text":"山色朝尤爽，溪声夏亦寒。\n蹇予资固陋，所得是平宽。\n庭日荒苔藓，林风老蕙兰。\n石床聊可借，白月在松端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东帅张传之遣人来相致将以七言次韵答之三首 其三","author":"李壁","text":"愧无庭论发奇樽，闲放骚人大小言。\n徐孺真能下蕃榻，孔公尚记出膺门。\n赤霄览德聊追凤，沧海寻仙更踏鲲。\n华发萧萧公健在，一将金奏洗哇繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东帅张传之遣人来相致将以七言次韵答之三首 其二","author":"李壁","text":"阆风当日奉清樽，犹记银钩洒七言。\n别去凄凉浑一梦，只今疏懒且衡门。\n已非绝足那希骥，自比游尘或佐鲲。\n珍重曲江劳仰止，人间岁晚雪霜繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东帅张传之遣人来相致将以七言次韵答之三首 其一","author":"李壁","text":"质非高古谢罍樽，漫向陈编挹圣言。\n久判馀生甘扫墓，尚怀先友欲登门。\n功名自昔归羊傅，丘壑从来著谢鲲。\n何日扁舟渑若去，眼看荔子压枝繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其十","author":"李壁","text":"景色随生指顾间，踏翻香雪弄潺潺。\n奏编谁上三千牍，宝带争拖十二环。\n有底穷愁惟甔石，无多远意但盆山。\n何时万顷沧波去，乞我扁舟自在閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其九","author":"李壁","text":"梦镜纷纭扰弃馀，尚连许国守心俱。\n投鞭绝笑保边策，聚米重寻破陇图。\n天外悠悠回雁使，眼前扰扰牧猪奴。\n移床试向春风坐，面旋飞霙卷一湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]