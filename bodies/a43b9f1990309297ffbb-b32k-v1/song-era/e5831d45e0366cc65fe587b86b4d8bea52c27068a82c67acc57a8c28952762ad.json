[{"title":"试陈瞻墨十绝 其四","author":"李之仪","text":"大患于吾为有身，纵横颠倒竟谁神。\n祗应静处天真在，且作斯须自在人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其五","author":"李之仪","text":"雉堞回环半倚山，泉声风顺响潺潺。\n从来省事惟便静，他日端能忆此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其六","author":"李之仪","text":"春来多病圣频中，歌曲双青笑拂红。\n今日闭门常静坐，始知身世已衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其七","author":"李之仪","text":"万口弥陀未饭前，西方境界每依然。\n何须更学王文度，那处元非极乐天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其八","author":"李之仪","text":"今年四月未闻雷，赤地从何问宿灰。\n剑戟埋身均是死，生憎逋欠踏门催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其九","author":"李之仪","text":"十年不去有如何，得少何须较失多。\n大是驹奴必千里，功名他日莫渠魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其十","author":"李之仪","text":"卧听风声坐见山，此生长寄有无间。\n等閒撇起能知病，莫厌萧萧雪满颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵次卿林下行歌十首 其一","author":"周紫芝","text":"风吹苏小门前柳，雨暗罗敷陌上桑。\n遥想锦江春色暖，被花恼得少陵狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过玩鞭亭再见吉先之","author":"李之仪","text":"姑熟溪头近请违，玩鞭亭上再相期。\n留连话旧忘尘虑，把盏枰棋得自怡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杏花白鹇","author":"李之仪","text":"朝来雨过发妖妍，向日枝头雪作团。\n缟练长拖轻洒墨，不须将作两般看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹鹤","author":"李之仪","text":"瘦玉萧疏触处宜，仙风一霎散霜威。\n未应舞罢排云去，更看丹砂理雪衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄精鹿","author":"李之仪","text":"绿遍前峰到后峰，灵苗压地几千重。\n勾班养就无人见，多少狂心欲采茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷叶龟","author":"李之仪","text":"翠盖相扶两不攲，多情独许见阳窥。\n千年自有逃形处，聊与清香暂约时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠崇扇面小景二绝 其一","author":"李之仪","text":"耳冷无人唱竹枝，归心惟有梦魂知。\n杨花扑地烟波阔，犹记征帆欲卸时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠崇扇面小景二绝 其二","author":"李之仪","text":"风高雨暗不成群，欲下还飞似畏人。\n已是却寻归去路，江南休笑水如春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读华严经三绝 其一","author":"李之仪","text":"纷纷作客不归来，树本无根何处栽。\n弹指未应超十地，重重楼阁一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读华严经三绝 其二","author":"李之仪","text":"老境侵寻上砌苔，自然生意不应栽。\n便应烈日鳞潜去，能得愁怀几度开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读华严经三绝 其三","author":"李之仪","text":"法令端如万仞陂，后来无法只趋时。\n早知兴废无非命，可笑穰侯见事迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其一","author":"李之仪","text":"雨后阶庭物物新，睡馀攲枕悄无闻。\n只疑日脚随人意，百刻香才过一分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其二","author":"李之仪","text":"帘波不动地无尘，久与相亲燕雀驯。\n似怪衰翁长静坐，时时回眼辄疑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其三","author":"李之仪","text":"未逢四祖且堆堆，才见龙潭眼便开。\n龙去潭空人自老，衔花百鸟漫飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其四","author":"李之仪","text":"闭门不语信深沉，岂可讥时作酒箴。\n料得门前无好事，解嘲聊复寄初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其五","author":"李之仪","text":"不堪细字眼犹花，熟睡分明暂到家。\n何独能收小儿泪，客中时可当乘槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其六","author":"李之仪","text":"玉壶试叫鸳鸯语，为问仙家似此无。\n养就丹砂早归去，不妨閒处作工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其七","author":"李之仪","text":"大人相好一百种，几劫修来得到今。\n不独普贤能演说，淘沙个个得精金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其八","author":"李之仪","text":"万里无云天一色，单衣不试似初春。\n鸽鸰习习游丝坠，未必他时得此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其九","author":"李之仪","text":"歌词漫与收狂念，诗句聊将代欠伸。\n钩棘徒劳刳胃肾，笔头才住已成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学书十绝 其十","author":"李之仪","text":"心非可见舌能陈，随语成章自有神。\n用作功名终底事，区区雕琢定痴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人李世南画秋山林木平远三首和韵 其一","author":"李之仪","text":"晚烟拂拂聚无痕，瘦骨棱棱见彻根。\n细路萦纡饥马疾，举头新月是前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人李世南画秋山林木平远三首和韵 其二","author":"李之仪","text":"曾经岁月几华夷，雨貌风颜茂晚姿。\n自是雪霜心共老，笔头聊复戏孙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故人李世南画秋山林木平远三首和韵 其三","author":"李之仪","text":"霜清木落见沙洲，洲上人家半在舟。\n射雁归来鱼满笱，瓮中先见问扶头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出院有期","author":"李之仪","text":"亲旧相逢似隔时，从今无复念归期。\n莫同更写留连恨，只拟添成百首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和观画三首 其一","author":"李之仪","text":"扫除不尽自无痕，底事狂缘尚有根。\n几日宁宁图画里，祇缘归思在江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和观画三首 其二","author":"李之仪","text":"何时船上载鸱夷，海道聊寻一问姿。\n不为丹青生着相，从来卷曲是吾枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和观画三首 其三","author":"李之仪","text":"欲问船师觅宝洲，须将大瓠作腰舟。\n掀天白浪蛟龙吼，才得随流一点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其一","author":"李之仪","text":"霅上归来过了春，枝头杏子可尝新。\n旋追老酒医佳况，更谢提壶解劝人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其二","author":"李之仪","text":"一春霖雨不曾休，雪雹惊人四月头。\n初制单衣方待着，却添炉火换重裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其三","author":"李之仪","text":"梦回檐滴不闻声，残月披窗分外明。\n投老逢春能几许，不堪催去与谁争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其四","author":"李之仪","text":"扶老相邀到陇头，麦苗如洗未全抽。\n愿天不雨只一月，聊慰艰辛望半收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其五","author":"李之仪","text":"栽桑插柳展沟塍，共趁清明力倍增。\n分得这般穷伎俩，却应苦行过于僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其六","author":"李之仪","text":"修车浸种一番忙，肚热邻家见早秧。\n饱饭未惊心已饱，方知生计要商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其七","author":"李之仪","text":"一生着得几䩫屐，一饱消得几多粮。\n怕雨望晴心不歇，白头搔尽眼望羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其八","author":"李之仪","text":"须知官职为他人，老去何妨可问津。\n宾客欢娱童仆饱，到头活计定谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其九","author":"李之仪","text":"从来人说水晶宫，投老方能到眼中。\n未必吾生便休去，溪山隐去再相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十","author":"李之仪","text":"鹅儿成队草成茵，来往驯鸦喜趁人。\n却恐城中无此况，莫辞辛苦且逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十一","author":"李之仪","text":"亹亹柔条动懿筐，森森初穗弄微黄。\n引雏飞去蒙朝雨，带犊归来卧夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十二","author":"李之仪","text":"东囤扫场方暂歇，插秧车水又相催。\n衰年乐得身强健，常愿南山到眼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十三","author":"李之仪","text":"芦已藏人水鸟喧，草堪留坐午风寒。\n从来偏得田家趣，折莫催归兴已阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十四","author":"李之仪","text":"雨后西风日日颠，重裘犹自觉轻单。\n春寒秋热江南候，四月如何尚有寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十五","author":"李之仪","text":"转午风休陡觉来，绵衣脱尽旋开轩。\n乍寒乍热难调御，厚薄随时体自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十六","author":"李之仪","text":"见事迟来五十年，何须投老念艰难。\n暖衣饱食无过此，谁是鲇鱼上竹竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十七","author":"李之仪","text":"饭舂罗担雁行来，任是囷廛亦易推。\n一岁艰难方有味，较量犹胜上燕台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十八","author":"李之仪","text":"朝衣行市头颅落，六印垂腰手足分。\n旋煮河豚加鲚脍，争如閒处醉醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其十九","author":"李之仪","text":"荷钱贴水蚕如蚁，稻似针芒葚未丹。\n牛角叩残歌转急，请看平地有波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其二十","author":"李之仪","text":"百事无能一老夫，十年江上把犁锄。\n西庄南亩时来往，常得青山在坐隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其二十一","author":"李之仪","text":"青山于我岂无因，到处抬头便见亲。\n时更一班逢好句，玄晖端恐是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其二十二","author":"李之仪","text":"坐啸宣城迹已赊，青山今日属寒家。\n多情宾客门如市，不独风流解染花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其二十三","author":"李之仪","text":"数亩田荒积渐耕，常忧坝损害垂成。\n传闻赵魏推盟主，便觉如云照眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路西田舍示虞孙小诗二十四首 其二十四","author":"李之仪","text":"水已平堤柳已线，洞房犹记锁婵娟。\n彩云易散春常在，啼鸟留人尚可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙宠惠朋樽深佩眷意聊奉一噱","author":"李之仪","text":"万国衣冠拱醉容，钧天梦断失云龙。\n多情尚寄当时约，宛似阇黎饭后钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯成已归尚阻雨会聚聊申短唱容易一笑","author":"李之仪","text":"髯友新从塞上回，中元樽俎未能开。\n更堪庭竹添幽思，只欠清风玉雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试笔柬赵德麟二绝 其一","author":"李之仪","text":"河朔初辞爨析骸，都城还许谢烦埃。\n日长穷巷春归后，万绿阴阴锁吹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试笔柬赵德麟二绝 其二","author":"李之仪","text":"窗间多病委枯骸，陌上初收雨后埃。\n公子风流过京兆，正堪眉妩傍妆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵见寄两绝 其一","author":"李之仪","text":"江湖流落久相依，每叹朱颜戏彩衣。\n何事泪痕书上见，他年千陇约同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵见寄两绝 其二","author":"李之仪","text":"七分年纪十分愁，物理乘除不自由。\n死葬生游今得地，却嗟无计共迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠人","author":"李之仪","text":"双双小叶衬花房，只斗花房不斗双。\n拾得不教同伴见，袖中拈出一齐降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和仇粹夫 其一","author":"李之仪","text":"曾寄冰绡十幅开，竹间红蕊燕衔来。\n黄筌已去风流尽，忽见诗翁笔下催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和仇粹夫 其二","author":"李之仪","text":"面面轩楹压水开，暑天端恐雪飞来。\n冰肌玉骨元无汗，更倩殷勤执板催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祈泽寺龙池","author":"李之仪","text":"池方一寻深寸许，泉脉涓涓萦砌台。\n闻道旱天能作雨，定应变化自何来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题虞氏外孙扇","author":"李之仪","text":"处己莫辞三径陋，读书须及五车多。\n成吾宅相非吾志，直欲丘门备四科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题二绝 其一","author":"李之仪","text":"投老还家髀肉消，霜天何处换金貂。\n一樽帝所欢犹在，翻恐醒来尚寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题二绝 其二","author":"李之仪","text":"楚国曾闻照乘珠，间因齐盗取为娱。\n人亡人得何须计，端有龟肠恨晚厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿五首 其一","author":"李之仪","text":"会次定多古语，笔端无复时流。\n肮脏若非投分，崎岖肯共经丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿五首 其二","author":"李之仪","text":"昨夜中秋好月，今朝类试终场。\n遥想客窗对酒，未知野饭同堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿五首 其三","author":"李之仪","text":"踏碎琼瑶聊步，行陪笑语多时。\n一段难逢佳事，五篇消得新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿五首 其四","author":"李之仪","text":"龙欲兴云致雨，虎能堕地成斑。\n端是便骑赐马，不须深恋家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿五首 其五","author":"李之仪","text":"附见谁为邹湛，奖成无复山涛。\n岂敢遽名此地，不如且醉归舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]