[{"title":"杂咏下 仙茅","author":"洪适","text":"许仙初拔宅，灵草迸香茅。\n能使羊无血，云何命在庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 黄精","author":"洪适","text":"叶细浑疑竹，丛轻却象花。\n果然能辟谷，谁不护萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 蘼芜","author":"洪适","text":"菲菲芳袭予，采采叶敷碧。\n捐躯陆羽经，钳口陈琳檄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 芷","author":"洪适","text":"为爱草中香，灵均咏药房。\n行山踏蛇虺，系肘有名方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 地簧","author":"洪适","text":"塞耳可治聋，下咽多去病。\n九曝不辞劳，蚤衰谙药性。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 茱萸","author":"洪适","text":"览尽辋川图，击节茱萸沜。\n九日秋子来，黄花为酒伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 玉虹洞","author":"洪适","text":"天晴玉连蜷，洞邃香吞吐。\n趁逐牡丹时，游人推不去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 绿沈谷","author":"洪适","text":"塞翁马论谷，山房谷名竹。\n千驷后无闻，一竿清亦足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 聚萤斋","author":"洪适","text":"广野萤如织，凉郊书好观。\n借光须继晷，莫遣案头乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 萤","author":"洪适","text":"得夜不韬藏，飞星乱草塘。\n都缘光影误，无路出书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 美可茹亭","author":"洪适","text":"勿誇万钱食，可畏五鼎烹。\n采山逃后悔，碧涧有芹羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 蕨","author":"洪适","text":"块破擎拳出，盘行转眼空。\n救荒非小补，粉骨不言功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 荠","author":"洪适","text":"犯寒青匝野，信手各盈襜。\n不与草争长，听教荼比甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 笋","author":"洪适","text":"出羖瘗五皮，获麟髡一角。\n煮箦太憨生，非关渠善谑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 云起亭","author":"洪适","text":"水穷云四起，出岫本无心。\n莫负苍生望，须为旱岁霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂咏下 西户","author":"洪适","text":"行乐惜分阴，或风雨有疾。\n细数一年中，户开能几日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其一 山居","author":"洪适","text":"经始得山居，幽寻迹不疏。\n自开溪上径，花露泣前鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其二 竹坡","author":"洪适","text":"有圃无修竹，其如借宅何。\n宁忘三月味，不厌此君多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其三 芝榭","author":"洪适","text":"筑榭芝山麓，仍年再产芝。\n欲求茹芝法，已与赤松期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其四 樵径","author":"洪适","text":"松钗藏曲径，林浪积枯枝。\n足了园炊用，何须坏扊扅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其五 茶丘","author":"洪适","text":"半世别玉州，梦忆仙人掌。\n经丘获鎗旗，清思飘云上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其六 栗岭","author":"洪适","text":"霜栗大如拳，皱开穰献熟。\n借问嘉卉山，何如白鸦谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其七 茅轩","author":"洪适","text":"剪茅聊复尔，步屧欲何之。\n风捲三重去，危檐雀护儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其八 蜂庐","author":"洪适","text":"分窠能择地，识路自寻花。\n不候谯门鼓，群飞晚趁衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其九 情话斋","author":"洪适","text":"意到非饶舌，情亲易解颐。\n或时铛脚坐，不效剑头炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十 榴花城","author":"洪适","text":"榴艳对枯筇，西来解后同。\n折花羞鬓白，未插已颜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十一 锦被堆","author":"洪适","text":"锦衾铺绿野，山麝可曾眠。\n蕙帐尘凝席，花残鹤惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十二 赪桐","author":"洪适","text":"花涵百日红，色到三秋重。\n叶大好题诗，丛卑难集凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十三 双鱼","author":"洪适","text":"犀角透鱼龙，石肌蕴星斗。\n亦有无情花，枝头鱼贯柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十四 蔷薇","author":"洪适","text":"竹外霞为幄，花间锦作篱。\n离宫多怨女，吃吃竟亡隋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十五 迎春","author":"洪适","text":"桃杏正酣酣，光春当仲月。\n吐艳既后时，嘉名安可窃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十六 长生草","author":"洪适","text":"经时久枯槁，得水即青葱。\n起死医无药，返魂香有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十七 云松关","author":"洪适","text":"叶生新易旧，岁寒凋独后。\n不改四时柯，贤言非圣耦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十八 山樊","author":"洪适","text":"蕊碎叶伤多，风韵弗娱目。\n独抱绝尘香，无心出幽谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其十九 踯躅崦","author":"洪适","text":"一气浃群芳，漫山踯躅黄。\n有谁相领略，自解度春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居二十咏 其二十 草野","author":"洪适","text":"发生宁有种，滋蔓妨人路。\n不得十月霜，扫除难尽去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱伸仲挽诗二首 其一","author":"洪适","text":"佩兰扈芷楚三闾，骋秘抽妍汉子虚。\n甘向黑头辞印绶，肯将白眼对图书。\n清规尽入先贤传，绣帐空驰长者车。\n千里缠悲付虞殡，西风吹泪著襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱伸仲挽诗二首 其二","author":"洪适","text":"秋来鸿羽得新文，不谓回封限九原。\n起起若为偿岁梦，嘻嘻无复对朝言。\n一编徒挂延陵剑，三径谁开靖节樽。\n尘迹盖棺浑莫问，墓头黄石拜儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程通判挽诗二首 其一","author":"洪适","text":"力行先孝友，潜处伴耕樵。\n日奉斑衣戏，风移尺布谣。\n白头方得禄，朱绂便登朝。\n车作骅骝折，松烟喝鼓箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程通判挽诗二首 其二","author":"洪适","text":"日游通德里，会面盖先倾。\n我作南垂去，君成东蓼行。\n忽持刍束奠，忍听薤歌声。\n为看三珠树，门高莫与京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊直阁挽诗二首 其一","author":"洪适","text":"文石荣三接，君王膝屡前。\n蒲鞭如汉日，盐筴有苏天。\n未上甘泉道，俄开京兆阡。\n传家文史足，不在一囊钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊直阁挽诗二首 其二","author":"洪适","text":"居巷相南北，登门久岁时。\n温言流肺腑，和气见须眉。\n日昃长沙傅，年凋绛县师。\n春云冒丹旐，同会袂成帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中大族伯挽诗二首 其一","author":"洪适","text":"笑谈登月窟，转盼戛天池。\n十载董狐笔，两州龚遂祠。\n文章传古法，名姓畏人知。\n忽作龙蛇梦，今无甲子疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中大族伯挽诗二首 其二","author":"洪适","text":"久矣宫盘谷，幡然筑大逵。\n方瞻乌亦好，已问鵩何之。\n无复竹林会，忍闻蒿里期。\n行行溯西日，有泪若连丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱承事挽诗","author":"洪适","text":"乡关闻德耀，子姓有佳声。\n五十贵不验，三千功已成。\n山幽双剑合，桂近一枝荣。\n他日先贤传，求之月旦评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臧县尉挽诗","author":"洪适","text":"共在乡人后，相高君子前。\n家声郜大鼎，利器楚龙渊。\n不相买臣贵，竟传梅福仙。\n只令空渍酒，落笔更悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程参政挽诗三首 其一","author":"洪适","text":"身近长安日，官无州县劳。\n黄麻袭姚姒，赤舄等伊咎。\n量与南溟阔，名如北斗高。\n十年蟠绿野，轩冕一秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程参政挽诗三首 其二","author":"洪适","text":"圣主更琴瑟，真儒政事参。\n上阶占两两，东第得潭潭。\n忽卧漳滨疾，虚传渑水谈。\n骅骝好千里，底事学吴蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程参政挽诗三首 其三","author":"洪适","text":"一顾驽增价，兼收雁作行。\n篇章非子墨，藻鉴误雌黄。\n云淡番君国，年荒陆氏庄。\n眼看飞旐出，雨泣漫淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李沅州挽诗二首 其一","author":"洪适","text":"籍籍台郎日，皋苏远拍肩。\n疏陈三尺法，制可九重天。\n不使金横带，俄惊酒渍绵。\n平亭知有报，高盖拂修椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李沅州挽诗二首 其二","author":"洪适","text":"朱轓今素幔，归路乃长迷。\n露菊荒三径，春棠叠五溪。\n新丘悲寓马，陈迹记谈犀。\n泪迸无乾袖，重云入望低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程司户挽诗","author":"洪适","text":"把酒论诗日，高标迥绝尘。\n那知三语掾，便作百年人。\n山雾铬旌湿，松风挽铎频。\n流光须有后，何必在其身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程枢母永嘉郡夫人挽诗二首 其一","author":"洪适","text":"华族鸣徽久，闺风蔼德门。\n鸿枢看子贵，象揥拜君恩。\n纯孝缠吹棘，端忧陨得萱。\n板舆无复御，旧迹识家园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程枢母永嘉郡夫人挽诗二首 其二","author":"洪适","text":"赫奕家声振，吾乡今所稀。\n北堂黄发寿，西府黑头归。\n方羡含饴乐，俄闻侍膳非。\n万家旁置处，空怆白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭太尉挽诗","author":"洪适","text":"閒适珍台腆旧仪，趣归方俟诏封泥。\n人生七十古犹少，执政二三今与齐。\n忽见墓门陈石马，空怀宾阁奉金犀。\n不须知识方流涕，处处俱成桃李蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗尚书挽诗三首 其一","author":"洪适","text":"周旋仪禁路，契合本孤忠。\n帝识尚书履，人惊御史骢。\n贵名青史上，谠论皂囊中。\n不入三台志，盐梅事竟空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗尚书挽诗三首 其二","author":"洪适","text":"当年持从橐，白发奉亲闱。\n安否君王问，尊荣简策稀。\n祥琴曾未御，丹旐已同飞。\n萧瑟千章柏，深藏五彩衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗尚书挽诗三首 其三","author":"洪适","text":"连蹇鱼符忝，宗师藻鉴亡。\n但瞻杨子宅，莫避盖公堂。\n远水松区对，东风绋路长。\n九原精爽在，遗恨一庄荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向通判挽诗二首 其一","author":"洪适","text":"屡荐声名白，低飞鬓发苍。\n平生几朱绂，梦寐一黄粱。\n利刃盘根出，明珠后乘光。\n洪都囚不死，阴德未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向通判挽诗二首 其二","author":"洪适","text":"里社承颜旧，情非数面亲。\n令名高月旦，和气蔼阳春。\n乍阔谈挥麈，俄惊冢卧麟。\n濡毫记遗事，顾我不如人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"俞淑人挽诗","author":"洪适","text":"名父尹京日，移天冠柏台。\n齐眉丰俎豆，继踵蜕尘埃。\n德比人如玉，情钟子在梅。\n山高云不去，虞殡有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何宜人挽诗","author":"洪适","text":"心了金刚偈，身膺石窌封。\n灵津双剑合，平壤万家容。\n感慕风吹棘，悲凉雾喝松。\n乡人清泪落，可但辍邻舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏恭人挽诗","author":"洪适","text":"儒门传礼法，妇道有初终。\n石窌重封贵，金章上寿同。\n含饴谈往日，吹棘怆来风。\n绋路刍灵隘，春朝里巷空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈淑人挽诗","author":"洪适","text":"尊章欢二姓，八座对厖眉。\n井井传家法，绳绳赖母仪。\n川灵双剑跃，壤吉万家移。\n多少龙湾树，云藏不尽悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余吏部挽诗三首 其一","author":"洪适","text":"石月颛门学，儒林誉翕然。\n齑盐家有塾，菽水坐无毡。\n孝永趋庭日，名成佩韘年。\n流芳千载下，不减汉韦贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余吏部挽诗三首 其二","author":"洪适","text":"入台光六察，言事过同寮。\n可畏触邪豸，元非开口椒。\n召来仍襆被，老去但乘轺。\n未报蒲轮聘，巫阳已下招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余吏部挽诗三首 其三","author":"洪适","text":"清音扁新阁，山色送溪声。\n尚欠题诗债，难寻把酒盟。\n囊空无长物，甑堕底浮名。\n绋路它州远，临风泪睫横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章通判挽诗二首 其一","author":"洪适","text":"丹霄钳荐口，白首滞微官。\n涉世无圭角，论交出肺肝。\n翔鸾说秋浦，展骥到新安。\n泉下赍遗恨，丝纶趣挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章通判挽诗二首 其二","author":"洪适","text":"富州春再见，风月款平分。\n翠竹曾留我，红梅独对君。\n遣书成挂剑，挥涕屡沾巾。\n千里佳城闭，哀笳不得闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈左相挽诗三首 其一","author":"洪适","text":"盛德波千顷，清风偃俊躔。\n两朝隆柱石，四海入陶甄。\n致主唐虞上，齐名房杜前。\n期颐悭上寿，底处问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈左相挽诗三首 其二","author":"洪适","text":"往昔旄头起，群心共震惊。\n指麾戎幕固，谈笑虏巢倾。\n绣黼重当国，毡裘即敛兵。\n岩岩谢安石，不数晋公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈左相挽诗三首 其三","author":"洪适","text":"天意尊黄发，人扶上玉墀。\n传呼昼接后，邂逅日斜时。\n瞻仰三台坼，沦亡一鉴悲。\n千秋名不朽，奎画在丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨和王挽诗二首 其一","author":"洪适","text":"矍铄狨鞯出，魁梧玉带轻。\n良家三世将，幕府万人英。\n长啸临天堑，妖氛散虏营。\n黄垆有遗恨，不见朔方平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨和王挽诗二首 其二","author":"洪适","text":"三纪羽林卫，千秋彝鼎铭。\n拔材多男爵，教子宝遗经。\n淮上开王社，云边落将星。\n后来思燕颔，麟阁仰丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许倩幼失所恃得地办葬名其亭曰棘风求诗纪事","author":"洪适","text":"择邻传懿范，负土踵前规。\n回首树萱录，动心吹棘诗。\n幽亭三鼎变，吉壤万家随。\n度曲薰弦绝，临风泪满颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]