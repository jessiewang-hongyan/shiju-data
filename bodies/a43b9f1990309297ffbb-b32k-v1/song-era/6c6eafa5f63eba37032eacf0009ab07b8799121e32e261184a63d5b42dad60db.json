[{"title":"九日幽居书怀","author":"赵湘","text":"九月蝉稀九日催，年光如逐水声回。\n人思往事凄凉在，菊倚荒庭寂寞开。\n落叶偶从池上过，夕阳初傍酒边来。\n白衣去后无消息，雨湿东离欲长苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上谷川尹殿丞","author":"赵湘","text":"琐闼题诗送赴官，郡斋潇洒谢公閒。\n树边棋阁开秋锁，池上吟窗见昼山。\n吏散独行红叶外，酒醒时望白云间。\n郊原渐有新烟火，知是逋民鸟道还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"及第东归泗上遇孙穆之话别","author":"赵湘","text":"偶负同年约，知君先出京。\n相逢得酒病，欲别值蝉声。\n共立山当眼，分题雨过城。\n东归几人问，为子耻诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"赵湘","text":"翠满衣裳远径分，渐供幽兴入诗门。\n临泉自爱窥筇影，过藓何妨驻屐痕。\n因惹断云还倚石，偶看残照学呼猿。\n行行却喜无人到，曾为秋来挂梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居引泉","author":"赵湘","text":"自引灵泉胜取冰，入云穷穴始因僧。\n閒疏咽处秋无际，静听时来月有层。\n乍觉疏林多爽气，渐疑幽石减寒棱。\n雨馀终夜西风起，流过吟窗溅著灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书松门寺壁","author":"赵湘","text":"物外纤尘绝，堪闻乐道歌。\n好山光不尽，幽鸟语无多。\n树影秋云杂，泉声昼磬和。\n高僧自禅定，时有野人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书韩山人壁","author":"赵湘","text":"山木争高叶尽深，山人半醉在庭阴。\n常时具馔多餐药，偶夜听松不弄琴。\n雨后看苔连井口，秋来见月到池心。\n近闻墙外诸峰卖，只向茶铛便煮金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书韩隐人壁","author":"赵湘","text":"雨黑径垂莎，全家在薜萝。\n树空穿井出，门掩烧痕过。\n写易澌生砚，悬壶月上柯。\n近来山屐老，枯齿旋无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台香柏峰会思上人","author":"赵湘","text":"孤峰连鸟道，幽会兴难忘。\n对坐无人到，空林尽日香。\n断崖逢积雪，高木露微阳。\n静话看晴晓，联联过晚冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆别","author":"赵湘","text":"何处篱筵酒欲空，夜凉横玉自吹风。\n人当木落关山外，秋在月明池馆中。\n隔水不堪惊远梦，入云犹拟触孤鸿。\n凭栏寂寂还多感，谁会无言忆马融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰汀晚泊","author":"赵湘","text":"孤舟愁晚泊，葭苇暂相邻。\n旅雁初栖雨，江花偶向人。\n强吟还自爱，忽语有谁亲。\n倚棹烟将暝，秋风起白蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰江仁智亭","author":"赵湘","text":"兰江江上亭，仁智称为名。\n山色晓争出，水光秋更清。\n微风飘复断，好鸟过还鸣。\n曾伴陶公醉，叠闻渔唱声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊子岁东归书事呈庞先辈","author":"赵湘","text":"上国有春榜，远人无试期。\n携琴出关早，闻雨到家迟。\n卧病邻皆笑，嫌贫仆转痴。\n高堂倚门久，此去尚多岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会平上人夜话","author":"赵湘","text":"秋灯照岳客，深夜坐前轩。\n白发新闻雨，青山旧听猿。\n病多添药债，吟苦避虫喧。\n不寐还相对，高梧叶自翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华顶峰","author":"赵湘","text":"连天含积翠，石路接危藤。\n日近栖雕树，云迎望海僧。\n狖传幽谷响，泉落断崖冰。\n中有仙人宅，知居第几层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋言事","author":"赵湘","text":"苔染衡门绿有钱，不堪风月渐凄然。\n蛩声乍出斜阳外，山色初来落木边。\n扫叶偶窥栽菊地，卷帘因作捣衣篇。\n故人南北新髭长，昨夜高怀雨滴蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江秀才新居","author":"赵湘","text":"营居知避俗，领鹤过秋郊。\n泉照书初架，窗移树未巢。\n留题新墨湿，掩户旧邻敲。\n数本当帘竹，茶烟渐欲交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自题","author":"赵湘","text":"独居颜子巷，还自种忘忧。\n偶病閒辜月，因吟瘦过秋。\n泣多曾忆阮，贫极尚师丘。\n散拙兼成癖，如何称俗流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观楚上人陈处士夜棋","author":"赵湘","text":"对局清宵解客醺，坐窥玄妙杳难群。\n势侵孤烛和秋冷，声隔高梧带雨分。\n关外散飞星出汉，水边斜起雁穿云。\n无人得见争先意，时被西林宿鸟闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别王穆明府","author":"赵湘","text":"又作残秋役，陶公为断魂。\n此行知入梦，欲去更登门。\n落叶堆霜径，微阳隔雨村。\n预愁山馆宿，相忆独闻猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别杨埙","author":"赵湘","text":"此身偏似雁，南北但孤飞。\n久客难为别，穷秋况未归。\n去程寒雨细，留话夕阳微。\n试共江边立，疏砧又捣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别所知","author":"赵湘","text":"知音不可得，此去但消魂。\n别夜俱闻雨，残秋自出门。\n水横芳草渡，烟蔽夕阳村。\n应念千山外，明朝独听猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别耶溪诸叔","author":"赵湘","text":"又散耶溪会，斜阳在古原。\n出门逢落叶，去路有啼猿。\n短发不堪照，新诗谁与论。\n如何为远别，风雪宿孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居书事寄逸人平上人","author":"赵湘","text":"雨驱寒藓入衡门，颜子箪瓢近水濆。\n静话忽容幽鸟听，好诗长忌俗人闻。\n半帘松影和秋卷，一槛棋声与竹分。\n野客有情僧有意，相思时望过溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮茶","author":"赵湘","text":"昼梦回窗下，秋声碾树边。\n僧敲石里火，瓶汲竹根泉。\n影照吟髭碧，香医酒病痊。\n坐馀重有味，犹见半墙烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招阮山人宿","author":"赵湘","text":"初晴石路新，溪户别无邻。\n自夏评诗遍，经秋扫叶频。\n拂琴堂有月，餐药病离身。\n欲话因来宿，西轩只两人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏山屐","author":"赵湘","text":"鸟道人分去，同行只有筇。\n过桥泉照齿，穿竹藓留踪。\n夜阁吟登月，秋山醉挂松。\n自窥还忆谢，会著在诸峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊居言事","author":"赵湘","text":"断径危桥积藓痕，闭关终与俗尘分。\n深秋鹤影临池见，静夜棋声隔水闻。\n山榻病来谁寄药，石床僧去独看云。\n閒吟閒醉慵开眼，门外寒虫叫日曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金山寺","author":"赵湘","text":"众木皆穿石，名香自合焚。\n两廊吴分月，一阁楚天云。\n雨过新灯露，潮平晚磬分。\n僧吟贝多偈，夜静钓人闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中寄所思","author":"赵湘","text":"寒气萧萧瘦骨惊，自知分得四愁平。\n秋堂病起莓苔色，池阁梦回芦苇声。\n幽滴冷痕连树影，暗驱浮气入诗情。\n衡门独掩还无语，一日相思万缕并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夕偶作","author":"赵湘","text":"一夕衡门独自开，雨阴深巷少尘埃。\n酒醒风傍池边起，坐久月从花上来。\n何处夜歌初欲断，四邻春梦未知回。\n因思此兴无人共，时复孤吟步绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日宿信安张明府厅","author":"赵湘","text":"夕景含钟露欲零，幽人醉宿长官厅。\n床头藓色虽连月，池底花阴更杂星。\n梧叶乍题无物污，蜀琴微响有风经。\n陶公伴客不思睡，门外数峰山晓青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕旅馆言事","author":"赵湘","text":"一点孤灯万里身，离肠曾搅九回频。\n梧桐自管秋来雨，蟋蟀谁妨夜后人。\n枕上梦将衣共短，卷中诗与发同新。\n江边但厌携琴去，明月西风满路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夕宿杨明府厅","author":"赵湘","text":"主人无俗缘，留客菊花边。\n雨气寒并竹，秋声夜杂蝉。\n爽知于酒称，閒觉爱棋偏。\n不欲攲孤枕，更深却漱泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日江亭","author":"赵湘","text":"远岸鸣蝉未拟休，蝉边风叶动飕飗。\n平沙露白聊宜鹤，孤岛分青独映秋。\n野色半侵凉气湿，水光低引夕阳流。\n题诗尽日无人伴，空忆潇湘有钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日过吴侃幽居","author":"赵湘","text":"掩门多径草，凉气动疏林。\n细雨经烟尽，微阳到菊深。\n话诗无鸟过，试茗有僧寻。\n欲去还留宿，窗边月照琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日过韩原隐居","author":"赵湘","text":"霜落门前石齿清，静中曾听咽泉声。\n分题会客多无说，抱疾迎僧忽强行。\n窗外叶随蝉影过，井边苔趁雨痕生。\n纱巾任侧衣从破，二十年来不到城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日宿楚江西寺","author":"赵湘","text":"沧浪生计任西东，人向萧园寄断蓬。\n灯影半轩无梦寐，雨声长夜在梧桐。\n閒僧正笑吟髭白，故国那堪水树红。\n志业未知谁念我，明朝江上苇花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜舟中作","author":"赵湘","text":"酒醒身计正悠悠，泽国如萍信水流。\n独夜听鸿深浦宿，坏篷连雨一灯秋。\n年来自觉新诗澹，江上谁怜旧业优。\n肠断山家数声笛，不知孤客在孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜集李式西斋","author":"赵湘","text":"泽国秋光淡，诗家夜会清。\n雨馀逢月色，风静得琴声。\n小径幽虫绝，寒阶落叶并。\n尝茶不拟睡，自起绕池行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚舟泊桐江","author":"赵湘","text":"严子陵边水自流，夕阳无语倚松舟。\n乍逢风月羞为客，及到溪山识尽秋。\n移树断蝉初过雨，立沙孤雁偶随鸥。\n乡心旅思何人会，芦苇萧萧一笛幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送丁鹗下第客游","author":"赵湘","text":"尊前泣复歌，清泪酒相和。\n别岸春风静，孤舟夜雨多。\n鸟鸣烟草露，花逐夕阳波。\n我亦无憀者，东西欲奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘熙","author":"赵湘","text":"落日照行衣，乡程隔翠微。\n听蝉临水别，闻雨抱琴归。\n鬓发各疑短，天涯相见稀。\n离歌一声断，江上有鸿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张用砺殿丞赴阙","author":"赵湘","text":"诏书徵入阙，数日醉离筵。\n野老衣多泪，山溪雨送船。\n郡斋閒月色，江鸟得诗篇。\n省阁人相待，供吟几树烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李著作赴四明","author":"赵湘","text":"暂辞芸阁伴，欲上海边城。\n地近瀛洲见，山连越水迎。\n驻帆寒草动，移旆晓霞明。\n到日新题出，登高待雪晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜少府赴华阴","author":"赵湘","text":"行路华山前，之官发黑年。\n移家拟拔宅，作尉已呼仙。\n近县云随鹤，当门树著蝉。\n吟诗因夜坐，毛女落秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈天锡赴始兴司户","author":"赵湘","text":"落叶上青衫，携家赴岭南。\n欲行犹买药，侵早即冲岚。\n久贱惟知事，长贫不解惭。\n山城骑病马，吟句去庭参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送到逢吉","author":"赵湘","text":"独去谁相待，全家寄旧林。\n雨声乡外尽，秋色水边深。\n别酒香和菊，新诗束傍琴。\n将行还共立，江上起孤砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周洞之蜀","author":"赵湘","text":"剑阁冲秋去，迢迢动郁陶。\n千山非故国，九日莫登高。\n峡树参天碧，巴猿向夕号。\n当垆人不在，何以慰离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周湜秀才之武川谒黄员外","author":"赵湘","text":"特地照青铜，行行谒谢公。\n山窗新入梦，池馆旧闻鸿。\n岐路云边去，炎蒸雨后空。\n郡斋如伴话，满座是清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送罗权","author":"赵湘","text":"相逢从冷澹，此别复凄凉。\n去路迎秋色，行衣拂夕阳。\n酒浓心易感，诗好意难忘。\n莫作关山役，吟髭况渐长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"赵湘","text":"留客强歌还强醉，送春多雨又多风。\n五更池馆孤灯尽，三月江城一夜空。\n青鉴照髭疑有白，子规啼树已无红。\n相逢赖得明年约，应向花前慰断蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩屿秀才南游","author":"赵湘","text":"杨柳一蝉清，关河九日行。\n却来时未熟，此去雨初晴。\n仆懒嫌书重，驴幽喜骨轻。\n还因得新句，山寺遍题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩起","author":"赵湘","text":"门外雨初晴，春深送客行。\n离筵近流水，芳草向空城。\n远鸟啼仍乱，残花坠欲并。\n会须频饮酒，莫遣白髭生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻晓角","author":"赵湘","text":"一声初起晓光浮，吟笛啼猿亦暗羞。\n清动月华犹满树，冷呼山色欲归楼。\n时萦别馆侵灯过，偶带凉飔入梦流。\n谁会酒醒倾耳听，近来沙塞不吹秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻蝉因寄东阳王穆明府","author":"赵湘","text":"孤蝉鸣水湄，独立少人知。\n急恐移他树，清还似旧时。\n曾同秋馆听，并起雨堂思。\n南望临风久，经年不得诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剡中唐郎中所居","author":"赵湘","text":"古柳垂溪水，当门系雪舟。\n开樽延白鸟，扫树带清秋。\n阁上看华顶，窗中见沃洲。\n寻常投刺少，来即是诗流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜山中喜雨","author":"赵湘","text":"何峰云共出，一夜洒山檐。\n爽气连灯湿，凉声得树兼。\n醉吟还有意，卧听似无厌。\n已约凌晨起，泉声自捲帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅中示所知","author":"赵湘","text":"无憀作客时，况逼入关期。\n听雨醒如醉，闻蝉坐欲移。\n病催新发长，贫有故人知。\n应念将行计，出门多路岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留连李寺丞吟诗阁","author":"赵湘","text":"静阁采诗人罕到，栖栖树石尽当檐。\n长因夜月全开户，独为南山不下帘。\n得句砚中秋水减，觅题池上晚花添。\n炎天几度相留宿，曾值风凉雨气兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦淮晚泊","author":"赵湘","text":"晚泊秦淮上，无人独倚樯。\n遥峰平积水，别浦露残阳。\n往事随天望，新蝉聒树黄。\n渔翁有深意，不语自鸣榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫冬新定郡楼閒望","author":"赵湘","text":"江城逢岁莫，独自倚楼台。\n积雪明孤岛，微阳在早梅。\n水摇冰欲泮，春近雁思回。\n故国还如此，归心但暗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿成秀才水阁","author":"赵湘","text":"卷箔无应永夜虚，凭栏还似钓鱼师。\n床头雨细飘芦苇，池上灯寒照鹭鸶。\n孤枕听泉随断梦，好风吹竹隔残棋。\n主人不寐客魂爽，晓色欲来犹赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄东阳王明府","author":"赵湘","text":"经炎虽得信，旦夕梦兼思。\n多暇知无事，新秋合有诗。\n树凉看雨过，吏散见蝉移。\n谁共清宵坐，西轩月满池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兰江鞠评事","author":"赵湘","text":"东望堪思捧刺时，姓名相齿有人知。\n公堂伴语山光入，秋阁尝茶树影移。\n石上琴尊容赏月，水边台榭许题诗。\n重因送客留连甚，长记还家不敢辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杨坦明府","author":"赵湘","text":"不语仍孤立，何人知此情。\n春禽鸣别树，夜雨入空城。\n望远魂堪断，思閒梦亦清。\n曾陪游岳寺，绕竹共题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杨埙","author":"赵湘","text":"闭门苔自长，春恨极天涯。\n落日山横水，空城雨过花。\n断狂曾避蝶，多病更闻蛙。\n江上无消息，风吹渡柳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄梁鼎殿丞","author":"赵湘","text":"登门长失约，千里阻关河。\n每为秋风至，空令夜梦多。\n旧时曾见许，新诺复如何。\n想望临荒径，微微雨滴蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]