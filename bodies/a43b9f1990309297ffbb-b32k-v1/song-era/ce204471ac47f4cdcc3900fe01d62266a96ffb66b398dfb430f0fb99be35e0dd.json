[{"title":"书院杂咏 牡丹","author":"王十朋","text":"今古几池馆，人人栽牡丹。\n主翁兼种德，要与子孙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 芍药","author":"王十朋","text":"已过花王候，才闻近侍香。\n来游禁酒地，免作退之狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 岩桂","author":"王十朋","text":"岩桂何时种，遥闻月窟香。\n君家似燕窦，会见五枝芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 江梅","author":"王十朋","text":"园林尽摇落，冰雪独相宜。\n预报春消息，花中第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 酴醾","author":"王十朋","text":"日烘香倍远，雨浥韵尤清。\n谁把玉钱比，恐花羞此名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 红梅","author":"王十朋","text":"桃李莫相妒，天姿元不同。\n犹馀雪霜态，未肯十分红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 海棠","author":"王十朋","text":"欲与春争媚，嫣然一笑芳。\n雨中如有恨，疑是为无香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 瑞香","author":"王十朋","text":"曾入江南梦，故宜名瑞香。\n何人好谈论，雅目误更张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 菊花","author":"王十朋","text":"不恨开时晚，自知能傲霜。\n慎毋同琐细，采撷上君堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 蜡梅","author":"王十朋","text":"非蜡复非梅，梅将蜡染腮。\n游蜂见还讶，疑自蜜中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 榴花","author":"王十朋","text":"客馆逢重午，石榴花正芳。\n吾庐开亦好，归去嚼天浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 薝卜","author":"王十朋","text":"禅友何时到，远从毗舍园。\n妙香通鼻观，应悟佛根源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 千叶黄梅","author":"王十朋","text":"菊以黄为正，梅惟白最佳。\n徒劳染千叶，不似雪中花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 千叶红桃","author":"王十朋","text":"在处飘红雨，临窗照夕阳。\n何时清禁里，一笑伴仙郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 千叶白桃","author":"王十朋","text":"岂有夭桃艳，淡然群卉中。\n全身是清白，那肯媚春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 佛见笑","author":"王十朋","text":"学得酴醾白，更能相继芳。\n金仙粲然笑，鼻观不多香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 荷花","author":"王十朋","text":"十里西湖上，红云照绿波。\n何如吾净友，臭味不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 蓼花","author":"王十朋","text":"秋色在何许，蓼花含浅红。\n客情禁不得，归兴逐西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 萱花","author":"王十朋","text":"有客看萱草，终身悔远游。\n向人空自绿，无复解忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 斑竹","author":"王十朋","text":"苍梧巡不返，斑竹至今存。\n今日稽山下，几枝忠孝痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 燕竹","author":"王十朋","text":"问讯东墙竹，佳名今始知。\n龙孙初迸日，燕子却来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 西河柳","author":"王十朋","text":"潇洒西河种，谁移向浙东。\n青枝太纤细，莫近楚王宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 葡萄","author":"王十朋","text":"珠帐临檐挂，龙须满架抽。\n也知堪酿酒，不要博凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 芭蕉","author":"王十朋","text":"草木一般雨，芭蕉声独多。\n主人栽未足，其奈客愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 石菖蒲","author":"王十朋","text":"天上玉衡散，结根泉石间。\n要须生九节，长为驻红颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 慎火草","author":"王十朋","text":"禁殿安蚩尾，骚人逐毕方。\n何如栽此草，有火自能妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 盆中新荷","author":"王十朋","text":"首夏盘池里，新荷点数圆。\n主人行中选，故为作青钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 假山","author":"王十朋","text":"君有好山僻，叠山亭院间。\n不遮山外眼，又得见真山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 盆池","author":"王十朋","text":"不比儿童戏，埋盆作小池。\n要令盆底水，长满不倾攲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 书架","author":"王十朋","text":"君富端不俗，有钱长买书。\n家藏三万轴，不怕腹空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 鹤","author":"王十朋","text":"雅志在冲霄，长思振羽毛。\n风前匆相和，声彻九天高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 鹅","author":"王十朋","text":"善鸣聊自适，不愿遇知音。\n深恐山阴妪，误猜君子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 花鸭","author":"王十朋","text":"毛羽不多异，浪于花得名。\n深疑杜陵误，黑白未分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院杂咏 鸂鶒","author":"王十朋","text":"文采真为累，飞鸣不自由。\n小池新水涨，相对谩沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 剡溪","author":"王十朋","text":"千古剡溪水，无穷名利舟。\n閒乘雪中兴，惟有一王猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 了溪","author":"王十朋","text":"禹迹始壶口，禹功终了溪。\n馀粮散幽谷，归去锡玄圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 挟溪亭","author":"王十朋","text":"远水从台婺，同归古嵊州。\n巍亭压山顶，千古挟双流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 龙宫碑","author":"王十朋","text":"曾到龙宫寺，拂尘观古碑。\n何时无短李，肉眼可能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 戴颙墓","author":"王十朋","text":"旷野冢累累，子孙犹不知。\n千年戴颙墓，三字道旁碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 阮仙翁宅","author":"王十朋","text":"再入山中去，烟霞锁翠微。\n故乡遗宅在，何日更来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 戴溪亭","author":"王十朋","text":"剡水照人碧，剡山随眼青。\n我来非雪兴，惭上戴溪亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剡溪杂咏 偃公泉","author":"王十朋","text":"泉自何时有，得名从偃公。\n谁能继张陆，为载水经中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书院挂额展筵雅会也戏集诸堂轩斋名作诗","author":"王十朋","text":"黉馆名初挂，银钩势欲翻。\n人才蕴秀异，学业扣渊源。\n俊彦方群集，文章可细论。\n辉声迈前辈，擢秀蔼诸孙。\n心友居兰室，天香满桂轩。\n兹为学者富，难与俗流言。\n恢义高风倡，同襟旧好敦。\n池中神鲤足，一一上龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别周德远诸友","author":"王十朋","text":"山城过疏雨，客馆生新秋。\n乡心杂病思，浩荡不可留。\n忆昨初来时，园花弄春柔。\n俯仰节物变，木杪风飕飕。\n旅食百日馀，故人情已周。\n论文有深味，惜别添牢愁。\n槐花物色老，琴书散交游。\n暖律回南枝，相期泛仙舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿石佛","author":"王十朋","text":"脩径入幽壑，梵宫摩碧霄。\n仰头惊突兀，跬步怯岧峣。\n宝相石间涌，钟声云外飘。\n明朝路南北，身世各尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白若遇水以小舟从石门渡势危甚因书数语示图南文卿时八月二日也","author":"王十朋","text":"归途阻秋潦，溪涨不可涉。\n迂从石门渡，未见心已怯。\n壮哉龙伯宫，幽据雁山胁。\n岩如峙城壁，南北本相接。\n众流欲朝宗，天为开岌嶪。\n泓澄潭百尺，臲卼舟一叶。\n吾生何自轻，内顾无可挟。\n所赖二友生，千里同负笈。\n忠信傥可仗，免作飞鸢跕。\n来归从剡溪，山水颇涉猎。\n石齧天台舟，浪拍临海楫。\n可曾如此境，令我魂震慑。\n连年作行客，川涂但取捷。\n不因风雨暴，谁?远步屧。\n兹渡虽云恶，观览意亦惬。\n谩赋石门篇，添入剡游箧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孟甲生日","author":"王十朋","text":"记汝初生际，灯花达旦然。\n门阑增喜庆，翁妪最矜怜。\n已过周天岁，行临志学年。\n勉修愚鲁质，诗礼称家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孟甲孟乙好蓄古钱因示以诗","author":"王十朋","text":"世人多好钱，今汝独好古。\n书中阅平准，壁上按图谱。\n广拾汉五铢，远及周九府。\n惜哉生我家，此物罕曾睹。\n百中时得一，喜笑见眉宇。\n所蓄虽不多，其志颇可取。\n闾阎富家子，绕床堆阿堵。\n一字不识丁，碌碌何足数。\n更宜移此力，典坟读三五。\n纵未到圣贤，定可过乃父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周光宗赠蛎房报以溪莼","author":"王十朋","text":"珠屿蛎房魁海错，左原莼线冠溪毛。\n韩公南食可曾见，张翰东归徒自高。\n鼎俎珍庖输肉食，江湖佳味属吾曹。\n有无相易通家事，僮仆往来毋惮劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘府君挽词 其一","author":"王十朋","text":"歆向诜然萃一门，过庭诗礼尽公恩。\n奇儿不负义方教，旧治至今遗爱存。\n心境欲明凭贝叶，寿藏预卜傍祇园。\n髯郎行烛青藜杖，定见荣光达九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘府君挽词 其二","author":"王十朋","text":"贱子无天衅早钟，记观先友涕亡从。\n士林方喜荣三桂，丞舍俄惊惨二松。\n剡水凄凉回棹速，丹丘恸哭过车凶。\n发扬门户胜他族，深羡公家有蔡邕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贾府君挽词","author":"王十朋","text":"鹿岩重见鹿门翁，襟宇浑然太古风。\n负郭良田全种德，起家难弟已收功。\n花间麟冢经年就，木杪龟趺指日丰。\n门婿自惭非李汉，鄙文何足状韩公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈夫人挽词","author":"王十朋","text":"伟节声名盖一时，夫人淑德最相宜。\n便甘布素从高隐，不惜花钿拯众饥。\n萱草未乾堂下土，杨花已应梦中诗。\n如今多少王孙饿，进食哀怜复有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纳凉偶成","author":"王十朋","text":"架松却烦暑，梳竹来清风。\n顽然七尺躯，寄此微凉中。\n高枕傲有道，深杯醉无功。\n山林有馀乐，此兴谁吾同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼演述二老僧","author":"王十朋","text":"叠石峰前二老僧，相逢一笑见真情。\n社中对酒日初永，林下围棋秋始清。\n尚拟维摩眠丈室，遽惊圆泽厌浮生。\n通幽亭冷西楼古，过客伤心涕泪横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄杨","author":"王十朋","text":"嘉彼黄杨，郁焉其苍。\n匪瓮而圆，匪盖而张。\n百干同根，森如弟昆。\n千枝其子，万叶其孙。\n惟此黄杨，先子所植。\n草木有义，先子之德。\n愿言我家，兄弟子孙。\n如此嘉树，永为义门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 竹子脩","author":"王十朋","text":"万木萧疏怯岁寒，子脩相见喜平安。\n世间宁有扬州鹤，休讶平生肉食难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 井子深","author":"王十朋","text":"席量泓泓井子深，客来车辖总能沉。\n定须再筑新亭覆，不负先君好事心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 梅子先","author":"王十朋","text":"竹外溪头手自栽，群芳推让子先开。\n好将正味调金鼎，莫似樱桃太不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 桂子苍","author":"王十朋","text":"学仙深愧似吴郎，赖有吾庐两子苍。\n疑是广寒宫里种，一秋三度送天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 兰子芳","author":"王十朋","text":"国香入鼻忽扬扬，知是光风泛子芳。\n林下自全幽静操，纵无人采亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 昌阳子仙","author":"王十朋","text":"天上星郎字子仙，结根拳石傍清泉。\n豨苓方入医师手，谁识仙姿解引年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 黄子嘉","author":"王十朋","text":"保绿轩前黄子嘉，非松非柏亦非花。\n故应唤作思人树，数十年前阅我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 丁子素","author":"王十朋","text":"雨底含愁雪里芳，琉璃叶映小何郎。\n世人竞重熏笼锦，子素何曾怯瑞香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 柳子春","author":"王十朋","text":"夹道青青柳子春，自从栽植几番新。\n如今已作参天树，应笑衰迟老主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 槐子夏","author":"王十朋","text":"方苦炎炎畏日长，欣蒙子夏惠清凉。\n三槐雅是王家物，为榜新亭拟旧堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 菊子秀","author":"王十朋","text":"子秀霜中色更嘉，金钱粲粲满庭阶。\n渊明异日开三径，端仗兹花慰老怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林下十二子诗 王子野","author":"王十朋","text":"场屋虚名且罢休，归来聊效晋人游。\n林间诸子总非俗，肯与野人为友不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌龄辟圃植花索诗于老者戏作数语兼简梦龄","author":"王十朋","text":"东园小小花木稀，西园廓廓规模奇。\n西园主人但置酒，东园老人甘赋诗。\n朝游西园饮千斛，莫向东园吟百幅。\n更约南园好事人，酒盏诗篇日相续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西园新辟昌龄索诗予以其未开尊也戏作数语既饮复用前韵","author":"王十朋","text":"阿连好事由来稀，开轩辟圃幽更奇。\n峰峦罗列富遐览，气象收拾归新诗。\n百挺琅玕花数斛，宛似辋川图一幅。\n朝莫过从有弟兄，长愿歌声无断续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予与二弟连日赋诗饮酒诗成命二子书之亦居家之一乐也复用前韵","author":"王十朋","text":"不愁地辟车马稀，自喜兄弟俱好奇。\n阿连举觞劝我酒，阿买研墨书翁诗。\n长泛郑生船百斛，日赋邺侯三四幅。\n何用身封万户侯，但愿青箱有人续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌龄和诗以不得志于贤关有欲退隐之语复用前韵勉其涵养俟时未可真作休休计也","author":"王十朋","text":"出门休叹知己稀，开卷揽取前人奇。\n西园松菊聊笑傲，未可遽赋休休诗。\n涵养胸襟容万斛，仰视青天纸盈幅。\n行看富贵来逼人，江左家声子当续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌龄频开尊再用前韵","author":"王十朋","text":"人生常患如意稀，利名扰扰何足奇。\n谁能如我惠连弟，有园有酒兼能诗。\n种秫西畴都几斛，时见小童驰片幅。\n风轩洒扫又相呼，适有嘉鱼馈羊续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵题东园","author":"王十朋","text":"吾园小小游人稀，吾腹便便空自奇。\n径草青青可煎饮，雨竹涓涓堪赋诗。\n鲜鲜菊满东篱斛，扬扬兰入骚人幅。\n牡丹芍药紫薇梅，四时花卉开相续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]