h":"宋_4.csv","pointer":36333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周德言游小庐山观余壁间诗次韵示教走笔奉谢 其一","author":"徐瑞","text":"美人尘外姿，胸次澹孤清。\n空堂语三日，隐隐金石声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周德言游小庐山观余壁间诗次韵示教走笔奉谢 其二","author":"徐瑞","text":"兰茗寻旧题，愧我昔好径。\n妙语为湔祓，清越泗滨磬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行即景","author":"徐瑞","text":"江流千丈碧，崖树一枝红。\n临眺延缘久，扁舟我欲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿常山 其一","author":"徐瑞","text":"小楼临水际，一塔出林端。\n为报山僧喜，无劳问数滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿常山 其二","author":"徐瑞","text":"灯影照白发，清酤浣旅颜。\n半生堪一笑，四度宿常山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"徐瑞","text":"细雨沾庭湿，惊风入袖寒。\n黄花有佳色，独自倚阑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"徐瑞","text":"门巷鸣乾叶，阶除吟候虫。\n幽怀不可奈，丝雨更濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"徐瑞","text":"丈室四壁静，孤灯永夜明。\n蒲团清坐稳，檐铁两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日六首 其一","author":"徐瑞","text":"屋上小山丛桂，门前绿水芙蕖。\n问事唯唯否否，逢人睢睢盱盱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日六首 其二","author":"徐瑞","text":"客散幽庭鸟集，日长高树蝉嘶。\n有士怀戴安道，无人铸钟子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日六首 其三","author":"徐瑞","text":"世眼看朱成碧，人情覆雨翻云。\n宁甘头责子羽，莫教腹负将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日六首 其四","author":"徐瑞","text":"偶自栖迟偃仰，谁无历落嵚崎。\n两刖足见美玉，九折臂为良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日六首 其五","author":"徐瑞","text":"我生尚友千载，不愿争名一时。\n闭门写范滂传，饱饭和渊明诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日六首 其六","author":"徐瑞","text":"宇宙千年遗事，江山几段閒情。\n一笑无人领略，杖藜竹外徐行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言四首 其一","author":"徐瑞","text":"脚下行万里路，胸中贮千卷书。\n到底只供一笑，屋乌何似除胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言四首 其二","author":"徐瑞","text":"畜耳何如畜眼，观人孰与观颐。\n远道纷纷飞鞚，深山有客争棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言四首 其三","author":"徐瑞","text":"悟得字中有笔，却参画外无诗。\n今人见谓痴绝，异世神交特奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言四首 其四","author":"徐瑞","text":"隐几反观唯我，出门与语者谁。\n饮酒止酒俱达，借书还书一痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故夏与南翁往来里社共听松风盘旋久之欲作数语不果近日偶至其下怅然兴怀追赋六言一首","author":"徐瑞","text":"夜语连床未了，村醪时复一钟。\n不怕石头路滑，要听古社松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送医士方存方归弋阳 其一","author":"徐瑞","text":"俗子纷纷束阁，此客亹亹逼人。\n未论探丸起死，壶中刀匕通神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送医士方存方归弋阳 其二","author":"徐瑞","text":"桔梗时而为帝，昌阳或笑引年。\n无用乃知有用，妙处当是不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送医士方存方归弋阳 其三","author":"徐瑞","text":"但识身中大药，不须肘后奇方。\n我欲与君谈此，暑途行计何忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"徐瑞","text":"曾驻金华傲紫烟，偶来此地了尘缘。\n春风白石冈头路，虚老松花过一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行书感","author":"徐瑞","text":"断崖斗绝小舟行，烟树崔嵬草一汀。\n宛是钓台台下路，杨梅、卢橘正青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东溪舟中呈石斋","author":"徐瑞","text":"两山盘屈水中分，紫翠深深日欲曛。\n孤枕短篷吟梦晓，一莺啼破半溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东湖枕上","author":"徐瑞","text":"云边假息竹方床，天地诗翁一枕凉。\n杳杳磬声清入梦，上方老衲起烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁亥正月二日自东湖泛舟归鹊湖","author":"徐瑞","text":"贳酒张帆古渡头，半篙新水送归舟。\n梅花惜我漂零久，一片飞香入柁楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月晦日泛舟诣东湖兴尽而返戏作","author":"徐瑞","text":"古渡开帆破暮烟，平明回棹浪鸣舷。\n可怜烟雨东湖兴，绝似山阴雪夜船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小斋前老梅至二月半花犹未落馀香最可爱","author":"徐瑞","text":"瘦树枯枝藓晕青，嫩寒清晓雨冥冥。\n道人不管花开落，独爱残香绕砚屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读苏黄集","author":"徐瑞","text":"胡儿争问大苏集，仙官解作太史书。\n当时同朝人欲杀，所能者天信不虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀五首 其一","author":"徐瑞","text":"伊优肮脏子自择，籧篨戚施我不能。\n试看洛阳红紫国，何如空谷一枯藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀五首 其二","author":"徐瑞","text":"朱云岂是丞相吏，子房偶作帝者师。\n去就谁能明此道，西风落木鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀五首 其三","author":"徐瑞","text":"文章意造乃天趣，学奇学涩为谁妍。\n皮毛落尽真实在，千载谁续鹍鸡弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀五首 其四","author":"徐瑞","text":"曹刘沈谢易摸索，杨王卢骆哂未休。\n眼底轮囷能有几，蛛丝尘网百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀五首 其五","author":"徐瑞","text":"枯桐三尺寄古意，悬崖夜半鸣风泉。\n广陵散曲世不传，五柳先生更无弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋晚对牵牛花怀友","author":"徐瑞","text":"蘸碧轻绡一捻垂，蜿蜒细蔓满枯篱。\n晓来风露深深巷，记得相看觅句时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"听雨","author":"徐瑞","text":"听泉听雨不须悲，声本无情我自痴。\n梦觉不同均是梦，寂然妙在不闻时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶洁瓷鼎煮芽茶可玉弟以云松吟藁至且啜且哦就成小绝并以卷锦","author":"徐瑞","text":"活火枯樵煮露芽，瓢盂颠倒岸乌纱。\n君诗味永加严苦，可恨山中客未嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲午夏日读尔雅有感","author":"徐瑞","text":"梁间客燕一采芑，韝上饥鹰肉不肥。\n爱杀前溪双属玉，羽毛如雪背人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程明大送枸杞数本侑以古诗两绝奉谢 其二","author":"徐瑞","text":"坡翁尚感黄柑意，杜老深知菜把恩。\n此意世间寥落久，自哦诗句绕荒园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书壁","author":"徐瑞","text":"爱山日凭西楼角，听雨长来破寺中。\n可恨无人同此味，绕檐疏竹鸟呼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其一","author":"徐瑞","text":"去年冰雪梅开晚，立春半月始见花。\n只今至后未五日，南枝已破两三丫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其二","author":"徐瑞","text":"冰溪冻合路迢迢，雪片疏疏著地消。\n幽香袭人无觅处，信步行过独树桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其三","author":"徐瑞","text":"山中峭壁孤绝处，瘦树独立殊风标。\n我行矫首坐叹息，正似高人不可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其四","author":"徐瑞","text":"石梁溪上鸳鸯树，昔年樵斧摧为薪。\n诗翁赋诗慰不遇，险语至今惊鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其五","author":"徐瑞","text":"墙东一株苍藓身，故人手斸山中云。\n封植敢忘角弓赋，每到花开如见君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其六","author":"徐瑞","text":"首阳食薇千古瘦，商山茹芝绝世清。\n谁能嚼花卧空谷，一物不向胸中横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其七","author":"徐瑞","text":"项里苔梅妙天下，蜀苑梅龙天下无。\n放翁诗酒白石笛，二老风流不可摹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其八","author":"徐瑞","text":"种性还如赋苦笋，趣味一似传冰壶。\n持此问梅翻绝倒，荔支瑶柱有同无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其九","author":"徐瑞","text":"烟芜牧笛不胜哀，梦绕西湖几百回。\n应是诗人有馀恨，断桥流水为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅十首 其十","author":"徐瑞","text":"十亩荒园野水边，尽栽梅树不论钱。\n珍重木瓢任真率，年年携此醉花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月廿五夜小雨成雪","author":"徐瑞","text":"秋来多病怯新寒，香冷衣篝梦易残。\n夜半忽惊风雨恶，开门雪已满前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄芳洲先生 其一","author":"徐瑞","text":"山中二十三年约，今日寻诗始得来。\n举瓢酌水为君寿，从此登临岁一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]