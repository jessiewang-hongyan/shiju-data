[{"title":"浣溪沙","author":"王寀","text":"雪里东风未过江。\n陇头先折一枝芳。\n如今疏影照溪塘。\n北客乍惊无绿叶，东君应笑不红妆。\n玉真爱著淡衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"王寀","text":"扇影轻摇一线香。\n斜红匀过晚来妆。\n娇多无事做凄凉。\n借问谁教春易老，几时能勾夜何长。\n旧欢新恨总思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"王寀","text":"珠箔随檐一桁垂。\n绣屏遮枕四边移。\n春归人懒日迟迟。\n旧事只将云入梦，新欢重借月为期。\n晚来花动隔墙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲","author":"王寀","text":"日月无根天不老。\n浮生总被消磨了。\n陌上红尘常扰扰。\n昏复晓。\n一场大梦谁先觉。\n雒水东流山四绕。\n路傍几个新华表。\n见说在时官职好。\n争信道。\n冷烟寒雨埋荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"王寀","text":"燕子来时春未老。\n红蜡团枝，费尽东君巧。\n烟雨弄晴芳意恼。\n雨馀特地残妆好。\n斜倚青楼临远道。\n不管傍人，密共东君笑。\n都见娇多情不少。\n丹青传得倾城貌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其六","author":"王寀","text":"花为年年春易改。\n待放柔条，系取长春在。\n宫样妆成还可爱。\n鬓边斜作拖枝戴。\n每到无情风雨大。\n检点群芳，却是深丛耐。\n摇曳绿萝金缕带。\n丹青传得妖娆态。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其五","author":"王寀","text":"晕绿抽芽新叶斗。\n掩映娇红，脉脉群芳后。\n京兆画眉樊素口。\n风姿别是闺房秀。\n新篆题诗霜实就。\n换得琼琚，心事偏长久。\n应是春来初觉有。\n丹青传得厌厌瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"王寀","text":"镂雪成花檀作蕊。\n爱伴秋千，摇曳东风里。\n翠袖年年寒食泪。\n为伊牵惹愁无际。\n幽艳偏宜春雨细。\n红粉阑干，有个人相似。\n钿合金钗谁与寄。\n丹青传得凄凉意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"王寀","text":"濯锦江头春欲暮。\n枝上繁红，着意留春住。\n只恐东君嫌面素。\n新妆剩把胭脂傅。\n晓梦惊寒初过雨。\n寂寞珠帘，问有馀花否。\n怅望草堂无一语。\n丹青传得凝情处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"王寀","text":"秾艳娇春春婉娩。\n雨惜风饶，学得宫妆浅。\n爱把绿眉都不展。\n无言脉脉情何限。\n花下当时红粉面。\n准拟新年，都向花前见。\n争奈武陵人易散。\n丹青传得闺中怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"王阜民","text":"家法从来师静治，赵张高掩前踪。\n清才八斗继宗风。\n年年正月尾，桃李满城中。\n已把长江成九酝，请将太白浮公。\n更移春槛向房栊。\n有花虽解语，莫负锦薰笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"占胜亭 其一","author":"王阜寿","text":"云横龙角千秋岸，水发含香十里堤。\n每向痴儿了公事，倚栏立到日沉西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永和县上巳","author":"王驾","text":"记得兰亭祓禊辰，今朝兼是永和春。\n一觞一咏无诗侣，病倚山窗忆故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同游柏谷山","author":"王举元","text":"晓出东郊迥，路穿桑柘林。\n人耕新雨地，寺隐半岩阴。\n远目穷天宇，和风爽醉襟。\n停骖顾遗老，同是劝农心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春集东园赋得叶字","author":"王举正","text":"芳辰聊命驾，郊野赏心惬。\n亭幽路郁纡，树密花重叠。\n暂纾朝绂劳，喜与朋簪接。\n谈麈逗松枝，宴赏澄竹叶。\n含和寄萧散，选胜穷登蹑。\n行乐且踌躇，此游非日涉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圆坛午龛行事","author":"王俊乂","text":"平日郊邱事口谈，今朝相祀列星参。\n大裘衮衮冕升南陛，小次龙床近午龛。\n韦杜去真尺五，嵩神祀圣似呼三。\n清都佩玉人归后，尚听笙镛万谷酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王俊彦","text":"不杂人间种，恐遭天上殃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"第一山","author":"王信","text":"禺迹茫茫万里天，望中皆我旧山川。\n谁将淮水分南北，直到幽燕始是边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞瀑","author":"王信","text":"闻道东阳水乐亭，一经坡句万年声。\n我来石洞得飞瀑，谁赋新诗留美名。\n平地有雷鸣不断，半天无雨势如倾。\n欲知山水醉翁意，且请主人迟酒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏扬州后土祠琼花","author":"王信","text":"爱奇造物剪琼瑰，为镇灵祠特地栽。\n事纪扬州千古胜，名传天下万花魁。\n何人斫却依然在，是处移将不肯开。\n谩说八仙模样似，八仙那得有香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石洞书院","author":"王信","text":"不到兹山又十秋，欲题名字记重游。\n转头前日梦相似，拭目诸公墨尚留。\n俗里尘埃随酒却，淡中生活为诗愁。\n晚来得趣无人解，一鸟不鸣山更幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题椿桂堂","author":"王信","text":"乡与子直游胶庠，是时子明居侍旁。\n友于学问相激昂，声华日驰翰墨场。\n仲氏一第如探囊，伯氏随即淩云翔。\n已快雁塔书雁行，君家馀庆未易量。\n二龙三凤同呈祥，一门竞爽如圭璋。\n前后继踵名相望，夥为十佛经中光。\n联翩不羡金华堂，会稽何独誇诸黄。\n世言燕山窦十郎，一枝椿老五桂芳。\n君今取此名其堂，荐绅荣之富篇章。\n几与窦氏争颉颃，吾家亦颇推吾乡。\n自从仲父闿天荒，五登科第于太常。\n枝分派别各一房，敢与君家相比方。\n夫人更喜寿且康，岁时罗列称寿觞。\n綵衣青紫交焜煌，人生至乐见未尝。\n源深允矣流必长，孙枝更接秋风香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王信","text":"托名庾公何区区，天造地设非关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢自然","author":"王俦","text":"颇怪韩夫子，犹疑谢自然。\n至今成福地，自古有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖","author":"王南一","text":"翠巘嵯峨插斗牛，仙家风景自清幽。\n从来此县传佳谶，就筑西湖占上流。\n层塔可梯升后进，五峰有路达前修。\n邦人接踵登科去，我亦京华共宦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓月楼","author":"王南美","text":"居士作层楼，不爱风花雪。\n待得野云收，只钓溪边月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香山刻石","author":"王厚之","text":"山琢青瑶水染蓝，莺声促我醉双柑。\n十年准备抽身去，记取镌诗在石龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清音","author":"王威","text":"白云深处有清音，上接祥光古木森。\n不但濯缨兼濯足，直须一洗利名心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"王娇姿","text":"兀自未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石门","author":"王度","text":"石门深锁气何雄，那得群仙采药踪。\n列嶂时时看过鸟，悬崖历历长游龙。\n一书未学嵇中散，十日聊陪邴曼容。\n拟向锦屏题姓字，箫台端的是元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王度","text":"云生坐来石，风掩读残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王度","text":"鸦分供馀食，鸽乱著残棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王度","text":"风摧秀林木，色变附蓝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王度","text":"樵斧和云斫，渔蓑带雪披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王度","text":"危红赊晚景，涨绿上平沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其十","author":"杨简","text":"肸蚃丰融富媪釐，班回长乐奉愉怡。\n休嘉最易生安逸，翼翼当如未祼时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其四","author":"杨简","text":"唱彻严更凤钥开，侍祠济济列崇陔。\n小臣亦忝廊西献，惟秉温恭对越来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其八","author":"杨简","text":"左个明堂是集英，鹄袍曾此接文明。\n馂馀款听钧天奏，疑是吾伊雅颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其五","author":"杨简","text":"玉佩珊珊出禁扉，金莲分炬散芳菲。\n祠班咫尺临黄道，惹得天香满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其九","author":"杨简","text":"千官移仗拱端门，一日鸡竿万里春。\n汤网本疏民自格，要知家法在深仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其六","author":"杨简","text":"登歌奏罢乐初成，懿懿芬芬荐德馨。\n好是天心彰信顺，故教华月吐青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其二","author":"杨简","text":"先皇鸿烈冠重兴，庙社依然总燕宁。\n今日孝思严陟配，必知深妥在天灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清湖","author":"王庭","text":"万顷灵湫带碧烟，源泉混混自山前。\n四时每涨空中雨，一片常涵镜里天。\n星斗转时银汉近，芙蓉开处彩屏连。\n鱼龙久跃平深处，变化应知在异年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其一","author":"杨简","text":"礼行肆类又称禋，喜见承平景铄信。\n堪笑汉人誇肸蚃，何如明德远精纯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂侍祠十绝 其三","author":"杨简","text":"玉轪才驰霁色开，都人欢呼殷如雷。\n曰旸曰雨元无定，都自吾皇一念来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二日出郊","author":"王庭圭","text":"日头欲出未出时，雾失江城雨脚微。\n天忽作晴山捲幔，云犹含态石披衣。\n烟村南北黄鹂语，麦陇高低紫燕飞。\n谁似田家知此乐，呼儿吹笛跨牛归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辰州僻远乙亥十二月方闻秦太师病忽蒙恩自便始知其死作诗悲之","author":"王庭圭","text":"辰州更在武陵西，每望长安信息稀。\n二十年兴缙绅祸，一朝终失相公威。\n外人初说哥奴病，远道俄闻逐客归。\n当日弄权谁敢指，如今忆得姓依稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡邦衡之新州贬所二首 其一","author":"王庭圭","text":"囊封初上九重关，是日清都虎豹闲。\n百辟动容观奏牍，几人回首愧朝班。\n名高北斗星辰上，身堕南州瘴海间。\n不待他年公议出，汉廷行召贾生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡邦衡之新州贬所二首 其二","author":"王庭圭","text":"大厦元非一木支，欲将独力拄倾危。\n痴儿不了公家事，男子要为天下奇。\n当日奸谀皆胆落，平生忠义只心知。\n端能饱吃新州饭，在处江山足护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和居东村作","author":"王庭圭","text":"避地东村深几许，青山窟里起炊烟。\n敢嫌茅屋绝低小，净扫土床堪醉眠。\n鸟不住啼天更静，花多晚发地应偏。\n遥看翠竹娟娟好，犹隔西泉数亩田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周秀实田家行","author":"王庭圭","text":"旱田岁逢六月尾，天公为叱群龙起。\n连宵作雨知丰年，老妻饱饭儿童喜。\n向来辛苦躬锄荒，剜肌不补眼下疮。\n先输官仓足兵食，馀粟尚可瓶中藏。\n边头将军耀威武，捷书夜报擒龙虎。\n便令壮士挽天河，不使腥膻污后土。\n咸池洗日当青天，汉家自有中兴年。\n大臣鼻息如雷吼，玉帐无忧方熟眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤栖梧/蝶恋花 王克恭生日","author":"王庭圭","text":"琼海无边银浪卷。\n画戟朱楼，缥缈云间见。\n当日使君曾拥传。\n海霞光里时开宴。\n翠斝红鳞吹酒面。\n莫谓今朝，人在天涯远。\n彩凤衔书应不晚。\n愿公难老身长健。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥","author":"王庭圭","text":"梅花发。\n夜寒吹笛千山月。\n千山月。\n此时愁听，龙吟幽噎。\n数枝飞尽南枝雪。\n风光又作年时别。\n年时别。\n江头心绪，乱丝千结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 茶","author":"王庭圭","text":"宴罢莫匆匆，聊驻玉鞍金勒。\n闻道建溪新焙，尽龙蟠苍璧。\n黄金碾入碧花瓯，瓯翻素涛色。\n今夜酒醒归去，觉风生两腋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其四 再和呈马守","author":"王庭圭","text":"天回北斗欲中宵。\n屡移杓。\n客魂消。\n记得皇州，灯火虹成桥。\n异俗西南开万里，冠带尽，百蛮徭。\n卢溪太守未还朝。\n起朱楼。\n接层霄。\n翠幕红妆，歌管玉为箫。\n民乐丰登无一事，看下诏，采风谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其二 步月新桥呈任子严","author":"王庭圭","text":"渡头犹唱棹歌声。\n雨初晴。\n月初生。\n忽见飞虹，夭矫挂寒汀。\n两岸小儿齐拍手，今夜里，放人行。\n朱栏画鹢照江亭。\n客来登。\n眼初明。\n如泛银河，天上跨长鲸。\n君是济川舟楫手，将许事，笑谈成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其五","author":"王庭圭","text":"楼头钟鼓变新声。\n晚霞晴。\n水云生。\n何处归帆，争泊蓼花汀。\n遥望虹桥如画里，鳌背上，著人行。\n夜阑风定见危亭。\n却重登。\n景方明。\n影落波心，疑是海中鲸。\n愿借吸川沧海量，为公寿，落桥成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其三 辰川上元","author":"王庭圭","text":"夜郎江上看元宵。\n斗回杓。\n雪初消。\n灯火银花，何处是星桥。\n哄得满城春不夜，三妓女，五溪徭。\n此时回首忆行朝。\n太平楼。\n倚层霄。\n红蜡光中，买酒听吹箫。\n且就天涯聊一醉，歌一曲，望京谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其一 吴贡道班师置酒","author":"王庭圭","text":"锦袍绣帽跃金鞍。\n卷旗幡。\n整师还。\n轻骑穷追，湘尾鼓声寒。\n千里尘清高会处，张翠幕，万人看。\n藕丝衫袖捧雕盘。\n玉颓山。\n夜将阑。\n幸遇休兵，且尽玉壶宽。\n未用汉军频出塞，徒生事，斩楼兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"王庭圭","text":"一拂退黄衫子，几团嗅蕊蜂儿。\n西风吹下月中枝。\n种在寒岩影里。\n人道蜡梅相似，又传菊满东篱。\n饶伊颜色入时宜。\n安得香传九里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 上元","author":"王庭圭","text":"少年时节，见皇州灯火，衣冠朝市。\n天汉桥边瞻凤辇，帘幕千家垂地。\n人似神仙，身游佛国，谪堕红尘里。\n如今憔悴，渐无往岁欢味。\n此夜帝里喧传，太平祥瑞，有街头人醉。\n更值端门新又起，楼阙千兵严卫。\n朝野多欢，边庭初静，歌舞方腾沸。\n良宵好景，异时多少遗事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨霖铃 雪","author":"王庭圭","text":"琼楼玉宇。\n满人寰似、海边洲渚。\n蓬莱又还水浅，鲸涛静见，银宫如许。\n紫极鸣筲声断，望霓舟何处。\n待夜深、重倚层霄，认得瑶池广寒路。\n郢中旧曲谁能度。\n恨歌声、响入青云去。\n西湖近时绝唱，总不道、月梅盐絮。\n暗想当年宾从，毫端有惊人句。\n谩说枚叟邹生，共作梁园赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其三","author":"王庭圭","text":"寂寞久无红袖饮，忽逢皓齿轻讴。\n坐令孤客洗穷愁。\n谁知沅水上，却似洛城游。\n闻道辰溪贤令长，深房别锁明眸。\n多年铅鼎养青虬。\n不应携妓女，骑鹤上扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其四","author":"王庭圭","text":"帘外东风吹断梦，卷帘人探春还。\n一枝疏影动檐间。\n鸳鸯□瓦冷，霜月堕栏干。\n闻道寿阳如许好，晨妆洗尽微殷。\n可怜玉骨瘦孱孱。\n谁家长笛□，吹彻玉楼寒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一","author":"王庭圭","text":"家住天门阊阖外，别来几度花开。\n近传消息到江淮。\n玉京知好在，金阙尚崔嵬。\n流落江南山尽处，雨馀苍翠成堆。\n暂同溪馆醉尊罍。\n恐随丹诏动，且任玉山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二 梅","author":"王庭圭","text":"问道春来相识否，岭头昨夜开花。\n水村烟坞寄生涯。\n月寒疏影淡，整整复斜斜。\n素面玉妃嫌粉污，晨妆洗尽铅华。\n香肌应只饭胡麻。\n年年如许瘦，知是阿谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]