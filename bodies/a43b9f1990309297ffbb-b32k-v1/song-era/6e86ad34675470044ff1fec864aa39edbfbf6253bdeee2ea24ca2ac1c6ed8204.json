[{"title":"龙华山寺寓居十首 其五","author":"王之望","text":"海国幽栖地，春风欲暮时。\n病忧梅雨逼，贫叹麦秋迟。\n并日终无愧，逢年会有期。\n饥寒宁苟免，吾道讳磷缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其四","author":"王之望","text":"作客他乡久，宜人此界稀。\n身閒长挟策，地僻惯披衣。\n妻有齑盐乐，儿因笋蕨肥。\n出门何所适，终日掩荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其三","author":"王之望","text":"嗜好非前日，颠狂减少年。\n久疏长夜饮，新学小乘禅。\n觅句驱春恨，翻书引昼眠。\n朝来山鸟闹，惊破睡中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其二","author":"王之望","text":"斋饭来香积，钟声出翠筠。\n僧投松径远，鸟下石坛驯。\n茶摘春山嫩，泉烹雨涧新。\n萧然烟篆室，处处喜留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其一","author":"王之望","text":"抱病云山远，兴怀节物新。\n林红纷过雨，岭翠郁堆春。\n猿鸟时相狎，烟霞日自亲。\n可怜成底事，半世走风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"关子东约中秋游天竺再用前韵有诗和之","author":"王之望","text":"湖光尽处两山开，夹道苍松郁壮哉。\n水过冷泉双涧合，石飞天竺一峰来。\n胜游喜有幽人约，佳句俄催爽气回。\n桂子中秋正芬馥，流霞好泛月边杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前二诗韵 其一","author":"王之望","text":"洞府仙扃本不关，凡踪长堕世尘间。\n胜游得得今须遍，俗驾迟迟肯遽还。\n绝巘晨光收雨脚，群峰春色亸烟鬟。\n感通珍重神灵意，诗思虽荒讵敢悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和制帅 其三","author":"王之望","text":"丘园养浩久怀安，忽侍天威咫尺间。\n草制方观周诰命，筹边聊重蜀江山。\n抟风已激三千水，掣电终归十二闲。\n天遣词人来作牧，勒铭重刻剑门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和制帅 其四","author":"王之望","text":"羁怀感槩少多违，世路迍邅老更迷。\n松槚十年乖种植，妻孥万里困携提。\n龙门偶幸馀光借，雁塔曾同伯氏题。\n拥彗祇今知不晚，曹装犹未去三齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和制帅 其二","author":"王之望","text":"露宿风餐走部封，要询民瘼下情通。\n消磨光景驱驰里，疲弊精神倥偬中。\n珠玉忽收千里赠，尘埃顿洗一襟空。\n病馀快觉心情爽，愈却头风耳不聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和制帅 其一","author":"王之望","text":"用尽登山力，方知行路难。\n孤峰宁久驻，半岭敢求安。\n远目穷千里，危肠搅百酸。\n川原忽开豁，歧路正平端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和制帅 其六","author":"王之望","text":"圣主不忘远，惠怀尧所难。\n如何吾所部，疲瘵未全安。\n诏条少宣布，牒诉多悲酸。\n抚节夜长叹，忧惭非一端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年十人会于湖上巫子先拘台制不来有诗次韵","author":"王之望","text":"曲江一散各西东，杯酒重来气尚雄。\n才薄愧参龙虎榜，会难常叹马牛风。\n弟兄半已颠毛白，宾主休辞醉颊红。\n底事坐中犹未乐，车公不遂一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同庞彦才晚酌于涵翠轩","author":"王之望","text":"登临到处久徘徊，水色山光滚滚来。\n百顷烟村抱城郭，数峰云水拥楼台。\n千篇取足诗材剩，万轴横陈画笥开。\n清兴穷探犹未厌，更投涵翠举馀杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同诸乡人泛临安西湖","author":"王之望","text":"短棹夷犹处，湖平酒满觞。\n荷深迷去路，波浅涩归航。\n落日山头暗，西风水面凉。\n今朝一尊共，相对恍江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕叔恭运使和题皇华馆诗复次韵","author":"王之望","text":"何处溪声响佩环，洗心堂下转潺湲。\n数株古柳枯临水，百亩丛篁翠倚山。\n岁久刊题多泯灭，时清景物自幽閒。\n轺轩登览留佳句，顿觉林泉发妙颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王圜中二首 其二","author":"王之望","text":"舟兀东风怯晓寒，绿杨堤畔见青山。\n溯流不碍朝天去，掉鞅何当拜命还。\n半世光阴忧患里，他时勋业笑谈间。\n儿童似觉吾衰老，只欲西归便丐閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王圜中二首 其一","author":"王之望","text":"网得金鳞不忍烹，一瓯春菜眼偏明。\n逢君强赋湖阴曲，顾我方趋日照城。\n散坐酴醾留客醉，过庭鹎鵊为谁鸣。\n还朝密迩非轻别，知有蒲轮访姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘南伯二首 其二","author":"王之望","text":"十年踪迹困邅如，多谢韦郎肯寄书。\n千里漫寻苕水梦，一廛方对相山居。\n归心不为莼鲈切，交契应闲简牍疏。\n近向钱塘得嘉种，秋盘何日共新蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘南伯二首 其一","author":"王之望","text":"晓来庭竹碎秋声，令我思君重怆情。\n三画当年曾擅价，五言今去合知名。\n赋归已荷因风寄，酾藇终期对月倾。\n但愿官军破骄敌，不妨淮海寄馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈勉仲见留之什","author":"王之望","text":"新诗俊逸走风雷，愧我驰驱欲强陪。\n花外疏篁青掩映，门前流水绿萦回。\n高情好客长留客，胜赏传杯莫放杯。\n老懒畏寒朝睡美，报章淹缓莫相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵制帅和王宪二首 其二","author":"王之望","text":"二麦初收堰水流，西园飞盖使君游。\n羽旄每出邦人喜，壶矢閒同坐客投。\n膏雨应时和气洽，丰年有兆颂声酬。\n政成讼简追胥息，镇静西南五十州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵制帅和王宪二首 其一","author":"王之望","text":"淮水绵绵不绝流，渡江龙化复东游。\n宗盟尚诧当年盛，交分还欣此日投。\n名并邛郲公等继，政称京兆我难酬。\n得时俱为公家计，三窟宁当各一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵贺子忱春事","author":"王之望","text":"老境流年速，春风几日晴。\n清尊花下怯，白发镜中明。\n蝴蝶迷幽梦，仓庚愧好声。\n良辰一尊酒，钟鼎可忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自公堂诗","author":"王之望","text":"丛石当轩峙，横池傍砌深。\n还将修竹绕，半入古榕阴。\n昼赏风澜皱，宵怜月影侵。\n聊纾江海志，寄此小山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐尧佐寄诗许予授代归谷城日相过次韵","author":"王之望","text":"故人千里去，犹记别时歌。\n衰鬓禁愁得，狂怀可奈何。\n南枝春意动，西望夕阳多。\n三径荒凉外，高轩讵肯过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别友人","author":"王之望","text":"此日天涯别，春风断客魂。\n绿杨初暗路，芳草欲迷村。\n祖帐前山远，骊歌落日昏。\n相思今夜月，不复对清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴明可寄诗次韵为答","author":"王之望","text":"两地相望百舍强，相思空结九回肠。\n君家沧海宾初日，我戍衡山俯夕阳。\n情话何当倾肺腑，倦游聊复信行藏。\n求田问舍真长策，捧檄荣亲道更光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"坐中赠朱尉庆长","author":"王之望","text":"君尉襄阳日，吾方首善游。\n素交微半面，青顾乃双眸。\n有喜一樽共，相期三径幽。\n溪山许分老，为我缮菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿处州徐守三首 其三","author":"王之望","text":"赤矢朱弓祖庆绵，五云吉梦世生贤。\n嘉时浃日迎重九，景运中天恰半千。\n律播金商资爽气，露和琼屑引遐年。\n寿觞莫负专城贵，好对西风醉管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿处州徐守三首 其二","author":"王之望","text":"共理经年惠利丰，此邦歌颂蔼提封。\n仙都洞府春风好，处士星躔瑞气浓。\n道向偓佺传口诀，禅从摩诘悟心宗。\n世间功业公馀事，平日高情薄万钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿处州徐守三首 其一","author":"王之望","text":"仆射文章六百春，人间又见石麒麟。\n朱颜白发古仙伯，和气清风今德人。\n出处三朝常守道，承宣千里更宜民。\n圣时共政须耆旧，归去千秋辅紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿台州黄守","author":"王之望","text":"千载初平庆未穷，本支今复见仙翁。\n当年郜鼎争尤力，此日于门报已隆。\n政尚宽和承祖烈，量涵清浊称家风。\n赐金增秩知非晚，行看丝纶下禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张和公母秦国太夫人挽词","author":"王之望","text":"誓比共姜早，贫如翟母希。\n三迁功可大，五福报无违。\n衮绣供儿綵，风幡契祖机。\n千秋凭直笔，图史播芳徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀李相之","author":"王之望","text":"李子通家旧，人门孰与侔。\n胸中足今古，皮里贮阳秋。\n尊酒怀清致，关山隔俊游。\n江城携手地，春色黯离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还鲜于蹈夫诗编","author":"王之望","text":"百首新诗句句妍，追还江左一千年。\n春归池草难专美，冷入江枫称所传。\n一字人知吟不到，八分我喜录成编。\n西来所得真多矣，满箧今藏锦绣篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人 其二","author":"王之望","text":"坐阅江城岁月迁，心劳政拙岂能贤。\n昔游泉石迷寻访，故里风烟喜接连。\n聊假颁宣行素学，敢将迟暮叹华颠。\n他年良史徵佳什，会入西京循吏篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人 其一","author":"王之望","text":"弟兄南渡各驰驱，几奉君王尺一除。\n黄耳音书寄怀抱，乌衣门巷惜丘墟。\n澄清孟博荣持节，雅量玄平静著书。\n五桂家风殊未艾，黄山佳气蔼如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和关子东筇杖","author":"王之望","text":"老境生涯正倚君，周旋夷险共悲欣。\n最怜磊磊多高节，未肯斑斑出异文。\n汉阁灯来徒照夜，葛陂龙去谩拿云。\n愿为灵寿扶黄发，廊庙他年看勒勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李士举陪提刑徽猷游中梁山临秀远轩以望江中平陆之胜承示佳句且叙故旧离合之感次韵二首 其二","author":"王之望","text":"京口追游地，钱塘执别年。\n飘流恍如梦，聚散岂其天。\n夙驾行趋诏，当朝正急贤。\n紫荷持从橐，去去入林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李士举陪提刑徽猷游中梁山临秀远轩以望江中平陆之胜承示佳句且叙故旧离合之感次韵二首 其一","author":"王之望","text":"空翠浮轩槛，岚光拂栋梁。\n江随平野曲，林拥暮山苍。\n城郭犹平日，田畴本乐乡。\n呻吟未休息，衰病意空长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李清卿雪","author":"王之望","text":"浩荡天花弄晓光，春风未转忽芬芳。\n人跻物外红尘远，境堕壶中白昼长。\n风柳冷飘三月絮，寒梅幽寄一枝香。\n朝来暴喜家风贵，圆璧方圭满舍旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和制帅","author":"王之望","text":"离索堪惊岁月忙，少城遗爱未曾忘。\n西园尚记英游并，南浦空嗟别恨长。\n壮志且窥勋业镜，高情休忆水云乡。\n玉关柝静边烽息，汉殿归称万岁觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和制帅 其一","author":"王之望","text":"按部经时走四封，云山有路宝岩通。\n普贤相对圆光里，摩诘不离方丈中。\n喜有篇章交寄远，恨无羽翼可凌空。\n来诗忽作蛟龙吼，三日能令两耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和制帅 其二","author":"王之望","text":"自怜麋鹿性疏顽，心在云林迹世间。\n每厌尘埃驱俗驾，不辞险阻访名山。\n池鱼得意时归壑，厩马长鸣暂出闲。\n万仞峰头曾进步，禅机一拨透三关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和眉守王郎中","author":"王之望","text":"惊风鸿鹄各翻飞，同落西南蜀一维。\n一日三秋双鬓改，两乡千里寸心驰。\n清香燕寝多佳致，远景楼台发妙词。\n只恐江山留不得，赐环闻已下丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾丈赠光化令赵元质","author":"王之望","text":"奔波朝士觅官忙，独买扁舟去意长。\n汲黯旧闻羞作令，冯唐今愧老为郎。\n鹓鸿引去知何慕，鸥鹭归来不乱行。\n窃食端输厕中鼠，惊馀犹得饱饥肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"房公湖","author":"王之望","text":"金雁桥南二顷湖，房公遗迹未湮芜。\n人游杜牧晚晴赋，境对王维别墅图。\n经始林泉心自巧，折冲廊庙术何迂。\n当时只作幽人计，留得陈陶四万夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浑醉庵诗","author":"王之望","text":"人间岁月都几许，醉里光阴差较长。\n千日不醒终有尽，百年浑得要为常。\n故人屡过无穷巷，一室能宽有醉乡。\n好事不妨多酌我，老来无复次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇华馆以上巳落成因修禊事题诗纪之","author":"王之望","text":"泉上新台紫翠环，暮春修禊俯潺湲。\n汉流尚带桃花水，云气初披杏子山。\n柳絮轻飏晴日暖，竹光不动午阴閒。\n时和岁稔游人乐，一醉聊开病守颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相之见和有真能乘兴之句再次韵","author":"王之望","text":"一月如三岁，怀君未足侔。\n情亲频入梦，句好欲生秋。\n真有山阴兴，聊寻河表游。\n翻愁江上别，心事不堪忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺刘侍郎三首 其三","author":"王之望","text":"万景楼头尽日留，乌尤岭上及春游。\n溪潭杳渺游鱼乐，林木阴森倦鸟投。\n千尺梵身名不谬，半轮山月句难酬。\n争流竞秀君休问，更有江声撼一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺刘侍郎三首 其二","author":"王之望","text":"汉嘉平日想风流，喜作凌云载酒游。\n尘土何时公事了，林泉聊与故人投。\n心期济物衰难强，志在求田老未酬。\n官满便当投劾去，一航从此下扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺刘侍郎三首 其一","author":"王之望","text":"早岁儒林俊誉流，中年持橐侍宸游。\n论思清禁三朝遇，閒散殊庭二纪投。\n迹与香山齐出处，诗将彭泽尽赓酬。\n似闻璧水求三老，行起蒲轮慰九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王教授子节父","author":"王之望","text":"綵衣方喜奉安舆，丹旐俄惊返故居。\n已作善人称里闬，固宜阴德大门闾。\n悟超庭柏心无碍，香茁阶兰庆有馀。\n哀挽一声寒日外，萧萧风树锁郊墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽季通判","author":"王之望","text":"六艺潜心老益尊，此邦耆旧众推贤。\n高文早出诸儒右，清节宜书独行篇。\n白首可怜才半刺，朱衣犹得贵重泉。\n佳城一閟成千古，寂寞哀笳惨暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林给事中母柳夫人词三首 其三","author":"王之望","text":"方喜门施戟，俄惊容奠刍。\n孤鸾空对影，老凤独将雏。\n祖送倾朝士，哀荣震帝都。\n祇应归葬处，千两拥山隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林给事中母柳夫人词三首 其二","author":"王之望","text":"作配归华族，生贤瑞国朝。\n升堂拜王导，窥牖识房乔。\n綵服金龟重，安舆驷马骄。\n庆门今鼎盛，环佩忽萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林给事中母柳夫人词三首 其一","author":"王之望","text":"联德成偕老，和鸣六十春。\n休声传孝妇，馀庆产名臣。\n人去虚韦幔，哀深泣孟邻。\n千年凭直笔，图史播芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栖贤三峡桥次南康守晏德基韵","author":"王之望","text":"古寺深藏紫翠间，清风夹道凛苍官。\n千寻秋色岩峦净，十里雷声涧谷寒。\n此去洗心应少累，从来蓄眼未经看。\n使君健笔题佳句，一首新诗倒醉澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题光相寺","author":"王之望","text":"至人悲念摄冥顽，倏见光明指顾间。\n亿劫未曾亲见佛，一宵今得暂栖山。\n从来叶障须除结，此去功名直等閒。\n欲以残年奉香火，尘劳无计恋松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题修觉山绝胜亭","author":"王之望","text":"古寺幽岩万木稠，蜀川一览尽西州。\n依微远树低平野，散漫清江吐乱洲。\n老眼乍明疑岘首，归心忽动忆槎头。\n当年风物悲游子，子美应同故国愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缺题","author":"王之望","text":"天梯云栈转龙旗，细雨凄风暗路岐。\n七夕难忘祈巧夜，三乡不以望仙时。\n曲江若悟贤臣语，汾水宁伤才子词。\n此日铃声肠断处，后庭遗唱未为悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缺题","author":"王之望","text":"霜晴爱日晓生东，萧寺山茶赏岁丰。\n锦里出遨驱小队，雪山纳堠狎诸戎。\n叶连油幕侵天碧，花倚朱旗特地红。\n美景良辰万人喜，不妨行乐一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]