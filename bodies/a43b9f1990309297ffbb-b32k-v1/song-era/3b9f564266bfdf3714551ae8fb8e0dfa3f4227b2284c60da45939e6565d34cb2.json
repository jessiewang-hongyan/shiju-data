[{"title":"王左丞新菊","author":"李维","text":"青规前席暇，归沐兴何长。\n北第秋将晚，东篱菊正芳。\n幽丛霏薄雾，桂色艳轻霜。\n已近黄金印，兼临白玉堂。\n甘疑掩萍实，秀肯让芝房。\n有佞还应指，无忧可要忘。\n蕊浮丞相酒，气馥令君香。\n好固松椿寿，仙经识秘方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"李维","text":"秋声和暮角，膏雨逐行轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李维","text":"谪去贾生身健否，秋来潘岳鬓斑无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"李维","text":"使梅和雪赏，僮橘过霜收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"李维","text":"昨日并今日，斋郎与挽郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李维","text":"清朝纳禄犹强健，白首还家正太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李维","text":"转盼回岩电，分髯磔猬毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和内翰杨大年见寄","author":"李虚己","text":"鳌冠三峰碧海宽，云谣初下霭芝兰。\n采珠宫里骊龙睡，织锦机中彩凤盘。\n药砌苍苔钱作点，粉墙脩竹玉为竿。\n闲从庄蝶亲凫舄，曾得安期九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和汝南秀才游净土见寄","author":"李虚己","text":"长松系马驻吟鞭，水殿沈檀一树烟。\n苔破闲阶幽鸟立，草芳深院老僧眠。\n桃花欲放条风后，茶蕊新供谷雨前。\n衰会赏诗多狎客，我无岐路近神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何水部蒙出牧宜阳","author":"李虚己","text":"宜川三月水东流，秀出江南二十州。\n红旆使君今日去，白衣举子昔年游。\n海潮赋就藏书府，竞渡诗成在郡楼。\n国史待修循吏传，政声早晚达凝旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄化城寺","author":"李虚己","text":"化城金地出人群，瀑布峰前一径分。\n宝塔香灯诸洞见，石楼钟磬半天闻。\n子明丹灶封秋藓，李白书堂锁暮云。\n欲去未能还结念，展图时诵北山文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院 其二","author":"李虚己","text":"绿池寒竹绕书斋，鼓箧横经任往回。\n积善原从千里应，表门恩自九天来。\n文章卷里蟾枝秀，礼义乡中棣萼开。\n记得浮云深处景，岩深应长栋梁材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建茶呈使君学士","author":"李虚己","text":"石乳标奇品，琼英碾细文。\n试将梁苑雪，煎动建溪云。\n清味通宵在，馀香隔坐闻。\n遥思摘山月，龙焙未春分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院 其三","author":"李虚己","text":"部符南粤转轺车，三宝新题表义闾。\n药石好携灵运句，素筠留得蔡邕书。\n平原架上衣无主，过客堂中食无鱼。\n见说下帷多俊士，共瞻司马慕相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院 其一","author":"李虚己","text":"聚族逢修偃，垂绅偶会昌。\n里闾师重厚，门阀诫轻扬。\n木垄堆云秀，书帷积雪光。\n清名传异域，丽句出中堂。\n玉蕴山还润，兰生谷更香。\n友朋敦布素，童稚味膏粱。\n铸剑归农器，休牛见服箱。\n斋心常拱极，端简立秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏松","author":"李师中","text":"半依岩岫倚云端，独立亭亭耐岁寒。\n一事颇为清节累，秦时曾作大夫官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登屏山","author":"谢尧仁","text":"有约携壶九日游，扶筇选胜豁双眸。\n天空晴送群峰翠，野旷寒生落木愁。\n浊酒故饶狂士态，黄花羞插老人头。\n凭高不管风吹帽，坐破屏山一色秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"谢尧仁","text":"奇奇水上花，湛湛花下水。\n花得水扶持，水因花富贵。\n当中既植藕，四畔还种苇。\n自然秋风生，便有江湖意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒丞相祠观八阵图","author":"李訦","text":"人言忠孝不磨灭，神物护持存水浒。\n千家陵谷几变迁，此石不移自章武。\n本由黄帝古兵法，六十四以八为伍。\n髯孙且惧仲达走，贼操游魂何敢拒。\n刻铭沙石水底碑，教战石存山下鼓。\n一片丹心天地间，万世闻风犹禦侮。\n我来起敬凛如生，再拜一言公必取。\n瀼流东截阵图前，寖隳城壁颓民宇。\n能安拳石止波流，愿回瀼患思民抚。\n常使夔人知感公，踏碛年年吊千古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾","author":"谢尧仁","text":"下腾赤蛟身，上抽碧龙头。\n千枝蟠一盖，一盖簪万毬。\n花要带月看，香要和露收。\n一点落衣袂，经月气未休。\n一点入酿瓮，经岁味尚留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题平亭","author":"李訦","text":"狄公有记记蛮平，蛮不难平将贵精。\n勉矣诸君修将业，请将平字作亭名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"控巴台次韵 其一","author":"李訦","text":"翠岸红灯寄语，要自江南看来。\n多景齐云楼下，当年使鹢招回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"控巴台次韵 其二","author":"李訦","text":"谁道地拘偪窄，须知天閟幽妍。\n一段丹青台阁，何人淡扫松烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六州歌头 吊武穆鄂王忠烈庙","author":"李訦","text":"高皇神武，善驾驭豪英。\n攘北狄，驱群盗，命天膺。\n救苍生。\n奈梦绕沙漠，隔温情，屈和好，召大将，归兵柄，列枢庭。\n公指汴京。\n威已振河洛，不顾身烹。\n失一时机会，嗟左衽吾民。\n痛岳家军。\n孰扶倾。\n久沈冤愤，七十载，还复遇，帝王真。\n表遗烈，锡王号，日照临。\n激士心。\n始识安刘计，宁祸己，是忠臣。\n我乘传，访壁垒，想精明。\n英气懔然若在，仍题扁、昭揭天恩。\n笑原头芳草，一死不能春。\n交怨人神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 次琼山韵","author":"李訦","text":"足迹半天下，家说在琼川。\n往来无定，蓬头垢面任憎嫌。\n挥扫笔头万字，贯穿胸中千古，不记受生年。\n海角一相遇，缘契似从前。\n钟离歌，吕公篆，醉张颠。\n恍如赤城龙凤，来过我鲸仙。\n笑我未离世网，不染个中尘土，饥食困来眠。\n拟问君家祖，兜率乐天天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"谢尧仁","text":"半夜鬼神朝水府，五更鼓角动扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题真空阁","author":"李熙辅","text":"栝苍山上云，山好云亦好。\n可怜山下僧，看云不知老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"李铨","text":"一朵千金，帝城谷雨初晴后。\n粉拖香透。\n雅称群芳首。\n把酒题诗，遐想欢如旧。\n花知否。\n故人清瘦。\n长忆同携手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉岩 其一","author":"李传","text":"雨馀山色一番新，物态民情若遇春。\n正好凭高飘逸兴，便教避世出红尘。\n再登云外通天路，就见岩中慕道人。\n俯仰熙和都得意，心欢手舞喜逢辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉岩 其二","author":"李传","text":"良时渐近一归新，人物熙熙乐此春。\n石磴屈盘登绝顶，岩高虚寂断纤尘。\n登临疑是壶中景，谈笑真同物外人。\n可是英灵招隐逸，芳名千载起兹辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李善","text":"无穷基有无穷问，第一人为第一官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李善美","text":"岘首何人碑，行客独垂泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其三 玉滩夜月","author":"李堪","text":"鸣玉滩头片月生，波光掩映钓舟横。\n何人隔岸吹长笛，一曲凉州恰二更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其四 华顶秋容","author":"李堪","text":"何处栖真远世纷，五华高顶绝人氛。\n仙翁自有餐霞法，谩使人间望彩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其二 西山晴雪","author":"李堪","text":"西山岌岌倚层霄，爽气恒多瘴气消。\n谁道闽中无雨雪，年年绝顶见璚瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其八 剑溪渔唱","author":"李堪","text":"水过云津势渐平，双溪汇作剑溪清。\n渔舟往来无人见，隔竹时闻欸乃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其七 蓝洞归云","author":"李堪","text":"洞门不闭日空虚，云去云来何定居。\n看到虚中生白处，恰如混沌未分初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其一 翠屏朝雨","author":"李堪","text":"翠屏山下雨霏霏，云掩冈峦草树微。\n一段丹青谁解写，画家惟有米元晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舞雩台","author":"李堪","text":"舞雩台上春风起，鲁国先生讲始开。\n欲解陶潜印归去，心思吾道重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌目山五题 其五 龙院","author":"李堪","text":"林下金仙地，苔门掩夕阳。\n花飞殿塔顶，地照云霞光。\n松老鹤仍在，洞闲龙已翔。\n中宵动清众，清磬发虚堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌目山五题 其一 兴福寺","author":"李堪","text":"云门十里长，殿塔明朝阳。\n半夜风雨至，满山松桂香。\n清猿啸远壑，好鸟鸣虚廊。\n尘土斯可濯，胡为语沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌目山五题 其二 延福院","author":"李堪","text":"兰桂绕禅关，半春香满山。\n风移金磬远，云伴玉龙闲。\n树暗猿吟外，花开僧定间。\n尘心自然洗，流水日潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌目山五题 其三 净居院","author":"李堪","text":"入门松桂深，清气生人心。\n霞影迷窗绮，花光照地金。\n微风起层阁，初月升高林。\n终夜魂自健，满堂钟磬音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慧聚寺","author":"李堪","text":"古寺有远名，欲游先梦生。\n飞猿涧底啸，灵鸟云间鸣。\n影密楼台众，香繁草树荣。\n何年照佛火，灿灿长光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌目山五题 其四 永庆寺","author":"李堪","text":"岩扉开早凉，谷鸟纷远翔。\n花气湿幽径，磬声清上方。\n云生松涧底，泉落藓池傍。\n我有遗荣意，移时坐石床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙楼道院","author":"李堪","text":"寻源探云霞，中有金仙家。\n绮疏晃飞翚，雕栏灿朱华。\n珍禽栖不去，灵液流无涯。\n晴旭起风篁，空香送天花。\n春雷会社鼓，寒烟聚海茶。\n奇峰媚如削，芳树一何嘉。\n且将翠阁齐，绝与红尘赊。\n终然谢朝绂，此地营丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其六 文笔夕照","author":"李堪","text":"玉邑东南第一峰，铦锥颖脱乱山中。\n夕阳影里分明见，五色文章耀笔锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉田八景 其五 仙岭樵歌","author":"李堪","text":"金仙洞头樵子多，负薪出山行且歌。\n仙家棋局无心看，只恐归时烂斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"极乐寺","author":"李堪","text":"空门出白云，梵宇依苍岫。\n天色湛瑶光，春花结野秀。\n檐间绮罗被，池底星珠漏。\n香沉烟篆馀，文兼雨碑旧。\n恬智静可养，寂寞谁复扣。\n逍遥隐叶猿，盘薄穿花溜。\n团团草露晞，瑟瑟空香逗。\n层台太虚半，双壑瀑泉透。\n苔空绿钱死，松老清阴瘦。\n独鹤倏飞骞，深萝苦纷构。\n归涔待沃洲，芥子观灵鹫。\n净土人不来，尘寰廓然昼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿慧聚寺","author":"李堪","text":"石林高月生，藓阁疏磬鸣。\n宿鸟梦难就，定僧魂更清。\n香风动花影，岩瀑飞玉声。\n遥夜坐来短，但馀天外情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李堪","text":"桐乡留语葬，铭路在生悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李堪","text":"海月随帆落，溪花绕驿流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李堪","text":"雷风有约春虬起，霜露无情紫蕙枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李堪","text":"雨密丝桐润，潮平钓石沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陕府芮城县群贤凉轩诗","author":"李寔","text":"自昔闻南国，于今讼已微。\n优哉贤墨绶，经始雅轩扉。\n白日有馀乐，清风知所归。\n如何心已化，尚寄玉琴徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"李巽","text":"孝义门风累世修，帝恩旌表耀南州。\n藏书不特延多士，贡币仍闻亚列侯。\n高阁声寒慈竹雨，小池香老瑞莲秋。\n人来辱示朝贤什，吟咏浑消万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登第遗乡人","author":"李巽","text":"当年踪迹困泥尘，不意乘时亦化鳞。\n为报乡闾亲戚道，如今席帽已离身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七星山","author":"李弼","text":"乘兴上东山，天风拂壮颜。\n七星连地脉，一窍透天关。\n玄鹤何年去，丹炉尽日閒。\n我因厌尘俗，到此不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日怀秦髯","author":"李彭","text":"山雨萧萧作快晴，郊园物物近清明。\n花如解语迎人笑，草不知名随意生。\n晚节渐于春事懒，病躯却怕酒壶倾。\n睡馀若忆旧交友，应在日边听晓莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其四 老南","author":"李彭","text":"万古黄龙真夭矫。\n斩新勘破台山媪。\n佛手驴蹄人不晓。\n无关窍。\n胡家一曲非凡调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其五 晦堂","author":"李彭","text":"宝觉禅河波浩浩。\n五湖衲子来求宝。\n忽竖拳头宜速道。\n茫然讨。\n难逃背触君须到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其三 云峰","author":"李彭","text":"孤硬云峰无计较。\n大愚滩上曾垂钓。\n佛法何曾愁烂了。\n桶箍爆。\n通身汗出呵呵笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其八 死心","author":"李彭","text":"骂佛骂人新孟八。\n是非窟里和身拶。\n不惜眉毛言便发。\n门庭滑。\n红炉大韛能生效。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其九 灵源","author":"李彭","text":"绝唱灵源求和寡。\n先牛寻得西家马。\n顾陆笔端难拟画。\n千林谢。\n吟风摆雪真萧洒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其一 湛堂","author":"李彭","text":"选佛堂中川藞苴。\n衲僧卑孔头垂下。\n独秀握来无一把。\n杖头挂。\n从教四海禅徒讶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其一 汾阳","author":"李彭","text":"南院嫡孙唯此个。\n西河狮子当门坐。\n绢扇清凉随手簸。\n君知么。\n无端吃棒休寻过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其二 慈明","author":"李彭","text":"掌握千差都照破。\n石霜这汉难关锁。\n水出高源酬佛陀。\n哩棱逻。\n须弥作舞虚空和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其七 潜庵","author":"李彭","text":"积翠十年丹风穴。\n当时亲得黄龙钵。\n掣电之机难把撮。\n真奇绝。\n分明水底天边月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔歌子十首 颂尊宿付杲山人 其六 真净","author":"李彭","text":"贬剥诸方真净老。\n顶门眼正形枯槁。\n一点深藏人莫造。\n由来妙。\n光明烜赫机锋峭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊贾氏园池","author":"李彭","text":"瑶房锦树曲相通，能几番春事已空。\n惆怅旧时吹笛处，隔窗风雨剥青红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都城元夜","author":"李彭","text":"斜阳尽处荡轻烟，辇路东风入管弦。\n五夜好春随步暖，一年明月打头圆。\n香尘掠粉翻罗带，蜜炬笼绡斗玉钿。\n人影渐稀花露冷，蹋歌吹度晓云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]