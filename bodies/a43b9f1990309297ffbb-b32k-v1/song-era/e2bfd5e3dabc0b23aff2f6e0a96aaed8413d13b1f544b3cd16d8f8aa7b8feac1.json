[{"title":"清明雨寒八首 其二","author":"杨万里","text":"脱却单衣著裌衣，禁烟无有不寒时。\n一年好处君知么，寒食千门插柳枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明雨寒八首 其一","author":"杨万里","text":"整冠忽见镜中霜，挽树浑无蒂上香。\n已贮春愁过万斛，更令细细著升量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓出郭迓客七里庄二首 其二","author":"杨万里","text":"偏得春怜是柳条，腰支别作一般娇。\n微风不动渠犹舞，刚道东风转舞腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓出郭迓客七里庄二首 其一","author":"杨万里","text":"却为迎宾得探春，白门官柳早尖新。\n如何霜瓦才逢日，半作青瑶半作银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓洪泽放闸四绝句 其三","author":"杨万里","text":"遮藏水面被残冰，流尽残冰水正明。\n幸自奔流总驩喜，落洪须做不平声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓洪泽放闸四绝句 其四","author":"杨万里","text":"沿河过闸梦中闻，奇观何曾似此晨。\n雪溅雷奔乍明眼，天跳地趠也惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓洪泽放闸四绝句 其二","author":"杨万里","text":"满闸浮河是断冰，等人放闸要前行。\n劣能开得两三板，争作摧琼裂玉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓洪泽放闸四绝句 其一","author":"杨万里","text":"起来霜重满淮船，更觉今朝分外寒。\n放闸老兵殊耐冷，一丝不挂下冰滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓湖上三首 其三","author":"杨万里","text":"六月西湖锦绣乡，千层翠盖万红妆。\n都将月露清凉气，并作侵晨一喷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓湖上三首 其二","author":"杨万里","text":"菰月蘋风逗葛裳，出城趁得上番凉。\n荷花笑沐燕支露，将谓无人见晓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓湖上三首 其一","author":"杨万里","text":"山腰轻束一绡云，湖面初颦半蹙痕。\n未说湖山佳处在，清晨小出涌金门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔舟","author":"杨万里","text":"绝小渔舟叶似轻，荻篷密盖不闻声。\n无人无钓无蓑笠，风自吹船船自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理发","author":"杨万里","text":"发脱心知不再生，新年底急顿星星。\n城边老柳也欺我，春里满头依旧青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷雨报恩因到翟园四首 其四","author":"杨万里","text":"未必钱园似翟园，翟园窠木最宜看。\n茂松亭下偏明眼，矮桧平铺翡翠盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷雨报恩因到翟园四首 其三","author":"杨万里","text":"绕亭怪石小山幽，夹径低枝压客头。\n幸自一来惟不早，梅花满地诉春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷雨报恩因到翟园四首 其二","author":"杨万里","text":"草路无泥未有尘，城南城北总游人。\n不缘香火来山墅，孤负今年半段春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷雨报恩因到翟园四首 其一","author":"杨万里","text":"雾气初迎日脚开，春光偏傍柳边回。\n寒暄消息何人会，十指今朝出袖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移瑞香花斛","author":"杨万里","text":"夜掇香窠沐露华，昼移翠斛馥窗纱。\n将身挨起帘帷著，生怕帘帷挨著花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归遇雨","author":"杨万里","text":"略略烟痕草许低，初初雨影伞先知。\n溪回谷转愁无路，忽有梅花一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望","author":"杨万里","text":"病身似怯暮来风，老眼还惊霁后虹。\n落日偏明松表里，好山分占水西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船过苏州二首 其二","author":"杨万里","text":"暮风似箭复如刀，落照那能暖客袍。\n天远地平城更阔，千寻玉塔尺来高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船过苏州二首 其一","author":"杨万里","text":"垂近姑苏特转湾，盘门只隔柳行间。\n望来望去何时到，且倚船窗看远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊夏摘则秋茂朝凉试手","author":"杨万里","text":"种菊君须莫惜它，摘教秃秃不留些。\n此花贱相君知么，从此千千万万花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野店二绝句 其一","author":"杨万里","text":"不劳官吏出将迎，山店如何远有声。\n人报官来争出看，牛逢轿过忽然惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野店二绝句 其二","author":"杨万里","text":"山店茅柴强一杯，梨酸藕苦眼慵开。\n深红元子轻红鲊，难得江西乡味来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野店多卖花木瓜","author":"杨万里","text":"天下宣城花木瓜，日华露液绣成花。\n何须堠子强呈界，自有琼琚先报衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野荼?二首 其二","author":"杨万里","text":"不识荼糜恨杀人，野花香里度芳晨。\n寄笺为报东皇道，不理今年一个春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野荼?二首 其一","author":"杨万里","text":"去岁诸司赏物华，荼糜一会属侬家。\n今年不识荼糜面，却买茅柴对野花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野望二首 其二","author":"杨万里","text":"野童撷菜疏移步，客子追程有底忙。\n茅屋破时偏入画，布衫洗了晒枯桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野望二首 其一","author":"杨万里","text":"也知口业欠消磨，造物嗔人奈口何。\n莫管诗人例寒饿，且容老子小婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野蔷薇","author":"杨万里","text":"红残绿暗已多时，路上山花也则稀。\n藞苴馀春还子细，燕脂浓抹野蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜雀砚","author":"杨万里","text":"摸索陶泓不忍研，阿瞒故物尚依然。\n浪传铜雀檐间瓦，恐是金凫海底砖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"银鱼乾","author":"杨万里","text":"初疑柘茧雪争鲜，又恐杨花糁作毡。\n却是剪银成此叶，如何入口软于绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中讲堂赐酒二首 其二","author":"杨万里","text":"袖手垂鞭出帝闉，万花栏马舞新春。\n是时也有青油伞，天上归来雪满身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中讲堂赐酒二首 其一","author":"杨万里","text":"玉果金柈码碯觞，春坊传令赐云浆。\n雪中上马浑如梦，一片飞来醉面凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中看梅","author":"杨万里","text":"犯雪寻梅雪满衣，池边梅映竹边池。\n要寻疏影横斜底，拣尽南枝与北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中登净远亭四首 其四","author":"杨万里","text":"忍却清寒得得来，不堪骑吏苦相催。\n雁穿银色界中去，人到水晶宫里回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中登净远亭四首 其三","author":"杨万里","text":"壕水深清一镜如，天倾瑶屑打成酥。\n琉璃缸面熬琼粥，酿出珠宫白玉腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中登净远亭四首 其二","author":"杨万里","text":"数片初飞点砌苔，须臾不觉玉千堆。\n去年无雪非无雪，留作今年一并来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中登净远亭四首 其一","author":"杨万里","text":"犯雪来登净远亭，飞花著水旋成冰。\n琼田万顷珠千树，真在瑶台十二层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后晓过八盘岭诣东宫谢受左司告二首 其二","author":"杨万里","text":"玉京世界大千中，银屋楼台一万重。\n好上宝莲山上望，南高峰照北高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后晓过八盘岭诣东宫谢受左司告二首 其一","author":"杨万里","text":"扶桑梢上上朝暾，起早行迟却载奔。\n玉作宫城三万雉，呼僮换马入金门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后晚晴四山皆青惟东山全白赋最爱东山晴后雪二绝句 其二","author":"杨万里","text":"群山雪不到新晴，多作泥融少作冰。\n最爱东山晴后雪，却愁宜看不宜登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后晚晴四山皆青惟东山全白赋最爱东山晴后雪二绝句 其一","author":"杨万里","text":"只知逐胜忽忘寒，小立春风夕照间。\n最爱东山晴后雪，软红光里涌银山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪霁出城","author":"杨万里","text":"梅于雪后较多花，草亦晴初忽几芽。\n河冻落痕馀一寸，残冰阁在柳根沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴二首 其二","author":"杨万里","text":"晴光雪色忽相逢，雨滴空阶日影中。\n珍重北檐殊韵胜，苛留残玉不教融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴二首 其一","author":"杨万里","text":"仙人剪水作花飞，忽化琼瑶已大奇。\n复把琼瑶化成水，滴来平地总琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴窗开展唐诗得一片桃花怅然赋之","author":"杨万里","text":"偶开诗卷雪窗晨，中有桃花片尚新。\n却忆携诗花底看，回头又是一年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"领客南园二首 其二","author":"杨万里","text":"人间俗杀是公筵，最苦沉烟杂烛烟。\n何似大家行几步，逢花即饮醉还眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"领客南园二首 其一","author":"杨万里","text":"南园多日不曾来，领客闲行始此回。\n独树小梅开一朵，被它栏住劝三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄菊","author":"杨万里","text":"莺样衣裳钱样裁，冷霜凉露溅秋埃。\n比他红紫开差晚，时节来时毕竟开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄雀食新二首 其二","author":"杨万里","text":"侯门信口总称珍，只见陈人不见新。\n三日荔枝香味变，况开酱瓿拂蛛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄雀食新二首 其一","author":"杨万里","text":"鹅黄染线织秋衣，杨柳吹绵细细披。\n诗债被渠浑索尽，醉乡邀我不容归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富阳登舟待潮回文","author":"杨万里","text":"山接江清江接天，老人渔钓下前滩。\n寒潮晚到风无定，船泊小湾春日残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒鸡","author":"杨万里","text":"寒鸡睡著不知晨，多谢钟声唤起人。\n明晓莫教钟睡著，被它鸡笑不须嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜不寐","author":"杨万里","text":"雪入迎春鬓，茶醒学古胸。\n梦回霜满屋，吟到月斜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其十五","author":"杨万里","text":"万顷湖光一片春，何须割破损天真。\n却将葑草分疆界，葑外垂杨属别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其十四","author":"杨万里","text":"若道寻春被雨催，如何随处两三杯。\n晚晴晓雨如翻手，有底亏侬不好来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其十三","author":"杨万里","text":"户户游春不放春，只愁春去不愁贫。\n今朝道是游人少，处处园亭处处人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其八","author":"杨万里","text":"清远溪中小闸头，遮栏溪水不教流。\n山僧为我放一板，溅雪奔雷怒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其四","author":"杨万里","text":"破雨游山也莫嫌，却缘山色雨中添。\n人家屋里生松树，穿出茅檐却覆檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其一","author":"杨万里","text":"游山不合作前期，便被山灵圣得知。\n只等五更倾一雨，三更犹是月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其五","author":"杨万里","text":"小溪曲曲乱山中，嫩水溅溅一线通。\n两岸桃花总无力，斜红相倚卧春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其二","author":"杨万里","text":"笋舆冲雨复冲泥，一径深深只觉迟。\n孤塔忽从云外出，寺门渐近报侬知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其十二","author":"杨万里","text":"雨里匆匆怨出郊，晴时不出却谁教。\n西湖北畔名园里，无数桃花只见梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其十一","author":"杨万里","text":"禅房寂寂水潺潺，涧草岩花点缀间。\n忽有仙禽发奇响，频伽来自补陀山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其十六","author":"杨万里","text":"轿顶花枝尽闹装，游人未暮已心忙。\n无端更被千株柳，展取苏堤分外长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中同舍约游天竺得十六绝句呈陆务观 其六","author":"杨万里","text":"老桧如幢翠接连，山茶作塔绿萦缠。\n山僧相识浑相忘，不到山中十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其七","author":"杨万里","text":"一春今岁两中和，信道韶华定较多。\n二月半头花已尽，脱空日月退还他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其六","author":"杨万里","text":"捣蓝作雨两宵倾，生怕难乾急放晴。\n一路东皇新晒染，桑黄麦绿小枫青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其五","author":"杨万里","text":"单车一节又行春，敢为观风惜病身。\n只是担头无櫑子，枉教唤作踏青人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其四","author":"杨万里","text":"出了长干过了桥，纸钱风里树萧骚。\n若无六代英雄骨，牛首诸山肯尔高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其三","author":"杨万里","text":"绵山恨骨已寒灰，尽禁厨烟肯更回。\n老病不禁馊食冷，杏花饧粥汤将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其二","author":"杨万里","text":"头上高垂碧玉盆，谁将漂絮尚残痕。\n青天幸自秋江样，须惹三丝两缕云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前一日行部过牛首山七首 其一","author":"杨万里","text":"岭花袍紫不知名，涧草茸青取次生。\n便是常州草虫本，只无蚱蜢与蜻蜓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其三","author":"杨万里","text":"柳条老去尚青鲜，下有清渠绕野田。\n波面落花相趁走，避风争泊岸傍边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]