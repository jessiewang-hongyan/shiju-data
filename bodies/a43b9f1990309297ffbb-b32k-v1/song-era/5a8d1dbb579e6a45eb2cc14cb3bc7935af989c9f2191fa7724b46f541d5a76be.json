[{"title":"夜坐门外示子遹","author":"陆游","text":"秋意遽如许，体中殊未佳。\n滩深无宿鹭，草茂有鸣蛙。\n栖遁从吾好，吟哦与汝偕。\n云门渐可到，剩判几青鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐中庭","author":"陆游","text":"萧散坐中庭，三更月未生。\n溯风凉醉颊，汲井濯尘缨。\n草露沾衣冷，天河隔树明。\n裴回不能睡，鼓角下高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐示子聿","author":"陆游","text":"久客诚当去，无心偶小留。\n扫空闲梦想，阅尽旧朋俦。\n学术非时好，文章幸自由。\n不嫌秋夜永，问事有长头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐示子虡","author":"陆游","text":"裘薄知霜重，灯残觉夜阑。\n为农宜废学，谢事等无官。\n疏懒贫难醒，沉绵死有端。\n大儿千里至，聊复为加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐示子遹兼示元敏","author":"陆游","text":"微霰不成雪，大风俄散云。\n孤灯翳还吐，断雁远犹闻。\n冉冉新春动，遥遥清夜分。\n儿孙未须睡，吾与汝论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐园中至夜分","author":"陆游","text":"岸巾闲倚胡床坐，步屧还扶拄杖行。\n渐近秋清知病减，尽捐世累觉心平。\n翻翻双鹊风枝爽，熠熠孤萤露草明。\n更欲裴回尽幽兴，丽谯传漏报三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐求酒已尽喟然有赋","author":"陆游","text":"澹月微霜夜漏徂，披裘不睡附寒炉。\n清笳袅袅已三弄，残火荧荧才一铢。\n报国无期心欲折，读书自力眼将枯。\n曲生作态年来甚，不受闲人折简呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐庭中","author":"陆游","text":"人静风褰幔，更阑露泫衣。\n暗窗饥鼠啮，空庑冷萤飞。\n岁月背人去，乡闾何日归。\n脱巾还感叹，残发不胜稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐庭中","author":"陆游","text":"大泽秋初到，荒庭夜自明。\n风云生有候，河汉落无声。\n病得新凉减，诗因少睡成。\n高枝有乌鹊，栖稳若为惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐庭中达旦","author":"陆游","text":"老矣常嗟去日遒，病来更觉此生浮。\n庭花无影月当午，檐树有声风报秋。\n足倦独行惊踸踔，发稀久坐怯飕飗。\n鸡号日出闲无事，又向清溪弄钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐闻大风","author":"陆游","text":"天旷穹庐覆，风豪野战酣。\n诗成飞醉墨，棋罢纵高谈。\n奇怪空堪笑，低摧亦未甘。\n东浮云海去，会载酒千甔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐偶书","author":"陆游","text":"衰发萧疏雪满簪，莫年光景易骎骎。\n已甘身作沟中断，不愿人知爨下音。\n病鹤摧颓分薄俸，悲蛩断续和微吟。\n向来误有功名念，欲挽天河洗此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜步","author":"陆游","text":"市人莫笑雪蒙头，北陌南阡信脚游。\n风递钟声云外寺，水摇灯影酒家楼。\n鹤归辽海逾千岁，枫落吴江又一秋。\n却掩船扉耿无寐，半窗落月照清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜步庭下有感","author":"陆游","text":"夜绕中庭百匝行，秋风传漏忽三更。\n星辰北拱疏还密，河汉西流纵复横。\n惊鹊绕枝栖不稳，冷萤穿竹远犹明。\n书生老抱平戎志，有泪如江未敢倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泛蜻蜓浦","author":"陆游","text":"四顾水无际，三更月未生。\n偶成摇楫去，不减御风行。\n烟浦渔歌断，芦洲鬼火明。\n还家人已睡，小立叩柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜还驿舍","author":"陆游","text":"楼上鼕鼕初发更，断云收雨旋成晴。\n市桥新涨摇灯影，驿路残泥壮屐声。\n阛阓变迁非曩日，情怀牢落感馀生。\n高秋病起犹能醉，剩买官醅乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮示坐中","author":"陆游","text":"胡雁叫群寒夜长，峥嵘北斗天中央。\n达人大观眇万物，烈士壮心怀四方。\n纵酒长鲸渴吞海，草书瘦蔓饱经霜。\n付君诗卷好收拾，后五百年无此狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮即事","author":"陆游","text":"天涯久客我何堪，聊喜灯前得纵谈。\n磊落金盘荐糖蟹，纤柔玉指破霜柑。\n烛围宝马人将起，花坠纱巾酒正酣。\n更作茶瓯清绝梦，小窗横幅画江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜抵葭萌惠照寺寓榻小阁","author":"陆游","text":"亭驿驱驰髀肉消，故山归梦愈迢迢。\n夜行触尉那能避，旦过随僧不待招。\n雨后风云犹惨澹，霜前草木已萧条。\n衰迟事事非平日，醉里题诗亦复聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊","author":"陆游","text":"小聚近江干，中春尚尔寒。\n钓船随鹭宿，烟月伴钟残。\n冉冉岁时速，茫茫天地宽。\n推篷一搔首，无处著悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊水村","author":"陆游","text":"腰间羽箭久凋零，太息燕然未勒铭。\n老子犹堪绝大漠，诸君何至泣新亭。\n一身报国有万死，双鬓向人无再青。\n记取江湖泊船处，卧闻新雁落寒汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜话赠华师","author":"陆游","text":"少喜洛阳侠，今成衡岳僧。\n深培地炉火，明照佛龛灯。\n衰鬓晨霜白，禅心古涧澄。\n犹能遍参在，为我买行縢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"陆游","text":"夜雨有残滴，秋砧无绝声。\n得诗旋已忘，觅睡固难成。\n壮志悲垂老，归耕愿太平。\n发春才属尔，岁事又峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"陆游","text":"齿牙摇动鬓毛疏，四壁萧然卧草庐。\n急雨声酣战丛竹，孤灯焰短伴残书。\n壮心未减从戎日，苦学犹如觅举初。\n自笑坚顽谁得似，同侪太半已丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨三首 其一","author":"陆游","text":"泽国寒多雨，畸人夜少眠。\n不缘酲作病，只合醉终年。\n庭草已争茁，园梅空自怜。\n重云不难抉，无剑倚青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨三首 其二","author":"陆游","text":"寒雨连三夕，幽居只数椽。\n家贫轻过节，身老怯增年。\n日月悲歌里，关山泪眼边。\n梅花自开落，叹息为谁妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"陆游","text":"正看飞雪暗江天，不觉新春已粲然。\n花气袭人娱独夜，雨声绕舍送丰年。\n樵风未改山川旧，禊事空悲岁月迁。\n一榼可营身尚健，故应先治下湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨三首 其三","author":"陆游","text":"人日春犹浅，鸡晨夜向阑。\n残缸灯晕小，单枕雨声寒。\n难补皇天漏，空思后土乾。\n山家尊酒薄，怀抱若为宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"陆游","text":"点滴茅檐雨，长宵不肯晴。\n残缸待鸡唱，倦枕厌枭鸣。\n已践衰残境，况兼羁旅情。\n晨兴亦何事，椎髻绕廊行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"陆游","text":"初夏雨淋浪，檐声绕四廊。\n感深头易白，睡少漏偏长。\n红捲帘旌湿，润生衣焙香。\n清吟欲排闷，三叹不成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨有感","author":"陆游","text":"断虹不隔江郊雨，一盏昏灯夜半时。\n多感生悲那为酒，积衰成瘦错冤诗。\n空阶点滴何由止，倦枕凄凉只自知。\n平日故人零落尽，寄书谁与叙睽离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨有感","author":"陆游","text":"北风吹雨暗江郊，十月僧庐旋补茆。\n病马敢希三品料，惊禽聊借一枝巢。\n少时诸老争求识，晚岁殊方罕定交。\n闭户不妨新得趣，丹经盈箧手亲抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨感怀","author":"陆游","text":"老来每惜岁峥嵘，几为巴歌判宿酲。\n白帝草生时入梦，锦官花重更关情。\n帘疏夜雨侵灯晕，枕冷秋风递角声。\n定许何时理归棹，酒狂犹解赋芜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜思","author":"陆游","text":"苍颜华鬓久低摧，叹息何堪岁月催。\n残暑已随团扇去，新凉还傍短檠来。\n月痕澹澹侵苔砌，云叶萧萧覆水台。\n簿领沈迷无日了，试凭诗思洗氛埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜思","author":"陆游","text":"风扫浮云作快晴，窗声终夜杂帘声。\n月明满院鹊惊起，霜冷压栖鸡懒鸣。\n名字虚称旧朝士，门庭元是老书生。\n尚馀一事犹堪喜，北陌东阡醉太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜思","author":"陆游","text":"露泣啼螀草，潮生宿雁汀。\n经年寄孤舫，终夜托丘亭。\n楚泽无穷白，巴山何处青。\n四方男子事，不敢恨飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻大风感怀赋吴体","author":"陆游","text":"故都宫阙污膻腥，原野久稽陈大刑。\n未须校尉戍西域，先要将军空朔庭。\n意言挥戈可退日，身乃读书方聚萤。\n病起窗前发如雪，夜闻风声孤涕零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻雨声","author":"陆游","text":"我似骑驴孟浩然，帽边随意领山川。\n忽闻风雨掠窗外，便觉江湖在眼前。\n路过邮亭知几处，身如估客不论年。\n未妨剩拥寒衾卧，赢取孤吟入断编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻雨声","author":"陆游","text":"高檐夜雨泻淋浪，起拥寒衾旋炷香。\n春事岂堪频破坏，客愁不可复禁当。\n长瓶磊落输郫酿，轻骑联翩报海棠。\n著意物华君莫笑，世间得丧更茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻秋风感怀","author":"陆游","text":"西风一夜号庭树，起揽戎衣泪溅襟。\n残角声催关月堕，断鸿影隔塞云深。\n数篇零落从军作，一寸凄凉报国心。\n莫倚壮图思富贵，英豪何限死山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宴","author":"陆游","text":"酒浪摇春不受寒，烛花垂烬忽堆盘。\n山川路邈人将老，丝管声遒夜向阑。\n四海交朋更聚散，百年光景杂悲欢。\n自怜病眼犹明在，更把名花半醉看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宴赏海棠醉书","author":"陆游","text":"便便痴腹本来宽，不是天涯强作欢。\n燕子来时新社雨，海棠开后却春寒。\n醉誇落纸诗千首，歌费缠头锦百端。\n深院不闻传夜漏，忽惊蜡泪已堆盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜读了翁遗文有感","author":"陆游","text":"秋雨萧萧夜不眠，挑灯开卷意凄然。\n吾曹自欲期千载，世论何曾待百年。\n当日公卿笑迂阔，即今河洛污腥膻。\n阴阳消长从来事，玩易深知屡绝编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜读巩仲至闽中诗有怀其人","author":"陆游","text":"诗思寻常有，偏于客路新。\n能追无尽景，始见不凡人。\n细读公奇作，都忘我病身。\n兰亭尽名士，逸少独清真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜读隐书有感","author":"陆游","text":"平生志慕白云乡，俯仰人间每自伤。\n倦鹤摧颓宁望料，寒龟蹙缩且支床。\n力探鸿宝寻奇诀，剩采青精试秘方。\n常鄙臞仙老山泽，要令仰首看飞翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜起思子虡","author":"陆游","text":"我久依耕垄，儿方吊战场。\n卧闻风浩荡，起视月苍茫。\n老境绨袍暖，贫家菜粥香。\n惟愁杀风景，无酒作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜酌","author":"陆游","text":"酒渌孤灯夜，梅黄细雨天。\n聊成顾影醉，复作曲肱眠。\n腰下苏秦印，囊中赵壹钱。\n丈夫随所遇，底处不陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜酌","author":"陆游","text":"我有一瓢酒，与君今夕同。\n鸣檐社公雨，捲野沛歌风。\n阅世花开落，观身劫坏空。\n北邙丘垄尽，太息几英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜阅箧中书偶得李德远数帖因思昔相从时所言后多可验感叹有作","author":"陆游","text":"早岁传闻月旦评，殿门邂逅眼偏明。\n当时一坐推谈止，今日丛林见话行。\n老卧烟村身偶在，夜开蠹纸泪如倾。\n岂知三十馀年后，河洛胡尘讫未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿鹄鸣山","author":"陆游","text":"西游万里已关天，采药名山亦宿缘。\n老柏干霄如许寿，幽花泣露为谁妍。\n苔黏石磴扪萝上，灯耿云房扫榻眠。\n安得仙翁索米术，一生留此弄寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜梦从数客雨中载酒出游山川城阙极雄丽云长安也因与客马上分韵作诗得游字","author":"陆游","text":"有酒不谋州，能诗自胜侯。\n但须绳系日，安用地埋忧。\n射雉侵星出，看花秉烛游。\n残春杜陵雨，不恨湿貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜梦遇老人于松石间若旧尝从其游者再拜叙间阔老人亦酬接甚至云","author":"陆游","text":"辽海曾从化鹤丁，百年尘土污巾瓶。\n万山深处遇行李，再拜起时如醉醒。\n绿树岩前开药笈，白驴背上指丹经。\n云霄平步寻常事，不用求方更解形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜寒与客烧乾柴取暖戏作","author":"陆游","text":"槁竹乾薪隔岁求，正虞雪夜客相投。\n如倾潋潋蒲萄酒，似拥重重貂鼠裘。\n一睡策勋殊可喜，千金论价恐难酬。\n他时铁马榆关外，忆此犹当笑不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜寒起坐待旦","author":"陆游","text":"惝恍不成寐，揽衣寒夜中。\n青荧煨芋火，鞺鞳鼓帘风。\n巷犬声如豹，山童首似蓬。\n悠然束书坐，徐待日生东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜登千峰榭","author":"陆游","text":"夷甫诸人骨作尘，至今黄屋尚东巡。\n度兵大岘非无策，收泣新亭要有人。\n薄酿不浇胸垒块，壮图空负胆轮囷。\n危楼插斗山衔月，徙倚长歌一怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜登小南门城上","author":"陆游","text":"曳杖上江城，清宵破二更。\n月回高树影，风壮急滩声。\n野艇鱼罾举，优场炬火明。\n湖塘正如此，回首忆柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜登山亭","author":"陆游","text":"飞观峥嵘天宇宽，幽人半醉凭阑干。\n三山渺渺鸾鹤远，七泽茫茫蓑笠寒。\n清吹拂林横玉笛，紫云覆鼎熟金丹。\n童颜绿鬓无人识，回首尘寰一梦残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜登白帝城楼怀少陵先生","author":"陆游","text":"拾遗白发有谁怜，零落歌诗遍两川。\n人立飞楼今已矣，浪翻孤月尚依然。\n升沉自古无穷事，愚智同归有限年。\n此意凄凉谁共语，夜阑鸥鹭起沙边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜窗","author":"陆游","text":"性中汝本具光明，蔽障除时道自成。\n手刈茆苫数椽屋，身锄菜煮一杯羹。\n天人迭胜谁能测，祸福无常不待评。\n惟有吾心终可恃，夜窗袖手听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜赋","author":"陆游","text":"老人不食觉魂清，恍若身游白玉京。\n夜静月惊林鹊起，水凉风飐露荷倾。\n昏灯一点窥孤梦，画角三终转五更。\n欲醉海山还懒去，且携羽扇憩青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜赋","author":"陆游","text":"八十衰翁久挂冠，今年无酒敌春寒。\n乱云入户雨方急，断雁叫群灯未残。\n蠹简幸存随意读，蜗庐虽小著身宽。\n支离自笑心犹壮，忧国忧家虑万端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜赋","author":"陆游","text":"檐滴新春雨，窗昏半夜灯。\n病无诗一字，穷赖酒三升。\n世路涩如棘，祠官冷欲冰。\n残年只此是，年少解飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜赋","author":"陆游","text":"小斋寂寂似禅寮，卧数更筹觉夜遥。\n帐外残灯欺不寐，梁间栖燕伴无聊。\n江湖蹭蹬朱颜改，忧患侵凌壮志消。\n挂旆天山少年事，此身终负圣明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜赋","author":"陆游","text":"月晕知将雨，风声报近秋。\n暗廊行熠耀，深树啸鸺鹠。\n老幸传家事，狂犹为国忧。\n相齐虽已矣，且复饭吾牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜赋","author":"陆游","text":"夜窗搔首发鬅鬙，病不胜衣倚瘦藤。\n堪笑颜回忍饥面，常依韩愈看书灯。\n残生已与灰俱冷，旧友谁如几可凭。\n月落风生忽增气，掠檐劲翮有归鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜意","author":"陆游","text":"浮云扫尽天如水，十里疏钟到野堂。\n窗纸月明人不睡，屋茅霜冷夜初长。\n归休固已师沮溺，承学犹能陋汉唐。\n安得子孙常念此，不妨世世业耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜意三首 其一","author":"陆游","text":"名姓人谁记，形骸老渐侵。\n酒悭停剧饮，诗退负高吟。\n雨隔疏更断，云藏古院深。\n衰迟常兀兀，惆怅少年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]