[{"title":"春日次韵张叔元","author":"王之道","text":"迟日轻风过雨天，草青南陌欲生烟。\n江湖节物登王鲔，村落归心起杜鹃。\n已办寻芳游野寺，何当修禊泛溪船。\n路逢少妇携笼去，为说蚕儿向雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日郊行和郭希鲁二首 其二","author":"王之道","text":"坐对烟江叠嶂图，何如门外翠屏纡。\n寻芳敢擅携筇去，命友应从折简呼。\n酒里光阴閒活计，诗馀情思静功夫。\n浪吟痛饮真难遇，休问西山日欲晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日郊行和郭希鲁二首 其一","author":"王之道","text":"萦风杨柳绿丝长，过雨桑麻沃以光。\n联骑不妨多载酒，看花无用更烧香。\n望穷岩电搜诗眼，愁转车轮感别肠。\n胜集清游定何处，它年曲水记流觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶成","author":"王之道","text":"馀生今赴迩英朝，似说夔龙许续貂。\n枯蘖遂承新雨露，苍鹰应识旧云霄。\n废兴须信关时命，劳逸谁能问贯条。\n十载山林劳梦寐，五更天仗听箫韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日游西塔示本上人","author":"王之道","text":"暇日搜奇胜，羸骖适莽苍。\n幽花撩醉眼，早麦慰饥肠。\n佛屋几间在，村墟三里长。\n廉纤晚来雨，未觉客心伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春残次韵张叔元","author":"王之道","text":"乱红狼籍紫苔斑，帘捲东风雨脚残。\n蜀酒渐宜消昼永，单衣犹觉怯朝寒。\n玲珑有客双摇辔，矍铄何人一据鞍。\n芍药酴醾晴更好，劝君休作梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪","author":"王之道","text":"一夜春寒梦寐清，柳梢梅萼颇关情。\n山川千里玉为路，楼观半天云满城。\n径醉已从酾酒去，稍晴当办出郊行。\n东君底事偏芳草，刬尽依然上砌生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独步","author":"王之道","text":"饱馀惟欲睡，散睡步东园。\n雨足富莲子，年丰多稻孙。\n崎岖穷竹径，诘曲遍花源。\n何必冠童辈，偕来笑语喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀 其一","author":"王之道","text":"断虹收尽晚风凉，扑鼻谁家社酒香。\n门外山横青玉案，屋头榴绽紫罗囊。\n对吟已觉输新俊，遇酒还能发老狂。\n坐想西园梨枣熟，昔年犹记拉君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀 其二","author":"王之道","text":"一别成均十九秋，断肠千里致书邮。\n可怜率土民心固，端为当年圣泽流。\n此去会看还北狩，夜来先梦到东州。\n尊君正是吾侪事，可但南冠学楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀 其三","author":"王之道","text":"到齐何日醉青州，久矣平原困督邮。\n避地未容行信步，汎江聊得卧安流。\n望穷落鹜千山晚，梦断惊飙万壑秋。\n安得尚方三尺剑，扫除骄寇献俘囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事三首 其三","author":"王之道","text":"俛仰黄花集，澄清九月秋。\n预愁新任迫，难为故人留。\n风去山光合，江回水气浮。\n何当脱羁绊，同办五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事三首 其二","author":"王之道","text":"今日知何日，西风正得秋。\n天心方祚汉，人物合师留。\n才略烦威敌，声名赖镇浮。\n不妨临赋乐，汎汎有杨舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日即事三首 其一","author":"王之道","text":"晚来何所喜，急雨洗新秋。\n幸遂登高赋，应容遇胜留。\n藕花明远近，鸥鸟任沉浮。\n不用挥纨扇，何妨醉玉舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日郊行","author":"王之道","text":"断桥临野水，疏屋见人家。\n嫩绿几畦菜，深黄三径花。\n断云行自逐，征雁望还赊。\n好访韩湘去，山林养白鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日喜雨题周材老壁","author":"王之道","text":"大旱弥千里，群心迫望霓。\n檐声闻夜溜，山气见朝隮。\n处暑馀三日，高原满一犁。\n我来何所喜，焦槁免无泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日游南汰二首 其二","author":"王之道","text":"松篁团野色，葭薍接江氛。\n芳菊开新雨，晴天扫片云。\n村醪过寺共，风袂转山分。\n邂逅梅夫子，清谈得致勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日游南汰二首 其一","author":"王之道","text":"小雨沾秋旱，清曦霁晓氛。\n山留归壑水，风送过江云。\n碧瓦觚棱出，黄茅兔径分。\n高僧似相喜，茗饮话殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其三","author":"王之道","text":"云影曚昽日洒晖，金湖西畔晚阴微。\n渔舟缭绕青山去，枫叶追随白鸟飞。\n摩诘家风非世有，渊明心性与时违。\n近来病瘠连诗瘦，翻爱西台字样肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其八","author":"王之道","text":"迢迢山势去委蛇，林木东头见荻陂。\n疏竹依岩秋迸笋，病桑经火雨生枝。\n草侵药种多难辨，土拨松苗欲自移。\n照眼谁家几枝橘，出篱丹实正离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其一","author":"王之道","text":"湖外干戈半绿林，湖边葭薍晚森森。\n风霾未放远山出，岚气又连凄日阴。\n世乱且同吟啸乐，时来终快扫除心。\n天寒况是开炉近，应有佳人赋藁砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其五","author":"王之道","text":"翠壁苍崖水外山，山头茅舍两三间。\n夜窗明月来临卷，昼户清风为启关。\n霞绮障秋惊老眼，酒红潮面发衰颜。\n集英一梦如今觉，犹忆当时晓趁班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其二","author":"王之道","text":"巉岩石壁半攲斜，茅栗丛中菊渐华。\n风里断鸿书带草，山头飞叶汉浮槎。\n柂楼索莫吟秋笛，戍火青荧咽暮笳。\n争似渔翁最萧散，晚来和月卧芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其七","author":"王之道","text":"勋业休烦付考功，此生终待老山中。\n宦情薄似贤人酒，诗思清于少女风。\n秋雨养肥桑耳白，溪流濯出柳须红。\n不堪世路频硗确，四十萧然秃鬓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其六","author":"王之道","text":"远水西来抱鹿头，山前草木带霜秋。\n黄花雅意撩诗兴，红叶端能寄别愁。\n日月奔驰双转毂，江湖漂荡一轻鸥。\n干戈未戢中兴沸，蹴被空怀祖豫州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴八首追和杜老 其四","author":"王之道","text":"辘轳世态一枰棋，销得秋来宋玉悲。\n舒啸可无元亮意，哦诗如见少陵时。\n江湖于我还萧散，田舍从他笑重迟。\n异域故人今在否，青灯牢落夜相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜对月","author":"王之道","text":"青廓经新雨，扶疏桂影秋。\n夜凉山色静，风细水光浮。\n坐久因忘寐，诗成得散愁。\n愿言乘此兴，同赋庾公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡张昌言喜雨呈同官","author":"王之道","text":"旱魃正须三尺雨，飞廉旋布四天云。\n诗成采笔挥琼玖，酒到酡颜散缬纹。\n莲沼滟翻宵溜急，槐庭清送午风薰。\n欣欣千里农夫庆，衰病空惭老使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡严车二雪诗 其二","author":"王之道","text":"雪满江城酒不赊，闭门那患出无车。\n未容踏冻寻梅萼，应喜临风见柳花。\n炭重乌银争晓市，蔬挑翠羽荷邻家。\n何人正下红莲幕，大嚼蒸羊手更叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡严车二雪诗 其一","author":"王之道","text":"公诗有意拂廉纤，令似欧阳韵更严。\n犬子亦应惭赋缟，痴儿端合愧誇盐。\n飞绵勃窣争平堑，冻笋槎牙欲堕檐。\n胡避只今何处是，玉屏森映一峰尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡送春和陈德夫","author":"王之道","text":"柳外风樯迅莫追，柳间迟日弄晴晖。\n青春已作堂堂去，乌辔何由缓缓飞。\n入户呢喃轻语燕，隔林咿轧静鸣机。\n谁言四月芳菲尽，萱草葵花觉昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和东坡倦夜一首","author":"王之道","text":"风阁开还闭，龛灯暗复明。\n竹间听露滴，庭际看云行。\n皎月千门静，微风一座清。\n只今廷诤者，谁复继元成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和老杜江上","author":"王之道","text":"独坐日将夕，凄凄风雨秋。\n寒灯照孤屋，攲榻拥疏裘。\n身世槐安国，功名蜃化楼。\n归欤老居士，踪迹继浮休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和李义山赋菊二首 其二","author":"王之道","text":"团团青盖小，拂拂御袍黄。\n翠叶凌霜秀，繁英浥露香。\n浮觞追北牖，饮水记南阳。\n采采东篱下，行歌对草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和李义山赋菊二首 其一","author":"王之道","text":"嫩萼犹封绿，繁英已醉黄。\n雨馀三径晚，秋到一枝香。\n滴滴盈朝露，晖晖映夕阳。\n何妨浮玉斝，共醉木兰堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送无为守郑深道移严州","author":"王之道","text":"世称儒雅擅青徐，今见君侯信不虚。\n报政未容更绣水，除书先已易桐庐。\n郡邻帝所旋趋召，地切家山勿恋居。\n千乘来迎催去急，邦人何计挽行车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘元发归鄱阳次其韵","author":"王之道","text":"杖藜千里访茅茨，来赴当年一笑期。\n白发我徒悲老大，青山君尚记艰危。\n夜听高论因忘寐，昼味新诗可疗饥。\n冬日迎长殊可爱，何妨去国少迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送安丰判官江叔夜用菊花韵","author":"王之道","text":"冬温行色好，江上菊花黄。\n乡味莼羹美，皇恩诰墨香。\n招延从北海，吟咏继东阳。\n别后如相忆，时应问草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江致远归建昌","author":"王之道","text":"翩然归兴不吾留，应为高堂念远游。\n数日语离良作恶，几时书到得无愁。\n白沙翠竹千山晚，朱实黄花万里秋。\n后夜西风茅店月，醉吟应不费冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许判官志仁","author":"王之道","text":"是行犹及豫章春，闻说逢迎有故人。\n倾盖为君殊快意，掺袪令我重伤神。\n向阳花木初开叶，得雨蛟龙已转身。\n江上新晴应更好，绿杨如幄草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈南仲守象州","author":"王之道","text":"熊轼朱轓照野明，知君今赴象山行。\n荣观共作叹嗟语，静念独伤离别情。\n畏景逼人才数日，脩涂计此始三程。\n至时应在中元后，好寄双鱼慰友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送彦逢弟赴西兴盐场","author":"王之道","text":"闻道西兴去，全家共小舟。\n别离江北岸，怀抱海东头。\n闪闪风帆远，滔滔雪浪浮。\n苕溪在何许，应为故人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐次公罢历阳任归三衢","author":"王之道","text":"闻说家书赋鹡鸰，归欤难弟见难兄。\n接联本作二年调，解印俄成千里行。\n故国一犁春雨足，长江三板暮潮平。\n烂柯况是神仙宅，招隐诗成好寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐季公运干罢任","author":"王之道","text":"羁栖无柰老而穷，又见徐卿马首东。\n快意一时荷叶雨，增明千里稻花风。\n高材合在云霄上，胜处能忘涧壑中。\n法护相从如问我，为言踪迹与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠昙远归无为持钵","author":"王之道","text":"一筇春色满郊畿，弹指淮南迅若飞。\n丈室正须香积供，孤云聊作故山归。\n长安城里风烟好，锦绣溪头笋蕨肥。\n我有上林桃李约，未容随子赴亲闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠善慧东游","author":"王之道","text":"西去方祈谷，东来适佩萸。\n凄风梧脱叶，积雨稻生蚨。\n诗骨寒岩木，禅心古庙炉。\n莫将明月句，容易谒姑苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送浮屠道郭云游","author":"王之道","text":"何必袁州去，尘尘小释迦。\n一筇非外物，四海即吾家。\n晓色霜还重，秋容菊正华。\n此行良不恶，冬笋已排牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送秦德久守安丰","author":"王之道","text":"历水分携十六年，相逢须鬓尽苍然。\n喜君宦况新来好，许我交情老更坚。\n小雨送行春溜急，长杨留别午阴圆。\n画船插帜澄江远，回首风帆指绣川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱逊叔出守袭庆赐出身除职","author":"王之道","text":"赐对金銮下九天，旋闻熊轼为驱前。\n人从芸阁初分直，桂折蟾宫乍得仙。\n刺史江山聊复尔，翰林风月自依然。\n下车快草东封疏，今去祥符正百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送淮西转运判官李彦恢还朝","author":"王之道","text":"江头旗影弄青红，似说朝天四牡东。\n抱病不容攀辔勒，送行那复遣儿童。\n田均税敛千年利，福及疮痍九郡同。\n此去定知还禁近，从来阴德报宜丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送董令升舍人归朋溪二首 其二","author":"王之道","text":"仙舟东去访金华，歌彻骊驹向水涯。\n试问玉堂司凤诏，何如蓬岛驾云车。\n雨馀翠筱初翻箨，风暖丹葵欲放花。\n天气清和行色好，江南江北半桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送董令升舍人归朋溪二首 其一","author":"王之道","text":"西掖归来鬓未华，著书论字当生涯。\n撑肠何止五千卷，溢箧定踰三十车。\n秋露青黄新种橘，春风红紫旧栽花。\n东还贪逐朋溪乐，只恐金銮诏草麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送端溪尉张达城挈家南归","author":"王之道","text":"年时萧寺雪初晴，闻道君来眼倍明。\n送别又看秋欲去，论交还感盖初倾。\n帆张须水秋潮涨，路入铅山晚翠横。\n快向端溪从吏隐，归来稳步上蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溯流入栅江","author":"王之道","text":"久客心肠怯溯洄，不堪官事紧相催。\n踏霜人去繵风吼，冲浪舟行岸冻开。\n雪尽野梅红剪腊，春回溪水绿生苔。\n穷愁好逐残年尽，三日元正与泰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭韩积中二首 其二","author":"王之道","text":"多能倾相府，高义著房州。\n脱略通侯贵，追随逐客游。\n敢论当世比，曾向古人求。\n怊怅今楼护，黄泉已再秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭韩积中二首 其一","author":"王之道","text":"命矣穷张籍，归哉病长卿。\n焦湖家自远，畏日我同行。\n想像分携处，依稀謦欬声。\n仙踪向西路，回首泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日归自宝林二首 其二","author":"王之道","text":"远岫升初日，长林霭曙烟。\n峰回遥见塔，溪转静鸣泉。\n竹箨新披锦，茅花欲擘绵。\n清和多美荫，归路得蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日归自宝林二首 其一","author":"王之道","text":"十里招提路，崎岖祝圣归。\n青黄原上麦，红白草间薇。\n正看云容合，俄惊雨脚飞。\n馀花被沾湿，芳气袭人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏月自六安舟行还安丰","author":"王之道","text":"滟滟溪流涨渌波，乍晴天气自清和。\n露梢抽翠交新竹，风叶翻红飐嫩荷。\n水外远山晨雾重，道傍佳树午阴多。\n头旋更苦舟摇兀，说与篙师住得么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯旱","author":"王之道","text":"食贫那识小槽红，回也箪瓢久屡空。\n翘候载芟歌济济，忍看云汉叹爞爞。\n困穷转觉蓬心隘，憔悴犹怜菜颊丰。\n坐对骄阳思霈泽，日占鸣鹳望穹窿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朗上人见访复谒不遇留刺而还有诗见谢依韵和答","author":"王禹称","text":"汤休访我我重寻，独叩松关绝好音。\n满袖尘埃回俗步，一炉香火隔禅林。\n偶留刺字情非浅，忽枉诗章思更深。\n犹喜谪官无吏役，往来从此伴闲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烧火用陈西麓韵","author":"王之道","text":"烧火驱寒去，衔杯待暖回。\n家书万金值，怀抱一时开。\n腊雪犹栖树，风光已着梅。\n相过随处好，未怪损梅苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"能赋台","author":"王之道","text":"万顷玻瓈水浸空，台前佳色咏难穷。\n倚栏人在烟霞外，落笔诗成笑语中。\n属句畏惭非孟子，供欢端合有车公。\n解将能否分优劣，过眼昭然向与雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读韦苏州诗因用陪王郎中寻孔徵君韵","author":"王之道","text":"我才伤朴樕，吾道属艰难。\n未遂三豪遇，那知一笑欢。\n湖山晨溢翠，风雨夜沾寒。\n归棹秋无几，游吴意未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥堂二首 其二","author":"王之道","text":"娜婀风前竹，空濛雨外山。\n孤云心共远，短艇兴俱还。\n酒有双莲胜，诗无一字閒。\n因君成怅想，时到梦魂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]