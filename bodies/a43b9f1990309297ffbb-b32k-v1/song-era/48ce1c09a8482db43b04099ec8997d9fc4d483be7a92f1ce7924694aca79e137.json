[{"title":"重沓岭","author":"张爚","text":"松间叠石步高低，啼鸟幽林听隔溪。\n七尺枯藤可扶老，青鞋香汗落花泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上赵主簿霁宇","author":"张爚","text":"辞棘鸾飞远，重来棹雪舟。\n政声清似水，官况冷于秋。\n谱系王侯贵，文章班马流。\n赈民问钱谷，名已在金瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"请赵季宪主玉虚道院","author":"张爚","text":"来自东山东复东，飞空一剑伴丝桐。\n能令矮屋疏篱下，如在十洲三岛中。\n鍊句入神敲夜月，谈玄动客笑春风。\n闻师曾得长生诀，同采丹砂访葛翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺","author":"张□□","text":"英声初发。\n记舍选齐驱，祖鞭先著。\n风月平分，尊罍谈旧，各已苍颜白发。\n屈指待拚一醉，祝生申嵩岳。\n怎知道，为清湘□润，暂移贤杰。\n休说。\n予心渴，里巷争先，拟持杯阶闼。\n毕竟人间，赏心乐事，种种尽归缘法。\n拈取瑞香一瓣，爇向湘山名刹。\n无量寿，和一身见在，两尊菩萨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读刘阮传","author":"张简","text":"俗缘未断念家乡，回首仙源竟渺茫。\n野鸟自啼春自好，桃花应是怨刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禅窝","author":"张简","text":"草窝双树下，借与定僧居。\n会得虚空境，坐卧总从渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天津桥月夜","author":"张简","text":"行阙独崔嵬，垂杨夹道栽。\n河通桃叶渡，门对雨花台。\n世事棋千变，人生梦一回。\n谁知今夜月，曾照六朝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄浙西仓曹东圳","author":"张简","text":"骨凡缘欠大还丹，饱食人间行路难。\n灯火半生诗鬓老，江湖九月客衣单。\n拈将红叶书愁思，摘得黄花当晚餐。\n莫向吴松江上宿，梦魂偏怯雁声寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠徐月道士","author":"张简","text":"病骨癯然鹤一般，相陪夜坐万松间。\n乾坤清气皆归月，湖海高人半在山。\n吟苦心从天汉转，琴清身与岭云闲。\n杯茶预约中秋节，五老峰头说大还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"扶杖夫","text":"一生甘作扶犁手，万变宁移抱瓮心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北归渡海","author":"折彦质","text":"去日惊涛远拍天，飞廉几覆逐臣船。\n归舟陡顿能安稳，便觉君恩更焕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"全州尹氏观","author":"折彦质","text":"当门悬泉一线白，绕屋稻田千亩青。\n未论茯苓能解垢，且教月色满空庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡海","author":"折彦质","text":"朝宗于海固愿也，一苇杭之如勇何。\n著浅惊呼过又喜，此生是等事尝多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢许君瑶","author":"折彦质","text":"东坡遗物来归我，两手摩挲思不穷。\n举取吾家阿堵物，愧无青玉案酬公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋浯溪造极图","author":"折彦质","text":"浯溪未到已登临，笔力能穷造化心。\n我是零陵新逐客，披图一一可追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋湘西清绝图","author":"折彦质","text":"与山分浅正伤神，蜡屐明朝陌上尘。\n谁写湘西清绝景，巧移林壑慰行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濯缨亭","author":"折彦质","text":"澄练正萦槛，高屏近拥门。\n偏宜云惨澹，更好月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"法轮寺","author":"折彦质","text":"路转崎岖岭，水藏委曲田。\n茂林深似海，古刹湛如渊。\n岣嵝未可到，禹碑真谩传。\n西林归恐暮，欲去又茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胜业寺","author":"折彦质","text":"故宫馀禹迹，胜地属僧家。\n古庙松阴合，幽亭竹影斜。\n岭云吟外澹，山鸟定中哗。\n谴逐成轻别，空怀客路赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别王六公","author":"折彦质","text":"六公八十尚占星，授法东坡今大成。\n此岁得归言不食，几时当雨信如盟。\n误人功业忍更问，老我林泉如可营。\n他日疑谋谁为决，无由重到访君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别许廷惠","author":"折彦质","text":"架空作屋才容膝，中有道人能湛然。\n门外红尘虽扰扰，枕边清梦自翩翩。\n君如海燕时须到，我似江鸥日又迁。\n回首石桥桥上月，与谁同赏第三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘山留别","author":"折彦质","text":"寓久浑忘客，临行似别家。\n途穷身更怯，秋老鬓先华。\n生计黄茅合，归期碧海赊。\n湘山今夜雨，留我意无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"超然亭","author":"折彦质","text":"超然亭上鬓毛斑，浩荡秋风小立閒。\n岂为诗情堪过海，只缘脚力要寻山。\n峭峰断续天容缺，高垒萦纡地势悭。\n回首不堪东北望，桂林万里是秦关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观汪丞相所藏崔白画罗汉","author":"折彦质","text":"山堂漠漠开晓烟，何许大士当四筵。\n坐忘默识形骸外，持钵植杖风露前。\n老龙欲奋屡回首，于菟甚驯非畏鞭。\n小儿已解辨人我，抱头怖走成痴颠。\n岂知畏爱果何物，手里舍利空烛天。\n嗟余耳目更浅陋，喜欢获遇希有缘。\n神明泰定始一笑，摩挲粉墨心茫然。\n平生崔白画常见，邂逅入眼多弃捐。\n莫言人物斗奇崛，醉里落笔神助焉。\n汪公昔入魏帅幕，叹息钜壁围神仙。\n归寻十疋好东绢，恰有名手能摹传。\n提携万里到岭表，尤物自得高人怜。\n迩来劫火坏诸有，陪都正苦纷戈鋋。\n无力挽河为吹洗，披图感极泪如泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过太平州拜李端叔遗像","author":"折彦质","text":"东来已数月，弛担已渺茫。\n犹喜灾患身，获登先生堂。\n肃衣拜遗像，依然双颊光。\n宛若侍坐侧，妙语发天藏。\n厄穷出天意，人理难度量。\n所幸言不朽，与世为文章。\n赍此复何恨，私淑良不忘。\n小郎出见我，问知雏凤凰。\n他年起门户，尘滓濯秋阳。\n世事几变灭，人生真黄粱。\n置之不足道，感慨涕泪滂。\n我行方有程，坟山空相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寇莱公庙 其一","author":"折彦质","text":"莱公英特姿，谭笑安社稷。\n流离死穷荒，志士气益塞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雷州苏公楼","author":"折彦质","text":"二苏翰墨仙，谪坠百蛮里。\n弟兄对床眠，此意孤一世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"折彦质","text":"石桥步月公居后，橘井烹茶我在先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"折彦质","text":"炼丹垂老心犹健，怀橘当年事已非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"折彦质","text":"待公辅佐中兴了，乞取袈裟送暮身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其七","author":"时少章","text":"玛瑙遗基尚未斜，两京风物使人嗟。\n先皇月出曾游历，空见春风发落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其六","author":"时少章","text":"北引黄河入宿河，下栽鹿角起层波。\n城中待哺一万户，咫尺南船那得过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其五","author":"时少章","text":"高帝神灵未可诬，至今陵柏尚扶疏。\n小臣眼有一石泪，准拟北来都破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其四","author":"时少章","text":"莫为蒲骚举高趾，边情转眼又千回。\n吴房小败宁非计，防后飞军雪里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其三","author":"时少章","text":"特地今年荷主恩，储胥百万给诸屯。\n张彝自向河南死，怀朔惊翻贺六浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其二","author":"时少章","text":"共说曾公有府城，殿前数日净边尘。\n白麻宣受人争看，宝马高秋报主身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事七首 其一","author":"时少章","text":"诸将纷然各自雄，面前全隔马牛风。\n尚衣已办通天带，何日临门送晋公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题园门","author":"时少章","text":"林花落处忆初妍，半折妖红似隔年。\n今日绿阴还涨眼，却思花落又茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大节堂碑引","author":"时少章","text":"天降疢疾殄我民，鸱鹠奋怒豺虎狞。\n掩道赤鸦蔽阳精，夜罗鬼火塞要津。\n当涂大吏腰缠金，挠腘稽颡泪满膺。\n嗢咿软语若稚婴，欺卖宗祏倾皇灵。\n有勇三子心棱棱，扳弧援甲凭孤城。\n城颓兵折气益振，目光如炬铄成群。\n或从辟雍曳长绅，欲拄八极遮帝?。\n有伟三子辞轰轰，危立高骂声吐霆。\n颈血溅天天为昏，断尸峙立不仆倾。\n神扶鬼挟赫可惊，坐朝不与燕不宾。\n寸武不踏黄金屏，性忠内发孰使令。\n英气挺挺旷古今，朅来柯山访厥孙。\n彷佛毅状冲杳冥，筑堂泮宇夐深明。\n悲风苦雨凄棘林，魂兮来归肃泠泠。\n寥哉旷宇畴非臣，登兹堂兮企风神。\n须毛磔立心胆森，勿俾三子专修名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸣鸡行","author":"时少章","text":"三里寥落秋夜长，老鸡望星初引吭。\n一声二声天沆漭，客梦初回犹惚恍。\n三声四声天渐明，道上行人马蹄响。\n嗟尔行人人有心，心长面短谁能寻。\n薛君脱走窘思虑，刘牧起舞豪精神。\n勿言咿喔才满座，中有叹悲千万个。\n君知种种在此鸡，只合鸡声塞天破。\n吴中老翁百不忙，杀鸡酿酒酬年光。\n黄紬软暖蒲荐稳，日出三竿犹在床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游碧落洞","author":"时孝孙","text":"昔经龙洞看飞泉，疋练穿岩落半天。\n今日挈家来碧落，萧然秋色满晴川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿荚道驿","author":"时沄","text":"笋舆倦长途，夜投村邸宿。\n市井倚峦冈，人烟半樵牧。\n茅檐俯清流，翠巘出前屋。\n山月照人寒，有意怜幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"时定钦","text":"白云黄鹤自来去，绿水青山无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青门饮 寄宠人","author":"时彦","text":"胡马嘶风，汉旗翻雪，彤云又吐，一竿残照。\n古木连空，乱山无数，行尽暮沙衰草。\n星斗横幽馆，夜无眠、灯花空老。\n雾浓香鸭，冰凝泪烛，霜天难晓。\n长记晓妆才了，一杯未尽，离怀多少。\n醉里秋波，梦中朝雨，都是醒时烦恼。\n料有牵情处，忍思量、耳边曾道。\n甚时跃马归来，认得迎门轻笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从先生明哲道中呈伯广炳道","author":"时澜","text":"燕子杨花各自飞，雨乾溪路绿初肥。\n无人会得风雩意，可是千年瑟竟希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李一鳌","text":"玉盆应有意，要洗贪者廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉笥山","author":"李与","text":"葛峰相对为文笔，萧水回环当墨池。\n说与晚衙休报事，长官亭上有新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"李久善","text":"东君试手，向南枝著意，争先时节。\n纵有丹青谁便忍，轻点肌肤冰雪。\n色借琼瑰，香分兰麝，元自标孤洁。\n冲寒独秀，误他多少蜂蝶。\n缟练不染缁尘，算来□合是，广寒宫阙。\n未问阳和先占取，前村一溪风月。\n留取清芬，主张真态，驿使休轻折。\n梢头青子，异时风味甚别。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"李久善","text":"莺掷垂杨，一点黄金溜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近 寿张路钤四月初一","author":"李义山","text":"夏初临，春正满，花事在红药。\n一阵光风，香雾喷珠箔。\n画堂旧日张家，梦中玉燕，早拂晓、飞来帘幕。\n酒深酌。\n曾记走马长安，功名戏樊郭。\n螺浦如杯，豪气怎生著。\n直须用了圯编，封侯万户，却归共、赤松翁约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次凤州","author":"李之才","text":"去年三月洛城游，今日寻春到凤州。\n欲托双鱼附归信，嘉陵江水不东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉答勤师山中见寄","author":"李之才","text":"羡子幽栖地，空山十月天。\n清檐朝饭后，寒壁夜深禅。\n霜树留残果，冰崖断旧泉。\n刘雷好为社，邑客有谁贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又书扇","author":"李之仪","text":"几年无事在江湖，醉倒黄公旧酒垆。\n觉后不知新月上，满身花影倩人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合流遇潘子真出斯文相示因置酒","author":"李之仪","text":"山谷老子久不见，豫章诗人何许来。\n章江未觉清彻骨，西山一带寒烟开。\n文章明镜现诸相，句律蛰户惊春雷。\n红炉劝坐且一醉，为我更赋扬州梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵东坡还自岭南","author":"李廌","text":"凭陵岁月固难堪，食檗多来味却甘。\n时雨才闻遍中外，卧龙相继起东南。\n天边鹤驾瞻仙袂，云里诗笺带海岚。\n重见门生应不识，雪髯霜鬓两毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子","author":"李之仪","text":"我住长江头，君住长江尾。\n日日思君不见君，共饮长江水。\n此水几时休，此恨何时已。\n只愿君心似我心，定不负思量意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万年欢","author":"李之仪","text":"暖律才中，正莺喉竞巧，燕语新成。\n万绿阴浓，全无一点芳尘。\n门巷朝来报喜，庆佳期、此日光荣。\n开华宴、交酌琼酥，共祝鹤算椿龄。\n须知最难得处，双双凤翼，一对和鸣。\n造化无私，谁教特地多情。\n惟愿疏封大国，彩笺上、频易佳名。\n从此去、贤子才孙，岁岁长捧瑶觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 其一 咏畴昔胜会和人韵，后篇喜其归","author":"李之仪","text":"深帘静昼。\n绰约闺房秀。\n叩衣楚制飞文绣。\n凝脂肤理腻，削玉腰围瘦。\n闲舞袖。\n回身昵语凭肩久。\n眉压横波皱。\n歌断青青柳。\n钗遽擘，壶频叩。\n鬓凄清镜雪，泪涨芳樽酒。\n难再偶。\n沈沈梦峡云归后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 其二","author":"李之仪","text":"柔肠寸折。\n解袂留清血。\n蓝桥动是经年别。\n掩门春絮乱，敧枕秋蛩咽。\n檀篆灭。\n鸳衾半拥空床月。\n妆镜分来缺。\n尘污菱花洁。\n嘶骑远，鸣机歇。\n密封书锦字，巧绾香囊结。\n芳信绝。\n东风半落梅梢雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 其五 和人","author":"李之仪","text":"中秋才过，又是重阳到。\n露乍冷，寒将报。\n绿香催渚芰，黄密攒庭草。\n人未老，蓝桥谩促霜砧捣。\n照影兰缸晕，破户银蟾小。\n樽在眼，从谁倒。\n强铺同处被，愁卸欢时帽。\n须信道，狂心未歇情难老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 其六 用秦少游韵","author":"李之仪","text":"深秋庭院，残暑全消退。\n天幕迥，云容碎。\n地偏人罕到，风惨寒微带。\n初睡起，翩翩戏蝶飞成对。\n叹息谁能会。\n犹记逢倾盖。\n情暂遣，心常在。\n沈沈音信断，冉冉光阴改。\n红日晚，仙山路隔空云海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 其三 再和前意","author":"李之仪","text":"万红暄昼，占尽人间秀。\n怎生图画如何绣。\n宜推萧史伴，消得东阳瘦。\n垂窄袖，花前镇忆相携久。\n泪裛回纹皱，好在章台柳。\n洞户隔，凭谁叩。\n寄声虽有雁，会面难同酒。\n无计偶，萧萧暮雨黄昏后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁 其四","author":"李之仪","text":"休嗟磨折，看取罗巾血。\n殷勤且话经年别。\n庭花番怅望，檐雨同呜咽。\n明半灭，灯光夜夜多如月。\n无复伤离别，共保冰霜洁。\n不断梦，从今歇。\n收回书上絮，解尽眉头结。\n犹未绝，金徽泛处应能雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿 谢人寄蜡梅","author":"李之仪","text":"春风似有灯前约，先报佳期。\n点缀相宜。\n天气犹寒蝶未知。\n嫩黄染就蜂须巧，香压团枝。\n淡注仙衣。\n方士临门未起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天门谣 次韵贺方回登采石蛾眉亭","author":"李之仪","text":"天堑休论险。\n尽远目、与天俱占。\n山水敛。\n称霜晴披览。\n正风静云闲、平潋滟。\n想见高吟名不滥。\n频扣槛。\n杳杳落、沙鸥数点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 用太白韵","author":"李之仪","text":"清溪咽。\n霜风洗出山头月。\n山头月。\n迎得云归，还送云别。\n不知今是何时节。\n凌歊望断音尘绝。\n音尘绝。\n帆来帆去，天际双阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]