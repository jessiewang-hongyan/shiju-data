[{"title":"和三二兄西庄书怀 其四","author":"潘良贵","text":"一炷清香度博山，妙观不著有无间。\n此心欲报难论价，放我形骸十载閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三二兄西庄书怀 其一","author":"潘良贵","text":"莫问庄生然不然，时中只可自随缘。\n冬深江北无边报，又得安贫过一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲严弟暮春二绝 其二","author":"潘良贵","text":"沂上风光点独知，陶然宁复叹春移。\n吾人老大知何用，仰止前贤须及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲严弟暮春二绝 其一","author":"潘良贵","text":"吾生四十已侵寻，独喜年来不动心。\n世事升沉君会否，人间春去落花深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈秀才 其一","author":"潘良贵","text":"年来有客从黄石，老去何心望紫泥。\n世事违人常八九，生涯随力任东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈秀才 其二","author":"潘良贵","text":"软语干时刍豢美，苦言投俗桂姜辛。\n山河若欲摅幽愤，盥手焚香读过秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈秀才 其三","author":"潘良贵","text":"弱龄虑事心常破，壮岁投閒鬓已华。\n但得安贫如北阮，何妨受侮似东家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜与仲严叔倚季成三弟同坐闻笛各赋一绝","author":"潘良贵","text":"西北干戈拨不开，今宵闻笛更清哀。\n高堂亲老发垂白，与子买舟归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日四绝 其四","author":"潘良贵","text":"娟娟疏竹拂云长，门巷无尘气自凉。\n多病无情如嚼蜡，卧看风篆博山香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日四绝 其三","author":"潘良贵","text":"错落星河天未明，太虚涵露气全清。\n东方隐约生光耀，便觉林间宿鸟惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅三绝 其三","author":"潘良贵","text":"枝头疏蕊吐檀心，借日娇黄色浅深。\n却倩红梅来作伴，要看明玉间良金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅三绝 其二","author":"潘良贵","text":"旦评人物尚雌黄，草木何妨定短长。\n试问清芳谁第一，蜡梅花冠百花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅三绝 其一","author":"潘良贵","text":"孤芳移种自仙家，故着轻黄映日华。\n举世但知梅蕊白，不知还有蜡梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三江亭","author":"潘良贵","text":"假守衰颓病日侵，湖山虽好倦追寻。\n登城忽睹三江水，快我平生万里心。\n聊筑小亭怡父老，敢承佳句粲珠金。\n春涛正待诸君赏，更拂诗牌看醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆读沈约传怒其缓颊卖国发上冲冠然古今人每壮其东阳八篇文辞未有少之者因次卿登楼新什辄效立春体制和且摅所怀云","author":"潘良贵","text":"隐侯文治知何用，千古端羞堕泪碑。\n国危忍助神鼎覆，身免犹嗟鞶带移。\n登览寒烟萦远目，凄凉夕照谢高榱。\n伤心往事君须赋，恐有遒人来采诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱教授见寄七言二首遂用其韵 其二","author":"潘良贵","text":"等閒长啸倚孤松，云破天边见碧峰。\n架上残书犹可读，瓶中储粟不堪舂。\n生涯幸有千年秀，身世何须万户封。\n僧榻寄眠无一事，觉来深省听晨钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱教授见寄七言二首遂用其韵 其一","author":"潘良贵","text":"贤哉蘧瑗晚知非，此道吾今亦庶几。\n囊乏一钱聊自哂，家无三径不妨归。\n冥鸿久已离矰缴，野马由来免靮鞿。\n溪上月明船正稳，肯将簪笏换蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和季成弟中秋不见月","author":"潘良贵","text":"经年等待中秋月，一夕阴云扫不开。\n高树时惊疏雨过，空山那复故人来。\n梦回谁忆霓裳戏，老去愁闻水调哀。\n与子相逢长得醉，何须佳节始衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花 其二","author":"潘良贵","text":"气欲峥嵘岁欲新，寒梅方信冠群伦。\n直能平地凌封雪，可是回根迎小春。\n九畹蕙兰真上客，千山桃李尽庸人。\n即今携酒江郊去，弄蕊攀条一拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花 其一","author":"潘良贵","text":"天与孤高花独新，世间草木信非伦。\n影涵水月不受彩，气傲冰霜何待春。\n冷淡自能驱俗客，风骚端合付幽人。\n往来百匝阶除里，顿使心无一点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中偶成 其一","author":"潘良贵","text":"飞花看六出，俄向腊中来。\n解验人情喜，始知天意回。\n夜阑窗愈白，晚冻日难开。\n麦熟何时节，饥民正可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中偶成 其二","author":"潘良贵","text":"歉岁多流冗，邦侯喜邓来。\n雪除惊腊尽，耕近乐春回。\n郊野犹同色，江天已半开。\n短衣难掩胫，谁说少陵哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三二兄西庄书怀 其二","author":"潘良贵","text":"贤愚狂圣等为人，要是天君自策勋。\n举世纷纷谁得妙，韩公惟许孟轲醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三二兄西庄书怀 其三","author":"潘良贵","text":"古来达士尽穷空，我愧修身道未丰。\n痛饮不妨歌楚些，投閒何幸伴吾侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐闻竹声示侄","author":"潘良贵","text":"室明窗有灯，夜暗天无月。\n趺坐依蒲团，竹声助清绝。\n初疑小雨至，萧萧俄复歇。\n忽然变轩昂，风湍散岩穴。\n听久耳根静，万虑皆瑩彻。\n尘凡不待扫，境妙心自洁。\n奇哉不二门，欲倩维摩说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法清晚步分韵得夕字","author":"潘良贵","text":"有生能几何，避乱不谋夕。\n联翩二三子，晚步纵所适。\n田野无人声，牛羊断归迹。\n时看墟曲中，寒烟袅修碧。\n雍雍南飞雁，北信杳难觅。\n不知二圣君，泫然泪沾臆。\n小臣真虮虱，持颠顾何力。\n残腊行当除，青阳来已逼。\n衰骸分填壑，公辈宜强食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑亨仲作亭西山颜曰可友以书求诗为赋一首","author":"潘良贵","text":"君不见子猷嗜好与俗殊，种竹不可一日无。\n又不见太白清狂世绝伦，举杯邀月独相亲。\n风流二子去已远，尘埃那复闻高人。\n郑侯未遇身更閒，躬耕自乐岩谷间。\n开亭容膝日寄傲，坐对嶕峣崒嵂之西山。\n西山苍翠如堆玉，松奏笙竽云作屋。\n澄鲜爽气日夕佳，不学时情易翻覆。\n田文唾面嗔小儿，翟公署门良可嗤。\n悠悠权利悲一时，乐哉此友谁能知。\n郑侯与我论心久，年少相从今白首。\n对山勿著绝交书，要须著我成三友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日四绝 其一","author":"潘良贵","text":"四月天气初郁蒸，碧桐照空门巷清。\n何人解助隐居乐，为我唤取黄鹂鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日四绝 其二","author":"潘良贵","text":"扫地焚香避湿蒸，睡馀茶熟碾声清。\n风来桐竹僛僛舞，雨过阶除㶁㶁鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈德固守禦","author":"潘良贵","text":"强敌登城日，中华将士奔。\n人皆趋北阙，君独死南门。\n秘计无人用，英声有史存。\n秋原悲泪落，桂酒与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"潘良贵","text":"良木秀山泽，中林犹百年。\n斲削应约绳，必资诸巧匠。\n陶者输瓦甓，圬人施涂泥。\n丝网及宝铃，丹漆塈塑绩。\n罢精磨岁月，始克观厥成。\n金钱与糗粮，所费如山积。\n虽名有漏法，实为无量德。\n庶俾凡睹闻，因缘得入道。\n我昔礼大士，广厦馀千间。\n何人持烈烟，一燎不存芥。\n呜呼有施者，又有戕毁人。\n良繇弗思维，纵我无明故。\n今合檀施力，作新美踰初。\n丁此时艰危，为众作依怙。\n咨尔方来者，毋意隳前功。\n增饬爱护之，当如捍头目。\n使百千万亿，游戏依双林。\n于龙华会中，永瞻微妙相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新梧","author":"潘良贵","text":"残春始抽芽，首夏已敷绿。\n空枝变繁阴，造物信神速。\n童童覆短墙，密密连深竹。\n扶疏团爽气，秀整厌群木。\n鸣琴音下上，和雅奏琴筑。\n亭年影途清，吾亦爱吾屋。\n身閒百忧无，意适万事足。\n此乐何以酬，床头酒方熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 中秋","author":"潘良贵","text":"夹水松篁，一天风露，觉来身在扁舟。\n桂花当午，云卷素光流。\n起傍篷窗危坐，飘然竟、欲到瀛洲。\n人世乐，那知此夜，空际列琼楼。\n休休。\n闲最好，十年归梦，两眼乡愁。\n谩赢得、萧萧华发盈头。\n往事不须追谏，从今去、拂袖何求。\n一尊酒，持杯顾影，起舞自相酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日后一日立春","author":"潘牥","text":"人日才过春日至，薄醪生菜旅亭头。\n慈亲鬓发垂垂白，应看诸孙弄土牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月菊 其二","author":"潘牥","text":"先生嗜菊菊中仙，不把东篱博秫田。\n九日于中谁不爱，勤餐何可得延年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月菊 其五","author":"潘牥","text":"一段风流玉琢成，开从霜后越精神。\n休嫌茉莉非吾配，曾见张良似妇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月菊 其四","author":"潘牥","text":"不染东篱一样黄，枝头琐细白而香。\n劳将茉莉相题品，未必莲花似六郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月菊 其三","author":"潘牥","text":"夕阳西去一凭栏，眼底黄花自岁寒。\n姚魏终皆非正色，请君细把楚骚看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子规","author":"潘牥","text":"一声啼破万山云，我正思归自喜闻。\n莫向贵人庭树下，王孙金弹不饶君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代百舌答","author":"潘牥","text":"祸福无门未可凭，天教有口可无声。\n莫嫌口解为身累，雁不能鸣反自烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯","author":"潘牥","text":"一点无多小似萤，虚堂夜静灭还明。\n若教安顿无风处，犹可从容到五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百舌","author":"潘牥","text":"问渠得似山间日，犹自筠笼叫不停。\n我亦多言私自省，再三守口要如瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"医士","author":"潘牥","text":"闻君妙得医王诀，我病劳君指下求。\n天与一般愚直性，不知何剂可能瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗祀夕","author":"潘牥","text":"玉天无滓月光寒，霁色分明在露盘。\n一夜九重全不寐，时教中使捲帘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松","author":"潘牥","text":"柯伐移来得得长，想渠历晋复经唐。\n惯于岩畔谙风雨，可与人间作栋梁。\n二室七仙同守护，千杉万桧任低昂。\n向来诸葛祠前柏，此物□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑","author":"潘牥","text":"并州昔用千金贾，流落人间岁月多。\n背有龙文空自宝，世无麟血倩谁磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春花秋色","author":"潘牥","text":"似觉山桃野杏非，耻将浓绿眩群姿。\n向天乞入秋风队，兰菊中间入片时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶 其二","author":"潘牥","text":"瑞草如梅早占春，谁将龙凤付仙人。\n烹来盏内花犹白，浇出胸中不语尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶 其一","author":"潘牥","text":"透屋松风蟹眼汤，野人纱帽自煎尝。\n谏议不分三道印，赵州剩借一瓯香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭谢驾自景灵宫回丞相以下皆簪花","author":"潘牥","text":"辇路安排看驾回，千官花压帽檐垂。\n君王不辍忧勤念，玉貌还如未插时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读道书 其二","author":"潘牥","text":"道人清晓炷炉薰，岚重衣巾湿露痕。\n课罢楞严经一卷，小窗徙倚候啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读道书 其一","author":"潘牥","text":"道人扫洒一间房，纸帐梅花滋味长。\n清晓起来无个事，炉香端简面虚皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹娥庙","author":"潘牥","text":"一川红涨夕阳波，幼妇碑残锁绿萝。\n不止但争三十里，曹瞒元不识曹娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父 其二","author":"潘牥","text":"生来一舸镇随身，柳月芦风处处春。\n翁自醉眠鱼自乐，无心重理旧丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父 其一","author":"潘牥","text":"小舟真个白鸥轻，一一鸣榔作阵行。\n打得鲜鳞归去早，蓼花深处卖鱼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绯桃","author":"潘牥","text":"一枝才破便精神，直是猩猩血染成。\n休逐东风贪结子，玉环早已妒倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晴","author":"潘牥","text":"西风一夜与晴期，红日当天烧陆离。\n云似败棋无著处，山如宿酒顿醒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琴 其三","author":"潘牥","text":"道人清夜理瑶琴，爱学啼乌啭羽音。\n莫把世人工拙论，世人弹耳不弹心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琴 其二","author":"潘牥","text":"操高不救西山死，瓢饮空称陋巷贤。\n二调只堪弹我听，不消举此贵人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢林簿遗庐阜茶芽 其二","author":"潘牥","text":"向来皇祐最升平，民识犁锄不识兵。\n茶向此时还有录，令人长羡蔡端明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢林簿遗庐阜茶芽 其一","author":"潘牥","text":"谁采匡庐紫玉芽，二千里路到吾家。\n砖炉石铫自烹吃，清落诗脾作雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楼","author":"潘牥","text":"突兀楼居倚碧空，松江西畔太湖中。\n天垂十二阑干角，月满三千世界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷鸣不雨 其一","author":"潘牥","text":"海激天翻电雹真，苍枝十丈擘为薪。\n须臾龙卷他山去，误杀田头望雨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊 晒翅","author":"潘牥","text":"拣尽南枝与北枝，风吹霜竹叶还稀。\n旁人忧喜非吾事，且自梳翎向落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈图南鼾睡图","author":"潘牥","text":"甲马营中紫气高，属猪人已著黄袍。\n此回天下都无事，可是山中睡得牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月梅","author":"潘牥","text":"洒扫东篱具菊杯，仙翁折送几枝梅。\n绝怜绿萼才先去，能与黄花作伴开。\n造物定应无顷刻，未霜早自有春回。\n穷山似汝真何数，幸被诗人拈出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月晦日剪牡丹","author":"潘牥","text":"三月三十日，千花馀牡丹。\n莫辞连夜剪，犹得及春看。\n银烛浅深间，金瓶高下安。\n洛中全盛日，见说大如盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居苦","author":"潘牥","text":"门外车声寂不哗，数椽净扫小山家。\n懒锄茂叔窗前草，剩种渊明篱下花。\n不饮客来还贳酒，长闲饭罢必煎茶。\n紫岩堪隐吾偕子，雪后春深蕨已芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日登九山","author":"潘牥","text":"不到鳌峰久，重来感物华。\n松应添岁寿，梅尚隔年花。\n清磬闻朝斗，丹炉借瀹茶。\n满城人记节，此日正喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰花 其一","author":"潘牥","text":"长身大叶耸丛丛，生处虽殊臭味同。\n全带安期溪涧碧，微偷勾漏箭砂红。\n闻名久向骚经内，识面翻从要服中。\n等是海山闲草木，东皇一顾便春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰花 其二","author":"潘牥","text":"闻说吾家又一种，移来远自剑津湾。\n叶如壮士冲冠发，花带癯仙辟谷颜。\n行辈合推梅以上，交游多在菊之间。\n平生我亦好修者，乞取幽兰镇小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]