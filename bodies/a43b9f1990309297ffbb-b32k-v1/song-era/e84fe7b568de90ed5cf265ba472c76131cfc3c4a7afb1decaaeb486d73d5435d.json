[{"title":"纵笔二首 其二","author":"刘克庄","text":"发似秋霜身槁枝，相逢惊怪此翁谁。\n能啖范丈齑盐日，曾识荆公疥癣时。\n不待姓名尊德齿，要知戒腊□须眉。\n融修汉士中翘楚，商略总堪大小儿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"身在一首","author":"刘克庄","text":"身在樵村钓濑行，秋豪不与市朝争。\n目云嗜酒相绳急，谤到吟诗所犯轻。\n沉水一铢销永昼，蠹书数叶伴残更。\n闭门孤学无穷味，笑杀韩公接后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯春日","author":"刘克庄","text":"甫报弓旌召，俄闻弹射攻。\n匹如饮甘露，又似斩春风。\n云梦吞伊辈，须弥纳个中。\n故山多芧栗，不必问狙公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥三月九日宿囊山","author":"刘克庄","text":"已买荒山卜毳藏，岂知来此借禅床。\n傍人尽怪病摩诘，送客不嫌穷孟尝。\n皓白群仙应笑老，昏花太乙谩分光。\n何时邻里持牛酒，却贺先生返故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥去国陈宗之胡希圣送行避谤不敢见希圣赠二诗亦不敢答乙卯追和其韵 其二","author":"刘克庄","text":"屡叩龙墀自免冠，虺隤初喜卸华鞍。\n病疏宾客麾之去，老爱儿孙遗以安。\n夙昔赐茶邻御座，即今送菜仰园官。\n萧然几案无书册，时取君诗反覆看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥去国陈宗之胡希圣送行避谤不敢见希圣赠二诗亦不敢答乙卯追和其韵 其一","author":"刘克庄","text":"苛留不觉夏徂秋，甚笑周颙却效尤。\n往圣明言衰戒得，先贤亦谓耄宜休。\n空疏谒帝无高论，老退明农已熟筹。\n惭愧二君更迂阔，远看逐客欲何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎候艮翁二首 其二","author":"刘克庄","text":"恰则含香文德殿，俄而揽辔祝融峰。\n得非麟角惊凡目，或是蛾眉妒冶容。\n六丈一勾非恶意，两翁相对少欢悰。\n西山北郭多幽事，虽老犹堪撰杖从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎候艮翁二首 其一","author":"刘克庄","text":"问讯江边白首郎，可堪留滞向殊方。\n远游定有骚哀郢，新集应添赋吊湘。\n得路诸公蛇入宇，去家几个鹤还乡。\n与君大胜于刘柳，岁晚邻翁约未偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎候林德辅帅参一首","author":"刘克庄","text":"西野约余同荐祢，六丁力尽不能留。\n霜蹄屡蹶追风骠，皓首还登载月舟。\n伊昔士元曾别驾，即今子美尚参谋。\n浮荣膜外何须较，且可归来秉烛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还黄镛诗卷","author":"刘克庄","text":"曾伴灵芝湖上吟，当年一悟至如今。\n源流不乱知归趣，篇什无多见苦心。\n贯虱功夫须切近，脍鲸力量要雄深。\n暮年谁可谈兹事，盎有村醪且自斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"进德","author":"刘克庄","text":"进德功夫有浅深，一毫间断即差参。\n醉无谬误明持敬，怒亦中和见养心。\n为善岂须朋友责，积勤常若父师临。\n向来岁月悠悠过，垂老方知痛自箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连日寒甚怀强甫二首 其二","author":"刘克庄","text":"人生各有稻粱谋，暂去家庭作远游。\n年事但看翁齿发，天寒深念汝衣裘。\n履霜我独知琴操，立雪谁来问话头。\n但愿茅檐相保守，千书说不尽离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连日寒甚怀强甫二首 其一","author":"刘克庄","text":"同云作色日潜辉，咄咄玄冥未霁威。\n驿使能无一枝寄，客程应有六花飞。\n乌公恩重宜亲谒，绛老年高可蚤归。\n想见仙霞三尺雪，布衾如铁起添衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邹莆田见传葬书","author":"刘克庄","text":"令君葬说其传远，一字真堪直一缣。\n惜似辨材藏禊帖，爱如房相笔楞严。\n略疏脱误烦重校，尽扣精微恐不廉。\n欲卜寝丘何处是，凭高试为指东崦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邻家孔雀","author":"刘克庄","text":"初来毛羽锦青葱，今与家鸡饮啄同。\n童子有时偷剪翅，主人常日少开笼。\n峤南岁月幽囚里，陇右山川梦寐中。\n因笑世间真赝错，绣身翻得上屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居","author":"刘克庄","text":"纳履归来六载强，身閒冷看世人忙。\n远公有酒邀莲社，录事无资助草堂。\n柿被鸟残分亦好，李为螬食咽何妨。\n春山何处无薇蕨，更不须求辟谷方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居即事","author":"刘克庄","text":"性偶安林薮，元非慕独清。\n米从仁祖乞，粟是伯夷耕。\n废井通邻汲，深墙隔市声。\n却因虚澹极，亦自觉身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈夫人哀诗","author":"刘克庄","text":"龙川天下士，女子节尤奇。\n孟母迁邻训，共姜誓己诗。\n生无封国分，殁有表阡时。\n曾识双珠树，聊为补些辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈寺丞续荔枝谱","author":"刘克庄","text":"蔡公绝笔山川歇，荔子萧条二百年。\n选貌略如唐进士，慕名几似晋诸贤。\n岂无品劣声虚得，亦有形佳味不然。\n题遍贵家台沼后，请君物色到林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈亨叔司理见遗长笺小诗还贽","author":"刘克庄","text":"贫近山家作此行，潘舆来只费三程。\n责儿反鲊嫌疑谨，使妇供鲑奉养清。\n吾不入城避瓜李，子因谋野过柴荆。\n紫薇老病君房去，自课樵歌代远情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈郎玉汝之官","author":"刘克庄","text":"择地喜将父，戴星勤坐曹。\n阿奴已伤锦，君子好更□。\n大尹徵求寡，先贤抚字劳。\n直须琴调古，莫倚棒头高。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈倩调真阳尉奉台檄摄潮阳尉小诗将别","author":"刘克庄","text":"相阀白眉子，吾家坦腹郎。\n莫贪鸢雾里，小住鳄溪傍。\n粤橐无卷石，韩祠有瓣香。\n两翁各钟念，安讯托风樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈虚一","author":"刘克庄","text":"几载皖山耕，忽提孤剑行。\n战场中有骨，尺籍上无名。\n马自寻归路，身空试贼营。\n却疑兵解去，曾说鍊丹成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮中题一首","author":"刘克庄","text":"曾从庄列问端倪，俗学区区等瓮鸡。\n佛法须偿蚯蚓债，帝魂化作杜鹃啼。\n安知丞相嗔如屋，但见山公醉似泥。\n它日门人求注脚，只须标作饮中题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮良翁宫教新第二首 其二","author":"刘克庄","text":"负郭依山远市廛，高宜台榭下宜田。\n径当膏抹从盘谷，似向丹青见辋川。\n别墅暮年□□□，□□□□□南迁。\n与君幸已抽身了，共结黄鸡白酒缘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮良翁宫教新第二首 其一","author":"刘克庄","text":"拂袖归来计未疏，别规爽垲卜新居。\n即今独擅百弓地，当日惟携一束书。\n户外何须置行马，坐中不必尽悬鱼。\n渠亦若与人家国，输与兴公赋遂初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麦斜","author":"刘克庄","text":"谚比武夷君，来游称所闻。\n岩开花似染，洞出气如云。\n屋老残诗在，崖枯小篆焚。\n只疑龛室内，犹有艾轩文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"使君次韵再赋二首 其二","author":"刘克庄","text":"下车不识疾呼声，郡政清平教亦行。\n曹相治齐宾盖老，何侯在楚厚龚生。\n甘棠通国俱怀惠，遗藁因公得记名。\n老受一廛无以报，先畴不腆尚堪耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"使君次韵再赋二首 其一","author":"刘克庄","text":"当年双璧甲科郎，未羡燕山五桂芳。\n奏赋何曾因狗监，谏书直乞罢鹰坊。\n聚萤窗冷韦编蠹，下马陵芜宰树苍。\n不是使君来北海，邦人岂识郑公乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"参预陈公挽诗二首 其二","author":"刘克庄","text":"圣主初调瑟，烦公数寄声。\n已来周大老，尚致鲁诸生。\n末至馀尊尽，西归只履轻。\n中年知己泪，销得几回倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"参预陈公挽诗二首 其一","author":"刘克庄","text":"人叹摛毫妙，天知补衮忠。\n力犹挽元气，身已御长风。\n家谱侔洪氏，官称似范公。\n独怜莼鲫奠，不得至苕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周天益辞归延平","author":"刘克庄","text":"自说镡津上，辛勤葺数楹。\n一家侨寄活，只手拮据成。\n俗薄诗人厄，州贫太守清。\n闻君不由径，想见揽衣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"命拙","author":"刘克庄","text":"命拙躬耕逢歉岁，旋营水菽度晨昏。\n晴天田舍禾归窖，腊日山家酒满盆。\n护竹短墙修复坏，浇花小井汲来浑。\n早知不是封侯相，蓑笠何因肯出村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乡守朱监丞劝驾一首","author":"刘克庄","text":"龚陈盛事记当年，重见奎星聚旧躔。\n瑞日赋工岂迷色，庆云诗妙似非烟。\n驰千里足相期远，占百花头孰敢先。\n老子扶衰看昼锦，琼林春好莫留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乡侯灯夕六首 其六","author":"刘克庄","text":"传呼铃下戒舆骖，清晓牙旗过水南。\n一瓣预祈今岁稼，两枚不受郡人柑。\n端门侍辇公修觐，禅几传灯我饱参。\n童子归谈城内事，遨头诗好众宾酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乡侯灯夕六首 其四","author":"刘克庄","text":"颇闻珠履从騑骖，士女憧憧忘北南。\n墨客共延素娥桂，鳏翁未遗细君柑。\n坐窗书癖惟孤炷，森戟诗豪且细参。\n输与邻村垂白叟，卖薪归去已醺酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乡侯灯夕六首 其三","author":"刘克庄","text":"榾柮通红未辟寒，病身无异著囚山。\n俊游与众聊同乐，欢事于侬了不关。\n一霎莲华开陆地，十分桂影洗瀛寰。\n朝家若访玄真子，知在清溪第几湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乡侯灯夕六首 其二","author":"刘克庄","text":"侯拥双旌舞两骖，应怜一叟卧周南。\n插门仅有一枝柳，照水全无万椀柑。\n藜去似知瞳子眊，梅开且向鼻端参。\n铃斋诗句兵厨酒，浅酌微吟意已酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方孚若瀑上种梅五首 其五","author":"刘克庄","text":"欲赋梅花材藻尽，公分生意到枯桩。\n钜题昔只韩联孟，妙手今惟羿愈逄。\n守谷尚烦看杏虎，护花难少吠篱尨。\n丹崖翠壁宜挥扫，止要游人笔似杠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方孚若瀑上种梅五首 其四","author":"刘克庄","text":"百匝千回看不足，管他急雪溅奔泷。\n瑶林错立明梁苑，宝璐横陈照楚邦。\n爱杀嚼芳仍嗅蕊，吟狂哆口更疏厖。\n晓来翠羽惊飞去，应为烟钟树杪撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方孚若瀑上种梅五首 其三","author":"刘克庄","text":"瀑映梅华何所似，蚌胎蟾彩浴寒江。\n梦回东阁频牵兴，吟到西湖始树降。\n雪屋恋香开纸帐，月窗怜影掩书釭。\n若将汉晋间人比，不是渊明即老庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方孚若瀑上种梅五首 其二","author":"刘克庄","text":"天赐梅花为受用，缤纷玉雪被层矼。\n素芳林下超群匹，繁蕊枝头巧叠双。\n陇月照时霜剪剪，涧风吹处水淙淙。\n主人笔力回元化，催发何须杖鼓腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方孚若瀑上种梅五首 其一","author":"刘克庄","text":"仙翁小试春风手，高拂茅檐矮映窗。\n选胜多依岩罅种，爱奇或并树身扛。\n海山大士寒蒙衲，月殿仙姝夜拥幢。\n商略此花宜茗饮，不销银烛綵缠缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方时父","author":"刘克庄","text":"曾陪朵殿燕天基，辜负先皇不世知。\n二客穿傍垂汉史，三良临穴见秦诗。\n犬鸡拔宅难飞举，雀鼠贪生愧暮迟。\n回首修门悲复喜，大明继照出咸池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方时父立春","author":"刘克庄","text":"茶梅有意如相伴，梨枣无根未易栽。\n稍喜冻逢春渐解，不堪老挟病俱来。\n久扃北户寒稀出，已落南枝暖再开。\n忘却玉堂供帖子，牛栏西畔觅诗回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和北山一首","author":"刘克庄","text":"幅巾高蹈挹洪崖，闲洒银钩著玉杯。\n文律不论先汉后，诗源远自国风来。\n却愁小子方攻冉，未必吾师肯铸回。\n极欲去修床下拜，扁舟归梦绕南台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶尚书解印二首 其二","author":"刘克庄","text":"倦入承明听履声，朱轓今复厌专城。\n荡胸太华供吟兴，照眼伊川洗宦情。\n莼鲙何惭高士决，琴龟不减昔贤清。\n未应便葺东山墅，出处方关世重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶尚书解印二首 其一","author":"刘克庄","text":"郡人不识疾呼声，甘雨和风遍一城。\n岁久偏多遗爱事，天高未察借留情。\n舟行精舍渔歌晚，家近华亭鹤唳清。\n莫比归云并倦翼，先生此念素来轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和外弟方遇立春","author":"刘克庄","text":"脱发纷纷雪满簪，逢春非复少年心。\n旋分菜把来穷巷，遥忆花枝满上林。\n寒拥絮衣看谒懒，老耽绮语业缘深。\n竹居东道风光主，乞与甘棠蔽芾阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和兴化赵令君二首 其二","author":"刘克庄","text":"自古名高众责全，几人赍恨到重泉。\n世传戆叟难□节，士谓周侯惜末年。\n扶电骏翻成跛鳖，鸣阳凤化作寒蝉。\n嗟予景薄崦嵫矣，临履渊冰尚凛然。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和兴化赵令君二首 其一","author":"刘克庄","text":"落笔昔传九天上，诛茅今老万山中。\n殷勤封内种花令，物色畦间拾穗翁。\n道是单传曾雪立，元来一字耻雷同。\n语君此事须商榷，唐律尤难似古风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱主簿四首 其四","author":"刘克庄","text":"君思清如许，吾诗浅矣哉。\n不能具刍饭，虚辱受琼瑰。\n伊洛推游谢，韩欧赏孟梅。\n武夷老仙伯，相引上蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱主簿四首 其三","author":"刘克庄","text":"耄矣犹耽学，天乎不背师。\n仅馀芭受业，曾许赐言诗。\n鲁兀存尊足，虞翻乏媚姿。\n回头谢房魏，努力辅明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱主簿四首 其二","author":"刘克庄","text":"玉座怀贤远，黄扉取友端。\n吾方观治象，渠忍铩祥鸾。\n家学应难改，贤名已不刊。\n三年无一字，怀旧忽汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱主簿四首 其一","author":"刘克庄","text":"在朝无友助，于野有人同。\n生愧饮牛叟，死惭招鹤翁。\n未应千载后，也似百年中。\n一掬珠林泪，凭高洒北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪三诗 其一 戊辰二月六日","author":"刘克庄","text":"炮车云怒激狂澜，只作禅家露电观。\n抽得元身闲处著，免他冷眼静中看。\n买山深悔于城近，逃席何须待酒阑。\n昔美少年今皓白，懒从日者问支干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪三诗 效颦一首","author":"刘克庄","text":"衰残悔不早脩真，蓝缕何须更逐贫。\n诸恶能通三世业，瓣香要做再来身。\n先民至死思存汉，谄子偷生作美新。\n俯仰两间无愧怍，有辞可以白先人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪三诗 其三 遣兴","author":"刘克庄","text":"晚慕玄真与季真，床头金尽不忧贫。\n六如偈简常持念，四勿箴佳最切身。\n古有德衰年亦暮，今谁齿宿意犹新。\n手遮西日过门客，来拜庞公者几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪怀樗庵二首 其二","author":"刘克庄","text":"偶赋东风御柳诗，流传误柬九重知。\n昔曾苑内借全树，今向林间巢一枝。\n已买十牛耕笠泽，难陪八骏宴瑶池。\n鬳翁同洒遗弓泪，犹记甘泉□□随。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪怀樗庵二首 其一","author":"刘克庄","text":"视草呼来犹殿上，采薇归去忽山阿。\n重笺饮渭观濠义，曾和横汾过沛歌。\n乞岛一联余思涩，方丕十倍子才多。\n白头辜负龙泉老，拙咏安能继庾何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪披字韵二首 其二","author":"刘克庄","text":"人夸晚节犹鲜健，谁信朝华已谢披。\n空有朵云盈箧笥，竟无片雪上钳椎。\n槁枯毋怪芳菲歇，退惰常因血气衰。\n自叹龙钟真髦矣，不如茗艼一中之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹溪披字韵二首 其一","author":"刘克庄","text":"玉雪面俄成丑老，琅玕腹未尽呈披。\n只今众女各施粉，自古十夫能挽椎。\n岂有进贤冠绘像，亦无灵寿杖扶衰。\n俚辞闻早安排了，未必他人识牧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和西外赵知宗","author":"刘克庄","text":"斤妙斲如神，源深汲愈新。\n岱宗疑有趾，海若忽无津。\n传远须公等，钻坚尽此身。\n平生师友意，非为雨中巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]