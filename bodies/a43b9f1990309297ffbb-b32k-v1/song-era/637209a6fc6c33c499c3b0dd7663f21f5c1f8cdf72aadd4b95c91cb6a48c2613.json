[{"title":"偈颂一百二十三首 其二十三","author":"释普度","text":"群阴剥尽，一阳来复。\n铁树花开，清香馥郁。\n眼皮开未开，枝南复枝北。\n凹凹凸凸破沙盆，何似镇州大萝卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十一","author":"释普度","text":"老瞿昙，眼孔小。\n一星半星容不得，说迷说悟何时了。\n衲僧分上那有许多般，雪晴海阔千峰晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十二","author":"释普度","text":"达磨西来，只个不识。\n铁壁银山，挨拶不入。\n因甚分皮分髓，飞来峰高冷泉碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一五","author":"释普度","text":"佛法无人说，虽慧不能了。\n幸然平似镜，何用曲如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十五","author":"释普度","text":"云收海山横，月印江天晓。\n扰扰红尘中，青春有多少。\n铁壁银山一拶开，落花流水空徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○二","author":"释普度","text":"是法住法位，世间相常住。\n昨日大风潮，吹折山前树。\n云自向天飞，水流朝海去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十","author":"释普度","text":"八月二十五，洞山离查渡。\n咄哉老云门，多却末后句。\n桃花浪暖禹门高，霹雳一声烧尾去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十六","author":"释普度","text":"玉鉴光中，波澄月现。\n展屠龙手，提金刚剑。\n栗棘金圈一拶开，从君细嚼浑崙咽。\n有照有用，有舒有卷。\n杨岐消息未全灰，优昙华笑春风面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十五","author":"释普度","text":"麻三斤，乾屎橛。\n不是五逆汉，此话凭谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十六","author":"释普度","text":"文殊虽令善财采药，佛病祖病，未曾医著。\n灵隐病亦无，药亦无，赵州东壁挂葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○八","author":"释普度","text":"今朝七月十五，衲僧拄杖起舞。\n头顶西天，脚踏东土。\n游历百城，不移寸步。\n阿呵呵，白云绽处青山露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十七","author":"释普度","text":"古镜无光，当台自照。\n森罗绝影，觌面难逃。\n行不言之令，坐致太平。\n赞无为之化，六国晏清。\n天高地厚，水绿山青。\n山青青，水泠泠。\n湘西古渡夕阳明，岳足当檐开画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十六","author":"释普度","text":"今朝五月五，诸方尽鸣鼓。\n不说药病相治，便说书符咒士。\n金山伎俩既无，未免别行一路。\n日轮当午。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十八","author":"释普度","text":"正觉山前，明星皎皎。\n夜半打失鼻孔，将谓一了便了。\n中竺看来，有些短处，不说也好。\n开得眼来天大哓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十一","author":"释普度","text":"破沙盆，没巴鼻，尽大地人扶持不起。\n玉山路上，荆棘参天。\n钟阜山前，清风匝地。\n擘破宝公面皮，德云无处回避。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一二","author":"释普度","text":"震法雷，击法鼓。\n玉角金鳞，兴云吐雾。\n机前拶倒凌霄峰，大地撮来无寸土。\n杀活全提，平欺佛祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十八","author":"释普度","text":"火云影里一叶落，玉鉴光中便见秋。\n一任秋来又秋去，大江依旧向东流。\n无变易，有来由。\n塞鸿何处，白鹭沧洲。\n数声渔笛烟村晚，狼藉断霞闲钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十四","author":"释普度","text":"长一线，一线长。\n眼闻耳见，不用商量。\n流水断桥梅破萼，枝南枝北一般春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十五","author":"释普度","text":"长长出不得，短短出不得。\n四大海不宽，藕丝窍不窄。\n非耳目之所到，非心意之所及。\n自西自东，自南自北。\n落霞与孤鹜齐飞，秋水共长天一色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十九","author":"释普度","text":"昨夜毗岚撼山岳，七十二峰俱倒卓。\n太湖万顷涓滴无，黄叶乱飘星斗落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二十五","author":"释普度","text":"说得一丈，不如行得一尺。\n行得一尺，不如离却一寸。\n山高分水深，青天分白日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十三","author":"释普度","text":"妙喜黑竹篦，有背还有触。\n儿孙用得亲，通身是眼目。\n正令全提转辘辘，花簇簇，锦簇簇。\n直教佛祖亦头低，宇宙空来更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十四","author":"释普度","text":"拘尸那城有生灭，我此世界生灭无。\n桃红李白花时节，是处江山开画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一二一","author":"释普度","text":"声前一句，格外一机。\n不堕古今，宁存凡圣。\n妙高台上，玉鉴光中。\n日日安居，时时禁足。\n风恬浪静，海晏河清。\n长期短期，平等受用。\n阑干同倚不同倚，消得龙王多少风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一二○","author":"释普度","text":"踏断洛阳桥，直上妙峰顶。\n拈得家传黑竹篦，搅动龙渊千尺井。\n四五处雷动风行，八九十春花月影。\n为人端的无情，独脱单提谁领。\n竹篦虽折典刑存，闻见犹能发深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一三","author":"释普度","text":"骄阳正酷火云飞，一雨霶?彻四维。\n䆉稏吹香民已乐，山川草木亦光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一一","author":"释普度","text":"邬那青青处，山高云半垂。\n面面栽荆棘，游人到者稀。\n寥寥五十载，昨是今何非。\n太湖三万六千顷，月在波心说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十三","author":"释普度","text":"虎岩岩下虎，咬人齿不露。\n踞地坐眈眈，南北无行路。\n翻身一掷更无踪，虚空拍掌须弥舞。\n万象森罗，一时痛苦。\n石人木人泪如雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四十九","author":"释普度","text":"楼阁门开，了无回互。\n既是家里人，便请直入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三","author":"释普度","text":"有主有宾，无疏无亲。\n直饶七佛到来。\n各与三十拄杖，少喜多嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十七","author":"释普度","text":"布袋头一结，百城消息绝。\n蜡人冰不冰，万里一条铁。\n珊瑚枝枝撑著月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十二","author":"释普度","text":"东湖辊底怒涛，青山参天荆棘。\n两处狭路相逢，拶得渠侬上壁。\n恩难酬，怨难酬，热煮冷泉流水，浓点淡茶一瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十二","author":"释普度","text":"智不到处，不妨道著。\n吸尽长江，冲开碧落。\n的的金圈栗棘，一一天花乳酪。\n杨岐消息俨然存，大用机前活卓卓。\n山僧合掌有分，诸人如何啖啄。\n玉鉴光中宇宙宽，双双放出辽天鹘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一七","author":"释普度","text":"一日三，三日九。\n只知暑往寒来，不觉躘蹱老朽。\n退一步，绝离微。\n百花开尽后，黄菊在东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五","author":"释普度","text":"拄杖子，无向背。\n东拄西撑，登山涉海。\n卞璧骊珠，泥团土块，一时粉碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九","author":"释普度","text":"前佛性命，后佛纪纲。\n开口即丧，闭口即错。\n瘥病不假驴驼药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"猪头和尚赞","author":"释普度","text":"金华圣者无人识，相逢便讨猪头吃。\n回首还从旧路归，春风一阵香狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚堂和尚赞","author":"释普度","text":"戏海狞龙，出山猛虎。\n眼盖乾坤，气吞佛祖。\n严法令则滴水冰生，提向上则超今越古。\n九据名蓝，三奉诏旨。\n无愧当年面壁人，只是口门多一齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山赞","author":"释普度","text":"没伎俩，爱吟诗。\n一句子，少人知。\n寥寥静听松风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寮前老郎请赞","author":"释普度","text":"心直如弦，性急似箭。\n翻手覆手，日面月面。\n零敲碎打破沙盆，我见人见众生见寿者见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德山赞","author":"释普度","text":"担疏钞行脚，大负不平气。\n失脚到龙潭，未惬平生意。\n吹灭纸灯时，拶著娘生鼻。\n便将一炬火，烧却闲故纸。\n从兹愤愤觅冤雠，一条白棒掀天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懒瓒赞","author":"释普度","text":"山窈窕，路羊肠。\n紫泥下诏，御墨犹香。\n报道我侬煨芋忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠医牙道人","author":"释普度","text":"先生得道医牙齿，痛令不痛消弹指。\n饱饭吾今八十年，未尝咬著一粒米。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八","author":"释普度","text":"龙门万仞，到者还稀。\n不犯清波，如何进步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十八","author":"释普度","text":"李白桃红，桃红李白。\n或雨或晴，或寒或热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十五","author":"释普度","text":"用鈯斧子，非重非轻。\n拈起放下，肘后符灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞世颂","author":"释普度","text":"八十二年，驾无底船。\n踏翻归去，明月一天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和葛天民南翔寺韵","author":"释普洽","text":"白鹤南翔何日返，香云不动春风转。\n屋为鳞次枕江安，江作蛇行到门远。\n的的明灯金殿寒，沉沉复道长廊晚。\n老翁矍铄皎须眉，爱客将迎笑盈面。\n自言天监拓基来，食指数千犹共饭。\n断碑壁下试摩挲，龟趺剥落生苔藓。\n茫茫往事比寒潮，苍烟落日愁难遣。\n遣中何处惬深深，玉甃新池开别院。\n二齐已去老堪殂，故垒空来巢旧燕。\n吾宗有弟知此怀，炊黍功名岂云愿。\n便呼阿买写新诗，研池涩拥清冰片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刀镊","author":"释普济","text":"得心应手乖毫发，心手俱亡处处通。\n摘一茎髭弹一镊，有相同有不相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山翁","author":"释普济","text":"重叠春风面，高低雪满头。\n渠无生老相，孤峻罕人游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"干藏","author":"释普济","text":"恶语重重放出门，只图一个不知恩。\n二千年事难遮覆，动便随人脚后跟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五祖送六祖渡江图赞","author":"释普济","text":"有传有受恩成怨，无受无传怨似恩。\n船到岸头恩怨绝，遍天遍地一儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水茶磨","author":"释普济","text":"机轮转处水潺潺，机若停时水自闲。\n末上一遭知落处，十分春色满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四睡赞","author":"释普济","text":"离了峨嵋别五台，倒骑白额下天台。\n松间石上梦中梦，唤得闾丘太守回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示若临侍者","author":"释普济","text":"一思面门摘不断，放下重新买草鞋。\n有路莫行无路入，照顾浑家落险崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"在庵","author":"释普济","text":"世间几见劫灰飞，老屋依前对落晖。\n四大部洲都遍历，到头还向此中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夹山见船子赞","author":"释普济","text":"毒手一桡难躲避，点头不见问津人。\n烟波浩渺无穷恨，父子虽亲未是亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞","author":"释普济","text":"出林虎方怒，横冈蟒正嗔。\n世无途路客，终是不伤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西隐","author":"释普济","text":"泥牛斗入海门关，直到如今万象闲。\n百鸟不来春自老，柴门依旧向东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨大师赞 其一","author":"释普济","text":"的的西天末法僧，来分此土最初灯。\n神光冷地一吹灭，葱岭忙忙只暗登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"进月轩","author":"释普济","text":"桂轮孤朗碧天宽，帘卷清光入座寒。\n底事明明人不荐，又移花影上栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和静照诗韵 其二","author":"释普济","text":"半千尊者眼如眉，一一从头为点开。\n踏断石桥成两段，方知亲过一回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和静照诗韵 其一","author":"释普济","text":"各逞神通现瑞茶，非云非雪亦非霞。\n梦中说梦非见见，报道从来眼不花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弥勒大士二月八生","author":"释普济","text":"契此老翁无记性，都忘生月与生辰。\n春风桃李能多事，特地年年说向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复古日者","author":"释普济","text":"试问先生蕴底术，卦盘掇转呵呵笑。\n毗婆尸佛早留心，直至如今不得妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柏岩","author":"释普济","text":"苗裔忽生崖石裂，不同松桧拂云长。\n苍苍无一闲枝叶，子落丛林也有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送广州泰长老","author":"释普济","text":"老卢曾见老黄梅，一首长廊落韵诗。\n既是同坑无异土，家私莫与路人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送日本国僧二首 其一","author":"释普济","text":"壁观胡僧入大梁，单传必死活人方。\n至今此术遍天下，航海梯山空自忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送日本国僧二首 其二","author":"释普济","text":"大舶浮空驾浪来，顶门有眼未曾开。\n南山虎口翻身出，日本生成一祸胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送清凉淮海和尚住万年","author":"释普济","text":"潮声忽转石头城，大舍峰高侧耳听。\n五百个僧都不会，教他一一侍巾瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送猫儿","author":"释普济","text":"大慈悲种小斑斑，软血功能也是闲。\n首尾直兮眸子正，不知走却屋头山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧偈","author":"释普济","text":"云遮剑阁三千里，水隔瞿塘十二峰。\n抖擞屎肠都说了，莫教错过瓮为钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"损窗","author":"释普济","text":"六处虚明不假修，七穿八穴有来由。\n霜风霰雪纵横入，不是愁人也著愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]