[{"title":"送鲁漕四首 其三","author":"吴芾","text":"自别频惊岁月迁，又来此地奉周旋。\n虽欣同会成三老，却恨相从未一年。\n君已促装行诣阙，我方投绂欲归田。\n须知出处从今异，一醉休辞拍酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲁漕四首 其二","author":"吴芾","text":"聚散无期自古来，偶然相值且徘徊。\n百年能得几回醉，三世肯辞平等杯。\n晚岁谁如君激烈，高情应念我衰颓。\n亦知分袂无多日，怀抱何妨更尽开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲁漕四首 其一","author":"吴芾","text":"高人本爱水云乡，揽辔登车未免忙。\n连岁已陪徐孺子，今年更访贺知章。\n近家上冢情何限，寻壑经丘兴更长。\n祇恐便归清禁去，稽山未必得徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏签","author":"吴芾","text":"平分冬气恰经旬，天应新阳产异人。\n家世旧来推硕学，胸襟自许作良臣。\n不应莲幕淹留久，会见枫宸拔擢新。\n但愿朱颜长不老，稳看他日画麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳用去年韵 其一","author":"吴芾","text":"不堪秋色已悲凉，那更重阳对夕阳。\n白发苍颜羞览镜，紫萸黄菊喜浮觞。\n且来高处开心目，莫引愁端挠肺肠。\n未信天教长作客，会须有日放还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳用去年韵 其二","author":"吴芾","text":"此生几度换炎凉，过了重阳又一阳。\n无奈流年如转毂，得逢佳节且飞觞。\n风前落帽从吹鬓，江上登台任断肠。\n老去已忘荣与辱，只思归卧水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳用昔年所作韵","author":"吴芾","text":"行尽天涯鬓欲霜，又来姑孰过重阳。\n试登翠巘邀珠履，更唤红裙侑玉觞。\n野菊有花供客眼，公庭无事恼人肠。\n诸君莫惜长鲸量，且伴衰翁入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳有作呈朝宗","author":"吴芾","text":"残年脚力已摧颓，不谓登高尚可来。\n每恨故人多爽约，那知今日共衔杯。\n挪挲黄菊香仍在，怅恨朱颜挽不回。\n君若此时犹惜醉，酒怀更待几时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳有感呈诸丈","author":"吴芾","text":"九日长年客异乡，今年又复到南昌。\n眼看黄菊依然好，心着青山祇自伤。\n已是岁华成晼晚，可堪秋色更凄凉。\n诸公不用羞吹帽，且试登高共一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳即席呈诸兄叔","author":"吴芾","text":"淅淅西风作晚凉，惊人节物又重阳。\n频年此会成千里，环坐如今共一觞。\n且把黄花开笑口，莫因白发搅愁肠。\n人生聚散浑无定，来岁那知在故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻伯可郎中锐然有冥鸿之举小诗奉庆","author":"吴芾","text":"郎省声猷蔼搢绅，看看步武到通津。\n合留北阙扶宸极，却向西溪整钓纶。\n愧我暮年方谢事，羡君壮岁便抽身。\n时贤莫把衰翁比，林下如君只一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻故旧二三公或不幸于官或以疾病而去或以口语而罢怅然有感","author":"吴芾","text":"平日衰迟众所怜，偶逢亨运亦腾骞。\n七旬已过宜休矣，一出不归终溘然。\n幸免烦言全晚节，且无多病恼残年。\n直须更作投簪计，莫待将身到九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻鹿生子","author":"吴芾","text":"再上归田疏，从违未可知。\n方忧鹤怨我，忽喜鹿生儿。\n六月事已验，千年寿可期。\n我归须汝健，正要汝相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台六首 其六","author":"吴芾","text":"宋武当年迹已陈，荒台寂寞几经春。\n一番栋宇从头葺，四面轩窗入眼新。\n陡觉江山增气象，更添风月愈精神。\n老夫无处逃炎暑，领客时来一岸巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台六首 其五","author":"吴芾","text":"百尺台前万顷宽，风烟缥缈隔尘寰。\n天浮江水兼湖水，云抹淮山与楚山。\n景物宛如图画里，星河祇在户庭间。\n登临莫作悲秋意，且对黄花一解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台六首 其四","author":"吴芾","text":"黄山高处敞层台，伊昔规模想壮哉。\n江上依然双阙在，日边不见六龙来。\n落花啼鸟空遗恨，翠竹青松且漫栽。\n先是老怀多感慨，每来吊古一兴哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台六首 其三","author":"吴芾","text":"簿书终日困拘挛，每到凌歊意豁然。\n千里日光斜照水，一川草色远连天。\n青山顶上玄晖宅，采石江头太白船。\n俱在目中浑可乐，何妨时复一扬鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台六首 其二","author":"吴芾","text":"万里清光绝点尘，别来经岁镇如新。\n恨居平地去天远，喜上高台与月亲。\n正好赏心拚酩酊，不堪怀古倍酸辛。\n向来登此知何限，传到如今有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台六首 其一","author":"吴芾","text":"莫辞千骑小徘徊，共上凌歊百尺台。\n过雨江山新似洗，连天草树翠成堆。\n搜罗好景归诗句，断送閒愁付酒杯。\n对此愿公拚一醉，相逢能得几回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挈累来当涂闻已入境感怀有作二首 其二","author":"吴芾","text":"方与晴窗爱日亲，若为天又作重阴。\n年来已是忧思过，老去那堪疾病侵。\n默数七旬宁几日，更添一岁愈惊心。\n喜闻已办周身具，对酒何妨且满斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挈累来当涂闻已入境感怀有作二首 其一","author":"吴芾","text":"鸥鹭相疏雁鹜亲，簿书丛里度光阴。\n尘埃已觉胸中满，霜雪还从鬓上侵。\n尽室修途方在念，连宵苦雨若为心。\n明朝傥得成团聚，有酒从教取次斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽五兄知府二首 其二","author":"吴芾","text":"三吴意气各翩翩，尚忆俱游太学年。\n伯氏久惊归厚夜，吾兄远复掩新阡。\n自怜门户今衰矣，回想音容祇泫然。\n犹幸诸儿浑竞爽，他时当不负家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽五兄知府二首 其一","author":"吴芾","text":"平生臭味最相投，方喜同时得退休。\n正欲从容陪杖屦，从兹萧散老林丘。\n高标岂料成千古，遗爱空嗟满一州。\n兄弟凋零复无继，故山谁与我同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王之先","author":"吴芾","text":"壮志凌云气吐虹，才华高出辈流中。\n读书不负建楼意，好客尚赊投辖风。\n鹗荐共期登虎榜，鹢飞无复到蟾宫。\n春来池馆浑如旧，梦觉黄粱事已空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽朱枢言","author":"吴芾","text":"持心常近厚，遇事不辞难。\n早岁曾攀桂，中年更握兰。\n盛名驰海内，素望耸朝端。\n尚有清芬在，流光永后观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汤丞相三首 其三","author":"吴芾","text":"吴郡为僚日，如公最妙龄。\n众寻归鬼录，独出佐王庭。\n道丧思人物，公存尚典刑。\n伤哉今亦逝，唯我老零丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汤丞相三首 其二","author":"吴芾","text":"游刃有馀地，孤忠不愧天。\n两朝资弼亮，四海赖陶甄。\n身后浮言汹，生前素履全。\n他时公论定，史笔看流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汤丞相三首 其一","author":"吴芾","text":"平步青云上，逢辰亦盛哉。\n十年登两地，四见入中台。\n独擅调元手，咸推济世才。\n如何天不慭，一夕泰山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何内翰二首 其二","author":"吴芾","text":"老去交游半浅深，高山流水独知音。\n分携苦未经寒暑，转盼那知隔古今。\n联事尚怀时把酒，同朝犹记共论心。\n无因执绋西山路，空对东风泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何内翰二首 其一","author":"吴芾","text":"场屋声名四海知，十年平步上丹墀。\n伏蒲议论高千古，视草文章妙一时。\n雅望自应登辅弼，壮图仍欲济艰危。\n谁知竟负经纶志，空使人怀殄瘁悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴尚书三首 其三","author":"吴芾","text":"公守东阳郡，于今已十年。\n人犹诵遗爱，政不愧前贤。\n清议当时重，休声后代传。\n我来叨郡佐，怅望隔重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴尚书三首 其二","author":"吴芾","text":"晚岁登台省，频年侍殿墀。\n从容如素宦，卓荦冠明时。\n人冀终图任，天胡不慭遗。\n流芳知未艾，家有宁馨儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴尚书三首 其一","author":"吴芾","text":"奇才从古少，厚德独公全。\n克己强为善，虚心乐荐贤。\n立朝忠贯日，谋国力回天。\n阅世虽多故，胸中固湛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽应伟节尊人","author":"吴芾","text":"归来闾里问高年，此日惟公五福全。\n三世儒科身及见，四经乡饮众推先。\n安时不恨青衫晚，适意还欣綵服鲜。\n终始哀荣无可憾，想应含笑入黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李季文二首 其二","author":"吴芾","text":"吴郡为僚记少时，别来光景迅如飞。\n江头我始怀章去，岭外君才解组归。\n正望故人时见过，回思往事遽成非。\n死生契阔无穷恨，极目高原泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李季文二首 其一","author":"吴芾","text":"世趋捷径蹈危机，公独安恬度岁时。\n但见谦谦卑自牧，不为赫赫急人知。\n政成名已闻丹扆，官满身将上赤墀。\n岂料一朝成奄忽，空传南国去思碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈兖仲","author":"吴芾","text":"慷慨平群盗，能为众所难。\n身虽淹武弁，志不负儒冠。\n义概千钧重，心田万顷宽。\n故山方适意，清梦忽惊残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周希舜二首 其二","author":"吴芾","text":"倾盖如前日，分携忽累年。\n我方来旧治，公已辟新阡。\n宿草荒三径，寒云惨一川。\n善人无复见，回首已茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周希舜二首 其一","author":"吴芾","text":"末俗事浮竞，夫君志不移。\n至诚闾里化，纯孝冕旒知。\n恬养方安命，骞腾未济时。\n一朝埋玉树，空使万人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周季卿","author":"吴芾","text":"一时推旷达，末俗少如公。\n自得高人趣，居多长者风。\n生涯书卷里，世事酒杯中。\n瞑目应无憾，传家有阿戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽孟仲安二首 其二","author":"吴芾","text":"义薄云天气吐虹，平生心事许谁同。\n从容破贼无遗策，清白传家有祖风。\n共意骞腾千里外，谁知萧瑟九原中。\n百年已矣馀芳在，庭下行看发桂丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽孟仲安二首 其一","author":"吴芾","text":"琴剑纵横迹已陈，凛然英气尚如存。\n向来忠义全乡社，老去诗书付子孙。\n正好林泉穷胜事，那知风月负清樽。\n他年阴德留馀庆，会见簪绅萃一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽季行可","author":"吴芾","text":"当年阙下久栖迟，故里归来万事非。\n访旧几人成鬼录，伤君未老弃亲闱。\n开樽尚想延宾醉，发廪犹思赈岁饥。\n积庆流芳知未艾，会看门户日光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林绍伊二首 其二","author":"吴芾","text":"三朝褒旧德，一代仰名儒。\n晚岁持荷橐，频年剖竹符。\n共期调鼎鼐，岂谓老江湖。\n身后知无憾，传家有凤雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林绍伊二首 其一","author":"吴芾","text":"早负经纶志，居然欲起家。\n持身惟孝友，告后尽忠嘉。\n位望隆青琐，文章在白麻。\n忍闻埋玉树，四海共惊嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽范丞相五首 其五","author":"吴芾","text":"长计公生日，年年献寿诗。\n祇今良月近，遽作九泉悲。\n世事真难料，人生信有涯。\n西风吹画翣，心折泪空垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽范丞相五首 其四","author":"吴芾","text":"七十方强半，天胡不慭遗。\n致身虽宰辅，遭世已艰危。\n计策安宗社，勋庸载鼎彝。\n国雠犹未灭，岂料哲人萎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽范丞相五首 其三","author":"吴芾","text":"贵处人臣极，居忘相位尊。\n朝廷名德重，前辈典刑存。\n方喜生同世，俄惊吊在门。\n百年知己恨，寂寞向谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽范丞相五首 其二","author":"吴芾","text":"伊昔宣和际，公来射策初。\n独陈天下事，不负古人书。\n宣室方前席，苍生欲奠居。\n黑头成奄忽，天意果何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽范丞相五首 其一","author":"吴芾","text":"蚤岁登三事，皇朝第一人。\n声名塞寰宇，功业在生民。\n千载风云会，三朝柱石臣。\n堂堂无复见，空忆吐车茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑武子","author":"吴芾","text":"中原耆旧久彫零，赖有夫君尚典刑。\n持节有心吞朔骑，请缨无路报朝廷。\n壮图落落嗟难合，末俗纷纷笑独醒。\n坐蜕已超尘世去，空馀遗像在丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽姚君二首 其二","author":"吴芾","text":"晚得田园趣，平居乐有馀。\n好贤闻善道，奉佛契真如。\n往事歌谣在，浮生梦幻虚。\n我惭居垩室，无路挽灵车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽姚君二首 其一","author":"吴芾","text":"处世心无愧，持身德有常。\n施恩周里闬，植福遍僧坊。\n入户书盈室，开樽客满堂。\n清芬传后叶，看取桂枝芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡经仲二首 其二","author":"吴芾","text":"相距一百里，相从四十年。\n话言穷理窟，酬唱足诗篇。\n我始归三径，公胡掩九泉。\n无由论旧事，尚拟志新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽胡经仲二首 其一","author":"吴芾","text":"千载微言绝，夫君妙独传。\n钩深探阃奥，养浩塞天渊。\n忧世心虽切，归田志颇坚。\n斯文今已矣，空复诵遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽席夫人二首 其二","author":"吴芾","text":"猗欤陶母世称贤，生子还持辅佐权。\n政府旧曾迎象服，成都重见拥戎旃。\n佳城闭处千车集，华屋生来五福全。\n终始衰荣今已矣，空馀陈迹载青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽席夫人二首 其一","author":"吴芾","text":"持身礼法动无违，四德如君古亦稀。\n大国增封光典册，长年献寿拥庭闱。\n俄惊蒿里飞丹旐，尚想萱堂玩綵衣。\n窃意生前犹有恨，沙堤不及见公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐子固","author":"吴芾","text":"相逢一笑记临安，倒指今逾二十年。\n别后每思论旧事，朝来忽报启新阡。\n莅官凛凛风犹在，居里恂恂誉更传。\n遥想武陵溪上路，送车千两一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽袁正言","author":"吴芾","text":"言路同游记昔年，英风凛凛共推贤。\n从容峨豸霜台上，感慨婴鳞黼扆前。\n持橐自应登禁闼，乘轺聊复向江壖。\n一朝岂料成千古，空有清规后代传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钱省干","author":"吴芾","text":"高义由来擅月评，壮年锐志立功名。\n助平逆党谋先定，谩骂凶酋色不惊。\n赤帻蹉跎怜晚景，青云腾蹋负平生。\n祇应馀庆钟兰玉，桂籍传芳奕世荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽梁尚书二首 其二","author":"吴芾","text":"身在名卿数，人怀长者风。\n爱民馀善政，富国著休功。\n扬历周中外，哀荣极始终。\n芝兰方竞秀，流庆看无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽梁尚书二首 其一","author":"吴芾","text":"早岁膺宸眷，回翔老禁涂。\n三持周版籍，九佩汉铜符。\n度量包千顷，声名满八区。\n谁知成奄忽，陈迹付龟趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽鹿国强二首 其二","author":"吴芾","text":"仕宦吾乡少，咸尊鲁一儒。\n名虽登上第，身不到亨衢。\n耆旧今垂尽，游从孰与俱。\n百年如梦幻，回首但惊呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽鹿国强二首 其一","author":"吴芾","text":"藉甚鸣场屋，居然好弟兄。\n桂林同擢秀，梓里顿增荣。\n泮水清规在，家山雅趣成。\n投簪方自适，何处掩佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽程朝议二首 其二","author":"吴芾","text":"忆昔安舆到郡时，使君欢迓镇江湄。\n万人踊跃瞻耆艾，千里歌谣美孝慈。\n盛德所钟门阀在，平生无愧鬼神知。\n佳城一闭成千古，徒有阴风拂穗帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽程朝议二首 其一","author":"吴芾","text":"兵革连年苦乱离，江东耆旧日衰微。\n身兼五福如公少，眼见重孙自古稀。\n未厌案头翻贝叶，方荣堂上戏斑衣。\n东风忽破南柯梦，回首音容涕泪挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]