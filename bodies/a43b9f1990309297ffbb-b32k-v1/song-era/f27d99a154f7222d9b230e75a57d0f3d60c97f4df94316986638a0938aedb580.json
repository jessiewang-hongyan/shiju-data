[{"title":"夜行船 其一 越上作","author":"丘崇","text":"水满平湖香满路。\n绕重城、藕花无数。\n小艇红妆，疏帘轻盖，烟柳画桥斜渡。\n恣乐追凉忘日暮。\n箫鼓动、月明人去。\n犹有清歌，随风迢递，声在芰荷深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜行船 其二","author":"丘崇","text":"一舸鸱夷云水路。\n贪游戏、悄忘尘数。\n明月长随，清风满载，那向急流争渡。\n邂逅占星来已暮。\n芝封待、却催归去。\n倚玉蒹葭，论文尊俎，回首笑谈何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜行船 其四 怀越中","author":"丘崇","text":"万柄荷花红绕路。\n锦连空、望无层数。\n照水旌旗，临风鼓吹，行遍月桥烟渡。\n堪笑年华今已暮。\n身西上、梦魂东去。\n一曲亭边，五云门外，犹记最花多处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定风波 咏丹桂","author":"丘崇","text":"月殿移根入帝乡。\n风流犹是旧时妆。\n猩血染成丹杏脸。\n浓点。\n郁金笼就赭衣黄。\n浪说锦城元自少。\n不道。\n只今何啻五枝芳。\n试问司花谁是主。\n传语。\n且烦都与十分香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"丘崇","text":"烛花渐暗，似梦来非梦，今夕何夕。\n帘幕生香人醉里，家住深深密密。\n送客难为，独留无计，此意谁知得。\n相看无语，可怜心绪如织。\n缓辔踏月归来，空馀襟袖，有多情脂泽。\n浅笑轻颦追想处，眼底如今历历。\n著意新词，于人好语，过后应难必。\n今宵酒醒，断肠人正愁寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 乙未，高宗庆七十，母氏封宜人作","author":"丘崇","text":"天上玉卮称万寿，人间湛露初匀。\n种萱堂上阅青春。\n薰风频送喜，同日拜丝纶。\n班在蕊珠仙缀立，等闲历遍燕秦。\n紫皇先付与佳名。\n宜家更宜国，宜子又宜孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 和胡夫人","author":"丘崇","text":"风佩珊珊。\n云屏曲曲，愁绝春悭。\n无赖馀寒。\n半醒宿酒，御夹成单。\n深沈院落人闲。\n凭阑处、眉颦黛残。\n彩笔慵拈。\n新声微度，兴入云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其一 为叶梦锡总领寿","author":"丘崇","text":"一番好景，近莺花时候。\n才过收灯便晴昼。\n正熊罴、占梦日，戏彩称觞，当此际，须信人间未有。\n光华分瑞节，粉署兰台，谁出如公望郎右。\n气如虹，才吐凤，指掌功名，馀事也，千载犹当不朽。\n待辟国、清边取封侯，看肘后、黄金印悬如斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其五 咏金林檎","author":"丘崇","text":"丰肌腻体，雅淡仍娇贵。\n不与群芳竞姝丽。\n向琼林珠殿，独占春风，仙仗里，曾奉三宫燕喜。\n低回如有恨，失意含羞，乐事繁华竟谁记。\n应怜我，空老去，无句酬伊，吟未就，不觉东风又起。\n镇独立黄昏怯轻寒，这情绪、年年共花憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其二 辛卯嘉禾元夕作","author":"丘崇","text":"江城梅柳，惯得春先处。\n催趁风光上歌舞。\n见九衢、车马流水如龙，喧笑语，罗绮香尘载路。\n欢娱多暇日，尊俎风流，重见承平旧官府。\n有多少、佳丽事，堕珥遗簪，芳径里，瑟瑟珠玑翠羽。\n好惜取、韶华醉连宵，更莫待、收灯酒阑人去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其三 元宵词","author":"丘崇","text":"□□春□，□画□□处。\n十里红莲照歌舞。\n望鳌山天际，宝篆翻空，看未了，涌出珠宫贝宇。\n锦江桥那畔，罗绮重重，曲巷深坊暗香度。\n玉相辉，花并艳，明月随人，归去也，零落珠玑翠羽。\n先如许、风光更元宵，算却好、图将凤城夸去。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其四 庚申乐净锦棠盛开作","author":"丘崇","text":"花中尤物，欲赋无佳句。\n深染燕脂浅含露。\n被春寒无赖，不放全开，才半吐，翻与留连妙处。\n人间称绝色，倾国倾城，试问太真似花否。\n最娉婷，偏艳冶，百媚千娇，谁道许，须要能歌解舞。\n算费尽、春工到开时，甚却付、连宵等闲风雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"丘崇","text":"花落花开，等闲不管流年度。\n旧游何处。\n浅立空凝伫。\n惊拍栏干，忍见春将暮。\n凭风絮。\n为人飞去。\n散作愁无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台/祝英台近 成都牡丹会","author":"丘崇","text":"聚春工，开绝艳，天巧信无比。\n旧日京华，应也只如此。\n等闲一尺娇红，燕脂微点，宛然印、昭阳玉指。\n最好是。\n乐岁台府官闲，风流剩欢意。\n痛饮连宵，花也为人醉。\n可堪银烛烧残，红妆归去，任春在、宝钗云髻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 迎春日作","author":"丘崇","text":"胜子幡儿袅鬓云。\n钗头绝唱旧曾闻。\n江城喜见又班春。\n拂柳和风初有信，欺梅残雪已无痕。\n只应笑语作春温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 即席和徐守元宵","author":"丘崇","text":"铁锁星桥永夜通。\n万家帘幕度香风。\n俊游人在笑声中。\n罗绮十行眉黛绿，银花千炬簇莲红。\n座中争看黑头公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 朱都大和荆州作，次韵谢之","author":"丘崇","text":"潇洒五湖仙。\n踏遍尘寰。\n吟哦长忆两松闲。\n邂逅天涯还一笑，璧合珠连。\n风采照衰残。\n妙语冷然。\n妓围香暖簇金蝉。\n端为故人情未减，醉玉颓山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅弄影","author":"丘崇","text":"雨晴风定。\n一任春寒逞。\n要勒群芳未醒。\n不废梅花，晚来妆面靓。\n曲阑斜凭。\n水槛临清镜。\n翠竹萧骚相映。\n付与幽人，巡池看弄影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 甲午秋作","author":"丘崇","text":"秋声夜到秋香院。\n重帘试卷都开遍。\n只似旧时香。\n更添些子黄。\n绮窗人共赋。\n犹忆分香句。\n别后几回秋。\n见花空复愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三 次朱都大韵送王漕行","author":"丘崇","text":"云林带水山横阁。\n故人去尽添萧索。\n反照射微茫。\n临分愁夕阳。\n传柑当令节。\n连璧朝天阙。\n还有雁西飞。\n慰人新别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 再登赏心用林子长韵","author":"丘崇","text":"壶边击断歌无节。\n山川一带伤情切。\n依旧石头城。\n夕阳天外明。\n行人谁是侣。\n遗唱今何许。\n对酒转愁多。\n愁多奈酒何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其四 为尤郎中延之寿","author":"丘崇","text":"花雨润。\n烟锁玉炉香韵。\n笑度华年春不尽。\n寿觞寒食近。\n甲子才周一瞬。\n争羡朱颜青鬓。\n咫尺朝元仙路稳。\n碧云新有信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其三","author":"丘崇","text":"罗袖薄。\n玉臂镂花金约。\n起晚欠伸莲步弱。\n倚床娇韵恶。\n独自青楼珠箔。\n怎向日长花落。\n门掩东风春寂寞。\n误人瞋喜鹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其二 为韩漕无咎寿","author":"丘崇","text":"槐阴绿。\n帘卷翠屏山曲。\n照眼冰壶寒并玉。\n赐衣便雾縠。\n熊梦又惊初卜。\n好在掖垣梧竹。\n应讶人归犹未速。\n已颁新诏墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其一 送林子长同年起官宣城","author":"丘崇","text":"风又雨。\n吹面落花红舞。\n把酒不禁春思苦。\n别离闻杜宇。\n叠嶂楼头佳处。\n犹想襞笺容与。\n思入云山便好语。\n莫辞频寄取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄河清 为史帅寿","author":"丘崇","text":"鼓角清雄占云祲。\n喜边尘、今度还静。\n一线乍添，长觉皇州日永。\n楼外崇牙影转，拥千骑、欢声万井。\n太平官府人初见，梦熊三占佳景。\n皇恩夜出天闱，云章粲、凤鸾飞动相映。\n宝带万钉，与作今朝佳庆。\n勋业如斯得也，况整顿、江淮大定。\n这回恰好，归朝去、共调金鼎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其三","author":"丘崇","text":"尊前宾主角多才。\n亦许我同来。\n诗思竞翻三峡，酒狂欲拗连台。\n身闲有限，莫辞光景，刻烛相催。\n沙路即看联辔，上林趁赏流杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其二","author":"丘崇","text":"几回相与叹高才。\n忽报驭风来。\n谁道亟朝天阙，更能同上春台。\n主人早晚，班联玉笋，行听连催。\n湖上饱赓新唱，思堂快泻深杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一 绍兴未太学作","author":"丘崇","text":"晚风斜日折梅花。\n楼外卷残霞。\n领略一城春气，华灯十万人家。\n轻衫短帽，风前趁马，月下随车。\n道个小来脚定，那人笑隔笼纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"愁倚阑/春光好 丙申重九和钱守","author":"丘崇","text":"风雨骤，妒花黄。\n忽斜阳。\n急手打开君会否，是伊凉。\n深深密密传觞。\n似差胜、落帽清狂。\n满引休辞还醉倒，却何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 庚申为大儿寿","author":"丘崇","text":"时节近中秋，桂花天气。\n忆得熊罴梦呈瑞。\n向来三度，恨被一官萦系。\n今朝称寿，也休辞醉。\n斑衣戏彩，薄罗初试。\n华发双亲剩欢喜。\n功名荣贵，未要匆匆深计。\n一杯先要祝，千百岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其五 渚宫怀古即事，用二干韵","author":"丘崇","text":"楚甸云收，歌舞地、依然江渚。\n嗟往事、豪华无限，梦回何许。\n翠被那知思玉度，绣袿谩说为行雨。\n悄不禁、俯仰一凄凉，成千古。\n吴蜀会，襟喉处。\n据胜势，开天府。\n著诗书元帅，谈笑尊俎。\n步障月明翻鼓吹，华榱雾湿披窗户。\n把胜游、都与旧风光，湔尘土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其四 余以词为石湖寿，胡长文见和，复用韵谢之","author":"丘崇","text":"冠盖吴中，羡来往、风流二老。\n谈笑处、清风满座，倡酬不了。\n琪树相鲜昆阆里，玉山高并云烟表。\n叹□时、顿有古来无，功名早。\n膺帝眷，符梦兆。\n为国镇，腾光耀。\n更宁容秀野，醉眠清晓。\n麟组已联方面重，衮衣行接天香绕。\n许畸人、巾履奉英游，荣多少。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其三 和范石湖","author":"丘崇","text":"十载重游，愧好在、吴中父老。\n官事里、空然痴绝，竟何曾了。\n赖有平生知己地，全胜末路依刘表。\n竟此身、还复雁门踦，宁论早。\n蓬仙语，开朕兆。\n郇翰洒，增荣耀。\n倚先声风动，了然家晓。\n翘馆每烦尘想□，宾筵更著红妆绕。\n算从前、得此慰初心，于人少。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其一","author":"丘崇","text":"驻马江头，聊自放、尘劳踪迹。\n身渐老、尊前羞见，异乡风物。\n雪柳垂金幡胜小，钗头又报春消息。\n记去年、持酒觅新词，人疏隔。\n时序好，今犹昔。\n携赏处，空追忆。\n都如梦才觉，悄然难觅。\n且饮不须论许事，从今煞有佳天色。\n但官闲、有酒便嬉游，愁无益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 其六 癸亥九日","author":"丘崇","text":"平楚苍然，烟霭外、飞鸿冥灭。\n身老矣、登临感慨，几时当彻。\n痛饮从教吹帽落，悲歌莫击壶边缺。\n算人生、任运复何为，伤情切。\n功名事，休谩说。\n渠有命，谁工拙。\n且随宜斗健，强酬佳节。\n九节从今知几度，试看镜里头如雪。\n向醉中、赢取万缘空，真蝉脱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 为叶总领寿","author":"丘崇","text":"风传芳信，晓色便清霁。\n帘幕护春寒，篆香温、笙簧韵美。\n使华容与，星动帝王州，花上脸，柳边眉，竞报占熊喜。\n欢娱好是，玉塞无尘起。\n鞭计小迟留，要长折、遐冲万里。\n传闻有诏，宣室待归来，醽醁满，叵罗深，莫负春葱指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦帐春 己未孟冬乐净见梅英作","author":"丘崇","text":"翠竹如屏，浅山如画。\n小池面、危桥一跨。\n著棕亭临水，宛然郊野。\n竹篱茅舍。\n好是天寒，倍添幽雅。\n正雪意、垂垂欲下。\n更朦胧月影，弄明初夜。\n梅花动也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 为钱守寿","author":"丘崇","text":"梅子著花当献寿。\n得得天工，有意还知否。\n教在岁寒霜雪后。\n长年不羡松筠茂。\n莫厌杯深歌舞奏。\n约略丝纶，正是来时候。\n富贵明年公自有。\n天香宫烛黄封酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二 送岳明州","author":"丘崇","text":"鼓吹东方天欲晓。\n打彻伊州，梅柳都开了。\n尽道鄞江春许早。\n使君未到春先到。\n号令只凭花信报。\n旗垒精明，家世临淮妙。\n遥想明年元夕好。\n玉人更著华灯照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三 西堂竹阁，日气温然，戏作","author":"丘崇","text":"逼砌筠窗围小院。\n日照花枝，疏影重重见。\n金鸭无风香自暖。\n腊寒才比春寒浅。\n昼景温温烘笔砚。\n闲把安西，六纸都临遍。\n茗碗不禁幽梦远。\n鹊来唤起斜阳晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 木犀","author":"丘崇","text":"碧玉槎丫金粟小。\n山路惊秋老。\n倒倚湿寒烟，似怯秋风，阁泪啼清晓。\n铜壶冷浸宜深窈。\n人试新妆巧。\n云鬓一枝斜，小阁幽窗，是处都香了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其五 咏绿荔枝","author":"丘崇","text":"玳瑁筵中见绿珠。\n淡然高韵胜施朱。\n揉兰雾縠蔷薇浅，半露冰肌玉不如。\n餐秀色，味肤腴。\n轻红端合与为奴。\n只愁宴罢翻成恨，赢得偏怜不似初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四 采莲曲","author":"丘崇","text":"两两维舟近柳堤。\n菱歌迤逦过前溪。\n曲中自诉衷肠事，岸上行人那得知。\n金齿屐，翠云篦。\n女萝为带蕙为衣。\n惜花贪折归时晚，急桨相呼入翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 和严倅二秦同集席上赋","author":"丘崇","text":"怀抱瑰奇懒叩阍。\n朝阳独赋远人村。\n即看飞下芝封诏，会见趣归金马门。\n今夕饮，拼濡裙。\n一时尊俎尽诗人。\n唯馀阿买真才劣，醉后犹能写八分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"丘崇","text":"陆海蓬壶自有山。\n光风霁月未应悭。\n但将歌舞酬佳节，却信阴晴是等闲。\n花照夜，烛烘盘。\n明年公更酒肠宽。\n奉陪黄伞传柑宴，莫忘红妆拥座欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三 乙未钱守登君山","author":"丘崇","text":"准拟关门度一秋。\n强扶衰病起相酬。\n不辞酩酊还吹帽，自笑鬅鬙怯露头。\n江日晚，更迟留。\n争传五马足风流。\n论车载酒浑闲事，著笼藏花说未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下洞","author":"丘葵","text":"天香亭下影婆娑，四畔高林结绿萝。\n云外飞仙不曾见，唯应翠树阅人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月初二日作","author":"丘葵","text":"万古青天万古山，颓然形气太虚间。\n氤氲开门无穷妙，只见飞云日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太阳 其一","author":"丘葵","text":"太阳一入地，亦足蒸成霞。\n老学傥能勉，声绩岂不华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太阳 其三","author":"丘葵","text":"太阳一入地，照月还生光。\n老学傥能勉，缮性岂不臧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山闻钟亭","author":"丘葵","text":"晓来草木自澄鲜，不到山中又五年。\n惆怅闻钟人不见，空馀古木锁寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归憩涧亭桥","author":"丘葵","text":"雨后溪流深更深，倚栏照见一生心。\n青山只在桥南北，枉自穿云渡水寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永宁庵","author":"丘葵","text":"路入永宁方午阴，禅师聊复坐沉吟。\n欲将门外葫芦水，倒作田间三日霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"丘葵","text":"万古有条平坦路，东西南北甚分明。\n世间多少惺惺汉，尽向荆榛里面行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次欧阳少逸韵呈雪庭禅师 其三","author":"丘葵","text":"瓶花故故透禅房，师自无心花自香。\n客散夜深归定里，白生虚室月无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次欧阳少逸韵呈雪庭禅师 其一","author":"丘葵","text":"蘋婆影镂日华明，照见枝头果已成。\n却是南风有吟思，时将万叶作秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次欧阳少逸韵呈雪庭禅师 其二","author":"丘葵","text":"吟得秋声满院凉，不知六月有骄阳。\n禅心已是空诸相，无奈瓶花故故香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百丈石","author":"丘葵","text":"北风吹我过峥嵘，片石中间水一泓。\n世事由来总如此，枉教辛苦为虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老学忽有所得","author":"丘葵","text":"刊落閒枝叶，推寻到本根。\n始知酬酢处，无地不乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芝山","author":"丘葵","text":"床头枕是溪中石，井底泉通竹下池。\n宿客不还过鸟语，独闻山雨对花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晦庵启蒙韵","author":"丘葵","text":"有人见得地中雷，三十六宫从此回。\n尽太虚中俱是易，底须龙马负图来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]