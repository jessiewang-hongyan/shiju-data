[{"title":"送楼致和归四明","author":"吴惟信","text":"长安尘土处，数日又随君。\n颇讶归何速，犹胜信不闻。\n寒霜杀岸柳，晓艇入江云。\n无语各回首，离愁落叶分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上卜君寿省元","author":"吴惟信","text":"沉香亭北何时去，饭颗山前瘦一生。\n已悟本心元有道，可能浮世便无名。\n江梅索笑何郎句，秋菊餐英楚客情。\n天意未教头白尽，合应留取短长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿吴平江","author":"吴惟信","text":"宽闲中立大规模，民亦相随入正途。\n爱物只凭心造化，养生无出定工夫。\n山移别圃新花木，鹤立闲厅古画图。\n印匣不开公事少，一帘春雨梦江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈蒙斋","author":"吴惟信","text":"出处真麟凤，诗书得正传。\n仁心全造化，风骨半神仙。\n门柳摇春雨，庭花锁暮烟。\n云台非隐地，即日帝王宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上湖守赵希苍 其一","author":"吴惟信","text":"方今选牧匪为轻，果见名邦付老成。\n白发益坚忧国念，丹心常蕴爱君诚。\n月迁花影尨无吠，风舞棠阴鹤自行。\n看著碧澜堂下水，与君政事一般清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上湖守赵希苍 其二","author":"吴惟信","text":"德大才优世所宗，汉唐诸老莫如公。\n高明正直行王事，耿介清廉继父风。\n六邑人居条教内，万家春出笑谈中。\n即看诏促归清禁，手把梅花马首东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上高疏寮处州守","author":"吴惟信","text":"神仙来守神仙地，铭石庭空画戟森。\n道接圣贤韩愈学，诗关风教杜陵心。\n二年鼓角传清调，万古溪山得赏音。\n即有诏书催入觐，金莲夜草玉堂深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈岳总卿","author":"吴惟信","text":"黄尘漠漠路漫漫，旧钓空思水国寒。\n乡信不来云树远，斜阳无语下栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伤春","author":"吴惟信","text":"白发伤春又一年，閒将心事卜金钱。\n梨花瘦尽东风软，商略平生到杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上留田","author":"严羽","text":"天地一何长久，上留田。\n人老一去无归，上留田。\n松柏一何累累，上留田。\n劝君酒樽金罍，上留田。\n愿君大家蚕桑，上留田。\n有丝织作衲裆，上留田。\n无为多忧烦伤，上留田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日书怀","author":"姚镛","text":"柔风散原野，百草摇春心。\n丛薄曜阳彩，嘤鸣调好音。\n节物一以变，万感集素襟。\n玄发不常居，华景无停阴。\n胡为苦贫贱，征尘翳瑶簪。\n萱叶覆堂阶，荆花感晴林。\n明当理星驾，归息清溪浔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗","author":"姚镛","text":"北风日以劲，古道无人行。\n阳坡树已黄，阴崖草犹青。\n四时相代谢，谁为此枯荣。\n揽衣坐幽磴，下有流泉声。\n听之不成调，挹之有馀清。\n悠悠京洛尘，污人头上缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春馆","author":"姚镛","text":"山馆四无邻，东风伴幽寂。\n瓶花羞晚红，庭草衒春碧。\n猿攀松树枝，鹤踏苍苔色。\n麾之不肯去，听读麻衣易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见赵章泉","author":"姚镛","text":"秉芳独向章泉老，四海儿童以字传。\n特诏难更高士服，好诗多入贾人船。\n行窝冷落熙宁后，放鹤风流景祐前。\n一代典刑能几见，愿从几杖阅耆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见袁蒙斋","author":"姚镛","text":"书说曾传到剡中，不图今见古人风。\n间生伊洛二三子，安得龚黄十数公。\n仁性未尝离日用，道心元自与人同。\n絜斋衣钵慈湖学，愿发精微一启蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄径山敬溪翁","author":"姚镛","text":"心远人间世，灯传国一禅。\n静中无剧暑，诗外总闲年。\n挂锡云生树，烹茶月落泉。\n几时归去得，再约剡溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拜先君墓","author":"姚镛","text":"次第瞻山看水流，夜台中閟忆三秋。\n新松成行如人长，老鹤无言似我愁。\n僧奉晨昏惟茗供，儿悲霜露只蘋羞。\n结庐终岁关心事，怊怅钟声出暝楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送晔冲晦归天竺","author":"姚镛","text":"西湖山下多奇石，师去今游乳窦峰。\n遥想石台登讲罢，野猿归洞鹤归松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓霅川","author":"姚镛","text":"王戴溪头小隐仙，渔翁引上霅溪船。\n几回倦钓思归去，又为蘋花住一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春夜曲","author":"姚镛","text":"金鱼锁合兰缸小，酒不支愁寻睡早。\n梨花欲堕风更寒，燕子不归春自老。\n流苏护帐香云结，三十六簧清吹咽。\n缄书欲寄湘水深，城乌啼落花西川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜发渔浦","author":"姚镛","text":"为亲从薄宦，不复计脩程。\n断浦迎潮别，孤帆带月行。\n秋来江柳变，夜久水烟生。\n前路犹淹泊，凄其赋远征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐庐道中","author":"姚镛","text":"两岸山如簇，中流锁翠微。\n风帆逆水上，江鹤背人飞。\n野庙青枫树，人家白板扉。\n严陵台下过，不敢浣尘衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"头陀庵","author":"姚镛","text":"衣缁发可梳，云外卓庵居。\n佛换新花供，幡拈古偈书。\n删松容径竹，种茗间园蔬。\n为应诸方供，山房尽日虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出山","author":"姚镛","text":"云阴漠漠雨潇潇，坐兀归舆野兴遥。\n石涧水流苔路滑，竹篱秋去菊花焦。\n谁将束缊求山火，自立寒溪问板桥。\n官事奔奔何日了，倚松临水羡渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画壁","author":"姚镛","text":"两山灌木带晴鸦，泯泯春流漾浦沙。\n隔岸小舟呼不应，碧桃花外是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄范中洲","author":"姚镛","text":"高隐就诗名，中洲雅趣成。\n几前脩竹净，屋上落泉鸣。\n柘圃春风织，山田野火耕。\n满山薇蕨老，客至足蔬萌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庙","author":"姚镛","text":"未知何王庙，岁月日已非。\n熏炉松柏煤，画壁苔藓衣。\n门空牧竖戏，树老山魈依。\n田家社酒香，纸窖生光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀范正夫","author":"姚镛","text":"愁霖滴禾黍，秋暮滞云庄。\n但虑输井税，不忧无积仓。\n竹鸡啼野堑，饥鼠走山房。\n不饮论文酒，思君觉夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿护国寺观晦翁先生题名 其一","author":"姚镛","text":"满树棕花满径松，解鞍才是暝楼钟。\n上方月白山云静，看见东南一两峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿护国寺观晦翁先生题名 其二","author":"姚镛","text":"看了题名看跋文，自怜不及晦翁门。\n野僧惜打残碑卖，时共山猿洗墨痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄冲晦","author":"姚镛","text":"欲答前春信，西飞雁不逢。\n应随丹灶鹤，同看白云松。\n花雨翻经石，山鸣出定钟。\n何时寻旧住，却说武夷峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赁宅","author":"姚镛","text":"及春游帝里，赁宅似吾家。\n雨霤生新草，风床受落花。\n病多添老懒，虑澹远纷华。\n时与幽人遇，烧香煮茗芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼复石壁","author":"姚镛","text":"一死虽如蜕，杀身真可哀。\n僧危能仗义，诗好更多才。\n鹤怨兰亭月，云消石壁苔。\n旧时同社友，寂寞载书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧","author":"姚镛","text":"去结茅堂霅水边，晓行持钵落花天。\n得钱未用栽松本，先买溪南旧石田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王别驾访天竺颐晔二师","author":"姚镛","text":"宝香熏彻碧莲台，别驾寻僧日暮回。\n听雨斋前惊树长，浴云池上看花开。\n青山久不逢坡老，玄鹤亲曾识辨才。\n二老风流如昨日，百年诗石未苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐陵赠异孤峰","author":"姚镛","text":"几度云间望鹤飞，相逢犹喜及秋期。\n明朝采药青原洞，好掬寒泉供祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄刘敏叔","author":"姚镛","text":"一生贫乐鬓成丝，前辈风流及见之。\n道外无营偏爱画，静中有趣只吟诗。\n云生茅屋湖山近，秋满荒园橘柚垂。\n见说地幽人罕到，自同妻子种江蓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自青原回访敏叔几不相遇","author":"姚镛","text":"晓汲三泉洗砚回，要看奇石立苍苔。\n骑驴应为寻诗出，放鹤还知有客来。\n一井清寒宜茗饮，千林黄落独梅开。\n他时老圃如能学，只乞山中橘本栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵东野时以帅檄抚定赣叛 其一","author":"姚镛","text":"东野山人有晋风，归来三径自栽松。\n锦囊句好闲中趣，铅鼎丹成静处功。\n无事杖藜随野鹤，有时隐几看晴峰。\n长江近日风波恶，莫向深渊下钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵东野时以帅檄抚定赣叛 其二","author":"姚镛","text":"清晨闲上郁孤台，鼓咽谯楼角更哀。\n病叶满山难独扫，狂花一树为谁开。\n泉枯石井狮空吼，雨暗荒池凤不来。\n欲向江东问仙老，海风吹浪驾舟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赣士谒前赣侯杨东山","author":"姚镛","text":"凝香句满空同石，静向东山卧白云。\n夫子自能明易学，众人谁解识玄文。\n空江短棹浮诗卷，别岸飞花扑练裙。\n到得带园春已过，煮茶应共竹间分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东山赠何青霞诗后","author":"姚镛","text":"青霞道士来相见，手阅东山诗一卷。\n句里明知山水心，笔端照见烟霞面。\n昨宵梦上寥阳殿，仙官敕作青霞传。\n传成不及卷中诗，罚读灵歌三百遍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午兴","author":"姚镛","text":"心闲日日理黄庭，四体和柔胜药灵。\n独步小轩无一事，老槐阴里鹤梳翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风","author":"姚镛","text":"颢气薄衣襟，疏声集暝林。\n雁惊烟塞梦，鲈入故乡心。\n静落阶前叶，清传月下砧。\n更怜茅屋破，愁绝少陵吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧孤峰","author":"姚镛","text":"分得西林云满巢，瓣香端为远公烧。\n阿兄不解陶潜饮，只倚山中水一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠孤峰","author":"姚镛","text":"拄杖寻幽古寺中，云容淡淡雨濛濛。\n归来一笑春多事，野杏山桃各自红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆孤峰","author":"姚镛","text":"浮杯方渡湘江上，又逐孤云到岳前。\n七十二峰烟雨夜，与谁同话懒残禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题孤峰房","author":"姚镛","text":"云木阴森天气清，杜鹃啼了又啼莺。\n幽人午枕不成梦，忆得故山春树生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟松泉","author":"姚镛","text":"未让葛洪丹井灵，石根流水更清泠。\n多年不见仙桃出，化作老松生茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别毛沧洲","author":"姚镛","text":"风雨三更梦，江湖万里心。\n青灯正愁绝，可惜不能琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放船","author":"姚镛","text":"数幅蒲帆破晓烟，一篙春水涨平川。\n谁家池馆多杨柳，时送飞花到客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题衡岳","author":"姚镛","text":"万山环拱祝融尊，紫盖前趋若骏奔。\n火德中天扶日月，炎方一柱镇乾坤。\n久无执贽来侯牧，空有穹碑立庙门。\n北望中原青一发，凄其四岳正尘昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离衡","author":"姚镛","text":"天恩下释湘累客，心事悠悠月满船。\n种药已收思病日，著书不就负残年。\n杂花怪石分人去，老竹荒亭入画传。\n归梦鉴湖三百里，白鸥相候亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"法华寺","author":"姚镛","text":"入门松径幽，树杪见钟楼。\n客至犬迎吠，香消僧出游。\n水花迎晚照，风叶引凉秋。\n欲作居山计，吾盟在白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出游","author":"姚镛","text":"春来日日风兼雨，今日晴明试杖藜。\n闭户不知花信过，野桃开了到棠梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗宪北林预脩禊事","author":"姚镛","text":"玉节先期泛禊川，携壶与客上楼船。\n江亭野寺山山好，梅子樱桃树树圆。\n看竹静行松下道，瀹茶寒汲石根泉。\n清游尽日惟觞咏，不学兰亭悦管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠相者","author":"姚镛","text":"眼白骨多屯，还能阅世人。\n空灵三寸舌，不疗一生贫。\n岁晚离骚国，天涯放逐臣。\n相过话人物，京洛尚风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送上超古还径山","author":"姚镛","text":"相见忽秋初，言诗足起予。\n身虽披坏衲，手未释群书。\n双径云多润，诸山木易疏。\n此心超万古，禅诵特其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿枢使","author":"姚镛","text":"崧岳重生再及申，望馀两日正青春。\n熊罴五十年前梦，龟鹤三千岁后身。\n故地寂无南牧马，桂枝新有北归人。\n黄封赐酒堪为寿，愿颂庄周上古椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"姚镛","text":"痴云蔽岳行人远，淫雨摧花白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"姚镛","text":"万里寻迁客，三年见此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"积雨叹","author":"张侃","text":"去年南兰陵，官河无流澌。\n阴云久不见，万里行炎曦。\n太守为民祷，百拜躬愈祗。\n忽然动凉飙，骤雨肆奔驰。\n旱苗有生意，下民免寒饥。\n感格在俄顷，嗟人自不为。\n颂语我欲作，垂世同曹规。\n深恐旁观者，凭藉立是非。\n反谓地势隆，水散及四支。\n纵使雨入尺，立待只片时。\n今年芒种后，有雨细如丝。\n农家买五兆，寸波成涟漪。\n我耳曾听得，把笔纪小诗。\n又传练湖圯，澒洞南北迷。\n浸淫到旁邑，原隰不分畸。\n秋中月色皎，老晴颇相宜。\n深谷传地籁，乔松难扶持。\n滂流尽三日，处处同一辞。\n化工有至理，浅眼休蠡窥。\n蝝蝝可怜生，短衣到凫茈。\n冬寒与夏暑，平日何怨咨。\n一旦示灾咎，反己深思惟。\n退寸望求尺，龠合规微赀。\n丰艰非逆料，人情恣生疑。\n既忻堆如栉，复话禾无䅗。\n遂致阴阳转，未免水旱移。\n固穷不羡富，求足翻成亏。\n不知尼父言，三年积铢锱。\n一稃与二米，犹胜糠覈肥。\n农家多守分，富家当坦夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋后一日书所见者","author":"张侃","text":"秋深山转清，雨定水自绿。\n庭前牵牛花，粲粲悦人目。\n居官已年馀，竟日书吏牍。\n因閒窥化工，景象不一足。\n促织汝何为，懒妇丝断续。\n夜长清未眠，题诗烧短烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红塔","author":"张侃","text":"出门看青山，天际晴云合。\n虬松植长涂，亭亭两红塔。\n谁知百年后，竟坐市尘杂。\n老僧随世机，电眸阅伏腊。\n流水洗不尽，就下污流纳。\n北窗稍幽虚，清风满眠榻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观海","author":"张侃","text":"孔圣道不行，乘桴浮于海。\n非子深寓言，诚欲警不逮。\n我生游江湖，舟汎听自在。\n有时月初生，满天云去叆。\n今朝到海边，潮迟立可待。\n固知源脉长，下藏鱼龙队。\n想见景晴明，间亦露光彩。\n因尔观自然，天地能主宰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨","author":"张侃","text":"今日天欲雨，农家名分龙。\n雨意或羞涩，沾润限西东。\n入夏雨已多，颇觉支体慵。\n轻烟苒苒绿，夕照微微红。\n不奈勃姑语，呼雨云满空。\n乍晴丝捲轴，复闇花无踪。\n良辰偶孤负，土脉方丰融。\n屈指是新秋，细听邻杵舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬夜对月","author":"张侃","text":"秋来月渐清，老火犹未退。\n好风送新凉，云深复昏晦。\n徐思此夜满，岂不令人爱。\n暑气薄前荣，蒸溽肯少贷。\n月色到芳池，缘此亦拘碍。\n今宵坐中庭，挥麈成独对。\n霜华杂月色，顿然清病肺。\n何必泥中秋，此语吾永佩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]