[{"title":"偈颂一百四十一首 其五十四","author":"释师范","text":"本色行脚人，须具行脚眼。\n千个与万个，多是空檐版。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十三","author":"释师范","text":"一冬二冬，你侬我侬。\n暗中偷笑，当面脱空。\n虽是寻常茶饭，谁知米里有虫。\n岂不见南泉道夜来好风，吹折门前一枝松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十二","author":"释师范","text":"八月十五，月圆当户。\n夜半正明，天晓不露。\n取个眼兮耳必聋，舍个耳兮目必瞽。\n君不见老长沙弄爪牙，一踏踏倒小释迦。\n将谓是个老大虫，元来却是一只虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十二","author":"释师范","text":"天上星，地下木。\n见便见，休□速。\n老瞿昙，空捏目。\n三七日，心返复。\n从此拿空便脱空，天上人间遍流毒。\n带累儿孙直至今，医得耳聋成瞎秃。\n鄮峰虽与同路行，却不与他同处宿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一五","author":"释师范","text":"今朝八月二十五，记得洞山离查渡。\n韶石山头打不回，追至如今无本据。\n问佛便答麻三斤，何似庭前柏树子。\n苍鹰搦卧兔，猫儿捉老鼠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十六","author":"释师范","text":"二月复二月，韶光尚可留。\n雪消深涧底，花发旧枝头。\n万木寒威解，千峰翠色浮。\n有谁知此意，相共倚危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十五","author":"释师范","text":"云收雾敛，地辟天开。\n处处弥勒，门门善财。\n安得真男子，同上黄金台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十二","author":"释师范","text":"世人住处我不住，世人行处我不行。\n天下丛林今日开炉，诸方老冻侬声鼓集众。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七十一","author":"释师范","text":"指月与话月，檐雪共填井。\n玩月与捧月，未免弄光影。\n月聻彷佛似盐官扇子，元来恰是云门胡饼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十九","author":"释师范","text":"烧香草舍蚊烟，礼拜小儿匍匐。\n杨歧顶上握拳，何似镇州萝卜。\n噫，有年无德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十五","author":"释师范","text":"旧年佛法，说到腊月极尽头。\n新年佛法，又从正月还起头。\n若论起头与极头，都卢只在拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十二","author":"释师范","text":"五峰门下，百种全无。\n僧床迫窄，堂供萧疏。\n脚下踏著底，破砖头碎瓦砾。\n面前撞见底，王獦獠李麻胡。\n恁么薄福住山，真个辜负老胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其六十一","author":"释师范","text":"天清地宁，庆袭一人。\n九州四海，咸被尧仁。\n熙熙然涵泳化育，犹千花万卉之逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十九","author":"释师范","text":"重岩风露清，深院霜天晓。\n一曲少林春，几人弹得妙。\n自古弹者希，亦复听者少。\n以之赠伯牙，伯牙不肯要。\n以之献子期，子期拍手笑。\n休休，不如留取自弹一曲，何似大石调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十八","author":"释师范","text":"去年不在家，虚过重阳节。\n今年既在家，须要强施设。\n淡水煮冬瓜，真个滋味别。\n不知滋味者，却似嚼生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十七","author":"释师范","text":"万籁沉沉，孤月团团。\n叶零零兮山瘦，风萧萧兮夜寒，不知谁共倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十四","author":"释师范","text":"径山门下，无彼无我。\n大家叠足挨肩，共向无烟宿火。\n若是香匙火箸，不得动著。\n不见道丹霞烧木佛，院主眉须堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十三","author":"释师范","text":"达磨西来，添盐减酱。\n后代儿孙，千般万样。\n谁信棋盘石，元在凌霄上。\n山僧恁么道，已是龟毛长数丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十二","author":"释师范","text":"现成公案，何事不办。\n百发百中，无边无畔。\n捏不聚，拨不散。\n万籁俱沉兮明月半窗，一色难分兮芦花两岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十一","author":"释师范","text":"径山无伎俩，住院多阻障。\n饭在平江府，口在凌霄上。\n河港既不通，千里空相望。\n暂假维摩手，一钵共分饷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五十","author":"释师范","text":"一年十二月，月月有月半。\n何独喜中秋，一时争赏玩。\n人人尽道十分圆，我道依前缺一半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十九","author":"释师范","text":"雪峰辊毬，睦州担版。\n杨歧栗棘蓬，东山铁酸馅。\n多处添，少处减，留得翠岩眉毛盖眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十八","author":"释师范","text":"径山结夏，不论功过。\n饭来展钵盂，困则伸脚卧。\n纵有千人万人，只消一个半个。\n岂不见流支要打胡达磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十七","author":"释师范","text":"雪峰发九重圣箭，谁敢当锋。\n三圣跃透网金麟，应无杂食。\n要明那畔事，须是这边人。\n三家村里，闹市丛中。\n妙应无私，临机有准。\n不是冤家不与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十五","author":"释师范","text":"昨日九月九，过了重阳节。\n今日忆重阳，升堂何可说。\n拟欲问黄花，黄花虽有在东篱。\n拟欲问白醪，白醪虽有非我知。\n不如一时放下衲被幪头，从教门外风飕飕，雨飕飕，幽州江口，采石渡头，三三两两钓渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十四","author":"释师范","text":"土宿颔下长髭须，净饭宫中生悉达。\n西天此土绝知音，千古万古阿剌剌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十二","author":"释师范","text":"才拟恁么，便不恁么。\n成现生涯，陈年滞货。\n雪峰辊出三个毬，?著嵩山破灶堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十一","author":"释师范","text":"雪山六年冻不死，一麻一麦饿不死。\n无端更道悟明星，跶倒至今扶不起。\n普贤蹙頞，文殊偷喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四十","author":"释师范","text":"孟冬薄寒，仲冬严寒。\n寒则普天普地寒，结成冰片，冻破泥团。\n达磨不会，大难大难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十八","author":"释师范","text":"恍恍惚惚，杳杳冥冥，非精非物，非佛非心。\n缺齿老胡得之而不识，飏在乎嵩山之阴。\n诸人还识得么，水上青青绿，元来是浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十六","author":"释师范","text":"衲僧家，无本据。\n动静去留，无非活路。\n进一步，临机没回互。\n退一步，声色如聋瞽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十五","author":"释师范","text":"天地之根，万物之主。\n大千无以居其尊，劫石难以并其固。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十二","author":"释师范","text":"千峰万峰浓泼眼，十溪五溪深没腰。\n只有山翁喜相接，声声惭愧与难消。\n且道还有所得也无，虾蟆口里一粒椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三十一","author":"释师范","text":"这个老冻侬，猛利如虎狼。\n威凛万壑风，眼摇百步光。\n我昔编其须，脱命于毫芒。\n至今数十载，毒恨不可忘。\n此世后世永永不愿见，临风誓此一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十九","author":"释师范","text":"径山今日结夏，不分上中下座。\n健则运瓦搬椽，困则横眠倒卧。\n谁管你孔夫子李老君胡达磨，善贾者不停死货。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十八","author":"释师范","text":"昔年当此日，生个老妖孽。\n殃害大地人，有屈无处雪。\n云门愤不甘，一棒要打杀。\n打不杀，至今年年有个四月八。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十五","author":"释师范","text":"杨歧设忌，做尽鬼怪。\n径山设忌，一无所解。\n随分淡淡薄薄，点一杯茶，烧一炷香，谩礼三拜。\n若谓报德酬恩，兔子吃牛奶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十四","author":"释师范","text":"数百禅和数十州，褴襂破衲面搊搜。\n诸方有道不肯学，甘共山僧拽木头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十三","author":"释师范","text":"指天指地，徒张意气。\n一棒打杀，更无巴鼻。\n径山今日都卢放过，且要一时脑门著地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十二","author":"释师范","text":"韶光去也谁能留，长江衮衮无暂休。\n人生既老不复少，此心未了空悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二十","author":"释师范","text":"六月火边坐，三冬水里走。\n怒中呈笑面，闹处伸毛手。\n满载没底船，归来重抖擞。\n抖擞个甚么，苏州有，常州有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十九","author":"释师范","text":"十五日以前，常在途中，不离家舍。\n十五日以后，常在家舍，不离途中。\n正当十五日，跛跛挈挈，百丑千拙。\n张都料，李作头，凿窍底凿窍，著楔底著楔。\n双径来来去去人，长安夜夜家家月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十五","author":"释师范","text":"七月八月，或凉或热。\n景色凄清，蝉声呜咽。\n观音菩萨将钱买胡饼，放下手却是馒头，韶阳老人得一橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十四","author":"释师范","text":"去时万木含愁色，归日千峰展笑容。\n此意此心知有自，一炉香爇散天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十二","author":"释师范","text":"劫灰飞尽见灵踪，突兀凌霄对五峰。\n意在目前谁共委，相同扶起旧家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其十一","author":"释师范","text":"万年石桥，三平石梁。\n总没交涉，恰恰相当。\n足陌见钱买卖，一毫不用商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其九","author":"释师范","text":"指天指地弄精魂，只为生来无脑门。\n韶石一棒打不杀，至今恩爱俱成冤。\n正当四月八，底事与谁论。\n门外千峰万峰啼断猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其八","author":"释师范","text":"不寒不热，好个时节。\n黄莺频织柳丝烟，子规犹哭松梢月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其七","author":"释师范","text":"同身共命，同气连枝。\n阿难合掌，迦叶扬眉。\n就中一句子，不许外人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其五","author":"释师范","text":"五峰门下，三个五个。\n衲被幪头，围炉打坐。\n鼻笑瞿昙，平欺达磨。\n又谁管你，张三李六。\n诸方炉鞴正炎炎，何似径山文武火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其四","author":"释师范","text":"初冬时节又相催，浩浩诸方炉鞴开。\n独有径山文武火，不知煨杀几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其三","author":"释师范","text":"去年底，今年底。\n辄莫明年更明年，年年只如是。\n黄花烂烂醉重阳，落叶萧萧愁满地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其二","author":"释师范","text":"天上无弥勒，人间无释迦。\n烧香礼拜谁，唵摩尼达哩吽㗶吒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十六首 其一","author":"释师范","text":"广大楼阁，门户不扃。\n了事衲僧，未行先到。\n且到后如何，眼不见为净。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十六","author":"释师范","text":"光景匆匆若逝川，旧年去了又新年。\n年来年去自来去，底事何曾有变迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十五","author":"释师范","text":"江南两浙，春寒秋热。\n尘沙劫事在如今，如今不异尘沙劫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十二","author":"释师范","text":"土木场中过两冬，朝匆匆兮暮匆匆。\n从来业识无凭据，说甚东山大脱空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十","author":"释师范","text":"旧岁今宵去，去去实不去。\n新年明日来，来来实不来。\n万古长空无变异，循环日月空相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其九","author":"释师范","text":"诸佛不出世，祖师不西来。\n颟顸一句子，南岳对天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其五","author":"释师范","text":"坐断主人翁，不落第二见。\n一念万年，万年一念。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其四","author":"释师范","text":"大地黑如漆，古今无消息。\n达磨老臊胡，九年空面壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其二","author":"释师范","text":"法无去来，无动转相。\n灯笼挂在露柱边，露柱挂在灯笼上。\n一年三百六十日，日日一般，一日十二时，时时一样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其一","author":"释师范","text":"二千年前，尺不如寸。\n二千年后，寸不如尺。\n清凉到这里，眼不见为净。\n只将三文钱，娶个黑老婆。\n长裙短袖，拖泥带水，隈隈??。\n且恁么过，更谁管你。\n结制解制，长期短期。\n杀生护生，得念失念。\n阿呵呵，少林穿耳客，元是老臊胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄云居掩室和尚 其二","author":"释师范","text":"几回梦到白云颠，欲往难禁懒病牵。\n何日相依倾倒夜，月寒千嶂一声猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄云居掩室和尚 其一","author":"释师范","text":"鹫峰云散霜天冷，南北东西片月孤。\n喜得江湖好消息，点胸尊者在云居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常不轻童子赞","author":"释师范","text":"作佛名何佛，不轻成自轻。\n谁知眼睛里，个个有瞳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常觉","author":"释师范","text":"暂时不在还同死，彻底惺惺亦自瞒。\n长爱东村老婆子，逢僧也解道和南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹山矩长老请赞","author":"释师范","text":"头圆象天，足方象地。\n耳朵闻声，鼻孔出气。\n马驹踏杀天下人，瞎驴不受灵山记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔妇观音赞 其二","author":"释师范","text":"篮内鱼，衣中珠。\n见买见卖，少实多虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩居士赞 其一","author":"释师范","text":"诈病从来不可医，文殊特为下针锥。\n事褫一啄长三尺，问著依前似鼓槌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲","author":"释师范","text":"横片竖片胡乱搭，长针短针信意联。\n但见日头东畔出，不知尘世是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]