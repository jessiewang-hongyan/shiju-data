[{"title":"挽郑令人二首 其二","author":"刘克庄","text":"宗伯中朝第一人，向来曾卜太初邻。\n凝香侯有孤高趣，拥絮翁馀老病身。\n嗟汝弃予宁返顾，祝公存我勿伤神。\n瑞云道远西风冷，想见斋居百岁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑令人二首 其一","author":"刘克庄","text":"乃翁自是里名儒，箴史遗言幼染濡。\n设馔礼如初作妇，貤封谊不忍先姑。\n色丝尤妙于前制，彤管从删以后无。\n一事可纾存没恨，即今丹穴有双雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑永福","author":"刘克庄","text":"竹间梧畔故应佳，非但才高诗亦葩。\n世胄蚤通枢相谱，里人知是大魁家。\n谁言陶令才为米，不遣潘郎再种花。\n□□云深华表远，北风无赖送哀笳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑判官","author":"刘克庄","text":"族谱康成裔，先儒谷叔孙。\n汉廷无表荐，鲁壁有书存。\n莲幕翻留滞，萱堂废凊温。\n吾衰惭宋玉，不解赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑贡士","author":"刘克庄","text":"少日鸣秋赋，中年读古书。\n宁游鲁侯泮，不诣汉公车。\n郑老先生行，申公八十馀。\n何妨凤雏小，玉润亢门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑参议","author":"刘克庄","text":"同榜飞腾尽，君初拜小侯。\n地寒推易去，天远借难留。\n新垄家山畔，生祠岭海头。\n历官如杜老，白首止参谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑郎公卫夫妇二首 其二","author":"刘克庄","text":"遗言传属纩，内则冠幽闺。\n刘尹真长妹，黔娄处士妻。\n鸾离暮年恨，鹤吊冻云迷。\n慧性无生灭，幡花导向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑郎公卫夫妇二首 其一","author":"刘克庄","text":"灯窗磨岁月，竹帛勒功名。\n晦迹溪西隐，终身谷口耕。\n似山犹有漏，于佛悟无生。\n尚喜家驹骏，何惭辅嗣甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑宣教","author":"刘克庄","text":"传嫡生枢府，耽书肖肯亭。\n未论禽拜后，姑喜鲤趋庭。\n葛帔悲交态，瑶环忆妙龄。\n吾无施力处，遗恨托于铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑淑人","author":"刘克庄","text":"忆在军中为记室，谢公门馆事皆知。\n谦卑若妇初嫔日，俭素犹夫未贵时。\n病了死生惟点首，晚忧家国每颦眉。\n旧人独有任安在，揽涕西风献些词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑甥主学二首 其二","author":"刘克庄","text":"亲则班□子，贤于辅嗣甥。\n奠刍终古诀，炊黍霎时荣。\n先墓身为殉，新丘手自营。\n老人尤惜泪，何况又偏盲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑甥主学二首 其一","author":"刘克庄","text":"北辙心犹锐，南廊策不迁。\n美芹干将相，采藻淑生徒。\n赋鵩方强仕，闻鸡漫壮图。\n未应精爽尽，丹穴有双雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑瑞州","author":"刘克庄","text":"召来未得久居中，麾去安知尚不容。\n虹卧雪涛怀旧惠，马跑白日掩新封。\n村边宅昔邻王翰，冢上碑今愧蔡邕。\n绿树青山总无恙，伤心杖履断过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南皋刘二先生 其一","author":"刘克庄","text":"久无羔雁聘遗贤，白首丘园气最全。\n聊与荆公续诗选，不闻谯叟入经筵。\n讲师翁庶几三昧，朴学余才说一篇。\n两侍细旃莫推挽，谀儒此愧若为湔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南皋刘二先生 其二","author":"刘克庄","text":"少时已诵水心铭，今息庵文可并行。\n椿算过如大君子，蒲轮莫致老先生。\n纵无掌故来传诏，盍有门人与易名。\n尝辱蓬山授经说，蟆陵道远一伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南雄林使君","author":"刘克庄","text":"东路归何及，南柯梦忽醒。\n居然鸣挽铎，都未制斋铃。\n官已题华表，名空录御屏。\n遥知泉下意，犹待竹溪铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南塘赵尚书二首 其二","author":"刘克庄","text":"自从水心死，麈柄独归公。\n于易疑程氏，惟诗取晦翁。\n二箴家有本，孤论世无同。\n不复重商榷，骑鲸浩渺中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南塘赵尚书二首 其一","author":"刘克庄","text":"起掌端平制，萧萧素发新。\n更生宗室老，太白谪仙人。\n贵矣狨施马，悲哉笔绝麟。\n谁为篆华表，题作宋词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽姚循州","author":"刘克庄","text":"太息龙川守，专城美绩传。\n方闻歌叔度，俄有谤文渊。\n旧府黄茅外，新丘紫帽边。\n二姚俱已矣，怀昔一悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽柯东海","author":"刘克庄","text":"不持寸铁霸斯文，畴昔曾将胆许君。\n撰出骚词奴宋玉，写成帖字婢羊欣。\n丧无归费人争赙，诗有高名虏亦闻。\n昨览埋铭增感怆，累累旧友去为坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽柳斋陈公四首 其四","author":"刘克庄","text":"受学龙图老，于今五十春。\n常为惊坐客，不比扫门人。\n荐我烦金口，酬公盍漆身。\n自怜双鬓秃，扶惫演恩新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽柳斋陈公四首 其三","author":"刘克庄","text":"昔有罴当道，今无雀可罗。\n慭遗公已矣，殄瘁国如何。\n末句拈花笑，前知曳杖歌。\n晚交惟赵子，曾作诔文么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽柳斋陈公四首 其二","author":"刘克庄","text":"已老乌衣巷，何心虎节门。\n予宁无可毁，公尚有流言。\n客散翘材馆，樵窥独乐园。\n空留殿后者，头白赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽柳斋陈公四首 其一","author":"刘克庄","text":"夹辅曾调鼎，分忧屡建牙。\n虏犹闻范老，盗亦说宗爷。\n公晚参黄檗，人痴望白麻。\n临歧却荤茹，应怕念头差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽段夫人二首 其二","author":"刘克庄","text":"母因子贵滔滔是，惟段夫人夐不同。\n丹桂义方如五窦，碧梧典册继三洪。\n鱼轩甫拜咸宁郡，象服未朝长乐宫。\n何必他人勒阡表，家庭自有大宗工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽段夫人二首 其一","author":"刘克庄","text":"断机手自训三珠，彤史遗芳未必如。\n子贵面槐陪国论，母贤画荻课儿书。\n百官未讲回班礼，千乘空多送葬车。\n曾忝枢庭文字友，束刍无路酹丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵母郑氏","author":"刘克庄","text":"攀桂者联翩，皆由母训焉。\n摘髭人共羡，出腹子多贤。\n稚耄三从美，哀荣五福全。\n幽明无一憾，玉润自铭阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵仲白二首 其二","author":"刘克庄","text":"昨吊寝门外，莱妻泣最悲。\n因言儿上学，复为墓求碑。\n零落烧丹诀，凄凉哭鹤诗。\n托孤朋友事，非谓九泉知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵仲白二首 其一","author":"刘克庄","text":"生被才名谴，摧残到死休。\n家留遗藁在，棺问故人求。\n对月悲孤咏，逢山忆共游。\n昔年携手地，今送入松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵卿无垢二首 其二","author":"刘克庄","text":"自是妖星死诸葛，非关潦雾病文渊。\n莼鲈不复归吴矣，琴鹤还如出蜀然。\n贤有丰碑存岘首，俭无高冢象祁连。\n东风一掬交游泪，吹向柯山宰树边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵卿无垢二首 其一","author":"刘克庄","text":"血衣尚在久乘边，入手功名费十年。\n圯上一编非鬼授，晋阳三版以人全。\n共祠石室思方切，不画云台命使然。\n玉树堂堂如昨日，安知冠剑隔重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵硕人二首 其二","author":"刘克庄","text":"苦恋莱衣乐，非贪汉绣行。\n上方优斡腹，儿未可陈情。\n风木终身恨，朝华过眼荣。\n谁言彤史废，阡表自峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵硕人二首 其一","author":"刘克庄","text":"华毂早于飞，深知梦幻非。\n幽閒林下气，澹素嫁时衣。\n客不闻轑釜，儿犹宝断机。\n天风环佩远，兜率是真归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵虚斋二首 其二","author":"刘克庄","text":"前岁山人来访逮，墓田丙舍报余知。\n法书尚宝元章帖，拙笔深惭有道碑。\n重作大招难尽意，共谈太极永无期。\n可怜老病忘昏昼，但记西窗剪烛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵虚斋二首 其一","author":"刘克庄","text":"俱列儒臣侍细毡，各为逐客问归船。\