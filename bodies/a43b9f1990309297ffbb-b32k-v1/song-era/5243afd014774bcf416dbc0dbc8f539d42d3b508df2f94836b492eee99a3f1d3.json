79689","path":"宋_1.csv","pointer":32246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐吏部二首 其一","author":"刘克庄","text":"仰钻无篚实，平进少梯媒。\n一鹤竟归去，万牛难挽回。\n空驰驿使召，不见省郎来。\n欲挂原头剑，徐君安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽翁仲山常卿二首 其二","author":"刘克庄","text":"昔驾輶轩忝外台，爱文学掾有高才。\n曾留太白论文去，亦辱奇章贽卷来。\n玉树枝成终古诀，紫薇花对别人开。\n时危国蹙英贤夭，空撚霜髭赋八哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽翁仲山常卿二首 其一","author":"刘克庄","text":"进由孤士列华簪，曾对薰风和舜琴。\n资善礼行貂竖肃，议郎疏出马群瘖。\n畿民犹说张京兆，宫媛皆知李翰林。\n麾去招来关气数，浩穹于此本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽聂孺人","author":"刘克庄","text":"已病犹蔬素，西归不复疑。\n飞凫踰岭远，别鹤返乡迟。\n箴史传贤女，巾褠付侍姬。\n白头潘令在，应有悼亡诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽袁侍郎二首 其二","author":"刘克庄","text":"遗诰兼新讣，同时至荜门。\n龙髯先帝远，鲐背几公存。\n方恨三旌晚，俄惊一鉴昏。\n潸然关世道，不是哭私恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽袁侍郎二首 其一","author":"刘克庄","text":"华发始遭逢，其如道不同。\n可曾留孟叟，俄已罢申公。\n谏草多传出，经疑尽解通。\n岂无南董氏，奋笔纪孤忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郭处士","author":"刘克庄","text":"昔闻东郭先生者，处士宁非是远孙。\n空有新诗喧一邑，竟无明诏老孤村。\n雷琴酷爱应同殉，草字尤工惜不存。\n复说归从葱岭去，骚成何路可招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽顾君任倅二首 其二","author":"刘克庄","text":"占断慈恩塔，归来履道坊。\n耆英真率社，少尹钓游乡。\n子可传汾曲，甥能述渭阳。\n如闻无恙日，治冢建祠堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽顾君任倅二首 其一","author":"刘克庄","text":"有酒常相觅，无金尚欲挥。\n竟骑黄鹤去，谁见素骡飞。\n华屋俄零露，蓉城果是非。\n自嫌闻道浅，怀旧忽沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽顾监丞","author":"刘克庄","text":"四州鼓吹迓前茅，几载疮痍变乐郊。\n黎母盗清民有犊，佽飞士勇海无蛟。\n安排循吏添新传，检点耆英少故交。\n欲发幽潜慰冥漠，自惭笔砚暮年抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽高孺人","author":"刘克庄","text":"溯源高适谱，作媲郑虔家。\n贤子搴丹桂，高才补白华。\n病犹观冕辂，没不待笄珈。\n阡表堪传远，何须挽诔加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽崔丞相三首 其三","author":"刘克庄","text":"昔侍琼花宴，回头二纪馀。\n嵇康作书懒，魏勃扫门疏。\n尚意开黄阁，安知尾素车。\n萧然旋马第，人指相君居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽崔丞相三首 其二","author":"刘克庄","text":"麻卷扬庭久，蒲轮就道迟。\n虚传杨绾用，不奈蔡谟辞。\n祝柱从渠诮，摧梁得许悲。\n流传千载下，犹足励清规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽崔丞相三首 其一","author":"刘克庄","text":"先帝谋元帅，烦公护蜀淮。\n军皆歌范老，民各像乖崖。\n北顾犹关虑，西归已卷怀。\n早令扶日月，宁不扫氛霾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽淮东丘升抚干","author":"刘克庄","text":"子美曼卿流，远携书剑游。\n惜攀丹桂晚，勇赴白檀秋。\n尚喜前筹壮，聊纾左衽忧。\n时危奇士夭，无泪可供愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽章孺人","author":"刘克庄","text":"□种岗头新宰树，追严案上旧楞伽。\n埋词更不烦谀墓，反哺何曾似自家。\n此女安知非妙善，夫人亦恐是摩耶。\n遥知兜率迎归去，天乐泠泠夹路花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄安人","author":"刘克庄","text":"嫁作儒家妇，韶颜已守孀。\n夫穷于仲子，儿胜似元方。\n陶母将迎养，庞妻忽坐亡。\n吾衰不能诔，短些谩凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄岩赵郎中二首 其二","author":"刘克庄","text":"青衫昔作督邮时，赏鉴除公更有谁。\n勘狱不嫌人守法，撰文常对众称奇。\n筑台虚辱生前意，穿冢难酬地下知。\n欲写哀思传挽者，身今戎服不能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄岩赵郎中二首 其一","author":"刘克庄","text":"朱公徒弟丘公婿，标致虽高气宇和。\n心向奏篇尤暴白，发因时事欲苍皤。\n讣传淮甸边情惜，路出萧山巷祭多。\n最长郎君师友盛，我知墓碣有人磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄德远堂长二首 其二","author":"刘克庄","text":"旧宅犹东里，新丘宛北邙。\n单鸡频哭友，老鹤悔还乡。\n斋记曾磋切，埋文愧耄荒。\n诸郎真五宝，虽死未尝亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄德远堂长二首 其一","author":"刘克庄","text":"虽与长君友，居常敬少君。\n何曾锦袄子，竟老布襦群。\n申白无殊礼，程朱有旧闻。\n谁为复斋传，应许附青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]