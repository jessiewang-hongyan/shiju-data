[{"title":"薛田察院洎寿师同宿三门开化院","author":"魏野","text":"绣衣蕙带方袍客，身计虽殊性共閒。\n同宿河心山顶寺，数宵无一事相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薛殿院将赴阙先归绛台迎觐","author":"魏野","text":"不妨赴诏暂归宁，跃马惟消两火程。\n七十严君千万喜，綵衣争似绣衣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王氏神童昆季","author":"魏野","text":"先后登科出玉京，满朝诗送更光荣。\n岂唯皇宋终难继，自古神童少弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠妓张八","author":"魏野","text":"君为北道生张八，我是西州熟魏三。\n莫惜樽前无笑语，半生半熟未相谙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠惠崇上人","author":"魏野","text":"张籍眼昏心不昧，崇师耳聩性还聪。\n是非言语徒喧世，赢得长如在定中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠潘阆","author":"魏野","text":"昔贤放志多狂怪，若比今来总未如。\n从此华山图籍上，又添潘阆倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三门与臧奎推官联句题东楼","author":"魏野","text":"二陕三门境，江城想未胜。\n早衙连庙鼓，夜市杂船灯。\n乞任多朝市，忘归有海僧。\n东楼仍更好，欲去又同登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三峰王耿殿丞将移陕下通理先已同袁刑部以唱和诗见寄因次前韵和酬二首 其二","author":"魏野","text":"蜀出多才信不虚，淹翔犹未佩银符。\n民间惠爱应长有，马上歌诗岂暂无。\n休话卜邻来草泽，即看得路去蓬壶。\n申湖公暇闲游地，贺监何须说鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三峰王耿殿丞将移陕下通理先已同袁刑部以唱和诗见寄因次前韵和酬二首 其一","author":"魏野","text":"君移棠树民皆喜，我住东郊却懒誇。\n拙性怕逢诗债主，病身愁见酒雠家。\n郢词温润如丝雨，蜀纸鲜明似绮霞。\n况是已经仙手和，点头空使角冠斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府大同王太尉","author":"魏野","text":"履历三朝五十春，坐棠难见辍元臣。\n分茅已是无双将，折桂兼为第一人。\n郡邑暂时劳抚恤，华夷尅日望陶钧。\n下车未暇求民瘼，先向东郊访隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府石太尉二首 其二","author":"魏野","text":"功名早岁立艰难，今日堪销费百般。\n婢仆出来皆会乐，儿童生下便为官。\n实封万户方应足，密赐千金旋已残。\n辍坐棠间惭豹略，莫嫌拘束动嗟叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府石太尉二首 其一","author":"魏野","text":"陕城天险枕河湄，茆土真风胜暂知。\n云雾虽频沾虎节，雪霜全未染虬髭。\n白霓放作军中练，红袖行为帐下旗。\n公暇不妨游赏外，佐僚时得一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府赵侍郎二首 其二","author":"魏野","text":"坐棠虚庙堂，俗亦似身康。\n药按仙方鍊，茶开御印尝。\n吏因呈案惧，民为立碑忙。\n公退无馀事，逍遥只道装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府袁刑部","author":"魏野","text":"星辰虽应碧虚中，富贵情疏道气融。\n绕野云烟陪淡薄，入衙山水学清通。\n申湖静泛孤舟月，棠树凉生一扇风。\n却有祖先难似处，献诗民住乐郊东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上致仕赵中令","author":"魏野","text":"王业致艰难，功成退自安。\n闲中犹有俸，品外更无官。\n洛水垂帘听，嵩峰凭几看。\n唯应问安诏，时复到门阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书闰师白莲堂","author":"魏野","text":"野人禅客合相陪，渐老诗心亦共灰。\n朱草阶前容不去，白莲堂上喜频来。\n地形各占幽深境，天产俱为散逸材。\n犹恨东郊西寺远，闲门难并水边开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书逸人俞太中屋壁","author":"魏野","text":"羡君还似我，居处傍林泉。\n洗砚鱼吞墨，烹茶鹤避烟。\n閒惟歌圣代，老不恨流年。\n每到论诗外，慵多对榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安春日书事","author":"魏野","text":"长安春色自依依，大命移应地不知。\n蔓草已迷双凤阙，千花犹照九龙池。\n岂无东閤开今日，尚有南山似旧时。\n一月悠悠游不足，青门欲出步迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日书事","author":"魏野","text":"一月天不暖，前村到岂能。\n闲闻啄木鸟，疑是打门僧。\n松色浓经雪，溪声涩带冰。\n吟馀还默坐，稚子问慵应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬暮郊居","author":"魏野","text":"村落欲黄昏，寒云片片凝。\n隔城钟似磬，远岫烧如灯。\n名利堪弹指，林泉但枕肱。\n何由遂闲散，自喜本无能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出户","author":"魏野","text":"出户下莎庭，徘徊当踏青。\n静嫌莺斗舌，闲爱鹤梳翎。\n云好昂头望，松宜侧耳听。\n便堪为导列，谁信可延龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四十自咏","author":"魏野","text":"闲心虽不动，记性觉潜衰。\n棋退难饶客，琴生却问儿。\n手慵农器信，身散道装知。\n笔砚将何用，除因改旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乔职方将赴阙诏领河东转输再成长句送之","author":"魏野","text":"河东控塞诏通儒，二十馀州系惨舒。\n位列九天应自致，权除两地更谁如。\n荐贤表想慇勤发，咏物诗应取次书。\n不为龙钟头半白，好抛泉石从轩车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘烨大著忽惠雅章喜惧交集辄增二咏聊以谢酬","author":"魏野","text":"东观刘郎一古儒，等闲简帖类经书。\n论交不弃如云客，并马常容似雪驴。\n蝴蝶梦魂知有据，凤凰诏命想无虚。\n翻愁旦暮西垣去，难伴王维宿直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同大孙状元送杨甫之蒲中","author":"魏野","text":"蒲本舜都州，君思独去游。\n云分五老顶，河喷二妃楼。\n雨足禾初熟，霜迟叶尚稠。\n此行贫莫叹，饮饯是三头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王希知县见赠","author":"魏野","text":"从前宰字绝文词，喜遇今来并有诗。\n封禅榜偏推凤藻，陶镕笔肯转稽迟。\n讼庭任静犹忘寐，文会虽忙不后期。\n莫怪林间强酬和，一般民最受深知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和同理王耿殿丞见赠","author":"魏野","text":"年来暂屈佐元戎，富贵真宜在蕊宫。\n性洁耻分钱子母，时清懒话剑雌雄。\n公心似水逢形鉴，和气如春触物融。\n莫道州民俱受赐，好诗遍得有谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和李殿院咏雪","author":"魏野","text":"瑞雪祥云见盛时，功轻苦雨谩霏霏。\n坠来虽作天花瘦，消去偏滋垄麦肥。\n太守登楼飘绣袂，幽人出户混麻衣。\n邻封愿得还如此，免说秦饥与晋饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬知开封县钱易学士见寄三首 其二","author":"魏野","text":"远劳仙馆客，相勉寄诗来。\n岂有口更叹，兼无心可灰。\n贫资闲寿命，吟助道梯媒。\n信拙过朝暮，除能泥酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬知开封县钱易学士见寄三首 其一","author":"魏野","text":"赤县滞清才，家曾有国来。\n埋金宁变土，烧玉岂为灰。\n敏手知谁敌，冥心懒自媒。\n雅章蒙寄惠，味胜沃醇杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和酬洛下宋京见寄","author":"魏野","text":"声名独步向西都，主将风骚敌亚夫。\n龟洛泛应随钓叟，龙门游想领生徒。\n公车未召身犹散，相府深知道岂孤。\n可惜春时还不见，眼前花卉谩芬敷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和薛端公归故里之什二首 其二","author":"魏野","text":"尚辍通儒外计筹，堂堂身岂等闲酬。\n绮罗笑别文翁郡，锦绣荣归舜帝州。\n贳酒村穿红树过，读书寺入翠岚游。\n逍遥楼对家山迥，得意诗销此处留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和薛端公归故里之什二首 其一","author":"魏野","text":"茜旗影里椹袍身，迎入蒲津免问津。\n策蹇去时为举子，乘骢归日是功臣。\n岂同化鹤千馀岁，才过登龙十数春。\n开宴仍闻倾锡赐，酣歌喜杀故乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上闲咏","author":"魏野","text":"微物满池塘，吟看向夕阳。\n草虫腰尽细，水鸟嘴多长。\n科斗渔翁字，芙蓉野客裳。\n诗成堪写处，莲叶碧笺香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过古战场","author":"魏野","text":"战死掩无坟，生降耻负君。\n古今魂易吊，贵贱骨难分。\n狐兔迷莎径，乌鸢噪陇云。\n谁家有征妇，曾此待回军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别后却寄三门发运卞寺丞兼简臧推官","author":"魏野","text":"共泛楼船去，临流羡送君。\n烟中旗不见，风里乐犹闻。\n李郭情堪并，荀陈事岂分。\n归来溪路上，特地怆离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀宗人仲容","author":"魏野","text":"寻常念朋友，况复是宗人。\n久别弹琴少，相思掷卦频。\n旅游湘水远，家寄华山贫。\n早晚重来此，园林又过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀寄河中表兄李徵君","author":"魏野","text":"蒲津棠树两閒人，我愧虚名帝亦闻。\n三世往还为近戚，一时递互唤徵君。\n虽同闭户辞丹诏，尚阻连床卧白云。\n苦恨中条镇相隔，老来离思转纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀寄眉山知县王辟寺丞","author":"魏野","text":"仲先别仲通，长忆又长慵。\n有梦应相信，无书想见容。\n尘埃五十驿，山水几千重。\n老去难寻访，何时得再逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村居述怀","author":"魏野","text":"布褐楮皮冠，朝昏信自然。\n眼明山雨后，发乱晚风前。\n鹤病生闲恼，僧来废静眠。\n自知慵懒性，至死岂能悛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还何学士诗集","author":"魏野","text":"魏野非商也，微言岂易穷。\n看虽许朋友，写不倚儿童。\n合在龙图上，难留蜗舍中。\n因思投纳处，还浦与珠同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居书事","author":"魏野","text":"无才动圣君，养拙住山村。\n临事知闲贵，澄心觉道尊。\n成家书满屋，添口鹤生孙。\n仍喜多时雨，经春免灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和长安龙图陈学士登熙熙台之什二首 其一","author":"魏野","text":"鹑野龙图陈学士，迎秋登眺称英奇。\n一声玉管风流处，百尺金台雨霁时。\n云近上清争缥缈，山连太白斗参差。\n碧纱他日裁多少，笼得园园寺寺诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和冯亚见赠","author":"魏野","text":"君向城中住，淳风想独还。\n相逢多解梦，不见少开颜。\n期约多寻药，商量共买山。\n羡予庭际石，重叠藓痕斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和李安见寄","author":"魏野","text":"三举休嗟尚陆沉，献书已得帝知音。\n烧残灰烬方分玉，披尽泥沙始见金。\n思苦任成潘岳鬓，道穷莫动孟轲心。\n公车再召应非晚，疏懒犹难卜访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和益州司理刘大著喜与运使薛端公相见之什","author":"魏野","text":"锦川风物似蓬丘，运使诗流压九流。\n五色云中题寺观，四时花里按军州。\n棠郊野客空遥羡，兰省才郎称共游。\n纵使谪仙今复出，难陪倡和却应愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和酬用晦上人见题所居","author":"魏野","text":"陋巷西邻召伯祠，入城流水透疏篱。\n雨来石室琴先觉，春去松庭鹤不知。\n薜荔交加侵瓮牖，莓苔斑驳绕盆池。\n草堂近日犹增价，添得汤休两首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人见咏新鹤","author":"魏野","text":"雪霜毛羽瘦形仪，养处人家觉道肥。\n龟有寿龄方可近，鹭无仙分莫相依。\n千年松上疑孤立，五色云中好并飞。\n不竞巢栖争饮啄，也应难免众禽非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三门窦寺丞见寄","author":"魏野","text":"风情不独少人同，满腹书宁愧郝隆。\n职务恰如波正急，辎囊长似狱长空。\n柳藏衙树侵堤绿，旗插楼船照岸红。\n见说公馀无一事，题诗多在禹祠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三门窦程寺丞见赠","author":"魏野","text":"禹门分署似仙居，谁羡同年在直庐。\n闲制曲教鸦角唱，醉吟诗遣凤毛书。\n蒙过村巷惊玄豹，命踏厅阶上白驴。\n莫讶此篇酬更晚，只缘思涩岂情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王衢见寄兼呈董行父","author":"魏野","text":"弃繻东入武牢关，帝里经年岂是闲。\n鹢退暂知淹凤藻，鹏残即看上鳌山。\n讨论想慰门人意，谈笑应开翰长颜。\n唯我块然谁共处，终朝门掩竹林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和长安孙舍人见寄","author":"魏野","text":"长安君到转民安，夏少炎蒸腊少寒。\n接使管弦登月榭，劝农旌旆入烟峦。\n龙池似锦花堪赏，鹑野如云稼好观。\n见说添苏亚苏小，随轩应是佩珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冯亚见赠","author":"魏野","text":"一生无一事，兀兀复腾腾。\n信脚虽过寺，斋心不请僧。\n松篁为活计，琴酒是良朋。\n除却君酬唱，他人亦懒能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冯亚寄进士孙磻","author":"魏野","text":"闲思生白发，懒更把菱花。\n久别何州住，相寻恐路差。\n独飞伤塞雁，会宿羡林鸦。\n犹得君为友，时过老母家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙舍人重过陕下二首 其二","author":"魏野","text":"一种分符两种荣，朱衣院吏引红旌。\n全家首赴酂侯镇，半路重过召伯城。\n迎步绮罗无旧态，随轩丝竹有新声。\n野人相见忻还愧，为爱交情似世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙舍人重过陕下二首 其一","author":"魏野","text":"二陕重过一纪强，麻衣已变椹袍光。\n数宵黄閤延三字，几处青楼认五郎。\n顾我岂能誇舌在，逢君宁复叹唇亡。\n大龙头丧同伤处，吏隐亭攲郑谷傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙虞部见赠","author":"魏野","text":"朝客惠诗牌，山人愧不才。\n旱田春雨足，暗室夜光来。\n灯下吟三复，琴中鼓数回。\n性愚非赐也，微旨尚难猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和并州刘密学见寄","author":"魏野","text":"还如裴度镇河东，百万军民畏爱中。\n钟鼓久喧刁斗静，旌幢一指雁门空。\n潇湘故友参时务，燕赵佳人接土风。\n密地再归知不出，莫将竹马约童蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和何学士见咏新得鹤","author":"魏野","text":"喜得华亭鹤，看承过所宜。\n防饥先种稻，忧病预钻龟。\n易惬眠云意，难酬卧锦诗。\n不缘过郡谢，步步在相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和呈寇相公见赠","author":"魏野","text":"深严相府绝纤埃，宴会寻常召不才。\n孙閤有歌凝翠黛，召棠无讼锁青苔。\n凤池即看三回入，蜗舍曾蒙数度来。\n仍赐雅章惭继和，朱门将献又徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈推官暮春感兴","author":"魏野","text":"角冠闲戴任攲斜，骑马人稀到我家。\n僧体盘餐唯笋味，道情栏槛只松花。\n惊回驯鹿林閒犬，聒杀灵龟雨后蛙。\n春去寻常何足叹，自将寂寞并繁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和河中孙谏议见送同薛田察院之龙门谒刘烨大著","author":"魏野","text":"闲忆披云辍卧云，尽惊獬豸鹿同群。\n舜耕山下辞廉使，禹凿门前谒宰君。\n莫讶楼台抛接武，却愁泉石动移文。\n花时离别尤堪惜，头白三分欲二分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和绛台王都官见寄春日书事之什","author":"魏野","text":"绛郡政闲闻，人家可闭门。\n马嘶花下路，犬睡月中村。\n吏亦擎书卷，民皆挈酒樽。\n行春思隐逸，多谢动吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郡侯咏雪","author":"魏野","text":"时节初过打猎天，山河一色晓漫漫。\n梁王宴罢樽犹湿，谢傅诗成墨未乾。\n笔砚窗间宁觉夜，管弦堂上岂知寒。\n须知祥瑞同霖雨，莫作梅花柳絮看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和夏台知县李尚贤殿直见赠","author":"魏野","text":"咫尺县前山，阳城旧掩关。\n两衙公务静，三载使星闲。\n雪入司房暗，苔侵界石斑。\n曾为攀桂客，多谢访林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和寇寺丞夏日游丽春园","author":"魏野","text":"丽春园甲召公城，池想游鱼恨至清。\n一簇楼台如画出，数群鸥鹭似家生。\n芰荷香里垂纶坐，杨柳阴中把卷行。\n不领管弦唯静憩，相门年少有高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]