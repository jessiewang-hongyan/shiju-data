[{"title":"感皇恩 其一 和吴推官","author":"韩淲","text":"急管度青枝，醉眠芳草。\n云断巫阳梦能到。\n乍醒馀困，晴影暗移纱帽。\n旧时闲意思，都忘了。\n今岁春迟，去年春早。\n点点繁红又多少。\n惜春归去，酒病翻成花恼。\n数声鸣鸟唤，人惊老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其二 又","author":"韩淲","text":"诗社酒徒闲，村村花柳。\n月榭风亭更霞牖。\n临春结绮，又是那回时候。\n不禁中夜雨，相僝僽。\n弄蕊攀条，为寻芳酒。\n一斗谁能问千首。\n江南云梦，空说气吞八九。\n持杯人共我，能吟否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摊破浣溪沙/山花子 杨梅","author":"韩淲","text":"生与真妃姓氏同。\n家随西子苎萝东。\n谁道玉肌寒起粟，酒能红。\n火齐烧空来上苑，冰浆凝露在西宫。\n不似荔枝生处远，恨薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 陈玉局生朝","author":"韩淲","text":"归锦堂成，云汉上、天垂新画。\n有朱颜绿鬓，禁林仙客。\n玉局暂从香火社，金龟未报文章力。\n看彤庭、赐第别承恩，居君侧。\n斑衣戏，蟠桃摘。\n翠袖倚，歌檀拍。\n正祥开初度，颂声千百。\n又是腊前梅态度，几多春近花消息。\n想明年、今日醉西湖，光辉赫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 和赵公明","author":"韩淲","text":"五老峰前，九江上、曾生仙客。\n相邂逅、贵池亭下，定交金石。\n我辈风流宜啸咏，官曹尘冗从煎逼。\n且簿书、丛里举清觞，偷闲日。\n同一笑，当今夕。\n梅正好，香浮白。\n便相忘尔汝，醉巾沾湿。\n已向琼楼夸意态，似闻金殿传消息。\n想君今、归去际风云，应相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 王寺簿生朝","author":"韩淲","text":"点点淮山，迢迢江水，分明别是风光。\n地灵人杰，星斗烂文章。\n初度充闾佳气，当年瑞、应弄圭璋。\n薰弦奏，凉宵宝月，玉井藕花香。\n清真，如逸少，兰亭修竹，曲水流觞。\n想醉乡日永，地久天长。\n小驻屏星怀玉，飞凫舄、元在鹓行。\n功名事，云龙风虎，行矣佩金章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪","author":"韩淲","text":"南兰陵郡鹧鸪词。\n底用登临更赋诗。\n贵不能淫非一日，老当益壮未多时。\n人间天上风云会，眼底眉前岁月知。\n只有海门横北固，宦情随牒想推移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 代儿寿黄靖州","author":"韩淲","text":"晓来一阵催花雨。\n正桃李、横塘处。\n笙歌帘幕燕莺喧。\n春在人间不老、谷城仙。\n潇湘图画迎千骑。\n襦裤欢声起。\n功名风虎庆云龙。\n更看万钉横带、系金狨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其一 姑苏画莲","author":"韩淲","text":"西湖十里孤山路。\n犹记荷花处。\n翠茎红蕊最关情。\n不是薰风、吹得晚来晴。\n而今老去丹青底。\n醉腻娇相倚。\n棹歌声缓采香归。\n如梦如酲、新月照涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其二 赵倅酌别灵山阁","author":"韩淲","text":"送君报最登朝路。\n初整曹装处。\n又因杯酒见馀情。\n凉雨灵山阁上、月初晴。\n醺然领客襟怀底。\n消得阑干倚。\n风流别乘我依归。\n清誉冰溪棠荫、绿漪漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 闲举“金风玉露相逢”之曲，因赋","author":"韩淲","text":"诗非漫与，酒非无算，都是悲秋兴在。\n与君觞咏欲如何，画不就、新凉境界。\n微云抹月，斜河回斗，隐隐奇奇怪怪。\n刚风九万舞瑶林，甚些少、人间利害。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 红梅已谢","author":"韩淲","text":"红梅已谢，杏花开也，一片海棠犹未。\n春风吹我带湖烟，甚恰限、新晴天气。\n黄昏楼上，烛花影里，拼得那回滋味。\n暗尘弦索拂纤纤，梦留取、巫山十二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其二 细雨吹池沼","author":"韩淲","text":"尽道今年春较早。\n梅与人情，觉得梅偏好。\n一树南豅香未老。\n春风已自生芳草。\n来自城中犹带晓。\n行到君家，细雨吹池沼。\n怅望沙坑须会到。\n玉溪此意年时少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其一 次韵伊一","author":"韩淲","text":"未就丹砂须九转。\n谁把新词，歌绕梁尘遍。\n拍拍韶华春意满。\n揆予初度文何健。\n恰是山花汀草远。\n独乐园林，不梦笙歌殿。\n灵气仙才非小见。\n霞杯漫道蟠桃献。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其二 次韵郑一","author":"韩淲","text":"千叶香梅春在手。\n日薄帘栊，花影遮前后。\n小立徐行还易久。\n微吟莫厌伤多酒。\n拾翠流红弦管透。\n望断青青，休问行人柳。\n往事如云如梦否。\n连天芳草惊依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 野趣轩看玉色木犀","author":"韩淲","text":"斜日清霜山薄暮。\n行到桥东，林竹疑无路。\n小院横窗香噀雾。\n胆屏曲几花如雨。\n细酌心情因少驻。\n九万刚风，寒影吹琼素。\n不是月宫那有许。\n霓裳舞彻凌波步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其一 三十日归途村店市酒，成季、子任同酌而歌","author":"韩淲","text":"道上疏梅花一树。\n人去人来，不管流年度。\n闲过南豅同散步。\n东风为我吹香去。\n试问青春今几许。\n明日新正，溪影横山暮。\n遮莫攀翻君且住。\n心儿却在题诗处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行 七夕词","author":"韩淲","text":"雨意生凉，云容催暮。\n画楼人倚阑干处。\n柳边新月已微明，银潢隐隐疏星渡。\n今古佳期，漫传牛女。\n一杯试与寻新句。\n幽怀冷眼是青山，旧欢往恨浑无据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉桃源 昌甫有曲，名之濯缨，因和","author":"韩淲","text":"残春风雨绕檐声。\n山空分外鸣。\n闲来落佩倒冠缨。\n尚馀亲旧情。\n人不见，句还成。\n又听求友莺。\n濯缨一曲可流行。\n何须观我生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉桃源 和昌甫","author":"韩淲","text":"固穷斋里语吾生。\n言之必可行。\n扶疏夏木既啼莺。\n更逢鱼计成。\n多雅尚，少时情。\n沧浪渔父缨。\n高歌宁与俗争鸣。\n朱弦疏越声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄/一斛珠 次韵斯远","author":"韩淲","text":"风高木落。\n壮心万里空回薄。\n振衣待把尘埃濯。\n声里斜阳，孤起戍楼角。\n人生谁会谁为错。\n年来但觉多离索。\n黄花照地浑开却。\n华发如斯，同和醉落魄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉蓬莱 寿潘漕","author":"韩淲","text":"问西湖好处，楼上薰风，有谁称寿。\n十里荷香，对槐阴清昼。\n细浪揉蓝，远山凝黛，更管弦初奏。\n醉舞傞傞，欢声沸沸，生申时候。\n膝下婆娑，老莱儿戏，帝所辉光，使衣呈绣。\n眷倚方隆，赐金章华绶。\n自此飞腾，凤阁鸾台，好满斟醇酎。\n道骨仙风，朱颜青鬓，年年依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉蓬莱 上太守","author":"韩淲","text":"庆文章太守，燕寝凝香，诞弥佳节。\n庾岭归来，又经年梅发。\n棋酒心情，笙歌滋味，便合朝天阙。\n玉作山前，冰为水际，几多风月。\n绿鬓朱颜，浩然相对，自是中原，旧家人物。\n鹓鹭班回，尚记陪清切。\n好把胸蟠万卷，谈笑了、济时勋业。\n锦幄初温，宝杯深劝，舞回香雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 离歌一叠","author":"韩淲","text":"只唱离歌一叠休。\n玉溪浮动木兰舟。\n如何又对云烟晚，不道难禁草树秋。\n空脉脉，忍悠悠。\n绸缪终是转绸缪。\n相思相见知何处，记取新欢说旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 次韵昌甫","author":"韩淲","text":"老去情怀酒味中。\n水边林下古人风。\n岁云暮矣江空晚，谁识儋州秃鬓翁。\n人易远，语难工。\n春时犹记一尊同。\n苦心未免皆如此，只合挥弦目送鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 寿福国陈夫人","author":"韩淲","text":"静乐堂中禅悦身。\n相家庆袭两家春。\n瑶池云气冲霄鹤，兰砌风标瑞世麟。\n华屋邃，宝杯新。\n年年秋与月常明。\n笙箫且奏长生曲，宣劝还看送喜频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 禁烟","author":"韩淲","text":"烟禁荒荒雨湿云。\n近郊争出满城人。\n儿童藉草几成市，杯酒沾花不觉村。\n身又老，眼增明。\n回头一任是红尘。\n山中谁信无寒食，涧上何如且采蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 冲雨小舟上南港","author":"韩淲","text":"莫笑闲身老态多。\n避人避世欲如何。\n分明画出山阴道。\n太息吟成宁戚歌。\n穿木石，泛烟波。\n从前魑魅喜人过。\n灵山西畔高溪上，一棹归来舞短蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 次韵赵路分生朝所赋","author":"韩淲","text":"便把山林寄此身。\n也须诗酒属吾人。\n仙家旧是金堂士，吏隐新收玉局名。\n惟自乐，不忧贫。\n渊明谈笑更清真。\n年年眉寿登高后，醉帽常留菊满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 十二月二十二日","author":"韩淲","text":"云到春飞若素期。\n柳条吹送落梅枝。\n冰壶表里谁能赋，玉鉴圆明且屈卮。\n村舍北，郡楼西。\n治中风调只心知。\n不堪野老关门醉，想见山翁倒载时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 昌甫同明叔饮赵崇公家","author":"韩淲","text":"莫道庞公不入州。\n为谁歌酒也迟留。\n襟期别乘真难事，领略同游岂易谋。\n他扰扰，自悠悠。\n香浮茉莉笑花头。\n一帘云影催诗雨，唤起佳人无限愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 看瑞香","author":"韩淲","text":"看了香梅看瑞香。\n月桥花槛更云窗。\n不知是有春多少，玉水灵山醉几场。\n闲蝶梦，褪蜂黄。\n尽温柔处尽端相。\n珠帘十里扬州路，赢得潘郎两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 兰溪舟中","author":"韩淲","text":"雨湿西风水面烟。\n一巾华发上溪船。\n帆迎山色来还去，橹破滩痕散复圆。\n寻浊酒，试吟篇。\n避人鸥鹭更翩翩。\n五更犹作钱塘梦，睡觉方知过眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜天晓角 又","author":"韩淲","text":"雨收云薄。\n有底情怀恶。\n一段春风花事，吟得就、又忘却。\n海棠红未落。\n细细流霞酌。\n选甚蝇营狗苟，皆现定、有何错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和史院晚出","author":"韩维","text":"新雨稍添清禁润，斜阳初下直庐明。\n方惭饱食无裨补，更作长廊百步行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又绝句","author":"韩维","text":"芙蓉落尽荷叶黄，西风测测梧桐凉。\n岁登讼息休吏早，林间独坐歌还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子华兄生日五首 其五","author":"韩维","text":"白鹤群飞散作阴，方春膏雨一犁深。\n只知万物含芳润，谁识清通造化心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子华兄生日五首 其四","author":"韩维","text":"柳阴散释真阳艳，妄虑消除至道冥。\n浮世短长何足道，须知时节在明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子华兄生日五首 其三","author":"韩维","text":"萱甲微抽碧玉簪，已惊花艳动筠篮。\n便须行乐迎东律，莫为回神滞北庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子华兄生日五首 其二","author":"韩维","text":"池面和风丽稍开，翠条芳甲满春台。\n笙歌竞奏长生曲，兄弟华颠对举杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子华兄生日五首 其一","author":"韩维","text":"秀眉华发貌安和，五福于今得最多。\n诸圣共忘心外境，八仙同入饮中歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卞仲谋八老会","author":"韩维","text":"同榜同僚同里客，斑毛素发入华筵。\n三杯耳热歌声发，犹喜欢情似少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太素雪中惠小桃","author":"韩维","text":"细雪繁飘远近来，三冬佳气一朝回。\n莫嫌天上琼花晚，元待人间粉艳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人阁四首 其三","author":"韩维","text":"薄暖正当挑菜日，轻阴渐变养花天。\n君王勤政稀游幸，院院相过理管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪偶成三颂呈芳公长老兼简收贵二上人 其二","author":"韩维","text":"闻君鼎足话无生，说尽无生及有生。\n几日西郊回杖锡，小窗同听竹风声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉汝惠猫头笋","author":"韩维","text":"汉臣问鹏曾游地，腊祭迎猫始出林。\n解箨光先凝片玉，含甘珍重等兼金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之饮杨路分家听琵琶 其一","author":"韩维","text":"酒熟梅香腊后天，春莺巧啭忽当筵。\n共嗤白傅辛勤甚，万唤千呼始上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之饮杨路分家听琵琶 其二","author":"韩维","text":"遇酒逢春触处春，白头相视若天伦。\n须知丞相官仪重，不及琳宫自在人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和尧夫同前 其一","author":"韩维","text":"朱弦四十昔尝闻，艺不论多贵绝伦。\n少损新声放平淡，免教醉杀白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和尧夫同前 其二","author":"韩维","text":"教得新声十二弦，每逢嘉客便开筵。\n春湖水绿花争发，好引红妆上画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和尧夫欲借琵琶妓 其二","author":"韩维","text":"谢公故事常携妓，白傅高年自唱歌。\n更假红妆知有意，欲添尊酒十分多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和尧夫欲借琵琶妓 其一","author":"韩维","text":"画船西去水成乡，玉管朱弦出上方。\n衰病不须多酌我，次公非酒亦能狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋颂二首 其二","author":"韩维","text":"阳景朝来释冻凘，水边林下好追随。\n灵山一会何曾散，莫学时人语别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋颂二首 其一","author":"韩维","text":"两膝双盘一足垂，历然宾主席间仪。\n惟应露柱方能识，只恐仙陀也不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因题象罔亭榜呈太素","author":"韩维","text":"一颗圆明不欠亏，胡来胡现大钧知。\n如今象罔浑无用，榜样从教作世师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尧夫垂示佳驾辄次二韵为谢","author":"韩维","text":"横笛能为水龙响，清歌不放綵云飞。\n知君未尽杯中兴，故折红芳赠醉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏示程正叔范彝叟时正叔自洛中过访","author":"韩维","text":"曲肱饮水程夫子，宴坐烧香范使君。\n顾我未能忘外乐，绿尊红芰对朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和唐公北使途中见寄二首 其二","author":"韩维","text":"残红著树春无几，怅望君家绿玉杯。\n美酒应容步兵醉，后堂先约戴崇开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答提刑王朝奉席上看梅见贻","author":"韩维","text":"诚己从来不问天，肯将衰白慕华轩。\n调羹岂是山翁事，只合看花对酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答微之","author":"韩维","text":"空门欲问君何得，灭色终非我所能。\n岑寂欢狂均有待，无相与处是良朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百门义呈君俞辄成短章","author":"韩维","text":"一微尘上百门成，空里花飞谷里鸣。\n海印元来君自有，聊将黄叶止啼声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红薇花","author":"韩维","text":"杏梅成实夏阴浓，波面繁花刺眼红。\n莫为春归减欢兴，共将弦管乐薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君俞惠诗觅洛中所得大金菊辄次韵酬二篇 其二","author":"韩维","text":"禅老心真异众心，不缘歌舞费黄金。\n春芳落尽慵开眼，豫乞寒花伴苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜君章家赋海棠二首 其二","author":"韩维","text":"濯锦江头千万枝，当年未解惜芳菲。\n今朝得向君家见，不怕春寒雨湿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜君章家赋海棠二首 其一","author":"韩维","text":"长条无风亦自动，繁艳著雨更相宜。\n少陵不奈被花恼，终日颠狂觅酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉五绝呈景仁 其五","author":"韩维","text":"携觞日日绕珍丛，未必欢情尽醉中。\n却怕后时无意思，杀风景似范家翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉五绝呈景仁 其一","author":"韩维","text":"堂前堂后尽芙蓉，晴日烘开万朵红。\n不把一樽酬胜赏，忍看憔悴落霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]