[{"title":"守闸书事时已退居五首 其一","author":"曹勋","text":"十年壮节下清都，鹢首常辞负弩驱。\n一棹西来黄篾舫，闸胥指点若樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏示子舍二首 其二","author":"曹勋","text":"日日有花终日赏，时时酌酒亦时醒。\n今年剩得优游乐，亭榜宜书醉景亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏示子舍二首 其一","author":"曹勋","text":"八八光阴又四春，同柈殊少去年人。\n不妨诸子频修供，莫厌击鲜休说贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏妙德二偈 其一","author":"曹勋","text":"万行不修无事也，随缘放旷任逍遥。\n昨夜人言风雨急，窗间只道海门潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"曹勋","text":"百拙无能性又昏，欲将昏拙去求真。\n新来又更添些懒，雪上加霜笑杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十七","author":"曹勋","text":"澹烟疏雨耿寒林，一水涓涓净不深。\n照影自怜逼摇落，归涂未就更关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十六","author":"曹勋","text":"淅淅西风入小楼，楼中听彻玉笙秋。\n不妨青竹摇残梦，甚怯新凉搅客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十五","author":"曹勋","text":"款段扬鞭过雨村，沙平步稳转山根。\n好花一簇墙头见，深院谁家尚掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十四","author":"曹勋","text":"轻雷隐隐初惊梦，小雨疏疏巧润花。\n正是暄和好春色，常将诗酒赏年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十三","author":"曹勋","text":"道人身在水云乡，诵罢楞伽日乍长。\n满坐好风驱热恼，一庭浓绿作清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十二","author":"曹勋","text":"一山孤秀隐溪云，溪影涵光隔世纷。\n松竹径深凉意透，衣巾不觉午风薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十一","author":"曹勋","text":"佛头山下雨随风，倒海翻江一饷中。\n徙倚栏干便晴霁，湖光渺渺夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二十","author":"曹勋","text":"柑花开密玉璘珣，香转薰风满坐闻。\n摘得一枝参鼻观，不妨终夕醒馀醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十九","author":"曹勋","text":"柳浪收晴水拍天，湖边宫殿影相连。\n悠扬笛韵惟愁彻，欸乃渔歌何处船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十八","author":"曹勋","text":"飞去莺儿黄一点，压低梅子绿团枝。\n钩窗捲箔凉生坐，但觉新阴转影迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十七","author":"曹勋","text":"绿暗红稀迷处所，梅黄雨细半阴晴。\n小轩坐久无馀事，喜听黄鹂一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十六","author":"曹勋","text":"西窗忽见弄微明，甚喜江湖作晚晴。\n不惮云霄遗暑湿，且无聒耳泻檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十五","author":"曹勋","text":"危亭栏槛倚江干，饭了登临得暂闲。\n林木巧随高下路，山容都在有无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十四","author":"曹勋","text":"此生扰扰事无穷，脱得闲身石火中。\n聊种柴桑三径菊，未输严濑一丝风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十三","author":"曹勋","text":"连旬梅雨暗人家，甚阻支筇一径斜。\n待得晴明荫新绿，追凉风帽侧乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十二","author":"曹勋","text":"清暑堂深日景迟，愧头书策梦回时。\n小栏闲倚薰风晚，一点红榴绿万枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十一","author":"曹勋","text":"晓天梅润喜追凉，湖上夷悠兴自长。\n清耳要闻蒲稗雨，挐舟深入水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其十","author":"曹勋","text":"腊后暄和若夏初，梅花催暖不容疏。\n从来准拟连旬赏，数日能忙雪不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其九","author":"曹勋","text":"从来甚爱水云居，投老安闲且自如。\n瀹茗焚香方外友，白灰红火养丹炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其八","author":"曹勋","text":"欣欣花木递香红，云散天容静碧空。\n恰是韶华浓似酒，柳丝澹荡杏花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其七","author":"曹勋","text":"春事匆匆祇可惊，暄和喜试晓衣轻。\n梅花烂熳浑如雪，只恐风多堕玉英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其六","author":"曹勋","text":"景阳未下水云乡，梅影摇寒月一窗。\n攲枕梦能归故隐，满帆烟雨渡涛江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其五","author":"曹勋","text":"幽栖真在赤城隈，桂月萝云冷斗台。\n猿鹤定能知我意，移文未怨晚归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其四","author":"曹勋","text":"远水兼天冷暮云，惊风脱叶静逾闻。\n蒲团宴坐都无事，只有山垆供夕熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其三","author":"曹勋","text":"云际翻风断雁斜，城阴槃暮噪栖鸦。\n春容落景寒犹嫩，望尽遥天数缕霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其二","author":"曹勋","text":"孤山不复访林逋，杖策东风踏碧芜。\n九里苍云经晓径，四围碧玉照清湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂诗二十七首 其一","author":"曹勋","text":"方塘倒影青天净，幽径生苔绿荫浓。\n春去得闲观物化，吹凉醒睡喜支筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程机宜感怀 其三","author":"曹勋","text":"至交类萍梗，离合宁前知。\n相思梅花发，岂待中郎吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程机宜感怀 其六","author":"曹勋","text":"北塞草色黄，吹作边风驶。\n惟公发踪谋，莫并横经士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程机宜感怀 其二","author":"曹勋","text":"十年戈甲际，四海烟尘中。\n惨惨鼓角晚，萋萋禾黍风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观马院洗马","author":"曹勋","text":"相靡相踶性不同，金环压辔照晴空。\n晚来洗罢游缰缓，喜听骄嘶岸柳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观月藏书楼","author":"曹勋","text":"月出西南气便清，看来看到满轮明。\n莫嗔夜夜东楼赏，却恐中秋未必晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访印老宿寺中值雪","author":"曹勋","text":"白项鸦儿啼远林，怪来新冷透重衾。\n僮奴窃语若为去，雪满前山数寸深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过太行","author":"曹勋","text":"太行应助往还程，一带峰峦日日青。\n岂比韩苏当日祷，兹行国事叶三灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过真定","author":"曹勋","text":"南北东西本一家，从来河朔富桑麻。\n枣梨阴翳忽如雪，漠漠一川荞麦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过淮甸","author":"曹勋","text":"长淮烟静是天津，兵里因循一半分。\n尚有旧时鸥与鹭，夕阳归处记南云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问西湖梅","author":"曹勋","text":"山肋梅花秀色新，不堪寒雨浥清尘。\n故应倒影澄澜碧，湿玉吹香烂熳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏松隐看雨","author":"曹勋","text":"细细南薰气已深，午来庭户作烦襟。\n雨云不向西山出，只在青天忽变阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"曹勋","text":"残冬梅玉已全开，明日新阳应候来。\n但喜痴儿欣节物，又闻残酒滴炉灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀远","author":"曹勋","text":"有美人兮隔千里，彼不来兮我独止。\n吴江木落又经年，壮士悲声寒易水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折杨柳五首 其五","author":"曹勋","text":"去日同君过渭桥，桥边新雪未全消。\n如今窗外杨花满，憔悴无心约细腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折杨柳五首 其四","author":"曹勋","text":"君去霏霏雪满衣，思君杨柳正依依。\n新来又得征人信，君去交河尚未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖次柳洲二首 其二","author":"曹勋","text":"净舍乘闲一苇航，入门松竹献清凉。\n倚栏澄碧龟鱼乐，照眼荷花风露香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖次柳洲二首 其一","author":"曹勋","text":"一棹西湖意不阑，解颐风约水云寒。\n瀰瀰细浪篷边去，叠叠青山枕上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到飞泉","author":"曹勋","text":"晓入飞泉带月华，山如相识路如家。\n百虫不响露初下，开尽一川荞麦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人见赠四首 其四","author":"曹勋","text":"白玉芳醪何所似，仙人掌冷下金盘。\n青衫汉殿人将老，应酌清醇拟旧欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人见赠四首 其三","author":"曹勋","text":"牢落海边惟教子，书声殊喜听三盘。\n芳樽远寄柴扉静，洗盏开尝得尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人见赠四首 其二","author":"曹勋","text":"尝借虏前三尺地，从容壮节进铜盘。\n如今袖手林泉去，惟喜天开二圣欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人见赠四首 其一","author":"曹勋","text":"新诗璀璨来蓬荜，径寸光摇白玉盘。\n二鹿已知烦细剪，一樽无乃辍馀欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪三首 其三","author":"曹勋","text":"欲往双溪积有年，病身须是履晴川。\n梅霏正作侵衣冷，馀暖犹思粪火边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪三首 其二","author":"曹勋","text":"戢戢青林万箨龙，满提烦贶嗫嚅翁。\n只宜放出长梢去，抹月披云紫翠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪三首 其一","author":"曹勋","text":"从来野性自由身，正欲山行不乱群。\n小筑与君今不远，松萝只隔一山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪五首 其五","author":"曹勋","text":"别去仙山今几春，客心牢落渴生尘。\n建溪寄向双溪去，一饮还应念故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪五首 其四","author":"曹勋","text":"秋窗夜雨湿晴空，水国新凉满袖风。\n更向西湖见西子，御风如过紫霄峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪五首 其三","author":"曹勋","text":"发缄喜读五篇诗，诗到天成分外奇。\n五一自应归定位，他时笑领更何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪五首 其二","author":"曹勋","text":"从来绝粒喜留侯，作个庵成漫几秋。\n未得归休桐柏去，每寻故老话台州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪五首 其一","author":"曹勋","text":"雕章琢句老双溪，秀韵凌虚独擅时。\n字似金陵诗似甫，风流词翰两相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和何季崇签判三首 其三","author":"曹勋","text":"帘静栊香袅袅秋，绮疏锦瑟寄清愁。\n梦回写出西瑶句，尚想风神白玉楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和何季崇签判三首 其二","author":"曹勋","text":"露寒烟冷不胜秋，红叶黄红总是愁。\n拟趁登临倩新雁，为传书札到青楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和何季崇签判三首 其一","author":"曹勋","text":"羁思登临已怯秋，紫萸黄菊更添愁。\n海光不动暮山紫，人在天涯空倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张达道先生三首 其三","author":"曹勋","text":"寒暑今应不见侵，聊将内事付清吟。\n不妨帝泽骈蕃处，燕坐山房花木深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张达道先生三首 其二","author":"曹勋","text":"先生道价彻云空，凛凛撑天玉一峰。\n我亦何知求至理，颇如纤筳扣洪钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张达道先生三首 其一","author":"曹勋","text":"杖屦从风入帝关，坐令爽气满西山。\n身随清跸云烟上，心在华阳晻霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其七","author":"曹勋","text":"老病衰残得养闲，语离可复对秋山。\n只应今夜相思梦，同渡江云水石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其六","author":"曹勋","text":"居临潮落潮生地，占得溪南溪北云。\n紫陌清歌同听曲，丹丘连日喜逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其五","author":"曹勋","text":"松乔吹断绿云璈，海迥天空冉冉高。\n他日幅巾期汗漫，昆丘同约上风涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其四","author":"曹勋","text":"移花种竹增幽寻，捲箔高窗邀远岑。\n腰镰饷耕不觉老，鬓华雪领从渠侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其三","author":"曹勋","text":"当年成性独存存，闻道今为五女门。\n收拾桑榆早栖泊，香烟轻卷静朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其二","author":"曹勋","text":"一别丰姿遽六年，相望淮浙限江天。\n糟丘闻甚羊肠险，履践欣如玉色鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李伯时韵送行七首 其一","author":"曹勋","text":"公来触热冒炎云，风义凌虚独有君。\n但觉一家增喜色，便如满座揖清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李判院宿松隐见贻","author":"曹勋","text":"又看历日改新元，卦气匆匆过二年。\n老境尤于光景惜，斜阳时候每茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苏养直题孙郎中扶疏堂二首 其二","author":"曹勋","text":"马上看花梦里莺，自怜行路每劳生。\n道人犹说未自在，且是扶疏堂上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苏养直题孙郎中扶疏堂二首 其一","author":"曹勋","text":"白项鸦儿趁晓啼，梢梢寒柳出疏篱。\n未飞腊雪连天白，且看江云四面垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈彦容雪中","author":"曹勋","text":"云雪商量天四垂，花应剪水未容飞。\n旗亭有客已豪饮，江上无人空钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]