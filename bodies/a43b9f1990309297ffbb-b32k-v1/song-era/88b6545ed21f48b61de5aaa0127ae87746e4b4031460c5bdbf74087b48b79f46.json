[{"title":"吕睦仲赴诏以病不及送作诗与之","author":"彭汝砺","text":"埃尘留病枕，霜雪听晨征。\n出谷莺声早，飞云鹤翅轻。\n寒郊亦常日，物色自离情。\n二月春风信，期君万里程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"分题得思字韵寄宁文渊","author":"彭汝砺","text":"风雪今之夕，湖山百尔思。\n欲歌莺谷意，不忘鹡原诗。\n腊意生梅萼，春容动柳枝。\n尘埃一千里，归梦自迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔小饮韵","author":"彭汝砺","text":"岛屿风回北，沧溟月上东。\n苦吟诗眼碧，小酌病颜红。\n城近更筹数，天寒斗柄中。\n且安颜巷陋，无泣阮途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和润之苦吟韵","author":"彭汝砺","text":"诸公敏酬唱，顷刻听诗成。\n夜月留寒影，春花落细英。\n更须洗尘滓，莫使污晶明。\n君看少陵格，篇章句句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和庭佐观射","author":"彭汝砺","text":"勇士环云帜，将军臂角弓。\n三狐毙林曲，一雁落云中。\n百步风争疾，千夫胆丧雄。\n更须洗稂莠，归凯上边功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"彭汝砺","text":"日夕孤蟾上，天寒万象低。\n苦吟闻夜漏，端坐听晨鸡。\n大道非无径，青云自有梯。\n更须极幽隐，慎勿叹羁栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君玉林字韵","author":"彭汝砺","text":"晚日牛羊舍，清风鸟雀林。\n山蹊频下上，天色屡晴阴。\n县令三乡念，君王万里心。\n事功非翰墨，酬唱故相禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙泉","author":"彭汝砺","text":"秋风入野凉，吹散菊花芳。\n万里无人处，千枝祇自香。\n风流忆彭泽，时节念重阳。\n物意虽寥寂，能忘酒一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得老儿到叶县书寄君时","author":"彭汝砺","text":"野店鸡啼处，平安信息来。\n摇旌心未稳，披雾眼先开。\n未敢言曾子，犹能学老莱。\n分阴须爱惜，好为补南陔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐家人乞诗","author":"彭汝砺","text":"憔悴蓬门学，尘埃布褐身。\n一官偶今日，相顾守吾贫。\n上国恩波重，高门鬓雪新。\n岂无忠孝论，子细遗良人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白彪驰寄君时","author":"彭汝砺","text":"横踰紫芝路，径赴白彪期。\n翼翼马爰饬，伾伾车载脂。\n山川道云远，日月来何迟。\n立语言不尽，不言君自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时予未至君时言有群鹊集檐","author":"彭汝砺","text":"旧重千金诺，元为五日期。\n水清冰破玉，岩润石凝脂。\n命驾不嫌遽，舍车空悔迟。\n多惭无道力，有往鹊先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时约谊甫先生游龙泉失期","author":"彭汝砺","text":"昨夜天文静，重云宿少微。\n客游还不值，人事故多违。\n照月双泉落，凌风一雁飞。\n山川虽往复，难值梦魂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吏部阁子前有千叶菊因酌同僚口占一首","author":"彭汝砺","text":"一花几千叶，千叶一时开。\n晓露红云拂，春风舞雪回。\n薄言酌我酒，亦道赏花来。\n自是兰台胜，桃源安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔艇","author":"彭汝砺","text":"物物非吾事，飘飘寄此生。\n江湖万古乐，簪绂一毫轻。\n醉舞秋风静，酣歌夜月明。\n沧浪有馀地，应许濯吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上见蜀山","author":"彭汝砺","text":"明日催今日，长亭间短亭。\n久流淮水远，喜见蜀山青。\n天地飞飞雁，江湖泛泛萍。\n欲知后夜乐，樽酒上亲庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓步","author":"彭汝砺","text":"峨冠出林薮，策杖济泥涂。\n山迥迷三岛，溪长念五湖。\n归云静寒谷，落日憩平芜。\n独乐无羁束，低徊愧野夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道傍松竹","author":"彭汝砺","text":"细细松千叶，纷纷竹万枝。\n寒声落幽径，碎影出疏篱。\n冷逼风霜劲，清舍雨露滋。\n不须稂莠念，自有岁寒姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲雨","author":"彭汝砺","text":"雨势将霶霈，风声自啸号。\n柳眉含绿泪，花脸腻香膏。\n厚泽宜苏物，微寒怯减袍。\n诗成欢不足，终拟醉春醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新晴","author":"彭汝砺","text":"一雨凄凉夜，群阳发育春。\n风雷惊旧蛰，泥滓倦行人。\n花秀千家囿，波添数尺津。\n新晴何处好，郊外草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠潘山人","author":"彭汝砺","text":"病卧沧江侧，惊逢长者车。\n亦如齐扁鹊，能起蜀相如。\n惠饮囊中药，功窥肘后书。\n微吟赠行色，犹胜百车渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过扬澜","author":"彭汝砺","text":"路入扬澜险，心魂独惘然。\n秋风浪飞屋，春雨水弥天。\n一叶渔翁艇，千钧客子船。\n相争蜗角利，平地看深渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓起","author":"彭汝砺","text":"清霜群籁息，淡晓一星留。\n野竹寒方翠，溪云夜不收。\n月明山路径，霜湿布衣裘。\n羁旅令人瘁，衰羸亦自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春风","author":"彭汝砺","text":"三春含造化，一雨洒空虚。\n寒色宵无定，轻阴昼未舒。\n亭台花色重，道路马蹄疏。\n燕雀乘风便，应言莫我如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驽马","author":"彭汝砺","text":"我马固非俗，不时今亦驽。\n晨征尽迂径，夜食一乾刍。\n憔悴千金骨，迟回万里途。\n无人拂衰朽，矫首独嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中有感","author":"彭汝砺","text":"维楫阗江海，轮蹄溢道途。\n微晴困炎暑，一雨厌泥途。\n天意自虚淡，物情空叹吁。\n是非今可卜，吾意独何虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去桐江","author":"彭汝砺","text":"去去不遑息，栖栖何所归。\n红尘伤客鬓，白露点征衣。\n风雨晴时少，山川平地稀。\n梦魂留不得，一夜到庭帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病题桐江","author":"彭汝砺","text":"叹息医工拙，矜嗟旧疾牢。\n衰容虽冻雀，烈气尚惊涛。\n羁旅双尘鬓，尘埃一布袍。\n远乡滋味恶，空益梦魂劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游龙泉寺","author":"彭汝砺","text":"林边竹枝子，问法即心王。\n气挹千山秀，风吹万室凉。\n灵泉通润泽，幽鸟恣徊翔。\n雨雪翻天地，看瞻爱有常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先赴东流因寄虞蒋诸君 其一","author":"彭汝砺","text":"相爱不能去，欲行还复留。\n山川荡行色，风雨结离愁。\n红日千山晓，清霜万木秋。\n回头望车马，目断白蘋洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先赴东流因寄虞蒋诸君 其二","author":"彭汝砺","text":"我行已南北，君迹尚西东。\n车马到虽晚，道途终不同。\n山川新霁雨，天地正秋风。\n有暇诗应作，无忘草野中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中作","author":"彭汝砺","text":"穷冬尚羁旅，行色太凄凉。\n白雪园林好，红尘道路长。\n暮云寒不散，斜日淡无光。\n夜宿溪山静，清风满肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次虞逊臣江行韵","author":"彭汝砺","text":"步绕林泉侧，襟怀一洒然。\n酒酲昏易析，诗癖老难痊。\n鬨息无尘地，寒生欲暝天。\n愿期明月到，同枕碧溪眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张瑞甫贪饮韵","author":"彭汝砺","text":"霜浓溪水缩，雨过竹风多。\n久病予无赖，微吟子为歌。\n远心倾塞雁，穷绪委江波。\n贪饮祇如此，世人谁复过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题晏无党少府","author":"彭汝砺","text":"身逐尘埃际，心迷道路间。\n无聊长卧病，未老已衰颜。\n竟日千忧结，何时一息闲。\n空劳中夜梦，绕尽夕阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倒押前韵","author":"彭汝砺","text":"吾生何独扰，世事欲相关。\n愿去红尘穴，同分白日闲。\n诗赓幽意绪，酒裛病容颜。\n尚有松筠意，相期霜雪间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬熊君惠诗","author":"彭汝砺","text":"扁舟去江海，邂逅得相亲。\n趋向亦非俗，尘埃知有人。\n我心双古剑，今日独飘萍。\n空愧诗中意，相期重济民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庭佐弟与润之同作","author":"彭汝砺","text":"狂风朝不定，急雨暮相连。\n丽泽已春意，浓寒犹腊天。\n红炉双酒艇，清夜一诗篇。\n不见东江客，临风意惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至雄州寄诸弟并呈诸友 其一","author":"彭汝砺","text":"马头今日过中都，到得雄州更有书。\n道路莫嗔音问少，天寒沙漠雁全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至雄州寄诸弟并呈诸友 其二","author":"彭汝砺","text":"沙陀行尽见南山，过却中京更少寒。\n欲寄梅花无处觅，祇将书去报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子育见和前韵因寄君宜弟 其一","author":"彭汝砺","text":"荥阳知汝已还都，未得陈桥别后书。\n头鬓不干霜雪事，冬来一似草彫疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子育见和前韵因寄君宜弟 其二","author":"彭汝砺","text":"东风吹雪满千山，便似江南料峭寒。\n天意人情终是别，渐知风日近长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和国信子育元韵 其一","author":"彭汝砺","text":"雪馀税马立孱颜，望尽南垂北际山。\n一段黄云凝不散，胡人说是瓦桥关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和国信子育元韵 其二","author":"彭汝砺","text":"晓起南山暮北山，夜深归梦祇山间。\n山中亦有流泉好，不许行人洗病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和国信子育元韵 其三","author":"彭汝砺","text":"闻道朝正使入关，殷勤试托寄书还。\n逢人若问今何许，已过金钩第一山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和国信子育元韵 其四","author":"彭汝砺","text":"山谷冥冥风怒号，故吹霜雪上绨袍。\n风波末路嗟奚拙，露电浮生笑自劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和国信子育元韵 其五","author":"彭汝砺","text":"傍火时寻柏子烧，青灯笑语夜寥寥。\n殊方更喜人情好，长日不知山路遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育 其一","author":"彭汝砺","text":"易水涿山无苦寒，燕南本是旧家山。\n山头更觉尧云近，玄鸟徘徊望汉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育 其二","author":"彭汝砺","text":"将军誓愿斩楼兰，涕泪横流杯酒间。\n紫气剑埋终未试，黄金印大亦何颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育 其三","author":"彭汝砺","text":"朔风白昼不胜寒，清晓马行霜雪间。\n纵目还经望云岭，伤心不见采芝山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育 其四","author":"彭汝砺","text":"手拈弓箭膝横刀，著尽君王赐战袍。\n语及灵州心欲碎，使轺今日敢言劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子育 其五","author":"彭汝砺","text":"气血畏寒身畏劳，养生曾去问参寥。\n我今与子俱错计，霜雪正严山正遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过右北平","author":"彭汝砺","text":"太平天子不言兵，拥节来经右北平。\n论将无人思李广，笑谈樽俎倚儒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云岭","author":"彭汝砺","text":"人臣思国似思亲，忠孝从来不可分。\n更与诸君聊秣马，尽登高处望尧云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过墨斗岭闻鸟声似子规而其形非是","author":"彭汝砺","text":"有鸟羽毛非子规，向人如道不如归。\n使轺不用君多劝，未到归心已似飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其一","author":"彭汝砺","text":"追诵寒梅佳句新，东郊平昔与迎春。\n今时独赋云岩路，目断蓬莱高阁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其二","author":"彭汝砺","text":"万木低徊冰雪辰，寄声凭尔急催春。\n即看苑囿芳菲遍，还见池台歌舞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其三","author":"彭汝砺","text":"不问萧条风雨辰，一花自与物为春。\n如云不比东门女，若雪岂非姑射人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其四","author":"彭汝砺","text":"滴叶开花妙入神，酥盘忆看北堂春。\n潇湘此日堪肠断，随处幽香著莫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其五","author":"彭汝砺","text":"折得寒梅自水滨，恰如去岁在宜春。\n潇湘不见江南客，祇有花枝似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其六","author":"彭汝砺","text":"眼看梅花愁更新，到头不似故园春。\n风前一片花飞落，节物匆匆更感人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖湘路中见梅花寄子开 其七","author":"彭汝砺","text":"沙村飞雪白于云，野岸寒梅已放春。\n诗兴乡愁俱不奈，江边愁杀杜陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正仲提举 其一","author":"彭汝砺","text":"兀坐形忘入眇微，泊然无事亦无思。\n个中若得真消息，先报维摩长者知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正仲提举 其二","author":"彭汝砺","text":"一丝急急一丝迟，触物苍茫若有思。\n流水高山新作操，十年留待伯牙知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正仲提举 其三","author":"彭汝砺","text":"万事纵横似乱丝，道人莫道便无思。\n五湖风起浪如屋，祇问鸬鹚知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正仲提举 其四","author":"彭汝砺","text":"岘首人亡无限悲，高阳客散有馀思。\n急来相就一游乐，明日东西浑未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正仲提举 其五","author":"彭汝砺","text":"十年祇有一钟期，泪落相望百尔思。\n寂寞广陵无复见，崩腾霖雨几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真州江亭","author":"彭汝砺","text":"潮落淮风怒不收，升州一日到真州。\n多情杨柳能青眼，底事波澜亦白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林亭","author":"彭汝砺","text":"禽鱼惯熟见歌舞，池沼亭台应是家。\n物物眼前浑自好，不须更种芰荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云盖寺谈空亭","author":"彭汝砺","text":"天地空空无一尘，谈空可惜枉劳神。\n欲知空外谈空者，恰似梦中占梦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨寄君时弟 其一","author":"彭汝砺","text":"朝雾苍茫暮雨低，恰如梅子欲黄时。\n三分半是行人泪，莫怪行人鬓已丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨寄君时弟 其二","author":"彭汝砺","text":"灯前微雨惜黄昏，想费慈闱夜倚门。\n知汝悦亲能有道，不应惟种北堂萱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李广","author":"彭汝砺","text":"非薄今人爱古人，今人祇说李将军。\n英雄岂遂无如广，叹息寥寥久不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长垣路中","author":"彭汝砺","text":"凤鸟不鸣今几时，太平今日合来仪。\n湖塘羽族多如雪，恐是当年养鹤池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]