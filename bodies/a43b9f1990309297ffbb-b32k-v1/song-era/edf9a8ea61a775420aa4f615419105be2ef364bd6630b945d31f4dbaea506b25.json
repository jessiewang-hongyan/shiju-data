[{"title":"无题","author":"陆游","text":"金鞭朱弹忆春游，万里桥东罨画楼。\n梦倩晓风吹不去，书凭春雁寄无由。\n镜中颜鬓今如此，幕下朋俦好在不。\n箧有吴笺三万个，拟将细字写新愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日暮","author":"陆游","text":"淅淅风吹叶，凄凄雨作泥。\n鹊寒犹绕树，鸡晚自归栖。\n老病心知有，荣枯理本齐。\n端居嫌太懒，拾瓦傍蔬畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日暮自大汇村归","author":"陆游","text":"笋舆伊轧暮山昏，水败陂塘路仅存。\n出谷钟声知过寺，隔林人语喜逢村。\n庙壖荒寂新犁地，堤草凄迷旧烧痕。\n儿子念翁霜露冷，遥持炬火出柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日暮自湖上归","author":"陆游","text":"我生本亦与人同，缘薄才疏剩得穷。\n细水自鸣沙渚外，乱山时出雪云中。\n僧归独趁残钟去，人散遥怜晚渡空。\n造物陈诗信奇绝，匆匆摹写不能工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日暮南窗纳凉","author":"陆游","text":"冠盖尘沙得我憎，脱巾聊喜发鬅鬙。\n素娥东踊行空阔，清吹南来扫郁蒸。\n团扇正闲看破墨，矮床攲卧怯文藤。\n扁舟归去应尤乐，莫羡金盘赐苑冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下小酌","author":"陆游","text":"草树已秋声，郊原喜晚晴。\n风生云尽散，天阔月徐行。\n下箸槎头美，传杯瓮面清。\n追欢犹可勉，徂岁不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下自三桥泛湖归三山","author":"陆游","text":"素璧初升禹庙东，天风为我送孤篷。\n山横玉海苍茫外，人在冰壶缥缈中。\n茅舍灯青闻吠犬，蘋汀烟淡见惊鸿。\n白头尚耐清寒在，安得终年伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下独坐","author":"陆游","text":"发根萧爽受微风，徙倚阑干月正中。\n天宇了无云一点，城楼俄报鼓三通。\n庭皋簌簌吹凋叶，江渚翩翩落断鸿。\n回首人间尘土恶，骑鲸聊驻水精宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下醉题","author":"陆游","text":"黄鹄飞鸣未免饥，此身自笑欲何之。\n闭门种菜英雄老，弹铗思鱼富贵迟。\n生拟入山随李广，死当穿冢近要离。\n一樽彊醉南楼月，感慨长吟恐过悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夕","author":"陆游","text":"开户满庭雪，徐看知月明。\n微风入丛竹，复作雪来声。\n俗尘不待扫，凛然肝肺清。\n村深无漏鼓，鹤唳报三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夕幽居有感","author":"陆游","text":"五岳名山采药身，可怜骑马踏京尘。\n浮名本是挻灾物，谢事宁非得道因。\n出岫每招云结伴，巢松仍与鹤为邻。\n剑南旧隐虽乖隔，依旧柴门月色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夕睡起独吟有怀建康参政","author":"陆游","text":"月上虚堂一榻横，断香漠漠欲三更。\n隔帘清露挟秋气，绕树惊鸦啼月明。\n只怪梦寻千里道，不知愁作几重城。\n苦吟更恨知心少，西望金陵阙寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月中归驿舍","author":"陆游","text":"岁岁常为锦水行，驿前双堠惯逢迎。\n草深闲院虫相语，人静空廊月自明。\n病起酒徒嘲小户，才衰诗律愧长城。\n何时却泛耶溪路，卧听菱歌四面声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜江渎池纳凉","author":"陆游","text":"微径荒城曲，丛祠野水边。\n月能从我醉，风欲驾人仙。\n静看黏萤草，遥闻采芡船。\n热官那有此，留滞莫尤天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜泛小舟湖中三更乃归","author":"陆游","text":"落日愁思把钓钩，南邻借得采菱舟。\n湖心月上明如昼，树杪风生冷逼秋。\n壮岁功名惭汗马，暮年心事许沙鸥。\n桐江一叶真奇策，莫为儿曹作滞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水乡泛舟二首 其一","author":"陆游","text":"终朝流汗浃衣褠，怅望何时枕簟秋。\n作雨未成徒益热，举杯不醉更添愁。\n悲歌易水轻燕侠，对泣新亭笑楚囚。\n别有生涯君会否，烟波无际弄孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水乡泛舟二首 其二","author":"陆游","text":"赤日黄尘不自聊，泛溪且用沃枯焦。\n隔林犬吠村墟近，掠面风来酒力消。\n远火微茫知夜绩，长歌断续认归樵。\n扁舟不尽凌风兴，却著青鞋踏野桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭","author":"陆游","text":"日淡暑犹薄，雨馀风更清。\n翛然水亭立，试此葛衣轻。\n晒粉怜孤蝶，穿枝喜晚莺。\n谁知簿书里，也复得吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭有怀","author":"陆游","text":"渔村把酒对丹枫，水驿凭轩送去鸿。\n道路半年行不到，江山万里看无穷。\n故人草诏九天上，老子题诗三峡中。\n笑谓毛锥可无恨，书生处处与卿同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭偶题","author":"陆游","text":"凉榭闲拈玉笛吹，十年疏放负明时。\n沟中木断谁曾问，空里蓬征自不知。\n金井梧桐生昼寂，绿池蘋藻弄风漪。\n人生行乐从来事，此理何须更细推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭晚眺","author":"陆游","text":"暑雨初晴浦面宽，水亭景物卷帘看。\n联舟作阵围鱼队，屈竹成篱护芡盘。\n四海诸公半丘垄，百年几夕倚阑干。\n日沈未用匆匆去，待挽银河濯肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牛饮市中小饮呈坐客","author":"陆游","text":"牛饮桥头小市东，店门系马一尊同。\n已能自置功名外，尚欲相期意气中。\n褐拥紫茸迎晓日，酒翻红浪醉春风。\n从今共约无疏索，竹外梅花欲恼公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王与道尚书挽词二首 其一","author":"陆游","text":"朗朗百间屋，汪汪千顷陂。\n直能彰主圣，清不愿人知。\n许国多艰日，逢辰独断时。\n人犹望霖雨，殄瘁不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王与道尚书挽词二首 其二","author":"陆游","text":"昔遇开藩日，尝叨下榻荣。\n从容陪宴笑，倾倒及平生。\n借誉言犹在，怀知涕易横。\n终惭五字句，不尽百年情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王成之给事挽歌辞二首 其一","author":"陆游","text":"昔溯黄牛峡，曾经白鹭洲。\n从容参步武，谈笑极风流。\n晚预蓬莱客，时从禊祓游。\n挥毫看半醉，追想只添愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王成之给事挽歌辞二首 其二","author":"陆游","text":"诗骚湘水客，风度曲江公。\n一夕南楼去，千秋东省空。\n囊封震朝右，墨敕绝宫中。\n赠极文昌贵，君恩厚饰终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王给事饷玉友","author":"陆游","text":"散发萧然蒲苇林，马军送酒慰孤斟。\n江河不洗古今恨，天地能知忠义心。\n无侣有时邀落月，放狂连夕到横参。\n玉船湛湛真秋露，却恨鹅儿色尚深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见事","author":"陆游","text":"流光莫恨去联翩，见事还疑胜昔年。\n细改新诗须枕上，少留剧饮待花前。\n阴阴竹坞安茶灶，浅浅蘋汀著钓船。\n物外家风吾岂敢，散人名号亦充员。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"计子布归程已过新安入畿县界","author":"陆游","text":"忆昔初登下峡船，一回望汝一凄然。\n梦魂南北略万里，人世短长无百年。\n强遣老怀终兀兀，忽闻归骑已翩翩。\n今朝屈指无穷喜，历尽江山近日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"车中作","author":"陆游","text":"秋天近霜霰，吴地少风尘。\n时驾小车出，始知闲客真。\n新交孰倾盖，往事漫沾巾。\n处处皆堪隐，桃源莫问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"车中作","author":"陆游","text":"雨过未生尘，寒轻不著人。\n断云飞苑路，高柳暗天津。\n憔悴非平日，呻吟又一春。\n丝毫宁有补，空负耦耕身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩花时将过感怀二首 其二","author":"陆游","text":"社雨晴时燕子飞，园林何许觅芳菲。\n江山良是人谁在，天地无私春又归。\n残史有期成汗简，修门即日挂朝衣。\n人生念念皆堪悔，敢效渊明叹昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩花时将过感怀二首 其一","author":"陆游","text":"小轩风月得婆娑，尽付流年与啸歌。\n细数一春今过半，正令百岁亦无多。\n还家常恐难全璧，阅世深疑已烂柯。\n只欲闭门支倦枕，晚风无奈落花何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长木晚兴","author":"陆游","text":"沮水嶓山名古今，聊将行役当登临。\n断桥烟雨梅花瘦，绝涧风霜槲叶深。\n末路清愁常衮衮，残冬急景易骎骎。\n故巢东望知何处，空羡归鸦解满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长汀道中","author":"陆游","text":"晚过长汀驿，溪山乃尔奇。\n老夫惟坐啸，造物为陈诗。\n鸟送穿林语，松垂拂涧枝。\n凭鞍久忘发，不是马行迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨","author":"陆游","text":"残暑时当尽，清风势自回。\n重云韫日月，大雨挟风雷。\n老树不自保，毁巢吁可哀。\n却愁新雁到，暮境更禁催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨","author":"陆游","text":"七十年来乐太平，白头父子事春耕。\n因思世事悲身事，更听风声杂雨声。\n四海故人强半死，一襟清泪对谁倾。\n新春要觅烧丹处，不住青城住赤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨","author":"陆游","text":"风雨连三日，衰翁不下堂。\n弄书聊自适，与世已相忘。\n坼栗经霜饱，搓橙带露香。\n地炉供小饮，亦足慰凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨中过龙洞阁","author":"陆游","text":"飘然醉袖怒人扶，个里何曾有畏涂。\n卷地黑风吹惨澹，半天朱阁插虚无。\n阑边归鹤如争捷，云表飞仙定可呼。\n莫怪衰翁心胆壮，此身元是一枯株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨旬日春后始晴","author":"陆游","text":"风吹过雁作斜行，雨洗残梅只淡香。\n南浦春回波渐绿，东庵睡起日初长。\n诗囊属稿惭新思，博齿争豪悔昔狂。\n莫向晴窗对明镜，朱颜减尽鬓苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨夜坐","author":"陆游","text":"寒风凄紧雨空濛，舍北新丹数树枫。\n攲枕旧游来眼底，掩书馀味在胸中。\n松明对影谈玄客，筱火围炉采药翁。\n君看龟堂新境界，固应难与俗人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风顺舟行甚疾戏书","author":"陆游","text":"昔者远戍南山边，军中无事酒如川。\n呼卢喝雉连暮夜，击兔伐狐穷岁年。\n壮士春芜卧白骨，老夫晨镜悲华颠。\n可怜使气尚未减，打鼓顺流千斛船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风霜","author":"陆游","text":"天上风霜惨，人间日月遒。\n江湖南北雁，原野雨晴鸠。\n莽苍新阡陌，凋零旧辈流。\n惟应赤藤杖，伴我送悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世上","author":"陆游","text":"世上悠悠东逝波，金丹将奈鬓丝何。\n墙头杨柳知秋早，窗外芭蕉受雨多。\n伏枥自应如老骥，还乡元欲借明驼。\n吾棋一局千年事，从使旁观烂斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世事","author":"陆游","text":"世事如今尽伏输，面能乾唾况其馀。\n诗才退后愁强韵，眼力衰来怯细书。\n敛迹已思焚笔砚，作劳敢避把犁锄。\n晴空万里宽多少，一片闲云足卷舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世事","author":"陆游","text":"世事说来犹可厌，宦情梦里亦应无。\n山林已结三生愿，朝市谁非九折途。\n醉舞杯盘无藉在，狂吟风月不枝梧。\n何人今擅丹青艺，为画苏门长啸图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世事","author":"陆游","text":"世事本难全，吾生已愧天。\n借书常稛载，馈酒亦蝉联。\n饘粥随时具，湖山此地偏。\n残年更何慕，未死即神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙辰上元前一日","author":"陆游","text":"弊裘破帽发鬅鬙，宛似山房罢讲僧。\n身病不禁连夜雨，家贫只挂旧年灯。\n修椽柳外掀楼角，危槛云间露塔层。\n自笑闲游本无定，兴阑随处倚枯藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙寅元日","author":"陆游","text":"缥缈初闻寺阁钟，霏微零雨兆年丰。\n家家椒酒欢声里，户户桃符霁色中。\n春枕方浓从卖困，社醅虽美倦治聋。\n从今万事俱抛掷，且作人间百岁翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东门外遍历诸园及僧院观游人之盛","author":"陆游","text":"马上哦诗画醉鞭，东城南陌去翩翩。\n微风蹙水鱼鳞浪，薄日烘云卵色天。\n隔屋鸠鸣闲院落，争门花簇小辎軿。\n病来久已疏杯酌，春物撩人又破禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东屯呈同游诸公","author":"陆游","text":"十月霜雕枫树林，清溪白石称幽寻。\n按行老子诛茆地，惆怅孤臣许国心。\n走马平沙嫌路近，传杯小阁喜寒侵。\n也思试索梅花笑，冻蕊疏疏欲不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东关二首 其二","author":"陆游","text":"云蹙鱼鳞衬夕阳，放翁系缆水云乡。\n一筇疾步人惊健，斗酒高歌自笑狂。\n风暖市楼吹絮雪，蚕生村舍采桑黄。\n东阡南陌无穷乐，底事随人作许忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东关二首 其一","author":"陆游","text":"路入东关物象奇，角巾老子曳筇枝。\n蚕如黑蚁桑生后，秧似青针水满时。\n穿市不嫌微雨湿，过溪翻喜坏桥危。\n当年野店题诗处，又典春衣具午炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园","author":"陆游","text":"车马无声客到稀，荷锄终日在园扉。\n断残地脉疏泉过，穿透天心得句归。\n对镜每悲鸾独舞，绕枝谁见鹊南飞。\n悠然自适君无怪，文史如山暂解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园","author":"陆游","text":"晨起东园去，消磨夏日长。\n随锄泉眼出，上爪药苗香。\n琴挂山斋壁，龟支道室床。\n始知彭泽令，真足傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园小饮四首 其四","author":"陆游","text":"乞得残骸老故山，草亭终日对孱颜。\n孤云百尺起江际，幽鸟数声鸣竹间。\n众死一身今独健，人忙万物本常闲。\n此心欲语知谁听，赖有渔樵日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园小饮四首 其一","author":"陆游","text":"少年万里走尘埃，归卧柴荆昼不开。\n十事真成九败意，一春知复几衔杯。\n波清凭槛观鱼乐，风紧钩帘待燕回。\n催唤比邻同晚酌，旋烧筀笋摘青梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园小饮四首 其二","author":"陆游","text":"入东又见几春风，茆屋芦藩寂寞中。\n道业虽如诗不进，世缘已与梦俱空。\n高枝濯濯辛夷紫，密叶深深踯躅红。\n村巷断无轩盖到，一樽犹得伴邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园小饮四首 其三","author":"陆游","text":"三月园林日渐长，闲从邻曲答年光。\n酴醾独殿群芳后，醽醁能令万事忘。\n下豉莼羹誇旧俗，供盐梅子喜初尝。\n乌靴席帽知何乐，自古京尘眯眼黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园观梅","author":"陆游","text":"出世仙姝下草堂，高标肯学汉宫妆。\n数苞冷蕊愁浑破，一寸残枝梦亦香。\n问讯不嫌泥溅屐，端相每到月侵廊。\n高楼吹角成何事，只替诗人说断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园晚步","author":"陆游","text":"久客天涯忆故园，彊名官寺只衡门。\n秋桐蠹遍无全叶，古柳吹斜出半根。\n痛饮每思尊酒窄，微官空羡布衣尊。\n何时定下三巴去，思卧孤舟听断猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村","author":"陆游","text":"塘路东头乌桕林，偶携藤杖得幽寻。\n桃源阡陌自来往，辋口云山无古今。\n远浦过帆供极目，暮天横雁入微吟。\n归来更觉愁无那，剩放灯前酒椀深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村","author":"陆游","text":"信脚村墟路，归来日未西。\n波清鱼队密，风小鹊巢低。\n白水初平岸，青芜亦遍犁。\n市垆多美酒，饮具不须赍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村","author":"陆游","text":"雨霁山争出，泥乾路渐通。\n稍从牛屋后，却过鹳巢东。\n决决沙沟水，翻翻麦野风。\n欲归还小立，为爱夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村步归二首 其二","author":"陆游","text":"风阵鸦翻黑，霜林叶半丹。\n筋骸欣小健，裘褐戒初寒。\n代步鸡栖足，充饥鹤料宽。\n平生自如许，况已挂吾冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村晚归","author":"陆游","text":"蜀道还吴鬓已丝，历年二纪固应衰。\n宁知病思沉绵日，又见秋风摇落时。\n锦雉白鱼供野饷，青林红树入新诗。\n东村寂寂风烟晚，酒挂驴肩又一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]