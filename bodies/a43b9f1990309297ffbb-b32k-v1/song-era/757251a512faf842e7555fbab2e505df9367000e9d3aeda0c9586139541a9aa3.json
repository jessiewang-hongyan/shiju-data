[{"title":"梅花集句 其一八六","author":"李龏","text":"旅馆谁相问，霜晴冻叶飞。\n花当陇上发，边色满戎衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一八七","author":"李龏","text":"风起塞云断，飞花入户香。\n孤城吹角罢，一镜有愁霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一八八","author":"李龏","text":"梅落经霜霰，云连京国深。\n金罍列四座，春色岂知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一八九","author":"李龏","text":"池草艳春色，流芳复满园。\n只应连夜雨，花落拥篱根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九○","author":"李龏","text":"世上树桃李，逢春解惜春。\n不知春色早，对此合伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九一","author":"李龏","text":"逆旅相逢处，冥冥花正开。\n今朝与君醉，不辨越王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九二","author":"李龏","text":"野渡人初过，人悲花自闲。\n歌声随绿水，春满杏花山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九三","author":"李龏","text":"旧雪逐泥沙，惊雷长荻芽。\n低檐一枝在，恐有夜来花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九四","author":"李龏","text":"一点白如雪，玄机未易窥。\n岁华摇落尽，空把月中枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九五","author":"李龏","text":"病见岩花发，风霜一岁残。\n月斜寒影动，清比玉堪餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九六","author":"李龏","text":"高树梅初发，城隅古谢村。\n况多秋藓色，巧咏任人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九七","author":"李龏","text":"落日明深坞，新移棘补篱。\n野花春后发，独自立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九八","author":"李龏","text":"画閤馀寒在，花明绮陌春。\n今年看花伴，东去汶阳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其一九九","author":"李龏","text":"无处写幽怀，前山雪未开。\n一阶春草碧，偶到树边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○○","author":"李龏","text":"数枝寒照水，幽意日相亲。\n爱此无他客，遥将寄野人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○一","author":"李龏","text":"渔舸汀鸿外，霜天似水清。\n更无花上月，新句与谁评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○二","author":"李龏","text":"枯株围古寺，老怪昔谁栽。\n水国花开早，疏花晚自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○三","author":"李龏","text":"问得梅花信，新晴花气香。\n戏赓和靖句，炙背负斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○四","author":"李龏","text":"触处是花开，孤高不受埃。\n春风别有意，时有暗香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○五","author":"李龏","text":"几度寻春信，亲曾到石桥。\n寒云拂缟夜，恨不坐通宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○六","author":"李龏","text":"旅望因高尽，江春入旧年。\n纷纷对寂寞，花隔杜陵烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○七","author":"李龏","text":"捲帘清梦后，静角掩山城。\n气射灯花落，饥肤片玉明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○八","author":"李龏","text":"积雪暮山寒，枝枝入肺肝。\n高风吹不尽，一半更须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二○九","author":"李龏","text":"雪消春力展，林雪似芳菲。\n独映孤松色，烦君问是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二一○","author":"李龏","text":"蠹根停雪水，花落钓人头。\n万里猿频断，春风亦似秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二一一","author":"李龏","text":"鸟喧金谷树，惟此出尘埃。\n古戍鸣寒角，池塘暗不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花集句 其二一二","author":"李龏","text":"人情皆共惜，勿谓少知音。\n若问阳台客，曾供雪夜吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谪仙吟","author":"李龏","text":"空白凝云颓不流，牧龙丈人病歌秋。\n寻诗北岭截珠树，老夫饥寒龙为愁。\n呼龙耕烟种瑶草，若为失意居蓬岛。\n泓泓水绕青苔洲，鲤鱼风起芙蓉老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公无渡河","author":"李龏","text":"屈平沉湘不足慕，公无渡河兮公苦渡。\n行搔短发提壶浆，玉白兰芳不相顾。\n惊波不在黤黮间，颜色错漠生风烟。\n其下无底旁无边，何用将身自弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长安春","author":"李龏","text":"春欲来，日日望春门早开。\n花台欲暮春辞去，禁城烟暖蒸青苔。\n龌龊浮生如走电，客舍似愁谁遣来。\n夜夜抱冰寒不睡，流光暂出还入地。\n门外平桥连柳堤，落花声里仙娥醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行路难","author":"李龏","text":"君不见长安城北渭桥边，长安恶少不少钱。\n飞窗复道传头饮，金鲸泻酒如飞泉。\n春风细雨走马去，鸣鞭晚出章台路。\n半垂衫袖揖金吾，谁道黄金如粪土。\n床头黄金尽，中门为异域。\n骨肉且不顾，促刺复促刺。\n世路有趋竞，人无一定颜。\n何处是平地，暗水自波澜。\n君不见建章宫中金明枝，春花落尽蜂不窥。\n双轮晚上铜梁雪，当春对酒不须疑。\n行路难，君好看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞上北风行","author":"李龏","text":"北风叫枯桑，玉沙粼粼光。\n天寒山路石断裂，驻马相看辽水傍。\n军容带甲三十万，都护宝刀冻欲断。\n旄头夜落捷书飞，少年金紫就光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴娃歌","author":"李龏","text":"洞庭明月一千里，芙蓉水殿春风起。\n残丝欲断黄蜂归，鸳鸯翡翠承燕私。\n露脚斜飞湿寒兔，越王金鸡报天曙。\n官街柳带不堪折，谢豹空啼采香月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致酒行","author":"李龏","text":"零落栖迟一杯酒，绿凸蛮觥奉君寿。\n湖花江月前后邻，寒风又变为春柳。\n离鸾别凤烟梧中，曦轮送客沟水东。\n霜白松溪转斜盖，世间何处无春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"采莲归","author":"李龏","text":"采莲女，采莲归。\n落日晴江里，莲舟渐觉稀。\n莲茎有刺不成折，争弄莲花水湿衣。\n白练束腰袖半卷，不语低鬟幽思远。\n碧玉搔头落水中，粉痕零落愁红浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪上春","author":"李龏","text":"黄璈散珠层殿曛，东方风来满眼春。\n龙蛇洗鳞春水暖，薇帐逗烟生绿尘。\n古人花为今人发，溪女洗花染白云。\n赤水阆风谁是主，西山日没东山昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋闺思","author":"李龏","text":"征人遥遥出古城，天河夜转漂回星。\n银缕香寒凤皇薄，树色深含台榭情。\n雨滋苔藓侵阶绿，为有秋期眠不足。\n城边残月势如弓，月下丁东捣寒玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"京洛篇","author":"李龏","text":"东望龙门北朝市，甲第千甍分戚里。\n朱门峨峨临九衢，垂柳金丝香拂水。\n毗陵震泽九州通，董贤女弟在椒风。\n周公旧迹生红藓，九泉寂寞葬秋虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦上天","author":"李龏","text":"驭凤升昆崙，梦上高高天。\n云楼半开壁斜白，蓬莱宫殿玉炉烟。\n春罗书字邀王母，绿章封事咨元父。\n鸿珑九关朝玉皇，大道无言暗相许。\n身不沉，骨不重，半空回首晨鸡弄。\n寒绿幽风生短丝，春雷蛰蛰龙蛇动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"空城曲","author":"李龏","text":"玉转湿丝牵晓水，昔日住人今住鬼。\n东家胡蝶西家飞，星流露泫谁驱使。\n秋风吹地百草乾，兔苑词人去不还。\n谁念幽寒坐呜呃，长忆深云海上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短歌行","author":"李龏","text":"日月出又没，贵贱同一尘。\n求荣不求辱，利欲相纷纶。\n鲸鱼张鬣海水沸，拟学长生更容易。\n不知中有长恨端，秦亡祖龙失天地。\n野草白根肥，凤雏长忍饥。\n人生过五十，何用假光辉。\n四时相催节回换，乌头虽黑有白时。\n一尊绿酒绿于染，有歌有舞闻早为。\n庭前芳树朝夕改，可叹年光不相待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒿里曲","author":"李龏","text":"古人今人留不住，六街马蹄浩无主。\n丧车辚辚入秋草，丘垄年年无旧道。\n天娃剪霞铺晓空，幽愁秋气上青枫。\n寒食家家送纸钱，纸钱那得到黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌夜啼","author":"李龏","text":"众鸟各归枝，落花香满泥。\n狭斜柳树乌争宿，夜夜夜半当户啼。\n浮萍摇荡门前水，九节菖蒲石上死。\n感郎中夜渡潇湘，恩光暗入帘栊里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公无出门","author":"李龏","text":"天迷迷，地密密，海漫漫。\n身若仓中鼠，迟回出门难。\n大道冥冥不知处，小人心里藏崩湍。\n我亦为君长叹息，炊沙作饭岂堪吃。\n棘针生猛义路闲，太华磨成一拳石。\n不惧天地倾，津涯浩难识。\n龙蟠泥中未有云，封狐雄虺自成群。\n人生结交在终始，细人何言入君耳。\n归卧东窗兀然醉，任他上是天，下是地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少年行","author":"李龏","text":"丈夫十八九，骢马拂绣裳。\n倒插银鱼袋，陪游出建章。\n醉下酒家楼，轩车满垂杨。\n君王正年少，无人荐冯唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"远别离","author":"李龏","text":"太湖三山口，中有西行舟。\n望望不相近，望中生远愁。\n重露湿苍苔，秋风散杨柳。\n空藏兰蕙心，离恨如旨酒。\n碧纱窗外叶骚骚，三更风作切梦刀。\n千里万里独为客，少年心事风中毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铜雀妓","author":"李龏","text":"泪眼看花枝，齐行奠玉杯。\n日暮铜雀迥，歌舞妾空来。\n悲心舞不成，恨唱歌声咽。\n君王去后行人绝，但见西陵惨明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江南思","author":"李龏","text":"妾家白蘋浦，柳恽乘马归。\n恰值清风起，朱服弄芳菲。\n离居不自堪，留情此芳甸。\n临醉欲拚娇，恶许傍人见。\n相逢恐相失，徘徊双明珰。\n归时不觉夜，要使两情伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"折杨柳","author":"李龏","text":"万里边城地，垂杨二月春。\n年华枝上见，日暮客愁新。\n露叶疑啼脸，风花思舞巾。\n玳梁谁道好，持此寄情人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜曲","author":"李龏","text":"秋夜长，殊未央。\n秋灯向壁掩洞房，天汉东西月色光。\n啼蛄吊月钩栏下，寒衣未寄莫飞霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出塞","author":"李龏","text":"单于寇井陉，进军飞狐北。\n沙昏夜探迟，远树深疑贼。\n胡霜损汉兵，不妨得头白。\n功成须献捷，会勒燕然石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老妇吟","author":"李龏","text":"万转愁成系肠线，青亩春芜连石苑。\n为他人作嫁衣裳，头白如丝面如茧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒女叹","author":"李龏","text":"国色久在室，寒女不自知。\n安得长不老，为君玄鬓衰。\n我有古时镜，一照一回悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怨诗二首 其一","author":"李龏","text":"绿蔓花绵绵，日晚梧桐落。\n所思终不来，虫声入罗幕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怨诗二首 其二","author":"李龏","text":"洞房秋月明，玉关芳信断。\n含怨倚兰丛，日惊罗带缓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过台城","author":"李龏","text":"云惨烟愁苑路斜，马嘶残日没残霞。\n绕篱野菜飞黄蝶，宫殿馀基长草花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵春日","author":"李龏","text":"登临吟望思无穷，折尽青青赏尽红。\n白鸟影从江树没，数峰春色在云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食日花宴","author":"李龏","text":"万象鲜明禁火前，红英翠萼簇芳筵。\n残春未必多风雨，少别秾华又隔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上赠新得意者","author":"李龏","text":"湖上新正逢故人，天明骑马入红尘。\n凭君莫话封侯事，栲栳量金买断春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惆怅诗 其一","author":"李龏","text":"觉来灯背锦屏空，自爱残妆晓镜中。\n寂寞闲庭春欲晚，垂杨无力受东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惆怅诗 其二","author":"李龏","text":"绣林红岸落花钿，目极云霄思浩然。\n漳浦病多愁易老，满庭榆荚似秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初夏偶赋","author":"李龏","text":"野烟乔木弄残晖，虚室无人乳燕飞。\n正是清和好时节，青丛花尽蝶来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿建溪","author":"李龏","text":"树侵闽岭渐无霜，一望繁花一县香。\n寂寞舟中谁借问，隔帘微月入中仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日松陵道中","author":"李龏","text":"烟岸人稀草色中，火天无处买清风。\n西南一望云和水，万树鸣蝉隔断虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋晚泊吴江塔院寄王抱节","author":"李龏","text":"雨后沙虚古岸崩，水风霜气夜棱棱。\n冷烟粘柳蝉声老，高塔晴来独自登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔人野祭","author":"李龏","text":"婆官赛却坐江隈，烟水悠悠霁景开。\n精魄不知何处在，野风吹起纸钱灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬左行之金陵夕游","author":"李龏","text":"宫城日晚度寒鸦，新意虽多旧约赊。\n商女不知亡国恨，恨君嗔折后庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书山居女冠绣楼","author":"李龏","text":"一渠流水数家分，弦管楼中永不闻。\n灯下此心谁共说，紫烟衣上绣春云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪 其一","author":"李龏","text":"细玉罗纹下碧霄，萦丛自学小梅娇。\n闲吟只爱煎茶澹，旋斫生柴带叶烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪 其二","author":"李龏","text":"密片无声急复迟，夜来谁向月中归。\n江湖不见飞禽影，寒锁侯门见客稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三衢道中","author":"李龏","text":"桂玉愁居帝里贫，南行无罪似流人。\n橘村篱落香潜度，渐觉生衣不著身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天城贵家妓","author":"李龏","text":"龙山晴雪凤楼霞，烟水初消见万家。\n宝枕垂云选春梦，隔帘微雨湿梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送通上人谒贾寺丞","author":"李龏","text":"进乏梯媒退又难，近因多难怕长安。\n相知莫话诗心苦，乞取新诗合掌看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与郑澹然","author":"李龏","text":"曾是朱门寄食身，一生生计祇长贫。\n清闲自可齐三寿，他日相逢乞药银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]