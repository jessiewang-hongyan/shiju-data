[{"title":"小舟晚归二首 其一","author":"陆游","text":"扶病寻溪友，忘忧泛钓槎。\n渚寒无宿鹭，月白有啼鸦。\n败壁青灯暗，幽窗稚子哗。\n无生未暇说，且复议桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小舟游西泾度西冈而归","author":"陆游","text":"小雨重三后，馀寒百五前。\n聊乘瓜蔓水，闲泛木兰船。\n雪暗梨千树，烟迷柳一川。\n西冈夕阳路，不到又经年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陆游","text":"新作小溪园，牵藤迮缚门。\n钓船横北渚，樵路接东村。\n静坐依林樾，慵眠傍竹根。\n还家日已夕，栖雀闹黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陆游","text":"窄窄柴门短短篱，山家随分有园池。\n客因问字来携酒，僧趁分题就赋诗。\n晨露每看花藟坼，夕阳频见树阴移。\n拂衣司谏犹忙在，此趣渊明却少知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陆游","text":"谁为闲愁拨不开，小园也复有池台。\n清泉白石皆吾友，绿李黄梅尽手栽。\n冲雨茭鸡时上下，近人栗鼠不惊猜。\n自怜两屦犹轻捷，不待儿扶日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陆游","text":"小园草木手栽培，袤丈清池数尺台。\n拄杖倦时闲倚壁，芳醪熟后喜传杯。\n春芜满地鹿忘去，夏木成阴莺自来。\n堪笑山童惭饱食，时时走报一花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陆游","text":"萧散遗尘事，栽培得小园。\n土松花意活，林暖鸟言繁。\n餐酪供晨钵，菹芹荐晚樽。\n馀年君莫问，送老向孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陆游","text":"松菊仅三亩，作园真强名。\n驯禽惊不去，熟果坠无声。\n倦就盘陀坐，闲拈楖栗行。\n茅亭亦疏豁，凭槛看春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园花盛开","author":"陆游","text":"厌住愁城徙醉乡，春风也肯到山房。\n鸭头绿涨池平岸，猩血红深杏出墙。\n淡薄相遭心已懒，修行无力梦犹狂。\n更嗟著句多尘思，惭愧溪藤似截肪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园独立","author":"陆游","text":"草香无处觅，花嫩不禁飞。\n泽国春归晚，柴门客过稀。\n新泥添燕户，细雨湿莺衣。\n倚杖临阶久，衰翁气力微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园独酌","author":"陆游","text":"横林摇落弄微丹，深院萧条作小寒。\n秋气已高殊可喜，老怀多感自无欢。\n鹿初离母斑犹浅，橘乍经霜味尚酸。\n小酌一卮幽兴足，岂须落佩与颓冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园新晴二首 其二","author":"陆游","text":"衰病犹烦药石功，残春终日在园中。\n地偏幽草为谁绿，雨霁新花如许红。\n足蹇扶持须稚子，杯深暖热赖邻翁。\n此身虽向闲中老，若比休休却未同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小轩","author":"陆游","text":"四面山如碧玉城，小轩聊得惬幽情。\n乍飞乳燕低无力，自落来禽静有声。\n麟笔残功成水品，蛇图馀思入棋枰。\n闲中事业吾能了，未恨林庐送此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小轩夏夜凉甚偶得长句呈杜叔高秀才","author":"陆游","text":"遥夜帘栊已借秋，阑干星斗挂檐头。\n鹊翻清影移枝宿，萤弄孤光拂簟流。\n榻上琴书纷枕籍，发根风露冷飕飗。\n故人莫笑幽居陋，此夕真从造物游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小饮","author":"陆游","text":"莫笑放翁颠，歌呼覆酒船。\n双螯初斫雪，珍鲞已披绵。\n寒雨连旬日，新橙又一年。\n更须重九到，作意菊花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小饮示座中","author":"陆游","text":"镜里萧萧两鬓衰，闲人正与老相宜。\n谁知剪烛焚香夜，恰是搓橙破橘时。\n莫道闭门无逸气，尚能为客诵新诗。\n君看江海宽多少，是处皆堪理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小饮房园","author":"陆游","text":"宦游到处即忘家，况得闲身管物华。\n疏索故人缘病酒，折除厚禄为看花。\n泥新高栋初巢燕，萍匝荒池已集蛙。\n斟酌人生要行乐，灯前起舞落乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小饮赵园","author":"陆游","text":"少年结骑厌追欢，渐老方知一笑难。\n邂逅偶能成午醉，登临未觉怕春寒。\n高林横霭丹青幅，乱蝶争花锦绣团。\n满眼风光索弹压，酒杯须似蜀江宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小饮罢行至湖塘而归","author":"陆游","text":"社酒真如粥面浓，朱颜顷刻换衰容。\n霜轻已觉树摇落，云起始知山叠重。\n梅市鱼归冲雨棹，宝林人定隔城钟。\n此翁大似游僧样，炉暖窗深又过冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小饮梅花下作","author":"陆游","text":"脱巾莫叹发成丝，六十年间万首诗。\n排日醉过梅落后，通宵吟到雪残时。\n偶容后死宁非幸，自乞归耕已恨迟。\n青史满前闲即读，几人为我作蓍龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小径登东山缭行自西北至溪上","author":"陆游","text":"行穿荦确度谽谺，小立风中客袖斜。\n衰草双双点飞蝶，长空一一送栖鸦。\n荻洲薄暮收鱼网，茆舍初寒响纬车。\n谁道老人多感慨，未妨尊酒乐年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨","author":"陆游","text":"细细湿春光，霏霏破夕阳。\n卧闻惊倦枕，起看入虚堂。\n映叶莺犹啭，争泥燕正忙。\n闲愁无遣处，谁与共飞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨","author":"陆游","text":"小雨明复暗，馀寒去又来。\n新苔缘砌上，残杏过篱开。\n垂老身馀几，逢春心尚孩。\n江天近寒食，林外过轻雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨二首 其二","author":"陆游","text":"急雨方侵幔，斜晖忽满廊。\n尘清添草色，衣润省篝香。\n妇织将收茧，农功已下秧。\n诸孙入家塾，亲为授三苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨","author":"陆游","text":"赤日炎熇势未回，川云忽起亦佳哉。\n鸭冲细雨桥阴出，蝶弄微风草际来。\n榉柳不禁朝暮久，芙蕖犹有二三开。\n一年光景烦君看，何怪昆池有劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨二首 其一","author":"陆游","text":"小雨过岩扃，残云傍野亭。\n花光相映发，莺语苦叮咛。\n举酒和神气，弹琴悦性灵。\n索居朋友绝，得句遣谁听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨云门溪上","author":"陆游","text":"好雨疏疏压暮埃，断云漠漠带春雷。\n离黄穿树语断续，翠碧衔鱼飞去来。\n生菜入盘随冷饼，朱樱上市伴青梅。\n狂吟不是誇强健，老气如山未许摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨出西门五里至东岳庙","author":"陆游","text":"埋没文书每自怜，偷闲出郭一欣然。\n稻陂雨细丰年候，槐陌风清嫩暑天。\n心似春鸿宁久住，身如秋扇合长捐。\n平生士雅今亡恙，老病何由共著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨舟过梅市","author":"陆游","text":"故故催诗衬雨篷，悠悠破梦隔云钟。\n遥看渔火两三点，已过暮山千万峰。\n老矣自应埋病骨，归哉莫念抗尘容。\n停桡小住青枫岸，吴市高人傥可逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨初霁","author":"陆游","text":"归来偶似老渊明，消渴谁怜病长卿。\n小雨染成芳草色，好风吹断画檐声。\n剪灯院落晨犹冷，卖酒楼台晚旋晴。\n莫道此翁游兴懒，兰亭禹寺已关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨泛镜湖","author":"陆游","text":"吾州清绝冠三吴，天写云山万幅图。\n龙化庙梁飞白雨，鹤收仙箭下青芜。\n菱歌袅袅遥相答，烟树昏昏淡欲无。\n端办一船多贮酒，敢辞送老向南湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨钓归","author":"陆游","text":"雨点鸣丛苇，云头冒远山。\n儿曹出篱望，老子榜舟还。\n润入园畦里，凉生窗户间。\n秋阳方可畏，徙倚一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雨颇寒","author":"陆游","text":"冬温初喜一寒新，纸阁砖炉养病身。\n残雨已收犹点滴，断云欲散更轮囷。\n衣裳可典宁留笥，口腹虽馋肯累人。\n一事明朝差似乐，探梅闲岸接䍦巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小亭","author":"陆游","text":"除地编茅作小亭，一川风露对青冥。\n残萤欲尽犹穿户，落叶初飞已满庭。\n栎老无心求匠石，鬼灵有说拒奴星。\n馀年默数能多少，尽付黄庭两卷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小垒","author":"陆游","text":"小垒荒寒外，高斋寂寞中。\n贫妨挂冠快，病减读书功。\n桥断春江白，云穿夕照红。\n悠然扶杖处，岁月叹匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小室","author":"陆游","text":"术浅难医忘，文疏不送穷。\n诗囊逢厄运，药裹少新功。\n小室香凝碧，明窗日射红。\n邻翁来问疾，少话莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小室","author":"陆游","text":"小室仅容膝，焚香观昨非。\n出门宁有碍，知我正须希。\n霜橘争棋乐，仙壶卖药归。\n平生钓竿手，不解叩黄扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小室","author":"陆游","text":"地褊焚香室，窗昏酿雪天。\n烂炊二龠饭，侧枕一肱眠。\n身似婴儿日，家如太古年。\n狸奴不执鼠，同我爱青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小室","author":"陆游","text":"窗几穷幽致，图书发古香。\n尺池鱼鱍鱍，拳石树苍苍。\n老去身犹健，秋来日自长。\n养生吾岂解，懒或似嵇康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小室晚酌","author":"陆游","text":"病不禁寒怯早霜，东斋随事具杯觞。\n清时宽大何妨醉，白首龙钟未减狂。\n枝叶扶檠山果熟，盐醯调适野蔬香。\n兴阑径觅华胥路，枕藉图书满一床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小阁纳凉","author":"陆游","text":"侵床月白病全苏，掠面风清酒欲无。\n渺渺塘阴下鸥鹭，萧萧秋意满菰蒲。\n纵输烟渡横孤艇，也胜京尘暗九衢。\n莫遣良工更摹写，此诗端是卧游图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小院","author":"陆游","text":"小院回廊夕照明，放翁宴坐一筇横。\n铜匜暖彻香初过，铁杵声清药欲成。\n世事熟看无一可，古人不作与谁评。\n新凉社酒家家熟，便用阳狂了此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小凉","author":"陆游","text":"羸躯一夏困沉绵，不在林间即水边。\n高卧已忘浮世事，小凉渐近早秋天。\n桔槔轧轧鸣幽圃，舴艋遥遥入暮烟。\n馀日无多那讳得，逢人自笑说明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小圃","author":"陆游","text":"剡曲西边筑草堂，小园聊复寄相羊。\n鱼行水际汀蘋动，麝过林中野草香。\n觅句有时携笔砚，遣怀随事具杯觞。\n少年朋旧凋零尽，不独思人亦自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小圃独酌","author":"陆游","text":"少时裘马竞豪华，岂料今为老圃家。\n数点霏微社公雨，两丛闲淡女郎花。\n诗成枕上常难记，酒满街头却易赊。\n自笑迩来能用短，只将独醉作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小圃醉中作","author":"陆游","text":"摇落园林探借春，耄期诗酒肯输人。\n狂时湖海犹嫌迮，达处羲农亦未淳。\n木叶蔽身如盛服，藜羹加糁即常珍。\n巢由尚隐唐虞代，漫道桃源是避秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小宴","author":"陆游","text":"洗君鹦鹉杯，酌我蒲萄醅。\n冒雨莺不去，过春花续开。\n英雄漫青史，富贵亦黄埃。\n今夕湖边醉，还须秉烛回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小斋壁间张王子乔梅子真李八百许旌阳及近时得道诸仙像每焚香对之因赋长句","author":"陆游","text":"山城作吏老堪羞，衫色尘昏鬓色秋。\n敛版那供新贵使，闭门聊与数公游。\n至人不死阅千劫，大海无穷环九州。\n安得相携从此逝，醉骑丹凤下玄洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小疾三首 其三","author":"陆游","text":"避人便小疾，省事喜闲身。\n并海鱼盐聚，入秋风雨频。\n元知器苦窳，空有胆轮囷。\n轑饭聊同饱，知君不笑贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小疾三首 其二","author":"陆游","text":"老不禁当病，经旬卧一床。\n亦知非疥癣，幸未至膏肓。\n水落滩初出，秋深草渐黄。\n非关畏人事，晚岁合深藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小疾三首 其一","author":"陆游","text":"小疾有根柢，忽之当日深。\n养苗先去草，省事在清心。\n蚁梦能看破，狐妖可坐擒。\n一杯藜粥罢，听雨拥秋衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小疾偶书","author":"陆游","text":"书生本愿致时康，自怪秋来疾在床。\n胸次岂无医国策，囊中幸有活人方。\n但知元气为根本，正使长生亦秕糠。\n竖子何劳一除扫，区区犹欲恃膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小疾谢客","author":"陆游","text":"小疾深居不唤医，消摇更觉胜平时。\n痴人未害看周易，名士真须读楚辞。\n绿径风斜花片片，画廊人静雨丝丝。\n晚来顿觉清羸甚，自置篝炉煮粟糜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小病两日而愈","author":"陆游","text":"病骨羸然山泽臞，故应行路笑形模。\n记书身大似椰子，忍事瘿生如瓠壶。\n美酒得钱犹可致，高人折简孰能呼。\n不如净扫茅斋地，卧看微香起瓦炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小酌","author":"陆游","text":"盘箸贫犹设，杯盂老更耽。\n宗文树鸡栅，灵照挈蔬篮。\n径醉眼花乱，高眠鼻息酣。\n觉来寒日晚，落叶拥茆庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小酌","author":"陆游","text":"偶向东园把一杯，不辞团坐扫苍苔。\n野花经雨自开落，山鸟穿林时去来。\n皂白正非天欲辨，青黄要与木为灾。\n今年秋后犹能健，剩乞梅栽与李栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小隐","author":"陆游","text":"小隐在江干，茆庐亦易安。\n庖厨供白小，篱落蔓黄团。\n蹭蹬冯唐老，飘零范叔寒。\n世情从迫隘，醉眼觉天宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雪","author":"陆游","text":"夜卧风号野，晨兴雪拥篱。\n未言能压瘴，要是欲催诗。\n跨蹇虽堪喜，呼舟似更奇。\n元知剡溪路，不减灞桥时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小筑","author":"陆游","text":"小筑湖边避俗嚣，几年于此寓箪瓢。\n虽非隐士子午谷，宁愧诗人丁卯桥。\n罗雀门庭无俗驾，缘云磴路有归樵。\n诗情酒兴常相属，堪笑傍人说寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小筑","author":"陆游","text":"小筑并湖堤，茅茨不厌低。\n引泉浇药圃，砟竹树鸡栖。\n夕霭山常淡，秋芜路欲迷。\n平生草玄手，老去学锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小筑","author":"陆游","text":"小筑茅茨镜水滨，天教静处著闲身。\n平原不复赋豪士，甫里但思歌散人。\n翠壁微泉时的皪，衡门叠嶂晓嶙峋。\n子虚误辱诸公赏，万里轻鸥岂易驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小筑二首 其一","author":"陆游","text":"小筑清溪尾，萧森万竹蟠。\n庵庐虽偪仄，庭户亦平宽。\n摘果观猿哺，开笼放鹤盘。\n澹然还过日，无处著悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小筑","author":"陆游","text":"放翁小筑寄江郊，屋破随时旋补茅。\n暮看白烟横水际，晓听清露滴林梢。\n生来不啜猩猩酒，老去那营燕燕巢。\n目断鹿门三太息，庞公千载可论交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小筑二首 其二","author":"陆游","text":"小筑随高下，园池皆自然。\n锄山得灵药，斸坎遇寒泉。\n幽槛花房敛，深林果蒂骈。\n邻翁亦好事，相伴送流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小葺居舍","author":"陆游","text":"野水枫林下，残年亦自存。\n刈茅支漏屋，插棘补颓垣。\n把钓襟灵爽，争棋笑语喧。\n晚窗幽兴极，共酌黍醅浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小集","author":"陆游","text":"乌桕遮山路，红蕖满野塘。\n病苏身渐健，秋近夜微凉。\n杯酌随宜具，渔歌尽意长。\n儿曹娱老子，团坐说丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小霁乘竹舆至柳姑庙而归","author":"陆游","text":"残云断处漏斜阳，草满平堤柳著行。\n飐飐画船来北港，翻翻青伞度南塘。\n行人相贺新年健，逃户虽穷旧业荒。\n感物兴怀空绝叹，才衰无语付诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小憩","author":"陆游","text":"徐行散腰膂，小憩啬精神。\n休养观书眼，调娱宴坐身。\n青毡我家旧，红粟太仓陈。\n温饱无馀事，寒龟息自匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]