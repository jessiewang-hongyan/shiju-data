[{"title":"东坡竹","author":"连文凤","text":"眉山墓木拱，墨迹此淋漓。\n风叶活欲动，霜根死不移。\n老仙初画处，元祐太平时。\n直节有如此，何缘入党碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日早行","author":"连文凤","text":"客里閒关去路赊，轻衫短帽朔风斜。\n青霜委地疑行雪，红叶成林当落花。\n渡口马嘶惊睡犬，田头鹿过散饥鸦。\n闭门无事日高起，谁似山中隐士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日晨兴","author":"连文凤","text":"开楼看雪坐，半榻著吟僧。\n顽甚不知冷，唾来还欲冰。\n空庭眠病鹤，冻壁立僵蝇。\n邻巷有贫者，晓炊犹未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对月怀故人","author":"连文凤","text":"相思不成寐，风露夜漫漫。\n明月此时好，故人何处看。\n客愁杯酒尽，秋影一灯残。\n空羡楼前雁，欲飞无羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对兰","author":"连文凤","text":"蔼蔼抱幽姿，幽人得自怡。\n爱之似君子，好不在花枝。\n浊世已如许，香心终未衰。\n窗前堪作伴，閒读九歌词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归燕","author":"连文凤","text":"营巢生计失，馀恨更依依。\n故国知何处，西风满去衣。\n花案空昨梦，柳巷竟残晖。\n欲问兴亡事，无言各自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"连文凤","text":"年来懒作少年狂，一枕功名属梦乡。\n举世相誇唐字学，几人曾识汉文章。\n自怜晚岁桑榆景，敢入春风桃李场。\n到此相逢莫相笑，谁知臧谷两亡羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纨扇","author":"连文凤","text":"露冷飘零半幅纨，伤心不见女乘鸾。\n歌残春院桃花暖，愁杀秋庭木叶寒。\n满地飞尘何处避，旧时明月向谁看。\n应思曾在君怀里，一点恩情欲忘难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自在庐为倪逊翁赋","author":"连文凤","text":"翁也家何在，悠然天地间。\n往来明月牖，坐卧白云关。\n晚岁有馀乐，谁人似此閒。\n只为清景恼，吟得鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自笑","author":"连文凤","text":"自笑儒冠不称时，几回堪笑复堪悲。\n閒门事少知贫好，逆境愁多恨死迟。\n勋阁麒麟无梦想，故山猿鹤有心期。\n纷纷尘俗都如许，吟得诗成欲寄谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自题","author":"连文凤","text":"每恨诗才短，吟来两目昏。\n虽然五七字，难似万馀言。\n雅道扶不起，苦心谁共论。\n几回风雨夜，哭杀杜陵魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听徐天民琴","author":"连文凤","text":"閒堂风月深，自此出瑶琴。\n为我弹一曲，悠然生古心。\n馀清分坐客，微响拂流禽。\n世上是非耳，谁能知此音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈赵侍郎","author":"连文凤","text":"飘缈蓬壶隔俗尘，尘中日月易因循。\n白驹皎皎犹空谷，秋水娟娟自美人。\n何限溪山分晓梦，无情天地著閒身。\n抱琴来问吟边信，见说池塘草正春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿陈右司","author":"连文凤","text":"白发苍颜半醉醒，衣冠洛社旧耆英。\n谁能似此存高节，天欲留公相太平。\n閒里看山心共远，老来读易眼增明。\n年年四月初三夜，帘外一痕新月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿林处士","author":"连文凤","text":"人物推先辈，江湖姓字香。\n今年方八十，此老不寻常。\n道义襟期重，诗书气味长。\n顾余蒲柳质，那得似彭郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子立春","author":"连文凤","text":"又逢庚子岁，老景对韶华。\n檐噪朝朝鹊，灯开夜夜花。\n凄迷连月雨，冷落几人家。\n幸有新春酒，瓶中不用赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"废冢","author":"连文凤","text":"零落谁家冢，乌鸢出土飞。\n黄金知有属，白骨竟无归。\n野鸟啼阴树，行人吊夕晖。\n盖棺犹未定，何况此生微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昌化道中","author":"连文凤","text":"不因来此地，不识别山春。\n几处坟无主，多年树有神。\n闻猿惊落日，畏虎问行人。\n忽到孤峰顶，白云飞满身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林处士湖居","author":"连文凤","text":"儒家生计薄，火后复何如。\n白发谁怜汝，青山自借居。\n种花思旧业，对竹理残书。\n莫叹今牢落，湖边尚可渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试笔","author":"连文凤","text":"谁遣毛州刺史来，閒窗终日共徘徊。\n龙窥石涧新临砚，鹤舞松烟乍试煤。\n茅舍寒深题未遍，玉堂月冷梦空回。\n笑予得尔浑无用，惆怅临风写八哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓丝风","author":"连文凤","text":"短发冷飕飕，倚船初下钩。\n閒来片水外，轻弄一痕秋。\n浅拂蘋花落，低随柳影浮。\n烟波清梦远，吹不到王侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"连文凤","text":"诸将驱驰尺寸功，先生来此坐清风。\n汉家天地閒身外，严濑烟波落照中。\n片石粼粼年岁晚，一丝袅袅利名空。\n笑余亦是垂纶客，欲借台前系短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀酬仇仁近见寄","author":"连文凤","text":"西风一夕送残蝉，老景情怀更惘然。\n芦荻病中秋瑟瑟，家山梦里路绵绵。\n空城点滴寒莎雨，故国凄迷断础烟。\n待得鹤归华表上，可堪人世又千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种菖蒲","author":"连文凤","text":"此种即昌阳，棱棱九节长。\n薜萝不敢碧，窗户自生香。\n病眼看能醒，閒心觉渐凉。\n余非学仙者，莫问引年方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵司门成之新居","author":"连文凤","text":"何必山巅共水涯，闲心幽远此相宜。\n喧无车马红尘少，乐有琴书白日迟。\n晴槛倚风初柳处，夜灯听雨正蛙时。\n客来试问功名事，已付功名与酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人归越","author":"连文凤","text":"妻子相携失所居，山川迢递更崎岖。\n征鸿去去秋风急，惊鹊栖栖夜月孤。\n赖有绨袍怜范叔，免教岐路泣杨朱。\n归来每忆溪船上，买得鲜鱼酒旋沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人建康入道","author":"连文凤","text":"郁郁文章不称时，岂堪寂寞寄人篱。\n早知乱后为儒误，始恨年来入道迟。\n春晚茅山犹有朮，秋深商岭已无芝。\n何当乘此清风去，共看山家未了棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王道士入燕","author":"连文凤","text":"何处春山采药还，此行万里道途难。\n西风尘起衣装重，北斗星低剑气寒。\n学跨青牛朝玉阙，语留白鹤守金丹。\n洞门无钥须归早，莫待桃花落石坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘悦心教授任浏阳","author":"连文凤","text":"一穗藜烟待校书，携书且此作师儒。\n扶持学法防时弊，教养人材应世需。\n兰芷汀洲身外楚，菰莼乡国梦中吴。\n片帆好趁秋风便，吟过洞庭青草湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴言可之鄞","author":"连文凤","text":"四明多胜迹，不惮此行难。\n客棹霜天晚，征衫道路寒。\n湖灵通夕见，海日带潮看。\n莫远乘槎去，风涛卒未安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张集父分教越之上虞","author":"连文凤","text":"此去横经涉远途，三江烟雨晚潮初。\n颛孙岂是贪求禄，郑老从来爱读书。\n驻马晓吟曹庙桧，倚船时看舜乡鱼。\n顾予挟册曾游此，故旧相逢为起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李元晖閤舍归庐陵","author":"连文凤","text":"锐气如君老不磨，悠悠世路涉风波。\n西湖旧识惟鸥鹭，故国重来尽黍禾。\n短枕客中生梦少，归舟江上载诗多。\n相逢未久忽相别，奈此夕阳芳草何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜子问归明州","author":"连文凤","text":"未酬行道志，抱道复东归。\n老入江湖鬓，寒深雨雪衣。\n客程烟树晚，乡梦海鱼肥。\n所恨交情浅，临岐别语稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈仲甫挟书游甫里","author":"连文凤","text":"西风客影鬓毛苍，此去携琴又一方。\n欲向书中消日月，何妨篱下寄文章。\n于今蜀道无平地，到处并州即故乡。\n茶灶笔床犹在否，烦君移棹问沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周伯旸之馀姚","author":"连文凤","text":"佳友难为别，何时重盍簪。\n客衣黄叶满，书屋白云深。\n落月生离梦，寒蛩助越吟。\n抱琴从此去，虞氏有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林校书入山","author":"连文凤","text":"茫茫尘世厌风波，但把柴门掩薜萝。\n朝野交游能有几，文章气味已无多。\n收书且作林泉隐，洗砚閒将岁月磨。\n后夜偶然逢野叟，错看太乙重相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送罗寿可归临江","author":"连文凤","text":"琴剑西还已有期，白云飞处望多时。\n湖边别酒春风醉，江上归帆落日迟。\n客思悠悠生远树，梦魂隐隐入芳篱。\n到家若话吴中事，自有哀歌寄楚词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹之才游天目山","author":"连文凤","text":"突兀双峰晓色分，瘦筇支足上昆崙。\n雷声俯听婴儿语，石势平看骏马奔。\n故国山川千古在，前朝人物几家存。\n登临不用多怊怅，只好清吟伴野猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻复先上人下世","author":"连文凤","text":"满腹贮韩文，僧中少似君。\n行高临死见，名重在生闻。\n霜变北峰树，猿啼下竺云。\n未知埋骨处，消得片香焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周明府公谨","author":"连文凤","text":"彭泽归来厌宦情，弁阳山下买山耕。\n春风秋月供吟啸，月夕风朝寄死生。\n铭墓古人堪彷佛，著书心事更分明。\n但能似此存清节，野史须还记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烧香","author":"连文凤","text":"坐我以灵室，炉中一篆香。\n清芬醒耳目，馀气入文章。\n微见五云散，閒消半日长。\n旧书重读罢，风味更悠扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后","author":"连文凤","text":"一病忽半载，囊无挑药资。\n生逢千劫后，死较十年迟。\n老色从侵面，閒愁并上眉。\n惟馀清思在，瘦尽尚能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破衣和尚","author":"连文凤","text":"平生只布衲，浑似晚秋莲。\n当日住何寺，随身著几年。\n懒将黄叶补，閒共白云眠。\n结屋吴山下，修行了宿缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顽独","author":"连文凤","text":"顽独斋前翠色交，翛然一榻掩衡茅。\n禅心久作高僧悟，方术宁从道士教。\n晓日短墙花弄影，晚风斜槛鹤归巢。\n老怀自喜诗尤健，几度穷吟忆孟郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄上虞周伯起县尉","author":"连文凤","text":"忆昔论文向酒边，忽来二十二三年。\n别离老泪深春水，今古闲愁积暮烟。\n吟作南音怀越土，望穷东浦隔秦天。\n梦魂不识曹娥渡，一纸相思寄客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄友人","author":"连文凤","text":"少年锐气尽消磨，岁月相随醉梦过。\n今古悠悠交道变，江山渺渺俗人多。\n绝弦应为无知者，鼓瑟其如不好何。\n从此诗筒频寄取，莺花时节莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄仲宝上人","author":"连文凤","text":"一笑箫韶曲未终，清风杖锡欲何从。\n不随轻絮飘流水，且作閒云过别峰。\n昭庆寺前鸦绕树，馀杭山下鹤归松。\n人来今雨闻消息，见说维摩带病容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林处士景初","author":"连文凤","text":"诗书岁月久，到老未忘情。\n一自文风变，长忧雅道轻。\n时人空见忌，圣主旧知名。\n更有孤高节，冰霜无此清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄送介夫城居","author":"连文凤","text":"曾赋隐居图，知君已定居。\n移家重入市，引鹤自挑书。\n烟雨生新梦，云山护旧庐。\n但令风浪静，何处不堪渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄桐庐李华甫","author":"连文凤","text":"客里光阴叹白驹，青山何处故人疏。\n花开花落难逢笑，潮去潮来莫寄书。\n北海酒深时自醉，西湖水浅晚堪渔。\n新诗忽见因相忆，何日携琴话起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄常州簿郑宗仁","author":"连文凤","text":"玉立蓬莱问浅深，仙裾不受海尘侵。\n千年爱护神龙骨，万里凄凉老鹤心。\n夜月照愁低草色，秋风吹泪哭松阴。\n钱塘流水情何限，谁采蘋花学越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄悼浦江吴县令清翁","author":"连文凤","text":"曾于诗里识清名，几夜吟看婺女星。\n番令宅前花未盛，延陵墓上草先青。\n灯摇残月佳人哭，碑立斜阳御史铭。\n一纸哀歌和泪寄，山高水远树冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼鹤为杨彦礼赋","author":"连文凤","text":"忽随尘土化，不复此翩跹。\n遗迹今犹在，主人时自怜。\n晚风琴操外，残月石床边。\n几夜梦中见，梦中疑是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"连文凤","text":"不知风露寒，深坐翠微间。\n对酒秋花尽，看云暝鹤还。\n钟声黄叶寺，樵唱夕阳山。\n安得吟身健，长随白日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"笼中鸟","author":"连文凤","text":"未是扶摇得意时，笼中日月且相依。\n一身天地宜閒过，四面风尘莫远飞。\n老树无枝空怅望，春山何处不知归。\n冯君爱取新毛羽，休向花前怨落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"连文凤","text":"几片飘从客鬓来，光摇老眼白皑皑。\n不因枯树今朝见，只道寒梅昨夜开。\n是处园林迎腊到，一时天地唤春回。\n凭谁寄语问滕六，乞与人间此种栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄资深入道","author":"连文凤","text":"霞衣飞舞越山青，回笑时人醉未醒。\n春枕卧看琪树月，夜香学拜石坛星。\n泥成丹灶烧仙药，移近明窗读道经。\n可惜蓬莱归不早，海风正急海波腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上行春","author":"连文凤","text":"踏破六桥杨柳烟，乡心迢递怯啼鹃。\n好花岁岁仍相似，白发星星不再玄。\n囊里有金堪一醉，瓢中无药可千年。\n游人不管兴亡事，但把笙歌闹彩船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖饮得天字","author":"连文凤","text":"老来更上百花船，赖有湖光慰眼前。\n兵后山川仍恋土，壶中日月不行天。\n閒身适意随鸥鹭，乐事何心问管弦。\n尽醉无愁归路晚，客楼只在废城边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葛岭废第","author":"连文凤","text":"此是歌钟第，斯人去不还。\n繁华一梦里，风雨十年间。\n红叶自成径，绿苔空掩关。\n国亡家亦破，愁杀夕阳山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠梅花","author":"连文凤","text":"惟有梅花不厌贫，花前笑语伴閒身。\n老枝犹带深山雪，生意能回破屋春。\n影待月来明户牖，香随风散恼比邻。\n寄余何限江南意，几度相看忆故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感春","author":"连文凤","text":"赏心未足事多违，啼鸟声声怨夕晖。\n客梦一番芳草歇，人生几度落花飞。\n病难为别乡情远，老不禁愁酒力微。\n犹记当年歌舞地，醉游秉烛夜深归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简李元晖","author":"连文凤","text":"移棹方游霅，携琴又到杭。\n溪山随影转，日月共贫忙。\n何处依刘表，无人识子长。\n世情已如此，客路独堪伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬高景仁见寄","author":"连文凤","text":"忆昔邮亭奉别裾，不知别后意何如。\n夕阳树外烟尘隔，明月河边笑语疏。\n客路惊回飞去梦，天风吹落寄来书。\n西湖莫问残春色，且好白茅山下居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬婺郡学高广文","author":"连文凤","text":"十载持竿浙水滨，江空岁晚更愁人。\n秦楼歌舞多燕剑，洛社风流少晋巾。\n伏枥已甘存老马，随波不解纵穷鳞。\n广文何日归茅屋，共醉樽前未死身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋杂兴 其七","author":"连文凤","text":"老计笑空疏，清风一草庐。\n閒门心迹在，仕籍姓名除。\n曲唱贞元后，吟归丙子初。\n不言封禅事，谁识病相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋杂兴 其六","author":"连文凤","text":"似隐还非隐，未能忘世情。\n山河亡国恨，风雨客楼声。\n穷有天堪问，贫无地可耕。\n桃源窅何处，目断故秦城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]