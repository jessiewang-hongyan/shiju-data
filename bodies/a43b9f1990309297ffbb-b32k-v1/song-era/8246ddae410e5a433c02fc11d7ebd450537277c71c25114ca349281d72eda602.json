[{"title":"读邸报怀王先生作","author":"林希逸","text":"当日筹边事偶蹉，追尤未已意云何。\n纵令君实谋时短，不道伊川好处多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟箬村有怀老师作","author":"林希逸","text":"昔去京华此舣舟，老师含笑别江头。\n我今重向江头立，宿草伤心二十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄林寒斋","author":"林希逸","text":"此是渊明向上人，少年早已谢簪绅。\n谈优雅号周禅客，意散宜称谢道民。\n书疏苦无多字数，岁时但觉两情亲。\n寒窗欠我煨炉语，久办青鞋拟乞身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"内宿","author":"林希逸","text":"玉宇凌空耸，金书照夜明。\n墙深容竹迸，石古伴梅横。\n云接天章路，风传徼道声。\n非才叨儤直，愧见壁间名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又绝句","author":"林希逸","text":"堂虚陡觉暮寒生，长乐疏钟缓转更。\n对烛已无词可草，拥炉时听闹皇城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次早喜雪","author":"林希逸","text":"竹叶初闻似雨声，禁林未晓已通明。\n朱楼屈曲栏先湿，紫殿参差瓦欲平。\n冰砚笔随花片起，风檐幔点蕊珠轻。\n堂名不枉人间说，此际真如玉琢成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入局有怀","author":"林希逸","text":"空餐无补负公家，此志虽存鬓已华。\n每向客怀红踯躅，不贪郎对紫薇花。\n宽心可要流香酒，圆梦何须正焙茶。\n手板便还丞相去，吾侪活计只桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有感","author":"林希逸","text":"少日因贫强觅官，于今悔掷钓鱼竿。\n宫袍岂似陀尼暖，厩马何如款段安。\n准易莫教玄尚白，奏篇还要炳于丹。\n得归须谒严陵去，梦已先经七里滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得郡后二首 其一","author":"林希逸","text":"君王分付为亲还，班路諠传忤要官。\n我但得归他不问，从来人道乞身难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得郡后二首 其二","author":"林希逸","text":"语戆情知忤要人，此心谋国不谋身。\n一麾得请天南去，出处应堪白老亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登舟喜风顿清秋暑","author":"林希逸","text":"触暑登途众共猜，好风谁料逐帆开。\n天公应是怜行客，正忤炎官热属来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村明皇按乐图歌","author":"林希逸","text":"芙蓉帐暖春觉迟，玉笛真人恣荒嬉。\n弄权宰相杨与李，老奴将军专北司。\n延秋门外目未睹，宫中但教霓裳舞。\n薛王沉醉寿王醒，天公自击催花鼓。\n锦鸡索斗金笼疏，宝马登床伶走趋。\n只愁海棠睡不足，肯信渔阳有反书。\n青娥阿㜮发种种，海上依然髻斜拥。\n游魂血污纵得归，不伴君王行蜀陇。\n周郎此笔妙殊常，琛台初见惜匆忙。\n重来把玩转烛许，十年去我春堂堂。\n按图雅欲谈遗事，西墅无人谁考异。\n少公锦卷长公题，共说少公各挥泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花","author":"林希逸","text":"纷纷尘劫数河沙，玉雪风标共几家。\n可是人间清气少，却疑太半作梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劭农","author":"林希逸","text":"此礼今于古庶几，厖眉共席意依依。\n儿携竹笠翁藜杖，主带朝冠客布衣。\n饮不尽觞瓢挈去，食犹馀胾叶包归。\n已分镂本随人看，闻说今年僻字稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆在","author":"林希逸","text":"忆在云深处，身曾侍紫宸。\n元无讲三昧，那得笔千钧。\n分赐茶犹在，批依墨尚新。\n汗颜恩莫报，窃禄谩娱亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马和之觅句图","author":"林希逸","text":"先生隐几奴煨火，斜插疏枝破瓦尊。\n鹤梦未回更几转，吟时应是月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石虎礼僧图","author":"林希逸","text":"眼前立是抱桥尸，悔不湔肠背后儿。\n洛度老胡闻血臭，汝虽合爪我攒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明皇听笛图","author":"林希逸","text":"寿王妃弄宁王笛，对面三郎背老伶。\n却恨马嵬西去路，无人吹出雨霖铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨通老移居图","author":"林希逸","text":"忆昔移居诗，在集篇篇好。\n就中语奇绝，最是涉与岛。\n谁欤作此图，题以杨通老。\n行行四五人，长短各有荷。\n瓢者帽且髯，席者头不裹。\n或牧而尚髫，或负而似跛。\n孟光衣颇宽，灵照袖亦拖。\n一儿解持箠，一儿才剪箠。\n处士独跨驴，牛乃背其媪。\n彼羊驱于前，彼猫肩于左。\n琴二荻篮双，生计亦甚夥。\n应嫌俗子知，必住深山可。\n低眉得何句，手卷岂其稿。\n若逢李十二，定复歌饭颗。\n薏苡或招谗，胡椒能惹祸。\n君子哉若人，万物备于我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石鼎联句图","author":"林希逸","text":"画意不画形，形胜意不足。\n正如九方皋，相马不相肉。\n此笔谁为之，缫藉以锦玉。\n一几共三人，弥明喜师服。\n赓酬夜何其，漏箭在银烛。\n谁如豕腹胀，谁作龙头缩。\n始胡为颉颃，末胡为屈伏。\n彼既鼻撩天，避席徒局束。\n去者俄翩然，二子睡正熟。\n奓户问童奴，晓云凄古木。\n质之昌黎篇，段段皆实录。\n用意岂不精，或者疑近俗。\n我闻文章家，同工而异曲。\n或如骏历险，千里在一蹙。\n或寸步不遗，句句必连属。\n在诗则乐天，在文则永叔。\n画品恐亦然，愿言宝此轴。\n毋使叹巧心，受嗤于拙目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题江贯道山水四言","author":"林希逸","text":"远山丛丛，远树濛濛。\n咫尺万里，江行其中。\n短长何岸，高低何峰。\n彼坻彼洔，彼瀑彼洪。\n晴岚乍豁，烟霭葱笼。\n或断或属，且淡且浓。\n尔崒奚寺，尔盘奚宫。\n或垣阴翳，或梁嵌空。\n有吠者厖，有樵者翁。\n危樯落碇，短棹掀蓬。\n往来异趣，寂动殊容。\n羃翠其庭，岂非卢鸿。\n略彴而渡，岂非龟蒙。\n昔我经行，云山万重。\n若淮南北，与江西东。\n亦蓑而雨，亦帽而风。\n乃今追惟，梦境相从。\n及此开卷，恍然昔同。\n谁居作者，造化论功。\n淹总其裔，熙成是宗。\n声闻九陛，既召而终。\n谓彼树白，谶其身穷。\n其然岂然，讯之天公。\n此名穹壤，畴曰不逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题达磨渡芦图","author":"林希逸","text":"白头浪中碧眼胡，赤脚笑踏雁衔芦。\n太平寺主不知我，观音后身谁诳渠。\n是身如幻本来空，偶然游戏非神通。\n当年涉海向震旦，扁舟本与商胡同。\n君不见壶丘弟子御风飞，犹有所待周笑之。\n又不见横抛锡杖渡水僧，回瞻黄檗称大乘。\n此胡法器更奇在，何曾以此为圣解。\n萧郎不悟义不留，却要时人略惊怪。\n异时埋骨寄熊耳，万里西归提只履。\n忽从葱岭遇宋云，雅意依然今日是。\n此图谁笔面如活，客来却咏凌波袜。\n若将底事比渠侬，老胡暗中定羞杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡圃偶题","author":"林希逸","text":"曲阶倚杖行疏影，柳花度竹粘衣领。\n台根三两落残梅，时见幽禽窥野井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月郡圃偶成","author":"林希逸","text":"梅花落尽柳将舒，池水冬深只尺馀。\n亭欠扫除多败叶，园随高下长新蔬。\n典刑如在松加爱，意思相关草莫锄。\n庆朔堂前诗一首，旧碑元是后来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题宋德清诗稿","author":"林希逸","text":"诗法如书法，临摹恐未真。\n宁为禅散圣，莫作婢夫人。\n士诧门中集，君留席上珍。\n苦吟应不厌，会见轧黄陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读刚悯程公祠堂碑作","author":"林希逸","text":"抗对公何勇，留芳泣血编。\n死能名百世，生不解千年。\n官岂云无长，吾诚耻独全。\n堂堂英烈在，遗像旧江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚行凤游池边作","author":"林希逸","text":"为吏常嗟七不堪，偷闲时到小池南。\n去来共浴凫千百，高下相呼鹊二三。\n春放新红梅点点，霜馀旧绿草毵毵。\n云边数阵鸦归后，远树如山日半含。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人世","author":"林希逸","text":"浮世堪嗤似戏场，尘编无限记兴亡。\n百年不了窗明暗，一觉宁论夜短长。\n空谷老天休浩叹，今人古月谩相望。\n眼前翻覆祇如许，隐几何妨静炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"林希逸","text":"入夜新凉乍满襟，檐前花竹弄清阴。\n好时好日随缘住，非月非风得趣深。\n书到七篇偏有味，诗留千载待知音。\n从来一点圆明处，不是禅心是本心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐朝奉挽歌词","author":"林希逸","text":"薤露曲，薤露歌，人生如露可奈何。\n如公九十鬓皤皤，有子百世名不磨。\n排奸直气贯羲娥，教忠蜚奏金銮坡。\n制书内出特旨褒，鱼跃白金绯染袍。\n径阪之门道日高，葵藿园中翁共哦。\n诸孙玉立春室和，生事以礼踰牲牢。\n公从诸仙游栏柯，送车千两山之阿。\n鸿章伐石质参轲，百年似此胜人多。\n翁归如蜕儿悲号，团栾一散顷兮俄。\n门人从今废蓼莪，事亲无足可奈何。\n事亲无足可奈何，薤露曲，薤露歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"亏欠","author":"林希逸","text":"休放闲愁到酒边，眼前亏欠是良缘。\n六王才毕秦关失，二寇俱平晋社迁。\n月满一轮须渐破，屋留三瓦莫教全。\n谁名缺减人间世，虽道胡僧也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自知","author":"林希逸","text":"学问深功要不疑，空谈长笑晋人痴。\n渠侬眼纵明如月，知我何如我自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊行即事二首 其一","author":"林希逸","text":"野店相依门向背，牧童对语岸东西。\n草枯白见樵成径，木落红随叶入溪。\n色有浅深峰远近，影无长短树高低。\n眼前好句闲收拾，归到书窗却自题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊行即事二首 其二","author":"林希逸","text":"老树菌生铺兔目，断蹊泥湿印牛蹄。\n山僧渡水双携履，野客归村独杖藜。\n群鸟争枝声上下，孤松夹涧影东西。\n行吟注意搜诗料，欲近前溪路忽迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"林希逸","text":"生涯莫要问如何，且卧牛衣醉浊醪。\n仕已何妨三令尹，是非元自一东坡。\n拾遗儿去看鱼笱，廷尉门荒设雀罗。\n百卉不论红与紫，看花时少叶时多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀二首 其一","author":"林希逸","text":"寒窗弄笔日娱嬉，品格高低问孰知。\n古貌古心空自许，散歌散传不能奇。\n但参言句禅差是，要入文章录却痴。\n谁道二郎吟可学，支颐摇膝笑龟儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀二首 其二","author":"林希逸","text":"人间逆境似难堪，涉历崎㠊我熟谙。\n早已知非如伯玉，误令入闹为图南。\n二娘子酒何妨醉，小厮儿禅只默参。\n试问先生缘底乐，坐观寒月照秋潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"世味","author":"林希逸","text":"世味更尝百念轻，眼前何辱又何荣。\n宁教鬼解揶揄汝，不许人能驾驭卿。\n跃马卧龙皆梦事，焚香弄镜了馀生。\n春残雨水差沾足，却愿从今米价平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读程氏遗书","author":"林希逸","text":"浮身长短梦，可见几英雄。\n不有遗编在，应随落叶空。\n中宵门外雪，一月坐间风。\n似此难传处，能言孰与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"身外","author":"林希逸","text":"身外荣枯时与命，眼前好恶古犹今。\n不须指拟文章力，且要消除人我心。\n贫甚可无餐玉法，闲多好和玩珠吟。\n春残任待花饶笑，竹几蒲团味自深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自警","author":"林希逸","text":"静退虽知趣味殊，终然习气未全除。\n有无对境宜俱遣，梦觉何时解一如。\n得力要须生处熟，用工最怕密中疏。\n莫教草草匆匆去，却恐从前枉读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晨兴和前韵","author":"林希逸","text":"分剂元无欠与馀，化工最巧是乘除。\n壮怀何必风云入，净念须看露电如。\n玄在不妨雄拓落，诗成自笑甫狂疏。\n新来一事尤堪讶，眼已眵昏学草书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晴窗放言","author":"林希逸","text":"今日与明朝，相寻仅顷刻。\n昨日不可追，便如千岁隔。\n长江汐且潮，孤月明又魄。\n真宰良自劳，人生况如客。\n锦衣岂云华，藜羹未为啬。\n俯仰去来今，升沉付一哑。\n卯酒六七分，武成二三策。\n晴窗乐自知，一镜虚中白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲寅十月十九日有感","author":"林希逸","text":"当年瑞节庆虹流，冷落如今阅几秋。\n鼓腹遗民犹诧说，攀髯诸老更谁留。\n玉梅枝上春长在，金粟堆边云正愁。\n追记鹄袍陪拜日，晓风黄伞望宸旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田园杂兴 其一","author":"林希逸","text":"畴昔多惭世网牵，收身幸早赋归田。\n四科人物皆高第，只学樊迟也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田园杂兴 其二","author":"林希逸","text":"独立搔头晓未梳，喜看童仆理园蔬。\n汉儒不悟真消息，却下帘帷只读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田园杂兴 其三","author":"林希逸","text":"郊迎犹待一番风，主相那能不愧容。\n纵道东还心事白，更须定洛乞明农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田园杂兴 其四","author":"林希逸","text":"岁计溪南数亩中，但将风雨祝天公。\n人生何必堂厨饭，米渗藜羹一饱同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田园杂兴 其五","author":"林希逸","text":"雨过高低水地平，扶犁野老续歌声。\n忧时莫问蓑衣谶，但看乌犍破晓耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田园杂兴 其六","author":"林希逸","text":"轮舆盖轸及车弓，模写文奇是考工。\n农具因何却疏略，周公于此愧龟蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题泳近稿","author":"林希逸","text":"拿舟早已向三韩，莫放天风解引还。\n九转黄芽先白雪，千年翠甗后红斑。\n棋无尽算仙犹著，性要全空佛未闲。\n得路不须愁险绝，看他脚力尽时山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦","author":"林希逸","text":"学道浑无力，纷纷梦未休。\n谁呼鹙与寂，莫订蝶为周。\n因想诚难诘，飞扬果自由。\n工夫何处是，勤看懒安牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦西轩旧事","author":"林希逸","text":"南谷霜松老，伤哉一窖尘。\n学迂穷有鬼，诗在护无神。\n往日同参尽，残年入梦频。\n遗书谁挂眼，衣钵付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云木相参歌","author":"林希逸","text":"溪翁结茅傍溪南，近山绕屋青如蓝。\n天垂四野云到地，千顷万顷罗松杉。\n着亭小小寄面势，往来万象窗中含。\n有时倚杖日未吐，但见云木朝相参。\n苍苍古木大百围，白云无心出复归。\n云无尽藏木不老，云木千载长依依。\n我醉呼云云不飞，风和万窍如埙篪。\n此时此景谁能画，既以名亭聊赋之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦寒斋","author":"林希逸","text":"故人千载隔幽明，昨夜踌躇过数更。\n握手不知为已死，掀髯犹更话无生。\n海山兜率归何乡，漳浦咸阳寤自惊。\n拥被长吟天未晓，满檐落月泪如倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊午与诸友同谒犀斜南谷二师坟作 其一","author":"林希逸","text":"来往松间不计年，学无进趣负师传。\n侯芭白发今能几，知付他谁守太玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊午与诸友同谒犀斜南谷二师坟作 其二","author":"林希逸","text":"身前枯槁似山僧，瓜葛虽存亦强名。\n料得九京还自喜，但将坟墓付诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艾轩先生","author":"林希逸","text":"为道难言不著书，但知日用是根株。\n当筵自昔倾龙象，嗣法何人识马驹。\n六学即今皆剿说，一齐孤立可长吁。\n犀斜南谷穷愁骨，仙境能谈旧事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臂痛六言 其一","author":"林希逸","text":"六十六翁衰久，四百四病更多。\n臂用火攻未可，心存水观如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臂痛六言 其二","author":"林希逸","text":"虞监因书自苦，龙眠为画劳功。\n臂痛与渠相似，笔端愧我非工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臂痛六言 其三","author":"林希逸","text":"列子肘停杯水，吴生臂画圆光。\n此是病魔饶借，莫将妙手誇张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庄子口义成","author":"林希逸","text":"逍遥而下是全书，渔父诸篇却不如。\n意外形容辞独至，句中脉络字无虚。\n机锋颇似禅三昧，根极祗求性一初。\n千古濠梁同会面，子真知我我知鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老子口义成","author":"林希逸","text":"见彻深微字字精，五千言在与谁明。\n事因借喻多成谤，经不分章况立名。\n数十有三元是一，道虚无实始为盈。\n苏云近佛非知老，老说长生佛不生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]