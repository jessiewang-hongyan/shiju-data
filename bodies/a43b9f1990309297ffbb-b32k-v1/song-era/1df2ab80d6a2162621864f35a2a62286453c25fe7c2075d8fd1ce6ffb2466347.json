[{"title":"读侯官刘宰山居集一首","author":"林希逸","text":"琴思清于五柳陶，词源浩浩似秋涛。\n落花未赋时争价，香草曾吟处得骚。\n七字法传山谷秘，数篇文比曼卿豪。\n衰年酷为齐年喜，紫橐仙翁有凤毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麒麟猫","author":"林希逸","text":"道汝含蝉实负名，甘眠昼夜寂无声。\n不曾捕鼠祇看鼠，莫是麒麟误托生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺刘尚书除龙图阁学士","author":"林希逸","text":"名在先朝擅斗南，圣心求旧眷非凡。\n龙图字足新三画，凤诰书来更几函。\n指日即须携手上，耆年可但改头衔。\n玉阶正要康扶对，新渥相辉共引帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和前韵谢后村饷甘露团荔子一首","author":"林希逸","text":"日日亲朋饷自南，比公所赐似仙凡。\n擅名甘露珠百颗，入手好风书一函。\n苏老黄柑休立传，半山红柿莫分衔。\n金茎仙掌何曾得，要枣如瓜谩举帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题京山书院","author":"林希逸","text":"天南胜处是京山，精舍新成数百间。\n柱石规模何整整，衣冠人物想班班。\n昌黎教法依然在，安定家声喜复还。\n受用不穷书富贵，吾侪本领学曾颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送严陵教方汝楫用后村韵","author":"林希逸","text":"官是东莱初补处，诸生料得熟香名。\n县知讲席通三昧，合向明廷听五英。\n君有奇才宜凤翥，我安穷分乐鸥盟。\n鸡群有鹤令人喜，伊昔翁曾共短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"所翁为泳作小卷玩珠龙极其精妙赋玩珠吟一首追忆此友","author":"林希逸","text":"翁为髯相小尤稀，此卷于今信绝奇。\n墨晕浅深行笔意，红光上下吐珠时。\n名高擅世无他手，语硬盘空况此诗。\n散发不知何处去，想应龙尾学骑箕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵谢子真","author":"林希逸","text":"到了于鱼真得计，从前飞鸟倦知还。\n低头未羡居辕下，拙手何妨缩袖间。\n说偈不嫌如泻水，著书岂必要藏山。\n渔翁学士皆閒梦，此事谁知若是班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵谢子常","author":"林希逸","text":"轮云世事去还来，老眼曾经见几回。\n乍可洗心清净社，何须觅句郁孤台。\n痴儿归语差精进，野叟衰颜觉好开。\n一件却令人愤闷，秋阳骄横胜恢台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月十二日作","author":"林希逸","text":"投閒不厌玩心珠，遮眼无他只旧书。\n得马塞翁从丧马，知鱼濠叟且观鱼。\n三旬不雨田俱涸，一月先秋暑未除。\n此念却难排遣在，家无大小仰犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月苦旱","author":"林希逸","text":"遍走仙坛与九渊，三旬涸尽涧中泉。\n垤无鸣鹳嗟何及，古有刑鹅法孰传。\n父守井槔形似鹤，儿归市籴瘦于猿。\n旁人若识农家苦，粝饭藜羹直万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泳宰安溪 其一","author":"林希逸","text":"好为君王去字人，乃翁知汝耐清贫。\n求民疾痛当如子，有道弦歌是悦亲。\n月解前期须趣办，日生公事怕因循。\n扫除诗癖祗勤政，最急无如赋役均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泳宰安溪 其二","author":"林希逸","text":"邑小虽贫亦自嘉，遥知深僻似山家。\n我思宫锦袍如梦，汝向黄绸被放衙。\n守忆旧游须易事，吏存古意要无华。\n但令禾麦年年好，肯羡河阳一县花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泳宰安溪 其三","author":"林希逸","text":"此邑先曾有美传，雨旸仰佛令多贤。\n复斋名比太丘长，清水仁如姑射仙。\n廉白不惭居补处，精虔更为祝丰年。\n殷勤办此身心去，莫怕溪滩稳放船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王此山午寄虹字韵一首","author":"林希逸","text":"早气如春夜即冬，操存要有主人公。\n斯翁枉向尘埃老，好我遥知臭味同。\n案上两图圆似月，毫端万丈吐如虹。\n渠侬落处应谁会，未羡他家那一通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵春谷南溪双莲二绝 其一","author":"林希逸","text":"蕖仙綵袂湿银泥，共蒂分红照碧溪。\n桃叶桃根双姊妹，未应拟入句中题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵春谷南溪双莲二绝 其二","author":"林希逸","text":"文耀祠前花满池，花神为谷献珍奇。\n会看两两红莲炬，先遣秋风瑞入诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程君履以薛宰书见访","author":"林希逸","text":"游历江湖久，刊诗已百篇。\n梅花曾共笑，杨叶不难穿。\n朴厚如翁好，推敲何处传。\n雀罗空自愧，为我谢琴仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉禾瑞于丁卯此粟瑞于戊辰两年之间嘉瑞迭见所产之地其名亦美琴化所感盛矣哉再赋此为梯飙明府贺","author":"林希逸","text":"我贫冬舂苦不足，常时屡贷监河粟。\n大贫忍口活小贫，仰天但冀田中熟。\n去年已喜见嘉禾，今年得粟喜奈何。\n一茎六穗最奇者，四四三三云更多。\n禾生之乡曰太平，粟生之里曰永福。\n天公此意岂偶然，拍手歌之仍鼓腹。\n忧国何人不愿丰，太仓那得相因红。\n但令此物如水火，酒肉如山八蜡通。\n人言此邦今乐土，长官于民如父母。\n曰旸曰雨天应之，叶气嘉生有如许。\n长官宁非佛地人，三年一念何其仁。\n要知此瑞为谁出，金粟如来个后身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二偈赠馀干震上人 其一","author":"林希逸","text":"芝云深处远携筇，行遍闽山访野农。\n问老旧游诸大老，云渠识涧住依松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二偈赠馀干震上人 其二","author":"林希逸","text":"老漆园仙数卷书，最佳公案是观鱼。\n濠梁水上宁无影，悟得应知我与渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月山丹","author":"林希逸","text":"数本山丹似晓霞，多情恋恋野人家。\n自从五月至九月，还有三花或两花。\n莫笑萧疏同寂寞，早曾烂漫见纷华。\n篱边黄菊今全未，且对芳樽拾堕葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月仲弟重九日庆七十","author":"林希逸","text":"自得斋中得乐全，对床白发者希年。\n尚平债了閒无事，洛社交多誉独贤。\n女嫁比邻来往密，醉忘巾栉起居便。\n紫薇旧伴今如梦，喜插黄花寿阿连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送丘进道入京","author":"林希逸","text":"孝慕三霜不脱衰，月评甚美况清才。\n为贫遮日投竿去，得趣吟风讲学来。\n翁岂常人嗟宰木，我尝为子指庭槐。\n有皋能赋谁嘘送，莫使君王忆老枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送光泽苏县丞","author":"林希逸","text":"种花城里谈经席，三载何曾有束脩。\n别换头衔聊佐邑，重拈手板向邻州。\n松厅莫笑无公事，蕖幕时能致俊流。\n握手溪干留饮去，相思那肯靳书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前后身","author":"林希逸","text":"幻影匆匆托太虚，问身前后果何如。\n李如画马沦为马，庄亦观鱼化作鱼。\n房相未忘前世字，谪仙曾读几生书。\n古今传说多蒙昧，觌面须知我即渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林帅参","author":"林希逸","text":"羊肠历尽鬓今皤，官职因才自折磨。\n议幕重来还去也，攀辕不住奈愁何。\n情知直道能容少，空喜阳岩得助多。\n券内功名终久在，非非是是一东坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十九日作","author":"林希逸","text":"霜残已报春消息，未见篱边蓓蕾黄。\n爱菊苦迟今十日，漉巾须作后重阳。\n酒知圣处何妨醉，药纵仙方不用尝。\n拍手自歌儿和我，别无曲调只沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"林希逸","text":"钓鱼矶畔赋沧浪，不是狂夫老更狂。\n心是罢参僧养病，身如拣退卒还乡。\n谈玄近喜儿差进，得酒先邀弟共尝。\n遮眼有书时掩卷，小窗趺坐自焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠月溪孙相士","author":"林希逸","text":"紫霞焚香青霞哭，此诗此事谁堪录。\n二公如此讼君冤，身虽掇祸名不辱。\n天留老眼见时平，君既生还丁已戮。\n仙无点铁救君贫，佛却有篦刮君目。\n令君看破玉管书，养生聊借君平卜。\n纵谈风骨妙入神，江湖诸老争推毂。\n君能相人我相君，岂无武襄与英六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵兴化","author":"林希逸","text":"壶山虽好俗难平，新下车来有异声。\n得乳雏均心恻怛，害群羊去听神明。\n永丰陂上碑遗爱，德礼堂中实称名。\n执别溪干情可耐，公家资相老门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"潮阳赵秋惟乂作新廨成以景阳扁之谓阳岩尝历此官也余既为作二隶古因赋唐律一首","author":"林希逸","text":"画栋危梁喜落成，主人高致著新名。\n义存必葺规模远，贤要思齐慕尚清。\n丹笔平反真养志，绿绨催趣看登瀛。\n阳岩住处今君住，料得誇张遍凤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"豨冻宜酒以皮为之入口爽而色可爱客以山谷醒酒冰比之余谓冰鳞物也其性寒比之玉狸又不瑩戏成一首","author":"林希逸","text":"豚膏鼎化元非胾，切入金盘得许清。\n鳞雪性寒空细缕，狸霜糟重欠通明。\n渠嗟不遇黄山谷，我爱浑如碧水晶。\n醉后不妨冰著齿，最宜人是味温平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅花帖","author":"林希逸","text":"梅经和靖诗堪画，兰识灵均赋是经。\n两得清名还此卷，梅花石上古兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方遣三山学记仍寄径山文字笔砚稍宽梁秘阁忽送金钟千颗此吾乡名品也 其一","author":"林希逸","text":"埋头汩汩应酬中，一喜因何到此翁。\n恰了数家文字债，满篮人送荔枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方遣三山学记仍寄径山文字笔砚稍宽梁秘阁忽送金钟千颗此吾乡名品也 其二","author":"林希逸","text":"虽云莆荔胜闽中，诸品如今未改容。\n寄语宋香陈紫辈，还他先进是金钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村书窗韵四首 其一","author":"林希逸","text":"尊知笼愚笑火驰，人间翻覆任纷披。\n偷桃儿羡侏儒粟，辟谷翁怀博浪椎。\n座下固知师也谚，门前却叹凤兮衰。\n世无齐物庄夫子，那得渠侬一问之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村书窗韵四首 其二","author":"林希逸","text":"乍可轮生角莫驰，蓑衣好在不妨披。\n相寻日月急如箭，休笑尘埃钝似椎。\n老去诗篇多感慨，古来书卷几兴衰。\n箪瓢乐处虽难会，却是知之亦好之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村书窗韵四首 其三","author":"林希逸","text":"痴人如马系犹驰，我有心经喜自披。\n解使伏戎仇李石，何如瞠视友桃椎。\n老怀只付一杯足，壮气浑如再鼓衰。\n得失到头堪献笑，纵令有道莫求之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村书窗韵四首 其四","author":"林希逸","text":"有馀宁要厥闻驰，架上书多已懒披。\n学养丹须明鼎灶，要参禅莫怕钳椎。\n痴心浪说诗穷达，冷眼閒看世盛衰。\n千古纷纷皆梦事，道难行矣却知之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和磨字韵谢后村以余评新稿见寄","author":"林希逸","text":"持荷苦口辞宫锦，伐木多情忆钓蓑。\n童子无言堪问答，武公虽圣更嗟磨。\n禅宗尚别偏中正，圣处犹分清任和。\n吟苦正求人订正，柴门何幸许相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至日再和磨字韵一首","author":"林希逸","text":"长边久息追风骑，散地閒披钓月蓑。\n锁谏忠劳多叔达，铜光谐谑绝新磨。\n笙镛尚閟须终岁，圭币将陈待始和。\n老太平时逢此日，负暄檐下看云过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬晓","author":"林希逸","text":"云树晓层层，初霞照屋棱。\n冰池纹以镂，霜瓦气如蒸。\n冻想歌樵客，閒思煨芋僧。\n痴翁吟太早，窗尚有残灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"林希逸","text":"寒林叶尽见巢乌，独坐閒吟自引须。\n万劫总如萍聚散，一身几见树荣枯。\n昨日明日算不尽，先天后天易本无。\n事有难言长隐几，何人曾识我非吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与友人论文偶作","author":"林希逸","text":"坡翁好语嗟难读，介甫新经苦尚同。\n举世笑时韩自喜，无人爱处陆云工。\n能奇却怕翻空病，得妙还须苦学功。\n旦暮烟霞千百态，伊谁巧似老天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信缘","author":"林希逸","text":"尘世情知事不然，生涯漫浪只随缘。\n闹蓝身入从初误，逆境魔多向老便。\n未肯羡人升白日，不妨存我送残年。\n声名官职俱何有，枉见匆匆发似绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓起即事","author":"林希逸","text":"千古宗传有正音，纷纷俗学误人深。\n痴生佛说成魔说，见彻尘心即道心。\n老眼惯看棋世界，浮生难恋隙光阴。\n凡情圣解凭谁诘，独坐蒲团只自吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"林希逸","text":"旧留席帽知何在，秃鬓乌巾一任斜。\n病发相如空视草，梦迷太白谩生花。\n古今来往三千载，文字消磨几百家。\n底为藏山痴作计，衰翁笔砚是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"论文有感","author":"林希逸","text":"纷纷见解何差别，豪杰还须间世生。\n识在雷从起处起，文如泉但行当行。\n均为千载无双士，莫问三苏与二程。\n丹井红泉南谷老，似渠宗旨更难明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题徐司理诰","author":"林希逸","text":"端拱雍熙诰尚存，栖鸾衣钵诧曾门。\n龙飞黄敕新来好，先辈名家又有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王元之行徐簿诰词","author":"林希逸","text":"文林有底迁登仕，簿领如何压理曹。\n官制虽殊纶笔美，黄州一字肯轻褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莆田陈尉新作二轩于其廨舍寄题二首 其一 紫薇轩","author":"林希逸","text":"双松厅上念先差，晚节渔翁谩叹嗟。\n试问归摩青玉笋，何如坐对紫薇花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莆田陈尉新作二轩于其廨舍寄题二首 其二 青云轩","author":"林希逸","text":"千载流传感兴诗，为渠黄绶叹官卑。\n便令图上凌烟阁，何似青云传伯夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题名登楼","author":"林希逸","text":"危檐飞处绿周遭，遥想凭栏似跨鳌。\n取义两山名甚美，凌空百尺卧尤豪。\n惊人姓字层层见，作圣功夫级级高。\n直要襟怀如范老，岳阳楼上赋云涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺李教授挂冠","author":"林希逸","text":"鹄袍未脱先谋隐，雅操如君世所难。\n甫拜衮龙怀敕牒，便寻神虎挂衣冠。\n定应传入逸民去，更有文留后代看。\n高卧东山还不稳，令人远笑谢公安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后村为李教赋诗且以索和辄课二首 其一","author":"林希逸","text":"莆在东南誇独盛，材如荆楚信多奇。\n为祥以德麟昭矣，增击何心凤去之。\n玄岂可嘲嗤范蔡，廉无敢溷慕随夷。\n情知结束非时样，冷看人间半额眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后村为李教赋诗且以索和辄课二首 其二","author":"林希逸","text":"诸老赓吟如许富，一翁寒瘦岂能奇。\n君为严郑其清矣，仆岂羊何敢和之。\n投匦疏高闻殿陛，入图赋妙遍蕃夷。\n子云自许千年后，觌面何须彼俯眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘元思倅三山","author":"林希逸","text":"碧玉峰前诏趣回，雅知金耀要清才。\n彯缨即盍班行去，岸帻还因便养来。\n丽句时应梦池草，安书日可到庭槐。\n府公况是深知己，引领同看禁苑梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠命士吴月堂","author":"林希逸","text":"为养祇凭卖卜钱，术精云有异人传。\n如君合把堂名月，得姓元同斫桂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村韵二首奉寄府判真司令 其一 听雨楼","author":"林希逸","text":"取放翁诗扁此楼，知君心企古名流。\n苏吟韦句虽欣慕，樗记曾云不是由。\n大被长衾佳伯仲，高门素学尚姱修。\n俱存无恙邹书训，此乐人间底处求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村韵二首奉寄府判真司令 其二 格轩","author":"林希逸","text":"祖学单传信有原，秤停一字自名轩。\n肯令公愧太丘长，要似思为孔子孙。\n知格格知须细认，有无无有果难言。\n读书记在门生老，愧有君家未报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄建安山长徐平父","author":"林希逸","text":"钓石摩挲久席珍，儒冠非误一朝伸。\n修程鹏击三千里，次榜龙飞第二人。\n讲紫阳书聊倚席，纵青云靶早彯缨。\n十传先辈家声大，又喜中朝诵句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题松涧徐氏馀庆集","author":"林希逸","text":"三派分来久，松高不计年。\n扁题六大字，姓氏两魁躔。\n太末韩曾记，中间稚更贤。\n为君期望远，声节要俱传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰除夜作","author":"林希逸","text":"今宵明早为新岁，明早今宵是旧年。\n却羡山中无历日，循环只认月亏圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]