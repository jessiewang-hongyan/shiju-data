[{"title":"峡路山行即事十首 其五","author":"袁说友","text":"双牛只叟一横犁，白水青秧透面肥。\n是处喜经连夜雨，田家十口可无饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其四","author":"袁说友","text":"跳山踏草笑迎逢，要识新侯过眼中。\n寄语山翁吾老矣，冬裘夏葛与伊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其三","author":"袁说友","text":"旌旗猎猎晓云风，扑面清微破午烘。\n更度幽香来细细，转头寻见野花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其二","author":"袁说友","text":"短篱深閟两三家，门外低畦长豆麻。\n急系芒鞋看行客，野花犹带一枝斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡路山行即事十首 其一","author":"袁说友","text":"环山翠幄远尤清，柏叶丛枝到地生。\n恰傍浓阴深处过，无端杜宇两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈商卿知府入觐二首 其二","author":"袁说友","text":"山行已办犹嫌晚，天意多悭未放晴。\n无奈公车留不住，片帆催听棹歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈商卿知府入觐二首 其一","author":"袁说友","text":"樯乌猛作朝天去，君到长安著脚初。\n若访西湖问西子，朋游应亦念其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重湖","author":"袁说友","text":"夷犹画舫入重湖，野蝶閒鸥自笑呼。\n踏遍北园桃李径，又寻芳草到南郛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"息壤","author":"袁说友","text":"石城出壤水怀州，息壤藏城水复收。\n千载故侯犹未识，土能胜水有深谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致盆栀子于同年楼大防天官","author":"袁说友","text":"一轮月影涨幽香，碧玉钗头白玉妆。\n持似此花供燕几，玉堂端可寿萱堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致菊种于子长","author":"袁说友","text":"好花一岁几回开，喜见东篱旧信来。\n不惜移根到邻里，离披也入画堂栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"被旨许浦蒐兵道中冻合舍舟行陆二首 其二","author":"袁说友","text":"荒村十里展琉璃，依旧篮舆涉水湄。\n自是小臣怀恐惧，要令履薄但兢危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"被旨许浦蒐兵道中冻合舍舟行陆二首 其一","author":"袁说友","text":"已办轻舟著脚登，笑渠河伯故阴凝。\n征车政欲周阡陌，赢得天教一夜冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄同年怀安曹守二首 其二","author":"袁说友","text":"我丈之贤今老成，题舆剖竹傍青城。\n从容官事一时了，莫忘莼鲈秋日羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄同年怀安曹守二首 其一","author":"袁说友","text":"慈恩犹记北山游，四十年间几别愁。\n岁晚天涯重握手，两翁齐白九分头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常熟敲冰行舟三首 其三","author":"袁说友","text":"一枕更阑客梦回，冰声犹作浪声来。\n并刀曾剪松江水，更欲从渠为剪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常熟敲冰行舟三首 其二","author":"袁说友","text":"画鹢悠悠辄退飞，一程百里两程归。\n天公若念羁怀恶，一夜东风便解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常熟敲冰行舟三首 其一","author":"袁说友","text":"岸头猛作敲冰势，船下俄闻戛玉声。\n寸进未应容退尺，要于此地卜平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庾公楼","author":"袁说友","text":"危楼千尺俯江津，天外飞帆点点匀。\n作此雄观真壮士，奈何犹说污人尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晦日昌甫见过因约伯皋小饮黄守继至三首 其三","author":"袁说友","text":"靖州太守诗自佳，留连浊酒看残花。\n涧上久矣无此乐，落拓尤怜云月家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晦日昌甫见过因约伯皋小饮黄守继至三首 其二","author":"袁说友","text":"章泉泉水在玉山，有客岁时来往间。\n今古风烟只如此，见君生怕又言还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晦日昌甫见过因约伯皋小饮黄守继至三首 其一","author":"袁说友","text":"满檐风动海棠雨，北客江南诗酒中。\n华发尊前无好句，飞花常望夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御书阁","author":"袁说友","text":"宝阁翚飞灿碧霄，中藏奎画叹先朝。\n要令冠带升堂者，日日羹墙遂见尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡杨子江遇颠风和霍希文韵三首 其三","author":"袁说友","text":"朝暾下接水光明，风激涛头浪捲层。\n衮衮舟帆来复往，江心笑杀几閒僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡杨子江遇颠风和霍希文韵三首 其二","author":"袁说友","text":"冲涛逐浪不禁寒，何止舟行百丈滩。\n柂橹一声江已转，瓜州岸上报平安。","collection":"宋","notice":"","provenance":{