[{"title":"题院画册 荷花士女图","author":"赵佶","text":"消受南薰一味凉，藕丝新织舞裙长。\n临池试展凌波步，只恐红莲妒艳妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题院画册 芭蕉士女图","author":"赵佶","text":"罗袜生香踏软沙，钗横玉燕鬓松鸦。\n春心正是芭蕉叶，羞见宜男并蒂花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题院画册 涤砚士女图","author":"赵佶","text":"软绣屏风小象床，细风亭馆玉肌凉。\n含情学写鸳鸯字，墨洗蕉花露水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题院画册 团扇士女图","author":"赵佶","text":"浓黛消香澹两蛾，花阴试步学凌波。\n专房自得倾城色，不怕凉风到扇罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海棠通花凤","author":"赵佶","text":"锦棠天与丽，映日特妖娆。\n五色绚仪凤，真堪上翠翘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杏花鹦鹉","author":"赵佶","text":"并亚陇云飞，稳巢文杏枝。\n高栖良自得，蜂蝶莫相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千叶碧桃蘋茄","author":"赵佶","text":"太平蜀雀异，仍映碧桃间。\n一秀三千岁，高枝永共攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"聚八仙倒挂儿","author":"赵佶","text":"垂身如逮下，名冠八仙中。\n最是天真处，樱桃一点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃竹黄莺","author":"赵佶","text":"出谷传声美，迁乔立志高。\n故教桃竹映，不使近蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金林檎游春莺","author":"赵佶","text":"佳名何拔萃，美誉占游春。\n三月来禽媚，嬉娱异众伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"香梅山白头","author":"赵佶","text":"山禽矜逸态，梅粉弄轻柔。\n已有丹青约，千秋指白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵昌江梅山茶","author":"赵佶","text":"赵昌下笔摘韶光，一轴黄金满斛量。\n借我圭田三百亩，真须买取作花王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梨花图","author":"赵佶","text":"楼台影里和风煖，弦管声中瑞日长。\n从听娇鹦说来路，莫教蜂蝶损浓芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题唐十八学士图二首 其一","author":"赵佶","text":"有唐至治咏康哉，辟馆登延经济才。\n廱泮育贤今日盛，汇征无复隐蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题唐十八学士图二首 其二","author":"赵佶","text":"儒林华国古今同，吟咏飞毫醒醉中。\n多士作新知入彀，画图犹喜见文雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"赵佶","text":"乍觉生风喜雨凉，农家得地发田穰。\n却缘暑退秋光满，点滴高梧似漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗二首 其一","author":"赵佶","text":"欲借嵯峨万仞崇，故将工巧状层峰。\n数寻苍色如烟合，一片盘根似藓封。\n院宇接连常藉竹，池亭掩映却凭松。\n分明装出依岩寺，只欠清宵几韵钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗二首 其二","author":"赵佶","text":"风霜正腊晨，早见几枝新。\n预荷东皇化，偷回北苑春。\n旗枪虽不类，荈蘖似堪伦。\n已有清荣谕，终难混棘蓁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日","author":"赵佶","text":"清和节后绿枝稠，寂寞黄梅雨乍收。\n畏日正长凝碧汉，薰风微度到丹楼。\n池荷成盖闲相倚，径草铺裀色更柔。\n永昼摇纨避繁溽，杯盘时欲对清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"赵佶","text":"十二楼藏玉蝶中，凤凰双宿碧梧桐。\n流霞浅酌留君醉，今夜吹箫第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡谟谏议大夫兼枢密使都督诸路军马户部尚书赐归田","author":"赵佶","text":"独善传家久，功名冠世豪。\n平原滂雨泽，岭外息风涛。\n缓拜恩笺盛，相传道义高。\n嗟予尘世隔，安得自陪叨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幸徐常庐","author":"赵佶","text":"人生何事厌嚣尘，汎宅浮家冬复春。\n今日暂来猿鹤语，他年应召白云人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牡丹","author":"赵佶","text":"异品殊葩共翠柯，嫩红拂拂醉金荷。\n春罗几叠敷丹陛，云缕重萦浴绛河。\n玉鉴和鸣鸾对舞，宝枝连理锦成窠。\n东君造化胜前岁，吟绕清香故琢磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题繁杏鹦鹉图","author":"赵佶","text":"天产乾皋此异禽，遐陬来贡九重深。\n体全五色非凡质，惠吐多言更好音。\n飞翥似怜毛羽贵，徘徊如饱稻粱心。\n缃膺绀趾诚端雅，为赋新篇步武吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怪石","author":"赵佶","text":"殊状难名各蔽亏，高□崒屼□巍巍。\n直疑伏兽身将动，常恐长蛟势□□。\n□裂几层苍桧□，凝岚四接老松围。\n名封三品非无美，饮羽曾令壮奋□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赵佶","text":"相公公相子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"赵佶","text":"北斗七星三四点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"赵佶","text":"选饭来时不喜餐，御厨空费八珍盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"赵佶","text":"网罗今不密，回首不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"赵佶","text":"午夜笙歌连海峤，春风灯火过湟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其八","author":"赵佶","text":"暖河消雪带，风柳散冰丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"赵佶","text":"玉阶齐种女贞子，大觉金仙采撷来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十","author":"赵佶","text":"日射晚霞金世界，月临天宇玉乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十一","author":"赵佶","text":"危楼日暮人千里，攲枕风秋雁一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巫山曲","author":"周紫芝","text":"楚宫夜半旌旗动，晓逐君王猎云梦。\n君王醉挽金仆姑，笑射双雕落飞鞚。\n霜风猎猎吹白羽，狨鞍下时日未午。\n天上台高翠被寒，雨湿烟霏梦神女。\n行云飞去不可留，却望阳台无处所。\n魂凝睇远烟凄迷，猿啼巫峡东复西。\n江边猎火一万炬，貂裘醉拥君王归。\n章华千门复万户，侍女焚香迎辇步。\n君心谁能念旧恩，忍泪悲啼不成语。\n愿寿君王一万年，常向阳台梦云雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五杂俎 其一","author":"周紫芝","text":"五杂俎，垄头水。\n往复来，玉关骑。\n不得已，从士子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五杂俎 其二","author":"周紫芝","text":"五杂俎，云际翮。\n往复来，长安陌。\n不得已，千里客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五杂俎 其三","author":"周紫芝","text":"五杂俎，夜茫茫。\n往复来，雁南翔。\n不得已，思故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荔枝香","author":"周紫芝","text":"千秋节当八月五，御楼卷帘看马舞。\n黄衫玉带分两行，绣衣宫人击雷鼓。\n梨园法曲凄且清，相传犹是隋家声。\n宜春北院蛾眉小，初按新声未有名。\n侍女焚香跪瑶席，更看真妃作生日。\n恰值南方驿使来，旋采风枝露犹湿。\n当时盛事人争传，荔枝香曲是新翻。\n宫中行乐事亦秘，此曲不许人间闻。\n马嵬梦断香尘息，满山荔子无人摘。\n却归西内冷如冰，一听遗音泪空滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武溪深","author":"周紫芝","text":"五溪妖蛮盘瓠种，穴狐跳梁恃馀勇。\n汉庭老骥闻朔风，两耳如锥四蹄踊。\n南方毒雾堕跕鸢，五溪溪深军不前。\n健儿六月半病死，欲渡五溪无渡船。\n将军誓死心独苦，本为官家诛黠虏。\n谁知君侧有谗徒，刚道将军似贾胡。\n人生富贵一衰歇，会令薏苡成明珠。\n祁连高结卫青冢，文渊藁葬无人送。\n至今行客武溪傍，谁为将军一悲恸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公无渡河","author":"周紫芝","text":"清江漫漫日夜流，江边无风人自愁。\n冯夷击鼓河伯怒，蛟龙掉尾鱼吞舟。\n人生一死亦难处，何不相从听媪语。\n公无渡河公自苦，人心险过山嵯峨，豺狼当路君奈何。\n劝君收泪且勿歌，世间平地多风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饮马长城窟行","author":"周紫芝","text":"长安城边边地永，万里沙场地无井。\n秦人掘土土作城，城下窟深胡水冷。\n汉家将军号都护，西征上陇寒日暮。\n野驼跑水无处寻，饮马长城窟边去。\n长城窟，古来战死多白骨。\n征人半作马下尘，犹向阴山斗驰突。\n去时胡天霜雁鸣，归见玉关春草生。\n将军功高封列城，斗死伍符无姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金铜歌","author":"周紫芝","text":"武皇开疆三万里，滇池初穿柏梁起。\n更铸仙人承露盘，万岁千秋奉天子。\n当时谩说邜金刀，谁知更有当涂高。\n铜雀台高阿瞒死，八方才人闹如蚁。\n玉井绮栏心未厌，犹取金仙着前殿。\n金仙辞汉忆汉主，登车殷勤垂玉箸。\n独捧金盘出故宫，回头忍看咸阳树。\n魏宫群臣眼亲见，朝着魏冠暮归晋。\n可怜长安肉食儿，不如顽铜犹有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日出东南隅行","author":"周紫芝","text":"春风淡荡春云浅，陌上柔桑青宛宛。\n青天易雨亦易晴，吴蚕催眠欲成茧。\n罗敷采桑南陌头，翠鬟皴鬌光欲流。\n罗襦吹香白玉佩，青丝络笼黄金钩。\n君王年少如秋水，欲学鸳鸯对飞起。\n赠君身上双明珰，结君同生亦同死。\n罗敷敛衽前致词，词多慷慨中含悲。\n念言夫婿良家子，委身结发为夫妻。\n人生匹配各有偶，愿逐狗走随鸡飞。\n江水可竭山可移，妾心皎皎君当知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌夜啼","author":"周紫芝","text":"黄门急诏下，趣封南郡王。\n鸾辂俨且深，班剑列成行。\n建以左纛旆，树以羽葆幢。\n骨肉厚恩义，门户生辉光。\n分封得大国，四境弥土疆。\n那知以嫌猜，将身触嗔怒。\n徵我还上都，令我不得住。\n夺我封侯印，被我五两组。\n低头屏气息，对客不敢语。\n红窗昏夜灯，白泪堕秋雨。\n郁郁两大树，依依近墙宇。\n鸦鸦枝上啼，腷腷振两羽。\n沉沉夜未央，紞紞方三鼓。\n侍儿闻之喜，揽衣中夜起。\n起敲斋閤门，秉烛具肴旨。\n再拜前致词，灵乌未可鄙。\n吾闻乌夜啼，霈泽覃万里。\n杲杲方平旦，使者已在门。\n官家有诏书，为君敦厚恩。\n旧愤知己释，徙封意增勤。\n客有鲍书记，当代称能文。\n命作啼乌曲，乐府传清芬。\n人生欲富贵，生身恨不早。\n富贵岂不好，危机亦难蹈。\n古来兄弟间，生死在一朝。\n煮豆然豆豆叶焦，灵乌莫厌声哓哓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上之回","author":"周紫芝","text":"汉宫三十六，复道高崔嵬。\n皇情极游豫，警跸北之回。\n苍螭挟龙辀，风伯清路埃。\n羽卫森戛击，玉舆久徘徊。\n青娥绝望幸，故宫秋叶催。\n举头望霄汉，白露零玉阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得宝子","author":"周紫芝","text":"蓬莱宫中春草绿，君王无事欢不足。\n宜春北院小蛾眉，日日霓裳按新曲。\n侍女倾心复尽计，歌舞君前不如意。\n今年新得太真妃，从此龙颜不胜喜。\n望春楼下纥那歌，枉说扬州古铜器。\n梨园乐府两部齐，尽歌乐府新歌词。\n君门谁道九重远，岁久欢声闻远夷。\n渔阳万骑仓黄入，帐中妃子吞声泣。\n当时掌上不忍看，玉骨埋时烟雨湿。\n属车尘远空邮亭，邮亭牧竖嗟娉婷。\n凌波袜在香未绝，万人争看俱伤情。\n一朝持入咸阳市，空得千金贾客惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昭君行","author":"周紫芝","text":"汉宫侍女知几千，争妍取宠俱可怜。\n谁知恩爱托画手，黄金买得昭阳眠。\n昭君自恃玉颜好，未信光阴镜中老。\n不知万里嫁胡儿，憔悴蛾眉葬秋草。\n忆得昭君初嫁时，含羞忍泪无人知。\n胡天漫漫沙漠远，空抱琵琶说别离。\n捐金得宠固可耻，委身胡酋不如死。\n世间妍丑何曾分，自古贤愚亦如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌飞曲","author":"周紫芝","text":"江云欲雪江风吹，王敦城头乌夜啼。\n云深月暗风转急，惊乌绕树无安枝。\n狂风忽来飞不定，夜半无巢何所依。\n情知天公有风雨，何不结巢高树栖。\n君不见秦氏庭中双桂美，庭乌生雏八九子。\n乌生岂不念高飞，托君庭阴飞不起。\n那知君家轻薄儿，弹丸脱手两翅垂。\n无巢悔不巢巍巍，有巢悔不常高飞，人生祸福难豫期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兰词","author":"周紫芝","text":"艺兰当九畹，兰生香满路。\n纫君身上衣，光明夺缣素。\n孤芳一衰歇，凋零湿秋露。\n佩服得君子，亦足慰迟暮。\n采摘良不辞，新枝忽成故。\n向来桃李场，红颜照当户。\n纷纷自芳菲，荣枯复谁顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金错刀","author":"周紫芝","text":"美人临晓镜，睡足含春娇。\n手持白玉尺，睥睨金错刀。\n欲将双綵凤，对飞宫锦袍。\n谁知游冶郎，经年事游遨。\n但知山上山，不说大刀头。\n君看良家子，尽属六郡豪。\n一朝著铠甲，万里随炊刁。\n家人剪春衫，欲寄道里遥。\n缄封望绝塞，蓬首时自搔。\n荡子会当归，行人日儦儦。\n别去隔生死，不保夕与朝。\n寄言楼中妇，清泪且当收。\n犹胜作征衣，远寄边城秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖阴行","author":"周紫芝","text":"石头城南五马渡，一马成龙上天去。\n晋家天子再御朝，洛阳胡骑空无数。\n当时枉道马与王，高官饱食丰豺狼。\n车前已赐兰斑物，江上空馀剑戟场。\n日光射天惊贼垒，封豖长蛇梦中起。\n仓皇只欲玩遗鞭，谁信龙媒已千里。\n黄须有智人岂知，不料将军未死时。\n着新脱故真是贼，白犬下齧天应迟。\n谁道晋朝公与相，不及金谷园中儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隋渠行","author":"周紫芝","text":"黄榆落尽河水冰，隋渠两岸无人行。\n雪花漫天大如掌，北风吹马南人惊。\n县官藏冰避炎热，健儿凿冰手流血。\n安得身随花石官，当路谁人敢呵喝。\n黄流千里冻彻底，舳舻相仍冻衔尾。\n天公便合回阳和，桃花水暖流春波。\n望春楼上天颜喜，齐声争唱纥那歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长干曲","author":"周紫芝","text":"黄昏明月上朱楼，帘旌射月香雾浮。\n画栏垂手楼中女，对月低眉不举头。\n人似长干桥下水，一去悠悠几千里。\n谩道嫁鸡逐鸡飞，长干夫婿那得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五男父","author":"周紫芝","text":"白头垂垂五男父，一生辛勤立门户。\n五男炊白割红鲜，阿翁采薪供五男。\n悲风惨惨寒日暮，翁入采山遭猛虎。\n猛虎磨牙卧道边，五男持戟谁敢前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魔军行","author":"周紫芝","text":"五岭南来山最多，驱军日涉千坡陁。\n山中食菜不食肉，十室九家俱事魔。\n县官给钱捕魔鬼，八万魔军同日起。\n将军新破强虏回，马前班剑如流水。\n生斩妖精拔羽幢，传首天庭藁街死。\n当时平田作战场，至今遗骼无人藏。\n旧居虽在人不见，破屋萧萧围短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野妇行","author":"周紫芝","text":"新安野妇双鬓垂，红膏涂靥深画眉。\n青襜两幅不掩骭，赤脚一双深染泥。\n饷耕如宾有翁媪，头戴银冠相媚好。\n银冠犹是嫁时妆，马上不知人绝倒。\n长年相见无别离，竟死不识愁眉啼。\n红颜暗逐春光老，暮栉常随落日低。\n秋娘一尺春风髻，下蔡阳城尽风靡。\n倾城可爱亦可怜，野妇谁知有西子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"输粟行","author":"周紫芝","text":"天寒村落家家忙，饭牛穫稻催涤场。\n燎薪炊黍呼妇子，夜半舂粟输官仓。\n大儿担囊小负橐，扫廪倾囷不须恶。\n县胥里正不到门，了得官租举家乐。\n去年有米不愿馀，今年米白要如珠。\n路傍老人拍手笑，尽道官兵嫌米粗。\n良农养兵与胡竞，胡骑不来自亡命。\n田家终岁负耕縻，十农养得一兵肥。\n一兵唱乱千兵随，千家一炬无孑遗。\n莫养兵，养兵杀人人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食曲","author":"周紫芝","text":"三月江南好春色，买酒家家作寒食。\n男呼女唤俱出游，扶路醉归欢乐极。\n街头尽日无人行，多在山村少在城。\n踏歌赛愿一时了，上冢归来闻笑声。\n岂料如今一百五，画戟满城椎战鼓。\n子孙半作泉下人，薄酒不浇山上土。\n死者已往生者存，随分欢娱各儿女。\n烹鱼裹菜当盘飧，花作红妆鸟歌舞。\n君不见江南江北多战场，去年白骨无人藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木芙蓉歌","author":"周紫芝","text":"吴江十月霜华浅，秋空无云霜日暖。\n芭蕉树暗帘幕垂，木芙蓉开红婉婉。\n银床露重梧叶飞，金钱扫地秋兰萎。\n无人自对秋风笑，黄菊葵花不同调。\n慢绿妖红解醉人，徐娘未老秋娘少。\n少年时节欢乐多，红莲影落秋江波。\n若耶女儿白如玉，夜半采莲闻棹歌。\n惊风吹浪鸳鸯起，回头日月飞梭里。\n对花不饮今蹉跎，泪湿秋风当奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雍门行","author":"周紫芝","text":"忆昔长安昼闭门，胡兵四面如云屯。\n嗣皇明圣日月出，尽刬宿蠹清妖氛。\n黄门急诏忽夜下，驿骑四出争驰奔。\n明朝都人看传首，贺客纵横各持酒。\n利剑空膏六贵人，富贵回头信何有。\n一身成粉骨成尘，当时近前丞相嗔。\n高台曲池已荆棘，援琴谁作雍门吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]