[{"title":"金钱菊 其二","author":"史铸","text":"天女将图买断秋，算来白帝价难酬。\n金钱满閤翻嫌富，撒向幽丛竟不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金钱菊 其一","author":"史铸","text":"阴阳铸出绕篱边，露洗风磨色灿然。\n未解济贫行世上，且图买笑向樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金铃菊","author":"史铸","text":"化工写出烂盈枝，颗颗光明耀竹篱。\n赏玩佳人应笑道，待教系向雪狮儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孩儿菊","author":"史铸","text":"地母提来风露径，笑风泣露并堪怜。\n品微元乏香肌骨，滥预秋英得浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春菊","author":"史铸","text":"莫论园蔬品目卑，花开不减菊幽奇。\n灿然金色仍堪采，春老恰如秋老时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残菊","author":"史铸","text":"天地方收肃杀功，菊枝倾倒不成丛。\n碎金狼藉不堪摘，图得人知色是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残菊","author":"史铸","text":"节去蜂愁蝶不知，冷香消尽晚风吹。\n碎金狼藉不堪摘，空作主人惆怅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种菊","author":"史铸","text":"春初种菊助盘蔬，益气轻身载旧图。\n终藉九秋扶正色，芳时偷得醉工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胜金黄","author":"史铸","text":"篱下秋深花正敷，煌煌金彩照吾庐。\n维扬贡品虽称贵，颜色看来反不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茱萸菊","author":"史铸","text":"品出陶家花品外，名存吴地药名中。\n若将泛入重阳酒，不用分香摘两丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔枝菊","author":"史铸","text":"莫论枝上粟团黄，且喜篱边珍颗香。\n若使唐家妃子见，料应误摘醉中尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花菊","author":"史铸","text":"仙源分派到篱东，灼灼秾华缀露丛。\n崔护诗章陶令酒，两家混作一家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"粉团菊","author":"史铸","text":"月姊容颜别一家，天真何必御铅华。\n秋来残腻方抛弃，幻作篱边馥馥花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绣线菊","author":"史铸","text":"天成素缕结秋深，巧刺由来不犯针。\n篱下工夫何绚烂，条条绾缀紫花心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绣菊","author":"史铸","text":"寒葩缕缕结缃红，不待纤针见巧工。\n秋老从他宫线减，彩文翻喜入花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"密友菊","author":"史铸","text":"寒英雅称伴吾徒，色正香清态有馀。\n日涉中园长与会，何忧因数反成疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徘徊菊","author":"史铸","text":"花神著意驻秋光，不许寒葩陡顿芳。\n敷彩盘桓如有待，幽人把玩不须忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚菊","author":"史铸","text":"节过霜风衮衮来，菊花寂寞晚仍开。\n谁云既晚何用好，为我殷勤送一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚菊","author":"史铸","text":"青蕊重阳不堪摘，重阳已过菊方开。\n不将时节较早晚，且折霜蕤浸玉醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮南菊","author":"史铸","text":"割脂簇蜡密成团，杰出东篱最奈寒。\n加紫翻宜霜后看，料应惯见属刘安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"毬子菊","author":"史铸","text":"团圞秋卉出篱东，惹露凌霜衮衮中。\n疑是花神抛未过，更教辗转向西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊花","author":"史铸","text":"独芳三径属秋深，清致贞姿快赏心。\n解道卓为霜下杰，平生靖节最知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野菊","author":"史铸","text":"寒郊露蕊疏仍小，瘦地霜枝细且长。\n境僻人稀谁与采，马蹄赢得践馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野菊","author":"史铸","text":"一簇疏篱有野花，不应青女妒容华。\n繁英自剪无人插，只有黄蜂趁两衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野菊二首 其二","author":"史铸","text":"野花无主为谁芳，酒熟渔家擘蟹黄。\n遇酒逢花须一笑，故留秋意作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野菊二首 其一","author":"史铸","text":"熠熠溪边野菊黄，风前花气触人香。\n可怜此地无车马，扫地为渠持一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"银盘菊","author":"史铸","text":"秋英疑是白金裁，承露如从仙掌来。\n翻笑汉皇铜制古，斩新一样也奇哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄白菊","author":"史铸","text":"金英铄铄擅秋芳，中有孤丛色夺霜。\n手把数枝重叠嗅，两般颜色一般香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄白菊","author":"史铸","text":"二色秋英并一根，金宜为友玉为昆。\n相依笑向西风里，皓色须还中色尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塔子菊","author":"史铸","text":"金彩煌煌般若花，高蟠层级巧堪誇。\n更添佛顶周遭种，成此良缘胜聚沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒菊","author":"史铸","text":"不畏霜风质自殊，不招蜂蝶艳何孤。\n梅花松竹如相见，便合添为四友呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御爱黄","author":"史铸","text":"贵品传来自禁中，色鲜如柘恍迷蜂。\n作歌亦见钟情重，承眷应曾遇德宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御袍黄","author":"史铸","text":"秋晚司花逞巧工，解将柘色染幽丛。\n待看开向丹墀畔，宛与君王服饰同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫菊","author":"史铸","text":"秋野閒花是绣铺，佳名得自北人呼。\n若教尼父当时见，应恶纷纷色乱朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缠枝白","author":"史铸","text":"西风顿拆晚秋葩，色映霜华与月华。\n不特翠枝柔猗傩，更饶绿叶密交加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾菊","author":"史铸","text":"春架秋篱景一同，想因分种自蚕丛。\n但将酩酊酬佳节，不管花居酒品中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馒头菊","author":"史铸","text":"离火供炊饼饼圆，幽人饱玩向篱边。\n采来还问堪餐否，应使痴儿口堕涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕脂菊","author":"史铸","text":"天女染花情若狂，鲜妍直欲媚秋光。\n忍将陶径黄金色，也学秦宫朱脸妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又蜜卣菊","author":"史铸","text":"化工也学割蜂房，秋卉妆成春蕊黄。\n芬馥犹疑盛秬鬯，未容轻把泛霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大笑菊 其二","author":"史铸","text":"晚节敷华性异常，黄冠白羽道家妆。\n料应识破荣枯事，独对秋风笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橙菊","author":"史铸","text":"上林佳果久流声，秋径香苞特假名。\n正赖蟹肥新酒熟，幽人来赏两含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹菊","author":"史铸","text":"本是秋香九日黄，假为国色百花王。\n待残拟把酥煎啖，莫采芳英泛酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侧金盏","author":"史铸","text":"圆模罗列占东篱，西帝赐来宫样奇。\n疑是花神清酌罢，尽教放处不妨攲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种菊","author":"史铸","text":"幽怀远慕陶彭泽，一亩荒园试为锄。\n自种黄花添野景，几多光彩照庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹧鸪 咏桃花菊","author":"史铸","text":"底事秋英色厌黄。\n喜行春令惜红妆。\n谢天分付千年品，特地搀先九日香。\n陶令骇观须把酒，崔生瞥见误成章。\n蜂情蝶思兼迷了，采蕊还如媚景忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滴滴金","author":"史铸","text":"未见秋来花便开，人言因露作根荄。\n千团万点枝头坠，尽化黄金出土来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和九日赐宴琼林苑","author":"史浩","text":"鸣跸登高秋暮天，西郊辇路直如弦。\n禁园花覆千官醉，愈觉君恩湛湛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋对月","author":"史嵩之","text":"一片瑶光万里开，停杯追忆谪仙才。\n寻常明月不易见，如此中秋能几来。\n零落故人非白社，登临何地不瑶台。\n欲招黄鹤临风去，为问霓裳安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪消得寒字","author":"史浩","text":"同云收万里，爱日已三竿。\n见睍将潜迹，无风特地寒。\n晴檐如下雨，槁涧忽鸣湍。\n渐觉山河复，方知世界宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"史愚","text":"深院宇。\n寂寂不禁风雨。\n苔径流钱青莫数。\n银泥蜗篆古。\n满院多应无主。\n却被痴儿拈取。\n穿向柳丝喧笑语。\n买将春色去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜闻蛩和壁间韵","author":"史慥之","text":"霜气添秋肃，蛩声入夜清。\n为谁衣未织，向我语偏明。\n庭外三更月，床头万里情。\n凄然如有诉，愁思动人生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴庆池禊宴","author":"史瑜","text":"池馆春光欲禁烟，芳辰修禊集群贤。\n茂林深处森冠剑，清籁鸣时当管弦。\n召伯甘棠分陕地，羊公风景岘山前。\n诗成莫讶天机俊，潜握人间造化权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"史蒙卿","text":"途穷那免哭，哭罢一高歌。\n白日催年急，青山阅世多。\n浮生从潦倒，遗恨不消磨。\n何许南来雁，殷勤掠暝过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"史蒙卿","text":"宫花攒晓日，仙鹤下云端。\n自是伤心极，那能著眼看。\n风沙两宫恨，烟草八陵寒。\n一掬孤臣泪，秋霖对不乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鹅鼻山","author":"史干","text":"龙泉五盏张帆去，鹅鼻三杯衣锦归。\n寄语长泉后生者，年年盛事莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国清寺","author":"史蕴","text":"十里松关路，门开对洞天。\n山神曾献地，海众此安禅。\n钟磬开岩谷，楼台跨石泉。\n高峰智者塔，长与赤城连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"史骧","text":"花分先后留春久，地带东南见月多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"史骧","text":"坐禅猿鸟看，谈易鬼神听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"史骧","text":"坐来夜半天河转，挑尽寒灯心自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴皮题壁","author":"叶三英","text":"求仙那得仙来访，多积阴功至有馀。\n欲悟东林沈东老，故留三十六玄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盛氏衔翠轩","author":"叶三锡","text":"平生丘壑心，漫浪不羁束。\n青山亦解意，四时共追逐。\n朝翠空濛时，北窗梦清熟。\n昼寂庭户凉，坐课黄卷读。\n此心与山违，对面若掩目。\n孱颜俨如故，心境两不触。\n宴坐收万象，剖璞出苍玉。\n木末流夕晖，窗户影摇绿。\n相对两青眼，悠然一笑足。\n此意陶潜知，不然问玉局。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王学正 其二","author":"叶大年","text":"遗文脍炙在吾乡，赋罢谁能少荐扬。\n声迹有妻先蝶梦，行藏无子付洴方。\n云萝烟蔓新泉宅，秋月春花旧野堂。\n交倡丝笺真翰墨，几人知为宝巾箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王学正 其一","author":"叶大年","text":"书剑当年游上都，贤关虫篆校诸儒。\n文华灿灿九苞凤，俊气骎骎千里驹。\n妙质竞谁挥垩漫，白头空此死樵苏。\n遗编残稿应犹在，搔首令人益叹吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉赋水仙花诗以谢提宫龚丈之贶","author":"叶子强","text":"水晶宫阙云母軿，列仙夜宴晓未阑。\n万妃倚竹翠袖寒，捧黄金杯白玉盘。\n劝酬未足云中欢，天门叫班奏祥鸾。\n惊此绰约落尘寰，嫣然花面明雕栏。\n天香宫态冰雪颜，江梅避舍不敢干。\n肯与哙伍羞山樊，说似诗伯平章看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书堂五首 其五","author":"叶子强","text":"少长事壮厉，意气弥九州。\n鞭车踏长路，渠料能夷犹。\n困此九折坂，嵚崎不容辀。\n彼须匪所彊，此售宁或求。\n犹有读书心，大寒索衣裘。\n贱嗜匪贵献，一拂销百愁。\n宝此清净退，相从赋归休。\n农圃雅所问，同一壑一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书堂五首 其四","author":"叶子强","text":"左角明西方，十分农事回。\n鞭蒲正尔束，系圄夷然开。\n我胡汝乎德，一朝变喧豗。\n仁义不蹂践，肺肝自胚胎。\n再拜父老言，美意吾所该。\n诗书不得力，亦自书中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书堂五首 其三","author":"叶子强","text":"小山后丛桂，方池前止水。\n泠然堂中人，枯槁祇中尔。\n平生不止酒，来此真止矣。\n今辰忽开尊，叵料真未止。\n瓶罍本非二，无罄亦无耻。\n卷尊佩君言，慕之戴星起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书堂五首 其二","author":"叶子强","text":"娟娟百个竹，落落一丈松。\n岂无桃李华，春事孰与冬。\n寒菊北户下，不斗颜色秾。\n气味如秃翁，忍死无容容。\n霜风落系雁，露草栖织蛩。\n读书真可人，明星耿疏篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书堂五首 其一","author":"叶子强","text":"诗书不策勋，岁月忽已晚。\n堕此尘?网，吾行其既远。\n胡宁于书事，意爱犹缱绻。\n况之迷蹊人，慕顾祇旧阪。\n扁旁真赤帜，所立示所本。\n又如农人心，终不置穮蓘。\n晞发茅檐下，荣荣兰九畹。\n初服苟未替，无亦惊晼晚。\n所逢非所安，吾庐盍云返。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山寺","author":"叶元素","text":"一树桃花一半空，不堪狼籍梵王宫。\n山僧手把青鸾尾，背却东风扫落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自赞","author":"叶元素","text":"心事茫然两鬓斑，十年空走利名关。\n算来只合苔矶坐，钓不得鱼犹得閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"叶元素","text":"家住夕阳江上村，一湾流水护柴门。\n种来松树高于屋，借与春禽养子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人从军","author":"叶元素","text":"斗酒不为薄，饯君千里行。\n时危见豪杰，年少易功名。\n旗影龙蛇动，甲光霜雪明。\n天山三箭定，不请羽林兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留宿山家","author":"叶元素","text":"山翁留我宿，行倦看群捷。\n黄□满山落，白猿终夜啼。\n枕边千里梦，窗外一声鸡。\n明日登程去，何村日又西。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家杂兴","author":"叶元素","text":"鸣榔声里过吴松，月似银槃贴水中。\n网得锦鳞鱼数尾，岂无一尾是蛟龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登凌云山绝顶","author":"叶升","text":"崔巍万仞俨危梯，蹑履多凭一杖藜。\n老宦跻崖冲斗动，高朋立顶惹风啼。\n振衣远望乾坤小，举首回看日月低。\n自是登天疑有路，云山缥缈夕阳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]