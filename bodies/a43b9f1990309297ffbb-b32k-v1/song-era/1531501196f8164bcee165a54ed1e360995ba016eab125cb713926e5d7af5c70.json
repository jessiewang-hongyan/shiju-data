[{"title":"县斋十咏 其十 石席","author":"宁参","text":"结粹从天匠，周方出翠峦。\n宁知磨琢易，须信卷舒难。\n角枕清同置，藜床雅并观。\n公馀聊偃息，空觉病肤寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋十咏 其九 波纹石","author":"宁参","text":"何必观春渚，他山质自奇。\n危层分荡漾，峭碧认逶迤。\n禁陛宜相接，星机好共支。\n高空如有阙，一补未为迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋十咏 其一 思齐楼","author":"宁参","text":"高闬营层构，翚飞势自伸。\n已闻能赋客，空忆带星人。\n彫槛凭秋迥，朱扉敞汉新。\n龟趺清刻在，谁共继芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋十咏 其七 载荣桐","author":"宁参","text":"几年惟悴质，一旦类生稊。\n玉甃青初满，银床绿乍齐。\n雅胜玄雨润，高称峄阳低。\n况有苍姬叶，还当副剪圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋十咏 其四 藏书阁署群籍也","author":"宁参","text":"洞辟前轩峻，危梯趣若何。\n绿苔生未遍，缥帙聚还多。\n晓幌吞清旭，秋栏拂静柯。\n犹怜铅笔在，公外独频过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋十咏 其三 惟勤阁","author":"宁参","text":"自责思前古，徒名是永怀。\n善声惭偃室，幽兴类萧斋。\n未报投虚刃，空防肆毒材。\n恪居知有地，僶俛竞相谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉鱼池","author":"宁某","text":"四百峰峦隐画屏，翠光楼阁起山溟。\n高侔太岳千山小，势镇乾坤万古青。\n石洞猿啼烟月落，嘉池龙起水云腥。\n临流矶上谁遗迹，隐约仙人窦子明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"宁瞻","text":"道高轩昊名犹晦，礼绝嵩衡位始尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨伯子","author":"左次魏","text":"銮坡蓬监两封书，道院东西各付渠。\n乾道圣人无固必，是非付与直哉鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马世功豁野堂","author":"左玙","text":"欢言赴幽期，作意理烟艇。\n曳缆松篁阴，未觉心地迥。\n舍舟登爽垲，微步水云净。\n扶舆登斯堂，遐眺方一骋。\n开轩纳野色，秋思浩千顷。\n心随片云远，目送孤鸿影。\n坐久襟宇宽，万事讵容省。\n永愿陪清游，栖身白鸥境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚","author":"左纬","text":"池上柳依依，柳边人掩扉。\n蝶随花片落，燕拂水纹飞。\n试数交游看，方惊笑语稀。\n一年春又尽，倚杖对斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋刘敏叔画杨诚斋先生探梅图","author":"左谟","text":"冲寒踏雪行溪路，对月看梅太瘦生。\n莫道亲曾陪杖屦，只今见画也心清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其二","author":"左誉","text":"一段离愁堪画处，横风斜雨摇衰柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其三","author":"左誉","text":"帷云剪水，滴粉搓酥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其一","author":"左誉","text":"无所事，盈盈秋水，淡淡春山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妾薄命","author":"左瀛","text":"妾貌微微改，君恩渐渐疏。\n本期为匹鸟，深恐作前鱼。\n却月无心画，香云信手梳。\n佳人多薄命，不必重欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋梅花","author":"布衣某","text":"影摇溪脚月犹冷，香满枝头雪未乾。\n只为传家太清白，致令生子亦辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"本之","text":"一篙春水滑无声，一叶轻舟过短亭。\n飞蔼晚楼迷紫翠，夕阳孤塔认丹青。\n怀人远折三花树，何日相携双玉瓶。\n欲唤渔郎问风色，凫鹥飞处酒初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"永秀","text":"禾黍离离满故都，君诗读罢泪倾珠。\n立朝食禄千官富，为国忘躯一事无。\n兵革已将临北阙，笙歌犹自醉西湖。\n黄冠氅服今谁识，前宋遗贤有此儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富沙","author":"王来","text":"忽惊羁旅身，已落富沙湾。\n江海旧茅屋，遥岑带潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"玉英","text":"塞上早春时。\n暖律犹微。\n柳舒金线拂回堤。\n料得江乡应更好，开尽梅溪。\n昼漏渐迟迟。\n愁损仙机。\n几回无语敛双眉。\n凭遍阑干十二曲，日下楼西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉壶洞","author":"玉壶洞客","text":"洞前流水碧于苔，洞口桃花扑面开。\n转头望断意不断，长啸一声须再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题樟林寺","author":"玉盘居士","text":"千岩壁立任苍苔，今日玉盘居士来。\n洗斸云根堪宴坐，不教独秀在天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹅翎山","author":"甘同叔","text":"俗谓鹅翎未必然，娥英恐是古时传。\n溪声流尽苍梧泪，斑竹林中闻杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题昌山圣姥庙","author":"甘同叔","text":"分宜古县环清溪，重冈复岭如奔驰。\n行逢山断水流处，阅城庙枕山之西。\n我来落日在前岭，摩挲一读卢肇碑。\n嗟唐去今亦巳久，尚馀文字光陆离。\n云昔秦人有天下，鏖战六国愚黔黎。\n砀山云气望不见，神物乃降江之嫠。\n雷轰电合助光怪，蜿蜒堕地偕群儿。\n赤鳣王鲔奉鼎俎，追逐甘旨怜姥慈。\n姥先仙去环佩冷，安能蟠蛰从儿嬉。\n刘累不出浮俗隘，况肯委质嬴与斯。\n珠宫贝阙世所希，铜环十二白玉扉。\n纫兰作佩香披披，招摇手掉芙蓉旗。\n哀弹清瑟和宓妃，大川击鼓劳冯夷。\n巨鱼踊跃鼋鼍随，虾蟹琐细不得追。\n庙门开阖风飔飔，千年万载龙居之。\n野巫侦伺荐酒卮，箫鼓坎坎来宫祠。\n五彩不辨虺与螭，聊以幻化惊群迷。\n嗟我四海久望霓，无复空抱明月辉。\n好施膏泽雨六合，岂止但慰袁人思。\n历阶酌水致此辞，退以遗谊传于诗。\n才悭语颣论甚卑，龙兮谨勿相诃讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风入松 其一","author":"田中行","text":"一宵风雨送春归。\n绿暗红稀。\n画楼尽日凭阑意，与谁同捻花枝。\n门外蔷薇开也，枝头梅子酸时。\n玉人应是数归期。\n翠敛愁眉。\n塞鸿不到双鱼远，恨楼前、流水难西。\n新恨欲题红叶，东风满院花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"田为","text":"映竹园啼乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江神子慢/江城子慢","author":"田为","text":"玉台挂秋月。\n铅素浅，梅花傅香雪。\n冰姿洁。\n金莲衬、小小凌波罗袜。\n雨初歇。\n楼外孤鸿声渐远，远山外、行人音信绝。\n此恨对语犹难，那堪更寄书说。\n教人红销翠减，觉衣宽金缕，都为轻别。\n太情切。\n消魂处、画角黄昏时节。\n声呜咽。\n落尽庭花春去也，银蟾迥、无情圆又缺。\n恨伊不似馀香，惹鸳鸯结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"田为","text":"嫩冰未白，被霜风换却，满院秋色。\n小阁深沈围坐促，初拥红炉宜窄。\n帘密收香，窗明迟夜，砚冷凝新滴。\n无人知道，个中多少岑寂。\n翻念一枕高唐，当年仙梦觉，难寻消息。\n睡起微醒衣袖重，不管腰支犹索。\n旋暖银簧，时添酥字，笋玉寒无力。\n如今肠断，暮云依旧凝碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南柯子/南歌子 其一 春景","author":"田为","text":"梦怕愁时断，春从醉里回。\n凄凉怀抱向谁开。\n些子清明时候、被莺催。\n柳外都成絮，栏边半是苔。\n多情帘燕独徘徊。\n依旧满身花雨、又归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南柯子/南歌子 其二 春思","author":"田为","text":"团玉梅梢重，香罗芰扇低。\n帘风不动蝶交飞。\n一样绿阴庭院、锁斜晖。\n对月怀歌扇，因风念舞衣。\n何须惆怅惜芳菲。\n拚却一年憔悴、待春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜黄花慢","author":"田为","text":"雁空浮碧，印晓月，露洗重阳天气。\n望极楼外，淡烟半隔疏林，掩映断桥流水。\n黄金篱畔白衣人，更谁会、渊明深意。\n晚风底。\n落日乱鸿，飞起无际。\n情多对景凄凉，念旧赏，步屐登高迢递。\n兴满东山，共携素手持杯，劝泛玉浆云蕊。\n此时霜鬓欲归心，谩老尽、悲秋情味。\n向醉里。\n免得又成憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探春/探春慢","author":"田为","text":"小雨分山，断云镂日，丹青难状清晓。\n柳眼窥晴，梅妆迎暖，林外幽禽啼早。\n烟径润如酥，正浓淡遥看堤草。\n望中新景无穷，最是一年春好。\n骄马黄金络脑。\n争探得东君，何处先到。\n万盏飞觞，千金倚玉，不肯轻辜年少。\n桃李怯残寒，半吐芳心犹小。\n谩教蜂蝶多情，未应知道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄荔枝与盛参政","author":"田从易","text":"樱桃真小子，龙眼是凡姿。\n橄榄为下辈，枇杷作客儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元","author":"田太靖","text":"元宵灯火照楼台，车马骈骈去又来。\n田郎试向楼上望，灯前好个阿孩孩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临封杂咏 其三","author":"田开","text":"我爱临封好，江流压水滨。\n东山画屏展，北阜翠虬驯。\n十里长松道，三春解佩人。\n乘閒狂太守，屐齿往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临封杂咏 其六","author":"田开","text":"我爱临封好，迎门水绕流。\n名山称濯锦，胜境说灵洲。\n嫩草青连座，奇花香入楼。\n公馀无一事，携酒任遨游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临封杂咏 其二","author":"田开","text":"我爱临封好，诗人兴味长。\n岭南蕉子国，海上荔枝庄。\n民有百年寿，家藏十种粮。\n宦游无远近，乐处是仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临封杂咏 其五","author":"田开","text":"我爱临封好，江楼四望遥。\n宾朋须共赏，风月故相邀。\n清兴拚成癖，诗狂不碍条。\n谩劳争自洁，适意乐偏饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临封杂咏 其一","author":"田开","text":"我爱临封好，人烟十里赊。\n秋风三酿酒，风景四时花。\n竹屋无贫子，渔村足富家。\n守官真吏隐，谩放日高衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临封杂咏 其四","author":"田开","text":"我爱临封好，宾朋日往还。\n年来甘白酒，老去益朱颜。\n引鹤游西寺，携琴上北山。\n君恩虽未报，公外且偷闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"田开","text":"我爱临封好，从来礼义乡。\n江山足形胜，风物半冠裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"田开","text":"吏民相共乐，浑不记相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"田开","text":"山近临轩翠，花开入座红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"田农夫","text":"桃李场中已免参，只将农圃系头衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"田如鳌","text":"投晓凭高雾满天，直疑和气酿丰年。\n殷勤北客还知否，不是南来有瘴烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十九 七月十八日太慈寺观施盂兰盆","author":"田况","text":"飞阁穹隆轶翠烟，盂兰盛会众喧阗。\n且欣酷暑从兹减，渐有凉风快夕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十八 七月六日晚登太慈寺阁观夜市","author":"田况","text":"万里银潢贯紫虚，桥边螭辔待星姝。\n年年巧若从人乞，未省灵恩遍得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十二 九日太慈寺前蚕市","author":"田况","text":"高阁长廊门四开，新晴市井绝纤埃。\n老农肯信忧民意，又见笙歌入寺来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十三 二十一日游海云山","author":"田况","text":"春山缥翠一溪清，满路游人语笑声。\n自愧非才无异绩，止随风俗顺民情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颍水","author":"田况","text":"先生尝此傲明时，绿袖清波万古奇。\n应有好名心未息，滩头洗耳欲人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题琴台","author":"田况","text":"西汉文章世所知，相如闳丽冠当时。\n游人不赏凌云赋，只说琴台是故基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠都监雍元规","author":"田况","text":"醒时莫忆醉时事，今日休言昨日非。\n池上风光宜共釂，劝君不要半酣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其六 二十八日谒生禄祠游净众寺","author":"田况","text":"千骑出重闉，严祠净宇邻。\n映林沽酒旆，迎马献花人。\n艳日披江雾，香飙起路尘。\n韶华特明媚，不似远方春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其五 二十三日圣寿寺前蚕市","author":"田况","text":"龙断争趋利，仁园敞邃深。\n经年储百货，有意享千金。\n器用先农事，人声混乐音。\n蚕丛故祠在，致祝顺民心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十四 三月十四日太慈寺建乾元节道场","author":"田况","text":"赤精流景铄，朱夏向清和。\n绀宇修祠盛，华封祝庆多。\n簪裳千载遇，钟梵五天歌。\n远俗尤熙泰，皇猷信不颇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十六 四月十九日汎浣花溪","author":"田况","text":"浣花溪上春风后，节物正宜行乐时。\n十里绮罗青盖密，万家歌吹绿杨垂。\n画船叠鼓临芳溆，綵阁凌波汎羽卮。\n霞景渐曛归棹促，满城欢醉待旌旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄道士张明真","author":"田况","text":"澹静姿仪简旷纵，结庵深对大茅峰。\n坐忘世故愁应少，道断人情语亦慵。\n万里信音凭鹤到，一厨烟火倩猿供。\n几时归侍虚皇驾，七色霞衣九色龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十 开西园","author":"田况","text":"春山寒食节，夜雨昼晴天。\n日气薰花色，韵光遍锦川。\n临流飞凿落，倚榭立鞦韆。\n槛外游人满，林间饮帐鲜。\n众音方杂遝，馀景更留连。\n座客无辞醉，芳菲又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十五 乾元节","author":"田况","text":"感帝开鸿绪，薰风正阜生。\n亿年逢景运，万国赞丕平。\n瑞霭承龙阙，晨曦启凤城。\n胪宾趋陛墄，乐舞备韶英。\n译导来珍贡，酺欢洽颂声。\n曼龄均庆祝，闿泽慰群情。\n地有扪参远，人怀就日诚。\n愿将民共乐，聊以报皇明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其二 二日出城","author":"田况","text":"初岁二之日，言出东城闉。\n缇骑隘重郛，淤车坌行尘。\n原野信滋腴，景物争光新。\n青畴隐遥坝，弱柳垂芳津。\n逻卒具威械，祭墦列重茵。\n俗尚各有时，孝思情则均。\n归途喧鼓铙，聚观无富贫。\n坤隅地力狭，百业常苦辛。\n设微行乐事，何由裕斯民。\n守侯其勉旃，亦足彰吾仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其七 二月二日游江会宝历寺","author":"田况","text":"昔年张复之，来乘寇乱馀。\n三春虽宴赏，四野犹艰虞。\n遂移踏青会，登舟恣游娱。\n戒备渐解弛，人情悉安舒。\n垂兹五十年，材哲不敢踰。\n愚来再更朔，遽及仲春初。\n綵舵列城隈，画船满江隅。\n轻桡下奔濑，纵舆临精庐。\n因思贤守事，所作民乃孚。\n慈惠未为大，大者其忘诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其八 八日太慈寺前蚕市","author":"田况","text":"蜀虽云乐土，民勤过四方。\n寸壤不容隙，仅能充岁粮。\n间或容堕懒，曷能备凶痒。\n所以农桑具，市易时相望。\n野氓集广廛，众贾趋宝坊。\n惇本诚急务，戒其靡愆常。\n兹会良足喜，后贤勿忽忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其十一 三月三日登学射山","author":"田况","text":"丽日照芳春，良会重元巳。\n阳滨修祓除，华林程射技。\n所尚或不同，兹俗亦足喜。\n门外盛车徒，山半列廛市。\n彩堋飞镝远，醉席歌声起。\n回头望城郭，烟霭相表里。\n秀色满郊原，遥景落川涘。\n目倦意犹远，思馀情未已。\n登高贵能赋，感物畅幽旨。\n宜哉贤大夫，由斯见材美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都遨乐诗二十一首 其四 上元灯夕","author":"田况","text":"予尝观四方，无不乐嬉游。\n惟兹全蜀区，民物繁它州。\n春宵宝灯然，锦里香烟浮。\n连城悉奔骛，千里穷边陬。\n衯裶合绣袂，轣辘驰香辀。\n人声震雷远，火树华星稠。\n鼓吹匝地喧，月光斜汉流。\n欢多无永漏，坐久凭高楼。\n民心感上恩，释呗歌神猷。\n齐音祝东北，帝寿长嵩邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]