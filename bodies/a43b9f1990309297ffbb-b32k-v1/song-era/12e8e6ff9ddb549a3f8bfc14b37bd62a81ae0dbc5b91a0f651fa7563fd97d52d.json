[{"title":"赠致政王朝奉","author":"黄裳","text":"得老归来已几年，水云深处洞中天。\n有身且睡三竿日，无物应看一指禅。\n松竹亭台閒信步，乡闾樽俎谩随缘。\n此生离合谁能定，只见龙潭尚宛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张秘校昔日同游僧舍","author":"黄裳","text":"过去光阴有胜游，翠微深处更乘秋。\n偶寻得石坐云坐，莫问作官休未休。\n世揉道情尘扰扰，云藏诗壁岁悠悠。\n山僧看了须重看，且碧双眸便转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李学士试院感秋二首 其一","author":"黄裳","text":"遽往偶相聚，下帘人事稀。\n感秋那听雨，闻杵屡催衣。\n得丧多士梦，行藏群雁飞。\n黄花期野老，须插满头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李学士试院感秋二首 其二","author":"黄裳","text":"荒庭初得雨，幽点失凋梧。\n滞思舒千卷，高吟想五湖。\n蛩声生翠幄，酒力借微躯。\n袭蹈贻文病，犹难望汉儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘教授","author":"黄裳","text":"升沈相识十三秋，新故如麻一转头。\n久款游从来北阙，遽闻风教入东州。\n自驱矛盾趋中说，谁拥鸾旂玩半流。\n十日菊花犹可醉，多情应且击扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平岚亭","author":"黄裳","text":"平岚亭寄半天身，閒向栏干独倚频。\n往事有怀谁共笑，归云无意自相亲。\n神仙窟宅幽明境，花木园林上下春。\n斗绝一台疑是此，不须低首看红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上","author":"黄裳","text":"一家风景洞天清，不愧东南第一名。\n春入桃源花未落，秋归湘浦月初生。\n便捐世事劬劬到，且置篮舆缓缓行。\n随分堪观无可辨，水光山色竞相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会江晦叔游湖山","author":"黄裳","text":"相随山水里徘徊，兴未阑时慎勿催。\n草草行厨随步去，匆匆渔艇趁船来。\n每逢佳景还含思，偶造幽轩更把杯。\n况是同归无世味，何须旁立有莲腮。\n荻湾桃坞犹留客，不觉银瓶又耻罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送升师行","author":"黄裳","text":"得道无馀事，游方有几年。\n如何超幻境，谁与付真筌。\n初祖昔曾诀，赵州今已仙。\n进修方且学，拂荡未须传。\n归去南山好，休休更说禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题西禅寺","author":"黄裳","text":"谁是怡山不灭仙，定光来应此方缘。\n龙骧凤翥三宗字，狮吼雷鸣六祖禅。\n鱼佩独垂聊徇世，藕丝相感为开天。\n自从日月归真后，衣法何人已得传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题乡老堂","author":"黄裳","text":"未到中年便挂冠，一乡三老北溪寒。\n废兴有命知尤早，去住无心遇更难。\n轻物想能閒似梦，爱山应是好如官。\n莫言林下何曾见，待向图中画与看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次赵彦思东湖见寄","author":"黄裳","text":"为爱江湖梦也寻，有泉来处乱云深。\n凿开澄澈是天界，激起潺湲非世音。\n鸿雁渚幽山两足，芙蓉堂冷水中心。\n花时月夜扁舟兴，相约公馀一醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范宏甫","author":"黄裳","text":"不于场屋便横行，安用诗书寄此生。\n万里一飞虽有志，十年三战未成名。\n风霜已是知秋柏，雷雨何妨借海鲸。\n自愧壮图犹未效，几时樽酒与君评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜张公实至","author":"黄裳","text":"才踰闽岭转悠悠，所属相逢梦未休。\n逸兴起君桑梓国，多情寻我帝王州。\n且看文物新朝事，更话溪山旧酒楼。\n会合此生能几度，一樽长泻菊花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方祖仁都门阻雨","author":"黄裳","text":"未蒙官放此身休，空恨茶园失旧游。\n将谓天边鸿共发，岂知门外雨相留。\n一襟凉过人归室，万朵香残菊送秋。\n兄弟急难君有义，白衣东下更何尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐庐会景亭二首 其一","author":"黄裳","text":"物华才思两无穷，来倚栏干万累空。\n今古坐间山远近，悲欢潮后客西东。\n樵楼上下夕阳外，渔网高低烟雨中。\n想见飞升人只在，留题当识紫玄翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐庐会景亭二首 其二","author":"黄裳","text":"舟楫会通处，阴阳明晦时。\n四并归善政，万象入新诗。\n地胜得仙久，水遥归鹭迟。\n为看滕阁记，将赋此尤宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王道观录事","author":"黄裳","text":"一府观风郡督邮，试看鹰隼在高秋。\n黄花对酌新离别，白雪难思旧唱酬。\n尘绪案头来扰扰，银河天上去悠悠。\n碧罗琢砚初离水，勤写瑰奇度阻脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻刘先生","author":"黄裳","text":"势利交游聚与分，会真堂上合离群。\n形骸外索难为侣，风义中寻偶得君。\n水鉴秋来宜泛月，桃源花后且穿云。\n此生已是龙山客，高论相过我欲闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题望远楼","author":"黄裳","text":"雕栏身有限，芳草意无穷。\n望尽天垂地，吟馀色入空。\n锋铓千里岫，羽翼半天风。\n万象回头了，骈明亦梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈邵老 其一","author":"黄裳","text":"南来安不裂新题，万里悠悠十载睽。\n一别每怀君海角，两除应笑我朝齑。\n是非莫讶时方转，荣辱须惊物未齐。\n故旧九仙山下客，想曾携手泛三溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈邵老 其二","author":"黄裳","text":"几度为书却便休，疏慵于我更如雠。\n两忘有道何须问，相责无情我合羞。\n屡感客尘新事变，难寻陵谷旧时游。\n为亲归去亲犹健，只此浮生已解忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次邦彦节推见寄 其一","author":"黄裳","text":"十年讥笑为谁妨，洒落思君酒瓮旁。\n晓殿虽争多士捷，夜窗还对短檠光。\n静怜春草开三径，冷怪朝齑引五浆。\n且喜相逢头尚黑，江湖休更起怀乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次邦彦节推见寄 其二","author":"黄裳","text":"淮上相逢得胜游，水边乡落水边洲。\n每怜酒旆能留客，长恐秋风便解舟。\n十载穷通重把手，两朝今古一回头。\n金明且看春波绿，共我忘机子与鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄简能","author":"黄裳","text":"形迹分飞有道同，五年声问不须通。\n侍亲官上应尤乐，得子年来想更聪。\n相对忽因山入梦，自窥还爱璧涵空。\n公馀谁伴溪南话，七椀浮云两腋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花洞","author":"黄裳","text":"莲社是非外，洞天空色中。\n一枝樵客梦，两腋石门风。\n鹿径踪何在，榴花信可通。\n此缘当邂逅，来接紫玄翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访曾君施不值","author":"黄裳","text":"有怀高论已经年，不落中间与两边。\n世路几人机寂寂，春风何处骑翩翩。\n四声险韵应寻句，一炷清香想看禅。\n我更欲劳三吐哺，周公今付伯禽贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李奉议","author":"黄裳","text":"更去乡关作子男，得贤当美大夫监。\n暑中雨过乘清洛，公外云开看绿岩。\n遂失故人须举酒，才闻佳境便收帆。\n春晖已报君无愧，一表遗文敕两缄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻冲和子","author":"黄裳","text":"想见高风梦已飞，无心中有道心微。\n此生独断来修养，何处相逢得指归。\n融结几人知火候，斡旋惟子识天机。\n松庵欲对禅床坐，莫问朝曦与夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阴阳","author":"黄裳","text":"阴阳无意本由人，祸福皆缘幻与真。\n悟即离伦兼度世，迷须倾国更亡身。\n智愚莫晓气随数，老少合惊秋复春。\n有物混成如了得，却教真幻两通神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄简陈伯修","author":"黄裳","text":"异香来自洞中春，王屋华阳密作邻。\n宛转白云离紫府，参差青锁断红尘。\n若无天柱难留许，惟有桃花解笑秦。\n我得此官应是分，欲从何处更寻真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"考试军器所和敦礼兵部见示之什","author":"黄裳","text":"梦中宣使至，天上敕书开。\n去骑遵西野，回眸失北槐。\n利名何日了，儒法几回来。\n丹管诛邪说，重帷截乱埃。\n簿书稀见影，典策冗成堆。\n仰望门虽峻，旁求网已恢。\n幽题胸胆破，雄敌剑锋摧。\n狂欲劳弹铗，轻投慎报瑰。\n侯中谁破的，营下各衔枚。\n含蓄飞香翰，搜寻绕翠苔。\n自非衡鉴手，谁是栋梁材。\n累外灰心火，閒中卧鼻雷。\n相投归邂逅，共乐入调诙。\n寥廓丧尔界，勤劳忘彼嵬。\n家音催转历，厅议款衔杯。\n殊品酬三刖，游辞荐一咍。\n无形嗤字号，有秩喜樽罍。\n壁角蚊初动，天南暑已回。\n不惭居屋漏，却厌面墙隈。\n凉满亭亭扇，香馀饼饼灰。\n几时当命驾，此兴可登台。\n清浪风归袖，红鳞酒入腮。\n莫随人俯仰，且共月徘徊。\n既事当如约，分襟便可催。\n棘闱人散后，谁赋北山莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其一","author":"黄裳","text":"瑞意才含蓄，轻花即剪裁。\n清寒穿箔去，丰兆破烟来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二","author":"黄裳","text":"密霰俄传信，痴云预作媒。\n瑶池方潋滟，玉凤更毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其三","author":"黄裳","text":"思见怜初洒，忧消喜渐堆。\n惜明聊自拟，惊密偶同欸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其四","author":"黄裳","text":"片片榆飘荚，累累蚌剖胎。\n遽将天晓报，频把岁华催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其五","author":"黄裳","text":"有景荣千巘，无私瑞九垓。\n水精排瓦砾，天库委琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其六","author":"黄裳","text":"就下深趋坎，凭高杪寄桅。\n四垂才密密，一望已皑皑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其七","author":"黄裳","text":"瀑布斗直泻，仙葩谁碎挼。\n风前鹅毳落，秋后海潮回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其八","author":"黄裳","text":"砻转扬轻矿，筛旋迸细粞。\n纹波翻太液，缟练绕蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其九","author":"黄裳","text":"泛泛冰壶动，漫漫宝鉴开。\n柳条新弄絮，律管乍飞灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十","author":"黄裳","text":"照耀行人氅，光华钓叟台。\n书帷争白日，秋色改黄槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十一","author":"黄裳","text":"比洁须延月，闻香不掩梅。\n载涂人艮趾，入领我咸脢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十二","author":"黄裳","text":"封锁烟尝卫，飞扬露可陪。\n厚将平地堑，高欲峻堂陔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十三","author":"黄裳","text":"特应三冬令，宁伤万物胚。\n秦蛇伸瓦陇，卞璞暴山峐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十四","author":"黄裳","text":"始恐佛氏讲，天花何徘徊。\n终疑宓妃至，仙肌何奇侅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十五","author":"黄裳","text":"砌铺砧上练，池泛瓮中醅。\n丰满莫见睍，优閒休及隤。\n遗圆还得璧，临翠忽亡苔。\n弄巧俄颠漩，争狂忽溯洄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十六","author":"黄裳","text":"空中逢汗漫，望外见崔嵬。\n艳态非因饰，虚根岂可栽。\n先崇逢垄断，后化得墙隈。\n欢贺纷耕叟，欣拿乱戏孩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十七","author":"黄裳","text":"应迷天上鹤，犹压地中雷。\n商色皎且盛，郢歌清更哀。\n檐澌悬剑戟，庭块列杓魁。\n对老凌华发，迎春濯旧埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十八","author":"黄裳","text":"盛疑星汉泻，高恐玉山颓。\n江水聊添涨，春根却忌培。\n渔汀埋舸缆，猎野陷卢鋂。\n覆盖污为洁，消磨厉作灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其十九","author":"黄裳","text":"栖寒禽惴慄，步滑马虺尵。\n富国寒银溢，笼鹏素网恢。\n漫郊频去牧，□穴怆归?。\n户湿知风送，轩鸣想竹摧。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二十","author":"黄裳","text":"密匀瓯渍液，丹映槛凝衃。\n照岁何妨积，侵阶慎勿推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二十一","author":"黄裳","text":"书窗辉竹简，诗笔冻松煤。\n煎煮供茶鼎，收藏厕酒罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二十二","author":"黄裳","text":"拟毡安可卷，欲器不禁锤。\n俯拾甘赪手，昂窥任扑腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二十三","author":"黄裳","text":"误鸡忙下杙，趣雉不须䍙。\n玩久清成兴，吞多冷失咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二十四","author":"黄裳","text":"脂肤堪奖与，墨面可讥诙。\n盐散徒云尔，心虚可比哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偕王道观雪中联句 其二十五","author":"黄裳","text":"助清还啜茗，胜冷屡衔杯。\n辨味凭茶陆，登高惬赋枚。\n袁门清梦未，梁苑胜游才。\n船去须寻戴，诗成盖献裴。\n光馀应可借，□大固难猜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐州游崇宁","author":"黄裳","text":"得官来自洞中天，閒向桑间戏问禅。\n已为命机根玉箓，曾将心印祖金仙。\n懒看小吏呈朝报，喜听高人说世缘。\n一物也无参底事，纷纷谁可付真筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中有作呈崔风子","author":"黄裳","text":"有分寻真莫道难，蓬莱诗句请君看。\n双轮转出三清路，二气烧成九转丹。\n烟霭楼台金虎绕，雪霜宫殿玉龙盘。\n解颜为向潜山近，天柱峰头月夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次严子陵濑 其一","author":"黄裳","text":"纁车曾此贲山林，深谷为陵古到今。\n节行清如台下水，何人能洗利名心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次严子陵濑 其二","author":"黄裳","text":"故人康世自英雄，富贵明知转首空。\n不似羊裘归去好，素痴犹解笑三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次严子陵濑 其三","author":"黄裳","text":"交游分在红尘外，主客缘从紫极中。\n各有志存休见迫，经邦须访渭川翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次严子陵濑 其四","author":"黄裳","text":"风节无人能用舍，尘凡何处问行藏。\n虹蜺已卷胸中气，只作天文一点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次严子陵濑 其五","author":"黄裳","text":"已外世情来独立，何劳物色去相寻。\n太官食好还多累，一线金鳞岂有心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张枢密西斋","author":"黄裳","text":"双梧尤惬雨中听，莫恨庭前古月明。\n簌簌西风吹又急，却疑攲枕得秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人闻角 其一","author":"黄裳","text":"胡笳羌笛此声同，一曲梅花万感浓。\n吹转满城蝴蝶梦，利名心动五更钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人闻角 其二","author":"黄裳","text":"一声寒角四更终，吹下云间细细风。\n孤馆几多人展转，半窗明月与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日有感 其一","author":"黄裳","text":"秋来犹寄一涯天，叶叶秋声似去年。\n可惜良辰长在客，不堪孤馆更闻蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日有感 其二","author":"黄裳","text":"几时能致买山钱，便好山中醉暮天。\n有物秋来长引梦，鲈鱼新到曲江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]