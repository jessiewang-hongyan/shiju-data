[{"title":"福胜院","author":"赵仲藏","text":"千骑踏清霜，东游古道场。\n云笼山骨秀，风引水声长。\n晓日依稀暖，寒花取次香。\n后随吹管急，空谷答宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山观雪 其一","author":"赵企","text":"莫谓湖山景，寻常总一般。\n欲穷清胜处，须向雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山观雪 其二","author":"赵企","text":"乘兴寻幽不怕寒，喜将山水雪中看。\n等闲哦出西湖句，自有清新上笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日泛西湖","author":"赵企","text":"湖光山色共争秋，一点尘埃无觅处。\n沉沉水底见青天，画舸直疑天上去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上竺真辩师","author":"赵企","text":"一别支公仅两年，山房高隐尚恬然。\n心清已澈灵泉奥，行峻应磨峭壁坚。\n俗眼不来青障里，孤峰谁认白云边。\n更期香火深寒夜，坐使飞花坠九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟晚出北关","author":"赵企","text":"舟泛寒塘静，人归一叶间。\n影疏行处柳，青远望中山。\n道在身从老，诗穷意觉闲。\n到家秋敛足，有谓掩柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿普圆寺二首 其二","author":"赵企","text":"仙巾鹤氅与云轻，晚出岩梯最上层。\n复复陇头归去雁，阴阴松下远来僧。\n风吹寒水光成叠，木落重峦碧有棱。\n行到湖边归兴尽，画桥临水与谁凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿普圆寺二首 其一","author":"赵企","text":"芒鞋侵晓踏青霜，九里松阴引兴长。\n云雾浅深山变态，风烟舒卷水晶光。\n千岩寒月笼疏薄，一笛西风度渺茫。\n短艇不来人意懒，谁知搔首正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萍","author":"赵企","text":"斑斑染黛色差匀，个个微圆类绿萍。\n不比榆钱铺砌白，未饶荷叶点溪青。\n陶镕尽出春工巧，磨就多应雨夜零。\n好与诗人买风月，何妨积贮满空庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题北山松轩","author":"赵企","text":"万木有荣谢，此松无盛衰。\n梦阑秋韵起，棋罢午阴移。\n般匠顾不顾，秦君知未知。\n亭亭高节在，看取雪霜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石桥","author":"赵企","text":"绀宇凌云接太和，萦回委曲过山阿。\n灵峰散彩祥光满，宝盏浮花景象多。\n瀑布迅从双涧落，禅徒争向一梁过。\n何当摆脱尘埃路，洗去人间万事磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题显孝南山寺","author":"赵企","text":"背日西来眼界明，隔溪遥见梵王城。\n旌旗夹道蔽山影，笳鼓入林闻谷声。\n青鸟向人疑有意，白云迎客不无情。\n夕阳临水共归去，明日纷纷尘事生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题兜率寺","author":"赵企","text":"一到巾山眼界宽，招提直在翠微间。\n黄鹂过处金穿柳，白鹭飞时雪点山。\n渔艇两三随月上，海帆八九趁潮还。\n归时听得梅花角，落日西城未掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别天台","author":"赵企","text":"携家隐青山，青山不我留。\n遣我出山去，再拜辞丹丘。\n王命急星火，驾言促西游。\n朝游白云城，暮宿黄花洲。\n佳人牵我衣，挽断不回头。\n路傍立樵叟，问我何所求。\n长安美少年，气概凌清秋。\n鸾台与凤阁，一一皆俊游。\n掉臂尔欲往，独不愧且羞。\n此言真吾药，口讷不易酬。\n我本麋鹿性，直与山林投。\n云何就冷局，岁月空悠悠。\n愿公看我还，长歌赋归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖晚归","author":"赵企","text":"日脚掩西山，四面烟光起。\n片月落湖心，照破琉璃髓。\n水面天光阔，孤烟暝不收。\n休瞻一钩月，挂起旅人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡冠花","author":"赵企","text":"秋光及物眼犹迷，著叶婆娑拟碧鸡。\n精采十分佯欲动，五更只欠一声啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题顺感院","author":"赵企","text":"一上危梯一解颜，重岗复岭四周环。\n山川尽出登临外，天地都归俯仰间。\n飞鸟直随双目断，游云长与片心閒。\n文书了却无馀事，日午须来日落还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"赵企","text":"闻道南丹风土美。\n流出溅溅五溪水。\n威仪尽识汉君臣，衣冠已变□番子。\n凯歌还、欢声载路，一曲春风里。\n不日万年觞，猺人北面朝天子。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感皇恩 别情","author":"赵企","text":"骑马踏红尘，长安重到。\n人面依前似花好。\n旧欢才展，又被新愁分了。\n未成云雨梦，巫山晓。\n千里断肠，关山古道。\n回首高城似天杳。\n满怀离恨，付与落花啼鸟。\n故人何处也，青春老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵企","text":"几夜已生蝴蝶梦，三年辜负鹧鸪班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"赵企","text":"青灯影冷棋三战，红火炉温酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"赵企","text":"四山来不断，一水去无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"赵企","text":"青镜不览一两日，白发又添三四茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵企","text":"愁从竹叶杯中去，老向菱花镜里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题倅厅吏隐堂","author":"赵众","text":"满耳江声满目山，此身疑不在人寰。\n民含古意村村静，吏束刑书日日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访刘汉英","author":"赵与缗","text":"无情岁月迅飞梭，却笑浮生虑更多。\n最羡君能寻旧业，半溪春雨一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探禹穴感怀","author":"赵与缗","text":"神禹宏疏凿，流传山海经。\n披览未为足，时骑李白鲸。\n是日轻飙起，翛然天籁鸣。\n孤峰带江浙，突兀地轴横。\n振衣履绝顶，盘踞雄殿亭。\n群峰百里外，拱护赖众星。\n乃信王气钟，根深奕叶生。\n厥后卧薪者，会稽栖复兴。\n此义久懵懵，寂寞羞山陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日诗","author":"赵匡胤","text":"欲出未出光辣达，千山万山如火发。\n须臾走向天上来，逐却残星赶却月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵匡胤","text":"未离海底千山黑，才到天中万国明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"当阳胜处","author":"赵夷夫","text":"当阳胜处好溪山，翠滴温公宝墨斑。\n线溜一泓凉意足，须臾肤寸遍人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祜公荣归","author":"赵存佐","text":"任重功馀屡乞辞，犯颜曾不避天威。\n朝回一体奎章下，携得天香满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送舒殿丞知荆州","author":"赵安仁","text":"建隼提封云梦泽，临民咫尺岘山碑。\n烟凝郊郭漳波净，翠绕楼台楚峤奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游白云山","author":"赵巩","text":"半生心事澹悠悠，应乐高卧白云稠。\n青山影里春酲解，黄雀声中午梦休。\n好景随处堪行乐，浮世何人免得愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烂柯山","author":"赵师圣","text":"姑蔑城南问烂柯，篮舆踏翠晚来过。\n岩前云拥杉松老，席上棋敲日月多。\n四序秋光浮澹荡，半空钟韵绕嵯峨。\n仙人去后馀残局，风雨山深长薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"向来","author":"赵师民","text":"向来情思已陈陈，旅思无端不及春。\n潘子形容伤白发，沈郎文字暗丹唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"赵师民","text":"委地露花啼晓恨，拂提烟柳弄春容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"赵师民","text":"霜女遗灵长著素，玉妃馀恨结成酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵师民","text":"菱天晨气润，槐夏午风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵师民","text":"露台枉惜千金费，却把铜山锡幸臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"赵师训","text":"庆元宰相事纷纷，说著令人暗断魂。\n好听当时刘弼语，分些官职乞平原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题严因崇报禅寺","author":"赵师龙","text":"寻幽访古到岩前，仰视云霞接梵天。\n六代兴王那复在，千身化佛尚依然。\n老松欲作苍龙去，怪石常如猛虎眠。\n已觉尘劳变清净，何当筑室向危巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺希瓐侄得男","author":"赵师吕","text":"天潢一派福流长，旅邸重闻夹乌香。\n海上蟠桃千古秀，月中仙桂万年芳。\n象贤应拟家声振，缮德还期国运长。\n端是吾宗能厚积，故生麟凤兆祯祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山路怀翁卷","author":"赵师秀","text":"困尝苦茗不论杯，天气才晴又有雷。\n寂寞小亭看草坐，晚风时复堕青梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中子山作","author":"赵师秀","text":"城郭经寒近佛生，偶来高顶作山行。\n竹房冷落无僧在，独倚阑干听晚莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北户","author":"赵师秀","text":"晓开北户得新晴，木末犹横一两星。\n满地绿苔看不见，细花如雪落冬青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉清夜归","author":"赵师秀","text":"岩有未有桂花开，观里闲寻道士来。\n微雨过时松路黑，野萤飞出照青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白石岩","author":"赵师秀","text":"谁炷清香礼少君，数声金磬梦中闻。\n起来闲把青衣袖，裹得栏干一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再过吴松","author":"赵师秀","text":"江边无处觅天随，又趁斜阳过渺瀰。\n远爱柳林霜后色，一如春至欲黄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上","author":"赵师秀","text":"朝来行药向秋池，池上秋深病不知。\n一树木犀供夜雨，清香移在菊花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约客","author":"赵师秀","text":"黄梅时节家家雨，青草池塘处处蛙。\n有约不来过夜半，闲敲棋子落灯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜鹃","author":"赵师秀","text":"三月江头花正开，啼教花片委青苔。\n若嫌此地非君土，今度归时莫要来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采药径","author":"赵师秀","text":"十载仙家采药心，春风过了得幽寻。\n如今纵有相逢处，不是桃花是绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿国清","author":"赵师秀","text":"残灯吹了闭禅关，风约孤萤落砌间。\n本为饮茶妨睡早，强寻诗句拟寒山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"数日","author":"赵师秀","text":"数日秋风欺病夫，尽吹黄叶下庭芜。\n林疏放得遥山出，又被云遮一半无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楼上","author":"赵师秀","text":"晓雨微微洒物华，牵牛初发傍墙花。\n数声野鹤无寻处，只在楼西有竹家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德安道中","author":"赵师秀","text":"峰头不住起云烟，野水纵横尽入田。\n定是人家蚕事末，道傍桑叶小如钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四圣观□道士诗卷","author":"赵师秀","text":"一观桃花红似锦，两堤杨柳绿于云。\n游人只是游晴昼，烟雨朝昏尽属君。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一真姑","author":"赵师秀","text":"忽然能不食，饮水度中年。\n此事知难伪，令人信有仙。\n形容无血色，衣服有香烟。\n听说瑶池路，犹如在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十里","author":"赵师秀","text":"乌纱巾上是黄尘，落日荒原更恐人。\n竹里怪禽啼似鬼，道傍枯木祭为神。\n亦知远役能添老，无柰高眠不救贫。\n此地到城惟十里，明朝难得自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万年寺","author":"赵师秀","text":"万年山木有千年，石路阴深到缭垣。\n几片云闲谁是主，一条流水不知源。\n土栽芍药尤胜木，僧说猕猴极畏猿。\n夜半空堂诸境寂，微闻钟梵亦成喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千日","author":"赵师秀","text":"千日方过半，何因便得还。\n就令凡事易，不及一身闲。\n种朮怜官地，登城忆自山。\n苦吟无爱者，写在户庭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大龙湫","author":"赵师秀","text":"一派落虚空，如何画得同。\n高风吹作雨，低日射成虹。\n西域书曾说，先朝路始通。\n或言龙已去，幽处别为宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大慈道","author":"赵师秀","text":"青苔生满路，人迹至应稀。\n小寺鸣钟晚，深林透日微。\n野花春后发，山鸟涧中飞。\n或有相逢者，多因采药归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小舟","author":"赵师秀","text":"小舟随处去，幽意日相亲。\n野草胜荷叶，轻鸥似逸人。\n闲思此湖水，曾洗几京尘。\n甚欲营渔屋，空虚未有因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平山读书寄城中诸友","author":"赵师秀","text":"野人无别事，故得坐空林。\n黄卷还铺日，青莲未悟心。\n铎音山殿静，萤影石池深。\n不敢邀芳屣，因闲傥一寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无言师还道院求诗","author":"赵师秀","text":"师已无言矣，今吾何所云。\n惟知佛照子，曾管雁山云。\n天下閒为宝，人间热似焚。\n筠州郡斋近，安坐过秋分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜怀徐照","author":"赵师秀","text":"月色一庭深，迢遥千里心。\n湘江连底见，秋客与谁吟。\n寒入吹城角，光凝宿竹禽。\n亦知同不寝，难得梦相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水际","author":"赵师秀","text":"水际移居晚，薰风绿满汀。\n密萍妨下钓，高柳碍观星。\n忙是僧相过，闲惟雨可听。\n寻思非久计，终忆自柴扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢申之载酒舟中分韵得明字","author":"赵师秀","text":"闲人闲处住，载酒荷高情。\n小舍宁容客，同舟却向城。\n弄花忘昼暑，忧谷念秋晴。\n归路虽无月，银河亦自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶侍郎送红芍药","author":"赵师秀","text":"雕栏迎夏发奇葩，不拟分来野客家。\n自洗铜瓶插攲侧，暂令书卷识奢华。\n旧游尚忆扬州梦，丽句难同谢脁誇。\n应被花嗔少风味，午窗相对一杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石门寺","author":"赵师秀","text":"寺外山皆石，门因凿石开。\n野花黄类菊，寒笋绿黏苔。\n官为看田至，僧方乞食回。\n一双檐际鸽，空觑出生台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石门僧","author":"赵师秀","text":"石门幽绝甚，独有一禅僧。\n寺废馀钟在，房高过客登。\n山蜂成苦蜜，崖溜结空冰。\n如此冬寒月，他人住岂能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示五峰僧","author":"赵师秀","text":"峰形如掌翠相环，头白山僧引客看。\n积叶坏来泥径滑，斜阳移去石桥寒。\n近闻瀑布寻还远，易得菖蒲采极难。\n分我一峰于此住，与师相聚愿辞官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]