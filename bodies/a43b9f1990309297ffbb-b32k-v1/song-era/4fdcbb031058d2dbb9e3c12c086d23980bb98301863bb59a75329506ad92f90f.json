[{"title":"瀑布诗","author":"米芾","text":"吾有瀑布诗，古今赛不得。\n最好是一条，界破青山色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尧山","author":"米芾","text":"信美此山高，穹窿远朝市。\n暑水结苍阴，飞泉落晴翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和严道培书院韵 其一","author":"米芾","text":"城头山脚旧图开，华构凌云亦壮哉。\n谈席昔人文献地，升堂此日豫章材。\n弦歌化里清风动，麟凤天南紫气来。\n独奈岩阿丛桂冷，幽栖不是伟长才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和严道培书院韵 其二","author":"米芾","text":"高馆搴帷万象开，西山翠入气佳哉。\n六经重振南方学，千里还徵上驾材。\n鸾鹤绕庭翔更集，云霞拂栋去还来。\n古今同被弦歌化，林卧其如老不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宝珠阁","author":"米芾","text":"对槛青山露，群仙捧宝珠。\n求遗如起定，象罔是文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虹县旧题二首 其一","author":"米芾","text":"快霁一天清洲气，健帆千里碧榆风。\n满船书画同明月，十日随风窈窕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虹县旧题二首 其二","author":"米芾","text":"碧榆绿柳旧游中，华发苍颜未退翁。\n天使残年司笔砚，圣知小学是家风。\n长安又到人徒老，吾道何时定复东。\n题柱扁舟真老矣，竟无事业奏肤公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋暑憩多景楼","author":"米芾","text":"纵目天容旷，披襟海共开。\n山光随眦到，云景渡江来。\n世界惭双足，生涯付一杯。\n横风多景梦，应似穆王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题董北苑画","author":"米芾","text":"千峰突兀插空立，万木萧疏拥涧阴。\n日暮草堂犹未掩，从知尘土远山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琴诗","author":"米芾","text":"澹乎无味中，指下清音发。\n□□□□□，空山堕凉月。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开先寺观瀑布","author":"米芾","text":"度挟扪青玉，临深坐绿苔。\n水从双剑下，山挟两龙来。\n春暖花惊雪，林空石迸雷。\n尘缨聊此濯，欲去首重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗二首 其二","author":"米芾","text":"携琴绕碧沙，摇苇弄青霞。\n杜若幽庭草，芙蓉曲沼花。\n宴游来野客，形胜得山家。\n往往留仙步，登攀日易斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其一","author":"米芾","text":"三闾宰国议，相如造承明。\n莫教朝廷上，不及为郡名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其二","author":"米芾","text":"几时越五湖，行行遂所适。\n之子方乐天，众累焉能迫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗三首 其三","author":"米芾","text":"閒中无所事，得意思同论。\n约月升崇观，校射出平原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大臣荐对诗","author":"米芾","text":"笏引上天梯，鞘鸣奋地雷。\n谁云天尺五，亲见玉皇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驱蝗虫诗","author":"米芾","text":"蝗虫本是天灾，不由人力挤排。\n若是敝邑遣去，却烦贵县发来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢吴安中留宿","author":"米芾","text":"肉眼通神四十年，侯门拖袖气如烟。\n符离经过无行李，西入皇都索相钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题开福院白莲堂 其一","author":"米芾","text":"二林消息已千年，戏向池中种白莲。\n昨夜秋香逐霜雪，又看莲子藕如船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题开福院白莲堂 其二","author":"米芾","text":"旧多社客谈因果，新向禅林问祖风。\n归去万缘无不了，这回洗钵听斋钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"干越亭","author":"米芾","text":"长卿骨已朽，延陵得兹亭。\n延平廖明略，大句题轩楹。\n遂令干越俗，擅此今古名。\n高咏刘廖句，白云穿石屏。\n琵琶洲无弦，我弹君能听。\n弹罢共一笑，白云归玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李伯时山阴图许元度王逸少谢安石支道林四像二首 其一","author":"米芾","text":"一幅轻绡三尺阔，百岁丹青半鹿脱。\n谁将光景写吴绫，神采森然动毫末。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李伯时山阴图许元度王逸少谢安石支道林四像二首 其二","author":"米芾","text":"临卷叹张芝，笔格入妙思。\n疏眉映朗目，白玉无泥滓。\n堂堂伟且长，想见坦腹姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙井延恩衍庆院","author":"米芾","text":"竹径随泉上，山云触石生。\n宝栖弹指处，的的是分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀南唐研山","author":"米芾","text":"研山不复见，哦诗徒叹息。\n唯有玉蟾蜍，向余频唳滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题越人王脩竹所藏雪窦禅师真迹","author":"米芾","text":"一幅昏昏半已空，何人重出自为工。\n从兹万偈并千颂，扰乱春风卒未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸡黍","author":"米芾","text":"鸡黍招要意已真，后堂许到转相亲。\n巧裁花竹岂多地，净扫轩窗无一尘。\n倾倒不知情话密，衰隤深畏酒行频。\n落花一夜成疏迹，风雨还增客恨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题马远作四皓弈棋图横卷","author":"米芾","text":"落落四皓翁，山林养其静。\n羞为汉家臣，若辟秦苛政。\n商颜高峨峨，坐待天下定。\n欻起佐储皇，上前启名姓。\n堪怜羽翼成，难将口舌争。\n无语及扶苏，空歌紫芝咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题定武本兰亭","author":"米友仁","text":"翰墨风流冠古今，鹅池谁不赏山阴。\n此书虽向昭陵朽，刻石犹能易万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题禅堂壁间","author":"米芾","text":"水石相搏，风竹相吞。\n炉烟方袅，草木自欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壮观亭","author":"米芾","text":"扶筇上瑶台，一笑领清绝。\n如何夜来风，独下前村雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仙掌石","author":"米芾","text":"碧海出蜃阁，青空起夏云。\n瑰奇□怪石，错落动乾文。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送端臣桂林先生兼简信叔老兄帅坐","author":"米芾","text":"骖鸾碧玉林，琢句白琼瑶。\n人间埃?尽，青罗数分毫。\n程老列仙长，磊落粹露臕。\n玉沥发太和，得君同逍遥。\n刻岩栖乌鸦，陟巘透紫霄。\n南风勿赋鵩，即是登云轺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题多景楼","author":"米芾","text":"华胥兜率梦曾游，天下江山第一楼。\n冉冉明廷万灵入，迢迢溟海六鳌愁。\n指分坱圠方舆露，顶矗昭回列纬浮。\n衲子来时多泛钵，汉星归未觉经牛。\n云移怒翼搏千里，气霁刚风御九秋。\n康乐平生追壮观，未知席上极沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴江舟中作","author":"米芾","text":"昨风起西北，万艘皆乘便。\n今风转而东，我舟十五纤。\n力乏更雇夫，百金尚嫌贱。\n船工怒斗语，夫坐视而怨。\n添槔亦复车，黄胶生口咽。\n河泥若祐夫，粘底更不转。\n添金工不怒，意满怨亦散。\n一曳如风车，叫啖如临战。\n傍观莺窦湖，渺渺无涯岸。\n一滴不可汲，况彼西江远。\n万事须乘时，汝来一何晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏东坡木石图","author":"米芾","text":"四十谁云是，三年不制衣。\n贫知世路险，老觉道心微。\n已是致身晚，何妨知我□。\n欣逢风雅伴，岁晏未言归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"米芾","text":"清明去郡则得郡，安用作业解洗业。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"米芾","text":"中间有一萧閒伯，学道登仙初应格。\n朝元明日拜五光，玉皇应怪须眉白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"米芾","text":"金山醉归江月出，瓜洲汹涌寒潮入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"米芾","text":"饭白云留子，茶甘露有兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"米芾","text":"人是西方无量佛，寿如南极老人星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"米芾","text":"手摩一丈石，读尽上元碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"米芾","text":"甘泉如惠泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"米芾","text":"孤屿水中圆，遥空海边阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"米芾","text":"如来髓，释迦骨。\n人不识，弥勒佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏古十六首 其十二","author":"华镇","text":"窫窳当九门，西山宝驺虞。\n鸱鸮集上林，丹穴巢鹓雏。\n奸雄始基搆，哲人晦良图。\n步兵偶叔末，整辔登蓬壶。\n身世委杯酒，不以礼法拘。\n长啸引鸣凤，新诗缀骊珠。\n慷慨临广武，感激恸穷途。\n所志岂方外，林下薄踟蹰。\n恢恢大雅人，矫矫真龙驹。\n宁愧苏门士，临刑据槁梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏古十六首 其十三","author":"华镇","text":"秋阳铄金石，康庄昼如焚。\n乘轩及负荷，累足朝市门。\n挥汗散凌雨，腾埃播长云。\n隋珠弹黄雀，贵贱谁复论。\n安知北窗下，乃有羲皇人。\n高卧挹清风，翛然远世纷。\n绿琴寂繁奏，白醅漉纶巾。\n井水患甘旨，膏兰困明芬。\n何用结庐地，喧填走车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏古十六首 其十四","author":"华镇","text":"唐昔先天后，天步复清平。\n君王图治定，槐棘来群英。\n渭水亦投竿，莘原犹弃耕。\n丈夫敦志尚，不为轩冕轻。\n矫矫同州守，素风独峥嵘。\n慷慨论十事，激切观王明。\n献纳无迕言，始来歆大烹。\n富贵岂不念，直道思有行。\n驭者信所学，不为嬖奚更。\n况当秉国钧，见利难自倾。\n行己或可枉，乘轩何所荣。\n风虎既相从，云雷底光亨。\n开元及贞观，当日乃悬衡。\n至今夸毗人，闻风心骨惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏古十六首 其十五","author":"华镇","text":"高柳何葱茜，袅袅章台端。\n眉叶荫紫极，条丝拂朱栏。\n何以谢松竹，挠弱惭岁寒。\n既乏贞固姿，枝叶何足观。\n小人殉利欲，俛仰如转丸。\n苟非社稷臣，祸患宁肯干。\n蒲山已归觐，黎阳尚盘桓。\n当时方寸地，明明赤如丹。\n飙举冠凌烟，腾芳臭如兰。\n一言失其所，功名两彫残。\n高帝论平阳，刘氏终以安。\n英公负文皇，武氏为世患。\n无忌问赵相，侯嬴起长叹。\n白首不可保，知人良独难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏古十六首 其十六","author":"华镇","text":"兰芷生幽薄，浥露搴华姿。\n芙容隔秋江，扁舟满江湄。\n丈夫抱材用，但愿君王知。\n宁生击牛角，载歌南山词。\n词终脱裋褐，缨佩暮萎蕤。\n人事非有定，斯言或难持。\n翩翩李将军，鸣弦压由基。\n馀威震戎虏，谈笑静边陲。\n桃李曾无言，嘉声满黄扉。\n心知堪万户，乃谓生匪时。\n烽火照甘泉，未能包虎皮。\n目视汉飞将，弃弃轻如遗。\n颇牧已黄土，忉忉勤缅思。\n如何中林士，坐视青云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古风","author":"华镇","text":"瞻彼南山下，沟塍蔚相续。\n泉流既清美，土壤膏且沃。\n岩壑云气多，时雨常沾足。\n苦乏知人术，所寄非良淑。\n树艺本未工，营私一何速。\n铫耨不及时，终然废穜稑。\n尝恐岁云暮，蟋蟀鸣我屋。\n良苗不可见，何以望嘉谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读孟东野懊恼诗","author":"华镇","text":"东野不解事，强为懊恼词。\n恶诗皆得官，举世不及嗤。\n好诗空抱山，寂寞无人知。\n诗自有好恶，得官不在诗。\n白面无伎能，青云多路歧。\n君无一囊钱，姻娅复为谁。\n且保圭玉质，无使伤磷缁。\n文章古所贵，恐非涉世资。\n羽翼圣道术，收拾古佚遗。\n此外不可倚，倚文谅多奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小院","author":"华镇","text":"小院无经过，虚庭窈深幽。\n高堂昼晴永，朱箔上银钩。\n文砌桐花落，碧瓦烟光流。\n交疏静丹绮，飞梁架青虬。\n流莺自睍睆，好音暂迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早发芜湖风便舟中有感","author":"华镇","text":"长波西南骛，高风激江流。\n挂席向浦溆，凌虚驾轻舟。\n洲渚乱挥霍，蒹葭飒飕飗。\n重山捷飞过，叠浪纷悠悠。\n凫鹜不及辨，频咤越飞鸥。\n舟人击鼓吹，谑浪相赓酬。\n调笑西来人，掩泪寒沙头。\n人闻此语乐，我闻此言忧。\n尔速非尔巧，彼淹岂其尤。\n淹速偶所值，矜笑徒自偷。\n况余涉世途，泰稀否常稠。\n此日虽偶驶，来日恐或不。\n驭也傥可矜，留滞还增羞。\n天道雅无常，非分非所求。\n但愿日日行，行路无阻修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汎舟","author":"华镇","text":"汎舟涉长川，舟巨川且广。\n操榜无良师，东西逐波荡。\n左之蕉苇多，右之洲渚枉。\n中有安流道，可以诣所往。\n不习昧其从，终日劳荡桨。\n荡桨劳尚可，所忧波涛长。\n黑云蔽白日，惊飙摧五两。\n沈浮何足道，形生在反掌。\n岂无觞深人，疏绝不得赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题竹轩诗","author":"华镇","text":"岁寒青松青，落落惟修竹。\n烟叶舒青翠，风茎戛苍玉。\n高标契嘉士，暂挹情已足。\n况复清阴中，耽耽有华屋。\n屋下富经史，埙篪韵方睦。\n啄食日已肥，文綵更繁缛。\n侧聆箫韶奏，联翩赴清曲。\n秋色正萧疏，庭宇清以肃。\n且复绕修林，采采黄金菊。\n莫学山阳客，颠倒困醽醁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别新渭府机宜蔡二同年","author":"华镇","text":"贾生流落处，寒日照山郭。\n江湖行欲尽，客意正寂寞。\n毂击逢蔡侯，旧交宛不若。\n立谈露底里，贞意销垠堮。\n握手笑登舟，杯盘已纷错。\n初言叙交契，次问何漂泊。\n苦道行路长，舂陵亦硗埆。\n仲冬才薄寒，秋水虽已落。\n湘山尚重叠，湘水亦浩漠。\n水深莫暮止，路远宜晨作。\n委曲话津途，纤悉指栖托。\n前修共科名，分义曾不薄。\n此道久沦替，后生多落寞。\n颂君古人风，不为一杯酌。\n我舟尚南迈，君马方西跃。\n各指天一涯，何以慰离索。\n平凉古名镇，扼控开戎幕。\n绿发照青衫，从容预经略。\n从军古所贵，清世尤多乐。\n已见六翮修，行看上辽廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿道林寺诗","author":"华镇","text":"钲鼓远轰填，旌旗近凌乱。\n兰棹截波舣，肩舆傍山转。\n白羽映尘举，乌纱倚风岸。\n揆才非阿都，托乘陪中散。\n暝投萧寺迥，路入修林茜。\n清谈曾未既，长夜已踰半。\n周旋仰陂量，眄睐惭沟断。\n欲倚青云披，轻歌白石烂。\n高风生夜壑，长松响幽涧。\n秉烛访陈迹，辞墨叠壮观。\n缨蕤虽未濯，心目欣已浣。\n文奇楚招些，迹异元郎漫。\n初惊冰玉违，已见珠玑璨。\n临池名草圣，天台得才冠。\n兼资古所稀，荐遇世尤愿。\n琳琅鼓馀韵，蛟虬走芳翰。\n诣绝雅无伦，神变敏如幻。\n规为到古始，气槩起消懦。\n须知赵璧贵，祗借秦人玩。\n吟想情有馀，言终屡增叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汲水诗","author":"华镇","text":"汲水苦绠短，低回就清浅。\n绠短傥有续，重渊良不远。\n清浅本无源，其涸易见睍。\n重渊酌愈出，流波被沟畎。\n膏肓苟愿治，会须好俞扁。\n所之在万里，庸可策驽蹇。\n白茅满原隰，刈之何不勉。\n缉索绠乃长，单极恣舒卷。\n寄声汲引者，功微利亦鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚室","author":"华镇","text":"轩前列群山，轩后得虚室。\n宛若成都居，枵然惟四壁。\n清明照窗牖，不待秋月色。\n万籁悄无声，终年饱岑寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颐轩诗","author":"华镇","text":"土木谢雕华，结构趣闲敞。\n四座来风月，中庭容几杖。\n庭喧海潮至，窗暝山云上。\n萧散寄官曹，欣兹会清赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝墨堂","author":"华镇","text":"堂有颜公石，辞墨真世宝。\n圆润屈银钩，淳华掞春藻。\n忠义昔所服，文艺久弥好。\n至今有识人，抚卷惜元老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广述二首 其一","author":"华镇","text":"茫茫太行道，日侧啸彫虎。\n天明落槛阱，迥失山林阻。\n摇尾仰视人，意态已如鼠。\n乌鹊竟何为，俛咮噪而聚。\n高明人共畏，鳏寡世所侮。\n丈夫气如霜，所贵摧强禦。\n埋轮斥豺狼，不待梁冀死。\n长孺戒李息，张汤方遇主。\n古人耻低徊，吐茹两不武。\n真节一朝奋，千载羞莽卤。\n兹人不可见，兹事乃近古。\n三复清风诗，永怀仲山甫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广述二首 其二","author":"华镇","text":"飘风入阊阖，九陌起黄埃。\n馺遝振鸣珂，驰驱东西来。\n侧足凑高明，珠箔为褰开。\n附会崇岳友，沮誉牛李侪。\n倾侧竞姿媚，谈笑足诙谐。\n朝为道旁客，暮为廊庙才。\n如何首阳人，怅望黄金台。\n所得竟斗筲，回首良可哀。\n安见郑子真，谷口日徘徊。\n嘉声满朝野，何用苦自媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]