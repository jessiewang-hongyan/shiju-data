[{"title":"咏南山诸胜 龙井","author":"杨杰","text":"崖下一泓泉，窈奥不可测。\n有时灵气生，散作人间泽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 归隐桥","author":"杨杰","text":"道人从此归，影不入廛市。\n端坐笑浮云，往来太多事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 涤心沼","author":"杨杰","text":"纵有狂风生，未尝险浪起。\n何当招世人，来此鉴清泚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 狮子峰","author":"杨杰","text":"岩风壮威猛，晴雷隐哮吼。\n无心露爪牙，百兽自奔走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 萨埵石","author":"杨杰","text":"解虎锡常闲，饲虎石常在。\n亡躯度有情，清风几千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 潮音堂","author":"杨杰","text":"潮来音普闻，潮平音亦歇。\n孰若此山堂，潮音未尝绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 讷斋","author":"杨杰","text":"天道竟何言，四序自流转。\n乃知毗耶翁，虽默真大辨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 冲泉","author":"杨杰","text":"不汲泉不盈，愈汲泉愈清。\n湛然有常德，随气利群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 寂室","author":"杨杰","text":"白云隔尘喧，虚堂太岑寂。\n寒尽春自来，莺啼报消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 照阁","author":"杨杰","text":"幽人无适莫，乘兴登高阁。\n夜月锁云林，春花绣岩壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 闲堂","author":"杨杰","text":"赵公归休年，访师翠微间。\n始知浮世上，白日两人闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 方圆庵","author":"杨杰","text":"地方不中矩，天圆不中规。\n方圆庵里叟，高趣有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游大涤山","author":"杨杰","text":"大涤洞天玉为室，真官典校长生籍。\n青山九锁閟仙源，老尽碧桃人不识。\n祖龙求仙徒用力，驾海欲驱山下石。\n神人倚柱不与行，留得岩前隐山迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉晨观左纽桧","author":"杨杰","text":"华阳山里千株桧，玉晨观前一左纽。\n虬枝龙干向朝曦，势与扶桑斗长久。\n亳州涡水太清宫，老子手植才数九。\n一桧正与此树同，蒂固根深应不朽。\n信知福地有灵木，栽种曾经上真手。\n君不见龙从火里出，虎向水中生，生理尚左不尚右。\n又不见天轮左旋不休止，日月五星如磨蚁。\n左纽桧，蕴至理，上士体之能不死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滴滴泉","author":"杨杰","text":"岩谷连天岭，杉松彻象山。\n路从云外入，人自海边还。\n禅榻红尘断，经窗白昼闲。\n玉莲生有处，香满翠微间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台三贤堂 丰干","author":"杨杰","text":"从来清净土，鼎足圣贤聚。\n骑虎归故乡，世人犹未悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台三贤堂 寒山","author":"杨杰","text":"家住天台寺，云岩万丈潭。\n本来人不识，饶舌是丰干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台三贤堂 拾得","author":"杨杰","text":"拾得元无姓，山前拾得来。\n常携一敝帚，不是扫尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙莲阁","author":"杨杰","text":"天台有新阁，胜地近塔庙。\n影浸碧琉璃，沿洄去山峤。\n莲生污泥中，白日有明窍。\n花实相表里，光色互炳曜。\n处空不染水，烈火岂其燎。\n宝藏诸如来，端坐满法要。\n青目付上士，不待举花笑。\n芳香初洞达，宿病已能疗。\n净土记珍色，机感愿力召。\n三时有开发，一本常寂照。\n不读智者书，岂知此莲妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琉璃轩","author":"杨杰","text":"西轩一泓水，瑩净碧琉璃。\n天人举目视，中有鱼龙知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞竹悟老种莲","author":"杨杰","text":"东林闻说好林泉，社会荒凉几百年。\n灵物孰知崔氏竹，方池新种远公莲。\n华严顿净三千界，庐阜重招十八贤。\n应笑陶潜又归去，白云幽鸟伴归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅月真堂","author":"杨杰","text":"童子依师兰水滨，声名真是碧云人。\n定中传得阿罗汉，十六身中第几身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弘忍像赞","author":"杨杰","text":"人孰无父，祖独有母。\n其母为谁，周氏季女。\n浊港滔滔入大江，门前依旧长安路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子陵钓台","author":"杨杰","text":"高风谁得似先生，七里溪山当画屏。\n功业不随东汉祖，光芒独应少微星。\n兰台有史传名姓，蓬户无人问醉醒。\n若使当时忘故态，何由千古羡鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方干故居","author":"杨杰","text":"千载富春渚，先生家独存。\n元英播寰宇，丹桂付儿孙。\n文正重高节，子陵同享尊。\n泊舟明月夜，重为吊吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题白云环翠亭","author":"杨杰","text":"龟甲屏风面面开，天台连接至蓬莱。\n檐前朝暮碧云合，时有一声清磬来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天台邦师","author":"杨杰","text":"天台邦公，善琴与诗，时称僧之雄。\n琴尽古意，诗得古风。\n自云天圣景祐中，踪迹犹飘蓬。\n大淮南北，长江西东。\n人之奇者必就见，景之胜者多游从。\n尔来五六载，不与当时同。\n发白体且瘦，所适多疏慵。\n却担一枝筇，归老天台峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞世偈","author":"杨杰","text":"无一可恋，无一可舍。\n太虚空中，之乎者也。\n将错就错，西方极乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"杨杰","text":"男大须婚，女长须嫁。\n讨甚闲工夫，更说无生话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"物华楼","author":"杨杰","text":"章郡物华楼上景，江湖城阁画图间。\n神仙已古遗踪在，牛斗从今胜气还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云堂院","author":"杨杰","text":"罗汉十六轴，江僧寄此山。\n画称天下绝，人自定中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金尺石","author":"杨杰","text":"丹砂画顽石，黄金横一尺。\n人世较短长，仙家爱平直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陶靖节祠","author":"杨杰","text":"涛阳欲归田，彭泽先解绶。\n有琴何必弦，无诗不可酒。\n秋黄篱下菊，春绿门前柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云山","author":"杨杰","text":"白云随师来，师逐白云止。\n山空师何在，木末白云起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净居寺","author":"杨杰","text":"达人到岸不须船，留寄寒云几百年。\n欲问上方多少远，为言先过净居天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题慧山寺","author":"杨杰","text":"闻说支公最好贤，瀛洲可买不论钱。\n楼台蔽日都无地，草木藏春别有天。\n石上雪飞千峡雨，洞山泉落几家田。\n高闲谁似幽居乐，一坐青山不问年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张公洞","author":"杨杰","text":"庆历初还自霅川，曾携琴酒访真仙。\n洞天不隔三千界，俗驾重来四十年。\n羽宝结成钟乳石，朱藤蒙罩画溪船。\n樵夫不识赜山叟，欲与何人讲易篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠钱氏孙端静师","author":"杨杰","text":"凤皇锵锵出丹山，览辉金阙振羽翰。\n箫韶九奏动天地，苑囿何处无琅玕。\n故山惟有千年鹤，海上芝田随饮啄。\n朝市纷华了不知，逍遥常在云林阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自海上来留题","author":"杨杰","text":"佛日山前水，行人甘露杯。\n须知源派远，直自四明来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖参寥山房","author":"杨杰","text":"我爱参寥一味闲，岩房占得画屏间。\n斫开东庑数枝竹，放入西湖千里山。\n石底酌泉清彻骨，门前逢客强为颜。\n白云幽鸟应相信，出本无心倦即还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨花台","author":"杨杰","text":"空书来震旦，康乐造渊微。\n贝叶深山译，曼花半夜飞。\n香清虽透笔，蕊散不沾衣。\n旧社白莲老，远公应望归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清凉广惠禅寺","author":"杨杰","text":"君勿爱清凉，清凉如火如沸汤。\n君勿恶炎热，炎热如冰如积雪。\n勿爱亦可恶，未是逍遥处。\n君不见海会山前一条路，一车来，一车去，今古转辕何日住。\n落花时节雨初晴，黄莺枝上分明语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长干圣感塔","author":"杨杰","text":"释迦八万四千塔，一在江南古道场。\n无碍展开青髻发，最初分得白毫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱氏天和堂 其一","author":"杨杰","text":"闻说隐君子，天和长自如。\n卮言庄叟意，谷水士衡居。\n穷达命已定，利名心顿疏。\n绣溪归未得，吾亦爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陶威公庙","author":"杨杰","text":"四海生灵困，柴桑牧札瘥。\n奸臣窥社稷，盟主奋干戈。\n百甓防休逸，分阴贵切磋。\n升天九重逼，破贼一亟多。\n贪吏羞移柳，游民愧盗禾。\n母贤移训诲，友益愿渐磨。\n鹤化丧家客，龙飞古壁梭。\n南州浸馀泽，东晋决颓波。\n诫重樗蒲戏，声腾仕女歌。\n中原力难致，白首泪滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"休老堂铭","author":"杨杰","text":"妙高峰顶，不住正处。\n毗耶离城，别闻一路。\n铁钵铜瓶，葛巾草履。\n付者不取，取者不付。\n谷有归云，木凝甘露。\n师子嚬伸，象王回顾。\n门外老胡，一苇横度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宝洞 其一","author":"杨杰","text":"层梯险峻出瑶台，游者多从半路回。\n天宝洞中如不到，西山元似不曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宝洞 其二","author":"杨杰","text":"极玄真人养真处，石门隔断红尘路。\n玉帘今古不曾收，只有白云晚归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙居剑履","author":"杨杰","text":"云雷峰百寻，硖石潭千尺。\n尘埃飞不到，山水相照碧。\n右顾唐相碑，下有天师宅。\n古人安在哉，剑履空遗迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望仙曲","author":"杨杰","text":"麻姑王蔡迹已往，望仙亭在孤峰上。\n朝见五云飞，暮见五云归。\n云飞云归自今古，仙来仙去谁可知。\n勿望仙，望仙目眩徒茫然。\n白石可煮谁能言，不爱插翼冲青天。\n玉池且酌太和酒，一醉寿同天地久。\n陶陶与物任浮沉，肯顾霞衣云组绶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝真步虚词","author":"杨杰","text":"珠佩珊珊路绝尘，凤凰山上夕朝真。\n甘棠美政行南国，列宿寒光拱北辰。\n篆冷金盘云屋晓，书飞玉阙洞天春。\n一声辽鹤归传报，寿益君王福在民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆寂庵铭","author":"杨杰","text":"万法一源，万念一息。\n法无不圆，念无不寂。\n强名而名，车尘马迹。\n是庵何如，风清月白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻源","author":"杨杰","text":"晓登丹霞峰，暮入仙都宿。\n麻姑胜游遍，驱车第三谷。\n落落千岁杉，干直枝不曲。\n根本托幽邃，匠师岂易斸。\n佗山石枯裂，斯□瑩青玉。\n乃知灵源深，馀液泽林麓。\n白云起西冈，华仙有遗躅。\n阴功影响绝，为阅飞升窟。\n长笑呼幽人，玉乳金鼎熟。\n岁时不须问，山花自红绿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五老峰","author":"杨杰","text":"乾坤重年德，五老固苍颜。\n亿万的间寿，二三云外山。\n天高汉星聚，世治舜臣闲。\n应笑游河客，悠悠去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄禅寺","author":"杨杰","text":"祖师平昔拨云开，一榻灵秋一石台。\n青玉成围千嶂合，黑龙分势五溪来。\n禅心不动澄潭月，俗耳常惊静夜雷。\n却笑兴公游未到，祇将佳句赋天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杨杰","text":"千古伏龙山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杨杰","text":"借取云山为帐幕，合教僧屋断尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"杨杰","text":"更在朱栏绿水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"杨杰","text":"山横大秀一峰高，水入平湖千里远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"杨杰","text":"儒释精通内外全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"杨杰","text":"偃月仙翁羽化初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"季子庙","author":"曹确","text":"人间不记吴王事，江上今存季子宫。\n坏壁乱飘青藓雨，破檐时荡白榆风。\n衣冠何处埋春草，鸡酒长年任野翁。\n下马一看思旧德，浮名应与暮云空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题眉岭方池","author":"曹确","text":"西蜀峨嵋谁为移，灵根元窍凿何时。\n烟霞欲暮胭脂冷，云雨初收青黛施。\n天净尘霾开古镜，晓寒星斗落残棋。\n江湖襟带全形胜，风动于今民物熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云楼","author":"程之才","text":"鬻熊城郭绕苍苔，万叠烟岚亦壮哉。\n平地窥觎心未惬，重楼徙倚眼初开。\n据襟风月争新入，刮目江山破迥来。\n日落三峨知处所，云浮双阙欲崔嵬。\n胡床不愧庾公兴，奕簟还思杜老才。\n更待携衾尽清景，夜深栏槛逼昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧落洞","author":"程之才","text":"名因物之累，物尝不厌名。\n标之曰到难，日有车马声。\n苍崖匪才凿，洞室百步宏。\n潜龙想鳞鬣，石乳悬旒缨。\n溪流湛其中，吞吐日月精。\n其源咫尺耳，盥濯未尝经。\n我来先振衣，色变水石清。\n倚杖聊四顾，高低古今铭。\n颇恨辙迹多，不益云萝情。\n西南有复岭，烟霞昼晦冥。\n呼僧指问之，山外或小平。\n茅茨构石壁，兔鹿浑微生。\n沈吟幽栖地，雅兴宿志并。\n何时一椽屋，散发入岩坰。\n脱略五千言，坐忘六尺形。\n看云会所适，以此休馀龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次东坡碧落洞韵","author":"程之才","text":"粤从度岭来，日见乱山横。\n触目皆荒凉，宁复乐事并。\n谁谓乱山间，仙境通玉京。\n奇怪如雁荡，清虚胜赤城。\n嵌空幽且深，层曲无攲倾。\n巨礿万仞高，天造妙难明。\n悬崖攒滴乳，涧水清濯缨。\n我来洞门开，山意如相迎。\n熟视石壁字，神清喜勿惊。\n回思紫阳山，追随许宣平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"苏氏","text":"乡人嫁娶重母党，虽我不肯将安云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉轩","author":"李古","text":"古国遮雷首，幽轩拥县堂。\n何须犀避暑，不待草迎凉。\n潇洒松筠地，清虚水石乡。\n牛刀无所用，高枕傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题广胜寺","author":"李曼","text":"寺隐藏山腹，山高绝杳冥。\n浓岚春发黛，岑塔晓开屏。\n岭上云无著，松根茯有灵。\n访求忠武迹，不复见丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李曼","text":"崖深经夏不融雪，江阔架筒难入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蟠龙山","author":"李时亮","text":"独卧粤南天尽头，吞吐清气压林丘。\n风云上下三千丈，雾雨西南十六州。\n古涧有泉穿石冷，阴崖无暑满山秋。\n我来结构山亭下，时复凭栏看未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞云山","author":"李时亮","text":"曳曳溶溶绕翠微，朝朝暮暮满山飞。\n于今待汝为霖雨，莫向山中变白衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]