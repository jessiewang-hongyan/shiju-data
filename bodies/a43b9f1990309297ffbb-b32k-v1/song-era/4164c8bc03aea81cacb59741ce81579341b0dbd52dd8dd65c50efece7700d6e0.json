[{"title":"次韵分司南京李诚之待制求酒二首 其一","author":"苏辙","text":"世上升沉都梦里，春来强健斗樽前。\n公田种秫全抛却，坐客无毡谁与钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送施历城辩归常州","author":"苏辙","text":"高人不受尘土侵，三年浙江藏何深。\n久闲物理有相复，历城官事森成林。\n乘时敛散逐十二，鞭挞逋负徒哀矜。\n一杯相属未尝得，百亩归去将安能。\n潜逃虽出知者后，黾勉尚见仁人心。\n归期忽告三月尾，强留不顾千黄金。\n河豚虽过鲈鳜在，粳稻正插风雨淫。\n酒肴劳苦罄邻里，期会迫隘思僚朋。\n山川吴越我所爱，扁舟佗日要追寻。\n滞留未用便相诧，半年岁月行骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻玉盘盂二首 其二","author":"苏辙","text":"故相林亭父老知，出群草木尚何疑。\n无多产业残花药，几许功名旧鼎彝。\n丰艳不知人世别，佳名新换使君诗。\n明年会看花尤好，剥尽浮苞养一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题密州新作快哉亭二首 其二","author":"苏辙","text":"槛前潍水去沄沄，洲渚苍茫烟柳匀。\n万里忽惊非故国，一樽聊复对行人。\n谢安未厌频携妓，汲黯犹须卧理民。\n试问沙囊无处所，于今信怯定非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其二","author":"苏辙","text":"舜井溢流陌上，历山近在城头。\n羁旅三年忘去，故园何日归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其三","author":"苏辙","text":"野步西湖绿缛，晴登北渚烟绵。\n蒲莲自可供腹，鱼蟹何尝要钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其四","author":"苏辙","text":"饮酒方桥夜月，钓鱼画舫秋风。\n冉冉荷香不断，悠悠水面无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其五","author":"苏辙","text":"雨过山光欲溜，寒来水气如烝。\n胜处何须吴越，随方亦有游朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其六","author":"苏辙","text":"扬雄执戟虽久，陶令归田未能。\n眼看云山无奈，神伤簿领相仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其七","author":"苏辙","text":"终岁常亲鞭扑，此生知负诗书。\n欲寻旧学无处，时有故人起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其八","author":"苏辙","text":"故人远在江汉，万里时寄声音。\n闻道禅心寂寞，未废诗人苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其九","author":"苏辙","text":"佳句近参风雅，微词间发离骚。\n窃欲比君庾信，莫年诗赋尤高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答文与可以六言诗相示因道济南事作十首 其十","author":"苏辙","text":"相思欲见无路，满秩西归有时。\n及君铃阁少事，饮我松醪满卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李公择以惠泉答章子厚新茶二首 其二","author":"苏辙","text":"新诗态度霭春云，肯把篇章妄与人。\n性似好茶常自养，交如泉水久弥亲。\n睡浓正想罗声发，食饱尤便粥面匀。\n底处翰林长外补，明年谁送霅溪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李公朝著作见赠二首 其二","author":"苏辙","text":"稽古终何力，扶衰谩有方。\n故人怜困踬，佳句赠辉光。\n未暇抽身去，安能插翅翔。\n空存疏懒性，高卧笑羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠穆吕公挽词二首 其二","author":"苏辙","text":"风俗非平昔，贤豪弃此时。\n新阡长宿草，行路拜丰碑。\n惠术遐方记，嘉猷信史知。\n悲凉哭坟客，不为受恩私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中会孙洙舍人饮王氏西堂戏成三绝 其二","author":"苏辙","text":"南国高人真巨源，华堂邂逅接清樽。\n十年一见都如梦，莫怪终宵语笑喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中会孙洙舍人饮王氏西堂戏成三绝 其三","author":"苏辙","text":"倾尽香醪雪亦晴，东斋醉卧已三更。\n佳人不惯生疏客，不尽清歌宛转声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵景仁正月十二日访吴缜寺丞二绝 其二","author":"苏辙","text":"浊醪时饮十分杯，万象溟濛晓气皑。\n醉倒篮舆夜归去，金吾宁复识谁哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵邦直见答二首 其二","author":"苏辙","text":"五斗尘劳尚足留，闭门聊欲治幽忧。\n羞为毛遂囊中颖，未许朱云地下游。\n无事会须成好饮，思归时亦赋登楼。\n羡君幕府如僧舍，日向城隅看浴鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂兴二首 其二","author":"苏辙","text":"朱轮华盖事远游，厩无良马乘疲牛。\n青丝玉勒金络头，任重道远旁人忧。\n奔驰往来历山丘，腾坑投淖摧辕辀。\n已压复起行未休，青刍黄粱为君羞。\n长路漫漫经九州，场有白驹胡不收。\n饥食玉山饮河流，朝秣幽冀莫炎陬。\n奔云掣电不少留，仆夫顾之心怀愁。\n王良不生谁与谋，哀哉骏骨千金酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中会饮李倅钧东轩三绝 其二","author":"苏辙","text":"雪花如掌堕阶除，剧饮时看卧酒壶。\n半夜琼瑶深没膝，欲归迷路肯留无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中会饮李倅钧东轩三绝 其三","author":"苏辙","text":"竹里茅庵雪覆檐，炉香蔼蔼著蒲帘。\n欲求初祖安心法，笑我醺然已半酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王巩上元见寄三首 其二","author":"苏辙","text":"繁灯厌倦作闲游，行到僧居院院留。\n月影随人深有意，车音争陌去如流。\n酒消凿落宁论斗，鱼照琉璃定几头。\n过眼繁华真一梦，终宵寂寞未应愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王巩上元见寄三首 其三","author":"苏辙","text":"灯火熏天处处同，暗游应避柏台骢。\n高情自放喧阗外，胜事偏多淡泊中。\n平日交游徒梦想，留都歌吹忆年丰。\n知君未有南来意，归去相从光与鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食游南湖三首 其二","author":"苏辙","text":"绕郭春水满，被堤新柳黄。\n官池无禁约，野艇得飞扬。\n浪泛歌声远，花浮酒气香。\n晚风归棹急，细雨湿红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食游南湖三首 其三","author":"苏辙","text":"携手临池路，时逢卖酒垆。\n柳斜低系缆，草绿荐倾壶。\n波荡春心起，风吹酒力无。\n冠裳强包裹，半醉遣谁扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上见卖芍药戏赠张厚之二绝 其二","author":"苏辙","text":"春来便有南园约，过尽春风约尚赊。\n绿叶成阴花结子，便须携客到君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答见和 其二","author":"苏辙","text":"尘编何用朝朝看，新酿还须处处赊。\n好事若能频载酒，不妨时复到杨家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送龚鼎臣谏议移守青州二首 其二","author":"苏辙","text":"面山负海古诸侯，信美东方第一州。\n胜势未容秦地险，奇花仅比雒城优。\n新丝出盎冬裘具，贡枣登场岁事休。\n铃阁虚闲官酿熟，应容将佐得遨游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋祀高禖二绝 其二","author":"苏辙","text":"乾德年中初一新，颓垣破瓦委荆榛。\n兴亡举坠干戈际，閒暇方知国有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵南湖清饮二首 其二","author":"苏辙","text":"坐客经年半已非，喜君重到暂相依。\n不嫌爱酒樽频倒，只怕题诗纸屡飞。\n耿耿幽怀谁与诉，徐徐细酌未应违。\n从今更肯相过否，几误风吹白版扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张安道生日二首 其二","author":"苏辙","text":"十载从公鬓似蓬，羡公英气老犹充。\n生时别得星辰力，晚岁仍加鼎灶功。\n世事不堪开眼看，劳生渐恐转头空。\n问公试觅刀圭药，岁岁称觞此日中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵顿起考试徐沂举人见寄二首 其二","author":"苏辙","text":"老年从事忝南京，海内交游尚记名。\n怯见广场心力破，厌看细字眼花生。\n新科未暇通三尺，旧曲惟知有六茎。\n空忆倚楼秋雨霁，与君看遍洛阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻过淮见寄兼简孙奕职方三首 其二","author":"苏辙","text":"龟山昔同到，松竹故依然。\n红印封咸豉，黄罂分井泉。\n青天携杖处，晚日落帆偏。\n无限相思意，新诗句句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻过淮见寄兼简孙奕职方三首 其三","author":"苏辙","text":"行役饶新喜，临川逢故人。\n相看对泉石，怜我在埃尘。\n会合终多故，分张类有神。\n南游得如愿，梦想霅溪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻自徐移湖将过宋都途中见寄五首 其三","author":"苏辙","text":"千金筑黄楼，落成费百金。\n谁言史君侈，聊慰楚人心。\n高秋吐明月，白璧悬青岑。\n晃荡河汉高，恍悢窗户深。\n邀我三日饮，不去如笼禽。\n史君今吴越，虽往将谁寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻自徐移湖将过宋都途中见寄五首 其四","author":"苏辙","text":"欲买尔家田，归种三顷稻。\n因营山前宅，遂作泗滨老。\n奇穷少成事，饱暖未应早。\n愿输橐中装，田家近无报。\n平生百不遂，今夕一笑倒。\n它年数亩宫，悬知迫枯槁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻自徐移湖将过宋都途中见寄五首 其五","author":"苏辙","text":"梁园久芜没，何以奉君游。\n故城已耕稼，台观皆荒丘。\n池塘尘漠漠，雁鹜空迟留。\n俗衰宾客尽，不见枚与邹。\n轻舟舍我南，吴越多清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴思道道人归吴兴二绝 其二","author":"苏辙","text":"遨游海上冀逢人，宴坐山中长闭门。\n去住只今谁定是，相逢一笑各无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放闸二首 其二","author":"苏辙","text":"闸空非有碍，水静为谁兴。\n开闭偶然异，喧豗自不胜。\n渊停初镜净，势转忽云崩。\n脱隘尚容与，投深益沸腾。\n玉山纷破碎，陈马急侵陵。\n挟版千钧重，浮舟万斛升。\n岸摇将落木，鱼困或投罾。\n汹涌曾谁止，萧条远欲凝。\n力争知必折，少待亦何能。\n一发临流笑，微言早服膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次磁湖以风浪留二日不得进子瞻以诗见寄作二篇答之前篇自赋后篇次韵 其二","author":"苏辙","text":"西归犹未有菟裘，拟就南迁买一丘。\n舟楫自能通蜀道，林泉真欲老黄州。\n鱼多钓户应容贳，酒熟邻翁便可留。\n从此莫言身外事，功名毕竟不如休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次子瞻夜字韵作中秋对月二篇一以赠王郎二以寄子瞻 其二","author":"苏辙","text":"十年秋月照相思，相从祇有彭门夜。\n露侵笳鼓思城阙，寒迫鱼龙舞潭下。\n厌厌夜饮欢自足，落落襟怀向人泻。\n秋深河来巨野溢，水乾楼起滕王亚。\n北海孔公虽好客，河内寇尹那得借。\n是非朝野忽纷纭，得丧芳菲一开谢。\n明月多情还入门，流水何知空绕舍。\n晨餐江市富鳣鲂，夜宿山村足梨蔗。\n坐隅鵩鸟不须问，墙外蝮蛇犹足怕。\n娄公见唾行自乾，冯老尚多谁定骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛国镇赵景仁唱和三首一赠毛一赠赵一自咏 其二","author":"苏辙","text":"一纸新诗过雁衔，醒然何异接君谈。\n奉亲鱼蟹兼临海，退食琴书定有庵。\n一别经年真似梦，多忧不饮亦如酣。\n共君友契非今日，蔽芾棠阴自剑南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛国镇赵景仁唱和三首一赠毛一赠赵一自咏 其三","author":"苏辙","text":"远谪江湖舳尾衔，到来辛苦向谁谈。\n畏人野鹤长依岭，厌事山僧祇住庵。\n黄雀顿来成一饱，白醪新熟喜初酣。\n疏顽近日尤堪笑，坐任飘风去自南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶花二首 其二","author":"苏辙","text":"细嚼花须味亦长，新芽一粟叶间藏。\n稍经腊雪侵肌瘦，旋得春雷发地狂。\n开落空山谁比数，烝烹来岁最先尝。\n枝枯叶硬天真在，踏遍牛羊未改香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其二","author":"苏辙","text":"江上孤城面面山，居人也自不曾闲。\n蜂游蚁聚知何事，日夜长桥南北间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其三","author":"苏辙","text":"城郭村墟共水云，槿篱竹屋映柴门。\n隐居亦有高人在，岸帻无言倚钓轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其四","author":"苏辙","text":"一官疏散自疑仙，三考应成醉日千。\n早病固须闲地著，多忧长被达人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其五","author":"苏辙","text":"养生尤复要功圆，溜滴南溪石自穿。\n近见牢山陈道士，微言约我更三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其六","author":"苏辙","text":"张公诗社见公名，白首山城叹不平。\n坐客要闻新乐府，应须湓口琵琶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其七","author":"苏辙","text":"高情日与故山期，鸿鹄谁言也倦飞。\n且听渔人强哺啜，坐中羁客畏公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其八","author":"苏辙","text":"天为多才故欲禁，府门摧落涨江深。\n鼎新翠壁排精铁，涌出飞楼直百金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其九","author":"苏辙","text":"楼上青山绕四垂，画桥百步引朱扉。\n落成当与公同上，一看长江白练微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和十首 其十","author":"苏辙","text":"歌舞留宾意自多，华灯数问夜如何。\n白头病客无才思，惯卧茅檐长薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"积雨二首 其二","author":"苏辙","text":"微阳力尚浅，未解破重阴。\n云气山川满，江流日夜深。\n冻牙生滞穗，馀润及重衾。\n泥泞沉车毂，农输绝苦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛君烧松花六绝 其二","author":"苏辙","text":"饼杂松黄二月天，盘敲松子早霜寒。\n山家一物都无弃，狼籍乾花最后般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛君烧松花六绝 其三","author":"苏辙","text":"松老香多气自严，馀烟勃郁透疏帘。\n须臾过尽惟灰在，借问谁收一番炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛君烧松花六绝 其四","author":"苏辙","text":"美人寒甚懒开扉，金作松花插羃䍦。\n几度低头疑堕落，青烟已断未消时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛君烧松花六绝 其五","author":"苏辙","text":"枯萼鳞皴不复坚，重重正似半开莲。\n曾经樵舍砖炉见，未许邦君画閤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵毛君烧松花六绝 其六","author":"苏辙","text":"黄蜡供炊自一家，锱铢贫富递矜誇。\n都城争买方薪贵，却顾松花已自奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛君惠温柑荔支二绝 其二","author":"苏辙","text":"荔子生红无奈远，陈家晒白到犹难。\n虽无驿骑红尘起，尚得佳人一笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛国镇生日二绝 其二","author":"苏辙","text":"闻公归橐尚空虚，近送楞严十卷书。\n心地本无生灭处，定逢生日亦如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王适元日并示曹焕二首 其二","author":"苏辙","text":"放逐三年未遣回，复惊爆竹起春雷。\n祈年粗有樽中桂，寄远仍持岭上梅。\n莫笑牛狸抵羊酪，漫将崖蜜代官醅。\n二君未肯嫌贫病，犹得衰颜一笑开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答孔平仲二偈 其二","author":"苏辙","text":"龟毛兔角号空虚，既被无收岂是无。\n自有真无遍诸有，灯光何碍也嫌渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王适东轩即事三首 其二","author":"苏辙","text":"眼看东邻五亩花，茅檐竹户野人家。\n过墙每欲随飞蝶，归舍谁怜已莫鸦。\n幽客偶来成晚饭，野僧何日寄新茶。\n三年气味长如此，归计迟迟也自嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王适东轩即事三首 其三","author":"苏辙","text":"北园春草径微微，未用频教剪棘茨。\n蜂阵纷纷初养蜜，莺巢浅浅欲生儿。\n客情流水兼山远，归梦游丝向日迟。\n懒病相将浑欲惯，赖君索我强裁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]