":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻书见舍弟去年自寿归郓道中诗怅然怀想久不作诗因集句为答用渭城体可歌也 其一","author":"刘跂","text":"春深逐客一浮萍，何处淹留白发生。\n山城过雨百花尽，野渡无人舟自横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻书见舍弟去年自寿归郓道中诗怅然怀想久不作诗因集句为答用渭城体可歌也 其二","author":"刘跂","text":"青春白日坐消难，须著人间比梦间。\n八公山下清淮水，明月何时照我还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻书见舍弟去年自寿归郓道中诗怅然怀想久不作诗因集句为答用渭城体可歌也 其三","author":"刘跂","text":"汶阳归客泪沾巾，莫厌伤多酒入唇。\n暂时相见还相送，水远山长愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻书见舍弟去年自寿归郓道中诗怅然怀想久不作诗因集句为答用渭城体可歌也 其四","author":"刘跂","text":"荒山野水照斜晖，绿净春深好染衣。\n请君问取东流水，来岁如今归未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻书见舍弟去年自寿归郓道中诗怅然怀想久不作诗因集句为答用渭城体可歌也 其五","author":"刘跂","text":"寻思百计不如閒，塞马重来事偶然。\n皇恩若许归田去，头白昏昏只醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻书见舍弟去年自寿归郓道中诗怅然怀想久不作诗因集句为答用渭城体可歌也 其六","author":"刘跂","text":"诗成吟咏转凄凉，独宿空帘归梦长。\n长年事事皆抛尽，惟到尊前是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重送成都漕","author":"刘跂","text":"曾游淮上爱清流，况子官为郡督邮。\n可贺吕虔贤太守，佩刀应得不须求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口号 其一","author":"刘跂","text":"孟仲争秋毒热新，自今三指算归旬。\n已判明月隔千里，可对茱萸少一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口号 其二","author":"刘跂","text":"面目已凭诗寄去，笑谈须待自将来。\n香泉不煮双金榼，候取归人趁菊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阙题","author":"刘跂","text":"北堂手种蓝田玉，采斸不随姜芋畴。\n迩来留得花为佩，付与吴侬可疗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又景亮惠藜杖赋绝句以谢 其一","author":"刘跂","text":"藜根矫矫似枯松，扶我蹒跚病力穷。\n置几赐餐非所重，康宁愿学乐全翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又景亮惠藜杖赋绝句以谢 其二","author":"刘跂","text":"银角桃枝空有赋，铁根藜杖可无诗。\n从今客到迎门待，还我维摩未病时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张辟疆","author":"刘跂","text":"老画骎骎不可攀，风流依约片言还。\n小儿若悟他年事，肯使生心涕泪间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觅竹示子勉","author":"刘跂","text":"为觅新篁雪后移，殷勤都莫遣根知。\n道人要作骑龙杖，与子相从到葛陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公度","author":"刘跂","text":"多情佳客送春来，雉尾猫头次第栽。\n从此庭前共苍翠，夭桃繁杏不须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松石 其一","author":"刘跂","text":"笔端陶冶不无神，纸面流沙秋后云。\n点破沙痕便成水，一溪松石浪沄沄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松石 其二","author":"刘跂","text":"向来爱鼎已成癖，今日还书真是痴。\n不分多求董威辇，只应重老李咸熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恩赦放还集句先寄乡中弟侄三首 其一","author":"刘跂","text":"去年当日别东都，鱼鸟犹疑畏简书。\n诏恩许逐阳和至，只向长沙住岁馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恩赦放还集句先寄乡中弟侄三首 其二","author":"刘跂","text":"橹声冲雨似鸣机，终日思归此日归。\n自为野客寻幽惯，不用登临叹落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恩赦放还集句先寄乡中弟侄三首 其三","author":"刘跂","text":"閒思往事似前身，羞见黄花无数新。\n我家孤侄在海浦，遍插茱萸少一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李氏绣佛赞 其一","author":"刘跂","text":"稽首慈悲父，相好光明藏。\n应现行愿力，针缕妙措成。\n我观因缘空，亦非自然性。\n种种皆心造，是心非造者。\n佛子不思议，炽然一念生。\n诸圣所加持，具足千百亿。\n我愿如是故，造作及见闻。\n遇见未来等，同承佛记莂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李氏绣佛赞 其二","author":"刘跂","text":"巍巍堂堂，妙庄严聚。\n一念现前，非针非缕。\n文闻已彰，何妨金露。\n满月当空，谁知在处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古器图赞","author":"刘跂","text":"想古之人，悠哉邈乎。\n我获其器，赋象在图。\n有客见之，笑此展转。\n阅斯勤斯，其人云远。\n我欲晓客，耿不能言。\n退观古人，恍独如存。\n千载寥寥，不在图外。\n谓不信者，取器以对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虏中作四首 其一","author":"刘跂","text":"文物燕人士，衣冠汉典仪。\n举知缯絮好，深厌血毛非。\n形势今犹古，规模夏变夷。\n谁言无上策，会是有天时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虏中作四首 其二","author":"刘跂","text":"甘作河南犬，休为燕地人。\n举能羞石晋，谁复怨嬴秦。\n地扼辽东海，星占析木津。\n悲伤此邦旧，会遣一朝新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虏中作四首 其三","author":"刘跂","text":"人物分多种，迁流不见经。\n已无燕代色，但有犬羊腥。\n海马生难驭，山苗煮始青。\n舜韶方九奏，异类合来庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虏中作四首 其四","author":"刘跂","text":"闻有官军士，生存仍宦胡。\n羞言陇西李，忍对杜陵苏。\n椎髻心何似，环刀意岂无。\n陈汤那复得，卫律不胜诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴江长桥","author":"刘跂","text":"路隔银潢鸟倦飞，行人恐犯女星机。\n长虹出浪无冬夏，老蜃浮空半是非。\n两岸履声云内合，三州帆影月边归。\n栏干独立秋风早，岂待鲈鱼始拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"刘跂","text":"急雨欲来先暑气，凉风过后却秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州 其一","author":"周谌","text":"公应夙世作词臣，文采飘飘入眼新。\n画烛排空滕阁夜，红旌照海越台春。\n新篇锦绣盈南国，旧德鹓鸿缀北辰。\n白发会稽还卧镇，直将生理付陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州 其二","author":"周谌","text":"风烟初别武王台，更向金河握节回。\n日月违颜天缥缈，尘沙吹面玉摧颓。\n试看紫府骖鸾去，又见长安驷马催。\n欲作东州遗爱录，自惭词笔乏邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陈瑊","text":"自是古今无变异，岂因霜雪有枯荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]