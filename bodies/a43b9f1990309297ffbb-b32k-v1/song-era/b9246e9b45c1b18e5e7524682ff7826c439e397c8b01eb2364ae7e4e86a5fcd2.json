[{"title":"竹里亭","author":"刘跂","text":"虽无白家池，竹是九之一。\n新萌如许长，来岁障夏日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藜杖","author":"刘跂","text":"雨衣类袯襫，野屩号不借。\n扶此枯藜根，行田北山下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学易堂作","author":"刘跂","text":"幽居淡无营，饱食心晏如。\n老不任作务，读我少时书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张赴供备 其一","author":"刘跂","text":"骑曲休歌出塞愁，渥洼名马鹔鹴裘。\n文章不暇三冬足，骨相由来万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张赴供备 其二","author":"刘跂","text":"桓桓壮气敌阳秋，冒雪冲风不被裘。\n天子方修上林苑，戎王莫怕义阳侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和初到岭二绝 其一","author":"刘跂","text":"到后浑如痛定时，不辞追赋道中诗。\n趁虚籴米非閒事，莫倚文章堪疗饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和初到岭二绝 其二","author":"刘跂","text":"欲语吞声且复休，异乡风物伴牢愁。\n铅华不为无人识，独自妆成却自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其一","author":"刘跂","text":"有香无色不因春，端是书生席上珍。\n同作齑盐赋诗客，定非歌舞赏花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其二","author":"刘跂","text":"根移少日便花开，数子殷勤手自培。\n更剪素衣成鹤氅，王恭定向雪中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其三","author":"刘跂","text":"玉蕊花开动玉宸，唐昌观里夜逢真。\n仙人琼卉初无比，直恐芳心却未申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其四","author":"刘跂","text":"凤尾成阴蕉叶重，金钿相对菊花繁。\n莫悲举世无相识，佩蕙纫兰有屈原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其五","author":"刘跂","text":"孤洁偏因霜露成，春花无数不知名。\n秖应新沐弹冠客，要尔相宜一倍清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其六","author":"刘跂","text":"日日花前醉赋诗，多情休诵北山移。\n沾巾不要时人学，独为秋香插一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其七","author":"刘跂","text":"姑射山前旧约非，秋风满意未成归。\n仙人一去无留迹，堕珥遗簪作雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉簪花和希纯 其八","author":"刘跂","text":"蓝田故有他山错，瑶旆琼旒碧玉干。\n左紫姚黄满金谷，野人留取伴鸡冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王安国芍药","author":"刘跂","text":"群花销尽独芳菲，淡沐轻膏知为谁。\n寂寞书生久无意，风流别驾合相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"相州州园","author":"刘跂","text":"解鞍休马暂萧然，虽晚犹堪一醉眠。\n所到园林且为主，若须吾有是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其一","author":"刘跂","text":"溪小才容舴艋舟，一樽聊复寄春流。\n纵横不用施篙棹，自在教随水上鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其二","author":"刘跂","text":"溪头青草弄春柔，一带花开动客愁。\n贪看波中锦纹石，不知船已过芳洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其三","author":"刘跂","text":"春水微生放鹢初，和风习习日舒舒。\n洲前且为停轻楫，待摘蒌蒿煮白鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其四","author":"刘跂","text":"扁舟如箭过前湾，飞鹭多情送我还。\n张起片帆风正急，回头已失蔡公山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其五","author":"刘跂","text":"天生桥畔水交流，夹岸花飞逐客舟。\n时听山禽歌一曲，何须吹笛舞凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其六","author":"刘跂","text":"下濑忽惊花满树，踏舟常恐酒杯翻。\n鼻头只怪香风远，知是行过桃李村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其七","author":"刘跂","text":"寒沙如雪水如蓝，歌啸中流响半岩。\n秖恐骊龙惊睡觉，呼风吹浪溅春衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其八","author":"刘跂","text":"春树连山水浸云，棹歌初奏浪花分。\n溪神为我添风色，十里归来日未曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其九","author":"刘跂","text":"淡淡春烟夕照微，渡头已觉行人稀。\n玉樽未尽宾朋意，两桨何妨待月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛西溪诗十首 其十","author":"刘跂","text":"岸边渐长陶潜菊，渚畔初生柳恽蘋。\n自学操舟狎清泚，从今休笑往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次黄富道觅山酿韵","author":"刘跂","text":"深岩穷谷自涓涓，惭愧诗情却泫然。\n政使家贫无曲米，犹堪烹作惠山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张竦","author":"刘跂","text":"张侯生意秖如瓶，出入艰难亦自成。\n却纵鸱夷差独乐，此中何物不堪盛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国湖上 其一","author":"刘跂","text":"溪光涵影碧萧萧，四合深林不见梢。\n寒暑若言无避处，世间那有况云巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国湖上 其二","author":"刘跂","text":"雨过松篁多样翠，风回蘋藻一般香。\n玉兰桃李非无意，兴味由来静处长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国湖上 其三","author":"刘跂","text":"菰蒲深处水藏波，邂逅相忘自啸歌。\n曳组悬龟知底用，水边消得一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国湖上 其四","author":"刘跂","text":"酤酒添庖趁晚饥，冷淘堆椀照银丝。\n羹芹有意无由献，此味君王恐未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国湖上 其五","author":"刘跂","text":"鸂鶒鸬鹚乐更真，夷犹溪水碧粼粼。\n全如傲世佳公子，泛泛波间不可亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和定国湖上 其六","author":"刘跂","text":"盘中擘粒试垂纶，与子应非臧丈人。\n渭水何须笑温水，绝胜憔悴楚江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏示语道","author":"刘跂","text":"御史青骢持望重，将军赤兔得勋多。\n乘黄騕袅今相见，垓下乌骓奈若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麦垄","author":"刘跂","text":"麦垄漫漫宿藁黄，新苗寸寸未经霜。\n手中马箠馀三尺，想见归时如许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵智夫并呈庭诲 其一","author":"刘跂","text":"为问尊前醉阿谁，韩娥应啭缕金衣。\n何须料理沙边客，更遣梁尘作雪飞