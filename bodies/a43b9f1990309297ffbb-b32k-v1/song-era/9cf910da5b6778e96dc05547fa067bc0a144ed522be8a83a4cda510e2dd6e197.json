[{"title":"题曾氏山园十一咏 其五 菊隐","author":"张栻","text":"不肯竞桃李，甘心同艾蒿。\n德人一题品，愈觉风味高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾氏山园十一咏 其七 蓼步","author":"张栻","text":"扁舟横薄莫，渺渺蓼知秋。\n家山有江湖，何必赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题曾氏山园十一咏 其三 橘沜","author":"张栻","text":"我家湘水滨，年年赋徕服。\n君家百亩田，晚岁千树绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题榕溪阁","author":"张栻","text":"寒溪澹容与，老木枝相樛。\n其谁合二美，名此景物幽。\n太史昔南骛，于焉曾少休。\n想当下榻初，清与耳目谋。\n品题得要领，亦有翰墨留。\n我来访遗址，密竹鸣钩辀。\n稍令旧观复，还与佳客游。\n树影散香篆，水光泛茶瓯。\n市声不到耳，永日风飕飕。\n所忻簿书隙，有此足夷犹。\n平生丘壑愿，如痼不可瘳。\n虽知等喧寂，终觉静理优。\n更思濯沧浪，榕根浮小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠乐仲恕","author":"张栻","text":"老子曾从先觉游，后来文采继风流。\n胸中有意穷千古，笔下成章映九秋。\n尘世利名无著莫，圣门事业要精求。\n咏归消息今犹在，鱼跃鸢飞会得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"默侄之官襄阳两诗以送之 其二","author":"张栻","text":"潦雨弥旬月，予方念鞠穷。\n子行何草草，别语又匆匆。\n汉沔英灵在，江山今昔同。\n未须登岘首，先合拜隆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其七","author":"张栻","text":"短筇遍历溪山，款段时寻邻里。\n遇酒聊一中之，得句亦偶然耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其六","author":"张栻","text":"人情自尔变迁，此道不渝燥湿。\n未妨静处闲观，要知二五即十。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其五","author":"张栻","text":"堤上已垂新柳，屋边尚有残梅。\n雪尽春生湖水，野航竟日悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其四","author":"张栻","text":"可是看花不厌，城南更欲城东。\n多谢诸君著语，莫教孤负春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其三","author":"张栻","text":"春意新回庭树，角声莫起江城。\n更著水仙为伴，真成难弟难兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其二","author":"张栻","text":"谁知牛铎黄钟，寡和阳春白雪。\n如君句法饱参，妙处不关言说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周畏知问讯城东梅坞七首 其一","author":"张栻","text":"城东幽事如许，一见定胜百闻。\n苦雨斜风无柰，断桥流水馀芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉茶送伯承伯承赋诗三章次韵 其一","author":"张栻","text":"与子艺兰九畹，胜渠赐璧一双。\n更碾春风白雪，同看明月清江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉茶送伯承伯承赋诗三章次韵 其二","author":"张栻","text":"正色可参官焙，妙香还近嵇山。\n草木丛中清绝，天教散在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉茶送伯承伯承赋诗三章次韵 其三","author":"张栻","text":"春去云藏岳麓，梅黄雨涨昭潭。\n政尔倚栏无那，一瓯唤起清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 联句问讯罗汉同张敬夫","author":"张栻","text":"雪月两相映，水石互悲鸣。\n不知岩上枯木，今夜若为情。\n应见尘中胶扰，便道山间空旷，与么了平生。\n与么平生了，□水不流行。\n起披衣，瞻碧汉，露华清。\n寥寥千载，此事本分明。\n若向乾坤识易，便信行藏无间，处处总圆成。\n记取渊冰语，莫错定盘星。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅","author":"张栻","text":"清溪南畔小桥东，落月纷纷水映红。\n五夜客愁花片里，一年春事角声中。\n歌残玉树人何在，舞破香衫曲未终。\n却忆孤山醉归路，马蹄残雪衬春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张栻","text":"郴山足奇变，其水复清美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"张桂","text":"雨压杨花路半乾。\n蜂遗花粉在阑干。\n牡丹开尽正春寒。\n懒品么弦金雁并，瘦惊双钏玉鱼宽。\n新愁不放翠眉间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"张桂","text":"东风忽骤无人见。\n玉塘烟浪浮花片。\n步湿下香阶。\n苔黏金凤鞋。\n翠鬟愁不整。\n临水闲窥影。\n摘得野蔷薇。\n游蜂相趁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过严子陵钓台二首 其二","author":"张浚","text":"中兴自是还明主，访旧胡为属老臣。\n从古风云由际会，归欤聊复养吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过严子陵钓台二首 其一","author":"张浚","text":"古木笼烟半锁空，高台隐隐翠微中。\n身安不羡三公贵，宁与渔樵卒岁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张浚","text":"群凶用事人心去，大义重新天意回。\n解使中原无左衽，斯文千古未尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张浚","text":"三相当年镇庙堂，江山草木亦增光。\n一时主宰权衡重，千古人间姓字香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞喻弥陀掩遗骸","author":"张浚","text":"刀兵劫海苦漫漫，原野遗骸葬若干。\n尽大地人须荐取，眼睛突出髑髅寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠罗赤脚","author":"张浚","text":"学道由来不记年，啸歌风月在前缘。\n身心已到无尘处，疑是人间自在仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李伯纪丞相挽诗二首 其二","author":"张浚","text":"十相从明主，唯公望最隆。\n召周虽异迹，李郭本心同。\n未遇升天药，空馀济世功。\n薰风歌吹咽，泪尽古城东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李伯纪丞相挽诗二首 其一","author":"张浚","text":"苍苍安可料，旧德奄重泉。\n痛为黎民惜，谁扶大厦颠。\n英风摩日月，正气返山川。\n丙午功勋在，丰碑万口传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝阳岩","author":"张浚","text":"已觉云天阔，风声四面凉。\n路幽迟晚日，岩古浥流香。\n客舍长年静，渔舟底事忙。\n相逢贤太守，不用管弦将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登道观","author":"张浚","text":"苍髯野褐予甚古，萝月桂风谁为贫。\n当户蛟龙森汉柏，隔江鸡犬隐秦人。\n好山如画能留客，宝鼎藏丹不计春。\n更上高亭问玄鹤，莫教诗眼有纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子","author":"张浚","text":"迟日惠风柔。\n桃李成阴绿渐稠。\n把酒樽前逢盛旦，凝眸。\n十里松湖瑞气浮。\n功业古难侔。\n宜在凌烟更上头。\n已向眉间浮喜气，风流。\n千岁三分万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"张浚","text":"教外单传佛祖机，本来无悟亦无迷。\n浮云散尽青天在，日出东方夜落西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏未开牡丹赠李氏 其一","author":"张浩","text":"迎日香苞四五枝，我来恰见未开时。\n包藏春色独无语，分付芳心更待谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏未开牡丹赠李氏 其二","author":"张浩","text":"碧玉蔀中藏蜀锦，东吴宫里锁西施。\n神功造化有先后，倚槛王孙休怨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题荆溪图","author":"张监","text":"斩蛟桥北玉枢府，高树连云第一家。\n欲向新图问何处，客窗风雨对梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"张祥","text":"为爱龙山胜，小队一登临。\n冯仙洞府安在，抉石试幽寻。\n商略生平事业，摆脱人间尘土，欲与斸断丝苓。\n泉响似相答，未可启归心。\n中原地，禾黍茂，犬羊腥。\n君王梦想豪杰，有待扫妖氛。\n缚虎正须人手，跨鹤缓酬夙志，行矣勿因循。\n夜半遣雷雨，助我作秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冯先生访梅于成都西郊同游十五人分韵哦诗而积不与翊日先生分僧字属积作之","author":"张积","text":"春回九地阳潜升，南枝破腊如酥凝。\n疏篱度香竹稍短，寒沙倒影溪流澄。\n魁然老株忽骇目，雪鳞矫矫双龙腾。\n天公一叱困仆地，掀髯弄爪高曲肱。\n长林望断千百株，奋首直欲青云凌。\n黎州太守和羹手，十里往看车呼登。\n西江破晓郊路净，合簪者谁金兰朋。\n欢笑藉草飞大白，行厨载酒多于渑。\n风花飘摇落杯面，漱齿浇胸如嚼冰。\n湘流之清岘山瘦，千古邂逅一笑兴。\n却踏东风急回首，侵夜霜月寒生棱。\n入门未坐亟相诧，曰今见之生未曾。\n成都胜事多四蜀，我欲问津云水僧。\n先生功成早丐身，未老重来醉倚藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张子正观察溪风亭二首 其二","author":"张称","text":"碧水通三径，高风重五侯。\n知深丹扆眷，未许赤松游。\n山简暂为郡，齐公晚得周。\n会攽滨海诏，再运钓鳌钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张子正观察溪风亭二首 其一","author":"张称","text":"亭临流水上，地接古城隈。\n日永檐楹静，春深锦绣开。\n鸥随清漾远，风杂乱香来。\n怀咏北山檄，招邀翠作堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"张素","text":"圣主临朝重义门，紫泥旌表不优恩。\n广延墨客收经籍，已见丹朱及子孙。\n池沼宴时花满槛，烟霞吟处酒盈樽。\n清闲官秩清闲景，千户侯封未足伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书林管辖扇","author":"张继先","text":"九鸾陪玉兽，八凤荐金芝。\n青童歌妙曲，玄女唱清词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月分韵得清字","author":"张继先","text":"碧霄澄彻素芒清，一片多情四海明。\n花院空庭冷香里，羽人心胆欲寒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白菊","author":"张继先","text":"陶家篱下未开时，曾得西风借力吹。\n月影夜深笼素艳，分明残雪两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示汤弟子","author":"张继先","text":"子欲济民非为己，我贪修道不忧贫。\n直须勉强方成业，只恐因循易老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"传度后作","author":"张继先","text":"道人愿力如天溥，度尽众生方自度。\n若还纤芥未蒙恩，我终不舍升天路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏吟","author":"张继先","text":"落魄正当年，人皆笑我颠。\n乾坤时运动，沧海渺无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹","author":"张继先","text":"雨过江皋净，风来庭槛清。\n此君故人好，入夜听秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访友不遇题","author":"张继先","text":"庵里人行庵外路，庵外人来庵里坐。\n遮头茅草欠坚牢，年年风雨年年破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙应大师往钱塘欲予赠行","author":"张继先","text":"太真宫室上方新，归去先垂紫诏人。\n天目洞霄期过处，星冠应不冒风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡","author":"张继先","text":"鸡德灵居五，峨冠凤彩新。\n五更大张口，唤醒梦中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏窗","author":"张继先","text":"无意殷勤遮皓月，有心特地隔红尘。\n从兹虚室长生白，占得桃源洞里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉弟子还山颂","author":"张继先","text":"昔劫因缘今劫会，昨日颜容今日改。\n世间沧海尽桑田，慎勿重来呈傀儡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鍊丹岩留题","author":"张继先","text":"鹤来松有客，苔去石无衣。\n黄金浮世在，白发故人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送九龙徐正之归麻姑","author":"张继先","text":"步冲晴雪过前滩，鹤迹云踪孰可攀。\n也似来时无一物，却疑归去是三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟","author":"张继先","text":"金晶铸就斗星悬，挂向琼楼知几年。\n好是五更残梦里，一声敲透白云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲花","author":"张继先","text":"淡淡红生细细香，半开人折寄山房。\n只缘清净超尘垢，颇似风流压众芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄元规","author":"张继先","text":"白日未中气色明，玉壶兴入西源行。\n草堂羡我不共往，竹风为汝致幽清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其九","author":"张继先","text":"钟声鼓声朝夕鸣，茶烟炊烟先后生。\n云衣霞佩栖山客，兀兀穷年无一营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其八","author":"张继先","text":"晴日暖风时出游，冷烟凄雨便归休。\n云还樵斧溪边牧，不似畸人得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其七","author":"张继先","text":"柴门虽谩不曾关，宾客从他自往还。\n连日山寒声影绝，蒲团危坐更安闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其六","author":"张继先","text":"莫羡庵居景物清，须知乐自苦中生。\n山前尽日幽寻客，多说荒蹊不可行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其五","author":"张继先","text":"南山雨过北山出，昨夜月明今日晴。\n云气自舒还自捲，太虚万古常清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其四","author":"张继先","text":"长松偃蹇不依林，枝干高盘千亩阴。\n昨夜酒醒风雨急，半空彷佛听龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其三","author":"张继先","text":"春蚕丝尽即生蛾，秋燕雏成不泥窠。\n山雉经时藏窟穴，也能龙化入烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其二","author":"张继先","text":"庵前桃李春争开，雪里见花惟有梅。\n莫谓枝梢有分别，根本自异非人栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庵居杂咏九首 其一","author":"张继先","text":"甓瓦完齐土壁坚，籓篱周匝没疏穿。\n人来谩笑无华旆，风雨须教安稳眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野轩偶书","author":"张继先","text":"日月双萤火，乾坤一鹊巢。\n野轩有凉户，谁敢等闲敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄","author":"张继先","text":"洞霄深处日栖真，仙子亲曾此致身。\n凤阙有人来献礼，溪声山色愈增新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题濯鼎泉","author":"张继先","text":"几千年浪碧澄澄，对景难忘我祖情。\n乐就也知曾借力，轩成方见不辜名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠青城洞翁二首 其二","author":"张继先","text":"人间久矣喜相倍，道术参同岂吝哉。\n他日功成果轻举，为吾天上作梯媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠青城洞翁二首 其一","author":"张继先","text":"神仙抱一养玄微，九载功成白日飞。\n道在当人须顺授，今朝何必秘天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云台治","author":"张继先","text":"汉朝人与道翱翔，是处遗踪属静方。\n烟外桃花非俗种，风前柏实有馀香。\n杖穿翠霭通深窅，舟驾洪波入渺茫。\n千八百年三十代，云台空碧佩琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]