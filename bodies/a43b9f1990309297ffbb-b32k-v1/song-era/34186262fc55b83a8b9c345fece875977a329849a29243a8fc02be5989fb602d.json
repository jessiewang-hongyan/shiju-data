[{"title":"赠道禅者","author":"释德洪","text":"大河卷浪雪翻风，桥压千艘卧彩虹。\n岱岳烟云连绝域，北门楼阁碍层空。\n浪游荆楚重湖外，更在沩源叠嶂中。\n水饼槐芽动乡思，近来归梦与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周庭秀爱湘中山水之胜定居十馀年宣和五年夏五月忽思吴中别余于湘上作此送之","author":"释德洪","text":"词刃平生工斫伐，探怀每欲取公侯。\n朅来世事懒经意，醉看湘山不转头。\n忽忆归吴泛千里，偶然尽室载孤舟。\n却将挥翰风雷手，且钓华亭万顷秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题悟宗壁","author":"释德洪","text":"到寺回身望众峰，一堂疏快万缘空。\n槲林曲折通幽径，莲荡凋零退晚红。\n师已灰心增夏腊，我今霜鬓撒秋风。\n亦知旁舍多佳士，香火他年愿此同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过陵水县补东坡遗","author":"释德洪","text":"白沙翠竹并江流，小县炊烟晚雨收。\n苍藓色侵盘马地，稻花香入放衙楼。\n过厅客聚观灯网，趁市人归旋唤舟。\n意适忽忘身是客，语音无伴始生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜归示卓道人","author":"释德洪","text":"心知家本住仇池，傲睨人间老变衰。\n两鬓京尘初邂逅，一尊川语问归期。\n劝沽何处禽知我，含笑谁家花隔篱。\n天水摹胡飓风作，夜归江路月相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪诗","author":"释德洪","text":"千岩雨雪黄昏后，一室香灯一寝馀。\n此夕乡关入归梦，明朝云物记曾书。\n地垆不独闻瓶泣，山果时惊落屋除。\n清境鼎来劳应接，暮年生计未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王教授艇斋","author":"释德洪","text":"宴居端若寄虚舟，三峡词源日倒流。\n惯与衣冠游泮水，坐看图史认瀛洲。\n胸中耿耿观澜术，物外悠悠涉世谋。\n莫谓纵横止容膝，济川林叶此中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾山风物如故园而甚僻余居月馀爱之将此卜居二首 其一","author":"释德洪","text":"此生于世已无求，况有村原事事幽。\n乞谷住山真素志，栽田博饭是良谋。\n别坡笋蕨春兼采，绕舍桑麻岁倍收。\n强健自能营饱暖，尘埃回首谩悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾山风物如故园而甚僻余居月馀爱之将此卜居二首 其二","author":"释德洪","text":"风物淳真似故丘，茅茨结处自深幽。\n竹西邻舍颇相近，客至须供良甚谋。\n灯火夜窗衣自补，丰登秋亩稻重收。\n安閒有此支馀岁，更欲驱驰亦谬悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送楞严经珣维那","author":"释德洪","text":"尸罗清净心清净，寄迹南台亦偶然。\n室掩香灯见行道，壁悬巾屦伴孤禅。\n宝书独欲烦君诵，法力真期迨我先。\n细味此诗如实录，他年僧史定须编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢岳麓光老惠临济顶相","author":"释德洪","text":"瘦骨孤标韵绝伦，传闻宗派出云门。\n收藏画里三玄老，分付湘中十世孙。\n骂佛风神疑正怒，打僧气宇尚惊群。\n能言灭却正法眼，不负滩头毒手恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送珠上人泐潭拜塔","author":"释德洪","text":"泐潭卧龙今不见，空有遗珠留世间。\n圆转自然离矿秽，光明聊复秘形山。\n随师受嚫前身事，披掌犹存此日还。\n言不走盘无影迹，方知生死不相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龙王枯木堂","author":"释德洪","text":"异种灵苗著四方，谩将名字挂虚堂。\n道林可惜昏岚掩，枯木那知在处芳。\n韶石曾闻傲烟瘴，焦山今已饱风霜。\n阳陂且喜根株茂，雪里花开烂熳香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送海印奭老住东林","author":"释德洪","text":"湘容岳色中秋后，古寺闲房小寝馀。\n扫径帚粘新落叶，开窗风掩读残书。\n吹云又作他山去，种漆何时伴我居。\n洞上闲名犹在世，未应容易与人除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余至清修别希一禅师津发如老媪扶女外车其义风可以起颓俗将发作此","author":"释德洪","text":"惊风急雨中秋后，回首长沙杳霭间。\n迎送初辞大藩府，逍遥来看小庐山。\n故人情义千钧重，行客生涯一叶闲。\n明日旅亭劳昼梦，孤峰标格不容攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题压波阁","author":"释德洪","text":"雪玉在躬贤令尹，江山约束入宏规。\n惊波溅岸凭陵□，杰阁控云弹压之。\n雾敛尘清闲纵目，蜂争蚁分想当时。\n邦人准拟朱栏外，安著他年惠爱碑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵贾令尹题裴公亭","author":"释德洪","text":"独凭危栏眼力穷，当年胜践想遗风。\n歌喉云杪殷馀韵，笑靥尊前发醉红。\n世相难逃朝夕改，山容不老古今同。\n议郎笔力回春色，摹写都藏画牒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余往汉上清修白鹿二老送至龙牙作此别之","author":"释德洪","text":"因法相逢亦一时，云泉所至共娱嬉。\n怪君追送不辞远，知我从来未有期。\n酝造离愁成独笑，欺凌秋色有新诗。\n阎浮掌上诃梨勒，去住休缠爱见悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪夜至明教寄王路分舍人","author":"释德洪","text":"雪夜山中还独宿，地垆深暖纸窗明。\n百年有限身今老，一枕无求梦自清。\n弟子分灯成保社，故人持节顿江城。\n瘴痾疏快诸缘净，卧听摧檐泻竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访双池老不遇其子觉先求诗为作此","author":"释德洪","text":"芒鞋竹杖快新晴，天迥游丝百尺轻。\n沃若柔桑连野绿，炯如白鸟照溪明。\n逢山有寺幽欣集，对客开轩午梦清。\n曦竟未回凭阁久，忽闻高柳子规声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寂音泉","author":"释德洪","text":"水灵有源不知处，但见方沼供无穷。\n俯波下看远山色，卷雾忽惊清镜空。\n危亭快若望霜晓，江岸□□□阴风。\n宜呼此泉作檀越，岁致万斛无凶丰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯禅师出蜀住此山十年为作南食且约同住作此以赠","author":"释德洪","text":"少年出蜀今耆艾，十见襄阳浩荡春。\n山近京畿看愈好，食兼虏馔味尤真。\n君今避世成深隐，我欲移庵结近邻。\n相对无嫌太岑寂，待添明月作三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄州乱后逢端州依上人","author":"释德洪","text":"汉上相逢兵火后，苍颜华发两摧颓。\n尘清雾敛闲身在，蚁分蜂争一笑开。\n志捍丛林山剔卓，义规朋友玉崔嵬。\n瓦精决舌休皮相，曾见淄州古佛来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济之通判日夜怀祖颖诸公","author":"释德洪","text":"才高自是万夫望，语妙人疑锦绣肠。\n新事惊嗟入诗律，故交契阔付凄伤。\n开书想见湖山好，他日悬知夜语长。\n狱屋岂能埋宝剑，斗牛长觉射龙光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送匀工人谒蔡州使君","author":"释德洪","text":"淮西气宇盖三军，绝似平原旧使君。\n今日孤城独坚守，疾风劲草昔传闻。\n龙蛇戏下唯呼姓，翰墨场中亦策勋。\n想见棠阴谈我处，笑持茗盌辩如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄盛群玉","author":"释德洪","text":"平生翰墨到精微，盛氏诸郎最白眉。\n气讦曾窥豪士赋，初交先和野僧诗。\n谩劳清梦思相识，那料孤踪晚见知。\n君看临危用心处，何殊晏子解骖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月十八夜大雪注莲经罢有僧来劝归庐山僧去作此","author":"释德洪","text":"烟凝生怕席帘开，快煖偏宜榾柮柴。\n夜久饥鼯嗅空案，梦惊斗虎堕层崖。\n优昙花偈馀残纸，薝卜杯香自满斋。\n折脚铛安莫嫌稳，地偏人懒遂幽怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中","author":"释德洪","text":"势密连空若推下，随风起舞不容追。\n门闲走犬无深巷，树暗栖鸦有剩枝。\n旋拨地垆通宿火，却呵冻手写新诗。\n轩窗秀发惊清昼，万壑春归说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再会庄德祖大夫","author":"释德洪","text":"平昔才名似孟宗，暮年一钵并岩丛。\n交朋半在青云上，意气都消白眼中。\n庞老尚馀灵照在，伯鸾应许孟光同。\n君看张柬之为相，不害荆州秃鬓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与蔡扬州","author":"释德洪","text":"五马东来数月间，十州人物帖然安。\n池边芳草新吟罢，楼外遥山昼卧看。\n铃阁蜡烟秋色晚，谯门铜漏夜声寒。\n虽然自是云林客，犹把风流作话端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐生能视手文乞诗戏赠之","author":"释德洪","text":"草芜门径过从少，那料秋来夜话同。\n屋漏移床时发笑，粥稠当饭巧于穷。\n我留痴绝传身后，君见平生似掌中。\n明日渡江应转首，数峰无语晚连空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠麻城接待僧胜上人","author":"释德洪","text":"绿发凋零白业增，住庵随分有规绳。\n为分一邑人家饭，普供十方云水僧。\n扫径客来圆笑靥，开轩云破露寒层。\n君看击桶金牛手，坐续山头柏子灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日同安示阿崇诸衲子","author":"释德洪","text":"老眼朅来惊节物，闲同诸子话江乡。\n试茶正要旋烘盏，煮饼且令深注汤。\n忽忆海山餐荔子，更思湘水劈莲房。\n夏休便可车轮去，菌蕈秋肥趁及尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十八日枣柏大士生辰六首 其一","author":"释德洪","text":"深观诸佛刹那际，三世十方无遁形。\n已尽凡情不颠倒，如除目翳自光明。\n意俱大地山河丧，心与空花梦幻生。\n垂手遇缘携法界，美髯跣足散衣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十八日枣柏大士生辰六首 其二","author":"释德洪","text":"二天给侍慈忍象，一虎橐经常寂光。\n意处世间离生灭，梦中尘劫浪遮藏。\n即真不必冠巾毁，绝染何妨枣柏尝。\n提起超情无比句，夜来山雨落花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十八日枣柏大士生辰六首 其三","author":"释德洪","text":"青春径去不小住，天迥游丝增眼寒。\n想见手提大千界，翛然身现一毛端。\n若存情见智山隔，但断攀缘业海乾。\n面目分明今日是，敢将枣柏荐盘餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十八日枣柏大士生辰六首 其四","author":"释德洪","text":"生死鹘崙无背面，摩挲把玩久嗟咨。\n悟明必藉戒定慧，随顺差成老病衰。\n净意即空良显决，色身对现出思惟。\n千烹万锻知恩德，敢忘摩尼在矿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十八日枣柏大士生辰六首 其五","author":"释德洪","text":"眼盖人寰撚美髯，年年相见晚春前。\n摸苏缘妄心俱尽，揩拭鲜陈念已圜。\n指下琴方才发越，眉间毫相见无边。\n微尘劫海依今住，生死何劳较后先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十八日枣柏大士生辰六首 其六","author":"释德洪","text":"一刹那际入正受，互参三世妙难思。\n有情梦境依此住，无量劫海不移时。\n任运行藏难掩覆，随疑语默出思惟。\n大哉无比金刚句，世罕知之我独知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十世观音生辰六月二十六日二首 其一","author":"释德洪","text":"十世为僧皆姓杨，死生游戏自隋唐。\n铁身自倒汝邪□，写字无为我道场。\n异迹著于无量寿，慈风不减普昭王。\n两川显化人皆识，今日全身不掩藏。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十世观音生辰六月二十六日二首 其二","author":"释德洪","text":"昙相禅师第二身，蝉联十世姓杨人。\n女兄慧辩成勍敌，弟子悲欣记夙因。\n解使邪迷知有佛，自呼名字凛如神。\n平生接物多方便，何似今朝一句亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡藏用生辰","author":"释德洪","text":"非烟云子酿新晴，争看麒麟堕地行。\n悉达已闻今日诞，优昙知复为谁荣。\n已惊久视方瞳碧，更觉藏年玉骨清。\n曾伴麻姑家法在，愿随风驭到蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月二十三日蔡元中生辰","author":"释德洪","text":"才过中秋今几日，夜来海月上三更。\n梦魂传得天书至，窗户俱明厩马惊。\n骨相终当为国器，儿声初已识人英。\n明年庆节山中友，金屋怜君夜直清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘彭年知县生辰","author":"释德洪","text":"清规懿德古难陪，秋尽民歌庆节来。\n瑞应草馀双叶在，优昙花适一枝开。\n莺娇妙管传佳句，玉腻新妆献寿杯。\n慈母千龄何所愿，早看贤子践三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中庐赵令生辰","author":"释德洪","text":"孟夏南风草木薰，民歌庆节喜传闻。\n今朝雪乙呈双瑞，后夜冰轮满九分。\n材业牛刀试小邑，家声天派落层云。\n吞舟岂久容涔足，禁殿论思政要君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄黄嗣深使君二首 其一","author":"释德洪","text":"江夏家声世所闻，无双千顷典刑存。\n肃严郡邑霜分晓，照映簪缨玉粹温。\n楼迥岘云供醉望，夜晴汉月洗吟魂。\n行将补衮调羹手，却执元圭侍至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄黄嗣深使君二首 其二","author":"释德洪","text":"身世浮云偶尚存，白衣苍狗与谁论。\n梦中不记金门宿，醉里曾看玉海翻。\n尚有惊魂缠瘴雾，已甘华发老江滨。\n枯荄欲藉阳和暖，催发新来雨露恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李道夫母挽辞","author":"释德洪","text":"缙绅家法想清规，平昔高风此一时。\n居约云山夫有道，客陪房杜子无疑。\n九原泪湿老莱袂，千字碑传幼妇词。\n他日欲寻贤母墓，北山松雨路人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邓循道父挽辞二首 其一","author":"释德洪","text":"苦冰洁檗是行藏，一节无求老更刚。\n好在缙绅师俭德，尚馀闾里说谦光。\n阴功隐秘天应录，遗训丁宁世共伤。\n勿谓不身尝报施，故应遗泽在诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邓循道父挽辞二首 其二","author":"释德洪","text":"一生纯德无遗恨，千字埋名有逸辞。\n墓隧嫩泉谁种玉，书斋子砚自生芝。\n音容已作终天痛，岁月真成罔极悲。\n拥鼻功名知不免，空将泪眼看风枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其一","author":"释德洪","text":"射圃闲亭酒半醺，手柔弓燥气超群。\n已惊百步穿杨綵，会看双雕落塞云。\n且集旌旗森画戟，未输文字饮金樽。\n治朝文武须兼用，万寿称觞祝至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其二","author":"释德洪","text":"太平无象乐年丰，况值疆场久已空。\n宾主献酬成雅集，江山谈笑助清风。\n良辰美景开金斝，缓带轻裘控角弓。\n鼙鼓急催齐指目，大侯的处中飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其三","author":"释德洪","text":"雨后园林花木新，传闻千骑出城闉。\n异能未中侯中鹄，佳气先浮盏面春。\n画鼓绣靴筵奏曲，红妆细马地无尘。\n长沙万古民争说，宾主人英伎绝伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其四","author":"释德洪","text":"闻道长沙贤太守，漆瞳玉颊照衡湘。\n讼庭散后宾朋集，民瘼苏来礼乐昌。\n且展绮筵陪胜饯，何须檀板闹红妆。\n晓无探骑□边檄，愿献君王万寿觞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其五","author":"释德洪","text":"细柳成阴花满径，晚来钲鼓导朱轮。\n河东鸑鷟三英杰，天上麒麟两俊人。\n闲里笑谈清似玉，杯中贤圣韵如春。\n引弓一箭惊穿札，堵立欢声快吏民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其六","author":"释德洪","text":"绣衣天使志澄清，五马贤侯见典刑。\n公退钲声闻射圃，日高槐影覆闲庭。\n共看酒蚁浮琼斝，不废花轮绕画屏。\n银烛红纱侵夜色，醉归明月淡疏星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其七","author":"释德洪","text":"陇西家世到仍云，许国清忠盖代闻。\n有道风流贤太守，无双才气旧将军。\n整弦使者情和易，承附诸郎艺逸群。\n便好画图收拾取，要传盛事满湘滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其八","author":"释德洪","text":"如云旌骑照湘江，千里农桑楚大邦。\n中鹄才高今有武，射雕伎巧古无双。\n锦袍雅称黄金带，琼液尤宜白玉霜。\n笑挽雕弓如满月，万人惊慑已心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其九","author":"释德洪","text":"无双自昔擅家声，春色都还细柳营。\n中的聊为万人杰，飞觥要使百壶倾。\n三湘父老传风化，十郡儿童识姓名。\n武纬文经俱不乏，桑弧蓬矢见平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人上李龙图并廉使致语十首 其十","author":"释德洪","text":"画鼓晓晴三击罢，如云兵骑整全威。\n俄闻画角胡笳断，忽觉华堂羽箭飞。\n一百步中精力巧，数重围内见心机。\n风流太守兼文武，扶路争看踏月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代夏均甫宴人致语一首","author":"释德洪","text":"九龄风度照峿台，宴寝香凝画戟开。\n归国已倾天下耳，驻轩宜举故人杯。\n青天白日心常在，附骥攀鳞志未摧。\n累足待公成相业，更随风驭看蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]