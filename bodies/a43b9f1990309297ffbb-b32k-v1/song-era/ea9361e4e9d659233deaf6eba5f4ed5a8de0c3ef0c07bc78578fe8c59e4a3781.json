[{"title":"题西林院壁二首 其一","author":"朱熹","text":"触目风光不易裁，此间何似舞雩台。\n病躯若得长无事，春服成时岁一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题西林院壁二首 其二","author":"朱熹","text":"巾屦翛然一钵囊，何妨且住赞公房。\n却嫌宴坐观心处，不奈檐花抵死香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题西林可师达观轩","author":"朱熹","text":"窈窕云房深复深，层轩俄此快登临。\n卷帘一目遥山碧，底是高人达观心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再题","author":"朱熹","text":"古寺重来感慨深，小轩仍是旧窥临。\n向来妙处今遗恨，万古长空一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示西林可师二首 其一","author":"朱熹","text":"身世年来欲两忘，一春随意住僧房。\n行逢旧隐低回久，绿树莺啼清昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示西林可师二首 其二","author":"朱熹","text":"幽居四畔只空林，啼鸟落花春意深。\n独宿尘龛无梦寐，五更山月照寒衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事书怀十六韵","author":"朱熹","text":"胡虏何年盛，神州遂陆沉。\n翠华栖浙右，紫塞仅淮阴。\n志士忧虞切，朝家预备深。\n一朝颁细札，三捷便闻音。\n授钺无遗算，沈机识圣心。\n东西兵合势，南北怨重寻。\n小却奇还胜，穷凶祸所临。\n旃裘方舞雪，血刃已披襟。\n残类随煨烬，遗黎脱斧砧。\n戴商仍夙昔，思汉剧讴吟。\n共惜山河固，同嗟岁月侵。\n泉蓍久憔翠，陵柏幸萧椮。\n正尔资群策，何妨试盍簪。\n折冲须旧衮，出牧仗南金。\n众志非难徇，天休讵可谌。\n故人司献纳，早晚奉良箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘彦采观雪之句","author":"朱熹","text":"朔风吹空林，眇眇无因依。\n但有西北云，冉冉东南飞。\n须臾层阴合，惨淡周八维。\n冻雨不流渊，飞花舞妍姿。\n翳空乍灭没，散影还参差。\n万点随飘零，百嘉潜润滋。\n徘徊瞻咏久，默识造化机。\n上寒下必温，欲积无根基。\n渐看谷树变，稍觉丛篁低。\n皓然遂同色，宇宙乃尔奇。\n繁华改新观，凛冽忘前悲。\n摛章愧佳友，伫立迎寒吹。\n感此节物好，叹息今何时。\n当念长江北，铁马纷交驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦采病中口占","author":"朱熹","text":"一榻流年度，篝灯遥夜阑。\n短衾闲自拥，清镜莫频看。\n竹密初惊雪，梅疏却耐寒。\n从今花木梦，无复在雕栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事","author":"朱熹","text":"闻说淮南路，胡尘满眼黄。\n弃躯惭国士，尝胆念君王。\n却敌非干橹，信威藉纪纲。\n丹心危欲折，伫立但彷徨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其一","author":"朱熹","text":"胡马无端莫四驰，汉家元有中兴期。\n旃裘喋血淮山寺，天命人心合自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其二","author":"朱熹","text":"天骄得意任驱驰，太岁乘蛇已应期。\n一夜旄头光殒地，饮江胡马未全知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其三","author":"朱熹","text":"雪拥貂裘一马驰，孤军左袒事难期。\n奏函夜入明光殿，底事庐儿探得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其四","author":"朱熹","text":"渡淮诸将已争驰，兔脱鹰扬不会期。\n杀尽残胡方反旆，里闾元未有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其五","author":"朱熹","text":"汉节荧煌直北驰，皇家卜世万年期。\n东京盛德符高祖，说与中原父老知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其六","author":"朱熹","text":"追锋闻说日驱驰，旧德登庸傥有期。\n圣主聪明似尧禹，忠邪如许讵难知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻二十八日之报喜而成诗七首 其七","author":"朱熹","text":"恭惟大号久风驰，清跸传呼却未期。\n此日不须劳玉趾，寸心那得侍臣知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次子有闻捷韵四首 其一","author":"朱熹","text":"神州荆棘欲成林，霜露凄凉感圣心。\n故老几人今好在，壶浆争听鼓鼙音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次子有闻捷韵四首 其二","author":"朱熹","text":"杀气先归江上林，貔貅百万想同心。\n明朝灭尽天骄子，南北东西尽好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次子有闻捷韵四首 其三","author":"朱熹","text":"孤臣残疾卧空林，不奈忧时一寸心。\n谁遣捷书来荜户，真同百蛰听雷音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次子有闻捷韵四首 其四","author":"朱熹","text":"胡命须臾兔走林，骄豪无复向来心。\n莫烦王旅追穷寇，鹤唳风声尽好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉陪判院丈充父平父兄宿回向用知郡丈壁间旧题之韵","author":"朱熹","text":"暮雨停骖处，僧庐古道边。\n千峰环杰阁，一水下平田。\n行役无期度，经过几岁年。\n明朝须饱饭，蹑足上寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事再用回向壁间旧韵二首 其一","author":"朱熹","text":"江北传烽火，胡儿大入边。\n已闻隳列障，不但扰屯田。\n借箸思人杰，摧锋属少年。\n偷安惭暇食，万灶起愁烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事再用回向壁间旧韵二首 其二","author":"朱熹","text":"廊庙忧虞里，风尘惨淡边。\n早知烦汗马，悔不是留田。\n迷国嗟谁子，和戎误往年。\n腐儒空感慨，无策静狼烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒙判院丈示及再用元韵之作率易和呈以求指诲","author":"朱熹","text":"畴昔经行地，溪山寂寞边。\n冰霜凝巨壑，风雨暗中田。\n古寺堪投晚，尘龛阅纪年。\n论文寒夜永，清绝袅炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数日前与判院丈有宋村之约雪中有怀奉呈判院通判二丈","author":"朱熹","text":"云垂天阔岁将阑，一室翛然独掩关。\n拥褐不知风折木，开轩惟见雪漫山。\n玄空杳霭低迷外，碧树珑璁掩映间。\n吟罢左思招隐句，扁舟无路过长湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵判院丈雪意之作","author":"朱熹","text":"端居岁复穷，闭户守冲澹。\n风阴原野悲，月黑庭除暗。\n淅沥静先知，崩奔谁与探。\n坐想青瑶林，寒光生素艳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熹伏蒙判院丈垂示用韵喜晴之句率尔奉酬伏乞笑览","author":"朱熹","text":"客枕终难稳，归来鼾息深。\n晓鸡回远梦，缺月挂空林。\n冰谷晨加帽，晴窗昼解襟。\n诗筒多妙语，仍喜旧盟寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登梅岭","author":"朱熹","text":"去路霜威劲，归程雪意深。\n往还无几日，景物变千林。\n晓磴初移屐，寒云欲满襟。\n玉梅疏半落，犹足慰幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪意","author":"朱熹","text":"向晚浮云四面平，北风号怒达天明。\n寒窗一夜清无睡，拟听杉篁叶上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨夕不知有雪而晨起四望远峰皆已变色再用元韵作两绝句 其一","author":"朱熹","text":"朔风吹尽暮云平，室暖炉红睡达明。\n但怪朝来满山白，不知昨夜打窗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨夕不知有雪而晨起四望远峰皆已变色再用元韵作两绝句 其二","author":"朱熹","text":"千林无叶一川平，万壑琼瑶照夜明。\n未觉残梅飘落尽，祇愁羌管不成声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉陪彦集充父同游瑞岩谨次莆田使君留题之韵","author":"朱熹","text":"踏破千林黄叶堆，林间台殿郁崔嵬。\n谷泉喷薄秋逾响，山翠空濛昼不开。\n一壑祇今藏胜概，三生畴昔记曾来。\n解衣正作留连计，未许山灵便却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读赵清献公瑞岩留题感叹之馀追次元韵","author":"朱熹","text":"赵公名迹此犹微，已荐行藏第一机。\n直自当年留翰墨，至今穷谷尚光辉。\n时清谏疏空遗稿，岁晚高斋自掩扉。\n珍重九原如可作，问渠何处是真归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读二刘公瑞岩留题感事兴怀至于陨涕追次元韵偶成二篇 其一","author":"朱熹","text":"谁将健笔写崖阴，想见当年抱膝吟。\n缓带轻裘成昨梦，遗风馀烈到如今。\n西山爽气看犹在，北阙精诚直自深。\n故垒近闻新破竹，起公无路祇伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读二刘公瑞岩留题感事兴怀至于陨涕追次元韵偶成二篇 其二","author":"朱熹","text":"投绂归来卧赤城，家山无处不经行。\n寒岩解榻梦应好，绝壁题诗语太清。\n陈迹一朝成寂寞，灵台千古自虚明。\n传来旧业荒芜尽，惭愧秋原宿草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入瑞岩道间得四绝句呈彦集充父二兄 其一","author":"朱熹","text":"忆昔南游桂树阴，归来遗恨满尘襟。\n篮舆此日无穷思，万壑千岩秋气深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入瑞岩道间得四绝句呈彦集充父二兄 其二","author":"朱熹","text":"翩翩一马两肩舆，路转秋原十里馀。\n共说前山深更好，不辞迢递款禅居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入瑞岩道间得四绝句呈彦集充父二兄 其四","author":"朱熹","text":"风高木落晚秋时，日暮千林黄叶稀。\n祇有苍苍谷中树，岁寒心事不相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽籍溪胡先生三首 其一","author":"朱熹","text":"夫子生名世，穷居几岁年。\n圣门虽力造，美质自天全。\n乐道初辞币，忧时晚奏篇。\n行藏今已矣，心迹故超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽籍溪胡先生三首 其二","author":"朱熹","text":"澹泊忘怀久，浑沦玩意深。\n箪瓢无改乐，山水自知音。\n册府遗编在，丘原宰树阴。\n门人封马鬣，寒日共沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽籍溪胡先生三首 其三","author":"朱熹","text":"先友多沦谢，唯公尚典刑。\n向来深缱绻，犹足慰飘零。\n乔木摧霜干，长空没晓星。\n伤心遽如许，孤路转竛竮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潮州诗六首 濠上斋二首 其一","author":"朱熹","text":"黄堂理事馀，便坐永兹日。\n语默趣虽殊，晦明心本一。\n旧闻真体露，已叹群疑失。\n迨此复几年，定知久纯白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潮州诗六首 濠上斋二首 其二","author":"朱熹","text":"道若大路然，奈此人好径。\n即事昧本心，离动觅真静。\n安知濠上翁，妙入玄中境。\n偶寄郡斋闲，无欲民自正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潮州诗六首 闲坐","author":"朱熹","text":"坐啸无馀事，淡然尘虑希。\n闲中自怡悦，妙处绝几微。\n韩子成今古，颠师果是非。\n悠然发孤些，千载傥来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潮州诗六首 销寇","author":"朱熹","text":"年来揭阳郡，牢落海阴墟。\n云峤无幽子，潢池有蹠徒。\n单车亦已税，蔓草不须锄。\n比屋弦歌里，功高化鳄图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潮州诗六首 山丹","author":"朱熹","text":"昔游岭海间，几见蛮卉拆。\n素英漙夕露，朱蘤烂晴日。\n归来今几年，晤对祇寒碧。\n因君赋山丹，悦复见颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潮州诗六首 山居即事用叠翠亭韵","author":"朱熹","text":"世情日以疏，庭树日以密。\n我心自悠悠，两忘喧与寂。\n门开山叠翠，雨罢云绝迹。\n天涯此兴同，万里寄消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柬舍侄","author":"朱熹","text":"回头别子时，岁月剧风雨。\n老大无所成，惭叹中夜舞。\n长镵足呻吟，短褐极蓝缕。\n古人不可期，炯炯心独苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日斋居得潮州诗卷咏叹之馀用卒章之韵以纪其事","author":"朱熹","text":"孟夏气淑清，窗户有佳色。\n卧闻幽箨翻，转觉林景寂。\n参差帙委素，缥缈香横碧。\n啜菽有馀欢，缨冠非所职。\n故人海边郡，妙语寄远翼。\n咏叹不得闻，超然见胸臆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其一","author":"朱熹","text":"秋风萧爽天气凉，此日何日升斯堂。\n堂中老人寿而康，红颜绿鬓双瞳方。\n家贫儿痴但深藏，五年不出门庭荒。\n灶陉十日九不炀，岂办甘脆陈壶觞。\n低头包羞汗如浆，老人此心久已忘。\n一笑谓汝庸何伤，人间荣耀岂可常。\n惟有道义思无疆，勉励汝节弥坚刚。\n熹前再拜谢阿娘，自古作善天降祥。\n但愿年年似今日，老莱母子俱徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其二","author":"朱熹","text":"敬为生朝举一觞，短歌歌罢意偏长。\n愿言寿考宜孙子，绿鬓朱颜乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其三","author":"朱熹","text":"阴澹园林岁欲霜，怪来和气满中堂。\n要知积善工夫巧，变得人间作寿乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其四","author":"朱熹","text":"昨夜秋风凉气归，今朝喜色动帘帏。\n细斟潋滟新春酒，戏舞斑斓旧綵衣。\n愿上龟莲千岁寿，永令凫藻一家肥。\n也知厚德天应报，更说阴功世所希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其五","author":"朱熹","text":"暑退秋容欲凛然，北堂佳气倍澄鲜。\n旧痾已向新凉失，寿骨应随爽籁坚。\n尘外光阴那有尽，尊前风月浩无边。\n痴儿六六今如许，惭愧西河不老仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其六","author":"朱熹","text":"仙人昔住紫琳房，一旦翩然下大荒。\n久悟客尘无自性，故应福禄未渠央。\n徙居邂逅成嘉遁，捧檄因循愧漫郎。\n愿借寒潭千丈碧，年年此日奉华觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿母生朝 其七","author":"朱熹","text":"竹柏交柯庭院清，西风不动翠帘旌。\n高堂正喜新凉入，乐事仍逢寿斝倾。\n尽室丹衷归善祷，满头绿鬓定重生。\n年年此日欢娱意，更愿时丰乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁丑冬在温陵陪敦宗李丈与一二道人同和东坡惠州梅花诗皆一再往反昨日见梅追省前事忽忽五年旧诗不复可记忆再和一篇呈诸友兄一笑同赋","author":"朱熹","text":"江梅欲破江南村，无人解与招芳魂。\n朔云为断蜂蝶信，冻雨一洗烟尘昏。\n天怜绝艳世无匹，故遣寂寞依山园。\n自欣羌笛娱夜永，未要邹律回春温。\n连娟窥水堕残月，的砾泣露晞晨暾。\n海山清游记玉面，衰病此日空柴门。\n相逢不敢话畴昔，能赋岂必皆成言。\n雕镌肝肾竟何益，况复制酒哦空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁晚燕集以梅花已判隔年开分韵赋诗得已字","author":"朱熹","text":"阳愆冬气昏，日暮悲风起。\n晤言欲谁从，斗酒会邻里。\n盘餐乏珍脆，肴核阙储峙。\n无以奉嘉宾，瓶罄亦可耻。\n所赖数子贤，深眷不余鄙。\n夜阑更促席，灯火共欢喜。\n酣歌气激冽，杰句韵清美。\n衰懒愧英游，岁晚情何已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卓国太生朝 其一","author":"朱熹","text":"凤凰山下凤凰城，十载重来双眼明。\n剩喜故人频献纳，足知贤母外荣名。\n生朝举酒天香里，贱子当歌鲁颂声。\n问讯豪眉今几许，年年此日照人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卓国太生朝 其二","author":"朱熹","text":"玄冬周四运，肃气驱烦喧。\n孕此贞秀质，德美难具论。\n巍巍北堂高，福履神所敦。\n晨昏极荣养，夙昔蒙天恩。\n明年启国封，屈狄文鱼轩。\n斑衣结紫绶，玉树承金尊。\n欢娱何所忘，千载如飞奔。\n惟应玄中趣，眇眇自本根。\n洗心河汉津，入此无穷门。\n超然谢众甫，永与天壤存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"社后一日作","author":"朱熹","text":"圣作重品节，等杀古所详。\n里有秦社稷，僭差遂无章。\n王纲谅已隳，精意尚不亡。\n尚论千载前，简编有遗芳。\n侃侃陈孺子，恂恂万春乡。\n敬恭事耆老，祷赛谨田桑。\n悠悠我里居，岁事有故常。\n向来诸老翁，惇厖亦端庄。\n交神庶或享，与物同乐康。\n今我胡不乐，怅然下颓冈。\n古人不可见，今人自猖狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月三日祀事毕因脩禊事于灵梵以高阁一长望分韵赋诗得一字","author":"朱熹","text":"逝川无停波，岁月一何疾。\n居然雨露濡，我意日萧瑟。\n共惟西山足，宰树久蒙密。\n晤言起哀敬，时事该礼律。\n肴羞既纷罗，荐馈亦芳苾。\n周旋极悽怆，俛仰讵终毕。\n更衣适精舍，邻曲会兹日。\n簋黍畀煇胞，从容罄膋膟。\n嘉宾更盘礴，环堵窥逸笔。\n即事君独哦，非才我何述。\n矧兹衰病馀，苦畏烦虑怵。\n赋罢掩寒栖，存存常抱一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日二首 其一","author":"朱熹","text":"端居倦时暑，竟日掩柴门。\n窗风远飙至，竹树清阴繁。\n静有图史乐，寂无车马喧。\n兹焉惬所尚，难与世人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]