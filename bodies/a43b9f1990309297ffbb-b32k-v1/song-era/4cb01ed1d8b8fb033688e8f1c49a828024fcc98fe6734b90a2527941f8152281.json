[{"title":"次韵陈知点瑞木一首","author":"廖刚","text":"薪斧宁参造化权，发祥瑞若剖符然。\n天心默与人心契，字色浑如墨色鲜。\n事类洛书今更显，义稽商颂古难全。\n愿归麟阁光青史，千载声歌播舜弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林吉夫朝奉共乐台即事","author":"廖刚","text":"一飞南堕羽谯谯，回首清都万里遥。\n却幸开樽得云榭，不妨携客上星桥。\n花明总照潘郎鬓，柳妙争萦楚女腰。\n化国春城人自乐，多惭前哲德音昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张延之觉寺亭","author":"廖刚","text":"迷途非远复，靖节子其徒。\n止水明心法，行年见道枢。\n俨如还旧国，端是得遗珠。\n燕处今何事，春风咏舞雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廖常山人惠珠副以诗文戏谢之","author":"廖刚","text":"至宝人所秘，感君轻暗投。\n还君祝君富，不是薄隋侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和吴济仲见赠长篇","author":"廖刚","text":"我有茆庐傍林麓，负溪映光千顷绿。\n灵峰钟磬敞金莲，绝涧松篁泻寒玉。\n萦回窈窕廓以容，正可标名取盘谷。\n肥鱼香稻不须致，苦恨风悲无静木。\n霜蒲易折柳经秋，萧飒鬓毛眵两目。\n闲云不雨空出岫，谩说幽兰自芬馥。\n低回还笑杜陵老，尧舜君民厚风俗。\n青萍飞跃凤鸣翔，要待乾旋坤转轴。\n只今舆马非我事，拄杖芒鞋巾一幅。\n时时照弄摩尼珠，金色祥云满天竺。\n年龄亦复惊晼晚，不暇栽松惟种菊。\n清冷池上景物新，幸得君诗三反读。\n向来巳分得奇祸，岂料更容侥静福。\n天光下济诏语温，未遣安丰惭考叔。\n市朝宗古恶风波，公棹惟怜初不欲。\n经营蛙角嚇腐鼠，往往竟同蛾赴烛。\n须知幻境本来空，况乃隙驹光景促。\n逍遥物外复何疑，苟简场中无自足。\n昨宵星月蘸虚碧，行散绕堤方恨独。\n朅来共语君勿迟，想见风尘厌追逐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠圆照","author":"廖刚","text":"试说栖真是若何，铁牛安卧到新罗。\n个中消息凭谁会，古庙缘墙长薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴工部日题信州玉南寺壁和韵","author":"廖刚","text":"病愤无凭写，翻然试一来。\n谁知丘壑性，畴昔斗牛回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题临漳台 其一","author":"廖刚","text":"银河一派接天来，碧玉千峰照眼开。\n我欲乘槎访仙去，却疑身巳在蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题临漳台 其二","author":"廖刚","text":"画栋岧峣倚翠微，玉箫声断紫烟飞。\n凭阑万里秋光老，谁会长吟久未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日牡丹","author":"廖刚","text":"金风淅沥叶飞黄，独倚殊姿逞艳阳。\n谁道化工无鉴别，故应奇特属花王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别妙湛","author":"廖刚","text":"云游何所图，只为一大事。\n事了早归来，和我休歇去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宁节致语口号","author":"廖刚","text":"虹流电绕想当时，万万人今寿域跻。\n十荚蓂开尧宝历，九歌功叙禹元圭。\n需云湛露罗簪绂，脆管繁弦飏羽霓。\n千仞寿山封祝意，年年峻极与天齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕待知滁州郭舍人致语口号","author":"廖刚","text":"汾阳几世令公孙，曾掌纶言代帝尊。\n扈毕未从朝紫极，郡符聊复驾朱轓。\n须知荣贵南柯梦，且尽勤渠北海樽。\n更愿滁人休借寇，欲看勋德被元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕陈观察致语口号","author":"廖刚","text":"皇华使者万人英，谁似青云稳致身。\n和气一城迎綵旆，高牙千骑拥朱轮。\n买臣被命聊辞汉，季子应朝却入秦。\n归侍玉皇难再见，当欢莫惜举杯频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕待赵走马致语口号","author":"廖刚","text":"使者星车自九天，一声天语万人传。\n恩光晓月明旌旆，和气薰风入管弦。\n北海樽罍须酩酊，东山歌舞亦婵娟。\n按行况觉都无事，倒载何妨作饮仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕待新知越州王中大致语","author":"廖刚","text":"画船搥鼓叠烟波，夹道争看刺史过。\n定有去思留剡水，巳传来暮到嘉禾。\n籓垣暂屈元侯镇，鼎鼐终还妙手和。\n高会莫辞今夕醉，儿童竹马拥郊坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕待宫使郭舍人致语","author":"廖刚","text":"琳宫仙客紫微郎，大笔由来远擅场。\n三接恩光倾弁冕，五花文綵照缣缃。\n蛟龙岂久逃雷雨，琏璧终须属庙堂。\n莫惜当欢同尽醉，主人龚召客常杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同前","author":"廖刚","text":"画堂开宴惬新凉，燕舞莺歌奉玉觞。\n未放仙舟登李郭，更看贤守会龚黄。\n三竿日照旌旗动，千里风飘锦绣香。\n尽醉故应怜夜永，高情莫逆话偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕待知泉州郑司业致语","author":"廖刚","text":"虎符分寄辍名卿，锦缆牙樯绣水滨。\n昼秀岂将誇故里，綵衣端为奉高亲。\n开怀此日樽中醉，结绶他年席上珍。\n画鼓不须催去棹，清欢难会玉堂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕待走马太傅致语","author":"廖刚","text":"使节星驰宿卫贤，九重遥指觐天颜。\n三春日暖桃花浪，万里人归明月船。\n金谷高欢难会遇，玉京还驭恐留连。\n明朝綵旆烟波渺，莫惜通宵醉管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新知明州周龙图知兴化黄府判特排致语口号","author":"廖刚","text":"丽日和风花正妍，黄堂高会四神仙。\n凌云擅价蓬莱客，游刃飞声天府贤。\n旌旆驰驱聊此日，鼎槐调燮属他年。\n红英趁拍莫教错，冠玉周郎正汝怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕走马太傅大排致语口号","author":"廖刚","text":"星车还自九天来，应是明时重选才。\n泽与尧言下宣室，人随汉史上春台。\n恩光晓日千家动，和气晴云万里开。\n高会莫辞同尽醉，风流北海富樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高丽使副特排致语口号","author":"廖刚","text":"方壶员峤海中仙，吴越溪山照画船。\n玉帛名王朝帝德，节旄肤使驻宾筵。\n恩承雨露来天上，武接鹓鸾指日边。\n共燕需云歌盛事，愿同文轨万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"引伴致语口号","author":"廖刚","text":"蓼萧均泽九夷同，万里将迎礼意隆。\n属国未瞻都护节，列城先仰使华风。\n清谈会觉襟无暑，痛饮何辞盏屡空。\n早晚回辕天上去，已应声价落辽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄思贤母氏挽词 其一","author":"廖刚","text":"哀响震重闱，伤心薤露晞。\n玉颜遗宝镜，仙驭想霞衣。\n恨满风中树，恩深草上晖。\n空傅御史孝，泣血故乡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄思贤母氏挽词 其二","author":"廖刚","text":"寿考推贤德，安荣享庆门。\n鹓鸿行令子，兰玉秀诸孙。\n谷暗风悲棘，庭空露泣萱。\n从今五色锦，不复照温颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀中作","author":"曲端","text":"破碎江山不足论，何时重到渭南村。\n一声长啸东风里，多少未归人断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温泉寺","author":"曲端","text":"曾统山西十万兵，腰间宝剑血犹腥。\n山僧不识英雄客，俣必叨叨问姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清凉院","author":"曲端","text":"日脚烧空意欲燃，山行六月道闻蝉。\n自怜不及高枝上，饱汲清风不费钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"曲端","text":"不向关中兴事业，却来江上泛渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终诗","author":"王道坚","text":"无心曾出岫，倦翮早知还。\n为报长安使，休寻海上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题安阳山","author":"赵伾","text":"突兀当空势不群，崭然头角起祥氛。\n毗陵自古多英傪，可信孤峰解主文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞朝","author":"钭元珍","text":"大定山河四十秋，人心不似水长流。\n受恩深处宜先退，得意浓时便好休。\n莫待是非来入耳，从前恩爱反为雠。\n世间多少忠良将，服事君王不到头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回朝","author":"钭元珍","text":"宴罢琼林酒一杯，忙忙骢马出蓬莱。\n黎民喜遇三春雨，猾吏愁逢二月雷。\n带得一天新雨露，扫开宇内旧尘埃。\n文昌阁上人千万，争看神明夺锦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归隐","author":"钭元珍","text":"碧树深林夏景凉，薰风飘竞日偏长。\n闲时棋局娱宾乐，忙里吟诗慰己惶。\n臣节栎才惟谨肃，圣明敷德化顽强。\n退暇狂声心犹耿，祈愿烽烟息障疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居","author":"妙普庵主","text":"心法双忘犹隔妄，色尘不二尚馀尘。\n百鸟不来春又过，不知谁是住庵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"警众三首 其一","author":"妙普庵主","text":"学道犹如守禁城，昼防六贼夜惺惺。\n中军主将能行令，不动干戈致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"警众三首 其二","author":"妙普庵主","text":"不耕而食不蚕衣，物外清闲适圣时。\n未透祖师关棙子，也须存意著便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"警众三首 其三","author":"妙普庵主","text":"十二时中莫住工，穷来穷去到无穷。\n直须洞彻无穷底，踏倒须弥第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"妙普庵主","text":"劫数既遭离乱，我是快泎烈汉。\n如今正好乘时，便请一刀两段。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"妙普庵主","text":"坐脱立亡，不若水葬。\n一省柴烧，二省开圹。\n撒手便行，不妨快畅。\n谁是知音，船子和尚。\n高风难继百千年，一曲渔歌少人唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"妙普庵主","text":"船子当年返故乡，没踪迹处妙难量。\n真风遍寄知音者，铁笛横吹作散场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亡姑墓铭诗","author":"尹焞","text":"嗟夫人之生兮，一气凝乎混茫。\n变而之死兮，去不知其何乡。\n唯懿德之在人兮，愈久而不忘。\n归安此室兮，其千万年无坏伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过种明逸故居题绝句","author":"尹焞","text":"少年亡意学经纶，老矣空馀此一身。\n面似髑髅头似雪，却来岩谷继前尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自秦入蜀道中绝句三首 其一","author":"尹焞","text":"绿阴深处竹篱遮，也有红花映白花。\n却忆故乡卿相第，不及张三李四家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自秦入蜀道中绝句三首 其二","author":"尹焞","text":"晓来雨过槐阴润，午霁风摇麦浪寒。\n自愧此身徒扰扰，未知何处可偷安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自秦入蜀道中绝句三首 其三","author":"尹焞","text":"南枝北枝春事休，啼莺乳燕也含愁。\n朝来回首频惆怅，身过秦川最尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避贼至商山绝句","author":"尹焞","text":"西来几被雪霜埋，鸿雁嗷嗷莫强猜。\n今朝始踏商山路，高视浮云任去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其一","author":"释思慧","text":"板韵才终，鼓声三叠。\n人天交接，龙象回旋。\n祖佛家风，一时漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其二","author":"释思慧","text":"天地一指，万物一马。\n踏倒系驴橛，清风满天下，庄生亦是悠悠者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其三","author":"释思慧","text":"智海无这个忌讳，要开便开，要合便合。\n要打便打，要喝便喝。\n一切智通无障碍，十方世界横该抹。\n灵叟灵叟，快活快活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其四","author":"释思慧","text":"透得荆棘过，枯木堂中第一座。\n拈得笔头挥，长连床上第二机。\n若向个中论胜劣，得便宜是落便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其五","author":"释思慧","text":"青春易过，白日难留。\n始见新年，又将一月。\n生死事大，人皆知之。\n了得生死，能有几个。\n拄杖子了得死生，古今日月磨砻他不得。\n天堂地狱龙罩他不得，六道四生留连他不得，祖师言句羁绊他不得。\n如师了王，自在无畏。\n哮吼一声，群狐屏迹。\n有时横按孤峰顶，铁眼铜睛不敢窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其六","author":"释思慧","text":"一法既通，万法无碍。\n拈起笊篱，放下布袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其八","author":"释思慧","text":"闰年节候晚，六月始梅蒸。\n一番云过一番雨，半日阴来半日晴。\n草鞋烂却浑闲事，苦是禅人眼不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释思慧","text":"妙高山顶，云海茫茫。\n少室岩前，雪霜凛凛。\n齐腰独立，徒自苦疲。\n七日不逢，一场懡㦬。\n别峰相见，落在半途。\n只履西归，远之还矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释思慧","text":"一切法无差，云门胡饼赵州茶。\n黄鹤楼中吹玉笛，江城五月落梅花。\n惭愧太原孚上座，五更闻鼓角，天晓弄琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释思慧","text":"南询诸友，踏破草鞋。\n绝学无为，坐消日月。\n凡前易脱，圣解难忘。\n但有纤毫，皆成渗漏。\n可中为道，似地击山。\n应物显形，如驴觑井。\n纵无计较，途辙已成。\n若论相应，转没交涉。\n勉诸仁者，莫错用心。\n各自归堂，更求何事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"洪拟","text":"富贵功名岂易量，暂休聊洗十年忙。\n赤城山下林泉美，退老堂中日月长。\n种竹几年心未厌，栽花经日手犹香。\n一丘寄傲真吾事，何必怀归问故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"洪拟","text":"千载明良不易逢，退居谁不慕高风。\n香留铁砚韦编上，卷在金罍玉斝中。\n鳌足共知曾立极，龙韬犹欲倚平戎。\n追锋只恐来相继，行看东山起谢公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏睹三兄文会之乐皆见于诗不肖屏居山间颇以不获陪末从为歉辄继高韵聊以自叙云尔。","author":"洪拟","text":"老去谩将书作伴，平生不喜酒为名。\n倦游落落忘尘事，清梦时时入化城。\n纵有诗骚浑漫与，回看波浪亦堪惊。\n赤城从阻陪高会，深自怜馀不及情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海五咏 其一 崇教寓居","author":"洪拟","text":"七年溪山北，颇自爱吾庐。\n人生真寄耳，何必赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海五咏 其二 对客隐几","author":"洪拟","text":"客欲谈世事，词锋若戈矛。\n我已梦为蝶，咄哉为罢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海五咏 其三 晚晴读书","author":"洪拟","text":"新晴快老读，斜日在遗编。\n吾非求甚解，会意即欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海五咏 其四 窗下独酌","author":"洪拟","text":"万事休杯酒，高情谁与论。\n寄语问安者，谨勿过吾门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁海五咏 其五 书斋夜坐","author":"洪拟","text":"不知月欲落，但觉衣生棱。\n夜深谁是伴，相对祇孤灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞莲桥","author":"王肱","text":"莲桥琢石跨松蹊，满院真香种木樨。\n欲得淡轩谈寂照，须将明水洗沉迷。\n云峰黯黯巴猿啸，竹岭苍苍杜宇啼。\n从此邦人知胜概，为师增贲此招提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过南华","author":"孙渐","text":"挟策自羽龄，周览南华书。\n茫然访道志，欲驾将焉如。\n朅来南华道，始识其故墟。\n尘迹寄委蜕，万事同蘧庐。\n想其为吏时，傲世乐有馀。\n天地等毫末，轩冕同锱铢。\n三公礼荜户，万乘尊褐夫。\n去古邈已远，浇风日沦胥。\n得丧嚇腐鼠，怒悦纷众狙。\n材否笑鹜雁，断续伤鹤凫。\n钓台已湮没，漆城称荒芜。\n恨不见斯人，逍遥与之俱。\n还淳以反朴，抚俗归黄虞。\n神交付恍惚，日暮犹踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]