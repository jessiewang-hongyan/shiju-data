[{"title":"偈颂一百零二首 其一○五","author":"释慧远","text":"参透西来鼻祖禅，乘时东去广流传。\n镬汤炉炭随缘入，剑树刀山自在攀。\n教海义天休更问，龙宫宝藏岂能诠。\n翻身师子通涂妙，活捉魔王鼻孔穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十一","author":"释慧远","text":"而来与一杓咸盐酸醋，北来与一杓苦菜淡齑。\n吃则因邪打正，不吃则自东自西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十七","author":"释慧远","text":"钵盂盛世界，拄杖搅沧溟。\n鱼龙俱削迹，佛祖也逃形。\n日午全机现，乌沉未出轮。\n秋高山月白，春至烧痕青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十七","author":"释慧远","text":"良宵正月一，日从东畔出。\n照见耆阇峰，回环指□中。\n坐断石桥路，凡圣无回互。\n佛祖生冤家，相逢若稻麻。\n雪消春雨过，碓觜也生花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十七","author":"释慧远","text":"四月上夏渐热，善疗也须调摄。\n文殊眼里抽筋，金刚脑后拔楔。\n须弥㪍跳上天，海底昆崙吐舌。\n几度长歌几度愁，一回饮水一回噎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四","author":"释慧远","text":"陇麦青青春色过，岭云散尽楚天高。\n翻思欢喜园中事，八万魔军争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十二","author":"释慧远","text":"红霞穿碧落，白鹭点苍苔。\n不得颜良首，谁能叹善哉。\n根向梢头出，子从花里开。\n只遮是，不须猜，青山绿水鬓边腮。\n有时寻不见，依旧却还来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十九","author":"释慧远","text":"五四三二一，日向东畔出。\n照见洞庭湖，乌龟眼睛赤。\n天无门，地无壁。\n一阵任风倒射回，吹起两须无孔笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十六","author":"释慧远","text":"白枫坞荆棘塞路，清潭山草莽缠身。\n牛栏头鳢鱼?跳，朱岭榨出油三斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十七","author":"释慧远","text":"若能离诸相，即入法王家。\n法王无二法，无法即是家。\n是故法王法，当甚苦瓠瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十五","author":"释慧远","text":"大地毗岚起，人天觉树摧。\n白云归大壑，惨雾结成堆。\n淼淼江天门，声声唤不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十八","author":"释慧远","text":"云笼岳顶，月印波心。\n私道车马，官不容针。\n著底一任著，不著底一任不著。\n虎□龙驹，兔头生角。\n春光夜雨昼晴，不怕和根烂却。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十三","author":"释慧远","text":"圆机互唱脱名模，妙应还同转辘轳。\n北济渊源连海峤，西岐枝叶茂江湖。\n一句子，彻天衢。\n草木虫鱼随物化，山川海岳亦欢呼。\n大千世界归明主，万国梯航贡帝都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十二","author":"释慧远","text":"年年正月一，鼻孔长三尺。\n个个贺新春，眉毛重八斤。\n但□平正事，天道自分明。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十六","author":"释慧远","text":"神仙秘诀妙难传，秃头修罗打左拳。\n夜半归来无觅处，忍饥高卧饭箩边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三","author":"释慧远","text":"虾蟆跳上梵天，蚯蚓蓦过东海。\n洞庭湖顶门著地，龙蟠山脑后见腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十二","author":"释慧远","text":"电卷星驰作者知，倒施逆用猛提撕。\n霜华宝剑当风按，忿怒那吒斫额窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十二","author":"释慧远","text":"梅阳老嘱付此衣，遮护得山僧一半。\n借问搭来何所宜，恰似当年卖柴汉。\n酱里堕，雪中炭，留与丛林斫额看。\n君不见睦州严陵滩畔兜率寺里有个陈蒲鞋，解道秦时?轹钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九","author":"释慧远","text":"今朝九月初一，败叶凋零满室。\n钵盂高挂悬崖，拄杖依前靠壁。\n几许斸山风月，且无遮个消息。\n诸祖不解提掷，久参那辨端的。\n云黯黯兮胡汉何分，风萧萧兮鼻孔突出。\n自是捕盗无功，只管抱赃叫屈。\n捉得也，捉得也，在什么处，晚风吹动小楼春，归来一径花狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十七","author":"释慧远","text":"言无展事，语不投机。\n顶门著眼，颔下安眉。\n圣凡路绝，事理俱非。\n刀截春风，锯解称锤。\n刀锯俱妙，明暗可追。\n刀锯不尔，二破一亏。\n阿呵呵，也大奇。\n风卷怒涛天际阔，莫教断送老头皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十六","author":"释慧远","text":"老婆二八少年时，羞向人前舞柘枝。\n而今要嫁便改嫁，谁管傍人说是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十七","author":"释慧远","text":"掬水月在手，弄花香满衣。\n若作佛法会，永劝堕泥犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十七","author":"释慧远","text":"一是二，二是三，咬定牙关彻底参。\n闹浩浩时双手掷，赤条条处两肩担。\n文殊老，强指南，□门三顿实难甘。\n五峰山下翻筋斗，八达衢头转放憨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○二","author":"释慧远","text":"两阵交锋出战时，旗鎗倒卓鼓无槌。\n丝毫不犯将军令，独脚机关各自提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十","author":"释慧远","text":"云外千峰秀，目前双涧清。\n若作如是会，永劫受沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十","author":"释慧远","text":"大哉释迦文，生下便作怪。\n南北东西行，点胸也忒杀。\n弃舍轮王位，反受父母拜。\n六载向雪山，精进修净戒。\n明星才出现，證道果能快。\n分别说三乘，惹得一身债。\n最后向灵山，拈花索买卖。\n十万众人前，就中无一介。\n独有迦叶波，和赃与捉败。\n二千年前且放过，直至而今被佗坏。\n坏不坏，主元在。\n主既在，休厮赖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十五","author":"释慧远","text":"仲冬十一月半，冷地急著眼看。\n春来草木还青，冬去冰霜自泮。\n谁知两个五百，元来合成一贯。\n纵饶百炼真金，也入红炉再煅。\n衡门突出古菱花，由胜秦时?轹钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十","author":"释慧远","text":"今朝六月初五，明眼衲僧难睹。\n惊回座□□龟，咬杀街头石虎。\n磨镇旗，挝铁鼓，破口半治闲佛祖。\n起坐相随独自行，夜漏声沈日卓午。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八","author":"释慧远","text":"扫尽衲僧踪，裂破祖师印。\n蹋翻香水海，透出威音前。\n生断主人公，不落第二见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十五","author":"释慧远","text":"良宵三月十五，依旧神歌鬼舞。\n未须三四吐吞，且看七八吞吐。\n临济瞎驴倒跨，云门正法眼普。\n三人證鳖成龟，一任衲僧气鼓。\n休气鼓，甜者甜兮苦者苦。\n偃月长蛇不用呈，发机自有千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十一","author":"释慧远","text":"今朝七月初一，丛林法岁将周。\n便请解开布袋，相从触处□游。\n解与不解总得，而今要休便休。\n凡圣本无忌讳，佛魔总是冤雠。\n静悄悄没干涉，闹浩浩莫能收。\n东行不见西行利，一叶落知天下秋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十二","author":"释慧远","text":"寒山扫松径，拾得拂苍苔。\n凭仗东君些子力，一时吹入我门来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十三","author":"释慧远","text":"一二三，四五六，萨达麻绳难辨的。\n翻身掷地向人前，鼻孔眼睛俱突出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十八","author":"释慧远","text":"腐韝架壁本无情，致雨兴雷自有因。\n倾倒十年放火口，高谭一夜动公卿。\n林长老，久相亲，楚语吴歌曲调新。\n羚羊已挂悬崖角，猛虎难藏露地身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十一","author":"释慧远","text":"平生学弄蛇，是蛇皆可弄。\n唯有遮一条，咬人不可动。\n轻轻动便觉，和身入草蓬。\n草蓬深，无处寻，不用寻。\n好水好山留不住，千岩万壑听龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十九","author":"释慧远","text":"虎穴魔宫阔步挨，犁耕拔舌待君来。\n摩云鼻孔须胡口，闹里相逢鬼擘开。\n不离刀山居马腹，便从炉炭入驴胎。\n一句子，不须猜，延宾岂在预安排。\n换手搥胸何处去，虾蟆头上戴青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十四","author":"释慧远","text":"道大兮功不立，隅无兮方莫存。\n跨鳌头兮归巨海，挟月角兮出天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十九","author":"释慧远","text":"金地岭胸中丘壑，赤城山皮里阳秋。\n华顶峰脑门著地，桐柏观稽首叩头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○三","author":"释慧远","text":"正如穷汉破衫袖，也不与万法为侣。\n捺著头，掀尾举，西江吸尽铁船浮，活捉泥牛和角煮。\n泼天大，些子许，君不见二月三月寒食天，桃花杏花落如雨。\n一口吸尽西江水，栗棘金圈饶得底。\n解道心空及第归，此去西天十万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十二","author":"释慧远","text":"锦江巨浪连三峡，九陇峰高接五天。\n中有导师口生角，眉毛落尽脚跟穿。\n击得嘉州石佛眼中火出，惊回陕府铁牛鼻孔生烟。\n阿呵呵，莫怨天。\n有利无利，不离行市。\n伸手缩手，无党无偏。\n酽茶三五碗，意在钁头边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十","author":"释慧远","text":"十月今朝又初一，丛林正值开炉日。\n打斋卖饭也寻常，残杯冷炙谁能吃。\n天无门，地无壁。\n葫芦棚上种冬瓜，两手扶犁水过膝。\n跳金圈，吞栗棘，毡拍板对无孔笛。\n屈屈，独脚山魈解双踢。\n去年冬里无炭烧，今年定是无火炙。\n饥时饥到眼睛黄，穷时穷至赤骨力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六","author":"释慧远","text":"黄面瞿昙，虽则分疏应口。\n车不横推，文殊仗剑逼佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十九","author":"释慧远","text":"两阵交锋笑似嗔，双眉倒卓眼生筋。\n溪山云月谁为侣，南北东西绝近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十三","author":"释慧远","text":"当年四月初八，老胡旧病再发。\n云门遇水脱鞋，且莫随佗孟八。\n九龙吐水沐金躯，七步周行总不如。\n稽首归依乾屎橛，胡须更撞赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十三","author":"释慧远","text":"久雨不晴，务在丙丁。\n修罗合掌，菩萨生瞋。\n佛也不会，波斯转经。\n拗直作曲，弄假像真。\n好是明明说与，从教鸭听雷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十一","author":"释慧远","text":"今朝四月八，邪师坏正法。\n累及释迦文，死水里淹杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十四","author":"释慧远","text":"毗耶离瞎人撞彩，摩竭陀哑子吃瓜。\n新长老到遮里，棒头开正眼，拳下作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十四","author":"释慧远","text":"一雨洗郊原，千山锁寒色。\n底事不须论，元胡口门窄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十七","author":"释慧远","text":"阿呵呵，也大奇，折臂脩罗舞柘枝。\n急如闪电，疾如飞毛，■翣眼迷痴，得便宜是落便宜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十二","author":"释慧远","text":"堂前开饭店，屋里贩扬州。\n南泉翻盐落酱钢，赵州老鼠入牛角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十","author":"释慧远","text":"建山徐廷干，三请谭般若。\n未跨浮山门，一时说了也。\n更开破天口，塞破太虚空。\n潭南湘之北，赵州西院东。\n掷下金刚圈，更饶栗棘蓬。\n百千万亿个，吞跳无有穷。\n幸有当阳险崖句，山僧不敢重下注。\n月里麒麟笑揭天，泥牛拔断珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十九","author":"释慧远","text":"一尘入正受，诸尘三昧起。\n诸尘入正受，一尘三昧起。\n三昧与正受，门檈作碓觜。\n起灭无定时，恰如眼见鬼。\n正受非正受，云何作道理。\n一去寥寥七百年，下载清风今未已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十","author":"释慧远","text":"庵内不知庵外事，铁额铜头不相似。\n定花板上打鞦韆，猛虎舌头书卐字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十九","author":"释慧远","text":"一粒红稻饭，几滴牛领血。\n凭君子细看，我亦难分雪。\n耕者耕未已，种者种不歇。\n目望九霄云，谁顾三伏热。\n秋收政其时，全在要精洁。\n升合等平分，彼我言词绝。\n暗室不可欺，吃水也防噎。\n上人饱法味，道眼能昭彻。\n归来满钵香，坐断水云舌。\n金毛恣翻踯，异兽潜深穴。\n栗棘金刚圈，略不通水泄。\n百草头边著眼看，七星用处当风截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十五","author":"释慧远","text":"弯弯初生如櫜弓，团团次第漾悬镜。\n人间起舞争清辉，影落秋江验邪正。\n圆也缺也乌足论，体也用也谁能分。\n潦倒南泉没碑记，夜随流水绕孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十六","author":"释慧远","text":"我闻禅师，荣领天竺。\n山色湖光，争辉夺日。\n佛法禅道，日月灯烛。\n眼放电光，机逾臂竹。\n说云门禅，如珠走盘。\n唱无生曲，铿金戛玉。\n千眼洞明，万机攒簇。\n佛祖并驱，水云叠足。\n掣颠掣狂，可记可录。\n诳嚇闾阎，鼓荡流俗。\n眉毛厮结，形影相逐。\n把手共行，孤峰独宿。\n彼上人者，难继高躅。\n因甚如此，为佗牵犁入市，骑牛上屋。\n七九从来八十三，六六何曾三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄超然居士","author":"释慧远","text":"瀫水一言亲领略，桐城千里重相闻。\n节角誵讹斩新句，不知居士与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄㑃堂仁和尚","author":"释慧远","text":"一击当机，千圣莫窥。\n佩无文印，著粪扫衣。\n踞魔王殿，开邪见扉。\n说禅说道，恶口臊齿。\n论心论性，撒屎撒尿。\n牵犁上树，拗折称锤。\n抗戾佛祖，倒行逆施。\n不是㑃堂，更是阿谁。\n曲罢酒阑人不会，断肠依旧画娥眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪峰和尚赞","author":"释慧远","text":"三回访道投子，九度亲到洞山。\n末后最初非句，从教盖地盖天。\n三个木毬开鬼眼，无端羁锁落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸿福普同塔","author":"释慧远","text":"海底红尘起，山头白浪飞。\n若能如是会，永劫堕泥犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化和尚赞","author":"释慧远","text":"热发风狂，趯倒饭床。\n挨脚脱漏，倒翻筋斗。\n坏佗临济一生禅，哑却盘山三昧口。\n有时好，未必好。\n有时恶，未必恶。\n有时把个破木铎。\n大悲院里赶村斋，直至而今无摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十八","author":"释慧远","text":"师子哮吼，象王回旋。\n左顾右盻，七穴八穿。\n平地和声便拶，等闲㪍跳上天。\n筑著梵王香案，然后退身归本位，叉手而立。\n自云法徽伏候台旨，未敢自专。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其七","author":"释慧远","text":"祝发何早，闻道何晚。\n出林猛虎靠山，当路毒蛇开眼。\n重不重漏泄，拟不拟便著。\n借问吕望六韬，何似黄公三略。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十七","author":"释慧远","text":"道出古今，法超闻见。\n雨骤云驰，星移斗转。\n梦魂历尽百城馀，觉后端知一物无。\n打鼓看来君不见，拈花笑杀老臊胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]