[{"title":"玉楼春 其六 冬日上江西漕鲁大卿","author":"石孝友","text":"汉皇受禅新尧统。\n沼跃潜鱼仪舞凤。\n五云色备观台书，万世功成贤相用。\n江湖襟带蛮荆控。\n摩抚民劳输土贡。\n愿倾石尉望尘心，来献鲁侯难老颂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其二","author":"石孝友","text":"春生泽国芳菲早。\n楼外墙阴闻语笑。\n东君著意到西园，点破施朱浑未了。\n楚云暮合吴天杳。\n天色沈沈云扰扰。\n洞门深闭月轮孤，不见当时张好好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其四","author":"石孝友","text":"扁舟破浪鸣双橹。\n岁晚客心分万绪。\n香红漠漠落梅村，愁碧萋萋芳草渡。\n汉皋佩失诚相误。\n楚峡云归无觅处。\n一天明月缺还圆，千里伴人来又去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其八","author":"石孝友","text":"黄钟应律扶炎统。\n舜日迎长佳节用。\n娟娟芳意著花梢，盎盎暖香浮酒瓮。\n寿觞唤取纤纤捧。\n雨歇珠帘云绕栋。\n兴来且伴橘中仙，归去却联池上凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其五","author":"石孝友","text":"井花暖处新阳动。\n节物撩人添倥偬。\n寒齑冰齿晕轻澌，败絮粟肌悭短梦。\n文章彻了成何用。\n闷拨炉灰窥饭瓮。\n寻思已得到春时，预把五穷连夜送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其七","author":"石孝友","text":"一阳不受群阴壅。\n残历行间冬破仲。\n云低吹白腊寒浓，梅小绽红春意重。\n湖山千里勤飞控。\n淑气冲融披水冻。\n笑携雨露洒民心，暗聚精神交帝梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其九","author":"石孝友","text":"台门瑞霭光阳动。\n人语鼓声沈汹汹。\n观风堂迥暗香飘，卷雨楼前寒翠拥。\n锋车促入承天宠。\n丹诏衔来须彩凤。\n五丝宫线日边长，看补岩廊龙衮缝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其三","author":"石孝友","text":"风光澹沲云容粹。\n点染园林添况味。\n花间照夜簇红纱，柳外踏青摇彩旆。\n芳时不分空憔悴。\n抖擞愁怀赊乐事。\n罗衫一任涴尘泥，拼了通宵排日醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 其一","author":"石孝友","text":"小桃破尽风前萼。\n草草年华闲过却。\n十分清瘦有谁知，一点相思无处著。\n书凭雁字应难托。\n花与泪珠相对落。\n万红千翠尽春光，若比此情犹自薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"传言玉女","author":"石孝友","text":"雪压梅梢，金袅柳丝轻敛。\n锦宫春早，乍风和日暖。\n华国翠路，九陌绮罗香满。\n连空灯火，满城弦管。\n月射西楼，更交光照夜宴。\n万人拥路，指鳌山共看。\n花旗翠帽，到处朱帘高卷。\n归时常是，漏残银箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近","author":"石孝友","text":"微雨洒芳尘，酝造可人春色。\n闻道梦云楼外，正小桃花发。\n殷勤留取最繁枝，樽前待闲折。\n准拟乱红深处，化一双蝴蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近","author":"石孝友","text":"幸自得人情，只是有些脾鳖。\n引杀俺时直甚，损我儿阴德。\n情知守定没乾休，乾休冤俺急。\n今夜这回除是，有翅儿飞得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其二","author":"石孝友","text":"风猎乱香如扫。\n又是粉梅开了。\n庭户锁残寒，梦断池塘春草。\n情悄。\n情悄。\n帘外数声啼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其一","author":"石孝友","text":"照水粉梅开尽。\n春残峭寒犹甚。\n秋气著人衣，斗帐玉儿生晕。\n那更。\n那更。\n帘外月斜风横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 其三","author":"石孝友","text":"折寄陇头春信。\n香浅绿柔红嫩。\n插向鬓云边，添得几多风韵。\n但问。\n但问。\n管与玉容相称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其一","author":"石孝友","text":"青青杨柳水边桥。\n水迢迢。\n柳摇摇。\n缓引离觞，频驻木兰桡。\n我是行人君是客，俱有恨，总无聊。\n冰澌波暖数琼瑶。\n舞晴飙。\n拂春潮。\n一片别魂，销尽遣谁招。\n不似严阳山上雪，魂易尽，雪难销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其二","author":"石孝友","text":"相逢执手也踟蹰。\n立斯须。\n话区区。\n借问来时，曾见那人无。\n忍泪啼痕香不减，虽少别，忍轻辜。\n霜风摇落岁将徂。\n景凋疏。\n恨萦纡。\n过尽行云，我在与谁居。\n一掬归心飞不去，层浪叠，片蟾孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行香子","author":"石孝友","text":"你也娇痴。\n我也狂迷。\n望今生、永不分离。\n如何别后，三换梅枝。\n是好相知，不相见，只相思。\n良辰美景，赏心乐事，□□□负我辜伊。\n凤弦再续，鸾鉴重窥。\n且等些时，说些子，做些儿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西地锦","author":"石孝友","text":"回望玉楼金阙。\n正水遮山隔。\n风儿又起，雨儿又煞，好愁人天色。\n两岸荻花枫叶。\n争舞红吹白。\n中秋过也，重阳近也，作天涯行客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其二","author":"石孝友","text":"脉脉无端心事，厌厌不奈春酲。\n越罗衫薄峭寒轻。\n试问几番花信。\n万点风头柳絮，数声柳外啼莺。\n斜阳还傍小窗明。\n门掩黄昏人静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其一","author":"石孝友","text":"歌彻秋娘金缕，醉扳织女云车。\n而今谁复荐相如。\n拔剑茫然四顾。\n好景凭诗断送，闲愁著酒消除。\n镜中丝发莫惊呼。\n春满珠帘绣户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"石孝友","text":"拽尽风流露布，筑成烦恼根基。\n早知恁地浅情时。\n枉了教人恁地。\n惜你十分撋就，把人一味禁持。\n这回断了更相思。\n比似人间没你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"石孝友","text":"烛花吹尽篆烟青。\n长波拍枕鸣。\n西风吹断雁鸿声。\n离人梦暗惊。\n乡思动，旅愁生。\n谁知此夜情。\n乱山重叠拥孤城。\n空江月自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更漏子 其一","author":"石孝友","text":"亸吟鞭，欹醉帽。\n行尽关山古道。\n霜满地，水平田。\n雁儿声在天。\n北沙门，南浦岸。\n望得眼穿肠断。\n桐树巷，梦云楼。\n玉儿应也愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更漏子 其二","author":"石孝友","text":"烛销红，窗送白。\n冷落一衾寒色。\n鸡唤起，马驰行。\n月昏衣上明。\n酒香唇，妆印臂。\n竟夜人人共睡。\n魂蝶乱，梦鸾孤。\n知他睡稳无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花天 借朱希真韵送司马德远","author":"石孝友","text":"把杯莫唱阳关曲。\n行客去、居人恨局。\n屏山似展江如簇。\n不见尊前醉玉。\n鹃啼处、怨声裂竹。\n问后夜、兰舟那宿。\n帛书早系征鸿足。\n肠断弦孤怎续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜行船 其一","author":"石孝友","text":"昨日特承传诲。\n欲相见、奈何无计。\n这场烦恼捻著嚎，晓夜价、求天祝地。\n教俺两下不存济。\n你莫却、信人调戏。\n若还真个肯收心，厮守著、快活一世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜行船 其二","author":"石孝友","text":"漏永迢迢清夜。\n露华浓、洞房寒乍。\n愁人早是不成眠，奈无端、月窥窗罅。\n心心念念都缘那。\n被相思、闷损人也。\n冤家你若不知人，这欢娱、自今权罢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝鼎现 上元上江西刘枢密","author":"石孝友","text":"雪梅清瘦，月桂圆冷，天街新霁。\n想帝辇、三朝薄暮，催促烛龙开扇雉。\n正拜舞、捧玉卮为寿，花满香铺凤髓。\n罄禹穴、胥涛万顷，春入南山声里。\n鼎轴元老诗书帅。\n体宸衷、双奉亲意。\n勤色养、行春惜花，夜欢宴、瑶池衣彩戏。\n鼓淑气、遍湖山千里。\n惊破悭红涩翠。\n笑那个痴儿无赖。\n打得金鱼坠地。\n休念太守当年，曾手把青藜照字。\n对珠帘云栋，收拾太平歌舞辍。\n庆母爱、小宽王事。\n馀沥□肠，看不日、归步沙堤，又赞重华孝治。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其一 上洪帅王予道生辰正月十六日，用东坡韵","author":"石孝友","text":"半千宝运，瑞清朝、诞育人间英物。\n暖律吹灰春到也，迟日光腾东壁。\n婺女双溪，沈郎八咏，辉映皆冰雪。\n储精毓秀，几年一个人杰。\n须信和气随人，粉梅欺黛柳，娇春争发。\n翠幕重重称寿处，莲炬蕙烟明灭。\n鼎席犹虚，九重频念此，衮衣华发。\n明年今夜，凤池应醉花月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其二","author":"石孝友","text":"闷红颦翠，惜流年、忍对艳阳时节。\n白玉楼成人去后，两地音尘都绝。\n鸾鉴分飞，梦云零乱，欢意今衰飒。\n墨痕红淡，忆曾题遍红叶。\n须信后约难凭，臂啮鬟剪，也只成虚说。\n满眼凄凉无限事，付与丁香愁结。\n欲语情酸，临岐步懒，怅望兰舟发。\n出门谁伴，泪昏一片孤月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其五 上德安王文甫生辰","author":"石孝友","text":"麦秋天气，正玉杓斡暑，熏弦鸣律。\n浴佛生朝初过也，还数佳辰三日。\n筮水呈祥，梦熊叶庆，宝运符千一。\n太平朝野，异人端为时出。\n须信家世蝉联，乃翁遗范在，子孙逢吉。\n雾隐巢云聊寄傲，行矣飞英腾实。\n瀑布泉清，炉峰气秀，光映霞觞溢。\n萱堂争看，彩衣红堕双橘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其三","author":"石孝友","text":"平湖阁上，正残虹挂雨，微云擎月。\n万顷琉璃秋向冷，忍便翠销红歇。\n北海樽罍，西园游宴，兴逸湖山发。\n飞尘不到，坐移蓬岛珠阙。\n莫厌笑口频开，少年行乐事，转头胡越。\n公子多情真爱客，敢惮深杯百罚。\n太一舟轻，芙蓉城锁，醉指神仙窟。\n乘风归去，尽教吹乱华发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画堂春","author":"石孝友","text":"寒蛩切切响空帷。\n断肠风叶霜枝。\n凤楼何处雁书迟。\n空数归期。\n□□沈腰春瘦，却成宋玉秋悲。\n又还辜负菊花时。\n没个人知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案","author":"石孝友","text":"征鸿过尽秋容谢。\n卷离恨、还东下。\n剪剪霜风落平野。\n溪山掩映，水烟摇曳，几簇渔樵舍。\n芙蓉城里人如画。\n春伴春游夜转夜。\n别后知他如何也。\n心随云乱，眼随天断，泪逐长江泻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其四","author":"石孝友","text":"枕上莺声初破睡，峭寒轻透帘帏。\n起来惆怅有谁知。\n雨狂风转急，揉损好花枝。\n薄幸别来春又老，等闲误却佳期。\n斜阳影里立多时。\n远山何事□，相对蹙修眉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其三","author":"石孝友","text":"买笑当歌何处好，小楼四面江山。\n玉梅枝上卸馀寒。\n雨随春到急，风向晚来颠。\n任自腰围都瘦损，肯教欢意阑珊。\n引杯相属莫留残。\n花如人竞好，人与月争圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一","author":"石孝友","text":"一霎狂云惊雨过，月华恰到帘帷。\n槛前叠石翠参差。\n洞房相见处，灯火乍凉时。\n睡玉眠花愁夜短，匆匆共惜佳期。\n风梧不动酒醒迟。\n好同蝴蝶梦，飞上凤皇枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其五","author":"石孝友","text":"常记梦云楼上住，残灯影里迟留。\n依稀绿惨更红羞。\n露痕双脸泪，山样两眉愁。\n数片轻帆天际去，云涛烟浪悠悠。\n今宵独宿古江头。\n水腥鱼菜市，风碎荻花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二","author":"石孝友","text":"醉袖吟鞭行色里，帽檐低处风斜。\n晚山一半被云遮。\n残阳明远水，古木集栖鸦。\n暮去朝来缘底事，不如早早还家。\n曲屏深幌小窗纱。\n翠沾眉上柳，红揾脸边花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亭前柳","author":"石孝友","text":"有件伡遮，算好事、大家都知。\n被新冤家矍索后，没别底，似别底也难为。\n识尽千千并万万，那得恁、海底猴儿。\n这百十钱，一个泼性命，不分付、待分付与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子","author":"石孝友","text":"梅雪弄芳馨。\n饯日迎辰契月蓂。\n争着琴堂称贺处，娉婷。\n满捧霞觞璨鲤庭。\n鹤等更龟龄。\n八十仙翁醉复醒。\n好倩洛阳驰誉手，丹青。\n乞与人间作寿星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其二","author":"石孝友","text":"草色裙腰展，冰容水镜开。\n又还春事破寒来。\n一夜东风吹绽、后园梅。\n糯瓮篘香酿，熏炉续麝煤。\n休惊节物暗相催。\n赢取大家沈醉、探春杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其五","author":"石孝友","text":"春浅梅红小，山寒岚翠薄。\n斜风吹雨入帘幕。\n梦觉南楼、呜咽数声角。\n歌酒工夫懒，别离情绪恶。\n舞衫宽尽不堪著。\n若比那回、相见更消削。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其四","author":"石孝友","text":"畴昔飞鸾侣，而今断雁行。\n西风岭外下斜阳。\n无赖一钩新月、挂人肠。\n双泪沾襟袖，孤灯对客床。\n枕馀衾剩只残香。\n别得娇痴不睡、也思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其一","author":"石孝友","text":"蚁酒浮明月，鲸波泛落星。\n春花秋叶几飘零。\n只有庐山君眼、向人青。\n明日非今日，长亭更短亭。\n不辞一饮尽双瓶。\n争奈秋风江口、酒初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其六","author":"石孝友","text":"乱絮飘晴雪，残花绣地衣。\n西园歌舞骤然稀。\n只有多情蝴蝶、作团飞。\n旧事深琴怨，新愁减带围。\n倚楼凝望更依依。\n怕见一天风雨、卷春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其三","author":"石孝友","text":"凤髻斜分翠，鸳鞋小砑红。\n东君著意绮罗丛。\n最好一枝特地、怨春风。\n懊恨无情语，娇羞忍笑容。\n相看疑是梦魂中。\n怕逐飞云归去、断行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"品令","author":"石孝友","text":"困无力。\n几度偎人，翠颦红湿。\n低低问、几时么，道不远、三五日。\n你也自家宁耐，我也自家将息。\n蓦然地、烦恼一个病，教一个、怎知得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青","author":"石孝友","text":"云髻盘鸦。\n眉山远翠，脸晕微霞。\n燕子泥香，鹅儿酒暖，曾见来那。\n秋光已著黄花。\n又恰恨、尊前见他。\n越样风流，恼人情意，真个冤家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌","author":"石孝友","text":"芙蓉院宇，露下秋容瘦。\n龟鹤仙人献长寿。\n问蓬山别后，几度春归，归去晚，开得蟠桃厮勾。\n人间游戏好，鲸背风高，那更相将凤雏九。\n事苹蘩，工翰墨，才德兼全，人总道、古今稀有。\n尽从他、乌兔促年华，看绿鬓朱颜，镇长依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其一","author":"石孝友","text":"霁景澄秋，晚风吹尽朝来雨。\n夕阳烟树。\n万里山光暮。\n一带长川，自在流今古。\n人何处。\n月波横素。\n冷浸蒹葭浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其四","author":"石孝友","text":"杨柳腰肢，春来尚怯铢衣重。\n眼波偷送。\n笑把花枝弄。\n雨帐云屏，一枕高唐梦。\n春情动。\n殢人娇纵。\n困亸钗横凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其六","author":"石孝友","text":"日薄风迟，柳眠无力花枝妥。\n燕楼空锁。\n好梦谁惊破。\n寒食清明，又等闲都过。\n愁无那。\n泪珠频堕。\n洒尽相思颗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其三","author":"石孝友","text":"著意栽银，砌成叶叶莲花舫。\n醉霞摇荡。\n恰似凌波样。\n自笑平生，鲸吸洪波量。\n孤心赏。\n不如深幌。\n一搦酬千想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其二","author":"石孝友","text":"缓解罗裳，十分鸳履低腰素。\n冰香微度。\n一罅殷红露。\n风折芳莲，影落盆池去。\n多羞处。\n怕人偷觑。\n粉面频回顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其五","author":"石孝友","text":"醉倚危樯，望中归思生天际。\n山腰渚尾。\n几簇渔樵市。\n帆落西风，一段芦花水。\n八千里。\n锦书欲寄。\n新雁曾来未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶瓶儿","author":"石孝友","text":"相对盈盈一水。\n多声价、开中得字。\n刚能见也还抛弃。\n负了万红千翠。\n留无计。\n来无计。\n□□□、成何况味。\n而今若没些儿事。\n却枉了、做人一世。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"石孝友","text":"迎客西来送客行。\n堆堆历历短长亭。\n殢人残酒不能醒。\n烟染暮山浮紫翠，霜凋秋叶复丹青。\n凭谁图写入银屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"石孝友","text":"柳岸梅溪春又生。\n风枝斜里雪枝横。\n空牵归兴惹离情。\n灰尽寸心犹自热，泪承双睫不能晴。\n梦云楼隔豫章城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"石孝友","text":"几曲屏山数幅波。\n雁声斜带夕阳过。\n卸帆聊醉菊花坡。\n旅枕梦魂归路远，秋江风紧夜寒多。\n薄情还解忆人么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]