[{"title":"送稻醴与子才","author":"司马光","text":"昔贤尊道谊，置醴待嘉宾。\n今我乐闲放，提壶饷故人。\n蚁浮杯面白，味撇瓮头醇。\n何以助高兴，篱边菊蕊新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重过华下","author":"司马光","text":"昔辞莲幕去，三十四炎凉。\n旧物三峰雪，新悲一镊霜。\n云低秦野阔，木落渭川长。\n欲问当时事，无人独叹伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻龚伯建下第","author":"司马光","text":"文章真长物，堪叹又遗贤。\n利器空埋土，灵光久照天。\n赵锥犹未出，荆璧会须传。\n道在虽穷困，知君不慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"首夏二章呈诸邻 其一","author":"司马光","text":"首夏木阴薄，清和自一时。\n笋抽八九尺，荷生三四枝。\n新服裁蝉翼，旧扇拂蛛丝。\n莎径热未剧，晨昏往来宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭马承之","author":"司马光","text":"平生千里别，书问亦常来。\n隼拂秋云击，鸾兼霏雾回。\n向无高世艺，安见出伦才。\n有纸盈箱箧，扃封不忍开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭刘仲原 其一","author":"司马光","text":"天下才无几，夫君独患多。\n高文粲列宿，英辩泻长河。\n荣宦成朝梦，浮生度尺波。\n旧僚空执酒，相与泪滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭刘仲原 其二","author":"司马光","text":"昔醉金明渚，今来慧辩祠。\n当年笑相视，此日哭殊悲。\n天迥川原净，风高草木衰。\n江梅灵气在，泉下复相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭尚颍","author":"司马光","text":"操业五常备，艰难六极全。\n仲尼难语命，禆灶不知天。\n弱女飘何许，遗文散莫传。\n官轻史不录，后世孰称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日","author":"司马光","text":"穷边已深夏，气色耿清秋。\n鲜旭开山郭，凉烟澹戍楼。\n兜铃烽火息，区脱虏尘收。\n迨此军中暇，无妨文雅游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射堋","author":"司马光","text":"叠鼓花前急，红旌竹外高。\n惊飙分白羽，馀响振乌号。\n壮观倾春陌，欢声涌夜涛。\n因兹刑礼俗，岂独事游遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅宿睢阳南湖","author":"司马光","text":"梁王弃宫馆，时世古今违。\n犹有南湖水，春来雁鹜飞。\n楼台沈倒影，林薄挂馀晖。\n豪侈终何在，行人得暂依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋阳三月未有春色","author":"司马光","text":"天心均煦妪，物态异芬芳。\n上国花应烂，边城柳未黄。\n清明空改火，元已漫浮觞。\n仍说秋寒早，年年八月霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓思","author":"司马光","text":"束带朝尚早，蓬门未脱扃。\n短篱潜落月，老树带孤星。\n隐几貂裘黑，开编竹简青。\n子云非执戟，何以得穷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朔会堂","author":"司马光","text":"朔旦集俺吏，兹堂簪组繁。\n舞空孤鹤下，映日两凫翻。\n花散东方骑，萍浮北海樽。\n须知太守贵，铙吹引朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮醳亭","author":"司马光","text":"曲水华榱下，浮觞去复还。\n浪摇花影碎，日射酒缸殷。\n灭没遥寻客，徘徊怯度湾。\n穷欢不知醉，清泚照心颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别友生","author":"司马光","text":"野际共为别，客亭芳草新。\n何心更执酒，满目尽伤春。\n今古无穷路，东西相背尘。\n行行复回首，不欲着鞭频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别逢吉","author":"司马光","text":"君念承明臭味稀，相逢惜别重依依。\n会稽太守方坐啸，东郭先生还步归。\n乐饮林塘留节物，饯行里舍动光辉。\n双旌回去行人发，一带长皋烟雨微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政杨侍郎挽歌 其二","author":"司马光","text":"忧国心如石，当朝有古风。\n挂冠虽在远，遗札不忘忠。\n飞旐西归洛，新阡背倚嵩。\n还令往来客，下马白杨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政杨侍郎挽歌 其一","author":"司马光","text":"时论归清德，皇心重老臣。\n祖风终鲠直，家学本深淳。\n便殿谈经久，安车就第新。\n如何金未尽，奄忽弃乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政邵少卿挽词","author":"司马光","text":"北固启佳城，东吴霣德星。\n穗帷长寂寞，羽扇遂飘零。\n泉烛千年碧，霜松数寸青。\n馀庆知有在，玉树满阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读汉武帝纪","author":"司马光","text":"方士陈仙术，飘飘意不疑。\n云浮仲山鼎，风降寿宫祠。\n上药行当就，殊庭庶可期。\n蓬莱何日返，五利不吾欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥四章呈钦之尧夫 其四","author":"司马光","text":"六合旷无际，逍遥好纵游。\n放怀同一贯，瞬目即千秋。\n丸遇区臾止，萍随波浪流。\n所之皆自得，何惧亦何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥四章呈钦之尧夫 其一","author":"司马光","text":"结发读经史，疲精非一朝。\n于今成濩落，所幸得逍遥。\n不韪狂心息，难平客气消。\n巢林易为足，窃敢比鹪鹩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭氏园送张仲通出刺棣州","author":"司马光","text":"名园送嘉客，冠盖去倾朝。\n小雨尘微敛，馀寒酒易消。\n雁归春近塞，日上海生潮。\n北道平如掌，东风五马骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱子高挽歌二首 其二","author":"司马光","text":"象设如平昔，升堂不见君。\n尚疑言笑在，忽念死生分。\n清论千秋雪，浮荣一片云。\n泉台多少路，何处复修文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱子高挽歌二首 其一","author":"司马光","text":"炜烨传家学，连翩射策荣。\n走丸过省阁，破竹取公卿。\n埋玉嗟何早，为山惜未成。\n空令泽宫友，相顾泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪子华燕醮厅酒半过赵中令园","author":"司马光","text":"簪裾丞相阁，林沼令君家。\n烟曲香寻篆，杯深酒过花。\n霏微烬沈水，馥郁渍榠柤。\n愧乏相如赋，陪游托后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪始平公燕柳溪","author":"司马光","text":"溪光不动柳风轻，玉帐森沈拥万兵。\n鸥入烟中闲自舞，鱼翻波面喜相迎。\n楼船下视晴天碧，鼓吹前驱远陌清。\n桃李归时应盛发，薰然和气满春城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪致政开府太师留守相公致政内翰燕集辄歌盛美为三公寿皆用公字为韵 内翰","author":"司马光","text":"眉似高僧秀，颜如童子红。\n忠纯汲长孺，高洁夏黄公。\n矫矫辽东鹤，冥冥塞北鸿。\n自誇新酒量，像想百分空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪致政开府太师留守相公致政内翰燕集辄歌盛美为三公寿皆用公字为韵 太师","author":"司马光","text":"独佐成康世，高年有毕公。\n神心降维岳，龟兆告非熊。\n黄阁遵成范，太常书茂功。\n归来保眉寿，恩礼享优隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪致政开府太师留守相公致政内翰燕集辄歌盛美为三公寿皆用公字为韵 相公","author":"司马光","text":"东阁延髦士，西都守别宫。\n不忘如卫武，难老似僖公。\n位貌今虽远，官僚旧忝同。\n开怀尽卮酒，足以厚时风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸君北园乐饮","author":"司马光","text":"浩歌纵饮任天机，莫使欢娱与性违。\n玉枕醉人从独卧，金羁倦客听先归。\n须知会府闲时少，况复边城乐事稀。\n花卉正浓风日好，今年已不负春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"假山","author":"司马光","text":"广汉土平远，已嫌丘壑疏。\n呼工刻岩洞，应手出庭除。\n缥渺神仙宅，嵌空虎豹居。\n人功与天力，秀绝两何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄成都吴龙图同年","author":"司马光","text":"照席烛花暖，随车剑骑寒。\n江山资秀句，风月助清欢。\n政简坤维静，仁深井络安。\n行歌与独酌，岂得并闲官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄扬州侯都监","author":"司马光","text":"木落淮南树，秋风日夜高。\n月临扬子渡，雪捲广陵涛。\n不得同萧散，何因破郁陶。\n空凭尺书速，未解梦魂劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陜西提刑江学士","author":"司马光","text":"明主于庶狱，选才从本朝。\n酂侯三尺律，汉使一封轺。\n郡国清名满，关河古意饶。\n凄凉乘障客，华发日萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄唐州吴辨叔二兄","author":"司马光","text":"方城古称险，远在豫州南。\n近岁污莱辟，新民秦晋参。\n当官诚近厚，获谴亦无惭。\n但惜墙阴竹，归辕几日骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄聂之美","author":"司马光","text":"去岁双毛白，今春一齿零。\n人生浮似叶，客宦泛如萍。\n塞上貂裘弊，天涯海气腥。\n何当占箕颍，萧散并柴扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄清逸魏处士","author":"司马光","text":"乡树三摇落，临风歌式微。\n徒嗟俗缘重，端使素心违。\n茅阁松杉冷，山园药草肥。\n不能如海燕，岁岁一西飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题兴州晁都官东沼沼上有唐郑都官诗刻石","author":"司马光","text":"名郎游胜地，心迹继风流。\n昔为题诗著，今因好事修。\n四山相照映，五马屡淹留。\n想见波光净，依然一片秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题刁景纯藏春坞","author":"司马光","text":"藏春在何许，郁郁万松林。\n永日门阑静，东风花木深。\n主公今素发，野服遂初心。\n时与乡人醉，高歌散百金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题宇文中允所居","author":"司马光","text":"孤宦行直道，栖栖良可悲。\n谁能拂衣去，不待挂冠期。\n经史乃吾友，云山为已知。\n世间青紫贵，尽付两佳儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题李水部浐水别业","author":"司马光","text":"茅茨临素浐，沃野带长林。\n日永一堂静，草生三径深。\n消忧何用酒，为乐不须琴。\n扰扰市朝客，无人知此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题李舍人蒲中新斋","author":"司马光","text":"陇上家声勇气殊，边庭卧鼓欲安居。\n非同王剪私求宅，更似甘宁晚好书。\n剑倚寒窗风淅沥，门无杂客柳萧疏。\n蒲州风土平生爱，为问旁邻地有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题洪州慈济师西轩","author":"司马光","text":"登临传胜绝，怅息未成游。\n山气高凌霁，湖光碧照秋。\n烟疏茶灶迥，灯冷竹房幽。\n安得聊凭槛，萧然洗客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题济源李少卿园亭","author":"司马光","text":"县僻人事少，土肥风物殊。\n杖刊灵寿木，轮裹溴梁蒲。\n竹不减淇水，花仍似洛都。\n主公眉雪白，游览未尝扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题钱君倚明州重修众乐亭","author":"司马光","text":"横桥通废岛，华宇出荒榛。\n风日逢知已，湖山得主人。\n使君如独乐，众庶必深颦。\n何以知家给，笙歌满水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题常州东山亭二首 其二","author":"司马光","text":"阀阅崔嵬动四方，入门鸾鹤自成行。\n青緺旧已临佳郡，墨客新归耀故乡。\n醉舞几应摧屐齿，对棋正欲赌香囊。\n阶庭玉树寒相照，更使东山逸气长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题常州东山亭二首 其一","author":"司马光","text":"谢傅英声高可攀，结茅积土想东山。\n常忧胜概一朝尽，岂信风流千古还。\n麈尾蒲葵供永日，酒樽棋局奉欢颜。\n贤侯心迹遥相望，不使兰陵风月闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题傅钦之济源别业","author":"司马光","text":"县郭遥相望，脩篁百亩馀。\n林间清济水，门外太行车。\n道胜随宜足，身闲与世疏。\n何时容命驾，采蕨钓肥鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼静照堂僧","author":"司马光","text":"宝阁灰寒静照新，马啼从此踏京尘。\n金门乞得诗千首，萧寺归时老一身。\n弟子去来浑领袖，交朋存殁半簪绅。\n西风又剪梧桐叶，不见蒲团旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探花桥","author":"司马光","text":"桥边春意近，五马屡徘徊。\n湖水旦暮渌，林花早晚开。\n适因尝酒到，又为赋诗来。\n借问双华表，经过日几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五哀诗 斛律丞相","author":"司马光","text":"君臣日荒宴，歌舞讳言愁。\n老相犹当国，强邻不敢谋。\n谣言虽未出，奸谤已先流。\n谁察忠臣意，通宵抱膝忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春病起呈择之治臣","author":"司马光","text":"风日正和柔，身轻喜病瘳。\n懒抛残蠹简，暖脱弊貂裘。\n值客开青眼，逢花忘白头。\n家家好春色，何处可同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨发故关寄逢吉","author":"司马光","text":"画戟衣中趋绛帐，驿亭门外拂征鞍。\n已嗟漂泊三年别，更负从容十日欢。\n暖席未穷谈笑乐，陟冈相望滞留难。\n扬鞭策马几多意，原上秋风作晓寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望日示康广宏","author":"司马光","text":"清晨三绿袍，罗拜北堂高。\n积善因先烈，馀光及尔曹。\n勿矜从事早，当念起家劳。\n修立皆由己，何人可佩刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅圣俞挽歌二首 其二","author":"司马光","text":"漆灯无复曙，柏径不知春。\n南纪光华减，中朝俊秀贫。\n凄清千古韵，寂寞一丘尘。\n异日昭亭下，方多沥酒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅圣俞挽歌二首 其一","author":"司马光","text":"兵形穷胜负，史法贯兴衰。\n落落虽殊众，恂恂不迕时。\n位卑名自重，才大命须奇。\n世俗那能识，伤嗟止为诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梧桐","author":"司马光","text":"紫极宫庭阔，扶疏四五栽。\n初闻一叶落，知是九秋来。\n实满风前地，极添雨后苔。\n群仙傥来会，灵凤必徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清风台","author":"司马光","text":"太守金闺客，天朝应对才。\n非因板舆恋，宁驾使车来。\n水鉴秋毫尽，霜锋错节开。\n清风偏千里，不独此高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清燕亭","author":"司马光","text":"波澄荫群木，永日湛清华。\n碧筱静秋色，白蘋低晚花。\n松声工醒酒，泉味最便茶。\n外事付丞掾，无妨风景嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"司马光","text":"楚岸橘花香，扁舟泛渺茫。\n短蓑冲密雨，素发净秋霜。\n烟外鸣桹远，波间掷线长。\n无人识名姓，击楫入沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野庙","author":"司马光","text":"古庙崩榱在，墙间杂树荒。\n依稀设馀像，寂寞閟祠堂。\n旧日牲豭地，今晨狐兔乡。\n英灵如未灭，何以度凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野菊","author":"司马光","text":"野菊未尝种，秋花何处来。\n羞随众草没，故犯早霜开。\n寒蝶舞不去，夜蛬吟更哀。\n幽人自移席，小摘泛青杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阍吏","author":"司马光","text":"弊车羸马犯尘泥，愁到朱门遍遍辞。\n相国舍人难骤见，将军马监岂相知。\n因循岁月劳何补，颠倒风埃辱固宜。\n惆怅东冈旧陂在，素心空负白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中寻友人不遇","author":"司马光","text":"拥袖犯风雪，驱车行诣谁。\n朱门不可入，素友复难期。\n依世诚多拙，迷方忽自悲。\n褊心终寡合，吾道易参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪霁登普贤阁","author":"司马光","text":"积雪明朝日，山河坐可分。\n崭岩初解冻，片段未归云。\n阔望穷人境，高寻俯雁群。\n开门枝鸟散，玉絮堕纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆宿遇雨怀诸同舍","author":"司马光","text":"佳雨濯烦暑，翛然生晓凉。\n森沈殿瓦碧，羃历井苔苍。\n院静杉篁秀，人闲钟鼓长。\n凭谁同把酒，清兴窅相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄甘","author":"司马光","text":"黄金缀缥蒂，摇落楚江涯。\n采助杯盘胜，羞将橘柚偕。\n时移香不变，物远味尤佳。\n欲种沧洲树，何年此意谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]