[{"title":"雨中见花戏呈伯庸秋曹","author":"赵抃","text":"脸红消尽泪阑干，似向人前欲诉难。\n若是东君与为主，肯教风雨尽摧残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和勉三兄","author":"赵抃","text":"求贤在昔常推毂，访道当年亦顾庐。\n圣旦光华今吁俊，长卿无苦叹贫居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题隐者邵醇郊居","author":"赵抃","text":"驱车乘兴谒先生，十里秋光照眼明。\n净室寒窗无长物，道书狼籍古琴横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠濮阳高蒙处士","author":"赵抃","text":"事了还家不记年，三茅俦侣尽真仙。\n恰如少华希夷子，十度花残一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再得成都过华阴","author":"赵抃","text":"孤臣何以报君恩，愿泽坤维轸虑分。\n却笑乖崖懒重去，有诗羞见华山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁壬子至节夕宿两当驿","author":"赵抃","text":"里数二千七百馀，两当冬夜宿中途。\n举朝五往东西蜀，还有区区似我无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过青泥岭","author":"赵抃","text":"老杜休誇蜀道难，我闻天险不同山。\n青泥岭上青云路，二十年来七往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢天彭净慧大师见访","author":"赵抃","text":"庵岩归隐绝纤埃，内外中间安在哉。\n正似无心云一片，等閒随雨出山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅僧重元自青过齐因寄","author":"赵抃","text":"教被山东十稔馀，人人师为指迷途。\n仰天峭绝灵岩峻，万里閒云一点无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈经侍御史禁中牡丹","author":"赵抃","text":"灵根得地占雕栏，禁苑春深奈晓寒。\n烟叶绿舒成翠幄，露葩红耸似朱冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过公安","author":"赵抃","text":"刘郎浦上公安渡，我过高吟老杜诗。\n烟浪几重江几曲，算应风物似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将到荆南先寄胡判官","author":"赵抃","text":"出京曾说会江陵，期在初春恐未能。\n君骑骎骎我帆便，果来同看上元灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬寺僧文昶","author":"赵抃","text":"师昔将名动冕旒，恩光归去照西州。\n如今白首诗随老，字字清风敌素秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾交见报代者","author":"赵抃","text":"惯见河阳县里花，何时归种召平瓜。\n江东正是鲈鱼美，昨夜西风梦到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招刘绛主簿游山","author":"赵抃","text":"青城峰顶更楼台，世界随高俗意开。\n今夜云归有明月，按琴倾酒待公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张俞壁","author":"赵抃","text":"诏书三度落坤维，为白云溪独掩扉。\n我愧俗疏来访道，不逢斜日又空归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自殿院得请知睦州同范御史挽舟过颍寓言 其一","author":"赵抃","text":"颍波清阔接淮沂，人似游山棹似飞。\n酒熟鲈肥何以乐，与公同是故乡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自殿院得请知睦州同范御史挽舟过颍寓言 其二","author":"赵抃","text":"得请天阍出拥麾，旧山东望已心飞。\n君恩欲使乡人宠，犹许峨冠獬豸归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自殿院得请知睦州同范御史挽舟过颍寓言 其三","author":"赵抃","text":"初见遥山横水湄，旧乡依约白云飞。\n还同户部诗中道，终日思归此日归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题云御史舟中偶书","author":"赵抃","text":"遭时致主期尧舜，力道终身致孔颜。\n出处两途公试看，几时能放此心閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和美毗陵鲥鲚之美","author":"赵抃","text":"江南鲥鲚客誇肥，公到常州鲙熟时。\n见说桐江鱼亦好，昔贤多作钓台诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和偶书","author":"赵抃","text":"古人胸臆赋才多，醒自冥搜醉自哦。\n今日淮山且诗酒，不劳贤否问谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵看山","author":"赵抃","text":"到烂哥山即武夷，并舟于此袂将离。\n公来一意苏疲俗，借问闽州知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范御史见鸬鹚与鹭鸶为群因感黑得鱼多","author":"赵抃","text":"二鸟一生汀渚上，已堪图画复赓歌。\n莫将黑白欺人眼，所得旁观不较多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新到睦州五首 观风阁","author":"赵抃","text":"一凭栏望意无穷，民屋连云叠嶂中。\n微术可令民不疚，有惭兹阁号观风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏春亭","author":"赵抃","text":"滂葩浩艳满亭隈，当度芳樽醉看来。\n始信春恩不私物，乱山穷处亦花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高峰塔","author":"赵抃","text":"上石披松十步劳，下窥人物见秋毫。\n嗟谁更向孤峰顶，树塔孤撑碧落高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉亭","author":"赵抃","text":"潺潺朝暮入神清，落涧通池绕郡厅。\n乱石长松山十里，讨源须上玉泉亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌龙山","author":"赵抃","text":"泉石淙淙泻百寻，群峰环翠起春林。\n危巅召雨云先作，不失苍生望岁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新定言怀","author":"赵抃","text":"吾家于衢守于睦，治馀何以乐且閒。\n仙棋一局钓一壑，烂柯山下严陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范都官行后九日奉寄","author":"赵抃","text":"湖平风稳送归航，望隔严滩七里长。\n更上高峰尽高处，黄花新酒醉重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜十二弟登第","author":"赵抃","text":"景祐初余唱第归，入门逢尔正儿嬉。\n如何二十二年后，继得蟾宫桂一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新定筵上","author":"赵抃","text":"衣紫金鱼耀服章，桐庐太守捧壶觞。\n邦人闻道南来贵，观者浑如入射场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶纾太博惠砚二首 其一","author":"赵抃","text":"遗我佳篇字字珍，更兼山骨琢磨新。\n古贤最重琼瑶意，持报曾同砚席人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶纾太博惠砚二首 其二","author":"赵抃","text":"多谢君诗重见珍，砚从黟水濯来新。\n持当夏昼南窗看，玉发光辉冷照人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵范师道龙图三首 其一","author":"赵抃","text":"舍车弭盖争寻胜，坐石携泉旋煮茶。\n可惜湖山天下好，十分风景属僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵范师道龙图三首 其二","author":"赵抃","text":"八月湖平绝越通，桐江烟水乱山中。\n客舟安稳尤为幸，百尺蒲帆一信风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵范师道龙图三首 其三","auth