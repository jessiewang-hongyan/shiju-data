[{"title":"思吴堂","author":"朱之纯","text":"画堂重构一湖中，更述民思渤海公。\n自昔三年留惠政，至今百里诵清风。\n波间?觉欢声别，陌上新传乐事同。\n从此邦人转怀德，悠悠谷水几时穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖斋","author":"朱之纯","text":"平湖十顷水汪洋，得意茅斋且屈藏。\n园种小桃今结子，池栽翠芰更闻香。\n六龟已兆千年瑞，双鹤看呈八月祥。\n居此倏然忘世味，此心尤懒去龙阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客宛陵遇乡人作集句","author":"王吉甫","text":"扬子江头杨柳春，衣冠南渡多崩奔。\n柳条弄色不忍见，东西南北更堪论。\n谁谓他乡各异县，岂知流落复相见。\n青春作伴好还乡，为问淮南米贵贱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送罗正之年兄出使二浙","author":"范钺","text":"紫泥封诏出蓬莱，且指东南倚宪台。\n千里忽惊霜斧去，百城争望锦衣来。\n浙江气象心先到，吴俗奸媮胆欲摧。\n天姥旧山还好在，应寻乡老一裴徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧光亭","author":"程之邵","text":"寺压高台最上头，一亭新就得清游。\n天连远岫交相碧，地枕长江分外幽。\n烟际晴光浑不断，望中诗思浩难收。\n公馀幸有宾朋乐，聊把狂篇索唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遇雪偶书","author":"程之邵","text":"三伏登途彻盛寒，客程犹未解征鞍。\n明时用舍皆公道，自是非才进路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧落洞","author":"陈履","text":"碧落传闻久，兹来列彦同。\n草沾游士屐，台挹大王风。\n一涧流元始，双崖凿混濛。\n天然自奇绝，不惜五丁功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"廖蒙","text":"叠嶂秋光浅，寒松古韵清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇宁乙酉元巳率同僚修禊于七星岩","author":"张渐","text":"妙意其谁运大钧，玲珑奥室辟天真。\n斗临北地精初结，龙去丹霄穴未湮。\n洪造故教虚待物，良辰赢得乐同民。\n我来禊有自然兴，岂羡兰亭曲水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"上官彝","text":"虎头峭立何巉巉，下有百本松与杉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题方氏清芬阁","author":"朱彦","text":"干戈唐季风尘中，一代文章扫地空。\n先生诗鸣最晚出，句法未减元和工。\n玉壶藏冰不受垢，卜隐宛蹈严陵踪。\n至今名字照人目，直与山水为无穷。\n我舟南纪坐烦促，接岁风波仍转蓬。\n缅怀先生酌溪水，梅花如霰落晚风。\n清芬筑室家有法，亦见裔孙白云翁。\n叔今策得待三接，仲也昔跨御史骢。\n乃翁归来三十载，语笑但觉朱颜红。\n翁不见东飞百劳西飞燕，南飞乌鹊北飞鸿。\n人生游宦正如此，我欲买田归江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题严子陵钓台","author":"朱彦","text":"泊舟钓台侧，敬谒严子陵。\n碧山如佩环，水作锵然声。\n定知千载后，尚复有遗灵。\n长啸明月下，缅怀今古情。\n世利浊于酒，末俗遭尘冥。\n毫发不一直，戈矛岂相争。\n先生得高蹈，万钧独可轻。\n持钓偶自适，潜鱼不吞醒。\n清风在人耳，凛凛见典刑。\n不如台下水，方可濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒光阁","author":"朱彦","text":"驾舟掠杭越，小泊清溪门。\n平生江令尹，邀我溪南园。\n丹碧气成霞，楼疏何郁盘。\n江城春事起，腊候已向残。\n的皪小梅花，暗香媚山樊。\n冰髯绝可爱，青士联苍官。\n君家艺兰畹，岁久兰有荪。\n我生真漫浪，嗜好无一存。\n尚作山水想，十年劳梦魂。\n历眼沧洲趣，兹盟那可寒。\n他年钓竿手，来傍沈郎滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻姑山","author":"朱彦","text":"羽驾龙车旧宅，金炉玉简幽宫。\n双练亭前秋水，七星杉下春风。\n莲沼何年变白，桃源几度翻红。\n明月清阴轩上，星冠羽褐髯翁。\n一弄瑶池新曲，夜寒风入霜松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼","author":"朱彦","text":"麻源山压盱江水，江楼迥对江山起。\n波平月满千里空，金斗栏干露如洗。\n此时想见一尊开，杳杳征帆破浪来。\n挥毫写尽江山景，何有飘零庾信哀。\n自怜久作红尘客，梦断江南烟水白。\n会歌黄鹄赋前溪，不作区区吟越舄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安仁寺","author":"朱彦","text":"一洞寒云锁翠虬，水声长绕影边流。\n令人坐忆南泉路，满目春山几万秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读齐云院碑有感","author":"朱彦","text":"玉像传香火，金钟警旦昏。\n建蓝知有自，种德岂无门。\n善力归慈母，馀波到远孙。\n拂碑今日泪，挥洒旧松根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄弟迪","author":"徐遘","text":"杜云姜被每相思，物换星移又一期。\n知汝再寻鹦鹉赋，起予深念鹡鸰诗。\n山寒久厌猿啼苦，水阔那堪雁到迟。\n好约春风共携手，玉壶沽酒系青丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李公麟画归去来图","author":"陈师锡","text":"百中神锋誇妙手，当时破敌祗因机。\n馀花堕裓无人见，半偈流传岂易知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈师锡","text":"金马旧游三学士，玉麟交政两诸侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈师锡","text":"溪门寂寞无人到，只有清风独自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑池","author":"徐辅","text":"剑去池空水自寒，游人到此凭栏杆。\n年来自是销磨尽，只有青山好静看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱氏天和堂","author":"徐铎","text":"先生晦迹谷水东，志趣不与晋贤同。\n遥听鹤唳笑二陆，巢倾穴碎非为工。\n浩然养素远声利，脱去羁束离樊笼。\n醉隐亭中三十载，桃红李白摇春风。\n感时啸咏聊自适，谁知富贵为穷通。\n羡君高操超流俗，直疑变姓称朱公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏东溪碧波亭","author":"姚孳","text":"赖简池台两蜀誇，东溪别是一仙家。\n令人却忆康王谷，坐看珠帘溅雨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金鸡关","author":"姚孳","text":"甘露灵根不老，尔朱丹灶空存。\n三十六蒙好处，倚栏役破诗魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥","author":"姚孳","text":"万派铿鞫走电车，跨岩蚴蟉玉虹斜。\n灵禽飞下传消息，五百瓯心结茗花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国清寺","author":"姚孳","text":"梵宫四面五峰巑，兜率台高倚翠峦。\n会有寒山重到此，倩谁试与问丰干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸣山岩","author":"林豫","text":"青山招隐桂丛高，五十年来姓字逃。\n春雨晴时星欲洗，晚雷殷处水生涛。\n关门不锁空玄室，花径无媒自碧桃。\n安得飘飖尘外事，胡麻白日饭吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥","author":"楼光","text":"溪流长卷千重玉，茗碗齐开五百花。\n方广只留方寸地，不须辛苦上仙槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过临淄","author":"李格非","text":"击鼓吹竽七百年，临淄城阙尚依然。\n如今只有耕耘者，曾得当时九府钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试院","author":"李格非","text":"斗暄成小疾，亦稍败吾勤。\n定是朱衣吏，乘时欲舞文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至象郡 其一","author":"李格非","text":"裨海环□□，□□□□国。\n世人持两足，遽欲穷畛域。\n心知禹分土，未尽舜所涉。\n吾迁桂岭外，仰亦见斗极。\n升高临大路，邮传数南北。\n山川来时经，草树略已识。\n枝床归梦长，乡堠行历历。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至象郡 其二","author":"李格非","text":"去日有近远，寒暑乃不同。\n手捉而喙饮，嗜欲南北通。\n是邦亦洙泗，人可牛与弓。\n良知尽虚市，妙质老耕农。\n彼时张曲江，此时余襄公。\n二子稍颖脱，一洗凡马空。\n斯文隔裔土，后生昧华风。\n闽中要常衮，剑外须文翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至象郡 其三","author":"李格非","text":"秦扁不南游，医方略岚嶂。\n茅黄秋两淫，与疟盖同状。\n咒师乌能神，适市半扶杖。\n吾欲养黄婆，母壮子亦王。\n妙药只眼前，乞汝保无恙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至象郡 其四","author":"李格非","text":"居近城南楼，步月时散策。\n小市早收灯，空山晚吹笛。\n儿呼翁可归，恐我意惨戚。\n从来坚道念，老去倦形役。\n天其卒相予，休以南荒谪。\n宴坐及此时，聊观鼻端白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句 其一","author":"李格非","text":"步履江村雾雨寒，竹间门巷系黄团。\n犹嫌肮脏惊鱼鸟，父老相呼拥道看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句 其二","author":"李格非","text":"八尺方床织白藤，含风漪里睡瞢腾。\n若无万里还家梦，便是三湘退院僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸太学倡和","author":"李格非","text":"日月天回十二章，诏移清跸幸胶庠。\n六龙稳转桥门曲，多士横穿锦仗行。\n俎豆威仪瞻阙里，东西风教自周王。\n太平谁谓初无象，四海形容在一堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"李格非","text":"邴吉勋劳犹未报，卫公精爽仅能归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"李格非","text":"鲁直今已矣，平生作小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武夷山升真洞","author":"陈觉民","text":"升真洞口接天门，灵草丹桃日日春。\n听说列仙来瑞世，三朝德业在斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五仙观","author":"陈觉民","text":"古木脩篁绝世间，越王台殿作仙坛。\n白羊常在玉虚远，玄鹤不来金井寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄米元章二首 其一","author":"陈觉民","text":"汩汩尘埃阅岁华，青山相见认空花。\n清淮风月元无价，凭仗诗翁为我赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄米元章二首 其二","author":"陈觉民","text":"长淮千古自流东，六月城头日日风。\n天际玉潢无少处，夜山图在明月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈觉民","text":"却忆当年江处士，辞言秋色蔼人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈觉民","text":"吊江为处士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题雪窦和尚亲书偈卷","author":"周仲仁","text":"道人诗句从梁老，笔意峥嵘自一家。\n谁会林间相见事，莫都错看乱飘花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"梁立曦","text":"遗像梁朝佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"广州部人","text":"三年清似镜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贞女峡","author":"欧阳经","text":"退之雄文露天巧，梦得清诗挥秀格。\n迨今声名三百年，文字山水相辉赫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"欧阳经","text":"林青乍听莺声唤，花嫩初笼日影迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"欧阳经","text":"峰头华创占瑰奇，下视湖山迤逦卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"欧阳经","text":"小桃斜映绿杨丝，激水泠泠漾日晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登幼山","author":"罗畸","text":"殿角才馀一握天，我来神骨自飘然。\n影移隐隐烟霞里，身在亭亭日月边。\n脚底拥青寒树杪，面前凝翠乱峰颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"罗畸","text":"几疑银汉馀波溢，浪衮黄金砌畔泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"罗畸","text":"山围碧玉神仙岛，地涌黄金宰相沙。\n丹荔熟时堆锦绣，翠榕空里起龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李宋卿","text":"潮来潮退东西渚，云起云收前后山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蛇首岩","author":"求仲弓","text":"石如蛇首隐林端，未得风雷且蛰蟠。\n俗眼莫嫌无变化，待生头角始堪观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵龟潭","author":"求仲弓","text":"江湖虽阔多罾网，幽涧清虚且勉旃。\n待我功成买双鹤，归来伴汝一千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江渎泛舟和吴中复韵","author":"雍方知","text":"火老金柔尚伏藏，快风收雨送新凉。\n人随竹马来方盛，酒入莲筒特地香。\n春草与谁占梦句，白云空自颂觥觞。\n欲知此日公之乐，正喜西城息亢阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"施子安","text":"蝉唤翠阴声断续，鸟藏红叶响啁啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"施子安","text":"陇云飘软玉，江月洗寒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北山隐居","author":"王拙","text":"负郭萧然筑短墙，北山隐几意悠长。\n静看青草随时换，笑问白云何事忙。\n范蠡浮家终觉晚，刘伶荷锸信非狂。\n楮冠布褐安吾分，那有移文到草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送向综通判桂州","author":"张镆","text":"百里常淹展骥材，除书远自九天来。\n绿油车上扬旌去，画鹢舟中叠鼓催。\n桂岭花光纷似雪，荔江波色渌如苔。\n讼庭尘满无留事，惟伴登临燕席开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"娇娘行","author":"孙次翁","text":"楚宫女儿身姓孙，十五绿鬓堆浓云。\n脸花歌笑艳杏发，肌玉才近红琼温。\n仙源曾引刘郎悟，天教谪下风尘去。\n策金堤上起青楼，照水花间开绣户。\n山阳天下居要冲，春行处处皆香风。\n花名乐府三千辈，惟君第一娇姿容。\n画舫骄马日过门，过者知名求见君。\n侍君颜色肯一顾，方肯延入罗芳樽。\n遏云数声贯珠善，惊鸿舞态流风转。\n不是当朝朱紫人，歌舞筵中难得见。\n朝英国士相欢久，学诗染翰颜兼柳。\n卫尉卿男号富儿，黄金满载来见之。\n朝欢夕宴奉歌酒，春去秋来情愈厚。\n青丝偷剪结郎心，暗发深诚誓婚偶。\n深更不与家人露，藏头掩面随郎去。\n千里相从人不知，鸳鸯比翼凌云飞。\n帝城风物正春色，与郎遍赏游芳菲。\n郎去高堂负父意，父亲惜子情难制。\n六礼安排迎入门，且图继嗣延家世。\n铨行补吏任忠州，整袖长江同溯流。\n瞿塘滟滪遍经历，二年惟爱居蛮陬。\n解官入京重调转，空闺独坐居京辇。\n伤离感疾时召医，无何楚客皆闻知。\n急具高堂报阿母，母怒大发如风雨。\n来见娇娘大嗟怨，怒声肆骂千千遍。\n扶夺上马去如飞，争奈郎踪相去远。\n回到娘家三四春，双眸盈疾愁见人。\n蕙心兰性欲枯死，盘金匣玉都埃尘。\n阿母养身今已报，从今所得多金宝。\n誓心不嫁待郎音，烟波万里难寻耗。\n迩来泛迹渡金陵，住近仪真江外亭。\n北提征辔过花院，分明认得娇娘面。\n旧家云鬓慵理妆，泪裹罗襟金缕溅。\n灯前相顾问行年，一别音容何杳然。\n君今三十未为老，昔时青发今华颠。\n君容若入襄王梦，我才曾试光明殿。\n秋江夜醉话平生，坐抱琵琶船上宴。\n娇娘娇娘真可惜，自小情多好风格。\n只恐情多误尔身，休把身心乱抛掷。\n君不见乐天井底引银瓶，瓶沉簪折争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"石处雄","text":"巨区形胜甲江东，可见全吴泽国雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招题院静照堂","author":"任恬","text":"门掩世喧外，幽栖向此堂。\n一心能自尽，万事即都忘。\n尘冷孤蟾白，庭空异草香。\n何须隐林壑，处处可韬光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招题院静照堂","author":"牟景先","text":"金色成千界，毫光独万缘。\n堂名斯拟象，法眼示通圆。\n座踞轩楹内，明观善恶前。\n吾当除滞见，清信奉周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪","author":"朱正民","text":"阳安多胜概，刘子卜郊居。\n江流清牖户，山列围庭衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]