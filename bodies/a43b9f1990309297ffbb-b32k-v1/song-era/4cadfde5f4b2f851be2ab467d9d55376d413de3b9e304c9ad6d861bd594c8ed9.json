[{"title":"次韵欧阳全真过玉山见寄","author":"赵蕃","text":"祇道欧阳子，行飞入道山。\n报来犹佐幕，书至得开颜。\n过我不相见，底忙成往还。\n未知重回日，端复几年间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵欧阳全真送行","author":"赵蕃","text":"几欲归休反服初，契论今昔更怜渠。\n非关造物相料理，自是吾侪计阔疏。\n似我端宜吏刀笔，如君久合召严徐。\n胡然更作丁宁语，道所经行觅细书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵欧阳伯威见和","author":"赵蕃","text":"宗派滔滔是，于今得障流。\n无悲和者寡，故愈暗中投。\n我愿下取履，君其高卧楼。\n穹冈如许割，肯爱一官休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵欧阳伯威因书见寄","author":"赵蕃","text":"病过一春事，不惟嗟索居。\n酒杯疏到手，药裹每关予。\n曹务宁知马，悲歌岂为鱼。\n故人能枉问，安否报何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑季奕见寄二首 其二","author":"赵蕃","text":"一写山中信，自嗟天外人。\n诗无咏贫士，政岂失穷民。\n已悟哀仍乐，勿论亨与屯。\n我交非势利，宁有白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑季奕见寄二首 其一","author":"赵蕃","text":"暑退伏才末，月明秋又中。\n蛩多喧向夕，蝉寂罢吟风。\n留滞周南事，苍茫阮籍穷。\n寄书无厚禄，犹喜见诗工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵南涧韩先生二首 其二","author":"赵蕃","text":"秋入园林日夜稀，慨然那复更临岐。\n暗中摸索非其物，海内流传会有知。\n岂但文章振吾道，更蕲饥溺济斯时。\n直声旧著尚书履，召节行闻夜席思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵南涧韩先生二首 其一","author":"赵蕃","text":"岁月侵寻两鬓稀，驾言乃复叹多岐。\n陈诗故匪初来识，辱赠何堪谬取知。\n太息先生作今日，顿还诸老在当时。\n倦游已恨归来晚，南涧潺湲日日思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐丞用韵见示","author":"赵蕃","text":"往将短木饰青黄，负此枯林岁久霜。\n穷为多言慕柔舌，病因止酒制刚肠。\n交游大抵要晚节，谈笑可须空累觞。\n净扫松阶决流水，效予清坐亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵晁大舅祖子应","author":"赵蕃","text":"离骚皎皎在湖湘，冀北茫茫失乘黄。\n徒手岂能探虎穴，敝车安得绕羊肠。\n外家文律况吾祖，有作岁时常一囊。\n天遣南来端有意，要须健笔写秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵莫令因迓使者同泛舟至漂神已而误焉问宿临江钟氏之阁二首 其二","author":"赵蕃","text":"璧月俨中悬，村空听悄然。\n借床依树阁，辍棹上滩船。\n物外我怀趣，区中公了缘。\n异时殊出处，安否要诗传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵莫令因迓使者同泛舟至漂神已而误焉问宿临江钟氏之阁二首 其一","author":"赵蕃","text":"我割仅铅刀，公铦比孟劳。\n莫酬谈绝倒，难和句挥毫。\n既误前驱远，不妨乘兴高。\n悠然风月底，脱略异官曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵萧之沈弟","author":"赵蕃","text":"外家人物盛东南，古已云然岂独今。\n兄弟长怀未多识，江湖乃得话同心。\n岂知行日还先我，更枉长吟写意深。\n别后相思回首处，山哀浦思有馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄子耕因任伯起见寄之作","author":"赵蕃","text":"客有能相觅，书来慰我思。\n贫宁可诗罪，老不悟书痴。\n旧友廑长忆，新交曷取知。\n况渠停轨日，政我出山时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远见寄","author":"赵蕃","text":"春今半历未知春，可奈昏昏昼复晨。\n药裹岂能知许病，诗囊亦觉顿成贫。\n羲和送日何其怯，天女司花不解神。\n何但子行无所诣，我怀端亦在湖漘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远晚步见怀","author":"赵蕃","text":"友远弟仍出，柴扃谁复过。\n卷终方独坐，诗至得长哦。\n我乏王杨体，君宁崔蔡多。\n相思欲相觅，马瘦怯陂陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远晨起见示","author":"赵蕃","text":"云行日日候西东，更卜林啼与穴宫。\n乍见天边成四合，不知山脚本来空。\n岂惟吾辈忧艰食，更说军储傒屡丰。\n诏旨已闻汤自责，缺然谏纸疏由衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远雪中见简","author":"赵蕃","text":"粲粲梅开亦大奇，雪来岂亦妒娥眉。\n纷纭八表同昏际，错莫千林欲暗时。\n闭户孰能怜我独，冲泥聊复问君诗。\n穷冬物色无多许，不付吾曹更与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远见寄","author":"赵蕃","text":"近市嫌纷扰，山居取静深。\n俗尘虽远隔，住处阙同临。\n孰愈思君瘦，频来可老吟。\n便应如对面，何止伴孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程士和并帖元衡","author":"赵蕃","text":"满目风埃顿尔清，祇缘朝雨过林声。\n兴乘政欲蝉连语，酒酽才胜一再行。\n容我不应嗔醉卧，忆君还复有诗成。\n定知今夜江东梦，梦炤冰溪雪鬓生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵愚卿留别","author":"赵蕃","text":"有约端能赴，如君信可人。\n解冲衡岳雪，宁问海棠春。\n雨后虽悬榻，泥涂政没轮。\n笑谈能款款，书札胜频频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵签判丈立春日长句","author":"赵蕃","text":"未说麦黄如病人，可堪梅落似残春。\n休论北客惊相叹，试问南公见一新。\n谓恐齐民罹疠疫，又言汉诏发深淳。\n从兹度日能无事，频与传诗慰此贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵签判丈牡丹","author":"赵蕃","text":"长红小白总堪珍，一见名芳叹绝尘。\n畴昔空传醉翁谱，祇今如访洛阳春。\n重跗固已称尤美，径尺真成出斩新。\n好物坚牢世那有，莫嗔采掇付厨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵签判丈喜雪二首 其二","author":"赵蕃","text":"鬓非丝素白，颜是酒争红。\n献瑞吾无与，哦诗且课功。\n要携藜杖出，安得冻泥通。\n事已空梁苑，公今亦醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵签判丈喜雪二首 其一","author":"赵蕃","text":"云蔽初疑雨，云开复似晴。\n北风何自起，南雪骤能成。\n沴气应无作，东郊看有耕。\n怨咨怀往咎，驩喜见今情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬答陈席庆伯见贻二首 其二","author":"赵蕃","text":"问君有赋敌相如，谁为君王诵子虚。\n去岁别家今未返，有亲须养得安居。\n附名愿见先友记，宣布曾传太史书。\n清燕倘思询旧事，莫辞待诏久公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬答陈席庆伯见贻二首 其一","author":"赵蕃","text":"诗成每辄肺肝愁，那与人充耳目谋。\n敢谓老怀千里志，故怜饥作四方游。\n若人尚隐南山雾，老我合从春水鸥。\n旧契百年谈未易，且言家共古扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵魏饶州用蕃唱酬诗卷最后一篇韵见赠之作","author":"赵蕃","text":"世纷往往竞趋奇，半额真同慕广眉。\n我已自知成忤俗，公今岂亦故违时。\n解鞍屡辱留连饮，出袖仍蒙惠好诗。\n异县绝疏亲且故，相从且免问为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次滕彦真韵三首 其三","author":"赵蕃","text":"我欲湘西看，行须觅渡船。\n何如临绝顶，得以尽长川。\n鸥鹭烟云表，蚊虻埃?前。\n隐宁分大小，那更别山廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次滕彦真韵三首 其二","author":"赵蕃","text":"暂作长沙住，侵寻两过年。\n萧然唯壁立，终矣欠蓬编。\n尽室嗟长客，归途喜再缘。\n还家定何许，当在早梅前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次滕彦真韵三首 其一","author":"赵蕃","text":"地接沅湘古，人留屈贾香。\n政须烦胜士，时为发幽光。\n贻我祛愁具，怀君待月章。\n朦胧成少味，失喜见琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毕叔文以双头白莲送程士和录唱酬诗以求次韵","author":"赵蕃","text":"是间何处有涟漪，况复双莲为出奇。\n要使惔焚成一洗，政须冰雪露多姿。\n折来不许从君玩，赋就空能唤我为。\n已见神人出姑射，定烦朝日避咸池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江月","author":"赵蕃","text":"江月照将夕，江风吹欲霜。\n残书看莫尽，病骨凛难当。\n俯仰年龄迈，飘零道路长。\n丰年易图饱，何乃又殊方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤莘夫用孙温叟韵见寄次韵答之","author":"赵蕃","text":"生气千年蔺与颇，生前杯酒事如何。\n谁令误舍清江钓，政尔甘持绝徼戈。\n有句忽成能见忆，感君知我未加诃。\n晚风苦杂蝉鸣树，不谓林莺尚有歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约老谢丈及诸友寻梅","author":"赵蕃","text":"闻道梅花发，山边复水边。\n要穿居士屩，还傍野人船。\n盘礴须穷日，飘零忆去年。\n携壶虽我约，能赋属公先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九度至衡岳呈同游潘文叔二首 其二","author":"赵蕃","text":"衡岳文公寺，南昌梅福官。\n意驰虽若近，身到每疑难。\n社木怅鸣橹，集贤欣解鞍。\n未须论契阔，聊复话团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九度至衡岳呈同游潘文叔二首 其一","author":"赵蕃","text":"荦确浑因石，飕飗半以松。\n秋鸡添老状，老木怯秋容。\n迩日朱张句，当年韩杜踪。\n辞工欠诗本，理到倚谈锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自荔支铺至楠木铺偶成书楠木","author":"赵蕃","text":"勿谓夷邦陋，深行亦或嘉。\n林空闻落叶，涧浅度枯槎。\n蓐食能支午，劳歌不致嗟。\n道边惟驿舍，山后有人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自吉水乘月放舟至玄潭","author":"赵蕃","text":"木叶未尽脱，水光真接天。\n苍然江上石，兀尔渡头船。\n酒有三杯饱，诗无万斛泉。\n冥冥鸿鹄举，渺渺鹭鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自江下徒步至庙山","author":"赵蕃","text":"雪岭模糊积未消，云林烂漫合仍飘。\n一儿跨牸饮田水，几担束梅同负樵。\n泥滓无嗟庙山路，魂栖正避浙江潮。\n污人更尔缁尘远，满眼何无诗思饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自作","author":"赵蕃","text":"素仰儒先德，兼闻内助人。\n齐家真有道，相敬俨如宾。\n女已节义著，儿仍经行醇。\n他年书附传，落落众星陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自宜兴过溧阳","author":"赵蕃","text":"荆溪路入白云径，势与松江相并宽。\n政以楫轻忧逆浪，忽逢风转起飞翰。\n须臾又报一舍过，转盻应无百里难。\n却恨铜官易成远，不容双目细留看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至丰城怀温叟叔异南秀欲题之叔异曲江矶之庵已芜甚矣重增太息","author":"赵蕃","text":"浩浩寒流急，萧萧落木高。\n江山故双剑，人物欠三豪。\n客意已愁绝，风声仍怒号。\n相思意无极，伫立首频搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日","author":"赵蕃","text":"今年至日还为客，堕我侵寻老境中。\n照影不堪诗鬓秃，向人无复酒颜红。\n石田茅屋乡关异，官柳野梅时序同。\n试问一廛何所直，苦令飘泊困西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至节后犹未见梅疑旱使然","author":"赵蕃","text":"败砌初无菊，空林合有梅。\n如何长至后，不见一枝开。\n岂是春渝信，端缘旱作灾。\n蔬畦与麦垄，满目但黄埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至夜读子肃诗卷帖","author":"赵蕃","text":"应接有不暇，幽忧能顿除。\n明当增短日，后且怆离居。\n恨我平生友，翻成咫尺疏。\n为生端不易，作客又何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中病思三首 其三","author":"赵蕃","text":"日脚阴晴屡，船身坐卧俱。\n溪山无入望，羁旅孰为娱。\n路识长安近，名非短策图。\n无迷蔡谟蟹，且觅季鹰鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中病思三首 其二","author":"赵蕃","text":"已见横山塔，兰溪路不多。\n青铜吾欠此，竹叶奈渠何。\n贫病成驱役，幽忧复放歌。\n平生钓台下，老矣负渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中病思三首 其一","author":"赵蕃","text":"桑叶绿已病，枫林黄亦危。\n行舟得秋日，满路入新诗。\n照水惊非昔，临风病不支。\n乾坤一惠施，吾事独多奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中读子进昆仲西游集有怀其人作诗寄之并示成父弟二首 其二","author":"赵蕃","text":"文士今固有，未闻居一门。\n松筠无异操，茧蕙若同根。\n试问临风读，何如把酒论。\n兹行羡吾弟，弭楫向湖村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中读子进昆仲西游集有怀其人作诗寄之并示成父弟二首 其一","author":"赵蕃","text":"君是三珠树，子非两玉人。\n水南留步武，竹隐记风神。\n往者兄同弟，今焉越与秦。\n细哦诗语妙，如款笑谈真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行","author":"赵蕃","text":"下水复上水，暮秋仍早秋。\n暂归非去吏，触绪苦添愁。\n本乏风雅作，谩于山水游。\n经营欲终日，人谓我何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行赋山中梅花","author":"赵蕃","text":"自与松筠并，宁容草棘欺。\n盈盈皆正色，脉脉匪邪思。\n照水初开处，临风欲坠时。\n深幽殊可念，酹酒侑之诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观王文之所藏荆公帖","author":"赵蕃","text":"余行江左路，曾涉蒋山椒。\n野逸思乘蹇，仪型想冠貂。\n帖窥藏五世，诗续咏前朝。\n永日欣无斁，巾攲膝屡摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观田者有感而作","author":"赵蕃","text":"白水田田满，青秧处处高。\n雨滋无复旱，人喜不知劳。\n顾我方羁旅，徒能慕汝曹。\n丰年如可望，贱籴亦多遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观邢园梅偶成长句录呈上饶故人段元衡钧","author":"赵蕃","text":"今年未省赋梅诗，疾病侵陵道路疲。\n两日喜逢新霁后，数株还见欲开时。\n色香于汝宁能尽，心迹如余只自知。\n不是新来苦耽酒，舍渠何以慰支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观贾元放书迹寄其弟季承","author":"赵蕃","text":"古寺荒凉客寓居，闭门百事付乘除。\n学知定力贫非病，诗见新功乐有馀。\n化鹤已空今已矣，骑鲸何处问何如。\n追怀存没伤零落，底事秋来音讯疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访韦丈叔能于严州西溪门外","author":"赵蕃","text":"春王正月附人书，踵报祠官赋遂初。\n到处频成询所寓，忽能为说已谋居。\n苏州旧日诗无敌，严濑从来画不如。\n东馆轻舟虽若驶，可辞蹑履到阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访白鹤山祥云观","author":"赵蕃","text":"白鹤空鸣鹤，祥云祇乱云。\n流传因长老，纪载未前闻。\n步屐欣逢胜，题诗愧不文。\n林园犹午雨，墟落遽斜曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访孙子进子肃于黄堰","author":"赵蕃","text":"茅屋啼鸡日过中，小舟随问曲能通。\n遥遥黄堰忽重到，落落白头今一翁。\n别后每怀音问阔，见时还许笑言同。\n倡予和汝平生事，惆怅春风又起鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访梅殊未有开意","author":"赵蕃","text":"不惮朝寒起杖藜，问梅随往到山蹊。\n枯根半死苔痕剥，细蕾深藏藤刺迷。\n倚市悬知无正态，入空还恐见深挤。\n幽居空谷端可愧，顾叹诗无老手题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"负暄","author":"赵蕃","text":"天公知我寒无褐，惠以檐间百尺裘。\n挟纩固殊如是想，索衣不叹晚为谋。\n神融遽合庄周梦，意气俄乘竹叶舟。\n侧听屋山鸡正午，又愁寒雀暮啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迂斋往葛水道中蚤起有诗见寄次韵答之","author":"赵蕃","text":"桑柘阴中数亩村，病多终日厌昏昏。\n忽传寄我道间作，径欲过君竹下门。\n坐看诸公上台省，谁知陶令在田园。\n文章勋业元难并，未易轻为得失论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过上村庵二首 其二","author":"赵蕃","text":"秀色留金凤，馀芳在木犀。\n日明能皓皓，风急似凄凄。\n野地犹飞蝶，深林亦啼鸡。\n居閒常却扫，安步辍扶藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过上村庵二首 其一","author":"赵蕃","text":"朵朵艳红蕖，丛丛映碧芦。\n秋风见池沼，幽思发江湖。\n爱竹宁询主，行山得当图。\n弟同仍子侄，我友亦相俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过丰城见甘叔异怀孙温叟","author":"赵蕃","text":"剑气当年属斗牛，散为人物尚南州。\n时平未可苏门隐，道在何卑幕府留。\n闻道为贤多受赏，未应此士独遗搜。\n经行不暇穷三径，邂逅羊求询旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]