[{"title":"连云枢老请赞","author":"释妙伦","text":"密运玄枢，恢张要旨。\n名邈得来，成甚面嘴。\n若是金毛狮子子，誵讹岂止三千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净惠教老请赞","author":"释妙伦","text":"霜茁其巅，云横其肩。\n眼无一角，鼻少半边。\n太湖水底走马，洞庭山上撑船。\n天下衲僧名不得状不得，取不得舍不得，一齐唤作教外别传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝藏主请赞","author":"释妙伦","text":"乾之下，坤之上。\n有一宝，无异相。\n刚地描摸出来，便见许多模样。\n引一切人到面前，学算鬼丁帐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治平璧老请赞","author":"释妙伦","text":"似马无騣，似牛无角。\n描摸出来，非常大错。\n错错，万古一崖倚寥廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"若楫请赞","author":"释妙伦","text":"貌兮藓石，形兮云松。\n口捷如哑，耳聪若聋。\n布重网无明山上，荡一楫烦恼海中。\n吽，五日后也有个弄脱空，水底放出泥大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真如靖老请赞","author":"释妙伦","text":"夜叉心，菩萨面。\n动则云翻大野鬼悉惧闻，静则练绕长溪人皆喜见。\n有一道迷魂咒，三千里外学念者也灵验。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"笑堂","author":"释妙伦","text":"冷地无端错喜欢，却将鸱吻对门安。\n引它铁作面皮汉，千里闻风也破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释妙伦","text":"前头计较既不成，后面安排亦不是。\n古时若有今时人，不落他家圈里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释妙伦","text":"狗走抖擞口，猴愁搂搜头。\n瑞岩门外水，自古向西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十一","author":"释妙伦","text":"千寻浪里出头，万仞崖前展手。\n七百甲子老翁，刚然弄一场丑。\n摘杨花，摘杨花，翻身跳上树，惊散暮林鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其二十二","author":"释妙伦","text":"猫弄鼠，猿禁猴，云门固是有杀活机谋。\n检点来，依旧出不得者僧话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其二十一","author":"释妙伦","text":"雪山层层，雪涧冷冷。\n瞿昙过去久矣，今宵谁睹明星。\n奇哉，低声，恐成妄语诳众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其二十","author":"释妙伦","text":"九十日一夏，始终无缝罅。\n拶到末梢头，有个好说话。\n长爪梵志注九经，瞎眼波斯书八卦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十九","author":"释妙伦","text":"云收幽谷静，雨歇幽涧鸣。\n风暖幽鸟语，日融幽草青。\n二祖不知，截断一手臂。\n归宗不会，拭坏双眼睛。\n致使衲僧，个个半疑半信，半醉半醒。\n争知道自来满口，咀华而嚼英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十八","author":"释妙伦","text":"烟迷岸树，水没汀莎。\n渡头拨动钓舟，野鸭翩然飞过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十七","author":"释妙伦","text":"年年是好年，日日是好日。\n南山今日好处又非常，石人起拜木人揖。\n蛇生角，虎插翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十五","author":"释妙伦","text":"将不去，拈不来。\n两个汉，一场呆。\n至今平地上，狼藉覆苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十四","author":"释妙伦","text":"九月九，一句话。\n有准绳，无柄把。\n惟有陶靖节知缝罅，悠然见南山，笑傲东篱下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十三","author":"释妙伦","text":"白蘋洲畔，红蓼岸头。\n渔人得意，拨动孤舟。\n飞起一行两行塞雁，漾开七个八个沙鸥。\n丝纶在手，随放随收，时有金鳞上直钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十二","author":"释妙伦","text":"玉缆纤纤布嫩芽，香苞朵朵依新叶。\n化工底事把天机，剖腹倾心俱漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十","author":"释妙伦","text":"日暖喷庭花，风轻摇岸柳。\n双林入灭老臊胡，至今犹露摩胸手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其八","author":"释妙伦","text":"西风一阵恶，北林平地摧。\n晓猿夜鹤，惊怨空徘徊。\n哀哉哀哉，戒光犹自照高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其七","author":"释妙伦","text":"一遇中秋节，竞赏中秋月。\n指底指，玩底玩，说底说，到了何曾离圆缺。\n惟爱老长沙，一踏踏倒小释迦。\n光灿烂，绝周遮，不知端的落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其五","author":"释妙伦","text":"十五日前，结而不解。\n十五日后，解而不结。\n正当今日，结也休，解也休。\n草鞋对颊耸八耳，拄杖横身撑两头。\n五湖四海衲子为冤雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其四","author":"释妙伦","text":"月临粉壁间尤白，烛入纱笼里更红。\n夜冷井边闻落叶，已惊秋色到梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其三","author":"释妙伦","text":"南山有众盈筹，总是佛祖冤雠。\n一夏资粮尚少，岂容坐视无谋。\n长安城里，芳草渡头。\n赖有作者，为我希求，要使个个饱饫而优游。\n忽然遇维摩居士东指西指，又且如何对酬。\n一言才勘破，笑倒老金牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其一","author":"释妙伦","text":"空兮空兮无背面，拈起豁然成两片。\n搭向南屏山角头，千古万古少人见。\n要见么，金乌飞上琉璃殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十九","author":"释妙伦","text":"红日升兮，慧目明而不晦。\n白云吐兮，慈容露而不遮。\n林木交加兮胸题卐字，峰峦重叠兮足蹑千花。\n好个天然古释迦。\n若谓今朝始诞梵王家，苦哉佛陀耶，苦哉佛陀耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其八十四","author":"释妙伦","text":"辊雪峰毬，打禾山鼓，露柱灯笼齐作舞。\n引得老丰干，倒跨南山虎。\n圣人作，万物睹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其八十二","author":"释妙伦","text":"烟横大野，雁篆长空。\n玉露滴开八枝九枝黄菊，金风剪下三片两片丹枫。\n吾家生涯，虽然冷淡，取之无禁，用之无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其七十九","author":"释妙伦","text":"一竖一展，一放一收。\n仰山弄险，过似岩头。\n赖是随风回橹棹，几乎翻却钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其七十六","author":"释妙伦","text":"门外一犬吠，櫩前一鸟鸣。\n天际半钩新月，移影上疏棂。\n忆得雪山六载，冻不死，饿不杀，夜半见明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其七十四","author":"释妙伦","text":"峰头异角灵毛，涧底锦鳞赪尾。\n各各性命一条，都在山僧手里。\n今日放开线路，也不妨自驰自骤，自飞自鸣，自泳自游，自潜自跃，又阿谁管你，诸方密布漫天网子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其七十二","author":"释妙伦","text":"德山低头，夹山点头。\n俱胝竖起手指头，玄沙?破脚指头，都来不出山僧拄杖头。\n一叶落，天下秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十八","author":"释妙伦","text":"你是川僧，我是浙僧。\n相逢相见，元似不曾。\n因何今日成冤憎，不见道臭肉来蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十七","author":"释妙伦","text":"金佛不度炉，道士念苏嚧。\n木佛不度火，嵩山打灶堕。\n泥佛不度水，钟馗嚇小鬼。\n真佛屋里坐，嗄，赵州老汉败露了也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十六","author":"释妙伦","text":"梨花李花白，杏花桃花红。\n的的正法眼藏，的的古佛心宗。\n灵云老几曾梦见，道得底都是脱空。\n叵耐螺江钓鱼船上翁，丝纶倒把搅春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十五","author":"释妙伦","text":"始从鹿野苑，终至跋提河。\n于是二中间，未尝说一字。\n年年花卉竞芳时，东风一阵成狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十二","author":"释妙伦","text":"宏施韬略，密展谋猷。\n胸中浩气，远迈伊周，玉炉香喷几千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十一","author":"释妙伦","text":"坐底立，立底坐。\n我即你，你即我。\n毕竟烧香礼拜谁，几成话堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十","author":"释妙伦","text":"心心，拙妇穿穴针。\n智智，巫师骂土地。\n道道，矮子肩栲栳。\n佛佛，乌鸦啖腐骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十九","author":"释妙伦","text":"学道参禅，别无方便。\n闹中底静里明，静里底闹中荐。\n坐断两头，打成一片。\n喜欢竖瞋拳，烦恼呈笑面。\n阿呵呵，瑞岩与么道，大似落汤螃蟹，七手八脚一时露现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十七","author":"释妙伦","text":"秋山色老，秋树叶零。\n秋云影乱，秋水波澄。\n伸手缩手，取之不得，开眼合眼，视之无形。\n五湖衲子，披披搭搭，哆哆和和。\n那里秤量，者边匹配。\n瑞岩老汉却不敢与之较重较轻，斤两分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十五","author":"释妙伦","text":"雨?寒食，日酝清明。\n三三两两，呼唤踏青。\n禅家流无处著幽情，倒卓乌藤倚石屏，闲听岩前杜宇一声声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十四","author":"释妙伦","text":"小姑将彩对花缝，半是深青半是红。\n被贼一时偷去了，浑家空自暗搥胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十三","author":"释妙伦","text":"我有一机，觌面提持。\n如击金石，如奏埙篪，不是知音谁共知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十二","author":"释妙伦","text":"庭前新吐一花红，袭袭馨香醉蜜蜂。\n公子见来情兴动，倒吹玉笛弄春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十","author":"释妙伦","text":"宽用工，急著限。\n是也刬，非也刬。\n顶?忽然突出眼，圈圈圞圞，一似古殿里壁角落头破灯盏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十七","author":"释妙伦","text":"禅不用参，道不用学。\n放下更放下，安乐又安乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十六","author":"释妙伦","text":"腊月三十日，一岁已周毕。\n野老竞相呼，把火门外立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十四","author":"释妙伦","text":"雁山云，台峤月。\n或卷或舒，或圆或缺。\n两两三三，朝游暮往。\n袈裟角，拄杖头，挑底挑，裹底裹，不妨自怡自悦。\n若到瑞岩定是打教棒折，而今什么时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十三","author":"释妙伦","text":"一夏已过了，生涯又复然。\n眉毛横眼上，鼻孔搭唇边。\n诸人若果疑情未决，但向冷地里摸索鼻孔看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十二","author":"释妙伦","text":"南泉卖身，只贪小利。\n道吾舞笏，一味鬼戏。\n百丈捲席，翻成钝置。\n赵州吃茶，太煞客气。\n老大隋更是没巴鼻，僧问佛法的的意，却道山前麦熟也未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十一","author":"释妙伦","text":"转身动脚，开口露牙。\n明明是我，的的非它。\n衲僧不肯向省要处受用，甘自区区于道途之上。\n真可惜，诚可嗟。\n瑞岩老婆心切，未免为汝指个歇处。\n便请急急回首，早早归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十九","author":"释妙伦","text":"主人翁，辘辘转。\n有手脚，无背面。\n或向深山里敲冰钓鱼，或向闹市中炙火摇扇。\n堪笑禅和子，长在蒲团上东讨西寻，直是不得一回亲见。\n当此自恣，将何證验。\n瑞岩今夜事不获已，未免擘破面门开个方便。\n秋风一阵晚来寒，吹断白云三四片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十八","author":"释妙伦","text":"小鱼吞大鱼，尾巴露一橛。\n渔翁醉不知，空把丝纶掣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十六","author":"释妙伦","text":"崭崭岩石，蔚蔚松萝。\n左枝右蔓，横牵竖惹，满地交罗。\n几人遭绊倒，反怪葛藤多。\n阿呵呵，跳不出时争柰何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十四","author":"释妙伦","text":"华山突兀耸苍穹，坐断坤维千万峰。\n潘阆骑驴山下过，只闻啼鸟闹春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十二","author":"释妙伦","text":"瑞岩老还债，出生双耳聩。\n扣道道不知，问禅禅不会。\n怕冷收帽裙，爱凉解衣带。\n上下相依不相怪，由来彼此肚皮大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十","author":"释妙伦","text":"水泻岩前，蛩吟砌下。\n问著衲僧，有口如哑。\n百二十日，弄真像假。\n今朝突出拂子头，净裸裸，赤洒洒，没可把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十九","author":"释妙伦","text":"丁出丁，楔出楔。\n老赵州，端的别。\n别别，金刚脑后三斤铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十八","author":"释妙伦","text":"那一通，你问我，玄关倒插无须锁。\n等閒一掣掣得开，三个老婆相对坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十七","author":"释妙伦","text":"三张白纸，千里同风，此是古人吃不尽底涎唾。\n争如瑞岩，将个季春极暄，换个孟夏渐热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十六","author":"释妙伦","text":"圣制中，有一诀。\n上三星，下半月。\n付诸人，须辨别。\n九十日，参教彻。\n参不彻，饮底是洋铜，吞底是热铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十四","author":"释妙伦","text":"三条椽下，七尺单前。\n有一则语，天下衲僧做尽伎俩。\n欲会会不得，拟举举不全。\n瑞岩老婆心切，略与诸人通一线。\n不容意解，只要心传，采石渡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十二","author":"释妙伦","text":"峭峻一方，玲珑八面。\n须弥灯王，有眼者见。\n若不见，随我脚跟转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十一","author":"释妙伦","text":"擒虎兕，辨龙蛇。\n一句子，绝周遮。\n太白不曾登便殿，笔头昨夜自生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其十九","author":"释妙伦","text":"昔年出此门去，步步踏著。\n今日入此门来，头头撞著。\n毕竟以何为验，洎合道著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其十八","author":"释妙伦","text":"来住瑞峰，去住瑞岩。\n未操雪曲，且打乡谈，天上人间一十三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其十七","author":"释妙伦","text":"躘踵几只牯牛，总在瑞峰过夏。\n有心卧月眠云，无意牵犁拽耙。\n溪东溪西，岭上岭下。\n饮水自饮水，吃草自吃草，第一不得犯人苗稼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]