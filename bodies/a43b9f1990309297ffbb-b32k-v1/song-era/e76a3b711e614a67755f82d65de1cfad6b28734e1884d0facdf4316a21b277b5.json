[{"title":"畬田","author":"陶弼","text":"畬田过雨小溪浑，远近云峰互吐吞。\n殊俗易昏三里雾，阳崖忽露一家村。\n桂花香里寻僧寺，榕叶阴中掩县门。\n井税未输兵甲后，心勤抚字且休论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登昆崙台","author":"陶弼","text":"落照古城隅，边风动隼旟。\n久閒忘战略，多病熟医书。\n白发随年短，新情与世疏。\n桃花春水起，还钓旧溪渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞莲池","author":"陶弼","text":"五月红莲繁盛时，隼旟同赏郡南池。\n额名旧载零陵志，碑字新镌子厚诗。\n采药衔杯愁满满，折花行令笑迟迟。\n明年岁熟歌声稳，伴醉清香客是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧湘门","author":"陶弼","text":"城中烟树绿波漫，几万楼台树影间。\n天阔鸟行疑没草，地卑江势欲沉山。\n人过鹿死寻僧去，船自新康载酒还。\n闻说耕桑渐苏息，岭头今岁不征蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶","author":"陶弼","text":"暖翅玉罗薄，香须金线微。\n青春二三月，白日一双飞。\n露重休深入，风高且暂归。\n南园芳树下，燕雀最多机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉石","author":"陶弼","text":"守边无一事，载酒翠崖东。\n几稳平沙上，杯流醉石中。\n野蔬沿涧绿，林果映江红。\n休把鼓钟动，此欢鱼亦同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题阳朔县舍","author":"陶弼","text":"石壁高深绕县衙，不离床衽自烟霞。\n民耕紫芋为朝食，僧煮黄精代晚茶。\n瀑布声中窥案牍，女萝阴里劝桑麻。\n欲知言偃弦歌化，水墨屏风数百家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题烟霞驿","author":"陶弼","text":"歌声野色中，人乐岁时丰。\n暑雨阴阳杂，秋田早晚同。\n岭云无烈日，江树足凉风。\n自指香山语，前村有路通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡州三首 其二","author":"陶弼","text":"秀邑八百里，古今题画难。\n望高三楚近，影转七州寒。\n北拆知蛮尽，南低见斗宽。\n路尽祝融寺，江倾兜率滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山亭","author":"陶弼","text":"诸峰不及此三峰，翠影多年路未通。\n野老传来无地主，神仙留待与山翁。\n雕弓射灭虎狼迹，长剑劈开荆棘丛。\n吏引旌旗先险阻，匠营楼阁出虚空。\n藤萝叶暗初无日，松桂枝新渐有风。\n下濑将军微举职，安南都护远输忠。\n商誇合浦珠胎贱，民乐占城稻谷丰。\n火炬影沉山岸北，潮声流过郡城东。\n四时收印来无定，终日开尊望不穷。\n玉版淡鱼千片白，金膏盐蟹一团红。\n云台志节悲歌外，铜柱封疆醉眼中。\n所惜溪头好崖石，只书诗句不书功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏藕","author":"陶弼","text":"万顷金沙里，谁将玉节栽。\n丝应鲛乞与，津是蚌分来。\n盘贮冰犹结，刀侵雪易摧。\n防风骨外折，混沌窍中开。\n月寺僧家钵，风亭酒客杯。\n胸中秋气入，牙角雨声回。\n自愧尘泥贱，得蒙尊俎陪。\n与君消酷暑，瓜李莫相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荔支","author":"陶弼","text":"五月南游渴，欣逢荔子丹。\n壳匀仙鹤顶，肉露白晶丸。\n色映离为火，甘殊木作酸。\n枝繁恐相染，树重欲成团。\n赤蚌遗珠颗，红犀露角端。\n爽能消内热，润可濯中乾。\n桂岭无霜处，梅天暴雨残。\n□□□□□，□□□□□。\n一簇冰蚕茧，千苞火凤冠。\n隔瓤银叶嫩，透膜玉浆寒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山亭","author":"陶弼","text":"红螺紫蟹新鲈鲙，白藕黄柑晚荔枝。\n酒尽月斜潮半落，山翁不省上船时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五湖亭","author":"陶弼","text":"七堤环绕四城隅，限隔烟波作五湖。\n书吏写供都水帐，画工描入职方图。\n东流满郭湖相似，塞气侵人瘴自无。\n日际诸蛮尽冠带，将军何计学陶朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花有感","author":"陶弼","text":"得莫欣欣失莫悲，古今人事若花枝。\n桃红李白蔷薇紫，问著春风总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会仙岩","author":"陶弼","text":"寂寂长冥洞，涓涓漱玉泉。\n凤笙闻夜半，鹤驭认云边。\n煮茗寻安老，披莎访稚川。\n于中得消息，何用买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合浦还珠亭","author":"陶弼","text":"合浦还珠旧有亭，使君方似古人清。\n沙中蚌蛤胎常满，潭底蛟龙睡不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵器","author":"陶弼","text":"五代乏真主，奸雄纷僭伪。\n横磨阔刀剑，白日相篡弑。\n我宋有神祖，潜德动天意。\n故天意若曰，往为我之嗣。\n神祖拜稽首，乃即皇帝位。\n不惠兆民乐，不怒诸侯畏。\n颠倒执玉帛，奔走恐后至。\n大商国三分，一朝有其二。\n太宗以义抚，真宗以仁治。\n王道竹箭直，诵声金鼎沸。\n独有阴山戎，时时寇边地。\n天子赫斯怒，大警巡澶卫。\n射杀右贤王，遂斩匈奴臂。\n狼心帖然服，结好同昆弟。\n自此两河间，寂寂无戎备。\n卒闲喜夜歌，将老贪春睡。\n自此为太平，恍逾三十岁。\n戎昊乘我间，南驰贺兰骑。\n阳关久夜开，枢朽不可闭。\n阵云起秦雍，杀气横泾渭。\n使臣股栗奏，宰相瞋目议。\n佥曰亟发兵，竖子坑甚易。\n仓皇筑边垒，未战力先瘁。\n遇迫开库兵，土蚀锋芒脆。\n防秋采旧屯，推毂谋新寄。\n旧屯老且死，少者无实艺。\n良由不训练，手足迷击刺。\n新寄将家子，从小生富贵。\n六韬未曾读，口但知肉味。\n师复从中御，进退由阍寺。\n权轻号令冗，两战无遗类。\n曹公弃七军，晋人获三帅。\n吾兵自此丧，有诏新其制。\n此器不预设，一旦从何致。\n朝廷急郡县，郡县急官吏。\n官吏无他术，下责蚩蚩辈。\n耕牛拔筋角，飞鸟秃翎翅。\n簳截会稽空，铁烹堇山碎。\n供亿稍后期，鞭朴异他罪。\n愁氛壅太虚，霁景昼冥晦。\n我闻郭汾阳，料敌多奇异。\n单箠谕突厥，蕃酋双膝坠。\n又闻李西平，临戎有英气。\n身著红锦袍，怀光肝胆碎。\n是知用兵术，在人不在器。\n君耳舜高听，君目舜明视。\n愿采谋略长，勿倚干戈锐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使光亭","author":"陶弼","text":"亭上三峰臂五湖，皇华人到此躇蹰。\n乡民看取黄龙节，郡吏听宣赤凤书。\n南下威如霜落后，抚边恩似雨来初。\n离筵何用银灯烛，自有双星照使车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南岳","author":"陶弼","text":"祝融何峻极，下看白云根。\n绝顶人稀到，诸峰势独尊。\n阔能遮日域，高不避天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭州 其四","author":"陶弼","text":"峡束江盘天影随，轻船双下几危机。\n初晴古木猿三叫，未晚阴崖日半规。\n篁竹数家何处县，清溪一曲几篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宾州二首 其二","author":"陶弼","text":"何处登临好，城楼对万山。\n新青上孤垒，远黑落诸蛮。\n竹引风穿壁，苔随雨上阶。\n有时宁免俗，银烛间金钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"继老堂","author":"陶弼","text":"冷酒十分无客送，轻国一两有民攀。\n将老未闻金作印，师寒犹用铁为衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望安南海口","author":"陶弼","text":"喜逢晴日破阴霾，望极西南瘴海涯。\n夷狄古今常反覆，朝廷终始务绥怀。\n何时良将收铜柱，不日孱王弃?街。\n惆怅藤桥兵死鬼，年年沙上哭坟骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铜雀研","author":"陶弼","text":"得自铜雀台，收晚棱角摧。\n四方绿琉璃，一片青玫瑰。\n炼尽沙石滓，陶成金玉胚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塞上","author":"陶弼","text":"星落胡王死，河穷汉使归。\n雪山经夏冷，天马入秋肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廉州石","author":"陶弼","text":"使君合浦来，示我海滨石。\n千岩秀掌上，大者不盈尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"膏泽峰","author":"陶弼","text":"石壁含天泽，南山第一重。\n旱时先出雨，阴穴又乘龙。\n云影摇诸壑，雷声起半空。\n何当大滂沛，尽活四方农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潮月亭","author":"陶弼","text":"角声吹送小单于，薄雾稀星乍有无。\n坐看月从潮上出，水晶盘里夜明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题阳朔山","author":"陶弼","text":"名山爱阳朔，平陆遍峰峦。\n郡境尖中拆，人家缺处安。\n穿青入梧峡，载影下昭滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题鬼门关","author":"陶弼","text":"朝过鬼门关，虎迹印玄室。\n暮过鬼门关，猿声啸苍壁。\n朝暮悲行人，森然增惨慄。\n驻马看飞云，蛮烟不见日。\n回首望江南，万里心何极。\n美人天一方，双鱼莫能觅。\n遥望天涯亭，相逢不相识。\n令我思古人，兴怀感今昔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题廉州孟太守祠堂","author":"陶弼","text":"昔时孟太守，忠信行海隅。\n不贼蚌蛤胎，水底多还珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十","author":"陶弼","text":"恩浃黄侬族，师还左右溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十三","author":"陶弼","text":"画舫行春处，潇湘二水涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三十八","author":"陶弼","text":"双鱼远客书来报，复有珠随旦暮潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十二","author":"陶弼","text":"北人南斗外，病过两重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十一","author":"陶弼","text":"晋兴由帅让，楚败以师喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十三","author":"陶弼","text":"渴蜂衔砚水，饥蝶嗅屏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四十一","author":"陶弼","text":"独有小梅香漠漠，陆行随马水随舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十五","author":"陶弼","text":"玉簪峰顶共登仙，铜柱溪头再得贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十五","author":"陶弼","text":"人心如地少平处，天气似春无冷时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三十九","author":"陶弼","text":"青山通象郡，白浪下灵渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"陶弼","text":"蠢囷发嬉笑，蟛蜞生呕泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十三","author":"陶弼","text":"山川通益部，星斗近交州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四十","author":"陶弼","text":"不与花争世态红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十六","author":"陶弼","text":"兵堪渡海将军老，史不占天处士閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"陶弼","text":"远草牛羊动，暗潭虾蟹明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"陶弼","text":"黄柑鲈鲙金膏蟹，使我秋风未拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十四","author":"陶弼","text":"柳与扬州今独在，水和隋帝不重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三十四","author":"陶弼","text":"人说罗池表岁功，深为丰稔浅为凶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"陶弼","text":"天形包旧楚，水影动全吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"陶弼","text":"紫蟹膏应满，丹枫叶未凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十九","author":"陶弼","text":"假守昭平郡，公馀访洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其