[{"title":"响山阁","author":"释居简","text":"有耳诬墙壁，无声谤瑟琴。\n一机才破敌，何处弗知音。\n澹墨微茫古，哀丝夭阏沈。\n天风号万籁，终始不曾瘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过泖","author":"释居简","text":"问骨水驿夜迢迢，泖阔风微水不摇。\n船似井莲花叶小，不禁吹鬓冷萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"致爽梅移自崔中书后圃秋种冬花","author":"释居简","text":"根从鼎实振华风，春自岧峣直禁中。\n与紫薇花分殿最，带黄昏月尚朦胧。\n玉堂踏雪司空惯，金谷从他白首同。\n遥想树梅如树德，小酬冰质洞玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观物初瓶梅予析为二其一奇而不怪其一怪而不奇 其一","author":"释居简","text":"的皪同枝独擅奇，冲和分寸偶相违。\n不寻别调酬清婉，横玉声中怨孰归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观物初瓶梅予析为二其一奇而不怪其一怪而不奇 其二","author":"释居简","text":"鹤膝歧分把瘦枝，节拳支局老支离。\n解嘲不入时宜处，只合仪刑月蚀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上晓晴","author":"释居简","text":"彤霞煖照碧玻璃，一点蜚光欲堕迟。\n恰似峨眉山半麓，紫兜罗雾布岩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄唐察院","author":"释居简","text":"他日台纲整顿难，独观风旨弗他观。\n脩名夙振鸳鸾序，元服絻加獬豸冠。\n已肆浊流堤衮衮，更教华月振团团。\n都人快睹青骢马，不作从前款段看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渊明画像","author":"释居简","text":"司马家儿历数穷，可能特地振孤踪。\n永怀东土清风远，不把元嘉纪岁终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龚料院挽章","author":"释居简","text":"涤器笑相如，呼儿诵子虚。\n诸公方荐鹗，仙舄已骑鱼。\n临餗俄翻鼎，储林未结庐。\n只成几望月，无路问蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱知府葵窗挽章","author":"释居简","text":"仁者胡为勇，全师不足加。\n一身百夫禦，三世四王家。\n脩竹老弥动，甘棠春自花。\n白华诗欲补，有子振光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒赵仓使二十一韵","author":"释居简","text":"昔分淮东天，河海幸潜济。\n悠悠不知远，仅一衣带水。\n今兹一道惠，列城洞明伟。\n可望不可及，弱水三万里。\n山林日深窅，踸踔坎井底。\n勇闻誉盛德，半属天下士。\n古调振骚雅，时样列骈俪。\n苦语杂颂咏，恶石必先耆。\n在御必骁腾，在治必精美。\n谨于千虑失，讵忍一得弃。\n谽呀浩如海，就下拓涯涘。\n朝夕不知了，莫测方寸地。\n老我不足为，把茅冷云际。\n楼欠元龙卧，门寻子云倚。\n小振伽梨肩，载整蒙茸刺。\n高视藐豪放，细意问奇字。\n倚门勿麾之，我欲见君子。\n况夫君子乡，畴曩屡游止。\n盖代品题手，声光动天地。\n公乎皆隽髦，愿听星辰履。\n大雅傥可作，郑卫赖一洗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中絮","author":"释居简","text":"弱弄轻阴却又前，析云洴雾不成绵。\n籧篨破处随风入，蓦地因风又出船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陶窗","author":"释居简","text":"如在羲皇上，都忘我是谁。\n闻钟还入寺，无酒却攒眉。\n篱落西风晚，琴书白昼迟。\n千年续遗响，侧枕答凉飔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羌村图","author":"释居简","text":"河朔尘昏孰解纷，零丁独走不忘君。\n麻鞋见了重瞳子，还忆江东日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书先天秀雁图","author":"释居简","text":"旧随燕燕擅周诗，海北天南却背驰。\n惆怅同经弗同里，好怀长似燕差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云锦","author":"释居简","text":"十丈花如织，酣酣拓具区。\n新于机上落，匀似镜中铺。\n容与翠绡幌，渥丹铅粉肤。\n越溪霞湛染，楚梦玉敷腴。\n隋棹新帆远，吴宫小队殊。\n绿攲檠雨盖，碧间袅风蒲。\n勺月清秋冷，生凉暑昼苏。\n天孙旌浦溆，水帝展屠苏。\n红白香无别，明光影可?。\n蜕尘古君子，具体小西湖。\n彷象虽曾赋，形容似按图。\n奚囊如可制，阔剪贮陶珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石罅水仙","author":"释居简","text":"缁云浅拂衬中单，苏石蒙茸伴月寒。\n欲与南枝分伯仲，为兄恐自季方难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石罅兰竹","author":"释居简","text":"筱丛疏薄总虚心，倾国香葩闯石阴。\n不是阿清幽思苦，属谁洴墨写萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬方司法一首","author":"释居简","text":"五字堪呈佛，投珍颇惜哉。\n汤汤大雅后，衮衮建安来。\n逸思属万象，空庭步几回。\n海陵藕花幕，已为故人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘改之葬昆山山寺下邑人不知葬处 其一","author":"释居简","text":"凌烟不著老风骚，剑沕深云铁未消。\n独欠张华眸子碧，寒芒千丈夜迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘改之葬昆山山寺下邑人不知葬处 其二","author":"释居简","text":"酒酹坟头土易乾，何如黄鹤断矶船。\n会看潮雪莆萄绿，唤起长鲸快吸川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书向禅师开山石壁","author":"释居简","text":"虎驯石上倚藤枝，细把兴亡问向师。\n千柱已随烟焰■，何如表刹未开时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后","author":"释居简","text":"老火无踪雁有声，雨絻战伯八纮清。\n西风帆落昆山晓，隐隐青岑玉色明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋月","author":"释居简","text":"月是寻常月，云胡迥鲜洁。\n老火日就灺，尽扫群阴屑。\n三万顷天秋作底，连天灏气清如水。\n金波炫转光流澌，团团曷若初学眉。\n玉虹跨水腰百围，翩然飞佩湖云低。\n尺箠缓把单于笞，且复鞭虹随月飞。\n月中先枝少年日，老蟾老兔曾相识。\n镜里功名两鬓青，却碾冰轮洞八纮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王侍郎改除二首 其一","author":"释居简","text":"阖闾春秋城，风烟俟时振。\n乾坤不改色，民物见天定。\n因仍古道漓，靡然随俗移。\n中流屹颓澜，万派皆东之。\n沈机静弗哗，澄湛物斯格。\n和煦生点点，阳春苏额额。\n翩翩不容驻，宣化思盟主。\n问之何因尔，去留有常数。\n真宰知何心，惜闲如惜金。\n天悭不容破，破不为佞壬。\n我知真宰心，暂适沧洲趣。\n恐此复偶然，还须济川具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王侍郎改除二首 其二","author":"释居简","text":"泉石岂不好，老我泉石心。\n可无鹪鹩枝，来傍威凤林。\n凤兮千仞翔，览德斯下临。\n青冥丛玉霄，洞视潜伏深。\n枪榆六月息，共听朝阳吟。\n梧桐生朝阳，老干垂层阴。\n夕霭联晨霏，凉入薰风琴。\n扣弦借清商，千里秋沈沈。\n乡来嘲哳声，不复沸釜鬵。\n卷舌绝音响，泯默如病瘖。\n采羽仍嘤嘤，善类还愔愔。\n醴泉与竹实，报效杳莫寻。\n且复事颂祷，耸德齐巍岑。\n词藻苦羞涩，戛击非球琳。\n伫为王者瑞，九成仪韶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华亭明行院","author":"释居简","text":"三女冈边寺，楼台旧郁峨。\n近郊闻梵放，陆地出芬陁。\n天福虽营刹，中原尚枕戈。\n烟尘绝淮海，熨帖看鲸波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祷雨龙祠","author":"释居简","text":"魃奚为旱虐，亟问海嵎龙。\n山吐四更月，楼敲三叠钟。\n天应怜独苦，年亦岂终凶。\n霹雳轰平地，霶然足四封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"热甚","author":"释居简","text":"四壁除遮障，炎风似炽炉。\n汗随停扇滴，气逐漱冰苏。\n销暑露寒殿，归仁扇暍图。\n一杯槐叶冷，谁致锦屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺湖州太守刘右司","author":"释居简","text":"辅郡殊非列郡同，楼居阔著水晶宫。\n胆尝故垒烟尘外，心在清流湛染中。\n看不足山归赋咏，发无馀蕴到鸿濛。\n华阳壁记多名辈，先为苏家述长公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈时斋赴湖北宪辟","author":"释居简","text":"曷与元龙别，河梁五字诗。\n多君坚素守，交臂得深知。\n忆过雁回处，料当梅放时。\n驿驰行卷外，更寄向南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伦间云偕时斋行","author":"释居简","text":"诺重黄金俗，伦名与布齐。\n不情山可改，定见水难西。\n七泽云生砚，千江月透犀。\n寄声种桃者，且在武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵大卿归自四明","author":"释居简","text":"玉轮碾秋旻，一印印百川。\n分光落泾渭，湛染尤澄鲜。\n素魄当清流，似喜清流贤。\n冰澌鉴伊洛，支脉逮涧瀍。\n悠悠涵万象，囧囧洞九渊。\n可照浊水源，岂异投漪涟。\n泾也自由浑，月也亏仍圜。\n各不改故常，亦复无党偏。\n不知夫如何，竟为浑者獧。\n天高杳难问，此理何时宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋无月寄吴侍郎","author":"释居简","text":"鏖残老火豁瑶空，谁遣云生桂殿东。\n未必清明如五马，故令霶霔洗垂虹。\n凉灯荐喜占晨霁，渴稼怀新乐岁丰。\n遥想半轮秋未老，朣朣襟袖振华风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王常熟左藏二首 其一","author":"释居简","text":"常熟端平政，难于子产初。\n有田皆可井，无港不容疏。\n龙断家安业，闾阎夜读书。\n山谣出林疃，处处乐樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王常熟左藏二首 其二","author":"释居简","text":"志士殊超俗，平常不作奇。\n到官如去日，归橐似来时。\n尚友皆名世，沿流逮武夷。\n由来清操别，端的畏人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵知丞","author":"释居简","text":"或谓公当去，人谁不喟然。\n独清非衒俗，众丑自憎妍。\n华月终能满，苍蝇弗足扇。\n滔滔五弦水，千里共芳鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"善权修造讫事","author":"释居简","text":"林表焕丹碧，化出一段奇。\n乡者未始见，今也其谁为。\n金锡来自闽，萍迹才止兹。\n跨门怀往昔，视篆恢宏规。\n所立志先定，志定山弗移。\n苦心忘艰勤，伫思常委蛇。\n复道行半天，云影低四垂。\n丛玉坐上天，白花水中坻。\n两忘深且高，旁列崇与卑。\n天人既交际，物我咸熙怡。\n殿以舍空王，空王颦两眉。\n长恐屋打头，东拄西防堕。\n棱层加峭峙，柱础奠仄攲。\n彫零古象设，一一皆新之。\n琐屑与灭裂，整顿靡孑遗。\n凄凉佛前灯，兰膏添满而。\n明光号无尽，安知无尽时。\n咨尔北山密，尔吾无学儿。\n曷如然此灯，千花开不萎。\n郁密暝云蔽，浩荡刚风吹。\n刚风吹不灭，相配天阳熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵左司可斋","author":"释居简","text":"橙露荐华滋，江干记语离。\n断虹收雨后，风马驾潮时。\n梦喜登门娄，书惭去翼迟。\n橙今还可剪，浩荡乡来思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读曹侍郎去国表","author":"释居简","text":"立螭持橐孰非荣，未若江头一苇轻。\n失侣鸳鸿空怅望，喜归鸥鹭亟将迎。\n雍容谭笑不但已，去就始终如此明。\n疏似南阳出师表，尽倾肝鬲写生平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄江东运使唐察院","author":"释居简","text":"勋业可曾看晓镜，垂虹回首鉴澄波。\n明鲜叵惜随时染，瞑眩其如变證何。\n舌在未忘输谔谔，边储聊复办多多。\n骄嘶只识瑶池路，仗下如何噤得他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强斋高秘阁过访二子侍","author":"释居简","text":"囊粟排金破黑甜，晓来乾鹊响晴檐。\n西游佳气作秋爽，东聚列星应夜占。\n双玉佩声随步武，老人躔度动沈潜。\n岂惟萧寺生晶色，白叟黄童亦快瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破山夜集","author":"释居简","text":"出户天疑雪，幡然雨滴檐。\n未飞盈尺霰，先失半规蟾。\n写壁催更尽，衔枚戒夜严。\n却须重刻烛，橐粟剪纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次丘监丞破山夜集并纤字韵 其一","author":"释居简","text":"领客能官样，鸳鸿戢翼随。\n题无流处叶，续有醉时诗。\n听雨思归者，寻梅且已之。\n小池疏积淤，何必赋盆池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次丘监丞破山夜集并纤字韵 其二","author":"释居简","text":"拟把南枝雪，簪坡醉帽檐。\n袖春如有脚，鉴冰影无蟾。\n采笔吟方勇，长城令更严。\n僧房虽冷落，简古发秾纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万竹陈兄伯仲相过","author":"释居简","text":"伯埙曾奏雅，仲氏又同参。\n眼白难为俗，衫青定出蓝。\n缀虫灯剪娄，谈麈鼎分三。\n寂寞空山曙，无从驻两骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王梁山","author":"释居简","text":"置书学剑漫游畋，百万樗蒱一掷先。\n结客缔交南荡寺，买花载酒后湖船。\n三边百险常单骑，五马双旌未十年。\n莫作扬州贵人样，兜牟更解出貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢乔丞相","author":"释居简","text":"神枢卓绝当环中，物物虚应无终穷。\n华风一点妙埏埴，精神千里看折冲。\n判然经济归详鍊，有若星光绕檀篆。\n崎岖诘曲到无馀，冷地静分千绪乱。\n空山触蛮亦云惨，山鬼陆梁僧䫲颔。\n施及无求益见真，惠当适用偏多感。\n千古拓提成再造，百粉直惭酬不了。\n垣傍紫微何处祝，道场山顶何山麓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题丘使君竹坡","author":"释居简","text":"人间苦炎热，君家窗户凉。\n人间苦埃壒，君家如潇湘。\n入门洞真趣，绕户皆筼筜。\n华月筛碎金，鲜风戛丛琅。\n初疑低地碧，忽观拂云长。\n不倚见特立，侧挺终弗僵。\n弗延醉名流，只著雏凤凰。\n奇草时自芬，幽兰时自芳。\n歌鸟时自新，风玉时自锵。\n枯榆与老柳，莫蔓夫子墙。\n墙固不在高，赐也不足方。\n市声辟三舍，苔痕宽一方。\n衡斜露头角，扶疏严奥堂。\n凉薰入冰弦，古轸横石床。\n悠然于此时，物我各两忘。\n孰辨桀与蹠，更说羲与皇。\n无人不种花，长恐负艳阳。\n我则异于是，无复相较量。\n藏春在怀袖，不使蜂蝶狂。\n愿结虚心友，晚节同苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿化度","author":"释居简","text":"烈日燉云僦一单，曲肱聊复谢轻纨。\n梦回不复疑蝴蝶，疑是蟾枝宿广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿天目山西净行寺","author":"释居简","text":"有水有石又有竹，竹里僧窗皆面山。\n沆瀣弗胜和玉屑，可能来隐碧孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴侍郎婺州之官","author":"释居简","text":"坤维日望虏尘消，鸳序坤珍压大僚。\n持橐爱兄同法从，牧羊友弟并仙镳。\n清流未涨双溪碧，浮俗先传五裤谣。\n八咏断弦如可续，为君折苇度秋潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴尚书温州之官","author":"释居简","text":"才指金华饯阿连，永嘉迓吏复联翩。\n东藩等是二千石，此乐已无三百年。\n学士即真尤鲜俪，使君独立恐难先。\n懒云倘借鲜风便，容与东西刺史天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼韶国师塔","author":"释居简","text":"不到通玄顶，如何见国师。\n了无心外法，丧却目前机。\n法眼那知此，天台复谶谁。\n三峰高岌岌，孤塔更巍巍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼此庵塔","author":"释居简","text":"痛遭圆悟手，悔上毒龙冈。\n义断生难续，冤深死弗忘。\n出言非动口，验贼不须赃。\n火后红莲舌，堂堂现广长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼真歇了菩萨塔","author":"释居简","text":"洞上芙蓉老，残花发旧枝。\n话行三十载，瑞应半千期。\n一掌空凡圣，群灵入范围。\n老胡如不会，却许老胡知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼光状元塔","author":"释居简","text":"江湖行脚后，洋屿吃拳初。\n死路从头活，生涯尽底除。\n纤毫无著实，万口错传虚。\n金锁今犹暖，同心愧瞎驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼应庵塔","author":"释居简","text":"直指心成曲，单传蔓更滋。\n全身入荒草，赤膊上东司。\n一向攻人短，多方徇己私。\n杨歧五世后，作者不如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼别峰塔","author":"释居简","text":"济北参天树，何时此活埋。\n人天知敬畏，佛祖惮挤排。\n父祖万人杰，儿孙一样乖。\n?毵穿布衲，谁复裹芒鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼密庵塔","author":"释居简","text":"监本白拈贼，行家福建僧。\n分甘行异类，名不挂传灯。\n一句定宗旨，通身是葛藤。\n葛藤桩倒也，此道复中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"礼尼总持塔","author":"释居简","text":"诵莲华品谤斯经，业识芬陀舌上生。\n旧日阿閦如再见，定应无此恶名声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山送明达二侍者归蜀","author":"释居简","text":"不住有佛处，不住无佛处。\n万里一条铁，孤鸾无伴侣。\n无处不蹉过，有处还却步。\n挂角少羚羊，枯桩多死兔。\n达也二十九，兴尽复回首。\n简也四十馀，寸长竟何有。\n人皆笑我愚，我愚学未就。\n扑碎古菱花，孰与分妍丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山送洪州因上人省母","author":"释居简","text":"为法来寻访，病眼翳花发。\n为母复归去，特地重添屑。\n父母所生口，终不为汝说。\n问之何因尔，吾尝于此切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]