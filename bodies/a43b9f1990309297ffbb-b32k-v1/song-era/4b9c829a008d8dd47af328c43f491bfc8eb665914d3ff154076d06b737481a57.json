[{"title":"次韵湖阴韦深道五小诗 其二","author":"李之仪","text":"书去书来又一年，祇应提处是虚鞭。\n相逢会得笔头语，莫惜频寻酒里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵湖阴韦深道五小诗 其三","author":"李之仪","text":"江头风浪似重关，几许行人限往还。\n不是多情过相与，肯将一叶犯银山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵湖阴韦深道五小诗 其四","author":"李之仪","text":"三山矶雨列山风，我亦频年强自攻。\n不负蛟龙竟何事，祇疑身世属江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵湖阴韦深道五小诗 其五","author":"李之仪","text":"新来句法宛如阴，端与衰公伴陆沈。\n未易偏师壮秦系，刘郎戈甲旧成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其一","author":"李之仪","text":"谁人月下奏云和，一夜繁枝向北多。\n长笛未须论旧恨，且留幽思待阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其二","author":"李之仪","text":"奸雄投老恋层台，随得分香散处开。\n枝上休论歌舞旧，尊中且泛绿于苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其三","author":"李之仪","text":"弄蕊攀条日几回，依稀长记雪中开。\n尘埃满袂家山远，底事多情拂眼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其四","author":"李之仪","text":"软火明窗酒一尊，馀杯未减日尤昏。\n谁人为折东来阁，续得何郎日断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其五","author":"李之仪","text":"黯黯危肠独九回，故园谁对此时开。\n撚来聊把倚孤枕，更拟慇勤入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其六","author":"李之仪","text":"病馀憔悴拊空尊，子细思量意却昏。\n便觉阳和振枯槁，不须方士致幽魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其七","author":"李之仪","text":"初见今年报信花，定从清浅缀横斜。\n无言对我应惆怅，不复当时处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其八","author":"李之仪","text":"玉作肌肤雪作衣，剪裁风月缀寒枝。\n上池可饮偶无路，空愧当年带下医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其九","author":"李之仪","text":"漏泄天工意不轻，傍春依腊独分明。\n孤高不作繁红伴，造化须知别有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡梅花十绝 其十","author":"李之仪","text":"姑射山前旧卜家，天香真色倚风斜。\n不须薝卜分高下，要是东皇第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吕焕","author":"李之仪","text":"红炉欢坐腊灯长，豫借春风发艳妆。\n流水落花无限好，却应双鬓恨刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟泊采石","author":"李之仪","text":"经年欲到竟无繇，便路今朝得暂留。\n弄月燃犀俱未暇，潮平且欲过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和州太守曾延之置酒鼓角楼","author":"李之仪","text":"楼台烟树接平芜，水墨丹青十幅图。\n认得黄山家住处，云中相对似相呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延之置酒当利楼侍人劝酒","author":"李之仪","text":"云山远近浅还深，宛转愁颜顿不任。\n独有绮罗知此意，故拈金盏十分斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延之置酒连云观北望丘墟掩翳相与凭栏感叹延之以所持扇见授云不可不记也因书之","author":"李之仪","text":"后垄前冈一色松，相看冠剑几悲风。\n今朝笑语明朝哭，莫厌尊中酒不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延之置酒南园因书柱上","author":"李之仪","text":"尊前景气朝朝别，醉里歌呼处处新。\n一度拈来一回好，主人须信异于人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何子温家有巨竹数顷因成绝句","author":"李之仪","text":"老绿阴森锁昼寒，儿孙延裔不知年。\n欲归顿失来时路，一似高风暗雨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾延之置酒后阁供帐酒馔物物皆内出侍人以裙带求书","author":"李之仪","text":"御醅盏畔千头菊，椽烛光中四和香。\n红粉莫嗟霜满颔，也应歌处似周郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延之问及当涂近事云君殆能容忍我不及也胡不迁居于此便治馆因口占为谢","author":"李之仪","text":"胯下淹时岂不知，故人疑我似阳痴。\n一廛固愿授陈相，只恐锋车便见追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延之云久迟公来不谓迫之乃肯顾我既开此路却当以匪人为津梁矣致我佳客敢忘其德口占为戏","author":"李之仪","text":"一水相忘辄自疲，青毡情厚失先期。\n从今不比鸬鹚数，更欲棠阴借异时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏四绝 其一","author":"李之仪","text":"人间所乐宁过此，一事都无有俸钱。\n更向丰年观割稻，须知身是地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏四绝 其二","author":"李之仪","text":"老呼稚舞报丰年，极目黄云欲际天。\n旋捣新粳供晚饭，只愁閒梦搅安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏四绝 其三","author":"李之仪","text":"解箨新篁绿未分，弄晴啼鸟语如文。\n翻风葭菼全疑雨，对岸峰峦便是云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏四绝 其四","author":"李之仪","text":"平生粥饭寄伽蓝，老日田园强自添。\n岂自着靴踏泥客，如何不许暂深潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书龚彦本庄壁二绝 其一","author":"李之仪","text":"青黄赤白千畦稻，远近高低四面山。\n旧约买邻今已决，却忧无力伴跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书龚彦本庄壁二绝 其二","author":"李之仪","text":"重阳过了十二日，阶下黄花方盛开。\n节物参差何足较，且浮新蕊共衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同彦本兄弟泛舟过北山","author":"李之仪","text":"横截西山一叶轻，晓奁初发镜中行。\n异时常作玻璃观，却恐丹青画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彦本邻庄有欲售其所舍之屋者相与就阅遂书其屏上与彦本为约","author":"李之仪","text":"求田问舍太迟生，栋宇才逢眼便明。\n凭仗经营须占早，连墙祇恐负柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龚深之曾约相从偶不及而深之逝矣独过其所约之地遗像俨然感怆不已因书其事","author":"李之仪","text":"德公期我此联裾，独舍扁舟断梦初。\n穗帐一灯如晤语，泪痕空对两龙驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入褒禅山","author":"李之仪","text":"近山回抱锦为屏，金碧高低照眼明。\n四十年来劳梦想，白头方喜慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"褒禅知客求书因以答之","author":"李之仪","text":"霜林斑驳抱园回，晓日初升宿雾开。\n忆得旧游怀小杜，分明回望绣成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"褒禅斋后独出三门步深山久之","author":"李之仪","text":"两脚都忘力不胜，穿云度堑信腾腾。\n林深鸟兽知无迹，时见游山一两僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游华阳洞行十馀步水阻而回","author":"李之仪","text":"篝火宵深兴转浓，可怜潭水断来踪。\n祇疑终有蛟龙护，玉室金堂未许逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自褒禅寺东转将过大乘路中","author":"李之仪","text":"不觉离家二十日，山林城市恣延缘。\n定因曾作和州客，长见鸡笼在眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲过大乘先寄祖灯禅师大乘甚贫新开堂","author":"李之仪","text":"大乘此去有几里，闻道祇园近布金。\n但恐钵中无客饭，止期经宿谢知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将过大乘薄晚不能到既见祖灯以寄一笑","author":"李之仪","text":"踏尽田塍转尽山，芥塘犹在夕阳间。\n主人缩地元多术，何事今朝特见悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汤泉才到便问浴处何在戏呈长老","author":"李之仪","text":"欲从旷口过金陵，不惜汤泉两日程。\n因就故人求一浴，何妨随例得身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苦竹寺后亭","author":"李之仪","text":"竹映丹枫转短篱，有花开处尽空枝。\n春风想见如铺锦，惆怅来游不是时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再过苦竹饭于寺前客邸","author":"李之仪","text":"隼旟歌呼引红妆，花帽追随入醉乡。\n今日再来如断梦，主人依旧进黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其一","author":"李之仪","text":"海燕初飞掠水轻，酴醾开就照人明。\n旋倾煮酒尝青杏，唯有风光不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其二","author":"李之仪","text":"万腔腰鼓打梁州，舞罢还催步打毬。\n更借缠头三百万，阿奴要彻第三筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其三","author":"李之仪","text":"情随榆荚不胜飘，心似杨花暖欲销。\n拟借琼林大盈库，约君孤注赌妖娆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其四","author":"李之仪","text":"漫寻蝴蝶却成痴，欲趁蜂儿转更疑。\n自是心情怕时节，不如閒处伴黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其五","author":"李之仪","text":"程氏园当尺五天，千金争赏并朱栏。\n莫因今日家家有，便与常时两样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其六","author":"李之仪","text":"的的枝头浅浅黄，未先颜色占年芳。\n任是剪成香更裂，鼻根眼界漫商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句七首 其七","author":"李之仪","text":"斋盂洗罢日方中，帘影低回破睡风。\n试问新浮一瓯乳，何须亲到广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张文潜赠杨妹","author":"李之仪","text":"草草声名等漏卮，相逢佳处暂舒眉。\n我方击节聊乘兴，君可忘忧莫见疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿观音寺三绝 其一","author":"李之仪","text":"倦听帘间点滴声，栖禽初报晓来晴。\n分明市合人争语，清浊高低各有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿观音寺三绝 其二","author":"李之仪","text":"乌啼鹊噪趁初晴，百舌新调燕羽轻。\n滑滑竹鸡催布谷，声声鶗鴂唤流莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿观音寺三绝 其三","author":"李之仪","text":"留滞江南又一年，燕巢初就鹊声喧。\n一番风竹摇窗外，犹冀曾来紫玉轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢范守惠鹅","author":"李之仪","text":"玉翎红觜小池中，双入筠笼寄病翁。\n不是山阴亲换得，自惭书学久无工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画鸭 其一","author":"李之仪","text":"野塘溶漾夕阳时，风淡云閒草半攲。\n会得腾身振衣否，不教春色在花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画鸭 其二","author":"李之仪","text":"道人笔力与春争，五彩都将墨染成。\n新浴羽毛犹更葺，似疑颜色未分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画鹅儿","author":"李之仪","text":"声里生涯壳外天，天真虽判尚茫然。\n只应未解长依母，每向沙头独自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画鹅","author":"李之仪","text":"人间今复见丹青，生意初侵造物灵。\n却笑山阴何所得，尚须辛苦写黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书罗氏屏风四绝 其一","author":"李之仪","text":"净练平铺月上时，无人吟得谢郎诗。\n酒酣直欲捉倒影，千古风流几个知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书罗氏屏风四绝 其二","author":"李之仪","text":"鼓声绝罢香烟起，涌出潮音满座寒。\n为问如何第一义，等閒拈却面前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书罗氏屏风四绝 其三","author":"李之仪","text":"一到山头却下山，终朝只在翠微间。\n白云本是无心物，何事高低伴往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书罗氏屏风四绝 其四","author":"李之仪","text":"日日春禽百转新，明窗棐几净无尘。\n平生似有丛林分，秃鬓何为尚满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢荆州太守","author":"李之仪","text":"荆州太守紫微仙，远寄渔翁白玉泉。\n长钓久垂鱼未食，为君一醉卧长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵次卿林下行歌十首 其二","author":"周紫芝","text":"闻道全家隐鹿门，竹篱茅屋寄江村。\n庞公事业无多子，只有平安遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题渔家壁","author":"李之仪","text":"卖酒罾鱼止数家，卜邻还在水之涯。\n扁舟定向桃源去，斜日红开两岸花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题六绝 其一","author":"李之仪","text":"霜风刮地雁连天，野舍衾寒感旧年。\n独有多情夜来榨，床头滴滴慰孤眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题六绝 其二","author":"李之仪","text":"行人犹未有归期，万里初程日暮时。\n唯爱门前双柳树，枝枝叶叶不相离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题六绝 其三","author":"李之仪","text":"长溪新雨色如泥，野水阴寒尽向西。\n楚客天南行渐远，山山树里鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题六绝 其四","author":"李之仪","text":"数卷新游蜀苑诗，长安僻巷得相随。\n草堂雪夜携琴处，况似青城馆里时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题六绝 其五","author":"李之仪","text":"不觉六月初八日，还是去年瓜熟时。\n鞭藉竟谁能致曲，定自昭昭终可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访瑫上人值吃葱茶","author":"李之仪","text":"软火明窗纸帐低，一声初报午来鸡。\n葱茶未必能留坐，为爱高人手自提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"李之仪","text":"银汉风休月对弦，灵桥长挂罢星填。\n从今祇恐情先老，无复佳期又隔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山","author":"李之仪","text":"南山不见见东山，白鹭时时自往还。\n为问天公几时雨，定因薄相故能悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒坐","author":"李之仪","text":"鸦衔遗秉趁饥鹰，老牸时传唤犊声。\n凡物有生皆有乐，不堪孤坐泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬辰春试终场王德循置酒登月阁邀丁希韩甚欢夜分方罢","author":"李之仪","text":"宝炷芬敷散瑞烟，月移花影上栏杆。\n角声又报梅花弄，只恐归时夜更寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日净因庄早饭罢遂游洪福有怀巨载元确因致别约 其一","author":"李之仪","text":"老禅期客煮园蔬，少憩西邻日转初。\n万白千红好时节，断魂空付两龙驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]