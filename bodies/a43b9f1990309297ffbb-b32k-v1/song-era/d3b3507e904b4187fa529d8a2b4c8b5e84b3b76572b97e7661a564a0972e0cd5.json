[{"title":"雪山","author":"释心月","text":"昼漫漫地夜漫漫，高下峰峦总一般。\n身在洞然明白里，勿于明白里头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄檗掌沙弥图赞","author":"释心月","text":"大机之用谁担荷，断际孤风不可追。\n济北少年曾未委，风光太子已先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭检法号仍旧","author":"释心月","text":"者汉本来无面目，几年向外空驰逐。\n蓦然忆著便归来，六六依前三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化赞 其二","author":"释心月","text":"邈得先师真，鼻孔不相似。\n大悲院里归，驴鸣较些子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送金州禅人","author":"释心月","text":"磨砖大士眼觑眯，归去高声唤醒伊。\n好个打车消息子，无端错付马驹儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩愈请益大颠图赞","author":"释心月","text":"去国迢迢路八千，归心日夕九重天。\n当机不领到家句，且向途中快著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪翁","author":"释心月","text":"水落曾知杓柄长，家风从此转凄凉。\n有时浪起无风处，冷看截流人自忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慵衲","author":"释心月","text":"寒涕垂颐懒不收，肯将佛法挂心头。\n针筒线袋也拈却，古毳从教烂坏休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"裴休捧佛请安名图赞","author":"释心月","text":"持来面目已全彰，出就呈机验当行。\n千释迦文万弥勒，都卢摄入一身光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"聪大师号无闻送广福住院","author":"释心月","text":"来日台山大会斋，隔身句子绝安排。\n如今已落无闻手，双放双收机莫偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镇汤头","author":"释心月","text":"甜似黄连微带涩，苦如甘草略含辛。\n一回点过一回别，只恐难瞒无舌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"璞翁","author":"释心月","text":"隐密全真处，浑崙未剖时。\n从来只与么，不用讨瑕疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如行新戒落发升座","author":"释心月","text":"患累资生无有涯，选官选佛学丹霞。\n须知发刬殿前草，不碍萱开堂北花。\n万法从心心是正，一心逐物物皆邪。\n夜窗寂寂青松下，究彻根源始到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张防禦","author":"释心月","text":"我有一方田，于中息万缘。\n生涯虽寂尔，日用不徒然。\n知足长年乐，无求在处禅。\n西邻知此意，松竹销寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"容大师水陆升座说偈","author":"释心月","text":"末山一境不露顶，直下全超五障身。\n佛国无边皆自己，台山大会付何人。\n苾刍草碧枝枝秀，菡萏花红叶叶新。\n外祖深恩只者是，一庵和气暖于春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其一三七","author":"释心月","text":"一月相抛不出门，几经花县几烟村。\n桑麻影里炊香早，松竹阴中笑语温。\n幽磬朝离迎白日，疏钟晚泊送黄昏。\n捲旗收阵归来也，谁是知恩与报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其九十八","author":"释心月","text":"把手同归者，琅琅笑语新。\n移身藏北斗，举步入南辰。\n少室残冬雪，武林三月春。\n辘轳千万偈，顽石两眉伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百五十首 其五十","author":"释心月","text":"赤心报国丈夫儿，进退存亡己自知。\n盖世英雄宁畏死，一时忠勇更无谁。\n冶城夜月将军墓，蒋岳春云武帝祠。\n从此龙光山下寺，龟哥也著载丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师正恭写松源掩室并师山行图请赞 其一","author":"释心月","text":"父前行，子后随。\n不肖孙，愚且痴。\n三昧门，各自知。\n入深村，草离离。\n风前翻忆老杨岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其七","author":"释心月","text":"对面抚掌，两镜相照。\n双涧与五峰，冷地齐失笑。\n唤作普贤还料掉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广福聪长老画无准顶相请赞","author":"释心月","text":"这慈尊，曾自赞。\n煮不熟，烧不烂。\n有软顽，没思算。\n秤须弥重四两，量虚空阔丈半。\n更有白■不是处，付与无闻，从公理断。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马郎妇赞","author":"释心月","text":"镜里精神，风前调度。\n手执莲经，换人肠肚。\n锦鳞吞钓上钩来，黄金骨已腾空去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其二","author":"释心月","text":"执爨灰满头，扫地尘扑面。\n岩下细思量，一场不著便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其三","author":"释心月","text":"道兮无贫，德兮有邻。\n五峰双涧，谁主谁宾。\n相靠而睡也，象王回顾。\n相呼而笑也，狮子嚬呻。\n噫，不省这个意，修行徒苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其五","author":"释心月","text":"微风吹，岩松鸣。\n听愈好，吟愈清。\n浑崙一句子，文彩甚分明，笔下如何写得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其四","author":"释心月","text":"双涧底，五峰前。\n块石上，磨松烟。\n多无一两字，少有三百篇，明明此意落谁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其六","author":"释心月","text":"左手执卷，右手指示。\n觌露不覆藏，几人知此意。\n回首台山锁寒翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞 其一","author":"释心月","text":"只解踞虎头，不解收虎尾。\n你若讦露人，人也讦露你。\n出没虎声中，卷舒牛迹上。\n半是小儿嬉，半是大人相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其五","author":"释心月","text":"能与么去，能与么回。\n青松郁密，白发摧颓。\n岭南消息几时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其一","author":"释心月","text":"竺乾正眼，震旦心宗。\n一点水墨，两处成龙。\n至今匝地生清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其二","author":"释心月","text":"诸缘息时，伎俩尽矣。\n了了常知，不是不是。\n莫被胡僧谩著你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其四","author":"释心月","text":"古佛无心，知之者谁。\n双峰点首，石女攒眉。\n错付黄梅个小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其三","author":"释心月","text":"无言说中，广说信心。\n洞然明白，非去来今。\n风病因兹转更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师赞 其六","author":"释心月","text":"字则不识，宗说俱通。\n如风吹水，如日行空。\n破荡箕裘是此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝请首座挂牌上堂","author":"释心月","text":"三春去向那边去，九夏来从屋力来。\n一喝两头俱坐断，人天眼目与谁开。\n乌飞兔走，地转天回，时有清风匝九垓。\n寒山子满头灰，引得丰干笑满腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开光明藏疏","author":"释心月","text":"佛祖亲传真命脉，橘洲笔底发渊源。\n郁乎光焰十万丈，只贵知音一印传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开眼入定赞","author":"释心月","text":"六用如如体不分，耳能观色眼能声。\n而今老大宜安分，眼自观兮耳自听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文殊赞","author":"释心月","text":"狮子吼，无畏说。\n空处挨，紧处捻。\n彼上人，缩却舌。\n不二门，都败阙。\n五髻童真七佛师，却證乌龟成白鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无瑕","author":"释心月","text":"本体温如又瑩如，拟心雕琢费工夫。\n自家宝藏只这是，切莫揩磨染污渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水月观音赞","author":"释心月","text":"觉天无云，性海无风。\n玉轮蘸影，金浪翻空。\n非惟观世音，我亦游其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东林彻长老请赞","author":"释心月","text":"寒浦先零之姿，古岩后凋之操。\n雪满颠一味寒酸，云半肩十分枯槁。\n任缘去住也，随处有馀。\n信手拈来也，用时恰好。\n虽云理绝思惟，其柰事关怀抱。\n倚天长剑用还磨，分付明岩彻长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞 其一","author":"释心月","text":"道无修證，入山何为。\n法无去来，出山何之。\n黄金屋宅草离离，天上人间说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释心月","text":"放布袋而立，携布袋而去。\n他日下生来，别道一转语。\n补处之尊，弄真像假。\n抛却内宫，来使奉化。\n回观时髑髅眼睛沥未尽，紧靠处布袋骨董放不下。\n放得下，未必遭人强描画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释心月","text":"儱侗十围腹，婆娑三尺躯。\n折拄杖搅无边香水海，破布囊贮百亿须弥卢。\n等个人㗭哩㗭哩，觅文钱苏噜苏噜。\n天上无，地下无，四明山色开画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释心月","text":"矬而肥，肥而痴。\n肩驼背负，或徐或驰。\n回头处，微笑时，此意明明说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自在观音赞","author":"释心月","text":"日高花影重，风暖鸟声碎。\n在在圆通门，门门观自在。\n宝陀峰顶较些些，片月分辉照沧海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行者德山改名德止","author":"释心月","text":"吾宗一德山，天下同仰企。\n寥寥数百年，清风来未已。\n汝名今与同，初非犯其讳。\n人前一呼唤，不觉耸众耳。\n易以艮为山，辞以艮为止。\n宜将止易山，只移一画子。\n吾当尊前贤，不得不如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其一","author":"释心月","text":"面壁而坐，见成行货。\n立雪求之，还同蹉过。\n须知罪犯弥天大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨居士请赞","author":"释心月","text":"水中之月，镜里之形。\n一顶春雪，半肩秋云。\n观而无观曰正观，闻而无闻曰真闻。\n画工作汝汝即我，居士识吾吾非君。\n是兮非兮分不分，赞之毁之徒云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵照看日早晚图赞","author":"释心月","text":"明暗双双机夺机，阿爷手里觅便宜。\n果然老底能轻信，输却日轮当午时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"言法华赞","author":"释心月","text":"褰裳登九重，走笔书十三。\n两头俱不住，临去又图南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刺血写法华","author":"释心月","text":"矮窗岑寂中，一字一点血。\n血尽笔秃时，止止不须说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗道者赞","author":"释心月","text":"一双破草鞋，无跟又无耳。\n袈裟包不得，拄杖挑不起。\n只知赤脚下桐城，不免桐城人笑你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝公和尚赞","author":"释心月","text":"鹰窠大士，示现无方。\n生于宋代，老于齐梁。\n杖头刀尺，隐显全彰。\n巍巍堂堂，炜炜煌煌。\n至今坐断独龙冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘惠长老请赞","author":"释心月","text":"万里晴空，一声霹雳。\n尽大地人，掩耳不及。\n浩浩清风生八极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郁山主赞 其二","author":"释心月","text":"骑驴过溪桥，一踏桥梁折。\n桥边万朵山，拊掌笑不歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鱼妇赞","author":"释心月","text":"左提鱼篮，右搴衣袂。\n浩浩尘中，一声活底。\n倾国倾城眼豁开，早已白云千万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亮座主赞","author":"释心月","text":"心与虚空讲未终，一呼回首一开容。\n勿言去后无消息，云外西山翠扫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草衣文殊赞","author":"释心月","text":"草离离，发垂垂。\n神出鬼没，佛眼难窥。\n能坐毗耶之舌，而不能出女子之定。\n能行法王之令，而不能免迦叶之疑。\n五台山势峭巍巍，返掷还他狮子儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草衣文殊赞","author":"释心月","text":"披草衣，执具书。\n面不洗，头不梳。\n是文殊，非文殊。\n拟议台山路转迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"说无生话图赞","author":"释心月","text":"收拾山云海月情，团栾鼻直眼眉横。\n龟毛拂子兔角杖，敲得虚空嚗嚗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵通判请赞观音","author":"释心月","text":"轮数珠，泛莲舟。\n觉天云静，性海风休。\n以悲为心，救众生苦。\n以慈为眼，观众生忧。\n众生何忧，忧忘内修。\n众生何苦，苦于外求。\n故现宰官身，所说宰官法。\n不出乎尽忠孝，守名节，保禄位，教子孙，勿坠于箕裘。\n夫如是普门一十九类，楞严三十二应，熙怡微笑，唯唯点头。\n公堂日永篆烟浮，誓与慈容同去留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一默翁入浙","author":"释心月","text":"有佛处不得住，铁鞭击碎珊瑚树。\n无佛处急走过，澄潭不许苍龙卧。\n三千里外莫错举，剔起眉毛眼卓坚。\n与么则不去也，百城烟水难图画。\n摘杨花，摘杨花，未容眨眼早忘家。\n赵州舌本悬千日，石火电光追莫及。\n纸灯吹灭便知归，落在吾家第二机。\n翻身倒握乌藤去，千圣罗笼不肯住。\n何时砥柱障颓波，大扇真风满寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林藏主省亲","author":"释心月","text":"有十不归今且归，不愿再见今再见。\n古今大道常坦然，各自当门通一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送保慧大师 其一","author":"释心月","text":"生在如来家，须学如来行。\n诸念入正念，有诤归无诤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送寂照庵归蜀","author":"释心月","text":"错向南来犹自可，归乡一错更难追。\n果然到底错将去，三十六江流向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"须菩提赞 其一","author":"释心月","text":"倚杖而立，示真般若。\n手中册子，云何抄写。\n长老若不放下，疑杀后生尊者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"须菩提赞 其二","author":"释心月","text":"常宴坐，常危立。\n一片虚凝，万境空寂。\n岩前花雨已狼籍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆通师孙福长老请赞","author":"释心月","text":"虚空寥寥，吾之体也。\n万象纭纭，吾之用也。\n青山白云，吾之宾朋也。\n山色溪声，吾之言论也。\n作是说者，画师之所不能幻也。\n夫画师所不能幻者，吾亦不知吾之为谁也。\n故强名之，曰石溪老冻畐也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷泽赞","author":"释心月","text":"荷泽元来不姓高，岭头一网竟难逃。\n尔曹若不论知解，知解无因到尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚬子赞 其一","author":"释心月","text":"师荒村古庙兮，人绀宇莲宫。\n师纸钱堆里兮，人璎珞聚中。\n师捞■摝蚬兮，人打凤罗龙。\n师鳣鲜枯槁兮，人玉食雍容。\n师与人隐显各异兮，卷舒一同。\n为华严之弟兮，不入华严保社。\n为洞山之子兮，不绍洞山门风。\n欲遁其迹迹愈著，欲晦其名名愈崇。\n夫能谨初护末，不沿他酒台盘兮，人莫知师之所知。\n师独乐其乐，乐亦无穷。\n果如是兮，安有今日。\n持短尺以量虚空，磨淡墨以邈虚空者哉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资寿溱长老请赞","author":"释心月","text":"寒浦先零之姿，古岩后凋之操。\n雪满颠一味寒酸，云拥肩十分枯槁。\n任缘而住也，触处有馀。\n随机而应也，无适不可。\n家法森严，钳锤糙暴。\n承当者谁，如溱长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]