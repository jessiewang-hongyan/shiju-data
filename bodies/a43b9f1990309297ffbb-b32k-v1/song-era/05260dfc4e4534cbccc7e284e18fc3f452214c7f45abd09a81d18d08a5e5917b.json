[{"title":"丙午新正书怀十首 其九","author":"范成大","text":"窗明窗暗篆烟馡，珍重晨光与夕晖。\n东院斋钟披被坐，南城严鼓岸巾归。\n几人霜滑骑朝马，何处灯残织晓机。\n懒里若承三昧力，始知忙里事俱非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其八","author":"范成大","text":"经过扫轨但幽栖，巢稳林深寄一枝。\n栗里归来窗下卧，香山老去病中诗。\n东风马耳尘劳后，半夜鸡声睡熟时。\n俯仰平生尽尘迹，恰如腷膊几枰棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其七","author":"范成大","text":"炭熟香浓石鼎煨，人言小閤是春台。\n蕉心翠展一冬在，梅藟粉融连夜开。\n肃肃九冰妨发育，温温三火护恢台。\n养生此外无遗说，梨枣元须趁暖栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其六","author":"范成大","text":"俗情如絮已泥沾，因病偷閒意属厌。\n鹏鴳相安无可笑，熊鱼自古不容兼。\n灰藏榾柮多时暖，雪压蔓菁满意甜。\n温饱闭门吾事办，异时书判指如签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其五","author":"范成大","text":"厉风翻海雪漫天，百计逃寒息万缘。\n稳作被炉如卧炕，厚裁绵旋胜披毡。\n尊前现在瞢腾醉，饭后无何烂熳眠。\n斟酌出门高兴尽，从教閒却剡溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其三","author":"范成大","text":"煮茗烧香了岁时，静中光景笑中嬉。\n身閒一日似两日，春浅南枝如北枝。\n朝镜略无功业到，午窗惟有睡魔知。\n年来并束床头易，一任平章济叔痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其二","author":"范成大","text":"瘦骨难胜遇节衣，日高催起趁晨炊。\n病怜楖栗随身惯，老觉屠苏到手迟。\n一饱但蕲庚癸诺，百年甘守甲辰雌。\n莫言此外都无事，柳眼梅梢正索诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其一","author":"范成大","text":"不用桃符贴画鸡，身心安处是天倪。\n行年六十旧历日，汗脚尺三新杖藜。\n祝我剩周花甲子，谢人深劝玉东西。\n春风若借筋骸便，先渡南村学灌畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙申元日安福寺礼塔","author":"范成大","text":"岭梅蜀柳笑人忙，岁岁椒盘各异方。\n耳畔逢人无鲁语，鬓边随我是吴霜。\n新年后饮屠苏酒，故事先然窣堵香。\n石笋新街好行乐，与民同处且逢场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东林寺","author":"范成大","text":"谈易翻经宰木春，三生犹自袅烟熏。\n客尘长隔虎溪水，劫火不侵香谷云。\n老矣懒供莲社课，归哉忺读草堂文。\n山头一任天灯现，个事何曾落见闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人七月十四日生朝","author":"范成大","text":"秋入壶中玉宇鲜，芝兰桃李共熙然。\n已饶瑞荚明朝满，先借清蟾一夜圆。\n北阙紫泥应道路，东山红袖莫云烟。\n如今且醉江湖酒，来岁城南尺五天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代圣集赠别","author":"范成大","text":"一曲悲歌水倒流，尊前何计缓千忧。\n事如梦断无寻处，人似春归挽不留。\n草色粘天鶗鴂恨，雨声连晓鹧鸪愁。\n迢迢绿浦帆飞远，今夜新晴独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至日天庆观朝拜云日晴丽遥想郊禋庆成作驩喜口号","author":"范成大","text":"淅淅霜风不满旗，紫烟黄气捧朝曦。\n五更贯索埋光后，万里钩陈放仗时。\n留滞周南无旧事，布宣汉德有新诗。\n丰年四海皆温饱，愿把欢心寿玉卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至日铜壶阁落成","author":"范成大","text":"走遍人间行路难，异乡风物杂悲欢。\n三年北户梅边暖，万里西楼雪外寒。\n已办鬓霜供岁籥，仍拚髀肉了征鞍。\n故园云物知何似，试上东楼直北看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至夜发峡州舟中作","author":"范成大","text":"舟中万里行，灯下一阳生。\n不减在家好，都忘为旅情。\n霜乾风愈劲，云淡月微明。\n况有诗兼酒，樽前莫问更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北山堂开炉夜坐","author":"范成大","text":"困眠醒坐一龛多，竹洞无关断客过。\n贪向炉中煨榾柮，懒从掌上看庵摩。\n閒无杂念惟诗在，老不甘心奈镜何。\n八万四千安乐法，元无秘密可伽陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北门覆舟山道中","author":"范成大","text":"苒苒霜风掠弊貂，簿书尘外访渔樵。\n林烟色淡如濛雨，塘水痕深似落潮。\n雁字江天闻塞管，梅梢山路欠溪桥。\n骑驴索句当年事，岁暮骚人不自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去年多雪苦寒梅花遂晚元夕犹未盛开","author":"范成大","text":"隔年寒力冻芳尘，勒住东风寂寞滨。\n只管苦吟三尺雪，那知迟把一枝春。\n灯烘画阁香犹冷，汤煖铜瓶玉尚皴。\n花定有情堪索笑，自怜无术唤真真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发荆州","author":"范成大","text":"初上篷笼竹笮船，始知身是剑南官。\n沙头沽酒市楼暖，径步买薪江墅寒。\n自古秦吴称绝国，于今归峡有名滩。\n千山万水垂垂老，只欠天西蜀道难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月十日出郊","author":"范成大","text":"约束南风彻晓忙，收云捲雨一川凉。\n涨江混混无声绿，熟麦骚骚有意黄。\n吏卒远时閒信马，田园佳处忽思乡。\n邻翁万里应相念，春晚不归同插秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月五日集陈园照山堂","author":"范成大","text":"寻壑经丘到此堂，官闲聊作送春忙。\n短篱水面残红满，团扇风前众绿香。\n尽捲帘旌延竹色，深斟杯酒纳山光。\n洞门无锁城门近，转午鸡啼日正长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圣集誇说少年俊游用韵记其语戏之","author":"范成大","text":"京尘红软扑雕鞍，年少王孙酒量宽。\n倚袖竹风怜翠薄，捧杯花露怯金寒。\n黄云城上栖乌曲，绿水桥边斗鸭栏。\n别后相思惟故物，壁煤侵损扇中鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"外舅挽词二首 其一","author":"范成大","text":"植德千章茂，硎材百鍊刚。\n事功才止此，物理故难量。\n雁序云天远，兰阶雨露芳。\n公无憾身后，人自惜堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"外舅挽词二首 其二","author":"范成大","text":"幽介联昏援，门阑阅岁更。\n方欣承燕几，何意写铭旌。\n笑语犹寻梦，恩勤已隔生。\n情伤到深处，有泪不胜倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十四日雨中与正夫朋元小集夜归","author":"范成大","text":"灯市凄清灯火稀，雨巾风帽笑归迟。\n月明想在云堆处，客醉都忘马滑时。\n老去樽前花隔雾，春来句里鬓成丝。\n浮生不了悲欢事，作剧儿童总未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"民病春疫作诗悯之","author":"范成大","text":"乖气肆行伤好春，十家九空寒螀呻。\n阴阳何者强作孽，天地岂其真不仁。\n去腊奇寒衾似铁，连年薄热甑生尘。\n疲氓惫矣可更病，我作此诗当感神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉堂寓直","author":"范成大","text":"摛文窗户九霄中，岸帻烧香愧老农。\n上直马归催下钥，传更人唱促鸣钟。\n金城巀嵲云千雉，碧瓦参差月万重。\n骨冷魂清都不梦，玉阶萧瑟听秋蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用汉中帅阎才元侍郎韵送樊子南西归兼呈侍郎","author":"范成大","text":"万里山巅与水涯，春风招看杏园花。\n向来科第直溷子，此去文章应满家。\n休学游仙穷越巂，且从知己控褒斜。\n南楼东望当思我，药裹堆中两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田舍","author":"范成大","text":"呼唤携锄至，安排筑圃忙。\n儿童眠落叶，鸟雀噪斜阳。\n烟火村声远，林菁野气香。\n乐哉今岁事，天末稻云黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲午岁朝寓桂林记去年是日泊桐江谒严子陵祠迤逦度岭感怀赋诗","author":"范成大","text":"去年晓缆解江皋，也把屠苏泛浊醪。\n一席饱风渔浦阔，千山封雪钓台高。\n将军老矣鸣孤剑，客子归哉咏大刀。\n早晚扁舟寻旧路，柁楼吹笛破云涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲午除夜犹在桂林念致一弟使虏今夕当宿燕山会同馆兄弟南北万里感怅成诗","author":"范成大","text":"把酒新年一笑非，鹡鸰原上巧相违。\n墨浓云瘴我犹住，席大雪花君未归。\n万里关山灯自照，五更风雨梦如飞。\n别离南北人谁免，似此别离人亦稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立冬夜舟中作","author":"范成大","text":"人逐年华老，寒随雨意增。\n山头望樵火，水底见渔灯。\n浪影生千叠，沙痕没几棱。\n峨眉欲还观，须待到晨兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"范成大","text":"候管灰初动，条风已发春。\n万灵归化育，一气验平均。\n农事牛先示，人情蠖欲伸。\n优哉汉疏广，樽酒过嘉辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日郊行","author":"范成大","text":"竹拥溪桥麦盖坡，土牛行处亦笙歌。\n曲尘欲暗垂垂柳，醅面初明浅浅波。\n日满县前春市合，潮平浦口暮帆多。\n春来不饮兼无句，奈此金幡綵胜何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日陪魏丞相登三江亭","author":"范成大","text":"佳节登临始此回，聊从晻霭望蓬莱。\n水分江北渡头去，风自海东潮外来。\n太白天寒犹带雪，十洲池暖已浮醅。\n一尊往酹发船鼓，我亦归帆相次开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前堂观月","author":"范成大","text":"箕踞绳床政自豪，远游何暇续离骚。\n萧森万竹秋逾瘦，突兀双楠夜更高。\n东郭风喧三鼓市，西城石汹二江涛。\n色尘声界如如现，本自无禅不用逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"?䢹驿大雨","author":"范成大","text":"暮雨连朝雨，长亭又短亭。\n今朝骑马怯，平日系船听。\n竹叶垂头碧，秧苗满意青。\n农畴方可望，客路敢遑宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙学侍郎清河侯张公挽词二首 其二","author":"范成大","text":"太息逢萋锦，平生付薄冰。\n沧溟淙赤舌，白日照青蝇。\n岳麓身犹健，星维驭已升。\n天如遗一老，人亦望三登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙学侍郎清河侯张公挽词二首 其一","author":"范成大","text":"白水名多士，清河最有声。\n人危孔北海，帝识柳宜城。\n蜀险谈间固，蛮讧檄到平。\n凌烟何处在，风雨上铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙学尚书新安侯罗公挽词二首 其二","author":"范成大","text":"一昨更调瑟，如闻欲赐环。\n途殚泣西狩，望绝起东山。\n华屋林霏惨，新阡草露班。\n春风埋玉泪，重为庾公潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲行再示新句复次韵述怀","author":"范成大","text":"神仙懒学古浮丘，祖意慵参老赵州。\n四壁尘埃心似水，一生风露鬓先秋。\n病衰谨谢吴中客，技拙甘同楚国优。\n斥鴳蓬蒿元自足，世间何必卧高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会庆节大慈寺茶酒","author":"范成大","text":"霜晖催晓五云鲜，万国欢呼共一天。\n澹澹煖红旗转日，浮浮寒碧瓦收烟。\n衔杯乐圣千秋节，击鼓迎冬大有年。\n忽忆捧觞供玉座，不知身在雪山边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光福塘上","author":"范成大","text":"指点炊烟隔莽苍，午餐应可寄前庄。\n鸡声人语小家乐，木叶草花深巷香。\n春去已空衣尚絮，雨来何晚稻初芒。\n祗今农事村村急，第一先陂贮水塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再出东郊","author":"范成大","text":"晚景增年惯，官身作客谙。\n大都缘偶熟，岂是性能堪。\n昔者开三径，他时老一龛。\n越溪亲种竹，芸绿想毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵","author":"范成大","text":"休论今昨总皆非，世味诚甘与我违。\n蜀道虽如履平地，杜鹃终劝不如归。\n三冬自苦坐毛颖，一梦微官陪螱飞。\n夜久南枝翻倦鹊，茫茫月白众星稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次喜雨诗韵以表随车之应","author":"范成大","text":"仙篆驱龙效水灵，佛螺吹梵演云经。\n何烦础汗生蒸润，便借炉薰作晦冥。\n一念故应周法界，万神元不隔明庭。\n昌时圭璧形声应，不似周时莫我听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵述怀约子文见过","author":"范成大","text":"灰木心形雪满头，鹤凫长短不悲忧。\n瓮畦纯白无机械，蒲局枭卢任博投。\n若爱陶陶并兀兀，先须莫莫与休休。\n个中情话谁能共，鸡黍明当挽仲由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再到虎丘","author":"范成大","text":"不过溪桥又两年，偶随筇竹访幽禅。\n有缘再踏云岩路，无处重寻石井泉。\n拟辍半山分座住，先携一枕借床眠。\n觉来饱吃红莲饭，正是塘东稻熟天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再渡胥口","author":"范成大","text":"古来此地快蓬心，天绕明湖日照临。\n一雁云平时隐现，两山波动对浮沉。\n衰髯都共荻花老，醉面不如枫叶深。\n罾户钓徒来问讯，去年盟在肯重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游天平有怀旧事且得卓庵之处呈寿老","author":"范成大","text":"访旧光阴二十年，残僧相对两依然。\n木兰已老无花发，石竹依前有麝眠。\n万户直须龟手药，一龛何用买山钱。\n从今半座须分我，共说昏昏一觉禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再题青城山","author":"范成大","text":"万里清游不暇慵，双旌换得一枝筇。\n来从井络直西路，上到江源第一峰。\n海内閒身输我佚，山中佳气为人浓。\n题诗试刻岩前石，付与他年藓晕重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再题瓶中梅花","author":"范成大","text":"园林篱落冻芳尘，南北枝间玉蕊皴。\n风袂挽香虽淡薄，月窗横影已精神。\n雪霜春事年年晚，今古诗情日日新。\n铁石如翁犹索句，真成嚼蜡对横陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘德修少卿避暑惠山因便寄赠","author":"范成大","text":"鸣凤朝阳尺五天，匆匆忽过白鸥边。\n遥怜海内无双士，独酌人间第二泉。\n决去君今身似叶，赠行谁有笔如椽。\n老夫但祝重相见，未拟消魂赋黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合江亭隔江望瑶林庄梅盛开过江访之马上哦此","author":"范成大","text":"何处春能早，疏篱限激湍。\n竹间烟雪迥，马上晚香寒。\n唤渡聊相觅，巡檐得细看。\n极知微雨意，未许日烘残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙真人庵","author":"范成大","text":"何处仙翁旧隐居，青莲巉绝似蓬壶。\n云深未到淘朱洞，雨小先寻炼药炉。\n涧下草香疑可饵，林间虎伏试教呼。\n閒身尽办供薪水，定肯分山一半无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙黄渡","author":"范成大","text":"舍舟从陆更间关，径仄仍荒亦未乾。\n棘刺近人牢闭眼，泥涂兀马紧扶鞍。\n茶山盗薮路程恶，麦垄人家怀抱宽。\n担仆舆夫尽劬瘁，病翁那得更加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乡县西晚泊","author":"范成大","text":"水阔鸟乌倦，墟寒童仆饥。\n一湾村县过，百折暮江迟。\n晓梦孤灯见，春阴病骨知。\n简书宁不畏，旅力奈先疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"州宅堂前荷花","author":"范成大","text":"凌波仙子静中芳，也带酣红学醉妆。\n有意十分开晓露，无情一饷敛斜阳。\n泥根玉雪元无染，风叶青葱亦自香。\n想得石湖花正好，接天云锦画船凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答澹庵小偈","author":"范成大","text":"莫问前程事，漂然海上舟。\n命乖逢鬼国，缘合遇蓬丘。\n毕竟非身计，俱成错路头。\n故乡随脚是，流浪不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题索桥","author":"范成大","text":"织簟匀铺面，排绳强架空。\n染人高晒帛，猎户远张罿。\n薄薄难承雨，翻翻不受风。\n何时将蜀客，东下看垂虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠勤长老","author":"范成大","text":"从君挥麈演金乘，我已无心缠葛藤。\n第一圆通三鼓梦，大千世界一窗灯。\n罢参柏子庭前意，权作梅花树下僧。\n饭饱閒行复閒坐，人间有味是无能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早发竹下","author":"范成大","text":"结束晨装破小寒，跨鞍聊得散疲顽。\n行冲薄薄轻轻雾，看放重重叠叠山。\n碧穗炊烟当树直，绿纹溪水趁桥弯。\n清禽百啭似迎客，正在有情无思间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早衰","author":"范成大","text":"早衰头脑已冬烘，信拙心情似苦空。\n僚旧姓名多健忘，家人长短总佯聋。\n一窗煖日棋声里，四壁寒灯药气中。\n晚景只消如此过，不堪拈出教儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早衰不寐","author":"范成大","text":"官事拘挛似力田，作劳归晚意茫然。\n按摩合体俱非我，展转通宵似远年。\n一叟披衣惟兀坐，群儿得枕便佳眠。\n人生元是华胥客，休向迷涂更著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]