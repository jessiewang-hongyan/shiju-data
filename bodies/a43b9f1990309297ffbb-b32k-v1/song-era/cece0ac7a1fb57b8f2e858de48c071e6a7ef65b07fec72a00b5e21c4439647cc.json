[{"title":"童丱须知 酒醴八篇 其六","author":"史浩","text":"女子亲傍礼法拘，合移孝道事翁姑。\n若还径醉无醒日，亦自无心相厥夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 酒醴八篇 其七","author":"史浩","text":"居家姆传未曾成，才及笄年便有行。\n中馈既然长酩酊，儿孙婢仆尽纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 酒醴八篇 其八","author":"史浩","text":"休说私酤趁得钱，官场警捕致忧煎。\n锥刀未必成家计，家计因兹却荡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其一","author":"史浩","text":"圣主勤勤欲措刑，何尝黩武爱兴兵。\n四方罢贡伤生物，愈见仁恩浃有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其二","author":"史浩","text":"设牧端因飨鬼神，大亨亦为养贤人。\n抡材祈福缘何事，只为苍生不为身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其三","author":"史浩","text":"滹沱麦饭出匆匆，禁脔天厨未必丰。\n若使平安能念此，铏羹土塯古人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其四","author":"史浩","text":"嗟见时人大侈生，八珍同聚一杯羹。\n若知过口成污秽，何用留心事割烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其五","author":"史浩","text":"物因相胜还相啖，弱者多为强者亨。\n勿谓天教充食类，斯人岂为虎狼生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其六","author":"史浩","text":"二膳朝朝饱即休，何须嗜杀苦营求。\n鱼虾蟹蛤皆微细，数百方能满一瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其七","author":"史浩","text":"飞潜蠕动尽贪生，就死无辜或自鸣。\n只可为亲甘旨具，自家口腹莫频亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 膳羞八篇 其八","author":"史浩","text":"戒杀当知有数端，闻声见死敢加餐。\n居家自作专因我，虽美还应下箸难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其一","author":"史浩","text":"随宜首饰莫留情，珠翠虽多未是荣。\n不见孟光居俭约，荆钗却立万年名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其二","author":"史浩","text":"南蕃有鸟翠葳蕤，千百为群自在飞。\n负痛衔冤无罪死，将来贵室缕冠衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其三","author":"史浩","text":"贵家所好若无偏，翠羽真珠不直钱。\n簪珥一求难得货，穷山深海尽骚然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其四","author":"史浩","text":"生灵膏血是缗钱，买得珍珠颗颗圆。\n痛惜鲛人在深海，风潮沉溺几多船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其五","author":"史浩","text":"北珠天产在戎蕃，不定还看走玉盘。\n钜万费钱收拾得，到头终不救饥寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其六","author":"史浩","text":"绣草铺茸玉作冠，四时花样几千般。\n当思蓬首寒窗女，终岁无油两鬓乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其七","author":"史浩","text":"倡优卑贱起淫风，涂泽唯知特地浓。\n珍重贤门贞洁女，不施朱粉自雍容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 梳妆八篇 其八","author":"史浩","text":"常须默坐悟前因，为爱铅华堕女身。\n若也于斯能改悔，来生定免落风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其一","author":"史浩","text":"后稷星光灿混仪，天教堕地作农师。\n牛羊腓字寒冰暖，自有神明默护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其二","author":"史浩","text":"方册尝观无逸书，更于七月诵豳诗。\n周公爱主真深切，稼穑艰难先使知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其三","author":"史浩","text":"能述先王播殖功，伯禽之后有僖公。\n故虽牧养駉駉盛，务惜吾农不起戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其四","author":"史浩","text":"文帝年年下玺书，唯忧农亩不丰馀。\n匈奴嫚侮吾甘忍，所喜千仓饱贮储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其五","author":"史浩","text":"武帝征诛不厌频，太仓无复有陈陈。\n末年户口多虚耗，却始封侯欲富民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其六","author":"史浩","text":"古者四民今六民，为添释老不耕耘。\n三农重困皆因此，况有张颐百万军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其七","author":"史浩","text":"勿嫌糠秕勿嫌陈，当念农家种苦辛。\n输得逋租盈廪廥，却归耕陇作饥民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"童丱须知 稻粱八篇 其八","author":"史浩","text":"代耕有禄及婴孩，饮啄当知所自来。\n若也食焉无怠事，庶于报国有涓埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天申节锡宴当筵致语口号 其一","author":"史浩","text":"帝眷炎图亿万秋，真人秉箓御神州。\n通和邻壤边声息，仁浃群生协气流。\n一札凤飞琼苑诏，千官花拥醉乡游。\n江城今日腾嘉颂，遥认中天绛阙浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天申节锡宴当筵致语口号 其二","author":"史浩","text":"邑近蓬莱萃刘真，晓看簪履望尧云。\n三呼请祝圣人寿，亿载长为天下君。\n荷柄飞香浮碧斝，榴花照座舞红裙。\n更听既醉升平雅，始信宸恩浃海垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天申节望阙祝圣致语口号 其一","author":"史浩","text":"簪缨万国拱尧云，遥认霏烟霭帝阍。\n始听嵩呼遍夷夏，便知孝治感乾坤。\n凤飞一札蟠桃宴，花覆千官湛露恩。\n历数在躬无纪极，垂衣请颂有虞尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天申节望阙祝圣致语口号 其二","author":"史浩","text":"万国星联拱北辰，晓看簪履拜尧云。\n三呼请祝圣人寿，亿载长为天下君。\n乐奏广庭声缥缈，香腾寰海瑞氤氲。\n太平今日非无象，花覆千官玉脸熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上明良庆会阁碑致语口号","author":"史浩","text":"绵绵宝历与天长，兴运重光属我皇。\n德洽化隆超汉晋，父慈子孝协虞唐。\n三阶顺轨时万泰，万国归心道益昌。\n一自皋陶赓载后，于今始得颂明良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔父知县庆宅并章服致语口号","author":"史浩","text":"簪缨济济佩锵锵，竞集华堂献寿觞。\n朱绂始闻新命诰，青毡俄睹旧门墙。\n梁闱琴瑟声俱妙，谢砌芝荪气倍香。\n烂醉莫嫌欢未彻，从今三万六千场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代人纳婿亲会致语口号","author":"史浩","text":"人物宣城妙九州，乘龙果是属清流。\n相逢解赋澄江练，上胜都归叠嶂楼。\n画戟林中银漏迥，香梅影底玉杯浮。\n洞房咫尺笙歌沸，谁道华胥祇梦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔父盐簿庆宅致语口号","author":"史浩","text":"清晓簪裾碾画轮，更循玉砌拥兰荪。\n定知广厦新遗址，来向华堂上寿樽。\n歌遏锦云声缥缈，舞攒星蜡影翩翻。\n剩须拚却如泥醉，显拜行符驷马门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馀姚待县官致语口号","author":"史浩","text":"浙右风烟属舜亭，几年才此萃群英。\n棠敷灵荫连天阔，湖泛恩波澈底清。\n醉吸霞光金盏窄，笑扶花影玉山倾。\n定知太史先占瑞，天外祥星一处明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":