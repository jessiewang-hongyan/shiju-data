[{"title":"运司园亭 茅庵","author":"杜敏求","text":"深深竹林下，圆庵最幽僻。\n高怀本恬旷，野趣助閒适。\n众人奔名徒，浮世萦物役。\n岂知庵中乐，道胜心自逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运司园亭 海棠轩","author":"杜敏求","text":"东风开百花，独有海棠胜。\n猩血染珠玑，点缀枝条䞉。\n日暖锦段新，雨馀燕脂凝。\n何待东閤梅，方能动诗兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运司园亭 雪峰楼","author":"杜敏求","text":"西山最高峰，积雪连四季。\n登楼试寓目，入国有故地。\n烽候虽久息，武经思豫备。\n文饶昔筹边，公意今无愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运司园亭 湲玉亭","author":"杜敏求","text":"林亭幽且深，砌下玉溪水。\n淙琤环佩声，晓夕清心耳。\n使君性所乐，爱玩不少已。\n方持利物心，默坐穷至理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运司园亭 翠锦亭","author":"杜敏求","text":"材大难为用，尝誇古柏篇。\n亭前老楩楠，黛色亦参天。\n夏暑借清阴，秋籁得自然。\n有如爱庭楸，朝暮东西偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杜敏求","text":"农夫苦相问，燮理是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山古调","author":"杜曾","text":"滥觞岷山侧，朝宗盖自然。\n沸沸出幽窦，滔滔成巨川。\n深流疑彻地，远势欲浮天。\n万石攒若斗，一流泻如悬。\n二蜀通货博，三峡为防坚。\n上下比难险，往来争溯沿。\n冲高濆气盛，转急汹形圆。\n行人戒仲夏，招子尚耆年。\n风波虽灭裂，滩碛且丛骈。\n湍声混蛮市，涨润入畬田。\n旁临股且栗，顺下目无前。\n浮沫逢槎聚，垂瀑依岸穿。\n哀猿藏森耸，渴鹿听潺湲。\n幽胜祠宇密，倾危村舍联。\n寒沙淹宿雨，暖溆罩春烟。\n青芜随远曲，白鸟戏轻涟。\n常经祗名利，旧隐多神仙。\n至清逃鳅鳝，极奥容鲟鳣。\n楚臣忠义郁，巫女威福专。\n龙骧战具敏，鲧嗣导功全。\n瞿唐十里暗，滟滪一邱偏。\n砥柱未足拟，吕梁诚浪传。\n伊予非智者，被命徒勉旃。\n尺短纠列郡，寸进乘孤船。\n一步一篙探，百丈百夫牵。\n通夕但耿耿，终日惟乾乾。\n废职罹罪罟，委命通化甄。\n寄言千金子，狂狷可闻焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅林分韵得爱字","author":"吕及之","text":"去城十里南郊外，突兀老梅馀十辈。\n玉雪为骨冰为魂，气象不与凡木对。\n我来穷冬烟雨晦，把酒从公对公酹。\n人言此实升庙堂，埋没荒村今几岁。\n清芳不为无人改，捐弃何妨本根在。\n瑰章妙语今得公，国色天香真有待。\n归路从公巾倒戴，俗物污人非所爱。\n我公行向日边归，此段风流入图绘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安济桥","author":"杜德源","text":"驾石飞梁尽一虹，苍龙惊蛰背磨空。\n坦途箭直千人过，驿使驰驱万国通。\n云吐月轮高拱北，雨添春色去朝东。\n休誇世俗遗仙迹，自古神丁役此工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"镜","author":"杜樗隐","text":"铸就揩磨不计工，岂量资质本顽铜。\n面前毫发曾无隐，背后看来便不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过董孝君祠","author":"杜醇","text":"湖环阚麓任清涟，古庙尘埋自汉传。\n剑吐寒芒愤已雪，碑刊轶事墨犹鲜。\n芳名百世留青史，至行千年启后贤。\n爵禄可辞甘海曲，富春耕钓与骈肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 湖上","author":"杜旟","text":"放扁舟、万山环处，平铺碧浪千顷。\n仙人怜我征尘久，借与梦游清枕。\n风乍静。\n望两岸群峰，倒浸玻璃影。\n楼台相映。\n更日薄烟轻，荷花似醉，飞鸟堕寒镜。\n中都内，罗绮千街万井。\n天教此地幽胜。\n仇池仙伯今何在，堤柳几眠还醒。\n君试问。\n□此意、只今更有何人领。\n功名未竟。\n待学取鸱夷，仍携西子，来动五湖兴。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 春","author":"杜旟","text":"春风如客，可是繁华主。\n红紫未全开，早绿遍、江南千树。\n一番新火，多少倦游人，纤腰柳，不知愁，犹作风前舞。\n小阑干外，两两幽禽语。\n问我不归家，有佳人、天寒日暮。\n老来心事，唯只有春知，江头路，带春来，更带春归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 石头城","author":"杜旟","text":"江山如此，是天开万古，东南王气。\n一自髯孙横短策，坐使英雄鹊起。\n玉树声消，金莲影散，多少伤心事。\n千年辽鹤，并疑城郭非是。\n当日万驷云屯，潮生潮落处，石头孤峙。\n人笑褚渊今齿冷，只有袁公不死。\n斜日荒烟，神州何在，欲堕新亭泪。\n元龙老矣，世间何限馀子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花二首 其二","author":"来氏","text":"花盟平日不曾寒，六月曝根高处安。\n待得秋残亲手种，万姬围绕雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花二首 其一","author":"来氏","text":"瑶池来宴老仙家，醉倒风流萼绿华。\n白玉断笄金晕顶，幻成痴绝女儿花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正命诗","author":"来廷绍","text":"病卧僧房两月多，英雄壮志渐消磨。\n昨宵饮药疑尝胆，今日披衣似挽戈。\n分付家人扶旅榇，莫教释子念弥陀。\n此心不死谁如我，临了连声三渡河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洞庭","author":"来廷绍","text":"日落君山暮，秋风过洞庭。\n一官身外物，千里客中情。\n北望乡关远，南来旅雁鸣。\n孤帆无限恨，斜指岳阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭夜泊","author":"来廷绍","text":"两岸树苍苍，孤舟湘水旁。\n猿声啼不住，明月照篷窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子猷访戴","author":"来梓","text":"四山摇玉夜光浮，一舸玻璃凝不流。\n若使过门相见了，千年风致一时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜甫游春","author":"来梓","text":"典尽春衣不肯归，熊儿扶过瀼溪西。\n伤时怀抱深于海，掠眼风光醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言二首 其二","author":"来梓","text":"行空月不著相，出岫云无恋心。\n胸中一丘一壑，不矶城市山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言二首 其一","author":"来梓","text":"叶淅历而争堕，菊徘徊而尚开。\n流年逼人太甚，佳客折简不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杨万毕","text":"千里暮云山已黑，一灯孤馆酒初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一鹭先立池中，有双鹭自外来。先立者逐之，双鹭亟去，莫敢敌者","author":"杨万里","text":"鹭鸶各自有食邑，长恐诸侯客子来。\n一鹭忽追双鹭去，穷追尽处始飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁亥正月新晴晚步二首 其二","author":"杨万里","text":"急下柴车踏晚晴，青鞋步步有沙声。\n忽逢野沼无人处，两鸭浮沉最眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁亥正月新晴晚步二首 其一","author":"杨万里","text":"嫩水春来别样光，草芽绿甚却成黄。\n东风似与行人便，吹尽寒云放夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉四月十日之官毗陵舟行阻风宿椆陂江口二首 其一","author":"杨万里","text":"虫声两岸不堪闻，把烛销愁且一尊。\n谁宿此船愁似我，船篷犹带烛烟痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁酉四月十日之官毗陵舟行阻风宿椆陂江口二首 其二","author":"杨万里","text":"十里江行一日程，出山似被北风嗔。\n东窗水影西窗月，并照船中不睡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕新凉","author":"杨万里","text":"商量秋思是寒螀，将息荷花得早凉。\n五岭从来说炎热，朝来已怯葛衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月二十三日题李亨之墨梅","author":"杨万里","text":"夏热秋逾甚，寒梅暑亦开。\n无尘管城子，幻出雪枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月二十五日晓登多稼亭","author":"杨万里","text":"风将烟雨入亭寒，城引山林拓眼宽。\n六月登临浑觉热，朝来不敢傍危栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月十四日雨后毗陵郡圃荷桥上纳凉","author":"杨万里","text":"荷叶迎风听，荷花过雨看。\n移床桥上坐，堕我镜中寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月既望晚观菱壕","author":"杨万里","text":"官壕水落两三痕，正是秋初雨后天。\n菱荇中间开一路，晓来谁过采菱船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月十五夜月细看桂枝北茂南缺未经古人拈出纪以二绝句 其二","author":"杨万里","text":"青天如水月如空，月色天容一皎中。\n若遣桂华生塞了，姮娥无殿兔无宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月十五夜月细看桂枝北茂南缺未经古人拈出纪以二绝句 其一","author":"杨万里","text":"桂树冰轮两不齐，桂圆不似月圆时。\n吴刚玉斧何曾巧，斫尽南枝放北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日雨寒五首 其五","author":"杨万里","text":"只见春晴道是晴，不知半夜嫩寒生。\n疾风吹落林间雨，细雨还成大雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日雨寒五首 其四","author":"杨万里","text":"姚黄魏紫向谁赊，郁李樱桃也没些。\n却是南中春色别，满城都是木绵花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日雨寒五首 其三","author":"杨万里","text":"梳头正美睡相催，理尽霜丝梦恰回。\n窗隙小风能几许，也吹蛛网去还来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日雨寒五首 其二","author":"杨万里","text":"补尽窗棂闭尽门，茶瓯火阁对炉熏。\n中庭浅水休教扫，政要留看雨点纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日雨寒五首 其一","author":"杨万里","text":"南方气候北方殊，春里清寒腊里无。\n雨入竹林浑不见，只来叶尾作真珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日郡圃寻春二首 其二","author":"杨万里","text":"花绕朱檐柳绕栏，小亭面面锦团栾。\n春风横欲欺诗瘦，且下东窗护嫩寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日郡圃寻春二首 其一","author":"杨万里","text":"中和节里半春天，一拂清寒半点暄。\n憔悴不胜梅欲落，娇饶无对杏初繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日晓渡太和江三首 其三","author":"杨万里","text":"二月初头春向中，花梢薄日柳梢风。\n折花客子浑无赖，狼藉须教满路红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日晓渡太和江三首 其二","author":"杨万里","text":"晓翠妨人看远山，小风偏入客衣单。\n桃花爱做春寒信，只恐桃花也自寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月一日晓渡太和江三首 其一","author":"杨万里","text":"绿杨接叶杏交花，嫩水新生尚露沙。\n过了春江偶回首，隔江一片好人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十三日南雄解舟二首 其二","author":"杨万里","text":"水没蒲芽尚有梢，风吹屋角半无茅。\n急滩未到先闻浪，枯树遥看只见巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二十三日南雄解舟二首 其一","author":"杨万里","text":"昨夜新雷九地鸣，今朝春涨一篙清。\n顺流更借江风便，此去韶州只两程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十一日夜梦作东都蚤春绝句","author":"杨万里","text":"道是春来早，如何未见春。\n小桃三四点，偏报有情人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十九日度大庾岭题云封寺四首 其四","author":"杨万里","text":"行者南来今几春，一回举似一回新。\n钵盂夺得知何用，不怕梅花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十九日度大庾岭题云封寺四首 其三","author":"杨万里","text":"梅叶成阴梅子肥，梅花应恨我来迟。\n明年若寄江西信，莫折南枝折北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十九日度大庾岭题云封寺四首 其二","author":"杨万里","text":"小立峰头望故乡，故乡不见只苍苍。\n客心恨杀云遮却，不道无云即断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十九日度大庾岭题云封寺四首 其一","author":"杨万里","text":"梅山未到未教休，到得梅山始欲愁。\n知道望乡看不见，也须一步一回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其八","author":"杨万里","text":"除却牡丹了，海棠当亚元。\n艳超红白外，香在有无间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其七","author":"杨万里","text":"老子侵星起，蜂儿先我忙。\n渊才无鼻孔，信口道无香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其六","author":"杨万里","text":"外种百来树，中安一小亭。\n放眸红未了，红了是天青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其五","author":"杨万里","text":"花密无重数，看来眼转迷。\n化为花世界，忘却日东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其四","author":"杨万里","text":"四面花光合，一身香雾红。\n忽从霞绮上，跳下锦城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其三","author":"杨万里","text":"晚得看花诀，丁宁趁绝晨。\n乘他醉眠起，别是一精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其二","author":"杨万里","text":"初日光殊薄，晴梢露正浓。\n真珠妆未稳，更著柳边风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日晓起看海棠八首 其一","author":"杨万里","text":"过雨天犹湿，新晴日尚寒。\n悬知晓妆好，破雾急来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日梅花二首 其二","author":"杨万里","text":"树劲春犹瘦，花寒暮更明。\n平生岂无句，此外不须清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十四日梅花二首 其一","author":"杨万里","text":"雨打知无那，春暄绝不禁。\n小风千点雪，落日一须金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月将半寒暄不常","author":"杨万里","text":"南中冷暖直难齐，一日之间具四时。\n脱了又添添又脱，寒衣暑服镇相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日","author":"杨万里","text":"海棠著意唤诗愁，桃李才开又落休。\n小雨轻风春一半，去年今日在严州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日劝农既归散策郡圃二首 其二","author":"杨万里","text":"今年花事许迟迟，九十春光已半归。\n风急杏花吹不脱，落梅无数掠人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日劝农既归散策郡圃二首 其一","author":"杨万里","text":"荆溪老守劝农归，吏散还从郡圃嬉。\n拾得落英才一掬，春风苦向掌中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二含笑俱作秋花","author":"杨万里","text":"秋来二笑再芬芳，紫笑何如白笑强。\n只有此花偷不得，无人知处忽然香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其十","author":"杨万里","text":"此行殊匆匆，天色不肯借。\n更待海棠晴，满意孤山下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其九","author":"杨万里","text":"上竺雪来时，四山都作冻。\n团团玉屏风，围绕浑无缝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其八","author":"杨万里","text":"客爱清殊绝，僧愁冻不胜。\n可怜兜率寺，斋供一湖冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其七","author":"杨万里","text":"去岁游春屐，苔痕故可寻。\n人家随岸远，塔影落湖深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]