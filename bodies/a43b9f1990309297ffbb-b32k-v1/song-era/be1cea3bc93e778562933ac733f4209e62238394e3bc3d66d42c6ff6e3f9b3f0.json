[{"title":"黄霸","author":"薛季宣","text":"称职关东汉吏良，作公名损浩难量。\n试看鹖雀为神雀，无复飞蝗食凤皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"假日","author":"薛季宣","text":"拖被蒙头贪睡足，莎庭卧鼓喏衙迟。\n宾僚莫讶吾慵甚，忙里偷閒亦暂时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将归","author":"薛季宣","text":"阅世光阴云掣电，忘形踪迹浪浮萍。\n翩然行逐西风去，聊复人间得此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏寄清虚先生","author":"薛季宣","text":"鼾睡懒醒先处士，回光坐照老宾州。\n西来大笑朝天子，一宿不为桑下留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻前月时事君举象先皆与南宫之选是日读易诗春秋作四首 其一","author":"薛季宣","text":"一阳萌动黄宫下，正是寒威合海时。\n闭户先生莫惆怅，雷行龙跃定前期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻前月时事君举象先皆与南宫之选是日读易诗春秋作四首 其二","author":"薛季宣","text":"我行永久亦何伤，仆马痡瘏不是忙。\n田卒污莱皇父去，憖遗将若守吾王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻前月时事君举象先皆与南宫之选是日读易诗春秋作四首 其三","author":"薛季宣","text":"忧河之浊泣清之，每笑周人切见几。\n麟史究观王室乱，异情元不是公非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻前月时事君举象先皆与南宫之选是日读易诗春秋作四首 其四","author":"薛季宣","text":"我不知人人我知，体交无味亦何为。\n朝阳鸣凤翔千仞，却是梧桐实未离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州图次元修韵三首 其一","author":"薛季宣","text":"导水要穷神禹迹，驱山每恨始皇移。\n晋家安石非无事，高镇神头有著棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州图次元修韵三首 其二","author":"薛季宣","text":"瞿聃尽道色非色，愚圣共知东是东。\n一纸画图都掌大，谁言遮壁意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州图次元修韵三首 其三","author":"薛季宣","text":"笺书莫笑虫鱼注，善学须通天地心。\n到尽粤南并蓟北，始知前古是来今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书敬仲兄枕屏","author":"薛季宣","text":"野趣知兄爱泉石，风屏少试秋毫力。\n纤煤点染出云天，万里江山安枕席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归计二首 其一","author":"薛季宣","text":"浮云何处是生涯，念绝营营即是家。\n洗脚渡头归去也，汉津无用逐灵槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归计二首 其二","author":"薛季宣","text":"置锥无地亦无锥，幸可归来特地疑。\n船子月轮贫未破，罗浮焉用石头为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青田同七五兄作四首 其一","author":"薛季宣","text":"为闻双鹤访青田，便有孤云竟目前。\n滩水自鸣山自绿，短篷斜挂得酣眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青田同七五兄作四首 其二","author":"薛季宣","text":"鸟云送雨过前山，白鸟将雏向远湾。\n独立溪亭无个事，湍流泷石镇潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青田同七五兄作四首 其三","author":"薛季宣","text":"浩歌欸乃客销魂，一抹烟林暝远村。\n花为忘忧人一笑，不知风雨作黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青田同七五兄作四首 其四","author":"薛季宣","text":"溪翁夜傍清溪立，千尺丝纶一红粒。\n天空月白不见人，无声露滴蘋蓑湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追和宝山昼睡","author":"薛季宣","text":"浮生化国总轻尘，已自忘真那得真。\n无物从教尽空洞，可须容著许多人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏作赠别效东坡体次其韵","author":"薛季宣","text":"茹菜羹时尝苦忆，摴蒱无路塞行期。\n难逢莫恨丝长断，金锁开缄自有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中鹤唳","author":"薛季宣","text":"十万虚屯野次兵，不逢苻诏寿阳城。\n愁云惨淡雨来急，鸣鹤一声天未晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"啄木","author":"薛季宣","text":"蝎谮区区切考求，饥肠一饱又何尤。\n要能去蠹无遗种，寥落空林死便休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莺","author":"薛季宣","text":"绵蛮巧语庆青春，金线低垂柳色新。\n定自知时厌流荡，归来空谷混泥尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读鬼诗拟作二首 其一","author":"薛季宣","text":"坐对悲风啸晚山，征鸿不记几回还。\n青铜蚀破菱花面，慵掠乌云绾髻鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读鬼诗拟作二首 其二","author":"薛季宣","text":"至乐纷华苦未真，至游无朕亦无身。\n细看浮世多尘坌，如我得归能几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斯 其一","author":"薛季宣","text":"猎尽山东六暴强，脩明律令起秦皇。\n还思税驾知无地，逐兔应当尔许忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斯 其二","author":"薛季宣","text":"诗书灰烬便秦文，便得秦王却误身。\n斯具五刑秦再世，六经还有表章人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李斯 其三","author":"薛季宣","text":"刚从孙卿学帝王，为羞贫贱速危亡。\n威严无复人居上，自处应惭厕鼠方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"燕太子","author":"薛季宣","text":"意气宁知错感人，姬丹秘计谩危亲。\n亡燕拜送于期首，政使荆卿趣帝秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后忆龙翔寺 其一","author":"薛季宣","text":"二峰高峙夹禅扃，长落潮音逐磬声。\n老僧睡起绝无事，不管波涛四面生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后忆龙翔寺 其二","author":"薛季宣","text":"窣堵东西岌两峰，王宫今日梵王宫。\n潮船八面来勍敌，都入禅师燕坐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋意","author":"薛季宣","text":"月娥素魄溢婵娟，金吹凄凉冷淡天。\n野水暝烟枫叶暮，黄花红蓼独嫣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻蝉 其一","author":"薛季宣","text":"自辟筠乡五亩阴，蝉声无处不相寻。\n炎天唤起秋萧索，便拟乘风绕邓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻蝉 其二","author":"薛季宣","text":"新蝉无数咽琅玕，引惹凉生六月寒。\n已自东山誉高洁，未须丹翅拟笙鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"村居秋暮","author":"薛季宣","text":"风回偃水縠纹平，林末它山笔架横。\n场圃未閒黄叶下，鹁鸠啼雨忽啼晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡香","author":"薛季宣","text":"君子夺朱有恶，祖师噩梦寻香。\n莫问两重公案，且须一曲霓裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"摴蒱","author":"薛季宣","text":"一局閒寻五木经，橛枭卢白意冥冥。\n未能后掷如前掷，将奈长亭又短亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公叔次开窗诗漫答","author":"薛季宣","text":"不同夷甫坐谈空，烂醉凫鹥灭没中。\n闻说诗豪君是否，好磨长剑倚崆峒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽兰次十八兄韵六言四首 其一","author":"薛季宣","text":"宛在一人空谷，居然九畹深林。\n襟袖不盈披拂，车辙无踪可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽兰次十八兄韵六言四首 其二","author":"薛季宣","text":"有美中郎芝砌，言采渊明菊丛。\n会取个中香气，萧然林下家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽兰次十八兄韵六言四首 其三","author":"薛季宣","text":"舞奏八风芗泽，颂声焱氏遗音。\n允也不夷不惠，悠哉非古非今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽兰次十八兄韵六言四首 其四","author":"薛季宣","text":"超出世间凡品，叵闻鼻观馀香。\n春入有花不艳，院小无人自芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诏书屯田湖北相土西乡属暑雨中旬转入洪道时雨初霁溪山葱泚如在缙云荆坑道中子规之声相闻属道","author":"薛季宣","text":"沐雨驱车涉败桥，平原渺渺涨江潮。\n华容葭苇凭谁燎，赤壁艨艟徒自烧。\n一路规啼情悄悄，九皋鹤唳思摇摇。\n道东直指松门去，酷似故乡归路遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书颜子传后","author":"薛季宣","text":"几庶都缘有若无，宁论刍狗矧蘧庐。\n要须非复周公梦，而亦何为子夏书。\n行苇至仁均草木，中孚大信洽豚鱼。\n穷神至命知奚事，不远周流意六虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月三夜梦观某人诗什其书一章四绝盖绝笔也走读竟太一真人来告语青猿手里得长书静闻丹灶风中雨之句梦而默记之寤矣作诗导意","author":"薛季宣","text":"多谢真人警梦书，青猿驯扰尚趑趄。\n任从炉鼎喧风雨，争奈神明复古初。\n君乐鍊形咀丹火，我甘饮水灌园蔬。\n惟当敬佩终焉意，子欲无言致匪虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读伊川易传","author":"薛季宣","text":"太极非名岂自然，由知辟阖见坤乾。\n先天讵必违中古，上古应须得后天。\n至密退藏那有迹，惟几成务尚容研。\n从教变易能从道，不似神龙得性全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樊口见郑崇阳不遇","author":"薛季宣","text":"经时兀兀坐筠乡，命驾崎岖傍夕阳。\n岛屿西陵开罨画，湖山东鄂洗新装。\n路侵细草迷繁绿，风落閒花忆旧香。\n却上渡船归去也，不逢安道故无妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诚台晚意","author":"薛季宣","text":"麦夏西山日脚斜，峰云千里尽丹霞。\n晴岚榱桷水春涨，芳草园林路晚花。\n远近子规啼怨抑，高低乳燕语淫哇。\n官身归是何年社，信美诚台不似家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晨赴寒溪寺乾龙节道场所","author":"薛季宣","text":"晓入招提旋即还，去何忙遽到非閒。\n寒溪日出射烟雾，退谷路荒埋草菅。\n林尽远峰晴历历，丛深流水暗潺潺。\n归途钟鼓依稀似，将谓禅居别有山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新晴","author":"薛季宣","text":"起人舒惨作阴晴，九十春光祇雨零。\n宿草未萌波漠漠，落花归尽叶青青。\n风生远峤衔明月，雾潋长江吐涨汀。\n天意乍回心自广，片时云路觉无形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胜亭雪望","author":"薛季宣","text":"上元云路玉尘飞，应是虬骖罢会归。\n望合郊原人世变，映浮城郭夜灯微。\n连天忘却黄冈县，际水平将赤壁矶。\n滚滚长江耐澄挠，浪回鸥鸟一惊翚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和贾簿","author":"薛季宣","text":"澄江风定也清寒，咫尺浑疑醉梦间。\n雪满后湖真是浪，云平西塞且无山。\n轻鸥弄水情无限，远雁书空时自还。\n静极要当随众乐，归来灯火闹朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和贾簿胜亭雪眺","author":"薛季宣","text":"携壶命侣燕江干，雪起颓垣甃玉栏。\n减水湖中还素浪，明云天际失青山。\n无端大火寒无艳，不奈生柴苦不乾。\n断岸芦洲见残月，一钩忤视却前湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮止亭即事","author":"薛季宣","text":"艮止危亭欲暮春，湖山江外翠眉颦。\n鸟啼夕月清歌扇，花发荒原闹舞裀。\n吴老洞迷青草暗，陶公宅古绿萝新。\n怀归何日成归计，不忿端居作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊船","author":"薛季宣","text":"泊船在处即吾家，鲜得熸烹爨有槎。\n弄景日移烟岸柳，流香风度野薇花。\n霞翻锦段浮江渚，水落涛纹隐岸沙。\n块坐朅来无一事，夜深远烧起殷霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从孙元式假定本韩文","author":"薛季宣","text":"杨墨衰周亦既微，仙昙变夏用戎夷。\n回澜岂直万人敌，断简传将百世师。\n脱落间亡乌鲗墨，蠹残宁免白鱼辞。\n校雠歆向君无愧，聊以新诗当一瓻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校毕归之","author":"薛季宣","text":"倒墨扶周复古文，清辉万丈醇乎醇。\n七篇奥义远相继，六代潜光今又新。\n字假通才识鱼鲁，车惭寡学改金银。\n异书喜得君无靳，此道中兴知有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝农出郊","author":"薛季宣","text":"漫驱戎马说农郊，不见田畴见白茅。\n洪道晓晴明水底，羊澜春涨长林梢。\n红翻大泽霞方散，青入空原草渐苞。\n迎畯示民民自劝，可须杯酒荐烹炮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日龙山之集","author":"薛季宣","text":"年年九日登高会，九日登高年岁閒。\n黄菊茱萸应故泛，茱萸黄菊故应攀。\n今人不在古人后，往意可如兹意閒。\n风帽落檐谁得见，龙山还是昔龙山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冒雨渡江吊丧彭氏造雪堂夜归 其一","author":"薛季宣","text":"冲风栉雨乱西江，吊死裴回问雪堂。\n丛枳界无春草主，小桥踪在古碑荒。\n人存有政名空大，世远回思恨始长。\n旋棹晚云何限事，可堪瑞庆柳成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冒雨渡江吊丧彭氏造雪堂夜归 其二","author":"薛季宣","text":"月波楼下草芊芊，浪拍三江起暝烟。\n愿见古人人又去，欲询往事事无传。\n洼樽明灭渔家火，樊口依稀估客船。\n妻子迎门应怪笑，问君何谓苦愁煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酴醾花","author":"薛季宣","text":"东邻处子太优柔，醉倚阑干十二楼。\n清白有家传酝藉，醇醲无味饮风流。\n带摇翠幄苍蛟动，佩解虹梁绿蚁浮。\n嘉木自香香到骨，困人非酒欲谁酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牡丹","author":"薛季宣","text":"三春首出众芳菲，笑倚东风蹙翠眉。\n洛浦未翔要玉佩，汤泉新浴曳袿衣。\n无双可奈倾城恨，第一何堪代命为。\n桑柘不花花乍可，清霜谁是不空枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岩桂","author":"薛季宣","text":"群芳未许论芳馨，独自秋天卧月明。\n赖有幽香洞渊奥，宁将雅趣博轻盈。\n德纯不显娥皇怨，道大无闻叔度清。\n好向深岩伴黄石，可知谁与桂花名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天闺","author":"薛季宣","text":"扁舟一叶转寒溪，返照西阳日下西。\n旬浃不来江水涨，惊澜几欲上天闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武昌怀古","author":"薛季宣","text":"漠漠烟村一古城，郊坛离殿草茅生。\n青山不解知兴替，销黯开颜为雨晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"筠乡入夏野花方拆","author":"薛季宣","text":"墙匝丛丛绣舞裀，一般颜面各精神。\n筠乡不为东君去，野草閒花满路春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮止亭晚意","author":"薛季宣","text":"山影殊亭日转西，墙头历历片帆移。\n何人唤我频归去，侧耳疏篁怨子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮止亭阻雨旬日 其一","author":"薛季宣","text":"山亭无路少徘徊，跬步狂澜涨九垓。\n不是蜃楼浮海外，也应弱水限蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮止亭阻雨旬日 其二","author":"薛季宣","text":"艮止休工未落成，做人限隔雨零零。\n眼前好景到不得，便是霄中望极星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚渡东坡 其一","author":"薛季宣","text":"赤鼻矶头横曙烟，吴王城下浪连天。\n闻道东坡妙天下，尔来靡日不盘旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚渡东坡 其二","author":"薛季宣","text":"浮生万事尽尘埃，瑞庆堂今榜快哉。\n惟有东坡旧烟柳，道人犹解指莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行戍西山","author":"薛季宣","text":"帝驱貙虎旧江州，旅卜僧坊计少休。\n避暑有宫留不暇，游山算却是山游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]