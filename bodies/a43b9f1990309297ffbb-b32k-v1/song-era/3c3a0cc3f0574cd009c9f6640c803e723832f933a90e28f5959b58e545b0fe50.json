[{"title":"挽刘学谕玗 其一","author":"廖行之","text":"剑浦昔名族，湘川今世家。\n簪缨方赫奕，里巷正光华。\n岂意有馀庆，翻成不足嗟。\n哀哉天道远，福禄一何差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘学谕玗 其三","author":"廖行之","text":"声猷惊俗旧，科第策名新。\n筮仕甫从志，辞官复为亲。\n谁期一朝患，遽殒百年身。\n平昔经纶事，而今已古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘学谕玗 其二","author":"廖行之","text":"诗礼家传旧，箕裘世袭良。\n蚤同花萼秀，晚并桂椿芳。\n方恨违同气，那知叹肯堂。\n斯文今已矣，继踵属贤郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘学谕玗 其四","author":"廖行之","text":"学富犹无已，才雄非自成。\n诲人真不倦，接物有馀情。\n仅有抠衣便，俄惊逝水倾。\n丹旌嗟莫挽，忍听薤歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘宣教孝昌 其一","author":"廖行之","text":"夙世垂遗训，书林早策勋。\n敬诚跻至善，师友富多闻。\n棠棣两玉笋，闺门万石君。\n九原那可作，惆怅哽飞云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘宣教孝昌 其二","author":"廖行之","text":"暂出伸三釜，归安菽水心。\n立言存绝笔，遗子胜籯金。\n肝腑真堪托，情亲久亦深。\n交朋忘一鉴，哀泪满衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽朱监庙明二首 其二","author":"廖行之","text":"平生知己几何人，高谊如君最好亲。\n鹤盖不随青眼顾，鸡窗唯有白头新。\n今谁肯借周瑜宅，待我深知管仲贫。\n肠断眼穿明月岭，九河倾泪一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽朱监庙明二首 其一","author":"廖行之","text":"人间世事最堪悲，有子骑鲸去不归。\n客厩谩遗陶母荐，萱堂空对老莱衣。\n黄金榜上嗟陈迹，白玉阶前泣断机。\n赖有青毡存眼底，满庭兰玉侍亲闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽江西宋漕三首 其三","author":"廖行之","text":"櫑具曾承衣绣迎，学宫仍见选诸生。\n求文于白远何取，联第如詹时共荣。\n公自典刑多教化，人谁菑播赖生成。\n而今未报何侯力，万里神驰两泪倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽江西宋漕三首 其二","author":"廖行之","text":"牙筹坐席未全温，尚想星沙恋德门。\n剡牍方新蠲赋请，忧民不计此身存。\n平生大乐功何晚，寿相庞眉理莫论。\n云黯江南失春色，可堪杜宇更销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽江西宋漕三首 其一","author":"廖行之","text":"蚤岁才名画省郎，会纡玉节惠三湘。\n哀矜折狱人无怨，访问垂心虑最长。\n不便幽潜遗陋巷，更将文物萃书堂。\n期公四海皆膏泽，太息思贤殄瘁章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋知县刚仲二首 其二","author":"廖行之","text":"阀阅方成一段奇，三湘况是古来稀。\n弟兄同岁乘槎去，父子连科折桂归。\n诗礼传家人共羡，欢华过眼事俱非。\n秋风寂寞萱堂露，染尽当年戏綵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋知县刚仲二首 其一","author":"廖行之","text":"与君同志复同州，少日论文放一头。\n孝子忧亲双鬓白，痴儿了事一生愁。\n凌云意气须臾尽，积岁声名取次休。\n赖有遗编留史笔，几回废卷泪横流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李主簿长民二首 其二","author":"廖行之","text":"帝里从游情最亲，江头一别几经春。\n追思语笑恍如昨，时枉音书宁厌频。\n忧患自嗟非故我，昂藏不复见斯人。\n每哦风月无边句，西望潸然泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽李主簿长民二首 其一","author":"廖行之","text":"蚤擅湘中二妙声，一官政尔为亲荣。\n倦游未试胸中蕴，苦学徒遗身后名。\n踵武世科知有子，尽心色养足生平。\n可堪膝下称觞处，不见伯仁贤弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽谷子长 其三","author":"廖行之","text":"伊昔拜芝宇，词场话俊游。\n一从分袂日，五阅鲙鲈秋。\n别梦思何极，长川逝莫留。\n盖棺俄隔世，空遣泪横流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽谷子长 其一","author":"廖行之","text":"仁寿渠应尔，为君呼彼苍。\n若人奚所恨，夫我谓难量。\n好学颜何泯，多才贾遽亡。\n乘除馀庆在，薿薿看诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽谷子长 其二","author":"廖行之","text":"百岁三之日，如君乃若然。\n谢庭凋玉树，楚泽毙兰荃。\n堂有双亲老，身无寸禄缘。\n英魂傥犹在，泣我此诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈宣教直中","author":"廖行之","text":"回雁峰前忆隐沦，平生谋道不谋身。\n诗书满腹空名世，科第衰年独后人。\n赖有佳儿传素业，能令潜德上贞珉。\n交游半世今零落，忍望铭旌泪墨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽周守","author":"廖行之","text":"姓氏标千佛，功名老一麾。\n人皆嗟窘步，公不陋居夷。\n悃愊尤安静，廉明且惠慈。\n穷陬天弗佑，三月逝如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽周宣教宗沂二首 其二","author":"廖行之","text":"始别犹承笑语温，昭晖相望几晨昏。\n伻来骇听言传异，泪哽悲怀饱不餐。\n归拜文帷人已去，痛瞻灵室像徒存。\n反思博我谆谆意，何日能酬知遇恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽周宣教宗沂二首 其一","author":"廖行之","text":"子职勤劳众莫攀，巴丘高节世尤难。\n一官未抵琴书乐，三釜何如菽水欢。\n傥有轩裳存妙句，平居丰俭只儒酸。\n音容渺邈今何在，云黯江南万木寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽武宣教彻二首 其二","author":"廖行之","text":"书来撩我重思君，情比雍雍雁叫群。\n词赋一时高李杜，弟兄今日扫机云。\n未还金马日边诏，去作玉楼天上文。\n千里莫能亲视窆，篇诗寄挽亦徒云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽武宣教彻二首 其一","author":"廖行之","text":"三釜何如菽水长，毅然投劾奉归装。\n共钦箠楚辞巴岭，又听勾稽复楚乡。\n鸂鶒下滩谁御史，凤鸾栖棘漫仇香。\n绝怜五十三年笔，不草文园封禅囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽武宣教徯四首 其四","author":"廖行之","text":"哭公无计挽公留，痛写哀衷佐绋讴。\n丹旐姓名何所益，青编事业等闲休。\n长江百里浮清恨，明月孤峰起些愁。\n底事波神均此怨，白头寒浪拍空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽武宣教徯四首 其三","author":"廖行之","text":"呜咽钟悲子夜昏，灵椿摧折重销魂。\n数丝白雪遗慈母，一寸青松括耳孙。\n返哺声乾那可及，挽须情在不堪论。\n桂枝皎皎攲寒玉，伫看扬名振礼门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽武宣教徯四首 其二","author":"廖行之","text":"生平耿耿不忘君，位下才高气不群。\n手取科名如拾芥，眼高富贵等浮云。\n祇知世可行吾道，其奈天将丧此文。\n知遇莫酬今已矣，篇诗聊寓一哀云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽武宣教徯四首 其一","author":"廖行之","text":"南楚东吴万里长，几年来往共资装。\n公方著脚功名路，我办卜邻文物乡。\n雅意嘉招言在耳，赠行新句墨犹香。\n追思气概生涯语，诚意谆谆总括囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽唐学录颐 其二","author":"廖行之","text":"虎榜标名日，英声四海闻。\n传家惟奥学，有子继清芬。\n未熟黄粱梦，俄同冥漠君。\n哲人今已矣，无复更论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽唐学录颐 其一","author":"廖行之","text":"今代称纯孝，如公第一流。\n事亲惟婉顺，厉志只操修。\n德行浑无间，功名略未酬。\n空遗千古恨，明月一山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘宣教秉二首 其二","author":"廖行之","text":"道义君家振楚荆，嗟君功业负平生。\n诗书累世有底盛，簿领一官徒尔荣。\n亲族追思应重惜，慈颜怅望不胜情。\n灵輀远送松冈外，风雨凄凄猿鹤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘宣教秉二首 其一","author":"廖行之","text":"铭旌摇曳泪沾巾，为惜贤才生死分。\n乐道喜陪今漫道，高文谁与共论文。\n西湘岸脚送霜雨，明月岭头留暮云。\n有子登科真不朽，它年勋鼎慰严君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽黄承事三首 其三","author":"廖行之","text":"畴昔云天一睹披，十年徒有梦追随。\n担簦已负异时志，仰斗今馀后学师。\n夜壑舟亡人孰秘，少微名在世空悲。\n嗟嗟莫致徐刍奠，掩袂伤心陨泪洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽黄承事三首 其二","author":"廖行之","text":"不用籯金侈厚藏，无烦农圃富耕桑。\n一经父子韦编训，馀庆阶庭玉树芳。\n道义固堪绵有后，功名浑把付诸郎。\n他年窦桂诜诜报，当信于今种德香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽黄承事三首 其一","author":"廖行之","text":"肯为儒冠叹误身，直将富贵等浮云。\n谈棋柯腐尘劳想，读易编摩世俗纷。\n郑叟遽嗟年在己，卜商宁作地脩文。\n须知异日高人传，耿耿君平继有君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽龚主簿盖卿 其二","author":"廖行之","text":"奇士如公少，居然得誉尊。\n绩文追古作，献策达修门。\n梁坏吾安仰，人亡道尚存。\n伤心南野路，天迥暮云昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽龚主簿盖卿 其一","author":"廖行之","text":"当代文章伯，声名属太常。\n云衢方奋立，薤露忽悲伤。\n郤桂荣贤嗣，莱衣远北堂。\n苍天竟何意，忍使哲人亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽龚宣教世基 其一","author":"廖行之","text":"文物湘中盛，唯公独最优。\n麒麟来瑞世，鹏鹗快横秋。\n桂籍名方著，灯窗志少酬。\n居乡多令望，治国蕴嘉猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽龚宣教世基 其二","author":"廖行之","text":"游刃虽馀地，栖鸾试未周。\n仅伸三釜养，俄隔九泉幽。\n风树悲难弭，蒿莪痛曷瘳。\n平生无恨处，有子袭箕裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽雍宣教知义 其二","author":"廖行之","text":"忆昔居黉舍，曾陪戏綵斑。\n才华推粹美，功绩叹间关。\n有子能传业，无丹可驻颜。\n哀词临隧路，明晦万重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽雍宣教知义 其一","author":"廖行之","text":"早擢蟾宫桂，声名第一流。\n下帷潜大业，击楫志神州。\n修短林中木，浮沉水上沤。\n生刍今日奠，恻怆泪难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中寄武公望二首 其二","author":"廖行之","text":"轻去千金若弃遗，高情勇决固应稀。\n端来共我茅一把，不肯折君腰十围。\n世事弹棋无定局，人情蒙阱有深机。\n生涯也趁身强健，况是平阳德可依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中寄武公望二首 其一","author":"廖行之","text":"四十馀年尚转蓬，渠论南北与西东。\n但知爱子三迁教，不办谋生一亩宫。\n北海可怜真意广，步兵良苦漫途穷。\n人生择术须循分，鹏鴳逍遥自不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘买舟西归","author":"廖行之","text":"畴昔春江上，诗成感旧游。\n重来正炎日，还复理扁舟。\n兴逐轻帆远，愁随急雨收。\n三年四来往，依旧水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿田舍遇雨","author":"廖行之","text":"奔走尘埃日几西，又从舟楫问津涯。\n官身底事多羁束，世路由来足崄巇。\n甘雨也知苏䆉稏，轻风祗管舞涟漪。\n夕阳又傍田村宿，无限蜩螗噪晚飔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿田桥驿枕上口占","author":"廖行之","text":"屋敝漏疏星，魂清梦转惊。\n蛙鸣千百辈，鸟语两三声。\n意气浑干斗，尘劳未解缨。\n平生四方志，安肯效蝇营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿白湖即事","author":"廖行之","text":"乱蝉声里夕阳村，野寺荒凉竹映门。\n汩汩溪流新过雨，芃芃禾稼已平原。\n老僧不省论诗句，初月犹能共酒樽。\n莫为奔驰起归兴，东西南北一乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得长兄书","author":"廖行之","text":"雨馀清梦话踌躇，投晓敲门一纸书。\n尺组却能羁壮士，寸心浑欲驾飞车。\n青衫小吏谁知子，白发慈亲正念渠。\n只道为官志三釜，而今那似守阎闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清江道中","author":"廖行之","text":"客里春愁万斛量，随身抖擞一奚囊。\n了无池草入诗梦，粗有山花供酒狂。\n半载飞蓬成底事，几钩新月误相望。\n夕阳又傍空山宿，杜宇声中入异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野花","author":"廖行之","text":"草木送春归去后，山花种种自然开。\n略无醉倒游人至，自有交情戏蝶来。\n日暖欲令纷锦绣，风和未遣委莓苔。\n清幽浑绝嚣尘态，应遣青阳恨莫陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬罗季康二首 其二","author":"廖行之","text":"自怜疏拙百奚宜，不省胡颜可媚时。\n驰骛功名非我事，欢娱菽水祇心知。\n风姿故陋难施粉，面目堪憎正类倛。\n惟有灵台亦裴度，到君明眼不能欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬罗季康二首 其一","author":"廖行之","text":"惭愧材非可与言，等閒微籁自鸣天。\n井蛙无理祇成闹，里妇空颦岂解妍。\n君自平生多与点，谁云一语始知然。\n欲伸床下慇勤拜，诗律于今属大贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春偶成四首 其四","author":"廖行之","text":"春色堂堂去，云容故故阴。\n情连芳草远，愁共碧波深。\n一雨能多久，鸣鸠只合瘖。\n杖头方寂寞，那得浊醪斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春偶成四首 其三","author":"廖行之","text":"小雨纤纤润，轻云淡淡阴。\n溪光清绝处，山影翠微深。\n蚕市朝何寂，牛歌晚不瘖。\n高吟怜节物，合把酒尊斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春偶成四首 其二","author":"廖行之","text":"蒲渚生新涨，花蹊长绿阴。\n微风将暑至，一雨共春深。\n强聒燕何吻，卑喧蛙未瘖。\n有怀无可奈，吟兴发清斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春偶成四首 其一","author":"廖行之","text":"残花自开落，迟日半晴阴。\n翡翠山容暗，蒲萄江涨深。\n绿杨浑作絮，黄鸟欲成瘖。\n春事今如许，谁能著酒斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋闻雁","author":"廖行之","text":"微日输晴宿霭妆，征鸿迎暖到南州。\n相呼相唤稻粱熟，年去年来芦苇秋。\n琴操曾遗中散恨，海濒还见子卿不。\n夕阳莫傍江楼去，长有别离人倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏瑑觉斋二首 其二","author":"廖行之","text":"灭去觚棱性本圆，了除藩蔽物皆然。\n向来具足顶门眼，尽发卑微瓮里天。\n胶扰空花俱是幻，拘挛尘鞅束如编。\n非予孰为幡然起，莫遣阿衡美独专。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题苏瑑觉斋二首 其一","author":"廖行之","text":"不随凿枘辨方圆，安用蓍龟考未然。\n万物由来皆备我，寸心既尽即知天。\n见几那俟拈花手，乐道浑忘绝易编。\n自得诚明千古学，谁能證此具精专。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题舅氏耕隐图","author":"廖行之","text":"诗书事业可公卿，垂上青冥却反耕。\n舍己芸人吾弗尔，种田得饱我何营。\n一犁春雨宁论力，万里秋云会享成。\n堂上更书无逸语，也知稼穑重金籯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别罗舜举二首 其二","author":"廖行之","text":"鳌峰夜色输明月，龙穴秋光蔼碧云。\n景物故应人惜别，风流难与世相闻。\n新诗题处君思我，啼鸟声中我梦君。\n一笑相从非易得，有怀聊复此云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别罗舜举二首 其一","author":"廖行之","text":"畴昔交情一辅车，年来造物且乘除。\n论文谁共肺肝语，道旧空传咫尺书。\n半岁不堪心鄙吝，一樽聊得语踌躇。\n匆匆又作相违恨，愁绝临风送目初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为老人寿苏盐","author":"廖行之","text":"司寇家声远，开元相业尊。\n亚燕推手笔，刺暴赋篪埙。\n无逸隋图在，居延汉节存。\n二天公覆盖，六印气雄浑。\n美玉蓝田裔，洪河积石源。\n人材钟盛世，侯伯萃高门。\n龙集天津尾，杓携井络坤。\n策加三卦候，蓂改四朝昏。\n兆梦熊罴喜，仪庭鸑鷟鶱。\n崧高真气宇，佛祖是心原。\n标准仪中外，才猷剸剧烦。\n枢庭陪国论，江介辅侯藩。\n忠力宣僚寀，勋庸简帝阍。\n皇华分使节，风采动輶轩。\n煮摘三湘富，澄清九郡恩。\n融融流叶气，蔼蔼载谣言。\n望洽青毡旧，荣须锡马蕃。\n金瓯披姓字，芝诏下天垣。\n卿月当联棘，王庭合簉鹓。\n蓬壶开寿域，斗柄挹芳樽。\n蟠实来仙木，松膏出老根。\n祝公千岁寿，带砺见调元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次西郊即事韵三首 其三","author":"廖行之","text":"一年好景今露萤，试问谁濯沧浪缨。\n随时动遭不事谤，洁己自觉太清生。\n西风常次乐郊路，好酒不博当朝卿。\n浩然十里马蹄疾，未到城门打鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]