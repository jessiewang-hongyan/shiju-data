[{"title":"与长老夜话出故人俞宋护书予至山之日俞书适至书中又相问讯感而赋诗二篇俞郊居婺源草堂蔬圃教子读书乡人重之闻近苦目疾殊可念 其二","author":"王洋","text":"法海空门老伏波，婺源槐市病维摩。\n道无同异要当尔，命有穷通可奈何。\n两目再清张籍在，一经传子凤毛多。\n饱闻行业书乡社，得失功名付浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与郑侍郎","author":"王洋","text":"还却天官尺一书，清时有味保悬车。\n公年尚壮去何蚤，古道谁言今不如。\n南部方开新榜丽，西清人说旧游疏。\n半簪白发无拘束，不用黄精自扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞桃竹于令尹","author":"王洋","text":"小结幽栖事静便，为无花竹不成村。\n在君百里鸣弦地，成我一方濯锦园。\n按鼓威名知破胆，乞花诗句是招魂。\n桃溪竹径如成趣，柳岸梅洲却未论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子楚寄吏报章复用前韵再寄一篇","author":"王洋","text":"长须晨送一函书，语不周遮意有馀。\n雨满一犁知过望，草开三径喜如初。\n黄鱼白酒江头市，绿竹青蒲隐士居。\n病后世缘多懒惰，相逢诗酒未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中冬下浣一日陪方丈访客因过向氏园亭有感","author":"王洋","text":"前疏水竹界桑麻，桃李畦分小径斜。\n山数青黄人住久，路排藜藿客行赊。\n云寒烟合入长暝，梅懒春催未放花。\n闻道苍头长儿女，主人游宦不还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中春二十四日集仰止书室德茂仰止何彦亨彦发邓叔度与仆凡六人至夜格夫自外归就邀同饮仰之是日对棋屡败德茂任直时出骂坐语叔厚谓子可以诗纪事否翌日戏成长句","author":"王洋","text":"朱何王邓偶婆娑，晚唤寒甥共笑歌。\n烦恼少因知事少，吃拳多为打人多。\n竹间豪逸多酣畅，斗下文章竞拂摩。\n好是花时省风雨，劝人沈醉是天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书窗梅花数枝病起再见瓶中盛开因作","author":"王洋","text":"书堂篱落冷如灰，十日相忘亦自猜。\n初讶冻枝无艳脉，那知寒室自花开。\n铜瓶结实元非种，蔀屋迎春似有媒。\n方信阳和满天地，不须人力费根栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老峰","author":"王洋","text":"已作人间瑞，飞空老尚豪。\n势分方岳重，名列纬星高。\n月夜霜添发，花晨露染袍。\n此翁无奈事，占咏亦徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王提干送云安春色以诗还酒尊","author":"王洋","text":"万里关河未说长，亡何乡是醉中乡。\n客居江馆当炎热，春日云安逸色香。\n沽水童奴思给酒，乞钱司业更传觞。\n蓝桥不用鸳鸯语，只合壶中贮玉浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆近还舍以一篇饷秀实蒙以两篇见酢谨用前韵再酬一篇","author":"王洋","text":"春行日日度芳林，僧梦回看午转阴。\n闲喜林塘多静态，忙输蜂蝶见花心。\n三杯酒后逢人醉，几首诗多取意吟。\n惭愧孟郊三百首，何人收拾荐薰琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从伯氏携稚孺游保庆即事","author":"王洋","text":"提携未便即归山，暂扣僧园且暂闲。\n岁晚东君颜色近，霜晴寒意有无间。\n前溪雨后浑通路，荒戍人归不上关。\n筇竹一枝天正暖，却嫌飞鸟倦思还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从邻庵求浴","author":"王洋","text":"口多屋褊分张窄，堂室斋庖约略分。\n春服乍成宜稳贴，浴盂无处集兰薰。\n供分清净如沾露，气郁芬芳过食芹。\n自引一杯归路稳，从教歌咏不成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以越笺与三四弟有诗次韵","author":"王洋","text":"无复花生拙笔头，一生长负剡藤羞。\n过门多是陈惊坐，得句谁怜赵倚楼。\n社友书来频寄语，山翁鬓已不禁秋。\n老干仙去吾宗冷，有继华星一字不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕夜与戎琳殊三老僧对棋琳请作诗赋之","author":"王洋","text":"白布衫韝时节新，娇鬟丰口绮罗春。\n满城菡萏官同乐，午夜箫歌社降神。\n继昼寻棋三净侣，闻灯坚坐一闲身。\n不须强学行春客，儿女多应不要人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日倦卧书斋闻僧食未敢歌鼓声作继以清唱感而戏作","author":"王洋","text":"蚤莺声转杂危弦，惊散书窗午枕眠。\n大法鼓声胡部曲，摩登伽戏野狐禅。\n眼中颠倒迷情事，世上纵横使鬼钱。\n烂煮瓠壶钟鼎食，山堂谁道独翛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌立冬十月十一日陪路文周朋携禔祖同访后山道人庵道人出就庵烹茶庵外采菊拾橡实以归偶成即事 其二","author":"王洋","text":"养生无欠亦无馀，种竹圈篱草结庐。\n凿地觅甘分乳脉，锄田得实饱新蔬。\n壁间数本空王像，架上都无养性书。\n我自病来能晚食，从今缓步当安舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天池赠回老","author":"王洋","text":"平地相逢已二年，重寻胜处少留连。\n千峰拱足烟霞表，飞鸟衔花几席前。\n白雪拥窗斋灶冷，春风吹谷野芳妍。\n四时坐断闲消息，古佛心灯万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无尽藏斋诗 其二","author":"王洋","text":"潢潦集须臾，朝盈夕已除。\n沛然随饱满，廓尔是清虚。\n金谷输仓箧，锱铢较簿书。\n不知方寸地，无计脱苞苴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无尽藏斋诗 其一","author":"王洋","text":"造物本无尽，贪求乃不公。\n此能随量取，彼亦一无穷。\n水底家家月，窗间处处风。\n要知真宰意，不在有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王侍郎挽章","author":"王洋","text":"位列仙官籍，名随海贾船。\n前旌冲瘴雨，拱木兆新阡。\n玉骨埋黄土，金声丽藻编。\n两行怀旧泪，洒向菊花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏书事","author":"王洋","text":"打打鸣窗雨，昏昏带岫云。\n酒寒难作热，炉冷不成熏。\n梅颊梦中笑，雁声愁处闻。\n伤怀目前事，细数费云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐饮","author":"王洋","text":"何意亲杯杓，初期乐性真。\n若教狂胜德，多被酒忘身。\n谈笑交情密，氤氲酒力醇。\n劝酬如错杂，莫过两三巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬节日疾作不能亲祀事但具礼不拜戏作示内","author":"王洋","text":"他乡易感岁时侵，病入衰骸苦不禁。\n卧听儿孙羞栗脯，倦依炉火只愁吟。\n房无肥腯牲三俎，幕有馨香酒数斟。\n苦与黔娄分等级，尚为吾妇莫伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去秋过吴江臞翁园亭追作","author":"王洋","text":"水接舟航陆接鞍，忙中光景静中看。\n无穷宇宙规模远，出格池台制度宽。\n一水斯须分静僻，四桥缭绕照波澜。\n拟分风月知何日，且趁鲈鱼整钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发龟溪道中","author":"王洋","text":"欲穷幽胜远纷华，频向晴空漾钓槎。\n霞杂凫群归趁浦，雪飞鹭阵宿投沙。\n山连空秀嫌花杂，树远多图怕雾遮。\n莫怪故园归未得，为贪入手好烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶云仰之谓予有随轩人作无真诗诮仰之用前韵","author":"王洋","text":"方外参军语太赊，文茵萋斐锦成霞。\n齐王国印封韩信，古战场文识李华。\n不醉而狂乌变白，以无为有舌生花。\n嚇燕书自何人计，只问军中李左车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶伯宇和霞字韵诗再作一篇","author":"王洋","text":"全似襄阳隐士家，只添灵照减丹霞。\n晚山寒后犹疑远，古木春来亦好华。\n酒似竹光仍斗绿，人如锦面更添花。\n了知衰病轻成醉，不但流涎向曲车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄糜公范","author":"王洋","text":"尘满簪缨缁满衣，几人真解弃如泥。\n水方流急收惊楫，籓自无心看触羝。\n陶令纵教贪漉酒，谢公宁不念烝黎。\n也知雅意人难会，笑对西山是指迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"帅相生日二首 其二","author":"王洋","text":"整顿乾坤不作难，指间造化自多端。\n恩回春色华风暖，气接秋天绝塞寒。\n勋爵已增彝鼎重，功名长入画图看。\n锡公难老无他验，但觉斯民欲再安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"帅相生日二首 其一","author":"王洋","text":"季管吹灰木落洲，天边初献鹔鹴裘。\n邦家袭庆因前续，岳渎储精自几秋。\n秦晋君臣三昼接，安危将相百年求。\n休论辟谷功成后，只恐功名卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归雁亭次东坡韵","author":"王洋","text":"平时何惮不成归，犹向亭前送雁飞。\n弱羽可堪缯缴密，寒沙那得稻粱稀。\n燕吴真恐音书绝，城郭犹疑今古非。\n若为哀鸣相原野，依随岂惜共卑微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧闻邵叟名今识面目于诗句字画中辄取二诗赓之他日会面亦旧相识也 其一","author":"王洋","text":"平生高士苦交疏，今见音容向一书。\n输子一筹吟未足，加人数等盍分馀。\n供陪应觉山劳费，捃拾不教春自如。\n诗社便宜张客馆，莫教游士叹无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧闻邵叟名今识面目于诗句字画中辄取二诗赓之他日会面亦旧相识也 其二","author":"王洋","text":"曾参古佛问忘情，可笑初孩尚未名。\n自刻肺肝诚定誓，时牵耳目又寒盟。\n苦无藉在书窗冷，赖有知怜风竹声。\n好是鼻端消息在，夜堂流水梦初成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"民瞻再作诗复以前韵酬之","author":"王洋","text":"报我新诗疾转舠，论文始信赖薰陶。\n追风定见骥千里，鸣野今闻鹤九皋。\n看剑为君倾薄酒，张弓何日畏春醪。\n不烦更问珊瑚树，旧绣年来拆海涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"目疾","author":"王洋","text":"天公嗔我眼长白，故著昏埃阿堵中。\n不怪参军谈瞎马，但妨中散送飞鸿。\n著篱令恶谁能对，损读方奇定有功。\n九恼从来是佛种，会如那律證圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"节日同儿女小集倅有诗见戏答之","author":"王洋","text":"白首相看一病妻，也能举桉与眉齐。\n诲儿共织庞翁竹，养气多惭纪渻鸡。\n作恶不须嗟室罄，惊魂长幸脱征鼙。\n团栾欲说无生话，试借先生刮眼鎞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙涎香","author":"王洋","text":"搴露纫荷楚泽舷，未参南海素馨仙。\n大门当得桂花酒，小样时分宝月圆。\n诗挟少陵看妙手，犀通神物为垂涎。\n使君少住幽兰曲，时傍颦山照鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵","author":"王洋","text":"堆案文书不用嗟，新诗字字说芳华。\n题舆事省时眠草，纶阁文高合判花。\n莫待春归空怅望，须知醉里有生涯。\n如何为向邦侯说，整顿清明载酒车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋红梅","author":"王洋","text":"为怯清宵短，然膏约凭栏。\n颊疑西子醉，花误北人看。\n点露燕支破，啼妆风雨残。\n莫嫌翠袖薄，犹得护春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再酬杜倅两诗用前韵 其二","author":"王洋","text":"昨朝珠玉已争光，再转旌旗再擅场。\n景物岁时俱婉娩，德人言语亦馨香。\n歌风燕子初争语，藏柳鸦儿学画黄。\n牵率赓酬无健句，鸾声只合听央央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吉父赋南池诗次韵吉父诗虽云红蕖在眼而独与白鹭关情莲上人何望辄戏呈","author":"王洋","text":"水府朝元路，牙分女队行。\n神仙天外事，风月世间情。\n步有凌波势，廊无响屧声。\n何妨沉醉后，珠履小纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同吴周朋高虞卿寻泉憩积暑下庵","author":"王洋","text":"缭绕寻泉远步迟，倦逢篱外敞庵扉。\n门前竹长云垂舞，岩下泉甘雪未飞。\n景物偏幽缘舍小，茶香看客为僧稀。\n相公房舍添人否，拟灌春园住翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同张德和游沈道士庵","author":"王洋","text":"上春甲子送穷日，早破烟扉令节求。\n指点葆光仙侣洞，招期南极老人游。\n龟前香火木称士，堂后交蟠石作牛。\n我恐上真无碍意，使君息虑是清修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕尚书挽章 其一","author":"王洋","text":"古远儒冠拙，时忙壮士尊。\n百年难保命，万里未归魂。\n身后塞翁马，生前廷尉门。\n悲笳咽遗恨，行矣不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕尚书挽章 其三","author":"王洋","text":"四海诎伸势，安危俯仰殊。\n犬戎蟠洛邑，晋鄙握兵符。\n杨李生同烈，高秦死异区。\n谁如双剑化，义烈一门俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕尚书挽章 其二","author":"王洋","text":"载缵世基日，群公扈圣年。\n伏蒲凤冈上，持节雁峰边。\n外阃风猷远，中台出处全。\n履声伤易尽，不得辅中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因同年见过有感","author":"王洋","text":"青似春袍色发荣，变移朱紫渐催成。\n琴因声急弦难续，流为池平水不鸣。\n神耗恐因惊宠辱，心闲请为减经营。\n贫门二十年中梦，贵贱存亡叹友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安眠","author":"王洋","text":"随处便随眠，昏昏息万缘。\n魂如双翅蝶，身在四禅天。\n素饰罗为幌，芳茵锦作筵。\n心如怀宠辱，未必得安然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁除前一日病中作","author":"王洋","text":"客寄他年又一乡，椒花随兴饮杯长。\n病疑寒健销阴脉，愁怯花宽笑酒觞。\n去住自知身老大，经过长恨岁穷忙。\n眼前儿女陪欢悦，年少从教各自彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆吉父七十作诗叙事","author":"王洋","text":"里有仁贤庆寿祺，不辞沽酒典春衣。\n年高且作寻常看，身健须誇七十稀。\n颊火欲烧双鬓白，心闲时笑昔年非。\n谁誇八座天人贵，丞相星垣动紫薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次蘋字韵即事","author":"王洋","text":"飘零何处是通津，陆有飞蓬水有蘋。\n赋禀但随升斗禄，姓名常后百千人。\n趋炎未肯施先足，耐冷何须便曲身。\n祗有鸣埙恐难继，此心端欲避芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次曾吉父韵","author":"王洋","text":"憔悴非同十载前，旅酬那复似初筵。\n蜜房羽客非无课，木局枯棋亦任缘。\n得酒且思陪笑语，著诗终欲共林泉。\n北坛居士新登拜，租得茶山又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此日湖源回展叔颖书颇及往岁经行暨诸同志赏梅花之一笑急景相催又复几年感而有作因寄叔颖并呈子楚","author":"王洋","text":"忆昨越溪曲，官梅正发时。\n追随连日饮，酬唱几篇诗。\n淡伫看人意，清香许自知。\n凭谁将恨寄，为说鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江如晦以诗送蕙一本以诗谢之","author":"王洋","text":"幽芳不弄妍，人意自推先。\n比德人间愿，同心事外贤。\n香因天力与，名自楚词传。\n桃李多颜色，相逢不敢鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自忻村被酒归失方竹杖","author":"王洋","text":"我贫难致远，得此有夤缘。\n弟为兄身老，书来意已传。\n扶衰惟献直，入手不随圆。\n偶向醉中别，如何不黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至法海寺","author":"王洋","text":"天有阴晴地有艰，一山如隔万重山。\n偶逢冬少三馀雨，况置身无百虑关。\n岁熟役车容借客，闲来崖寺可开颜。\n悬危既免逢饥虎，又得休公半偈还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观击食","author":"王洋","text":"结习慕金仙，西方省问禅。\n时分四季社，报积后生缘。\n念恋期无问，辛勤已有年。\n会缘如有约，此理自谁传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观瑞香杏花二首 其二 杏花","author":"王洋","text":"绛萼红腮带露肥，烧林长近禁烟期。\n且容北郭通邻径，若比南枝较发迟。\n曲水岸边寻旧事，卖花担上拣繁枝。\n香鞯一色垂杨路，何似吴王宫里时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观瑞香杏花二首 其一 瑞香","author":"王洋","text":"陌上春风已半酣，薰笼院静怯轻寒。\n织成花锦传香密，养就娇羞对客难。\n山路不知清梦远，宫衣犹惜旧花残。\n若将品第分高下，须向芝兰格外看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观僧作藏会","author":"王洋","text":"推崇社首劝来人，岁结春缘转宝轮。\n诛及米盐知产罄，事干生死见诚真。\n归持福寿凭怀券，时及暄和谓有神。\n安得劝农官考古，春秋礼射莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯氏再以前韵即事复继韵","author":"王洋","text":"问宅无成复问津，青衫长是照青蘋。\n生涯异日知何地，性命如今正属人。\n蝼蚁命轻难报国，虫鱼买绝拙谋身。\n五年湖海成何事，只得冠缨不染尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯氏临江使君寄芗林次韵 其二","author":"王洋","text":"君王劝驾一轻舟，赐履西江饱胜游。\n井邑诗书今化鲁，春秋盟会不书邹。\n诗中侯印知无分，笔下尊拳勿太遒。\n快读新章与神会，蠹关门掩梦经邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯氏临江使君寄芗林次韵 其一","author":"王洋","text":"力荡横空万斛舟，一函酬唱纪川游。\n篇篇秀润东南竹，落落珠玑小大邹。\n人物百年同富寿，客怀千里梦逡遒。\n主人合作鲸川楫，无奈高情寄一邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]