[{"title":"鹧鸪天 其七 十六夜出","author":"姜夔","text":"辇路珠帘两行垂。\n千枝银烛舞僛僛。\n东风历历红楼下，谁识三生杜牧之。\n欢正好，夜何其。\n明朝春过小桃枝。\n鼓声渐远游人散，惆怅归来有月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 丁巳元日","author":"姜夔","text":"柏绿椒红事事新，隔篱灯影贺年人。\n三茅钟动西窗晓，诗鬓无端又一春。\n慵对客，缓开门，梅花闲伴老来身。\n娇儿学作人间字，郁垒神荼写未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"姜夔","text":"曾共君侯历聘来。\n去年今日踏莓苔。\n旌阳宅里疏疏磬。\n挂屩枫前草草杯。\n呼煮酒，摘青梅。\n今年官事莫徘徊。\n移家径入蓝田县，急急船头打鼓催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 己酉之秋，苕溪记所见","author":"姜夔","text":"京洛风流绝代人，因何风絮落溪津。\n笼鞋浅出鸦头袜，知是凌波缥缈身。\n红乍笑，绿长颦，与谁同度可怜春。\n鸳鸯独宿何曾惯，化作西楼一缕云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六 元夕有所梦","author":"姜夔","text":"肥水东流无尽期，当初不合种相思。\n梦中未比丹青见，暗里忽惊山鸟啼。\n春未绿，鬓先丝，人间别久不成悲。\n谁教岁岁红莲夜，两处沉吟各自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 正月十一日观灯","author":"姜夔","text":"巷陌风光纵赏时，笼纱未出马先嘶。\n白头居士无呵殿，只有乘肩小女随。\n花满市，月侵衣，少年情事老来悲。\n沙河塘上春寒浅，看了游人缓缓归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姜夔","text":"中兴无限艰难意，日暮湖平力士归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"姜夔","text":"花花竹里无人见，一夜只香过石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题日哦轩","author":"娄机","text":"高轩多暇日，宴寝独怡神。\n风俗谁今古，云山自主宾。\n滩平分燕尾，松老半龙鳞。\n徙倚清阴下，吟怀愧昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"娄寿","text":"飞云过雨洒明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潺潺阁","author":"娄乾曜","text":"一派泠泠绕槛清，尘襟洗涤自凉生。\n夜深好梦才惊破，疑是半天风雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讥王黼","author":"宣和民谣","text":"三百贯，且通判。\n五百索，直秘阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小舟溯马湖江","author":"度正","text":"横斜骤雨巾折角，屈曲小舟屋打头。\n石壁愈高天愈远，乱云深处羁縻州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发益昌","author":"度正","text":"牵江万斛犯惊湍，终日号呼寸寸难。\n少驻不妨官避客，也教容易下前滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正蒙主文教授大著宠示佳章辄继严韵仰酬盛意之辱兼呈诸契丈幸赐采瞩正皇恐再拜 其五","author":"度正","text":"冥搜窃叹眼俱高，我欲还家备百牢。\n三十三人齐上去，举杯帆外送洪涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正蒙主文教授大著宠示佳章辄继严韵仰酬盛意之辱兼呈诸契丈幸赐采瞩正皇恐再拜 其二","author":"度正","text":"眼空未可叹贤无，瓦砾中间有宝珠。\n多谢三峨孕清淑，安排贡籍贡鸿儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正蒙主文教授大著宠示佳章辄继严韵仰酬盛意之辱兼呈诸契丈幸赐采瞩正皇恐再拜 其四","author":"度正","text":"外省风雷亦壮哉，曾将科目放颜回。\n因寻俊秀传衣钵，笑指凌云得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正蒙主文教授大著宠示佳章辄继严韵仰酬盛意之辱兼呈诸契丈幸赐采瞩正皇恐再拜 其一","author":"度正","text":"珍重知音审五声，也从纸上得张程。\n设科久矣何曾见，想像双瞳万古惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访廖叔度蒙示山谷所作真赞及藜郊等帖","author":"度正","text":"珍重前贤此考槃，山川环合地平宽。\n雨馀草木俱苍翠，好与光风霁月看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过石洞","author":"度正","text":"修门赫赫铁城长，雨后山川拥翠光。\n大似锦屏饶富贵，至今人说状元坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"制干判院初度载临谨以梅起兴赋三绝句为斯文寿一笑幸甚 其二","author":"度正","text":"冰魂玉质映霜林，四月飞成点点金。\n遥想清香能止渴，应知此意可为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"制干判院初度载临谨以梅起兴赋三绝句为斯文寿一笑幸甚 其三","author":"度正","text":"傅岩人起应旁招，道德光明相业高。\n试问当年调鼎事，非梨非栗不能桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"制干判院初度载临谨以梅起兴赋三绝句为斯文寿一笑幸甚 其一","author":"度正","text":"江梅吐出五花新，绰约林间早占春。\n多谢天公孕佳实，中心浑是那仁仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"命解","author":"度正","text":"世谓臧仓解谮轲，岂知天意在干戈。\n如天便欲平天下，纵百臧仓不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉送三荣王子文游益昌 其一","author":"度正","text":"廉逊先生袖手间，徽猷学士屡开藩。\n行藏有道俱奇绝，谁似清名萃一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉送三荣王子文游益昌 其四","author":"度正","text":"徽学诸孙亦俊游，舌端造化挽洪流。\n慨然投笔从裘马，要学班超万里侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉送三荣王子文游益昌 其二","author":"度正","text":"自修盟好讳言兵，竞喜丰年贺太平。\n养得狐狸解猖獗，健儿还胜老儒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉送三荣王子文游益昌 其三","author":"度正","text":"料得人人喜自新，尔民元是汉人民。\n君王仁对于天下，元帅慈祥也似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"畅伯圭父子下第归乡携嗣由广文书并手佳章宠贶正旧读程门遗书知有潜道者列由求之间今见伯圭父子姓名不胜惊喜因问家世出处果潜道近族遂用其韵反其意出鄙语以谢庶几朋友相与切磋之义也","author":"度正","text":"先正传家逮泗滨，一言一论本诸身。\n是间极力窥真际，物外何心逐像人。\n蹈履若迷天所赋，奔驰犹误实之宾。\n都将出处束高阁，明日从容傥细陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剑门诗","author":"度正","text":"罗列峰峦万仞尊，横纵畦畛自村村。\n诸侯有道人安业，何用崎岖闭剑门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨幸甚得见子玉教授丈得一论其说出于订顽克己铭词致超绝辄借前韵以庆兼呈诸丈幸乞一笑正再拜上 其三","author":"度正","text":"新泉瀹茗濯诗魂，翻阅如飞彻晓昏。\n是石无瑕终是石，莫教抱璞退声冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨幸甚得见子玉教授丈得一论其说出于订顽克己铭词致超绝辄借前韵以庆兼呈诸丈幸乞一笑正再拜上 其四","author":"度正","text":"鉴别毫釐岂易哉，逢奇何惜读千回。\n充囊未可矜前得，如积薪焉看后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨幸甚得见子玉教授丈得一论其说出于订顽克己铭词致超绝辄借前韵以庆兼呈诸丈幸乞一笑正再拜上 其二","author":"度正","text":"广文人物世间无，两眼晶荧照乘珠。\n拈出便应人叹服，粹然议论到先儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨幸甚得见子玉教授丈得一论其说出于订顽克己铭词致超绝辄借前韵以庆兼呈诸丈幸乞一笑正再拜上 其五","author":"度正","text":"浅陋微邦望不高，偶同齐晋会虫牢。\n进贤受赏非吾事，拭目龙门跃巨涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨幸甚得见子玉教授丈得一论其说出于订顽克己铭词致超绝辄借前韵以庆兼呈诸丈幸乞一笑正再拜上 其一","author":"度正","text":"天作斯文鼓大声，贤科今已定章程。\n诸生自此升堂去，谗说安能复震惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兼考遂宁补试锁宿在学戏题一绝","author":"度正","text":"壮士缚鸡聊尔耳，小儿相鼎竟何如。\n眼前万事不堪说，惟有秋风解得渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题濂溪书堂","author":"度正","text":"千载斯文傥可求，暮春春服共行游。\n向人鱼鸟都和乐，满眼溪山只恁幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌书怀","author":"度正","text":"熙宁使者今何在，元祐师臣去不归。\n独对江山舒望眼，悠然天际见云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦得学士贤表惠寄蕨芽小诗驰谢聊发一粲","author":"度正","text":"陟彼南峰采蕨芽，筠篮驰送簇英华。\n东君迸出非无意，救活饥肠几万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殿中覆考进士","author":"度正","text":"交戟重门间九阍，彤庭紫殿切星辰。\n能来此地连宵直，即是骖鸾驾鹤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠䨥先生","author":"度正","text":"眼如明月口如神，閒里乾坤物外身。\n世上穷通都莫问，粹然生色几何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上李大参 其一","author":"度正","text":"坐对江山古与稽，熏炉一线入云霓。\n闻思草木忧春雨，轸念桑麻病夏畦。\n有美荇蓠泥不滓，无言桃李下成蹊。\n青天瑩彻明如鉴，下照毫釐自不迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上李大参 其二","author":"度正","text":"云间龙鹤隐峰峦，袖手何妨此考槃。\n秋老未须愁菊悴，春回宁复讶梅酸。\n风吹雁字成簪盍，雪压鸥盟阅岁寒。\n万卷皇坟谁可续，为言执事劝加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上制置侍郎 其一","author":"度正","text":"龙虎西头象更雄，巍然坐觉马群空。\n三千威已行方外，百万兵元贮腹中。\n蜀国欢声连上国，秋风和气似春风。\n只今欲荐斯文寿，大雅篇中愿赋崧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上制置侍郎 其三","author":"度正","text":"武侯落落旧规摹，千载谁能发壮图。\n抚定南方无后顾，感通北面自前孚。\n但于号令教心服，自是欢忻听指呼。\n群策不遗光竹帛，方知儒术本非迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上制置侍郎 其二","author":"度正","text":"堂堂汉使到天涯，覆芘西南亿万家。\n礼乐化行真有道，强梁气慑自无哗。\n坐观狼狈奔牛角，敢复猖狂犯虎牙。\n措置得宜归妙算，更歌丰乐庆中华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上茶使赵伯川 其一","author":"度正","text":"六阳浩荡奏薰风，白雨肥梅纂纂红。\n学到狼胡心湛湛，性同麟趾步融融。\n已锄汉戚更王化，行建周宗辅圣聪。\n师友一源端复振，世间从此卜兴隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上茶使赵伯川 其二","author":"度正","text":"几年题笔决文围，妙手元堪补衮衣。\n不讦不谀持正大，能经能济洞几微。\n天高且作茶星现，地迥行亲海月辉。\n万岁池塘神兴逸，总教西子赋东归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上赵茶马 其一","author":"度正","text":"仙源奕叶满皇州，人物于今第一流。\n蹈履诗书宗孔孟，扶持日月继伊周。\n更观河浒盘根出，已自风雩向上求。\n异说扫除昌此道，方来勋业掩前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上赵茶马 其二","author":"度正","text":"圣门绝学叹中微，天祐斯文再发挥。\n宗衮爰升陪国论，党魁特起赞经闱。\n麒麟复见公朝瑞，虎兕何忧我道非。\n千载明良相庆会，更歌既醉醉无归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太孺人生朝","author":"度正","text":"万事随缘处处安，分明淡泊有馀欢。\n痴儿解赋蟠桃颂，拙妇能炊脱粟餐。\n天上神仙谁羡慕，人间真乐我团栾。\n愿如松柏坚刚寿，相与年年保岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去年微之国史读易彻章梦谒晦翁相与从容话言今年读周官再用前韵录以垂教正谨依韵酬谢 其二","author":"度正","text":"礼经遗子略闻之，大法昭然世莫违。\n初学卑卑由礼立，终身恳恳欲仁依。\n芸苗自我持三勿，克己从头绝四非。\n往教旧盟如可践，警其懈惰久心希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去年微之国史读易彻章梦谒晦翁相与从容话言今年读周官再用前韵录以垂教正谨依韵酬谢 其一","author":"度正","text":"伊人寤寐自求之，钻仰应无咫尺违。\n试看后来身愿学，便如当日自归依。\n及门定许偕行止，下笔何由谬是非。\n好把遗编还指示，也教都识大音希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正伏承泽深佥判学士贤友以正生朝宠贶佳篇辄次元韵 其一","author":"度正","text":"当年霁月正光凝，坐对窗前草吐英。\n已羡同时希洁白，更高异代继澄清。\n蒲卢有道应知化，花柳无私自应诚。\n世重世轻皆自乐，登坛还与莅斯盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正伏承泽深佥判学士贤友以正生朝宠贶佳篇辄次元韵 其三","author":"度正","text":"清献重逢在永阳，方知此道浸明昌。\n非聪何以闻天籁，有畀终须辨国香。\n不贰见知忠肃瓘，逸民晚遇太师光。\n圣贤出处宁无意，舍则深藏用束装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正伏承泽深佥判学士贤友以正生朝宠贶佳篇辄次元韵 其四","author":"度正","text":"自洛而闽幸有传，更相私淑百馀年。\n面言犹及金为口，手墨何妨锦作笺。\n在昔见闻迷卓约，至今钻仰叹高坚。\n分明太极图中意，更续源源付后贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正伏承泽深佥判学士贤友以正生朝宠贶佳篇辄次元韵 其二","author":"度正","text":"特立谁能为道谋，千钧岂可委庸流。\n正涂壅底如丛棘，此意萧条若缀旒。\n指掌人归容景慕，传心书在正研求。\n恭惟天道何由谬，服力田畴自有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次合州新赵使君阻雨","author":"度正","text":"时髦济济盛经纶，自愧空疏忝字民。\n槐下日光忧杲杲，麦秋雨势厌频频。\n化工付物难占命，精意回天亦在人。\n闭閤焚香惟静坐，一回思念一眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至喜亭诗","author":"度正","text":"扁舟三峡备艰难，幸脱风波魄未安。\n山已陵夷成㟝嵝，水无约束渐瀰漫。\n半天堤柳垂春暖，满地江梅怯岁寒。\n坎坷一生何所用，它年湖海一渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别坚甫伯修","author":"度正","text":"几日驰来别浩斋，偶然良晤尽吾侪。\n苛留归思主人恶，少驻征鞍客子佳。\n栗烈侵肤凝腊雪，纵横塞路困山崖。\n三家白发元相似，放去从教慰母怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"君锡知丞僚友录示诸公所赋介寿堂诗谨次后溪先生元韵以记盛事","author":"度正","text":"老翁神气亦轻强，凿井耕田种豫章。\n扶植高标盘石壑，养成合抱栋明堂。\n风雷海运非人力，日月天开盛宠光。\n既醉诗书餐道德，坐观晚节更清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈晏制干二首 其二","author":"度正","text":"忆昔归来自建溪，徘徊拟岘访前题。\n江山秀伟钟灵杰，文物光辉焕斗奎。\n历数儒绅真冀北，推源宗派孕江西。\n凤雏骥子今如许，称兕公堂傥许跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈晏制干二首 其一","author":"度正","text":"陇西公府俱名胜，元献曾孙号最贤。\n玉陛新题翻墨榜，金门旧事付青毡。\n远游行橐诗千首，退食高斋易一编。\n再世起家调鼎鼐，中兴榜样更蝉联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"制置侍郎阁学台座俯从乡论营求胜地改建贡闱严严翼翼实称朝廷所以宾兴贤能之意父老观者莫不称叹今工已告成命客饮之正获与焉谨赋诗三章以纪盛事词鄙意拙亦各言志傥蒙采察曷胜荣幸 其一","author":"度正","text":"中兴诏下九重天，分建科场贡蜀贤。\n急就佛宫嫌北面，载开儒馆堕西偏。\n得人自昔英才盛，择地于今气象全。\n多士深思公雅意，要收鸿硕副详延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"制置侍郎阁学台座俯从乡论营求胜地改建贡闱严严翼翼实称朝廷所以宾兴贤能之意父老观者莫不称叹今工已告成命客饮之正获与焉谨赋诗三章以纪盛事词鄙意拙亦各言志傥蒙采察曷胜荣幸 其二","author":"度正","text":"殿角西头辟礼闱，峥嵘栋宇更巍巍。\n碧鸡金马连环绕，云顶峨眉耸翠围。\n陈范苏张应并驾，龙章谯郭亦横飞。\n东都行复充乡赋，却望秦关入帝畿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"制置侍郎阁学台座俯从乡论营求胜地改建贡闱严严翼翼实称朝廷所以宾兴贤能之意父老观者莫不称叹今工已告成命客饮之正获与焉谨赋诗三章以纪盛事词鄙意拙亦各言志傥蒙采察曷胜荣幸 其三","author":"度正","text":"皇家科目钓英豪，手大方能得巨鳌。\n考论勋庸推虎榜，讲求师友自鸾刀。\n泉翁竟被盲夫弃，云叟空劳圣主褒。\n细看当年权造化，欧公眼目独清高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":38530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]