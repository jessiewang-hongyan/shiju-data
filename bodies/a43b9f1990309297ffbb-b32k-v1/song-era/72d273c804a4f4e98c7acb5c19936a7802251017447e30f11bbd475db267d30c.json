[{"title":"清明日","author":"张伯玉","text":"每年每遇清明节，把酒寻花特地忙。\n今日江城衰病起，佛前新火一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"港口渡","author":"张伯玉","text":"三月悲风瑟瑟寒，小船舟楫渡溪难。\n日高待得过岸去，回首修篁千万竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊日喜雪","author":"张伯玉","text":"腊雪常闻百厉销，今年腊日雪飘飘。\n山公预喜明年熟，擘画开春买酒瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题月波楼","author":"张伯玉","text":"烟波万里浮舟国，云木华亭鹤唳乡。\n欲驻野王船一饷，数声风笛肯相将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题新定红渠阁","author":"张伯玉","text":"烟卷龙绡艳格殊，彩霞翻处好风俱。\n几杯仙露含秋色，一曲蟾宫在画图。\n雨送清香浮酒面，泉飞幽韵透城隅。\n州民多有东南美，尽应嘉招入幕无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题新定郡斋寄孝叔二首 其一 后池荷","author":"张伯玉","text":"主人今向日边归，犹有清香满谢池。\n为嘱西风莫摇落，不禁憔悴夕阳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题新定郡斋寄孝叔二首 其二 赏春亭","author":"张伯玉","text":"花意知君改外台，乱红飞尽见苍苔。\n纵教颜色明年在，前度刘郎肯再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日蕺山戒珠寺戏呈僚友","author":"张伯玉","text":"秦望山前晓雁斜，蕺山云外看黄花。\n谁能蒂芥关心绪，且插茱萸伴物华。\n岁计簿书宁有尽，日生公事了无涯。\n樽前况有兵厨酒，不待兵厨酒亦赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官新定同年李郎中以诗赋别即事感怀次韵上答","author":"张伯玉","text":"雨后惊涛激箭催，为君停棹把离杯。\n宦游向老令人笑，别恨伤春触处来。\n故国未归江令宅，全家且上子陵台。\n如今遇酒伸眉醉，休问多才与不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官新定却寄并州通判王几道","author":"张伯玉","text":"新定与并门，天南天北人。\n扁舟江外客，别乘塞垣身。\n朔马惊鸣橐，秋鲈上钓纶。\n何时叙离阔，把酒碧嵩春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小楼独酌","author":"张伯玉","text":"老去春来事事慵，春阴独酌小楼中。\n一千里色江南岸，二十四般花信风。\n祗有溪山迎醉目，更无尘土倦樊笼。\n鹪鹩自得诚堪笑，诗有馀狂酒有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书大禹寺壁","author":"张伯玉","text":"萧寺禹祠傍，人閒白日长。\n讽经闻海穴，洗钵动湖光。\n台殿留风月，烟云起栋梁。\n游人晚回首，松竹自苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书应天寺壁","author":"张伯玉","text":"城郭锁山林，自无尘土侵。\n一峰来海上，高塔起天心。\n世路有盈缩，灵泉无浅深。\n使君今老矣，閒处得閒吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王治臣以余在告宠示嘉什","author":"张伯玉","text":"新安泉石最为佳，多病何劳养岁华。\n药好幸依桐圃近，山安惟畏酒垆赊。\n狂思逸客浮沧海，渴想仙人饮绛霞。\n欲傍重阳支策起，菊房新小玉生芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁日书事","author":"吴充","text":"拂露屠苏酒满巡，越山如鬣水如鳞。\n日边虽望龙庭远，海上初传凤历新。\n好景融融来破雪，和风细细欲黏人。\n莫言老守无心计，排比宾寮醉过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再题州宅","author":"张伯玉","text":"昔览微之州宅篇，待将屏障写山川。\n更看白傅明月句，欲上高楼跨紫烟。\n盘纡星斗旁六郡，零落风骚三百年。\n乔木自存人自远，可怜香案旧神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年李郎中以诗见寄仍许见过次韵和答","author":"张伯玉","text":"新定溪山国，病怀忻所依。\n桐君谈药妙，严濑得鱼肥。\n吏退钞书谱，朋来典道衣。\n轩车如顾我，春酒上苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同孝叔游萧洒亭","author":"张伯玉","text":"昔日贤侯多兴咏，为怜萧洒复潺湲。\n一桥飞处横牛渚，二水清来见浙源。\n雨涨瀑泉添岳面，晚晴春草带潮痕。\n好风新月相留意，只恐张纲拥使轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王治臣九日使君席上二章 其二","author":"张伯玉","text":"新安江碧郡楼危，九日登临醉袖垂。\n莫笑松筠岁寒地，却胜桃李艳阳时。\n清渟酒瑩红螺面，窈窕笙攒碧玉枝。\n未必尊前叹迟暮，几人如我始牵丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王治臣九日使君席上二章 其一","author":"张伯玉","text":"楚枫丹外客帆稀，水拍长天雁字垂。\n乐事喜逢千日酒，凭高正在九秋时。\n吴歈调笑歌杨叶，蛮鼓铿闳引柘枝。\n使骑相逢且留饮，行看卓马辔如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至和中得倅新定今领福唐再经此郡感旧书怀因呈使君刘孝叔","author":"张伯玉","text":"十年前倅北州来，平日风情尚壮哉。\n玉水声中寒濯笔，石楠乡里夜衔杯。\n可怜白首成何事，犹得红旌向北回。\n太守故人应笑我，践言堪愧子陵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次子陵钓台","author":"张伯玉","text":"十载从军去又来，强为颜面走尘埃。\n久惭簪笏未归去，且喜妻孥共此来。\n旋撷岸蔬供野饭，欲题岩壁拂苍苔。\n子陵昔日诚高趣，未必全家上钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次兰溪却寄新定太守","author":"张伯玉","text":"解纚向萧瑟，叙别喜英豪。\n野水征帆迥，秋天醉幕高。\n使旟标画隼，骑吹压霜涛。\n几日狂酲析，思君梦更劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园醉归","author":"张伯玉","text":"向晚西园饮乍阑，山公酩酊上轻鞍。\n东方千骑随车出，南国佳人夹路看。\n纵目渐迷山色远，回头犹忆水声寒。\n归来未放宾游散，更赋新题刻烛观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖楼","author":"张伯玉","text":"积水照层峰，登临谁与同。\n望来生羽翼，醉欲上烟空。\n细细湿花雨，疏疏开袖风。\n新安江上景，尽属此楼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西楼早望","author":"张伯玉","text":"纤纤初日射西楼，楼上帘旌卷绣钩。\n数襞断云秦望晓，一声寒雁鉴湖秋。\n烟波憔悴西施国，风月飘零范蠡舟。\n莫向登临动怀古，有情多为等闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西楼晚望","author":"张伯玉","text":"叠岫敛馀霞，轻舠簇远沙。\n斜阳媚城郭，细柳杂汀花。\n两两联归骑，萧萧起暮鸦。\n谁知故园兴，闲在使君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访禹穴至阳明洞","author":"张伯玉","text":"宛委山前舣画船，攀萝渐入太霄边。\n因寻大禹藏书穴，深入阳明古洞天。\n万壑秋光含细籁，数峰寒玉立苍烟。\n宝函金篆久稀阔，欲就皇人讲数篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐山图","author":"张伯玉","text":"东南真赏有齐山，路隔江湖到者难。\n绝笔扫成千仞翠，数峰高挂一堂寒。\n林僧旧居云泉侣，刺史今为侍从官。\n还似东阳重涵碧，丹青写入雍州看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏同孝叔游朱氏园","author":"张伯玉","text":"冻醪卢橘助登临，此地相逢旧有音。\n石润自知梅信蚤，池方应为玉流深。\n诗成千色排清砌，话久花枝转夕阴。\n不见辟疆妨底事，月楼归去正龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏同孝叔游普光寺","author":"张伯玉","text":"鱼跳莲叶青钱小，雪压花枝玉燕参。\n细草使轓瞻鹿扰，微风池果落莺含。\n满瓯春茗浮仙露，一点尖峰滴翠岚。\n却逐归舟更多景，晚来雌霓挂寒潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到新定后却寄苏州蒋侍郎","author":"张伯玉","text":"遂翁亭畔碧桃开，招隐溪头画舫回。\n曾奉云鸿此真赏，到今羽翼出尘埃。\n閒窥玉字书千卷，渴饮金茎露一杯。\n别后霜天苦寥阔，海云深处望公台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王治臣新定即事","author":"张伯玉","text":"碧泉千脉泻金沟，名是东南俗阜州。\n任昉旧诗题县石，贺齐高叠照江流。\n月明几处游归客，春色何人醉倚楼。\n我是江潭钓鱼者，喜君相见且相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和国镇晚秋斋中见寄","author":"张伯玉","text":"越国风光与众殊，贰车才调世应无。\n晴楼对酌云平海，夜榻分题月满湖。\n吟啸江山君好手，主张诗酒我非夫。\n行当乞挂朱轮去，别作香山九老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张伯玉","text":"令狐太守好权奇，画楼新建月波晖。\n风光似逐水仙去，物色如从云汉归。\n春澹瀛洲浮海曲，涛惊渤澥起天围。\n从今便作月波唱，醉拍姮娥金缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"张伯玉","text":"尽逐鲸鲵埽八区，故人惟我更无馀。\n云台功将任图画，天上客星閒卷舒。\n若把杀人来逐鹿，争似全身归钓鱼。\n先生有意羲皇外，不为林泉傲帝居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日登望海亭","author":"张伯玉","text":"望海亭前春色深，风光澹澹海沈沈。\n潮如世路来还去，山带城芜古到今。\n坐见微云生别岸，吟惊幽鸟起层阴。\n劝君莫苦凭高望，惊动子牟千里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送睦州丁郎中","author":"张伯玉","text":"雨后桐江木叶稀，坐棠无事枕閒攲。\n扁舟几认严君钓，古壁多逢沈令诗。\n夜静好当轮省宿，晓寒堪忆趁朝时。\n山城寂寞郎官贵，想对秋风动所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡斋閒步","author":"张伯玉","text":"花木方塘小，楼台宅院深。\n以何消俸禄，无事任山林。\n雨雪羁游路，风沙苦战心。\n若论当此景，不啻万黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐寺晓钟","author":"张伯玉","text":"扁舟下桐圃，霜月满寒潭。\n疏钟一声起，清与天地参。\n春容逗万壑，窈窕出层岚。\n羁魂不成寐，洗耳涤尘贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题千峰榭呈孝叔","author":"张伯玉","text":"君把元英诗集披，群山依旧绕轩墀。\n杜陵几醉花前地，谢客曾吟日落时。\n雨过荷香兼酒美，云深泉韵透帘迟。\n佳名大约称千数，百万岚盘一一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题玉泉山堂","author":"张伯玉","text":"动非缘境静非禅，物物前尘现四天。\n此地筌蹄求妙论，有时璎络献诸仙。\n欲梅泉石多秋思，过夏松篁聒昼眠。\n一个攒眉招不至，劳师香火漏沈莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监州新定却寄并州旧僚","author":"张伯玉","text":"久从光禄长城戍，却到严陵旧钓滩。\n休问簿书边报急，且听宅舍水声寒。\n舟浮南渡云千里，睡起东窗日数竿。\n寄语晋溪溪上月，楚天虽远一般看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罢新定至钱塘喜见孙观书记","author":"张伯玉","text":"桐江撝袂蚤三年，把臂重来讲旧篇。\n陌上风尘成底事，鬓边霜雪但悠然。\n虬蟠我亦思沧海，鹗荐初方上碧天。\n忍把离杯又抛掷，别愁纷泊满春烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥堂寓兴","author":"张伯玉","text":"疏竹閒花阴，了无尘土侵。\n旌麾千骑长，风月一堂深。\n海气生吟榻，烟香披醉襟。\n山翁方自得，莫问去留心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿桐庐县江口","author":"张伯玉","text":"桐庐江水碧，百丈见游鱼。\n元是新安水，流从下濑初。\n清风寒到底，明月静涵虚。\n尘土谁难濯，人心自不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄会稽刁景纯学士","author":"张伯玉","text":"雨后稽山紫翠毫，使君千骑压云鳌。\n楼台日暖花木丽，河汉夜凉丝竹高。\n瀛馆久淹骐骥足，越人今识凤凰毛。\n江南老守思离阔，梦想时过白鹭涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄新定苏七太守","author":"张伯玉","text":"闻道银符渡睦溪，桐山应为长清晖。\n渔翁几十迎舟拜，沙鸟成双夹旆飞。\n检点簿书茶贡蚤，体量风物橘奴肥。\n题舆自愧来何晚，未得云中瞩使威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄睦州朱少卿","author":"张伯玉","text":"何幸乡枌托使麾，忆曾淮澨见风仪。\n泉分龙岫成新酿，庙锁琼蕤换旧枝。\n二水清涵潭月夜，千峰晴捲雪云时。\n向来萧洒称名郡，少缓龚黄次补期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄睦州苏七使君","author":"张伯玉","text":"阔步曾飞到广寒，一麾聊顿野云间。\n虬蟠涧底未失水，鹤在笼中且看山。\n旧日笑谈犹壮否，近来书信亦稀还。\n严滩桐岭宜秋醉，却恐才高不奈閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游叔虞祠","author":"张伯玉","text":"庙中桐叶手中文，闲读高碑拂素尘。\n异陇归禾曾是主，徒林射兕独留神。\n关河莫问周秦事，花木谁分汉魏春。\n惟有门前旧溪水，秋风幽咽送行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答王越州蓬莱阁","author":"张伯玉","text":"书报蓬莱高阁成，越山增翠越波明。\n云收海上天地静，人在月中金翠横。\n游女弄芳珠作佩，仙人度曲玉为笙。\n会须长揖浮丘伯，醉听银河秋浪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答延平王八使君望江亭见怀之什","author":"张伯玉","text":"望江亭上望桐江，烟水茫然隔锁窗。\n擢第蚤同丹桂树，从军俱在碧油幢。\n天遥皓月人千里，书托红鳞锦一双。\n开府时多家令瘦，酒旗犹恐未相降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新安江舟中奉酬孙观书记","author":"张伯玉","text":"十年塞外忆江山，今日扁舟纵眼看。\n匝岸野花红似簇，避人沙鸟起成团。\n放怀自古酒为得，老笔到今诗最难。\n君解高吟我方饮，几人能共此清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新定望湖楼","author":"张伯玉","text":"龙盘山影倒寒流，十里屏风翠入楼。\n画笔肯归涵碧手，湖光疑对涌金秋。\n主翁爱客排三雅，渔父忘机任直钩。\n为访红云绕花岛，满船歌舞按梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睦州","author":"张伯玉","text":"千家楼阁丽朝晖，人到于今说钓矶。\n雨后数峰骄欲斗，春来两港活如飞。\n高吟多谢沈家令，中酒长怜杜紫微。\n更爱严城无锁处，白云摇漾去还归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓬莱阁归醉","author":"陈公辅","text":"蓬莱阁上醉归时，犹索芳樽步步随。\n啼鸟似来留翠佩，旁人笑为整花枝。\n腰间半亸黄金印，头上斜攲白接䍦。\n拍手向他宾从道，使君未老莫扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遥题钱公辅众乐亭","author":"张伯玉","text":"句章太守钱君倚，湖上新为众乐亭。\n花木岂徒游子爱，笙歌长与郡人听。\n坐来高韵天风起，饮罢馀香夕雨零。\n安得凭阑纵吟笔，玉觞遥对数峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉泉","author":"张伯玉","text":"灵源曾记古篇章，飞入霜筠万丈长。\n六月林风吹宝瑟，九秋山翠坼银潢。\n试茶石鼎云含液，酿酒兵厨菊有香。\n到此欲知真玉性，不为圆折本来方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题思范轩二首 其二","author":"张伯玉","text":"天下儒宗不世勋，履声今绝岂重闻。\n空馀逸韵传流水，犹喜清风在此君。\n山倚孔祠分积翠，篆寻严濑挂香云。\n接花酬倡将三记，时拂尘篇见旧文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题思范轩二首 其一","author":"张伯玉","text":"英衮多年去竹轩，更思风节记山樊。\n抗言后坐遗忠美，通使河源旧策存。\n诗石欲留千古永，棠阴还对一楼繁。\n使君才望须相继，莫厌林间驻画轓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题禹庙","author":"张伯玉","text":"宝穴千峰下，严祠一水傍。\n夜声沧海近，秋势越山长。\n薄葬超前古，贻谋启后王。\n万灵何以报，终古咏怀襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈虞卿","author":"张伯玉","text":"东吴王孙归挂冠，玉丝红鲙满雕盘。\n狂吟但觉日月久，醉舞不知天地宽。\n小圃移花山客瘦，夜窗捣药橘童寒。\n新书近日成多少，且告先生旋借看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自新定沿牒三衢舟中寓兴寄所知","author":"张伯玉","text":"井落瓯闽近，乡亭百粤连。\n一蓱游宦客，两桨上滩船。\n石壅千寻浪，山围几匝天。\n乱篙鸣远屿，群噪捧危舷。\n峡断疑无路，汀回复济川。\n林深羡沙鸟，村近喜人烟。\n岂昧垂堂诫，都由稍食牵。\n家山旧庐在，蚤晚赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]