[{"title":"蒲中杂咏 白楼","author":"赵鼎","text":"寸断吟肠柰此何，临高怀远足悲歌。\n若教尽写凄凉意，东阁郎君语更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 文瑞堂","author":"赵鼎","text":"辛苦鱼虫老著书，一生冷淡笑迂儒。\n何当马上提三尺，去作凌烟大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 建安堂","author":"赵鼎","text":"潇然一枕北窗凉，唤取樵青发嫩香。\n净洗西州羊炙口，要看妙语落冰霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 必种轩","author":"赵鼎","text":"此君风度固萧然，谁解招邀到此轩。\n要识维摩真面目，支离瘦骨寂无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 河山阁","author":"赵鼎","text":"干戈险阻恃河关，祸乱相寻一转丸。\n千载太平归有道，牂牁青海尽衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 种学轩","author":"赵鼎","text":"诗书千亩浩从横，蚤岁勤劳费笔耕。\n纨裤儒冠定谁饱，年年妻子笑谋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 精思轩","author":"赵鼎","text":"穷年兀兀究遗编，圣处工夫也自贤。\n政苦齑盐食不足，诸生毋诮腹便便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 竹轩","author":"赵鼎","text":"笙箫声断一杯残，翠袖云鬟共倚栏。\n要藉馀阴清晚醉，酸寒莫作子猷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 北阁","author":"赵鼎","text":"一时相见万夫雄，蔓草荒陵剑甲空。\n争战百年无处问，高城弦管正春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 鹳雀楼","author":"赵鼎","text":"目断河梁有许愁，人生离合最悠悠。\n遥怜别夜登临怨，不减清秋燕子楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 披风亭","author":"赵鼎","text":"飞步临风亦快哉，雌雄何苦赋兰台。\n只凭一弄渔舟笛，唤得凉飙渡水来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 碇斋","author":"赵鼎","text":"长波浩渺拍青山，细雨蓬窗一觉眠。\n但向急流能暂止，从他蛟鳄怒垂涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 临川亭","author":"赵鼎","text":"卷落银潢天汉涯，坐观河伯势雄誇。\n游人不识支机石，拟向津梁问客槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 河西亭","author":"赵鼎","text":"波光山色雨溟濛，粉雉红楼杳霭中。\n自是人间佳丽地，不须寻访水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 行庆关","author":"赵鼎","text":"振跸鸣銮万马环，悲歌应鄙汉楼船。\n关头老吏亲曾见，千丈荣光夜烛天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 铁佛寺","author":"赵鼎","text":"波面香风落磬声，夕阳楼殿更分明。\n蓬莱弱水端难到，聊与人间作化城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 李园","author":"赵鼎","text":"射虎将军竟不侯，脱身锋镝老菟裘。\n柳枝折尽东风晚，闲对酴醾一醉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 淙玉亭","author":"赵鼎","text":"跳珠溅雪满空岩，疏涤心灵爽气严。\n彷佛瑶台明月下，佩环声在水晶帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 逍遥亭","author":"赵鼎","text":"郁郁亭前三四松，苍髯疑是采芝翁。\n归欤莫作终南卧，无限英雄落彀中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 此君亭","author":"赵鼎","text":"飘零谁复问平安，只得幽人冷眼看。\n流水空山云暮合，此君无乃太清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 御波亭","author":"赵鼎","text":"泠然我欲御波行，身世由来水上萍。\n好笑安期空狡狯，犹须赤鲤渡沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 王母观","author":"赵鼎","text":"月下何人唱步虚，如闻仙子好楼居。\n五云缥缈星河阁，肠断青鸾一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 面山堂","author":"赵鼎","text":"老去收身百战场，厌闻鼓吹奏西凉。\n凭君剩把珠帘卷，要与青山共此觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 涵虚阁","author":"赵鼎","text":"鹊飞乔树月临波，仿佛天孙掷夜梭。\n卷尽纤云风不动，却从直下看星河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲中杂咏 南轩","author":"赵鼎","text":"璧月沉沉过女墙，时闻桂子落天香。\n三山碧海无消息，双燕归飞秋色荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虞乡道中菊","author":"赵鼎","text":"冱露低烟拟怨谁，凄然亦自惜馀姿。\n无人为买蒲城酒，正是柔桑叶落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和通守王元美二绝句 其一","author":"赵鼎","text":"断无车马访闲曹，背暖儿童罢抑搔。\n叹息深林有兰蕙，谁能收拾赋离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和通守王元美二绝句 其二","author":"赵鼎","text":"志士犹来惜寸阴，青铜那觉二毛侵。\n留连春色一樽酒，未必东风识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和倅车韵 其一","author":"赵鼎","text":"斯文天意属吾曹，技痒何由一快搔。\n莫抚断弦思凤髓，如公便可将风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和倅车韵 其二","author":"赵鼎","text":"高标聊复寄尘凡，此意难从俗子谈。\n烂醉狂吟公勿怪，公犹如此我何堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解池役所大风","author":"赵鼎","text":"初从蘋末转飘摇，回薄山林势益豪。\n好笑堤边肤寸水，便能平地作波涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解梁别李氏女子晚宿静林寺 其一","author":"赵鼎","text":"满眼西风恨别离，路逢萧寺叩柴扉。\n团栾一听无生话，更觉前谋种种非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解梁别李氏女子晚宿静林寺 其二","author":"赵鼎","text":"山下人家鸡黍时，解鞍那暇拂尘衣。\n宦游无况田园薄，自问此生何以归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"解梁别李氏女子晚宿静林寺 其三","author":"赵鼎","text":"森森竹树晓生寒，病怯秋衾梦易阑。\n欲驾征鞍慵未起，卧听渔鼓吼空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客舍重九","author":"赵鼎","text":"半月征衫困路尘，一樽芳酒谩情亲。\n心知不是陶彭泽，只恐黄花解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扬州竹西亭 其一","author":"赵鼎","text":"路入扬州秋草残，竹西亭上曲栏干。\n而今那复闻歌吹，黄叶西风薄暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扬州竹西亭 其二","author":"赵鼎","text":"锦缆牙樯一梦愁，行人空击木兰舟。\n玉箫吹断青楼锁，二十四桥风月秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大明水","author":"赵鼎","text":"咫尺城中膏火煎，空山竹柏固苍然。\n赠君杯酌清心骨，此是人间第一泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋江晚渡","author":"赵鼎","text":"木落空江淡夕霏，疏篷一叶并渔矶。\n秋风几许莼鲈兴，亦欲临流唤渡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨夜不寐","author":"赵鼎","text":"西风吹雨夜潇潇，冷烬残香共寂寥。\n要作秋江篷底睡，正宜窗外有芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊秦淮雪中一绝","author":"赵鼎","text":"不知门外月波寒，但觉樽前酒量宽。\n向道东风莫吹去，暂教楚客作花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵退翁雪中书事 其一","author":"赵鼎","text":"营邱图画展霜绡，眩转寒光鉴影摇。\n更待东风开夜色，月明洛水断冰消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵退翁雪中书事 其二","author":"赵鼎","text":"纤柔醉撚小梅花，顾影娇春玉凤斜。\n不觉窗前三尺雪，夜风万里卷龙沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵退翁雪中书事 其三","author":"赵鼎","text":"章台走马最多情，不怕春衫扑粉英。\n半夜归来寒梦短，潇潇卧听打窗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵退翁雪中书事 其四","author":"赵鼎","text":"笔头造化渺无边，闻道春来思涌泉。\n定向山台得佳句，湿云残雪冷侵天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风回舟泊新河口饮李氏酒肆后轩 其一","author":"赵鼎","text":"西风吹面浪如山，却并寒沙夜系船。\n两日不能离故处，人间岐路敢争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风回舟泊新河口饮李氏酒肆后轩 其二","author":"赵鼎","text":"八节愁闻上水滩，江流东下许艰难。\n青帘招我非无意，端为疏篷夜枕寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风回舟泊新河口饮李氏酒肆后轩 其三","author":"赵鼎","text":"满眼豺狼兵火馀，我今那暇哭穷途。\n青鞋踏雪江南岸，试觅黄公旧酒垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊柴家湾风物宛如北上","author":"赵鼎","text":"雨过平田陇麦青，春深桑柘暖烟生。\n恍如身在澜洄曲，肠断东风杜宇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三衢多碧轩","author":"赵鼎","text":"平生爱山心不足，寸碧已复明双眸。\n暮年得此幽栖地，枕上烟岚万叠秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将至常山先寄诸幼","author":"赵鼎","text":"经年游宦叹离群，相见提携数候门。\n一笑相看即无事，径须归办酒盈樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张京与之宰解县 其一","author":"赵鼎","text":"条山洓水是吾家，君去重开满院花。\n邂逅故人相借问，为言秋鬓点霜华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张京与之宰解县 其二","author":"赵鼎","text":"长堤百里并山回，漫漫沧波鉴影开。\n要看天工种明玉，请君少待盐风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张京与之宰解县 其三","author":"赵鼎","text":"栖迟出处略相同，握手论情一笑逢。\n便作他年林下约，一樽相对两衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次明仲韵 其一","author":"赵鼎","text":"曾谒祥曦羽盖黄，天衣纷扰御炉香。\n蒙尘草莽干戈隔，坐看边氛蔽日光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次明仲韵 其二","author":"赵鼎","text":"浩浩颠风尘四合，漫漫后土水平流。\n无人举手披云雾，却放晴曦照九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次明仲韵 其三","author":"赵鼎","text":"尘沙渺渺暗城楼，心切尧云泪欲流。\n慷慨一卮戏下酒，诸郎谁是舞阳侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次明仲韵 其四","author":"赵鼎","text":"一年春事到耕桑，辽绝乡山恨渺茫。\n清梦不成风雨夜，更堪诗思搅饥肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除吏部郎题建康省中直舍壁","author":"赵鼎","text":"四海茫茫扰战尘，岂无贤俊共经纶。\n可怜伧父今头白，也作江南第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其一","author":"赵鼎","text":"武陵归棹几重山，回首沧波锁暮烟。\n一寸愁生千万斛，可能容易付湘弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其二","author":"赵鼎","text":"东风春水湛晴天，斜日平林画素烟。\n不会浮云亦多事，又将飞雨过山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其三","author":"赵鼎","text":"小圃来时春向深，酴醾犹得伴孤斟。\n欲留午枕梦归去，缥缈行云何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其四","author":"赵鼎","text":"满马尘埃叹滞留，空劳魂梦绕南州。\n涌金亭下烟波阔，聊作西湖一段秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其五","author":"赵鼎","text":"山色于人定有缘，髻鬟眉黛巧争妍。\n何当招我白云下，坐对苍崖百尺泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其六","author":"赵鼎","text":"夜凉波面涌金霞，坐觉天香落桂华。\n便合泠然御风去，玉川何待七杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其七","author":"赵鼎","text":"飞桥跨岸饮晴虹，云散风微水月空。\n日日尘沙困鞍马，暂留身在广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其八","author":"赵鼎","text":"台高山远淡如无，愁极羁人念索居。\n一任东风吹鬓发，潇潇蓬葆不禁梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其九","author":"赵鼎","text":"风堕何能续断弦，只凭樽酒送彫年。\n仙人示我长生术，除却醉乡非洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其十","author":"赵鼎","text":"宦学平生着意深，要从黄卷古人寻。\n功名富贵非吾事，只有渊明会此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其十一","author":"赵鼎","text":"昨非今是若为论，有愧悠悠出岫云。\n老鹤乘轩本无意，何妨饮啄混鸡群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"役所书事用山谷观化韵 其十二","author":"赵鼎","text":"浩荡东风卷送春，娇莺雏燕谩争新。\n此心自有青山约，不是看花陌上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会郑有功","author":"赵鼎","text":"江流变血火连天，闻道舟行相后先。\n今世谋身无第一，政缘夫子爱逃禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自越趋明上虞道中和季申梅四首 其一","author":"赵鼎","text":"关山戎马信音稀，肠断无人寄一枝。\n沾酒西城联骑入，上林踏雪探春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自越趋明上虞道中和季申梅四首 其二","author":"赵鼎","text":"孤标亦自惜幽姿，折赠行人第几枝。\n万斛清愁江上雨，曾看结子欲黄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自越趋明上虞道中和季申梅四首 其三","author":"赵鼎","text":"玉瘦香寒不自持，潇然冷蕊暗疏枝。\n向来几许闲花木，及见春光烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自越趋明上虞道中和季申梅四首 其四","author":"赵鼎","text":"天与清芬心自知，丛林深处出纤枝。\n发明无限春消息，正是风霜作恶时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自四明回越宿通明堰下","author":"赵鼎","text":"短棹还随海浪回，通明堰下小徘徊。\n东风吹落篷窗雨，点点春愁枕上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦文携玉友见过出示致道小诗因次其韵 其一","author":"赵鼎","text":"一壶春色玉生光，最爱霏霏绕鼻香。\n浅醉不禁衣袖冷，幽林风雨夜苍凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]