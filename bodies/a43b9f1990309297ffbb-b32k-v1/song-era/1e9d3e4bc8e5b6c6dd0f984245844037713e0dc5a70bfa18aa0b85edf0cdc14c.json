[{"title":"水调歌头 寿丘漕九月初三","author":"李刘","text":"端正九秋月，今夜始生明。\n扬辉毓秀，飘然海上跨长鲸。\n认得灵均初度，直用望舒为御，重耀紫枢庭。\n何事乘槎使，尚藉执圭卿。\n合东西，瞻使节，镜中行。\n腾腾渐渐，绕枝乌鹊不须惊。\n太白擒胡了未，即墨降城安否，玉斧仗修成。\n圆却山河影，捣药兔长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 寿魏制干九月十九","author":"李刘","text":"万里彩衣远，旬日黄花后。\n蓬矢纪佳辰，莲幕翻新奏。\n更看桂枝香，归献灵椿寿。\n同对小蟠桃，共醉长生酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 寿谢宪，在四川类省试院","author":"李刘","text":"湘江贯地维，衡岳生人杰。\n谁遣益州星，暂伴峨眉月。\n初度庆今朝，绣斧双龙节。\n为国罩嘉鱼，趣觐黄金阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鱼游春水 寿衙大参","author":"李刘","text":"湖南三千里。\n百万人家争送喜。\n元戎初度，和气水流山峙。\n荆楚中间寿域开，翼轸傍边台躔起。\n崧岳降神，维箕骑尾。\n见说君王注倚。\n问舟楫、盐梅谁是。\n国人争望周公，东归几几。\n功名多载旗常上，福禄平分天壤里。\n家家弦管，年年弧矢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 上赵侍郎生日","author":"李刘","text":"鹄立通明殿。\n又重逢、揆余初度，梦庚华旦。\n不学花奴簪红槿，且看秋香宜晚。\n任甲子、从新重换。\n天欲东都修车马，故降神生甫维周翰。\n歌崧岳，咏江汉。\n明堂朝罢夷琛献。\n引星辰、万人共听，风尘长算。\n清昼山东诸将捷，席卷黄河两岸。\n问谁在、玉皇香案。\n师保万民功业别，向西京、原庙行圭瓒。\n定郏鄏，卜瀍涧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 庆董内机","author":"李刘","text":"濯锦江边玉树明。\n碧油幢里彩衣荣。\n当年此日下长庚。\n细酌成都千岁酒，闲看嶰谷一阳春。\n归听云母隔屏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 自寿","author":"李刘","text":"我生辰在斗牛中。\n井路有何功。\n运转峨眉山月，按行雪界天风。\n归欤老矣，愁添鬓白，酒借颜红。\n丘壑堪容我辈，轩裳分付诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 上程宪卓，程尚书大昌侄","author":"李刘","text":"郑履声传，倪经业绍，半千贤运重开。\n妙年阔步，高折桂枝回。\n卿月郎星历遍，都贪把、符竹南来。\n棠阴永，仍持玉节，臬事副钦哉。\n吾生，真幸会，旧家桃李，曾费栽培。\n更春风次第，吹到寒荄。\n遥望绂麟祥旦，霄躔邈、阻奉琅杯。\n谁知道，清源路远，直上即蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 寿漕使","author":"李刘","text":"汉庭用老，想君王也忆、潜郎白首。\n底事煌煌金玉节，奔走天涯许久。\n江右风流，湖南清绝，更借诗翁手。\n明年七十，人间此事希有。\n固是守得堂间，鲂斋亭下，要称归来柳。\n上恐夜深□贾傅，便有锋车迎候。\n寿岳峰前，寿星池畔，且寿长沙酒。\n期颐三万，祖风应管依旧。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 寿吴倅九月初七","author":"李刘","text":"恰则重阳信宿前。\n菊潭先寿濮阳仙。\n暂陪明月清风夜，共醉孤云落照边。\n群玉府，紫微天。\n看看东壁二星连。\n月中斫桂吴夫子，定是长生不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临漳台","author":"李则","text":"亭枕临漳一水阴，半空云雾锁寒林。\n山从天宝来鸾远，基辟开元历代深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李提刑李参政再和招鹤诗再用韵以谢 其一","author":"魏了翁","text":"静看瀺灂几游鳞，争似玄裳缟袂生。\n几度有书招不至，应惭侧翅傍他人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄香橙","author":"李?","text":"黄云冉冉晓苍苍，闲倚平湖只自香。\n较似寒梅虽未至，依然风韵挟风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊寅入岭丁亥上元游碧落洞","author":"李华","text":"乳床奇诡鉴清涟，碧落真人古洞天。\n十载南游才一到，不访重补到难篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸱夷子皮赞","author":"李华","text":"龙蟠幽谷，非时则伏。\n蝉蜕高枝，饮露而飞。\n进如风行，退若云归。\n冥冥其几，赫赫其居。\n于越霸兴，强吴荡夷。\n功成不居，先生得之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李华","text":"后夜郁孤台上月，更从何处照诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上黄端明寿诗以伫期三入后一品见玄孙为韵 其十","author":"李吕","text":"阻陪称寿席，想见醉芳樽。\n嘉庆宜图画，簪绅遍子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上黄端明寿诗以伫期三入后一品见玄孙为韵 其三","author":"李吕","text":"献替先其大，从容接每三。\n但知言謇謇，肯顾府潭潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上黄端明寿诗以伫期三入后一品见玄孙为韵 其九","author":"李吕","text":"贱子甘藏拙，无心学草玄。\n自然多坎壈，不是乐盘旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上黄端明寿诗以伫期三入后一品见玄孙为韵 其四","author":"李吕","text":"仗节朔庭回，建议光明入。\n尽得强敌情，何人敢轻袭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上黄端明寿诗以伫期三入后一品见玄孙为韵 其六","author":"李吕","text":"姓字本无双，山林今见一。\n动必合礼经，心焉在王室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上黄端明寿诗以伫期三入后一品见玄孙为韵 其二","author":"李吕","text":"器识谁能及，功名自有期。\n一朝闻正论，亲切在彤墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己亥出南康宫伯称以诗赠行次韵三首 其三","author":"李吕","text":"君才端可用于时，努力行将彻主知。\n出处到头皆分定，相期于道不须离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetr