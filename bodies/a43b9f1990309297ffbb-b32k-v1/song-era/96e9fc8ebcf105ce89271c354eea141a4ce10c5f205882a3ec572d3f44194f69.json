7053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同徐吕二子游西湖复次前韵五首 其一","author":"陈造","text":"老去胡宜誓酒卮，兴来破戒为君持。\n自今排日花间醉，报答春光已后时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元冬再到盱眙四首 其四","author":"陈造","text":"日行荦确面孱颜，旧惯山居意易阑。\n见说烟云暝崷崒，北人争指画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元冬再到盱眙四首 其三","author":"陈造","text":"醴筵曾作二年留，静镇人今郭细侯。\n望断江南空梦到，西风斜照白杨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元冬再到盱眙四首 其二","author":"陈造","text":"平日朝京此问途，如今一水剪坤舆。\n客来羡杀闲鸥鹭，北翥南飞得自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元冬再到盱眙四首 其一","author":"陈造","text":"虎头山下参天柳，亲见栽时共我长。\n柳自摧残人自老，半生不抵熟黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏促黄簿鸡粥约三首 其三","author":"陈造","text":"只鸡可餍小人腹，未羡侯家千足羊。\n借问解鼋食指动，何如蒸鸭瓠壶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏促黄簿鸡粥约三首 其二","author":"陈造","text":"鹅炙博嗔宁复计，马肝知味不须评。\n老宜此辈充庖宰，更问钻篱与不鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏促黄簿鸡粥约三首 其一","author":"陈造","text":"微吟仰屋耐调饥，腹负将军竟是谁。\n侧耳邻翁隔墙唤，黄鸡粥熟是何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其七","author":"陈造","text":"虎丘僧宇瞰坡陀，几许香軿载酒过。\n游子花骢烟外驻，丽人尘袜水边多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其一","author":"陈造","text":"不是风寒即雨寒，朝来春意破天悭。\n怪君未解春皇意，恐把韶华付等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其四","author":"陈造","text":"中林频度养花风，合放林梢一点红。\n蝴蝶与春偏有约，依依先占去年丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其十","author":"陈造","text":"馆娃宫外趁游人，不见湖山自在春。\n闻道石湖清绝处，芳时不著绮罗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其三","author":"陈造","text":"树外晴云不拟飞，东风无力惬单衣。\n垂杨院宇斜阳里，还是钩帘待燕归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其二","author":"陈造","text":"倏看媚白破梅枝，更喜娇黄著柳丝。\n春事斩新当客眼，可须山鸟报人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其九","author":"陈造","text":"鸱夷古锦犊车辕，盘薄沙鸥舞蝶前。\n少日长安聚蚊梦，莫年诗酒解随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其五","author":"陈造","text":"杏羞桃涩要诗催，客子情钟倍费才。\n惜欠王家千杖鼓，辊雷声里看花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其六","author":"陈造","text":"未须看竹扣人门，且复寻梅过水村。\n香片点衣归马健，临风只博断吟魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春十绝呈石湖 其八","author":"陈造","text":"缓引牙樯载绮罗，宽围丝锦著笙歌。\n小抬醉眼游丝外，夕照御城奈乐何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早夏 其一","author":"陈造","text":"安石榴花猩血鲜，凉荷高叶碧田田。\n鲥鱼入市河豚罢，已破江南打麦天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱倅索诗作三绝谢之 其一","author":"陈造","text":"因循不试推敲手，日月消磨簿领间。\n旧故书来尽新作，穷儿券负几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱倅索诗作三绝谢之 其三","author":"陈造","text":"从公挥扫且观傍，免费雕镌苦肾肠。\n血指忍惭嗟已老，怒矊相向更深防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王巡检韵三首 其三","author":"陈造","text":"每愧铜盘走柘丸，忽惊檀轴卷丝阑。\n真成敝帚千金享，笑唤诸雏挂壁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王巡检韵三首 其二","author":"陈造","text":"平生嘿识玩诗昌，对客挥毫底未忘。\n祇恐韩陵读碑客，诮君草草诮吾狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王巡检韵三首 其一","author":"陈造","text":"掐肾搜肠不自奇，细模深刻似非宜。\n流传纵便鸡林售，指擿防遭鹅腿嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次史髯韵二首 其二","author":"陈造","text":"已误西湖鸥鹭约，客舟西上更徘徊。\n故人益叹天涯远，怀抱何从得好开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次史髯韵二首 其一","author":"陈造","text":"痛忆分题把酒时，暑寒谁遣隙驹驰。\n芙蓉风露梅花月，又费骚人几首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次石湖送炭韵赠龚养正三首 其三","author":"陈造","text":"寒谷冰崖底著身，望晨疑寝越王薪。\n今年未办巡檐笑，急雪阴风肯贷春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次石湖送炭韵赠龚养正三首 其二","author":"陈造","text":"广文书案雪沾身，灶妇冰菹焮湿薪。\n綵胜银花犹拜赐，冻醅寒饼不成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次石湖送炭韵赠龚养正三首 其一","author":"陈造","text":"饥乌窘兔不谋身，君亦衣穿桂作薪。\n小露化工陶铸手，地炉分得雪中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次两知县韵四首 其四","author":"陈造","text":"政成无复败群羊，万轴书前一缕香。\n明日过君况休务，茶边清话不妨长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次两知县韵四首 其三","author":"陈造","text":"似我聱牙亦漫官，倚君风义慰羁单。\n开缄更识新诗法，脱手铜丸转玉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次两知县韵四首 其二","author":"陈造","text":"暴醉琳腴饱栈羊，巡檐闲认小梅香。\n胡床曝背关情甚，古锦囊诗引兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次两知县韵四首 其一","author":"陈造","text":"老去栖迟八品官，剑颐深悔诮田单。\n东邻未省吟髭断，笑掷牙牌命肉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张节推山字韵诗留其行 其五","author":"陈造","text":"老丑只宜岩谷里，何人挈致俊贤间。\n虽云章服裹叔夜，尚有笭箵随次山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张节推山字韵诗留其行 其三","author":"陈造","text":"红尘叹我奔驰久，空谷逢君梦寐间。\n政使公荣可无饮，风江惊浪涌银山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张节推山字韵诗留其行 其二","author":"陈造","text":"人瞻甫里歊埃外，诗著苏州伯仲间。\n爽气凭销残暑尽，钩窗不用对西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张节推山字韵诗留其行 其六","author":"陈造","text":"故人偶得一饭款，僻县才馀十亩间。\n赤米白盐君勿诮，病夫官况等居山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张节推山字韵诗留其行 其四","author":"陈造","text":"粹学堂堂真有本，玄谈亹亹尽无间。\n小回馀事入诗律，句法还能逼后山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张节推山字韵诗留其行 其一","author":"陈造","text":"足音肯到寂寥处，风味要看樽俎间。\n行役小休良不恶，雷声昨夜殷南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张丞送菊韵二首 其二","author":"陈造","text":"寒花彭泽门阑旧，好句柯山伯仲间。\n贫负清樽只三益，诗人错笑庾郎悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]