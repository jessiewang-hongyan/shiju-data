,"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘向二首 其二","author":"陈造","text":"若将初节订贤愚，圣哲功名古亦无。\n一代儒宗忧国意，当年几落伪金诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘向二首 其一","author":"陈造","text":"江边逐客楚宗卿，谏数君疏命自轻。\n可信后儒惭往哲，辄将强聒议更生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘有诗再次韵四首 其四","author":"陈造","text":"耐暑支离倚瘦筇，百金未博一襟风。\n了知诗有蠲痾力，绝胜江涛捲碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘有诗再次韵四首 其三","author":"陈造","text":"此君高韵已萧然，更向新诗得媚川。\n谁遣小家藏二妙，为君时炷水沉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘有诗再次韵四首 其二","author":"陈造","text":"已后湖州秃鬓翁，喜君挥扫有遗风。\n幻成殢雨熹晴态，尽使尘凡一洗空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘有诗再次韵四首 其一","author":"陈造","text":"小点猩毫出碧鲜，技随文思各增川。\n祇应月地饶般礴，心醉寒梢曳晓烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689"