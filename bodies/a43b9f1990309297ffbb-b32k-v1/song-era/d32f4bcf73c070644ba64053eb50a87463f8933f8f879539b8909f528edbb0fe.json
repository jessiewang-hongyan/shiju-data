[{"title":"淳祐祭海神十六首 送神用《成安》。","author":"郊庙朝会歌辞","text":"告灵飨矣，锡我嘉祚。\n乾端坤倪，开豁呈露。\n玄云聿收，群龙咸骛。\n灭除凶灾，六幕清豫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 亚、终献用《飨安》。","author":"郊庙朝会歌辞","text":"笾豆有楚，贰觞斯旅。\n神其醉饱，式燕以序。\n百灵秘怪，蜿蜒飞舞。\n锡我祺祥，有永终古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 北海位酌献用《溥安》。","author":"郊庙朝会歌辞","text":"倏忽会同，裴回安留。\n牲肥酒香，晨事聿修。\n惟德之凉，曷奄九州。\n帝命是祗，多福自求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 西海位酌献用《类安》。","author":"郊庙朝会歌辞","text":"积流疏派，被于流沙。\n布润施泽，功均迩遐。\n我秩祀典，四海一家。\n祗荐令芳，灵其享嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 南海位酌献用《贵安》。","author":"郊庙朝会歌辞","text":"南溟浮天，旁通百蛮。\n风樯迅疾，琛舶来还。\n民商永赖，坐消寇奸。\n荐兹嘉觞，弭矣惊澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 东海位酌献用《熙安》。","author":"郊庙朝会歌辞","text":"沧溟之德，东南具依。\n熬波出素，国计攸资。\n石臼却敌，济我王师。\n神其享锡，益畀燕绥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"昭格灵贶，祀典肇升。\n牲牷告充，雕俎是承。\n荐虔效物，省德惟馨。\n灵其有喜，万宇肃澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 北海位奠玉币用《瀚安》。","author":"郊庙朝会歌辞","text":"瀚海重润，地纪亦归。\n吞受百渎，限制北陲。\n一视同仁，我心则怡。\n嘉荐玉币，神其格思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 西海位奠玉币用《润安》。","author":"郊庙朝会歌辞","text":"蒲昌之泽，派引天潢。\n羲娥出入，浩渺微茫。\n盖高斯覆，犹隔封疆。\n我思六合，肇正吉昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 南海位奠玉币用《瀛安》。","author":"郊庙朝会歌辞","text":"祝融之位，贵乎三神。\n吞纳江汉，广大无垠。\n长为委输，祐我黎民。\n敬陈明享，允鉴恭勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 东海位奠玉币用《德安》。","author":"郊庙朝会歌辞","text":"百川所归，天地之左。\n澒洞鸿濛，功高善下。\n行都攸依，百禄是荷。\n制币嘉玉，以侑以妥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 升降用《钦安》。","author":"郊庙朝会歌辞","text":"灵之来至，垂庆阴阴。\n灵之已坐，饬兹五音。\n坛殿聿严，陟降孔钦。\n灵宜安留，鉴我德心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 其四 迎神用《延安》。","author":"郊庙朝会歌辞","text":"猗与祀礼，四海会同。\n灵之来沛，鞭霆驭风。\n肸蚃彷佛，在位肃雍。\n佑我烝民，式徼神功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 其三 迎神用《延安》。","author":"郊庙朝会歌辞","text":"若稽有唐，克致崇极。\n祝号既升，爰增祭式。\n从享于郊，神斯受职。\n我祀肇新，式祈阴骘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 其二 迎神用《延安》。","author":"郊庙朝会歌辞","text":"四溟广矣，八纮是纪。\n我宅东南，回复万里。\n洪涛飘风，安危所倚。\n祀事特隆，神其戾止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐祭海神十六首 其一 迎神用《延安》。","author":"郊庙朝会歌辞","text":"堪舆之间，最钜惟瀛。\n包乾括坤，吐日滔星。\n祀典载新，礼乐孔明。\n鉴吾嘉赖，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其十一 内侍官举太上皇后册诣读册位用《圣安》。举宝同。","author":"郊庙朝会歌辞","text":"珉玉玢豳，袅蹄精良。\n既刻厥文，亦铸之章。\n象德维何，至静而方。\n辅我光尧，万寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其十 太上皇后出阁升御坐用《坤安》。","author":"郊庙朝会歌辞","text":"重翟出房，袆衣被躬。\n委委佗佗，河润山容。\n圣皇临轩，圣母在宫。\n并受鸿名，与天无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其九 皇帝从太上皇后册宝诣宫中用《正安》。","author":"郊庙朝会歌辞","text":"丕显文王，之德之纯。\n亦有太姒，式扬徽音。\n维册维宝，乃玉乃金。\n伊谁从之，一人事亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其八 太傅奉太上皇后册宝升殿用《圣安》。","author":"郊庙朝会歌辞","text":"乾健坤从，阳刚阴相。\n迨兹受祉，允也并况。\n虡业在下，仪物在上。\n咨时三公，执事无旷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其七 太傅奉太上皇帝册升殿用《圣安》。奉宝同。","author":"郊庙朝会歌辞","text":"天畀遐福，允彰父慈。\n维昔旷典，我能举之。\n徐尔陟降，敬尔威仪。\n申锡无疆，永言保之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其六 太上皇帝升御坐用《乾安》。降同。","author":"郊庙朝会歌辞","text":"天行惟健，天步惟安。\n圣子中立，臣工四环。\n民无能名，威不违颜。\n宋德宜颂，汉仪可删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其五 册宝入德寿宫门用《正安》。","author":"郊庙朝会歌辞","text":"惟天为大，其德曰诚。\n惟尧则之，其性曰仁。\n乃文乃武，得寿得名。\n于万斯年，以莫不增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其四 册宝出门用《正安》。","author":"郊庙朝会歌辞","text":"蚴蟉青龙，婉嬗象舆。\n其载伊何，煌煌金书。\n乃由端门，乃行康衢。\n于以荣亲，振古所无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其二 中书令、侍中奉册宝诣殿下用《正安》。","author":"郊庙朝会歌辞","text":"受命既长，福禄既康。\n如日之升，如月之常。\n追琢其章，金玉其相。\n君子万年，保其家邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其一 册宝降殿用《正安》。","author":"郊庙朝会歌辞","text":"高明者乾，博厚者坤。\n以清以宁，资始资生。\n寿胡可度，德胡可评。\n愿言从欲，诞受强名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十二年加上太上皇帝太上皇后尊号十一首 其十一 内侍举太上皇后册宝诣读册宝位用《圣安》。","author":"郊庙朝会歌辞","text":"有美英瑶，于昭祥金。\n为策为章，并著徽音。\n德圣而尊，备举弥文。\n亿载万年，永辅尧勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十二年加上太上皇帝太上皇后尊号十一首 其十 太上皇后出閤升御坐用《坤安》。降坐同。","author":"郊庙朝会歌辞","text":"天相慈皇，庆臻壶闱。\n徽柔内修，寿与天齐。\n既承皇欢，载觌母仪。\n懿典鸿名，永绥多祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738