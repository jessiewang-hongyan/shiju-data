d506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其九","author":"郊庙朝会歌辞","text":"帝庆三宫，膺受宝册。\n御于中闱，载欣载惕。\n乃孚阴教，乃明内则。\n翼翼鱼贯，罔不承式。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其八","author":"郊庙朝会歌辞","text":"帝有显命，禀于亲慈。\n后德克承，拜而受之。\n人伦既正，王化是基。\n亿载万年，永祚坤仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其七","author":"郊庙朝会歌辞","text":"袆褕盛服，有恪其容。\n是陟是降，相以尚宫。\n金殿玉阶，聿来于中。\n展诗应律，载咏肃雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其五","author":"郊庙朝会歌辞","text":"懿范柔容，如月斯辉。\n驾厥翟辂，被以袆衣。\n九御从之，如云祁祁。\n典册是承，心焉肃祗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其四","author":"郊庙朝会歌辞","text":"鼓钟喤喤，磬筦锵锵。\n剑佩充庭，济济洋洋。\n礼典告备，皇心乐康。\n于万斯年，受福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其三","author":"郊庙朝会歌辞","text":"有玺范金，有册镂琼。\n汝使汝介，持节以行。\n礼始文德，达于穆清。\n是恪是虔，依我和声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其二","author":"郊庙朝会歌辞","text":"乃协良辰，维春之宜。\n乃诏近弼，来汝相仪。\n九门洞开，文物华辉。\n声诗载歌，于以侑之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其一","author":"郊庙朝会歌辞","text":"乾位既正，坤斯顺承。\n日丽于天，月斯溯明。\n惟帝受命，惟帝并登。\n黼扆尊临，典册是行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其十三","author":"郊庙朝会歌辞","text":"天监有周，是生太任。\n亦有太姒，嗣其徽音。\n孰如两宫，慈爱相承。\n思齐之盛，复见于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其十二","author":"郊庙朝会歌辞","text":"窈窕淑女，备六服兮。\n陟降多仪，耸群目兮。\n内治允备，阴教肃兮。\n宜君宜王，绥有福兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其十一","author":"郊庙朝会歌辞","text":"硕人其颀，公侯之妻。\n翟茀以朝，象服是宜。\n如星之共，溯月之辉。\n母仪既瞻，群心则夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其十","author":"郊庙朝会歌辞","text":"葛覃节用，樛木逮下。\n形为嫔则，夙已心化。\n兹临长秋，遂正诸夏。\n以庆以祈，百祥来迓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其九","author":"郊庙朝会歌辞","text":"容典既膺，壶仪既正。\n羽卫外列，扬颜中映。\n如帝如天，以庄以靓。\n六宫承式，二南流咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其八","author":"郊庙朝会歌辞","text":"备物典册，乐之鼓钟。\n拜而受之，极其肃雍。\n司言司宝，各以职从。\n行地有庆，与天无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其七","author":"郊庙朝会歌辞","text":"规殿沉沉，叶气旼旼。\n明章妇顺，表正人伦。\n蹑是左墄，暨于中庭。\n尚宫显相，罔有弗钦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其六","author":"郊庙朝会歌辞","text":"德隆位尊，礼厚文缛。\n乃篆斯金，乃镂斯玉。\n群公盈门，执事有肃。\n愿言保之，永镇坤轴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其五","author":"郊庙朝会歌辞","text":"椒涂兰驭，河润山容。\n副笄在首，袆衣被躬。\n静女其姝，实翼实从。\n自彼西閤，聿来殿中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其四","author":"郊庙朝会歌辞","text":"册行何向，于门东偏。\n礼备乐成，合扇鸣鞭。\n皇举玉趾，如天之旋。\n燕及家邦，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其三","author":"郊庙朝会歌辞","text":"刻简以珉，铸宝以金。\n持节伊谁，时惟四邻。\n自我文德，达之穆清。\n委蛇委蛇，往迄于成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其二","author":"郊庙朝会歌辞","text":"卜月惟良，练辰斯臧。\n臣工在庭，剑佩玱玱。\n来汝疑丞，明命是将。\n有淑其仪，无或怠遑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳熙三年发皇后册宝十三首 其一","author":"郊庙朝会歌辞","text":"赫赫惟皇，如日之光。\n肃肃惟后，如月之常。\n礼行一时，明照无疆。\n天子莅止，畴敢不庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其八","author":"郊庙朝会歌辞","text":"赤符启祚，长发其祥。\n灵源自远，帝运重光。\n载洁笾豆，恭荐令芳。\n致成翼翼，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其一","author":"郊庙朝会歌辞","text":"于穆宋庙，肇允基扃。\n文母来献，国祚咸宁。\n永言昭格，式荐惟馨。\n亦既降止，聿柄神灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其七","author":"郊庙朝会歌辞","text":"奕奕清庙，巍巍帝基。\n诒谋积德，累洽熏熙。\n粢盛丰洁，礼容肃祗。\n俯歆明荐，永锡蕃禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其十一","author":"郊庙朝会歌辞","text":"巍巍新庙，穆穆真皇。\n德符二圣，仁洽万方。\n坠典咸秩，鸿仪用彰。\n威灵如在，时思不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其四","author":"郊庙朝会歌辞","text":"洁尔牺牲，既角且骍。\n玉俎奉将，式表纯精。\n祖宗斯享，毖祀以成。\n福禄来降，邦祚隆平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其十","author":"郊庙朝会歌辞","text":"赫赫皇祖，万邦之君。\n功崇偃革，德盛兴文。\n圣谟宏达，至教氤氲。\n子孙百世，祗荐苾芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]