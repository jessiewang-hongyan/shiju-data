[{"title":"和杨龙图芦雁屏","author":"蔡襄","text":"何事高堂秋思生，野芦寒雁画工精。\n风前挺立孤根老，云外相从去意轻。\n不似丹青能借色，若逢霜月定闻声。\n研桑心术都无取，回望江乡计未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨龙图獐猿屏","author":"蔡襄","text":"画莫难于工写生，獐猿移得上幽屏。\n相逢平野初惊顾，共向薰风适性灵。\n引子昼游新草绿，啸群时望故山青。\n可怜官省沈迷处，每到中轩顿觉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运使学士芍药篇","author":"蔡襄","text":"密叶阴沈夏景新，朱栏红药自为春。\n香于兰芷偏饶艳，画入缣绡未逼真。\n已恨芳华难驻景，可堪愁卧动经旬。\n三年想爱须留恋，不为江头酒味醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邱提刑闻新雁寄贾度支","author":"蔡襄","text":"翔雁来江渚，秋容在远空。\n几声疏树外，一字断云中。\n虚馆垂帘月，平皋败叶风。\n裁诗托幽思，幽思更无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邱提刑寄湖南贾度支","author":"蔡襄","text":"何处多离感，山邮霁野光。\n清吟贯骚雅，远意属荆湘。\n霜树呈秋色，风兰生晚香。\n使轺偏倚望，摛藻寄回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈殿丞南州新咏","author":"蔡襄","text":"宝坊高阁遍凭栏，曾是芳辰得未閒。\n日上天容低接海，风轻湖底倒摇山。\n夜深佛火寒星外，春过人烟暗树间。\n无意孤吟采幽致，异时行橐断空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和诗送茶寄孙之翰","author":"蔡襄","text":"北苑灵芽天下精，要须寒过入春生。\n故人偏爱云腴白，佳句遥传玉律清。\n衰病万缘皆绝虑，甘香一味未忘情。\n封题原是山家宝，尽日虚堂试品程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和钱端明游南屏山","author":"蔡襄","text":"新秋初变一天清，急雨仍添万木声。\n山势不根空外起，湖光无际槩来平。\n锦衣应有徘徊恋，金地聊开燕乐情。\n衰暮典城何所用，愿公云路羽翰生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和偶登安济亭","author":"蔡襄","text":"津亭遥望草萋萋，空旷清怀与物齐。\n春水倒行潮欲上，晚云平压日先低。\n高城览古人何在，远渡伤离客自迷。\n好共山翁同出处，不随朝骑五门西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曹殿丞寄荔支","author":"蔡襄","text":"荔子凝丹摘晓鲜，江南来路与云连。\n托根曾是三山下，结实应归万木先。\n乡国远携甘旨重，宴堂分玩色香全。\n清才仍更传新唱，一一骊珠照眼圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和登安济亭","author":"蔡襄","text":"亭上风吹藤帽檐，为怜清胜得安恬。\n惊涛触岸层澜碎，落日衔山半景尖。\n遥认犀奔知鹿角，忽逢龙挂见胡髯。\n城南一去通沧海，无限春寒向晚添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答孙推官","author":"蔡襄","text":"拟将身计入扁舟，纵得三公不黑头。\n病体已轻休赋鵩，机心如动辄惊鸥。\n强看吴野江山醉，肯为春风花草愁。\n所向乾坤皆客寓，可能与我更迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答孙推官久病新起见过钱塘之什二首 其二","author":"蔡襄","text":"病来安健赋诗誇，甲子新移一岁加。\n吾道所存唯浩气，世缘何著但空花。\n烟云已过同归雁，杨柳初藏并宿鸦。\n便拟寻山逐幽趣，春泥随马不须遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答孙推官久病新起见过钱塘之什二首 其一","author":"蔡襄","text":"于世无机是海翁，客情醒醉任邻钟。\n廉纤雨意还侵夜，料峭春期未减冬。\n宝气上浮难掩玉，岁寒中立不凋松。\n君王自结英雄网，千载风云定有从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和新燕","author":"蔡襄","text":"燕燕何来处处喧，新从海上振轻翰。\n卑飞不避春泥重，并语应愁夜雨寒。\n客舍暗窥吟笔健，宴堂时见酒杯乾。\n雕梁信美多移主，愿尔将雏择便安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨病中","author":"蔡襄","text":"久雨曾无度，阳和渐向阑。\n杂香生众木，浓翠入孤峦。\n漏缓宵仍静，灯微晓更寒。\n芳时犹卧病，何日出城看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答孙推官南屏旧游","author":"蔡襄","text":"已怜丛翠在湖边，最胜浓岚返照前。\n未省天工能刻饰，祇应山骨自清坚。\n岩端下溜添春涧，穴底来风送野烟。\n欲仗何人安屐齿，更寻幽径一攀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬王知县赏春不与以诗见赠","author":"蔡襄","text":"仙陬翠观尽繁英，朱白相兼照眼明。\n池浸岚光生晚碧，鸟惊人语断春声。\n谈谐遽喜开怀久，骪骳终惭走笔成。\n佳致可能陶靖节，庭柯斜眄独忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝月法喜堂","author":"蔡襄","text":"少悟浮图法，因传法喜名。\n于人无厚薄，知己尽豪英。\n药舍朝炉暖，棋窗夜烛明。\n性怀元自得，未用厌逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子上元即事","author":"蔡襄","text":"老去年华只自惊，又逢佳节向山城。\n春临半夜寒犹重，月到中天色更清。\n上客风流连宿醉，游人歌调得新声。\n遥思凤阙行时令，红伞朱栏万烛明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杪秋湖上","author":"蔡襄","text":"旧暑侵凉已分销，萧疏丹树见斜桥。\n千千露竹全潇洒，一一风蝉共寂寥。\n菰米熟汀来客燕，芡丝分水避归桡。\n月魂未上东城角，谁向东城与下招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州访吉祥璘上人追感苏才翁同赏牡丹","author":"蔡襄","text":"曾乘春饮绕花畦，花底馀香入燕泥。\n剪处佳人传烛下，归时明月到云西。\n重来草树惊秋色，零落交朋感旧题。\n若使他年逢胜赏，一觞知复共谁携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州璘上人以花栽数种见寄","author":"蔡襄","text":"名品参差十数窠，商船千里任风波。\n土花分破根株小，春色随来意气多。\n欲种更看移树法，将开须与傍栏歌。\n中年渐不胜杯酌，红翠他时奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经钱塘故宫","author":"蔡襄","text":"废苑芜城裹故宫，行人苑外问秋风。\n当时歌舞何年尽，此意古今无处穷。\n往事萧条随败叶，客情迢递寄孤鸿。\n扁舟欲去更回首，寒树苍苍夕照东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨晴早出","author":"蔡襄","text":"徂秋久不雨，沾濡才此旬。\n新阳净万物，太虚无一尘。\n老稚出旷野，锄犁及清晨。\n爱尔安居乐，力作勿辞贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西金明池小饮二首 其二","author":"蔡襄","text":"城西禁籞宿烟收，霜薄朝寒上罽裘。\n佳树得春生意动，平池受日翠光浮。\n十年歌笑惊前世，满眼风花是旧游。\n从此曲江芳物好，定知重到更疑留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西射弓挺之以病不至简示新诗有唯应欠我渭城歌之句谨吟一篇以答佳意","author":"蔡襄","text":"雪后西郊物外清，官閒乘兴此閒行。\n出门疏树无尘色，入内流渠带野声。\n近腊酒醪香更酽，得风弓箭力还生。\n知君病起心犹壮，独背船窗唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客有至自京师言诸公春间多会于元伯园池因念昔游辄形篇咏","author":"蔡襄","text":"绿渠春水走潺湲，画阁嵩峦映碧鲜。\n酒令已行金盏侧，乐声初急翠裙圆。\n清游胜事传京下，多丽新词到海边。\n曾是樽前沈醉客，天涯回望重依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭松安静堂","author":"蔡襄","text":"偏爱堂东砌下松，三年潇洒伴衰翁。\n寒声动荡潮初上，疏影孤圆月正中。\n清彻纱帷延昼梦，绿涵金盏带春风。\n自缘多病饶归思，便觉山林野意通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼寝宴坐轩忆与苏才翁会别","author":"蔡襄","text":"投凉下马卧僧家，绕簟清风卷绛纱。\n修竹满前微雨过，远山无际薄云遮。\n武侯旧隐人应到，闽粤孤城日自斜。\n解与尘心消百事，更开新焙煮灵芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪泽阻风","author":"蔡襄","text":"今日风期恶，迟回一水滨。\n村旗呈酒圣，庙鼓赛河神。\n跃鲤曾惊网，饥乌不避人。\n商工时借问，何处即通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜书廨中壁","author":"蔡襄","text":"遥夜不能寝，值兹节物清。\n大空瑩虚碧，仰观澄性情。\n素月若可把，浮云何故生。\n瑶琴且勿弄，谁怜希代声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子真给事出守常山","author":"蔡襄","text":"安得长材护北州，暂烦儒将拥轻裘。\n声名不啻一敌国，功业何须万里侯。\n设馆高牙延永昼，猎场飞骑入清秋。\n天枢严近恩荣重，归梦应思帝所游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仲庶待制知泽州","author":"蔡襄","text":"十年台省献嘉谋，新总兵符镇上游。\n琴有薰弦多舜俗，地连沙尾旧湘州。\n江边行色船千丈，塞外威声马万头。\n宣室夜谈思贾谊，未应乡国久迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别陈比部","author":"蔡襄","text":"祖帐西郊道，川原画阁临。\n烧痕经雨活，树色入溪深。\n斜日明春态，孤云感客心。\n何人知别意，重把酒杯斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨殿丞通判睦州","author":"蔡襄","text":"苍崖中断一溪来，迤逦人家向水开。\n尽日烟云迎旆去，满泷铙吹引船回。\n虚斋昼梦鸣禽下，别坞春游画角催。\n莫怪杜郎题处少，更留佳致待清才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程刑部出守洪州","author":"蔡襄","text":"何事名郎出计台，钟陵都会久须才。\n江山不是人间有，旗鼓初从日下来。\n列郡五符归总制，故乡三组少徘徊。\n勿嗟南国多怀感，宝气还应彻斗魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳日有美堂南望","author":"蔡襄","text":"越邑吴封绣错分，华堂繁吹半空闻。\n山峰高下抽青笋，江水东西卧白云。\n菊蕊芬芳初应节，松林照耀欲迎曛。\n州人不见归时醉，未拟风流待使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭贾少卿","author":"蔡襄","text":"画旟南度谪长沙，粤海新恩路更赊。\n子日鵩来知主去，辰年龙会为贤嗟。\n犹多婚嫁先捐馆，无复田园可寄家。\n曾是德公推奖厚，一觞何处酹魂车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐彦猷挽词 其二","author":"蔡襄","text":"旧德推当代，新悲入故乡。\n直当冠獬豸，清可濯沧浪。\n美研精煤色，文瓯昼茗香。\n生平无复见，流涕送幽堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐彦猷挽词 其一","author":"蔡襄","text":"鲠亮驰名久，孤高进路难。\n富文平日业，劝学晚年官。\n隧外春江静，林边晓露漙。\n唯应坟上土，犹解是芝兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏晚南墅","author":"蔡襄","text":"夏竹侍前楹，凉襟析旧酲。\n叠云封日茜，斜雨著虹明。\n鱼动池开晕，蝉移树减清。\n葭洲烟向暝，凫鹜自相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃杏园 其二","author":"蔡襄","text":"送客来仙馆，清幽处处寻。\n春风行酒面，昼日到花心。\n独厌归期促，难忘野意深。\n归鞍更回顾，桧柏自阴森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中偶书二首 其二","author":"蔡襄","text":"行年三十六，几是半生人。\n举止不入俗，清修难厌贫。\n宴坐炉烟暖，微醺瓮酎醇。\n前看箫管辈，未免作埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中偶书二首 其一","author":"蔡襄","text":"已感节候变，物态舒阳春。\n那复壮年意，如今多病身。\n净室焚香久，烘炉煮药频。\n神欢百虑解，销尽眼前尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耕园驿","author":"蔡襄","text":"使轺迢递到天涯，候馆迁延感岁华。\n白发却攀临砌树，青条犹放过墙花。\n悲来唯见金城柳，醉后曾乘海客槎。\n欲问昔游无处所，晚烟生水日沈沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耕园驿佛桑花","author":"蔡襄","text":"溪馆初寒似早春，寒花相倚醉于人。\n可怜万木彫零尽，独见繁枝烂熳新。\n清艳夜沾云表露，幽香时过辙中尘。\n名园不肯争颜色，的的夭红野水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春登南门","author":"蔡襄","text":"丽谯高倚晚天霞，满目平皋尽物华。\n千曲胡笳催鼓答，三重湘酎倩旗誇。\n连江急雨送归燕，拂地轻风移落花。\n强倚栏干还自问，此情何处是边涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读离骚经","author":"蔡襄","text":"莫怪灵均恋楚滨，可能臣子外君亲。\n精心独去珠无颣，飞语潜来箭有神。\n宋玉招魂推意远，扬雄流涕掩书频。\n江边自是修门路，嗟苦先生陨此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿延平津","author":"蔡襄","text":"鸣籁萧森万木声，浓岚环合乱峰青。\n楼台矗处双溪会，雷电交时一剑灵。\n晓市人烟披霁旭，夜潭渔火斗寒星。\n画屏曾指孤舟看，今日孤舟在画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄来安孙推官","author":"蔡襄","text":"我爱孙公子，安贫无所营。\n相逢虽邂逅，一见即平生。\n黑电挥诗笔，黄河泻酒觥。\n轻舟何处在，别思若摇旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄答汝州王仲仪待制","author":"蔡襄","text":"汝水闽山道路长，行邮时复寄新章。\n谏垣笑别三年近，病枕魂飞万里强。\n烈火未应焚玉石，埋轮曾是问豺狼。\n主恩未报头生白，羞见龙泉百鍊钢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题张景山大卿园池","author":"蔡襄","text":"人仰公才世吏师，更甘归老旧林池。\n门阑清似当官处，心力强于少壮时。\n物理自冥非寄酒，兵谋犹在却因棋。\n濠边风月如招隐，愿拂尘裾从所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚上碧峰亭","author":"蔡襄","text":"城头近晚忽开晴，有色皆鲜是物清。\n地势四来州午向，山围一罅水东行。\n乘风歌吹无时已，面日楼台触处明。\n不比儿曹誇衣锦，自缘恩与养亲荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清暑堂会同年","author":"蔡襄","text":"当年绿发上天衢，三纪于今雪满须。\n荣路风波多契阔，画堂歌吹暂欢娱。\n杯中明月时摇动，草际飞萤乍有无。\n莫问更筹须剧醉，四翁同籍亦难俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜弟及第","author":"蔡襄","text":"里闬高高祖德新，鲁庭诗礼孟家邻。\n连登桂籍青袍客，共拜萱堂白首亲。\n倚国精诚明火玉，照人清节对霜筠。\n童襟开慧盈书馆，渐喜芝兰在处春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜欧阳永叔余安道王仲仪除谏官","author":"蔡襄","text":"御笔新除三谏官，士民千口尽相欢。\n昔时流落丹心在，自古忠贤得路难。\n好竭谋猷居帝右，直须风采动朝端。\n人生万事皆尘土，惟是功名永远看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食西湖","author":"蔡襄","text":"山前雨气晓才收，水际风光翠欲流。\n尽日旌旗停曲岸，满潭钲鼓竞飞舟。\n浮来烟岛疑相就，引去山禽好自由。\n归骑不令歌吹歇，万枝灯烛度花楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓居兴化转运廨舍","author":"蔡襄","text":"病恼连春夏，居閒意味长。\n海风生永昼，山雨送微凉。\n书帙梅蒸润，衣巾荔实香。\n尘缘消遣尽，物我两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温成皇后挽词二首 其二","author":"蔡襄","text":"翟綵开新礼，金文易大名。\n真游上仙路，故物感皇情。\n月落辞丹禁，春前引素旌。\n宫闱鸣挽铎，不是佩环声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温成皇后挽词二首 其一","author":"蔡襄","text":"紫极腾轩曜，青春委蕣颜。\n云軿何处去，金殿几时还。\n仗下编箫咽，陵中夜烛閒。\n六宫哀送返，疑是梦魂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵峰院龙龛山","author":"蔡襄","text":"天柱支南极，蓬山压巨鳌。\n云崩石道险，潮落海门高。\n客馆闻鼍鼓，秋风忆蟹螯。\n凭栏望乡树，千里楚江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金山寺","author":"蔡襄","text":"平日压尘土，今游兴味长。\n波涛围四际，台殿起中央。\n鱼听晨餐鼓，云和夕炷香。\n薰风休递吹，襟袂不胜凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游烟霞洞","author":"蔡襄","text":"新晴特地入烟霞，道并南山转更赊。\n幽磬过邻溪口寺，众鸡鸣午野人家。\n洞深随溜先如雨，石古笼藤乱放花。\n潘岳小园犹作赋，轻轩选胜乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答孙推官","author":"蔡襄","text":"不是穷轮始问途，肯将全璧混泥污。\n尚平婚嫁何时毕，陶令田园先自芜。\n羁旅且甘家四壁，牢愁须借酒千垆。\n唯应抒素推文富，落笔词章气象粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]