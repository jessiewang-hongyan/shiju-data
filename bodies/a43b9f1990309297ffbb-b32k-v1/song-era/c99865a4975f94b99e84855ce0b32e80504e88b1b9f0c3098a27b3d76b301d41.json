[{"title":"次韵前人贵籴","author":"陈著","text":"麦甑凄凉稻尚青，粒珠乘急价掀腾。\n市平本易无千斛，仓籴良艰且五升。\n长是信天还自活，未能送鬼任多憎。\n回头钟鼓群峰寺，饱饭高眠独有僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人重阳","author":"陈著","text":"说道贫閒亦自忙，谁知硕果自存阳。\n堪怜冻病如无己，不复狂游似季常。\n过眼世情多逐臭，闭门家话自生香。\n重阳已在西风里，空有龙山入梦乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人雪中","author":"陈著","text":"晚风吹下六花祥，喜到眉閒色浅黄。\n旋积层寒消夙瘴，平施一白洗时妆。\n要寻闭户家形迹，肯为乘骓客断肠。\n岁事已占禾麦好，与民相庆著诗忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人寒食","author":"陈著","text":"今年寒食倍心寒，不独松楸感涕潸。\n青草遥悲新瘗冢，苍梧错认旧来山。\n人生醉梦乾坤里，时节晦冥风雨閒。\n只有杜鹃知此意，傍云啼去又啼还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人道中","author":"陈著","text":"开遍梅花柳渐丝，甘棠次第又添诗。\n马头村路皆官况，面上春风是己知。\n山笔重时谙事体，蒲鞭轻处惜民饥。\n老夫尚解随人后，舞劝碑潭水一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人醵更生会三首 其三","author":"陈著","text":"世变如轮到厄年，危魂飞绕万山巅。\n冥心前路追陶令，回首中原属汉渊。\n树鹊频惊枝上月，醯鸡苟活瓮中天。\n悠悠未是归时节，风雨何□复对眠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人醵更生会三首 其二","author":"陈著","text":"劫火吹炎海水飞，九州同惴釜鱼危。\n有时杜老泪盈把，终日颜回面忍饥。\n今古滔滔无限事，乾坤纳纳竟何知。\n便教强趁黄花约，终恐趑趄罚后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵前人醵更生会三首 其一","author":"陈著","text":"满天地里暗尘飞，老息奄奄一发危。\n种秫为生姑托醉，采薇忍死未忘饥。\n三閒书屋鬼神护，百两芒鞋风雨知。\n咄咄书空如梦寐，龙山谁记有佳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洛阳秦庆父贽见","author":"陈著","text":"洛中人物好，磊磊实过名。\n和气春浮动，新诗玉琢成。\n相逢交义重，一笑世情轻。\n问到牡丹外，凄然百感生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洞真道士卢致远","author":"陈著","text":"虹桥关福地，门外任风涛。\n襟带金钟秀，根基铁柱牢。\n安心培大枣，办手摘蟠桃。\n坐镇江山稳，新题立石高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡景参制机见寿二首 其二","author":"陈著","text":"南风吹笠走长须，一轴新诗一幅书。\n虎榜陈人有韩愈，鹤山佳婿得肩吾。\n行年八十死将似，求活须臾计已疏。\n惭愧珍羞□初度，忽忘门户是穷儒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡景参制机见寿二首 其一","author":"陈著","text":"倚囊仙叟付良姻，一实交孚略具文。\n共喜树高堪托蔓，自怜莸臭不投薰。\n移厨幸免劳都督，问字何妨□子云。\n月峡霞峰总奇绝，閒中相望足为群。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡甥幼文留别","author":"陈著","text":"婿车俄见过，喜气动庭莎。\n别久一来重，病馀相问多。\n亲情忘淡薄，归兴及清和。\n山路须回首，长松有翠萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵孟益游西山寺","author":"陈著","text":"佛何为者占崔嵬，引得骚朋蹈险来。\n洗钵有泉披草见，入门无径凿岩开。\n避人幽鸟毛生样，守屋残僧面死灰。\n自是世閒心绝处，灵山无分莫徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵寄庵","author":"陈著","text":"家住黄沙绿水湾，功名土苴任天悭。\n顾瞻宇宙惊多碍，收卷江湖憩一閒。\n处子声容心自铁，太公年几鬓才斑。\n老来难得重相见，明月清风处处山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵菊泉","author":"陈著","text":"世衰人物眇，犹见得閒平。\n劫火诗书脉，春风杖履盟。\n霏霏木屑话，淡淡菜羹情。\n相对青镫下，平生心事明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵景文见寄","author":"陈著","text":"十载扃门白发翁，一丝飞毒忽缠胸。\n浮云随詟惊雷散，跃铁终逃劫火镕。\n尚有先庐供手实，幸叨儒籍免身佣。\n关津本不征风月，来往何妨信一筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵景文见寄怀亲","author":"陈著","text":"薄俗滔滔逐水流，谁能古道两绸缪。\n白云终日静相向，紫气有时来更留。\n啼鸟已呼春到了，醉驴曾记旧游不。\n山林乐事输君早，未遇仙炊已转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵剡张知录见寄","author":"陈著","text":"危途盍把隐为师，名姓翻嫌世或知。\n栗里已成终老计，桐乡犹记旧游时。\n云山杳杳勤搜便，风雨潇潇独寄诗。\n目送心期无别语，厚培根本做春枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵剡僧孜书记","author":"陈著","text":"县如残寺裹荒城，僧干穷缘耐苦声。\n虽把慈悲供日用，可能方便徇人情。\n四明山背看云近，九里湾头呷水清。\n支遁后身偏念我，惠来诗好愧兼荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐何慊九日登高","author":"陈著","text":"广莫亭前秋气清，招邀酒伴走庖兵。\n悠然谁解知真意，乐只应须在太平。\n直到上峰饶独步，尽收下界入双明。\n满头芬馥随归马，惟有黄花不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐何慊咏雪","author":"陈著","text":"冯夷剪水暗中央，映带同云浅与黄。\n旋积层寒消宿瘴，平铺一白洗时妆。\n行仙休羡王恭兴，僵叟应关洛令肠。\n不觉喜吟丰岁瑞，方知知是为民忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐直翁仙霞岭近衢州","author":"陈著","text":"道大谁能用，功名一念微。\n释然文石梦，轻似岫云归。\n霞岭空重历，天书的又飞。\n翻身凤池去，分阃却成非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐鳞卿","author":"陈著","text":"百罹身世不成家，赢得萧萧两鬓华。\n梦想山行三载里，绸缪亲谊百年赊。\n苍颜一见如枯柏，佳语相延总粲花。\n别后有诗须狎寄，莫嫌踏险路谽谺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵留友直道士来访","author":"陈著","text":"九六荡摩中，几人閒处同。\n浮生丝傀儡，后计石婆翁。\n事事休休过，时时咄咄空。\n何如仙羽健，来往傲方蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翁古晚见寄就送其之京","author":"陈著","text":"万里风云路向前，功名盍趁仕强年。\n文如李杜谁争燄，心是夷齐不问泉。\n别驾有功歌沸海，筑台在望勇趋燕。\n自惭筋力难追送，侧耳凌清上集贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翁古晚府判见赠二首 其二","author":"陈著","text":"振讯䙰褷病鹤形，箳篂影下话平生。\n受原宪业惟环堵，溯德公心不入城。\n日把寸量著蝶梦，云拖一出被猿惊。\n自惭迂学经题品，输与两生无姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翁古晚府判见赠二首 其一","author":"陈著","text":"清风明月满蓬瀛，谁识监州閒世生。\n道义浓香薰政谱，文章馀力到诗城。\n傃儒不买三姝媚，好客能容一座惊。\n见说锋车春在路，北门西掖是功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵崇福老泽南洲","author":"陈著","text":"邯郸枕上梦回身，景照窗前醉卧人。\n山别是天迟放晚，鸟知何世早呼春。\n乾坤大事三缄外，湖海清交一笑新。\n山去莫嫌来往密，免教云树两驰神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟","author":"陈著","text":"挂画烧香书满前，丰标清出剡溪源。\n平坡肘腋眠牛垄，小屋规模放鹤园。\n外事任如黄叶寂，閒心暗与白云论。\n应须参到希夷处，自是三峰直下孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟见怀","author":"陈著","text":"自笑缘何事，老来还客中。\n唱花悲杜牧，隐杵愧梁鸿。\n颇忆良眉白，相欢醉面红。\n如今各成别，方信坐天穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟咏梅","author":"陈著","text":"冬塞方严春自通，老根芳脉与天融。\n清于仙李月梁上，瘦似神苏雪窖中。\n庾岭依然开信早，孤山无复课诗工。\n一枝在手驿风远，渺渺予怀谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟感时","author":"陈著","text":"翳日腥云澒洞尘，是虽天做亦由人。\n难禁老泪如囚楚，忍托空言写过秦。\n风雪正培阳气脉，山林幸有岁寒身。\n功名已付无何有，要及馀光耕富春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟感时四首 其四","author":"陈著","text":"边将才无日越晖，中朝人是李斯非。\n顺流兵马竟掀舞，死战规模谁发挥。\n忍看金茎移露去，空歌玉树送春归。\n不图世变今如此，真与尘埃蠓蚋飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟感时四首 其三","author":"陈著","text":"春造曾分寸草晖，晚经霜雪始知非。\n中心痛事神孤往，前面虚名手一挥。\n肯使晓猿随陇笑，不烦倦鸟引云归。\n绝粮只管餐松菊，赢得身轻入险飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟感时四首 其二","author":"陈著","text":"世事滔滔趁夕晖，仰天咄咄付非非。\n乾坤谁解中撑拄，江海方听北指挥。\n风舞南人新万户，灰飏西岭旧三归。\n只应天竺孤峰在，一自飞来不更飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟感时四首 其一","author":"陈著","text":"吟情本是谢玄晖，邂逅年来世事非。\n到处望风千甲解，无人留日一戈挥。\n杜鹃入洛啼拌死，鸿雁辞南去有归。\n浩荡春光天万里，孤云叶叶向谁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟感春","author":"陈著","text":"老来危迹感秋蓬，万事都归马耳风。\n百五节为春好处，两三年在乱离中。\n溅花难禁少陵泪，缚柳休辞韩子穷。\n最是残镫风雨夜，杜鹃声里梦西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅山弟静中大观","author":"陈著","text":"默默融融内自观，纷纷藉藉外何关。\n托言鹏化未为大，相与鸢飞方是閒。\n万古乾坤全易上，四时风月小诗閒。\n天寒一步不轻动，祇为梅花费往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵虚谷和长儿奉别","author":"陈著","text":"有便勤相问，何时得近依。\n诗搜肠藿瘦，字为眼花肥。\n云远心犹远，春归人未归。\n羡君牢闭户，珍重白山衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵雪窦主同少野见寄","author":"陈著","text":"谁肯寄衰翁，当年应梦熊。\n知心廑惠远，载酒寿扬雄。\n古道今犹在，清交老更丰。\n和诗不尽意，极目万山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄子羽七十自叹","author":"陈著","text":"弃瓢巢父固云稀，解印陶潜未是非。\n风雨似知人世换，溪山自爱主翁归。\n时消孤闷有茶屋，天把独醒存芰衣。\n我亦岁寒松下草，相望百里借春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄长孺","author":"陈著","text":"山谷忽精神，一番桃李新。\n杯盘留话处，镫火苟安人。\n老去刻为岁，醉来寒亦春。\n催归莫閒管，此处岂天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄长孺","author":"陈著","text":"人情相得古来难，肯溯溪山伴退閒。\n潇洒风流屏褥外，和平气象瑟琴閒。\n鹊巢自爱居南国，鹤帐从教怨北山。\n只恐杜鹃声梦里，与君飞去又飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄长孺","author":"陈著","text":"玉润深惭冰未清，午轩杯酒见人情。\n艰难方识山林味，亲戚还兼朋友盟。\n安用白头伤世变，又看黄叶报秋成。\n羡君燕奉潘舆处，淡泊中閒礼乐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄长孺别陈子得","author":"陈著","text":"两閒何纳纳，长夜正漫漫。\n感旧心犹热，逢春眼自寒。\n人情伐木宋，世变幻花韩。\n寂寞衡茅下，从他作拙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄虚谷","author":"陈著","text":"弓招消息下幽京，群起张弮不受檠。\n衰朽分为林下物，英雄谁取彀中名。\n坐看年少抟双翼，争把时铦驱五兵。\n万事要终方有见，休凭水到说渠成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游南山寺","author":"陈著","text":"紫盖矗天开，更无山并来。\n脚飞云外去，眼到海东回。\n长啸落林叶，新题淋壁苔。\n兹游亦奇绝，休惜醉徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程仲实佥事纪行","author":"陈著","text":"道脉来从洛二程，天教驰辔福东瀛。\n笔头有海清尘浊，胸次如春放雪晴。\n喜拍蓬壶鳌亦抃，攀遮梅驿马难行。\n恨无老翼飞随去，岁晚江空潮自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵童尚质书怀三首 其三","author":"陈著","text":"夜寂气如洗，心閒理自明。\n凝香清梦寐，读易悟生平。\n月树乌惊晓，云阶鹤报更。\n闭门佳致意，名利一毛轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵童尚质书怀三首 其二","author":"陈著","text":"地偏人迹悄，月到小窗明。\n鼓瑟希曾点，观书慨屈平。\n物情閒里见，世事梦中更。\n不著黄粱枕，虚名已自轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵童尚质书怀三首 其一","author":"陈著","text":"夜室清如许，檠镫便且明。\n哦诗须已断，看剑气难平。\n露户浸孤月，江城知几更。\n枕书俄作梦，梦觉骨毛轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董三馀约赏月丹瑞香","author":"陈著","text":"老仙平日鍊心丹，荏苒光阴百岁閒。\n随分种花供冷眼，逢人留酒有温颜。\n乾坤只作醒中梦，风月何妨忙处閒。\n有约酬春争起舞，要看北道破先悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董伯和二首 其二","author":"陈著","text":"时难何必苦嗟吁，自有山庄只自如。\n行担应携杏花谱，闭门堪著竹林书。\n行观尘外乘风鹤，坐看人閒减水鱼。\n宇宙平安终有日，却从旧卜大门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董伯和二首 其一","author":"陈著","text":"事难言处只长吁，沸海烹煎一鼎如。\n贫累转添知有命，故交自绝本无书。\n仕方见境大槐蚁，走不离乡千里鱼。\n已分归农谋半菽，尚忧龙岁起秦闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董伯和镫夕有感二首 其二","author":"陈著","text":"数枝镫火古祠门，妆点山中一鬨春。\n俚语为求蚕麦福，队游多是布荆人。\n强随戏鼓看狂舞，忍听嘶鼙入小颦。\n见说九街罗绮地，传呼禁夜令方新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董伯和镫夕有感二首 其一","author":"陈著","text":"万镫无复艳端门，一簇星毬里域春。\n羌调悲酸吹笛社，村声祥瑞卖饧人。\n鬼神亦要民心乐，山谷聊舒世态颦。\n最好今宵天上月，安知时事有陈新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵董声可重五","author":"陈著","text":"人事俄随世事殊，尚存榴艾伴嘻吁。\n怀沙到处哀新鬼，瑞市何时见醉夫。\n荣赐休思当暑葛，早衰空感望秋蒲。\n辟兵禁恶□儿戏，无计能逃急急符。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赋南山广莫轩","author":"陈著","text":"洗眼来看广莫诗，烟霏空翠雨微微。\n四平地上一山起，独拄天南群望归。\n乔木不随兵燄动，好云时入寺门飞。\n乾坤浩荡难言处，猛拍阑干阁口机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龄叟","author":"陈著","text":"儒酸自是分当穷，老退非干势不容。\n并日莫留馋半菽，馀生休说寿三松。\n眼中落落同人少，脚底兢兢坎险重。\n惟有灵山老吟友，暗中心事两云龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龄叟见寄","author":"陈著","text":"方外好交情，诗筒出醉屏。\n清能濯骄暑，光欲掩常星。\n自愧薄榆景，有生真草亭。\n多年祇多感，岌岌旧门庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龄叟招石秀叔","author":"陈著","text":"久知难久别，飞约到柴门。\n唤起雨窗困，踏开岚径昏。\n世情忙外看，交道淡中存。\n何日巳公屋，新诗得共论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵僧仁泽 其一","author":"陈著","text":"来诗自有师，心与晚唐期。\n开我正墙面，喜于闻乐脾。\n山林人似许，风月事还谁。\n不用盟为社，从今是故知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵僧仁泽 其二","author":"陈著","text":"洒洒忘家客，相逢若有期。\n茶腴参道味，诗瘦出饥脾。\n避俗无新计，谈空更阿谁。\n吾言太浪荡，休遣世人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵樊伯撝见贶","author":"陈著","text":"自笑我何如，叨年八十馀。\n户门觉老病，梅竹护穷居。\n拙计信天鸟，残生减水鱼。\n时将一字命，仰卧向空书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":21332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]