[{"title":"书事十绝 其二","author":"曾惇","text":"和戎诏下破群疑，无复旄头彗紫微。\n屈己销兵宜有报，先看长乐版舆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事十绝 其七","author":"曾惇","text":"江头柳木已参天，柳色花光日日妍。\n惊怪田家频得醉，今年斗米不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东湖","author":"曾惇","text":"三年领客醉东湖，欲去犹携竹里厨。\n谁解挽留狂太守，风荷十顷翠相扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题桐柏石道士院妙声堂","author":"曾惇","text":"门外千峰翠作堆，道人名籍在丹台。\n是非荣辱俱休问，只放泉声入耳来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹丘诸先辈被荐书赴试南宫郡守曾惇既大合乐祖其行复成小诗歌以送之","author":"曾惇","text":"夜窗几岁聚寒萤，一日秋闱较艺精。\n不但春秋明古义，雅知月旦著乡评。\n毫端剩埽三千牍，云路方期九万程。\n三郡看魁天下士，丹丘应未坠家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖怀洪景伯","author":"曾惇","text":"东湖径昃半苍苔，问讯红蕖几许开。\n渺渺波光侵坐席，霏霏荷气著尊罍。\n片云正为诗情起，好雨更将凉意来。\n别乘朝来知健否，颇思剧饮拗莲台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙溪新亭","author":"曾惇","text":"怀玉知名寺，诸峰翠插天。\n凌云飞略彴，照水舞蜿蜒。\n午日孤穿履，新凉定著鞭。\n更须烦惠远，小立虎溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵 其二","author":"曾惇","text":"危观干霄百尺开，海山罗列似东莱。\n鸟飞千里暮天碧，云断半弦新月来。\n报答风光伤晼晚，扶持欢事小徘徊。\n一春准拟留君醉，翡翠罗衫窄窄裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵 其一","author":"曾惇","text":"举觞东望玉霄峰，万顷云涛雪塞空。\n拥鼻自应多好句，褰裳便欲御长风。\n际天江草如许碧，隔水山桃无限红。\n李侯长句有家法，惊倒江楼一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后园观梅简洪景伯","author":"曾惇","text":"扶藜点检后园梅，小雨沾滋第一回。\n宾客正愁花有语，拾遗只恐老相催。\n关心故国赏心处，爱酒暮年疏酒杯。\n待得山宫千树白，与君骑马入青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪景伯韵 其一","author":"曾惇","text":"午夜崩腾玉马飞，春前腊后未为迟。\n正怜灞上诗无继，似与山阴客有期。\n摇荡江花迷远渚，埋藏海峤失多歧。\n谁能作句催端水，清绝台州别驾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李举之玉霄亭 其一","author":"曾惇","text":"新亭崛起最高峰，无数遥岑翠埽空。\n恐有谢公留屐齿，为开摩诘画屏风。\n倚江杨柳自高下，照水杏花能白红。\n正欠渭川千亩竹，清阴分借赖邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李举之玉霄亭 其二","author":"曾惇","text":"亭据城央一径开，仍标兰芷出蒿莱。\n诸峰合沓云边出，大舶岢峨海上来。\n已办酒池供倒载，可无舞袖看低回。\n风烟正赖君弹压，时遣诗锋为剸裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵景伯宠示劝农新什","author":"曾惇","text":"奉诏东郊宣主恩，如云和气蔼生春。\n仙舟偶共元礼载，宫舍仍依王翰邻。\n忽有清诗惊老眼，惭无惠化及斯人。\n半生不分微官缚，早晚故溪归钓纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江南野步简贺子忱蔡瞻明","author":"曾惇","text":"步屧溪南探野梅，冲寒仍与故人来。\n竹边嫩蕊为谁好，雪后恶云今日开。\n照夜剩呼修月户，惜花须筑避风台。\n中郎华发殊堪酒，更挽稽山贺监回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和何麒子应雪堂","author":"曾惇","text":"坐想诛茅日，山川走百灵。\n重来寻旧宅，几至泣新亭。\n何意投天禄，犹传是岁星。\n花砖知底物，只老合沉溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和谢景思","author":"曾惇","text":"康乐东山迹已陈，续衣传钵不无人。\n往时绛阙清都上，几岁荒山野水滨。\n红药高吟须小谢，白莲胜社得遗民。\n不嫌小邑来车辙，同试龙园第一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洪景伯饮诸丈分绣阁以诗戏之","author":"曾惇","text":"新营小阁面孱颜，领客开樽紫翠閒。\n千里画图供徙倚，一时名胜喜跻攀。\n好风已破晚来暑，小雨不遮湖上山。\n老子个中殊不浅，尚堪同醉看弓弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖霞会饮诸僚","author":"曾惇","text":"月近中秋好，风因小雨清。\n山眉烟外远，江练夜深横。\n我病自不饮，君诗俱有声。\n放歌能取醉，不必唤嘉荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖霞偶作","author":"曾惇","text":"蔬饭已忘肉，清心已是僧。\n春华空婉娩，衰病苦侵凌。\n风飏孤舟急，江明远浦澄。\n邵楼来远念，实怯醉时登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"分绣阁","author":"曾惇","text":"治中妙言语，洪涛泻词源。\n向来群玉府，垂上紫微垣。\n佐郡沧海傍，凭轩望朝暾。\n便欲乘轻车，长啸登昆崙。\n兹楼何缥缈，千岩霭云屯。\n空庭百吏散，博山炷微薰。\n重寻羡门辈，仙事渺无垠。\n何知对妙高，举手招德云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖怀贺子忱","author":"曾惇","text":"不负春风烂漫晴，聊驱小队出郊坰。\n一百五日可无酒，二十四弦须细听。\n溶溶漾漾沙鸟白，短短长长溪柳青。\n贺监扁舟在何许，惜无妙墨记兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪景伯韵 其二","author":"曾惇","text":"半刺风流雅好贤，幽寻同举蔡经鞭。\n江梅满树为谁好，官柳著行还自妍。\n笔阵如君难索敌，诗锋顾我敢争先。\n一春剩唤忘忧子，要看长鲸吸百川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪景伯韵 其三","author":"曾惇","text":"新诗清如玉壶冰，一读为破旅愁凝。\n正怀狂客贺秘监，忽见高人王右丞。\n坐忘仙去境尚在，广文骨冷呼不应。\n其谁洗涤怀古恨，别乘博物如何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次谢景思韵","author":"曾惇","text":"埋没双岩已百年，班班胜事漫流传。\n幸陪佳客挥犀麈，实欠倾城舞绣筵。\n故老风流寒似铁，月卿英妙笔如椽。\n拂衣便欲故山去，复恐眼中无此贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朱知裁少卿见贻二首 其二","author":"曾惇","text":"少陵卧穷巷，作诗叹秋雨。\n坐令马群空，真欲洗万古。\n乃知笔有神，宁复惭思阻。\n此翁已仙去，上界足官府。\n下视五浊世，正自一尘聚。\n后学如秋蝉，聒耳了无取。\n月卿折槛后，传家有仪矩。\n织成锦绣段，宫商寄鸣杼。\n追还正始音，雅颂继皇武。\n即今风骚将，仅可一二数。\n岂伊尘滓人，得此百世士。\n心源忽湛然，对面识诸祖。\n何待登妙高，历险叹踽踽。\n便可咤善才，室中闻密语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朱知裁少卿见贻二首 其一","author":"曾惇","text":"丹丘山水窟，中有如斗城。\n地迥鸟不喧，一叶动亦惊。\n閒门有胜士，学道师广成。\n翛然卧环堵，六印一缕轻。\n脱非玄真子，疑即坐忘生。\n姓名存丹台，宁问月旦评。\n小试未轩翥，襆被辞汉廷。\n肯令莲社流，坐叹草堂灵。\n要当酌家酿，酒色粲碧瑛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清閟堂","author":"曾惇","text":"洪郎雅吴语，不减贺季真。\n开轩风烟上，爽气朝朝新。\n手栽渭川竹，坐对北海尊。\n平生耐久朋，岁晚独此君。\n此君不可疏，亦复未易亲。\n纷纷桃李行，岂容托清尘。\n退食静隐几，微风冷衣巾。\n乃知王子猷，真是我辈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题一相庵","author":"曾惇","text":"满山松竹翠成林，彷佛前身旧所临。\n不分双旌杀风景，他年蜡屐再幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题谢景思少卿药寮二首 其二","author":"曾惇","text":"维摩示清羸，宴坐丈室中。\n静观世上人，百邪所交攻。\n我有一丸药，得之无是公。\n人人各安乐，淡然心地空。\n脱复未办此，济物存阴功。\n南山千岁苓，托根万丈松。\n下有青青草，其名为救穷。\n愿君时举手，采取置药笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题谢景思少卿药寮二首 其一","author":"曾惇","text":"先生数亩园，种药一何盛。\n子知医国手，元自谙药性。\n愚溪植仙毗，服食每自信。\n伏波收薏苡，初不避谗柄。\n牛溲马渤辈，并蓄用必慎。\n我知若人心，欲了世閒病。\n君非山中相，疑即句漏令。\n问讯紫金丹，刀圭宜有赠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟 秋寿太守","author":"曾惇","text":"去年看月诗成，援毫曾寄鄞江守。\n流传乐府，惭非宾客，竹枝杨柳。\n今岁江楼，载勤歌扇，青蛾应奏。\n况铃斋初驻，凉生燕寝，有香雾凝清昼。\n遥想十洲三岛，对冰轮、寒光依旧。\n主人来自，清都碧落，天香满袖。\n寄语嫦娥，剩留清照，时为公寿。\n恐明光诏下，翩然归去，试为霖手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情令 别意","author":"曾惇","text":"鄞江云气近蓬莱。\n花柳满城隈。\n风流谢守相遇，应覆故人杯。\n烟浪暖，锦帆回。\n莫徘徊。\n玉霄亭下，芍药荼蘼，都望归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 送淮漕钱处和","author":"曾惇","text":"绣衣直指，问凌风一笑，翩然何许。\n诏出层霄持汉节，千里秋风淮浦。\n鉴远江山，竹西歌吹，曾被腥膻污。\n须君椽笔，为渠一洗尘土。\n休厌共倒金荷，翠眉重为唱，渭城朝雨。\n看即扬鞭归骑稳，还指郁葱深处。\n宝带兼金，华鞯新绣，直上云霄去。\n回头莫忘，玉霄今夜风露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 重九饮栖霞","author":"曾惇","text":"九月传杯，要携佳客栖霞去。\n满城风雨。\n记得潘郎句。\n紫菊红萸，何意留侬住。\n愁如许。\n暮烟一缕。\n正在归时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"曾惇","text":"无数春山展画屏。\n无穷烟柳照溪明。\n花枝缺处小舟横。\n紫禁正须红药句，清江莫与白鸥盟。\n主人元自是仙卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其一","author":"曾惇","text":"幽芳独秀在山林。\n不怕晓寒侵。\n应笑钱塘苏小，语娇终带吴音。\n乘槎归去，云涛万顷，谁是知心。\n写向生绡屏上，萧然伴我寒衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其二","author":"曾惇","text":"绿华居处渺云深。\n不受一尘侵。\n细看宜州新句，平生才是知音。\n凌波一去，平山梦断，谁是关心。\n惟有青天碧海，知渠夜夜孤衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"曾惇","text":"浅沙细与鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"曾惇","text":"家贫只旧醅，不办樽中醁。\n但煮官焙香，炊饭鲙鱼腹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"曾惇","text":"坐对潜山万髻鬟，一峰孤秀独搀天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游临武秀岩 其一","author":"曾晞颜","text":"琼楼玉宇落荒村，鸡犬无声到洞门。\n采凤久藏丹穴羽，青莲倒续华峰根。\n笑谈疑有宫商应，剜刻浑无斧凿痕。\n莫讶空中能卓立，亭亭一柱拄乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 以梅为寿","author":"曾晞颜","text":"昨夜探寒梅，先报一阳消息。\n天遣花神妆点，衬贤侯清白。\n试将玉蕊比修龄，算枝头千百。\n更有不凡风味，付调羹仙客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎 贺耐轩周府尹己卯","author":"曾晞颜","text":"富贵人间有。\n就如今，秤量阴德，还公最厚。\n一郡鹘崙全似旧，春满霜畴稻亩。\n近帐外、干将夜吼。\n直指禾川弄霆雷，从山阴、鹿健那能走。\n都算计，怎担负。\n单车曲曲穿岩窦。\n向迷途、分明一呼，散渠回首。\n夹路香花迎拜了，见说家家举酒。\n道公是、再生父母。\n活一口还添一岁，这一回、活几千千口。\n只此事，是公寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡季昭谪象州","author":"曾梦选","text":"象州销黯又钦州，道路何辞作远游。\n投北谁怜新逐客，落南不减旧编修。\n江山在处犹加护，廊庙诸公底著羞。\n天定从来人可胜，著书消日海西头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客安南见进奉使回口占","author":"曾渊子","text":"安南莫道是天涯，岁岁人从蓟北回。\n江北江南亲故满，三年不寄一书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山","author":"曾渊子","text":"草径蜿蜒十里间，云间若在画图看。\n万松密翠地无影，一水长清空自寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日登翰苑台","author":"曾渊子","text":"翰苑台边拂旧题，岁华荏苒壮心违。\n看萸喜得亲长健，对菊犹惭令未归。\n秋水一江鸥共瘦，云山千里雁初飞。\n宦情有暇无风雨，把酒相酬此会稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳南示义军寄邑人谭野臣","author":"曾渊子","text":"漳州城南烟雾深，漳州城北氛气侵。\n忆从奸邪卖和议，汉廷君臣愁至今。\n乘舆播迁天地怒，残军掩泣眠星雾。\n黄金无收白骨多，指点枯骸拟亲故。\n昨夜羽书如电飞，报道三城又被围。\n皇家恩深重如山，英雄奋起披铁衣。\n万人同心猛如虎，关山震动挝鼙鼓。\n百战须当百胜归，凯歌唱满中原土。\n论功赏爵将宪章，汾阳异姓封侯王。\n鞠躬尽瘁固常事，愿教一涌歼豺狼。\n莫上高楼偶长望，壮怀忽忽思乡丈。\n琴台落日私语时，丹心耿耿今能忘。\n惜君忠义老无官，山河破裂泪欲乾。\n衰容未画麒麟阁，目尽故园心转酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登麻姑山","author":"曾渐","text":"蹑石扪萝得得来，人间尘累已忘怀。\n行穷险道忽平地，立看飞泉倾断崖。\n邃宇半依苍木里，秀峰长是白云埋。\n方平羽驾今何在，欲会仙姑恨未谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浯溪磨崖","author":"曾焕","text":"元颂颜书山谷诗，还镌我宋中兴碑。\n慇勤三读重回首，万□□□江渺瀰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题飞雪亭","author":"曾焕","text":"玉虬垂处雪花翻，四序雷声六月寒。\n凭槛未穷千丈势，请君岩下举头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸿沟和吕圣功韵","author":"曾琏","text":"王霸兴亡劫几尘，鸿沟依旧锁寒云。\n不将帝业追三代，祇把河山割半分。\n故垒已随流水尽，归鸦空带夕阳曛。\n西风立马频回首，那忍猿声隔岸闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻西浦渔歌作","author":"曾跃鳞","text":"西浦鸣榔下钓矶，歌声欸乃送斜晖。\n扣舷互答惊鸥梦，拍手欢呼看鹭飞。\n山接素琴仙子过，洲连青草使君归。\n海天空阔家长在，一任芦花雪点衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游王母冈","author":"曾跃鳞","text":"冈空云散净如银，石磴层层接九宸。\n翠竹影摇湘浦夜，碧桃香蔼武陵春。\n但看此日烧丹灶，不见当年驾鹤人。\n游遍瑶池归去晚，一声长啸月华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉送自强明府之官昆山","author":"曾逮","text":"吴中大县数昆山，心定庭空亦不难。\n多事要将无事治，万人须作一人看。\n床头有易何妨读，琴上无弦不用弹。\n况是威名贤太守，吏民谁敢半言谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"曾逮","text":"满树叶繁枝重，缀青黄千百。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沁园春 其六 寿制帅吴退庵","author":"曾寓轩","text":"运在东南，千古金陵，帝王旧州。\n看地雄江左，蟠龙踞虎，事专阃外，缓带轻裘。\n惟断乃成，非贤罔任，真是富韩文范俦。\n难兄弟，久齐名天壤，谁劣谁优。\n冕旒。\n似欲兼收。\n命四辈传宣难借留。\n记适遵昆季，迭行沙路，育充伯仲，并在金瓯。\n或后或先，相推相逊，等是延陵德泽流。\n称觞了，便促装西上，同奉宸游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 寿章殿院","author":"曾寓轩","text":"细数班行，阿谁是、调元手段。\n君不见、当涂往岁，饥民流散。\n天幸立庵来歇马，留心济粜无遗算。\n未须臾、千里复安居，无愁叹。\n公与相，天皆愿。\n天施报，如符券。\n看青州阴骘，富公公案。\n已筑新堤旌异数，便膺虚席非常眷。\n待明年、弧矢再垂门，蒙宣劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题资福院平绿轩","author":"曾揆","text":"终日劳劳雁鹜行，偶然来访赞公房。\n扶疏草木四围合，萦绕溪流一带长。\n倚槛岂能成杰句，把杯多是说名方。\n问师乞取安心法，宴坐蒲团对佛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"曾揆","text":"檐雨轻敲夜夜，墙云低度朝朝。\n日长天气已无聊。\n何况洞房人悄。\n眉共新荷不展，心随垂柳频摇。\n午眠仿佛见金翘。\n惊觉数声啼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南柯子/南歌子","author":"曾揆","text":"桐叶凉生夜，藕花香满时。\n几多离思有谁知。\n遥望盈盈一水、抵天涯。\n雨洒征衣泪，月颦分镜眉。\n相逢又是隔年期。\n不似画桥归燕、解于飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚","author":"曾揆","text":"芙蓉帐冷翠衾单。\n魂梦几曾闲。\n怎禁未许，茫茫烟水，叠叠云山。\n去时频把归期约，远不过春残。\n而今已是，荷花开了，犹倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]