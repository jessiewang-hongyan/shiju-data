[{"title":"题张圣言画四时景物 其四","author":"潘大临","text":"云蒙山头雪翻空，飞鸟绕树困号风。\n关山淮水失微路，酒炉曾借衰颜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠张圣言画柯山图","author":"潘大临","text":"我昔骑鲸游九州，上扣天关望冕旒。\n群公侍旁好颜色，将顺帝旨成刚柔。\n抱持日月不自献，蒙茸尘土归家丘。\n结茅竹间今休已，炎暑避舍清飙留。\n屋头清溪鸣昼夜，当户古木蔽马牛。\n苍头卢儿从高盖，传呼不到门巷幽。\n两公忘言儿袖手，驱除睡魔须茶瓯。\n谁传此意到旁郡，解衣槃礴烦张侯。\n张侯落笔妙天下，未坠学士之风流。\n欲见柯山入画图，丹青知君百不忧。\n黄公不肯直南省，一麾已具东南舟。\n请君援笔待公至，画我迎公竹阴里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"潘大临","text":"胡子云中白鹤，林生初发芙蓉。\n吴十九成雅奏，饶三百炼奇锋。\n南州复见高士，东山行起谢公。\n信祖真成德祖，立之无愧行中。\n吴生可共南郡，老夫宁附石崇。\n闻雅已倾重客，说谈仍得王戎。\n冠盖城南高会，山阴未扫馀风。\n客散日衔西壁，主人不道尊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"潘大临","text":"归来陶隐居，拄颊西山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"潘大临","text":"诗束牛腰藏旧稿，书讹马尾辨新雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"潘大临","text":"八字山头雁，武昌江上鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"潘大临","text":"思君带孔移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"潘大临","text":"两屐上层楼，一目略千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钓台","author":"潘中父","text":"焚坑祸作逃园绮，明哲保身宁饿死。\n溺冠嫚骂又一春，织畚鼓刀恬不耻。\n子房托疾封留归，齐鲁大臣那可知。\n此意寥寥二百载，阿谀往往居帝师。\n中兴天幸有光武，下士谦恭冠千古。\n布衣本以道义交，不问故人登九五。\n朅来过我路几程，征衫犹作战血腥。\n睡馀伸足稍加腹，安得细事关天星。\n归与宜审苞桑戒，勿念洁身增叹慨。\n君持柔道理乾坤，我把丝纶老湍濑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢张御史见访","author":"潘从大","text":"绿满山人屐齿苔，蓬门长日为谁开。\n那知御史秋霜笔，携得春风满袖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠无庵沈相师","author":"潘从大","text":"喜见人间百岁翁，青鞋藜杖步如风。\n一庵无处知身幻，四海行来觉眼空。\n论相又看新进士，挑诗多识旧名公。\n承平往事谁知得，闲听高谈梦寐同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏斋以旧作题渊明归来图诗见赠依韵奉和","author":"潘从大","text":"公归岂为三径松，取节荆轲雠祖龙。\n平生大义要其终，遁身甘混田舍翁，肯随一世皆尚同。\n言言易水诗见志，抚卷陡觉辞深雄，谁知笔补造化工。\n寓怀曲糵匪轹醉，孤忠耿耿蟠心胸。\n纡辔几许尘埃中，柴桑不与车马通。\n八表同昏雨濛濛，皦日行天西复东。\n当年荣木随时穷，黄花今犹傲秋风。\n拜公遗像读公传，眼高千载为之空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏斋用前韵记响山之游依韵奉答","author":"潘从大","text":"空山在昔森万松，两贤曾此登虬龙。\n流风馀韵无时终，我来寒栖鬓成翁，人生出处何心同。\n梦破邯郸几富贵，战退蛮触相长雄，静定要与山争功。\n绣衣光华照岩壑，豁然纳我云梦胸。\n群峰飞翠匏樽中，仙源还□渔舟通。\n须臾烟霏散空濛，楼观隐约孤城东。\n感慨千古思无穷，啸歌抵掌生英风。\n黄金易求此乐少，野人何计箪瓢空。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢人惠鱼米","author":"潘从大","text":"读书干禄不医贫，馔厌寒菹甑欲尘。\n自笑凄凉弹铗客，欣逢慷慨指囷人。\n江南缩项鲜堪鲙，浙右长腰色胜银。\n盂饭杯羹饱扪腹，鬓迈岁事又从新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为被虏妇作 其四","author":"潘文虎","text":"鹁鸪鸪，鹁鸪鸪，帐房遍野相喧呼。\n阿姊含羞对阿妹，大嫂挥泪看小姑。\n一家不幸俱被虏，犹幸同处为妻孥。\n愿言相怜莫相妒，这个不是亲丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为被虏妇作 其二","author":"潘文虎","text":"不如归去，不如归去，家在浙江东畔住。\n离家一程远一程，饮食不同言语异。\n今之眷聚昔寇仇，开口强笑心怀忧。\n家乡欲归归未得，不如狐死犹首丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为被虏妇作 其三","author":"潘文虎","text":"泥滑滑，泥滑滑，脱了绣鞋脱罗袜。\n前营上马忙起行，后队搭驼疾催发。\n行来数里日已低，北望燕京在天末。\n朝来传令更可怪，落后行迟都砍杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为被虏妇作 其一","author":"潘文虎","text":"交交桑扈，交交桑扈，桑满墙阴三月暮。\n去年蚕时处深闺，今年蚕时涉远路。\n路傍忽闻人采桑，恨不相与携倾筐。\n一身不蚕甘冻死，祇忆儿女无衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悟性寺","author":"潘正夫","text":"乱山深处出楼台，秋入群松万壑哀。\n岚翠逼人清似雾，滩声落石响如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题惠山","author":"潘正夫","text":"秋风萧瑟净岩扃，寂寂澄泉可鉴形。\n比色未饶先玉乳，试甘应合跨中泠。\n梦回春草花犹落，雪洒松窗酒乍醒。\n须碾月团三百片，不辞来此汲泓渟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹岩六韵奉呈逊叔侍郎兼寄惠照禅老","author":"潘正夫","text":"祝融之南近湘滨，地出天开戡翠珉。\n金阙不关尘世路，丹葩争发洞宫春。\n迟留杖履寻真惯，怅望烟萝入梦频。\n弈罢空怀烂柯客，云深多失避秦人。\n高悬石栈仙风迥，静对岩扉濯色新。\n借问时翁与禅伯，如何导往许为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘正夫","text":"岭开越峤通交趾，路转荆门入九疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采药","author":"潘汇征","text":"采药归来抱膝吟，烟霞情性爱山林。\n不留踪迹在图画，三十六峰何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊游遇黄府女孙","author":"潘用中","text":"谁教窄路恰相逢，脉脉灵犀一点通。\n最恨无情芳草路，匿兰含蕙各西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答黄府女孙","author":"潘用中","text":"一曲临风值万金，如何难买玉人心。\n君如解得相如意，比似金徽恨更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"社日","author":"潘亥","text":"听得东风急，吹乾小径泥。\n雨多花放早，水满燕飞低。\n贫女不知纬，幽人只此栖。\n依依怀去岁，摘茗白坛西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵紫芝","author":"潘亥","text":"长安独跨驴，一别二年馀。\n朝士不能荐，承明空有庐。\n窗虚桐影薄，棹冷桂花初。\n莫怪无书札，心亲迹任疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠善书记","author":"潘亥","text":"不见十年久，缘师懒入城。\n庵移五峰近，病去一身轻。\n弟子新传业，诗人旧识名。\n依然难驻屐，空复重予情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送兄赴饶","author":"潘亥","text":"草堂荒芜未春暮，乳燕安巢雁北去。\n回首蜃水桃始花，及至螺江柳飞絮。\n江东绣衣真御史，闻者纷纷毛发起。\n日长惟抱空瓮眠，头白应怜故人子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘先生","text":"大江今古怒声怒，长为将军气不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌云阁","author":"潘兴嗣","text":"萧峰顶上与云齐，一派溪流直下飞。\n击破寒冰千万片，涵林幽响动清晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦人洞","author":"潘兴嗣","text":"秦人当日避风烟，自种桑麻老洞天。\n绿竹横溪鸡犬静，不知门外汉山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八百石洞","author":"潘兴嗣","text":"八百仙来不记年，剑池丹井尚依然。\n秀峰插汉含灵气，古洞通真锁瑞烟。\n竹简漆书何处觅，神符白雪更谁传。\n芝軿一去人间世，应念沧波又变田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏郭功甫","author":"潘兴嗣","text":"休恨古人不见我，犹喜江东独有卿。\n尽怪阿戎从幼异，人疑太白是前生。\n云间鸾凤人间现，天上麒麟地上行。\n诗律暮年谁可敌，笔头谈笑扫千兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滕王阁春日晚眺","author":"潘兴嗣","text":"重叠西屏对面开，巍城穹阁信雄哉。\n眼中孤鹜云边没，望里长江槛外来。\n蛱蝶图成春未晚，柘枝筵动客多才。\n休论今古兴亡事，时倒金樽醉一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠茂叔太博","author":"潘兴嗣","text":"心似冰轮浸玉渊，节如金井冽寒泉。\n每怀颜子能希圣，犹笑梅真祇隐仙。\n仕傥遇时宁枉道，贫而能乐岂非贤。\n区区世路求难得，试往沧浪问钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙沙","author":"潘兴嗣","text":"五陵无限人，密视龙沙记。\n龙沙虽未合，气象已灵异。\n昔时蛟龙湫，半作桑麻地。\n地形带江转，洲浮有连势。\n陵谷岂可常，渊窦在何岁。\n微生久慕道，安恬辄忘味。\n愧无及物功，碌碌尚匏系。\n生蒙尘土厚，未受神仙秘。\n何时与孤鹤，冉冉从此逝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师道","author":"潘兴嗣","text":"师道久不振，小儒咸自私。\n破崖求圭角，务出己新奇。\n恻恻去圣远，六经秦火隳。\n不有传授学，涉猎安所为。\n汉儒守一经，学者如云随。\n承习虽未尽，模法有根基。\n荐绅立朝廷，开口应万机。\n附对皆据经，金石确不移。\n熟烂见本末，较然非可欺。\n吾愿下学官，各立一经师。\n务尽道德业，不取章句辞。\n庶几昔人风，炳然复在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西山翠岩联句","author":"潘兴嗣","text":"苍龙夭矫西山来，凿破明珠成碧岫。\n何人架空起楼阁，地灵不敢藏馀秀。\n锁窗云重衣巾润，梳木风清肌骨透。\n客来一夜与僧谈，气觉浩然充宇宙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过濂溪","author":"潘兴嗣","text":"鳞鳞负郭田，渐次郊原口。\n其中得清旷，贵结林泉友。\n一溪东南来，潋滟翠波走。\n清响动灵粹，寒光生户牖。\n峨峨双剑峰，隐隐插牛斗。\n疏云互明晦，岚翠相妍丑。\n恍疑座中客，即是关中叟。\n为歌紫芝曲，更击秦人缶。\n窅然忘得丧，形骸与天偶。\n君怀康济术，休光动林薮。\n得非仁知乐，夙分已天有。\n捉鼻固未免，安能混真守。\n日暮车马徒，桥横莫回首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逍遥亭","author":"潘兴嗣","text":"作亭名逍遥，此理诚不虚。\n宽于一天下，原宪惟桑枢。\n况我卜清旷，风雨庇有馀。\n方池容潋滟，小径足萦迂。\n花木颇窈窕，松筠亦扶疏。\n鸣蛙送鼓吹，好鸟来笙竽。\n可琴亦可咏，可饮亦可娱。\n盘虽无下箸，宾食亦有鱼。\n恢论或申旦，隐几忘移晡。\n困来展足眠，醉倒从人扶。\n率尔但付畅，因烦而领无。\n邺侯三万轴，方朔五车书。\n弃置复弃置，任自相贤愚。\n无妨吾逍遥，此乐诚何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"潘兴嗣","text":"丰狱剑飞云气尽，吴州仙去敢言轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"潘兴嗣","text":"拟将十幅绡，绘出云堂景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"潘兴嗣","text":"窥鱼白鸟明残照，抱石幽云点半青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘夙","text":"橐中奇物为棋输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大涤洞天留题","author":"潘伯虎","text":"平生闻有洞霄奇，三载京华梦里知。\n非藉贤侯为引领，那因小子获追随。\n危坡滑滑凭舆上，古洞阴阴秉烛窥。\n万壑千岩游未遍，又催归骑向东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼吟","author":"潘初","text":"朝向蓬莱游，暮归蕊珠宿。\n偶然折断玉龙腰，降下凡间三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入南溪","author":"潘希白","text":"沙头落月照蓬低，杜宇谁家树底啼。\n舟子不知人未起，载将残梦上青溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉夜","author":"潘希白","text":"凉夜无云星自流，池塘促织早知秋。\n远更不受重城隔，时逐西风到小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"积霭","author":"潘希白","text":"积霭收残雨，千峰在小楼。\n忽然空远思，野服上渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题云山图","author":"潘希白","text":"谷口无人烟树迷，雨添新瀑下前溪。\n思家只作归程看，疑有春深杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋朴之维阳","author":"潘希白","text":"隋家天子爱扬州，四十离宫取次游。\n荆棘久迷秦陇路，柳丝空拂汴河流。\n君才清似庾开府，世事难于孙仲谋。\n莫为青衫怯骑马，却将风景付閒愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广德早行","author":"潘希白","text":"草屦穿篱过，衣湿槿花露。\n千里浙东人，今踏江南路。\n晓程犹带夜，众星照高树。\n家中犹未醒，梦我青云去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丑奴儿慢/采桑子慢","author":"潘汾","text":"愁春未醒，还是清和天气。\n对浓绿阴中庭院，燕语莺啼。\n数点新荷翠钿，轻泛水平池。\n一帘风絮，才晴又雨，梅子黄时。\n忍记那回，玉人娇困，初试单衣。\n共携手、红窗描绣，画扇题诗。\n怎有如今，半床明月两天涯。\n章台何处，应是为我，蹙损双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉蝴蝶","author":"潘汾","text":"睡起日高莺啭，画帘低卷，花影重重。\n醉眼羞抬，娇困犹自未惺忪。\n绣床近、强来描翠，妆镜掩、不肯匀红。\n锦屏空。\n对花无语，独怨春风。\n匆匆。\n庾郎去后，香销玉减，是事疏慵。\n纵蛮笺封了，何处问鳞鸿。\n眼中泪、万行难尽，眉上恨、一点偏浓。\n杳无踪。\n夜来惟有，幽梦相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花心动","author":"潘汾","text":"啼鸟惊心，怨年华，羞看杏梢桃萼。\n映柳小桥，芳草闲庭，处处旧游如昨。\n断肠人在东风里，遮不尽、几重帘幕。\n旧巢稳，呢喃燕子，笑人漂泊。\n应是素肌瘦削。\n空望断天涯，信音难托。\n半污泪痕，重整馀香，夜夜翠衾寒薄。\n倦游只怕春归去，怎忍见、水流花落。\n梦魂远，韶华又还过却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孟家蝉 蝶","author":"潘汾","text":"向卖花担上，落絮桥边，春思难禁。\n正暖日温风里，斗采遍香心。\n夜夜稳栖芳草，还处处、先亸春禽。\n满园林。\n梦觉南华，直到如今。\n情深。\n记那人小扇、扑得归来，绣在罗襟。\n芳意赠谁，应费万线千针。\n谩道滕王画得，枉谢客、多少清吟。\n影沈沈。\n舞入梨花，何处相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倦寻芳 闺思","author":"潘汾","text":"兽镮半掩，鸳甃无尘，庭院潇洒。\n树色沈沈，春尽燕娇莺姹。\n梦草池塘青渐满，海棠轩槛红相亚。\n听箫声，记秦楼夜约，彩鸾齐跨。\n渐迤逦、更催银箭，何处贪欢，犹系骄马。\n旋剪灯花，两点翠眉谁画。\n香灭羞回空帐里，月高犹在重帘下。\n恨疏狂，待归来、碎揉花打。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居苦","author":"潘玙","text":"凿破碧云开牖户，花多留得春长久。\n种蔬种豆了生涯，心闲只与琴为友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书兰莫德全壁","author":"潘玙","text":"谁谓居廛身未清，在家心似出家僧。\n铜壶惯买梅花插，相对无言悟小乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书红尘兰若吟卷","author":"潘玙","text":"家住东风花柳边，客来试茗学谈禅。\n有时病酒关门睡，梦到维摩丈室前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东吴府佥见山觅酒","author":"潘玙","text":"火龙走日烁炎天，久渴羁肠拟吸川。\n见说蓝桥风月好，愿分清致到吟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四圣观御园海棠花","author":"潘玙","text":"燕子来时春政好，御园剩拆海棠花。\n如今翠辇游观少，一片东风属道家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"休倚楼","author":"潘玙","text":"碧天如水片云收，雁雁西风字字秋。\n江上有楼休独倚，夕阳衰草几多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸠","author":"潘玙","text":"斑斑羽拂晓烟青，一样东风两样声。\n计拙不如鸱妇巧，绸缪桑户趁天晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日闲居二首 其二","author":"潘玙","text":"西风挟雨过江来，水树烟村罨画开。\n待得夜晴窗有月，横斜祇欠数枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]