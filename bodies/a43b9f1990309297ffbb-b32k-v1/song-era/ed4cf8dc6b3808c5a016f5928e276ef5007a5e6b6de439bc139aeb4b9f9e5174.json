[{"title":"致政少卿邵公挽辞三首 其二","author":"苏颂","text":"江左推华胄，朝端挹老成。\n官登九寺贵，迹寄五湖清。\n治行当年立，家声继世荣。\n书林有贤杰，名德岂惭卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政少卿邵公挽辞三首 其一","author":"苏颂","text":"屡试循良政，兼推干裕才。\n惠和绥列郡，风绩振行台。\n始见彤襜去，遄惊画翣回。\n甘棠犹蔽芾，高陇已崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政侍读孙蔓叔挽辞二首 其二","author":"苏颂","text":"英祖修官日，先皇出震年。\n甘泉方授职，少海继登贤。\n望积公台久，恩从诔册宣。\n遗思满京邑，曾议市租钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政侍读孙蔓叔挽辞二首 其一","author":"苏颂","text":"秘殿除书降，经筵特诏开。\n未闻陪幄议，忽起奠楹哀。\n卜葬青乌兆，临丧白马来。\n平生我投分，洒泪向天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公唱和多记经历之事因感昔游复用元韵凡三首 其三","author":"苏颂","text":"平生南北与东西，岂是扬波与汩泥。\n晚入金门诸彦接，来同绮席赐尊携。\n时逢宠渥欣陪预，老遇风光懒咏题。\n共戴君恩何以报，惟将圣寿祝天齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公唱和多记经历之事因感昔游复用元韵凡三首 其二","author":"苏颂","text":"朝鞍早过凤楼西，雨浥轻尘未有泥。\n颁宴百壶人共醉，演纶双笔客同携。\n紫微旧刻兰堂閟，朱字新牌艺院题。\n更识训词深厚意，言成膏泽惠编齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸公唱和多记经历之事因感昔游复用元韵凡三首 其一","author":"苏颂","text":"十年不到掖垣西，旧路重寻壁已泥。\n四户贵同公鼎重，九门高共斗杓携。\n追思往事惊陈迹，欲和长言怯巨题。\n老见诸贤虽缩忸，不量绵力尚思齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读杨文公集","author":"苏颂","text":"文公名节冠当年，没世清风更凛然。\n梁父旧庐空德里，西州华屋恸时贤。\n平生奏御三千牍，不朽文章二百篇。\n潇洒建溪遗俗在，至今弦诵满山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱起居挽辞二首 其一","author":"苏颂","text":"地席贤王宠，官分右掖司。\n文华天所赋，政事吏为师。\n始见良言进，俄惊哲士萎。\n平生公辅业，所赖圣明知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄译经清衍大师","author":"苏颂","text":"辇寺栖迟不计年，衡门无异对林泉。\n试闱给笔频辞命，译馆翻经屡奏篇。\n九陌尘埃方外境，六时香火静中缘。\n思陪丈室谈名理，自愧常为俗累牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题吴兴墨妙亭","author":"苏颂","text":"汉唐遗刻在江干，右史殷勤辑坠残。\n剔去藓文人乍识，传来墨本字犹完。\n六书体法从兹辨，二费声光遂不刊。\n何必临池苦萦思，燕閒时得坐隅观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题宗室世泽太博修性斋","author":"苏颂","text":"人情安逸或骄惛，君子操修有本原。\n结宇近同閒燕处，题颜深警圣贤言。\n游心最乐群书富，寓目无穷百卉繁。\n治世右文风教洽，彬彬儒雅遍宗藩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题傅钦之学士济源草堂","author":"苏颂","text":"大形南址直河津，君有茅庐泲水滨。\n苍翠入檐藏绝景，潺湲绕舍隔嚣尘。\n久游台阁忘声利，长忆渔樵狎隐沦。\n待得功成年至日，归来不负故园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题蒲传正学士清风阁","author":"苏颂","text":"阁倚青山书满堂，门齐通德里高阳。\n传家载世惟清白，教子何人似义方。\n班嗣一丘虽道卷，刘商七业已名彰。\n他年驷马充闾贵，须信文儒泽施长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"接伴北使至乐寿寄高阳安抚吴仲庶待制","author":"苏颂","text":"道路传闻北守贤，就中清尚是河间。\n辕门卧鼓军无警，幕府赓歌笔不閒。\n只合论思居禁闼，岂宜留滞在边关。\n宁容旧客升堂室，拟请新篇满箧还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆西迎驾起居","author":"苏颂","text":"一梢鸣跸启重关，广殿传呼趣就班。\n瑞日初临黄盖外，紫云先绕翠裘间。\n和鸾音里趋翔过，锦绣围中拜舞还。\n共诧书林清近地，彤墀咫尺对天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭城县太君挽辞二首 其二","author":"苏颂","text":"寿考人间福，贤明阃内宗。\n铭传史官笔，墓绕故乡松。\n双剑归还合，南陔养莫容。\n登堂曾拜客，凄怆望新封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭城县太君挽辞二首 其一","author":"苏颂","text":"封邑从夫贵，传家嗣子贤。\n初闻板舆去，忽怆寿宫迁。\n树隐长平外，川流濩泽前。\n高门馀庆在，足以慰沈泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭城郡郑太夫人挽辞二首 其二","author":"苏颂","text":"他日亏常膳，呼医走数州。\n初欣药瞑眩，俄痛疾弥留。\n子舍终天恨，都人挽绋愁。\n春风汝阴道，贵母葬新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭城郡郑太夫人挽辞二首 其一","author":"苏颂","text":"姓系山东胄，乡闾建业城。\n有家归吉士，从子尹留京。\n望郡疏封美，黄堂侍膳荣。\n终焉贵与寿，无一慊平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景纯学士文丈再录早年见庆嘉篇重用前韵奉和","author":"苏颂","text":"载世交游共一时，立朝几见盛门扉。\n官班早合登青琐，星象俄闻返少微。\n曾向瀛仙陪雅集，更同绵蕝讲鸿徽。\n江干千里劳魂梦，常恨平安信息稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝议大夫致仕张公挽辞二首 其二","author":"苏颂","text":"忆寓龙阳馆，曾陪布素游。\n登朝俱老大，分袪几春秋。\n脱屣追三景，遗衣复一丘。\n无因素车送，感旧涕双流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝议大夫致仕张公挽辞二首 其一","author":"苏颂","text":"清修闻校议，慈惠布州蕃。\n奉使功虽最，遗荣道亦尊。\n卜居邻楚泽，反葬近秦源。\n自得寻真趣，高风世所敦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登雄州城楼","author":"苏颂","text":"三关相直断华戎，燕蓟山川一望中。\n斥堠人间风马逸，朝廷恩广使轺通。\n岁颁金絮非无策，利尽耕桑岂有穷。\n自古和亲诮儒者，可怜汉将亦何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陈再次前韵","author":"苏颂","text":"牛斗经年望建标，忽闻行李度南谯。\n仙舟复喜逢元礼，飞御仍烦接子乔。\n已试演纶成典册，尚劳分竹偃藩朝。\n海沂邂逅诚多幸，继日相过不待招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答胡完夫示及四和前篇","author":"苏颂","text":"书名曾伏庾征西，词命宜封玉检泥。\n前日星垣同属咏，即时墨客已潜携。\n岂惟家集分门录，直待郊居满壁题。\n更览晋祠新石刻，从来文体压梁齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫宸殿正旦宴教坊口号","author":"苏颂","text":"敦牂开岁斗回杓，共庆元正视朔朝。\n仗下法官陈禹会，宴开平乐奏虞韶。\n北邦肤使星持节，近侍词臣颂献椒。\n共效华封人吉语，勤勤三请祝唐尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道元上人累示禅偈诗笔并诸贤赓唱见索鄙作因成短句奉酬","author":"苏颂","text":"释子南宗秀，囊文数见过。\n灯分壁观后，诗学宝书多。\n摘句心游刃，谈空辩注河。\n儒林盛推挹，风势张云柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"