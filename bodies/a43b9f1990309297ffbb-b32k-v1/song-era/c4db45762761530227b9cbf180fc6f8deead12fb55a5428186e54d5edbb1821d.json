[{"title":"吴冲卿夫人秦国挽词二首 其一","author":"苏辙","text":"国老相随尽，家风慨独存。\n见夫成相业，听子得忠言。\n气节惭多士，声华盛一门。\n平生高义重，未易俗人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋城宰韩秉文惠日铸茶","author":"苏辙","text":"君家日铸山前住，冬后茶芽麦粒粗。\n磨转春雷飞白雪，瓯倾锡水散凝酥。\n溪山去眼尘生面，簿领埋头汗匝肤。\n一啜更能分幕府，定应知我俗人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张公洞","author":"苏辙","text":"乱山深处白云堆，地坼中空洞府开。\n茧瓮有天含宇宙，瑶台无路接蓬莱。\n金芝春暖青牛卧，珠树月明黄鹤回。\n此日登临兴何限，春风吹绽碧桃腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张文裕侍郎挽词","author":"苏辙","text":"持节西南二十年，华堂遗像已苍然。\n归来侍从三朝旧，老去雍容平地仙。\n落笔纵横题壁处，诵诗清壮举杯前。\n东游邂逅迎归旐，泪落城南下马阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀黾池寄子瞻兄","author":"苏辙","text":"相携话别郑原上，共道长途怕雪泥。\n归骑还寻大梁陌，行人已渡古崤西。\n曾为县吏民知否，旧宿僧房壁共题。\n遥想独游佳味少，无言骓马但鸣嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李公麟阳关图二绝 其一","author":"苏辙","text":"百年摩诘阳关语，三叠嘉荣意外声。\n谁遣伯时开缟素，萧条边思坐中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李邦直见邀终日对卧南城亭上二首 其一","author":"苏辙","text":"一径坡陀草木间，孤亭胜绝俯川原。\n青天图画四山合，白昼雷霆百步喧。\n烟柳萧条渔市远，汀洲苍莽白鸥翻。\n客舟何事来匆草，逆上波涛吐复吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李邦直见邀终日对卧南城亭上二首 其二","author":"苏辙","text":"东来无事得遨游，奉使清闲亦自由。\n拨弃簿书成一饱，留连语笑失千忧。\n旧书半卷都如梦，清簟横眠似欲秋。\n闻说归朝今不久，尘埃还有此亭不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李邦直出巡青州余不久将赴南都比归不及见矣作诗赠别","author":"苏辙","text":"东道初来托故人，南楼频上泗河漘。\n江山尚有留人意，樽俎宁当厌客贫。\n顾我及秋行不久，问君触热去何因。\n西归凉冷霜风后，浊酒清诗谁与亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛潩水","author":"苏辙","text":"早岁南迁恨舳舻，归来平地忆江湖。\n半篙春水花千片，八尺轻船酒一壶。\n徐转城阴平野阔，稍通竹径小亭孤。\n前朝宰相终难得，父老咨嗟今亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀州僧本瑩净照堂","author":"苏辙","text":"有僧访我携诗卷，自说初成净照堂。\n求得篇章书壁素，不论尘土渍衣黄。\n故山别后成新岁，归梦春来绕旧房。\n看取盈编定何益，客来无语但循墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题二首 其一","author":"苏轼","text":"山行似觉鸟声殊，渐近神仙简寂居。\n门外长溪容净足，山腰苦笋耿盘蔬。\n乔松定有藏丹处，大石仍存拜斗馀。\n弟子苍髯年八十，养生世世授遗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赤壁怀古","author":"苏辙","text":"新破荆州得水军，鼓行夏口气如云。\n千艘已共长江崄，百胜安知赤壁焚。\n觜距方强要一斗，君臣已定势三分。\n古来伐国须观衅，意突成功所未闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎寄王适","author":"苏辙","text":"投窜千山恨不深，扁舟夏涉气如烝。\n重来疋马君何事，归去飞鸿我未能。\n养气经年惟脱粟，读书终夜有寒灯。\n安心且作衰慵伴，海底鲲鱼会化鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨不出寄张恕","author":"苏辙","text":"麦熟蚕缫热似烝，雨倾三尺未为淫。\n洗清沟浍蚊虻静，没尽蒲莲沼沚深。\n遗秉满田惊朽腐，移床避漏畏侵寻。\n高闲祇有张公子，卧听萧萧打叶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵武游氏老人三清堂紫芝","author":"苏辙","text":"黑龟赤凤早逢师，白发苍颜老不衰。\n丹鼎一丸深自秘，紫芝三叶却先知。\n烟熏晴日云容薄，色凝秋霜玉性奇。\n何日刀圭救羸病，尽芟荆棘种交梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰八月二十五日菊有黄花园中粲然夺目九日不忧无菊而忧无酒戏作","author":"苏辙","text":"年年九日忧无菊，今岁床空未有糟。\n世事何尝似人意，天公端解恼吾曹。\n金龟解去瓶应满，玉液倾残气尚豪。\n门外白衣还到否，今时好事恐难遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 楼观","author":"苏辙","text":"神仙避世守关门，一世沉埋百世尊。\n旧宅居人无姓尹，深山道士即为孙。\n天寒游客常逢雪，日暮归鸦自识村。\n君欲留身记幽寂，直将山外比羌浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 五郡","author":"苏辙","text":"蜀人不信秦川好，食蔗从梢未及甘。\n当道沙尘类河北，依山水竹似江南。\n观形随阜饮溪鹿，云气侵山食叶蚕。\n犹有道人迎客笑，白须黄袖岂非聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 大秦寺","author":"苏辙","text":"大秦遥可说，高处见秦川。\n草木埋深谷，牛羊散晚田。\n山平堪种麦，僧鲁不求禅。\n北望长安市，高城远似烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 仙游潭五首 其四 马融石室","author":"苏辙","text":"扶风贵公子，早岁伴山家。\n吹笛堕秋叶，读书随晓鸦。\n业成心自叛，学苦我长嗟。\n石室非人住，穷山雪似沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 仙游潭五首 其一 潭","author":"苏辙","text":"潭深不可涉，潭小不通船。\n路断游人止，龙藏白沫旋。\n剪藤量水短，插石置桥坚。\n桥外居民少，躬耕不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 仙游潭五首 其五 玉女洞","author":"苏辙","text":"洞门苍藓合，逼仄不容身。\n传有虚明处，中藏窈窕人。\n吹笙桥上月，拾翠洞南春。\n往往来山下，萧然雨洒尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻三游南山九首 仙游潭五首 其二 南寺","author":"苏辙","text":"澄潭下无底，将渡又安能。\n惯上横空木，轻生此寺僧。\n晓鱼闻考考，石塔见层层。\n不到殊非恶，他年记未曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻过岭","author":"苏辙","text":"山林瘴雾老难堪，归去中原荼亦甘。\n有命谁令终返北，无心自笑欲巢南。\n蛮音惯习疑伧语，脾病萦缠带岭岚。\n手挹祖师清净水，不嫌白发照毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻新居欲成二首 其二","author":"苏辙","text":"山连上帝朱明府，心是南宗无尽灯。\n过此攲危空比梦，年来瘴毒冷如冰。\n图书一笑宁劳客，音信频来尚有僧。\n梨枣功夫三岁办，不缘忧患亦何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻新居欲成二首 其一","author":"苏辙","text":"老罢子卿还属国，功成定远恨阳关。\n漂流岂必风波际，颠沛何妨枕席间。\n伏腊便应随俚俗，室庐闻似胜家山。\n因缘宿世非今日，赖有阴功许旋还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻题风水洞","author":"苏辙","text":"风送江湖满洞天，洞门可听入无缘。\n土囊郁怒声初散，石齿聱牙势未前。\n乐奏洞庭真跌宕，歌传帝所亦清便。\n何人隐几观遗韵，重使颜成问嗒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其五 高斋","author":"苏辙","text":"金陵佳处自无穷，使宅幽深即故宫。\n楼殿六朝遗烬后，江山百里旧城中。\n雨馀尚有金钿落，月出长窥粉堞空。\n看尽一城怀古地，兹游恨不与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其三 凤凰台","author":"苏辙","text":"凤鸟久不至，斯台空复高。\n何年种梧竹，特地剪蓬蒿。\n白水来无际，青山转几遭。\n南游且未返，江海共滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其四 天庆观","author":"苏辙","text":"兴废不可必，冶城今静祠。\n松声闻道路，竹色净轩墀。\n江近风云改，亭深草木滋。\n孤坟吊遗直，狂闇闵元规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其七 见江亭","author":"苏辙","text":"江水信浩渺，连山巧蔽亏。\n端能上崄绝，故自识津涯。\n灭没樯竿度，飘摇鹭羽迟。\n何人倚舟望，亦爱此峰危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其一 白鹭亭","author":"苏辙","text":"白鹭洲前水，奔腾乱马牛。\n亭高疑欲动，船去似无忧。\n汹涌山方坏，澄清练不收。\n中秋谁在此，明月满城头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其六 此君亭","author":"苏辙","text":"绿竹不可数，孤亭一倍幽。\n色分岩石润，梢出涧松修。\n雪节寒方见，春萌旱不抽。\n故山多此物，长恨未归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔武仲金陵九咏 其二 览辉亭","author":"苏辙","text":"城里最高处，坡陀见一城。\n山多来有绪，江远静无声。\n歌吹风前度，楼台雨后明。\n风光同楚蜀，聊此慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔教授武仲济南四咏 其二 北渚亭","author":"苏辙","text":"西湖已过百花汀，未厌相携上古城。\n云放连山瞻岳麓，雪消平野看春耕。\n临风举酒千钟尽，步月吹笳十里声。\n犹恨雨中人不到，风云飘荡恐神惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔教授武仲济南四咏 其一 环波亭","author":"苏辙","text":"南山迤逦入南塘，北渚岧峣枕北墙。\n过尽绿荷桥断处，忽逢朱槛水中央。\n凫鹥聚散湖光净，鱼鳖浮沉瓦影凉。\n清境不知三伏热，病身唯要一藤床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔教授武仲济南四咏 其三 鹊山亭","author":"苏辙","text":"筑台临水巧安排，万象轩昂发瘗埋。\n南岭崩腾来不尽，北山断续意尤佳。\n平时战伐皆荒草，永日登临慰病怀。\n更欲留诗题素壁，坐中谁与少陵偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孔教授武仲济南四咏 其四 槛泉亭","author":"苏辙","text":"连山带郭走平川，伏涧潜流发涌泉。\n汹汹秋声明月夜，蓬蓬晓气欲晴天。\n谁家鹅鸭横波去，日暮牛羊饮道边。\n滓秽未能妨洁净，孤亭每到一依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛国镇白云庄五咏 其二 平溪堂","author":"苏辙","text":"清溪似与隐君谋，故入堂前漫不收。\n盥手从今休汲井，浮觞取意便临流。\n花漂涧谷来应远，石激琴筝久未休。\n莫把朱栏强围绕，山家事事要清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛国镇白云庄五咏 其一 掬泉轩","author":"苏辙","text":"卜筑高深已有山，起居清润可无泉。\n穿墙白练秋声细，照屋清铜晓色鲜。\n已放鱼虾嫌跳掷，更除蘋藻任漪涟。\n只应明月中霄下，长共禅心相向圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛国镇白云庄五咏 其三 眺远台","author":"苏辙","text":"山似高人长远人，不登高处见无因。\n筑台土石无多子，照眼峰峦得许新。\n阵马奔腾时绝远，风涛舒卷忽无垠。\n白云自是逃名处，犹恐此中藏隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛国镇白云庄五咏 其四 濯缨庵","author":"苏辙","text":"临池濯足惜泉清，缨上无尘且强名。\n横木为桥便独往，结茅依岛类天成。\n往还渐少人谁识，寝食无为身转轻。\n有似三吴朱处士，钓鱼谁与话西征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王定国寄刘贡父","author":"苏辙","text":"度岭当年惜远行，过淮今日似前生。\n留连秋思江侵海，摇荡春心花满城。\n欲寄尺书慵把笔，偶闻佳句独含情。\n何时复看清虚会，醉听秦筝促柱声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王适新葺小室","author":"苏辙","text":"向日堂东一室存，竹为窗壁席为门。\n心如白月光长照，气结丹砂体自温。\n饭软莫嫌红米贱，酒香故取泼醅浑。\n他年一笑同谁说，伴我三年江上村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李公择赴历下道中杂咏十二首 泛清河","author":"苏辙","text":"南北无多水，崎岖未舍船。\n何时好霖雨，是处有通川。\n坟垄看书卷，兴亡指道边。\n苍茫半秋草，犹复较愚贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李公择赴历下道中杂咏十二首 将至桃园阻浅且风不得进","author":"苏辙","text":"卷帆倚棹浅河津，忆泛长江步步新。\n未免生涯寄风浪，不堪舟楫委埃尘。\n往来欲就沙囊堰，深浅时看举策频。\n一望云霓百忧集，应思平地隐居人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李公择赴历下道中杂咏十二首 桃园阻浅将易小舟一夜水大至复乘便风顷刻百里","author":"苏辙","text":"此生与物妄相仇，欲往长嫌苦见留。\n浅濑何知向人恶，涨溪岂复为公流。\n雨痕忽到工催客，风信初来转打头。\n举目汀洲都未改，忽添清兴满行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李公择赴历下道中杂咏十二首 宿迁项羽庙","author":"苏辙","text":"尺箠西来垄亩中，驱驰力尽众兵冲。\n旧封独守君臣义，故国长修俎豆容。\n平日军声同破竹，少年心事喜摧锋。\n锦衣眷恋多乡思，肯顾田家社酒醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李公择赴历下道中杂咏十二首 梁山泊","author":"苏辙","text":"近通沂泗麻盐熟，远控江淮粳稻秋。\n粗免尘泥污车脚，莫嫌菱蔓绕船头。\n谋夫欲就桑田变，客意终便画舫游。\n愁思锦江千万里，渔蓑空向梦中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和青州教授顿起九日见寄","author":"苏辙","text":"岁月飘然风际烟，紫萸黄菊又霜天。\n莫思太室杉松外，且醉青州歌舞前。\n杯酒追欢真一梦，天涯回望正三年。\n近来又欲东观海，听说毛诗雅颂篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柳子玉共城新开御河过所居墙下","author":"苏辙","text":"卜筑共山功欲成，新河入县巧相萦。\n谁将畚锸千夫力，添上园林一倍清。\n生长鱼虾供晚馔，浮沉鹅鸭放春声。\n为邻有意非今日，丐我馀波伴濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柳子玉地炉","author":"苏辙","text":"凿地泥床不费功，山深炭贱火长红。\n拥衾熟睡朝衙后，抱膝微吟莫雪中。\n宠辱两忘轻世味，冰霜不到傲天工。\n遥知麻步无人客，寒夜清樽谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柳子玉纸帐","author":"苏辙","text":"夫子清贫不耐冬，书斋还费纸重重。\n窗明晓日从教入，帐厚霜飙定不容。\n京兆牛衣聊可藉，公孙布被旋须缝。\n吴绫蜀锦非嫌汝，简淡为生要易供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和胡教授蒙太守策试诸生","author":"苏辙","text":"著籍初同阙里多，采芹先致鲁风和。\n欲将大策观胸胆，尽召中堂列雁鹅。\n终日正言何忌讳，几人馀力尚委蛇。\n岂惟太守知为政，仍见先生善设科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁壬子八月于洛阳妙觉寺考试举人及还道出嵩少之间至许昌共得大小诗二十六首 和顿主簿起见赠二首 其二","author":"苏辙","text":"一锁楼中暗度秋，微官黾勉未能休。\n笑谈容我聊纾放，文字凭君便去留。\n杯酒淋漓已非敌，清诗窈眇更难酬。\n东归犹得联征骑，同上嵩高望九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熙宁壬子八月于洛阳妙觉寺考试举人及还道出嵩少之间至许昌共得大小诗二十六首 和顿主簿起见赠二首 其一","author":"苏辙","text":"声病消磨只古文，诸儒经术斗纷纭。\n不知旧学都无用，犹把新书强欲分。\n老病心情愁见敌，少年词气动干云。\n搜贤报国吾何敢，欲补空疏但有勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和强君瓦亭","author":"苏辙","text":"君为魏博三年客，日有江湖万里心。\n暂得野亭留马足，强循疏柳步堤阴。\n无人携手共吴语，得意摇头时越吟。\n何日东郊过微雨，并骑鞍马去同寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏竹二首 其二","author":"苏辙","text":"南邻竹甚茂，门巷不容宾。\n悬印君当往，囊金我患贫。\n翠旌稍乱起，犀角笋初匀。\n不惜图书卖，端来作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏竹二首 其一","author":"苏辙","text":"湖滨宜草木，修竹可三寻。\n廛居多野思，移种近墙阴。\n及尔迷未醒，方予热正侵。\n无嫌不逮本，地薄肯成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏霜二首 其一","author":"苏辙","text":"江南雪不到，霜露满山村。\n纸被欺毡厚，茅檐笑瓦温。\n何曾凝沼渌，有意隔朝暾。\n底日身无事，高眠不出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏霜二首 其二","author":"苏辙","text":"清霜欺客病，乘夜逼窗扉。\n坐睡依炉暖，细声闻叶飞。\n蕉絺空满箧，砧杵旋催衣。\n起看庭前草，松筠未觉非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 十日南归马上口占呈同事","author":"苏辙","text":"南辕初喜去龙庭，入塞犹须阅月行。\n汉马亦知归意速，朝旸已作故人迎。\n经冬舞雪长相避，屈指新春旋复生。\n想见雄州馈生菜，菜盘酪粥任纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]