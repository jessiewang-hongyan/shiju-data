[{"title":"偈颂一百四十二首 其一○五","author":"释广闻","text":"写王公符，用商君令。\n师多鬼乱，药多病甚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○六","author":"释广闻","text":"闹市无人，龙门有客。\n漆桶相揩，浑无轨则。\n一时辊入草窠中，尽西湖之西，北山之北。\n山上鲤鱼，南山白额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○七","author":"释广闻","text":"一法若有，脱罗笼处万象平沉。\n万法若无，没遮护时红尘满地。\n如孤云行空，如寒月即水。\n拟从于此觅云山，何啻白云千万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○八","author":"释广闻","text":"水清月现，动随影转。\n水清月不现，背手新罗箭。\n踏翻水碗便行，堕在解脱深坑。\n三大老，总似闭目中秋坐。\n只知第二月，如何是第一月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○九","author":"释广闻","text":"相逢不拈出，犹是东山左边底。\n举意便知有，又是方庵外边事。\n南山快便难逢，声东击西。\n持方入圆，贵要诸人知有。\n一点成龙两处全，何如兄弟添十字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一○","author":"释广闻","text":"九日已无黄栗糕，十日依然有黄菊。\n何须九日记重阳，黄花开时意自足。\n东篱若谓见南山，鹞子已过新罗国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一一","author":"释广闻","text":"日南长至，吉无不利。\n冻破泥团，花开碓嘴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一二","author":"释广闻","text":"祖师意，百草头。\n衲僧眼，拄杖头。\n得路塞路，看楼打楼，须知众穴一毫收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一三","author":"释广闻","text":"大辩若讷，大巧若拙。\n如说而行，如行而说。\n只如行说不到时如何，潇洒溪山，一天风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一四","author":"释广闻","text":"唱新丰曲，风清古格。\n声前转调入无生，恰应云门腊月拍。\n无影树下，古渡头边。\n要知东谷末后句子，须待洞水逆流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一六","author":"释广闻","text":"忽地晴天霹雳声，禹门三级浪滂澎。\n几多头角成龙去，虾蟹徒劳努眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一七","author":"释广闻","text":"一句语具三玄门，一玄门具三要路。\n直下重重透彻，许你纵横十字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一八","author":"释广闻","text":"一升三合，拄杖头边。\n万水千山，草鞋跟底。\n未言先领，谁家灶里无烟。\n撩起便行，是处井中有水。\n莫道空来又空去，许多途路不相辜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一一九","author":"释广闻","text":"花添锦上几重重，针劄将来不露锋。\n佛手分明遮不得，盖天盖地显吾宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二○","author":"释广闻","text":"朝看东南，暮看西北。\n一见便见，一得永得。\n灵云谩道见桃花，临济未是白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二一","author":"释广闻","text":"秘魔擎杈，鲁祖面壁。\n官路不行，拗曲作直。\n一日不作，一日不食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二二","author":"释广闻","text":"目前机，量外事。\n巢知风，穴知雨。\n百鍊钢，千钧弩。\n拟不拟，箭后路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二三","author":"释广闻","text":"世界恁么热，今日何似昨日。\n庭柯一叶落，前秋不觉后秋。\n通方达士未举先知，不是俊流徒劳啖啄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二四","author":"释广闻","text":"拨开若耶溪上云，高挂峨嵋峰顶月。\n大用不存轨则，瞎人何止一城。\n无毫发间，无前后际。\n只今吴越令行，恼乱春风未已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二五","author":"释广闻","text":"有则水里月，无则形名兆。\n即此是达磨眼睛，亦谓之衲僧顶门窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二六","author":"释广闻","text":"东去西去，脚头脚尾没回互。\n南来北来，铁壁银山尽豁开。\n拟即失，动即乖。\n试看杨岐跨驴，何似玄沙斫牌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二七","author":"释广闻","text":"吾佛舒广长舌相，不即此座亦不离。\n尔时宝积诸长者，持七宝盖而献佛。\n如庵道人道机熟，今亦即色以明心。\n攒花簇锦出新好，而以组绣作佛事。\n一一针孔一世界，一一花叶一如来。\n森罗万象影重重，莫不一法之所印。\n此座非高亦非广，此被非阔亦非狭。\n舒即大千悉弥满，收入微尘不迫窄。\n譬如随色摩尼珠，是被光明亦如是。\n昼夜常转如是轮，须弥灯王为作證。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二八","author":"释广闻","text":"燃无尽灯，示无尽意。\n藕丝窍里逗须弥，蟭螟眼中放夜市。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一二九","author":"释广闻","text":"一句绝离微，浑崙无缝罅。\n善财七日寻觅不得，赵州五年分疏不下。\n灵山今日，快便难逢，为通一线。\n六月卖松风，人间恐无价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三○","author":"释广闻","text":"云门以势欺人，雪窦抑强扶弱。\n捡点将来，总是外道见解。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三一","author":"释广闻","text":"灵山又见一夏，不说陈年旧话。\n青州衫重七斤，庐陵米作么价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三二","author":"释广闻","text":"海外同归用亦同，灵山有此两云峰。\n万人丛里高标上，只贵重论盖代功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三三","author":"释广闻","text":"圆处圆还缺，缺处缺还圆。\n人争看今日，月只是常年。\n南泉拂袖便行，鼓山拂袖归众。\n说甚衲僧门下，直是重处偏坠，薄处先穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三四","author":"释广闻","text":"一年复一年，一冬复一冬。\n海水知天寒，枯桑知天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三五","author":"释广闻","text":"智门莲花，赵州庭柏。\n不用低头，思量难得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂四十一首 其三十四","author":"释普宁","text":"吾本来兹土，传法救迷情。\n一花开五叶，结果自然成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三七","author":"释广闻","text":"文殊为众竭力，世尊满口含霜。\n千言万语无人会，又逐流莺过短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三八","author":"释广闻","text":"机轮活脱走珠盘，妙处都卢在笔端。\n竖起依然还放下，灵锋宝剑倚天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一三九","author":"释广闻","text":"四月十五，灵山直举。\n捻聚处放开，放开处捻聚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一四○","author":"释广闻","text":"佛子住此地，踏著依前不相似。\n即是佛受用，切忌唤钟而作瓮。\n经行及坐卧，常在于其中。\n鹤有九皋难翥翼，马无千里谩追风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一四一","author":"释广闻","text":"天寒人寒，风动幡动。\n与么与么，大难大难。\n一二三四五，放待冷来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其一","author":"释广闻","text":"乘流而行，过径即止，犹是时人升降处。\n只今脚后脚前，通汝活路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其二","author":"释广闻","text":"捻聚放开，放开捻聚。\n黄面瞿昙，无回避处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其三","author":"释广闻","text":"一缕烟盖天盖地，一滴水为雨为霖，谁见龙王宫殿深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其四","author":"释广闻","text":"者里是吾父翁券内事，纵横杀活，妙在不传。\n赵州亲见老南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其五","author":"释广闻","text":"挂域中日月，立方外乾坤。\n从至尊至贵中得来，向无欲无依中流出。\n云行雨施，三草二木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其六","author":"释广闻","text":"法王法令，头正尾正。\n只如世尊便下座时如何，路入桃源深更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其七","author":"释广闻","text":"一有多种，二无两般。\n花根本艳，虎体元斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其八","author":"释广闻","text":"天生有大福德人，与佛同时同现瑞。\n是知心与佛心同，母仪天下同化育。\n如春及物春无迹，如月印水月无痕。\n天人中来道机熟，应身摩耶显慈力。\n与天同寿福元元，万年密赞无为治。\n山林演此无为法，是亦名为报恩者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其九","author":"释广闻","text":"和气祥光霭九垓，新阳端自日边回。\n龙峰高处君恩重，先放花从铁树开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十","author":"释广闻","text":"大小黄面瞿昙老，了了了时何曾了。\n因忆明星出现时，夜来霜重知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十一","author":"释广闻","text":"雪峰据令而行，者僧分疏不下。\n雪窦不曾与人葛藤，径山道得也得也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十二","author":"释广闻","text":"德山但知草偃风行，不觉通身泥水。\n者僧只见溪回路转，不知身在桃源。\n径山与么批判，一任诸方捡责。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十三","author":"释广闻","text":"落赖家风，今日重举。\n草本多同，西天此土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十四","author":"释广闻","text":"分圆照灯，下炎天雪，活弄南山鳖鼻蛇。\n验尽英灵，提得藕丝牵玉象，不存途辙。\n只么横身异类行，踏断石桥成两截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十五","author":"释广闻","text":"看锢■，著生铁。\n因甚云门心肝五脏，被者僧一搂搂尽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十六","author":"释广闻","text":"人间八月二十五，洞山此日离查渡。\n棒头敲出玉麒麟，江西湖南便与么。\n径山闹里飏碌砖，谁道今人不如古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十七","author":"释广闻","text":"溪上烟波远，壶中日月长。\n谁知冷灰里，九转透瓶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂十八首 其十八","author":"释广闻","text":"以蜡人为验，病翼栖芦。\n以铁弹子为验，困鳞止泺。\n径山不然，一箭双雕落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种竹","author":"释广闻","text":"香严活葬在南阳，知是所知忘未忘。\n猛虎不应餐伏肉，听教风雨细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归蜀","author":"释广闻","text":"曾经巴峡听啼猿，万想千思举不全。\n一万里风吹梦转，月明人上锦江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送昭书记归径山","author":"释广闻","text":"错下凌霄恨不忘，百城烟水漫茫茫。\n思量六十蒿枝拂，铁打心肝也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"看潮","author":"释广闻","text":"怒雷声撼海门秋，知是几家人上楼。\n眼眼尽随波浪转，全潮端的属谁收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"褙语录","author":"释广闻","text":"路不赍粮笑复歌，三更月下入无何。\n太平谁整闲戈甲，王库初无如是刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送愚庵和尚赴资福","author":"释广闻","text":"十分消息在竿头，片甲纤鳞未足收。\n怪得一番浮子动，西湖明月上金钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古剑","author":"释广闻","text":"干戈罢却复何言，六国风清令不传。\n犹有当时太平意，尘埋三尺髑髅前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花翁","author":"释广闻","text":"传来五叶到渠侬，略露些儿便不同。\n自是普通年远事，莫将一样看春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送祖上人归蜀","author":"释广闻","text":"只因月下瓮吞蛇，赢得南来两眼花。\n换手槌胸应有日，知他死款属谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送布袋像与妙峰和尚","author":"释广闻","text":"百千诸佛竖降旗，大法犹悬一缕丝。\n问讯率陀老慈氏，只是恰是下生时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放牛","author":"释广闻","text":"呜咿声断笛横时，满目春风不自知。\n脚后脚前者些子，入渠群队听渠疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拜大梅常禅师塔","author":"释广闻","text":"声前借路谩经过，望却梅林自倒戈。\n八十四人屙漉漉，阿师犹更带誵讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上安晚郑丞相为免坟地","author":"释广闻","text":"黄檗山中话裴相，独龙冈上忆舒王。\n相公留得溪边寺，千古佳名在郑乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归蜀","author":"释广闻","text":"脱得南方驴马群，相逢无法可呈君。\n看侬百衲袈裟上，半是吴云半楚云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠蜀相士蓑衣道人","author":"释广闻","text":"梦入东南万里馀，阅人多处定何如。\n绿蓑又裹春风去，未必黄金换得渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送兰与樗寮张寺丞","author":"释广闻","text":"绿叶丛丛间紫茎，芳心细细为谁倾。\n不如去入芝兰室，凑得仙家一段清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无梦","author":"释广闻","text":"为人彻困有谁知，眨得眼来话已迟。\n满地如今正闹在，听渠寐语住何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿天衣偶成","author":"释广闻","text":"过雁曾无影可留，不妨寒水向东流。\n千峰一夜撑空立，旧事惊翻尽底休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觉海诸善友整经","author":"释广闻","text":"好风晴日满溪山，又到桃源尽处还。\n流水落花拦不住，几多春色在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑关","author":"释广闻","text":"吹毛不动定誵讹，遍地茫茫尽倒戈。\n但见清风生阃外，知恩终少负恩多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]