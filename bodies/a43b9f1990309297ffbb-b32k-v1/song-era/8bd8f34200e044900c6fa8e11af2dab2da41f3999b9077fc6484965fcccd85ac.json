[{"title":"第十七国师塔样颂","author":"释义青","text":"古塔涌圣迷，云笼龙凤失。\n香风半夜沉，实殿无知识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十八吸尽西江颂","author":"释义青","text":"父母旷来别，得奉当竭力。\n木人半夜言，莫使外人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第十九僧问长沙颂","author":"释义青","text":"苔殿重重紫气深，星分辰位正乾坤。\n金轮不御阎浮境，岂并诸侯宝印尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十云岩南泉颂","author":"释义青","text":"金刚际下古髑髅，几被人踏血溅空。\n明月任从君自掬，寒松那弃白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十一赵州吃茶颂","author":"释义青","text":"见僧便问曾到否，有言曾到不曾来。\n留坐吃茶珍重去，青烟暗换绿纹苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十二大随乌龟颂","author":"释义青","text":"一家有事百家忙，春暖才回草自长。\n东岭月分西涧水，菊残犹自候重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十三南泉斩猫颂","author":"释义青","text":"临险推人事要知，求财先自露针锥。\n钓鱼尽说谙风势，及至风来波路迷。\n潦倒赵州虽好手，钟鸣斋后赴来迟。\n要知大像嘉州路，铁牛镇断陕关西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十四云居居山颂","author":"释义青","text":"突屼嵯峨万仞横，四边无路不通行。\n自古两轮光不到，夜深王老人西岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十五丹霞烧佛颂","author":"释义青","text":"古岩苔闭冷侵扉，飞者惊危走者迷。\n夜深寒热汀洲火，失晓渔家辄自疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十六鸡栖凤巢颂","author":"释义青","text":"无伴石人衣入山，云笼红顶绿衣寒。\n喝开劫兆三峰顶，捧出金栏对日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十七疏山答佛颂","author":"释义青","text":"养子方知在仁慈，亲言无味外人疑。\n欲穷沧浪深深处，听取渔家辄莫迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十八归根得旨颂","author":"释义青","text":"家破人亡何所依，无心无绪话求归。\n十年忘尽来时路，暂忆些儿总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第二十九问夹山境颂","author":"释义青","text":"月皎青松鹤梦长，碧云丹桂挂羚羊。\n严高碧仞千峰雪，石笋生条半夜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十曹山出世颂","author":"释义青","text":"月隐青山瑞气高，梧藏丹凤觑无寥。\n无端石马潭中过，惊起泥龙之海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十一无隐身处颂","author":"释义青","text":"苔殿烟收紫气旋，拱班宸幄退尧年。\n凤楼不宿桃源客，岂并金光瞩汉天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十二风穴古曲颂","author":"释义青","text":"古岩月色锁重云，枯木迎芳晓带春。\n昨夜星河转南斗，金鸟随凤过天轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十三投子劫火颂","author":"释义青","text":"天地为炉万物焦，石人驾浪渡云霄。\n风生半夜霜残重，月落水寒碧鬓凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十四米胡间悟颂","author":"释义青","text":"碧岫峰头借问人，指山穷处未安身。\n虽然免得重阳令，争似灵苗不犯春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十五镜清有言颂","author":"释义青","text":"寻常爱客恨无来，及至人来懒话陪。\n空卧早知眠不当，虚劳红焰落寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十六云门明教颂","author":"释义青","text":"等闲垂借问端由，不负平生尽吐酬。\n竭力为人须是彻，方知茶味解人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十七云居六户颂","author":"释义青","text":"春到石人视远山，莺啼花木碧波闲。\n须知云外岩松瑞，千古迎风任岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十八风穴黄龙颂","author":"释义青","text":"无价明珠暗处悬，夜深将把木人穿。\n谁知却被泥牛见，吞入红霞碧浪渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第三十九雪峰南际颂","author":"释义青","text":"送客随家丰俭施，尽情为饯免生疑。\n却蒙惠重过相赠，敛手遥别向暮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十大士不起颂","author":"释义青","text":"梁国令他魏国愁，渡江投水暗随流。\n虽然寸土居无动，争奈双林树半秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十一首山亲切颂","author":"释义青","text":"日暮阴云郊野深，重阳到后菊花新。\n不因西峤残冰尽，争得东山一带春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十二云门糊饼颂","author":"释义青","text":"祖佛超谈问作家，困来宜吃建溪茶。\n重阳日近开金菊，深水鱼行暗动沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十三亲传底事颂","author":"释义青","text":"亲伸端的向君言，莫比流沙少室传。\n昨夜雁回双岭后，谢家人立月明前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十四板齿生毛颂","author":"释义青","text":"九年少室自虚淹，争似当头一句传。\n板齿生毛犹可事，石人踏破谢家船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十五问法身宝颂","author":"释义青","text":"松生岩畔鹤停稳，凤出丹山鸾并群。\n面壁尚亏庵外事，净名何苦太言论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十六日里看山颂","author":"释义青","text":"坦然曾问老师安，争似韶阳一句传。\n日里华山仙掌露，夜深猿叫月当轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十七龙宿凤巢颂","author":"释义青","text":"相逢借问众僧糜，莫比庵围香饭施。\n紫气夜随丹凤转，金龙晓缠月中枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十八巴陵鸡鸭颂","author":"释义青","text":"同别祖意问端由，便将元价与他酬。\n丝纶夜静人垂钓，晓得金乌带月收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第四十九投子凡圣颂","author":"释义青","text":"水出昆崙浪接天，天高地下秀林峦。\n禅床略下云山断，凡圣无踪海岳寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十问赵州道颂","author":"释义青","text":"知道还他潦倒翁，亲言相指自匆匆。\n关山路远重须去，一径长途君任通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十一仰山山河颂","author":"释义青","text":"一句称提万象分，摩竭空自掩重门。\n当初衲子微开眼，插箸炉边当火焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十二首山菩提颂","author":"释义青","text":"问路穷途拟进程，绿杨莺语送行人。\n牌标五里向君说，莫道当年不指陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十三岩头片帆颂","author":"释义青","text":"云暗西岩东岭明，汀洲南面起笛声。\n天光睡重和衣润，莺啭高枝柳带春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十四风穴麈鹿颂","author":"释义青","text":"禁殿重闱视听危，侧思偏立绛纶垂。\n汉乡云断汀洲迥，岭暮猿啼孤月随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十五投子三身颂","author":"释义青","text":"三身说法问端由，弹指轻轻海岳收。\n金锁塔开红日像，夜深人笑碧峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十六曹溪意旨颂","author":"释义青","text":"重峰层仞插寒空，塔锁深云势莫穷。\n千古松声来有韵，万年溪水去无踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十七雪峰长蕖颂","author":"释义青","text":"雪峤层层翠锁深，风生寒岫结重云。\n夜来丹凤冲霄汉，听晓樵人逐雁群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十八广教冀州颂","author":"释义青","text":"禁幄重闱苔藓深，金铃不动侍无人。\n谁携班杖来相问，报说东园麦拢青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第五十九风穴皮裘颂","author":"释义青","text":"亲切曾伸问老翁，东山歌唱北山吟。\n弄潮须是江吴客，别语还他汉地人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十僧问首山颂","author":"释义青","text":"未语难明迷悟情，发言方表赤心人。\n只知进步求名玉，争信灵苗不受春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十一首山此经颂","author":"释义青","text":"水出昆崙山起云，钓人樵父昧来因。\n只知洪浪岩峦阔，不肯抛丝弃斧声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十二赵横高坡颂","author":"释义青","text":"江山历尽几施功，方得逢人话昔同。\n春到洞庭无壁岸，鸟啼西岭月生东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十三九峰龟毛颂","author":"释义青","text":"等闲不语未逢人，语便伤直似太亲。\n不顾火中鸾凤息，惊他石虎暗生嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十四临济吹毛颂","author":"释义青","text":"剑藏匣冷逼人寒，拟问栖迟过岭南。\n更欲进前求退后，悲风千古绕溪潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十五大随證龟颂","author":"释义青","text":"六耳同谋事可成，直言方表赤心人。\n室中灯焰谁来拨，白发童儿两鬓新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十六瑞岩不出颂","author":"释义青","text":"贵异天然应有时，六宫春苑少相随。\n星攒半夜天轮迥，烛晓东闱帘静垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十七文殊成劳颂","author":"释义青","text":"驰书才去返匆匆，一足垂酬继后踪。\n坐久成劳谁委悉，红炉点雪自相通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十八蓝市廛颂","author":"释义青","text":"日出升空高下周，昆崙源派入川流。\n春山云逗风无尽，雁去回南天地秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第六十九洛浦藏教颂","author":"释义青","text":"毕钵岩花晓带春，香风时结鹫峰层。\n须知玉像瓶中塔，别有辉天鉴地灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十一芭蕉好恶颂","author":"释义青","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十二天彭当户颂","author":"释义青","text":"白云时映旧山青，竹锁薄烟露几茎。\n虚室夜寒秋月迥，雁回遥听可三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十三禾山打鼓颂","author":"释义青","text":"布毛拈起费人言，争似禾山一句传。\n打鼓一声喧宇宙，冰寒千丈忽生莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十四黄连声前颂","author":"释义青","text":"空劫前时旷路闲，声前无句信入难。\n欲穷沧浪白云曲，且看石人露半颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十五资福圆相颂","author":"释义青","text":"一曲两曲深夜弹，松风和雨遇前山。\n可怜卞玉离荆岫，谁是知音却取还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十六崇福宽廓颂","author":"释义青","text":"宽廓言时不犯舌，清风高韵碧云斜。\n石人贪话西峰事，不觉东岩起雾遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十七梁山道场颂","author":"释义青","text":"路穷岸仞问山翁，别指岩西岭近东。\n拟进雾垂岚色重，回头顶见太阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十八百丈奇特颂","author":"释义青","text":"巍巍峭迥出云霄，顶锁水寒势外遥。\n坐观四望烟笼处，一带青山万水潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第七十九历村煎茶颂","author":"释义青","text":"煎茶未了人来问，拈起茶匙呈似他。\n当初若遇收燕手，性命难存争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十文殊九曲颂","author":"释义青","text":"问法穷因归何处，黄河透过碧波澜。\n须知云外千峰上，别有灵松带露寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十一雪峰典座颂","author":"释义青","text":"满钵盛来一物无，岂同香积变珍苏。\n日月并轮长不照，木人舞袖向红炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十二德山上堂颂","author":"释义青","text":"金轮微动吼乾坤，稍逆金躯草卧身。\n更欲发言来拟问，悲风吹尽四绝邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十三兴化军旗颂","author":"释义青","text":"离城别阁暗愁时，月落星分信马蹄。\n风扫晓霜林木迥，夜深汀岸火生微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十四长庆不疑颂","author":"释义青","text":"展手之时万仞摧，枯河无水月无来。\n若疑别问庞居士，石女黄梅谁共陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十五洞山茎茆颂","author":"释义青","text":"野火烧时越转新，至今烟焰雨难霖。\n旱地红莲遮日月，无根树长翠成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十六国师侍者颂","author":"释义青","text":"国师唤侍者，重言不当吃。\n他耳又不聋，自又无处雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十七幽栖上堂颂","author":"释义青","text":"蓦路相逢借问由，寸心莫便与他酬。\n虽然重担教人待，终是惭颜暗地羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十八答麻三斤颂","author":"释义青","text":"三年一闰大家知，也有颟顸不记时。\n昨夜雁迥沙塞冷，严风吹绽月中枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第八十九北斗藏身颂","author":"释义青","text":"南岳峰高北岳低，行人泣泪两迟疑。\n火星昨夜移牛斗，照见西瞿人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十凤楼前颂","author":"释义青","text":"深宫禁殿隔重闱，帘静檐楹紫气垂。\n苔地不通朝请近，家人指路莫迟疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十一仰山插锹颂","author":"释义青","text":"沩山问处少知音，插地酬时佛祖沉。\n踏倒玄沙傍不肯，免教苍翠带春深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十二法眼慧超颂","author":"释义青","text":"巇崄行时问路难，有人相指北村南。\n长安无限人来往，几个无铃遇得关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十三赵州勘婆颂","author":"释义青","text":"灵龟未兆无凶吉，变动临时在卜人。\n路头问破谁人委，王老东村努目嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十四多子塔前颂","author":"释义青","text":"于道无所證，方通万法路。\n或明或暗行，不慎亦不护。\n月来松色寒，云去青山露。\n今古天台桥，几人能得度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"第九十五大阳玄旨颂","author":"释义青","text":"轻轻人问玄中旨，便吐肝肠说与他。\n木人暗皱双眉处，石女多言争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]