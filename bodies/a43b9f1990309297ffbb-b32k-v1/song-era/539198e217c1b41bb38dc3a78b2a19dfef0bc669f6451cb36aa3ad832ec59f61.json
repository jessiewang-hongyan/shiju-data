[{"title":"题浯溪中兴碑","author":"赵汝谠","text":"苍崖插浯溪，清涨湿元颂。\n费墨合屋高，千年此安用。\n鲸翻天宝末，云滃朔方众。\n还都迎上皇，呜咽抱馀痛。\n两宫重宴乐，万国尽朝贡。\n当时纪成功，小雅见微讽。\n颜公发劲画，金玉相错综。\n我于碑刻间，众羽得孤凤。\n艰危人物难，忠烈鬼神重。\n摹取挂野堂，英风凛生栋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠景建将入都赠别","author":"赵汝谠","text":"子先文章宗，秀种凌孔翠。\n观风多儒郡，籍籍罕与辈。\n客远纡劳思，交新惬清会。\n说诗延秋色，造极超古对。\n敏识入误领，玄功谢彫绘。\n颇云幼把笔，涛涌亦川汇。\n中探阴符髓，意蹑海蟾背。\n悄然忽坐愁，穷老少所遂。\n雄都始旋轸，上国专结佩。\n八纮张云罗，局士绳墨内。\n名场沾童肤，奇质委蒿艾。\n卿侯雅如赏，荣爵宁尔爱。\n早拜王命归，声明耀群昧。\n吾衰愧尸职，笺劾力自退。\n奋身登金台，农野甘秉耒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"囊山寺","author":"赵汝谠","text":"松门包土囊，石径驻尘鞅。\n征途悄愁辛，意豁金利爽。\n鼓钟殷林际，堂殿攀磴上。\n有亭依后冈，极眺一何朗。\n海光混苍碧，云思浮渺漭。\n良久空雨霏，风泉谷交响。\n岩龛寄禅迹，古佛瞻刻像。\n更欲步层巅，荒烟晚迷罔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵汝谠","text":"先朝怀族远，平世责人深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵汝谠","text":"人家插柳春将过，时节浇松老未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重建神秀楼追和忠定公韵","author":"赵汝遇","text":"峨峨城南楼，缔创知几时。\n楼前中津水，潮来复潮归。\n眷此云海区，襟带东西溪。\n图牒考往事，杳杳孤鸿飞。\n传闻昔芜城，陋若枳棘篱。\n鼎新赖宗衮，欲与千年期。\n纪事属东莱，字字皆吾师。\n甲子甫一周，孙枝继成规。\n壁垒访遗迹，阑干纳馀晖。\n农隙既閒暇，溟波日平夷。\n班春布宽大，谕俗无浇漓。\n乔木有世臣，惟有乃似之。\n此段信奇事，今昨何是非。\n指顾旧观还，略不烦文移。\n落成当元夜，月华流客衣。\n前作信高韵，新篇实英词。\n却笑岘山语，登临何足悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石桥","author":"赵汝愚","text":"法身遍满三千界，影现天台水石间。\n我欲直从心地见，来看磊磈听淙潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘阮庙","author":"赵汝愚","text":"当年刘阮意何穷，莫谓仙凡事不同。\n解到琼台双阙下，遥知道骨与仙风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致爽轩","author":"赵汝愚","text":"浓阴夹道水流渠，吹尽残花不复馀。\n唯有范家千亩竹，青青依旧色侵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题竹赠卫清叔之潭州","author":"赵汝愚","text":"飔飔忽见青鸾尾，扫遍翠崖冈上头。\n昨夜月明仙子过，玉笙吹彻万山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同林择之姚宏甫游鼓山","author":"赵汝愚","text":"几年奔走厌尘埃，此日登临亦快哉。\n江月不随流水去，天风直送海涛来。\n故人契阔情何厚，禅客飘零事已灰。\n堪叹世人祇如此，危栏独倚更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金溪寺梅花","author":"赵汝愚","text":"金溪有梅花矗矗，平生爱之看不足。\n故人爱我如爱梅，来共寒窗伴幽独。\n纷纷俗子何足云，眼看桃李醉红裙。\n酒狂耳热仰天笑，不特恶我仍憎君。\n但令梅花绕僧屋，梅里扶疏万竿竹。\n相逢岁晚两依依，故人冰清我如玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"神秀楼落成","author":"赵汝愚","text":"鲁侯作南门，春秋书不时。\n嗟予春暮来，复遣秋暮归。\n岩岩龙固山，迢迢括苍溪。\n孤城煨烬馀，栋宇烟尘飞。\n悠悠客行路，一夕固藩篱。\n城中十万家，奠枕将何期。\n宾僚贾马俦，邑下循良师。\n经营有馀地，所就踰前规。\n西风散黄菊，天宇澄清晖。\n浩歌留飞仙，击鼓惊冯夷。\n分题杂险怪，醉墨翻淋漓。\n别来册府英，往往梦见之。\n恍然今夕游，似梦疑复非。\n夜深灯火阑，露下星斗移。\n父老呼童儿，挽裳或褰衣。\n来饮史君酒，听歌史君词。\n有泪不忍弹，恐遂行人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送学士汪大猷归鄞","author":"赵汝愚","text":"尚书天官贵，持经侍帷幄。\n青冥欲无际，白首非故约。\n连樯动南浦，父老望岩壑。\n下车入里门，执手问欢乐。\n十年几风雨，寒鸡叫屋角。\n勤劳毕吾分，帝赉出宠渥。\n殊适奉香火，禁直连六阁。\n遂令宣室思，从今问晦朔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 西湖","author":"赵汝愚","text":"水月光中，烟霞影里，涌出楼台。\n空外笙箫，云间笑语，人在蓬莱。\n天香暗逐风回。\n正十里、荷花盛开。\n买个扁舟，山南游遍，山北归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵汝愚","text":"早晚扁舟会东下，莫占衡岳问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵汝愚","text":"寒雪冥濛外，山云显晦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与同年陈公过山亭","author":"赵汝暖","text":"青苔满地护阶阴，尘俗曾无半点侵。\n林鸟避人穿谷去，野猿寻果出云深。\n千竿翠竹依檐立，一对黄鹂入树吟。\n昼静风清诗思罢，凭阑倾耳听松琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会饶伯舆徐子荐徐立大三高士一首","author":"赵汝腾","text":"英英奇节东州彦，凛凛清风南浦豪。\n更有馀干饶有道，建安堂上聚三高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因遣乡书赠姜山嗣师","author":"赵汝腾","text":"近市依湖十里间，扁舟朝往暮能还。\n莫教老圃翻锄尽，留我他年葬骨山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次徐径坂衡阳使君韵示林敬则","author":"赵汝腾","text":"千仞冈头一振衣，共嗟凤德卧郊扉。\n近锄萧艾知天意，会见朝阳露欲晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐径坂衡阳使君韵题渔庄烟雨","author":"赵汝腾","text":"列子御风旬五日，庄周称寿八千秋。\n归欤烟雨濛濛景，萼集班衣剩劝酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韵诇徐径坂","author":"赵汝腾","text":"圣断锄奸不大声，传闻侧席迟幽人。\n人今天民之先觉，幡然风俗还振振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋词","author":"沈说","text":"雨放凉飙晚复晴，小窗人亦共秋清。\n月华网在蛛丝上，错认疏帘挂水晶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江墨庄 其二","author":"赵汝腾","text":"寄语玉柯贤太守，万间精舍有诗盟。\n迩来曾践斯言否，此事须公剧力成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江墨庄 其一","author":"赵汝腾","text":"径坂仙翁名盖代，得君胶法喜临池。\n鸡林鼠岛皆知重，尔亦声华万古垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈善世 其二","author":"赵汝腾","text":"抱琴几宿滞秦溪，多谢常丞寄近诗。\n细咀绝无烟火气，其人可与溯濂伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈善世 其三","author":"赵汝腾","text":"不须远远苦求师，恭敬渊源可细推。\n归路瑞安逢二戴，为予再四说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈善世 其一","author":"赵汝腾","text":"似闻久客沧洲馆，曷不相从早数年。\n老我一丘事耕钓，劳君千里度山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭松溪簿来承绝句以紫霞翁见号因自号为紫霞翁成二绝走呈径坂 其二","author":"赵汝腾","text":"南涧当年浚紫洲，我今取号自虚舟。\n倚栏惆怅青霞远，何日从君飞佩游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭松溪簿来承绝句以紫霞翁见号因自号为紫霞翁成二绝走呈径坂 其一","author":"赵汝腾","text":"名斋取义本凡庸，借屋蓬莱理钓篷。\n特为紫阳访霞紫，临流一笑就称翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见孟博送仲久诗章辄题二绝代赠 其一","author":"赵汝腾","text":"扁舟乘兴山阴道，春半园林雪未消。\n便解貂裘从我在，小窗幽寂共箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见孟博送仲久诗章辄题二绝代赠 其二","author":"赵汝腾","text":"且看青山覆白云，悠悠世事谩知闻。\n扁舟却绝长江去，回首红尘路欲分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄仲节金华牧二首 其二","author":"赵汝腾","text":"传闻议论异柯山，辨难何妨莫失欢。\n试取景仁与君实，中和问答几书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄仲节金华牧二首 其一","author":"赵汝腾","text":"犹记衰翁佩印初，曾将四学劝群儒。\n只今郡守西山后，好勉人人诵吕朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李颐老","author":"赵汝腾","text":"易说刊成未，心传自法云。\n寄声扬舶使，一力主斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐左司 其二","author":"赵汝腾","text":"人皆山斗瞻吏部，谁敢文章近左司。\n君看玉池金鲫句，尽刊腥腐带仙姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐左司 其一","author":"赵汝腾","text":"紫洲洲上得诗筒，展诵青霞在眼中。\n白首漫郎应号叟，黑头永叔早称翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄高耻堂","author":"赵汝腾","text":"江西格了使湖南，又似当年朱晦庵。\n问学如公真少辈，请将大道讲毡谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答郑宜中 其一","author":"赵汝腾","text":"太极成争今几年，濂翁先得我同然。\n经行醉墨匆匆就，不谓朋侪今竞传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答郑宜中 其二","author":"赵汝腾","text":"畏暑门稀问字徒，袖中妙语契周图。\n知君十倍侯芭学，老我非雄尚索涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题永阳文献录 其一","author":"赵汝腾","text":"奸魂偃月忌吴黄，正气难摧百鍊刚。\n奇响后来谁接续，玉川拜疏植纲常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林行简见徐径坂","author":"赵汝腾","text":"紫霞洲上雨如丝，白发衰翁有所思。\n吟付三山林敬则，烂柯国手尚观棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又再用韵和","author":"赵汝腾","text":"后期采菊约新酬，笑指西风帽恋头。\n陆羽久仙泉水在，紫芝何代寺峰留。\n霞边野雾供吟啸，泽畔归鸿免叹愁。\n愧乏登高能赋手，陪公后乘写清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和饶计使丹青阁韵","author":"赵汝腾","text":"久闻杰阁愿今酬，亭午登临到上头。\n二水清澄新雨霁，众峰苍峭冻云留。\n拟赓场圃诗人句，休负烟波墨客愁。\n信使偕行原隰耀，仙山多谢约同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三用韵答饶计使","author":"赵汝腾","text":"郡凋亦办七茶纲，不似霜台雀舌香。\n上美为元包锡贡，残膏分丐雪翻尝。\n三为大有天王飨，二得坤中臣道方。\n退食自公味公赐，狂吟牵动璟心肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵呈史绣使","author":"赵汝腾","text":"吁嗟肤使襟期厚，来顾陈人老鬓班。\n席地樽开樵舍畔，停云兴在玉柯间。\n不知天上皇华贵，也共山中半日閒。\n好向金门领名胜，独留一叟弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵","author":"赵汝腾","text":"天生神醴地生材，曾感当年鸑鷟来。\n钓水取清芳酷烈，采山可茹味徘徊。\n能招霞侣云中笑，得奉龙颜食后杯。\n细品第三纲最胜，人间双井当舆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵贺计使高耻堂建台得雨","author":"赵汝腾","text":"皇华都骑访陈人，似洒仙瓢助守臣。\n亭午建台申大雨，作霖用汝泽先闽。\n物情是处皆忻吐，吏习从今一洗新。\n陕事早知付韩范，尧夫定不叹天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵答","author":"赵汝腾","text":"当年肮脏厄伊优，身寄枌榆宅尚浮。\n芝凤未肦羔屡聘，樯乌将发燕难留。\n朝廷终念孔文举，里社回思马少游。\n烟雾沧波休健羡，吾侪嫠纬莫忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵答","author":"赵汝腾","text":"敬简如翁吾所慕，即之目击道斯存。\n斥归借卧平泉石，倦出几名傲吏园。\n早日寒斋令尚友，近来径坂寄传言。\n文山岁晚梅如雪，拟约庞公到鹿门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵答饶计使","author":"赵汝腾","text":"周原愔愔隶台纲，茶篚驰供玉食香。\n贡重郑男难并列，品珍考叔未曾尝。\n乳花烹就分清贶，英草吟成属大方。\n后蔡前丁同入讽，令人怀古九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用韵答谢石屿庾使","author":"赵汝腾","text":"一翁閒伴两星台，亭畔看花花半开。\n我盍归田垂钓隐，公行持橐侍鸾回。\n流莺似避宫妆靓，黄鹄曾将蜀种来。\n二妙赓酬康济手，横舟句好相推莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答 其一","author":"赵汝腾","text":"西州名品萃东台，特为光风连夜开。\n春事三分元未半，诗肠一日九周回。\n雨中有泪坡吟尽，马上沾花甫醉来。\n郡坞数株寥落甚，园丁爱护剪荒莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答 其二","author":"赵汝腾","text":"人间姚魏总舆台，独占神仙上品开。\n绝代词华三峡倒，当时谏草九天回。\n晚晴大白檐前举，春暖小车花下来。\n笔补浣花溪畔老，吟工压倒北山莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆高耻堂柱史除漕","author":"赵汝腾","text":"九曲山川值异人，仙灵忻舞对波臣。\n德星临照来从蜀，瘴雾澄清一洗闽。\n泽物濂翁仁望著，宽民王旦政条新。\n烂柯精舍班荆语，好约秋风到北津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆高耻堂柱史都运","author":"赵汝腾","text":"招麾不可独斯人，中外称为社稷臣。\n永叔未容居四谏，鲜于且起福全闽。\n光华濡辔今亲遣，风采埋轮又一新。\n命下八州俱鼓舞，紫霞老守喜津津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叔兴见赠","author":"赵汝腾","text":"眼界纷纷尽扫除，云烟杳雾是匡庐。\n江山信美非吾土，井邑繁雄想旧庐。\n落笔纵横看草檄，感时忧愤欲成书。\n要须起赴功名会，莫守陈编似蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪游一首呈高计使谢庾使","author":"赵汝腾","text":"天风吹我到丹青，不觉春华又再经。\n芝叟采来云冉冉，茶仙尝后水泠泠。\n溪山信美琅琊景，宇宙无穷岘首亭。\n登者固多公不朽，老衰得附凤凰翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别伯舆新鄱阳广文","author":"赵汝腾","text":"特为予来冬复春，重寻旧话续新闻。\n诸儒学北今谁嗣，独步斗南犹有君。\n精舍诸生朝问道，郡斋一叟夜论文。\n絷维不可成分袂，搔首江东日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈竹湖李端明","author":"赵汝腾","text":"淳祐清忠推杜李，岿然名德赖公存。\n岁时阔会英耆社，风月稀游独乐园。\n一榻自观心主静，诸贤欲扣我忘言。\n仆归借屋西湖畔，半载才能两造门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀史计使","author":"赵汝腾","text":"皇华叱驭遂驱驰，抱病匆匆语别离。\n不到天风海涛地，空吟春树暮云诗。\n似闻信宿留桑下，惜不扁舟趁水涯。\n一笑论文何日再，玉川为我说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诇李斛峰右司","author":"赵汝腾","text":"数士英英未易招，当时一网尽于萧。\n公才何止为陈瓘，朝论今争推杜乔。\n国定须贤扶宇宙，士惟知道乐箪瓢。\n凤凰千仞需时下，谗说新来已雪消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诇斛峰李纯父右司","author":"赵汝腾","text":"衰拙新来领建安，郡斋夜梦绕馀干。\n东都得尔名节重，西贼闻之心胆寒。\n海内四贤尚家食，闽中一叟愧空餐。\n幔亭仙掌文盟在，好与伯舆来共看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诇湖南刑使赵紫薇","author":"赵汝腾","text":"绣节当年立碧霄，至今遗爱蔼欢谣。\n云烟何止能开霁，山岳曾闻亦动摇。\n纵未振衣华表著，不应分席混渔樵。\n馀干宰士今乔固，定有诗筒慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和饶计使北苑焙观贡品","author":"赵汝腾","text":"使华金掌冠卿材，曾侍红云一朵来。\n龙井为君增洗濯，凤山来客小低徊。\n膏翻玉雪团香帖，味笃金兰共酒杯。\n计相他时踵庞老，席前敷奏记东台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高计使郊行","author":"赵汝腾","text":"春光物色伴扬班，昼出城南暮入阍。\n转蕙风吹禊亭竹，采桑日照女筐蘩。\n清游得共皇华醉，妙语能追红药翻。\n一任鹃鸣芳自若，坐间嘉客意同原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]