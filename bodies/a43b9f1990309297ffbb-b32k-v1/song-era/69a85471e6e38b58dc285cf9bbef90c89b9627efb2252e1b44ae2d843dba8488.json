[{"title":"宁宗朝享三十五首 还位用《乾安》。","author":"郊庙朝会歌辞","text":"旅楹有闲，人神允叶。\n福以德昭，飨以诚接。\n六乐宣扬，百礼炜烨。\n对越在天，流祚万叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 诣室用《乾安》。","author":"郊庙朝会歌辞","text":"丹楹云深，芳勺宵奠。\n乐华淳鬯，礼文炳绚。\n有容有仪，载肃载见。\n维时缉熙，世世以燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"天一以清，地一以宁。\n维皇精专，承神明灵。\n娥御堕津，渎祇扬溟。\n盥事允严，先祖是听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 升殿用《乾安》。","author":"郊庙朝会歌辞","text":"于穆清宫，奕奕孔硕。\n芝茎蔓秀，桂华冯翼。\n八簋登列，六瑚贲室。\n皇代拥庆，启佑千亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 皇帝入门用《乾安》。","author":"郊庙朝会歌辞","text":"王假有庙，四极骏奔。\n鼎俎宵严，簴簨云屯。\n积厚流广，德隆庆蕃。\n是则是绳，保我子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉清昭应宫上尊号三首 其三 二圣殿奉绛纱袍用《登安》。","author":"郊庙朝会歌辞","text":"赫赫列圣，盛德巍然。\n彤彤灵宇，睟仪在焉。\n奉以龙衮，被之象天。\n重庆宗稷，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉清昭应宫上尊号三首 其二 太初殿奉册宝用《登安》。","author":"郊庙朝会歌辞","text":"皇灵垂祐，洪福弥隆。\n祗率绵宇，洁祀真容。\n严恭奉册，对越清躬。\n睟容肃穆，懿号尊崇。\n礼成乐举，福禄来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉清昭应宫上尊号三首 其一 奉告用《隆安》。","author":"郊庙朝会歌辞","text":"登隆妙号，钦翼渊宗。\n茂宣德礼，有恪其容。\n奉璋升荐，垂佩弥恭。\n扬休咏美，以间笙镛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元三年奉上孝宗徽号三首 其三 上徽号用《显安》。","author":"郊庙朝会歌辞","text":"金石充庭，珩璜在列。\n绘画乾坤，形容日月。\n巍巍功德，显显谟烈。\n垂亿万年，鸿徽昭揭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元三年奉上孝宗徽号三首 其二 册宝升殿用《显安》。","author":"郊庙朝会歌辞","text":"文金晶荧，册玉辉润。\n统绍乎尧，德全于舜。\n勤崇推高，子孝孙顺。\n冠德百王，万年垂训。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元三年奉上孝宗徽号三首 其一 册宝入门用《显安》。","author":"郊庙朝会歌辞","text":"巍巍孝庙，圣德天通。\n同符艺祖，克绍高宗。\n有仪有册，载推载崇。\n镂玉绳金，登奉祏宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至和祫享三首 其三 送神用《兴安》。","author":"郊庙朝会歌辞","text":"四祖基庆，三后在天。\n荐侑备成，灵娭其旋。\n孝孙应嘏，受福永年。\n送之怀之，明发恻然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至和祫享三首 其二 奠瓒用《嘉安》。","author":"郊庙朝会歌辞","text":"昭穆亲祖，自室徂堂。\n礼备乐成，肃然祼将。\n瑟瓒黄流，条鬯芬芳。\n气达渊泉，神孚来享。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至和祫享三首 其一 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"濡露降霜，永怀孝思。\n祫食谛叙，再闰之期。\n歌德咏功，八音播之。\n歆神惟始，灵其格兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前享太庙三首 其三 还大次用《乾安》。","author":"郊庙朝会歌辞","text":"礼既行矣，乐既成矣。\n维祖维妣，安且宁矣。\n皇举玉趾，佩锵鸣矣。\n拜贶总章，于厥明矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 高宗室用《大德》。","author":"郊庙朝会歌辞","text":"于皇时宋，自天保定。\n高宗受之，再仆景命。\n绍开中兴，翼善传圣。\n何千万年，永绥厥庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前享太庙三首 其一 徽宗室酌献用《承元》。","author":"郊庙朝会歌辞","text":"明明徽祖，抚世升平。\n制礼作乐，发政施仁。\n圣灵在天，德泽在民。\n亿万斯年，保佑后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其三 还位用《乾安》。","author":"郊庙朝会歌辞","text":"嘉玉既设，量币既陈。\n彷佛灵游，来顾来宁。\n对越伊何，厥惟一纯。\n佑我熙事，以迄于成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其六 再诣圣祖位用《乾安》。","author":"郊庙朝会歌辞","text":"岁逢有年，月旅无射。\n我将我飨，如几如式。\n肃尔臣工，谐尔金石。\n本原休功，垂裕罔极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其二 圣祖位用《乾安》。","author":"郊庙朝会歌辞","text":"骏命有开，庆基无穷。\n祗率百辟，仰瞻睟容。\n鼓钟斯和，黍稷斯丰。\n灵其居歆，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其七 还位用《乾安》。","author":"郊庙朝会歌辞","text":"旨酒思柔，神具醉止。\n工祝既告，孝孙旋位。\n何以酢之，纯嘏来备。\n燕及云来，蕃衍无已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其八 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"象德之成，有奕其舞。\n一弛一张，进旅退旅。\n嘒以管箫，和以镛鼓。\n神其乐康，永锡多祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其四 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"发祥仙源，流泽万世。\n曷其报之，亲飨三岁。\n相维列卿，洁粢是馈。\n匪物之尚，诚之为至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其五 再诣盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"华灯荧煌，瑞烟氤氲。\n威神如在，蠲洁必亲。\n再盥于罍，再帨于巾。\n皇心肃祗，其敢惮勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其十 酌献用《博安》。","author":"郊庙朝会歌辞","text":"至哉物祖，设象隆脽。\n动静之德，翕辟攸宜。\n嘉栗以荐，精祷洪釐。\n茂宣阴贶，五谷蕃滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其九 后土庙降神用《靖安》。","author":"郊庙朝会歌辞","text":"博厚流形，秉阴成德。\n柔顺利正，直方维则。\n明祇格思，素汾之侧。\n祗载吉蠲，宸心翼翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其八 亚、终献用《正安》。","author":"郊庙朝会歌辞","text":"至哉柔祇，滋生蕃锡。\n涤濯静嘉，寅恭夕惕。\n金奏纯如，万舞有奕。\n立我烝民，莫匪尔极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其七 饮福用《博安》。","author":"郊庙朝会歌辞","text":"寅威宝命，明祀惟虔。\n协神备物，罔不吉蠲。\n后祇格思，灵飙肃然。\n诞受景福，遐哉亿年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其六 太宗配坐酌献用《博安》。","author":"郊庙朝会歌辞","text":"报功厚载，祀事惟明。\n思文烈考，道济群生。\n侑神定位，协德安平。\n馨洁并荐，享于克诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其五 太祖配坐酌献用《博安》。","author":"郊庙朝会歌辞","text":"坤元茂育，植物成形。\n于穆圣祖，功齐三灵。\n严恭配侑，厚德攸宁。\n永怀锡羡，歆此惟馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其四 后土地祇坐酌献用《博安》。","author":"郊庙朝会歌辞","text":"秉阴成德，敏树宣功。\n应变审谛，神力无穷。\n沈潜刚克，流谦示中。\n洁兹奠献，妙物玄通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其三 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"博硕者牲，载纯其色。\n体荐登俎，聿崇坤德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其二 奠玉币登歌《嘉安》。","author":"郊庙朝会歌辞","text":"至诚旁达，柔祇格思。\n奉以琮币，致诚在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汾阴十首 其一 降神用《靖安》。","author":"郊庙朝会歌辞","text":"茫茫坤载，粤惟太宁。\n资生光大，品物流形。\n瞻言汾曲，允宅神灵。\n圣皇躬享，明德惟馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎奉圣像四首 其四 太宗位。","author":"郊庙朝会歌辞","text":"于显神宗，德洽区中。\n祥金烁冶，范兹睟容。\n殊庭胥宇，备物致恭。\n明威有赫，降福来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎奉圣像四首 其三 太祖位。","author":"郊庙朝会歌辞","text":"烝哉大君，聿怀帝祖。\n镕范真仪，奉尊灵宇。\n至感祥开，洪辉物睹。\n瞻谒尽恭，飞英率土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎奉圣像四首 其二 圣祖位。","author":"郊庙朝会歌辞","text":"总化在天，保昌厥绪。\n降格皇闱，琼轮载御。\n藻仗星陈，睟容金铸。\n佑我庆基，宅兹灵宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎奉圣像四首 其一 玉皇位。","author":"郊庙朝会歌辞","text":"玉虚上帝，金像睟容。\n宅真云构，练日龟从。\n维皇对越，率礼寅恭。\n灵心丕应，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴二十九年显仁皇后祔庙一首 酌献用《歆安》。","author":"郊庙朝会歌辞","text":"恭惟圣母，跻祔孔时。\n陈羞宗祏，徼福坤仪。\n钟鼓惟序，牲玉载祗。\n于皇来格，永介丕基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴十四年奉上徽宗册宝三首 其三 上徽号用《显安》。","author":"郊庙朝会歌辞","text":"惟精惟一，乃圣乃神。\n鸿名克扬，茂实斯宾。\n如禹之功，如尧之仁。\n孝思永慕，用诏无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴十四年奉上徽宗册宝三首 其二 册宝升殿用《显安》。","author":"郊庙朝会歌辞","text":"金字煌煌，瑶光灿灿。\n群工奉之，登此宝殿。\n对越祖宗，式遵成宪。\n威灵在天，来止来燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴十四年奉上徽宗册宝三首 其一 册宝入门用《显安》。","author":"郊庙朝会歌辞","text":"于铄徽考，如天莫名。\n迨兹丕扬，拟纯粹精。\n温玉镂文，来至于祊。\n有严奕奕，礼备乐成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 送神用《兴安》。","author":"郊庙朝会歌辞","text":"霜露既降，时思展禋。\n在天之御，眷然顾歆。\n乐成礼备，言归靡停。\n既安既乐，福禄来成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 彻豆用《兴安》。","author":"郊庙朝会歌辞","text":"礼备乐成，物称诚竭。\n相维辟公，神人以说。\n歌雍一章，诸宰斯彻。\n天子万年，无竞维烈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"观德宗祏，奕世烈光。\n有严祀典，粤循旧章。\n乐谐九变，献举重觞。\n燕娭如在，戬谷穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"肃肃清庙，于显维德。\n我祀孔时，我奏有翼。\n秉翟载骏，有来干戚。\n神之燕娭，休祥允格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 孝宗室用《大伦》。","author":"郊庙朝会歌辞","text":"圣人之德，无加于孝。\n思皇孝宗，履行立教。\n始终纯诚，非曰笑貌。\n于万斯年，是则是效。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 钦宗室酌献用《端庆》。","author":"郊庙朝会歌辞","text":"于皇钦宗，道备德宏。\n允恭允俭，克类克明。\n孝遵前烈，仁翊函生。\n歆兹肆祀，永燕宗祊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 徽宗室酌献用《承元》。","author":"郊庙朝会歌辞","text":"天锡神圣，徽柔懿恭。\n垂衣拱手，遵制扬功。\n配天立极，体道居中。\n佑我烈考，万福攸同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 哲宗室酌献用《重光》。","author":"郊庙朝会歌辞","text":"于皇浚哲，遹骏有声。\n率时昭考，丕显仪刑。\n功光大业，道协三灵。\n永绥厥后，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 神宗室酌献用《大明》。","author":"郊庙朝会歌辞","text":"于昭神祖，运抚明昌。\n肇新百度，克配三王。\n遐荒底绩，圣武维扬。\n永言执竞，上帝是皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 英宗室酌献用《治隆》。","author":"郊庙朝会歌辞","text":"炎基克巩，赫赫英宗。\n绍休前烈，仁化弥隆。\n笃生圣子，尧汤比踪。\n烝尝万世，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 仁宗室酌献用《美成》。","author":"郊庙朝会歌辞","text":"至哉帝德，乃圣乃神。\n恭己南面，天下归仁。\n历年长久，垂裕后人。\n祀修旧典，宝命维新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 真宗室酌献用《熙文》。","author":"郊庙朝会歌辞","text":"于穆真皇，维烈有光。\n丕承二后，奄奠万方。\n威加戎狄，道格穹苍。\n歆时禋祀，降福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 太宗室酌献用《大定》。","author":"郊庙朝会歌辞","text":"明明在上，时维太宗。\n允武允文，丕基绍隆。\n于肃清庙，昭报是丰。\n皇灵格思，福禄来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 太祖室酌献用《皇武》。","author":"郊庙朝会歌辞","text":"赫赫艺祖，受天明命。\n威加八纮，德垂累圣。\n祀事孔明，有严笙磬。\n对越在天，延休锡庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 宣祖室酌献用《天元》。","author":"郊庙朝会歌辞","text":"天启炎历，集我大命。\n长发其祥，笃生上圣。\n夷乱芟荒，乾坤以定。\n时祀聿修，孝孙有庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 僖祖室酌献用《基命》。","author":"郊庙朝会歌辞","text":"于穆文献，自天发祥。\n肇基明命，锡羡无疆。\n子孙千亿，宗社灵长。\n神之格思，如在洋洋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"冠佩雍容，时惟上公。\n享于清庙，陟降弥恭。\n笾豆静嘉，粢盛洁丰。\n孝孙有庆，万福来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 初献盥洗用《正安》。","author":"郊庙朝会歌辞","text":"恪恭祀典，涓选休成。\n设洗致洁，直于东荣。\n嘉觞祗荐，明德惟馨。\n祖考来格，享兹孝诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"王假有庙，子孙保光。\n奉牲以告，玉俎膏香。\n专精厉意，神其迪尝。\n休承灵意，申锡无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 其四 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"道信于神，神灵燕娭。\n酒有嘉德，物惟其时。\n缓节安歌，乐奏具宜。\n欣欣乐康，福禄绥之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 其三 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"嘉承和平，秩祀为先。\n乃练休辰，祝史告虔。\n内心齐明，祀具吉蠲。\n交际恍惚，如在后前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 其一 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"奉先严祀，率礼大经。\n时思致享，肃荐芳馨。\n竭诚备物，乐奏和声。\n真驭来止，熙事克成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴别庙乐歌五首 其五 彻豆用《宁安》。","author":"郊庙朝会歌辞","text":"仙驭弗返，眇邈清都。\n荐此嘉殽，既丰既腴。\n奠享有成，鼓乐愉愉。\n彻我豆笾，率礼无踰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴别庙乐歌五首 其四 亚、终献用《嘉安》。","author":"郊庙朝会歌辞","text":"霄汉月堕，郊原露晞。\n徽音如在，延伫来归。\n有酒既清，累觞载祗。\n神具醉止，燕衎怡怡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴别庙乐歌五首 其三 懿节皇后室酌献用《明安》。","author":"郊庙朝会歌辞","text":"曾沙表庆，正位椒庭。\n徽音杳邈，宫壶仪刑。\n虔修祀事，清酌惟馨。\n缩以包茅，昭格明灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]