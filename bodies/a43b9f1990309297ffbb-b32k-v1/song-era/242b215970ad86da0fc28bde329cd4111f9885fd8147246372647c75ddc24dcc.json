[{"title":"张公洞二首 其二","author":"岳珂","text":"驴迹惊初践，鹰盘若有灵。\n石桥通便户，金钥锁朱庭。\n滴乳看成像，登台仍刻铭。\n更怜国山字，真欲比云亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张公洞二首 其一","author":"岳珂","text":"祚纪千龄运，名标二代仙。\n鹊鸣应徙地，蝠化已先天。\n风洞疑无底，丹炉信有缘。\n祇应岩下弈，为我一跫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨梅","author":"岳珂","text":"渰历三家市，梅垂万颗酸。\n烽池看火树，嵝室试金丹。\n风露盈篮重，冰霜透齿寒。\n它杨应不类，留与子云看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月之腊诏赐银合腊药三首 其三","author":"岳珂","text":"无功应自念，有赐盍先尝。\n病作馀生累，恩颁上剂良。\n愿觇齐国證，小效越人方。\n采菲傥留意，须先元气防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月之腊诏赐银合腊药三首 其二","author":"岳珂","text":"式赐十一种，分驰数百程。\n虎符多俊杰，貂帽比恩荣。\n老矣何能役，居然忝此名。\n圣情天样阔，美报誓馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月之腊诏赐银合腊药三首 其一","author":"岳珂","text":"驿使锦连乾，传宣下九天。\n缄题瞻赐玺，走送听鸣鞭。\n意溢兼金外，恩从玉陛前。\n更怜戍边客，一骑入秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居六咏 其二 午睡","author":"岳珂","text":"东日平明际，北窗高卧时。\n五经方坦腹，百虑且伸眉。\n蕉覆从疑鹿，槐安更猎龟。\n觉来还一莞，七椀玉川诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居六咏 其一 早起","author":"岳珂","text":"五夜玉绳转，双轳金井寒。\n背人蚊作市，欺梦蝈鸣官。\n竹径风初度，松梢月尚团。\n踞龟犹汗漫，何计觅乘鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居六咏 其六 夜坐","author":"岳珂","text":"一窗凉浸月，四壁息闻雷。\n铜漏水仍滴，金炉香未灰。\n徘徊听蛩远，熠耀逐萤来。\n看剑挑灯久，谯城角引梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居六咏 其三 昼閒","author":"岳珂","text":"用关无用地，才与不才间。\n万法因心起，几人如我閒。\n床头看黄卷，屋外尽青山。\n隐几逌然笑，何人战触蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居六咏 其五 晚步","author":"岳珂","text":"抱病游从少，居閒醉醒频。\n心怀喜无事，脚力尚随人。\n野径经行地，园亭自在身。\n不妨归步晚，长趁月华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居六咏 其四 晡饮","author":"岳珂","text":"閒居欣少事，燕坐觉无营。\n炎暑鏖天阵，驱除须酒兵。\n勿嫌晡日杲，自有晚风清。\n堪笑竹中饮，终成七子名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卷雪楼","author":"岳珂","text":"地灵境胜宅神游，第一江山卷雪楼。\n势拥万峰淮甸接，气吞七泽楚天浮。\n鱼龙灂沸云生槛，鸥鹭波閒月上钩。\n画栋珠帘朝复暮，英名常与水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜观象弈","author":"岳珂","text":"青灯相对夜初阑，适意棋枰伴我閒。\n天马辎车金象国，虚龙缟袜宝台山。\n进趋自可觇成败，倖胜何尝不往还。\n一著未容回局势，不妨袖手酒杯间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过寿昌","author":"岳珂","text":"风云八字护城隅，楼殿崔嵬想帝居。\n曾侍金舆惟石马，幸因玉玺记铜鱼。\n千年鼓角声犹壮，四塞河山恨未袪。\n麋鹿已游人事改，何人曾读辅吴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜读庄子呈高紫微","author":"岳珂","text":"蒙园傲吏御风仙，聊以卮言后世传。\n小大升潜同此地，智愚工拙岂其天。\n众途适正何劳问，一理观心本自然。\n从此二经束高阁，为君终夕读名篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉寄何正父总干","author":"岳珂","text":"经旬习懒惯山居，不写城间一字书。\n把菊见山新趣倦，汎莲依水旧交疏。\n无心是处友麋鹿，有客寄谁烹鲤鱼。\n见说近来军食足，不妨诗卷访犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉谢何正父日虾荔实茶果宣瓜蜜朮之贶酬以露芽","author":"岳珂","text":"打门军将到山家，小国长须海上楂。\n冰片霞餐正浮蜜，雪穰风味更宜茶。\n颇思野蔌盘无荔，安得珍投琼报瓜。\n汎水旧游浑不记，且看七椀岸巾纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉赓赵季茂雪中感兴二首 其二","author":"岳珂","text":"湓城一夜雪，处处饭箩空。\n青序回规运，苍生比屋穷。\n伤心慨疆事，抱膝愧田翁。\n别乘应同志，忧时正愿丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉赓赵季茂雪中感兴二首 其一","author":"岳珂","text":"晓雪初明瓦，春云密布空。\n酒惊蕃鹤远，诗坐灞驴穷。\n访戴无嘉客，和陶称倦翁。\n应怜四十韵，衣带贺年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子三月二十七日又易守当涂四月十一日发辞免之牍书怀成二唐律 其二","author":"岳珂","text":"去载西陲夏正初，首惊禹阁下除书。\n璇杓导旨方螭陛，珍圉迎釐又燕居。\n三见纶音传诏玺，六看棨信到耕锄。\n祇今又上公车奏，何日烟蓑返老渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子三月二十七日又易守当涂四月十一日发辞免之牍书怀成二唐律 其一","author":"岳珂","text":"九重旒冕真知己，几度弓旌忆款门。\n素志不为温饱计，赤心未报圣明恩。\n鹤汀云雨暮应捲，牛渚风烟秋欲昏。\n休向长江问陈迹，浮梁孤塔不堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子正月彗见于室有诏求言因上己见有感作三唐律 其三","author":"岳珂","text":"粮府久关虑，骑官方应占。\n天心昭可卜，人事备当严。\n一苇江难恃，三巴民已歼。\n闭关还早计，璿玉不须觇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子正月彗见于室有诏求言因上己见有感作三唐律 其二","author":"岳珂","text":"美芹野人意，乔木世臣家。\n尺璧谅非宝，寸心元不遐。\n谁知剑门栈，已建郁军牙。\n所恨箫韶远，不堪闻塞笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中观庐山 其二","author":"岳珂","text":"半生每负看山眼，此日真成带雨游。\n攲枕有无疑欲暮，成峰横侧总宜秋。\n耳喧似厌泉呜咽，腰系不妨云去留。\n明日新晴马蹄放，直须三峡看龙湫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯孟运判寺簿赴京三首 其三","author":"岳珂","text":"半生共饮西江水，草木由来臭味同。\n交臂便同鸿燕社，论心不隔马牛风。\n君方鸣佩趋双阙，我自烧车延五穷。\n景倩仙尘凝望处，为言驿骑莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯孟运判寺簿赴京三首 其二","author":"岳珂","text":"诏书夜下日华门，辇路争看使者轩。\n烽火三边尚勍敌，烟尘万里欠公言。\n不须目睫忧多垒，好吐胸怀悟至尊。\n富贵功名分中有，勿令仗马愧廷鹓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯孟运判寺簿赴京三首 其一","author":"岳珂","text":"温纯如玉绝纤瑕，惊坐何人指孟嘉。\n策马殿军劳不伐，舍鱼取义理无差。\n读碑襄水真为谷，守垒房陵忍顾家。\n乡国不妨动归兴，天津八月却随楂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"便风经雁汊宿荻港是日舟行四百里三首 其三","author":"岳珂","text":"瞬息四百里，经行三十年。\n