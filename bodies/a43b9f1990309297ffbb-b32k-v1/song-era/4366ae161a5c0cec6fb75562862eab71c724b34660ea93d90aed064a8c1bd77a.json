[{"title":"哭吴亦虚一首","author":"刘一止","text":"髯吴少年日，轻车驾飞黄。\n授简千人中，风流蔼东梁。\n根植苦不牢，一朝陨清商。\n谁者不归尽，我独哀此郎。\n人物秀且美，叔夜惭龙章。\n眼看一抔土，瘗此白璧光。\n空馀百篇诗，老语惊摧藏。\n孤儿将谁赖，门户如冰霜。\n我非山巨源，感念徒悲伤。\n恨墨慰九泉，别语尚微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴彦和朝散挽诗二首 其一","author":"刘一止","text":"挂冠归去何曾老，贤达谁如此大夫。\n白傅宁惟结香火，季鹰初不为莼鲈。\n岸巾扶杖方行乐，寻壑经丘失步趋。\n惆怅眼中前辈少，更怜乡国后生孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴彦和朝散挽诗二首 其二","author":"刘一止","text":"谈经析理老逾工，家学诸郎得马融。\n心远自无流俗驾，语真端有古人风。\n每容晚进壶觞共，尚许残年杖履同。\n悽断松杉封马鬣，不堪持酒酹桥公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴公立承事挽诗一首","author":"刘一止","text":"脱蜕超然不可寻，了知胸次未宏深。\n智谋谁复如樗里，缓急惟思扣季心。\n惊见丹炉无宿火，欲凭辽鹤问遗音。\n邦人岂识神仙事，竞挽丧车泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐仲常朝奉挽诗一首","author":"刘一止","text":"岂弟临民契昔贤，政成终自弛蒲鞭。\n暮年三径师元亮，故国扁舟老计然。\n北陌东阡遗杖履，后冈前道锁风烟。\n郎君秀美如圭璧，会有恩光贲下泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁居士挽诗二首 其一","author":"刘一止","text":"臧否何曾挂，心真语自真。\n风波谙末俗，金玉见斯人。\n大厦方巢燕，新冈已卧麟。\n死生知是梦，洒落更谁伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁居士挽诗二首 其二","author":"刘一止","text":"自忝知心旧，常如识面初。\n情亲终近古，识远胜知书。\n水宿同烟艇，山行傍笋舆。\n眼中无此老，洒涕独沾裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼忠显刘公二首 其一","author":"刘一止","text":"时相开边隙，膻胡入帝州。\n痛心惟主辱，何意辨身谋。\n义气摧山岳，高居照斗牛。\n天令光史册，为洗百年羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼忠显刘公二首 其二","author":"刘一止","text":"重义何难死，知恩忍自欺。\n豫生真国士，南八是男儿。\n天地一朝黑，风霜千岁悲。\n至今瞻拱木，人口胜丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"参政大资张公挽诗二首 其一","author":"刘一止","text":"遇合时多故，风云气自强。\n补天烦大笔，医国见名方。\n恻怛忧民意，殷勤荐士章。\n可能遗一老，谁复问穹苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"参政大资张公挽诗二首 其二","author":"刘一止","text":"塞垒烽初息，留都倚重臣。\n奸骄阴夺气，政化本如春。\n待得中兴旦，宁论独病身。\n空馀门下士，悲恨不胜陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方秘监允迪挽诗二首 其一","author":"刘一止","text":"声名三纪在中州，身到蓬山最上游。\n笃行岂惟今代少，摛辞仍向古人求。\n独嗟宣室催归晚，不料漳滨卧病留。\n慷慨严尤三策在，暮年谁识子心忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方秘监允迪挽诗二首 其二","author":"刘一止","text":"同舍西雍四十春，乱离君我两身存。\n宁惟交道全金石，罕见人间此弟昆。\n雅志泽民终莫遂，微言忧国岂堪论。\n鸬鹚渡口千峰合，悽断西风泪睫昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方司业挽诗一首","author":"刘一止","text":"三纪飞腾近要津，声名磊落动朝绅。\n当时荐士韩安国，早岁谈经井大春。\n芸省并游今几在，螭坳立处梦曾真。\n蹒跚西望门生老，悽断云山泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莫奉议挽诗一首","author":"刘一止","text":"五斗难堪志愿违，斜川宁与宿心期。\n自持雪柏霜松操，直到鸡皮鹤发时。\n身世几番惊惧梦，功名一局半残棋。\n高风独与齐山并，他日行人口是碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅子渐朝议挽诗一首","author":"刘一止","text":"世事何曾有到头，此心安处便休休。\n田园竟老陶元亮，乡里谁如马少游。\n乐施轻财知气概，飞觞举白见风流。\n吁嗟四十年前梦，追怆经行泪莫收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔父朝请挽诗二首 其一","author":"刘一止","text":"厉节冰霜似，摛辞锦绣如。\n诚心惟济物，老眼更便书。\n备养今谁及，辞荣计未疏。\n郎君官已重，门户合关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叔父朝请挽诗二首 其二","author":"刘一止","text":"四纪儒林誉，谈经我一门。\n那知诗礼学，晚失父师尊。\n阡陌南阳旧，松杉厚夜温。\n心摧寒日落，泪尽晚云昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"詹阁学持国挽诗二首 其一","author":"刘一止","text":"元祐崇三舍，词场次第开。\n两科踰万士，一日见连魁。\n圭璧知难售，鹓鸾独晚陪。\n乱离身已老，不复梦东台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"詹阁学持国挽诗二首 其二","author":"刘一止","text":"至行无瑕玷，今人见古人。\n伤时心独切，接物语能真。\n丘壑寻春旧，松杉堕泪新。\n飘零一樽酒，无复听谆谆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贾居仁侍郎挽诗一首","author":"刘一止","text":"礼乐三千字，论思二十年。\n声名江夏愧，志节祖生先。\n阅世初何有，安心晚更贤。\n对棋无复德，悲泪渺林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少保左丞叶公挽诗二首 其一","author":"刘一止","text":"四纪声华旧，三朝道义尊。\n微言真自乐，博识更谁论。\n翰墨馀千载，哀荣付九原。\n松杉倚幢节，愁绝暮烟昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少保左丞叶公挽诗二首 其二","author":"刘一止","text":"文章千古事，富贵百年身。\n并世今馀几，如公孰拟伦。\n轩裳清梦破，丘壑此心亲。\n叹息常编旨，无从举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李方叔侍郎挽诗一首","author":"刘一止","text":"论议当今耸外庭，英英人物照丹青。\n文章共道追千古，训诂曾看媲六经。\n畴昔鹓行今几在，异乡薤露不堪听。\n老成远矣何嗟及，闻说郎君有典型。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周元举侍郎挽诗一首","author":"刘一止","text":"回翔三纪到丹泉，始觉深归雨露边。\n黄霸声名初不减，吾丘智略孰居先。\n勤劳再见云横岭，志业空惊雪满颠。\n愁绝故山三径晚，不堪持酒酹风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛鲁卿待制挽诗二首 其一","author":"刘一止","text":"先皇隆教育，师席重朝绅。\n模楷归元礼，纷纶仰大春。\n壮图初未究，归意久逾真。\n丘壑平生事，何人得此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛鲁卿待制挽诗二首 其二","author":"刘一止","text":"论议超今昔，文章适典彝。\n老成嗟已远，后学欲谁师。\n封域南阳旧，交亲北陌悲。\n他年门弟子，下马识丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑维心挽诗二首 其一","author":"刘一止","text":"我忆谷口孙，气貌清而腴。\n山潜三十年，吐此百卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑维心挽诗二首 其二","author":"刘一止","text":"嗟哉谷口孙，句法何摧藏。\n骨冷归九原，古意堕渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"恭人黄氏挽诗一首","author":"刘一止","text":"半世安贫家自宜，瀛洲进退本观时。\n随身况有居山服，傍涧宁惭采藻诗。\n案上镜奁今寂寞，林间风日倍凄悲。\n山公取友先嵇阮，永愧论才得误知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安人陈氏挽诗一首","author":"刘一止","text":"孕秀名卿族，来嫔吉士门。\n夫从中岁达，家至暮年温。\n意淡如忘物，身安只弄孙。\n镜奁今寂寞，遗懿不胜论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孺人张氏挽诗一首","author":"刘一止","text":"慈惠闺门浃，清真意不私。\n台臣有贤操，母德是吾师。\n家近青乌卜，名传黄绢碑。\n冯勤终贵宠，他日岂胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夫人赵氏挽诗三首 其一","author":"刘一止","text":"疏派天潢阔，天孙赋锦裳。\n佳祥来吉梦，淑德旧休光。\n周室中兴日，唐家异姓王。\n长人勋业茂，恩泽未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夫人赵氏挽诗三首 其二","author":"刘一止","text":"曾谓闺房奥，忠诚意有加。\n相夫惟以义，体国乃如家。\n天上期何近，人间日易斜。\n纶言知甚宠，谁为寄云霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夫人赵氏挽诗三首 其三","author":"刘一止","text":"帝胄恩荣久，夫人独俭勤。\n仁心见舆诵，孝行溢前闻。\n畴昔牛眠地，而今鹤吊坟。\n家声应更好，少长总能文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈夫人挽诗二首 其一","author":"刘一止","text":"婉娩闺门秀，安贫六十春。\n相夫惟礼义，玩意独清真。\n蜀道灵归远，吴山兆卜新。\n哀声传北里，悽感路傍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈夫人挽诗二首 其二","author":"刘一止","text":"盛德高门阀，荣光动里间。\n如何偕老愿，端向此时悭。\n幼妇辞新刻，仙游梦莫攀。\n吁嗟袆翟贵，不立内朝班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"俞居易阁学挽诗二首 其一","author":"刘一止","text":"事业更中外，论思契冕旒。\n年虽濒钓渭，志不在封留。\n慈爱平生念，欢愉末路收。\n遥知谢公客，挥洒过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"俞居易阁学挽诗二首 其二","author":"刘一止","text":"奕世论交地，红花巷陌春。\n扬雄一区宅，晏子百年邻。\n游倦归相踵，身闲意更亲。\n那知从此别，老泪损天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜山静疑院铁磬老师通公真赞","author":"刘一止","text":"堂堂律师，了无上乘。\n律彼后生，约束如绳。\n我煞叩师，师笑而嘻。\n曰我无心，法何所依。\n以无心故，说持说犯。\n以无法故，横竖钩贯。\n我知是师，说本无说。\n身心了然，片云孤月。\n姜山嵯峨，宛在世外。\n访师遗踪，惟铁磬在。\n片云出山，孤月丽天。\n铁磬不鸣，声满大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自作真赞","author":"刘一止","text":"枯木寒岩，形影相依。\n禄食而臞，孰与遁肥。\n四十九年，我知其非。\n已往不谏，来者庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又自赞","author":"刘一止","text":"居闲无所乐，从仕无所愧。\n忽作此两言，自省过去事。\n害性多矣晚乃安，苦心至矣晚乃甘。\n咄，我无初终得丧兮，又何乘除于其间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄草道衣赞","author":"刘一止","text":"何草不黄，谁其纺绩。\n持以售人，得不偿力。\n居士少贱，组丽是饰。\n力贫作奢，终愧于色。\n居士老愚，山泽放逸。\n下泽有车，登山着屐。\n被此草衣，相羊自适。\n倦鹄依林，野麋卧石。\n维此草黄，不失士职。\n不以本然，随彼染习。\n戒哉居士，服之无斁。\n馀年几何，以永厥德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许师正秀才游燕中得膏面碧云油见示因作二绝句 其一","author":"刘一止","text":"当年公主嫁毡裘，自撷芳兰制此油。\n燕代古来多绝艳，涂妆今有汉风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许师正秀才游燕中得膏面碧云油见示因作二绝句 其二","author":"刘一止","text":"驿骑奁封入禁门，六宫匀面失妆痕。\n应嗤万里通西域，只得连山苜蓿根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵呈师正 其一","author":"刘一止","text":"谁怜季子黑貂裘，谈舌曾经动碧油。\n客路何施画眉手，自涂香泽慰飘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵呈师正 其二","author":"刘一止","text":"涂泽风流出雁门，战场谁为洗啼痕。\n圣时宫女自妆薄，不遣燕入苍琅根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿长城西溪题僧舍","author":"刘一止","text":"西溪一夜枕潺湲，晓上楼头更细看。\n欲揽青山入怀袖，却愁烟雨湿衣寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题广福寺二绝 其一","author":"刘一止","text":"涓涓壁间通小池，小雨廉纤未作泥。\n深炷炉香高著火，何须骑马听朝鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题广福寺二绝 其二","author":"刘一止","text":"山中松韭厌寒俎，江甲防风手自锄。\n一榻北窗听雨睡，全胜白饭与青刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅舍人咏褚邦直葫芦","author":"刘一止","text":"山瓢枵腹谩如壶，不学鸱夷肯借酤。\n清夜玉堂谁伴宿，此时一盏可能无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题宣和御画","author":"王庭圭","text":"玉锁宫扉三十六，谁识连昌满宫竹。\n内苑寒梅欲放春，龙池水暖鸳鸯浴。\n宣和殿后新雨晴，两鹊飞来向东鸣。\n当时妙手貌不成，君王笔下春风生。\n长安老人眼曾见，万岁山头翠华转。\n恨臣不及宣政初，痛哭天涯观画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙人春宴曲","author":"王庭圭","text":"高楼玉佩摇春风，银槽压雨珍珠红。\n天留晓月十分魄，飞光下照仙人宫。\n瑶姬半醉挝鼍鼓，綵凤吹笙黄鹤舞。\n双成翠袖织藕丝，麻姑行厨擗麟脯。\n金盘烧蜡夜未央，从妃进果蟠桃香。\n坐上花开人未老，他日重来花更好。\n三千年后忽相逢，再约群仙醉蓬岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观骆元直经进江南形势图","author":"王庭圭","text":"异时汉网疏天讨，胡儿马齧江南草。\n石头重戍岂无兵，将军不识丹阳道。\n至今战骨埋秋霜，伤心不忍问耆老。\n龙蟠虎踞昔何雄，赤壁濡须在眼中。\n浔阳江水射蛟处，旌旗拂天来向东。\n艨艟塞川不敢下，昔人曾此破曹公。\n横江九道波翻屋，试请轻兵渡淮曲。\n夜入长安人不知，应见画图心已熟。\n他日将军按此图，鼓行如西如破竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长沙北禅览古","author":"王庭圭","text":"明湖涨天光，春云如粉碎。\n吴王宫女罢吹箫，象床玉椀今安在。\n桃李初开映绿池，绿池水暖摇花枝。\n闻道只今池上月，照见吴王繁盛时。\n当时粉色艳月彩，今日古坟烟草衰。\n草衰不见吴宫事，唯有月下孤猿啼。\n猿声哀告问不得，又恐清晓催黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方外庵听惠端弹琴明日赴李似矩尚书招","author":"王庭圭","text":"浮云捲尽天无风，青山衔日犹半红。\n谁弹乌啼夜鹤怨，平明结客长安中。\n大颠初识韩吏部，清檗亦参裴相公。\n尚书气欲吞胡虏，手挽天河作霖雨。\n响泉韵磬应自携，昵昵莫为儿女语。\n为陈古操有平戎，此曲聊堪佐旗鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游青原呈王元勃舍人周秀实监丞","author":"王庭圭","text":"异时黄鲁直，尝赋青原诗。\n至今青原山，名与星斗垂。\n自从有宇宙，孰能磨灭之。\n昨日从大旆，上读前人碑。\n欲学下一语，自觉落笔迟。\n我等如湛辈，后世谁复知。\n治君千载人，治中同一时。\n两公俱大手，妙语仍崛奇。\n得句未肯吐，神物悭护持。\n光艳出月胁，当留照岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟次白沙","author":"王庭圭","text":"朝发螺浦湄，暮宿白沙口。\n初为夜行计，有物应掣肘。\n山云四面起，风涛半江吼。\n落帆危石矶，就枕不敢久。\n林深鸣鹤鹊，村远闻鸡狗。\n梦觉知月明，破篷见牛斗。\n起视天色清，解缆欲放溜。\n浪头聒天响，掀簸入我牖。\n蒲帆未及张，篙师复回首。\n渡头有古祠，壁画杂怪丑。\n舟人相与言，劝我酬神酒。\n出处本细事，阴晴亦常有。\n我固不问天，岂问土木偶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄胡邦衡兼简陈佥判黄书记","author":"王庭圭","text":"斯文久寂寞，谁应擅雕龙。\n万事问伯始，今复得此公。\n涛澜翻笔舌，锦绣蟠心胸。\n平时吐佳句，逸气如长虹。\n制策收俊异，行当推选锋。\n元龙湖海士，江夏无双童。\n词彩俱秀出，春葩发青红。\n铿锵排律吕，纯音玉琤琮。\n草木吾臭味，坐隔神螺峰。\n遥闻玉荆产，长松想清风。\n安得奋馀勇，提戈噪其中。\n且愿试音响，径须撞巨钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向衡州生日","author":"王庭圭","text":"嵯峨阊阖西风回，赤霄夜半天门开。\n昴星麒麟下穹昊，两家同日生公台。\n两公为谁张与向，人物堂堂真汉相。\n愿公接武未央庭，禁直金銮对方丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张持操携徐献之侍郎书见访兼出示著述中兴论诸杂文为赋诗一篇以文轴还之他日亦录寄献之也","author":"王庭圭","text":"君不能徒步上书献天子，又不能移书帝城结王公。\n欲将笔力扛九鼎，纸上有说能平戎。\n宣和治极久忘战，羯奴骑马嘶淮甸。\n是时犹屯百万师，无人北向放一箭。\n大臣搏手知何为，草间公卿儿女啼。\n至今谋国无上策，读君断藁令人悲。\n君家人物照青汗，曲江犹识胡雏乱。\n他年论事要回天，应向荆州寻好汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过萧泷庙","author":"王庭圭","text":"泷江欲度虹为桥，泷涛舂击蛟鱼跳。\n泷头有庙非一朝，泷民犹传神姓萧。\n殿脚插入白鹭腰，青原舞翠挹岧峣。\n朱甍日出烟雾消，碧瓦不动磨青瑶。\n忽然飞电掣紫霄，天为借怒生奇飙。\n游龙挥雨洗泬寥，桂花堕落香云飘。\n百年古木号鼍能，击鼓变化鸾吹箫。\n官艘贾舶胆欲焦，庙前泊橹不敢摇。\n楚词跪奠设浆椒，泷之灵兮或可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]