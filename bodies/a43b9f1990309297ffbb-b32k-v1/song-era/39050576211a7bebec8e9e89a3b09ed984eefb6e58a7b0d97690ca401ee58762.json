[{"title":"再用前韵酬达夫 其九","author":"刘弇","text":"罚筹满把槽仍滴，鲙手千刀刃必迎。\n春若背教花不老，恣挨红阵燥瑶觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵酬达夫 其十","author":"刘弇","text":"阔疏未可轻愚叟，放浪多应学漫郎。\n待挽春工醉乡去，随教蜂蝶笑雄张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其一","author":"刘弇","text":"掠风社燕窥帘入，阁雨溪桃结子慵。\n莫笑妩眉等闲画，藁砧情地胜春醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其二","author":"刘弇","text":"花气曛曛活逼楼，十分大白直须浮。\n自怜短发如烟薄，敢买钿车贮莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其三","author":"刘弇","text":"柳挽花搴独自狂，鼓催钟趁几人忙。\n重城特解春将闭，时放红英笑女墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其四","author":"刘弇","text":"得丧三分徒鼎峙，是非两角谩蜗争。\n人情不似春情好，一气无私见合并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其五","author":"刘弇","text":"闲杀筛风酿雨时，可怜腰带渐宽围。\n何因径作江南梦，泛取图中竹叶归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其六","author":"刘弇","text":"关关柳幄莺怀友，曳曳花房蝶乞邻。\n未羡西园冠盖客，稍关南浦别离身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其七","author":"刘弇","text":"蹀骢草媚障泥锦，结妓花烘压杏油。\n梁父吟输醉乡客，抛毬乐称曲家流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其八","author":"刘弇","text":"骈棘重关不自由，横将匏系代萍流。\n飞丝莫罥林塘兴，留与骚人作四愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其九","author":"刘弇","text":"酒徒博醉貂龟解，社老赛神箫鼓迎。\n未省拨忙酬燥吻，壁端赢得挂空觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三用前韵酬达夫 其十","author":"刘弇","text":"它日江淹曾赋恨，几人颜驷尚潜郎。\n年来春事稠于发，莫把哀丝为急张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其一","author":"刘弇","text":"怯思酣魂九十中，蚕苗凤子学人慵。\n来来不会春工意，酝造风光抵死醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其二","author":"刘弇","text":"黄金迟日蚁成楼，翠色红光一样浮。\n短杀五更无客梦，小垂双手有人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其三","author":"刘弇","text":"高阳门巷有人狂，金谷园林数日忙。\n多事正堪怜考父，不寻花去却循墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其四","author":"刘弇","text":"雀缘底事儿童戏，蛙为何人口舌争。\n待割金明一寻碧，恨无霜剪快如并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其五","author":"刘弇","text":"叶底蜂儿抛蜜桶，花边猧子乱棋围。\n一绷周昉新番画，拟就勾芒乞取归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其六","author":"刘弇","text":"梦草客儿成底句，贪杯吏部觅谁邻。\n雪衣女软留茶舌，金十奴慵刺绣身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其七","author":"刘弇","text":"楼台半蘸浮天水，灯火频乾继晷油。\n桃李不须连夜赏，牡丹它日有高流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其八","author":"刘弇","text":"稍喜浊醪扶病头，强看狂絮点清流。\n王鳣叔鲔成何事，不似吞书鲤破愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其九","author":"刘弇","text":"提壶芦能送好声，客来长是及门迎。\n惜花待著连天幕，赌酒须翻卷海觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四用前韵酬达夫 其十","author":"刘弇","text":"折柳愁生灞陵岸，射雕闲杀羽林郎。\n长安不禁花时夜，京兆于今有赵张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其一 富沙门楼五绝","author":"刘弇","text":"通庄一日踊青鸳，目极须知剩得天。\n竞秀溪山归笔助，拨忙风月看觞传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其二 富沙门楼五绝","author":"刘弇","text":"文榱绣栱切浮云，喜色先开万井春。\n未俯栏干窥独鸟，已惊衽席度游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其三 富沙门楼五绝","author":"刘弇","text":"扑闬行人衮底流，闉阇缥缈到三休。\n霜魂月魄交光夜，十二冰帘不上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其四 富沙门楼五绝","author":"刘弇","text":"王粲登临端不负，庾公兴味故应清。\n广寒约酌无多地，取取仙风洗骨生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其五 富沙门楼五绝","author":"刘弇","text":"曾闻仙者好楼居，楼外仙山入指呼。\n聊作上游新粉泽，使君不为贮罗敷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其一 安济桥五绝","author":"刘弇","text":"谁把灵楂接饮牛，主人潇洒古东瓯。\n玉清夜半开冰箔，暗认方平别驾虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其二 安济桥五绝","author":"刘弇","text":"扶槛侏儒玉刻红，斩新装饰水精宫。\n武夷不信仙山近，十万曾孙正踏虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其三 安济桥五绝","author":"刘弇","text":"跨海鳌身传洛阳，贴波虹影老吴江。\n未如截取玻瓈去，稳卧箜篌白玉腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其四 安济桥五绝","author":"刘弇","text":"拥翠拖青得要津，截波仙屐略无尘。\n借令万鹊填桥巧，何补褰裳一世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建州富沙门楼安济桥十绝呈太守黄彦发 其五 安济桥五绝","author":"刘弇","text":"江夏无双自妙年，颍川第一早闻天。\n阳和自满千桃李，更欲邦人识济川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾道者归玉笥旧隐二首 其一","author":"刘弇","text":"踏尽匡山十载云，却抽秋鹤九皋身。\n明明似为溪毛熟，笑整西风不屋巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾道者归玉笥旧隐二首 其二","author":"刘弇","text":"道隐曾窥反接猱，急人尤喜施圭刀。\n浮生不絓秋毫外，肯把长闲博暂劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道旁见牛车因成二绝 其一","author":"刘弇","text":"由来得计在通津，蚀尽冥冥古道尘。\n犊子掣辕疲欲死，须知作俑是椎轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道旁见牛车因成二绝 其二","author":"刘弇","text":"兼两正缘胜任取，摧辀终忌大圆生。\n尺涂寸潦皆吾病，何必羊肠九折行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李德素罢官归舒城三首 其一","author":"刘弇","text":"潇洒由来物外姿，文章满把尽珠玑。\n飞黄蹀月终难绊，看取蘅皋手一挥。","collection":"宋","notice":""