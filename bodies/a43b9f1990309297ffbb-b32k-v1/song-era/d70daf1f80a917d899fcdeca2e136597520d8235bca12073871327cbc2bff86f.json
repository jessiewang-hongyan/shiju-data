[{"title":"次韵张巨山正月十日游天竺","author":"朱翌","text":"欲饭云边寺，先寻湖上春。\n山川良是旧，岁月又更新。\n草长烟如积，梅晴粉自匀。\n久留知不可，暂过却须频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李令","author":"朱翌","text":"青云独上肯随群，遇我真成数面亲。\n未许儿童骑竹马，且看土偶笑桃人。\n弟兄酬唱诗无敌，宾客过从德有邻。\n世味傥教如嚼蜡，便能调鼎识甘辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵俞路分见寄 其二","author":"朱翌","text":"龙尾道南初见子，烱如玉笋出瑶林。\n别来东海记三浅，歌罢武溪同一深。\n后五日看真得力，前三语且更留心。\n平生著手枯桐上，会有人能识此音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵俞路分见寄 其一","author":"朱翌","text":"有田二顷复何求，长恐斯言久不酬。\n青箬正堪烟雨笠，白文终返水云裘。\n相亲多谢风标子，可款岂无潇洒侯。\n更下疏帘对君弈，要观都大出棋州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡明仲见寄二首 其二","author":"朱翌","text":"柳州非国语，意恐乱诗书。\n去草绝根本，立言推绪馀。\n断疑先近似，反己问何如。\n岁晚飘零甚，归欤指敝庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡明仲见寄二首 其一","author":"朱翌","text":"双鸟鸣方盛，公今遂著书。\n浮云供一扫，直笔用三馀。\n孔孟扬韩道，乾坤日月如。\n平生击奸手，发踪自桐庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵常子正","author":"朱翌","text":"骨鲠当朝迹未尘，但知谋国不谋身。\n试看犀角龟文表，真是鸾台凤阁人。\n短别可堪驰梦驿，小诗聊为写情亲。\n雪山满眼寒潮急，凭仗归鸿一问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵傅丈见寄 其一","author":"朱翌","text":"到处能行到处藏，饭馀挂钵解茶囊。\n不缘头上五分白，始与人间万事忘。\n一介远劳询近日，十年如此住南荒。\n只今已是交游绝，不问比邻不择乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵傅丈见寄 其二","author":"朱翌","text":"土瓜甘蔗窖深藏，青李来禽子在囊。\n胜日园林吾有分，暮年歌酒尔无忘。\n扫除金屑不到眼，尽力石田难救荒。\n每遇北风长引领，皖公山下是桐乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上待客不至","author":"朱翌","text":"烟雾濛濛远岫埋，沙边特为小徘徊。\n行人又向去处去，客子未知来不来。\n诗似芙蓉临水出，人如杨柳待风开。\n何时见此消愁眼，更责后期倾玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上送客夜归","author":"朱翌","text":"江干燕客酒如淮，归路飞辀破绿苔。\n灯影入帘窥酩酊，雨声宜梦引咍台。\n岂无文送穷行别，似有人呼隐去来。\n一念不生无可道，此怀今欲向谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约郑公绩出城","author":"朱翌","text":"颇厌低头看文字，似曾有约到南山。\n稍回妍暖日自喜，扫尽积阴天解颜。\n便合与君联骑出，更谁如我两人闲。\n相逢莫作伤时状，且趁春光竞往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约徐令登妙高峰徐不至","author":"朱翌","text":"衙鼓声中百事休，独攀危磴看江流。\n君脩吏课中中考，我且山行上上头。\n下视三千佛世界，高寻十二仙人楼。\n闻思大士谁呼应，愿赐飞霖洗旱眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后饭客","author":"朱翌","text":"新阳为我解忧端，梅破南枝雪造寒。\n绣刺五纹添日刻，饼炊十字荐春盘。\n遣排百念有时尽，邂逅一尊无限欢。\n更待小晴拿小艇，兰浆重酹子陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过小市李秀才居","author":"朱翌","text":"大涌泉东小市头，川平土沃似中州。\n谁欤筑屋溪山里，李也读书窗户幽。\n懒觉郊行差自适，老于春事不相谋。\n他时来问曹溪路，系马桥边更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过乌龙岭","author":"朱翌","text":"群山低首避乌龙，行道惊看翠倚空。\n地设中原如此险，人无斗志若为功。\n九重颇觉天门近，一卒能当蜀道雄。\n细酌粉泉庵下水，泠然归去御刚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过王监园","author":"朱翌","text":"为问西园客，秋花馀几何。\n敲门容剥啄，此老正婆娑。\n十月为春酒，今年得子鹅。\n举杯邀月罢，击缶仰天歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竞秀阁二首 其二","author":"朱昱","text":"客槎飞过小金山，画栋参差杳霭间。\n隐踏鳌头归月府，侧骑龙背出尘寰。\n秋生弱水烟霞冷，春至蓬壶日月閒。\n遥望严陵钓鱼处，十分全似落星湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竞秀阁二首 其一","author":"朱昱","text":"辋川遥展右丞图，盘谷中藏李愿居。\n龙睡潭深飞客棹，凤鸣枝老结吾庐。\n但令蜡屐去前齿，安用鸱夷托后车。\n西望子陵三十里，烟云来往问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到曲江六首 其六","author":"朱翌","text":"嘉卉怀炎德，孤根幸斗临。\n象蹄交绿润，佛眼瞬红深。\n含笑香飘坐，素馨娇满簪。\n老榕虽拥肿，六月十分阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到曲江六首 其五","author":"朱翌","text":"草断城头路，春未履屡穿。\n雨馀峰染黛，云出岭垂莲。\n眼傍青林转，愁来白鸟边。\n中原好消息，问取此江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到曲江六首 其四","author":"朱翌","text":"岭外山川最，天涯草木芬。\n曾经五月狩，俱被一琴薰。\n韶石静张乐，舜峰高出云。\n真同适鲁见，何异在齐闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到曲江六首 其三","author":"朱翌","text":"灯火光元夕，歌呼亦尽欢。\n欣闻雪霏白，愁失荔垂丹。\n老酒莲花曲，甜鱼藿叶槃。\n万金书若到，便可解忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到曲江六首 其二","author":"朱翌","text":"昭代人无弃，遐方住亦堪。\n司分大火舍，官作世南男。\n守拙休心匠，忘忧纵手谈。\n平生不喜闹，所欠一茅庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到曲江六首 其一","author":"朱翌","text":"度岭三百里，携家五六人。\n卜居依古寺，爱日向初春。\n时有逃虚喜，端无去客嗔。\n团栾何所作，不寐守庚申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"告春亭 其一","author":"朱翌","text":"一丈宽锄地，三重密盖茅。\n分封鸥鹭境，拾翠芰荷坳。\n正尔宾中主，居然国外郊。\n老来俱倒置，营圃不营巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"告春亭 其二","author":"朱翌","text":"竟日成清坐，因行或抚松。\n墙阴连曲浪，木杪涌奇峰。\n要路看公等，闲乡属我侬。\n未春花已尽，春到若为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"告春亭 其三","author":"朱翌","text":"自断身将隐，无嫌论少卑。\n江湖双桂楫，天地一茅茨。\n溪篆行蝌蚪，林妆啭画眉。\n悠悠昏复昼，聊尔给其私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中示客","author":"朱翌","text":"风急梳松堕碧钗，雨多及榻长青苔。\n趁虚阿段阿稽去，挟册宗文宗武来。\n不用张罗知寂寞，恐妨飞鸟乐徘徊。\n侵寻老矣成何事，一日华严一卷开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中即事","author":"朱翌","text":"出山道士在家僧，晚诵儒书早佛经。\n灰尽此心犹木偶，扫除往事送刍灵。\n花边过客蜂旁午，溪上良时鹭适丁。\n一到菊坡分品目，玉盘盂可次金铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹次韵 其一","author":"朱翌","text":"一日春工过颍阳，名园次第款侯王。\n风流得见升平瑞，气味初无世俗香。\n早托筠笼驰驿骑，旋张罗盖护晨光。\n最怜一尺槃盂玉，稳上高鬟映额黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹次韵 其二","author":"朱翌","text":"画舫何须载西子，青裙今幸拜东王。\n佛谈非想色界色，天造玉皇香案香。\n兴庆池边凝晓露，善和坊里借馀光。\n行闻绮席开东省，飞鞚争驰御道黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰月四日大风出灵鹫捕鱼具鲙且约冬间再集","author":"朱翌","text":"西北云收廓太虚，东南风急放船初。\n冬深更许侯设鲙，地远不讥公矢鱼。\n白小未容登燕俎，红鲜忽已间嘉蔬。\n重生鳞鬣浮江去，尽是先生所弃馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿方允迪家雨雪大作","author":"朱翌","text":"肺腑群山襟带江，近人鸥鸟日成行。\n每来问道维摩室，何幸浓薰班氏香。\n雨脚雪花方间作，灯红酒绿正争光。\n更烦采选消长夜，坐看回旋穴骼忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑元亚新居面梅开轩诸子读书其间名曰擢英","author":"朱翌","text":"纷纷百卉不须栽，一见论交正有梅。\n诗兴已从东阁动，山寒并许北枝开。\n影横窗纸月为友，香著砚屏春共来。\n庭下芝兰争秀发，对花君但莫停杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金刚台","author":"朱翌","text":"儿子门生交说勤，要翁一出步溪云。\n金刚台近城三里，玉友醅新盏十分。\n反照江山红半敛，小春桃李暖如薰。\n心灰已冷无机事，戏象争棋亦谩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金秀轩诗","author":"朱翌","text":"金秀皆垂颖，山园特有光。\n牵牛高晕碧，滴露小匀黄。\n老读离骚传，儿寻急就章。\n杜门观化物，吾得傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台观新刻范文正碑","author":"朱翌","text":"日角曈曈上蔡阳，有星飞去避馀光。\n东西怵迫谢新进，南北逍遥乐故乡。\n载刻庙碑求琰琬，一新祠宇照沧浪。\n使君著意敦风俗，更作高堂榜卒章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨止读陶诗有感","author":"朱翌","text":"涓涓泉溜木欣欣，便觉居闲思不群。\n快睹朝霞开宿雾，少休时雨霭停云。\n无弦琴上宫商足，有酒篇中醉醒分。\n谁是知音谁可酌，置琴罢酒对炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后告春亭饭客亭下荷花皆为酿家入曲久雨颓垣方议栽竹代之","author":"朱翌","text":"半夜檐声挟北风，平明贺雨走诸翁。\n山人起向水亭坐，野膳不求行帐丰。\n曲糵有香莲不死，藩篱无阙竹成功。\n闲中自有闲生理，促办牛衣戴此公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后登城上亭","author":"朱翌","text":"何堪湿热坐支离，且就虚凉看剧棋。\n避雨唯应急走耳，登城愿丐少休之。\n江山政此成三绝，耳目醒然亦一奇。\n突兀小亭吾画箧，真形妙境恣君窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨晴吴李过园中","author":"朱翌","text":"联璧来吾隐，交欢只贺晴。\n酌泉心不易，指李话平生。\n万木翠光合，一池春水平。\n更询消遣法，元自不容声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷入南华僧仲有诗为次其韵仲欲见予诗集 其一","author":"朱翌","text":"促驾难求马一寻，行缠快走任山深。\n上方首入文公褐，小语能披逸少襟。\n三尺盆池清照影，五更窗月默传心。\n更烦细看门前水，昔日西流何似今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷入南华僧仲有诗为次其韵仲欲见予诗集 其二","author":"朱翌","text":"寺分三集易披寻，藏在名山意亦深。\n但与止兹鸾凤友，共逃不学马牛襟。\n年来惟以睡过夏，老去莫令诗呕心。\n欲见文章须近北，太平风雅盛于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷种柏假山中黄宪相访见之后八年黄宪复持节来柏已长大","author":"朱翌","text":"两石之间一寸栽，与君坐看斸莓苔。\n苍官阅世犹如此，欢伯唤人归去来。\n飘放又瞻新斧绣，光华重照旧池台。\n他时左纽纹生后，更望西游老子回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华具素饭烹茶诗","author":"朱翌","text":"颇有客仓卒，初无具咄嗟。\n家贫难办素，人众不烹茶。\n此老来修供，兹辰并拜嘉。\n小船横一笛，风引入荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华卓锡泉复出","author":"朱翌","text":"竹龙衔尾转山房，饮足寒清滴夜长。\n曾问鞠穷目眢井，为焚安息坐胡床。\n千山从此俱蒙润，一线才通未可量。\n六月炎方了无暑，谁知世上有清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华道中诗","author":"朱翌","text":"小市荒堤转，涌泉春水悭。\n频经石角铺，不上马鞍山。\n桥断冲泥过，松摧塞道艰。\n草鞋牢踏雨，更著一蓑还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峤南元夕时桃李尽花今岁游人甚盛示王守","author":"朱翌","text":"太平文物自多奇，刺史风流照海涯。\n五福神游先乐国，百灯王现应明时。\n笙箫合处春回煖，桃李阴中月落迟。\n醉倒花前天厚我，何须更间紫姑为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种黄菊","author":"朱翌","text":"白日殆欲寝，黄花能起予。\n妙香来枕上，正色立霜馀。\n护外劳编竹，培深更荷锄。\n收功归我枕，洗眼读残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈内翰去非三首 其三","author":"朱翌","text":"夜到甘泉捷，光摇建晓魁。\n唐家方再造，汉德已重开。\n太史书云后，群公贺雪回。\n十行宽大诏，早晚出银台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈内翰去非三首 其二","author":"朱翌","text":"梦获生花笔，祥开视草儒。\n奉天专仰陆，元祐只传苏。\n莲影光分烛，丝纹细结絇。\n禁中颇牧在，夙夜赞神谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈内翰去非三首 其一","author":"朱翌","text":"闻道催宣召，传呼入翰林。\n堂高初上玉，带重更垂金。\n烦悉周公诰，丁宁葛亮心。\n调元知有日，天意向君深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王端材以宣谕属官入川","author":"朱翌","text":"使星入蜀动佳占，幕府谟谋要子参。\n天下兵戈连岁月，朝廷根本在西南。\n路经九折休回首，事考三分小驻骖。\n想见梅黄飞雨里，前旌已在百花潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邓清臣之行在","author":"朱翌","text":"老去何嫌雪满颠，放怀惟与子周旋。\n起趋吴越时难得，上继张余理必然。\n岭海断云归雁底，江湖春浪白鸥前。\n故人相见问今我，雨笠烟蓑事力田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨亨仲还建康","author":"朱翌","text":"湖海重相面，干戈早脱身。\n亦知怀琰琬，宁肯就风尘。\n船泛东吴夜，梅寻故国春。\n毛锥有持护，如子岂长贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨倅致政还乡","author":"朱翌","text":"交说纷纷不惮烦，要公小驻北归辕。\n三休恐负名亭意，二去吾宁顾子言。\n快指柴桑还我里，遥瞻神虎到君门。\n画图史笔俱张大，又得杨家一巨源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏判院赴江东辟","author":"朱翌","text":"春风桃李正开花，客路江山亦可嘉。\n白鹭洲前浪山起，乌衣巷口夕阳斜。\n一星终矣君重往，四壁萧然我独嗟。\n元祐子孙今用尽，如公岂合在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送果州邵公济分韵得其字","author":"朱翌","text":"蓬莱清暑按行归，却向西南万里驰。\n郡继尊君家有法，学传乃祖世无师。\n曹刘墙短自今日，班马香浓如昔时。\n青士在旁知别语，夕阳回首更凄其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗巨济北归","author":"朱翌","text":"君才可从六龙飞，便合超腾向日畿。\n曾使诸生馆下立，又骑一马醉中归。\n江山得助云蒸笔，桃李不言春上机。\n归去来园花似海，子行吾且闭柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送范漕子仪","author":"朱翌","text":"乃公乃祖帝王师，勋在周家日月旗。\n德盛固宜长有后，材高如此用何迟。\n五更雨脚方收绝，六月云峰正出奇。\n好去加鞭度梅岭，及时功业继前规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡德辉","author":"朱翌","text":"抗章乞得清凉国，已是无心瑞锦窠。\n谁去自追戏下信，时来宁免禁中颇。\n三吴春尽天连海，四月梅黄雨压蓑。\n倘有新诗求共和，莫辞一骑送羊何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送崔若砺令河源","author":"朱翌","text":"双凫飞出九重关，带得中原气象还。\n抵死欲留之子住，吹笙要伴老夫闲。\n草荒白鹤峰前宅，云散黄龙洞口山。\n茉莉素馨闻已熟，妙香从此剩熏班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送福帅","author":"朱翌","text":"春到春城和雅歌，又携春去度云萝。\n过余竹里煎茶久，看子花边簇马多。\n千里福星临福地，一时天使挽天河。\n江红陈紫留连得，奈此催归尺一何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳不见菊次诸公韵 其四","author":"朱翌","text":"菊以黄为正，纷纷祇皂舆。\n待寒缘耿介，纵老不凋疏。\n秋净花如染，时迁水走渠。\n惟留五字句，能不愧应徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]