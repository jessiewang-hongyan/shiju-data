[{"title":"次韵昌甫所题唐宋诸贤画像石刻 其二","author":"韩淲","text":"谁云诗好不言寒，隐隐长身拥鼻端。\n尘世出门真有阂，强歌声里且求安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所题唐宋诸贤画像石刻 其三","author":"韩淲","text":"不见高人王辋川，兴来独往句能传。\n短衣袖手看云起，贺监何须水底眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所题唐宋诸贤画像石刻 其四","author":"韩淲","text":"唐人楷法今人少，笔数当年虞与欧。\n想见临池池水黑，恨无身世与同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所题唐宋诸贤画像石刻 其五","author":"韩淲","text":"放翁所刻章泉赋，雅道谁能见一斑。\n却怪我来居涧谷，摩挲墨妙得诗閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻郎中墨刻寄昌甫","author":"韩淲","text":"散庵常喜沙随字，更莫说他湍石翁。\n忽得行书难独享，急将回施散庵中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净名石刻","author":"韩淲","text":"净名居士本天人，冷坐毗耶百病身。\n华发苍颜只如此，便多言说也全真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄帐干琴一张云澄心堂旧物也因以次韵 其一","author":"韩淲","text":"江南书院初图霸，乃斲清琴尔许精。\n却忆焦桐裁爨下，要知徽外是真情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄帐干琴一张云澄心堂旧物也因以次韵 其二","author":"韩淲","text":"当年五柳先生手，白日无弦抚此琴。\n中散飞鸿有天眼，广陵一曲亦何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄帐干琴一张云澄心堂旧物也因以次韵 其三","author":"韩淲","text":"草衣塔院听鸣弦，妙悟分明恰似禅。\n愧我初非子期耳，但知声和醉吟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小卫铅山结课","author":"韩淲","text":"铅湖鹅岫春风煖，放步拥书明远楼。\n弹指两年同唱第，要知能赋古诗流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新亭图","author":"韩淲","text":"新亭地望是神州，夷甫诸人话转愁。\n又见江南描画出，古今容易得悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张果老小刻","author":"韩淲","text":"袖手风前散白须，长安道上且骑驴。\n苍黄失脚君门里，赢得他人作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李白泛舟图","author":"韩淲","text":"采石矶头捉月仙，脱靴意气尚飘然。\n沈香亭北惊尘世，且惜閒身棹酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孟襄阳灞桥风雪","author":"韩淲","text":"玉堂伴直我何如，想见归来不作诗。\n今日秦川灞桥语，蹇驴吹帽也相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵林德久所赋东坡海外三适图 其一","author":"韩淲","text":"玉堂学士何清真，惠州儋州犹若人。\n岂是故作排遣计，却疑画师笔有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵林德久所赋东坡海外三适图 其二","author":"韩淲","text":"胸罗星斗明是非，旁人谁知杜德机。\n濯足理发两眼睡，千载寂寥吾与归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一犁春雨图次赵正字韵题之 其一","author":"韩淲","text":"莫问今人与古人，汉家红腐本陈陈。\n年来饥馑因师旅，何计归田了此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一犁春雨图次赵正字韵题之 其二","author":"韩淲","text":"村舂茅屋动炊烟，负郭收他二顷田。\n便做丹青也堪赋，谁云不必万人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题山水曲屏","author":"韩淲","text":"空山蕙帐眠清熟，一个渔舟堕枕边。\n却忆年时江上路，丹青浓淡是云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈绍之作山水于卧屏","author":"韩淲","text":"一夜云山落枕边，布衾清煖得安眠。\n五更门外闻朝马，始觉清风远涧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜天思田间穫稻之乐书赠犁春图卷 其一","author":"韩淲","text":"霜晴稻熟上场时，鸡黍人间任所之。\n谁念尘埃自缠缚，耳昏眼悖复奚宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜天思田间穫稻之乐书赠犁春图卷 其二","author":"韩淲","text":"除了催租吏打门，洗锄犁后便醺醺。\n常年春雨多春事，待把心情付与君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题墦间图孙季仲丈创意为之殊可玩也 其一","author":"韩淲","text":"妻妾能羞亦可嘉，而今那有此人家。\n买臣见弃苏秦逐，却悔施施尚尔誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题墦间图孙季仲丈创意为之殊可玩也 其二","author":"韩淲","text":"战国纵横得几年，当时情态已如然。\n滔滔天下平常惯，要底丹青入画传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题烟月竹石","author":"韩淲","text":"和月依风远弄明，细看密密更亭亭。\n文湖州去坡仙已，诗眼逢君亦为青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题水石松梅","author":"韩淲","text":"绝壑移阴上壁间，潺潺犹听泻狂澜。\n乱梅香喷青松起，但觉庵中六月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老仙钓台观了思所作兰松梅竹","author":"韩淲","text":"带得西湖一树清，却因松竹并兰生。\n如今收拾归横卷，冷坐钓台非有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南唐画有宣和题","author":"韩淲","text":"南唐三主御屏风，流转宣和画苑中。\n今日江南谈旧话，遗黎无泪湿青红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马图","author":"韩淲","text":"朔风鬃尾自萧骚，却喜丹青眼力高。\n君欲案图来索骏，人间谁复九方皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和画猿 其一","author":"韩淲","text":"宣和殿上退朝时，万岁山中猿挂枝。\n今日江南无塞北，不禁毫素尚淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和画猿 其二","author":"韩淲","text":"雪霜繁处是阴山，八骏周游更不还。\n犹有遗黎抱弓剑，猿声依旧啸林间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梨花蚁蝶图昌甫伯皋约同赋","author":"韩淲","text":"暖烟晴霭月明微，一种生香只自知。\n春动飞行有情性，为渠花下立移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题草虫扇 其一","author":"韩淲","text":"粉翼才成便斗飞，微虫气化岂先知。\n草间更看跳梁者，物物春风信有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题草虫扇 其二","author":"韩淲","text":"雨晴风细两翩翩，一枕庄周莫怅然。\n野落春光惊欲老，深情都付草虫边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"施倅留饮题进帆","author":"韩淲","text":"千里云涛十幅蒲，仙家吹梦入方壶。\n嫩香破蕊横枝处，镂雪敲冰画得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题扇 其一","author":"韩淲","text":"老木埋云水浸沙，常言山尽是天涯。\n谁知却在天涯外，髣髴青山似旧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题扇 其二","author":"韩淲","text":"渔艇悠扬杳渺宽，茅茨突兀有无间。\n晴风便面回轻暑，更觉青山似我閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题扇 其三","author":"韩淲","text":"一山晴日一林风，僧舍人家杳霭中。\n行自章泉过怀德，依稀图画略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"希之小扇","author":"韩淲","text":"野水寒烟洗岸沙，萧萧风苇净霜华。\n无人独立飞来鹭，冷落心情一倍加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自吴中持陈绍之墨梅归置屋壁","author":"韩淲","text":"西湖貌得一枝来，长夏风轩尽日开。\n老眼暗中时摸索，便知玉雪不能猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题墨梅","author":"韩淲","text":"只在山林不见花，谁将水墨试横斜。\n与君一笑风霜里，从此留诗到酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨补之梅花小轴","author":"韩淲","text":"腊前到处见梅蕊，影落寒窗只自知。\n珍重西江三昧手，玉溪西隐看横披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画竹","author":"韩淲","text":"万叶扶疏落画檐，清风吹影上疏帘。\n人间翰墨閒游戏，一笔挥成不用添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伯皋所藏名妓墨竹逼令题之可谓戏剧","author":"韩淲","text":"夜寒窗静密还开，翠袖移将影下来。\n只是风前犹爱惜，更教月底共徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑩中自馀杭送兰笋 其一","author":"韩淲","text":"青璧兰花带土来，极知禅老为移栽。\n斩新叶底含风露，满眼尘埃亦暂开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑩中自馀杭送兰笋 其二","author":"韩淲","text":"常记林间烧笋时，饱餐香饭浪吟诗。\n如今白发王城里，甜苦堆盘只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何文蔚以瑞莲新篘见饷因以双井茶报之","author":"韩淲","text":"青山碧涧秋前立，莲酒和诗字字香。\n饮尽却愁君共醉，更将双井洗肝肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢昌甫芋药 其一","author":"韩淲","text":"山翁不管膏粱味，道士常从芝朮餐。\n想见散庵高洁地，竹垆深火对瓢箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢昌甫芋药 其二","author":"韩淲","text":"八年置散荒墟境，数月无祠迫暮冬。\n芋药五斤谁馈我，甑尘无用叹溪舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡教授送一壶","author":"韩淲","text":"急雨吹风送隐雷，瓦沟烟起往还来。\n北窗一枕竹床梦，便把诗翁酒汎杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周倅送郡酝且闻郡燕有佳客","author":"韩淲","text":"谁将双柱兵厨酒，留与閒民尚有馀。\n珍重平分风月手，又将新句擘笺书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送文叔同晦之宿鹅湖午间坐松下块石煎茶","author":"韩淲","text":"鹅湖十丈古松下，吃得一杯茶味甘。\n却坐僧窗拨寒火，满编新句又同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至寄蒋阜茶与昌甫且录大监赋来 其一","author":"韩淲","text":"巩为伊人句苦锥，宜乎赵有蒋茶诗。\n献芹微意随拈出，紫笋石花同谱之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至寄蒋阜茶与昌甫且录大监赋来 其二","author":"韩淲","text":"兴言此语竹林悲，寂寞泉溪近亲知。\n犹有晏斋能赏味，一篇温实旧人词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至寄蒋阜茶与昌甫且录大监赋来 其三","author":"韩淲","text":"绝世吟须属二公，休言桑苧玉川翁。\n清流洁士能同嗜，郁滞昏蒙定耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至寄蒋阜茶与昌甫且录大监赋来 其四","author":"韩淲","text":"烹煮清风两腋生，枪旗空复撷其英。\n如今共把春风椀，莫道须端与研泓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方斋子潜留瀹茗","author":"韩淲","text":"雨声滴碎窗前树，不是诗人作许愁。\n夜静岸花吹浪远，酒阑山气与云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"施寺山茶","author":"韩淲","text":"山茶天竺记能红，江浙虽非景则同。\n笑到堂中老禅伯，青春吹得几般风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"社日无酒戏作","author":"韩淲","text":"世事纷纷不拟知，纵聋何必苦医治。\n旁观未会醒然意，更道为猪无太痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从洪子野觅酒","author":"韩淲","text":"兵厨不作鸣鞭送，市酤多怀饮湿忧。\n可念嗫嚅空燥吻，要须倾倒付新篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简林敏夫觅酒","author":"韩淲","text":"今日复霜江上寒，病躯于此最知难。\n所须杯酒相料理，市酤不堪甜且酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简人求酒二首 其一","author":"韩淲","text":"儿曹昨过故人家，归说渠侬酒味佳。\n闻道得之王录事，题诗聊代夜能赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简人求酒二首 其二","author":"韩淲","text":"无客犹须酒解忧，客来宁免为之谋。\n白衣走送君家事，莫问东篱菊未秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"成父携酒过余作二绝 其一","author":"韩淲","text":"今雨能来定可怜，一壶仍与遂初泉。\n故人风味成疏阔，且向杯中别圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"成父携酒过余作二绝 其二","author":"韩淲","text":"晓甑无炊从妇嗔，也须料理瓮头春。\n殷勤遗我非无意，应笑茅柴但湿唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酒阑","author":"韩淲","text":"酒阑天地与同流，懊恼吟成不那愁。\n渭北江东春树远，古今波荡白浮鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵清江携临安酒来饮","author":"韩淲","text":"一壶犹带武林春，细拂湖边陌上尘。\n此去清江八百里，秋深蓬底是行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上巳留晋仙饮","author":"韩淲","text":"隔江烟雾是山阴，一夜风寒忽转晴。\n我有一杯相就饮，唤回昏梦杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡教授留饮","author":"韩淲","text":"出山閒度过桥风，留我持觞两颊红。\n座对腊梅花著蕊，南窗斜日角声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫斯远步过涧园小坐梅下一杯 其一","author":"韩淲","text":"落梅春风一杯酒，薄晚小园寒色时。\n章泉章丘亦何事，能閒过我容追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫斯远步过涧园小坐梅下一杯 其二","author":"韩淲","text":"十诗说得梅能好，我欲和之无此情。\n一坞暗香浮涧水，君来犹觉句难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫斯远步过涧园小坐梅下一杯 其三","author":"韩淲","text":"十日秋风记相别，经年常忆树头章。\n水南春事一月矣，杖藜犹有落梅香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上南豅春伯家雨后绝溪小酌酒肆","author":"韩淲","text":"行转山腰唤小舟，更寻荒店酒家游。\n一溪雨后滩声急，小醉虚檐翠竹秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵簿溪亭张饶县约共饮有怀睡翁 其一","author":"韩淲","text":"岁晚相从说睡翁，拥炉吹烛酒杯同。\n九原不作泉溪冷，空以残编著眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵簿溪亭张饶县约共饮有怀睡翁 其二","author":"韩淲","text":"冲风被褐过桥来，水净孤城没点埃。\n只是老怀犹自可，怀人惊世复何哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟垂虹亭下沽酒举杯","author":"韩淲","text":"晴林眇邈晓波平，红日埋云只漏明。\n少驻一篙微步去，试沽官酒句须成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋香欲开小醉而归","author":"韩淲","text":"桂树水南香是花，高山还许著诗家。\n旋沽村酒乘秋思，一道冰溪浸两涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]