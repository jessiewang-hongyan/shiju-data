84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"煮泉石","author":"王洋","text":"顽石连卷裹绿苔，人传桑苧手亲开。\n谁言天地无情物，却解殷勤唤客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琵琶洲","author":"王洋","text":"塞外风烟能记否，天涯沦落自心知。\n眼中风物参差是，只欠江州司马诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫极二仙翁祠","author":"王洋","text":"方内人过方外游，两翁身世等浮沤。\n何如添作三高士，为有平生一水丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏瑞香催海棠五首 其五","author":"王洋","text":"卜昼弥文卜夜迟，前人明训后人师。\n海棠不守春秋法，高烛偏宜照睡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏瑞香催海棠五首 其四","author":"王洋","text":"刺绣窗前午梦惊，骊驹堂上礼初成。\n旁无粉黛灯笼锦，顿解饥寒瓠子羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏瑞香催海棠五首 其三","author":"王洋","text":"鲁国诸儒走月题，甘于圣学饱羹藜。\n不知荷筱人归后，谁似张侯为割鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏瑞香催海棠五首 其二","author":"王洋","text":"生无飞颔老蒿莱，惭愧君侯客燕开。\n面带凄凉无酒色，谁人信道赏花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏瑞香催海棠五首 其一","author":"王洋","text":"郑人兰佩不须誇，自别团香擅国华。\n客枕莫疑无好梦，年年同有瑞香花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣兴","author":"王洋","text":"老如认老应无病，贫要安贫可免忧。\n贫病欺人须服弱，嗔拳笑面却应休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"催老泉凿井","author":"王洋","text":"全师何日凿新泉，浇涤尘埃是胜缘。\n恐为师无均济力，长招官索欠租钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"携稚幼看桃花","author":"王洋","text":"人面看花花笑人，春风吹絮絮催春。\n韶华虽好多头绪，何似秋空不受尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚王庙","author":"王洋","text":"提封犹是古方隅，庙食何惭百世馀。\n醴酒不陈宾客去，至今遗俗重诗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬伯氏再用前韵","author":"王洋","text":"自方国小难回袖，不畏秦彊欲奏盆。\n遥想调琴堂上日，仁风曾使满千门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧求诗往平江","author":"王洋","text":"一瓶一钵远山寒，野路梅花已向残。\n自古吴门十万户，莫疑开口告人难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙台","author":"王洋","text":"不将台榭压城闉，争奈长淮四面春。\n闻道公馀一吟啸，满天风月助精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"裴子再寄诗酬之","author":"王洋","text":"裴郎四海一轻舠，身寄浮家小动摇。\n蝴蝶不来闲处舞，知随春梦到云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山庵","author":"王洋","text":"桃花樱花红雨零，桑钱榆钱草色青。\n昌条脉脉暖烟路，膏壤辉辉寒食汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题会蠡亭 其一","author":"王洋","text":"禦儿南望越王城，相国勤劳干国情。\n料得功成身去后，扁舟犹忆此经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题沈氏小桥","author":"王洋","text":"能去尘埃几里摇，随香步步透兰桡。\n主人可是饶风月，分与游人倚小桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宓庵壁","author":"王洋","text":"西风吹彻菊花黄，唤我东篱泛一觞。\n白发插花休笑我，年年汝亦负重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题范子济双头芍药二首 其二","author":"王洋","text":"赵家姊妹在椒房，宫漏春迟午梦长。\n淡拂蛾眉减脂粉，一般装束奉君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题范子济双头芍药二首 其一","author":"王洋","text":"春风随律入花房，三月淮南春昼长。\n闻道传呼催近侍，双垂罗袖引花王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题前寺中洲茶","author":"王洋","text":"中洲绝品旧闻名，瀹以寒泉雪乳轻。\n怪得道人长不睡，一瓯唤醒梦魂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵侯庙","author":"王洋","text":"途穷道尽势仓皇，犹守孤城结战场。\n遗庙丹青照今古，不惭张许在睢阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题源师小房源善画","author":"王洋","text":"吾心闲欲省尘缘，选得闲云起处眠。\n笔下自多宽宇宙，眼前犹乐少林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠宣上人二首 其二","author":"王洋","text":"袖被腾腾粥饭师，无人曾见下山时。\n相逢只道无能解，肯作红楼应制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠宣上人二首 其一","author":"王洋","text":"海上孤峰一剑铓，从来匣里自韬光。\n如今直面相呈处，怀玉山头春草长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠栖贤僧二首 其二","author":"王洋","text":"暖风吹律百花新，何处芳菲不动人。\n到底雄丹有家法，风流不是一般春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠栖贤僧二首 其一","author":"王洋","text":"锦心绣口绝铅华，白氎铜瓶古梵家。\n宴坐无人问消息，有时敲板唤玄沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠笔工周宣","author":"王洋","text":"静闻孤卓漏声迟，午转花阴昼景移。\n能事莫忧身不足，人间不用石榴皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠廨院主僧","author":"王洋","text":"平生老信爱颠狂，觉子而今继道场。\n坐断前溪去来路，为谁辛苦为谁忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一夕大风偶成呈诸兄简士修思远","author":"王洋","text":"狂飙一夜撼天关，彻晓阳乌势未还。\n早恨馀寒誇老健，重怜新物损朱颜。\n强留残火如相别，已典春衣不可攀。\n料得云端风背上，融和那肯似人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月九日访仰之闻德茂与婿邓叔厚蚤作逍摇溪滨叹而成诗","author":"王洋","text":"贪闲心不受嚣尘，六十年馀自在身。\n爱水爱山三益友，如冰如玉两闲人。\n言无拘畏诗多健，酒借豪华力有神。\n闻说山中丞相语，与君心事最相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和新字","author":"王洋","text":"清秋移象纬，皎月一更新。\n岩桂陪宾席，黄花似故人。\n诗参工部正，道入醉乡醇。\n摇指灵山下，长衫赛社神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万席仰之许酒以诗戏之","author":"王洋","text":"花色芳菲酒力醲，坐中上客索千钟。\n朱陈缱绻论前契，子婿牵联本一宗。\n独为棋高能假借，众同酒伴不阿容。\n归来醉倒终无怨，此会心知不易逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三峡桥","author":"王洋","text":"万马战空山，声驰宇宙间。\n窥高增健大，照勇怯孱颜。\n洗石无千古，招僧过一关。\n不知平去易，何似倒流艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元二首 其二","author":"王洋","text":"谁将膏粥饭蚕师，轻薄儿童觅綵衣。\n游骑但知誇艳丽，祠门直莫叹寒微。\n东城南陌春迷眼，逐马随车醉未归。\n莫怪老翁闲坐久，鬅鬙灯火照柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元二首 其一","author":"王洋","text":"火树银花起夜烟，骖驔朱幰竞骈阗。\n一千户外开金锁，十二里中然玉莲。\n何日行宫祠太一，谁从摩诘问诸天。\n歌台且喜宜正月，柳岸今年胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与长老夜话出故人俞宋护书予至山之日俞书适至书中又相问讯感而赋诗二篇俞郊居婺源草堂蔬圃教子读书乡人重之闻近苦目疾殊可念 其一","author":"王洋","text":"三十年馀病作魔，相思长恨隔关河。\n僧窗开读君书至，丈室分龛我暂过。\n忆尔音容如会合，感怀踪迹念蹉跎。\n两篇价有千金重，若比千金更不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]