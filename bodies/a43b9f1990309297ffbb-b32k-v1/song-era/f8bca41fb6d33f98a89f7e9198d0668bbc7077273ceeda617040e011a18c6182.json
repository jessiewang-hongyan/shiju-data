[{"title":"赠风鉴","author":"苏寿元","text":"空有奇胸贮石渠，功名不许老头颅。\n凭君细阅寒窗下，还有它年房杜无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠伯鸾","author":"苏寿元师","text":"伯鸾苏氏子，年少勤经史。\n下笔如有神，气概迈前古。\n切勿恃其长，囊麝自然香。\n如有周公美，使骄不足扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"特吟诗二首送英公大师 其一","author":"苏易简","text":"乘舟南去唯寻酒，上马西行只咏诗。\n醒醉去留皆遂意，如斯方信是男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"特吟诗二首送英公大师 其二","author":"苏易简","text":"祝融峰上曾传纳，太一山前旧结庐。\n两地逍遥已三纪，争教肯在帝城居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁林宴会之什","author":"苏易简","text":"雨晴禁署绝纤尘，宴会名贤四海闻。\n供职尽居清显地，崇儒同感圣明君。\n翩然飞白璇题字，焕若丹青翠琰文。\n梓泽笙歌诚外物，兰亭诗酒不同群。\n少年已作瀛洲老，他日终栖太华云。\n莫怪坐间全不饮，心中和气自醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题临兰亭序","author":"苏易简","text":"有若似夫子，尚兴阙里门。\n虎贲状蔡邕，犹旁文举樽。\n昭陵自一闭，真迹不复存。\n予今获此本，亦可比玙璠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠翰林学士宋公白","author":"苏易简","text":"天子昔取士，先俾分媸妍。\n济济俊兼秀，师师麟与鸾。\n小子最承知，同辈寻改观。\n甲第叨荐名，高飞便凌烟。\n遂使拜扆坐，果得超神仙。\n迄今才七岁，相接乘华轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越江吟","author":"苏易简","text":"神仙神仙瑶池宴。\n片片。\n碧桃零落春风晚。\n翠云开处，隐隐金舆挽。\n玉麟背冷清风远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"苏易简","text":"天赋九华名状别，岧峣胜槩压诸方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"苏易简","text":"憔悴贰卿三十六，与师气味不争多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"苏易简","text":"玉堂臣老非仙骨，犹在丹台望泰阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一笑","author":"苏泂","text":"曾服燕支遂得仙，此花风味出于天。\n杜陵无句休惆怅，且共东坡一粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"苏泂","text":"七夕相寻旧宅来，鸡头月下脊令杯。\n饮残谁问天边事，独自婆娑弄影回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"苏泂","text":"茅檐小屋对青山，只有渊明一味闲。\n手把黄花玩尊酒，宛然风味义熙间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日宝林塔中作","author":"苏泂","text":"瓮头无酒菊花青，千丈苍崖孰与登。\n从此重阳课茶事，不携儿女只携僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八阵图","author":"苏泂","text":"俨然云转与风回，故国人看但石堆。\n犹有鬼神供职守，不移行列待将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其七","author":"苏泂","text":"朝家积累有深仁，天听由来不远人。\n且愿君王省征伐，明郊重见四夷宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其五","author":"苏泂","text":"燕罢芳园敕御龙，须臾仙仗簇还宫。\n千官过尽尘如雾，薄暮香钿满路中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其六","author":"苏泂","text":"花枝人面两欣然，和气晴光四接连。\n亲向官街听舆诵，太平天子万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其三","author":"苏泂","text":"月中鼓吹日中归，重领中宫拜寿闱。\n指点都人最欢喜，今郊恩赦每郊稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其二","author":"苏泂","text":"黄门驰马去如云，末后椒房驾玉轮。\n惊起秋风无处避，变成三月万花春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其四","author":"苏泂","text":"祥烟漠漠上龙旂，将相侯王护六飞。\n一望御街红数里，几人簇拥赭黄衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六日伏睹明堂礼成圣驾恭谢太一宫小臣敬成口号 其一","author":"苏泂","text":"三边兵隙果谁开，尽道秋高战马来。\n宗祀告成无一事，小臣欣睹带花回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南明示众","author":"赵抃","text":"寂寂松门竟日閒，更无金锁与玄关。\n时人欲识南明路，过得溪来便上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上馀姚","author":"苏泂","text":"忆侍大人江北去，却从伯父野堂回。\n争知二老轻凋谢，岁晚扁舟一个来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与曾亨仲曹六二兄买小舟游西湖","author":"苏泂","text":"贪忙安得似偷闲，日日红尘倦往还。\n买得小舟真似叶，败荷丛底看孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之上虞道中作","author":"苏泂","text":"东关白塔何由见，异日曾惊堠子频。\n千顷波涛风雨里，夜深孤载一愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大仙庙 其一","author":"苏泂","text":"为云为雨话头长，十二峰前事渺茫。\n尽道翠眉愁未展，不应犹忆楚襄王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大仙庙 其二","author":"苏泂","text":"风木哀鸣想佩环，飞鸾何在古祠閒。\n无端牢落悲秋客，刚把人间比梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子大送桂花答之","author":"苏泂","text":"小山月在影团团，满院清香特地寒。\n病骨逢秋眠较少，五更风露起来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小立","author":"苏泂","text":"飞却青天白鹭鸶，短篷相伴月明知。\n只因独速归来后，见我沧洲小立时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小亭诗","author":"苏泂","text":"小亭西角杏花明，寂寞闻莺但一声。\n九十日春今五十，自挼红蕊绕阶行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小憩西兴","author":"苏泂","text":"吴越相望一苇通，仙凡不隔半帆风。\n玄晖有句无人识，尽在西兴落照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"川墨送两冯君 其一","author":"苏泂","text":"裕陵故物秦家得，再拜摩挲老墨潘。\n今代廷圭那复见，纸窗蛛络半乌丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞盖堂即事","author":"苏泂","text":"秋清未脱暑衣裳，稍上城楼过苑堂。\n北面芰荷南面桂，水香吹乱月中香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"苏泂","text":"风露凄清入敝裘，月明偏照五更头。\n无衣毕竟干谁事，彻夜寒螀叫不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书所见","author":"苏泂","text":"画手何须觅范宽，有人楼上倚栏干。\n琼田玉界三千顷，野鸭飞来不道寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"