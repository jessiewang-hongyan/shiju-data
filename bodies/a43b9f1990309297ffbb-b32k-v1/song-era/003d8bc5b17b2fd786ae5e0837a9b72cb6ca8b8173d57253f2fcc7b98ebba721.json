[{"title":"长相思","author":"章丽贞","text":"吴山秋。\n越山秋。\n吴越两山相对愁。\n长江不尽流。\n风飕飕。\n雨飕飕。\n万里归人空白头。\n南冠泣楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送水云归吴","author":"章妙懿","text":"一从骑马逐铃銮，过了千山又万山。\n君已归装向南去，不堪肠断唱阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题弥勒院","author":"章孝参","text":"桥通流水绿溶溶，殿阁穹然镇象龙。\n半壁石桥通雪窦，一龛丽室占雷峰。\n挂岩屋似六和塔，入路门如九里松。\n遥想空庭明月夜，浮屠桂树影重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自龙隐岩泛舟至雉山","author":"章岘","text":"晴溪几曲度澄湾，朝涉龙岩晚雉山。\n林叟野僧休笑我，平生所得是官闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁未上巳重游龙隐岩","author":"章岘","text":"溪干舣棹访岩扉，危磴攀缘不欲归。\n垂乳滴声当佛座，宿云留润在僧衣。\n聊开禊席临流水，闲掷文竿到落晖。\n旅宦天涯甘寂寞，送春无意惜芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李升之夜游漓江上","author":"章岘","text":"自笑无钱对菊花，天寒欲冷慢令赊。\n桄榔叶暗临江圃，茉莉香来酿酒家。\n月雾空濛萤照水，霜风萧瑟鹭眠沙。\n归寻独秀山前路，城角参横斗柄斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治平丙午仲冬中浣游释迦寺登环翠阁","author":"章岘","text":"吏局区区得暇难，倚崖高阁暂登攀。\n群峰半出重林外，小艇横浮一水间。\n霜叶信风随鸟逝，晚云沉石伴僧闲。\n夕阳欲下犹回恋，更鼓清琴数弄还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题龙隐岩","author":"章岘","text":"碧崖石室俯清涟，蟠蛰灵虬不记年。\n委蜕去为天下雨，抱珠归作洞中眠。\n照开雾脚澄溪月，滴破云根暗穴泉。\n负郭胜游虽信美，桑间留爱我无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题伏波岩","author":"章岘","text":"江澜洄洑齧山根，山裂岩开石室存。\n溺鬼夜呼千嶂黑，蛰龙晨起一川浑。\n金沙试决通泉脉，翠壁闲题破藓痕。\n三伏几人逃畏暑，岂惟河朔有清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雉山","author":"章岘","text":"营邱水墨师，不识桂林山。\n半世阅渠画，今始陋坚顽。\n岭边千奇峰，浓绀梳云鬓。\n肩舆兀醉梦，所窥才一斑。\n偶投雉岩宿，洞穴穷孱颜。\n旁通赤明天，南极地所寰。\n更登云外顶，下视江湾湾。\n群仙无我笑，畏汝碧玉环。\n我久堕尘网，岁晚嗟良难。\n往来等幻化，南北俱乡关。\n却怜雪花儿，三生此山閒。\n愿力不汝无，永悟无所还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书祖显墨梅枕屏","author":"章甫","text":"我曾醉卧勇庵床，酒渴依然梦吸江。\n晚角吹回灯尚在，眼花错认月横窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书壁","author":"章甫","text":"禽声春后变，柳色夜来深。\n老子关门坐，无人识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"章甫","text":"今朝忽至前，郭索当炎伏。\n也知楚人馋，不待秋霜熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖游上人相访于白沙翌日如金山求诗 其二","author":"章甫","text":"宗师贪寂灭，祖道益衰迟。\n只有青山色，相逢似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖游上人相访于白沙翌日如金山求诗 其一","author":"章甫","text":"剥啄惊春睡，萧然湖上僧。\n篝灯夜深语，多说鉴巴陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖游上人相访于白沙翌日如金山求诗 其三","author":"章甫","text":"江草随春远，沙鸥伴我閒。\n殷勤东去水，送子过金山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后十小绝以一雨洗残暑万家生早凉为韵 其五","author":"章甫","text":"百岁已逾半，知复几寒暑。\n此事当究观，勿共俗子语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后十小绝以一雨洗残暑万家生早凉为韵 其六","author":"章甫","text":"长安卿相家，一食费几万。\n有功享固宜，我辈且蔬饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晓 其五","author":"章甫","text":"扰扰世间事，悠悠眼中人。\n幽怀与谁语，独立望秋旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晓 其四","author":"章甫","text":"鸿雁何时来，肃肃楚天晓。\n悲鸣向江南，江北稻粱少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵再可以通一所作梅雀求题","author":"章甫","text":"老去诗情在，逢春祇欲狂。\n飞来枝上雀，似亦爱幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡圃残雪三首 其一","author":"杨万里","text":"半依篱脚半依城，多傍梅边水际亭。\n最是晚晴斜照里，黄金日射万银星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡圃残雪三首 其二","author":"杨万里","text":"南风融雪北风凝，晚日城头已可登。\n莫道雪融便无迹，雪融成水水成冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄金山良书记 其二","author":"章甫","text":"不向金山作主人，春江鸥鸟定相亲。\n凭君与问寒岩树，今见桃花几度新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄金山良书记 其一","author":"章甫","text":"浮玉山头屋数椽，同龛弥勒忆当年。\n祇今输与良书记，睡起晴窗看钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葡萄 其二","author":"章甫","text":"磊落堆盘亦快哉，无人能寄一枝来。\n平生不识凉州酒，汉水遥怜似泼醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葡萄 其一","author":"章甫","text":"马乳酸甜自旧知，眼寒久不见生枝。\n中原有路人难到，北客思乡泪欲垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"章甫","text":"日长睡足傍帘栊，庭院初收落絮风。\n叶底樱桃浑可摘，黄莺不离绿阴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"章甫","text":"登高长是易销魂，多病新来目更昏。\n强引儿童追节物，久拚身世任乾坤。\n江风冷拂乌纱帽，篱菊香浮老瓦盆。\n回首西湖如昨日，交游凋谢不堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日寿之见过","author":"章甫","text":"老去犹耽酒，归来自拨醅。\n绝怜黄菊好，仍有故人来。\n怀古空三叹，挼香更一杯。\n横山无十里，骑马未须回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月朔巢县道中","author":"章甫","text":"瘦马从摇兀，行装更寂寥。\n老来宁浪出，此去有佳招。\n岁暮风霜苦，山长馆舍遥。\n儿曹应念我，今日是生朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜焕之求双竹","author":"章甫","text":"结屋清江上，怜君雅趣深。\n自移双竹种，分得半檐阴。\n特立夷齐节，相看管鲍心。\n祇应风雨夜，听此两龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上黄漕","author":"章甫","text":"汉初曲逆未侯日，穷巷席门谁见收。\n固是知人甚难事，悬知同类合相求。\n客怀夜雨打破壁，世事春江横钓舟。\n为报能文韩吏部，吹嘘籍湜预名流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"章甫","text":"江行风浪恶，石路仆夫劳。\n一水几回度，乱山无数高。\n村醪清似镜，早稻细如毛。\n愁听田家语，令人首屡搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不寐","author":"章甫","text":"不眠知夜永，危坐起忧端。\n木叶纷犹落，篝灯炯未残。\n年华今晼晚，边堠且平安。\n以我衣裳冷，遥怜弟妹寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予归自都梁魏子深来自滁州坐间酌酒","author":"章甫","text":"道路长年笑此身，绝怜尘土涴衣巾。\n飞花数点已愁客，归雁一声如唤人。\n州县驱驰君欲老，江湖流落我常贫。\n相逢却恨成匆遽，不醉沙头烂熳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆王履方","author":"章甫","text":"江头今日少风埃，时有閒云出断崖。\n入网河豚来近市，争巢野鹊堕空阶。\n偶行芳草得佳句，不见故人无好怀。\n愁送客帆西去尽，日随潮水到秦淮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆弟妹","author":"章甫","text":"新年思弟妹，何处有田园。\n见面宁无日，伤心不忍言。\n飘零空岁晚，契阔又春暄。\n肠断东来水，滔滔共一源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"章甫","text":"棋局机心在，诗篇习气馀。\n去来旋磨蚁，生死蠹书鱼。\n阅世双蓬鬓，还山一草庐。\n苦无食衣计，不是故踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王梦得意久出远归惠诗次韵","author":"章甫","text":"手栽桃李已成花，久客归心急莫鸦。\n别后新诗圆似弹，依前瘦马钝如蛙。\n路长人困煎茶店，春去莺啼卖酒家。\n三径未荒还寄傲，只应清梦到京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王漕舟行邵伯枯河之间一花独秀有诗次韵","author":"章甫","text":"志在冥鸿上，舟行白鹭群。\n水花明晚色，诗态蔼春云。\n独立兴三叹，孤斟为十分。\n锦囊曾不惜，还遣野人闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白露 其一","author":"章甫","text":"岁旱今如此，天高岂不闻。\n家家望秋谷，日日有閒云。\n圣主焦劳甚，群公献纳勤。\n老农愁欲死，祈祷漫纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白露 其二","author":"章甫","text":"烈日照平野，狂风吹槁苗。\n皇天无一雨，白露只明朝。\n世路多艰险，人心恐动摇。\n愁来唯有酒，聊以永今宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其二","author":"章甫","text":"黄闼清华选，湖山烂熳游。\n秋筠同节操，春柳似风流。\n须鬓茎茎白，园林事事幽。\n天然诗句好，初不待穷搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其一","author":"章甫","text":"公合麒麟画，吾今麋鹿群。\n别离频换岁，梦寐昔论文。\n寒尽春生后，泾清渭浊分。\n喜还亲几席，语妙得时闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其三","author":"章甫","text":"红紫今无几，寒暄尚未齐。\n春愁人更瘦，午醉日还西。\n课仆除新草，呼儿检旧题。\n空庭可徐步，藜杖故相携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同汤叔度兄弟赋秋声","author":"章甫","text":"古木斜阳暮，寒江澹月秋。\n萧骚初满耳，蟋蟀最关愁。\n茅屋疑鸣雨，云溪想枕流。\n几回连别恨，为我过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同杨德骏任致道登北观留题壁间","author":"章甫","text":"年来多病废幽寻，眼底风光亦倦吟。\n岁暮情怀伤老大，雪晴筋力试登临。\n一江烟水分南北，千里云山自古今。\n杖屦频来端不恶，只愁东望起归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多日不收家信再和呈丁合州","author":"章甫","text":"邮亭盘礴已六日，清坐了无尘事随。\n书寄弟兄犹未到，梦游京浙不胜驰。\n江边短艇雨千点，竹里疏烟梅一枝。\n儿女未知为客恨，但争柑橘绕庭墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守倅元日唱酬次韵","author":"章甫","text":"别驾篇章敏，黄堂句法新。\n宜民多受福，把笔竞题春。\n拖玉丹墀晓，鸣珂紫陌尘。\n退朝如有作，应亦念兹辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答王通一","author":"章甫","text":"底事重来淮上村，九关难上阻司阍。\n短衣他日欲射虎，堂印何时看倒盆。\n花著襟裾无定力，雪侵须鬓有愁根。\n天河且挽洗疮疥，若问甲兵君莫论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏简李清宇","author":"章甫","text":"四十九年真大谬，三百六旬长鲜驩。\n人生一梦何足较，田谷荐饥良独难。\n酒边志气漫豪放，眼中骨相殊酸寒。\n输与能诗李供奉，水旱不忧吾有官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王勉夫见招 其二","author":"章甫","text":"风月分公宇，图书静客堂。\n交情知烂熳，暇日想徜徉。\n我老嗟筋力，诗成损肾肠。\n报章惭不敏，秋至足悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王勉夫见招 其一","author":"章甫","text":"浪迹踰三纪，知音只数公。\n拙非今日用，愚与古人同。\n宾客虽常满，箪瓢或屡空。\n躬耕逢岁旱，拄杖立西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次仲韩韵兼简若晦","author":"章甫","text":"世途时事两艰难，上水船行八节滩。\n旅雁唤愁秋已尽，邻鸡惊梦夜将阑。\n醉狂终是心情懒，老瘦非关骨相寒。\n閒忆能诗俞与赵，久无妙语发毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张子仪韵","author":"章甫","text":"半生江海惯浮游，邂逅今成客此州。\n忧国幸逢年谷熟，望乡长恨晚山稠。\n连天烟雨双鸿雁，满地风波一白鸥。\n独把酒杯悲节物，何时弟劝与兄酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次郝泽民韵","author":"章甫","text":"归雁冲寒去，栖乌向日啼。\n山明初过雨，沙静不多泥。\n江上梅花细，村中酒价低。\n无人可同出，课仆理荒畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次通一见诒韵","author":"章甫","text":"酒力添春意，诗魔恼夜眠。\n老来尤惜日，客里又逢年。\n送雁寒云外，寻梅野水边。\n无钱供剧饮，空枉故人篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次郭遐龄所携张安国诗韵","author":"章甫","text":"早作诸公客，过门竞挽留。\n忧时心尚壮，怀旧涕难收。\n富贵来何晚，文章老更优。\n尊前身健在，不必问封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次惠老见诒","author":"章甫","text":"别去忽三纪，馀生能几年。\n相看双眼碧，且喜一灯传。\n禅病君无恼，诗狂我欲仙。\n剧谈成绝倒，还似蜜中边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韩无咎盱眙道中韵","author":"章甫","text":"人家过午绝炊烟，陇上羸牛挽不前。\n寇退皇恩方掩骼，民饥客饭只烹鲜。\n观风到处春随马，楗水归时月满川。\n王事独贤无倦色，鸡鸣起坐屋三椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韩无咎途中寄陆务观 其一","author":"章甫","text":"风高微退鹢，云好合从龙。\n萧艾长贪雨，松筠却耐冬。\n禁途今不远，归兴未应浓。\n莫羡朱双毂，相期禄万钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韩无咎途中寄陆务观 其四","author":"章甫","text":"昼永浑无事，昏归只掩门。\n甘贫同陋巷，多病似文园。\n对月人千里，论文酒一尊。\n远怀霄汉路，愁绝虎狼村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韩无咎途中寄陆务观 其五","author":"章甫","text":"园笋看成竹，庭榴已著花。\n老来犹是客，归去亦无家。\n万事大槐国，一身焦谷芽。\n心閒聊默坐，红日下天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韩无咎途中寄陆务观 其三","author":"章甫","text":"寒梅欺雪白，腊酒爱鹅黄。\n花下觥筹乱，灯前锦绣香。\n醉吟挥字大，愁别听更长。\n近报蛾眉好，何时奉一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韩无咎途中寄陆务观 其二","author":"章甫","text":"戎马驰驱日，江湖邂逅间。\n笑谈无逆旅，翰墨落名山。\n画省春风入，渔舟夜月还。\n唱酬能见记，书札忍令悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江北","author":"章甫","text":"江北多戎马，江南有战船。\n艰难吾欲老，辗转夜无眠。\n归去须三径，飘零又一年。\n邻舟听客语，愁绝晚来天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕戏简胥直夫","author":"章甫","text":"小雨催耕苦未匀，东风吹水起鱼鳞。\n兵戈关塞今年定，灯火江城此夜新。\n万点飞花愁客子，一天明月属游人。\n旧时面壁胥居士，何处笙歌作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕韩使君惠谷帘泉","author":"章甫","text":"忆昨嬉游不忍閒，祇今但欲掩柴关。\n短檠无恙客多病，明月有情天若悭。\n落日哦诗方袖手，故人忆我未还山。\n归家且酌康庐水，恍堕千岩紫翠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中简祖显 其一","author":"章甫","text":"计拙生无益，时危老可伤。\n江山双敝屣，诗酒一空囊。\n夜雨茆庐破，秋风菊径荒。\n閒随枕流客，蓑笠钓沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]