[{"title":"步绕","author":"余观复","text":"步绕苍苔自咏诗，吟情惟有涧泉知。\n山猿忽地来偷果，攀断庭前乌桕枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居即事","author":"余观复","text":"密竹环茆舍，应无俗士过。\n睡浓嫌日出，坐久厌尘多。\n斗雀翻危叶，饥鹅唼短莎。\n世涂真九曲，奔走欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵春日","author":"余观复","text":"日淡风轻养物华，老天将此付诗家。\n人情巧似营巢燕，春意忙于赴壑蛇。\n寂寞兰亭空有感，凄凉金谷竟谁誇。\n绝怜狂甚樊川杜，枉杀吟情豆蔻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"余观复","text":"群卉皆舆隶，孤标真圣贤。\n乾坤清不彻，风月兴无边。\n生意春常在，贞心晚更坚。\n骚经虽不载，已入二南篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"余观复","text":"自是孤芳集大成，红红白白漫争名。\n天边差有雪堪亚，世上更无花敢清。\n笔到花光空幻相，句如和靖蔼遗声。\n一枝勾引窗前月，冷淡相看太古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀","author":"余观复","text":"盘盘老桂树，金屑黄?松。\n孕此无尽香，袭袭乘西风。\n幽人为延伫，古意滋无穷。\n王孙招不来，西郊草蒙茸。\n欲以遗远者，道阻嗟难从。\n□□不忍替，揽之寄房栊。\n梦魂恍而清，夜午超鸿濛。\n常恐芳气歇，我恨何时终。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏怀","author":"余观复","text":"山容洗眼青，江光照肌白。\n翻枝鹊查查，抱叶蝉啧啧。\n蒹葭摇风声，梧桐淡秋色。\n草木了无能，阴阳互相激。\n人于大化中，真成逆旅客。\n藏舟夜半移，不假贲育力。\n尘网罩八纮，贪夫受罗织。\n蹇予丘壑姿，一室颇安适。\n荒寻纵奇怀，清诡吊尘迹。\n风摇泛海槎，雨涩登山屐。\n世远事荒唐，天高兴寥阒。\n渺渺孤征鸿，一举振六翮。\n此意人莫知，独啸岩扉寂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读柴桑集","author":"余观复","text":"游心太古初，得句万物表。\n平生一樽酒，寂寞三径小。\n有琴不张弦，正以知音少。\n伊予挹残芳，道心炯相照。\n北窗清梦长，山间自啼鸟。\n吾欲问先生，天阔白云杳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄伯成 其二","author":"余观复","text":"风雅不可复，亦乃世代然。\n君看黄初语，已减河梁篇。\n神思透溟涬，至宝辞雕镌。\n党欲剩著语，不如寂无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄伯成 其一","author":"余观复","text":"昔别青梅酸，今来黄叶堕。\n叶堕却归根，窗隙见驹过。\n大巧亦自然，小智空琐琐。\n一言取封侯，千金贾奇祸。\n达人知倚伏，去就无不可。\n天公亦可为，妙用正在我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花引","author":"余观复","text":"耨银云，锄璧月，栽得寒花寄愁绝。\n阳和一点来天根，春满江南谁漏泄。\n珊瑚作树玉为肤，沉水熏香檀吐屑。\n野桥横，寒涧洁，斜梢舞破屋角烟，老树压残墙角雪。\n风流不肯王谢俦，孤高尚笑夷齐劣。\n萧然与俗最无缘，此话难明向谁说。\n绝爱西湖君，暗香浮动月黄昏。\n亦爱东坡老，竹外一枝斜更好。\n二仙去矣花寂寥，著语压花花不倒。\n谁能淡笔传其真，谁能楚语招其魂。\n参横月落兴未了，三叫花神闻不闻。\n花影摇摇情默默，冷透吟脾醒醉魄。\n问渠桃李岂知春，西抹东涂受春役。\n自然香，无色色。\n谯楼角动霜初飞，萧寺钟鸣天欲白。\n披衣绕遍树头行，判断人间风月国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游虎邱","author":"余伯皋","text":"才出阊门望虎邱，马行冲雨上扁舟。\n绿杨碧草沿溪岸，白水青苗满稻畴。\n云雾黯然方润溽，山林蕞尔自清幽。\n吴王邱墓分无所，英气犹依剑石留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和余天开见寄","author":"余宏孙","text":"春树君方吟渭北，林塘我已卜溪西。\n赏心乐事优游处，花自飞飞鸟自啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和通山尹张松坡梦游庐山吟","author":"余宏孙","text":"我行匡庐鬓青青，往往大醉琵琶亭。\n归来老我二十载，惟有梦寐劳神形。\n有时遍历开先寺，老僧禅定齁齁睡。\n有时经过五柳家，秫香酒熟邀人醉。\n恍兮惚兮真若飞，高泊天池坐忘归。\n晴云漠漠披絮帽，白鹤冉冉来羽衣。\n方将餐霞炼颜色，觉来无失亦无得。\n何当整理下泽车，共逐双凫访真迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蒋颍叔泾溪","author":"余良肱","text":"画舸夷犹紫翠间，暮云如扫月如环。\n三山六刺须臾过，恰似严陵七里滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"教子诗","author":"余良弼","text":"白发无凭吾老矣，青春不再汝知乎。\n年将弱冠非童子，学不成名岂丈夫。\n幸有明窗群净几，何劳凿壁与编蒲。\n功成欲自殊头角，记取韩公训阿符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"余叔英","text":"野市人来郢，毗邻水接襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祥符寺水阁","author":"余国宝","text":"楚江空阔水痕收，葭苇萧萧两岸幽。\n柔橹推残千顷浪，好风吹过一帆愁。\n人归别浦云烟晚，舟泊寒沙岛屿秋。\n领略风光须我辈，谩寻诗句倚江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平园","author":"余季芳","text":"柳暗花明自一春，青山缭绕水如襟。\n偶然觅得桃源路，便欲分栖竹屋阴。\n清昼平原寻小隐，夕阳归路入閒吟。\n迟迟风袂烟堤上，遥望环溪鸭绿深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄","author":"馀杭令","text":"野服萧萧款翠微，虚亭高敞射晴晖。\n仙归洞府云烟静，春入名山笋蕨肥。\n缓饮壶觞聊自适，暂指朱墨便忘归。\n何时罢脱利名去，始悟人间万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙","author":"余玠","text":"怪新来瘦损。\n对镜台、霜华零乱鬓影。\n胸中恨谁省。\n正关山寂寞，暮天风景。\n貂裘渐冷。\n听梧桐、声敲露井。\n可无人、为向楼头，试问塞鸿音信。\n争忍。\n勾引愁绪，半掩金铺，雨欺灯晕。\n家僮困卧，呼不应，自高枕。\n待催他、天际银蟾飞上，唤取嫦娥细问。\n要乾坤，表里光辉，照予醉饮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"余玠","text":"老子也曾来伺候，诸公聊复忍须臾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句三首 其三","author":"余知阁","text":"千里旌旗拥六飞，投簪欲上钓鱼矶。\n无端忽被闲云引，回耀峰前掩竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句三首 其二","author":"余知阁","text":"洛邑名园歌舞沈，乱鸦啼破几深林。\n何人学得香山老，千载精庐有梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句三首 其一","author":"余知阁","text":"几年魂绕浙城西，十里荷花漾锦陂。\n踏遍两峰三竺路，又随青嶂入云栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登翠微亭 其一","author":"余迪","text":"数年乐此宦池城，每爱湖光分外清。\n远浦落霞秋水阔，乱山斜日碧云横。\n牧吹牛背归林晚，渔唱舟中对月明。\n同览翠微重吊古，谩将诗酒逐交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题韩仲止壁二首 其二","author":"余俦","text":"名闻由昔者，礼进合欣然。\n古有不屑教，意令加后鞭。\n尚书八座贵，吏部一灯传。\n惊代文章伯，曾容贾浪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题韩仲止壁二首 其一","author":"余俦","text":"谒入久不出，兀坐如枯荄。\n苍头前致词，问我何因来。\n士节久凋丧，人情易嫌猜。\n本无性命忧，不去安待哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"报恩寺","author":"余复","text":"大山奔到海之滨，中有辉光佛刹新。\n前后二三皆梵侣，不知谁是报恩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和御赐登第","author":"余复","text":"风虎云龙岂偶然，信知盛世士多贤。\n虞庠教育蒙深泽，汉殿咨询愧首延。\n释褐遽沾琼宴宠，锡诗齐听玉音宣。\n爱君忧国平生志，敢负周王宴乐篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文笔峰","author":"余复","text":"一飞一飞知几时，斗酒落魄谁共知。\n胸中造物饱星斗，笔下文字盘蛟螭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙霞岭","author":"余复","text":"二十年前过此间，旅囊羞涩笔头悭。\n时来山色与人好，我亦诗肠似海宽。\n旧事消除身后梦，新声惭愧路旁官。\n乘车衣锦浑闲事，留此功名竹帛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西陂","author":"余复","text":"涉海波涛险，登山足力疲。\n胡为赤鉴游，海角山之涯。\n崎岖乱石间，况复乘船危。\n兹游固有意，访古伤今时。\n荒陂存遗迹，缺处十丈馀。\n父老向我言，先畴为农师。\n当时大父行，相与筑此堤。\n堤成百物丰，师承及见之。\n稻蟹不论钱，况敢论糠秕。\n一朝坏不修，惊心伤鼓鼙。\n田家岁作苦，土狭何由支。\n忆昔禾黍地，石水数斗泥。\n前功嗟已废，继者今其谁。\n曾闻部使者，询问及故基。\n水利固可究，具文怨徒欺。\n又闻劝农吏，楚楚多奇姿。\n朝游暮始还，山水穷清晖。\n有念不及此，但见冠盖飞。\n公家急相敛，星火惊文移。\n农无地可耕，岁入何从规。\n今幸长官贤，愿言拯我饥。\n作书白太守，经营得如兹。\n珍重父老言，岂为儿童戏。\n皇华如观风，此老诚可资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金鳌桥","author":"余复","text":"吾闽三山妙天下，灵鳌背上罗高峰。\n山环水绕龙虎伏，人在缥渺烟霞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞峰","author":"余复","text":"海上一峰高插天，山头眼力穷大千。\n飞来鸿鹄下霄汉，掩翼缩足今三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霍童山","author":"余复","text":"霍童山峰凡六六，不知仙子在何山。\n秋风万里一黄鹤，返照半林双白鹇。\n长剑气横霄汉外，飞泉影落画图间。\n自怜懒作朝阳客，访道寻真日往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"余某","text":"此生待足何时足，未老得闲方是闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"余洪道","text":"须知凡卉空千万，不似寒花只两三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"余洪道","text":"著心计较般般错，退步思量事事宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"余洪道","text":"世上声名无买处，人间官职有来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃红/连理枝","author":"余桂英","text":"芳草连天暮。\n斜日明汀渚。\n懊恨东风，恍如春梦，匆匆又去。\n早知人、酒病更诗愁，镇轻随飞絮。\n宝镜空留恨，筝雁浑无据。\n门外当时，薄情流水，如今何处。\n正相思、望断碧山云，又莺啼晚雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题遗直轩","author":"余淳礼","text":"二苏翰墨仙，同谪百蛮里。\n时有田舍翁，结茅住行李。\n迩来三十年，闻名辄掩耳。\n天定能胜人，稍复蒙料理。\n公卿寻断编，台隶藏敝屣。\n败屋亦见修，变故乃如此。\n开轩画遗像，凛凛有生气。\n却恨封德彝，不见盛时死。\n兄弟对床眠，此意孤一世。\n骑鲸傥相逢，笑人真好事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重修朝宗门楼集句呈王宰","author":"余壹","text":"兹城实佳丽，上与浮云齐。\n回望川之阴，津途去不迷。\n一旦起楼高百尺，城高跨楼满金碧。\n朱门峨峨临九衢，一片彩霞迎晓日。\n好奇赏俊实难逢，看此宁避雨与风。\n仍誇县尹风骚客，与人一心成大功。\n应喜中原正无事，出为苍生作仙吏。\n大贤为政即多闻，不独文章推国器。\n立驱巘崿压波澜，千古烟霞一望间。\n江上晚来堪画处，丹青画出是君山。\n况乃烹鲜会嘉客，楼上重重歌吹发。\n艳歌一曲酒一杯，华筵有戏呈初彻。\n楼中美人夺神仙，轻身起舞红烛前。\n须臾宴罢日将夕，断烬遗香袅翠烟。\n四座少年君听取，太平时节难身遇。\n先生事业不可量，此中岂是久留处。\n且饮美酒登高楼，高视乾坤又何愁。\n早晚北门下徵诏，佩声归去凤池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送龙池廖先生开讲沙场诗","author":"余湜","text":"沙场诸子弟，少小尽晞颜。\n迎我五经笥，归来七岛山。\n朝游松子洞，暮宿惠人湾。\n讲罢西风里，扁舟早送还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"余湜","text":"西母已回金殿冷，绿珠一坠玉楼空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨梅","author":"余萼舒","text":"摘来鹤顶珠犹湿，点出龙睛泪未乾。\n若使太真知此味，荔支应不到长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三友堂","author":"余谦一","text":"岁晚惟松竹，于梅伯仲间。\n藉溪并白水，着个老屏山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈竹所帅越 其二","author":"余谦一","text":"供帐荣归一日同，故乡增重汉朝空。\n二疏事莫徵图画，西陌东阡看两翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈竹所帅越 其三","author":"余谦一","text":"便使丝絇离禁闼，还教牙纛傍天京。\n邺侯浪说君王宠，避谤江西几许程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城山国清塘","author":"余谦一","text":"湖光山色酒杯中，此会那知一笑同。\n风暖空岩落松子，雨晴新涨没凫翁。\n隔林村落微茫见，一径禅房曲折通。\n老艾当年题品处，斜阳无语想高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈郡倅用虎妻朱安人 其二","author":"余谦一","text":"太息睢阳事，重围保障孤。\n兄公能死节，女子亦捐躯。\n半被金闺婿，孤灯自发姑。\n百年遗恨处，风雨暗环湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈郡倅用虎妻朱安人 其一","author":"余谦一","text":"阖郡无男子，夫人可奈何。\n平生羞蔡琰，一死伴湘娥。\n门盍来旌表，邻应辍杵歌。\n潘郎家国恨，怪得鬓丝多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡竹庄元夕","author":"余谦一","text":"佳人月下翠成行，团铺高张椀舞忙。\n想见风情杜书记，暗中挥泪忆钱塘。\n一老东家唤不应，当年膴仕正承平。\n何人诵得科灯判，莫向膏脂上取明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈竹所帅越 其一","author":"余谦一","text":"留侯羽翼计危成，谁遣鸿飞避杳冥。\n一女倚楹犹有识，不知柱后立何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温陵吴氏瓠斋 其二","author":"余谦一","text":"大樗大椿等类，率是内篇寓言。\n我谓惠王瓠种，合种庄家漆园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温陵吴氏瓠斋 其四","author":"余谦一","text":"提壶足供杯勺，吹匏可入弦歌。\n一瓢濩落无用，无奈夫君拙何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温陵吴氏瓠斋 其一","author":"余谦一","text":"试问高斋底许，瓠瓜星舍明边。\n椰大能容千古，壶中别有洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温陵吴氏瓠斋 其三","author":"余谦一","text":"诗记断壶秋半，易占硕果春先。\n粒许中间种子，乾坤生意无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题白云院","author":"余越","text":"松花蔌蔌糁苍苔，墙角梧桐取次开。\n倚遍阑干人未去，一双白鹭破山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄宫","author":"余愚","text":"琳宫胜处绝尘嚣，千古佳名号洞霄。\n地锁九峰形屈曲，擎天一柱势岧峣。\n凤鸣怪石仙岩邃，蛟舞流泉涧壑遥。\n幸有飞升遗迹在，便须骑鹤快扶摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马当呼鸦不至偶成呈同行诸官","author":"余靖","text":"昔年曾泛马当湾，团饭唤鸦篙楫间。\n今日江头飞不下，应知人世足机关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五色雀","author":"余靖","text":"五方纯色俨衣冠，应是山灵寄羽翰。\n多谢相逢殊俗眼，谪官犹作贵人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁化锦石岩","author":"余靖","text":"巉岩绚烂倚云隈，万玉无香结作堆。\n不是虬龙眠铁树，原来假石作根荄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬月茹青台子有感","author":"余靖","text":"雪霜不到海山隅，随分园蔬助醊餔。\n万物无情乘暖长，秦皇何事枉坑儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再简伯恭","author":"余靖","text":"十载京华九日期，帝家园苑醉金卮。\n今朝郭外寻僧话，坐听寒泉绕竹篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲江津亭谒华严长老见所赐御书因成二韵","author":"余靖","text":"数年不侍御炉傍，梦断千山隔帝乡。\n今日见师堪下泪，御书开卷带天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]