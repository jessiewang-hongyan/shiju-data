[{"title":"题徐浩书法华经","author":"王安石","text":"一切法无差，水牛生象牙。\n莫将无量义，欲觅妙莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题舫子","author":"王安石","text":"爱此江边好，留连至日斜。\n眠分黄犊草，坐占白鸥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题景德寺试院壁","author":"王安石","text":"屋东瓜蔓已扶疏，小石蓝花破萼初。\n从此到寒能几日，风沙还见一年除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕","author":"王安石","text":"处处定知秋后别，年年长向社前逢。\n行藏自欲追时节，岂是人间不见容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠外孙","author":"王安石","text":"南山新长凤凰雏，眉目分明画不如。\n年小从他爱梨栗，长成须读五车书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠安大师","author":"王安石","text":"独龙冈北第三峰，逋客归来老更慵。\n败屋数椽青缭绕，冷云深处不闻钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张轩民赞善","author":"王安石","text":"潮打空城寂寞回，百年多病独登台。\n谁人得似张公子，有底忙时不肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠僧","author":"王安石","text":"纷纷扰扰十年间，世事何尝不强颜。\n亦欲心如秋水静，应须身似岭云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"默默","author":"王安石","text":"默默长年有所思，世间谈笑强追随。\n苍髯欲出朱颜谢，更觉求田问舍迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁年","author":"王安石","text":"丁年结客盛游从，宛洛毡车处处逢。\n吟尽物华愁笔老，醉消春色爱醅浓。\n垆间寂寞相如病，锻处荒凉叔夜慵。\n早晚青云须自致，立谈平取彻侯封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登东山寄昌叔","author":"王安石","text":"城上啼乌破寂寥，思君何处坐岧峣。\n应须绿酒酬黄菊，何必红裙弄紫箫。\n落木云连秋水渡，乱山烟入夕阳桥。\n渊明久负东篱醉，犹分低心事折腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八功德水","author":"王安石","text":"雪山马口出琉璃，闻说诸天与护持。\n此水遥连八功德，供人真净四威仪。\n当时迦叶无尘染，何事阌乡有土思。\n道力起缘非一路，但知瓢饮是生疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又段氏园亭","author":"王安石","text":"攲眠随水转东垣，一点炊烟映水昏。\n漫漫芙蕖难觅路，翛翛杨柳独知门。\n青山呈露新如染，白鸟嬉游静不烦。\n朱雀航边今有此，可能摇荡武陵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元戏呈贡父","author":"王安石","text":"车马纷纷白昼同，万家灯火暖春风。\n别开阊阖壶天外，特起蓬莱陆海中。\n尽取繁华供侠少，祇分牢落与衰翁。\n不知太乙游何处，定把青藜独照公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上西垣舍人","author":"王安石","text":"共说才高世所珍，诸贤谁敢望光尘。\n讨论润色今为美，学问文章老更醇。\n赋拟相如真复似，诗看子建的应亲。\n仍闻悟主言多直，许史家儿往往嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与宝觉宿精舍","author":"王安石","text":"扰扰复翩翩，秋床烛屡昏。\n真为说万物，岂止挟三言。\n问义曹溪室，捐书阙里门。\n若知同二妄，目击道逾存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与舍弟华藏院此君亭咏竹","author":"王安石","text":"一径森然四座凉，残阴馀韵去何长。\n人怜直节生来瘦，自许高材老更刚。\n会与蒿藜同雨露，终随松柏到冰霜。\n烦君惜取根株在，欲乞伶伦学凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛口见月","author":"苏轼","text":"掩窗寂已睡，月脚垂孤光。\n披衣起周览，飞露洒我裳。\n山川同一色，浩若涉大荒。\n幽怀耿不寐，四顾独徬徨。\n忽忆丙申年，京邑大雨霶。\n蔡河中夜决，横浸国南方。\n车马无复见，纷纷操筏郎。\n新秋忽已晴，九陌尚汪洋。\n龙津观夜市，灯火亦煌煌。\n新月皎如昼，疏星弄寒芒。\n不知京国喧，谓是江湖乡。\n今来牛口渚，见月重凄凉。\n却思旧游处，满陌沙尘黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与微之同赋梅花得香字三首 其三","author":"王安石","text":"浅浅池塘短短墙，年年为尔惜流芳。\n向人自有无言意，倾国天教抵死香。\n须袅黄金危欲堕，蒂团红蜡巧能装。\n婵娟一种如冰雪，依倚春风笑野棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与微之同赋梅花得香字三首 其二","author":"王安石","text":"结子非贪鼎鼐尝，偶先红杏占年芳。\n从教腊雪埋藏得，却怕春风漏泄香。\n不御铅华知国色，祇裁云缕想仙装。\n少陵为尔牵诗兴，可是无心赋海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与微之同赋梅花得香字三首 其一","author":"王安石","text":"汉宫娇额半涂黄，粉色凌寒透薄妆。\n好借月魂来映烛，恐随春梦去飞扬。\n风亭把盏酬孤艳，雪径回舆认暗香。\n不为调羹应结子，直须留此占年芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小姑","author":"王安石","text":"小姑未嫁与兰支，何恨流传乐府诗。\n初学水仙骑赤鲤，竟寻山鬼从文狸。\n缤纷云䙱空棠楫，绰约烟鬟独桂旗。\n弄玉有祠终或往，飞琼无梦故难知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"王安石","text":"出写清浅景，归穿苍翠阴。\n平头均楚制，长耳嗣吴吟。\n暮岭已佳色，寒泉仍好音。\n谁同此真意，倦鸟亦幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居杂言","author":"王安石","text":"法和衣钵过南华，正叶传师萃一花。\n胜地雾迷淮水石，望星人指楚天涯。\n数千松倚西山老，七百僧悲去路赊。\n一片苍苔涅槃石，至今缭绕白云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马玘大夫挽辞","author":"王安石","text":"冠盖青门道，知君自少时。\n从容他日喜，奄忽暮年悲。\n江月明丹旐，湖风冷穗帷。\n音容虽可想，材力竟何施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不到太初兄所居遂已十年以诗攀寄","author":"王安石","text":"一水衣巾剪翠绡，九峰环佩刻青瑶。\n生才故有山川气，卜筑兼无市井嚣。\n三叶素风门阀在，十年陈迹履綦销。\n归荣早晚重携手，莫负幽人久见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中书偶成","author":"王安石","text":"忽忽余年往，茫茫不自知。\n慇勤照清浅，邂逅见衰迟。\n辅世无贤业，容身有圣时。\n归欤今可矣，何以长人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为裴使君赋拟岘台","author":"王安石","text":"君作新台拟岘山，羊公千载得追攀。\n歌钟殷地登临处，花木移春指顾间。\n城似大堤来宛宛，溪如清汉落潺潺。\n时平不比征吴日，缓带尤宜向此闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌塘","author":"王安石","text":"地僻居人少，山稠伏兽多。\n怒狸朝搏雁，嚵虎夜窥骡。\n篱落生孙竹，门庭上女萝。\n未应悲寂寞，六载一经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予求守江阴未得酬昌叔忆江阴见及之作","author":"王安石","text":"黄田港北水如天，万里风樯看贾船。\n海外珠犀常入市，人间鱼蟹不论钱。\n高亭笑语如昨日，末路尘沙非少年。\n强乞一官终未得，祇君同病肯相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽辞四首 其四","author":"王安石","text":"同执群方至，因山十月催。\n永违天日表，空有肺肝摧。\n帐殿流苏卷，铃歌薤露哀。\n宫中垂晓轫，西去不更回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽辞四首 其三","author":"王安石","text":"厌代人间世，收神天上游。\n遽然虚玉座，不复望珠旒。\n待旦移巾帻，饔人改膳羞。\n寻常飞白几，寂寞暗尘浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽辞四首 其二","author":"王安石","text":"凭几微言绝，群臣涕泗挥。\n哀号三级陛，缟素九重围。\n天上仙游远，宫中御座非。\n最悲帷幄侍，不复未明衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽辞四首 其一","author":"王安石","text":"去序三朝圣，行崩万国天。\n忧勤无旷古，治洽最长年。\n仁育齐高厚，哀思罄幅员。\n欲知千载美，道德冠遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元珍以诗送绿石砚所谓玉堂新样者","author":"王安石","text":"玉堂新样世争传，况以蛮溪绿石镌。\n嗟我长来无异物，愧君持赠有佳篇。\n久埋瘴雾看犹湿，一取春波洗更鲜。\n还与故人袍色似，论心于此亦同坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元献晏公挽辞三首 其三","author":"王安石","text":"感会真奇遇，飞扬独妙龄。\n他年西饯日，此夜上骑星。\n宿惠留藩屏，馀忠在禁庭。\n音容无处所，彷佛寄丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元献晏公挽辞三首 其二","author":"王安石","text":"终贾年方妙，萧曹地已亲。\n优游太平日，密勿老成人。\n抗论辞多秘，赓歌迹已陈。\n功名千载下，不负汉庭臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元献晏公挽辞三首 其一","author":"王安石","text":"文章晋康乐，经术汉公孙。\n旧秩疑丞贵，前功保傅尊。\n传呼犹在耳，会哭已填门。\n萧瑟城南路，鸣笳上九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公辟枉道见过获闻新诗因叙叹仰","author":"王安石","text":"青丘神父能为政，碧落仙翁好作诗。\n旧事齐儿应共记，新篇楚老得先知。\n怀砖大岘如迎日，供帐阊门胜去时。\n若与鸱夷斗百草，锦囊佳丽敌西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午枕","author":"王安石","text":"百年春梦去悠悠，不复吹箫向此留。\n野草自花还自落，鸣禽相乳亦相酬。\n旧蹊埋没开新径，朱户攲斜见画楼。\n欲把一杯无伴侣，眼看兴废使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰寒食","author":"王安石","text":"客思似杨柳，春风千万条。\n更倾寒食泪，欲涨冶城潮。\n巾发雪争出，镜颜朱早雕。\n未知轩冕乐，但欲老渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太湖恬亭","author":"王安石","text":"槛临溪上绿阴围，溪岸高低入翠微。\n日落断桥人独立，水涵幽树鸟相依。\n清游始觉心无累，静处谁知世有机。\n更待夜深同徙倚，秋风斜月钓船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尹村道中","author":"王安石","text":"满眼霜吹宿草根，谩知新岁不逢春。\n却疑青嶂非人世，更觉黄云是塞尘。\n万里张侯能奉使，百年曾子肯辞亲。\n自怜许国终无用，何事纷纷客此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文元贾公挽辞二首 其二","author":"王安石","text":"铭旌萧飒九秋风，薤露悲歌落月中。\n华屋几人思谢傅，佳城今日闭滕公。\n名垂竹帛书勋在，神寄丹青审象同。\n天上貂蝉曾梦赐，归魂应佩紫阳宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文元贾公挽辞二首 其一","author":"王安石","text":"功名烜赫在三朝，经术从容辅汉条。\n儒服早纡丞相绂，戎冠再插侍中貂。\n开仓六塔流人复，出甲甘陵叛党销。\n东第祇今空画像，当时于此识风标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王子直挽辞","author":"王安石","text":"多才自合至公卿，岂料青衫困一生。\n太史有书能叙事，子云于世不徼名。\n丘坟惨淡箕山绿，门巷萧条颍水清。\n握手笑言如昨日，白头东望一伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王中甫学士挽辞","author":"王安石","text":"同学金陵最少年，奏书曾用牍三千。\n盛名非复居人后，壮岁如何弃我先。\n种橘园林无旧业，采蘋洲渚有新篇。\n蒜山东路春风绿，埋没谁知太守阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王村","author":"王安石","text":"晻霭王村路，春风北使旗。\n尘催轻骑走，寒咽短箫吹。\n揽辔联貂帽，投鞭各酒卮。\n纷纷小儿女，何事倚墙窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王浮梁太丞之听讼轩有水禽三巢于竹林之上恬而自得邑人作诗以美之因次元韵","author":"王安石","text":"水边舟动多惊散，何事林间近绝疑。\n野意肯从威令至，旧巢犹有主人知。\n不关饮啄春江暖，自在飞鸣夏日迟。\n览德岂无丹穴凤，到时应让向南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王逢原挽辞","author":"王安石","text":"蒿里竟何在，死生从此分。\n谩传仙掌籍，谁见鬼修文。\n蔡琰能传业，侯芭为起坟。\n伤心北风路，吹泪湿江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长干寺","author":"王安石","text":"梵馆清闲侧布金，小塘回曲翠文深。\n柳条不动千丝直，荷叶相依万盖阴。\n漠漠岑云相上下，翩翩沙鸟自浮沈。\n羁人乐此忘归思，忍向西风学越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长垣北","author":"王安石","text":"揽辔长垣北，貂寒不自持。\n霜风急鼓吹，烟月暗旌旗。\n骑火流星点，墙桑亚戟枝。\n柴荆掩春梦，谁见我行时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"世事","author":"王安石","text":"世事一何稠，论心日已偷。\n尚蒙今士笑，宜见古人羞。\n老圃聊须问，良田亦欲求。\n非关畏黻冕，无责易身修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙申八月作","author":"王安石","text":"秋风摧剥利如刀，漠漠昏烟玩日高。\n眼看南山露崖窾，心随东水转波涛。\n归期正自凭蓍蔡，生理应须问酒醪。\n还有诗书能慰我，不多霜雪上颠毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东皋","author":"王安石","text":"起伏晴云径，纵横暖水陂。\n草长流翠碧，花远没黄鹂。\n楚制从人笑，吴吟得自怡。\n东皋兴不浅，游走及芳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日","author":"王安石","text":"扰扰今非昔，漫漫夜复晨。\n风沙不贷客，云日欲迷人。\n散发愁边老，开颜醉后春。\n转思江海上，一洗白纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至","author":"王安石","text":"都城开博路，佳节一阳生。\n喜见儿童色，欢传市井声。\n幽闲亦聚集，珍丽各携擎。\n却忆他年事，关商闭不行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城访无党因宿斋馆","author":"王安石","text":"关外寻君信马蹄，漫成诗句任天倪。\n花枝到眼春相照，山色侵衣晚自迷。\n今日笑谈还喜共，经年劳逸固难齐。\n生涯零落归心懒，多谢慇勤杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山三咏 其二 觉海方丈","author":"王安石","text":"往来城府住山林，诸法翛然但一音。\n不与物违真道广，每随缘起自禅深。\n舌根已净谁能坏，足迹如空我得寻。\n岁晚北窗聊寄傲，蒲萄零落半床阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山三咏 其三 道光泉","author":"王安石","text":"箨龙将雨绕山行，注远投深静有声。\n云涌浴槽朝自暖，虹垂斋镬午还晴。\n铜瓶各满幽人意，玉甃因高正士名。\n神力可嗟妨智巧，桔槔零落便苔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山暮归示道人","author":"王安石","text":"千山复万山，行路有无间。\n花发蜂递绕，果垂猿对攀。\n独寻寒水度，欲趁夕阳还。\n天黑月未上，儿童初掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半山春晚即事","author":"王安石","text":"春风取花去，酬我以清阴。\n翳翳陂路静，交交园屋深。\n床敷每小息，杖屦或幽寻。\n惟有北山鸟，经过遗好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古松","author":"王安石","text":"森森直干百馀寻，高入青冥不附林。\n万壑风生成夜响，千山月照挂秋阴。\n岂因粪壤栽培力，自得乾坤造化心。\n廊庙乏材应见取，世无良匠勿相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史教授独善堂","author":"王安石","text":"湖海十年旧，林塘三亩馀。\n静非谈者隐，贫胜富人居。\n列鼎亦何有，幅巾聊自如。\n犹应不独善，学子满阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月果","author":"王安石","text":"一春强半勒花风，几日园林几树红。\n汲汲追攀常恨晚，纷纷吹洗忽成空。\n行看果下苍苔地，已作人间白发翁。\n岂惜解鞍留夜饮，此身醒醉与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士葛君挽辞","author":"王安石","text":"楚人黄歇地，晋代葛洪家。\n特擅山川秀，相承黻冕华。\n猗君有清尚，于世不雄夸。\n令子能传业，流光未可涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外厨遗火示公佐","author":"王安石","text":"刀匕初无欲凊人，如何灶鬼尚嫌嗔。\n翛翛短褐方炀火，冉冉青烟已被宸。\n邂逅焚巢连鸟雀，仓黄濡幕愧比邻。\n王阳幸有囊衣在，报赏焦头亦未贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]