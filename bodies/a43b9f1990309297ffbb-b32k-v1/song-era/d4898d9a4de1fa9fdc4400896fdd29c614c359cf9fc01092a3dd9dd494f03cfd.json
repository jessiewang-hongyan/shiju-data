[{"title":"挽前眉州使君廖子长二首 其二","author":"程公许","text":"卧罴花石戍，梦蝶古渝津。\n秀子嗣荣禄，诸郎皆聘珍。\n笄珈陪墓窆，雾雨暗车尘。\n今代谁班范，牵连汉传循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽前眉州使君廖子长二首 其一","author":"程公许","text":"二老金兰好，诸昆笔砚交。\n坐隅亲问字，投分漆如胶。\n决眦云间步，惊心水上泡。\n屋梁耿残月，含涕祖西郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽顺庆使君宝章李十三丈二首 其二","author":"程公许","text":"金相玉质素心降，每见令人折幔幢。\n亦有荐扬当使传，若为淹泊只侯邦。\n款门心讶三医谒，藏壑舟惊半夜扛。\n搔首薰风丹旐举，些歌凄断不成腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽顺庆使君宝章李十三丈二首 其一","author":"程公许","text":"东斋嫡子巽岩孙，酝酿诗书气味醇。\n桃李七州春不尽，松筠一节晚弥新。\n恤章峻直宁王宝，治行高推汉吏循。\n四尺坟前千字诔，清名不与迹俱陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽桃源使君虞公二首 其二","author":"程公许","text":"解印桃源后，卜居梅溆幽。\n秉心难偶俗，乐道自忘忧。\n故国八千里，妖氛六十州。\n公魂如不泯，时作玉芝游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽桃源使君虞公二首 其一","author":"程公许","text":"畴昔交诸季，曾闻说长公。\n圣涯探窔奥，词藻亦精工。\n偶幸趋徵诏，方当顺下风。\n飙斿无处问，延伫鬓飞蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽虞提干仲房","author":"程公许","text":"沧江亭上极绸缪，况复兰阶托胜游。\n邂逅磬川分别袂，传闻边邑费良筹。\n诸公推上青云毂，一梦惊移夜壑舟。\n生死交情那忍负，霜风吹泪锦江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽廖山父","author":"程公许","text":"忘年幸接使君游，仲氏论交意最稠。\n桂蘤方看霏月露，兰芽何遽陨霜秋。\n遗编荟粹兼三传，英气峥嵘閟一丘。\n忍见翣车随二老，彭殇试与问庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽潼帅许侍郎成子三首 其三","author":"程公许","text":"雪惨龙沙节，春浓豹尾班。\n难销方寸赤，不待二毛斑。\n力尽三医谒，忧深九虎攀。\n丁宁尸谏语，端不愧家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浙江观潮","author":"程公许","text":"浙岸携觞差一日，秋风吹爽轶层霄。\n怒涛奋击三千里，壮观元同十八潮。\n蓬阆何曾云海隔，偓佺未散玉京潮。\n琴高背稳容追逐，借与天风递玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别李贯之大著二首 其二","author":"程公许","text":"二老俱黄发，遥怜望倚门。\n凄凉游子意，惭愧主人恩。\n酒舫湖光滟，书灯夜雨昏。\n三山渺云海，何日听重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别李贯之大著二首 其一","author":"程公许","text":"车马红尘里，阅人谁似君。\n洚流倾世论，砥柱倚斯文。\n籍甚诗书誉，超然利欲醺。\n相从期岁晚，兰佩袭芳熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题马溪寺二首即用前韵 其二","author":"程公许","text":"翠珉瞻手泽，六十有馀龄。\n囊锦传宗旨，锥沙更典刑。\n发缘忧世白，眼独为山青。\n蕙帐摇归梦，秋猿正可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题马溪寺二首即用前韵 其一","author":"程公许","text":"玉笋竞秋爽，翠屏张晓晴。\n天开金地胜，鼎峙紫霄撑。\n见说禅心静，能调异物狞。\n十方芗水海，何处不澄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"载酒泛芙蓉溪游富乐伯用再和前韵牵课同作","author":"程公许","text":"霸气凄凉忆豫州，薜萝掩映小山幽。\n不知今古几枰误，空使英雄两泪流。\n借问长枪威塞外，何如短棹老沧洲。\n临分更隔芙蓉语，投赠惭无玉可舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅邸报上临朝召用二三耆德志喜有赋过眉山呈悦斋","author":"程公许","text":"人间二十八年事，天运盈虚一刹那。\n金坞漫忧无处著，冰山想复误人多。\n问唐偃月消磨几，奈鲁灵光岌嶪何。\n黄道方看升日毂，洗兵马更挽天河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪尚书游中岩夜大风雨尚书及任卿史石泉皆耆年德清谐季并余以晚辈侍","author":"程公许","text":"中天台殿倚竛竮，忆昨深登六岁零。\n雾锁岩扉须玉钥，云扶革履上青冥。\n三峰静对厖眉秀，双璧惊回醉眼醒。\n风雨三更龙象集，祖师意旨付谁听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪宪节饭石堂书院渡江游双泉墅即席和韵","author":"程公许","text":"箯舆杭野渡，竹径绕平畴。\n红蓼前宵涨，黄花几日秋。\n谈锋蜚屑玉，岩窦答鸣球。\n山水饶心赏，能忘恤纬忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪宪节饮见易亭及万里楼和韵二首 其二","author":"程公许","text":"天宇修眉分外妍，雷垣波静稳行船。\n向来蛟鳄骄无奈，今日凫鹥戏满前。\n爽气逼人漙瑞露，醉题眩眼烂非烟。\n薄才羞与云龙啜，脱骨端须第一泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪宪节饮见易亭及万里楼和韵二首 其一","author":"程公许","text":"郭洞春深物象妍，得陪绣斧漾觥船。\n连山崷崒檐楹外，六画分明几席前。\n记就尽教腾纸价，碑成还恐费松烟。\n熟知丘壑饶心赏，正未能忘赋下泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿驿亭和前韵末句属可道","author":"程公许","text":"千里因人作远游，一番风景酿清秋。\n眼明惊羽新埼岸，心折狼烟旧戍楼。\n山驿解鞍才晚霁，夜床惊雨滚溪流。\n壁间唐律须扬搉，却恨宗风隔果州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄呈座主李左史三首 其三","author":"程公许","text":"世纷枨触不胜忧，尚忆薰风故国游。\n惝恍梦回身八翼，凄凉别久日三秋。\n愿驰玉轪天津阻，拟问星槎海浪浮。\n千载指南先觉在，行迷未远却回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄呈座主李左史三首 其二","author":"程公许","text":"九万云程不作遥，暂教六月息鹏游。\n骚情吟彻湖天晓，义胆寒生石剑秋。\n想见床头谈屑堕，时浇椀面乳花浮。\n云山不隔师墙恋，凭仗缄书乞点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄呈座主李左史三首 其一","author":"程公许","text":"丝絇趁晓紫宸朝，悯俗超然赋远游。\n富贵傥来心止水，隐思不耐鬓先秋。\n谁知皓首太玄草，独对青山大白浮。\n只恐万牛勤挽致，未须封户橘千头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇女撷菜煮羹","author":"程公许","text":"稚女春间绕舍嬉，手挑野菜满篮归。\n细?碧涧和根煮，旋掬香粳芼糁稀。\n久识道腴知隽永，更从禅悦悟精微。\n投床忽作还乡梦，雪暖西山笋蕨肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日郡圃游观者如织余以赵园之约至夕乃还若水赋诗后四日偶因小疾谒告清坐始得奉答","author":"程公许","text":"老怯尊前倒玉山，清晨有约夕曛还。\n似知是日笙箫沸，趁赏群芳绮缬班。\n细阅馀妍能几许，喜因小疾得端閒。\n持觞不釂春应笑，若欠题诗亦厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祷雨有应和郡广文希白韵","author":"程公许","text":"金气胚浑火尚流，亢阳渐已裂龟畴。\n沛然一雨酬精祷，暂与群黎缓隐忧。\n千里耕桑犹乐土，三边鼙鼓又防秋。\n白头底是宽閒日，款段令人羡少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祷雪麻仙洞前立春一日湫压县境而雪霰已集连日六花呈瑞以元宵设供权父及士友皆赋诗二首和韵以谢 其二","author":"程公许","text":"阳乌且缓浴虞渊，瑞白春花胜腊前。\n台笠看人争播种，扶犁撩我梦归田。\n千金何术能医国，十雨从今更问天。\n暂驻飙游须净供，元宵未暇宝灯燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祷雪麻仙洞前立春一日湫压县境而雪霰已集连日六花呈瑞以元宵设供权父及士友皆赋诗二首和韵以谢 其一","author":"程公许","text":"驽怯深惭政理愆，骄阳积擅北风权。\n青鸾趣驾宾苍皞，白凤先驱从列仙。\n坯蛰梦惊离贝阙，裂龟渴饮变琼田。\n空餐那有涓埃报，只办炉薰荐洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移住西门之溪上","author":"程公许","text":"罢官来就湖州住，为爱双流贯一城。\n僦屋本非嫌僻静，开窗正要纳空明。\n鱼虾幸可随宜买，饘粥何妨逐渐营。\n况有双梅供索笑，昭琴底处有亏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移居北新桥彦质惠诗和答 其一","author":"程公许","text":"束书欲去意迟迟，从此宁无一会期。\n客路相逢如宿契，人生难得是閒时。\n虚廊过午陪行食，净院中宵共说诗。\n此乐何时仍共赏，底须簪佩侍彤墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移居北新桥彦质惠诗和答 其二","author":"程公许","text":"绣段轻投报苦迟，隔关那复共襟期。\n艰虞敢自求安宅，懒慢欣知不入时。\n王粲登楼初有赋，杜陵屏迹可无诗。\n边声又逐秋风劲，谁有良筹动玉墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绳翁初度","author":"程公许","text":"男儿十六已非孩，心地迷云渐剔开。\n虽复词章当藻绘，要从德性植根荄。\n谦和孝友能无愧，富贵功名付傥来。\n但愿时平早还蜀，田间伴我斸蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚舟相逐至岳阳录示旧日避风诗和韵纪事","author":"程公许","text":"系船三日风当止，雨欲逗晴云乱飞。\n沽酒店家都是薄，买蔬山市晚方归。\n客装淹速信难料，友社欢谐知可依。\n唤起玄真共心赏，桃花流水鳜鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"揆初之日承父用晦以余前岁登玉华楼玩月借宋青山诗韵赋诗称寿仍和答之并示甥侄","author":"程公许","text":"防意由来似守城，涧潢洁祀及良辰。\n命名犹念记闾史，学道粗知存谷神。\n欲诵蓼莪心楚怆，愧投木李句清新。\n何当共觅长生诀，去逐商颜四老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游中岩晴烟如春尤觉林壑之胜也","author":"程公许","text":"晴岚暖翠中岩寺，十二年间得再游。\n三笋龛深香不散，万松山拥雾难收。\n鹫峰付嘱虽常住，雁荡经行岂易求。\n欲识老师真面目，白云深处涧泉流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游永康灵岩寺","author":"程公许","text":"诘曲山蹊远世氛，荒寒古寺荐炉熏。\n清泉迸石韵寒玉，翠逻倚天施白云。\n半藏石经真健妇，一龛古貌现声闻。\n迟留恐遇鱼凫叟，岚霭浮空日易曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石湖","author":"程公许","text":"雨过春塘水慢流，唤船聊作石湖游。\n水亭风槛今馀几，越垒吴台相对愁。\n笑拂壁题如觌面，忆从乡老话遨头。\n不知化鹤曾归否，更撚梅花一饷留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游道何二山晚饮倪氏玉湖","author":"程公许","text":"草草盘蔬一酒壶，虎岩小憩转金舆。\n静观生物春风里，笑拂诗牌劫火馀。\n散策松阴寒悄悄，撷香梅径雪疏疏。\n归航未迫西山暮，碧浪湖边看网鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊月二十六日部宿雪甚登天官厅后亭子","author":"程公许","text":"冲寒趁襆青绫被，奇事妆成白粉闱。\n老怯凭高银海眩，渴因引满玉池肥。\n七旬蜀道才通信，两月淮壖未解围。\n澒洞忧端深似海，鬓霜争与六花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢检阅牟存叟袖启相访","author":"程公许","text":"井络西瞻劫火残，天涯执手语含酸。\n乡人为把子虚诵，国典能推良吏难。\n老我栖迟同燕雀，送君翔翥上鸳鸾。\n长风借与还乡便，犹喜白鸥盟未寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢慧明王道士自大面山寄赠三诗并蜜黄精 其一","author":"程公许","text":"与君一再会岷山，共把匏尊中圣贤。\n强说市朝为大隐，何如山泽友臞仙。\n空中皓月参心地，海面浮沤悟世缘。\n安得一龛时晤语，笑披云雾豁青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢慧明王道士自大面山寄赠三诗并蜜黄精 其二","author":"程公许","text":"尺书覼缕写衷诚，大面山前两日程。\n黄独润含崖谷味，清诗吟作涧泉声。\n灰心久已安枯寂，月指何劳借发明。\n更与草庵求扁榜，太虚底处强安名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢慧明王道士自大面山寄赠三诗并蜜黄精 其三","author":"程公许","text":"三复君诗想洛阳，令人愤极意飞扬。\n鼎湖知有威灵在，魏阙欣闻孝里彰。\n一念变迁无量劫，寸心寂照大圆光。\n君能勘破皆泡幻，长与乔松燕玉房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"煇父道父携酒相伴饮飞赴寺四望亭","author":"程公许","text":"四望奇观广莫同，瘦藤拄入画图中。\n晴烟杳霭景无尽，醉眼模糊鸢堕空。\n邑蕞也曾基相业，井眢谁复现神通。\n漫劳二妙相追逐，胜处宜搜未易工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道山诸丈置酒饮饯秀野园以诗谢别","author":"程公许","text":"去国飘然一障乘，都门祖帐集华簪。\n黄梅未雨热如沸，白葛当风凉满襟。\n江国颇堪千里寄，蓬山遥想五云深。\n论思禁闼须公等，肯念交盟数寄音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道传山丹一本两花举以见遗夜窗翻书偶见刘潜夫尝赋云偶然避雨过民舍一本山丹恰盛开种久树身樛似盖浇频花面大如杯怪疑朱草非时出惊问红云甚处来可惜书生无事力千金移入画栏栽因借韵同赋一首","author":"程公许","text":"种类山茶花较大，一根恰有两枝开。\n铅砂炼熟大还鼎，琥珀琢成双劝杯。\n威凤想从丹穴下，飞仙近自赤城来。\n便船惟会加培养，寄伴阶庭芍药栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪亭春日二首 其一","author":"程公许","text":"借屋三间俯近郊，溪流如练绕兰皋。\n聊同彭泽归栽菊，肯向玄都问种桃。\n别久心情浑漫浪，相看须发转萧骚。\n只因旧学荒尤甚，政藉谈馀为栉薅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪亭春日二首 其二","author":"程公许","text":"极目青天蜀道难，无因长坂得联骖。\n思乡浪费肠回九，行世何妨臂折三。\n杨柳风微生百媚，棠梨昼永带馀酣。\n天涯犹赖春娱客，那得邻山寄一庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"督堰至岷下借馆南浦张叔全家临别惠以润石香几一峰挺拔于白云杳霭间殊有远意小诗谢之","author":"程公许","text":"飞幰轻舆御暖风，款门何事日憧憧。\n芳荣满槛丹青丽，秾秀当轩紫翠重。\n石几拜嘉才径尺，云天无际挺孤峰。\n更烦指似麻坛路，万壑千岩借一筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉平八日祷雪崇福观集霰随车至晚大雪凡三日广文邵丈志喜赋诗勉和元韵","author":"程公许","text":"集霰才随紫马回，散花天已御风来。\n尘寰瞥地开仙境，和气融春入酒杯。\n寒冱潜消人物疠，清吟肯傍簿书堆。\n南枝陡觉精神别，探借东皇信息催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙老拉泰叔同伴山行由马溪寺攀跻险绝历龙洞上罗汉洞洞前小庵极幽邃下有龙潭潭水窈深一绿蟾蜍踞坐石间意若神龙守护者抵暮还憩双峰阁看十三夜月和泰叔韵","author":"程公许","text":"扶携罗汉洞前去，谁信此中天地宽。\n涧水翻成千偈快，岭云肯放一尘干。\n倚岩庵好无僧住，积石潭深照影寒。\n归对双峰看月吐，薇花浴露色如丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题马溪寺二首 其二","author":"程公许","text":"先子旧游此，余时方五龄。\n风神见图像，云体想仪刑。\n衰发年年白，遥山面面青。\n不须论旧事，欲说唤谁听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题马溪寺二首 其一","author":"程公许","text":"久客愁多雨，清游喜骤晴。\n云蓝犹独踞，玉岭忽双撑。\n洞口龙方卧，山腰虎尚狞。\n方池竟何在，一水至今清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题丹景山","author":"程公许","text":"原庙标丹景，神游想岱宗。\n宝龛严石像，绀殿锁云峰。\n浪说侵疆复，何当检玉封。\n天门东北望，漠漠晓烟浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题巴东县秋风亭","author":"程公许","text":"万山寂寂巴东县，千古堂堂寇长官。\n野水可无诗问讯，秋风长对泪汍澜。\n著楼无地尽渠诧，折箠立功非我难。\n君看公安一梢竹，向来许国寸心丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题江东陈氏江亭","author":"程公许","text":"渔艇閒撑过水东，乱云含雨晚溟濛。\n绝怜郊墅依林壑，更拓轩窗贮竹风。\n剩与烟波开霭杳，却须菑翳略疏通。\n閒居可忍虚吟啸，载酒来时社友同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题罗江云盖寺二首 其二","author":"程公许","text":"处处名山屐齿留，尽忙也合此閒游。\n重楼高压青螺顶，二水横分白鹭洲。\n岁月尽饶僧结足，风烟耐与客消愁。\n红尘岐路重回首，车毂憧憧古益州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题罗江云盖寺二首 其一","author":"程公许","text":"云盖山前往返频，过门不入愧山灵。\n晚烟莽苍乱流去，夜雨淋浪攲枕听。\n遍索寺碑寻往话，但馀辙迹护禅扃。\n老权有句堪呈佛，谁为援毫刻翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题卷子会","author":"程公许","text":"龙飞景运诏宾兴，将相之阶自此升。\n毛颖铦锋须快战，楮生衷甲作先登。\n精思可使文加点，抄写能令价倍增。\n努力杀青男子事，功名未尽剡溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题信州半月岩","author":"程公许","text":"岩际半轮月，神工幻怪奇。\n本来无显晦，何自有盈亏。\n岚雾凝蟾彩，藤萝影桂枝。\n能令万里客，为尔忆峨眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]