[{"title":"吴宗教惠西施舌戏成三绝 其一","author":"王十朋","text":"吴王无处可招魂，惟有西施舌尚存。\n曾共君王醉长夜，至今犹得奉芳尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴宗教惠西施舌戏成三绝 其二","author":"王十朋","text":"博物延陵有令孙，不因官冷作儒酸。\n珍庖自有西施舌，风味堪陪北海尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴宗教惠西施舌戏成三绝 其三","author":"王十朋","text":"长记还家屡击鲜，南来归兴日飘然。\n不缘樽俎逢西子，始泛江湖范蠡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贡院食新荔观双莲因成六言","author":"王十朋","text":"两郡两逢新荔，三年三结双莲。\n酒盏莫辞在手，异时同把无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分韵得两字","author":"王十朋","text":"官舍苦炎热，贡闱快虚敞。\n急呼玉友生，闲共同僚赏。\n堂成桂植万，堤就池分两。\n莲开花并蒂，荔擘珠在掌。\n诗句听细论，尘襟发清爽。\n行矣北归翁，山林起遥想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云榭纳凉","author":"王十朋","text":"人间正炎热，云榭独清凉。\n如欲慰黎庶，诸君宜奉扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分韵得宜字","author":"王十朋","text":"榭向云间筑，风从天半吹。\n谈方以清饱，襟更为凉披。\n雄入兰台赋，微生殿阁诗。\n倚栏观出岫，吾去亦诚宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罢官述怀","author":"王十朋","text":"去矣清源守，皤然雪满颠。\n居官无善政，排闷有诗篇。\n朋盍三杯酒，公馀一觉眠。\n泉人岂思我，我意自思泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出州宅","author":"王十朋","text":"官居到处邮传，岁月惊人电飞。\n惆怅同来德耀，故乡不与同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓清源驿","author":"王十朋","text":"两年缪作清源守，不到清源洞里游。\n天恐孤予远来意，驿中聊许少迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸公饯别分韵得人字","author":"王十朋","text":"清源古名郡，守土宜择人。\n胡为不才者，两载乘朱轮。\n政拙岁多旱，民愁眉日颦。\n赖兹淳厚俗，容我老病身。\n乞祠竟不允，易郡俄得邻。\n雅怀上冢愿，偶有还乡因。\n宾僚共呼酒，肴蔌嘉且新。\n展饯选士场，语离庚伏辰。\n清风屡吹衣，暑雨微洒尘。\n骊驹沸盈门，鹦鹉飞入唇。\n我亦重惜别，不辞劝酬频。\n诸君如神鱼，行奋六六鳞。\n学士倍登瀛，郡符同治秦。\n我如倦蜚鸟，野性难笼驯。\n旧巢寻故山，一枝老荆榛。\n官居类邮传，谁能久相亲。\n但愿各勉力，相期作纯臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枕上闻雨声","author":"王十朋","text":"枕上微闻点滴声，皇天有意救苍生。\n虽然未作商家雨，已觉炎方暑气清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻角声","author":"王十朋","text":"角声已作送行声，更向萧萧雨后听。\n明日出郊闻更远，回头忍见二山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复安静堂旧额","author":"王十朋","text":"端明之孙字子强，银钩铁画传遗芳。\n昔年作郡古平海，大笔亲书安静堂。\n自从宣和至乾道，字与轮奂争光芒。\n一朝忽遭俗眼白，毁灭名姓深埋藏。\n我来搜访久乃获，老兵据为寝处床。\n涤除五载尘土面，字向堂上增激昂。\n祖为第一孙是似，书有家法称莆阳。\n体具万安颇雄壮，榜与忠献同翱翔。\n因知文字乃至宝，一时之厄庸何伤。\n石鼓文有鬼神护，淮西碑并日月光。\n岂容泯灭暴秦火，谁肯脍炙段文昌。\n书生作郡太迂阔，理财听讼俱非长。\n吾君若问何以治，堂复韩蔡祠秦姜。\n今才五日京兆耳，眷此陈迹犹未忘。\n但愿兹堂日安静，名与国寿俱无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次蒋元肃韵","author":"王十朋","text":"酒杯三十六人衔，劝我殷勤不止三。\n长记白蘋离浙右，忍看丹荔别泉南。\n自惭政似阳城拙，那得棠如召伯甘。\n见说广文尤惜别，好诗千里送归骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠李宜之运干","author":"王十朋","text":"谪仙苗裔自非凡，家学端能嗣大参。\n一见便知空冀北，三年长叹滞周南。\n绝畦翰墨仆骚可，请试言词倚马堪。\n莫道南来橐无宝，一编传得小云龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"记风","author":"王十朋","text":"泉南固多风，兹风大为最。\n初惊月有晕，忽听天鸣籁。\n蓬蓬从何来，烈烈不可奈。\n万窍争怒号，三光变冥昧。\n掀翻败墙壁，摧折到松桧。\n瓦飘上天半，茅捲洒郊外。\n稻吹垂实花，果堕未熟蒂。\n山川失故容，草木遭厄会。\n飞同鹢过宋，悲异见歌沛。\n孰云楚台雄，未觉周郊大。\n虽然不终朝，无乃已被害。\n嗟予垂素发，滥此张皂盖。\n方忧西畴禾，未问南海贝。\n心如韩值飓，卜效苏命蔡。\n焚香叩穹昊，防患问耆艾。\n稍稍云色定，徐徐雨声霈。\n渐停箕簸扬，会见气交泰。\n居民理破屋，老守戒征旆。\n五弦歌舜琴，一丝咏严濑。\n去矣不待瓜，归欤及鲈鲙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡端明祠堂","author":"王十朋","text":"公昔自禁从，再来临此邦。\n河梁一何壮，笔力独能扛。\n政绩留南纪，祠堂枕大江。\n山川与人物，今古两无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别傅教授景仁","author":"王十朋","text":"鼻祖调羹佐有商，耳孙家业踵前芳。\n万言书有盐梅味，千首诗开锦绣肠。\n绛帐讵容淹久次，制科端欲待非常。\n归囊剩有君佳句，更获珠玑四十章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈教授正仲","author":"王十朋","text":"益友乎生所愿亲，南来深喜得斯人。\n渊源师杜真知体，人物如平岂久贫。\n绛帐可能淹教育，掖垣便合掌丝纶。\n临行赠我五百字，楚璧隋珠未足珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽令人","author":"王十朋","text":"糟糠情味饱相谙，我事耕耘尔力蚕。\n误走迷途半天下，忽惊魂梦断泉南。\n二年旅榇悲无奈，千里途车涕不堪。\n预卜黄华晚秋节，佳城归祔白岩庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈体仁","author":"王十朋","text":"我来守清源，德星识二陈。\n大陈如金玉，一室清无尘。\n厌世不肯留，至今里称仁。\n儒先贺州守，才气超等伦。\n胸中包古今，笔下真有神。\n唾手取甲科，齿发方青春。\n声名满天下，文字惊缙绅。\n劳人暂州县，平步当要津。\n蹉跎忽至今，此志犹未伸。\n真人奉香火，萧寺含悲辛。\n讲席延诸生，黄卷诃古人。\n异端斥佛老，吾道鸣孟荀。\n聊籍束脩礼，少资囊橐贫。\n我忝二千石，二年牧斯民。\n不能助玉川，耻与韩公均。\n赠我诗与文，字字皆可珍。\n宠褒恨太过，感激难具论。\n愿公少自爱，行矣当致身。\n门下有高第，庙堂手经纶。\n房魏方得君，讵肯忘河汾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠林尉致约","author":"王十朋","text":"红颜白面神仙吏，好学苦吟真我徒。\n政事文章有家法，它年呼作小龙图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临行至贡院观桂赠致约","author":"王十朋","text":"窃禄清源愧不才，贡闱临去尚徘徊。\n青青万本新移桂，尽是梅仙手为栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿寂光院","author":"王十朋","text":"青山环绕如盘谷，中有清幽佛子家。\n人昔共来今不见，数行老泪湿烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈德溥以百韵诗送别因赠一绝","author":"王十朋","text":"莲幕游从一二年，送行越境继前贤。\n笔头皆有珠千颗，端似少陵夔府篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越境送别者七人蒋元肃黄少度鹿伯可赵元序陈德溥叶飞卿林致约少酌驿舍","author":"王十朋","text":"同僚送我枫庭驿，共酌临分酒一杯。\n我念泉人仍惜别，此身虽去首频回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别蒋元肃","author":"王十朋","text":"符竹南来识广文，经横讲席见渊源。\n凌云词赋胜三赋，医国忠言压万言。\n陈迹互将文字记，交情更向别离论。\n君方腾踏吾衰矣，名节相期百世存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题莆田林氏双阙","author":"王十朋","text":"唐室遥遥孝义门，屹然双阙至今存。\n当时泣尽思亲血，化作恩波遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过头陀九岭宿天王栖林二招提因成三绝 其一","author":"王十朋","text":"凌晨饱饭渡秦溪，要上青山九级梯。\n不使瓯闽隔人世，头陀力与五丁齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过头陀九岭宿天王栖林二招提因成三绝 其二","author":"王十朋","text":"千里归涂险更长，眼中深喜见天王。\n从今渐入平安境，旧路艰辛未敢忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过头陀九岭宿天王栖林二招提因成三绝 其三","author":"王十朋","text":"我如倦鸟欲栖林，喜见禅僧栖处深。\n家在梅花小溪上，一枝聊慰北归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿五峰院","author":"王十朋","text":"万法由来总是空，五峰名在本无峰。\n我来遥作庐山想，隐约夕阳开处逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠亮首坐","author":"王十朋","text":"雪顶庞眉八十馀，五峰深处结精庐。\n阅人老眼能青白，赠我严公一轴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王成之太博寄诗病中未能和谩书二十字以酬","author":"王十朋","text":"老病欲纳禄，君恩许奉祠。\n已为三径计，误辱广文诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"司理叔文和过万桥诗复用前韵","author":"王十朋","text":"少年一夕九起嗟，家贫亲老无生涯。\n河东先生独青眼，慨然许我修通家。\n三十年间同转首，王谢依然作甥舅。\n时人咸笑孺子贫，杜老惟蒙丈人厚。\n罢官闽峤初归来，登堂又荷倾金罍。\n诗诵白圭感前事，情钟我辈衔馀哀。\n定向清朝力求退，呼宾剩设严冬鲙。\n从公杖屦鹿岩前，明月清风赵欧会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽令人 其一","author":"王十朋","text":"知汝莫如我，伤心不尽谈。\n忍贫犹好施，见得可曾贪。\n水陆同艰险，糟糠共苦甘。\n和鸣三十载，一梦断闽南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽令人 其二","author":"王十朋","text":"之子有贤叔，鲰生误受知。\n恩蒙夫子妻，事类白圭诗。\n黄卷悲吟夜，青灯照绩时。\n竟孤偕隐愿，徒切悼亡思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽令人 其三","author":"王十朋","text":"我欲志诸墓，有言何敢私。\n如宾最相敬，无妒似知诗。\n孝合从姑葬，贤宜举郡悲。\n明朝是重九，忍看菊花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅溪草堂新辟缺少花木效少陵故事觅之以诗 其一","author":"王十朋","text":"小小园中十八香，主人游宦遂荒凉。\n名园草木多奇品，分我馀根种草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅溪草堂新辟缺少花木效少陵故事觅之以诗 其二","author":"王十朋","text":"闲中那得买花钱，孤负桃红李白天。\n拈出向来花疏目，招邀春色上诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦龄弟生日","author":"王十朋","text":"周正犹馀八荚蓂，昴星下应一阳生。\n貌和冬岭松俱秀，神与梅花溪共清。\n定享百龄如卫武，预开三径学渊明。\n弟兄此去皆华发，无惜更相荐寿觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"可公禅老住泉之九日山二十年矣予临罢官求去甚力复为后政所留寄诗酬以一绝","author":"王十朋","text":"泉山好处稍延福，白发禅僧去复回。\n且与晋松为隐侣，莫同英石便飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄伯厚得蒲墨折而为三以书来易戏成二绝 其一","author":"王十朋","text":"不谓一子墨，忽成三客卿。\n君家好兄弟，鼎立并驰名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄伯厚得蒲墨折而为三以书来易戏成二绝 其二","author":"王十朋","text":"好去文房宝，坚刚宜自持。\n吾家藏有尽，黄子玩无时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姚宰行可和诗索墨酬以元韵 其一","author":"王十朋","text":"武城民事暇，著述似虞卿。\n手握陈玄辈，磨成不朽名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姚宰行可和诗索墨酬以元韵 其二","author":"王十朋","text":"人生几丸墨，老病厌操持。\n好与贤明宰，研磨共救时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松笔","author":"王十朋","text":"我有文房宝，莫如毛颖清。\n来从丹桂窟，封以五夫城。\n辈行惟彤管，宗盟是墨卿。\n湘东谩三品，无此岁寒名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题净名院二绝 其一","author":"王十朋","text":"净名却见老维摩，道眼相看语不多。\n我待衣冠挂神武，杖藜来此老岩阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题净名院二绝 其二","author":"王十朋","text":"谷中有月露蛾眉，水织珠帘更绝奇。\n满目峰峦观未尽，有僧携纸觅题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千叶白桃","author":"王十朋","text":"洗尽夭夭色，泠然众卉中。\n却将千叶雪，全胜几枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊","author":"王十朋","text":"佳节逢吹帽，黄金染菊丛。\n渊明何处饮，三径冷香中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芍药","author":"王十朋","text":"千叶扬州种，春深霸众芳。\n无言诮君子，窈窕有温香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅","author":"王十朋","text":"蝶采花成蜡，还将腊染花。\n一经坡谷眼，名字压群葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红梅","author":"王十朋","text":"似桃非桃杏非杏，独与江梅相早晚。\n天姿约略带春酲，便觉花容太柔婉。\n霞觞潋艳玉妃醉，应误刘郎来阆苑。\n会须参作比红诗，莫学墙头等閒见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梨花","author":"王十朋","text":"淡客逢寒食，村烟烂漫芳。\n谪仙天上去，白雪世间香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酴醾","author":"王十朋","text":"风枝张羽盖，露脸污何郎。\n收拾归醽醁，芳姿韵更香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香花","author":"王十朋","text":"真是花中瑞，本朝名始闻。\n江南一梦后，天下遇清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁香","author":"王十朋","text":"雨里含愁态，枝头缀玉英。\n为花更雅目，变乱药中名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"委羽山","author":"王十朋","text":"龟山软翠日开屏，羽客逍遥此闭扃。\n早起留云閒放鹤，夜来伴月静看经。\n岩前方石有多好，灶里丹砂且是灵。\n应有赤城鸾凤过，一声长啸入青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤禅寺","author":"王十朋","text":"閒上箫台顶，山深喜路通。\n人家烟色里，古寺水声中。\n金溅星犹在，丹成灶已空。\n神仙何处觅，千载想遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"能仁禅寺","author":"王十朋","text":"不到能仁久，欣闻赐额还。\n浮云已过眼，依旧好青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石夫人","author":"王十朋","text":"亭亭独立望天津，四畔无家石作邻。\n螺髻不梳千载晓，蛾眉空扫万年春。\n雪为铅粉凭风传，霞作胭脂仗日匀。\n莫道岩前无宝鉴，一轮明月照夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大龙湫","author":"王十朋","text":"灵源东接雁池遥，裂石崩崖下九霄。\n云断青天倚长剑，月明泉室挂生绡。\n江声雨势三秋急，雪片冰花五月饶。\n休勒移文北山去，他年来赴石梁招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卓笔峰","author":"王十朋","text":"束缚真凭造化功，巍巍直气贯鸿濛。\n雨将苔色生彤管，山吐虹光绕兔锋。\n未数如椽曾入梦，误疑怪事尚书空。\n士人毛颖多荣辱，恩宠才衰便不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兄弟邻里日讲率会因书一绝且戒其早纳租税也","author":"王十朋","text":"屏迹山林颇自安，里闾率会有馀欢。\n但须及早输租税，不用低颜见长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花","author":"王十朋","text":"月澹碧云笼野水，棱棱瘦耸吟肩起。\n一天寒气霞衣裳，人在石桥春影里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"王十朋","text":"杜陵应恨未曾识，空向成都结草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]