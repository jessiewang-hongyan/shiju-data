[{"title":"大晟府拟撰释奠十四首 初献盥洗用《同安》。","author":"郊庙朝会歌辞","text":"右文兴化，宪古师经。\n明祀有典，吉日惟丁。\n丰牺在俎，雅奏在庭。\n周旋陟降，福祉是膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 其四 迎神用《凝安》。","author":"郊庙朝会歌辞","text":"圣王生知，阐乃儒规。\n诗书文教，万世昭垂。\n良日惟丁，灵承不爽。\n揭此精虔，神其来飨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 其三 迎神用《凝安》。","author":"郊庙朝会歌辞","text":"巍巍堂堂，其道如天。\n清明之象，应物而然。\n时维上丁，备物荐诚。\n维新礼典，乐谐中声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 其二 迎神用《凝安》。","author":"郊庙朝会歌辞","text":"生而知之，有教无私。\n成均之祀，威仪孔时。\n维兹初丁，洁我盛粢。\n永适其道，万世之师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 其一 迎神用《凝安》。","author":"郊庙朝会歌辞","text":"大哉宣圣，道德尊崇。\n维持王化，斯民是宗。\n典祀有常，精纯并隆。\n神其来格，于昭盛容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其五","author":"郊庙朝会歌辞","text":"圣考能飨，宗祀熙成。\n骏烈惟帝，于皇执衡。\n茂育元运，降祚丕平。\n载清斯酌，庸罄精诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其十","author":"郊庙朝会歌辞","text":"白炜方肃，合宫孔硕。\n琥以象象，神惟飨德。\n升配有序，虔恭无斁。\n降福穰穰，永安邦国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其一","author":"郊庙朝会歌辞","text":"帝宅震方，在德惟木。\n宣仁赋和，大生□育。\n祀法有虔，皇情允肃。\n神之格思，报以介福。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其十一","author":"郊庙朝会歌辞","text":"于赫路寝，肆筵有序。\n粤若西颢，其神执矩。\n以荐币玉，式陈簠簋。\n神其格思，受天之祐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其六","author":"郊庙朝会歌辞","text":"四序均气，五色奠方。\n元标枢纽，位正中央。\n至诚馨洁，率土年康。\n神兮降止，鼎祚绵长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其八","author":"郊庙朝会歌辞","text":"帝乘中央，沉载函蒙。\n经纬四方，物性滋丰。\n金石之荐，象德以宫。\n神锡嘉虞，介祉无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其二","author":"郊庙朝会歌辞","text":"太微灵德，若首五精。\n本仁与益，降气施生。\n纯牲有硕，旨酒斯清。\n锡兹寿嘏，既寿洽平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其十三","author":"郊庙朝会歌辞","text":"今月季秋，谷日辛亥。\n路寝合宫，亲修严配。\n北方之神，五室来会。\n馨烈是■，庬褫攸介。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其九","author":"郊庙朝会歌辞","text":"玉琯均和，金风候气。\n神其格思，丰粢洁币。\n九谷顺成，群物茂遂。\n降福无疆，德泽光被。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其三","author":"郊庙朝会歌辞","text":"惟帝乘离，恢台其德。\n平秩南讹，百嘉允殖。\n感精启运，祖我炎历。\n璋币迎郊，□□翼翼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其十五","author":"郊庙朝会歌辞","text":"礼经之重，祀典惟明。\n命官摄事，陟降以诚。\n既升庶品，亦奉二精。\n锡兹福祉，迄用丕平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其四","author":"郊庙朝会歌辞","text":"惟帝乘离，司厥生殖。\n感所自兴，据我炎德。\n既度斯筵，乃馨斯稷。\n对越居歆，介祉无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其七","author":"郊庙朝会歌辞","text":"盛德居厚，含章有融。\n惟思惟信，曰黄曰中。\n礼诚荐达，福祐嘉通。\n永延永阜，九谷咸丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其十四","author":"郊庙朝会歌辞","text":"太宇清明，宣以方色。\n沛哉灵游，昭示幽则。\n崇配尊亲，惟兹孝德。\n神熙蕃丕，涵育四极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五方帝 其十二","author":"郊庙朝会歌辞","text":"水官修职，星昴居方。\n执权含宝，万物伏藏。\n大明昌祚，临下皇皇。\n曰寒时若，神降之康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙六首 其六 送神用《登安》。","author":"郊庙朝会歌辞","text":"灵之来下，以雨先驱。\n灵之旋驭，五云结车。\n操环应夏，发匣瑞虞。\n真人在御，来献珍符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙六首 其五 亚、终献用《嘉安》。","author":"郊庙朝会歌辞","text":"明明天子，礼文咸秩。\n矧神之功，横被九域。\n云施称民，物产滋殖。\n嘉承惠和，罔有终极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙六首 其四 酌献用《恺安》。","author":"郊庙朝会歌辞","text":"练吉日兮，进神之堂。\n牲既陈兮，粢盛既香。\n奠桂酒兮，容与嘉觞。\n灵安留兮，锡我福祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙六首 其三 奠币用《文安》。","author":"郊庙朝会歌辞","text":"维灵德兮，变化不常。\n沛天泽兮，周流八荒。\n奠嘉币兮，肃雍不忘。\n永佑民兮，锡以丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙六首 其二 升降用《雅安》。","author":"郊庙朝会歌辞","text":"灵之至兮，逸驾腾骧。\n嘘云吸气，承祀日光。\n展诗鸣律，肃庄琳琅。\n何以膺神，贶惠无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五龙六首 其一 迎神用《禧安》。","author":"郊庙朝会歌辞","text":"灵之智兮，跃汉潜幽。\n欲豢扰兮，无董与刘。\n陈金石兮，佐侑牢羞。\n庶燕享兮，泽应民求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元祐祀九宫贵神二首 其二 送神用《景安》。","author":"郊庙朝会歌辞","text":"天之贵神，推移九宫。\n厥位靡常，降康则同。\n来集于坛，顾歆恪恭。\n歌以送之，飙静旋穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元祐祀九宫贵神二首 其一 降神用《景安》。六变。","author":"郊庙朝会歌辞","text":"上天贵神，九宫设位。\n功德及物，乃秩明祀。\n望拜紫坛，赫然灵气。\n奠玉荐币，歆之无愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符祀感生帝五首 其五 送神用《普安》。","author":"郊庙朝会歌辞","text":"俯临下土，回复上天。\n触类而长，荷福无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符祀感生帝五首 其四 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"大君有命，阙典咸脩。\n帝歆明祀，佑圣千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符祀感生帝五首 其三 帝位酌献。","author":"郊庙朝会歌辞","text":"乐和凤律，酒奠牺尊。\n神明斯享，礼盛难论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符祀感生帝五首 其二 初献升降用《保安》。","author":"郊庙朝会歌辞","text":"冕旒俨若，步武有容。\n公卿济济，韶頀邕邕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符祀感生帝五首 其一 降神用《大安》。六变。","author":"郊庙朝会歌辞","text":"二仪交泰，七政顺行。\n四序资始，万物含生。\n皇朝创业，盛德致平。\n为民祈福，洁此精诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其七 退文舞、迎武舞用《穆安》。","author":"郊庙朝会歌辞","text":"舞以象功，乐惟崇德。\n文经万邦，武靖四国。\n一张一弛，其仪不忒。\n神鉴孔昭，孝思维则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其九 饮福用《胙安》。","author":"郊庙朝会歌辞","text":"莫尊乎天，莫亲乎父。\n既享既侑，诚申礼举。\n戛击堂上，八音始具。\n天子亿龄，饮神之胙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其五 上帝位酌献用《庆安》。","author":"郊庙朝会歌辞","text":"惟礼不渎，所以严亲。\n惟孝不匮，所以教民。\n陟配文考，享于大神。\n重禧累福，祚裔无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其八 亚献用《穆安》。","author":"郊庙朝会歌辞","text":"于昭盛礼，严父配天。\n尽物尽诚，莫匪吉蠲。\n重觞既荐，九奏相宣。\n神介景福，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其一 皇帝升降用《仪安》。","author":"郊庙朝会歌辞","text":"严父配天，孝乎明堂。\n与奠升阶，降音以将。\n天步有节，帝容必庄。\n辟公宪之，礼无不臧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其六 配位酌献用《德安》。","author":"郊庙朝会歌辞","text":"隆功骏德，两有烈光。\n陟配宗祀，惠我无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其四 奉俎用《禧安》。","author":"郊庙朝会歌辞","text":"奕奕明堂，天子即事。\n奠我圣考，配于上帝。\n凡百有职，畴敢不祗。\n俎洁牲肥，其登有仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其二 上帝位奠玉币用《镇安》。","author":"郊庙朝会歌辞","text":"圣能享帝，孝克事亲。\n于皇宗祀，盛节此陈。\n何以荐虔，二精有炜。\n何以致祥，上天鉴止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符亲享明堂十一首 其三 神宗奠币用《信安》。","author":"郊庙朝会歌辞","text":"合宫礼备，时维哲王。\n堂筵四敞，明德馨香。\n圣考来格，降福穰穰。\n承承继继，万祀其昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元符祭神州地祇二首 其一 迎神用《宁安》。八变。","author":"郊庙朝会歌辞","text":"膴膴浚邦，皇天是宅。\n必有幽赞，聪明正直。\n布列笾豆，考击金石。\n中外谧宁，繄神之力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天安殿册封五岳帝一首 神出入用《正安》。","author":"郊庙朝会歌辞","text":"名岳奠方，帝仪克举。\n吉日惟良，九宾咸旅。\n温玉镂文，纁裳正宁。\n礼备乐成，笃神之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天禧三年册皇太子一首","author":"郊庙朝会歌辞","text":"明离之象，少阳之位。\n固邦为本，体天作贰。\n仪范克温，礼章斯备。\n丕宣令猷，恭守宗器。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太庙","author":"郊庙朝会歌辞","text":"大享合宫，于礼莫盛。\n入太室祼，遍于列圣。\n陟降有仪，一主乎敬。\n祀事孔明，邦家之庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东京留守宗公","author":"《靖康小雅》作者","text":"洪河滔滔，撼野摧山。\n砥柱中立，独当狂澜。\n敌势焰焰，动植俱残。\n公俯视之，若萤燐然。\n知无不为，独殿中原。\n方事北讨，将以身先。\n赤羽若日，朱旗绛天。\n二贼巧沮，行或止还。\n虽醢二贼，奚足偿焉。\n夺之遽矣，中外悲叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至孟春孟夏季秋四祀上公摄事七首 送神用《景安》。","author":"郊庙朝会歌辞","text":"帝临中坛，肃恭禋祀。\n灵景舒光，飞龙旋轨。\n送神有章，神心具醉。\n辅德惟仁，永锡元祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至孟春孟夏季秋四祀上公摄事七首 太尉行用《正安》。","author":"郊庙朝会歌辞","text":"礼经之重，祭典为宗。\n上公摄事，登降弥恭。\n庶品丰洁，令仪肃雍。\n百神萃止，惟吉之从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至孟春孟夏季秋四祀上公摄事七首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"秩秩礼文，肃肃严祀。\n仰洽神休，式协民纪。\n灌献有容，叙其俎簋。\n明德惟馨，以介丕祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 送神用《理安》。","author":"郊庙朝会歌辞","text":"五运惟火，寔宗众阳。\n宿壮用明，千载愈光。\n神保聿归，安处火房。\n郁攸不作，炎图永昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"潜之伏矣，柞槱既休。\n有俶其来，榆柳是求。\n灵驾纷羽，尚其安留。\n饮我三爵，言言油油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 宣明王位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"周设司爟，虽列夏官。\n仍袭孔易，闿端实难。\n相彼商丘，永怀初造。\n不腆桂椒，匪以为报。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 大辰位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"孰为大辰，维北有斗。\n曾是彗星，斯名孔有。\n幽荣报功，洁齐敢后。\n容与嘉觞，式歆旨酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"有严在涤，陈彼牲牢。\n孔硕其俎，荐此血毛。\n厥初生民，饮茹则然。\n以燔以炙，伊谁云先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 商丘宣明王位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"二七储神，与天地并。\n孰俪厥德，聿惟南正。\n功楙陶唐，泽流亿姓。\n作配严禋，贽列惟称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 大辰位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"维莫之春，五阳发舒。\n日之夕矣，三星在隅。\n莫量匪币，莫嘉匪玉。\n明荐孔时，神光下瞩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"屹彼嘉坛，赤伏始届。\n掞光耀明，洋乎如在。\n俛仰重离，默与精会。\n随我降升，肃听环佩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 其三 降神用《高安》。","author":"郊庙朝会歌辞","text":"火在六气，独处其两。\n感生维君，繄辰克相。\n何以验之，占兹垂象。\n腾驾苍虬，歘其来飨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 其二 降神用《高安》。","author":"郊庙朝会歌辞","text":"乐音上达，粤惟出虚。\n火性炎上，亦生于无。\n我镛我磬，我笙我竽。\n气同声应，昭哉合符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出火祀大辰十二首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"烨烨我宋，火德所畀。\n用火纪时，允惟象类。\n神以类歆，诚繇类至。\n有感斯通，孚我阳燧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司中司命五首 其五 送神用《欣安》。","author":"郊庙朝会歌辞","text":"云兮飘飘，风兮棱棱。\n飙驭返空，杲日来升。\n归旆扬扬，众乐锵锵。\n我神式欢，惠我嘉祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司中司命五首 其四 酌献用《雍安》。","author":"郊庙朝会歌辞","text":"酌兹旨酒，既盈且芬。\n式用来歆，衎衎熏熏。\n何以宁神，荐有嘉笾。\n何以锡民，曰惟丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司中司命五首 其三 奠币用《容安》。","author":"郊庙朝会歌辞","text":"我诚既洁，我豆既丰。\n神来降斯，有俨其容。\n荐此嘉币，肃肃雍雍。\n何以侑之，于乐鼓钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司中司命五首 其二 升降用《钦安》。","author":"郊庙朝会歌辞","text":"绅緌舒舒，佩环铿铿。\n陟降上下，坛燎光明。\n有盥于罍，有帨于巾。\n不吴不敖，庶以安神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司中司命五首 其一 迎神用《欣安》。","author":"郊庙朝会歌辞","text":"冠峨峨兮，服章蕤蕤。\n灵来下兮，进止委蛇。\n我涓我坛，我洁我俎。\n降舆却旌，于兹享御。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁宗登门肆赦二首 其二 降坐用《乾安》。","author":"郊庙朝会歌辞","text":"天日清晏，朝野靖安。\n三灵答祉，万国腾欢。\n帝命不违，王业艰难。\n天子万年，永迪监观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁宗登门肆赦二首 其一 升坐用《乾安》。","author":"郊庙朝会歌辞","text":"帝飨于郊，荷天之休。\n五福敷锡，皇明烛幽。\n云行雨施，仁翔德游。\n圣人多男，歌颂九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]