[{"title":"某伏蒙宫师相公杜寄示新居诗斋沐捧读不胜铭叹某谨成拙诗一章上纪盛德粗伸谢意","author":"文彦博","text":"年至即还政，贤哉近古稀。\n明哲冠四辅，谋猷翊万微。\n名遂身乃退，意确天弗违。\n奇节焕青简，遗法在黄扉。\n仁里开新第，德宇翔采翚。\n宴宅俭有制，丘墙高可依。\n雅言重金鼎，清音繁玉徽。\n一览近观徼，三复终研几。\n私橐永缄秘，蔀室增光辉。\n信矣贤人业，发于君子机。\n孤生怀绛帐，引颈咏缁衣。\n圣神方图任，日冀东山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招刘伯寿秘监","author":"文彦博","text":"君自山中来，熟见山中事。\n我亦山中人，素怀归山志。\n切望青牛车，细问归山计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题史馆兵部傅君草堂","author":"文彦博","text":"羡君济上墅，胜概不可名。\n泉石与松竹，声影交相清。\n周墙数百堵，版筑皆亲营。\n箕尾出南极，直对茅轩明。\n陶庐自爱乐，蒋径堪逢迎。\n但恐赤松子，到此难忘情。\n拾却留侯伴，从吾林下行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过燕川渡","author":"文彦博","text":"燕川东北孔山西，借车直渡马头溪。\n农樵引路津不迷，行行引上青云梯。\n回头不视林木低，谷风冷冷山鸟啼。\n岩隈泉甘土仍肥，昔人于斯卜幽栖。\n春深芝朮生新荑，采芝茹朮希夷齐。\n诸公共游不知疲，长吟吐气如虹蜺。\n水演石上写此诗，手拭苍藓脚踏泥。\n冒寒履险不惮辞，勉欲继踵前贤题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题密州超然台","author":"文彦博","text":"莒侯之燕处，层台逾十寻。\n俯镇千乘国，前瞻九仙岑。\n勿作西州意，姑为东武吟。\n名教有静乐，纷华无动心。\n凭高肆远目，怀往散冲襟。\n琴觞兴不浅，风月情更深。\n民被裤襦惠，境绝枹鼓音。\n欲识超然意，鸰原赋掷金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞下曲 其一","author":"文彦博","text":"老上焚庭后，昆邪右衽时。\n休开小月阵，罢祷拂云祠。\n徒觉筋竿劲，宁闻羽檄驰。\n祁连皆积雪，渠答夜应施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞下曲 其二","author":"文彦博","text":"朔漠凝寒久，穷荒气候赊。\n冻云藏虎谷，残雪满龙沙。\n地回胡风急，天高汉月斜。\n何人动乡思，垄上听金笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"折杨柳","author":"文彦博","text":"长忆都门外，低垂拂路尘。\n更思南陌上，攀折赠行人。\n行人经岁别，杨柳逐年新。\n何当逢塞雁，重寄一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"关山月","author":"文彦博","text":"宕子久行役，辽西戍未还。\n佳人怨遥夜，清泪浥朱颜。\n藓晦兰闺寂，尘昏宝鉴闲。\n相思不相见，明月下关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采莲曲","author":"文彦博","text":"江南秋色蚤，江上蚤莲芳。\n佳人采红萼，两桨渡横塘。\n翳日华芝薄，随风锦䋏长。\n荡舟方自乐，绿水任沾裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜夜曲","author":"文彦博","text":"明月流清汉，娟娟照洞房。\n微风吹败叶，飒飒下银床。\n尘晦流黄素，炉销壁恶香。\n年年机杼妾，独怨夜何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长相思","author":"文彦博","text":"远别苦无悰，离居常戚戚。\n顾慕怀所欢，徘徊弥自惜。\n琼蕊不可采，瑶华未堪摘。\n惟凭尺锦书，一寄长相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阳春曲","author":"文彦博","text":"颇伤金管遽，仍恨缇光促。\n四序若循环，百年如转轴。\n佳人暮不归，兰苕春又绿。\n空持绿绮琴，愁弄阳春曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陌上桑","author":"文彦博","text":"佳人名莫愁，采桑南陌头。\n困来淇水畔，应过上宫游。\n贮叶青丝笼，攀条紫桂钩。\n使君徒见问，五马亦迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巫山高","author":"文彦博","text":"巫山高不极，高与碧穹齐。\n朝云常蔼蔼，暮雨复凄凄。\n髣髴闻珠佩，依稀认绣袿。\n无能留彼美，徒使梦魂迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御沟","author":"文彦博","text":"远疏银派浪，深入帝王州。\n不为朝丹禁，何缘异众流。\n冷穿平乐观，清绕景阳楼。\n金屋严妆罢，香波苑外收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"文彦博","text":"翠羽亭亭盖，微障越鄂君。\n锦书何日寄，绣被几时薰。\n步稳非因学，丝轻未见棼。\n唯愁容易散，尽作楚天云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读汉史 其一","author":"文彦博","text":"汉室言中圮，咸京欲伴芜。\n髹墀倾馺娑，齯齿笑诸于。\n未暇平青犊，旋闻奉赤符。\n货泉诚妄改，天命本难渝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读汉史 其二","author":"文彦博","text":"久吏皆黄发，频年困赤眉。\n忽逢司隶属，重睹汉官仪。\n讴咏皆欣合，民灵共乐推。\n区区蹇嚣辈，犹不悟天时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西晋","author":"文彦博","text":"马圉言虽验，凫毛事亦奇。\n紫微才遍植，白刃已交驰。\n星麦应无酒，私蛙尚有糜。\n铜驼休反袂，何救黍离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉阶树","author":"文彦博","text":"亭亭依玉砌，郁郁尽琼枝。\n璧月夜虽照，金风秋更吹。\n陈宫唯是唱，汉殿只应悲。\n似有君轩恋，岁寒终不移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"文彦博","text":"西陵何限柏，一一胜瑶华。\n几纵青丝骑，多逢油壁车。\n香囊犹未致，春带已成赊。\n莫作云间月，愿亲梁上霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠市隐者","author":"文彦博","text":"縠帔绛绡头，墙东隐侩牛。\n闲门甘肮脏，薄俗重伊优。\n有頍宁须拂，无资可用游。\n故人虽茜旆，那复问前驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中隐者","author":"文彦博","text":"尘中久绝迹，谷口自忘机。\n草桥凌晨出，柴车向夕归。\n磴泉濡蕙带，径竹败荷衣。\n借问何为者，山中尝采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作示同志","author":"文彦博","text":"隐几清吟久，投瓢浩叹频。\n如何爵举日，犹是传还人。\n胶葛终当戾，洿涂偶未伸。\n若嫌家监傲，殊不厚田仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜思","author":"文彦博","text":"明河秋耿耿，小阁夜愔愔。\n鲁酒不成醉，洛生唯是吟。\n簟凉初卷玉，垆暖乍薰金。\n默坐终无寐，西窗月影沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华月","author":"文彦博","text":"皎皎新秋月，分明照洞房。\n几人千里别，今夜九回肠。\n皓彩穿珠幌，澄辉上璧珰。\n画楼兼绣户，浑是可怜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲斋偶作","author":"文彦博","text":"鼓吹尽私蛙，蓬蒿蒋径斜。\n梧高唯待凤，柳密只容鸦。\n度暑巾裁縠，迎凉帐卷纱。\n茂陵无奈渴，犹有镇心瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏筝","author":"文彦博","text":"别院秋仍静，高堂夜更闲。\n繁丝移宝柱，数曲奏阳关。\n好荐琼筵上，长亲黼座间。\n野王虽后出，无复谢东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪","author":"文彦博","text":"同云方霭霭，琼屑已瀌瀌。\n陌迥皆连璐，台高尽结瑶。\n羽樽深酌桂，砀壁暖涂椒。\n谁念牛衣客，袁扉困一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旭日","author":"文彦博","text":"乍出扶桑海，如轮隐半规。\n未晞槃上露，已侧槛中葵。\n赫奕晨霞映，空濛晓雾披。\n君看可怜处，偏在照梁时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋望","author":"文彦博","text":"远目仍秋望，依依江上风。\n烟涛寒飐白，霜叶乱翻红。\n列岫晴霞外，遵鸿晚照中。\n羁怀同屈宋，倚立恨无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏苔","author":"文彦博","text":"绵绵上钓矶，漠漠拥闲扉。\n石面风梳发，垣根雨濯衣。\n不将凡卉杂，还与俗尘违。\n谢砌曾成咏，深严近紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏柳","author":"文彦博","text":"带缓何曾绾，眉长未见愁。\n青青缘御路，郁郁映金沟。\n乱絮凌空荡，繁丝逐吹流。\n传闻隋水上，千树拥迷楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉梁","author":"文彦博","text":"玉梁千丈驾澄流，曾与群仙烂熳游。\n丹桂扶疏应近月，紫苔漫没几经秋。\n濛濛五里皆金雾，岌岌三休是宝楼。\n此地回骖时一望，世间尘上尽蜉蝣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽兰","author":"文彦博","text":"燕姞梦魂唯是见，谢家庭户本来多。\n好将绿叶亲芳穗，莫把清芬借败荷。\n避世已为骚客佩，绕梁还入郢人歌。\n虽然九畹能香国，不奈三秋鹈鴂何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄友人包兼济拯","author":"文彦博","text":"缔交何止号如龙，发箧畴年绛帐同。\n方领聚游多雅致，幅巾嘉论有清风。\n名高阙里二三子，学继台城百六公。\n别后愈知琨气大，可能持久在江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公子","author":"文彦博","text":"甲第峨峨爵观前，对回微岸鵔鸃冠。\n锦鞯飞鞚丹砂埒，蜜炬流膏紫玉槃。\n狐尾单衣常裛麝，虎头双绶镇薰兰。\n闲驰便面章台陌，里巷儿童逐弹丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓怀","author":"文彦博","text":"高楼闲背夕阳登，渺渺长怀不自胜。\n锦瑟有时闻北渚，钿车何日到西陵。\n地寒萱草犹难种，天远瑶华岂易凭。\n多谢苏门清啸客，了无尘事染壶冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时兴","author":"文彦博","text":"纶巾短袖迎凉服，茧犊笨车乘兴游。\n岂谓烟霞生旷达，只缘尘土倦伊优。\n更无倾盖将谁共，纵有吹彫不我留。\n曾达酒垆惟独醉，幰前犹恨欠三驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑中书事","author":"文彦博","text":"薰飙猎猎度融纱，赫日流金树影斜。\n寝簟冷便铺薤叶，门裾轻爱曳橦华。\n仙槃想挹三危露，灵汉思乘八月槎。\n雪散冰丸犹长物，镇心堪笑茂陵瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初曙","author":"文彦博","text":"汉宫金掌露淋漓，椒殿装梅欲罢时。\n宿霭空濛昏绣桷，晓暾依约上文㮰。\n九苑威凤犹栖阁，三匝惊乌尚绕枝。\n玉女窗虚莲烛谢，西南金魄隐残规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人留题华清宫温泉","author":"文彦博","text":"玉唾神游接汉京，朝元金碧照天明。\n香波浅斗龙原润，炎液深涵雁甃清。\n狎猎乱光浮藻井，穹隆长影浸彫楹。\n圣皇勤俭无西豫，辇路经春烟草平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋风吟","author":"文彦博","text":"猎遍兰丛与桂枝，巢居未必有先期。\n灵台十仞乌随转，阿阁三重凤岂知。\n度柳暗催蝉嘒嘒，出云高送雁离离。\n汉宫玉树知何限，争忍重吟画扇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅史有感","author":"文彦博","text":"缥帙青箱次第开，慨然英气转难裁。\n莫言美事俱长往，须有清风属后来。\n弹铗始知皆琐旅，枕戈方信是雄才。\n平生自况真非薄，只是休容楚鸩媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诏开礼闱偶作呈诸友","author":"文彦博","text":"星弧首辟群英彀，天毕初张众目罗。\n汉傅仍闻求泛驾，周明何止育菁莪。\n碧纱已有蓬山籍，绿李将分桂殿科。\n全伏阿香推毂力，九门三月化陶梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省试蒲车诗","author":"文彦博","text":"汉祀精禋洁，云亭禅礼殊。\n金泥伸秘检，车毂尚编蒲。\n越席侔前制，文茵愧后涂。\n软轮同致美，规地用难符。\n翠幰芳蕤集，华芝秀彩敷。\n升中仪矩盛，备物壮皇图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天圣五年春省试献羔开冰","author":"文彦博","text":"国重司寒祭，羔羊献礼陈。\n开冰遵旧典，荐庙属昌辰。\n肥羜方登俎，清壶冀飨神。\n虫疑非蚤夏，狐听异先春。\n凿凿凝光瑩，峨峨发彩新。\n何当比鱼上，从此出迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日作","author":"文彦博","text":"万寿称觞日，天光肇祚辰。\n新阳方改故，暖律已升春。\n桃梗分朱户，椒花献紫宸。\n子舆方养浩，何必造盘辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日偶作","author":"文彦博","text":"借问此何时，南园蝶又飞。\n杏梁栖紫燕，麦垄覆惊翚。\n榆荚深堆砌，杨花乱扑衣。\n洛吟经永日，还似舞雩归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"文彦博","text":"洛涘幽居植，江南驿使传。\n一阳初应候，万木独为先。\n素萼凌繁雪，清香袭淡烟。\n欲知佳丽处，汉殿晓妆妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元巳阻雨","author":"文彦博","text":"林花脉脉怯朝烟，雨隔兰庭曲水筵。\n欲买春花无定价，东风撩乱掷榆钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和友人春日即事","author":"文彦博","text":"小院闲扃煦日长，静探琅简事虚皇。\n依依柳荫银塘暗，习习风穿玳押凉。\n碧合暮云连础润，绿攀奇树透怀香。\n蒙山近得脩真诀，辟谷常餐太乙粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬金华山人春日见寄之什","author":"文彦博","text":"漠漠鲜云习习风，谷莺娇啭小园中。\n谢塘初长如裀草，湘渚难留避弋鸿。\n轻雨落花红扑地，惹烟垂柳绿萦空。\n寻芳好伴高阳侣，深忆东山采药公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和友人春日即事","author":"文彦博","text":"青阁登临恨已多，可堪兰景又妍和。\n书囊阅尽应成癖，诗思狂来恐是魔。\n玉树芬芳连雾縠，珠栊隐映隔云萝。\n鹴裘贳得杨昌酒，度日无悰倚瑟歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡斋春日书怀","author":"文彦博","text":"煦日亭亭昼渐长，烟藏幽砌蕙兰香。\n纤垂谢监园中柳，嫩折罗敷陌上桑。\n出谷晓莺迁绮树，入檐风燕语雕梁。\n瑶华欲寄岭头信，心逐白云归帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长平怀古","author":"文彦博","text":"此子徒能读父书，兵降始信蔺相如。\n却令后代承家者，每到长平戒覆车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题筹笔驿","author":"文彦博","text":"卧龙才起扶衰世，料敌谋攻后出师。\n帏幄既持先圣术，肯来山驿旋沉思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩溪诗 其一","author":"文彦博","text":"韩信未遭面主顾，萧何亲至此中追。\n君王有意争天下，不得斯人未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩溪诗 其二","author":"文彦博","text":"平日渔樵皆病涉，当年将相尽成功。\n淮阴未济酂侯识，留得雄才归汉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩溪诗 其三","author":"文彦博","text":"水滨山曲暂盘桓，盛事临风一据鞍。\n莫讶史君频叹咏，古来君相受知难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩溪诗 其四","author":"文彦博","text":"途中胜迹尽留题，独有韩溪未有诗。\n直把芜词重叠咏，只图流播路人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿绮","author":"文彦博","text":"楚舞休飞鹤，燕歌罢绕梁。\n高堂横绿绮，上客奏明光。\n秋月华池净，春风蕙草香。\n还邛有辞赋，仙凤正求皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蘅皋","author":"文彦博","text":"蘅薄频牵望，阳林久驻镳。\n香囊徒叩叩，云月自苕苕。\n翠佩传情密，曾波托意遥。\n翩鸿渐高逝，翻恨隔神霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深院","author":"文彦博","text":"杨柳亭台暮，梨花院落深。\n玉池波湛湛，珠幌影沈沈。\n远思随庄蝶，春怀怯雍琴。\n萱苏不蠲忿，拥鼻独清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓","author":"文彦博","text":"宿霭藏飞观，晨霞幌绣甍。\n锦帏人未起，珠树鹊先惊。\n炉暖香初烬，窗幽烛尚明。\n更开花上露，妆泪斗盈盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芳草","author":"文彦博","text":"绮节初抽翠，金塘久托根。\n何堪混萧艾，自合比兰荪。\n碧映龙池水，青迷楚泽魂。\n年年增恨处，长信与长门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公子","author":"文彦博","text":"朝罢章台陌，追随紫燕光。\n雁陂冠绿帻，洛浦授明珰。\n下士营三窟，名姬号四香。\n十千沽斗酒，结客少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]