[{"title":"金沙","author":"胡寅","text":"海棠开后数金沙，谁料炎荒有此花。\n青玉案头张重锦，碧云堆里漏彤霞。\n高枝已写清尊照，嫩蕊犹须翠幕遮。\n未信东风肯吹谢，且教游客看繁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将次钟乡先寄处厚唐丈","author":"胡寅","text":"试问云山数岁华，寒梅吹尽两年花。\n倦游吴楚六千里，幸脱兵戈三四家。\n那用有田从桀溺，且欣无疾住毗耶。\n欲将别后从头说，满眼春酤尽更赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将游上封先寄南台珏老","author":"胡寅","text":"淅淅风摇玉露秋，尚怀分柿半山不。\n众香肯共维摩饭，元亮聊同惠远游。\n荟蔚彫零岩壑露，佩环清越涧泉幽。\n青鞋本自无泥滓，更约诸峰最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸丑元日文定时留丰城今归青湘唁家","author":"胡寅","text":"去年已向爆声残，晓气絪缊雨不寒。\n玉佩想闻趋桂殿，綵衣遥祝献椒盘。\n千龄帝运方更始，一统王春正履端。\n不与时光共流转，此心那更觅人安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴宣卿牡丹之集和奇父二首 其二","author":"胡寅","text":"移得仙丹手自封，护花云结秀阴浓。\n未嫌芍药争时发，却有酴醾作酒供。\n喜见典型开朵朵，宁须绯紫计重重。\n定知禾黍胜桃李，何似犁牛问老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴宣卿牡丹之集和奇父二首 其一","author":"胡寅","text":"胜业看花暖正繁，玉仙洪福且休论。\n初筵爱客尊俱尽，落笔成诗水共翻。\n京洛追游真似梦，风光流转绝无言。\n武林亦有西池否，安得姚黄奉至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱推于水东口","author":"胡寅","text":"送客水东口，散襟城北头。\n清风正骀荡，细雨忽飞浮。\n荒传少来燕，平田多乳鸠。\n何时理归棹，横笛下沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姜医与能仁西堂印老能仁韦宙读书之地","author":"胡寅","text":"韦公挟策漫荆榛，牧子亡羊也未真。\n百叠乱山秋思杳，半岩脩竹岁寒亲。\n不须招手游莲社，且可冥心舍筏津。\n山芋畦蔬正味好，饷君姜醢助芳辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送茶与执礼以诗来谢和之","author":"胡寅","text":"箪瓢曾不饱颜回，何事新茶转海来。\n八饼尚怀经幄赐，一苞聊对岭云开。\n分君要使浇书腹，待客应须罢酒罍。\n自笑玉川空两腋，清风无梦到蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄权守归八桂三首 其三","author":"胡寅","text":"雨岸溪纹蹙，风亭柳带萦。\n借留无上策，送别有兼程。\n望杳云间旆，班馀野外荆。\n路从簪玉去，增我故山情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄权守归八桂三首 其二","author":"胡寅","text":"乐物羁栖伴，筋骸放逐馀。\n自甘门有雀，宁叹食无鱼。\n倾盖情文腆，投醪笑语舒。\n晚途多感慨，赖此得时祛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄熙赴韶推","author":"胡寅","text":"籯金不取义方严，孝友家庭岭海瞻。\n力古共推经笥富，决科争看笔锋铦。\n才非俗契心难展，清畏人知德尚潜。\n鹏翼垂天终九万，固应凫舄未能淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黎才翁往荆门","author":"胡寅","text":"圣道原来不易穷，君今何处觅同风。\n唐虞世远精神在，邹鲁人归事业崇。\n德性未尊须强学，道心才胜即收功。\n他时杯酒论暌阔，应有微言激懦衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九简单令","author":"胡寅","text":"殊方令节也堪怜，可咏江涵雁影篇。\n买得紫萸虚市里，种成黄菊小池边。\n相逢便是华胥国，一醉宁惭玳瑁筵。\n何必登临追旧俗，南山秋气自超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽刘忠显 其二","author":"胡寅","text":"未识堂堂玉立姿，已传薤露满山悲。\n空馀父执修恭意，谩继词流纪德诗。\n诸子尽贤门益大，万家馀地冢初累。\n纷然尽夺三军帅，谁识公心死不移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吴丞相 其三","author":"胡寅","text":"黄扉清启帝之初，俊乂招徕念远图。\n桃李舒华方雨露，鸳鸿戢翼又江湖。\n当年举国蒙休烈，至死无人雪厚诬。\n圆觉妙明何计此，独疑遗恨绕苍梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吴丞相 其一","author":"胡寅","text":"妙龄一月了群书，未壮声华众已孚。\n器远况曾师旧德，时来俄看献嘉谟。\n亲扶日毂升天路，不许金戈入帝都。\n大节已全名自永，讵同奸慝苟全躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吴丞相 其二","author":"胡寅","text":"追念宣和国势孤，上公元宰导人谀。\n妖氛已觉前星暗，皇泽宁论少海枯。\n谁谓玉华传玉座，共知青琐伏青蒲。\n谗言一发堪流涕，祸在同升有鄙夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李太孺人","author":"胡寅","text":"桂水无情日夜东，空馀丹旐溯西风。\n一经不负门闾望，五鼎端宜馈祀丰。\n茂渥出纶观有炜，芳徽勒石播何穷。\n遥知祖送诗千首，挽铎声悲大队中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽杨子川","author":"胡寅","text":"倾盖小冠市，论文乔岳阳。\n一生能几屐，两鬓忽成霜。\n我尚栖南岭，君俄赴北邙。\n无因浇絮酒，回首重呻伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽杨训母荚氏","author":"胡寅","text":"戚戚秋风飐旐旌，送车千辆咽佳城。\n令妻寿母名兼美，孝子慈孙礼备成。\n望士有诗歌绋綍，梵坊无侣献铙钲。\n更惭朴语书铭石，万一幽光久更明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈几叟","author":"胡寅","text":"妙质曾挥匠石斤，久于其道更超群。\n皂貂破敝头蒙雪，黔突凄凉气吐云。\n忽上谏坡规帝德，又陪经殿劝皇坟。\n事功难必清名在，未辱先贤付托勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽某氏","author":"胡寅","text":"慈祥令淑禀于天，宗族闺门共仰贤。\n中馈克脩惟六二，义方能教亦三迁。\n艺萱无复忘忧日，种柏行看合抱年。\n旧欲升堂今已矣，大招成些重凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽端州黄大用大用喜读书有志行数过予讲讨虽未诣宗本要自佳士可尚也心为形役遂以病死作二诗哭之 其二","author":"胡寅","text":"锯屑霏谈涉往今，濡毫洒纸掞词林。\n听歌鹿野三章后，帐下龙门九曲深。\n十口西畴贫索莫，一官南选晚侵寻。\n早知大易无思虑，应悔生前未洗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黎承事 其一","author":"胡寅","text":"北正黎司地，南来得姓繁。\n清时能教子，馀润必高门。\n珠蚌他年誉，金籯晚岁温。\n王师勤佐馈，乡斗待平反。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黎承事 其二","author":"胡寅","text":"援手遗嫠难，酬心乐泮恩。\n凄凉投辖井，慨叹给孤园。\n艺槚平居近，攀松永慕敦。\n流年驹过隙，不辱付诸昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别王元治师中谭纯益三首 其三","author":"胡寅","text":"欲步夷途盍近思，行寻捷径却成迟。\n大弨不必穿杨叶，古乐何曾唱竹枝。\n须信孔门无用赋，也知高叟漫为诗。\n功名易立书难读，努力当乘少壮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别王元治师中谭纯益三首 其二","author":"胡寅","text":"幸不当官也去思，春江风日正舒迟。\n少留画鹢呼桃叶，捲尽红螺看柘枝。\n三爵劝酬三益友，四并除扫四愁诗。\n渭城景色朝朝是，不用丹青李伯时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别王元治师中谭纯益三首 其一","author":"胡寅","text":"儿钓童游几梦思，春风千里恨归迟。\n君今旧隐治三径，我尚他州寄一枝。\n载酒犹惭来问字，对花深欲共论诗。\n不堪又听阳关曲，想见酴醾喷雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别唐次山","author":"胡寅","text":"占君州土负沉痾，饱听溪山欸乃歌。\n季路漫传能折狱，阳城元自拙催科。\n苟逃谴责恩波厚，更喜逢迎廪粟多。\n珍重老人分手意，论文何日再经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别贾阁老","author":"胡寅","text":"熙朝侍从老堂堂，和气如春与物昌。\n未见峨冠真楚越，思逢倾盖在潇湘。\n放怀缱绻情何厚，忧世艰难话更长。\n果有南山求问意，芷兰犹冀袭清芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷花","author":"胡寅","text":"梦到南塘翠盖稠，姹然得意敛然羞。\n惊鸿远映朝霞色，白鹭先窥霁雨秋。\n袅袅芳馨烦折赠，霏霏凉吹想追游。\n天花欲试维摩病，衣袂何曾一片留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郭伟求鄙文","author":"胡寅","text":"少时文墨已非工，渐老才情更觉蒙。\n空有簿书相汩没，了无朋友共磨砻。\n功名也只浮云似，富贵还应逝水同。\n寄语宅心何处所，晚春沂上舞雩风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿馀干临江高寺题清音寺","author":"胡寅","text":"閒身何事有尘劳，憩息欣逢一榻高。\n瀼水转湾如玉玦，曲洲斜抱记檀槽。\n凭栏偶见飞鸿翼，对酒仍持紫蟹螯。\n畴昔未观东汇泽，片帆聊欲驾洪涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈生","author":"胡寅","text":"穷冬才得雨梢梢，梅已无馀柳渐包。\n且把简编遮病眼，时拖衾絮拥寒骹。\n讥诃驳杂怀张籍，联续诗章忆孟郊。\n归卧萧斋谅安稳，可无消息到衡茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄奇父","author":"胡寅","text":"似闻北舍与南邻，各向西畴答问津。\n独使丈人留阒寂，更无佳客奉光尘。\n思公待泛山阴雪，破闷须携曲米春。\n往行前言未多识，古来元重老成人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄唐坚伯","author":"胡寅","text":"君诗平昔思如泉，无事寻医孰使然。\n礼尚往来思报玖，情深汲引屡抛砖。\n岂能遽造忘言地，应有沉吟得意联。\n待听钟声撼清夜，明朝纸贵万人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题吴郁养素轩","author":"胡寅","text":"到处风尘染素衣，蜉蝣掘阅尚何知。\n似闻扫雪开三径，可但移梅探一枝。\n分我高山弹旧曲，乞君明月斲新诗。\n几时把酒临窗槛，借问如何涅不缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜义卿得子端倅摄新守","author":"胡寅","text":"喜乐民宜甚，平反笑屡春。\n故应熊梦协，还见凤毛新。\n桂籍他年继，桑弧旧俗因。\n岂无汤饼会，也合到穷宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"胡寅","text":"闻说频年旱，先怀并日忧。\n家书不易到，囷米谅难求。\n一雨连三夕，千仓裕九秋。\n若为知帝力，鼓腹听蛮讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食日约蔡生以雨不至","author":"胡寅","text":"细雨斜风恼弄春，荒郊不见踏青人。\n伤心湖外松楸域，吊影天涯露电身。\n杨柳杏花何处好，石泉槐火一时新。\n举杯幸有君相属，更待泥乾步屧匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游三角寺","author":"胡寅","text":"再游三角寺，胜践十人偕。\n雨后林峦媚，心同笑语谐。\n碧兰初秀畹，红药渐翻阶。\n若问经行意，春风写客怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游龙山寺六祖故居也","author":"胡寅","text":"范阳卢以仕南迁，卜宅空山不计年。\n间气有钟超象类，美材无匠制方圆。\n谁能判断风幡话，等是追随粥饭缘。\n携客同来又同去，浮屠依旧插苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游武夷赠刘生","author":"胡寅","text":"六曲睎真馆，千松夺秀亭。\n回桡失相值，载酒约重经。\n小雨装图画，红尘隔杳冥。\n更烦横铁笛，吹与众仙聆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游淡竹岩","author":"胡寅","text":"岩好城还近，山南路却西。\n淡交同鲁卫，新酿到青齐。\n桑密家家茧，秧稠处处犁。\n朱陵更清绝，何必此幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊雷春雪示吉甫","author":"胡寅","text":"晓色空明衡岳南，一尘那复隔仙凡。\n贯时松竹色自好，破腊雷霆声未咸。\n万里鲛绡开步障，千金火浣试春衫。\n渔舟不与人供画，独驾云涛月满帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠舂陵石山","author":"胡寅","text":"何人蹙缩九疑山，叠映公家几砚间。\n欲识神鱼閟凝湛，试看云气出孱颜。\n新蒲已结根千岁，旧藓犹窥晕一斑。\n举饷敢辞归载重，要将奇绝寄幽閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢朱推梅栽","author":"胡寅","text":"南国虽云有学堂，了无松菊径徒荒。\n瘴痕元爱冰花洗，衰鬓聊依玉树芳。\n便觉小池招秀影，更令寒月映新妆。\n从今剩酝萸香酒，指拟春风摘子尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢周尉用前韵致丹砂且见劝葆真","author":"胡寅","text":"寒衾未暖睫先交，晓漏那闻促点敲。\n非有真丹存下海，讵同和气满春郊。\n王弘颇亦知陶令，仲达何劳诮石苞。\n为报迩来幽意惬，箨龙拳鳖渐充庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢彦脩携具见过","author":"胡寅","text":"识字深惭扬子云，载醪何以塞殷勤。\n山腾海浪兼天碧，雨荐秋声映烛闻。\n秘藏未能窥佛界，剧谈聊足张吾军。\n浮蛆玉色人间少，判却陶然引十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢赵戎惠白菘甚腴且再求之","author":"胡寅","text":"已是居无竹，那堪食一箪。\n烦君饷园茹，使我助盘餐。\n秀色春风早，甘肥晓露漙。\n美材今又阙，小摘更相宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢道醇见和","author":"胡寅","text":"畏隹于喁处处哗，先春吹出万林花。\n要看腊瑞三番白，宁许霜威十倍加。\n瓦陇未平俄淅沥，冰池难合漫槎牙。\n若嫌吾土山川暖，蜀客相逢尚可夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢蔡生见和","author":"胡寅","text":"三分已过二分春，尚想绵田一善人。\n冷食未平千载恨，浮云何与百年身。\n从教对雨携壶阻，自爱观风得句新。\n芍药酴醾无复见，花林芳草翠初匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋永宁严老幻庵","author":"胡寅","text":"物理初无妄，云何以幻观。\n得非心有碍，坐使肉生瘢。\n日月当天久，山河著地安。\n波斯不别宝，学道古来难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遇雨晚宿和彦达","author":"胡寅","text":"天以春归野，云将雨暗山。\n三人行甚乐，五字句何艰。\n每喜诗偿债，还须酒破颜。\n禽声接芳树，和气亦关关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"携酒访奇父小酌竹斋以诗来谢次其韵","author":"胡寅","text":"优游林麓避尘沙，杖策巾横一幅纱。\n却老自烧金鼎药，醒心时进玉川茶。\n钩窗爱日频迁坐，荫竹流泉屡满洼。\n常记此欢同醉处，歈歌折柳舞传巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新州鹿鸣宴致语口号","author":"胡寅","text":"秋气清高肃雁行，贤侯劝驾会黄堂。\n宾朋满座曳珠履，鼓吹喧天飞羽觞。\n题柱弃繻俱有志，班荆折桂正相望。\n明年春色催行李，衣锦荣归耀故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春即事二首 其二","author":"胡寅","text":"恰赋春还柳，俄闻地出雷。\n雨丝分织作，风籁急喧豗。\n寂寂炉无火，欣欣瓮有醅。\n临寒插羔袖，雪观亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春即事二首 其一","author":"胡寅","text":"竹爆腊寒尽，桃符春事来。\n和风已披拂，暖日便徘徊。\n曳杖閒挑菜，攀枝齼摘梅。\n太牢虽有味，岂必胜登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溯江濡滞","author":"胡寅","text":"何处难忘酒，舟行不进时。\n漫流迷纤道，数日诮篙师。\n近树久犹见，远山都未移。\n此时无一盏，吾意亦纾迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简单周二子 其一","author":"胡寅","text":"回首清明远矣哉，和风还挟禊辰来。\n丽人空忆行歌乐，曲水难追翰墨才。\n鬓发飘萧吾自祓，形骸放荡孰相开。\n早知胜集荷塘上，何不飞觞看耻罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简单周二子 其二","author":"胡寅","text":"音尘疏阔思悠哉，有底匆匆不我来。\n阵合鹳鹅须敌手，诗成珠玉要奇才。\n新荷雨定如兰馥，曲沼风閒作镜开。\n况是凉蟾方半璧，清光应欲照金罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简奇父","author":"胡寅","text":"累旬不见孙夫子，闻学神农阖户眠。\n药物谅能收近效，精神应复类癯仙。\n欲趋丈室求高论，恐费华池溉下田。\n指日春风动花柳，也须乘兴慕斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简彦达","author":"胡寅","text":"别来鱼雁半浮湛，一日掀杯酒便深。\n照水颜容皆欲老，荫门槐竹尽成阴。\n驱山塞海成何事，饭糗羹藜只此心。\n但愿岁丰人共乐，扶筇有兴即相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨次家君元日之韵","author":"胡寅","text":"薰然和气爆声残，贺客充庭上庆笺。\n令节共欣元会日，本朝新数中兴年。\n仰观北斗书王正，合起东山付国权。\n天祐斯文知有在，称觞还咏福如川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]