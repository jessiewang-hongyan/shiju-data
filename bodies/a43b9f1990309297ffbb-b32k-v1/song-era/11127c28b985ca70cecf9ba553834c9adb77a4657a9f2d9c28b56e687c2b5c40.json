[{"title":"寒食雨中 其一","author":"杨冠卿","text":"无家可耐异乡何，怪底愁边万感多。\n今夜雨昏山月暗，泪痕元不减金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨中 其二","author":"杨冠卿","text":"晚风一再花狼籍，春去匆匆不可寻。\n蜂蝶亦如人意薄，便无消息到墙阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡口","author":"杨冠卿","text":"欲系孤舟日已斜，秋霜一岸著蒹葭。\n若为唤得愁魂醒，柱杖穿沙寻酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道间所见","author":"杨冠卿","text":"窄窄山腰路，娟娟屋角花。\n溪回蔽修竹，鸥暖戏春沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上与郑将夜饮 其二","author":"杨冠卿","text":"几年京洛暗胡尘，老上龙庭恨未焚。\n安得君王倚天剑，提携直上决浮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上与郑将夜饮 其一","author":"杨冠卿","text":"白发将军夜枕戈，楼兰未斩奈愁何。\n挑灯看剑恍如洗，那听萧萧易水歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漫题","author":"杨冠卿","text":"著雨林花暗，敲风槛竹幽。\n翠屏疏得梦，红叶忽惊秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四绝 其四","author":"杨冠卿","text":"阿娇厌贮黄金屋，洗尽铅华儿女妆。\n香魂寒夜伴幽独，青灯相对吟胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四绝 其三","author":"杨冠卿","text":"涂黄不学汉宫妆，一点檀心万斛香。\n嚼蜡我今忘世味，羞将花谱细平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四绝 其一","author":"杨冠卿","text":"游蜂辛苦事芳菲，嚼蕊偷香酿蜜脾。\n还被东风巧收拾，又随春色上南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅四绝 其二","author":"杨冠卿","text":"枝上编钟万颗垂，凌寒傲视雪霜姿。\n从今疏影暗香句，不数西湖处士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张安国舍人平沙落雁图","author":"杨冠卿","text":"渚云低压云山暮，烟素横空落日斜。\n秋老江乡稻粱熟，一行征雁下平沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画扇","author":"杨冠卿","text":"断桥流水小舟横，卧看林梢素月明。\n双鹤不知何事舞，风前时送九皋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题凌波采莲图","author":"杨冠卿","text":"绰约风姿云雾衣，波心新月映明辉。\n更深折得清香去，烟霭不知何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与金陵傅漕余预乡荐时傅兄持文衡 其二","author":"杨冠卿","text":"乡书忆昔献贤能，姓字曾叨天府登。\n阙里抠衣欣附凤，云程敛翼愧飞鹏。\n流年自信一弹指，末路谁怜三折肱。\n若见金昆问消息，为言霜鬓已鬅鬙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与金陵傅漕余预乡荐时傅兄持文衡 其一","author":"杨冠卿","text":"著作承明近玉堂，云何持节尚为郎。\n运储巧思蜀诸葛，揽辔澄清汉范滂。\n自昔谋猷资启沃，于今军国欠平章。\n商岩事业公须继，好趁春风朝未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与鄂州都统张提刑 其一","author":"杨冠卿","text":"五云楼阁武昌宫，曾挫曹瞒百万雄。\n今古兴亡付流水，江山弹压赖元戎。\n折冲尊俎笑谈里，极目关河指顾中。\n准拟明年会京洛，为君沽酒醉春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与鄂州都统张提刑 其三","author":"杨冠卿","text":"江湖畴昔受恩深，岁晚漂流伤客心。\n雨楫风帆倦行役，雪车冰柱少知音。\n价高肯羡连城璧，才谫难希谀墓金。\n但得扁舟从此去，成亏宁复问昭琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与鄂州都统张提刑 其二","author":"杨冠卿","text":"貔虎云屯细柳营，旌旗号令转精明。\n人言郤縠诗书帅，自有孙卿仁义兵。\n关塞金汤今奠枕，江淮草木旧知名。\n家声凛凛汉人杰，看取筹帷功业成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为谷隐和虞参议韵","author":"杨冠卿","text":"诛茅祗合老僧龛，一笑欣陪麈尾谈。\n天末冥鸿方避弋，辽东白豕忍怀惭。\n折腰我已宦情薄，嚼蜡谁言世味甘。\n万事转头俱梦幻，试将此语静中参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬午杂诗 其二","author":"杨冠卿","text":"寒甚王亲驾，春归虏请和。\n北军方拥众，小戍或投戈。\n形势中朝壮，衰离伪境多。\n燕云可中裂，岂限白沟河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬午杂诗 其三","author":"杨冠卿","text":"不逆凶渠诈，当须报使回。\n君恩固宽大，虏意每嫌猜。\n义举初难废，兵端莫浪开。\n要知情伪审，往事验方来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬午杂诗 其五","author":"杨冠卿","text":"已分依人老，犹期振袂还。\n有愁供白发，无力买青山。\n北驾方传跸，西师已度关。\n孤臣忧国泪，东首落馀潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬午杂诗 其四","author":"杨冠卿","text":"关内攻城战，淮东却敌兵。\n败亡初妄作，狼狈坐虚名。\n贼势虽亡命，君心实好生。\n不知他日事，谁筑受降城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬午杂诗 其一","author":"杨冠卿","text":"黄屋非尧意，讴歌有启归。\n德参羲昊古，事与汉唐非。\n喜气传千嶂，皇风浃九围。\n胡亡固无日，智勇旧沈机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王鸥盟别去久之有诗继韵","author":"杨冠卿","text":"急桨冲烟去，奚奴唤不应。\n清吟继囊锦，妙句琢壶冰。\n天远暮云碧，江寒秋练澄。\n怀人心欲折，愁坐对青灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代别张宪 其二","author":"杨冠卿","text":"老去安为客，春来不著家。\n江湖遂良觌，身世入长嗟。\n处死宁无地，谋生信有涯。\n分携感时节，杨柳又藏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代别张宪 其一","author":"杨冠卿","text":"泽国春强半，馀寒燕子飞。\n绝知悬榻久，故作买舟归。\n岁月空荒老，行藏有是非。\n功名游戏尔，此意尚依稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代秦干上刑部张尚书 其一","author":"杨冠卿","text":"畴昔持衡冰鉴清，议刑今去刻为明。\n坐令几阁文书静，驯致斋居狱讼平。\n疏阔汉朝新禁网，风流廷尉旧家声。\n哀穷悼屈心如砥，应笑张汤有重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代秦干上刑部张尚书 其二","author":"杨冠卿","text":"平生报国剑铓寒，万里漂流困一箪。\n贫剧方思毛义檄，归来却戴楚囚冠。\n解骖旧事无人继，恸哭穷涂祗自叹。\n倚伏循环知有待，春回寒谷在毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自淮右读楚辞有感","author":"杨冠卿","text":"忆昔淮山战骨高，行人持节过临洮。\n匣中剑气徒干斗，袖里纶钩莫钓鳌。\n世事从来两蜗角，男儿不遇一鸿毛。\n功名槐国吾深省，痛饮何妨读楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夹江 其一","author":"杨冠卿","text":"雨洗山容静，江流塞水通。\n征涂万烟树，行色一秋蓬。\n黯澹平郊雾，清徐邃谷风。\n直须歌缓缓，莫作去匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夹江 其二","author":"杨冠卿","text":"麦浪浮浓绿，山眉晕远青。\n光风来婉娩，客意独伶俜。\n回雁鸣何许，轻鸥下远汀。\n人家总幽隐，烟雨竹门扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王宣干秋怀","author":"杨冠卿","text":"囊锥脱颖久峥嵘，剑气干霄恨莫平。\n江左方思见王导，儿曹谁敢吏渊明。\n悲秋欲赋情难极，忧国忘言酒细倾。\n高卧东山岁将晚，何如一起为苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观诸园接花果","author":"杨冠卿","text":"花木聊观化，芳菲触处同。\n大都知岁晚，各自占春风。\n巧著移根力，阴争造物功。\n化钧均播埴，此理杳冥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别襄阳帅","author":"杨冠卿","text":"淮海棠阴已著行，却移小队入襄阳。\n江山尚带戎马气，斋閤遽闻编简香。\n自昔声名满梁楚，向来为政压龚黄。\n风流高出山翁上，不用擎鞭问葛彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"杨冠卿","text":"人事悲欢里，交情冷暖中。\n山林催晚计，颜面久秋风。\n有传记耆旧，无书问子公。\n反关违世久，幽事亦匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"杨冠卿","text":"欢悰凭浅酌，衰相怯单衣。\n诗向贫中好，春从雨际归。\n气寒忧麦瘦，桑湿恐蚕饥。\n豫学田园计，他时恐愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其三","author":"杨冠卿","text":"未办因人出，时歌不我过。\n墨泓云脚乱，药鼎雨声多。\n三篾阅浮世，把茆营懒窠。\n肯将犹在舌，容易说干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江道中 其一","author":"杨冠卿","text":"野色苍烟阔，篷笼宿雨开。\n湖光与天接，林彩觉春回。\n心事归双鬓，年华付一杯。\n松江元赴海，流驶更须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江道中 其二","author":"杨冠卿","text":"坏郭郊丘里，长桥烟浪间。\n幽花经雨润，独鸟受风还。\n春水围丛薄，晴云吐乱山。\n莫将吴越恨，添入二毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谷隐之东芍药酴醾涉夏尚有存者箨龙头角且森列于前次前韵呈九江赵使君","author":"杨冠卿","text":"衣钵相传书一龛，晴窗时许听名谈。\n诗成与客探囊取，句好令人下笔惭。\n别墅经春花未老，芳畦过雨荠尤甘。\n明朝更欲从公去，玉版堂头作小参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和京尚书上元日同禁从游凤山韵","author":"杨冠卿","text":"苔封石磴绕层栏，栏外行厨荐玉盘。\n座揖湖山诗兴远，气吞云海酒杯宽。\n篮舆竟日有馀乐，莲市只今无此欢。\n我愧么微难接武，飞笺亦欲寄青翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"始觉","author":"杨冠卿","text":"始觉躬耕晚，从谁话此情。\n但能安食息，敢复计声名。\n留滞烦书信，驱驰愧友生。\n有怀愁不尽，归鸟暮云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷岁如番禺与庆传十六兄遇上饶后五年胥会于霅时太学增置生试竟不遂志将别去理朱方棹因咏昔人风雨对床之语慨然有感作是诗","author":"杨冠卿","text":"囊空未办买山钱，壮志随人祗自怜。\n千里乡关愁梦里，几年踪迹瘴江边。\n回溪重困南抟翼，异县还寻东去船。\n何日苍崖结茅屋，与君风雨对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用前韵且约携琴寻花下之盟","author":"杨冠卿","text":"吟笺写就讯难通，人在千岩紫翠中。\n谈笑尊罍有馀乐，交游气槩压群公。\n忘年许缔金兰好，佳处何妨杖履同。\n我欲携琴坐花底，乞君妙曲奏松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庭草","author":"杨冠卿","text":"庭草凄馀碧，江风吹早寒。\n带围愁里减，诗律病中宽。\n隐几闲留客，迎门懒不冠。\n萧然有真处，未易俗人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸丑生朝舟行有感","author":"杨冠卿","text":"悬弧初度日，鞠育念劬劳。\n未了诗书债，见轻儿女曹。\n争知两蜗角，等是一鸿毛。\n所贵尽忠孝，结交英与豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸卯春杂用古语继吴监簿水月即事","author":"杨冠卿","text":"霜日炫晴昼，意行春色随。\n平林花淡淡，荒墅草离离。\n竹径通幽处，山云薄暮时。\n壶觞情未极，飞鞚返青丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日怀松竹旧友 其一","author":"杨冠卿","text":"松竹隐君子，别来安稳不。\n音书迟寄雁，风雨又惊秋。\n金井叶黄落，青灯人白头。\n客怀难著语，谁共赋牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日怀松竹旧友 其二","author":"杨冠卿","text":"乌免不停轨，蒹葭鬓已苍。\n囊空携古锦，赋未奏长杨。\n林下松风曲，炉边柏子香。\n朝昏作禅供，荣辱已俱忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀十首微云淡河汉疏雨滴梧桐为韵 其一","author":"杨冠卿","text":"寒蝉初停号，客燕催将归。\n吾亦客一世，去此复焉依。\n敛衽听物变，著书明化机。\n深参漆园吏，渠语甚精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"适安旅次 其二","author":"杨冠卿","text":"槛蒲行碧瘦，林叶得红深。\n客子倦长夜，居人催暮砧。\n风梢窗纸急，月转药栏阴。\n高枕已无睡，寒螀休苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"适安旅次 其一","author":"杨冠卿","text":"山郭萧条晚，秋堂窈窕深。\n轻寒笼暮霭，横吹度疏砧。\n丛竹深藏翠，孤云带晚阴。\n淹留有幽趣，不碍短长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦游","author":"杨冠卿","text":"归去陶彭泽，重来丁令威。\n逢场真戏剧，阅世识危机。\n蛮雨沾乌帽，京尘黯素衣。\n回头今自笑，三十六年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶南仲","author":"杨冠卿","text":"畴昔丈人行，典型诗礼家。\n刚方排武叔，词赋敌张华。\n造膝陈经济，凝旒屡叹嘉。\n他年想遗烈，拊髀谅兴嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓思","author":"杨冠卿","text":"山鸟春犹咽，城乌晓乱啼。\n危谯初罢角，落月已催鸡。\n地迥来何事，家遥梦到迷。\n片怀如许恶，深觉负瓜畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后暑退","author":"杨冠卿","text":"宽作迟留计，难期岁月功。\n方惊鼠辈舞，未觉马群空。\n度暑苏病骨，涉秋悲候虫。\n长江二千里，只欠一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"继朱叔谦所寄韵","author":"杨冠卿","text":"湖海三十载，穷观未见书。\n文章耻沿袭，体制薄浮虚。\n老去情怀恶，生平习气除。\n交亲应笑我，术业废三馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"继诗社诸友韵","author":"杨冠卿","text":"休将龟筴问穷通，往事邯郸午枕中。\n南郭吹竽羞滥食，北山运畚笑愚公。\n酒边赖有赓酬在，客里还欣臭味同。\n得句不妨频寄我，从今莫效马牛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书","author":"杨冠卿","text":"忧世终何补，忠怀怅不平。\n收回长太息，翻作短歌行。\n是事且复置，今人谁可盟。\n湘中千树橘，墨墨了馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读杜工部集","author":"杨冠卿","text":"平生忠义不忘君，末路升沈付九原。\n千古神交真未泯，一时人事可重论。\n摩挲醉眼朝廷在，消息他乡弟妹存。\n独阅遗编堪堕泪，秋窗灯火雨昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿前岗铺","author":"杨冠卿","text":"老去心犹壮，天边岁欲除。\n喜行新过路，如读未看书。\n溪水萦回净，人家远近居。\n梅花正愁绝，薄暮雨疏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮楚春晚病中","author":"杨冠卿","text":"绝塞驱驰有底忙，病馀归思绕江乡。\n雁飞不到楚天远，蝶梦可堪春昼长。\n满地香红初过雨，一帘风絮正斜阳。\n愁边赖有新诗在，强劈吟笺付锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后","author":"杨冠卿","text":"野日茅茨短，荒村霰雪馀。\n溪流山足裂，谷迥鸟声虚。\n矫首怀新隐，归窗有旧书。\n残年甘饱饭，何必事名誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麻姑之东涉千堆垄至射亭宿黄氏新馆","author":"杨冠卿","text":"宴宇新成苦未嘉，忽膺朝委易军牙。\n张侯暂喜留欢客，开槛凭谁种好花。\n北沼不难平钓岸，西峰犹欠入窗纱。\n后贤政敏多馀暇，高会何妨月影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"港口","author":"杨冠卿","text":"野寺云山迥，人家烟火稀。\n水腥渔市近，帆落晚风微。\n拂树昏鸦去，迎船白鸟飞。\n吾生乐江海，犹恐与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游交广用帐干赵德纵韵","author":"杨冠卿","text":"家声久矣愧长杨，浪说男儿志四方。\n鼎鼎百年半流落，悠悠万里益凄凉。\n羁怀岭表芙蓉幕，归梦江南云水乡。\n欲访匡庐近消息，试凭征雁到浔阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴久不作客问其故戏为说偈","author":"杨冠卿","text":"昭琴不鼓任亏成，泽畔行吟且独醒。\n自信荣枯本同辙，谁云得丧有殊形。\n古今几见桑田变，日月常循昼夜经。\n去去来来祇如此，风前别调不须听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]