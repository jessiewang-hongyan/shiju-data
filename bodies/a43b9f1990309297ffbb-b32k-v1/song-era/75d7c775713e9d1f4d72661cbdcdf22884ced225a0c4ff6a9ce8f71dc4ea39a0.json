5294295f79689","path":"宋_2.csv","pointer":32270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题西湖并送净慈显老三绝 其二","author":"范成大","text":"膏肓泉石痼烟霞，半世游山不著家。\n老入蒲团三昧定，坐看穿膝长芦芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题祝郢州白雪楼","author":"范成大","text":"楚望风烟倚绣楹，使君静治有高情。\n袛应襦裤新翻曲，压倒当年寡和声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题郫县蘧仙观四楠","author":"范成大","text":"沉犀浦上旧仙踪，老木长春翠扫空。\n敢请丹光来万里，为扶云峤驾飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题鹿伯可见一堂 其一","author":"范成大","text":"梦觉春闱俱转蓬，仙凡今隔玉霄东。\n聊攀铁锁问何似，岂敢避堂邀盖公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"范成大","text":"排门帘幕夜香飘，灯火人声小市桥。\n满县月明春意好，旗亭吹笛近元宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步西园","author":"范成大","text":"料峭轻寒结晚阴，飞花院落怨春深。\n吹开红紫还吹落，一种东风两样心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚思","author":"范成大","text":"藓墙莎砌响幽虫，睡起翻书觉梦中。\n残暑一窗风不动，秋阳入竹碎青红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其十四","author":"范成大","text":"湖莲旧荡藕新翻，小小荷钱没涨痕。\n斟酌梅天风浪紧，更从外水种芦根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其十五","author":"范成大","text":"蝴蝶双双入菜花，日长无客到田家。\n鸡飞过篱犬吠窦，知有行商来买茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其十六","author":"范成大","text":"湔裙水满绿蘋洲，上巳微寒懒出游。\n薄暮蛙声连晓闹，今年田稻十分秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 晚春十二绝 其十三","author":"范成大","text":"紫青莼菜卷荷香，玉雪芹芽拔薤长。\n自撷溪毛充晚供，短篷风雨宿横塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其四十八","author":"范成大","text":"新霜彻晓报秋深，染尽青林作缬林。\n惟有橘园风景异，碧丛丛里万黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其四十七","author":"范成大","text":"细捣枨齑买鲙鱼，西风吹上四腮鲈。\n雪松酥腻千丝缕，除却松江到处无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚潮","author":"范成大","text":"东风吹雨晚潮生，叠鼓催船镜里行。\n底事今年春涨小，去年曾与画桥平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望乡台","author":"范成大","text":"千山已尽一峰孤，立马行人莫疾驱。\n从此蜀川平似掌，更无高处望东吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望都","author":"范成大","text":"荒寺疏钟解客鞍，由山东畔白烟寒。\n望都风土连唐县，翁媪排门带瘿看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵昌四季花图 其四 梅花山茶","author":"范成大","text":"月淡玉逾瘦，雪深红欲燃。\n同时不同调，聊用慰衰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雨五绝 其二","author":"范成大","text":"乙酉甲申雷雨惊，乘除却贺芒种晴。\n插秧先插蚤籼稻，少忍数旬蒸米成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中作","author":"范成大","text":"漠漠人间一气平，虚无宫殿锁飞琼。\n碧云万里海光动，何处书来金鹤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欲雪","author":"范成大","text":"乌鸦撩乱舞黄云，楼上飞花已唾人。\n说与江梅须早计，冯夷无赖欲争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深溪铺中二绝追路寄呈元将仲显二使君 其一","author":"范成大","text":"贺州归去柳州还，分路千山与万山。\n把酒故人都别尽，今朝真个出阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深溪铺中二绝追路寄呈元将仲显二使君 其二","author":"范成大","text":"祗有南风捲路尘，断无南客送车轮。\n故人合在潇湘见，却向潇湘别故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳安","author":"范成大","text":"篙师叫怒破涛泷，水石如钟自击撞。\n欲识人间奇险处，但从歙浦过桐江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙五年四月二日直宿玉堂怀旧二绝句 其二","author":"范成大","text":"雪山刁斗不停挝，夜把军书敢顾家。\n珍重玉堂今夜梦，静闻宫漏隔宫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙五年四月二日直宿玉堂怀旧二绝句 其一","author":"范成大","text":"桂海冰天老岁华，直庐重上玉皇家。\n当年曾识青青鬓，惟有东墙一架花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清远店","author":"范成大","text":"女僮流汗逐毡軿，云在淮乡有父兄。\n屠婢杀奴官不问，大书黥面罚犹轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清音堂与赵德庄太常小饮在馀干琵琶洲傍洲以形似得名","author":"范成大","text":"曲浦弯环绕县青，一杯閒客两飘零。\n琵琶不语苍烟暮，山水清音著意听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清湘驿送王柳州南归二绝 其一","author":"范成大","text":"南归北去路茫茫，不是行人也断肠。\n可惜湘江春夜月，落花时节照离觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]