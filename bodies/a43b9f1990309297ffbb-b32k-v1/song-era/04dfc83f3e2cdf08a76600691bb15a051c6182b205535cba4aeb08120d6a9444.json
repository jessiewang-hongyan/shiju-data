[{"title":"送茶头并化士 其一","author":"释慧空","text":"四海建溪茶，古今人所重。\n惟有禅家流，端的得受用。\n风穴出送行，香严用原梦。\n古佛老赵州，到与不到共。\n今者披秀翁，又作如是供。\n阶也分化权，空生与之颂。\n但得出处真，一用一切用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其二","author":"释慧空","text":"物以甘柔趋所嗜，茶独森严正其味。\n老僧得之其梦圆，张喉引喙欲谈禅。\n小僧得之忘百虑，挑囊直入茶山去。\n僧无老少俱喜茶，问讯武夷仙子家。\n待我明年春睡醒，借尔郝源作茶鼎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其三","author":"释慧空","text":"三昧酒，吃便醉，坐禅时，只瞌睡。\n轻轻未可悚动渠，送上茶山渠自会。\n见张三，逢李四，把得便行果灵利。\n一枝春信有来由，六出飞花不相类。\n到秀峰，真得地，四方老衲如云至。\n跨著三门酌一杯，换却眼睛拈却鼻。\n铁面老禅今健否，家居道旧想安然。\n饭香苦忆伊蒲馔，井冽还思甘露泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其四","author":"释慧空","text":"真斗九汤云起雪，贡馀径寸玉无瑕。\n春寒不念山中事，岁岁封题记我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其五","author":"释慧空","text":"瓦盆雷动千山晓，横岭香传两袖风。\n添得老禅精彩好，江西一吸兔瓯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其六","author":"释慧空","text":"今我老无崖险句，送人行不折杨花。\n前头有问又须道，黄面禅和吃酽茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其七","author":"释慧空","text":"衲僧手眼亲，把得是日用。\n左乞建溪茶，右化连江洪。\n快拈两条蛇，并作一手弄。\n行看腊雪消，便是春雷动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其八","author":"释慧空","text":"披秀三句二偈，与宠为茶佛事。\n法味法乐法财，资神资生资惠。\n使于施受之间，而无虚得虚弃。\n我亦未證其中，乃就其中出气。\n截却娇梵舌根，捩转衲僧巴鼻。\n来者满与一瓯，看伊东倒西醉。\n既醉各各起来，门外晓山横翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其九","author":"释慧空","text":"当阳一印妙无文，惭愧东山有子孙。\n是圣是凡齐印定，不妨持钵扣人门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其十","author":"释慧空","text":"至辱莫若乞，至乐在无求。\n苟得无求旨，虽乞吾何羞。\n道人白云居，心与白云俦。\n明朝出山去，迫夏归来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其十一","author":"释慧空","text":"尽大地是吾檀越，梅花杏花先后发。\n绿杨阴下问长安，门门有路皆通达。\n祖师禅，活鱍鱍，长粳米饭抄满钵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其十二","author":"释慧空","text":"佛子平居观世间，皆谓圆融无杂坏。\n使其应入如所观，与夺交驰还窒阂。\n我尝行乞今示汝，要得圆成先击碎。\n一毛不立等刹尘，八面俱来无向背。\n如探有无于怀中，如问可不于自己。\n有无可不非外来，是中欲谁为愠喜。\n佛子当持此法门，入此界中而示现。\n丹山红炉为汝开，岁晚归来金百鍊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其十三","author":"释慧空","text":"道人随处展家风，酒肆鱼行有路通。\n但得堂中盐米办，吉山佛法自兴隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其十四","author":"释慧空","text":"佛与众生旧有缘，入廛一句更为宣。\n眼前不用生贪恋，三界无安若火煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶头并化士 其十五","author":"释慧空","text":"达人不见尘中隘，为有而今这一解。\n长柄笊篱入手来，倒用横拈风雨快。\n南街打倒北街头，东园乞得西园菜。\n阿呵呵，也奇怪，他家自有通人爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送印侍者广化开山歌","author":"释慧空","text":"君不见东山老人僧中月，法惟直指初无说。\n有众如云来不休，有饭如山供不彻。\n印道人，善时节，不持应器循门乞。\n只募同心一万人，请将大地为檀越。\n或宽平，或曲折，与我福田衣不别。\n二彼虽无施受心，万斛千仓从此出。\n若见闻，宜猛烈。\n莫守从前悭吝穴。\n些儿信种落其中，遍界灵苗齐秀发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送光侍者充街坊","author":"释慧空","text":"养子不著顺摩捋，喝要耳聋棒要杀。\n摩捋得成用不行，棒杀教伊应手活。\n东山妙得养子方，所以用时俱爪抹。\n我是谢郎先早归，打就铁船相触拨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送愿兄化永嘉 其一","author":"释慧空","text":"秦溪在处皆招提，我此东山为最上。\n非谓丰庖丽堂宇，于中坐此真导师。\n如火周空拟则焚，如鼓涂毒闻则死。\n痴禅眇劣渠得知，但以情疑实相法。\n我观此会比丘众，一一从其法化生。\n混而不杂如千光，用而无畏如师子。\n汝宜于此办肯心，此心一办一切办。\n善哉遍界尘劳门，悉是东山大智海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送愿兄化永嘉 其二","author":"释慧空","text":"脩途初发步，步步要相似。\n后步才到时，岂离最初故。\n乃翁众导师，况是为之子。\n欲取步骤同，努力无忽此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广州化士 其一","author":"释慧空","text":"禅参闽岭雪峰寺，饭在南方檀越家。\n岁岁僧归饭满钵，普熏何独是毗耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广州化士 其二","author":"释慧空","text":"雪岭留香众，南方上善人。\n先佛肃恭法，佛子今此行。\n古佛有仪式，衲僧不放过。\n一座雪峰山，千门万户到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次直指老人韵送璠化士兼呈丘中大 其一","author":"释慧空","text":"宝所龙蛇争守护，自非其人手难措。\n若于个里到一回，堪与东山称化士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次直指老人韵送璠化士兼呈丘中大 其二","author":"释慧空","text":"上方香饭远吹风，堕我云堂一钵空。\n要使人人无食想，却烦小小现神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次直指老人韵送璠化士兼呈丘中大 其三","author":"释慧空","text":"南庵居士今摩诘，久稔声光未扣门。\n忽睹曼殊说三偈，坐令身在对谈边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主造大目溪桥","author":"释慧空","text":"擘开太华手，生铁铸就汉。\n拈起白玉虹，跨著溪两岸。\n东西南北人，步步无间断。\n直造大歇堂，一生事成办。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与聚道者造白林桥 其一","author":"释慧空","text":"白林山中一句子，大溪为舌日夜说。\n路人扰扰如不闻，聚等诸人今始瞥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与聚道者造白林桥 其二","author":"释慧空","text":"横身溪上略相酬，不住中间彻两头。\n行人掉臂上头过，谁信如今有赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与珍道者造东山寺前石桥","author":"释慧空","text":"灌溪劈箭虽云急，截流过者脚不湿。\n东山一水人不惊，拟动脚时滩下立。\n如何咫尺东山门，在眼可望不可及。\n珍公老手但问渠，自有方便令人入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送圆上人归云居","author":"释慧空","text":"康庐诸峰欧阜殊，寺称天上众五湖。\n古来相传应真辈，多入此众潜安居。\n有为白癞聊戏剧，邻坐恶之思割席。\n一朝忽怪单位空，遗下疮痂渺无迹。\n东山若是与同时，捶折其胫宁容之。\n圆今病痛又相似，放过从教天下疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送正维那归华亭","author":"释慧空","text":"无丝线子拽不断，正要并州快剪刀。\n尔既有之还不用，山僧赢得笑呵呵。\n只将一笑赠君行，无限青山送又迎。\n到得华亭人不识，柳阴终日钓舟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与胨儿","author":"释慧空","text":"云水四方人，同居九十日。\n大光明藏中，各各不相识。\n月兔晓东生，日乌夜西出。\n善现问瞿昙，般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与朋宁二士","author":"释慧空","text":"东山东游形吊影，闭门作夏山房冷。\n两士能来共寂寥，人谓同风吾未省。\n窗间一笑岩穴惊，窗外数峰清昼永。\n不知祖道今安危，自拨寒灰出烧饼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送妙侍者游方","author":"释慧空","text":"秋雨秋风如解事，忽送新凉到庭户。\n道人明日先我行，少立斯须听吾语。\n龙蛇共路古犹今，魔佛同源水非乳。\n满世谁能辨正邪，入门且可分宾主。\n句中有眼汝验渠，棒下无私渠验汝。\n好手虽然不犯锋，横身却在锋铓里。\n象王蹴蹋驴群空，师子嚬呻狐类死。\n道人一等是精灵，大显无功合如此。\n愧当十偈非赏音，喜见独行无伴侣。\n相逢休问来何从，佛寿之孙佛心子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧游天台 其一","author":"释慧空","text":"天台五百尊者，吃尽秀峰酸豏。\n更引秀峰禅和，尽向桥头脱赚。\n初开盏里茶花，次散空中灯焰。\n分明不是好心，到者以何为验。\n若是具眼高流，一见不劳再勘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧游天台 其二","author":"释慧空","text":"天台五百尊者，受尽秀峰供养。\n更引秀峰禅和，费他草鞋拄杖。\n初说石梁横空，次誇圣灯明亮。\n元来不是好心，只要递相欺诳。\n烦公勘破归来，领过不消一状。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵超然 其一","author":"释慧空","text":"钝根阿师初乐小，同一法中人怪笑。\n白云堆里强安身，掣电机前争失照。\n业风吹下到天亭，无著力处尽力争。\n一朝力尽却自笑，放下蛇头摆手行。\n超然居士今庞老，此日相逢犹草草。\n不知船子下扬州，更指梅花开恰好。\n开恰好，惭愧东君解倾倒。\n一枝倒把赠公行，拟行把住道道道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和赵超然 其二","author":"释慧空","text":"山僧当年活计小，冷地不知人怪笑。\n白云堆里强安身，石火光中多失照。\n业风吹不到天亭，无著力处尽力争。\n千岁灵龟退灵壳，而今步步火中行。\n超然居士今庞老，一笑相逢重拨草。\n全机透出上头关，平屐家风且安好。\n且安好，走过市桥曾挞倒。\n回头筑著老丹霞，咄这冤家何不道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜温首座至 其一","author":"释慧空","text":"我昔识此老，谓之定上座。\n是时朋辈中，个个道与么。\n一别二十年，相逢皆老大。\n把手两风颠，傍观尽惊倒。\n翻思往者言，幸尔欺得过。\n若是在今日，管取遭一唾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜温首座至 其二","author":"释慧空","text":"两翁相对好机缘，点在人人本命年。\n方外笑谭无忌讳，梦中歧路说迍邅。\n自从打破秦时镜，总是花开腊月莲。\n或问两翁年几许，寻常儿唤首罗天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与撮药曹道","author":"释慧空","text":"当阳拈出大家看，来处分明去处端。\n总是诸人自遮护，先生豪发不相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与开道者","author":"释慧空","text":"大悲院里罗斋出，十字街头觅水程。\n肩上袈裟无一截，草鞋落地作金声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与明州茂上人","author":"释慧空","text":"十五已前不得去，寒木一寻生铁铸。\n十五已后不得住，针筒鼻孔俱分付。\n正当十五天然别，谁管春寒与秋热。\n拈起笠子为焰光，遍在湖南并两浙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送川全之云门","author":"释慧空","text":"入岭踏著披秀，恰似倒食甘蔗。\n前头节节不同，未可只么掉下。\n雪峰玄沙黄檗，鼓山东禅西禅。\n是处波腾岳立，随方五位三玄。\n一一从头咬嚼，要令首尾完全。\n云门尽头一节，苦硬如咬生铁。\n一咬咬著舌头，洛阳桥成两截。\n普贤隐身无地，文殊倒退三千。\n有问蔗作何味，附子出在西川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送德上人归故山","author":"释慧空","text":"泯泯众人中，不与一人共。\n阒尔居闲房，俨若临千众。\n是谓有恒人，一心无二用。\n东山早尝学，身行而口诵。\n久之如善射，纵横无不中。\n魔外作姻亲，蛇虎为伯仲。\n离歌无可言，出此以为送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送珍兄之黄檗","author":"释慧空","text":"老倒空生，言无旨的。\n索瓶指泥，觅偈与墼。\n俊流把得，劈面便掷。\n如其不然，分付黄檗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和披秀韵与般阳明上人","author":"释慧空","text":"衲僧一口剑，莫问何年铸。\n既有杀人威，亦有活人句。\n说梦老瞿昙，至今未曾悟。\n为之子孙者，果以何为据。\n聚头化城中，自谓得安住。\n抛却金刚王，记持死汉语。\n腊月三十日，一字不堪睹。\n若惊吾剑在，便解子与午。\n忽挂忽为轮，可见不可取。\n提出长桥蛟，却是南山虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与璨上人","author":"释慧空","text":"参寻惟上士，骏逸谅无俦。\n去住一言下，东西拄杖头。\n主宾能互换，针芥更相投。\n忽竖顶门眼，西江水倒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与勇上人","author":"释慧空","text":"虎丘之虎老且死，道人勇者乃其子。\n以其有子父不亡，偈地风声犹在耳。\n东山于其父子间，为之道旧为乡里。\n要尔全机起乃翁，据虎头而收虎尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与眉州远上人","author":"释慧空","text":"左握峨眉右五台，新罗吃粥七闽斋。\n朝来不省何方去，背却三门著草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与通上人","author":"释慧空","text":"行脚莫归乡，枝筇一条铁。\n庵居不说禅，直以身为舌。\n莫归刚要归，不说又著说。\n张翁把研槌，锅中钓出鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其一","author":"释慧空","text":"推出睦州担版汉，是圣是凡齐赞叹。\n十方世界绝冤亲，不用藏身更吞炭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其二","author":"释慧空","text":"赵州狗子无佛性，咬人更不存性命。\n大悲千手不能遮，跋陀那龙侧耳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其三","author":"释慧空","text":"有问西来祖意，但与衲僧巴鼻。\n香林坐久成劳，东山睡多损气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其四","author":"释慧空","text":"一个端坐吃不足，二个同槃则有馀。\n缺齿老胡曾未会，洞传今古在吾徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其五","author":"释慧空","text":"普化传真，七错八错。\n后人不明，随邪逐恶。\n若是真鍮，黄金不博。\n今人长爱李将军，一箭离弦双雕落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广南僧","author":"释慧空","text":"神光三拜，菩提达磨。\n老安平生，一破灶堕。\n东山病汉，石个什么。\n信笔写出，不勘自破。\n丹山雏凤九苞文，海坛犬子似驴大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送白上人还丰岩","author":"释慧空","text":"我初不识丹霞师，迩来偶识丹霞子。\n却因其子识其师，云水相悬渺千里。\n空生不往丰岩中，丹霞不到西庵里。\n如何说个相识来，理契即邻休寐语。\n风前把出赠行人，虚空稽首须弥舞。\n千载冰岩一日春，悬水落崖声似雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送定勋二上人","author":"释慧空","text":"定禅快为师子吼，勋禅瑩净玉无垢。\n两禅同居渊不分，一日用之左右手。\n超方独脱王老师，向何壁立今何慈。\n杓柄短长锅大小，揭而示之无可疑。\n末后更有一句子，未省两禅著何语。\n东山有句不敢书，恐著替渠出山去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和慈觉炊字韵并送兰蕙 其一","author":"释慧空","text":"竹屋孤烟未断炊，鸥盟岁晚不应违。\n五湖云水座中客，一沼芰荷身上衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和慈觉炊字韵并送兰蕙 其二","author":"释慧空","text":"蕙弟兰兄本一山，莫如白下望长干。\n人间草木非其对，留与芝翁到老看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招南泉","author":"释慧空","text":"一饭之微亦报缘，蒲团纸帐在吾年。\n道惟简易人惟俭，遁乃嘉肥进乃邅。\n问讯江头白石佛，愿回足下紫金莲。\n当年手种庭前柏，岁晚青青欲入天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"素上人为普贤办供过溪上需偈予曰与普贤有素不可无词乃作五偈遗之归山呈似道人一笑 其一","author":"释慧空","text":"普贤愿海君能续，火聚刀山勿厌登。\n更入人间烦恼海，自然触处妙相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"素上人为普贤办供过溪上需偈予曰与普贤有素不可无词乃作五偈遗之归山呈似道人一笑 其二","author":"释慧空","text":"素公初住峨眉寺，遣化人间要话行。\n借问话头何自得，大都来处要分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]