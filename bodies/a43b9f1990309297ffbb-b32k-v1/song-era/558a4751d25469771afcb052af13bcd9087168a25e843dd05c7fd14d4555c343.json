[{"title":"醉起仙","author":"徐积","text":"佩环声动出金华，凤引鸾随入绛霞。\n行到瑶台云路狭，侧身趋避玉妃车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廉仙","author":"徐积","text":"人閒日月分庭过，天外星河入户流。\n是物化金无所用，满田种玉不曾收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寡欲仙","author":"徐积","text":"膝上横琴鹤在傍，白云衣共白云裳。\n夜深閒卧南窗月，更有清风共一床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"地仙","author":"徐积","text":"瑶台紫府都归梦，碧洞红尘总是家。\n蓬岛有时来问信，桃源无处不开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉妃","author":"徐积","text":"琳琅宫殿本无尘，犹跨青鸾踏紫云。\n怪得晓来天色淡，海霞都在玉妃裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻姑 其一","author":"徐积","text":"折尽青林多少花，麻姑却在蔡经家。\n瑶台好醉无人醉，凤怨鸾栖空暮霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻姑 其二","author":"徐积","text":"不道风尘良苦辛，却停仙仗醉红尘。\n青鸾一去无消息，只被麻姑误杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒仙","author":"徐积","text":"先生坐时云满裳，先生卧时云满床。\n白云终日自来去，若比先生云尚忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棋仙","author":"徐积","text":"壶中白日何曾夜，洞里桃花别是春。\n一局閒棋犹未了，坐中老却采樵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宴仙 其一","author":"徐积","text":"阊阖宫中夜宴开，手挥明月坐瑶台。\n不教偷药姮娥到，却放投壶玉女来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宴仙 其二","author":"徐积","text":"明月宫中夜宴多，坐中齐唱白云歌。\n瑶环玉佩三千女，不著人閒俗绮罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"困仙","author":"徐积","text":"洞中一觉春风梦，落尽桃源万树花。\n灶上丹砂寻不见，骑鸾误入阿谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浴仙","author":"徐积","text":"玉佩珠襦自辟尘，瑶池浴罢卧红云。\n指挥莫放香波去，留与龙儿并凤群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒仙 其一","author":"徐积","text":"玉谱天书金版字，桂花浓酿碧霞浆。\n无人敢与为诗敌，有客时来觅酒尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒仙 其二","author":"徐积","text":"閒云淡月为诗态，春日春风是酒容。\n玉女争求新乐府，金童时献碧瑶钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平仙","author":"徐积","text":"谁知我是太平仙，歌罢浮云笑暮烟。\n更倚玉楼吟乐府，断虹消尽月明天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别仙","author":"徐积","text":"平日忠言薄万金，此时何惜赠君行。\n好名不是真人事，莫向人閒留姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪仙","author":"徐积","text":"九重天路忽难通，谁与传书寄阆风。\n鹤驭三千无处觅，银潢万丈一时空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望仙","author":"徐积","text":"好云消尽鹤空来，一去麻姑更不回。\n紫府路从何处去，碧桃花向梦中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无妄仙","author":"徐积","text":"清风窗外云初去，明月池中鹤自还。\n春色一帘閒睡过，瑶花落尽不抽关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"希夷仙 其一","author":"徐积","text":"白云夫子号希夷，碧玉窗中下绛帷。\n皓首勒成书万帙，病鸾偷见鹤偷知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"希夷仙 其二","author":"徐积","text":"红尘旧学今虽废，紫府新书近已齐。\n三十六仙俱不见，玉函金锁印龙泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悟仙","author":"徐积","text":"昔日闻人说上清，如今高步太元庭。\n有时却忆红尘事，恰似梦回并酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恶伪仙","author":"徐积","text":"本希上圣忘言学，傍采南华寓意书。\n去伪即真虽有道，未知人意自何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑仙","author":"徐积","text":"此剑曾将赤霄倚，云雷欲战秋风起。\n携下赤霄磨玉山，玉山色变龙蛇寒。\n霜飞浪活河汉精，星辰日月分光明。\n天生神物不可犯，曾向人閒诛不平。\n玉龙不死常在腰，一抹血腥犹未消。\n莫教望见延平水，待与天地除凶妖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙 其一","author":"徐积","text":"曾乘秋浪泛银河，拨尽閒云恣浩歌。\n明月一环来拂面，玉龙十万总随波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙 其二","author":"徐积","text":"天上瑶池为别馆，海閒金阙是离宫。\n徐行按尽烟波国，高步却来云汉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙 其三","author":"徐积","text":"昨夜曾游洛女家，自知此处胜烟霞。\n回鸾更按湘妃曲，醉踏烟波弄月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙 其四","author":"徐积","text":"龙驭曾游绛水霞，回来却坐赤鲸车。\n夜深正解双珠佩，莫点犀灯照我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无累仙","author":"徐积","text":"尘世纷纷总是空，花开花落几时穷。\n有人若问烟霞事，我是逍遥无累翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"笑仙","author":"徐积","text":"天上人閒自不同，莫将浇俗比真风。\n真风大抵无今古，万事都来一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忧仙","author":"徐积","text":"我是真人何所忧，所忧世俗好多求。\n相谋相诈何时了，一笑一啼无日休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闵仙","author":"徐积","text":"祸福之来本自求，世人闻语不回头。\n但知自快身前欲，不道永为身后羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又水仙 其一","author":"徐积","text":"紫金沙路明珠阙，浴罢龙儿洗明月。\n待来人世等麻姑，只被尘埃污罗袜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又水仙 其二","author":"徐积","text":"为买蟠桃海上花，明珠满载玉龙车。\n蓬山诸子须相问，笑指烟波是我家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又水仙 其三","author":"徐积","text":"我是江湖都一掬，海水虽深不濡足。\n待教平地产明珠，但恐世人更多欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又水仙 其四","author":"徐积","text":"伍子波涛空淼然，至今犹有不平言。\n屈原褊浅尤多忿，但恐有时来诉冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劳仙","author":"徐积","text":"朝采药，暮采药，踏尽閒云一双脚。\n出一山，入一山，先生如此何时閒。\n有时两脚不出户，不炼黄金即炼丹。\n先生手足已劳苦，一心欲把河沙数。\n却笑閒仙无所为，閒仙端坐亦相嗤。\n大都世事亦如此，相笑相非无尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宴仙","author":"徐积","text":"紫瑶楼上宴真人，脍是鲸鲵脯是麟。\n醉倒玉妃何处去，烟霞迎步鹤随身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨起仙","author":"徐积","text":"帐外双童持剑履，一榻红云睡初起。\n满面清风漱月华，瑶浆更挹明河水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"童仙","author":"徐积","text":"忆昔为儿跨竹梢，谁何传与太平谣。\n如今羽化已千载，绿鬓朱颜更不凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饱仙","author":"徐积","text":"谁道真人能辟谷，先生每食无馀肉。\n邻家便是忍饥仙，糊口之粮犹不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饥仙","author":"徐积","text":"粮虽不足气常充，真是根源久是功。\n真久不惟能养气，幽明亦可感而通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶仙","author":"徐积","text":"赐得龙田不种花，自携瑶水灌烟霞。\n谁将玉树双枝换，只得春前一寸芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狂仙","author":"徐积","text":"香枝洒面瑶池水，霞艳装衣阆苑花。\n一半是狂兼是醉，急教扶去卧烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迷路仙","author":"徐积","text":"当时采药因迷路，平上青云不用梯。\n却似人閒行路者，醉魂春梦至今迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卖药仙","author":"徐积","text":"蹄涔蚁垤何须较，芳草浮云事可知。\n曾向人閒闲卖药，尘埃满眼看儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无知仙","author":"徐积","text":"为向平时寻古风，幅巾芒履走尘中。\n俗人不识烟霞客，唤作无知卖药翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞仙 其一","author":"徐积","text":"不用骖鸾不御风，腾身拖袂便乘空。\n方从碧海游三岛，却驾烟霞上紫宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞仙 其二","author":"徐积","text":"十万里馀都一息，须知此道非人力。\n有时閒望玉山游，鸾凤满天追不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谪仙 其一","author":"徐积","text":"曾宴巫山十二峰，归来谪下广寒宫。\n如今已得瑶环赐，便揖浮丘骑玉虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谪仙 其二","author":"徐积","text":"自脱霓裳辞玉关，玉符金字谪人閒。\n人閒虽与烟霞隔，醉梦吟魂自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忘忧仙","author":"徐积","text":"鸟不曾喧兽不争，鸾歌凤舞碧瑶城。\n群童尽唱忘忧曲，也似人閒乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"力仙 其一","author":"徐积","text":"崆峒道人良多识，易以真为难以力。\n岂无群圣可相师，亦有一篇言道德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"力仙 其二","author":"徐积","text":"挟虎搏蛟良有力，扼断鲸咽批豹额。\n虎豹虽狞却易防，蝼蚁口中藏剑戟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"急仙","author":"徐积","text":"但把真声吹鼓箫，凤来凤去不须招。\n浮槎河上无徒涉，种玉田中莫揠苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慢仙","author":"徐积","text":"急仙烧炼日盈罐，慢仙十日未能半。\n一人卖药走不停，一人得金不肯换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又雪仙 其一","author":"徐积","text":"华盖车前龙步滑，紫微垣上凤巢寒。\n一时扫下尘泥去，却入汉家盛露盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又雪仙 其二","author":"徐积","text":"人閒多是苦寒饥，短褐疏衾正弊时。\n欲把霞衣都覆盖，却辞玉女宴瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求仙","author":"徐积","text":"神仙不知真有无，其术可图不可图。\n得之不得存乎命，躁不以命良可吁。\n愚夫忘欲弃所爱，父母无子妻无夫。\n本求长生不死术，夭厥所寿残厥躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉霞弟子","author":"徐积","text":"玉霞弟子非无学，金箓名仙亦有才。\n却作左慈筵上术，谁将酒脯尽携来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藐仙","author":"徐积","text":"藐哉小哉其奈何，牛蹄之水一泓多。\n若是胸中能自养，长源巨派倾洪河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奇仙","author":"徐积","text":"奇哉奇哉有此仙，胸中广大可容天。\n深莫测兮高可仰，沧浪之水太山颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不可知","author":"徐积","text":"歌谣才作彩衣童，策杖俄为白发翁。\n走遍红尘人莫问，先生意在不言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫回头","author":"徐积","text":"薄夫用意终归险，更有乡原事可羞。\n多少古人遗恨在，红尘歧路莫回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无奈何 其一","author":"徐积","text":"我曹意者非忘物，自是为仙无奈何。\n海水玩来如股掌，人心难处甚风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无奈何 其二","author":"徐积","text":"无奈何兮无奈何，失之哀兮得之歌。\n巧拙其閒不容寸，得失相去能几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝君","author":"徐积","text":"劝君莫折杨柳枝，枝无根本任风吹。\n劝君莫爱水中萍，萍随流水何时停。\n莫爱春风山上草，才到秋风便吹了。\n更有篱边红槿花，朝来锦绣暮泥洼。\n不似茅庵水上家，碧芦门径白汀沙。\n两眼仅分鸥与鸦，口无巧语心无邪。\n不但无邪兼寡欲，钓得一鱼心便足。\n渔衣便是岸头莎，钓竿自种篱边竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙","author":"徐积","text":"云是口中气，雨是口中沫。\n口中嘘吸须臾閒，天下焦枯一时活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤","author":"徐积","text":"百尺楼头凤一群，声如韶濩羽如云。\n开口一鸣天路白，六龙驰上海之濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸾","author":"徐积","text":"吹箫台上曾歌舞，留住秦云伴秦女。\n近来长趁紫宸朝，麟凤肩随龙接武。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹤","author":"徐积","text":"任教鸡鹜争糠秕，脱身一举三千里。\n如今直入凤凰池，口啄琅玕饮瑶水。\n旧群流落在人閒，为趁稻粱飞不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清虚台题华州崔氏园","author":"徐积","text":"名园自郊谷，何况筑高台。\n酷暑未尝到，清风长自来。\n云岚瞰山罅，烟水近池隈。\n谁更将松竹，萧森四面栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华州太守花园","author":"徐积","text":"南园花谢北园开，红拂栏干翠拂苔。\n却是梧桐且栽取，丹山相次凤凰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李守","author":"徐积","text":"莫说真州南畔路，楚望亭南路已遥。\n只可寄声来见问，更难折简去相招。\n船头何处逢秋水，山下谁家把酒瓢。\n且趁潮行急摇橹，到江州后更无潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟和御制赏花钓鱼","author":"徐积","text":"禁苑千花一夜开，祥烟深处翠华来。\n重轮日色辉天步，万岁山声荐寿杯。\n鱼跃灵池初浩渺，凤巢阿阁正徘徊。\n姚虞臣主方赓唱，蓬荜儒生愿窃陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舞","author":"徐积","text":"十幅华裀遍画堂，仙家妆束学霓裳。\n一双舞袖鸾凤势，满院春风罗绮香。\n巫峡朝云无定意，汉滨珠佩杂鸣珰。\n歌声未罢全无力，归去重闱泣晕妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘江潮 其一","author":"徐积","text":"独派岂从天汉坠，千涛争趁海波还。\n齐声怒过轰雷鼓，乱沫喷来碎玉山。\n尘土刮开心目外，冰霜留在骨毛閒。\n君看江上潮平后，恰似鱼龙战斗閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]