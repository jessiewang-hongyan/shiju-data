[{"title":"题郑季奕火阁","author":"赵蕃","text":"朝来日当窗，晚矣犹未落。\n梅开怪璀璨，信是日初薄。\n勿云丈席地，可咏亦可酌。\n岁月与情怀，宁须问今昨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓雪图 其二","author":"赵蕃","text":"沙鸥故飞飞，湖雁更历历。\n顾我亦忘机，相看同一适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓雪图 其四","author":"赵蕃","text":"曾恨固无遗，谢兴亦不浅。\n人言介庵介，我谓远斋远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓雪图 其一","author":"赵蕃","text":"空濛天外林，璀璨岸头石。\n何许放舟回，寂然方自得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题临水茅亭","author":"赵蕃","text":"竹里茅檐竹外溪，青琅玕映碧玻瓈。\n吟从亭午到薄暮，诗就不知安所题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题彦真天开图画","author":"赵蕃","text":"湘山不为高，湘水未为远。\n湘城几何家，湘景无不挽。\n滕侯宅虽早，郭圃市之晚。\n纡馀直陂陀，突兀对偃蹇。\n登临适正昼，亭榭惬深稳。\n诗材浩无穷，画手羞用本。\n虽然倏变化，正以发关键。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐氏滋德堂用老谢丈韵","author":"赵蕃","text":"一时人物韩与苏，题榜制名夫岂疏。\n保家匪乏千金产，教子必以万卷书。\n江河源从滥觞起，拱把可取合抱馀。\n方今天子陋汉武，会见待诏仍公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题乾明庵","author":"赵蕃","text":"谁结道人庐，前临博士湖。\n名非窜荒李，官是避秦庐。\n隐德虽无述，清风不可渝。\n严元有孙子，往往混樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题喻氏万卷楼","author":"赵蕃","text":"今人藏书务书多，昔人读书病书少。\n藏书不读竟何用，岁老财供蠹鱼咬。\n俞君命意何其贤，藏书读书两相兼。\n有楼不肯贮风月，名以万卷非徒然。\n我今百念空如水，祇有耽书心未死。\n为君作诗岂无意，一鸱时送从兹始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蒋伯玉作白玉山创亭于廨舍之后榜曰望云思其亲也因赋十韵","author":"赵蕃","text":"蒋侯家荆溪，胸次饱空阔。\n一官寄楚尾，常病登眺窄。\n有酒无地把，况助诗句活。\n规模作危亭，更为思亲设。\n安车几时来，历览吴与越。\n俸廪虽云薄，采菽水可啜。\n我实通家子，此意敢自别。\n愿同竹马儿，就彼上寿列。\n岂惟一门事，犷俗坐可革。\n长使是邦人，指亭记所茇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新乐铺铺在滩头","author":"赵蕃","text":"朝烟山濛濛，暮霭山羃羃。\n穷日作山行，而不见山色。\n投昏宿此舍，乞晓动前辙。\n归梦绕家山，滩头有轻楫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新市酒家","author":"赵蕃","text":"有鱼可漉酒可沽，尔更未知山水娱。\n今晨系缆才须臾，异日回头看画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"磬湖","author":"赵蕃","text":"凿开何自来，名得因形似。\n似欲使先生，因兹号居士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡山道中怀清江旧游寄长沙诸公","author":"赵蕃","text":"昔我官白下，屡到清江上。\n清江众君子，我友或我丈。\n至今过其邦，眷恋若乡党。\n几思结庐居，风流共来往。\n柰何怀玉山，挽我不我放。\n去年五溪归，泊家长沙国。\n长沙今洙泗，不但谈贾屈。\n梁吴兄弟游，两周新旧识。\n咸能不我鄙，更复成我益。\n其馀或一见，往往情如昔。\n自疑长沙人，宛类清江时。\n官期纵卒卒，行计犹迟迟。\n出门即风雪，怅此将安之。\n然薪旋烧酒，借笔追索诗。\n诗成何所属，兴落古湘西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠于革去非时为武陵尉","author":"赵蕃","text":"忆昨闻君谓君老，及见知君得名早。\n文章妙处殆夙成，不作扬雄少而好。\n西山南浦饫搜寻，武陵桃源暂探讨。\n诸公识面争我出，学子闻风竞门扫。\n嗟我无闻不足畏，何事相逢亦倾倒。\n论诗未易当韩豪，聊复悲吟似郊岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠云卿","author":"赵蕃","text":"乃翁里居时，曾上庐山牍。\n怀贤访其孤，今值词人牧。\n我尝爱临川，韩草刊于陆。\n尔侯古雅趣，与陆堪并躅。\n而翁词翰佳，世亦思在目。\n尔其持此诗，勿惮拜仆仆。\n侯宁谓我易，未遂嗔尔渎。\n峨峨兮西山，光燄那久伏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠尤检正四首 其四","author":"赵蕃","text":"季秋过庐陵，客有示新录。\n尤杨两诗翁，间以严州陆。\n澧兰与沅茝，顿觉无芬馥。\n何况破囊中，欲探还自忸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠尤检正四首 其三","author":"赵蕃","text":"榜舟浙江潮，僦屋长安雪。\n寒涛幸少年，积冻还复结。\n虽逃蛟鳄虞，未免薪刍绝。\n噂?怅难登，嗫嚅羞妄悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠尤检正四首 其二","author":"赵蕃","text":"往焉石灰桥，粲粲方秘书。\n近者南浦亭，皇皇乃轺车。\n遄归今几年，人望益以储。\n俱期白兽省，共徯玉堂庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠尤检正四首 其一","author":"赵蕃","text":"多书如邺侯，读书如张巡。\n一代信不数，吾身见能亲。\n门墙虽云旧，踪迹乃若新。\n政以沅湘远，无由书疏频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠孙从之","author":"赵蕃","text":"吏事要及民，何假须缘饰。\n是故西都儒，往往名背实。\n萍乡孙明府，抱负惟儒术。\n起家长此邦，为政皆有述。\n催科非我急，急民使滋殖。\n今夏戒艰食，粒米劝蓄积。\n种麦贵宿耕，禾孙视前绩。\n是我贤弟昆，三市俱鼎立。\n正之官南昌，大吏遭丝刻。\n为陈先世事，稍稍从吾律。\n窃尝叹斯人，当补谏争缺。\n如何即九原，我为长太息。\n叔也今王官，路以云霄逼。\n才难未易识，屡荐今始入。\n赣川与洪州，目见非耳得。\n使之佐庙谟，弥缝宁阙职。\n公行被里言，步武俱文石。\n为移一县政，于以均万国。\n我虽落蛮夷，归来岂无日。\n傥遂乐耕耘，于焉吾事毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别吴仲权三首 其三","author":"赵蕃","text":"移舟汉将祠，蹑屐秦人洞。\n一别几何时，酒杯还此共。\n前途或追随，祇恐终倥偬。\n要是策羸骖，无繇踵飞鞚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别吴仲权三首 其二","author":"赵蕃","text":"昔在山水乐，往往失意人。\n公今弦歌馀，乃复于此亲。\n搜罗既奇胜，落笔为写真。\n文章复何似，高处殆先秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别吴仲权三首 其一","author":"赵蕃","text":"英英延陵家，蔼蔼宜章县。\n政用鲁诸生，俗今齐一变。\n诸公竞推毂，天子思晚见。\n用舍有是夫，交亲谁不羡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠唐德舆通判","author":"赵蕃","text":"忆昔中原全盛日，犹推巴蜀多人物。\n况今王气在东南，北望中原渺萧瑟。\n先生隐居谈典坟，博士乃有垂世文。\n内前之行传未了，钩党已到白鹭群。\n舍人父子自知己，红药翻残棠屡憩。\n逮公四世传以是，池上凤毛宜翙翙。\n胡为一再才别乘，纵说翱翔岂其称。\n鸡群牛皂匪殽杂，玉水珠渊自辉映。\n维公大父我曾祖，绍圣同年蒙主恩。\n我今流落不足论，附骥讵敢侪青云。\n鄱阳别去今三岁，邂逅从公宁自意。\n几思著句道所以，笔力甚孱无好思。\n今辰何以为公寿，四世斯文端不朽，匪蜀眉山还有否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠耆英","author":"赵蕃","text":"用世故欲巧，拙者终近德。\n人皆笑髯曾，我独长太息。\n贫吾岂人为，问天天不痴。\n君看松柏受，宁与春风期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠弹琴李睎尹","author":"赵蕃","text":"临川郡古多奇迹，严黎已老裘父没。\n江山纵是诗得摹，峨峨洋洋亦其物。\n谪仙几世之云仍，平生嗜渠如嗜文。\n光风霁月胸次有，渭北江东脚底频。\n忽来过我今几日，拟欲赠行空四壁。\n临分谩与一篇诗，筝笛纷纷敢谓知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠曾槃乐道","author":"赵蕃","text":"我居怀玉山，茶山非一游。\n每观文清竹，凛若人好修。\n往来道嘉禾，诗曾长公投。\n十年再建业，问劳加绸缪。\n中歌殄瘁诗，尺疏去莫由。\n虽微荆州论，感叹自不休。\n今日复何日，兰溪系归舟。\n典型君尚有，一见写余忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠路芾德章","author":"赵蕃","text":"忆昔介庵老，视我犹子弟。\n于今于越州，必洒西州涕。\n重忆郎中公，契与外氏通。\n慨我未知学，一见宁发蒙。\n公于介庵老，笔砚相亲友。\n而于郎中公，学问躬授受。\n与我非素交，有儿仍甚愚。\n辱公收教之，举俗有是夫。\n辱书示深眷，未报无加谴。\n平日但闻风，今朝真识面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辨漆","author":"赵蕃","text":"面上清如水，牵丝作钓钩。\n拨开鹰粪脚，打起有浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邂逅孙子仪于临安喜而赋诗并怀子进子肃","author":"赵蕃","text":"车尘高没人，欲障无能施。\n忽逢故人面，如濯清涟漪。\n客居纵荒凉，聊复具酒卮。\n劳苦数语外，论事仍索诗。\n长年口欲棘，一笑为解颐。\n怀哉二难兄，何由会埙篪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"濠乐","author":"赵蕃","text":"韩悲沮洳居，贾叹寻常渎。\n何似老庄周，逍遥一篇足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"魏辰州生日","author":"赵蕃","text":"昔在思文献，今焉见典刑。\n玉良中有韫，陂广外无形。\n毓秀舒淮水，飞声出汉廷。\n恩虽予符左，官来继毡青。\n谕俗书阴德，传家刻孝经。\n庶几相感格，于以称丁宁。\n万象皆春气，斯人乃德星。\n否臧斯列上，耳目岂途听。\n松茂寒仍秀，兰幽远更馨。\n不惟归盛美，并用祝脩龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣县道中有怀晦庵用江东日暮云为韵作五诗寄之 其一","author":"赵蕃","text":"我行向何许，贡江与章江。\n悠悠异所见，俗变服亦庞。\n定迁本中州，来南已殊邦。\n况此接荒服，寸心那得降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣县道中有怀晦庵用江东日暮云为韵作五诗寄之 其三","author":"赵蕃","text":"自往一寄书，俯仰又许日。\n岂无东归便，值遇多卒卒。\n昔如马口衔，欲去随缓疾。\n今者身属人，动步窘刀笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣县道中有怀晦庵用江东日暮云为韵作五诗寄之 其四","author":"赵蕃","text":"去年过辞公，忽忽值春暮。\n及今复兹时，而公在何处。\n荆溪坡之居，濑上郊所赋。\n公能蹑高踪，我岂遗野趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣县道中有怀晦庵用江东日暮云为韵作五诗寄之 其二","author":"赵蕃","text":"此心如江水，日夜东复东。\n不惟爱吾庐，顾瞻几临风。\n今者款段马，向来御史骢。\n在我何得失，人自分悴丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣县道中有怀晦庵用江东日暮云为韵作五诗寄之 其五","author":"赵蕃","text":"半出未吐日，徐行欲归云。\n岂惟阴晴殊，政自凉燠分。\n物态故应尔，天机宁亦云。\n安得变淑气，尽为除楚氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十三日夜五更闻杜鹃时成父欲入浙因赋六章章四句以送之","author":"赵蕃","text":"不如归去，苍山茂树。\n独胡为乎，空此号謼。\n归去来兮，斯言可师。\n我今已归，胡能不知。\n不如归去，春且云莫。\n山中之乐，岂同岐路。\n归去来兮，言发动随。\n古之逸民，舍陶而谁。\n不如归去，载丁载宁。\n劝子勿去，子宁我听。\n不如归去，子宁肯住。\n归去来兮，早歌式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行见月作 其一","author":"赵蕃","text":"有风肃然，落于树巅。\n使我沈痾，不药而痊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行见月作 其二","author":"赵蕃","text":"意行何之，陟此云岭。\n如梦而觉，如昏而醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行见月作 其四","author":"赵蕃","text":"恨我无酒，负尔一醉。\n酌兹寒泉，兀尔忘睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行见月作 其三","author":"赵蕃","text":"东坡老翁，有言莫酬。\n凉天佳月，即为中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧云 其一","author":"赵蕃","text":"碧云散舒，合且复离。\n皓月涌照，圆而不亏。\n嗟我所期，曷云不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧云 其二","author":"赵蕃","text":"翳翳村巷，遥遥犬声。\n肃肃庭树，啾啾鸟鸣。\n所期不来，实关我情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧云 其三","author":"赵蕃","text":"寒镫既张，幽室有光。\n岂无他人，惟子之良。\n闭彼柴荆，今夕斯长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十三日早霁","author":"赵蕃","text":"晴云如衣如絮，落月似钩似梳。\n鸬鹚鸂鶒未觉，一段并能属予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十一日","author":"赵蕃","text":"少年意与春竞，老去全将病供。\n鹊噪芳阴树树，蝶飞幽梦重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从莫万安觅柑子并以玉山沙药合寄之六言三首 其三","author":"赵蕃","text":"世态多随燥湿，物情大费堤防。\n遗以药筒如截，取其勿败甘香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从莫万安觅柑子并以玉山沙药合寄之六言三首 其二","author":"赵蕃","text":"我识令君人物，传柑合侍清都。\n寂寞当思林下，有时病渴犹须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从莫万安觅柑子并以玉山沙药合寄之六言三首 其一","author":"赵蕃","text":"忆过万安连郭，家家碧树团栾。\n想见如今霜后，摘来可口甘酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发潭州后作","author":"赵蕃","text":"昔日道林岳麓，每逢图画诗篇。\n今日羸骖东首，却成惨澹云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游道中三首 其三","author":"赵蕃","text":"晴山阴雪犹在，西下东风苦高。\n眼贪白鸟孤没，耳怕哀猿数号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游道中三首 其二","author":"赵蕃","text":"山连远近惨澹，水合东西渺瀰。\n旧说诗中有画，今成画里寻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游道中三首 其一","author":"赵蕃","text":"下水楫轻如鹜，溯流帆敏于鸿。\n人心愿祷欲遂，天意若将无同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因书寄黄子耕六言三首 其三","author":"赵蕃","text":"自失孤山杯酒，两年相望梅花。\n交友平生几许，差池重复成嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因书寄黄子耕六言三首 其二","author":"赵蕃","text":"忽有长沙使至，为传江右书来。\n茅屋于时已黑，青灯为尔频开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因书寄黄子耕六言三首 其一","author":"赵蕃","text":"旧谒南州高士，必过江夏无双。\n吊古已悲衰柳，怀人更隔长江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作梅花六言未就而得兰一盆并颂之三首 其三","author":"赵蕃","text":"梅句商量未稳，兰诗拥并人来。\n试问关山细雨，何如茅屋苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作梅花六言未就而得兰一盆并颂之三首 其二","author":"赵蕃","text":"死欲千秋万岁，生须四海九州。\n人里封胡羯末，诗中沈谢曹刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作梅花六言未就而得兰一盆并颂之三首 其一","author":"赵蕃","text":"绝叹园林枯槁，顿惊溪谷精神。\n两鬓我终如雪，数花渠可回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远见梦有作六言二首 其二","author":"赵蕃","text":"几欲罢官归去，未应形役能拘。\n矗矗奇峰晚对，岂如云谷同趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远见梦有作六言二首 其一","author":"赵蕃","text":"白也江南逐客，少陵因梦成诗。\n我亦移官衡岳，惊乌未有安枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远别后见寄六言四首 其四","author":"赵蕃","text":"子国有黄叔度，女子识韩伯休。\n晤对可忘长夏，分携况值新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远别后见寄六言四首 其三","author":"赵蕃","text":"学道了无得处，空云孟子鲁论。\n为文老益退步，怀哉赋鵩招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远别后见寄六言四首 其二","author":"赵蕃","text":"旱势东南已病，秋风早晚室凉。\n蓝缕青衫可笑，萧条白发增长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵斯远别后见寄六言四首 其一","author":"赵蕃","text":"避暑真成畏病，逢秋便觉生愁。\n回首南山幽处，有怀数子同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]