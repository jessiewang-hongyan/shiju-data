[{"title":"赠梅","author":"邓深","text":"花蒙腊雪袁安卧，影落寒江正则魂。\n忽见江南春信息，谁教驿使到夔门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀼西亭即事","author":"邓深","text":"危亭曲槛俯溪流，去去来来渡口舟。\n微雨不妨人刈麦，轻烟正可客垂钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕竞渡","author":"邓深","text":"水马相先急画桡，朱楼红粉宴笙箫。\n月中谁念穿綵线，江上齐看夺锦标。\n冷眼诸人旁贾勇，争头一鼓喜成谣。\n凭谁试展乘槎手，直入银湾看鹊桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日方壶","author":"邓深","text":"返照重城暮色催，人家十万出楼台。\n江流湛湛洞庭去，山色青青衡岳来。\n佳处绿樽穷日饮，故园黄菊向谁开。\n人间此会论今古，醉听西风拂帽埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日灵兴山沽酒赏菊","author":"邓深","text":"众山环绕一溪斜，低小轩窗眺望赊。\n行遣方兄寻野店，坐邀欢伯过仙家。\n多情恋顶乌纱帽，不语向人黄菊花。\n山月上时归更好，何妨有待至昏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十四夜赏月","author":"邓深","text":"月婵娟对竹婵娟，竹影萧疏月转妍。\n才过中庭十分好，直疑明晚一般圆。\n银河漾漾无尘界，玉宇昭昭不夜天。\n君饮不多须强饮，何妨醉里却逃禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵答克修","author":"邓深","text":"前回藜杖绕芳郊，底处梅花出好梢。\n野彴低横盈尺水，竹篱深护数家茅。\n春风桃李成生客，腊雪松筠是故交。\n剩欲再携樽酒去，柴门应复许人敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三伏中一雨苏旱","author":"邓深","text":"江涨如三月，天凉似九秋。\n遭逢今日雨，安稳一年收。\n处处香瓮面，村村肥藁头。\n小春前后好，待挂百钱游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山斋早起","author":"邓深","text":"推枕凌晨起，添衣奈冷何。\n新霜浮瓦薄，缺月挂檐多。\n野烧犹残焰，邻鸡尚冻歌。\n拨灰添宿火，一快爇松柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月湖祷雨有应李渭赋诗次韵并呈","author":"邓深","text":"一雨端由诚意通，不然笔落有神功。\n奔云拥树千山黑，迅电翻江万丈红。\n黍稷盈畴才可望，尘埃眯眼顿成空。\n民间岁晚知何事，饱饭无忧属两公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木芙蓉","author":"邓深","text":"露冷烟凄草树荒，木芙蓉好试平章。\n蒲萄晚叶尤宜日，芍药秋花正耐霜。\n蜀锦卷帏妆院落，秦宫开镜照池塘。\n写容安得剑南老，聊复殷勤酹一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东池把酒","author":"邓深","text":"隐显亭台旧，浅深桃杏新。\n池光迷野鸟，春色醉游人。\n改席那嫌数，持杯不记巡。\n海棠宜秉烛，归恨隔城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"市桥成次韵","author":"邓深","text":"雷雹平时生马蹄，偶冲暴涨去难追。\n一年病涉愁无奈，今日安行喜可知。\n虹饮江头愁雨霁，龙横水面暮云垂。\n却怜舟楫无人渡，借我江心理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉虚洞其上有日月之象其旁有龙象之形","author":"邓深","text":"立马香溪唤渡船，羊肠绕尽洞呀然。\n知谁开辟群工巧，直许宽虚一室圆。\n龙象现形严佛土，乌蟾垂象烛壶天。\n惜哉不遇东坡赏，为作新诗与世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同友人新陂庄少憩","author":"邓深","text":"家家轣辘络丝声，竹杖芒鞋取次行。\n村笛牧羊烟欲暝，农歌秧稻雨初晴。\n随瓶沽得酒堪醉，就野挑来菜可羹。\n此是田家真况味，吾曹借取片时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同廷美兄宿龙福寺","author":"邓深","text":"峰回路转竹间扃，古寺寻幽当下程。\n浅屋近山寒较早，小窗容榻意偏清。\n睡魔催枕如元约，山鬼吹灯似薄情。\n樽酒重温休惜醉，恐君长夜厌蛩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮寄兰窗兄在郴阳","author":"邓深","text":"每日登楼望欲迷，家书写罢复题诗。\n对床夜雨还非昨，啜茗春风未可期。\n岁月催人惊合沓，梦魂觅路苦参差。\n也应梅竹多新句，千里因风慰我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋","author":"邓深","text":"风入题诗叶，清音已奏商。\n夜来堪简册，客至便衣裳。\n次第征鸿到，还令团扇藏。\n人情兼物意，殊觉漫炎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早梅","author":"邓深","text":"荒村野水小春时，纵有梅开人未知。\n几度携筇无觅处，今朝映竹忽横枝。\n脱非入骨清香动，恐被传神淡墨欺。\n酸意中含和鼎实，相期远到诵黄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴文美","author":"邓深","text":"决科君辈不须疑，好采来如博局嬉。\n拾芥紫青非外事，举杯富贵可前期。\n相将竞奏大人赋，怂恿常谈小子诗。\n接武虞廷须八凯，颍阳深遁我何知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵易高士","author":"邓深","text":"新诗叹干戈，流移痛眼边。\n公若据要路，不惜金躯捐。\n同舟曾有约，傥行亦忧煎。\n政恐无此吟，掩卷空自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵欧阳天聪","author":"邓深","text":"今古由来几废兴，人生底事谩劳生。\n一身休作笼中鸟，万事终归墙角檠。\n且与风光閒作主，莫于诗社倦寻盟。\n相从只么消閒暇，自快人间物外情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵晚春","author":"邓深","text":"阆仙晦日惜春归，尚喜争他五日迟。\n延蝶晚花馀小茜，藏莺暗柳尽低垂。\n频催布谷能谋野，苦劝提壶殆为私。\n寄语社中须痛饮，喜晴山色也开眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答公美二首 其二","author":"邓深","text":"四至长沙熟物情，留题胜处记吾曾。\n三生会是湖湘客，一钵浑如云水僧。\n赢得身轻閒有味，尽从人笑老无能。\n如君应饱田园乐，犹道啼饥有怨憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答公美二首 其一","author":"邓深","text":"幽居正傍小溪斜，想见樵风似若耶。\n固有诗章舒眼界，可无药物助脾家。\n追欢难共长沙酒，遣睡姑尝陆羽茶。\n更祝安心为妙法，都将世事等空花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答周公美","author":"邓深","text":"温风怂恿柳婆娑，两见春来蜂蝶多。\n迁变时光如转烛，迟留日影欠挥戈。\n思君欲问加餐未，苦思能令太瘦么。\n岁晚忘言除习气，寒灰试共拨阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赋十月桃为罗司理生朝","author":"邓深","text":"根苗不自武陵乡，挟暖凌寒独有光。\n韵过海棠春带露，红羞篱菊晚经霜。\n宅仙本结千年实，瑞世仍开十月芳。\n过插一枝谁称面，后堂杨柳舞霓裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自赋大隐","author":"邓深","text":"柴门虽设日常关，只有琴书几案间。\n屋宇无多聊近市，尘埃不到即深山。\n悠悠世事非吾事，往往云閒是我閒。\n出处尚疑陶靖节，倦如飞鸟始知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕坊渡","author":"邓深","text":"江阔寒风痛括肌，村醪无力破寒威。\n融霜点滴松间雨，爱日晴明身上衣。\n闯竹柴扉黄犬吠，卧沙蓬艇白鸥飞。\n烧痕已觉春来近，稍放青青出土肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何先生月湖楼","author":"邓深","text":"青天素月古今流，奇观还须自我谋。\n照有馀辉众人共，取之不禁此湖收。\n水容天色交光处，玉鉴冰壶不夜秋。\n俯仰无尘清绝甚，栏干百尺独宜搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别长沙驿渡","author":"邓深","text":"别去六年久，重来四日留。\n笋舆离古驿，荻岸即方舟。\n云淡楚天阔，风高湘水秋。\n洞庭知不远，乘兴欲盟鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"邓深","text":"水夹山围近，天悭日到迟。\n塞沙擎巨石，古木障崇祠。\n黄藁畬田粟，青烟茅舍炊。\n两村生理足，乐处几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀清旷兄弟","author":"邓深","text":"可观阁上借床眠，明月清风不用钱。\n会面向来无空日，离群何事有经年。\n相望千思江湖地，正坐三秋风雨天。\n耿耿青灯空透影，可堪新雁一声传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀清旷兄弟","author":"邓深","text":"残腊迎除夕，新春接上元。\n常时陪内集，排日醉芳樽。\n岁月惊殊俗，关山隔故园。\n谈边应记我，频嚏怪黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村中病起","author":"邓深","text":"访医墟落疾难痊，肘后奇方得旧编。\n药济君臣亲剂和，火停文武事烹煎。\n旁人笑道徒为尔，午睡醒来已脱然。\n从此节宣防未病，那须扁鹊信真传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜兴","author":"邓深","text":"官舍浑如僧舍幽，炉香静坐兴悠悠。\n一窗灯火鸣蛩夜，千里湖山落雁秋。\n只恐有诗成笔下，自馀无事到心头。\n何妨信手翻书卷，不限更深困即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩石山鼓","author":"邓深","text":"有字留诗锦，无皮入药囊。\n同坚唯铁杖，易穴岂藜床。\n况有千年润，能添六月凉。\n因岩作书院，驰誉比衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画壁","author":"邓深","text":"松柏双双夹竹青，来游仙客称閒情。\n一时幻出谁能尔，四者依然太瘦生。\n郁郁相交堪掬翠，昂昂自得若闻声。\n如何艳冶容繁杏，殆恐人嫌境过清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"邓深","text":"鹅鸭江村曲，人家竹树深。\n闲云自来去，皎日屡晴阴。\n水送园蔬叶，谷传樵斧音。\n瘦驴鞭不动，风处得披襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尝云安曲米春","author":"邓深","text":"名自云安已久传，未尝先觉口流涎。\n三杯通道正须此，一盏醺人今信然。\n取醉间关怜杜老，闻香比拟忆苏仙。\n岂知閒散江湖客，快饮瞿唐滟滪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡江","author":"邓深","text":"击电浮霜浪作堆，峡江试险眼初开。\n常惊四畔山围绕，不见中间水去来。\n石出多奇吾甚爱，舟移太疾首频回。\n濒涯稳处凭谁问，我欲其间作钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"施食","author":"邓深","text":"它乡身总健，每食饭何如。\n一饱宁无限，三人动有馀。\n娇鸦来木杪，喜鹊下庭除。\n施食僧家事，何妨领略渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜次韵答肯堂兄","author":"邓深","text":"天赋疏慵性，身将四十年。\n逢欢开口笑，遇醉倒头眠。\n世事多翻覆，时光易变迁。\n置之无足校，五字要清圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪","author":"邓深","text":"勾芒新政让玄冥，一雪填门讶许平。\n不夜乾坤月留照，无尘世界玉装成。\n如何辨认梅花发，只得誇张柳絮轻。\n数片檐前休扫去，且留窗下快书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柔远楼","author":"邓深","text":"柔远楼高豁寸眸，白盐赤甲锁关头。\n四川形胜当前险，三峡波涛据上游。\n鸟道极天云日近，靴城匝地市烟浮。\n时平久矣无戎马，回首当年老杜忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋大阅呈月湖先生","author":"邓深","text":"将兵还似将风骚，军帐从容自不劳。\n鼓角悲风肃人马，旌旗蔽日闪弓刀。\n折冲正自烦樽俎，急檄宁闻借羽毛。\n洗眼临淮新号令，凭谁挑战醉挥毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈仲思","author":"邓深","text":"中鹄知谁好，烹鱼始认名。\n报公勤有子，似我懒无甥。\n何日亲相见，因风且寄声。\n泥金闻喜处，樽酒欲同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追送何伯宪不及","author":"邓深","text":"追送无从谩寄诗，道间安稳我能知。\n情怀亦似居家乐，笑语依然奉母慈。\n巴水柳风新霁后，钱塘花雨暮春时。\n乃翁邂逅询佳况，膝上时时置坦之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕把酒","author":"邓深","text":"爆竹惊今夕，屠苏荐诘朝。\n去来时转眼，新旧岁中腰。\n立地符先钉，倚门钱未烧。\n土人珍裂饼，聊以荐金蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涌翠为知观周允升作","author":"邓深","text":"山翠来如涌，开轩不怕深。\n浑疑霏雾雨，已觉湿衣襟。\n世事归楸局，泉声当玉琴。\n道人尘外越，我欲剩追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别赵徽猷","author":"邓深","text":"自客湖州市，时登韫美堂。\n云烟看挥染，风月共平章。\n酒子常同醉，梅兄已再香。\n遽为今日别，欲乞旧诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留报恩定老","author":"邓深","text":"住山姑小试，同学偶相求。\n两手便分付，诸公坚挽留。\n退庵曾毒手，进步莫回头。\n早晚江湖去，閒云更自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留通商馆数日","author":"邓深","text":"商馆非闲地，闲人偶在旁。\n无端声利役，有许去来忙。\n受雨芭蕉响，怀风䆉稏香。\n江郊秋易盛，早献十分凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"躬耕","author":"邓深","text":"靖节田园兴，子真岩谷情。\n古人虽不见，今代有同清。\n道义丘山重，轩裳羽翮轻。\n萧然无俗累，心地湛虚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁拄杖次韵答赵侍郎","author":"邓深","text":"非竹非藤性最刚，铁君风骨凛秋霜。\n清坚阅世千年久，正直持身九节长。\n宜向山林扶矍铄，难随车马入康庄。\n只愁雷电搜蛟蜃，并及新诗不许藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪吴正字赏花诗","author":"邓深","text":"名园无物不芳妍，上个篮舆缓绕旋。\n曲径幽亭留客地，微云淡日养花天。\n四时公举春为最，万事铨量酒是先。\n管领风光须一醉，要看诗笔落云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿长湖尾","author":"邓深","text":"古木侵沙路，柴门引竹篱。\n山低秋水阔，天远夕阳迟。\n杳杳来鸿雁，翩翩下鹭鸶。\n渔舟何处宿，横笛未休吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄饶云叟","author":"邓深","text":"别来每辱遗双鲤，颇怪吾侬不作书。\n非为广文官独冷，自缘中散性常疏。\n静晖待月昏钟后，制胜登高晓雨馀。\n正忆去年同此会，只今相望问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄清旷兄弟","author":"邓深","text":"一别春三见，相思日几回。\n自离夔府后，已过岳阳来。\n寒食还虚度，酴醾幸晚开。\n到时犹可及，应得共衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄麻姑山李元礼","author":"邓深","text":"不见山中客，还经四度春。\n近闻归旧隐，真个是閒人。\n吹发松风迥，当轩琴月新。\n悬知心更静，梦不到红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄曾德广","author":"邓深","text":"懒慢多违俗，寻常倦作书。\n分襟还许久，为况定何如。\n鸿雁秋风冷，梧桐夜雨疏。\n相如病好否，何日过吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"接天阁为武将荣叔赋","author":"邓深","text":"山色浑连水，波光总映空。\n捲帘秋雨后，注目夕阳中。\n低下翩翩鹭，斜行点点鸿。\n去天应尺五，归去会乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐散花之室","author":"邓深","text":"官居无处寄幽栖，洞户深沉坐最宜。\n静拨炉薰挹香气，间论画壁数花枝。\n虫鸣颇似雁来后，果熟还如莺老时。\n吹彻角声巫峡晚，片云催雨更催诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"邓深","text":"雨催柔绿上桑枝，新霁浮云未尽归。\n寂寂帘栊留燕舞，阴阴杨柳护莺衣。\n莫于绮席嫌筹并，已觉青春作鸟飞。\n满径落花愁踏损，羊欣切勿款柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋怀社中诸子","author":"邓深","text":"池塘水落倒枯荷，橘绿橙黄晚菊多。\n日暖怀沙鳖衷甲，霜清奔火蟹横戈。\n如今时节从来好，得醉工夫似旧么。\n傥有征鸿过巫峡，待凭诗句问如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅方开一花","author":"邓深","text":"烟村清浅白沙溪，篱落槎枒老树枝。\n一朵梅开如许早，几多人过不曾知。\n风前遇我还青眼，花里推渠是白眉。\n未办酒樽浇磊块，试凭诗句写新奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦回","author":"邓深","text":"日日风吹雨，秋深寒气催。\n檐声中夜断，月色上窗来。\n冷砌虫吟稳，幽屏蝶梦回。\n明朝应露重，晚菊正宜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]