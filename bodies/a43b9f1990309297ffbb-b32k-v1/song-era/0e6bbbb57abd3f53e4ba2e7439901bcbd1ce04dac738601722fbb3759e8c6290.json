[{"title":"山居杂诗九十首 其三十九","author":"曹勋","text":"休官伏畎亩，农事未历览。\n年丰则知喜，岁歉颇不鉴。\n螟蜮则曰蠖，不实乃名冇。\n生民惰与勤，天灾未尝滥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十六","author":"曹勋","text":"北归了无日，先垄扫何时。\n愁与燕鸿远，心同楚客悲。\n寒蝉咽败柳，幽鹭来清池。\n谁与话旧事，泪藓空在衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十八","author":"曹勋","text":"手种亭下松，偃盖出云外。\n攀条喜脩干，为我发清吹。\n晓庭风瑟缩，夜月金锁碎。\n种久方来归，对之颜有愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十七","author":"曹勋","text":"饭了纵闲适，杖屦涉晴昼。\n时物破百感，环山献明秀。\n承宇茂芳桂，追凉风细逗。\n摘果靡惮劳，聊用引稚幼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十八","author":"曹勋","text":"前日花正红，今旦香已改。\n我知色空相，未开固非在。\n韶华每备陈，风雨不相贷。\n任渠万点飞，岂待愁如海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十","author":"曹勋","text":"西山隐道室，山光锁葱茜。\n松竹意可揖，芳润欲入馔。\n扳携一二友，香火共昏旦。\n天台坐忘身，笑领吾所眷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十一","author":"曹勋","text":"瑞香本庐阜，瑞昌最为冠。\n以此得瑞名，昧者强臆断。\n种法避寒暑，锦笼不足纂。\n欲披紫云裘，时分建溪椀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四","author":"曹勋","text":"蒸沙以为城，冶铁用作限。\n未伸彼利害，先为己忧患。\n家事席未暖，基址已永叹。\n在德不在险，推类仁者谏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十二","author":"曹勋","text":"秋雨湿庭户，陋舍集闲客。\n重以樽酒空，可为饥肠厄。\n呼童取杯酌，村酒我先识。\n一杯复一杯，满坐生春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十五","author":"曹勋","text":"蓬荜久不居，乍归欣故情。\n落叶聚蛛网，残莎闹蛩声。\n迹与朝市远，梦随风月清。\n从此眠食间，萧散安馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十五","author":"曹勋","text":"松隐静无事，松竹惟参差。\n避热卧其间，绿荫回凉吹。\n水云不相远，起坐常自怡。\n此心益浩然，西风生桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十","author":"曹勋","text":"松根有至药，琥珀与茯苓。\n琥珀未易致，茯苓选宜精。\n制与鞠尘细，色如截肪并。\n一一伴朝粥，地黄安可京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十三","author":"曹勋","text":"我本汝颍士，老隐天台山。\n一瓢顾粗足，三谒无厚颜。\n身与樵牧远，居眇林壑间。\n不为物事役，常对风日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十三","author":"曹勋","text":"小隐世味薄，花飞惨残春。\n明玉剥楚笋，嫩紫庖吴莼。\n不觉槃箸阙，但喜志意新。\n我惟一廛足，何必问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十二","author":"曹勋","text":"闽浙风土异，九日未见菊。\n丰枝閟秀色，细蓓凄已绿。\n当樽折野蕊，气味亦枨触。\n讵知三径中，采采不一足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十八","author":"曹勋","text":"道德五千言，屡读殊隐奥。\n颇能分句法，已自到微妙。\n治国与脩身，篇篇言上道。\n讲解七十家，识者自知要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五","author":"曹勋","text":"吾年今七十，非杖或能行。\n食罢散步武，欲与跛鳖争。\n皮里气不充，骨中髓不生。\n安能勉筋力，笑傲云霞轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十三","author":"曹勋","text":"吾年将八十，历践何足数。\n义不惜骸骨，愧无罔君父。\n挂冠复挂冠，求去再求去。\n至愿诚遂心，燕笑乐畎亩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十二","author":"曹勋","text":"平昔喜鳌举，未易自摧堕。\n功名邂逅来，求则成大过。\n壮年不艰苦，老即困寒饿。\n消长理或然，要知非力可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十一","author":"曹勋","text":"莫怪游春频，只被老逼身。\n念此乐天语，诚哉辞甚真。\n遵行我不倦，治具汝勿嗔。\n持炬接迎我，村醉攲冠巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十七","author":"曹勋","text":"村落辟幽居，深静颇得趣。\n白云栖檐栋，岚光照窗户。\n往还得隐逸，谈笑皆旧故。\n不畏归路遥，家家响机杼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十三","author":"曹勋","text":"秋雨不可雷，雷即雨无节。\n况当收刈时，只欲天明洁。\n夫何连日雨，卧穗恐芽檗。\n已失早禾望，晚田幸天辍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十一","author":"曹勋","text":"泽国经炎夏，常厌日晷永。\n既乏枕簟凉，亦欠冰雪冷。\n北窗但倦卧，闲人远造请。\n时濯醒心泉，柳下汲深井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十","author":"曹勋","text":"吾年已七十，眠早起不宴。\n倦甚就宵枕，卧久思永旦。\n虽无文字劳，渐绝人事叹。\n收其放心尔，戒得尤所赞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十一","author":"曹勋","text":"莳松须残腊，栽花宜早春。\n移竹日随月，种麻月及辰。\n旺方八卦定，农诗七月陈。\n物性无不然，农业宜斤斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十三","author":"曹勋","text":"煴室宿火销，缊袍良独暖。\n病身怯夜永，老怀苦昼短。\n栖鸟惊檐头，朝日上窗眼。\n未问粥面花，地黄酒须满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十七","author":"曹勋","text":"中春艳桃李，东风惠以繁。\n胡为连日雪，花叶飘阑干。\n气非骄阳候，宛若残腊寒。\n玄冥僭融和，玉川知其端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其九","author":"曹勋","text":"清晓看田去，乘露衣襟凉。\n已有耘夫出，揖我喜非常。\n为言苗正好，喜颜笑亦长。\n虽有吏在门，视苗端可偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十二","author":"曹勋","text":"骎骎随日老，宁能问分阴。\n波流固自远，云在初无心。\n鸟声惊幽思，风徐快冲襟。\n马卿苦病多，中怀天莫忱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十四","author":"曹勋","text":"蒲桃天下冠，太原与全邠。\n邠故近西凉，种植纷士民。\n岂但马乳堆，殆若荔子春。\n为膏为酒醴，香味有此珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十","author":"曹勋","text":"春深多夜雨，倦卧得饱听。\n穿林乍依微，滴檐已纷竞。\n衾寒似落莫，人寂眷闲静。\n怡然遂高眠，枕上颇适性。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十一","author":"曹勋","text":"春雪翳重霄，寒雨连日夜。\n不辍兽炭炽，甚恐庭花谢。\n疏帘莫禦冷，炉焚屡成灺。\n寒食数日间，春事求诸野。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其九十","author":"曹勋","text":"北风号枯桑，浓寒坚夜冻。\n关河鸟过少，雪意晓来重。\n陌上未沾尘，山中已成垄。\n雍雍南去雁，袖手徒目送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十九","author":"曹勋","text":"吾家远城市，四围萦叠嶂。\n意寻烟霞游，喜逐樵牧上。\n松间憩两足，论高等四畅。\n或时戴月归，山花记心想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十五","author":"曹勋","text":"梢梢岸上柳，粼粼岸下波。\n晴云羃远岫，东风扇微和。\n去冬有耕植，连春无干戈。\n田畯知此意，种秫应更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十四","author":"曹勋","text":"侵晨盥栉起，爽气随凉飙。\n曳杖踏露草，不觉路已遥。\n水清出沙嘴，烟白横山腰。\n致爽列群岫，不待西山招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十五","author":"曹勋","text":"新年供家庙，老稚晨夕忙。\n块坐温暖处，但闻油酱香。\n不问物物阙，有食时时尝。\n诸孙甚解事，翁乃无饥肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十八","author":"曹勋","text":"临老看草圣，作字意少快。\n居然落笔际，点画反留碍。\n早意亦易事，怀抱殊不介。\n兹来每把玩，徒复一叹慨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十八","author":"曹勋","text":"栽竹勿傍墙，种蕉莫近砌。\n顷之根蔓延，寖乃坏阶戺。\n扶疏宛成趣，茂密相映蔽。\n操刀时遣獠，洗削去蓊翳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十一","author":"曹勋","text":"斗水小涟漪，拳石献岩窦。\n苍苍三峰足，挺挺数叶秀。\n棐几得巨壑，幽色清永昼。\n以我兼忘心，嵩华亦何有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十五","author":"曹勋","text":"云山贮回肠，日月任转毂。\n客居不问乡，一饱宁较粟。\n家酿报浮蚁，溪鳞买尺玉。\n以充朝莫槃，怀抱无乃足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十二","author":"曹勋","text":"行都老故旧，见赠新历日。\n快哉得过目，蘧然若有失。\n已病嗟再岁，渐老念弱质。\n叹馀落麈尾，非言付摇膝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十六","author":"曹勋","text":"素愿游匡庐，梦寐不可易。\n弃官竟一往，不以归意迫。\n屡扣清虚仙，杯酒话畴昔。\n永怀拨云峰，西麈每相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十八","author":"曹勋","text":"新春遨西湖，结伴每有侣。\n岂意气差忒，旬中自寒暑。\n欣欣一日晴，愀愀三日雨。\n谓言爱酒伴，有酒谁能湑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十二","author":"曹勋","text":"道人谈长生，禅子论寂灭。\n二子互出奇，生灭孰判别。\n吾侪守黄卷，生理知犹劣。\n惟当一以贯，无问亦无说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十二","author":"曹勋","text":"架屋集匠氏，斲石最可恤。\n相石千仞端，堑山方得出。\n疲形困辇置，巧磓较丝忽。\n所直等众人，人可不择术。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十六","author":"曹勋","text":"鸡冠与凤仙，早种近阶砌。\n夏秋无花时，类能作幽致。\n鸡色惟青紫，凤蕊杂红翠。\n来年不待种，罅隙自苗裔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十七","author":"曹勋","text":"老来参同事，勤志不敢失。\n人言炉偃月，吾意炉藏日。\n朝阳升西山，异液甘若蜜。\n一体奠所居，旦旦享清逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其九","author":"曹勋","text":"人生行乐尔，行乐则心闲。\n心既无所用，和气滋容颜。\n卫生有此妙，馀事皆可删。\n若益兼忘理，敢告知识间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二","author":"曹勋","text":"农人作田务，耘者最辛苦。\n肘膝伏泥涂，拔莠连茹取。\n所拔随已多，悉酿所伏处。\n惟冀禾稻肥，岂问正炎暑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十四","author":"曹勋","text":"四大一和合，所以兆我命。\n及其有损增，遂复制我病。\n五年过纵心，四大失正定。\n新岁转盼来，疾应改新證。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十七","author":"曹勋","text":"初意得闲适，处处期登临。\n岂谓病见拘，未能摅灵衿。\n小滞广莫愿，恐辜云水心。\n强半人事尔，无令成侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十六","author":"曹勋","text":"随分作栏槛，松竹带花柳。\n四时面面看，百种日日有。\n玩目必群卉，洗心付芳酒。\n吾侪不改常，居閒简可久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十九","author":"曹勋","text":"赤城玉京天，冠简奉香火。\n一旦僧有之，道容易佛坐。\n忽为道复得，瞿昙加巾裹。\n屡改神不闻，二家自人我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十四","author":"曹勋","text":"年来心目昏，稍息文字业。\n晓拥台山云，时读修禊帖。\n稚子来捋须，幼孙每持镊。\n晚来微雨休，幽径无不涉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十三","author":"曹勋","text":"墐户喜冬序，秋容换霜风。\n可叹景物移，只在笑谈中。\n菊茂远先见，蓼疏寒更红。\n老怀欣自惬，渐享爱日功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十八","author":"曹勋","text":"和靖骨已槁，后来欲无说。\n细雨断魂句，妙处益清绝。\n朅来客异县，篱落冷风月。\n吟哦一字难，愧此枝下雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十九","author":"曹勋","text":"寓居溪阴刹，未暇理归棹。\n遮眼阙文史，借书得探讨。\n卷舒白虎通，涵泳青龙钞。\n贤哉绝世书，欣然慰幽抱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六","author":"曹勋","text":"小圃艺花竹，春末已繁秀。\n土脉得锄斸，枝叶易秀茂。\n久以告老病，未免闭圭窦。\n相忘无芥蒂，一二约亲旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十六","author":"曹勋","text":"露蜂缀林薄，土蜂翔户内。\n飞绕旬日閒，穿穴皆其类。\n众声互起息，鬨然自阛阓。\n螫幼成肿毒，居闲视其未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十一","author":"曹勋","text":"闲时谒坟山，小筑真隐麓。\n怪来少清景，颇似阙脩竹。\n荷锄斸云烟，移种扶疏绿。\n亭亭才数根，一扫群朴樕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十八","author":"曹勋","text":"春来每窃抃，春去孰可谚。\n寻胜揽妍姿，对花得清燕。\n樽酒所以乐，摘植得忘倦。\n忽改绿阴阴，苍苔从满院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七","author":"曹勋","text":"古斗喜妙供，溪荪种匀抽。\n蘸水浮翠猬，络石骈栗皱。\n薿薿巧凝绿，梢梢眇含秋。\n相对几案间，萧然无与俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十七","author":"曹勋","text":"大麦未救饥，小麦渐擢芒。\n此时农夫叹，政阻接青黄。\n多畏频雨泽，只欲暄晴光。\n农安吾亦安，朝夕祈苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十二","author":"曹勋","text":"天地有大德，好生洽民心。\n炎云涨毒暑，此风散重阴。\n欲驱深旬热，忽作三日霖。\n人物荷造化，喜归田亩深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十七","author":"曹勋","text":"忆君远亦去，泉响堑每度。\n一笑成真乐，此乐固难屡。\n村闲桑柘秋，川阔牛羊暮。\n归顾紫领巾，愧我方学圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十","author":"曹勋","text":"今岁立秋早，便觉驱探汤。\n虽有正午热，已觉中夜凉。\n麻豆率房角，早禾亦上场。\n吾心喜可知，纪实藏诗章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十八","author":"曹勋","text":"英石多斧凿，司石殊怯脆。\n拳然太湖出，始有岩壑意。\n弹窝数峰绿，欲与仇池对。\n永念灵壁巧，嵌空劳梦寐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十九","author":"曹勋","text":"凿池固不广，纳纳隘所居。\n苟无水光寒，便觉非吾庐。\n漪涟漾芳渚，澄影浮晴虚。\n乐哉濠梁心，已复游嘉鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]