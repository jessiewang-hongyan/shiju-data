[{"title":"秋兴二首 其一","author":"陆游","text":"拒霜惨淡数枝红，石竹凋零不满丛。\n小蝶一双来又去，与人都在寂寥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴十二首 其五","author":"陆游","text":"莫笑门庭草棘荒，也能随事答年光。\n半瓶野店沽醇碧，一畚邻园饷矮黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴十二首 其四","author":"陆游","text":"病起残骸不自支，旋烹藜粥解饥羸。\n一编蠹简青灯下，恰似吴僧夜讲时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴十二首 其十一","author":"陆游","text":"樵客高僧两断蓬，偶同烟榜泛秋风。\n栖贤雪夜匆匆别，岂意相逢在剡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"陆游","text":"暮年身世转悠悠，又向天涯见早秋。\n昨夜月明今夜雨，关人何事总成愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"陆游","text":"星斗阑干河汉流，建州风物更禁秋。\n年来多病题诗懒，付与鸣蛩替说愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其三","author":"陆游","text":"迢迢枕上望明河，帐薄帘疏奈冷何。\n不惜衣篝重换火，却缘微润得香多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其一","author":"陆游","text":"少年万里度关河，老遇秋风感慨多。\n草圣诗情元未减，若无明镜奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其二","author":"陆游","text":"园丁傍架摘黄瓜，村女沿篱采碧花。\n城市尚馀三伏热，秋光先到野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其四","author":"陆游","text":"诗如水淡功差进，身似云孤累转轻。\n落叶拥篱门巷晚，一枝藤杖且闲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋旱方甚七月二十八夜忽雨喜而有作","author":"陆游","text":"嘉谷如焚稗草青，沉忧耿耿欲忘生。\n钧天九奏箫韶乐，未抵虚檐泻雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陆游","text":"庭院萧条夜气清，卧听宫漏下宫城。\n旅怀生怕还乡梦，留取残灯伴雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜二首 其一","author":"陆游","text":"灯欲残时酒半消，断砧疏雨共无憀。\n老来万事浑非昔，惟有诗情似灞桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜二首 其二","author":"陆游","text":"夜雨凄凉客思迷，闻砧却是梦回时。\n人人解说悲秋事，不似诗人彻底知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜池上作","author":"陆游","text":"短发飕飕病骨轻，临池闲看露荷倾。\n月明何与浮云事，正向圆时故故生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜观月二首 其二","author":"陆游","text":"谁琢天边白玉盘，亭亭破雾上高寒。\n山房无客儿贪睡，常恨清光独自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜观月二首 其一","author":"陆游","text":"梦回残烛耿房栊，杳杳江天叫断鸿。\n病骨不禁风露重，披衣小立月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜将晓出篱门迎凉有感二首 其一","author":"陆游","text":"迢迢天汉西南落，喔喔邻鸡一再鸣。\n壮志病来销欲尽，出门搔首怆平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜将晓出篱门迎凉有感二首 其二","author":"陆游","text":"三万里河东入海，五千仞岳上摩天。\n遗民泪尽胡尘里，南望王师又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜读书戏作","author":"陆游","text":"别驾生涯似蠹鱼，简编垂老未相疏。\n也知赋得寒儒分，五十灯前见细书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨渐凉有怀兴元三首 其三","author":"陆游","text":"清梦初回秋夜阑，床前耿耿一灯残。\n忽闻雨掠蓬窗过，犹作当时铁马看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨渐凉有怀兴元三首 其一","author":"陆游","text":"八月山中夜渐长，雨声灯影共凄凉。\n遥知南郑风霜早，已有寒熊犯猎场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨渐凉有怀兴元三首 其二","author":"陆游","text":"十年前在古梁州，痛饮无时不惯愁。\n最忆夜分歌舞歇，卧听秦女擘箜篌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思十首 其九","author":"陆游","text":"眼明尚见蝇头字，暑退初亲雁足灯。\n历历胸中千载事，莫将轻比住庵僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思十首 其三","author":"陆游","text":"一篇旧草天台赋，六幅新传太华图。\n占尽人间清绝事，紫藤香起竹根炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5654,"sha256":"803c6a90ea3