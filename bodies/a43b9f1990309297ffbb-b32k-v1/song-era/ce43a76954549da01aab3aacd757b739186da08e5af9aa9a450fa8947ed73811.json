cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上成绝句呈刘伯声四首 其三","author":"张耒","text":"野岸北风归客愁，浮烟不动雨飕飕。\n围成野色萦纡岸，点破湖光三四鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上成绝句呈刘伯声四首 其二","author":"张耒","text":"风荡云容不成雪，柳偷春色放冲寒。\n湖边艇子冲烟去，天畔青山隔雨看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上成绝句呈刘伯声四首 其一","author":"张耒","text":"湖北风来吹晓钟，湖边渔客闭船篷。\n波光不动天光阔，更在浮烟细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登乘槎亭","author":"张耒","text":"海天秋雾暗乘槎，风响空山浪卷沙。\n杳杳橹声何处客，一帆冲雨暗天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊日步西园","author":"张耒","text":"三亩寒园春欲回，浅池低树忽飘梅。\n楚乡万里霜云尽，归雁行行斜日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月下旬偶作","author":"张耒","text":"岁暮烟霜泽国寒，晓鸦鸣处是柯山。\n地炉有火樽馀酒，自起焚香深掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月殊有春意二首 其二","author":"张耒","text":"拂槛垂杨雪后青，谁家朱阁晓来晴。\n拂帘动幕无人解，先把春愁寄有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月殊有春意二首 其一","author":"张耒","text":"一夜长风无片云，晓来风动似初春。\n应知春近催桃李，更有轻寒不著人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊初小雪后圃梅开二首 其二","author":"张耒","text":"晨起千林腊雪新，数枝云梦泽南春。\n一尘不染香到骨，姑射仙人风露身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊初小雪后圃梅开二首 其一","author":"张耒","text":"风格孤高又国香，故教小雪发新妆。\n修行嗟我无功力，却使天魔入道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢仲闵惠友于泉上多紫竹","author":"张耒","text":"地吉泉甘庆所钟，直疑遥与惠山通。\n曲肱烦暑都消尽，如卧萧萧紫竹风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢仲南和诗","author":"张耒","text":"曾约西湖薄主人，只今湖色已知春。\n会须多载连车酒，绝胜寒仓满目尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏心亭","author":"张耒","text":"楫迎桃叶家何处，桨送莫愁人已非。\n独立东风今古恨，春江无语又斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道彭泽","author":"张耒","text":"姓陶令尹今何在，空补陈编归去来。\n安得春江作春酒，百年长与子衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩信","author":"张耒","text":"登坛一日冠群雄，钟室仓皇念蒯通。\n能用能诛谁计策，嗟君终自愧萧公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩信祠","author":"张耒","text":"千金一饭恩犹报，南面称孤岂遽忘。\n何待陈侯乃中起，不思萧相在咸阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感春三首 其一","author":"张耒","text":"日长残雪滴高檐，院静人閒风度帘。\n可是岁华随日好，故应愁恨逐春添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感春三首 其三","author":"张耒","text":"梅梢柳眼弄春娇，云暖南山腊雪消。\n近郭樵渔成野市，远村箫鼓隔溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感春三首 其二","author":"张耒","text":"冰消水面波光动，日暖树梢花意归。\n世上繁华随日好，却应春浅胜芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感秋三绝 其三","author":"张耒","text":"高林败叶已飕飕，更有寒莎翠已收。\n若道神仙脱情累，如何独唱感庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春","author":"张耒","text":"水乡清冷落梅风，正月雪消春信通。\n昨夜园林新得雨，杏梢争放晓来红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新堂望樊山","author":"张耒","text":"幽人井臼两山间，邻里樵渔尽往还。\n兴发登临穷眼界，江南秀色碧云鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚王","author":"张耒","text":"十二巫山耸翠峦，楚王宫殿玉巑岏。\n定知为雨为云处，不似当初梦里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚城晓望","author":"张耒","text":"鼓角凌虚雉堞牢，晚天如鉴绝秋毫。\n山川摇落霜华重，风日晴明雁字高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚桥秋暮阻雨","author":"张耒","text":"水满城西钓艇横，云豪风弱晚冥冥。\n天寒小店人愁雨，灯暗孤舟客卧听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神功盛德诗 其一 神州","author":"华镇","text":"茫茫神州，有疆有理。\n歼殄豺虎，剪夷荆杞。\n人可以群，神获其祀，惟宣祖是畀。\n道有伦极，克建克叙。\n不丧厥猷，物有其纪。\n既污者隆，何千万年。\n施于孙子，惟宣祖所畀。\n其畀惟何，笃生真人。\n作之孔武，敏则有神。\n乃圣嗣德，益之以文。\n庆既令矣，克成厥勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其二","author":"张耒","text":"小园寒尽雪成泥，堂角方池水接溪。\n梦觉隔窗残月尽，五更春鸟满山啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福昌官舍后绝句十首 其七","author":"张耒","text":"洛川春色几时归，漾漾清流照翠微。\n日暖雪消沙岸软，鸳鸯相对不惊飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]