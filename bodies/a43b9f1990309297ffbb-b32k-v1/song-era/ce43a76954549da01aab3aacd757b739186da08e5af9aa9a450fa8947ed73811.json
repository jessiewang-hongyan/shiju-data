[{"title":"梅花 其六","author":"张耒","text":"三亩荒园草棘荒，可堪终夜北风狂。\n瑶环瑜珥谁将去，啧啧幽禽啄蕊黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其一","author":"张耒","text":"月落严霜自理妆，北风工为发清香。\n晓英数点辞人去，幽独无人为断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦至一园池藕花盛开水鸟飞鸣为作二小诗记之 其二","author":"张耒","text":"平池秋水雨来深，无数红妆出岸阴。\n翠幕深藏知有意，白鸥相见本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦至一园池藕花盛开水鸟飞鸣为作二小诗记之 其一","author":"张耒","text":"偶来乘兴不须疑，一顷秋香欲发时。\n老子婆娑真为尔，百回相见愧鸬鹚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦灵寿寺","author":"张耒","text":"客居有似鸿遵渚，鸿渚相看岂有情。\n何事春来频见梦，老僧谈笑起相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦周楚望","author":"张耒","text":"春风吹梦到淮南，一夕从容尽笑谈。\n睡觉始知经岁别，洛阳新柳已毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上观冰下","author":"张耒","text":"寒淮千里群冰下，古岸枯槎黄苇枝。\n忆得天津桥下见，五门春动雪消时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上晓望","author":"张耒","text":"酒醒窗明月半川，怯将病齿漱寒泉。\n楼西别有清秋色，一片淮山在晓烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮阴","author":"张耒","text":"芦梢林叶雨萧萧，独卧孤舟听楚谣。\n生计飘然一搔首，西风沙上趁归潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮阴晚望","author":"张耒","text":"萧萧衰柳来时路，袅袅危樯西去船。\n白鸟归飞夕阳尽，断霞风约过平川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮阴道中","author":"张耒","text":"映日断霞临水尽，出云新月向人来。\n野塘秋晚无行迹，点点黄花照水开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日舟中书事二首 其二","author":"张耒","text":"巢乌噪处绿杨村，寒食人家昼掩门。\n麦陇晓风收宿润，烟林午日涨黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日舟中书事二首 其一","author":"张耒","text":"清明不到旅人家，乞火邻船自试茶。\n弄柳好风低作舞，夹船春浪细浮花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竟陵酒官舍北有数步草岁寒霜落犹郁然也予为障其风霜暮冬尚自如一日大火焚舍无遗复往寻草不复有矣","author":"张耒","text":"为爱墙隅芳草色，故遮霜霰待新春。\n火烧雨洗寻无处，祇有东风吹旧尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竟陵梦野亭在子城西南角一目而尽云梦之野最为郡中之胜","author":"张耒","text":"高甍巨桷压城闉，平视如将七泽吞。\n几度春光招宋玉，碧阑干外独消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竟陵僦舍仍有小园景物颇佳","author":"张耒","text":"荒凉台阁追随事，懒慢江河放逐臣。\n应是主人怜寂寞，僦居仍有小园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章华","author":"张耒","text":"长恨章华亦陋夫，周秦仅可胜登徒。\n谁知南楚仍穷巷，骨像何妨自应图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧何","author":"张耒","text":"萧公俯仰系安危，功业君王心独知。\n犹道邵平能缓颊，君臣从古固多疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧萧","author":"张耒","text":"萧萧风雨五更初，枕上秋声独井梧。\n只有菊花犹灼灼，苦教摧拉就荒芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒蒋帝祠过钟山下二首 其二","author":"张耒","text":"溶溶野水戏凫鹥，垄麦初长午景迟。\n尽日绿杨閒照水，临风自爱好腰支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒蒋帝祠过钟山下二首 其一","author":"张耒","text":"野塘春水绿迢迢，上有东风弄柳条。\n晓日已穿东岭出，轻寒犹欲战驼毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒僧不值","author":"张耒","text":"古寺人閒僧掩扉，客来下马解尘衣。\n双松带月风蝉噪，古阁鸣钟夕鸟归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野步","author":"张耒","text":"带水依城一径微，出城桃杏雨来枝。\n最怜杨柳身无力，付与春风自在吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿邑道中","author":"张耒","text":"去岁秋时去，今年秋又来。\n浮名何所得，岁月苦相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州酒务税宿房北窗新种竹戏题于壁","author":"张耒","text":"异时小杜高眠地，几向秋风听楚江。\n身世浮云那可计，试留双竹守寒窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄葵","author":"张耒","text":"黄葵贵丽不妖娆，一朵新晴槛外高。\n还似迩英临便坐，曈眬朝日照天袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪走笔呈李宣城三首 其三","author":"张耒","text":"万夫饿腹待仓储，三户穷民守破圩。\n疲瘵不禁鞭挞甚，长官对酒且欢娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪走笔呈李宣城三首 其二","author":"张耒","text":"聒聒庭中争曲直，纷纷笔下判鞭笞。\n坐曹决事输归饮，须信薛宣称吏师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪走笔呈李宣城三首 其一","author":"张耒","text":"殷勤寄语宣城宰，公事何时是了时。\n病守欣然有嘉思，亦须对雪把空卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食","author":"张耒","text":"庭院轻寒新雨过，江城寒食野花飞。\n故园北望一千里，极目江枫客未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食日作二首 其二","author":"张耒","text":"朝寒却觉春衣薄，禅诵还将酒盏疏。\n落尽江城千树雪，门前杨柳已藏乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食日作二首 其一","author":"张耒","text":"荒山野水非吾土，寒食清明似去年。\n杨柳插门人竞笑，荆蛮不信子推贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食离白沙","author":"张耒","text":"莫惊客路已经年，尚有青春一半妍。\n试上芳堤望春野，万丝杨柳拂晴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食离白沙","author":"张耒","text":"花枝袅袅水溶溶，杨柳轻明二月风。\n景物可怜人寂寞，年年寒食醉眠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其八","author":"张耒","text":"笼灯到晓只微明，独拥单衾听雨声。\n葛幌竹床清过暑，萧然未觉负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其七","author":"张耒","text":"错落星河没半空，江城悲角五更风。\n幽人梦断西窗雨，背壁笼灯到晓红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其六","author":"张耒","text":"平晓春云失半山，濛濛小雨暗江干。\n寺楼倚遍消残醉，只有春愁伴薄寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其五","author":"张耒","text":"翠眉长好何曾损，寄语啼禽漫不閒。\n应为残春足愁恨，长疑蹙破镜中山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其三","author":"张耒","text":"病卧淮阳太昊城，牡丹丛畔过清明。\n那知春暮长江上，竹里招提听晓莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其四","author":"张耒","text":"江城梅子青时节，嫩紫夭红扫地无。\n修竹满山连草色，却烦林鸟劝提壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其二","author":"张耒","text":"道人钟梵久寂寞，倦客弭车聊静便。\n我亦云山閒衲子，平生香火旧因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓寺八首 其一","author":"张耒","text":"门外清泉浸稻畦，西南脩竹作城埤。\n川平林断空明处，却有遥山作翠眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓淮阳驿二首 其二","author":"张耒","text":"悠飏短日下西墙，庭叶吟风作夕凉。\n客枕甚安无一事，邻鸡不用唤朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓淮阳驿二首 其一","author":"张耒","text":"一庭秋色高堂夜，半壁灯光短幌凉。\n都是去年秋气味，谁知飘泊古淮阳。",