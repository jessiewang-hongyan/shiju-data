[{"title":"端砚六绝 其四","author":"陈宓","text":"一段无瑕真万金，临窗忽见洗尘心。\n中间方寸君知否，便是仙家绿绮琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端砚六绝 其三","author":"陈宓","text":"紫琼宜墨世间稀，合与韩公属好辞。\n若是只教誇染翰，献之难受属羲之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端砚六绝 其二","author":"陈宓","text":"忆昔先臣从武皇，最承天宠与恩光。\n孤儿白发虽图报，见著乌号泣数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端砚六绝 其六","author":"陈宓","text":"少年刻志好临池，老去方知大是痴。\n今日开奁聊一笑，暂时把玩似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横玉台","author":"陈宓","text":"横玉初登斗样台，倚栏一带雪花堆。\n儿时亲见前朝事，不忍春深载酒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王孙口致爽亭赓陈左史韵 其二","author":"陈宓","text":"谁结危亭碧玉堆，西山爽气唤仍回。\n岚光祇恐不堪著，更遣新诗勾引来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王孙口致爽亭赓陈左史韵 其一","author":"陈宓","text":"溪山一路送还迎，管领溪山有此亭。\n我为举杯相劳勉，他年端不负山灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题永石屏 其一","author":"陈宓","text":"琅玕三尺重南金，风韵仍同绿绮琴。\n胸次便如斯壁立，千年不受一尘侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题永石屏 其二","author":"陈宓","text":"谁将一段楚天碧，磨向崖心万仞馀。\n桥柱不题司马字，兰亭留待右军书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题玉井","author":"陈宓","text":"自昔高誇十丈莲，我今平步华峰巅。\n年来妄想驱除尽，不信人间是有仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题先陇","author":"陈宓","text":"去去音容远，冥冥岁月深。\n浑将溪作泪，莫尽一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题冰玉堂","author":"陈宓","text":"此是刘君处士家，茅檐犹想旧横斜。\n我今添著朱夫子，薄祀秋初荐水花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题延平张相公庙 其一","author":"陈宓","text":"想像孤忠尚凛然，古祠何止更千年。\n清标自是人难泯，不为区区一剑传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题延平张相公庙 其二","author":"陈宓","text":"匪躬尽瘁握机权，虽值时危亦晏然。\n况有式乾遗奏在，若教勇退更身全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题延平张相公庙 其三","author":"陈宓","text":"地下宝光犹解见，眼前天象却茫然。\n君恩自古难贪恋，乃父反输少子贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙寂寺","author":"陈宓","text":"老鹊呼檐人起早，华鲸催午日西迟。\n不因地迥稀尘事，那得冬阴似夏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙寂僧无碍明碧轩","author":"陈宓","text":"何处便宜养性情，禅床更著玉纵横。\n应是高人幽隐地，开轩远月迥双明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南康归宗寺","author":"陈宓","text":"山阴逸气追千古，不但挥毫一段奇。\n到此风流故无恙，游人休问旧来池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题高将仕墨梅","author":"陈宓","text":"玉质纵横黄绢外，春阳却自紫毫开。\n雨馀不共莓苔老，风暖暗勾蜂蝶来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清隐祠","author":"陈宓","text":"高标千载有谁攀，风雨祠堂尚一间。\n寄语当年詹令尹，吾今亦欲早归山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题隐居","author":"陈宓","text":"磐石疑溪月，茅檐潘竹风。\n琴尊随分有，夜夜主人公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 观鱼","author":"陈宓","text":"燕忙将水撇，鱼乐欲空跳。\n此意谁能会，光阴静里消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 流花桥","author":"陈宓","text":"春风事华侈，红紫逐香飘。\n水底从铺锦，还能似此桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅侍郎寒碧十五韵 梅坡","author":"陈宓","text":"江南开最蚤，犹及仲春时。\n此地先飞雪，多情却愿迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题湖堂长春风堂","author":"陈宓","text":"柯翰由来元气同，要须壮岁似儿童。\n君家友爱谁能比，一榻长如二月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠羽士","author":"陈宓","text":"独擅兹山四十年，凝之去后见君贤。\n羽衣时向云间去，为爱飞泉不肯仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林教谕","author":"陈宓","text":"囊中惟有圣贤书，宅是箪瓢陋巷图。\n我一见君先自愧，题诗归拟揭庭隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠枢上人","author":"陈宓","text":"心期极乐三千界，世事怀安二十年。\n顾我未能从学道，祇将寂寞当幽禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日寿外姑方氏","author":"陈宓","text":"九帙华龄开第一，画堂瑞气蔼葱葱。\n綵花宝胜年年好，绿鬓朱颜岁岁同。\n五福谁人如寿考，四时何日不春风。\n门阑应笑龙钟婿，作吏风尘□两翁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月八夕邀刘学录","author":"陈宓","text":"老来岁月去如流，佳节前期约共游。\n玉露尽驱三伏暑，银蟾堪□作中秋。\n交朋得暇频相过，身世须忘百不忧。\n尚有读书心未足，寒光凭为洗双眸。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十日同潘王游曾城和潘韵","author":"陈宓","text":"羌庐聚处秋将半，山色湖光翠映璃。\n河汉乘槎端可到，蓬壶跨海屹难移。\n织织天外知商舶，猎猎沙头见酒旗。\n欲豁尘襟须得月，题诗仍记共来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十七日窘雨邑中舟还","author":"陈宓","text":"行到青山欲尽头，穷源未省作溪游。\n轻云放日催人渡，积雨肥波送客舟。\n卧看玉簪迎两岸，心随绣领逐浮沤。\n眼前邂逅多堪赏，特地安排似此不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十八日景山同舟作别","author":"陈宓","text":"浓阴犹辨石粼粼，百尺浑疑到底冰。\n湍急宛乘银骑出，身轻直向碧霄凌。\n风前别酒能禁几，雨外征衣却惯曾。\n最是萧萧霜叶动，路回不见笋舆凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六至十九日雨未已","author":"陈宓","text":"一夜蛟龙怒虎炰，卧听檐溜不分交。\n拍天溪浦迷西极，万里耕耘尽乐郊。\n蛙黾无舟乘野外，寒鸦不笠待林梢。\n要看杲杲东方白，鱼自清波燕自巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月菊","author":"陈宓","text":"白玉三千界，黄金百万钱。\n虽迟九日后，却战一阳前。\n不愿游人看，仍疏酒盏边。\n天公岂无意，垂老更芳妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次刘学录韵","author":"陈宓","text":"八月川原旱欲然，季秋连雨顿澄鲜。\n明朝领客成无暇，七日登高不厌前。\n菡萏扫除如暑净，芙蓉绰约作春妍。\n佳人得得同来看，萸菊年年却懒搴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和刘学录","author":"陈宓","text":"千竿修碧净无尘，长伴先生自在身。\n万卷旧书中夜烛，满怀和气四时春。\n长年漱炼颜如玉，一字推敲句有神。\n请践往时渔艇约，夜深共话两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赓刘学录双莲韵","author":"陈宓","text":"亭亭玉立谢栽培，却笑凡花杂草莱。\n水面不教蜂蝶见，天边偏引鹭鸥来。\n化工岂是誇呈瑞，人意何须岂妄猜。\n并秀六房如可信，里中他日又公台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山送真景元","author":"陈宓","text":"盖世功名国子师，青春入觐道方夷。\n荣华素定终须有，事业难期便勇为。\n此日清尊同一笑，明朝丹陛听危词。\n东风总送仙舟去，杨柳江头谩似丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三贤堂和柯东海","author":"陈宓","text":"先后勋名百岁周，同堂耿耿夜光寒。\n片言已夺丹辽气，万世犹闻四谏官。\n殄虏机筹馀胆壮，佐时忠亮更胸蟠。\n不因品藻公舆论，得与前贤一样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上王侯重九前蠲不济寺债","author":"陈宓","text":"史君救弊知原本，民赖浮屠产力宽。\n保障便为今日计，功名留与百年看。\n喜闻白纸租都放，不饮黄花酒亦欢。\n晨起有人相贺语，禅斋得稳占蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上潘舍人 其二","author":"陈宓","text":"浙水人如大雅诗，唯君出句最能奇。\n腾声直欲骖鸾鹤，赤子犹思缚虎罴。\n览卷几年如旧识，忘年今日辱新知。\n漳滨尚许陪尊俎，想像梅花是玉姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上潘舍人 其一","author":"陈宓","text":"经行造次有新诗，吞吐珠玑不自奇。\n寸管久期窥变豹，深丛今幸见孤罴。\n高情陶谢犹能及，圣处阴何讵得知。\n乞与金丹换凡骨，飞遨祇恐乏仙姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上潘舍人德久 其一","author":"陈宓","text":"惭愧西湖处士身，强縻圭组向南闽。\n旌旗夹道浑闲物，句律横空别有神。\n严濑旧题追古昔，奚囊白首更清新。\n年来剩喜三回见，一代于今有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上潘舍人德久 其二","author":"陈宓","text":"气大词雄擅百家，长江衮衮见浮楂。\n襟怀有道颜长玉，谈笑为春物自花。\n飘逸大书追渴骥，联翩行字更飞鸦。\n夜陪馀论清肝胆，不羡乘风七碗茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与杨信斋","author":"陈宓","text":"半春积雨逗浓寒，陇亩都翻宿藁残。\n要得三秋□成熟，直须千里绝高乾。\n瘵疲悉振惭无力，租赋频蠲觉更难。\n赖有诗人知中意，佳篇时遣鄙怀宽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久不到流惠杨至之相访邀游杨以干亟归因呈之","author":"陈宓","text":"众峰奇秀四围旁，拥出千寻月样塘。\n只鹭双凫自来往，圆荷细草竞高长。\n密云带雨天应近，晚照酣春水自香。\n幸有家人来共看，如何也作簿书忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园送春","author":"陈宓","text":"一春强半尚无晴，有负渊明日涉名。\n莺粟已妆红叶艳，青梅尚觉荔枝生。\n可怜蜂蝶攀辕意，尚欲羲和反旆行。\n桃李不言流水畔，游人到此自多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"陈宓","text":"浅溪仍残照，山青更暮烟。\n人行罨画地，鸟度粉笺天。\n麦润先春秀，梅清破腊年。\n田家无力事，牛背落鸦眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居","author":"陈宓","text":"山深尘事绝，物静壮心降。\n蚁度轻移履，蜂迷为穴窗。\n霜晖疑皓月，风月类翻江。\n有客来何处，应寻居士庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中春","author":"陈宓","text":"袭人天气暄还冷，欲雨窗绡暗复明。\n山鸟喜晴乘屋语，野农侵晓荷锄耕。\n不须杯勺勾春思，幸有诗书惬此生。\n桃杏繁枝一回首，争如松竹伴秋清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋夕无月前两夕皆明","author":"陈宓","text":"四时丹桂年年好，万岁青娥个个妍。\n但看世人生与老，不愁玉兔缺仍圆。\n攻侵属国雪中节，巧趁鸱夷烟际船。\n我把清光贮胸次，从教飞辙碧宵缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予宰安溪日景山相访还山之兴浩不可留诗以送之","author":"陈宓","text":"经年不见意弥亲，来惬相思洗吏尘。\n陋邑苦难留上客，好山终是恋高人。\n同看腊底梅筠月，便想云间笋蕨春。\n此去书堂能几驿，诗筒莫惮往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云台梅盛开呈单丞立之","author":"陈宓","text":"两年骑马上云台，长是梅花烂漫开。\n未识明珠从海出，祇逢飞雪下天来。\n月移清影侵衣带，风送浮香入酒杯。\n珍重主人邀客意，忙中唤我此追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开禧丙寅春二十六日黄子功袭少任赵仲白同会转庵中夜以夜永烛花偏分韵赋诗乐甚时太守有游山之约不果","author":"陈宓","text":"有道襟怀鬓不华，笑谭物物总春花。\n挥毫要使钟张避，出句应知屈宋衙。\n今日相逢萍聚水，明朝各是客乘楂。\n坐中韶濩铿锵作，亦许狂吟杂俚哇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙寅五月三日陪真秘字留校理游鼓山一别二年适同游东观缅思旧游正以是日作诗以记之","author":"陈宓","text":"一时盛事擅南闽，惊世词宗幕府宾。\n今日恰同当日会，道山元是鼓山人。\n两年君几封囊上，百里予方束带新。\n岐路不同俱自勉，何年重此拂坚珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖有双莲之瑞赓潘瓜山韵","author":"陈宓","text":"积雨东湖久不游，清风忽送瑞香浮。\n初疑并咮鸾窥镜，元是同心友聚头。\n我已收身栖?亩，君看盛事擅闽瓯。\n从今有月皆佳夕，旋办轻舠溯碧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题缺","author":"陈宓","text":"诗跨唐人未数钱，定应妙思入风烟。\n才堪华国华宁老，句得惊人即是仙。\n世事但将酬一醉，侯封那可敌千篇。\n天葩况值春初到，蜂蝶纷纷看扑缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叶吉阳赴任中道而返作居思堂以自娱以诗赠之","author":"陈宓","text":"海山深处拥旌旗，六十红颜未是迟。\n千里行程中道返，百年心事几人知。\n近家园小堪娱目，插架书多足课儿。\n闲看好山忙作吏，主人得计祇缘思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冰山","author":"陈宓","text":"出自重阴地，来陈酷暑天。\n峥嵘真可仰，刻轹更成妍。\n气与骄阳敌，峰将太华肩。\n有人心计巧，直欲厄其巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吉溪见桃花","author":"陈宓","text":"山中开落不逢人，我为持杯一笑频。\n最喜绿阴成子早，却嫌红蕊折枝频。\n已勾蛱蝶轻遮雨，更约溪风细护春。\n万点武陵归去日，应无一叶到嚣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同林潘二先生登舟 其二","author":"陈宓","text":"何日长桥一酒船，蓑衣摆尽世间缘。\n乘风弄笛多莲夏，吹火烹鲈欲雪天。\n山际烟云来有底，湖中风月浩无边。\n细看造化浑无老，只有朱颜易得年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同林潘二先生登舟 其一","author":"陈宓","text":"暇日衣襟懒自船，扁舟不系任风缘。\n人间避暑疑无地，湖上乘凉别有天。\n鱼静不惊香饵下，花红偏称夕阳边。\n从今日日须来看，才隔秋风便数年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同柯东海出湖","author":"陈宓","text":"欲访西湖久未晴，故应穿屐踏泥行。\n不因世事无时尽，那识波光有底清。\n翠竹碧莲迷上下，雕栏画阁压峥嵘。\n扁舟正好频来买，烟景何人与子争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同喻景山游月湖","author":"陈宓","text":"兼旬不到月湖来，无数荷花雨里开。\n燕是旧知频绕栋，蝉如有意共衔杯。\n公庭兀坐虽无暇，佳友同携得几回。\n冒雨作闲成胜赏，儿童迎道任相咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因读鲁论赓潘丈韵","author":"陈宓","text":"八十年前一笔门，须将旧事与重论。\n幸承显考箕裘后，全赖宣尼典籍存。\n道统精微传舜禹，性原善恶辨杨孙。\n学由践履工夫入，敬义当稽六二坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平范子登同侄祖年见访惠诗次韵","author":"陈宓","text":"森森九桂植岩幽，所谓伊人在一洲。\n别后道尊君可慕，病馀学废我堪羞。\n雪惊新白传佳咏，云□残黄会晚秋。\n多谢联镳垂访意，疏慵犹可诲还不。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有赠鹿忽生麛承刘学录惠诗以韵谢之","author":"陈宓","text":"麀鹿方辞赠，秋来忽有麛。\n暂能娱市隐，终遣傍云栖。\n幽事渔樵诧，佳篇李杜齐。\n行看双挺角，未羡骇群鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次方云台韵","author":"陈宓","text":"泉石膏肓世欲忘，扁舟更溯寿湖光。\n也知他日持荷橐，不似闲时制芰裳。\n雨后尚馀新稻熟，风前偏觉荔枝香。\n人生有禄亲头白，万石何如宦本乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]