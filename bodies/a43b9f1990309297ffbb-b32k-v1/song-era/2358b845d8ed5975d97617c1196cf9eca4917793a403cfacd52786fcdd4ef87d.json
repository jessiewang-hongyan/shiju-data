[{"title":"送黄若虚下第归湖南","author":"韩驹","text":"时人会傍高门走，独肯来游翰墨场。\n已有哲兄如叔度，定知吾子胜文强。\n长淮白浪摇春枕，故国青山接夜航。\n乞得功名归遗母，未应深羡绿衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馆中直宿书事 其一","author":"韩驹","text":"十载名山惯杖藜，清都直宿梦魂疑。\n卧闻长乐钟声近，尚忆寒山半夜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馆中直宿书事 其二","author":"韩驹","text":"北风吹马袭貂裘，薄雪连云冻未收。\n银阙昼开禽鸟白，信知三馆是瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"走笔谢人送酒","author":"韩驹","text":"此身投老倦黄埃，傍水柴扉晚自开。\n百万愁城攻不破，正须从事斩关来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别馆中诸公","author":"韩驹","text":"暂谪人间去，群仙莫浪猜。\n尘缘吾未断，不是薄蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行至华阴呈旧同舍","author":"韩驹","text":"落日同骑款段游，倦依松石弄清流。\n蓬莱汉殿春分手，一笑相逢太华秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金粟堆","author":"韩驹","text":"少陵金粟堆前泪，叹息开元万事空。\n今日我来愁又绝，更无松竹鸟呼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人寄小胡孙","author":"韩驹","text":"致尔自何处，初来犹索腾。\n真宜少陵觅，未解柳州憎。\n婢喜常储果，奴嗔屡掣绳。\n报君无一物，试为斸寒藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中走笔留别杨将军","author":"韩驹","text":"山西老将尚童颜，曾臂红旗到贺兰。\n今日樽前惆怅别，梨花风雨一枝寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋曲江禁柳","author":"韩驹","text":"照水纤柯拂地明，东风初试舞腰轻。\n人间岂识长门恨，雾鬓烟鬟绾不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵思聪","author":"韩驹","text":"欲问琴聪水镜篇，朅来端为著幽禅。\n五更下马呼残梦，数面成亲似宿缘。\n伏脑怜君有犀骨，腾身笑我不鸢肩。\n白头奔走襄阳道，空诵新诗忆浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人寄茶筅子","author":"韩驹","text":"立玉干云百尺高，晚年何事困铅刀。\n看君眉宇真龙种，犹解横身战雪涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书二绝呈馆中旧同舍 其一","author":"韩驹","text":"去年看曝石渠书，内酒均颁白玉腴。\n今日醉登延阁望，几人回首忆穷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书二绝呈馆中旧同舍 其二","author":"韩驹","text":"御本曾看锦帕舒，醉惊飞阁上凌虚。\n而今卧病衡门底，自晒茆檐几卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题明皇上马图","author":"韩驹","text":"翠华欲幸长生殿，立马楼前待贵妃。\n尚觅君王一回顾，金鞍欲上故迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵倪巨济夏夜二首 其一","author":"韩驹","text":"慵便纱帽滑，病起葛衣轻。\n白露含花动，黄流带月清。\n思君开酒阵，是夕破愁城。\n但恐何平叔，常谈笑老生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵倪巨济夏夜二首 其二","author":"韩驹","text":"卧病京华客，尘缘种种轻。\n共谁倾盖旧，之子逼人清。\n笔倒三江水，诗专五字城。\n白头听讽诵，浑觉黑丝生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送苏世美东归 其一","author":"韩驹","text":"东游两见鹤林春，晚愧先生作并邻。\n樽俎每留仓猝客，典型犹识老成人。\n系舟一笑都门外，卖剑归耕颍水滨。\n意气年来类儿女，别离不觉泪横巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送苏世美东归 其二","author":"韩驹","text":"京口寻山每见携，鹤林问法更追随。\n本无物累那成癖，肯借人书未必痴。\n食粥往年容乞米，一樽今日细论诗。\n邗沟好去春风暖，莫忘椎冰共载时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵苏文饶待舟书事","author":"韩驹","text":"公才岂止剧曹郎，肯向明时氏庾仓。\n会有绫衾趋汉署，不须锦缆系吴樯。\n青箱教子书千卷，白发思亲天一方。\n看我飘然五湖去，栈羊筛酒送归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵苏彦师见寄","author":"韩驹","text":"长年眼力怯看书，每见先生愧腹虚。\n犹觉是身多净业，欲投禅客问真如。\n向来水驲分襟罢，常记河梁握手初。\n从此论交同毕杜，巷南巷北莫相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题万松亭 其一","author":"韩驹","text":"北窗攲枕雨濛濛，梦破青山落眼中。\n唤取隐居来此住，人间却有万松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题万松亭 其二","author":"韩驹","text":"老夫爱此摩云干，欲下黄冈尚据鞍。\n一疋犹无好东绢，凭谁貌出万松看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中绝句 其一","author":"韩驹","text":"浅黛依依临水笑，挼蓝脉脉抱山流。\n他年定作寒溪梦，梦载支郎雪满舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中绝句 其二","author":"韩驹","text":"野岸黄榆三万栽，枯根断处水容开。\n隋堤二月春如许，看取柔条拂面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中绝句 其三","author":"韩驹","text":"青罗带上玉花飞，不用天山一尺围。\n欲上钓船沙际宿，前旌何苦唤人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其一","author":"韩驹","text":"山居有幽事，小雪破梅心。\n的皪明阴壑，玲珑挂晚林。\n吹香撩远兴，弄影慰孤斟。\n剩欲留长在，霜枝半不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其二","author":"韩驹","text":"蒂是团青蜡，花非刻素纨。\n直言南雪少，犹自北枝寒。\n白发迟明折，清香带暝看。\n有情亭午日，慎莫苦摧残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其三","author":"韩驹","text":"的皪林间白，风霜莫浪催。\n江南春不雪，似是一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其四","author":"韩驹","text":"雪里寻梅蕊，多应傍水开。\n那知是花处，但觅暗香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其五","author":"韩驹","text":"江南岁晚雪漫漫，涧谷梅花巧耐寒。\n幸有幽香当供给，不辞三载滞西安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其六","author":"韩驹","text":"云根细路绕溪斜，日出烟销水见沙。\n只度关山魂已断，何须疏雨湿梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其七","author":"韩驹","text":"篮舆晓入关山路，玉节珠幡次第开。\n白发微官何用许，似怜身出道山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花八首 其八","author":"韩驹","text":"汉宫铅粉净无痕，蜡点寒梢水畔村。\n忍犯雪霜凌竹柏，尚凭风月吊兰荪。\n骚人折去清诗健，驿使持归旧典存。\n病眼浑惊春思早，一枝聊洗画图昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题申居士霅溪图","author":"韩驹","text":"霅溪居士买山图，碧玉峰前碧玉湖。\n中有一丘容我老，暮年居士肯分无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同赵发运游甘露寺","author":"韩驹","text":"皇华使者下沧洲，十载题舆记旧游。\n欲信随车翻雨脚，请看转漕跋船头。\n飞腾已入西清殿，徙倚犹寻北固楼。\n肯与故人跻石径，松风声里度鸣驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庚子年还朝饮酒六绝句 其二","author":"韩驹","text":"往时看曝石渠书，内酒均颁白玉腴。\n落魄十年无复醉，因公今日识官壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庚子年还朝饮酒六绝句 其三","author":"韩驹","text":"汉阁重来鬓已苍，故交强半上鹓行。\n鸣鞭送与黄封酒，似唤幽人入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庚子年还朝饮酒六绝句 其四","author":"韩驹","text":"爱酒渊明爱也无，无人为我著钱沽。\n起呼老瓦尝官酝，一炷寒灯夜自娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庚子年还朝饮酒六绝句 其五","author":"韩驹","text":"旧闻西国蒲萄酒，走送柴门不待求。\n饮罢愁城无处立，故应一斗直凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庚子年还朝饮酒六绝句 其六","author":"韩驹","text":"五侯池沼卷东风，酿作真珠滴小红。\n但怪外边春色晓，浓华都在沁园中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题韩干画马","author":"韩驹","text":"古画仍藏古锦囊，故人携得自瞿塘。\n僰僮莋马应羞见，羌户方调两骕骦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送海常化士 其一","author":"韩驹","text":"好去凌空锡杖飞，凤林关外道场稀。\n莫言衲子篮无底，盛取江南骨董归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送海常化士 其二","author":"韩驹","text":"钵囊空去莫言贫，会见吹毛本分人。\n乞得金多未为贵，归来著眼看家珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何文缜种竹","author":"韩驹","text":"杜陵穷老觅桤栽，不似何郎种笛材。\n三径莫忧荒草合，一樽如与故人开。\n未堪急雨枝枝打，便有幽禽日日来。\n坐诵东坡食无肉，诗肠日午转饥雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虞童子七岁能诵书部使者闻诸朝既至京师会更制不果试其归也以二小诗送之 其一","author":"韩驹","text":"七岁澜翻数万言，饥鹰引子望腾鶱。\n时平不用甘罗辈，寂寞提书归故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虞童子七岁能诵书部使者闻诸朝既至京师会更制不果试其归也以二小诗送之 其二","author":"韩驹","text":"不作西京童子郎，时人已自识黄香。\n还家更诵五千卷，十八重来诣太常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李希声馆中上元直宿","author":"韩驹","text":"海上飞来百尺山，三呼万岁亦迎銮。\n春连禁籞常年早，夜近清都特地寒。\n不见星桥开铁锁，似闻雷鼓落铜丸。\n起呵冻笔哦诗罢，月傍蓬莱汉阁残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王给事观殿试唱名 其一","author":"韩驹","text":"已对丹墀眼尚生，金茎晓露逼人清。\n非关董相三篇切，自是重华四目明。\n勇似风摧山岳势，罢如雷卷海波声。\n曾叨应奉宫门外，老去空惊岁籥更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王给事观殿试唱名 其二","author":"韩驹","text":"马革包尸誓此生，岂知今日塞尘清。\n强随举子论兵要，直为君王下诏明。\n老将犹能贾馀勇，少年未分怯先声。\n元戎十乘他时事，莫厌边亭夜报更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王给事观殿试唱名 其三","author":"韩驹","text":"漠漠春云晚自生，广寒宫里未为清。\n花深曲水潺湲出，柳暗长廊胧?明。\n月近频移鳷鹊影，庭空自乐鸟乌声。\n此时欲寄王摩诘，字字烦君子细更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王给事观殿试唱名 其四","author":"韩驹","text":"集英春殿唱诸生，日转觚棱晓色清。\n近侍皆分金带赤，内人争看雪衣明。\n罢朝诏赐群公坐，合殿欢传万岁声。\n我老倦随宫漏永，江南归去听鼍更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"先大夫元丰间及进士第荣州伯父喜而赋诗宣和四年信道兄登科某时为著作郎侍立集英殿与观唱名未几信道兄调而归某谨次伯父韵以送之","author":"韩驹","text":"坐看连名策太常，青云稳上不须忙。\n尽收骐骥无中驷，别拣楩楠有豫章。\n玉殿桂留今日影，琼林花记昔年香。\n闻君补吏成都去，更与重寻旧草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王左丞宣抚河北","author":"韩驹","text":"百里烟云堕目中，天戈直捣大槐宫。\n已烦宠数褒申伯，更遣羌戎识晋公。\n玉帐旌旗皆喜色，铁林鼓吹自春风。\n应磨万丈燕山石，独揽宣和第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臣?以御画鹊示臣某谨再拜稽首赋诗 其一","author":"韩驹","text":"君王妙画出神机，弱翅争巢并语时。\n想见春风鳷鹊观，一双飞占万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臣?以御画鹊示臣某谨再拜稽首赋诗 其二","author":"韩驹","text":"舍人簪笔上蓬山，辇路春风从驾还。\n天上飞来两乌鹊，为传喜色到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送权师谒蒋山华藏二长老","author":"韩驹","text":"祇园寺里长连榻，衲被蒙头坐五年。\n忽忆山中有尊宿，欲来言下觅真诠。\n萧萧野店云生钵，渺渺江津月入船。\n一段孤湖千里去，不知何事苦参禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送聪师往蜀中乞钱","author":"韩驹","text":"早学汤休句，中参鲁祖禅。\n举花曾有省，持钵尚随缘。\n雪满商山屦，风号灞水船。\n谁怜功行苦，乞与一囊钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵馆中上元游葆真宫观灯 其二","author":"韩驹","text":"玉作芙蕖院院明，博山香度小峥嵘。\n直言水北人稀到，也有槃姗勃窣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵馆中上元游葆真宫观灯 其三","author":"韩驹","text":"鸭绿未全生曲沼，鹅黄先已上柔柯。\n故应春物撩诗思，白发明朝一倍多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵馆中上元游葆真宫观灯 其四","author":"韩驹","text":"开卷爱公如李益，解言明月逐人来。\n多情如共春流转，刻烛题诗又一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵馆中上元游葆真宫观灯 其五","author":"韩驹","text":"澹澹新妆带浅啼，催车只待日平西。\n骅骝也自知人意，散入千花了不嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过左掖门马上口占","author":"韩驹","text":"十载扁舟自在闲，帝城春物不相关。\n却因久住蓬莱阁，赢得年年看绿山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜀僧法聪率然叩门乞诗送行","author":"韩驹","text":"去蜀且万里，寻师踰十年。\n初犹学搜句，老渐欲参禅。\n晏坐蒲团破，游方草屦穿。\n还家何所得，笑上峡中船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"申应时卜居京口名之曰云栖又曰小筑乞诗送行 其一","author":"韩驹","text":"客舍秋来忆旧居，一帆归去落东吴。\n他年寄我新诗句，即是云栖小筑图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"申应时卜居京口名之曰云栖又曰小筑乞诗送行 其二","author":"韩驹","text":"不分西津亭下石，二年输与白鸥眠。\n而今更恨申居士，占断旁边著钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故枢密郑公挽词 其一","author":"韩驹","text":"旧德凋零尽，惟公尚典型。\n遂无宣室对，徒有景钟铭。\n志欲兼三代，文皆刺六经。\n何由瞻傅说，但觅泰阶星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故枢密郑公挽词 其二","author":"韩驹","text":"义苑曾深入，词源更力探。\n经纶黄阁再，宥密紫枢三。\n盛德今谁似，高名古所惭。\n伤心旧宾客，望哭府潭潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故枢密郑公挽词 其三","author":"韩驹","text":"忆昔平原客，曾叨十九人。\n怀沙正愁苦，负土更悲辛。\n册府三年滞，枢庭一见新。\n今来挥涕泪，为国惜良臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何文缜舍人后省致斋","author":"韩驹","text":"夜直沉沉浴殿南，春风想对百花潭。\n藤床转枕寻馀梦，粉壁题诗倚半酣。\n追记旧游时一笑，劝参真理莫多谈。\n白头粗试丝纶手，归去扶犁意亦甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故正议李公挽词 其一","author":"韩驹","text":"内阁论思密，西班步武清。\n谁无子隆贵，独被主恩荣。\n带曳黄金重，鞍飞白玉轻。\n旧时行乐地，箫鼓入佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故正议李公挽词 其二","author":"韩驹","text":"昔在昭文馆，从公侍赭袍。\n笑谈倾盖旧，风采照人高。\n便欲参藜杖，那知奠浊醪。\n不堪西北望，松柏暮风号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]