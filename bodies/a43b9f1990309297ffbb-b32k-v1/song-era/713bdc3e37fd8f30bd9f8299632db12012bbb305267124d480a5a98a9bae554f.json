[{"title":"病起自嘲","author":"释智圆","text":"林下羸羸一病躯，四旬攲枕减肌肤。\n闲来试照秋泉看，金镀形容雪染须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读元结文","author":"释智圆","text":"复古还淳元结文，可怜杨浚独知君。\n当时自号为聱叟，立事垂言信不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读毛诗","author":"释智圆","text":"夫子删来三百章，箴规明白佐时王。\n近来吟咏唯风月，谤木诗官事久亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读王通中说","author":"释智圆","text":"孟轲荀况与杨雄，代异言殊道一同。\n夫子文章天未丧，又于隋世产王通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读孙合集","author":"释智圆","text":"唐祚将亡王泽枯，四明归隐泣穷涂。\n而今若撰才名志，更有闲僧得入无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读杨子法言","author":"释智圆","text":"秦焚汉杂道何孤，荡荡皇风岂易图。\n空有法言为世范，不知来者肯行无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读罗隐诗集","author":"释智圆","text":"非非是是正人伦，月夜花朝几损神。\n薄俗不知惩劝旨，翻嫌罗隐一生嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读项羽传二首 其二","author":"释智圆","text":"发叹虞姬势已穷，乌江此夕丧英雄。\n当时若也知天命，佐汉应居第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读项羽传二首 其一","author":"释智圆","text":"频年战胜恃雄强，历数分明在彼苍。\n堪笑范增无异识，不能令主事高皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读禅月集","author":"释智圆","text":"属兴难忘水与山，救时箴戒出其间。\n读终翻恨吾生晚，不得斯人一往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄远","author":"释智圆","text":"洞房秋晚更思君，宝瑟慵弹日又曛。\n雁过长空书不到，满庭黄叶落纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将之霅溪寄别择梧师","author":"释智圆","text":"忆得凉宵宿上方，静吟闲话趣何长。\n别来音信无由寄，目断遥天雁一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄瑞应经疏及注阴符经与体元上人","author":"释智圆","text":"瑞应阴符尽索看，封题欲寄意盘桓。\n自惭才识非通敏，不得同归得异端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题终南道宣律师塔","author":"释智圆","text":"冷碧终南插太虚，纻麻兰若旧闲居。\n波离灭后无人继，萧索西风叶满渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题章安禅师塔","author":"释智圆","text":"祖师坟塔在天台，雨坏风摧事可哀。\n香火无人空有迹，夜深明月照苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤","author":"释智圆","text":"微虫禀质有清光，踪迹难令暗室藏。\n车胤死来人堕学，秋庭终夜恣飞翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上闲坐","author":"释智圆","text":"终日湖亭坐，悠悠万虑闲。\n眼前何所有，寒水与秋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上望月二首 其二","author":"释智圆","text":"寒光皎皎映平湖，水色天形两不殊。\n学道未能同罔象，也于深处见圆珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上望月二首 其一","author":"释智圆","text":"秋水澄澄树绝风，冰轮苒苒上遥空。\n闲思今夜供吟景，冷色清光几处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十","author":"释智圆","text":"留心俭让唐虞道，恣意贪求桀蹠徒。\n闲坐思量茆屋下，夜深秋月照平湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十三","author":"释智圆","text":"伯阳道德释迦心，夫子文章尽可寻。\n饱食暖衣都不顾，可怜容易过光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其二","author":"释智圆","text":"看云静放支公鹤，临水闲观惠子鱼。\n窗下寂寥何所有，竺乾经卷仲尼书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其五","author":"释智圆","text":"凤为时瑞世传名，及现郊村众尽惊。\n唤作怪禽宜弹杀，始知流俗重虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其三","author":"释智圆","text":"闲庭庭畔植梧桐，上有新蝉噪晚风。\n咽咽清音正堪听，无端惊断彼儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十五","author":"释智圆","text":"月照闲轩亏复盈，吉凶消长势相倾。\n须知人事同天道，宠辱由来尽可惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其七","author":"释智圆","text":"尼父立言敦礼乐，能仁垂训励慈悲。\n堪嗟世路营营者，狡佞贪残都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十六","author":"释智圆","text":"草堂闲坐念编民，多尚浮虚少尚真。\n礼让不修难致福，唯知烧纸祭淫神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其八","author":"释智圆","text":"不省浮生大患身，谄求终日走红尘。\n一朝死至名随没，满屋黄金属别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十七","author":"释智圆","text":"阴阳家说惑常民，孝道从兹尽失伦。\n庐墓三年谁肯也，竞谈冈势益生人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其六","author":"释智圆","text":"直木风摧秋败兰，闲观庭际可长叹。\n屈原溺水伍员死，孤洁由来独立难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十八","author":"释智圆","text":"福善祸淫言可信，吉凶由己语堪陈。\n乖仁背义都无耻，只记临行拣日辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其九","author":"释智圆","text":"猛虎磨牙踞荫林，幽幽一路晚烟深。\n行行君子休疑惧，此物由来食兽心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十一","author":"释智圆","text":"兰在深林亦自馨，岂因风雨阻鸡鸣。\n由来君子须谋道，不为时人有重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其四","author":"释智圆","text":"移得烟溪竹数竿，闲庭栽处绿阴寒。\n虚心高节真堪爱，不放常人暂入看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十二","author":"释智圆","text":"白犬宵行似有情，为防暴客到天明。\n近来守禦无功绩，不吠人形只吠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其一","author":"释智圆","text":"湖波冷淡绝纤尘，满目云山是四邻。\n一径草深人不到，竹床蒲扇养天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其二十","author":"释智圆","text":"凿得新泉古砌头，煮茶滋味异常流。\n夜来闲看澄明性，天上无云月正秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十四","author":"释智圆","text":"雪晴山院景堪跻，玉树琼楼照碧溪。\n日暮忽惊销烁尽，百年豪富事还齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖西杂感诗 其十九","author":"释智圆","text":"静思尘世事茫茫，策杖闲吟出草堂。\n欲喻浮生那远觅，芭蕉昨夜已经霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花","author":"释智圆","text":"花开花落尽由风，数日荣衰事不同。\n庭下晚来犹可玩，绿苔芳草缀残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢仁上人惠茶","author":"释智圆","text":"寄我山茶号雨前，斋馀闲试仆夫泉。\n睡魔遣得虽相感，翻引诗魔来眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢僧惠蒲扇","author":"释智圆","text":"结蒲为扇状何奇，助我淳风世罕知。\n林下静摇来客笑，竹床茆屋恰相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新栽竹","author":"释智圆","text":"傍砌疏篁手自栽，数竿苍翠胜花开。\n今宵窗下更深睡，应送寒声枕上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪居即事寄梵天阇梨","author":"释智圆","text":"松竹森森独掩扉，尘中谁复爱忘机。\n苍苔满砌无人到，犹感幽禽夜夜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬简上人见寄","author":"释智圆","text":"林间病卧懒逢迎，相识何人最惬情。\n唯有简公闲且僻，寂寥翻被俗流轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槛猿","author":"释智圆","text":"异果供餐金锁缠，侯门虽贵性非便。\n夜啼只忆巴江畔，霜木千株冷倚天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲写真","author":"释智圆","text":"泡幻吾身元是妄，丹青汝影岂为真。\n吾身汝影俱无实，相伴茆堂作两人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠广上人","author":"释智圆","text":"魏阙林泉趣本同，随缘来往兴何穷。\n闲宵访我茆堂宿，湖水无波月照空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月望夜招处士林君泛湖玩月","author":"释智圆","text":"病负中秋约，残秋月自新。\n寒波沈皓魄，碧落辗冰轮。\n风静砧声绝，烟收岳影均。\n何妨此夕玩，况是不羁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上钱唐太守薛大谏","author":"释智圆","text":"分符江郡远，贵列七人间。\n文古淳风在，时清谏笔闲。\n楼高喧暮角，厅冷锁秋山。\n圣代期调鼎，轩车即诏还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与友人夜话","author":"释智圆","text":"对坐当清夜，茆堂野水西。\n破窗秋烛冷，高木老猿啼。\n迹与孤云并，身将一梦齐。\n幽怀言未已，明月落前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久病","author":"释智圆","text":"五月茆堂卧，穷秋疾未除。\n乔林叶尽落，旧识分皆疏。\n讲室萦蛛网，书床长蠹鱼。\n医王有妙药，饮了万缘虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久病有感因示后学","author":"释智圆","text":"羸病身未死，轻安人屡亡。\n穹旻不可问，浮世转加伤。\n三十共嗟短，百年同好长。\n未能齐一梦，何以事空王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中寻羽客不遇","author":"释智圆","text":"杖藜寻隐迹，重叠过林泉。\n花暖幽禽语，堂空瑞兽眠。\n涧松寒有韵，茶灶冷无烟。\n知在何峰顶，高谈会列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中闻知己及第","author":"释智圆","text":"交知心莫逆，出处任相违。\n月里方攀桂，山中自采薇。\n致君期有术，遁世贵无机。\n华发他年事，云泉亦可归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中感友生见访","author":"释智圆","text":"讲馀多滞疾，林下掩重扉。\n度日人稀到，残阳鸟独归。\n山光来有势，云影去何依。\n世态那堪说，唯君念息机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"释智圆","text":"策杖乘闲兴，山深人迹稀。\n断桥摧宿雨，高树挂残晖。\n岩静云孤起，潭空鸟独飞。\n前峰有兰若，吟赏自忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居偶成","author":"释智圆","text":"世上諠哗耳不闻，烟萝深处绝人群。\n岁寒弗改怜高柏，舒卷无机爱白云。\n闲采药苗医故疾，旋编红叶写新文。\n有人来问居山意，寂寂茆堂日又曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山堂落成招林处士","author":"释智圆","text":"搆厦当高巘，登临称遁仙。\n澄波寒浸郭，叠翠冷支天。\n野艇浮残照，僧楼袜淡烟。\n此中无俗物，自可会清贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书久上人城中幽斋","author":"释智圆","text":"杉竹匝吟径，轩窗更绝尘。\n清风生后夜，幽景遍诸邻。\n磬断栖禽梦，香凝出定身。\n城中有高趣，宁羡赖留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书山中道士壁","author":"释智圆","text":"松下消摇自扣扉，相留终日话真机。\n烟藏花岛青牛卧，客散仙房独鹤归。\n丹井泉澄天影小，玉坛风冷磬声微。\n乘闲拟学冲霄术，九土茫茫得者稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书友人壁","author":"释智圆","text":"不问人间事，连年鸟外居。\n白云吟次见，青壁醉来书。\n扫石秋苔駮，开窗夜月虚。\n于时已无念，生计有樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀","author":"释智圆","text":"一锡任西东，孤怀孰与同。\n吟髭潜变白，人事旋成空。\n秋阁闲看月，寒窗卧听鸿。\n时将寂寥意，深夜寄丝桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书林处士壁","author":"释智圆","text":"高迹远城市，湖山景色奇。\n水声喧睡榻，岚气逼书帷。\n鸟语垂轩竹，鱼惊浸月池。\n蒲轮来有日，终负白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书通上人城居","author":"释智圆","text":"禅房萧洒闭重关，祖意明来万事闲。\n高卧有时消白日，静吟无念忆青山。\n扫花晚砌留苍藓，剃发秋池照病颜。\n堪笑林泉深隐者，不知幽趣在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人元敏示以三题乃赓而和之 其二 刮字刀","author":"释智圆","text":"质本精刚化，锋铓岂易群。\n未曾伤正典，长为铲讹文。\n类与铅刀异，名将彩笔分。\n删书及定礼，曾忝立奇勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人元敏示以三题乃赓而和之 其三 试金石","author":"释智圆","text":"真伪立可辨，贞姿号试金。\n虽无褒贬口，似有是非心。\n采取山溪远，缄藏箧笥深。\n矿人如未诀，终日自相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人元敏示以三题乃赓而和之 其一 挑灯杖","author":"释智圆","text":"裁制削青筠，纤纤状可珍。\n助灯虽有力，举用实由人。\n破暗如无怠，资明敢顾身。\n窗间傥勤学，终夕愿相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆南塔上方因寄庆昭师","author":"释智圆","text":"杉竹森森一径通，六年高院寄幽踪。\n凉移峭壁秋深月，冷映长江雪后峰。\n吟次夏云晴影薄，讲残春树翠阴浓。\n四时嘉景真堪爱，曾伴支公数倚筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水","author":"释智圆","text":"本性澄明万古同，滔滔润物信无穷。\n百川奔注归沧海，五服安居赖禹功。\n动带晚风冲岛屿，静涵秋色混虚空。\n浮舟葬骨成何事，范蠡知机伍相忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风","author":"释智圆","text":"造化不可测，分明有所依。\n冷和秋叶动，送客暮帆归。\n扫雾离遥岳，飘香出静扉。\n西斋独吟坐，萧飒满禅衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失鹤","author":"释智圆","text":"只鹤忽飞去，清音更不闻。\n远应寻凤侣，闲恐避鸡群。\n岸静休临水，庭空罢舞云。\n唯馀旧踪迹，篆字印苔纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪","author":"释智圆","text":"冷结平湖绝棹过，纷纷盈目趣如何。\n侯门歌舞看难足，编户饥寒心厌多。\n旋满闲庭誇玉砌，重攲幽树斗琼柯。\n夜来孤坐书窗下，犹赖虚明自琢磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉武帝","author":"释智圆","text":"酷矣秦皇灭，荒哉汉武还。\n将军封五利，神药访三山。\n重色为金屋，穷兵过玉关。\n岂知尧舜道，千古在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白发","author":"释智圆","text":"华发如春卉，森森易满头。\n栽培全仗老，浇灌半凭愁。\n世态谁能避，仙方莫漫求。\n回观短折者，欲见更无由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]