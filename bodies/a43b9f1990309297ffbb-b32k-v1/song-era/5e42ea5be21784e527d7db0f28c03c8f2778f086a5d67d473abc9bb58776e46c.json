[{"title":"子玉家宴，用前韵见寄，复答之","author":"苏轼","text":"自酌金樽劝孟光，更教长笛奏伊、凉。\n牵衣男女绕太白，扇枕郎君烦阿香。\n诗病逢春转深痼，愁魔得酒暂奔忙。\n醒时情味吾能说，日在西南白草冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景纯复以二篇，一言其亡兄与伯父同年之契，一言今者唱酬之意，仍次其韵 其一","author":"苏轼","text":"灵寿扶来似孔光，感时怀旧一悲凉。\n蟾枝不独同攀桂，鸡舌还应共赐香。\n等是浮休无得丧，粗分忧乐有闲忙。\n年来世事如波浪，郁郁谁知柏在冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景纯复以二篇，一言其亡兄与伯父同年之契，一言今者唱酬之意，仍次其韵 其二","author":"苏轼","text":"屡把铅刀齿步光，更遭华衮照厖凉。\n苏门山上莫长啸，薝卜林中无别香。\n烛烬已残终夜刻，槐花还似昔年忙。\n背城借一吾何敢，慎莫樽前替戾冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳氏二外甥求笔迹二首 其一","author":"苏轼","text":"退笔如山未足珍，读书万卷始通神。\n君家自有元和脚，莫厌家鸡更问人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳氏二外甥求笔迹二首 其二","author":"苏轼","text":"一纸行书两绝诗，遂良须鬓已成丝。\n何当火急传家法，欲见诚悬笔谏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都进士杜暹伯升，出家，名法通，往来吴中","author":"苏轼","text":"欲识当年杜伯升，飘然云水一孤僧。\n若教俯首随缰锁，料得如今似我能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子玉以诗见邀，同刁丈游金山","author":"苏轼","text":"君年甲子未相逢，难向人前说老翁。\n更有方瞳八十一，奋衣矍铄走山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山寺与柳子玉饮，大醉，卧宝觉禅榻，夜分方醒，书其壁","author":"苏轼","text":"恶酒如恶人，相攻剧刀箭。\n颓然一榻上，胜之以不战。\n诗翁气雄拔，禅老语清软。\n我醉都不知，但觉红绿眩。\n醒时江月堕，摵摵风响变。\n惟有一龛灯，二豪俱不见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送柳子玉赴灵仙","author":"苏轼","text":"世事方艰便猛回，此心未老已先灰。\n何时梦入真君殿，也学传呼观主来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监洞霄宫俞康直郎中所居四咏 其一 退圃","author":"苏轼","text":"百丈休牵上濑船，一钩归钓缩头鳊。\n园中草木春无数，只有黄杨厄闰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监洞霄宫俞康直郎中所居四咏 其二 逸堂","author":"苏轼","text":"新第谁来作并邻，旧官宁复忆星辰。\n请君置酒吾当贺，知向江湖拜散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监洞霄宫俞康直郎中所居四咏 其三 遁轩","author":"苏轼","text":"冠盖相望起隐沦，先生那得老江村。\n古来真遁何曾遁，笑杀踰垣与闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"监洞霄宫俞康直郎中所居四咏 其四 远楼","author":"苏轼","text":"西山烟雨捲疏帘，北户星河落短檐。\n不独江天解空阔，地偏心远似陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游鹤林、招隐二首 其一","author":"苏轼","text":"郊原雨初霁，春物有馀妍。\n古寺满修竹，深林闻杜鹃。\n睡馀柳花堕，目眩山樱然。\n西窗有病客，危坐看香烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游鹤林、招隐二首 其二","author":"苏轼","text":"行歌白云岭，坐咏修竹林。\n风轻花自落，日薄山半阴。\n涧草谁复识，闻香杳难寻。\n时见城市人，幽居惜未深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书普慈长老壁","author":"苏轼","text":"普慈寺后千竿竹，醉里曾看碧玉椽。\n倦客再游行老矣，高僧一笑故依然。\n久参白足知禅味，苦厌黄公聒昼眠。\n惟有两珠红百叶，晚来犹得向人妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刁景纯席上和谢生二首 其一","author":"苏轼","text":"误入仙人碧玉壶，一欢那复问亲疏。\n杯盘狼藉吾何敢，车骑雍容子甚都。\n此夜新声闻北里，他年故事记南徐。\n欲穷风月三千界，愿化天人百亿躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刁景纯席上和谢生二首 其二","author":"苏轼","text":"纵饮谁能问挈壶，不知门外晓星疏。\n绮罗胜事齐三阁，宾主谈锋敌两都。\n榻畔烟花尝叹杜，海中童丱尚追徐。\n无多酌我君须听，醉后粗狂胆满躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏州太守王规父侍太夫人观灯之什，余时以刘道原见访，滞留京口，不及赴此会，二首 其一","author":"苏轼","text":"不觉朱轓辗后尘，争看绣幰锦缠轮。\n洛滨侍从三人贵，京兆平反一笑春。\n但逐东山携妓女，那知后阁走穷宾。\n滞留不见荣华事，空作赓诗第七人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏州太守王规父侍太夫人观灯之什，余时以刘道原见访，滞留京口，不及赴此会，二首 其二","author":"苏轼","text":"翻翻缇骑走香尘，激激飞涛射火轮。\n美酒留连三夜月，丰年倾倒五州春。\n安排诗律追强对，蹭蹬归期为恶宾。\n堕珥遗簪想无限，华胥犹见梦回人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书焦山纶长老壁","author":"苏轼","text":"法师住焦山，而实未尝住。\n我来辄问法，法师了无语。\n法师非无语，不知所答故。\n君看头与足，本自安冠屦。\n譬如长鬣人，不以长为苦。\n一旦或人问，每睡安所措。\n归来被上下，一夜无著处。\n展转遂达晨，意欲尽镊去。\n此言虽鄙浅，故自有深趣。\n持此问法师，法师一笑许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别金山宝觉、圆通二长老","author":"苏轼","text":"沐罢巾冠快晚凉，睡馀齿颊带茶香。\n舣舟北岸何时渡，晞发东轩未肯忙。\n康济此身殊有道，医治外物本无方。\n风流二老长还往，顾我归期尚渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常润道中，有怀钱塘，寄述古五首 其一","author":"苏轼","text":"从来直道不辜身，得向西湖两过春。\n沂上已成曾点服，泮宫初采鲁侯芹。\n休惊岁岁年年貌，且对朝朝暮暮人。\n细雨晴时一百六，画船鼍鼓莫违民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常润道中，有怀钱塘，寄述古五首 其二","author":"苏轼","text":"草长江南莺乱飞，年来事事与心违。\n花开后院还空落，燕入华堂怪未归。\n世上功名何日是，樽前点检几人非。\n去年柳絮飞时节，记得金笼放雪衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常润道中，有怀钱塘，寄述古五首 其三","author":"苏轼","text":"浮玉山头日日风，涌金门外已春融。\n二年鱼鸟浑相识，三月莺花付与公。\n剩看新翻眉倒晕，未应泣别脸消红。\n何人织得相思字，寄与江边北向鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常润道中，有怀钱塘，寄述古五首 其四","author":"苏轼","text":"国艳夭娆酒半酣，去年同赏寄僧檐。\n但知扑扑晴香软，谁见森森晓态岩。\n谷雨共惊无几日，蜜蜂未许辄先甜。\n应须火急回征棹，一片辞枝可得黏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常润道中，有怀钱塘，寄述古五首 其五","author":"苏轼","text":"惠泉山下土如濡，阳羡溪头米胜珠。\n卖剑买牛吾欲老，杀鸡为黍子来无。\n地偏不信容高盖，俗俭真堪著腐儒。\n莫怪江南苦留滞，经营身计一生迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常州太平寺观牡丹","author":"苏轼","text":"武林千叶照观空，别后湖山几信风。\n自笑眼花红绿眩，还将白首对鞓红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游太平寺净土院，观牡丹中有淡黄一朵，特奇，为作小诗","author":"苏轼","text":"醉中眼缬自斓斑，天雨曼陀照玉盘。\n一朵淡黄微拂掠，鞓红、魏紫不须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杭州牡丹开时，仆犹在常、润，周令作诗见寄，次其韵，复次一首送赴阙 其一","author":"苏轼","text":"羞归应为负花期，已见成阴结子时。\n与物寡情怜我老，遣春无恨赖君诗。\n玉台不见朝酣酒，金缕犹歌空折枝。\n从此年年定相见，欲师老圃问樊迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杭州牡丹开时，仆犹在常、润，周令作诗见寄，次其韵，复次一首送赴阙 其二","author":"苏轼","text":"莫负黄花九日期，人生穷达可无时。\n十年且就三都赋，万户终轻千首诗。\n天静伤鸿犹戢翼，月明惊鹊未安枝。\n君看六月河无水，万斛龙骧到自迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无锡道中赋水车","author":"苏轼","text":"翻翻联联衔尾鸦，荦荦确确蜕骨蛇。\n分畴翠浪走云阵，刺水绿针抽稻芽。\n洞庭五月欲飞沙，鼍鸣窟中如打衙。\n天公不见老翁泣，唤取阿香推雷车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘寺","author":"苏轼","text":"入门无平田，石路细穿岭。\n阴风生涧壑，古木翳潭井。\n湛卢谁复见，秋水光耿耿。\n铁花绣岩壁，杀气噤蛙黾。\n幽幽生公堂，左右立顽矿。\n当年或未信，异类服精猛。\n胡为百岁后，仙鬼互驰骋。\n窈然留清诗，读者为悲哽。\n东轩有佳致，云水丽千顷。\n熙熙览生物，春意破凄冷。\n我来属无事，暖日相与永。\n喜鹊翻初旦，愁鸢蹲落景。\n坐见渔樵还，新月溪上影。\n悟彼良自咍，归田行可请。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘孝叔会虎丘，时王规父斋素祈雨，不至，二首 其一","author":"苏轼","text":"白简威犹凛，青山兴已浓。\n鹤闲云作氅，驼卧草埋峰。\n跪屦若可教，卜邻应见容。\n因公问回老，何处定相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘孝叔会虎丘，时王规父斋素祈雨，不至，二首 其二","author":"苏轼","text":"太常斋未解，不肯对纤秾。\n只遣三千履，来游十二峰。\n林空答清唱，潭净写衰容。\n归去瑶台路，还应月下逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏州闾丘、江君二家，雨中饮酒，二首 其一","author":"苏轼","text":"小圃阴阴遍洒尘，方塘潋潋欲生纹。\n已烦仙袂来行雨，莫遣歌声便驻云。\n肯对绮罗辞白酒，试将文字恼红裙。\n今宵记取醒时节，点滴空阶独自闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏州闾丘、江君二家，雨中饮酒，二首 其二","author":"苏轼","text":"五纪归来鬓未霜，十眉环列坐生光。\n唤船渡口迎秋女，驻马桥边问泰娘。\n曾把四弦娱白傅，敢将百草斗吴王。\n从今却笑风流守，画戟空凝宴寝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵沈长官三首 其一","author":"苏轼","text":"家山何在两忘归，杯酒相逢慎勿违。\n不独饭山嘲我瘦，也应糠覈怪君肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵沈长官三首 其二","author":"苏轼","text":"男婚已毕女将归，累尽身轻志莫违。\n闻道山中食无肉，玉池清水自生肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵沈长官三首 其三","author":"苏轼","text":"造物知吾久念归，似怜衰病不相违。\n风来震泽帆初饱，雨入松江水渐肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏书吴江三贤画像三首 其一","author":"苏轼","text":"谁将射御教吴儿，长笑申公为夏姬。\n却遣姑苏有麋鹿，更怜夫子得西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏书吴江三贤画像三首 其二","author":"苏轼","text":"浮世功劳食与眠，季鹰真得水中仙。\n不须更说知机早，直为鲈鱼也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏书吴江三贤画像三首 其三","author":"苏轼","text":"千首文章二顷田，囊中未有一钱看。\n却因养得能言鸭，惊破王孙金弹丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过永乐文长老已卒","author":"苏轼","text":"初惊鹤瘦不可识，旋觉云归无处寻。\n三过门间老病死，一弹指顷去来今。\n存亡惯见浑无泪，乡井难忘尚有心。\n欲向钱塘访圆泽，葛洪川畔待秋深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安平泉","author":"苏轼","text":"策杖徐徐步此山，拨云寻径兴飘然。\n凿开海眼知何代，种出菱花不计年。\n烹茗僧誇瓯泛雪，炼丹人化骨成仙。\n当年陆羽空收拾，遗却安平一片泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张刁二老","author":"苏轼","text":"两邦山水未凄凉，二老风流总健强。\n共成一百七十岁，各饮三万六千觞。\n藏春坞里莺花闹，仁寿桥边日月长。\n惟有诗人被磨折，金钗零落不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去年秋，偶游宝山上方。入一小院，阒然无人。有一僧，隐几低头读书。与之语，漠然不甚对。问其邻之僧，曰：「此云阇黎也，不出十五年矣。」今年六月，自常、润还，复至其室，则死葬数月矣。作诗题其壁","author":"苏轼","text":"云师来宝山，一住十五秋。\n读书尝闭户，客至不举头。\n去年造其室，清坐忘百忧。\n我初无言说，师亦无对酬。\n今来复扣门，空房但飕飗。\n云已灭无馀，薪尽火不留。\n却疑此室中，常有斯人不。\n所遇孰非梦，事过吾何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听僧昭素琴","author":"苏轼","text":"至和无攫醳，至平无按抑。\n不知微妙声，究竟从何出？\n散我不平气，洗我不和心。\n此心知有在，尚复此微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧惠勤初罢僧职","author":"苏轼","text":"轩轩青田鹤，郁郁在樊笼。\n既为物所縻，遂与吾辈同。\n今来始谢去，万事一笑空。\n新诗如洗出，不受外垢蒙。\n清风入齿牙，出语如风松。\n霜髭茁病骨，饥坐听午钟。\n非诗能穷人，穷者诗乃工。\n此语信不妄，吾闻诸醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵隐高峰塔","author":"苏轼","text":"言游高峰塔，蓐食治野装。\n火云秋未衰，及此初旦凉。\n雾霏岩谷暗，日出草木香。\n嘉我同来人，久便云水乡。\n相劝小举足，前路高且长。\n古松攀龙蛇，怪石坐牛羊。\n渐闻钟磬音，飞鸟皆下翔。\n入门空有无，云海浩茫茫。\n惟见聋道人，老病时绝粮。\n问年笑不答，但指穴藜床。\n心知不复来，欲归更彷徨。\n赠别留匹布，今岁天早霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十七日，天竺山送桂花，分赠元素","author":"苏轼","text":"月缺霜浓细蕊乾，此花元属玉堂仙。\n鹫峰子落惊前夜，蟾窟枝空记昔年。\n破裓山僧怜耿介，练裙溪女斗清妍。\n愿公采撷纫幽佩，莫遣孤芳老涧边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海会寺清心堂","author":"苏轼","text":"南郭子綦初丧我，西来达摩尚求心。\n此堂不说有清浊，游客自观随浅深。\n两岁频为山水役，一溪长照雪霜侵。\n纷纷无补竟何事，惭愧高人闭户吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捕蝗，至浮云岭，山行疲苶，有怀子由弟二首 其一","author":"苏轼","text":"西来烟障塞空虚，洒遍秋田雨不如。\n新法清平那有此，老身穷苦自招渠。\n无人可诉乌衔肉，忆弟难凭犬附书。\n自笑迂疏皆此类，区区犹欲理蝗馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捕蝗，至浮云岭，山行疲苶，有怀子由弟二首 其二","author":"苏轼","text":"霜风渐欲作重阳，熠熠溪边野菊黄。\n久废山行疲荦确，尚能村醉舞淋浪。\n独眠林下梦魂好，回首人间忧患长。\n杀马毁车从此逝，子来何处问行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青牛岭高绝处，有小寺，人迹罕到","author":"苏轼","text":"暮归走马沙河塘，炉烟袅袅十里香。\n朝行曳杖青牛岭，寒泉咽咽千山静。\n君勿笑老僧，耳聋唤不闻，百年俱是可怜人。\n明朝且复城中去，白云却在题诗处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新城陈氏园，次晁补之韵","author":"苏轼","text":"荒凉废圃秋，寂历幽花晚。\n山城已穷僻，况与城相远。\n我来亦何事，徙倚望云巘。\n不见苦吟人，清樽为谁满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅圣俞诗集中有毛长官者，今于潜令国华也。圣俞没十五年，而君犹为令，捕蝗至其邑，作诗戏之","author":"苏轼","text":"诗翁憔悴老一官，厌见苜蓿堆青盘。\n归来羞涩对妻子，自比鲇鱼缘竹竿。\n今君滞留生二毛，饱听衙鼓眠黄紬。\n更将嘲笑调朋友，人道猕猴骑土牛。\n愿君恰似高常侍，暂为小邑仍刺史。\n不愿君为孟浩然，却遭明主放还山。\n宦游逢此岁年恶，飞蝗来时半天黑。\n羡君封境稻如云，蝗自识人人不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与毛令方尉游西菩寺二首 其一","author":"苏轼","text":"推挤不去已三年，鱼鸟依然笑我顽。\n人未放归江北路，天教看尽浙西山。\n尚书清节衣冠后，处士风流水石间。\n一笑相逢那易得，数诗狂语不须删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与毛令方尉游西菩寺二首 其二","author":"苏轼","text":"路转山腰足未移，水清石瘦便能奇。\n白云自占东西岭，明月谁分上下池。\n黑黍黄粱初熟候，朱柑绿橘半甜时。\n人生此乐须天付，莫遣儿曹取次知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李行中秀才醉眠亭三首 其一","author":"苏轼","text":"已向闲中作地仙，更于酒里得天全。\n从教世路风波恶，贺监偏工水底眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李行中秀才醉眠亭三首 其二","author":"苏轼","text":"君且归休我欲眠，人言此语出天然。\n醉中对客眠何害，须信陶潜未若贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李行中秀才醉眠亭三首 其三","author":"苏轼","text":"孝先风味也堪怜，肯为周公昼日眠。\n枕曲先生犹笑汝，枉将空腹贮遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":75385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]