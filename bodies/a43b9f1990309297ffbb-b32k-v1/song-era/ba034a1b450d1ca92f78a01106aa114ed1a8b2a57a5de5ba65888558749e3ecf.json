,"notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过湖上登城楼泛小舟归 其二","author":"韩维","text":"绿水逶迤城两面，清风摇动稻千畦。\n独乘幽兴携樽酒，小艇归时月已低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过湖上登城楼泛小舟归 其一","author":"韩维","text":"蛩响渐依阶砌下，萤光乱出草莱间。\n炎蒸散尽人轻健，从此篮舆数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"累日不到西园瑞香忽已烂熳","author":"韩维","text":"锦官翻样出新机，浅绿深红各自宜。\n不是东风送香气，幽花落尽有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄莲花 其二","author":"韩维","text":"只将萧洒与温醇，敌尽千花百草春。\n欲赋清诗写深愿，却疑潜笑白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄莲花 其一","author":"韩维","text":"浅白轻黄两未分，飞来人世作朝云。\n天教细雨常遮护，留得清香数日闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄莲花 其三","author":"韩维","text":"一水盈盈独立时，六铢衣薄透冰肌。\n临川已没龙丘远，辜负芳妍乞好祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景仁雨中同游南园 其二","author":"韩维","text":"宿醉厌厌晓尚曛，卷帘清思满风云。\n久嫌日暖撩人困，却喜花香带雨闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景仁雨中同游南园 其一","author":"韩维","text":"暖日催花落夕曛，轻雷一夜变重云。\n安舆少滞无多怪，涩雨悭风自古闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾通直见惠风琴","author":"韩维","text":"剡竹纫丝匠意深，泠然终日自成音。\n吾君方急民财阜，好助薰风入舜琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游北园辄成二颂呈芳公长老 其二","author":"韩维","text":"青山隐约林端见，碧水逶迤竹下来。\n芳草落花无朕迹，与君亲到北园回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游北园辄成二颂呈芳公长老 其一","author":"韩维","text":"万法都来一道场，游行何处不真常。\n临风不用提玄旨，翠竹森森自短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游象罔亭偶成二绝 其二","author":"韩维","text":"竹色隐波流不去，莲香浮坐断还闻。\n诛茅结宇才方丈，占尽清风与白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游象罔亭偶成二绝 其一","author":"韩维","text":"泛尽溪流数曲清，竹阴开处见新亭。\n山翁不会题牌意，犹守枯枝看道经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上招曼叔","author":"韩维","text":"故人旌旆镇邻城，未奏骊歌已怆情。\n莫为炎蒸慵命驾，绿荷红芰水风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新作西北门楼","author":"韩维","text":"赤白崔嵬晚照间，投闲时复一跻攀。\n时平守望皆无用，添得清秋数点山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新得小石呈景仁","author":"韩维","text":"泥沙洗尽太湖波，状有嵌崆势亦峨。\n可笑尚平游五岳，不如坐视一拳多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"照禅师久欲一见比至汝则已游矣因题广惠","author":"韩维","text":"高僧寂寞空尘坐，古寺悲凉足野风。\n道在岂须烦目击，亭前双柏自葱葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙惠拄杖及诗依韵奉答","author":"韩维","text":"藤枝既老解纵横，禅老因何解道情。\n识取个中无把捉，眼前瓦砾是瑶琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾","author":"韩维","text":"平生为爱此香浓，仰面常迎落架风。\n每至春归有遗恨，典刑犹在酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠曹大夫三绝 其二","author":"韩维","text":"窃禄偷安到白头，一闻高韵使人羞。\n如今便欲归休去，已愧迟君八九秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠曹大夫三绝 其一","author":"韩维","text":"落落明珠骇暗投，知君所得在无求。\n直须言下通非句，识取澄潭皎洁秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠曹大夫三绝 其三","author":"韩维","text":"势利驱人去若流，君才六十便归休。\n归时不及家无有，但问松安竹健不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日席上赋得茱萸","author":"韩维","text":"寥落霜园树，萸房独照秋。\n实兼兰佩结，香近玉卮浮。\n嗔蕊醒残醉，纫红感旧游。\n三英佳句在，殊喜继风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十日游象之葆光亭寄曼叔","author":"韩维","text":"几负高阳约，蹉跎此岁华。\n论心看翠竹，感事对黄花。\n寒日悽征雁，清霜急暮鸦。\n临风一樽酒，回首意无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和子华","author":"韩维","text":"沉阴消尽见春和，初放扁舟溯绿波。\n水际踏青怜日暖，林间举白为花多。\n狂从田妇窥篱看，醉任家童刮鼓歌。\n年少纵欢饶点检，老欢终不挂谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和北轩竹上甘露","author":"韩维","text":"君家竹上露，点缀如明珰。\n垂枝乍惊重，映日复能光。\n聊可助清兴，安知为羡祥。\n应从草制暇，延咏对华觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和馆西迎驾","author":"韩维","text":"宫树烟开敞禁扉，儒冠罗立望天威。\n霜清广殿鸣鞘肃，日上觚棱翠盖飞。\n玉勒帕鞍龙在御，锦衣腰剑士成围。\n暂来直舍支颐坐，却听箫韶辇路归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]