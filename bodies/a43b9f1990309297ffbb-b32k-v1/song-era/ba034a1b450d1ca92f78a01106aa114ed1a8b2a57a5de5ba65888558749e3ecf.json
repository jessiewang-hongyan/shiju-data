[{"title":"芙蓉五绝呈景仁 其四","author":"韩维","text":"不辞晨起立秋风，为爱浓芳露满丛。\n若比洛阳花盛品，万枝开遍瑞云红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉五绝呈景仁 其三","author":"韩维","text":"少年尝记作西游，尤蕊奇葩夹道秋。\n今日家园开烂熳，恍疑身在蜀江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉五绝呈景仁 其二","author":"韩维","text":"小沾清露细摇风，养得新花次第红。\n客至莫教樽酒燥，朝吟夕赏未知穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居思湖上","author":"韩维","text":"远泛每思随雁鹜，深居半是避杯觥。\n官闲日永无馀事，卧听朱弦教曲成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和三兄立冬祠太乙二首 其二","author":"韩维","text":"曾为祝史趋真馆，屈指于今二十年。\n琪树瑶林成想像，直疑当日梦游仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子华对雨有感 其二","author":"韩维","text":"雪白朱红已万枝，年年长恨失花期。\n莫嗟飞雨淹游棹，却赖春寒发较迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太素双头牡丹兼呈子华","author":"韩维","text":"群英日零谢，并蒂发奇芳。\n愿以附驿使，为兄寿且昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太素密杏","author":"韩维","text":"甘滋不假蜂房取，美种疑随鹤驭来。\n方朔偷桃徒语尔，安期食枣足珍哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王詹叔寄彭年四首 其四","author":"韩维","text":"一曲清琴满架书，万钟于我亦分铢。\n他年欲作林泉计，为问山前有地无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王詹叔寄彭年四首 其三","author":"韩维","text":"层楼飞观压溪流，缥缈当从海上求。\n病间体轻尘虑静，好追仙子御风游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王詹叔寄彭年四首 其二","author":"韩维","text":"断瓢疏罟入提携，浊酒徐倾鲙缕肥。\n雨后碧山来爽气，松间明月尚清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王詹叔寄彭年四首 其一","author":"韩维","text":"纷纷声里满埃尘，一听除书耳目新。\n清世未能忘薄禄，官曹犹得作闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和玉汝赠收上人","author":"韩维","text":"道得都来是八成，圣无功用已非灵。\n凭君谛视丹霞路，依旧云山点点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冲老雪颂","author":"韩维","text":"揉絮琼飞晓尚飘，平吞六合蔽层霄。\n从来不打禾山鼓，且向樽前看绿腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杜孝锡展江亭三首 其一","author":"韩维","text":"斜日低云动水光，偶寻佳处阅群芳。\n城闉不隔和风度，吹过千花百草香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和述古河阳感怀之作","author":"韩维","text":"大河雄胜昔常游，拥节题诗为少留。\n我亦华颠无用者，碧嵩清颍是归头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提刑千叶梅 其一","author":"韩维","text":"层层玉叶黄金蕊，漏泄天香与世人。\n闲寂未须嗟失地，年年长冠百花春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提刑千叶梅 其二","author":"韩维","text":"擢玉自成超俗格，施朱不学入时妆。\n莫将罗幕轻遮护，从放樽前自在香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景纯栽松 其一","author":"韩维","text":"芳根出涧底，秀木依墙东。\n莫顾一时好，当观三世空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和景纯栽松 其二","author":"韩维","text":"论坚莫如松，言脆莫如葱。\n坚脆卒同尽，无尽无如翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之游湖春夏秋冬四绝 其一","author":"韩维","text":"冰散玉珂微弄暖，梅含金粉巧矜新。\n道人不管年光逝，贪作诗章等待人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之游湖春夏秋冬四绝 其二","author":"韩维","text":"花边鹭立红云里，林下人行翠幄中。\n炎暑吾今知所避，全家移入广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之游湖春夏秋冬四绝 其四","author":"韩维","text":"画舫新成水拍堤，悲丝急管韵参差。\n吟风啸月年年事，未省曾经兴尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和微之游湖春夏秋冬四绝 其三","author":"韩维","text":"败荷衰折水西流，极目清光好放舟。\n幸有主人频卜昼，肯同俗子更悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和君俞以子华古德颂见示","author":"韩维","text":"百尺竿头进步人，随缘偶物莫非真。\n君看日用如何讨，即此空身是法身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答祖印喜雪二颂 其一","author":"韩维","text":"细逐流风遍大田，皑然一色绝中边。\n空生惯识岩中镜，何似天花乱坠年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答祖印喜雪二颂 其二","author":"韩维","text":"久旱终能不失时，田家喜气吐虹霓。\n庞公昔日曾垂语，资福今朝更指迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招彝叟厚之饮台上花间","author":"韩维","text":"恍然身世出尘心，香霭祇园地布金。\n秉烛听歌不知醉，夜深清露满衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西书事五首 其一","author":"韩维","text":"蔬畦绕茅屋，林下辘轳迟。\n霜蔓已除架，风飘空挂篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某伏蒙寄示五言二韵诗辄次韵上呈聊以见志","author":"韩维","text":"尚不求真语，何能计妄言。\n且饶只么会，犹是弄精魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张七元构仕亳州","author":"韩维","text":"萧条平马逐飞蓬，回首园林平露中。\n政事文章君得法，如今太守古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻太素绝食饮水颇甚清羸以诗见招","author":"韩维","text":"曲肱饮水归寒士，服气休粮号道人。\n顾我非寒亦非道，好来相伴祭身神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻彝叟游展江亭","author":"韩维","text":"西亭不觉又春风，弱柳微波四面中。\n更欲烦君亭下看，海棠枝上浅深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展江亭海棠四首 其四","author":"韩维","text":"人避寒风与暖曦，年年长此探花期。\n如今太守尤珍爱，只许官娃带一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展江亭海棠四首 其三","author":"韩维","text":"红糁妆条袅袅长，人间不合有天香。\n千觞未足酬佳丽，回首东风更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展江亭海棠四首 其二","author":"韩维","text":"昔年曾到蜀江头，绝艳牵心几十秋。\n今日栏边见颜色，梦魂不复过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展江亭海棠四首 其一","author":"韩维","text":"占尽人间丽与华，白头判得醉流霞。\n谁将法锦翻新样，红绿装成遍地花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"