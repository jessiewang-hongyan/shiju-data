[{"title":"井上桐","author":"文彦博","text":"擢干殊琼巘，托根非峄阳。\n发华临玉甃，倒影覆银床。\n方待高朋集，宁容众鸟翔。\n尾焦期入爨，谁识蔡中郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳絮","author":"文彦博","text":"拂地高阳翠影浓，杨花断续蔽香红。\n密和微雨粘沙坂，乱逐轻风透绮笼。\n漆圃旋惊飞蝶梦，玉庭频拟散盐空。\n青门一望依依处，千里金堤二月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其一","author":"文彦博","text":"金屋无人夜未央，独吟团扇倚椒房。\n辟寒犹待君王意，鹤燄荧煌龙漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其二","author":"文彦博","text":"体轻全不胜鸾钗，常羡同心上苑梅。\n翠辇未来珠箔卷，漆盘犹贮夜明苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登江楼","author":"文彦博","text":"飞观接江干，乘闲独凭栏。\n鲜云横列岫，芳草蔽遥滩。\n梅笛吹渔浦，荃桡泛鹭湍。\n登临谢康乐，寄远折瑶兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游","author":"文彦博","text":"紫燕动光辉，春游雁鹜陂。\n鹤天方烂熳，鸿盖任追随。\n促席开瑶瑟，当歌泛羽卮。\n言归将薄暮，不羡习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宴","author":"文彦博","text":"清夜开良宴，金瓶泛羽觞。\n蕙肴芬洁俎，兰焰耿华堂。\n妙舞流风雪，妍歌绕栋梁。\n西园堪赏玩，明月照银塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从军行","author":"文彦博","text":"汗马出长城，横行十万兵。\n晨驱左贤阵，夕掩亚夫营。\n雪压龙沙白，云遮瀚海平。\n燕山纪功后，麟阁耀鸿名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侠少行","author":"文彦博","text":"锦带佩吴钩，翩翩跃紫骝。\n垂鞭度永埒，挟弹过长楸。\n平乐十千酒，南城百尺楼。\n荆娥拂双袖，日夕又迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花","author":"文彦博","text":"雨过新含灼灼华，烟笼芳树势交加。\n狂飞粉蝶穿朱槛，巧啭流莺傍碧纱。\n露井细香飘烈麝，霜林浓艳散馀霞。\n啮毫更近成阴处，似入仙源一径斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早夏言怀","author":"文彦博","text":"碧槛初荣槿，芳园已莠葽。\n翠岑应解鹿，高树欲鸣蜩。\n霞绮笼飞观，云峰映琐寮。\n霜纨徒比月，仙驭好凌飙。\n寒水沉朱李，新吟寄绿蕉。\n药房清气爽，荃壁冷香消。\n玉沼贺荷嫩，兰禳乳燕娇。\n薄帷安画石，幽径采神虈。\n每欲求飞雪，常思造结瑶。\n浩歌频倚瑟，长袖几炊彫。\n静对黄梅雨，闲吹紫玉箫。\n砌榴红烂熳，窗岫碧岧峣。\n袁趾疏还往，颜居正寂寥。\n且倾光禄酒，莫发采菱谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕偶怀","author":"文彦博","text":"小槛风惊叶，幽庭露泫柯。\n芳尘千里远，幽恨九回多。\n萤影穿帘押，蛩声出砌莎。\n寸心无以写，愬月但长歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕偶作","author":"文彦博","text":"独诵潘郎秋兴赋，闲吟谢守怨情诗。\n风摇红树啼螀急，月照绿窗清漏迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜闻笛","author":"文彦博","text":"秋宵万籁沉，羌笛似龙吟。\n向秀忽思旧，马融方好音。\n细声寒入牖，残韵半和砧。\n莫奏梅花曲，旅人情更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古寺清秋日 其一","author":"文彦博","text":"古寺清秋日，微凉宝殿中。\n玉题高纳月，金铎碎摇风。\n翠藓缘阶碧，幽兰裛露红。\n闲听连叶漏，吟对惠休公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古寺清秋日 其二","author":"文彦博","text":"古寺清秋日，幽闲景倍殊。\n晚云遮鹫岭，新月照虾须。\n玉露沾篱菊，金风落井梧。\n武泥求泛驾，张翰莫思鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古寺清秋日 其三","author":"文彦博","text":"古寺清秋日，登楼拥鼻吟。\n微凉生柰苑，轻吹动香林。\n窗外萤飞火，篱边菊散金。\n静弹流水曲，何处有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古寺清秋日 其四","author":"文彦博","text":"古寺清秋日，潘郎兴倍长。\n院闲披鹤氅，人静掩鹰房。\n密树惊晨鹊，幽轩耿夜螀。\n班姬应咏扇，通夕恨昭阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古寺清秋日 其五","author":"文彦博","text":"古寺清秋日，含毫凭小楼。\n雨微滋石藓，烟淡落霜楸。\n紫燕休巢幕，苍鹰已下韝。\n闲倾浮蚁酎，时典鹔鹴裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳前五日探菊","author":"文彦博","text":"比到重阳犹五日，露披金菊满东篱。\n莫言预赏非真赏，大抵先时胜后时。\n密蕊不容群蝶采，清香未许众人知。\n幕中婉画应多暇，来伴渊明把酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳前两日登楼望月","author":"文彦博","text":"宝刹翚飞切紫霄，况莲开士木绵袍。\n黄昏尚倚危楼望，反照南荣呗梵高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩月吟寄友人 其一","author":"文彦博","text":"桂魄腾车朱户深，琐寮珠箔夜沉沉。\n慵听北里吹竽燕，闲倚南楼拥鼻吟。\n玉宇暗销红烛影，银床斜转碧桐阴。\n金瓶剩贮程乡酒，留待龙交满满斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩月吟寄友人 其二","author":"文彦博","text":"薄宦羁尘事，劳生困夏畦。\n偶来游日观，更喜蹑云梯。\n便拟纫兰佩，相招隐竹溪。\n回看广津路，欲问转多迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩月吟寄友人 其三","author":"文彦博","text":"闻道频挥霹雳手，定知不费琰之才。\n且投丹笔携诗笔，来就花间把一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游仙咏","author":"文彦博","text":"十二瑶楼切绛云，醉游昆阆碧桃春。\n烟藏玉树栖鸾稳，露浥芝田唳鹤频。\n闲访五城骑白鹿，静寻三洞驾黄麟。\n紫房求看登真录，说是明晨第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡秀才归绛台","author":"文彦博","text":"飘飘词赋已还邛，法牖推贤继祖风。\n缓颊且惊仪舌在，只轮休叹阮途穷。\n伫观振翼迁乔木，忍学栖衡嗜晚菘。\n楚宝定须三献遇，肯教烦岁泣如虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠孙庄秀才","author":"文彦博","text":"丽藻遒文绝比肩，买符新自帝州迁。\n四溟浪阔鹍须化，三岛路长鸾暂闲。\n桂玉擅名将继却，箪瓢乐道且晞颜。\n前春定奋冲天翼，休抱如虹泣楚山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭屯田牧涪陵","author":"文彦博","text":"涪陵古群接青台，巴俗频思叔度来。\n鱼竹乍分天顾息，星轺初动隼旟开。\n一麾暂辍含香职，双笔犹淹视草才。\n伫听陜棠民颂洽，紫泥对诏下蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张峣秀才勉弟之什","author":"文彦博","text":"棣萼联华继昔贤，素园游想已多年。\n方观薮凤翱千仞，将见床鸾上九天。\n宽诏已闻求泛驾，盛时休忆赋归田。\n来春定中穿杨箭，好约抽毫玉陛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送昌黎先生归秦亭","author":"文彦博","text":"独驾轻鸿返故园，冠霞曾醉锦江烟。\n五图金记何年授，九籥丹经几处传。\n晓别阆州飞玉斝，暮登秦岭挹红泉。\n椒庭他日重相见，应许壶中看列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送果州李推官赴阙","author":"文彦博","text":"德满椒兰学满籯，升堂鸿藻继云卿。\n舜庠蚤中巍峨选，俭府还驰酝藉名。\n捧诏定趋文石陛，扬鞭将度洛阳城。\n麟台马署期高步，闲绎芸签听苑莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送友人","author":"文彦博","text":"携手北梁道，送君南浦春。\n斜阳沉璧彩，流水濯缨尘。\n郢酒频扬觯，燕歌旋怆神。\n瑶华如可折，堪寄陇头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送浦上人游川","author":"文彦博","text":"火宅清凉荫慧云，海潮芳论更难伦。\n鹰房暂锁巴山下，虎锡还飞锦水滨。\n贝叶文皆收缥帙，林兰衣不染红尘。\n亭皋欲别偏多感，缘是双林社里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登通山阁有怀寄呈同人","author":"文彦博","text":"小阁登临春暮时，绮栏飞闼映游丝。\n莺喧曲槛韩冯树，藓晦幽庭贡禹綦。\n闲对碧云吟桂水，狂思长袂宿兰池。\n徘徊望断江边客，采得瑶华寄与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘推官归冶源栖真馆","author":"文彦博","text":"高情乐幽趣，遂与尘事违。\n岩谷久潜照，鱼鸟知忘机。\n方邀栗里会，却指冶源归。\n借问归何遽，山中芝朮肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送福州通判陈铸殿丞","author":"文彦博","text":"泽宫登甲第，殿省滞时英。\n闽国题舆贵，稽山昼锦荣。\n轶才犹绊骥，美俗仰诚衡。\n寿母平返喜，迎知讼牒清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠会稽尊师","author":"文彦博","text":"藐姑容化三阴馆，勾漏砂封六乙泥。\n五练夜穷苍玉几，七明晨采碧云梯。\n冠霞高挹浮丘袂，握髓深藏鬼谷溪。\n如有西山驻灵药，何妨相赠一刀圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠自然表白大师 其一","author":"文彦博","text":"千仞清溪绝世纷，先生高卧白云根。\n近来名系丹台籍，多向蒙山见羡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠自然表白大师 其二","author":"文彦博","text":"紫府仙人每驭飙，朝游三岛暮三茅。\n他年内史功成后，愿结山阴世外交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠自然表白大师 其三","author":"文彦博","text":"常感真公传隐诀，每言凡骨是仙材。\n他时载挹浮丘袂，直在昆峰十二台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某天圣四年叨充乡赋明道二年夏假副车于本郡今年夏忝外计于本道寔嗣世职八月行部率遵故常乡老欢迎邀留累日徘徊旧地追惟畴曩因成拙诗二章题于行署 其一","author":"文彦博","text":"不才惟侍高门庆，奕世皆为外计臣。\n乡老相逢频教我，尽忠思孝报君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某天圣四年叨充乡赋明道二年夏假副车于本郡今年夏忝外计于本道寔嗣世职八月行部率遵故常乡老欢迎邀留累日徘徊旧地追惟畴曩因成拙诗二章题于行署 其二","author":"文彦博","text":"昔年乡赋议兴贤，曾接诸君砚席间。\n屈指岁华逾一纪，锦衣怀绶过稽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送益利路承受梁供奉回京","author":"文彦博","text":"二星同入蜀，三岁复还台。\n秋晚华轩去，江滨祖席开。\n归途虽日远，别酒任山颓。\n思渥迎知厚，当朝重使才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷简夫自辰溪还除国子博士盐铁判官以书见谢并寄杜鹃鸟一只偶成二章答之 其一","author":"文彦博","text":"学省新开用退之，阳城司业定相知。\n休思杜曲仙乡隐，好献元和圣德诗。\n三部共推盐铁论，五溪曾制虎貔师。\n济源处士功成后，始信书生善出奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷简夫自辰溪还除国子博士盐铁判官以书见谢并寄杜鹃鸟一只偶成二章答之 其二","author":"文彦博","text":"山人远寄杜鹃禽，因寄山禽遂寄心。\n应谓不如归去好，高飞却入旧云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送中舍蒲君致政西归","author":"文彦博","text":"阆苑当年砚席同，别来三十八秋风。\n东朝新命西归去，珍重贤哉鹤发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送分司少卿归洪井 其一","author":"文彦博","text":"囊奏祈分务，纶恩宠亚卿。\n挥金还故里，脱屣谢浮荣。\n綵服趋庭学，彤襜解榻迎。\n送言惭有味，何有答希声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送分司少卿归洪井 其二","author":"文彦博","text":"知止遗荣世所稀，帆风美满浩然归。\n江边闻有梅真宅，吟对西山不掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送知府给事赴阙","author":"文彦博","text":"紞如惊晓鼓，仙旆戒晨兴。\n万臂攀朱毂，千兵拥绿縢。\n归途非杳邈，高步即严凝。\n竹马光前迹，蒲鞭掩旧称。\n睿襟思启沃，宸扆伫疑丞。\n舆论方盈耳，佥谋尽伏膺。\n公乎调大鼎，皇矣赉良肱。\n属吏垂三异，微才仅五能。\n梁园暂未至，燕馆愧先登。\n北海难充荐，西曹久见矜。\n顽金虽自况，巧冶欲谁凭。\n深结君轩恋，翻思附骥蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太师相公重九日宴府僚之什","author":"文彦博","text":"不独龙山胜致全，黄枢开宴尽时贤。\n风回绮席鸾觞泛，日上彤襜虎幄鲜。\n陶菊香浓侵玳押，吴歈声缓倚鹍弦。\n云笺一幅西园什，如听钧韶下九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小园即事","author":"文彦博","text":"闲脱蕉衫挂树桠，竹冠芒屩自耘瓜。\n心形散傲如园吏，椑榼纵横似酒家。\n古桧婆娑张碧盖，流泉诘屈动青蛇。\n风清日落未归舍，待得东南见月华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫保相公之役与有劳焉及闻非才忝爰立之命贻诗加奖有晋公亲讨卫国专谋之句称述大过拟议非伦辄成拙恶一章以达谢意","author":"文彦博","text":"平淮伐潞皆殊绩，靖乱夷凶著往编。\n今以薄才叨重任，改将微效觊前贤。\n人惭肖象求商野，德谢非熊起渭川。\n惟有安昌念高第，雅章称述爱彭宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题高平公亲书伯夷颂卷后","author":"文彦博","text":"书从北海寄西豪，开卷才窥竦发毛。\n范墨韩文传不朽，首阳风节转孤高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上偶作 其一","author":"文彦博","text":"地胜当春早，身闲爱景幽。\n微风吹积水，尽日飏虚舟。\n客至解悬榻，鱼来避直钩。\n机心本不动，犹恐骇群鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上偶作 其二","author":"文彦博","text":"岸帻长吟坐钓矶，花香漠漠柳依依。\n夕阳湖面光如鉴，风送虚舟自在归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢太傅相公以近诗三十首寄示","author":"文彦博","text":"一轴诗三十，词高气格雄。\n文通推杂体，吉甫让清风。\n平日丹青笔，当年造化工。\n安车有馀力，移向二南中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上独酌","author":"文彦博","text":"尽日观鱼坐水边，悠然独酌望青山。\n樽前解下渊明帢，起就东奚濯腻颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"外计苏度支示古铜器形制甚雅辄书五十六字还之","author":"文彦博","text":"古鼎良金齐法精，未知何代勒功名。\n更须梓匠为凫杓，堪与仙翁作酒鎗。\n涤濯尚应劳犊鼻，腥膻不复染羊羹。\n水边林下风清处，长伴薰然醉玉倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中湖上绯桃盛开舟子维缆于树因书二十八言","author":"文彦博","text":"灼灼秾华照碧流，素烟丝雨助妖柔。\n武陵不放刘郎去，更就桃根系小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得告赴洛展省松楸往还寓宿于阳翟程密学新第因成四十言寄高阳","author":"文彦博","text":"公临赵北际，宅据许西偏。\n来往由通德，逢迎阻见贤。\n嵩高当牖外，颍树出墙颠。\n信宿依华荫，身居贺燕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提刑司封垂访郡斋会于湖上道旧为乐兼贶雅章辄成四十言以答来惠","author":"文彦博","text":"昔忝西州牧，驱车经剑门。\n见君新凿沼，延我共开樽。\n治岸依山麓，疏泉透树根。\n鸭湖今日会，往事喜重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予移守青社同年宋学士代予守壁田会有来诗因成四十言为答","author":"文彦博","text":"旧许陪原郡，时清偃息优。\n羡君熊轼去，夺我鸭坡游。\n草树秋方密，禽鱼晚思幽。\n相凭皆与问，犹忆醉翁不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答南都致太傅相公","author":"文彦博","text":"雪苑挥毫寄雪宫，丘门褒宠过华虫。\n希声远夺霜钟韵，妙墨高踰禊帖工。\n辱韵颇惭才陋薄，玩辞弥见意勤隆。\n西南跂望安昌馆，何日陪随似戴崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题看山楼新画山水","author":"文彦博","text":"尽日望西山，扶筇复倚栏。\n远观犹未足，更作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太原府统平殿朝拜","author":"文彦博","text":"逆垒弥天甚，君王驻翠銮。\n荆榛亲剪伐，家业信艰难。\n一剑山河定，千年庙社安。\n故城禾黍美，无复验泥丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄太原韩太尉","author":"文彦博","text":"旧说男儿本分官，更将诗句报长安。\n虚庸自省尤非据，深玷君家汉上坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅公仪待制 登骊山见连理木","author":"文彦博","text":"长生私语都无益，芳树交柯自表奇。\n就使玉真如素愿，山阴拱木竟何知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]