[{"title":"宫词 其四十二","author":"赵佶","text":"清和景物称游遨，金屋亭亭瑞日高。\n节物应时来别院，合中连络进樱桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十三","author":"赵佶","text":"杏子成丹乳雀飞，柳条摇曳拂涟漪。\n瑶宫露井残红满，惆怅晴空欲暮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十四","author":"赵佶","text":"满架酴醾旖旎香，小亭芳沼戏鸳鸯。\n兰房祗慕承恩泽，愈学时宜百巧妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十五","author":"赵佶","text":"高丽新贡欲还朝，再御东回一水遥。\n祖饯国门仍赐乐，屡传恩诏下层霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十六","author":"赵佶","text":"鞦韆影里笑相迎，蕙圃兰畦恣撷英。\n薄暮归来春意倦，芝堂闲听碾茶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十七","author":"赵佶","text":"屏山掩翠敞华堂，巧燕初归拣画梁。\n寂坐安闲忘俗虑，益知仙府昼何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十八","author":"赵佶","text":"云华重辑叠层峰，宝构高骧萃彩虹。\n环碧对池临翠圃，一沟春水远相通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十九","author":"赵佶","text":"琳庭节物乐无涯，又是馀寒易岁华。\n昨夜雪晴天气好，后园初进腊梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十","author":"赵佶","text":"旋题玉额起层楼，三阁图书集校酬。\n近日得增新碧榜，显谟相继缮徽猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十一","author":"赵佶","text":"秘阁初生瑞竹双，碧栏杆外玉墀旁。\n连柯并干扶疏叶，带月萦风兴味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十二","author":"赵佶","text":"白檀象戏小盘平，牙子金书字更明。\n夜静绮窗辉绛蜡，玉容相对煖移声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十三","author":"赵佶","text":"朝班翼翼布鸳行，三卫森严殿砌旁。\n遴选亲勋先许进，校员多是补中郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十四","author":"赵佶","text":"阊阖朝来禁钥开，传邮跃马度香街。\n封章通进言三捷，从尔威风满国怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十五","author":"赵佶","text":"九重城阙壮端门，霁色荣光瑞景分。\n一望葱葱佳气里，楼台常恐碍行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十六","author":"赵佶","text":"嫔娥闲较选仙图，争到天宫意自娱。\n堂印碧油常占得，更无忧恐入酆都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十七","author":"赵佶","text":"宗祀玄堂羽卫还，大庭斋夕驻鸣鸾。\n平明复赐端明赦，争看金鸡立巨盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十八","author":"赵佶","text":"十花金盏劝仙娥，乘兴追欢酒量过。\n灯影四围深夜里，分明红玉醉颜酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十九","author":"赵佶","text":"红药栏边晚吹轻，玉肌人醉撷芳英。\n春衫旖旎香难已，却羡东风太有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十","author":"赵佶","text":"小雨飞轻助燕泥，万花零落柳垂堤。\n紫清宫里人稀到，廊外双双孔雀栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十一","author":"赵佶","text":"宴殿匀将蜀锦铺，花明金赫丽簪裾。\n舞茵全似朝霞散，十二金鸾面玉除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十二","author":"赵佶","text":"每将兢慎保丕基，频岁多男巳应期。\n欲问荣昌在何事，春中禖燕满彤围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十三","author":"赵佶","text":"象蹋冰盘四面凉，风摇槐影蘸莲塘。\n玉颜一枕游仙梦，谁觉炎天畏日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十四","author":"赵佶","text":"日暖风和殿宇深，高花修竹啭闲禽。\n宫娥携手临丹槛，喜看文鸳戏水心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十五","author":"赵佶","text":"送腊自然时序应，颁春常与迩遐同。\n福随新岁知阳德，庆协斯男诞禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十六","author":"赵佶","text":"三十六宫春信早，郁葱佳气艳阳天。\n莫将旧事论新事，尽道今年胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十七","author":"赵佶","text":"朝来和气巳氤氲，碧瓦朱甍照眼新。\n永昼更添莲漏水，晴曦容与蕊宫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十八","author":"赵佶","text":"池面冰开漾绿波，枝头花朵蹙红罗。\n东风信有芳菲意，应为今年乐事多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十九","author":"赵佶","text":"蓬莱宫殿五云低，广内楼台草色齐。\n忧在进贤忘寤寐，晓妆常是未鸣鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十","author":"赵佶","text":"梅心透粉傍琼疏，柳眼回青袅玉除。\n雨露不偏金穴贵，六宫春晓念关雎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十一","author":"赵佶","text":"日上觚棱气郁葱，露华犹泠玉芙蓉。\n锦帏绣幕风光暖，琼叶珠花影渐重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十二","author":"赵佶","text":"黄头进酒斗醇浓，问有均颁不启封。\n向晚闻呼装尚酝，双瓶环绕小金龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十三","author":"赵佶","text":"化成金碧拱雕楹，四序开筵率有程。\n安福殿阶连绣帟，内人常按鼓箫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十四","author":"赵佶","text":"螺钿珠玑宝盒装，琉璃瓮里建芽香。\n兔毫连盏烹云液，能解红颜入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十五","author":"赵佶","text":"元夕风光属太平，烛龙衔耀照严城。\n鳌峰屹立通明观，绛炬宵辉上下明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十六","author":"赵佶","text":"酒入金钟滟滟平，暗偷全在夹盘盛。\n宫嫔捧劝知分别，相顾潜闻笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十七","author":"赵佶","text":"唐画名工品格殊，搜求争进入皇居。\n金题玉躞分伦类，区别媸妍细字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十八","author":"赵佶","text":"翰林文府择良工，心画诸家一一通。\n无逸孝经书座右，迩英到彻画屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七十九","author":"赵佶","text":"新样梳妆巧画眉，窄衣纤体最相宜。\n一时趋向多情逸，小阁幽窗静奕棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十","author":"赵佶","text":"藻幄春深夜不寒，兰缸耿耿照屏弯。\n太平丝管通宵按，祥瑞封章隐几看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十一","author":"赵佶","text":"寒食风光淑景时，宫娥装束斗珠玑。\n呼卢尽日随朋侣，将掩严闺始欲归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十二","author":"赵佶","text":"昼漏声催篆缕残，碧墀幽寂画堂宽。\n九嫔相习敦诗训，争把关雎讽咏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十三","author":"赵佶","text":"玉关驰奏捷章来，鄯部洮湟万里开。\n阊阖通衢人意乐，争看宣舞凯歌回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十四","author":"赵佶","text":"春日循常击土牛，香泥分去竞珍收。\n三农藉此占丰瘠，应是宫娥暗有求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十五","author":"赵佶","text":"鼎殿崇新大器安，因时严享至诚殚。\n零零甘露符昌福，金玉沾濡拭不乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十六","author":"赵佶","text":"机杼年来入禁垣，素丝初织未成端。\n遍呼御府令均玩，方识农家力最难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十七","author":"赵佶","text":"锦屏谁染楚峰青，依约惟无涧水声。\n丽质闲观攲缕枕，高唐云杳梦难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十八","author":"赵佶","text":"晓色轻阴四幕低，如膏小雨密霏霏。\n传宣仪仗通廊立，惟恐沾濡近御衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十九","author":"赵佶","text":"庆成宫宇亘修梁，伟颂声文出玉堂。\n近日屡经亲述作，欢然中分仰宸章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十","author":"赵佶","text":"麻纸初新诏墨乾，金莲未剪烛花残。\n珠帘不隔霜华月，应比人间分外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十一","author":"赵佶","text":"对御分排紫锦班，内家新样挽云鬟。\n中官宣试霓裳舞，红袖翩翩飞燕般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十二","author":"赵佶","text":"弱柳飘飘意甚颠，无端牵住小花钿。\n楼中阿监遥相觑，应绘□图供御前。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十三","author":"赵佶","text":"夏日龙池小宴开，轻绡雾縠试新裁。\n酒阑齐逐采莲去，隔浦鸳鸯个个猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十四","author":"赵佶","text":"金题玉躞灿星光，御札纷纷杂紫黄。\n宣索女官三十六，就中谁是校书郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其一","author":"赵佶","text":"地居天上接空居，万象森罗遍八区。\n功用不知谁主宰，绛霞丹雾閟清都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其二","author":"赵佶","text":"碧落空歌黍米珠，十方勃勃入无馀。\n闻经庆喜难言说，九色龙腾八景舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其三","author":"赵佶","text":"羽童呼吸辟非烟，烟气徘徊绿室前。\n造化不从身外得，自根自本即三天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其四","author":"赵佶","text":"帝景相将会玉洲，月真层观紫云浮。\n掣开三八黄金锁，无极虚皇在上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其五","author":"赵佶","text":"白玉飞符下紫庭，华幡三举召群灵。\n攀条咀嚼空青蕊，五体金光射日星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其六","author":"赵佶","text":"远昌台下海扬波，得道高真始得过。\n下格小仙追莫及，邕邕遥听八鸾和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其七","author":"赵佶","text":"五色云营叆叆屯，三三洞户敞琼门。\n何方道士通朱表，玉女飞函达上尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其八","author":"赵佶","text":"上景三元妙色精，绛宫久已列仙名。\n更从大混存雌一，缥缈云车驾羽明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其九","author":"赵佶","text":"真阳馆里气徘徊，升降三宫密往来。\n生死不忓浮世事，相将五老上金台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉清乐 其十","author":"赵佶","text":"三华太素自然生，空里芙蓉灼灼明。\n绛室金房虚宝座，大微童子下相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其一","author":"赵佶","text":"紫清天上育华林，绛实朱柯竹叶深。\n咀嚼繁英身不老，下观鸟兔换光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其二","author":"赵佶","text":"元君八气号青灵，锦帔飞裙住玉城。\n把握帝符司道籍，拔除尘累济群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其三","author":"赵佶","text":"高上皇人宴紫霄，撷芳常引八骞条。\n肌肤表里琉璃彻，映照三涂万苦消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其四","author":"赵佶","text":"九日宫中四老真，广霞山上宴仙宾。\n鸣钟鼓瑟行灵醑，碧落融融别有春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其五","author":"赵佶","text":"浮绝山连白玉京，金华楼共日华明。\n五真结就圆珠气，骨似丹琼貌似婴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其六","author":"赵佶","text":"秀华峰下五灵都，元景神君握化枢。\n真火有功能造物，销镕五毒出阴途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其七","author":"赵佶","text":"赫赫曈曈日九轮，六渊宫殿紫元君。\n霞冠锦帔端居暇，披拂祥烟著赤文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其八","author":"赵佶","text":"佳气青葱覆紫空，青精羽驾命元童。\n逆风浩荡三千里，七返香烟处处通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其九","author":"赵佶","text":"流汩池中大宝莲，开花十丈映池泉。\n嗅香饮水无饥渴，绰约金华叶上仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清乐 其十","author":"赵佶","text":"万仞霞山峙玉虚，四司冠剑护灵都。\n众真稽首持天禁，腰佩仙皇逸录符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其一","author":"赵佶","text":"太一元君掌列仙，彤晖绛彩射芝田。\n功圆会遇刊名籍，可但洪崖笑拍肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其二","author":"赵佶","text":"五节清香半夜焚，天人玉女尽遥闻。\n味同气合遥相应，绛节霓旌下五云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其三","author":"赵佶","text":"太极元君翠翮车，万魔奔走听神符。\n九龙纵步齐骧首，时见空中吐火珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其四","author":"赵佶","text":"蕊珠宫里七言成，十二神君一一名。\n云拥苍虬归火府，风随素虎出沧瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其五","author":"赵佶","text":"金阙明光后圣君，流津焕彩结丹云。\n不因太上相传授，安得人间有玉文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其六","author":"赵佶","text":"元景岩峦耸太空，彭彭仙室在霞中。\n九灵变化俄离合，羽驾飘飖不可穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其七","author":"赵佶","text":"东井中涵皓月精，群龙奋搦运金罂。\n仙人灌沐知何代，唯见玻瓈透骨明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]