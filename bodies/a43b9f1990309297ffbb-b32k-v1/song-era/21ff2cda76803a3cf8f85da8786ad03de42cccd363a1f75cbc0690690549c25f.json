[{"title":"艮岳百咏 蟠桃岭","author":"李质","text":"不到瑶台白玉京，海中仙果但闻名。\n何人为报西王母，岭上如今种已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 梅岭","author":"李质","text":"雪林横夜月交光，万壑风来处处香。\n圣主乾坤为度量，包藏曾不限遐荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 三秀堂","author":"李质","text":"窗户深沈昼不开，凤凰时下九层台。\n月明夜静闻环佩，知有霓旌羽扇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 萼绿华堂","author":"李质","text":"绿萼承趺玉蕊轻，清香续续度檐楹。\n天教不杂开桃李，赐与神仙物外名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 岩春堂","author":"李质","text":"桂影亭亭漾碧溪，寻芳曾被暗香迷。\n碧桃开后晴风暖，花外幽禽自在啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 蹑云台","author":"李质","text":"万本琅玕密不开，林深明碧锁高台。\n更无一点游尘到，但觉云随步步来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 玉霄洞","author":"李质","text":"披香寻径百花中，蝶引蜂随路不穷。\n但见凌霄缠古木，洞天应与碧虚通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 清虚洞天","author":"李质","text":"玉关金锁一重重，只见桃源路暗通。\n行到水云空洞处，恍如身世在壶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 和容厅","author":"李质","text":"白羽流星一点明，上林飞雁几回惊。\n弓开月到天心满，风外唯闻中的声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 泉石厅","author":"李质","text":"萦迂流碧与环山，月地云阶在两间。\n有此清泠居物外，方知尘土属人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 挥云亭","author":"李质","text":"天风吹作海涛声，挥斥浮云日更明。\n波上石鲸时吼雨，只知楼阁是蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 泛雪厅","author":"李质","text":"月团携下九重天，来试人间第一泉。\n正在水声山色里，六花浮动紫瓯圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 虚妙斋","author":"李质","text":"武王屈己尊箕子，黄帝斋心问广成。\n惟道集虚观众妙，超然将见不能名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 寿山","author":"李质","text":"结构崇高秀气连，清风不老月长圆。\n春游玉座时相对，花发莺啼亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 杏岫","author":"李质","text":"山上晴霞兴綵云，芳菲时节避花繁。\n分明自有神仙种，不是青旗卖酒村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 景龙江","author":"李质","text":"润通河汉碧涵空，影倒光山晓翠重。\n闻说巨鱼时骇浪，只应风雨是神龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 鉴湖","author":"李质","text":"水天澄澈瑩寒光，一片平波六月凉。\n移得会稽三百里，不教全属贺知章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 桃溪","author":"李质","text":"霏霏红雨落清浔，流出山中直至今。\n休道仙源在平地，空教人向武陵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 回溪","author":"李质","text":"穿云透石落潺潺，恋浦馀波尚绕山。\n只怪岚光迷向背，不知流水正回环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 滴滴岩","author":"李质","text":"苍苔青润石嶙皴，泉脉涓涓湿白云。\n疑有天仙深夜过，丁当环佩月中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 榴花岩","author":"李质","text":"绝域移根上苑栽，又分红绿向岩隈。\n累累子已枝间满，灼灼花犹叶底开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 枇杷岩","author":"李质","text":"结根常得近林峦，晚翠谁怜却岁寒。\n不见龙文横杆面，方知垂实作金丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 日观岩","author":"李质","text":"朝阳初上海霞红，五色云生碧洞中。\n回首烂柯人自老，棋声犹在石门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 雨花岩","author":"李质","text":"纷纷泊泊弄晴晖，曾逐春风上绣衣。\n不为胡僧翻贝叶，仙家长有碧桃飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 芦渚","author":"李质","text":"万叶梢梢秋意初，斜风细雨忆江湖。\n谁知雪压波澄后，更与宫中作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 梅渚","author":"李质","text":"只借晴波为晓鉴，不随花岛作江云。\n未须吹笛风中去，多得清香水际闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 榠查谷","author":"李质","text":"折花宜与酒相薰，结子难随酒入唇。\n一阵暗香无处觅，不知幽谷巧藏春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 秋香谷","author":"李质","text":"玉屑花繁淡淡黄，碧岩曾伴紫栏芳。\n月明露洗三秋叶，山迥风传七里香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 松谷","author":"李质","text":"云藏烟锁昼苍苍，得地何须作栋梁。\n闻道九龙扶辇过，一山风又作笙簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 长春谷","author":"李质","text":"洞天风物几人知，暗得阴阳造化机。\n不似寒乡待邹律，四时岩际有芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 桐径","author":"李质","text":"不嫌春老花飞湿，要听秋来雨打声。\n一自移根来禁籞，朝阳常有凤凰鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 松径","author":"李质","text":"夹路成行一样清，吟风筛月自亭亭。\n云章正写人间瑞，坐待云根长茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 百花径","author":"李质","text":"红紫交加一径通，翠条柔蔓浴玲珑。\n日晴烟暖微风度，百和香薰锦绣中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 合欢径","author":"李质","text":"綵丝拂拂机中锦，绣缕茸茸马项缨。\n却似汉宫三十六，黄昏时节掩罗屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 竹径","author":"李质","text":"翠叶吟风长淅沥，寒梢擎露忽高低。\n有时杳杳穿云去，碧玉交加四望迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 雪香径","author":"李质","text":"夹径梨花玉作英，年年寒食伴阴晴。\n要看雪色无边际，十二楼前月正明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 海棠屏","author":"李质","text":"清明微雨欲开时，收拾狂香付整齐。\n但得浣花春在眼，不须枝上杜鹃啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 百花屏","author":"李质","text":"众香芬馥著人衣，云母光寒露未晞。\n围得春风胜绣幕，纷纷红紫斗芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 蜡梅屏","author":"李质","text":"冶叶倡条不受羁，翠筠轻束最繁枝。\n未能隔绝蜂相见，一一花房似蜜脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 飞来峰","author":"李质","text":"突兀初惊倚碧空，翠岚仍与瑞烟重。\n吴侬莫作西来认，真是蓬莱第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 留云石","author":"李质","text":"白云何事苦留连，中有嵌空小洞天。\n却恐商岩要霖雨，因风时到日华边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 宿雾石","author":"李质","text":"飞烟自绕龙楼驻，瑞气长随海日开。\n独有春风花上露，夜深多伴月明来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 辛夷坞","author":"李质","text":"山中常压早梅开，不待暄风暖景催。\n似与东君书造化，笔头春色最先来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 橙坞","author":"李质","text":"磊磊金丸画不如，空濛香雾几千株。\n应怜绿橘秋江上，却被人间唤木奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 海棠川","author":"李质","text":"清明时候暖风吹，叶暗花明满目开。\n石在剑门犹北向，锦江春色亦须来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 仙李园","author":"李质","text":"亳社灵踪亘古存，混元龙蜕出风尘。\n移根更接蟠桃岭，结子开花万万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 紫石壁","author":"李质","text":"没水攀萝琢马肝，赍持坚润出风湍。\n潜藩每恨端溪远，叠作山中峭绝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 椒崖","author":"李质","text":"团枝红实见秋成，曾按方书合五行。\n不遣汉宫涂屋壁，此间吞饵得长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 濯龙峡","author":"李质","text":"山束苍烟细路通，喷泉飞雨洒晴空。\n真龙岂许寻常见，故作云间饮涧虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 不老泉","author":"李质","text":"来从云窦不知远，涌出碧岩无暂停。\n花落莺啼春自晚，潺湲长得坐中听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 柳岸","author":"李质","text":"牵风拂水弄春柔，三月花飞满御楼。\n不似津亭供怅望，一生长得系龙舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 栈路","author":"李质","text":"六丁开处只通秦，此地天临万国春。\n驻跸有时思叱驭，服劳王事爱忠臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 药寮","author":"李质","text":"已闻颁朔向明堂，百草犹思一一尝。\n天意应怜民疾苦，欲跻仁寿佐平康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 太素庵","author":"李质","text":"结草铺茅不用华，白云深处列仙家。\n萧骚风雨千竿竹，翠叶浓阴衬碧霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 祈真磴","author":"李质","text":"台上炉香袅翠烟，云间风驭已翩翩。\n吾皇奉道明灵降，惟德从来可动天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 踯躅岿","author":"李质","text":"春风晓日乱晴霞，艳艳初开一岿花。\n疑是仙琴红玉轸，醉归遗在紫皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 山庄","author":"李质","text":"重崖置屋亦常关，下法龙眠小隐山。\n纵有青牛不耕稼，但闻犬吠白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 西庄","author":"李质","text":"低作柴扉短作篱，日晴鸡犬自熙熙。\n躬耕每以农为本，稼穑艰难旧亦知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 东西关","author":"李质","text":"天上人间自不同，故留关钥限西东。\n姓名若在黄金籍，日日朝元路自通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"艮岳百咏 敷春门","author":"李质","text":"帝力无私万国通，尚思寒谷待春风。\n欲将和气均天下，都在熙熙造化中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"李质","text":"古木愁撑月，危峰散堕江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"谢泂","text":"溪瘦玉声小，山横翠色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送童宣抚平燕班师","author":"詹度","text":"长亭春色送英雄，满目江山映日红。\n剑戟夜摇杨柳月，旌旗晓拂杏花风。\n行时一决平戎策，到后须成济世功。\n为报燕山诸将吏，太平取在笑谈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读翠微集","author":"盖屿","text":"圣宋吟哦只九僧，诗成往往比阳春。\n翠微阁上今朝见，格老辞清又一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同程致道著作次鲍溶冬夜答客韵送赵叔问奉议归南都","author":"方元修","text":"清秋不相借，白发日更多。\n尘埃困烦促，原野怀经过。\n聊当倚滂润，资以生吾禾。\n岂不念离群，惊鹊宁择窠。\n王孙别都去，澹若依松萝。\n暂别亦复难，赓诗饮无何。\n我行那尔尔，渺邈踰江河。\n剩须作佳句，相我沧浪歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月七日初见梅花","author":"方元修","text":"雪净冰融溪作鳞，梅花经眼日当人。\n北枝风力顾不早，东阁诗情聊一新。\n烟并博山薰莫乱，色同衰鬓插宜新。\n一年好处得全尽，红绽雨肥犹弄春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"杨信祖","text":"共约城南方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白龟泉","author":"皇甫涣","text":"灵台尘不止，尘止非灵台。\n爱此一泓水，曾栖灵物来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释文准弟子","text":"寒食因悲郭外春，野田无处不伤神。\n林间累累添新冢，半是去年来哭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿禅房院","author":"程祁","text":"山庵极回互，禅房深晦藏。\n红尘来不到，虚室自生凉。\n好鸟时孤啭，幽兰静亦香。\n征车又晓去，终恨世缘长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再宿禅房院五首 其一","author":"程祁","text":"作意寻兰若，重来是有缘。\n眼前真是喜，境熟故依然。\n归迹休论静，收心莫话禅。\n廊虚剩看月，照影枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再宿禅房院五首 其二","author":"程祁","text":"暂屏喧嚣想，来寻断续香。\n微风吹客袂，孤月照禅房。\n静起劳生念，闲谙养性方。\n攲眠不成梦，夜久转清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再宿禅房院五首 其三","author":"程祁","text":"春兰与秋菊，各是一时花。\n芳馥聊应尔，淹留定自佳。\n客尘随处有，归梦计程赊。\n采采眼前物，令人惜岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再宿禅房院五首 其四","author":"程祁","text":"策策日乾禾，萧萧风晚木。\n秋容全未老，岁事十分熟。\n寺古断行迹，林幽聊税足。\n遥闻击壤响，知是先年曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再宿禅房院五首 其五","author":"程祁","text":"献计忧不售，逃形惟愿深。\n老来销外念，闲处惬幽寻。\n晚草媚迟景，残蝉噪暝林。\n欲将诗遣兴，谁解此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽三灵山人","author":"程祁","text":"昔读先生传，埋铭属鄙文。\n里门经岁别，人事一朝分。\n宿诺成虚语，遗言忍重闻。\n伤心吟楚些，知我不欺君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴集","author":"程祁","text":"九老当年乐有馀，于今五老更欢娱。\n乔松百尺倚天外，也许蒿莱入画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其一","author":"赵佶","text":"涂丹辉映霁烟明，四启严闻晓漏清。\n初御广庭人意肃，九宫遥听警鞭声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]