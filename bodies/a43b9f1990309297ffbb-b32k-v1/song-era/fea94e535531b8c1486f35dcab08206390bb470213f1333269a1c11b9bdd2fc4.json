[{"title":"渔家傲 其一 春月","author":"黄裳","text":"多幸春来云雨少。\n且教月与花相照。\n清色真香庭院悄。\n前事杳。\n还嗟此景何时了。\n莫道难逢开口笑。\n夜游须趁人年少。\n光泛雕栏寒料峭。\n迂步绕。\n不劳秉烛壶天晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其七 斜月","author":"黄裳","text":"已送清歌归去后。\n东南楼上人声悄。\n冷落尤临弦上调。\n欢意少。\n空将万感收残照。\n窗外剑光初出鞘。\n斜窥梦断人年少。\n未到盖棺心未了。\n尘虑扰。\n双眸竟入扶桑晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其二 夏月","author":"黄裳","text":"汗漫金华寒委地。\n火云散尽奇峰势。\n纨扇团圆休与比。\n犹可喜。\n恩情不怕凉飙至。\n梦冷魂高何处寄。\n琉璃砌上笼人睡。\n逃暑广寒宫似水。\n缘有累。\n乘风却下人间世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 其五 端午泛湖","author":"黄裳","text":"梅霖初歇。\n乍绛蕊海榴，争开时节。\n角黍包金，香蒲切玉，是处玳筵罗列。\n斗巧尽输少年，玉腕彩丝双结。\n舣彩舫，看龙舟两两，波心齐发。\n奇绝。\n难画处，激起浪花，飞作湖间雪。\n画鼓喧雷，红旗闪电，夺罢锦标方彻。\n望中水天日暮，犹见朱帘高揭。\n归棹晚，载荷花十里，一钩新月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺 表海亭冬日闲宴","author":"黄裳","text":"雕栏闲倚，瑞雪霁、浣出人间金碧。\n下想名园，芳心多少，欲占九州颜色。\n洞开路入丹汉，自是神仙真宅。\n寒吟外，看歌云舞雪，光阴难得。\n谁共怀古意，东海一老，居易头垂白。\n自此英雄，功名相继，空有寂寥遗迹。\n圣贤电拂休笑，离合许多宾客。\n使君乐与人同，且对云门斜日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜朝天/踏莎行 腊中雪后东湖闲宴","author":"黄裳","text":"雪云浓。\n送愁思，衾寒更怯霜风。\n惹起离恨，为光阴恼，人意无穷。\n谁省年华屡换，渐作个、浮生玉髯翁。\n休易感，新醅泛蚁，且共时同。\n相逢。\n笑语相契，况驾言游处，山里齐宫。\n寂寞时候，自有皓景，粉泽冬容。\n先顾丽人期约，痛赏候、花开洛城红。\n三十日，回头过尽，喜对春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荷叶 雨中泛湖","author":"黄裳","text":"落日衔山，行云载雨俄鸣。\n一顷新荷，坐间疑是秋声。\n烟波醉客，见快哉、风恼娉婷。\n香和清点，为人吹在衣襟。\n珠佩欢言，放船且向前汀。\n绿伞红幢，自从天汉相迎。\n飞鸥独落，芦边对、几朵繁英。\n侑觞人唱，乍闻应似湘灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 东湖观莲","author":"黄裳","text":"绿盖纷纷，多少个、云霄仙子。\n应是有，瑶池盛会，靓妆临水。\n无奈轻盈风信急，瑞香乱翠红相倚。\n谁共吟、此景竹林人，桃溪士。\n时雨过，明珠细。\n朝雾染，香腮腻。\n轻舟破幽径，烦襟都洗。\n第一朵须寻华池景，寿觞边偶得龟千岁。\n乘兴泻、云液落新荷，休辞醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳 咏浮桥","author":"黄裳","text":"琼馆烟轻，银河风细，玉桥云锁方开。\n晓虹千丈，宛转下天来。\n人在水精宫里，行乐处、锦绣成堆。\n仍相问，人间天上，何处有蓬莱。\n徘徊。\n追往事，征南巧架，傅野怀才。\n谩石驱东海，沙合龙台。\n好是乐成初宴，红牙碎、声隐晴雷。\n江天晚，游人未散，莫放隼旟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满路花/促拍满路花 和秋风吹渭水","author":"黄裳","text":"乾坤生古意，草木起秋声。\n移人名利境，梦中惊。\n便寻灵宝，凤髓与龟精。\n密报黄芽就，紫府门开，道情有个莺莺。\n问归含楚山青。\n卧影水天明。\n松庵谁笑话，见还婴。\n鹤归日落，聚散两忘情。\n好笑人痴处，白头青冢，世间犹说醒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 腊日游尧山","author":"黄裳","text":"春前信息，到处欢声满。\n旌旆出西郊，拥笙歌、婵娟两畔。\n东巡事往，空有雪中山，仙驭悄，古风间，谩动吟人叹。\n天边身世，况值重华旦。\n击壤访遗民，想如云、望中不断。\n功名休论，齐楚共唐虞，开口笑，插花归，更候清秋晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锦堂春/锦堂春慢 玩雪","author":"黄裳","text":"天女多情，梨花碎剪，人间赠与多才。\n渐瑶池潋滟，粉翘徘徊。\n面旋不禁风力，背人飞去还来。\n最清虚好处，遥度幽香，不掩寒梅。\n岁华多幸呈瑞，泛寒光，一样仙子楼台。\n虽喜朱颜可照，时更相催。\n细认沙汀鹭下，静看烟渚潮回。\n遣青蛾趁拍，斗献轻盈，且更传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑶池月/瑶台月 其一 云山行","author":"黄裳","text":"微尘濯尽，栖真处、群山排在云汉。\n青盘翠跃，掩映平林寒涧。\n流水急、数片桃花逝，自有留春仙馆。\n秦渔问，前朝换。\n卢郎待，今生满。\n谁伴。\n元翁笑语，相从未晚。\n更安得、世味堪玩。\n道未立、身尤是幻。\n浮生一梭过，梦回人散。\n卧松庵、当会灵源，现万象、无中须看。\n乾坤鼎，阴阳炭。\n琼枝秀，金圆烂。\n何患。\n朝元事往，孤云难管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑶池月/瑶台月 其二 烟波行","author":"黄裳","text":"扁舟寓兴，江湖上、无人知道名姓。\n忘机对景，咫尺群鸥相认。\n烟雨急、一片篷声碎，醉眼看山还醒。\n晴云断，狂风信。\n寒蟾倒，远山影。\n谁听。\n横琴数曲，瑶池夜冷。\n这些子、名利休问。\n况是物、都归幻境。\n须臾百年梦，去来无定。\n向婵娟、留住青春，笑世上、风流多病。\n蒹葭渚，芙蓉径。\n放侯印，趁渔艇。\n争甚。\n须知九鼎，金砂如圣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一 月词","author":"黄裳","text":"忽破黄昏还太素。\n寒浸楼台，缥缈非烟雾。\n江上分明星汉路。\n金银闪闪神仙府。\n影卧清光随我舞。\n邂逅三人，只愿长相聚。\n今月亭亭曾照古。\n古人问月今何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其七 劝酒致语","author":"黄裳","text":"万籁无声天地静。\n清抱朱弦，不愧丹霄镜。\n照到林梢风有信。\n抬头疑是梅花领。\n万感只应闲对景。\n独倚危栏，扰扰人初定。\n吟不尽中愁不尽。\n溪山千古沈沈影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"高下亭台山水境。\n两畔清辉，中有垂杨径。\n鹭点前汀供雪景。\n花乘流水传春信。\n不醉无归先说定。\n醉待言归，又被风吹醒。\n月下壶天游未尽。\n广寒宫是波中影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其三 东湖","author":"黄裳","text":"南北两山骄欲斗。\n中有涟漪，莫道壶山小。\n落落情怀临漂渺。\n驾言来处铃斋悄。\n行到桃溪花解笑。\n人面相逢，竞好窥寒照。\n醉步敧斜西日少。\n欢声犹唱多情调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其九","author":"黄裳","text":"忽送林光禽有语。\n飞入遥空，失素归洲鹭。\n照处无私清望富。\n馀辉不惜人人与。\n玉绳欲到中天路。\n且待飞觞，缓缓移琼步。\n花下影圆良夜午。\n东南楼上还相顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"千二百回圆未半。\n人世悲欢，此景长相伴。\n行到身边琼步款。\n金船载酒银河畔。\n谁为别来音信断。\n那更蟾光，一点窥孤馆。\n静送忘言愁一段。\n会须莫放笙歌散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"黄裳","text":"一望瑶华初委地。\n更约幽人，共赏岩边翠。\n试把方诸聊与试。\n无情争得无中泪。\n飞瀑恐从星汉至。\n渐向宾筵，但觉寒如水。\n自爱一轮方得意。\n轻随箕毕还成累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"兴到浓时春不住。\n昨夜雕栏，放了花无数。\n谈笑急邀吟醉侣。\n青娥也合随轩去。\n媚恐情生娇恐妒。\n今日开尊，多幸无风雨。\n休唱宴琼林一句。\n来年花共人何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"水鉴中看尤未老。\n乘兴拿舟，更向湘江过。\n俯仰太虚都一个。\n九春风思谁吟到。\n闲上钓台云外坐。\n待得金鳞，始放芳尊倒。\n醉后言归犹更早。\n素纤有数君须道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"黄裳","text":"古往今来忙里过。\n今古清光，静照人行道。\n难似素娥长见好。\n见频只是催人老。\n欲驻征轮无计那。\n世上多情，却被无情恼。\n夜夜乌飞谁识破。\n满头空恨霜华早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"满到十分人望尽。\n仙桂无根，到处留光景。\n听我尊前欢未竟。\n金卮已弄寒蟾影。\n银色界中风色定。\n散了浮云，宝匣初开镜。\n归去不须红烛影。\n天边自与人相趁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"人逐金乌忙到夜。\n不见金乌，方见人闲暇。\n天汉似来尊畔泻。\n须知闲暇欢无价。\n银色满身谁可画。\n两腋风生，爽气骎骎马。\n待入蟾宫偷造化。\n姮娥已许仙方借。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其八","author":"黄裳","text":"谁悟月中真火冷。\n能引尘缘，遂出轮回境。\n争奈多情都未醒。\n九回肠断花间影。\n万古兴亡闲事定。\n物是人非，杳杳无音信。\n问月可知谁可问。\n不如且醉尊前景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一 牡丹","author":"黄裳","text":"每到花开春已暮。\n况是人生，难得长欢聚。\n一日一游能几度。\n看看背我堂堂去。\n蝶乱蜂忙红粉妒。\n醉眼吟情，且与花为主。\n雪怨云愁无问处。\n芳心待向谁分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"俄落盏中如有恋。\n盏未乾时，还见霜娥现。\n说向翠鬟斟莫浅。\n殷勤此意应相劝。\n光景尤宜年少面。\n千里同看，不与人同怨。\n席上笑歌身更健。\n良时只愿长相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"黄裳","text":"杳杳晴虚寒漫漫。\n放下尘劳，相共游银汉。\n便入醉乡休浩叹。\n神仙只在云门馆。\n饮兴偏宜流水畔。\n时有红蕖，落在黄金盏。\n鹭未忘机移别岸。\n画船更上前汀看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜叶飞 冬日闲宴","author":"黄裳","text":"谁能留得年华住。\n韶华今在何处。\n万林飞尽，但惊天篆，半空无数。\n望消息、霜催雁过，佳人愁起云垂暮。\n就绣幕、红炉去。\n金鸭时飘异香，柳腰人舞。\n休道行且分飞，共乐还一岁，见景长是欢聚。\n大来芳意，既与名园，是花为主。\n翠娥说、尊前笑语，来年管取人如故。\n向寂寞，中先喜，俄顷飞琼，化成寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 青丝木香","author":"黄霁宇","text":"丽华一握青丝，金珠粟粟香环里。\n春窥绮阁，新妆风舞，铢衣如碎。\n翠凤苍虬，骑来下界，蝶惊蜂避。\n甚三生富贵，垂垂晓露，犹凝满身珠翠。\n谁共那人结发，问何时、蹇修为理。\n对花一笑，香茸易剪，碎金难缀。\n半点芳心，乱愁如织，缕丝传意。\n倩东皇、拂拭新条，更与作、来生计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花","author":"黄静斋","text":"雨后桃花作片飞，风前柳絮点人衣。\n春归不用怨风雨，无雨无风春亦归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南","author":"黄静淑","text":"君去也，晓出蓟门西。\n鲁酒千杯人不醉，臂鹰健卒马如飞。\n回首隔天涯。\n云黯黯，万里雪霏霏。\n料得江南人到早，水边篱落忽横枝。\n清兴少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"支提禅寺","author":"黄履翁","text":"福地由来此最幽，翠微深锁碧山头。\n参差梵阁云常护，隐现神灯夜不收。\n面壁几人曾入定，摩崖有客记同游。\n从今悟道支提处，知是名高十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄德明","text":"晚烟晴带湿，春雾暖生香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送水云归吴","author":"黄慧真","text":"万叠燕山冰雪劲，万里长城风雨横。\n君衣云锦勒花骢，此酒一杯何日更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚塞楼","author":"黄播","text":"楼上何由楚塞名，楚人曾此设重扃。\n固知宇宙同文轨，聊把江山作障屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武夷山","author":"黄遹","text":"闲将绿绮弄清音，招得青山作故人。\n烟霭谩呈千样巧，松篁长贡四时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南山堂","author":"黄遹","text":"幸然闭阁文书静，何必衔杯笑语频。\n只把悠然无限意，散为和气万家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张无梦归天台","author":"黄震","text":"想别岐周不记年，丹丘高卧好林泉。\n飞名已出红尘外，放迹才辞紫殿前。\n虚室先输君静坐，野云终俟我閒眠。\n长歌宸翰真皇赐，袖去须知世世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"黄震喜","text":"手挹龙头蹽龙脊，山耸螺鬟水澄碧。\n酒酣一笑且掀髯，春日融融浮霁色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄樵仲","text":"俸薄俭亦足，官卑清自尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉泉","author":"黄朴","text":"水性能方圆，泉色常圭璧。\n云山静有辉，琼液来无迹。\n泉上修禅人，曹溪分一滴。\n鉴止更澄源，纷纷万缘息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程给事知越州","author":"黄默","text":"会稽山水古来雄，内史新除捧诏东。\n何藉扁舟追范蠡，更将一钓问任公。\n久谙偃息藩垣乐，未试调和鼎鼐功。\n日食万钱谁吝惜，不知蓬岛属诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄稹宅","author":"黄燮","text":"大夫桥畔水繁华，春满郊原树满花。\n石马导前蒙御葬，数声鸡犬是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游登高山","author":"黄麟","text":"上至登高眼界宽，蜜陀僧舍富琅玕。\n天雄峻塔淩穹漠，泽泻巍阶铁护栏。\n虎脑已回仙枕梦，鸡头宁愧国香兰。\n登临岂止黄花日，川练常随夜月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南湖","author":"龚大明","text":"梅霖初歇水平湖，湖上青山展画图。\n更著楼台相掩映，风流端不减西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和鹤林吴泳题艮泓轩","author":"龚大明","text":"知与坡仙有宿盟，来贤岩畔旧经行。\n节同老柏岁寒操，心契焦桐太古声。\n云出九峰龙起蛰，风清五夜鹤传鸣。\n须公一柱擎天力，妙斡洪钧大发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道友怡云潘先生","author":"龚大明","text":"九转工夫真妙绝，丹炉进火徐徐热。\n离龙坎虎自归降，姹女婴儿共欢悦。\n天机密运造元微，精采神光迥然别。\n枝头结果有时红，骖鸾跨鹤神仙列。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"捣练子 赠道友雪崖朱先生","author":"龚大明","text":"清高绝，雪崖翁，向上元机顿观通。\n金鼎有丹成九转，凝然宴坐白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居 其四","author":"龚大明","text":"山居好，山居好，斸月锄云种瑶草。\n泠泠碧涧响寒泉，蔌蔌落花风自扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居 其三","author":"龚大明","text":"山居好，山居好，竹杖芒鞋恣幽讨。\n坐分苔石树阴凉，閒数落花听啼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居 其二","author":"龚大明","text":"山居好，山居好，门对青山水环绕。\n一榻烟霞梦寐清，我以不贪为至宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居 其一","author":"龚大明","text":"山居好，山居好，鹤唳猿啼饯昏晓。\n碧窗柏子炷炉香，趺坐蒲团诵黄老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 书怀","author":"龚大明","text":"我本无为野客，飘飘浪迹人间。\n一时被命住名山。\n未免随机应变。\n识破尘劳扰扰，何如乐取清闲。\n流霞细酌咏诗篇。\n且与白云为伴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黑马图","author":"龚开","text":"八尺龙媒出墨池，昆崙月窟等闲驰。\n幽州侠客夜骑去，行过阴山鬼不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵鸥波高士图","author":"龚开","text":"雪气侵人卧欲僵，苦劳明府到藜床。\n主宾问答皆情语，何用閒名入荐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陆右丞君实挽诗 其二","author":"龚开","text":"数关天地人何预，分在君臣礼可无。\n周粟如山夷叔馁，史书犹日臼婴诬。\n旧邦新命方开化，公法私情本不渝。\n忠义未须论彼此，后先崇长是昌图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陆右丞君实挽诗 其一","author":"龚开","text":"立事宁将败事论，在边难与在朝分。\n从来大地为沧海，可得孤臣抱幼君。\n南北一家今又见，乾坤再造古曾闻。\n他年自有春秋笔，不比田横祭墓文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一字至七字观周曾秋塘图有作","author":"龚开","text":"秋，秋。\n潇洒，清幽。\n人静处，水边头。\n波纹细细，风色飕飕。\n鸥鹭情相狎，凫鹥乐自由。\n疏苇败荷池沼，白蘋红蓼汀洲。\n几竿渔钓去已尽，一段晚云寒不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儿子咸画雁老人作江天仍作诗命咸书卷上","author":"龚开","text":"朔方六月犹有雪，江南十月冰未结。\n雁门一夜起秋风，飞到江南未八月。\n江南处处多稻粱，景物何独为潇湘。\n沙汀月暗渔火起，警奴一夜空荒忙。\n休言汝肉不登俎，全身已被家儿取。\n犹幸先生有爱心，放汝长江得容与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]