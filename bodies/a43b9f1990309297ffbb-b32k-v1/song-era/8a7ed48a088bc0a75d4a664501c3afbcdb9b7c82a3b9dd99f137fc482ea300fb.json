[{"title":"送泽长老往南方","author":"邹浩","text":"枝头挑着祖师禅，走遍三千与大千。\n又被草鞋勾引去，善财游处弄云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招梦臣","author":"邹浩","text":"春色集檐楹，今朝兴倍生。\n一樽谁与共，促驾有豪英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仁老所画枕屏 其一","author":"邹浩","text":"昔侍先君官四明，往来皆向此中行。\n昊天欲报嗟何及，空对小屏无限情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仁老所画枕屏 其二","author":"邹浩","text":"万顷红蕖照落晖，五云门外贺家池。\n别来无复当时兴，二十四年空自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仁老所画枕屏 其三","author":"邹浩","text":"古堰横空舟楫回，曹娥江上候潮来。\n全家弥月寒光里，日日鲜鳞醉泼醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仁老所画枕屏 其四","author":"邹浩","text":"天华寺前维小舟，僧窗轩豁留清眸。\n平湖秋霁净如镜，时复轻轻飞白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仁老所画枕屏 其五","author":"邹浩","text":"身在九疑麓，门当二水流。\n谁知剡中胜，朝夕助嬉游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示愚溪守道山主","author":"邹浩","text":"叉手前来问我禅，我无言句与人传。\n一杯茶罢抽身起，笑指长松直上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和李馀庆","author":"邹浩","text":"三分春色一分空，莫负花前酒满钟。\n醉里是非浑忘却，任它禅客自分宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仙居阁","author":"邹浩","text":"心镜圆明照不穷，晋公元自宝青铜。\n真人外景虽能睹，争识希夷造化功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霞老于云会堂后开小轩为以览胜名之因示短句","author":"邹浩","text":"潇湘之胜渺无穷，尽入西轩一览中。\n须信高山巧方便，为人别自有家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西邻葛长源司录到","author":"邹浩","text":"邻舍南来不得书，口传消息到吾庐。\n白云入望无休歇，何日斑衣奉版舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸦鸣","author":"邹浩","text":"老鸦声里度朝昏，凶吉由来我不分。\n惟有渊明心莫逆，一函经罢醉醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"邹浩","text":"长折松枝为麈尾，圆刳杉树作茅庵。\n本来面目无人识，却许江山静处参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望澹山","author":"邹浩","text":"澹山形势冠零陵，咫尺拘挛去未能。\n怅望烟霞今阻隔，尚期归路一来登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移居昭州 其一","author":"邹浩","text":"广南东西四十州，瘴疠莫与新昭侔。\n我身多病亦知免，陛下仁同天地流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移居昭州 其二","author":"邹浩","text":"日日闻人说桂州，桂州朝夕遂经由。\n自怜罪大当踰岭，深荷皇恩不远投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移居昭州 其三","author":"邹浩","text":"忠孝从来不两全，两无忠孝倍堪怜。\n自新有路君恩重，犹冀它时不愧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览镜","author":"邹浩","text":"览镜朝来心自知，鼻端色动有光辉。\n乡邦回首见归路，已觉欢欣生綵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滩声 其一","author":"邹浩","text":"长滩斗折转城隅，激浪飞声昼夜俱。\n猛讶龙骧带雷雨，缓疑仙会集笙竽。\n吟风古木那能和，弄影幽禽只自娱。\n我已无心到天籁，凭栏聊为一踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滩声 其二","author":"邹浩","text":"洗耳何须颍水清，淫哇涤去有滩声。\n宫商别奏天然曲，淡薄追还物外情。\n聊与沙鸥均至乐，谩同渔父引馀觥。\n个中一拍谁人会，长啸归来烟雾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻州学补试","author":"邹浩","text":"辟廱泮水旧先生，十五馀年经自横。\n今日传闻试多士，尚疑身复任权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀詹成老","author":"邹浩","text":"胸中云梦向来宽，妙入微尘心更安。\n天北梧桐正鸣凤，江东枳棘尚栖鸾。\n渊明可是忘三径，下惠犹能仕小官。\n何日相从坐金粟，静听飞雪洒琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀霍子侔","author":"邹浩","text":"平时咳唾落珠玑，未掌丝纶亦数奇。\n远去天官空帐幄，中分淮水动旌旗。\n圜扉荡涤民知免，列位搜扬士不遗。\n报国功成有馀日，也应回首念流离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀何伯震","author":"邹浩","text":"我别家时君在床，后来南北两相忘。\n直饶伏枕到新岁，也胜投身居瘴乡。\n孤节未尝交世俗，清贫何以度星霜。\n皇天默相谁窥得，看取它年吾道光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀张晋卿","author":"邹浩","text":"年少东邻新亲家，奋然鳞鬣脱泥沙。\n传闻昨者数时弊，想见迩来双鬓华。\n局上光阴聊斗马，杯中意气莫生蛇。\n江鲈已过河鲀出，准拟从君烹荻芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀黄光晖","author":"邹浩","text":"远托同门寄好音，夫君不改岁寒心。\n因思明月共千里，亦似家书抵万金。\n美玉会开和氏璞，高山犹袐伯牙琴。\n真人训诰知无爽，快我它时朋盍簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招泽老","author":"邹浩","text":"门向山城静处开，更无一点旧尘埃。\n葛藤尚忆龙溪老，拄杖横担便可来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道傍妇","author":"邹浩","text":"长插双钗低系裙，手持青伞步如云。\n忽然退傍芭蕉立，元是前头逢伯君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀至明弟","author":"邹浩","text":"青衫虽已被天恩，蹩躠难趋犹杜门。\n分手于今十个月，寄书何事一无言。\n但勤药饵宽吾母，休费心神接乃昆。\n我罪湔除归有路，綵衣相与应篪埙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀至远弟","author":"邹浩","text":"机警如君亦可人，经营门户不因循。\n须知孝友是为政，莫叹功名难奋身。\n北塔杉松培万本，东皋禾黍列千囷。\n尔兄倍觉归来好，百事无为只奉亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀承天岑老","author":"邹浩","text":"记得承天老古锥，呵呵拍手几人知。\n年来饱饭应无数，门外小桥真可为。\n浙右普瞻圆照塔，室中高挂建降师。\n我身虽窜心如昨，落笔犹能挥寺碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦秦少游","author":"邹浩","text":"淮海维扬第一流，三关齐透万缘休。\n真心岂复随灰劫，遗骨终然寄橘州。\n专为流通深叹赏，莫相钝置豁愁忧。\n觉来欲语无人听，屋角荧荧空斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻放归田","author":"邹浩","text":"天地曾无一物遗，孤臣今许返庭闱。\n黄茅瘴里抽身出，青草湖边鼓棹归。\n衣锦还乡难并比，承颜称寿倍光辉。\n恩深骨肉何由报，空有精诚贯紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曾敷文","author":"邹浩","text":"谁道衡阳雁即回，也传书向岭南来。\n故人得报皇恩至，约我同归青眼开。\n爽有江湖清暑气，豁无尘土溷灵台。\n功曹法掾相随处，邂逅追踪真快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠湘西琳老","author":"邹浩","text":"八年之中三往回，道人一意金石开。\n非干桑梓有分好，自是针芥无嫌猜。\n焚香说了四句偈，把手直上千尺台。\n洞庭青草不我隔，东吴可归归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻霍仁仲唱名第一","author":"邹浩","text":"吾乡魁选久萧条，深喜高才偶圣朝。\n天子六龙飞紫极，状元一鹗奋丹霄。\n拜亲此日荣谁及，报国他时事更超。\n四海欢然重改观，常州真是出英标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜归","author":"邹浩","text":"日日思归今得归，朝衣不着着斑衣。\n谁人得似邹居士，跳出轮回无是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"邹浩","text":"不雨人忧旱，晨兴忽沛然。\n早禾欣长王，炎瘴敢留连。\n气象还丰岁，歌谣动乐川。\n皇恩亦如此，特放我归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归先寄道乡","author":"邹浩","text":"自作中都吏，道乡难更居。\n今予返田里，就尔乐琴书。\n闭户温生席，开窗凉满裾。\n年来通物理，得计在渊鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"川涨","author":"邹浩","text":"昨朝清露石，今日涨汀湾。\n翕受无边水，流来有众山。\n鱼龙随浪跃，鸥鹭掠波还。\n因念盈虚数，高楼一破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山禽","author":"邹浩","text":"何处飞来傍隐居，就中声与众禽殊。\n长拖缓转娇无力，一似汴孙吹画乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凭栏","author":"邹浩","text":"朝天坊里朝天客，北去朝天已赐环。\n从此昭平梦不到，剩凭栏槛看青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"修仁茶 其一","author":"邹浩","text":"味如橄榄久方回，初苦终甘要得知。\n不但炎荒能已疾，携归北地亦相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"修仁茶 其二","author":"邹浩","text":"岭南州县接湖南，处处烹煎极口谈。\n北苑春芽虽绝品，不能消鬲禦烟岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"修仁茶 其三","author":"邹浩","text":"龙凤新团出帝家，南人不顾自煎茶。\n夜光明月真投暗，怅望长安天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得家书","author":"邹浩","text":"乌鹊每来檐外集，蛛丝时向眼边明。\n心知有喜寻归路，今日音书果见迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又得敷文书","author":"邹浩","text":"一封黄敕下天关，岭表湖南释旧跧。\n吏部回头真可笑，拾遗作伴竟同还。\n张公洞里花流水，扬子江边雪满山。\n更约家居多暇日，相从莫遣鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀成老","author":"邹浩","text":"乐平主簿詹成老，平乐流人邹至完。\n莫逆于心心古道，不知其异异时官。\n一觞一咏风光胜，无咎无誉世界宽。\n北陌东阡好归去，幅巾藜杖永相安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄葛长源","author":"邹浩","text":"平乐舂陵地接连，岭南岭北异风烟。\n罪分轻重当如此，坐阻声容空自怜。\n天上恩书来有日，湖边归路约同船。\n东门取醉邻居耳，已办金鱼当酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静阅堂","author":"邹浩","text":"左辖诸郎朝散君，顷年于此岸纶巾。\n谁知还是风炎日，我亦来为堂上人。\n菡萏波澄端自倚，桄榔烟静几番新。\n静中阅尽荣枯事，独爱龙山万古春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山禽","author":"邹浩","text":"异色殊形不可名，飞来飞去亦多情。\n只应知我归期近，故傍书帷送好声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"邹浩","text":"缓步随山径，横前得野塘。\n倚风荷展玉，带日鹭翘霜。\n雾敛都无瘴，天晴却自凉。\n支筇惬新兴，疑已到江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记梦","author":"邹浩","text":"廊庙知心独此公，夜来魂梦忽相通。\n密言新命非虚语，所以流传四海中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄瑩中","author":"邹浩","text":"天道无私果是非，斯人如凤中人机。\n雄惊一矢从南落，雌领诸雏向北飞。\n且与龟龙为伴侣，未应蝼蚁损毛衣。\n吾皇致理肩虞舜，会见翱翔下德辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读丘浚寺丞天绘亭记","author":"邹浩","text":"襟怀落落富经纶，造命奇穷道不伸。\n诗以百篇天上献，身为万里幕中宾。\n每听故老谈风节，尚有遗文照水滨。\n闻说神游已无碍，想经山顶亦逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读龙图梅公瘴说","author":"邹浩","text":"市门隐去不知年，蔽芾甘棠荫乐川。\n五瘴作时虽不染，一篇留诫指其然。\n直须镂版人皆与，庶使绵区病可痊。\n更有奇方公未说，上医医国许心传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追感董敦逸梦授侍郎","author":"邹浩","text":"台陟莲花见旧篇，追惟平昔倍凄然。\n初为百里青衫短，晚按连城白发鲜。\n东省联裾惊昨梦，南宫分袂忽新阡。\n使公虽老犹无恙，只恐投荒更我先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄零陵令朱君陟彦明推官","author":"邹浩","text":"前时递角惟忧速，今日邮筒只恐迟。\n书到零陵长官处，掀然一笑有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"邹浩","text":"莫把形骸碍此心，此心真体杳难寻。\n太虚仅此一沤发，方寸能容万象沉。\n无佛无人谁是我，不来不去妙常今。\n更须知有全提在，拄杖从横云雾深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"母氏安康郡太君生日三十韵","author":"邹浩","text":"朱明初启节，分卦属纯乾。\n善积名门久，祥开淑质贤。\n柔仪应月吕，和气集薰弦。\n奕世儒风蔼，持家礼法传。\n乘龙来配德，采藻助承先。\n姑耄勤朝乳，功馀绎旧编。\n卜邻严子教，截发盛宾筵。\n萱草欣多豫，鸤鸠咏不偏。\n乡闾师肃穆，坤道信完全。\n自辍齐眉奉，尤于内典专。\n三车窥至喻，一笑悟真筌。\n荣辱忘区别，优游任众缘。\n居常遵坦路，方寸湛澄渊。\n浩也端愚陋，身兮数仆颠。\n范滂蒙训敕，梦得念慈怜。\n放逐清湘外，羁縻苍桂边。\n遥知今日燕，想见瑞炉烟。\n弟侄纷为寿，亲朋俨造前。\n焚香控南斗，极目望东阡。\n鸾鹤翔仙岭，龟鱼动乐川。\n安康符郡号，昌炽赋诗篇。\n计已闻消息，惟新获洗湔。\n赐环叨霈泽，衣綵即归田。\n省定深如志，生成实荷天。\n岂徒宽虑耳，必是倍欢然。\n虽阻随行拜，犹胜避瘴眠。\n鹏抟九万里，椿大八千年。\n就养逾曾晰，承颜继闵骞。\n尚存诚意在，终冀夙心圆。\n永结老人好，星光盈紫躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蓬菜并示柄","author":"邹浩","text":"皇帝如天极至公，恩光来自大明宫。\n归田实遂平生志，与汝难忘造化功。\n料得安康无限喜，信知理数莫能穷。\n吾今只候文书到，便挈囊衣迎北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂花","author":"邹浩","text":"丹桂从来未发花，今年花发众惊嗟。\n盈盈簇盖真珠细，片片笼车美玉斜。\n阊阖携香熏席绮，嫦娥流影动窗纱。\n乾坤着意欣逢遇，收得风光向北誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤火","author":"邹浩","text":"未解捐书常读书，只缘炎瘴简编疏。\n夜深萤火犹相勉，无数飞光照閤居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广南四时摄养括子","author":"邹浩","text":"仁者存心故不同，四时括子广西东。\n蒙恩归去虽无用，留作韦弦戒我躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览镜","author":"邹浩","text":"三窜湖南与岭南，生涯破荡孰能堪。\n归田莫虑饥寒迫，眼下新来有卧蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追凉晚步邂逅张云卿王文辅王子正三进士同行","author":"邹浩","text":"巷僻门多掩，鸡豚散不收。\n后先携众士，笑语入汀洲。\n太尉庙前面，冠芝亭上头。\n旷然无障碍，谁羡尔公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过张云卿所居","author":"邹浩","text":"发石诛茅古道边，儒家清占静中天。\n数番雨水添塘水，满目红莲间白莲。\n望处苍龙蟠远岳，坐来朱鹭舞祥烟。\n我心本在风尘表，偶此相羊更豁然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读庄子 其一","author":"邹浩","text":"形影相随向此居，柴门终日掩清虚。\n谁知盘礴高堂上，自与南华游物初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读庄子 其二","author":"邹浩","text":"万物同为一体真，体真谁复见陈新。\n今吾故我强名耳，莫逆于心得此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]