[{"title":"赠丁子植抚干","author":"高翥","text":"幕府归来赴调时，清声籍籍满京师。\n真如白璧藏奇石，判得黄金博断碑。\n借宅先寻笼鹤地，买盆权作养鱼池。\n客中高致犹如此，明日还山乐可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠番昜程克己","author":"高翥","text":"见说番昜有老程，与人怀抱亦分明。\n一千里外未识面，二十年间长慕名。\n因听酒边谈旧事，便从客里定交情。\n他时我老君犹健，海内重逢即弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月旦日永定寺作","author":"高翥","text":"萧然一室坐清虚，又见西风到客居。\n老去身心便懒惰，人来情意任亲疏。\n从僧借地秋移菊，与佛分镫夜读书。\n幽事复为行计夺，去留端的合何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三峰废寺","author":"高翥","text":"荒林依约旧山门，秋草离离故迹存。\n双瀑有声传宿雨，一龛无地住闲云。\n蜗沿坏壁丹青古，龟负残碑字画昏。\n三叹废兴谁可问，乱鸦鸣噪自成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌镇普静寺寺沈休文故居也","author":"高翥","text":"寂寞梁朝寺，深廊十数閒。\n碑存知殿古，香冷觉僧残。\n断岸舟横浦，平坡树补山。\n休文如好在，依旧带围宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无计","author":"高翥","text":"无计留连日，争来断送春。\n落花终日雨，流水一溪云。\n山鸟呼名急，林梢著色新。\n诗成真谩兴，吾懒事因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毋自欺斋夜宴","author":"高翥","text":"毋自欺斋清更严，斋中人物斗之南。\n七朝宰相得瞻仰，四海诗人交笑谈。\n古调喜听琴再弄，深杯休惜酒重添。\n玉堂今夜无宣唤，且与江湖作小参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同刘潜夫登乌石山望海有怀方孚若柯东海陈复斋旧游","author":"高翥","text":"念念思归身欲翰，旧题无暇遍寻看。\n故人尽入黄泉路，远客空登乌石山。\n休起痴心乘九鲤，莫劳病眼望三韩。\n神仙未必知吾事，道在何妨两鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁除登岝崿山精舍","author":"高翥","text":"萧寺经行无尽情，倚阑长是眼增明。\n溪因宿雨十分急，山为凝寒一味清。\n竹外飞花随晚吹，树头幽鸟试春声。\n重来又是明年事，临出门犹款款行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老将","author":"高翥","text":"垂头终日坐当门，两臂苍龙隐墨纹。\n笑撚白须传阵法，手摊黄纸说君恩。\n中年主帅皆为鬼，晚岁虞兵见领军。\n每劝儿孙学刀箭，解衣教看旧瘢痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"高翥","text":"秋来高处不宜登，闲却西楼最上层。\n读罢黄庭窗户晚，自敲清磬上香镫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张氏曲江","author":"高翥","text":"一曲澄江两派分，满山脩竹绿齐云。\n矮窗风月侵帆腹，小径烟霞隐屐痕。\n白鹭夜依花影宿，清猿时共橹声闻。\n主人与客心如水，同倚阑干得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵鹫寺","author":"高翥","text":"灵鹫名山万古名，几回无事绕廊行。\n殿前流水晴犹急，塔上春云晚自生。\n鹤傍经床听梵语，鸟窥斋钵候钟声。\n我来借得团蒲坐，归去閒眠梦亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居杂兴三首 其三","author":"高翥","text":"杜鹃休忉忉，布谷休聒聒。\n无田不须耕，无家自能活。\n行藏莫非时，造化安可夺。\n更放心地宽，出门行路阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居杂兴三首 其二","author":"高翥","text":"点镫酌春酒，襞纸题小诗。\n读尽列仙传，引调学语儿。\n自饮复自笑，不觉春漏迟。\n且了今日事，明日还任之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居杂兴三首 其一","author":"高翥","text":"开门遣蛮童，买花供铜佛。\n春风随花来，为我一披拂。\n风和花气清，下帘休放出。\n回施佛因果，供此老诗骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"育王寺","author":"高翥","text":"晓策乌藤上育王，入山随处得徜徉。\n碑头龙护先皇字，塔下鱼悬外国香。\n遍谒禅房尝苦茗，闲听社媪说豪光。\n山深日短行难尽，僧遣头陀办客床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中","author":"高翥","text":"霍地春归唤不应，客中容易鬓星星。\n漫山风雨樱桃紫，绕屋烟云薜荔青。\n姑恶恨谁能自苦，子规催客厌人听。\n闭门独坐难抛酒，生怕离愁到短屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜尹和靖先生墓","author":"高翥","text":"和靖祠堂在半村，敬瞻遗像忆师门。\n洛中虽去名犹重，吴下曾来道益尊。\n言立岂徒规后学，书存端可识真源。\n瓣香再拜公应鉴，自愧传衣忝嫡孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拜李谪仙墓","author":"高翥","text":"萧萧高冢占云根，故老相传太白坟。\n白骨定随风月冷，青山长共姓名存。\n平生出处犹如见，一死浮沈异所闻。\n客子开元书记后，故来浇酒些清魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"高翥","text":"冉冉日将莫，萧萧秋欲残。\n浮云低阁雨，宿霭密藏山。\n扇觉轻蒲重，衣嫌细葛单。\n更交一寒暑，精进独衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜书怀","author":"高翥","text":"明灭孤镫缥缈香，沈沈更漏隔宫墙。\n秋风倦客家千里，夜雨怀人天一方。\n世事从他多锄铻，生涯如我亦凄凉。\n亟须唤酒消长夜，休梦黄华绕涧傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺杨东山休致","author":"高翥","text":"莫言纳禄寻常事，试读唐人梦谒赋。\n骑驴径上东山椒，九州四海风萧萧。\n大瓢贮云杓斟月，却跨阴崖听冰柝。\n松萝影薄寒花妍，白鸥飞来亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重五日怀旧","author":"高翥","text":"独守空庭日欲晡，满斟浊酒不须沽。\n白头兄弟三年别，青眼交游一字无。\n醉看葵榴怀旧事，馋思樱笋梦吾庐。\n向时痴绝今愁绝，自读离骚些老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽章朋举","author":"高翥","text":"相逢便拜十年兄，自此交游得尽情。\n草纸抄书传遁甲，竹筒沽酒命添丁。\n他时结屋期来往，今日登门隔死生。\n从此苕溪明月夜，小舟不复为君停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹娥浦泊舟","author":"高翥","text":"夜宿曹娥浦，停舟是几更。\n闻钟知寺近，听橹信潮生。\n风向沙头起，天从柁尾明。\n梦回无意绪，两岸杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜乡友来","author":"高翥","text":"萧萧春夜雨，有客渡江来。\n世事攒眉说，乡谈信口开。\n晚肴供苦笋，时果荐青梅。\n甚欲浇离恨，呼镫拨酒醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日田父辞二首 其一","author":"高翥","text":"啄黍黄鸡没骨肥，绕篱绿橘缀枝垂。\n新酿酒，旋裁衣，正是昏男嫁女时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日田父辞二首 其二","author":"高翥","text":"少妇挼蓝旋染裙，大儿敲葛自浆巾。\n新摘摘，笑欣欣，相唤相呼看赛神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"高翥","text":"早知花木今无主，不把丰碑累放翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"高横槎","text":"宦情薄于水，吟鬓早为霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴","author":"高镕","text":"已学渊明早赋归，东风吹醒梦中非。\n莺声睍睆来谈旧，牛背安闲胜策肥。\n时听樵歌时牧笛，间披道氅间农衣。\n篇诗那可形容尽，何似忘言对夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题碧落洞","author":"高衡","text":"仙府沈沈尽日开，霓旌鹤驾几徘徊。\n青云有路容人到，煮茗浮觞不忍回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高塘桥","author":"高衡孙","text":"碧荷色犹懒，紫花香渐多。\n过桥通故里，分界入新河。\n土润何劳治，沙平不用磨。\n衣冠今已矣，从此想鸣珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题","author":"高攀","text":"洞府幽深幸许探，危峰削玉与天参。\n凡心洗涤今无妄，仙迹微茫要指南。\n俯涧长吟舒逸兴，倚岩小酌助清谈。\n抱琴携子盟泉石，终老山阿我亦甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为三状元咏","author":"乾道民谣","text":"翀峰龟岭与龙屿，三处山川实壮哉。\n相去之间不百里，七年三度状元来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"商侑","text":"地俯梅溪新栋宇，源通橘井近烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题阊门外小寺壁","author":"寇国宝","text":"黄叶西陂水漫流，籧篨风急滞扁舟。\n夕阳暝色来千里，人语鸡声共一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日不饮","author":"寇准","text":"云淡长空日欲斜，水边衰柳噪寒鸦。\n病来不饮空凄感，独绕东篱咏菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日群公出游郊外余方卧郡斋听水因寄一绝呈诸官","author":"寇准","text":"菊老东篱人病酒，西风黄叶满荒田。\n不知今日登高兴，何似虚堂听水眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小韩店","author":"寇准","text":"昔从邺下游梁苑，孤店曾经十数回。\n岁月暗移人事改，白头重到小韩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中书秋日有怀青社旧游因书一首","author":"寇准","text":"掖垣秋色生鸡树，忽忆青丘感旧情。\n曾倚西楼吟暮雨，数峰寒碧绕高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予顷从穰下移涖河阳洎出中书复领分陕惟兹二镇俯接洛都皆山河襟带之地也每凭高极望思以诗句状其物景久而方成四绝句书于河上亭壁 其一","author":"寇准","text":"堤草惹烟连野绿，岸花经雨压枝红。\n年来多病辜春醉，惆怅河桥酒旆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予顷从穰下移涖河阳洎出中书复领分陕惟兹二镇俯接洛都皆山河襟带之地也每凭高极望思以诗句状其物景久而方成四绝句书于河上亭壁 其二","author":"寇准","text":"蝉鸣日正树阴浓，避暑行吟独杖筇。\n却爱野云无定处，水边容易耸奇峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予顷从穰下移涖河阳洎出中书复领分陕惟兹二镇俯接洛都皆山河襟带之地也每凭高极望思以诗句状其物景久而方成四绝句书于河上亭壁 其三","author":"寇准","text":"岸阔樯稀浪渺茫，独凭危槛思何长。\n萧萧远树疏林外，一半秋山带夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予顷从穰下移涖河阳洎出中书复领分陕惟兹二镇俯接洛都皆山河襟带之地也每凭高极望思以诗句状其物景久而方成四绝句书于河上亭壁 其四","author":"寇准","text":"暮天寥落冻云垂，一望危亭欲下迟。\n临水数村谁画得，浅山寒雪未销时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东有感","author":"寇准","text":"长岁天涯悲断梗，逢君无处不伤情。\n那堪日落红楼伴，更听萧萧杜宇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆岐下小池","author":"寇准","text":"长忆西园清夜景，酒阑无不独临池。\n可怜陇月三更白，谁见红蕖露滴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆洛阳","author":"寇准","text":"金谷春来柳自黄，晓烟晴日映宫墙。\n不堪花下听歌处，却向长安忆洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆樊川","author":"寇准","text":"闲想旧游都似梦，别来秦树又西东。\n高秋最忆樊川景，稻穗初黄柿叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"寇准","text":"金甲珠襦锁绣扃，杜城残月葬娥英。\n春风候馆花如雪，空有莺传度曲声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安春日","author":"寇准","text":"淡淡秦云薄似罗，灞桥杨柳拂烟波。\n夕阳楼上山重叠，未抵愁春一倍多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安春望感怀","author":"寇准","text":"灞岸春波远，秦川暮雨微。\n凭高正愁绝，烟树更斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日北斋","author":"寇准","text":"寒风飒飒响庭槐，爱日明窗坐北斋。\n闲忆故山归未得，旧游时展认云崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"左冯寺楼闲望","author":"寇准","text":"闲思至道年中事，独倚左冯城外楼。\n目断平皋人不见，暮天无际水悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归州留别傅君","author":"寇准","text":"杨柳如丝拂画桥，此中留语欲魂销。\n还愁别后巴东馆，独听空江半夜潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉上偶书","author":"寇准","text":"谪仙唐室游兹郡，花下听歌醉眼迷。\n今日汉江烟树静，更无人唱白铜鞮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华山","author":"寇准","text":"祇有天在上，更无山与齐。\n举头红日近，回首白云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成安秋望","author":"寇准","text":"八月西风蝉噪时，萧萧疏叶已辞枝。\n烟村物景都无赖，况是登临有所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中早行","author":"刘镇","text":"严钟将报曙，游子已登途。\n野火时明灭，星残似有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"寇准","text":"溪水觉暖微函碧，山杏经春半吐红。\n不向此时拚一醉，到头无计奈春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋二绝 其一","author":"寇准","text":"年光苒苒暗推移，坐惜流年感旧期。\n独听早蝉秋色里，潘安初见二毛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋二绝 其二","author":"寇准","text":"一听早蝉响，坐悲芳岁阑。\n新秋空索寞，前事但心酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀","author":"寇准","text":"秦川春婉晚，汉水路迢遥。\n不待凭危槛，离魂已暗销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"寇准","text":"古岸萧萧闻去雁，平芜杳杳更斜晖。\n空江极目望不尽，枫叶半红人未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上闻鹧鸪","author":"寇准","text":"水村烟树与云平，闲倚孤舟念远行。\n无奈乡心倍寥落，残阳中有鹧鸪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上晚望","author":"寇准","text":"寒钟来极浦，古寺隔重岩。\n斜日支颐坐，天涯落月帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过新井慈光院留题海棠","author":"寇准","text":"暄风花杂满栏香，尽日幽吟叹异常。\n翻笑牡丹虚得地，玉阶开落对君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过襄州留题驿亭","author":"寇准","text":"沙堤筑处迎丞相，驿吏催时送逐臣。\n到了输他林下客，无荣无辱自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏雨中","author":"寇准","text":"绿树新阴暗井桐，杂英当砌坠疏红。\n重门寂寂经初夏，尽日垂帘细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"判都省感怀","author":"寇准","text":"昔为学士掌三铨，屈指年光三十年。\n秋雨滴阶桐已老，白头重到倍依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岐下秋书","author":"寇准","text":"碧树微凉露气清，感愁怀旧独含情。\n西楼月夜明如水，只欠桓伊一笛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庐山","author":"寇准","text":"江南到处佳山水，庐阜丹霞是胜游。\n独抱古琴携竹杖，若逢绝境莫归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]