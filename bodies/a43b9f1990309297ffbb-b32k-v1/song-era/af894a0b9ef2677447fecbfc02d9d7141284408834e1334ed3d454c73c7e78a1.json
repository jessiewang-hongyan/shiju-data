[{"title":"石颐寺","author":"程九万","text":"闻法师来杖锡东，于菟蹭蹬奋雷风。\n当时地裂泉随动，一酌清甘万虑空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道寺","author":"程九万","text":"二载尘劳薄宦身，双峰几忆旧家邻。\n甫能再上阳城考，更有一年孤负春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铜山","author":"程九万","text":"飞鸟投林去复还，临风恒忆旧家山。\n平生杖履经行处，杳在云烟髣髴间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠峰寺和毛泽堂韵","author":"程九万","text":"岩石玲珑翠竹斜，木犀依约又残花。\n长官愧我无才思，却忆东堂旧作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岘石寺","author":"程九万","text":"苍岩绝顶俯晴川，佳处潜开小洞天。\n琴几棋台谁是伴，霞栖月啸恍如仙。\n□山□□□多石，□□□□□引泉。\n独取悬崖□□□，□□已自□燕然。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟霞坞二首 其二","author":"程九万","text":"鬓发几星星，风霜抑饱经。\n年华轻过鸟，身世俯危亭。\n寒碧还相照，飞湍盍暂停。\n平生爱山眼，分外为渠清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟霞坞二首 其一","author":"程九万","text":"山深何限好，客到辄同登。\n泉壑岚光冷，烟林霁色凝。\n韵艰诗益健，杯数量难胜。\n老矣功名稳，何须叹沔渑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松桂亭","author":"程九万","text":"松桂移栽满，园亭改筑新。\n诗书千古事，松桂四时心。\n萧瑟风成韵，扶疏月满阴。\n一琴聊自托，山水是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重建东堂","author":"程九万","text":"宦游偶落云水乡，耻以贪墨为吏商。\n三年寄傲南窗月，一瓣为炷东堂香。\n翛然清风揖佳客，好古博雅真扬扬。\n旧题湔祓古寺壁，浊酒呼索邻家墙。\n淋浪醉墨鸾凤舞，警语峭厉凌冰霜。\n大碑小碑共检校，次第安置堂中央。\n朅来弦歌有馀暇，逸兴剩欲希韩湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬近","author":"程琳","text":"世间剥复每相乘，此理几几唤得应。\n万木冻僵梅有信，黄河冰合井如蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陆务观海棠","author":"程大昌","text":"唤回残睡强矜持，浅破朱唇倚笛吹。\n千古妖妍磨不尽，长随春色上花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘侍郎九日登女郎台","author":"程大昌","text":"霜枝凋翠雁横秋，莫倚危楼动旅愁。\n菊有清香樽有酒，茱萸不插也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觅梅","author":"程大昌","text":"花中结子酸连骨，正味森严众苦之。\n待得和羹渠自会，如今莫管皱双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其四","author":"程大昌","text":"九龄几协梦，三载忽缠丧。\n地卜周巡旧，山因禹穴傍。\n云卿飞步阔，风沛著思长。\n八表神游处，天高巩洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其三","author":"程大昌","text":"智超黄屋表，不以位为怡。\n罢省斋居事，安持寿殿卮。\n尊荣天子父，巍焕圣王师。\n盛德几无古，惟尧始济兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其二","author":"程大昌","text":"英明如艺祖，慈厚类仁宗。\n民隐深忧恻，天骄入益容。\n前芳尝北指，鸣镝自回功。\n戢动皆时当，居然八政农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其一","author":"程大昌","text":"先汉运尝屯，令周历再新。\n必知天地泰，为有帝王真。\n立极绵三纪，垂鸿更万春。\n鼎龙俄夭矫，升鹤肯逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次林光朝八月十五日道出南昌寄龚帅实之韵","author":"程大昌","text":"闻有挐音扫榻埃，尚疑却棹酒船回。\n锦囊忽至诗传诺，玉麈未交心已开。\n邂逅四人今楚尾，班联十载旧兰台。\n尊前莫发粗官叹，奇绝江山直一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿直留诗","author":"程大昌","text":"抖擞身章却冒尘，袅蹄顾影也逡巡。\n銮坡寓宿非其地，莲烛操文自有真。\n字直由来同古语，位高兼复见今人。\n迎潮有诺无轻爽，季老当年不诿贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 园丁献海棠","author":"程大昌","text":"春产不贪春，为厌春花泛。\n睡到深秋梦始回，素影翻春艳。\n意赏逐时新，旧事谁能占。\n解转春光入酒杯，萸菊谁云欠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万年欢 硕人生日","author":"程大昌","text":"岁岁梅花，向寿尊画阁，长报春起。\n恰似今朝，分外香肥萼韡。\n杂佩珊珊就列，映蓝袂、宝薰擎跽。\n道这回、屋舍团栾，四时风月桃李。\n回头处、无限思。\n看秋前药裹，而今鼎匕。\n须把康强，收作玳筵欢喜。\n况是鬓云全绿，顶珈笄、笑陪星履。\n新年动、定拥新祺，有孙来捧醪醴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万年欢 硕人生日","author":"程大昌","text":"富寿康宁，要三般齐足，方是有福。\n献个新词，不是越夸搀祝。\n七十古稀今独。\n花钗底、髻云堆绿。\n那堪更、眼力过人，彩丝穿透珠曲。\n星辰履阶庭玉。\n对这般景趣，乐胜笙筑。\n更愿孙枝衮衮，诜诜续续。\n解把诗书勤读。\n新丹桂、会生旧竹。\n十年外、又颂生朝，恁时别换腔局。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万年欢","author":"程大昌","text":"秋后花窠，放两枝三朵，来通芳信。\n诗眼惊观，谓是春光倒运。\n便即移尊就赏，更不惜、黄封赤印。\n何期道，青女专时，露华忽变霜阵。\n诗翁笑、但休问。\n那阳和有脚，骎骎日进。\n待得灰飞，梅畹果先骋俊。\n次后连天红紫，向东风、万般娇韵。\n恁时节，玉勒狨鞍，郊原莫论远近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万年欢 丙午生日","author":"程大昌","text":"老钝迂疏，尽世间乐事，不忺不觑。\n痴向韦编，根究卦爻来处。\n浑沌包中天地。\n谢东家、从头指示。\n便和那、八八机关，并将匙钥分付。\n行年数、六十四。\n把一年一卦，恰好相拟。\n妙道生生，既济还存未济。\n身愿河图比似。\n每演九后，重从一始。\n待人间、甲子何其，剩书亥字为戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头","author":"程大昌","text":"绿净贯阛阓，夹岸是楼台。\n楼台分影倒卧，千丈郁崔嵬。\n此是化人奇变，能使山巅水底，对出两蓬莱。\n溪浒有仙观，苕霅信佳哉。\n水晶宫，谁著语，半嘲诙。\n世间那有，如许磊砢栋梁材。\n每遇天容全碧，仍更苹风不动，相与夜深来。\n饮子以明月，净洗旧尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 上巳日领客往洛阳桥","author":"程大昌","text":"坐上羽觞釂，水际洧衣褰。\n适兹胜赏，风轻云薄有情天。\n不用船舷悲唱，真俯阑干小海，乐事可忘年。\n莫向歌珠里，却叹鬓霜鲜。\n送朝潮，迎夕汐，思茫然。\n知他禊饮，此地过了几千千。\n既有相催春夏，自解转成今古，谁后更谁前。\n堪笑兴怀客，不似咏归川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头","author":"程大昌","text":"红树迎风舞，彷佛采衣褰。\n云容应为，虞侍分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉宫春 生日词","author":"程大昌","text":"万六千年，是仙椿日月，两度阳春。\n根柯不随物化，那有新陈。\n戏夸悠久，借时光、惊觉时人。\n道历管，阶蓂万换，悠然唤做逡巡。\n老我百无贪羡，羡天芳寿种，掩冉三辰。\n谢他流年甲子，已是重轮。\n人间春狭，只九旬、斗柄标寅。\n更拟向，椿枝倚数，十分取一为真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其二","author":"程大昌","text":"白屋到横金，已是蟠桃结子。\n更向仕途贪恋，是痴人呆虑。\n水晶宫里饭莼鲈，中菰第一义。\n留得鬓须迟白，是本来真贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其五","author":"程大昌","text":"我里比侨居，不欠山青水绿。\n只恨风冲雁序，使分飞隈澳。\n只今一苇视苕溪，见天伦雍睦。\n此去春浓絮起，应翻成新曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 生日词","author":"程大昌","text":"日绎五千言，未说年龄可续。\n且得襟期萧散，远氛嚣宠辱。\n鬓须白尽秀眉生，来伴老眸绿。\n人道雪霜林里，有翠松鲜竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其四 同日即事","author":"程大昌","text":"岁岁做生朝，只是儿孙捧酒。\n今岁丝纶茶药，有使人双授。\n圣君作事与天通，道有便真有。\n老去不能宣力，只民编分寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其三","author":"程大昌","text":"腊月做生朝，只有南枝梅玉。\n此外后生桃李，未舒英吐馥。\n后园别自出神奇，现双松双竹。\n报道前堂琴瑟，俱长生厚福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其一 会娄彦发","author":"程大昌","text":"桃柳旧根株，春到红蔫绿茁。\n一似老年垂白，带少容黳发。\n浮家泛宅在他乡，难得会瓜葛。\n幸对此番乐饮，任宵分明发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其一 硕人生日","author":"程大昌","text":"绿鬓又红颜，谁道年周甲子。\n两婿□□蓝绶，那一儿何虑。\n只今卜筑水晶宫，归安好名义。\n金紫珈笄偕老，备长生福贵。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其六 生朝纪梦","author":"程大昌","text":"自涉希寿来，疑道无多岁月。\n昨夜风吹好梦，报前途康吉。\n石桥坚壮跨黄河，不用资舟楫。\n管取身心安泰，阅椿龄千百。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近 其二 生日","author":"程大昌","text":"盥水结冰花，老眼于今重见。\n一似琢成水玉，向冻盆游泛。\n天公作事有何难，要花花便现。\n且把重春留住，变苍黎容面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"折丹桂 端复受官","author":"程大昌","text":"童年未晓君恩重。\n教得能趋拱。\n重亲带笑酌天杯，听祝语、殷勤捧。\n青衫得挂尤光宠。\n桂是蟾宫种。\n诗书浓处便生枝，但只要、频浇壅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 彝卿国录不闲僻远，特为一来。则既幸佳词叙旧，谦褒交厚，不容虚辱，次韵为谢","author":"程大昌","text":"海角怀人，长误喜、簌簌敲帘风竹。\n命驾翩然，谁信道、不怕溪山回曲。\n榻拂凝尘，香笼清宴，麈柄从挥玉。\n好音闻耳，慰心何啻跫足。\n犹记一桂专秋，创开殊选，倒峡馀词力。\n往事茫茫十换岁，却共天涯醽醁。\n已分成翁，翘观赐带，上拥通仙录。\n休贪泉石，贤台闻用金筑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 呈苏季真提举","author":"程大昌","text":"冰容玉格，笑桃杏、非是闺帏装束。\n待要舒华那更管，朔气凝波僵木。\n五鬣山松，万年宫树，仅仅存馀绿。\n一枝寄赠，教渠知道春复。\n宁解车马成蹊，高标宜雪月，仍便溪谷。\n纵有知闻，谁办得、驾野凌寒秉烛。\n尽更荒闲，终难掩抑，风里香千斛。\n林坰兴尽，此时鼎味翻足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 其二","author":"程大昌","text":"抗步碧潭弥弥，五畲青髻累累。\n何年乔木倚筇枝。\n搜寻同队者，追说钓游时。\n今日昂藏称壮子，向来襁褓婴儿。\n年周甲子又重书。\n岂容藏老丑，照白有清池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 和正卿弟生日词三首 其一","author":"程大昌","text":"遥认埙篪相应，为传珠贯累累。\n紫荆同本但殊枝。\n直须投老日，常似有亲时。\n子姓亦闻多慧性，贪书不是痴儿。\n朝家世世重诗书。\n一登龙虎榜，许并凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 其三","author":"程大昌","text":"夹路传呼杳杳，垂腰印绶累累。\n万般荣贵出丹枝。\n遥知心乐处，椿畔桂当时。\n酒到芳春偏弄色，轻黄泛滟鹅儿。\n大为行乐使堪书。\n醉来花下卧，便是习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 其一","author":"程大昌","text":"每月冰轮转，常疑桂影摇。\n封姨特地借今宵。\n万水一规光景、湛寒瑶。\n圆处应无恨，君胡不自聊。\n谁家隐隐度晴箫。\n莫是素娥仙玉、会丛霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 其三","author":"程大昌","text":"韵致撩诗客，风流出酒家。\n长绳为驻日车斜。\n且向春香玉色、占生涯。\n细按歌珠串，从敧宝髻鸦。\n花应笑我鬓双华。\n偏向西阶吹馥、侑流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 其二","author":"程大昌","text":"才出沧溟底，旋明紫岫腰。\n玉光漫漫涌层潮。\n上有乘流海贾、卧吹箫。\n更上云台望，翻牵旅思遥。\n我生何许著箪瓢。\n却向天涯起舞、影萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 庚戌生日","author":"程大昌","text":"春草池塘，茸茸短碧通芳信。\n更饶华润。\n不解膏霜鬓。\n池上诗翁，别带超遥韵。\n阳和进。\n香苞翠晕。\n物物皆沾分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 五首 其一","author":"程大昌","text":"乾处缁尘湿处泥。\n天嫌世路净无时。\n皓然岩谷总凝脂。\n清夜月明人访戴，玉山顶上玉舟移。\n一蓑渔画更能奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"程大昌","text":"剪水飞花也大奇。\n熬波出素料同机。\n会心一笑撒盐诗。\n谁拥醴酏夸岁瑞，恨无坚白怨朝曦。\n闭门高卧有人饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 饯万大卿，前一夜有月，此日不得用乐作","author":"程大昌","text":"物本无情人有情。\n百般禽咮百般声。\n有人闻鹊不闻莺。\n我盏通神君信否，酒才著盏月随生。\n大家吸月当箫笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"程大昌","text":"兽炭香红漫应时。\n遮寒姝丽自成围。\n销金暖帐四边垂。\n报道黑风飞柳絮，齐翻白雪侑羔卮。\n那家斟唱□□词。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"程大昌","text":"水递迢迢到日边。\n清甘夸说与茶便。\n谁知绝品了非泉。\n旋挹天花融湩液，净无土脉污芳鲜。\n乞君风腋作飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"程大昌","text":"始待空冬岁不华。\n还教呈瑞怨贫家。\n若为高下总无嗟。\n日照华檐晴后雨，风吹飞絮腊前花。\n天公何事不由他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 内子生日","author":"程大昌","text":"距春五日。\n吉语搀先来饮席。\n易卦占新。\n八八周轮又再轮。\n开年定好。\n定把笙歌更药裹。\n旧怕无孙。\n今已蓝袍拥绣荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"程大昌","text":"桑弧标吉。\n做了生朝逾七十。\n子又生孙。\n阶砌芝兰欲满门。\n今年定好。\n春腊之交诞婴少。\n玉烛气中。\n寿富康宁四序同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其四 中外三人受封","author":"程大昌","text":"中外受郊恩，三封纶告。\n依并小君出称号。\n锦犀光艳，不比香薰脂膏。\n况从鸣瑟里，添花草。\n更愿天公，别施洪造。\n水长船高愈新好。\n恁时舞带，一任巧装百宝。\n曲终珠满地，从人扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其三","author":"程大昌","text":"变化属朝班，鲲鹏相并。\n健翼垂云风用壮。\n扶摇得势，不藉仙人仙仗。\n旁观生意气，犹神王。\n此去汉庭，春光骀荡。\n亲见子虚不惆怅。\n鸢肩捷上，自有唐家格样。\n三台旬月里，堪歌唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其一 生日示妹","author":"程大昌","text":"身寿又康强，谢天将并。\n耳目聪明行步壮。\n登高挥翰，不用瞠眉扶杖。\n华堂偕老处，儿孙王。\n只恨萍蓬，他乡浮荡。\n回首故山便惆怅。\n今年生日，忽似还家模样。\n当缘风絮韫，来赓唱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其七 淑人生日词","author":"程大昌","text":"锦告侈脂封，煌煌家宝。\n偕老之人已华皓。\n绿云拥鬓，更没一根入老。\n但从和晬看，年堪考。\n叶是松苗，松为叶脑。\n禀得松神大都好。\n人人戴白，独我青青常保。\n只将平易处，为蓬岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其八 娄通判生日词","author":"程大昌","text":"一岁一生朝，一番老相。\n无欲无营亦无望。\n看经写字，且做闲中气象。\n闭门人阒静，心清旷。\n骨肉团栾，一杯相向。\n野蔌家肴竞来饷。\n真情直话，不用逢迎俯仰。\n从他人笑道，不时样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其六 生朝","author":"程大昌","text":"七十有三番，挂弧门首。\n此事从来信希有。\n新来仕路，夸说一般高手。\n肯从清要地，抛簪绶。\n何许分花，伊谁送酒。\n得开口时且开口。\n无烦无恼，也没期程奔走。\n但能安此乐，夷然寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其五","author":"程大昌","text":"措大做生朝，无他珍异。\n填个曲儿为鼓吹。\n古来龙马，曾献河图真数。\n羲黄缘得此，齐元气。\n我向如今，职名升赐。\n地在天宫正东序。\n当初真本，到此或容披觑。\n这回错综处，堪详叙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]