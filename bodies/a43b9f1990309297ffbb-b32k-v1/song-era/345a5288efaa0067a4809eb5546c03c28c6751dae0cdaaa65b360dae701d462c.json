[{"title":"醉落魄/一斛珠 其三 后两日，再拉同官，席上用前韵","author":"管鉴","text":"寒欺酒力。\n一番风雨花如摘。\n酴醾不与群花敌。\n笑吐清香，独自殿春色。\n春愁惟酒消除得。\n何妨常满坐中客。\n因花更把光阴惜。\n莫待春归，空对花梢忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其二 三月十日赏酴醾，时坐客沈、赵与余将终更花干复议归蜀醉中口占","author":"管鉴","text":"春愁无力。\n酴醾娇软难禁摘。\n风流彻骨香无敌。\n积玉团珠，明月夜同色。\n花时易失欢难得。\n尊前半是将行客。\n为花一醉何须惜。\n明岁花时，何处谩相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄 其四 中秋前一日，饯潘德鄜于花光，用德鄜韵","author":"管鉴","text":"碧云暮合。\n不教预赏中秋月。\n凉生楚观风初歇。\n山影沈沈，相对两奇绝。\n湘人怅望黄金节。\n只愁酒散仙舟发。\n凭谁为与姮娥说。\n明夜虽圆，空照人离别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其一 正月二十日张园赏海赏作","author":"管鉴","text":"春阴漠漠。\n海棠花底东风恶。\n人情不似春情薄。\n守定花枝，不放花零落。\n绿尊细细供春酌。\n酒醒无奈愁如昨。\n殷勤待与东风约。\n莫苦吹花，何似吹愁却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其五 为薛子昭寿","author":"管鉴","text":"燕寝香中锦帐郎。\n二年和气蔼蒸湘。\n鬓间不减当年绿，眉上新添一点黄。\n徵诏近，寿筵长。\n乍晴人意喜非常。\n燕莺休苦留春住，归趁薰风殿阁凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"管鉴","text":"山色初晴翠拂云。\n画桥流水碧粼粼。\n一尊不尽登临兴，归及西湖二月春。\n班缀旧，诏除新。\n稳看腾踏上星辰。\n回头却望尘凡处，应记尘凡有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其四 宋子渊生日","author":"管鉴","text":"富贵楼台玉琢成。\n更移玉节下西清。\n才高不数梅花赋，笑捻琼苞泛寿觥。\n莲幕静，宝香凝。\n春风和气自然生。\n要知他日调元手，看取今朝雪里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其一 席上赠别","author":"管鉴","text":"杨柳梢头月未残。\n杏花开尽却春寒。\n宾鸿社燕寻常别，渭北江东别更难。\n尊欲尽，夜将阑。\n明朝马首便长安。\n悬知不作人间住，归去春风玉笋班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其三 为妻寿","author":"管鉴","text":"前日新冬举寿觞。\n今朝喜色又非常。\n一阳生后逢生日，日渐舒长寿更长。\n移晚宴，庆新堂。\n堂前高竹早梅芳。\n年年一为梅花醉，醉到千回鬓未霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读兰皋先生集","author":"缪志道","text":"自少从诸老，如公能几人。\n斲轮推老手，削鐻妙惊人。\n人物九泉古，诗名千载新。\n矮窗遗稿在，一读一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狮子岩","author":"缪烈","text":"幽岩萧飒商飙起，一天灏气凉如水。\n金井梧飞兰谷芳，长江浪冷莼鱼美。\n雁字半侧银钩攲，云光净扫光陆离。\n桂花岩下香满枝，随意催送到书帷。\n碧潭烟敛琉璃滑，素娥乘鸾下天阙。\n清晖深射水晶宫，虚明澄澈蛟龙窟。\n上下天光一镜浮，冰轮碾破一天秋。\n今来古往事悠悠，月自升沈水自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台 其二","author":"缪瑜","text":"桐庐江中秋水清，富春山中秋月明。\n钓竿千尺无恙在，持竿我欲从先生。\n先生岂是傲当世，鄙夫患失滔滔是。\n狂澜既倒挽之回，持报故人惟此尔。\n衮衣不博一羊裘，事往台空江自流。\n遂令千古重名节，于乎先生真汉杰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台 其一","author":"缪瑜","text":"王阳在位贡公喜，何况故人作天子。\n掉头不肯从渠游，却把丝竿钓江水。\n欲将此意问遗灵，寂寞江山唤不应。\n至今桐江一拳石，留得人间千古名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遇灾报应诗","author":"缪瑜","text":"郁攸属者潜煽灾，蜚廉纵风相与偕。\n林林生齿七万户，连甍接栋烧成灰。\n如何老翁一区宅，间不以寸独不㶼。\n玉石俱焚势应尔，岂有幻术能然哉。\n闻之翁乃好善者，平时事佛经卷开。\n有馀必以济贫乏，不以利欲萦其怀。\n仓卒遂蒙鬼神护，万目注视咸惊猜。\n厥初巨燄爇天起，左顾右盼如燔柴。\n翁知无脱免，委身甘作烬与煨。\n麾儿与妇令亟走，誓死不去无违乖。\n全家酣寝越信宿，如闻大浪声喧豗。\n及其梦觉火亦息，依然一室当崔嵬。\n微如蒲萄不熏灼，而况梁栋与桷榱。\n苍苍表善有如此，馀自作孽何足哀。\n作诗志往劝来者，勿以斯语同优俳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"缪瑜","text":"游人柳叶蹙鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"缪瑜","text":"有客去游丞相阁，无人来问孝廉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"缪瑜","text":"栖雅照日黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"缪瑜","text":"亭台十二眼双明，一幅画图开水墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应举早行","author":"缪蟾","text":"半恋家山半恋床，起来颠倒著衣裳。\n钟声远和鸡声杂，灯影斜侵剑影光。\n路崎岖兮凭竹杖，月朦胧处认梅香。\n功名苦我双关足，踏破前桥几板霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"磨崖碑","author":"翟天翼","text":"元公具述鲁公书，文象相参翼轸区。\n语气一时扬盛德，词锋千古挫凶徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其二","author":"翟佐","text":"畴昔追随日，团头笑语同。\n酒船浮大白，荔圃擘轻红。\n入社惭招亮，忘年肯友戎。\n向来觞咏地，古木起悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓 其一","author":"翟佐","text":"当年汗漫期，蟾窟折危枝。\n四海习凿齿，三生杜牧之。\n凄其一声笛，已矣八哀诗。\n忍看亭前柳，青青似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸水","author":"翟杰","text":"癸水绕东城，刀兵不用忧。\n须勤疏道力，常使达潮头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题米元晖山水","author":"翟耆年","text":"善画无根树，能描朦?山。\n如今身贵也，不肯与人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽赵秋晓","author":"翟龛","text":"早向南宫掇一筹，英声藉藉出南州。\n襟怀雪月五更晓，器宇江天万顷秋。\n方羡庐山高筑室，奚虞夜壑遽藏舟。\n天朝弗为斯文地，才羡如公不久留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王祥季昆","author":"翟龛","text":"右军孙子总奇才，一别俄惊秋又来。\n冠佩正宜朝凤阙，钓竿未许老鳌台。\n云昏野寺疏钟断，潮落寒汀野鹤回。\n咫尺相思不相见，渴心吟望欲生灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔清献公祠堂落成","author":"翟龛","text":"象笏犹存旧典型，魏谟亦此振家声。\n矧今故第堂堂复，不日新祠恰恰成。\n嘉定间关全蜀险，端平仓卒护乡城。\n此功此德垂千古，自有人人香火情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣衣曲","author":"翟澥","text":"寒蛩何处栖，栖傍砧石月。\n停砧问蛩鸣，砧动蛩复歇。\n似鸣辛苦心，欲替征人说。\n去年旧衣寄谁去，今年新衣织到曙。\n却移砧石来支机，蛩鸣复在支机处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵子固水仙图","author":"翠屏道人","text":"翠带悬珰重，凌波步步轻。\n春深不成怨，锦瑟夜无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 其一 贺赵可父七月初六","author":"翠微翁","text":"蓂荚才开六，宝历已当千。\n人间收尽繁溽，凉意入琴弦。\n尽道荐衡交剡，更值生申时节，喜色动闾阎。\n终夜望银汉，文宿贯台躔。\n定燕秦，封晋魏，信当然。\n处处红莲开幕，曹掾岂能淹。\n见说玉堂飞诏，已许金闺通籍，蓬岛伴神仙。\n来岁寿卮酒，应醉御炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹫峰院","author":"臧子常","text":"望穷山下疑无路，行入壶中别有天。\n花落春岩朝带雨，月涵秋谷夜闻泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠终南英公上人","author":"臧丙","text":"是个人言好性灵，镐京碑记念千厅。\n五言出格为诗匠，百盏长杯应酒星。\n曾把篆求身上紫，几将金买面前青。\n多闻国士相寻访，莫把松门画夜扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"臧馀庆","text":"橘里风烟好，壶中日月长。\n松身鹤发自安强。\n应有老人呈瑞、动光芒。\n酒饮无边酒，香烧不断香。\n从今乞与醉为乡。\n更醉百年三万、六千场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其三","author":"臧馀庆","text":"交广出沉香，路遥难致。\n何况卑人更不易。\n寿星香帕，我又几曾识置。\n有般祝寿底，忒忔戏。\n剪下一张，池州表纸。\n捻得轻圆更滑腻。\n五双纸捻，管打十个喷嚏。\n□□□□儿，一百岁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其一","author":"臧馀庆","text":"消息近春来，东风还又。\n先借椒盘劝金斗。\n坐间和气，压尽一番梅柳。\n掖庭频寓直，君恩厚。\n天祐两宫，南山齐寿。\n况有仙丹在公手。\n论功医国，合在药王之右。\n不妨千岁饮，长生酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其二","author":"臧馀庆","text":"南岳有真仙，人间祥瑞。\n酒量诗豪世无比。\n晚年林下，做个清闲活计。\n诮如千岁鹤，巢云际。\n此日大家，广排筵会。\n酒劝千钟莫辞醉。\n昔时彭祖，寿年八百馀岁。\n十分才一分，那里暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"臧馀庆","text":"寿菊才开三四葩。\n秋光着意主人家。\n清香未许人间识，先占重阳醉紫霞。\n儿绿绶，母金花。\n斑衣庭下乐无涯。\n要知他日中书考，细数沙堤堤上沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"臧馀庆","text":"天与君王管晏才。\n尚书两曳履声来。\n今朝望着楼头看，已有台星照斗魁。\n金蹀躞，玉崔嵬。\n天香满袖早朝回。\n中书尚享无穷考，长揖南风醉寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹岩","author":"臧辛伯","text":"元柳搜奇□□□，□□□□□诗传。\n眼看岩□□□□，□□□明却有天。\n溜□□□□□□，□藤穿壁锁晴□。\n□□□□□□古，望断飞鸿夕照边。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浯溪","author":"臧辛伯","text":"四山凝碧一江横，读尽唐碑万感生。\n却想老仙明月夜，度香桥下听溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东峰亭","author":"臧诜","text":"水西庭榭枕东峰，终日秋阴一径松。\n月到滩心来白鹭，云浮潭面起苍龙。\n最宜翠敛前山雨，长是声闻近寺钟。\n报捷功名今共闻，时携樽酒访遗踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"臧鲁子","text":"澹露零空，好风光袂，月华飞入觥筹。\n青莲碧藕，芡实与鸡头。\n笑傲纶巾羽扇，有如此、人物风流。\n西湖上，不妨游戏，民富自封侯。\n骈蕃。\n新宠渥，弃华延阁，领事园丘。\n看木牛流马，恢复神州。\n万里凉霄浩渺，使星共、南极光浮。\n从今好，一秋长醉，直醉过千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"臧鲁子","text":"露洗银潢，风来玉宇，正当□□□□。\n□□□阁，争看拥冰轮。\n共指银河影里，依稀见、执斧仙人。\n还知么，天教此夕，嵩岳再生申。\n夤缘，当阃寄，高明洞物，爽气侵云。\n记广寒宫殿，曾对高真。\n玉兔捣馀灵药，霞觞化、万种花春。\n嫦娥嘱，愿公难老，长似月精神。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"臧鲁子","text":"虎踞龙蟠万古雄。\n横飞一节大江东。\n今归定作鸾坡客，笔底山川写不穷。\n吟柳絮，赋东风。\n年年春在建章宫。\n天教随佛生人世，恰似河沙寿我公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人远游","author":"蔡士裕","text":"慵为香兰读楚骚，俊游不惮著鞭劳。\n千钧弩底机方彀，百尺楼中气正豪。\n水激鱼龙江月暗，云翻雕鹘海风高。\n相逢要把精神对，应笑狂吟短发搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅","author":"蔡士裕","text":"风饕雪虐大江头，苔藓鳞鳞绾铁虬。\n清绝一枝先百卉，密攒万蕊傲千秋。\n本无烟火尘氛气，洗尽铅华脂粉羞。\n月夜携樽相对饮，恍疑身世在罗浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行","author":"蔡士裕","text":"无计远尘嚣，寻幽过野桥。\n风刀削林杪，云带束山腰。\n水抱孤村迥，舟回断岸遥。\n几时忘俗虑，来此伴渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜宿田家夜久不寐","author":"蔡士裕","text":"凉涵诗魄瑩苍旻，散发吟商月满襟。\n风叶顺行芦叶尾，露华逆上稻花心。\n千山欧子秋声赋，一室希公夜气箴。\n坐待河倾天欲曙，邻翁起汲井桐阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题所藏赵清献公梅花图","author":"蔡士裕","text":"鹅溪白茧光昭回，上写罗浮山南绝壁之寒梅。\n霜台铁面太孤峭，槎牙诘曲可望不可摧。\n我疑华光道人云水绝，为花传神惟有月。\n胸中若无一片冰雪心，焉能写此万古冰雪骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠琴士周芝田","author":"蔡士裕","text":"吾诵老韩听颖诗一章，琴中意味深且长。\n纵横变态浩无尽，颖弦韩笔相发扬。\n二贤往矣五百载，俯视六合空茫茫。\n今有芝田嗣颖传宫商，一弹令我喜，再弹令我伤。\n世多善手无善耳，使我百感煎中肠。\n高冈不闻鸣老凤，江湖夜雨啼寒螀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金缕曲 罗帛剪梅缀枯枝，与真无异作","author":"蔡士裕","text":"怪得梅开早。\n被何人、香罗剪就，天工奇巧。\n茅舍竹篱容不得，移向华堂深悄。\n别一样、风流格调。\n玉质冰姿依然在，算暗中、只欠香频到。\n著些子，更奇妙。\n有时来伴金尊倒。\n几徘徊、认成真后，又还误了。\n费尽东君回护力，空把芳心萦绕。\n竟不解、索他一笑。\n夜月纱窗黄昏后，为爱花、翻被花情恼。\n个恩爱，负多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浦湘曲 为金坛教谕干寿道考满怅词","author":"蔡士裕","text":"功名早。\n步武青云缭绕。\n斯文近有成效。\n绛纱拍拍春风满，香动一池芹藻。\n瓜期到。\n便勇撤皋比，此去应光耀。\n立登枢要。\n向红药阶前紫薇阁，管不负年少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张公洞","author":"蔡中道","text":"天上骡踪竟不回，洞门深闭密封苔。\n神光夜烛烧丹灶，淑气晴薰讲易台。\n瑶草春肥仙去远，紫芝云暖鹤归来。\n清游喜挟三茅客，杖履凌空雾雨开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彩云轩","author":"蔡元厉","text":"洞府神仙此是家，麻姑曾驻五云车。\n峰前三尺寒泉水，犹有白莲开旧花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遗履轩","author":"蔡元厉","text":"仙客相从往玉都，轩前惟见老松枯。\n春来试问梁间燕，还是当时旧履无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中阁","author":"蔡元厉","text":"万仞仙山插太空，山腰依约见蓬宫。\n人寰隔绝无烟到，洞府深沉有路通。\n石罅生云埋柱础，海光浮日照帘栊。\n野僧斋罢凭栏久，千里秋毫一望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤青峰","author":"蔡元厉","text":"琳馆松扉白昼扃，骖鸾人去已冥冥。\n天开远画楼台古，地得遗丹草木灵。\n万壑野云晴酿雨，一池秋水夜涵星。\n麻姑仙驭今何在，槛外孤峰晚更青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠逍遥子","author":"蔡元厉","text":"身在逍遥境，开庵寓此身。\n红尘不到处，白日独閒人。\n月满云山夜，花留玉洞春。\n坐中无俗客，猿鹤故相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一字天","author":"蔡公亮","text":"石室阴幽却朗然，仰窥长罅见清玄。\n不知谁把如椽笔，画出光明一字天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠华阳法师","author":"蔡卞","text":"师到华阳洞，山华几度开。\n祇应常救物，却遣世人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏茅山元符万宁宫","author":"蔡卞","text":"猗嗟三茅，得自初成。\n气合于无，与形俱升。\n孰希其风，必静必清。\n寥寥久哉，乃发先生。\n帝用尊之，载召来廷。\n乃亲其人，燕见妙语。\n乃锡命书，迨其俦侣。\n因其故庐，启此新宇。\n像图仙真，上肖帝所。\n神笔榜之，龙凤轩翥。\n天锡皇帝，聪明孝友。\n抱一用中，以绥九有。\n遐迩率从，尊道熙功。\n有欲求之，与在斯宫。\n作为好歌，以诏无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"蔡卞","text":"对掌紫枢参大政，同扶赫日上中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"蔡卞","text":"莫学饥鹰饱便飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]