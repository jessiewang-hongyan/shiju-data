[{"title":"湖中微雨戏作","author":"陆游","text":"搓罢青梅指爪香，一杯聊复答年光。\n莫言老子无人顾，犹得西施作淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖水愈缩戏作","author":"陆游","text":"瓜垄从来几邵平，镜湖复有一玄英。\n今秋雨少烟波窄，堪笑沙鸥也败盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村月夕四首 其二","author":"陆游","text":"锦城曾醉六重阳，回首秋风每断肠。\n最忆铜壶门外路，满街歌吹月如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村月夕四首 其四","author":"陆游","text":"谁持绿酒醉幽人，鹤氅筇枝发兴新。\n今夜湖边有奇事，青山缺处涌冰轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村月夕四首 其三","author":"陆游","text":"金尊翠杓犹能醉，狐帽貂裘不怕寒。\n安得骅骝三万疋，月中鼓吹渡桑乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村月夕四首 其一","author":"陆游","text":"客路风尘化素衣，闲愁冉冉鬓成丝。\n平生不负月明处，神女庙前闻竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村野兴二首 其二","author":"陆游","text":"山色空濛雨点微，醉中不觉湿蓑衣。\n何妨乞与丹青本，一棹横冲翠霭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖村野兴二首 其一","author":"陆游","text":"十里疏钟到野堂，五更残月伴清霜。\n已知无奈姮娥冷，瘦损梅花更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖堤","author":"陆游","text":"新月纤纤淡欲无，时闻鱼跃隔菰蒲。\n篮舆小放湖堤上，信有人间白玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"焚香昼睡比觉香犹未散戏作二首 其二","author":"陆游","text":"燕梁寂寂篆烟残，偷得劳生数刻闲。\n三叠秋屏护琴枕，卧游忽到瀼西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"焚香昼睡比觉香犹未散戏作二首 其一","author":"陆游","text":"小屏烟树远参差，吏散身闲与睡宜。\n谁似炉香念幽独，伴人直到梦回时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴剑","author":"陆游","text":"流尘冉冉琴谁鼓，渍血斑斑剑不磨。\n俱是人间感怀事，岂无壮士为悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶","author":"陆游","text":"西蜀琵琶逻逤槽，梨园旧谱郁轮袍。\n绣筵银烛燕宫夜，一饮千钟未足豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏雨","author":"陆游","text":"檐间秋雨时一滴，绝似汉嘉方响泉。\n不听此声三十载，梦回搔首一凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舍东四咏 其一 疏篱","author":"陆游","text":"数掩围柴荆，王维画不成。\n尤怜月中影，特地起诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗下戏咏三首 其二","author":"陆游","text":"三尺清池镜面平，剪刀叶底戏鱼行。\n吾曹安得如渠乐，傍渚跳波过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗下戏咏三首 其三","author":"陆游","text":"何处轻黄双小蝶，翩翩与我共徘徊。\n绿阴芳草佳风月，不是花时也解来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗下戏咏三首 其一","author":"陆游","text":"飞来山鸟语惺愡，却是幽人半睡中。\n新竹成阴无弹射，不妨同享北窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗前作小土山蓺兰及玉簪最后得香百合并种之戏作","author":"陆游","text":"方兰移取遍中林，馀地何妨种玉簪。\n更乞两丛香百合，老翁七十尚童心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"策杖","author":"陆游","text":"山翁老病入腰膂，坐觉诸儿行步奔。\n暂出衡门须策杖，千回上树更堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫溪驿二首 其一","author":"陆游","text":"它乡异县老何堪，短发萧萧不满篸。\n旋买一尊持自贺，病身安稳到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫溪驿二首 其二","author":"陆游","text":"云外丹青万仞梯，木阴合处子规啼。\n嘉陵栈道吾能说，略似黄亭到紫溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山园草木四绝句 其一 紫薇","author":"陆游","text":"钟鼓楼前宫样花，谁令流落到天涯。\n少年妄想今除尽，但爱清樽浸晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缃梅三首 其一","author":"陆游","text":"疏影横斜事已非，小园日暮锁芳菲。\n素绡应怯东风思，故著重重浅色衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缃梅三首 其二","author":"陆游","text":"香似海沈黄似酒，不禁风雪最迟开。\n放翁欲作梅花谱，蜡屐支筇日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缃梅三首 其三","author":"陆游","text":"红梅眼看风吹尽，更有缃梅亦已无。\n天与色香天自爱，不教一点上蜂须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落叶","author":"陆游","text":"万瓦清霜伴月明，卧听残漏若为情。\n无端木叶萧萧下，更与愁人作雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花","author":"陆游","text":"山杏溪桃次第开，狂风正用此时来。\n未妨老子凭栏兴，满地残红点绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬园杂咏五首 其三 葱","author":"陆游","text":"瓦盆麦饭伴邻翁，黄菌青蔬放箸空。\n一事尚非贫贱分，芼羹僭用大官葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葺舍","author":"陆游","text":"蚁知将雨先移穴，燕护新雏迭守巢。\n补漏支倾吾可笑，呼奴乘屋更添茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢朱元晦寄纸被二首 其二","author":"陆游","text":"纸被围身度雪天，白于狐腋软于绵。\n放翁用处君知否，绝胜蒲团夜坐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢朱元晦寄纸被二首 其一","author":"陆游","text":"木枕藜床席见经，卧看飘雪入窗棂。\n布衾纸被元相似，只欠高人为作铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢君寄一犁春雨图求诗为作绝句二首 其二","author":"陆游","text":"老农虽瘠喜牛肥，回首红尘万事非。\n耕罢春芜天欲暮，小舟冲雨载犁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢君寄一犁春雨图求诗为作绝句二首 其一","author":"陆游","text":"说著功名我自羞，喜君解剑换吴牛。\n莫将江上一犁雨，轻博人间万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢张廷老司理录示山居诗二首 其一","author":"陆游","text":"憔悴经年客瘴乡，把君诗卷意差强。\n古人三语犹嗟赏，况是珠玑满锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢张廷老司理录示山居诗二首 其二","author":"陆游","text":"老觉人间万事非，但思茆屋映疏篱。\n秋衾已是饶归梦，更读山居二十诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢韩实之直阁送灯二首 其一","author":"陆游","text":"玉作华星缀绛绳，楼台交映暮天澄。\n东都父老今谁在，肠断当时谏浙灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢韩实之直阁送灯二首 其二","author":"陆游","text":"旧友年来不作疏，华灯乃肯寄蜗庐。\n宁知此老萧条甚，二尺檠前正读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢演师送梅二首 其二","author":"陆游","text":"折送江梅意不疏，要教相对斗清臞。\n为君著向明窗下，试问山翁具眼无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"越王楼二首 其二","author":"陆游","text":"蒲萄酒绿似江流，夜燕唐家帝子楼。\n约住筦弦呼羯鼓，要渠打散醉中愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"越王楼二首 其一","author":"陆游","text":"上尽江边百尺楼，倚栏极目莫江秋。\n未甘便作衰翁在，两脚犹堪蹋九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道上见梅花","author":"陆游","text":"载酒房湖风日美，探梅喜折一枝新。\n今朝忽向街头见，万萼千跗俗却春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道山直舍","author":"陆游","text":"身世从来一蠹鱼，讨论犹记入朝初。\n自怜报国无他技，又领兰台四库书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂咏六首 其四","author":"陆游","text":"万法元须一理通，长生极治本同功。\n广成千岁无它术，祇在唐虞二典中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂咏六首 其一","author":"陆游","text":"精神有限惟当啬，造化无心不汝私。\n此事安须知决择，鸡鸣勿后老人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂咏六首 其五","author":"陆游","text":"莫缘侯印学阴谋，生世惟须一钓舟。\n轻用镆铘终折缺，善刀何止解千牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂咏六首 其三","author":"陆游","text":"冰霜难与夏虫语，晦朔岂容朝菌知。\n忿欲至前能小忍，人人券内有期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂题四首 其四","author":"陆游","text":"勘书窗下松明火，采药溪头槲叶衣。\n只在人间人不识，秋风又见雁南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂题四首 其二","author":"陆游","text":"闻说湖中有钓舟，烟波出没杂轻鸥。\n一声清啸去已远，我欲从之何处求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道室杂题四首 其一","author":"陆游","text":"早访丹砂上岣嵝，晚提河派溯昆崙。\n阴符后出君无忽，三百奇文要细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f