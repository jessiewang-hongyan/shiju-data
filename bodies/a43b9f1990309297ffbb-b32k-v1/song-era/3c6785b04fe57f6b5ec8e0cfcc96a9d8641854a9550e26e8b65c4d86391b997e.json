[{"title":"颂古三十一首 其二十三","author":"释如本","text":"家世拄杖，佛祖付嘱。\n沩山寄来，香严发哭。\n父子投机，阳春雪曲。\n不是知音，大难相续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释如本","text":"久雨不晴，戊在丙丁。\n通身泥水，露出眼睛。\n且道是什么眼睛，林间泥滑滑，时叫两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释如本","text":"李四有钱不解饮，张三解饮又无钱。\n相招丰乐楼中看，不怕寒威雪满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"干藏","author":"释如净","text":"瞿昙老贼口亲屙，驴屎相兼马屎多。\n打作一团都拨转，泼天臭恶恼娑婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化炭","author":"释如净","text":"一刀两段没商量，透出无明大火坑。\n再入死灰烹得活，岁寒声价转峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牛图","author":"释如净","text":"柳堤烟敛春风静，鼻孔辽天一牯牛。\n拽转通身依旧黑，野花芳草转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风铃","author":"释如净","text":"通身是口挂虚空，不管东西南北风。\n一等与渠谈般若，滴丁东了滴丁东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞 其二","author":"释如净","text":"摩耶落赚屙出来，撞入草窠打一回。\n谁知有屈叫不得，殃害儿孙作罪魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼真歇塔","author":"释如净","text":"歇尽真空透活机，儿孙相接命如丝。\n今无倒指空肠断，杜宇血啼花上枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观使太尉张求颂","author":"释如净","text":"居士眼睛吞佛祖，衲僧鼻孔透乾坤。\n眼睛鼻孔初无间，万古宗门结痛冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞 其一","author":"释如净","text":"端坐圆通微妙相，众生眼里堆青嶂。\n晓来窗外听啼禽，春风不在花枝上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞 其二","author":"释如净","text":"头上宝冠牛戴角，脚下莲华马踏蹄。\n通身璎珞皮毛债，历劫风流辊水泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲人更衣","author":"释如净","text":"老胡教网漫天阔，当甚多年椀脱丘。\n勘破转关千圣外，别行条贯结冤雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其二","author":"释如净","text":"金乌飞上玉阑干，黑漆昆崙背面看。\n毕竟者些传不得，落花流水太无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧翁","author":"释如净","text":"自家鼻孔自家穿，自家绳索自家牵。\n自家忽地都忘却，一笛清风送楚天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"济颠赞","author":"释如净","text":"天台山里五百牛，跳出颠狂者一头。\n赛尽烟花瞒尽眼，尾巴狼藉转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送亮藏主谒碧云","author":"释如净","text":"咬狗猪汉烂泥团，撮著参天剑刃寒。\n转入春风开笑眼，桃花红照碧琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送觉兄归洞庭","author":"释如净","text":"觉尽还源见本心，洞庭无盖碧沈沈。\n衲僧不作这伎俩，浪急风高意转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧","author":"释如净","text":"生逼猢狲坐铁砧，一槌天地尽崩沈。\n横来竖去呵呵笑，吃饭噇眠迈古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其八","author":"释如净","text":"策起眉毛答问端，亲曾见佛不相瞒。\n至今应供四天下，春在梅梢带雪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其七","author":"释如净","text":"一个乌梅似本形，蜘蛛结网打蜻蜓。\n蜻蜓落了两片翼，堪笑乌梅咬铁钉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其六","author":"释如净","text":"张来张打油，李来李打油。\n通身骨辘转，打得最风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其五","author":"释如净","text":"肘后蓦生闲络索，风前忽布闹叉撑。\n那吒八臂空惆怅，夜半三更白昼行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其四","author":"释如净","text":"万物朝元不较他，拈来直截辨誵讹。\n游春浪子风流甚，卖弄三文黑老婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其三","author":"释如净","text":"钟声披起郁多罗，妙用灵通变化多。\n贼是家亲须扫迹，太平无象始安和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其二","author":"释如净","text":"唤一声兮应一声，两个分明好弟兄。\n倒却门前刹竿著，芳草漫天荆棘生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其五","author":"释如净","text":"衲衣下事火烧山，腊月家贫彻骨寒。\n堪笑连延曾未息，眉毛焦赤面皮乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释如净","text":"一桡劈口虚空破，三点驴头覆却船。\n父子至今俱不了，江湖波浪错流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释如净","text":"金乌飞上玉阑干，黑漆昆崙对面看。\n毕竟这些传不得，落花流水太无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十五","author":"释如珙","text":"五台山上云蒸饭，佛殿阶前狗尿天。\n刹竿头上煎䭔子，三个猢狲夜簸钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其四","author":"释如净","text":"钻冰取火凭谁信，拚命工夫入死门。\n脱体一交翻得活，金刚正焰透乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其三","author":"释如净","text":"十方聚会鱼游网，三月安居鸟入笼。\n生杀尽时蚕作茧，心空及第黑山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其一","author":"释如净","text":"不曾动步上天台，金锁玄关尽豁开。\n坐断鞔峰第一句，万机俱透起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十二","author":"释如净","text":"万派朝宗一派收，扬清激浊几经秋。\n忽然到底都乾却，露柱灯笼笑不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王安石","text":"浓绿万枝红一点，动人春色不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十一","author":"释如净","text":"莫谤瞿昙今日生，插天山岳势峥嵘。\n一番雨洗添狼藉，万古风烟恨不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十三","author":"释如净","text":"古佛不曾过去，现在法如是。\n一声婆饼焦，啼在竹林里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十六","author":"释如净","text":"一粒曾生无相田，异苗繁茂试机先。\n庄严劫佛借他力，双树荫凉本自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十五","author":"释如净","text":"到纯无学处，语路若何生。\n意气天然别，神笔画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十二","author":"释如净","text":"心田法地有灵苗，不动金锄耕步休。\n何事长松脩竹下，风师雨客逐春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十一","author":"释如净","text":"云形水意拥通身，德用不孤道正亲。\n年少风流犹一段，花棚铺锦蝶飞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其十","author":"释如净","text":"无明暗室勿入近，暮日江山相映红。\n处处烟尘收不得，早来晚去失真风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其九","author":"释如净","text":"时节因缘佛性义，共移灵棹渡头舟。\n玉麟带月离云汉，金凤衔花下彩楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其八","author":"释如净","text":"一机织作锦衣裳，是可太平君子床。\n只许宝山堆这里，细把玉针贞上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其六","author":"释如净","text":"不劳澄九鼎，流动百花新。\n木鸡前树报，月磨萝镜轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其四","author":"释如净","text":"金牛弄得烂银蹄，耕破劫空田地开。\n不带泥痕今古路，牧童疏笛入云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其十","author":"释如净","text":"瑞岩一只破木靴，几个搀来尽要拖。\n唯有老僧能踢脱，出门赤脚笑呵呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其七","author":"释如净","text":"十二峰前上戏棚，那吒赤脱点天强。\n屈烦鼓笛低头舞，弄丑真堪笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十七","author":"释如净","text":"寿皇顶?老冤魔，痛念先师旧草窠。\n聊借蒲团供打坐，大家拍手唱山歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十五","author":"释如净","text":"把钓归来得锦鳞，充天塞地笑忻忻。\n虽然也只寻常事，历尽风波验尽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十四","author":"释如净","text":"至人垂化无生死，示现阎浮有去来。\n刹刹尘尘成正觉，黄金宝殿玉楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其九","author":"释如净","text":"无忧树下浴婴孩，清晓蔷薇带露开。\n转过衲僧相见处，后槽驴马出胞胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其一","author":"释如净","text":"截断程途蓦直来，乾坤洞彻此门开。\n左边拍兮右边吹，倒翻关捩起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"接待","author":"释如净","text":"饭箩无底乾坤窄，舀出炎炎热铁丸。\n烂断饥肠重瞥地，佛魔无处辨来端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"善财赞","author":"释如净","text":"捏住乾坤粉一团，大人刚被小人瞒。\n机先若具机先眼，走杀从教起衅端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举太尉张求颂","author":"释如净","text":"平生道德迈前贤，著汉衣冠拜汉天。\n自是名高闲不得，阿难依旧世尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"敬溪翁","author":"释如净","text":"揭翻古剡岸云开，峻发清机劈箭来。\n裂转面皮乾剥剥，万山奔浪笑咍咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端狮子赞","author":"释如净","text":"咄哉捏怪老狐狸，披起金毛狮子皮。\n弄尽任从天外去，尾巴败露已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无用顶相赞","author":"释如净","text":"打杀宣州花木瓜，爆出越州翁木大。\n血滴滴风衮剑轮，黑漫漫弥天罪过。\n咦，描邈者个贼头，三千里外谁耐面热而汗迸流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞 其一","author":"释如净","text":"冻不死，饿不死，深山走出这面觜。\n咦，人间天上风波起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四睡图赞","author":"释如净","text":"拾得寒山，老虎丰干。\n睡到驴年，也太无端。\n咦，蓦地起来开活眼，许多妖怪自相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其一","author":"释如净","text":"乌龟壳空索索，打一钻响剥剥。\n也是张拳嚇野狐，描邈出来增丑恶。\n虽然三十年后，只管有人卜度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞 其三","author":"释如净","text":"心尘脱落开岩洞，自性圆通俨绀容。\n天子敬，龙之恭，不以为喜安然中。\n咦，更荐海涛翻黑风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其一","author":"释如净","text":"豁然无圣，自作自败。\n面壁钉桩，犹敢捏怪。\n叵耐神光屙一堆，引他臭秽遭他坏。\n咦，葛藤荒草遍乾坤，年年剩欠春风债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞 其三","author":"释如净","text":"脚下茎芦，到岸也未。\n直指人心，驴屁狗屁。\n咦，千古丛林遭钝置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听松风布袋赞 其一","author":"释如净","text":"松风鸣，侧耳听，扪腹而笑，贼精贼精。\n咦，千古万古得人憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"言法华赞","author":"释如净","text":"脚下长拖破木履，口内不知道甚底。\n恼乱风光没奈何，南北东西无定止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拄杖颂寄松源和尚","author":"释如净","text":"七尺乌藤挂东壁，春风忽来生两翼。\n鞭起飞龙趁不得，洞庭搅碎琉璃碧。\n去兮去兮明历历，梅花影里休相觅。\n为雨为云自古今，古今寥寥有何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山律师赞","author":"释如净","text":"优波离后身，韦将军捧足。\n布衣真童男，瓦钵天厨食。\n咦，历劫戒光秋月明，南山静照烟霜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉大道赞","author":"释如净","text":"棒头挑起葫芦，手里伸出钵盂。\n噇酒噇肉破落户，天上人间大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"相士","author":"释如净","text":"月落沧溟夜渺漫，衲僧面目太寒酸。\n拟将祸福轻偷眼，恶浪狂风衮乱山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蜀僧得母书归乡","author":"释如净","text":"雁落秋空剥万金，寥寥一片老婆心。\n先天后地难回互，风急恩深冤亦深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧见明极和尚","author":"释如净","text":"机丝抽尽万缘平，休倚寒岩转路程。\n千圣不携无影像，那边借伴月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圆觉图赞","author":"释如净","text":"一队猪狗汉，围绕业识幢。\n只管要说傍人罪过，不知败缺自己贼赃。\n咄，太平无象打一椎，惊破虚空闪电飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涂田","author":"释如净","text":"劄断潮头大海枯，十方公界佃官租。\n寥寥万古平如掌，不许傍人扬契书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"起净慈方丈","author":"释如净","text":"方方一丈牯牛栏，佛祖驱来要透关。\n聊借眉毛相架搆，遮天盖地黑漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其一","author":"释如净","text":"清贫三盏便轻酬，万里曹门出郑州。\n尽情斫却月中桂，恼乱春风卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其八","author":"释如净","text":"妙音观世音，具足神通力。\n十方诸国土，无刹不现身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其七","author":"释如净","text":"平地起骨堆，虚空剜窟笼。\n蓦透两重关，拈却黑漆桶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]