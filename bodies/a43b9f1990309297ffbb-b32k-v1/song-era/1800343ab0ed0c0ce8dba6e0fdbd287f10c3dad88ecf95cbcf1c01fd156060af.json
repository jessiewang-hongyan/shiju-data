[{"title":"看梅","author":"李龙高","text":"蹋雪迢迢过水涯，翠禽见客却咨嗟。\n此翁只识孤山路，不识玄都观里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禹庙","author":"李龙高","text":"古庙峨峨拥衮裳，苍龙千载锁飞梁。\n向来更有稽山穴，谁把梅花荐一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种梅","author":"李龙高","text":"别岭移根置小园，半锄明月半锄云。\n世间下是无花卉，若个清高得似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重叶梅","author":"李龙高","text":"雪片层层簇玉林，寒窗光烱照人心。\n春风著物须平等，那得工夫有浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射梅","author":"李龙高","text":"由基去后挥瞻来，不惯穿杨惯射梅。\n寄语东居莫涂抹，牺樽自是木之灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃梅","author":"李龙高","text":"素面何曾学艳妆，子肥刚带苦心肠。\n谁知刬被虚名误，污却莲花是六郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"消梅","author":"李龙高","text":"冰融雪化一须臾，清脆圆松压塞酥。\n我有牢愁三万斛，问君消得几分无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胭脂梅","author":"李龙高","text":"卸却云衣明月珰，轻朱傅脸锦为裳。\n古来美艳多招妒，不似临风且淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读范谱","author":"李龙高","text":"刘叟空将芍药誇，欧公浪谱牡丹花。\n如君更把凡花品，俗了吴门一范家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸳鸯梅","author":"李龙高","text":"莫是夷齐幻出身，又疑洛下见机云。\n世人苦被风情累，也把妖名涴却君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄梅","author":"李龙高","text":"范子经年别陆郎，陆郎远致一枝香。\n料伊正作关山梦，望见梅花也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅","author":"李龙高","text":"问讯南枝开未开，花神许我日徘徊。\n桐江一缕清风在，莫误刘郎物色来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"接梅","author":"李龙高","text":"中条隐士裂唐麻，角里先生就汉车。\n一种寒酸真本色，羞将槁淡博繁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅友","author":"李龙高","text":"老子平生怕热瞒，论心只可话馀酸。\n刘郎枉了誇豪杰，甘向伾文托岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅兄","author":"李龙高","text":"花萼相辉暗递香，岂无难弟伴元方。\n水仙只可供奴隶，合得诗人作雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅台","author":"李龙高","text":"弹压群芳不敢开，清高地位隔尘埃。\n抬头一见风霜面，莫是花中御史来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅关","author":"李龙高","text":"南窥海岭北江津，截断青山客路尘。\n千载子真应冷笑，吾侬不是守门人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅初落","author":"李龙高","text":"身后传芳自古难，回头一笑旅空山。\n飞时莫过妆台去，只可诗人笔砚间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅实","author":"李龙高","text":"青子累累荐几何，眉颦齿软怎消磨。\n可怜只识闲滋味，不道酸心事尚多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅屏","author":"李龙高","text":"含冰茹铁似枯槎，淡月濛濛四五花。\n多少人家誇富贵，数枝和雪写山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅香","author":"李龙高","text":"忍饥抱冻老穷崖，一点檀心未肯灰。\n夷甫彦回空似玉，却曾遗臭汗青来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅窗","author":"李龙高","text":"月射云绡印玉腮，风穿罅隙度香埃。\n莫将易向花边读，惹得周公入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅影","author":"李龙高","text":"月地云阶是画图，溪腰水面更工夫。\n平生一片心如雪，为问姮娥貌得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅蕊","author":"李龙高","text":"红蕊盈盈费刻镂，芳心未露似含羞。\n俗儿鼻孔难凭据，只道无香刬恁休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅篱","author":"李龙高","text":"庑下浮沈老伯鸾，树间寂寞隐申蟠。\n主翁倘解怜芳洁，莫作藤萝枳棘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清江","author":"李龙高","text":"玉雪缤纷数丈花，石湖老子极称誇。\n渠侬不是琴台女，那得生来傍酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿珠楼","author":"李龙高","text":"危甍连绮百千株，人去莺飞半朵无。\n太白莫嗟金谷树，绛霄楼外亦平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅","author":"李龙高","text":"懒将冰萼试红妆，也不随宜传蜡黄。\n当日琼林消息断，绿衣犹带旧时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊梅","author":"李龙高","text":"千林摇落梅新蓓，万卉披猖菊未莎。\n岁晚幽人空谷里，渊明和靖不争多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野梅","author":"李龙高","text":"千山木落涧风豪，十里瑶林月邑高。\n醉尉不来村墅冷，三更绕树读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪梅","author":"李龙高","text":"雪飞不到越王台，万树千枝满意开。\n花太清高天也妒，转教滕六御风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄香梅","author":"李龙高","text":"云叶重重护雪花，玉人隐隐隔窗纱。\n虽然不带微酸味，免与时人置齿牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒梅","author":"李龙高","text":"绵衣早觉污陈子，冬服何能薄顾郎。\n不是生平誇强项，众芳无奈怯风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疏梅","author":"李龙高","text":"瘦削丰姿淡伫妆，三三两两立冰霜。\n春风只爱私红紫，可是梅花欠主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"硬梅","author":"李龙高","text":"风棱玉面耿无尘，铁脊今成老大身。\n莫怪一身多崛强，渠侬元是石心人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫蒂梅","author":"李龙高","text":"外面看来本色非，香袍隐映省垣薇。\n谁知傲睨风霜底，不改平生一布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏梅","author":"李龙高","text":"我爱溪桥半树开，几回觅句当衔杯。\n江南不欠花如雪，自是游人不看来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道山堂","author":"李龙高","text":"疏花斜映玉玲珑，曾见诚翁与放翁。\n犹有旧时相识在，几回搔首立春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"催梅","author":"李龙高","text":"笛声未了鼓轰雷，尽道梅寒苦要催。\n抵死争春如许急，有花毕竟待时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪梅","author":"李龙高","text":"村北村南眩玉田，孤芳岁晚转幽妍。\n老天恐被缁尘染，著在残山剩水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅","author":"李龙高","text":"枝枝六出试新妆，色界何曾识许香。\n只道单传餐玉诀，不知还解服硫黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜梅","author":"李龙高","text":"青女欺花战未分，花神直诉与东君。\n冰山回首知何许，依旧山人住白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东阁","author":"李龙高","text":"杜老花边惯撚须，却怜花傍驿亭居。\n德公便使游城府，肯受红尘半点无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋赋","author":"李龙高","text":"姚子编文去取难，将渠例与白歌删。\n后人要识心如铁，却向桃花赋里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纸帐","author":"李龙高","text":"氎巾几幅蹙鳞鳞，四面清香拥幻身。\n夜半梦回花也笑，想君不是饮美人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苔梅 其二","author":"李龙高","text":"铁骨槎牙花四五，虬皮封裹晕烂斑。\n极知不似君芳洁，也要相依度岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑笺","author":"李龙高","text":"老郑东都一钜儒，未知楠树与梅殊。\n平生博识犹如此，何况儿曹不读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盐梅","author":"李龙高","text":"世味明知可口难，到头终不换寒酸。\n直须袖却和羹手，何必贪居鼎鼐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真州","author":"李龙高","text":"仪真谁种满林梅，兵后危枝半草莱。\n便使萧条君莫叹，也曾惯见太平来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陶诗","author":"李龙高","text":"靖节当年不赋渠，仅题一字果何如。\n分明诗是梅花样，剩说梅花诗更癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅角","author":"李龙高","text":"朝暮相催鬓易星，酸风无奈送悲声。\n丁宁莫过黄芦塞，月落霜寒客半醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅亭","author":"李龙高","text":"飞甍面面枕冰霜，云抵轻纱月抵窗。\n莫怪能寒吟彻夕，一生无梦到沈香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瘦梅","author":"李龙高","text":"丰标病后维摩相，骨骼穷来贾岛诗。\n我亦清臞花莫笑，相逢休要话轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎跑泉","author":"李乔","text":"虎丘岩畔识泉根，股引琼腴此处分。\n品绝未应容易得，地灵难使等闲闻。\n声寒夜杂林间籁，气润朝随谷口云。\n十和清篇盈丽轴，强牵己句不成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平黎锡宴","author":"李乔木","text":"圣主当年重武文，柳营韬略孰同群。\n名播中外扬三殿，威遏鲸鲵震六军。\n宴锡九重恩浩荡，醉酣三爵坐氤氲。\n何人缓带当樽俎，彝鼎重看勒巨勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次南华寺","author":"李乔木","text":"衣钵相传旧，菩提漫尔栽。\n好山僧独占，冒暑我初来。\n野鸟迎人语，溪塘傍竹开。\n登临问因果，老衲笑相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙学堂","author":"李仲光","text":"天人异所禀，事物皆生知。\n强名仙学堂，此语将谁欺。\n我欲借隙地，虚檐敞茅茨。\n琅琅诵玉章，勉力探希夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙蜕","author":"李仲光","text":"昼夜本循环，天地均此理。\n人生出入机，昼夜差可拟。\n仙家学蝉蜕，脱然遗腐胔。\n白骨尚珍藏，似未忘生死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠弈棋蓝氏子","author":"李仲光","text":"古人制此文楸枰，要下黑白知死生。\n闲中借此消永日，未必能取人心争。\n后人不识古人意，致使方寸生纵横。\n烂柯人去弈秋死，通国善弈谁知名。\n东南地胜人最杰，下至百技今咸精。\n手谈坐决胜与负，蓝氏之子驰其声。\n沈机终日静不语，一子落手四座惊。\n肯堂为人百不解，僻性从来要疏快。\n推倒棋枰君莫怪，不向眼前论成败。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百字令 寿冯宪。是日，宴于古羊桃花下","author":"李仲光","text":"小红开也，问韶华、今年何事春早。\n尽道福星临照久，勾引东风仙岛。\n一点恩光，列城生意，万物无枯槁。\n圜扉深处，也应满地芳草。\n却怪有脚阳春，如何移向崆峒了。\n父老牵衣留不住，只有攀援遮道。\n翠柏杯中，蟠桃花下，君看朱颜好。\n路人遥指，他年黄阁元老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 寿赵帅","author":"李仲光","text":"诗书元帅，风流人物，看取方瞳如漆。\n铜驼陌上若相逢，当一笑、摩挲金狄。\n相门事业，中书考第，未数汾阳功绩。\n若将六十寿行年，才数得、百分之一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 自寿","author":"李仲光","text":"焚香清坐，呼童瀹茗，聊当一杯春酒。\n不须歌舞倩红裙，为祝百千长寿。\n诗书万卷，绮琴三弄，更有新词千首。\n从今日日与遨游，便是天长地久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 石门岩","author":"李仲虺","text":"门外数峰围绕。\n帖石路儿弯小。\n花老不禁风，委地乱红多少。\n人悄。\n人悄。\n隔叶数声啼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉乳泉","author":"李仲殊","text":"玉液煎琼甃，泓澄一脉泉。\n张生题品异，丞相与名传。\n荐客流霞胜，煎茶掇乳鲜。\n祇园终古在，长对白衣仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏崇道观","author":"李仲偃","text":"妙道心期赤水求，隙驹光景任川流。\n朝真净界琼台月，涤想鲜飙玉宇秋。\n芝茹荐盘香露散，茶腴烹鼎绿云浮。\n劳生可念荣华束，食顷邯郸枕上游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐君山","author":"李仲骧","text":"水尽露嵌嵚，红尘杂市音。\n西来天日远，东望白云深。\n塔□中流见，渔灯半夜沉。\n烟波竞名利，应负指桐心。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李会","text":"金沙滩上双鸂鶒，肯为分司御史来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爱山堂 其一","author":"蒋之奇","text":"我爱通羊好，民居山作城。\n眼前无俗事，枕畔有滩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爱山堂 其二","author":"蒋之奇","text":"我爱通羊好，环回云水间。\n重峦与叠嶂，真是翠屏山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爱山堂 其三","author":"蒋之奇","text":"我爱通羊好，清无半点尘。\n峭山多洞户，樵牧识仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦 其一","author":"李似权","text":"碧玉山头碧玉泉，琤琮声里数流年。\n不知曾与何人到，笑想丹题似昔缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦 其二","author":"李似权","text":"石壁苍苔露未乾，小池射日石团团。\n弄泉漱玉归何暮，风捲横云细细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与杜秀才","author":"李先","text":"南极多老人，及见九代孙。\n君今古儋州，气质清且温。\n今年八十二，颇觉行步奔。\n白须映红颊，疑是羲皇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李先","text":"宁舍济川航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其四 昌化郡长桥词","author":"李光","text":"独步长桥上，今夕是中秋。\n群黎怪我何事，流转古儋州。\n风定潮平如练，云散月明如昼，孤兴在扁舟。\n笑尽一杯酒，水调杂蛮讴。\n少年场，金兰契，尽白头。\n相望万里，悲我已是十年流。\n晚遇玉霄仙子，授我王屋奇书，归路指蓬丘。\n不用乘风御，八极可神游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 丞相李公伯纪寄示水调一阕，咏叹李太白，词采秀发。然予于太白窃有恨焉，因以陶渊明为答，盖有激云耳 其一","author":"李光","text":"元亮赋归去，富贵比浮云。\n常于闹里，端的认得主和宾。\n肯羡当年轩冕，时引壶觞独酌，一笑落冠巾。\n园圃日成趣，桃李几番春。\n挹清风，追往躅，事如新。\n遗编讽咏，敛衽千载友斯人。\n君爱谪仙风调，我恨楼船迫胁，终污永王璘。\n何似北窗下，寂寞可栖神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]