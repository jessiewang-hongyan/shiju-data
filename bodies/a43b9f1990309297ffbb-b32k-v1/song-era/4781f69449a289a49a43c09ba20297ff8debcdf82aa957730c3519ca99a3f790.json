[{"title":"三昧诸颂 其四","author":"释印肃","text":"空色无边际，离垢摩尼圆。\n能依实相用，助发有龙天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三昧诸颂 其三","author":"释印肃","text":"千光一合圆如镜，万象森罗影现中。\n此光大用如如体，道了桥成风月同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与王巡检 其二","author":"释印肃","text":"达磨非为后，瞿昙未是先。\n当来无量劫，懒翁得自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其七","author":"释印肃","text":"净人若信平常事，穿过髑髅连孔鼻。\n多中一了一中多，城东老母难回避。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其三","author":"释印肃","text":"行人到此宜回首，此物元来处处有。\n除非自己肯承当，方信境缘无好丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其一","author":"释印肃","text":"庭前雪子落纷纷，妙触灵明应普门。\n不是药山无用处，权令庞老警儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"加颂蜀僧雪颂 其四","author":"释印肃","text":"免使从前业浪奔，直入圆音普眼门。\n宾主历然谁委悉，不是通方莫与论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四字书窗以印实相 其二 观","author":"释印肃","text":"佳乘两口草标头，共见同看水牯牛。\n昨夜牧人无被盖，今朝犹笑道无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四字书窗以印实相 其三 定","author":"释印肃","text":"实离贯穿理不俱，一人直下体同渠。\n久停顽坐邪思起，返谤如来正觉虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四字书窗以印实相 其一 止","author":"释印肃","text":"得正无非离一安，印空圆足宝瀰漫。\n天魔外道从何有，体若虚空世岂干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其八 向火","author":"释印肃","text":"云冻风弥鸟绝踪，洞山只道没西东。\n等闲目击谁相委，赖遇丹霞作炭红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其十三 侍师","author":"释印肃","text":"百里千乡信未圆，到来空爇一寻烟。\n我今朝夕时闻见，粉骨碎身报未全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其三十 园头","author":"释印肃","text":"千百年前老古锥，锄山钁圃示箴规。\n蛇儿挑起无人会，直截横抛更勿疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其六 受持","author":"释印肃","text":"闻道真空不著言，信心清净在拳拳。\n只将此性光明遍，语默行藏岂离禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其十一 知客","author":"释印肃","text":"不亏扫地与煎茶，门户开关用法华。\n云迹雨踪来不住，个中谁肯速还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其十五 净头","author":"释印肃","text":"护净烧汤不离坑，慈和三昧益群盲。\n十方诸佛皆如是，岂效披毛业报生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其二十九 填路","author":"释印肃","text":"轰雷吼电警昏蒙，雨歇风清似脱空。\n佛教众生弘大道，资家报国续宗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其三十一 米头","author":"释印肃","text":"灵源车辙显来由，一粒穿时快疾收。\n莫待庐陵高索价，临机下口卒难酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其三十二 库司","author":"释印肃","text":"摩尼无价汝当收，金玉浮财誓莫求。\n戴角披毛从此入，百千万劫作驴牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其七 澡浴","author":"释印肃","text":"了身如幻向谁言，运水搬柴化有缘。\n忽遇浴堂人指水，轻清妙触转光鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其二十五 合药","author":"释印肃","text":"扁鹊卢医速退边，大家饱吃普庵圆。\n解冤释结消诸病，感应无方不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其十 香灯","author":"释印肃","text":"恒河沙劫奉如来，功未全时眼不开。\n自知本有灵光物，香灯不绝警痴呆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其四 坐禅","author":"释印肃","text":"夜静风悲人悄悄，众缘事办寂寥寥。\n趺坐结跏云汉定，谁知卧月忽明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其二十八 干桥","author":"释印肃","text":"直截无根树子铺，超凡越圣大心粗。\n忘躯为法方如此，担板真如大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其二十一 干竹","author":"释印肃","text":"绿节闲云间古风，茂林浓处没西东。\n子猷消息无人问，鸾凤飞来足印空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其九 饭头","author":"释印肃","text":"将勤补拙入厨中，不问青泥事事充。\n拾得寒山明此意，如今成佛满虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其十四 茶汤","author":"释印肃","text":"主宾交接未开言，便过茶汤应口边。\n察理聆音非外物，结他欢喜万千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其一 卯粥","author":"释印肃","text":"普目不拘开合眼，意光何必待天明。\n众人未起我周布，行益资他腹自膨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行住坐卧三十二颂 其五 习听","author":"释印肃","text":"生老病死苦相煎，唯我能知速弃捐。\n十二时中常念佛，闻师一举耳无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金刚随机无尽颂 其三 应化非真分第三十二","author":"释印肃","text":"如如皆合道，休向外边讨。\n大地作纤尘，万里无茎草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金刚随机无尽颂 其七 应化非真分第三十二","author":"释印肃","text":"易开终始口，会理休分剖。\n照镜失却头，引惹波波走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e