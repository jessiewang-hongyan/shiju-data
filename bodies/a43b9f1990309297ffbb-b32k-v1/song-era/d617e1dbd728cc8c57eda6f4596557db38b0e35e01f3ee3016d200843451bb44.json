cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明暗","author":"刘克庄","text":"大士千眼而明，老子一只而盲。\n或不夜能久照，谁吁天鸣不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"物化","author":"刘克庄","text":"今朝风物甚美，明日阴晴未知。\n夕阳无回照理，落花有上天时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试笔六言二首 其二","author":"刘克庄","text":"薰玉蕤香解秽，挽银河水涤尘。\n虽非补造化笔，不似食烟火人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试笔六言二首 其一","author":"刘克庄","text":"病鹤尚能孤唳，冻萤相守残编。\n世间有豁达老，天上无愚戆仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郤谢","author":"刘克庄","text":"蒙叟云大儒倡，晋人以小字呼。\n谢琰仅呼未婢，方回故是伧奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉千里侄秋试六言四首 其四","author":"刘克庄","text":"子心思犹盛壮，吾光阴已耋耄。\n不堪蝥弧先登，尚可鼓旗傍噪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉千里侄秋试六言四首 其三","author":"刘克庄","text":"茂才异等息响，太祝斋郎比肩。\n汝伯何由漆发，我家旧有青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉千里侄秋试六言四首 其二","author":"刘克庄","text":"童习好雕篆作，相业寓混成篇。\n犹之射者百中，勉旃原夫一联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉千里侄秋试六言四首 其一","author":"刘克庄","text":"而翁二子绝奇，其季虎中最怒。\n期此郎甲科郎，跨王父曾王父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其十二","author":"刘克庄","text":"适报翁子露绶，又闻孟博登车。\n田里觇赈贷议，墙壁挂宽大书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其十一","author":"刘克庄","text":"扶持村翁出来，问讯壶公安否。\n汝寒插帽蒙头，吾渴脱巾漉酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其十","author":"刘克庄","text":"不肯肩随谄子，幸留面见严君。\n晚驾笨车还里，岁将麦饭浇坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其九","author":"刘克庄","text":"黄烛分光过眼，柳条弄色关心。\n老死毋劳覆议，先生自谥醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其八","author":"刘克庄","text":"渊明甫涉知命，汲汲登皋临流。\n侬长渠三十岁，故当秉烛出游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其七","author":"刘克庄","text":"谩道三阳交泰，绝无一客来临。\n仲尼于复卦见，子美云人日阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其六","author":"刘克庄","text":"病不禁茅柴酒，寒添著木绵裘。\n寄语斜川鱼鸟，先生改日来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其五","author":"刘克庄","text":"昨夜身手和柔，今晨毛发飕飗。\n不堪早朝骑马，尚能夜起饭牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其四","author":"刘克庄","text":"黄亭瓮闻酒美，白湖船至籴平。\n珠衱丽人出郭，银钗村姑入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其三","author":"刘克庄","text":"宿露卷青步障，晨曦涌紫金轮。\n时平有戴白老，春晴宜踏青人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其二","author":"刘克庄","text":"七诫妇罕全者，四穷鳏居一焉。\n嗟余抱终身恨，与子结来生缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日六言十二首 其一","author":"刘克庄","text":"䙰褷病鹤翅短，虺隤老马力疲。\n不知大朝会事，且吟小家数诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事六言 其一","author":"刘克庄","text":"椒酒桃符改旧，麦芒菜甲怀新。\n东皇太乙用事，不能粉饰陈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事六言 其二","author":"刘克庄","text":"藻密难呼金鲫，柳疏未啭黄鹂。\n华发无重黑理，烧痕有再青时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其二","author":"刘克庄","text":"私怨有公论者，反噬非人情哉。\n颖叔发修阴事，资深叹轼奇才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其五","author":"刘克庄","text":"燕山张皇薄伐，艮岳文饰太平。\n黼贺尅复受赏，瓘忧分裂有萌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十八","author":"刘克庄","text":"绝交书谢伊辈，养生论真吾师。\n诗无风刺尤妙，史有天刑勿为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十三","author":"刘克庄","text":"书奸书盗不隐，讳周讳鲁若私。\n使乱贼惧直笔，于定哀多微辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十五","author":"刘克庄","text":"一部日录付婿，三经新义传儿。\n跻翁超乎亚圣，赞父光于仲尼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十","author":"刘克庄","text":"选人片言授钺，贵臣万里建侯。\n平洮致绿石研，复燕得碧云油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其七","author":"刘克庄","text":"丞相训子尤俭，夫人送女已非。\n盥面用瓦盆子，籍足以锦地衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十四","author":"刘克庄","text":"向来动脚已谬，末后濡尾转非。\n伏生力辞不至，申公不合而归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十一","author":"刘克庄","text":"拔舌犯世深忌，枕肱夸师绪言。\n徂徕生为鬼怪，伊川死尚还魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其九","author":"刘克庄","text":"京桧皆黄发老，攸熺各黑头公。\n当时号为小相，至今叹作顽童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十二","author":"刘克庄","text":"子长交游莫救，孙盛门户几危。\n执简而往误矣，阁笔相视得之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其六","author":"刘克庄","text":"门前客已去矣，屋里人安在哉。\n寒雀张罗可得，春燕衔泥不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其三","author":"刘克庄","text":"鼎镬烹东都党，烟瘴磨元祐人。\n但看纸上陈迹，始知陛下至仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十七","author":"刘克庄","text":"图霸卧薪尝胆，为农拾穗行歌。\n短衾敛首形矣，高官如跋疐何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其一","author":"刘克庄","text":"侍中谲取玉带，尚书苦爱貂蝉。\n家破谪黎母矣，冢穿无髑髅焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其四","author":"刘克庄","text":"骨朽是非始定，怒炎毁誉未公。\n太平呼奇宰相，野狐目半山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十六","author":"刘克庄","text":"惩舒之志甚锐，祚宋之言可悲。\n浓墨书奸党石，长绳拽粹德碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其二十","author":"刘克庄","text":"相郎穴厨而窃，王相坎壁以藏。\n十袭为传家宝，一点无入己赃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜温故六言二十首 其十九","author":"刘克庄","text":"辨才师苦死爱，文皇帝得许痴。\n温韬劫陵大盗，萧翼穿窬小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贵公子一首","author":"刘克庄","text":"春圃莺花围席，秋堂风露入帘。\n宁以肩承蹴鞠，不将手触牙签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送月蓬道人南游寄呈阳岩侍读直院侍郎六言三首 其三","author":"刘克庄","text":"□□士之渊薮，阳岩学者山斗。\n三麻九制□□，要渠一马来否。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送月蓬道人南游寄呈阳岩侍读直院侍郎六言三首 其二","author":"刘克庄","text":"首从淇奥君子，数到越王潞公。\n世仅有一两个，君毋□八十翁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送月蓬道人南游寄呈阳岩侍读直院侍郎六言三首 其一","author":"刘克庄","text":"昔燕见沉香亭，今送老破茅屋。\n醉翁之耳虽白，坡仙之鬓已秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫赴铜铅场六言七首 其二","author":"刘克庄","text":"盐铁论儿读否，聚敛臣子攻之。\n公卿大夫民贼，贤良文学汝师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫赴铜铅场六言七首 其一","author":"刘克庄","text":"文度何须膝上，阿奴姑可目前。\n载驰载驱王事，一喜一惧父年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫赴铜铅场六言七首 其四","author":"刘克庄","text":"旦市有攫金者，地灵岂爱宝哉。\n零陵贪而乳尽，合浦清而蚌回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫赴铜铅场六言七首 其三","author":"刘克庄","text":"山程行店绝少，官舍去家匪遥。\n吾闻粉□□□，□□红巾已枭。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫赴铜铅场六言七首 其五","author":"刘克庄","text":"世禄鲜由礼法，家驹勿使荒嬉。\n但愿儿读十纸，孰云孙隔一皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明甫赴铜铅场六言七首 其六","author":"刘克庄","text":"化蝶但贪睡美，舐犊尚为爱牵。\n三年不见心痗，十日无书眼穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其十","author":"刘克庄","text":"或问汉庭名卿，仅数洛阳耆英。\n汝见诸公执贽，各为老子寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其九","author":"刘克庄","text":"得百里地虽小，作三年计勿忙。\n但愿彼禾稼熟，莫愁汝松菊荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其八","author":"刘克庄","text":"村叟昔尝为宰，溪民今未忘吾。\n汝父德薄勿效，前有子野易□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其七","author":"刘克庄","text":"彼民若不骇舆，乃翁可就安车。\n击鲜之力不足，啜菽之欢有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其五","author":"刘克庄","text":"脑上笔不会插，心头肉其忍剜。\n乍可侬无花判，莫教渠有租瘢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其四","author":"刘克庄","text":"巽以行权亦可，方于事上未然。\n或迎使者负弩，或为刺史挽船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴惠安六言十首 其三","author":"刘克庄","text":"古云若保赤子，亦曰如烹小鲜。\n雉驯万物遂性，犬吠一村废眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]