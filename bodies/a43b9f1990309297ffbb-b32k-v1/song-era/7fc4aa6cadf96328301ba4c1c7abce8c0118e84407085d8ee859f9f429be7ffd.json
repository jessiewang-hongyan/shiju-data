[{"title":"示小师法照","author":"释怀深","text":"庵小不能容汝住，湖边相送颇依依。\n身心欲得长坚固，记取重围吃菜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"法逸云尝记堕城时番人追逐时回观平江变为瓦砾时只此便是息心处也师云何止息心","author":"释怀深","text":"三处莫忘真是药，两针不蓄亦无妨。\n浑身劫得燖鸡尽，始好参禅作歇场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻平江焚爇","author":"释怀深","text":"阿呵呵了阿呵呵，聚落都如蝼蚁窠。\n一弄火销无影迹，几人于此悟南柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦强求偈","author":"释怀深","text":"老僧住世非长久，之子春秋正盛年。\n生铁脊梁须竖起，莫于女井苦留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示师勤","author":"释怀深","text":"出家毕竟事如何，超越情尘敌死魔。\n莫向丛森贪饱暖，百年光境等闲过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示小师行脚","author":"释怀深","text":"古人只蓄两枚针，夏葛冬裘逐旋寻。\n汝辈盛年脚力健，好携复子历丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其一","author":"释怀深","text":"世谛纷纷没了期，空门得入是便宜。\n直须日夜常精进，莫只劳劳空过时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其二","author":"释怀深","text":"心猿易纵安教纵，意马难调亦要调。\n到老情尘扫不尽，出家四事恐难消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其三","author":"释怀深","text":"焚香礼拜莫匆匆，目睹心存对圣容。\n忏悔多生尘垢罪，愿承法水洗心胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其四","author":"释怀深","text":"出家言行要相应，战战长如履薄冰。\n虽是未除须与发，直教去就便如僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其五","author":"释怀深","text":"也要学书也念经，出家心地要分明。\n他年圆顶方袍日，事事临时总现成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其六","author":"释怀深","text":"出家不断荤和酒，枉在伽蓝地上行。\n到老心田如未净，菩提种草亦难生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其七","author":"释怀深","text":"莫说他人短与长，说来说去自招殃。\n若能闭口深藏舌，便是修身第一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其八","author":"释怀深","text":"常住分毫不可偷，日生万倍恐难酬。\n猪头驴脚分明见，佛地今生扫未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其九","author":"释怀深","text":"莫学愚人说脱空，脱空说得有时穷。\n暗中莫道无人见，只恐难瞒马相公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十","author":"释怀深","text":"一等出家为弟子，事师如事在堂亲。\n添香换水宜勤谨，自有诸天鉴照人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十一","author":"释怀深","text":"香积厨中好用心，五湖龙象在丛林。\n瞻星望月虽辛苦，须信因深果亦深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十二","author":"释怀深","text":"二时普请宜先到，众手能为事不差。\n讽取如来经一卷，都胜闲话口吧吧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十三","author":"释怀深","text":"廊下逢僧深问讯，门前遇客要相呼。\n出家使态宜谦让，莫似愚人礼数无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十四","author":"释怀深","text":"家事积粗宜爱惜，使时直似眼睛看。\n莫将恣意胡抛掷，用者须知成者难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十五","author":"释怀深","text":"诸寮供过要精勤，扫地装香莫厌频。\n事众若能常谨切，身心方是出家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十六","author":"释怀深","text":"衣衫鞋袜须齐整，挂搭巾单不可无。\n身四威仪常具足，莫随愚辈学粗疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十七","author":"释怀深","text":"拳手相交不可为，粗豪非是出家儿。\n遭人唾面须揩却，到底饶人不是痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十八","author":"释怀深","text":"三通浴鼓入堂时，触净须分上下衣。\n语笑高声皆不可，莫将粗行破威仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其十九","author":"释怀深","text":"有时缘干到街头，照顾沩山水牯牛。\n门外草深常管带，等闲失却便难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福训童行颂 其二十","author":"释怀深","text":"色身康健莫贪眠，作务辛勤要向前。\n不见确坊卢行者，祖堂衣钵是渠传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蔡相面壁轩 其一","author":"释怀深","text":"见便道下见，碧眼明寸电。\n瞥尔落思惟，何啻千山远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蔡相面壁轩 其二","author":"释怀深","text":"壁亦何须面，禅床今拽转。\n翻笑钝胡僧，更不作一喘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蔡相面壁轩 其三","author":"释怀深","text":"个事本来如，风光满帝都。\n酒楼春洞晓，尽现大毗卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蔡相面壁轩 其四","author":"释怀深","text":"处处是方便，此理几人荐。\n不识雪峰球，错认盐官扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孙大夫求偈","author":"释怀深","text":"论政已肩裴相国，谈禅应笑老维摩。\n道存休恨归来晚，一语投机已是多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再住慧林和高观察韵","author":"释怀深","text":"归来饱睡懒谈真，一任禅和喜作瞋。\n笑破野堂居士口，孤云去住也由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答葛待制 其一","author":"释怀深","text":"与君同鞭洞庭山，此个因缘非等闲。\n好记灯前一句子，莫教流落向人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答葛待制 其二","author":"释怀深","text":"终朝圆觉不曾迷，底事劳生强是非。\n一扫浮云纤芥尽，个中心月自光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题孙主簿真庆阁","author":"释怀深","text":"黄卷展开共佛语，青山长对伴僧禅。\n一炉香尽文时过，浮世何人有此缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章学士避地毛公山号隐泉居士因相约作庐山饭携偈赴之","author":"释怀深","text":"杖藜来赴庐由饭，喜见公家园有蔬。\n安得龙眠老居士，丹青重画隐泉图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊王观察 其一","author":"释怀深","text":"去年公到包山寺，林底相逢笑不休。\n今日我来公已去，石羊石虎替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊王观察 其二","author":"释怀深","text":"临终一得老僧言，扫尽胸中事万千。\n回首荣华都似梦，便能谈笑死生前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢王七舍人施手写华严经并大藏等经及弥陀像 其一","author":"释怀深","text":"大千经卷毫端出，铁划银钩字字清。\n更会当头这一点，六尘堆上放光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢王七舍人施手写华严经并大藏等经及弥陀像 其二","author":"释怀深","text":"大法流通千有春，西山犹未识金文。\n琅函玉轴照岩谷，想见龙神亦喜欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢王七舍人施手写华严经并大藏等经及弥陀像 其三","author":"释怀深","text":"每日睹佛殊胜相，还如溪上见公时。\n堂堂风貌无凡圣，只要当人路不迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"结茅包山寄孙彦孚主簿","author":"释怀深","text":"老矣休休卜养闲，囊空赊得洞庭山。\n朝中谁送米三合，风雨自存茅一间。\n清啸有云披月岭，高眠无客打柴关。\n此情试为知音说，应隔沧浪冷破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与俗兄相见","author":"释怀深","text":"兄弟情深夙有由，死生岐路各须修。\n要知五欲坑中崄，万顷风涛一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"殷员外为包山铸钟毕求偈","author":"释怀深","text":"包山一火铸钟成，百草头边总是声。\n唤起劳生一睡眼，一时于此得惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李都事求偈","author":"释怀深","text":"棒头笔下宜精审，打锁敲枷好用心。\n成佛作祖只这是，劝君不用别追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孙保义求偈","author":"释怀深","text":"省缘知足常安乐，广费多求损道情。\n闹市门头祖师意，放教心地坦然平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴保义求偈","author":"释怀深","text":"前日相逢欣款曲，见君胸次坦然平。\n祖师有个入门句，只要时中事事轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王员外求偈","author":"释怀深","text":"劝君不用广贪求，随分家缘了便休。\n百岁光阴能几日，得回头处早回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金大翁求偈","author":"释怀深","text":"礼拜烧香新活计，行船种橘旧家风。\n欲知自己弥陀佛，便是亢山金大翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许善友求偈","author":"释怀深","text":"二十亩田供伏腊，无妻无妾自由身。\n回观万顷良田者，也是人间多事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"善友诵金刚经求偈","author":"释怀深","text":"背诵金刚四十年，老来心地转精专。\n劝渠不用忧生死，只此修行便是禅。\n便是禅，不须参，一句该通五百函。\n无我无人无寿者，尘尘刹刹笑瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因读法华经至火宅喻不觉一笑因书偈示孙主簿","author":"释怀深","text":"梦里分明有火殃，觉来心地本清凉。\n三车亦为儿童设，想见瞿昙别有方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答高道人二首 其一","author":"释怀深","text":"人身正类砂盆破，三篾束缚全暂时。\n暑往寒来宜爱惜，莫教土上更加泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答高道人二首 其二","author":"释怀深","text":"砂盆打破化为尘，始是撑天拄地人。\n举世只言身是幻，不知谁是幻中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸道友以法爱故常至包山以偈却之","author":"释怀深","text":"老僧多病厌将迎，且卜西山隐姓名。\n若是吾家真道友，隔湖相见最分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真州檀越求偈","author":"释怀深","text":"了即业障本来空，心如聚蚁意如风。\n未了应须还宿债，破后还将茅草盖。\n灯笼露柱笑呵呵，好是焦山口更多。\n奉报扬子江头水，等闲无事莫与波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福改神霄道友挽留不得师去以偈却绝","author":"释怀深","text":"人生聚散本无常，休把闲愁脑肚肠。\n三十年后重相见，拍手呵呵笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其一","author":"释怀深","text":"时光迅速急如流，一别慈颜几换秋。\n坟墓乡关空杳杳，死生岐路两悠悠。\n充饥乳哺恩难报，寄体怀担力莫酬。\n想像音容无觅处，春风特地使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二","author":"释怀深","text":"涅槃生死两般名，正眼观来一性灵。\n五蕴山头云散后，大千沙界月长明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三","author":"释怀深","text":"三月安居要护生，蛾蛘蚁子乱纵横。\n衲僧自有转身路，不向时人行处行。\n三条椽下清风远，六尺单前白昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四","author":"释怀深","text":"芭蕉闻雷开，还有耳么。\n葵花随日转，还有眼么。\n社桑知天风，还有心么。\n海水知天寒，还有意么。\n无情之物，尚自知时。\n多少衲僧，一向瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其五","author":"释怀深","text":"资福为人处，从来无异路。\n饭饱譬如闲，共般数担土。\n你行我亦行，你住我亦住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其六","author":"释怀深","text":"咄哉异类身，轮转无休息。\n戴角复被毛，觳觫偿人力。\n我观佛与牛，其性本来一。\n良由昧此心，所以异形质。\n想汝为人时，岂信有今日。\n侵欺常住钱，互用招提物。\n是非信口谈，酒肉恣情食。\n五戒既不持，人身安可得。\n今日堕牛身，方知无利益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其七","author":"释怀深","text":"才见仲冬初，不觉又月半。\n光景急如梭，人情忙似钻。\n白发鬓边添，朱颜暗里换。\n名利竞头争，好事无人看。\n腊月三十日，饶你是铁汉。\n觉花有种无人种，心火无烟逐日烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其八","author":"释怀深","text":"禅门泊将气如云，江北江南把要津。\n莫怪林众闲未待，扫除佛祖要当人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其九","author":"释怀深","text":"欲铸红炉百炼金，先烦广结众人心。\n刀山剑树长年苦，好为劳生发妙音。\n佛手遮不得，人心自等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十","author":"释怀深","text":"昔时说有千般，今日看无一种。\n等闲拈转虚空，始得平生受用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十一","author":"释怀深","text":"焦山旧日时，堂安百馀众。\n笊篱与木杓，如今不足用。\n多谢诸禅人，各出一只手。\n南北与西东，面南看北斗。\n厨中一个锅，煮粥又不多。\n若非宪上座，谁人奈尔何。\n水陆会街坊，六人为总领。\n但看正二月，夜夜香花请。\n二人同一心，打围要种菜。\n意在钁头边，两彩都一赛。\n腊月冷如冰，众僧犹卧簟。\n二人去化席，姑苏也不远。\n漆桶要打破，深禅却要光。\n但教无渗漏，得个也无妨。\n镇州萝卜头，今年到处少。\n奇公去打钱，典座呵呵笑。\n法真小比丘，去觅沩山牛。\n绳头须紧把，鼻孔要牢收。\n迹在牛还在，无心终易求。\n要得十分好，更造一层楼。\n更有一件事，不小亦不大。\n擘也擘不开，跣也跣下过。\n常在动用中，未有人担荷。\n你若肯发心，我为你说破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十二","author":"释怀深","text":"腊月二十五，拄杖二十五。\n灯笼二十五，拂子二十五。\n普请栽菜上堂，焦别无见解，且学古人栽菜。\n若还总不生根，也是诸人有彩。\n无端跂死禅和，只要硬守疆界。\n忽然筑著磕著，便见草贼大败。\n大凡履践此事，须要自由自在。\n从教土面灰头，不怕风吹日晒。\n老来意在钁头漫，家风自有通人爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十三","author":"释怀深","text":"莫谓无心便是禅，个中有路更幽玄。\n系驴橛子推翻后，打著南边动北边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十四","author":"释怀深","text":"一切法不生，一切法不灭。\n若能如是解，诸佛常现前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十五","author":"释怀深","text":"不风流处也风流，匹马追风四百州。\n金镞离弦胸百战，铁鞭多力恨无雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十六","author":"释怀深","text":"本地风光何似生，谁明日午打三更。\n直饶金印大如斗，争踏毗卢顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]