[{"title":"秋感","author":"释文珦","text":"客中难度日，池上独徘徊。\n露冷芙蕖死，天高鸿雁来。\n枯茎宁再润，群叫易成哀。\n对此能无感，吾亲在夜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种植","author":"释文珦","text":"种植有良法，曾闻老圃辞。\n灵苗如已茂，恶草自然萎。\n根本须培养，生枯勿顾思。\n修身亦如此，于理足堪推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡逸人幽居","author":"释文珦","text":"幽居清绝甚，四面尽沧波。\n柳步春船集，花源晚吹和。\n宦情垂钓薄，吟思捲帘多。\n便有书来辟，其如爱此何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荒径 其一","author":"释文珦","text":"荒径入林微，蓬庐客到稀。\n苔痕侵药裹，山色冷吟衣。\n蚯蚓耕泥起，蜻蜓点水飞。\n坐来忘万事，静看宿云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追送奎上人还鄞","author":"释文珦","text":"随缘游上国，兴尽即言行。\n今日不辞我，他宵还梦兄。\n出山云满橐，归路水兼程。\n无奈汀洲畔，春风草又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人","author":"释文珦","text":"送子西风里，令予起别愁。\n何时通远信，逾月在孤舟。\n野果经霜实，潮田带露收。\n明朝于此地，独自倚高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人之蜀","author":"释文珦","text":"佳友相辞去，西游卒未还。\n单车行数月，万水与千山。\n雨雪年华晚，烟尘道路艰。\n莫教音信绝，添我鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人归金华","author":"释文珦","text":"此去金华水作程，扁舟定是过严陵。\n高山蔽日寒多雾，浅濑通潮夜不冰。\n汉代丝风应自咏，故乡三洞与谁登。\n拟从别后题书寄，又怕征鸿未可冯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送友","author":"释文珦","text":"山临东郭暮，路转北原斜。\n此地轻为别，孤蓬不恋家。\n客程何地尽，离思满天涯。\n明日重阳至，同谁对菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送友人住海寺","author":"释文珦","text":"海上莲花国，初从太守招。\n衣传方石偈，舟泊丈亭潮。\n渔子应焚簄，鲛人拟献绡。\n他时思旧社，无奈寄书遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王商公游永嘉兼呈东圳曹侍郎荆山刘学士","author":"释文珦","text":"觅句东嘉去，春风草又薰。\n一千馀里路，四十九盘云。\n幸有江山助，休为旅泊分。\n曹刘诸老在，为我致殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王逸人","author":"释文珦","text":"閒身如野鹤，天地一虚巢。\n山水琴中趣，松筠世外交。\n怀亲逢远信，开卦卜归爻。\n更说云门好，相期共结茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送北征人","author":"释文珦","text":"与君俱是客，那复送君行。\n未卜重逢日，难为欲别情。\n露花皆远泪，风叶是愁声。\n到日寒应极，脩途七十程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送立上人偕沈东皋谒吴退庵","author":"释文珦","text":"阖闾城里去，瘦沈是同舟。\n不用悲游鹿，唯须问狎鸥。\n夕阳空茂苑，残雪遍长洲。\n太守相逢日，言诗定点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送兵部兄出守高安","author":"释文珦","text":"君是甲科人，文章已立身。\n远邦迎父母，天阙动星辰。\n行爱三冬日，到为千里春。\n如将致吾后，先要惜斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杞上人归于潜山","author":"释文珦","text":"同乡唯子在，欲别意何如。\n归路青苔远，还家白露初。\n山光围古邑，溪影渡寒鱼。\n须为过星渚，高风似二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨菊屋","author":"释文珦","text":"菊屋何为者，耽吟呕肺肝。\n短衣空自咏，长铗向谁弹。\n不计为儒误，唯言得句难。\n几人怜此别，把酒不成欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送远","author":"释文珦","text":"离情不可说，握手更踌躇。\n为客三秋尽，还家千里馀。\n山程枫叶赤，水驿柳条疏。\n日夕空林下，何人伴索居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送春","author":"释文珦","text":"老人无复趁春场，见说春归亦送将。\n唯恐再来吾不见，偏于此别意难忘。\n花枝卧雨红颜尽，草蔓梳风绿发长。\n作计欲留留不住，聊歌一曲当离觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵一严守永嘉","author":"释文珦","text":"九重思共理，符竹付更生。\n卿月辉麟谱，文星次鹿城。\n精微敷易教，信厚播诗声。\n好使中川水，长流不尽清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵东阁罢官归永嘉","author":"释文珦","text":"一年吟抱寄京华，几度相逢说永嘉。\n梦入西山寻枸杞，约归东阁看梅花。\n风霜摧拉知何事，雨露生成自有涯。\n应笑屈平终不返，空留遗恨在长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵寒泉重宰南中邑","author":"释文珦","text":"字民无异术，薄敛与宽刑。\n宓子琴犹在，蔿于歌重听。\n瘴云消昼黑，毒草变春青。\n万里南中路，秋风几驿亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送通嗣法书僧归隆兴","author":"释文珦","text":"一千馀里路，知为尔师行。\n晚峤踏云影，春江闻浪声。\n相逢知有约，又别似无情。\n莫话传衣事，北宗人恐争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送敬从可上人","author":"释文珦","text":"爱君心似我，十载共随缘。\n离别从兹始，音书何处传。\n岭云迷晚寺，江水入春田。\n遥忆归栖后，松门独夜禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送雅上人自鄞归杭","author":"释文珦","text":"之子幡然别，何人伴寂寥。\n相从非世道，独去是寒朝。\n目送孤帆远，魂随晓浪消。\n重来须定约，莫待隔江招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鉴上人还故山","author":"释文珦","text":"偶随流水出，不碍滞人间。\n道树多年别，空门此日还。\n瀑飞春涧净，云度晓窗閒。\n后会应难定，相思桂满山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧","author":"释文珦","text":"空山草木秋，相送古原头。\n倦客难为别，寒蛩替说愁。\n旧房深翠壁，归路隔沧洲。\n后夜多明月，相思为上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧之华亭","author":"释文珦","text":"忽尔来相别，携琴便出关。\n此行离日下，何事到云间。\n郭外遥通海，舟前少见山。\n应思旧栖处，樵屋过秋閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧之湖南","author":"释文珦","text":"交游星散尽，之子复南行。\n惜别悲杨柳，相思寄杜蘅。\n好山须驻锡，恶路莫贪程。\n近得湘中信，湘中寇未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归日本","author":"释文珦","text":"远人仍远别，把手话江皋。\n积水三韩路，西风八月涛。\n海门山似粒，洋屿树如毛。\n他日难通信，想思梦寐劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧行古归越","author":"释文珦","text":"孤云无定迹，兴至即难留。\n独往经秦望，相期隐沃洲。\n雪晴分去路，风急阻行舟。\n旧住如相问，惟烦话旅游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送襄锦二上人之鄞","author":"释文珦","text":"春风湖上别，携手欲何之。\n细问重来日，那曾有定期。\n舟行江路永，锡挂海峰迟。\n若有东南使，相逢即寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游天台华顶峰 其二","author":"释文珦","text":"天台三万丈，华顶入穹苍。\n片石群魔慑，千年古寺荒。\n树枯赪菌出，僧老白眉长。\n极目沧溟际，烟波更渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻似道入相因赋诗","author":"释文珦","text":"盛德方为贵，虚名底用高。\n异时游荡子，今日儗萧曹。\n红粉催身朽，清霜入鬓牢。\n势穷人事改，槐棘等蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闽中岁暮怀吴中","author":"释文珦","text":"冉冉年光尽，悽悽客思惊。\n疏狂轻万事，行役负平生。\n海月移松影，山风壮瀑声。\n寒宵频作梦，曾不离吴城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除狭","author":"释文珦","text":"世狭难纡辔，全生托散财。\n纷华因地遣，怀抱向山开。\n野祭鸦争聚，贫居燕亦来。\n不知江上笛，何事有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食苦笋","author":"释文珦","text":"老去居山乐最真，盘蔬日日富前陈。\n爱尝苦笋疏甜笋，似进忠臣远佞臣。\n饭为韵清常倍食，酒因味爽或添巡。\n美芹之意全相似，颇谓堪将献紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乘兴","author":"释文珦","text":"乘兴不拘程，悠悠任意行。\n小溪横木渡，何寺远钟声。\n野菜抽心起，山花照眼明。\n幽禽亦堪爱，多解自呼名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"候禽","author":"释文珦","text":"候禽来报我，春已到园林。\n冻解通泉脉，风和动草心。\n由来增齿腊，翻是促光阴。\n其可陪人事，衰迟已不任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭何甥","author":"释文珦","text":"秀颖出儒林，吾甥所得深。\n良材竟难用，造物果何心。\n身后无遗育，生前惜寸阴。\n临棺一悲咤，万籁亦同音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭复荆山","author":"释文珦","text":"分讲南山日，人推学问精。\n弥纶八教网，坚实五言城。\n愿力生前重，声华灭后清。\n家山孤塔在，过者敬如生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭恭仲温","author":"释文珦","text":"信敬谦勤德更纯，江湖风谊最相亲。\n曾知九要三玄髓，岂混重泉一窖尘。\n此日伤心亡我友，异时再面是他人。\n山中弟子怀师德，各剪生绡暗写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"息影","author":"释文珦","text":"息影尘埃表，安心静默间。\n若为消白日，长是对青山。\n流水欲穷处，野猿相与还。\n孤云时起灭，未必似余閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅中秋晚","author":"释文珦","text":"秋露洗晴空，秋光处处同。\n枫霞明野树，芦雪覆沙丛。\n旅况悲寒蛩，归心寄断鸿。\n几时随牧竖，吹笛乱山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅况","author":"释文珦","text":"日暮投村馆，悽然逆旅情。\n地荒频有盗，城远不闻更。\n度岁无多日，思乡是几程。\n听鸡还束被，霜月伴晨征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅怀","author":"释文珦","text":"客路何当极，家林久未还。\n只今明镜里，又觉鬓毛斑。\n夜雨添春水，寒云没晓山。\n彊吟无好思，佳句也应悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅夜 其一","author":"释文珦","text":"秋宵似岁长，旅馆更荒凉。\n灯暗鼠出穴，天寒虫近床。\n羁栖弥岁月，老大易悲伤。\n幸有茅庐在，何为别故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅夜 其二","author":"释文珦","text":"离人厌夜长，独起坐空床。\n苦雨迟家信，秋云隔旧乡。\n烛残重作焰，桂湿不生香。\n倘得归期遂，閒居在上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅夜思亲","author":"释文珦","text":"故里多离别，他乡久滞留。\n虫声偏入夜，客梦不禁秋。\n枯叶兼风响，清溪带月流。\n倚门应望切，明日问归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓别故人","author":"释文珦","text":"别日不易数，相逢多故情。\n为吾留一宿，同子话三生。\n月印秋灯白，霜添夜气清。\n晨钟缘底事，还又动离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柴门","author":"释文珦","text":"柴门虽设不曾关，时有忘机客往还。\n风送钓舟来北渚，雨催樵子下西山。\n生前富贵何劳美，身后声名亦是閒。\n万虑消除心自在，从教人道我疏顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐州先师塔","author":"释文珦","text":"耿介绝依凭，清虚尚饮冰。\n悟明中观论，度越小乘僧。\n梦已三生破，神应九品升。\n法门谁得髓，石塔冷孤灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐庐县","author":"释文珦","text":"潇洒桐庐县，名闻汉代馀。\n民风尚耕钓，土物富薪蔬。\n江水连衢港，云山带越墟。\n终期置茅屋，邻近钓台居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟霞石屋诸寺","author":"释文珦","text":"缘山一径微，竹树隐禅扉。\n云绝去来性，僧无生灭机。\n风檐铁自语，阴洞石能飞。\n终拟携瓶锡，他年向此归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱性","author":"释文珦","text":"爱性畏欢呶，云深一径茅。\n了无徒属累，唯结鹿麋交。\n灌木由来古，修篁亦渐苞。\n终然声利表，颇若类由巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真乐 其二","author":"释文珦","text":"岁律又将穷，山房四壁空。\n水云踪不异，松柏性元同。\n睡起蹲鸱熟，香消贝叶终。\n谁知真乐事，却在寂寥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真乐 其一","author":"释文珦","text":"人皆有所乐，此乐独吾真。\n一静灭万虑，空房无点尘。\n雪清梅骨骼，烟养竹精神。\n羁绁徒千丈，难拘散诞身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衰病","author":"释文珦","text":"衰病苦无悰，偃仰以终日。\n少间步东园，愈使我心怵。\n名芳扫迹空，野草争头出。\n无力事耘耛，长吁返蓬室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读伍子胥史事","author":"释文珦","text":"惆怅当年死属镂，到头忠义竟何如。\n眼悬城郭空怀旧，魂寄江涛尚贾馀。\n向使君王从谏诤，未应宫阙便丘墟。\n唯应教得鸱夷子，万里扁舟计不疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调琴","author":"释文珦","text":"群动夜中息，霜清月满林。\n野僧无俗事，幽兴寄瑶琴。\n澹澹思归操，悠悠太古心。\n希声在自得，不必为知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭文举祠","author":"释文珦","text":"封禺山水国，曾是郭文游。\n列岫开新障，平川合众流。\n丹青遗像在，松竹古祠秋。\n虽不逢尧禅，高风似许由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘江潮","author":"释文珦","text":"初闻万马声，渐觉似长城。\n远自三山起，高连两岸平。\n淩风添怒势，映日作虚明。\n若是吴胥魄，如何渡越兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘晚渡","author":"释文珦","text":"残日下重城，寒潮起暮声。\n岸遥江树小，天阔野云平。\n一水分吴越，孤舟寄死生。\n如何未归者，犹此计乡程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偃息","author":"释文珦","text":"偃息冷云边，悠然白已玄。\n动时皆物役，静处是吾天。\n虚牖延萝月，连筒引竹泉。\n心期终不出，就此了馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释文珦","text":"名利双蜗角，堪舆一旅亭。\n生平嫌著物，老去更忘形。\n慢火煎茶熟，寒灯照梦醒。\n室空无道伴，自展八还经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作 其一","author":"释文珦","text":"风露洗空寒，秋清四体安。\n偶扶筇杖出，因采菊花餐。\n老觉心情懒，閒知世界宽。\n寒山诗一卷，随意作经看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿山庵","author":"释文珦","text":"绝顶一庵孤，悠悠清夜徂。\n野僧寒出定，山鬼暗相呼。\n泉落池应满，云深树欲无。\n何年捐万事，来此共跏趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿灵鹫澜师房","author":"释文珦","text":"清泉绕砌流，境界极深幽。\n有客暂投宿，羡君长此留。\n诗成云满涧，人静月当楼。\n忽听清猿啸，南山山树秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿海上正觉寺","author":"释文珦","text":"霜满啼猿石，风回落雁洲。\n半生为远客，此夕欠同流。\n白月无穷意，沧波不尽秋。\n倚阑吟未足，长啸上峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄山中友人 其一","author":"释文珦","text":"闻道幽栖野思饶，径无尘迹草萧萧。\n长松架壑因为屋，老榉横溪便作桥。\n煮石未须閒水碓，漱流何必弃风瓢。\n吾生更爱深居乐，定拟相从不待招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]