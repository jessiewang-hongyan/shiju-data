[{"title":"足子苍和人诗","author":"胡仔","text":"执戟老人双鬓斑，陆沉三世不迁官。\n穷如老鼠穿牛角，拙似鲇鱼上竹竿。\n岂有葡萄博名郡，空馀苜蓿上朝盘。\n荣华气象无丝许，正坐平生骨相寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对月用促句换韵格","author":"胡仔","text":"青玻璃色瑩长空，烂银盘挂屋山东，晚凉徐度一襟风。\n天分风月相管领，对之技痒谁能忍，吟哦自恨诗才窘。\n扫宽露坐发兴新，浮蛆琰琰抛青春，不妨举盏成三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自题水阁绝句","author":"沈括","text":"三间水阁贾耘老，一首佳词沈会宗。\n无限当时好风月，如今总属绩溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"歌风台","author":"胡仔","text":"碑存溪石高嵯峨，汉字漫灭新镌讹，台非旧筑行人过。\n赤帝当年布衣起，老妪悲啼白龙死，芒砀生云凝夜紫。\n一朝花发咸阳春，老剑磨血消京尘，归来故里天上人。\n千古斜阳愁色里，草没荒城狐掉尾，不信英雄化为鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苕溪渔隐图 其二","author":"胡仔","text":"秋云漠漠烟苍苍，芦花初白莲叶黄。\n钓船尽日来往处，南村北村粳稻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 以李长吉美人梳头歌填","author":"胡仔","text":"梦寒绡帐春风晓，檀枕半堆香髻。\n辘轳初转，阑干鸣玉，咿哑惊起。\n眠鸭凝烟，舞鸾翻镜，影开秋水。\n解低鬟试整，牙床对立，香丝乱、云撒地。\n纤手犀梳落处，腻无声、重盘鸦翠。\n兰膏匀渍，冷光欲溜，鸾钗易坠。\n年少偏娇，髻多无力，恼人风味。\n理云裾下阶，含情不语，笑折花枝戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红","author":"胡仔","text":"泛宅浮家，何处好、苕溪清境。\n占云山万叠，烟波千顷。\n茶灶笔床浑不用，雪蓑月笛偏相称。\n争不教、二纪赋归来，甘幽屏。\n红尘事，谁能省。\n青霞志，方高引。\n任家风舴艋，生涯笭箵。\n三尺鲈鱼真好脍，一瓢春酒宜闲饮。\n问此时、怀抱向谁论，惟箕颍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"胡仔","text":"为官两部喧朝梦，在野千机促妇功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"胡仔","text":"钓艇江湖千里梦，客毡风雪十年寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"胡仔","text":"鹦鹉杯且酌清浊，麒麟阁懒画丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"胡仔","text":"愁随竹叶消春盏，喜入灯花缀夜缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"胡仔","text":"白发惟公道，春风不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"胡仔","text":"壮图鹏翼九万里，末路羊肠百八盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"胡仔","text":"话尽春愁双紫燕，唤回午梦一黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"胡仔","text":"霞抹晚空鱼尾赤，水生春渚鸭头青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"胡仔","text":"飞花红千点，芳草绿万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"胡仔","text":"润资宿麦两歧秀，寒勒新花几信风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"胡仔","text":"飞絮落花春向晚，疾风甚雨暮生寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅坛","author":"胡发","text":"忠肝一点炳如月，世事难将道眼看。\n驾取云軿升斗府，惟遗岩壑拱仙坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元行","author":"胡处晦","text":"上元愁云在九重，哀笳落日吹腥风。\n六龙驻跸在草莽，孽胡歌舞蒲萄宫。\n抽钗脱钏到编户，竭泽枯鱼充宝赂。\n圣主忧民民更忧，骄子娇媟天天不怒。\n向来艰难传大宝，父老谈言似仁庙。\n元年二月城下盟，未睹名臣继嘉祐。\n哀痛今年尘再蒙，冠剑夹道趋辞公。\n神龙今在九渊卧，安得屡困蛟蛇中。\n朝廷中兴无柱石，薄物细故昭帝力。\n毛遂不得处囊中，远惭赵氏厮养卒。\n今日君王归不得，倾城回首歌悲啼。\n会有山呼间动地，万家香雾烧天衣。\n胡儿胡儿莫耽乐，君不见夕月常亏东北角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金精山","author":"胡平仲","text":"人去坛空几历年，尘埃难没汉山川。\n窦门深入壶中地，环壁遥开瓮外天。\n致雨土龙如解化，随时木鹤亦能仙。\n要知万劫长生处，古篆惟存石鼓篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"胡平仲","text":"兰凋蕙歇。\n野店酒初尝竹叶。\n绝艳幽姿。\n洗出铅华见雪肌。\n云阶月地。\n凭仗幽人须着意。\n一夜花飞。\n一点微酸已著枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一 咏梅","author":"胡平仲","text":"天然标格。\n不问青枝和绿叶。\n彷佛吴姬。\n酒晕无端上玉肌。\n怕愁贪睡。\n谁会伤春无限意。\n乞与徐熙。\n画出横斜竹外枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 寿段知事。时方旱，祈雨大作","author":"胡幼黄","text":"有喜君初度，风雨作秋声。\n连旬烈日，稻畦麦垄欲扬尘。\n好似天瓢在手，笑把群龙呵叱，四野注如倾。\n勃勃生意满，翠浪涌纵横。\n君知否，仁者寿，寿斯仁。\n自从三代而下，民命寄苍旻。\n满目桑麻谷粟，满目簿书期会，试说与仁人。\n小试作霖手，苏醒永新民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"胡旦","text":"明年春色里，领取一行归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏红蕉","author":"胡用庄","text":"谢家池馆遇芳菲，破绿抽心一片绯。\n恰似九衢三二月，绿罗丛里著朱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日雨","author":"胡仲弓","text":"避灾野老寻蓑笠，送酒人来白衣湿。\n龙山路滑少人登，篱下菊花含泪泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十五夜雪","author":"胡仲弓","text":"听得窗前雪打声，起来眼界甚分明。\n从前浪说丰年瑞，三白如今始作成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与枯崖悟师","author":"胡仲弓","text":"振锡归来又许时，苔痕犹污坐禅衣。\n是非不定空怀古，惭愧高人蚤见几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨","author":"胡仲弓","text":"桑田万顷变沧海，四海茫茫不见津。\n天漏祗今无补处，不知谁是作霖人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"义溪舟中","author":"胡仲弓","text":"梦里不知身是客，却疑身是老坡仙。\n羽衣道士飞将去，月在波心人在船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中有花一种俗名花叶不相见感而赋之","author":"胡仲弓","text":"世间雁燕本无情，天上参商谁会面。\n花叶自是同根生，何事开时不相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中逢老人","author":"胡仲弓","text":"头白不知今几龄，儿时犹及见升平。\n可怜野老无知识，却认钱塘是汴京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行逢樵者","author":"胡仲弓","text":"鹤发童颜歌负薪，衣襟不染一凡尘。\n担头几点桃花片，恐是当年避世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞来峰","author":"胡仲弓","text":"山染西湖水漾青，孤高长对冷泉亭。\n飞来何不飞将去，空与山僧作画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不如归去","author":"胡仲弓","text":"禽言自是不分明，谁信西川帝子灵。\n千古传讹无订正，至今春晚误人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹青阁","author":"胡仲弓","text":"紫芝峰上一凭栏，烟草茫茫天地宽。\n眼界已随流水去，丹青无复旧时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌衣巷","author":"胡仲弓","text":"飞云当日未停骖，巷在秦淮水以南。\n可笑异闻唐小说，馀风犹袭晋清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云根","author":"胡仲弓","text":"出岫无心直等闲，却于天运颇相关。\n五云飞绕黄金阙，留得云根在越山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日 其二","author":"胡仲弓","text":"绿蜡红纱满路新，翠眉蝉鬓往来人。\n榕阴门户香如雾，十二天街无此春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日 其一","author":"胡仲弓","text":"大书春帖当桃符，吟对窗前梅一株。\n湖海相逢无老少，莫分先后饮屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元宵","author":"胡仲弓","text":"缓辔归来看夜城，千门灯火照街明。\n自疑不是乘槎客，却傍银河星斗行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元宵雪","author":"胡仲弓","text":"灯火楼台白玉铺，这般祥瑞不如无。\n谁能断取维摩手，画出元宵踏雪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"胡仲弓","text":"台上梧桐失旧栽，荒丘寂寂掩蒿莱。\n凤凰一去不复返，引得鸱鸮向此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天竺呼猿","author":"胡仲弓","text":"眠云啸月走枯藤，不是园丁叫不应。\n自恋香林不归去，前生恐是住山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太真卧病图","author":"胡仲弓","text":"鬓蝉彫落柳眉颦，惭愧三郎不见嗔。\n一病早知尸解去，定无罗袜堕边尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月临关","author":"胡仲弓","text":"长笛一声天地寒，不堪回首月临关。\n山河不二无全影，莫说前头桂可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水乐洞","author":"胡仲弓","text":"娲皇昔日奏钧天，一派清音知几年。\n寄语山灵好收拾，不须留与世人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世路","author":"胡仲弓","text":"春山寂寂锁云萝，林外钩辀声最多。\n不是哥哥行不得，祇愁世路有风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古意","author":"胡仲弓","text":"流水滔滔去不回，好花能得几时开。\n丁宁莫剪门前竹，留两三竿待凤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题 其二","author":"胡仲弓","text":"年来古道不堪行，尽避君厨俊杰名。\n莫枉锥刀鞭算手，且调金石击撞声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题 其一","author":"胡仲弓","text":"抱琴终日坐槐庭，万绿阴中一掬清。\n天地山河俱荫芘，肯将风浪向人生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题","author":"胡仲弓","text":"一别家山不计程，断人肠处若为情。\n客床欲结鸳鸯梦，夜夜相思睡不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题 其三","author":"胡仲弓","text":"谪居姜相庸奚损，贫杀元英直是清。\n风月分来无著处，摩挲海眼看长鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉泉观鱼","author":"胡仲弓","text":"一潭秋水净无尘，付与群鱼乐性真。\n镇日倚栏看未足，岂知沧海有修鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用乌山韵题碧吟卷","author":"胡仲弓","text":"湖海元龙气，因吟恐负身。\n世间无谒客，天下有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵送驴与源谷","author":"胡仲弓","text":"长耳追风走似流，黔人空使载驴舟。\n巾箱欲置无容处，来与骚人款段游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵答宝叶","author":"胡仲弓","text":"蒲团出定入玄微，尽是山间林下诗。\n安得远公陪一笑，朗吟同过虎溪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"众芳所","author":"胡仲弓","text":"接䍦倒著醉花傍，染得衣巾一味芳。\n说与园丁严锁钥，免教韩寿去偷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘项祠","author":"胡仲弓","text":"二祠相望几春秋，祀了龙颜祀沐猴。\n章戴溪南梨岭北，不知何处是鸿沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行","author":"胡仲弓","text":"曙色微分星渐稀，迎人犬吠出疏篱。\n轻车稳坐谁知我，不是坡翁戴笠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴","author":"胡仲弓","text":"苏堤拍拍水平湖，谁信田间苗欲枯。\n路上行人方苦热，山中七月已围炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次芸居无题韵","author":"胡仲弓","text":"身似浮云不定栖，倚栏觅句听鸦啼。\n洛阳纸价新来贵，吟得诗成就壁题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次卓仁夫元宵雪中三绝 其一","author":"胡仲弓","text":"姑射神人雉扇开，三千玉女拥瑶台。\n十分散布犹嫌少，万斛明珠抖下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次卓仁夫元宵雪中三绝 其三","author":"胡仲弓","text":"绣帘直下整云鬟，歌舞丛中强自欢。\n兴尽归来太多事，不如高卧学袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次卓仁夫元宵雪中三绝 其二","author":"胡仲弓","text":"风急梅花片片飞，游人星散市声稀。\n翻思往日西楼约，不至天明不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次松坡梅花韵","author":"胡仲弓","text":"满树苔痕带老苍，水边篱落月昏黄。\n丁宁僮子休教折，只听枝头独自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次枯崖问病韵","author":"胡仲弓","text":"病馀已觉二毛侵，湖海诗盟亦懒寻。\n无奈壮怀生万感，黄昏枕上听蛩吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次适安感古二首 其二","author":"胡仲弓","text":"二南风化盛行时，里咏涂歌总是诗。\n采到春秋无可采，获麟以后更堪悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次适安感古二首 其一","author":"胡仲弓","text":"少陵合与古诗班，不是诗家持论宽。\n风雅近来随世变，诗无可采不须官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄瑞玉石镜韵","author":"胡仲弓","text":"凿出巉岩似镜形，年深剥尽藓痕青。\n世间更有磨塼者，欲借钳锤与五丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵早梅","author":"胡仲弓","text":"枝头未受雪霜催，偏傍江南暖处开。\n不是东君私造物，有何凭据作花魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵顺适遣寄","author":"胡仲弓","text":"拟折芳馨遗所思，要将心事共谋惟。\n暮云遮断松江路，重读夫君别后诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵烹笋一绝","author":"胡仲弓","text":"锦绷才脱见龙孙，便好西园倒玉尊。\n满肚岁寒无著处，此情难与俗人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江郎山 其一","author":"胡仲弓","text":"巫山有石称神女，何事江山亦号郎。\n岂是世情强分别，从来造化有阴阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江郎山 其二","author":"胡仲弓","text":"观尽千山与万山，几曾得似此峰峦。\n谁能移向西湖上，并与西湖一样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汲清","author":"胡仲弓","text":"欲波如浊流，心源如古井。\n不患无清泉，祇恶无修绠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]