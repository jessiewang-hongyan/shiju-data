宋"}},{"title":"和李端叔大夫从参寥子游许昌西湖十绝 其二","author":"李廌","text":"草已芊绵柳已柔，落花重叠不须愁。\n风光流转等閒过，又是一年春事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李端叔大夫从参寥子游许昌西湖十绝 其十","author":"李廌","text":"池南池北乱蛙声，不问官私处处鸣。\n昨夜一犁新雨足，无烦科斗更滋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李端叔大夫从参寥子游许昌西湖十绝 其一","author":"李廌","text":"几处鞦韆愁日暮，一声鶗鴂唤春归。\n红稀绿尽寻常事，不用长绳系落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李端叔大夫从参寥子游许昌西湖十绝 其四","author":"李廌","text":"西畴新买数塍田，便扫空囷俟有年。\n欲坐瓜庵吹豆叶，风翻黄浪麦秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李端叔大夫从参寥子游许昌西湖十绝 其六","author":"李廌","text":"痴儿插地栽杨柳，杨柳无根插便生。\n我亦无根常作客，四年漂泊大梁城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈恬思其叔子思有书斋在山中二首 其二","author":"李廌","text":"嗟我衰迟行老矣，与君生死尚情深。\n屈平贾谊何须旧，敬吊先生泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈恬思其叔子思有书斋在山中二首 其一","author":"李廌","text":"古寺愔愔映夕岑，谷风凄劲触霜林。\n曩时蕙帐知何处，不见山人来苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"李廌","text":"且喜屋无穿隙雪，未愁漏尽满靴霜。\n纸帏布被从牢落，赖有希牙齿颊香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其二","author":"李廌","text":"山东太白谪仙人，笔捲天河气拂云。\n百代公卿嘲哂遍，清溪石上想严君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其三","author":"李廌","text":"兴王不患无功业，贼乱常忧在岁寒。\n能缓阿瞒移鼎手，长鋋此日愧渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其一","author":"李廌","text":"竹冈深贮一溪云，溪湾路尽钓矶新。\n鱼鸟相忘自相乐，使君元是狎鸥人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至酂城和德麟韵","author":"李廌","text":"绿胜章台杨柳街，青罗斗帐净无埃。\n五株何用诗频说，安得韩公到此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其九","author":"李廌","text":"逃閒闭关坐，忽有卖花声。\n老大自多感，依然京洛情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其八","author":"李廌","text":"娇马宁馨郎，毡车薄媚娘。\n萧萧两蓬鬓，愁入少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其七","author":"李廌","text":"怅望白铜鞮，醉听金缕衣。\n花间愁落日，老更惜春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其六","author":"李廌","text":"化国有馀暇，丰年多醉人。\n典衣谋一饮，对酒却惭春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其五","author":"李廌","text":"但喜朝朝醉，那知夜夜风。\n老人贪睡美，春梦五更中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其四","author":"李廌","text":"毛桃犹带蕊，青杏已团枝。\n老不禁春恼，应知老易欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其三","author":"李廌","text":"怒风吹老屋，急雨闹空庭。\n莫叹林花尽，悬知陇麦青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其二","author":"李廌","text":"新绿阴将就，残红在亦稀。\n雨中千点絮，来伴落花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事九首 其一","author":"李廌","text":"蔼蔼花絮乱，纷纷蜂蝶多。\n今年春复尔，不饮奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日偶题寄友人","author":"李廌","text":"低云不断风仍急，细雨无声晚更稠。\n千里思君常在眼，黄昏天意自春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其八","author":"李廌","text":"粤藤玉板泽于脂，歙婺隃糜理胜犀。\n归日锦囊诗几许，七闽当有数千题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其七","author":"李廌","text":"瓯闽接壤气多同，只恐泉南有飓风。\n撅虹见时定翻海，禦寒裘褐要重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其六","author":"李廌","text":"泉南南浦是南溟，瘴雾熏人不用醒。\n想对文书搔首罢，刺桐花下学兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其五","author":"李廌","text":"梅雨晴时荔子丹，绛囊青幄共檀栾。\n按图读谱尝珍品，大胜关西苜蓿盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其四","author":"李廌","text":"解知身世两鸿毛，肯羡一钩连六鳌。\n有口惟宜醉醇酒，时时痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其三","author":"李廌","text":"看罢吴山看越山，一帆千里玩风澜。\n令人颇忆羊裘老，为钓桐庐七里滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其二","author":"李廌","text":"君房言语妙知名，元凯春秋癖已成。\n作者风流公莫让，要令江海听文鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元勋不伐侍亲之官泉南八首 其一","author":"李廌","text":"卷中识尽古来人，笔下文章日日新。\n万里从亲海边县，要令南国见麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其七","author":"李廌","text":"千里隋堤榆柳风，轻花薄荚正冥濛。\n离情解逐仙舟去，欲过三江震泽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其六","author":"李廌","text":"横江一苇听潮来，江月飞霜落酒杯。\n寄语钱唐江上月，可怜寂寞照潮回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其五","author":"李廌","text":"寄语松陵与太湖，烟波风月尔何如。\n故时景物应如昔，复有当年张翰无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其四","author":"李廌","text":"问讯东海秦钓客，尔来闻已霸风骚。\n缗明饵香我知愧，愧尔一钩连六鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其三","author":"李廌","text":"苦忆君家两惠连，楼居应作水中仙。\n静看河畔青青草，应有池塘春梦篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其二","author":"李廌","text":"湖山主人玉堂客，尔来华发故应多。\n安石虽云江海士，元元苍生将奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏伯达之官西安七首 其一","author":"李廌","text":"好去西安苏县丞，千年求友近严陵。\n江山如彼君如此，正似玉壶寒露冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓至长湖戏赠德麟","author":"李廌","text":"桐实离离楸带长，玉鞭骄马度垂杨。\n黄茆野店人争看，篱上红眉粉额妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笋箨笔诗","author":"李廌","text":"琅玕夭娇排霄去，败箨平阶聊贮储。\n付与管城汤沐地，何须毛颖号中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴 其二","author":"李廌","text":"阴壑留残雪，林虹带晚霞。\n孤烟障渔市，不见两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿鸭亭","author":"李廌","text":"澄波奫沦鸭头绿，秋水清于春水明。\n芰裳已逐秋光尽，藻带暗藏春意生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"李廌","text":"纸窗明晃晃，云日暗暾暾。\n半夜寒添被，清晨雪拥门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中汎汉江呈德麟","author":"李廌","text":"汉江莽莽雪浮浮，远想山阴汎剡游。\n高兴共成何更尽，子猷安道喜同舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴","author":"李廌","text":"山凝秀色螺成髻，溪走寒光珠在盘。\n更欲呈姿作清巧，暂妆梅柳雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食","author":"李廌","text":"千株蜜炬出严闉，走马天街赐近臣。\n我亦茅檐自钻燧，煨针烧艾检铜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渼陂","author":"李廌","text":"晴山如黛水如蓝，波净天澄翠满潭。\n身在玉壶图画里，心随飞鸟过终南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事呈岑使君吏部次和德麟韵三首 其三","author":"李廌","text":"白叟黄童话使君，买牛买犊谕邦人。\n今年菽粟仓箱满，仁政常为七县春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事呈岑使君吏部次和德麟韵三首 其二","author":"李廌","text":"稻塍粟垄绿相连，野老欣逢大有年。\n人意物情俱自适，溶溶佳气满江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事呈岑使君吏部次和德麟韵三首 其一","author":"李廌","text":"日射西山烂烂光，低云遮岸水风凉。\n从来鞍马倦行役，笑语不知岐路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德麟以书相招云已与潘仲宝在中卢可自酂来同游灵溪石门双池等胜处某作六诗率张会川作 其四","author":"李廌","text":"地上云居有梵天，碧池灵脉泻双泉。\n不应胜地能埋没，政欲因君佳句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德麟以书相招云已与潘仲宝在中卢可自酂来同游灵溪石门双池等胜处某作六诗率张会川作 其一","author":"李廌","text":"冰溪雪岭赴诗盟，我愧难先二子鸣。\n莫惮登临助馀勇，欲令万战遇奇兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德麟以书相招云已与潘仲宝在中卢可自酂来同游灵溪石门双池等胜处某作六诗率张会川作 其六","author":"李廌","text":"异时倥偬此时閒，甘在尘中可厚颜。\n天为好山生胜士，莫因便懒负云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德麟以书相招云已与潘仲宝在中卢可自酂来同游灵溪石门双池等胜处某作六诗率张会川作 其五","author":"李廌","text":"云外泉声度碧林，浏萦累带作清深。\n吾缨已分令尘染，欲借寒光去洗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德麟以书相招云已与潘仲宝在中卢可自酂来同游灵溪石门双池等胜处某作六诗率张会川作 其三","author":"李廌","text":"千仞云崖耸石门，古传此地圣凡分。\n我曹自愧群峰诮，未必山灵解勒文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题孔氏东园三首 其三","author":"李廌","text":"浓绿阴中黄栗留，醉乡迟日厌鸣鸠。\n青春去后百花歇，赖有枝头安石榴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题孔氏东园三首 其二","author":"李廌","text":"桐已参天柏已苍，昔年曾见似人长。\n树犹如此人休怪，宾主相逢鬓各霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题孔氏东园三首 其一","author":"李廌","text":"何处移来薝卜花，琢成玉叶静无瑕。\n天香不合人间有，只是祇园居士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题唐洲东寺访友人不值诗 其二","author":"李廌","text":"眼前风景似襄阳，松柏参天竹满岗。\n鶗鴂一声春欲去，雨催新杏渐娇黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题唐洲东寺访友人不值诗 其一","author":"李廌","text":"三年漂泊老荆州，重过淮安旧驿楼。\n地上谪仙天上去，故来萧寺想风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题峻极下院列岫亭诗 其一","author":"李廌","text":"早讶年年狂士来，每来亭上独徘徊。\n山应又喜添知己，去后山容似死灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题峻极下院列岫亭诗 其二","author":"李廌","text":"山色满亭亭倚空，与君俱在画图中。\n解道龙腾青壁断，令人却忆漫浪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又过陈叔易隐居相拉同游超化寺诗","author":"李廌","text":"文范今亡见嗣卿，颍川应聚异时星。\n清风特为吾曹至，畏景宁忧日御停。\n踏雪曾穿东郭履，移文今忤北山灵。\n烹茶且酌南溪水，第欠金山第二?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"习池诗","author":"李廌","text":"陈迹相推今古同，池边倚杖送归鸿。\n童山尚接千岩秀，稚树犹传万壑风。\n春意物情迷野兴，水光天影共青空。\n雍门有泪应承睫，绕墓行吟吊习公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雨中游岳寺","author":"李廌","text":"忽见微云别峤生，急缘危磴下峥嵘。\n势倾海岱千岩黑，力卷江湖万叶声。\n碧瓦依稀人暗喜，急溪湍涨马初惊。\n老僧宴坐朱门底，应笑狂夫冒险行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分题得古香炉","author":"李廌","text":"质为浮休弃，形惟好古宜。\n埏陶异甓砾，香火近神祇。\n冷暖非恒德，兴衰彼一时。\n舍兹何所适，尔意勿迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"厄台","author":"李廌","text":"今古俱无忌惮情，厄台犹敢尚为名。\n裔孙不复重瞳圣，俗目俱同瞽叟盲。\n见愠仲由空肮脏，脍肝盗蹠尚彭亨。\n圣人道大故难用，谁听弦歌兕虎声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人董耘馈长沙猫笋廌以享太史公太史公辄作诗为贶因笋寓意且以为赠耳廌即和之亦以寓自兴之意且述前相知之情焉","author":"李廌","text":"节藏泥滓气凌空，荐俎宁知肉味重。\n未许韦编充简策，已胜丝黍诳蛟龙。\n短萌任逐霜刀重，美干须烦雪壤封。\n他日要令高士爱，不应常共宰夫供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少林寺诗","author":"李廌","text":"禅老家风古少林，道场遗迹蔽烟岑。\n山遮石脚斜阳早，云碍钟声出谷深。\n只履度关天杳杳，九年面壁海沉沉。\n欲知苗裔能传法，柏树犹明圣主心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方竹杖和功远","author":"李廌","text":"性禀方外正，人怜节瘦轻。\n持携防水潦，杀活奈山精。\n直以中圆称，名因义类清。\n若将灵寿比，未可贱书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]