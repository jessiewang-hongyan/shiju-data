[{"title":"寒食野外书所见","author":"宋祁","text":"一雨初回逗晚凉，近郊连帟俨相望。\n乞浆易醉墦间客，就养初閒灶下郎。\n暖吹未休缘迥野，低烟不散为垂杨。\n家家钟鼓争行乐，肯信龙蛇是怨章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"属邑告稔寄转运劝农二使台","author":"宋祁","text":"稼云弥望默纡馀，雨遍公私告稔初。\n田父此时歌击壤，牧人他夜梦为鱼。\n劝符数下收遗穧，漕谷相衔饷剩储。\n莫谓衰翁止蒙福，有年须待史官书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"属疾五首 其五","author":"宋祁","text":"里旅居仍隘，台家疾见宽。\n何言汉朴学，正似楚枝官。\n煦渚藏劳尾，投林戢倦翰。\n上恩何日报，怯步已蹒跚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"属疾五首 其四","author":"宋祁","text":"天假支离养，人怀寂寞惭。\n衰容行得老，苦节遂无甘。\n飞鸟惟宜下，疲驴讵可骖。\n吾生知所守，嘲客勿多谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"属疾五首 其三","author":"宋祁","text":"自昔闻称疾，于今是养疴。\n三杯留客案，五子倦朝珂。\n落落堪忧苦，星星奈老何。\n酒希非所嗜，扬宅竟谁过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"属疾五首 其二","author":"宋祁","text":"淹卧日无聊，年侵葆鬓凋。\n久衰翻似凤，危息乍成鷮。\n笔倦长栖格，琴慵不褫襓。\n心知烦虑苦，宁望一丸销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"属疾五首 其一","author":"宋祁","text":"腐肉填鸱素，华轩载鹤身。\n闭关吾有谓，当路彼何人。\n带眼移仍数，颠毛变愈新。\n惟无公干誉，他味似漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屡乞近郡诏不许","author":"宋祁","text":"避贤求假左朱轮，衡石通章触罢频。\n十驾似驽宁取道，五能如鼠不藏身。\n危心事国区区在，短领侵年种种新。\n君惠转深无报日，长教猿鹤怨归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嵇中散画像","author":"宋祁","text":"彼美云章子，翛然天外情。\n凝眉逐层翥，俯手散馀清。\n霄迥心逾远，徽迁曲暗成。\n千秋想萧散，方觉绘毫精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠民堤河晚瞩","author":"宋祁","text":"远水同萦带，联堤类筑垣。\n行舟压天底，卧木拥沙痕。\n鲂鱮逃空罶，凫鹥泊迥村。\n层波真可羡，由此到都门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠泉","author":"宋祁","text":"遥源辞叠嶂，澄派鉴晴虚。\n流迅无汾恶，波长尽楚馀。\n隐之徒酌水，郑伯谩名渠。\n不必西江去，凭君起鲋鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"提刑张都官回文诗","author":"宋祁","text":"欢馀惜对清谈剧，远路行嗟又怆违。\n寒蚁酒空催客别，晓骊歌罢怨人归。\n乾风摆柳衰条短，骤霰迷鸿侧阵微。\n残岁念君同恨恨，丽章贻我慰依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欹枕","author":"宋祁","text":"欹枕风窗雪絮繁，梦回红日转南轩。\n栖迟自乐周人什，偃息终非魏国藩。\n书习练裙聊弄翰，吟随池草欲迷魂。\n疏慵不喜当关报，罗雀先时署翟门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴云","author":"宋祁","text":"春空无际碧，云意静悠悠。\n尽日随风驭，迎昏抱月钩。\n正宜衔迥陇，强欲蔽层楼。\n宋野何须问，鸿濛正掉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"智成上人奉陪中山公赴淝上","author":"宋祁","text":"宗工方出守，大士此相亲。\n不有今平叔，难酬彼上人。\n毡毹连榻具，笋脯对盂珍。\n别后临川偈，同翻几叶新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝天岭","author":"宋祁","text":"天岭循归道，征旟面早暾。\n滩声逢石怒，山气附林昏。\n谷啭如禽哢，尘交作马痕。\n萋萋芳草意，无乃为王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝阳","author":"宋祁","text":"缩宿沈榆彩，沧溟转若华。\n才晞汉盘露，便映洛神霞。\n鸣凤梧冈迥，桑柔桂笼斜。\n照梁休自许，城上已啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游小圃","author":"宋祁","text":"初阳未爇树阴轻，中圃留连底有情。\n春草抽心终不死，夏禽反舌已无声。\n辘轳半上畦泉逗，襫袯初休陇雨晴。\n紫蓼青葵正堪掇，于陵何必是逃名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游白兆山寺","author":"宋祁","text":"地枕层岑面势斜，蔽亏原隰在烟霞。\n璇题衒目三休阁，宝树沿云四照花。\n结社高风思惠远，忘言真理寄毗邪。\n铜莲漏永螟风细，不觉西陂转若华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游惠山","author":"宋祁","text":"遇酒忘忧闻乐喜，世人未到惠山前。\n泉供胜味轻糟曲，松献清音异管弦。\n陆子旧文残琬琰，湛家馀迹抚云烟。\n珍禽幽石应容我，翠麓亭深晚更便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上晚瞩","author":"宋祁","text":"湖平潦已收，清兴暂夷犹。\n风舸时摇缆，眠凫自去洲。\n荒藤依树老，残芡听波浮。\n珍重芣山色，苍苍到暝楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登师利寺文殊阁","author":"宋祁","text":"宝梯斜级上盘空，千里亭皋一眺穷。\n翠柰自生经苑地，萎花时堕佛天风。\n桥横颍岸淙幽碧，日下嵩云插倒红。\n暂涤六尘凭槛久，可嗟归御太匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登高晚思","author":"宋祁","text":"喜祓尘襟属丽谯，高旻雨罢暑氛销。\n游回宿鸟霞横岭，唱杀寒蝉柳抱桥。\n戍壁风烟閒尉候，客亭灯火混渔樵。\n山川信美非吾乐，已是三年去国遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登望台","author":"宋祁","text":"年华无限景，况复上高台。\n晓气先明树，春寒不著梅。\n幽禽仍早啭，戏蝶即双来。\n此地流霞意，同谁一釂杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登塔","author":"宋祁","text":"窣堵缘霄雁势联，凭阑清眺俯三川。\n春华已遍燃灯地，日气犹烘噀雨天。\n游盖结阴尘不动，饮筹催釂客争传。\n须知四级题名处，要记浮生六十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼","author":"宋祁","text":"百尺危楼照綵霓，凭高不见羽人归。\n桑田海上悲深浅，城郭人间叹是非。\n急桨征帆来未定，远云低树去相依。\n古欢今恨成多少，讵减江声与翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼望郡中美人物之盛","author":"宋祁","text":"晓色青烟万瓦间，飞谯极望尽通阛。\n轮音闹过丛台市，岁计多于畏垒山。\n猎路向寒鹰眼疾，戍亭无事犬声閒。\n邑民讼息风谣乐，坐饫双鸡止厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程密学知益州","author":"宋祁","text":"墀涂昼对光尧蓂，细札芝泥袭绶馨。\n三独旧台呼辐宠，十连新府梦刀灵。\n云梯霁日明钩栈，雨阁苍苔蚀剑铭。\n只恐廉襦歌未厌，萤煌归应六符星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答书 其二","author":"宋祁","text":"答书牛马走，卜疏草茅人。\n久谢轮囷器，羞言阿堵神。\n触笼摧劲翮，喣沫瀑穷鳞。\n尚欲求糟粕，心知老斲轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答书","author":"宋祁","text":"经㰅摧无几，书刀削未休。\n胡能反招隐，更欲傍牢愁。\n澌砚寒馀滴，窗灯明映篝。\n子威销骨尽，何相得封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答书 其一","author":"宋祁","text":"栾栾馀病骨，踽踽本孤臣。\n夷饿怀餐粟，轲居忆徙邻。\n旧围宽胁带，镵刻暗书筠。\n亲见扬雄者，容仪不动人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答劝农李渊宗嘉州江行","author":"宋祁","text":"嘉月嘉州路，轲峨按部船。\n山围杜宇国，江入夜郎天。\n霁引溪楼望，凉供水馆眠。\n愧君舟楫意，遂欲济长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答友人清明雨思","author":"宋祁","text":"楚云朝暮蔽前峰，佳节寻芳已半空。\n三日薰炉沈蕙绿，一星春火并榆红。\n文鳞对掷回塘水，贺燕交飞翠幕风。\n怅忆沈斋题句罢，碎英无响坠华桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答天台梵才吉公寄茶并长句","author":"宋祁","text":"山中啼鸟报春归，阴阆阳墟翠已滋。\n初笋一枪知探候，乱花三沸记烹时。\n佛天甘露流珍远，帝辇仙浆待汲迟。\n饫罢翛然诵清句，赤城霞外想幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答屯田齐员外见赠","author":"宋祁","text":"淹卧清漳续畔牢，平时赋笔谢登高。\n决科漫欲当三道，作颂何曾敌二豪。\n久侍经帏惭肉缓，骤歌楼雪觉心劳。\n兼金满橐萱忧释，空仰文星在汉曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答户部勾院王学士泊沧陵见寄","author":"宋祁","text":"峭帆风罢到淮濒，草草停桡一问津。\n大小山前怀古地，短长亭下未归人。\n林姿暗淡吞霞彩，浪垒光芒受月轮。\n尚忆他年故俦在，擘笺题作郢中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答刑部王侍郎病中见寄","author":"宋祁","text":"请告烦开许，循衰分退藏。\n病淹三折臂，愁热九回肠。\n冻酌思同釂，仙丸得遍尝。\n深惭白云老，相忆未相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答安陆王工部早春郡园见寄次韵","author":"宋祁","text":"五马新回金络头，方春稀讼释南囚。\n荆岑汉浒联形胜，渚月台风递宴游。\n自许良辰偏有感，不知清唱遂无俦。\n比来酒所闻相忆，对倚层城近此楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答安陆庞掾","author":"宋祁","text":"囊文尝奏御，军事此参卿。\n座隘升堂友，乡荣乞墅甥。\n清言飘麈毳，慎疾搴芝英。\n谈幄尸官久，烦襟怯报琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答朱公绰牡丹","author":"宋祁","text":"珍卉分清赏，飞邮附翠笼。\n蹄金点鬓密，璋玉镂跗红。\n香惜持来远，春应摘后空。\n玩时仍把酒，恨不与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答张学士西湖即席","author":"宋祁","text":"胜地纡佳客，高秋会赏心。\n返霞延落照，馀岫补疏林。\n捉麈谈方熟，持螯酒屡斟。\n无烦命丝竹，擿句是清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答李从著作","author":"宋祁","text":"身是鸡翘侍从流，单车淮上老为州。\n全生正似婆娑树，不死翻成觳觫牛。\n今日空名同地饼，晚年归计有瓜畴。\n惭君远寄相思句，不啻三逢采艾秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答连生见寄兼简同邑胡希元","author":"宋祁","text":"京华倦游客，顾我损文鳞。\n道觉穷方胜，交缘淡更亲。\n句成池草夕，讯到陇梅春。\n欲答双盘恨，清才彼有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答京西提刑张司封次韵","author":"宋祁","text":"乞得二千石，终非循吏才。\n霜蓬根易动，笼鸟翅难开。\n梦寤惭封邑，陶埏仰铉台。\n报言殊丽藻，虚附驿筒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答庞龙图塞下秋意","author":"宋祁","text":"故人握节远屯边，三见寒飙折塞绵。\n俎豆何妨学军旅，兜鍪遂欲出貂蝉。\n酒酣帐下摐金夕，雪洒军中蹋鞠天。\n不惜裁章报吾党，欲将馀力镂燕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答庞丞相","author":"宋祁","text":"安车就第上优贤，不使当关损晏眠。\n勋重旧更三府地，体强初过六身年。\n游篮净贮茶经具，醉幕閒垂酒颂天。\n独念相如久称疾，时时令预雪台篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答转运王工部到寿阳却乘流东下以诗见寄","author":"宋祁","text":"闻到清淮上，还乘清溜回。\n缘持使者节，难把故人杯。\n曙盖星衔柳，昏邮雨亚梅。\n怆离并感昔，都向句中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答客","author":"宋祁","text":"贱子空虚甚，何烦跪自陈。\n摧藏不鸣雁，排迮后来薪。\n栉短三秋发，途奔四海尘。\n安能得所欲，况是数奇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答翁愈赋卷","author":"宋祁","text":"登高大夫事，感物古诗流。\n韵变齐风缓，辞凌汉气遒。\n恨非雌霓赏，惟祝洞箫求。\n病客无盘玉，琅玕未易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答通判张太博贺雪应期","author":"宋祁","text":"亲祝星鱼裂绘绡，再旬方见瑞英飘。\n阴连腊底寒威在，润压春头疠气销。\n碎粒有声欺瓦屋，乱花无次恼林条。\n府中上客真才子，首为常民续楚谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答郭仲微以予记注见庆之作","author":"宋祁","text":"晓趁霞暾立殿螭，翠凹濡墨庆逢时。\n褚生徒记为郎事，方朔犹惭待诏饥。\n目极天关趋䆗窱，步依宫柞荫华滋。\n故人雅意相怜厚，亲唱阳春护草衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答宿州王素都官","author":"宋祁","text":"当年弛镫避清尘，此地联麾喜故人。\n豸角去冠休触佞，虎头分绶且行春。\n谤销不复投亲杼，宦拙犹须让后薪。\n酌酒为君赓一曲，江边收得子牟身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答常山屯田张中行寄赠","author":"宋祁","text":"紫荷焦脱燥宫毫，万里边霜扰鬓毛。\n不称衰年开幕府，只堪平世掾功曹。\n飞蓬转野初无定，疮雁惊弦久未高。\n犹有一愁何计奈，掷䃉难报美人刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答彭州职方朱员外公绰","author":"宋祁","text":"四忝方州换隼旟，九番官树老储胥。\n淹留太史编残藁，废忘河东箧里书。\n远想渊云才不逮，略通邛僰计仍疏。\n梦回密友偏矜我，时损瑶音附鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答景亳宣徽吴尚书见寄短偈","author":"宋祁","text":"玉帐论兵罢，东方静守藩。\n有尘都是客，无法可容言。\n海鸟逢觞怯，醯鸡恋瓮喧。\n因公四句惠，弥觉对酬烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答燕龙图对雪宴百花见寄","author":"宋祁","text":"百花洲外六花寒，使幕凌晨把酒看。\n舞袂回风人斗丽，醉山颓玉客留欢。\n斜霏北渚离鸿下，密洒东风宝骑攒。\n犹念平台旧朋侣，远将清句代幽兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答翰林苏学士","author":"宋祁","text":"开颜忽见故人书，并得雕章念索居。\n自是牺尊忆沟水，敢将吾笠望卿车。\n流年遂往蹉跎在，末路虽还连蹇馀。\n弹饰旧冠犹有愧，别来苍鬓不胜梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊后书所见","author":"宋祁","text":"北斗边城春柄回，闰年飘縠占馀灰。\n鼓声催遍江南草，驿路传残陇首梅。\n寒日已高犹沆漭，薄云无待故徘徊。\n何郎素忆惭杯杓，强欲乘閒拨冻醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊后晚望","author":"宋祁","text":"寒日系难定，鸣笳弄已休。\n冻崖初辨马，昏谷自量牛。\n汉树临关密，荒泉入塞流。\n登高能赋未，风物古尧州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落月","author":"宋祁","text":"已照金枢穴，初乘玉女扉。\n望花愁桂老，数叶畏蓂稀。\n汉蚌兼珠隐，边兵背塞归。\n持将离妾恨，一问上天飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花 其一","author":"宋祁","text":"紫房丹萼旋辞春，素瑟悲多不忍闻。\n暮雨便从巫峡散，馀香犹上魏台分。\n魂销南浦波空绿，望绝长门日易曛。\n翠被已空桃楫远，自今搔首更离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花 其二","author":"宋祁","text":"坠素翻红各自伤，青楼烟雨忍相忘。\n将飞更作回风舞，已落犹成半面妆。\n沧海客归珠迸泪，章台人去骨遗香。\n可能无意传双蝶，尽委芳心与蜜房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢都官监建安郡","author":"宋祁","text":"郎署新畴出宰功，海闽关夹使旌雄。\n晨涂倦伏双毫奏，暮席贪随五两风。\n芳荈摘山唐贡远，薧鱼升豆汉祠丰。\n赌囊贵胄膏腴盛，丽唱行闻溢褚中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢都官监治建州","author":"宋祁","text":"初得中台满岁迁，七闽犹贰左鱼权。\n鸡香烬晦华星闼，虎眼波迎下濑船。\n几种珍鲑资昼膳，万岑芳茗蔽春廛。\n行行正及陶嘉月，溪树烘霞荔子鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋得新秋似旧秋","author":"宋祁","text":"新秋摇落意，只似旧秋时。\n流景预何事，长年真自悲。\n芙蕖兼露歇，杨柳带蝉衰。\n叹罢蹉跎在，惟应素领知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐禁中所种稻米","author":"宋祁","text":"中天铜雀长鸣罢，清籞滮池告稔初。\n刈敛方从弄田出，颁分更自导官馀。\n霜茎矗秀纡宸玩，玉粒凝甘剩禁储。\n惭愧有年君赐厚，等閒欹枕梦为鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中二首 其二","author":"宋祁","text":"舣船清颍岸，岸豁见高原。\n桑柘寒烟路，牛羊落日村。\n扣舷鱼艇集，争食渚凫喧。\n去去风波事，逢人未易言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]