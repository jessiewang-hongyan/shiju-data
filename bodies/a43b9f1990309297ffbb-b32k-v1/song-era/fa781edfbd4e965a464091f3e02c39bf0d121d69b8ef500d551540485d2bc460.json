[{"title":"送周畏知二首 其二","author":"张栻","text":"半世功名误，苍颜幕府游。\n文辞追楚些，得失付阳秋。\n荐牍方交上，衡门岂重留。\n青云看稳去，快处一回眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周畏知二首 其一","author":"张栻","text":"秋冬仍苦雨，旬浃喜霜晴。\n木末楼台见，江头橘柚明。\n登临方适意，离别已增情。\n后夜相思地，寒梅影正横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送范伯崇","author":"张栻","text":"堂堂延阁老，遗范见斯人。\n孝友传家旧，诗书用力新。\n人心危易失，圣学妙难亲。\n愿勉思弘毅，求仁可得仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送临武雷令 其一","author":"张栻","text":"诏举循良吏，时资抚字功。\n人情平易看，治道古今同。\n绿野新耕盛，潢池旧习空。\n便应君课最，名姓御屏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡伯逢之官金陵","author":"张栻","text":"相望数舍已云疏，远别何因执子袪。\n漫仕想应同捧檄，旧闻当不废观书。\n月明淮水空陈迹，山绕新亭有故墟。\n暇日更须频访古，因来为我道何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵节卿","author":"张栻","text":"昭代才难叹，宗盟世有人。\n千钧定晚试，一角信逢真。\n政拟寻梅共，还经折柳新。\n青云看稳上，回首楚江春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曾裘父","author":"张栻","text":"交旧间何阔，能来浃日留。\n还寻佳橘颂，惜别仲宣楼。\n探古书盈屋，忧时雪满头。\n绝思黄阁老，招隐意绸缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舜臣抚干表兄赴部","author":"张栻","text":"畴昔相看意便倾，重逢便觉眼增明。\n半生漫仕壮心在，五月长江去棹轻。\n龟椟久藏千乘宝，鹏风方快九霄程。\n公朝兼用人门选，外氏传家旧有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送韩宜州","author":"张栻","text":"顷年未识宜州面，已信诸贤品藻公。\n幕下从容逢益友，胸中肮脏本家风。\n一麾且与宽凋瘵，华发应无慕勇功。\n从古安边须自治，人情初不间华戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送零陵贾使君二首 其二","author":"张栻","text":"孝友传家法，如君好弟兄。\n祇应推此意，便足慰民情。\n间岁仍艰食，新书督劝耕。\n想今潇水畔，惟日望双旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送零陵贾使君二首 其一","author":"张栻","text":"藉甚零陵郡，风流记昔贤。\n宅存元水部，人识范忠宣。\n山近地宜竹，溪清岸有泉。\n官閒时访古，馀韵故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重九日与宾佐登龙山","author":"张栻","text":"晓风猎猎笛横秋，泽国名山九日游。\n万里烟云归老眼，千年形势接中州。\n丘原到处堪怀古，萸菊随时岂解愁。\n此日此心谁共领，朝宗江汉自东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重九陪详刑护漕东西楼之集","author":"张栻","text":"猎猎西风满角巾，登临秋思与云平。\n山围四野高低碧，江绕东城今古清。\n莫恨寒花未堪摘，且忻樽酒得同倾。\n政须客里频回首，细话家山此日情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳前一日","author":"张栻","text":"九日明朝是，清樽强自开。\n萧萧疏雨暗，滚滚大江来。\n野菊闲无数，沙鸥静不猜。\n何须骑台饮，此兴亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻定叟弟已近适迫祀事未能出先遣侄辈往迎书此问讯","author":"张栻","text":"渐喜书题近，悬知归意忙。\n才闻下湘水，早已过衡阳。\n雨洗秋山净，凉生桂树香。\n慇勤二三子，策马为迎将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕登仲宣楼","author":"张栻","text":"怀土昔人志，伤时此日心。\n长江霜潦净，故国莫烟深。\n访古多遗恨，凭栏更独吟。\n细看前浦树，生意已堪寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读李邕碑","author":"张栻","text":"荒榛日莫倚筇时，叹息危亭北海碑。\n后辈但知尊字画，当年不得戍边垂。\n岂关贝锦能成祸，祇恐干将不自奇。\n杜老惜才千古意，如今谁咏六公辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄宇文邛州","author":"张栻","text":"寄语临邛守，相望万里情。\n有来诗句好，足验教条清。\n好古从时讪，为邦已政成。\n无寻子虚赋，忠厚诏诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄侯彦周","author":"张栻","text":"塞雁仍南去，慇勤问耒阳。\n催科应独拙，理发讵能长。\n邑古弦歌地，年丰鱼稻乡。\n婆娑还得不，三径未云荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赵漕","author":"张栻","text":"想得昭潭上，儿童夹道迎。\n皇华今日使，竹马旧时情。\n梅蕊冬前拆，山光雨后清。\n使君桃李客，当为驻车旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄曾节夫","author":"张栻","text":"曾子别经月，相思如几秋。\n不应行役叹，却为贾胡留。\n雨后湖光满，梅边春意浮。\n须君细商略，晴日共茶瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题周功父溪园三咏 其三 雪亭","author":"张栻","text":"溪园平广处，雅称雪中游。\n疏密看千变，高低共一丘。\n寒知松节劲，静觉竹声幽。\n还有故人否，当能著小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题周功父溪园三咏 其二 溪亭","author":"张栻","text":"未识主人面，先为溪上吟。\n澄潭依近岸，绝壁耸遥林。\n领略襟期远，登临岁律深。\n想当轩冕外，三叹有馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题周功父溪园三咏 其一 嫣然亭","author":"张栻","text":"闻说亭花好，居然似蜀乡。\n色深姿不俗，香淡意能长。\n高烛留深夜，轻阴护晚芳。\n何心较桃李，只拟答春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题建安公梅山堂","author":"张栻","text":"梅公山色近庭除，胜日供公几杖馀。\n千古谩传栖迹地，当年谁忆爱君书。\n丹心炯炯元无间，白发星星不用锄。\n待得斯民俱奠枕，归来端亦爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彪德美来会于泉有诗因次韵","author":"张栻","text":"君卧衡山北，我行湘水滨。\n相逢还莫逆，清绝两无尘。\n胜集追前日，轻阴近小春。\n濯缨聊复尔，举首谢簪绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿鸣宴","author":"张栻","text":"从昔山川夸八桂，只今文物盛南州。\n秋风万里携书剑，春日端门拜冕旒。\n圣世取才先实用，儒生报国岂身谋。\n且看廷策三千字，为写平时畎亩忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜广仲伯逢来会","author":"张栻","text":"二阮向来俱莫逆，支筇为我到山巅。\n浊醪共饮聊复尔，胜集于今亦偶然。\n人立千峰秋色里，月生沧海暮云边。\n高谈此地曾知几，一笑归来对榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨呈安国","author":"张栻","text":"望岁民心切，为霖帝力均。\n崇朝变炎暑，举目尽清新。\n坎坎连村鼓，熙熙万室春。\n北窗凉枕簟，安稳到闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜闻定叟弟归","author":"张栻","text":"吾弟三年别，归舟半月程。\n瘦肥应似旧，欢喜定如兄。\n秋日联鸿影，凉窗听雨声。\n人间团聚乐，身外总云轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾节夫罢官归旴江以小诗寄别","author":"张栻","text":"俗隘宁为异，言深敢自欺。\n如何幕中辩，翻作暗投疑。\n行李秋将半，家园菊正滋。\n反躬端得味，当复有馀师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游诚之来广西相从几一年今当赴官九江极与之惜别两诗饯行 其一","author":"张栻","text":"游子名家后，天资更敏强。\n壮怀知自许，远业定难量。\n幕府文书简，韦编趣味长。\n怅然成阔别，音寄莫相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游诚之来广西相从几一年今当赴官九江极与之惜别两诗饯行 其二","author":"张栻","text":"士学端成己，工夫要自程。\n圣门窥广大，中德养和平。\n美玉资勤琢，良才讵小成。\n心期须后会，拭目更增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游章华台","author":"张栻","text":"楚国旧雄胜，荒台今是非。\n平川留宿潦，萧寺掩斜晖。\n木落秋声急，天高雁影微。\n凄凉无处问，骑马踏堤归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游道场山次沈国录韵","author":"张栻","text":"玻瓈盆外起千鬟，路入空濛紫翠间。\n心远最便天宇迥，眼明偏见野云闲。\n寒泉宰木留千载，清磬疏钟度两山。\n我亦湘城三径在，湖边归去洗尘颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岳麓赫曦台联句","author":"朱熹","text":"泛舟长沙渚，振策湘山岑。\n烟云眇变化，宇宙穷高深。\n怀古壮士志，忧时君子心。\n寄言尘中客，莽苍谁能寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登法华台","author":"张栻","text":"山间景物转流年，台上风光处处传。\n放目便应云梦小，凭栏平挹祝融巅。\n忽寻故国占天际，谁看孤舟系岸边。\n百感还将山下去，肯同槁木堕深禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢胡掾惠诗","author":"张栻","text":"一见知心事，旋观慰月评。\n慈祥汉循吏，儒雅鲁诸生。\n莫作周南叹，终期冀北程。\n新诗连夜读，梅影伴孤清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隔墙闻正父乡饮甚乐偶畏风不预用前韵敬简","author":"张栻","text":"元日忻晴色，新年祇旧心。\n故人同客里，乡话自情深。\n尽说成都酒，休为楚泽吟。\n相逢须痛饮，岁月易侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"廉州何使君挽诗二首 其二","author":"张栻","text":"忆昔湟江上，相逢意便倾。\n胸中元浩荡，笔下更纵横。\n士伏徐公德，人言景倩清。\n定应乡里敬，枌社祭先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"廉州何使君挽诗二首 其一","author":"张栻","text":"橘井登贤籍，槐宫并俊游。\n姓名题雁塔，文字上瀛洲。\n青简穷千载，朱轓但一州。\n有怀终未试，眼看落山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新亭","author":"张栻","text":"风景自今古，斯亭今是非。\n绝怜江水去，还有故山围。\n得失同千虑，成亏共一机。\n所思惟谢傅，不但胜淮淝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醇叟崇道之丧未得往哭闻窀穸有期辄赋二章以相挽者 其二","author":"张栻","text":"晚岁浑无事，端居只自如。\n冰霜浇块磊，日月老籧篨。\n山寺留题墨，晴窗罢卷书。\n从今行岳路，忍复过公庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醇叟崇道之丧未得往哭闻窀穸有期辄赋二章以相挽者 其一","author":"张栻","text":"庆席亲贤胄，心知道义尊。\n如何著闲处，终不近修门。\n三载成长别，微言未细论。\n人琴俱寂寞，风雨闭丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题伏龙寺壁","author":"张栻","text":"少日忆曾到，归途得小留。\n回还山寺古，萧瑟柿林秋。\n道路情无那，琴书可细求。\n从来士穷达，分付水悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题邢使君钓隐","author":"张栻","text":"使君卜筑占芳洲，短槛疏篱处处幽。\n风月随时供燕几，笑谈终日在中流。\n翩翩影落来宾雁，漠漠寒生欲下鸥。\n城市山林俱寓目，问君底处足消忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南台寺","author":"张栻","text":"相望几兰若，胜处是南台。\n阁迥规摹稳，门空昼夜开。\n回风时浩荡，高岭更崔嵬。\n谩说石头滑，支筇得往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题益阳清修寺","author":"张栻","text":"峰势香炉直，溪流峡水潺。\n居然一兰若，唤作小庐山。\n老木千崖表，孤亭万竹间。\n明朝问征路，回首白云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题福岩","author":"张栻","text":"掷钵峰前寺，肩舆几度来。\n楼台还旧观，杉桧抚新栽。\n湘水堂堂去，秋山面面开。\n裴徊千古思，风壑有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩清风峡","author":"张栻","text":"扶疏古木矗危梯，开始知经几摄提。\n还有石桥容客坐，仰看兰若与云齐。\n风生阴壑方鸣籁，日烈尘寰正望霓。\n从此上山君努力，瘦藤今日得同携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"默侄之官襄阳两诗以送之 其一","author":"张栻","text":"默也相从久，吾心念汝多。\n又为江汉别，空觉岁年过。\n气习须消靡，工夫在讲磨。\n惟应介如石，人事易蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"襄州护漕使者张侯寄示所作快目亭记辞多慷慨予读而壮之且想斯亭观览之胜为赋此","author":"张栻","text":"闻说君家快目亭，湓江直上起千寻。\n昔人事业规摹在，故国山河草木深。\n世态从渠翻覆手，壮图还我短长吟。\n会须一展平戎策，始称平生洒落襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月旦日晚登湘南楼","author":"张栻","text":"又书稍去眼，日夕进微凉。\n高楼一徙倚，清风为我长。\n渔父荫深樾，归人度浮梁。\n仰看河汉明，俯视群山苍。\n平生会心处，于此故难忘。\n旧闻水东胜，岩峦发天藏。\n岂无一日暇，勇往聊徜徉。\n民瘼未渠补，况敢怀乐康。\n天边云物佳，似复为雨祥。\n秋成傥可期，岁晚或自强。\n当从农家鼓，一历水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二使者游东山酒后寄诗走笔次韵 其二","author":"张栻","text":"绣衣双节从天下，文字皆称一世豪。\n桂山发地凛千尺，新诗与之相并高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月既望要详刑护漕游水东早饭碧虚遍观栖霞程曾龙隐诸岩晚酌松关放舟过水月洞月色佳甚逼夜分乃归赋此纪游","author":"张栻","text":"漓江即湘江，戢戢清见石。\n其东列群峰，秋色碧复碧。\n日出雾露收，草径上逼侧。\n凭栏揩望眼，已足慰畴昔。\n更窥岩穴胜，创见为惊咋。\n如何数里间，奇观相接迹。\n宽同厦屋深，划若巨灵擘。\n日月递光景，风云变朝夕。\n石桥几年成，乳窦时一滴。\n神龙旧隐处，仰视多辟易。\n蜕迹凛犹存，隐隐印霜脊。\n下有澄湫深，馀波漱苍壁。\n往者已仙去，来者此其宅。\n薄晚扣松关，风过声索索。\n聊麾车骑退，容我且散策。\n却望訾家洲，轻舫度前碛。\n回首烟树林，已复挂蟾魄。\n宇旷净馀滓，群物被光泽。\n何所寄遐思，空岩皎虚白。\n清辉可一规，水色相激射。\n天边与川上，亭亭如合璧。\n居然广寒游，不用假六翮。\n班坐依微澜，晤赏共佳客。\n因之想千载，讵有今古隔。\n箫鼓归夜阑，观者粲城陌。\n往往罗杯盘，班班见殽核。\n谅因年岁丰，人意少舒适。\n视尔意少舒，于予亦忻怿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十五日过小孤山","author":"张栻","text":"沃野迥千里，岿然突孤标。\n崖分势亦裂，江静影频摇。\n栖鹘巢何险，盘柯冻不凋。\n吾行足观览，未觉客程遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月七日城南书院偶成","author":"张栻","text":"积雨欣始霁，清和在兹时。\n林叶既敷荣，禽声亦融怡。\n鸣泉来不穷，湖风起沦漪。\n西山卷馀云，逾觉秀色滋。\n层层丛绿间，爱彼松柏姿。\n青青初不改，似与幽人期。\n坐久还起步，堤边足逶迤。\n游鱼傍我行，野鹤向我飞。\n敢云昔贤志，亦复咏而归。\n寄言山中友，和我和平诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三茅观李仁父刘文潜员显道赵温叔崔子渊置酒分韵得高字","author":"张栻","text":"节物岁云暮，九衢尘满袍。\n起我二三友，招要步林皋。\n仰看冥飞鸿，俯览千丈涛。\n石径上深窈，竹风更萧骚。\n杯槃自真率，更起泻浊醪。\n叹我会合难，慰我涉历劳。\n薰然乡社游，饮少意已陶。\n我亦寿长者，万里欣所遭。\n嗟哉士业艰，逝矣日月滔。\n古义重金石，外物真秋毫。\n愿言共勉厉，勿负岷山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大云岩","author":"张栻","text":"平地起突兀，颓然若负龟。\n初疑斤斧凿，安得此巧奇。\n乃知化工巧，精意运神机。\n岩深翠长滴，冲冲阅四时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子远使君出守广汉始获倾盖诸官赋诗赠别某广汉人也故末章及之","author":"张栻","text":"半生落南州，分与岷峨疏。\n朅来荆江上，所忻近乡闾。\n吾乡多隽豪，杂遝来舟车。\n时从说情话，颇觉中怀舒。\n中间识胡公，粹美真璠玙。\n心远气自静，语简意有馀。\n向来有推毂，入校中秘书。\n名场万夫立，人亟我则徐。\n拳拳抱忠爱，百虑才一摅。\n白云已在望，思亲惜居诸。\n乞州枌榆边，政以便版舆。\n同舍挽不住，清风挟归裾。\n观君进退间，此岂为名誉。\n春帆肯小驻，论交良慰予。\n爱君秉质高，且复富蓄储。\n任重则道远，愿言勿踟蹰。\n吾州得贤牧，父老想乐胥。\n我亦有一廛，径思归荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广汉黄仲秉即转运使治之东作亭扁以楚翠盖取杜陵所谓楚岫千峰翠者属客赋诗","author":"张栻","text":"维衡屹南荒，作镇自开辟。\n蟠根结地厚，面势倚空碧。\n陂陀数州境，高下相接迹。\n麓山乃其趾，神秀固未极。\n定王十里城，处处见山色。\n知谁长在眼，嗟此尘中客。\n观风君独暇，延纳到几席。\n得句恍忘言，寄兴渺今昔。\n自君之东来，民瘼极探索。\n仁言彻九关，宁惧虎豹厄。\n诹询遍南亩，民肥吾则瘠。\n筑亭一舒啸，逮此百忧隙。\n看山傥不愧，隐几亦聊适。\n寄语后来者，此意当无斁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中夜祝融观月","author":"张栻","text":"披衣凛中夜，起步祝融巅。\n何许冰雪轮，皎皎飞上天。\n清光正在手，空明浩无边。\n群峰俨环列，玉树生琼田。\n白云起我旁，两腋风翩翩。\n举酒发浩歌，万籁为寂然。\n寄言平生友，诵我山中篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]