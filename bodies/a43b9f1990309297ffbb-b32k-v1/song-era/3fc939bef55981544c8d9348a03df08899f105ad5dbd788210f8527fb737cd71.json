[{"title":"霜晓早行","author":"孙嵩","text":"三两残星龙?云，人烟山色晓初分。\n西风一夜吹黄叶，不计霜晨客子闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日","author":"孙嵩","text":"残冬初曦巧弄频，轻澌片片动游鳞。\n土牛不报穷居暖，星鸟非司退士春。\n门帖废忘梅柳句，乡傩倚阁鼓鼙人。\n愁多酒浅知何那，太息年光草草新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行都饯岁","author":"孙嵩","text":"插架馀残历，挑灯忆故乡。\n年光蛇赴壑，羁旅雁随阳。\n禁阙迎傩鼓，邻街祭灶香。\n英雄须自力，容易鬓毛苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谢虚谷 其二","author":"孙嵩","text":"穷愁幽思或成时，畦径荒芜失自治。\n秋气居然寒宋玉，土风犹尔操钟仪。\n安能跛鳖从天马，正拟长松引菟丝。\n启以新篇新绳削，元和直至建安时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谢虚谷 其一","author":"孙嵩","text":"文章琬琰盛镌磨，乞与丹青侈若何。\n已是追随名世晚，敢言步骤古人多。\n未同子美投三赋，且为灵均释九歌。\n怎有农谣又渔曲，稍谈钓笠与耕蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊垂虹","author":"孙嵩","text":"螮蝀无晴雨，横空不计年。\n长身欺浪渺，钜力厌风颠。\n怀古方闻笛，题诗且住船。\n飞鸣中夜雁，何处得洲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"觅佳山水迁居未能又力役不休","author":"孙嵩","text":"微吟清啸有孤怀，历落嵚崎已大乖。\n芳草何心知世事，闲云肆意绕天涯。\n前时绝喜王官谷，此去聊堪阿里街。\n一语作铭君记取，腾腾任运莫安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临安钱武肃庙","author":"孙嵩","text":"吴越归旗纛，风云助鼓鼙。\n锦蒙山树遍，弩射海潮低。\n龙凤城葱郁，牛羊墓惨悽。\n古祠存故里，秋草庑东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日武康游望过孟东野故居","author":"孙嵩","text":"残霭初收半在沙，一川芳草趁溪斜。\n群峰古意汪芒国，废地诗情正曜家。\n天末凄迷浮野色，柳边骀荡受春华。\n更携尊酒看修竹，不为前坡得意花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦客","author":"孙嵩","text":"倦客江湖返，书生畎亩思。\n古来惟即墨，世上几仇池。\n八表烟霾隔，三春草木衰。\n交游消息断，存没杳难知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯叹","author":"孙嵩","text":"救地扶天力不支，犹为落落怪男儿。\n泥中龙逝江神骇，波际鲸枯海若悲。\n恨入烟云连汉县，魂随霜雪薄燕垂。\n可怜傲兀南冠在，吟尽关山恸绝诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣怀杂赋","author":"孙嵩","text":"宇宙迂疏一布衣，谋身毕竟是邪非。\n能知道义丘山重，定看荣华草芥微。\n世事悠悠蝴蝶梦，人情扰扰桔槔机。\n英雄不是违流俗，白雪阳春和自稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公无渡河","author":"孙嵩","text":"公乎渡河不可航，年既老，智则童。\n临流径渡何伥伥，夫岂有急须自亡。\n前无掣，后无挤，且无迹捕至尔门，未至东市之诛磔死如牛羊。\n河流在前白日光，谁以锦覆河流黄。\n公不见河源夭矫落昆崙，悬天注地千里强。\n飞奔突入中原疆，一击无有完堤防。\n跳蹴后土舂穹苍，公懵视之行康庄。\n掉臂而往无褰裳，不能驭风骑气奚为狂。\n河之流汤汤，鲲鲸之恶未可量。\n长戈为鳍锯为尾，刀崖斧窟镵牙张。\n公其以身委饥肠，人生无难死足伤。\n以饥寒死骨犹藏，棺椁送尔松柏冈。\n何必为河之鬼冯夷乡，其下浊泥出无梁。\n何不相蹙公自僵，奈何乎箜篌之音河水旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬初杂兴 其五","author":"孙嵩","text":"残花与新蕊，不共横斜枝。\n摧谢得清峭，独照冰霜时。\n寒梅正如此，他木乃变衰。\n此由观世物，特以厄见奇。\n古云桑落节，当有新醪篘。\n得秫酿几何，拨瓮香浮浮。\n醇熟不足计，醒醉亦自筹。\n得酒乃径饮，无酒亦可休。\n绝怜未知道，颠倒阮与刘。\n百年有事业，遑云逃糟丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬初杂兴 其一","author":"孙嵩","text":"今晨霜露肃，爱此群山秋。\n夭桃薄照日，乃是丹枫稠。\n草花无名字，正类黄菊幽。\n一筇步涧阿，聊复舒我眸。\n雁声一何高，渺渺关山愁。\n林间有橡栗，岁晚行可收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬初杂兴 其二","author":"孙嵩","text":"牧童与樵叟，共载牛背归。\n我无薪蒸计，南山松栎稀。\n寒风昨日至，须用葺我扉。\n故园或可废，亦以完我衣。\n人生有定分，勿怪生理微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬初杂兴 其六","author":"孙嵩","text":"秋晚种麰麦，覆块青茸茸。\n兹物乃畏湿，沟作棋道通。\n江南地力瘠，百谷劳农工。\n粳稌蓄塍上，麰麦藏沟中。\n从今防蹂啮，早晚观麦丛。\n须纵牛羊食，勿信东坡翁。\n吾诗乃农谱，亦著江南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬初杂兴 其四","author":"孙嵩","text":"斋中乃无纸，柿叶平篱根。\n稍取书点画，带此朝露痕。\n识字有何补，随尔忧患繁。\n姓名总不记，适有古意存。\n惜哉结绳后，事始于乾坤。\n先生晚始悟，无术鸠田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬初杂兴 其三","author":"孙嵩","text":"钟声烟外寺，报我明朝霜。\n篱落暝雀惊，原野昏鸦翔。\n杖策归茅茨，偶一歌慨慷。\n千载有我辈，感念行斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲江头","author":"孙嵩","text":"君不见曲江头，离离衰草寒云秋。\n今人不见昔人游，昔人不见今人愁。\n欲谈往事无耆旧，沉吟千载空搔首，盛衰倚伏如寒暄。\n秦时宜春苑，汉世乐游园，更复唐人宫殿拥千门。\n往古来今但如此，同一溶溶曲江水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还邓觉民诗卷","author":"孙嵩","text":"南山竹可笛，北山桐可琴。\n得如听松风，中有太古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明妃引","author":"孙嵩","text":"明妃如花颜，高出汉宫右。\n可怜君王目，但寄丹青手。\n寂寂保孤妍，悠悠成伪丑。\n坐此嫁穹庐，流落无时回。\n无时回，琵琶未阕边笳催。\n哀弦流入千家谱，明妃只作阏支舞。\n年年犹借南来风，吹得青青一抔土。\n君不见汉家嫁得几娉婷，不闻一一琵琶声。\n祸起当年娄敬谬，后人独恨毛延寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏嘲二子","author":"孙嵩","text":"攻为乐府作，吟尽乐府题。\n不晓张籍与王建，笔端欲揽风凄凄。\n大半闲愁生浪语，十九他人无与汝。\n击辕抚缶何如声，奈此澜翻两吻鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀五首 其五","author":"孙嵩","text":"黄山秋雕锼，风露洗崖崿。\n行行听清猿，处处采灵药。\n秋云老石床，已后十年约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀五首 其四","author":"孙嵩","text":"畴昔旅江湖，夜夜南飞雁。\n山园柿栗秋，出户望河汉。\n袛今寒雁时，中夕起三叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀五首 其三","author":"孙嵩","text":"何处秋声多，竹外声历历。\n凄切不禁寒，萧萧旧时碧。\n此中白发愁，饷与秋风客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀五首 其二","author":"孙嵩","text":"从来感秋人，一例皆楚声。\n吾闻古燕赵，慷慨多不平。\n惜哉宋玉辞，不使荆轲听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀五首 其一","author":"孙嵩","text":"秋虫日以喧，秋树日以疏。\n君听草根蛩，泣吊风中梧。\n壮士秋怀涕，及此清霜初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送年寓叹","author":"孙嵩","text":"岁事分携作径归，清愁环守有重围。\n预供除日先人祭，次拂元朝道士衣。\n狂似嵇康今尽懒，觉如蘧瑗昔皆非。\n新春未识耕耘地，当卜何如买钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感兴","author":"孙嵩","text":"清风有佳意，逢者为一娱。\n曾不救饥渴，政尔飘襟裾。\n凡物贵有用，论诗用则无。\n诗成亦自咏，侘傺或昭苏。\n身名不相涉，二者如参商。\n迟其议论公，旷越百世长。\n于人已无益，离离坟草荒。\n不知史册上，更是谁芬芳。\n犹足厉世俗，曰此有耿光。\n生前文字冗，寸札蓐荑稂。\n及后乃大行，家有星河章。\n君欲知其人，近世苏与黄。\n夫有酷吏事，良不为奇屯。\n俗子来吾前，有语无由伸。\n其愚正可置，而又何为嗔。\n勿如孤竹子，宇宙生涯垠。\n匪惟狎樵牧，浩浩冥疏亲。\n鸟故不乱行，兽故不乱群。\n在山为远志，出山为小草。\n不足凋谢安，适可谓殷浩。\n夫亦有所怀，非必著枯槁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东池","author":"孙锡","text":"一片沧州景，寒光湛碧流。\n有时双鲤跃，尽日采鸳浮。\n绿荇千丝密，红蕖万朵稠。\n琴尊约佳客，乘月泛归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孙锡","text":"句溪虽可鉴，未若宛溪清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日游盘谷","author":"孙翥","text":"旌旆朝驱入翠微，东风闲访故山薇。\n金龟换酒留僧住，白鹤穿云伴客归。\n月影坐移栖凤竹，泉声静绕钓鱼矶。\n中原那似开元日，得学巢由远是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"裴公亭二首 其二","author":"孙翥","text":"风有亭台月有池，春深猿鹤喜追随。\n水从王屋泉初旺，山过秦关势欲危。\n仙乐静依林鸟奏，浮云轻伴海鸥迟。\n斜阳不尽登临兴，远树微茫入酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"裴公亭二首 其一","author":"孙翥","text":"太行王屋群峰上，秦晋关河望处分。\n猿鹤几年怀旧隐，乾坤百战重儒勋。\n龙归洞府暮将雨，僧过浮桥晓度云。\n万里中原无事日，不妨尊酒细论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"孙奭","text":"笑背芙蓉阙，东南望海涯。\n云章藏绿蕴，鹤驭拂青霞。\n台岭攀新桂，桃源访旧花。\n鸣驺须再去，莫泛客星槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武平十二峰","author":"孙璋","text":"苍峰十二碧岩隈，岂是飞从海上来。\n灵境莫将巫峡比，但令云雨下阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东路赤岭铺","author":"孙蕃","text":"官路日长蝴蝶飞，豫章花落点征衣。\n江南江北牡丹过，肠断春归客未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙岩寺","author":"孙懋","text":"苍林翠碧龙岩寺，县令三年两度来。\n从此岩前花与草，只今时与梦徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温泉","author":"孙懋","text":"乔林远凝烟，怪石卧如虎。\n汤泉在其下，深广数尺许。\n蒸蒸百鼎沸，衮衮骊珠吐。\n温然可人意，了不变寒暑。\n我来一盥挹，和气溢宾主。\n谁知山谷间，异物乃有取。\n又闻泉之功，万顷浸禾黍。\n升腾或为云，定作傅岩雨。\n贤人抱气节，潇洒谨出处。\n平生泽物志，得时谁可御。\n奈何斗筲徒，名利每轻举。\n一朝冰山碎，笑唾无足数。\n临风祝斯泉，更请事斯语。\n回首骊山阴，凄然吊前古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"于飞乐","author":"宇文元质","text":"休休得也，只消更、一朵荼蘼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅林分韵得酒字","author":"宇文师献","text":"平生慕英游，望公真山斗。\n一见开心诚，已落诸人后。\n龙门岂甄择，大小俱容受。\n联辔寻胜践，春风倚尊酒。\n惟公对江梅，端若同志友。\n玉色洗尘沙，幽姿出藜莠。\n命客花下坐，相与沃醇酎。\n非公无此客，譬诸草木臭。\n向晚入深巷，苍根倚瓮牖。\n始知水西头，卧梅胜卧柳。\n有客三叹息，此树警老丑。\n一笑客诚痴，万法要经久。\n奇卉如尤物，过眼不必有。\n惠我终日香，重来香在否。\n但从此理悟，那复长搔首。\n念公捧召节，修名当不朽。\n舣舟未忍去，拓寻访林薮。\n中心甚虚明，外慕厌纷纠。\n杖屦循古岸，细话犹开诱。\n再拜诵公诗，一洗刍豢口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题回山人画像","author":"宇文孝叔","text":"仙踪久矣闭禅关，忽遇高人唤得还。\n创就琳宫依岌嶪，移来真像带斓斑。\n路通远浦重重水，楼倚长松面面山。\n酌我一杯如有意，坐令衰脸变朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"宇文绍节","text":"过口此舟方属汝，行人何用较锥刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏碛","author":"宇文绍庄","text":"八阵图前凛古风，武侯英烈岂匆匆。\n江流千载长呜咽，山插孤云亦茜葱。\n陡觉新春忘病思，喜陪高论自情钟。\n典刑前辈今能几，岁晚相期华发同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈二首 其一","author":"安分庵主","text":"几年个事挂胸怀，问尽诸方眼不开。\n肝胆此时俱裂破，一声江上侍郎来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈二首 其二","author":"安分庵主","text":"十五日已前，天上有星皆拱北。\n十五日已后，人间无水不朝东。\n已前已后总拈却，到处乡谈各不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石门","author":"安丙","text":"凌晨走马过花后，先玩玉盆次石门。\n细想张良烧断处，岩间伫立欲销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈伯宏归天台","author":"安丙","text":"平生江湖兴，欲住元无由。\n一朝忽复来，飘然泛扁舟。\n相将东南去，子独从之游。\n倾盖荷相与，盏斝频劝酬。\n危坐每长叹，经营出奇谋。\n浩然天地间，愤气冲斗牛。\n追陪文字饮，酣歌大开喉。\n与君结深交，交朋情欲周。\n会合元有时，妄意追陶刘。\n每恨不久住，共此敝马裘。\n西风彫梧桐，忽忽春复秋。\n嗟余客中都，中夜怀百忧。\n区区为贫仕，坐此徒穷愁。\n我恨各南北，公乃遂所求。\n天台亘雁荡，今为故乡游。\n忽焉又分襟，凉风已飕飕。\n可怜烟水阔，坐见群山幽。\n音书有可寄，还解顾我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下瞿塘","author":"安如山","text":"去去如奔马，来来无尽船。\n人心似江水，日夜向吴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹将军","author":"安如山","text":"将军精悍姿，齿齿碎铁石。\n在昔童稚中，但闻饱经术。\n纵横骋柔翰，丹雘间金碧。\n有司塞明诏，敝邑屈词伯。\n芹香春水生，冠玉侍重席。\n脱略章句陋，搜抉穷理窟。\n未及文化成，其如王土窄。\n丈夫报主愿，岂必蒙清秩。\n苍然请去位，满面秋栗烈。\n纠合熊虎群，旌旆扬广陌。\n正当摩厉閒，一鼓拔勍敌。\n屯兵沔水源，千里斧截截。\n浩荡排烟旻，西极安屼嵲。\n奈何国无人，腐儒秉旄钺。\n赏予入私门，金汤授盗贼。\n公时奋臂争，反遭献玉刖。\n三军视马首，痛哭下天壁。\n功成坐龃龉，愤怒须插戟。\n中宵拔剑起，肃肃整劲翮。\n吐气风云生，搴旗陷坚列。\n贯穿死生地，蹀血天地黑。\n势虽众寡悬，形未雌雄决。\n路穷断首尾，众尽乃手格。\n岂知龙虎逝，黯淡山川色。\n百万尚震惊，呜呼死诸葛。\n长城但自坏，千里痛稠结。\n肉食无远谋，野史有直笔。\n酒酣歌节士，皛皛霜日白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清远峡和光洞","author":"安昌期","text":"蕙帐将辞去，猿猱不忍啼。\n琴书自为乐，朋友孰相携。\n丹灶非无药，青云别有梯。\n峡山余暂隐，人莫拟夷齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归天宁万年禅院","author":"安德裕","text":"迹自青门远，田衣贲在躬。\n旧房千峤外，归棹五湖东。\n地力姜畦沃，年支芋盎充。\n从支乃荣道，一与祖心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞来山","author":"安稹","text":"升山游罢到贤沙，松桧阴中一境赊。\n自愧簪缨趋仕路，翻怜泉石属僧家。\n寻穷越国真仙迹，见尽闽封好物华。\n幸接凭熊拥千骑，红旌归去照残霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"举富铺","author":"安鏖","text":"漠漠烟横草树青，依稀风景似兰亭。\n小桥疏竹人沽酒，曲径落花僧掩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三姑石","author":"安?","text":"雾鬓烟鬟彷佛梳，老翁指点说三姑。\n娉婷不嫁非无意，谁是人间大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暖翠","author":"安?","text":"暖翠浮岚万壑春，桃花流水碧沄沄。\n同亭祠下生青草，天柱峰头空白云。\n雨后石林群鹭宿，月中山树两猿分。\n几时结屋清溪上，鹤氅筇枝学隐君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炊熟日有怆松楸","author":"巩丰","text":"小楼吹断玉笙哀，春半馀寒去复来。\n五岁不浇坟土上，望江心折刺桐开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄即事","author":"巩丰","text":"积藓青踰一寸痕，山灵守护几千春。\n长藤横系岩边木，何日重来挂葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴便有春意","author":"巩丰","text":"风正波平可进桡，水光山影暮相交。\n残阳欲去犹回首，一抹斜红曳竹梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪汀见二鸥三鹊对立","author":"巩丰","text":"二鸥三鹊羽毛鲜，立在方沙更可怜。\n全似烂柯棋势里，白棋初让黑棋先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠微亭","author":"巩丰","text":"行迹年来到处希，独于岩壑有深期。\n鹅溪道士能相属，请和空山木落诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题阮孚墓","author":"巩丰","text":"千古高风挽不回，故山花落又花开。\n莫欺亭畔苍苍藓，曾印高人屐齿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]