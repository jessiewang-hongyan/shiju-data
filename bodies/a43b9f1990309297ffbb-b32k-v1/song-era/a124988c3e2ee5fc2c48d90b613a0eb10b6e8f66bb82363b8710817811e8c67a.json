[{"title":"和唐致远蜡梅","author":"崔敦诗","text":"万木折冰雪，千葩谢华秾。\n谁约金童仙，冲寒下严风。\n恼人风味深，缕衣立隆冬。\n旁有玉京子，含香笑相逢。\n夜水吐玉龙，月窗影相重。\n诗情太牢落，聊以二友供。\n清标体黄裳，素姿掩凡容。\n东君著意先，群英绝追踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和甄监簿述怀","author":"崔敦诗","text":"一鸣当日众俱惊，曾掞天庭赋太清。\n宦路喜君方晚遇，文场推我是虚声。\n短材漫饱支离粟，藻思宜餐沆瀣英。\n近喜和光成莫逆，嘉名洋溢鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙七年端午帖子词 皇后閤六首 其二","author":"崔敦诗","text":"厚德承三殿，柔风被八纮。\n欲知勤俭化，当暑浣衣清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十四 太祖位酌献用《孝安》。","author":"郊庙朝会歌辞","text":"一德开基，百年垂统。\n中天禘郊，薄海朝贡。\n宝龟相承，器鼎加重。\n泽深庆绵，帝复命宋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十九 亚献用《穆安》。","author":"郊庙朝会歌辞","text":"四阿有严，神既戾止。\n备物虽仪，洁诚惟己。\n有来振振，相我熙事。\n载酌陶匏，以成毖祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十七 皇帝还小次用《仪安》。","author":"郊庙朝会歌辞","text":"匏尊既举，秸席未移。\n有德斯顾，靡神不娭。\n物情肃穆，天宇清夷。\n宅中受命，永复邦基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十六 还大次用《憩安》。","author":"郊庙朝会歌辞","text":"应天以实，已事而竣。\n毡案朝帝，竹宫拜神。\n灵光下烛，协气斯陈。\n福禄时万，基图日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊祀乐章 皇帝降御座宫架奏黄钟宫乾安之曲","author":"崔敦诗","text":"帝坐中天，流泽演迤。\n厥蒙伊民，歌舞以喜。\n泽流普矣，民喜偕矣。\n驾言徂归，福禄同矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十三 送神用《诚安》。","author":"郊庙朝会歌辞","text":"奕奕宗祀，煌煌礼文。\n高灵下堕，精意升闻。\n熙事既毕，忽乘青云。\n敢拜明贶，永清世氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊祀乐章 登门肆赦皇帝升御座宫架奏黄钟宫乾安之曲","author":"崔敦诗","text":"大礼备矣，銮车阗阗。\n帝来维何，赉及幅员。\n有声伊肃，有容伊虔。\n彼雉斯开，帝坐中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 三举酒用瑞鹤之曲","author":"崔敦诗","text":"彼肃者羽，名纪仙经。\n芝田下啄，容止安停。\n引吭警露，响彻青冥。\n圣德格物，来仪帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 上寿用崇安之曲","author":"崔敦诗","text":"凝旒肃穆，鸣佩舂容。\n有酒伊醑，管磬其从。\n典礼绚缛，威仪恪共。\n颂尧之寿，与天比隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 五举酒用老人星见之曲","author":"崔敦诗","text":"奕奕南极，应期曜灵。\n祥晖昭衍，次丙躔丁。\n事垂汉史，名著甘经。\n锡符祚圣，亿万斯龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 公卿入门用礼安之曲","author":"崔敦诗","text":"端闱肃启，金奏和声。\n有来济济，烨其华缨。\n度中规矩，步协英茎。\n一人达孝，百辟丕承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 升坐用圣安之曲","author":"崔敦诗","text":"簪缨列序，羽卫分行。\n雉扇爰彻，天威炜煌。\n清明在躬，颙颙昂昂。\n咸拜稽首，万寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 太上皇帝初举酒用蟠桃之曲","author":"崔敦诗","text":"结根阆苑，登实瑶池。\n红云骈艳，瑞露含滋。\n味参石髓，名配松脂。\n王母一笑，河水涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 四举酒用祥龟之曲","author":"崔敦诗","text":"粤有灵物，负图效祥。\n莲栖蓍宿，锦文有章。\n天和发越，睿泽滂洋。\n溯于宫沼，美应昭彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 再举酒用大椿之曲","author":"崔敦诗","text":"培植自古，质淳以全。\n凌傲霜雹，盘薄风烟。\n朝菌焉识，楚蓂讵肩。\n耸柯擢干，终古苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 降坐用福安之曲","author":"崔敦诗","text":"庆典具举，皇慈溥将。\n礼光长乐，事掩未央。\n佩环济济，金石锵锵。\n天容有怿，言旋建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 酒再行罢用圣德重光之舞","author":"崔敦诗","text":"于穆圣子，仁天智神。\n体刚立极，宝俭化民。\n美政毕举，旧章聿遵。\n舞以象德，拟韶实伦。\n龙楼问寝，前殿奉卮。\n密承慈训，不怠其祗。\n海宇丰阜，边陲晏夷。\n于以养志，福禄来宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 皇帝上太上皇寿酒用福安之曲","author":"崔敦诗","text":"笙镛皦绎，簨簴腾骧。\n奉觞介寿，龙衮黼裳。\n盛仪克举，至德用章。\n刑于四海，化洽风扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝上太上皇帝寿乐曲 酒一行罢用万寿无疆之舞","author":"崔敦诗","text":"三纪御图，道丰德盛。\n化洽兆民，功光列圣。\n畀托有归，脱屣万乘。\n优游法宫，颐神养性。\n岧岧具阙，丰丽靖渊。\n游神象外，玩意物先。\n为众父父，尊荣配天。\n大福备禄，何千万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二时慢","author":"崔敦诗","text":"勋华并、天胙昌期。\n圣德茂重离。\n英明经远，浚哲昭微。\n宝俭更深慈。\n观万国、累洽重熙。\n对明时。\n报礼秩神祗。\n玉帛奏华夷。\n雍肃显相，百辟各钦祗。\n奄嘉虞英璧奠华滋。\n神安坐、景气澄虚。\n极光焰、烛长丽。\n展诗应律，万舞逶迟。\n三献洽皇仪。\n垂露浸庆祜来宜。\n礼无违。\n鸣鸾临帝阙，飞凤下天倪。\n清和寰宇，霈泽一朝驰。\n醇化无为。\n万祀巩洪基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六州","author":"崔敦诗","text":"商秋吉，嘉会协中辛。\n涓路寝，修禋祀，圣德昭清。\n端志虑，罄竭斋精。\n锦绣排天仗，羽卫缤纷。\n朝太室、返中宸。\n被衮接神明。\n时平天时俱清晏，兼丰年和气，品物达芳馨。\n瞻熉座，舂容娭燕三灵。\n奠瑶爵，荐量币，清思呦冥冥。\n望昆仑。\n嘉祥塞絪缊。\n诚殚礼洽庆休成。\n润泽被生民。\n端门肆眚，昕庭称贺，俱将景福万寿、祝双亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"崔暨","text":"居占梅仙里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎丘","author":"崔端","text":"入寺山光峭倚天，剑池寒色锁危巅。\n苍苔自老生公石，新茗谁烹陆羽泉。\n楼阁下窥溟海浪，松篁遥接洞庭烟。\n二难选胜真奇绝，留得芳名万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"今日一何好","author":"崔璆","text":"今日一何好，花下醉狼藉。\n醉中有奇事，梦见生八翼。\n浩荡排虚空，灵君好颜色。\n朱衣持大篆，授我醉乡伯。\n顿首玉墀下，臣璆才虮虱。\n封此抑何功，请陈愚顽臆。\n臣家京口东，门前大江碧。\n臣愿驾长风，吹作酒万石。\n万象各千钟，拍拍大庭国。\n推枕在山中，纸衾霜晓月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咄咄","author":"崔璆","text":"咄咄复咄咄，小儿成老翁。\n幺微各形色，追琢元化工。\n不知春风去，又见千绿丛。\n主人美客怀，载酒行溪东。\n一步一回首，十步尊已空。\n灵均与太白，醒醉同所终。\n愿见化蠛蠓，生死托壶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"携鸊钺汎江","author":"崔璆","text":"酒星落京口，化为崔子玉。\n孤舟载壶觞，水花红映肉。\n小儿唱铜斗，大儿倒醽醁。\n一笑不知年，浩荡天地屋。\n慎勿临窦呼，人生随转烛。\n嗣宗礼法仇，钟会被杀戮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"属疾","author":"崔遵度","text":"李白羹初美，相如渴渐瘳。\n八砖非性懒，三昧减心忧。\n笔宛多批凤，词锋胜解牛。\n旧山疑鹤怨，畏日想云愁。\n广内劳挥翰，通中羡枕流。\n使星方屡降，客辖未容投。\n好奏倪宽议，何须庄舄讴。\n朝衣熏歇不，侍史待仙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与叔易过石佛看宋大夫画山水","author":"崔鶠","text":"霜落石林江气清，隔江犹见暮山横。\n个中只欠崔夫子，满帽秋风信马行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观黄筌画花二首 其二","author":"崔鶠","text":"浅浅红颧与白腮，卧枝斜叶抱新开。\n何人与作春风面，诳得蜂儿日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观黄筌画花二首 其一","author":"崔鶠","text":"苍颜白发我虽陈，见了青红几度新。\n更向黄生毫末里，全家看尽剑南春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吕居仁九日诗","author":"崔鶠","text":"街头未易著清香，折取萧萧满把黄。\n归去乞钱烦里社，买糕沽酒作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其二","author":"崔鶠","text":"记得诗狂欲发时，鄱阳湖里月明知。\n无人为觅桓伊笛，自捲秋芦片叶吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗二首 其一","author":"崔鶠","text":"泪尽空山一病夫，荆榛无路掩樵居。\n自怜身是皮公美，茅屋青灯夜著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗四首 其四","author":"崔鶠","text":"屯云塞望蔚青林，刻雪停空立皓禽。\n南渡长淮才一水，令人便起五湖心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗四首 其三","author":"崔鶠","text":"荒蒲乱苇簇人烟，指点江州一望间。\n惜取看人闲目力，琵琶亭上看庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗四首 其二","author":"崔鶠","text":"芙蓉堂下水溟溟，老去难禁此段清。\n唤取王郎吹玉笛，愁来要听水龙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗四首 其一","author":"崔鶠","text":"我如秋蝶未忘情，对此寒花叹此生。\n常愧老来亲拄杖，看花不似蝶身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"崔鶠","text":"落日不可尽，丹林紫谷开。\n明明远色里，历历暝鸦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日即事","author":"崔鶠","text":"秋草门前已没靴，更无人过野人家。\n离离疏竹时闻雨，淡淡轻烟不隔花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花","author":"崔鶠","text":"残月迷春晓，桃花怯夜寒。\n何人未妆洗，先傍玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"崔鶠","text":"浑是华清出浴初，碧绡斜掩见红肤。\n便教桃李能言语，要比娇妍比得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"婆娑园","author":"崔鶠","text":"晚禽噪竹百千翅，残菊横枝三两花。\n好在山园养衰废，风波不到野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其一","author":"崔鶠","text":"仙子衣裳云不染，天人颜色玉无瑕。\n月寒桂树犹藏魄，海冻珊瑚未放芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绩溪道中三首 其三","author":"崔鶠","text":"山口含糊半吐云，林头时见绿纷纷。\n何人解作孤鸾啸，呼取凉风入帽裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绩溪道中三首 其二","author":"崔鶠","text":"摐摐名木列千兵，风雨斜来捲旆旌。\n愁倚寺门南下望，水烟不见小桥横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绩溪道中三首 其一","author":"崔鶠","text":"䆉稏青衣未剡芒，联拳荷叶已秋香。\n笋舆十里青松路，高捲蒙纱溯晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄州道中","author":"崔鶠","text":"莫愁微雨落轻云，十里长亭未垫巾。\n流水小桥山下路，马头无处不逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上联句","author":"崔鶠","text":"遥岑舣舟见，野思过桥生。\n兴尽回兰棹，归鞍月正明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题绩溪雪峰楼","author":"崔鶠","text":"题诗最高处，不为付人看。\n记著今朝胜，山明松雪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝忠楼","author":"崔鶠","text":"闻说骊龙睡九渊，觉来头角去升天。\n官封越国三千户，血食新安五百年。\n锦轴尚标唐岁月，彩楼重见宋山川。\n收藏石匣非无意，留与江南野史传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新安四咏 其二","author":"崔鶠","text":"我爱新安好，城西似竹西。\n僧扉入黄叶，樵径下寒溪。\n宝阁花为网，珍台玉作梯。\n不愁临暮雨，白石了无泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新安四咏 其一","author":"崔鶠","text":"我爱新安好，斋房四友全。\n斲成千样玉，扫得万毬烟。\n云气随银管，蛟龙入彩笺。\n周旋不能去，何待更论年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丈室","author":"崔鶠","text":"此家英妙姿，玉雪熙冠冕。\n新诗一何似，鸾鹄见萧散。\n蹑屣往从之，宁复念重趼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子石砚","author":"崔鶠","text":"石家有儿玉含晶，嘘为云气吸为晴。\n纯精与之相感并，孕育万状流千名。\n黄昏鬼哭不忍听，且为白鹅了黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"止遽轩","author":"崔鶠","text":"我如万斛船，岁久腰已懒。\n谁能逐相师，终日问手板。\n去谋一寸安，辄被三尺挽。\n怜公谢蛮触，鼓卧旗亦偃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石牛庄閒居","author":"崔鶠","text":"不识春风面，知从底处来。\n红深桃靥破，绿静水帘开。\n物外心常挂，人间事不谐。\n从今江海去，无复世推排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会节园梅花下作","author":"崔鶠","text":"去年白玉花，结子深林间。\n小憩藉清影，低颦啄微酸。\n故人不复见，春事今已阑。\n绕树寻履迹，空馀土花斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春偶题","author":"崔鶠","text":"寒风淅沥鸣枯苇，小鸭睡残犹未起。\n更教细雨结轻寒，坐听萧萧打窗纸。\n石盆养蒲已抽翠，雕斛栽花先弄紫。\n拥炉闭閤赋幽香，未怕春冰生砚水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋雨霁图","author":"崔鶠","text":"我离蜀山来，赤日走东州。\n奇峰作眼想，一过神已留。\n翩翩宋公子，新诗蔼风流。\n丹青见新韵，潇洒出林丘。\n依微万里遥，旷明一雨收。\n高云杳褰开，缟日明华秋。\n风裾映山青，眇眇行李幽。\n得非送将归，色有离别忧。\n念我山海癖，针砭不为瘳。\n目看孤鸿飞，心已麋鹿游。\n吾儿能扶犁，此帻便可投。\n勿言尺寸许，是中有菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观鱼","author":"崔鶠","text":"小鱼喜亲人，可钓亦可网。\n大鱼自有神，隐见谁能量。\n老禅虽无心，施食不肯尝。\n时于千寻底，隐见如龙章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和老人观牧图","author":"崔鶠","text":"作官畏人嘲，胡孙骑牧牛。\n却离大江水，还家整归舟。\n还家此计不可移，此乐勿令儿辈知。\n行歌带索拾遗穗，耳静不复闻征鼙。\n功名亦妄尔，吾生去此将安之。\n趁此青草长，自牧牛与羊。\n不减九十头，何翅三百强。\n沙平水浅南山下，千角万蹄如此画。\n牛腰吹笛溯秋风，不问人间矍铄翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏圆通崇胜院","author":"崔鶠","text":"峥嵘卢山高，下看三江水。\n青天瀑布飞，白日看烟起。\n人家闲崦口，石道乔松底。\n似窥仙刹丽，翠影乱螭尾。\n亭亭两金闾，妙拥青云里。\n瞻言古堂侧，绛幔垂乌几。\n煌煌重瞳君，玉带横文绮。\n名为天下笑，身系降生邸。\n辛苦万厄功，一戏直童子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花","author":"崔鶠","text":"如何一朽株，孕此千亿花。\n虽云行且阑，明岁亦再华。\n岂如世上人，一老不复佳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花 其二","author":"崔鶠","text":"寿阳楼畔晴梅落，孝武宫中晓露漙。\n越浦争回乘兴棹，洛堤欲驻有情鞍。\n蝶遗粉翼轻难拾，鹤坠霜毛散未抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新安四咏 其三","author":"崔鶠","text":"我爱新安好，新安胜事多。\n秋容明远眺，夜响答清歌。\n寺映离离叶，城通瑟瑟波。\n黄山敌嵩阜，三十六嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]