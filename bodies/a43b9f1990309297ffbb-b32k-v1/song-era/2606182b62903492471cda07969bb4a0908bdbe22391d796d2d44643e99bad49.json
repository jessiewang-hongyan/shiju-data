[{"title":"喜声伯谪还","author":"区仕衡","text":"生还今日寸心明，客泪初收恨亦平。\n岂有安危关一疏，不知流逐到诸生。\n钱塘江上船犹待，玉枕山前屋未成。\n畎亩馀忠刘子政，也应全不为修名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游曹溪六祖寺","author":"区仕衡","text":"智药曾过此，溪源掬水香。\n西天传鹫至，南海见龙藏。\n菩萨一心竟，伽梨六代长。\n千年法珠在，持得照迷方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登西樵后即往罗浮山","author":"区仕衡","text":"大科百丈兴翛然，东向朱明七洞天。\n蹑级修衢通绝巘，凿空灵窦架飞烟。\n凤毛五色天岩上，竹篆千秋石室前。\n两入名山劳蜡屐，安期于世竟能仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答赵宗白宣州寄诗次韵","author":"区仕衡","text":"三载樟亭信到迟，偏劳双鲤寄相思。\n玄晖有兴期频订，太白曾游亦自奇。\n顾我尝为秋圃客，知君不废敬亭诗。\n未须更道澄江练，只候飞凫上赤墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑寺丞邓山长来访林中","author":"区仕衡","text":"喧传彩鹢下江干，村北村南稚子看。\n呼酒咄嗟欣有客，住山寥落幸无官。\n不惭居士新藤帽，亦醉田家老瓦盆。\n君爱幽居寻旧好，几来林下共清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中","author":"区仕衡","text":"蓬窗竹户小园东，湿尽残红又浅红。\n羡杀乌栖深树稳，豆花篱落雨声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡生行","author":"区仕衡","text":"君不见平陵班仲升，君不见句章阚德润。\n二子佣书日苦贫，投笔诵经总才隽。\n又不见二子之后有胡生，寸管从人落魄行。\n往往自诧骨非贱，口述二子功与名。\n凿空绝域称使者，孝廉为郎补中舍。\n都乡拜爵金印持，定远封侯玉门射。\n胡生果是大耳儿，蛟龙尺水自有时。\n长安乞米齿编贝，且得待诏聊免饥。\n不能持钓富春泽，只解校文天禄阁。\n丈夫岂必终落魄，他时人认佣书客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘声伯赴南安军羁置","author":"区仕衡","text":"凤山君出早，马厩我来迟。\n盘辟分斋日，流涕伏阙时。\n谪堪栽岭树，愁莫赋江蓠。\n横浦看前辈，应刘铁汉诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都门送杜枢院","author":"区仕衡","text":"赫赫中兴业，黼扆咨明辅。\n锋车召黄岩，端笏拜西府。\n昔簉讲筵班，倏接仪曹武。\n庶几进谠言，衮职万一补。\n璚琚厕珷玞，楩楠杂榛楛。\n镜几祈圣哲，厦构谋梁柱。\n云何梦傅时，而乃与哙伍。\n指图玩金瓯，进箴骄玉斧。\n旦夕尚逡巡，调剂竭肝腑。\n志竟不可谐，洁身谢鹓羽。\n道岂荣抽簪，思恒记铭釜。\n公行且居东，衮归谒朱户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赵仲白先辈","author":"区仕衡","text":"章台杜牧之，长安孟东野。\n忆君飞笔时，何处木兰下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄恺刘黻赵蕃王元野会讲祐国僧舍","author":"区仕衡","text":"城角晓方罢，斋钟时一鸣。\n良候属春莺，求友来嘤嘤。\n吾侪二三子，簪盍怀同声。\n相期辨初志，视履规安行。\n道岂讲解得，学以磨琢精。\n释氏辨一心，且不蕲修名。\n齐盟共商求，勉旃在明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"卞震","text":"老筇支瘦影，寒木凭吟身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"卞震","text":"雨壁长秋菌，风枝落病蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"卞震","text":"积雨生残稻，苍苔入旧笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"卞震","text":"风涛秋渡阙，烟雨晚村孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"卞震","text":"茶香解睡磨铛煮，山色牵怀著屐登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"卞震","text":"空囊万里客，斜月一床寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"卞震","text":"芳草又牵为客恨，白云空寄未闲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"卞震","text":"诗债到春无处避，离愁因醉暂时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"卞震","text":"双阙暂随丹诏入，三峰寻与白云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"双林大士","text":"渡河须用筏，到岸不须船。\n人法俱名执，悟理讵劳诠。\n中流仍被溺，谁论在两边。\n有无如取一，即被汗心田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"双涧","text":"雨露桑麻清夜话，晴明花柳少年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"厅壁山水","author":"双渐","text":"涧边芳草连天碧，山下锦涛无丈尺。\n莺稀燕少蝶未知，蜜意寻芳与谁惜。\n我有春情方似织，万绪千头难求觅。\n富贵荣华不早来，眼前光景空抛掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豫章逢故人歌","author":"双渐","text":"乐天尝日浔阳渚，舟中曾遇商人妇。\n坐间因感琵琶声，为托微词写深诉。\n因重佳人难再得，故言何必曾相识。\n今日相逢相识人，青衫拭泪应无极。\n我因从官临川去，豫章城下风帆驻。\n续有翩翩画舸来，斜阳共系垂杨树。\n绿窗相近未多时，红帘半动闻私语。\n认得舟中是故人，从人来自韶阳路。\n柔情脉脉不得通，馀香冉冉时闻度。\n借问舟中是谁氏，长自庐江佳丽地。\n苏姓从来字小卿，桃叶桃根皆姊妹。\n十岁清歌已遏云，十一朱颜妒桃李。\n十二能描新月眉，十三解绾乌云髻。\n乱花溪上偶相逢，一托深心许为婿。\n翠鬟曾剪系平生，暗断金钗为盟誓。\n无何官难两相忘，因兹流落来天际。\n扬州一梦今何处，风月心情向谁诉。\n算来争似不相逢，空感当时无限事。\n昔日风光曾作主，今日风光如蓦路。\n肠断江头夜不眠，风帆明日东西去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人月圆","author":"双渐","text":"碧纱低映秦娥面，咫尺暗香浓。\n瑶池春晚，长天共恨，烟锁芙蓉。\n夭桃再赏，流莺声巧，不待春工。\n樽前潜想，樱桃破处，得似香红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答赞宁","author":"天目僧","text":"山中人事违，天眼中修定。\n我本无根株，只将笋为命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宴坐石","author":"太史章","text":"白云曾罩定中身，石上云归不见人。\n应有山神常守护，松风时为埽埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题望飞泉","author":"太史章","text":"既晴安得雨霏霏，百道流泉落翠微。\n侧帽试看绳引处，破烟千点湿人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石桥","author":"太史章","text":"涧底轻雷喷玉泉，石桥僧度是何年。\n灵峰斗隔人间世，真境潜分洞里天。\n施食曾闻龙就掌，谈空应有虎当筵。\n道猷雪涕非无谓，谁见湔肠挂木颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题幽石","author":"太史章","text":"痕疑神所凿，不与众岩俱。\n镇地形何直，参天势自孤。\n鹤栖乔木稳，猿揽古藤粗。\n欲得丹青手，和云画作图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏崇道观","author":"太史章","text":"神仙隐居尚深渺，径迂不欲与世通。\n必求峭拔出林杪，俯视左右环群峰。\n飞泉不测源所自，瀑注一落千丈虹。\n步跻石磴旋盘折，翠荫蒙密多长松。\n唐闻马练师，晋传葛仙翁。\n丹灰已死不复炽，独有翰墨留遗踪。\n定知华表立归鹤，谁见灵湫藏蛰龙。\n白云子，信亦稀，藐视声利如尘泥。\n仕途捷径非我乐，不死之乡终欲归。\n玉霄峰前烟扑扑，金庭宫外云霏霏。\n哀猿啸断月不古，桃杏得春还满枝。\n风驭寥寥何处在，孤坟棺殓只空衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回憩翠蛟亭","author":"孔元忠","text":"引领篮舆上翠微，众山回首觉平低。\n栖真洞口云初合，大涤峰头日未西。\n新笋暗抽穿木叶，古藤虬结跨沙堤。\n蛟亭雨后泉声急，万鼓喧豗拥涧蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵穆父见戏","author":"孔文仲","text":"当年同望赭袍光，万事争先落彩铓。\n一别已经陵谷变，再来方觉路岐长。\n黄金久压腰间重，白笔才容柱下藏。\n唯愿山林息枹鼓，免教鸱隼嚇鸳凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵瀛倅邓慎思见寄","author":"孔文仲","text":"官是麟台却佐州，蓬瀛俱称列仙游。\n忆分晓色趋天阙，想对春风倚郡楼。\n书付塞鸿应易到，人如陇水正分流。\n江湖未有归耕处，何日相逢说旅愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至南都途中感旧二首寄钱穆父 其二","author":"孔文仲","text":"苒苒星霜七换年，故人已上碧云天。\n书凭去雁虽无便，路出名都亦有缘。\n秋晚楼台风作雪，雨馀埼岸柳生烟。\n应烦北道开樽俎，又费公庖几万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至南都途中感旧二首寄钱穆父 其一","author":"孔文仲","text":"北风吹雪满皇州，携手同为落魄游。\n霄汉路歧腾万里，江湖尘土积千忧。\n世情共逐飞蓬转，人事都如激浪流。\n只待清谈慰愁病，月明几度促归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋月二首 其二","author":"孔文仲","text":"秋夜不可晨，悲歌聊自永。\n頫听一掀帘，星河光烱烱。\n霜浮万瓦寂，月满四山静。\n壮心随北风，吹入单于境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋月二首 其一","author":"孔文仲","text":"孤枕夜何永，破窗秋已寒。\n雨声冲梦断，霜气袭衣单。\n利剑摧锋锷，苍鹯缩羽翰。\n平生冲斗气，变作泪汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天官颛面正朝","author":"孔文仲","text":"天官惟将相，位号著璇霄。\n所处皆颛面，攸司共正朝。\n极星安正宁，列宿俪群僚。\n号令三光动，吹嘘二气调。\n何参方辅汉，稷契正裨尧。\n盛旦群龙进，乾符已上昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月三十日慈孝寺山亭席上口占送子敦都运待制赴河北","author":"孔文仲","text":"送客城南寺，萧然云水秋。\n客意在万里，聊作须臾游。\n昨夜过新雨，清风满梁州。\n簪裳合俊彦，河图并天球。\n古来功名人，未就不肯休。\n譬如凿空使，尚致安石榴。\n矧今南亩氓，往往东西流。\n君能安辑之，千仓与万辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉烛","author":"孔文仲","text":"圣王臻大治，四海属休戈。\n遂致阴阳顺，均如玉烛和。\n德威周远迩，民俗被渐摩。\n品物皆蕃殖，昌辰绝札瘥。\n气充诸夏润，祥应太平多。\n华旦今如此，庸才愿咏歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"孔平仲","text":"客兴谓已旦，出视见落月。\n瘦马入荒陂，霜花重如雪。\n海风吹万里，两耳冻几脱。\n岁晏已苦寒，近北尤凛洌。\n况当清晓行，溯此原野阔。\n笠飞带绕颈，指强不能结。\n农家烟火微，炙手粗可热。\n岂能迂我留，而就苟且活。\n仰头视四宇，夜气亦渐豁。\n苦心待正昼，白日想不阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次钱穆父新凉可喜","author":"孔文仲","text":"商飙结新寒，草木起馀怨。\n翩翩前庭叶，追逐已千万。\n斜阳背西壁，迤逦落藤蔓。\n安得金满堂，聊换酒家券。\n追随双鸿鹄，摆脱旧笼圈。\n胡为汗流赭，日与蝇争饭。\n常恐计不就，更以诗屡劝。\n江湖秋水高，百尺风帆健。\n何当开竹溪，玉腕互酬献。\n左手持蟹螯，平昔固有愿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"置章御座","author":"孔文仲","text":"圣皇勤政治，虚己纳忠良。\n拱手居宸扆，留神置谏章。\n孜孜收国论，密密迩天光。\n中昃常游息，焦劳慎作荒。\n至言规汉后，无逸戒周王。\n默处岩廊邃，洪基可世长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题显孝南山寺","author":"孔文仲","text":"寻尽城中山，又访江外寺。\n兰舟涉澄漪，隼旌入疏翠。\n楼台初日升，岩谷宿露坠。\n飞泉百禽鸣，怪石万蛇踬。\n绝庵皆步登，佳木留客醉。\n洞天生昼寒，桃源发春意。\n烟霞暂深阔，宇宙忽殊异。\n海国遇升平，铃斋无俗事。\n颍川擅才敏，康乐足情意。\n只恐新诗多，镌镵费年祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孔文仲","text":"一茎青竹初出水，数个黄蜂占作窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禾熟三首 其一","author":"孔平仲","text":"百里西风禾黍香，鸣泉落窦谷登场。\n老牛粗了耕耘债，齧草坡头卧夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"犍为王氏书楼","author":"苏轼","text":"树林幽翠满山谷，楼观突兀起江滨。\n云是昔人藏书处，磊落万卷今生尘。\n江边日出红雾散，绮窗画阁青氛氲。\n山猿悲啸谷泉响，野鸟嘐戛岩花春。\n借问主人今何在，被甲远戍长苦辛。\n先登搏战事斩级，区区何者为《三坟》。\n书生古亦有战阵，葛巾羽扇挥三军。\n古人不见悲世俗，回首苍山空白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄内","author":"孔平仲","text":"试说途中景，方知别后心。\n行人日暮少，风雪乱山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宜宾见夷中乱山","author":"苏轼","text":"江寒晴不知，远见山上日。\n朦胧含高峰，晃荡射峭壁。\n横云忽飘散，翠树纷历历。\n行人挹孤光，飞鸟投远碧。\n蛮荒谁复爱，秾秀安可适。\n岂无避世士，高隐鍊精魄。\n谁能从之游，路有豺虎迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和经父寄张绩 其二","author":"孔平仲","text":"半通官职万人才，卷蓄经纶未得开。\n鸾凤托巢虽枳棘，神仙定籍已蓬莱。\n但存漆室葵心在，莫学荆山玉泪哀。\n倚伏万端宁有定，塞翁失马尚归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和经父寄张绩 其一","author":"孔平仲","text":"解纵枭鸱啄凤凰，天心似此亦难详。\n但知斩马凭孤剑，岂为摧车避太行。\n得者折腰犹下列，失之垂翅合南翔。\n不如长揖尘埃去，同老逍遥物外乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼眠呈梦锡","author":"孔平仲","text":"百忙之际一閒身，更有高眠可诧君。\n春入四支浓似酒，风吹孤梦乱如云。\n诸生弦诵何妨静，满席图书不废勤。\n向晚欠伸徐出户，落花帘外自纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霁夜","author":"孔平仲","text":"寂历帘栊深夜明，睡回清梦戍墙铃。\n狂风送雨已何处，淡月笼云犹未醒。\n早有秋声随堕叶，独将凉意伴流萤。\n明朝准拟南轩望，洗出庐山万丈青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代小子广孙寄翁翁","author":"孔平仲","text":"爹爹来密州，再岁得两子。\n牙儿秀且厚，郑郑已生齿。\n翁翁尚未见，既见想欢喜。\n广孙读书多，写字辄两纸。\n三三足精神，大安能步履。\n翁翁虽旧识，伎俩非昔比。\n何时得团聚，尽使罗拜跪。\n婆婆到辇下，翁翁在省里。\n大婆八十五，寝膳近何似。\n爹爹与妳妳，无日不思尔。\n每到时节佳，或对饮食美。\n一一俱上心，归期当屈指。\n昨日又开炉，连天北风起。\n饮阑却萧条，举目数千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千秋岁","author":"孔平仲","text":"春风湖外。\n红杏花初退。\n孤馆静，愁肠碎。\n泪馀痕在枕，别久香销带。\n新睡起。\n小园戏蝶飞成对。\n惆怅人谁会。\n随处聊倾盖。\n情暂遣，心何在。\n锦书消息断，玉漏花阴改。\n迟日暮，仙山杳杳空云海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其三","author":"孔夷","text":"岁穷风雪飘零，望迷万里云垂冻。\n红绡碎剪，凝酥繁缀，烟深霜重。\n疏影沈波，暗香和月，横斜浮动。\n怅别来，欲把芳菲寄远，还羌管、吹三弄。\n寂寞玉人睡起，污残妆、不胜姣凤。\n盈盈山馆，纷纷客路，相思谁共。\n才与风流，赋称清艳，多情唯宋。\n算襄王，枉被梨花瘦损，又成春梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南浦 旅怀","author":"孔夷","text":"风悲画角，听单于、三弄落谯门。\n投宿骎骎征骑，飞雪满孤村。\n酒市渐闲灯火，正敲窗、乱叶舞纷纷。\n送数声惊雁，下离烟水，嘹唳度寒云。\n好在半胧溪月，到如今、无处不销魂。\n故国梅花归梦，愁损绿罗裙。\n为问暗香闲艳，也相思、万点付啼痕。\n算翠屏应是，两眉馀恨倚黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜馀春慢/选冠子","author":"孔夷","text":"弄月馀花，团风轻絮，露湿池塘春草。\n莺莺恋友，燕燕将雏，惆怅睡残清晓。\n还似初相见时，携手旗亭，酒香梅小。\n向登临长是，伤春滋味，泪弹多少。\n因甚却、轻许风流，终非长久，又说分飞烦恼。\n罗衣瘦损，绣被香消，那更乱红如扫。\n门外无穷路岐，天若有情，和天须老。\n念高唐归梦，凄凉何处，水流云绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七星岩","author":"孔延之","text":"隐安楼阁贯空嵌，绝顶磨霄凝翠岚。\n若到白云犹未半，凭君更上七星岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顶山寺","author":"孔延之","text":"高山峰顶欲参天，蓄怪储灵远近传。\n云岫万重围净土，石门千丈落飞泉。\n群居在昔论三益，少别于今已十年。\n绕槛穿云似蝴蝶，梦魂何夕不翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"孔延之","text":"天目远随双凤落，海门遥蹙两潮趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七里驿遇叶振卿秘校南归三首 其三","author":"孔武仲","text":"湘水秦山此路分，更持杯酒劝行人。\n马头便作天涯别，好到江南看早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]