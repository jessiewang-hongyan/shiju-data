[{"title":"题林户曹寒斋","author":"刘克庄","text":"举世争驰势利场，君于冷处看人忙。\n不营摩诘散花室，只设苏州听雨床。\n种果园林无虎守，勘书窗几有萤光。\n直须唤起西塘老，来向斋中伴石塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林文之诗卷二首 其二","author":"刘克庄","text":"君豪自合相推逊，吾老犹堪共切磋。\n有许奇奇并怪怪，直将少少胜多多。\n风人所作葩而正，治世之音乐以和。\n他日薰弦要赓载，勿为处士五噫歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林文之诗卷二首 其一","author":"刘克庄","text":"叔季词人杂雅哇，喜君诗卷美无瑕。\n朋侪却走避三舍，句律斩新成一家。\n肯学小儿烹虱胫，要看大手拔鲸牙。\n村翁岂敢持衡尺，直为痴年两倍加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林梦馨本朝杂咏","author":"刘克庄","text":"二百新题字四千，庚申已后甲寅前。\n继周可以知百世，续汉谁曾到八年。\n江左重修泰陵录，水心绝重建隆编。\n何时老子真闲退，共结青灯蠹简缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林琦友于轩","author":"刘克庄","text":"城中甲第连霄汉，吾子书窗占地悭。\n卧起大衾长枕共，呻吟细字短檠间。\n一门兄季推谌纪，北屋东西著孔颜。\n祗恐四方羔雁到，未容坚坐闭柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林璞经属平寇录","author":"刘克庄","text":"倏尔蜂窝起，俄然鼠首枭。\n果能歌竞病，不枉事票姚。\n瘴岭收氛祲，朝家赏烂焦。\n祝君深养勇，稍北有天骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题罗亨祖丛菊隐居","author":"刘克庄","text":"令君抱送当秋晚，手种寒葩占断清。\n伯始厚颜贪饮水，灵均满腹饱餐英。\n要须晚节分香臭，宁与朝华角悴荣。\n父老方夸琴调古，未应高兴慕渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郑宁文卷","author":"刘克庄","text":"昔侍西山讲习时，颇于函丈得精微。\n书如逐客犹遭绌，辞取横汾亦恐非。\n筝笛岂能谐雅乐，绮纨元未识深衣。\n嗟余老矣君方少，勤向师门扣指归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金华王山甫吟稿","author":"刘克庄","text":"载贽来相觅，挑灯读失惊。\n尊公王逸少，外祖郑康成。\n子壮堪传嫡，吾衰浪得名。\n江湖有公论，不必问钟嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题临江郭君季韩文卷","author":"刘克庄","text":"二刘三孔萧条久，直至君家擅俊声。\n挥麈旧曾参宿老，吹篪蚤合和诸兄。\n怪来度度观诗好，闻说人人有集行。\n欲荐子虚无气力，津亭折柳若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题洪使君诗卷","author":"刘克庄","text":"刻于芹泮士争披，传到茅庐我窃窥。\n突过韦郎森戟句，高如柳恽采蘋诗。\n日惟坐啸熏沉水，间亦摇毫品荔支。\n况有太丘为小序，遥知流布满京师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵上舍崇?诗卷","author":"刘克庄","text":"系出诸王后，名高胄子中。\n昔惟称八凯，今复有□□。\n疏可编遗史，诗宁论变风。\n所交皆胜彦，未必记衰翁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵与㑾贽卷","author":"刘克庄","text":"身已明农老一丘，屡空何以答珍投。\n新腔高处古乐府，警句当家小倚楼。\n此笔生花尤组丽，彼风吹箨漫轻浮。\n从前作者皆勤苦，萤雪功夫更讲求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵子固诗卷","author":"刘克庄","text":"紫芝仲白俱仙去，晚秀惟君擅士林。\n字肖率更亲手作，诗疑贾岛后身吟。\n九成合奏音方备，三染为纁色始深。\n老去尤于朋友笃，未忘几研琢磨心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵主簿省试议并以将行","author":"刘克庄","text":"世儒通易少，公子信人豪。\n几载韦编绝，三篇纸价高。\n素心鄙温饱，馀事及风骚。\n台阃招徕广，勾朱不足劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵西里诗卷二首 其二","author":"刘克庄","text":"不向莺边系宝鞍，海门东畔把鱼竿。\n无蒲萄酒博太守，有竹枝歌传小蛮。\n到处名山留屐齿，看来元气在毫端。\n绣娃辛苦描新样，肯信春风放牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵西里诗卷二首 其一","author":"刘克庄","text":"紫芝仲白飞仙去，常恐英才不复生。\n人叹斯文逢厄运，天留此老主齐盟。\n执鞭孰可为之御，序齿吾犹事以兄。\n未必时人能著价，后千百载话头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵别驾委斋","author":"刘克庄","text":"乍看华扁费寻思，徐叩微言极坦夷。\n无可奈何安命者，吾非恶此欲逃之。\n万羊赋禄渠前定，二鸟蒙恩彼一时。\n总被委斋参透了，不求符竹止求祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵志仁南溪双莲","author":"刘克庄","text":"乃翁去记玉楼成，岁帅乡人祀洛英。\n文耀可无田助祭，象贤赖有谷传声。\n奇葩融结双莲瑞，奕叶追攀五桂荣。\n累将重侯何足道，几人三世有诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵检察贽卷","author":"刘克庄","text":"福唐少尹平生友，函送王孙一卷诗。\n始信人间有龙种，又疑天上下麟儿。\n月须玉斧修成后，仙待金丹炼熟时。\n不是樗翁心有窍，镜中添雪到须眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题倪上人诗卷","author":"刘克庄","text":"故交岁晚各西东，解后斯人慰老穷。\n莫把冠巾浼澄观，更添须发恼林公。\n强牵谢客为禅客，闲伴涪翁作钓翁。\n行矣余方有公事，异时傥肯访山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题倪鲁玉诗后二首 其二","author":"刘克庄","text":"自从风雅陵夷后，吟到梅村世岂多。\n旷达知章归后作，轩昂予美醉时歌。\n击蒙何止闻童稚，谴疟犹堪去病魔。\n一听牙弦三叹息，今无钟子奈诗何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题倪鲁玉诗后二首 其一","author":"刘克庄","text":"梅经御史鞫成案，村荷先皇敕扁堂。\n少日不容人入社，暮年甘被子侵疆。\n不应愚谷知名姓，惟许孤山擅影香。\n岂独江湖酬唱者，卷中诸老半存亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题唐察院诗卷二首 其二","author":"刘克庄","text":"不见林夫与子方，坦翁健笔亦堂堂。\n孝诚亲有终身慕，忠爱君无一饭忘。\n铭座六章韦作佩，入台五字铁为肠。\n未应径欲投吟社，谏草长留御榻傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题唐察院诗卷二首 其一","author":"刘克庄","text":"细读公诗屡绝编，心知妙处口难传。\n言言箴儆堪垂世，历历行藏自谱年。\n但觉朱弦馀倡叹，不烦玉斧更雕镌。\n小儒可是通身胆，拟为坡仙注大全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题真继翁司令新居二首 其一 听雨楼","author":"刘克庄","text":"共极堂中听雨楼，谁知华扁有源流。\n追攀应物并和仲，友爱全真与子由。\n老监情尤钟冢嗣，放翁语亦本前修。\n文忠百世之标准，更向韦苏以上求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题真继翁司令新居二首 其二 格轩","author":"刘克庄","text":"招鹤山空衿佩散，至今复以格名轩。\n礼诗学已先传子，性理书犹密付孙。\n程氏必须通一件，申公云不在多言。\n侯芭老去头如雪，曾受吾师罔极恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题袁秘书文藁","author":"刘克庄","text":"场屋声名淳绍初，同时一辈晓星疏。\n举人尚记前乡贡，天子亦呼行秘书。\n出蜀诗堪编杜集，涉湘文可补骚馀。\n中朝典册须鸿笔，何必然藜照蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题晤上人诗卷","author":"刘克庄","text":"星星短发茁霜根，今后村非昔后村。\n无客雨中能裹饭，有僧月下忽敲门。\n佛为摩顶虽真觉，儒劝加巾亦格言。\n师不茹荤余止酒，何时煮茗得重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题梁抚干见一堂","author":"刘克庄","text":"勇归陶子元非矫，素懒嵇公每不堪。\n僧贺新堂初见一，友忻旧径再开三。\n渠侬去矣涯之北，此士佳哉斗以南。\n遮莫肯招房□客，老夫或可作同参。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题萧令山则文编二首 其二","author":"刘克庄","text":"咄咄人皆怪老夫，奈何此客去难呼。\n招温处士为罗否，待穆先生设醴无。\n我有青刍堪秣马，君言白发久占乌。\n人生蝉冕腰金印，未抵斑衣膝下娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题萧令山则文编二首 其一","author":"刘克庄","text":"茧纸银钩写一通，殷勤投赠愧空空。\n辙环晚乃交吾子，稛载天将富此翁。\n著论未容符独步，操琴欲与愈争雄。\n儿童错认眉间喜，疑有珠犀满箧中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄景文诗 其二","author":"刘克庄","text":"蚤穿草履行求友，晚闭柴荆病绝交。\n古德皆曾经棒喝，今人不肯事推敲。\n吟千万首等蛩响，续三百篇无凤胶。\n霍地鬓毛如雪色，少年岁月莫轻抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄景文诗 其一","author":"刘克庄","text":"病叟懒亲灯久矣，得君贽卷阖还开。\n专心致意刻成楮，有胆通身占断梅。\n中的孟云非尔力，钻坚颜叹竭吾才。\n旧时奇字今忘却，不是无人载酒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题福清薛明府太平禾图","author":"刘克庄","text":"闻说琴堂似水清，天公产瑞告西成。\n宛如唐叔称同颖，未羡相如诧一茎。\n岳牧定应图画进，朝家曷有玺书旌。\n侬诗社舞村歌尔，让紫薇郎作颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题端溪王使君诗卷","author":"刘克庄","text":"社友凋零雅道穷，使君于此信英雄。\n性情所发前无古，骚选虽高不必同。\n蚤日甫曾怀渭北，暮年丘只在家东。\n何时偃伯兴文治，尽采新吟献法宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题蔡烓主簿诗卷 其一","author":"刘克庄","text":"诗作平生祟，因而废不为。\n君豪频挑战，吾老怯交绥。\n哨骑来无定，纲船发尚迟。\n日长无职事，半是撚髭时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题蔡烓主簿诗卷 其二","author":"刘克庄","text":"旧止四人为律体，今通天下话头行。\n谁编宗派应添谱，要续传灯不记名。\n放子一头嗟我老，避君三舍与之平。\n由来作者皆攻苦，莫信人言七步成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题戴贡士诗卷","author":"刘克庄","text":"新吟亹亹来相逼，华胄遥遥请具陈。\n安道晋时名处士，叔伦唐世老诗人。\n百家衣莫劳针指，九转丹能蜕肉身。\n肯访柴门衰老叟，愧无薄具可留宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲤湖","author":"刘克庄","text":"凡是龙居处，皆难敌此泉。\n下穷源至海，上有穴通天。\n小派犹成瀑，低峰亦起烟。\n莫疑乘鲤事，能住即能仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"懒","author":"刘克庄","text":"向来乐此不为疲，太息龙钟迫耄期。\n鼓未挝三先就睡，书才数叶已停披。\n护篝妾喜烘衣晏，拂袖宾嗔倒屣迟。\n一事切身犹自力，扶衰抱瓮灌园葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"懒","author":"刘克庄","text":"病入中年百事阑，颓然一榻倦衣冠。\n客方接话俄辞起，书未终编已辍看。\n架坏尽教花卧藓，砌荒亦任草侵兰。\n力求香火非无意，疏散明知涉事难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠女学士","author":"刘克庄","text":"女子谈天世有之，福唐吴媛独神奇。\n语多中的疑明思，心自通灵不问龟。\n闻道膝边随季主，定传肘后与文姬。\n未知谁是吹笙侣，玉镜台前要画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠川郭","author":"刘克庄","text":"川郭颠狂甚，平生挟术游。\n老犹携侍女，贫不谄公侯。\n用药多投病，酬钱或掉头。\n金陵官酒贵，应典旧貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠天台陈相士","author":"刘克庄","text":"径草齐腰人迹稀，凌晨忽有叩柴扉。\n远携吾子出疆贽，来看先生杜德机。\n许燕颔侯行且验，评鸢肩夭是耶非。\n惜无斗酒堪浇汝，一曲劳歌赠北归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠天台通上人","author":"刘克庄","text":"老倦逢迎揖客稀，上人乃肯顾柴扉。\n愧无林下茶瓜待，忽有空中杖锡飞。\n师瘦能吟无本句，吾穷难赠大颠衣。\n此行不枉观南海，探得珊瑚满载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠天隐李君瑞一首","author":"刘克庄","text":"唱名纳禄尤崖异，誓墓休官更崛奇。\n先辈翔而皆集矣，广文得此欲逃之。\n圣门岂不高曾晰，列传何为首伯夷。\n虎帅听君谁敢犯，莫欺此老白须眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日者袁天勋","author":"刘克庄","text":"多识名公与钜卿，也携贽卷到柴荆。\n神巫未易觇壶子，太卜安能筮屈平。\n且喜天纲家有种，不忧日者传无名。\n村翁耄矣诗全退，同社诸人各善鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日者程士熙","author":"刘克庄","text":"竹溪满口相称说，韩慥林间一辈流。\n少不如人今已老，天之命我子难修。\n桑蓬壮志无成就，箕斗虚名有悔尤。\n试为端蓍占岁晚，几囤枣实几蹄牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠王月轩用意一韵","author":"刘克庄","text":"江湖少菰米，京洛足风尘。\n生命主穷鬼，赠诗多贵人。\n芒鞋双堠远，斗籴一家贫。\n吾力轻于羽，安能举百钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠风水僧","author":"刘克庄","text":"向人说葬又谈空，郭璞瞿昙并入宗。\n背得山经如诵咒，顶将禅笠去寻龙。\n遍为檀越裁生圹，预定公侯出某峰。\n想亦自营归寂处，一丘卵塔种青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠术者施元龙","author":"刘克庄","text":"信上多人物，华宗谱最蕃。\n遥遥忘世胄，仆仆傍谁门。\n眼毒偏奇中，心灵每预言。\n秃翁无阿堵，何以赠南辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠永福黄国孙","author":"刘克庄","text":"尚记鸣琴锦水滨，华宗赞府偶同寅。\n涉哦松笔规随我，传种花词脍炙人。\n潘令鬓毛两堆雪，崔丞诗赋一微尘。\n览君姓氏询乡里，旧事关心感慨频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠玉隆刘道士","author":"刘克庄","text":"观中曾访老黄冠，尔尚为童立醮坛。\n新染氅衣披得称，旧泥丹灶出来寒。\n诗非易作须勤读，琴亦难精莫废弹。\n忆上洪崖题瀑布，因游试为拂尘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠宇文贡士","author":"刘克庄","text":"君家忠节著先朝，庙院如今稍寂寥。\n晋代褒勋侯谢澹，唐人诏姓取颜标。\n地寒访我门罗爵，天定看君世珥貂。\n欲扫空斋同夜话，山荒黄独尚无苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠许登仕","author":"刘克庄","text":"蓬户无人来问疾，薇垣道汝妙通仙。\n此翁书眼真盲矣，之子心眸愈瞭然。\n预算粉郎将死日，能推绛老始生年。\n清漳守相方悬榻，应助君平卖卜钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠杨相士","author":"刘克庄","text":"西北功名奋发秋，南辕咄咄欲何求。\n似闻君识壶丘子，自笑吾非定远侯。\n鹓鹭行难看凫雁，麒麟阁不画猕猴。\n故人若问樗庵老，林下吟诗白却头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈起","author":"刘克庄","text":"陈侯生长纷华地，却以芸香自沐熏。\n鍊句岂非林处士，鬻书莫是穆参军。\n雨檐兀坐忘春去，雪案清谈至夜分。\n何日我闲君闭肆，扁舟同泛北山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠林信夫","author":"刘克庄","text":"昔日相师今画师，依然红颊映霜髭。\n懒为阅世青白眼，写出无声水墨诗。\n胸次九流人物镜，笔端三友岁寒枝。\n刺桐城里多豪贵，绝艺何忧不见知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠罗摄官","author":"刘克庄","text":"一梦端为文字祥，华宗复出小君章。\n无家来去如潮水，有鬼揶揄向路傍。\n肯顾雀罗殊郑重，欲为鸡黍愧荒凉。\n燕昭殁后金台少，僮瘦驴饥驿堠长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠施道州二首 其二","author":"刘克庄","text":"胡尘突过剑门关，西顾于今尚未宽。\n早晚相如通僰道，苍皇子美问长安。\n拮据自笑营巢拙，枘凿明知合辙难。\n纵有望乡楼百尺，淡烟衰草莫凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠施道州二首 其一","author":"刘克庄","text":"施先生学有源流，家自长安徙益州。\n畴昔建牙当一面，祇今失国托诸侯。\n身侨岳麓无生计，目断岷峨起暮愁。\n闻道汉廷须黼黻，蜀珍那得此淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠洪道人圆定","author":"刘克庄","text":"道人三昧力，手阅几岩砖。\n既用功追琢，何忧质得坚。\n玉因石攻美，月以斧修圆。\n非遇良工剖，陶泓不受镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠贵上人","author":"刘克庄","text":"贵公葬法妙蓍龟，眼力尤高异管窥。\n先世曾从牧堂学，前身疑是涅槃师。\n服寒食散方谁验，营土馒头计已迟。\n我卜寝丘将斩草，重来莫负老人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]