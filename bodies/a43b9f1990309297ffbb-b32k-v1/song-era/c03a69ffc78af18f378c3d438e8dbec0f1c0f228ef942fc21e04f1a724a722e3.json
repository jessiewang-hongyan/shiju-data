[{"title":"安阳好 九首并口号破子 其四","author":"王安中","text":"安阳好，泮水盛儒宫。\n金字照碑光射斗，芸香书阁势凌空。\n肃肃采芹风。\n来劝学，乡兖首文翁。\n岁岁青衿多振鹭，人人彩笔竞腾虹。\n九万奋飞同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安阳好 九首并口号破子 其五","author":"王安中","text":"安阳好，耆旧迹依然。\n醉白垂杨低掠水，延松高桧老参天。\n曾映两貂蝉。\n王谢族，兰玉秀当年。\n画隼朱轮人继踵，丹台碧落世多贤。\n簪绂看家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安阳好 九首并口号破子 其六","author":"王安中","text":"安阳好，负郭相君园。\n绿野移春花自老，平泉醒酒石空存。\n月馆对风轩。\n人选胜，幽径破苔痕。\n拥砌翠筠侵坐冷，穿亭玉溜落池喧。\n归意黯重门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安阳好 九首并口号破子 其七","author":"王安中","text":"安阳好，曲水似山阴。\n咽咽清泉岩溜细，弯弯碧甃篆痕深。\n永昼坐披襟。\n红袖小，歌扇画泥金。\n鸭绿波随双叶转，鹅黄酒到十分斟。\n重听绕梁音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安阳好 九首并口号破子 其八","author":"王安中","text":"安阳好，□□又翚飞。\n拨垄旋栽花密密，著行重接柳依依。\n鸳瓦荡晴辉。\n池面渺，相望是荣归。\n两世风流今可见，一门恩数古来稀。\n谁与赋缁衣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安阳好 九首并口号破子 其九","author":"王安中","text":"安阳好，千古邺台都。\n穗帐歌人春不见，金楼梦凤夜相呼。\n辇路旧萦纡。\n闲引望，漳水绕城隅。\n暗有渔樵收故物，谁将宫殿点新图。\n平野漫烟芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其四","author":"张继先","text":"西源好，岩馆凿松崖。\n五斗洞前斟玉斝，半酣窗外抚金杯。\n无累自悠哉。\n青翠色，玉竹自新栽。\n风到莫来摇老木，雨霖时复洗圆苔。\n如此恼诗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其五","author":"张继先","text":"西源好，春日日初长。\n不看人间三月景，常思天上万花香。\n幽赏一时狂。\n歌笑也，空洞大歌章。\n千景净来风谷秀，三云归后月林光。\n沉麝似兰香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其六","author":"张继先","text":"西源好，迎夏洒炎风。\n红锦石边怜一派，老张岩上恋群峰。\n时得化龙筇。\n琴振玉，晓色倚梧桐。\n黼黻文章朝内盛，山川林木野亭空。\n朱火焕明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其七","author":"张继先","text":"西源好，秋景道人怜。\n时至自然天气肃，夜凉犹喜月华圆。\n长啸碧崖颠。\n须信酒，难别咏歌边。\n是处伐薪为炭后，此时尝稻庆丰年。\n童子舞胎仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其八","author":"张继先","text":"西源好，冬日雪中松。\n携手石坛承爱景，静观天地入清宫。\n恰似大茅峰。\n襟袂冷，琴里意浓浓。\n吹月洞箫含碧玉，动人佳趣转黄钟。\n情绪发于中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其九","author":"张继先","text":"西源好，幽径不成斜。\n山谷隐连无改色，池塘空静默无瑕。\n人钓水之涯。\n仙舫小，人欲盼君家。\n归棹日回如览镜，放船星落似乘槎。\n风雨乱寒沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十","author":"张继先","text":"西源好，神洞自相求。\n傍水垦田流涧急，砍山开径小花浮。\n踪迹旧人留。\n忘万物，爽气白云收。\n司命暂曾寻寝静，紫阳真是步条幽。\n思继此公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十三","author":"张继先","text":"西源好，还向观庭西。\n扌弃晚菊明方丈外，傍寒梅放六花飞。\n三鹤会同时。\n清净宇，处一贵无为。\n戴月夜中仍是别，衔香原上不须迷。\n于此振衣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其三","author":"陈克","text":"深院静。\n尘暗曲房凄冷。\n黄叶满阶风不定。\n无端吹酒醒。\n露湿小园幽径。\n悄悄啼姑相应。\n半被馀熏残烛影。\n夜长人独冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月上海棠","author":"赵佶","text":"孟婆且与我、做些方便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"宋江","text":"自幼曾攻经史，长成亦有权谋。\n恰如猛虎卧荒丘。\n潜伏爪牙忍受。\n不幸刺文双颊，那堪配在江州。\n他年若得报冤仇。\n血染浔阳江口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"陈袭善","text":"江南二月。\n犹有枝头千点雪。\n邀上芳尊。\n却占东君一半春。\n尊前眼底。\n南国风光都在此。\n移过江来。\n从此江南不复开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十样花 其六","author":"李弥逊","text":"陌上风光浓处。\n自有花王为主。\n富艳压群芳，蜂蝶戏，燕莺语。\n东君都付与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春光好 其一","author":"张元干","text":"疏雨洗，细风吹。\n淡黄时。\n不分小亭芳草绿，映檐低。\n楼下十二层梯。\n日长影里莺啼。\n倚遍阑干看尽柳，忆腰肢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其四","author":"杨无咎","text":"钟陵好，家世仰仙卿。\n衣带不须藏贝叶，集贤何用化金瓶。\n且欲佐中兴。\n期早晚，丹诏下天庭。\n不许南州犹弭节，促归东府共和羹。\n膏泽遍寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"殢人娇 其二 曾韵寿词","author":"杨无咎","text":"露下天高，最是中秋景胜。\n喜银蟾、十分增晕。\n嫦娥飞下，见雾鬟风鬓。\n念八景园中，画谁能尽。\n慢奏云韶，美斟仙酝。\n清不寐、桂香成阵。\n只愁来夕，又阴晴无准。\n却待约重圆，后期难问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其二 咏十八香异香牡丹","author":"王十朋","text":"庭院深深，异香一片来天上。\n傲春迟放。\n百卉皆推让。\n忆昔西都，姚魏声名旺堪惆怅。\n醉翁何往。\n谁与花标榜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"番禺调笑 其一 羊仙","author":"洪适","text":"南土。\n贤铜虎。\n黄木湾头腾好语。\n骑羊执穗神仙五。\n拭目摩肩争睹。\n无双治行今犹古。\n嘉瑞流传乐府。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"番禺调笑 其二 药洲","author":"洪适","text":"寒食。\n人如织。\n藉草临流罗饮席。\n阳春有脚森双戟。\n和气欢声洋溢。\n洲边药灶成陈迹。\n九曜摩挲奇石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"番禺调笑 其七 蒲涧","author":"洪适","text":"佳节。\n初春月。\n飞盖倾城尊俎列。\n安期驾鹤朝金阙。\n丹灶分留岩穴。\n山中花笑秦皇拙。\n祠殿荒凉虚设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"番禺调笑 其十一 破子","author":"洪适","text":"南海。\n繁华最。\n城郭山川雄岭外。\n遗踪嘉话垂千载。\n竹帛班班俱在。\n元戎好古新声改。\n调笑花前分队。\n高会。\n尊罍对。\n笑眼茸茸回盼睐。\n蹋筵低唱眉弯黛。\n翔凤惊鸾多态。\n清风不用一钱买。\n醉客何妨倒载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句降黄龙舞 其一","author":"洪适","text":"伏以玳席接欢，杯滟东西之玉；锦茵唤舞，钗横十二之金。\n咸驻目于垂螺，将应声而曳茧。\n岂无本事，愿吐妍辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句降黄龙舞 其二 答","author":"洪适","text":"眄流席上，发水调于歌唇；色授裾边，属河东之才子。\n未满飞鹣之愿，已成别鹄之悲。\n折荷柄而愁缕无穷，剪鲛绡而泪珠难贯。\n因成绝唱，少相清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句降黄龙舞 其三 遣","author":"洪适","text":"情随杯酒滴郎心。\n不忍重开翡翠衾。\n封却软绡看锦水，水痕不似泪痕深。\n歌罢舞停，相将好去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句南吕薄媚舞 其一","author":"洪适","text":"羽觞棋布，洽主礼于良辰；翠袖弓弯，奏女妖之妍唱。\n游丝可倩，本事愿闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句南吕薄媚舞 其二 答","author":"洪适","text":"踏软尘之陌，倾一见于月肤；会采蘋之洲，迷千娇于雨梦。\n且蛾眉有伐性之戒，而狐媚无伤人之心。\n既吐艳于幽闺，能齐芳于节妇。\n果六尺之躯不庇其伉俪，非三寸之舌可脱于艰难。\n尚播遗声，得尘高会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句南吕薄媚舞 其三 遣","author":"洪适","text":"兽质人心冰雪肤。\n名齐节妇古来无。\n纤罗不蜕西州路，争得人知是艳狐。\n歌舞既阑，相将好去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其四","author":"张抡","text":"暖日迟迟，乱莺声在垂杨里。\n昼眠惊起。\n花影闲铺地。\n试问荣名，何似花前醉。\n陶陶地。\n任他门外。\n车驾喧朝市。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其五","author":"张抡","text":"花满名园，万红千翠交相映。\n昼阑幽径。\n行乐迷芳景。\n惟有幽人，不与浮华竞。\n便幽静。\n兴来独饮。\n花下风吹醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"张抡","text":"人间何处难忘酒。\n素秋令节逢重九。\n步屟绕东篱。\n金英烂漫时。\n折来惊岁晚。\n心与南山远。\n一盏此时休。\n高怀何以酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"张抡","text":"人间何处难忘酒。\n六花投隙琼瑶透。\n火满地炉红。\n萧萧屋角风。\n飘飖飞絮乱。\n浩荡银涛卷。\n一盏此时干。\n清吟可那寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"张抡","text":"人间何处难忘酒。\n山村野店清明后。\n满路野花红。\n一帘杨柳风。\n田家春最好。\n箫鼓村村闹。\n一盏此时辞。\n将何乐圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其九","author":"张抡","text":"人间何处难忘酒。\n兴来独步登岩岫。\n倚杖看云生。\n时闻流水声。\n山花明照眼。\n更有提壶劝。\n一盏此时斟。\n都忘名利心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十","author":"张抡","text":"人间何处难忘酒。\n水边石上逢山友。\n相约老山林。\n幽居不怕深。\n浮名心已尽。\n倾倒都无隐。\n一盏此时无。\n交情何以舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其八","author":"张抡","text":"澄神静虑。\n□□□□□□□。\n□□□□。\n□□□花水满池。\n无中养□。\n□□□□□□□。\n□□凡胎。\n五彩云生鹤驾来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑令 其四 博","author":"李吕","text":"花底。\n锦铺地。\n绣浪琼枝光似洗。\n一心长在金盆里。\n翠袖懒遮纤指。\n珠玑满斗犹慵起。\n过尽红楼春睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"陆游","text":"飞上锦茵红皱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 其一 葛守坐上出此词，道思归之意，走笔次其韵","author":"周必大","text":"报答风光，满倾琼液休思睡。\n乱莺声碎。\n来往甘棠底。\n闻道中和，深简君王意。\n归舟起。\n到时应是。\n玉殿槐交翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头","author":"范成大","text":"万里吴船泊，归访菊篱秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"□□□ 其一 闻鹃啼","author":"王质","text":"眼将穿，肠欲裂。\n声声似向春风说。\n春色飘零，自是人间客。\n不成泪，都成血。\n朝朝暮暮何曾歇。\n叫彻斜阳，又见空山月。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其三十八 三劝","author":"沈瀛","text":"酒巡未止。\n更号三般杨氏喜。\n上苑春风。\n宝带灵犀点点通。\n听歌侑酒。\n富贵两全添个寿。\n人少兼何。\n彭祖人言只寿多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其四十 五劝","author":"沈瀛","text":"酒巡未止。\n更说五行人听喜。\n康节淳风。\n说道诸公运数通。\n乞浆得酒。\n更检戊申前定寿。\n亥子推何。\n甲子生年四百多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其四十一 六劝","author":"沈瀛","text":"酒巡未止。\n鼓吹六经为公喜。\n也没回风。\n只有村中鼓数通。\n长须把酒。\n自当长头杯捧寿。\n问得穷何。\n一坐靴皮笑面多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其四十二 七劝","author":"沈瀛","text":"酒巡未止。\n且听七言余韵喜。\n弹到悲风。\n醒酒风吹路必通。\n休休避酒。\n末后茶仙来献寿。\n七碗休何。\n不独茶多酒亦多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"张孝祥","text":"误入蓬莱仙境，松风十里凄凉。\n众中仙子淡梳妆。\n瑶琴横膝上，一曲泛宫商。\n独步寂寥归去睡，月华冷淡高堂。\n觉来犹惜有馀香。\n有心归洛浦，无计梦襄王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"张孝祥","text":"脱却麻衣换绣裙。\n仙凡从此两俱分。\n蛾眉再画当时柳，蝉髻仍梳旧日云。\n施玉粉，点朱唇。\n星冠不戴貌超群。\n枕边一任潘郎爱。\n再也无心恋老君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"张孝祥","text":"半旧鞋儿着稳，重糊纸扇多风。\n隔年煮酒味偏浓。\n雨过樱桃色重。\n有距公鸡快，尾长山雉枭雄。\n烧残银烛焰头红。\n半老佳人可共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探春令 其十二","author":"赵长卿","text":"清江平淡，暗香潇洒，满林风露。\n渐枝上、也学杨花柳絮。\n轻逐春归去。\n东君著意勤遮护。\n总留他不住。\n幸西园别有，能言花貌，委曲关心愫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 浣花因赋","author":"京镗","text":"锦里先生，草堂筑、浣花溪上。\n料饱看、阶前雀食，篱边渔网。\n跨鹄骑鲸归去后，桥西潭北留佳赏。\n况依然、一曲抱村流，江痕涨。\n鱼龙戏，相浩荡。\n禽鸟乐，增舒畅。\n更绮罗十里，棹歌来往。\n上坐英贤今李郭，邦人应作仙舟想。\n但□呼、落日未西时，船休放。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其四","author":"石孝友","text":"风又雨。\n断送残春归去。\n人面桃花在何处。\n绿阴空满路。\n立马垂杨官渡。\n一寸柔肠缕。\n回首碧云迷洞府。\n杜鹃啼日暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其七","author":"赵师侠","text":"风雨半。\n春锁绿杨深院。\n幕浪不翻香穗卷。\n轻寒闲便面。\n归兴新来不浅。\n勾引闲愁撩乱。\n一枕春酲谁与管。\n晓莺惊梦断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 其二 谢人惠竹榻","author":"姜夔","text":"楚山修竹，自娟娟、不受人间袢暑。\n我醉欲眠伊伴我，一枕凉生如许。\n象齿为材，花藤作面，终是无真趣。\n梅风吹溽，此君直恁清苦。\n须信下榻殷勤，翛然成梦，梦与秋相遇。\n翠袖佳人来共看，漠漠风烟千亩。\n蕉叶窗纱，荷花池馆，别有留人处。\n此时归去，为君听尽秋雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"郭应祥","text":"秾李夭桃委路尘，太半成泥滓。\n只有海棠花，恰似杨妃醉。\n折向铜壶把烛看，且莫教渠睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"吴礼之","text":"我不成，心酸眼软。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后筵勾曲","author":"程珌","text":"天容不老，千龄已祝于尧年；地限无边，四海均闻于舜乐。\n至和一鼓，万象皆春。\n上侑清欢，后部献曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱用之","author":"程珌","text":"用之与程珌同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 王总领□□生日八月六日","author":"魏了翁","text":"轻露瀹残暑，哉魄拟初弦。\n天台万八千丈，中有紫霞仙。\n正理中枢旧武，却忆邻环昨梦，重上蜀青天。\n只守伯禽法，駉野万云烟。\n锦川星，郎位宿，又移躔。\n为无结辈十数，踏遍蜀山川。\n人识绍兴奉使，家有显谟科约，慧命得公传。\n从此造朝去，两地亦青毡。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其四","author":"卢祖皋","text":"深院静。\n隔叶鸣禽相应。\n金鸭云寒闲梦醒。\n转帘花月影。\n闲步碧阶香径。\n亸翠残红慵整。\n明日阴晴犹未定。\n试教移小艇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其四","author":"净圆","text":"娑婆苦，生老病无常。\n九窍腥臊流秽污，一包脓血贮皮囊。\n争弱又争强。\n随妄想，耽欲更荒唐。\n念佛看经云著相，破斋毁戒却无妨。\n只恐有阎王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其五","author":"净圆","text":"娑婆苦，终日走尘寰。\n不觉年光随逝水，那堪日白发换朱颜。\n六趣任循环。\n今与古，谁肯死前闲。\n危脆利名才入手，虚华财色便追攀。\n荣辱片时间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]