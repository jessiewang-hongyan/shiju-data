ice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪边月上二首 其二","author":"杨万里","text":"片子黄金饼，看来只管高。\n忽然落溪水，杂碎作银涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪边月上二首 其一","author":"杨万里","text":"正月十四夜，如何月便团。\n似知吾辈出，预借上元看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪边回望东园桃李","author":"杨万里","text":"看花不合在花间，外面看来锦一般。\n每一团花三丈许，红花团绕白花团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花二首 其二","author":"杨万里","text":"树如岩桂不胜低，花比素馨幽更奇。\n要作团栾小窠锦，春风不长出丛枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香花二首 其一","author":"杨万里","text":"织锦天孙矮作机，紫茸翻出白花枝。\n更将沈水浓薰却，日淡风微欲午时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起观山","author":"杨万里","text":"过雨前汀未可登，搴篷小散睡瞢腾。\n船头政好看山色，一点江风冷似冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起即事","author":"杨万里","text":"午时睡起忽心惊，一事关心太懒生。\n速摘荼糜薰白酒，不愁香重只愁轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"稚子弄冰","author":"杨万里","text":"稚子金盆脱晓冰，彩丝穿取当银钲。\n敲成玉磬穿林响，忽作玻瓈碎地声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筠庵晚睡三首 其三","author":"杨万里","text":"享了荷花上番香，却穿竹径百弓长。\n满园亭榭都参遍，祇有筠庵第一凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筠庵晚睡三首 其二","author":"杨万里","text":"一户元无白板遮，两窗新染藕丝纱。\n竹床品字排三只，睡杀山风醉杀霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筠庵晚睡三首 其一","author":"杨万里","text":"碧玉新篁翳洞天，绀珉方斛贮山泉。\n脱巾赤脚长松下，何处人间更有仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简陆务观史君编修二首 其二","author":"杨万里","text":"员外治中高帝孙，幕中何幸有诗人。\n主人不减西湖长，青眼无妨顾德麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简陆务观史君编修二首 其一","author":"杨万里","text":"闻道云间陆士龙，钓台绝顶啸清风。\n却将半掬催诗雨，洒入山村作岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲桃乾","author":"杨万里","text":"凉州博酒不胜痴，银汉乘槎领得归。\n玉骨瘦来无一把，向来马乳太轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲桥寓舍剧暑","author":"杨万里","text":"三岁都城寓远坊，今年一热古无双。\n夜来何处山村雨，凉到蒲桥桥北窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解舟上饶明晖阁前","author":"杨万里","text":"玉水风船擘岸开，一帆飞到雨花台。\n思量饶歙山溪路，梦里征行也莫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解舟铜陵望淮山白云二首 其二","author":"杨万里","text":"银城遮不尽淮山，许事何缘便达天。\n谁遣诗人强饶舌，和山失却忽苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解舟铜陵望淮山白云二首 其一","author":"杨万里","text":"天惜淮山不惜银，浑银砌起一长城。\n淮山裹在银城里，半出诸峰越样青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞满代者未至","author":"杨万里","text":"一麾来此恰三年，到得终更分外难。\n老眼看灯浑作晕，愁心得酒不成欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣骑问讯范明州参政报章寄二绝句和韵谢之 其一","author":"杨万里","text":"南海人从东海归，新诗到日恰梅时。\n撚梅细比新诗看，未必梅花瘦似诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣骑问讯范明州参政报章寄二绝句和韵谢之 其二","author":"杨万里","text":"一别姑苏江上台，绿波碧草恨悠哉。\n忽然两袖珠玑满，割取三吴风月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬阁皂山碧崖道士甘叔怀赠美名人不及佳句法如何十古风二首 其二","author":"杨万里","text":"赠我新诗字字奇，一奁八百颗珠玑。\n问侬佳句如何法，无法无盂也没衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]