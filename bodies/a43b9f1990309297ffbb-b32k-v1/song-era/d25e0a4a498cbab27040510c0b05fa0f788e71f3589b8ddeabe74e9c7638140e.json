4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锁宿省中心气大作通昔不寐得两绝句 其二","author":"杨万里","text":"绝恨诗人浪许痴，四更无睡只哦诗。\n老铃枕手眠窗底，急雨颠风总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锁宿省中心气大作通昔不寐得两绝句 其一","author":"杨万里","text":"酒病春愁恰并来，更冲花信宿鸾台。\n睡乡堠子无三里，玉漏声声只唤回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隔岸","author":"杨万里","text":"隔岸淮南树，中流渡北人。\n数来无急务，一数一回新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹅鼻铺前桃花","author":"杨万里","text":"归来长恐已春迟，恰是东风二月时。\n路上桃花亦欢喜，为人浓抹湿燕支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塘闸","author":"杨万里","text":"山逢塘闸冠南中，小大高低十九峰。\n东畔连尖尤秀绝，一双铜绿翠铺茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"微雨","author":"杨万里","text":"要知微雨密还疏，空里看来直是无。\n不被波间三两点，阿谁见破妙工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","po