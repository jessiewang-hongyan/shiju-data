[{"title":"古镜铭","author":"释慧方","text":"有古菱花，物来斯现。\n演若倍瞻，仰山亲荐。\n迷悟虽殊，寒光不变。\n恶像弗祛，丽质奚羡。\n历照千差，肯随物转。\n觑破前尘，是谁对面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和灵源和尚善护颂","author":"释慧方","text":"灵性包群象，千年寿最优。\n既知身是幻，何用壳埋头。\n护惜虽深固，推迁已密流。\n大随鞋盖处，若个辨踪由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送禅人化缘转藏","author":"释慧方","text":"经头以字孰能测，举起分明好消息。\n劳生未晓直截机，双林大士运神力。\n括囊五教妙全提，高张八面真奇特。\n汝行如是化檀那，推转机关超奥域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送化士","author":"释慧方","text":"青春条风至，无情阐化机。\n法本自何来，要当探极微。\n只在红尘中，忽见胜珠玑。\n虽然皆旧物，争奈昔人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人呈雪窦顶相求赞","author":"释慧方","text":"勘破北塔归来，接得铁佛即透。\n分明觌面全彰，不可唤作雪窦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写余真求赞 其一","author":"释慧方","text":"打破直要坐禅，佛祖亦须超越。\n若言祇这便是，大似水中捉月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写余真求赞 其二","author":"释慧方","text":"古松怪石，全体是我。\n若谓一如，莫教话堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释祖秀","text":"枯木岩前夜放华，铁牛依旧卧烟沙。\n侬家鞭影重拈出，一念回心便到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自像赞","author":"释齐谧","text":"个汉灰头土面，寻常不欲露现。\n而今写出人前，大似虚空著箭。\n怨怨，可惜人间三尺绢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题佛鉴禅师语录后","author":"释慧古","text":"流水高山不在弦，等闲成曲又成篇。\n列珊瑚树枝枝好，撒水银珠颗颗圆。\n挥落禅关无少滞，增添衲子几重冤。\n拟于纸上明端的，争似当机自造玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咨叩有省呈黄龙清禅师偈","author":"戴道纯","text":"杳冥源底全机处，一片心花露印纹。\n知是几生曾供养，时时微笑动香云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释咸静","text":"气候欲流金，炎威将铄石。\n扇子摇明月，云片耸奇峰。\n蚕成茧而麦渐收，笋抽簪而梅已熟。\n薰风习习，逝水滔滔。\n鹊噪森松，莺啼修竹。\n观音势至，文殊普贤。\n有愿必从，无刹不现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释咸静","text":"匣中宝剑，袖里金锤。\n时节既彰，莫辞拈出。\n击开关锁，斩断葛藤。\n令他跳出生死门，惊过荆棘路。\n人人似生师子，个个如活大虫。\n休教著布过他州，直待还乡衣昼锦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈","author":"释咸静","text":"弄罢影戏，七十一载。\n更问如何，回来别赛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一 勘婆二","author":"释咸静","text":"婆子只知指路，鸡犬被人偷去。\n直待赵州勘了，这回紧闭门户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二 勘婆二","author":"释咸静","text":"赵州老老大大，不解山中打坐。\n自言去勘婆了，倒被婆子勘破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 犀牛扇","author":"释咸静","text":"扇上犀牛从古画，索来既破要元牛。\n纵教戴子重描出，不是当时那一头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 四不迁","author":"释咸静","text":"掐珠不念佛，开眼不见色。\n吃饭谁择日，任东西南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其一","author":"释咸静","text":"多见拟寒山，不然拟拾得。\n冲天各有志，拟彼复何益。\n居山山色翠，临水水声长。\n风华与雪月，时处自歌扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其二","author":"释咸静","text":"颇忆未参禅，教中听十年。\n昼夜数他宝，何曾得半钱。\n发志出行脚，遍求无病药。\n及至休歇时，依旧没鞋著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其三","author":"释咸静","text":"行时唯信脚，到处便为家。\n午饭随粗细，三衣乱掩遮。\n空名耳里水，微利眼中砂。\n一觉黄昏睡，金鸟出■涯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其四","author":"释咸静","text":"目述自高吟，自高非倨傲。\n高怀肯随动，幽鸟徒轻噪。\n无水定无源，有烟必有灶。\n天堂并地狱，自作还自报。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其五","author":"释咸静","text":"近见一般人，堂堂似佛祖。\n入室求知识，为明生死事。\n问汝莫是贼，当时面如土。\n语言勿生嗔，只个是生死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其六","author":"释咸静","text":"参禅脱生死，辄莫被魔使。\n八风一任吹，六尘终不污。\n非语乱如麻，截断众流句。\n仰面看青天，立地超佛祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其七","author":"释咸静","text":"五更一盂粥，辰时一顿饭。\n昼夜两觉眠，一日事俱辨。\n毁我还自毁，赞我还自赞。\n是非与荣辱，红炉赤金弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其八","author":"释咸静","text":"良田著力耕，自利复利故。\n莫栽荆棘树，子孙没出路。\n仁者爱安仁，狡佞生嫉妒。\n劝汝早回头，翻覆面前觑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其九","author":"释咸静","text":"莫笑我自述，粗言无义理。\n岂为骋文辞，因笔写其志。\n百年呼吸间，何用苦较计。\n劝汝莫痴毒，无常忽忽至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟寒山自述 其十","author":"释咸静","text":"一曲乐升平，非关啰哩棱。\n山河俱属宋，云水且饶僧。\n时击松风磬，长然涧月灯。\n愿王似南岳，万世碧层层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其一","author":"释咸静","text":"半夜子，心境俱忘正莽卤。\n撚转天关万象移，泥牛入海谁亲睹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其二","author":"释咸静","text":"鸡鸣丑，一声相报无前后。\n惊觉腾腾梦里身，释迦老子交横走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其三","author":"释咸静","text":"平旦寅，翠竹黄华拂眼明。\n灵禽异兽争嘲哄，总解回头转眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其四","author":"释咸静","text":"日出卯，紫雾红霞腾海岛。\n挤排无限利名人，出门忘却衣中宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其五","author":"释咸静","text":"食时辰，掌钵徒劳入市巡。\n若将心受檀那饭，也似无功食禄人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其六","author":"释咸静","text":"禺中巳，选甚淫坊并酒肆。\n回头便是出尘人，翻笑曼殊携庆喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其七","author":"释咸静","text":"日南午，卓然独耀无今古。\n粪埽堆头玉马嘶，琉璃殿上金刚舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其八","author":"释咸静","text":"日昳未，万树千峰影斜坠。\n兔角龟毛绕市寻，贵卖还思买时贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其九","author":"释咸静","text":"晡时申，一日三分过二分。\n直饶省得来时路，到家急急也黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其十","author":"释咸静","text":"日入酉，残霞返照门前柳。\n无声一曲牧童归，背跨牛儿师子吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其十一","author":"释咸静","text":"黄昏戌，角韵钟声遐迩一。\n要会闻复翳根除，补陀岩上寻弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时 其十二","author":"释咸静","text":"人定亥，念念无常刹那快。\n回光省取不迁心，坐照十虚谁对待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拄杖歌","author":"释咸静","text":"谁人无一条拄杖，我家收底丑模样。\n彻头彻尾节目深，从生至老筋骸壮。\n不须修，何须漆，体段自然成个格。\n或行或坐尽随身，或倚或携还任力。\n抛一抛，卓一卓，三界魔王顿惊愕。\n雨云雷电匝长空，展尽神通难揣摸。\n有时收，有时用，纵夺临机恣拈弄。\n傥蒙上士入门来，一棒打教知痒痛。\n说道理，没人情，动著教伊祸患生。\n休誇昔日化龙势，谩说当年解虎声。\n挑日月，吞乾坤，划开一路涅槃门。\n大丈夫儿须执捉，一言不契命难存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其一","author":"释本才","text":"上封一句，海墨难诠。\n墙壁瓦砾，昼夜流传。\n若住听瑩，鹞子冲天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其二","author":"释本才","text":"当阳不显迹，文彩未生前。\n只个平常处，壶中别是天。\n别是天，唯自到，缓行急行俱蹉过。\n红尘数尽去来人，李白元是痴措大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其三","author":"释本才","text":"色本殊质像，声元异乐苦。\n眼耳绝见闻，半夜日轮午。\n日输午，与谁说，休向虚空重钉橛。\n烱烱森罗相对看，如净琉璃含宝月。\n无智人前莫说，打汝头破脑裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其四","author":"释本才","text":"二由一有，一亦莫守。\n拂子朝到西天，暮归唐土。\n也无佛，也无祖，夜半日输正当午。\n露柱灯笼?著时，谁道黄金如粪土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其五","author":"释本才","text":"清机历掌，同道方知，格外称提。\n徒劳陷啄，句中有句。\n埋没已灵，句中无句。\n藏身北斗，拈灯笼向佛殿里。\n即且置将三门来，灯笼上又作么生。\n自是觑不见，刚道有遮护。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其六","author":"释本才","text":"智身迥出先天地，大用纵横不易知。\n鼓舞灵源宣众妙，人间天上仰无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其七","author":"释本才","text":"鸡鸣丑，一颗圆光明已久。\n忽然抖擞起来时，问著依前还漏逗。\n还漏逗，拟欲藏身北斗前，应须合掌南辰后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其八","author":"释本才","text":"三界无法，何处求心。\n四大本空，佛依何住。\n直得清寥寥白滴滴，犹是真常流注。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其九","author":"释本才","text":"上无攀仰，下绝已躬。\n唤起怀州牛吃禾，捺下益州马腹胀。\n从教天下觅医人，炙猪左膊上。\n奇，奇，是是非非总不知。\n梦回瞥起临明镜，洎被张公错画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十","author":"释本才","text":"诸佛放光明，助发真实相。\n希有诸比丘，是中无比况。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十一","author":"释本才","text":"袖里暂闲医国手，岸巾来访卧云人。\n相逢一笑千峰顶，高下森罗百亿身。\n相逢一笑，万壑风清。\n大冶精金，应无变色。\n黄檗昔遇裴相国，当头一劄，冷暖自知。\n睦州久契陈尚书，剖露肝肠，清虚廓落。\n正当今日，宾主互换。\n觌体唱酬，似空藏空，如镜照镜。\n芥子拈来敲石窟，须知渠是个中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十二","author":"释本才","text":"画饼不足以充饥，大羹必资于敏手。\n净瓶趯倒，目前赢得大沩山。\n铁钵擎来，八万毛孔皆香发。\n口吞三世即且置，铁牛不食连鞭草。\n机梭不犯风云势，石笋从教劫外抽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十三","author":"释本才","text":"秋风浩浩来，芙蓉花半开。\n秋风萧萧去，黄叶填山路。\n大块本无私，恩威各有遇。\n藏头白海头黑，明眼衲僧辨不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一 达磨见梁武帝。","author":"释本才","text":"远泛鲸波入大梁，廓然无圣对君王。\n可怜径寸无人鉴，却与相如依旧藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二 宝寿开堂，三圣推出一僧。","author":"释本才","text":"丰城收宝剑，宇宙识人稀。\n不入张华手，焉能别是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释本才","text":"达磨未来，怀藏至宝，顶髻有珠。\n达磨既来，卞和刖足，杨朱途穷。\n拟议之间，知君罔措。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释本才","text":"一法有形该动植，百川湍激竞朝宗。\n昭琴不鼓云天淡，想像毗耶老病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一 风幡。","author":"释本才","text":"指出风幡俱不是，直言心动亦还非。\n夜来一片曹溪月，却照侬家旧翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二 大禅佛参仰山后到霍山。","author":"释本才","text":"子陵滩水急如弦，摸得黄鱼缩项鳊。\n提向市中频索价，他家不著半分钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释本才","text":"彻，彻，大海乾枯，虚空迸裂。\n四方八面绝遮拦，万象森罗齐漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释本才","text":"一法有形该动植，百川湍激竞朝宗。\n昭琴不鼓云天淡，想像毗耶老病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释空","text":"十方无壁落，四面亦无门。\n净裸裸，赤洒洒，没可把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野狐话颂","author":"释空","text":"含血噀人，先污其口。\n百丈野狐，失头狂走。\n蓦地唤回，打个筋斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 柏树。","author":"释空","text":"打人骂人易，劝人休却难。\n不识饶人处，急水下高滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太平曲","author":"释普初","text":"无为而为，神而化之。\n洒德雨以霶霈，鼓仁风而雍熙。\n民如野鹿，上如标枝。\n十八子，知不知。\n哩哩啰，啰啰哩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释从密","text":"开口不是禅，合口不是道。\n踏步拟进前，全身落荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释宗密","text":"休把庭华类此身，庭华落后更逢春。\n此身一往知何处，三界茫茫愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"知和庵主","text":"竹笕二三升野水，松窗七五片闲云。\n道人活计祇如此，留与人间作见闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝积寺","author":"刘芑","text":"宝积重来异昔年，修廊千步辟山边。\n南分灵派渠行玉，北敞高台花雨天。\n日照青林犹带润，云收翠崦尚藏烟。\n庞眉老子升猊坐，不惜家风示众贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释普崇","text":"非风非幡无处著，是风是幡无著处。\n辽天俊鹘悉迷踪，踞地金毛还失措。\n呵呵呵，悟不悟。\n令人转忆谢三郎，一丝独钓寒江雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬普首座偈","author":"释持","text":"性空老人何快活，只有三衣并一钵。\n丛林端的死心儿，见胆开谈心豁豁。\n有时吹笛当言说，一声吹落西江月。\n桃花庵中快活时，往往观者舞不彻。\n甚道理，能欢悦，摇手向人应道别。\n堪笑无人知此意，尽道称锤硬似铁。\n难瞒唯有当行家，为报临机莫漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]