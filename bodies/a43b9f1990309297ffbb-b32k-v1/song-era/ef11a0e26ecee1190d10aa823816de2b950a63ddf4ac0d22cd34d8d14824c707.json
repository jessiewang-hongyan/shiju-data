[{"title":"失调名","author":"黄庭坚","text":"直须把、茱萸遍插，看满座、细嗅清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名 其一","author":"黄庭坚","text":"屋角数声鸦噪柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名 其二","author":"黄庭坚","text":"旧家杨柳依依绿，长锁春来庭院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归田乐引/归田乐 其二","author":"黄庭坚","text":"对景还销瘦。\n被个人、把人调戏，我也心儿有。\n忆我又唤我，见我嗔我，天甚教人怎生受。\n看承幸厮勾。\n又是尊前眉峰皱。\n是人惊怪，冤我忒撋就。\n拼了又舍了，定是这回休了，及至相逢又依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归田乐引/归田乐 其一","author":"黄庭坚","text":"暮雨濛阶砌。\n漏渐移、转添寂寞，点点心如碎。\n怨你又恋你。\n恨你惜你。\n毕竟教人怎生是。\n前欢算未已。\n奈向如今愁无计。\n为伊聪俊，销得人憔悴。\n这里诮睡里。\n梦里心里。\n一向无言但垂泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归田乐令/归田乐 其三","author":"黄庭坚","text":"引调得、甚今日心肠不恋家。\n宁宁地、思量他，思量他。\n两情各自肯，甚忙咱。\n意思里、莫是赚人唦。\n噷奴真个、共人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好女儿 其二","author":"黄庭坚","text":"粉泪一行行。\n啼破晓来妆。\n懒系酥胸罗带，羞见绣鸳鸯。\n拟待不思量。\n怎奈向、目下恓惶。\n假饶来后，教人见了，却去何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好女儿 其一","author":"黄庭坚","text":"春去几时还。\n问桃李无言。\n燕子归栖风劲，梨雪乱西园。\n唯有月婵娟。\n似人人、难近如天。\n愿教清影常相见，更乞取团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其二 太平州小妓杨姝弹琴送酒","author":"黄庭坚","text":"一弄醒心弦，情在两山斜叠。\n弹到古人愁处，有真珠承睫。\n使君来去本无心，休泪界红颊。\n自恨老来憎酒，负十分金叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其三","author":"黄庭坚","text":"不见片时霎，魂梦镇相随著。\n因甚近新无据，误窃香深约。\n思量模样忔憎儿，恶又怎生恶。\n终待共伊相见，与佯佯奚落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其一 汤词","author":"黄庭坚","text":"歌罢酒阑时，潇洒座中风色。\n主礼到君须尽，奈宾朋南北。\n暂时分散总寻常，难堪久离拆。\n不似建溪春草，解留连佳客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 橄榄","author":"黄庭坚","text":"潇洒荐冰盘，满座暗惊香集。\n久后一般风味，问几人知得。\n画堂饮散已归来，清润转更惜。\n留取酒醒时候，助茗瓯春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 其二","author":"黄庭坚","text":"新来曾被眼奚搐。\n不甘伏。\n怎拘束。\n似梦还真，烦乱损心曲。\n见面暂时还不见，看不足、惜不足。\n不成欢笑不成哭。\n戏人目。\n远山蹙。\n有分看伊，无分共伊宿。\n一贯一文跷十贯，千不足、万不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 其一 忆别","author":"黄庭坚","text":"画堂高会酒阑珊。\n倚栏干。\n霎时间。\n千里关山，常恨见伊难。\n及至而今相见了，依旧似、隔关山。\n倩人传语问平安。\n省愁烦。\n泪休弹。\n哭损眼儿，不似旧时单。\n寻得石榴双叶子，凭寄与、插云鬖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"黄庭坚","text":"月侧金盆堕水，雁回醉墨书空。\n君诗秀色雨园葱。\n想见衲衣寒拥。\n蚁穴梦魂人世，杨花踪迹风中。\n莫将社燕等秋鸿。\n处处春山翠重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 用惠洪韵","author":"黄庭坚","text":"细细风清撼竹，迟迟日暖开花。\n香帏深卧醉人家。\n媚语娇声娅姹。\n姹娅声娇语媚，家人醉卧深帏。\n香花开暖日迟迟。\n竹撼清风细细。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 老夫既戒酒不饮，遇宴集，独醒其旁。坐客欲得小词，援笔为赋。","author":"黄庭坚","text":"断送一生惟有，破除万事无过。\n远山横黛蘸秋波。\n不饮旁人笑我。\n花病等闲瘦弱，春愁没处遮拦。\n杯行到手莫留残。\n不道月斜人散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 茶","author":"黄庭坚","text":"龙焙头纲春早，谷帘第一泉香。\n已醺浮蚁嫩鹅黄。\n想见翻成雪浪。\n兔褐金丝宝碗，松风蟹眼新汤。\n无因更发次公狂。\n甘露来从仙掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"黄庭坚","text":"宋玉短墙东畔，桃源落日西斜。\n浓妆下著绣帘遮。\n鼓笛相催清夜。\n转眄惊翻长袖，低徊细踏红靴。\n舞馀犹颤满头花。\n娇学男儿拜谢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其五","author":"黄庭坚","text":"贫家春到也骚骚。\n琼浆注小槽。\n老夫不出长蓬蒿。\n邻墙开碧桃。\n木芍药，品题高。\n一枝烦剪刀。\n传杯犹似少年豪。\n醉红浸雪毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其四","author":"黄庭坚","text":"退红衫子乱蜂儿。\n衣宽只为伊。\n为伊去得忒多时。\n教人直是疑。\n长睡晚，理妆迟。\n愁多懒画眉。\n夜来算得有归期。\n灯花则甚知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其三 茶词","author":"黄庭坚","text":"摘山初制小龙团。\n色和香味全。\n碾声初断夜将阑。\n烹时鹤避烟。\n消滞思，解尘烦。\n金瓯雪浪翻。\n只愁啜罢水流天。\n馀清搅夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其一 曾敷文既眄陈湘，歌舞便出其类，学书亦进。来求小楷，作阮郎词付之","author":"黄庭坚","text":"盈盈娇女似罗敷。\n湘江明月珠。\n起来绾髻又重梳。\n弄妆仍学书。\n歌调态，舞工夫。\n湖南都不如。\n它年未厌白髭须。\n同舟归五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其一","author":"黄庭坚","text":"黔中桃李可寻芳。\n摘茶人自忙。\n月团犀胯斗圆方。\n研膏入焙香。\n青箬裹，绛纱囊。\n品高闻外江。\n酒阑传碗舞红裳。\n都濡春味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其二 效福唐独木桥体作茶词","author":"黄庭坚","text":"烹茶留客驻金鞍。\n月斜窗外山。\n别郎容易见郎难。\n有人思远山。\n归去后，忆前欢。\n画屏金博山。\n一杯春露莫留残。\n与郎扶玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"两同心 其一","author":"黄庭坚","text":"巧笑眉颦。\n行步精神。\n隐隐似、朝云行雨，弓弓样、罗袜生尘。\n尊前见，玉槛雕笼，堪爱难亲。\n自言家住天津。\n生小从人。\n恐舞罢、随风飞去，顾阿母、教窣珠裙。\n从今去，唯愿银缸，莫照离尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"两同心 其三","author":"黄庭坚","text":"秋水遥岑。\n妆淡情深。\n尽道教、心坚穿石，更说甚、官不容针。\n霎时间，雨散云归，无处追寻。\n小楼朱阁沈沈。\n一笑千金。\n你共人、女边著子，争知我、门里挑心。\n最难忘，小院回廊，月影花阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"两同心 其二","author":"黄庭坚","text":"一笑千金。\n越样情深。\n曾共结、合欢罗带，终愿效、比翼纹禽。\n许多时，灵利惺惺，蓦地昏沈。\n自从官不容针。\n直至而今。\n你共人、女边著子，争知我、门里挑心。\n记携手，小院回廊，月影花阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 馀甘汤","author":"黄庭坚","text":"庵摩勒，西土果。\n霜后明珠颗颗。\n凭玉兔，捣香尘。\n称为席上珍。\n号馀甘，争奈苦。\n临上马时分付。\n管回味，却思量。\n忠言君试尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子","author":"黄庭坚","text":"体妖娆，鬟婀娜。\n玉甲银筝照座。\n危柱促，曲声残。\n王孙带笑看。\n休休休，莫莫莫。\n愁拨个丝中索。\n了了了，玄玄玄。\n山僧无碗禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步蟾宫 妓女","author":"黄庭坚","text":"虫儿真个忒灵利。\n恼乱得、道人眼起。\n醉归来、恰似出桃源，但目送、落花流水。\n何妨随我归云际。\n共作个、住山活计。\n照清溪，匀粉面，插山花，也须胜、风尘气味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春","author":"黄庭坚","text":"把我身心，为伊烦恼，算天便知。\n恨一回相见，百方作计，未能偎倚，早觅东西。\n镜里拈花，水中捉月，觑著无由得近伊。\n添憔悴，镇花销翠减，玉瘦香肌。\n奴儿。\n又有行期。\n你去即无妨我共谁。\n向眼前常见，心犹未足，怎生禁得，真个分离。\n地角天涯，我随君去。\n掘井为盟无改移。\n君须是，做些儿相度，莫待临时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其一","author":"黄庭坚","text":"小桃灼灼柳鬖鬖。\n春色满江南。\n雨晴风暖烟淡，天气正醺酣。\n山泼黛，水挼蓝。\n翠相搀。\n歌楼酒旆，故故招人，权典青衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其二","author":"黄庭坚","text":"旋揎玉指著红靴。\n宛宛斗弯讹。\n天然自有殊态，供愁黛、不须多。\n分远岫，压横波。\n妙难过。\n自敧枕处，独倚阑时，不奈颦何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 在戎州登临胜景，未尝不歌渔父家风，以谢江山。门生请问：先生家风如何？为拟金华道人作此章","author":"黄庭坚","text":"一波才动万波随。\n蓑笠一钩丝。\n锦鳞正在深处，千尺也须垂。\n吞又吐，信还疑。\n上钩迟。\n水寒江静，满目青山，载月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其三 荔枝","author":"黄庭坚","text":"晚岁监州闻荔枝。\n赤英垂坠压阑枝。\n万里来逢芳意歇。\n愁绝。\n满盘空忆去年时。\n涧草山花光照坐。\n春过。\n等闲桃李又累累。\n辜负寒泉浸红皱。\n消瘦。\n有人花病损香肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其一","author":"黄庭坚","text":"把酒花前欲问溪。\n问溪何事晚声悲。\n名利往来人尽老。\n谁道。\n溪声今古有休时。\n且共玉人斟玉醑。\n休诉。\n笙歌一曲黛眉低。\n情似长溪长不断。\n君看。\n水声东去月轮西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其一 次高左藏韵","author":"黄庭坚","text":"自断此生休问天。\n白头波上泛孤船。\n老去文章无气味。\n憔悴。\n不堪驱使菊花前。\n闻道使君携将吏。\n高会。\n参军吹帽晚风颠。\n千骑插花秋色暮。\n归去。\n翠娥扶入醉时肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其三","author":"黄庭坚","text":"上客休辞酒浅深。\n素儿歌里细听沈。\n粉面不须歌扇掩，闲静，一声一字总关心。\n花外黄鹂能密语。\n休诉。\n有花能得几时斟。\n画作远山临碧水。\n明媚。\n梦为胡蝶去登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其四 客有两新鬟善歌者，请作送汤曲，因戏前二物","author":"黄庭坚","text":"歌舞阑珊退晚妆。\n主人情重更留汤。\n冠帽斜敧辞醉去，邀定，玉人纤手自磨香。\n又得尊前聊笑语。\n如许。\n短歌宜舞小红裳。\n宝马促归朱户闭。\n人睡。\n夜来应恨月侵床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其四","author":"黄庭坚","text":"准拟阶前摘荔枝。\n今年歇尽去年枝。\n莫是春光厮料理。\n无比。\n譬如痎疟有休时。\n碧甃朱阑情不浅。\n何晚。\n来年枝上报累累。\n雨后园林坐清影。\n苏醒。\n红裳剥尽看香肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其二","author":"黄庭坚","text":"小院难图云雨期。\n幽欢浑待赏花时。\n到得春来君却去。\n相误。\n不须言语泪双垂。\n密约尊前难嘱付。\n偷顾。\n手搓金橘敛双眉。\n庭榭清风明月媚。\n须记。\n归时莫待杏花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其二 次高左藏使君韵","author":"黄庭坚","text":"万里黔中一漏天。\n屋居终日似乘船。\n及至重阳天也霁。\n催醉。\n鬼门关外蜀江前。\n莫笑老翁犹气岸。\n君看。\n几人黄菊上华颠。\n戏马台南追两谢。\n驰射。\n风流犹拍古人肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"黄庭坚","text":"断虹霁雨，净秋空，山染修眉新绿。\n桂影扶疏，谁便道，今夕清辉不足。\n万里青天，姮娥何处，驾此一轮玉。\n寒光零乱，为谁遍照醽醁。\n年少从我追游，晚凉幽径，绕张园森木。\n共倒金荷家万里，难得尊前相属。\n老子平生，江南江北，最爱临风曲。\n孙郎微笑，坐来声喷霜竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拨棹子 退居","author":"黄庭坚","text":"归去来。\n归去来。\n携手旧山归去来。\n有人共、月对尊罍。\n横一琴，甚处不逍遥自在。\n闲世界。\n无利害。\n何必向、世间甘幻爱。\n与君钓、晚烟寒濑。\n蒸白鱼稻饭，溪童供笋菜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河传 有士大夫家歌秦少游“瘦杀人、天不管” 之曲。以好字易瘦字，戏为之作","author":"黄庭坚","text":"心情老懒。\n对歌对舞，犹是当时眼。\n巧笑靓妆，近我衰容华鬓。\n似扶著、卖卜算。\n思量好个当年见。\n催酒催更，只怕归期短。\n饮散灯稀，背销落花深院。\n好杀人、天不管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"画堂春 其二","author":"黄庭坚","text":"摩围小隐枕蛮江。\n蛛丝闲锁晴窗。\n水风山影上修廊。\n不到晚来凉。\n相伴蝶穿花径，独飞鸥舞春光。\n不因送客下绳床。\n添火炷炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"画堂春 其一","author":"黄庭坚","text":"东堂西畔有池塘。\n使君棐几明窗。\n日西人吏散东廊。\n蒲苇送清凉。\n翠管细通岩溜，小峰重叠山光。\n近池催置琵琶床。\n衣带水风香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摊破南乡子","author":"黄庭坚","text":"得意许多时。\n长醉赏、月影花枝。\n暴风狂雨年年有，金笼锁定，莺雏燕友，不被鸡期。\n红旆转逶迤。\n悔无计、千里追随。\n再来应绾泸南印，而今目下，凄惶怎向，日永春迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"黄庭坚","text":"樱桃著子如红豆，不管春归。\n闻道开时。\n蜂惹香须蝶惹衣。\n楼台灯火明珠翠，酒恋歌迷。\n醉玉东西。\n少个人人暖被携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其四","author":"黄庭坚","text":"城南城北看桃李，依倚年华。\n杨柳藏鸦。\n又是无言飐落花。\n春风一面长含笑，偷顾羞遮。\n分付谁家。\n把酒花前试问他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"黄庭坚","text":"马湖来舞钗初赐，笳鼓声繁。\n贤将开关。\n威竦西山八诏蛮。\n南溪地逐名贤重，深锁群山。\n燕喜公闲。\n一斛明珠两小鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二 送彭道微使君移知永康军","author":"黄庭坚","text":"荔枝滩上留千骑，桃李阴繁。\n燕寝香残。\n画戟森森镇八蛮。\n永康又得风流守，管领江山。\n少讼多闲。\n烟霭楼台舞翠鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其一","author":"黄庭坚","text":"虚堂密候参同火，梨枣枝繁。\n深锁三关。\n不要樊姬与小蛮。\n遥知风雨更阑夜，犹梦巫山。\n浓丽清闲。\n晓镜新梳十二鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二","author":"黄庭坚","text":"投荒万里无归路，雪点鬓繁。\n度鬼门关。\n已拼儿童作楚蛮。\n黄云苦竹啼归去，绕荔枝山。\n蓬户身闲。\n歌板谁家教小鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其一 赠黄中行","author":"黄庭坚","text":"宗盟有妓能歌舞，宜醉尊罍。\n待约新醅。\n车上危坡尽要推。\n西邻三弄争秋月，邀勒春回。\n个里声催。\n铁树枝头花也开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中花/夜行船 送彭文思使君","author":"黄庭坚","text":"政乐中和，夷夏宴喜，官梅乍传消息。\n待作新年欢计，断送春色。\n桃李成阴，甘棠少讼，又移旌戟。\n念画楼朱阁，风流高会，顿冷谈席。\n西州纵有，舞裙歌板，谁共茗邀棋敌。\n归来未得，先沾离袖，管弦催滴。\n乐事赏心易散，良辰美景难得。\n会须醉倒，玉山扶起，更倾春碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案 至宜州次韵上酬七兄","author":"黄庭坚","text":"烟中一线来时路。\n极目送、归鸿去。\n第四阳关云不度。\n山胡新啭，子规言语。\n正在人愁处。\n忧能损性休朝暮。\n忆我当年醉时句。\n渡水穿云心已许。\n暮年光景，小轩南浦。\n同卷西山雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其四","author":"黄庭坚","text":"卧稻雨馀收。\n处处游人簇远洲。\n白发又扶红袖醉，戎州。\n乱折黄花插满头。\n青眼想风流。\n画出西楼一帧秋。\n还把去年欢意舞，梁洲。\n塞雁西来特地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 重阳日宜州城楼宴集即席作","author":"黄庭坚","text":"诸将说封侯，短笛长歌独倚楼。\n万事尽随风雨去，休休，戏马台南金络头。\n催酒莫迟留，酒味今秋似去秋。\n花向老人头上笑，羞羞，白发簪花不解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其三","author":"黄庭坚","text":"黄菊满东篱。\n与客携壶上翠微。\n已是有花兼有酒，良期。\n不用登临恨落晖。\n满酌不须辞。\n莫待无花空折枝。\n寂寞酒醒人散后，堪悲。\n节去蜂愁蝶不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其一","author":"黄庭坚","text":"招唤欲千回。\n暂得尊前笑口开。\n万水千山还么去，悠哉。\n酒面黄花欲醉谁。\n顾影又徘徊。\n立到斜风细雨吹。\n见我未衰容易去，还来。\n不道年年即渐衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]