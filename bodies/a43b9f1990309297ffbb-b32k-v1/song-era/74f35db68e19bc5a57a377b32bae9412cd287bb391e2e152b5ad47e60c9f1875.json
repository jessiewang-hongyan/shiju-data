[{"title":"赠无择老禅因观稼 其一","author":"郑霖","text":"两年风雨为民愁，那得偷閒物外游。\n谁谓秋鸿留爪甲，吴侬一稔展眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠无择老禅因观稼 其二","author":"郑霖","text":"每谒祠堂憩虎邱，山僧煮茗雪花浮。\n陆泉便作曹溪会，引得清风话未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安抚陈侍郎宴曾提刑乐语","author":"郑霖","text":"恰好莺花一半春，福星相会赣江滨。\n丈人师吉符前谶，肤使心同扫旧尘。\n看剑引杯宜酩酊，轻裘缓带倍精神。\n从今净洗天河甲，有诏催归两重臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳祐己酉月正人日春雨堂宴三学同舍即事","author":"郑霖","text":"十年随牒访三高，不觉星星上鬓毛。\n尚忆齑盐形夜梦，聊因椒柏荐春醪。\n文盟再会知何日，臭味相投属我曹。\n总是虞庠旧培植，致君当不愧夔皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭知军宴交代都运陈宝章乐语","author":"郑霖","text":"使轺严戒鼓逢逢，熊轼颁春到此邦。\n炳炳福星临一道，融融爱日照横江。\n断霞秋日闲飞鹜，荒草寒烟不吠厖。\n台府交欢同一体，从今俗返古淳庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"提刑曾宝章宴安抚陈侍郎乐语","author":"郑霖","text":"听得敷纶天上头，二星交会玉虹流。\n风生三路军容壮，春到双江喜气浮。\n谈笑预知传露布，劝酬只恐促更筹。\n会看印佩黄金斗，肯羡当年定远侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"集仙纳凉","author":"郑霖","text":"县滩如沸鼎，玄馆足清幽。\n竹径不留暑，莲池先借秋。\n学仙师有诀，恋禄我怀羞。\n安得双凫舄，乘风八极游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题松风馆","author":"郑魏珽","text":"一壑萧然万里间，此身落得似云閒。\n蹁跹野鹤身同逸，来往樵人语不关。\n瑶草茂时春淡荡，乱溪交处水潺湲。\n偶怀知己携琴去，十里松风未出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹崖","author":"郑瀛","text":"丹崖之山丹气浮，葛洪老仙居上头。\n丹成一去几千载，至今猿鹤生清愁。\n丹井有泉石有拇，流芳直与天地久。\n我来问山山不知，坐费山僧一杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四泽晓罾","author":"郑瀛","text":"泽水回环六七里，中流拥出一廛市。\n桃花吹浪鳜鱼肥，红蓼翻风蟹螯美。\n渔郎业渔相忌猜，欲晓未晓江上来。\n举罾交错不知倦，欸乃又入云涛堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伏虎崖","author":"郑瀛","text":"西崖有虎凭其威，凛然百兽不敢窥。\n众山压倒势莫敌，磅礴万古谁能驱。\n乡人好利不知计，剪毛伐骨何太厉。\n安知此虎不汝欺，长作吾家一屏蔽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官塘竞渡","author":"郑瀛","text":"长江百里浓于醅，天风吹作云涛堆。\n吾乡好事重佳节，龙舟两两争喧豗。\n今人不识灵均意，祇作龙舟多竞渡。\n汨罗旧事付苍烟，空有遗歌写哀些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南野暮镕","author":"郑瀛","text":"村南野老亦多伎，两鬓髼松状如鬼。\n嬴颠秦蹶了不闻，一心只向红炉里。\n风鞴在手金在镕，等閒变化天无工。\n日暮欢呼走妻子，买鱼沽酒歌春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葛井涵秋","author":"郑瀛","text":"吾乡葛氏真好奇，凿开石井山之湄。\n寒波清冽不受暑，主人爱取沁诗脾。\n百年兴废事非昔，莓苔剥落土花碧。\n我来拂拭已忘言，落叶西风秋析析。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑瓒","text":"一水玻璃似苕霅，群山俎豆胜方壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑爚","text":"月似故人能赴约，鹭如小友可忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金庭观","author":"金卞","text":"寻真穷养浩，崇妙路迢迢。\n洞掩峰千叠，尘分水一条。\n白云生石壁，飞阁插崖腰。\n隐隐存仙迹，浑疑在碧霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"金汉臣","text":"故乡万里思亲远，客馆孤身度日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双头兰和吴应奉韵","author":"金似孙","text":"手种盆兰香满庭，閒来趣味独幽深。\n敢誇双萼钟奇气，祇恨孤根出晚林。\n长倩生男不得力，滕公有女谩萦心。\n援琴欲和春风曲，却对骚魂费苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题广信道中","author":"金丽卿","text":"家住钱塘山水图，梅边柳外识林苏。\n平生惯占清凉国，岂料人间有暑途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"义乌","author":"金君卿","text":"徒知感义海边州，未效精衷已白头。\n苑囿清阴无限好，栖身容借一枝不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大云仓阻风","author":"金君卿","text":"走越游梁万里回，却临江渡已残梅。\n归帆未落青溪尾，云压寒风水面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五色雀","author":"金君卿","text":"晨氛澄霁海风调，綵绚珍禽入绛霄。\n闻说舜庭方作乐，可容飞舞听箫韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双溪","author":"金君卿","text":"双派飞来一镜寒，合流南注息惊湍。\n雨馀山脚云收尽，两幅青绡绕翠峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水心亭分题","author":"金君卿","text":"雨脚新收晚照开，水心亭上一曾来。\n红裙只解邀人醉，竞折新荷当酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石","author":"金君卿","text":"地隘风波势已惊，更容顽险暗中倾。\n自嗟忠信犹防患，却任舟人委曲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石龟塘","author":"金君卿","text":"石化神龟不计年，方塘依旧洌寒泉。\n氛埃不到真仙境，拟倩麻姑种碧莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州","author":"金君卿","text":"秋浦南边绝点埃，碧围烟嶂一屏开。\n当时小杜行吟处，重见高阳骑从来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池亭避暑","author":"金君卿","text":"新花犹未出圆荷，月射风翻卷翠波。\n对酒强须通夕醉，暑天清景此为多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李白坟","author":"金君卿","text":"谢公山下见孤坟，下阚平江万顷云。\n尽日舣舟空怅望，谪仙风骨在遗文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张公达端见寄","author":"金君卿","text":"殷勤寄语张夫子，休爱三山胜处游。\n闻说诏书催入觐，便须飞步上鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康甫兄见寄","author":"金君卿","text":"梦想南亭倚翠岑，手栽松竹已成阴。\n白云不是无留意，出得山来四海心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"披襟台","author":"金君卿","text":"紫微行乐不到处，绝胜何人共赏心。\n况是难逢开口笑，强须携手一披襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金竹峰","author":"金君卿","text":"重重岩崿插晴空，云际丛开菡萏峰。\n疑是葛仙归洞府，移将江上九芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金沙亭","author":"金君卿","text":"亭阚方池物物新，花中名品富长春。\n诗僧用意栽培处，四季常教有主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留应圣宫","author":"金君卿","text":"松扫醮坛青羽盖，杉围精馆碧油幢。\n葛张二老今何许，云外归来鹤一双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题分宜前山吴隐士白云亭 其二","author":"金君卿","text":"江上青山山上泉，酌泉烹茗白云间。\n长官不扰民无讼，共喜登临一日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题分宜前山吴隐士白云亭 其一","author":"金君卿","text":"面挹晴光锦绣川，却临苍涧玉声涓。\n逸民自有山中乐，不问山前令尹贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起","author":"金君卿","text":"黄祖城边下石船，蕉林暗地雨如烟。\n只知问俗求民瘼，却愧经旬卧瘴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真珠亭","author":"金君卿","text":"新寺回廊入翠微，亭前珠树斗芳菲。\n寄言游者休披采，还似人怀薏苡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书茭湖院","author":"金君卿","text":"波漾晴光入户庭，隔湖烟扫髻螺青。\n老僧犹厌当官道，面壁焚香昼诵经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿德兴周秀才书阁","author":"金君卿","text":"十室所可重，喜君吾道同。\n因过一携手，醉卧六经中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄别朱公美","author":"金君卿","text":"三载乡坊义最亲，驱车还是走京尘。\n虽无士会兼人智，犹有临岐赠策人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盛暑偶游旷亭书于再生樟石碣之阴","author":"金君卿","text":"万里雄风海峤来，客襟聊为旷亭开。\n千年古木清阴合，若比庄椿是美材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢朱公美遗瓜酒","author":"金君卿","text":"龙蹄甘美蚁头香，远远缄封遣老郎。\n便向嵓亭逃暑去，恨无人共把觥觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题公定兄滴翠亭","author":"金君卿","text":"数岫翠岚浓欲滴，一轩静境阒无尘。\n暑风满枕日高起，谁识羲皇傲世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题晞上人齐物堂","author":"金君卿","text":"莫论西竺与南华，了得真筌只一家。\n声色外来无物我，茫茫名利是空花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠成秘校","author":"金君卿","text":"四门嵓下一翘英，满腹诗书学已成。\n讲义群庠初应辟，绛帷罗列尽诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠南华拱禅师","author":"金君卿","text":"祖叶彫零四百年，法灯今见拱师传。\n堂头海会僧三百，昼课莲经暮叩禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至日代书呈诸兄","author":"金君卿","text":"人人欢聚庆新阳，我独飞心恋北堂。\n薄宦飘流成底事，数年牢落在他乡。\n徒将远意凭归雁，不及诸兄捧寿觞。\n何幸前春改官去，綵衣相逐戏亲傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张子礼锁应下第南归","author":"金君卿","text":"官小事如麻，去官书满车。\n干时不得荐，垂翅又还家。\n知命独无愧，沉英众所嗟。\n风波信一叶，流落向天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵辩大师归江南","author":"金君卿","text":"睿赞释真筌，惟师得本原。\n歌时诗百首，祝圣颂千言。\n巨轴朝闻御，方袍夕拜恩。\n江南归旧隐，高卧老乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花沼分题","author":"金君卿","text":"寒光净色照花林，更喜诗家共赏心。\n谢客不成春草梦，杜郎须强海棠吟。\n惟忧别去歌云散，不管愁来鬓雪侵。\n且试主人新酒令，片红飘盏十分斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周涛权宰大冶，以湖光亭诗见寄，因和之","author":"金君卿","text":"面揖清光万顷陂，满檐秋色曙阴微。\n回环远岫烟中辨，片段闲云镜里飞。\n富冶地饶民讼简，洞庭风便客舟稀。\n知君已厌江山思，亭下行吟日望归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人悯道傍冻馁者","author":"金君卿","text":"天意正成物，民心犹怨寒。\n风霜草木死，田野稻粱乾。\n何谓耕桑者，而无衣褐完。\n因思饵胡费，把笔谩悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和介甫寄安丰张公仪之什","author":"金君卿","text":"前贤立事岂徒然，惠政须教振古传。\n芍水灌馀三万顷，楚人祠已二千年。\n近闻令尹开新闸，不避风波上小船。\n堤筑已完舆颂洽，去时民吏重留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔芍药","author":"金君卿","text":"不逐群花散漫开，风前一笑尚淹回。\n使人便有留春意，对尔强须衔酒杯。\n时与乐并真胜会，笔缘情赋尽高才。\n如何只得新诗看，也似南园纵赏来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔颍川西湖","author":"金君卿","text":"名游无似郡城西，况是棠阴讼简时。\n信步桑间春去后，榜舟湖面夜归迟。\n烟波际目无穷乐，沙鸟留人逐处随。\n应为独醒须强醉，浩歌风月倒千卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周涛见寄","author":"金君卿","text":"薄宦留连未得归，思亲怀旧两依依。\n岭头梅信凭谁去，枕上鸿声到此稀。\n君喜及瓜催北向，我嗟垂翅倦南飞。\n何时共作东都客，不厌京尘化旅衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和御制观龙图阁三圣御书","author":"金君卿","text":"累圣传真迹，天苞炳瑞文。\n珍藏留紫禁，宝构拂丛云。\n焜耀三辰烂，周旋八体分。\n宸心追睿辙，尤念保邦勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾子固闻言事谪官者","author":"金君卿","text":"四海疮痍剧猬毛，爱君三谏未能逃。\n所期力济生民福，不为名存信史褒。\n想见斯人心独喜，愿为君党义尤高。\n忠言已入身甘窜，始见吾徒气思豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招王阚二同年","author":"金君卿","text":"偶忆去年逃暑饮，与君通夕屡忘归。\n旋沽美酒开樽渌，更买新鱼斫鲙肥。\n今日忽惊池水涨，小亭依旧柳阴围。\n停舟待月波心去，携手相过莫我违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郁孤台","author":"金君卿","text":"鳞鳞万瓦绕云根，环列诸峰势独尊。\n屹若灵鳌浮海面，俨如谋将立辕门。\n赣流东汇龙蛇走，崆阜南来虎豹蹲。\n乘月偶为逃暑饮，欲扪南斗当清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康县清暑台","author":"金君卿","text":"子康疏略人皆笑，即墨孤危众所攻。\n遇主卒封齐万户，会时犹位汉三公。\n二贤养正堪忻慕，百里徒劳且晦蒙。\n闲上高台散幽郁，独开襟袖挹清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南塘闲泛二首 其二","author":"金君卿","text":"水乡真个似三吴，碧淀涵秋水鉴湖。\n十里香风起莲萼，半空飞雪下鸥雏。\n堤森古木严征仗，塞缭方田展角图。\n闲舣洛阳桥畔饮，风涛还到此中无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南塘闲泛二首 其一","author":"金君卿","text":"雨收平淀饮残虹，蘋末无风碧印空。\n寒净浑疑踏冰去，清光直欲贮胸中。\n客樯隐隐逐飞鸟，钓舸悠悠任转蓬。\n日暮韩堤犹极望，却将耕稼问渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雁","author":"金君卿","text":"北来南去年年事，微物还应不自由。\n缯缴多机当远谢，稻粱已饱更何求。\n潇潇风雨衡阳暮，渺渺烟波震泽秋。\n夜过边城牢闭口，断肠砧杵不禁愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送广州刘待制","author":"金君卿","text":"光摇剑外使星还，天阁平跻侍从班。\n暂命剖符开广府，先声指日定诸蛮。\n浮江大旆翩翻去，过岭新恩次第颁。\n济俗有谋方适用，卷舒应在笑谈间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张明远归丹阳","author":"金君卿","text":"此行非远别，何用惨离颜。\n纵棹溪亭外，清歌樽酒閒。\n相期在西笑，从此望南还。\n归去重回首，夕阳江外山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重修龙兴观寄呈江吴二尊师 其一","author":"金君卿","text":"坛宇榛芜几十年，遗基重葺控长川。\n羽人便是双飞鹤，仙籍须增一洞天。\n蓝峤逢秋无败叶，龟池经夏有甘泉。\n操舟过客宜停棹，暂到尘襟自洒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重修龙兴观寄呈江吴二尊师 其二","author":"金君卿","text":"万户晴岚生紫烟，绝尘佳致甲昌川。\n轻舠急桨风中叶，碧瓦朱栏水底天。\n雨夜龙涎腥柱础，霜秋桂子落嵓泉。\n二师自得幽栖趣，向此灰心肯复然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽仁宗皇帝词 其四","author":"金君卿","text":"深仁醴泽浃威灵，最是櫜兵与缓刑。\n坐接迩僚均父子，手挥宸翰走风霆。\n臣心未报空号慕，刍牧无知亦涕零。\n视古诸侯从俭约，忍思遗诏尚丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]