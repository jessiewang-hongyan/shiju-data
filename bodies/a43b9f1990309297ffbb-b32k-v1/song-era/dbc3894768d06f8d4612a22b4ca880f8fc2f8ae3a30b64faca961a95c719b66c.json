[{"title":"次韵朱新仲学士元日会饮馆中同舍家","author":"张扩","text":"华堂小集寿佳辰，好雪萦风上舞茵。\n珠琲相酬元富贵，绮罗不设自清真。\n近从朱墨生官府，便觉方壶隔世尘。\n纵许一斑窥妙句，亦应寡和愧阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李天祚屯田","author":"张扩","text":"巷北巷南车殷雷，怜渠襟抱向谁开。\n苦无好梦绝江去，合有短书逢雁回。\n省户淹留惊白发，朝廷缓急要真材。\n他年炙手会不免，早赋柴桑归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春深遣兴","author":"张扩","text":"深院小亭花药香，春来无处避风光。\n畦蔬自种两席许，溪水忽高三尺彊。\n冷淡不妨诗作活，狂歌时以酒为乡。\n故人南北今谁在，纸尾寒暄未可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谭少卿胜仲怀归","author":"张扩","text":"底用封侯老据鞍，如君家世自儒冠。\n初无妩媚追时好，但有孤高到岁寒。\n梦入向来招隐处，诗成有味付谁看。\n援毫欲和愧迟涩，八节推舟窘上滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄大年耆年二侄","author":"张扩","text":"漫天白雨欲催诗，恰似连床细柳时。\n近悔论文多败绩，不关避谤要寻医。\n才如伯仲世无敌，学有本原人未知。\n例著布袍随举子，满听危论上丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文之雪霰落砚诗戏用其韵","author":"张扩","text":"玄璧无尘中作泓，偏宜净几集飞霙。\n柳花可染巳无迹，鹄羽不黔如幻成。\n小试桑根犹耿介，结为冰面更晶明。\n痴儿呵冻为渠赋，费尽壶中墨客卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楼西枢出抚关陜郑亨仲以秘监充参谋馆中咸分韵为饯得纶字","author":"张扩","text":"关河宣慰尚儒臣，宾客仍收席上珍。\n便有威名如敌国，更分筹画累同人。\n连城簪笏官寮旧，夹道壶箪诏墨新。\n归日毛锥应好在，却从丹禁演丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒广济军向工曹仲吉","author":"张扩","text":"水曹笔力若新硎，冷屋无人诗自鸣。\n取别未容长草草，相看岂合但平平。\n百年王谢见人物，少日机云真弟兄。\n且向陶丘问消息，他时湖海莫寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别梅和胜侍郎","author":"张扩","text":"平日寄声天一方，那知岁晚屡登堂。\n百年已负几樽酒，一夜各添新鬓霜。\n尘里著身空岁月，笔间应俗漫文章。\n门庭未觉千里远，会有书来细作行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张无隅送乌髭方与人并寄以诗","author":"张扩","text":"肘后仙方旧著名，知君学道得长生。\n烧丹自秘砂银诀，染白聊分草木英。\n两鬓尚须并检校，二毛应觉顿神明。\n他年莫向玄龄问，李纬犹堪老作卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送彦材侄还乡","author":"张扩","text":"朔风吹雪冷侵衣，过我山城岁暮时。\n每叹吏曹长缩手，会从樽酒得伸眉。\n笑谈亹亹未更仆，行李匆匆还语离。\n莫厌吾家穷事业，囊中好在几毛锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"檐冰","author":"张扩","text":"历历排檐定琢成，小庵睡起眼初明。\n药翁收乳得鹅管，天女坠钗悬水晶。\n脱手不供时把玩，怯风终作泪纵横。\n老顽不办刘叉句，听尽寒阶断续声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笋","author":"张扩","text":"披箨游龙破地皮，浪将头角长孙枝。\n浑疑铁骑旌戈晓，如趁玉班宫殿时。\n羊酪莼羹真谩语，河鲀荻笋彊相宜。\n无人会得丛林趣，尽属此君惟我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次笋韵","author":"张扩","text":"羽猎谁寻狐貉皮，空林失箭已千枝。\n遥聆春晚斧斤响，不到岁寒霜雪时。\n喜有斋熏延上座，愧无椽管付师宜。\n平生漫作汉宫妾，十指许长君未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子温偶书","author":"张扩","text":"门外溪光倒碧山，怜君终不厌身閒。\n直须扫迹利名里，却要策勋文字间。\n洗耳时倾高士论，转喉莫犯贵人颜。\n百年总是一抔土，且乞馀生隐市关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昼寝","author":"张扩","text":"翠簟轻纨腹果然，午风吹梦入湖边。\n竹奴不语专新宠，水厄无功罢宿烟。\n却要降魔时读易，未须盘膝彊磨砖。\n谁人妙解老韶诀，心印传来不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天柱峰","author":"张扩","text":"神人断鳌立极处，一柱至今馀尺度。\n摩挲岁月不可穷，会见女娲曾手补。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"展旗峰","author":"张扩","text":"何年陨石化蚩尤，彷佛光芒动九斿。\n厌乱无人识天意，浓云若雾没高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大龙湫","author":"张扩","text":"巉岩石壁倚天开，何处苍龙噀雨来。\n海上秋田半焦槁，不应涧谷但空雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门瀑布","author":"张扩","text":"胸中顿有两龙湫，晚向尘寰得胜游。\n定是伏龙思远客，剩分一派洗穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天聪洞","author":"张扩","text":"危梯百级面天聪，路逼青冥似可通。\n著脚未平身已堕，神仙窗户漫玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫成","author":"张扩","text":"人声乍寂鸟声乐，书舍旁通僧舍幽。\n行尽人间硗确处，吾庐自好更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春绝句 其一","author":"张扩","text":"飘尽杏园红白株，祗留芍药殿春馀。\n不堪风雨夜来恶，地上又多枝上疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春绝句 其二","author":"张扩","text":"地上殷红锦作衣，游蜂百匝绕空枝。\n满园绿暗莺声老，正是一年春尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮春绝句 其三","author":"张扩","text":"背人春日去堂堂，无赖春风有底忙。\n便好单衣裁白纻，青天露坐试新凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宁徽言学士立春六绝 其一","author":"张扩","text":"仙家庭院立春朝，不记仙翁几种桃。\n共祝风光还上苑，钧天丝管换弓刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宁徽言学士立春六绝 其二","author":"张扩","text":"剪綵沾酥顷刻间，开花不受雪摧残。\n谁人试手争春巧，定是仙娥下广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宁徽言学士立春六绝 其三","author":"张扩","text":"古县鞭牛吏谨时，老农分喜上庞眉。\n东皇一例扶衰朽，不独故园桃李枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宁徽言学士立春六绝 其四","author":"张扩","text":"青丝行菜手纤纤，盏面鹅黄照舞衫。\n萧寺馆君归未得，杜鹃应合口如缄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宁徽言学士立春六绝 其五","author":"张扩","text":"丽句从君笔底翻，旁观但合把降幡。\n承明何日供春帖，字字堪回玉色温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宁徽言学士立春六绝 其六","author":"张扩","text":"野人破衲度穷冬，枕上馀寒散晓风。\n春事苦无关我处，茶烟药臼了龟蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵石倅喜江令祷雨有应三绝句 其一","author":"张扩","text":"忱词新沐管城枯，夜启天门玉锁鱼。\n借得丰年三尺雨，此郎那解世间书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵石倅喜江令祷雨有应三绝句 其二","author":"张扩","text":"蛰龙水底未全枯，睡稳终惭点额鱼。\n聊为苍生一伸肘，阴功何待玉函书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵石倅喜江令祷雨有应三绝句 其三","author":"张扩","text":"藜苋搜肠老欲枯，年来冷釜已生鱼。\n三钱斗米待明日，预办平原乞米书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其一","author":"张扩","text":"春泥滑滑封行路，春水溶溶没野蔬。\n独坐不愁无酒饮，林间山鸟自提壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其二","author":"张扩","text":"温风习习送蚕老，晓日曈曈催麦黄。\n新笋已添千个竹，绿萌初遍数畦秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其三","author":"张扩","text":"山腰老桧结缨络，石眼飞泉鸣佩珰。\n午梦悠悠谁唤觉，竹风时借枕衾凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居四首 其四","author":"张扩","text":"诛茅结屋方丈阔，买酒浇肠升斗悭。\n古寺隔林人阒寂，祗传钟梵到山间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题枕流轩诗四首 其一","author":"张扩","text":"世间无路不榛荆，且枕清流巧避名。\n俗客若来休举似，恐渠笑倒断冠缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题枕流轩诗四首 其二","author":"张扩","text":"谁酌贪泉计巳疏，但知辛苦立廉隅。\n君今乐水自智者，未用休官乞鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题枕流轩诗四首 其三","author":"张扩","text":"坐有谈玄墨客卿，家无铜臭孔方兄。\n梦馀更听沧浪水，洗尽微尘见太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题枕流轩诗四首 其四","author":"张扩","text":"诗老诗如冰雪味，后来和者得分甘。\n从今客耳亦清净，只合高吟当剧谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舫斋","author":"张扩","text":"曾得操舟三昩功，浮家不借一帆风。\n鲈鱼如雪酒如玉，宛在五湖春水中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与客争棋客有所负坐人以目无解围者客怒甚而去作诗戏之","author":"张扩","text":"不论别墅自心降，风急西南势转忙。\n那辨旁呼白鹦鹉，坐看豪夺紫罗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用文之韵赋岩桂 其一","author":"张扩","text":"叶底倒悬香作团，鹅黄新染色初乾。\n晚秋风露易摇落，合属幽人仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用文之韵赋岩桂 其二","author":"张扩","text":"昔年曾赋道边花，岁月侵寻鬓已华。\n衰病不堪无好语，却凭三嗅作诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵允中大夫兄秉烛看海棠","author":"张扩","text":"从公烛下看花枝，直到海棠花睡时。\n恰似玉人春枕稳，温风吹酒上凝脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢李簿送白牡丹","author":"张扩","text":"擎玉花头取次妍，鞓红从此不论钱。\n如何未入明皇梦，已醉高吟李谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清香","author":"张扩","text":"北苑珍膏玉不如，清香入体世间无。\n若将龙麝污天质，终恐薰莸臭味殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣城乳梨味珍或谓性寒养生所忌辄劝疏之予因为作诗叹其不遇","author":"张扩","text":"开花曾作雪缤纷，花去还供饤座珍。\n谁向医门书下考，便防蒸食堕痴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子温惠双井茶二首 其一","author":"张扩","text":"双井昆仍分不疏，渴中曾起病相如。\n策勋未有涪翁语，浪说翻经到石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子温惠双井茶二首 其二","author":"张扩","text":"不减建溪官焙香，匏樽汲水自煎汤。\n未应重为粗官屈，定自诗情合得尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观茶","author":"张扩","text":"镇西不入未为屈，坐上臞仙眼如漆。\n平生陆羽彊著语，不叙建溪谁第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"均茶","author":"张扩","text":"密云惊散阿香雷，坐客分尝雪一杯。\n可是陈平长割肉，全胜管仲自分财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗茶","author":"张扩","text":"新剪鹅溪样如月，中有琼糜落飞屑。\n何年解后紫霞仙，肘后亲传餐玉诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"碾茶","author":"张扩","text":"何意苍龙解碎身，岂知幻相等微尘。\n莫言椎钝如幽冀，碎璧相如竟负秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水帘谷","author":"张扩","text":"洞中宫阙玉层层，山瀑供帘似织成。\n素额长垂云为扫，琼钩欲挂月还生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拂云桥","author":"张扩","text":"谁重淇园百世孙，青青枝叶暗连云。\n能诗外监亦清苦，结屋邻桥配此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汲泉","author":"张扩","text":"古寺僧囊见水经，未贪饮菊学长生。\n棹船且向南零汲，欲试高人识鉴精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澹竹","author":"张扩","text":"谁解香根一种寒，试尝炎帝作朝餐。\n余生倘遇袢襟渴，一任清凉露肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫成三绝句 其一","author":"张扩","text":"蜗涎行窗篆诘屈，荷叶泻露珠淋浪。\n朝来危坐笏拄颊，乱云横山如许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫成三绝句 其二","author":"张扩","text":"银杯厌世已仙去，春草催诗寻梦来。\n日暮砧声捣衣急，夜凉月色挽船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫成三绝句 其三","author":"张扩","text":"三馆赘疣终罢废，丛祠甲乙例推迁。\n斗升似线当复续，冠带如雠莫近前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏成二毫笔绝句","author":"张扩","text":"包羞曾借虎皮蒙，笔阵仍推兔作锋。\n未用吹毛强分别，即今同受管城封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送均父作江守","author":"张扩","text":"平时衮衮向诸公，投老犹推作郡公。\n未觉朝廷疏汲黯，极知州郡要文翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山矾花","author":"张扩","text":"秋风刻縠先黄染，七里寻香不辞远。\n荒溪日暮下牛羊，满路幽香谁挂眼。\n世间草木久纷然，妖红嫚绿徒争先。\n何当伴君过一世，细看四面秋香悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"张扩","text":"范侯渥洼种，出水已权奇。\n失身肉马群，俯首枯豆萁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵曾大卿用东坡先生韵赋蜡梅","author":"张扩","text":"湘潭有客善种花，晓移根垡来君家。\n天公着意为刻蜡，幻出新苞亦尤物。\n至游老仙旧相知，少年惜花多赋诗。\n而今更挽金蕉叶，与花一处成三绝。\n夜阑宝帐攒远山，钗头馀苍薰醉眠。\n明朝红紫麾不去，妖艳妨人觅佳句。\n始信清臞自可人，此语嘱谁当嘱君。\n请为百花作檀越，得意不妨时击钵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次前韵","author":"张扩","text":"梅花声名降百花，蜡梅后出亦世家。\n真香不多护以蜡，玄官风流无长物。\n瀛洲阁老圣得知，不解藏锋屡作诗。\n君不见大苏曾赋黄千叶，岁晚无胶续弦绝。\n君今颇陋饭颗山，枕上冥搜那得眠。\n想应不妨花归去，开处韩郎有新句。\n浅黄官样苦撩人，此事从来合付君。\n我亦评花太僭越，不问吞针与齧钵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅近出或谓药中一种不结子非梅类戏作数语为解嘲云","author":"张扩","text":"梅花孤高少辈行，蜡梅晚出辄争长。\n素妆落额岂不好，浅黄拂杀更官样。\n檀心半迎寒日吐，暗香坐待初月上。\n春风不是苦靳惜，未办开花大如掌。\n君不见桃李开花到结果，削梗钻核终奇祸。\n蜡梅沾蜡如幻成，渠要调羹身后名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"博古堂","author":"张扩","text":"古人嗜书书不足，家贫无钱就市读。\n今人收书书填屋，红牙垂签手未触。\n别驾平生师古人，传癖书淫九经簏。\n卢仝撑肠五千卷，邺侯插架三万轴。\n河东安世工补亡，伏日郝隆便晒腹。\n少时场屋学有馀，行辈见推行秘书。\n援毫急趁蚕食叶，袖手冷窥獭祭鱼。\n十年未持紫荷橐，校雠合在天禄阁。\n投身簿领聊尔耳，饱看五车誇濩落。\n近者闻说新堂成，芭蕉急雨作秋声。\n请君扫榻近灯火，莫歌长檠歌短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行江阴道中","author":"张扩","text":"雨后侵篙一尺浑，败蒲衰柳乱填门。\n梦闻断角送馀向，起看新潮到旧痕。\n处处鱼盐成市井，家家罾笱长儿孙。\n更传下诏宽民力，斗米三钱何足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]