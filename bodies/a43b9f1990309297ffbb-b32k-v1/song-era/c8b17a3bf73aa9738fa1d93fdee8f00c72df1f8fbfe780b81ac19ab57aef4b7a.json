[{"title":"月下闻桂花","author":"陈起","text":"一庭人静月当空，桂不多花细细风。\n香露滴衣凉似水，恍然移下广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"止酒示圭","author":"陈起","text":"一病杯中物致危，翰林何事酷耽之。\n酒经若果通仙道，不向青山立断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东郊瞻四望亭有感","author":"陈起","text":"有杯莫向前山举，楚水吴云此地分。\n竹外谁家霜鹤唳，吟逋梅下昔曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧挽汪隐君 其一","author":"陈起","text":"栖志浮云小万钟，带经高垄度春风。\n义方莫问当年事，十五男儿识阿戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧挽汪隐君 其二","author":"陈起","text":"遗碣钻辞掩夜台，脩文空叹逞馀才。\n鹿坡明月成惆怅，不见高人自往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旧题隐者壁一绝","author":"陈起","text":"妻嗔山犬践园蔬，儿钓溪鱼喂鹤雏。\n总道村居无外事，有人庭下索诗逋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"买花","author":"陈起","text":"今早神清觉步轻，杖藜聊复到前庭。\n市声亦有关情处，买得秋花插小瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同清兄看猿","author":"陈起","text":"藜杖同僧扣，应门野叟闲。\n放他猿摘果，莫把白云关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圭示急须制作亭当喜成一绝","author":"陈起","text":"博古图中无此样，繄谁匠意巧胚胎。\n槐堂新送黄封酒，便可冲寒暖一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西兴道间","author":"陈起","text":"此心只欲与民安，不要人知道有官。\n顾得簥来虽是小，买他船去却须宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过三桥怀山台","author":"陈起","text":"卖花声里凭阑处，沽酒楼前对雨时。\n景物如初人自老，夕阳波上燕差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"束起","author":"陈起","text":"束起仙翁肘后经，且参思邈枕中吟。\n夜来独卧寒无寐，忆杀黄紬旧破衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸帐送梅屋小诗戏之","author":"陈起","text":"十幅溪藤皱縠纹，梅花梦里閟氤氲。\n裴航莫作瑶台想，约取希夷共白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏琴上曹先生","author":"陈起","text":"清如雅操直如弦，此意于今久不传。\n月冷风高清禁地，只将古调奏钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过西湖","author":"陈起","text":"鹊巢犹挂三更月，渔板惊回一片鸥。\n吟得诗成无笔写，蘸他春水画船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜诵","author":"陈起","text":"父子跏趺绝似僧，青灯一盏夜三更。\n读残戴记儿将倦，山栗旋煨仍擘橙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚戌秋作","author":"陈起","text":"甲辰迤逦至今年，药灶殊劳日夕煎。\n血气任他销与铄，向来诗骨已成仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明远阁","author":"陈起","text":"风捲疏烟远岫分，天开一镜皎无云。\n衰荷摇落汀洲晚，犹舞馀香坠茜裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上","author":"陈起","text":"病与仇谋酒作成，药炉又复伴深更。\n邻钟自是常时听，才到霜天分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与苇航适安饮 其二","author":"陈起","text":"觥筹交错舞傞傞，延得嫦娥泛醁波。\n客谓平生无此乐，二章聊继饮中歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与苇航适安饮 其一","author":"陈起","text":"献酬无算是杯行，午酌从容至四更。\n陶母侈于真率约，退思无倦若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"脩父知县万里寄诗久未能答午枕梦见之觉而有答","author":"陈起","text":"梦觉疏蝉韵更凄，阑干曲曲柳阴移。\n吴蚕蜀茧缲千尺，一种愁机两处丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"陈起","text":"又见街头卖紫茱，老怀扰扰类催租。\n客来喜得吴江纸，欲写新吟一字无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡季怀有诗约群从为秋泉之集辄以山果助筵戏作二叠 其二","author":"周必大","text":"君家香醪蜜不如，试投木桃望瑶琚。\n敢誇所有易所无，潘郎一出果盈车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵济民生日","author":"陈起","text":"今岁呈祥殊胜昔，六花端为寿筵开。\n小诗聊寓千秋意，不得相陪法喜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唤渡","author":"陈起","text":"一帆又是过西陵，天正寒时雨欲冰。\n心地自平潮自险，回瞻绛阙认觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓寒即事","author":"陈起","text":"芳意迢迢客梦閒，乱红飞尽晓泥乾。\n薄罗尚怯馀寒在，一阵东风剪牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"消遣","author":"陈起","text":"夜雨生寒换夹衣，形臞貌悴叹衰迟。\n病中何物能消遣，一榻揩摩十载诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题天乐寓张氏湖亭","author":"陈起","text":"沉水香销一局棋，客来浅酌旋分题。\n画栏占得春多少，帘捲东风日未西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢酒","author":"陈起","text":"罢酒寻花涉断矶，颠跻犹复强褰衣。\n可怜醉眼无分别，却把旁边柳折归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄彭勿庵","author":"陈起","text":"一片巴江月，移辉到庾梅。\n孤山春事早，疏影望东回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花怨为汪耘业赋","author":"陈起","text":"峥嵘岁事春将至，寂寞梅花雪失期。\n独有垂杨伴幽怨，岂堪临水折长枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"第三桥诗","author":"陈起","text":"梅花雪岸去舟单，茅屋水田白鹭寒。\n好景几回吟不得，重来无语立阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中三绝 其一","author":"陈起","text":"一天和气到柴门，槛内兰芽也玉温。\n静炷衙香谁与伴，慈悲大士共黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中三绝 其三","author":"陈起","text":"可怜切切度众生，千百年来魄尚灵。\n自幼归依今老矣，濯云晓汲荐清泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中三绝 其二","author":"陈起","text":"探梅又复负前盟，曾念霜风病不禁。\n清晓担头和雪买，数枝亲插供观音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中简赵德行","author":"陈起","text":"滕六庭前三致意，应翻奚锦报琼瑶。\n剡梅莫讶山阴棹，寒色欺人是灞桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后","author":"陈起","text":"青山当户牖，雪后非吾有。\n为问谢家池，绿波还在否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上曲","author":"陈起","text":"鞦韆索外阑干侧，一曲凝云花影直。\n玉瓶风暖醉忘归，春水不分杨柳色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葵窗送酒","author":"陈起","text":"久藏斗酒谋诸妇，婢子仓皇错授醯。\n解后芸居初止酒，小厨海错旋开泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬成贤良","author":"陈起","text":"献璞无成喜弄璋，世间得失事相参。\n刘蕡不得言时事，半为当时记朴庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西窗食芹稿","author":"陈起","text":"曾味西窗稿，经年齿颊清。\n细评何物似，碧涧一杯羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薄暮","author":"陈起","text":"寂寥谁作侣，耿耿一寒釭。\n薄暮西风急，呼童掩却窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三江斗门","author":"陈起","text":"短艇漾秋霞，江村数百家。\n水声鸣轣辘，山骨瘦槎枒。\n自笑如浮梗，何期又泛楂。\n人传前岸石，曾化作虾蟆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分得无题","author":"陈起","text":"露杯云馆昔相留，解佩人归暗绿洲。\n八斗才高空赋洛，九层台迥易悲秋。\n定知玉凤人吹怨，还念金龟婿远游。\n屏曲鸳鸯三十六，夜凉谁与结绸缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台桐柏观李高士惠诗兼寄其游山纪咏一编且复见招予不能赴约敬次来韵以谢","author":"陈起","text":"景物写成编，清新人竞传。\n风轻花自若，雨骤鸟悽然。\n老我尘中累，多君物外仙。\n未能抛世虑，山馆借床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨作","author":"陈起","text":"无成老见过，望望太平歌。\n惊雨愁扃户，闻风虑偃禾。\n杯中醇止久，瓶底粟无多。\n畎亩忧时切，天乎少警何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰亭归途","author":"陈起","text":"山水佳如此，都忘客路难。\n鸥明寒渚净，雁入野田宽。\n事久人多厌，心清梦却安。\n独怜鸾翼远，谁念箧衣单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同毛谊夫喻可中夜汎西湖","author":"陈起","text":"又复移舟践旧盟，喜随师友挹湖光。\n一番雨势生秋意，几处蝉声送夕阳。\n亭榭家家增藻饰，星河岁岁曜文章。\n断桥向午蟾方出，载月乘风更举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安晚先生送自赞太上感应篇帙首御题诸恶莫作众善奉行八字辅以佑圣像一轴两诗见意云 其二","author":"陈起","text":"稽首玄真像，当年助我军。\n龟蛇裨圣武，龙凤焕奎文。\n剑耸烧空焰，旗翻渡海云。\n上公传琬琰，分惠感慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安晚先生送自赞太上感应篇帙首御题诸恶莫作众善奉行八字辅以佑圣像一轴两诗见意云 其一","author":"陈起","text":"公衮殊相念，奇书寄布衣。\n此心才动处，万善要同归。\n本旨详敷衍，奎题重发挥。\n应怜蘧伯玉，投老始知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观羊吟","author":"陈起","text":"拂石坐秋绿，寓目山之阳。\n有白类积雪，谁放前村羊。\n冗蹄求一饱，寒草嚼峁藏。\n日晚山下路，西风吹稻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉解后友人留饮","author":"陈起","text":"倦叟寻芳藉短筇，故人解后一尊同。\n明霞浸水疑铺锦，彩阁横溪俨卧虹。\n猿去复归啼晓嶂，僧来相伴立春风。\n雪涛湍激开寒闸，涤尽尘襟万虑空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呜呜","author":"陈起","text":"呜呜画角悲，又复掩柴扉。\n夜月云千里，春城水四围。\n连宵灯报喜，几日鸟啼归。\n飞尽东郊絮，谁怜尚夹衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀三山友人","author":"陈起","text":"春前深惜别，病后政无诗。\n青又生菱角，红应熟荔枝。\n鱼甘宾席暖，风逆客帆迟。\n徒结连宵梦，邮音负所期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汪夫人筵上口号","author":"陈起","text":"今朝王母宴西池，葱茜祥烟霭绣帷。\n坐摘蟠桃华寿席，行看丹桂发孙枝。\n鱼轩锦毂花千叠，鸾诰金铃络四垂。\n好是殷勤千岁祝，老莱先酌后门楣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还刘雪坡词藁","author":"陈起","text":"谁与分天巧，裁成云锦裳。\n春花笼淡月，秋水照斜阳。\n得句皆奇伟，知音尽老苍。\n尚期京国路，相与较宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜听诵太极西铭","author":"陈起","text":"六经宇宙包无际，消得斯文一贯穿。\n万水混茫潮约海，三辰焕烂斗分天。\n鸢鱼察理河洛后，金玉追章秦汉前。\n遥夜并听仍闇味，奎明谁敢第三篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉酬竹溪陈史君新诗墨梅之贶","author":"陈起","text":"千里双鱼贲草堂，中藏瑰异夜腾光。\n兴因东阁增怀想，影落前荣不寄香。\n四韵休誇毛颖伎，几回曾误寿阳妆。\n感公意过兼金馈，惭乏琼琚展报襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信步","author":"陈起","text":"信步过高岗，随僧到上方。\n泉侵松径润，风出稻畦芗。\n地险人谁问，山深屋亦藏。\n惜无碑可考，创立自南唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋步吴济川别业","author":"陈起","text":"闻逐秋云去，东西任所如。\n偶过扬子宅，尽见邺侯书。\n疏竹难藏鹤，清流可数鱼。\n隔墙秋更迥，残柳夕阳初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜怀康节","author":"陈起","text":"无眠辗转听更残，心绪如丝起万端。\n煎药炉边童梦晓，读书檠下妇纫寒。\n狻猊断火香犹婉，促织催秋袂怯单。\n愿子大贤康节语，此情于我一般般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵监簿寄建宁诸诗","author":"陈起","text":"推敲久不见新裁，函轴光芒寄草莱。\n音调似于清庙听，风骚知自建安来。\n每嗟衰晚同篱菊，岂意先春得岭梅。\n拂拭尘轩对清绝，愧无锦段报琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送印寒邓簿得阙西归","author":"陈起","text":"才藻世于家，勾朱新职华。\n学能如艺木，春到可生花。\n野店寒吟月，轻装晓度沙。\n君行余止酒，一念一兴嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨明叔上舍归蜀","author":"陈起","text":"东书西向溯波行，霜冷风凄定几程。\n客枕夜长熊入梦，故园春到燕来迎。\n丈人山上芝堪友，西子湖边柳结情。\n回首尧天乡月皎，对床那不忆难兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送贺某赴兴化任 其二","author":"陈起","text":"壶山邈千里，旌旗拂摇空。\n是邦足文物，教宜先泮宫。\n嗟余病十载，置身药裹中。\n追送不能远，望望昼锦红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适安夜访读静佳诗卷","author":"陈起","text":"情同义合亦前缘，得此兰交慰晚年。\n旋爇古香延夜月，试他新茗瀹秋泉。\n君停逸驾谈何爽，客寄吟编句极圆。\n可惜病翁初止酒，不能共醉桂花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适安招游汤镇不果赴","author":"陈起","text":"汤镇古祠宫，招邀及倦翁。\n轻裘乘晓月，骏马逐东风。\n野色观无分，春光病见攻。\n行将迎诞日，一瓣拟遥通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻邻寺粥","author":"陈起","text":"寒釭旋擿动冥搜，泓玉摩研万象愁。\n铁版响廊催早粥，铜壶添水易新筹。\n一声鸡唱惊残梦，再听鸦群过小楼。\n可惜秋光帷帟隔，料应河汉五更收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"借居值雪","author":"陈起","text":"已叹长安索米难，可禁风雪满长安。\n无家又是于人借，有命从来只自宽。\n春入园林根觉煖，色连天地眼生寒。\n西湖寂寞梅无伴，合向孤山忍冻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林夫人","author":"陈起","text":"懿德遐龄世所尊，浓薰班马到诸孙。\n疏荣花诰加宏邑，赐第兰阶侈异恩。\n了了三乘言外趣，如如一性定中存。\n鱼轩应向西方去，知在莲花第几根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽宣教郎新差通判庆元府王琮","author":"陈起","text":"前月相过了无恙，小窗画卷手亲开。\n不知翁作仙游去，忽见儿封圹记来。\n寂寂芸居香不断，悽悽松坞韵堪哀。\n客中为洒秋风泪，尚想吟魂绕夜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽梅屋","author":"陈起","text":"桐阴吟社忆当年，别后攀梅结数椽。\n湖海有声推逸韵，弓旌不至叹遗贤。\n儿收残稿能传业，自志平生不愧天。\n航便双鱼无复得，夹山西望泪潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耘业许印章四韵叩之","author":"陈起","text":"近因稚子传来意，知许衰翁两印章。\n字画莫教凡手刻，形模当取古人长。\n六书今独行秦峄，三体空闻设汉庠。\n后世阳冰能复古，未知何日寄文房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]