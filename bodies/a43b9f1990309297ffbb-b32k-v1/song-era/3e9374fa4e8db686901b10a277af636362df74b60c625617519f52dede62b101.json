[{"title":"万太博知惠州","author":"祖无择","text":"惠州君未到，听我送君吟。\n去路九韶石，邻封八桂林。\n下车秋色老，望阙海云深。\n善政多馀暇，无忘惠好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀寄呈莱州张学士","author":"祖无择","text":"从作东齐吏，经年寡往来。\n朱颜随日减，青眼为山开。\n学政惭能政，论材信不材。\n何人慰孤寂，知己在蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"升州保宁寺凤皇亭","author":"祖无择","text":"凤台虽旧址，亭榭斩新开。\n荆棘榛芜去，江山气象来。\n明君虞氏化，贤守次公才。\n迟尔离丹穴，飞飞止此台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"历城郡治凝波亭","author":"祖无择","text":"耽耽层构俯清涟，山色波光晓共鲜。\n形胜增雄齐十二，风流素盛客三千。\n铺舒柳影眠鸥渚，欺压莲香载妓船。\n公退每来须度日，尘缨未濯愧潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"右军墨池","author":"祖无择","text":"羌庐峰下归宗寺，曾是当年内史居。\n茧纸世传遗迹后，墨池人记作书初。\n秋毫几老崇山兔，旧法空观得水鱼。\n珍重僧家能好事，朱栏碧甃壮庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田四秘丞通判镇戎军","author":"祖无择","text":"身纡茜绶朝章贵，手把芝函帝命新。\n方朔上书曾自荐，祁奚外举果知人。\n运筹暂逐征西将，持橐看归拱北辰。\n我亦潜心禦戎策，羡君抗旆拥朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石伞峰书堂","author":"祖无择","text":"伊人高步接夔龙，旧隐荒凉石伞峰。\n莘野躬耕闻往事，傅岩代筑见遗踪。\n草茅岂合掩崇业，竹帛终能纪茂庸。\n朝暮油云肤寸合，何妨霖雨遍三农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙图范给事以禫服向除修治茔域就山筑室因尔书怀俾无择继和谨次用其韵","author":"祖无择","text":"采采陔兰负养亲，几思定省泣晨昏。\n三年已毕先王制，画日将承圣主恩。\n名遂自同周柱史，谏违谁记鲁臧孙。\n考槃在涧虽云乐，祗恐泥书到远村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同年杨兄作尉僰道兼领勾稽之作赋七言四韵诗以送之","author":"祖无择","text":"县城荒僻民居少，吏事全稀似隐沦。\n且喜桑郊接乡树，莫嗟蓝绶染京尘。\n鸾姿岂合淹仇览，仙骨应难滞子真。\n好在公馀频寄问，我方江上学垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其十","author":"祖无择","text":"吏隐宜春郡，素飧诚有馀。\n政声惭遂霸，文藻谢严徐。\n使节分铜虎，仙庐秘石渠。\n君恩殊未报，不敢赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其九","author":"祖无择","text":"吏隐宜春郡，穷能懒更占。\n矜名遭巧谮，晦迹喜深潜。\n昔慕狂为圣，今师智养恬。\n优游无一事，不觉岁时淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其八","author":"祖无择","text":"吏隐宜春郡，放怀诗酒间。\n未能惭下俚，几欲效中山。\n杜甫籓篱窄，刘伶幕帟悭。\n高吟与沈醉，荣辱讵相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其七","author":"祖无择","text":"吏隐宜春郡，山城少客过。\n静中窥物理，闲外养天和。\n春暖寻花坞，宵凉玩月波。\n将迎者谁子，劳逸两如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其六","author":"祖无择","text":"吏隐宜春郡，同僚得俊髦。\n纯音等疏越，馀刃剧豪曹。\n器识青云远，歌词白雪高。\n遂令迁客意，不复赋离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其五","author":"祖无择","text":"吏隐宜春郡，乡园去路赊。\n间关成客宦，荏苒度年华。\n出水鱼吞饵，辞山凤在笯。\n谁言千里隔，夜夜梦吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其四","author":"祖无择","text":"吏隐宜春郡，闲思应举时。\n端居苦贫贱，徒步入京师。\n误宠乘轩鹤，钧忧入庙牺。\n功名在何许，双鬓已垂丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其三","author":"祖无择","text":"吏隐宜春郡，追惟二相贤。\n节明天宝日，业茂会昌年。\n友善曾何累，朋诬亦自煎。\n不才非不幸，异代若差肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其二","author":"祖无择","text":"吏隐宜春郡，溪山若画图。\n纤鳞时自跃，幽鸟静相呼。\n晓浪喷寒雨，晴岚锁绿芜。\n渔樵本吾事，搔首重踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏隐宜春郡诗十首 其一","author":"祖无择","text":"吏隐宜春郡，年丰狱讼稀。\n馀粮委南亩，茂草满圜扉。\n天意怜艰食，民心耻画衣。\n万家行乐处，车马有光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寺有四绝一曰灵岩予以赴官获此税鞅因赋拙句用志其行","author":"祖无择","text":"常想灵踪得到难，因回征辔此盘桓。\n松风逗磬僧斋冷，石水环堂客梦寒。\n圣作自同尧典布，古碑犹是魏朝刊。\n最怜山色当楼好，欲去重来一凭阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和酬张兟秀才见寄","author":"祖无择","text":"倾盖相知分不同，远凭邮置枉缄封。\n题评祗益烦更品，刻画何曾补陋容。\n綵服侍行君得意，朱轓假守我劳悰。\n论文未遂西斋约，早晚重亲太华锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏二首 其二","author":"祖无择","text":"形胜山前感物华，却乘清兴过僧家。\n楼台消废无人问，今古传闻只自嗟。\n云拥断崖埋石笋，泉冲凉雨落金沙。\n凭君识得寻幽趣，只管高谭至日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至齐五月两院狱空喜而成咏","author":"祖无择","text":"厌预铃斋议，欣闻狱犴空。\n三章用旧制，五月绍遗风。\n止系垂衣治，非干别驾功。\n惟期四海内，刑厝与周同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次张泽阻风","author":"祖无择","text":"舟楫虽佳兴，风波即畏途。\n我心何所惧，世路此无殊。\n衔尾千艘泊，争头万怪趋。\n飘然不终日，挥手谢淳洿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋嘉言雅善飞白一日书八字贶予因成长句谢之","author":"祖无择","text":"轻如浮雾重如云，学到精微妙入神。\n奇迹昔年传垩帚，高名他日压乌巾。\n誇呈朋友防求副，留教儿孙恐失真。\n天子清閒好挥翰，似君须合侍严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张寺丞鸣玉亭书事","author":"祖无择","text":"为怜潇洒近城闉，来往何曾问主人。\n列岫晓昏云郁郁，流泉秋净石粼粼。\n陆机诗就伏招隐，班固文成正答宾。\n愁见西峰日将暮，却驱羸马入埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张唐民下第东归","author":"祖无择","text":"学古功非浅，干时命尚迍。\n拾青辜壮志，垂白念慈亲。\n归路天同远，生涯世自贫。\n吾知君道大，驰逐老风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈康赴江西掾","author":"祖无择","text":"高誉冠时英，人皆倒屣迎。\n决科材尚屈，掌狱职仍轻。\n滕阁吟登健，吴山醉望清。\n公馀如访古，一为问丰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羌先生庙","author":"祖无择","text":"先生高世迹，旧隐白云深。\n结宇知何代，遗祠直至今。\n地分坛杏影，门接社莲阴。\n我亦希风者，终明托玉岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和阎运使以诗见奖吏隐宜春郡诗","author":"祖无择","text":"狂吟何足话风骚，和寡甘降郢唱高。\n敢望与言同子夏，竞推多可似山涛。\n九成岂后虞韶美，一字终虚鲁史褒。\n自笑潢污不盈尺，犹将学海去滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和御制赏花钓鱼","author":"祖无择","text":"禁籞春深御幄开，鸣鞘晓出五云来。\n花含瑞色三危露，酒湛晴光万寿杯。\n香饵得鱼波滉漾，仙音仪凤日徘徊。\n微臣叨窃逢辰幸，行橐甘泉此从陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和题东湖","author":"祖无择","text":"晴烟羃幂澹湖光，势胜居然占一方。\n拂水万丝杨柳弱，倚风千盖芰荷香。\n纵游闲泛兰舟稳，半醉狂眠石席凉。\n公退每来须度日，却疑身出利名乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官况","author":"祖无择","text":"物态无端固尽谙，自为俗吏欠清谈。\n岂忧官况全萧索，祗畏人言足二三。\n玉勒已辜寻晓陌，锦鳞犹忆钓秋潭。\n公馀自遂疏慵性，从道嵇康七不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚辰清明州衙不送新火","author":"祖无择","text":"禁烟故事存遗俗，改火平时有旧章。\n纵道齐民皆按堵，堪惊烜氏昧修方。\n晨炊已绝供宾馔，春酒何来独酌觞。\n不似前年为客日，富邻犹许借馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明水镇水陆禅院","author":"祖无择","text":"谁卜精蓝若画屏，四边山色与泉声。\n野僧惯见心应乐，俗客偷来骨亦清。\n晚吹乍回香篆破，晓云才散蜡灯明。\n吏人莫怪徘徊久，自得闲情减宦情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泗水","author":"祖无择","text":"纪地复涵虚，清疑颢气俱。\n东家遗教远，夏后建功殊。\n冷色平吞鲁，长波迥胜吴。\n如斯无少息，体道悟真儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经剑池","author":"祖无择","text":"巧冶何年百炼金，刜钟芒刃此湮沉。\n气冲牛斗虽难掩，鉴遇张雷始见寻。\n恍惚莫穷神物远，波澜空在曲池深。\n铅刀也强思磨试，怅望西山与华阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视役于清偶书四韵寄示幕中宾客","author":"祖无择","text":"经旬一水湄，风土化缁衣。\n岂敢嗟于役，何当赋式微。\n云山晴特秀，花木暖相辉。\n期子同携手，春游事勿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试笔","author":"祖无择","text":"济南通守欲几年，最课无成愧古贤。\n却为簿书抛笔砚，每思樵钓负林泉。\n浮名自信虽徒尔，薄俸相拘且勉旃。\n已共妻孥约生计，会须搔首赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康春日","author":"祖无择","text":"惭愧东风破腊来，一尊清圣为君开。\n无方可使朱颜驻，有客相逢白眼回。\n老大渐能知世态，疏慵那复计身媒。\n遥怜伊洛冰应泮，芳草还荒旧钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春郊即事","author":"祖无择","text":"东方驱晓骑，南亩劝春耕。\n试与牧童语，因知林鸟名。\n雨前茶正小，社后酒犹清。\n可笑豚蹄祝，篝车望岂轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日感怀","author":"祖无择","text":"多病多愁客，新秋百感生。\n异乡违土性，孤宦见人情。\n案厌留灯读，田思带雨耕。\n不堪临晓镜，潘鬓二毛成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诮王安石乞分司西京避谗而去因以述怀","author":"祖无择","text":"割断攀缘宰相权，忧危争似我身全。\n试观竿上抛生体，且拟波中戏钓船。\n名利不求还独乐，是非莫辨祗高眠。\n何当对景幽堂坐，更得闲吟度百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人作尉临潼","author":"祖无择","text":"年少文能老，新曾射策来。\n从横传古学，慷慨济时才。\n黄绶官徒尔，青云志在哉。\n他年归会课，迟子出尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘进士游边","author":"祖无择","text":"朔风动地雪花明，去去从知指戍城。\n场藿未縻千里骥，食鱼翻嗜五侯鲭。\n征途望断河冰合，旅馆吟残海月生。\n且共淹留话离索，一尊浊酒为君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送宋寺丞通判邛州","author":"祖无择","text":"半刺侯藩重，临邛驿路赊。\n将经灞陵树，先看洛阳花。\n土物张骞竹，民封卓氏家。\n为君伤远目，日日断褒斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李承知京兆司录","author":"祖无择","text":"才从知己荐，又应辟书行。\n廷尉官联重，军谋职任清。\n华严东野秀，紫阁晚峰横。\n尽是供吟处，归应新筑成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孟湘虞部赴阙","author":"祖无择","text":"科名拾芥职三虞，落落雄才与众殊。\n为政人惊今遂霸，论兵自比古孙吴。\n倚庐已见因心著，结绶还陪辨色趋。\n不似冯唐空白首，汉皇今正渴嘉谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送承泽上人归宁富沙","author":"祖无择","text":"五老峰前见，过从一岁馀。\n还将随客棹，归去侍亲舆。\n乞食江云际，牵吟腊雪初。\n祗应清夜梦，时复到荒庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春长句呈李泰伯","author":"祖无择","text":"尽日临风把酒卮，宜春台上送春归。\n已看绿树阴阴静，犹有残花帖帖飞。\n岁月任从随手过，功名未必与心违。\n我缘客宦无常处，后会如今亦恐稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩尉员外","author":"祖无择","text":"几年献赋向公车，四十方为冉冉趋。\n昔竞寸阴终蹭蹬，今贪斗粟尚踟蹰。\n潘郎毛鬓看将白，陶令田园说已芜。\n官满还归省门下，预应搔首重长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新州陈式虞部","author":"祖无择","text":"大庾岭南郡，新兴事若何。\n还珠合浦近，辟恶密香多。\n主圣天如覆，时平海不波。\n更逢贤太守，应有裤襦歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭郓州孔给事 其二","author":"祖无择","text":"圣孙家世嗣衣缨，夫子当朝有令名。\n许国志坚存亮直，致君心切赞隆平。\n明庭抗疏忠言在，列郡班条惠化行。\n不享永年兼大用，终天遗恨负苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭郓州孔给事 其一","author":"祖无择","text":"出入多年侍紫宸，封章频上触龙鳞。\n杼投几见疑慈母，槛折终闻记直臣。\n阙里忽惊歌曳杖，洛阳那复见埋轮。\n师门一恸盈襟泪，痛为明时惜正人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏州叛","author":"祖无择","text":"羌虏奸诛轸圣忧，出师十万拥貔貅。\n朝廷命将诗书府，廊庙论兵帷幄筹。\n舜后舞干期振旅，汉臣投笔待封侯。\n宣王六月存周雅，愿继徽声颂国猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中即书南事","author":"祖无择","text":"军垒无多事，朝晡且放衙。\n吏人如野鹿，公署似僧家。\n京信因求药，宾欢为斗茶。\n忘怀尘俗外，枕籍祗南华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题女郎台","author":"祖无择","text":"女郎台上寺，寺影蘸湖光。\n夜梵星辰近，晨斋鸟雀忙。\n烟滋杨柳绿，风逞芰荷香。\n欲下还慵去，凭阑到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"监丞萧君见贻嘉句仍惠芳醪强率鄙词辄继高韵聊资逌尔深愧斐然","author":"祖无择","text":"迟日和风婉娩春，感时情思浩无津。\n烦君远寄中山酒，顾我方为洛社人。\n濡笔便思题素扇，当尊难借吐芳茵。\n已钦才妙兼怀惠，相过文场愿捧轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读王元之后集题于卷末","author":"祖无择","text":"提笔几回书诰命，剖符长是守方州。\n未能抗表分司去，终老为郎谪宦休。\n歌舞懒呼寒食节，醉吟孤坐月波楼。\n文章独步成何事，空有离骚寄隐忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄千乘刘殿丞求字人编","author":"祖无择","text":"千乘刘夫子，高名继谪仙。\n从居庇身邑，已著字人编。\n才入钟嵘品，文期郑氏笺。\n何当求副本，长愿播匏弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄信安判官张秘校","author":"祖无择","text":"莲幕从军客，蓬仙典校人。\n才章过鲍谢，交契敌雷陈。\n婉婉谋画暇，翩翩书问频。\n徒知感高义，犹阻奉清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄泰山孙复","author":"祖无择","text":"先生心与白云闲，五十秋风鬓不斑。\n自有清名满天下，更无尘迹到人间。\n朱铅乐外非攸好，贪懦闻风合厚颜。\n不待高吟见招隐，见收馀俸买青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄颍州兄","author":"祖无择","text":"川陆一千里，炎凉六十旬。\n意通书信少，思入梦魂频。\n身外宦情薄，眼前人事新。\n祝兄无见念，忧道不忧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄献阙下一二知己","author":"祖无择","text":"公道当朝绝比伦，因凭暖笔变孤根。\n才冲霰雪游梁苑，便逐风雷化禹门。\n南郡已甘抛绛帐，东州何幸佐朱幡。\n心怀象魏身江海，两地悠悠欲断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题汉州西湖兼简知郡马屯田","author":"祖无择","text":"房相留遗爱，清风湖水长。\n人思浴池凤，谁识济川航。\n白雪徽音远，洪钧道化光。\n还闻继高躅，新有召公棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄澶州孙司理","author":"祖无择","text":"明道二年同夏课，四人两举尽登科。\n孤寒惟子辛勤甚，虚薄伊余忝窃多。\n宦路驱驰今各自，名场出处旧相过。\n感今怀旧无憀赖，不觉临风发浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]