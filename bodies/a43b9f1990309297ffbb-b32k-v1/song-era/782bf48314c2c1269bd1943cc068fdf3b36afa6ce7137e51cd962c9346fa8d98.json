[{"title":"汀州","author":"宋思远","text":"全闽形势数临汀，赣岭连疆似井陉。\n江汇里渊锁地脉，山横华盖应天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定光南安岩 其一","author":"郑弼","text":"石耸灵岩接太虚，百千年称定光居。\n未知天上何方有，应是人间别地无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪陈太守游南山道院","author":"宋贶","text":"漫陪仙吏访仙乡，仙室倾颓径路荒。\n碧草护坛麇有迹，红桃照井水浮香。\n岩边鹤返曾千岁，梦里丹分近一囊。\n最怜仙术神如此，何不霞新炼药房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"宋贶","text":"鳌分双岛江心寺，鹢散连樯海面舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"社日不饮","author":"宋恭甫","text":"漪漪细浪生蒲叶，剪剪轻风破柳芽。\n不饮恐孤今日社，强随儿女插桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"在燕京作","author":"宋恭宗","text":"寄语林和靖，梅花几度开。\n黄金台下客，应是不归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹦鹉","author":"宋恭宗","text":"毛羽自然可数，仙禽不受凡笼。\n衔得梧桐一叶，中含无限秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白石山","author":"宋晋之","text":"日车未访到仙宫，日脚将西又转蓬。\n莫怪登山能草草，祗缘行李自匆匆。\n玉棺已去人何在，石鼎虽存味早空。\n休羡古来名与迹，几多丘壑在胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"宋泰发","text":"薰风将雨熟黄梅，忙里偷闲此地来。\n更欲少留偿逸兴，长官却怕晚衙催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五峰岩","author":"刘涛","text":"五峰岩在白云间，岩下千山与万山。\n莫向公卿容易道，恐伊来此一生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次陆务观韵","author":"宋甡","text":"欲求平易多成拙，稍涉新奇却未工。\n得句直须参造化，此身何必计穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内香药库诗赞","author":"赵恒","text":"每岁沉檀来远裔，累朝珠玉实皇居。\n今辰内府初开处，充牣尤宜史笔书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛牙赞","author":"赵恒","text":"西方大圣号迦文，接物垂慈世所尊。\n常愿进修增妙果，庶期饶益在黎元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"批杨亿谢表","author":"赵恒","text":"承明近侍究儒玄，苦学劳心疾已痊。\n善保兴居调饮食，副予前席待多贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐古藏用","author":"赵恒","text":"海霞照灼散青烟，历历星榆在晓天。\n松韵寒烟绝世态，鹤翔高顶应鸣弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐知贡举晁迥 其二","author":"赵恒","text":"盛时选士贡闱开，殿宇闻风献艺来。\n心似权衡求实效，勿教蓬荜有遗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐知贡举晁迥 其一","author":"赵恒","text":"礼闱选士古称难，都为升沉咫尺间。\n较艺清时公道在，抡材应得惠人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐道人郑隐归山","author":"赵恒","text":"尽日临流看水色，有时隐几听松声。\n遍游万壑成嘉遁，偶出千峰玩治平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐僧义澄","author":"赵恒","text":"止观心地法，色相本皆空。\n禅慧明宗性，超然万法中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠 其一","author":"赵恒","text":"春律行将半，繁枝忽竞芳。\n霏霏含宿雾，灼灼艳朝阳。\n戏蝶栖轻蕊，游蜂逐远香。\n物华留赋咏，非独务雕章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠 其二","author":"赵恒","text":"翠萼凌晨绽，清香逐处飘。\n高低临曲槛，红白间纤条。\n润比攒温玉，繁如簇绛绡。\n尽堪图画取，名笔在僧繇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐杨亿判秘监","author":"赵恒","text":"琐闼往年司制诰，共嘉藻思类相如。\n蓬山今日诠坟史，还仰多闻过仲舒。\n报政列城归觐后，疏恩高阁拜官初。\n诸生济济弥瞻望，铅椠咨询辨鲁鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐神童蔡伯禧","author":"赵恒","text":"七闵山水多才俊，三岁奇童出盛时。\n家世应传清白训，婴儿自得老成资。\n初尝学步来朝谒，方及能言解诵诗。\n更励孜孜图进益，青云千里有前期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐詹骙","author":"赵恒","text":"名阅誇詹氏，新居古五云。\n擢科魁众士，拔萃喜超群。\n礼肃人畏敬，胪传世共闻。\n好将多锦绣，五色耀龙文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又将放榜","author":"赵恒","text":"四海为家宝绪隆，旁求文雅振儒风。\n命乡随计来多士，较艺抡材有泽宫。\n簪绂近臣当显任，丝纶深旨论丹衷。\n旰宵汲汲予存念，夙夜孜孜尔徇公。\n名实岂惟衡鉴内，贤能皆萃网罗中。\n伫观翘楚登时用，布政分忧协庶功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐丁谓 其二","author":"赵恒","text":"践历功皆著，咨询务必成。\n懿才符曩彦，佳器贯时英。\n俾展经纶业，旋升辅弼荣。\n嘉亨忻盛遇，尽瘁罄纯诚。\n均逸明恩洽，畴劳茂典行。\n白麻三殿晓，红旆九衢平。\n虽辍凝严任，尤增倚注情。\n拥旄辞帝阙，顿辔望都城。\n风景高秋月，烟波几舍程。\n想卿怀感意，常是梦神京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐王钦若除太子太保判杭州十韵","author":"赵恒","text":"早自外朝登近侍，克符昌运振嘉名。\n一参黄阁推良画，再陟鸿枢显至荣。\n该博古今堂献纳，勤劳夙夜每专精。\n石渠撰述多文备，日观封崇大礼成。\n宰府调元心匪懈，真宫兼职望弥清。\n龙楼进秩恩尤异，熊轼为藩任不轻。\n二浙奥区期惠化，三吴佳致悦高情。\n重重山水舟中见，处处壶浆陌上迎。\n既肃迩遐安外域，更分宵旰抚黎氓。\n予衷侧席方毗倚，伫有甘棠播颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐陈尧叟谢病归济源","author":"赵恒","text":"文苑垂清誉，朝端仰盛才。\n嘉猷毗万路，奇遇列三台。\n勤职兴居爽，辞荣奏疏来。\n畴咨登百揆，异数冠中台。\n巨屏扬旌去，名藩昼锦回。\n君臣相厚意，瞻望两徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐知贡举钱惟演","author":"赵恒","text":"寅奉昌图绍庆基，选抡多士叶前规。\n乡闾荐拔期无滥，草泽搜罗讵有遗。\n德举况逢全盛日，计偕咸造广场时。\n春官任职当求善，宗伯抡材务得宜。\n侍从名儒当委任，艺文公道辩妍媸。\n伫伸衡鉴裁深念，允协菁莪乐育诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北征回銮诗","author":"赵恒","text":"锐旅怀忠节，群胡窜北荒。\n坚冰销巨浪，轻吹集隹祥。\n继好安边境，和同乐小康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观龙歌","author":"赵恒","text":"四灵之长惟虬龙，虬龙变化故难同。\n三茅福地群仙宅，灵物潜形在此中。\n池内仙人驯扰得，至今隐现谁能测。\n乘云蠢动独标奇，行雨嘉生皆荷力。\n常人竞取暂从心，才出山楹兮无处寻。\n中使勤求深有意，欲献明庭兮陈上瑞。\n初献一龙朝魏阙，偶挹二龙离洞穴。\n人心龙心若符契，一去一住何神异。\n我睹真龙幸不惊，至诚祝龙龙好听。\n但祈风雨年年顺，庶使仓箱处处盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"励学篇","author":"赵恒","text":"富家不用买良田，书中自有千钟粟。\n安居不用架高楼，书中自有黄金屋。\n娶妻莫恨无良媒，书中自有颜如玉。\n出门莫恨无人随，书中车马多如簇。\n男儿欲遂平生志，五经勤向窗前读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台山","author":"赵恒","text":"混元为教合醇精，视之无迹听无声。\n唯有达人臻此理，逍遥物外事沈冥。\n浮云舒卷绝常势，流水方圆靡定形。\n乘兴偶然辞涧户，谈真俄尔谒王庭。\n顺风已是闻宗旨，枕石还期适性情。\n玉帛簪缨非所重，长歌聊复宠归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐丁谓 其一","author":"赵恒","text":"懿辞硕画播朝中，造膝询谋礼遇丰。\n文石延登彰顺美，高牙前导表畴庸。\n书生仗钺今尤贵，旧里分符古罕逢。\n昼锦买臣安敢比，黄枢早日接从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞胡家","author":"赵恒","text":"一门三刺史，四代五尚书。\n他族未闻有，朕今止见胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"赵恒","text":"酣醉皮裘思晦迹，行高终自有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"赵恒","text":"臣守但当守公法，驰骛苟进何可取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"赵恒","text":"该明圣典通今古，发启冲年晓典常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐熙设色花鸟","author":"赵构","text":"人言道院属江西，古一真人卧水湄。\n可是瑞莲花叶大，载他书册泛涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇恩显义院 其四","author":"赵构","text":"海神来过隐风回，浪打天门石壁开。\n浙江八月何如此，清似连山喷雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇恩显义院 其三","author":"赵构","text":"管妙弦清韵入神，老人合眼醉醺醺。\n成知不及当来曲，犹觉闻时胜不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇恩显义院 其二","author":"赵构","text":"松竹幽禽尺素间，恍然真向雪中看。\n动摇已自清风足，何况丹青写岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别和甫赴南徐","author":"王安石","text":"都城落日马萧萧，雨压春风暗柳条。\n天际归艎那可望，只将心寄海门潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇恩显义院 其一","author":"赵构","text":"春莺叶底引圆吭，临罢黄庭日更长。\n满院柳花寒食后，旋钻新火爇炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅岩","author":"赵构","text":"怪石苍岩影翠霞，梅梢疏瘦正横斜。\n得因祀事来寻胜，试探春风第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虚堂","author":"赵构","text":"虚堂燕坐悄无言，欲断残香冷自烟。\n秋色满山林桂静，一轮霜月泻寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐僧守璋二首 其二","author":"赵构","text":"久坐方知春昼长，静中心地自清凉。\n人言圆觉何曾觉，但见尘劳尽日忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐圆觉寺僧德信 其一","author":"赵慎","text":"古寺春山青更妍，长松修竹翠含烟。\n汲泉拟欲增茶兴，暂就僧房借榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画册 其四","author":"赵构","text":"不祷自安缘寿骨，人间难得是清名。\n浅斟仙酒红生颊，永保长生道自成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画册 其一","author":"赵构","text":"桃李无言春告归，落红如海乱莺啼。\n西村渡口斜阳里，渺渺烟波绿拍堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马麟画册","author":"赵构","text":"已过谷雨十六日，犹见牡丹开浅红。\n曾不争先及开早，能陪芍药倒薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马麟亭台图卷","author":"赵构","text":"后院深沉景物幽，奇花名卉弄春柔。\n翠华经岁无游幸，多少亭台废不修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题丹桂画扇赐从臣 其一","author":"赵构","text":"月宫移就日宫栽，引得轻红入面来。\n好向烟霄承雨露，丹心一一为君开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题丹桂画扇赐从臣 其二","author":"赵构","text":"秋入幽丛桂影团，香深粟粟照林丹。\n应随王母瑶池晓，染得朝霞下广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上杂咏 其一","author":"邹浩","text":"荷叶如钱三月时，幅巾藜杖一追随。\n尔来胜事知多少，惟有风标公子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题刘松年画团扇","author":"赵构","text":"南山晴翠入波光，一派溪声绕路长。\n最爱早春沙岸煖，东风轻浪拍鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画册花草四首 其二 修竹芙蓉","author":"赵构","text":"寒花婀娜露凝香，风叶摇秋凤尾凉。\n梦入画堂银烛下，翠屏深处隐红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵伯驹团扇月宫图册","author":"赵构","text":"清凉境界火云藏，但觉仙家日更长。\n千岁寿松谁宴坐，星君午夜吐光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题阎次平小景","author":"赵构","text":"西来白水满南池，走马池边日暮时。\n桥底荷花无限思，清香乞与路人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘珵西湖十洲 芙蓉洲","author":"舒亶","text":"照水横横蜀锦囊，年年泽国为谁芳。\n朱颜自得西风意，不管清秋昨夜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题燕文贵柳庄观荷图","author":"赵构","text":"万片绿荷流水西，乱风飘雨湿人衣。\n前村竹树田家密，时见軥辀屋后飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴己巳南郊礼成","author":"赵构","text":"清坛祗谒礼郊丘，辅相贤劳其款留。\n初讶密云低覆冒，遽看霁景上飞浮。\n气回俎豆群工泰，喜入貔貅万马秋。\n赫赫天心允昭格，协谋同德赖嘉猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐刘能真三首 其一","author":"赵构","text":"简易高人道，崇玄性自真。\n身常居太极，心已远凡尘。\n玉陛辞荣禄，瑶台役鬼神。\n辛勤三十载，羡尔道心淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐枢密院楼炤","author":"赵构","text":"朕念邦家历万几，幸卿相与久维持。\n孜孜广道诹询处，蹇蹇封章纳诲时。\n半世奇勋惟我重，一生忠节自天知。\n南归奚事将为赠，金石诗篇壮羽仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画册花草四首 其四 雪中山茶","author":"赵构","text":"名出本南山，来依琼苑间。\n陈主歌前树，杨妃醉后颜。\n为嫌脂太赤，故著粉微斑。\n共言攀折处，已获宝枝还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画册花草四首 其三 墨竹","author":"赵构","text":"墨花垂兔颖，千古尚漓漓。\n翠羽风前叶，秋声雨一枝。\n诗题春粉节，绷脱玉婴儿。\n湘浦人何在，空闻凤管吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中和堂","author":"赵构","text":"六龙转淮海，万骑临吴津。\n王者本无外，驾言苏远民。\n瞻彼草木秀，感此疮痍新。\n登堂望稽山，怀哉夏禹勤。\n神功既盛大，后世蒙其仁。\n愿同越句践，焦思先吾身。\n艰难务遵养，圣贤有屈伸。\n高风动君子，属意种蠡臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戎州","author":"苏轼","text":"乱山围古郡，市易带群蛮。\n瘦岭春耕少，孤城夜漏闲。\n往时边有警，征马去无还。\n自顷方从化，年来亦款关。\n颇能贪汉布，但未脱金镮。\n何足争强弱，吾民尽玉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其五","author":"赵构","text":"扁舟小缆荻花风，四合青山暮霭中。\n明细火，倚孤松，但愿樽中酒不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其十一","author":"赵构","text":"谁云渔父是愚翁，一叶浮家万虑空。\n轻破浪，细迎风，睡起蓬窗日正中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其十五","author":"赵构","text":"清湾幽岛任盘纡，一舸横斜得自如。\n唯有此，更无居，从教红袖泣前鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其三","author":"赵构","text":"雪洒清江江上船，一钱何得买江天。\n催短棹，去长川，鱼蟹来倾酒舍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]