[{"title":"禅人并化主写真求赞 其三○○","author":"释正觉","text":"发衰雪白，眼寒秋碧。\n壁立千寻，功消一色。\n体得有家风，心传亡辙迹。\n少林祖师兮岂会唐言，黄梅行者兮不识横画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七○","author":"释正觉","text":"眼冷眉长，鼻直气快。\n彼彼常不轻，门门观自在。\n寂光而无中，妙用而无外。\n谁怕肉团碍世界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七一","author":"释正觉","text":"智明而藏，净极而光。\n四大蛇非蛰，六窗猴不忙。\n因缘仍善应，机用更优长。\n觌面相逢出思议，自然随处露堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八四","author":"释正觉","text":"颠发山雪，眶瞳水秋。\n月白濯河汉，霁寒摩斗牛。\n韶意千华里，光风百草头。\n如幻三昧兮，妙得优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三○","author":"释正觉","text":"功转密藏，寻踪迹以无方。\n影现益彰，历因缘而有常。\n身分尘刹普，舌拄梵天长。\n心心不触菩提用，法法无依般若光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三八","author":"释正觉","text":"老境侵寻，衰残到今。\n霜须雪发春犹浅，壑眼岩眉秋更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二三","author":"释正觉","text":"眉目岩岩，身心静恬。\n万机自息，一默谁参。\n虚空兮霁云卷谷，清白兮夜月濯潭。\n春入丛林兮谩道化工百亿，神游浩劫兮底意真超二三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二五","author":"释正觉","text":"山向岳奔，川趋海吞。\n船浮水柔有力，雁没烟冷无痕。\n二三四七，传持之句。\n百千万亿，变化之门。\n招手授手，知恩报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一七","author":"释正觉","text":"毗卢之口闹嘈嘈，普贤之身闲飘飘。\n理无不备，事不相饶。\n小舟点点浮烟水，柔柳垂垂映竹桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七七","author":"释正觉","text":"梨杖横膝，衲衣拥肩。\n默为佛事，情忘世缘。\n家风空扫四壁，活计冷坐三椽。\n见闻声色外相讨，破晓青山啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九五","author":"释正觉","text":"慧而能定，定而能应。\n空有短长，初无欠剩。\n定慧力庄严，性相心齐證。\n妙观察智照非功，成所作智同圆镜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二七","author":"释正觉","text":"行起解绝，宗全说缺。\n根根尘尘兮元自现成，佛佛祖祖兮何劳施设。\n本色当行家，赏音个时节。\n迟日风流转柳腰，迁林语软调莺舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四五","author":"释正觉","text":"雪发霜髭，古岩阿师。\n坐寒空劫眼，机活用时眉。\n文殊靠倒维摩诘，帝释仰赞须菩提。\n如今吃饭下堂去，谁敢等闲欺石梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六七","author":"释正觉","text":"机锋不敏，神观不清。\n一点寒灰后，三乘热椀鸣。\n历代祖咽喉把定，十方心手段放行。\n春风剪剪兮，物像英英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九一","author":"释正觉","text":"精神自然，秋早春先。\n蟠胸丘壑，绕齿风烟。\n理无生而心传阿祖，神不死而道出诸仙。\n苍黄酢酬兮将军齿镞之日，黑白胜负兮樵子烂柯之年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二四","author":"释正觉","text":"静复湛存，潮退珊瑚之根。\n智随用奔，派发昆崙之源。\n光风草木献春像，霁夜鱼龙吞月魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五一","author":"释正觉","text":"一片閒心，十方充塞。\n春律行兮发华，秋风敛兮落木。\n谁调谁牧，不伤不触。\n万像同放光明，太虚了无棱骨。\n中规矩兮，东西南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二七","author":"释正觉","text":"老节疏踪，傲雪之松。\n真智證理，吟云之龙。\n饱丛林而彭亨肚，善知识而隗磊胸。\n春成万物兮平等无像，海吞百川兮自然有容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○○","author":"释正觉","text":"澄潭之月，苍山之雪。\n清白家风，灵明事业。\n秋空净无痕，野云闲不彻。\n如今借问旁观，且道看何行列。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十","author":"释正觉","text":"暗而明，虚而盈。\n水天秋色共，月昼夜潮平。\n无在不在，无生不生。\n诸尘随起倒，万化得纵横。\n默默大全兮壁挂闲口，堂堂正受兮谁黏恶名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一八","author":"释正觉","text":"众流吞海，大泽藏山。\n磨云月兮蟾蜍胆冷，卧风波兮鸥鸟情閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十八","author":"释正觉","text":"松石岁寒，云月高闲。\n野雪发须上，秋波眉睫间。\n用持智柄，静入道环。\n觉心了了，幻事斑斑。\n草木精神兮风流自得，丛林气像兮春信谁悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一六","author":"释正觉","text":"鼻直口四方，眉低眼三角。\n默默句难传，深深谁转脚。\n入挂树之壶，天地能阔。\n得烂柯之棋，黑白未错。\n如今更不囊藏，到处随宜著落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六九","author":"释正觉","text":"头上有骨，眼底无肉。\n分影月随流，閒心云出谷。\n万缘圆应兮廓周大千，一点灵虚兮默照幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十九","author":"释正觉","text":"赤肉一团，疏通数窍。\n惟色惟声，乃听乃眺。\n不借应而即真，不外虚而常照。\n长时默坐亡世机，万里青天绝飞鸟。\n谓尔画工，那得其妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五七","author":"释正觉","text":"云水之身，丛林之人。\n眉毛长盖眼，鼻孔直欺唇。\n等闲西院两声错，急快云门一路亲。\n不肯割城还夺璧，相如肝胆抑强秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一七","author":"释正觉","text":"了了常知，灵灵匪思。\n妙空三世，圆包二仪。\n针鼻长通线，梭脐细吐丝。\n出谷白云风断送，盈科流水月相随。\n普应群机兮，自然合宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一九","author":"释正觉","text":"眉目精神，画工装点。\n功转玄微，了无丝糁。\n秋天清而河气澄明，夜水白而月魂潋滟。\n物物头头应化身，超出机前有刑典。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二六","author":"释正觉","text":"白发苍颜，三篾住山。\n开眼不觉晓，静坐不知閒。\n善应全机用，灵明入道环。\n而今相伴尘中去，榆叶青钱莫我悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四六","author":"释正觉","text":"如圭如璧，雕文丧德。\n如云如石，坚润是式。\n苍竹无心岁寒色，老松有傲霜雪力。\n照破诸缘兮，两眼如漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九一","author":"释正觉","text":"两眼碧，一面黄。\n舌头不掉，鼻孔难藏。\n老兔静弄魄，灵犀通得光。\n历历机感兮，何用思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八一","author":"释正觉","text":"深深沉沉，心不见心。\n理亡出没，妙超古今。\n锦机丝度密无缝，玉涧水流寒有音。\n友约寒山拾得子，拍手一笑舒胸襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四二","author":"释正觉","text":"山秋而癯，水秋而净。\n得丘壑偃蹇之姿，赋猿鸟超摇之性。\n离微彻见根，动静该听瑩。\n提来万法上看，更没一丝头剩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四七","author":"释正觉","text":"气宇豁落，精神萧散。\n尘劫坐空，世缘居简。\n閒閒淡淡枯木云，沥沥漉漉通身眼。\n森罗万像同条，莫道个人檐板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二一","author":"释正觉","text":"枯木之春，蟠桃之辰。\n自然时节，不费精神。\n啐啄丹山之凤窟，游跃桃华之龙津。\n一机历历，三昧尘尘。\n眼中之物物中眼，身里出门门里身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四二","author":"释正觉","text":"云无心而不羁，谷有应而相宜。\n寂住通感，圆明了知。\n性汪洋而海有受，气突兀而山不移。\n百年身后所须物，问取南阳忠国师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六八","author":"释正觉","text":"缄默之妙，本光自照。\n鉴物之真，眼里有筋。\n出气之快，鼻头有窍。\n见道之根，德象之要。\n处处相应兮，不馀不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六一","author":"释正觉","text":"源养而渊，灯传未残。\n照分光燄，流演波澜。\n暂时还落薄，客事岂艰难。\n春上烧瘢，绿生草端。\n无心为润云行麓，有应不留珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十一","author":"释正觉","text":"枯木形骸，野云踪迹。\n照兮夜色月摩，默也潭空秋入。\n三千界，露半身。\n九万里，成一息。\n随类应缘，何翅百亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十六","author":"释正觉","text":"传之失真，体之而神。\n明白智圆而有照，清虚理极而无身。\n心萌法法，影落尘尘，一段精光华上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八三","author":"释正觉","text":"静而神，默而真。\n方寸绝四壁，大千成一尘。\n拈来百草头边看，浩荡华华叶叶春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八四","author":"释正觉","text":"貌悴情枯，云閒月孤。\n诸根影像有，百念肺肠无。\n毒蛇头少人揩痒，猛虎口是谁捋须。\n有时变态兮，电卷雷驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二○","author":"释正觉","text":"廓然而瑩，了无馀影。\n卓尔而存，岂有他痕。\n静非像也，彻见其源。\n动顺缘也，萌发其根。\n用绵绵兮搅不浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六四","author":"释正觉","text":"了心非相，了相是心。\n皋禽梦寒琥珀树，海月光射珊瑚林。\n影摇风竹，响发秋砧。\n万像森罗俱演说，宝陀岩上有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七○","author":"释正觉","text":"妙处难传，明明像先。\n光凝雪月，秋连水天。\n百亿分身随应事，更嫌何处不周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二九","author":"释正觉","text":"石上足蟠，人间念乾。\n秋生眼角，喜入眉端。\n丘壑之身心磈磊，丛林之肝胆衰残。\n涧月依稀，夜霜濯磨而气韵清白。\n岩松偃蹇，朔雪湔洗而精神翠寒。\n行脚屦败，住山篾宽。\n点著破灶堕，呼回倒刹竿。\n光阴催促三眠茧，风雨扪摩百战瘢。\n影像受鉴，音声度垣。\n寂默髑髅眼，光明赤肉团。\n云锦舒春兮华容光燄，潮雷卷雪兮海口波澜。\n挂拂之喝，拄杖之窜。\n胡饼馒头有变通而绍祖供职，莲华荷叶没科臼而说禅判宦。\n相随学步，莫似邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四一三","author":"释正觉","text":"云水之身，山林之气。\n不专乎学，不游乎艺。\n默坐而心空，妙传而道贵。\n西风凄清秋有痕，长天碧净云无蒂。\n从来佛祖真宗，只么克承家世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○八","author":"释正觉","text":"这个形容，缘报遭逢。\n藏万德于未兆，戢六用于无踪。\n雪阵血战，玉田历农。\n影响若空谷，随扣如霜钟。\n竿头不是风幡动，知有此事还卢舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二三","author":"释正觉","text":"止水怀月，空山吐云。\n清白自若，高閒不群。\n丘壑性灵兮猿鹤得伴，江湖情味兮鸥鹭相分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十五","author":"释正觉","text":"云山之姿，水月之像。\n大海之容，太虚之量。\n受也的的无心，应也头头离相。\n随缘有照兮妙而不痕，彻底亡依兮空而不荡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六二","author":"释正觉","text":"心心绝缘，了了亡年。\n吞佛空三世，披经等大千。\n妙观智出碍，韶昼春无边。\n齐物竹床蝴蝶梦，双飞栩栩华风颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十五","author":"释正觉","text":"拙口默默，閒身寥寥。\n去住妙提其印，死生谁与同条。\n捋须黄檗，夺杖芭蕉。\n十方三世兮，一句全超。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四○","author":"释正觉","text":"白云无根，青山有棱。\n自得一句，妙出三乘。\n和气而春回百草，光明而焰续千灯。\n渊默心传诸佛体，家风独许少林曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○○","author":"释正觉","text":"渊默元成，至虚不盈。\n体天地之含光，十方昭彻。\n用阴阳之变态，万像峥嵘。\n百战瘢知风雨信，垂头兀兀老升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十九","author":"释正觉","text":"闻名不如见面，都卢是个一件。\n风埃闹处常閒，行市贵时却贱。\n圆珠不拨转，精金久磨炼。\n触犯机锋兮青天流电。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一四","author":"释正觉","text":"器宇廓落，形像乾枯。\n一点彻灵府，万年空劫壶。\n青原门下识麟角，黄檗床头捋虎须。\n死中还活兮活中还死，无中却有兮有中却无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五○","author":"释正觉","text":"寒山骨瘦，雪林气清。\n万机寖削，一点光明。\n其灵不可像，其妙不可名。\n默倚蒲团坐终日，你道何时不太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八七","author":"释正觉","text":"皴皮似鸡，疏齿如鲵。\n诸缘坐断，一句全提。\n夜月圆明兮珊瑚海阔，晚云破碎兮玳瑁天低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十九","author":"释正觉","text":"癯山早寒，老木先槁。\n心潜三界空，念动一尘眇。\n太虚谁与增添，万像何曾欠少。\n止犹谷神唯自知，肯把閒身相搅扰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十七","author":"释正觉","text":"只是个人，到处分身。\n万水中间月，百华头上春。\n不外一法，不受诸尘。\n生处熟也疏处亲，默时说也静时神。\n钵盂著饭饱还喜，拄杖入拳饥放嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十九","author":"释正觉","text":"看看，变态毫端。\n春风不泮颠毛雪，秋色自摩眸子寒。\n笑添面孔两眉展，参饱肚皮三篾宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八二","author":"释正觉","text":"动若出山云，止如居谷神。\n无心千种用，有应十方真。\n通气相烦鼻孔，说禅不挂口唇。\n谁知默默坐中意，长养昙华劫外春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十一","author":"释正觉","text":"这样师僧，面目可憎。\n名摸还不似，藏覆又何曾。\n虚空阔无工夫挂剑，沧海深有伎俩挑灯。\n抖擞头陀备，玲珑道者棱。\n入闽借问，何如个能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七九","author":"释正觉","text":"颠毛衰白，眸子寒青。\n闲口能吞佛，虚空解讲经。\n古鉴出匣，太阿发硎，放得无依用得灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一八","author":"释正觉","text":"何须魁斗之名高，不在山川之气豪。\n有口挂壁，亡牛奏刀。\n纵横佛用，分付儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四九","author":"释正觉","text":"清若松篁雪，虚明河汉秋。\n深心老节岁寒事，稳放胡床默默游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]