[{"title":"李公择自滑州移知鄂州","author":"刘攽","text":"黄鹤仙人去不留，武昌官柳傍层楼。\n前山欲近沧浪水，芳草遥分鹦鹉洲。\n渔父啸歌聊自乐，祢衡词赋若为谋。\n朱轮皂盖一身贵，谈笑岂知千古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得江同州和诗后却寄","author":"刘攽","text":"左辅关河二十城，使车全胜直承明。\n白头樽酒谙风味，乘兴篇章得性情。\n苜蓿空肥天骥老，风霜有意皂雕横。\n惊沙急雪迷秦树，不似山阴一日程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和裴润州见寄","author":"刘攽","text":"江城山翠若连环，城下波涛暗楚关。\n去计祇应劳侍从，归心愿复赐清閒。\n百年旧法轩丘外，千里伤怀嬴博间。\n过事恼君堪白首，添欢惟有綵衣斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆子履知颍州","author":"刘攽","text":"稻白鱼肥颍水清，重湖光彩动层城。\n经为游客欢闾里，特羡朱轩拥旆旌。\n整棹凫鹥横笔势，倚楼风雨壮歌声。\n聚星贤士兼存殁，配社名乡见远情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄韩庆州","author":"刘攽","text":"万骑将军西护羌，边尘无复近麾幢。\n烽传列障来遮敌，雪拥层城接受降。\n日暮悲笳还自叠，天寒羁雁少成双。\n檄书不得从军乐，覢弩空令候小邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谢师厚知唐州","author":"刘攽","text":"腰虎凭熊近越乡，方城南望色苍苍。\n社人随处祠桐柏，传马来时认肃霜。\n两国风烟通置吏，百年荆棘劝锄荒。\n王成劳徕先蒙赏，史起犹应问浊漳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王广渊郎中知颍州","author":"刘攽","text":"二月颍河春水生，樯乌相望使君行。\n东风不起惊涛势，迟日何妨短驿程。\n坐有图书欢傲吏，静看鱼鸟忘专城。\n汉庭良守谁先赏，会见胶东举相成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送光禄吕卿知怀州","author":"刘攽","text":"卿秩西来郡组新，东京故事本忧民。\n太行形胜连天党，积石波涛会孟津。\n千里雄风随坐啸，百城膏雨待行春。\n期年定有周堪诏，父老无劳借寇恂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送龚鼎臣修撰知兖州","author":"刘攽","text":"楚国清名世岂知，郡章新得泰山归。\n静思雕鹗霜天势，却看蓬瀛客旆飞。\n去国鬓毛休变色，还家传瑞已生辉。\n翠华早晚东巡守，驰道离宫接帝畿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕郎中知解州","author":"刘攽","text":"南风吹雪暑飞霜，瞬息高车起重装。\n胡马迩来充牧苑，汉兵无处不馀粮。\n部丞亟上司农奏，腰组仍夸太守章。\n正赖研桑密心计，晚从王谢识诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋次道知绛州","author":"刘攽","text":"铜鞮宫观久尘埃，樊守园池亦壮哉。\n属县老人书亥字，临汾神祀问台骀。\n土风颇记尧遗俗，府吏犹疑楚有材。\n汉史待君成十志，传车长望北风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送韩文饶知均州","author":"刘攽","text":"岭梅阴下驻旌旟，五月归更竹使符。\n汉上川原连梦泽，郧人风俗语于菟。\n奋髯曹吏知无事，坐啸云山得自娱。\n建礼会朝兼夜直，羡君覢弩盛前驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙秦州","author":"刘攽","text":"十年幕府领旌麾，事半前人此复稀。\n元帅诗书真用武，小戎车甲岂无衣。\n胡兵候月麒麟斗，汉马乘秋苜蓿肥。\n自失阴山常恸哭，更闻消息向金微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王泰州","author":"刘攽","text":"粒食由来不愿馀，云飞自愧羽翰孤。\n已同白首滞三署，却羡青郊授一夫。\n出守故人犹虎竹，相忘吾道亦江湖。\n秋来卧阁知何事，铃索生尘狱有芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送乔左藏自太常博士除知施州","author":"刘攽","text":"志士变衣非变性，丈夫能勇亦能言。\n东郊不顾田二顷，爱子欢然弓两鞬。\n黔水犀牛群解鸩，峡山猱子躁欺猿。\n蛮溪未足纡长策，会使天骄祭北门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王汝州","author":"刘攽","text":"读易绝编经获麟，廷臣推汝老成人。\n宦游独怪乌衣晚，吏隐何妨青绶新。\n风穴不应长啸虎，汤泉宁复为煎薪。\n高斋有胜宣城处，三十六峰为近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十日赵令园饯送王汝州汝州留诗二篇次韵 其一","author":"刘攽","text":"华发悲秋复送行，茂林修竹若为情。\n菊花节去香犹在，桑落寒来色更清。\n赵魏优贤常不欲，春秋知我亦空名。\n别离何必皆千里，分手如今越与荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十日赵令园饯送王汝州汝州留诗二篇次韵 其二","author":"刘攽","text":"五马来时照路傍，名园秋物自裳裳。\n吹花酒面蟹螯壮，下豉莼丝鱼脍长。\n问事不休推景伯，读书未见属黄香。\n穷愁解摘唯须酒，身外浮云天际翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送韩七文饶郎中再知解州","author":"刘攽","text":"传瑞生光厩马闲，使君冠盖隔年还。\n莫嫌屈产齿加长，少有甘棠身再攀。\n白径岭前开驿路，哀乌星里望朝班。\n盐车过往繁如织，骥耳能忘一顾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送裴郎中知房州","author":"刘攽","text":"好去台郎应列星，异于迁客向房陵。\n且看银印悬青绶，可在金舆与玉乘。\n柏坞麝脐香不杂，竹崖牛角价无朋。\n清通便是循良术，三最从君数吏能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王济州","author":"刘攽","text":"狱市并空俗已和，使君高兴足婆娑。\n画成林色重装洗，鉴作湖光更洁磨。\n历下军声从古盛，济南名士迩来多。\n小寒渐有北归雁，话与飞翰同一过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬王济州","author":"刘攽","text":"郡印拘人祇看山，簿书无尽且偷閒。\n不羞暮景桑榆上，聊寄高情宇宙间。\n颇葺池台增旧观，旋栽桃李待堪攀。\n老公此意君知否，未有菟裘未得还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送满龙图知襄州","author":"刘攽","text":"凤林关下七连城，猎猎霜风卷旆旌。\n汉阴抱瓮防机械，岘首沈碑认智名。\n季孟中间欲谁与，英贤馀事亦难平。\n习池倒载时一往，却是古今真实情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁单州诗六首 其一","author":"刘攽","text":"五字酬君诗百篇，知音免负伯牙弦。\n淹留子贱弹琴地，怅望兰成射策年。\n术到仙真皆羽化，师无前敌在中权。\n古今风雅人多少，名下声华不浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁单州诗六首 其二","author":"刘攽","text":"材杰知心似合符，不违颜氏亦如愚。\n文章偏我不得力，怀抱与君非有殊。\n龟手但知能澼絖，纬萧何意得骊珠。\n自携如意樽前舞，曲尽歌长缺酒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁单州诗六首 其三","author":"刘攽","text":"性僻材疏酷嗜诗，头童齿缺雪垂颐。\n五十已过无闻尔，三百虽多奚以为。\n每向后生知所畏，独于名士喜同时。\n李陵苏武俱尘土，豪杰由来自得师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁单州诗六首 其四","author":"刘攽","text":"多爱不忍缘爱奇，记人毫发忘瑕疵。\n垂老此心免愧己，起予它日亟言诗。\n衣冠为子最青眼，兄弟数君仍白眉。\n瓠叶岂以菲废礼，鲜首燔炮为宛脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁单州诗六首 其五","author":"刘攽","text":"侧径蜂飞忙蔽日，绿阴莺语静移时。\n自疑寂寞扬雄宅，最爱清和谢监诗。\n词客篇章写桐叶，饮流筹箸折花枝。\n相望十舍不相就，两地风光镇所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁单州诗六首 其六","author":"刘攽","text":"贵公门地多阴德，庆事今君大乐生。\n爱子桂枝新上第，弄孙兰茁始书名。\n拨弓试复穿杨叶，负鼎何妨待鹄羹。\n不似淮阳多病守，十年卧閤见交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂讽","author":"刘攽","text":"阳武旧恩惟丙吉，中兴同学有严遵。\n封侯会自酬阴德，物色终应访故人。\n可在介推怀怨望，深疑咎犯亦逡巡。\n刚肠独有屠羊说，称义孤高无与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送虞太熙著作知番禺县","author":"刘攽","text":"远师犹觉丹青似，大邑知无盘错忧。\n梅岭山长因海尽，夜郎江阔傍城流。\n鲸鱼浪作伧人鲙，槎客常随贾舶舟。\n莫为风帆径清浅，秘书仍自有蓬丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹辅奉议福建转运判官 其一","author":"刘攽","text":"驰传典州名字高，溪山更不厌勤劳。\n吏逢照胆新磨镜，事似屠牛已善刀。\n颇说团茶如湩酪，欲将丹荔比葡萄。\n使君诗思过泉涌，为赋佳篇悟此曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张遂州","author":"刘攽","text":"九折无艰蜀道通，使君车骑最雍容。\n尚书不复拘三辅，御史仍开给五封。\n接境去思棠树密，退公欢燕綵衣重。\n治民固有张京兆，坐看巴人益劭农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张宣德合江亭","author":"刘攽","text":"此水此山今昔游，苍烟古木又穷秋。\n起随佳士初乘兴，忽话离人始欲愁。\n南极早知无到雁，北天那可际归舟。\n老身学得灰心也，不是灰心泪已流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日寄杨十七","author":"刘攽","text":"檐日辉辉过午天，榱风槭槭未霜前。\n不甘翠叶无时落，已分黄花特地鲜。\n富贵应须三寸舌，文章不及一囊钱。\n诗翁白发经秋甚，为问穷愁有几篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳云亭 其一","author":"刘攽","text":"山外浮云横翠微，海边初日上朝晖。\n我无小鲁悠悠志，那欲乘风去去飞。\n上客高吟挥玉麈，佳人半醉舞罗衣。\n昏鸦独鹤何劳问，合暝投林各有依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳云亭 其二","author":"刘攽","text":"槛外连山如合围，尤怜昏旦变清晖。\n云行骤雨非无事，鸟伴归鸿即倦飞。\n厌见市朝车马迹，喜看岩谷薜萝衣。\n尚平毕娶何萧散，千载高风自可依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄后庙","author":"刘攽","text":"驷家冠虎久腾声，龙跃中都汉道兴。\n人事能无输织室，母仪终见葬南陵。\n苍苔复阁连荒草，乔木参云挂老藤。\n欲学灵均纪天问，古堂丹碧正严凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑秘丞知邛州蒲江县","author":"刘攽","text":"明府之官固有程，巴江缭绕趣君行。\n孤帆去远沧浪色，百丈牵迟滟滪声。\n火井煮盐收倍利，山田种芋劝深耕。\n旧来邛竹通西域，边吏还知健令名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李尚书除少保致仕","author":"刘攽","text":"疏公黄发欲遗名，诏秩青宫二品荣。\n自昔为家皆僻地，更闻题剑得佳城。\n赐金给馆君恩重，倚杖看山世累轻。\n试问门风过万石，白头贤子已名卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴国博未五十致仕归蕲州","author":"刘攽","text":"名宦于身甚纆徽，白头青紫莫言归。\n曼容自以微官去，蘧瑗应知过事非。\n笛竹满山经夏冷，江鱼如玉向秋肥。\n避喧不厌尘纷远，何况孤城人迹稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与诸公会赵氏园主人加送酒馔既而求诗书五十六字","author":"刘攽","text":"落木稀疏存叶丹，别筵秋兴杂悲欢。\n主人爱客愿少驻，老子为君加一餐。\n萧相河山馀带砺，谢公子弟悉芝兰。\n会因休沐观歌舞，正赖微官谒禁宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦寒早朝","author":"刘攽","text":"漏绝星沈十二门，烈风吹耳万车奔。\n疾驱不敢行驰道，辨色才能认掖垣。\n病眼无堪频唾沫，瘁肌时复强嘘温。\n尚衣仍在青冥外，薄愿何当献负暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王舍人酬王工部早朝","author":"刘攽","text":"天门金碧照晨光，跃马鸣珂晓正当。\n人到蓬莱知不夜，地从阊阖夐无傍。\n风移宫漏穿花远，云覆炉烟绕禁香。\n望断双凫候飞舄，空传诗句首东皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后早朝","author":"刘攽","text":"雨阕凉生楼阁虚，绿槐花落影萧疏。\n端门立仗交符后，禁漏传呼上水初。\n伏阁预闻明诏语，退朝潜诵直臣书。\n愚忠空觉身无补，放去江湖待诏除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪早朝和沈编校","author":"刘攽","text":"晓寒初怪客衣重，隐约钟声长乐宫。\n出户万家横雪里，止车双阙秀云中。\n退朝禁柳迎人绿，寓直庭花向日红。\n纵使著书嘲尚白，会应华发兆非熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和牟公野馆宿早朝","author":"刘攽","text":"梦回仙府豁中扃，未断尘缘复战兢。\n交态出门逢楚越，俗情开口判淄渑。\n夜长鳷鹊偏留月，岁尽天河亦有冰。\n阊阖晨开车马集，五云深处望朝升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐中与王丞相吴枢密韩端明王学士会饮骐骥池上去今将二十年王有感事诗见示次韵","author":"刘攽","text":"水色林光照举觞，陂塘六月起秋凉。\n壮年过事难重得，末路贫交故未忘。\n注眼阶星元近极，叱枭氓采不成王。\n严徐未抵冯唐老，犹咏君诗意自卬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汾州郑闳中学士寄蒲萄","author":"刘攽","text":"汉使于阗伐大宛，蒲萄天马遍长安。\n绝尘无复千金骨，结实常迎八月寒。\n远愧故人勤置驿，每逢樽酒为加餐。\n自身不得凉州牧，何以报君双玉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与倪秀才酒","author":"刘攽","text":"学子青青佩与衿，湘中携手一伤心。\n君为壮者我白首，家在秦州书万金。\n失马颇能如北叟，似鸮那复怪南禽。\n相怜羁旅方无友，赍赠醇醪稍献斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾舍人春祠太一坛二首 其一","author":"刘攽","text":"使节春祠太一坛，汉庭儒雅贵儿宽。\n星河回转开阊阖，楼观参差起广寒。\n月射金盘霜更白，风来宫树雪犹残。\n清诗不减高唐颂，万玉锵鸣杂佩珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾舍人春祠太一坛二首 其二","author":"刘攽","text":"五城金碧尽楼居，西望屯云蔼太虚。\n瑞气长存春不觉，美光相属夜如初。\n归承宣室雍容问，密受神君策画书。\n力士传车空杳邈，真游本自接储胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和顾直讲","author":"刘攽","text":"故人相语笑家丘，华发盈簪此滞留。\n无限风光轻过眼，迩来春色试回头。\n名园秀木丛幽境，紫府真仙熟旧游。\n自是山林怀胜赏，非关适野济吾谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚归","author":"刘攽","text":"古木号蝉鸦乱栖，凉风稍稍袭人衣。\n高楼鼓角悲秋意，小市渔樵竞夕晖。\n虽有簿书容暇豫，强从宾旅复来归。\n闭门跃马俱人事，吾道何能问是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕都下","author":"刘攽","text":"元夕灯光岁益新，羁游四十五年春。\n垂髫已识东西事，回首宛如前后身。\n绣毂雕鞍驱不顾，丹台绛阙到无因。\n清霜著屋风吹面，素月满庭吾故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏旗","author":"刘攽","text":"玉关归马候全师，虎落无尘指列旗。\n壮士欢声歌杕杜，降人破胆望枪累。\n禹功远近逾千岁，汉德并容过二仪。\n青海远通青冢地，白羊斜界白狼夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张器著作","author":"刘攽","text":"长裾欲敝二毛侵，他日闻君东武吟。\n骐骥老成方得路，梧桐焦尾始知音。\n蓬莱著作芸香馥，楚泽弦歌笛竹深。\n七十封侯殊未晚，相看感激壮夫心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵酬著作见寄","author":"刘攽","text":"粗了文书过目前，公馀宾宴即欢然。\n腊醅趁熟先春味，官烛供烧合夜烟。\n恶土一番生好木，涸池三面秀红莲。\n不知尚有思人否，吟咏来诗几绝编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王平甫直舍未开梅花","author":"刘攽","text":"复阁深沈人到稀，官梅孤秀及花期。\n地寒竹柏应为伴，春近冰霜信有时。\n不恨未开烦久待，正怜将落赖偏迟。\n催人头白何由奈，可在江南寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏喜凉","author":"刘攽","text":"季月南州雨过春，雨馀炎气即经旬。\n北风一变如秋色，小屋三间喜病身。\n出户燕儿矜羽化，堆盘梅子荐时新。\n融峰盛夏含冰雪，安得清凉颇借人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳","author":"刘攽","text":"风光亹亹逼人来，过去清明更不回。\n巳日家人还祓禊，蜀江清水快流杯。\n关关啼鸟如相和，冉冉残花欲尽开。\n自笑野心安淡泊，亦能随众上春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南宫锁宿戏题","author":"刘攽","text":"复阁深沈横九衢，京尘断绝闭门居。\n士人应怪跳壶术，汉使曾无系雁书。\n暝数月华将复缺，春和庭卉已非初。\n东风雷雨知何在，快意青冥看化鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题禅寺","author":"刘攽","text":"锦帆牙樯四百年，曲池歌榭两凄然。\n又从劫火悲前佛，犹有灵光阅逝川。\n何处鸣禽新出谷，几株乔木上参天。\n春游不负题诗兴，神助仍因梦阿连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]