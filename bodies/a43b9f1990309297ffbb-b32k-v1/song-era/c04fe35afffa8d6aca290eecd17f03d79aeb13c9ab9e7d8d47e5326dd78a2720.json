[{"title":"览邻几重游西池兼简和叔","author":"韩维","text":"积雨淹连骑，新波滟广池。\n喜闻重到客，更作复游诗。\n逐水无留絮，飘空有断丝。\n送春吾得地，一问故人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览景仁君实议乐以诗戏呈景仁","author":"韩维","text":"少年议乐至颠华，作得文章载满车。\n律合凤鸣犹是末，尺非天降岂无差。\n劳心未免为诗刺，聚讼须防似礼家。\n一曲银簧一杯酒，且于闲处避风沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卫真晏太丞","author":"韩维","text":"才名宰相子，二十取辞科。\n得县古称厉，登楼朝见涡。\n疲民劳赋役，静理足弦歌。\n八桧仙祠在，知君秀句多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送门客李秀才赴省试","author":"韩维","text":"伤思易子闻前戒，务学求师是至言。\n岂有车鱼延上客，欲将诗礼示诸孙。\n青衿散后人千里，黄菊开时酒一尊。\n壮岁雄图当自勉，未应长啸入苏门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太素南游","author":"韩维","text":"戕性伤生俗所同，人间今见百年翁。\n无稽不学公超雾，有待犹嗤禦寇风。\n心到灵源千虑息，气随真火百骸通。\n临觞不用嗟离阔，达者相忘道术中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王奉议知吴江县","author":"韩维","text":"闻说吴江上，长桥百丈虹。\n蚝粘能固本，人度若乘空。\n明委三秋月，清来万里风。\n君知此为政，名惠广无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送石昌言归蜀","author":"韩维","text":"省署聊休直，皇恩许过家。\n朝廷宠儒雅，车骑有光华。\n行色星垣动，褒章宰树加。\n遥知蜀父老，夹道竞咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送休上人之荆门玉泉寺","author":"韩维","text":"怜师真达者，于世了无求。\n万事沤起灭，一身云去留。\n楼台金地古，风雨玉泉秋。\n安得超尘网，相从物外游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘巽殿直官蜀","author":"韩维","text":"车马萧条西出门，怜君宦薄意能闲。\n并游多得贤豪士，久困独无憔悴颜。\n白酒园林休洛社，黄花风露见岷山。\n男儿荣滞古来有，收取功名晚节间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘景元观察守襄阳","author":"韩维","text":"荆州太守驾朱轓，宝笔题诗出御前。\n应厌笙歌消暇日，欲将才业效当年。\n千章翠木云间寺，百丈清江雪后船。\n看取古来良吏迹，苍碑突兀岘山巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕寺丞","author":"韩维","text":"古有从军乐，人今衣綵行。\n春风骐骥健，朝日凤凰鸣。\n树远秦中道，花繁塞下城。\n篇章闻旧俗，当为放遗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙广","author":"韩维","text":"文才武略有家规，懿行乡闾雅见推。\n乘障讵能申远业，偃戈良喜遇清时。\n风吹秀菊篱边发，雨落黄榆塞下悲。\n白首情怀何以慰，从军早寄仲宣诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙通直","author":"韩维","text":"白首归来养性情，同时流辈尽彫零。\n忘怀物外思游好，访旧樽前得典刑。\n霜月醉留湖榭白，雪风吟度陇山青。\n斯民利病君多识，好奉新书谒帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送尧夫知陈州","author":"韩维","text":"亮节金坚气玉温，入登廊庙出藩垣。\n谈经每尽先儒意，议政居多长者言。\n恩恤疲羸蠲重赋，礼加耆耄屈常尊。\n白头但祝公归早，南陌东陂并短辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱主簿","author":"韩维","text":"浮舟下东溪，春寒花未遍。\n共约征车行，复此华堂饯。\n人事多龃龉，临分阙芳燕。\n坐想竹间风，杂英纷如霰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李宣德为县太原","author":"韩维","text":"昔叨符守访乡评，守节安贫得水名。\n道在莫嗟为邑晚，禄微须喜及亲荣。\n风吹白菊篱边别，雨落黄榆塞下行。\n善抚疲羸修分职，边庭无事正休兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李瑜屯田通判润州","author":"韩维","text":"耳熟江南胜事传，闻君官去便翛然。\n江流截楚红尘断，山势吞吴秀色连。\n紫蟹迎霜新受钓，黄花吹酒正当前。\n嗟予不得从斯乐，坐看秋风发画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈学士知常州","author":"韩维","text":"毗陵今古号名州，况是风流得隐侯。\n吴岫稍迎双隼旆，洛尘凡敝几貂裘。\n预期庭下无嚚讼，还向樽前作艳讴。\n去去国门谁不羡，画船烟浪入清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送芳公长老归法云","author":"韩维","text":"水际茅亭竹下庵，清谈竟夕不知厌。\n伽佗善巧何能继，经藏幽深亦许觇。\n额内珠存虽本有，眼中金落复谁拈。\n圆通到日如相问，为道春来米价添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送辛十七作尉盐城","author":"韩维","text":"少年嘉誉冠诸生，白首青衫仅有成。\n千里辛勤州县职，一觞凄惨里闾情。\n家临颍水花催发，柳绕长堤絮扑行。\n寸禄折腰何必去，道存心在即渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送河秘校鬲主簿良原","author":"韩维","text":"平时太学客，文藻士林传。\n憔悴尚一邑，声名空十年。\n风烟长夏始，关塞浊泾前。\n莫作归来叹，将军好荐贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送思上人南归","author":"韩维","text":"尘埃不可久，归卧故山秋。\n荣利非其好，风骚得所求。\n晨征随社燕，夜宿近江鸥。\n闻子禅林胜，它年一系舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送洵阳王令之官","author":"韩维","text":"离马嘶高树，郊原夏景深。\n还持长者政，往慰远人心。\n种黍侔千户，张鱼盛百金。\n江山永嘉咏，时寄草堂吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晁怀州学士 其二","author":"韩维","text":"退传清门世有才，使君嘉誉蔼中台。\n未甘文墨工彫篆，聊取圭符试剸裁。\n垄上劝耕春晼晚，山前闻笛月徘徊。\n明朝建隼临长道，回首仙庐拂斗魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晁怀州学士 其一","author":"韩维","text":"儒馆雠书旧，侯藩请节行。\n山川犹古气，铙吹自春声。\n问俗怜彫瘵，颁条赖简平。\n从来寇河内，谁复继声名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送海印住香严颂","author":"韩维","text":"枕石漱流尘外趣，随缘应物谷中声。\n更无宾主能酬对，自有儿孙可使令。\n万古清风归法语，一轮明月伴经行。\n鳌山成道知何日，时伫雷音警妄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高寺丞宰岐上","author":"韩维","text":"墨绶垂腰底，怜君尚一同。\n人豪固秦俗，地古自豳风。\n春色鸣弦外，山光隐几中。\n定应传善政，不日到关东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送崔朝请通判徐州","author":"韩维","text":"与君仍世接游从，造次相敦德义中。\n善继家声名父子，不追时好古人风。\n流光岂受长绳系，妙道才容一线通。\n待得铃斋民讼简，更将此理问庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹大夫归家","author":"韩维","text":"飞尽杨花见绿阴，飘然轻盖返家林。\n野堂泥落归双燕，纹簟风清戏一禽。\n秀麦柔桑皆有望，高轩华衮久无心。\n知君自得闲中乐，早寄新诗别后吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾通直入京","author":"韩维","text":"敏学高文俊茂身，少年今见鲁公孙。\n明心早得无生意，清耳常闻有味言。\n绿鸭陂中春纵棹，芰荷池上雨移樽。\n临分有赠非他物，声利精忘道始存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送戴处士还卢州","author":"韩维","text":"早识浮生妄，欣陪达士游。\n观心非本有，于法尚何求。\n煮茗林间寺，题诗湖上舟。\n还嗟别后夜，风雪拥貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳对雨招介甫","author":"韩维","text":"积潦行车绝，高舂闭户眠。\n萧条黄叶下，冷落菊花前。\n废卷怜佳节，衔杯想少年。\n君来慰愁坐，厩马疾于烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宴逍遥堂","author":"韩维","text":"朱颜绿鬓尽才良，永日逍遥宴此堂。\n乐事已先桃艳动，欢情仍共雪花狂。\n梦中身世知虚实，醉里光阴任短长。\n荣辱誉非那复问，无何有处是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宴湖上呈稚卿","author":"韩维","text":"熠熠萤光草际流，及时高宴落霞洲。\n繁弦急管宜清月，细蕊浓芳艳晚秋。\n飞鹭欲来迎画舫，跳鳞如喜脱金钩。\n知公加数为醇酿，应许闲官烂漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展江亭看海棠遇风","author":"韩维","text":"少陵昔日富辞华，愁见飘零万点花。\n写物高才从古少，伤春情绪此时加。\n恨无巧语谗风伯，直欲狂图系雨车。\n莫怪晚来觞屡釂，白头判得醉流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏相公湖上泛舟赋","author":"韩维","text":"小雪未成寒，平湖好放船。\n水光宜落日，人意喜晴天。\n云薄翠微外，禽归莽苍前。\n上公宽礼数，清醉亦陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花菊 其二","author":"韩维","text":"霜女星娥不俗情，施朱点出浅深更。\n平泉记上遗嘉品，本草经中注别名。\n气得清凉开更早，色沾寒露久逾明。\n今朝樽酒来篱下，不为重阳为尔倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花菊 其一","author":"韩维","text":"谁测天工造化情，巧将红粉傅金英。\n武陵溪上分佳色，陶令篱边得异名。\n不使秋光全冷淡，却教阳艳再鲜明。\n瓮头消息香醪熟，何必黄花便可倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浴普静同江二李叔中道赋","author":"韩维","text":"夜来飞雨濯残芳，绿遍童童佛树行。\n把酒可劳悲暮节，振衣还自喜微凉。\n清帘不下轻飏燕，别院时来暗霭香。\n自是嵩阳欲归客，为公聊尽次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"积雨成雪呈子华","author":"韩维","text":"寒威暗袭春和去，坐拥重裘仅自温。\n对景直须忘适适，随机聊耳不言言。\n兴来一笑非缘酒，道本无忧岂在萱。\n欲与何人论此意，竹风松雪满西轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"请微之饮","author":"韩维","text":"句解章通字字安，书成进御九重观。\n更加亲切从新诏，却得高闲是旧官。\n禁阁不忧连夜直，好山应许老年看。\n菊香酒熟身无事，且尽樽前一笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"载酒过景仁东园","author":"韩维","text":"地胜依危堞，城高若半峰。\n衔觞惊岁序，候雪仰云容。\n不假猫滋竹，须防犬败松。\n顾惭文俗吏，游步蹑仙踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪宁极游南溪夜还山墅","author":"韩维","text":"南溪晚酌罢，归路笑言同。\n家在碧山下，人行清露中。\n鹊飞斜映月，虫响暗移丛。\n下马儿童喜，谁知为德公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪范尧夫之北第饮彝叟新堂","author":"韩维","text":"光禄新堂指顾成，非奢非俭称高情。\n春风为我开朱户，晴日从公驻彩旌。\n庭下早梅惊喜客，门前垂柳欲啼莺。\n追攀梦境终何得，识取家乡旧路行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪景仁赴况之湖上燕集遇雨","author":"韩维","text":"炎蒸消尽作浓阴，湖上兹游喜重寻。\n急雨洗开荷芰色，清风借出管弦音。\n凉生顿觉絺衣薄，欢至宁论酒盏深。\n善谑清谈都有适，过从所得在知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成寄曼叔","author":"韩维","text":"红芳落尽鸭陂边，白首伤春倍惨然。\n自愧闲官消永日，独吟佳句想当年。\n早休诸吏眠斋馆，时引双童上舞筵。\n闻说年来亦归兴，琳宫仙籍旧无员。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿西京府署晚游东池","author":"韩维","text":"牢落悲春事，萧条作晚游。\n清光溢平沼，凉思近高楼。\n碧树森将合，朱栏渺若浮。\n公来慰羁寓，华月许移舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庆州德孺待制","author":"韩维","text":"常爱公家好弟兄，忠言直道友于情。\n心期光禄朝中驾，目断将军塞上旌。\n埤堄高风回过雁，琵琶宵寂语流莺。\n共欣出处非它辙，报国诚身各自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李公达","author":"韩维","text":"早为书殿同游客，尝贰侯藩共理臣。\n流景又逢黄菊节，狂欢犹记紫荆春。\n浮生几度花前饮，访旧多为柏下人。\n闻说真乘得深趣，暂抛珍御出埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄郑州曾资政","author":"韩维","text":"鲁公旌旆镇兹邦，曾奉樽罍佚老堂。\n彩服过庭闻政术，缁衣传世见诗章。\n斗龙门外波光绿，集凤台边柳色黄。\n应感归欤形丽唱，故园春草满池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄侯官知县吕宣德","author":"韩维","text":"鸭子陂边昔并游，别来频见藕花秋。\n十年已惯身萧散，百里空嗟手滞留。\n道在岂常忘塞马，机閒真可伴沙鸥。\n平时几案应多暇，还有妖歌近耳不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄秦川马从事","author":"韩维","text":"往岁游西谒季长，陇云秦树胜风光。\n分题红叶蛮笺腻，对举流霞綵袖香。\n宴洽翠娥连象榻，夜寒娇凤泥银黄。\n未知早晚重携手，惆怅而今鬓已苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致仕李洵大夫","author":"韩维","text":"买得田园便退身，世间今作自由人。\n不争路上风波静，无相光中日月新。\n红叶委阶非异物，碧峰当户见全真。\n知君未放狂心歇，兴在陶公漉酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢师直","author":"韩维","text":"十年三退卧吾庐，解组归来始定居。\n数亩家园荒杞菊，一池秋水拂龟鱼。\n临花对月难忘酒，咏古怀贤不废书。\n更欲两忘真俗累，逍遥常御白牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄微之通议","author":"韩维","text":"十五年来自在身，晴天万里见孤云。\n闲中密迹常同俗，老去忠言尚爱君。\n一坐精神归素发，两行歌舞避红裙。\n早梅时节华灯夜，日伫车公共醉醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题苏子美沧浪亭","author":"韩维","text":"闻君买宅洞庭傍，白水千畦插稻秧。\n生事已能支伏腊，岁华全得属文章。\n骞飞灵凤知何暮，蟠蛰蛟龙未可量。\n莫以江山足清尚，便收才业傲虞唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题周著作江山县溪亭","author":"韩维","text":"结亭遐僻古江山，胜绝终为好事传。\n溪泛夜声来枕上，峰回午影过樽前。\n禽鱼旧识应相乐，花木亲栽益自怜。\n我抱沧洲未归恨，羡君生计有林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题曹大夫栖真堂","author":"韩维","text":"闻君初欲挂冠缨，便构兹堂不日成。\n桐桧茂阴归后得，烟霞高兴坐中生。\n禅心皎月通宵静，诗思寒泉彻底清。\n十五年来饱闲散，纷纷人世自浮荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过邻几官舍三首 其三","author":"韩维","text":"萧洒君官舍，从来可数来。\n养莲疏浊水，薙草出荒台。\n芡散初成籍，蒲长欲映杯。\n吾知蒋生径，不为俗人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过邻几官舍三首 其二","author":"韩维","text":"车马东桥绝，凉风满夕轩。\n水声通沁苑，树色入夷门。\n每接渊明咏，常怀仲理言。\n沧洲如可约，杯酒会重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过邻几官舍三首 其一","author":"韩维","text":"炎日来休骑，红尘喜放船。\n波平凉洗马，树净晚吟蝉。\n风至披襟后，云消倚拖前。\n潭心见华月，归意一留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚过象之葆光亭戏呈一首","author":"韩维","text":"萧洒崔家宅，重门一径通。\n竹烟虚晚碧，花雨重秋红。\n傲睨怜苔石，徘徊俯桂丛。\n自期新月色，不为主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春","author":"韩维","text":"春晖东去月如弦，却拂凝埃敞北轩。\n几曲云屏空白昼，一帘花雨自黄昏。\n庭芜碧合阴虫息，窗树红稀斗雀喧。\n细忆旧欢都入梦，习家池上子山园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹通直以颜鲁公墨迹题辞乞诗刊石","author":"韩维","text":"临池馀事得忠臣，白刃林中不动身。\n见义舍生安为己，怀谖保位独何人。\n英名在世长如日，遗像于今凛若神。\n一览精诚方自失，羞将累句刻苍珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明北园泛池舟中作","author":"韩维","text":"路绕高林尽，舟篷出近湾。\n鸟啼青竹影，人对绿波间。\n野色平当坐，春愁巧作颜。\n已知湖榭近，飞絮落班班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清涟矶独坐","author":"韩维","text":"绿筱清涟得钓矶，制名翻与实相违。\n沉钩不忍潜鱼乱，回棹常侵宿鸟飞。\n林霭散馀知月上，水风清极怯秋归。\n兴来诗就觞来尽，不信人间有是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]