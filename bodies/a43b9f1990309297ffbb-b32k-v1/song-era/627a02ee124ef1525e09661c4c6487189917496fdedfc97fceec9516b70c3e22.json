[{"title":"咏唐史 杨绾","author":"韦骧","text":"总政中书月未期，郭崔奢侈遽中移。\n代宗勿叹天亡早，用相斯人已后时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 郭子仪","author":"韦骧","text":"凌烟阁上中兴后，勋德光全属令公。\n鱼辈也知深用力，其如谦巽悟宸衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 萧复","author":"韦骧","text":"面排卢杞兴言佞，背沮刘公受旨私。\n真相不知知彼相，便容辞疾守閒司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 柳浑","author":"韦骧","text":"刑宽毁玉回天怒，智料渝盟识虏情。\n延赏见跻终不愠，陶陶谁似柳宜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 李揆","author":"韦骧","text":"献替初虽有可贤，忌能遭贬是谁愆。\n獐头鼠目言何易，重困江湖十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆双栟榈","author":"韦骧","text":"忆昔厚栽培，怜双异众材。\n青青江外色，往往梦中来。\n未得甘棠比，宁随弱柳衰。\n春华摅劲质，冷淡为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘诚夫江阴狱掾","author":"韦骧","text":"学老才优底里精，青衫今始掾江城。\n高门积德功须倍，三尺持平道可行。\n听决即能诚吏俗，名声安用势公卿。\n相逢未几还相去，赠别非言岂慰情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石龟","author":"韦骧","text":"磨琢成龟智不虚，天然体理尽难如。\n世珍未许论荆璞，神迹当曾负洛书。\n山泽秘奇西蜀远，星辰分气北方馀。\n坚完自得灵身计，安用区区免豫且。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县斋即事","author":"韦骧","text":"作邑惭无术，怀民赖有年。\n讼筒消不逞，宾席汰非贤。\n奉养庭闱稳，论求典册全。\n谁言非吏隐，山水匝城堧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜德甫彦文至","author":"韦骧","text":"昏昏山雨锁春晖，褊邑萧条客至稀。\n怜子远来求所益，愧予无术慰焉依。\n文章未易论高出，行谊当须及庶几。\n幽阁群书足游意，圣贤虽邈欲谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨池荷花","author":"韦骧","text":"云翳前山雨脚长，洒然清气动莲塘。\n花中润色添来美，叶上繁声过去忙。\n红面浑羞泣珠泪，翠盘微重泻琼浆。\n萧萧古县无公事，赢得澄神坐冷床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金华按覆回止普净","author":"韦骧","text":"雨止山路滑，肩舆进亦难。\n官拘当勉力，室处岂非安。\n浅涧流还急，鸣禽意自宽。\n来归虽薄暮，古寺且盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼","author":"韦骧","text":"邑落皆山水，登楼远目通。\n从容民事外，游息圣经中。\n画饼羞虚誉，持衡尚至公。\n此心难语俗，举袂挹松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离邑之衢按狱","author":"韦骧","text":"出野暴雨作，迟晴方戒行。\n溪山百里秀，气象一番清。\n于役途虽远，祛虑意自平。\n民田况交隶，足以慰予情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野塘白莲","author":"韦骧","text":"路转方塘口，塘莲云不如。\n孤芳已难值，秀色况非馀。\n及鉴波平后，飘香雨过初。\n泥途忧溅污，顽鹜仗谁祛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石龙","author":"韦骧","text":"隐隐苍山壁，蜿蜒此蛰身。\n物生多有象，人附即为神。\n头角千年古，威灵一境伸。\n确然难以诘，立马为逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还邑遇雨","author":"韦骧","text":"一阵阴云一雨来，驱除烦暑洒尘埃。\n山川固不为迎合，岂是先知地主回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻国哀","author":"韦骧","text":"欲及乾元节，登遐诏忽翻。\n万方钧疾痛，三纪被仁恩。\n气象河山惨，光华日月昏。\n小臣忠未效，饮泣望昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县圃刈禾","author":"韦骧","text":"林下圭田一亩馀，春耕秋敛亦勤渠。\n年丰独喜能钧众，月给谁咍薄助吾。\n已愧拔葵贤鲁相，更羞尘甑诵莱芜。\n字民固合知民事，稼穑艰难坐可图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答吕秀才","author":"韦骧","text":"恻微赒急意虽完，势力锱铢岂自安。\n畎亩君忧家计迫，风波我畏宦途难。\n敝衣非不怜原宪，尘甑其如类范丹。\n情礼甚勤无以谢，愧将珉石报琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答颜长道见寄","author":"韦骧","text":"花溪前日还辕处，惆怅高贤又阻陪。\n山雨在云方惨淡，野烟笼水正低徊。\n别离轻似风飘絮，迟想多于渴望梅。\n胸腹殷勤岂无感，果然缄寄好诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同邑簿检视堤柳乘兴游保寿僧舍","author":"韦骧","text":"拨置簿书看种柳，等閒联辔入云岐。\n山僧莫道疏迎候，我辈行行不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过紫霄宫","author":"韦骧","text":"先春曾宿紫霄宫，今日重游春正融。\n谁道居官便跧缩，也能偷暇向忙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游寿山","author":"韦骧","text":"暂离簿领来邻邑，旋访灵踪到寿山。\n乘闲一游真未易，岂论身寄此中閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下山复题二首 其一","author":"韦骧","text":"頫望群峰目已惊，山僧更解说山情。\n夕阳归去心难足，未听飞泉雨后声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下山复题二首 其二","author":"韦骧","text":"宛转松蹊入五峰，更临危阁半晴空。\n山花鸟语皆真趣，谁是韬光傲世翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望方岩","author":"韦骧","text":"路过方岩未及游，肩舆回首兴难收。\n野桃带日遥相笑，笑我山情不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿灵岩 其一","author":"韦骧","text":"坐邑传闻此岩好，心疑好事张浮辞。\n及来胜境穷游览，却悟前言有漏遗。\n触石烟云如障俗，倚崖殿阁半乘危。\n自嗟吏治多牵制，祇作清虚一宿期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿灵岩 其二","author":"韦骧","text":"百丈苍岩入杳冥，高低气象本天成。\n藤蟠翠壁龙蛇动，涧泻断崖风雨声。\n不许画工为润色，祇应诗伯长馀情。\n栖鸦乱墨题僧室，车马何时再此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自灵岩回途中寄颜令","author":"韦骧","text":"吏役谁婴绕，寻幽得二三。\n穿云离古观，冒月宿灵岩。\n乘兴诗何择，孤游语自缄。\n寄言酬地主，清赏可无惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冒雨游石室","author":"韦骧","text":"陟磴苔痕滑，穿岩雨脚收。\n爱山邻邑令，来作雨中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸡人峰","author":"韦骧","text":"石室前头一片春，天然形象附嶙峋。\n山家况味无晨夕，安用鸡人赋此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨止","author":"韦骧","text":"雨止单蹊步可通，寻春天气似迎逢。\n山花有意飘行盖，野水无情照瘦容。\n挈榼竟难成独饮，抽毫犹得当朋从。\n逡巡且尽今朝兴，数阖归来趁暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓霁归邑","author":"韦骧","text":"夜枕轻寒睡思衰，迟明方霁促归来。\n车徒虽患泥行蹇，林麓还逢秀色回。\n山雨定非天意足，溪云应为主人开。\n野花零乱春禽闹，此兴何如鼓吹陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏别颜令","author":"韦骧","text":"趣驭不遑辞地主，趁晴唯且荷天公。\n县楼归去劳东望，早就新篇寄好风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将及熟溪","author":"韦骧","text":"东风吹散黑云轻，渐望吾疆野色青。\n料得熟溪滩响急，到时聊为驻轩听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村落","author":"韦骧","text":"轻寒切切战春阳，村落人家意自遑。\n老妇画眉窥止水，痴儿曝背坐颓墙。\n牛归小径蹄痕叠，犬吠空山响答长。\n夏赋未来秋赋了，片时优佚胜膏粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中寄县斋诸士子","author":"韦骧","text":"花发蒙亭画景舒，浩歌应叹食无鱼。\n灵岩恨不同真赏，且把新诗慰子居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离石室","author":"韦骧","text":"九十阳春兴已酬，登山穿谷尽清幽。\n閒田不是无多让，故遣尘劳作胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离邑寄颜长道","author":"韦骧","text":"县城不出已逾月，出爱秀野浮青春。\n前时枯株变深翠，对我意气如欣欣。\n肩舆渐入南康道，溪山清旷交吾邻。\n簿书拨置固可喜，又况雅谊还相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻诏士呈同僚朱伯英","author":"韦骧","text":"圣神虑遗士，豪杰思致身。\n诏书一飞传，上下交欢忻。\n吾侪职山邑，步局志未伸。\n缅想风云会，廓然忘我勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和亭","author":"韦骧","text":"前贤重交际，世俗竞将迎。\n用礼皆由正，知和始可行。\n候亭增旧构，题榜易先名。\n训徼非存远，还当鉴鄙情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯英初霁","author":"韦骧","text":"日出乾坤静，阴霖革累旬。\n前溪声未减，绿野秀如新。\n人意犹祛病，物心疑再春。\n此情谁解赋，先手属东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜令见寄 其一","author":"韦骧","text":"孤城四面插群峰，云翳经旬雨气雄。\n自愧不才为县令，近来无事若山翁。\n几思羽翼飞腾去，幸有英豪咫尺中。\n独上高楼方引脰，喜逢嘉句载清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜令见寄 其二","author":"韦骧","text":"洗出郊原物象明，积阴祛尽喜天晴。\n东邻长道诗新寄，增我溪山一倍清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"权东阳既久求归武川上守倅 章守","author":"韦骧","text":"剧邑虚官偶承乏，字民何术慰林林。\n文翁化被虽无事，巫马才悭惧不任。\n樽俎弗踰宗祝计，牛羊自守乘田心。\n愿归山邑逃瘝旷，养拙寒儒荷赐深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"权东阳既久求归武川上守倅 沈倅","author":"韦骧","text":"星火州符气势豪，敢辞承乏赋贤劳。\n设施每恐无能及，旷责还忧不可逃。\n捕鼠孰淹睎骥足，解牛难任割鸡刀。\n愿令樗散归閒邑，更使潜心缘饰高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衢梁试院呈同事","author":"韦骧","text":"秋风动林叶，山国早寒轻。\n较艺精神暇，持杯语论清。\n勿辞淹锁院，未用尅归程。\n留意如求举，终当不误评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依前韵酬张屯田和诗","author":"韦骧","text":"落笔流星缓，酬言白璧轻。\n鄙辞翻可愧，老格有馀清。\n择士无精鉴，糊名况旧程。\n更烦为大句，使我壮文评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试士毕同长道东归","author":"韦骧","text":"相将冒晓出郊原，但值佳山即驻轩。\n投午未行三十里，和诗已及半千言。\n黄云被野田禾熟，白雪翻空溪浪奔。\n高旷襟怀共为乐，此情难与俗人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上睦州刘工部 其一","author":"韦骧","text":"政行荆楚百蛮怀，却拥旌旄向此来。\n自喜平生无枉道，岂论千里复淹才。\n恩苏疲瘵精神返，威慑奸憸胆气摧。\n秋晚子陵溪上好，樽罍风雅许谁陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上睦州刘工部 其二","author":"韦骧","text":"桐庐古郡压乌龙，潇洒佳名信不空。\n傲世曾栖隐君子，谪官多属钜贤公。\n连云城郭残秋外，近水楼台返照中。\n太守公馀登览胜，始知天意养其衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱尉见招","author":"韦骧","text":"作尉由来本仙局，况能投隙会僚朋。\n开怀自适人须美，治具虽疏客不憎。\n雨意初收天爽快，田工将毕岁丰登。\n高吟大饮无羞涩，祗恐秋风苦不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜令见寄","author":"韦骧","text":"别后经宵各到家，别时岐路两萦斜。\n相期卮酒重何日，独对秋林浪有花。\n攻墨却思同整具，择金犹记共澄沙。\n语言彷佛如朝暮，但怅暌离似海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观穑","author":"韦骧","text":"霜风卷叶度高楼，楼上萧然对晚秋。\n坐看野人收?稏，相将尽室在田畴。\n赴晴汲汲如防寇，望岁区区已见酬。\n遗秉多忘歌笑去，乃心应亦傲轻裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄长道","author":"韦骧","text":"诗筒寂寞过残秋，望断前山暮霭收。\n共简犹思石岩句，连镳悔失烂柯游。\n晴溪激浅声还细，栖鸟争深闹未休。\n野兴与君当不异，不知今日在层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"县斋即事","author":"韦骧","text":"比来庭讼少，拙令称幽潜。\n爱日开朝幌，看云捲画帘。\n澄神烹茗粥，忆古检书签。\n菽水清多乐，溪山意自恬。\n韬光异耕钓，苦志念渔盐。\n骥足空思展，牛刀敢谓淹。\n民心久当信，佐局美相兼。\n笑傲言祛隘，赓酬韵斗严。\n囊钱如未乏，樽酒尚能添。\n园笋新成绿，池荷半露尖。\n共谋怀坦坦，毋恤远炎炎。\n此兴欢无敌，逢人语必钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永康徐尉次寄颜令诗韵见寄因以前韵酬答","author":"韦骧","text":"柅车为别始中秋，遽见霜朝爱景浮。\n自愧马期无少暇，祗应梅福有清游。\n殷勤好句能相寄，哦咏幽斋岂便休。\n此段情怀何所似，月明更上庾公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱伯英后圃见招","author":"韦骧","text":"爱君邀客以清诗，会我公庭缿讼稀。\n卷白到时须自勉，乱红飞处是春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏公馀","author":"韦骧","text":"公庭日无事，民伍正蚕耕。\n夏浅寒犹在，云浓雨易成。\n图书存远古，诗酒有馀情。\n傲吏居幽僻，其谁诮近名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱伯英迓送还示","author":"韦骧","text":"怜君迍蹇从初仕，慰我萧条典一同。\n莫为尘劳便兴叹，所施无负即为功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太守郡阁望群山有雪","author":"韦骧","text":"郊原霁后晚寒清，残雪笼山望处明。\n尽道凝留因地冷，当知粉饰藉天成。\n昆冈玉聚微云敛，沧海潮横返照清。\n解赋属谁诗格老，贤侯登览在层城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自郡还寄长道","author":"韦骧","text":"故岁局重城，填然思不清。\n归来见春老，何处慰诗情。\n顾我几茅塞，知君已帙盈。\n社坛当未废，旧约可寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜长道见寄","author":"韦骧","text":"宛转溪山邑落深，春归云物易成阴。\n莺穿别坞遗新子，花谢前村失旧林。\n自厌簿书为滞迹，未应轩冕足关心。\n东邻幸有颜明府，清旷襟怀且共吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢朱伯英遗诗","author":"韦骧","text":"我辈清怀书自将，不须才与古人当。\n佳辰美概无穷尽，险语高词尔转相。\n吏隐未能离扰扰，诗情犹得慰皇皇。\n如君逸格谁忘羡，騕袅终难困服箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜长道寄三首 其一 首夏","author":"韦骧","text":"秀邑发丛萱，清阴泛新竹。\n园林足幽思，扬扬曲池曲。\n奚独念春归，爱此未炎燠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜长道寄三首 其二 县斋肆笔","author":"韦骧","text":"簿领区区岂惬情，尘纷安得眼长青。\n且希五柳先生醉，莫似清江使者灵。\n临政每惭非善治，随时尤愧有劳形。\n谁能与我同幽旷，陇上耦耕还带经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颜长道寄三首 其三 阅武川倡酬","author":"韦骧","text":"往还赓唱百馀篇，草草编联后或前。\n语气有时凌夜月，辞源何啻泻春泉。\n须知吏隐能遗俗，不独山溪解乐天。\n屈指代期秋信逼，封人莫厌屡驰笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扫蒙亭","author":"韦骧","text":"芜亭一扫愧陈蕃，松柏阴森翠竹环。\n闹蝈尽驱澄曲水，横柯旋斫望青山。\n人归畎亩醇风在，我近图书白日閒。\n樗散自知成独乐，惭无善效及民间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和颜令见寄","author":"韦骧","text":"再来东白日无休，剸割唯忧或滞留。\n满眼烟尘真可厌，幸而涵碧见清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]