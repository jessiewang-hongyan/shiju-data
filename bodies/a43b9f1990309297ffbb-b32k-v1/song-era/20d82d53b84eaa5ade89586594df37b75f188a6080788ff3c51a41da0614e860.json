[{"title":"樵歌三首 其三","author":"郑起","text":"山坳筑著牧牛儿，白石凿凿蒙茸披。\n缪公无人宁戚死，独吹觱栗谁得知，不如采樵同路归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樵歌三首 其二","author":"郑起","text":"入城不识公与卿，行歌道上旁无人。\n衣衫蓝缕鹑百结，与妻索笑妻生嗔，那知不是朱买臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樵歌三首 其一","author":"郑起","text":"上山斸山山丁登，下山嵌山山棱层。\n秋残日暮归来晚，茅檐洗脚月又明，明朝早入芙蓉城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠英公大师","author":"郑起","text":"玉殿承恩四十年，水云心已悟南禅。\n李斯篆字功何妙，贾岛诗章学太玄。\n筇在几嗟无虎斗，钵腥长笑有龙眠。\n闻今未老休慵堕，剩把书踪石上镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读冯道传","author":"郑起","text":"西山有薇，二子采之。\n二子竟死，薇不疗饥。\n匪恶周粟，食不下咽。\n君臣义重，彼苍者天。\n尔道何人，数主一身。\n有何颜面，冠冕搢绅。\n乔固诸贤，宁死道边。\n曹操不帝，清议凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"短歌行","author":"郑起","text":"览镜摩挲，岁月蹉跎。\n道长命窄，忧虑如何。\n何以消除，非酒莫祛。\n醉来不见，醒复如初。\n蹠蹻锵锵，孔孟皇皇。\n何非何是，孰劣孰强。\n日出杲兮，月出皓兮。\n无风无雨，可以同携。\n人生朝露，保不及暮。\n青青累累，皆是坟墓。\n天机转深，转用劳心。\n不如坦荡，驱遣光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭陈丞相","author":"郑钺","text":"大厦将倾一木支，登陴恸哭志难移。\n螳螂怒臂当车日，精卫衔沙塞海时。\n梦里忽惊元主朔，军中犹卓宋家旗。\n孤臣万死原无恨，独怪山翁总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"支提禅寺","author":"郑鬲","text":"卓锡千峰里，空门壮大观。\n雨馀双屐冷，风杪一灯寒。\n蜗篆团真偈，龙沙绝野干。\n婆娑参佛果，登眺已忘餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山丹花","author":"郑域","text":"团栾蜂蕊簇枝间，铅鼎成丹七返还。\n乞与幽人伴幽壑，不妨相对两朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阇提花","author":"郑域","text":"此花移种自招提，借佛为名识者希。\n优钵曼陀果何似，并参香争问因依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"素馨花","author":"郑域","text":"妙香真色得之天，羞御铅华学女妍。\n只向温柔乡里活，怕寒不许上林传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槟榔","author":"郑域","text":"海角人烟百万家，蛮风未变事堪嗟。\n果堆羊豕乌青榄，菜饤丁香紫白茄。\n杨枣实酸薄蒳子，山荼无叶木棉花。\n一般气味真难学，日啖槟榔当啜茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉蕊花","author":"郑域","text":"维扬后土庙琼花，安业唐昌宫玉蕊。\n判然二物本不同，唤作一般良未是。\n琼花雪白轻压枝，大率形模八仙耳。\n山溪野路多见之，樵夫摧残如狝薙。\n比之玉蕊似实非，金粟冰丝那有此。\n花须中有碧胆瓶，别出珑璁高半指。\n清馨静夜冲九天，招隐瑶台女仙子。\n乘风跃马汗漫游，偷折繁香分月姊。\n紫茎柘叶荼蘼条，少到寻常人眼底。\n翰林内苑集贤阁，雨露承天近尺咫。\n后生不识天上花，又把山矾轻比拟。\n叶酸而涩供染黄，不著霜缣偏入纸。\n江乡老少知此名，郑榐玚音无正字。\n方言土谚随舌讹，乌马成焉固应尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茉莉花 其一","author":"郑域","text":"风韵传天竺，随经入汉京。\n香飘山麝馥，露染雪衣轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游黄杨岩","author":"郑域","text":"暮秋访幽隐，谢屐凌崩空。\n行到山顶间，还与平地同。\n举手抉层云，下视无高峰。\n疏藤挂赤虬，粘苔糁青茸。\n面首三神山，缥缈沧海东。\n指点笑语高，吹声半天中。\n安得大鹏背，载我游无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灵惠","author":"郑域","text":"高山如逸民，不肯近人迹。\n孤峭尺五天，空洞容数百。\n不招龙自来，其下为窟宅。\n天下待霖雨，胡为耽睡癖。\n我今唤飞廉，驾汝上空碧。\n吾鞭不妄施，慎勿惮劳瘠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题法相岩","author":"郑域","text":"法相具诸相，宝方无定方。\n突兀虎豹立，嵌空蛟龙藏。\n入地转轮远，透天圆窦光。\n何人凿混沌，掷弃官路傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其一","author":"郑域","text":"素肌莹净，隔鲛绡贴衬，猩红妆束。\n火伞飞空熔不透，一块玲珑冰玉。\n破暑当筵，褪衣剥带，微露真珠肉。\n中心些子，向人何大焦缩。\n应恨旧日杨妃，尘埃走遍，向南闽西蜀。\n困入筠笼消黯搅，香色精神愁蹙。\n赖有君谟，为传家谱，不弃青黄绿。\n到头甜口，是人都要圜熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 戊午生日作","author":"郑域","text":"嗟来咄去，被天公、把做小儿调戏。\n蹀雪龙庭归未久，还促炎州行李。\n不半年间，北胡南越，一万三千里。\n征衫著破，著衫人、可知矣。\n休问海角天涯，黄蕉丹荔，自足供甘旨。\n泛绿依红无个事，时舞斑衣而已。\n救蚁藤桥，养鱼盆沼，是亦经纶耳。\n伊周安在，且须学老莱子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"郑域","text":"水晶宫殿，放三千龙女，凌波浮浴。\n花里雕房分洞户，隐隐钉头齐簇。\n处子娇羞，碧裙无袖，密护圆瑳玉。\n堤头微露，半身犹掩金绿。\n知是紫府筵开，□随纤指，出玲珑窗屋。\n倩剥霓裳轻手搔，掐损些些香玉。\n端的中心，密藏芳意，苦苦何时足。\n巴城憔悴，采歌犹闻新曲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其三","author":"郑域","text":"东陵美景，有轻烟和月，斜风吹雨。\n一体龙须随地转，不学松萝儿女。\n结就员青，收来掌握，犹带金盘露。\n拍浮金井，水花零乱飞舞。\n谁信六月飘霜，破开落刃，散银丝金缕。\n冷碧凄香萦齿颊，洗我尘襟烦暑。\n杜老吟诗，巳公留客，此兴无今古。\n安期非诞，世间有枣如许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其二","author":"郑域","text":"蕊宫仙子，爱痴儿、不禁三偷家果。\n弃核成根传汉苑，依旧风烟难□。\n老养丹砂，长留红脸，点透胭脂颗。\n金盘盛处，恍然天上新堕。\n莫厌对此飞觞，千年一熟，异人间梨枣。\n刘阮尘缘犹未断，却向花间飞过。\n争似莲枝，摘来满把，莺嘴平分破。\n餐霞嚼露，镇长歌醉蓬岛。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"画堂春 春思","author":"郑域","text":"东风吹雨破花悭。\n客毡晓梦生寒。\n有人斜倚小屏山。\n蹙损眉弯。\n合是一钗双燕，却成两镜孤鸾。\n暮云修竹泪留残。\n翠袖凝斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭君怨 梅花","author":"郑域","text":"道是花来春未，道是雪来香异。\n竹外一枝斜，野人家。\n冷落竹篱茅舍，富贵玉堂琼榭。\n两地不同栽，一般开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人 春愁","author":"郑域","text":"东风料峭寒吹面。\n低下绣帘休卷。\n憔悴怕他春见。\n一任莺花怨。\n新愁不受诗排遣。\n尘满玉毫金砚。\n若问此愁深浅。\n天阔浮云远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 别恨","author":"郑域","text":"酒薄愁浓醉不成。\n夜长敧枕数残更。\n嫩寒时节过烧灯。\n已自孤鸾羞对镜，未能双凤怕闻笙。\n莫教吹作别离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"郑域","text":"九里花田地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"郑域","text":"槟榔共聘币。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"郑域","text":"果子庵摩勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"郑域","text":"旅程一见错欢喜，彷佛吾乡茉莉花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夹漈草堂","author":"郑寅","text":"地隔一区石，山高两漈深。\n弓旌已陈迹，泉石高馀音。\n若不登兹境，何由见古心。\n遗编湮没久，思与共追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"郑庶","text":"千古钓台下，老尽去来人。\n倚空绝壁，朝暮秀色只如春。\n高挂瀑泉千尺，洗到云根山骨，无处著风尘。\n秋尽玉壶冷，别是一乾坤。\n问当日，中兴将，汉功臣。\n云台何在，寂寞谁复记丹青。\n争似先生标致，长共清风明月，不减旧精神。\n无限兴亡意，舒卷在丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其三 双港明月","author":"郑得彝","text":"沄沄逝水夹沧洲，金耀浮光碎碧流。\n夜半渔歌声再起，一天明月两溪秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其四 半山残雪","author":"郑得彝","text":"寒峰苍削露痕晴，残雪遥疑宿冻云。\n茶话尚馀清绝趣，半瓯真味许僧分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其六 别浦归帆","author":"郑得彝","text":"望断烟波眼欲空，霞光明衬暮天红。\n水高数尺舟归急，幅幅蒲帆饱受风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其八 村市晓烟","author":"郑得彝","text":"微茫村市隐江湄，三两人家欲早炊。\n翠箔楼台烟半湿，不知红日上花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其七 断岸浮梁","author":"郑得彝","text":"轻舠簇簇水溶溶，影落空江万丈虹。\n溱洧更无人病涉，浮梁千载纪成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其五 渔村夕照","author":"郑得彝","text":"小艇穿鱼醉夕阳，柔条犹可折残杨。\n数家网罟孤村外，渔唱一声烟水长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其一","author":"郑得彝","text":"雨急林花第几峰，层层岩翠沐嵌空。\n回头万象皆生意，绿遍天涯造化功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙游八景 其二 瀫水晴风","author":"郑得彝","text":"鲛鮹蓝色染初匀，风皱粼粼渺水云。\n安得此溪还姓冉，名高千载柳州文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠光岩","author":"郑得彝","text":"一棹巨川舟，相随物外游。\n芳尘曾未逐，春兴若为酬。\n酌石花阴湿，题岩藓墨浮。\n沙鸥应笑我，留住瀫溪头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮丘祠","author":"郑晦","text":"青天志欲骑长虹，半生双眼四海空。\n题诗远寄广成子，笔力万仞摇崆峒。\n前年鹤背乘天风，翻然回首江之东。\n束书归隐黄山中，山中偶遇浮丘翁。\n人生寰宇总过客，呼酒浇愁醉李白。\n十亩耕云种紫芝，酣歌击石嫌春窄。\n招浮丘，乾坤到处堪遨游。\n丈夫有志身徇国，逢时无意干封侯。\n皇天恩泽盈遐陬，忍视吴楚森戈矛。\n黄金白璧岂足尚，我爱文章有官样。\n长篇欲向庵壁题，凭陵豪气三千丈。\n住庵道人请书壁，秃毫轰雷停不得。\n飞香洒雪淋漓湿，一夜寒风瘦蛟泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父","author":"郑梦周","text":"披却蓑衣翁自渔，青荷包饭柳穿鱼。\n时归坐在短篷底，白占一溪云水居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一岩","author":"郑清之","text":"一岩洞空挂云山，巧印穹苍半璧环。\n只为广寒宫殿远，故留阙月在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙巳三月出湖口占 其一","author":"郑清之","text":"几朝花片落书奁，未信春光已属厌。\n猛省清明今日是，家家青柳压朱檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙巳三月出湖口占 其二","author":"郑清之","text":"晓日慇勤为着鞭，微风逐旋约轻烟。\n东皇景胜浑如旧，西子妆浓许近前。\n槛外客山今对展，禊时朋酒占初筵。\n十年重访苏堤柳，总付春光入画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月上弦夕","author":"郑清之","text":"轻风熨贴晚云开，为放中秋半月来。\n待得月圆多值雨，不如今夕共樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月初五梦桃杏枝上皆小蕊顷刻间一花先开既而次第皆拆色殊红鲜可爱梦中为赋一诗觉但记其第二句戏足成之","author":"郑清之","text":"天孙红锦浅深裁，为惜芳苞未肯开。\n争奈东风披拂甚，枝头次第吐香腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十四日自东山到金峨一宿而归偶题壁上安晚居士自觉际航湖入东山道金文意行至此淡晴轻冷风策策有声草树清幽泉石雅洁如在天竺灵隐间深靓过之既暮假榻瀑通夕喧枕始印鲁直梦成风雨诗粥鱼鸣展钵而去因笔一绝","author":"郑清之","text":"桥石天台水谷帘，峰回秀拥更深严。\n我来便欲兼忘世，少立清风为拂髯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上清宫 其一","author":"郑清之","text":"雨馀日脚到天涯，十里平山戴晚霞。\n疑是千虹蟠绛阙，频移光景入仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兀坐","author":"郑清之","text":"夜听寒蛩晓听蝉，梧桐疏雨晚秋天。\n空斋抱膝元无事，半是痴憨半是禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口占","author":"郑清之","text":"谁道寒官俸给稀，赍装满路得追随。\n秋光不与诗肠算，无限江山信笔支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小憩上庵","author":"郑清之","text":"竹边深静纳新晴，瘦策徐行足力轻。\n曲槛负墙尘不到，游蜂时寄采花声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤栖方丈","author":"郑清之","text":"矮伯老于周柱史，瘦梅青似楚离骚。\n推窗欲觅登山路，无数青苔落鹳毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其一","author":"郑清之","text":"二老毫端一滴曹，唤醒䆿语没忉忉。\n更无慧可安身处，作么当时立得牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其四","author":"郑清之","text":"书经犹有遮个在，画佛何曾梦见来。\n玲石玉峰雷雨过，梅花昨夜一枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其三","author":"郑清之","text":"龙宫海藏自分明，搕?滩头一任倾。\n因果若还终不昧，政须防作野狐鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其九","author":"郑清之","text":"般柴运水老庞禅，佛法无多在密边。\n饼汝将来还与汝，因师交点更团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其十","author":"郑清之","text":"生老年来病已深，灸瘢着艾复难禁。\n六根四大元无有，何处求师下一针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其八","author":"郑清之","text":"老胡无圣亦无言，蓦指虚空唤作禅。\n掌血条痕无着处，教谁白地患青颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其五","author":"郑清之","text":"三经已是太多罗，州去休休更问婆。\n个里幸然无一事，何须终日把砖磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天育二老禅惠示经佛偈答以十诗 其二","author":"郑清之","text":"馀尘明极强分离，菩萨如来是阿谁。\n既道本来无一物，将何芥子纳须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太史报彗星没","author":"郑清之","text":"老彗妖芒欲爇天，王良见迫为收鞭。\n紫微一夜玑衡转，甘雨祥风到野田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬瓜","author":"郑清之","text":"剪剪黄花秋后春，霜皮露叶护长身。\n生来笼统君休笑，腹里能容数百人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉泉观鱼","author":"郑清之","text":"金鳞玉翅舞涟漪，雷雨休言变化迟。\n尺水能开千里润，看来端的是龙儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作窗蝇诗","author":"郑清之","text":"曾记窗蝇古德诗，笑渠未有出头时。\n蓦然撞破窗间纸，透出虚空未是迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏嘲杜宇","author":"郑清之","text":"呼晴不似鸠知务，报喜何如鹊爱人。\n有口自鸣谁禁汝，乱啼何必待残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯薪","author":"郑清之","text":"小草虚心不染尘，传灯会上屡焚身。\n光明一点元无尽，谩结空花作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]