[{"title":"浙江晚眺","author":"黄复之","text":"越口对吴头，风烟画出秋。\n帆遥疑不动，鸥下若相投。\n云敛山争出，潮生水逆流。\n平生得意处，杯酒凭江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"滕王阁","author":"黄复之","text":"飞阁岧峣倚天半，千里秋毫掌中看。\n城下江声铁马行，梁间日影金蛇窜。\n词客寂寥光景闲，秀色不改惟西山。\n朝来敛黛作眉语，问此风月何当还。\n便须领略追绝唱，终古发扬无尽藏。\n惜哉元婴不读书，笔端祇作蛱蝶图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇面六言","author":"黄复之","text":"峡束天围渐小，林穿日脚微明。\n竹居有径谁扫，水碓无人自鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北楼","author":"黄奕","text":"百尺危楼四远明，人从鳌背戏沧溟。\n乾坤到处皆在目，山海何人更作经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤凰台","author":"黄度","text":"江淮表里拱神州，底事干戈不肯休。\n试上凤凰台上望，定山尽处是瓜洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玄武湖 其一","author":"黄度","text":"玄武湖中春草生，依稀想见竹篱城。\n后来万堞如云起，方恨图王事不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玄武湖 其二","author":"黄度","text":"万骑连山噪虎熊，千艘激浪泣鱼龙。\n变迁陵谷有如此，应笑铜驼无定踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹭亭","author":"黄度","text":"白鹭亭前白鹭飞，定知公子未忘机。\n我来犹识难驯意，江际翩翩趁落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冶城楼 其一","author":"黄度","text":"果然当国擅功名，著屐闲来上冶城。\n久欲乘风还海道，江山佳处尚关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冶城楼 其二","author":"黄度","text":"春秋将绝书刘子，汉史虽终述武侯。\n旧国不知遗烈在，我来偶作冶城楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青溪阁","author":"黄度","text":"江家旧宅枕溪头，谁向溪湾著小楼。\n无奈当年亡国恨，潮生潮落几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅岭冈","author":"黄度","text":"梅冈丘垄已难寻，堪恨吴儿太忍心。\n闻道土山标擘处，原头丛薄不成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"黄庭佐","text":"露着桂枝晓，霜护菊篱秋。\n无尘玉宇南极，一点瑞光浮。\n崧岳精英瑞世，河洛图书寓直，琳馆奉宸游。\n独袖功名手，谁与复神州。\n带垂金，头尚黑，紫绮裘。\n年年今日，灵寿扶出富民侯。\n应为娉婷一笑，烂醉葡萄新熟，明月满西楼。\n西北雨峰峙，端与寿山侔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一夕风雨花药都尽唯有豨莶一丛濯濯得意戏题","author":"黄庭坚","text":"红药山丹逐晓风，春荣分到豨莶丛。\n朱颜颇欲辞镜去，煮叶掘根傥见功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日对菊有怀粹老在河上四首 其四","author":"黄庭坚","text":"碧窗闲杀春风手，古柳堤莺几日回。\n纵有黄花堪对酒，应无红袖与传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日对菊有怀粹老在河上四首 其三","author":"黄庭坚","text":"忆得旧时重九日，紫萸黄菊压梳钗。\n寒花有意催垂泪，喜鹊无端屡下阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日对菊有怀粹老在河上四首 其二","author":"黄庭坚","text":"黄花节晚犹可惜，青眼故人殊未来。\n金蕊飞觞无计共，香钿满地始应回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日对菊有怀粹老在河上四首 其一","author":"黄庭坚","text":"月邀棋约屡登台，学省公厅只对街。\n九日菊花孤痛饮，百端人事可安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入穷巷谒李材叟翘叟戏赠兼简田子平三首 其三","author":"黄庭坚","text":"田郎杞菊荒三径，文字时追二叟游。\n万卷藏书多未见，老夫端拟乞荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入穷巷谒李材叟翘叟戏赠兼简田子平三首 其二","author":"黄庭坚","text":"只可阕中安止止，谁能铁里斗铮铮。\n田多谷少无人会，譬似无田过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入穷巷谒李材叟翘叟戏赠兼简田子平三首 其一","author":"黄庭坚","text":"紫冠黄钿网丝窠，蝶绕蜂围奈晚何。\n二叟家居如避世，开门自少俗人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"几道复觅槟榔","author":"黄庭坚","text":"蛮烟雨里红千树，逐水排痰肘后方。\n莫笑忍饥穷县令，烦君一斛寄槟榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月十五早饭清都观逍遥堂","author":"黄庭坚","text":"心游魏阙鱼千里，梦觉邯郸黍一炊。\n蔬食菜羹吾亦饱，逍遥堂下叶辞枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十四弟归洪州赋莫如兄弟四章赠行 其一","author":"黄庭坚","text":"恼人自作乐，休休莫莫莫。\n相看将白头，止有不如昨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十四弟归洪州赋莫如兄弟四章赠行 其三","author":"黄庭坚","text":"志欲收九族，别离乃同生。\n谁能成此意，惟有孔方兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又戏为双井解嘲","author":"黄庭坚","text":"山芽落硙风回雪，曾为尚书破睡来。\n勿以姬姜弃蕉萃，逢时瓦釜亦鸣雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又戏呈康国","author":"黄庭坚","text":"整冠行客莫先尝，杨子家无数仞墙。\n假借肃霜令弄色，勾添寒日与争黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又戏题下岩","author":"黄庭坚","text":"往往携家来托宿，裙襦参错佛衣巾。\n未嫌满院油头臭，蹋破苔钱最恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又借前韵见意","author":"黄庭坚","text":"招潮瘦恶无永味，海镜纤毫只强颜。\n想见霜脐当大嚼，梦回雪压摩围山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又寄王立之","author":"黄庭坚","text":"南人羁旅不成归，梦绕南枝与北枝。\n安得孤根连夜发，要当雪月群明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又答寄糖霜颂","author":"黄庭坚","text":"远寄蔗霜知有味，胜于崔浩水精盐。\n正宗扫地从谁说，我舌犹能及鼻尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万州太守高公宿约游岑公洞，而夜雨连明，戏赠二小诗 其一","author":"苏轼","text":"肩舆欲到岑公洞，正怯冲泥傍险行。\n定是岑公閟清境，春江一夜雨连明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万州太守高仲本宿约游岑公洞而夜雨连明戏作二首 其二","author":"黄庭坚","text":"蓬窗高卧雨如绳，恰似糟床压酒声。\n今日岑公不能饮，吾侪闻健且频倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上萧家峡","author":"黄庭坚","text":"玉笥峰前几百家，山明松雪水明沙。\n趁虚人集春蔬好，桑菌竹萌烟蕨芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李公择道中见两客布衣班荆而坐对戏弈秋因作一绝","author":"黄庭坚","text":"两客班荆覆局图，看人车马溷泥涂。\n文昌八座邻枢极，天上归来愧不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞姚花二首 其二","author":"黄庭坚","text":"青春日月鸟飞过，汗简文书山叠重。\n乞取好花天上看，宫衣黄带御炉烘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞姚花二首 其一","author":"黄庭坚","text":"正是风光懒困时，姚黄开晚落应迟。\n欲雕好句乞春色，日历如山不到诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞猫","author":"黄庭坚","text":"秋来鼠辈欺猫死，窥瓮翻盘搅夜眠。\n闻道狸奴将数子，买鱼穿柳聘衔蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风","author":"黄庭坚","text":"霜重天高日色微，颠狂红叶上阶飞。\n北风不惜江南客，更入破窗吹客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大暑水阁听晋卿家昭华吹笛","author":"黄庭坚","text":"蕲竹能吟水底龙，玉人应在月明中。\n何时为洗秋空热，散作霜天落叶风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子产庙","author":"黄庭坚","text":"区区小郑多君子，谁若公孙用意深。\n监巫执节诛腹诽，不除乡校独何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首 其四","author":"黄庭坚","text":"乐天名位聊相似，却是初无富贵心。\n只欠小蛮樊素在，我知造物爱公深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首 其三","author":"黄庭坚","text":"封掌丝纶罢记言，职亲黄屋傍尧轩。\n雁行飞上犹回首，不受青云富贵吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首 其一","author":"黄庭坚","text":"赤壁归来入紫清，堂堂心在鬓彫零。\n江沙踏破青鞋底，却结丝絇侍禁庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首 其二","author":"黄庭坚","text":"胸蟠万卷夜光寒，笔倒三江砚滴乾。\n大似不蒙稽古力，只今犹著侍臣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小鸭","author":"黄庭坚","text":"小鸭看从笔下生，幻法生机全得妙。\n自知力小畏沧波，睡起晴沙依晚照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为黄龙心禅师烧香颂三首 其三","author":"黄庭坚","text":"海风吹落楞伽山，四海山徒著眼看。\n一把柳丝收不得，和风搭在玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为慧林冲禅师烧香颂三首 其二","author":"黄庭坚","text":"多年破衲不胜针，一曲胡笳无古今。\n往日闻韶独忘味，守株人在月西沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书王氏梦锡扇","author":"黄庭坚","text":"压枝梅子大于钱，惭愧春光又一年。\n亭午无人初破睡，杜鹃啼在柳梢边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书扇","author":"黄庭坚","text":"鲁公笔法屋漏雨，未减右军锥画沙。\n可惜团团新月面，故教零乱黑云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书舞阳西寺旧题处","author":"黄庭坚","text":"万事纷纷日日新，当时题壁是前身。\n寺僧物色来相访，我似昔人非昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书蔡秀才屏风颂四首 其四","author":"黄庭坚","text":"读经一字礼一拜，瘦骨棱棱心苦辛。\n看伊冷淡教人笑，定作阎浮百岁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予去岁在长沙数与处度元实相从把酒自过岭来不复有此乐感叹之馀戏成一绝","author":"黄庭坚","text":"玄霜捣尽音尘绝，去作湖南万里春。\n想见山川佳绝地，落花飞絮转愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"今岁官茶极妙而难为赏音者戏作两诗用前韵 其二","author":"黄庭坚","text":"乳花翻椀正眉开，时苦渴羌冲热来。\n知味者谁心已许，维摩虽默语如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"今岁官茶极妙而难为赏音者戏作两诗用前韵 其一","author":"黄庭坚","text":"鸡苏狗虱难同味，怀取君恩归去来。\n青箬湖边寻顾陆，白莲社里觅宗雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从人求花","author":"黄庭坚","text":"舍南舍北勃姑啼，体中不佳阴雨垂。\n欲向黄梅问消息，背阴合有两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从张仲谋乞蜡梅","author":"黄庭坚","text":"闻君寺后野梅发，香蜜染成宫样黄。\n不拟折来遮老眼，欲知春色到池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从时中乞蒲团","author":"黄庭坚","text":"扑屋阴风雪作团，织蒲投我最宜寒。\n君当自致青云上，快取金狨覆马鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从时中乞蒲团","author":"黄庭坚","text":"织蒲投我最宜寒，正欲阴风雪作团。\n方竹火炉趺坐稳，何如矍铄跨征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从舅氏李公择将抵京辅以归江南初自淮之西犹未秋日思归","author":"黄庭坚","text":"归心摇摇若鞦带，哀操切切如蝉吟。\n百年双鬓欲俱白，千里一书真万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仓后酒正厅昔唐林夫谪官所作十一月己卯余纳秋租隔墙芙蓉盛开","author":"黄庭坚","text":"攀槛朱云头未白，不知流落向何州。\n空馀前日学书地，小阁红蕖取意秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以天坛灵寿杖送莘老","author":"黄庭坚","text":"王屋千霜老紫藤，扶公休沐对亲朋。\n异时驷马安车去，拄到天坛愿力能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以虎臂杖送李任道二首 其二","author":"黄庭坚","text":"未衰筋力先扶杖，能救衰年十二三。\n八百老彭嗟杖晚，可怜矍铄马征南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以虎臂杖送李任道二首 其一","author":"黄庭坚","text":"走送书堂倚绛纱，瘦藤七尺走惊蛇。\n晴沙每要交头拄，寻遍渔翁野老家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以金沙酴醾送公寿","author":"黄庭坚","text":"天遣酴醾玉作花，紫绵揉色染金沙。\n凭君著意樽前看，便与春工立等差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以梅馈晁深道戏赠二首 其二","author":"黄庭坚","text":"渴梦吞江起解颜，诗成有味齿牙间。\n前身邺下刘公干，今日江南庾子山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以梅馈晁深道戏赠二首 其一","author":"黄庭坚","text":"带叶连枝摘未残，依依茶坞竹篱间。\n相如病渴应须此，莫与文君蹙远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以椰子小冠送子予","author":"黄庭坚","text":"浆成乳酒醺人醉，肉截鹅肪上客盘。\n有核如匏可彫琢，道装宜作玉人冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以潞公所惠拣芽送公择次旧韵","author":"黄庭坚","text":"庆云十六升龙样，国老元年密赐来。\n披拂龙纹射牛斗，外家英鉴似张雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公择用前韵嘲戏双井","author":"黄庭坚","text":"万仞峰前双井坞，婆娑曾占早春来。\n如今摸索苍龙璧，沈井铜瓶漫学雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公益尝茶","author":"黄庭坚","text":"子云窗下草玄经，寒雀争喧户昼扃。\n好事应无携酒榼，相过聊欲煮茶瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十七日昼寝","author":"黄庭坚","text":"红尘席帽乌韡里，想见沧洲白鸟双。\n马龁枯萁喧午枕，梦成风雨浪翻江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双涧寺二首 其二","author":"黄庭坚","text":"山陕江深屋翠崖，夜钟声自瓮中来。\n长松偃蹇苍龙卧，六月涧泉轰怒雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双涧寺二首 其一","author":"黄庭坚","text":"二水奔奔鸣屋除，松林落日吼乌菟。\n老僧更有百岁母，白发身为反哺乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平州作二首 其二","author":"黄庭坚","text":"千古人心指下传，杨姝烟月过年年。\n不知心向谁边切，弹尽松风欲断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]