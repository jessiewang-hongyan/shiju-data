[{"title":"偈五十三首 其四十五","author":"释克勤","text":"深深处，无物堪比伦。\n浅浅个，两手相分付。\n以一统万，穿众穴于毫端。\n补短截长，握秤尺于掌内。\n意气不从天地得，英雄岂藉四时推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其四十六","author":"释克勤","text":"叶落知秋，动弦别曲。\n定光拈手，智者点头。\n承当于文彩未彰前，相照向是非得失外。\n不涉廉纤，如何通信。\n万景徒有象，孤云本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其四十七","author":"释克勤","text":"玄玄玄，太颟顸。\n了了了，没边表。\n有生有灭，特地乖张。\n无去无来，转见漏逗。\n不起寂灭定，而现诸威仪。\n不舍凡夫法，而修诸胜行。\n随流认得性，无喜亦无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其四十八","author":"释克勤","text":"大人具大见，大智得大用。\n一飞六月息，一诺千金重。\n滔天必江海，崔嵬必山岳。\n先知觉未知，先觉觉后觉。\n打开无尽藏，运出无价珍。\n不依倚一物，显示本来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其四十九","author":"释克勤","text":"突出难辨，久参未免躇蹰。\n信手拈来，后学那知端的。\n金风扇物，玉露垂珠。\n雁过长空，蛩吟幽砌。\n一一七穿八穴，明明百匝千重。\n何必棒喝交驰，方论照用。\n直下悬崖撒手，便有恁么人么。\n见义不为非勇士，临危不变始惊群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其五十","author":"释克勤","text":"一切无收摄，触处圆成。\n应用绝参差，莫穷形相。\n向千圣顶?上，有时露出佛祖莫穷底机关。\n于一毫端中，有时演出主宾互换底文彩。\n经天纬地，玉转珠回。\n海神知贵不知价，留与人间光照夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其五十一","author":"释克勤","text":"一向孤峰独宿，目视云霄。\n虽则不埋没宗风，无乃太高生。\n一向十字路口，土面灰头，利物应机。\n虽则埋没自己，无乃太屈辱生。\n况明悟之士，顶门具眼，肘后有符。\n出没卷舒，得大自在。\n动若浮云，止犹谷神。\n或可以孤峰独宿，不碍土面灰头。\n或土面灰头，不碍孤峰独宿。\n恁么中有不恁么，不恁么中却有恁么。\n瑞气逢嘉运，灵苗触处春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其五十二","author":"释克勤","text":"古佛有通津，当阳亘古今。\n悬崖能撒手，一语直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其五十三","author":"释克勤","text":"行棒行喝，拽石搬土。\n象骨辊毬，禾山打鼓。\n沩岭牧牛，玄沙见虎。\n吃茶赵州，面壁鲁祖。\n争似老云门，腊月二十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五十三首 其五十四","author":"释克勤","text":"乾茆近火，理合先燋。\n滴水生冰，事不相涉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为佛眼下火","author":"释克勤","text":"如来涅槃日，娑罗双树间。\n放出三昧火，阇维金色身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为亡僧下火","author":"释克勤","text":"五蕴山头涅槃路，四方八面没遮拦。\n通身尽是金刚眼，一粒灵丹火里燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其一 德山小参不答话。","author":"释克勤","text":"大冶烹金，忽雷惊春。\n草木秀发，光辉日新。\n不费纤毫力，擒下天麒麟。\n全威杀活得自在，千古照耀同冰轮。\n话作两橛，句中眼活。\n龙头蛇尾，以指喻指。\n撞著露柱瞎衲僧，塞断咽喉无出气。\n拟议寻思隔万山，咭嘹舌头三万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其二 女子出定。","author":"释克勤","text":"大定等虚空，廓然谁辨的。\n女子与瞿昙，据令何调直。\n师子奋迅兮，摇乾荡坤。\n象王回旋兮，不资馀力。\n孰胜孰负，谁出谁入。\n雨散云收，青天白日。\n君不见马驹踏杀天下人，临济未是白拈贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其三 须弥山。","author":"释克勤","text":"石笋抽条，泥牛吼月。\n谁料同舟自胡越，应机涌出须弥卢。\n一念不生，何处雷，无处雪，金刚宝剑当头截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其四 麻谷持锡到章敬又到南泉。","author":"释克勤","text":"如是不是，去却药忌。\n拟犯封疆，全军失利。\n杖头突出古菱华，举世风流出当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其五 透网金鳞以何为食。","author":"释克勤","text":"百草头出没，三界外遨游。\n从布漫天网，虚下钩鳌钩。\n摇鳞振鬣撼乾坤，兀目昂头洪浪喷。\n棒雨点，喝雷奔，肯将争战定功勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其六 麻三斤。","author":"释克勤","text":"钟在扣谷受响，池印月镜含僧。\n曾非展事投机，岂是预搔待痒。\n点铁成金，举直措枉。\n一箭雕一双，一掴血一掌。\n君不见疏而不漏兮恢恢天网。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其七 云门示众云：人人尽有光明在。","author":"释克勤","text":"夜明帘外千峰秀，鸾镜台前万象虚。\n扫踪灭迹，不立锱铢。\n谁为佛殿，谁是香厨。\n敲出凤凰五色髓，击碎骊龙明月珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释克勤","text":"金鸭香销锦绣帏，笙歌丛里醉扶归。\n少年一段风流事，祇许佳人独自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释克勤","text":"本来无形段，那复有唇觜。\n特地广称扬，替他说道理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释克勤","text":"十方同聚会，本来身不昧。\n个个学无为，顶上用钳锤。\n此是选佛场，深广莫能量。\n心空及第归，利剑不如锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释克勤","text":"休誇四分罢楞严，按下云头彻底参。\n莫学亮公亲马祖，还如德峤访龙潭。\n七年往返游昭觉，三载翱翔上碧岩。\n今日烦充第一座，百华丛里现优昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示善友","author":"释克勤","text":"此段本来无向背，要须坚猛力行持。\n金刚正眼通身是，万境来侵莫管伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古联珠","author":"释克勤","text":"雪峰骑骏马，云门跨驴儿，一踢一踏相奔驰。\n长安有路非无路，夜半行时人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释克勤","text":"收光摄彩信尺真，事事圆成物物新。\n内若有心还有物，何能移步出通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠思净律师","author":"释克勤","text":"百万斋才了正因，大缘倏举只逡巡。\n凿将玛瑙一方石，镌作龙华百尺身。\n天竺江山增秀丽，西湖风月愈清新。\n色声不动操能事，可是僧中英特人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释克勤","text":"庵前永日无狼子，磨下终年绝雀儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿皇恐滩","author":"黄得礼","text":"倦客逢长至，扁舟泊远滩。\n居常谙寂寞，童稚笑相欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈云寺","author":"朱褒","text":"崩崖落云外，怪石相支撑。\n穿林出蒙密，忽有青山横。\n古寺瞰山腹，飞檐浮太清。\n寒流出其右，㶁㶁沿阶鸣。\n我昔作胜游，芒鞋弄飞径。\n今来四十年，白首徒自惊。\n高僧延我入，巾冠耸峥嵘。\n假榻寄清梦，飞泉夜澎轰。\n残灯闻弈棋，胜负时纷争。\n机心亦何有，战罢谩亏成。\n钟声随晓风，昴宿西南倾。\n骊驹仆在门，吾亦问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾密公江楼诗韵","author":"朱褒","text":"太史声名重，江楼昔有言。\n诗清排屈宋，意古挹羲轩。\n飞栋苍云合，窥鱼白羽翻。\n台高萦水府，气爽返梅魂。\n市远风埃洁，川腴草木繁。\n沧浪初出日，瓠落可浮樽。\n曲岸疏帆影，枯槎隐烧痕。\n秋容天漠漠，春意雨昏昏。\n地易规模在，碑新典则存。\n溪山重入座，先哲岂虚论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦屏峰","author":"郑南","text":"霍童佳境本天成，十里莲花遍处生。\n山色依然仙不至，月明徒自忆吹笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮云楼","author":"张之才","text":"安州水西寺，李白旧题诗。\n今古已堪叹，风烟独昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去任辞汤庙","author":"张之才","text":"一官来此四经春，不愧苍天不愧民。\n神道有灵应信我，去时犹似到时贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 乘初游慧聚到翠屏轩上月华转上方及翠微阁日已晚矣不容他访乃归","author":"李乘","text":"两月寓昆山，耳目厌烦闹。\n饮啄落樊中，多嚬少嬉笑。\n岁节簿书稀，慧聚富清峭。\n愿偷一日閒，进步访殊调。\n石台出神功，殿宇自梁诏。\n胜境布高低，虽难亦容造。\n平阁翠屏轩，苍然插峰峤。\n满眼岁寒物，将迎若盟要。\n新阁亦虚明，隐显入凭眺。\n乾坤指顾閒，孙登一长啸。\n迤逦上月华，老碧倚烟奥。\n夜半谁有力，负鳌族嵩少。\n层层转上方，冰岩隐诸妙。\n嵌崆本自然，不凿混沌窍。\n方寸有泓泉，清彻宛秦照。\n几次菖蒲风，为解众生躁。\n别有古道场，数级下移趠。\n石佛梦中来，天手造容貌。\n于此稍盘桓，平昔恨难到。\n欲掷下山筇，尽作雾中豹。\n奈何苟禄身，未得从吾好。\n他日龙眠山，相期有耕钓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 依孟东野韵","author":"李乘","text":"千山贮云房，瓶钵安空床。\n野籁有真响，天葩无世香。\n巢鹳羽翎老，睡僧眉宇光。\n此外足忧喜，劳劳荣辱场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 依张承吉韵","author":"李乘","text":"一寺皆楼殿，虽雄向此吞。\n云霞终日影，桧柏几年根。\n槛俯水烟国，磬传鸡犬村。\n倚窗翻贝叶，宴寂属空门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 压云轩依张朝奉韵","author":"李乘","text":"路峻山穷顶，岩低木露梢。\n半天修日观，一室分枝巢。\n帆去归渔市，钟来报寺庖。\n世閒荣悴事，寒暑转烟郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 又依朱秀才韵","author":"李乘","text":"金阙山头辟一轩，轩閒身世两超然。\n阶临霭霭张公市，檐接青青广乐天。\n风聒近林容虎啸，雨腥低洞有龙眠。\n坐看起处分明甚，不羡王维到水边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 翠微庵","author":"李乘","text":"胜境增添岂偶然，已前无屋事金仙。\n巨灵擘到三千丈，向老基来八百年。\n远远别山来白足，重重峻宇出青莲。\n端严石像庵犹在，若个寻庵复坐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 灵山讲堂","author":"李乘","text":"佛度亿万众，山是说经所。\n今人说猊座，亦作潮音主。\n何必诸比丘，曾见五花雨。\n面壁无说人，家风自一祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 月华阁","author":"李乘","text":"依稀瑶径通云隙，藓石模糊数千尺。\n昂者如飞俯者驰，叠叠寒空翠光滴。\n影高中逗日月辉，阴助草灵春不识。\n王屋壶中体浅深，来者增添爱山僻。\n有人隐几每忘饥，姓名自愧樊中客。\n结庐纵拟续琴歌，却忆猿惊旧山侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 东斋","author":"李乘","text":"峭绝山根野水旁，栏干瞰水有山房。\n鱼藏似识秋风冷，僧睡那知世路忙。\n金磬一声清恋竹，石矶数级碧皴霜。\n耻罍未忍轻归去，班嗣垂纶此兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 又依向主簿韵","author":"李乘","text":"鹭飞万顷碧光中，楚楚缁庐枕水穷。\n事外有缘三径邃，眼前无碍九霄通。\n转山僧道筇携雨，载月渔归席挂风。\n一切世间虚幻事，隔堤请看数枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 岩阴堂","author":"李乘","text":"寒帚高悬绝点埃，贮藏秋色枕山隈。\n僧眠石室衣生雾，客步莎庭迹印苔。\n占竹鸳雏容得老，采花蜂蝶枉教来。\n澄怀观道如痴者，兀坐忘归忽自咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 慧照堂","author":"李乘","text":"眼亦不碌碌，耳亦不碌碌。\n云外野鸣幽，霜中岁寒绿。\n何必面南山，真理明明足。\n客问慧照名，僧拈一枝菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 少林堂","author":"李乘","text":"无欠无馀丈室幽，鸡鸣而动晦而休。\n利名涉处尘尘热，香火缘中日日秋。\n祇解结跏临竹石，懒将叉手对公侯。\n有人来问禅宗旨，告道明明百草头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 素琴堂","author":"李乘","text":"长官发已星，强持牧羊箠。\n故山荒草堂，为贫不知耻。\n衮衮敲朴庭，缨裾渍尘滓。\n子贱敬可高，七弦不离指。\n今日到僧房，阴森翠堆几。\n数拳解巑岏，一泓粗清泚。\n瑞草不知名，芬我胜兰芷。\n天籁更自然，世音亦何俚。\n长官趣如何，依稀琴在此。\n返思子贱琴，未免尚宫徵。\n弹与不弹间，一切聊尔耳。\n兀坐纵无言，汤汤寓流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 翠屏轩","author":"李乘","text":"轩对山开昼不扃，山迎轩耸展如屏。\n高低楼阁安三宝，向背峰峦荷五丁。\n秋雨松林成水墨，春风花谷具丹青。\n谁人坦腹来高枕，笑傲羲皇任醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 连云阁","author":"李乘","text":"摇摇曳曳白云轻，檐外多般弄晦晴。\n龙与去来无定影，僧将舒卷伴真情。\n雪留瑩彻层霄在，云散森罗万象清。\n试问主僧还解否，毗耶消息甚分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 西斋","author":"李乘","text":"老后名山付卧游，偶携谢屐此寻幽。\n每思南岳嘲周子，何暇东林访惠休。\n苔护出生苍石老，竹供延客碧云秋。\n主僧不用贪行脚，祇此林间可白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 淩峰阁","author":"李乘","text":"海上飞来据马鞍，灵鳌独坐碧孱颜。\n几年真宰雕镌就，尽日高僧指顾间。\n去市红尘三里远，供人青眼一轩悭。\n半峰有窟龙为宅，云在檐头恣往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 夕秀轩","author":"李乘","text":"逍遥金地与人疏，山静风光碧有馀。\n开筑当年看锡卓，焚修今日听星居。\n灵株瑞草人难识，明月清风室更虚。\n坐久半天琼佩响，泠泠此理属真如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧聚杂题 西庵","author":"李乘","text":"野蔓盘青上短檐，客来径草旋锄芟。\n禽饥闻磬来疏砌，僧饱携筇过别岩。\n茶鼎引烟熏纸帐，竹窗漏月射经函。\n西庵门外如何景，杳杳寒泾一叶帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浔州","author":"萧刓","text":"自广直邕分十郡，绵龚引象列三江。\n水归东海流无尽，山拱西祠势若降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤山","author":"谢黻","text":"高台伊昔来凤凰，于今凤去台亦荒。\n苍苍竹实有霜露，飒飒梧叶生秋凉。\n西风斜日开晴色，閒步瑶阶访仙迹。\n道人诵罢蕊珠经，老鹤一声山月白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山","author":"谢黻","text":"东山一何高，他山不足论。\n其间有玖石，乃是世人珍。\n时与我数友，登高看嶙峋。\n悠然叹黄鹄，飞及下山云。\n我友今年归，寂绝车马尘。\n问言家何许，正与此山邻。\n想为携蜡屐，自往穷朝昕。\n斯游孰可陪，有意徒殷勤。\n门前一溪水，清彻多游鳞。\n安得尺素书，问讯情所亲。\n四时且终穷，明日是青春。\n便作隔岁别，感怀意未伸。\n郊原共游地，我独行逡巡。\n重来望东山，晤语焉可闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠林子山","author":"毕渐","text":"儿童闻说子山名，将谓先生是古人。\n海上偶经仙洞府，岩前犹见玉精神。\n南华久彻逍遥梦，兜率重来自在身。\n携得新诗天上去，不教辜负到全闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼 其一","author":"王絪","text":"太史常挥醉笔，题诗遍满江楼。\n胜事尽随流水，白蘋依旧沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼 其二","author":"王絪","text":"春晚幽花对浦，夜阑明月当轩。\n好在当年胜趣，登临尽属诸孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园载酒和邑宰蔡确韵","author":"徐迪","text":"檐影荫游鱼，江声颤崖竹。\n云帆天外去，龙刹空中矗。\n霞明晚渡红，草暖晴沙绿。\n澄波见归鸟，纷霭迷飞鹜。\n有时雪浪吹，玉马争追逐。\n青霄皓月满，琉璃瑩极目。\n谢傅昔出宰，天葩动惊俗。\n一读梁间诗，清风感佳木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗 其一","author":"胡邃","text":"名重功高服搢绅，精神图画在麒麟。\n去提黼扆还天子，归与园林作主人。\n三径松筠供啸傲，一堂风月替嚣尘。\n时平自有无穷事，谁解如公早退身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗 其二","author":"胡邃","text":"戡定兵戈古所难，盛名何啻重于山。\n收身矢石征诛外，放意林泉杳霭间。\n曾是神龙犹解蛰，岂惟飞鸟会知还。\n上方当宁思元老，正恐询谋未许闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]