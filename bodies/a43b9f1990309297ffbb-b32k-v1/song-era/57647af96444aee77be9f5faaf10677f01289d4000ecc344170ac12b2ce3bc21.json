[{"title":"失题九首 其七","author":"李之仪","text":"映月西湖漾鸭头，堕红飘碧正飞浮。\n逢师来自日边路，如我遂归江上州。\n嵩岭异花开未遍，洛川新燕语方柔。\n经行须作半年计，归去当知难再求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其八","author":"李之仪","text":"薄云疏雨洒雕笼，槎拂银潢月上弓。\n红泪半残歌后烛，翠涛低涌梦回风。\n淬馀剑锷虽为利，解尽犀棱未见通。\n杳杳芝田定何许，断魂无计脱惊鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其九","author":"李之仪","text":"华榱曾记孔鸾栖，断梦还来拂旧题。\n妙悟从谁识无射，赏心空自感雌霓。\n干云宝气层霄外，埋玉孤坟落照西。\n千载相逢定何许，嘐嘐风雨独鸣鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻葬者","author":"李之仪","text":"铙钹高低与哭声，同寻此路不相惊。\n年来自是多伤感，帘外何须问晦明。\n未返耕桑真拙计，长萦缰锁奈虚名。\n无名可恋何贪着，瓶罄须休莫强倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过蒲地寺谒田承居","author":"李之仪","text":"萧寺经行旧，骚人趣尚幽。\n从来不妄许，相见若为愁。\n税驾终何地，乘桴可共舟。\n感君诗有味，老去复谁求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子重见过夜话","author":"李之仪","text":"坐久日将落，窗前云欲平。\n倦游淹岁月，旅闷等坻京。\n已谢长杨赋，犹怀古剑行。\n拥炉虽有味，琢句苦难成。\n一笑逢吾友，诸方旧著名。\n景山惭绝膑，击节愧深耕。\n奥妙穷三际，坚刚敌万兵。\n谁知俯冬杪，顿觉得春荣。\n缱绻桑榆恨，间关儿女情。\n金篦何足道，闇室斗光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三家店早饮主人似喜余至而庭下残花犹在也酒客辄见避余固止之因得揽其醉态 其一","author":"李之仪","text":"再过三家店，还投旧酒垆。\n重攀红踯躅，争认白髭须。\n所惜自拘束，无因同拍扶。\n他年遂卜筑，终为伴歌呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三家店早饮主人似喜余至而庭下残花犹在也酒客辄见避余固止之因得揽其醉态 其二","author":"李之仪","text":"醉人休见避，我恨未如君。\n到了输他乐，何须强自分。\n稻粱姑取足，鸡鹜漫离群。\n上马冲寒去，回头愧垄云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真师移植新竹","author":"李之仪","text":"锦绷方有托，粉面转相疑。\n渐露凌云节，微分弄月枝。\n高僧开槛赏，野客带砧移。\n只恐成龙去，空来款此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿汤泉示真师二首 其一","author":"李之仪","text":"睡美不觉晓，蜕然犹恋床。\n未能忘夜旦，已自懒衣裳。\n供佛添新水，持经续旧香。\n不知门外路，何事有归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿汤泉示真师二首 其二","author":"李之仪","text":"粥后复就枕，梦中还在家。\n老身知自妄，病厌事如麻。\n渐觉同刍狗，终当悟宝车。\n何妨蓦直去，细啜赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱希仲设榻温密与真师榻相对明日雨止送过金陵","author":"李之仪","text":"居士留我宿，虚堂照一灯。\n如逢永平梦，仍对竹兰僧。\n彷佛三无愠，间关百不能。\n平明失檐溜，欢喜话金陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真师自汤泉相送至石碛遂归索诗为别","author":"李之仪","text":"流落不我弃，如君能几人。\n宁辞迂驿路，且喜慰情亲。\n蹭蹬还逢雨，因循懒问津。\n尤惭远相送，谁谓白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石碛阻雨夜分睡觉枕上","author":"李之仪","text":"一夜雨不止，渡江还不能。\n谁知未归客，独自对孤灯。\n禄食强作主，生涯端是僧。\n都来如一梦，随处且腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石碛寺寺僧以牌求诗","author":"李之仪","text":"花石锁风烟，轩楹半是山。\n门连虎溪路，桥接赵州关。\n屈曲深疑步，高低屡解颜。\n却应多是梦，不伴此身閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅山道中抵莫投一客邸甚素雅主人喜客乃一善士为待至厚既别留此致谢","author":"李之仪","text":"客绪如缲茧，山行似踏车。\n方疑武陵宿，宛是德公家。\n倾盖君何厚，论心我可嗟。\n祗应从此别，去路隔云霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜小舟中雨不止而作雪寄德麟","author":"李之仪","text":"醉侣今何在，寒灯倍黯然。\n却应听雨梦，犹是散花天。\n老境不自得，客程谁我怜。\n晓钟催去路，明日又新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腰痛医者馈药以酒为使命酒对灯欲饮不能","author":"李之仪","text":"我固不善酒，醉中常独颠。\n不词讥濩落，秪恐负妖妍。\n迹类怀沙悴，心驰浊世翩。\n空樽聊口诳，继晷漫膏然。\n未分穷投魏，长思夜刷燕。\n蛇惊元有影，蚁慕本无膻。\n兀坐疑痴鹤，忘形已蜕蝉。\n沧溟虽可径，何意逐鲸鳣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯下试婺源杨生笔和韵","author":"李之仪","text":"局蹐数椽内，回旋跬步中。\n艰生乃至此，吾道得非穷。\n询鞠元无术，行移底是功。\n可堪追兔鼠，强学注鱼虫。\n未厌朝齑绿，生憎夜烛红。\n呻吟惭杜老，感慨谢终童。\n奏剡何时发，微连几日通。\n亲知遥怅望，应是转衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上独坐","author":"李之仪","text":"春至犹飘雪，江寒未有鱼。\n无人慰青眼，尽日对红炉。\n瑟瑟窗频响，愔愔鸟强呼。\n潸然不自觉，岂待到穷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书崇宁观黄道士火匮壁","author":"李之仪","text":"地肺闻名久，崇宁请祝初。\n仙家岂兴废，物理自乘除。\n羽客论欢旧，红炉劝坐俱。\n斯须竟何有，聊复慰穷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同赵德麟宿长河堰僧房德麟适相送至此且约明春再相会有诗见及次其韵","author":"李之仪","text":"涔涔一夜雨，皎皎百年心。\n岁路无多日，僧床有剩衾。\n长卿空涤器，季子漫多金。\n赖有绨袍旧，春风定可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年二月二日自采石过藏云取路回远少憩已入夜遂留宿明日聪师相邀登览偶见西偏地真一方之胜也余方营葬庶几得之以托妙缘既去因留此诗","author":"李之仪","text":"挑菜逢今日，藏云访近山。\n路纡知昼永，心远觉身閒。\n未信尘埃隔，犹疑梦寐间。\n佳城更何卜，便好辍孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书长干僧房二首 其一","author":"李之仪","text":"赤手能搏虎，青毡不与偷。\n真知外物重，未放此缘休。\n平地见山岳，排空回斗牛。\n何须待尘劫，才许證前秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书长干僧房二首 其二","author":"李之仪","text":"问讯无尺寸，顺风留岁时。\n传闻万金积，未叹一生疲。\n突兀端可想，高明还此期。\n他年问初祖，却是宁馨儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东坡赠岭上老人","author":"李之仪","text":"过眼崎岖等劫灰，到头荣悴本谁裁。\n须知此老心如铁，看尽行人几往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年春夏之交閒居无事触绪成咏得绝句五首 其一","author":"李之仪","text":"檐间百啭已莺声，枕上千山尚未明。\n老去只知难得睡，儿童何用报阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年春夏之交閒居无事触绪成咏得绝句五首 其二","author":"李之仪","text":"身世低回不自期，个中消息更谁知。\n江边折尽青青柳，才见云头月画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年春夏之交閒居无事触绪成咏得绝句五首 其三","author":"李之仪","text":"楸花落尽楝花繁，门巷人稀半是村。\n好事凭谁消湿热，一帘疏雨下黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年春夏之交閒居无事触绪成咏得绝句五首 其四","author":"李之仪","text":"庭前日转树交阴，坐上风来境自深。\n度曲已嗟千里客，听蝉已寄两头心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大观四年春夏之交閒居无事触绪成咏得绝句五首 其五","author":"李之仪","text":"江南塞北遍曾游，一饭何方不可留。\n快箸旧尝便蛮耳，垂涎安得饫饘头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题柳氏园","author":"李之仪","text":"昔年车马绕芳丛，倒尽金缸卧醉红。\n可惜秾华俱扫地，兔葵燕麦自春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书真公轩","author":"李之仪","text":"松阴苔径曲盘盘，古佛残灯古殿间。\n却羡老僧无个事，一生长伴白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题","author":"李之仪","text":"新荷点水麦花齐，一抹残阳露浅晖。\n回首西山归未得，片心还逐暮云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"首夏","author":"李之仪","text":"娇红扫尽绿阴成，便觉庭虚暑气生。\n旋拂藤床方竹枕，不妨鼻息作雷鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦迹","author":"李之仪","text":"晦迹丘园敢自图，幸逢泉石作幽居。\n明窗隐几有馀乐，一炷清香卧勘书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饷茶不容少待二绝 其一","author":"李之仪","text":"玉骨冰肌体自轻，非关茗饮觉神清。\n无端堕落红尘里，碾就云腴不许烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饷茶不容少待二绝 其二","author":"李之仪","text":"厌厌酒病结春阴，邻笛传来恨更深。\n拟借春风联袂去，遏云佳处托知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其一","author":"李之仪","text":"过从顿谢懒尤添，倦卧终朝不捲帘。\n晚饭都无官米气，始知身已是苍黔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其二","author":"李之仪","text":"独展离骚吊逐臣，尚存残角报重闉。\n时节自新人易老，未应閒处似他人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其三","author":"李之仪","text":"忆逢新火客秦川，绣岭归来浴暖泉。\n从古盛衰如反掌，累累何地不新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其四","author":"李之仪","text":"旋营香火拂尘埃，市井声传隐隐雷。\n顿觉林泉归已晚，姑从閒处看花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其五","author":"李之仪","text":"贪着崎岖信可羞，误将鬼录作天游。\n东山自是力不足，细论前途有底忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其六","author":"李之仪","text":"春风浩荡思无涯，老病萦仍苦恋家。\n推枕不知真早晚，小窗披雨一庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其七","author":"李之仪","text":"极目湖光彻骨清，无风犹觉尚坚冰。\n心安处处皆堪乐，未必西南是得朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其八","author":"李之仪","text":"十仞惊湍拂面寒，恐人如在百胜竿。\n飞云舞鹤形容处，英爽端疑共此看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其九","author":"李之仪","text":"求田问舍本无期，废弃衰年适此时。\n未拟沃州那旧隐，且从新托试维持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罢官后稍谢宾客十绝 其十","author":"李之仪","text":"何须叹世鹿皮翁，得句真能发笑容。\n谁谓祖风无与寄，寸莛终愧触洪钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔宋镇立秋五绝 其一","author":"李之仪","text":"渡口人归月上钩，萧萧风叶荻花秋。\n因君指出诗人语，便向庭前欲买舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔宋镇立秋五绝 其二","author":"李之仪","text":"雨闇烟昏蔚不开，时时白鸟去还来。\n相逢都是江湖上，莫为人声却自猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔宋镇立秋五绝 其三","author":"李之仪","text":"秋热春寒花不老，云浓日薄雨频收。\n共言今岁鱼偏熟，旧网须教展一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔宋镇立秋五绝 其四","author":"李之仪","text":"捞虾摸蚬几回来，斗笠蓑衣安在哉。\n将谓此生缘已断，登临不觉眼重开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李方叔宋镇立秋五绝 其五","author":"李之仪","text":"南北区区浪自催，不妨随遇且徘徊。\n鲈鱼白酒何须得，一醉端从好句来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初得马骑","author":"李之仪","text":"有两龙驹慰陆沈，四年河海每关心。\n今朝款段聊乘兴，矍铄犹堪寄好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题朱砂汤","author":"李之仪","text":"忆同德曜涉歊蒸，欲濯汤池竟辍行。\n憔悴独来琴瑟变，满怀谁识泪纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石蟹","author":"李之仪","text":"泉泓石蟹如乌头，一种为类太微生。\n此地逢君宜见假，才方入手便横行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵致君","author":"李之仪","text":"华清赐浴记当年，偶托荒山结胜缘。\n未必兴衰异今昔，曾经天女卸金钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得延之书书尾戏答","author":"李之仪","text":"齿豁童头老可憎，艰难相值历何曾。\n吹箫问渡愧未达，终有心头一点蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卞忠烈公墓","author":"李之仪","text":"丛篁灌木丽霜晴，忠孝岩岩父子名。\n举扇西风虽自洁，受遗不至亦何情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冶城","author":"李之仪","text":"冶城昔是王公宅，鹊噪乌啼异昔时。\n不见犊车催麈尾，莫年惆怅蔡家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿天禧因书壁间","author":"李之仪","text":"月堕风林夜已深，寒衾展转不能禁。\n一番过眼知何处，惟有孤灯识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正上人求书","author":"李之仪","text":"火灭窗晴冷似冰，随时活计自脩行。\n客来若问真消息，只有观音自證明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书吴江垂虹亭壁","author":"李之仪","text":"三十年惊一世人，衣巾空有泪痕深。\n他年不为鲈鱼脍，聊欲江干卜近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书张君书斋窗上次其韵","author":"李之仪","text":"眼力无穷面面窗，知君心不在西凉。\n聊将浮世两茧足，共借明朝一线长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵牡丹四绝 其一","author":"李之仪","text":"朝阳烁烁欲争流，已过群红盍自脩。\n发尽妖妍犹未歇，天机终待几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵牡丹四绝 其二","author":"李之仪","text":"云低雨细静无风，似著精神染异红。\n驻辇慈恩赏佳句，若论今日定谁工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵牡丹四绝 其三","author":"李之仪","text":"蓬莱宫阙有神仙，解释春风欲斗妍。\n不是殊狂曾迕物，肯将飞燕谓当前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵牡丹四绝 其四","author":"李之仪","text":"我老迂疏合灌园，强来乘障负初暄。\n多情似识伊川旧，宛是韩公第一根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其一","author":"李之仪","text":"阳关才断一声歌，已觉离愁万斛多。\n谁信邮亭槛车际，便惊风露隔关河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其二","author":"李之仪","text":"疏帘弄影不惊尘，百忆恒沙认此身。\n转盼回头已陈迹，那知犹作未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试陈瞻墨十绝 其三","author":"李之仪","text":"门无关锁何由出，案有诗书敢自期。\n寻到古人留意处，绝胜把酒听歌时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]