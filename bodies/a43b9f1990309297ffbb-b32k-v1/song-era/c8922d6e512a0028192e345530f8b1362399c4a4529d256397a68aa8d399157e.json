[{"title":"菩萨蛮 其二 政和丙申","author":"向子諲","text":"娟娟明月如霜白。\n鳌山可是蓬山隔。\n恨不及春风。\n行云处处同。\n暖香红雾里。\n一笑谁新喜。\n知得远愁无。\n春衫有泪珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 王景源使君生日坐上偶作","author":"向子諲","text":"满城腊雪净无埃。\n触处是花开。\n天上琼林珠树，谁知夜半移来。\n黄堂荐寿，请君著意，和气潜回。\n化作一江春酒，都将注入尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 奉酬曾端伯使君，兼简赵若虚监郡","author":"向子諲","text":"雁阵横空，江枫战、几番风雨。\n天有意、作新秋令，欲鏖残暑。\n篱菊岩花俱秀发，清氛不断来窗户。\n共欢然、一醉得黄香，仍叔度。\n尊前事，尘中去。\n拈花问，无人语。\n芗林顾灵照，笑抚庭树。\n试举似虎头城太守，想应会得玄玄处。\n老我来、懒更作渊明，闲情赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 政和癸巳滁阳作，其年京师大雪","author":"向子諲","text":"天宇长闲，飞仙狂醉，挼云碎玉沈空。\n谢家庭院，争道絮因风。\n不怕寒生宝粟，深调护、犀幕重重。\n瑶林里，疏梅献笑，小萼露轻红。\n瑞龙。\n香绕处，云间弦管，尘外帘栊。\n须烂醉流霞，莫诉千钟。\n闻道蟠桃正好，蓬瀛路、消息潜通。\n飞琼伴，偷将春色，分付入芳容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二 岩桂芗林改张元功所作","author":"向子諲","text":"瑟瑟金风，团团玉露，岩花秀发秋光。\n水边一笑，十里得清香。\n疑是蕊宫仙子，新妆就、娇额涂黄。\n霜天晚，妖红丽紫，回首总堪伤。\n中央。\n孕正色，更留明月，偏照何妨。\n便高如兰菊，也让芬芳。\n输与芗林居士，微吟罢、闲据胡床。\n须知道，天教尤物，相伴老江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一","author":"向子諲","text":"月窟蟠根，云岩分种，绝知不是尘凡。\n琉璃剪叶金粟缀花繁。\n黄菊周旋避舍，友兰蕙、羞杀山樊。\n清香远，秋风十里，鼻观已先参。\n酒阑。\n听我语，平生半是，江北江南。\n经行处、无穷绿水青山。\n常被此花相恼，思共老、结屋中间。\n不因尔，芗林底事，游戏到人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 其一 绍兴乙卯，大雪行鄱阳道中","author":"向子諲","text":"瑶田银海。\n浩色难为对。\n琪树照人间，晓然是、华严境界。\n万年松径，一带旧峰峦，深掩覆，密遮藏，三昧光无碍。\n金毛狮子，打就休惊怪。\n片片上红炉，且不可、将情作解。\n有无不道，泯绝去来今，明即暗，暗还明，只个长不昧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 其三 老妻生日作，十一月初七日","author":"向子諲","text":"一阳才动，万物生春意。\n试与问宫梅，到东阁、花枝第几。\n疏疏淡淡，冷艳雪中明，无俗调，有真香，正与人相倚。\n非烟非雾，瑞色门阑喜。\n再拜引杯长，看两颊、红潮欲起。\n天教难老，风鬓绿如云，对玉笥，与芗林，岁岁花前醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其四","author":"向子諲","text":"绮窗人似莺藏柳。\n巧语春心透。\n声声清切入人深。\n一夜不知两鬓、雪霜侵。\n何时月下歌金缕。\n醉看行云住。\n懒将幽恨寄瑶琴。\n却倩金笼鹦鹉、递芳音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其二","author":"向子諲","text":"去年不到琼花底。\n蝶梦空相倚。\n今年特地趁花来。\n却甚不教同醉、过花开。\n花知此恨年年有。\n也伴人春瘦。\n一枝和泪寄春风。\n应把旧愁新怨、入眉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其四 梅花盛开，走笔戏呈韩叔夏司谏","author":"向子諲","text":"江头苦被梅花恼。\n一夜霜须老。\n谁将冰玉比精神。\n除是凌风却月、见天真。\n情高意远仍多思。\n只有人相似。\n满城桃李不能春。\n独向雪花深处、露花身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其三","author":"向子諲","text":"澄江霁月清无对。\n鲁酒何须醉。\n人怜贫病不堪忧。\n谁识此心如月、正含秋。\n再三涝漉方知处。\n试向波心去。\n迢迢空劫勿能收。\n谩道从来天地、与同流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其一","author":"向子諲","text":"淮阳堂上曾相对。\n笑把姚黄醉。\n十年离乱有深忧。\n白发萧萧同见、渚江秋。\n履声细听知何处。\n欲上星辰去。\n清寒初溢暮云收。\n更看碧天如水、月如流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其二 明年过彭蠡，遇大风，行巨浪中。用前韵寄赵正之及洪州李相公，兼示开元栖隐二老","author":"向子諲","text":"银山堆里庐山对。\n舟子愁如醉。\n笑看五老了无忧。\n大觉胸中云梦、气横秋。\n若人到得归元处。\n空一齐销去。\n直须闻见泯然收。\n始知大江东注、不曾流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其三 宣和辛丑","author":"向子諲","text":"去年雪满长安树。\n望断扬州路。\n今年看雪在扬州。\n人在蓬莱深处、若为愁。\n而今不恨伊相误。\n自恨来何暮。\n平山堂下旧嬉游。\n只有舞春杨柳、似风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其一 政和丁酉下琵琶沟作","author":"向子諲","text":"濛濛烟树无重数。\n不碍相思路。\n晚云分外欲增愁。\n更那堪疏雨、送归舟。\n雨来还被风吹去。\n陨泪多如雨。\n拟题双叶问离忧。\n怎得水随人意、肯西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"向子諲","text":"飞云多态，凉飔微度，都到酒边歌处。\n冰肌玉骨照人寒，更做弄、一帘风雨。\n同盘风味，合欢情思，不管星娥猜妒。\n桃花溪水接银河，与占断、鹊桥归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"向子諲","text":"合卺风流，擘钗情态，压倒痴牛騃女。\n今年云外果深期，想却笑、人间离苦。\n萦愁叠恨，青山绿水，杳杳重重无数。\n寻常犹有梦能来，到此夜、无寻梦处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 七夕","author":"向子諲","text":"澄江如练，远山横翠，一段风烟如画。\n层楼杰阁倚晴空，疑便是、支矶石下。\n宝奁琼鉴，淡匀轻扫，纤手弄妆初罢。\n拟将心事问天公，与牛女、平分今夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殢人娇 钱卿席上赠侍人轻轻","author":"向子諲","text":"白似雪花，柔于柳絮。\n胡蝶儿、镇长一处。\n春风骀荡，蓦然吹去。\n得游丝、半空惹住。\n波上精神，掌中态度。\n分明是、彩云团做。\n当年飞燕，从今不数。\n只恐是、高唐梦中神女。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二 百花洲老桂盛开，张师明、程德远携酒来醉花下，有唱酬蝶恋花，亦次其韵","author":"向子諲","text":"岩桂秋风南埭路。\n墙外行人，十里香随步。\n此是芗林游戏处。\n谁知不向根尘住。\n今日对花非浪语。\n忆昨明光，早辱君王顾。\n生怕青蝇轻点污。\n思鲈何似思花去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一 和曾端伯使君，用李久善韵","author":"向子諲","text":"推上百花如锦绣。\n水满池塘，更作溅溅溜。\n断送风光惟有酒。\n苦吟不怕因诗瘦。\n寻壑经丘长是久。\n晚晚归来，稚子柴门候。\n万事付之醒梦后。\n眉头不为闲愁皱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 政和丙申九江道中","author":"向子諲","text":"霭霭朝云，矜春态度。\n楚宫梦断寻无路。\n欲将尊酒遣新愁，谁知引到愁深处。\n不尽长江，无边细雨。\n只疑都把愁来做。\n西山总不解遮栏，随春直过东湖去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"向子諲","text":"浅浅妆成淡淡梅。\n见梅忆着傍妆台。\n书无鸿雁如何寄，肠断催归作么回。\n千种恨，百般猜。\n为伊怀抱几时开。\n可堪江上风头恶，不放朝云入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其十一 绍兴戊辰岁闰中秋","author":"向子諲","text":"明月光中与客期。\n一年秋半两圆时。\n姮娥得意为长计，织女欢盟可恨迟。\n瞻玉兔，倒琼彝。\n追怀往事记新词。\n浩歌直入沧浪去，醉里归来凝不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 宣和己亥代人赠别","author":"向子諲","text":"斗帐欢盟不计年。\n谁知蓦地远如天。\n何曾一霎离心上，怎得而今在眼前。\n鱼不断，雁相连。\n可无小字寄芳笺。\n薄情已是抛人去，更与新愁到酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三 宣和己亥代人赠别","author":"向子諲","text":"说著分飞百种猜。\n泥人细数几时回。\n风流可惯曾孤冷，怀抱如何得好开。\n垂玉箸，下香阶。\n凭肩小语更兜鞋。\n再三莫遣归期误，第一频教入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其六 有怀京师上元，与韩叔夏司谏、王夏卿侍郎、曹仲谷少卿同赋","author":"向子諲","text":"紫禁烟花一万重。\n鳌山宫阙倚晴空。\n玉皇端拱彤云上，人物嬉游陆海中。\n星转斗，驾回龙。\n五侯池馆醉春风。\n而今白发三千丈，愁对寒灯数点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 绍兴壬戌中秋前数夕与杨谨仲，鲁子明，刘曼容及子驹兄弟待月新桥","author":"向子諲","text":"驾月新成碧玉梁。\n青天万里泻银潢。\n广寒宫里无双树，无热池边不尽香。\n承露液，酿秋光。\n直须一举累千觞。\n不知世路风波恶，何似芗林气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三 豫章郡王席上","author":"向子諲","text":"两个鸳鸯波上来。\n一緺杨柳掌中回。\n已愁共雪因风去，更着繁弦急管催。\n含浅笑，劝深杯。\n桃花气暖眼边开。\n司空常见风流惯，输与山翁醉玉摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其七 戏韩叔夏","author":"向子諲","text":"只有梅花似玉容。\n云窗月户几尊同。\n见来怨眼明秋水，欲去愁眉淡远峰。\n山万叠，水千重。\n一双蝴蝶梦能通。\n都将泪作黄梅雨，尽把情为柳絮风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四 绍兴己未归休后赋","author":"向子諲","text":"露下风前处处幽。\n官黄如染翠如流。\n谁将天上蟾宫树，散作人间水国秋。\n香郁郁，思悠悠。\n几年魂梦绕江头。\n今朝得到芗林醉，白发相看万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 寿太夫人","author":"向子諲","text":"戏彩堂深翠幕张。\n南飔特地作微凉。\n葵花向日枝枝似，萱草忘忧日日长。\n门有庆，福无疆。\n老人星与酒生光。\n殷勤更假天吴手，倾泻西江入寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其九 咏红梅","author":"向子諲","text":"江北江南雪未消。\n此花独步百花饶。\n青枝可爱难为杏，绿叶初无不是桃。\n多态度，足风标。\n蕊珠仙子醉红潮。\n绝怜竹外横斜处，似与芗林慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"向子諲","text":"几处秋千懒未收。\n花梢柳外出纤柔。\n霞衣轻举疑奔月，宝髻敧倾若坠楼。\n争缥缈，斗风流。\n蜂儿蛱蝶共嬉游。\n朝朝暮暮春风里，落尽梨花未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 与徐师川同过叶梦授家","author":"向子諲","text":"小院深明别有天。\n花能笑语柳能眠。\n雪肌得酒于中暖，莲步凌波分外妍。\n钗燕重，髻荷偏。\n两山斜叠翠连娟。\n朝云无限矜春态，暮雨情知更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 题芗林","author":"向子諲","text":"莫问清江与洛阳，山林总是一般香。\n两家地占西南胜，可是前人例姓杨。\n石作枕，醉为乡。\n藕花菱角满池塘。\n虽无中岛霓裳奏，独鹤随人意自长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 番禺齐安郡王席上赠故人","author":"向子諲","text":"召埭初逢两妙年。\n瑶林玉树倚风前。\n疏梅影里春同醉，红芰香中月一船。\n长怅恨，短因缘。\n空馀蝴蝶梦相连。\n谁知瘴雨蛮烟地，重上襄王玳瑁筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其八 老妻生日","author":"向子諲","text":"玉篆题名在九天。\n而今且作地行仙。\n挂冠神武归休后，同醉芗林是几年。\n龟游泳，鹤蹁跹。\n疏梅修竹两清妍。\n欲知福寿都多少，阁皂清江可比肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其十二 曾端伯使君自处守移帅荆南，作是词戏之","author":"向子諲","text":"赣上人人说故侯。\n从来文采更风流。\n题诗谩道三千首，别酒须拚一百筹。\n乘画鹢，衣轻裘。\n又将春色过荆州。\n合江绕岸垂杨柳，总学歌眉叶叶愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"向子諲","text":"康庐山水雄，三峡又争长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄成都蒋密学","author":"向传式","text":"钦闻宥密缀荣班，西顾分忧辍钜贤。\n乍领蜀都新印绶，应怀越国旧风烟。\n流觞雅趣人多羡，正俗佳名世永传。\n圣主倚毗閒未得，重来游赏是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渌波亭","author":"向传式","text":"我爱东南郡，恩容守会稽。\n府当秦望北，园枕卧龙西。\n水为流觞引，亭因正俗题。\n松篁清有韵，桃李密成蹊。\n一沼开方鉴，双桥亘采霓。\n晓波平漾漾，春草碧萋萋。\n城上兴崇构，林端露半梯。\n登疑青汉近，坐与白云齐。\n山色回头是，湖光照眼迷。\n笙歌随分有，樽斝逐欢携。\n月夜宜飞盖，花时醉似泥。\n蓬莱风景异，此地好长栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近","author":"向希尹","text":"晓帘栊，晴院宇，空鸭冷沉水。\n翠被欺寒，娇困未忺起。\n厌厌两点眉峰，一痕酒晕，正人在、温柔乡里。\n甚情味。\n羞对钗燕筝鸿，胭脂暗弹泪。\n欲写吴笺，无处问双鲤。\n倩他轻薄杨花，与愁结伴，直吹到，那人根底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"向希尹","text":"结客去登楼。\n谁系兰舟。\n半篙清涨雨初收。\n把酒留春春不住，柳暗江头。\n老去怕闲愁。\n莫莫休休。\n晚来风恶下帘钩。\n试问落花随水去，还解西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"向郎中","text":"惟洪一都会，控带荆与瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"向郎中","text":"湖边乔木幽人宅，楼外长江帝子洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"向郎中","text":"身在鸣銮帝子楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延安守岁","author":"向敏中","text":"律管风生消暮景，塞原烟静绝妖氛。\n坐移残烛光阴变，故旧年华一夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈知鄜州何士宗","author":"向敏中","text":"勋将钟鼓堪铭镂，业为皇王致太平。\n貔虎有威开玉帐，犬戎无战卧金钲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚行乐 其四","author":"白玉蟾","text":"落红庭院绿池塘，语燕啼莺亦可伤。\n霁柳吹花春已老，暝槐成幄日初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花","author":"向敏中","text":"千朵秾芳倚槛斜，一枝枝缀乱云霞。\n凭君莫厌临风看，占断春光是此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山飞来寺","author":"向敏中","text":"峡山胜地安禅处，万仞危桥压要津。\n世上岂知名利路，浪中空笑往来人。\n倚门怪石狂遮面，入座寒云碎绕身。\n日暮西风懒回首，满林幽鸟语声频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暮","author":"向敏中","text":"恨别春归酒满杯，残芳缭绕旧亭台。\n不甘淑景随风变，刚被炎光继日催。\n弱柳绿浓还易合，夭桃红尽更难开。\n明年复与君相约，重遣阳和早到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶吟遣怀","author":"向敏中","text":"昔为宰辅居黄阁，今作元戎控夏台。\n万里苍黔渐受赐，一方清晏有何才。\n紫宸杳杳弥年别，红旆翩翩映日开。\n将相官荣如我少，不须频献手中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游净居寺","author":"向敏中","text":"四面烟岚合，吟魂到便清。\n乱山供远翠，幽竹送寒声。\n磬韵听时歇，云根望处生。\n尘机闲摆落，潜得笑浮荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"向敏中","text":"岑楼高架郁嵯峨，几度凭栏发浩歌。\n春树鸟声当户巧，夕阳山色卷帘多。\n花凝玉勒含烟露，酒泛金樽醉绮罗。\n自是梁园知好客，不妨车马日相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄寇平仲","author":"向敏中","text":"九万鹏霄振翼时，与君同折月中枝。\n细思淳化持衡者，得到于今更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨鸠","author":"向雪湖","text":"曈昽晓日上帘旌，又听林鸠逐妇声。\n可笑天公无定向，只随汝辈作阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月四日约同寮劝耕万安院已而不至书于彭氏酒家壁","author":"向滈","text":"满目风光二月时，小桃无数柳依依。\n松间野寺临清浅，花底旗亭倚翠微。\n人意不随春意好，此心端与赏心违。\n目斜望断高阳侣，赢得惺惺骑马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莞尔堂春晚书怀呈同僚","author":"向滈","text":"三分春色二分休，是处红稀绿已稠。\n芳草池塘空有思，落花亭馆不胜愁。\n人情似昔犹难合，身世如今岂易谋。\n若欲忘忧须是酒，醉乡安稳胜封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]