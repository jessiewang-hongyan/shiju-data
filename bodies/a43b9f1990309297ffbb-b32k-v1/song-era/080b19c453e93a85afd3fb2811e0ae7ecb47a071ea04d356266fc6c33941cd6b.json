[{"title":"和晏相公府东三咏 其三 李相园","author":"韩维","text":"杨花点径残春后，草气薰池过雨初。\n行到松洲有遗兴，水声东下竹间渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邵学士留题府署东堂有不及花时之叹次韵 其一","author":"韩维","text":"翘材曾验太常车，壁上新留醉墨斜。\n一览雕章私自喜，远来犹得及残花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邵学士留题府署东堂有不及花时之叹次韵 其二","author":"韩维","text":"君逢烟叶才抽日，我值风葩欲谢辰。\n称意人生无十九，要须烂醉洛阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛城杂诗五首 其一","author":"韩维","text":"分从柳外扬鞭去，同作花前载酒行。\n题得新诗无处寄，杂英飞絮满春城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛城杂诗五首 其二","author":"韩维","text":"洗马涧边芳树密，阑干仍在碧流西。\n香檀乱拍朱弦急，应有游人醉欲迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛城杂诗五首 其三","author":"韩维","text":"上东门外春三月，桑叶阴阴覆菜花。\n密竹乱流行径绝，桔槔鸣处是人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛城杂诗五首 其四","author":"韩维","text":"无数长条乱晓风，谁将紫锦覆春丛。\n残英点落青苔面，独倚朱栏细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛城杂诗五首 其五","author":"韩维","text":"樱桃园裹鸣禽乱，獬豸池边积草多。\n七十年前繁盛地，曲溪深隧见张罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相游楚家园赋四题 其一 桂","author":"韩维","text":"叶裁青玉层层合，花结丹砂小小垂。\n不惜淹留赏残艳，抽毫愧乏楚人词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相游楚家园赋四题 其二 竹","author":"韩维","text":"繁根傍水生先合，翠色通门望更深。\n待得墙东春笋长，好来乘暑坐清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相游楚家园赋四题 其三 雁翅柏","author":"韩维","text":"叶翻清吹恐飞去，影照澄波欲下来。\n花有鹤翎惭近俗，松为麈尾可同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相游楚家园赋四题 其四 松","author":"韩维","text":"苍鳞上竦孤生干，翠鬣横抽欲偃枝。\n惟有公来赏修直，洛城人重看花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜酴醾","author":"韩维","text":"天意再三珍野艳，花中最后吐奇香。\n狂风莫埽残英尽，留与佳人贮绛囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗马涧","author":"韩维","text":"飘花拂柳巧萦回，回处朱阑压岸苔。\n安得扁舟系林下，共看清月入波来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相公游韩王水硙园三首 其一","author":"韩维","text":"怒水远从轮下散，平桥斜度竹间来。\n林深不识游人到，无限惊禽去却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相公游韩王水硙园三首 其二","author":"韩维","text":"行遍洛川南北岸，自怜探赏颇穷幽。\n不知物外清闲境，只在韩王水硙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪晏相公游韩王水硙园三首 其三","author":"韩维","text":"樱连翠叶方离树，酒泻银壶欲照人。\n不是谢公丘壑趣，岂容清醉倒冠巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晏相公小园静话","author":"韩维","text":"祓除名利开清论，柬汰文章到古风。\n日暮园林洒微雨，一樽犹对菊花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明寺西亭五绝句 其一","author":"韩维","text":"溪面惊禽鸣复翔，薜梢藤蔓罥衣裳。\n无端脩竹行不尽，何处野花时自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明寺西亭五绝句 其二","author":"韩维","text":"脩篁蔽日森苍壁，远麦迎风乱翠波。\n安得嵩云洒飞雨，更将清思助吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明寺西亭五绝句 其三","author":"韩维","text":"水杨柳絮风中乱，野蔷薇花波上明。\n春芳零落不照眼，对此聊复开予情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明寺西亭五绝句 其四","author":"韩维","text":"圆荷帖帖野池平，时有龟鱼傍岸行。\n春事寂寥初暑动，坐听流水竹间声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明寺西亭五绝句 其五","author":"韩维","text":"野鹤飞来水树春，丹砂作顶羽如银。\n似矜毛彩非凡偶，欲下清波犹顾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛府东池泛舟","author":"韩维","text":"风中林叶欣欣动，竹外波光剡剡来。\n日晚清樽催客醉，夜深红烛待船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出留守府之东游李相园赵令竹林观楚家桂树余去岁数从元献公为此行作三绝句以道悲怆之意 其一","author":"韩维","text":"府东朱户昔常开，日日从公选胜来。\n游履吟毫成故事，断松飞溜有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出留守府之东游李相园赵令竹林观楚家桂树余去岁数从元献公为此行作三绝句以道悲怆之意 其二","author":"韩维","text":"李家池上朱樱熟，赵令林中锦箨春。\n更欲题诗论旧赏，自惭非是绝弦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出留守府之东游李相园赵令竹林观楚家桂树余去岁数从元献公为此行作三绝句以道悲怆之意 其三","author":"韩维","text":"曾陪樽酒咏芳丛，今日迟留意不同。\n红萼似知人惨淡，乱随清泪落春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明叔惠洛中花走笔为谢","author":"韩维","text":"弱枝秾艳逐归轮，装出雕盘露色新。\n满酌酒卮聊自庆，一年齐见两邦春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省壁画山水","author":"韩维","text":"淡水疏峰举目间，独怜平远思多闲。\n烦君莫使埃尘污，绝笔如今不易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西城三绝句 其一 愁台","author":"韩维","text":"暖风和日著人来，细柳高榆抱径回。\n我为伤春足悲恨，不禁驱马上愁台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西城三绝句 其二 梁王城","author":"韩维","text":"大梁从古名都会，宫阙当年亦壮哉。\n人事无端几兴废，春风依旧入城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西城三绝句 其三 段干木庙","author":"韩维","text":"由来为国必贤才，偃息端能弭祸灾。\n千古风流谁嗣者，顾瞻遗庙独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和原甫安福院二绝 其一","author":"韩维","text":"平桥背郭红尘断，净宇临溪绿树深。\n何日君闲同命驾，凉风吹袖听莺吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和原甫安福院二绝 其二","author":"韩维","text":"久游京洛化尘衣，闻说林泉便解颐。\n能使波光入轩槛，为君携酒复题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆院池上五首 其一","author":"韩维","text":"细雨疏烟冒广池，危亭晨坐冷侵衣。\n秋风不作羁人便，波面萧萧柳叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆院池上五首 其二","author":"韩维","text":"蜻蜓漆墨蝶金黄，上下波间有底忙。\n不及柳阴双白鹭，终朝伴我立溪傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆院池上五首 其三","author":"韩维","text":"露蓼风蒲匝四阿，欠盘无数覆清波。\n丁宁舟子徐移棹，枉碎池中绿锦窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆院池上五首 其四","author":"韩维","text":"池边衰草化秋根，萤火多于五月蚊。\n看久惊风忽飘散，树头金烬落纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆院池上五首 其五","author":"韩维","text":"日日池头望绿波，秋声萧瑟欲翻荷。\n已惊寒露朝来重，零落红蕖水面多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答胜之过学舍相访","author":"韩维","text":"世事纷纷无已日，人生鼎鼎欲何如。\n不嫌官冷时相过，幸有明窗满架书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏相公西园雪后栽梅三首 其一","author":"韩维","text":"日晏金华劝讲回，幅巾藜杖小园来。\n知公洒落遗尘事，旋斸寒梅趁雪栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏相公西园雪后栽梅三首 其二","author":"韩维","text":"才看如粟吐花床，已想江南万里香。\n小缀柔枝得残雪，密催繁艳喜晴阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晏相公西园雪后栽梅三首 其三","author":"韩维","text":"寒芳准拟临风折，佳句安排对酒论。\n知想钱塘林处士，暗香浮动月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明叔昆仲特惠梅花聊赋小诗三篇为谢 其一","author":"韩维","text":"劲雪严风不易摧，琼苞犹冠百花开。\n洛阳去此无多地，不似迢迢驿使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明叔昆仲特惠梅花聊赋小诗三篇为谢 其二","author":"韩维","text":"玉斝久期繁艳至，筠笼先漏暗香来。\n歌童知我怜芳意，不向尊前唱落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明叔昆仲特惠梅花聊赋小诗三篇为谢 其三","author":"韩维","text":"朱萼琼华次第开，烦君自折向春台。\n遥知玉季承欢宴，唱尽新词釂巨杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀邻几","author":"韩维","text":"清醉由来未惬心，更携残酒傍花阴。\n共思潇洒江夫子，独拥枯桐事苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀景仁","author":"韩维","text":"电激波旋春已空，此间尊酒几时同。\n欲知对酒思君处，零落残花满架风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答次道马上见示","author":"韩维","text":"醉插花枝薄暮归，不知风雨过长堤。\n夫君信是高阳客，还有新诗马上题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同和叔早出天波门马上口号","author":"韩维","text":"去年连骑出天波，共爱晴旸景气和。\n又喜游从经岁月，西城宫树绿嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"众举毗卢作僧正以诗勉之","author":"韩维","text":"庵前谁为子磨塼，休把真心作静看。\n了得诸尘非异物，披毛带角也何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"联句","author":"韩维","text":"古木含清吹，池上增晚凉。\n余怀本达旷，联此傲羲皇。\n孤鸥可与狎，幽岸足以觞。\n幸有彭泽酒，便同永嘉堂。\n潘生起为寿，王子齐陈章。\n林端见新月，草际闻寒螀。\n照水萤影乱，拂筵蓼花香。\n徘徊恋嘉境，坐使归兴忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"韩维","text":"日华川上动，风光草际浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"倪天隐","text":"物外风尘不染颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双桧联句","author":"李邵","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双桧联句","author":"杨致祥","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双桧联句","author":"种古","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双桧联句","author":"种诊","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"崔子厚","text":"兴尽回兰棹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"徐融","text":"淮船分蚁点，江市聚蝇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走马引","author":"文同","text":"群蹄踏空山，半夜若风雨。\n平明即其地，已复天上去。\n惟予迫大义，盍免以名捕。\n蟠蜗入寒壳，此岂谓安处。\n脱身入浩渺，固有神物护。\n礼谓不戴天，天知天亦许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上众禽尽以俗呼为题 提葫芦","author":"文同","text":"花开已堪摘，酒熟正好沽。\n山禽会人意，劝我提葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临汉亭","author":"文同","text":"危亭俯绝岸，汉水望天表。\n遥源泻金穴，高浪灌朱鸟。\n纡馀转荆楚，万里合浩渺。\n谁知嶓冢下，悸然如带小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡斋水阁闲书 朱槿","author":"文同","text":"含露方矜杳袅，摇风旋见离披。\n湖上先生笑汝，朝开暮落何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡斋水阁闲书 偶书","author":"文同","text":"犊去食苗莫问，乌来攫肉休知。\n物须以信相感，事忌于心有为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周介之学士通判定州 其二","author":"文同","text":"河北扼虏要，定武承其咽。\n分道宿劲兵，望之为中权。\n朝廷倚注地，择用须材贤。\n黠猃詟所闻，射猎不敢边。\n兹焉势愈重，岂谓甲马然。\n将军庙堂老，御史蓬瀛仙。\n合谋运潜略，胜气压古燕。\n惟当陪缓带，壶觞铃阁前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月 其二","author":"文同","text":"望外物容澄似水，坐中秋力凛如刀。\n此身直愿乘双翼，飞上三峰第一高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"文同","text":"兴来雷出土，万箨起崖谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪丞相游石子涧 其二","author":"黄庶","text":"涧下禽鱼识上台，听泉履迹遍苍苔。\n岩边不欲踟蹰久，只恐商王梦远来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋闻角","author":"黄庶","text":"角本金鼓俦，独主昏晓色。\n日收云气黄，月斜霜露白。\n征夫朝夕闻，泪落甲铠黑。\n时平腐櫜鞬，白首眼不识。\n严城重启闭，不废角人职。\n老农鼓腹听，安识天子德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋小桐","author":"黄庶","text":"小桐才几尺，气压百岁樗。\n雨露意未饱，风月韵已孤。\n凤凰肯寂寞，燕雀空踟蹰。\n天地有和气，想为桐之腴。\n我愿刳作琴，献上九重居。\n坐使薰风还，虽死骨不枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋辘轳","author":"黄庶","text":"火云旱风苗欲死，曲木直绠寒泉深。\n耕夫泪湿原上土，老圃顾盼轻黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"曾巩","text":"兴亡两丘土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"曾巩","text":"割蚌珠的皪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"曾巩","text":"固知臭味非相类，其奈萦缠不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逐伯强文","author":"刘敞","text":"皇皇上天兮，浩浩后土。\n厥生孔繁兮，其施甚溥。\n陶陶仲夏兮，草木蕃庑。\n鸟兽孳息兮，我民乐胥。\n我民孔灵兮，上帝是仁。\n天子孔圣兮，百工日新。\n上无秕政兮，下无悖人。\n邻里其集兮，乐哉欣欣。\n伯强何为兮，孰畀以政。\n反世五福兮，持极以令。\n我民不怡兮，既丧其盛。\n白黑眩瞀兮，孰察其正。\n谓寿反天兮，谓康反病。\n仁义无益兮，苟且为幸。\n嗟尔子强兮，其独何心。\n绝世和气兮，俾民不任。\n上天孔神兮，大德曰生。\n天不可长罔兮，民不可久侵。\n天诛诚加兮靡所避，雷公驱兮风伯逝，嗟尔子强兮何所诣。\n南有蛮兮，为寇为逋。\n西羌戎兮，恃艰自虞。\n天子孔仁兮，靡焉毕屠。\n子强往兮，代天伐诛。\n嗟中国兮，不可久留。\n子不去兮，颠倒思予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]