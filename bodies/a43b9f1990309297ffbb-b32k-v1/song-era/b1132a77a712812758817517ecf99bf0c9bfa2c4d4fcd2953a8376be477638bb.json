[{"title":"蔡州叔父金部挽歌辞五首 其五","author":"晁补之","text":"并直仪曹前后厅，当檐种竹已青青。\n平生不试南宫笔，可忍图公地下铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡州叔父金部挽辞别二首 其一","author":"晁补之","text":"书来犹劝还乡早，路梗谁令去棹迟。\n曾缀锵金拜先垒，可堪扱衽送灵輀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡州叔父金部挽辞别二首 其二","author":"晁补之","text":"学比我公常恐后，身于馀子似蒙知。\n心惊并直仪曹夜，泪尽孤吟海浦时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞安门下母二首 其一","author":"晁补之","text":"瓜瓞传仙裔，鸤鸠媲积功。\n龙章看子贵，鹤发与夫同。\n褕翟丹青里，珠襦鼓吹中。\n秋原送车泪，斜日起西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞安门下母二首 其二","author":"晁补之","text":"城南塞冠盖，哀挽送何人。\n吉卜郊连浚，恩封国号秦。\n桓碑空复古，蒿里不知春。\n应夺居庐念，朝廷伫弼臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞三首 其一","author":"晁补之","text":"指李仙源后，兴唐帝胄馀。\n家传湖北句，人诵岭南书。\n知子唯宾客，扬名属起居。\n平生操史笔，遗事一欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞三首 其二","author":"晁补之","text":"相国家风独，夫人壸范如。\n宝珈宜服象，文锦合轩鱼。\n感慨温成议，光华庆寿馀。\n非夫闻敌退，应愧此生虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞三首 其三","author":"晁补之","text":"酷好春秋学，亲书列女篇。\n胡儿吟敢并，逸少字方传。\n馀事犹闺范，高材自世贤。\n凯风君莫诵，秋柏已成阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任承制挽辞刘校勘槩求作","author":"晁补之","text":"生业清谈外，浮名痛饮馀。\n谁令力如虎，坐使食无鱼。\n壁冷犹鸣剑，床空未卷书。\n呻吟待河润，秋柏只遗墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉答文潜戏赠","author":"晁补之","text":"倦游年少忆安巢，归梦尝惭断织刀。\n老去周颙虽有妇，黄经对几夜骚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"考校同文馆戏赠子方兼呈文潜","author":"晁补之","text":"二十年来曹子方，新诗曾见未能忘。\n多才善戏称物芳，吴娃席上呼作郎。\n瞥然何许岁月长，只今未老毛发苍。\n自言逢掖非昔狂，传经华阴夫子堂。\n何曾骑马身挟枪，诏随上将西击羌。\n董蒲跗注谓我臧，夜行马顿饥无粮。\n鼓鼙惊谷骑卷冈，吏呼为微醉在床。\n前锋奄至灵武傍，中坚反后无敢骧。\n城开三日牧蔽隍，百驰载笴千橐装。\n旌旗立垒乌鸟扬，还军不省一矢亡。\n坐师无获劳不偿，铙歌入奏虚锦囊。\n秋风鲈鱼思故乡，锐头宜董鹳鹅行。\n得官犹领万骕骦，王城对巷如参商。\n那知连月居兹房，称多量少非我王。\n群公古镜悬秋光，闭门饭饱庭叶黄。\n秋盘登兔官酎香，吴音讹变杂秦凉。\n令壶老柏笑覆觞，淹留平日梦欲翔。\n得君可乐殊未央，人生倾盖何所望。\n结交松柏要冰霜，中天号出玉玺章。\n青骢御史腾康庄，归期屈指未可忙。\n闻君况有梦虺祥，生女不恶嫁邻墙。\n扫轩留客具酒浆，与君更约城南张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复用方字韵奉赠同舍慎思文潜同年天启","author":"晁补之","text":"平生数子天一方，今夕何夕情难忘。\n荷衣揽蕙气芬芳，册府两公同舍郎。\n昆崙方轨万里长，西城却望天苍苍。\n秋庭风雨翻幕狂，夜语蔡侯同一堂。\n张侯老笔森矛枪，文词楚些遗蹇羌。\n胸中水镜谁否臧，学三百囷羞裹粮。\n思如决渎万仞岗，大编小轴山压床。\n城南买屋君舍旁，疲骖日附骥尾骧。\n我惭昧道由四隍，人如燕宋初束装。\n听君雄辩神扬扬，却思得一愁十亡。\n邓侯韫椟价不偿，有方未试聊贮囊。\n起家牛斗玉笥乡，鸿鶱早入鹓鹭行。\n和鸾采齐要骕骦，一铎便足谐宫商。\n知君云壑有松房，南阳耒耜心霸王。\n玉池复说夜有光，仙人藏丹金鼎黄。\n愿分神瀵浴骨香，非我其人惭德凉。\n蔡侯发迹江滥觞，闭笼祗欲擘海翔。\n此公事业未渠央，六奇他日吾所望。\n乌号张月刀瑩霜，裂五单于加印章。\n穰苴可但虚斩庄，遭时立志未可忘。\n白犊得瞽宁非祥，嗟予企踵不及墙。\n逢君如渴御蔗浆，怯虽如鼠犹胆张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾","author":"晁补之","text":"唤将梅蕊要同韵，羞杀梨花不解香。\n如何五月露寒殿，不与薰风送晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"晁补之","text":"短棹孤飞誇寥廓，洪涛高卧看星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"晁补之","text":"山色不违人，嵌满千家窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六十三首 其二十四","author":"释道宁","text":"三八念诵，五日一参。\n古佛标榜，今人可观。\n通方上士，不用颟顸。\n如石含玉，似地擎山。\n直下会得，也大无端。\n明暗一条今古路，依俙屈曲隔烟岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"僧某","text":"因山见水，见水忘山。\n山水俱忘，理归何所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以偈问清远禅师","author":"僧某","text":"劫火威音前，别是一壶天。\n御楼前射猎，不是刈荒田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"僧某","text":"一水吞空远，三峰峭壁危。\n猊台重拂拭，共喜主人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过清溪渡","author":"杨时","text":"天阔江衔雨，冥冥上客衣。\n潭清鱼可数，沙晚雁争飞。\n川谷留云气，鹈鹕傍钓矶。\n飘零沧海客，期到一帆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚心亭","author":"杨时","text":"山横鳌背碧巑岏，亭对浮筠缥缈间。\n萧散谁为三径侣，祇应长共白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送席二","author":"杨时","text":"抠衣丈席想多闻，高节应能与俗分。\n不用卑飞入幽谷，定知乔木在青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登岘首阻雨 其一","author":"杨时","text":"羊公风绩几经秋，独绕龟趺为少留。\n欲问荆人寻旧事，一江清泚自东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登岘首阻雨 其四","author":"杨时","text":"庭前古木已经秋，天外行云暝不收。\n倚杖却寻山下路，一川风雨湿征辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓 其一","author":"杨时","text":"云霭浮空半雨晴，茅檐未忍扫残英。\n欲寻春物飘零尽，只有黄鹂一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"薛绍彭","text":"一径入中渚，坐来惟鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释广","text":"日头东畔出，月向西边没。\n来去急如梭，催人成白骨。\n山僧有一法，堪为保命术。\n生死不相干，打破精魂窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临寂偈 其二","author":"释若愚","text":"室里千花罗网，梦中七宝莲池。\n踏得西归路稳，更无一点狐疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢举廉","text":"秋风鲙鲈丝，霜月持蟹螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怨曲二首 其一","author":"张耒","text":"白首南朝女，愁听异域歌。\n收兵颉利国，饮马胡卢河。\n毳布腥膻久，穹庐岁月多。\n雕窠城上宿，吹笛泪滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用刘梦得三题 其二","author":"张耒","text":"春已暮，把酒送春归。\n花落鸣禽散，草长游客稀。\n去年堂上燕，故故傍人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用刘梦得三题 其三","author":"张耒","text":"春竟去，白发感生平。\n流水去不断，夕阳犹有情。\n旧时桃李月，悄悄向人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食歌","author":"张耒","text":"东风芳草长，寒食春茫茫。\n人家掩门去，鸡犬自相将。\n原头簇簇柳与花，行人往来长叹嗟。\n旧坟新冢累累是，裂钱浇酒何人家。\n桑上鸣鸠唤山雨，雨脚萧萧山日暮。\n归来门巷正春寒，花底残红落无数。\n北里悲啼夜未休，清弦脆管起南楼。\n古今歌笑何时尽，芳草白杨春复秋。\n去年巧笑鞦韆女，今年嫁作东家妇。\n綵绳画柱似当年，只有朱颜不如故。\n百人学仙无一成，麻姑不见但闻名。\n万斛春醪须痛饮，江边渔父笑人醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日杂兴四首 其一","author":"张耒","text":"桃李用事辰，鲜明夺云绮。\n繁华一朝去，默默惭杞梓。\n时徂鹰化鸠，地迁橘为枳。\n独有羡门生，后天犹不死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日杂兴四首 其二","author":"张耒","text":"昔我游京室，交通五陵间。\n主客各英妙，袍马相追攀。\n千金具饮啜，百金顾吹弹。\n缨弁罗广席，当头舞交竿。\n鲜妆耀渌酒，锦缬生风澜。\n灯烛暗夜艾，士女纷相班。\n欢娱易徂歇，转盼如飞翰。\n亹亹负孤愿，离离衔永叹。\n山鸟窥茗饮，檐花笑蔬餐。\n弃捐勿重陈，事定须盖棺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日杂兴四首 其四","author":"张耒","text":"潭潭故邑井，猗猗上宫兰。\n不食自清渫，莫服更幽闲。\n志士耻穷极，卷迹甘饥寒。\n佳辰邈良觌，触物悬悲端。\n入途眇回远，经岁旷音翰。\n岂不慕裘马，诡得非所安。\n蝉冕多怵迫，绳枢鲜忧患。\n枉寻竟何补，方枘诚独难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其二","author":"张耒","text":"出门惮应接，俗士不多情。\n对酒辄拜辞，好礼以求名。\n嗟嗟名几何，曷足善尔生。\n共处一泡中，倏忽风涛惊。\n好饮信无补，不饮亦何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其三","author":"张耒","text":"我久喜文词，思与鸿鹄飞。\n老来觉非是，念昔正可悲。\n买金铸杜康，百拜誓归依。\n晋陶与康伯，九原吾与归。\n涉世苦不谙，多病身早衰。\n惟有尊中酒，不与我心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其四","author":"张耒","text":"处乐非纵情，处静非避喧。\n豪夸与枯槁，彼各据一偏。\n悠然独乐处，在我不在山。\n羲皇迹已远，三酌呼可还。\n一樽每独睡，不待宾客言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其五","author":"张耒","text":"所嗜人不得，一物百非是。\n犹有尊中酒，道胜无敢毁。\n彼哉讥谤者，诳口而信耳。\n当忧十八隔，罚此缪语绮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其六","author":"张耒","text":"自庇无一椽，道人分半宅。\n屋西罗古殡，寒草无人迹。\n累累长与少，岂复待年百。\n鸦飞朝树疏，虫吊宵月白。\n平生或不饮，至此方知惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其七","author":"张耒","text":"曹参汉贤相，掾吏亦豪英。\n四海付醇酒，乃真知物情。\n亡秦馀毒烈，一洗百壶倾。\n和气薰醉人，金革乃不鸣。\n卑卑谈治道，陋矣洛阳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其八","author":"张耒","text":"种树东檐下，雨来发幽姿。\n微阳动九地，光彩变新枝。\n荣衰一以异，枯槁易神奇。\n消息天使然，人工徒尔为。\n杜门沽酒饮，高悬吾马羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其九","author":"张耒","text":"里有好事者，我往樽辄开。\n我亦为之尽，每往亦开怀。\n尚虑数见厌，动作旬月乖。\n今晨起苦晚，独坐见乌栖。\n冬温雪作雨，里巷苦多泥。\n且复闭门坐，开卷理多谐。\n谁知无言中，独往不自迷。\n得意复终日，弭车不复回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十","author":"张耒","text":"弱岁慕世名，中年颇探道。\n世间无非苦，病死与生老。\n相寻无穷已，递代作荣槁。\n奇哉竺乾书，百遍读愈好。\n污泥虽云浊，本不害吾宝。\n酒虽破净律，吾事在律表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十一","author":"张耒","text":"昔尝罹厄疾，一卧辄踰时。\n念无所归咎，乃誓与酒辞。\n那知偶不死，持杯复饮兹。\n既饮辄为尽，快哉复何疑。\n神畅病自失，此说信不欺。\n药石伤天和，此方吾笑之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十二","author":"张耒","text":"世间有醉乡，百世本一境。\n欲游不待驾，但畏足疾醒。\n其乡无限界，亦不阻岩岭。\n阴阳无疾疠，风俗尽箕颍。\n君往余请从，无待宵烛炳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十三","author":"张耒","text":"酒尽辄起沽，耽然待酒至。\n呼儿挈樽杓，未酌兀已醉。\n譬如念醯醢，流液不待味。\n醉客失揖让，醉语少伦次。\n坐客皆摇头，知稀故我贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十四","author":"张耒","text":"儿童居宛丘，里巷昔所经。\n重来三十年，落魄竟何成。\n扣门问长老，主人多已更。\n萧萧城南道，松柏共坟庭。\n念此久兴叹，游不待鸡鸣。\n悠然且饮酒，聊以慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十五","author":"张耒","text":"岁晏霰雪集，客庭号北风。\n老人不复出，兀睡小斋中。\n忽然身且老，惜此岁时穷。\n一弛不再张，吾身如挂弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十六","author":"张耒","text":"渊明酒不足，种秫犹可得。\n无秫酒须求，时人嘲我惑。\n宁当且醉酣，慎勿疑通塞。\n但憎独醒人，岂有禁酒国。\n酩酊忘对言，满引常默默。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十七","author":"张耒","text":"乐天好饮者，少亦登贵仕。\n八年浔阳谪，学道乃忘己。\n与时虽寡怨，行己终有耻。\n抗言立朝廷，放志傲闾里。\n优游祸福间，出处皆可纪。\n乘流与偕逝，遇坎辄复止。\n酣歌尽百年，天理端可恃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十八","author":"张耒","text":"吾知李太白，潇洒本天真。\n一饮三百杯，不问漓与醇。\n子云亦好饮，白发事亡新。\n奇穷易投阁，区区赋剧秦。\n两贤竟谁乐，千载同埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渊明饮酒诗 其十九","author":"张耒","text":"平生自百懒，而独于酒勤。\n生事万缘疏，而独于酒亲。\n皇皇东家丘，隐者笑知津。\n我欲去即去，柴车不劳巾。\n但饮百年中，不愧饮酒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涟水","author":"张耒","text":"孤舟逆水上，野静闻水声。\n鸥飞不远水，寒浪溅霜翎。\n夜气岸兼木，夕光潭照星。\n长吟弄双桨，知有睡龙惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜","author":"张耒","text":"山静寒云薄，天空孤月明。\n霜桐占阶影，风叶绕廊声。\n经济心难就，蹉跎岁屡更。\n冥鸿本清远，何事亦宵征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月三日舟行自蔡河赴临淮","author":"张耒","text":"旷野天垂地，川晴水见沙。\n河回迷向背，岸断忽桑麻。\n水阔时浮鹭，陂寒乍集鸦。\n年饥田濩落，岁晚客悲嗟。\n新月排云水，西风送日斜。\n孤舟何处宿，故国已天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暇日六咏 其三 百舌","author":"张耒","text":"晓语月斜树，昼啼春霁天。\n胸中自有激，不是故多言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书寺中所见四首 其三","author":"张耒","text":"叩户谁惊午睡，烹茶听客论诗。\n病里虽成禁酒，兴发何妨杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题","author":"张耒","text":"屋角纤纤挂断虹，清蝉一噪起高桐。\n天涯云尽见残日，林下雨馀来好风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟行六绝 其六","author":"张耒","text":"渡头烟雨欲昏天，湾畔枯桑系客船。\n风打篷窗秋浪急，一杯寒酒夜深眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书颍州皇甫秘教书室","author":"张耒","text":"閒来便是日侵阶，窗下棋枰林下杯。\n晓解扁舟又南去，百年还得几回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"写情二首 其二","author":"张耒","text":"人閒漏永报春晖，日过檐牙梦未回。\n隔夜雨飘梅蕊尽，入帘风捲柳花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春","author":"张耒","text":"苔封池面草芊绵，鸣蚓跳蛙意若便。\n颇觉风云有奇变，翻盆一雨便潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"微云","author":"张耒","text":"微云霮䨴弄馀春，清晓微寒尚著人。\n重理裌衣温卯酒，绿阴啼鸟闭衡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗呈同院诸公 其二","author":"张耒","text":"邓子诗成癖，全分李杜光。\n楚风还屈宋，宫体变齐梁。\n蔡子辨焦尾，晁公怀智囊。\n三贤方鼎峙，安敢用吾长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]