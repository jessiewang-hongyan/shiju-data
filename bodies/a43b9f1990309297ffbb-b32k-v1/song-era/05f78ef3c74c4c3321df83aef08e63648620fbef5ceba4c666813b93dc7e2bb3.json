[{"title":"耶律侍郎","author":"范成大","text":"乍见华书眼似獐，低头惭愧紫荷囊。\n人间无事无奇对，伏猎今成两侍郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"育王方丈","author":"范成大","text":"窗纸悲嘶万壑风，石梁飞涧倒枯松。\n殷勤昨夜三更雨，添作投渊雪色龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"育王望海亭","author":"范成大","text":"海云晻霭日茏葱，案指光中万象空。\n想见蓬莱西望眼，也应知我立长风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范氏庄园","author":"范成大","text":"夕阳尘土涨郊墟，六六峰头梦觉馀。\n竹色唤人来下马，乱蝉深处有图书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范阳驿","author":"范成大","text":"邮亭偪仄但宜冬，恰似披裘坐土空。\n枕上惊回丹阙梦，屋头白塔满铃风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘六绝句 其二 千人坐","author":"范成大","text":"听经人散藓花深，千古谁能更赏音。\n只好岸巾披鹤氅，风清月白坐弹琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘六绝句 其六 方丈南窗","author":"范成大","text":"鼓板钟鱼彻晓喧，谁云方外事萧然。\n窗间日暮寒烟重，未到斋时我正眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘六绝句 其三 白莲池","author":"范成大","text":"碧泓白石偃樛枝，爱水嫌风老更低。\n潭影中间龙影卧，一山好处没人题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘六绝句 其四 剑池","author":"范成大","text":"石罅泓渟剑气潜，谁将楼阁苦庄严。\n只知煖热游人眼，不道苍藤翠木嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘六绝句 其一 点头石","author":"范成大","text":"当年挥麈讲何经，赚得坚顽侧耳听。\n我自吟诗无法说，石头莫作定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘六绝句 其五 致爽阁","author":"范成大","text":"碧嶂横陈似断鳌，画阑相对两雄豪。\n东轩只有云千顷，不似西山爽气高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘新复古石井泉太守沈虞卿舍人劝农过之为赋三绝谨次韵 其三","author":"范成大","text":"传闻公作新亭好，先报侬家拄杖知。\n便拟挈瓶来煮茗，绕阑干角遍寻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘新复古石井泉太守沈虞卿舍人劝农过之为赋三绝谨次韵 其一","author":"范成大","text":"劝耕堂上醉高年，和气春风共蔼然。\n大士亦修随喜供，夜来古井跃新泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘新复古石井泉太守沈虞卿舍人劝农过之为赋三绝谨次韵 其二","author":"范成大","text":"落纸云烟堕翠峦，一泓潭月斗清寒。\n凤凰池上挥毫手，却掬山泉淬笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎溪","author":"范成大","text":"水本无心作浪波，经行偶与石相磨。\n不须更问桥安否，唤取于菟载我过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊外阅骁骑剪柳","author":"范成大","text":"千骑同瞻白羽挥，惊尘一鬨响金鞿。\n不知掣电弯弓过，但觉柳梢随箭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲三首 其一","author":"范成大","text":"溪头风迅怯单衣，两桨凌波去似飞。\n折得蘋花双叶子，绿鬟撩乱带香归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲三首 其二","author":"范成大","text":"藕花深处好徘徊，不奈华筵苦见催。\n记取南泾茭叶露，明明风熟更重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲三首 其三","author":"范成大","text":"柔橹无声坐钓鱼，浪花飞点翠罗裾。\n空江日暮无来客，肠断三湘一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金氏庵","author":"范成大","text":"醉墨题窗侧暮鸦，蔓藤缘壁走青蛇。\n春深有燕捎飞蝶，日暮无人扫落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金水河","author":"范成大","text":"菜市桥西一水环，宫墙依旧俯清湾。\n谁怜磊磊河中石，曾上君王万岁山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金沙","author":"范成大","text":"庄严福地守灵仙，不为人閒计子钱。\n一掬斓斑光照眼，路傍馋隶枉流涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"范成大","text":"久矣心空客路埃，兹行端为主恩来。\n杜陵诗是吾诗句，卧病岂登江上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"范成大","text":"山林朝市两尘埃，邂逅人生有往来。\n各向此心安处住，钓台无意压云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨再作政妨海棠","author":"范成大","text":"漂红湿紫满莓苔，泼墨浓云尚送雷。\n风雨岂无他日再，何须随却海棠来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后东郭排岸司申梅开方及三分戏书小绝令一面开燕","author":"范成大","text":"雨入南枝玉蕊皴，合江云冷冻芳尘。\n司花好事相邀勒，不著笙歌不肯春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨凉二首呈宗伟 其一","author":"范成大","text":"谁扶病客起龙钟，恩在盆倾一雨中。\n问讯九关何路到，拟笺欢喜谢天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨凉二首呈宗伟 其二","author":"范成大","text":"惊雷隐地送凉飔，起舞看山不自持。\n说与骚人须早计，片云催雨雨催诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临平道中","author":"范成大","text":"烟雨桃花夹岸栽，低低浑欲傍船来。\n石湖有此红千叶，前日春寒总未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临洺镇","author":"范成大","text":"竟日霜寒暮解围，融融桑柘染斜晖。\n北人争劝临洺酒，云有棚头得兔归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南塘冬夜倡和","author":"范成大","text":"燃萁烘煖夜窗幽，时有新诗趣倡酬。\n为问灞桥风雪里，何如田舍火炉头。\n寒釭欲暗吟方苦，冻笔难驱字更遒。\n绝笑儿痴生活淡，略无岁晚稻粱谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用韵记昨日坐中剧谈及赵家琵琶之妙呈王正之提刑二绝 其一","author":"范成大","text":"病来六结总龟藏，不用浓薰戒定香。\n花下酒边非我事，但馀消瘦是东阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用韵记昨日坐中剧谈及赵家琵琶之妙呈王正之提刑二绝 其二","author":"范成大","text":"曹穆新声和者稀，如今妙手属天支。\n转关濩索都传得，想见飞凰舞绿丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客舍","author":"范成大","text":"毂击肩摩锦绣堆，朝声汹汹暮声催。\n忽然忆起长桥路，天镜无边白鸟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣化道中","author":"范成大","text":"瘦草萧疏已似秋，盘陀山骨束江流。\n两崖若不顽如铁，争得狂澜拍岸休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣德楼","author":"范成大","text":"峣阙丛霄旧玉京，御床忽有犬羊鸣。\n他年若作清宫使，不挽天河洗不清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将赴建康出城","author":"范成大","text":"牒诉缤纷塞瓮天，经年痴坐两三椽。\n出门纳纳乾坤大，依旧青山绕画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扁鹊墓","author":"范成大","text":"活人绝技古今无，名下从教世俗趋。\n坟土尚堪充药饵，莫嗔医者例多卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"施进之追路出严关且写予真戏题其上","author":"范成大","text":"唤渡牂牁瘴水滨，严关关外又逢春。\n神仙富贵俱何在，且作全家出岭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日三首 其三","author":"范成大","text":"双鲤无书直万金，画桥新绿一篙深。\n青蘋白芷皆愁思，不独江枫动客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日三首 其二","author":"范成大","text":"西窗一雨又斜晖，睡起薰笼换夹衣。\n莫放珠帘遮洞户，从教燕子作双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日三首 其一","author":"范成大","text":"药栏花暖小猧眠，雪白晴云水碧天。\n煮酒青梅寒食过，夕阳庭院锁鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春困二绝 其二","author":"范成大","text":"诺惺庵里呼春困，特地回头著耳听。\n若解昏昏安稳睡，主翁方始是惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春困二绝 其一","author":"范成大","text":"綵花生菜又新年，节物人情已可怜。\n不待春来呼我困，四时何日不堪眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春怀","author":"范成大","text":"柳颦梅笑各相恼，诗债棋雠俱见寻。\n莫道幽居无一事，春来风物总关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春来风雨无一日好晴因赋瓶花二绝 其二","author":"范成大","text":"酒冷花寒无好怀，柴荆终日为谁开。\n三分春色三分雨，疋似东风本不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春来风雨无一日好晴因赋瓶花二绝 其一","author":"范成大","text":"满插瓶花罢出游，莫将攀折为花愁。\n不知烛照香薰看，何似风吹雨打休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚三首 其二","author":"范成大","text":"客去钩窗咏小诗，游丝撩乱柳花稀。\n微风尽日吹芳草，蝴蝶双双贴地飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚三首 其三","author":"范成大","text":"夕阳槐影上帘钩，一枕清风梦昔游。\n梦见钱塘春尽处，碧桃花谢水西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚三首 其一","author":"范成大","text":"阴阴垂柳闭朱门，一曲阑干一断魂。\n手把青梅春已去，满城风雨怕黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚初出西楼","author":"范成大","text":"试倚枯藤似籋云，堂阶微步小逡巡。\n忽逢岩桂新抽叶，屈指黄紬睡一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚即事","author":"范成大","text":"屋头清樾暗荆扉，紫葚斓斑翠荚肥。\n春晚轩窗人独困，日长篱落燕双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚偶题","author":"范成大","text":"寂寥春事冷于秋，雨打风吹断送休。\n点检梨花成一梦，蘸红新绿满枝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昱岭","author":"范成大","text":"竹舆摇兀走婆娑，石滑泥融侧足过。\n昱岭不高人已困，晚登新岭奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柏乡","author":"范成大","text":"贯生名压汉公卿，自古逢雠不反兵。\n仇虏滔天无敢动，柏乡空溷迫人名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柏林院","author":"范成大","text":"胡来胡现劫灰深，风鼓三灾海印沈。\n急过当年无佛处，庭前空有柏森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳公亭","author":"范成大","text":"主人敬客有馀情，催唤绳床坐柳亭。\n曲水流觞非故物，马鞍山色旧青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉亭","author":"范成大","text":"收拾风烟锁翠微，乱山穷处结岩扉。\n青天不尽鸟飞尽，吴楚川原似衲衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相州","author":"范成大","text":"秃巾髽髻老扶车，茹痛含辛说乱华。\n赖有乡人聊刷耻，魏公元是鲁东家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相国寺","author":"范成大","text":"倾檐缺吻护奎文，金碧浮图暗古尘。\n闻说今朝恰开寺，羊裘狼帽趁时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日二绝 其一","author":"范成大","text":"碧芦青柳不宜霜，染作沧洲一带黄。\n莫把江山誇北客，冷云寒水更荒凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日二绝 其二","author":"范成大","text":"新秋病骨顿成衰，不度溪桥半月来。\n无事闭门非左计，饶渠屐齿上青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 冬日十二绝 其四十九","author":"范成大","text":"斜日低山片月高，睡馀行药绕江郊。\n霜风扫尽千林叶，閒倚筇枝数鹳巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十三","author":"范成大","text":"乾高寅缺筑牛宫，卮酒豚蹄酹土公。\n牯牸无瘟犊儿长，明年添种越城东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十","author":"范成大","text":"炙背檐前日似烘，煖醺醺后困蒙蒙。\n过门走马何官职，侧帽笼鞭战北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十七","author":"范成大","text":"煮酒春前腊后蒸，一年长飨瓮头清。\n廛居何似山居乐，秫米新来禁入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十五","author":"范成大","text":"拨雪挑来踏地菘，味如蜜藕更肥醲。\n朱门肉食无风味，只作寻常菜把供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十四","author":"范成大","text":"放船閒看雪山晴，风定奇寒晚更凝。\n坐听一篙珠玉碎，不知湖面已成冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十二","author":"范成大","text":"松节然膏当烛笼，凝烟如墨暗房栊。\n晚来拭净南窗纸，便觉斜阳一倍红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十九","author":"范成大","text":"探梅公子款柴门，枝北枝南总未春。\n忽见小桃红似锦，却疑侬是武陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十一","author":"范成大","text":"屋上添高一把茅，密泥房壁似僧寮。\n从教屋外阴风吼，卧听篱头响玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其六十","author":"范成大","text":"村巷冬年见俗情，邻翁讲礼拜柴荆。\n长衫布缕如霜雪，云是家机自织成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十六","author":"范成大","text":"榾柮无烟雪夜长，地炉煨酒煖如汤。\n莫嗔老妇无盘饤，笑指灰中芋栗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其五十八","author":"范成大","text":"黄纸蠲租白纸催，皂衣旁午下乡来。\n长官头脑冬烘甚，乞汝青钱买酒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋前三日大雨","author":"范成大","text":"暑残堪喜亦堪憎，恰似沙场喋血兵。\n纵有背城馀烬在，能禁几度泻檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种竹了题爱山亭","author":"范成大","text":"洒扫宣华舍此君，烟中月下绿生尘。\n他年叶叶清风满，莫忘今年借宅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"科桑","author":"范成大","text":"斧斤留得万枯株，独速槎牙立暝途。\n饱尽春蚕收罢茧，更殚馀力付樵苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秭归郡圃绝句二首 其二","author":"范成大","text":"孤城偪仄复偪仄，前山后山青欲来。\n市声萧条衙鼓静，惟有叱滩喧万雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]