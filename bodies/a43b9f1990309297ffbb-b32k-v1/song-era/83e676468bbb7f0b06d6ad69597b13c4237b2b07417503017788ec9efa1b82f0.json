[{"title":"蔚斋","author":"周紫芝","text":"山云未成雨，敛藏方寸间。\n会当不崇朝，一雨膏人寰。\n人言隐雾豹，依约在南山。\n试从管中窥，何止见一斑。\n人生患无才，富贵天岂悭。\n二士伟人物，万里来间关。\n行陈治安策，遂拜咫尺颜。\n岂容十里湖，长吟对烟鬟。\n愿君如鸾鹄，摩霄共追攀。\n云出豹亦变，何止铜与纶。\n举首望长途，分当落榛菅。\n鹏飞君方高，鸟倦我亦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵庭藻读少陵集 其一","author":"周紫芝","text":"李杜文章万丈高，就中诗律少陵豪。\n风流自是渠家事，奴仆从来可命骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵庭藻读少陵集 其二","author":"周紫芝","text":"濯锦江头可一杯，碧鸡坊口草堂开。\n十年剑外无相识，黄四娘家几度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵庭藻读少陵集 其三","author":"周紫芝","text":"玉烛初调大历年，先生偶脱万兵前。\n谁教早献千金赋，可得看囊更有钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡馀赋东墙雪竹","author":"周紫芝","text":"饱食枕方便，过午茶未杵。\n拨火理残香，倚窗翻故楮。\n寻我东墙隅，枝筇散腰膂。\n朔风寒萧萧，修竹静楚楚。\n枝头雪犹在，秀色乃如许。\n竹固不受寒，岂但不受暑。\n老翁日日来，相期伴君语。\n谁能与俗人，昵昵作儿女。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章彦漙决狱五羊归登郁孤台得东坡石刻见遗报以小诗","author":"周紫芝","text":"一见苍碑眼自开，便疑身在郁孤台。\n可怜决狱章廷尉，不带将军薏苡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四圣观后山亭","author":"周紫芝","text":"附山结真祠，朱门照湖水。\n湖流中入池，秀色归净几。\n风帘邃旌幢，神卫森剑履。\n清芬宿华殿，瑞雾蒙玉扆。\n仿佛还神京，想像轮奂美。\n祈年开新宫，祝釐奉天子。\n良辰复难会，岁暮得斯喜。\n况乃清樾中，飞楼见千里。\n云车倘可乘，吾事良已矣。\n当赋远游篇，未可回屐齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太一宫成奏告礼毕秦枢密有诗示秘阁次韵一首三绝 其一","author":"周紫芝","text":"圣主均休锡庶民，亲祠遥望属车尘。\n云旗欲下精诚格，绛阙初成制作新。\n肃肃衣冠严祀事，雍雍箫鼓降明神。\n椒浆一酌能多少，散作人间万国春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太一宫成奏告礼毕秦枢密有诗示秘阁次韵一首三绝 其二","author":"周紫芝","text":"汉家何事筑通天，漫费当年九府钱。\n跻世本期开寿域，祝釐端合报长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太一宫成奏告礼毕秦枢密有诗示秘阁次韵一首三绝 其三","author":"周紫芝","text":"玉帛新祠太一神，庙堂生育转洪钧。\n侍臣俱从甘泉驾，万世何人继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太一宫成奏告礼毕秦枢密有诗示秘阁次韵一首三绝 其四","author":"周紫芝","text":"至治非关黍稷香，可须巫觋降殊祥。\n公今重草周公颂，不和东皇第一章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯远梅花","author":"周紫芝","text":"徐侯顿朱墨，岂复知花时。\n美人忽含笑，临镜窥涟漪。\n朝来摩两眼，喜作云雾披。\n须烦春草句，咏此玉雪枝。\n小窗惜无人，共赏林下姿。\n毛褚二三子，亦足相遨嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春三绝句 其一","author":"周紫芝","text":"暖风融雪晴方好，春意催年老自悲。\n故国未归空有梦，梅花欲动又题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春三绝句 其二","author":"周紫芝","text":"地下青风欲到时，土牛何得解先知。\n墙边雪里梅花树，已借清香入旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春三绝句 其三","author":"周紫芝","text":"多病谁怜泽国人，眼明羞见綵幡新。\n满倾吴地千钟酒，细说长安六度春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋立春效王建三绝 其一","author":"周紫芝","text":"苍龙阙角晓光明，日近彤庭瑞雾温。\n殿下百官犹未入，阁门催引谢春幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋立春效王建三绝 其二","author":"周紫芝","text":"御沟冰暖欲生涡，律管灰飞气自和。\n已进玉堂春帖子，六宫无事笑声多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋立春效王建三绝 其三","author":"周紫芝","text":"圣明天子见升平，二纪颁春下禁庭。\n今岁御前争进表，明年七十贺慈宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七闽山中竹皆有实多至万斛民赖以食岁且不饥作乐府短歌以纪异事将以俟采诗者择焉盖诗人之职也","author":"周紫芝","text":"七闽山中地不足，往往连山暗脩竹。\n今年是处生竹花，竹米登囷日千斛。\n大家炊饭饷田夫，小家作糜饥饫腹。\n官虽赋田无上地，民不扶犁得中熟。\n福唐太守不敢藏，青版成囊献黄屋。\n黔黎鼓腹慰天心，宣付汗青书日录。\n山中父老雪满头，何曾眼见天雨粟。\n漫将葆旅属珠星，谁问庙堂调玉烛。\n人言丹凤餐竹实，玉粒先来自山谷。\n会见双飞入建章，万年枝并看鸾宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉和黄文若赠刁文叔","author":"周紫芝","text":"昔日风流守，流传父老知。\n诸孙今若此，天意了无疑。\n醉里开愁眼，灯前得近诗。\n闻名真已久，识面更何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵文若赠黄叔鱼","author":"周紫芝","text":"倦客愁如许，他乡岁屡更。\n衰颜人共笑，遗恨老难平。\n我欲随归梦，君谁共月明。\n嗣宗贤叔侄，况有各才名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓枕不寐书所感三首 其一","author":"周紫芝","text":"昔年残梦晓初回，花上啼禽近小斋。\n可笑只今春梦里，五更攲枕听笼街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓枕不寐书所感三首 其二","author":"周紫芝","text":"南市津头忆买船，花姑溪上钓晴烟。\n老来安得孤篷夜，横枕蓑衣听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓枕不寐书所感三首 其三","author":"周紫芝","text":"白发心知万事休，力耕犹欲种春畴。\n五更卧听鸡催晓，残月开门起饭牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚霁欲归三绝 其一","author":"周紫芝","text":"雨后儿童喜欲颠，老翁不出自欣然。\n晴天霁色浑无用，只乞斜阳了断编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚霁欲归三绝 其二","author":"周紫芝","text":"花树窗前睡足时，斜阳忽到雨边枝。\n白头可笑闲居士，又写春晴入小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚霁欲归三绝 其三","author":"周紫芝","text":"印颗初封马在庭，杖藜犹傍竹边行。\n老兵莫漫催人去，且听幽禽说晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分双鱼笺赠徐伯远","author":"周紫芝","text":"水底双鱼不上钩，粉金翻样滑如流。\n我无三昧诗中手，乞与君脩五凤楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵戴文举陈季陵见索故稿","author":"周紫芝","text":"短兵无力可交绥，强敌当前敢出奇。\n况我龙钟临老日，值君三五少年时。\n拟将冲雪骑驴句，换取看花走马诗。\n病思谁能更搜索，但拳双臂作支颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送文若归嘉禾二首 其一","author":"周紫芝","text":"乌帽犹冲九陌尘，扁舟谁钓两溪春。\n久凭归梦寻香国，忽喜清樽对故人。\n满眼穷愁嗟我老，此生交旧独君真。\n华亭一水无多地，细作来书莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送文若归嘉禾二首 其二","author":"周紫芝","text":"将军十载半鸣珂，才武怜君中异科。\n但把长吟作回雪，不妨濒海看熬波。\n方愁只影身如寄，便买扁舟意若何。\n一别应须五年事，好诗从此为谁哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西湖词二首 其一","author":"周紫芝","text":"吴中小女结烟鬟，自打青腰唱采莲。\n欲趁歌声过南浦，藕花深处不通船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西湖词二首 其二","author":"周紫芝","text":"湖天无尽月如霜，露湿荷花别是香。\n何处渔郎解吹笛，并头惊起两鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吕仁父十九日朝谒初自宫南门","author":"周紫芝","text":"未央宫阙转光风，谁识萧何第一功。\n禁殿潮连银海阔，御楼霞似赤城红。\n旧来双舄飞翻处，今在春秋赞祝中。\n自此翔麟驾君辇，试从紫陌看方瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月中与儿曹露坐二首 其一","author":"周紫芝","text":"葛巾藤杖竹方床，旋扫花阴坐晚凉。\n儿小但随翁看月，夜长谁念客思乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月中与儿曹露坐二首 其二","author":"周紫芝","text":"客去无人与对床，风微聊借月为凉。\n杯中小友多情甚，勾引衰翁入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罂粟将成","author":"周紫芝","text":"庾郎十饭九不肉，家无斗储饭不足。\n穷儿朝来忽乍富，墙下千罂俱有粟。\n只今锦烂花争妍，想见云翻釜初熟。\n一饮醍醐生玉池，再饮沆瀣充朝饥。\n味虽似淡中实美，暖能扶老甘归脾。\n黄粱岁割一万斛，谩饲谷伯如猪肥。\n君不见蛾眉仙人家海涯，自种紫芋羹蹲鸱。\n尚说人间无此味，天酥酡固不可知。\n愿借东坡玉糁句，题作此窗罂粟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小儿灯下读细书戏作","author":"周紫芝","text":"一生青白强锱铢，老眼昏昏亦废书。\n长剑竟辜真事业，短檠空照旧虫鱼。\n临风忘酒殊妨事，隔雾看花不管渠。\n犹与蝇头较多寡，小儿曹合戒前车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵鲍仲山官居临大池傍鲍题以协趣取谢宣城所谓后协沧洲趣之句也","author":"周紫芝","text":"参军诗古清而臞，清瑶绕屋分西湖。\n长安城中开八陌，心知此地人皆无。\n草阁波平少傍舍，卧看晴沙鸟飞下。\n眼无公事儿自痴，句有澄江官颇暇。\n吾生已老心怀羞，为饥索米亦有求。\n闻君稍动谢守趣，令我转忆江南洲。\n诗成况复终少味，五字故坚不知畏。\n可怜未识故将军，应似当年灞陵尉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲山再示协趣韵","author":"周紫芝","text":"青衫老吏骨亦臞，身游魏阙心江湖。\n眼看白发不胜数，梦绕故乡何日无。\n况我携家得官舍，背水开门故墙下。\n不见湖光意阙然，欲唤归舟心未暇。\n一闻羞处令人羞，人生如此当何求。\n春动飞来属玉起，无人貌得河中洲。\n我生嚼蜡元无味，鲍谢诗高心独畏。\n西风长怨草虫秋，自笑酸寒溧阳尉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲平喜雨二首 其一","author":"周紫芝","text":"旱欲流金水欲裂，百千火聚作此热。\n秋风忽送雨一犁，应念田夫汗流血。\n庙堂调烛随弛张，五色线补虞帝裳。\n书生拟作丰年颂，临窗弄笔鬓如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲平喜雨二首 其二","author":"周紫芝","text":"田作何郎炊饼裂，饮冰不救中肠热。\n千山云路鸟欲飞，六月行人驹汗血。\n风师偃旆那复张，雷师鞭雨沾帷裳。\n雨中仿佛云子香，行看玉粒秋饱霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题蔡仲平博士行田记唱诗轴二首 其一","author":"周紫芝","text":"当年车骑两联翩，来按钟陵水复田。\n可但痴儿了公事，尚馀诗思入风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题蔡仲平博士行田记唱诗轴二首 其二","author":"周紫芝","text":"令君颇似太邱贤，水旱忧君记昔年。\n父老犹能谈旧事，想随佳句共流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵孙子绍判院喜雨之作","author":"周紫芝","text":"丰隆欲鞭车，风伯不借便。\n我欲讼风伯，云意亦复变。\n帝命谁敢迟，民事那可缓。\n油云始肤寸，崇朝忽瀰漫。\n深忧轸渊衷，冻雨洗霜霰。\n知谁挽银河，倾泻落天半。\n喜气同雨来，孙郎语良健。\n应怜占籍者，就食免流转。\n天子坐法宫，斯民乐芳甸。\n云山倘可寻，野水不辞乱。\n幽人得新凉，妙作寄三叹。\n君锋不可当，我复那能殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱塘初见黄爵","author":"周紫芝","text":"侬家大江东，黄爵家江西。\n江东黄爵不忍吃，江西黄爵贱如泥。\n赤罂封口上有印，白绵卧酒中含脂。\n君不见浯口漫郎真漫仕，万事平生不如意。\n一囊红粟不一咽，千里苞苴谁复寄。\n有时鲑菜念故乡，并刀落脍思饱霜。\n青龟未堪聊入俗，黄爵那知亦渡江。\n时平漫说尔可咀，击鲜谁遣今得尝。\n残杯欲尽客欲去，臛雁烹鱼岂论数。\n酒闻风味不可名，惟有此郎难著句。\n九原谁唤儋耳翁，添入当年老饕赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花次元啸斋","author":"周紫芝","text":"手种琅玕岁已成，要听风雨近窗鸣。\n戏将落月千寻影，幻作长离半岭声。\n蕙帐梦残秋雨急，锦囊诗了夜灯清。\n便须写入朱弦曲，安用能回越石兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月二十日秘阁曝书二首 其一","author":"周紫芝","text":"芸香时近曝书筵，缥帙缃囊得纵观。\n不是圣时修故事，岂知藏室有清官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月二十日秘阁曝书二首 其二","author":"周紫芝","text":"香罗剪帕金描凤，红字排方玉作签。\n身到蓬山瞻御墨，眼惊奎宿射珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题徐季功画墨梅木犀二首六言 其一","author":"周紫芝","text":"夜色无人能画，徐郎挽上寒枝。\n仿佛孤山尽处，黄昏月到花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题徐季功画墨梅木犀二首六言 其二","author":"周紫芝","text":"细雨欲催秋晚，幽花已著寒枝。\n似我江南九月，西风马上归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题徐季功画二古木二首六言 其一","author":"周紫芝","text":"千尺龙蛇夭矫，半山风雨凭陵。\n谁为梅花赋手，能回古木寒藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题徐季功画二古木二首六言 其二","author":"周紫芝","text":"何处千年双干，未嫌雪虐风饕。\n楚士两龚介洁，孤竹二子清高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剪芦藩出木犀二绝 其一","author":"周紫芝","text":"小窗幽绝为谁通，分得清阴落坐中。\n可笑森严木居士，肯来相伴竹坡翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剪芦藩出木犀二绝 其二","author":"周紫芝","text":"特地移藩唤木犀，眼明初见岁寒枝。\n临风想像香来处，不到黄昏满树时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子绍游寿星寺寒碧轩","author":"周紫芝","text":"好竹连山万壑青，落星天近接飞甍。\n流杯共把人须胜，风玉相看眼倍明。\n故老旧游云已散，孙郎长啸凤重鸣。\n闲来却倚朱栏看，苍雪依然入句清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别方桐川","author":"周紫芝","text":"一麾投老始专城，共理聊烦助圣明。\n欲识斯民元不病，要知循吏本无声。\n官闲莫道州如斗，客满何妨饮似鲸。\n它日桐川楼下酒，会须分与故人倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首示陈李二省曹 其一","author":"周紫芝","text":"客枕难禁夜，醨樽不解愁。\n秋声归草树，霜力到衣裘。\n依约江南梦，留连海畔州。\n君休问新句，只有大刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首示陈李二省曹 其二","author":"周紫芝","text":"细数平生旧，谁人到白头。\n飘零无藉在，生死任羁愁。\n太白今诗伯，元龙昔胜流。\n吾衰已如许，何得奉君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李郎中休日不出二首 其一","author":"周紫芝","text":"文昌不作吏曹忙，赐沐归来日更长。\n青士寒生庭下雨，木奴香借树头霜。\n唤回短梦知何事，寻得新诗又夕阳。\n遥想南窗卷疏箔，起看双鹭入鹓行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李郎中休日不出二首 其二","author":"周紫芝","text":"簿领痴儿作底忙，闲中得味独君长。\n登临莫负山如玉，岁月还成鬓作霜。\n谁把酒浇陶靖节，天将诗付沈东阳。\n明朝湖上看双璧，兄弟联镳作雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨吉老秋怀古风","author":"周紫芝","text":"相思复相思，一别遽如许。\n相望隔参商，相期邈秦楚。\n溯洄愿从之，道路长且阻。\n道阻不足忧，岁暮心独苦。\n踏车缲丝娘，头绪几千缕。\n寒螀声酸嘶，入我肺与腑。\n自我之来思，悠悠六寒暑。\n赖此同社郎，清风生玉麈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送冯清叟使虏三首 其一","author":"周紫芝","text":"上尽西湖几翠峰，偶依征驿度边风。\n遥知载酒寻山句，尽入弯弓落雁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送冯清叟使虏三首 其二","author":"周紫芝","text":"君王慈俭不临戎，国好长因汉使通。\n遥想南归寒已尽，榆关草色正春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送冯清叟使虏三首 其三","author":"周紫芝","text":"黄云朔雪马凌兢，去踏河边六尺冰。\n博望封侯君亦喜，归来洗眼看飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]