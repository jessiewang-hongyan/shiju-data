[{"title":"醉落魄 其一 辛未九月望和答庆符","author":"胡铨","text":"百年强半。\n高秋犹在天南畔。\n幽怀已被黄花乱。\n更恨银蟾，故向愁人满。\n招呼诗酒颠狂伴。\n羽觞到手判无算。\n浩歌箕踞巾聊岸。\n酒欲醒时，兴在卢仝碗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 和陈景卫忆西湖","author":"胡铨","text":"一忆西湖太瘦生。\n十年不到梦曾行。\n空濛山色烟霏晚，淡沲湖光雾縠轻。\n芳草远，暮云平。\n雨馀空翠入帘明。\n梦回一饷难存济，这错都因自打成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 癸酉吉阳用山谷韵","author":"胡铨","text":"梦绕松江属玉飞。\n秋风莼美更鲈肥。\n不因入海求诗句，万里投荒亦岂宜。\n青箬笠，绿荷衣。\n斜风细雨也须归。\n崖州险似风波海，海里风波有定时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"胡铨","text":"万古嗟无尽，千生笑有穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"胡铨","text":"盈尺子鱼来丙穴，一瓶女酒敌新州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"胡铨","text":"君侧无谗人，发口不须婉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"胡铨","text":"两山排闼来，周遭似环翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十三","author":"胡铨","text":"梦入琼崖身益壮，烟销金坞臭空传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"胡铨","text":"中有羁孤湿帽尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"胡铨","text":"眼明渐见天涯驿，脚力将穷地尽州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"胡铨","text":"有水不栽莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"胡铨","text":"儋耳道中还可乐，东坡安用叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"胡铨","text":"啖毡使者莫思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"胡铨","text":"君恩许归此一醉，傍有梨颊生微涡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十四","author":"胡铨","text":"笑春烛底影，煎泪风前杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"胡铨","text":"梁园高会忆邹岩，千里莼羹未下盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百字令 几上凝尘戏画梅一枝","author":"胡惠斋","text":"小斋幽僻，久无人到此，满地狼藉。\n几案尘生多少憾，把玉指亲传踪迹。\n画出南枝，正开侧面，花蕊俱端的。\n可怜风韵，故人难寄消息。\n非共雪月交光，这般造化，岂费东君力。\n只欠清香来扑鼻，亦有天然标格。\n不上寒窗，不随流水，应不钿宫额。\n不愁三弄，祗愁罗袖轻拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 灯花","author":"胡惠斋","text":"暝霭黄昏，灯檠上、荧荧初炙。\n银焰袅、孤光分夜，寸心凝碧。\n留照娇颜欢笑偶，上元庆赏嬉游夕。\n笑聚萤、积雪与偷光，寒儒忆。\n蝶眷恋，成何得。\n花传喜，知何日。\n听邻家昨夜，扣阍谁觅。\n焰短始知新月上，摇红孤馆因风急。\n恨那人、别后不成眠，时时剔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯范子","author":"胡景裕","text":"当年邂逅帝王畿，岁月侵寻若电飞。\n学士荣除青锁闼，故人老著白麻衣。\n尊前且斗闲身健，眼底休论往事非。\n第恐锋车促严召，片帆明发不轻违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风铃","author":"胡朝颖","text":"风不能调碎玉声，宫商滥奏竟难名。\n谁家稚女敲方响，一曲从头学不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅夜书怀","author":"胡朝颖","text":"十日春光九日阴，故关千里未归心。\n遥怜儿女寒窗底，指点灯花语夜深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小金山","author":"胡朝颖","text":"天光云影碧相涵，百顷玻璃一望间。\n绿水绕门迷客渡，白云终日伴僧闲。\n疏钟破晓潜虬动，老木成阴倦鸟还。\n唤取头陀磨石壁，为渠题作小金山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游","author":"胡朝颖","text":"风烟冉冉草萋萋，乍雨还晴不作泥。\n粉蝶乱随花片妥，黄鹂双压柳枝低。\n一湾渌水明凫影，数里青山送马蹄。\n无限春光吟不尽，浮红浪紫望中迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"胡朝颖","text":"久闻父老言沙谶，为问何时出状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"胡温彦","text":"难甘不是唐工部，窃效犹堪艳绣鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"胡温彦","text":"南朝欲相风方上，北敌闻风骨已寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"胡温彦","text":"已听恩波生茗椀，更看皇泽下鸡竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清江道中","author":"胡琴窗","text":"黑潦妨行役，呼船渡碧湾。\n春烟数家远，绿树一莺闲。\n古有难行路，今无僻处山。\n空馀芳草句，流落在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颜鲁公祠","author":"胡舜举","text":"立庙本来皆可纪，凛然英烈殆天启。\n年垂八十官太师，平生所欠惟死尔。\n分甘一死鸿毛轻，举世俗子何用嗔。\n谁知我公本不死，眉间生气犹峥嵘。\n堂堂十老皆人杰，逢辰遇合稷与契。\n俨然玉立配我公，忠义文章两奇绝。\n我来摩挲读丰碑，扛鼎笔力犹精奇。\n定应神物常护持，劲直千载垂良规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 江行阻风","author":"胡舜陟","text":"几日北风江海立。\n千车万马鏖声急。\n短棹峭寒欺酒力。\n飞雨息。\n琼花细细穿窗隙。\n我本绿蓑青箬笠。\n浮家泛宅烟波逸。\n渚鹭沙鸥多旧识。\n行未得。\n高歌与尔相寻觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感皇恩 丐祠居射村作","author":"胡舜陟","text":"乞得梦中身，归栖云水。\n始觉精神自家底。\n峭帆轻棹，时与白鸥游戏。\n畏途都不管，风波起。\n光景如梭，人生浮脆。\n百岁何妨尽沈醉。\n卧龙多事，谩说三分奇计。\n算来争似我，长昏睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登黄楼","author":"胡谧","text":"山接青齐横翠黛，水兼汴泗入洪流。\n西风落日凭栏处，廊庙江湖总系愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄人","author":"胡楚","text":"不见当时丁令威，年来处处是相思。\n若将此恨同芳草，却恐青青有尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆彭头山","author":"胡楚材","text":"久客倦行役，故山安在哉。\n松竹读书室，水石钓鱼台。\n明月照归梦，西风吹酒杯。\n亭亭篱下菊，寂寞为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青山怀古","author":"胡楚材","text":"樵猎识冠裳，何言志四方。\n离秦风日冷，过楚薜萝长。\n梦野违徵诏，时衰枉荐章。\n故山隈且僻，应种秫为粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"默山小潭","author":"胡楚材","text":"分落银河一派清，源深流远旱常盈。\n蛟龙潜处鱼虾少，日月中时表里明。\n插岸好山青泼黛，倚波丑石势奔鲸。\n幽奇信是神仙窟，上有浮云散又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙池岩","author":"胡楚材","text":"崚嶒插天山，仙池在绝顶。\n无源水自溢，泓澄照天镜。\n鱼依藻荇深，龙藏密穴静。\n天意欲为雨，烟雾如炉甑。\n至今山下田，势不忧旱横。\n划然霁景开，仰看飞泉迸。\n一道翠微间，长剑倚天净。\n群山列画屏，高下相辉映。\n安得丹青手，写此绝胜境。\n挂我草堂中，吟望免延颈。\n不负山水心，永谢利名阱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白艾溪","author":"胡楚材","text":"澎湃白艾溪，源恐从天落。\n滩石剑戟列，喷怒波势恶。\n篙工手眼亲，飞舫过如箨。\n达阻有长桥，轻虹□寥廓。\n参天树列幢，夹岸如山削。\n中有钓鱼郎，扁舟□寂寞。\n俗眼急势利，问此何足乐。\n不钓沧海鳌，须脍潮州鳄。\n胡为持一竿，默在艾溪脚。\n我且笑不答，自歌还自酌。\n日暮鼓枻归，风埃满城郭。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清溪","author":"胡溥","text":"杨柳汀洲绿四围，沙中禽鸟杂相依。\n烟留群鹭和鸥卧，霞带孤鸿与鹜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睢阳五老图","author":"胡瑗","text":"始同优烈晚同闲，五福俱全戴角冠。\n典午山河遵大道，调元宗社对穹桓。\n羌夷谁敢窥中夏，朝士猜疑畏岁寒。\n肱股赓歌遗韵在，惟吾后进祇膺看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石壁","author":"胡瑗","text":"李白好溪山，浩荡旌川游。\n题诗汪氏壁，声动桃花洲。\n英辞逸无继，尔来三百秋。\n汪公亦蕃衍，宗支冠南州。\n其间新建居，林泉最清幽。\n竹声满道院，山光入书楼。\n仙气既飘飘，儒风亦悠悠。\n子孙多俊异，词行咸精修。\n我来至石壁，赏之不能休。\n酣味碧溪水，苦饮黄金瓯。\n因羡汪君居，复思汪君投。\n遇景清兴发，浩与天云浮。\n斐章异绣段，洒翰非银钩。\n庶与谪仙诗，千古同风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"佛牙山","author":"胡鉴","text":"烈火烹煎沸鼎游，梦回渐觉此身浮。\n坐忘三载蕉中鹿，卧护一帆天际舟。\n要识此心如止水，尽将尘迹送牢愁。\n荆溪莓藓青无恙，待与石亭三日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定业寺","author":"胡鉴","text":"拂云开紫气，窈窕入幽境。\n杉森若趋山，竹青无尽境。\n寒螀互响答，野鸟话深静。\n暗水冽池光，疏风碎金影。\n骋怀抖黄埃，吸景别清镜。\n三年面溪西，所乐尤未竟。\n出野山益深，佳气为参请。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题大涤洞天留题","author":"胡?","text":"拔脚红尘到蕊宫，眼前物物是诗筒。\n云关左右转九锁，天柱西南边一峰。\n正喜斋厨供笋蕨，更寻药圃觅芝芎。\n飞仙何在应怜我，指出灵丹绀箬丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈执中","author":"胡僧","text":"虎目猿身形最贵，只因攀附即升高。\n知君今向端溪去，助子清风泛怒涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"胡僧","text":"何年饮著声闻酒，直到而今醉不醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 寿黄邦彦四月初八","author":"胡德芳","text":"湛湛玉清水，矗矗炼丹山。\n秀环侯泮，广文分得括苍仙。\n虞殿薰风初入。\n尧陛祥蓂七叶，此际庭真贤。\n学术瑞王国，声誉蔼人寰。\n绿槐宫，丹桂殿，杏花坛。\n英华粲发，聊将文教布龙藩。\n我亦执经北面，喜见发祥南斗，再拜祝长年。\n丹诏烂鸦墨，绿发映貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘升之蛰龙岩","author":"胡槻","text":"东望尧山西舜宫，山人名姓不求通。\n蛰岩侧畔蘧庐子，即是巢由住个中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追和叔祖自述韵","author":"胡震雷","text":"霅川疑狱独承当，敬远炎炎即馆凉。\n帝子几曾谋不道，相臣自弗肯包荒。\n李猫初劾犹全命，梁犬重评竟断肠。\n甘死如饴行素志，岂知流入杀青香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南剑州","author":"胡器之","text":"化成丹碧出鳌头，独占闽川最上游。\n两剑合来灵一境，双流分处带三州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"镡溪阁","author":"胡器之","text":"龙津剑窟古南州，阁势横空占上游。\n山色镇留春色在，水光长带宝光浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"胡澹翁","text":"如今竹阁多清兴，紫蟹尖团不数虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"胡澹翁","text":"赤鱼白蟹何足数，风味未可松江鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"胡澹翁","text":"鲑鱼还抵店，虾蟹不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题采石渡","author":"胡璞","text":"抗议金銮反见雠，一杯蝉蜕此江头。\n当时醉弄波间月，今作寒光万里流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书堂","author":"胡融","text":"右军本清真，名题列仙籍。\n朝披赤城霞，凭崖望南极。\n不读人閒书，诛茅近东壁。\n松窗拂青霭，石架横野色。\n草圣天仙求，竹扇山猿觅。\n不有铁石心，敢迩虎豹迹。\n高歌振林木，上与霄汉迫。\n时有太一星，拥杖照几席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双阙","author":"胡融","text":"朝游双阙下，遂登双阙上。\n峻壁束清溪，石扇阖奔嶂。\n旁通风云气，下蓄关键状。\n高踰剑阁竦，狭过彭门壮。\n我行季秋月，霜飙扫霾瘴。\n崖枯水还壑，巴峡失清涨。\n矫步凌丹梯，陟崄神愈王。\n作书遗家人，咋指悔狂妄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉霄峰","author":"胡融","text":"青冥玉霄顶，静夜无纤埃。\n手携赤松子，拂石坐苍苔。\n举瓢呼海月，长虹贯金罍。\n挂剑桂树枝，洗手天河洄。\n我欲铲崖嶂，涉海登蓬莱。\n要观中州碑，鼓枻云涛堆。\n风波虽可越，长鲸正崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伏虎坛","author":"胡融","text":"顗公天人师，猛虎屡欲瞋。\n形体掘槁木，鸷心化为仁。\n猥厕龙象侧，而作猫犬驯。\n砺齿怖天魔，掉尾迎山君。\n西伯困羑里，仲尼畏匡人。\n人心害贤圣，宁与猛虎邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鍊丹井","author":"胡融","text":"荒巅有野井，古意豁冥搜。\n藓石已摧剥，云萝閟清幽。\n忆昔抱朴翁，炼液栖高丘。\n朝饮井中泉，暮濯井下流。\n丹成已蝉蜕，岩花几春秋。\n但见虎豹蹄，印迹碧甃头。\n举瓢酌寒泉，一饮销百忧。\n日暮洞恍惚，攀桂聊淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐柏山","author":"胡融","text":"清晓骑白鹿，直上桐柏山。\n山环若城郭，琪树郁参天。\n青猿导我路，如入崆峒巅。\n瑶草被阪绿，琼蕊凌霜繁。\n旁瞰老子宫，玲珑隐林閒。\n垩栋天马出，绛柱彫龙盘。\n喜与冥寂士，共谈秋水篇。\n散发松下啸，拂霞石上眠。\n赠我玄玉膏，相期淩紫烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐柏碑","author":"胡融","text":"韩公在大历，高名悬日月。\n游戏翰墨场，八分独奇绝。\n遥嗤程邈钝，近鄙伯喈拙。\n我来桐柏巅，洗眼见碑碣。\n峍屼挟风霜，钟簴粲成列。\n龟跗閟琳宇，铁画照清越。\n至今毡墨工，石本走胡越。\n引袖拂台山，山尽字乃灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望海石","author":"胡融","text":"枯藤拄苔磴，长啸淩秋风。\n天空白露下，碧落摩青铜。\n夜半见海日，发轫扶桑红。\n黄支与流求，出没白浪中。\n久誇坎井见，始知天壤空。\n招手唤海童，寄书蓬莱宫。\n我欲蹲此石，投竿慕任公。\n巨鳌傥可得，持压江之东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄经洞","author":"胡融","text":"平生山水癖，遐往心独喜。\n采秀凌丹丘，忽遇白云子。\n腰剑苍龙活，野袂青霞起。\n邀我石洞行，共坐啖石髓。\n架有黄庭经，犹是东晋纸。\n粲若锥画沙，其字大如指。\n口传却老术，长跪与进履。\n吾心在魏阙，焉得给薪水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼台","author":"胡融","text":"璿台插中天，仙圣展游眺。\n亭亭珠玕树，蒙日光照曜。\n上有天乐鸣，嘈杂声要妙。\n浮丘倚岩听，玉女排云笑。\n兹游偿夙心，时闻八鸾啸。\n搴茎茹金芝，援藟爱青峭。\n琅琊失孤岫，渤海播圆峤。\n抵掌嗤客星，石濑坐投钓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]