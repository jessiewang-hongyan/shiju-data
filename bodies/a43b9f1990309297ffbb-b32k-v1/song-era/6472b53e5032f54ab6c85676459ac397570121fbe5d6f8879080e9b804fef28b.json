[{"title":"郑国太挽词四首 其一","author":"张纲","text":"五福兼全举世稀，庭闱早日见清规。\n应期千载生公辅，掩迹三迁号母师。\n汉魏疏封华国史，蘋蘩遗德继周诗。\n年年只说重阳近，无复黄花酒一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑国太挽词四首 其二","author":"张纲","text":"一夕萱堂事已非，百年遗范在丰碑。\n颁花玉殿春风暖，奉诏登楼夜漏移。\n罢宴已闻修故事，回班那复见新仪。\n音容寂寞应仙去，香火因缘只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑国太挽词四首 其三","author":"张纲","text":"兰桂秋风一夜催，衮衣何处望南陔。\n堂垂斗帐销香篆，鉴掩飞鸾下玉台。\n汉使从天虚卤簿，胡笳和月助悲哀。\n东门咫尺佳城在，双鹤飞空日几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑国太挽词四首 其四","author":"张纲","text":"铭旌冉冉去飞扬，萧瑟西风泣画堂。\n不见鱼轩辞绣毂，空馀鸾诰冷绡囊。\n姓名自是标仙籍，环佩应知返帝乡。\n尽把遗芳归史笔，会令千古独辉煌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何丞相挽词三首 其一","author":"张纲","text":"一德乘亨运，三公冠宰司。\n秉钧回直道，解组向明时。\n人去空图画，名存粲鼎彝。\n悬知千古后，贪懦激清规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何丞相挽词三首 其二","author":"张纲","text":"帝念亏三鉴，天临动八銮。\n飞星瞻傅说，旧学记甘盘。\n治定身先退，名全德不刊。\n于何验符策，有子嗣鸳鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何丞相挽词三首 其三","author":"张纲","text":"不憖遗元老，岩岩失具瞻。\n勋庸扶庙社，名字到闾阎。\n王国开封大，师垣宠数兼。\n梦鸡初莫省，今日竟成占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谭胜仲挽词二首 其一","author":"张纲","text":"词伯风骚旧，公朝宿望存。\n郎官宁出宰，廷尉亟平反。\n梦断天衢远，愁连野树昏。\n祗应阴德茂，兰玉照于门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谭胜仲挽词二首 其二","author":"张纲","text":"时论归清德，耽书到白头。\n士应知己用，人岂法家流。\n骨瘦凌孤鹤，诗豪压万牛。\n悲看耆旧传，谁复继前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤德广挽词三首 其一","author":"张纲","text":"四海知名士，三朝老从臣。\n勤王安反侧，分阃试经纶。\n天阔鸳行断，山空马鬣新。\n丰碑满忠义，千古诏簪绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤德广挽词三首 其二","author":"张纲","text":"忠愤忧时切，风云得路先。\n官箴循吏传，家法棣华篇。\n灭虏兵方急，优贤席屡前。\n如何天不憖，高冢卧苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤德广挽词三首 其三","author":"张纲","text":"束发师前辈，忘年得此翁。\n鸡豚同里社，诗礼共家风。\n别去十年久，书无三月空。\n归来人不见，铭旐舞斜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张彦度挽诗二首 其一","author":"张纲","text":"京兆吾宗不乏人，煌煌朱绂照簪绅。\n棠阴讼简弦歌乐，莲幕才高画诺新。\n北海但知樽有酒，莱芜谁念甑生尘。\n哀笳忽送秋风急，忍看遗踪万古陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张彦度挽诗二首 其二","author":"张纲","text":"满目溪山旧赏心，杖藜那复共登临。\n平生友谊情无间，累世宗盟分更深。\n顾我老怀谁告语，思君遥夜独悲吟。\n流风赖有诸郎在，他日相亲倘嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庄弱翁挽诗二首 其一","author":"张纲","text":"厚德乡评最，知名国士同。\n郎曹参列宿，宰属辅宗工。\n紫诏恩垂下，黄梁梦已空。\n九原那可作，流涕湿西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庄弱翁挽诗二首 其二","author":"张纲","text":"仕路青霄逼，还家白发生。\n一麾惊作梦，三径适幽情。\n孰谓如兰契，先随逝水倾。\n送君悽断处，烟雨暗铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡氏硕人挽词二首 其一","author":"张纲","text":"吾舅当朝杰，幽芳配德同。\n典刑家法整，汤沐上恩隆。\n鸾影悲尘鉴，兰芬泣露丛。\n音容不知处，宰木夜号风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡氏硕人挽词二首 其二","author":"张纲","text":"我有劬劳念，多从外氏游。\n母仪频接侍，宾馈每淹留。\n应惜年垂老，相亲礼特优。\n一朝千古别，衰泪不能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舅李侍郎挽词三首 其一","author":"张纲","text":"射策飞腾早，推贤望实兼。\n直心常自负，大器果难淹。\n持橐丹墀稳，分符画戟严。\n平生莫追忆，泪尽转愁添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舅李侍郎挽词三首 其二","author":"张纲","text":"诸舅唯公在，承颜念母存。\n笑看身已老，情话意弥温。\n不作求田计，方期报主恩。\n高堂忽萧瑟，谁为赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舅李侍郎挽词三首 其三","author":"张纲","text":"彊健公先去，零丁我曷从。\n同盟空白水，酷似有衰容。\n休说鹓行梦，看成马鬣封。\n泪流南望眼，愁绝暮云重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪庆善挽词二首 其一","author":"张纲","text":"画省真郎选，朱幡老郡侯。\n名归时论重，行向古人求。\n嗜学千鸡蹠，修文五凤楼。\n秋风忽惊梦，怀旧涕交流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪庆善挽词二首 其二","author":"张纲","text":"忝戚乡闾旧，论交道义深。\n穷搜千古意，乐易一生心。\n遭谤身虽贬，全名死不沉。\n君恩为昭雪，归窆得家林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴氏太淑人挽词","author":"张纲","text":"生儿要路早飞腾，玉瑱金花宠屡膺。\n天寿康宁逾九帙，佛心明了契三乘。\n葭莩永叹音容阻，闾里空存孝义称。\n追想潘舆从游处，青青烟草正愁凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈叔美挽词","author":"张纲","text":"坦腹东床众莫奇，堂堂吾弟独君知。\n交亲未及亲三岁，沦丧俄惊共一时。\n琴在我方悲子敬，礼存谁为哭言思。\n山阿幽室千年閟，挽语空吟靖节诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"外祖李承事挽词二首 其一","author":"张纲","text":"总角承颜赖击蒙，后生因识古人风。\n忘情自到羲皇上，盛事多谈庆历中。\n双寿儿孙青若若，一门慈孝郁葱葱。\n吁嗟耆旧今何在，古木斜阳濑水空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"外祖李承事挽词二首 其二","author":"张纲","text":"西山忽与老人期，未报深恩忍复思。\n燕及祖风从少小，与闻家训识操持。\n聊从诸舅纪遗行，深愧外孙无好辞。\n悬想追封在他日，附书名传有佳儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舅李义卿挽词","author":"张纲","text":"由来甥舅两相依，存没谁知半路亏。\n在侧每蒙誇叔宝，不才那得似牢之。\n临风酌酒酬春处，对月凭轩语夜时。\n回首凄凉已陈迹，壮心无哭奈愁思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈洞元挽词","author":"张纲","text":"天阙辞严召，云栖得坐忘。\n尊生三洞箓，起死上池方。\n神托飞鱼化，丹馀旧灶香。\n从今纪甲子，华表伫还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐献仲挽词","author":"张纲","text":"一尊相别未经时，情话如今忍复思。\n老去交亲能有几，年来怀抱更谁知。\n溪桥路断秋风急，香火庭空晓日迟。\n三尺孤坟闭千古，伤心东望涕交颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁宣仲挽词","author":"张纲","text":"回首三年别，追怀一笑欢。\n坐移香砌暖，饮散烛花残。\n蒿里归何速，桃蹊忍更看。\n秋原愁绝处，为想鹡鸰寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李居正挽词","author":"张纲","text":"白首论交旧，黄冠独此人。\n诚全知俗薄，语直见情亲。\n上馆钟鱼在，空坛月露新。\n如今入山去，行处是悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁明仲挽词二首 其一","author":"张纲","text":"世德知名早，乡评第一流。\n折腰官易厌，拄颊兴难收。\n博物千寻海，高情百尺楼。\n平生松菊径，萧瑟晚云秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁明仲挽词二首 其二","author":"张纲","text":"里社欣相接，葭莩晚益亲。\n过从忘客礼，简易见天真。\n把酒微风夜，归舟细雨春。\n如今每追忆，悽恸欲伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈美成挽词二首 其一","author":"张纲","text":"望族推平舆，清芬嗣太邱。\n乡评严礼法，家学邃源流。\n幸托葭莩契，方期仗履游。\n西风忽悲惨，忍复看眠牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈美成挽词二首 其二","author":"张纲","text":"德润洮湖阔，心平福地安。\n流风前辈似，雅量鄙夫宽。\n松菊开三径，芝兰秀二难。\n百年如转烛，萧瑟夜堂寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁宋卿挽词","author":"张纲","text":"旧约频相过，交情忍独违。\n四时闲杖履，一榻冷烟霏。\n易感龙祠别，难期鹤驭归。\n老怀谁共语，东望益沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦饰弟挽词二首 其一","author":"张纲","text":"吾家奕奕茂芝兰，士论尤推季孟间。\n挟策可怜场屋老，杜门空对水云间。\n嗟余屏迹常多病，幸尔论心数解颜。\n乘兴过从无复日，忍将愁眼望西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦饰弟挽词二首 其二","author":"张纲","text":"解组归来会面初，杖藜朝暮过吾庐。\n相亲樽酒情无间，共话田园乐有馀。\n樗散年颓方倚托，棣华风急顿萧疏。\n堂堂人物无高寿，不那哀伤泪满裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦深弟挽词","author":"张纲","text":"忆弟悬弧日，当余弱冠年。\n艰勤同素志，衰病各华颠。\n辞禄归相倚，惊魂去忽先。\n一樽风雨夜，那复共蝉联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈子张挽词二首 其一","author":"张纲","text":"地发湖光秀，神钟鹤骨清。\n高谈排俗子，执友遍时英。\n枳棘鸾栖在，松楸马鬣成。\n欲收东望眼，流涕若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈子张挽词二首 其二","author":"张纲","text":"交契先朝露，凄凉对夕晖。\n箕裘三世远，簿领一官微。\n翠柏开新隧，青编冷旧帏。\n元方未惭长，万里看横飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坚所生母李氏安人挽词五首 其一","author":"张纲","text":"仙李移根远，夭桃表庆长。\n九重颁象服，三世奉萱堂。\n尚想慈祥性，难追淡靓妆。\n眼酸生怕哭，双泪忽淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坚所生母李氏安人挽词五首 其二","author":"张纲","text":"四德腾芳早，三乘悟性空。\n清修忘俗累，勤俭肃家风。\n舞镜鸾悲影，飞花雨泣丛。\n愁情无处著，半入梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坚所生母李氏安人挽词五首 其三","author":"张纲","text":"旧约余偕老，分违汝忽先。\n有怀中馈阙，无憾母仪全。\n望断送归路，衷缠垂尽年。\n何当卜同穴，相与伴愁烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坚所生母李氏安人挽词五首 其四","author":"张纲","text":"七帙开逾半，孤芳散若飘。\n可怜频举案，那复记吹箫。\n翠幌浮埃积，熏炉旧炷消。\n如何寄怀抱，细雨夜萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道士王如晦真赞 其一","author":"张纲","text":"色如春温，若可与言。\n神如水清，不可以烦。\n子乔仙去远矣，乃今识其裔孙。\n任造化之日逝，独湛然而常存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道士王如晦真赞 其二","author":"张纲","text":"道风仙骨照青春，谁写生绡却乱真。\n莫讶三毛不加颊，齐公端解视全人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道士李冲妙真赞 其一","author":"张纲","text":"蟠根仙李万叶敷，遗芳岂直黄冠徒。\n吐气硉矹古丈夫，味道之腴貌何癯。\n谁令畏垒俎豆予，龙吟虎啸人争趋。\n故栖猿鹤情未疏，翻然脱屣吾归欤。\n舍者争席不关渠，向来形谍诚区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道士李冲妙真赞 其二","author":"张纲","text":"领袖名山，龙吟虎啸。\n忽辞屦于户外，信光矣而不耀。\n是将冲而用之，深入乎众妙之门。\n吾不知其人，曰伯阳之孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞写真 其一","author":"张纲","text":"堂堂莫作公侯想，是身如幻无定相。\n衣冠挂却神武门，便是维摩坐方丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞写真 其二","author":"张纲","text":"投闲岁久，圣恩图旧。\n载锡身章，在帝左右。\n骨相多屯，何以瘉人。\n陈力就列，勿为具臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南洞即事","author":"张纲","text":"紫绶金章八十三，衰残不称旧官衔。\n烦君写作归田老，野野翛然坐碧岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释文观","text":"过去诸如来，斯门已成就，好事不如无。\n现在诸菩萨，今各入圆明，好事不如无。\n未来修学人，当依如是住，好事不如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其一","author":"释文观","text":"冬瓜蘸雪未为淡，匠者三文淡最幽。\n淡最幽，天共白云晓，水和明月流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释文观","text":"赵州勘破老婆时，恰似青春三月里。\n陌上游人争看花，鹧鸪啼处谁相委。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其三","author":"释文观","text":"冰雪肌肤西舍女，梳妆巧巧画双眉。\n傍人笔力强传写，户外如何见得伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古","author":"释可观","text":"夹山不在一桡上，明月芦花夜夜寒。\n谁谓华亭消息断，俨然秋色在江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重九","author":"释可观","text":"胸中一寸灰已冷，头上千茎雪未消。\n老步只宜平地去，不知何事又登高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自题像","author":"释可观","text":"维摩诘不坏于身，而随一相老竹庵。\n坏与不坏，初无欠长。\n到处江山风月，不是这个伎俩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"延福寺","author":"刘涛","text":"唐时贤士今何在，晋代青松独此存。\n往事悠悠何处问，金鸡山色又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思古堂","author":"刘涛","text":"今人思古不如古，后代思今亦似今。\n古往今来祇如此，溪山伤尽几人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处士林知墓","author":"刘涛","text":"处士坟三尺，吴山松万株。\n空馀著书业，不见炼丹炉。\n道古言难合，年高势最孤。\n盛朝礼乐备，无处用真儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"张澄","text":"均佚归来一品崇，赤城新野焕仙风。\n功存社稷今全德，身佩安危本至公。\n宁似乐天丹灶破，不令北海酒樽空。\n中原未靖戎氛恶，会有吁谟沃舜聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"张澄","text":"背郭堂成乐趣真，碧油幢下海山春。\n谁知种木十年手，元是擎天一柱人。\n久矣威名彰草木，行须谈笑静风尘。\n宁容巾屦长闲逸，即看金瓯宠数新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青云亭","author":"张澄","text":"昔者青云亭，位置直巽隅。\n旴江入怀抱，灵谷当襟裾。\n百年但草茀，兔葵杂榛芜。\n我登问安堂，凝睇爽气俱。\n相将还绝赏，翚飞接云凫。\n却望州郭盛，五峰画不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雷公山","author":"张澄","text":"年大嗜烟壑，心鄙城郭近。\n篮舆践晨霜，峭茜入云畛。\n病衰风见乘，放浪顾难忍。\n驾言小玩愒，微尚希遁隐。\n隐沦著扁舟，欲济江无流。\n岧峣雷公山，信美惭薄游。\n夕烟散林谷，暮钟鸣寺楼。\n抚事百感集，聊兹兼夕留。\n留情不复欢，恻恻抱悲叹。\n何以纾拂郁，曳策青云端。\n雷祠蔽深莽，灵宫俯层峦。\n下视万壑趋，遥见千峰攒。\n攒峰娱余心，领略悟山阴。\n平生一丘壑，何须故山岑。\n放怀白鸟盟，斯焉得重寻。\n题诗谢灵山，勿閟金玉音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嵯峨岭","author":"张澄","text":"晨登嵯峨岭，危欲搏春冥。\n安得秦六甲，锤凿使之平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]