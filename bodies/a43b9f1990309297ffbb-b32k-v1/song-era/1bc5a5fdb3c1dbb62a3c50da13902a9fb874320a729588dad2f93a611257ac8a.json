[{"title":"吴德夫侍郎挽诗 其一","author":"韩淲","text":"葵轩炉韛大，成铸几英才。\n绝叹长沙久，常钦蜀道回。\n豸冠千仗耸，凫舄九关开。\n持漕西江日，深惭过我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴德夫侍郎挽诗 其二","author":"韩淲","text":"不为盆盎浅，直欲挽狂澜。\n下士谦何假，崇师歉未安。\n只今那复有，从昔信为难。\n见说清闲甚，无钱可盖棺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐文子侍郎挽诗 其一","author":"韩淲","text":"分教随为大，公能过我庐。\n缙云尝和句，湓浦近收书。\n天府人间仰，甘泉帝所除。\n无高情复见，官路竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐文子侍郎挽诗 其二","author":"韩淲","text":"承华推旧学，鸿翼本高飞。\n次对恩空在，还官事已违。\n双元今孰并，高士古犹稀。\n应有交朋老，泉溪泪湿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽胡团王先生诗 其一","author":"韩淲","text":"在昔从诸老，于今失此翁。\n貌庄知德性，身退仰高风。\n制宅规何远，藏书意转隆。\n虽非官可贵，自与道无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽胡团王先生诗 其二","author":"韩淲","text":"著述钦成说，叮咛忆绪言。\n不期捐几杖，无复贲丘园。\n行旐村前路，丰碑屋外原。\n形容惭识浅，相挽只馨吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舒彦升监簿挽诗 其一","author":"韩淲","text":"不作骄浮态，还同谨厚为。\n决科将显大，脱选复逶迟。\n漕幕虽论荐，朝班仅取知。\n相看豸冠耸，忽听薤歌悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舒彦升监簿挽诗 其二","author":"韩淲","text":"起家荣宦路，纪墓重乡闾。\n忍见交亲语，应求耆彦书。\n成名常自美，遗范久何如。\n东阜田园在，西山县郭虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈宣抚待制挽诗 其一","author":"韩淲","text":"百尺楼高卧，宜乎造物游。\n卫青开幕府，李广不封侯。\n世界乾坤在，邦家岁月流。\n遥知水心老，历历志诸幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈宣抚待制挽诗 其二","author":"韩淲","text":"到眼交朋少，前头师友多。\n胶庠一腾达，台阁合婆娑。\n混迹谈谐尔，成名字画何。\n隆兴乾道旧，零落几山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李正之丈提刑挽词 其一","author":"韩淲","text":"犹记登龙日，分明捉月仙。\n精神超物表，才术本天然。\n符节多遗爱，玺书行九迁。\n岂期归蜀道，乃尔閟重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李正之丈提刑挽词 其二","author":"韩淲","text":"耆旧今零落，风流近所无。\n歌诗到元白，字画逼欧虞。\n为约言犹在，收书德不孤。\n阶庭知有子，庆泽自相符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余寺丞挽诗 其一","author":"韩淲","text":"仁宅居郊秀，儒科载世清。\n致君才列寺，教子亦专城。\n宠数垂车佚，恩封进秩荣。\n逢辰俱动色，厚夜失吞声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余寺丞挽诗 其二","author":"韩淲","text":"恪素安时论，谦洪陟宦涂。\n飞凫应缥缈，峨豸乃踟蹰。\n玉水流深派，灵山拥壮图。\n丰碑看陇首，大隧锡龟趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"俞麻溪挽诗","author":"韩淲","text":"哀挽麻溪上，人皆说此翁。\n平生多义事，终古盛儒风。\n湍石推名族，清湖想旧功。\n瑞云松桂满，寒露湿碑丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄都干挽诗","author":"韩淲","text":"叹息凋零旧，江城北客稀。\n宦涂谁衮衮，里社独依依。\n曾决文闱胜，才从将幕归。\n清霜吹夹路，老涕亦须挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东阳郭德谊挽词 其一","author":"韩淲","text":"赫奕汾阳后，才华冠里中。\n一官难未偶，五福合无穷。\n宾接师儒意，兴扬礼义风。\n不亡知有子，嘉誉发诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东阳郭德谊挽词 其二","author":"韩淲","text":"闾里应哀挽，佳城閟九泉。\n素车行靡靡，丹旐去翩翩。\n肠断西沉日，泪流东逝川。\n空馀书剑在，石洞贮风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭赵子夷县丞二首 其一","author":"韩淲","text":"海内宗盟盛，振振乃好修。\n伤心终契阔，回首近从游。\n才学年方壮，声猷志未休。\n人琴遽如许，歌罢玉溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭赵子夷县丞二首 其二","author":"韩淲","text":"病阻躬临穴，慇勤寄此哀。\n严霜著松柏，寒日转蒿莱。\n千雨应俱集，一诗惭匪才。\n致刍徐赵在，亦足慰泉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋和仲挽诗","author":"韩淲","text":"旧话无人说，南游事益暌。\n田园落吴楚，乡社失青齐。\n道院松风在，佳城薤露悽。\n衣冠典刑地，遗恨满霅溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋柳州挽诗","author":"韩淲","text":"清德乡闾冠，尝思宋柳州。\n故家犹有后，季子更无求。\n世业终能守，生涯仅足收。\n伤心往来地，翩旐土冈头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余四一隐君挽诗","author":"韩淲","text":"季蜕竟观化，忘机岂冯生。\n闲亭非故步，佳叙是修名。\n有子庶绵远，无官底重轻。\n遥怜小水寺，松路郁深清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭方伯谟","author":"韩淲","text":"平昔意翛然，闲吟肯自贤。\n贫应闻苦节，学亦得心传。\n路滑籍溪上，草深云谷前。\n何时奠鸡酒，为滴到重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭潘恭叔宣干","author":"韩淲","text":"怜我山之涧，高轩昔再过。\n人生倏长往，天意竟如何。\n德学知能绍，儒言信不磨。\n春风青宿草，宰上想坡陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭吕三","author":"韩淲","text":"东南驻跸地，近岁少狂言。\n谁谓长江上，又招迁客魂。\n归由徐稚舍，莽附阮孚墦。\n寒日松风起，妻儿独泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭斯远","author":"韩淲","text":"彤庭将赐第，疾病已缠之。\n药裹自无及，朝衣谁为披。\n识高空宛转，意广竟参差。\n只有章泉叟，与渠收旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南丰宋郎中夫人曾氏挽诗","author":"韩淲","text":"奕奕南丰氏，新碑见母仪。\n相夫郎省日，从子法曹时。\n懿美人皆仰，隆恩世所推。\n流芳当益大，双凤印累累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"俞夫人杨氏挽诗","author":"韩淲","text":"往岁登门日，庭闱见淑称。\n从夫期鼎贵，有子定登瀛。\n鸾诰恩荣在，鱼轩梦幻惊。\n谁歌蒿里挽，寒雨和松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江尉挽诗","author":"韩淲","text":"有子承家美，能书已荐贤。\n葛塘成别墅，严濑亦同川。\n意本功名远，身犹爵命迁。\n临终言不乱，云绕宝华天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈太平挽诗 其一","author":"韩淲","text":"相业冰溪望，明公实妙年。\n方看回旧观，乃复閟新阡。\n才学时争美，声华士更传。\n发扬文正谥，尤动九重天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈太平挽诗 其二","author":"韩淲","text":"歌酒追随地，名园记昔游。\n升沉嗟潦倒，哀挽为悲愁。\n自出推王社，友于才郡侯。\n联翩期禁近，何意遽浮休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德源访乳泉问吕紫薇墓","author":"韩淲","text":"我记乳泉路，古桥归德源。\n寺何知雅俗，僧仅可寒温。\n砌断藓痕涩，崖枯尘迹昏。\n紫薇青嶂合，秋树叶初翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"监仓赵十忠训挽诗 其一","author":"韩淲","text":"先契俄三世，新交仅七年。\n于中虽断落，方始要周旋。\n志勇科名换，身劳疾病缠。\n寿藏留石窆，耆彦定铭镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"监仓赵十忠训挽诗 其二","author":"韩淲","text":"经史閒常说，诗文喜或编。\n见贤知尚友，忧国问筹边。\n宗室多名世，庄家喜有年。\n崇公元盛大，郡从已腾骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻诗按酒","author":"韩淲","text":"拔卒寻诗将，同朋按酒兵。\n巢由空自洗，沮溺向谁耕。\n城市时来往，乡村日送迎。\n任之多论秀，分矣只编氓。\n上郭如拳大，南溪指掌平。\n醉随吟力去，归隐紫云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵倅","author":"韩淲","text":"老去怀玄英，冠尘已满缨。\n宦游虽降志，栖遁实留情。\n幸以此身在，何由得眼明。\n相家逢别驾，仕路合专城。\n敢谓融尊满，而同孔盖倾。\n不嫌林竹迥，却爱石泉清。\n举扇风襟豁，停杯月面轻。\n银潢泻天派，诗就玉绳横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑盱眙","author":"韩淲","text":"羊陆规模远，龚黄政事多。\n剖符欣委寄，视篆欲如何。\n秋入江湖道，寒生淮泗波。\n提封新保障，对境旧山河。\n吏蠹应铨择，民穷藉抚摩。\n蕃宣归俎豆，盟好戢干戈。\n才大知谁识，诗成想自哦。\n风云尝负剑，雨露忆鸣珂。\n缓带从簪履，凝香接绮罗。\n雅怀今郑谷，壮略古廉颇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张礼书帅隆兴","author":"韩淲","text":"国是古难定，公胡亦帅藩。\n荣怀虽禁路，雅志已丘园。\n在昔从诸老，于今盛一门。\n便藩方异渥，勇退复明恩。\n家学资经纬，儒科得本原。\n等閒为出处，何必较腾骞。\n致主丹心在，忧时素发繁。\n纷纭诚虮虱，变化任鹏鹍。\n华阁犹前席，洪都漫左轓。\n建牙仪甚伟，分屏望还尊。\n持橐嘉谋略，横经妙讨论。\n皂囊怀直节，青琐务忠言。\n紬史知无隐，明刑信不冤。\n治才和上下，力可正乾坤。\n收敛当侯阃，迢遥远帝阍。\n九迁由简拔，三入匪趋奔。\n落落终难合，悠悠实易昏。\n归应思贺监，到日记陈蕃。\n自叹驱驰困，谁能顾盼温。\n春风动行李，只有梦随轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西山道院立春日","author":"韩淲","text":"春风吹我上箯舆，山路梅花已雪如。\n道院闲寻旧题句，故人不寄一行书。\n物华满眼知春至，世事装怀逼岁除。\n犹喜重来有佳伴，何妨相送入樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚春","author":"韩淲","text":"幽砌疏畦送晚春，水流山静见闲身。\n行吟散去风光好，熟睡醒来雨气新。\n木笔岂非浓意态，石楠终是淡精神。\n莺声圆处鹃声急，景物要之不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日","author":"韩淲","text":"纷如残雪堕梅梢，门外春光入柳条。\n岁事肯随人意改，时情空使客魂销。\n山围古屋地还僻，水拍孤城滩复高。\n鸥汎鸟鸣声自好，一巾华发任萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惜春","author":"韩淲","text":"惜春惟付酒杯深，不特年龄老鬓侵。\n花柳共随人酩酊，轩裳祇觉我?嵚。\n数家突兀迷深谷，一涧连横出茂林。\n行遍东邻与西舍，弄云初日见啼禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日","author":"韩淲","text":"人日春来又两宵，梅花开尽已飘摇。\n爱闲多病有谁问，偶景独游无自焦。\n门外溪山犹浅浅，床头书册谩昭昭。\n细看荣辱云翻雨，未抵幽栖水一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熟食日","author":"韩淲","text":"清明寒食牡丹红，江右无人记洛中。\n随分曲栏皆一种，任他荒径亦成丛。\n百年流落推迁景，一代兴隆造化功。\n谁识名花有姚魏，数枝单叶倚晴风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十九日寒食","author":"韩淲","text":"晓色濛濛淡淡烟，花间行过小溪边。\n人家寒食当晴日，野老春游近午天。\n吹尽海棠无步障，开来山柳有堆绵。\n呼儿觅友寻邻伴，即看村农又下田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明 其一","author":"韩淲","text":"欲赋春华状不成，微风微雨又清明。\n残花满地偏饶笑，高柳插天如有情。\n百岁光阴诚鼎鼎，一生怀抱强营营。\n相思真隐山前路，寒食酒杯终日晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明 其二","author":"韩淲","text":"小院春阴满槛花，淡红微绿自芳华。\n檐前落日蜂儿聚，帘外东风燕子斜。\n修禊人寻诗事业，清明天与醉生涯。\n一樽莫负流觞意，梦到兰亭兴亦嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重午乏酒戏成","author":"韩淲","text":"小楼清坐意何如，休沐虽闲叹索居。\n解粽未忘良夜饮，研朱犹作午时书。\n风生暝色天横幕，云捲晴光月吐梳。\n朗诵离骚抚空案，独醒笑杀楚三闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重午","author":"韩淲","text":"年年重午泛菖蒲，儿女搔头亦篆符。\n忍复研朱如羽客，懒能切玉醉狂夫。\n长歌楚些冤何有，却忆山人讽已无。\n田里萧萧方渴雨，小轩清望老怀孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕次韵仲至","author":"韩淲","text":"钩月迷云殢柳梢，雷声收雨转晴宵。\n从教冠盖填京国，得似儿童绕市桥。\n玉漏沈沈传底恨，银河耿耿泻无聊。\n政须百巧从天乞，懒和闲吟听夜潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"韩淲","text":"今年七夕最凄凉，谩埽天阶试炷香。\n犹使儿童觅瓜果，懒随风俗晒衣裳。\n缑山何在归寥廓，河鼓传闻堕渺茫。\n百拙已成那得巧，年丰只欲更时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日 其一","author":"韩淲","text":"老眼当今万景随，登台殢酒不关诗。\n从教四野风烟合，未必荒园草木知。\n玉岫插天开岳顶，水波流月照江湄。\n一巾华发吾何醉，故旧携壶汎菊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日 其二","author":"韩淲","text":"酒不沾唇菊又华，荒苔何处落乌纱。\n微官汩没其谁问，多病尪羸只自嗟。\n山绕层城明落木，江连孤屿涨平沙。\n空馀能赋登高意，一笑西窗日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日列岫","author":"韩淲","text":"试倾浊酒汎黄华，节物于人自可嘉。\n一上荒台供远目，更邀闲客堕乌纱。\n萧萧霜树明晴昼，隐隐烟汀入暮霞。\n醉里只多今古意，要知秋色在山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日不饮","author":"韩淲","text":"风光流转又重阳，午梦初回意愈伤。\n时序肯随人境异，江山空对晚天长。\n年华冉冉秋将老，物色班班菊自香。\n虽少一觞还一咏，恍然身世立苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日破晓携儿侄上前山伫立佳甚","author":"韩淲","text":"怀玉镜台开远晴，灵溪葛水去无声。\n园荒不碍凭高立，径侧何须委曲行。\n露气已浓清可掬，日华初上画难成。\n闲居九日依辰至，举俗胡为亦爱名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫九日","author":"韩淲","text":"薄寒中人秋气清，山能高绝水能平。\n独怜佳节迫吹帽，谁可东篱嗅落英。\n尽道诗家有昌甫，每逢胜处说渊明。\n鬓毛垂领萧萧白，应任雨风阴复晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕呈仲至","author":"韩淲","text":"小至才看语夜深，岁除寒雪复关心。\n交游每叹难同话，亲旧相逢且自寻。\n爆竹尽教邻巷响，屠酥先付小儿斟。\n崇朝又是春风起，急景何由不缓吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初六日","author":"韩淲","text":"开年逐夜闻山雨，阵阵声催一样春。\n孤枕自听元不恶，虚檐谁谓便能新。\n门前有客尤全美，园里无梅益固珍。\n水活正添幽涧渌，草生纤嫩亦初匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月十三日","author":"韩淲","text":"南山春雪未全消，路并浮梁步石桥。\n深绿渐归高柳叶，浅红初上小梅梢。\n峭寒寺院钟声起，昏暮人家烛影摇。\n一夜东风吹酒醒，梦回花月是元宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十五日晴窗","author":"韩淲","text":"绛霄谁复记宣和，灯市钱塘未觉多。\n香动软红迷锦绣，醉扶娇翠入笙歌。\n南来渐向百年久，北望其如前日何。\n门外儿童正呼笑，小窗晴色且吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月一日","author":"韩淲","text":"一山春雪见梅花，渌涨沟流浸草芽。\n纵著峭寒虽较冷，不禁暄日便争华。\n游蜂未放迷深树，回雁初归泊浅沙。\n步转横桥已孤绝，奈吹香处隔邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十二日","author":"韩淲","text":"年过半百身何用，犹有春来不世情。\n夹岸桃红仍柳绿，漫山月白与风清。\n狂朋怪侣难收拾，騃女痴儿易长成。\n老把一杯生日酒，待呼沮溺耦而耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十六日","author":"韩淲","text":"雨雪绵绵春欲深，鹅湖石井旧登临。\n经行为我踌躇立，俛仰知谁放旷吟。\n高爽山川无起灭，卑喧人物有升沈。\n青鞋布袜茅柴酒，花柳中边惜此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月初二日","author":"韩淲","text":"杨柳阴阴上小楼，窗中远岫夕阳浮。\n棋声竞处偏饶笑，酒味醺时未肯休。\n多病故应惊独老，一閒消得许多愁。\n清和莫放春归去，好事人须惜此游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]