[{"title":"方广圣灯次敬夫韵","author":"林用中","text":"灯长三世火长明，千里遗踪子细寻。\n自是神光能永夜，不妨金偈更降心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方广奉怀定叟","author":"林用中","text":"相从偶到招提寺，独对西风忆羽人。\n澹泊烟霞深处卧，百年衣钵此生身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方广版屋","author":"林用中","text":"上方古栋宇，年久自参差。\n动我行人想，相看各赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方广道中半岭少憩次敬夫韵","author":"林用中","text":"岭峻山高且息肩，芒鞋踏破野云烟。\n须臾直入上方去，又是乾坤一洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石廪峰次敬夫韵","author":"林用中","text":"石廪峰高直插天，芳名耿耿旧流传。\n好推佳惠敷寰宇，始信人间大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后洞雪压竹枝横道","author":"林用中","text":"山中景物自新奇，乘兴幽人写小诗。\n洞里竹枝遭雪压，何人扶起向明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自上封下福岩道旁访李邺侯书堂山路榛合不可往矣遂赋此","author":"林用中","text":"百年古路已成荒，今日人称相国堂。\n麟凤已归天上去，空留遗像在斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行林间几三十里寒甚道旁有残火温酒举白方觉有暖意次敬夫韵","author":"林用中","text":"高山绝顶雪千堆，凛裂冰肤这几回。\n行到林间得残火，借它燃烬暖寒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿方广闻长老守荣化去敬夫感而赋诗次韵","author":"林用中","text":"上方长老已寻真，禅室空存锡杖新。\n自是屋梁留夜月，可怜飘泊系留身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜得岳后庵僧家园新茶甚不多辄分数碗奉伯承","author":"林用中","text":"芽吐金英风味长，我于僧舍得先尝。\n饮时各尽卢仝量，去腻除繁有远香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳后步月","author":"林用中","text":"转缺霜轮出海边，故人千里共婵娟。\n山阴此夜明如练，月白风清人未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林间残雪时落锵然有声赋此","author":"林用中","text":"天花乱落类琼瑶，游赏行人觉路遥。\n林畔残枝犹被压，数声佩玉遍青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将下山有作","author":"林用中","text":"昔日乘舆住此山，爱山五日住山间。\n今朝忽动思归兴，得伴先生杖屦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枯木","author":"林用中","text":"数年抱叶不萌芽，终岁淹淹绝藓花。\n廊庙大材工舍用，何须把节向人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残雪未消","author":"林用中","text":"冻压林巢欲堕鸦，素花飘落结烟霞。\n阴风惨淡青山老，不辨梅花与雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉声","author":"林用中","text":"穿云络日苦悲吟，涧底潺潺觅好音。\n弦管笙簧寒碎玉，源头深处细追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲花峰次敬夫韵","author":"林用中","text":"十丈花开自白莲，峰头花色更鲜妍。\n分明会得濂溪趣，强作新诗续古篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崖边积雪取食清甚次敬夫韵","author":"林用中","text":"崖边琼玖吐清光，偶到山间得味尝。\n一段奇香今已会，冰牙冷齿裂人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚霞","author":"林用中","text":"晚霞掩映祝融峰，衡岳高低烂熳红。\n愿学陵阳修炼术，朝餐一片趁天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪消溪涨见山色可喜口占","author":"林用中","text":"雪消山色自青青，水涨溪流拍小汀。\n行客悠悠心目快，漫题新句在空屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡兴乐江望祝融","author":"林用中","text":"今日溪云迷小槎，层层锦浪映晴霞。\n须臾直至前村去，遥望群峰真可誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登山有作次敬夫韵","author":"林用中","text":"壁立崔嵬不计寻，千峰罗列献奇深。\n等闲伫立遥观遍，流水高山万古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋罗汉果","author":"林用中","text":"团团硕果自流黄，罗汉芳名托上方。\n寄语山僧留待客，多些滋味煮成汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过高台获信老诗集","author":"林用中","text":"今朝移步野云端，幸得新诗读夜阑。\n识破中间真隐诀，月明风雪道休寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中景物甚胜吟赏不暇敬夫有诗因次其韵","author":"林用中","text":"天外云端磬有声，道中景物信增新。\n徘徊吟赏天将暮，好向平原问主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"福岩寺回望岳市","author":"林用中","text":"福岩宝地几千年，宫殿朦胧锁暮烟。\n游客回头怀想望，自知身在寂寥天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"福岩寺读张南湖旧诗","author":"林用中","text":"名公有意著新书，翰墨精神碧玉姿。\n今日山中才读罢，经行已续少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉下祝融峰","author":"林用中","text":"祝融高处怯寒风，浩荡飘凌震我胸。\n今日与君同饮罢，愿狂酩酊下遥峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壁间古画精绝未闻有赏音者赋此","author":"林用中","text":"老树参横傍古阴，浓烟淡月试追寻。\n自来无会丹青意，可惜良工苦片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜月","author":"林用中","text":"雪霁云收月满天，冰轮碾转净无烟。\n几回寒色侵人冷，底信清光永夜娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次敬夫登定王台韵","author":"朱熹","text":"今朝风日好，抱病起登台。\n山色愁无尽，江波去不回。\n客怀元老草，节物又疏梅。\n且莫催归骑，凭栏更一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五日再登祝融峰用台字韵","author":"林用中","text":"惆怅独徘徊，晴岚绕古台。\n日从东海上，人自北山回。\n峰老曾经雪，天寒不放梅。\n野僧怜我倦，相观酒盈杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六日下山各赋二篇以纪时事云","author":"林用中","text":"匹马返归程，天寒雪眼明。\n无穷身外事，难了世间情。\n客向天边去，风含玉佩声。\n别离与僧约，明岁再来迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后洞山口晚赋","author":"林用中","text":"西岭更西路，云岚最窈深。\n水流千涧底，树合四时阴。\n更得寻幽侣，何妨拥鼻吟。\n笑看云出岫，谁似此无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自方广过高台赋此","author":"林用中","text":"山云迷古寺，曙色照孤城。\n禅境风偏好，空门眼倍明。\n逢僧叙旧话，对客结新盟。\n□□□□□，□□□□生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自西园登山宿方广寺","author":"林用中","text":"登山极目望，梵宇自鲜明。\n风度闲花落，云低野树清。\n夜长人不寐，地僻月初生。\n明发又归去，何能已此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡文广仲与范伯崇自岳市来同登绝顶举酒极谈得闻比日讲论之乐","author":"林用中","text":"自得中峰住，怜君冒雪来。\n共登福岩寺，齐上古层台。\n斗酒酬佳兴，诗怀喜独开。\n飘然尘世隔，谈论转堪哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登定王台","author":"朱熹","text":"寂寞番君后，光华帝子来。\n千年馀故国，万事只空台。\n日月东西见，湖山表里开。\n从知爽鸠乐，莫作雍门哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登山回","author":"林用中","text":"胜概峰头寺，寻幽客自来。\n泉声涧分细，山色翠成堆。\n踏破千崖雪，还闻一夜雷。\n东林期拟结，卧石梦忘回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题福岩寺","author":"林用中","text":"久慕云间寺，相从此日来。\n山僧留客坐，野老把松栽。\n地拱千寻险，天遮四面开。\n殷勤方外望，尘事不胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠上封诸老","author":"林用中","text":"上封台观静，夕霁景偏清。\n月下闻禅语，风中有磬声。\n龙池留古迹，雁塔寄馀情。\n借问房前树，东窗忽偃生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方广寺睡觉次敬夫韵","author":"林用中","text":"寒溜山房太惨情，夜长枕畔听泉声。\n起来独自浑无语，牢落凄凉澹泊清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同游岳麓道遇大雪马上次敬夫韵","author":"林用中","text":"遥瞻衡岳顶，云尽碧参差。\n人从南方至，雪坠西崖垂。\n谈玄问老子，鸣佩邀神妃。\n飞花舞琼瑶，青壁比珠玑。\n平生山水兴，行止只自知。\n飘飖凌浩荡，犹恐太白低。\n松持岁寒操，梅放冰雪姿。\n迢递昆崙颠，俯仰动遐思。\n兹峰名天下，突兀真绝奇。\n行行将易晚，去去尚追随。\n我爱君饮酒，君爱我赋诗。\n相看各惆怅，勉旃在明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游南岳风雪未已决策登山用春风楼韵","author":"张栻","text":"人言南山巅，烟云耸楼观。\n俯瞰了坤倪，仰攀接天汉。\n勇往愧未能，长吟湘水畔。\n兹来渺遐思，风雪岂中断。\n行行重行行，敢起自昼叹。\n我闻精神交，石裂冰可泮。\n阴沴驱层霄，杲日丽旭旦。\n决策君勿疑，此理或通贯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登祝融口占","author":"林用中","text":"托身天际外，寄足在云端。\n俯仰心犹壮，登临眼尽宽。\n乾坤真景界，风雪倍朝寒。\n忽起烟霞想，相从结大还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题福岩寺 题南台","author":"林用中","text":"山高耸楼观，天际有瑶台。\n地僻烟霞静，门空云雾开。\n舆图真绝域，形胜实崔巍。\n久以平生慕，今年始得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游翠阴洞和朱履常韵","author":"林石","text":"松桂擢危岑，烟云昼亦阴。\n洞门虽不锁，谁测洞中深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雨潭","author":"林石","text":"去夏曾同潭上游，荫松坐石濯清流。\n论文声杂飞泉响，话道心齐邃谷幽。\n盛暑忽思寻旧好，烦襟顿觉似新秋。\n也知关决多馀暇，能更重为胜赏不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登福全山","author":"林石","text":"尝闻陶隐居，经行到兹地。\n君王屡飞诏，高尚心愈厉。\n一幅画双牛，谁人知此意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答王学士","author":"林昉","text":"已著山人屐，那能远入城。\n艰难思变姓，老大畏争名。\n病叶兼虫响，闲云肯雨行。\n长怀陶靖节，出处意分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜溪行怀富沙友","author":"林石涧","text":"溪光清浅碎琼瑶，杨柳风柔酒渐消。\n犹忆去年今夜月，照人同上水西桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏笔","author":"林石涧","text":"碧云芳草两悠悠，望断天涯此倚楼。\n莫遣闲愁似江海，潮生潮落几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏","author":"林石涧","text":"蓂荚阶前日月飞，羹墙惆怅望尧眉。\n三千年笑巢由错，不见勋华揖逊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中怀槐坡丹品","author":"林石涧","text":"昔同诗伴结清游，乱折梅花当酒筹。\n十二阑干风雪里，玉人扶醉下西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人西上","author":"林石涧","text":"祖席歌云散，春风助马飞。\n到京三月尽，为客几时归。\n雨驿梨花瘦，烟村荻笋肥。\n倚门有慈母，莫负老莱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潮后","author":"林石涧","text":"潮后菰蒋半带泥，隔林遥听午时鸡。\n江天漠漠云帆远，野日荒荒春鸟啼。\n石壁倒垂枯树老，沙田平接乱山低。\n经行好处须摹取，收入诗囊付小奚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕","author":"林石涧","text":"年年因社到，海阔翅飞低。\n故国伤新别，空梁忆旧栖。\n暮帘疏竹雨，春岸落花泥。\n红线今何在，香愁满绣闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"林乔","text":"醮坛夜朝斗在目，石室昼卧云生胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"林乔","text":"斗州无顿閒身处，时向梅花走一遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日下水","author":"林亦之","text":"黄花时候苦思乡，急水还家一日强。\n不道南风打头上，客船摇橹作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小练林承事挽词二首 其二","author":"林亦之","text":"生前莫问刘郎浦，死后还看孟母邻。\n遥想刍灵穿海出，浪头如屋自愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小练林承事挽词二首 其一","author":"林亦之","text":"薤歌才唱已堪嗟，莫道生平隔海涯。\n曾向网山图上见，蛇门东去是君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方提举公美挽词","author":"林亦之","text":"马上姿容河朔风，吁嗟不见夕阳红。\n长江自小为邻舍，昨日归来无此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢氏母挽词二首 其二","author":"林亦之","text":"小径幽幽竹绕门，闺楼终日总无言。\n若教诵得维摩句，应愧平生费讨论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢氏母挽词二首 其一","author":"林亦之","text":"为语歌铃过野田，不须泪眼更悬悬。\n人间催促如风叶，谁是平头八十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢助教质夫挽词二首 其二","author":"林亦之","text":"毗耶钞轴五千卷，净几焚香心自閒。\n蜡烛烧残春梦断，逢逢哀鼓吊空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢助教质夫挽词二首 其一","author":"林亦之","text":"山中香火今谁在，那听残春薤曲新。\n第一伤心惟此老，父时诸客已无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"艾轩先生侍郎挽词四首 其四","author":"林亦之","text":"黄柑时候曲堆村，长忆篮舆到荜门。\n恰是今年去年日，野萤衰草吊寒原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"艾轩先生侍郎挽词四首 其三","author":"林亦之","text":"绣衣曾出黄梅岭，金印还游红药阶。\n勋业至今人道说，幽怀长是在空斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"艾轩先生侍郎挽词四首 其二","author":"林亦之","text":"菖蒲对客尚从容，明月红泉梦已空。\n纵是千年有豪杰，六经人物只斯翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"艾轩先生侍郎挽词四首 其一","author":"林亦之","text":"典刑还似鲁人初，四海衣冠归坐隅。\n涕落寒芜嗟不见，月明蟹井白云孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"记九月二十五夜梦中作","author":"林亦之","text":"药圃幽人径，桃源处士居。\n岁时虽屡改，踪迹尚如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光泽朱君挽词四首 其四","author":"林亦之","text":"乃翁飞旐过前村，一妇随车一在门。\n何处人家有三柩，髑髅山下合销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光泽朱君挽词四首 其三","author":"林亦之","text":"为官长者得声名，唯诺公堂如父兄。\n欲作汝南耆旧传，不须多语尽平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]