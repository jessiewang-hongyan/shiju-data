[{"title":"颂古十九首 其十七","author":"释法全","text":"西天人不会唐言，旱地雷声彻大千。\n九年面壁无人会，玉兔金乌火里旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十六","author":"释法全","text":"八十翁翁著绣靴，踏开幽洞笑呵呵。\n傍人指点忘归路，不觉腰间烂斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十五","author":"释法全","text":"石火光中烂熳游，白拈临济未同俦。\n掀反华岳连天黑，几个知身在御楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十三","author":"释法全","text":"七里滩头多蛤子，太阳一出口俱开。\n平生肝胆虽然露，狡鹘何曾逐臭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十","author":"释法全","text":"相逢把手上高峰，四顾寥寥天宇空。\n一曲渔歌人不会，芦花飞起渡头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其五","author":"释法全","text":"天高地厚寻常事，海阔山重更要论。\n霹雳震摧山鬼窟，独携霜剑定乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其二","author":"释法全","text":"布鼓当轩为击来，卧龙惊起出岩隈。\n千峰秀色凭谁写，一带澄江古镜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十四","author":"释法全","text":"耳里种田，满口含烟。\n钟馗解舞十八拍，张老乘槎上九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十二","author":"释法全","text":"钵里饭，桶里水，狗子咬人不露齿。\n堪笑韶阳老古锥，倒地至今犹未起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十一","author":"释法全","text":"驴觑井，井觑驴，冬瓜叶上长葫芦。\n会不得，莫踟蹰，定盘星上绝锱铢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其九","author":"释法全","text":"东司上不说佛法，唤来与伊劈面踏。\n不用重论报佛恩，将此深心奉尘刹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其八","author":"释法全","text":"狗子佛性无，斫额路上逢子湖。\n业识性在遭一口，大地全无碧眼胡。\n狗子佛性有，春风吹动千株柳。\n知而故犯可怜生，一一面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其七","author":"释法全","text":"日暖风和莺啭新，柳垂金线系东君。\n东君不惜无私力，一点花红一点春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其六","author":"释法全","text":"当门一脉透长安，游子空嗟行路难。\n不是人前誇俏措，金锤击碎万重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其四","author":"释法全","text":"乱撒明珠颗颗晶，走盘应不贵金声。\n谁家女子能针线，一串穿来不剩星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其三","author":"释法全","text":"遍身是，通身是，净洁浑身涴却屎。\n拽来露出猛风吹，谁教背手摸枕子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其一","author":"释法全","text":"昨夜深沙铸铁券，阿那律陀来合伴。\n醉来相打见阎王，阎王握笔不能判。\n不能判，却相劝。\n彼此事同一家，更莫前思后算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山光寺","author":"释法芝","text":"扁舟乘兴到山光，古寺临流胜气藏。\n惭愧南风知我意，吹将草木作天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释法芝","text":"淡游聊得慰孤闷，谁问当年寄老心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞众偈","author":"释法祚","text":"七十七年，幻缘忽破。\n秋水无痕，霜天月堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释法言","text":"林下闲看水牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释法周","text":"地因培客土，凡草有时生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释法宝","text":"千般言，万种喻，只要教君早回去。\n夜来一片黑云生，莫教错却山前路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释法明","text":"资福别无所补，五日一参击鼓。\n何曾说妙谈玄，祇是粗言直语。\n甘草自来甜，黄连依旧苦。\n忽若鼻孔辽天，逢人切忌错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙马洞","author":"释法显","text":"汗血何时别大宛，一嘶洞府已千年。\n区区汉武求良药，却是闲中骏骨仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其七","author":"释法泉","text":"非佛非心徒拟议，得皮得髓谩商量。\n临行珍重诸禅侣，门外千山正夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其十三","author":"释妙伦","text":"团团离海峤，渐渐出云衢。\n此夜一轮满，清光何处无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答东坡居士","author":"释法泉","text":"指出明明是甚么，举头鹞子穿云过。\n从来这碗最希奇，解问灯人能几个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼赵清献公抃","author":"释法泉","text":"仕也邦为瑞，归欤世作程。\n人间金粟去，天上玉楼成。\n慧剑无纤缺，冰壶彻底清。\n春风瀔水路，孤月照云明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北邙行","author":"释法泉","text":"前山后山高峨峨，丧车辚辚日日过。\n哀歌幽怨港岩谷，闻者潜悲薤露歌。\n哀歌一声千载别，孝子顺孙徒泣血。\n世间何物得坚牢，大海须弥竟磨灭。\n人生还如露易晞，从来有会终别离。\n苦乐哀感不暂辍，况复百年惊梦驰。\n去人悠悠不复至，今人不会古人意。\n栽松起石驻墓门，欲为死者长年计。\n魂魄悠扬形化土，五趣茫茫井轮度。\n今人还葬古人坟，今坟古坟无定主。\n洛阳城里千万人，终为北邙山下尘。\n沈迷不记归时路，为君孤坐长悲辛。\n昔日送人哭长道，今为孤坟卧芳草。\n妖狐穿穴藏子孙，耕夫拨骨寻珠宝。\n老木萧萧生野风，东西坏冢连晴空。\n寒食已过谁享祀，冢畔馀花寂寞红。\n日月相催若流矢，富贵贤愚尽如此。\n安得同游常乐乡，纵经劫火无生死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送东坡居士","author":"释法泉","text":"脚下曹溪去路通，登堂无复问幡风。\n好将钟阜临歧句，说似当年踏碓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其六","author":"释法泉","text":"快人一言，快马一鞭。\n若更眼睛定动，未免纸裹麻缠。\n脚下是地，头上是天。\n不信但看八九月，纷纷黄叶满山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其五","author":"释法泉","text":"文殊笑，普贤嗔，眼里无筋一世贫。\n相逢尽道休官去，林下何曾见一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其四","author":"释法泉","text":"时人欲识南禅路，门前有个长松树。\n脚下分明不较多，无奈行人恁么去。\n莫恁去，急回顾，楼台烟锁钟鸣处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其三","author":"释法泉","text":"要去不得去，要住不得住。\n打破大散关，脱却娘生裤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈七首 其一","author":"释法泉","text":"来不来，去不去。\n脚下须弥山，脑后擎天柱。\n大藏不能宣，佛眼不能觑。\n诸禅德，渐老逢春解惜春，昨夜飞花落无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释法恭","text":"腊月烧山，对面热谩。\n瞥然悟去，身在长安。\n咄哉无限未归客，沙里求油实可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释法恭","text":"五天一只蓬蒿箭，搅动支那百万兵。\n不得云门行正令，几乎错认定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释法恭","text":"见得彻，用时亲，相逢尽是个中人。\n望空雨宝休誇富，无地容锥未是贫。\n踏著秤磓硬似铁，八两元来是半斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释法恭","text":"春风杨柳眉，春禽弄百舌。\n一片祖师心，两处俱漏泄。\n不动步还家，习漏顿消灭。\n暗投玉线芒，晓贯金针穴。\n深固实幽远，无人孰辨别。\n惭愧可怜生，头头皆合辙。\n不念阿弥陀，南无乾屎橛。\n无智痴人前，第一不得说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释法恭","text":"头祖才始升堂，百丈卷席归去。\n不是拾得寒山，有理也无雪处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时般若 其一","author":"释法泰","text":"日暖风和天地春，野华芳草一翻新。\n灵山佳致依然在，谁是当年微笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时般若 其四","author":"释法泰","text":"林木萧条复本根，严霜冻雪锁松门。\n地炉煨火通身暖，寒暑到来休更论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时般若 其二","author":"释法泰","text":"万木扶疏夏景长，园林梅杏嚼红香。\n山前麦熟还知否，一一当机为举扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时般若 其三","author":"释法泰","text":"飘飘黄叶坠幽庭，万里无云宇宙清。\n飒飒凉飙生户外，韶阳三句转分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其十二","author":"释法泰","text":"多子塔前衣付后，更传何物示于人。\n双珠迸出刹竿倒，直得寒光彻四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其十","author":"释法泰","text":"树倒藤枯意若何，沩山开口笑呵呵。\n可怜三尺龙泉剑，唤作陶家壁上梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其九","author":"释法泰","text":"商岭东西路不分，两间茅屋一溪云。\n师年耳聩知师意，人是人非不欲闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其七","author":"释法泰","text":"应用从来不覆藏，当机何得昧真常。\n只知报道王来也，不觉浑身在帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其五","author":"释法泰","text":"子卿不下单于拜，始末常遵汉帝仪。\n雪后乃知松柏操，事难方见丈夫儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其四","author":"释法泰","text":"十分风采露堂堂，玉蕊琼华未比量。\n刚被傍人论好丑，因兹难嫁与潘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其二","author":"释法泰","text":"三脚驴子弄蹄行，步步莲华衬足生。\n堪笑草中寻觅者，不知芳树啭新莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十四","author":"释法泰","text":"西天人不会唐言，端坐巍巍少室前。\n刚被流支打齿缺，至令有理不能宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四十一","author":"释法泰","text":"风前露出无瑕璧，室内擎将如意珠。\n两度献渠渠不识，可怜流落在江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十八","author":"释法泰","text":"明镜当台湛如水，无端特地起尘埃。\n积成山岳面前立，千手大悲擘不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十七","author":"释法泰","text":"凉风落木楚山秋，满树寒蝉噪不休。\n红蓼白蘋开两岸，不知谁在钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十四","author":"释法泰","text":"白纸三张通信去，展开千里却同风。\n阳春转入胡笳曲，不是风吹别调中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十二","author":"释法泰","text":"一拳拳倒黄鹤楼，一趯趯翻鹦鹉洲。\n幸有傍人为著力，自家端坐看扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其三十","author":"释法泰","text":"垂钩四海钓狞龙，格外玄谈知己从。\n相见披衫带席帽，不妨把手上高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十九","author":"释法泰","text":"高楼美女一双双，各向琼窗坐玉床。\n绣出鸳鸯呈似了，金针深插锦香囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十八","author":"释法泰","text":"窣堵波成赏匠人，工钱一二与三文。\n可怜眼里无筋者，当面定将数目分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十七","author":"释法泰","text":"嵯峨万仞是曹山，气岸雄雄坐祖关。\n横按镆铘全正令，太平寰宇斩痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十三","author":"释法泰","text":"白衣拜相喜难加，暂时流落向天涯。\n移身换步人难用，夜来归宿五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其二十一","author":"释法泰","text":"皮裹骨兮骨裹皮，分明道了复何疑。\n拈起草鞋如未委，不如别处且乌龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十九","author":"释法泰","text":"溪边嫩柳条条绿，陌上桃花树树红。\n勿谓东君无管带，更加暖日与和风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十八","author":"释法泰","text":"打破当年山鬼窟，豁开正眼耀乾坤。\n三拳肋下无多子，一喝雷轰迸海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十七","author":"释法泰","text":"病餐毒药访良医，医使元餐药治之。\n病去药回滋味别，舌头具眼者方知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十六","author":"释法泰","text":"等闲施设岂徒然，平地波澜欲浸天。\n更向胡梯敲数下，免教失脚堕黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十四","author":"释法泰","text":"宗师垂手贵天真，肯事雕虫篆刻新。\n只向平田浅草处，等闲推出玉麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其十二","author":"释法泰","text":"试问田中有几人，插锹叉手意分明。\n可怜不逐南山去，撒手归家罢问程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其六","author":"释法泰","text":"朱沙镜里开颜笑，白玉盘中展脚眠。\n大抵人生难得共，得团圆处且团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十四首 其四","author":"释法泰","text":"堂堂妙相绝锱铢，善恶都忘见也无。\n万里云收天界净，海心无浪月轮孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其十一","author":"释法泰","text":"幽鸟语如篁，柳垂金线长。\n少林传底事，对面不囊藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞达磨","author":"释法泰","text":"泛舶来梁自普通，一锤击碎有为功。\n谁云面壁无言说，争奈当门齿露风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其十一","author":"释法泰","text":"有无不问语先堕，明镜当台双照破。\n迷云散尽晓天空，杲日团团红似火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十二首 其八","author":"释法泰","text":"不落因果何曾堕，不昧因果何曾脱。\n当堂镜破两头忘，扫影灭踪无摸索。\n无摸索，何倚托。\n秋风吹梧桐，树叶鸣嚗嚗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]