[{"title":"端正好 其三","author":"杜安世","text":"露落风高桐叶坠。\n小庭院、秋凉佳气。\n兰堂聚饮华筵启。\n罢令曲、呈珠缀。\n晚天行云凝香袂。\n新声内、分明心意。\n玉炉初喷檀烟起。\n敛愁在、双蛾翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端正好 其四","author":"杜安世","text":"野禽林栖啾唧语。\n闲庭院、残阳将暮。\n兰堂静悄珠帘窣。\n想玉人、归何处。\n喜鹊几回薄无据。\n愁都在、双眉头聚。\n凄凉方感孤鸳侣。\n对夜永、成愁绪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其四","author":"杜安世","text":"闲院秋千，又还拆了。\n绿苔遍地青春老。\n画楼日晚燕归巢，红稀翠盛梅初小。\n窈窕身轻，怎禁烦恼。\n罗衣渐减怯风峭。\n韶华好景想多才，厌厌只为书音少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其二","author":"杜安世","text":"夜雨朝晴，东风微冷。\n雕梁燕子闲相并。\n后园次第数芳菲，千香百艳年年定。\n步险楼高，人赊途迥。\n烟芜冉冉斜阳暝。\n红笺写尽寄无因，想伊不信人成病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其三","author":"杜安世","text":"嫩柳成阴，残花双舞。\n尘消院落新经雨。\n洞房深掩日长天，珠帘时有沈烟度。\n夜梦凄凉，晨妆薄注。\n香肌瘦尽宽金缕。\n到头终是恶因缘，当初只被多情误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤冲天","author":"杜安世","text":"清明天气。\n永日愁如醉。\n台榭绿阴浓，薰风细。\n燕子巢方就，盆池小，新荷蔽。\n恰是逍遥际。\n单夹衣裳，半栊软玉肌体。\n石榴美艳，一撮红绡比。\n窗外数修篁，寒相倚。\n有个关心处，难相见、空凝睇。\n行坐深闺里。\n懒更妆梳，自知新来憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕归梁","author":"杜安世","text":"风摆红绦卷画帘。\n宝鉴慵拈。\n日高梳洗几时忺。\n金盆水，弄纤纤。\n髻云松亸衣斜褪，和娇懒、瘦岩岩。\n离愁更被宿酲兼。\n空赢得，病厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"杜安道","text":"晓镜初妆玉粉，轻风暗递幽香。\n闲随月影到寒塘。\n忘却人间天上。\n雪意空惊春意，孤芳已断年芳。\n从教驿使为伊忙。\n乞个寿阳宫样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题灵岩寺","author":"杜尧臣","text":"四绝精蓝冠古今，千山影里寺难寻。\n年来踪迹如萍梗，不得登临恨更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苍岭","author":"杜师旦","text":"休嗟道险未堪行，却到层峦足较轻。\n山险还如心险否，心平履险险仍平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丝瓜","author":"杜汝能","text":"寂寥篱户入泉声，不见山容亦自清。\n数日雨晴秋草长，丝瓜沿上瓦墙生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时思荐福寺","author":"杜汝能","text":"□知山不厌，高处更营亭。\n对面开诗景，当空列画屏。\n药生香草异，盖结古松灵。\n见说师斋暇，时来此读经。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送顾梅山之扬州","author":"杜汝能","text":"高人必见知，已是渡淮迟。\n路远飘零客，囊多绝妙诗。\n早蝉何处听，归棹几时期。\n到定陪吟宴，琼花惜过时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈随隐","author":"杜汝能","text":"父子名相继，如君又出奇。\n乾坤钟秀气，湖海诵新诗。\n放鹤春风远，横琴夜月迟。\n未应随大隐，闲过圣明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杜汝能","text":"闲立绿杨影，交眠红藕花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪 其一","author":"杜耒","text":"晚立苕溪溪上头，往来无数采菱舟。\n采菱归去明朝卖，安识人闻乐与愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪 其二","author":"杜耒","text":"风掠篷窗两鬓秋，生涯无岁不扁舟。\n吟诗本欲相消遣，及到吟成字字愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚","author":"杜耒","text":"穫稻已空霜未落，秋风虽老雁犹迟。\n丹林黄叶斜阳外，绝胜春山暮雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游禅林寺","author":"杜耒","text":"不到禅林又几春，依然风景自清新。\n竹窗松径幽深处，只有黄花认著人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜","author":"杜耒","text":"寒夜客来茶当酒，竹炉汤沸火初红。\n寻常一样窗前月，才有梅花便不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"窗间","author":"许志仁","text":"秋香烂熳入屏帷，金粟楼台富贵时。\n晓起旋收花上露，窗间闲写夜来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小山即事 其二","author":"杜耒","text":"当时尝爱酒，此夕更登楼。\n月有十分好，人无一点愁。\n云山开宿雾，灯火近清秋。\n何事太孤绝，前身是楚囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小山即事 其一","author":"杜耒","text":"一閒殊足乐，物物入吾诗。\n雨过苔逾碧，风来竹屡攲。\n日长思睡急，磨老出茶迟。\n近得边头信，今当六月师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同紫芝宿双岭","author":"杜耒","text":"本作翠岩游，反成双岭留。\n云深山易晚，雨过寺如秋。\n野水连青竹，残僧半白头。\n上方成共宿，剧语到元幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同紫芝游西山","author":"杜耒","text":"几番江上凭栏久，今在西山山里行。\n天遣得随三客后，春来无此一朝晴。\n方穿藤蔓寻源去，忽见烟霏趁步生。\n幽鸟向人作清哢，似应知我有诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱令招作社献","author":"杜耒","text":"閒官得趁宰官行，农务村村早办耕。\n燕子知时还记旧，社公合雨却成晴。\n登坛饮福虽无称，割肉怀归似有情。\n宿露尽披山历历，卖花人起欲天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴太博赴莆中","author":"杜耒","text":"贵为五马只儒酸，都说先生大耐官。\n去国十年虽已久，爱君一念不曾寒。\n定知前辈如公少，好与今人作样看。\n归日不须囊薏苡，有书堪录荔堪乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季昭窜象郡","author":"杜耒","text":"庐陵一小郡，百岁两胡公。\n论事虽小异，处心应略同。\n有书莫焚稿，无恨岂伤弓。\n病愧不远别，写诗霜月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重宿紫芝","author":"杜耒","text":"书窗隔湖水，寒气倍冯陵。\n集宿因重到，新诗得再承。\n月明山入坐，酒渴夜敲冰。\n为尔二三友，令人去未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌歊台","author":"杜耒","text":"几年听客话凌歊，不似台边目力遥。\n千古江山犹昨日，六宫歌舞自前朝。\n苔碑有字多漫灭，野寺无僧转寂寥。\n碧聚双蛾愁不敛，阑干落照重魂消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游禅寂寺访隐居","author":"杜耒","text":"官閒仍暇日，乘兴共寻芳。\n久雨山蹊润，新晴花气香。\n春偏藏古寺，水渐满閒塘。\n忽有隐居者，留人看海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李少保家传","author":"杜耒","text":"将军忠愤世无双，忍见狂童作假王。\n全蜀不移唐日月，四州重著汉衣裳。\n节旄凛凛风霜在，兄弟班班史传香。\n若使中营星未殒，生擒颉利到龙荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈宗之","author":"杜耒","text":"往年曾见赵天乐，数说君家书满床。\n成卷好诗人借看，盈壶名酒母先尝。\n对河却见桐阴合，隔壁应闻芸叶香。\n老不爱文空手出，从今烦为蓄仙方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子规","author":"杜耒","text":"不论南北与东西，但是春山有子规。\n啼到日边啼未了，何尝劝得二人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"杜耒","text":"酿雪不成微有雨，被风吹散却为晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"杜耒","text":"青灯夜深雨，破帽晓来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"杜耒","text":"生就石桥罗汉面，吟成雪屋阆仙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"杜耒","text":"鸱夷让员滑，混沌惭瘦爽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"杜耒","text":"不画涪翁画李翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"杜耒","text":"尘事分清事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"杜耒","text":"无风花自落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"融州老君洞敕赐真仙岩之图","author":"杜应然","text":"古号黔南今号融，真仙第一胜高嵩。\n仙关标榜门增丽，圣像威灵民敬崇。\n帝赐御书藏宝阁，天生石像老仙翁。\n瓶炉罗列非雕琢，幢盖周围夺巧工。\n足履分明深踏石，仙衣彷佛挂玲珑。\n青牛水畔藏头角，白鹤溪边饮羽㚇。\n狮子像前如拜伏，猿猴梯上若登空。\n龙田龙迹施鳞甲，蛇藏蛇身似锦红。\n罗汉数躯朝向北，斗星七位转回东。\n浮桥伫望金星座，仙径平瞻水月宫。\n丹井千秋泉不竭，芝田万顷草常丰。\n馀清近酌潺潺水，耸翠遥观叠叠松。\n石柱经年坚且直，寿溪度岁淼无穷。\n吕仙隐迹居于壁，□□□容坐得穹。\n彩仗彩仪皆拥护，仙床仙室尽高雄。\n化岩夏月生寒凛，和洞冬天都暖烘。\n棋画台中人弈戏，树生石内月朦胧。\n列三寺观学俱近，会一楼堂像阐洪。\n道院庵中居上道，风雩台畔自生风。\n桥名步扣登融石，楼号鸿音撞巨钟。\n花圃西南前可望，钓台泉石景堪充。\n刘侯布德于融郡，父宿兴祠立寿容。\n广地可容千位客，照天高挂一灯笼。\n洞天要比应难比，福地虽同未肯同。\n一石镌经显居士，万碑题咏称名公。\n想君足迹难穷览，敬为栽诗入画中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杜抑之","text":"雷霆真自地中出，河汉莫从天上翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杜杞","text":"有验如有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集工部句题暖谷","author":"杜汪","text":"作尉穷谷僻，官高何足论。\n温温有风味，忆昔李公存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集杜工部句咏寒亭","author":"杜汪","text":"湖南清绝地，长夏想为情。\n六月风日冷，炎天冰雪生。\n蓬莱如可到，心迹喜双清。\n去郭轩楹敞，幽居不用名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"□韵呈徐□勘□□□","author":"杜汪","text":"规广前贤迹，相期幸有君。\n搜奇辱佳句，纪实待高文。\n古木风长悄，阴崖日易曛。\n何时陪胜赏，举手上霄云。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鄜台","author":"杜纯祐","text":"两载低眉著小冠，一台高筑地平宽。\n向阳花木齐教放，天下无春似此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三姝媚","author":"杜良臣","text":"花浮深岸树。\n迎新曦窗影，细触游尘。\n映叶青梅，记共折南枝，又及尝新。\n驻屐危亭，烟墅杳、风物撩人。\n虹外斜阳留晚，莺边落絮催春。\n心事应辜桃叶，但自把新诗，遍写修筠。\n恨满芳洲，倩晚风吹梦，暗逐江云。\n慢捻轻拢，幽思切、清音谁闻。\n谩有鸳鸯结带，双垂绣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"杜杲","text":"父子俱开国，朝廷不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范孙闲行溪西得梅数花韵 其二","author":"杜知仁","text":"孤根要先觉，一花已后会。\n而况万香中，晚乃誇狂醉。\n东皇兆群物，无物居其最。\n对梅欲著语，当在梅之外。\n君看龙蛇蛰，中有江河沛。\n其元阳复雷，其真岁寒桧。\n于梅观此妙，眼力怜湛辈。\n无能根本求，仅为色香嗜。\n一元无识者，孤真可知矣。\n君独邃玄机，命笔开风气。\n奇哉天根词，与世呼梦寐。\n犹疑转语下，未为梅之至。\n愿闻第一义，更作向上计。\n会有先天翁，当发无极喟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范孙闲行溪西得梅数花韵 其一","author":"杜知仁","text":"寒梅我故人，岁必以文会。\n涴墨尚可覆，未知凡几醉。\n晚乃得此诗，山灵以为最。\n置身风月上，出语色香外。\n驾言孤绝处，坏枝委颠沛。\n悬崖折披竹，断涧强病桧。\n穷交仅如此，过是藐无辈。\n碧眼苦好奇，于焉有深嗜。\n迎长得一花，以为时可矣。\n遂若天下春，笔头顿生气。\n我属闭关日，一枝偕寤寐。\n敢贺微阳来，尚虞坚冰至。\n结束果何在，飘零初不计。\n政恐负岁寒，或为识者喟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又得一绝句","author":"杜范","text":"白句方从万玉妃，安排红袖点春晖。\n一寒自笑无毡客，三酌匆匆早赋归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大龙湫","author":"杜范","text":"半世名闻始见之，洞心无语立多时。\n经行处处皆奇绝，此比诸峰更绝奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小龙湫","author":"杜范","text":"水脉凭高天外来，半空散得万飞埃。\n老龙卧处知何在，唤作灵湫亦漫猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞雪未已可谓佳瑞约判簿判务二丈同登尊经阁","author":"杜范","text":"万顷琼瑶烂不收，从今便合庆来牟。\n与君莫负登临约，不是偷闲作浪游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬申九月初十归自邑中两绝 其一","author":"杜范","text":"雁宿沙头水月明，无端惊起两三声。\n孤飞缥缈知何处，影落寒江浪已平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬申九月初十归自邑中两绝 其二","author":"杜范","text":"风清露肃片云闲，耿耿寒光沐万山。\n满目琼楼高著脚，岂知身复在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天聪洞","author":"杜范","text":"脚力穷时眼力通，层梯倚石上天聪。\n世间无限惟顽石，独此中间透外空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天柱","author":"杜范","text":"削成一柱是何年，屹立当空更不偏。\n我欲借渠成大厦，少陵此意久无传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代菊对","author":"杜范","text":"未有渊明先有我，何人唤我作渊明。\n东篱宛在南山下，谁向秋风管落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处静得梅枝为赠以新诗将之漫次韵以谢","author":"杜范","text":"花与诗人自目成，荷君持赠半寒灯。\n悄然清梦江村里，忘却官身在宛陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石梁","author":"杜范","text":"它山不数碎如拳，有此撑空万古寒。\n好个山中廊庙具，游人浪作石梁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘上舍携酒有诗和其韵 其二","author":"杜范","text":"匆匆岁事又更新，一气初回万木春。\n独有江梅殊未觉，凛然冰雪照诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘上舍携酒有诗和其韵 其一","author":"杜范","text":"数过流年转瞩中，宦尘休更问穷通。\n新诗唤我尘埃梦，孤驿清澄一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘上舍以诗送牡丹并酒和之二首 其二","author":"杜范","text":"纷纷万卉委泥沙，独殿春风自一家。\n珍重白衣相问劳，醉吟佳句醉看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘上舍以诗送牡丹并酒和之二首 其一","author":"杜范","text":"春愁风雨不禁寒，红尽枝头绿已团。\n谁遣佳人伴岑寂，初酣卯酒脸匀丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘百十六兄送梅花大鲫新酒以诗将和其韵四首 其四","author":"杜范","text":"新篘盎盎泻琼晶，照我襟怀彻底清。\n多谢白衣相问劳，举杯无语不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘百十六兄送梅花大鲫新酒以诗将和其韵四首 其三","author":"杜范","text":"暖日浮光深水湄，鱼方掉尾煦晴时。\n巨鳞如掌勤分饷，兴入扁舟动钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘百十六兄送梅花大鲫新酒以诗将和其韵四首 其二","author":"杜范","text":"寒冰为骨玉为精，篱落横斜数点清。\n不见孤山浮动处，岭头折赠若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]