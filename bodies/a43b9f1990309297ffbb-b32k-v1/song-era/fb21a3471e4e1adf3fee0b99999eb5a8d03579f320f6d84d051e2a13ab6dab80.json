[{"title":"三断石","author":"杨备","text":"孙吴纪闻旧刊碑，埋没蟠螭与伏龟。\n惆怅石冈三断在，至今犹似鼎分时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天阙山","author":"杨备","text":"牛头天际碧凝岚，王导无稽示妄谈。\n若以远山为上阙，长安应合指终南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵览古 北渠","author":"朱存","text":"金殿分来玉砌流，黑龙湖彻凤池头。\n后庭花落恩波断，翻与南唐作御沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白都山","author":"杨备","text":"驾鹤骖鸾自古闻，策名仙籍是真君。\n天边旧迹无寻处，满目青山空白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石阙","author":"杨备","text":"双石巍巍慰眼青，满朝珍重佐公铭。\n官城府寺俱灰烬，翻使他人漫涕零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐云观","author":"杨备","text":"上界笙歌下界闻，缕金罗袖郁金裙。\n倚阑红粉如花面，不见巫山空暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听筝堂","author":"杨备","text":"雁柱鸾弦十有三，南山安石位岩岩。\n逡巡奏罢金縢曲，堂上沾襟叹不凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵和殿","author":"杨备","text":"得地恩深雨露遍，丹墀左右玉阶前。\n君王属意君知否，好似风流美少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵览古 直渎","author":"朱存","text":"昼役人功夜鬼功，阳开阴阖几时终。\n不闻掷土江中语，争得盈流一水通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东涧","author":"杨备","text":"手拖葛屦坐藜床，竹树萧然一水傍。\n枕上白云船下月，卜邻东涧胜东冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独足台","author":"杨备","text":"鸟迹分明在帝台，管弦声里辄书来。\n回头一觉风流梦，犹得朱门傍水开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射雉场","author":"杨备","text":"外作禽荒内色荒，三千红粉日严妆。\n潘妃纵有嫣然态，不步金莲到射场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚕室","author":"杨备","text":"摘茧抽丝女在机，茅檐苇箔旧堂扉。\n年年桑柘如云绿，翻织谁家锦地衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕雀湖","author":"杨备","text":"平湖岸侧见高坟，万土衔来燕雀群。\n鉴面无波天一色，此中文藻似储君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"覆杯池","author":"杨备","text":"金杯覆处旧池枯，此后还曾一醉无。\n东晋中兴股肱力，元皇也学管夷吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明庆寺","author":"杨备","text":"翠壁如屏旱不枯，一泓甘滑饮醍醐。\n高僧到此闻丝竹，还有金鳞对跃无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒云千叠山","author":"杨养晦","text":"松竹阴森护上方，老仙蓬发一簪霜。\n闲来攲枕松风里，归梦不知山水长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千手眼白玉观音偈嘲金使","author":"径山寺僧","text":"一手动时千手动，一眼观时千眼观。\n幸自太平无一事，何须做得许多般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上扬州太守","author":"杨冠","text":"古人肉食无远谋，腰钱骑鹤上扬州。\n春风十里珠帘捲，但看竹西歌吹楼。\n天朝选用诗书帅，上策公言须自治。\n屏翰坚持保障功，江淮益壮金汤势。\n北骑不敢纵南牧，关寒烟迷芳草绿。\n健儿歌舞乐升平，一曲梅花细柳营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙巳春次中隐先生韵 其二","author":"杨冠卿","text":"种满人间桃李春，门阑旧物讵忘情。\n江湖若也有闲地，著我一犁春雨耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":71999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙巳春次中隐先生韵 其一","author":"杨冠卿","text":"密勿筹帷今几春，故山猿鹤尚关情。\n中书历遍令公考，乐道要从莘野耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙未秋赋不遂志归寓水村","author":"杨冠卿","text":"归来不负白鸥盟，要听云山韶濩声。\n钟鼎轩裳非我事，从教水到自渠成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九江春半雨中寒甚忽见梨花","author":"杨冠卿","text":"江城一雨春强半，寒色著人芳信迟。\n赖有梨花遮病眼，一枝带雨出疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又用韵 其三","author":"杨冠卿","text":"杏坛铿尔瑟声稀，剑佩三千羽盖飞。\n独对春风吟咏处，从今愿学舞雩归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又用韵 其二","author":"杨冠卿","text":"穷巷无人车辙稀，寻巢燕子故飞飞。\n似嫌茅屋太低小，广厦千间欣有归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又用韵 其一","author":"杨冠卿","text":"弱水蓬山到者稀，凌空须仗羽轮飞。\n群仙拍手山头笑，笑我漂零胡不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山茶","author":"杨冠卿","text":"绿叶巃嵷衬渥丹，疏林残雪尚班班。\n先驱特为东君至，怕向春风桃李间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从郭中隐觅酒并呈张君量","author":"杨冠卿","text":"百斛龙文鼎可扛，挥毫曾寄碧油幢。\n酒兵若有三千骑，肯向诗坛筑受降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"杨冠卿","text":"莺语丁宁隔晓窗，露翻红药斗新妆。\n玉笙莫作相思调，犹恐春归得见郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水亭晚坐","author":"杨冠卿","text":"烟波渺渺白鸥双，远树微红衬夕阳。\n坐久江风起蘋末，冯夷借我一襟凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王干竹枕甚简古客有得之者为赋二绝 其一","author":"杨冠卿","text":"荣枯已熟槐安境，妄幻敢藏鸿宝书。\n一节黑甜参已透，漆园胡蝶浪分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王干竹枕甚简古客有得之者为赋二绝 其二","author":"杨冠卿","text":"夜明已赐虢国姊，曲肱又属东家丘。\n娱寝有人君得计，睡乡留我取通侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回纹四时 其四","author":"杨冠卿","text":"霜惊叶落催寒晓，梦破人愁觉夜长。\n香暗折梅初点玉，镜鸾呵手试新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回纹四时 其二","author":"杨冠卿","text":"冰盘瑩静风帘阖，酪粉尝残日影曛。\n棱枕印红斜玉颊，碧衫揎袖整轻云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回纹四时 其三","author":"杨冠卿","text":"纹簟浥香馀汗粉，绿眉攒恨旧愁新。\n焚香夜拜初生月，暮色窗纱薄雾匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回纹四时 其一","author":"杨冠卿","text":"轻风透幕罗衾薄，满萼娇红缀小桃。\n明月对愁萦锦字，断弦空暗紫檀槽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归涂春晚 其一","author":"杨冠卿","text":"待得春归人亦归，风花撩乱扑征衣。\n清香十里荼蘼路，零落珠幢对晚晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归涂春晚 其三","author":"杨冠卿","text":"暂解征骖野水湄，卷衣上马夜何其。\n客愁政自不堪说，残月一声闻子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归涂春晚 其二","author":"杨冠卿","text":"点点更筹清夜徂，昏昏乡月琐窗虚。\n梦回忽听狂风雨，明日前村花更疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归途用李泉野韵","author":"杨冠卿","text":"乾坤万古几昏晓，兔走乌飞不暂停。\n去日荻花秋索索，归时芳草又青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦 其一","author":"杨冠卿","text":"攲岩松桧转龙蛇，洞户仙人字少霞。\n炯炯长眉非是画，翠翘斜倚碧桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦 其二","author":"杨冠卿","text":"问讯人间几日期，谓言何处是瑶池。\n玉杯饮罢梦中醉，不记神游话别时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同张帅出郊客有欲别去者作诗留之","author":"杨冠卿","text":"元戎小队出郊坰，落絮游丝亦有情。\n纵酒欲谋良夜醉，系帆何惜片时程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同韩吴二寺丞饮西湖梅花下酒酣继韩韵","author":"杨冠卿","text":"冉冉山云薄暮时，壶觞歌咏欲忘归。\n一杯且为梅花醉，莫待梅花作雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次归耕堂稀字韵 其二","author":"杨冠卿","text":"神京千里雁书稀，关塞传闻驿骑飞。\n报道天骄遁沙漠，衮衣行从翠华归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次归耕堂稀字韵 其四","author":"杨冠卿","text":"湖山春老杏花稀，柳絮漫空作雪飞。\n横槊赋诗有馀暇，不妨倒载送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次归耕堂稀字韵 其三","author":"杨冠卿","text":"功业汾阳千载稀，龙庭单骑去如飞。\n笑谈整顿乾坤了，黄钺金钲奏凯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次归耕堂稀字韵 其一","author":"杨冠卿","text":"精忠贯日古来稀，帷幄从容扈六飞。\n风虎云龙方际会，故乡未许我公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次李提举桂花韵 其一","author":"杨冠卿","text":"绿帷深护黄金粟，妩媚似嫌红粉妆。\n年来不作广寒梦，喜对孤标时踞床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次李提举桂花韵 其二","author":"杨冠卿","text":"人间初未识奇木，子落蟾宫秋政芳。\n托根底事在幽谷，要伴清都山水郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王鸥盟秋日郊居即事 其一","author":"杨冠卿","text":"老去柴桑昼掩关，悠然得意在南山。\n忘言妙处无人解，目送孤鸿天际还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王鸥盟秋日郊居即事 其三","author":"杨冠卿","text":"松菊依然绕旧庐，西风归兴动鲈鱼。\n归来有酒辄成醉，旋摘秋园雨后蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王鸥盟秋日郊居即事 其二","author":"杨冠卿","text":"不贪薏苡与明珠，曳屣狂歌信杖扶。\n谁道先生贫彻骨，先生清处若冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶无咎栀子花","author":"杨冠卿","text":"楼石山前薝卜花，品题从昔属诗家。\n君看五字齐梁句，句好当令屈宋衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自仙潭治归舟呈王鸥盟 其四","author":"杨冠卿","text":"江村烟雨暗霏微，正是鸥盟得句时。\n雨后屏山展新绿，更烦摹写送新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自仙潭治归舟呈王鸥盟 其一","author":"杨冠卿","text":"江头重整旧渔衣，触起眠沙鸥鹭机。\n烟渚芦花留不住，叶舟还趁夕阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自仙潭治归舟呈王鸥盟 其二","author":"杨冠卿","text":"绝嶂云烟乍有无，苍崖茅屋近何如。\n西风拍手唤征雁，恐有平安锦字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自仙潭治归舟呈王鸥盟 其三","author":"杨冠卿","text":"扁舟夜泊蓼花丛，晓挂风帆苕水东。\n拟办盖头茅一把，十年湖海浪飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自槜李至毗陵道中 其四","author":"杨冠卿","text":"满目江山无限情，夫差城郭暮云平。\n当时不竞黄池长，一再何由致越兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自槜李至毗陵道中 其五","author":"杨冠卿","text":"晋陵城东窣堵坡，两尖高并下临河。\n昔年曾醉邻墙酒，卧听扁舟唱踏歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自槜李至毗陵道中 其二","author":"杨冠卿","text":"朱槿碧芦相间栽，蓬棚车水过塍来。\n茸茸秋色浓如染，已有陂塘似镜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自槜李至毗陵道中 其三","author":"杨冠卿","text":"极目云天意已舒，迎人草树绿扶疏。\n望中孤塔松江近，便有小船来卖鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西楼","author":"杨冠卿","text":"平头四十误儒冠，独立西楼忧万端。\n两鬓飘萧半华发，羞将勋业镜频看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐安 其一","author":"杨冠卿","text":"寂寞东坡对竹楼，两公陈迹是前修。\n津亭倚柁还商子，雪后独为江上游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗僧常不轻以梅花句得名于时雪后踏月相过论诗终夕退得二绝以谢 其二","author":"杨冠卿","text":"荒江落日孤鸿影，远趁幽人踏月来。\n雪屋云林淡相对，月边依约有寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗僧常不轻以梅花句得名于时雪后踏月相过论诗终夕退得二绝以谢 其一","author":"杨冠卿","text":"十年袖里梅花句，梦绕江南烟雨村。\n今日相看更愁绝，天低云淡月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨未霁有载歌姬游道场山者","author":"杨冠卿","text":"濛濛烟雨暗空山，骄马行春翠袖寒。\n待得春风捲云幕，却愁春色又阑珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪溪口","author":"杨冠卿","text":"短短桃华宿雨馀，风轻春水縠纹铺。\n柁师苦要贪行色，不肯系船寻酒酤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其二","author":"杨冠卿","text":"忽忆前时小院归，杏花墙角两三枝。\n夜香烧断黄昏月，缥缈邻家玉笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其一","author":"杨冠卿","text":"东阁官梅已退妆，远村沙柳发新黄。\n遥知归去西江路，定有飞花触地香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送堵修远归湖城 其二","author":"杨冠卿","text":"云卧江村烟树林，悬知出岫本无心。\n亭皋若也有归雁，得句不妨频寄音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送堵修远归湖城 其一","author":"杨冠卿","text":"十载读书松竹林，壶觞歌咏有知音。\n君今别我市朝去，谁伴寒窗拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"继韩尚书春日舟行韵 其一","author":"杨冠卿","text":"河水拍堤清且涟，堤联南陌与东阡。\n浮家泛宅苕溪路，老却春光又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"继韩尚书春日舟行韵 其二","author":"杨冠卿","text":"蜀魄思归昼夜啼，漆园蝴蝶梦魂飞。\n箪瓢陋巷心如水，惟有颜渊殆庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读亲征诏 其二","author":"杨冠卿","text":"君王神武不恬兵，气詟中原一扫平。\n可笑西江喜归客，便装行橐待还京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读亲征诏 其一","author":"杨冠卿","text":"诏语深醇告万方，便知九鼎不劳扛。\n波臣奔走扶黄屋，约束风涛过大江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别友生马千里 其二","author":"杨冠卿","text":"瘴雨蛮烟道路赊，囊书匣剑是生涯。\n海山佳处能相忆，好寄新诗雁字斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别友生马千里 其一","author":"杨冠卿","text":"秋鸿社燕几时休，万里无家天尽头。\n青蒻绿蓑今已办，江湖归去老渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]