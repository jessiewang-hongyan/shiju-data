[{"title":"送赵抚州至坎石共饭胜不如索赋","author":"韩淲","text":"坎石溪头同早炊，清霜枫树叶飞飞。\n班荆一笑又何许，珍重云山布衲衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小饮 其一","author":"韩淲","text":"玉梅吹雪乱香云，箫鼓声中万室春。\n谁信长安有閒地，啸吟风物两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小饮 其二","author":"韩淲","text":"春云梳月照通衢，灯火摇红入醉呼。\n拍手儿童唱杨柳，江头人道十分无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南庵听琴","author":"韩淲","text":"霜晴随意到南庵，近有溪流远看山。\n小醉情怀听别鹤，数声清弄入幽閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弈棋","author":"韩淲","text":"绿叶初新暑尚轻，林疏明处见流莺。\n茗盂过手棋声起，睡眼挼挲句又成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与成季著棋","author":"韩淲","text":"一树寒梅秋未花，日边终是影横斜。\n开轩戏把纹楸对，绿叶清声亦自嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野趣轩弈棋","author":"韩淲","text":"山雨吹凉醉不成，棋声閒与写吟情。\n老来但觉相羊地，不尽烟云笔底生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲明还自杭戏与弈棋","author":"韩淲","text":"人自西湖南荡归，定无尘土染征衣。\n山间醉把纹楸戏，还共清晖对落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十七日过谭守听松","author":"韩淲","text":"溪堂不到又三日，忽有松声来赋诗。\n误喜新凉风雨过，懒收窗下著残棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢送石松 其一","author":"韩淲","text":"大涤洞头双径间，望穷天目但槃跚。\n如今觅得云根树，景气祥飙溢翠寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢送石松 其二","author":"韩淲","text":"故人知我老生埃，天目春松亦茂哉。\n从此涧清山愈邃，移来不待著诗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松花","author":"韩淲","text":"松花千树发轻黄，乍暖风来细细香。\n但是游蜂喧过午，不知飞鸟下斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春山竹间","author":"韩淲","text":"薰风常坐竹间亭，不为前山满眼青。\n行遍溪南来下郭，主人休问草堂灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏问丞廨荷花","author":"韩淲","text":"露荷吹满小池风，想见公馀采摘空。\n正是新秋明月夜，隔溪还许野人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同施教授东濠看荷花和韵二首 其一","author":"韩淲","text":"行云吹尽没纤痕，涌月浮空到碧澜。\n濠上更看荷花发，夜凉无计凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同施教授东濠看荷花和韵二首 其二","author":"韩淲","text":"醉醒絺衣尚酒痕，空思清论捲涛澜。\n一诗又得圆前梦，依约风花十二栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花","author":"韩淲","text":"秦外市尘吹不到，独看流水种桃花。\n春红片片飞时候，动影垂光是落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花飘零满涧","author":"韩淲","text":"细水收晴露浅沙，叶新枝上绿交加。\n春风误得刘郎老，犹有心情数落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涧上桃花","author":"韩淲","text":"桃花风里鬓成丝，老眼青山百不宜。\n犹有中原旧家在，相寻呼酒和新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饮赵池咏海棠","author":"韩淲","text":"池阁新晴见海棠，试将杯酒问春光。\n主宾可是风流杀，一片红云过夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡教授来因酌海棠下见和前韵复答赋","author":"韩淲","text":"轻阴催雨湿汀沙，山崦寒生一倍加。\n好事肯同杯酒咏，绿娇红小是谁花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乘雨寻梅","author":"韩淲","text":"冲风冲雨看梅花，却喜今年得在家。\n拌却一冬常是醉，远香孤艳正无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自章泉泊施寺雨中见梅盖秋尝宿此","author":"韩淲","text":"秋风秋雨又冬霜，山路山溪任短长。\n邂逅留连随地饮，峥嵘竹外见梅芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涧梅一枝盛开","author":"韩淲","text":"涧头一树小春梅，每岁何曾抵死开。\n乱点香须乃如许，有花无句为徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武林买蜡梅栽在园","author":"韩淲","text":"移得西湖一种来，小园已是十年栽。\n输香浅色霜风晚，合与幽人子细开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏问梅花","author":"韩淲","text":"本是山中向腊开，如何亦入帝城来。\n插向瓷瓶疑有语，大家都莫管尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放步山根梅梢一花奇甚","author":"韩淲","text":"老去情怀触景移，意行何地不吾诗。\n小园雨后将飞雪，探得梅花第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其一","author":"韩淲","text":"衡门终日掩荒苔，岁晚寒梅取次开。\n斜入倒窥霜雪后，嘉平腊近有春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其二","author":"韩淲","text":"漠漠繁香为倚风，一枝藏白更舒红。\n稀疏固喜山容淡，零落惟愁涧影通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其三","author":"韩淲","text":"行歌时与发天和，模写工夫苦未多。\n忽到酒边聊贾勇，衰颜如许亦红酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其四","author":"韩淲","text":"不须回梦入池塘，对雪逢花且醉香。\n纵御铅华那可拟，涂黄空说旧家妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其五","author":"韩淲","text":"千里民熙岁熟时，使君应为把芳卮。\n浮香亭上诗成处，一片官梅意已知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其六","author":"韩淲","text":"花仙依约艳轻腮，幽爽何由染世埃。\n只道云阶连雾牖，岂知月观与风台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其七","author":"韩淲","text":"江头千树白茫茫，空谷佳人未洗妆。\n一曲霓裳舞初破，寿阳春色到宫嫱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其八","author":"韩淲","text":"细酌微吟苦未休，气酣名酒思方抽。\n一年心事梅花白，留落江南第几州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其九","author":"韩淲","text":"皂盖难忘近所稀，晚香初落少人知。\n讼庭既简无过酒，官路何嫌不到诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵五叔梅花 其十","author":"韩淲","text":"孤静清新才半树，香凝兵卫独来时。\n十诗说尽花间句，未必黄昏浅月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子似梅花 其一","author":"韩淲","text":"梅开诗就适相逢，一样精神别样容。\n只恐芬芳花易谢，诗人情性却无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子似梅花 其二","author":"韩淲","text":"诗与梅花不易逢，凭谁能赋水边容。\n涧声清浅流香去，笔力应须子细穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子似梅花 其三","author":"韩淲","text":"雪里何如月下逢，一般景色一般容。\n分明天地之尤物，便只枝梢画莫穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子似梅花 其四","author":"韩淲","text":"时时觅句与香逢，看见春风上玉容。\n兴熟归来眠纸帐，梦魂何处有诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初三日丁使君送三绝句梅诗 其一","author":"韩淲","text":"浮香亭下几株梅，曾是宗英太守栽。\n宾主两魁黄阁老，发挥全待后贤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初三日丁使君送三绝句梅诗 其二","author":"韩淲","text":"敝庐幽涧自横斜，千骑行春见此花。\n留与他年作佳话，公应犹记野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初三日丁使君送三绝句梅诗 其三","author":"韩淲","text":"轩前淡泊总生春，绝艳吹香更著人。\n因古讽今宣德化，要令观听俗还新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十九日散步春浦因看山池梅花缤纷而酌","author":"韩淲","text":"晚香梅落小池春，老意閒随岁事新。\n山霭乍收斜日澹，一轩恰醉两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱卿有绝句看梅之约次韵谢之 其一","author":"韩淲","text":"当代儒魁不数人，纷纷胶胶孰知春。\n诗来话起梅花约，一段风流意更真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱卿有绝句看梅之约次韵谢之 其二","author":"韩淲","text":"雨雪连阴恼杀人，梅花空度玉溪春。\n何当迟日暄风底，挈榼从游醉乃真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"约次公看梅","author":"韩淲","text":"春风春雨春山里，一盏青灯对简编。\n涧水东边有梅蕊，且呼杯酒醉新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后看梅","author":"韩淲","text":"雪残山润眩朝晴，涧溜融澌渐有声。\n最是梅花先后发，倚风乘日艳精明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"看梅","author":"韩淲","text":"竹篱围著一株梅，不道青春昨夜回。\n繁蕊嫩条花萼底，也须知我有诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次公山中有绿萼梅 其一","author":"韩淲","text":"问讯春山绿萼梅，今年还有几枝开。\n主人曳履花香底，谁是渔樵可往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次公山中有绿萼梅 其二","author":"韩淲","text":"我亦篱前见野梅，殊非绿萼未全开。\n稀疏红颗多纤瘦，啼彻幽禽扑下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次公山中有绿萼梅 其三","author":"韩淲","text":"萼绿花仙作尔梅，肯随尘态向人开。\n是中只可添风月，兴熟遥知得句来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙花 其一","author":"韩淲","text":"清浸数枝香动人，待吟诗句与花新。\n洞庭风度湘灵瑟，月冷波寒谁写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙花 其二","author":"韩淲","text":"冬深犹有水仙花，雪打霜催更好葩。\n岁岁山间连槛种，数枝亦足傲尘沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山矾映山红买置窗间甚思上饶閒适 其一","author":"韩淲","text":"春风亦到我窗轩，洁白殷红日正暄。\n桃李人间已无数，且看踯躅与山矾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山矾映山红买置窗间甚思上饶閒适 其二","author":"韩淲","text":"月岩云洞向春时，石上旁开最好枝。\n日落风生啼鸟唤，几回容我醉行迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山矾映山红买置窗间甚思上饶閒适 其三","author":"韩淲","text":"西关东郭转平冈，常是春游满路香。\n沿路儿童拾残蕊，更寻高树折归忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金来禽","author":"韩淲","text":"红湿华滋叶护花，金来禽映海棠斜。\n珊瑚声里飞山鹧，云气吹晴落紫霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"御仙花","author":"韩淲","text":"山间亦有御仙花，瓶插幽窗意自嘉。\n笑杀黄尘吹鬓客，只图横带把金誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"牵牛花","author":"韩淲","text":"露气浮风入短篱，蔓延高下复参差。\n轻清不作妖红艳，漠漠秋阴分外宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大笑花","author":"韩淲","text":"磊落檐前大笑花，肯同凡木强争华。\n日光玉洁薰风里，秾郁香传自一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓶间薝卜","author":"韩淲","text":"碧叶瑶光发净香，薰风吹我小书房。\n日长饮罢支颐坐，忘却浮生鬓发苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅天薝卜花开","author":"韩淲","text":"梅润愔愔雨脚斜，海天长夜一瓯茶。\n巴笺试罢卷书坐，静看小丛薝卜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"轩窗薝卜瓶浸佳甚","author":"韩淲","text":"瑟瑟风声去复还，薄烟轻日小窗閒。\n铜壶更浸新薝卜，香扑书帘笔格间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵永兴梅花蜡梅水仙 其一","author":"韩淲","text":"南枝北枝香最清，诗边酒边如许情。\n不应领略无妙语，唤取里中诸父兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵永兴梅花蜡梅水仙 其二","author":"韩淲","text":"绛纱中单发幽芳，不肯祗作脂粉妆。\n取蜡为花付禅老，护寒却有麝脐香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵永兴梅花蜡梅水仙 其三","author":"韩淲","text":"肯同桃李强争妍，山矾江梅可忘年。\n霜雪时候金玉质，持花合为西湖仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落花","author":"韩淲","text":"满地春风醉不知，汉皋金谷任他吹。\n落花回雪真何有，宛转如云点缀迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓露看花","author":"韩淲","text":"乘露看花过小园，海棠明润转芳鲜。\n无人伴我寻诗立，时有双双戏蝶翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦益菜 其一","author":"韩淲","text":"宜油宜酱复宜葱，熟炒堆盘放箸空。\n应怪辛勤营一饱，幽人元自有家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦益菜 其二","author":"韩淲","text":"南烹蛙黾颇腥臊，北食羔豚亦太豪。\n老觉閒身便野蔌，口头虽苦意殊高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦益菜 其三","author":"韩淲","text":"荠甘荼苦本难齐，苦尽甘回信不迷。\n日日晓凉和露采，山间寻得便提携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山空鸟鸣可喜","author":"韩淲","text":"数叠高山拥画屏，一声啼鸟唤春心。\n有诗更在斜阳外，归棹绿波烟浪深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻莺","author":"韩淲","text":"拓落闲身著涧边，地偏犹幸可回旋。\n青桐已长阴敷嫩，黄鸟初飞语转圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓凉闻莺","author":"韩淲","text":"茂树无风晓自凉，数声黄鸟啭圆吭。\n老身曳屣穿林去，一片荷香是小塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山禽","author":"韩淲","text":"势路权门不负人，林亭花竹且藏身。\n山禽地瘴嘲啾叫，又使无明动一尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午睡醒闻鸠","author":"韩淲","text":"鸣鸠亭午唤春阴，不记凉风气候深。\n残酒醒来吟笔在，小山丛桂得芳寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乘晓汲闻蛙鸣","author":"韩淲","text":"起来片月尚朦胧，汲井开门露滴空。\n隐隐雾横山澹薄，蛙声犹在小池东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]