[{"title":"周希父赋梅次韵三首 其二","author":"林季仲","text":"岁华物意两俱迟，开到前村第几枝。\n抱影自怜春有信，冲寒长指雪为期。\n音传陇首人相忆，恨入楼头角正悲。\n最是一年难忘处，小桥流水夕阳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周希父赋梅次韵三首 其一","author":"林季仲","text":"村舍江南雪意迟，月边初破两三枝。\n输他一点先传得，回首千花总后期。\n春事循环宁有尽，岁华晼晚漫多悲。\n君诗到眼如图画，写出行人立马时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高少保九日","author":"林季仲","text":"谁将淡墨扫秋山，乞与衰翁独倚栏。\n白发试思何处去，黄花今有几人观。\n老来自觉情怀恶，客里长嗟会面难。\n卷尽浮云放明月，与公同倒百杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"表之索诗为别","author":"林季仲","text":"踏著禅门步步新，布衣蔬食欲终身。\n解颜一笑如深契，拭眼相看尚未真。\n世事尽归簪上雪，我生聊寄瓮头春。\n夜深坐对柯山月，应念沧江独钓人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侯公谨挽词","author":"林季仲","text":"富贵功名等弁髦，何如声迹翳蓬蒿。\n倦游正被微官缚，辞禄方知处士高。\n华萼向来荣父行，芝兰重见秀儿曹。\n寄言护国山头月，莫照山猿夜夜号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"娄夫人挽词","author":"林季仲","text":"曾将句读授儿童，记得何侯待我隆。\n肯辟高堂舍孙宝，定知贤室赞张忠。\n兰陔未遂三山养，霜树俄惊一夜风。\n汤沐追封他日事，哀荣应在泪痕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日郊行","author":"林季仲","text":"困倚春风半醉醒，小桥流水欲相平。\n晚蹊窈窕行桃李，野老逢迎略姓名。\n浦溆远兼江色暝，凫鸥迥立夕阳明。\n田家作苦吾何恨，无补公家合退耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日感怀","author":"林季仲","text":"忆昔青春去不来，深凭百舌唤将回。\n尊前便觉和风转，镜里生憎白发催。\n青破轻寒归驿柳，香和宿雨落江梅。\n人生七十从来少，待挽长河作寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨夜梦陪后乘次前韵","author":"林季仲","text":"落花迷晓径，零露点秋畦。\n节物惊衰鬓，登临忆故栖。\n苍苔痕过履，修竹湿新题。\n昨夜寒窗梦，相随叠嶂西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳夫人挽词","author":"林季仲","text":"风俗日云薄，典刑终未泯。\n请看列女传，今有柳夫人。\n色养金章贵，褒封钿轴新。\n凄凉板舆路，却见小梅春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡夫人挽词","author":"林季仲","text":"自昔衣冠盛，人言胡与吴。\n诗书渐渍久，妇女见闻殊。\n凤去怜雏弱，鸾吟叹影孤。\n灵龟表贤德，卜地得慈湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵守泛舟康侍郎有诗次韵","author":"林季仲","text":"弹压湖山有主人，我如鸿雁亦来宾。\n连云岛屿参差见，过雨林塘取次新。\n霜橘似誇千户富，雪梅欲放一枝春。\n酒醒月落愁无那，听彻残更断晓闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵宝学挽词二首 其二","author":"林季仲","text":"粲粲霜蕤晚，凄凄烟渚秋。\n长随山简马，同上谢公楼。\n诗句入飞鹜，歌声落钓舟。\n那知倚栏处，直北是松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵宝学挽词二首 其一","author":"林季仲","text":"珠海光无尽，瑶山气自温。\n鸿基开烈祖，馀庆袭贤孙。\n妙墨潜虬动，雄词骇浪翻。\n九重应震悼，同性失毛原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵彦挽词","author":"林季仲","text":"铁面声名满九州，尔来孙子亦风流。\n怡云自比陶弘景，下泽谁如马少游。\n醉袖舞低千嶂月，钩纶翻动五湖秋。\n可怜旧日飞觞处，波影空摇百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送思深赴泉州录参","author":"林季仲","text":"南郭先生卧病馀，瘦如骐骥服盐车。\n厌尝漆叶青黏散，旋理司空城旦书。\n长陌欲登秋色薄，一樽相对鬓毛疏。\n晋江波与温江接，消息频传双鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁尚书移守宛陵","author":"林季仲","text":"堂堂体貌照簪缨，天与君王佐太平。\n拭眼待看萧相国，举杯且属谢宣城。\n花间未听歌声彻，笛里先催别恨生。\n说与邦人休卧辙，过家闻欲趁清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"项居士挽词","author":"林季仲","text":"孝友从初岁，温恭见隐居。\n谁云不为政，只此是知书。\n末俗惟多伪，何人得似渠。\n春江照丹旐，恨亦到龟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭薛吏部 其二","author":"林季仲","text":"白鹿春城下，黄牛古垄头。\n年年唤兄弟，两两酹松楸。\n今日逢寒食，哀君返故丘。\n荣怀多少恨，不逐晚云收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭薛吏部 其一","author":"林季仲","text":"伯仲皆登第，人言薛与林。\n凄凉五年事，摧折两家心。\n漫醉春来酒，谁同别后襟。\n空馀钓矶在，落日见孤岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽程夫人词","author":"林季仲","text":"金章朱毂烂盈门，春入仙翁笑颊温。\n曳杖时时过他客，含饴日日弄诸孙。\n风高浙水惊霜叶，月落黟山泣晓猿。\n丹旐悠扬转寒日，尚疑帘下綵衣翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁居士挽词","author":"林季仲","text":"君看袁居士，苍然松柏姿。\n生涯一樽酒，事业五言诗。\n去跨月边鹤，空馀床下龟。\n江村相送处，尚忆杖过眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘别诸同年","author":"林季仲","text":"晚色明沙际，春愁挂柳边。\n相逢一尊酒，难值七同年。\n聚散雁遵渚，行藏鱼在渊。\n西兴残夜月，独照渡头船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪枢密诸丈游赤松迫于还城阻为宝峰之集情见于诗","author":"林季仲","text":"村迥云连屋，溪晴水绕畦。\n半生嗟薄宦，随处惬幽栖。\n散策寻遗迹，披尘识旧题。\n夕阳催上马，不到宝峰西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪赵守登楼赏红梅","author":"林季仲","text":"大洁时争嫉，独醒人更疑。\n漫随春色媚，不改岁寒姿。\n霞带寿阳脸，酒融姑射肌。\n凭谁慰孤寂，新有倚楼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪郡守赵介然泛舟","author":"林季仲","text":"邦人夹岸觑龚黄，画鹢夷犹转曲塘。\n风定波平溪练净，沙寒石出木奴香。\n冥搜万象诗肩耸，流盼千山醉眼长。\n此兴在公真不浅，更乘霜月倚胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪馆中诸人游天竺分得香字","author":"林季仲","text":"不到八年久，重来双鬓苍。\n珠玑溅寒溜，笙磬咽风篁。\n啼鸟千林晚，飞花一路香。\n吾宗故庐在，立马傍残阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高太傅挽词","author":"林季仲","text":"声利场中意独消，端如处士翳蓬蒿。\n渡江一马神先助，夹日五龙功更高。\n不愿本朝私戚里，长称文母训儿曹。\n十年共说无生话，却对东风泪满袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘知言","author":"林季仲","text":"年来何止二宜休，合把身名付钓舟。\n寒食又冲花下雨，晚塘渐狎棹前鸥。\n推居谁复如公瑾，种竹犹怜似子猷。\n来坐梅阴引春酒，微酸点点著枝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄婺州周知录","author":"林季仲","text":"不到东阳六七年，干戈身世两依然。\n每思三虑堂中退，径向双溪楼上眠。\n空翠霏微浮酒斝，林烟杳霭没渔船。\n有人问我今何似，头秃昏昏瘴海边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题赵丞相独往亭诗","author":"林季仲","text":"海内英豪还有谁，宁容丘壑著皋夔。\n欲知今日中兴业，已定黄冈独往时。\n谢傅本无朱组愿，留侯应念赤松期。\n更须整顿乾坤了，我亦芒鞋随所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题蒋封州三径堂堂本在丹阳后避地四明再创","author":"林季仲","text":"三径开从蒋兖州，至今孙子亦风流。\n钩帘虽对鄮山月，闻笛应悲京口秋。\n往事漫劳书咄咄，馀生只合赋休休。\n问君办得蓑衣否，便好相随上钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼潘君秀才","author":"林季仲","text":"投笔辞场屋，携钱送酒家。\n身名俱梦幻，醒醉是生涯。\n沙晚号寒雁，林高惨暮鸦。\n嗟予方哭弟，清泪堕悲笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚眺二首 其二","author":"林季仲","text":"病与老相守，慵思静自便。\n故园三径菊，归路一蓑烟。\n高下云连谷，纵横水护田。\n凄凉千古事，簇簇夕檐前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚眺二首 其一","author":"林季仲","text":"秋色澹脩渚，夕光明小楼。\n溪虚烟漠漠，天迥雁悠悠。\n短发存堪数，黄花插自羞。\n青山本无事，敛黛为谁忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移竹次林英伯韵四首 其四","author":"林季仲","text":"娟娟犹带露痕新，分得江潭未化身。\n岁晚定知堪傲雪，生来不肯强随人。\n心如庞老空诸有，节比原思不恨贫。\n月淡风清卧寒谷，倡予和女复谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移竹次林英伯韵四首 其三","author":"林季仲","text":"手种琅玕照眼新，老来深寄五湖身。\n连宵留得枝间月，邀我同为物外人。\n封殖不贪千户富，依栖可慰一生贫。\n武夫称谓殊粗俗，却恨樊川语未亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移竹次林英伯韵四首 其二","author":"林季仲","text":"不向窗前著色新，老夫无处可安身。\n寒梢已拔千寻剑，空腹堪容数百人。\n染泪浪传湘水恨，结根终伴杜陵贫。\n回头万事皆衰歇，岁晚相从尔独亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移竹次林英伯韵四首 其一","author":"林季仲","text":"苍苔斲破斧痕新，移傍颓檐慰病身。\n见我浑如旧相识，此君端是个中人。\n孤高自比西山洁，澹泊宁甘南巷贫。\n梦断啼鸦窗转月，怜渠犹把影相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧朝宗旅寓有途穷之叹次韵以广其意","author":"林季仲","text":"路入长安处处同，断桥绝港自相通。\n地高何羡三公贵，境乐那知四壁空。\n万象森罗皆拱北，百川曲折定趋东。\n懒从宦达如曾闵，也有芳猷到不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程显学挽词二首 其二","author":"林季仲","text":"忆向沙头别，谁知地下游。\n祠堂只如旧，庭竹自生秋。\n回首山埋玉，伤心月满楼。\n慎江日夜去，中有泪俱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程显学挽词二首 其一","author":"林季仲","text":"卓荦千人杰，飞腾四十秋。\n才应有馀刃，事不见全牛。\n持节半诸道，分符知几州。\n终遗搢绅恨，不作富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴","author":"林季仲","text":"庆吊何时已，劳生不自閒。\n野情难脱略，人事足机关。\n附尾初无意，同尘半强颜。\n柴门当却扫，未敢负云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潘居士挽词","author":"林季仲","text":"君家多隐德，自昔赋閒居。\n不用毛锥子，甘乘下泽车。\n李衡千树橘，范琰一园蔬。\n夫妇仍同穴，乱离谁似渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题薛献可新居次高仲贻韵","author":"林季仲","text":"高居占得野塘横，竹径桃蹊取次成。\n宿霭半兼朱户湿，好山长傍晚窗明。\n风吹酒面春情渺，月落诗肠夜味清。\n今日主人归定否，试听枝上子规声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩瑞安北湖诗三首 其三","author":"林季仲","text":"吐晴林雨薄，弄水夕阳骄。\n风定云横野，马鸣人度桥。\n藓斑封石骨，花影动溪腰。\n谁破南窗梦，空山落断樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩瑞安北湖诗三首 其二","author":"林季仲","text":"径深松翠重，风软马蹄骄。\n水绕谁家屋，门飞小竹桥。\n龟开平野兆，蜂引断山腰。\n生理吾能免，趋林拾堕樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩瑞安北湖诗三首 其一","author":"林季仲","text":"去去春无语，融融物自骄。\n饷耕怜野老，随犬过山桥。\n晚唱缘溪口，晴晖绊柳腰。\n迂儒欲何用，只合伴渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薛康朝挽词","author":"林季仲","text":"意气平生百不伸，一麾晚出守宜春。\n功名到此当言命，才术如公岂后人。\n庭集鹓雏知有种，盘堆苜蓿未全贫。\n江寒木落悲无那，诗寄蓬窗墨尚新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠刘舍人次德裕弟韵","author":"林季仲","text":"雁塔联名记昔年，天涯一见破衰颜。\n人言巧宦何曾巧，我欲閒居未得閒。\n弱植自怜葭倚树，雄文才许管窥斑。\n明公旧有经纶手，今日宁当缩袖间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别陈给事","author":"林季仲","text":"仕途多汩没，归袖独飘飏。\n要伴赤松子，终辞青琐郎。\n水云宽处好，日月静中长。\n万事休回首，停桡即故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李举之别","author":"林季仲","text":"摛藻才何赡，哦松志未酬。\n奉祠得南岳，戏綵向丹丘。\n贾谊方年少，冯唐已白头。\n桃花烟浪暖，看子上瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李端明","author":"林季仲","text":"洗尽烟岚见海山，池塘春草亦怡颜。\n野沈犬警清宵迥，檐转堂阴白昼闲。\n移镇又传三叠鼓，告庭行促百官班。\n攀辕父老休相忆，总在炉锤橐籥间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵遂甫别","author":"林季仲","text":"才擅金枝秀，名标桂籍先。\n有如此公子，不负我同年。\n风落松间雪，沙明竹外船。\n天涯人老矣，尊酒忆凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠虞教授别","author":"林季仲","text":"儒生底用苦知书，学到根源物物无。\n曾子当年多一唯，颜渊终日只如愚。\n水流万折心无竞，月落千家境自孤。\n把手沙头莫言别，与君元不隔江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戴唐卿挽词","author":"林季仲","text":"湖海长为客，干戈仅脱身。\n来寻林下友，半与鬼为邻。\n马上人何在，庭前草自春。\n平生饶意气，寂寞委荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"魏府君挽词","author":"林季仲","text":"霜露长悲陟岵人，见翁强健却酸辛。\n家徒四壁知无恨，掌有双珠未是贫。\n老去米盐浑不问，病来药石强相亲。\n归从先垄平生志，松下应逢月色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张叔靖咏萤次韵","author":"林季仲","text":"榛莽荒秋雨，郊坰接暮阴。\n挟明如自喜，穿隙互相寻。\n昼伏终羞日，宵征欲乱参。\n林惊光不定，叶脱势俱沈。\n代烛时临卷，随风屡拂琴。\n青荧行爝火，的皪漾沙金。\n巧自缘帘幕，翻令念藁砧。\n徘徊怜扇影，婉娈傍衣衿。\n窗曙星河落，江寒霜露深。\n危蹝怅何往，腐质谅难任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梁守饯诸贡士","author":"林季仲","text":"右文逢圣代，首善自神京。\n延及吴中士，咸称洛下英。\n我邦虽僻陋，此学号专精。\n耆旧风流在，山川气象新。\n元侯来作牧，后进赖提衡。\n有美僖公颂，谁高蜀守名。\n能书偕计吏，燕豆列宾荣。\n万里云霄路，抟风看去程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋不见月","author":"林季仲","text":"淹淹一夜雨，脉脉万方情。\n勿怪云多妒，从来物恶盈。\n水浑珠自瑩，垢尽镜还明。\n共赏此时月，无论阴与晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天柱峰","author":"林季仲","text":"寻胜权舆自天姥，芒鞋踏遍春山雨。\n要得山如磊落人，纷纷拳石何足数。\n忽逢一柱插天寒，形貌最尊疑父祖。\n群峰往往皆儿孙，环列膝前仍俯伛。\n我忧穹昊欲撑柱，莫笑杞人心独苦。\n伊谁有力能致之，大庇苍生使安堵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林楙南秋兴见寄","author":"林季仲","text":"秋阳晃朗秋江前，秋山崷崒飞鸟边。\n待扶仙人九节杖，去采玉井千叶莲。\n一丘一壑不在我，或用或舍其如天。\n故人谪官卧空谷，谁与晤语情凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬黄季章","author":"林季仲","text":"长安公子意气豪，笑我憔悴居蓬蒿。\n人生栖托一枝足，何用抟风九万高。\n我今百事付流水，归卧北窗心独喜。\n林表春禽自在啼，绝胜豢养金笼里。\n谁能胸臆无尘垢，木雁未论才不才。\n子陵事业亦何有，风月凄然一钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观徐孺子画像","author":"林季仲","text":"伯淮卧彭城，绕屋生蓬茨。\n天子呼不起，思见岩壑姿。\n俾工图其形，衔命日夜驰。\n落笔竟不得，韬面以疾辞。\n豫章有孺子，同时隐江湄。\n栖栖非我事，结庐对风漪。\n时人亦罕识，阿堵谁写之。\n我闻郭有道，曾遣轻骑追。\n疑此言语生，即是茅画师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周希父挽词","author":"林季仲","text":"忆昔同年友，吾乡有六人。\n而今如梦寐，强半委埃尘。\n云护霜天晚，梅含野径春。\n回头赋诗处，清泪堕江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]