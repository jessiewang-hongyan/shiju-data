[{"title":"仁寿敬行可开两池曰双照","author":"释居简","text":"照与照者，影沈迹绝。\n尔如何其，自起途辙。\n傍睨语我毋庸疑，倚棂为我赋两池。\n谓言物物皆吾诗，绝怜思苦槁弗滋。\n不忍污此清涟漪，不然小需载生魄，碧潋不摇皆玉色。\n一池各有一眉新，眉间喜气浮津津。\n悠然散作无边春，辗轮半仄朣朣蘸，明透方方两团鉴。\n更徵此义吾无说，莫问清池问明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江塔寺登阁观太湖","author":"释居简","text":"十华藏海藐涔蹄，便作涔蹄为物移。\n富贵不须开帝网，只开万顷碧玻璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"释居简","text":"集霰夜才分，缤霏晓更零。\n未乘风洒洒，先挟雨冥冥。\n窗失三更黑，山无一寸青。\n有船非剡棹，谁去扣吟扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻杜子野讣","author":"释居简","text":"嘉泰开禧后，人传伯仲文。\n演纶宜掌制，草檄谩从军。\n楚塞沈秋警，江云黯暮曛。\n旧题湖上石，藓晕湿苔纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问傅庵海棠消息 其一","author":"释居简","text":"光风欲透锦燕脂，数点忺晴已荐奇。\n惆怅一双新燕子，年年不见未开时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问傅庵海棠消息 其二","author":"释居简","text":"红云煖压草玄池，宫烛传榆夜更奇。\n空掩沉香亭北恨，玉环宿酒未醒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读贾太傅传 其一","author":"释居简","text":"诸老先生总未言，一言中的已先闻。\n守成天子恭沉默，不妒多功重少文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读贾太傅传 其二","author":"释居简","text":"七日平城戒覆车，不容年少系单于。\n用贤勿贰君知否，不用何须叹不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵都厢见过","author":"释居简","text":"彷佛巴东县，空横尽日船。\n晴占收麦候，寒似养花天。\n岚湿窗纱重，云明幌楮鲜。\n商星与参子，相别动经年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访叶海盐不值","author":"释居简","text":"绿叶未幄春正迟，看看雪煖开荼蘼。\n丁宁密意谢红药，掎角缓放韶华归。\n一芳一菲寻版荡，更无可砥狂澜涨。\n惠风迤逦索蒲葵，约束凉薰小相让。\n棠梨雨褪燕脂蔫，来禽效颦相后先。\n主人朝天未回鞯，软红没屦东华前。\n饮湖山绿方颓玉，水绕山围南宕北。\n起来却忆故园春，园中四时花木新。\n诗人眉苦闲情皱，不怕天知怕天瘦。\n遂令真宰妒冥搜，无人不恨古藤州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入邑阻风 其一","author":"释居简","text":"斗风鹢退不忺飞，还似当年过宋时。\n又似雪舟人兴尽，归时却是顺风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入邑阻风 其二","author":"释居简","text":"见时无事去还思，往往来参去不辞。\n弗是山林傲轩冕，澹台有请独无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长兴长赵宪可说闽帅王方岩逸事","author":"释居简","text":"勋业在青编，貂蝉负雪颠。\n巍科几望月，定见不回川。\n用小才嫌大，时危德忌全。\n上天寻白傅，表海问蓬仙。\n心在方岩上，天游委羽先。\n十连茂棠荫，一橐老钧天。\n浊水因珠洁，清风被物鲜。\n孤芳观晚节，善贾考初年。\n吟速甘存拙，文疏耻竞妍。\n郑庄真好客，王衍不言钱。\n谬我奚为者，烦公辱赠篇。\n初无昙颖契，终说项斯贤。\n大雅皆传响，楞严未讫笺。\n新阡小溪曲，华玉反蓝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四明陆韩二佳友登科 其一","author":"释居简","text":"龙虎榜头千佛名，乱山寸碧起双明。\n预吟新句虽三首，莫放胪传第二声。\n得意马蹄须款曲，吐花兔颖看峥嵘。\n平生两眼人嫌白，青为君家好弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四明陆韩二佳友登科 其二","author":"释居简","text":"江上得书才半月，漕闱旋与计偕初。\n荐闻得第喜何似，纵不嗣音曾弗疏。\n别院苦难应有助，大庭贾勇可无馀。\n首呼名氏须相报，雁若慵来亟遣鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盘隐瘗猿","author":"释居简","text":"寸土如寸金，恩殊帷盖深。\n病思罹阱日，死恨出林心。\n残橡停朝赋，空樊绝夜吟。\n六窗呼不应，云冷月沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张公洞得响石","author":"释居简","text":"汉张烧炼处，切得一痕云。\n土蚀爊金液，苔皴截铁文。\n响非弦脆杂，清浣俗纷纭。\n袖里东溟小，罗浮不足云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬卢玉堂","author":"释居简","text":"溪友弗来过，幽栖欠濯磨。\n眼饥嫌睡少，竹醉惜移多。\n雏燕骈争乳，慵莺噤弗歌。\n窗低云不扫，零乱尽从它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈襄阳归长兴 其一","author":"释居简","text":"玉帐拥貔貅，朝天爽借留。\n勋庸收素定，江汉耻横流。\n传有当时癖，池无暇日游。\n貂蝉倘来耳，又见出兜鍪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈襄阳归长兴 其二","author":"释居简","text":"巾子山前寺，曾分华顶薇。\n去寻龙首约，因些客儿归。\n白羽精戎律，黄金缓带围。\n孔融倾座处，西望几斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"项别驾讣临","author":"释居简","text":"清约筋骸别，云泥俗肺肠。\n酌贪廉不污，鉴正丑难藏。\n贵药无钱买，沉痾有死偿。\n若为千驷马，得似蕨薇香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉树曲","author":"释居简","text":"翠袖薄，霞裾飘，盈盈不动金步摇。\n步摇金扶翠翘玉，只知今夕欢难足，不知明日欢难续。\n瑶姬自是能吟女，璧合知还旧躔度。\n古菱花试小龙文，双鸾舞处亭亭分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巫山高","author":"释居简","text":"阳台晴霞煖生缬，削玉六双云嵽嵲。\n白盐赤甲秋未零，侧树攲岩妥鳞?。\n雾毂烟軿两朱凤，紫琼锒铛碧瑶鞚。\n辙飞不点九地泥，泥滓各谐蝼蚁梦。\n兰台词客词诡奇，讽微劝广胡不思。\n更欲张仪聘燕赵，却嫌郑袖黄金少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莲塘曲","author":"释居简","text":"锦帆泾浅花如玉，苧罗女儿更明淑。\n纤柔揽花映芳脸，绿皱不摇秋湛染。\n嫣然闯影一笑新，笑花解笑不解颦。\n扁舟五湖一痕月，照见颦吴更颦越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古镜行","author":"释居简","text":"一奁古碧涵冷秋，泓澄绀滑凝不流。\n开奁拂拭辨款识，认得轩辕在时事。\n轩辕昔游广寒殿，取太阴精酬百鍊。\n囧囧妖踪怪影消，夜哭空郊晓奔窜。\n菱花乱古亦乱真，识真考古今无人。\n黄金宁可买不死，难买张华两眸子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"傅家林","author":"释居简","text":"樵斧响晴雷，平林顷刻摧。\n兔亡三穴徙，猿吊一枝哀。\n桑梓思前辈，松杉惜上材。\n养林如养德，万木盍重栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑大参净慈双井","author":"释居简","text":"山展凤膺仍敛翮，东井碧通西井白。\n井花娄欲策茶勋，长恨眼中无此客。\n夔州病渴夜迢迢，阿段透云分湱湱。\n胡为金锡卓山泉，小倚银床问庭柏。\n一杯盍为龙象供，数寻自是蜿蜒宅。\n万斛滔滔随地出，九地茫茫不须择。\n浅清盈甃玉痕圆，深净镜空云影拆。\n江淮行地自南北，河汉如人同血脉。\n举瓢高谢沧浪浊，吹箫去觅浮丘伯。\n遂令天水不违行，洞明爻象元同画。\n更将康谷细商评，一笑自知肩可拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日寄宜兴谢长官","author":"释居简","text":"射蛟溪上黄花酒，灏气浮溪静弗澜。\n素羽已忘秋后热，紫萸不怕夜来寒。\n轸裁彫玉鸣焦尾，屏掩涂金炷博山。\n步武自高吟自适，何须鼓吹上层峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦雨","author":"释居简","text":"尺潦翻阶怒辊沙，沉阴物物殒精华。\n最怜万亩伤禾颖，忘却重阳对菊花。\n原上有苗皆委地，水中无穗不生芽。\n占晴夜夜观西北，一缕何曾见暮霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠天台权上人","author":"释居简","text":"老荷纫缀晚秋前，冷榻曾无坐客毡。\n旋剪玉虫观细字，欲分半芋且迟眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"箬溪楼制锦堂长兴长官赵可斋新制 其一","author":"释居简","text":"步武弗忺低，阑干俯峭巍。\n霜鸿天外去，檐翼水边飞。\n胜践西风老，幽寻晚照微。\n贺成先燕雀，宏略在沉机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"箬溪楼制锦堂长兴长官赵可斋新制 其二","author":"释居简","text":"古制宜藏巧，吾宁十目窥。\n弗将青镜掩，谁兆白鸥疑。\n雁鹜方群散，罝罦各自施。\n悠然机杼别，无愧召南思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大雄寺陈朝桧","author":"释居简","text":"托根陈土隋风烟，送尽鲤鱼蜚上天。\n六騑度江又如许，老彭社栎将齐年。\n彭自有商观五伯，区区社栎奚为者。\n君乎干老旧时天，刚中紫铁青铜坚。\n一年一年看妖妍，年年死在秋风前。\n轮囷孤顶鸾停翼，脱略霜皮蛟露脊。\n自古才难人弗惜，江东酒壶浇柱石。\n夜深风雨卷潭湫，霹雳一声天地秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月溪","author":"释居简","text":"光动群阴敛，朣朣古岸斜。\n缘空冰碾雾，分影璧沉沙。\n圆转刚非缺，虚灵净弗瑕。\n修轮纷血指，玉斧在山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月初三四雪","author":"释居简","text":"霰集三秋后，花飞十月初。\n更添两度白，并作一年书。\n稻疃齐生耳，麰田烂弗锄。\n寒敲君子竹，压折怕林疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"墨藕花 其一","author":"释居简","text":"红铺不是芬陁利，绿卷无非菡萏秋。\n以色媚人宁坏色，不随荣谢镜中羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"墨藕花 其二","author":"释居简","text":"西子湖阴锦掞云，水风池阁度晴熏。\n影窥明王生绡薄，分外精神一两分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松图 其一","author":"释居简","text":"李怀仁画双龙后，活在兰陵道士家。\n水墨工夫能幻巧，变成霜干老槎牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松图 其二","author":"释居简","text":"断桥之西石桥北，忘世忘年寄幽独。\n千仞干云险绝攀，瘦影何时落横幅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋雨连冬雪寄常平使者王郎中","author":"释居简","text":"九月十月闰月雨，阴晶阳采云霾?。\n十旬朝夕漏涔涔，岂应漏处无人补。\n准拟书云须少霁，破镜上天犹未已。\n田家屋老半閒茅，带雨旋抽仍数米。\n雨中集霰初廉纤，雪中更把来麰占。\n麰今一粒不入土，倘有些小黄厌厌。\n春耕仰麦今无麦，欲驱秧马饥无策。\n富人露廪矗如林，价高少室山人索。\n贪夫相时为利谋，耕夫食力毋过求。\n无求尚有丰凶忧，更忧螟螣蠈与蟊。\n常平使者深长虑，少戆安知汲长孺。\n开仓振粟勇不疑，救焚孰与先救饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘漫塘寄谢宜兴三诗属宜兴索和 其一","author":"释居简","text":"医俗无如退，荣身岂俟官。\n不知狙喜怒，聊问竹平安。\n恶曲麾圆器，希同即异端。\n十虚无四壁，冷眼要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘漫塘寄谢宜兴三诗属宜兴索和 其二","author":"释居简","text":"美政喧邻壤，新诗致漫翁。\n新声能峭眇，嘉实对清空。\n药苦终成效，言甘恐害忠。\n不逢丈人行，争识古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘漫塘寄谢宜兴三诗属宜兴索和 其三","author":"释居简","text":"泳飞楼上吟，记赏竹岩深。\n鹤已几番子，棠仍千树阴。\n名随北斗上，刻笑岘山沉。\n独欠岩翁些，交游尚挂心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张南雄之官","author":"释居简","text":"一麾梅岭下，征旆踏春妍。\n响郑尚书履，收王大令毡。\n阜财昌国本，裕食佐民天。\n来岁花如雪，芳枝记驿传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"薛蓝田","author":"释居简","text":"蓝田新续记，莲幕又登贤。\n次迟初潜地，荣如利见年。\n熊飞占吉梦，綵侍未华颠。\n天予先成佛，无庸缓著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陪方江阴宗谕劝耕过宋景文墓田次日得其唐书草并侍郎诰","author":"释居简","text":"千骑精明振物华，麦畦分处槿篱斜。\n山虽有尽春无际，李竟不言桃自花。\n绿涨新添前夜雨，青归不减去年畬。\n酒杯弗酹刘伶土，重为斯文一叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"君山吊古","author":"释居简","text":"梏足晶荧佩陆离，无人从事一丸泥。\n谋疏与国迷同体，恨逐东流竟噬脐。\n俗好永怀兄弟逊，金多盍愧斗牛齐。\n潮来只打君山脚，渺渺江空宇宙低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁楷画钟馗并引鹤归云际携琴过涧西三题 其一","author":"释居简","text":"华清横玉落梅愁，不寤人谋蔽鬼谋。\n白面书生名字贵，还如版筑梦中求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁楷画钟馗并引鹤归云际携琴过涧西三题 其二","author":"释居简","text":"唤起胎仙细问伊，几时华表柱头归。\n一编玄草都收拾，种玉田东伴采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁楷画钟馗并引鹤归云际携琴过涧西三题 其三","author":"释居简","text":"不是忘弹閟古音，怕人误赏玷琴心。\n云西六六峰前去，挂壁梧桐槁弗瘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨园四题 其一","author":"释居简","text":"草薰薰，木欣欣，海棠昨日随雨零。\n牡丹欲放金紫新，馀芳各自争鲜明。\n小圃日涉不日成，品分目署月旦评。\n是家当年驾卢骆，祖烈亭亭相博约。\n振陋锄荒十亩馀，坐看鸢飞与鱼跃。\n奇奇怪怪幻玲珑，白白红红相杂错。\n小伫人间日月长，更拓胸中小丘壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨园四题 其二","author":"释居简","text":"凉自红酣起，香从静胜闻。\n虹梁虽可跨，龙液不须焚。\n天作池中底，风成水上文。\n倚楹闲意绪，只与月平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨园四题 其三","author":"释居简","text":"堑断垣颓井不移，秀盘古色尚依稀。\n兴亡千载谁相委，华表柱头丁令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"燕归","author":"释居简","text":"旧巢新补画梁西，趁得兰塘雨后泥。\n莫忆年年归去路，蜃楼高处海云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月三十日","author":"释居简","text":"笑贾长江惜语离，苦留春到五更时。\n怕伤怀似阳关别，何似悠然睡莫知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻盘隐府判换阙","author":"释居简","text":"两考在官当有俸，三年待次已无馀。\n骥虽暂展淹州佐，鹓欲成行盍内除。\n湖上玄猿嗟宿草，帐中丹顶喜新雏。\n青冥脚脚平如砥，浩荡沧江兴弗疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢盘隐府判","author":"释居简","text":"秋檐去年约，夜色正中旬。\n月堕水中影，沙明镜里人。\n杜鹃移树怨，蝙蝠抵帘嗔。\n谁报明朝喜，灯花剪剪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王守除本路仓使","author":"释居简","text":"把茅著在深云里，亦有残畬近水边。\n不作山人沽善价，更饕司业养廉钱。\n皇华未远难为别，倦翮嫌高弗足怜。\n来岁小团新锡赉，从公酌第四桥泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周氏小阁漫堂名之曰燕超","author":"释居简","text":"蜂懒蜜脾香，将雏燕子忙。\n种萍翻尽絮，蕃稻浸成秧。\n梅子雨初溽，蘋花风未凉。\n卯金天禄阁，芳墨浩淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜀葵满庭","author":"释居简","text":"鬘缀薰风舞袂凉，依稀五竺饭空王。\n未哦玉唾三千偈，先列金钗十二行。\n桂殿冷滋分素洁，魏家新紫拟芬芳。\n华林锦绣连铜雀，叶叶倾斜背太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋日赠竹邻陈上舍","author":"释居简","text":"秋夏才交事，征轮勇欲飞。\n有诗上行卷，无地扣吟扉。\n梅雪玲珑瘦，瓜藤蔓延肥。\n侯鲭易充悦，不似北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"捣药禽","author":"释居简","text":"大药何年窃得灵，广寒去伴月长生。\n至今弱羽沾馀沥，犹作当时杵臼声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"啸云","author":"释居简","text":"月下悠然洞杳微，弗谐琴筑与埙篪。\n不知林谷鹓鸿响，何似南阳抱膝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贫女观音","author":"释居简","text":"雪藕铢衣不自珍，人间丝枲谩纷纭。\n何如小白花山上，别剪彤霞与白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茂书记归闽 其一","author":"释居简","text":"出岭新吟问老铦，丹青费尽笑无盐。\n涧阴雪立寒更尽，才识元戎玉帐严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]