[{"title":"句 其一","author":"田亘","text":"趁暖不随千卉折，凌寒先伴六花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"田亘","text":"临溪照影为谁好，映竹无人空自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"田亘","text":"巡檐一笑屑琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"田亘","text":"粉蝶风烟外，黄云草树秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"田亘","text":"已呼白面书生去，更约青腰玉女来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"田亘","text":"少时解奏三千牍，老去犹翻十二经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅","author":"王直方","text":"纷纷红紫虽无韵，映带园林却要渠。\n谁遗一枝香最胜，故应有客问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳游金明池","author":"王直方","text":"游丝堕絮惹行人，酒肆歌楼驻画轮。\n凤管遏回云冉冉，龙舟冲破浪粼粼。\n日斜黄伞归驰道，风约青帘认别津。\n朝野欢娱真有象，壶中要看四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮安园","author":"王直方","text":"贤王经别墅，深窈近严城。\n花竹四时好，宾朋一座倾。\n阖奁争弈罢，击钵记诗成。\n明日朝天去，门扃鸟雀惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉蕊花","author":"王直方","text":"阆苑瑶林春晚芳，仙妃舞困卸霓裳。\n蠙珠委地隳云佩，尚带天边风露香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清芬阁","author":"王直方","text":"人以诗自业，在唐如蜂房。\n香英众采撷，论功归其王。\n恭维少陵老，实提六义纲。\n人能分一体，犹足生辉光。\n元英萧散人，亦以诗道昌。\n馀隽独不吮，嘉殽常自将。\n沧江下千寻，便足知流长。\n元英不可见，看取尚书郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终颂","author":"何士昭","text":"五十年住人世，灵台不染纤瑕。\n壬午三更子时，天开万里无霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"韩瑨","text":"已束归鞍逐去鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方潭展墓示子侄","author":"刘安上","text":"旧庵在山顶，去此五里馀。\n创谋自吾祖，迁就今所居。\n往时僧不多，苟且完室庐。\n至于五十载，风雨荒榛芜。\n先人乐溪山，每到尝踌躇。\n深怜栋宇弊，缔构新是图。\n凿岩辟幽径，开门揖清虚。\n高堂闳且深，三山列庭隅。\n或禅或教律，济济跄衣裾。\n先茔旧所卜，乃在西南隅。\n松筠老且茂，云气时卷舒。\n政和甲午岁，予解寿春符。\n宽恩得真祠，展省来郊墟。\n清酹奠墓隧，诰轴焚金朱。\n报效未云讫，涕泗徒涟如。\n朅来就堂宇，会饮族属俱。\n夜深灯火明，山静竹柏疏。\n翻思昔日营，似为今所须。\n先人笃好善，雅志在诗书。\n于公有阴德，高大其门闾。\n虞诩名升卿，其后果不诬。\n嗟余忝厥修，覆败良可虞。\n作诗以自警，其无迷厥初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁寒亭","author":"刘安上","text":"兹亭予所作，再到异畴昔。\n江梅老半枯，桧柏春逾碧。\n易名为岁寒，表此苍翠色。\n森然一径幽，步屧时取适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清涟亭泛舟","author":"刘安上","text":"高树环清池，波平春正绿。\n移舟近南崖，倒影见华屋。\n危梁属修径，幽思生远目。\n更登狎鸥亭，可以忘宠辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋杂咏六首 其一 葵花","author":"刘安上","text":"物性不可夺，葵藿倾太阳。\n为臣兹取节，万古有馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋杂咏六首 其二 桧","author":"刘安上","text":"蔚蔚傲霜叶，亭亭绿池畔。\n莫言盈尺材，要是淩云干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋杂咏六首 其三 竹","author":"刘安上","text":"繁枝喜删除，劲节见独立。\n灌溉未逾浃，新笋已戢戢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋杂咏六首 其四 冬青","author":"刘安上","text":"得名固不诬，对植近庭庑。\n叶绿带寒烟，花繁泣微雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋杂咏六首 其五 菊","author":"刘安上","text":"移根近轩墀，不使众草没。\n会见黄金英，泛我杯中物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋杂咏六首 其六 石斛","author":"刘安上","text":"凿石空其中，贮水凡几斛。\n渊渟或可鉴，童子慎毋触。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万田道中","author":"刘安上","text":"水阔疑无路，云深仅有山。\n儿童划小艇，出没稻塍间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方潭","author":"刘安上","text":"饭饱云岩粟，茶甘碧涧泉。\n我来无一事，危坐听山蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花靥镇二首 其一","author":"刘安上","text":"下蔡嬉游地，春风万杏繁。\n谁家堪系马，青壁竹篱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花靥镇二首 其二","author":"刘安上","text":"花靥谁名镇，梅装自古传。\n家家小儿女，满额点花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长溪建善寺四首 绣谷堂","author":"刘安上","text":"山谷谁能绣，华堂得此名。\n春风无辙迹，红紫自敷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长溪建善寺四首 龙湫亭","author":"刘安上","text":"亭下一杯水，澄泓如有容。\n不因求得雨，那信有神龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长溪建善寺四首 燕庵","author":"刘安上","text":"已涉艰危地，方能处燕安。\n人间不可忽，须向静中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长溪建善寺四首 白莲堂","author":"刘安上","text":"潇洒献公房，幽深古道旁。\n山形半环小，池面一奁方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长溪建善寺四首 仙岩庄","author":"刘安上","text":"山势从东转，河流自北来。\n地幽饶水竹，山迥少尘埃。\n城郭居何远，舟船暮可回。\n此中栖息稳，怀抱一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九宴集天柱间","author":"刘安上","text":"皖国逢重九，登临摇落天。\n盍簪追往事，吹帽想前贤。\n入眼吴萸紫，开觞邓菊鲜。\n五云亭最好，争奈近灵仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡子文游山寺值雨","author":"刘安上","text":"偷闲出城府，聊以洗尘心。\n自得林泉趣，何妨雨雾深。\n野亭连竹色，古寺想潮音。\n幸接高人论，清风满素襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆鸂鶒二首 其一","author":"刘安上","text":"鸂鶒知何许，南园春水多。\n稻粱随分有，烟雨想无他。\n世上贪毛羽，湖边足网罗。\n池塘栖息稳，慎勿厌风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆鸂鶒二首 其二","author":"刘安上","text":"幸有春池阔，双双戏晚晖。\n庭闲宜对立，翅短莫高飞。\n寇贼已闻熄，主人行且归。\n相将芰荷畔，看汝浴红衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独游竹阁","author":"刘安上","text":"极目尽天际，风烟杳霭间。\n水光清滉日，野色远连山。\n白鹿今何在，高僧此独闲。\n我今无伴侣，乘兴一跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿方潭","author":"刘安上","text":"山中何所有，一味静难名。\n暗谷流泉响，疏林落叶声。\n夜深寒月白，霜重晓钟清。\n早出松间路，衣裘空翠凝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠释达夫","author":"刘安上","text":"云房依古城，阒静户常扃。\n苦行人难及，高吟鬼亦听。\n望馀秋水远，定起暮山青。\n世谛都无念，逢人自说经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和少伊同左经臣湖上作","author":"刘安上","text":"共访招提去，轻舟漾晓风。\n水光云影里，山色酒樽中。\n边戍今休卒，吾生免转蓬。\n兹游惜不与，犹喜一篇同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小饮","author":"刘安上","text":"南窗闲徙倚，风露已秋深。\n晚色兼凉至，浮云带日阴。\n池荷欺碧玉，篱菊暗黄金。\n时序将遒尽，翻惊壮士心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶院紫翠阁","author":"刘安上","text":"小阁面空阔，下临寒水清。\n前山挂锦绣，日落转分明。\n沙际小舟远，云间归翅轻。\n我来看不厌，伫立独含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"便斋","author":"刘安上","text":"芙蓉已过菊花残，独有松筠耐岁寒。\n一榻萧然无个事，坐看红日上栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登炼丹山三绝句 其一","author":"刘安上","text":"攀沿绝壁上高峰，下瞰尘寰杳霭中。\n未饮刀圭跨鸾鹤，已如身世脱樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登炼丹山三绝句 其二","author":"刘安上","text":"神仙已往遗基在，丹井凄清绝点埃。\n归去漏残初睡醒，恍疑身到洞天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登炼丹山三绝句 其三","author":"刘安上","text":"群峰耸拔更回环，鹤驾分明缥渺间。\n金鼎丹成人不见，但留名字镇空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德翚梅轩月下小酌","author":"刘安上","text":"疏影横斜落酒樽，谁知寒月上梅轩。\n昔年山相栖真地，我亦全家寄此村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿栖林三首 其一","author":"刘安上","text":"谁知踪迹到桐山，赖有禅僧数往还。\n溪路水深行未得，小窗幽阁总跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿栖林三首 其二","author":"刘安上","text":"回首江乡路渺瀰，雨天行色倍迟迟。\n最怜山寺留连日，恰是清明禁火时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿栖林三首 其三","author":"刘安上","text":"征鞍终日雨霏霏，投宿栖林旋燎衣。\n天意似怜行客倦，放将红日出岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建善即事三首 其一","author":"刘安上","text":"绣岭峰高插晚空，雨馀烟雾淡朦胧。\n琼枝细叶知多少，最爱团栾竹一丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建善即事三首 其二","author":"刘安上","text":"春归枝上馀花少，转午浓阴绿满蹊。\n何事黄鹂语音好，慇勤飞傍粉墙啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建善即事三首 其三","author":"刘安上","text":"箨龙亭下知谁种，旋见新篁破绿苔。\n到此不知才几日，抽梢今已过墙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄沙二首 其一","author":"刘安上","text":"轩窗高下傍岩隈，花木层层取次栽。\n谁道山深春色晚，等闲桃李已齐开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄沙二首 其二","author":"刘安上","text":"飞山彷佛如天竺，环合峰峦一径通。\n何日再来亭上宿，静听猿叫月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大中西庵","author":"刘安上","text":"借得西庵不似庵，宛如蜗舍住城南。\n晚来一盏亮功酒，更荐栖林八寸柑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"硖石相对有项羽庙","author":"刘安上","text":"乘閒驱马向高原，楚汉遗基尚宛然。\n堪怜项羽成何事，占得淮边屋数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村渔舍","author":"刘安上","text":"江边茅屋被风掀，雨打疏窗夜小眠。\n催唤儿童五更起，重添篾缆系渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"刘安上","text":"秋半凄然客思清，杖藜何处畅幽情。\n晚天风雨莓苔活，閒傍栏干取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出局纪怀","author":"刘安上","text":"国尔忘家是所先，如何交构竞争权。\n霜台白简真可畏，一日五公俱左迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅","author":"刘安上","text":"双成送我蜡梅花，夜静幽香自一家。\n疑是素娥乘月下，淡黄衣袂紫云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿桐城驿二首 其一","author":"刘安上","text":"大农遗爱在桐川，血食于今几百年。\n应想岁丰秋赛日，送迎歌舞独喧阗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿桐城驿二首 其二","author":"刘安上","text":"桐溪古驿闻来久，我到梅黄雨细时。\n砌下流泉无复有，空馀松柏覆檐垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"刘安上","text":"江烟淡淡日落后，山雨纤纤潮上初。\n黄莺引雏过林杪，群鸡就食喧阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澄源堂落梅如茵","author":"刘安上","text":"落英回旋雪飞馀，谁向庭中细细铺。\n借与翠娥相应舞，绝胜西蜀锦氍毹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安丰道中","author":"刘安上","text":"陂渠积水与田通，彷佛江乡意趣同。\n引起三吴耕钓兴，小舟来往藕花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘露亭二首 其一","author":"刘安上","text":"涵碧轩前甘露亭，暑天凉夕此闲行。\n琅玕一亩森如玉，影入池心彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘露亭二首 其二","author":"刘安上","text":"水斛安排镜面平，菰蒲初种已齐生。\n晚来雨过浮萍少，看见鱼儿作队行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舒州西门送客亭","author":"刘安上","text":"拂云亭外竹千竿，静听清声戛玉寒。\n却忆谢公岩下路，水风凉处战檀栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人新居","author":"刘安上","text":"门向平湖静处开，雨馀山色入帘来。\n连云竞秀千岩竹，隔水飘香一径梅。\n观里紫芝元不老，柱头玄鹤几时回。\n此峰信是神仙窟，子晋吹箫有旧台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登谢公楼分韵得心字","author":"刘安上","text":"高峙危楼压翠岑，登临遥想昔贤心。\n人随岁月有兴废，名逐江山无古今。\n残日汀边生晚思，断云帘外捲晴阴。\n清风凛凛今何在，芳草池塘恨独深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"刘安上","text":"未寻南郭旧生涯，且向淮堧太守家。\n西圃学栽陶令菊，后园时种邵平瓜。\n民淳讼少看空圄，吏散庭空听报衙。\n更得岁丰多乐事，宦游谁复问年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄叔静","author":"刘安上","text":"频年京阙暗胡尘，窃发桐庐更骇闻。\n食尽犬羊还自毙，火炎蝼蚁却须焚。\n中原已有汾阳将，二浙谁驱下濑军。\n州郡虽严防守计，可将知略佐忠勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和左经臣见过","author":"刘安上","text":"为爱端居上郡章，里闾何幸得徜徉。\n买田郭外春耕早，筑室湖滨野趣长。\n且把旧书遮病眼，了无尘事扰中肠。\n故人访我留佳句，应笑年来两鬓苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆溪有怀","author":"刘安上","text":"自从南郭得三椽，怕趁荆溪半夜船。\n每望白云惊岁月，空将清梦绕林泉。\n虽因追远时来此，又见登高意惨然。\n极目不知多少恨，一声孤雁夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣泉","author":"刘安上","text":"闻道东山有圣泉，杖藜侵晓到山前。\n一泓寒玉流无尽，万顷良田大有年。\n茶鼎晓煎云脚嫩，斋厨夜引溜声圆。\n我来一酌磁瓯去，终日馀甘齿颊边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]