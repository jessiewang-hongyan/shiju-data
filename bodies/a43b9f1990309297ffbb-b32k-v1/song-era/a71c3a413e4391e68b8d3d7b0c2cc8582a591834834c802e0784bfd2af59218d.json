[{"title":"避风","author":"刘攽","text":"南风多叠浪，逆水暂回船。\n画鹢秋相对，沙鸥静独眠。\n微明见云树，孤绝问人烟。\n吾道常如此，听歌枉渚邅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同原甫咏秘阁诏藏古器图","author":"刘攽","text":"昔占金宝气，天瑞告成功。\n绘事今时绝，书文自古同。\n剖钩记巫锦，按刻异桓公。\n尘世无由睹，昆山策府中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王广渊郎中挽诗","author":"刘攽","text":"家本秦川贵，旧传淮水占。\n省郎时望在，公族主恩兼。\n转烛风何急，栖尘草正纤。\n襄阳今罢市，涕泪万人沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘彝学士挽诗","author":"刘攽","text":"传闻四君子，同是五经师。\n独以功名误，空思俎豆为。\n不成宣室召，长负雁门期。\n赖有铭泉室，千秋无愧词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过观音精舍旧读书房","author":"刘攽","text":"往作关东客，来携一束书。\n旅人观所主，野性乐玄虚。\n过事都如梦，精庐宛若初。\n空怜两蓬鬓，萧飒十年馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过雍熙院兴师房","author":"刘攽","text":"习静未离解，悟空犹著禅。\n斋居性所近，古寺境萧然。\n瓶水寒生冻，炉香暝袅烟。\n老僧眉雪白，晏坐已忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨","author":"刘攽","text":"天暝龙蛇化，风高鸟兽呼。\n尘嚣一洒尽，暑病暂时苏。\n电火将焚野，雷车若隘涂。\n坐疑陵谷变，明发蹈江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上夜雨","author":"刘攽","text":"江黑暮潮生，云深骤雨倾。\n风波两舟语，灯火一川明。\n短夜苦难曙，羁怀方未平。\n空怜梦中路，依约尽归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆寿挽诗二首 其一","author":"刘攽","text":"史占书五鹿，世德活千人。\n孝养东朝盛，徽音赤管新。\n濯龙虚望幸，茧馆不知春。\n历数姜任事，宁如复辟辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆寿挽诗二首 其二","author":"刘攽","text":"卤簿严仙仗，笳箫去掖门。\n昼閒长乐卫，春寂灞陵园。\n壹德诒谋地，群生顾复恩。\n神游馀仿像，日入际昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"营冬二首 其一","author":"刘攽","text":"羁旅殊多事，崩腾欲老身。\n连年俱异邑，几地愧邻人。\n板屋秦诗旧，衡门泌水新。\n何时仲长子，卜筑离风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"营冬二首 其二","author":"刘攽","text":"薙草元留径，开窗祇近檐。\n成冬须少有，为客未尝淹。\n朋旧看都绝，诗书剩欲嫌。\n自知疏懒剧，决意老幽潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归","author":"刘攽","text":"扁舟到北郭，屣履向东门。\n不改蓬蒿陋，犹怜松菊存。\n因秋动归兴，值物怆离魂。\n早晚城头月，呼儿坐小轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨花","author":"刘攽","text":"不分春色晚，杨花意气骄。\n吹嘘轻一羽，容易点层霄。\n细细穿檐隙，姗姗学舞腰。\n暂来幽僻地，还复去人遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移居观音寺","author":"刘攽","text":"栖息避城市，尘埃将浼人。\n虚空见佛性，简傲得吾真。\n霜过草木改，斋馀鸟雀驯。\n席门常昼闭，谁与驻车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陕西图三首 其一","author":"刘攽","text":"干戈今日事，关塞此图看。\n白日长安近，苍山垄坂寒。\n由来名百二，自古有艰难。\n指以安西道，凝情意据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陕西图三首 其二","author":"刘攽","text":"万里灵州地，他年汉朔方。\n山河从割弃，关辅急堤防。\n转益豺狼窟，堪嗟礼义乡。\n拔胡须壮士，看画意苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陕西图三首 其三","author":"刘攽","text":"河源来积石，天马涉流沙。\n耳目成千古，丹青在一涯。\n荒凉都护府，断绝使臣槎。\n安得山河将，收功似汉家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月","author":"刘攽","text":"五月黄梅熟，江边昼雨初。\n锈痕侵匣剑，润气蠹囊书。\n乱恐翻银汉，喧愁泄尾闾。\n时时双水鸟，往往上吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上雨中","author":"刘攽","text":"江云似无信，山雨易翻盆。\n鹏起天形黑，龙骧水面浑。\n大舟才弱缆，孤树小前村。\n濯热吾知慰，风波勿重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王待制湘东王故苑","author":"刘攽","text":"故园悲帝子，高兴复清秋。\n密竹娟娟静，通波细细流。\n干戈馀鲁殿，池沼似沧洲。\n鱼鸟应无恨，山公肯醉游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬暖","author":"刘攽","text":"南瘴无消息，玄冥为失威。\n水深鸿雁宿，霜薄鹧鸪飞。\n处处怜乔木，人人惯袷衣。\n生涯卑湿地，日饮自知机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忝官","author":"刘攽","text":"忝官东北藩，老拙复何言。\n曹事辄付外，客车稀到门。\n临池看鱼乐，倚杖听禽喧。\n莫恨三年最，从今长子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中","author":"刘攽","text":"沈阴连日雨，六月似高秋。\n凉冷宵眠稳，泥涂昼事休。\n尘昏旧铜镜，朽蠹敝貂裘。\n赖有盈樽酒，能为懒病谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后","author":"刘攽","text":"积雨黄梅后，多风夕景天。\n少阴回玉烛，秋气变薰弦。\n孤鸟爰居外，残云螮蝀边。\n羽陵书蠹尽，数怪绝韦编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲雨","author":"刘攽","text":"久晴惊础润，信宿候风回。\n仰月光如瓦，烧云色变灰。\n欢蛙疑自得，青鹢竞飞来。\n正想江南地，清凉接过梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北窗闻雨","author":"刘攽","text":"庭梧不隐响，秋入意萧条。\n过雨喧天籁，高风会海潮。\n寒侵知洒近，气豁想云遥。\n岁晚看摇落，无衣耻敝貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨","author":"刘攽","text":"繁阴昼漠漠，日雨暝纷纷。\n斗蚁仍移市，乖龙亦过云。\n泥涂休不出，钟鼓遣相闻。\n愿得辞昏垫，长风破宿氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾轩雨中二首 其一","author":"刘攽","text":"小雨疏阴响，高风绿幕斜。\n冷吹能却暑，细滴不妨花。\n轻湿苔痕滑，连阴草色加。\n路长车马少，暂喜息飞沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾轩雨中二首 其二","author":"刘攽","text":"病身常自力，杖屦及比邻。\n继日伤霖雨，深居若避人。\n阴苔无数绿，秋草一番新。\n入夜添凉冷，书灯顿可亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巢湖阻风二首 其一","author":"刘攽","text":"重云迷日月，异县失西东。\n苦畏连天水，何须竟夕风。\n微明分白鸟，摇落望青枫。\n久客嗟留滞，吾生事事同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巢湖阻风二首 其二","author":"刘攽","text":"四月风犹北，湖边气似秋。\n天时如反置，吾道信淹留。\n望远还吹帽，憎寒更拥裘。\n无由开白日，晦暝使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安河阻风","author":"刘攽","text":"随湖寄渔浦，村戍起孤烟。\n水色连天黑，沙禽亦昼眠。\n柘田春种麦，客渡晚争船。\n尽日无他事，寻村听野泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凝翠堂","author":"刘攽","text":"耸耸排修竹，萧萧拂蠹檐。\n秋声送凉雨，晚影碎寒蟾。\n居处贫非病，生涯智养恬。\n著书聊自守，非欲效幽潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留张十二宿","author":"刘攽","text":"静外尘土息，故人从我游。\n襟怀已潇洒，杯酒聊劝酬。\n大笑呼五白，浩歌遣四愁。\n劳生如此少，叹息为君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王太傅河北阅马","author":"刘攽","text":"丰草河壖地，平沙冀北区。\n离宫连苜蓿，旧苑半騊駼。\n夫子深诗者，无邪颁使乎。\n宁令汉马少，不议击匈奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庶几堂","author":"刘攽","text":"碧草衡门里，凉天过雨初。\n惊秋数甲子，隐几读残书。\n近郭多鸣鹤，坳堂可钓鱼。\n异方无到客，非是故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁除立春乾祐县献梅","author":"刘攽","text":"除日应无岁，新春不待年。\n风光生意里，梅信客情边。\n冷艳来冰谷，疏风映雪天。\n不逢江上使，相与竞芳妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽胡太傅二首 其一","author":"刘攽","text":"州来推博物，伯始贵中庸。\n论道宜黄发，铭功遍景钟。\n龙门馀旧客，马鬣怅新封。\n后世瞻遗德，南山万丈峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽胡太傅二首 其二","author":"刘攽","text":"路车申伯去，白马庾公归。\n殄瘁人相吊，哀歌露易晞。\n石麟森立木，蜜印锁泉扉。\n絮酒惭徐孺，回看旅雁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽西京左藏使石太保二首 其一","author":"刘攽","text":"勇掷诸生笔，终乘使者车。\n家声唯孝谨，将略亦诗书。\n鹤发遗荣始，泷冈卜兆初。\n谬承公叔荐，曾未撇衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽西京左藏使石太保二首 其二","author":"刘攽","text":"青绶股肱守，毳衣方伯监。\n威名真落落，硕望自岩岩。\n道远年如待，才长志尚缄。\n家多二千石，会见集门凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋司空丞相二首 其一","author":"刘攽","text":"斗枢齐七政，鼎铉象三公。\n文武兼人际，安危注意同。\n规随馀故事，止足畅高风。\n他日云台画，依然想窦融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋司空丞相二首 其二","author":"刘攽","text":"蜜印加泉室，哀箫去国门。\n降龙严冕服，画鹿并车轓。\n山甫中兴业，臧孙既殁言。\n定应天壤内，长与日星存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜吹箫","author":"刘攽","text":"长路见秋月，空江连夜明。\n吹箫不能寐，举酒递相倾。\n贾客或垂泪，羁人多失声。\n湘弦苦沉绝，曲尽一含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国公主挽诗","author":"刘攽","text":"渭阳追舅氏，婺女嫁天孙。\n平日诸姑问，当时赤绶尊。\n烟波空北渚，荻竹自长门。\n后夜秦楼月，哀箫閟九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿岘山寺二首 其一","author":"刘攽","text":"眷予倦羁旅，坎壈林壑间。\n落日投古寺，秋虫吟乱山。\n月明露已白，风定云方还。\n王事殊未暇，怅兹清夜閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿岘山寺二首 其二","author":"刘攽","text":"苍山若无路，落日听鸣钟。\n旁舍适眠虎，古潭微见龙。\n空窗向云月，高枕听风松。\n幽境昔未遘，仙游如可逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观虎翼士戍宜州","author":"刘攽","text":"虎贲王爪士，铜柱国南门。\n魑魅非人境，蛮夷尽鸟言。\n瘴烟旗纛黑，雾雨剑铓昏。\n即路皆无色，何时见北辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再见士卒戍桂阳","author":"刘攽","text":"驿书频插羽，汉士远征蛮。\n四月天将暑，三苗旧阻艰。\n悲笳背城邑，苦雾湿关山。\n后夜东南望，妖氛翼轸间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼杨公缊二首 其一","author":"刘攽","text":"得君虽恨晚，白发幸前期。\n分手遂陈迹，晤言成独悲。\n隙驹得未久，风烛不胜危。\n讵有修文选，高天可易知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼杨公缊二首 其二","author":"刘攽","text":"寄书曾未报，题墨宛如新。\n长路归丹旐，孤儿泣画輴。\n江湖馀气槩，星月聚精神。\n冥漠九原上，空将万鬼邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"刘攽","text":"摇落看秋色，淹留倦郢城。\n登临想自昔，风土最含情。\n白露黄橙熟，清风绿桂生。\n异乡随众醉，须尔析朝酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"刘攽","text":"蒹葭晚已变，天宇向来高。\n风露一潇洒，江湖久郁陶。\n鲈鱼越人脍，白露广陵涛。\n归兴凭三鸟，悲秋叹二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夕雾","author":"刘攽","text":"日落山气改，汀洲寒雾生。\n深沈转墟落，迢递失重城。\n树里迷人语，沙头见火明。\n商帆宿何处，彷佛棹歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"签判承议携官酒并具殽炙晚饮桧下二首 其一","author":"刘攽","text":"烦携光禄酒，愧举使君觞。\n伏尽转秋热，月明才夜凉。\n暗蛩声蕊蕊，古桧影苍苍。\n衰老淡薄味，殽蔬犹遍尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"签判承议携官酒并具殽炙晚饮桧下二首 其二","author":"刘攽","text":"风月近秋好，君来蒙十觞。\n尘劳我休息，炎暑此清凉。\n玉露衣襟爽，金波鬓发苍。\n知心一为足，何必似原尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仪父清溪县丞","author":"刘攽","text":"虽方六七十，皆有万千家。\n赞府亦制锦，到官殊及瓜。\n山苗甘笋蕨，溪饭饱鱼虾。\n为尔传清白，遗黎每叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和周承议登仙源宫楼","author":"刘攽","text":"屏星驻真境，乔木尽萧森。\n野旷日偏永，山寒云更深。\n九皇容尽信，万事盛来今。\n回首灵光殿，飞鸦起暮林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送从兄思甫尉富阳","author":"刘攽","text":"南州吏数千，尉事独神仙。\n平日稀桴鼓，端居数醉眠。\n潮声雷出海，山色剑横天。\n会尽登临兴，淹留肯计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘谊先辈尉泾县","author":"刘攽","text":"诏除芸阁吏，名属太常书。\n高第余无愧，同宗谁不如。\n乡情欢赐服，寿酒庆安舆。\n正复秋风起，沧江厌脍鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张益宣州法曹","author":"刘攽","text":"谢守宣城句，偏矜吕法曹。\n郡斋应似旧，廷掾不徒劳。\n东北归流驶，空虚去棹高。\n木瓜因赠客，并择兔千毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩康公挽词三首 其一","author":"刘攽","text":"初还丞相印，并授上公封。\n门戟交行马，衣章杂绣龙。\n策书休命毕，拜老未临雍。\n遗爱无时息，凄凉在辍舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩康公挽词三首 其二","author":"刘攽","text":"八龙归济美，四辅号无官。\n鲁卫联三寿，韦平属二难。\n大勋流竹帛，盛事绝衣冠。\n今日哀荣礼，贤豪共永叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩康公挽词三首 其三","author":"刘攽","text":"乘舆锡临吊，朝士盛班辞。\n笳鼓千人仗，辒辌数仞旗。\n坏梁萧画在，藏壑说舟移。\n无复龙渊剑，空传禹甸诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤王都官正卿","author":"刘攽","text":"巍然积德门，识此贵公孙。\n譬彼芝兰秀，行看鸿鹄轩。\n谁令武子死，无复孟尝言。\n寂寞穗帷暝，流尘空酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤胥平叔都官","author":"刘攽","text":"欲为大招赋，期子入修门。\n昔尔南宗学，惭予庄叟言。\n清樽湛凝绿，丹旐杳飞翻。\n晨夕高堂念，此情难重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤杨元明都官","author":"刘攽","text":"传家推德祖，似舅识刘牢。\n刻意鸿都学，精心常侍曹。\n万金酬六体，一字秃千豪。\n讵有修文事，苍苍空自高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归雁","author":"刘攽","text":"楚水几时绿，归鸿前后闻。\n江湖久漂泊，南北忍辛勤。\n意气融融日，声音漠漠云。\n青冥易凌厉，况复未离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中闻雁","author":"刘攽","text":"四海困横绝，经年长往来。\n雪霜空尽力，道路有馀哀。\n水宿稻梁薄，云深罗网猜。\n北方有杀气，缓缓及春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新雁","author":"刘攽","text":"南飞洞庭雁，稍复过衡阳。\n宇宙同为客，春秋各异方。\n边尘犹处处，杀气苦苍苍。\n恐有伤弓翮，哀鸣少稻粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]