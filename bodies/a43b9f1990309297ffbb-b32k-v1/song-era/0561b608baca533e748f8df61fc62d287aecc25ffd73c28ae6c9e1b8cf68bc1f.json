[{"title":"元夕遣怀二首 其一","author":"陈造","text":"陆海莲开夜色鲜，短檠灯下掩陈编。\n风姨竟日鸣条罢，月姊因谁得意圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公孙述","author":"陈造","text":"东来温诏枉丁宁，隆少忠谋肯汝聆。\n不待宾胪延马援，始知西帝偶人形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六绝句呈赵帅兼简郑机宜 其六","author":"陈造","text":"长日登临忆侍郎，芳时谭笑客凝香。\n须公多办琼花露，容我时开古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六绝句呈赵帅兼简郑机宜 其五","author":"陈造","text":"蒲鞭閤束久停檛，暮府人闲早放衙。\n频唤羊何把诗笔，即看姚魏用年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六绝句呈赵帅兼简郑机宜 其一","author":"陈造","text":"南徐把酒送行行，话我漂零倍怆情。\n屈指六年才一梦，更消几梦了浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六绝句呈赵帅兼简郑机宜 其三","author":"陈造","text":"雁塔题名尽俊贤，即今十八卧重泉。\n合离荣瘁何须较，强健相过是半仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六绝句呈赵帅兼简郑机宜 其二","author":"陈造","text":"玉笋班中第一流，冰花影里釂琼舟。\n来迟输与花前客，袖手看公笔不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六绝句呈赵帅兼简郑机宜 其四","author":"陈造","text":"宦路平时欲陆沉，先生诲语每南金。\n长庚配月空回首，古井无波已此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孔明二首 其二","author":"陈造","text":"搴蜀宁蛮走阿瞒，功名继此坐天悭。\n平生囊括华夷策，畏虎才教见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孔明二首 其一","author":"陈造","text":"古今深忌忿为兵，及霤师臣要力争。\n白帝败归思孝直，端知难抗魏元成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文帝","author":"陈造","text":"君王俭德本天然，萧相鸠营已造天。\n不见千门并万户，露台虽罢未为贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"陈造","text":"多誉庸非蠲忿草，一谦良是辟兵符。\n先生謦欬忘鸡口，俗子过逢动虎须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题三首 其二","author":"陈造","text":"才不时宜懒治生，学专信已一官轻。\n只今尚友须千载，独惜时无尚子平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题三首 其三","author":"陈造","text":"居为耕叟出为官，出处人将二致看。\n朝市山林俱乐地，却须神武挂衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题三首 其一","author":"陈造","text":"酒鸱车后无何饮，易卷床头脱复看。\n岂谓浮生须此具，世纷方解不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王逢原二首 其二","author":"陈造","text":"文章俯睨汉唐馀，属思深湛到古初。\n正使玉楼须有记，忍令银笔嗣无书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王逢原二首 其一","author":"陈造","text":"弱岁文推一代豪，诸公敛衽看颠毛。\n天于屈宋应为地，不放先生仆命骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东庄小留四首 其四","author":"陈造","text":"接屋连墙翠密中，炊香羹玉饱过从。\n人将逋客为同社，地与斜川作附庸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东庄小留四首 其三","author":"陈造","text":"亲朋樽俎日周旋，无限欢情到酒边。\n底许挤排作尊客，祇令抚己叹衰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858