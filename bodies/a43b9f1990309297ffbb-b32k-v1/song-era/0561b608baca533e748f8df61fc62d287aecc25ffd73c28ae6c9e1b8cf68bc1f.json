r":18446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其八","author":"陈造","text":"春光陆续委东流，看到湖边安石榴。\n更与苏堤鸥鹭约，办舟来赏牡丹秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其七","author":"陈造","text":"堆青泛碧放船篷，万里风前鹤发翁。\n绝境满前官不禁，此身未省叹涂穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其六","author":"陈造","text":"定结诸山粥饭缘，每归留得杖头钱。\n穿云更欲携君去，布水多烦为我先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其五","author":"陈造","text":"十字街头托钵盂，雁鹅食口待朝晡。\n我来欲序睽违意，要问扬州米价无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其四","author":"陈造","text":"杖挑初日闯云关，忽报充师早下山。\n煮茗谭诗有贤子，免教题凤怅空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其三","author":"陈造","text":"畴昔相期襆被来，饭馀归意类挤排。\n蘋风萝月孤清夜，仅见山间结夏斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其二","author":"陈造","text":"杰屋修垣著画图，连连胜士逸人居。\n乘闲我亦无羁束，竹杖芒鞋信所如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月望再游西湖十首 其一","author":"陈造","text":"前时小舫冒氛昏，重到轻桡破曲尘。\n湖面风烟饱姿态，一番到眼一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉江岸二首 其二","author":"陈造","text":"沙随秋涨漫川原，沙外人家尽毁垣。\n寄语饥羸莫深恨，西人无数饱鱼鼋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉江岸二首 其一","author":"陈造","text":"一自阳侯战雨师，枣畦桑陇但空陂。\n此君屹立如尊勇，依旧青青似昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示阿泰三首 其三","author":"陈造","text":"老稚悬知乐有馀，迎门先问小于菟。\n风烟满眼山环海，对酒还曾斲句无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示阿泰三首 其二","author":"陈造","text":"官上依然四壁空，讼庭人寂每从容。\n看家不为穿窬计，老去登临分外慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示阿泰三首 其一","author":"陈造","text":"曾倚新晴望海天，天容海色湛相鲜。\n奁中遥点群鸦影，万舶千艘忽过前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光武二首 其二","author":"陈造","text":"闭关谢质保丰功，建武规模见祖风。\n宰辅骈诛非细故，平章敢谓茂陵同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光武二首 其一","author":"陈造","text":"济业何关赤伏符，王梁不拜未云疏。\n君王幸却东封请，底事终身溺谶书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其四","author":"陈造","text":"传闻洞府锁高青，探著诗成数启扃。\n相见群仙书玉叶，更应交口叹精灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其一","author":"陈造","text":"嗣皇仁覆物昭苏，皋自陈谟鲧自吁。\n闻道诸公扶国论，须君左袒订邦诬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其三","author":"陈造","text":"漫叟当年臼作樽，侑樽青嶂漫嶙峋。\n与君屡共山前醉，似觉清欢胜昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其三","author":"陈造","text":"环秀亭中命渌樽，云烟明灭映嶙峋。\n佐州不喜分风月，喜与南山作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其四","author":"陈造","text":"诗人妙思天同巧，鬼守玄关不及扃。\n闲挹山光诵奇语，断无尘滓溷襟灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其二","author":"陈造","text":"今朝著我簿书堆，领客樽罍未办开。\n始信南山是知己，露奇呈秀斩关来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次羊羔酒韵三首 其三","author":"陈造","text":"他时阿奋辞髯簿，来作东风席上珍。\n安得方平鞭乱石，百觚陆续丐吾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次羊羔酒韵三首 其二","author":"陈造","text":"莱子杯盘别样香，春浮亲面日相羊。\n老夫底幸沾馀沥，却笑无鱼客孟尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次羊羔酒韵三首 其一","author":"陈造","text":"元放诸孙怜遽许，截肪醉骨荐馨香。\n茂先九酝犹须问，自是诗翁石作肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次还鹤韵三首 其三","author":"陈造","text":"人家往往琴堪劈，谁定如翁肯放回。\n他日飙轮驷修翮，衔恩当复誓云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次还鹤韵三首 其二","author":"陈造","text":"啅鹊却陪新饮啄，啼猿俨识旧容仪。\n可须辩士诳荆楚，似喜逐臣还秭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次还鹤韵三首 其一","author":"陈造","text":"朅来室迩念人遐，回首青田几许赊。\n飞去定惊鱼荡水，跫然今似客还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵三首 其三","author":"陈造","text":"茗瓯对客乳花浓，静听挥犀发异同。\n度腊迎春如此过，不知人世有王公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵三首 其二","author":"陈造","text":"连夜愁阴苦戒严，雪将寒雨斗廉纤。\n老人冻饿人情断，米价何如酒价添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵三首 其一","author":"陈造","text":"春事兼回寂寞滨，茅檐背日已书勋。\n径须引睡携黄奶，未办寻芳命紫君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其三","author":"陈造","text":"枝筇过我海云边，空谷人声喜欲颠。\n更喜重逢各强健，未须悽惋话彫年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其一","author":"陈造","text":"梦思游览慰衰迟，起耐阴寒不自持。\n捉笔把杯吾技痒，可堪袖手过花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其四","author":"陈造","text":"倦游祇有囊诗锦，试为高人一笑开。\n当日留题海山寺，旋闻石刻暗莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其四","author":"陈造","text":"眼向朱门每懒抬，今朝笑口为君开。\n别来却喜人争席，浪遣长须扫径苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其一","author":"陈造","text":"住山今日得宗师，妙与缁徒示总持。\n衣钵更缘延客尽，衲衣包却郑当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其五","author":"陈造","text":"精蓝端未下云居，况复僧中有后湖。\n理障禅那俱坐断，颇尝游戏到诗无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其三","author":"陈造","text":"共谭诗律更谭禅，人指昌黎接大颠。\n屏叠葛藤烧笔砚，息阴休影了残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其五","author":"陈造","text":"好在新居胜旧居，右连灵隐面西湖。\n东南胜境谁同领，我亦闲官一事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其二","author":"陈造","text":"道人心地古为徒，野鹤昂藏白月孤。\n我亦生来世缘薄，回思昏宦叹非夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次寄肯堂韵五首 其二","author":"陈造","text":"丈室云趋彼岂徒，拳拳此意忍容孤。\n即今又举二三语，说似当年邑大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其二","author":"陈造","text":"微风不放浪纹长，噞暖跳鱼三尺黄。\n祇欠高荷护千袜，醉妆浓艳媚斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵","author":"陈造","text":"二子峨冠共我长，即看紫绶映银黄。\n不须握手论家谱，更举宣尼与伯阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵三首 其三","author":"陈造","text":"连朝飞雨暗群山，局步修廊广霤间。\n会作闲人留十日，当令屐齿遍苔班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵三首 其二","author":"陈造","text":"俗尘我亦怜多病，道价师今重五天。\n投老鼎山追旧约，未妨林壑著臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵三首 其一","author":"陈造","text":"得君清句我愁无，不惜长哦缺唾壶。\n句法森严谁到此，了知岛可但中涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次到房交代招饮韵四首 其三","author":"陈造","text":"荦确悍顽经数驿，醒然初挹碧嶙峋。\n眼明骤与真山晤，不比逃虚见似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其三","author":"陈造","text":"到眼浪岐官冷热，遇人传得酒逡巡。\n曼容东老俱通梦，不劝趋荣劝养神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次到房交代招饮韵四首 其二","author":"陈造","text":"语不能工恨作堆，撚髭空对翠屏开。\n清吟赖有雕龙手，绣段联翩诏后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其一","author":"陈造","text":"公朝已后茹茅连，幕府偷闲亦所天。\n宠辱肯为差别观，道人随寓祇怡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次交代韵四首 其三","author":"陈造","text":"视草行看赐上樽，浊醪付我酹嶙峋。\n扶携谁共山前醉，从此无君度外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其二","author":"陈造","text":"作吏丁年熟李书，调官晚境曳邹裾。\n平时外慕生灾怪，嘉遁爻中有祓除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次到房交代招饮韵四首 其四","author":"陈造","text":"山色阴晴远更青，谁教睥睨枕岩扃。\n诗翁意欲移千步，安得朱符祝巨灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其四","author":"陈造","text":"颇有传诗问子山，或将赞易誉虞翻。\n先生不乏醺酣笑，问字能无款席门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]