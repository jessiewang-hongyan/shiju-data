[{"title":"读范周士诗卷二首 其二","author":"孙觌","text":"汗血苍龙种，名翚紫凤毛。\n赤霄行未稳，白雪句先高。\n月斧将谁断，风斤可独操。\n雄夸赋云梦，莫学楚臣骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈令解印赴阙三首 其一","author":"孙觌","text":"户外珑璁响玉珂，弁星遥见切云峨。\n蜗泉渺渺依龙具，凫影翩翩下雀罗。\n溜雨霜皮青嶂合，抟风云翮紫霄摩。\n八门了了登天路，一夜惊雷起壁梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈令解印赴阙三首 其二","author":"孙觌","text":"帐殿筹兵拥俊髦，风尘三尺剑吹毛。\n鸾旂低绕金舆动，雉扇旁连玉简高。\n折柳便堪当马箠，割鸡何足试牛刀。\n看君一扫欃枪尽，归握元戎虎豹韬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈令解印赴阙三首 其三","author":"孙觌","text":"乱山环合水边村，楚些谁招九死魂。\n鸟语迁枝黄叶□，蜗涎粘壁古苔昏。\n禾囷屡出将军指，菜把空怀地主恩。\n落日秋风满山色，尽驱离恨入清樽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胥泽民竹亭","author":"孙觌","text":"兵气缠三辅，胡尘暗百蛮。\n楚狂歌凤去，蜀相卧龙跧。\n露藓霾松磴，春罗挂屋山。\n呼童开翠竹，筑室待苍弯。\n碧泻褰罗带，青遥耸髻鬟。\n森罗随地辟，披写露天悭。\n川泳知鱼乐，林栖看鸟还。\n醉吟呼酒伴，逸想寄人寰。\n北海抟风背，南山浴露班。\n弓旌到林下，鞍马出门闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与李彦能范安同赴泽民之集饭后野步","author":"孙觌","text":"提壶声里有嘉招，步屐寻芳过小桥。\n万壑春风笑笙籁，一溪晴日碎琼瑶。\n虺隤未忍加鞭去，磊块惟愁着酒浇。\n云月娟娟弄人影，醉归扶路莫辞遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周士春晴二首","author":"孙觌","text":"门鹄犹残雪，林莺已唤春。\n相逢青眼见，不恨白头新。\n猎猎翻归袖，僛僛落醉巾。\n小红齐破蕾，一笑为何人。\n绿涨三家渡，红酣万户春。\n交情久客见，物态一时新。\n缥缈凌波袜，淋漓漉酒巾。\n对花身已在，应解笑陈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦妙觉新居","author":"孙觌","text":"苔花带雨上秋床，攲枕无人午梦长。\n愁极俱凭诗可遣，忧深唯有酒能忘。\n窥人谷鸟匆匆语，扑马岩花细细香。\n袖手莫夸穷事业，试将斗酒换西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题范周士潇湘图","author":"孙觌","text":"平生千里目，遥寓紫翠间。\n见此纸上语，照我胸中山。\n泛泛水俱远，悠悠云共闲。\n渔翁收晚钓，一棹醉中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐云楼","author":"孙觌","text":"他日群偷窥扑满，旱时遣患识金仙。\n颓基尚带三江水，故苑今随一炬烟。\n驹隙未过人换世，棠阴不剪树参天。\n从今免被元龙笑，茅屋三间蔽采椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎丘","author":"孙觌","text":"梦里清游一瞬间，苔留屐齿尚班班。\n千章古木秃如赭，百尺老蛟寒更跧。\n径欲乘桴蹈东海，那能拄笏望西山。\n人间俯仰成今古，青冢累累鹤未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩","author":"孙觌","text":"青莲花出古娃宫，华殷亭亭月满容。\n风籁一声传夜壑，云幢千丈荫苍松。\n曲池漫漫悲禾黍，古隧冥冥出鼎钟。\n落纸烟云供醉笔，吾宗文采擅雕龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蒋次庄二首 其一","author":"孙觌","text":"敝裘羸马老风尘，两鬓星星乱白纶。\n乘兴来寻剡溪雪，倦游归钓锦江春。\n眼中了了三生梦，俗眼欣欣一笑亲。\n急雨催诗头上黑，凭谁唤起谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蒋次庄二首 其二","author":"孙觌","text":"政拙心劳愧此身，一麾便合挂朝绅。\n青山有意迎仙客，白日相逢是故人。\n见说卑宫恢禹迹，时来击壤颂尧仁。\n玉川寸铁真无用，地上空愁虮虱臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思上人休庵二首 其一","author":"孙觌","text":"置屋苍崖上，骑鲸碧海中。\n筑闲樵径雨，门掩钓船风。\n蚁穴封千户，蜗庐斗两雄。\n区区真可笑，天地一尘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思上人休庵二首 其二","author":"孙觌","text":"阅世身如梦，捐书语更真。\n人牛俱不见，棒喝总休亲。\n败壁虫书藓，空床鼠印尘。\n滔滔天下士，应不羡知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次魏惠书二小诗代简 其一","author":"孙觌","text":"剑卧冲星斗，珠玑照海涯。\n籋云梢骥足，擘水拔鲸牙。\n议论轻馀子，文章自一家。\n堂堂楚云梦，给札赋雄夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次魏惠书二小诗代简 其二","author":"孙觌","text":"飘飘迁客去，恋恋故人心。\n墨妙传双鲤，情高敌万金。\n天旋黄道直，野迥白沙沉。\n不负青云意，繄君嗣好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘守林宗喜晴二首 其一","author":"孙觌","text":"禾头生耳釜生鱼，去马来牛迥不殊。\n飓势驱云千嶂合，雷公载雨百车输。\n长堤一决无完块，高树纷披有积苏。\n赖有娲皇补天手，一时争诵鲁真儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘守林宗喜晴二首 其二","author":"孙觌","text":"涤地愁霏欲变鱼，毗耶问疾有文殊。\n拟将十万回天去，且罄丹衷伏地输。\n忽听风声传画角，徐看日影上流苏。\n曲穷不用号眢井，呫嗫瘦词笑小儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强氏园亭二首 其一","author":"孙觌","text":"绿涨柳塘漫，红翻花径深。\n意行留胜践，孤闷破芳斟。\n倦马縻空枥，惊乌泊晚林。\n潭潭万人海，理策又归寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强氏园亭二首 其二","author":"孙觌","text":"柳外枫桥转，桑间竹径分。\n意行穿竹过，小雨隔溪闻。\n日萼团红糁，风漪织翠纹。\n不知谁主客，相值两孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋日次韵葛正卿","author":"孙觌","text":"侵晓微云渡，秋声带雨来。\n池凉噤蛙鼓，帘静閟蚊雷。\n风伯褰帷入，炎官叱驭回。\n不须移枕簟，挥麈谢徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叔毅兄佳什","author":"孙觌","text":"云梦平吞八九宽，紫髯红颊秀春峦。\n天边鸿雁心应折，竿上鲸鲵肉未寒。\n倦听山城鸣鼓角，喜瞻衡宇挂衣冠。\n培风好上天南去，莫遣荆榛簉孔鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感春四首 其一","author":"孙觌","text":"槿篱茆屋两三家，急雨捎溪燕子斜。\n万壑笙镛号地籁，一天缯絮堕杨花。\n风尘澒洞身先老，樽酒欢呼气尚华。\n虎穴参差半朝市，无嫌卑湿赋长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感春四首 其二","author":"孙觌","text":"万里蒙尘六尺舆，一丸泥蜡十行书。\n豫且往往窥鱼服，属国栖栖掘鼠馀。\n村径红稠花艳艳，沙平翠点树疏疏。\n落霞孤鹜西南望，千顷洪波浸日车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感春四首 其三","author":"孙觌","text":"村巷深深绿映人，粥饧槐火一时新。\n山河万里缠妖气，宫殿千门锁暗尘。\n几点微酸梅着子，半篙清涨水生鳞。\n岩花涧草元无主，雨洗风吹又一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感春四首 其四","author":"孙觌","text":"春物菲菲自解欢，雨鸣孤枕夜漫漫。\n忘形不到公荣饮，绝意休弹贡禹冠。\n离乱家书万金直，艰难斗酒百忧宽。\n囊空甑倒谁能救，泪湿花枝不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵四首 其一","author":"孙觌","text":"猎猎青旗傍酒家，映门杨柳受风斜。\n行穿细路迷芳草，坐对空樽数落花。\n藜杖醉扶悲确荦，角巾攲倒露苍华。\n故山渺莽愁眉外，翠竹青蒲绕白沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵四首 其二","author":"孙觌","text":"万事破除惟有酒，半生劳苦坐看书。\n青鞋云水扁舟去，朱毂风尘一梦馀。\n战格连云胡骑满，断弦挂壁旧交疏。\n春泥活活朝天路，犹有和公擅一车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵四首 其三","author":"孙觌","text":"亹亹交情青眼见，纷纷穷路白头新。\n地偏壤断门无辙，衣敝囊空甑有尘。\n但见荒村连虎穴，那知曳水暴龙鳞。\n谁人手挽天河去，一洗郊原浩荡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵四首 其四","author":"孙觌","text":"胡尘惨惨缠林莽，海气纷纷接淼漫。\n天上空传脩月斧，人中那见切云冠。\n干戈未解千忧结，杯酒相逢一笑宽。\n老眼逢春只思睡，花枝浑似雾中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新居城二首 其一","author":"孙觌","text":"戢戢盘蜗满舍东，笑看蛮触两争雄。\n便携龙具归田去，更祝豚蹄望岁功。\n未怪席门多长者，肯教壑谷问吾公。\n超然独到羲皇上，卧占南窗一枕风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新居城二首 其二","author":"孙觌","text":"肝胆寥寥楚越分，鼻端不落郢人斤。\n倚门肮脏无如我，从客雍容孰似君。\n一榻方尊徐孺子，千篇不数鲍参军。\n从今更欲论奇字，载酒重来问子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赠彦明用前韵","author":"孙觌","text":"老干轮囷不计春，强名居士愧诗人。\n共尊有若都非是，误认颜标自有真。\n忽睹二豪联白璧，坐令百鬼怖黄巾。\n它年若许陪莲社，不惜千金剩买邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送卓侍者二首 其一","author":"孙觌","text":"多病身如寄，长贫气自华。\n只将穷事业，便当老生涯。\n泥饮醉生缬，挑灯喜见花。\n殷勤香火社，问病到毗耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送卓侍者二首 其二","author":"孙觌","text":"禅客青鞋软，诗翁白帽斜。\n惊飞蝶栩栩，喜见鹊查查。\n推户风敲竹，登床雨散花。\n匆匆一笑许，只履上青霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吴生最乐轩","author":"孙觌","text":"曲径通林樾，幽栖见草堂。\n松云春细细，山雨夜浪浪。\n逐臭如闻鲍，吹齑若探汤。\n平生为善乐，应不羡濠梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅见寄二首 其一","author":"孙觌","text":"风尘蹭蹬悲游子，鸡黍招邀愧老农。\n盗取青毡无旧物，书凭黄耳有先容。\n乞怜不辨齐门扫，投老宁堪楚市舂。\n回首故山劳梦想，楼高百尺卧元龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔毅见寄二首 其二","author":"孙觌","text":"莫遣声名夸俗子，且将筋力伴耕农。\n五湖鱼鸟非先素，一坞山林肯见容。\n翠出短樊供小摘，香浮大甑饱新舂。\n邻翁莫怪频来集，门户如今有八龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和别韵","author":"孙觌","text":"岁阴衮衮惊心折，世事纷纷触眼新。\n烁烁风灯深院雨，离离花草故城春。\n一区栽自无宁处，五斗谁能更为贫。\n矢醉自醒还自笑，依稀却是梦中真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送天宁维老","author":"孙觌","text":"犀颅月面表千夫，吏用公才举世无。\n斗丽争雄何足道，君看澄观岂僧徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邹志新致书酒荔枝山栗海错之馈四绝 其一","author":"孙觌","text":"门前剥啄响鸣驺，十里惊尘满地流。\n恋恋绨袍故人意，一书何啻万金投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邹志新致书酒荔枝山栗海错之馈四绝 其二","author":"孙觌","text":"窥檐双鹊语匆匆，一夜灯花缀玉虫。\n便有曲生来过我，尽推愁入酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邹志新致书酒荔枝山栗海错之馈四绝 其三","author":"孙觌","text":"白鸦谷口叶盘秋，荔子今无驿使求。\n零落共谁一笑粲，殷勤为报赤心投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邹志新致书酒荔枝山栗海错之馈四绝 其四","author":"孙觌","text":"蛮珍不说紫驼峰，怪雨腥风起坐中。\n莫遣蔡谟勤学死，须君尔雅注鱼虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斗酒同小诗送杨君圣四绝 其一","author":"孙觌","text":"糟床滟滟玉虹流，洗尽胸中万斛愁。\n待看百篇供太白，不将一斗换凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斗酒同小诗送杨君圣四绝 其二","author":"孙觌","text":"天禄先生第一流，著书曾赋畔牢愁。\n何人载酒论奇字，彷佛虞箴是九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斗酒同小诗送杨君圣四绝 其三","author":"孙觌","text":"习池尊俎擅风流，一洗干戈四海愁。\n倒着接篱扶上马，举鞭一笑问并州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"斗酒同小诗送杨君圣四绝 其四","author":"孙觌","text":"一水横分醉眼流，两峰遥蹙黛眉愁。\n醉眠千日中山酒，不羡三刀梦益州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简彦廓求梅花二绝 其一","author":"孙觌","text":"畏寒春半尚跧藏，闻说江梅已弄芳。\n全树不妨分一朵，夜窗时作定中香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简彦廓求梅花二绝 其二","author":"孙觌","text":"折来犹自带春寒，入手谁穷造化端。\n钿玉半含金蘸雪，嗅香须更细看看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和公权梅花用前韵","author":"孙觌","text":"雪香琼瘦逼人寒，闲澹精神画亦难。\n照水可怜清更甚，不堪浑作镜中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢公惠梅花","author":"孙觌","text":"今年春晚懒寻芳，独掩寒斋政坐忘。\n多谢风流濠上掾，凌晨分我一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和落花流水四绝句依长文侄韵 其一","author":"孙觌","text":"雨花着地燕脂湿，风柳飘空帽絮披。\n粉黛纷纷半黄土，蟹螯从此不须持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和落花流水四绝句依长文侄韵 其二","author":"孙觌","text":"菌短椿长未易齐，雨花风叶任纷披。\n甑盆已破谁能改，趺坐观空且对持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和落花流水四绝句依长文侄韵 其三","author":"孙觌","text":"老怯风波一棹回，故园芜没半苍苔。\n水深莫遣蛟龙得，火急招归海贾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和落花流水四绝句依长文侄韵 其四","author":"孙觌","text":"浅浅微波照残影，溅溅流润细萦苔。\n浮花浪蕊相随去，莺语丁宁挽不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游惠山偶书","author":"孙觌","text":"春到梵王家，千林已着花。\n小桃无限思，竹外一枝斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"主簿甥孙小舟载白菊一本见遗赋二小诗为谢 其一","author":"孙觌","text":"飞琼乘月下瑶台，老眼惊窥一笑开。\n冰雪定嫌诗酒污，不应更待白衣来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"主簿甥孙小舟载白菊一本见遗赋二小诗为谢 其二","author":"孙觌","text":"水槛吹香风渐渐，月丛泛彩露团团。\n高情不入梨花梦，蝶乱蜂狂可得干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯瑩上人","author":"孙觌","text":"金地布时黄鹤下，化身现处赤乌来。\n如今只履西归去，又见天花一叶开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其一 别芳","author":"孙觌","text":"缥带湘枝半攲墙，行人立马并垂杨。\n珠帘半捲扬州路，争看金钗十二行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其二 友花","author":"孙觌","text":"午枕惊回一梦馀，间关枝上听催酤。\n已招十客花为友，更觅千头橘作奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其三 照艳","author":"孙觌","text":"抟云琢雪斗轻盈，一片霞光夜自明。\n会有国香来入梦，莫教高烛照长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其四 浮香","author":"孙觌","text":"冰姿更立冰溪上，雪艳仍开雪径中。\n白地迷藏不知处，云何鼻观已先通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其五 水香","author":"孙觌","text":"半篙新涨渌周遭，种出荷花十丈高。\n撷秀堪纫水仙佩，招词更续楚臣骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其六 小莲","author":"孙觌","text":"莲渚红酣三丈日，苔矶轻飏一丝风。\n钓船篷底眠秋雨，谁遣南柯入梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张子为园林八咏 其七 蒲桃径","author":"孙觌","text":"手植蓬藤数千寻，笑看潘液上骎骎。\n使君千骑东方去，零落空留一院阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]