ice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄毛伯明李叔器及康叔临二首 其一","author":"赵蕃","text":"日日江头闻鼓声，问船云作岳州行。\n如闻风便一日尔，我乃终年怀友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄白云觅茶","author":"赵蕃","text":"忆别白云笋渐长，而今想见出梢墙。\n道人寄我不忘我，盍寄茶瓯洗睡肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘凝远峦四首 其四","author":"赵蕃","text":"一生已分阻长饥，轻薄羞随造化儿。\n远寄微言作君寿，无盐何敢突西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘凝远峦四首 其三","author":"赵蕃","text":"少陵衣钵在涪翁，传述东莱得正宗。\n闻道曾经亲授记，不求印可谁更从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘凝远峦四首 其二","author":"赵蕃","text":"曾因下座识元龙，深觊归途得款从。\n顾我殊非黄叔度，多君不愧郭林宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘凝远峦四首 其一","author":"赵蕃","text":"旧来人物数诸刘，公更诗名盖几州。\n新贵祇今多故旧，先生宁久滞瓜丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄向伯休且约他日道为芗林之游二首 其二","author":"赵蕃","text":"平生芗林五十咏，何意扁舟其下过。\n王郎逸兴非余有，不问主人防怒诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄向伯休且约他日道为芗林之游二首 其一","author":"赵蕃","text":"东郭竹溪君所庐，我家此物也扶疏。\n何时归去数来往，不似而今空寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄毕叔文二首 其二","author":"赵蕃","text":"闷甚长须酒破除，酒能作病又何如。\n故人欲问春来趣，多病还于酒盏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄毕叔文二首 其一","author":"赵蕃","text":"小园春物比如何，想见花稠草作窠。\n老去不能知许事，顾怀修碧可磨挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀","author":"赵蕃","text":"雨足新晴后，凉生静夜时。\n支筇谁得见，惟有鹭鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其二十","author":"赵蕃","text":"早起阴晴殊未分，杜鹃何许叫深云。\n眼中忽尔生新句，何异风行水面纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十九","author":"赵蕃","text":"剩水残山觉范诗，汎然孤棹去何之。\n倚樯吟啸元无忤，谁信今朝无早炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十八","author":"赵蕃","text":"忽忽离家且一年，春风又是海棠天。\n还家何以遗妻子，倾倒囊诗近百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十七","author":"赵蕃","text":"祝融香火我亡缘，还上江头上水船。\n赖得江山旧相识，登临到处一悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十六","author":"赵蕃","text":"下水乘舟恨少滩，溯流翻恨溯滩难。\n人生淹速祇如此，何必区区千万端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十五","author":"赵蕃","text":"雪没东园一径深，频惊饥雀落空林。\n疏明自喜山房小，更听哀弦空外音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十四","author":"赵蕃","text":"终日搜诗思不枯，坐间失喜折冰须。\n寒窗雪满无人到，伴我一枝梅更孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十三","author":"赵蕃","text":"破屋支撑风雨馀，世间种种不关渠。\n忍饥要惯无他术，过午未炊犹读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十二","author":"赵蕃","text":"秋风常恐到无期，一雨便兴摇落悲。\n疾病相攻今转甚，囊空何以致高医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十一","author":"赵蕃","text":"春今五日如京兆，风雨更堪携折之。\n我病不能知许事，饭馀扪腹细哦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其十","author":"赵蕃","text":"楝树层层细著花，日薰香暖蜜蜂衙。\n客来傥有论文兴，活火风炉自煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其九","author":"赵蕃","text":"扶疏夏木已来禽，安石榴花出树深。\n六尺纸窗明棐几，迸阶閒笋欲成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其八","author":"赵蕃","text":"早禾栖陇待晴收，雨欲为霖势可忧。\n似觉朝来乌鹊喜，便携童稚过西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其七","author":"赵蕃","text":"县官宽灭去年租，癃老扶携听诏书。\n和气定能消冷气，未知天意又何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其六","author":"赵蕃","text":"读书万卷不充饥，枵腹吟哦大似痴。\n不是邻僧能送米，囊空何以续晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其五","author":"赵蕃","text":"春风底事苦欺梅，旧雪未乾新雪催。\n元自不侪桃与李，何须著意苦相摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其四","author":"赵蕃","text":"正月山园未有花，梅花落尽亦堪嗟。\n瑞香莫与兰争长，独立风前自一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其三","author":"赵蕃","text":"阴晴竟日漫难分，远岫犹藏欲雨云。\n叹息无言桃与李，一年踪迹又纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其二","author":"赵蕃","text":"旱风吹野未成阴，空喜孤云出寸岑。\n饱食便知难自必，茶瓯小注莫令深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀二十首 其一","author":"赵蕃","text":"晏斋生理比何如，破砚今来亦已枯。\n珍重此君为耐久，澹然相对祗清癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李叔器兼寄毛伯明张王臣康叔临三首 其三","author":"赵蕃","text":"向来相别恨匆匆，别复长思讲学功。\n江水无由致双鲤，春风又是起归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李叔器兼寄毛伯明张王臣康叔临三首 其二","author":"赵蕃","text":"洞庭拍拍浸君山，亭对君山君闭关。\n胜日想多文会友，定应怜我在荆蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李叔器兼寄毛伯明张王臣康叔临三首 其一","author":"赵蕃","text":"春水满时春草生，春风日日上江亭。\n蘋花采得从谁寄，空送沅湘入洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李商叟二首 其二","author":"赵蕃","text":"卿来我已后诸公，颇愿相从缯简中。\n岂若吾身得亲见，怪君风味莫之同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李商叟二首 其一","author":"赵蕃","text":"笋茁桐敷又一时，想君日日有新诗。\n诗成寄我何其晚，要与羊何共和之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周愚卿","author":"赵蕃","text":"买得武夷毛竹杖，忽思江外友于人。\n青原若访常荷屋，助尔扶携觅句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周愚卿兄弟","author":"赵蕃","text":"渚花飘锦已残春，几对江山思故人。\n邂逅欲书书不得，醒狂于此见天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄审知","author":"赵蕃","text":"枫赤芦花白，扁舟夜泊时。\n平生故人梦，细雨说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄居邠","author":"赵蕃","text":"黄溪茶种有闽风，忆昨缄封自赞公。\n筠焙久空青箬里，纸囊盍寄白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林敏夫二首 其二","author":"赵蕃","text":"吴江应已落丹枫，况说枫桥半夜钟。\n想见归心成日日，暮云如我忆江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林敏夫二首 其一","author":"赵蕃","text":"闻说君家家具区，秋风应熟季鹰鲈。\n虽云祸福有倚伏，要是知几失早图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄莫万安升之二首 其二","author":"赵蕃","text":"身在江西尽处山，江东家住几时还。\n苦吟更与风光别，一夜并成双鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄莫万安升之二首 其一","author":"赵蕃","text":"我坐移官不作忧，得君为主见风流。\n移官得此天如恶，遣落江西尽处头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄逸","author":"赵蕃","text":"思隐今年竹几竿，因人略不报平安。\n门东叫认真痴绝，但有书来说饱餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄蒋攸县砺二首 其二","author":"赵蕃","text":"湘山越岭纵怀归，可废当年靡盐诗。\n府主甚贤宾得士，岂忧磨磷涅能缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄蒋攸县砺二首 其一","author":"赵蕃","text":"君家三径开来久，不待弦歌始得资。\n傥欲赋归归便得，湘山越岭匪逶迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢周子开","author":"赵蕃","text":"四益堂中四益碑，南轩文字述家规。\n殷勤打寄非无益，从此折肱当得医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩仲止主簿 其三","author":"赵蕃","text":"介室于余亦外家，二年朝夕向长沙。\n闻君往会临川葬，我不及前空叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩仲止主簿 其二","author":"赵蕃","text":"海内知名长少公，在今谁复可同风。\n可怜籍湜今头白，空复挂名家集中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩仲止主簿 其四","author":"赵蕃","text":"病卧凄然寂寞滨，既亲且故几何人。\n如君父子风流似，宁复可疏当可亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩仲止主簿 其一","author":"赵蕃","text":"旧来绝叹茶山竹，今日重悲南涧泉。\n儒雅风流真不愧，两贤真可作三贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄愚卿二首 其二","author":"赵蕃","text":"马甘荐秣自投鞿，巧弹何曾射倦飞。\n风急正看蛛去网，雨酣还见蚁争围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄愚卿二首 其一","author":"赵蕃","text":"江边栏槛竹中斋，缘我频能扫又开。\n茅屋苍苔唤归去，来禽青李待书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄简欧阳伯威刘伯山","author":"赵蕃","text":"问讯穷冈病主人，若为买得竹溪邻。\n是中剩有堪诗处，恨不与之相主宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潘恭叔曾幼度三首 其三","author":"赵蕃","text":"天将绝境付奇才，万里飘零莫自哀。\n不尔如何吾幼度，郁孤台又粤王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潘恭叔曾幼度三首 其二","author":"赵蕃","text":"去岁附书并附诗，自吴适粤至何时。\n殷勤再觅铜鱼使，傥不沉浮敢恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潘恭叔曾幼度三首 其一","author":"赵蕃","text":"一冬风雪苦多寒，春至冰霜更积攒。\n咫尺端如隔千里，况于楚粤路漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常山道中 其一","author":"赵蕃","text":"桃李成阴麦有花，笋舆咿哑我还家。\n谬恭莫望临邛令，雨后东陵宜种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常山道中 其二","author":"赵蕃","text":"烟雨濛濛鸡犬声，道长人寂掩柴荆。\n漫山桃李浑无数，归近何妨细作程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悠然亭","author":"赵蕃","text":"亭能招南山，径亦栽黄菊。\n我乃愿师陶，过公期托宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探梅","author":"赵蕃","text":"石上生梅老未枯，著花虽少更敷腴。\n要须邻老深调护，莫遣儿童纵牧刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚书二首 其二","author":"赵蕃","text":"何处黄鹂语，玲珑芳树间。\n可怜求友意，飞去又飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚书二首 其一","author":"赵蕃","text":"春晚苦多风，花残不见红。\n问花宁自觉，愁杀白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚行见梅","author":"赵蕃","text":"玉立空林一树梅，向人脉脉似怜才。\n微波托使为媒去，一被晚风吹又回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚行田间书事三首 其三","author":"赵蕃","text":"我生饱识田家趣，只坐无田归计迟。\n纵是无田慵可得，莫将画饼欲充饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]