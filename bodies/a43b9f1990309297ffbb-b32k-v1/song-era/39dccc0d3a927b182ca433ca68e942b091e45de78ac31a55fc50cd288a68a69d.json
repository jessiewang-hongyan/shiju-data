[{"title":"送觉先大师觉先参佛照圆通二老","author":"释德洪","text":"浮玉道人雷电舌，法云老师冰雪颜。\n后来事听诸方外，先数君游二老间。\n只把黑甜酬世味，从教螺鬓有诗斑。\n乘秋曳杖归何处，万叠匡庐是故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿慈云","author":"释德洪","text":"门前便是小曹溪，只欠孤猿岭上啼。\n水磨自鸣当浚浍，渔舟闲泊近沙堤。\n经游况是闲心远，富览谁能与物齐。\n一宿少留终未足，会须移锡向高栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答素首座","author":"释德洪","text":"勘破诸方剩得闲，归来岳寺掩深关。\n我行浅麓惊回地，君在翔鸾杳霭间。\n契阔独期当再见，峻严争说不容攀。\n勿矜出岫无心久，弱羽冲风亦欲还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道林送鸿禅者江陵乞食","author":"释德洪","text":"一篙湘水碧于螺，瑩净无痕不受磨。\n晓雾有情呵素镜，东风作恶卷纤罗。\n老来谈笑追随少，岁晚别离头绪多。\n浦口送君聊倚杖，会看归棹掠晴波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还太首座诗卷","author":"释德洪","text":"料理诗情难复难，萦心结思倾毫端。\n夺回天地英秀气，坐令落纸生风寒。\n老猿夜月叫苍壁，孤鹤晓霜疏羽翰。\n精神清韵知几许，付与后来能者看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秦少逸","author":"释德洪","text":"秦郎毛骨玉壶秋，望见令人忘百忧。\n便觉宗之未潇洒，肯容如晦独风流。\n来为南岳翛然别，去作东华烂熳游。\n想见醉围红粉处，雪笺佳句挽银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归筠","author":"释德洪","text":"西津渡口唐朝寺，到眼潇湘餍饫看。\n谁遣松声环坐榻，更令岳色堕栏干。\n君如鸟倦今知返，我与鸥盟久已寒。\n想见若耶溪上路，正尝卢橘带甘酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿临川禅居寺书方丈壁","author":"释德洪","text":"雨过沙村系客船，行间楼殿带晴烟。\n夜深霜月凉于水，门外云涛远际天。\n禾稻丰登如弃土，菱莲甘美不论钱。\n好峰不住犹行役，匆忆钟山掬涧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱世英守临川新开轩而轩有槐高数尺因名之作此","author":"释德洪","text":"圣朝贤佐蔚如林，天独于君著意深。\n喜气欲传黄阁信，夏窗先露绿槐阴。\n望云匆起怀亲念，隐几难忘济世心。\n他日此轩成故事，壁间应载野僧吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世英梅轩","author":"释德洪","text":"平生忠孝两难忘，乞得邻州近故乡。\n清白夜晴千里月，肃严秋迥一天霜。\n数行径彻临清晓，半印香消倚夕阳。\n记取东轩谈笑处，庭梅他日似甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送琳上人","author":"释德洪","text":"髯琳身小胆崔嵬，严冷中藏热肺怀。\n京洛归来尝自说，湘山游遍与谁偕。\n解将骨董藏涪叟，又负籚篅访了斋。\n更说开春南岳去，要寻浯水看磨崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵信民教授谢无逸游南湖","author":"释德洪","text":"春游每觉客愁消，最爱晴湖涨柳桥。\n鸭绿皱寒初拍岸，鹅黄照影自垂条。\n恼人风物今如许，著意春光已不撩。\n但得与君同一醉，何辞日日作诗招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思禹兄生日","author":"释德洪","text":"文章瑞世本奇豪，风鉴霜天夜月高。\n且袖玉堂批诰手，戏来山邑试牛刀。\n意长千里奔赪尾，恩重三山压巨鳌。\n满荐寿觞何所祝，祝公亲见折蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇仁县与思禹闲游小寺啜茶闻棋","author":"释德洪","text":"平生阅世等虚舟，临汝重来又少留。\n携弟来逃三伏暑，入门拾得一轩秋。\n隔墙昼永闻棋响，阴屋凉生见树幽。\n又值能诗王主簿，饭馀春露啜深瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余居临汝与思禹和酬瓯字韵数首后寓居湘山思禹复和见寄又答之","author":"释德洪","text":"涔蹄小邑著吞舟，未起风雷更少留。\n馔客酒酣腮玉缬，侍儿歌送眼波秋。\n诗成槲叶江村处，想见杨花院落幽。\n绮席忆曾蒙设醴，预闻谈笑把空瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡儒效见寄","author":"释德洪","text":"独宿圆庐意自清，夜凉林木寂无声。\n镜中白发今慵剃，梦里浮华已懒争。\n故国别来空好境，旧游谁共读题名。\n遥知他日重相见，握手应惊太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵初入制院","author":"释德洪","text":"依然收付建康狱，拴索珑璁惊市人。\n寄语小儿休嬲相，未妨大士戏分身。\n懒于梦境分能所，枉把情缘比客尘。\n笑视死生无可拣，目前刀锯若为神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄超然弟","author":"释德洪","text":"深掩圜扉夜向阑，梦惊清境慰辛酸。\n卧闻瓦垄集微霰，起觉衾裯压薄寒。\n忧患饱经心老大，云泉归晚鬓凋残。\n书空偶尔成诗句，寄与西林阿永看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初至海南呈张子修安抚","author":"释德洪","text":"南来稍复召惊魂，知有留侯异代孙。\n未即解衣甘九死，试令骑马赋千言。\n琼山有月光相射，玉海无风浪自翻。\n戏下应传获罗什，秃头争看戴华轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抵琼夜为飓风吹去所居屋","author":"释德洪","text":"贪看长鲸吸舟楫，忽惊娇蜃吐楼台。\n朦胧醉忆王城别，汗漫游从海国来。\n夜半飓风携屋去，朝来瘴雾放天回。\n会须横笛骑云背，笑响从教落九垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出朱崖驿与子修","author":"释德洪","text":"投老南来雪满颠，羁囚不自忆生全。\n久为白骨今重肉，已卧黄泉复见天。\n报德定应追结草，效忠那肯愧餐毡。\n此诗清绝如冰雪，乞与江山洗瘴烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别子修二首 其一","author":"释德洪","text":"疆埸探骑断奔埃，院落棠阴暗绿苔。\n上疏乞闲追鲍靘，载书归老继吴恢。\n争怀父母三年化，愁见风帆十幅开。\n勿剪青青堤下柳，念公遗爱手亲栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别子修二首 其二","author":"释德洪","text":"漂泊孤踪一转蓬，语音虽在变形容。\n瘴乡猿鸟今为伍，蚁穴王侯昔梦封。\n海阔盲龟登木孔，山高纤芥落针锋。\n公归不得参行驭，心折淮南紫翠重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡州道中","author":"释德洪","text":"北来行尽关山道，梁宋郊墟眼力微。\n饮食甘酸杂淮甸，语音清软近京畿。\n黄尘又向九天去，槁项新从万里归。\n投老不堪行役苦，手遮西日想岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余号甘露灭所至问者甚多作此","author":"释德洪","text":"老俨化身甘露灭，不妨须发著伽梨。\n虚舟阅世鸱夷子，彗帚□除王伯齐。\n香火共修心老大，楼钟重听意凄迷。\n馀生未觉全无累，折脚铛犹手自提。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海上初还至南岳寄方广首座","author":"释德洪","text":"天风吹笑落人间，白发新从死地还。\n往事暗惊如昨梦，此生重复见名山。\n倦禅想见堆危坐，知法应抛放纵闲。\n初嚼芳鲜动诗思，一篇先寄倩君删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈生携文见过","author":"释德洪","text":"海外归来两鬓秋，自嗟无地可逃羞。\n携筇肯过惊时听，炊黍能为信宿留。\n睡触屏风讥富贵，笑分脔社致公侯。\n遗编家世丹青著，铁砚磨穿未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至筠二首 其一","author":"释德洪","text":"乞浆问路到筠溪，天气清和得所宜。\n父老相逢班草坐，风光初过采茶时。\n摩挲禅榻营春睡，想像斋厨办晚炊。\n白首不知舟壑走，壁间来读旧题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至筠二首 其二","author":"释德洪","text":"偶唤归舟隔乱溪，春山偏与晚相宜。\n自寻熟路悬崖去，正是新秧刺水时。\n身健已如秋社燕，梦回犹看客亭炊。\n雨窗灯火清相对，画出渊明五字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示超然","author":"释德洪","text":"秋光满鬓万事死，惭愧眼明牙齿牢。\n野寺闲眠听风雨，海山犹梦渡云涛。\n事非白傅方惊鼎，迹隐庖丁已善刀。\n一径莓苔三十载，未容此老独奇豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"释德洪","text":"去岁重阳瘴海滨，病拈霜蕊嗅清晨。\n身闲已断思归梦，山好仍逢称意人。\n卯饭露葵欣旋摘，夜窗风栗共尝新。\n妙年衲子应相笑，痴钝耽源老应真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二十日偶书二首 其一","author":"释德洪","text":"春林院落曲栏东，小立初迎到面风。\n冰齿寒生花坼信，湿梅烟重雨毛空。\n病衰老去登临倦，节物年时气味同。\n却掩垆烟闭深阁，匆惊西日借窗红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二十日偶书二首 其二","author":"释德洪","text":"此生早衰坐世故，末路易归惊崄艰。\n临事无疑知道力，读书有味觉身闲。\n解医忧患臂三折，难隐文章豹一斑。\n永愧山赤头璨，不令姓氏落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈瑩中左司自丹丘欲家豫章至湓浦而止余自九峰往见之二首 其一","author":"释德洪","text":"雁荡天台看得足，却搬儿女寄蓬窗。\n径来漳水谋三顷，偶爱庐山家九江。\n名节逼真如醉白，生涯领略类湘庞。\n向来万事都休理，且听楼钟一夜撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈瑩中左司自丹丘欲家豫章至湓浦而止余自九峰往见之二首 其二","author":"释德洪","text":"与公灵鹫曾听法，游戏人间知几生。\n夏口瓮中藏画像，孤山月下认歌声。\n翳消已觉华无蒂，矿尽今知珠自明。\n远壑夕阳残雨后，一番飞絮满江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔见寄","author":"释德洪","text":"一官游戏且同尘，梦寐江湖亦可人。\n轩冕久知身是寄，鱼虾才说口生津。\n解嘲镜里萧疏发，时吐毫端浩荡春。\n自古浯溪好风月，买山终欲与君邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴太原狱别上蓝禅师","author":"释德洪","text":"平昔巾盂共空壁，只今楼观碍层霄。\n道心针水妙应在，俗眼云泥谩觉遥。\n道路为家身是寄，死生如梦意全消。\n明年五顶东游遍，来听吴音发海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太原还见明于洪水上蓝问明别后尝寓则曰十年客云居感叹其高遁作此","author":"释德洪","text":"清软吴音笑展眉，芳鲜犹在雪霜姿。\n十年不下欧峰顶，一旦肯来漳水湄。\n湘巘春深重记处，风瓯雨歇对闻时。\n红尘未可因藏迹，要卜云泉结后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温上人自庐山见过","author":"释德洪","text":"雀罗门巷榻凝尘，千里相寻骇四邻。\n好事真诚虹贯日，照人清气水含春。\n忽惊我祸今无比，高笑君痴亦绝伦。\n此别遥知想标格，浅云东崦对冰轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷塘暑雨过凉甚宜之见访作此","author":"释德洪","text":"居近池塘春意在，路穿空翠夕阳多。\n隔林放鹿哀怨语，掠水幽禽扑摝过。\n得雨村嚣觉风味，分秧天气爱清和。\n莫辞坐稳相寻数，酣战难回指日戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重会言上人乞诗","author":"释德洪","text":"海外归来五见春，梨衣两识帝京尘。\n此生已觉浑无累，为累空惊尚有身。\n厚善最怜山解事，岁寒更爱月情亲。\n鹫峰峰下重相见，雪作飞花一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诚心二上人见过","author":"释德洪","text":"破夏来寻甘露灭，快人如对水晶轮。\n烟云扫尽词传意，知见不生情透尘。\n旋缚茅茨吞远壑，偶临檐隙见归人。\n露芽便觉如浮雪，品坐同分一盏春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕示超然","author":"释德洪","text":"殿阁知谁烧夜香，矮窗灯火试新凉。\n草虫对语僧临砌，露叶翻光月转廊。\n补缀高风三袜线，破除清梦一匡床。\n与君游遍人间世，折脚铛中滋味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鞦韆","author":"释德洪","text":"画架双裁翠络偏，佳人春戏小楼前。\n飘扬血色裙拖地，断送玉容人上天。\n花板润沾红杏雨，綵绳斜挂绿杨烟。\n下来闲处从容立，疑是蟾宫谪降仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒灵源塔","author":"释德洪","text":"高帆驾浪过南溟，那料归来扫此亭。\n桃李成阴春老大，溪山好在鬓凋零。\n瓦灯已照宫商石，卵塔分藏服匿瓶。\n春雪尚能知客意，荡除毛孔瘴烟腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日会思禹兄于溪堂","author":"释德洪","text":"门前溪水蒲萄绿，风掠松窗料峭寒。\n忽忆十年同祸福，那知今日共盘餐。\n尽签书策齐幽架，已买渔舟泊小滩。\n君会不嫌村落僻，乘闲来此弄渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招夏均父","author":"释德洪","text":"北山深转青松壑，万叠烟霏空翠堆。\n元亮果堪中路俟，子猷那敢棹舟回。\n鸟工魂梦寻公去，蝉蜕尘埃出郭来。\n他日荆林谈笑处，行人应指两翁台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠僧","author":"释德洪","text":"攲枕无人梦自惊，回廊广殿午风清。\n已浮春露浇诗胆，更炷水沉熏道情。\n忧患撼床闻蚁斗，功名殷鬓作蚊声。\n欲依净社陪香火，僻处安排折脚铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资国寺西斋示超然二首 其一","author":"释德洪","text":"对眠偶此风雨夕，又近寒岩槲叶村。\n谢昼未焚风鉴在，韦郎不见语言存。\n岁时暗觉持山去，忧患空惊斫水痕。\n绿发彫零心已死，成蹊桃李落华分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资国寺西斋示超然二首 其二","author":"释德洪","text":"人间炊黍未及熟，万事只今归欠申。\n巳织青驹饯华骝，更披白帢称闲身。\n遗编终不求甚解，故人但愿长相亲。\n去年此日琼南岸，涨海翻天探骑尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠寄老庵僧","author":"释德洪","text":"自怜玉钵双峰信，来访牛头懒比丘。\n山色深浓过夜半，月华清亮近中秋。\n已欣境胜如龙阜，更觉庵幽占凤头。\n梦幻此身犹且在，杖藜投老得追游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀李道夫","author":"释德洪","text":"半篙晚涨绿杨湾，接翅鸥归雾雨残。\n数叠吴山围楚梦，一番花信酿春寒。\n别时小语依然在，隔岁来书展复看。\n补衮胸中五色线，只今应作怒蜺蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余所居连超然自见轩日多啜茶其上二首 其一","author":"释德洪","text":"三生事办吾知要，一室香凝独掩门。\n睡足便惊清昼夜，火红消尽白灰存。\n巷无俗驾蚁纷绕，邻有高人玉粹温。\n隐比价膺犹可愧，会茶时复到幽轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余所居连超然自见轩日多啜茶其上二首 其二","author":"释德洪","text":"功名今古一鸡肋，美味那知是祸根。\n扫迹世途龟曳尾，僻居烟雾豹埋文。\n如期见访穿窗月，不告而行出岫云。\n火浴未为无伴助，塔吾遗骨尚烦君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐师川罪余作诗多恐招祸因焚去笔砚入居九峰投老庵读高僧昙谛传忽作数语是足成之以寄师川师川读之想亦见赦二首 其一","author":"释德洪","text":"归来卧起有馀适，老去消磨无杂缘。\n门外不知何岁月，梦中亦觉在云泉。\n千年高道谁酬价，一世清闲我卖钱。\n安得道人江北去，此诗先录寄师川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐师川罪余作诗多恐招祸因焚去笔砚入居九峰投老庵读高僧昙谛传忽作数语是足成之以寄师川师川读之想亦见赦二首 其二","author":"释德洪","text":"古书漫灭字斓斑，眼倦颓然整顿闲。\n以法为亲疏世相，视身如幻寄人间。\n业缘有尽今脱手，老态无因日上颜。\n已办一瓢期涧饮，要刳馀润到昆山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云岩宝镜三昧","author":"释德洪","text":"宝镜当机不密传，纤毫渗漏堕言诠。\n圆伊三点分宾主，妙挟双明绝正偏。\n暗里丹青元异色，句中泾渭本同川。\n婴儿索物哆啝耳，与物宁瞋语未全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过永宁寺","author":"释德洪","text":"已背荒南过永宁，犯寒呵手捉枯藤。\n雪如镜底颔丝白，山学谁家眉黛青。\n射影风光知脱离，伐冰门巷觉添增。\n故人不用惊风帽，我是前身卧像僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十一月十七日发豫章归谷山","author":"释德洪","text":"急景穷冬一千里，笋舆部曲去匆匆。\n候船班草江津岸，曝日探檐山店中。\n袖手归休今日是，隔生冤债转头空。\n湘西雪后青松径，想见声盘万壑风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春前一日雪","author":"释德洪","text":"明日立春今日雪，雪中残响滴虚檐。\n方增谩说寒威在，不绝潜知煖气添。\n客去旋开书对语，闲多偏与懒相兼。\n湘山自古愁眉浅，纵御铅华不到尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明年湘西大雪次韵送僧吴","author":"释德洪","text":"夜残陡觉寒生骨，梦断空惊月转檐。\n瓶响卧闻秋蚓泣，火红起拨白灰添。\n欲酬清景寻侬去，更棹扁舟与子兼。\n要倩新诗写愁绝，笑呵冻砚蘸毫尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清富堂","author":"释德洪","text":"此堂冠绝湘西胜，枯木名多道不穷。\n用谷量云当衣钵，以江盛月展家风。\n买山归隐真寒乞，借竹为轩落笑中。\n绿锦涨连青玉浦，剪裁磨琢费诗工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]