[{"title":"次韵滕岳州谢王南郡酒","author":"刘敞","text":"谁信专城千骑居，空斋图籍两三厨。\n销忧尽付鸱夷酒，乘兴兼忘阮籍涂。\n爱客谁先魏公子，长贫却爱范莱芜。\n归轩仍有东门饯，显父还须至百壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和章伯镇","author":"刘敞","text":"南上湘潭谁记初，北还宣室受釐馀。\n共怜贾傅才无敌，真作扬雄老著书。\n调笑群驺饥欲死，去来千骑乐何如。\n洞庭木下鲈鱼熟，三叹新诗重起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和滕巴陵寄张虢州","author":"刘敞","text":"明府功名期壮年，滞留中路鬓成斑。\n岂知汲黯轻为郡，真为刘伶善闭关。\n归梦未尝离帝所，谪仙宁久混人间。\n会看使者持三节，缓带轻裘且自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄杨子华阁老使君","author":"刘敞","text":"吾丘不乐直承明，固请分符关外行。\n赐册最荣批凤尾，离群独恨出龙城。\n壮谋欲负腰间组，愁思空摇塞外旌。\n尘土满衫头半白，一闻班马不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"刘敞","text":"晚云蒸雨泻惊湍，积水浮城五月寒。\n卑湿向人如楚泽，风尘回首忆长安。\n岁华徂暑参差尽，旅馆怀归去就难。\n自昔梁山有遗操，试凭繁手一清弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过华阴马上口占寄李君锡王懿臣薛师政三漕","author":"刘敞","text":"三岁重过二华间，衰年弥觉厌尘喧。\n自知碌碌初无补，正是纷纷不惮烦。\n江壁向来忧郑客，鼎湖今日望轩辕。\n修门渐近翻鸣咽，满面风埃涕泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过中京后寄和贡两弟","author":"刘敞","text":"归鞍蹀躞弄轻尘，满眼韶光破宿云。\n去国几愁歌白纻，上天真喜望缇群。\n华林雪尽莺先啭，广陌风多草竞熏。\n我欲还家千日饮，益须酿酒张吾军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍弟东还病中口占七言奉寄景仁彝唐公甫","author":"刘敞","text":"眼暗头昏逾十旬，涔涔终岁发华新。\n幽如羑里迷天路，醉似中山与鬼邻。\n闭阁却怜廷掾力，废书弥信道家淳。\n修门已后君无恙，试枉招魂慰满身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句容刘同年寄示游山诗及术煎","author":"刘敞","text":"江外三峰倚碧天，古来相续几神仙。\n自无飞骨何由到，赖有新诗尚许传。\n饵术始知堪度世，听松真得自忘年。\n会驱鸡犬从君隐，与择华阳数亩田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登城","author":"刘敞","text":"前岁登城日几回，去年犹记隔辰来。\n老侵筋力铢铢减，慵坏心情寸寸灰。\n幸有风光相挽引，那无宾友共追陪。\n北台好在中秋月，便是重阳菊蕊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜春卿自陜归","author":"刘敞","text":"休汝曾更月旦评，几年漂泊倦尘冥。\n神峰好在岩岩石，符采依然两两星。\n天禄自嫌书尚白，绛帷仍喜眼犹青。\n召南风什知多少，一一亲弦更许听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻莺","author":"刘敞","text":"舍南舍北柳阴阴，竟日啼莺不自禁。\n羁旅可怜还择木，间关似欲向知音。\n鴂鶗无事催芳草，燕雀相喧守旧林。\n幽独闭门惊岁晚，固烦求友慰愁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贡甫时迁居城南水上","author":"刘敞","text":"城南风物似江湖，卜筑尤宜近水隅。\n俗薄容垂真钓否，庭閒得种此君无。\n关身调度惟存剑，适意图书略满厨。\n心远地偏俱可喜，免逢甲马与尘涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中使传宣二月一日史院赐御筵某亦预召作七言呈禹玉真孺景仁三内翰","author":"刘敞","text":"虞书纪典上稽唐，鲁史传经近属商。\n刻玉春山瞻气象，积星东壁聚钩芒。\n朝思膏饫欢情洽，天令中和尽刻长。\n虽引客卿讥子墨，翰林还许望清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答次道学士","author":"刘敞","text":"世路相逢难自期，江城三岁想琼枝。\n宁知邂逅驱千骑，亦复东南寄一麾。\n把酒聊同醉乡乐，看花欲后麦秋时。\n旧都红药犹堪赏，不负风流谢客诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陜府祖学士","author":"刘敞","text":"承明持橐倦徂年，自陜分符得近关。\n人物风流二南后，山河形势两周间。\n莫嗟落魄书犹白，共许优游鬓未斑。\n数醉申湖好风月，传车行且趣君还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒席赠钦圣提刑学士","author":"刘敞","text":"弃捐不预朝廷议，落莫真成老秃翁。\n放眼能宽蜀郡礼，高贤信有古人风。\n都门倏忽三年别，樽酒淹留一笑同。\n还有野歌随拙舞，肯教庭炬彻明红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日和韵","author":"刘敞","text":"禁垣清切近云霓，楚客逢秋意亦悲。\n拙学由来玄尚白，敝裘何意素成缁。\n解嘲却笑朱丹毂，迕俗兼惩百一诗。\n短景正须棋玩岁，薄寒宁厌酒盈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涵虚阁昼卧","author":"刘敞","text":"池水无波清照心，庭柯交让绿成阴。\n游鱼自与江湖阔，翔鸟不期山谷深。\n身外悠悠日复夜，世间扰扰古犹今。\n寄愁天上从吾乐，高卧聊为招隐吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"于司录东园","author":"刘敞","text":"辟疆园圃厌城闉，闻道池台事事新。\n自置一樽消永日，别留槃石待幽人。\n雨添草色迷三径，风散花香入四邻。\n亦欲肩舆乘兴去，主人何必旧相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘郎中监灵仙观尽室而往","author":"刘敞","text":"华发星郎七十馀，碧山遥访羽人居。\n白石不为天上药，淮南欲试枕中书。\n长缨自濯沧浪水，高盖仍瞻驷马车。\n福地神仙应易致，几时南岳侯乘舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和诸公御制后苑赏花钓鱼","author":"刘敞","text":"四照繁英拂槛开，九重芝盖赏春来。\n卿云共和光华旦，瑞雾偏凝沆瀣杯。\n池藻跃鱼波淡荡，林光倾日景徘徊。\n淮阳闭阁头今白，梦达钧天惜未陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚西楼","author":"刘敞","text":"微霜欲堕木叶脱，积潦已收天宇清。\n皎皎日华映林莽，潇潇风色闭柴荆。\n正怜戎马秋防塞，何处悲笳暮绕城。\n回首浮云满西北，七哀还见古人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘中允涣年五十馀以颖上县令致仕卜居庐山","author":"刘敞","text":"五柳先生厌俗纷，拂衣归去卧江滨。\n松菊还同昔人好，山川复似向时新。\n瀑泉飞雪千岩晚，仙杏蒸霞万树春。\n亦欲扁舟乘兴往，沧浪借取濯埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答令狐司封求酒","author":"刘敞","text":"冯公郎隐发苍苍，拨弃尘烦得醉乡。\n富贵两行安用圣，沧浪独醒讵非狂。\n顾惭宿酿能千日，远愧深衷颂短章。\n当就天公借北斗，更倾东海益君觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"持礼北庭回示希元并寄之翰彦猷当世","author":"刘敞","text":"肃承朝命谒穹庐，却卧空床涕满裾。\n不敢复论天下事，更能重读箧中书。\n男儿战死自无恨，国势倒悬谁为摅。\n我本不来人强我，百年空使愧相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻莺","author":"刘敞","text":"阴阴老树连村路，羃羃轻烟过雨天。\n长爱禽声能永日，似于莺友欲忘年。\n朱缨紫椹看齐熟，深巷荒城得屡迁。\n朗咏谢公池上作，勿惊春物变熏弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日发古北口寄禹玉直孺昌言三阁老","author":"刘敞","text":"桂酒椒盘共发春，山川虽旧物华新。\n仲尼鲁史王正月，泰帝河图岁甲寅。\n玉殿耸闻斟白兽，火城想见接清尘。\n应怜二使星安在，北斗杓端析木津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春后游杜城陈丞相郊园","author":"刘敞","text":"韦杜胜游谁可寻，相君旧隐对云岑。\n水渠婉转蛟蛇活，霜竹参差孔翠深。\n故老能言卧龙地，儿童不用满籯金。\n郡斋殊负青山郭，空挹芳樽慰客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日登楼","author":"刘敞","text":"南极阳生天地新，高楼气色已含春。\n得无鸿雁翻归翼，应有龙蛇动蛰鳞。\n亦复书云占楚岁，不辞为寿引湘醇。\n甘泉从祀虽能赋，怅望钩陈拥北辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨","author":"刘敞","text":"长至须臾二月来，朔云零雨未尝开。\n阴藏昼景长绣线，寒夺阳和潜律灰。\n宿翼困冰多后雁，暗香漂水惜残梅。\n撩晴召暖无他术，安得凉风一夜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同邻几伯镇观秘阁壁上苏子美草书","author":"刘敞","text":"苏子佯狂不自疑，汉庭籍甚莫言非。\n放歌金马居常醉，穷老沧洲不更归。\n浮世功名均梦寐，平生翰墨独光辉。\n壁间数字龙蛇动，神物通神亦恐飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春","author":"刘敞","text":"腊去春归意可怜，久为羁客海西偏。\n温风泛泛生卮酒，和气融融媚管弦。\n剪綵直为儿女戏，土牛向自国家传。\n事情争爱新翻掷，还道今年胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春日紫宸拜赐归持国见率同过江十不行","author":"刘敞","text":"蓬莱佳气旧无时，春物迎新特更宜。\n燕识玉箱来自早，漏随宫线报还迟。\n沟声破冻才通苑，酒力含风易满卮。\n蓬鬓不堪双綵胜，懒随君向习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺隐直","author":"刘敞","text":"寂寞三年倦一飞，知音不限向来希。\n虽然主簿非高士，犹喜分曹近太微。\n吏部铨中超俗状，京官班首望天威。\n汉儒多有司空掾，努力新书更发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨景修秘校归","author":"刘敞","text":"武夷曾孙尘外仙，手携桂枝归故山。\n夸乡始信一经是，衣锦不须三组还。\n蓬莱观书聊复尔，枳棘栖鸾殊未然。\n野人放荡辱先进，惭愧竹林诸阮间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答校书郎孙侔少述","author":"刘敞","text":"金华劝讲愧通经，铜虎分忧强请行。\n千骑亦知翁子贵，一麾谁觉仲容轻。\n西宾落莫空遗俗，北斗阑干有旧城。\n欲作过秦无与语，故人高论忆盱衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉答屯田宋员外","author":"刘敞","text":"汗血龙文千里驹，长楸未试局庭隅。\n一麾几老诸侯相，五日初还建礼趋。\n独得凤毛惊众目，相望花萼照亨衢。\n白头漫感悲秋赋，自笑妨贤此禁涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为转运沈郎中题","author":"刘敞","text":"宝轴牙签三万馀，中园华宇荫清渠。\n风流复见郊居赋，荣观归乘使者车。\n俯仰江山乐无有，优游文籍昔谁如。\n何当去此从君语，尽得平生未见书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题溪堂","author":"刘敞","text":"苏侠遗欢小洞庭，高堂殊恨曲池平。\n山川满目仍非昔，鱼鸟依人自不惊。\n琐细幽花相妩媚，回环流水共澄清。\n秋风初足江湖意，不作鲈莼万里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯镇初拜湖州","author":"刘敞","text":"君向江湖领一麾，亲欢自与宿心期。\n腰间紫绶新光彩，都内青钱厚宠私。\n厩吏莫催乘传去，诏恩方许戌瓜时。\n碧澜堂上青山下，烂醉寻春亦未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩司谏移亳宫双桧植于道山","author":"刘敞","text":"仙子分根白鹿檀，定知高峭出岩端。\n浓云借色曾无变，初日移阴渐可观。\n风外共成苍鹤舞，夜深齐作翠幢看。\n人今俟尔为梁栋，慎勿轮囷取自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新秋","author":"刘敞","text":"七月荆人亦具裘，朔风飒飒动昭丘。\n巫峡出云杳无定，洞庭飞月绝堪愁。\n长歌濯足沧浪水，回首开襟西北楼。\n宇宙歊蒸暂潇洒，小山青桂与淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宿直晨出遂赴奉慈斋告寄持国子履","author":"刘敞","text":"玉殿鸣鞘辟寝闱，银台归骑蹀霜蹄。\n楼光已映朝霞动，树色犹衔宿霭迷。\n身贵承明翻厌直，岁穷樽酒幸招携。\n太常几日休斋禁，亦欲从公醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"刘攽","text":"水气横浮飞鸟外，岚光平堕酒杯间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游平山堂","author":"刘敞","text":"背城历历才十里，经岁悠悠能一来。\n可惜薄书捐白日，强从宾客宴平台。\n暮云自与千山合，醉眼时令万宇开。\n老子谁怜兴不浅，黄花欲落更添杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中口占七言奉送前成都尹吕宝臣龙图还朝","author":"刘敞","text":"开远故城长乐坡，三年从此送君过。\n宦游不道相逢少，愁病何堪惨别多。\n强敌犹知奉威信，巴童莫忘习中和。\n庙堂应趋缁衣拜，少缓离亭白玉珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜独酌","author":"刘敞","text":"凉月破云涵碧霄，暂怜庭宇断尘嚣。\n露翻高树光明灭，风度疏篁影动摇。\n惊鹊似投人处息，暗虫如恨岁华凋。\n短歌薄酒清辉里，百感先秋不自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和永叔雨中见寄","author":"刘敞","text":"泥涂后土未曾乾，骑马相过行路难。\n卧听鸡鸣知景晦，起逢花谢惜春残。\n银台幸阕连宵直，樽酒能谋尽日欢。\n红药苍苔虽寂寞，多情肯作旧游看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城楼晚望","author":"刘敞","text":"长夏淮天却似秋，居人未解白貂裘。\n云起岱山时涨雨，风迎沧海欲横流。\n日边渴问长安使，天际频瞻贾客舟。\n自是七哀宜写望，不关非土故登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答宋都官游骊山见寄","author":"刘敞","text":"华清宫殿映春晖，未醉三晡莫遽归。\n人事废兴犹可记，风光流转不相违。\n歌临灞岸朱弦脆，走度章台汗马肥。\n自是秦川贵公子，城隅相望不能飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙少述题虎丘","author":"刘敞","text":"吴墟秦烬灭遗踪，谁见千岩锁梵宫。\n化出楼台双树外，密移天地一壶中。\n石形虎踞森相向，剑气龙盘冷射空。\n羁宦无由蜡山屐，因君诗句梦江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙侔雁荡山二首 其一","author":"刘敞","text":"鳌翻溟涨折灵山，漂落尘区莽眇间。\n自有神仙护真境，故令林木断人寰。\n碧城万玉重重合，琪树三株寂寂间。\n安得长风破高浪，拂衣东去一跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙侔雁荡山二首 其二","author":"刘敞","text":"天台赋后世多贤，复在君家雁荡篇。\n气逸还令人耸动，境幽初许俗流传。\n万峰林立浮云外，一径梯横绝海边。\n闻道归艎从此逝，秋风招隐特依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答罗同年忆楸花之作","author":"刘敞","text":"勾稽严密不通宾，因见楸花忆去春。\n当日同僚尝把酒，于今邑子远思人。\n临安草木皆蒙锦，金谷池塘各斗茵。\n自笑痴儿了公事，经年不识酒沾唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵谢某送行诗","author":"刘敞","text":"天涯毕昴隔烟尘，风雪梁山忆侍亲。\n行记简书聊接淅，去怀印绶正逢春。\n评依月旦情增恋，诗感兰陔意重陈。\n先向沙堤侯归骑，却瞻霖雨作伊晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阁下午寝晚归","author":"刘敞","text":"高阁遥依日月光，苍苔重叠紫微芳。\n蝉声已觉迎秋急，云物还惊过午凉。\n独往山林非复昔，梦为鱼鸟不能忘。\n芝泥封诏鸡栖树，半落宫槐满地黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观冲卿所试诗赋贺府君","author":"刘敞","text":"斗城烟雾隔金銮，日破轻阴玉滴寒。\n捷笔补天凌造化，高文惊世涌波澜。\n梦成白凤飞鸣远，功就丹梯步武宽。\n回首蓬莱笑清浅，春风前后发芝兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁晚偶作","author":"刘敞","text":"不嫌腊过催人老，直恐春归恼客愁。\n柳眼梅心俱次第，云容雪意与淹留。\n岁穷楚俗依稀古，冰解巴江汹涌流。\n遣兴长须一樽酒，呼儿径典敝貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春日过荐福寺","author":"刘敞","text":"一岁还随一岁来，立春人日竞相催。\n细细谷风能破冻，熙熙习俗似登台。\n初阳弄色明高柳，残雪留寒伴落梅。\n淮北风光元自好，壮心摧谢不胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿斋中书外省答永叔京尹内翰朝回马上见寄并谢子华次韵","author":"刘敞","text":"朝罢章台日几竿，遥闻走马试雕鞍。\n春风自发游人意，宿雪偏留下省寒。\n坐久独知宫漏永，诗成谁尽玉堂欢。\n会须一办如泥醉，从笑归来笔向乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富谷老人臧用自云本京师兵士咸平中没番五十馀年矣","author":"刘敞","text":"白发衰翁双涕零，曾随诸将战咸平。\n一捐左衽迷归路，却问中华似隔生。\n思报汉恩身已朽，耻埋胡壤死无名。\n今朝纵观非他意，得见官仪眼自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都运陈光禄自河北移陜西以病不得诣别作七言奉送","author":"刘敞","text":"西州判袂忽三年，梦想城南尺五天。\n谢病归来真老矣，伤春刻意益茫然。\n受降塞外威名远，足食关中寄注专。\n北顾邯郸复临灞，更能一醉促哀弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]