[{"title":"寄子骏郎中","author":"冯山","text":"叠叠巴山走使轺，不辞岩险奉宽条。\n频来马足行应惯，重见民情喜自谣。\n雨过寒林微带雪，风生幽谷静闻樵。\n清奇定入骚吟笔，乞取邮筒寄下僚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李杞省句赴阙","author":"冯山","text":"使轺西走奉军期，万货泉流向武威。\n才伴江声关外去，又随秋色日边归。\n千寻蜀岭供吟藁，一道秦川照锦衣。\n莫叹奔驰伤浩气，出群鸿雁已高飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子骏郎中登高","author":"冯山","text":"曾对炎蒸忆静便，偶逢佳节思超然。\n相将绝顶孤高处，剩看清秋几许天。\n虽欠笙簧留席上，犹胜风雨傍篱边。\n好看菊蕊殷勤别，旦暮除书落枕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子骏郎中文台","author":"冯山","text":"地接松扶绝塞边，星居人户种畬田。\n语音高亢关中俗，风物萧疏剑外天。\n一失羁縻生堡障，十分流运费刀泉。\n闾阎谩作封侯计，几辈伻图到上前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清晖亭","author":"冯山","text":"亭榭轩窗处处开，清晖嘉致号为魁。\n群峰有景互争出，一水无声相向来。\n已借寒光摇棨戟，莫辞欢赏费瓶罍。\n新诗自属风骚将，何苦登临愧不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范百禄子功学士知谏院二首 其一","author":"冯山","text":"天庭高议破群奸，先帝曾将侍从班。\n谈笑一辞双阙去，缙绅遗恨十年间。\n倾朝每忆刘蕡对，侧席才闻贾谊还。\n言责逡巡非久计，行看鸣玉上鳌山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范百禄子功学士知谏院二首 其二","author":"冯山","text":"圣贤中道意何如，历历樊川论谏书。\n要在致君成德业，不当沽直徇名誉。\n平生忠义倾心际，后日经纶试手初。\n得意古人多气义，弹冠应有旧簪裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苗时中子君运判亭溪道中双白猿","author":"冯山","text":"雪白霜猿久已灵，江山但觉有馀清。\n优游此地不常出，皎洁一身能自明。\n高挂岂知神气王，仰看谁为骨毛惊。\n因吟佳句成遗恨，安得风前闻啸声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子骏郎中清江道中","author":"冯山","text":"缭绕川原又载驰，人情风物共依依。\n胶舟野水涸将尽，捲雨岭云寒不飞。\n岂惮长途劳使传，尚寻清景扣禅扉。\n前山次第看梅发，剩带新年春色归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴辟利台吕少蒙运判以诗回赠依韵谢之","author":"冯山","text":"随和箧笥号藏珍，物理求多渐失真。\n骐骥已胜千里足，鹪鹩才寄一枝身。\n自怜蹭蹬居前秕，岂意蹉跎接后尘。\n穷达圣贤知有分，不同非望泽中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岑岩起莫轩","author":"冯山","text":"闻在幽轩隐使华，合归清望戴重纱。\n手持温诏方行道，堂有慈亲即是家。\n得意乡山频上看，异时蓬岛合重誇。\n登临强欲留诗句，苦恨风骚力未加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送文与可知洋州","author":"冯山","text":"何事年年拥使麾，放身閒处避危机。\n为思清汉还重去，犹厌承明未肯归。\n天上荣途方策足，林间轻霭尚沾衣。\n区区斥鴳宁能啸，只得蓬蒿自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏梅呈李待制才元","author":"冯山","text":"镇雅墙阴看早梅，满城惟此一株开。\n已驱禽鸟工夫尽，才共宾僚宴赏来。\n月照寒姿凌画烛，风传香蕊堕清杯。\n玉堂深切归期近，少住花前醉几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读刘宾客外集","author":"冯山","text":"七言常爱中山好，百首犹存外集多。\n大约晚年知性命，一时清韵入中和。\n森张剑戟虽无敌，隐约瑕疵惜未磨。\n三绕花栏俱读尽，杜陵回首郁嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还杨恬天隐长官家集","author":"冯山","text":"经世才高若命何，微茫骚雅寄编摩。\n纯音已落人间久，孤愤犹存集外多。\n喜看仙巢鸣鸑鷟，重闻古匣奏云和。\n殷勤归秩非无报，谁为沉文吊汨罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题合江知县杨寿祺著作野亭","author":"冯山","text":"野亭何处访仙翁，安乐风烟迥不同。\n千里清泉来塞外，四时佳景出山中。\n偷身暂逐禽鱼乐，放意翻成笔砚工。\n醉伴逍遥无计去，钩藤新熟荔枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕少蒙题大卿林下轩","author":"冯山","text":"归来何处解尘襟，幽径寻轩入茂林。\n身到静中方有我，事除诗外更无心。\n江山相就能清景，桂柏新成已翠阴。\n闻说逍遥樽酒会，三卿鱼袋斗黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题冯公举郎中清音亭","author":"冯山","text":"山水清音绕翠微，一亭风物里中稀。\n为怜鱼钓生平处，还向功名事了归。\n白傅歌童聊自适，庄生鸥鸟自相依。\n区区贫阮长嗟叹，才有林居便拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行县道中遇暴风雨寄吕少蒙太博","author":"冯山","text":"霖潦经时路未通，公言行县太匆匆。\n安知风雨欺人处，正在溪山绝险中。\n一出到头馀日在，少留随分觉途穷。\n却因下马心方悟，欲速无成万事同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳寄文与可","author":"冯山","text":"牛峰秋色翠相摩，还上凌云宴绮罗。\n黄菊纵逢佳节好，清欢不似去年多。\n僧房次第依重到，霜月萧条且强歌。\n闻说洋州时节盛，不知高兴定如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过永泰文与可宅因寄","author":"冯山","text":"数程奔走倦征车，喜过蓬仙旧隐居。\n秀气峰峦排户牖，清风楼阁锁图书。\n一从高步东山起，重见深秋少室虚。\n无计墨君堂上看，林间猿鹤共踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻内舍榜将至","author":"冯山","text":"元丰内舍初公选，开宝中秋定试期。\n四海诸生趋盛集，一朝新议破群疑。\n人传学榜才张后，驿递家音未到时。\n莫怪虚名随分喜，文章门户欲支持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苗子君新井道中","author":"冯山","text":"阆水兼山斗晓光，星轺亲按古村乡。\n临江麦陇烟云翠，夹道林花锦绣香。\n使旨天边劳按察，人情车下见欢康。\n东风相伴行宽诏，敢恨年来鬓发苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒲安行诚之秘丞游乌奴寺","author":"冯山","text":"共随春色探幽奇，春到山中未几时。\n啸傲烟霞凌绝顶，毫芒人物乱交逵。\n已登高阁临清旷，更羡轻舟泛渺瀰。\n落笔停杯遂陈迹，莫辞钟鼓下山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李才元待制二首 其一","author":"冯山","text":"直道崎岖出禁林，江湖长有爱君心。\n五年汉法更张际，千里潼江惠泽深。\n天下鹓鸿方得侣，道傍桃李正垂阴。\n邦人不用留行色，满旆薰风入舜琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李才元待制二首 其二","author":"冯山","text":"为掾初逢幕府开，便将清望属非才。\n重来门下经年后，始见天边促召回。\n况有平生馀事业，此行高步脱风埃。\n孤踪已作沟中断，休费工夫为剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李待制寄僧诗有歇定之语兼闻有岷峨之游因作诗以寄之二首 其一","author":"冯山","text":"无心宜与物相期，既歇须行似不疑。\n出处休将人事说，功名多在老成时。\n胸中白练何妨洁，足下青云岂自知。\n好取圣贤权进退，莫教轻重失毫釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李待制寄僧诗有歇定之语兼闻有岷峨之游因作诗以寄之二首 其二","author":"冯山","text":"春游游尽欲寻山，杖屦岷峨只等閒。\n但放高怀穷物外，不知清誉满人间。\n经年绿野常沉醉，几日香峰暂往还。\n自笑尘辕盘未得，逍遥无路一追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和普守勾辅元郎中见寄均逸亭诗","author":"冯山","text":"春风猎猎卷双旌，太守开樽上子城。\n地僻养成山水趣，民和流入管弦声。\n林花远近参差发，野景朝昏次第生。\n引领英游归未得，东溪遗恨几时平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赏海棠","author":"冯山","text":"三春花卉满州城，渠占风流第一名。\n老杏酸寒誇锦绣，野梨乾强学瑶琼。\n秾妆雨后频来看，尤物年深特地荣。\n为是翰林亲手植，莫辞欢赏慰民情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送韩存宝閤使","author":"冯山","text":"君常慷慨论兵机，喜见韩侯定远归。\n将略无穷虽世出，秋毫不犯似君稀。\n封侯气骨青春在，报主功名白日飞。\n龌龊簿书何所恋，拟投儒服换戎衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和岑岩起见寄","author":"冯山","text":"一别江皋能几时，相从鸥鹭久无依。\n楼前流水常东去，塞上征鸿又北归。\n交分每传双鲤信，乡心同望白云飞。\n孤吟长啸无俦侣，惟向清宵共月辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和后唐王仁裕舍人留题自然观","author":"冯山","text":"黄鹤仙音久寂然，嘉陵江上碧峰端。\n惟馀寂寞烟霞馆，空老阴森桧柏坛。\n药灶绕行云彩动，诗牌吟拂玉声寒。\n虚无踪迹何须问，自有清名不死丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与陈万石","author":"冯山","text":"千首诗兼百首文，宗韩之子拾遗孙。\n吾乡此道嗟几绝，先世馀风喜仅存。\n三变声名徒自惜，平生襟抱向谁论。\n相知惟有贫相见，拨置穷愁付酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开州道中逢王子严中散惠诗依韵和之","author":"冯山","text":"经年东北望阳台，阻奉从容一笑开。\n良会俱从江上得，清风潜向坐中来。\n诗成不倦乘閒写，酒好何妨尽醉陪。\n百老篇章今少见，满怀归去重琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子严","author":"冯山","text":"归船才泊古巴台，遥见诗筒眼豁开。\n摩垒只忧轻挑去，报琼何意误投来。\n老知仙梦终难到，清喜英游屡得陪。\n对酒孤吟重相忆，江前微霰屑瑶瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渝州春雪","author":"冯山","text":"青帝云车碾玉尘，阴机和雨付江神。\n巧将清冷三巴景，妆出繁华二月春。\n已凛寒威驱瘴疠，更流和气助陶钧。\n劝农使者虽欢赏，犹念无衣索拊循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄仲贤朝议","author":"冯山","text":"仙雏曾伴学飞翻，三纪光阴一梦间。\n龙坂旧游今独在，凤池高步已难攀。\n衣冠每恨功名晚，风月谁兼富贵閒。\n契阔人情应见念，故人憔悴老巴山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿春穆东美有节亭","author":"冯山","text":"淮上仙翁倚岁寒，绕亭閒种碧琅玕。\n林泉莫恨归时晚，风月偏宜静处看。\n为爱萧森从叶密，欲令蕃衍放根蟠。\n阶庭已见清阴合，更长龙孙百十竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李之纯宝文二首 其一","author":"冯山","text":"平生玉帐耻论兵，劝学儒风已自成。\n惟有爱民常惨怛，况曾廉俗旧澄清。\n直将经济为仁术，不假中和助政声。\n从此回翔归柄用，更推忠厚福群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李之纯宝文二首 其二","author":"冯山","text":"邂逅当年最见知，台光云雾阻重披。\n忽闻颍上还朝日，正是漳滨养病时。\n剑外江山愁远别，天边鸿鹄望归期。\n西南遗爱情何限，千载羊公堕泪碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题希元承诏堂希元惠诗因次其韵","author":"冯山","text":"鸑鷟峰前旧隐亭，仙翁曾此被弓旌。\n云山每恨未能到，松桂向人如有情。\n共把清尊惭北海，更听馀论学南荣。\n何须酩酊为真赏，归袖琼瑰已自盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小溪尉丘君父母年皆九十康强精明尚能读书挫箴如五六十岁人相继受恩命某固未尝见也亦未尝闻也因作诗遗丘君且以传诸士大夫如果未尝见闻则宜相与乐道其美而形于歌颂云","author":"冯山","text":"人间夫妇老难期，九十俱全古亦稀。\n沧海蟠桃堪结子，碧梧栖凤久忘归。\n君恩黄发颁新诰，儿戏青衫著彩衣。\n一尉三公无此乐，百年琴瑟在庭闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游","author":"冯山","text":"邀约东风共出城，云容羞日弄阴晴。\n看人墙外冲花气，下马石间闻水声。\n林蘖半从樵刃起，草牙还傍烧痕生。\n趁时桃李参差发，得意禽虫各自鸣。\n开谢眼前穷物态，丰登时下见民情。\n悔将诗笔随春酒，万景投怀醉不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题辛叔仪花园","author":"冯山","text":"前载闻君说种花，重来轩槛早芬葩。\n只知造化随人力，岂觉光阴换岁华。\n风雨不容孤客赏，馨香宁待主翁誇。\n牡丹珍重偏开晚，料得开时已到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冯太博归州春望","author":"冯山","text":"闻说巴东暂解颜，两回曾到十年间。\n咤滩自古风波险，玉洞无人水竹閒。\n霜雪凭虚千尺瀑，烟岚弥望四围山。\n登临欲伴春游去，惟恐藤萝不易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和八舍弟赞贤司理 其一","author":"冯山","text":"湖外閒官四见春，就中吟咏费精神。\n青山借得风骚古，白发相将意思新。\n每向孤高虽得意，要知閒淡苦无人。\n归来幸有鸰原识，为惜鸿毛抵万钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和八舍弟赞贤司理 其二","author":"冯山","text":"兄弟当年粗有声，家风传得至今清。\n争先踪迹虽相让，投老情怀共一惊。\n富贵有时当自致，文章无价可能轻。\n期君正在青云上，何止新诗几首行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和二首 其一","author":"冯山","text":"归来相值故园春，坐对春风忽怆神。\n十里溪山依旧好，一番花木为谁新。\n青云功业虽留我，白日光阴奈趁人。\n道在不须论用舍，惟将时命托洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和二首 其二","author":"冯山","text":"新诗才读眼惺惺，照见词源彻底清。\n白雪乍闻高唱喜，明珠翻值暗投惊。\n儿童一辈年将晚，研席平生分不轻。\n为爱惠连才思好，登临重寄远山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其一","author":"冯山","text":"莫厌诗筒来往频，閒中无物可怡神。\n追回风雅篇篇好，鍊尽襟怀日日新。\n自笑支离多病客，更随憔悴苦吟人。\n阳州不识英雄器，重问颜高借六钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其二","author":"冯山","text":"休向诗中恨不平，范滂留意在澄清。\n烟霄鸿鹄飞将到，雷雨龙蛇蛰未惊。\n声价得来知道长，穷愁消尽觉身轻。\n荣途咫尺非难至，俯拾功名在此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滴水岩","author":"冯山","text":"飞泉分下一岩寒，谁识神功借意难。\n泻出龙漦投石上，缀成仙佩落云端。\n离山便有江流杂，当道宁辞宿眼看。\n几把狂吟题不就，十年馀思在栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游滴水岩","author":"冯山","text":"仙佩玲珑白玉寒，每来常与寺僧看。\n忧民未有林泉约，重到岩前为解鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承诏堂","author":"冯尧民","text":"名因南山出，迹为南山止。\n少室价自高，大劳招不起。\n君恩动林壑，古道变闾里。\n堂下松桂栽，清阴从此始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸太学","author":"梁焘","text":"原庙亲持十月觞，天回宝辇款虞庠。\n当阳赭幄翔龙座，属地霜袍振鹭行。\n拭目向儒移美俗，虚怀稽古自兴王。\n太平重见清风颂，嘉句飞传到玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸太学","author":"周商","text":"云覆鸾舆五色章，鸣鞘声肃下儒庠。\n佩衿雾集三千子，仪卫星罗十二行。\n位列夔龙陪帝圣，经陈戊甲献成王。\n元龟象齿方来供，不用论兵政事堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔代书寄岊仲七弟","author":"钱协","text":"东方千骑拥朱轮，衣锦归逢故国春。\n莫向西湖恋风月，鸰原知有望归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次秦少游春日偶题韵二首 其一","author":"钱协","text":"藏室委蛇咏素丝，春风初动万年枝。\n如何愁叹无行路，却似袁安卧雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次秦少游春日偶题韵二首 其二","author":"钱协","text":"春雪唯添鉴里丝，慵将泪眼看花枝。\n?跻伏枕呻吟日，枉过还家一笑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又二十八字辄送来米二石","author":"钱协","text":"儒馆优贤盖取颐，校雠犹自困朝饥。\n西邻馀禄无多子，稀薄才堪作淖糜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答二十八字","author":"钱协","text":"春雪严凝暖未回，围炉犹拥已燃灰。\n明朝知是长斋毕，准拟冲泥踏水来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出省马上有怀蒋颖叔二首 其一","author":"钱协","text":"春雪京城一尺泥，并鞍还忆蒋征西。\n碧幢红旆出关去，一路东风送马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出省马上有怀蒋颖叔二首 其二","author":"钱协","text":"不论埃壒与涂泥，封印还家日已西。\n岂比元戎碧油下，貔貅绕帐马千蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]