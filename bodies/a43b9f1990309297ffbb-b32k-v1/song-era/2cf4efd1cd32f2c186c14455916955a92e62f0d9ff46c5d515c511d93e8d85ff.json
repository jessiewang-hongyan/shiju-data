[{"title":"北山广智大师，回自都下，过期而归，时率开祖，无悔同访之，因留渌净堂，竹鹤二绝 其一","author":"苏轼","text":"渌净堂前竹，秋期赴白云。\n不知缘底事，一日可无君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山广智大师，回自都下，过期而归，时率开祖，无悔同访之，因留渌净堂，竹鹤二绝 其二","author":"苏轼","text":"渌净堂前鹤，孤栖守竹轩。\n胸中无限事，恨汝不能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欲往湖州，见孙莘老，别公辅、希元、彦远、醇之、穆仲","author":"苏轼","text":"秋来欲见紫髯翁，待得梅花细萼红。\n记取上元灯火夜，道人犹在水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富阳道中","author":"苏轼","text":"清晨振衣起，起步方池侧。\n徘徊俯丹楹，到影见攲仄。\n不识陶靖节，定非风尘格。\n遥怀谢灵运，本自林泉客。\n予生忽世事，不以形为役。\n顾彼冕弁人，冕弁非予适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠青潍将谢承制","author":"苏轼","text":"吾皇有意缚单于，槌破铜山铸虎符。\n骁将新除三十六，精兵共领五千都。\n周王常德须攘狄，汉帝雄才亦尚儒。\n君学本兼文武术，功名不必读孙、吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过潍州驿，见蔡君谟题诗壁上云：「绰约新娇生眼底，逡巡旧事上眉尖。春来试问愁多少，得似春潮夜夜添。」不知为谁而作也？和一首","author":"苏轼","text":"长垂玉箸残妆脸，肯为金钗露指尖。\n万斛闲愁何日尽，一分真态更难添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州春日杂书四绝 其一","author":"苏轼","text":"楚乡春冷早梅天，柳色波光已斗妍。\n淮上雁行皆北向，可无消息到侬边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州春日杂书四绝 其二","author":"苏轼","text":"中州腊尽春犹浅，只有梅花最可怜。\n坐遣牡丹成俗物，丰肌弱骨不成妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州春日杂书四绝 其三","author":"苏轼","text":"清晓披衣寻杖藜，隔墙已见最繁枝。\n老人无计酬清丽，夜就寒光读《楚辞》","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州春日杂书四绝 其四","author":"苏轼","text":"病腹难堪七碗茶，晓窗睡起日西斜。\n贫无隙地栽桃李，日日门前看卖花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚游城西开善院，泛舟暮归，二首 其一","author":"苏轼","text":"晚照馀乔木，前村起夕烟。\n棋声虚阁上，酒味早霜前。\n远谪何须恨，来游不偶然。\n风光类吾土，乃是蜀江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚游城西开善院，泛舟暮归，二首 其二","author":"苏轼","text":"放船江濑浅，城郭近连村。\n水槛松筠静，市桥灯火繁。\n谁家挂鱼网，小舫系柴门。\n卜筑计未定，何妨试买园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人雪晴书事","author":"苏轼","text":"消尽琼瑶云驭归，馀寒犹复助风威。\n垂帘渐学秋霖滴，满地犹疑夜月辉。\n冻壤相和开荜户，流澌半释拥苔矶。\n可怜乌鹊饥无食，日暮空林何所依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬仲闵食新面汤饼，仍闻籴麦甚盛，因以戏之","author":"苏轼","text":"初见煌煌秀两岐，俄惊落硙雪霏霏。\n可烦都尉热承汗，绝胜临淄贫易衣。\n尚有清才对风月，未妨便腹贮书诗。\n知君货殖誇长袖，满籴千箱待一饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读仲闵诗卷，因成长句","author":"苏轼","text":"喜见西风吹麦秋，年年为逭老农忧。\n沾涂手足经年种，荐载珠玑一倍收。\n壮齿君能亲稼穑，异时我亦困耝耰。\n独怜紫竹堂前月，清夜娟娟照客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送酒与崔诚老","author":"苏轼","text":"雪堂居士醉方熟，玉涧山人冷不眠。\n送与安州泼醅酒，从今三日是三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏作切语竹诗","author":"苏轼","text":"隐约安幽奥，萧骚雪薮西。\n交加工结构，茂密渺冥迷。\n引叶油云远，攒丛聚族齐。\n奔鞭迸壁背，脱箨吐天梯。\n烟筱散孙息，高竿拱桷枅。\n漏兰零露落，庭度独蜩啼。\n扫洗修纤笋，窥看诘曲溪。\n玲珑绿醽醴，邂逅盍闲携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行见月四言","author":"苏轼","text":"吟哦傲兀，仰晤岩月。\n遇巘迎崖，银刓玉啮。\n源鱼噞喁，岸雁臲卼。\n卧玩我语，聱牙岌嶪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆黄州梅花五绝 其一","author":"苏轼","text":"邾城山下梅花树，腊月江风好在无？\n争似姑山寻绰约，四时常见雪肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆黄州梅花五绝 其二","author":"苏轼","text":"一枝价重万琼琚，直恐姑山雪不如。\n尽爱丹铅竞时好，不如风雪养天姝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆黄州梅花五绝 其三","author":"苏轼","text":"虽老于梅心未衰，今朝谁赠楚江枝。\n旋倾尊酒临清影，正是吴姬一笑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆黄州梅花五绝 其四","author":"苏轼","text":"不用相催已白头，一生判却见花羞。\n扬州何逊吟情苦，不枉清香与破愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆黄州梅花五绝 其五","author":"苏轼","text":"玉琢青枝蕊缀金，仙肌不怕苦寒侵。\n淮阳城里娟娟月，樊口江边耿耿参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访散老不遇","author":"苏轼","text":"君来不遇我，我到不逢君。\n古殿依修柏，寒花对暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王定国","author":"苏轼","text":"离歌添唧唧，古曲拟行行。\n不作相随燕，空吟久住莺。\n瞢腾君上马，寂寞我回城。\n明日东门外，空舟独自横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院观伯时画马绝句","author":"苏轼","text":"竹头抢地风不举，文书堆案睡自语。\n看马欲?顿风尘，亦思归家洗袍裤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出局偶书","author":"苏轼","text":"急景归来早，穷阴晚不开。\n倾杯不能饮，留待卯君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"觅俞俊笔","author":"苏轼","text":"笔工近岁说吴、俞，李、葛虚名总不如。\n虽是玉堂挥翰手，自怜白首尚抄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鼠须笔","author":"苏轼","text":"太仓失陈红，狡穴得馀腐。\n既兴丞相叹，又发廷尉怒。\n磔肉饲饥猫，分髯杂霜兔。\n插架刀槊健，落纸龙蛇骛。\n物理未易诘，时来即所遇。\n穿墉何卑微，托此得佳誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴枕","author":"苏轼","text":"高情闲处任君弹，幽梦来时与子眠。\n彭泽漫知琴上趣，邯郸深得枕中仙。\n试寻玉轸抛何处，闲唤香云在那边。\n平素不须烦按抑，秦娥自解语如弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书李宗晟《水帘图》","author":"苏轼","text":"宗晟一轴《水帘图》，寄与南舒李大夫。\n未向林泉归得去，炎天酷日且令无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书《龙马图》","author":"苏轼","text":"先皇御马三千匹，仗下曾骑玉骆骢。\n金鼎丹成龙亦化，圉人空栈泣西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皎然禅师《赠吴凭处士》诗云：「世人不知心是道，只言道在西方妙。还如瞽者望长安，长安在东向西笑。」东坡居士代答云","author":"苏轼","text":"寒时便具热时风，饥汉那知食药功。\n莫怪禅师向西笑，缘师身在长安东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯花一首赠王十六","author":"苏轼","text":"金粟钗头次第多，起看缺月带斜河。\n悬知瑞草桥边夜，笑指灯花说老坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王晋卿得破墨三昧，又尝闻祖师第一义，故画邢和璞、房次律论前生图，以寄其高趣，东坡居士既作《破琴》诗以记异梦矣，复说偈云。","author":"苏轼","text":"前梦后梦真是一，彼幻此幻非有二。\n正好长松水石间，更忆前生后生事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和芝上人竹轩","author":"苏轼","text":"洞外复空中，千千万万同。\n劳师唱竹颂，知是阿谁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏赠秀老","author":"苏轼","text":"拆却相公庵，泥却驸马竹。\n天下人总知，流入《传灯录》。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晃美叔老兄","author":"苏轼","text":"反观皆自直，相诋竟谁谀。\n事过始堪笑，梦中今了无。\n珍才尚空谷，瘦马正长途。\n未识造物意，茫然同一炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮归","author":"苏轼","text":"牛羊久已下，寂寞掩柴扉。\n水鹊鸣城堞，飞萤上戟衣。\n夜凉江海近，天阔斗牛微。\n何日招舟子，寒江北渡归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待旦","author":"苏轼","text":"梦破山骨冷，扶桑未放晓。\n披衣坐虚堂，缺月犹皎皎。\n扬泉漱寒冽，激齿冰雪绕。\n百体喜坚壮，万象觉情悄。\n簪履事朝谒，神魂飞窅渺。\n龛灯蚌珠剖，炉穗玉绳袅。\n浮念恍已消，真庭谅非杳。\n须臾霁霞起，赫奕射林表。\n高树引凉蝉，深枝啅栖鸟。\n二虫彼何为，逐动自纷扰。\n悠悠天宇内，岂复论大小。\n覆盎舞醯鸡，浓昏恣飞绕。\n定知达观士，方寸常了了。\n世无陶靖节，此乐知者少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约吴远游与姜君弼吃蕈馒头","author":"苏轼","text":"天下风流笋饼餤，人间济楚蕈馒头。\n事须莫与谬汉吃，送与麻田吴远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕，访子野食烧芋，戏作","author":"苏轼","text":"松风溜溜作春寒，伴我饥肠响夜阑。\n牛粪火中烧芋子，山人更吃懒残残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北归度岭寄子由","author":"苏轼","text":"青松盈尺间香梅，尽是先生去后栽。\n应笑来时无一物，手携拄杖却空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"《鸣泉思》，思君子也。君子抱道且殆，而时弗与，民咸思之。鸣泉故基堙圮殆尽，眉山苏轼搔首踟蹰，作《鸣泉思》以思之","author":"苏轼","text":"鸣泉鸣泉，经云而潺湲。\n拔为毛骨者修竹，蒸为云气者霏烟。\n山夔莫能隐其怪，野翟讵敢藏其奸。\n茅庐肃肃，昔有人焉。\n其高如山，其清如泉。\n其心金与玉，其道砥与弦。\n执德没世，落月入地，英名皎然，阳曦丽天。\n旧隐寂寂，新篁娟娟。\n思彼君子，我心如悬。\n谷鸟在上，岩花炫前。\n鸣泉鸣泉，能使我菀结而华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰年有高廪诗","author":"苏轼","text":"颂声歌盛旦，多黍乐丰年。\n近见藏高廪，遥知熟大田。\n在畴纷已穫，如阜隐相连。\n《鲁史》详而记，神仓赋且全。\n舂人洪蓄积，祖庙享恭虔。\n圣后忧农切，宜哉报自天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万菊轩","author":"苏轼","text":"一轩高为黄花设，富拟人间万石君。\n佳本尽从方外得，异香多在月中闻。\n引泉北涧分清露，开径南山破白云。\n此意欲为知者道，陶翁犹自未离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩干马","author":"苏轼","text":"少陵翰墨无形画，韩干丹青不语诗。\n此画此诗真已矣，人间驽骥漫争驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送煮菜赠包安静先生","author":"苏轼","text":"野菜此出珍又珍，送与西邻病酒人。\n便须起来和热吃，不消洗面裹头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沿流馆中得二绝句 其一","author":"苏轼","text":"淮西功业冠吾唐，吏部文章日月光。\n千载断碑人脍炙，不知世有段文昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沿流馆中得二绝句 其二","author":"苏轼","text":"李白当年流夜郎，中原无复汉文章。\n纳官赎罪人何在？\n壮士悲歌泪万行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中赋裙带","author":"苏轼","text":"百叠漪漪风皱，六铢縰縰云轻。\n植立含风广殿，微闻环佩摇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王定国自彭城往南部，时子由在宋幕，求家书，仆醉不能作，独以一绝句与之","author":"苏轼","text":"王郎西去路漫漫，野店无人霜月寒。\n泪尽粉笺书不得，凭君送与卯君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠黄州官妓","author":"苏轼","text":"东坡五载黄州住，何事无言及李宜。\n却似西川杜工部，海棠虽好不吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言乐语","author":"苏轼","text":"桃园未必无杏，银矿终须有铅。\n荇带岂能拦浪，藕花却解留莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题领巾绝句","author":"苏轼","text":"临池妙墨出元常，弄玉娇姿笑柳娘。\n吟看屡曾惊太傅，断弦何必试中郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书裙带绝句","author":"苏轼","text":"任从酒满翻香缕，不愿书来系綵笺。\n半接西湖横绿草，双垂南浦拂红莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎跑泉","author":"苏轼","text":"金沙泉涌雪涛香，洒作醍醐大地凉。\n倒浸九天河影白，遥通百谷海声长。\n僧来汲月归灵石，人到寻源宿上方。\n更续《茶经》校奇品，山瓢留待羽仙尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端砚诗","author":"苏轼","text":"披云离北岩，度岭入中夏。\n重藉剪楚茅，方函斲英槚。\n骚坛意莫逆，匠石语○奓。\n匪垩劳运斤，如带防毁銙。\n砺○○○○，观隅整同厦。\n津津剖马肝，索索模羊觟。\n气逼松滋豪，烟联雪涛奼。\n登堂却蹒跚，饮水何?閜。\n守墨面宜黔，含贞口终哑。\n静惟有寿焉，玷尚可磨也。\n《鲁史》记获麟，晋帖题裹鲊。\n供给到唐文，护持等商斝。\n眉形空爱纤，风字仍嫌哆。\n载观七八评，咸本六一写。\n退然敢摩肩，信矣俱出跨。\n始知尹公他，不媚王孙贾。\n铭诗与器传，篆刻当碑打。\n严韵拾孑遗，微才任聊且。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张无尽过黄州，徐君猷为守，有四侍人，姓为孙、姜、阎、齐、适张夫人携其一往婿家，既暮复还，乃阎姬也，最为徐所宠，因书绝句云","author":"苏轼","text":"玉笋纤纤揭绣帘，一心偷看绿萝尖。\n使君三尺毬头帽，须信从来只有檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题铜陵陈公园双池诗 其一","author":"苏轼","text":"南北檐楹照绿波，濯缨洗耳不须多。\n天空月满宜登眺，看取青铜两处磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题铜陵陈公园双池诗 其二","author":"苏轼","text":"落帆重到古铜官，长是江风阻往还。\n要似谪仙回舞袖，千年醉拂五松山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏槟榔","author":"苏轼","text":"异味谁栽向海滨，亭亭直干乱枝分。\n开花树杪翻青箨，结子苞中皱锦纹。\n可疗饥怀香自吐，能消瘴疠暖如薰。\n堆盘何物堪为偶，蒌叶清新卷翠云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中题鲛绡诗","author":"苏轼","text":"天地虽虚廓，惟海为最大。\n圣王皆祀事，位尊河伯拜。\n祝融为异号，恍惚聚百怪。\n二气变流光，万里风云快。\n灵旂摇红纛，赤虬喷滂湃。\n家近玉皇楼，彤光照世界。\n若得明月珠，可偿逐客债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"苏轼","text":"帘卷窗穿户不扃，隙尘风叶任纵横。\n幽人睡足谁呼觉，攲枕床前有月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雅安人日次旧韵二首 其一","author":"苏轼","text":"人日滞留江上村，定知芳草怨王孙。\n题诗寄远方挥翰，扶杖登高独出门。\n柳色忍看成感叹，花前归思自飞翻。\n浮阳披冻虽才弄，已觉春工漏一元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雅安人日次旧韵二首 其二","author":"苏轼","text":"似闻高隐在前村，坐膝扶床戏子孙。\n自赏春光携桂酒，喜逢晴色款柴门。\n屏间带日金人活，头上迎风綵胜翻。\n蓬鬓扶疏吾老矣，岂能旧貌改新元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和代器之","author":"苏轼","text":"雨过郊原一番新，寻芳车马踏无尘。\n普天冷食闻前古，萧寺清游属两人。\n不作佺期问新历，颇同之问感馀春。\n明年归藉梨花上，应会群贤及四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自题金山画像","author":"苏轼","text":"心似已灰之木，身如不系之舟。\n问汝平生功业，黄州、惠州、儋州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]