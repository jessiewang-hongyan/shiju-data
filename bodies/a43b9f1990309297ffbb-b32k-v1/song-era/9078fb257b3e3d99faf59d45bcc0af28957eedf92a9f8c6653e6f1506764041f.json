[{"title":"偈颂六十五首 其四十八","author":"释普济","text":"南山云，北山雨。\n毗卢楼阁，豁开门户。\n花簇簇，锦簇簇。\n弥勒大士，倾肠倒腹。\n百城风月，目前领话，人畜草芥。\n一时知有不知有，毗目仙人执善财手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十七","author":"释普济","text":"铁蒺藜椎，转弄转危。\n丹霞烧木佛，院主落须眉。\n南山炉添今日火，作者不同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十二","author":"释普济","text":"不参禅，不问道。\n竖起铁脊梁，死蛇钻出草。\n不是禅，不是道。\n云门千岁僧，越山鼐长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十","author":"释普济","text":"旱地一声雷，青天撒白雨。\n不是诺佛说底法，不是祖师传底心，不是衲僧参底句。\n日月轮边气象高，鱼龙穴下蟠根固。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十九","author":"释普济","text":"为众持钵去，七佛旧仪式。\n庵园塔庙间，处处遍敲击。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十八","author":"释普济","text":"老黄龙颔下明珠，胜首座悬空扑碎。\n黄檗山吐雾兴云，遍地走南山鳖鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十六","author":"释普济","text":"南北山朝对，东西有路分。\n一步不相到，大地入无门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十","author":"释普济","text":"一天星斗大家看，独有渠侬见处偏。\n打失眼睛拈得口，至今脚下黑漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十九","author":"释普济","text":"风不鸣条，雨不破块。\n老胡忽西来，拨乱清平世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十八","author":"释普济","text":"西来无意，遍天遍地。\n玉兔东升，金乌西坠。\n老鼠咬床头，猫儿正憨睡。\n莫教动著渠，动著便祸事。\n二祖动著招祸上身，天宁今日开眼失利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十七","author":"释普济","text":"白鹤五通贤圣，瞥喜瞥嗔无定。\n闻名不如见面，见面依然错认。\n从来与渠水米无交，年年今日，钵盂安柄。\n因甚如此，鸡不吃谷，肫里有病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十六","author":"释普济","text":"砉碎明月珠，始为家宝。\n飏下鈯斧子，方是住山。\n古策风高，天宽地阔。\n别别，别峰妙转风雷舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十四","author":"释普济","text":"同条不同条，心眼自相照。\n翻覆论岁寒，不觉拍手笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十一","author":"释普济","text":"栽田博饭，诡计百出。\n插锹叉手，通身荆棘。\n枷棒场中亲不亲，草窠交辊见当人。\n谁是当人，放箸忘恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其二十","author":"释普济","text":"鹫岭拈花，少林得髓。\n病痛一般，脉息有异。\n脉得著目前见鬼，脉不著死而不吊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十九","author":"释普济","text":"腊极严寒，冻破泥团。\n不可默会，不可形言。\n鸡上树，鸭下水，明朝更献楚王看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十八","author":"释普济","text":"禁足护生脚跟下，乞命底纷纷纭纭。\n克期取證平地上，埋没人千千万万。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十六","author":"释普济","text":"去日炎威重，归时秋半过。\n林间坐磐石，不觉笑呵呵。\n不笑仰山插锹叉手，不笑地藏博饭栽田。\n二胜米料人人有，笑他饿死饭箩边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十五","author":"释普济","text":"一队衲僧来，一队衲僧去。\n打破睦州关，大地无寸土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十四","author":"释普济","text":"圆通门户开，湛然应一切。\n星罗云汉低，山岳起空翠。\n风雨雪霜寒，人惊鸡犬吠。\n正法明如来，依然在门外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十一","author":"释普济","text":"天晴日头出，雨落阶头湿。\n宝陀岩上人，犹自不条直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其九","author":"释普济","text":"有句无句，如藤倚树，截铁斩钉。\n水不借路，树倒藤枯。\n西天胡子没髭须，蹋杀杨歧三脚驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其八","author":"释普济","text":"知之一字，众祸之门。\n杀人放火，活捉生擒。\n不是今日枢要，亦非上古典刑。\n与贼过梯了也，攻墙割壁何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其七","author":"释普济","text":"眼耳鼻舌身意，八万四千法门，昼夜放光动地。\n一翳在眼，空花乱坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五","author":"释普济","text":"禾山打鼓，雪峰辊毬，妙胜不打个般车里油。\n一双穷相手，两个死柴头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三","author":"释普济","text":"十日雨，今日晴。\n一则多年公案，明明举似诸人。\n若是覆盆之下，又争怪得老僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其一","author":"释普济","text":"春山叠乱青，春水漾虚碧。\n大解脱门开，把手拽不入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释普济","text":"指桃骂李，败种发机。\n词穷理尽，一嘿横施。\n大地山河背震吼，七佛之师懡㦬归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山赞","author":"释普济","text":"采樵沿岭去，提水傍溪归。\n个般无出豁，七佛不曾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒衲","author":"释普济","text":"针锋不露重重补，线脚通时密密参。\n放下无针无劄处，冻云垂地一肩担。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福州长溪乐山王居士遣儿惟惺投师薙发写师顶相请赞 其一","author":"释普济","text":"闻名不如见面，见面不如闻名。\n两重虚假，一对眼睛。\n不近人情处，是句也刬，非句也刬。\n一味拍盲时，逼犬透墙，證龟成鳖。\n如斯杜撰，岂堪人师。\n谁知千里同风句，却有乐山居士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"演史","author":"释普济","text":"干戈场是太平基，休把英雄较是非。\n试问长空风与月，周秦汉魏不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜘蛛","author":"释普济","text":"一丝挂得虚空住，百亿丝头杀气生。\n上下四维罗织了，一无漏网话方行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马郎妇赞","author":"释普济","text":"有愿必从，无刹不现。\n鬓乱钗横，金沙滩畔。\n稽首皈依，漏卮难满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音大士赞","author":"释普济","text":"空如来藏，立大圆镜。\n水落石出，月明云净。\n瞻之仰之，群机普应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝陀三句 其二","author":"释普济","text":"宝陀一玄，掣臂揎拳。\n打失鼻孔，苍天苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝陀三句 其一","author":"释普济","text":"宝陀一路，来来去去。\n撞著鳌头，风波无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝陀三句 其三","author":"释普济","text":"宝陀一妙，无人能到。\n吃饭著衣，屙屎放尿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其二","author":"释普济","text":"肩担口叫，晓夜撑船。\n道路各别，养家一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十一","author":"释普济","text":"深山穷谷，蛇虎纵横。\n平田浅草，鸦鸣鹊噪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十","author":"释普济","text":"东去西去，南来北来。\n残羹馊饭，门外安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十九","author":"释普济","text":"三八念诵，劳动大众。\n五月升堂，说短论长。\n打鼓入室，逼狗透墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十三","author":"释普济","text":"古佛堂前，三头六臂。\n祖师门下，道绝人荒。\n衲僧者里，银山铁壁。\n慧日峰顶，春风和气。","collection":"宋","notice":"","provenan