[{"title":"县学","author":"李正民","text":"碧瓦鳞鳞接近郊，青青衿佩得同袍。\n欣闻庠序儒风盛，不见桑榆太白高。\n鲁国已观沂上舞，汉朝应货蜀中刀。\n献酬济济升平事，泮水从今有弁髦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送敏申赴敕局","author":"李正民","text":"弟兄接武上天关，行色差池一岁间。\n献纳已看腾碧落，编摩宁久曳青班。\n雨蒸梅暑兰舟稳，纲解秋茶赤笔闲。\n病鹤乘轩嗟老矣，毰毸短羽恋云山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"先畴戏简尹叔","author":"李正民","text":"槜李城东雀墓边，先畴芜没仅名传。\n南来书契今无有，岁远比邻屡变迁。\n剪叶旧疆几并沃，钓璜遗业久输田。\n莫言鸡肋难料理，犹胜区区贷子钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辞高安之行","author":"李正民","text":"投林倦翼漫差池，揣分量材祗自知。\n郁郁安能久居此，栖栖若是欲何为。\n文轩华毂非余望，白发苍颜叹我衰。\n闻说风波犹未靖，难于江海把旌麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹叔若讷和边字韵因再寄 其一","author":"李正民","text":"遁迹东游沧海边，全家到处寄邮传。\n江淮李监人多厌，甲乙商墟利则迁。\n遣兴千钟犹有酒，思归一马尚无田。\n买山拟作诛茅计，难学巢由不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹叔若讷和边字韵因再寄 其二","author":"李正民","text":"将相驱驰正事边，风声喜自道途传。\n鲰生岂解求三捷，荣路如何望九迁。\n励志陶公朝运甓，决疑平子赋归田。\n谁人肯为将军地，自笑都无直一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曹明甫","author":"李正民","text":"忆昔宣城接俊游，回头三十六清秋。\n少年志气青霄近，老境飘零白发羞。\n可叹飞光如电往，自怜外物等云浮。\n何时相对一樽酒，与子同消万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄艾若讷","author":"李正民","text":"拟寻荒僻事田园，窃食祠庭愧国恩。\n休论鹤长凫甚短，且看齿落舌犹存。\n陶潜昔去因多忤，房琯今知欠不言。\n欲问大钧吾岂敢，喙长三尺亦须吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄孙邦求","author":"李正民","text":"少年英气已峥嵘，泮水曾传御史名。\n白简自宜绳列位，皂囊终不负家声。\n且随郡守寻春去，未向班心布武行。\n知有弹冠贡公喜，休嗟华发镜中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张子安 其一","author":"李正民","text":"縠水分襟十五秋，此身萍梗任飘浮。\n久栖孤馆为真隐，未访名山作胜游。\n醉里周郎曾度曲，闲中庾信祗添愁。\n西风起我江湖兴，拟把兰桡上钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张子安 其二","author":"李正民","text":"来往三吴二十年，星星华发已盈颠。\n未开松菊陶潜径，且泛江湖范蠡船。\n黄石不逢宁论富，丹砂可就试求仙。\n乘闲欲访张公子，共说升平一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄元叔","author":"李正民","text":"湖海飘零畏甲兵，敢将笔墨论功名。\n好官未忆羊元保，万户难侯李北平。\n智短云霄曾踠足，老来农圃合谋生。\n王维荐弟虽无愧，尚恐诸公厌祢衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再寄曹明甫","author":"李正民","text":"忆昔陵阳寓学时，登山临水共追随。\n并游志气青云近，投老光阴白发垂。\n顾我家无阿堵物，喜君门有宁馨儿。\n仍闻岁晚聊栖棘，愿访茅斋杜拾遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔食黄雀有诗求叶公书次韵","author":"李正民","text":"惊禽投案庇微躯，尚见头颅万里馀。\n敢谓苞苴犹到我，偶因棠棣得逢渠。\n身闲幸饱公孙粟，地散难移薛相书。\n闻道舍人已倾盖，承明何必恋吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邦求假仆制槁示诗褒拂次韵为谢","author":"李正民","text":"漫试词科久缀文，误升禁掖掌丝纶。\n判花旧职怀先德，留草私家愧古人。\n珍宝未能逃拙涩，诏书何以变温纯。\n相如多病辞源涸，紫橐同君再拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与客往天宁素饭以惠山水煎茶","author":"李正民","text":"精舍閒游结胜缘，老来宁复嗜腥膻。\n共分摩诘众香饭，仍试华山第二泉。\n石鼎煎来甘有味，乳花浮处色尤鲜。\n几年泻卤伤牙颊，吮漱华池便欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻人馀庆见和因再赋","author":"李正民","text":"世路功名懒著鞭，閒中乘兴便逃禅。\n檀栾林里禽初啭，阿耨池边柳正妍。\n未怕俗情嗤北阮，只愁神物戏南泉。\n我来不为寻春色，试举开遮问竺乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵许希文","author":"李正民","text":"少年豪气压词场，晚喜松筠耐雪霜。\n但见貂裘嗟季子，焉知素发老潘郎。\n黄公垆畔山河邈，陶令门前草木长。\n邂逅正当戎马际，共惊飘泊在他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王廷老","author":"李正民","text":"珥笔风谣萃此州，二年坐啸政非优。\n樽前自愧孔文举，竹下欣逢王子猷。\n九琐洞天空怅望，一麾江海漫淹留。\n归心拟借南风便，万里沧波一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐大谏道漳南与舍弟倡和次韵 其一","author":"李正民","text":"天涯流落鬓丝生，喜见英豪一坐倾。\n云霭微茫分岛屿，风涛歘忽变阴晴。\n幸逢胜饯开樽俎，必有嘉言补圣明。\n忧国济时公自任，十年寰海困戈兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐大谏道漳南与舍弟倡和次韵 其二","author":"李正民","text":"谢公今起为苍生，樽酒相看只细倾。\n戏綵鲤庭窥丽藻，披云鲸海属新晴。\n感时华发萧萧改，致主丹心皎皎明。\n从此灵台应偃伯，共知堂上有奇兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德卲见寄","author":"李正民","text":"三年持橐侍君轩，误剖麟符去日边。\n暂解尘缨寻紫府，愧无棠荫在螺川。\n羲之诏郡难为政，邴曼辞官不待年。\n等是飘零江海客，祗应同病自相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵邦求宗博","author":"李正民","text":"番禺薏苡旧传名，公酌贪泉志愈清。\n绛帐有经谈训诂，淮壖无地可归耕。\n鸿飞久困孙内史，龙具宁悲王仲卿。\n琳馆素飧公自愧，秋风萧飒二毛生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次元叔韵","author":"李正民","text":"吴越飘零一叶轻，战场暂息虎狼争。\n身闲自适琴书乐，耳冷宁闻宠辱惊。\n系表对谈通妙义，禅源默契涤凡情。\n他年更遂茅齐约，重使云间见弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次平叔韵","author":"李正民","text":"草长江南送暮春，谁怜羁羽及沈鳞。\n放怀自适渔樵乐，会面欣逢手足亲。\n齿发渐凋嗟晚景，田园粗葺作闲人。\n材高莫叹时相负，会见诸公宠荐频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同院蜡梅 其一","author":"李正民","text":"曾笑江妃粉面光，化工端为拂娇黄。\n蜜脾旋滴明如剪，宫额新涂暗有香。\n应与巩梅分气味，不同陶菊斗轻狂。\n捧心谁识西施病，临鉴深颦未试妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同院蜡梅 其二","author":"李正民","text":"岭梅开过已飘扬，独出奇姿浅淡黄。\n绛萼巧粘花蕊蜜，缃罗轻熨水沉香。\n光摇烛跋连宵赏，色映鹅儿殢酒狂。\n只恐寿阳公主怪，蛾眉画了不成妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同院蜡梅 其三","author":"李正民","text":"瘦骨纤肌出众芳，嘉名聊占蜜脾黄。\n秦酥乱点寒生粟，春酒初开冻发香。\n事异代薪矜屋润，巧同刻凤伴儿狂。\n十年不见春风面，依旧轻轻薄薄妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋","author":"李正民","text":"不杂寒枝冰雪光，蜜脾初点一分黄。\n裁时巧借韩湘手，到处浓薰荀令香。\n东阁敛藏羞太白，游蜂邂逅恍如狂。\n艳阳时节閒桃李，任学风流时世妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东海生欲以酒见遗而郡禁方严仆每饮又少作诗谢之","author":"李正民","text":"霜凝鸳瓦晓纤纤，静拥寒炉火屡添。\n白堕春醪空有意，青州从事邈难瞻。\n幸逢朱博杯盘少，况值曹公禁令严。\n瓶汲甘泉聊漱齿，鸱夷应笑若清廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览镜","author":"李正民","text":"览镜空惊鬓发凋，暮年踪迹逐渔樵。\n如无似有梅天雨，暂去还来海浦潮。\n栗里忘忧惟浊酒，锦城排闷且长谣。\n草堂日晏犹高枕，不怕当关苦见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客有以茶易竹次韵","author":"李正民","text":"琅玕黝璧两清虚，不比山阴鹅换书。\n花乳试烹应有味，龙孙新种未嫌疏。\n轻身通气宜君饮，冒雪停霜称我居。\n斜曲短长休更问，森罗万象已如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和换竹","author":"李正民","text":"此君风度不可无，禅老方翻贝叶书。\n试遣酪奴相问讯，为邀青士看扶疏。\n芳香雅称松江水，苍翠还宜长者居。\n明月清风随处是，去来有分意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同院梅花 其一","author":"李正民","text":"岁残万木冻如痴，聚窟飘香起玉肌。\n韵胜自依山谷里，肤清偏称月明时。\n且看雪后微微折，只怕风前细细吹。\n蓬岛瑶池空入梦，不将清兴属芳枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同院梅花 其二","author":"李正民","text":"孤标无物可相宜，浅浅娇黄点素肌。\n曾向扬州动诗兴，不劳杜宇啭芳时。\n高情已与云为友，冷艳仍愁雪共吹。\n自笑刚肠如铁石，难陪徐庾赋南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同院梅花 其三","author":"李正民","text":"清真淡薄正相宜，肯使赪容透玉肌。\n自倚怀冰难受染，何妨凌雪独先时。\n烟迷远树依稀见，风度回塘取次吹。\n闻说江南春信早，凭君折取最繁枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和舒伯源梅花韵 其一","author":"李正民","text":"极目凄迷杳霭间，群芳敛迹自知难。\n半穿篱落涂黄浅，静对溪流照影寒。\n月地云阶偏适意，雪车冰柱苦相干。\n莫随羌笛风前舞，却怕青青逼齿酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和舒伯源梅花韵 其二","author":"李正民","text":"群芳谁与斗时宜，淡拂铅华不著肌。\n爱静悄无蜂蝶影，耐寒孤映雪霜时。\n珑璁喜见银蟾满，零落愁听画角吹。\n几许妍词传不尽，只誇半树与横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和舒伯源梅花韵 其三","author":"李正民","text":"叶落千林景最宜，天教姑射露冰肌。\n轻明素粉初匀后，浅淡娇黄半吐时。\n青女有情来慰藉，姮娥着意借嘘吹。\n不须驿使传消息，看尽南枝与北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和舒伯源梅花韵 其四","author":"李正民","text":"檐卜花开鹫岭西，何如江国见纤肌。\n自矜六出非凡格，独占三冬最晚时。\n刻玉漫劳誇智巧，镂冰那复耐风吹。\n短墙深院凄凉甚，竹外攲斜一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和舒伯源梅花韵 其五","author":"李正民","text":"一种幽香取次宜，耻同桃杏献琼肌。\n为嫌脂粉污真色，谁道冰容不入时。\n寒透芳心能底瘦，风欺弱质等閒吹。\n清樽何惜花前醉，莫待飘零空折枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春游","author":"李正民","text":"草薰风暖气潜催，桃李商量次第开。\n纂纂何须歌枣下，熙熙聊复上春台。\n田园粗足终归去，轩冕无心任傥来。\n尽道人生行乐尔，勿辞频覆掌中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观德邵诗卷","author":"李正民","text":"天涯几点四明山，万里沧溟去路难。\n春晚池塘空梦草，老来尘土倦弹冠。\n文雄自可收三捷，诗好那能博一官。\n秋赋已闻丹诏下，九霄寥廓看鹏抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵同院晚春 其一","author":"李正民","text":"病思愁肠叵奈何，新诗无复苦磋磨。\n欣闻郢客阳春曲，罢唱吴侬小海歌。\n幽径雨馀芳草绿，小园风静落花多。\n融樽正好酬佳景，休叹朋簪不我过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵同院晚春 其二","author":"李正民","text":"华年衮衮似江波，更被閒愁暗折磨。\n懒逐西园飞皂盖，却寻严濑听新歌。\n春光不为干戈减，花发长嗟风雨多。\n已束轻装增别恨，竹林高会阻经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄和叔 其一","author":"李正民","text":"双鱼来自縠溪端，手把缄书子细看。\n授业马融褰绛帐，怀归王粲倚危栏。\n且凭黄耳传消息，未办青蚨济急难。\n七十从心今已过，保兹遐福愿加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄和叔 其二","author":"李正民","text":"飘泊柯山二十春，琴书索莫困埃尘。\n忆攀杨柳当年别，愁见桃花几度新。\n公业有田犹告乏，渊明解绶便忧贫。\n浮生种种皆为累，况是羁栖一旅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄尹叔 其一","author":"李正民","text":"来往三吴几度春，星星华发镜中新。\n厌餐柯岭冷毛羜，急趁松江雉尾莼。\n东海且垂任子钓，西风尚畏庾公尘。\n二千石禄惭非称，未作隳官谢病人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄尹叔 其二","author":"李正民","text":"为人疏懒自天真，从宦区区本为贫。\n尚恨有情难学道，正缘无事不随人。\n腥咸连日逢河伯，击拍终宵困黍民。\n乐静爱閒吾得计，何须更问要涂津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄毕少董","author":"李正民","text":"求金未有张车子，梦草聊同谢客儿。\n万里辛勤形骨瘦，十年流落鬓毛衰。\n蓬蒿绕舍春归后，苜蓿堆盘日上时。\n极目五湖烟水阔，扁舟重理钓鱼丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄元叔","author":"李正民","text":"十束三钟未苦贫，端居终岁谢尘氛。\n春回苒苒生芳草，日暮悠悠对碧云。\n往事已嗟存土梗，乘时争欲辨莸薰。\n伤心极目空千里，肠断稽山正忆君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄和叔 其一","author":"李正民","text":"君书于我不能忘，我亦思君苦断肠。\n女嫁儿婚方扰扰，宦情文意愈茫茫。\n病来颇厌杯中绿，老去时添鬓畔霜。\n一夜西风破残暑，蛩吟四壁倍凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄和叔 其二","author":"李正民","text":"阮公痛哭到途穷，碧海相望西与东。\n流落真同土木偶，奔驰方类马牛风。\n乌衣旧会嗟难继，黄耳家书杳不通。\n桂树连蜷猿啸苦，王孙何久滞山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄和叔 其三","author":"李正民","text":"木落山高断旅魂，可堪云水隔烟村。\n分甘赖有东屯稻，托赠初无西瀼园。\n淮上纷纭鼙鼓震，海隅络绎羽书奔。\n何时却得同樽酒，弟劝兄酬笑语喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄和叔 其四","author":"李正民","text":"半生粗粝嗣先芬，肯向朝晡造业因。\n夜鲤晨凫那竞爽，露葵霜薤自称珍。\n烝豚未辨王武子，豆粥犹惭石季伦。\n惟有清高井居士，葱齑麦饭久酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再领宫祠","author":"李正民","text":"流落天涯任转蓬，三千窃禄愧无功。\n身游乌帽黄尘外，名在丹台紫府中。\n赖有俸钱优白傅，且教閒处着司空。\n挥毫拟就归田赋，检点山资苦未丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘卿任尝新茶于佛舍元叔弟赋诗次韵 其一","author":"李正民","text":"禁籞初尝瑞草新，侯邦仍得贵馀珍。\n筠篮带雾分佳品，禅榻飏烟集众宾。\n花乳清泠仙掌露，云腴浮泛建溪春。\n草堂睡起传佳句，愧我难陪清路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘卿任尝新茶于佛舍元叔弟赋诗次韵 其二","author":"李正民","text":"北苑春芽斗后先，斲成圭璧任方圆。\n泉轻火活汤宜嫩，乳聚云浮色更鲜。\n一种风流香味别，几苞辐辏贵豪偏。\n华堂饮散纤纤捧，气爽神清作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀旧","author":"李正民","text":"遁迹渔盐远市朝，回廊落叶响萧萧。\n云迷岭岫天将雪，草没汀洲海上潮。\n欲寄新诗人杳杳，重寻旧会恨迢迢。\n暮年更欠刘龚语，门翳蓬蒿转寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泉守汪兄内翰惠荔子蕉乾","author":"李正民","text":"远使担簦到草堂，泉州太守未相忘。\n素书岂但寒暄问，篚实仍分果蓏香。\n荔子尚滋闽岭露，蕉乾犹带粤林霜。\n自怜辽鹤归飞倦，咀嚼偏知气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔来谒李守值其在告作诗戏之","author":"李正民","text":"赤袍画戟拥朱门，铃阁晨扃正谢宾。\n京兆欲行犹案事，杜陵投老尚论亲。\n蕙帷鹤怨空寒夜，名纸毛生踏路尘。\n南郡高风非托疾，未应吐哺愧前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送元叔守建昌 其一","author":"李正民","text":"论都献赋动凝旒，谁料材高却滞留。\n芸阁九乌刊蠹简，霜台一鹗在清秋。\n中年未得文章力，俭岁空怀儿女忧。\n游刃小邦真易尔，且将歌吹荐觥筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送元叔守建昌 其二","author":"李正民","text":"少时佔毕共辛勤，晚岁飘零寂寞滨。\n未分尘埃蒙琬琰，岂容蹭蹬老麒麟。\n文因饱学多多辨，诗为穷愁日日新。\n五十专城虽不晚，汉廷诏令要词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]