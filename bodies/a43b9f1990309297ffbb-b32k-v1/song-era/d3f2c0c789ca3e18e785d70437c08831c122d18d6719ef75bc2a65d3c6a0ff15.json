[{"title":"呈唐德舆兼寄呈可久三首 其一","author":"赵蕃","text":"白头四海客，青眼几何人。\n况复平生旧，端殊数面亲。\n文声虽益振，仕簿亦何屯。\n好在章江水，聊堪濯世尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈晁舅祖叔蕴","author":"赵蕃","text":"辈行虽如祖，年龄仅可兄。\n经过得屡见，文字有同盟。\n门户当深责，饥寒厌此生。\n良农务穮蓘，初不计秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈莫信州障二首 其二","author":"赵蕃","text":"公为州牧我州民，敢叙当年半面亲。\n故喜来归逢稔岁，况于游倦得閒身。\n无功良酝不可恋，仲叔猪肝犹累人。\n最是妻孥苦惊怪，奈何造请尚趋晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈莫信州障二首 其一","author":"赵蕃","text":"稍将书札报黄堂，仅得官亭系野航。\n文物愿窥中秘直，风流曾识省曹郎。\n莫言长孺今闭閤，旧说葛丰能击彊。\n未信吾州留得住，天书咫尺会徵黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈逢宣子","author":"赵蕃","text":"叹息逢宣子，频为郡国宾。\n人皆说才具，我独爱词人。\n邂逅殊方见，凄凉半月春。\n但能诗似镜，从使鬓如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈郭峡州二首 其二","author":"赵蕃","text":"乡来识面苦无因，今日升堂叙所亲。\n岂爱潇湘为隐地，故嗟伊洛涴风尘。\n周程授受源流远，广受声名物望均。\n诏旨已闻班郡绂，徵书看即动蒲轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈郭峡州二首 其一","author":"赵蕃","text":"往者枉书并赐诗，蔼然高义见乎词。\n襄阳耆旧今馀几，海内风流更属谁。\n早日有怀期见止，秋风于此得来思。\n顾虽愿被林宗识，却恐人非讵辱知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈康职君谟","author":"赵蕃","text":"高谭自可解人颐，何况携醪烹伏雌。\n衰白无庸辨须发，困穷端只坐书诗。\n西湖阅境君其访，南亩深耕我自期。\n异日书来话畴昔，黄溪寺下雨昏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈晦庵二首 其二","author":"赵蕃","text":"不上龙门五过秋，袖诗还是觅扁舟。\n胡然贫病祇如昔，听尔行藏随所由。\n未厌室人能我谪，故防知己作公羞。\n孟郊五十酸寒尉，想见溧阳神尚游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈晦庵二首 其一","author":"赵蕃","text":"一纸书来遂隔年，江湖远地水连天。\n纷纷横路又逢此，凛凛岁寒嗟独然。\n学道终期世勋业，抄经暂了佛因缘。\n白头下士重来拜，依旧鸥汀鹭渚边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈梁从善","author":"赵蕃","text":"飘流老矣谓知津，邂逅欣然愿卜邻。\n不但梁邢丈人行，更吾骚雅社中人。\n前秋一见遽为别，今日重来情倍亲。\n政自论诗得欢喜，更因话旧忽酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈黄永新希二首 其二","author":"赵蕃","text":"偶作空房寓，频成假日从。\n平生壮诗胆，一见怯谭锋。\n天地虽云碍，江湖讵不容。\n终南捷径绝，衡岳卧图逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈黄永新希二首 其一","author":"赵蕃","text":"江夏无双士，嘉禾百里君。\n信非今日吏，要与古人群。\n阅世卧松柏，过前纷蚋蚊。\n薰莸自我别，青白在渠分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈曾侍郎逮","author":"赵蕃","text":"思人几作访茶山，竹密如云不敢删。\n未觉风流成岁远，政繇伯仲力追还。\n长公旧日曾一识，末路后来遭百艰。\n邂逅探囊得行记，赠公试遣略承颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈葛抚州二首 其二","author":"赵蕃","text":"试说临川郡，江西第一州。\n晏王今邑子，颜谢古诸侯。\n未觉流风远，端知物望优。\n岘山犹得拟，湛辈肯容不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈葛抚州二首 其一","author":"赵蕃","text":"人物与江山，风流适比肩。\n家声自勾漏，出守更临川。\n美政人人说，新诗句句传。\n五言成漫兴，一见岂无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈谢资深县丞源","author":"赵蕃","text":"平生梦寐临川郡，故在溪堂竹友斋。\n句法已看行世集，风声犹得起人怀。\n有孙住著园依水，薄宦旧来松俨槐。\n纵是尘埃政冲突，可无一语道离乖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈简寿玉","author":"赵蕃","text":"门外双槐日已高，庭中钜竹与争豪。\n萧萧共倚青云翰，渺渺仍工白雪操。\n欲向潇湘访兰芷，却从吴越看波涛。\n问君役役胡为尔，我亦叹嗟出入劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈慧力然老","author":"赵蕃","text":"慧力知名寺，混融开士英。\n宗乘真继祖，翰墨亦兼名。\n更用终何得，悠然听此生。\n怀哉躬井碓，永绝世尘撄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘文叔二首 其二","author":"赵蕃","text":"寓舍莓苔合，春郊花草香。\n忽逢宁比料，欲语未能长。\n大阮为勿药，阿连欣对床。\n嗟予重多感，有弟各殊方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘文叔二首 其一","author":"赵蕃","text":"岳寺分携后，邮亭邂逅时。\n鸣鞭萍实驿，分韵木犀诗。\n契阔书忘素，飘零鬓益丝。\n我归宁偶尔，君至忽于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈衡州使君先生二首 其二","author":"赵蕃","text":"常州何乃又衡州，或谓兹行乃胜游。\n钟鼓相闻寻岳寺，茝兰无数踏湘流。\n是中夫岂先生乐，此段聊供幽子求。\n岳麓相望唯石鼓，要令吾辈务藏修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈衡州使君先生二首 其一","author":"赵蕃","text":"当年月以秋中过，今岁凉因闰故迟。\n渴想话言思亟见，暑侵鞍马敢云疲。\n曾闻遗俗有存者，岂若吾身亲见之。\n少不如人今老矣，朝闻夕死庶几为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"告别晦庵晦庵有惜别语因用张志和答陆羽问作诗呈之","author":"赵蕃","text":"负笈初忘道阻长，求船翻为岁奔忙。\n一尊故惜时重与，四海当知别未尝。\n渭北江东无异辙，太虚明月本同光。\n属公忽讳轻为别，遣客仍知醉不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"困坐穷山无以娱日用随斋问讯韵寄莘夫并呈随斋","author":"赵蕃","text":"少陵苦忆将廉颇，才似淮阴亦奈何。\n岂待秋风方忆鲙，不堪夏日况挥戈。\n分当鹿鹿终随后，言敢譊譊取屡诃。\n世事多虞未知免，鹅烹复坐不能歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝扬成父约见过屡展期云须晴也","author":"赵蕃","text":"雨到丛篁忽暗鸣，谯门应已载传更。\n伯淮被冷睡难著，孺子榻空尘欲生。\n几戒樵青成痛扫，屡闻黄耳递虚声。\n逢迎可待休形叹，祇恐穷冬无好晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋行中履叔以其先兄时中亨伯穷藁借观归之","author":"赵蕃","text":"古寺秋风客，难兄昔日诗。\n人间非旧识，地下有新知。\n为禄归难早，知穷计已迟。\n因声语吾弟，吾亦类渠痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张以诗卷来再用韵谢之","author":"赵蕃","text":"绝叹风流不可追，赖闻难弟更能诗。\n半生求识终无遇，一见于今已后期。\n昔在蛮荆孰疆理，后来秦汉始津涯。\n征南政欲图经借，把卷如同禹穴窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张王臣贶诗诘朝遂行次韵寄之","author":"赵蕃","text":"书贵在瘦硬，诗须成管弦。\n典刑君尚有，老至我加年。\n早作诸侯客，远劳从事贤。\n见来元不款，别去忽何边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张因叔尉曹借示赣陈丞择之文编以长句还之","author":"赵蕃","text":"子昂高蹈固家风，诗到后山仍更工。\n何事栖迟犹五斗，向来推许漫诸公。\n平生但记逢人说，一洗真成凡马空。\n今日宦游得此士，知君不类溧阳穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张伯永简来云雪欲作而酒适熟尉又过之要余同集","author":"赵蕃","text":"久旱疑为瘴，晚风生许寒。\n梅花逾孤厉，人意绝荒残。\n漉酒能呼我，知公故解欢。\n平明如雪满，快阁上危栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张涪州出诗数轴皆纪用兵以来时事有感借其韵","author":"赵蕃","text":"感时赋咏属英游，又向涪江说去秋。\n兵甲未休须壮士，闾阎乃敢问封侯。\n频年青坂陈陶恨，到处阳春白雪留。\n谁道东归穷彻骨，骊书落落照书舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀公择且问讯成父","author":"赵蕃","text":"山雨戴溪云，茅檐昼不分。\n林花应扫地，我友况离群。\n数口饥寒累，三生翰墨勤。\n因声问吾弟，几日定行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀王彦博徐审知","author":"赵蕃","text":"遮眼文书倦，可人亲友赊。\n雨疏无更有，鸦断直还斜。\n两鬓宁禁白，馀生孰可涯。\n关余三作径，愧尔五其车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧","author":"赵蕃","text":"千林犹自绿，一树独能红。\n午霭全收外，夕阳将坠中。\n画谁能事独，诗我故人工。\n物色凄凉甚，裴回讽咏同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀甘叔异曲江庵寄叔异","author":"赵蕃","text":"梦寐曲江矶，矶头隐墅扉。\n朝筇惊鹭起，暮履看渔归。\n志士泣兰芷，高人甘蕨薇。\n怅予非所事，乐尔谢尘鞿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀成父 其二","author":"赵蕃","text":"竹里人家茅舍烟，竹篱崩缺涧鸣泉。\n几声啼鸟隔林唤，两树桃花相对然。\n古路经行斜更直，好山迎我后仍前。\n暂谋坐睡还成觉，春草池塘思惠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀成父","author":"赵蕃","text":"晓枕占乾鹊，昏檐数湿萤。\n竹风愁独立，山雨要同听。\n懒更翻黄卷，还成倒浊瓶。\n犹疑到或晚，戒勿掩柴扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀成父 其一","author":"赵蕃","text":"柳黄初作一夜秋，诗瘦宁消万古愁。\n客子岂无衣褐念，飞鸿犹作稻粱谋。\n早须微禄非因酒，晚愿全生但守丘。\n望尔不来来且去，江头吾已具归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀伯谟","author":"赵蕃","text":"为忆窗间句，思从物外人。\n白云空在望，青眼为谁新。\n一别已数载，再来还几晨。\n期君归对策，过我莫嫌贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀张丞用多字韵兼属明叔","author":"赵蕃","text":"愁阴颇觉助烦疴，别日回头已似多。\n联诗古亦有韩孟，共和今岂无羊何。\n踏青未晚归来约，举白何妨醉后歌。\n顾惮礼容成简慢，愿君贳我勿加诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀李商叟 其一","author":"赵蕃","text":"旧隐屏风叠，而今半在村。\n作诗传正派，对客理清言。\n我埽山中屋，君开竹下轩。\n风流要还往，一叶任溪喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀李商叟 其二","author":"赵蕃","text":"好在半村宅，竹添桐长枝。\n空馀相忆梦，不见寄来诗。\n苦节君耆旧，卑官我判司。\n因来贵溪水，一为洗尘缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀灵山呈元衡","author":"赵蕃","text":"故人移住远，明月挂檐迟。\n谁复相过语，何从更觅诗。\n白头甘斗食，青眼望群儿。\n想见灵山阁，云峰夏愈奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀明叔三首 其三","author":"赵蕃","text":"微风吹甚清，缺月照同盈。\n盘礴得露坐，喧阗嫌市声。\n何胜忆玄度，底处觅弥明。\n念我筠窗底，萧然榻正横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀明叔三首 其二","author":"赵蕃","text":"纷纷阅投刺，往往尽冠儒。\n岁晚见松柏，火炎知珷玞。\n寒厅怜我独，玉趾赖君迂。\n政尔如修竹，何能一日无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀明叔三首 其一","author":"赵蕃","text":"结交不在早，倾盖有馀欢。\n愧比陈蕃榻，犹吾陋巷箪。\n新来几日别，无计百忧宽。\n世俗轻交态，相期在岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀明叔晚题","author":"赵蕃","text":"室暗莫遽寝，庭空成漫行。\n蚊喧方夏聚，虫咽已秋鸣。\n月淡星能著，云疏电或明。\n可人非故乏，幽处莫能并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀秉文","author":"赵蕃","text":"稍过湖头路，临流但远林。\n打篷知雨急，荡桨觉溪深。\n红叶专秋色，青铜慨古心。\n平生学诗友，两地复离襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀谢子畅","author":"赵蕃","text":"中年非畏别，我辈自情钟。\n惨澹千山雨，凄凉四壁蛩。\n有诗因闷得，无酒似愁浓。\n未说扶携去，犹期一再逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投介庵先生并寄庐陵周侍郎四首 其四","author":"赵蕃","text":"粗识诗中趣，翻怜笔下难。\n中流疑失楫，远举虑摧翰。\n起我七十病，蕲公九转丹。\n韩豪非所敢，曾未到郊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投介庵先生并寄庐陵周侍郎四首 其三","author":"赵蕃","text":"桐乡曾作令，使者复乘车。\n风俗因子厚，溪山要我居。\n此声闻旧矣，今日见归欤。\n祇恐功名事，毋庸遽舍诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投介庵先生并寄庐陵周侍郎四首 其二","author":"赵蕃","text":"贰卿辞郡日，刺史乞身年。\n往事甑已堕，归来璧顾全。\n坐令颓俗振，未觉古人贤。\n白鹭思高举，琵琶有直弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投介庵先生并寄庐陵周侍郎四首 其一","author":"赵蕃","text":"忽忆沧洲去，何心汉节持。\n上书期得请，勇退复奚疑。\n用舍非吾事，荣枯自彼时。\n疾风劲草见，松柏岁寒知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投宿龙溪寺夜行迷道者久之","author":"赵蕃","text":"已辨龙溪宿，宁知鸟路迂。\n林光收琐碎，山月失须臾。\n见约虽田父，归尤自老夫。\n但知寻野寺，不拟问官途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投宿清福寺","author":"赵蕃","text":"落日迷墟落，林霏隔树林。\n入门疑寺近，出谷听钟深。\n墐户觅安寝，隔篱谋浊斟。\n不眠还耿耿，百虑搅予心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投宿湘东","author":"赵蕃","text":"雾雨杂炊烟，山巅复树巅。\n初疑但纷若，有听忽骚然。\n立马看题壁，冲鸥唤渡船。\n莫嗟饥雁外，且及暮鸦前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投曾原伯运使二首 其二","author":"赵蕃","text":"远地书邮绝，长年属望劳。\n要期亲帚柄，宁惮学舟操。\n愧守藩篱小，难窥墙仞高。\n秋风满天地，不废候虫号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投曾原伯运使二首 其一","author":"赵蕃","text":"一自嘉禾见，于今岁几多。\n飞腾公可那，流落我如何。\n旧说金能点，今成镜失磨。\n未甘终痼疾，还复向医和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抚州初程夜寄孙温叟甘叔异","author":"赵蕃","text":"水激成悲壮，星稀乍有无。\n店荒容托宿，酒远懒能沽。\n冉冉非今日，遑遑愧此途。\n孙甘两奇逸，萧飒旧怜吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李通判休日约僚属追凉于净因已复酌于芙蕖馆既题名于寺之壁为赋唐律","author":"赵蕃","text":"野寺依林木，官园带芰荷。\n饭蔬朝共集，尊酒晚成过。\n岁月记游胜，礼容宽俗苛。\n公能数倾倒，我得慰蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李商叟传录临川与黎师侯唱酬怀曾文清公长句用韵作四首 其四","author":"赵蕃","text":"叹息茶山识面迟，经过旧宅恨推移。\n听泉尚想甘瓢乐，抚竹如亲与物离。\n千首未多行世集，数篇才刻住山诗。\n属君勉力任兹事，吾道祇今棼若丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李商叟传录临川与黎师侯唱酬怀曾文清公长句用韵作四首 其三","author":"赵蕃","text":"向夕相寻昔步迟，坐残初月见阴移。\n关心去后几南北，倒指从前屡合离。\n君叹我贫犹为米，我怜君苦伹耽诗。\n三山堂下冰溪水，何日扁舟两钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李商叟传录临川与黎师侯唱酬怀曾文清公长句用韵作四首 其二","author":"赵蕃","text":"生世胡为尔许迟，况经事变与时移。\n论文尚喜两公在，一见何胜隔岁离。\n落木长江天末恨，清风朗月卷中诗。\n有怀曾子今冥漠，雨泪真成满面丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李商叟传录临川与黎师侯唱酬怀曾文清公长句用韵作四首 其一","author":"赵蕃","text":"欲访临川苦恨迟，一官窘束费符移。\n台高纳日朝寻胜，蕉合生风夜语离。\n别后有怀长入梦，向来未识已传诗。\n信知习气难除洗，可怪深悲墨翟丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李商叟举似用南涧山字韵茶山星字韵数诗辄借韵呈商叟二首 其二","author":"赵蕃","text":"吾州畴昔聚文星，我已后之君有声。\n丹笔未雠天禄阁，白头犹住锦官城。\n旧谙林麓深堪隐，今见溪山远更明。\n剩欲相投小盘礴，溪头亡那橹双鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]