[{"title":"送刘兄西上","author":"林希逸","text":"春光已入柳条催，雪后孤山尚有梅。\n泉上老人携子去，天中多士待君来。\n绝知戏綵怡颜久，便合看花得意回。\n遥想端门迎马处，不妨翁季共传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰元日作","author":"林希逸","text":"云暗长空夜不风，新年又与旧年同。\n身前百念翁俱足，但几乡田岁屡丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初二日作","author":"林希逸","text":"一饱祇期与众同，残年自分乐溪中。\n此心久为云留住，犹梦持笺入帝宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"象祖戊辰元日初冠仍拜敕命","author":"林希逸","text":"老得渠为第二孙，加冠还已向春元。\n蓝袍试拜痴翁喜，初敕题名圣主恩。\n好续世科如汝父，勉求师学大吾门。\n一樽长幼团圞笑，虽愧儒酸礼略存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临清堂前观红梅作","author":"林希逸","text":"滨溪竹伴老梅丛，一种风姿与杏同。\n直者倒垂横者瘦，水中同漾影青红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林少嘉西上","author":"林希逸","text":"声名早出自儿曹，埸屋尤推笔力高。\n老大诗魔空白发，几多榜少已青袍。\n穷通有道吾何畏，文字随时看所遭。\n簪取宫花归锦后，不妨痛饮诵离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴子谦西上","author":"林希逸","text":"君家学问富源流，世守书窗志未酬。\n曾记麒麟初抱日，喜看雕鹗再横秋。\n龙飞恩数优多士，胪唱声名占上流。\n我为汝翁期望汝，捷书闻日报溪头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送戴兄西上","author":"林希逸","text":"乃翁白发栖鸾去，夙志勤勤待汝成。\n自古文章有定价，如兄词赋合先鸣。\n今年恩数非常比，上甲科名著意争。\n语别溪干聊赠句，南归伫看锦衣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王税院西上","author":"林希逸","text":"词埸百战气尤豪，此友真如老伏波。\n本色蓝袍须用著，到头铁砚岂空磨。\n向来鹗荐飞腾屡，此去龙飞恩数多。\n遥想玉阶胪唱后，小珰觅句看挥毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵送徐平父西上","author":"林希逸","text":"鸣鞭西上访渔村，倒屣霜朝喜及门。\n豹隐频年聊蓄锐，龙飞今岁有殊恩。\n诵先朝赋知名祖，读外家书见此孙。\n千载艾轩吾敬慕，袖中锦轴两诗存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林汝大西上","author":"林希逸","text":"一第于兄何足溷，相期十载恨悠悠。\n未闻鲤化三层浪，但见雕横几度秋。\n手妙八叉时辈服，眼迷五色主司羞。\n舒徐有待知天意，要作龙飞榜状头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈清夫西上","author":"林希逸","text":"健笔朋俦推许久，芬芬几播桂花秋。\n词埸多羡君叉手，省户须看鬼点头。\n昔送广文生有序，今无瞌睡汉争筹。\n高科迟取君休讶，恩数龙飞榜最优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林毅夫西上","author":"林希逸","text":"乃翁赋手妙驰名，白发青衫恨晚成。\n宋玉大招惭老友，枚皋末句属吾兄。\n专场见说词锋锐，跨灶应知话柄行。\n圣御六龙新策士，输忠不厌字纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰谒伯祖惠阳使君坟三绝 其一","author":"林希逸","text":"一山双脉两翁藏，最久凋零长一房。\n谁道败墙荒草里，冢中枯骨昔金章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰谒伯祖惠阳使君坟三绝 其二","author":"林希逸","text":"少日春秋学最高，年踰弱冠掇危科。\n也乘五马鹅湖去，埋玉凄凄草一窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰谒伯祖惠阳使君坟三绝 其三","author":"林希逸","text":"手足情钟共处埋，荣枯顿异可胜哀。\n长公松下无人扫，三从诸孙岁一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送余兄西上","author":"林希逸","text":"得意秋风早，香浮桂籍中。\n清疑卫玠是，年与贾生同。\n鹏化多诸从，龙飞上两翁。\n此行宜趾美，伫见赋摩空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送蔡弥坚西上","author":"林希逸","text":"春试新因闰少迟，行行应见柳舒眉。\n香留丹桂籍中久，名写金花帖上宜。\n一榜三魁同我里，重轮六戊属今时。\n赠言此意殷勤甚，就有安书寄小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵题马氏亦乐园集","author":"林希逸","text":"何处君家亦乐园，遥知眼界与天宽。\n年时料得群花好，岁晚祇留老树蟠。\n佳客酒中吟李白，主人林下见韦丹。\n事随鸿去今如梦，却有赓酬集可观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵和黄兄","author":"林希逸","text":"老如枯柏傲霜冬，名实俱忘赋芧公。\n正苦岁寒无竹伴，喜知春思与梅同。\n囊书待朔登金马，琢句追坡咏玉虹。\n他日肯寻翁住处，花边野水与池通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨晚溪缘之论闻善友颇不能堪戏成八句","author":"林希逸","text":"作室道谋虽不可，同舟义等又何疑。\n自贤必去能贤也，不受何宗是受之。\n非马固知难喻马，围棋恐未及看棋。\n溪干老子归来笑，忆到行河集议时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题化龙桥碑","author":"林希逸","text":"桥以乡名曰万安，篆碑谁作曰溪干。\n化龙二字重修得，归鹤千年耐久看。\n钩画不凡非世有，精神欲动肯泥蟠。\n崇宁石在文尤古，虹笔相辉射斗寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠周医主簿和后村诗","author":"林希逸","text":"紫橐埙篪派易推，丹炉芽雪妙谁知。\n方因龙得来何处，棘为鸾栖住几时。\n见似臞仙清可掬，胜他流辈俗难医。\n樗庵有句吾拈出，谒两孤山共和之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄兴","author":"林希逸","text":"生涯薄薄仰田畴，破敝犹存晏子裘。\n聊向太虚中过活，何曾自已外驰求。\n狂吟时有衔杯兴，退省知无障扇羞。\n老守残书差得趣，人间别一种风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洗石蒲作","author":"林希逸","text":"似发青蒲石顶鲜，与奴疏剔换青泉。\n莫嫌水部寒贫气，聊结涪翁潇洒缘。\n昼永久看云独立，夜寒略对月还眠。\n焚香弄镜皆书味，时有新诗入续编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗真隐已化数年曾纠仕五羊病中尝访渠为之求乐曾知其已逝颇有问答曾今为漳倅亲与东庵道老言之","author":"林希逸","text":"生时句句有玄机，语我因医偶造微。\n霞屿已题新窆石，羊城还著旧深衣。\n曼卿见说乘骡去，丁令尝闻化鹤归。\n葱岭相逢提履者，宋云恐被后人讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰二月六日作","author":"林希逸","text":"事随时去似飞澜，具眼应须以道观。\n汤武交争棋里见，唐虞气象瑟中看。\n寄情物外吟差乐，回首尘间意久阑。\n多一月春还过半，先生随分老溪干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读昌黎与孟简书作","author":"林希逸","text":"学能害道义当排，深浅还须究竟来。\n动静理如双转毂，危微心要两俱灰。\n俟之不贰知天矣，逝者如斯叹水哉。\n却笑留衣韩十八，羡人明识外形骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴","author":"林希逸","text":"老后粗知见处真，世缘随顺不妨贫。\n静看星斗尊吾性，閒对烟云笑此身。\n旧学易忘缘懒散，近诗多拙欠尖新。\n从今只合逃名去，似此饥穷昔几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓作偶成","author":"林希逸","text":"饭粟羹藜漫曲肱，病无俗物也身轻。\n万钱下箸非吾事，数卷残书了此生。\n学浅幸无禅二障，心閒喜与迹双清。\n更长睡足元无梦，又听檐间足足鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村喜大渊至二首 其一","author":"林希逸","text":"可笑儿痴觅句忙，先生善诱许升堂。\n未应得髓能如可，敢道言诗亦与商。\n笔落更誇风雨疾，袖回犹射斗牛光。\n句中有眼容参取，肯靳涪翁古印章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村喜大渊至二首 其二","author":"林希逸","text":"问疾维摩本不任，招延多谢屡挥金。\n伏波床下容松拜，康节窝中为客吟。\n新语粲花空把玩，旧游煨芋阻追寻。\n老惭筋力难为礼，南北相望只嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和效颦一首","author":"林希逸","text":"诗能妨病语情真，才大犹如富傲贫。\n强作手书诚愧我，那知腹稿不劳人。\n生平酷好乐何苦，集本多传续又新。\n拚却此身吟送老，百骸虽在果谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶万山以诗求诗为赋一首","author":"林希逸","text":"闻说君家旧业儒，贪游到处曳长裾。\n学青乌子通砂法，傍紫阳翁故里居。\n吟苦虽无堪煮字，交穷却有救贫书。\n虚中融结皆真理，朱蔡犹谈可但渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈伯厚试上庠","author":"林希逸","text":"才华早已逼难兄，声动贤关指日听。\n万卷饱看双眼碧，一篇聊换半身青。\n三都赋出愁无纸，千佛名题会有经。\n投老溪干吟送别，旧游回首梦炉亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后村再和堂字二首且云欲谢遣孤月一意祈天用韵为谢 其一","author":"林希逸","text":"问药虽忙吟更忙，新诗必富似龟堂。\n未能载雪寻安道，恨不乘风学老商。\n伊昔虱心看愈大，因何牛背射无光。\n疑公只欠长明颂，不用云璈共绿章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后村再和堂字二首且云欲谢遣孤月一意祈天用韵为谢 其二","author":"林希逸","text":"诗工如沈笔如任，到手篇篇玉应金。\n月好岂无搔首梦，日长谁伴撚髭吟。\n如今具眼师能几，何处还睛佛可寻。\n来往莫嫌贫问讯，也胜空谷听跫音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和桃巷吏部用鄙韵三首 其一","author":"林希逸","text":"人间波浪胜扬澜，对镜知公有达观。\n晚喜骑驴半山去，早曾立马万人看。\n平头八秩身逾健，信手千诗兴未阑。\n应笑溪翁耽贝叶，但寻破寺访丰干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和桃巷吏部用鄙韵三首 其二","author":"林希逸","text":"袖疏曾将紫闼排，山今排闼送诗来。\n试评藜杖为吹火，何似麻衣共拨灰。\n濠上鯈鱼真乐也，山梁雌雉信时哉。\n只愁驱上蒲轮去，不许笺天强乞骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和桃巷吏部用鄙韵三首 其三","author":"林希逸","text":"老学黔娄已逼真，他年谁解传寒贫。\n曾供天老书题目，空守将军醉告身。\n山似友于青眼在，世多交绝白头新。\n痴儿浪下庞公拜，许作樽前问字人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴司户之任","author":"林希逸","text":"南州诧说才名早，到手青衫已二毛。\n自守冰霜真铁汉，肯淹岁月待珠曹。\n遥知玉节将争致，暂掌牙筹莫厌劳。\n圣世怜才甄拔易，倚须去著锦宫袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵谢桃巷 其一","author":"林希逸","text":"清吟思涌似回澜，家数他年比务观。\n歌舞丛中知散易，功名纸上要留看。\n吹残柳雪寒仍在，数尽花风春欲阑。\n好景纵多公不饮，谁论曲糵向江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵谢桃巷 其二","author":"林希逸","text":"老境浑无闷可排，交情莫逆有舆来。\n骨寒底为哦诗瘦，心懒非因忍事灰。\n蔬水生涯聊尔耳，轮云世故奈何哉。\n漆园未悟身如幻，更把君臣论百骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵谢桃巷 其三","author":"林希逸","text":"山深林密乐吾真，从古吟人例是贫。\n参句似禅诗有眼，还丹无诀酒全身。\n我闻竹后痴犹甚，公见桃来思许新。\n有雁莫嫌时问讯，旧游诸老更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒题","author":"林希逸","text":"老守寒溪作逸民，未尝忧道况忧贫。\n生涯宁薄吾无愧，分外求多天亦嗔。\n一点要须明不昧，万缘总是假非真。\n有书数卷诗千首，便是人间了底人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四和澜字三首谢赵工部 其一","author":"林希逸","text":"汩汩难回既倒澜，我今忘世漫游观。\n雀罗生怕客惊散，鱼笱长呼儿去看。\n笋蕨弥山求易足，园林到处入无阑。\n渔翁樵叟相过熟，一语何曾非意干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四和澜字三首谢赵工部 其二","author":"林希逸","text":"已分金门不可排，何须竹帛诏方来。\n囊收玉子开云种，炉养金公候火灰。\n老见明时真乐只，身缘吾党合归哉。\n年丰处处炊烟好，追忆边城叹析骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四和澜字三首谢赵工部 其三","author":"林希逸","text":"芋栗先生语最真，有园我亦未全贫。\n閒寻往事浑如梦，?作清吟老此身。\n但愧淹才随锦尽，何如韩思与花新。\n柞山集即杼山是，佛地中来有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山前山丹已见微红","author":"林希逸","text":"一种村居富贵穷，多年饶润谢天公。\n眼前黄白方吹尽，已放山丹蓓蕾红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和效颦一首寄后村","author":"林希逸","text":"读易伊谁见得真，能见富定不如贫。\n涪翁但冀天还眼，子厚何求愁化身。\n语燕殷勤如话旧，良苗次第又怀新。\n往来独恨诗差少，便觉江山憔悴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵答徐古为","author":"林希逸","text":"金问天南使，过门欲尽春。\n理谈经独妙，诗当札尤真。\n图进知天喜，纶颁人日新。\n相思梁月在，吟望向江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼刘主簿","author":"林希逸","text":"忽传哀讣泪难禁，忆在樗庵别至今。\n遗迹几何留子墨，知音多是惜人琴。\n汝身汝伯相为命，一死一生尤痛心。\n幸是栖鸾本无意，遽令题墓向空林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪峰藏叟过门见访赠别一首","author":"林希逸","text":"山头老汉老尤癯，忽谩溪干访老夫。\n问讯辊毬思古宿，等闲隐几说今吾。\n多留旧日题诗在，近有寒泉答话无。\n握手依依还别去，十年一见只斯须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"看风穴语偶然有感","author":"林希逸","text":"一点关心道即非，到关心处又谁知。\n渠宗为此犹垂涕，益信傍人不是痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得虾酱怀所翁作","author":"林希逸","text":"送酒无如鲊酱宜，所翁旧以宝名之。\n看渠忽洒思翁泪，为忆相呼得宝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平远窗中作","author":"林希逸","text":"祠宇小窗西，松高柳尚低。\n垂垂青可爱，一带绕长堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜立池边作","author":"林希逸","text":"烦促耽凉夜，穹虚望碧霄。\n云行迎月入，波动带星摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄檗老子住西禅","author":"林希逸","text":"贤哉断际堂中老，法席新移向凤山。\n妙选碧油翁具眼，相迎黄面佛开颜。\n老来得友如师少，别去伊谁伴我閒。\n十二峰头明月在，不妨言句落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后溪桥看水","author":"林希逸","text":"绿遍东西岸，田家亦喜晴。\n溪因急雨涨，云放半山明。\n沙外看流势，桥边听浅声。\n向令平十里，应与剡争名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读契嵩非韩三十首","author":"林希逸","text":"此缁何事与韩仇，可怪真如撼树蜉。\n唤作辨才知汝误，看成寐语使人羞。\n赐云日月无容毁，甫叹江河不废流。\n者也之乎三十首，千年贻笑几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送岭口仓季高兄用后村韵 其一","author":"林希逸","text":"士能优即学，岂必为贫驱。\n翁有三珠树，兄如千里驹。\n敏知才脱颖，慈是德充符。\n盐户彫残甚，殷勤为掖扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送岭口仓季高兄用后村韵 其二","author":"林希逸","text":"灶户年年减，苛征可奈何。\n给符催起火，输赋仰晴波。\n民困官谁察，兄贤政必和。\n虽云纲有本，久例剋除多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中看山丹作","author":"林希逸","text":"簇簇团团似剪霞，雨中相对为咨嗟。\n固知沾足遍宜稻，只恐淋漓解损花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和送岭口仓季高兄二首 其一","author":"林希逸","text":"此客熬波去，初程宿暑驱。\n名家真凤穴，内厩待龙驹。\n台自催征课，官惟守信符。\n少留翁必召，温国要康扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和送岭口仓季高兄二首 其二","author":"林希逸","text":"尽职随高下，吾无问孰何。\n留看烹玉雪，入对丽金波。\n任大盐中举，官卑柳下和。\n当涂须刮目，父执故人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得浩书自维扬至京将归矣","author":"林希逸","text":"汝渡长江后，南来北客稀。\n梦寻骑鹤处，愁对钓鱼矶。\n淮仆行方半，京书报欲归。\n抵家应一喜，稚女解牵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]