[{"title":"次韵孙长文泊姑苏馆","author":"范成大","text":"读书窗下一灯残，忽有诗来为暖寒。\n闻道扁舟春共载，雪云虽冷不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱严州从李徽州乞牡丹三首 其三","author":"范成大","text":"阆风苑里司花女，肯作山腰水尾来。\n十二玉栏天一笑，只今归路五云开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱严州从李徽州乞牡丹三首 其二","author":"范成大","text":"歙浦烟山蟠万叠，钓台云日拥千章。\n两侯好事洗寒劣，宝槛移春入燕香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱严州从李徽州乞牡丹三首 其一","author":"范成大","text":"佳人绝世堕空谷，破恨解颜春亦来。\n莫对溪山话京洛，碧云西北涨黄埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李子永梅村散策图","author":"范成大","text":"光风先放越溪春，萧散寻诗索笑人。\n藜杖前头春浩荡，三生应是主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汪仲嘉尚书喜雨 其二","author":"范成大","text":"老身穷若不须忧，未有毫分慰此州。\n但得田间无叹息，何须地上见钱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汪仲嘉尚书喜雨 其一","author":"范成大","text":"雨云浑似雪云同，天意人心本自通。\n吏役驱驱骑马滑，何如欹枕闭门中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陆务观编修新津遇雨不得登修觉山径过眉州三绝 其二","author":"范成大","text":"离合纷纷怕远游，远游仍怕赋登楼。\n何须一望三千里，望尽西州转更愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陆务观慈姥岩酌别二绝 其一","author":"范成大","text":"送我弥旬未忍回，可怜萧索把离杯。\n不辞更宿中岩下，投老馀年岂再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陆务观慈姥岩酌别二绝 其二","author":"范成大","text":"明朝真是送人行，从此关山隔故情。\n道义不磨双鲤在，蜀江流水贯吴城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周子充正字馆中绯碧两桃花","author":"范成大","text":"碧城香雾赤城霞，深出刘郎未见花。\n凭仗天风扶绛节，为招萼绿过羊家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朋元卖花处见梅","author":"范成大","text":"烟浓日淡不多寒，担上看花雪作团。\n想得竹边春已暗，明朝走马过溪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宣州西园二首 其一","author":"范成大","text":"苔茵无地著红尘，花草含芳一笑新。\n不待东君能剪刻，相公笔力挽回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宣州西园二首 其二","author":"范成大","text":"星芒垂耀笔床寒，河汉波流砚滴乾。\n棐几松跗入三昧，一篇诗就一杯残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵养民碧虚坐上","author":"范成大","text":"已将山色染眉黛，更挽江波添酒罍。\n珍重江山劝人醉，笑人驱马惺惺回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐廷献机宜送自酿石室酒三首 其三","author":"范成大","text":"一语为君评石室，三杯便可博凉州。\n百年兀兀同渠住，何处能生半点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐廷献机宜送自酿石室酒三首 其二","author":"范成大","text":"清绝仍香如橘露，甘馀小苦似松肪。\n官槽重浊那知此，付与街头白面郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐提举游石湖三绝 其三","author":"范成大","text":"天上麒麟翰墨林，当家手笔擅文心。\n欲知万顷陂中意，但向三篇句里寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐提举游石湖三绝 其二","author":"范成大","text":"日脚烘晴已破烟，山头云气尚披绵。\n却须多谢朝来雨，洗净明湖镜里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐提举游石湖三绝 其一","author":"范成大","text":"三径荒芜岫幌开，锦车何事肯徘徊。\n春风想为高人住，落絮残花好在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵耿时举苦热","author":"范成大","text":"赤日才低又火云，巷南街北断知闻。\n荷风拂簟昭苏我，竹月筛窗慰藉君。\n避暑无奇那避谤，能觞便了莫能文。\n浮湛放荡从今始，悔把长裾强沐薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵致远自毗陵见寄二首 其一","author":"范成大","text":"黄鹄高飞碧落寒，向来山水梦惊残。\n故情若问玄真子，依旧江头把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵致远自毗陵见寄二首 其二","author":"范成大","text":"新词一阕话羁愁，清似寒泉咽陇头。\n官下有谁同此景，仲宣应是独登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩许浦按教水军二绝句 其二","author":"范成大","text":"戈船战棹疾如飞，莫遣潮沙淀海湄。\n草奏直须穷利病，奉身从此系安危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩许浦按教水军二绝句 其一","author":"范成大","text":"横波组练试扬舲，风捲鱼龙海欲凝。\n但得绨袍如挟纩，何妨铁甲冷如冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩常熟道中三绝句 其一","author":"范成大","text":"小雨萧寒破晚晴，疏疏密密滴檐声。\n乌鸦盘舞黄云乱，早与商量雪意生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩常熟道中三绝句 其三","author":"范成大","text":"使君横槊赋诗回，断取天风海雨来。\n綵笔从今閒不得，雪花梅蕊一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩常熟道中三绝句 其二","author":"范成大","text":"仄径难胜四牡騑，扁舟辛苦凿冰归。\n简书鞅掌吟诗苦，并与东阳减带回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭季勇机宜雪观席上留别","author":"范成大","text":"胜绝尊前万事休，纵非吾土且登楼。\n山迎雨脚俄飞过，风约江声欲倒流。\n野水渐堪添酒面，夕阳依旧满帘钩。\n凭阑从此迟归鞅，能及中秋对月不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龚养正中秋无月三首 其三","author":"范成大","text":"丙夜清光些子见，儿童惊喜强雄夸。\n阑珊高兴应无几，恰似春残看落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龚养正中秋无月三首 其二","author":"范成大","text":"去年怪雨无端甚，今岁痴云亦复然。\n减却新诗酸却酒，乘除添得一更眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龚养正中秋无月三首 其一","author":"范成大","text":"词客幕天清露下，老翁卧病破窗中。\n高吟大醉输公等，不见嫦娥与我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龚养正送水仙花","author":"范成大","text":"色界香尘付八还，正观不起况邪观。\n花前犹有诗情在，还作凌波步月看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾仲躬侍郎同登伏龟楼二绝 其二","author":"范成大","text":"古来游客谩西东，领会谁如我与公。\n露坐绳床天不尽，绝胜帘雨栋云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾仲躬侍郎同登伏龟楼二绝 其一","author":"范成大","text":"带束江淮翠岫围，掌窥台殿碧鳞差。\n刘郎句里登临眼，压倒三江二水诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵温伯苦蚊","author":"范成大","text":"白鸟营营夜苦饥，不堪薰燎出窗扉。\n小虫与我同忧患，口腹驱来敢倦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"范成大","text":"天色无情淡，江声不断流。\n古人愁不尽，留与后人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯夕怀广蜀旧事","author":"范成大","text":"漓水桥西列炬香，少城楼下变灯忙。\n儿嬉万里客程远，老懒一龛春梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灰洞","author":"范成大","text":"塞北风沙涨帽檐，路经灰洞十分添。\n据鞍莫问尘多少，马耳冥濛不见尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百丈山","author":"范成大","text":"沐雨梳风有底忙，解鞍来宿赞公房。\n传闻三岭连天峻，未到王千已断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老陈道人自云梦被召作地上主者又常受一贵家供祝之曰他日必来吾家作儿戏赠小颂","author":"范成大","text":"野人何苦赴官差，符使追呼挠道怀。\n幸有于门香积供，不如随喜去罗斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耳鸣","author":"范成大","text":"风号高木水翻洪，历历音闻不是聋。\n一任大千都震吼，便从卷叶證圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自天平岭过高景庵","author":"范成大","text":"卓笔峰前树作团，天平岭上石成关。\n绿阴匝地无人过，落日秋蝉满四山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自宁国溪行至宣城舟人云凡百八十滩","author":"范成大","text":"波惊石险夜喧雷，晓泊旗亭笑眼开。\n休问行人缘底瘦，适从百八十滩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自育王过天童松林三十里","author":"范成大","text":"竹舆窈窕入萧森，逗雨梳风冷客襟。\n翠锦屠苏三十里，不知脚底白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自横塘桥过黄山","author":"范成大","text":"阵阵轻寒细马骄，竹林茅店小帘招。\n东风已绿南溪水，更染溪南万柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至昌为具赏东轩千叶梅然梅尚未开","author":"范成大","text":"玉叶重英意已芽，新移竹外小横斜。\n东斋何事春工晚，铁树已花梅未花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芒种后积雨骤冷三绝 其三","author":"范成大","text":"梅霖倾泻九河翻，百渎交流海面宽。\n良苦吴农田下湿，年年披絮插秧寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芒种后积雨骤冷三绝 其二","author":"范成大","text":"梅黄时节怯衣单，五月江吴麦秀寒。\n香篆吐云生暖热，从教窗外雨漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芒种后积雨骤冷三绝 其一","author":"范成大","text":"一庵湿蛰似龟藏，深夏暄寒未可常。\n昨日蒙絺今挟纩，莫嗔门外有炎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西瓜园","author":"范成大","text":"碧蔓凌霜卧软沙，年来处处食西瓜。\n形模濩落淡如水，未可蒲萄苜蓿誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讲武城","author":"范成大","text":"阿瞒虓武盖刘孙，千古还将鬼蜮论。\n纵有周遭遗堞在，不如鱼复阵图尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过江津县睡熟不暇梢船","author":"范成大","text":"西风扶橹似乘槎，水阔滩沉浪不花。\n梦里竹间喧急雪，觉来船底滚鸣沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过虎溪对东林苍岩翠樾下浸大涧宛似灵隐冷泉嘱长老法才作亭名曰过溪且为率山丁薙草定基一朝而毕","author":"范成大","text":"过溪无限翠屏开，大笑从教虎子猜。\n不独山中添故事，仍教题作小飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过燕渡望大峨有白气如层楼拔起丛云中","author":"范成大","text":"围野千山暑气昏，大峨烟霭亦缤纷。\n玉峰忽起三千丈，应是兜罗世界云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邢台驿","author":"范成大","text":"太行东麓照邢州，万叠烟螺紫翠浮。\n谁解登临管风物，枯荷老柳替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严关","author":"范成大","text":"回看瘴岭已无忧，尚有严关限北州。\n裹饭长歌关外去，车如飞电马如流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严州","author":"范成大","text":"城府黄尘扑马鞍，一篙重探水云寒。\n耳边眼底无公事，睡过严州二百滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何同年书院","author":"范成大","text":"竹色侵晚帙，泉声漱嵌根。\n试通丹灶路，应到老人村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀杭","author":"范成大","text":"春晚山花各静芳，从教红紫送韶光。\n忍冬清馥蔷薇酽，薰满千村万落香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀杭初出陆","author":"范成大","text":"村媪群观笑老翁，宦途何处苦龙钟。\n霜毛瘦骨犹千骑，少见行人似个侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭放水","author":"范成大","text":"古苔危磴著枯藜，脚底翻涛汹欲飞。\n九陌倦游那有此，从教惊雪溅尘衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初入湖南醴陵界","author":"范成大","text":"崖树阴阴夹暝途，出山欢喜见平芜。\n一春客梦饱风雨，行尽江南闻鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初三日出东郊碑楼院","author":"范成大","text":"远柳新晴暝紫烟，小江吹冻舞清涟。\n红尘一鬨人归后，跕跕饥鸢蹙纸钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初见山花","author":"范成大","text":"三日晴泥尚没靴，几将风雨过年华。\n湘东二月春才到，恰有山樱一树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋二首 其二","author":"范成大","text":"壮岁故多病，老年知不堪。\n何须看公案，只此是真参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋二首 其一","author":"范成大","text":"急雨过窗纸，新凉生簟藤。\n蹒跚老铃下，来炷壁间灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂三首 其三","author":"范成大","text":"一株萧索倚宣华，东苑香风属内家。\n丹碧屠苏银烛照，平生奇绝象山花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂三首 其二","author":"范成大","text":"越城芳径手亲栽，红浅黄深次第开。\n不用小山招隐赋，身如强健日千回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏二首 其二","author":"范成大","text":"晴丝千尺挽韶光，百舌无声燕子忙。\n永日屋头槐影暗，微风扇里麦花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏二首 其一","author":"范成大","text":"清晨出郭更登台，不见馀春只么回。\n桑叶露枝蚕向老，菜花成荚蝶犹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏三绝呈游子明王仲显 其二","author":"范成大","text":"一帘芳树绿葱葱，胡蝶飞来觅绮丛。\n雪白荼蘼红宝相，尚携春色见薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏三绝呈游子明王仲显 其一","author":"范成大","text":"东君不解惜芳菲，料峭寒中一梦非。\n剪尽牡丹梅子绽，何须风雨送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏三绝呈游子明王仲显 其三","author":"范成大","text":"送春迎夏未闻雷，日日斜风细雨来。\n不是故人能裹饭，柴门虽设为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"范成大","text":"醉袖笼鞭转柳塘，青门芳树掩残香。\n谁惊翡翠双飞去，只有莲花对断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴灯两品最高","author":"范成大","text":"镂冰影里百千光，剪綵毬中一万窗。\n不是齐人誇管晏，吴中风物竟难双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]