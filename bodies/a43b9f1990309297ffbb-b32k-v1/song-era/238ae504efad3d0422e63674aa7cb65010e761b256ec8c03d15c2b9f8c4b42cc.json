[{"title":"十叠 其六","author":"刘克庄","text":"起来无赖晚风狂，便恐飘零损岁芳。\n飞燕不持身欲去，绿珠虽坠魄犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其四","author":"刘克庄","text":"有花多处便凭栏，插在金瓶不必看。\n百斛量珠真富贵，两枝剪綵太寒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其五","author":"刘克庄","text":"赋繁台雪云将暮，歌后庭花月未残。\n客至苑皆琼作树，宾来并用玉为栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其八","author":"刘克庄","text":"天子封松作某官，相君复报竹平安。\n梅花一点无沾惹，三友中间独岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其一","author":"刘克庄","text":"才得几朝浑拆遍，只消一霎又吹空。\n何曾学舞能回雪，便不为台与避风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其三","author":"刘克庄","text":"花离京洛缁尘少，诗到齐梁绮语多。\n老子七言虽淡泊，不曾一字犯阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其九","author":"刘克庄","text":"霜皓千林冻欲僵，经旬不爨只餐香。\n何曾转授休粮诀，却是单传屑玉方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十叠 其十","author":"刘克庄","text":"珠树无多攀不已，珊瑚有尽采无穷。\n海神上诉天公怒，似怕龙宫宝藏空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又一首","author":"刘克庄","text":"吾蒙白裙帽，汝著紫袈裟。\n纵有傅大士，难和作一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又七言三首 其三","author":"刘克庄","text":"枝上绛英吹欲尽，镜中素发摘来稀。\n今年过了菖蒲节，犹就香篝著裌衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又七言三首 其二","author":"刘克庄","text":"田翁有酒邀村饮，地主存羊饷节仪。\n不喜人题木居士，何曾鬼怕艾天师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又七言三首 其一","author":"刘克庄","text":"蛾眉已被生前妒，鱼腹犹遭死后诬。\n把似与龙争角黍，何如随俗饮菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又三首 其三","author":"刘克庄","text":"年高难结草鞋缘，道远贫无犊负辕。\n惟有加餐两个字，忉忉衍作百千言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又三首 其一","author":"刘克庄","text":"图二疏归无画工，留君严去欠文公。\n卸了尚书呼长者，纳还学士做渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又三首 其二","author":"刘克庄","text":"雪平腰各立师边，半夜输君得密传。\n伴后村翁成二老，比绛县人多一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又绝句二首 其二","author":"刘克庄","text":"物贵皆由楮币轻，近闻五岭亦通行。\n旧时白苇黄茅里，有犬鸡声布有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又绝句二首 其一","author":"刘克庄","text":"东阁郎君己贰卿，斡回严冷作和平。\n专人昔暴于家靼，太傅今贤似父兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其三","author":"刘克庄","text":"向来平勃颇相知，使粤归来岁月移。\n只以一篙为导从，亦无剑马可相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其九","author":"刘克庄","text":"稚子呼牛妇馌耕，早秧水足麦风清。\n老农喜极还垂涕，白首安知再太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其七","author":"刘克庄","text":"虽沉璧马计安施，倏忽桑田变渺瀰。\n说与神通君看取，潮头不到艮山祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其十","author":"刘克庄","text":"本朝耆旧数吾宗，老监轩昂洛社中。\n后五百年人定说，过江复有戴花翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其六","author":"刘克庄","text":"眉洲屿隔雪涛中，闻此山川髣髴同。\n但是至人游息地，邦人处处作离宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其一","author":"刘克庄","text":"少游款段何从借，伯厚鸡栖未易求。\n看取后村翁简径，百钱聊税一渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其八","author":"刘克庄","text":"溪北溪南一雨通，山村佳处便掀篷。\n老身不怕无安处，著在渔翁保社中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其二","author":"刘克庄","text":"退之岁晚南溪上，把钓联诗得几回。\n便与乌衣群从约，及身强健更频来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其五","author":"刘克庄","text":"弟兄玉映更珠联，岂减玄晖与惠连。\n却笑汉人无具眼，羡它李郭作神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十一日泛舟十绝 其四","author":"刘克庄","text":"桥低水涨过船难，旋拆船篷复旋安。\n未免屈蟠篷底坐，谁教君爱切云冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其三","author":"刘克庄","text":"自古根深枝叶蕃，百年乔木到今存。\n只留谏草传家世，莫著轺车辱户门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其六","author":"刘克庄","text":"石室千年不复开，庭花无语委苍苔。\n席间旧客惟枚叟，白发重将屐齿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其七","author":"刘克庄","text":"空留藓石仆斜阳，不见奇章与赞皇。\n何必雍门弹一曲，蝉声极意说凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其二","author":"刘克庄","text":"伯兄乃汉司徒掾，季子亦唐行秘书。\n只愿荆花常烂熳，莫令瓜蔓稍稀疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其十","author":"刘克庄","text":"后有良工识苦心，今无善听孰知音。\n老来字字趋平易，免被儿童议刻深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其一","author":"刘克庄","text":"才入中年会面难，安知白首此团栾。\n不妨时驾柴车出，只作初骑竹马看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其九","author":"刘克庄","text":"早退分明胜一筹，年行六十复何求。\n东门瓜与南山豆，谁道君恩薄故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其五","author":"刘克庄","text":"呼来不许望清光，麾去奚堪作省郎。\n莫是后身刘快活，插花重入少年场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其四","author":"刘克庄","text":"西舍鸣笳索赋诗，东家拽石请书碑。\n眼中除却壶山外，多是新知少旧知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十五日饮方校书园十绝 其八","author":"刘克庄","text":"百年如电复如风，昨日孩提今日翁。\n乍可生前称醉汉，也胜死后谥愚公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日被命祈晴上天竺舟中得六绝句 其三","author":"刘克庄","text":"无尽谈空学，纵横胆似天。\n如何兜率说，不肯许他禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日被命祈晴上天竺舟中得六绝句 其二","author":"刘克庄","text":"浪说无文字，楞伽面壁看。\n元来有怀挟，一世被粗瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日被命祈晴上天竺舟中得六绝句 其六","author":"刘克庄","text":"勤本小家数，韩欧大秀才。\n二公需作料，勾入集中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日被命祈晴上天竺舟中得六绝句 其四","author":"刘克庄","text":"寥昔十年字，新今百八篇。\n男儿自传世，何必托彼传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日被命祈晴上天竺舟中得六绝句 其一","author":"刘克庄","text":"手写八诗寄，耳聋三日惊。\n何须论句法，年自让吾兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二日被命祈晴上天竺舟中得六绝句 其五","author":"刘克庄","text":"僧句多枯槁，舟公锦绣堆。\n如何涉吾地，咄咄逼人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三笑图","author":"刘克庄","text":"坚白相非是，高虚目送雄。\n远公差解事，孔老各牢笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其五","author":"刘克庄","text":"半卸红绡出洞房，依稀侍辇幸温汤。\n三郎方爱霓裳舞，珍重梅姬且素妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其四","author":"刘克庄","text":"瓦瓶侧畔设蒲龛，纵有推敲紧闭庵。\n何庾诸人俱谢去，只饶和靖作同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其十","author":"刘克庄","text":"早知粉黛非真色，晚觉雕镌损自然。\n天巧千林均一气，人痴一叶费三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其三","author":"刘克庄","text":"群玉峰头玉帝家，桥边池上玉横斜。\n白头老监今留落，曾领群仙共赏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其七","author":"刘克庄","text":"曲径无尘聊席地，小亭有月即凭栏。\n此翁虽老犹高致，不但能评黑牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其一","author":"刘克庄","text":"唐时才子总能诗，张祜轻狂李益痴。\n管甚三姨偷玉笛，诳他小玉写乌丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其八","author":"刘克庄","text":"脂粉形容总未然，高标端可配先贤。\n不陪严子羊裘后，即傍王郎麈尾边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其六","author":"刘克庄","text":"春意萌于肃杀中，玄冥信有斡回功。\n东皇太一无情甚，吹去才消几阵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其九","author":"刘克庄","text":"濡墨先愁染素衣，和铅亦恐浼冰肌。\n后村老子无声画，压倒花光与补之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三叠 其二","author":"刘克庄","text":"银烛千枝插树头，烛光花气半空浮。\n人间富贵真珠室，天上通明白玉楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下蜀驿","author":"刘克庄","text":"幄殿荒凉屋欠扶，绍兴遗老故应无。\n旧来曾识高皇帝，尚有庭前柳一株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨五首 其五","author":"刘克庄","text":"久断过从客，尤妨刈穫夫。\n羲和应烂醉，晨起失金乌。","collection":"宋","notice":"","provenance":{"re