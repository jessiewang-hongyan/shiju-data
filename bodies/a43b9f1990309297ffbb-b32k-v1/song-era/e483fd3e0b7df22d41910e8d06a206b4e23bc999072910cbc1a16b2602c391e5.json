etry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续梦中所见两句","author":"林亦之","text":"长剑歌明月，吴门一夜过。\n红楼何处是，为说马阑坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲍待用挽词四首 其四","author":"林亦之","text":"读尽东床一卷书，不妨踪迹向来疏。\n剑津红帐为门户，想得多多送葬车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲍待用挽词四首 其三","author":"林亦之","text":"寒村夜雨断人烟，却有累累哭野田。\n一饭谁能吊衰草，似君此事至今传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲍待用挽词四首 其二","author":"林亦之","text":"去年一笑荔枝园，今岁重来是墓门。\n纵有青青旧时树，已看斜日照黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲍待用挽词四首 其一","author":"林亦之","text":"一经教子已青裾，况又行年七十馀。\n恰好遭逢身却死，北风门外只长嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横路林少皋挽词","author":"林亦之","text":"十年骑马画桥归，长记朱楼傍水湄。\n今日悲吟想君屋，一如骑马十年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题长乐县灵峰寺望日亭","author":"林亦之","text":"云母江边有草亭，分明见得日头生。\n一村篱落更何处，此已无天只水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题严子陵钓台","author":"林亦之","text":"莫向金门傲冕旒，归来却要著羊裘。\n乾坤不是刘文叔，那得长竿钓白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月游龙卧山留一夕明日值雨坐超上人房偶题","author":"林亦之","text":"野兴更周遭，应迟问大刀。\n山房逢雨好，人意与秋高。\n多谢烹鲜乳，还令厌浊醪。\n重来须累少，款款听萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月登龙卧山","author":"林亦之","text":"复此云山饮，吁嗟空自劳。\n三回看杞菊，两度叹蓬蒿。\n昨者唯伤李，如今更忆曹。\n海阳真俊逸，一等野坟高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹井陈子白母挽词二首 其二","author":"林亦之","text":"嫁娶比邻近，门庭古木幽。\n藁砧旧相好，兰玉久从游。\n双鹤来何处，孤鸾不到头。\n通家丘嫂行，愁涕白云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹井陈子白母挽词二首 其一","author":"林亦之","text":"哀曲梧桐夜，何年苜蓿盘。\n敬夫前辈重，好客妇人难。\n十月明朝尽，孤坟落日寒。\n鹿门催作黍，此意竟长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆浮家洞","author":"林亦之","text":"万竹苍苍乌鸟啼，一江渺渺薜萝西。\n幽怀动处兰初长，好句来时月已低。\n年岁却从为客尽，家书长是倩人题。\n疏钟日落孤村立，秋燕梁空归思迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方士登母挽词","author":"林亦之","text":"伤心来讣日，各各为沾衣。\n慈母夜长诀，郎君客未归。\n短山长笛惨，青草素旗飞。\n料得楚人些，连篇说断机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上陈给事二首 其二","author":"林亦之","text":"云锦轩楹兰玉阶，暂从仙仗下蓬莱。\n良辰歌馆声声起，明月妆楼夜夜开。\n天上李藩批敕手，蜀中严武总戎才。\n可教问舍悠然去，即下红泥促召回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上陈给事二首 其一","author":"林亦之","text":"谢安旧宅翠云环，复见新墙月样弯。\n市近岂容三岛客，楼居须向九仙山。\n去天尚郁金门步，计日催归玉笋班。\n好与衣冠添盛事，一门三府照人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古龙孺人曹氏挽词","author":"林亦之","text":"寒原何处哭，下马欲销魂。\n白日数行泪，黄柑十里村。\n传家犹墨绶，聘妇尽朱门。\n似此何多恨，空沤不要论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵和林守","author":"林亦之","text":"清咏重重画戟边，芳题短短竹篱前。\n政如美稷西河日，诗到黄初正始年。\n滕国已歌慈父爱，韩门更感使君贤。\n铜鱼好句关风教，巴岭赓酬只浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同安抚赵子直饯朱晦庵于怀安二首得重字 其一","author":"林亦之","text":"祖帐寒梅白未空，已看新叶绿重重。\n八州斧钺送行客，十里旌旗绕暮峰。\n北斗独高韩吏部，南州争慕郭林宗。\n一时宾主俱豪杰，敢道招要到野农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同安抚赵子直饯朱晦庵于怀安二首得重字 其二","author":"林亦之","text":"虎夷长想蕙兰踪，螺渚幸修桑梓恭。\n诗造本情天下诵，学传正统世儒宗。\n三山过客日无数，四海闻人此一逢。\n官烛行行送归路，半村无月海云重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚山楼书怀","author":"林亦之","text":"傩鼓逢逢起，江边岁又除。\n哦诗犹古木，高枕尚僧居。\n脚垢时忘洗，头蓬月懒梳。\n自应尘事少，非我故耽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵奉酬林仲雨","author":"林亦之","text":"年去又来三月强，诗成未了寸心狂。\n已无精力能穿鹄，尚有头颅可牧羊。\n老柏纵教逢岁晚，幽兰本不为人香。\n东胶待补犹堪战，莫道今无识绕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵奉酬致仕通直吴七丈上元所寄之什","author":"林亦之","text":"空齐自合冷如灰，何物龙钟似不才。\n日日读书无处用，年年作客几时回。\n君为诸老先生行，我在当初最后来。\n可忍残春对耆旧，不携斗酒去相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"林亦之","text":"败絮沧江上，柴门落日中。\n论文谁与共，觅句不须工。\n壮思如秋叶，搔头似老翁。\n崎岖村浦路，敢自说豪雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江西试罢还故里八月二十九日过飞猿岭连日遇雨","author":"林亦之","text":"万里崎岖愁不禁，飞猿更听雨淋淋。\n剩将暑药凉无用，未著秋衣寒已深。\n刻鹄雕虫成底事，牧羊喂鸭负初心。\n还家渐近病渐好，得句自题时自吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江楼陪范长官宴自警一篇戏呈郑主簿","author":"林亦之","text":"几回过海上，此日暂踌躇。\n未尽尊前酒，还奔使者车。\n官人无少暇，贱子敢安居。\n一亩芭蕉圃，如今要自锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"网山二首 其二","author":"林亦之","text":"屋舍高低住，比邻活计同。\n笭箵嫌月白，螃蟹要霜红。\n吠犬随村落，卖鱼成老翁。\n地咸耕种少，海熟抵年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"网山二首 其一","author":"林亦之","text":"风涛生长处，土地属东隅。\n树树悬鱼网，村村吹鹧鸪。\n酒旗孤屿见，书卷一山无。\n欲趁鸡豚社，深惭身业儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别莆阳史君林宗丞二首 其二","author":"林亦之","text":"扶羸十日候行期，瓜叶初生荷满池。\n别袖难禁须进酒，离情未足更题诗。\n飞鸾渡口还家后，老鼠梯前到阙时。\n士论民谣如缴日，甘泉直上岂容迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别莆阳史君林宗丞二首 其一","author":"林亦之","text":"下笔翩翩如史君，年过五十始朱轮。\n蜀山久托无家客，滕国曾为负耒人。\n脱印忽闻过我里，攀辕尤更甚州民。\n乍晴乍雨黄梅道，好听泥封下紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县学东轩","author":"林亦之","text":"莫道东轩恶，朝来意欲迷。\n平田飞白鸟，高木叫黄鹂。\n林阙孤峰出，檐低远树齐。\n虽然有佳趣，那似海门西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨严州母挽词","author":"林亦之","text":"生长大夫宅，来归御史门。\n吾儿天下宝，此母里人尊。\n九岭三江外，孤云片月村。\n同乡无见日，他国赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛卯岁应举过西峡渡","author":"林亦之","text":"白鹿山头云欲颓，峡门滩下水如雷。\n锦囊破裂元无用，席帽嵚崎还更来。\n我自未能逃世俗，人谁便解脱尘埃。\n扁舟且趁牛羊渡，莫问如今第几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎仙致政王修职挽词","author":"林亦之","text":"晦德香泉下，秋风知几回。\n襟怀如阮达，门阀自唐来。\n立马曾交语，寒蛩重一哀。\n生前双锦轴，亦足慰苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈文焕秀才所宅近市凭楼一望西山宛然堕几案中县之豪隽唱酬不下数十百篇野人后来承听许不必次韵故为之赋一首","author":"林亦之","text":"西山檐外见，何必鹿门行。\n近晚市声合，疏帘野意生。\n终朝如此好，初月更多情。\n却愧才华钝，三年句不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]