[{"title":"寄宇文成州","author":"陆游","text":"成州太守比何如，梦里依然把臂初。\n复起卿当用卿法，长闲吾实爱吾庐。\n五湖风雨孤舟夜，万里关山一纸书。\n正使两翁长隔阔，子孙他日莫相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄成汉卿将军","author":"陆游","text":"燕颔将军万里游，溪山好处即迟留。\n颇闻南岳度残夏，宁忆北平防盛秋。\n君巳飞腾丹换骨，我方衰病雪蒙头。\n禅龛也有新勋业，百万魔军一战收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄朱元晦提举","author":"陆游","text":"市聚萧条极，村墟冻馁稠。\n劝分无积粟，告籴未通流。\n民望甚饥渴，公行胡滞留。\n徵科得宽否，尚及麦禾秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄别李德远二首 其二","author":"陆游","text":"李侯不恨世卖友，陆子那须钱买山。\n出牧君当千里去，归耕我判一生闲。\n中原乱后儒风替，党禁兴来士气孱。\n复古主盟须老手，勉追庆历数公间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄别李德远二首 其一","author":"陆游","text":"萧萧风雨临川驿，邂逅连床若有期。\n自起挑灯贪夜话，疾呼索饭疗朝饥。\n即今明月共千里，已占深林巢一枝。\n惜别自嫌儿女态，梦骑羸马度芳陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张季长","author":"陆游","text":"发不胜簪短褐宽，每因临镜叹衰残。\n未尝三日不服药，虽满百年终阖棺。\n旧友岂知常阻阔，一尊那得叙悲欢。\n锦官花重应如昔，直欲凌风借羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张真父舍人二首 其二","author":"陆游","text":"天上紫微省，莺花绕直庐。\n逢时身鼎贵，忧国鬓先疏。\n憔悴元当弃，牵联也得书。\n犹能下榻否，拟卜瀼西居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄张真父舍人二首 其一","author":"陆游","text":"诸公方衮衮，无地著斯人。\n万里夔州守，中朝禁省臣。\n孤帆秋上峡，五马晓班春。\n想见怀明主，登临白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杨济伯","author":"陆游","text":"闻道皇华使，来从万里回。\n五溪春荠老，三峡暮猿哀。\n昔日文昌省，频年滟滪堆。\n问君何地险，斟酌寄声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈鲁山二首 其一","author":"陆游","text":"诸公贵人识面稀，胸中璀璨漫珠玑。\n即今举手遮西日，应有流尘化素衣。\n旧学极知难少贬，吾侪持此欲安归。\n夜来风雨空堂静，忽忆灯前语入微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈鲁山二首 其二","author":"陆游","text":"天下无虞国论深，书生端合老山林。\n平生力学所得处，政要如今不动心。\n旧友几年犹短褐，谪官万里少来音。\n愿公思此宽羁旅，静胜炎曦岂易侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄奉新高令","author":"陆游","text":"小雨催寒著客袍，草行露宿敢辞劳。\n岁饥民食糟糠窄，吏惰官仓鼠雀豪。\n只要闾阎宽箠楚，不须亭障肃弓刀。\n九重屡下丁宁诏，此责吾曹未易逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄径山印禅师","author":"陆游","text":"市朝声利战方酣，眼看纷纷每不堪。\n但有客誇车九九，了无人问众三三。\n会当身返东西蜀，要与公分上下庵。\n春枕悠然梦何许，两枝筇杖唤鱼潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄姜梅山雷字诗","author":"陆游","text":"章台官柳映宫槐，宝马蹄轻不动埃。\n只怪好诗无与敌，谁知古学有从来。\n江山常逐客帆远，岁月不禁衙鼓催。\n剩约东林投净社，高情千载有宗雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陶茂安监丞","author":"陆游","text":"永州太守鬓毛残，矍铄犹能起据鞍。\n徵士虽思赋松菊，隐居未可挂衣冠。\n功名梦境元非实，歌舞山城且自宽。\n也胜钟陵穷别驾，闭门无客遣忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄龚立道","author":"陆游","text":"龚子吴中第一流，老农何幸接英游。\n难逢正似玉杵臼，易散便成风马牛。\n清夜话端思滚滚，暮年心事恐悠悠。\n何由唤得阊门棹，一醉千岩万壑秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄龚实之正言","author":"陆游","text":"台省诸公岁岁新，平生敬慕独斯人。\n山林不恨音尘远，梦寐时容笑语亲。\n学道皮肤虽脱落，忧时肝胆尚轮囷。\n至和嘉祐须公了，乞向升平作幸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄答绵州杨齐伯左司","author":"陆游","text":"磊落人为磊落州，滕王阁望越王楼。\n欲凭梦去直虚语，赖有诗来宽旅愁。\n我老一官书纸尾，君行千骑试遨头。\n遥知小寄平生快，春酒如川炙万牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄溧阳周丞文璞周寄诗卷殊可喜","author":"陆游","text":"满握珠玑何自来，晴窗初喜拆书开。\n信哉天下有奇作，久矣名家多异才。\n隔阔经年如许进，超腾它日若为陪。\n山阴道上霜天好，安得相从赋早梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题太和陈诚之秀才远明楼","author":"陆游","text":"宦游再有江西役，南望庐陵每慨然。\n未见高楼出云雨，但惊妙语杂风烟。\n诸公何止元和盛，独我初非正始贤。\n笔力深知太辽绝，此诗它日勿同编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题季长饰庵","author":"陆游","text":"近诏还中秘，新文记饰庵。\n主盟君勿让，贾勇我何堪。\n木落山容瘦，云齐雪意酣。\n何由共杯酒，把蟹擘黄甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题胡基仲故居","author":"陆游","text":"忆昔公来一束书，萧然不复畜僮奴。\n浮云每叹成苍狗，空谷谁能絷白驹。\n才气沙尘埋巨阙，文章林壑吼于菟。\n旅坟三尺云门寺，又见离离长绿芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题赵宽之主簿慈顺堂","author":"陆游","text":"人间得意尽危机，独有荣亲事未非。\n魏阙恩光新绿绶，高堂娱侍旧斑衣。\n牙签插架书无恙，兰膳循陔养莫违。\n况有两公天下士，为君百斛泻珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题栝苍陈伯予主簿平楚亭","author":"陆游","text":"琵琶洲上暮山奇，五十馀年役梦思。\n与子定交虽可乐，念身垂老亦成悲。\n远游倦似风枝鹊，愁思多于茧盎丝。\n安得往寻平楚约，一樽相属醉题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题儒荣堂","author":"陆游","text":"军容基祸庙谋疏，尚记文登遣使初。\n只道大功随指顾，至今遗种费诛锄。\n还朝不遣参麟笔，寓直空闻上石渠。\n剩办杀青君记取，龙庭焚尽始成书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赠湖中隐者","author":"陆游","text":"高标绝世不容亲，识面无由况卜邻。\n万顷烟波鸥境界，九秋风露鹤精神。\n子推绵上终身隐，叔度颜回一辈人。\n无地得申床下拜，夜闻吹笛度烟津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巢山二首 其一","author":"陆游","text":"巢山避世纷，身隐万重云。\n半谷传樵响，中林过鹿群。\n虫锼叶成篆，风蹙水生纹。\n不蹋溪桥路，仙凡自此分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巢山二首 其二","author":"陆游","text":"短发巢山客，人知姓字谁。\n穿林双不借，取水一军持。\n渴鹿群窥涧，惊猿独袅枝。\n何曾畜笔砚，景物自成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中夜兴","author":"陆游","text":"示疾维摩无侍者，夜阑自掩草庵门。\n有情梅影半窗月，相应鸡声十里村。\n纸帐拥裘寻断梦，地炉拨火暖残樽。\n扶衰又践新春境，万事元知不足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中独居感怀三首 其二","author":"陆游","text":"自闭庵门不点灯，惰耕村叟罢参僧。\n一生已是胶黏日，投老安能夏造冰。\n顽面敢辞乾汝唾，蔬餐聊得曲吾肱。\n高舂睡熟无多笑，那有禅师解放鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中独居感怀三首 其三","author":"陆游","text":"无钱溪女亦留鱼，有雨东家每借驴。\n藜粥数匙晨压药，松肪一碗夜观书。\n黄紬被暖闲无厌，白布衫长乐有馀。\n南陌东阡春事动，放翁作计未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中独居感怀三首 其一","author":"陆游","text":"身愈龙钟发愈稀，流年冉冉迫残晖。\n读书十纸勤虽在，上树千回事已非。\n仗马曾鸣宜取斥，牧羝虽乳亦忘归。\n馀生自笑知何似，万里辽天老令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中晚思","author":"陆游","text":"小庵摩腹独彷徉，俗事纷纷有底忙。\n云影忽生鸦蔽日，雨声不断叶飞霜。\n经纶正复惭伊傅，杂驳犹能陋汉唐。\n卷尽残书窗已晚，笑呼童子换炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中晨起书触目四首 其三","author":"陆游","text":"赋形不使面团团，耸膊心知到骨寒。\n晏子元非枕鼓士，杜生那有切云冠。\n时扶迁客桄榔杖，日厌诗人苜蓿盘。\n赖是平生憎阿堵，今年初解侍祠官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中晨起书触目四首 其二","author":"陆游","text":"晖晖初日上帘钩，漠漠清寒透衲裘。\n雪棘并栖双鹊瞑，金环斜绊一猿愁。\n廉宣卧壑松楠老，王子穿林水石幽。\n戏事自怜除未尽，此生行欲散风沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庵中晨起书触目四首 其一","author":"陆游","text":"山重水复怯朝寒，一卷窗间袖手看。\n朱檐长瓶列云液，绛囊细字拆龙团。\n数峰移自侏儒国，一研来从黯淡滩。\n要识放翁顽钝处，胸中七泽著犹宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得子聿到家山后书","author":"陆游","text":"日日春阴愁出户，汝今恰遇十分晴。\n桑林紫葚累累熟，稻垄青秧漫漫平。\n梦好定知行路健，书来深慰倚门情。\n柯桥道上山如画，早晚归舟听橹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得子虡临安舟中书因寄","author":"陆游","text":"江水悠悠双鲤鱼，眼明初拆入关书。\n残年已觉身如客，一念还成泪溅裾。\n春近预忧归梦短，潮回莫遣寄声疏。\n何时可弃微官缚，五亩荒畦共荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得成都诸友书劝少留嘉阳戏作","author":"陆游","text":"一坐五十日，痴顽良可哀。\n新凉为醉地，少讼作慵媒。\n市柳风烟惨，汀蘋岁月催。\n远官从漫浪，垂老懒低回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得张季长书以大蓬见称盖以予寄禄官视昔秘书监也因作五字寄之","author":"陆游","text":"老病江湖上，烦公问死生。\n仙蓬虽误到，残锦只虚名。\n点滴三更雨，凄凉万里情。\n向来遗恨极，不遂隐青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得京书或怪久不通问","author":"陆游","text":"惯向江湖铩羽翰，云霄那敢接鹓鸾。\n百年未必如炊久，万事真须作梦看。\n白首据鞍惭侠气，青灯顾影叹儒酸。\n手遮西日成何味，还我平生旧钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得建业倅郑觉民书言虏乱自淮以北民苦徵调皆望王师之至","author":"陆游","text":"邦命中兴汉，天心大讨曹。\n风云助开泰，河渭荡腥臊。\n日避挥戈勇，山齐积甲高。\n煌煌祖宗业，只在驭群豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得所亲广州书","author":"陆游","text":"音信连年恨不闻，书来细读却消魂。\n人稀野店山魈语，路僻蛮村荔子繁。\n毒草自摇春寂寂，瘴云不动昼昏昏。\n此生相见应无日，且置清愁近一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得林正父察院书问信甚勤以长句寄谢","author":"陆游","text":"折柳湖南别尚新，书来已见柳摇春。\n故情有此胶投漆，薄俗从渠越视秦。\n长剑拄颐那复梦，短衣掩胫未全贫。\n有诗亦欲频持寄，肠断西江六六鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得雨沾足遂有丰年意欣然口占","author":"陆游","text":"人事销沉渺莽中，此身元合付天公。\n儒生可逐惟求忘，社酒常辞不怕聋。\n郁郁稻苗欣出穗，汪汪陂水告成功。\n老民莫道浑无用，能为明时祝岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得亲旧书问近况以诗代书报之","author":"陆游","text":"溪头日日弄潺湲，敢料馀生竟得全。\n白简免劳中执法，青铜罢算小行年。\n花前一笑频开口，林下深藏永息肩。\n欲养金丹还懒去，身今已是地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得故人书偶题","author":"陆游","text":"小筑稽山下，狂歌剡曲傍。\n乡邻共鸡黍，童稚学农桑。\n白首馀年促，青编后日长。\n此心谁复许，三叹付书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得赵昌甫寄予及子遹诗","author":"陆游","text":"去国双蓬鬓，还山一鹿车。\n壮惭稽古浅，老悔养生疏。\n俗态慵开眼，高吟独起予。\n青灯对余子，并为问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得赵若川书因寄","author":"陆游","text":"泽居路绝人不到，晨起忽传双鲤鱼。\n储泪一升悲世事，减愁三尺看君书。\n龙墀对策言伤直，山邑迎亲计未疏。\n老病闭门谁省录，因风时肯问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得都下八月书报蒙恩牧叙州","author":"陆游","text":"凤城书到锦江边，故里归期愈渺然。\n掌上山川初入梦，壶中日月尚经年。\n方轮落落难推毂，倦马骎骎怕著鞭。\n未佩鱼符无吏责，看花且作拾遗颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得蜀信","author":"陆游","text":"齿发凋零志气衰，强临尊酒祇成悲。\n少年半是投闲日，春事常当卧病时。\n忧患颇疑书作祟，功名不似老如期。\n青城旧友频相约，归养金丹尚未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徙倚","author":"陆游","text":"渔扉夕不掩，徙倚欲三更。\n月正树无影，露浓荷有声。\n峥嵘岁将晚，悄怆恨难平。\n坐念中原没，男儿恐浪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排闷","author":"陆游","text":"悠然不觉岁时迁，楚水枫林系钓船。\n贫悴只如行卷日，衰迟忽过挂冠年。\n闲游野寺骑驴去，倦拥残书听雨眠。\n赖有一筹差自慰，小儿笔墨日翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排闷","author":"陆游","text":"抱耒返东皋，初非惮作劳。\n饥寒凛未免，老病适相遭。\n开卷无如懒，飞觥岂复豪。\n不辞穷到死，犹足窃名高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排闷","author":"陆游","text":"残雪融成雨，寒灯结作花。\n睡稀听齧鼠，坐久送栖鸦。\n食似开僧钵，居如寓店家。\n馀年不须问，即此是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排闷","author":"陆游","text":"老去知心少，流尘锁断弦。\n尊空问字酒，囊罄作碑钱。\n扫叶供朝爨，和泥补漏船。\n胸中元浩浩，白眼望青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排闷","author":"陆游","text":"白发无端日日新，自怜犹作百忧身。\n孤灯听雨常终夜，一榼寻花又送春。\n旋压麦糕邀父老，时分菜把饷比邻。\n不须频起陈人叹，已是清朝六世民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排闷","author":"陆游","text":"吹尽梅花了不知，化工也误老人期。\n离离新草随愁出，漠漠馀寒与睡宜。\n古锦一联吟旧句，文楸数著理残棋。\n波生澄涧君何怪，禅榻从来映鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探梅","author":"陆游","text":"岁月相寻岂有穷，早梅唤醒醉眠翁。\n坐中酒量人人别，花底春风处处同。\n白帝城边微雪过，青衣江上夕阳红。\n锦囊空复残诗在，分付悲欢一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探梅至东村","author":"陆游","text":"乞得残骸已累年，柴车破弊不堪悬。\n闲愁正要供诗思，小疾何妨省酒钱。\n忍事渐多心混混，贮书虽少腹便便。\n今朝偶有寻梅兴，春色争来拄杖前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩门四首 其二","author":"陆游","text":"簌簌落高槐，阴阴长绿苔。\n只言门昼掩，不道客谁来。\n足痹思寻壑，愁生久拨醅。\n吾儿能问事，梨栗且炮煨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩门四首 其三","author":"陆游","text":"举手可及屋，积书高拄颐。\n忽闻疏雨滴，恍记故山时。\n点染聊成字，呻吟仅似诗。\n不关才思尽，碌碌本亡奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩门四首 其四","author":"陆游","text":"寡求忘市远，易足任囊空。\n院吏催呈史，家僮笑忍穷。\n鬓毛惊尽白，仓粟饫陈红。\n赖有三峨梦，时时到枕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩门四首 其一","author":"陆游","text":"身瘦不胜笏，官闲常掩门。\n汉廷虽好老，楚泽未招魂。\n砚润蟾疏滴，香残鸭尚温。\n个中殊会意，恨欠阿戎言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"掩户","author":"陆游","text":"蔗浆那解破馀酲，一读南华眼自明。\n香缕映窗凝不散，墨丸入砚细无声。\n太山蚁垤初何有，佛国魔宫本亦平。\n此段光明谁障得，旷怀还与老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]