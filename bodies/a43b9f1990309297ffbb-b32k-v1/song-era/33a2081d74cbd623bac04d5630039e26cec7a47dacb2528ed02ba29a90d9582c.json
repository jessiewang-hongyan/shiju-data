[{"title":"赵左丞画像","author":"杨杰","text":"洪学祠堂写六贤，左丞功业最居先。\n仪形已在凌烟阁，岂独丹青一郡传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏徵君赞","author":"杨杰","text":"天子诏不起，少微星转明。\n寥寥千载后，富贵在清名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵宾客生日","author":"杨杰","text":"人间爵禄颂公难，自有家传一品官。\n己亥年生逢己亥，从今甲子别开端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老子度关图送张会稽为寿","author":"杨杰","text":"秘藏函谷关中子，持赠蓬莱阁上仙。\n愿得髭须如此老，却教龟鹤羡长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无为子六年官太常江上耆老思得一见门人求京师名笔传写以归因题之云","author":"杨杰","text":"江南江北白云堆，试共幽人一展开。\n向道无为老居士，拟归先遣化身来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"申国吕公挽词","author":"杨杰","text":"讣闻孰不泪盈巾，宝鉴云亡社稷臣。\n帝猎渭滨先得吕，神还崧岳旧生申。\n默调一气归元鼎，坐致群伦入大钧。\n孤贱无能报知遇，文章曾许继前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"资政少保章简公挽词","author":"杨杰","text":"中道立不倚，大哉王者言。\n文章曾润色，功业在调元。\n衮绣光闾里，图书遗子孙。\n悲风起吴国，千载凤凰原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得安肃颜舅书再成哀词","author":"杨杰","text":"安肃书来倍痛伤，痛伤穷苦盛时亡。\n三千蝉蜕人何处，十载龙山梦一场。\n我愧动心非孟子，谁能鼓缶学蒙庄。\n夜台难寄登科信，泪滴春衫吊夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章俞待制挽诗三首 其一","author":"杨杰","text":"材与时相会，声华孰可攀。\n东堂升秘籍，内阁叙清班。\n馀庆千年远，浮生一梦还。\n故乡闻讣日，云黯四明山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章俞待制挽诗三首 其二","author":"杨杰","text":"熙宁治百川，献议辟民田。\n平昔不毛地，于今大有年。\n至忠期报国，上策在安边。\n士论追贤业，临风一泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章俞待制挽诗三首 其三","author":"杨杰","text":"节制当方面，恩威号令明。\n黠羌知效顺，叛俗乞归耕。\n一夕流星陨，中年逝水倾。\n祠堂严岁享，耆旧致精诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山五笑 远师","author":"杨杰","text":"我笑东林寺，孤高远法师。\n种莲招社客，平地凿成池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山五笑 陶渊明","author":"杨杰","text":"我笑陶彭泽，闻钟暗皱眉。\n篮舆急回去，已是出山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山五笑 陆先生","author":"杨杰","text":"我笑陆简寂，修真脱世埃。\n九霄一飞去，重入旧山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山五笑 开先招老","author":"杨杰","text":"我笑开先老，家风双剑高。\n云间本无事，拭目看金毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山五笑 无为子","author":"杨杰","text":"我笑无为子，游山学古人。\n康庐不能住，骑马入红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞皇公祠","author":"杨杰","text":"梦到瀛洲夜，觉来江上秋。\n一身投绝域，千古吊穷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏徵君草堂","author":"杨杰","text":"召伯甘棠国，东郊处士家。\n百年三世隐，泉石当生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登南楼 其一","author":"杨杰","text":"此楼此景他州无，山川形势吞三吴。\n唯凭诗老写奇胜，纵有画笔难工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登南楼 其二","author":"杨杰","text":"此楼此景他州无，天高水阔连平芜。\n绿杨深处杏花发，日暖数声山鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登南楼 其三","author":"杨杰","text":"此楼此景他州无，栏干倚遍还踌躇。\n主人有酒且共醉，骊歌不用催行车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀黄梅三阁 钓阁","author":"杨杰","text":"屏去竿头饵，非唯用直钩。\n我来鱼不避，鱼信我无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀黄梅三阁 吟阁","author":"杨杰","text":"二十年前令，曾来阁上吟。\n如今头已白，诗有壮时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀黄梅三阁 醉阁","author":"杨杰","text":"江边醉长官，昔慕陶彭泽。\n未赋归去来，于今有惭色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈令壁","author":"杨杰","text":"地胜江山国，风清令尹家。\n酒阑寒食夜，月上海棠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清轩","author":"杨杰","text":"清轩直下压秦淮，淮是秦皇厌胜开。\n千古兴亡无问处，好风惟共月明来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水月轩","author":"杨杰","text":"湛碧一泓泉，中涵千古月。\n不比天上轮，三五有盈缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐贤亭偶成","author":"杨杰","text":"湖外青山在，湖边人不归。\n古今无问处，幽鸟下渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遥碧亭","author":"杨杰","text":"幽鸟无心去又还，迢迢湖水出东关。\n暮云留恋不飞动，添得一重山外山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗野亭","author":"杨杰","text":"八月风高浪渺瀰，仙公醉倚海槎枝。\n夜深曾傍亭边过，亭上主人知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈令归无为","author":"杨杰","text":"楚水漾轻碧，楚花飞乱红。\n故人故乡去，半雨半晴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘彦辅乞侍养","author":"杨杰","text":"变化未随雷焕剑，晨昏愿服老莱衣。\n山堂大饮不敢醉，应恐倚门人望归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别安廷老","author":"杨杰","text":"山色浅深烟霭里，客情去住别离中。\n临川聚会应不久，明日扁舟乘便风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄倅别诸公 其一","author":"杨杰","text":"豫溪春雨江湖平，苍壁洲边春草生。\n吏民出郭自归去，草间流水随君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄倅别诸公 其二","author":"杨杰","text":"垂杨阴里系行舟，隔岸数声黄栗留。\n异日相逢定何处，莫辞春蚁一杯浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其一 吕望","author":"杨杰","text":"举世无人用直钩，直钩到底是良谋。\n孟津再掷磻溪饵，八百诸侯尽爱周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其二 任公子","author":"杨杰","text":"机深谁及任公子，浙水苍梧饱巨鳞。\n鲵鲋不吞钩上犗，一年笑杀海边人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其三 詹何","author":"杨杰","text":"五年南国钓烟波，妙手从来所得多。\n鱼引盈车竿不挠，几人施舍似詹何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其四 鲁人","author":"杨杰","text":"好钓无如鲁国人，暗投香桂饵游鳞。\n谁知浅水鱼贪食，不待金钩翡翠纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其五 庄周","author":"杨杰","text":"谩投香饵试纤鳞，楚使徒来濮水滨。\n莫讶持竿不相顾，顾君还是上钩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其六 琴高","author":"杨杰","text":"不钓浮名不钓鱼，一纶钩线卷还舒。\n九霄控鲤无人识，谁道纤鳞是脍馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其七 陵阳子明","author":"杨杰","text":"旋溪不杀真龙子，学道三年蹑太虚。\n今古报恩人亦有，不知谁有腹中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其八 左慈","author":"杨杰","text":"香饵轻投一席间，鲈鱼泼泼跃铜盘。\n曹公不悟神仙术，徒整金钩把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其九 严光","author":"杨杰","text":"狂奴肯顾安车聘，祗爱东阳七里滩。\n谁道世间人不识，客星光射紫微寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓矶怀古十章 其十 刘遗民","author":"杨杰","text":"雨笠烟蓑细草巾，持竿谁识白莲人。\n当时若得文王猎，泾水还应似渭滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝林院五松","author":"杨杰","text":"葛洪井上两三株，不与孤秦作大夫。\n借问东山岁寒木，得无羞见水西无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太白桃花潭","author":"杨杰","text":"桃花潭似武陵溪，太白仙舟去路迷。\n岸上踏歌人不见，年年空有鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东峰白云院","author":"杨杰","text":"僧爱白云溪上飞，白云飞处敞禅扉。\n莫言便是无心物，忆著故山依旧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采石四咏 其一 温峤","author":"杨杰","text":"半夜燃犀采石江，江神无处避馀光。\n未应赤帻能为害，窥见渊鱼已不祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采石四咏 其二 袁宏","author":"杨杰","text":"袁郎风格抗浮云，咏史高吟世未闻。\n乘月泛江今古有，不知谁是谢将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采石四咏 其三 李白","author":"杨杰","text":"一别蓬宫不计年，锦袍吟醉钓鱼船。\n鉴湖贺老天机浅，轻向人间号谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采石四咏 其四 樊若冰","author":"杨杰","text":"兵到金陵举国降，若冰谋策谓无双。\n由来天意归真主，何必舟梁始渡江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廉溪","author":"杨杰","text":"山为羌仙传旧姓，溪因廉士得新名。\n愿持一勺去南海，直使贪泉千古清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题城西水磨","author":"杨杰","text":"客来亭上脱春衫，马浴寒泉洗辔衔。\n怪得主人留再住，水声林影似江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠范鲁仲","author":"杨杰","text":"人急生前计，子图身后名。\n重来天地远，谁为作权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏梅呈仲元","author":"杨杰","text":"十年不见锦川梅，今日清香入酒杯。\n太守为施红步障，郡园惊怪寿阳来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞香","author":"杨杰","text":"孤根移自紫霄峰，只斗清香不斗红。\n忆得婆娑一株桂，欧家曾见月屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访吴尉不遇","author":"杨杰","text":"人爱红尘我爱山，寻山重叩白云间。\n子真避客游都市，月上梧桐未肯还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐静十八松","author":"杨杰","text":"庐山社友皆逃晋，秦府功臣不仕隋。\n今日明堂求巨栋，好教天下匠师知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧霄泉鱼","author":"杨杰","text":"岩深荫薜萝，金鬣弄寒波。\n莫爱江湖好，江湖罾网多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游白云山醉题僧壁","author":"杨杰","text":"买得青山不用钱，金沙门外草绵绵。\n黄梅老令醉欲倒，拟借白云今夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野寺","author":"杨杰","text":"泽国春风老，杂花间芳草。\n门前车马稀，竹叶无人扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山房枕上作","author":"杨杰","text":"十里溪源寻未见，忽逢茅屋白云堆。\n竹床纸帐睡正稳，无奈野猿惊觉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还庆师扇","author":"杨杰","text":"赠我无心著，还师理亦然。\n秋风归旧谷，明月上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"目前传神欧阳价","author":"杨杰","text":"国手曾烦写几回，无人仿佛醉颜开。\n青铜鉴里寻常见，不谓今从笔下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉","author":"杨杰","text":"白云山下泉，几年石中韫。\n但见玉色明，孰能究其本。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西山仙迹岩","author":"杨杰","text":"功鍊三千满，手持白玉圭。\n出尘举天步，踏石上云梯。\n物外踪长在，人间路自迷。\n只因从此去，曾过越王溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉隆万寿宫","author":"杨杰","text":"竹标溪涧蠲民瘼，剑击蛟龙救水灾。\n四十日升金阙去，半千年后玉函开。\n丹藏井底人难得，柏荫坛心手自栽。\n一段彩云天外至，山翁疑是锦堆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅坛","author":"杨杰","text":"天下人心爱至公，天心还与世人同。\n自生羽翼三清去，不独丹砂九转功。\n汉代变名游越国，道家遗像并萧公。\n石坛正是飞升处，老鹤一声松桧风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双泉","author":"杨杰","text":"南泉甘滑北泉清，竹引潺湲绕殿楹。\n分派铜龙穿石过，两泓寒月隔室明。\n金沙自是藏金穴，玉马长遗喷玉声。\n曾倚栏杆一攲枕，梦回疑不在重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"施肩吾书堂","author":"杨杰","text":"玉京高谢黄金榜，石室来乘白鹿车。\n山后暗通天宝洞，眼前便是地仙家。\n时闻清夜雪中犬，回视红尘井底蛙。\n五百年前人未死，芭蕉源上锁烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵山","author":"杨杰","text":"繁川灵鹫山，山顶驾老屋。\n初从曲径登，叠石盘岩腹。\n景逐轩楹转，云烟炫游目。\n忆昔心上人，欲往怯洄洑。\n前人涨白沙，环流作平陆。\n昨夜暑雨暴，高低或成谷。\n感物鉴江水，江水清可掬。\n莫惊秋霜飞，能换鬓边绿。\n我有紫阳丹，晶明大如粟。\n服之能长生，千载一时毂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横望山","author":"杨杰","text":"陶家旧宅寄山坳，七百年前此结茆。\n太尉双碑遗字晦，先生五井暗泉交。\n野僧拂石为床坐，童子穿冰作磬敲。\n岩下清音谁解听，古声长在老松梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金地院","author":"杨杰","text":"大历年中茅结宇，禅翁瓶锡久曾留。\n飞泉堂下雨长滴，偃石道傍云不收。\n野鸟归来群木晚，老猿啼罢一山秋。\n世人多事头多白，底事情闲亦白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙都山","author":"杨杰","text":"有路入仙都，何人到鼎湖。\n秋风夜来急，吹落碧莲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴兴明月楼","author":"杨杰","text":"江南地暖少严风，九月炎凉正得中。\n溪上玉楼楼上月，清光合作水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静隐寺","author":"杨杰","text":"五岭碧崔嵬，云深隔世埃。\n寺从梁氏建，僧自梵天来。\n锡井三泉迸，松门十里开。\n如今渡江者，见说不浮杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏南山诸胜 风篁岭","author":"杨杰","text":"微风摇琅玕，萧瑟岭一道。\n万帚扫晴空，纤尘不可到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]