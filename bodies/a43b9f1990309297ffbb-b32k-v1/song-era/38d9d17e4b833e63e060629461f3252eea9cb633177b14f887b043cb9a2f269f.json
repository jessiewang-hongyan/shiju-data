[{"title":"次韵陈教授见寄二首 其一","author":"俞德邻","text":"藜床听雨卧，雨霁抱琴行。\n古径荒苔合，秋渠坠叶平。\n流年悲雁影，往事咽蛩声。\n谁识玄都观，刘郎旧有名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈教授见寄二首 其二","author":"俞德邻","text":"江城吾旧隐，今岁喜秋穰。\n一顷南山豆，千畦负郭姜。\n看云扃户晚，对月引杯长。\n他日凭鱼雁，犹堪话楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送程道大归新安兼简宪使卢处道学士四首 其一","author":"俞德邻","text":"倦客思归整旆鞍，班荆祖道驻江干。\n浮云流水别离易，明月清风会晤难。\n携妓东山须载酒，上书北阙莫求官。\n诸公衮衮君休羡，得马还将失马看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送程道大归新安兼简宪使卢处道学士四首 其二","author":"俞德邻","text":"十年故国黍离离，一日翩然赋式微。\n儒服政怜山鸟怪，机心何独海鸥飞。\n山中朝露閒观槿，岭曲春风自采薇。\n苍狗白衣从变化，是今非昔昔谁非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送程道大归新安兼简宪使卢处道学士四首 其三","author":"俞德邻","text":"我生惭愧贾胡留，暮鼓晨钟复报秋。\n万里桥南存旧宅，十年客舍尚并州。\n青山是处堪埋骨，白发新来渐满头。\n此日送君何限意，长江万折有东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送程道大归新安兼简宪使卢处道学士四首 其四","author":"俞德邻","text":"戋戋束帛贲丘阿，有几英雄入网罗。\n少室山人徵不起，贞元朝士已无多。\n声光赫奕埋轮使，音调凄清扣角歌。\n倾盖相驩应恨晚，乔松千尺有丝萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程道益见赠二首 其一","author":"俞德邻","text":"此生惭愧马牛襟，返锁柴门岁月深。\n避地管宁甘白帽，登台郭隗自黄金。\n风霜渐老骚人鬓，天地元知国士心。\n却喜程侯晚相遇，长鱼碧酒共清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程道益见赠二首 其二","author":"俞德邻","text":"十载时艰泪染襟，馀生几拟托幽深。\n匹夫无罪空怀璧，校尉有官从摸金。\n老去风尘犹眯眼，春来药裹更关心。\n草玄作赋吾何敢，梁父吟成祇自吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中三首 其一","author":"俞德邻","text":"病来十日闭茅庐，孤负吟诗与著书。\n床下不知牛是蚁，濠间谁识子非鱼。\n羸形分绝麒麟画，老境堪同鹿豕居。\n坎止流行随所寓，分明天地一籧篨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中三首 其二","author":"俞德邻","text":"腐儒粗粝愧无功，一月兼旬卧病中。\n赋就但应增肺渴，檄成元不愈头风。\n移心有法难忘药，折臂无缘定作公。\n世事渐艰吾已老，翛然梦不到槐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中三首 其三","author":"俞德邻","text":"婢寻本草犬迎医，二竖驱除去复随。\n衰老维摩常示病，瘦生杜甫不关诗。\n门堪罗雀那容驷，釜不烹鱼但作糜。\n见说九重徵武士，却须攘臂学支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故舶使知泉州赵公挽词五首 其一","author":"俞德邻","text":"闽粤驱驰后，乾坤震荡中。\n名虽高斗北，身竟老辽东。\n仕止因时异，悲欢与世同。\n洛滨多侍从，立懦独清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故舶使知泉州赵公挽词五首 其二","author":"俞德邻","text":"慷慨辞双节，逍遥寄一筇。\n扬雄虽若凤，老子自犹龙。\n霁月窗前草，悲风陇上松。\n遗民应巷哭，何但辍秦舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故舶使知泉州赵公挽词五首 其三","author":"俞德邻","text":"壮岁风云会，衰龄岸谷迁。\n芾棠南国里，细柳曲江边。\n天地纷戈甲，园林寂管弦。\n康成共丁卯，肯避巳辰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故舶使知泉州赵公挽词五首 其四","author":"俞德邻","text":"杜陵侔稷契，诸葛陋袁曹。\n道在七分易，文过九辩骚。\n丘原终古闭，嵩岳极天高。\n况复阶庭树，于今有凤毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故舶使知泉州赵公挽词五首 其五","author":"俞德邻","text":"世梗投林密，人稀寄驿迟。\n一朝传易箦，千古竟骑箕。\n斲鼻空悲郢，援琴谩忆期。\n薤歌嗟已晚，生死负恩私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋壑堂","author":"俞德邻","text":"衮绣三朝乐盛时，湖山廊庙两栖迟。\n一声鼙鼓乾坤沸，万里烟尘草木悲。\n隔叶黄鹂空睍睆，定巢紫燕尚差池。\n春风不管人间事，犹绕雕阑飏绿漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀聂道录二首 其一","author":"俞德邻","text":"形影参商已六春，春风吹梦益沾巾。\n江头杨柳送行客，窗外梅花疑故人。\n世事茫茫山岳隔，年光冉冉燕鸿新。\n一尊何日重携手，鹤外乾坤迥不尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀聂道录二首 其二","author":"俞德邻","text":"夜鹤朝猿伴苦吟，碧窗静锁绿云阴。\n青精可饭药资乏，黄独无苗山雪深。\n岂有故人分禄米，但闻隐士寄焦琴。\n相思一夜生春草，明月满街天籁沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病愈出游","author":"俞德邻","text":"桐帽棕鞋破晓烟，落花飞絮暮春天。\n风檐转日噪乾鹊，云树隔溪啼杜鹃。\n客引茅亭沽旧酒，僧邀竹院话枯禅。\n病馀一事还堪笑，脚力轻松倍去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行欲访三茅践许宗师鹤会之约","author":"俞德邻","text":"涧饮岩栖愿已违，小舟拂晓泛涟漪。\n蒲丛露冷泣姑恶，木末云深叫子规。\n山近三茅便杖屐，酒沽五里带糟醨。\n乘风俓拟寻幽躅，莫负当年汗漫期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜卧旅邸梦入三茅山一道士病一道士鼾睡因作诗纪其概云","author":"俞德邻","text":"梦入三茅叩玉扉，楼台金碧净朝晖。\n岩花涧草高低见，田鹤沙禽下上飞。\n道士倚墙方熟睡，至人杜德不言机。\n人间天上元非远，非想非非更觉非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日","author":"俞德邻","text":"人日吟窗涤砚尘，探官擘茧笑乡邻。\n山人雅爱终南径，诗客空怀渭北春。\n誉毁盖棺犹未了，勋名看镜不须频。\n从今好是支离卧，有客问余方负薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭朝奉挽词二首 其一","author":"俞德邻","text":"性俭家常足，心閒体自胖。\n令名缘有子，良贵不须官。\n遗像衣冠古，高堂几席寒。\n他年说耆旧，回首重辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郭朝奉挽词二首 其二","author":"俞德邻","text":"世态十年别，交情奕代论。\n及门先倒屣，引酌定空尊。\n杖屦春风语，松楸夜月魂。\n些成嗟已晚，江阔听啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼俞仁则","author":"俞德邻","text":"藕花汀畔柳丝垂，杯酒殷勤话别离。\n风雨对床空有约，池塘梦草竟无诗。\n荒坟日落谁人吊，古屋苔深独我悲。\n毕竟功名大槐国，排云书在即丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门逢友人","author":"俞德邻","text":"泽国江山冷战云，扁舟春晚忽逢君。\n荒城鼓角含商气，旧曲楼台暗楚氛。\n海燕认巢迷故主，苔蜗篆壁变新文。\n更怜庾信江南赋，音调凄清不忍闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张师道","author":"俞德邻","text":"七闽幕府藉词臣，一笑平反草木春。\n制下九重新涣汗，胸蟠千古旧经纶。\n生平耻不为伊傅，夜半何烦问鬼神。\n无限焦枯待霖雨，好将斯道觉斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送道士孙雪房","author":"俞德邻","text":"雾豹文章野鹤姿，黄冠晦迹浙江涯。\n携家拟就鹿门隐，奏赋何期狗监知。\n触热问涂行有日，排云论事岂无时。\n太平上策须倾倒，更忆崆峒麦熟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送董左丞二首 其一","author":"俞德邻","text":"帝眷东南用正人，角巾归第请何频。\n相公久矣倦台鼎，故国依然倚世臣。\n霖雨合归天上作，忠言须造榻前陈。\n丈夫出处非徒尔，四海安危寄一身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送董左丞二首 其二","author":"俞德邻","text":"煌煌勋业绘凌烟，共说韦平有世贤。\n黄閤紫枢名将相，凉台燠馆半神仙。\n百年富贵真槐国，一日清閒胜葛天。\n祇恐九重方侧席，东山未许遽高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣怀","author":"俞德邻","text":"密树幽花似远村，循除流水自浑浑。\n无僧肯送卢仝米，有客时过陆抗门。\n月晕河天鱼散子，泥融雨径竹生孙。\n十年四海干戈满，似此遗民几户存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为汤提刑赋南园玉绣毬花二首 其一","author":"俞德邻","text":"绣衣持斧旧诗翁，天与奇葩衬绮栊。\n翠㔩叶攒珠的皪，碧搔头映玉珑璁。\n氤氲香雾迷丛蝶，淡沲晴飔飏转蓬。\n安得素娥斟绿醑，缓歌一阕月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为汤提刑赋南园玉绣毬花二首 其二","author":"俞德邻","text":"愁烟泫露泣明妃，万蝶魂迷倦不飞。\n帐簇流苏裀翡翠，阶翻蹴鞠落珠玑。\n琼葩分韵香疑减，柳絮成团似却非。\n风雨朝昏他日约，忍令容易失芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈静佳咏梅","author":"俞德邻","text":"玉骨冰肌不受尘，纷纷红紫谩争春。\n最宜岩壑风霜夜，相对心肠铁石人。\n寂寞上林迷雾苑，嵯峨巫岫隔烟津。\n翛然自得閒中趣，肯与姚黄作素臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古寺","author":"俞德邻","text":"古寺倚峥嵘，春风信马行。\n猿吟千树暗，僧定一灯明。\n野水循除出，庭莎夹径生。\n云何多俗韵，一宿又江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故枢密使陆公挽词三首 其一","author":"俞德邻","text":"杞国天将压，苍梧云正愁。\n龙胡垂可挽，鱼腹葬何忧。\n万死丹心在，千龄王气收。\n县知精卫忿，今古不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故枢密使陆公挽词三首 其二","author":"俞德邻","text":"七朝迷瘴雾，一昔倒狂澜。\n天意竟难料，皇图不再安。\n宁甘蹈东海，不忍絷南冠。\n自古谁无死，从容就义难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故枢密使陆公挽词三首 其三","author":"俞德邻","text":"群雄纷爱死，一士独捐生。\n历数绝谁续，纲常晦复明。\n人皆念王蠋，天岂祸程婴。\n泪眼休枯尽，他年看史评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答郦学正见赠三首 其一","author":"俞德邻","text":"鸡鸣群动已憧憧，习静工夫自笑慵。\n风月一襟霜两鬓，图书万卷酒千钟。\n维摩示病元非病，李广难封不愿封。\n世道隆污随所适，我知老子本犹龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答郦学正见赠三首 其二","author":"俞德邻","text":"萧森竹柏小蒲庵，身世嵇康七不堪。\n眼底故人俱寂寞，镜中衰发自䰐鬖。\n过车慷慨陈清酹，旧馆殷勤脱左骖。\n老我与君同此意，纷纷轻薄不须谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答郦学正见赠三首 其三","author":"俞德邻","text":"粥饭随缘类出家，小瓶汲月自煎茶。\n浮荣等是蕉中鹿，薄俗堪怜井底蛙。\n南亩半栽元亮秫，东陵多种邵平瓜。\n青鞋布袜相随去，九陌红尘任没车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈教授见寄二首 其一","author":"俞德邻","text":"拟效时人耻效尤，时人嫉我亦如雠。\n携金懒市燕台骏，卖剑聊寻渤海牛。\n白发盈簪羞我老，黄花满径为谁秋。\n尊前有酒休辞醉，痴绝由来爱虎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈教授见寄二首 其二","author":"俞德邻","text":"朝暮何人肯拔尤，周民何友亦何雠。\n还家久类苏耽鹤，溷世聊歌宁戚牛。\n笔在不妨书甲子，诗亡谁为作春秋。\n百年修短终归尽，倚杖看山任白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏五园亭对雨漫成六首 其一","author":"俞德邻","text":"野鹤乘轩愧不才，柴门键密昼慵开。\n荒亭锁雾红葵老，古木号风白雨来。\n酒免官沽时一醉，诗非私贷日相催。\n人间万事皆儿戏，千载昆明几劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏五园亭对雨漫成六首 其二","author":"俞德邻","text":"从来工瑟莫吹竽，赤米黄齑尽自娱。\n种柳藏鸦怜哺母，葺巢护燕待将雏。\n荆榛少剪但除道，瓜芋多栽莫问区。\n金马玉堂元有分，青铜惭愧白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏五园亭对雨漫成六首 其三","author":"俞德邻","text":"镜中勋业不须论，拭发何由得马肝。\n日暮论文思李白，年衰忘事类师丹。\n几多归燕愁无主，是处鸣蛙总为官。\n多谢天公相劳苦，梅风吹雨长琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏五园亭对雨漫成六首 其四","author":"俞德邻","text":"五噫休作不平鸣，世事悠悠弈一枰。\n歌有红儿休用比，酒无白堕亦须倾。\n青山倘是埋骨好，素发何嫌照眼明。\n鼎鼎百年三万日，晓烟收尽暮云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏五园亭对雨漫成六首 其五","author":"俞德邻","text":"雨霁云收正午天，槐阴翳翳北窗眠。\n百年未了暂为客，一日得閒真是仙。\n美酒但寻知己饮，好诗休用俗人传。\n山林钟鼎知谁是，输与鸱夷理钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏五园亭对雨漫成六首 其六","author":"俞德邻","text":"有酒能浇磊磈胸，人生何处不从容。\n横飞辽海成孤鹤，老死南阳亦卧龙。\n习静一丘聊自足，逢时万户莫先封。\n梧楸门巷将迎少，涧曲分畦学老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋泊吴门寄友","author":"俞德邻","text":"尊酒旗亭说旧游，重来茂苑又深秋。\n烟霞静锁诗人屋，风雨常欺倦客楼。\n独雁叫群天漠漠，蹇驴畏滑路悠悠。\n相思清夜黄花老，一盏寒灯万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵薛晓翁教授","author":"俞德邻","text":"鲲鹏意气鹤精神，髣髴风流贺季真。\n三顾岂无天下计，百年空老梦中身。\n兵尘满眼谁知己，儒术谋生每误人。\n长啸归来寻旧隐，石田茅屋未全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒境","author":"俞德邻","text":"门外红尘竞往还，小轩容膝自怡颜。\n三杯对影夜邀月，一笏拄颐朝看山。\n芳草落花春不老，鸣鸠乳燕乐相关。\n人间寻遍无閒境，閒境由来祇此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小园漫兴四首 其一","author":"俞德邻","text":"小园雨过草离离，寂寞葵榴又一时。\n载酒客来閒问字，催租人去更吟诗。\n一杯淡粥学僧供，三尺高床避鬼吹。\n百岁光阴行六十，世间何许凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小园漫兴四首 其二","author":"俞德邻","text":"杖藜竹外独徘徊，叹息人间几劫灰。\n燕颔素无难食肉，蟹螯才有便持杯。\n世人枉是皆欲杀，明主何尝肯弃才。\n多谢诸公共推挽，公车时亦到蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小园漫兴四首 其三","author":"俞德邻","text":"公车纵肯诏遗民，宣发萧萧已满巾。\n美景昔时多乐事，丰年今日有饥人。\n翻云覆雨怜轻薄，洗眼开怀任屈伸。\n野鹤瘦躯驯鹿性，此时宁复绘麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小园漫兴四首 其四","author":"俞德邻","text":"华发思乡去苦迟，人民城郭总成非。\n九原可作吾谁与，三径就荒胡不归。\n诗思寂寥无腹稿，病躯憔悴减腰围。\n有时梦与钟期遇，閒拂枯桐按玉徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀萧道夫","author":"俞德邻","text":"北辙南辕一昔分，何时尊酒细论文。\n谈经举世用燕说，横笔何人静楚氛。\n朋辈风流推李杜，弟兄词藻愧机云。\n麟洲有客长回首，归诵琅章饫所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊阎桥有怀","author":"俞德邻","text":"青镜霜刀杳莫寻，陈留巷陌故阴阴。\n鸿飞犹记东西迹，燕去难留下上音。\n多病乐天悲老近，三生杜牧恨春深。\n浮云柳絮元无准，惭愧人间儿女心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏简友人二首 其一","author":"俞德邻","text":"百年何处筑菟裘，又向周南叹滞留。\n砧韵但能凄客枕，雁声浑不到歌楼。\n江湖展转鱼千里，今古驱驰貉一丘。\n回首金焦渺何许，潇潇风雨使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏简友人二首 其二","author":"俞德邻","text":"茅斋蓬鬓静编蒲，谁使担簦问客途。\n万里晴云离塞雁，一天明月绕枝乌。\n羁愁浩渺夜将半，诗思凄凉岁欲徂。\n却羡故人沉醉处，红楼红粉拥红炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次郭元德二首 其一","author":"俞德邻","text":"马周淹逆旅，梦寐忆常何。\n琴古知音少，囊空得句多。\n凄凉怜我老，慷慨为谁歌。\n三尺匣中剑，时时自濯磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次郭元德二首 其二","author":"俞德邻","text":"昔贤多不偶，今我欲如何。\n浮世欢娱少，衰年感慨多。\n吾伊翻蠹简，欸乃听渔歌。\n自笑平生志，低回竟不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郭元德旅怀","author":"俞德邻","text":"挟册知何用，援琴且自宽。\n世途今更险，客枕夜偏寒。\n俯仰随时易，隆污合道难。\n功名大槐梦，青镜莫频看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]