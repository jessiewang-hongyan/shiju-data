[{"title":"送舒用之葬有感","author":"陶梦桂","text":"藕塘三亩宅，松竹荫兰荪。\n有酒曾留客，无香可返魂。\n亲朋惟我老，心事与谁论。\n苦恍如縻绠，随风洒墓门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读传灯录","author":"陶梦桂","text":"公案堆来高似山，人人沉着语言间。\n水中掬月徒辛苦，衣下寻珠只等闲。\n此事不从人世得，诸贤枉道法门艰。\n千山万水参禅者，行到穷时祇自还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王良佐","author":"陶梦桂","text":"高高林木带烟霞，短短茅檐寄水涯。\n尽有清风疏种竹，苦无空地密栽花。\n云停栗里渊明屋，月满剡溪安道家。\n会待子猷清兴发，扁舟一叶著平沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄椿上人","author":"陶梦桂","text":"颜童齿豁老书生，习气消除道气增。\n自止酒来疏酒伴，闲吟诗去寄诗僧。\n不才臃肿庄周木，无尽光明摩诘灯。\n解道本来无一物，未容尽逊岭南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望郡城酬舟中诸丈","author":"陶梦桂","text":"归路宁迂三两程，落霞孤鹜近乡城。\n水连南浦天然碧，秋入西山雨后清。\n鹿梦已醒谙世事，鸥盟犹在见交情。\n近来一事君知否，耳畔全无鼙鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游永福寺二首 其二","author":"陶梦桂","text":"寺占吾乡好处山，半新半旧屋千间。\n水中莲似尼清净，雨后云如僧退闲。\n石路教人修整过，芒鞋怕我往来艰。\n夜深火炬浑无用，长是天教月送还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游永福寺二首 其一","author":"陶梦桂","text":"二十馀年不入山，重来疑是梦魂间。\n薰炉已冷灯犹在，经卷才收磬自闲。\n寂寂禅关人罕到，茫茫人世事多艰。\n朅来细说无生话，稳坐蒲团不忍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩兴","author":"陶梦桂","text":"吟情常得闲情助，和气多为直气侵。\n易说难行天下事，未为先懒老来心。\n公然排闼清风入，悄地窥窗好月寻。\n风月无情肯相管，尘缘终浅道缘深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩兴","author":"陶梦桂","text":"溪山争献状，易得小诗成。\n病骨如松瘦，清愁似草生。\n苦无人比饭，喜有弟分羹。\n下及长须辈，人言似顾荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬君山远上人送别","author":"陶梦桂","text":"恋恋君山未解维，高僧来送赠行诗。\n谁知归去陶元亮，又遇当年远法师。\n莲社欲留听说法，菊篱那忍负归期。\n临岐重约头陀会，记得江干话别时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题竹岩丁直卿镂冰集","author":"陶梦桂","text":"一片好诗如片月，半生愁杀镂冰翁。\n多情误以苦为乐，众体疑于异却同。\n几度手抄方刻枣，数茎发在已如蓬。\n江湖醉墨争驰骋，谁识岩灯夜夜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大儿时中堂成德脩弟喜而赋之因次元韵","author":"陶梦桂","text":"有谭名利者，耳若了不闻。\n心乎平似水，身也懒于云。\n眇眇居人世，骎骎过隙曛。\n田园趣归去，风月谩平分。\n有子万事足，一堂何足论。\n还欣身有托，或谓寿无根。\n静处安吾分，超然忘世纷。\n炉薰祝万寿，持用答吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山矾","author":"陶梦桂","text":"香远花繁叶耐冬，人人道与木犀同。\n一般赛得木犀过，能为人间报岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同子兴赋雪中折带冰梅","author":"陶梦桂","text":"雪里攀梅冷不胜，归来分插几空瓶。\n花间乱缀未凋玉，窗下细看元是冰。\n旋觉暖回还易散，只愁冻损独先零。\n诗翁贪看横斜影，未暝呼童急上灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵坚大师","author":"陶梦桂","text":"明时有分坐空山，终日心游天壤间。\n无欲始安贫里乐，是人只得睡时闲。\n离家便忆居家好，论事那知任事难。\n自快此身天所相，干戈丛里得生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陶明甫","author":"陶梦桂","text":"寸质元非紫磨金，少时徒有济时心。\n中年世味谙常尽，晚节宗门趋向深。\n万境皆空何所着，百年未满得长吟。\n人间俯仰咸尘迹，惟有江山不古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自题","author":"陶梦桂","text":"短衣匹马遍关山，二十年来一梦间。\n万里烟尘催我老，一溪风月伴人闲。\n处心简淡常常足，著意经求事事艰。\n亭午厨人多喜色，邻翁举网得鱼还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次吴城山","author":"陶梦桂","text":"淮蜀荆襄老此生，归与双眼识吴城。\n树依神力连云暗，水到江西彻底清。\n去棹来帆南北客，孤鸿落日古今情。\n枯肠尚可搜诗句，三老放船钲一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余试吏初期六十止今遂初愿喜而赋之","author":"陶梦桂","text":"小儿无力报明时，六十休官早自期。\n今岁才周花甲子，此身已在菊东篱。\n行年如许化未化，天命而今知不知。\n休问圣贤千古事，从今诗酒是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄澄伯下第以诗来访次韵","author":"陶梦桂","text":"平塘水外竹三亩，古木阴中屋数间。\n天幸诸贤皆大用，分甘少病比长闲。\n百年世事皆前定，一枕清风无后艰。\n多谢新诗来慰藉，不堪溢美欲封还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬坚大师","author":"陶梦桂","text":"蜀山越峤倦跻攀，拄杖经年挂壁间。\n驹隙光中惊迅速，龙泉山里占清闲。\n但存宝藏明珠在，不管石头行路难。\n香冷磬残经卷了，倚栏静数暮鸦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题涂季儒愚安堂","author":"陶梦桂","text":"而翁吉德怕人知，天与良孙一似之。\n自分随缘栖矮室，何曾弄巧蹈危机。\n人生怀抱祇平易，天下道涂皆坦夷。\n此语莫书堂上壁，客来徒说是和非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁香","author":"陶弼","text":"万枝千叶递相亲，内结花心外结身。\n草木至微犹有合，悲哉父子与君臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登群山楼","author":"陶弼","text":"节逢重九日，郡占五溪间。\n止水痕依岸，行云影过山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九龙岩","author":"陶弼","text":"岩有真龙卧未醒，此龙于物本无情。\n可能暂起为甘雨，洗我征南十万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山茶花二首 其二","author":"陶弼","text":"江南池馆厌深红，零落空山烟雨中。\n却是北人偏爱惜，数枝和雪上屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山茶花二首 其一","author":"陶弼","text":"浅为玉茗深都胜，大曰山茶小树红。\n名誉漫多朋援少，年年身在雪霜中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广州 其一","author":"陶弼","text":"地穷山亦断，烟水是封圻。\n外国衣装盛，中原气象非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广州 其二","author":"陶弼","text":"石门见月随潮早，洸口闻猿上峡迟。\n新酒满篘蛮妪店，古碑当道海神祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹灶山","author":"陶弼","text":"羽客朝元地，遗坛古寺中。\n炼成丹灶在，骑去鹤巢空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北池","author":"陶弼","text":"句漏城中菡萏池，池边台榭半空基。\n频年太守多新额，异代思贤有旧碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马错城","author":"陶弼","text":"北设长城陷敌尘，更来劳力武陵民。\n我疑洞里栽桃者，便是当时筑版人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白雾驿","author":"陶弼","text":"一曲青溪一曲山，鸟飞鱼跃白云閒。\n溪山岂要行人到，自是行人到此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙壁","author":"陶弼","text":"曾看柳侯山水记，信知龙壁好烟霞。\n谁能写作新屏障，寄与长安富贵家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全州","author":"陶弼","text":"南北东西几万峰，郡城如在画屏中。\n何人截断湘妃竹，半蘸秋江作钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安城即事二首 其二","author":"陶弼","text":"金鼓声阑剑戟收，使君回上雅歌楼。\n樽前一节清商曲，销尽穷边万里愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安城即事二首 其一","author":"陶弼","text":"南峤风云久肃清，坏沟残垒号升平。\n官曹惟识簿书字，民俗不知金鼓声。\n往岁传闻南诏檄，近时方筑伏波城。\n安城太守知边计，菡萏花中阅水兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园居","author":"陶弼","text":"篁韵松涛入耳清，诛茅欣见径初成。\n更添苍柏两三辈，相伴高枝作雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"希静堂","author":"陶弼","text":"二江明月九峰云，云月堂中希静人。\n芙蕖池浅蛙迎雨，钴鉧潭空草送春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李","author":"陶弼","text":"春昼暖风熏翠幄，暑天凉气暗朱阑。\n主人肝胆无猜忌，果下游人但整冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陶辰州","author":"章惇","text":"使介直登双御阁，州符就领五蛮溪。\n争雄白鹊临崖斗，忆子玄猿绕涧啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辰州 其一","author":"陶弼","text":"草市人朝醉，畬田夜火明。\n泷江