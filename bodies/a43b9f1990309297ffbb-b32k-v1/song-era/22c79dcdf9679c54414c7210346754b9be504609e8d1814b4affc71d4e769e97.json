ovenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春道中口占 其二","author":"李新","text":"挑人柳目空依路，唤客莺声又隔林。\n病渴相如今已老，悔将春事入琴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春道中口占 其五","author":"李新","text":"白马蹄轻气亦骄，嘶风嘶日上山椒。\n乃翁不似杨光禄，与汝披霜趁早朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春道中口占 其六","author":"李新","text":"榆荚已吹鹅眼去，柳绵不带茧香来。\n轻霜未度刘郎鬓，更看春桃几度开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春道中口占 其一","author":"李新","text":"幛地翠烟犹惜晓，乳花小雨却翻晴。\n去年春恨依前到，先得东风捲入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦江思","author":"喻汝砺","text":"独咏沧浪古岸边，牵风柳带绿凝烟。\n得鱼且斫金丝鲙，醉折桃花倚钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静邻寺","author":"李新","text":"垂天云影暗溪桥，寺野人稀自寂寥。\n游梦已随飞叶落，乱风吹雨竹萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨竹","author":"李新","text":"叶叶飞秋声自来，萧郎国有不羁才。\n西山昨夜虎风恶，大折一枝无处栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题东高院壁","author":"李新","text":"主簿骑驴云外去，山僧吹笛梦中来。\n行人不用重回首，自有东风播凤台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题冯园三首 其三","author":"李新","text":"浑道无情易别离，袖痕看取泪燕脂。\n阳关三叠何须唱，正是征鞍欲去时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题冯园三首 其二","author":"李新","text":"已将归骑逐东风，家在岷峨第几峰。\n应是故山猿鹤啸，主人归得已龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题冯园三首 其一","author":"李新","text":"林园暖日注蔫红，啼鸟重来树亦空。\n莫道主人无意在，解将篱落护春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北岩定林院方丈戊戌正月二十四日携诸童稚来游藉草而饮既醉书方丈小垣以去 其二","author":"李新","text":"东风桃李年年在，化国光阴日日长。\n试数开元到今夕，几经繁盛几凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题北岩定林院方丈戊戌正月二十四日携诸童稚来游藉草而饮既醉书方丈小垣以去 其一","author":"李新","text":"松岭晴烟明冉冉，石桥融水暖涓涓。\n老翁百事无心计，秪有寻春似去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题兴化小阁 其一","author":"李新","text":"田界纹楸看绿玉，池分龟兆渴清泉。\n水曹载酒非无意，小雨留人信有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题纯益壁记","author":"李新","text":"斜雨逆风昏旧字，是中能有几人知。\n未言温室栽何木，先向忠州教竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题贵閒轩","author":"李新","text":"尘埋鬼笑有无间，多少真痴不贵閒。\n白日舒长问谁老，几将春梦到三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题望喜驿黄夷仲诗后","author":"李新","text":"杜宇啼愁连谷暗，嘉陵流恨接天长。\n路人要见行人喜，看取眉间一点黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题韩溪","author":"李新","text":"云梦擒王终猎狗，芒砀龙子讵蟠泥。\n前知妇女磨英气，亦率萧公早过溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赖盘市法云院二首 其二","author":"李新","text":"石壁冷磨閒日月，松棂平觉远山川。\n便将小纽双龟印，试换禅床一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赖盘市法云院二首 其一","author":"李新","text":"乱石崖边花蹙锦，斗鸡峰下麦翻云。\n青螺着地山浑翠，丹饼乘天日半曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九支池二首 其二","author":"李新","text":"际天州县出要荒，始觉承平日月长。\n一望宛无戎甲马，四围皆是汉封疆。\n清笳沓沓翻新曲，寒月低低下乳墙。\n说与远人知德意，九重深处是成康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九支池二首 其一","author":"李新","text":"万里车书自一家，新城蜿蜿卧龙蛇。\n路民已别东西日，楼鼓初闻早晚衙。\n洗出云岩销虎穴，扫开烟瘴离椒花。\n受廛不惜躬耕去，欲与滕公度岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日无菊","author":"李新","text":"芳物及时难，良辰旷野欢。\n古园荒草莽，秋雨秃阑干。\n香桂风流减，红萸气味单。\n书绅惩淡饮，活取宿根寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日林守同饮因思昔年朱侍讲跨鹤之集","author":"李新","text":"常记秋登跨鹤台，儒先杖履共追陪。\n如公已到蓬莱上，过我又分符竹来。\n往事已成千古话，遗风空负十分杯。\n依依正尔重阳日，襟抱何时得好开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日罗江旅情呈文孺","author":"李新","text":"山程十驿策驽来，中路几成兴尽回。\n旅次白醪饶客醉，故园黄菊为谁开。\n漏长更箭迟翻鼓，生久灯花细落煤。\n不是学无经济术，道书教我壮心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日过蓬溪书净戒寺","author":"李新","text":"瓦冷云埋殿，灯长黑暗沙。\n药灵閒草木，蔓走古龙蛇。\n石佛随山老，松梯转路赊。\n门前溪水浅，无处问仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又出差还茂州","author":"李新","text":"深入不毛何所负，不妨老子解痴顽。\n九峰自积十年雪，八国犹遗六诏蛮。\n楸带绿垂蚯蚓直，苔衣翠滴鹧鸪斑。\n山前人事如麻麦，却忆孤城日日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张幕","author":"李新","text":"草色恩袍九品中，文章高步屈英雄。\n红莲绿水开新幕，绛帐青衿走下风。\n沛雨苍龙功已奋，翔云丹凤路潜通。\n尘迷试问刘安诀，就学仙源点化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下鹿头坂偶成","author":"李新","text":"朝来喜下鹿头关，谁谓追奔匹马还。\n意气已无豪愤态，梦魂犹在崄崎间。\n白云亲老愁归计，明月知音笑病颜。\n天子已筹西夏策，将军未易许安閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大佛寺留题","author":"李新","text":"绿筱寒松小翠微，鱼声寂寂鼓声稀。\n山头远见龟屏出，海峤谁迁石笋归。\n欲得鬼神添岭桧，却愁风雨断天衣。\n醵钱欲作翚飞观，一钵无妨厌蕨薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中秋意","author":"李新","text":"拟握陂龙陟凤台，厌闻远雁一声哀。\n霜乾殷叶背林去，雨足黄云归谷来。\n蕙幛可能留鹤宿，草堂终待觅桤栽。\n有心培养山中桂，不束轮囷作散材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山间女","author":"李新","text":"倚竹情何极，伤春事已阑。\n长眉弯月薄，翠袖怯天寒。\n倩妇拢新鬓，凭人易旧冠。\n轻闻骑马客，相趁隔篱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"李新","text":"不寐成孤坐，悠悠百感生。\n灯明将续昼，鼓急欲移更。\n药熟知僮倦，杯残任鼠争。\n羁怀忘未得，时作下阶行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中江道中","author":"李新","text":"茅结萧萧宅，松周浅浅山。\n斧桑云堕绿，堤水月留弯。\n杨蕊风团去，虫丝燕掠还。\n行经双只堠，曾未彻重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋夜宿穆陵关","author":"李新","text":"羁旅情怀不自禁，清霜岐路马骎骎。\n一年明月最圆夜，千里故人常别心。\n幸有酒沽除是醉，更无人赏又如阴。\n寒蛩似识风骚意，伴我凄凄到晓吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书梁山杨氏亭壁","author":"李新","text":"骑马黄尘本不知，作新轩榭发幽奇。\n缬云山色屏千曲，绣地花光春四时。\n涤器讵须能赋客，力书自有起家儿。\n心肝呕出无空处，一宿相酬不废诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从辟泸南道中晓征三首 其三","author":"李新","text":"貂裘紫帽日程程，不得修途一纸平。\n作雪晓天梅萼重，压尘小雨马蹄轻。\n随身诗酒三勍敌，入眼山川几画屏。\n到日未须投我辖，为烧兰水濯繁缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从辟泸南道中晓征三首 其二","author":"李新","text":"矍铄从戎恃骨彊，旧衣褒博讵堪装。\n岁云暮矣家安在，月出皎兮山更长。\n锥子秃毛穷有分，碑颜没字老何妨。\n凭君为护痴儿女，白首相期乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从辟泸南道中晓征三首 其一","author":"李新","text":"人情世事今如此，与作丛林眼目看。\n髀肉未能销犊鼻，溪篁先与斸渔竿。\n山衔落月金盘缺，马踏清霜玉佩寒。\n一十九年閒睡足，欲将春梦入长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分蒲萄遗苏必强","author":"李新","text":"吏归珍客赐，手自举铜盘。\n珠酿旧琼液，烟匀秋露漙。\n初分马乳碧，聊别水晶寒。\n教彻梨园曲，停歌一处餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天池读书寄元明","author":"李新","text":"絺葛皮冠萧隐居，溪山随我亦名愚。\n调和得所弟乳酪，丽泽不均兄瓠壶。\n晓雨莫偿双泪落，夜灯常照一心孤。\n阿松活计今多少，试问山前几木奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巴山","author":"李新","text":"飞云冉冉隔层峦，涨水茫茫失旧湾。\n自昔秋风悲宋玉，这回夜雨宿巴山。\n独行云峤双飞舄，谁置壶浆一解颜。\n世事人情随日改，不妨老子解痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东平县君挽词","author":"李新","text":"玉翰飞过碧江东，露泣三荆向晓风。\n贝叶尘生昏旧绿，蘋花烟老堕疏红。\n鸟沉孤影桓山外，虫返青冥壁水空。\n德范岂惟坟上土，传家清训是无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]