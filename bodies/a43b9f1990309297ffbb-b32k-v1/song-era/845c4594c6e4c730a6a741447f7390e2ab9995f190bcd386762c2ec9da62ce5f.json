[{"title":"江亭晚眺","author":"王安石","text":"日下崦嵫外，秋生沆砀閒。\n清江无限好，白鸟不胜闲。\n雨过云收岭，天空月上湾。\n归鞍侵调角，回首六朝山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南","author":"王安石","text":"江南春起柂，秋至尚波涛。\n问舍才能定，呼舟已复操。\n行歌付浩荡，归梦得萧骚。\n冉冉欲何补，纷纷为此劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汤泉","author":"王安石","text":"寒泉诗所咏，独此沸如烝。\n一气无冬夏，诸阳自废兴。\n人游不附火，虫出亦疑冰。\n更忆骊山下，歊然雪满塍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自白土村入北寺二首 其二","author":"王安石","text":"雨过百泉出，秋声连众山。\n独寻飞鸟外，时渡乱流间。\n坐石偶成歇，看云相与还。\n会须营一亩，长此听潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自白土村入北寺二首 其一","author":"王安石","text":"木杪田家出，城阴野径分。\n溜渠行碧玉，畦稼卧黄云。\n薄槿烟脂染，深荷水麝焚。\n夕阳人不见，鸡鹜自成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自府中归寄西庵行详","author":"王安石","text":"意衰难自力，扶路便思还。\n强逐萧骚水，遥看惨淡山。\n行寻香草遍，归漾晚云间。\n西崦分明见，幽人不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自金陵如丹阳道中有感","author":"王安石","text":"数百年来王气消，难将前事问渔樵。\n苑方秦地皆芜没，山借扬州更寂寥。\n荒埭暗鸡催月晓，空场老雉挟春骄。\n豪华祇有诸陵在，往往黄金出市朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至开元僧舍上方次韵舍弟二月一日之作","author":"王安石","text":"溪谷溅溅嫩水通，野田高下绿蒙茸。\n和风满树笙簧杂，霁雪兼山粉黛重。\n万里有家归尚隔，一廛无地去何从。\n伤春故欲西南望，回首荒城已暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中读书","author":"王安石","text":"冉冉木叶下，萧萧山水秋。\n浮云带田野，落日抱汀洲。\n归卧无与语，出门何所求。\n未能忘感慨，聊以古人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟夜即事","author":"王安石","text":"火炬临遥岸，馀光照客船。\n水明鱼中饵，沙暖鹭忘眠。\n感概无穷事，迟回欲晓天。\n山泉如有意，枕上送潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过山即事","author":"王安石","text":"却过兹山已九年，江湖身世只飘然。\n曲城丘墓心空折，盐步庭闱眼欲穿。\n惨惨野云生陇底，萧萧饥马立风前。\n转多愁思摧华发，早晚轻舟上秀川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过故居","author":"王安石","text":"溯筏开新屋，扶舆绕故园。\n事遗心独寄，路翳目空存。\n野果寒林寂，蛮花午簟温。\n难忘旧时处，欲宿愧桑门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邢太保有鹤折翼以诗伤之客有记翎经冥三韵而忘其诗者因作四韵","author":"王安石","text":"不为摧伤改性灵，静中犹见好仪形。\n每怜今日长垂翅，却悔当时误剪翎。\n医得旧创犹有法，相知多难岂无经。\n稻粱且向人间觅，莫羡抟风起北冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严陵祠堂","author":"王安石","text":"汉庭来见一羊裘，默默俄归旧钓舟。\n迹似磻溪应有待，世无西伯可能留。\n崎岖冯衍才终废，索寞桓谭道不谋。\n勺水果非鳣鲔地，放身沧海亦何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒二首 其二","author":"王安石","text":"何处难忘酒，君臣会合时。\n深堂拱尧舜，密席坐皋夔。\n和气袭万物，欢声连四夷。\n此时无一盏，真负鹿鸣诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处难忘酒二首 其一","author":"王安石","text":"何处难忘酒，英雄失志秋。\n庙堂生莽卓，岩谷死伊周。\n赋敛中原困，干戈四海愁。\n此时无一盏，难遣壮图休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初去临川","author":"王安石","text":"东浮溪水渡长林，上坂回头一拊心。\n已觉省烦非仲叔，安能养志似曾参。\n忧伤遇事纷纷出，疾病乘虚亹亹侵。\n未有半分求自赎，恐填沟壑更沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初憩和州","author":"王安石","text":"衣足一囊弊，粟馀三釜陈。\n犹依食贫地，已愧省烦人。\n尘土病催老，风波愁过春。\n诗书今在眼，还欲讨经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别葛使君","author":"王安石","text":"邑屋为儒知善政，市门多粟见丰年。\n追攀更觉相逢晚，谈笑难忘欲别前。\n客幕雅游皆置榻，令堂清坐亦鸣弦。\n轻舟后夜沧江北，回首春城空黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别雷国辅之皖山","author":"王安石","text":"侍郎忧国最贤劳，太尉西州第一豪。\n家庙比来闻泽厚，公孙今果见才高。\n明时尚使龙蛇蛰，壮志空传虎豹韬。\n莫厌皖山穷绝处，不妨云水助风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"王安石","text":"河流南苑岸西斜，风有晶光露有华。\n门柳故人陶令宅，井桐前日总持家。\n嘉招欲覆杯中渌，丽唱仍添锦上花。\n便作武陵樽俎客，川源应未少红霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"王安石","text":"径暖草如积，山晴花更繁。\n纵横一川水，高下数家村。\n静憩鸡鸣午，荒寻犬吠昏。\n归来向人说，疑是武陵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席次韵微之泛舟","author":"王安石","text":"画舸幽寻北果园，应将陈迹问桑门。\n地随墙墅行多曲，天著冈峦望易昏。\n故国时平空有木，荒城人少半为村。\n悠悠兴废皆如此，赖付乾愁酒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴正仲谪官得故人寄蟹以诗谢之余次其韵","author":"王安石","text":"越客上荆舠，秋风忆把螯。\n故烦分巨跪，持用佐清糟。\n饮量宽沧海，诗锋捷孟劳。\n甘餐饱觞咏，馀事付钧陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江","author":"王安石","text":"莽莽昔登临，秋风一散襟。\n地留孤屿小，天入五湖深。\n柑橘无千里，鱼虾有万金。\n吾虽轻范蠡，终欲此幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈陈和叔","author":"王安石","text":"毁车为屋仅容身，三岁相要薄主人。\n昼寓椁砖常至夜，冬沿沟彴复寻春。\n南陔不洎公归里，苍墓垂成我丧亲。\n后会纵多无此乐，山林投老一伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈柳子玉同年","author":"王安石","text":"三年不上邺王台，鸿雁归时又北来。\n水底旧波吹岁换，柳梢新叶卷春回。\n尘沙漠漠凋双鬓，箫鼓匆匆把一杯。\n劳事欲歌无与和，衰颜思见故人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋中道挽辞","author":"王安石","text":"文史传家学，声名动帝除。\n兰堂空作赋，金匮不雠书。\n胜事悲畴昔，清谈想绪馀。\n吹箫索上去，归国有魂车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张侍郎示东府新居诗因而和酬二首 其二","author":"王安石","text":"荣观流传动草莱，中官赐设上尊开。\n鼓歌䆗窱听疑梦，肴果联翩馈有台。\n斧藻故应宜旧德，栋梁非复称凡材。\n虚堂欲踵曹参事，试问齐人或肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张侍郎示东府新居诗因而和酬二首 其一","author":"王安石","text":"得贤方慕北山莱，赤白中天二府开。\n功谢萧规惭汉第，恩从隗始诧燕台。\n曾留上主经过迹，更费高人赋咏才。\n自古落成须善颂，扫除东阁望公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张剑州至剑一日以亲忧罢","author":"王安石","text":"客舍飞尘尚满鞯，却寻东路想茫然。\n白头反哺秦乌侧，流血思归蜀鸟前。\n今日相逢知怅望，几时能到与留连。\n行看万里云西去，倚马春风不忍鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古二首 其二","author":"王安石","text":"长者一床室，先生三径园。\n非无饭满钵，亦有酒盈樽。\n不起华边坐，常开柳际门。\n漫知谈实相，欲辩已忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古二首 其一","author":"王安石","text":"日密畏前境，渊明欣故园。\n那知饭不赐，所喜菊犹存。\n亦有床座好，但无车马喧。\n谁为吾侍者，稚子候柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀吴显道","author":"王安石","text":"南郭红亭冷，西山白道曛。\n江光凌翠气，洲色乱黄云。\n岁暮谁邀客，情亲故忆君。\n天涯独惆怅，归鸟黑纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀舒州山水呈昌叔","author":"王安石","text":"山下飞鸣黄栗留，溪边饮啄白符鸠。\n不知此地从君处，亦有他人继我不。\n尘土生涯休荡涤，风波时事只飘浮。\n相看发秃无归计，一梦东南即自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟寒山拾得二十首 其八","author":"王安石","text":"幸身无事时，种种妄思量。\n张三腨口窄，李四帽檐长。\n失脚落地狱，将身投镬汤。\n谁知受热恼，却不解思凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李君昆弟访别长芦至淮阴追寄","author":"王安石","text":"怒水凭风雪垄高，乱流追我祇鱼舠。\n忽看淮月临寒食，想映江春听伯劳。\n道义当成麟一角，文章已秃兔千毫。\n后生可畏吾知子，南北何时见两髦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李璋下第","author":"王安石","text":"浩荡宫门白日开，君王高拱试群材。\n学如吾子何忧失，命属天公不可猜。\n意气未宜轻感慨，文章尤忌数悲哀。\n男儿独患无名尔，将相谁云有种哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"每见王太丞邑事甚冗而剸剧之暇犹能过访山馆兼出佳篇为赠仰叹才力因成小诗","author":"王安石","text":"我看繁讼频搔首，君富才明见亦常。\n尚有闲襟寻水石，更留佳句似池塘。\n松苗地合分高下，凫鹤天教有短长。\n徐上青云犹未晚，可无音问及沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沂溪怀正之","author":"王安石","text":"故人何处所，天角浪漫漫。\n寂寞断音驿，徘徊愁肺肝。\n世情纷可怪，旅况浩难安。\n愿化东南鹄，高飞托羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟青溪入水门登高斋奉呈叔康","author":"王安石","text":"簿领纷纷惜此时，起携佳客散沈迷。\n十围但见诸营柳，九曲难寻故国溪。\n牵埭欲随流水远，放船终碍画桥低。\n子猷清兴何曾尽，想忆高斋更一跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纸暖閤","author":"王安石","text":"联屏盖障一寻方，南设钩帘北置床。\n侧座对敷红絮暖，仰窗分启碧纱凉。\n毡庐易以梅烝坏，锦幄终于草野妨。\n楚谷越藤真自称，每糊因得减书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏才翁挽辞二首 其二","author":"王安石","text":"翰墨随谈啸，风流在弟兄。\n浮名同逆旅，壮志负平生。\n使节何年去，丧车故老迎。\n悠悠京口外，落日照铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏才翁挽辞二首 其一","author":"王安石","text":"空馀一丹旐，无复两朱轓。\n寂寞蒜山渡，陂陀京口原。\n音容归绘画，才业付儿孙。\n尚有故人泪，沧江相与翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"身闲","author":"王安石","text":"身闲宜晚食，岁晏忌晨兴。\n人自嘲便腹，吾方乐曲肱。\n睡蛇虽不去，梦虺已无凭。\n寄语中林客，思禅病未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还自河北应客","author":"王安石","text":"愧客问谣俗，旧传今自如。\n材难知骥马，味美赛河鱼。\n塞水移民久，川防动众初。\n北人虽异论，时议或非疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还自舅家书所感","author":"王安石","text":"行行过舅居，归路指亲庐。\n日苦树无赖，天空云自如。\n黄焦下泽稻，绿碎短樊蔬。\n沮溺非吾意，悯嗟聊驻车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游慧山","author":"蒋之奇","text":"还家岂不乐，生事未应闲。\n朝日已复去，征鞍方更攀。\n伤心百道水，阅目万重山。\n何以忘羁旅，翛翛醉梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居遣兴","author":"王安石","text":"惨惨秋阴绿树昏，荒城高处闭柴门。\n愁消日月忘身世，静对溪山忆酒樽。\n南去干戈何日解，东来驲骑此时奔。\n谁将天下安危事，一把诗书子细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈动之秘丞挽辞二首 其二","author":"王安石","text":"人间三十六，追逐孔鸾飞。\n似欲来为瑞，如何去不归。\n琴樽已寂寞，笔墨尚光辉。\n空复平生友，西华岂易依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈动之秘丞挽辞二首 其一","author":"王安石","text":"年高汉贾谊，官过楚荀卿。\n望古君无憾，论今我未平。\n有风吹画翣，无日照佳城。\n空复文章在，流传世上名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈师道宰乌程县","author":"王安石","text":"尝闻太丘长，德不负公卿。\n墟墓今千载，昆云亦一城。\n本怀深闭蓄，馀论略施行。\n故自有仁政，能传家世声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈君式大夫恭轩","author":"王安石","text":"恭轩静对北堂深，新斸檀栾一亩阴。\n膝下往来前日事，眼中封植去年心。\n每怀樽斝沾馀沥，独喜弦歌有嗣音。\n肯搆会须门阀大，世资何用满籯金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京兆杜婴大醇能读书其言近庄其为人旷达而廉清自托于医无贵贱请之辄往卒也以诗二首伤之 其一","author":"王安石","text":"萧瑟野衣巾，能忘至老贫。\n避嚣依市井，蒙垢出埃尘。\n接物工齐物，劳身耻为身。\n伤心宿昔地，不复见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京兆杜婴大醇能读书其言近庄其为人旷达而廉清自托于医无贵贱请之辄往卒也以诗二首伤之 其二","author":"王安石","text":"叔度医家子，君平卜肆翁。\n萧条昨日事，彷佛古人风。\n旧宅雨生菌，新阡寒转蓬。\n存亡谁一问，嗟我亦穷空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到家","author":"王安石","text":"五年羁旅倦风埃，旧里依然似梦回。\n猿鸟不须怀怅望，溪山应亦笑归来。\n身闲自觉贫无累，命在谁论进有材。\n秋晚吾庐更萧洒，沙边烟树绿洄洄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到舒州次韵答平甫","author":"王安石","text":"夜别江船晓解骖，秋城气象亦潭潭。\n山从树外青争出，水向沙边绿半涵。\n行问啬夫多不记，坐论公瑾少能谈。\n只愁地僻无宾客，旧学从谁得指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程公辟转运江西","author":"王安石","text":"江西一节铸黄金，最慰章滨父老心。\n长孺向来真强予，次公今不异重临。\n馀风尚有欢谣在，陈迹非无胜事寻。\n豫想新诗能寄我，十年华省故情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文淑湓浦见寄","author":"王安石","text":"多难漂零岁月赊，空馀文墨旧生涯。\n相看楚越常千里，不及朱陈似一家。\n发为感伤无翠葆，眼从瞻望有玄花。\n唯诗与我宽愁病，报尔何妨赋棣华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王司封会同年","author":"王安石","text":"收科天陛顷同时，回首相欢事亦稀。\n追讲旧游犀麈脱，交酬新唱彩笺飞。\n直须倾倒樽中酒，休惜淋浪坐上衣。\n日暮主翁留客辖，会稽聊滞买臣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和平甫招道光法师","author":"王安石","text":"鍊师投老演真乘，像劫空王爪与肱。\n于总持门通一路，以光明藏续千灯。\n从容发口酬摩诘，邂逅持心契慧能。\n新句得公还有赖，古人诗字耻无僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和平甫寄陈正叔","author":"王安石","text":"强行南仕莫辞勤，闻说田园已旷耘。\n纵使一区犹有宅，可能三月尚无君。\n且同元亮倾樽酒，更与灵均续旧文。\n此道废兴吾命在，世间滕口任云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和正叔怀其兄草堂","author":"王安石","text":"茆堂竹树水之滨，耕稼逍遥似子真。\n小吏一身今倦宦，先生三亩独安贫。\n欲抛县印辞黄绶，来伴山冠戴白纶。\n祇恐明时收士急，不容家有两闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲庶夜过新开湖忆冲之仲涂共泛","author":"王安石","text":"水远浮秋色，河空洗夜氛。\n行随一明月，坐失两孤云。\n露发此时湿，风颜何处醺。\n淹留各有趣，不比汉三君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴相公东府偶成","author":"王安石","text":"承华往岁幸踌躇，风月清谈接绪馀。\n并辔趁朝今已老，连墙得屋喜如初。\n诛茅我梦江皋地，浇薤公思洛水渠。\n敛退故应容拙者，先营环堵祭牢蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴御史临淮感事","author":"王安石","text":"栅锁城扉晓一开，柂牙车轴转成雷。\n黄尘欲碍龟山出，白浪空分汴水来。\n澄观有材邀昧陋，霁云无力报奸回。\n骚人此日追前事，悲气随风动管灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]