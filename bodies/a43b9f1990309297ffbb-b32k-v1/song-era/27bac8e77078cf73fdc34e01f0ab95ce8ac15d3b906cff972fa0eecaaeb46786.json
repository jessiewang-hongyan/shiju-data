[{"title":"田舍小憩","author":"叶绍翁","text":"犬驯迎且吠，儿小笑还啼。\n樱熟施鱼网，桑空卧竹梯。\n枯枝禽啄折，野草鹿眠低。\n屋后登山路，牛栏更向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次崇德","author":"叶绍翁","text":"倦身只合卧家林，客里消磨感慨心。\n水国逢春梅未见，山城到午雾犹深。\n地名不记维舟问，酒味曾谙入巷寻。\n泛宅浮家何日了，庄头栽竹已成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访隐者","author":"叶绍翁","text":"不作王门梦，来敲隐者关。\n童先孤鹤化，云伴一身闲。\n碍笋新移路，低墙为看山。\n几回松下去，锄得茯苓还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访隐者","author":"叶绍翁","text":"开门迎客着山袍，井畔猕猴一树桃。\n儿向草间寻落果，妻从墙角过香醪。\n旧栽松子今能大，新起茅堂不甚高。\n历遍贵游无此味，韭和春雨笋和糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过崇德","author":"叶绍翁","text":"野塍泉自注，断岸柳空存。\n雨霁云开塔，船过犬吠门。\n柴扉斜着水，草径别通村。\n翻羡田家乐，盈盈老瓦盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纸帐","author":"叶绍翁","text":"五色流苏不用垂，楮衾木枕更相宜。\n高眠但许留禅客，低唱应难着侍儿。\n白似雪窗微霁后，暖于酒力半醺时。\n蒲团静学观身法，岁晚工夫要自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和葛天民呈吴韬仲韵赋其庭馆所有","author":"叶绍翁","text":"江远潮痕细，城回路势斜。\n竹行穿砌笋，风堕过墙花。\n篆叶虫留字，衔泥燕理家。\n主人清到骨，相对只杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏先牌","author":"叶绍翁","text":"相随万里途，汝岂被名驱。\n挂壁疑何用，辞家不可无。\n店翁先洒扫，津吏认称呼。\n举子无钱刻，惟将□纸糊。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表忠观韩小官人","author":"叶绍翁","text":"观里韩风子，无心似有灵。\n绕廊时自语，扪虱故忘形。\n午暴松檐暖，晨餐柏叶青。\n客来知有馈，迎笑立中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪阁","author":"叶绍翁","text":"江总能文士，空贻狎客名。\n旧基荒草占，废圃野人耕。\n古柳无多树，新蝉第一声。\n青溪固亡恙，依旧与孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居书事","author":"叶绍翁","text":"窗开双佛塔，水绕数鱼家。\n酒剩沾邻里，时平买钓车。\n童闲唯伴鹤，树老自成槎。\n枕上关心事，侵晨扫落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日游龙井","author":"叶绍翁","text":"引道烦双鹤，携囊倩一童。\n竹光杯影里，人语水声中。\n不雨云常湿，无霜叶自红。\n我来何所事，端为听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冯济川归蜀","author":"叶绍翁","text":"勇唤东吴万里船，皂囊来奏九重天。\n一官岂为苏洵冗，诸老宁容贾谊先。\n满载月归应有命，便耕云去岂无田。\n竹枝歌罢篷窗掩，到此相思倍黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻顶山徐道人改卜","author":"叶绍翁","text":"先生新卜宅，只许白云知。\n野蜜和蜂割，岩花带蝶移。\n坐谙苔石稳，醉忘木桥危。\n屋后寒梅放，因风寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄湖上黄教","author":"叶绍翁","text":"门幽缘近寺，官冷未成家。\n楼借山为障，风吹水作花。\n诗方酬北涧，经又节南华。\n闻说新雏凤，宾来解唤茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒半山祠","author":"叶绍翁","text":"归去田畴问老农，力行新法竟何功。\n已知供佛追前过，尚惜修书谢数公。\n塑像难陪夫子壁，古祠谁访觉王宫。\n都来二百年间事，燕麦戎葵几度风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居 其二","author":"叶绍翁","text":"无酒难留客，借书方入城。\n洗衣知水落，贪睡畏窗明。\n野竹藤缠杀，枯枝草寄生。\n十年林下隐，差觉世缘轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居 其一","author":"叶绍翁","text":"云补青山缺，琴销白日长。\n鸥从雨外没，蛇入树间藏。\n客久衣常黑，童蛮发半黄。\n萤多邻舍少，此意自凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛天民隐居","author":"叶绍翁","text":"种竹成新列，移兰即旧阴。\n老铛犹有耳，古柳已无心。\n得句添杯满，贪炉到夜深。\n篝灯聊点校，春水没衣砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋葛天民栽苇","author":"叶绍翁","text":"叶碍渔舟入，丛分水国宽。\n低回藏鹭渚，彷佛钓鱼竿。\n荡户和萍送，溪翁当竹看。\n所怜如许节，不耐雪霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山间老友壁","author":"叶绍翁","text":"山间虽寂静，未得事全无。\n锄地留莎草，添泉养石蒲。\n庭除风自扫，身世月同孤。\n老去知禅味，松间试结趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题孙端甫别墅","author":"叶绍翁","text":"幽居地僻少人知，野水春风枳树篱。\n检历预寻移竹日，题墙闲记种花时。\n堪嗤狡兔须三窟，只学鹪鹩占一枝。\n净扫绿苔斟浊酒，邻家吹过野棠梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鄂王墓","author":"叶绍翁","text":"万古知心只老天，英雄堪恨复堪怜。\n如公更缓须臾死，此虏安能八十年。\n漠漠凝尘空偃月，堂堂遗像在凌烟。\n早知埋骨西湖路，学取鸱夷理钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发长安堰","author":"叶绍翁","text":"夏老虫声切，晨兴草气香。\n买瓜依绿树，出水?青秧。\n船聚知村近，牛闲觉昼长。\n双凫莲叶荡，无雨故生凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石头感古","author":"叶绍翁","text":"夷甫诸人者，龟趺已故丘。\n但能挥玉麈，不解冠兜鍪。\n正朔从江左，经营仅石头。\n中原虽可望，不忍上层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"猫图","author":"叶绍翁","text":"醉薄荷，扑蝉蛾。\n主人家，奈鼠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敬陪直院右史上巳后一日西斋之集","author":"叶绍翁","text":"清时天上诏书稀，曲水从游许布衣。\n插羽满浮寒食酒，倚栏同忆故山薇。\n碧桃绕观春风静，柔橹摇汀夕照微。\n慨想兰亭如昨日，沙鸥飞下钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登谢屐亭赠谢行之","author":"叶绍翁","text":"君家灵运有山癖，平生费却几緉屐。\n从人唤渠作山贼，内史风流定谁识。\n西窗小憩足力疲，梦赋池塘春草诗。\n只今屐朽诗不朽，五字句法谁人追。\n天台览遍兴未已，天竺山前听流水。\n秦人称帝鲁连耻，宁向苍苔留屐齿。\n乙庵是渠几世孙，登山认得屐齿痕。\n摩挲苔石坐良久，便欲老此岩之根。\n吾侬劝渠且归去，请君更学遥遥祖。\n遥遥之祖定阿谁，曾出东山作霖雨。\n乙庵未省却问侬，莫是当年折屐翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞洞宾像","author":"叶绍翁","text":"撚吟髭，剑在前。\n心中月，天上圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"叶采","text":"双双瓦雀行书案，点点杨花入砚池。\n閒坐小窗读周易，不知春去几多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七星岩","author":"叶南仲","text":"斗峰遥认旧嵩台，为劝耕农特地来。\n短李高名光翠壁，伪刘真迹没苍苔。\n洞天日永风埃静，岩窦云收霁色开。\n好景最宜供宴赏，操觚欲赋愧非才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"叶省干","text":"闲傍苍苔数落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"叶祐之","text":"木叶临风皆好色，稻田流水亦新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令","author":"叶祖义","text":"如梦。\n如梦。\n和尚出门相送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"叶祖义","text":"醉来黑漆屏风上，草写卢仝月蚀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邵武","author":"叶祖洽","text":"江南烟雨蔽征轮，行近樵阳景渐真。\n鸟语乍闻如梦寐，林光初见长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台","author":"叶祖洽","text":"先生遗世者，长谢帝京尘。\n一钓桐江水，高名万古春。\n客星曾犯座，天子不能臣。\n台下千帆过，风波愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"叶祖洽","text":"已分桂叶争云路，不负榴花结露枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一片峰","author":"叶茵","text":"十丈苍圭似削齐，摩挲信是古来碑。\n不刊二范忠劳绩，合写诸贤唱咏诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一线泉","author":"叶茵","text":"银潢万丈下嵯峨，想是天孙挂玉梭。\n休道此泉丝样小，涓涓将见作江河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠","author":"叶茵","text":"一为功成一见几，一逢叔世老渔矶。\n后人欲隐求其志，志不因时隐亦非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"叶茵","text":"古木环池竹数竿，疏篱补菊屋三间。\n白云不放红尘入，无怪山人懒出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云思","author":"叶茵","text":"交柯叆苍寒，不碍青霄路。\n油然隐者心，一声孤鹤度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕","author":"叶茵","text":"一簇莲灯亦可观，隔墙箫鼓二更残。\n平生未识繁华事，旋借宣和国史看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少陵骑蹇驴图","author":"叶茵","text":"帽破衣宽骨相寒，为花日日醉吟鞍。\n时人祗道题风月，后世将诗作史看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"止庵","author":"叶茵","text":"时事艰难路险巇，得来名利亦何为。\n赵州茶罢速归去，莫待钟鸣漏尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水竹墅十咏 其十 寻源桥","author":"叶茵","text":"躞蹀水穷处，鸡犬非人间。\n褰裳不用涉，迤逦逃秦山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水竹墅十咏 其一 曲水流觞","author":"叶茵","text":"兰亭饮者徒，因物寓天理。\n著眼静中观，坎止流行耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水竹墅十咏 其五 竹风水月","author":"叶茵","text":"造物无尽藏，散在林泉中。\n结亭相周旋，人与万境空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水竹墅十咏 其二 峭壁寒潭","author":"叶茵","text":"百丈崖悬立，一泓流绿漪。\n品题无好语，摹写冷泉诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水竹墅十咏 其七 盟鸥","author":"叶茵","text":"同此江湖心，有盟非知己。\n我亦畏机人，莫入惊波里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去去","author":"叶茵","text":"去去扁舟对晚晖，晴和直欲减绵衣。\n风来一阵芦花过，祗道春残柳絮飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意","author":"叶茵","text":"悠悠涧边人，溅溅涧中水。\n水流无返时，人生流水耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意二首 其二","author":"叶茵","text":"境空纳风月，心远辞埃尘。\n终日穷目力，得景亡天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意二首 其一","author":"叶茵","text":"逝波不可回，白鸟不可驯。\n古人成感慨，今人犹古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"头陀岩","author":"叶茵","text":"旧说头陀坐石巅，披肩坏衲不知年。\n空岩圣得头陀号，啼鸟枯松也解禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归途","author":"叶茵","text":"春来天气半阴晴，那更奔驰一月程。\n又恐花时成草草，还家插柳佐清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"打坐","author":"叶茵","text":"一卷黄庭日未移，跏趺坐处篆香迟。\n儿曹问我新官职，顺适堂中老住持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日口占","author":"叶茵","text":"举室相先起五更，为翁诞日寿金觥。\n痴儿未识翁年甲，五十年前今夜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其二","author":"叶茵","text":"夜登车桁昼耘秧，怕说风伤与水伤。\n历尽艰辛双鬓白，今秋方觉稻花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其五","author":"叶茵","text":"逢逢社鼓佐丰年，酒熟那逢酿雪天。\n擘橘煮鸡偿一醉，布衾烘暖抱孙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其三","author":"叶茵","text":"老天应是念农夫，万顷黄云著地铺。\n有谷未为儿女计，半偿私债半官租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其二","author":"叶茵","text":"家家柳色染轻黄，柳外归鸦噪夕阳。\n屋角有烟青不断，粞儿饭熟淡齑香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其三","author":"叶茵","text":"群来野雀绕林梢，三五人家住水坳。\n翁媪语人年岁好，屋山添得一层茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其一","author":"叶茵","text":"桃花深映水边庄，夫妇相携笑语香。\n耕耨有粮蚕有种，丁男戽水女条桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其五","author":"叶茵","text":"往来鸡酒乐村村，一稔难忘大造恩。\n粜谷可酬婚嫁愿，今年好事属柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其一","author":"叶茵","text":"去年积潦苦无收，今岁逢人说有秋。\n未拟香粳供一饱，穇穇新藁盖檐头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田父吟五首 其四","author":"叶茵","text":"未晓催车水满沟，男儿鬼面妇蓬头。\n但求一熟偿逋债，留得糠粞便不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白发","author":"叶茵","text":"半世持竿笠泽滨，鬓边留得几茎春。\n近来白发无公道，暗把黑头饶贵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白牡丹","author":"叶茵","text":"洛阳分种入侯家，魏紫姚黄谩自誇。\n素质不为颜色污，看来清得似梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石佛","author":"叶茵","text":"一段无情作有情，如来相貌十分真。\n不因人世皆尘土，谁识山头不坏身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记颜","author":"叶茵","text":"五十一年前素昧，相逢元是镜中人。\n他时鹤发鸡皮样，却道今番画未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买鱼","author":"叶茵","text":"柳线穿来网上鱼，宽偿所直办朝厨。\n烹鲜不及为亲养，一笑分羹问二雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"优钵罗花","author":"叶茵","text":"九房六瓣瑞天山，香色清严入坐寒。\n不悟岑参题品意，后人祗作佛花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"存方寸地","author":"叶茵","text":"客问燕山地，燕山地不多。\n祗因解培植，桂子绿婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尘外","author":"叶茵","text":"自有此山扃，疑与浮世隔。\n清风袭我裳，竹下有来客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]