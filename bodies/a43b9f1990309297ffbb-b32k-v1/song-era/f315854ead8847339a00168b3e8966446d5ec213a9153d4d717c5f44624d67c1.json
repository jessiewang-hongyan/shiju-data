[{"title":"辰十月八日同希周扫松灵石晚步松下怆然有怀以数诗示儿侄辈邀希周同赋时阿同在新城他日当寄之 其二","author":"谢直","text":"老树谁所栽，及兹上交盖。\n峥嵘仰巨樟，秀发怜稚桧。\n悠然搅心思，慨我百年外。\n我怀引以长，天色惨欲晦。\n投床闻夕钟，拥衾不成醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辰十月八日同希周扫松灵石晚步松下怆然有怀以数诗示儿侄辈邀希周同赋时阿同在新城他日当寄之 其四","author":"谢直","text":"先公为直言，蔡林古无书。\n家贫卖窗箔，编箨聚所馀。\n取之写文字，琐细行虫蛆。\n遂令后奕世，衣冠出门闾。\n今为执政孙，学与不学欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辰十月八日同希周扫松灵石晚步松下怆然有怀以数诗示儿侄辈邀希周同赋时阿同在新城他日当寄之 其一","author":"谢直","text":"寒光转南陆，夕景上乔木。\n层柯荫脩径，疏密散金绿。\n缅怀载酒人，萝蔓记遐躅。\n行行出林表，烟莽际童牧。\n时有种麦儿，挥锄电翻覆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辰十月八日同希周扫松灵石晚步松下怆然有怀以数诗示儿侄辈邀希周同赋时阿同在新城他日当寄之 其六","author":"谢直","text":"昔在井田日，一民本非四。\n农隙或工商，其秀乃称士。\n是知桑禾间，可以寄书史。\n时非长桀耦，时得伊傅事。\n卒岁优游哉，吾道甚简易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"谢直","text":"上有皇天下后土，此身不患无归所。\n凭谁说与清河公，何苦为人作黄祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀五首寄致道 其五","author":"谢直","text":"在昔营居巢，首尾三十年。\n高邻念羁旅，分我佳林泉。\n自从仓幕归，亦买半顷田。\n坐念颜太师，粥竭祇益煎。\n不如边孝先，昼眠腹便便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀五首寄致道 其三","author":"谢直","text":"君子不谋食，士固食于人。\n饥饿自有责，何足烦吾神。\n拂几展我书，熟读困蹇屯。\n羲文与周孔，可鉴道屈信。\n叹叹眼中事，悠悠尘间身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀五首寄致道 其四","author":"谢直","text":"生当益于人，为道固不同。\n赐也乃结驷，回也乃屡空。\n忆昔年少壮，未知理穷通。\n收身百忧馀，自置寂寞中。\n饘粥傥可继，当为七十翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀五首寄致道 其二","author":"谢直","text":"时命各有遇，何言富与贫。\n有来疾雷电，决去微埃尘。\n坐令区区者，视此为鬼神。\n既有得失患，自忘情性真。\n所以首阳山，昔有饿死人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀五首寄致道 其一","author":"谢直","text":"贫者士之常，富亦我所欲。\n得常讵可厌，逐欲何由足。\n荒哉化蝶翁，微欤监河粟。\n人生命如线，日须不盈匊。\n俯仰天地间，何由谢羁束。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 赠妓","author":"谢直","text":"双桨浪花平，夹岸青山锁。\n你自归家我自归，说着如何过。\n我断不思量，你莫思量我。\n将你从前与我心，付与他人可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩干马","author":"谢采","text":"圉人唐衣冠，天闲畜神骏。\n虽非金日磾，不忝张景顺。\n饱食无嫌身贱卑，时其渴燥张饮之。\n长年牧养瘠者肥，龙鬐凤臆誇权奇。\n韩干仙翁挥翰手，毫端幻出渴乌首。\n气不凋丧骨肉匀，艺精端继王裴后。\n遥想腾骧析木津，衔勒难拘自在身。\n斗水底用求他人，渌波沄沄易水春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钓台三贤堂","author":"谢采伯","text":"辍帆谒肖像，衣冠非汉俦。\n翩翩挂佛幡，小椟求香油。\n庸衲资诳惑，良为先生羞。\n后来跻两贤，几与逆祠侔。\n扁堂失本旨，贻诮何时休。\n盍归白而长，是正兹谬悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"谢采伯","text":"归来邻里悉不记，未免惊呼问桑竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答赵生红梨花诗","author":"谢金莲","text":"本分天然白雪香，谁知今日却浓妆。\n秋千院落溶溶月，羞睹红脂睡海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢三井山祷雨二首 其一","author":"陈襄","text":"曾祷神龙井，云林杳莽间。\n蘋蘩朝荐庙，风雨夜离山。\n百里田畴熟，一年囹圄閒。\n因循失报谢，石险路难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题湖上","author":"谢雨","text":"杜鹃呼我我归休，陆有轻车水有舟。\n笑杀西湖湖上客，醉生梦死恋杭州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"军峰","author":"谢驿","text":"倚天青壁瘦巉岩，下有神龙捲作潭。\n龙欲出时山吐气，黑云随手暗江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州","author":"谢驿","text":"谁把杭州曲子讴，荷花十里桂三秋。\n那知卉木无情物，牵动长江万里愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西捷口号","author":"谢举廉","text":"圣明陛下如先帝，辟国谋臣似召公。\n不遣毛嫱嫔漠北，只将魏尚守云中。\n百年境土逡巡复，万里窠巢指顾空。\n今日版图非昔日，玉关西有岭名葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题指纹斗牛图","author":"谢举廉","text":"左者前其角，右者后其足。\n浼君双指螺，战此两觳觫。\n草长水远日悠悠，不向桑间自在休。\n蜗头尚可屠蛮触，壁上从今斗二牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浴日亭","author":"谢举廉","text":"煌煌太阳精，浴以沧溟水。\n光润无纤滓，畏爱从此始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"谢举廉","text":"万里一时开骥足，百年今始破天荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次兄奕修群玉山留题韵","author":"谢奕信","text":"碧玉参差绕崛奇，来登胜概喜忘疲。\n人传唾玉添芳润，二十年前刺史为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"群玉山留题","author":"谢奕修","text":"天竺呼猿未当奇，化工锼剔亦应疲。\n漫山尽是玲珑玉，却笑名园以假为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次兄奕修群玉山留题韵","author":"谢奕奎","text":"喜登群玉访幽奇，步步琼瑶力不疲。\n拂拭棠阴留石刻，天然仙境岂人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋梅","author":"谢洪","text":"朔风飕飕著古梅，寒枝冷落俟春回。\n可怜雪萼无人问，乞借阳和早放开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送馀姚知县陈最寺丞 其一","author":"谢绛","text":"稍过山阴接甬东，正当两国画屏中。\n岩巅僧井通江水，门外商帆落海风。\n尽日挥弦无一事，平时推毂有诸公。\n此行绝胜人人羡，莫恨犹怀五两铜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送馀姚知县陈最寺丞 其二","author":"谢绛","text":"愧君来款关，话别憩林间。\n不待风销暑，聊因酒发颜。\n沧洲即欲往，清躅暂容攀。\n居者羡行者，寄声思越山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小隐园诗","author":"谢绛","text":"仆本尘外士，功名若毫末。\n因寻小园隐，忽见群芳发。\n昔梦宛可记，灵契方兹达。\n会须挂朝缨，归弄岩前月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双松亭","author":"谢绛","text":"筑居喜物外，披径穷木末。\n层阜绕襟带，澄江见毫发。\n芬芬山蜜熟，决决春泉活。\n林梢闪猿陨，石罅整衔月。\n坐长百虑寂，望远孤兴发。\n何必较万殊，吾自师吾达。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答梅圣俞问隐","author":"谢绛","text":"圣俞一幅书，间我小隐居。\n小隐讵有异，筑室数亩馀。\n岩壑不峻崒，田园非美腴。\n所欲近丘墓，岁时来扫除。\n先人梦读史，尊道本圣徒。\n绝笔于此诗，子孙无忽诸。\n刻石置中堂，且使过者趋。\n题榜为服训，义取铭盘盂。\n后岭双松亭，径术何逶迂。\n下临富春渚，万象生有无。\n东偏作草舍，可以施琴壶。\n门前碧塘水，万本栽荷蕖。\n风来触香气，长著人衣裾。\n澄水泱泱流，黍稻可勿枯。\n柔桑及美果，种广莫记株。\n涧草不识名，野禽多异呼。\n坐此易岁晏，自与人世疏。\n在昔东陵侯，瓜垄犹亲锄。\n杨恽谢九列，种豆南山隅。\n余尝有此志，来者安敢诬。\n诛茅实张本，解组当后图。\n是时考槃赋，从我者骓欤。\n近来傅越石，趣尚若不殊。\n傥闻丘樊往，不顾升斗储。\n如君美才具，日月升云衢。\n安敢预招挽，粗自陈其愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"联句","author":"杜衍","text":"古木含清吹，池上增晚凉。\n余怀本达旷，联此傲羲皇。\n孤鸥可与狎，幽岸足以觞。\n幸有彭泽酒，便同永嘉堂。\n潘生起为寿，王子齐陈章。\n林端见新月，草际闻寒螀。\n照水萤影乱，拂筵蓼花香。\n徘徊恋嘉境，坐使归兴忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情令 宫怨","author":"谢绛","text":"银缸夜永影长孤。\n香草续残炉。\n倚屏脉脉无语，粉泪不成珠。\n双粲枕，百娇壶。\n忆当初。\n君恩莫似，秋叶无情，欲向人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜行船 别情","author":"谢绛","text":"昨夜佳期初共。\n鬓云低、翠翘金凤。\n尊前和笑不成歌，意偷转、眼波微送。\n草草不容成楚梦。\n渐寒深、翠帘霜重。\n相看送到断肠时，月西斜、画楼钟动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 咏目","author":"谢绛","text":"娟娟侵鬓妆痕浅。\n双眸相媚弯如剪。\n一瞬百般宜。\n无论笑与啼。\n酒阑思翠被。\n特故瞢腾地。\n生怕促归轮。\n微波先注人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢绛","text":"秋波下南浦，晓气望西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"谢绛","text":"王貌闲如鹤，黄吟苦似猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"谢卿材","text":"东倾壶柄双流水，西阚瓯唇四别峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作","author":"谢涛","text":"百年奇特几张纸，千古英雄一窖尘。\n惟有炳然周孔教，至今仁义浸生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题澄照寺主师壁","author":"谢涛","text":"叠巘收云拂眼明，久依香社豁高情。\n主人心似秋池水，一日看来一日清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送石深之归沃洲","author":"谢耘","text":"懒踏红尘地，结庐岩壑间。\n酒催清夜别，身伴白云还。\n贺老湖边月，支公屋外山。\n沃洲吟不尽，天与老翁闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"谢耘","text":"路深容马窄，楼小插花多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖偶成","author":"谢隽伯","text":"思远楼西平屿东，会昌湖上藕花风。\n水亭隔岸湘帘捲，人倚阑干忆谢公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂兴 其二","author":"谢隽伯","text":"高槐堕疏花，梁燕感时节。\n神飙驾轻翮，行计夙已决。\n飞鸣绕前檐，似与主人别。\n乌衣隔海云，去去避霜雪。\n故垒尚未归，相期杏花月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日杂兴 其一","author":"谢隽伯","text":"西风运金气，万籁含商声。\n寒蛩亦何为，微音最凄清。\n幽人倦长夜，拊枕难为情。\n朱门沸歌钟，醉卧鸳鸯屏。\n晨鸡唤不醒，况乃闻蛩鸣。\n蛩声自酸悽，赖有幽人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台道中","author":"谢深甫","text":"溪绕青山路绕溪，山长溪曲路高低。\n晴滩浅湿舟如荡，危磴棱层石作梯。\n晚照荒村飞鸟入，秋风落木败蝉嘶。\n碧云四合长天暮，转使乡关望眼迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"识时梅歌","author":"谢琎","text":"寇至人远避，寇退人复归。\n归来寻旧址，草芜迷荒基。\n哀哉住傍梅，清梦常相依。\n可怜岁寒心，能识存亡机。\n不欲染尘垢，先枯避时虞。\n方今向太平，枯干生新枝。\n主人修废坠，古梅仍春辉。\n俗态分荣瘁，梅心无改移。\n如我耐寒友，头白不相违。\n梅花自奇绝，世事与古别。\n花下独徘徊，似听梅花说。\n不愿傍官驿，驿外尘飞多马迹。\n几番驿使自南来，南枝折尽花狼藉。\n不愿在深宫，蛾眉人去寿阳空。\n缤纷檐下花飞片，不上宫妆入草丛。\n不愿在西湖，旧时逋仙迹已芜。\n可惜暗香疏影处，迩来都是给樵苏。\n不愿近东阁，无人更管花开落。\n黄昏风雨锁朱门，和羹人伴归沙漠。\n但愿开向千岩窟，饕虐冯陵任风雪。\n花香只绕处士庐，花飞不点征人骨。\n吟翁索笑痴更痴，谁似梅花能识时。\n始终不渝含酸味，去就长存调鼎资。\n广平铁石笔何在，生死与我深相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天柱","author":"谢章","text":"莺花婉娩天，晴空落红雨。\n千里赋远游，山水无重数。\n武夷天下甲，清绝多奇趣。\n名峰三十六，一一拱天柱。\n隔岸分西东，回首时一顾。\n孤高自特立，不肯相朋附。\n溪流走其下，萦纡溢清泚。\n荒烟锁寒碧，晴岚滴空翠。\n曲曲深复深，行行止且止。\n时闻欸乃歌，恍入桃源路。\n山禽相应答，岭云自吞吐。\n此境非人寰，蔚为神仙所。\n我欲深穷□，白鸥没星渚。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又一首","author":"谢绪","text":"莫笑狂夫老更狂，推轮怒臂勇螳螂。\n三军未复图中土，万姓空悲塞外乡。\n动地声名悬宇宙，擎天气概荡边疆。\n忠心自古人人有，莫笑狂夫老更狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝笔","author":"谢绪","text":"立志平夷尚未酬，莫言心事付东流。\n沦胥天下谁能救，一死千年恨不休。\n湖水不沉忠义气，淮淝自愧破秦谋。\n苕溪北去通胡塞，流此丹心灭虏酋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望云","author":"谢绪","text":"东山渺渺白云低，丹凤何时下紫泥。\n翘首夕阳连旧眺，谩看黄菊满新溪。\n鹤闲庭砌人稀迹，苔护松荫山径迷。\n野老更疑天路近，苍生犹自望云霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉山观","author":"谢谔","text":"微明灯火夜堂幽，听彻丝桐万虑休。\n骨冷魂清眠不得，竹风萧瑟满庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至曾田市贻管巡检 其一","author":"谢谔","text":"一年三过曾田市，春去秋来瞬息间。\n安得此身无俗累，清高长似寨前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至曾田市贻管巡检 其二","author":"谢谔","text":"将军齐相夷吾后，不用干戈盗自清。\n回首江南望江北，故乡天际暮云平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南真观","author":"谢谔","text":"人烟一簇古溪头，竹树低昂映碧流。\n曳杖不知山路险，南真观里谒浮丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子岘之官萍乡 其一","author":"谢谔","text":"圣主除官本为民，吾儿何幸到簪绅。\n但须因此行方便，不必为冬更学春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子岘之官萍乡 其二","author":"谢谔","text":"吏师吾昔得三贤，回首思之几许年。\n屈指利名多少事，其间廉节最为先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鳌溪 其一","author":"谢谔","text":"数版小桥横晚晴，两行古木弄春荣。\n不知多少夜来雨，水到岸头浑欲平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鳌溪 其二","author":"谢谔","text":"蔼蔼烟云望眼昏，乱红翻径绿遮门。\n一声啼鸟在何处，山外人家桑柘村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六瑞堂","author":"谢谔","text":"循良天惠海边头，波浪澄清宿雾收。\n才把一麾来北阙，便惊六瑞到南州。\n日高双影亭亭并，风动孤香冉冉浮。\n好作画图献当宁，御屏风上永传休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝农","author":"谢谔","text":"莫入州衙与县衙，劝君勤理旧生涯。\n池塘多放聊添税，田地深耕足养家。\n教子教孙须教义，栽桑栽柘胜栽花。\n闲非闲是都休管，渴饮清泉困饮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙回院","author":"谢谔","text":"堂殿尘埃外，轩棂紫翠中。\n凭栏千嶂雨，攲枕半窗风。\n得意何妨僻，寻幽岂易穷。\n分张閒草木，一一见春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延福寺","author":"谢谔","text":"阅世岩松古，随人径藓斑。\n楼台云冉冉，沙石水潺潺。\n兴出崎岖外，身行杳霭间。\n通天知有路，一笑槛前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读书台","author":"谢谔","text":"莓苔点点路层层，此地分明胜概增。\n天上楼台山上寺，云边钟鼓月边僧。\n青松鹤梦生秋吹，宝塔星华见夜灯。\n消尽尘襟三万斛，石床閒倚古萝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清常寺","author":"谢谔","text":"佛庐尘不到，客枕梦频惊。\n淅淅山风响，纤纤隙月明。\n烟云春渐暖，钟磬晓逾清。\n踪迹奔驰里，飘浮愧此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]