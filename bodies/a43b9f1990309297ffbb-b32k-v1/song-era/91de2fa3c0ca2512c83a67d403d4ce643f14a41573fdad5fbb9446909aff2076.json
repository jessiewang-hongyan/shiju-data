[{"title":"投壶","author":"卢钺","text":"离骚课罢便投壶，长日身心得自娱。\n多少论筹闲殿最，始终中节定工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和太傅平章魏公咸淳庚午冬大雪遗安抚潜侍郎 其一","author":"卢钺","text":"天花六出瑞午林，公溥明通造化心。\n农望丰年知兆朕，物涵生意总怀任。\n兔围奕奕誇圭璧，薇戍霏霏咏昔今。\n擎重老枝长玉立，主张阳类杜群阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和太傅平章魏公咸淳庚午冬大雪遗安抚潜侍郎 其二","author":"卢钺","text":"底用封书祷梵林，瑞霙先腊感由心。\n豫知农亩宜禾稼，复喜边储足辇任。\n民乐齐宫誇往昔，捷歌周戍属斯今。\n燮调妙造推元老，治象阳明无伏阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏台览古","author":"卢钺","text":"姑苏台下百花洲，解语香魂此旧游。\n巧笑已倾吴子国，浅颦又涴范公舟。\n湖山四顾无奇骨，五霸俱空等拙谋。\n杯酒酹江应自誓，男儿西北有神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹","author":"卢梅坡","text":"玉栏四面护花王，一段风流似洛阳。\n深院不须驱野鹿，只愁蜂蝶暗偷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉","author":"卢梅坡","text":"云袂飘摇翠佩环，仙姿绰约紫霞冠。\n虽然谪在西风里，合作人间小牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闵雨","author":"卢梅坡","text":"百万人家井水黄，江南大半田无秧。\n乖龙岂是为霖物，贪弄明珠簸日光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茉莉","author":"卢梅坡","text":"京尘湫隘■蚊多，彼美繁英玉雪窠。\n见谓娇柔能特立，肯凭他物学藤萝。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游","author":"卢梅坡","text":"红芳满眼斗风流，谁信春来有客愁。\n惆怅不干桃李事，故山烟雨忆松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚕","author":"卢梅坡","text":"春蚕运巧起经纶，底事周防反杀身。\n鼎镬如归缘报主，羞他肥禄避危人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其九","author":"方岳","text":"有梅无雪不精神，有雪无诗俗了人。\n薄暮诗成天又雪，与梅并作十分春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"卢梅坡","text":"梅雪争春未肯降，骚人阁笔费平章。\n梅须逊雪三分白，雪却输梅一段香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读康节诗","author":"卢梅坡","text":"先生乐处少人知，最是生平不皱眉。\n身世帝王全盛日，风光伊洛太平时。\n画前勘破先天易，醉后吟成击壤诗。\n高卧行窝吾亦愿，不堪心事类周嫠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳絮","author":"卢梅坡","text":"晴栏看尽柳花飞，一段风情不自持。\n若使化为萍逐水，不如且作絮沾泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荼蘼 其一","author":"卢梅坡","text":"荼蘼结屋是何年，风雨摧颓为怆然。\n飞似绿珠楼上坠，困于毕卓瓮间眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅","author":"卢梅坡","text":"自负孤高伴岁寒，玉堂茆舍一般看。\n顽风摧剥君知否，铁笛一声人倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再题浯溪","author":"卢察","text":"逆孽滔天乱大伦，忠邪淆杂竟何分。\n欲知二圣巍巍力，止在浯溪一首文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题浯溪","author":"卢察","text":"□后声名人始贵，真卿笔札次山文。\n二贤若使生同世，□□□悲不放君。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题梨岭冯唐庙","author":"卢篆","text":"五原塞外骄儿悍，万死台前女子多。\n闻道中郎知魏尚，不教天子忆廉颇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"卢蹈","text":"客怀耿耿自难宽，老傍京尘更鲜欢。\n远梦已回窗不晓，杏花同度五更寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈一首","author":"印首座","text":"不挂寸丝方免寒，何须特地袅长竿。\n而今落落零零也，七佛之名甚处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"印首座","text":"折脚铛儿谩自煨，饭馀长是坐堆堆。\n一从近日生涯拙，百鸟衔华去不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨过","author":"厉元吉","text":"漠漠轻云过野墙，新枫矮柏色苍苍。\n平田鹳迹留残雨，深坞鹂声带夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"厉元吉","text":"免冠思脱三涂难，吐舌甘从五鼎烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花","author":"厉文翁","text":"杏花菖叶渐烂斑，率属劭农入祖关。\n昔日郎君方彩袖，今朝太守已苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庭竹","author":"厉文翁","text":"渭川未暇栽千亩，庭槛聊须种数根。\n敢爱深秋群木脱，独欺风雨战黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶","author":"厉文翁","text":"海滨鱼盐胜耕稼，尝呼父老采丁宁。\n江乡鱼茗尤逐末，为分利害别重轻。\n拔茶种桑何苦口，崇阳因得良吏名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"厉文翁","text":"苍芜万顷渺无边，鞭石飞梁接市廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"厉文翁","text":"暮云春雪江南北，回首人生叹路歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"厉文翁","text":"且喜卧龙常自在，新诗特地报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"厉文翁","text":"若见集英门外柳，为言曾惹御炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"厉文翁","text":"翠草庭前生意足，甘棠堤上去思多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺乔丞相 其一","author":"厉寺正","text":"乔年国同永，寿星秋见丙。\n社稷资夹扶，乾坤赖重整。\n善胜在不争，镇浮惟以静。\n金鉴上千秋，爱君时戒警。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其二","author":"厉寺正","text":"和羹梅傍小春荣，尧陛犹馀一荚蓂。\n万里云收天镜净，三台星畔老人星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其一","author":"厉寺正","text":"天地钟奇在鄞鄮，代产真儒傅衮绣。\n明良千载会风云，虎拜万年同国寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其六","author":"厉寺正","text":"耆艾何须比龟鹤，高深岂止如川岳。\n但祈公永辄萝图，常诵缉熙比帝学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其五","author":"厉寺正","text":"人才谁不出陶镕，耆旧皆归聘召中。\n周室中兴由任使，颂声今可继周崧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其三","author":"厉寺正","text":"瑞应金穰均禹甸，三边洗甲谁言战。\n关河岂但犬羊奔，郊薮殆将麟凤见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其八","author":"厉寺正","text":"遥想翘材集贺宾，未饶珠履寿春申。\n原嗟老守师门士，独望黄扉种大椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其七","author":"厉寺正","text":"贵极台衡世莫京，依然璧水一儒生。\n只将无限宽洪意，上为皇家致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺乔丞相 其四","author":"厉寺正","text":"相公一身兼，爵德齿俱全。\n剑履登金殿，山川锡土田。\n龟游莲叶露，蚁泛菊花天。\n白鹭洲边守，重赓绿竹篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺乔丞相 其三","author":"厉寺正","text":"天下达尊三，加之量海涵。\n忠言今稷契，眉寿古彭聃。\n渭水功犹小，汾阳考欲参。\n料应宣劝处，花不数优昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺乔丞相 其二","author":"厉寺正","text":"孔山民具瞻，位高心愈谦。\n待人冬日暖，持己晓霜严。\n善类藉培植，贤材无滞淹。\n更栽椿百本，岁岁绿阴添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺郑丞相 其四","author":"厉寺正","text":"大学道惟一能静，国势尊安如九鼎。\n致君事业比皋夔，不羡萧曹并魏丙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万年欢 寿乔丞相","author":"厉寺正","text":"卫武期颐，与文公福艾，俱号贤相。\n今我元台，齿德又居其上。\n玉立擎天一柱，似泰华、气凌秋庄。\n明良会，千载风云，长为龙衮凭仗。\n清知孔山叠嶂。\n有猿吟鹤舞，日俟鸠杖。\n无忝苍生依依，未容高尚。\n待整顿、乾坤了当，与蓬岛、神仙来往。\n摩铜狄，点检笙歌，菊浮香泛新酿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临卒书诗","author":"古成之","text":"物外乾坤谁得到，壶中日月我曾游。\n留今留古曾留得，一醉浮生万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五仙观二首 其一","author":"古成之","text":"拨破浮尘入紫烟，五羊坛上访神仙。\n人间自觉无闲地，城里谁知有洞天。\n竹叶影繁笼药圃，桃花香煖映芝田。\n吟馀池畔聊攲枕，风雨萧萧吹白莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆罗浮","author":"古成之","text":"忆昔罗浮最上峰，当年曾得寄仙踪。\n凭阑月色出沧海，攲枕秋声入古松。\n采药静寻幽涧洗，寄书闲仗白云封。\n红尘一下拘名利，不听山间午夜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀石楼","author":"古成之","text":"相思天一边，知在石楼间。\n高卧客稀到，数峰人共閒。\n仙方新更试，易疏旧曾删。\n好探鳌头信，时应有鹤还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贪泉","author":"古成之","text":"贤良知足辱，为尔戒贪名。\n一酌不能惑，千年依旧清。\n深涵秋汉色，冷浸古松声。\n珍重荒碑在，何人曾泪倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游天通真身塔","author":"古成之","text":"洁志登高塔，西南对海城。\n一真虽有相，万法本无生。\n梅雨侵窗冷，天风入海清。\n临回慵更语，祖意自分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五仙观二首 其二","author":"古成之","text":"玄元分古观，南镇越王城。\n五石空留瑞，群仙不记名。\n丹砂虽久炼，鸡犬自长生。\n槛簇鳌头景，门通鹤颈程。\n烟霞随砌起，花木逐时荣。\n古井涵虚碧，疏钟入户清。\n荒芜怜夜色，寒溜引秋声。\n丹灶封苔老，芝田积雨平。\n风光齐岳麓，音信接朱明。\n愿将身从此，乘云到玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"古成之","text":"寰中有道逢千载，岭外观光祇一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白马雪涛","author":"古汴高士","text":"层澜叠浪势轰雷，怒雨号风涌雪堆。\n半夜四天云墨黑，恍疑白马闯江来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浔阳古寺","author":"古汴高士","text":"浔阳古寺久荒凉，倒柱颓梁卧夕阳。\n一盏佛灯犹未灭，霁天云淡月华光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炼丹台","author":"古汴高士","text":"洞角丹砂吐锦云，龟毛铅彩瑞氤氲。\n我来收入县胎鼎，炼到洪濛未剖分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源","author":"古汴高士","text":"山前溪是当时水，源上桃非旧日花。\n多是渔郎露消息，洞门从此锁烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渌罗晴昼","author":"古汴高士","text":"第一岩前景若何，江流潋滟漾晴罗。\n游仙道士无萦系，也共白云栖一窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚山春晓","author":"古汴高士","text":"雾散云收宿雨乾，秦桃落尽晓风寒。\n晴山四望天开画，啼鸟一声人倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潼坊晚渡","author":"古汴高士","text":"日落山前水涨时，有人拍掌笑嘻嘻。\n篙师只管需把手，载过神仙不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"古某","text":"仙客有灵千古在，洞门无钥四时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十四","author":"可旻","text":"文墨尖新无处用。\n已将名利浑如梦。\n一串数珠随手弄。\n休千种。\n唯闻念佛心欢勇。\n滉漾空中仙乐动。\n笙箫声细天风送。\n接引凡夫归圣众。\n香云捧。\n男儿此日方崇重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一 赞净土并序","author":"可旻","text":"曾讲弥陀经十遍。\n孤山疏钞频舒卷。\n事理圆融文义显。\n多方便。\n到头只劝生莲苑。\n本性弥陀随体现。\n唯心净土何曾远。\n十万程途从事见。\n休分辨。\n临终但自亲行转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十八","author":"可旻","text":"净土故乡嗟乍别。\n天涯流浪经时节。\n老去染沾眉鬓雪。\n思归切。\n闻声愿寄辽天月。\n念念时时修净业。\n临终佛定来迎接。\n有誓表为诚实说。\n广长舌。\n三千遍覆红莲叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二","author":"可旻","text":"西土纹成东土坏。\n星飞一点千华界。\n勿讶神魂生去快。\n无遮碍。\n乐邦只在同居内。\n八德池深华又大。\n跏趺端坐莲华载。\n耳听法音心悟解。\n低头拜。\n从今跳出胞胎外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十一","author":"可旻","text":"万事到头无益已。\n寻思只有修行是。\n若送此心游宝地。\n还容易。\n坐观落日当西坠。\n万顷红光归眼际。\n眼开眼闭长明媚。\n此观成时知法味。\n心欢喜。\n临终决定生莲里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其八","author":"可旻","text":"为厌娑婆求净土。\n驰情送想存朝暮。\n谁信不劳移一步。\n西方去。\n楼台隐隐云深处。\n珠网为光华作雨。\n金沙布地无尘土。\n怎不教人思去路。\n心专注。\n坐观落日如悬鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其五","author":"可旻","text":"鹦鹉频伽知几只。\n音声和雅鸣朝夕。\n演畅五根并五力。\n令人忆。\n心飞恨不身生翼。\n从是西方十万亿。\n山长水远谁人识。\n唯是观门归路直。\n真消息。\n坐澄劫水琉璃碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十九","author":"可旻","text":"善导可嗟今已往。\n化来老少皆归向。\n佛念一声分一镪。\n声才响。\n一声一佛虚空上。\n八万四千奇妙相。\n光明寿命皆无量。\n金色臂垂千万丈。\n鹅王掌。\n誓来迎接归安养。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其四","author":"可旻","text":"佛赞西方经现在。\n广长舌相三千界。\n为要众生生信解。\n临终迈。\n不修净业犹何待。\n七宝池塘波一派。\n莲华朵朵车轮大。\n华内托生真自在。\n分三辈。\n阿鞞跋致长无退。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十二","author":"可旻","text":"西望乐邦云杳隔。\n一钩新月弯弯白。\n意欲往生何计策。\n劳魂魄。\n弥陀一念声千百。\n金殿玉楼为屋宅。\n七重行树强松柏。\n华里托生非血脉。\n真高格。\n乐天不是蓬莱客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其十五","author":"可旻","text":"休纵心猿驰意马。\n牢将系念绳头把。\n说破十疑因智者。\n争传写。\n庐山又结莲华社。\n十八大贤居会下。\n功成五色云西驾。\n诸上善人都在那。\n相迎迓。\n聚头只说无生话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其六","author":"可旻","text":"清净乐邦吾本郡。\n娑婆流浪因贪吝。\n冉冉思归霜入鬓。\n深嗟恨。\n塞鸿不解传音信。\n落日尽边沙隐隐。\n向西望处归应近。\n天乐是时相接引。\n宜精进。\n紫金台上谁无分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]