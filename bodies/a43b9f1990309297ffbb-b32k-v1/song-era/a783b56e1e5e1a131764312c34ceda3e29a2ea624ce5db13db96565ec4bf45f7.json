[{"title":"丁端叔茶马会同年同庚","author":"袁说友","text":"竹林宾主乐襟期，并榜齐年两见之。\n丙午同生虽共老，甲辰笑我独为雌。\n秋鸿社燕时难值，桂酒椒浆醉莫辞。\n半是天涯老行客，耆英当继洛中诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入山呈孙使君","author":"袁说友","text":"平生懒慢岂能刚，身外微官似漫郎。\n不怪閒居为消渴，何劳多酌本醒狂。\n雪晴欲试穿云履，背冷仍寻曝日床。\n为想骑牛破山碧，晚风吹笛野梅香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入淮","author":"袁说友","text":"桐柏分源远，清流接泗滨。\n于何号边境，不忍问淮民。\n北顾关山在，西风草木新。\n天河如可挽，吾欲洗边尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上官桀诈令人为燕王旦上书言光疑有非常臣愿归符玺宿卫察变上曰朕知是书诈也后桀燕王等谋废立事觉尽诛","author":"袁说友","text":"燕国归符玺，将军有谤书。\n君王嗟诡诈，党与悉趑趄。\n白日中天照，浮云扫地除。\n狂谋身一败，邪骨满丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与副伴王领卫论弈象","author":"袁说友","text":"轻兵三十二，一著见安危。\n疋马渡河日，单车驰敌时。\n棘门漫儿戏，淝水付枰棋。\n小试平戎手，将军更出奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨霁后见月","author":"袁说友","text":"涨水横侵屋，轻舟半宿溪。\n竹风千影乱，帘月一钩低。\n鼠黠欺残照，鸦啼识故栖。\n馀樽才稍稍，薄露已凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞酒于林子长通判","author":"袁说友","text":"衰颜得酒尚能赪，笑我维罍耻弗盈。\n无计青州几从事，可怜白面一书生。\n新篘竞说邻家熟，好句惭无健笔成。\n传语白衣人记取，何须秋帽始关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乡人徐辩道见过自云有升平遗策当挟之西游乞诗祖行聊作一首","author":"袁说友","text":"乡翁初识面，独往定何如。\n客舍风霜急，权门韦布疏。\n北书应有犬，南食尚无鱼。\n身外祇遗策，苍苔空故庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风雷雨","author":"袁说友","text":"雷风一息到山西，攲侧村花不自持。\n际晚甘霖如倒峡，今年香雪可翻匙。\n绿秧蘸脚元非揠，白水齐腰不恨迟。\n浪说随车誇故事，但知忧国愿无饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月","author":"袁说友","text":"皓魄埋云未肯收，佳娥寂寞为谁羞。\n可怜数点不多雨，误却一轮无限秋。\n急扫妖氛天外去，莫教微影暗中流。\n终当永夜清如水，我为停杯便倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日立春","author":"袁说友","text":"春入帘帏线几添，更随桃茢快新瞻。\n晓看密密轻丝堕，晚作纤纤细雨兼。\n可喜田家馀谷粟，也应泽国饱鱼盐。\n年丰更乐弦歌化，知是曹装渐趣严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日得雨","author":"袁说友","text":"知时膏泽下新正，便觉欣欣物意生。\n细雨寒梢半檐滴，单床孤梦五更声。\n两年元日嗟萍梗，万里殊乡付酒觥。\n不似斗杓容易转，只今迎岁指东城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午阴小饮","author":"袁说友","text":"草树涧边青，人稀自掩扃。\n阴沈端午水，晴映半天星。\n倦枕敷横榻，枯藜傍小亭。\n谁知一杯酒，小醉不嫌醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午晴观孔雀","author":"袁说友","text":"异雀逢人正美观，一鸣晴日傍栏干。\n昂头未展云霄翼，掉尾先摇锦绣盘。\n危坐我方诗兴切，薄寒谁伴酒肠宽。\n世间最是羁怀恶，犹得亭花著意看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卞山石林","author":"袁说友","text":"物是人非旧，堂空语不应。\n千重云夭矫，百态玉崚嶒。\n断壁苔封径，悬岩树挂藤。\n支颐重觅日，犹记昔年曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双溪亭","author":"袁说友","text":"源委萦苕霅，乾坤接水云。\n半天孤月照，两派一溪分。\n日落虹垂影，鱼翻縠断纹。\n烟波岂无义，泾渭固难群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天宁寺有白石曰卞山脚石上多名公题识","author":"袁说友","text":"隐隐来岗续，沈沈土脉萦。\n一峰庭下立，十里地中行。\n石脚犹依佛，山腰恰近城。\n摩挲嗟岁月，风雨几题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文帝议以贾谊任公卿绛灌冯敬等害之乃毁谊曰洛阳年少擅权于是天子疏之以谊为长沙王太傅","author":"袁说友","text":"诸老谗言入，长沙远地留。\n一闻天子议，众嫉少年谋。\n自堕奸谀术，谁宽痛哭忧。\n至今言绛灌，犹为孔门羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文帝登虎圈问尉禽兽簿不能对虎圈啬夫对甚悉上拜啬夫为上林令张释之曰今以口辨超迁恐天下争口辨无实遂不拜","author":"袁说友","text":"辨舌机锋锐，言簧巧意倾。\n一闻贤者议，众鄙啬夫名。\n利口宜深戒，违颜愿力争。\n须知玄默化，帝已久躬行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斗茶","author":"袁说友","text":"截玉誇私斗，烹泉测嫩汤。\n稍堪肤寸舌，一洗苋藜肠。\n千枕消魔障，春芽敌剑铓。\n年年较新品，身老玉瓯尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日华书自通州来言其同僚多唱酬","author":"袁说友","text":"题舆赢得锦囊归，酬唱西昆事可追。\n久不陪君三日语，政须咽子百篇诗。\n宁甘咄咄痴儿事，稍愧纷纷俗吏为。\n我亦湖山多暇日，秋蝉时解噪寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水竹","author":"袁说友","text":"拳石环清泚，龙须细屈蟠。\n两峰低峍崒，一簇小琅玕。\n密叶风前影，疏枝水底寒。\n相从此君尔，著意问平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水西叶氏园","author":"袁说友","text":"风月欲在眼，园林须傍家。\n崚嶒飞翠巘，飐滟舞绡花。\n门近山光入，堂深树影斜。\n犹将小西景，更为石林誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王氏山居","author":"袁说友","text":"豆粥通幽径，松杉蔽野门。\n眼空楼外碧，身落洞前村。\n荷静风岩晓，梅开雪月昏。\n环山书未捲，林薄鸟声喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"车驾过重华宫和陈止斋韵","author":"袁说友","text":"晓到觚棱簇仗齐，千官星拱马无嘶。\n清尘警跸来宫阙，夹道欢声浃耄倪。\n孝治未应誇郑隧，皇威今已竦边鼙。\n小臣何以扬君德，手舞相呼醉月溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出东城观水","author":"袁说友","text":"浩荡东城外，微茫病眼开。\n烟帆一鸟过，云插乱峰堆。\n绿水漫漫去，青山衮衮来。\n飞边双鹭没，天末晚风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园","author":"袁说友","text":"菡萏暑风晓，芙蕖秋露时。\n青山无限好，明月故相宜。\n雨长穿城竹，湖深隔岸池。\n春堂夜留客，举首问南箕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古镜","author":"袁说友","text":"老眼羞看镜，华颠怯半霜。\n栖迟勋业晚，孤负岁年长。\n月透光深杳，花摇影颉颃。\n衣冠从尔正，不趁晓来妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司庾会稽道中答衢民綵帜送行","author":"袁说友","text":"征车何事不容征，綵旆歌谣塞路津。\n徒以平生多拙政，偶于岁晚得衢民。\n我方州县惭尸禄，汝向闾阎切爱身。\n料得去思均彼此，一诗聊复慰邦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月雨应祷","author":"袁说友","text":"夜半溶溶四面遮，云峰推起阿香车。\n只今陇上誇多麦，谁为丘中赋有麻。\n喜见绿针初剌水，笑渠青笠趁烧畬。\n偶然精祷诚非昧，应有欢娱田舍家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归自郊外遇雪","author":"袁说友","text":"细雨初收脚，飞来已溅身。\n固应宜瑞雪，未必困行人。\n酒里寒犹重，吟边语未新。\n更怜渠白叟，呵手诉车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归舟遇大风雨","author":"袁说友","text":"客里才三日，归来仅一程。\n片云天外立，短棹雨中行。\n小却黄昏路，犹须半夜晴。\n春光又零落，游子不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘棠桥","author":"袁说友","text":"波入南溪绿，荷薰夹岸香。\n一川虹倒影，百步带横塘。\n舟榜桥边柳，鱼惊月下榔。\n人亡遗爱远，谁复赋甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用刘汀洲左顾亭韵","author":"袁说友","text":"杖屦东风欲滥巾，小舟重泊一亭春。\n醉看梅月无新语，老与溪山作故人。\n意气不惊双白鬓，功名忍负百年身。\n我来又续题诗柱，敬为刘郎细拂尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用吴知立韵","author":"袁说友","text":"老去胸中句甚豪，清风应笑我徒劳。\n可怜官事何时了，肯使诗盟取次逃。\n剩欲论交思击节，不妨饮德要投醪。\n如君岂是长贫者，自古诗成得绣袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用陈和父太博韵题江州高远亭四首 其四","author":"袁说友","text":"久说匡庐喜暂经，遐观但觉眼青青。\n倚栏万事双颓鬓，抚掌千年一古亭。\n珠玉名章方竞赋，江山喜色已先形。\n我来落笔真如助，撩得诗狂不为醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用陈和父太博韵题江州高远亭四首 其三","author":"袁说友","text":"浔阳名郡敢言支，最爱江山左右之。\n松盖前倾浑似故，诗兵捷出愈称奇。\n案头朱墨无多事，亭面东风足四时。\n相与平分剩遗爱，未饶白傅去时思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用陈和父太博韵题江州高远亭四首 其二","author":"袁说友","text":"亭高未涉意先申，五马同来却报春。\n一笑孰知今在旅，兹游端不厌居尘。\n分张好景因人重，排拶佳篇逐日新。\n我是东州西上客，也来吟作社中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用陈和父太博韵题江州高远亭四首 其一","author":"袁说友","text":"鲜新栋宇出楼颠，尽得江山四面全。\n高摘星辰风月夜，远迷河岳水云天。\n一湖尚想甘棠爱，万井谁呼大隐廛。\n见说松关频却扫，两贤吟处日回旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白雪堂","author":"袁说友","text":"今代斯文只此翁，乾旋坤转独孤忠。\n千年此地江山里，一日东坡翰墨中。\n莫起黄泉空老泪，可怜赤壁几春风。\n潇潇暮雨双双竹，白雪堂前忍酹公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石上玉簪花","author":"袁说友","text":"根齧棱棱石，香衔寸寸心。\n误人猜落蕊，眩眼拾遗簪。\n掬水滋繁种，柔枝倚短岑。\n清姿浮玉润，不受暗尘侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日雪","author":"袁说友","text":"料理风光兴未残，老无诗手一何悭。\n新传綵胜排枝上，趁得冰花落鬓间。\n噪雀晓来埋屋角，土牛声已动谯关。\n寒窗我欲觞眉寿，不是羊羔醉玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训子","author":"袁说友","text":"投老寻三窟，传家只一经。\n呼儿亲料理，开卷熟叮咛。\n我已头居白，谁堪芥拾青。\n颇怀兰与玉，长忆谢家庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会文堂","author":"袁说友","text":"束带峨冠集会文，郡侯著语到诸君。\n平居讲习须朋友，退食工夫在典坟。\n士学何先先尚志，书生务业业惟勤。\n鹍鹏他日扶摇上，共致云霄庆策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会新第进士和陈振享韵","author":"袁说友","text":"梧桐风细月将楼，犹得公馀款俊游。\n喜入芳樽凉彻夜，风生绮席气横秋。\n两魁前躅高三辅，八隽飞觞照一州。\n屈指吴门多盛事，眼看勋业佐宸旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴化吴宰商卿来书","author":"袁说友","text":"百里报消息，一缄劳寄驰。\n但知怀旧切，犹恨得书迟。\n儒者可言政，怀邦当易为。\n问君安否外，别后几篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋","author":"袁说友","text":"飘然击楫问中流，仗节观风十四州。\n见说九重天语好，不妨万里蜀山游。\n大书竞照光山色，好句应题滟滪头。\n稍办澄清早归去，周南宁复叹淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘德修殿院持节归蜀","author":"袁说友","text":"堂堂柏府几人过，屈指精忠竟若何。\n正尔浮云遮白日，赖公砥柱立颓波。\n回天力挽千钧重，去国身轻一叶多。\n万里长江向东去，清明无日可镌磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同子隆次公小饮","author":"袁说友","text":"老境昏昏只醉眠，不知门外艳阳天。\n奚为有客携壶至，又以閒人到酒边。\n山路试登桃映日，溪城一望草如烟。\n春分花事今多少，未觉心情胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同张元善集癸未同年","author":"袁说友","text":"同年几合几分违，三十年间见日稀。\n尊酒相逢今也幸，诗书论政旧焉依。\n慈恩故事嗟回首，吴地清谈对落晖。\n平世功臣在公等，尚期努力佐龙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同周可大莫子章同游證通寺","author":"袁说友","text":"好友频相过，閒愁一笑忘。\n逶迤萧寺径，淡薄老僧房。\n饱饭溪山足，空门日月长。\n归来怀妙语，心地转清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同莫子章方舟下龟溪","author":"袁说友","text":"一舸相从下碧澜，城南百里话更残。\n绝知未减在家好，政自不愁行路难。\n舒望最堪诗眼纵，忘形只觉酒肠宽。\n归来颇讶山头黑，果是西风一夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同鄂州都统制司登压云亭","author":"袁说友","text":"一带城头四望全，压云亭上更无边。\n手攀北斗轻飞肉，目盼南楼仅及肩。\n城郭千年高复下，江湖万里后还先。\n平生颇负昂霄志，便欲乘风送上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守郡不能同宪使仓使游灵岩","author":"袁说友","text":"秋风敲叶漾湖光，两两星华古寺傍。\n晓日一川迎使节，晚山十里送归艎。\n风流我已非山简，宾客公应念葛彊。\n岂是清游本无分，纷纷雁鹜苦相妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成都府学释奠","author":"袁说友","text":"西风淅淅露漙漙，释菜雍容礼可观。\n冠带三千严鹄立，风云九万欲鹏抟。\n锦江曾吐胸中凤，泮水新回笔下澜。\n拭目诸君快秋捷，胪传高压万人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成都府鹿鸣宴","author":"袁说友","text":"大启文明会胜流，同升更合上西楼。\n三春得意桃花浪，八月乘槎桂子秋。\n结绶偏应登凤阙，拿云直欲钓鳌头。\n乘除但看今年好，六八名高五十州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"袁说友","text":"万事缘憎爱，孤衷只惷愚。\n归与乖俗好，老矣误时须。\n举世冲霄鹄，何人滥吹竽。\n穷通一不问，无复鬼揶揄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次常熟县先君旧所摄宰也","author":"袁说友","text":"冲寒一舸下琴川，小缆依依市柳边。\n花县重来听好语，棠阴深处不论年。\n钓游颇忆儿童旧，风物徒惊岁月迁。\n老恐不任奔走力，问侬何日赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行得水仙花","author":"袁说友","text":"彻底清姿秀可餐，柔枝不怯胆瓶寒。\n三星细滴黄金盏，六出分成白玉盘。\n是物合陪仙子供，何人遣傍客舟看。\n山矾似俗梅偏瘦，别与诗人较二难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯花","author":"袁说友","text":"一点寒釭照，楼头夜鼓挝。\n报人初缀玉，戏我只空花。\n身已遗荣辱，灯应误逞誇。\n焚膏畴昔事，墙角几檠斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自常熟敲冰行舟半日一夜仅十里","author":"袁说友","text":"到晓才通十里冰，颇怜黄帽叹征行。\n半篙不下风霜夜，一日之间水陆程。\n无复稳时村路滑，不胜危处断桥倾。\n驱驰原隰皇华事，筋力犹堪誓此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中怀稚子","author":"袁说友","text":"远浦三更月，春风一夜程。\n平生惯安静，多病怯征行。\n急橹誇先后，连山护送迎。\n关心小儿女，幽梦落东城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中酒味酸许深父漕使以家酿来亦不欲受","author":"袁说友","text":"樽酒称台馈，牢辞以例陈。\n独醒心已醉，不饮意如春。\n凝望嗟陶令，誇醒笑伯伦。\n兼金有前训，寄谢白衣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟发黄州连日遇逆风泊赤壁","author":"袁说友","text":"赤壁矶方到，黄州路未遥。\n辛勤四十里，跋涉两三朝。\n戢戢牛羊下，閒閒鸥鹭骄。\n忍将今岁月，容易客中销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行邂逅别吴子明郎中","author":"袁说友","text":"杜宇催归急，青山送客忙。\n去帆辞断港，过眼接危樯。\n亲戚五年别，尊罍一笑长。\n山西堕残照，不忍酹离觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]