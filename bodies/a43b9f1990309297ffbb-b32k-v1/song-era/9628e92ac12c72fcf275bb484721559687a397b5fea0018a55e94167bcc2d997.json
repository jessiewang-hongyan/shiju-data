[{"title":"次韵徐庭珍春日杂言十首 其七","author":"陈棣","text":"卉木争供众妙薰，春工试手为裁成。\n纷纷落蕊莺边雨，寂寂游丝燕外晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐庭珍春日杂言十首 其六","author":"陈棣","text":"沉酣蠹简不知春，庭设雀罗谁扣门。\n拄颊看山无限意，阴晴变态异朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐庭珍春日杂言十首 其五","author":"陈棣","text":"轻阴酝酿勒花天，节物撩人接禁烟。\n沂上未成曾点服，杖头聊挂阮生钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐庭珍春日杂言十首 其四","author":"陈棣","text":"扰扰胶胶且罢休，会栽奴橘满汀洲。\n但教方寸无馀事，不必林泉学枕流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐庭珍春日杂言十首 其三","author":"陈棣","text":"燕雀经营竞短檐，未容蝶梦到花前。\n吾生几阅春荣谢，自叹如蚕已再眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐庭珍春日杂言十首 其二","author":"陈棣","text":"身如不系一虚舟，入眼江山总旧游。\n视昔视今俱勿论，且凭从事到青州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐庭珍春日杂言十首 其一","author":"陈棣","text":"溪风袅袅素涛翻，兀坐书帷怯悄寒。\n老去见春如梦寐，此心底用倩人安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过冯公岭","author":"陈棣","text":"整促篮舆破晓晴，岚光滴翠夹衣轻。\n日窥青嶂坳中出，身在白云深处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李倅生辰三首 其三","author":"陈棣","text":"文章浩浩若江河，锦橐嘲吟得句多。\n政恐丝纶须大手，伫看三俊在銮坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李倅生辰三首 其二","author":"陈棣","text":"心览冲虚厌物波，樽前肯听雪儿歌。\n能捐伐性婵娟斧，不必樛枝号养和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李倅生辰三首 其一","author":"陈棣","text":"伯阳飞御上层天，继世云礽尽谪仙。\n炯炯方瞳真寿相，不劳颂祝自长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈公藻觅笋仍许作包子","author":"陈棣","text":"玉版禅师来应供，锦绷稚子敢分珍。\n并包更藉桄榔屑，风味悬知定可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂饷郑舜举戏笔代柬 其二","author":"陈棣","text":"折得天葩满袖香，小窗寂寂伴凄凉。\n何如乞与文园客，瑶髻斜簪试晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂饷郑舜举戏笔代柬 其一","author":"陈棣","text":"天香薰透辟寒金，拂拂鹅黄汉额深。\n多谢西风唤幽梦，径随秋蝶到疏林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽奉议刘公度四首 其四","author":"陈棣","text":"挂冠神武赋归欤，旋捧恩纶赐佩鱼。\n谁谓桑榆将暮景，骈来庆事萃门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽奉议刘公度四首 其三","author":"陈棣","text":"风鉴高明世少双，衮荣挞辱擅雌黄。\n须知柱下书言手，元是东床坦腹郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽奉议刘公度四首 其二","author":"陈棣","text":"平生学术在斯民，蕴积渊源百未伸。\n边障掾曹聊小试，一城惠爱已如春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽奉议刘公度四首 其一","author":"陈棣","text":"英誉当年蔼上庠，谈经肯羡解颐匡。\n才高不第空嗟惜，一命聊为末路光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春道中四首 其四","author":"陈棣","text":"芍药无香燕有雏，绵蛮犹苦劝提壶。\n直须强作留春计，烂醉黄公旧酒垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春道中四首 其三","author":"陈棣","text":"纤秾扫尽换清阴，便有南风欲荐琴。\n漫道仙葩归阆苑，小儿造化本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春道中四首 其二","author":"陈棣","text":"归涂检点物华非，黛色随风上柳枝。\n扑扑晴香恋芳草，却疑春去未多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春道中四首 其一","author":"陈棣","text":"簿书丛里掣归身，万树毵毵浅绿匀。\n试向小园寻落蕊，慇勤拂拭觅馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅三绝 其一","author":"陈棣","text":"蜂采群芳酿蜜房，酿成犹作百花香。\n化工却取蜂房蜡，剪出寒梢色正黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅三绝 其三","author":"陈棣","text":"寒菊已枯分正色，春兰未秀借幽香。\n凭君折取簪霜鬓，解与眉间一样黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅三绝 其二","author":"陈棣","text":"林下虽无倾国艳，枝头疑有返魂香。\n新妆未肯随时改，犹是当年汉额黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次韵冯文度春晚二首 其二","author":"陈棣","text":"春到穷檐分外和，典衣日日饮无何。\n未陪蜡屐寻幽乐，已觉诗囊得句多。\n颇喜醉乡无畔岸，从教平地有风波。\n脱巾露顶君休问，倦客尘冠底用峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次韵冯文度春晚二首 其一","author":"陈棣","text":"花梢疏雨下巫阳，酒面新鹅拂嫩黄。\n老去光阴春苦短，閒中气味日偏长。\n方塘水满丙鳞跃，故垒泥空乙羽忙。\n剩作篇章酬节物，忍令相背去堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上梁尚书生辰 其三","author":"陈棣","text":"上苑春光一夜回，和羹消息报江梅。\n促装旧事追曹相，折桂新荣付老莱。\n千里颂声形鼓吹，万家和气入樽罍。\n明年此日趋黄阁，待看传宣押赐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上梁尚书生辰 其一","author":"陈棣","text":"破晓霜晴快活天，少微光彩焕台躔。\n来从紫府飞仙窟，生作皇家间世贤。\n勋业定应铭鼎鼐，仪容端合珥貂蝉。\n外家旧事今重睹，又致升平五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上梁尚书生辰 其二","author":"陈棣","text":"一麾卧治镇江边，芳草还应梦惠连。\n十载从班联玉笋，六城课最用蒲鞭。\n依刘曾识尚书履，借寇难私刺史天。\n共徯公归缘底事，嗷嗷四海望陶甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上湖","author":"陈棣","text":"舟车出阛阓，暂觉脱樊笼。\n松荫凄迷日，荷香澹沱风。\n凌晨争迅急，向晚却和融。\n貌取君诗句，方知物象同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"陈棣","text":"斥鴳蒿蓬足，鲲鹏谩北溟。\n馀生薰白业，内景练黄庭。\n大白蚁浮绿，短檠灯闪青。\n欲知陶令趣，应向醉中醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王有之见和复用韵二首 其二","author":"陈棣","text":"小雨冥冥暗市楼，无聊一日似三秋。\n穷愁顾我堆千斛，健笔期君回万牛。\n语怪未应书咄咄，身閒底用赋休休。\n晓来春到西窗外，唤梦一声黄栗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王有之见和复用韵二首 其一","author":"陈棣","text":"年来慵堕畏多愁，怕见群才得意秋。\n题柱敢期乘驷马，隐廛端欲舍蜗牛。\n既成春服聊歌咏，拟赋閒情且罢休。\n漫道无心关节物，杖藜时为好山留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上时相生辰 其二","author":"陈棣","text":"中兴事业耀无前，明圣相逢运半千。\n尽纳有生归礼乐，全提鸿化入陶甄。\n八风自转成天籁，五纬更调祚有年。\n体物形容劳颂笔，浪云无象岂其然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上时相生辰 其三","author":"陈棣","text":"春光先向陇梅归，正值崧神降岳时。\n孕秀直疑天地相，输忠唯许冕旒知。\n八珍锡燕宫厨送，百两传宣使驿驰。\n盛事逖闻千载后，鲁公綵服效儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上时相生辰 其一","author":"陈棣","text":"国论盈庭正尚同，唯公英略与天通。\n一丝不断千钧重，九鼎重安万世功。\n独见夐超流俗外，先机端在笑谈中。\n际高极厚知难报，愿辅熙朝到不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代上时相生辰 其四","author":"陈棣","text":"武定文明过十秋，光芒无复见旄头。\n身更万变心方壮，位极千官宠更优。\n贺厦阻趋丞相閤，分符假守子陵州。\n长生不老何须祝，元是丹台第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古刹","author":"陈棣","text":"古刹嚣尘外，浮图屋角西。\n残缁犹赞仰，孳羽共依栖。\n清影芜城远，孤棱落照低。\n丹梯傥容蹑，极目饱双溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永嘉旅中","author":"陈棣","text":"小雨凄风酿早寒，行厨萧索酒壶乾。\n抄书时自嗫嚅语，把菊谁同仔细看。\n收拾梦魂归枕上，扫除愁思寄毫端。\n家山只在一帆外，望隔烟峦漫倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用韵戏赵贯道买妾并呈郑舜举王有之二丈","author":"陈棣","text":"碧玉双簪两髻丫，满怀春恨正萌芽。\n停桡空对无情水，倚槛谁邻解语花。\n蚤与幽闺深领略，毋令狂客浪矜誇。\n须知三昧非凡手，北苑知名第一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子岁除一夕梦与先子论诗有云未能免俗犹听谶无计为生只送穷此吾顷年诗也汝亦得之否某曰已在家集中既觉泣书二章 其二","author":"陈棣","text":"昔年浩气许谁攀，诗礼趋庭侍燕閒。\n但喜新阳更旧律，岂知斑鬓改朱颜。\n时挑短烬倾蕉叶，独拥寒烬炷博山。\n不见诗翁送穷处，空留膏馥在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲子岁除一夕梦与先子论诗有云未能免俗犹听谶无计为生只送穷此吾顷年诗也汝亦得之否某曰已在家集中既觉泣书二章 其一","author":"陈棣","text":"惊风急雪不胜寒，苇索桃符岁事残。\n里巷杯盘喧半夜，儿童灯火守更阑。\n年催老色归须鬓，诗引穷愁入肺肝。\n无复斑衣颂椒柏，只将泪血洒毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白菊","author":"陈棣","text":"千芳百卉正凋零，喜见东篱粲玉英。\n粉面真能延月姊，檀心端不羡梅兄。\n骚经岂为黄花作，丹鼎应须素液成。\n勿讶开迟后佳节，白衣犹足向渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日有感","author":"陈棣","text":"剪綵漫添怀抱恶，簪花空映鬓毛秋。\n流年旧事陈刍狗，佳节新春报土牛。\n里社浮沉贫可忍，身名坎壈老宜休。\n天高难问平生意，已矣冥心任去留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"艾以诸公雌黄其诗意殊不平戏用前韵","author":"陈棣","text":"载味君诗字字新，方知后实称先声。\n文章素号五经笥，姓字行添千佛名。\n赵璧有瑕虚指示，随珠无价妄讥评。\n官閒聊戏管城颖，小草银钩乱伯英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵三首 其三","author":"陈棣","text":"陶冶无心瓮与盆，等閒妍窳意难论。\n年光未易留驹隙，世事唯堪隐鹿门。\n久客思家华发满，小儒忧国赤心存。\n江山还有新亭叹，痛惜伊川化陆浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵三首 其二","author":"陈棣","text":"堕地何劳顾甑盆，事同电往不堪论。\n归休我愿白驹谷，登用君宜金马门。\n气习肯随流俗变，笑谈如见古人存。\n词源清彻如甘井，愈汲方知愈不浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵三首 其一","author":"陈棣","text":"刺头底事向胶盆，沉湎应从通率论。\n人世百年都是梦，醉乡四达总无门。\n颠狂自索形骸外，酣适宁知礼法存。\n日饮亡何真得计，袁丝由此脱全浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其一","author":"陈棣","text":"畏途忧患饱相谙，火芋何当问懒残。\n每觉愁来诗思苦，更因老去壮心阑。\n年光背我捐鸡肋，世事甜人嗜马肝。\n拨尽寒炉残漏永，已知春驭到林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其一","author":"陈棣","text":"小圃香初足，枯池水乍通。\n捲帘延旧燕，扫径衬飞红。\n寂寂梨花雨，斜斜柳带风。\n东君有馀思，别在一壶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其三","author":"陈棣","text":"老去欢情少，逢人强自誇。\n閒愁付蕉叶，衰鬓耻菱花。\n倚杖閒扪虱，临池戏咏蛙。\n深惭诗律细，何以世吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵 其二","author":"陈棣","text":"雨过滩声急，无风亦自波。\n花稠春意闹，山远月明多。\n地僻无来辙，门閒欲设罗。\n胸中元礧磈，诗酒漫揩磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再过绣川驿","author":"陈棣","text":"霜林病叶日凋残，更觉平芜眼界宽。\n天外碧云山共远，阶前明月水争寒。\n愔愔夜气侵肌骨，戢戢诗愁入肺肝。\n欲去自怜心未惬，为君满意更重看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏效连珠叠韵体","author":"陈棣","text":"溯流迟涩须流轻，石岸崎岖沙岸平。\n高树影藏低树影，前滩声掩后滩声。\n飞禽飞去语禽语，归客归休行客行。\n望断谁怜魂欲断，诗成转觉梦难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏德秀几道","author":"陈棣","text":"小槛新篁脱箨初，依然数轴壁间书。\n已无尘落清声外，空有香分素手馀。\n古狱冤销神剑去，高堂梦破晓云疏。\n圜扉只掩青青草，门外应无长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题酒肆","author":"陈棣","text":"一气无私万物春，小儿造化果能神。\n鸟啼花发遽如许，酒病诗狂那厌频。\n倒著敢期山简醉，典衣谁计少陵贫。\n上林五祚他年赋，姑作临邛涤器人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵几道玉泉小集时公藻以病仆以沿檄不与","author":"陈棣","text":"激水聊充一笑嬉，扁舟西子想当时。\n应怜波底无双鲤，直恐樽前有鸒斯。\n笑我独将愁酝酿，闻君长苦酒禁持。\n山中异日寻遗事，徒见吾家伯仲诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马仲元推官贺五马喜雨","author":"陈棣","text":"甘澍随车未足贤，商霖小试涨晴川。\n溶溶旧绿低蝉柳，聒聒新流响露田。\n刈熟腰镰争满载，叩门乞粟不论钱。\n老农岂但歌襦裤，尽道今年胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王有之主簿 其二","author":"陈棣","text":"蓬生敢望直如麻，才思真同焦谷芽。\n拥被苦吟声踯躅，盈编细札眼空花。\n羡君得意方豪纵，顾我无知绝诞誇。\n输与能诗王主簿，惊人句法自名家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王有之主簿 其一","author":"陈棣","text":"春归满目尽桑麻，岸柳敷阴荻有芽。\n急景岂容留石火，馀香何处认空花。\n曲眉持酒真成梦，纤手分茶亦浪誇。\n欲醉流霞烹瑞雪，直须同谒五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶秀实县治环翠亭 其一","author":"陈棣","text":"亭高望远破天悭，万叠晴岚俯仰间。\n着屐好追灵运逸，垂帘尤爱恺之閒。\n诗豪会见挥银笔，酒圣端能倒玉山。\n杖履欲归聊徙倚，栖鸦寒带暝烟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶秀实县治环翠亭 其二","author":"陈棣","text":"合缀严宸玉笋班，尚劳小试簿书间。\n溟鲲未击三千里，天骥终归十二闲。\n望气行看求利剑，知音当已识高山。\n逼人富贵君宁免，未许山阴兴尽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶秀实县治环翠亭 其三","author":"陈棣","text":"畏途踪迹几间关，浩气空存天地间。\n沈湎恨无千日醉，浪游赢得半生閒。\n观书尚喜眼如月，搜句谁怜肩耸山。\n三径晓来添逸兴，柳梢桃色报春还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵艾慎机县庠蕉花","author":"陈棣","text":"蕉心擢秀占文庭，润沃偏宜雨露声。\n已向杏坛新表瑞，莫嫌花谱旧无名。\n决科此日先幽谶，记异他年见史评。\n况有能诗贤令尹，直将美事付群英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘伯瑞觅酒","author":"陈棣","text":"贫病相仍坐拙方，敢将斗酒博西凉。\n自怜里巷栖迟久，倍觉樽罍气味长。\n玉斝交飞君有约，红裙共醉我何尝。\n一樽聊慰相如渴，要听歌声过女墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘敷言新雁","author":"陈棣","text":"倦飞聊复下江湖，此去衡阳万里馀。\n阵合鱼丽司马法，字排草圣右军书。\n随阳度塞身良苦，避缴衔芦计已疏。\n一抹参差无乱序，似闻衙鼓列群胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李元老柬王令周簿喜雨 其一","author":"陈棣","text":"阿香破旱用功深，更遣新凉入素襟。\n曝日已通贤令意，望霓聊慰野人心。\n水添浅濑征帆稳，云掩残阳古树阴。\n洗眼看君调燮手，一同先已荷商霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]