[{"title":"春晚园中作","author":"陆游","text":"杏子青青梅子酸，山园转眼又春残。\n老怀岂复少年乐，病骨不禁清晓寒。\n学术背时甘义堕，功名无路久心阑。\n蚕收麦熟吾何恨，但遣银杯似海宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚坐睡忽梦泛舟饮酒乐甚既觉怅然有赋","author":"陆游","text":"梦泛扁舟逸兴多，画桡摇荡曲生波。\n微风蔌蔌生蒲苇，小雨霏霏湿芰荷。\n舞落乌纱从岁去，歌酣白纻奈情何。\n年来惟觉华胥乐，莫遣茶瓯战睡魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚村居","author":"陆游","text":"一事元无可得忙，悠然半醉倚胡床。\n牡丹枝上青春老，燕子声中白日长。\n身世已如风六鹢，文章仍似闰黄杨。\n太平有象无人识，南陌东阡捣麨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚泛湖归偶赋","author":"陆游","text":"十日雨晴湖水深，暖催新绿上横林。\n分泥海燕穿花径，带犊吴牛傍柳阴。\n夏近渐低游舫价，日斜殊费寺楼吟。\n归来支枕还无事，一缕微烟看水沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚闲步门外","author":"陆游","text":"病退扶行力尚微，悠然随意出荆扉。\n蜂贪酿蜜争花去，燕喜分泥傍水飞。\n午渴坼瓶尝煮酒，晴暄开笥换单衣。\n踌躇已久归犹懒，更向溪头坐钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚苦雨","author":"陆游","text":"垂老卧村墅，馀寒欺病身。\n鸡犹未忘旦，雨欲不容春。\n忽忽花时过，茫茫草色匀。\n莼丝已上市，一饭未伤贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚雨中作","author":"陆游","text":"冉冉流年不贷人，东园青杏又尝新。\n方书无药医治老，风雨何心断送春。\n乐事久归孤枕梦，酒痕空伴素衣尘。\n畏途回首涛澜恶，赖有云山著此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春望","author":"陆游","text":"天地回春律，山川扫积阴。\n波光迎日动，柳色向人深。\n沾洒忧时泪，飞腾灭虏心。\n人扶上危榭，未废一长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春欲尽天气始佳作诗自娱","author":"陆游","text":"浮云飞尽见青天，拄杖闲拈瘦倚肩。\n渐喜绿秧分䆉稏，又看画柱坼鞦韆。\n鸡豚杂遝祈蚕社，鼓笛喧哗竞渡船。\n惟有此翁无一事，闭门赢得日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"陆游","text":"冉冉年华过上元，梅花如雪照江村。\n云归翠窦初收雨，人怕清寒懒出门。\n香烬已残炉未冷，客谈方剧酒重温。\n尚嫌尘境妨幽致，过埭船声暮正喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"陆游","text":"渔艇水流去，柴门风自开。\n馀寒为醉地，多病作慵媒。\n莎草锄还出，鸥群去复来。\n流年殊衮衮，残鬓不禁催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"陆游","text":"故岁无多雪，新春乃尔寒。\n柴车归里社，茅舍老江干。\n客熟沽醨啜，孙痴索饭抟。\n更怜菘芥长，殊胜仰园官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒连日不出","author":"陆游","text":"海棠花入燕泥乾，梅子枝头已带酸。\n老去懒寻年少梦，春分不减社前寒。\n著书敢望垂千载，嗜酒犹须隐一官。\n正是闲时无客过，小庭斜日倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴","author":"陆游","text":"一庭舞絮斗身轻，百尺游丝弄午晴。\n静喜香烟萦曲几，卧惊玉子落纹枰。\n新春易失遽如许，薄宦忘归何似生。\n安得一船东下峡，江南江北听莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴","author":"陆游","text":"春如人易老，愁与漏俱长。\n酒著多思睡，花熏直欲狂。\n新晴乾蝶翅，微暖滑莺吭。\n谁见龟堂叟，支藤送夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴","author":"陆游","text":"南陌争牛事已非，綵山又近放灯期。\n风和已染柳千缕，山冷未开茶一旗。\n酒病况当人别后，春光偏在雪晴时。\n道傍笑我清狂在，马上看山细咏诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴二首 其二","author":"陆游","text":"常年春日少春晴，拂面今朝暖吹轻。\n水阁家家横小舫，园亭处处听新莺。\n桃花不管诗人老，菖叶空催野叟耕。\n自笑此生馀几许，铜驼荆棘尚关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴二首 其一","author":"陆游","text":"雨断云归两作晴，夕阳鼓角动高城。\n客愁正得酒排去，草色直疑烟染成。\n莺为风和初命友，鸥缘水长欲寻盟。\n不须苦问春深浅，陌上吹箫已卖饧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴","author":"陆游","text":"柳未吹绵笋未抽，春郊风日正清柔。\n疏疏帘影供高卧，袅袅舆竿懒出游。\n无客共谋良夜醉，有花空动故年愁。\n云生祇恐还成雨，自向园头听鹁鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴出游","author":"陆游","text":"芳树参差叶已成，园林随处听莺声。\n游人正乐还兴叹，造物无心却有情。\n糁径落红犹可藉，涨溪分绿已堪耕。\n兰亭禹庙年年好，剩伴乡邻醉太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴自云门归三山","author":"陆游","text":"乍行春野眼增明，渐减春衣体倍轻。\n人卖山茶先谷雨，鸦随墦祭过清明。\n柳塘水满双凫戏，稻陇泥深一犊行。\n晚到三桥泛舟去，掩关不复畏重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴泛舟","author":"陆游","text":"儿童莫笑是陈人，湖海春回发兴新。\n雷动风行惊蛰户，天开地辟转鸿钧。\n鳞鳞江色涨石黛，袅袅柳丝摇曲尘。\n欲上兰亭却回棹，笑谈终觉愧清真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴泛湖入城","author":"陆游","text":"春色初回杜若洲，隔烟时见矫轻鸥。\n嵩云缑月年年梦，楚柁吴樯处处愁。\n鱼跃银刀论网买，酒倾绿蚁满杯浮。\n前生杜牧吾身是，又向江南遍倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴登小台","author":"陆游","text":"不管筇枝破绿苔，闲穿万竹上荒台。\n幽花经雨自开落，啼鸟喜晴时去来。\n河岸家家装彩舫，儿曹处处唱青梅。\n谁家老子痴顽甚，看改新元十一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴暄甚游西市施家园","author":"陆游","text":"税驾名园半日留，游丝飞蝶晚悠悠。\n骤暄不为海棠计，长昼只添鹦鹉愁。\n老去自惊诗酒减，客中偏觉岁时遒。\n东风好为吹归梦，著我松江弄钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游二首 其一","author":"陆游","text":"杏花天气喜新晴，白首书生乐太平。\n小陌鞦韆虽隔世，名园祓禊尚关情。\n山林自古流觞地，弦管谁家送酒声。\n莼菜鲚鱼初满市，莫将羊酪敌南烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游","author":"陆游","text":"春风堤上草萋萋，草软沙平护马蹄。\n似盖微云才障日，如丝细雨不成泥。\n千秋观里逢新燕，九里山前听午鸡。\n追忆旧游愁满眼，綵船曾系画桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游二首 其二","author":"陆游","text":"穷愁终日竟胡为，老健人间自一奇。\n每驾柴车游古寺，间骑竹马伴群儿。\n登临兰渚流觞地，萧散狐泉冷饼时。\n綀布单衣白羽扇，路傍人总道相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游","author":"陆游","text":"梅市移舟过古城，此行亦未阙逢迎。\n负薪野老无妻子，施药山人隐姓名。\n风雨偏宜宿茅店，盐醯不遣到藜羹。\n宣和版籍今谁在，似是天教乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春感","author":"陆游","text":"老厌纷纷懒入城，长亭小市近清明。\n陇头下漏初芸草，陌上吹箫正卖饧。\n多病更知生是赘，九原那恨死无名。\n但馀一事犹关念，万里唐安阙寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨非","author":"陆游","text":"温饱从来与道违，书生只合卧牛衣。\n老狐五百生前错，孤鹤三千岁后归。\n舌自生肥胜玉食，腰常忘带况金围。\n一官彭泽曾何有，元亮还家悔昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭德堂晚步","author":"陆游","text":"笑唤枯筇蹋夕阳，探春聊作静中忙。\n高枝鹊语如相命，幽径梅开秪自香。\n苔蚀断碑惊世换，钟来废寺觉城荒。\n谪仙未必无遗恨，老欠题诗到夜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼卧","author":"陆游","text":"忽忽见春尽，徂年那更还。\n香生帐里雾，书积枕边山。\n凌厉心犹壮，沈绵气已孱。\n千秋有管葛，看镜汗吾颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼卧","author":"陆游","text":"秋暑侵人气力微，烧香高枕掩斋扉。\n弄姿野蘤晴犹敛，作态江云晚未归。\n身外极知皆梦事，世间随处有危机。\n故山松菊今何似，晚矣渊明悟昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼卧初起书事","author":"陆游","text":"岁华病思两侵寻，静看槐楸转午阴。\n待睡不来聊小憩，煅诗未就且长吟。\n还山久洗天涯恨，谢事新谐物外心。\n忽有故人分禄米，呼儿先议赎雷琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼睡","author":"陆游","text":"眼昏妨读书，不睡复何如。\n拥被新寒里，伸腰午饭馀。\n断香萦倦枕，疏雨滴前除。\n未竟华胥乐，茶瓯莫唤渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼睡","author":"陆游","text":"书狱徵租自笑忙，暂归聊得憩匡床。\n屏图夜雨孤舟句，枕带秋风九日香。\n一卷蠹书栖倦手，数声残角报斜阳。\n清泉浴罢西窗静，更觉茶瓯气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼睡起偶赋","author":"陆游","text":"蝴蝶与蒙庄，颓然寓一床。\n日随香篆过，梦逐雨声长。\n酒喜新篘绿，橙如故岁黄。\n昏昏还隐几，谁识老龟堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柯山道上作","author":"陆游","text":"道路如绳直，郊园似砥平。\n山为翠螺踊，桥作彩虹明。\n午酌金丸橘，晨炊玉粒粳。\n江村好时节，及我疾初平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳林酒家小楼","author":"陆游","text":"桃花如烧酒如油，缓辔郊原当出游。\n微倦放教成午梦，宿酲留得伴春愁。\n远途始悟乾坤大，晚节偏惊岁月遒。\n记取晴明果州路，半天高柳小青楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳桥秋夕","author":"陆游","text":"柳疏桥尽见，水落路全通。\n衣杵家家月，渔舟浦浦风。\n眼明无俗物，步蹇有枯筇。\n野逸谁能那，悠然西复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残历","author":"陆游","text":"残历不盈纸，苦寒侵弊裘。\n岁猪鸣屋角，傩鼓转街头。\n未死犹当学，长贫肯复忧。\n雪晴农事起，且复议租牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残年","author":"陆游","text":"残年迫钟漏，病骨怯风霜。\n投帻早当去，强颜徒自伤。\n文符纷似雨，讼诉进如墙。\n笑杀沧浪客，微官有许忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残年","author":"陆游","text":"残年垂八十，高卧岂逃名。\n泥巷多牛迹，茅檐有碓声。\n炊菰觞父老，煮枣哺雏婴。\n遣戍虽传说，何时复两京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残年","author":"陆游","text":"残年光景易骎骎，屏迹江村不厌深。\n新麦熟时蚕上簇，晚莺啼处柳成阴。\n短檠已负观书眼，孤剑空怀许国心。\n惟有云山差可乐，杖藜谁与伴幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残春二首 其二","author":"陆游","text":"过了清明日愈迟，年华不复在辛夷。\n谁知绿叶阴成处，正是青天露坐时。\n茂草满庭喧鼓吹，嫩汤出鼎试枪旗。\n衰翁敢作明年计，剩与东君惜语离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残春","author":"陆游","text":"章甫从诸老，今为两世人。\n惟书尚开眼，非酒孰关身。\n远水涵清镜，晴云蹙细鳞。\n篱边花未尽，作意醉残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残春二首 其一","author":"陆游","text":"江鲚堆盘粔籹香，山家节物亦穷忙。\n桑间葚紫蚕齐老，水面秧青麦半黄。\n语燕似催春事去，游丝不似客愁长。\n乡村年少那知此，处处喧呼蹴鞠场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残春","author":"陆游","text":"残春醉著钓鱼庵，花雨娱人落半岩。\n岂是天公无皂白，独悲世俗异酸咸。\n妄身似梦行当觉，谈口如狂未易缄。\n已作沉舟君勿叹，年来何止阅千帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残春无几述意二首 其二","author":"陆游","text":"衰疾来无已，流年过若驰。\n家贫食易美，身老梦常悲。\n草长增蛙怒，花空失蝶期。\n不堪多难日，更赋送春诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残春无几述意二首 其一","author":"陆游","text":"试笔书盈纸，烹茶睡解围。\n新蔬供冷面，熟练制单衣。\n雏燕飞初稳，残花见渐稀。\n年衰学不进，默默讼吾非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残暑得小雨颇凉","author":"陆游","text":"午暑不可触，忽惊如许凉。\n轩窗云作暝，草木雨生香。\n蒲叶先秋霣，蝉声入夜长。\n自欣无一事，岸帻倚胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残腊二首 其一","author":"陆游","text":"残腊无多寒渐薄，新春已近日微长。\n棋枰散后轩窗静，梅坞归来襟袖香。\n海雾笼山青淡淡，河堤潴水白茫茫。\n鹭飞前导生游兴，笑岸纶巾上野航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残腊二首 其二","author":"陆游","text":"残腊去春才十日，衰翁告老已三年。\n乳糜但喜分香钵，银胜那思映綵鞭。\n万里当时嗟漫浪，一窗此日困沉绵。\n清泉白石无人到，且结梅花淡淡缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残腊二首 其二","author":"陆游","text":"残腊无多日，吾生又一年。\n林塘明夕照，墟落淡春烟。\n山色危栏角，梅花绿酒边。\n岁时元自好，老病独凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残腊二首 其一","author":"陆游","text":"破腊春先到，微阴日易醺。\n鸟声犹寂寂，木意已欣欣。\n云起山分叠，风生水蹙纹。\n断肠何处笛，偏向醉中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"炭尽地炉危坐至夜分戏作","author":"陆游","text":"短景窗易黑，长宵炉少红。\n直令贫到骨，未害气如虹。\n志士元谋道，儒生敢讳穷。\n霜严鸡喔喔，但愧读书功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独处二首 其二","author":"陆游","text":"白氎敷床稳，乌藤倚壁斜。\n灰深惟画字，灯暗不成花。\n似客犹居里，如僧未出家。\n孤村夜无月，何事有啼鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独处二首 其一","author":"陆游","text":"蓬门终日闭，寂寂少人声。\n纳禄知身贵，传家觉责轻。\n朝餐烹芋糁，夜坐爇松明。\n刬却弹棋局，此心如砥平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独立","author":"陆游","text":"白髯萧飒一愚公，独立濛濛细雨中。\n羊踏寒蔬新少梦，鱼生空釜久谙穷。\n残编幸有圣贤对，闲话岂无邻曲同。\n衒鬻才名非老事，小诗信笔不能工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独立","author":"陆游","text":"午醉初醒后，回廊独立时。\n斜阳明雨叶，乳鹊袅风枝。\n违俗虽堪笑，师心颇自奇。\n傍人疑徙倚，向道是寻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独立","author":"陆游","text":"独立柴荆外，颓然一秃翁。\n乱山吞落日，野水倒寒空。\n忧患工催老，飘零敢讳穷。\n渔歌亦何恨，悽断满西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独立思故山","author":"陆游","text":"溪水初生与岸平，桥头新柳已藏莺。\n诗缘遇兴玲珑和，酒为逢知烂熳倾。\n青箬买来冲雨钓，乌犍租得及时耕。\n今朝独立东风里，叹息无人会此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独至遁庵避暑庵在大竹林中二首 其二","author":"陆游","text":"世俗元非不汝忘，汝归安取醉为乡。\n药苗野蔌山家味，柏子松房道室香。\n一卷隐书为日课，数声啼鸟谢年光。\n客来莫笑茆茨陋，占尽炎天一味凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独至遁庵避暑庵在大竹林中二首 其一","author":"陆游","text":"赤日黄尘厌垢纷，竹林深处寄幽欣。\n如听嵩雒风前笛，似看潇湘雨后云。\n园鹿知时新解角，池鱼得意自成群。\n悠然一笑谁能识，坐胜天魔百万军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮冬夜宴","author":"陆游","text":"官机锦茵金蹙凤，舞娃钗堕双鬟重。\n宝炉三尺香吐雾，画烛如椽风不动。\n主人爱客情无已，筝声未断歌声起。\n亦知百岁等朝露，便恐一欢成覆水。\n炉红酒绿春为回，坐上梅花连夜开。\n堂前只尺异气候，冰合平池霜压阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐","author":"陆游","text":"巾帽攲倾短发稀，青灯照影夜相依。\n穷边草木春迟到，故国湖山梦自归。\n茶鼎松风吹谡谡，香奁云缕散馡馡。\n羸骖敢复和銮望，只愿连山苜蓿肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]