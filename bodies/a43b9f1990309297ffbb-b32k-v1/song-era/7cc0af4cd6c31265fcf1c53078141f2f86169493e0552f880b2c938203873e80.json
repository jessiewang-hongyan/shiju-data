[{"title":"归自德清","author":"陈必复","text":"午阴云弄日，水涨浪侵矶。\n小港渔舟聚，深村酒户稀。\n牛闲童自睡，蚕熟客方归。\n隔岸人家近，缫声出翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏折竹叶为舟示奚奴","author":"陈必复","text":"乃翁儿戏可怜生，折叶浮舟趁岸行。\n有便信风翻覆易，无心逐水去留轻。\n触崖颇似乘时意，藏壑深关遁世情。\n幸喜此身元不系，底须壁上觅寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖","author":"陈必复","text":"江湖路远总风波，欲向山中制芰荷。\n黄叶落来秋色晚，乱鸦归处夕阳多。\n惯经世态知时异，拙为身谋惜岁过。\n有屋一区田二顷，分无清梦到鸣珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中得催字","author":"陈必复","text":"山郭少晴日，春阴欲酿梅。\n岸痕新雨过，岛色晓云开。\n数鸟烟中落，一帆天外来。\n溪行正如画，频报长年催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行崇德","author":"陈必复","text":"落日挂征帆，西风客袂单。\n灯明村店近，船重水程宽。\n芦蓼作秋意，汀洲生晚寒。\n钟声烟外寺，山色梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过隐者居","author":"陈必复","text":"瘦筇独与鹤相随，行尽荒郊入翠微。\n溪鸟喜晴将子浴，山蜂傍暖采花归。\n空村岁月徵书晚，深径蒿莱客屦稀。\n久欲依居图别业，自愁无计泣牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村家","author":"陈必复","text":"绕郭一溪斜，溪村八九家。\n招邀过邻里，款曲话桑麻。\n老树低眠石，寒流浅漱沙。\n吾生尚萍梗，愧尔独兴嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苇径","author":"陈必复","text":"苇径通支港，舟行倚岸斜。\n晓沙含宿雨，老树著疏花。\n岁月春城暮，人烟水驿赊。\n仍年为客恨，飘泊祇堪嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还西里所居","author":"萧元之","text":"长恐山林计未成，可能俯仰羡公卿。\n鹤闲不受云拘束，梅冷惟堪雪主盟。\n北阙无书休悔出，东皋有秫可归耕。\n镜容渐改惊非昔，犹喜傍人唤后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迟客小轩","author":"陈必复","text":"约客久不至，春明坐小轩。\n墙阴侵霁色，檐晕上波痕。\n晴色麦花老，暖风莺语繁。\n午庭人寂寂，桃李亦无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏狂虏","author":"陈必复","text":"狂虏何时静，干戈卒未休。\n乾坤犹半拆，汴泗自东流。\n腥日鼪鼯野，悲风鸿雁秋。\n诸贤江左计，长为晋人羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜发江城","author":"陈必复","text":"移舟别浦待潮生，客子匆匆又夜行。\n云趁远帆离岛岸，风传疏角过江城。\n忧时谏草嗟无用，爱客灯花喜有情。\n愁甚不堪亲友别，小窗张酒到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿山庵","author":"陈必复","text":"扣宿精庐旋启扉，佛香未冷坐多时。\n分僧一半云归榻，借竹几些风入诗。\n隔梦听钟疑寺远，避寒移枕觉宵迟。\n起看犹有残窗月，春雪满山啼子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉酬陈介庵明府桐江见寄","author":"陈必复","text":"寒侵征袖客先知，晓角吹霜下客衣。\n归兴只缘松菊晚，宦情肯为稻粱肥。\n山村日落人收市，海浦风生浪打围。\n怊怅诗成无便寄，夜深暗遣梦魂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松江","author":"陈必复","text":"嗟我赋归役，怜君尚滞留。\n江风借行色，山月伴离愁。\n天地日以肃，星辰夜欲浮。\n东篱菊花约，莫易负清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行","author":"陈必复","text":"夏半馀寒在，新秧绿未齐。\n僧归知有寺，水尽觉无溪。\n疏径风行箨，空庭鸟篆泥。\n东郊有幽致，小暇一扶藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴小步","author":"陈必复","text":"蚕月家家静，村流处处深。\n草分两岸色，竹覆半池阴。\n少饮亦微醉，独行还自吟。\n儿童怪相问，争识野夫心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客枕","author":"陈必复","text":"客枕偏饶睡，春归尚拥绵。\n屋深灯易晕，漏短梦难圆。\n栖鸟警凉夜，闹蛙喧雨天。\n一声柔橹过，何处上溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过东野故居","author":"陈必复","text":"郭外有村名孟堡，旧传君此卜幽栖。\n草荒东野千年宅，水绕南山一曲溪。\n人物不生诗渺渺，秋风无语恨悽悽。\n可怜如许衣冠士，不为留祠向竹西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虏退后作","author":"陈必复","text":"小臣忧国志，所愿见时平。\n刁斗春防塞，囊书夜入京。\n边风吹冷骨，淮月浸重城。\n失喜天骄死，传闻已息兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"席上和林端隐韵","author":"陈必复","text":"云压檐花重，溪禽湿不飞。\n烟林生暝色，雨砌上苔衣。\n暮鼓深村急，疏钟远寺微。\n吟窗得新句，写向锦囊归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓步","author":"陈必复","text":"清晓步幽径，庭芜带绿莎。\n篱根惟有菊，池面已无荷。\n高树蝉声急，远山寒色多。\n小窗风日转，便觉似春和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积潦简友人","author":"陈必复","text":"暝锁层阴重，霾深失远峦。\n积流上篱落，飞影度栏干。\n石发梳风瘦，垣衣护雨寒。\n深怀裹饭去，终愧往来难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读后山诗","author":"陈必复","text":"百世人参杜陵句，一灯晚得后山传。\n天寒霜重隼孤击，木落江空花自妍。\n绝代文章惊此老，半生心力尽他年。\n后来不作嗟谁继，古意凄凉付断编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶出","author":"陈必复","text":"野店荒鸡曙，篱荆带暝开。\n漏声随雨尽，山色傍船来。\n事业归书卷，生涯付酒杯。\n溪翁往还惯，不怕白鸥猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"陈必复","text":"绕屋栽梅亦可人，最怜夏月绿阴清。\n前村雨过山如洗，深径风来竹自鸣。\n涤砚不嫌池水冷，写书爱傍午窗明。\n近吟未许人知得，且向梅边隐姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄石泉云间明府叔 其二","author":"陈必复","text":"异政人能说，新吟客为传。\n一官清似水，万事信于天。\n养鹤分厨料，收书出俸钱。\n昼庭少公事，闭阁抱琴眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄石泉云间明府叔 其三","author":"陈必复","text":"卧念相从乐，杜门岑寂中。\n曙窗报晴色，寒叶语秋风。\n别去诗难稳，愁来酒易空。\n相看才数驿，好为寄书筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨征","author":"陈必复","text":"乱山迎马首，树色辨微茫。\n犬吠一村月，鸦啼满屋霜。\n近郊人语早，远市漏声长。\n隔岸谁家圃，疏梅出短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"陈必复","text":"瘦得冰肌骨亦清，诗人于尔独关情。\n孤高不受尘埃涴，洁白犹嫌缟练轻。\n天下有花皆北面，岁寒惟雪可同盟。\n当时只欠灵均识，不与离骚写姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"领客游闻人氏省庵园","author":"陈必复","text":"半夜雨方住，一春晴不常。\n倚栏听鸟语，开户纳花香。\n庭暮竹阴净，池风水气凉。\n几番吟未稳，步月细平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游前溪西庵","author":"陈必复","text":"为爱僧居雅，时来扣野扉。\n沼清鱼可数，轩静客忘归。\n修竹负墙立，幽禽背水飞。\n道人差不俗，洗耳听弦徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋参政叔祖水亭","author":"陈必复","text":"一段渔歌起夕阳，溪山佳处欠平章。\n受风杨柳丝丝弱，临水轩窗面面凉。\n约客有时同把酒，横琴无事自烧香。\n沙头鸥鸟忘机久，却被官船去较忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"意行","author":"陈必复","text":"简出少过从，前游仙梦中。\n寒峰千岭碧，霜叶半林红。\n霁表浮馀景，明边落去鸿。\n意行随所止，端未哭涂穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧房","author":"陈必复","text":"结庐修竹里，身外世缘轻。\n滑几净如拭，小窗低更明。\n夜深留佛火，人静听钟声。\n共拨炉灰坐，跏趺对短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉禾境上","author":"陈必复","text":"联畴冈势断，缺岸浪痕垂。\n野店茅柴酒，人家槿树篱。\n逆风鱼上少，连雨稻开迟。\n客路秋偏好，归程尽是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漏长","author":"陈必复","text":"漏长知夜久，梦薄觉衣轻。\n曙月侵霜白，寒星度水明。\n遥空一雁过，邻屋数鸡鸣。\n著论吾宁敢，徐徐待老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张駉","author":"陈必复","text":"乍见语相合，苦吟心更亲。\n老于琴得趣，隐与牧为邻。\n一夜檐花雨，十年江树春。\n所交半湖海，恨晚识斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林尚仁","author":"陈必复","text":"溪边著吟屋，亦足老生涯。\n洗砚浑池水，敲棋落案花。\n客来多载酒，童去自煎茶。\n爱尔丰标异，逢人满口誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中书事","author":"陈必复","text":"天气如春盎，连朝未有霜。\n数蝉嘶老木，一鸟渡寒塘。\n风竹写晴影，水花临晓妆。\n静中观物化，此意等羲黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中效东坡用韵","author":"陈必复","text":"底事京尘踏软红，又随征棹过吴松。\n人家半在桑柘住，春水忽迷芦苇丛。\n赤蟹白鱼今稍稍，红樱紫笋已匆匆。\n船窗尽日看山色，多少好山供眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"防风氏庙","author":"陈必复","text":"一去归期不复闻，故乡目断会稽云。\n乌江空堕将军泪，蜀国曾招望帝魂。\n两壁衣冠存古貌，千年城郭说邦君。\n遗民尚指专车骨，老树槎牙枕庙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴江道中","author":"陈必复","text":"叶老蚕登箔，泥肥燕葺窠。\n晓风帆腹饱，夜雨柂梢高。\n久客交游少，一春行役多。\n短篷终日坐，煮茗读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和客用韵","author":"陈必复","text":"麦风翻蝶梦，花露湿蜂窠。\n水阔浪痕帖，雨晴云气高。\n酒功书下下，诗料办多多。\n拟唤三高起，豪吟些楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"搆得","author":"陈必复","text":"搆得数檐椽，閒身与静便。\n半帘花影碎，一树鸟声圆。\n吟苦瘦于旧，春寒多似前。\n闭门无客过，心事付琴边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"响应寺","author":"陈必复","text":"步屧穷幽讨，扶筇上碧尖。\n山高秋易瘦，瀑小雨方添。\n寺老僧单少，潭深庙祀严。\n平生丘壑志，爱此结茅檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偕游响应山观瀑泉饮漱玉亭上分复磴拥危泉赋磴韵十四","author":"陈必复","text":"溪山晴色妍，桃李春意剩。\n野服乌角巾，郊游偶乘兴。\n同行皆好宾，乐此境物胜。\n古寺临清潭，鸣泉落危磴。\n孤亭上云雨，木末渺难认。\n林深行渐迷，谷虚语相应。\n阴壑号悲风，悬萝碍飞镫。\n扫花坐寒石，意与幽事称。\n崖巅记曾游，藓湿墨痕凝。\n登高浩怀古，岁月如堕甑。\n百年几朝昏，今昔一长凭。\n道人苦将迎，颇亦厌车乘。\n他时营菟裘，隙地傥可赠。\n举杯酌山灵，兹语为我證。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿龙山精舍","author":"陈必复","text":"偶贪禅宇静，襆被到深林。\n夜榻僧同话，寒檐客自吟。\n窗明疑积雪，树黑怪常阴。\n犹恨匆匆出，丁宁约重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄石泉云间明府叔 其一","author":"陈必复","text":"容易成离索，临分重忍言。\n夜船杨柳岸，晓枕荻花村。\n山雨断云脚，溪风生浪痕。\n悬知自公退，怀抱欠同论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫赋","author":"陈必复","text":"篝灯读易听更残，微雨萧萧独闭关。\n治世岂无谋可献，书生从古命多寒。\n数茎须为忧时白，一点心犹报国丹。\n未肯轩裳便尘土，此身翻恐误儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东坡画像","author":"陈必复","text":"东坡先生谪仙人，骑鲸海宇几十春。\n麾呵日月斥八极，笑触丰缺天不嗔。\n万里归来故无恙，诸公非复先朝臣。\n空令后世拜公像，洛阳宫阙今成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台二首 其二","author":"陈必敬","text":"已上桐江台，又弄桐江钓。\n不食桐江鱼，不怕严公笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台二首 其一","author":"陈必敬","text":"公为名利隐，我为名利来。\n羞见先生面，黄昏过钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尊贤堂","author":"陈谠","text":"闻道骑鲸碧眼仙，黄柑手植尚依然。\n人间俯仰更成古，天下声名不计年。\n茧纸谁能收妙墨，鸡林何用续遗编。\n使君为创新堂事，若解尊贤则是贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白龟泉","author":"陈田夫","text":"天下白龟三处显，怡山少室寿仙亭。\n我今卜筑南山顶，得尔为邻祝圣龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题白云堂","author":"陈田夫","text":"我爱潇湘境，朱陵后洞天。\n白云堂里客，青草渡头眠。\n小艇牵红鲤，幽池种白莲。\n颐真堪此地，风月两依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙智寺 其一","author":"陈白","text":"台岭名将方丈齐，当年曾说二仙迷。\n无人再得洞中信，空有桃花落剡溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙智寺 其三","author":"陈白","text":"八重峰顶望群山，百谷东流去不还。\n惟有右军遗迹在，月波时落墨池间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题元象大师房","author":"陈白","text":"鹭行飞起绿杨岸，渔笛吹残明月滩。\n一片画图收不得，何人终日倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙智寺 其二","author":"陈白","text":"排危步步上天梯，乔木苍苍拂紫霓。\n向日莫催琪树老，清宵应见玉绳低。\n云蒸巨壑金虬蛰，月落高岩翠羽栖。\n况复仙翁丹井在，碧霄歧路不须迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题胜光怡道轩","author":"陈白","text":"了了无凝滞，谁人知此心。\n开池待海月，种树宿沙禽。\n白雪盈青简，古风生素琴。\n由来大隐者，何必在山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"葵花","author":"陈石斋","text":"恐是牡丹重换紫，久疑芍药再翻红。\n娇娆不似桑间女，蔽芾深迷苧下翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戒子孙诗","author":"陈亚","text":"满室图书杂典坟，华亭仙客岱云根。\n他年若不和花卖，便是吾家好子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和魏周辅","author":"陈亚","text":"昔贤自是堪加罪，非敢言君爱窃诗。\n叵耐古人多意智，预先偷子一联诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"陈亚","text":"张公吃酒李公醉，自古人言信有之。\n陈亚今年新及第，满城人贺李衙推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜竹","author":"陈亚","text":"出槛亦不剪，从教长旧丛。\n年年到朱夏，叶叶是清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嗤人面黑","author":"陈亚","text":"笑似乌梅裂，啼如豉汁流。\n眉间粘帖子，已上是幞头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀旧隐","author":"陈亚","text":"多愧当年未第间，卜居人外得清闲。\n排联花品曾非僭，爱惜苔钱不是悭。\n秋阁诗情天淡淡，夕溪渔思月弯弯。\n而今惭厚明朝禄，敢念藏愚莫买山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登湖州销暑楼","author":"陈亚","text":"重楼肆登赏，岂羡石为廊。\n风月前湖近，轩窗半夏凉。\n罾青识渔浦，芝紫认仙乡。\n却恐当归阙，灵台为别伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答杨球","author":"陈亚","text":"蒙君遗长笺，语意如何说。\n请看身上衣，裈中本无蝎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]