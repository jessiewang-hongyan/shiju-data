[{"title":"偶题","author":"林希逸","text":"溪南溪北鸟相呼，听雨看云足自娱。\n不羡笔书黄纸尾，但吟诗撚白髭须。\n身谋只合交猿鹤，眼见浑如掷雉卢。\n堪笑少陵高自比，到头老大始知愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和柞山肠字一首","author":"林希逸","text":"县知书卷饱撑肠，一倡殷勤十和章。\n茅捲三重怜杜屋，株高八九羡韩堂。\n利名谁信为缰锁，圣知人犹比桁杨。\n万事不如祇浩饮，葡萄切莫换西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪居古榕甚佳未尝有所赋得柞山诗卷借奇字韵戏成一首","author":"林希逸","text":"古树婆娑谁手种，有藤缠络似髯垂。\n但看窗草求溪意，自觉庭楸欠愈诗。\n才拙岂能酬郢曲，心降但合靡齐旗。\n吟渠却羡公家柞，短韵长篇句句奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春谷惠示榕桥精舍二十四诗借首篇韵赋一首","author":"林希逸","text":"春谷因榕费苦吟，为怜夹道绿阴阴。\n身藏岩涧风霜老，名入图经岁月深。\n北客未知题咏少，南州莫向字书寻。\n莺啼庭叶曾留句，独有河东柳赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题僧雪岑诗","author":"林希逸","text":"本自无须学撚须，此于止观事何如。\n诗家格怕无僧字，圣处吟须读佛书。\n得趣藕花山下去，逃名枯木众中居。\n早梅咏得师谁是，见郑都官却问渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题范月溪欸乃集","author":"林希逸","text":"欸乃溪干入听时，忽传新集到柴扉。\n自惭我老眠云惯，遥羡君吟弄月归。\n正始馀音何寂寞，四灵苦思尽光辉。\n当行家数今谁是，消得渠侬论锦机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐咨议总管 其一","author":"林希逸","text":"美矣军咨议，元戎喜借留。\n吟多磨盾鼻，心久折刀头。\n梅日相求去，花时寄别愁。\n天风题石处，从此梦同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐咨议总管 其二","author":"林希逸","text":"括要翁精训，君于翁又贤。\n吟工如射巧，稿富已刊传。\n资格宜分竹，功名早著鞭。\n从军诗更好，因雁寄溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡圃小山大资可斋先生所作也石久散而池亦荒恕斋来公补处叠之浚之访求旧记重刊之仍续留题之句以寄可翁翁又和之以某同出可斋之门不鄙赐示借韵为谢 其一","author":"林希逸","text":"湖嵌散尽重堆叠，池碧堙多旋斸开。\n旧记幸存新入石，胜游端待可人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡圃小山大资可斋先生所作也石久散而池亦荒恕斋来公补处叠之浚之访求旧记重刊之仍续留题之句以寄可翁翁又和之以某同出可斋之门不鄙赐示借韵为谢 其二","author":"林希逸","text":"旧留岸柳千株老，新种池荷一度开。\n此是可翁题咏处，元戎领客喜同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡圃小山大资可斋先生所作也石久散而池亦荒恕斋来公补处叠之浚之访求旧记重刊之仍续留题之句以寄可翁翁又和之以某同出可斋之门不鄙赐示借韵为谢 其三","author":"林希逸","text":"石好岁深欧记在，雨多云为段游开。\n同门一士头如雪，许待龙图老子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴帅用前韵以别再赋以谢 其一","author":"林希逸","text":"碧油幢下诗书帅，吏案如山强拨开。\n领客雍容游郡圃，柳间松下步行来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴帅用前韵以别再赋以谢 其二","author":"林希逸","text":"主人爱客情何厚，尽日移樽逐处开。\n古柏寒梅俱问讯，追思犹说海棠来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴帅用前韵以别再赋以谢 其三","author":"林希逸","text":"清晨玉帐方违拜，一叶江干舣未开。\n多愧元戎怀旧雨，殷勤惜别袖诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴帅用前韵以别再赋以谢 其四","author":"林希逸","text":"村居僻甚城闉远，避俗柴门久不开。\n忽漫出山归自喜，庞翁还谒恕翁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题天风海涛","author":"林希逸","text":"亭后千寻屴崱峰，亭前万里见晴空。\n山藏落照生新月，海涨轻涛带晚风。\n世事浮云变今古，客游镵石遍西东。\n近檐溜雨霜皮柏，却是渠曾识晦翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梁秘阁玉堂何似亭","author":"林希逸","text":"放眼久知亭外景，连朝苦恨雨昏昏。\n红飘落桂浑如雪，青失平林总是云。\n与世相忘真有道，休官曾不待移文。\n玉堂天上空回首，白发追寻我愧君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜新晴和前韵","author":"林希逸","text":"清晓秋声枕上闻，倚栏顿觉失眵昏。\n潮分新水添池水，山放晴云换雨云。\n翠洗方壶如著色，稻摇平野自成文。\n荷枯菊少梅全未，风叶萧萧对竹君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张尚书画册四首 其一 松间睡道士","author":"林希逸","text":"高枕松间石，如侬未易知。\n世情祇益睡，不是学希夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张尚书画册四首 其二 犬","author":"林希逸","text":"辞家何处附书归，纵猎何年投绁去。\n斯入咸阳机洛阳，料知黄耳嗤渠误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张尚书画册四首 其三 牡丹","author":"林希逸","text":"生意草亦佳，可但莲菊好。\n富贵本何心，莫以色见我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张尚书画册四首 其四 雀","author":"林希逸","text":"勘破鹏鸠事，人间百念消。\n茂先老自误，不记赋鹪鹩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊庵相道人求赠","author":"林希逸","text":"抛汝庵中菊，寻他楦上麟。\n休将穷达事，来语菊边人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送建宁倅林太博用后村韵二首 其一","author":"林希逸","text":"清班早见扬休立，自诡俄为九仞翔。\n教雨久沾儒馆下，屏星还照建溪傍。\n助行好事趋铃阁，课了康功向玉堂。\n禹锡文章终得力，吾侪觕细要更尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送建宁倅林太博用后村韵二首 其二","author":"林希逸","text":"家年爱友相期久，注目云宵看凤翔。\n半刺暂烦书纸尾，一翁分守系篱傍。\n多携客上丹青阁，易事贤居夷白堂。\n更喜宦游逢乐地，户无贵籴稻新尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题赵武子鹤泉","author":"林希逸","text":"可人何事著斯名，知傍清泉筑小亭。\n遥想倚风看鹤鹤，更须和月掬泠泠。\n君于醉后流应漱，渠若来时舞不停。\n莫谩濯缨歌此水，会当冲翼上青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别林伯常国博 其一","author":"林希逸","text":"解印南来久卸鞍，未甘遮日向长安。\n洪都别驾何廉取，斋殿除书果趣还。\n再入美传喧辇下，多情远别到溪干。\n才名藉甚如君少，此去应须立要班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别林伯常国博 其二","author":"林希逸","text":"岁晚交亲久寂寥，明时剩喜入旌招。\n玉融名邑虽多士，橐从无人已四朝。\n我分长閒守龙具，君宜闻健侍鸡翘。\n从今出处分岐路，对月相思梦愈遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"林希逸","text":"清晓焚香罢，书窗只自娱。\n时为五禽戏，閒看六牛图。\n遁世元无闷，衰年不厌癯。\n围棋三稚子，夜夜笑翁输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题国清林氏海山精舍","author":"林希逸","text":"白醉吟翁颇似痴，当仁一见却无疑。\n但寻来处知归处，莫把迷时待悟时。\n风过更看云不尽，潮生长与月相随。\n海山此趣谁能会，也是禅关也是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙寅再至水南吴景朔家","author":"林希逸","text":"旧游人物转头空，此地重来恨不穷。\n闻笛久怀中散氏，对床仅有小苏公。\n门前旋辟园池好，壁上芳题子侄同。\n尤喜芝兰书种茂，迎门欢笑挹溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村问讯水南失约二首 其一","author":"林希逸","text":"忆昔从容陪燕几，别来岑寂守渔蓑。\n论谈苦羡江河决，离索深惭岁月磨。\n觌面难逢善知识，钝根空比老禅和。\n当时言语何曾会，路滑山高敢再过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和后村问讯水南失约二首 其二","author":"林希逸","text":"学荒久欠亲谈麈，居僻谁同理钓蓑。\n砂欲作糜那解饱，砖难成镜只空磨。\n出乘雪兴思安道，归逐风吟笑志和。\n赖有先生前约在，扫门直候愈轩过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘某诗集","author":"林希逸","text":"邻居前此未相闻，到手新编喜得君。\n一事更令人动念，曾吟诗谒网山坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书窗即事","author":"林希逸","text":"此心无著自超然，粗粝随宜醉即眠。\n喜读佛书非佞佛，赋游仙曲岂求仙。\n涪翁语忌随人后，康节图看到画前。\n老书蓬窗聊尔耳，何曾敢道慕诸贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚晴","author":"林希逸","text":"云收风止晚晴初，池减波痕见绿蒲。\n鹭入田行如数步，鸦随林去似相呼。\n赋形宇宙真如寄，息意林泉不是迂。\n疏柳欲黄枫渐赤，来今去古几荣枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吴司户忠斋","author":"林希逸","text":"事业心期在汉廷，师生莫讶共斋名。\n当年取履封留者，入梦祇因住谷城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吴司户思忠堂","author":"林希逸","text":"我既题斋扁，堂名却又同。\n进思臣职分，意慕世宗工。\n欲问传心法，无如尽己功。\n游杨朱吕后，先且学忠公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三和除字韵","author":"林希逸","text":"终岁吾伊祇自苦，多生习气未全除。\n却嫌俗态骚骚尔，宁作閒民皞皞如。\n肯羡孔光灵寿杖，且烧韩愈送穷车。\n一编受用床头易，却似忘筌已得鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗赠友人程乡次子和甫兄","author":"林希逸","text":"苦恋庭闱戏綵衣，其言虽讷未全非。\n旁人竞喜广长舌，之子还如杜德机。\n他日必多麟抱送，妙年肯叹雉孤飞。\n但能寡过何妨拙，却恨乡闾识者稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中怀后村石塘之约爽矣","author":"林希逸","text":"好读书多昼苦短，细行历到岁其除。\n无端竹雨萧萧下，可奈松风谡谡如。\n更仆诗来几满箧，过门约在待安车。\n大寒不出空回首，何日同观濠上鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四和除字","author":"林希逸","text":"白发馀生甘寂寞，丹书微累幸蠲除。\n天留老眼谅人只，云本无心于我如。\n千岁不知棋几局，二乘且论宝三车。\n香山见彻人间事，断道为龙苦似鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客至五和除字","author":"林希逸","text":"衡茅有客同欢笑，径草呼童旋刬除。\n篘酒熟迟聊酤我，藜羹生怕有卷如。\n夜长不必论升斗，岁晚能忘誓笠车。\n邻舍多情还解事，频分野菜馈生鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和披字寄后村","author":"林希逸","text":"不羡新雕绣毂驰，不嫌自织草衣披。\n谈禅客至眼俱碧，联句人来髻似椎。\n愁绝只凭杯遣兴，意行全藉杖扶衰。\n旧游历历天南北，梦不能忘随所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈莆田","author":"林希逸","text":"邑以滩名处处同，此滩加似打头风。\n吟多正恐招穷鬼，怨作无端谤杀公。\n怒欲怀砖嗟薄俗，义为全璧赖宗工。\n衡寒溪上携琴去，羞涩囊如子美空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和春谷用弓字见寄 其一","author":"林希逸","text":"奴去看鱼笱，儿寻射鸭弓。\n养痾三径里，取友一溪中。\n日苦经檐短，天如罩野穹。\n过从人绝少，访问愧春翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和春谷用弓字见寄 其二","author":"林希逸","text":"星晓有残月，明明挂一弓。\n四天垂野外，万象蓄山中。\n水动知冰薄，林疏见谷穹。\n傍人应比我，观物邵家翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和春谷用弓字见寄 其三","author":"林希逸","text":"齐物书非放，师传自子弓。\n人多谈稷下，我独守环中。\n道贵身无贱，名高位莫穹。\n元和虽五相，千载一渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三和磨字韵","author":"林希逸","text":"休忆朝携香满袖，从教人画雪披蓑。\n诗狂黄鹤楼堪碎，颂美浯溪石欲磨。\n安得谷论肥定武，却嗤甫贵瘦光和。\n老痴只弄穷生活，散帙多闻暮鸟过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和除字韵","author":"林希逸","text":"洛下玄功须究意，人间杂念早消除。\n才情向老无多许，梦觉何时解一如。\n失马塞翁云得马，数车柱史论无车。\n浮生宠辱浑閒事，胜负真如射㩉鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"第三孙弥月小饮","author":"林希逸","text":"茅檐喜得第三孙，草草团栾笑语温。\n晚菊客贻黄似盖，新篘儿喜绿盈樽。\n生涯素薄书差富，旧物能留砚仅存。\n儒级传来方四叶，九龙入梦始曾门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四和除字韵寄元思别驾","author":"林希逸","text":"多生已被禅勾引，万事祇凭酒破除。\n节物变衰黄落矣，儒功寡要白纷如。\n怀贤疑似渴司马，避俗佯为聩仲车。\n好友年来吟骤进，相逢何日语姬鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨山徐总管袖诗见访以道间见梅而作少留一夕次韵为别 其一","author":"林希逸","text":"何曾问柳与寻花，访友轻车到海涯。\n少为梅吟看倒挂，会须木餫出褒斜。\n霜寒尽夜同煨芋，月过残星似撒沙。\n村落常时无此客，多陪僧话送年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨山徐总管袖诗见访以道间见梅而作少留一夕次韵为别 其二","author":"林希逸","text":"天放寒梅三两花，殷勤妆点淡生涯。\n巡檐索笑忘霜冷，倚树长吟待月斜。\n君去定趋丹凤阙，我閒但占白鸥沙。\n孤山好处空回首，典祀何时到玉华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨山徐总管袖诗见访以道间见梅而作少留一夕次韵为别 其三","author":"林希逸","text":"岸帻冲寒嗅雪花，兴随云远到天涯。\n月知玉斧修成近，星伴银潢左界斜。\n佳客过从聊把酒，浮生聚散似团沙。\n新吟何日重商榷，苦学无功鬓已华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七和披字韵","author":"林希逸","text":"意马难调系更驰，空沙莫为拣金披。\n忘机每笑棋争局，爱礼时看斋白椎。\n正月书因王不竞，变风作为教先衰。\n圣朝可托狂歌乐，况有羊何共和之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泳得男再蒙后村先生和除字见寄戏和一首","author":"林希逸","text":"贫惯人人嗤不管，老惭幼幼念难除。\n有孙何必位为喜，戏父谁云翁不如。\n夫子忘年容撰屦，长文何日抱随车。\n殷勤好伴腰镰叟，莫学娇痴女觅鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题朔斋铁壁堂","author":"林希逸","text":"耐久声名参古柏，绝清词翰赋薇花。\n几闻人似南都老，再有公生朔党家。\n题扁不渐名铁壁，持荷更合侍金华。\n元城志业须翁了，推美还看入制麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁卯元日作","author":"林希逸","text":"泰畤钦柴已庆成，金鸡赦下是兹辰。\n百官班立楼前拜，万岁嵩呼竿上人。\n正喜含饴看稚子，还叨祭泽及微臣。\n老逢嗣圣徵前梦，三十年前岁在寅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二日野望作","author":"林希逸","text":"麦垄高低一样青，淡云笼昼雨丝轻。\n梅花烂漫开将尽，松叶稀疏落又生。\n遥企钧天知梦断，欣闻玉陛庆熙成。\n人人尽说新年好，除夕无风岁旦晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丁卯立春作","author":"林希逸","text":"岁阳更始财三日，辇路归来第四春。\n野菜旋挑丝未细，村醪浅酌酿差醇。\n团栾弟侄何妨笑，淡薄杯盘莫厌贫。\n却忆先朝供帖子，伤心白发旧词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻园惠晚菊数月有花高大甚奇","author":"林希逸","text":"菊种虽殊多短短，忽传一种自比邻。\n围过十尺高七尺，开到初春始小春。\n团比盖擎身极瘦，碎如金散色常新。\n梅时得此真奇绝，更有清香细袭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放歌","author":"林希逸","text":"朗诵乌栖曲数终，乾坤何事老英雄。\n纵令经有千名佛，敢道诗无两放翁。\n九万里风来海外，二三更月到天中。\n便教挽得银河下，今古閒愁洗不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晨兴闻檐雀作","author":"林希逸","text":"晨起喧喧暮自栖，梦回每每当闻鸡。\n有渠何用门前客，廷尉当年见处低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石竺山紫云恭老 其一","author":"林希逸","text":"几载空拳把疏头，新成楼阁石山幽。\n未忘嘱付樗居士，送紫云师紫帽游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]