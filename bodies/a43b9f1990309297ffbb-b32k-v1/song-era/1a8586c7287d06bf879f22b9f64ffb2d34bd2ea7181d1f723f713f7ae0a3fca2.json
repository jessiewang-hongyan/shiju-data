[{"title":"句","author":"冯澥","text":"腊腊批红玉，霜梨割紫金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽张总管叔夜","author":"董俊","text":"南道勤王仗壮猷，襄阳果幸尚无忧。\n可怜一具英雄骨，不扈君王过白沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"臞庵","author":"苏庠","text":"王郎臞庵摩诘诗，烟花绕舍江绕篱。\n石渠东观了无梦，笔床茶灶行相期。\n古人已往不可作，甫里顾有今天随。\n湾头蟹舍岂著我，请具蓑笠悬牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂","author":"苏庠","text":"笛弄松江明月，蓑披笠泽归云。\n若话青霄快活，五侯何处如君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮天阁 其一","author":"苏庠","text":"臞庵主人天与闲，回栏飞阁临沧湾。\n晴波渺渺雁行落，坐见万顷穿云还。\n百年有底付鸟翼，未暇著脚鸳鸾间。\n径须呼酒浇磈磊，莫遣暝色霾烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮天阁 其二","author":"苏庠","text":"玉蟾飞入水晶宫，万顷琉璃碎晚风。\n诗就云归不知处，断山零落有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮天阁 其三","author":"苏庠","text":"秋落空江动碧虚，黄芦洲渚雁飞初。\n我来欲访鸱夷子，为挂西风十幅蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平远堂 其一","author":"苏庠","text":"柳外西风六幅蒲，野塘睡鸭对舂锄。\n如何唤得王摩诘，画作江南烟雨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平远堂 其二","author":"苏庠","text":"寒芦淅淅催秋晚，浦雨溟溟忆去年。\n它日未埋黄土陌，为君重赋补亡篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送举书记归天台","author":"苏庠","text":"卷衲下苍壁，夜光容暗投。\n人追道林辈，诗入杼山流。\n风吹蒹葭雨，雁横江汉秋。\n须烦紫藤杖，聊与白云留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天台则上人还浙东","author":"苏庠","text":"溪南溪北鸟啼处，树头树底梅已空。\n绝叹不如木上座，伴君千叠夕岚中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天台圭上人","author":"苏庠","text":"雨暗蒹葭浦，烟青杨柳津。\n有劳修月手，来访卧云人。\n落笔向来事，无锥今岁贫。\n故山何处是，落日大江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕山友游天台","author":"苏庠","text":"床头萝月厌同攀，发兴东吴万叠间。\n森木已深溪上屋，瘦藤穿尽雨馀山。\n黄梅绿李看来熟，长簟北窗谁与閒。\n此别故应频作恶，一樽何日慰勤艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次刘晞颜韵","author":"苏庠","text":"校书绝足腾飞黄，不数向来何与江。\n锦囊诗句随云表，十袭未启心先降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送行","author":"苏庠","text":"语别既不易，况与子同生。\n如何携手好，忽作千里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽张彦知","author":"苏庠","text":"敌骑乘秋入，妖氛拥贼营。\n孤城控淮海，百口付柴荆。\n徒想回天力，空馀恋阙情。\n艰难思报主，炯炯寸心明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李巨源赴洮湖陈氏馆","author":"苏庠","text":"蟠胸历历邺侯书，落笔奔奔走坂车。\n办作五言玉节信，直拚病渴马相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"苏庠","text":"聊辍清都玉笋班，虎符犹得控荆蛮。\n已见五溪谈笑了，坐追九辨典刑还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏成小诗留子静兄","author":"苏庠","text":"秋霜一夜到枯荷，奈此江南秋色何。\n蕲君未作一成去，同听竹窗鸿雁过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱仲韶机宜南归天台","author":"苏庠","text":"尺五城南客，能过仲蔚居。\n烟霏深寂历，云树晚扶疏。\n老去一无著，诗成百不如。\n喜无招隐作，仍免绝交书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张公洞","author":"苏庠","text":"铜棺之南山复山，扪萝绝壁藓苔斑。\n只今何处可容足，乞我石房云一间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿飞来峰下","author":"苏庠","text":"吴中未历佳山水，湖上怀思去惘然。\n云去云归两峰寺，鸥飞鸥没夕阳天。\n客愁官渡落花雨，归梦下湖春水船。\n想得对床成夜语，何须陇月向人圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子经归临安","author":"苏庠","text":"牛背行将老，鸥沙盟已寒。\n莼鲈付张翰，书札报任安。\n古学饱胸次，惊澜翻笔端。\n西湖千顷月，留取醉眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陶隐居画像赞","author":"苏庠","text":"蕊珠妙言，字照编简。\n云霾三馆，其人则远。\n世衰道丧，完节者鲜。\n临终之叹，作世和篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠安寺","author":"苏庠","text":"沙溪烟绝雨才通，无数深红间浅红。\n山店落英春寂寂，青旗吹尽柳花风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德友近在咫尺乃不相过因成小诗上呈","author":"苏庠","text":"十日已吹梅信风，绝怜未许一尊同。\n喜君不减习主簿，愧我殊非庞德公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德友求薝卜花栽戏作小诗代简","author":"苏庠","text":"问讯云萝小隐家，剡藤醉墨半攲斜。\n酒馀落笔已殊绝，发兴不须薝卜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题唐颓山风漪轩","author":"苏庠","text":"竹阴既疏明，流泉复清驶。\n佳响闻山禽，凉风澹然至。\n幽人此安禅，阅世一嬉戏。\n何必周八垠，是中有能事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至湖上","author":"苏庠","text":"沙晚水痕碧，萧萧蒲苇秋。\n鸿飞遵远渚，木落见沧洲。\n藤杖吟还倚，风帘行可休。\n有怀谁共语，暝色起林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠邑令章夏","author":"苏庠","text":"弦歌武城宰，遗芳叹汉官。\n莫怀千载忧，且毕今日欢。\n亭午百吏散，曲肱谢喧烦。\n况看古锦句，落笔酬江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"苏庠","text":"但见金华仙伯语，笔端丘壑饱经心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"苏庠","text":"休言贫病惟三箧，已办借书无一鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"苏庠","text":"去止书三箧，归亡酒一鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"苏庠","text":"惭无安世书三箧，滥得扬雄酒一鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"苏庠","text":"斯人活国计，不数管及萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"苏庠","text":"惟公廊庙姿，骨相宜珥貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"苏庠","text":"饱闻胸次有云梦，语作惊澜翻舌端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"苏庠","text":"骑鲸公子汉于菟，并驾殊非李与苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"苏庠","text":"晚喜此士来相亲，呼童汲涧濯玄云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十","author":"苏庠","text":"江南溪工琢溪玉，凄风瑟瑟江作縠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十四","author":"苏庠","text":"断崖绝壑元无主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"苏庠","text":"乞得东风一杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"苏庠","text":"眼底青山映寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"苏庠","text":"穿花却与共扶藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十九","author":"苏庠","text":"迎春不负千金诺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台山中偶题","author":"释祖可","text":"伛步入萝径，绵延趣最深。\n僧居不知处，彷佛清磬音。\n石梁邀屡度，始见青松林。\n谷口未斜日，数峰生夕阴。\n凄风薄乔木，万窍作龙吟。\n摩挲绿苔石，书此慰幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜馀溪上绝句","author":"汪藻","text":"水似秋蛇巧作蟠，山如浓翠拥高鬟。\n清风明月元无主，乞我烟萝茅数间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李伯时作渊明归去来图王性之刻于琢玉坊病僧祖可见而赋诗","author":"释祖可","text":"坐上柴桑墟落烟，眼中百里旧山川。\n候门稚子似无恙，三径巾车人绝怜。\n尚友当须今逸少，丹青宁复老龙眠。\n流传匪独遗怡玩，端使懦夫怀凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吴伯江所藏文湖州山水韵","author":"释祖可","text":"乘空作山川，妙绝借墨色。\n曲折千里素幅间，来自吴兴白蘋客。\n乃知潇湘洞庭岸，平吞胸中寄笔力。\n清霜摇落江海空，如闻冥冥度惊鸿。\n重楼复阁底处所，使我绝欲空濛中。\n吴侯吴侯安用许，浪迫归心赴翛渚。\n如何唤得江上船，一卧苍波占烟雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书余逢时所作山水 其一","author":"释祖可","text":"江势卷十万顷，村墅掩三四家。\n落雁惊横烟水，小舟攲著寒沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书余逢时所作山水 其二","author":"释祖可","text":"折苇非关秋色，飞鸥元自斜行。\n坐上忽惊丘壑，窗间那有潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书余逢时所作山水 其三","author":"释祖可","text":"江南江北岸，饱历此山川。\n谁信著笔力，尽驱来眼前。\n野桥分道路，古木薄风烟。\n我欲径归去，沙头人挽船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏秦处士作枯松","author":"释祖可","text":"秦郎真是旧摩诘，写出崔巍霜雪姿。\n林壑卷帘相照映，坐令公子发幽思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求初老墨梅","author":"释祖可","text":"手开玉玺心希有，乃得横烟冰雪枝。\n枯木堂中安用许，适堪病眼发新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅","author":"释祖可","text":"不向江南冰雪底，乃于毫末发春妍。\n一枝无语淡相对，疑在竹桥烟雨边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书性之所藏伯时木石屏 其一","author":"释祖可","text":"此自是我辈物，而乃落君家房。\n尚喜周旋顾盼，无忧荦确风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书性之所藏伯时木石屏 其二","author":"释祖可","text":"淡巃嵷烟雨色，老槎牙霜霰痕。\n想见湘岑落木，雾连江月昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书性之所藏伯时木石屏 其三","author":"释祖可","text":"胸中定自有此，笔端乃一见之。\n摧却岌峨天柱，来成咫尺峨嵋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书秦处度所作松石","author":"释祖可","text":"怜君作诗自无敌，游戏诗馀画成癖。\n高堂奋袖风雨来，霜干云根动秋色。\n长怀祝融天柱峰，万年不死之乔松。\n观君此画已无斁，不复望云支瘦筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观壮舆所藏伯时马","author":"释祖可","text":"平生徒说追风足，厌见驽骀饱刍粟。\n刘侯为出二马图，缅想权奇在坰牧。\n本朝不伐大宛城，公初得之无乃惊。\n胡沙燕山在吾目，短草落日低边明。\n雄姿忽作风动壁，意气腾骧欲无敌。\n前者骄矜后者驰，信矣能先鸟疾飞。\n圉人亦复神超然，亮作俗肉勤加鞭。\n吁嗟骏骨世定有，良乐不逢长弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山十八贤","author":"释祖可","text":"不能晋室扶倾覆，尽作西方社里人。\n岂意一时希有事，翻令元亮两眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"释祖可","text":"琴到无弦听者希，古今唯有一钟期。\n几回拟鼓阳春曲，月满虚堂下指迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靖节祠","author":"释祖可","text":"靖节非傲世，带耻为人束。\n郁然霜雪姿，受正如松独。\n高歌归去来，自种松与粟。\n寓意琴书间，处己审缨足。\n倾觞三径醉，颓然忘宠辱。\n江山有遗迹，庶以拯流俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香林许惠南溪茶作诗促之","author":"释祖可","text":"午窗汤饼违烦渴，安得云腴作短兵。\n仙鼎望公能遣赠，只今兀坐听歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠中上人","author":"释祖可","text":"能来不能款，竟欲与公言。\n促策望山去，未须违世喧。\n轻帆收落日，独鸟向前村。\n我亦动归思，一峰烟霭昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞梅","author":"释祖可","text":"朔风吹尽西山雪，合有早梅凌雪开。\n不应占看野塘上，分我一枝春色来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞霜柑","author":"释祖可","text":"殊非海外罗浮样，亦胜洞庭霜后黄。\n此实君家能独有，何时分饷齿牙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬才上人送霜柑 其一","author":"释祖可","text":"霜柑寄我莫言少，但得向人怀抱佳。\n渺渺新愁入思梦，晚云连雁雪连沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬才上人送霜柑 其二","author":"释祖可","text":"日向南云望几回，无因怀抱得重开。\n凭君莫惜锦囊句，尽作银钩虿尾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞菖蒲","author":"释祖可","text":"饱闻云根九节，不改四时郁然。\n愿见明窗棐几，浅叶瘦碧相鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀","author":"释祖可","text":"霜禽惊呼山麓音，霜风急吹溪上林。\n羲和揽辔不可缓，夏后苦身惊寸阴。\n横河明明月皎皎，远山苍苍水深深。\n哀鸿万里绕云阵，游子不眠中夜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺","author":"释祖可","text":"雪晴梅破发幽香，莺作春声入画堂。\n多少玉人魂梦断，不胜情况恨更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋屏阁","author":"释祖可","text":"袖手章江净渺然，倚风残叶舞翩翩。\n霜鸥睡渚白胜雪，雾雨含沙轻若烟。\n杨柳一番南陌上，梅花三弄远云边。\n匣鸣双剑忽生兴，我欲因从东去船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"释祖可","text":"漱壑夜泉响，扫窗春雾空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"释祖可","text":"故人江北江南岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"释祖可","text":"怀人更作梦千里，归思欲迷云一滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"释祖可","text":"窗间一榻篆烟碧，门外四山秋叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"释祖可","text":"此身未是寻真客，惭愧寻真观里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]