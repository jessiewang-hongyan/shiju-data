[{"title":"次韵秋兴","author":"姚孝锡","text":"老畏年光速，愁添旅梦多。\n西风著梧竹，归思入烟波。\n夜永凭诗遣，颜衰得酒和。\n故溪千树柳，谁复晒渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居偶成","author":"姚孝锡","text":"静爱柴门野兴幽，杖藜徐步到岩丘。\n深林有兽鸟先噪，废圃无人泉自流。\n土瘠税租随力办，年丰禾黍过时收。\n客来不虑无供给，白酒黄鸡亦易求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和成冠卿见寄","author":"姚孝锡","text":"别恨频添鬓雪深，百年怀抱郁沈沈。\n标名不挂金银榜，涉世空坚铁石心。\n俗物何劳供一醉，残僧正欲伴孤吟。\n朱弦三弄虚檐寂，唯有清风是赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日书怀","author":"姚孝锡","text":"云散交情薄，棋翻世态新。\n山容犹带腊，鸟语已回春。\n节物惊心遽，丘园入梦频。\n东风如解语，端笑未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日溪桥","author":"姚孝锡","text":"留恋春光慰病颜，无情风雨卷春还。\n阴阴密绿笼溪暗，细细疏红点径斑。\n老去益怜诗思涩，欢来聊破酒肠悭。\n不嫌门外无车辙，得遂衰慵一味閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳溪别墅","author":"姚孝锡","text":"安车随意饱甘肥，晚食徐行理亦齐。\n山市日高人未集，柴门客至鸟先啼。\n溪桥散望携筇度，野寺牵吟信笔题。\n容膝易安聊自适，瓮天閒看舞醯鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九偶成","author":"姚孝锡","text":"天边今日又重阳，陇树红飞雁信霜。\n且插茱萸慰衰鬓，莫将诗句挠回肠。\n歌勤皓齿人俱醉，舞恋晴晖蝶也忙。\n来日预期扶宿酒，未应篱菊减秋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓霁","author":"姚孝锡","text":"一夜云峰卷迅雷，残红狼藉点苍苔。\n莺声岂解留春住，燕语虚劳唤梦回。\n愁寂顿疑诗思减，衰残偏感岁华催。\n柳溪鱼鸟应相识，乘兴无嫌日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄田朝散善辅","author":"姚孝锡","text":"粉署标名旧，山城识面新。\n青云摧劲翮，空谷滞幽人。\n世路谋身拙，心田育德醇。\n久要知可卜，倾盖已情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登楼有怀","author":"姚孝锡","text":"老愧凭阑目力昏，百年怀抱向谁论。\n晴空雁起云边塞，夕照人归郭外村。\n因记昔游惊迅晷，暂将离恨付清尊。\n谁人肯似边居士，远驾朱轮过雀门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪桥早春","author":"姚孝锡","text":"轻黄未染柳梢匀，连日溪风卷塞尘。\n乍暖乍寒花信晚，相呼相应鸟声频。\n少勤漫挟经纶策，老懒空馀病患身。\n追忆故园桃李树，年年红紫为谁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"姚孝锡","text":"睡起日侵牖，开轩遥见山。\n晓风吹腊尽，芳草惹春还。\n烟暖莺迁谷，云低雁渡关。\n衰年人事减，遇酒得开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"姚孝锡","text":"生涯甘分寄耕桑，山色围门水绕墙。\n困病久惩耽酒癖，爱閒犹有和诗忙。\n檐冰滴砌春犹冷，野马浮川日渐长。\n旧事老年多记忆，故园归梦正悠飏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题佛光寺","author":"姚孝锡","text":"臧谷虽殊竟两亡，倚阑终日念行藏。\n已忻境寂洗尘虑，更觉心清闻妙香。\n孤鸟带烟来远树，断云收雨下斜阳。\n人间未卜蜗牛舍，远目横秋益自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题滕奉使祠","author":"姚孝锡","text":"本期苏郑共扬镳，不意芝兰失后凋。\n遗老祇今犹涕泪，后生无复识风标。\n西陉雁度霜前塞，滹水樵争日暮桥。\n追想生平英伟魄，凌云一笑岂能招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩琴示儿子沂","author":"姚孝锡","text":"古人无复见，但有东轩琴。\n一鼓高山操，因窥古人心。\n正声久沈埋，俚耳喧哇淫。\n正可自怡悦，不须求赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公才对菊见怀","author":"姚孝锡","text":"发蓬新感二毛侵，尚阻清尊对菊斟。\n久拟芝兰同臭味，莫疑鱼鸟自高深。\n食贫岂复甘秦炙，客病空怀奏楚音。\n挂席无由上牛斗，漫凭流水送归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居","author":"姚孝锡","text":"无客访衰残，柴门尽日关。\n耽书真是癖，惜酒近成悭。\n苔径行搜句，茅檐卧看山。\n却嫌明镜里，偏照鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"姚孝锡","text":"节物先后南北异，人情冷暖古今同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"姚孝锡","text":"舞风初学絮，带雨不成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"姚孝锡","text":"烟染绿丝迷别浦，雨催红糁缀长条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"姚孝锡","text":"盘无兼味惭留客，梦厌多岐不到乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"姚孝锡","text":"岸涨鱼吹沫，山空石转雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十三","author":"姚孝锡","text":"玄晏暮年常抱病，子山终日苦思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"姚孝锡","text":"云生古木千章秀，山抱晴川一掌平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"姚孝锡","text":"愁边日晷偏疑短，梦里江乡未当归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"姚孝锡","text":"诗忙疏酒盏，俸薄减厨烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"姚孝锡","text":"谷虚繁地籁，境寂散天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"姚孝锡","text":"红缬退风花著子，绿针浮水稻抽秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"姚孝锡","text":"久客交情谙冷暖，衰年病骨识阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"姚孝锡","text":"酒敌馀威翻索莫，诗含幽思倍清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上桂林詹帅","author":"姚宋佐","text":"九月无霜飞叶少，四时有笋乱丛深。\n桂林二十四岩洞，杖屦十年供醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅月吟","author":"姚宋佐","text":"梅花得月太清生，月得梅花越样明。\n梅月萧疏两奇绝，有人踏月绕花行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"姚宋佐","text":"蛮丁诵吏部，沙户知退之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"姚宋佐","text":"当日客星今底处，化成台辅柄璇霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦笔驿","author":"姚宏","text":"一宵短梦惊流俗，千里高名挂里闾。\n遂使晚生矜此意，痴眠不读半行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔歌","author":"姚所韶","text":"自得元无趣，悠然与世忘。\n一声来欸乃，孤棹在沧浪。\n云断暮空碧，江清秋思长。\n欲将湘笛和，无调入宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋青田","author":"姚述尧","text":"水绕山围景物赊，楼台相望酒旗斜。\n暮云低锁门前柳，晓日轻笼陌上花。\n簇簇鱼盐喧贾市，声声弦诵半儒家。\n我来亦为邦人庆，写入新诗一笑誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑奴儿/采桑子 其一 王清叔赠梅花见索","author":"姚述尧2","text":"山城寂寞浑无绪，兀坐黄昏。\n多谢东君。\n先遣司花来报春。\n清标自是蓬莱客，冰玉精神。\n独步前村。\n分付仙翁作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑奴儿 其二 寿词","author":"姚述尧2","text":"晓来佳气穿帘幕，郁郁葱葱。\n宝鸭烟浓。\n戏彩庭前玉树丛。\n肌肤绰约真仙子，王母宫中。\n欢会曾同。\n笑问蟠桃几度红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平欢 圣节赐宴","author":"姚述尧2","text":"蕤宾奏律，正太平无事，欢娱时节，翘首箫台南望处，两两寿星明彻。\n和满乾坤，春回草木，瑞霭凝金阙。\n钧天齐奏，嵩呼隐隐三发。\n遥想帝里繁华，庆父尧子舜，赓歌胥悦。\n黼座传觞仙仗里，拜舞两阶英杰。\n愠解薰风，恩覃湛露，玉陛笙镛咽。\n溥天同庆，年年沈醉花月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆秦娥 曹季明休沐日会同舍小酌，命爱女奏 于帘间，索词。醉中口占","author":"姚述尧2","text":"珠帘深。\n玉人天上传清音。\n传清音。\n云横新雁，梅落寒林。\n□□□□□□□。\n□□□□□□□。\n□□□。\n谢家庭院，寿酒频斟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一 中秋","author":"姚述尧2","text":"碧落暮云卷，玉宇静无尘。\n宝阶露滴仙掌，秋气正平分。\n冷浸银河清澈，光射珠躔明灭，素女拥冰轮。\n今夕桂华满，疑是别乾坤。\n对清影，凌灏气，沃芳尊。\n凭高凝望，万里城阙尽铺银。\n偏照长门离恨，更揽西园诗思，何处不关情。\n此景年年好，莫惜醉归频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二 七夕","author":"姚述尧2","text":"三五半圆夜，二七素秋天。\n银河耿耿，中渡绛节会星軿。\n宝鹊喜传佳信，丹凤欢迎仙仗，瑞彩映珠躔。\n此意天长久，不比在人间。\n多情客，捧香饵，洁宾筵。\n殷勤拜舞，乞寿乞富乞团圆。\n宜与人人愿足，更看家家欢洽，喜气满江山。\n今夕莫辞醉，后会是来年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其四 秩满告归，曾使君饯别，席间奉呈","author":"姚述尧2","text":"泽国正秋杪，微雨洒江滨。\n凭高一望，万里多稼总如云。\n芳野壤歌鼎沸，古市欢声辐凑，尽是泰平人。\n铃阁尽无事，桃李满公门。\n恨瓜戍，趣征驭，惜芳辰。\n高情耿耿，重别中夜沃清尊。\n不为兰亭感慨，莫作楚狂醉倒，谭笑自生春。\n明日送行处，忍顾翠眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其三 酴醾","author":"姚述尧2","text":"上苑暮春好，烟雨正溟濛。\n桃蹊冷落无语，嫩绿翳残红。\n好是翠屏乍展，喜见玉英初坼，裁剪费春工。\n绰约更娇软，轻扬万条风。\n散清馥，翻素艳，照晴空。\n佳人羞妒，竞把粉质斗芳容。\n无限恼人风味，别有留春情韵，都付酒杯中。\n极目凭阑久，月影在墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归自谣 其一","author":"姚述尧2","text":"初夏好。\n雨过池塘荷盖小。\n绿阴庭院莺声悄。\n朱帘隐隐笙歌早。\n沈烟袅。\n玉人笑拥金尊倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其一 赠王清叔","author":"姚述尧2","text":"水阁弄清风，黯黯满园肥绿。\n茶罢竹间携手，有佳人如玉。\n渊明三径已催归，名利几时足。\n遥想五云多处，奏南风一曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其二 重午前三日","author":"姚述尧2","text":"梅子欲黄时，霖雨晚来初歇。\n谁在绿窗深处，把彩丝双结。\n浅斟低唱笑相偎，映一团香雪。\n□指墙头榴火，倩玉郎轻折。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其三 寿茶","author":"姚述尧2","text":"龙焙初分丹阙。\n玉果轻翻琼屑。\n彩仗挹香风，搅起一瓯春雪。\n清绝。\n清绝。\n更把兽烟频爇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其二","author":"姚述尧2","text":"雅淡轻盈如语。\n碧玉枝头娇处。\n钩月衬凌波，仿佛湘江烟路。\n凝伫。\n凝伫。\n不似梨花带雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其一 水仙用雪堂韵","author":"姚述尧2","text":"绰约冰姿无语。\n高步广寒深处。\n香露浥檀心，拟到素娥云路。\n仙去。\n仙去。\n莫学朝云暮雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行香子 抹利花","author":"姚述尧2","text":"天赋仙姿。\n玉骨冰肌。\n向炎威、独逞芳菲。\n轻盈雅淡，初出香闺。\n是水宫仙，月宫子，汉宫妃。\n清夸檐卜，韵胜酴醾。\n笑江梅、雪里开迟。\n香风轻度，翠叶柔枝。\n与玉郎摘，美人戴，总相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一 次蔡仲明韵","author":"姚述尧2","text":"红叶漫随风舞，黄花不畏霜凋。\n诗人把酒竞招招。\n更欲移尊籍草。\n醉里谪仙兴逸，夜深归骑声呶。\n孟公投辖未相饶。\n不放秋光便老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"姚述尧2","text":"嫩绿烟笼碎玉，繁红日护香绡。\n故人去后恨迢迢。\n独倚危楼情悄。\n脉脉望穷云杪，看看月上花梢。\n嫩添金鸭任烟消。\n杜宇一声春晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 前题","author":"姚述尧2","text":"江村昨夜一枝梅。\n先传春信回。\n非烟非雾下瑶台。\n香风拂面来。\n云幕卷，日华开。\n祥光映上台。\n安舆从此步天街。\n君王赐寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其六 梅词厉主簿为梅溪先生寿","author":"姚述尧2","text":"早春时候，占百花头上，天香芳馥。\n寥廓寒分和气到，知是花神全毓。\n独步前林，挽回春色，素节辉冰玉。\n翛然一笑，便应扫尽粗俗。\n最爱潇洒溪头，孤标凛凛，不与凡华逐。\n自是玉堂深处客，聊寄疏篱茅屋。\n已报君王，为调金鼎，直与人间足。\n更看难老，岁寒长友松竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其二 冬日赏菊次前韵","author":"姚述尧2","text":"霜风初过，正仙吏微吟，诗喉清咽。\n静对南山真赏处，秋后一亭花月。\n翠簇香裀，光摇今胜，玉女肌凝雪。\n寒城无伴，灿然还自奇绝。\n况有凫舄朋来，拼金钱都罄，晚酣留客。\n应笑陶潜孤负了，多少傲霜馀色。\n鲸饮方豪，龙吟未已，更著雕胡设。\n清欢无限，醉归犹记前说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其五 瑞香","author":"姚述尧2","text":"芸堂春早，正芳苞紫萼，笼烟调雨。\n隐隐朝阳歌宴罢，拥出三千宫女。\n醉面匀红，香囊暗惹，鹊尾烟频炷。\n庐山佳致，依然都在庭宇。\n因念一种天香，当年岩谷下，想难俦侣。\n一旦呈祥都占断，阆苑琼林歌舞。\n瑞彩扶疏，锦笼绰约，兰蕙应羞妒。\n明朝胜赏，有谁同唱金缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其一 次刘周翰韵","author":"姚述尧2","text":"山城秋早，听画角吟风，晓来声咽。\n梦断华胥人乍起，冷浸一天霜月。\n灏气参横，尘埃洗尽，玉管濡冰雪。\n兴来吟咏，灵均谁谓今绝。\n闻道潇洒王孙，对黄花清赏，喜延佳客。\n一坐簪缨谭笑处，全胜东篱山色。\n酒兴云浓，诗肠雷隐，饮罢须臾设。\n醉归凝伫，此怀还与谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其四 重九前二日登西塔观县治，用前韵","author":"姚述尧2","text":"江山清绝，正箫台花县，霜秋时候。\n寻胜登高环望处，碧瓦参差铺绣。\n五岫藏云，两溪吞月，古市渔盐凑。\n青帘斜扬，家家香泛丹溜。\n况是东鲁风流，看儒冠济济，垂天赋就。\n陶令从容官事了，把菊高吟闲昼。\n草鞠圜扉，香凝燕寝，豪饮挥金斗。\n公庭无事，珍祥休问驯兽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其三 九日作","author":"姚述尧2","text":"山城秋好，正西风淅淅，登高时候。\n杖倚徘徊凝望处，翠叠万山如绣。\n云绕禾场，熢沈戎马，田野欢声凑。\n琴堂无事，何妨同泛香溜。\n况有庭下黄花，遍河阳、尽把金钱铺就。\n一座簪缨谭笑里，尘脱风生清昼。\n饮罢龙山，诗成彭泽，灏气森星斗。\n醉归凝伫，美人时炷金兽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其三 雨中观瀑泉于白鹤僧舍","author":"姚述尧2","text":"云度岩扉风振谷，迅雷惊起蛟龙。\n天威汹汹变晴空。\n搅翻银汉水，倾入宝莲宫。\n雪浪奔冲凌翠麓。\n陇头低挂双虹。\n人间热恼尽消融。\n此流长不断，万折竟朝东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其五 前县尉吕次新自台城来访，酌酒为劝","author":"姚述尧2","text":"材刃纵横森武库，箫台旧日梅仙。\n累陪簪盍醉花前。\n吴门归去后，一别动经年。\n曾到赤城真隐处，飘飘凤举龙蟠。\n勒回俗驾向长安。\n好将医国手，从此活人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其八 送使君刘显谟归三衢","author":"姚述尧2","text":"忆昨曾将明使指，轺车踏遍东城。\n重来游戏拥双旌。\n江山皆故部，英俊尽门生。\n杖策翩然归去也，送行满坐簪缨。\n尊前雨泪不胜情。\n曲终人散后，江上数峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一","author":"姚述尧2","text":"山县登高真胜事，满筵当代英奇。\n黄花无语笑东篱。\n龙山真鼠辈，巴岭漫羁栖。\n醉后风流情更好，笑谈落落珠玑。\n莫将乌帽任风吹。\n动容皆是舞，出语总成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]