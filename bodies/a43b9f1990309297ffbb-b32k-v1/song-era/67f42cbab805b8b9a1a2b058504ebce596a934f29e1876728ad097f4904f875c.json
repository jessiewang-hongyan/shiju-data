fe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄吉父将赴南康官归金溪三首 其二","author":"王安石","text":"还家一笑即芳辰，好与名山作主人。\n邂逅五湖乘兴往，相邀锦绣谷中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄吉父将赴南康官归金溪三首 其一","author":"王安石","text":"柘冈西路白云深，想子东归得重寻。\n亦见旧时红踯躅，为言春至每伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧惠思归钱塘","author":"王安石","text":"渌净堂前湖水渌，归时正复有荷花。\n花前亦见馀杭姥，为道仙人忆酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧游天台","author":"王安石","text":"天台一万八千丈，岁晏老僧携锡归。\n前程好景解吟否，密雪乱云缄翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"适意","author":"王安石","text":"一灯相伴十馀年，旧事陈言知几编。\n到了不如无累后，困来颠倒枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重过余婆冈市","author":"王安石","text":"忆我东游未有须，扶衰重此驻肩舆。\n市中年少今谁在，鲁叟当街六十馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重将","author":"王安石","text":"重将白发旁墙阴，陈迹茫然不可寻。\n花鸟总知春烂熳，人间独自有伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山晚步","author":"王安石","text":"小雨轻风落楝花，细红如雪点平沙。\n槿篱竹屋江村路，时见宜城卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭张唐公","author":"王安石","text":"堂邑山林久寂寥，属车前日驻鸡翘。\n冥冥独凤随云雾，南陌空闻引葬箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宰嚭","author":"王安石","text":"谋臣本自系安危，贱妾何能作祸基。\n但愿君王诛宰嚭，不愁宫里有西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐秀才园亭","author":"王安石","text":"茂松脩竹翠纷纷，正得山阿与水濆。\n笑傲一生虽自乐，有司还欲选方闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悟真院","author":"王安石","text":"野水从横漱屋除，午窗残梦鸟相呼。\n春风日日吹香草，山北山南路欲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悯儒坑","author":"王安石","text":"智力区区不为身，欲将何力助强秦。\n只应埋没千秋后，更足诗书发冢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晏望驿释舟走信州","author":"王安石","text":"病起行山山更险，下穷溪谷上通天。\n乘高欲作东南望，青壁松杉满我前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殊胜渊师八十馀因见访问之近来如何答曰随缘而已至示寂作是诗","author":"王安石","text":"寄托荒山鬼与邻，一生黄卷不离身。\n百年薪尽随缘去，莫学缁郎更误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠花","author":"王安石","text":"绿娇隐约眉轻扫，红嫩妖饶脸薄妆。\n巧笔写传功未尽，清才吟咏兴何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中睡起折杏花数枝二首 其二","author":"王安石","text":"独卧无心起，春风闭寂寥。\n鸟声谁唤汝，屋角故相撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]