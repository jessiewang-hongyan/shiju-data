[{"title":"夜坐因读隐直书寄之","author":"刘敞","text":"徂岁曾何急，清宵不复长。\n蹉跎问甲子，愁寂看灯光。\n峡雨萧萧冷，江云澹澹黄。\n殷勤故人别，容易二年彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙监丞送书生南游","author":"刘敞","text":"历国向七十，滔滔何日还。\n轻赍一剑在，壮节二毛斑。\n浮俗风波里，高情天地间。\n滞留多愠见，送远愧登山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏寒","author":"刘敞","text":"冥冥梅送雨，椮椮麦迎秋。\n四月应徂暑，南方复重裘。\n昆崙摇地轴，渤海涨河流。\n天事无端错，民生若许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同黄子温小寒","author":"刘敞","text":"阴老疑龙战，风高怯海飞。\n枯蓬不自息，归鸟竞相依。\n时节惊流水，生涯托墐扉。\n哀歌向妻子，吾道亦牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨至西阳池示同行","author":"刘敞","text":"风定水逾静，雨收天倍高。\n分明写冰鉴，深浅露秋毫。\n车马情颇厌，山林心正劳。\n观鱼近至乐，相与更临濠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又过西阳池","author":"刘敞","text":"役役轻日月，回回分簿书。\n怅然面止水，乐矣羡游鱼。\n鸥鸟舞迎客，江湖兴起予。\n顾邀二三子，退食未宜疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送信阳舒使君","author":"刘敞","text":"闻名自夙昔，已作旧相知。\n倾盖成邂逅，如何还别离。\n军声咽鼓角，行色满旌麾。\n莫怪樽前醉，亲邻心所期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送南仪守黄中允","author":"刘敞","text":"十年幕中客，万里海南州。\n命服仍朱绂，夸乡未白头。\n山城时昼黑，岭水或西流。\n问道林多桂，王孙莫自留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阎工部新作西斋","author":"刘敞","text":"逍遥不期远，趣足外嚣尘。\n谁谓持斧客，翻同高卧人。\n江芦烟叶重，岩菊露香匀。\n爱惜凌寒意，留欢过小春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王寺丞北城","author":"刘敞","text":"专城空岁月，报国愧纤毫。\n幸及农功暇，初成壁垒高。\n飞翚邻雉堞，萦带俯鱼濠。\n与听舆人诵，无令板筑劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同年陈君制策高第改佐著作东还馀杭作五言送行兼寄彦猷阁老使君二兄","author":"刘敞","text":"江海一远别，见君金马门。\n先鸣二三子，强著五千言。\n清望开中秘，英辞动至尊。\n荐贤受上赏，时论重西垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴庆池送客","author":"刘敞","text":"红蕖千顷合，碧树百年藤。\n长日宜沿溯，清风破郁蒸。\n别离情易恶，衰老醉那能。\n还望邯郸道，悲歌不自胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春日斋祠毕还过金明池寄永叔","author":"刘敞","text":"宿雨原野润，朝云宫殿明。\n东风未半日，佳气满重城。\n涣涣泉披冻，欣欣木向荣。\n江头景如此，公起探春晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送次子敏归河阴","author":"刘敞","text":"表里山河险，成皋广武间。\n仕贫宁自佚，待次复空还。\n寿酒千秋祝，儿衣五綵斑。\n人生此乐少，何事惨离颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟","author":"刘敞","text":"溪流向人急，野色背人偏。\n轻浪仍堪鉴，虚舟不费牵。\n柳长勤拂面，鸥戏巧随船。\n幽兴终难尽，禽鱼莫间然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日对酒二首 其一","author":"刘敞","text":"惨惨霜天迥，纷纷风叶黄。\n须倾一樽酒，少浣九回肠。\n世事浑无定，秋容每自伤。\n登高何必赋，会使鬓毛苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日对酒二首 其二","author":"刘敞","text":"懰慄看秋尽，差池感岁穷。\n薄寒侵白罽，危叶陨青枫。\n零落茱萸佩，淹留桂树丛。\n年光不可玩，生意羡冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对酒忆献臣二首 其一","author":"刘敞","text":"举酒惜春尽，缓歌伤别离。\n江山空发兴，鸡黍若为期。\n醉起疑千日，愁来独五噫。\n皋桥羁旅客，惆怅不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对酒忆献臣二首 其二","author":"刘敞","text":"春日怀吾子，羁游各异方。\n况逢青眼绝，早识白眉良。\n树逐相思老，江回去路长。\n感时惟尚寐，终日醉无妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汝阴送扬州通判广陵高秘丞","author":"刘敞","text":"朱轓垂丝旒，千里下扬州。\n本郡荣何甚，治中望最优。\n高人孙绰贵，节妇孟光尤。\n问俗应宾礼，清风远镇浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新作小桥","author":"刘敞","text":"幽池旧徒涉，春涨得新桥。\n自恨济川小，欣忘渡水遥。\n中流横螮蝀，别径会渔樵。\n更爱凭栏处，东风柳万条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月十一日早行是日风寒如八九月","author":"刘敞","text":"晨兴事朝谒，星汉已阑干。\n云薄露犹湿，风高天正寒。\n尘衣先改素，蓬鬓强弹冠。\n兴在江湖永，空歌行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜独饮","author":"刘敞","text":"霜落月更白，云开天正青。\n捲帘邀玉兔，引酒劝天星。\n起舞凭相属，高歌愿共听。\n春宵谁谓短，罍罄适添瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中赠徐监簿","author":"刘敞","text":"明闇云移影，萧骚雨送凉。\n远林寒起雾，清簟润浮霜。\n小隐交游绝，微吟杖履妨。\n奕棋还偃几，幽趣亦难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄和弟","author":"刘敞","text":"鹡鸽飞砌下，广莫起寒风。\n感物念游子，赋诗同召公。\n楚歌还落木，淮月更虚弓。\n羁旅伤离别，如何岁亦穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日寄因甫","author":"刘敞","text":"遥想登高处，姑苏秋草多。\n那无万古恨，少作五噫歌。\n野菊萧萧晚，江鸿叠叠过。\n尺书不可托，送目奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日登城北门送孙许州","author":"刘敞","text":"红叶迎霜陨，高楼近日暄。\n送归仍暮节，极望正平原。\n容易风吹帽，殷勤菊满樽。\n岂嫌径先醉，当识别销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"刘敞","text":"采采黄花菊，飘飘阊阖风。\n醉从纱帽落，兴与古人同。\n北岳烽烟隔，甘泉侯骑通。\n悲歌伤远目，不独为青枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阁下紫薇花","author":"刘敞","text":"宫中万年树，天上紫薇垣。\n此地飞尘隔，经时绛雪翻。\n幽香通复阁，密影半层轩。\n已后阳春节，无辞白露繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀襄阳郭户曹","author":"刘敞","text":"远身适荆楚，苦掾寄书题。\n他日相思甚，终年引望迷。\n销忧岘山醉，招隐鹿门栖。\n勿以徒劳故，全家自此携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹西亭送二十六弟赴定州去年三月亦于此相别即昆冈蒙谷之阳","author":"刘敞","text":"山中招隐地，江上未归人。\n那可连年别，俱逢欲暮春。\n乱飞莺恋友，北向雁辞宾。\n自觉双蓬鬓，萧萧日更新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送和弟通判陜府","author":"刘敞","text":"丹绂双纹绶，朱轓左画轮。\n平生固自负，归去亦荣亲。\n美俗馀分陜，悲歌激在陈。\n别离俱未易，因目二毛新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧山舍弟将发南都以诗候之","author":"刘敞","text":"闻道双飞舄，看来万里流。\n传声淮口渡，审候越侬讴。\n霜蟹人人得，春醪盎盎浮。\n襄贲差不恶，须汝共销忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴小园偶步","author":"刘敞","text":"弱弱纤纤柳，朱朱白白花。\n春风最无赖，客鬓亦空华。\n草色明深径，泉声落浅沙。\n江枫千里思，醉眼向天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄盐城舍弟得书言岁大稔兼求作夫子庙记","author":"刘敞","text":"海邑近蟠桃，铜章肯许劳。\n公田都种秫，霜蟹餍持螯。\n宫庙比洙泗，弦歌通掾曹。\n想多记石柱，非复笑牛刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚁斗","author":"刘敞","text":"扰扰嗟何急，营营若有侵。\n由来穴知雨，非尔旱为霖。\n王霸强并弱，兴亡古到今。\n愿君推达观，安得异机心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒后登清风亭","author":"刘敞","text":"清笳转不极，碧水望偏多。\n醲酒春先醉，晴阳晚更和。\n起提如意舞，自击唾壶歌。\n芳树知多少，春游奈汝何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同持国过江十新作池亭三首 其一","author":"刘敞","text":"筑榭因高柳，疏泉激浅沙。\n登临容展席，游泛足浮槎。\n露盌涵醇醴，冰盘饷美瓜。\n爱君难兴尽，未醉惜还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同持国过江十新作池亭三首 其二","author":"刘敞","text":"菡萏千枝发，池塘五月秋。\n香繁初过雨，影密欲藏舟。\n鱼跃知琴乐，鸥飞为客留。\n江湖未成往，愧此意悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同持国过江十新作池亭三首 其三","author":"刘敞","text":"吏隐由来事，郊居故自宜。\n池台随意定，泉石象天为。\n珍树移时语，清风竟日棋。\n市朝情久厌，野老不相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄凤翔舍弟 其一","author":"刘敞","text":"早悟出处际，同归羁旅间。\n从军差复乐，捧檄莫思还。\n百仞磻溪水，千岩大白山。\n异时曾想见，乘兴辄跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄凤翔舍弟 其二","author":"刘敞","text":"百里异形影，况今殊楚秦。\n陇云虚引领，江月漫随人。\n愁恨西山雪，惊心绝塞尘。\n寄书悬胜梦，雁足莫嫌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞氏甥及第后赴寿春尉立别","author":"刘敞","text":"尔门大父行，俱是云霄人。\n诸孙自骏骨，高第复青春。\n试吏小山下，还家芳桂新。\n当成我宅相，宁肯滞埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝耕亭晚望田家作","author":"刘敞","text":"田庐非一处，微径自相通。\n日下耕钓息，林边言笑同。\n此虽人问俗，独有方外风。\n吾亦毕婚嫁，还从击壤翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"危楼","author":"刘敞","text":"尚有危楼在，犹传羽驾归。\n悲歌城郭是，故老姓名非。\n积水浮天宇，孤云绕翠微。\n远游悲世俗，思见菊花衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四望楼二首 其一","author":"刘敞","text":"白露参差晚，丹枫点染深。\n高楼延远恨，嘶马动归心。\n留客小山桂，愁人思妇砧。\n昏鸦稍欲集，堑黑倒城阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四望楼二首 其二","author":"刘敞","text":"展步乘幽兴，登临当远游。\n凉轩不用扇，高树自知秋。\n月出潮声涌，云生岳色浮。\n旅怀虽易失，无奈角声愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中元雨后招两漕","author":"刘敞","text":"积水吾山溢，轻风汶筱秋。\n微凉禁鲁酒，清唱发齐讴。\n小雨何须急，高云更肯留。\n知公兴不浅，能醉月边楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小雨朝归东轩","author":"刘敞","text":"小雨车马息，微风窗户虚。\n尘埃顷洒埽，蝇蚋一讴除。\n高枕华胥梦，忘言藏室书。\n不知吾丧我，安更问其馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中北轩","author":"刘敞","text":"草树朱明晚，云霓白日颓。\n幽居谁与适，山鸟独无猜。\n蠹实危将堕，衰花冷自开。\n秋光殊不意，顿入眼前来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西郊候客","author":"刘敞","text":"西郊逢故人，倾盖暂相亲。\n车马有行色，衣裳栖洛尘。\n问筇出冉笮，询道自峨岷。\n却话别时意，悠然已四春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月榭饮会","author":"刘敞","text":"清秋望不极，凉月夜还新。\n河汉初无际，山川共绝尘。\n举杯光可挹，起舞影相亲。\n此兴何曾浅，风流忆古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独行","author":"刘敞","text":"南山半云雨，天气杂暄寒。\n野兴宜独往，春愁无定端。\n鸟声来静听，柳色入遥看。\n却谢芳樽酒，悠悠谁与欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石少傅致仕","author":"刘敞","text":"独持子房计，欲伴赤松仙。\n犹行少傅事，更觉大夫贤。\n诏策容就问，子孙随拜前。\n顾嫌越相国，远泛五湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望沙楼","author":"刘敞","text":"朱轩映粉堞，遥出夕阳中。\n云雨通巫峡，江山入楚宫。\n登临馀壮观，潇洒向雄风。\n万事随陵谷，滔滔水向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨子寺送彦猷阁老去年四月某别彦猷于京师到今适期年矣","author":"刘敞","text":"一年再远别，尘世令人嗟。\n况复江湖永，空惊鬓发华。\n青山浮海上，远水即天涯。\n出处俱萍泛，悬知后会赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山","author":"刘敞","text":"万里亘东西，连峰隐朔陲。\n气缠冰雪惨，险极鬼神为。\n偪仄单车度，盘桓壮士悲。\n今朝识天意，正欲限华夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阴山","author":"刘敞","text":"阴山天下险，鸟道上棱层。\n抱石千年树，悬崖万丈冰。\n悲歌愁倚剑，侧步怯扶绳。\n更觉长安远，朝光午未升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"占晴三首 其一","author":"刘敞","text":"小雨何曾湿，轻云苦易开。\n蛟龙自喣沬，江汉欲飞埃。\n碧草寒仍短，喧禽去不回。\n楚山长对日，未信有阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"占晴三首 其二","author":"刘敞","text":"白日丽江上，初晴风景饶。\n春愁来集眼，暖气起连宵。\n旷野苍茫合，饥鸢上下飘。\n长亭送行处，稍复柳垂条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"占晴三首 其三","author":"刘敞","text":"巫峡空多雨，江南自有春。\n瘴排寒色早，晴发岁华新。\n地暖仍馀湿，风和欲起尘。\n旧伤千里目，巳复觉愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登扬州城北门予昔侍亲寓居此城下驿舍十八年矣怆然感动","author":"刘敞","text":"昔钓城下水，今来十八年。\n居人几能在，里巷独依然。\n手种成乔木，躬耕有废田。\n悲歌顾千骑，不觉涕沦涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀北归寄张四和弟","author":"刘敞","text":"安得生羽翼，超然成远游。\n探书下禹穴，问礼适东周。\n贤圣有遗迹，江山俱早秋。\n西风日夜急，无事独淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山寺","author":"刘敞","text":"水面尘土少，山头炎景微。\n蛟龙能护法，鱼鸟各忘机。\n空寂见佛事，幽閒滞客归。\n蓬莱似咫尺，拟纵海帆飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张介归山中","author":"刘敞","text":"君归湖上山，寄傲白云间。\n岩树定未改，春条应可攀。\n曾随太守荐，近揖上公还。\n知子不贪贵，令人思闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒鸦","author":"刘敞","text":"天清北风厉，日落乱鸦栖。\n望远影如叠，听长声渐低。\n月中惊不定，城上暗仍啼。\n出处乘朝夕，应无失旦迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍弟及杨十七尊兄同年登科贺彦文","author":"刘敞","text":"紫禁过从密，青云步武通。\n文章一朝盛，兄弟两家同。\n结绶轻萧育，忘年似孔融。\n相看各相喜，安得恨途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬暖","author":"刘敞","text":"南服已卑湿，隆冬方晏温。\n夏虫轻火伏，葛履易霜繁。\n谁复谋吹律，吾真笑负暄。\n爰居或避地，亦慰异乡魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山暖","author":"刘敞","text":"通谷近中原，初阳生旧年。\n欣欣林动色，漠漠野浮烟。\n鸣雉飞朝日，新芽发暖泉。\n东风彊人意，车马亦翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铜陵阻风","author":"刘敞","text":"惊浪乘风疾，浮云映水低。\n卷帆高卧熟，看鹢退飞迷。\n山远微分树，村深略辨鸡。\n蒹葭萦客恨，极望正萋萋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]