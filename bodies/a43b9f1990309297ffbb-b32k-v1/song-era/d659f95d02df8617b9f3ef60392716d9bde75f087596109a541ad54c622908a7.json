[{"title":"病起","author":"陆游","text":"山村病起帽围宽，春尽江南尚薄寒。\n志士凄凉闲处老，名花零落雨中看。\n断香漠漠便支枕，芳草离离悔倚阑。\n收拾吟笺停酒椀，年来触事动忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起小饮","author":"陆游","text":"病起新霜满鬓蓬，凭高一笑与谁同。\n酒如渌静春江水，人有鸿荒太古风。\n野寺钟来夕阳外，寒山空插乱云中。\n一官正尔妨人乐，只合沧浪狎钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起山居日有幽事戏作二首 其一","author":"陆游","text":"灵府超然外物轻，静中谈笑却三彭。\n晴窗风竹参差影，霜树山禽格磔声。\n客出异苗咨药品，僧携奇篆乞书评。\n幽居亦未全无事，更用人间有姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起山居日有幽事戏作二首 其二","author":"陆游","text":"鹤骨龟肠欲不禁，扶衰初喜罢呻吟。\n盆山冰释书窗暖，药灶香浓道院深。\n笔健乍临新获帖，手生重理旧传琴。\n闭门局促还堪恨，云海何时豁此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起书怀二首 其一","author":"陆游","text":"病骨支离纱帽宽，孤臣万里客江干。\n位卑未敢忘忧国，事定犹须待阖棺。\n天地神灵扶庙社，京华父老望和銮。\n出师一表通今古，夜半挑灯更细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起书怀二首 其二","author":"陆游","text":"酒酣看剑凛生风，身是天涯一秃翁。\n扪虱剧谈空自许，闻鸡浩叹与谁同。\n玉关岁晚无来使，沙苑春生有去鸿。\n人寿定非金石永，可令虚死蜀山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起初夏","author":"陆游","text":"头风间作已全轻，山雨虽频却快晴。\n窗外时时度花片，林梢处处送莺声。\n地偏无客谈闲事，麦熟逢人乐太平。\n不为衰迟辜节物，一瓯羊骆荐朱樱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起偶到复庵","author":"陆游","text":"经旬羸卧怯登临，偶忆东庵试一寻。\n新竹初成迷栈路，断云不散抱城阴。\n陂池绿静龟鱼乐，亭馆苍凉草树深。\n欲把一杯无奈懒，病来触目动归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起寄曾原伯兄弟","author":"陆游","text":"意象殊非昨，筋骸劣自持。\n衰如霜后木，愁抵盎中丝。\n风雪书来少，江山梦到迟。\n出门还惘惘，倚杖独移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起惫甚有叹","author":"陆游","text":"残年迫衰谢，一病不枝梧。\n书倩傍人读，行须稚子扶。\n冥心付天地，毕世钓江湖。\n无米博佳传，虚名那可图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起镜中见白发此去七十无十寒暑矣偶得长句","author":"陆游","text":"短鬓萧条失故青，人间真似宿邮亭。\n正令宽作十年梦，安用更留三日醒。\n覆瓿书成空自苦，击辕歌罢遣谁听。\n客来若觅衰翁处，睡起悠然倚素屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病酒述怀","author":"陆游","text":"闲处天教著放翁，草庐高卧笮桥东。\n数茎白发悲秋后，一盏青灯病酒中。\n李广射归关月堕，刘琨啸罢塞云空。\n古人意气凭君看，不待功成固已雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病减","author":"陆游","text":"病减停汤熨，身衰赖按摩。\n书亏平日课，睡比故年多。\n龟卜占休泰，医方校阙讹。\n有时还一笑，隔浦起渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病著","author":"陆游","text":"病著今年剧，衰来次第新。\n茅茨安久处，刍豢罢前陈。\n零落闲边句，逍遥事外身。\n村东褚草蕈，一笑得常珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病稍平示儿辈","author":"陆游","text":"人与鸦俱晓，天凭雁送秋。\n极知生意尽，彊为汝曹留。\n药饵倾残橐，风霜迫故裘。\n倚屏搔短发，且复寄悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病愈","author":"陆游","text":"秋夕高斋病始轻，物华凋落岁峥嵘。\n蟹黄旋擘馋涎堕，酒渌初倾老眼明。\n提笔诗情还跌宕，倒床药裹尚纵横。\n闲愁恰似憎人睡，又起挑灯听雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病愈","author":"陆游","text":"倦榻呻吟每自哀，占蓍来告出馀灾。\n自能洗研拂书几，时亦折花寻酒杯。\n久类寒蛟潜岫穴，忽如老马喷风埃。\n霜晴烂熳东窗日，一笑山坡访早梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病愈偶书","author":"陆游","text":"枯蓬万里寄飘风，晚落江头号放翁。\n冉冉流年秋镜里，悠悠残梦晓笳中。\n扫除药裹病良已，弃置酒杯愁自空。\n闲处固应容老子，卧看年少起新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真珠园雨中作","author":"陆游","text":"清晨得小雨，凭阁意欣然。\n一扫群儿迹，稍稀游女船。\n烟波蘸山脚，湿翠到阑边。\n坐诵空濛句，予怀玉局仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离成都后却寄公寿子友德称","author":"陆游","text":"萧条常闭爵罗门，点检朋侪几个存。\n吾道将为天下裂，此心难与俗人言。\n逢时尚可还三代，掩卷何由作九原。\n寄语龟城旧交道，新凉殊忆共清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离嘉州宿平羌","author":"陆游","text":"初挈囊衣宿水村，萧然一扫旧巢痕。\n本来信手忘工拙，却为无心少怨恩。\n自笑远游谙马上，已营小筑老云根。\n淡烟疏雨平羌路，便恐从今入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦皇酒瓮下垂钓偶赋","author":"陆游","text":"酒瓮山边古钓矶，沙鸥与我共斜晖。\n目前虽有小得丧，天下岂无公是非。\n沧海横流何日定，古人复起欲谁归。\n道边醉倒君奚憾，岂失风尘一布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕桑","author":"陆游","text":"老病虽俱至，耕桑亦未迟。\n儿童誇犊健，妇女闵蚕饥。\n月落枭鸣夜，灯残鼠啮时。\n但当寻熟睡，万事不须思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胸次郁郁偶取枯笔作狂草遂成长句","author":"陆游","text":"酒隐人间六十年，晚途敛板自伤怜。\n庄周聊寄漆园吏，梅福终为吴市仙。\n方外酒徒盟尚在，囊中剑术老当传。\n此心郁屈何由豁，聊遣龙蛇落蜀笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后岁事有望欣然赋诗","author":"陆游","text":"圣时恩厚赐馀生，日与乡闾乐太平。\n已弃胡床无长物，尚携拄杖有同行。\n新裁乌帽人争看，小摘青蔬手自烹。\n买得水车无用处，绝知造物相归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后述怀六首 其一","author":"陆游","text":"弹冠绍兴末，解组庆元中。\n滟滪危涂过，邯郸幻境空。\n闲传相牛法，醉挟斗鸡翁。\n冲雨归来晚，山花满笠红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后述怀六首 其二","author":"陆游","text":"壮岁江湖去，还朝六十馀。\n辈流俱已尽，勋业固知疏。\n遽走宁黔突，长闲祇荷锄。\n如今更何憾，终作爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后述怀六首 其六","author":"陆游","text":"店店容赊酒，家家可乞浆。\n白陂时雨足，绿树午阴凉。\n病为休官减，门缘谢客荒。\n今朝遇邻叟，满意说丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后述怀六首 其五","author":"陆游","text":"韦布还初服，蓬蒿卧故庐。\n所惭犹火食，更恨未巢居。\n叱叱驱黄犊，行行跨白驴。\n交亲各强健，不必问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后述怀六首 其四","author":"陆游","text":"昔自台郎斥，频年困负薪。\n四叨优老禄，十送故乡春。\n衰瘁宁知活，萧条敢厌贫。\n惟思逢乐岁，击壤学尧民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致仕后述怀六首 其三","author":"陆游","text":"生理虽贫甚，胸中颇浩然。\n常辞问字酒，屡却作碑钱。\n宁有骆堪鬻，尚无车可悬。\n小须梅雨霁，散发醉江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致语口号二首 其二","author":"陆游","text":"凉月参差白露漙，请看宾主罄清欢。\n麟符玉节交相映，凤竹鸾丝殊未阑。\n百谷方登仓庚足，七州无事里闾安。\n樽前莫惜山颓玉，四者能兼自古难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致语口号二首 其一","author":"陆游","text":"曾立蛾眉禁省班，至今风采照金銮。\n纵横笔阵千人废，浩荡辞源万顷宽。\n落纸烟云纷态度，照人冰玉峙高寒。\n从容坐啸香凝寝，说与宾僚拭目观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷锄","author":"陆游","text":"五亩畦蔬地，秋来日荷锄。\n何曾笑尔辈，但觉爱吾庐。\n胆怯沽官酿，瞳昏读监书。\n区区尚多事，未解杂樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫仲谦挽词","author":"陆游","text":"怀器潜山泽，逢时起薜萝。\n星辰占宝剑，雷雨化龙梭。\n禹穴书虽富，浯溪石未磨。\n门闾更须筑，有子继三科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫笑","author":"陆游","text":"莫笑穷阎叟，人生亦已稀。\n众中容后死，险处得先归。\n初服还韦布，晨餐美蕨薇。\n床头周易在，舍此复畴依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰叹","author":"陆游","text":"十年三堕齿，久矣叹吾衰。\n亹亹循天理，兢兢到死时。\n穷空颜子巷，勤苦董生帷。\n道远馀生趣，常忧日影移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰疾","author":"陆游","text":"衰疾支离负圣时，犹能采菊傍东篱。\n捉衿见肘贫无敌，耸膊成山瘦可知。\n百岁光阴半归酒，一生事业略存诗。\n不妨举世无同志，会有方来可与期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰疾","author":"陆游","text":"衰疾犹能饭一箪，莼丝菰首亦加餐。\n旧叨刻印俄销印，老愧弹冠亟挂冠。\n自怪嵇康如许懒，人怜范叔不胜寒。\n得钱剩买青芒屦，采药名山兴未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰疾","author":"陆游","text":"衰疾怜新鬼，狂豪尚故吾。\n棋常先客著，行不许儿扶。\n砚润闲蟾滴，香残冷鸭炉。\n自怜风味在，尚欲泛江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病","author":"陆游","text":"衰病集馀日，推移成老翁。\n衡门隐者趣，大布古人风。\n几杖呻吟里，山川苍莽中。\n从来世缘簿，不是坐诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病二首 其二","author":"陆游","text":"病除犹老健，雨止得冬晴。\n觅句嗟心在，钞书试眼明。\n朝寒添布褐，晚步出柴荆。\n外慕终无益，儿曹且力耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病二首 其一","author":"陆游","text":"衰病不浪出，闭门烟雨中。\n苇花添絮暖，葑火试炉红。\n仕宦蚁窠梦，功名马耳风。\n山翁但更事，人看作神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病","author":"陆游","text":"衰病龙钟已要扶，谁怜犹作折腰趋。\n世无鲁国真男子，心忆高阳旧酒徒。\n万里秋风吹鬓发，百年世事叹头颅。\n桐江久客无奇句，孤负君王乞左符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病有感三首 其二","author":"陆游","text":"倦枕先鸡觉，寒汀伴雁孤。\n寂寥谁省录，衰疾且枝梧。\n鹤骨秋添瘦，龟肠夜自呼。\n盖棺吾事定，未敢泣穷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病有感三首 其三","author":"陆游","text":"羁宦一周星，归如化鹤丁。\n灰心成寂寂，霜鬓失青青。\n小智空自贵，大愚元不灵。\n客来应绝倒，扶病讲丹经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衰病有感三首 其一","author":"陆游","text":"衰与病相乘，山房冷欲冰。\n在家元是客，有发亦如僧。\n愁绝穷秋雨，情亲独夜灯。\n西邻有甘井，聊得曲吾肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袖手","author":"陆游","text":"袖手地炉傍，身闲日自长。\n窗明蠹简字，帘约篆盘香。\n道士传琴谱，山僧送药方。\n自然尘事远，不用濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"被酒径卧比觉已五鼓矣","author":"陆游","text":"俗事驱人挽不回，经年无地濯氛埃。\n酒酣稍觉客愁破，睡觉忽闻山雨来。\n窗外树寒无鸟宿，壶中水暖有梅开。\n五更欲起先惆怅，烛下文书已作堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"两两星躔九九车，天津笑我醉骑驴。\n床头正可著周易，架上何妨抽汉书。\n幸有古人同臭味，不嫌儿子似迂疏。\n颓然白发虽堪鄙，耐事禁愁却有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"远遁江湖上，端居风雨中。\n纸新窗正白，炉暖火通红。\n签帙方重整，声形且细穷。\n扶衰倘未死，更破十年功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"束发论交一世豪，暮年憔悴困蓬蒿。\n文辞博士书驴券，职事参军判马曹。\n病里犹须看周易，醉中亦复读离骚。\n若为可奈功名念，试觅并州快剪刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"稽古衰犹力，翻书夜达晨。\n思人频掩卷，感事忽沾巾。\n世阅几春梦，身今一老民。\n忍穷端已惯，蔬食又经旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"先亲爱我读书声，追慕慈颜涕每倾。\n万事到前心尽懒，一编相向眼偏明。\n致君正使违初志，为己犹当毕此生。\n更祝吾儿思早退，雨蓑烟笠事春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"少从师友讲唐虞，白首襟怀不少舒。\n旧谓皆当付之酒，今知莫若信吾书。\n朱黄参错鸡鸣后，签帙从横月堕初。\n抚几欣然时有得，此翁作计未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书","author":"陆游","text":"读书肝胆尚轮囷，蠹简堆中著此身。\n饱识三千馀岁事，已为七十四年人。\n镜中衰鬓难藏老，海内虚名不救贫。\n只欲从今都扫尽，剩沽春酒答新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书有感","author":"陆游","text":"洙泗诸生尊所闻，岂容兀者亦中分。\n焚经竞欲愚黔首，亡史谁能及阙文。\n吾道固应千古在，几人虚用一生勤。\n世间倚相何曾乏，会与明时诵典坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读仙书作","author":"陆游","text":"与世已如风马牛，松风终日听飕飗。\n一炉丹熟定不死，半瓮酒香安得愁。\n腰带鞓前秋万顷，香炉峰下水交流。\n人间事事皆须命，惟有神仙可自求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史","author":"陆游","text":"夜对遗编叹复惊，古来成败浩纵横。\n功名多向穷中立，祸患常从巧处生。\n万里关河归梦想，千年王霸等棋枰。\n人间只有躬耕是，路过桑村最眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史","author":"陆游","text":"青灯耿耿夜沉沉，掩卷凄然感独深。\n恤纬不遑嫠妇叹，美芹欲献野人心。\n孤忠要有天知我，万事当思后视今。\n君看宣王何似主，一篇庭燎未忘箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史有感","author":"陆游","text":"英雄自古埋秋草，世上儿童共笑狂。\n射贼曾飞白羽箭，闭门空枕绿沉枪。\n隆中高卧人千载，易水悲歌泪数行。\n读尽青编窗日晚，一尊聊复吊兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读老子","author":"陆游","text":"道德五千言，巍巍众妙门。\n管窥那见豹，指染仅尝鼋。\n正尔分章句，谁欤达本源。\n蜀庄犹不死，过我得深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读李杜诗","author":"陆游","text":"濯锦沧浪客，青莲澹荡人。\n才名塞天地，身世老风尘。\n士固难推挽，人谁不贱贫。\n明窗数编在，长与物华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读穷居五字慨然有感复作一首自解","author":"陆游","text":"布褐营身足，茅茨置榻宽。\n食非依漂母，菜不仰园官。\n小蹇鞍鞯黑，羸僮骨相酸。\n丹青能写此，千载尚传观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读宛陵先生诗","author":"陆游","text":"欧尹追还六籍醇，先生诗律擅雄浑。\n导河积石源流正，维岳崧高气象尊。\n玉磬漻漻非俗好，霜松郁郁有春温。\n向来不导无讥评，敢保诸人未及门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读宛陵先生诗","author":"陆游","text":"李杜不复作，梅公真壮哉。\n岂惟凡骨换，要是顶门开。\n锻鍊无遗力，渊源有自来。\n平生解牛手，馀刃独恢恢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读经示儿子","author":"陆游","text":"通经本训诂，讲字极声形。\n未尽寸心苦，已销双鬓青。\n惧如临战阵，敬若在朝廷。\n此是吾家事，儿曹要细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]