[{"title":"送杰老住仙游 其九","author":"唐士耻","text":"端坐阅四时，烂然各有第。\n新篇敌岛可，邮筒当数寄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杰老住仙游 其六","author":"唐士耻","text":"白云每亭亭，其出亦何心。\n贤侯考之天，无谓由蹄涔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杰老住仙游 其三","author":"唐士耻","text":"差入栴檀林，自古只公选。\n乃知天定时，丹成骨自换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杰老住仙游 其四","author":"唐士耻","text":"仙游知几年，晨香梵古佛。\n人移境亦移，高风日披拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杰老住仙游 其五","author":"唐士耻","text":"一瓶还一钵，作戏且逢场。\n会看走鹤书，横宝今道傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送临江交代张司理","author":"唐士耻","text":"子房帝王师，溢庆流裔孙。\n朅来之萧滩，快睹芝眉温。\n亭亭起黄气，中有阴德存。\n宜哉孔融表，辐辏排天阍。\n通籍何足道，履声还青毡。\n嗟我一何幸，夤缘踵符文。\n自顾菲且愚，续貂诚所难。\n承颜一甲子，夙昔披晤言。\n柳浓烟冥冥，鹢舟江吐吞。\n顺流急如箭，催鼓且勿喧。\n为语徒作恶，且尽沙头尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题蠲流亭","author":"唐士耻","text":"乌伤仇览仙，一弓扁蠲流。\n清流从谁蠲，浊流石之幽。\n石之幽定可，齿齿翻成忧。\n君看得失珠，象罔无全牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿槐阴","author":"唐士耻","text":"槐阴似尼父，轶轨追前踪。\n绝尘非学步，所产夐无双。\n今此于越东，钟孕亦鸿庞。\n朅来于越西，掌教开群迷。\n群迷于今正有赖，肯使玉佩从他之。\n昔人种槐根细细，坐阅日月蝉已栖。\n历聘辙环嗟不遇，岂若今日廊庙归。\n要俾六经日益明，俗还唐虞熙又熙。\n槐阴虽异道则一，彼不见用吾登跻。\n宇宙虽云宏且邈，理焉所在成均齐。\n槐阴槐阴异今昔，一则不用一明陟。\n道在六经道固存，道出六经道还得。\n洪哉尼父怀此道，今日谁知归探讨。\n探讨既力道不殊，三都遂隳陈常讨。\n天骄立可倾，神州立可清。\n一祖八宗地，教化登升平。\n先生为黄发，自可七六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题彭绍墨","author":"唐士耻","text":"彭绍之墨玄又玄，问谁得法托之仙。\n凌烟胶漆有三昧，鲁直之什曹洞禅。\n我欲大振狮子吼，直恐惊翻龙象筵。\n纷纷是事但且置，一言为语千金廉。\n唐人五字魂绕天，箕敛四大归新篇。\n空馀句法落寰海，豆萁不觉相熬煎。\n中原可复墨可黔，鬓丝白发知何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠浩然观胡道士","author":"唐士耻","text":"只为丹霄足羽軿，且将奇法验人寰。\n从他血肉并烟火，自有仙家九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴下同年会诗","author":"唐子寿","text":"人生会少足睽违，尊酒相从又复稀。\n我叹散材谁见数，公持华节幸相依。\n题名雁塔思当日，曳屣龙门借夕晖。\n会见十行来日下，禁涂高处看横飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"唐子真","text":"六六峰从云外立，三三人出洞中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日赠僧","author":"唐介","text":"今日是重阳，劳师访野堂。\n相逢又无语，篱下菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明王寺","author":"唐介","text":"日高霞散彩，松老鹤巢枝。\n坏壁诗犹在，纱笼何用之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴桐庐郡淮上遇风三首 其一","author":"范仲淹","text":"圣宋非强楚，清淮异汨罗。\n平生仗忠信，尽室任风波。\n舟楫颠危甚，蛟鼋出没多。\n斜阳幸无事，沽酒听渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧落洞","author":"唐介","text":"余生本孤拙，所志在云石。\n薄宦偶缠锁，未遂林泉适。\n迩来备台选，幸一当言责。\n狂愚抵罪辜，遽从遐徼谪。\n区区数千里，车马倦行役。\n浈阳颇善地，解辔喜安席。\n官散无所事，度日多闲隙。\n太守苏宣甫，邀我访奇迹。\n西山有石室，疑是灵仙宅。\n翛然烟径入，讶若天门辟。\n中泻一溪清，傍映千峰碧。\n万穴滴瑶乳，两岸张翠幕。\n爽气来先秋，昏岚生未夕。\n不知造化意，何为置穷僻。\n周生说到难，兹文不虚摭。\n怪容诚莫状，胜迹今始获。\n暂已瑩耳目，久觉生虚白。\n拂拭缨上尘，回头谢朝客。\n虽非吾所乐，聊以慰奇只。\n圣恩未放还，屡游君莫惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"唐介","text":"著要及春前后到，趁赋梅花庾岭东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王氏小园","author":"唐从龙","text":"山脉钟云气，新晴散紫霞。\n玉藏云里石，金落水中沙。\n瘦鹤依疏竹，饥蜂恋落花。\n临池看洗砚，知是右军家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华盖山","author":"唐元龄","text":"巍然独立九霄中，势压衡庐亘华嵩。\n捣药声高蟾阙近，乘槎路渺鹊桥通。\n三更见日生沧海，六月飞霜下翠空。\n好挟千年王子晋，玉笙轻度碧桃风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郁林寺","author":"唐元龄","text":"一径通深窈，丛林独蔚然。\n神仙栖佛屋，香火当僧田。\n罕见催租吏，谁谈文字禅。\n吴侬来拜朔，偻指满三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"象眠山","author":"唐元龄","text":"作县苦无俄顷閒，喜逢佳节一开颜。\n无人送酒来彭泽，有客登临嗣鲁山。\n慨想鹤汀凫渚外，盘桓鳌水象峰间。\n赏心未尽天将晚，剩插黄花带月还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟雨楼","author":"唐天麟","text":"百尺楼高足赏心，我来犹记旧登临。\n四时天色有晴雨，一片湖光无古今。\n远塔连云知寺隐，小舟穿柳觉村深。\n凭阑多少斜阳景，分付渔歌替晚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以日者命状寄王龟龄","author":"唐文若","text":"试把流年子细看，休将蠖屈比鹏抟。\n君家大有回天力，不为区区作好官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题绍兴焕文阁 其二","author":"唐文若","text":"三峨直上片云飞，飞过匡庐惹住衣。\n我亦朱轓暂容与，山南山北判清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题绍兴焕文阁 其一","author":"唐文若","text":"山光水色借春妍，登尽参差下九天。\n共看玉泉香案吏，重来点检白云篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登金山","author":"唐文若","text":"江流出岷蜀，万折东南倾。\n兹山若巨舫，势欲扼沧溟。\n天高象教尊，海岳朝百灵。\n云水渺四极，下上涵日星。\n朱甍倚霄汉，倒影鱼龙惊。\n重游十年旧，挂席鸥鸟轻。\n维扬魏公幕，回首剑戟明。\n行都望北固，铁瓮高峥嵘。\n孤舟系烟月，六尺僧窗横。\n印师支远俦，静对如风铃。\n旷怀怜此翁，得法世虑平。\n尘劳霜发秃，风月冰壶清。\n乞诗写崖壁，指月双浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"唐文若","text":"阳安城西百尺楼，画栋翚飞出鳌岭。\n蜀汉东南此地分，胜槩悠悠谁复领。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天香 宛委山房拟赋龙涎香","author":"唐艺孙","text":"螺甲磨星，犀株杵月，蕤英嫩压拖水。\n海蜃楼高，仙蛾钿小，缥缈结成心字。\n麝煤候暖，载一朵、轻云不起。\n银叶初生薄晕，金猊旋翻纤指。\n芳杯恼人渐醉。\n碾微馨、凤团闲试。\n满架舞红都换，懒收珠佩。\n几片菱花镜里，更摘索双鬟伴秋睡。\n早是新凉，重薰翠被。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐 馀闲书院拟赋蝉","author":"唐艺孙","text":"柳风微扇闲池阁，深林翠阴人静。\n渐理琴丝，谁调金奏，凄咽流空清韵。\n虹明雨润。\n正乍集庭柯，凭阑新听。\n午梦惊回，有人娇困酒初醒。\n西轩晚凉又嫩。\n向枝头占得，银露千顷。\n蜕剪花轻，羽翻纸薄，老去易惊秋信。\n残声送暝。\n恨秦树斜阳，暗催光景。\n淡月疏桐，半窗留鬓影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂枝香 天柱山房拟赋蟹","author":"唐艺孙","text":"收帆渡口。\n认远岸夜篝，松炬如昼。\n还见沙痕雪涨，水纹霜后。\n秦宫梦到无肠断，望明河、月斜疏柳。\n琐窗相对，茶边犹记，眼波频溜。\n渐嫩菊、初篘绿酒。\n叹风味尊前，潇洒如旧。\n几度金橙香雾，玉盘纤手。\n清愁小醉凄凉里，拼今生、容易消瘦。\n草心春浅，年年相忆，看灯时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云峰院","author":"唐仲友","text":"木杪出危阁，轩窗罗翠屏。\n更须登石望，欲尽远山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代家君答闻老诗三首 其三","author":"唐仲友","text":"江山天借使诗昌，太守风流似沈郎。\n莫作推敲冲导其，好携佳句过黄堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代家君答闻老诗三首 其二","author":"唐仲友","text":"附热衔泥不足言，尔来杖锡亦纷然。\n不趋炉炭趋寒谷，青白于中觉汝贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代家君答闻老诗三首 其一","author":"唐仲友","text":"流水高山举似谁，我惭善听匪钟期。\n三诗历历皆可语，彷佛当时病可师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行登新现潭 其二","author":"唐仲友","text":"薄雨轻云掩翠微，丰年何物不熙熙。\n拒霜也效嫣然笑，白白红红出短篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行登新现潭 其一","author":"唐仲友","text":"荞麦花齐晚稻黄，今年此地是仙乡。\n篮舆又作山中去，敬为神龙一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村舍","author":"唐仲友","text":"草色红泉井，桐阴白板扉。\n徘徊不忍去，坐待白云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其二","author":"唐仲友","text":"点缀何曾待化人，密房琐琐暗藏春。\n定应昔与江梅友，惹得清香尚满身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其十三","author":"唐仲友","text":"一点轻明照雪开，六花惊妒亦徘徊。\n清香不在江梅后，底事全无驿使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其三","author":"唐仲友","text":"袂剪黄罗亦可人，君诗剩觅小园春。\n最怜丈室铜瓶里，独对维摩似病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其十","author":"唐仲友","text":"只恐幽花取次开，哦诗忍冻几徘徊。\n莫猜野服风情浅，解把天香暗里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其四","author":"唐仲友","text":"黄姑侍女两三人，散作名家不嫁春。\n仙桂飘零篱菊尽，香容付与雪中身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其十一","author":"唐仲友","text":"甚欲陪君酒瓮开，寒侵病骨却徘徊。\n不辞更琢金仙句，图得抛砖换玉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其九","author":"唐仲友","text":"长伴南枝带雪开，浑无蜂蝶去徘徊。\n可能熟识金仙面，只有诗人日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其一","author":"唐仲友","text":"此花清绝似幽人，苦耐冰霜不爱春。\n蜡蕊轻明香万斛，黄姑端的是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其十五","author":"唐仲友","text":"积雪愁阴久不开，为怜花冷故徘徊。\n凭君琢句留金蕊，待取霜风送月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其七","author":"唐仲友","text":"的皪光明色照人，枝头已有十分春。\n我惊唤作菩提树，为是如来幻化身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其六","author":"唐仲友","text":"山麝时时暗袭人，蔷薇露湿满枝春。\n若教粉蝶知音耗，应怨韶华枉误身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其八","author":"唐仲友","text":"不管江梅妒杀人，壶中日月已先春。\n恰如姑射神仙子，野服高闲物外身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其十二","author":"唐仲友","text":"为爱凌晨细细开，谁人伴我独徘徊。\n朝阳满树无尘滓，寒雀惊窥欲下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其五","author":"唐仲友","text":"日暮天寒倚竹人，淡妆别有一般春。\n紫橐深贮香无限，金缕初裁稳称身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅十五绝和陈天予韵 其十四","author":"唐仲友","text":"几岁岩扃独自开，何人立马为徘徊。\n只因坡谷传佳句，惹得寻春使少来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长台途中","author":"唐仲友","text":"冲晓入山去，行行遵远途。\n滩头横略彴，林表出浮图。\n麦饭田家饷，松醪野店酤。\n红尘自扰扰，心与白云孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次季弼索杨继甫诗 其一","author":"唐仲友","text":"诗来得得巧搜寻，清似壶冰洗我心。\n白雪阳春皆绝唱，高山流水欠知音。\n秦淮淼淼涵秋影，楚岸迢迢起夕阴。\n此际须君速相就，寒鸦趁侣欲投林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次季弼索杨继甫诗 其二","author":"唐仲友","text":"爱山欲作杪秋寻，薄宦逢回倦壮心。\n排遣牢愁须鲁酒，激扬逸气和春音。\n归与物色荒山径，晚矣功名惜寸阴。\n寂寞孤芳聊自守，不殊兰芷在深林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛丑正月上休日谒灵康庙拜滕公祠","author":"唐仲友","text":"苍山馀雪在云端，五两摇风减晓寒。\n谷应笙簧成两部，日涵烟水上三竿。\n相逢戏事留仙传，如在英魂激壮肝。\n分职幽明均报国，愿神终赐免空官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨花台 其一","author":"唐仲友","text":"竟夕飞花一尺围，今朝晴色荷神禧。\n共寻萧寺因乘兴，直上高台是爱奇。\n鳷鹊馀寒通北极，凤凰斜照落西垂。\n诗成似得江山助，莫遣金陵胜侣知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨花台 其三","author":"唐仲友","text":"因时兴灭易成空，更向层台觅旧踪。\n江渚馀寒栖白鹭，山岗晴色转青龙。\n风烟暖入千林景，丝管春生万井容。\n堪笑冷官诗思苦，绝尘高韵以难从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺孙知从改章服","author":"唐仲友","text":"蚤岁蹉蛇晚节全，举觞犹自吸长川。\n紫泥优渥逢熙事，朱绂荣华慰暮年。\n强效琼杯哦庆语，欲将铁杖寿真仙。\n明堂尚有蒲轮召，未许终闲野水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱守归朝除大农二首 其二","author":"唐仲友","text":"贱迹归田里，高怀不世情。\n细倾忧国酒，频话及时耕。\n紫橐恩将近，茅茨计未成。\n攀辕无好语，所愿达时英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱守归朝除大农二首 其一","author":"唐仲友","text":"北海廉平守，曾为汉大农。\n此邦高治行，今日继前风。\n饥馑难于政，循良茂厥功。\n好将清静对，推与四方同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绣川湖","author":"唐仲友","text":"众水汇山麓，平湖天宇宽。\n千家连岛屿，十里带林峦。\n柳长波澜阔，荷衰风月寒。\n吾将乘一棹，谁与办纶竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读章嘉甫诗","author":"唐仲友","text":"句法亡来久，诗坛忽有人。\n看君哦字苦，胜我食芝新。\n国史空遗恨，竿门未识真。\n尚须樽酒细，非效捧心颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅","author":"唐仲友","text":"凌寒不独早梅芳，玉艳更为一样妆。\n懒著霓裳贪野服，自然仙骨有天香。\n轻明最是宜风日，冷淡从来傲雪霜。\n欲识清奇无尽处，中间深佩紫罗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元应善利真人祠 其九","author":"唐仲友","text":"外传炯遗迹，真诰垂微言。\n子微有妙笔，罗列丹青传。\n我生后诸子，倾心慕真诠。\n像设俨如在，白云聊续篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元应善利真人祠 其二","author":"唐仲友","text":"吹笙洛阳道，邂逅浮邱公。\n方瞳一莫逆，精思嵩高峰。\n剑舄我何有，飞驭凌刚风。\n时闻凤凰鸣，隐隐丹霞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元应善利真人祠 其三","author":"唐仲友","text":"弦月何皎皎，缑山何巍巍。\n上有白鹤驾，聊与时人期。\n后天凋三光，何必千年归。\n金阙帝有命，吾非丁令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]