[{"title":"任公仙台祠堂","author":"陈铸","text":"任公何代此升仙，万仞仙台倚翠巅。\n石径层层封绿藓，松萝步步拂青烟。\n海中岛屿分诸国，野外云霞萃一川。\n贤守乘秋纵登赏，不妨吟到夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈铸","text":"云头落日半规明，林际炊烟一抹横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈雄飞","text":"处顺心恒逸，无求道乃高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临川桥歌","author":"陈骙","text":"壮兮沧溟跨蛟龙，丽兮霄汉垂螮蝀。\n疑若有神施磨砻，巩然不动如华崧。\n环瞻山幄凝翠空，俯睨溪纹织微风。\n夜半横浮沆瀣中，朝来掩映扶桑红。\n车马飒沓西复东，宏规硕利繄谁功。\n竞将大年寿我公，愿与此桥俱无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"陈鹄","text":"莫待柳吹绵。\n吹绵时杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈嗣昭","text":"二十四州称小桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈廓","text":"沧江练绕清晖阁，古榭苔封燕喜碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 赠九霞子鞠九思","author":"陈楠","text":"夺取天机妙，夜半看辰杓。\n一些珠露，阿谁运倒稻花头。\n便向此时采取，宛如碧莲合蕊，滴破玉池秋。\n万籁风初起，明月一沙鸥。\n紫河车，乘赤凤，入琼楼。\n谓之玉汞，与铅与土正相投。\n五气三花聚顶，吹著自然真火，炼得似红榴。\n十月胎仙出，雷电送金虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真珠帘 赠海南子白玉蟾","author":"陈楠","text":"金丹大药人人有。\n要须是、心传口授。\n一片白龙肝，一盏醍醐酒。\n只为离无寻坎有。\n移却南宸回北斗。\n好笑。\n见金翁姹女，两个厮斗。\n些儿铅汞调匀，观汉月海潮，抽添火候。\n一箭透三关，方表神仙手。\n兔子方来乌处住，龟儿便把蛇吞了。\n知否。\n那两个钟吕，是吾师友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南 其三","author":"陈楠","text":"内外变，八转始还元。\n地带长垂主坎户，周行胎息贯天门。\n太始道方存。\n纯一体，赤黑气常喷。\n丹火发时烧内景，冷泉涌处浴猴孙。\n神水赤龟吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南 其一","author":"陈楠","text":"毛发薄，三转运行阳。\n胎色渐红阴渐缩，推移岁运助阳刚。\n育火养中央。\n成物象，五转辨微茫。\n出入尚迟形上小，晨昏时饮玉壶浆。\n天籁奏笙簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南/忆江南 其二","author":"陈楠","text":"丹已返，四转运行阴。\n逢六闭藏阳户气，三关全透合丁壬。\n龟游任浮沉。\n时出入，无碍贯他心。\n游戏神通常出面，圆光周匝绕千寻。\n寒暑不相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 赠蛰虚子沙道昭","author":"陈楠","text":"红莲含蕊，露珠凝碧，飞落华池滴滴。\n运归金鼎唤丁公，炼得似、一枚朱橘。\n三花喷火，五云拥月，上有金胎神室。\n洞房云雨正春风，十个月、胎仙了毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈槐卿","text":"谁能作文冢，反魂为瘗埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈槐卿","text":"浩叹但伤前辈少，此怀难与俗人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玩鸥亭","author":"陈槩","text":"雨后方池碧涨秋，玩鸥亭槛俯清流。\n时看雪翅轻披縠，忽见霜毫细滚毬。\n来往径随蘋岸戏，浮沉争逐晚潮游。\n吾心久欲同斯乐，早已忘机共倡酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春","author":"陈睦","text":"小雪初晴，画舫明月，强饮未眠。\n念翠鬟双耸，舞衣半卷，琵琶催拍，促管危弦。\n密意虽具，欢期难偶，遣我离情愁绪牵。\n追思处，奈溪桥道窄，无计留连。\n天天。\n莫是前缘。\n自别后、深诚谁为传。\n想玉篦偷付，珠囊暗解，两心长在，须合金钿。\n浅淡精神，温柔情性，记我疏狂应痛怜。\n空肠断，奈衾寒漏永，终夜如年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"陈睦","text":"鬓云斜坠。\n莲步弯弯细。\n笑脸双蛾生多媚。\n百步兰麝香喷。\n从前万种愁烦。\n枕边未可明言。\n好是蓝桥再渡，玉篦还胜金钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清虚堂","author":"陈简轩","text":"闭门潇洒入窗明，一洗浮生梦幻情。\n夜月静移花下影，晓风轻度竹间声。\n天空寥廓人孤坐，地耸高寒鹤不惊。\n满眼青山云散尽，恍疑身世在蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉芙蓉","author":"陈简轩","text":"璚姬秋宴集蓬壶，酒晕微微上雪酥。\n笑倚西风浑不定，因临流水欲相扶。\n绿云香减霜初冷，红玉痕消日又晡。\n妆镜明朝见真色，不知犹带宿酲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游云门","author":"陈蒙","text":"杖策耶溪寺，风流忆晋唐。\n门深云未散，梁古帖犹香。\n晚翠千峰远，春深一涧长。\n徘徊松影下，觅句向斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虞山","author":"陈蒙","text":"野店杏花红满枝，江南天气早春时。\n青山笑我来何晚，白发催人老不知。\n云窦雪消龙涧满，星坛树偃鹘巢危。\n明朝欲尽登临兴，还赴云间羽士期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题玉芝祠","author":"陈蒙","text":"玉芝不见草萧萧，古柏阴廊昼寂寥。\n琳馆废来馀福地，名碑留在记前朝。\n碧梧树老鸾飞远，华表天空鹤去遥。\n惟有迎仙桥上月，夜深还自照吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穿山","author":"陈蒙","text":"石门空虚谁凿辟，薜荔挂影苍苔积。\n悬崖偃树鹘栖巢，古洞出云龙启蛰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别","author":"陈虞之","text":"柳湿征衫晚出关，荒城古雪剑花寒。\n西风漠漠龙沙路，马上青山带醉看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山水小景","author":"陈虞之","text":"千年老树立苍石，三峰两峰天出云。\n青溪道士坐船上，自按玉箫人不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过周墩堡","author":"陈裔长","text":"地坦容车马，城空绝戍楼。\n几家烟火在，风露冷松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游玉岩 其一","author":"陈谨","text":"预作重阳半日游，行厨望客属鳌头。\n樽前绿橘当时果，岭下清泉彻夜流。\n新竹未斑秋正好，晚禾才熟岁仍收。\n使君须尽登临兴，行捧天书未许留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与客夜饮蜡烛有花客请赋之","author":"陈鉴之","text":"圆蒲促坐话情真，蜡炬能花似有神。\n毕竟蜂须膏馥在，酒边依旧十分春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月下见桂花欣然会心赋二十八字","author":"陈鉴之","text":"万卉千葩春事足，一岩桂自壮秋光。\n清泠风露月侵午，天上人间相对香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守斋和张倅古岩诗予用韵赋三绝呈守斋 其二","author":"陈鉴之","text":"贰车林下喜逢僧，眼底千峰逸兴生。\n五马未游心已到，吟笺零乱岫云清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守斋和张倅古岩诗予用韵赋三绝呈守斋 其一","author":"陈鉴之","text":"天然石屋两三僧，趺坐寒云几上生。\n想见瓦炉烟断处，一函经对万松清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守斋和张倅古岩诗予用韵赋三绝呈守斋 其三","author":"陈鉴之","text":"澹泊贤侯似衲僧，功深心地枣梨生。\n画堂歌舞聊娱客，客退依然禅榻清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"陈鉴之","text":"淋雨何人记子桑，朱门车马涨尘黄。\n百年友谊须英概，画虎何妨效季良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和友人题唐明皇杨太真对弈图","author":"陈鉴之","text":"风流阵退却围棋，心醉妖妍落子迟。\n还记兵行南诏否，输赢应不到双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒋实斋出示孟浩然画像因赋二绝 其二","author":"陈鉴之","text":"诵诗纵不忤龙颜，荣贵无过是好官。\n未必一僮随瘦马，千年传作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒋实斋出示孟浩然画像因赋二绝 其一","author":"陈鉴之","text":"吟鞭遥指鹿门归，水色山光件件诗。\n缩项鳊鱼元自好，当年应悔识王维。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题村学图","author":"陈鉴之","text":"田父龙钟雪色髯，送儿来学尚腰镰。\n先生莫厌村醪薄，醴酒虽醲有楚钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈景说诗稿后 其二","author":"陈鉴之","text":"月明孤屿云，一鹤唳清夜。\n和之以君诗，竹牖寒灯下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈景说诗稿后 其一","author":"陈鉴之","text":"今人宗晚唐，琢句亦清好。\n碧海掣长鲸，君慕杜陵老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑承事所作蕙兰三首 其三","author":"陈鉴之","text":"郑君欲与兰写真，心神暗与兰俱春。\n诗家三昧正如此，境融意会今何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑承事所作蕙兰三首 其二","author":"陈鉴之","text":"托迹不辞岩谷深，异于萧艾亦何心。\n清风披拂自多事，斜日淡云香满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑承事所作蕙兰三首 其一","author":"陈鉴之","text":"兰如君子蕙如士，此评吾得之涪翁。\n有馀不足姑勿论，毕竟清幽气类同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口甘露寺登眺","author":"陈鉴之","text":"吹帽海风鸦背起，冯夷知我酒微醺。\n楼台气压金焦浪，钟鼓声飞淮浙云。\n戈甲虎争馀块石，榛芜鼪啸几斜曛。\n山僧不管兴亡事，清坐闲披贝叶文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口江阁和友人韵","author":"陈鉴之","text":"良辰仍我辈，斗酒大江边。\n小阁纳万里，一帆来九天。\n世尘黄鹄外，诗兴白鸥前。\n地胜吾衰矣，长怀李谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和守斋户部家居书怀","author":"陈鉴之","text":"抽身龙尾外，一壑本来心。\n书卷竹阴润，笔床花气侵。\n耿光增魏笏，雅趣寓陶琴。\n隐几时搜句，忘言兀似瘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚野步","author":"陈鉴之","text":"容易老春工，扶藜趁好风。\n蛙跳蒲细细，燕没絮濛濛。\n沽酒亦可醉，有怀谁与同。\n长松古须鬣，无语对繁红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送方粹仲适会稽","author":"陈鉴之","text":"正好炉亭语夜分，朔风征帽浙江濆。\n天低雁带参差树，山远舟横黯淡云。\n龟解不妨时换酒，鲸呿元自妙为文。\n千岩万壑心如水，二尺檠边剩著勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"陈鉴之","text":"鹊影翻高树，萤光出浅莎。\n墙低天宇阔，楼小月明多。\n清吹徐徐至，微云缓缓过。\n欲谈无与共，默坐养天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探梅","author":"陈鉴之","text":"驴蹇飙寒猎帽裙，吟肩山耸酒微醺。\n弯弯竹径霏霏雪，小小溪桥淡淡云。\n忽邂逅时真得侣，向空濛处细飘芬。\n回天力量知谁似，笑挽春来首策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚凉湖边放步","author":"陈鉴之","text":"暑气湖山薄，晚风巾袂凉。\n蝉鸣便柳荫，鹭立领荷香。\n大舸鼓声远，小轩茶味长。\n独游元更好，细细踏斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陈鉴之","text":"踏遍苕溪石，梅花又满林。\n山川春入望，宇宙月知心。\n一纪别乡井，八年无雁音。\n危巢老松顶，日暮有归禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮登蓬莱阁","author":"陈鉴之","text":"危栏散湮郁，已暮亦登临。\n鼓角孤城月，山川万古心。\n鹳栖松雾重，鸥卧渚烟深。\n客子终何托，婆娑且醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题问政山","author":"陈鉴之","text":"冯轼邦君侈画熊，却来问政翠崖翁。\n祇应兄念玄真子，不是堂无齐盖公。\n千载棣华垂盛事，两丛慈竹亦清风。\n跨鸾时过宣平老，明月箫声在半空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"包家山和潘孔时","author":"陈鉴之","text":"危阑纳纳万里天，此景不作西子妍。\n荒蹊斗折乔木末，小亭棋布层崖巅。\n阳侯作意娱我醉，潮头百尺来樽前。\n游蜂低回殢花露，一鸟急去拖林烟。\n年来祇可作橘隐，四人聊学商山仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古诗四首奉寄陈宗之兼简敖臞翁 其一","author":"陈鉴之","text":"雌雄乌一色，烈焰玉石分。\n子桑十日雨，英概君摩云。\n麈尾失羁思，襟裾兰茝芬。\n是岂如蟨驉，书圃同锄芸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古诗四首奉寄陈宗之兼简敖臞翁 其三","author":"陈鉴之","text":"甘旨娱母颜，雍雍春满室。\n咿哑索梨枣，诸儿争绕膝。\n波明再茁桐，露涤清吟笔。\n人生如此足，富贵刀头蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古诗四首奉寄陈宗之兼简敖臞翁 其四","author":"陈鉴之","text":"亭亭会山阁，四面秋澄鲜。\n槃礴一代英，披衣俯飞鸢。\n迩来几星聚，清樽压云烟。\n九转得奇诀，分惠毋独仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古诗四首奉寄陈宗之兼简敖臞翁 其二","author":"陈鉴之","text":"君隐万人海，啸咏足胜流。\n我堕寂寞滨，嵌岩一筇秋。\n蟠郁向谁吐，天围芦荻洲。\n劈箭客帆去，何日回吾舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会稽秋日观山","author":"陈鉴之","text":"荒塍间流水，蠹叶风飕飗。\n前山与幽人，亭亭共清秋。\n远近日明晦，隐见云去留。\n木末一叟归，犬鸣茅舍幽。\n忆昔典午东，剑佩森名流。\n胜地慰远怀，兹焉久绸缪。\n渔矶与樵径，今有斯人不。\n池石老苔发，空馀螺蚌游。\n世有古今异，郢歌聊自酬。\n醉眼时摩挲，此山即前修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再到京口","author":"陈鉴之","text":"问讯金焦亡恙否，双鳌依旧据寒流。\n塔边浪战嵌岩石，木末云扶缥缈楼。\n枫叶蓼花新醉雨，山容客鬓两添秋。\n海天一镜舟如豆，忘却尘缁季子裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同刘叔泰放步湖边入灵芝寺坐依光良久叔泰诵坡仙好把西湖比西子之句予因赋古风一首","author":"陈鉴之","text":"刘郎唤我出，胜处意所便。\n清寒柳桃风，浓淡杉桧烟。\n僧庐自生香，步绕古佛前。\n依光偶不扃，坐数禽联翩。\n平林度清磬，遥堤簇归船。\n湖山露真态，鸥点溶溶天。\n形容几吟笔，刚道妆抹妍。\n莫作西子看，正如姑射仙。\n相知喜值予，微笑生清涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同潘孔时饮总宜园孔时出宝晋数帖呼道人吹箫次日有诗予用韵答之","author":"陈鉴之","text":"六桥秋新宜醉吟，举杯共听岩鹤音。\n危亭三面立老竹，宝晋数帖清人心。\n凉蝉不敢喧夕曛，洞箫声绕山腰云。\n摇摇归艇水纹裂，山紫天青河汉白。\n想君独立对空阔，一鹭毛寒藕花月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守斋示予游问政山和陈广文诗予用韵呈守斋","author":"陈鉴之","text":"小队名山访古归，雪云不解听招麾。\n琼瑶千嶂插空阔，珠璧一诗争崛奇。\n兴逸聊兹游赤石，民安何待化潢池。\n妓围如画心如水，鬒发从渠映玉碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毕履和惠端砚余以大歙砚报之佐以一诗","author":"陈鉴之","text":"履和惠端砚，玉质马肝色。\n我有大砚卧蚕纹，元是新安龙尾石。\n持以答佳贶，聊尔见此心。\n极知不是双南金，未足报君绿绮琴。\n我得履和砚，清润如履和。\n天然粹德非琢磨，秋江印月平不波。\n君得刚甫砚，朴钝若刚甫。\n不能轻捷随人后，默默寒窗守愚鲁。\n端砚入手喜有馀，展开古帖聊学书。\n大砚知君不负渠，墨池飞出北溟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖晚望","author":"陈鉴之","text":"过雨长堤葱翠湿，小桥人静支筇立。\n一缕竿头颤霜鲫，风动青蒲见蓑笠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吴江","author":"陈鉴之","text":"垂虹四年别，淼淼来梦境。\n今晨整芒屦，柳风吹鬓影。\n春光彻重渊，蛟困绿波静。\n远帆有无处，小立为徐领。\n浩歌翁自得，白发乱垂颈。\n一室世谁如，三万六千顷。\n平生卜邻意，此际味差永。\n翁肯平分欤，吾其办渔艇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":23094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]