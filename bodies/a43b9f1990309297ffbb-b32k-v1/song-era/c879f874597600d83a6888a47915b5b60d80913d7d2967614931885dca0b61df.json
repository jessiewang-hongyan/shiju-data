[{"title":"陪德孺游徐氏园池","author":"李处权","text":"禽鱼花竹静相参，溪雪融春青出蓝。\n月下醉归休秉烛，要将清梦过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书三首 其三","author":"李处权","text":"朝云漠漠雨丝匀，山路清无一点尘。\n桃李著花溪水满，断肠何处故园深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书三首 其二","author":"李处权","text":"碧涧溅溅绕竹林，欲从源水阻幽深。\n春风想有桃花树，更有渔舟可访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书三首 其一","author":"李处权","text":"柴门如画映山隈，窈窕轩窗向水开。\n想见幽人清彻骨，松阴翠竹竹阴梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中过伊南","author":"李处权","text":"低阴漠漠水漫漫，杨柳如丝不忍看。\n见说山前风更恶，杏花无处避春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中题梅","author":"李处权","text":"山家梅树出疏篱，好客慇勤折一枝。\n直是老来风味薄，而今相遇可无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简辨老","author":"李处权","text":"晚风吹叶满溪流，落日孤云万里秋。\n径欲五湖寻范蠡，醉携西子上扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题湘园","author":"李处权","text":"当年此地勤花竹，景物方成姓又移。\n尽爱芙蓉照秋水，倚风怀往亦多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"士特倒用韵作元日复和","author":"李处权","text":"觅醉无千日，浮家又一春。\n閒门久罗雀，贫甑自生尘。\n我欲论秦过，君须赋洛神。\n穷途依二阮，遂欲老于闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"才臣设席彦修来过仍陪表臣终日之乐岂易得也因赋","author":"李处权","text":"顾我非仙李，知君实老彭。\n承家罗玉树，润屋起金赢。\n世路嗟多事，人生戒不情。\n岁华将暮矣，切勿诉深觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋对月","author":"李处权","text":"露洗风吹未遽央，登山临水总心降。\n明年此夕知何处，自古中秋不可双。\n尚倚人琴温似玉，更能诗酒浩如江。\n披襟拄颊浑无寐，斗转参移莫下窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆入月山介卿有诗见怀次韵答之","author":"李处权","text":"鼠辈欺人可奈何，我今行橐已无多。\n醉魂尚爱黄华谷，归梦长迷白石坡。\n壮士陆沉无籍在，道人香积有经过。\n行朝近报仍安稳，想见沙堤蹀玉珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日闻养源文少醉诗以简之","author":"李处权","text":"南州新岁换，北客长年悲。\n吾日且三省，我生仍百罹。\n谷深云不起，树暖蝶先知。\n闻道山翁醉，何如卧雪池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元长生辰","author":"李处权","text":"力扶吾道与斯文，世职家声蚤出群。\n欲致升平宁舍我，从来出处不忘君。\n龙吟虎啸弥千日，兔髓乌肝恰一斤。\n已格皇天方俾寿，未须骑鹿上青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"止戈堂","author":"李处权","text":"坐见妖氛犯斗魁，使君谋略信雄哉。\n寇如狐兔草间出，兵似貔貅天上来。\n门馆无私千里静，宾朋多暇百壶开。\n他年入数中书考，始识汾阳济世才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水阁雨中","author":"李处权","text":"南国寒多雨，溪山昼更晴。\n风帆随鸟上，樵径入云行。\n已苦无饘粥，犹欣见耦耕。\n故园归未得，豺虎正纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见怀","author":"李处权","text":"飘零吾老矣，诗酒得斯人。\n邂逅干戈际，慇勤骨肉亲。\n锦囊元绝俗，琼树旧无尘。\n归棹荷花里，从谁问玉津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"车水","author":"李处权","text":"挽尽溪流沮洳浑，幽人昼卧懒开门。\n诸邻鹅鸭顿亡赖，一夕鱼虾无半存。\n及此焦枯方有祷，从而暴殄岂堪论。\n清漪绿竹城南路，回首吾庐正断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长桥","author":"李处权","text":"徙倚长桥上，时难得此游。\n水光迎目动，帆影上天浮。\n不见鸱夷子，须烦顾虎头。\n今年闰八月，好好醉中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东亭","author":"李处权","text":"檐屋排空阔，薰风眺晚晴。\n閒云连树碧，白鸟破烟明。\n世乱思君子，身危仗友生。\n秪应今夜月，解识故乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申春登平山谷林二堂时茂世应时同行追录之","author":"李处权","text":"已过平山又谷林，登高能赋兴何深。\n群峰雪后皆浮玉，万竹风前亦碎金。\n尚喜日闻黄屋信，可堪时动白头吟。\n载游不为壶觞事，携取君家绿绮琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伟观堂","author":"李处权","text":"孤烟落日对衔杯，此观人间亦伟哉。\n树色远从江浦合，潮声低咽海门回。\n衣冠喜有承平气，宾客惭无赋咏才。\n城阙郁葱人望幸，五云将拥翠华来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再到值雨","author":"李处权","text":"无复清池照病颜，尚馀诗思发天悭。\n西风似水初鸣叶，细雨如尘不隔山。\n岁熟自然民意乐，时平更觉鸟声閒。\n江梅会见花敷雪，剧饮须期倒卧还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和","author":"李处权","text":"已着诗招隐，何须酒引陶。\n胸中有泾渭，笔下足波涛。\n世乱闭门早，身閒倚枕高。\n何惭少陵老，鹦鹉啄金桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和","author":"李处权","text":"鬓丝殊觉老，泪血更伤春。\n阅世元如梦，除天总是尘。\n有心耽传癖，无意媚钱神。\n坐怪三衢守，书来不到闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊彦深","author":"李处权","text":"已秀不成实，长怀事可吁。\n宁论日下鹤，遽失掌中珠。\n扰扰遭斯厄，冥冥丧厥躯。\n高堂亲白发，泪眼尚青枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同二三子步溪上","author":"李处权","text":"已恨春风过，犹欣夏日长。\n莺喧桑已葚，燕乳麦初芒。\n白发悲如许，青鞋乐未央。\n归来安客舍，更有北窗凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同士特似表过中峰饯似宗","author":"李处权","text":"旧好崔亭伯，新交阮仲容。\n招携来白水，祖饯过中峰。\n谷暖芊芊树，云深杳杳钟。\n兵戈一分袂，惆怅几时逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后乐堂","author":"李处权","text":"去尽沙鸥水照空，群山濯玉有无中。\n乱来更觉心情减，佳处犹欣臭味同。\n喜有清樽对雌霓，惭无健笔继雄风。\n此行会见承平否，岁晚飘零已秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守岁用少陵阿戎家韵寄怀萧国器","author":"李处权","text":"节物赖邻家，南风竞剪花。\n门无迎客犬，地有噪人鸦。\n病眼愁中暗，题诗醉里斜。\n乱离俱老大，今夕意何涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏简秦处度","author":"李处权","text":"淮海秦夫子，相逢又十年。\n好诗无漫与，爱酒不虚传。\n夜寺云连榻，秋江月满船。\n不知嵇叔夜，何得绝交篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵四首寄德基兼呈侍郎公 其二","author":"李处权","text":"蒙尘天子尚戎衣，南国旌旗正伐鼙。\n国士伤时多刺怨，王官失路有悲啼。\n似闻叔向方图晋，亦报夷吾未去齐。\n易地皆然心寸折，钓竿吾欲老磻溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵四首寄德基兼呈侍郎公 其一","author":"李处权","text":"溪流暴雨涨江同，咫尺西邻信不通。\n衰朽怕看青镜里，笑谈犹近翠屏中。\n侍郎客到无苛礼，教授诗来有古风。\n五载皇皇无税驾，我途正似阮生穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵四首寄德基兼呈侍郎公 其三","author":"李处权","text":"书文车轨几时同，诸道惟闻羽檄通。\n岂较北南聊暂寓，若论贤圣且时中。\n门前杨柳方垂雨，溪上桃花尚舞风。\n谁见东山谢安石，命宾携妓兴何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵四首寄德基兼呈侍郎公 其四","author":"李处权","text":"紫凤天吴在短衣，乱来无日不鸣鼙。\n情随野鹤云间舞，梦绕城乌月下啼。\n但得交情如水淡，何须妇馔与眉齐。\n抱琴载酒明朝去，相送无劳过虎溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵民瞻端礼二首 其二","author":"李处权","text":"春雨既过云未归，春寒屋下人无衣。\n林如膏沐鹁鸠语，草已怒生胡蝶飞。\n中原格斗几时定，北叟飘零何所归。\n我今始悟蘧伯玉，明明四十九年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵民瞻端礼二首 其一","author":"李处权","text":"枉报新诗锦不如，句中风竹韵萧疏。\n颇分泾渭甘从子，不较穷通岂病予。\n避地拟求千日酒，误身何用五车书。\n谁人与作任公钓，要使东人厌若鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朴侄见寄","author":"李处权","text":"鼙鼓声中老战尘，故山归梦月三更。\n交情咄咄浑无寐，学古悠悠浪得名。\n鳌禁未容追世职，熊轓何足语官荣。\n阿咸自是吾家秀，始觉前人畏后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵约之秋怀 其一","author":"李处权","text":"野人不入俗，裋褐分田舍。\n由来黄犊车，不受尘中驾。\n空床蟋蟀边，阴牖蒲萄下。\n适然契幽怀，推枕起中夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵呈德基兼呈王侍郎","author":"李处权","text":"书生卧病久无衣，不意临衰厌鼓鼙。\n乡信略无鸿雁到，客愁惟有杜鹃啼。\n谁怜弹铗长依孟，自不工竽漫说齐。\n我亦漂流费耘业，看君文字照浯溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵表臣见遗喜归","author":"李处权","text":"溪南浑似辋川居，不啻当年卧草庐。\n从昔金声蒙酱瓿，至今汗血困盐车。\n端知将相真无种，更喜才华甚有馀。\n及此知机同免祸，季鹰初不为鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵巽老","author":"李处权","text":"风前竹干须料理，雨后蜗涎费扫除。\n北客经过无好语，南州骚屑少安居。\n雄称百万空扛鼎，功盖三分漫顾庐。\n识字信为忧患始，邺侯何必万签书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵端礼见寄","author":"李处权","text":"自昔孤芳难寄林，乱离漂泊却须禁。\n春风不解回双鬓，夜雨何堪搅寸心。\n薄日花光怀杜曲，清流竹色梦山阴。\n从来玉石昆山火，臭味多君肯嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵德孺感怀","author":"李处权","text":"敝屣浮云世所难，谁堪走俗抗尘颜。\n海鹏已激三千里，天马终归十二闲。\n醉发杖藜云逐逐，香凝宴寝雨斑斑。\n林泉久假皆吾有，何必捐金更买山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上望灵石","author":"李处权","text":"似闻环佩杂箫笙，鼎立争雄凛太清。\n不与古今争变化，可能舒惨属阴晴。\n花开玉井难求种，月下瑶台但有名。\n我亦生来未尝屈，敢持方寸并峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上书所见留别益谦","author":"李处权","text":"池上风烟故可人，倦游老眼厌纷纷。\n晴云出岫似知我，野鹤鸣皋疑是君。\n可恨音书长契阔，尚从杯酒见殷勤。\n新诗准拟频相寄，独学方当病寡闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自龙云归复次前韵","author":"李处权","text":"野寺经旬客寓居，水声山色是吾庐。\n喜君能道碧云句，招我更烦黄犊车。\n世路从来多险阻，人生何必问赢馀。\n况闻一诺千金重，为激西江救涸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西亭","author":"李处权","text":"江南形胜地，列坐肆遐观。\n气象天围大，溪山眼界宽。\n远风来绿野，返照上朱栏。\n更待秋澄澈，重寻落帽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮二首 其二","author":"李处权","text":"海舶忽惊风打头，观澜又破一年秋。\n若为尽作杯中物，安得飞来枕下流。\n岂计双凫兼乘雁，谁分去马与来牛。\n君王大业追神禹，前日黄龙已负舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮二首 其一","author":"李处权","text":"雪屋银山满上头，年年伟观近中秋。\n只言沧海无回浪，岂信长江有逆流。\n一一樯帆如过鸟，时时烟雨要沉牛。\n青衫白鬓功名晚，何日翩然范蠡舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过德孺池上二首 其二","author":"李处权","text":"谁堪秋热与春寒，北客南州有底欢。\n酒熟但招吾辈饮，诗成莫与俗人看。\n眼明白鸟清溪上，心折黄鹂碧树端。\n口诵离骚手遮日，梦魂不敢到长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过德孺池上二首 其一","author":"李处权","text":"树色溪光五月寒，幅巾藜杖接清欢。\n吞声鸟自屏中过，倒影山从镜里看。\n佳处唯堪著胸次，平生久已付毫端。\n向来未筑沙堤路，岂信东山有谢安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亨仲家兄擢居谏省诗以贺之","author":"李处权","text":"除书喜动荐绅颜，稳上天池刷羽翰。\n诗似少陵多教化，文从太史有波澜。\n王庭看折朱云槛，儒巷闻弹贡禹冠。\n兄弟相知夫岂敢，会怜流落久江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈九兄","author":"李处权","text":"我兄少有谪仙才，襟抱于今得好开。\n珠玉尽从谈次落，溪山浑入句中来。\n弦歌小邑徒劳尔，松菊故园安在哉。\n有客漂流无税驾，愿将高义挽春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈似表","author":"李处权","text":"闻说烟尘近，惊奔道路长。\n人生何草草，天意竟茫茫。\n山鸟寒亡路，溪花湿更香。\n飘零值君子，老眼慰悲凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙空出示诸公诗卷次元韵","author":"李处权","text":"已著芭蕉喻此身，木人花鸟岂知春。\n他家定自无生灭，此物何尝有故新。\n美玉不羞论瓦砾，明珠终解照泥尘。\n相逢一笑空归去，无语堪酬彼上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀清叙","author":"李处权","text":"梦想平生始此回，扁舟坐稳兴悠哉。\n阴阴树底莺声切，漠漠田中雨气来。\n乱世等閒凋鬓发，故园何处问池台。\n临风不见高公子，正渴论文共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投建阳王宰","author":"李处权","text":"异时丞相柄文盟，一顾曾空冀北群。\n铅椠无功方笑我，箕裘不坠蚤知君。\n诗家只说王摩诘，官况谁怜郑广文。\n散尽黄金犹作客，还来把酒对孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迓辨老","author":"李处权","text":"琳宫尚记昔年游，扑面杨花晚不收。\n自倚钓鱼终悟主，谁知射虎不封侯。\n江湖已恨长为客，风雨何须横作秋。\n未见故人心已醉，更拚十日为君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻雨","author":"李处权","text":"小雨妨幽事，徜徉所得多。\n前期操野艇，亭午出烟萝。\n选胜才如许，偷閒肯重过。\n自怜诗酒涸，无句敌阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叔易席上","author":"李处权","text":"何处春光最可怜，仙山亭上碧岩前。\n穷来更觉诗堪画，老去谁知酒可仙。\n云色弄晴花蘸水，风光纵好柳拖烟。\n左思近有三都赋，谁与吹嘘送上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和九兄贺二十六兄除大谏","author":"李处权","text":"祖德当年吐握勤，谏垣人物典刑存。\n在阴鸣鹤和有子，产峄孤桐枝见孙。\n王室艰难欣得士，世家矜伐敢援恩。\n清明謇谔平生事，况乃中兴辟四门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和与可见惠之诗","author":"李处权","text":"倚马万言才一挥，问年于我亦肩随。\n才华早擅乡评在，人物行看国士知。\n黄卷沉酣端有志，青云腾踏岂无时。\n小人薄宦犹三黜，方驾聊同柳士师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘逸老题罗汉壁间韵","author":"李处权","text":"僧房元寂寂，客意遂陶陶。\n诗笔翻云锦，茶瓯捲露涛。\n鸦归寒日下，雪尽远峰高。\n尚喜王乔近，吹笙坐碧桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和如祖弟二首 其二","author":"李处权","text":"绿树黄鹂阴复晴，春风何处不堪行。\n野烟著草绵绵色，江日浮花滟滟明。\n故国音书添梦想，异乡节物减心情。\n逢人尽说兵戈事，始觉如今去就轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和如祖弟二首 其一","author":"李处权","text":"老来风味淡于秋，愧负平生马少游。\n但得山云供晚眺，何须花雨作春愁。\n新诗未省曾多见，情话端知肯独留。\n政渴一杯浇磊磈，书生何用玉为舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和怀英雪诗 其二","author":"李处权","text":"纵赏钩帘面远山，蟹螯谁复问尖团。\n飞花空自嫌春晚，折竹应当念岁寒。\n句法一如冰柱险，书斋坐怪玉壶宽。\n固知柳絮因风起，何事青天亦受漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]