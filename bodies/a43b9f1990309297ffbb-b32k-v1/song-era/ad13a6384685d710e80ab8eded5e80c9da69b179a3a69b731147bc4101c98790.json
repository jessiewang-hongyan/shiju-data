[{"title":"谢沿海制使颜侍郎举","author":"宋伯仁","text":"羞把床头短铗弹，弓裘殊愧一丝官。\n但知晓雪侵髭满，不拟春风著眼看。\n东閤选抡前固有，西班腾踏近尤难。\n先生浓点陶镕笔，安得梅花月共寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢浙东赵宪使举","author":"宋伯仁","text":"未肯归耕负郭田，举杯方欲问青天。\n乡心固忆张翰鲙，壮志还思祖逖鞭。\n政化一番新事业，春风千里赖陶甄。\n男儿得遇人知己，愿听鸡声夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简吴荆溪","author":"宋伯仁","text":"薄宦从来错，宁容著意求。\n自惭千里梦，空作一番愁。\n笑我人如昨，知心雨未休。\n荆溪清彻底，愿泊钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僻居","author":"宋伯仁","text":"居僻恬无事，开轩挹晚晴。\n雨耽云脚重，风约燕身轻。\n有子争梨栗，无朋问死生。\n每忧人载酒，剥啄打门声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲不识字","author":"宋伯仁","text":"难字逢人问，村中一小儿。\n璋獐宁易辨，亥豕似堪疑。\n卤莽原非莽，耕犁别字犁。\n识丁何足道，煮字不充饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题象山县栖霞观应真亭简住持张羽士 其一","author":"宋伯仁","text":"杜鹃声里立东风，山色应怜鬓已蓬。\n二麦晓寒新雨后，一年春事落花中。\n醉斟浮蚁邀仙客，笑揖飞鸥问钓翁。\n檐外万竿君子竹，虚心能得几人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题象山县栖霞观应真亭简住持张羽士 其二","author":"宋伯仁","text":"万玉丛中屋四檐，柳花时候笑掀髯。\n谁将海上山千点，幻作人间画一缣。\n药灶未寒丹可炼，春风犹力酒宜添。\n透瓶泉冷无人酌，输与黄冠自养恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题智门寺寄住山伊岩玉老 其二","author":"宋伯仁","text":"笋轿冲烟落翠巅，白岩山里借床眠。\n饱听溪水云深处，笑索梅花雪后天。\n几世世修三世福，万灯灯是一灯缘。\n吾生误读磨崖颂，落得吴霜点鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题智门寺寄住山伊岩玉老 其一","author":"宋伯仁","text":"紫微深处著招提，古迹名臣事两奇。\n宣子画由高庙治，越王心有孝宗知。\n万竿玉立春来早，六角池深月上迟。\n禅定十年帘不卷，不知门外几盘棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"懒","author":"宋伯仁","text":"懒懒懒复懒，而今懒更宜。\n此身聊复尔，万事欲何之。\n尚觉瓢为赘，奚烦锸自随。\n客来眠正熟，裙幅任题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠僧了性","author":"宋伯仁","text":"虽然年纪小，胸次已江湖。\n贝叶连宵看，梅花一样臞。\n记诗诚敢许，戒酒恐应无。\n好向苏堤上，行行掐数珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠僧妙源新创宝叶庵","author":"宋伯仁","text":"立锥无地未为穷，况有三椽似鹤笼。\n细纳海山听夜雨，旋栽松竹引秋风。\n诗如东野肩头瘦，禅与西来鼻孔同。\n他日寺成君记取，维摩床画雪岩翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山下","author":"宋伯仁","text":"山下六七里，山前八九家。\n家家清到骨，只卖水仙花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑女歌","author":"宋伯仁","text":"梳风杨柳笑，沐雨杏花羞。\n看看三十馀，不敢下妆楼。\n待媒媒不来，对娘娘共哭。\n何时王右军，来坦东床腹。\n君不见西施绝色天下白，能使麋鹿走吴宫。\n玉环一笑百媚生，能使渔阳鞞鼓惊玄宗。\n无盐无盐形貌恶，当时一段议论千古生清风。\n美妇未必美，所美貌徒美。\n丑妇未必丑，所丑行不丑。\n丑妻恶妾寿乃翁，何须能劝羊羔酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋月","author":"宋伯仁","text":"只与閒时月一般，宁知今夕最团栾。\n竹边借柄还如扇，花下传杯可当盘。\n野兔易忘终夜梦，林乌未许一枝安。\n人生几个中秋节，那得都将笑眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老 其二 老将","author":"宋伯仁","text":"髀肉丰腴鬓发疏，将军健饭待何如。\n七禽不了中原事，羞读君王问劳书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夕得友偶集文选古诗句赋感怀一首","author":"宋伯仁","text":"人生寄一世，但伤知音稀。\n明月何皎皎，游子寒无衣。\n客从远方来，携手同车归。\n愁多知夜长，各在天一涯。\n生平不满百，岁暮一何速。\n冠带自相索，何不策高足。\n还顾望故乡，冉冉孤生竹。\n含意俱未申，谁能为此曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访林可山","author":"宋伯仁","text":"可山无日不吟诗，我欲论诗未有期。\n几次孤山明月下，手挼梅蕊立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别朱冷官","author":"宋伯仁","text":"客中奔走易蹉跎，学馆痴留月又过。\n橙蟹醉斟知己重，莼鲈乡话忆人多。\n吴陵今夜三更月，霅水明朝一棹歌。\n船在白蘋亭下过，有无传语晒渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听琴","author":"宋伯仁","text":"静夜听鸣琴，秋风动幽谷。\n何为钟子期，千古无人续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈留耕先生王侍郎","author":"宋伯仁","text":"夜雨篝灯梦未闲，十年殊愧屋头山。\n喜闻局面棋声别，不惮吟髭雪样斑。\n渔钓醉歌人所愿，功名心事国相关。\n辟书笑倒梅边鹤，尽在先生指顾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张监税新居","author":"宋伯仁","text":"为爱滩头只两家，也来随分作生涯。\n依山筑屋先栽柳，买地为园旋种花。\n聊把功名循世态，只凭诗酒度年华。\n与梅一夜论心事，石鼎茶乾月未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佳人歌","author":"宋伯仁","text":"淡傅粉，浅画眉，鬓边休插桃花枝。\n白面郎君马如箭，回头再盼情依依。\n文君未识相如面，朱弦声里犹相恋，风流胜事千古传。\n宁如文君当时深深深处深庭院，临邛亦免王孙怨。\n佳人佳人休捲帘，门外落花春正甜。\n绣床午困语声寂，博山篆冷香频添。\n佳人噫，佳人吁，今人安得人人思秋胡，黄金不认真丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊船吴江","author":"宋伯仁","text":"垂虹一抹跨晴江，好解帆绳系矮桩。\n水浸碧天天浸月，只消推起小篷窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪不止","author":"宋伯仁","text":"春来雪意愈迟遛，又学飞绵过小楼。\n暖逐东风虽易化，猛如前月未容休。\n莺花消息孤诗课，蚕麦生涯累客愁。\n莫道远人多冻杀，王师亦有在边头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风歌上游丞相及台谏","author":"宋伯仁","text":"噫吁嚱，秋风从天来，一扫酷吏热。\n嗷嗷天下心，无复苦炊爇。\n丛丛篱边花，幽香知素节。\n与花同一啸，世事花能说。\n前兮酷暑在，击楫志如铁。\n岂无如谢安，围棋声未歇。\n胸中森甲兵，千里胜自决。\n诗人扪虱穷，忧时心惙惙。\n歌秋风兮歌国风，问知音兮问豪杰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷叶浦","author":"宋伯仁","text":"小船摇荡水中央，喜得归程近帝乡。\n秋与荻花俱淡薄，地名荷叶素凄凉。\n几番来往人虽熟，两月奔波话更长。\n巡检不知何日满，一堤衰柳对夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄征夫","author":"宋伯仁","text":"待君君未归，寄书书不去。\n寄书书可去，有意殊难语。\n深夜弹琵琶，思君在何处，知君在何处。\n不禁春事已阑珊，东风吹起杨花絮，东风吹落杨花絮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其六 大开一十四枝","author":"宋伯仁","text":"水精行素鳞，琉璃走夜光。\n铭垂日日新，万古稽商汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其一 大开一十四枝","author":"宋伯仁","text":"五采会章服，汝明以垂教。\n虎蜼宗庙器，于以象其孝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其七 大开一十四枝","author":"宋伯仁","text":"举头见长安，志士欣有托。\n葵藿一生心，岂容天负却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十三 大开一十四枝","author":"宋伯仁","text":"西施无限愁，后人何必效。\n只好笑呵呵，不损红妆貌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其三 大开一十四枝","author":"宋伯仁","text":"溢满而覆虚，盈亏俱有病。\n万事得于中，乌乎云不正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二 大开一十四枝","author":"宋伯仁","text":"象明十二章，斧形不可玩。\n黻以取其辨，斯以取其断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其七 大蕊八枝","author":"宋伯仁","text":"苍竹纬琅玕，为形有如豆。\n遇祭何所容，乾桃与脩糗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二 大蕊八枝","author":"宋伯仁","text":"蟾宫有兔臼，捣药千万年。\n药有长生术，世人无计传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其一 大蕊八枝","author":"宋伯仁","text":"高山流水音，泠泠生指下。\n无与俗人弹，伯牙恐嘲骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其三 大蕊八枝","author":"宋伯仁","text":"休与鹬相持，自有山川隔。\n祝君无孕珠，恐非保身策。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其六 大蕊八枝","author":"宋伯仁","text":"方深有制度，撞之以合乐。\n止乐戛以敔，始终知所觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其七 小蕊一十六枝","author":"宋伯仁","text":"三窟不须营，蒙恬素心友。\n识尽天下书，只要文章手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十一 小蕊一十六枝","author":"宋伯仁","text":"宛陵有灵根，圆红珍可芼。\n卫人感齐恩，琼琚未容报。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十四 小蕊一十六枝","author":"宋伯仁","text":"东陵人已仙，黯淡斜阳暮。\n可惭名利心，孜孜问葵戍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十六 小蕊一十六枝","author":"宋伯仁","text":"清波漾蛙子，古书形似之。\n可惜书废久，时人无能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其三 小蕊一十六枝","author":"宋伯仁","text":"风掣五云开，明星灿南极。\n嘉祥自朝廷，何幸愚亲识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十五 小蕊一十六枝","author":"宋伯仁","text":"生长沧波中，收罗向书室。\n剡藤无不平，祇恐无椽笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其一 小蕊一十六枝","author":"宋伯仁","text":"药性贵温凉，胡为辛且烈。\n无与桂附徒，天资更趋热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十三 小蕊一十六枝","author":"宋伯仁","text":"垂垂生井上，游子休整冠。\n道旁徒自苦，青眼谁能看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其九 小蕊一十六枝","author":"宋伯仁","text":"锦囊蕴珠玑，长养南风力。\n当年东老家，曾代中书笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其六 小蕊一十六枝","author":"宋伯仁","text":"善舞几当场，妖姿呈窈窕。\n当场人自迷，郭郎未容笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十 烂熳二十八枝","author":"宋伯仁","text":"八珍风味清，藜肠岂曾识。\n堪嗤尝脔人，欲与鱼兼得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二十三 烂熳二十八枝","author":"宋伯仁","text":"雪羽卧晴沙，渔人无可虑。\n机事亦难忘，不如且飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十五 烂熳二十八枝","author":"宋伯仁","text":"三拍羽翎寒，风雨不改度。\n起舞何人斯，男儿当自寤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其三 烂熳二十八枝","author":"宋伯仁","text":"兖鷩毳希元，君尊十二旒。\n璪取玉以文，五采宗成周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十八 烂熳二十八枝","author":"宋伯仁","text":"世久无渊明，黄花为谁好。\n青女自凌威，寒香未容老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其七 烂熳二十八枝","author":"宋伯仁","text":"览辉千仞高，君子思在治。\n朝阳如不鸣，敢言当自愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十四 烂熳二十八枝","author":"宋伯仁","text":"苍生望云霓，难作池中物。\n孔明卧隆中，天子势亦屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其六 烂熳二十八枝","author":"宋伯仁","text":"缯壳烂缃枝，夏果收新绿。\n玉真望甘鲜，不管邮兵哭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二十二 烂熳二十八枝","author":"宋伯仁","text":"东风开绣帘，且向花梢立。\n主人忘旧交，雕梁不须入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其九 欲谢一十六枝","author":"宋伯仁","text":"金梭抛翠丝，东风弄晴昼。\n求友不须鸣，绿窗人倦绣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二 欲谢一十六枝","author":"宋伯仁","text":"烂醉是生涯，折腰良可嘅。\n欲酒对黄华，乌纱奚足爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其四 欲谢一十六枝","author":"宋伯仁","text":"一梦在人间，东风吹不觉。\n庄周鸿冥冥，胡恋花枝巧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其七 欲谢一十六枝","author":"宋伯仁","text":"舞处更宜长，十笋藏纤指。\n脱得戏衫时，方知有呆底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其四 就实六枝","author":"宋伯仁","text":"一竿风雨寒，独占严陵濑。\n苟非伸脚眠，曷见光武大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二 蓓蕾四枝","author":"宋伯仁","text":"静看隋堤人，纷纷几荣辱。\n蛮腰休逞妍，所见元非俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其一 蓓蕾四枝","author":"宋伯仁","text":"南枝发岐颖，崆峒占岁登。\n当思汉光武，一饭能中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"累字戏作解愁吟简旧同寮","author":"宋伯仁","text":"愁。\n知不。\n空白头。\n心事惊秋。\n归兴满沧洲。\n貂蝉虽出兜鍪。\n功名有愧黑貂裘。\n夷齐与盗蹠总荒丘。\n无非蘧蘧栩栩梦庄周。\n空教笑倒江上烟雨汀鸥。\n一琴一剑一童一鹤一茶瓯。\n自不须苦苦高卧元龙百尺楼。\n著眼看翻云覆雨处豪杰总成羞。\n牙旗金甲蹇驴破帽穷通一任前脩。\n五湖千万顷明月则尽可棹歌横钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落叶","author":"宋伯仁","text":"捲地西风促雨来，扫除黄叶满苍苔。\n垂杨蚤有青青眼，只碍梅花未敢开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简如皋赵买盐","author":"宋伯仁","text":"倾盖相逢尽故人，如君喜色更津津。\n三更虽共金樽月，半日难留玉麈尘。\n淮海浮名徒惹手，田园归计好谋身。\n何时同醉孤山路，笑撚梅花问早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简张寄翁秀才","author":"宋伯仁","text":"徽外琴声局外棋，此心能得几人知。\n纵横谩说三千字，陶写须吟百一诗。\n秋到蓼花蝉噪后，雨敲荷叶钓归时。\n西湖尽著张公子，莫把吟篷月共移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝僧还乡","author":"宋伯仁","text":"世事无过尔尔，禅心只好休休。\n江上数峰如削，西风不碍归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"宋伯仁","text":"绿盖半篙新雨，红香一点清风。\n天赋本根如玉，濂溪以道心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]