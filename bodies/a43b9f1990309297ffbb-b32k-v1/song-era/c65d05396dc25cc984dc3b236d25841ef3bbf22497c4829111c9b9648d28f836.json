[{"title":"剑浦思归 其二","author":"王克功","text":"古柳枝头啼暮鸦，清明时候又天涯。\n故园桃李凭君问，老却春风几度花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荼蘼 其二","author":"卢梅坡","text":"门前碍路旋移来，压架攲斜绿作堆。\n三月半时花正好，十年前是手亲栽。\n幽香早被风偷递，小蕊那禁雨急催。\n尽数折为神佛供，免教飞去卧苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花 其二","author":"王公炜","text":"雪后梅花独步天，半开犹自未全然。\n倚岩大瘦魂销梦，照水无尘骨蜕仙。\n贮向金瓶生怕俗，绝饶翠袖敢争妍。\n夜深霜角吹残月，错梦梨花耿独眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早梅","author":"张棨","text":"扶筇拄月过前溪，问讯江南第一枝。\n驿使不来羌管歇，等閒开落只春知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿赵推官 其二","author":"赵福元","text":"郁葱佳气晓笼天，北斗倾霞入酒船。\n莲炬金辉油幕下，兰牙玉立宝香前。\n衡山寿比闽山秀，楚地人瞻福地仙。\n岁岁瑶池闻燕集，蟠桃从此熟三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金钱花","author":"邵清甫","text":"也无棱郭也无神，露洗还同铸出新。\n青帝若教花底用，牡丹应是得钱人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"吴氏","text":"纷纷事如麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"吴僧","text":"到江吴地尽，隔岸越山多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"武允蹈","text":"露萱钳宿蝶，风木撼鸣鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"武允蹈","text":"屋头风过雁，灯背月移窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"武允蹈","text":"霜林五色锦，烟渡一萦丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"武允蹈","text":"午簟展风供睡课，夜窗扃雨办诗逋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"武允蹈","text":"眼昏书字不著纸，耳重听言常问人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花曲 其二","author":"易士达","text":"春脚移从何处来，未到百花先到梅。\n南枝初着三两蕊，北枝冱寒犹未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花曲 其三","author":"易士达","text":"昨夜东风破寒腊，南枝北枝尽披拂。\n不须羯鼓喧春雷，一点阳和香自发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"易士达","text":"可堪收拾归屏枕，颇欲浮沈赴酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红梅 其二","author":"徐介轩","text":"轻盈弄月醉霞觞，娇软酡颜褪晓妆。\n缟素丛中红一点，好花终是不寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"徐玑","text":"要是此花清绝处，端如醉面读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"徐玑","text":"青蛟煖昼拿云上，白雪深春压架香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"徐玑","text":"娇困扶头怜半醒，淡浓宜面斗新妆。\n并肩罂粟多含怨，具体牡丹惟欠香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"徐玑","text":"矾弟堕小白，梅兄怜老苍。\n仲氏似白眉，表表金玉相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"徐玑","text":"鲜鲜金凤花，得时亦自媚。\n物生无贵贱，罕见乃为贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"杨巽斋","text":"如龙化作青藜焰，宁用窗前设短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荼蘼 其二","author":"湛道山","text":"一春多雨少晴光，眼底青春去意忙。\n已恨点衣红作阵，才怜满架雪生香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"湛道山","text":"想得东篱黄已遍，到家及取未凋零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"湛道山","text":"含雨数峰分水墨，著霜千树半丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赵讷轩","text":"白鸟一双帘外去，芦花风静钓舟闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华严寺望樊川","author":"释子兰","text":"万木叶初红，人家树色中。\n疏钟摇雨脚，积水浸云容。\n雪碛回寒雁，村灯促夜舂。\n旧山归未得，生计欲何从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茉莉花 其二","author":"王右丞","text":"香严童子沈薰鼻，姑射仙人雪作肤。\n谁向天涯收落蕊，发君颜色四时朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天津桥 其二","author":"周彦夫","text":"联镳去作蒋山游，路转天津绕御沟。\n忽作故都禾黍恨，洛阳宫殿锁千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤凰台 其二","author":"徐棫翁","text":"台前烟草接青徐，台后风花满殿庑。\n千里暮涛空寂寞，醉人春色正西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅坛 其二","author":"张异","text":"古树枯藤知几年，衣冠来此岂徒然。\n波涛平地难回首，风雨深山且熟眠。\n吾道有灵终用世，此心无愧可通天。\n功名分定从吾好，未许驱驰效执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅山 其二","author":"范仁仲","text":"说到神仙事渺茫，寿春亘古此灵场。\n松边白隐千年鹤，岭外红拖几夕阳。\n霞驭月寒时弄影，斗坛风冷夜闻香。\n先生不必真人号，自与乾坤共久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"释义铦","text":"无热天中第一仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"释义铦","text":"风标高古汉唐无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"释义铦","text":"冰霜过了翩然去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"释义铦","text":"平生一点调元意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"沈清友","text":"自便牛背稳，却笑马蹄忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月 其二","author":"叶巽斋","text":"维此十月，稼穑孔实。\n黍稷稻粱，糜芑秠秬。\n取陈食农，遗秉伊妇。\n室家胥庆，小大餍饫。\n我公之德，穑宝是似。\n为国珍粱，馨香荐祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月 其三","author":"叶巽斋","text":"维此十月，可爱其日。\n光华朝升，融温晏布。\n熙熙小春，物态和豫。\n清明在中，靡翳靡雾。\n我公之政，莫不休燠。\n衣服其和，悦我黎庶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月 其四","author":"叶巽斋","text":"维此十月，新霜始降。\n寒不折胶，冻不凝冱。\n凛然严师，少而慈父。\n戒示坚冰，衣裘蚤具。\n我公之威，伊教匪怒。\n不竞不絿，无怨无恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月 其五","author":"叶巽斋","text":"维此十月，物宝全富。\n雪梅在岭，霜菊盈圃。\n梧竹之高，椿松之固。\n剩馥郁芬，古根盘踞。\n我公之寿，此未足谕。\n峻峙精神，蜀江庐阜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月 其六","author":"叶巽斋","text":"庐山岩岩，江水汤汤。\n磨而颂之，我公之功。\n酿而酌之，公福无穷。\n再拜稽首，以寿我公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月 其七","author":"叶巽斋","text":"维此十月，其数无极。\n自十而百，千万及亿。\n四百甲子，周而复始。\n书考中书，汾阳之比。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中纪咏 其二","author":"龚文焕","text":"白日幽情惬，閒门到者稀。\n嗜茶和月煮，采药带云归。\n春树馀花落，天坛独鹤飞。\n年华自来往，慵换薜萝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"周芝田","text":"草香花落后，云黑雨来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"缔盟","author":"杨氏","text":"珠帘半床月，青竹满林风。\n何事今宵景，无人解与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意 其二","author":"鱼潜","text":"权衡岂公平，天驷但伏枥。\n东井不救渴，仓库何时实。\n元工肯假借，名器甚可惜。\n如何万万古，不行督责术。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"袁瓘","text":"青州熟铁不足数，卫公结邻差可方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙庭观 其二","author":"祝铸","text":"风雨连山松竹鸣，宦途牢落若为情。\n中宵嘹喨惊残梦，疑是云和重度声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石茝","author":"艾申","text":"突兀倚苍穹，谁云巧妙工。\n滴□岩已竭，神运□常空。\n人入嵌□里，春归秋□中。\n□翁何处在，孤塔凛高风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长沙","author":"周光岳","text":"江上南风起白蘋，长沙城郭异咸秦。\n故乡犹自嫌卑湿，何况当时赋鵩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游玉岩 其二","author":"陈谨","text":"同向天岩最上游，诗翁来见九螭头。\n僧房为映川原好，野水空随岁月流。\n玉节朝天行日促，金风驱雨暮云收。\n已摹大字镌山骨，要与匡庐万古留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题玉岩次韵 其二","author":"郑蕴","text":"世路从来疏散甚，江山好处且归休。\n饭馀正好远寻景，棋罢何妨閒倚楼。\n岭外梅疏初破腊，岩前松老不知秋。\n晚风落日催归兴，更约闲时取次游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫作 其二","author":"李公明","text":"烟冷风寒处，芙蓉三两枝。\n愁怀方换酒，秋意更催诗。\n不遇元白友，宁寻沈宋师。\n谁知苦吟处，发落一丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红梅","author":"牛士良","text":"陇头人未来，江南春几许。\n惆怅玉笛声，吹落胭脂雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"素曲送酒","author":"谢安国","text":"帘外春风正落梅，须求狂药解愁回。\n烦君玉指轻拢撚，慢拨死灰送一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题清芬阁 其二","author":"吴升之","text":"辟书既上不沾恩，拂袖归来闭里门。\n聊取江山助篇什，尽将轩冕付儿孙。\n纷纷利害真能择，扰扰光尘岂易论。\n傥使乘时拜遗补，未应千古配严尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意十四首 其二","author":"章云心","text":"折柳系离船，船行柳条短。\n赖有枝上花，飘泊随君远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意十四首 其三","author":"章云心","text":"采莲莫采花，采花损空房。\n留房结青子，种作明年香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意十四首 其四","author":"章云心","text":"匆匆采桑女，花雨湿襜袖。\n春风十二弦，生世未触手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意十四首 其五","author":"章云心","text":"浣衣轻浣布，布缕不如丝。\n□坚犹易穿，布弱从可知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意十四首 其六","author":"章云心","text":"佳人买明镜，意重轻千金。\n结以双罗带，欲照荡子心。\n荡子渺不归，镜影春云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意十四首 其七","author":"章云心","text":"贱妾燕子身，衔泥巢君房。\n游子黄鹄志，辞家独南翔。\n采花为谁容，袭兰为谁香。\n安得小心风，寄子双明珰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘同年入蜀","author":"章云心","text":"蜀山如砥水如丝，送子西游蜀道时。\n万里乾坤犹战血，百年豪杰几愁眉。\n青虫渐老秋声小，白雁不来霜信迟。\n若过锦宫城下路，遥怜堕泪孔明祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"吕奫","text":"九锁琼宫萃列仙，飘然别是一壶天。\n时时云气生岩洞，日日松声助涧泉。\n山茗已堪回短梦，金丹要可得长年。\n是中着语真难事，今古舂容几大篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"苏瀛","text":"冉冉云根手可采，天然泉石故相参。\n仙家永日元无夜，虚室冷风每自南。\n剩办芒鞋寻隐躅，更从羽士纵玄谈。\n真空不在多言论，学道何如啖蔗甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"湖杓","text":"平生昼里看丘壑，便欲扶筇快赏心。\n真个溪山在亭外，老坡千古共知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"朱希言","text":"松桧参天几万株，清阴夹道暑全无。\n暗泉深洞尤难写，拟借君诗作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初夏闲居","author":"鲍鳌川","text":"杜门春又夏，贫不厌身闲。\n白日静于水，绿阴浓似山。\n野蔬留客饮，小艇送僧还。\n却忆西庵雨，泉声石壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明游玉堂庄","author":"释朋来","text":"几宿青山逐陆郎，清明时节好烟光。\n归穿绿荇船头滑，醉踏残花屐齿香。\n风急岭云飘迥野，雨馀田水落方塘。\n不堪吟罢东回首，满耳蛙声正夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题妙庭观 其二","author":"边维岳","text":"不见当年鼎与坚，望中河汉路漫漫。\n人人自有飞升骨，平却心丹是内丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"黄畸翁","text":"身闲不入红尘市，梦好频惊画角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"黄畸翁","text":"日高三丈宿酒醒，鸟唤一声春梦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"何英","text":"自从二水分新旧，南北烟波各自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒阙里 其二","author":"高诩","text":"六经不幸火于秦，日月曾何碍片云。\n用舍从来关治乱，皇天本不丧斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老僧","author":"释景云","text":"日照西山雪，老僧门始开。\n冻瓶黏柱础，宿火陷炉灰。\n童子病归去，鹿麋寒入来。\n斋钟知渐近，枝鸟下生台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夷陵即事","author":"释尚颜","text":"不难饶白发，相续是滩波。\n避世嫌身晚，思家乞梦多。\n暑衣经雪著，冻研向阳呵。\n岂能临岐路，还闻圣主过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠樊川长老","author":"释清尚","text":"瘦颜诸骨现，满面雪毫垂。\n坐石鸟疑死，出门人谓痴。\n照身潭入楚，浸影桧生隋。\n太白曾经夏，清风凉四肢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]