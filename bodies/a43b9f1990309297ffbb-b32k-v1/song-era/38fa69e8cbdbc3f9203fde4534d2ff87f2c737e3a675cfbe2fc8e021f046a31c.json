[{"title":"舟次再寄","author":"刘摰","text":"小孤风顺水安流，湓浦欣闻已系舟。\n几日亭中折奇树，从今江上解离忧。\n客心岁晚惊催橹，雪意天寒入倚楼。\n东圃梅开酒更美，团圆无复越乡愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岸次见梅花不果折","author":"刘摰","text":"武昌江口见江梅，紫萼瑶芳取次开。\n穷腊雪寒新霁后，满枝春色为谁来。\n坐嗟陇首无人寄，莫使城楼有角哀。\n犹喜东风慰岑寂，暗香时许度蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自衡岳至福严寺二首 其一","author":"刘摰","text":"晓指禅关入翠屏，烟岚金碧旋疏明。\n旁看阴壑溟濛失，斗上云梯伛偻行。\n漫兴独于元子惬，诗怀容与谢公评。\n区区出处劳分别，朝市山林各有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自衡岳至福严寺二首 其二","author":"刘摰","text":"俯仰岩溪万仞临，恨输飞鸟极高深。\n青云平地人难到，流水残花路可寻。\n稍觉衣裾侵小雨，渐闻钟磬下遥岑。\n丈人不厌频来往，欲作香山得二林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福严寺呈贯之少卿并诸禅老","author":"刘摰","text":"眼熟林峦认旧缘，耆关峰北入霏烟。\n云房直上三千尺，蜡屐重来十五年。\n山奥坐能朝万象，地灵深自接诸天。\n暂游久住均如梦，社客何须约白莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至福严寺得邹耒阳书因寄","author":"刘摰","text":"尽室攀萝入五峰，峰前金碧寺飞空。\n山当星鸟离方镇，地辟天龙海上宫。\n喜我徜徉泉石外，忆君辛苦簿书中。\n登临樽酒无因共，半夜题诗寄北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲登祝融峰阻雨呈少卿","author":"刘摰","text":"雾雨阴冥万壑蒸，五峰当面失云层。\n愁如药使迷蓬岛，路似仙溪隔武陵。\n已认神灵憎俗客，欲将魔障问岩僧。\n劳公为我祈昭圣，暂借扶桑白日升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠南岳董少卿二首 其一","author":"刘摰","text":"身在南山非隐沦，闲中官贵异风尘。\n清泉白日预何事，华发綵衣今几人。\n虚室图书忘岁月，寿筵香火祝君亲。\n朝廷不以忠移孝，又说恩函拜命新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠南岳董少卿二首 其二","author":"刘摰","text":"世人行止两匆匆，公独荣亲禄隐中。\n清职正同香案吏，旷怀都似漆园翁。\n南陵兰茂晨羞洁，内鼎丹灵老颊红。\n虽喜论心慰迁客，区区安足识冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄少卿二首 其一","author":"刘摰","text":"仙翁来自太常班，再乞林泉捧诏还。\n养志秖为华发戏，无心宜共白云闲。\n一樽未厌尘中客，双屐同跻雨后山。\n为寄东宫舍人语，五峰新句两难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄少卿二首 其二","author":"刘摰","text":"携筇得得访云关，恰值东湖贺监还。\n泉石主人元好事，尘埃游子暂偷闲。\n心轻齐组知灵运，文满浯溪服次山。\n秖恐东风唤归棹，江头杨柳已堪攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少卿送酒肴至山中","author":"刘摰","text":"十里传书厚意将，珍肴醇酹寄山房。\n定知僧舍餍疏食，更欲云岩有酒乡。\n一饭常闻淮上报，独醒徒使楚人伤。\n携持明日到峰顶，试揖浮丘共此觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵贯之见勉冒雨至后洞","author":"刘摰","text":"狂电惊雷晓未收，春云能护洞天游。\n徘徊已尽剡溪兴，秘怪难探禹穴幽。\n彊勉更须劳屐齿，龙钟何惮过山头。\n从今功德应圆满，厚意成人岂易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵","author":"刘摰","text":"已踏云梯上翠岑，洞中闻说更幽深。\n夜惊寒雨生潇洒，愁起孤猿助啸吟。\n白日昔传仙可学，青天今笑梦难寻。\n故应清兴无时尽，肯为淹留折此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登祝融峰题上封寺二首 其一","author":"刘摰","text":"磴险梯危路忽穷，胜游须到祝融峰。\n九千丈外云间寺，一万年馀石上松。\n引手莫高疑触斗，临池毋久恐兴龙。\n此山惜与中都远，未得君王检玉封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登祝融峰题上封寺二首 其二","author":"刘摰","text":"寒风吹脑赤霄边，飞鸟犹难到绝巅。\n下见人间又成海，恍惊身世此何天。\n岩腰半白春留雪，僧面多黔日冒烟。\n我亦淮南宗姓后，举家应合到神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贯之自岳先还衡阳示诗见别次韵奉和","author":"刘摰","text":"云壑登临杖屦随，狂歌清醉乐忘疲。\n拍肩正赋游仙曲，回首还吟陟屺诗。\n春草便惊南浦别，寿觞应慰北堂慈。\n区区流水高山意，常有孤音托子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙少卿鹿头山诗并画图二首 其一","author":"刘摰","text":"诛茅搜险旋寻真，闻说山岩一日新。\n佳境留连应有待，先时登览岂无人。\n披榛好石来如召，随手清泉应若神。\n不独山中兴胜事，几多风爱在邦民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙少卿鹿头山诗并画图二首 其二","author":"刘摰","text":"使君镇爱鹿头山，图画歌吟共为传。\n尘世那知武陵事，时人争诵永嘉篇。\n行春游醉常劳梦，按部登临又隔年。\n有客平生志林壑，坐怜双眼隔云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡景繁红梅三首 其一","author":"刘摰","text":"故人江驿寄瑶华，紫玉枝头散嫩霞。\n日暗露桃春尚浅，醉馀收面粉难遮。\n绿溪地静东风遇，雕槛香寒晓月斜。\n水满琉璃聊自喜，不堪尘眼秖空花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡景繁红梅三首 其二","author":"刘摰","text":"萧疏仙梗擢芳华，巧刻圆琼傅淡霞。\n素质本非桃杏质，酡颜聊避雪霜遮。\n香含暮雨栏边散，艳倚春风鬓上斜。\n闻说樽前偏属党，青黄朱粉更无花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡景繁红梅三首 其三","author":"刘摰","text":"仙圃瑶林冠物华，靓英明媚洗晴霞。\n醉装却费胭脂晕，纨扇应烦绛粉遮。\n天上念奴春睡足，风前飞燕舞容斜。\n后房宜劝歌声小，惜爱今年第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次红梅","author":"刘摰","text":"色不夭秾始是华，仙家林观倚云霞。\n春酣白玉醅香入，日射红鸾扇影遮。\n攒萼乱须能淡伫，抱枝寒蓓更疏斜。\n为寄瑶林主人语，争妍应有曲房花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭前有古槐一株枝叶扶疏广荫一亩每当月夕风晨辄为婆娑其下空翠滴衣心神清越感秋寄兴情见乎词","author":"刘摰","text":"绿玉交柯蔽郁深，碧萝寒幄静沈沈。\n最宜初旭晞晴霭，时有珍禽宅翠阴。\n终日对为佳客伴，几年相慰故溪心。\n主人已有秋风兴，更听疏蝉抱叶吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盆中移白菊","author":"刘摰","text":"九秋风露下星榆，玉刻圆钱散晓株。\n人住水涯多白发，地应花谷近清都。\n按香清酒登新谱，益气轻身载旧图。\n移取黄堂朝夕见，北洲亭远故台芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次南阳钱紫微白菊","author":"刘摰","text":"清根灵气本仙通，白玉葩华绿玉丛。\n山远莫寻幽谷水，洲香聊近百花丛。\n神寒缥缈梅同格，英出繁多雪愧工。\n篱下区区醉金蕊，郦卿应笑鹿皮翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵傅推官宏月菊","author":"刘摰","text":"应怜陶令爱东篱，分付黄花特地迟。\n百卉浪随秋色尽，孤芳自与岁寒期。\n冷香直欲梅相斗，金蕊悬知雪更宜。\n空使诗人咏重九，天公造物本无时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽慈圣光献皇后二首 其一","author":"刘摰","text":"翼子诒孙庙社功，忧劳嘉祐治平中。\n泽流自配皇图远，仙去谁期寿劫空。\n三献奄违长信殿，万灵神会永昭宫。\n母仪五十年间事，愁入西郊鼓吹风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽慈圣光献皇后二首 其二","author":"刘摰","text":"孝孙皇帝念终天，毁慕难留王座迁。\n庙谥易名尊四字，宸闱行服自三年。\n宝衣鸾凤藏华殿，哀仗星辰下洛川。\n从此都人想游幸，无因重见九龙軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽资政殿学士吏部尚书曾公二首 其一","author":"刘摰","text":"怀诏归来望九霄，伾山才隔渡河桥。\n履声未彻君王听，车左俄悲道路招。\n韦氏诗书传秘阁，石家孝谨冠中朝。\n灵輀闻说都门过，愁彻西风鼓吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽资政殿学士吏部尚书曾公二首 其二","author":"刘摰","text":"百岁悲欢俯仰间，讣惊畴昔涕汍澜。\n玉堂天圣传先契，兰省元丰事长官。\n寂寂尘音华屋闭，萧萧云木故山寒。\n深心令德今何愧，付与无穷后世看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋次道二首 其一","author":"刘摰","text":"橐笔周旋侍汉宫，慱知前载问无穷。\n朝廷人物儒林丈，家世文章太史公。\n俯仰顿惊华屋换，声容徒望穗帷空。\n寝门一哭何嗟及，付与悲哀挽铎风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽宋次道二首 其二","author":"刘摰","text":"平生襟尚苦清通，白首耽心翰墨中。\n万卷囊书推沈氏，一时碑字贵颜公。\n尘栖村馆稀宾至，山抱佳城与祖同。\n已矣善人那复见，萧萧溱洧秖秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀吕西台行父四首 其一","author":"刘摰","text":"大夫门户斗魁旁，落落南宫旧望郎。\n收敛壮心书万卷，沈浮高兴酒千觞。\n乘骢始欲新年去，藏壑俄惊半夜亡。\n索我赠言曾未暇，哀怀今变绋尘章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀吕西台行父四首 其二","author":"刘摰","text":"仙骨萧疏古柏秋，合于尘世独悠悠。\n人间未熟黄粱饭，天上新成白玉楼。\n隐几不闻遗治命，飞旌何日向西州。\n识君惟有崔夫子，预说衣冠一蜕留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀吕西台行父四首 其三","author":"刘摰","text":"前月南河欲放船，壶觞一夕暂盘桓。\n吐霏珠玉音犹在，风折筼筜墨未乾。\n皎皎不应随物转，滔滔从此缔交难。\n孤怀幽调谁知者，寂寞金徽不复弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀吕西台行父四首 其四","author":"刘摰","text":"吴兴空望使君车，道厄陈州亦命欤。\n归路自为兜率去，遗忠谁访茂陵书。\n秕糠世俗心无累，兰玉阶庭善有馀。\n一束生刍犹未至，春风洒泪满襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵唐诵植棕榈三绝句 其一","author":"刘摰","text":"亭亭员干直，剪剪翠轮齐。\n叶散夜叉样，恶名谁品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵唐诵植棕榈三绝句 其二","author":"刘摰","text":"荣悴逐时序，纷纷红翠多。\n谁同岁寒操，旁有羽林戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵唐诵植棕榈三绝句 其三","author":"刘摰","text":"种兰不当户，李以苦见容。\n珍重主人意，东亭非要冲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次长守长历两孙自汶寄读诗韵 其一","author":"刘摰","text":"阿守似其父，丰姿仍秀疏。\n别翁犹数月，书驿且渠渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次长守长历两孙自汶寄读诗韵 其二","author":"刘摰","text":"历也驹千里，新诗慰远思。\n霜秋鱼酒美，来趁寿觞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏简许教授","author":"刘摰","text":"虽有董盐甘寂寞，如闻颜粥更艰辛。\n莫将秉釜论多少，聊为君家拂甑尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马融绛帐台","author":"刘摰","text":"汉守曾为绛帐师，升堂高弟许抠衣。\n传经无复当时事，只有沙禽自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国风亭","author":"刘摰","text":"地灵真合有清辞，正在中和乐职时。\n谁道诸诗吟不尽，试看亭上国风诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复古亭","author":"刘摰","text":"功大文雄岁月深，巍然高碣字生金。\n台池得与吾民共，谁识邦家复古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"穿杨亭","author":"刘摰","text":"华构翚飞一望中，颜间篆墨飏秋风。\n休矜百步穿杨巧，未及当年射虎功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎春亭","author":"刘摰","text":"亭接东风近晓霞，几多和气到萌芽。\n也知当日迎春意，不为松筠只为花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝宗亭","author":"刘摰","text":"亭下长江走浪花，朝宗东委去无涯。\n何时银汉风涛稳，待泛仙人八月槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澄心阁","author":"刘摰","text":"危栏倒影下千寻，空水无声万象沉。\n试问登临来往客，几人澄得利名心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七瑞堂","author":"刘摰","text":"草木生成亦偶然，谁将枝干验祥编。\n如何并作当时瑞，寂寞如今五十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水舫","author":"刘摰","text":"天水相将远欲无，扁舟双桨似飞凫。\n此身未是逃名客，且学鸱夷泛五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双桥","author":"刘摰","text":"双桥十里跨虚明，波面无风两足轻。\n雨歇烟收人不见，路岐依约是蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月六日与客游金山乾明宣塔戒坛弥勒舍利广教七山寺三首 其一","author":"刘摰","text":"水落溪桥霜未寒，冈林平浅是西山。\n路穿峭茜青葱底，寺在崎岖屈曲间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月六日与客游金山乾明宣塔戒坛弥勒舍利广教七山寺三首 其二","author":"刘摰","text":"排门金碧七禅关，松阁相望石径连。\n不为勤求善知识，可能一日遍诸天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月六日与客游金山乾明宣塔戒坛弥勒舍利广教七山寺三首 其三","author":"刘摰","text":"行彻云烟到上方，青林深壑对重冈。\n山中底处饶风月，要著江州一草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作","author":"刘摰","text":"春气未强寒惨惨，羁人多病兴寥寥。\n闲愁付与毫端遣，长日期于局上销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张供备达夫观回雁峰二首 其一","author":"刘摰","text":"图志分明传者谬，峰名元在岳山隈。\n邦人试看春岩上，岂有燕鸿到此回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张供备达夫观回雁峰二首 其二","author":"刘摰","text":"林麓坡陀湘水侧，烟岚朝暮楚城隈。\n峰前迁客翻堪笑，不及飞鸿一岁回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樊山口二绝 其一","author":"刘摰","text":"洲觜崭崭乱石排，濯风寒浪踏苍苔。\n长江万里从西北，泻向幽人两足来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樊山口二绝 其二","author":"刘摰","text":"无数江鸥似雪霜，暂来还去俯沧浪。\n幽人已自忘机久，却恐窥鱼意未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日依唐生韵五绝句 其一","author":"刘摰","text":"三岁重阳负玉觞，悲欢不定客途长。\n元光节物真虚掷，赖有新诗付锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日依唐生韵五绝句 其二","author":"刘摰","text":"白醪趁节醅已发，黄菊候霜花未开。\n独上荒城拱双袖，风云惨惨雁声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日依唐生韵五绝句 其三","author":"刘摰","text":"无处登临百尺楼，若为销散仲宣忧。\n拒霜寒菊常烟雨，愁满江城冷澹秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日依唐生韵五绝句 其四","author":"刘摰","text":"悄悄登山临水兴，纷纷泛菊佩萸人。\n不须吹落簪花帽，但愿常存漉酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日依唐生韵五绝句 其五","author":"刘摰","text":"长松老桂风霜足，细草幽花雨露沾。\n天寒日下音书少，雁自高飞鱼自潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵燕中舍若水苦雨五绝句 其一","author":"刘摰","text":"湖水漫漫日夜添，芡芒蒲锷斗尖铦。\n不须更问雨多少，且喜西窗青入帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵燕中舍若水苦雨五绝句 其二","author":"刘摰","text":"风欺炊灶晨烟重，泥隔宾车午枕高。\n谁记幽人张仲蔚，都将三径付蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵燕中舍若水苦雨五绝句 其三","author":"刘摰","text":"池蛙联络声方旺，径草纵横势未锄。\n不厌微凉生枕簟，只忧新蠹入图书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]