[{"title":"小集食藕极嫩","author":"杨万里","text":"比雪犹松在，无丝可得飘。\n轻拈愁欲碎，未嚼已先销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小楼晚眺云日","author":"杨万里","text":"小楼挂上绿窗棂，落日孤云万态生。\n碧玉峰峦白银缘，峰峦暗处缘偏明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小溪至新田四首 其四","author":"杨万里","text":"懊恼春光欲断肠，来时长缓去时忙。\n落红满路无人惜，踏作花泥透脚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小溪至新田四首 其三","author":"杨万里","text":"晚云解事忽离披，放出千峰特地奇。\n欲拣一峰谁子是，总如笔未退尖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小溪至新田四首 其二","author":"杨万里","text":"只爱孤峰惹寸云，忽惊头上雨翻盆。\n北来南去缘何事，路上君看屐子痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小溪至新田四首 其一","author":"杨万里","text":"人烟懡㦬不成村，溪水微茫劣半分。\n流到前滩忙似箭，不容雨点稍成纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小滩三首 其三","author":"杨万里","text":"船里征人政念归，居人来看却嗟咨。\n居人祗羡征人著，世世安生不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小醉折梅","author":"杨万里","text":"死爱花枝不忍吹，醉来恣意折芳菲。\n鬓边插得梅花满，更撚南枝满把归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小憩栟楮","author":"杨万里","text":"笋舆放下倦腾腾，睡倚胡床撼不应。\n榉柳细花吹面落，误挥团扇扑飞蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小憩揭家冈谛观桐阴","author":"杨万里","text":"仰看阳光只见空，不如影里看梧桐。\n莫言日脚无行迹，偷转零分破寸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山云","author":"杨万里","text":"春从底处领云来，日日山头絮作堆。\n恋著好峰那肯去，欲开犹绕两三回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山庄李花","author":"杨万里","text":"山庄又报李花秾，火急来看细雨中。\n除却断肠千树雪，别无春恨诉东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"杨万里","text":"山行两日厌荒凉，田少山多多更长。\n一望不曾亏碧草，半分何似借青秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居午睡起弄花三首 其三","author":"杨万里","text":"浸得荷花水一盆，将来洗面漱牙根。\n凉生须鬓香生颊，沉麝龙涎却是村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居午睡起弄花三首 其二","author":"杨万里","text":"数片荷花漾水盆，忽然相聚忽然分。\n从教压捺沉盆底，依旧浮来无水痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居午睡起弄花三首 其一","author":"杨万里","text":"五年出仕喜还家，双桂成阴不阙些。\n午睡起来无理会，银盆清水弄荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居雪后二首 其二","author":"杨万里","text":"一点红尘未敢生，松间雪后政堪行。\n日光半破风微度，时作高林落果声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居雪后二首 其一","author":"杨万里","text":"春近能馀几许寒，雪花才落便销残。\n青松梢上兰根下，犹得三朝两日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山店松声二首 其二","author":"杨万里","text":"松本无声风亦无，适然相值两相呼。\n非金非石非丝竹，万顷云涛殷五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山店松声二首 其一","author":"杨万里","text":"脩涂残暑仆夫劳，午憩茅檐尺许高。\n忽有凉风飒然起，小松呼舞大松号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已至湖尾望见西山三首 其三","author":"杨万里","text":"千里都无半点山，如何敢望有人烟。\n不教远树遮拦却，芦荻生来直到天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已至湖尾望见西山三首 其二","author":"杨万里","text":"芦荻中间一港深，蒌蒿如柱不成簪。\n正愁半日无村落，远有人家在树林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已至湖尾望见西山三首 其一","author":"杨万里","text":"好风稳送五湖船，万顷银涛半霎间。\n已入江西犹未觉，忽然对面是西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已过吴江阻风上湖口二首 其二","author":"杨万里","text":"南风捲水入湖去，落尽波痕不复回。\n更被纲船碍归舫，一船过尽一船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已过吴江阻风上湖口二首 其一","author":"杨万里","text":"五日姑苏一醉中，醉中看尽牡丹红。\n阻风只怕松江渡，过了松江却阻风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其十一","author":"杨万里","text":"半晴半雨半暄凉，拖带春光未要忙。\n为报州家兼县里，吾乡改作万花乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其四","author":"杨万里","text":"百舌殷勤报晓晴，花梢做出百般声。\n饶渠学遍山禽语，至竟何曾学得莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其十二","author":"杨万里","text":"一春两脚滞东园，柳绊花牵不暂闲。\n今日酽晴天气好，杖藜看水更看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其五","author":"杨万里","text":"海棠重叶更妖斜，青帝翻腾别一家。\n格外出奇人不识，大红抹利小莲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其三","author":"杨万里","text":"海棠雨后不胜佳，子细看来不是花。\n西子织成新样锦，清晨濯出锦江霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其一","author":"杨万里","text":"今岁春迟雨亦然，生愁无水打秧田。\n不消三日如麻脚，线样溪流浪拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其六","author":"杨万里","text":"春寒偏勒牡丹迟，晚似常年半月期。\n上巳清明同一日，那时恰好放花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其八","author":"杨万里","text":"金作林檎花绝秾，十年花少怨东风。\n即今遍地栾枝锦，不则梢头几点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其十","author":"杨万里","text":"日影云光学镀金，好风不肯碎花阴。\n人言春色醲于酒，不醉衰容只醉心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其七","author":"杨万里","text":"手种花王五百窠，半来枯瘁半萌芽。\n东风未要都开了，每日教开三两花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其二","author":"杨万里","text":"半月春晴探物华，山园走得脚酸麻。\n从教三日风和雨，闭户烧香不看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未春日山居杂兴十二解 其九","author":"杨万里","text":"寒久花迟也大奇，雨膏饱足土膏肥。\n牡丹芍药君须记，管取花房二尺围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"杨万里","text":"脚底神通也自强，三更报我有飞霜。\n人言冬夜长如岁，不寐方知岁未长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐听雨","author":"杨万里","text":"雨到中宵寂不鸣，只闻风拂树梢轻。\n瓦沟收拾残零水，并作檐间一滴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不睡四首 其四","author":"杨万里","text":"眊氉浑如病起初，冬烘又似酒醒馀。\n睡乡幸有闲田地，不放诗人僦一居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不睡四首 其三","author":"杨万里","text":"清愁无数暗相随，酒是渠雠也是媒。\n醉里不知何处亸，等人醒后一时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不睡四首 其二","author":"杨万里","text":"望后更深月未明，暗蛩冻得总无声。\n闲心幸自清如水，万感还从不睡生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不睡四首 其一","author":"杨万里","text":"夜永无眠非为茶，无风灯影自横斜。\n拥裯仰面书帷薄，数尽承尘一簟花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中元日早起","author":"杨万里","text":"欲借微凉问万松，万松自热诉无风。\n清晨秋暑已如许，那更斜阳与日中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中和节日步东园三首 其三","author":"杨万里","text":"一年佳节又中和，三分春光一已过。\n莫恨峭寒花较晚，留连春色尽从他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中和节日步东园三首 其二","author":"杨万里","text":"五出桃花千叶绯，团栾绕树问芳菲。\n攀来欲折还休去，看到残红教自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中和节日步东园三首 其一","author":"杨万里","text":"两晨又不到东园，沙径朝来合小乾。\n可惜红梅将落去，怕风怕雨不来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月既望月甚佳二首 其二","author":"杨万里","text":"月到中秋故故无，今宵月好莫渠孤。\n旧传月径圜千里，影落金杯只粒珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月既望月甚佳二首 其一","author":"杨万里","text":"中秋无月莫尤天，月入秋来夜夜妍。\n且道今宵明月色，何曾减却半分圜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月宿青弋江晓行新寒","author":"杨万里","text":"新寒催我索衣裘，凉雨凄云总是愁。\n耐冷素娥今老去，夜来桂殿罢中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前二夕钓雪舟中静坐二首 其二","author":"杨万里","text":"去岁中秋政病馀，爱它月色强支吾。\n今年老矣差无病，后夜中秋有月无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前二夕钓雪舟中静坐二首 其一","author":"杨万里","text":"月到南窗小半扉，无灯始觉室生辉。\n人间何处冰壶是，身在冰壶却道非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为崇辨法沄师作林野二大字","author":"杨万里","text":"天下何人不爱官，弃官出世古今难。\n向来一觉钧天梦，便作林居野处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌臼烛","author":"杨万里","text":"焰白光寒泪亦收，臼灯十倍蜜灯休。\n忘情也似诚斋叟，烧尽心时不泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌祈酒二首 其二","author":"杨万里","text":"毛永乌祈山两崖，家家酒肆向江开。\n也知第一蒲萄色，只问米从何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌祈酒二首 其一","author":"杨万里","text":"入到严州不识田，一江两岸万青山。\n乌祈酒味君休问，费尽江波卖尽钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌贼鱼","author":"杨万里","text":"秦帝东巡渡浙江，中流风紧坠书囊。\n至今收得磨残墨，犹带宫车载鲍香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书孙公谈圃谈圃载子由为黄白术将举火一猫据炉而溺须臾不见","author":"杨万里","text":"少许丹砂和水银，鍊成紫磨赚痴人。\n颍滨莫笑狸奴著，却恐狸奴笑颍滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书斋夜坐二首 其二","author":"杨万里","text":"酒力欺人正作眠，梦中得句忽醒然。\n寒生更点当当里，雨在梅花蔌蔌边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书斋夜坐二首 其一","author":"杨万里","text":"棐几吹灯丈室虚，隔窗雨点响阶除。\n胡床枕手昏昏著，卧听儿童读汉书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云际寺前山顶却望幡竿鹧鸪诸山二首 其二","author":"杨万里","text":"远近青山列画屏，近山浓抹远山轻。\n高屏已出低屏外，更有孤峰出一层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云际寺前山顶却望幡竿鹧鸪诸山二首 其一","author":"杨万里","text":"幡竿岭带鹧鸪山，雪后霜前紫翠间。\n自掇胡床移好处，莫教漏眼一烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云际院小池荷花才落一叶急承之","author":"杨万里","text":"欲落荷花先自愁，如何落后免沉浮。\n谁将碧玉圆盘子，和蕊和花一一收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十六夜病中无聊起来步月五首 其五","author":"杨万里","text":"道是月明星便稀，阿瞒此句未为奇。\n今宵斗柄也不见，一镜孤光天四垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十六夜病中无聊起来步月五首 其四","author":"杨万里","text":"夏日虽炎夜却清，四更还更胜三更。\n露从玉兔须根落，风在银河浪底生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十六夜病中无聊起来步月五首 其三","author":"杨万里","text":"人睡方酣鸡未知，起来叫转月华西。\n南风吹落北斗柄，细数月中丹桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十六夜病中无聊起来步月五首 其二","author":"杨万里","text":"无求不必位三公，一饱何须禄万钟。\n只有人生安乐好，享它明月与清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月十六夜病中无聊起来步月五首 其一","author":"杨万里","text":"抛官放浪十三年，底事今年病懒残。\n旧健肯饶梅摘索，新羸翻羡竹平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元举叔莲花","author":"杨万里","text":"不著芙蓉近路栽，菰蒲深处却花开。\n晚香特地清人骨，多谢西风得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月九日晓登连天观","author":"杨万里","text":"小立层台岸幅巾，除莺作伴更无人。\n晓风草草君知么，不为高荷惜水银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月二十三日立秋","author":"杨万里","text":"暑中剩喜立秋初，特地西风半点无。\n旋汲井花浇睡眼，洒将荷叶看跳珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月六日小集二首 其二","author":"杨万里","text":"新蝉声涩亦无多，强与娇莺和好歌。\n尽日舞风浑不倦，无人奈得柳条何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月六日小集二首 其一","author":"杨万里","text":"青李来禽已眼明，新瓜入夏见何曾。\n酒边忘却人间暑，消尽金盆一丈冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月喜雨三首 其三","author":"杨万里","text":"今年不是雨来悭，不后秧时亦不前。\n自古浙西长苦涝，近来无涝恰三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月喜雨三首 其二","author":"杨万里","text":"玄云直下素光开，雨到前山只恐回。\n霹雳一声风一阵，为侬催上半天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月喜雨三首 其一","author":"杨万里","text":"守臣两月祷山川，诏旨才颁便沛然。\n不是格天缘诏旨，忧民天子本如天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分宜逆旅逢同郡客子","author":"杨万里","text":"在家儿女亦心轻，行路逢人总弟兄。\n未问后来相忆否，其如临别不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]