[{"title":"次韵无咎别后见寄","author":"陆游","text":"平日杯行不解辞，长亭况是送君时。\n几行零落僧窗字，何限流传乐府诗。\n归思恰如重酝酒，欢情略似欲残棋。\n龙蛇飞动无由见，坐愧文园属思迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王给事见寄","author":"陆游","text":"大手方司一世文，癯儒何敢望馀尘。\n谁知天上黄扉贵，肯记江边白发新。\n末路愈穷诗有祟，旧书浑忘笔无神。\n床头周易尊中酒，犹赖渠侬不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邢德允见赠","author":"陆游","text":"人间荣瘁固难穷，岁月推迁即老翁。\n马骏初非凡眼识，源深终与大川通。\n细思渭北希高价，终胜淮南诮发蒙。\n莫学三山顽钝叟，一生空耗太仓红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张季长正字梅花","author":"陆游","text":"倚桥临水似催诗，戏伴鹅黄上柳丝。\n万里西湖惊断梦，二年东阁忆幽期。\n插瓶直欲连全树，簪帽凭谁拣好枝。\n一味凄凉君勿叹，平生初不愿春知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈机宜见赠","author":"陆游","text":"邂逅今年得若人，翛然不染庾公尘。\n思幽屈子歌山鬼，语妙陈王赋洛神。\n初接笑谈忘老惫，熟观风度爱清真。\n花时飞尽频行乐，莫学衰翁睡过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周辅雾中作","author":"陆游","text":"一日篮舆十过溪，丹萸黄菊及佳时。\n端居恐作他年恨，联辔聊成此段奇。\n侧磴下临重涧黑，乱云高出一峰危。\n何时关辅胡尘静，太华山头更卜期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵季长见示","author":"陆游","text":"倚遍南楼十二栏，长歌相属寓悲欢。\n空怀铁马横戈意，未试冰河堕指寒。\n成败极知无定势，是非元自要徐观。\n中原阻绝王师老，那敢山林一枕安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林伯玉登卧龙","author":"陆游","text":"一纸临门喜欲颠，词源滚滚泻长川。\n旗旄外阃新元帅，风月名山古洞天。\n自笑屏居依近郭，每烦登望指孤烟。\n雄篇三复空兴叹，穷乃工诗似不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范文渊","author":"陆游","text":"箪瓢气已压膏粱，不傍朱门味更长。\n细看高人忘宠辱，始知吾辈可怜伤。\n岩扃勾漏新丹灶，香火匡庐古道场。\n剩欲与君坚此约，它年八十鬓眉苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其二","author":"陆游","text":"已著山林扫塔衣，洗除仕路剑头炊。\n心光焰焰虽潜发，颔雪纷纷已太迟。\n度日只今闲水牯，知时从昔羡山雌。\n掩关未必浑无事，拟遍寒山百首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其七","author":"陆游","text":"芋栗多储煮复煨，一尘那许到灵台。\n虹穿道室炉丹熟，龙吼空山匣剑开。\n蹑屩未成游地肺，掩扉聊欲隐天台。\n桃花荣谢吾何预，一任刘郎去后栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其八","author":"陆游","text":"探梅方忆雪中归，转眼青青子满枝。\n筑圃漫为娱老计，襞笺又赋送春诗。\n乞身何日还初服，坐食终年愧圣时。\n睡起西窗澹无事，一枰闲看客争棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其十","author":"陆游","text":"赵州行脚我安能，闲却床边六尺藤。\n钓阁卧听西涧雨，棋轩遥见北村灯。\n平生爱睡如甘酒，晚岁忧谗剧履冰。\n剩欲舒怀答清啸，半空鸾凤愧孙登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其六","author":"陆游","text":"祠禄恩宽亦例沾，屏居怀抱苦厌厌。\n戍边事往功名忤，迎客儿扶老病兼。\n遇兴榜舟无远近，破愁沽酒任酸甜。\n残年唯有读书癖，尽发家藏三万签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其四","author":"陆游","text":"感昔伤怀一喟然，事贤犹及绍兴前。\n此身颠仆应无日，诸老凋零不计年。\n客少可罗门外雀，家贫也办杖头钱。\n插花醉舞春风里，不学庞翁更问禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其九","author":"陆游","text":"宇内寓形财几时，西山俄已迫斜晖。\n百年过隙古所叹，众口铄金胡不归。\n已是平生行逆境，更堪末路践危机。\n夜香一炷无他祝，稽首虚空忏昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其三","author":"陆游","text":"身寄崦嵫欲尽时，且贪馀景伴儿嬉。\n故庐手种竹千个，醉帽时篸花一枝。\n蠹箧有书供夙好，衡门无客作新知。\n羊裘自欠封侯骨，敢道君房彻底痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵范参政书怀十首 其一","author":"陆游","text":"养气颓然似木鸡，谤谗宁复问端倪。\n生尘甑暖喜炊黍，轑釜羹香忘糁藜。\n万里曾游云栈北，一庵今卧镜湖西。\n残年老病侵腰膂，那得随人病夏畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑盱眙见寄并简其甥刘君","author":"陆游","text":"衣上空嗟京洛尘，故交半作白头新。\n众中初得见吾子，东观已疑无若人。\n仗马极知非久斥，沙鸥要是孰能驯。\n两章英妙同时到，赵壹囊中却未贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑唐老","author":"陆游","text":"宦游早日阙相闻，一面那知乃尔勤。\n秋钓清滩方入梦，晓穿细仗又逢君。\n骤看落笔惊风雨，便拟同舟卧水云。\n作意归休还会否，暮年无力起斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朝陵叶院察见寄","author":"陆游","text":"忆昨翩然别众仙，秋风吹鬓感凋年。\n虚斋无复客满座，败橐空馀诗百篇。\n高谊未忘林下约，清吟重结社中缘。\n不教落在尘埃地，万顷烟波一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"陆游","text":"禹会桥头江渺然，隔江村店起孤烟。\n冷云垂野雪方作，断雁叫群人未眠。\n万里漂流归故国，一生蹭蹬付苍天。\n暮年尚欲师周孔，未遽长斋绣佛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"陆游","text":"江上霜寒透客衣，闭窗羸卧不支持。\n羁孤形影真相吊，衰飒头颅已可知。\n潦缩稳经行雨峡，竹疏剩见挂猿枝。\n清樽可置须勤醉，莫望功名老大时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上观月","author":"陆游","text":"暗浪冲舟鞺鞳声，夷陵城下正三更。\n十分倾酒禁风力，一点无云祟月明。\n久坐不知衣露湿，浩歌时有水禽惊。\n诗成莫驾长鲸去，自是虚皇白玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上梅花","author":"陆游","text":"老来乐事少关身，犹喜尊前见玉人。\n岂是凄凉偏薄命，自缘纤瘦不禁春。\n娟娟月上明江练，黯黯天低糁玉尘。\n绝涧断桥幽独处，护持应有主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江干","author":"陆游","text":"霜晴忽念到江干，小蹇羸童路已乾。\n骨相岂能当富贵，鬓毛聊喜耐悲欢。\n客途冬暖衣裘薄，村市年丰酒盏宽。\n残腊即今无十日，剩求芹蓼助春盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江村","author":"陆游","text":"江村连夜有飞霜，柿正丹时橘半黄。\n转枕却寻惊断梦，拨炉偶见爇残香。\n医无绝艺空三易，死与浮生已两忘。\n拈得一书还懒看，卧听孙子诵琅琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江村二首 其二","author":"陆游","text":"误著儒冠不更论，白头且喜卧江村。\n林深栖鸟逐更噪，埭近过舟终夜喧。\n病起日惟翻断简，愁来时亦倒清尊。\n自嫌未绝知闻处，尚有僧敲月下门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江村二首 其一","author":"陆游","text":"江村一雨喜尘清，隐隐雷车意未平。\n莽苍郊原来暮色，飕飗林壑起秋声。\n书希简古终难近，诗慕雄浑苦未成。\n白首愈悲知我少，从今一技不须名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江村道中书触目","author":"陆游","text":"短篱曲曲对开门，修竹阴阴不见村。\n别浦回潮鱼沪密，孤舟春近雁沙温。\n路逢行客时交辔，店卖新醅一举樽。\n忽过乱山幽绝处，恍如白帝到东屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江亭","author":"陆游","text":"千载涛江上，书生诵所闻。\n铸形尊越蠡，抉眼悼荆员。\n高鸟冲烟没，轻舟压浪分。\n何由从此逝，挥手谢诸君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江亭","author":"陆游","text":"野市逢虚日，江亭候暮潮。\n虫号霜后草，人立雨中桥。\n病骨羸将折，残魂黯欲消。\n无心作村醉，酒旆苦相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江亭冬望","author":"陆游","text":"霜落江清水见鱼，偶来徙倚草堂孤。\n雪天黯淡常如晚，烟树微茫直欲无。\n下泽乘车终碌碌，上方请剑漫区区。\n拟将疏逸消豪气，寻罢酒徒寻猎徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江亭晚思","author":"陆游","text":"本自无闲况有忙，远坊兀兀送年光。\n太空不碍云舒卷，高枕宁论梦短长。\n山破霁烟千万叠，鸟横潮浦两三行。\n年来自笑诗情减，愁绝奚奴古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江夏与章冠之遇别后寄赠","author":"陆游","text":"骑鹤仙人不可呼，一樽犹得与君俱。\n未应湖海无豪士，长恨乾坤有腐儒。\n壮岁光阴随手过，晚途衰病要人扶。\n凄凉江夏秋风里，况见新丰旧酒徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江陵道中作","author":"陆游","text":"山川杂吴楚，气候接秋冬。\n水落鱼可拾，霜清裘欲重。\n乡遥归梦短，酒薄客愁浓。\n白帝何时到，高吟酹卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江渎池醉归马上作","author":"陆游","text":"久住西州似宿缘，笙歌丛里著华颠。\n每嗟相见多生客，却忆初来尚少年。\n迎马绿杨争拂帽，满街丹荔不论钱。\n浮生何处非羁旅，休问东吴万里船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江楼","author":"陆游","text":"急雨洗残瘴，江边闲倚楼。\n日依平野没，水带断槎流。\n捣纸荒村晚，呼牛古巷秋。\n腐儒忧国意，此际入搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江楼夜望","author":"陆游","text":"江楼百尺倚高寒，上尽危梯宇宙宽。\n秋近渐看河落角，天回更觉斗阑干。\n茫茫浦口烟帆远，坎坎城头漏鼓残。\n要得故人同蹑屐，一尊相属话悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江楼醉中作","author":"陆游","text":"淋漓百榼宴江楼，秉烛挥毫气尚遒。\n天上但闻星主酒，人间宁有地埋忧。\n生希李广名飞将，死慕刘伶赠醉侯。\n戏语佳人频一笑，锦城已是六年留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江路","author":"陆游","text":"江路最初程，飘然两屦轻。\n少留云际宿，徐待月明行。\n雁起平沙影，泉轻断岸声。\n谁知游剡兴，不减上青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上","author":"陆游","text":"旋移吟榻并池横，欲出柴门复懒行。\n树罅忽明知月上，竹梢微动觉风生。\n贫无醉日惟坚忍，疾遇凉秋亦渐平。\n二尺灯檠元好在，便思相伴听蛩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上晚雨","author":"陆游","text":"乌纱白葛一枝筇，罨画池边溯晚风。\n云叶初生高树外，雨声已到乱荷中。\n凭阑顿觉氛埃远，回首方知暑毒空。\n阅世万端惟小忍，何人更事似衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池亭夜赋","author":"陆游","text":"池上小亭幽，清宵秉烛游。\n荷盘时泻露，萤火早知秋。\n有感岁时速，无声河汉流。\n殊方不堪住，归梦绕沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯下看梅","author":"陆游","text":"风雨经旬怯倚阑，梅花折得就灯看。\n有情应记去年别，无寐不禁清夜寒。\n病起支筇幽兴在，春迟载酒后期宽。\n篱东数树尤奇绝，日遣蛮童候路乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯下阅吏牍有感","author":"陆游","text":"老眼今年太负渠，羲经鲁史顿成疏。\n一为柱后惠文吏，厌读司空城旦书。\n正苦雁行须束缚，不言鼠辈合诛锄。\n致君尧舜元无术，黄卷何辞饱蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百岁","author":"陆游","text":"百岁纷纷易白头，一年鼎鼎又清秋。\n壮心空似骥伏枥，病骨敢怀狐首丘。\n屠钓论交成酒隐，山林高卧得天游。\n莫悲晚节功名误，即死犹堪赠醉侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪怀","author":"陆游","text":"未斸要离冢畔云，侩牛得食寄乡枌。\n修身本欲善吾死，临事岂忘尊所闻。\n时序管宁亲馈奠，江山庞老上丘坟。\n饰巾家箦从来事，万种悠悠莫苦分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老去","author":"陆游","text":"老去时时病，春来日日阴。\n文书有期会，山水负登临。\n倦客风埃眼，孤臣狗马心。\n馀寒欺短褐，莫惜酒杯深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老叹","author":"陆游","text":"人生易衰老，万事海涛翻。\n但恨芳尊迮，宁悲雪鬓繁。\n诸儒轻古学，遗虏盗中原。\n有语谁能听，毋矜舌尚存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老叹","author":"陆游","text":"齿发衰残久退休，衡茅荒寂更禁秋。\n一无用力身犹倦，百不关心梦亦愁。\n远浦卧看凫泛泛，深林时听鹿呦呦。\n天台日有游僧过，白朮黄精不待求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老叹","author":"陆游","text":"步迟腰伛偻，面瘦骨峥嵘。\n贫病消前业，耕樵乐太平。\n有歌悲易水，无酒醉湖城。\n何许容身得，门前钓艇横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老叹","author":"陆游","text":"事与年俱往，心于世转疏。\n曼肤销欲尽，鬒发变无馀。\n野店通赊酒，邻翁伴荷锄。\n尚嗟馀习在，梦课吏钞书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老叹","author":"陆游","text":"一齿危将堕，双瞳久已昏。\n谋生赖蔬圃，养拙闭柴门。\n多病从来惯，虚名不足论。\n自怜馀一念，犹欲济元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老叹","author":"陆游","text":"老翁终日饱还嬉，常拾儿童竹马骑。\n食为齿摇艰咀嚼，冠因发少易倾攲。\n乌乌歌罢人谁问，咄咄书成自不知。\n堪笑残生似蒲柳，秋风未到已先衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老民二首 其二","author":"陆游","text":"老民无一事，终日卧柴扉。\n凿沼观鱼乐，钩帘待燕归。\n架高藤叶密，土润药苗肥。\n休退真吾分，无心学息机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老民二首 其一","author":"陆游","text":"乞得不赀身，林间号老民。\n儿因作诗瘦，家为买书贫。\n村仆欺谩少，邻翁语笑真。\n今朝盐酪尽，荠糁更宜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老伶","author":"陆游","text":"老伶头已白，相识不论年。\n时出随童稚，犹能习管弦。\n烟林梅市路，风幔放翁船。\n馀酒堪同醉，君无惜醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老怀","author":"陆游","text":"身见高皇再造初，名场流辈略无馀。\n旧书科斗才存字，薄业蜗牛仅有庐。\n迂士岂堪新贵使，少年自与老人疏。\n荒园寂寂堆霜叶，抱瓮何妨日灌蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老怀","author":"陆游","text":"老怀常易感，秋雨苦难晴。\n羁枕悲欢梦，高城长短更。\n荣枯一蚁垤，成坏几棋枰。\n抱疾茅檐下，行人肯寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老身","author":"陆游","text":"老身无处著，登望忆闲游。\n白浪浮天远，黄云出塞秋。\n百年殊鼎鼎，万事只悠悠。\n岁晚长亭路，寒侵季子裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老学庵","author":"陆游","text":"老学衡茅底，秋毫敢自欺。\n开编常默识，闭户有馀师。\n大节艰危见，真心梦寐知。\n唐虞元在眼，生世未为迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老学庵","author":"陆游","text":"穷冬短景苦匆忙，老学庵中日自长。\n名誉不如心自肯，文辞终与道相妨。\n吾心本自同天地，俗学何知溺秕糠。\n已与儿曹相约定，勿为无益费年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老学庵夜兴","author":"陆游","text":"冷卧空斋枕曲肱，饥鹰惊起发鬅鬙。\n烟霞华岳逃名客，风雪庐山入定僧。\n槲叶蔽身胜衣帛，金丹照室不燃灯。\n秃翁自笑无名字，聊向江湖袭旧称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老态二首 其二","author":"陆游","text":"寡欲贫何损，无才老更宜。\n挂墙多汉刻，插架半唐诗。\n饭已频摩腹，儿来暂解颐。\n尚悲吴蜀远，未免故人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老态二首 其一","author":"陆游","text":"破榼愁春近，空囷畏日长。\n头风便菊枕，足痹倚藜床。\n冉冉残年逼，悠悠万事忘。\n有儿堪晤语，无客亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]