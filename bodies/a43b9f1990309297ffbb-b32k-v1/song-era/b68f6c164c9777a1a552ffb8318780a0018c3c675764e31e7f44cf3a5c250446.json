[{"title":"再次韵菊花谱系四首 其一","author":"项安世","text":"人道花生绝域，此花或系西夷。\n薝卜林中妙馥，金光明里真肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其三","author":"项安世","text":"望海亭前句远，蓬莱阁上诗寒。\n老子向来椽笔，要题吉日斯干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其五","author":"项安世","text":"叹息五陵翁仲，春来草路长堙。\n钜鹿空怀故将，海山空著诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其八","author":"项安世","text":"广文已荒茆屋，彭泽浪耻虚罍。\n二顷平生幽愿，一犁归处深推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其一","author":"项安世","text":"湖海峥嵘老气，风云惨淡高情。\n可惜元龙双鬓，江南江北诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其十","author":"项安世","text":"圣处耘耔日浅，俗间葑淤年深。\n蚤岁襟期何许，如今翻愧初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其九","author":"项安世","text":"麦熟啼声未了，藕花醉魄还馨。\n只么跳丸日月，何年检玉云亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其二","author":"项安世","text":"听说忠臣孝子，不论往事今人。\n衣上淋浪清泪，一生长为君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其四","author":"项安世","text":"少日心随鹗上，长年身伴鸥闲。\n昨夜松声到枕，梦魂踏破天山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其六","author":"项安世","text":"丰年官事无何，梅月诗情最多。\n白水暗添沤界，青苔乱长松科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其七","author":"项安世","text":"文命生轻癸甲，祖龙死惑燕齐。\n矗矗秦山易识，茫茫禹穴难稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和王少清春游","author":"项安世","text":"自笑年来多病，一春辜负嬉游。\n造物故禁双眼，东风为惜缠头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘都干菊花六首 其六","author":"项安世","text":"断无罗绮追随，政要儿曹鄙夷。\n千古一人知己，重阳无酒温肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘都干菊花六首 其五","author":"项安世","text":"暖风和日花时，不共人争丑夷。\n自爱霜深月冷，累累金粟生肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘都干菊花六首 其四","author":"项安世","text":"食杞何须慕陆，采薇未用誇夷。\n别有寒潭秋蕊，能留鹤发松肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘都干菊花六首 其三","author":"项安世","text":"霜神亦有丰韵，未可寻常等夷。\n赤尽江头枫叶，却能遍护花肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘都干菊花六首 其二","author":"项安世","text":"长恨独醒无赖，和英餐向冯夷。\n我自浮沈酒里，鹅黄薰透香肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵潘都干菊花六首 其一","author":"项安世","text":"花草春时迹远，风霜急处心夷。\n生怕枕帏收去，粉香脂气薰肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其十","author":"项安世","text":"朅来此事尽废，少日论功未深。\n欲觅仙人一指，要看月胁天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其九","author":"项安世","text":"苦心自在阿堵，圣处谁知宁馨。\n佳句忽来天外，恰能当当亭亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其八","author":"项安世","text":"小人区釜升斗，明公钟鼎尊罍。\n难学将军竞病，且随寒士敲推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其七","author":"项安世","text":"玄思上窥姚姒，后尘肯逐梁齐。\n谁言今世第一，我自古人与稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其六","author":"项安世","text":"诗声长甬则震，笔阵战功曰多。\n自抽天上机杼，不落人间臼科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其五","author":"项安世","text":"雅颂意久不闻，周孔业将遂堙。\n若要兴灭继绝，不妨动地惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其四","author":"项安世","text":"脱腕流泉纚纚，忘怀大智闲闲。\n学苏二李十二，笑山谷陈后山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其三","author":"项安世","text":"从来赐达由果，不说岛瘦郊寒。\n政誉追还小范，诗名压倒方干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其二","author":"项安世","text":"西牧村风流老，翰林里供奉人。\n去之虽五百载，斩新料敌堪亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安抚六言十首 其一","author":"项安世","text":"堆案牛腰万轴，消磨不尽诗情。\n定应是我辈语，掷地当作金声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗机宜竟陵督捕六首 其六","author":"项安世","text":"已赋阳台行雨，还看梦泽连云。\n为问当时平土，如今多少耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗机宜竟陵督捕六首 其五","author":"项安世","text":"好把从军乐事，新诗细入邮筒。\n我亦平生湖海，日来颇困头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗机宜竟陵督捕六首 其四","author":"项安世","text":"只合笑谈油幕，亦烦亲拥雕戈。\n小试异时颇牧，要观方略如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗机宜竟陵督捕六首 其三","author":"项安世","text":"万仞山根蝼蚁，千车辙底螳螂。\n不怕麷蕡婴刃，只忧玉石焚冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗机宜竟陵督捕六首 其二","author":"项安世","text":"共是天家赤子，可怜地上游魂。\n去草固嫌滋蔓，遏流须藉澄冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗机宜竟陵督捕六首 其一","author":"项安世","text":"飐飐旌旗出郭，轰轰雷电奔空。\n一夜楚江风雨，千岩万壑流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题上遇雨","author":"项安世","text":"风声千岩万壑，雨意三江五湖。\n横笛平生幽愿，小舟归去良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"便桥泊舟","author":"项诜","text":"身寄一叶舟，扰扰又行役。\n不知寒袭人，但觉酒无力。\n霜剥岸石裂，风激水波逆。\n望眼浩无涯，远山相对碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中忆兄弟","author":"项容孙","text":"鸿雁不成行，飘零岁月长。\n一身三处梦，五夜九回肠。\n积雪欺茅屋，孤灯照锦囊。\n何当听夜雨，却话此凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和酴醾韵","author":"项寅宾","text":"天遣司花宝笈开，鲛绡散剪碧云堆。\n芳根移自蚕丛远，薰酿曾随凤诏来。\n祇恐飘风撼新竹，却惊残雪触苍苔。\n水仙欲逞幽香压，山谷似无诠品才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范至能元日","author":"项寅宾","text":"献岁身留外，思家恨满中。\n桃符禳厉鬼，椒酒劝仙童。\n出谒凭羸马，题书附去鸿。\n青春应时节，斗柄夜摇东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和郑逢辰元宵韵","author":"项寅宾","text":"忆昔先皇赏露台，鳌山半影落蓬莱。\n群芳欲识龙颜喜，双阖时瞻雉扇开。\n十里仙香濛碧雾，六宫韶乐隐新雷。\n神仙旧事浑如梦，只有春风每岁催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"项寅宾","text":"冻云同色坠飞霙，送腊迎春一岁成。\n但见红花洗芳面，那闻黄竹度新声。\n密移琼室祥光满，倒泻银河白浪平。\n已属画师图此景，炎蒸相对卧桃笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逍遥峰访李觏不遇","author":"饶子尚","text":"叠嶂南奔似跃龙，逍遥楼畔识奇踪。\n云根盘地三千丈，石徇参天第一峰。\n岁久已知苍藓合，晓来常怪翠云封。\n肩舆却过株槎路，曙色岚光隔几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金山","author":"饶方","text":"地将灵气吐林峦，至宝曾淘瓦砾间。\n若把图经重校定，此山宜唤作金山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眠石","author":"饶节","text":"静中与世不相关，草木无情亦自闲。\n挽石枕头眠落叶，更无魂梦到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"饶节","text":"松下柴门闭绿苔，只有胡蝶双飞来。\n蜜蜂两股大如茧，应是前山花已开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚起","author":"饶节","text":"月落庵前梦未回，松间无限鸟声催。\n莫言春色无人赏，野菜花开蝶也来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游麻姑山","author":"饶师道","text":"拂晓旌幢远访真，洞中和气一番新。\n争迎谢守同游客，尽是方平旧会人。\n山峭亭台多占月，地灵风物只知春。\n清欢何必笙簧助，自有红泉碧涧邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无弦琴","author":"饶延年","text":"月作金徽风作弦，清音不在指端传。\n有时弹罢无生曲，露滴松梢鹤未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜游黄鹤楼遇道人","author":"饶廷直","text":"黄鹤楼前秋月寒，楼前江阔烟漫漫。\n夜深人散万籁息，独对清影凭阑干。\n一声长啸肃天宇，知是餐霞御风侣。\n多生曾结香火缘，邂逅相逢竟相语。\n翛然洗尽朝市忙，直疑身在无何乡。\n回看往事一破甑，下视举世俱亡羊。\n嗟予局促犹轩冕，知是卢敖游未远。\n他年有约愿追随，共看蓬莱水清浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹径步月","author":"饶良辅","text":"素月流空天不夜，清辉散入疏林下。\n下有幽人独往来，杖藜缥缈谁能画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示儿鲁","author":"饶炎","text":"匡居终日只钦钦，一寸灵台万古心。\n鹿洞象山前路在，频思寡过到而今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禅峰寺","author":"饶南强","text":"禅山乔木饱苍烟，柿叶能来老郑虔。\n楼阁暮寒风铁定，与僧分展对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水心亭","author":"饶道深","text":"两岸尘埃终不到，四檐风月冷无声。\n路从碧树阴中断，人向红莲影里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"饶道深","text":"落霞断岸斜阳里，万里江天画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶洲","author":"饶鲁","text":"浔阳江上谱无传，化作沙汀越水边。\n一段遗音人不识，夜深幽咽下滩泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石潭急峡","author":"饶鲁","text":"两山夹石湍风急，势吼春雷鬼神泣。\n行人登舟不敢渡，疑有毒龙深处蛰。\n崄巇彷佛若霅川，又如三峡倾潺湲。\n水窍恐是神禹凿，石骨未遇秦皇鞭。\n飞流溅沫弄寒玉，赴壑奔滩势何速。\n直须流入镜湖心，如遇平夷舟免覆。\n垂杨覆阴沙岸高，将军唤渡多英豪。\n中流击楫思祖逖，当清宇宙无辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远浦棹歌","author":"饶鲁","text":"片帆雨霁飞烟江，渔翁停棹歌沧浪。\n一声欸乃山水绿，浪中惊起双鸳鸯。\n双鸳鸯情一何美，同宿同飞在秋水。\n不似人生苦别离，女嫁征夫男战死。\n五湖烟景方纷争，闻歌顿欲思升平。\n邻舟短笛应风响，落日淡淡波冥冥。\n美人春词誇艳丽，皓齿朱唇楚腰细。\n江楼富贵今如何，不似沧浪真趣味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春水番湖","author":"饶鲁","text":"春湖浩浩无津涯，银河之水天上来。\n波澜万顷清复浊，日光云影相昭回。\n雄吞宇宙何寥廓，欲度冥鸿势还却。\n南通海气北长江，月出东兮日西落。\n当时神禹别九州，彭蠡之泽居上流。\n千年人物馀润泽，况乃雄秀光潜虬。\n洪涛如山驾楼橹，春风夜夜喧鼙鼓。\n谁是江湖归去人，扁舟范蠡随渔父。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重湖夜月","author":"饶鲁","text":"昔闻放翁歌镜湖，船尾有酒船头书。\n又闻鉴湖赐贺老，剡川一曲春风好。\n番阳之东有重湖，风光与此真不殊。\n澄波湛湛秋瑩洁，碧月一片沈冰壶。\n彩舟荡漾摇画桨，上下天光映虚幌。\n踏歌搥鼓乐者谁，武陵樵客来湖上。\n赋诗横槊何英雄，气概或誇前两翁。\n我思此景劳梦寐，东望咄咄徒书空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"稠山茅屋","author":"饶鲁","text":"乱山堆翠如削玉，中有幽人结茅屋。\n柴扉寂寂掩苍苔，书院萧萧倚修竹。\n閒云满堑白日长，咿唔朝暮声琅琅。\n芸窗纸破漏月影，石砚水满涵天光。\n风尘频动遍丘壑，此处怡然有真乐。\n门静应无俗客过，茅深不怕秋风恶。\n高人有才济当路，会见徵贤日三顾。\n愧我飘蓬石洞人，茅屋青山在何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送向综通判桂州","author":"饶奭","text":"百粤封疆桂岭崇，□□□□□□□。\n十城县弩争趋府，五管侯圭尽偃风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"骆仲舒","text":"张鸿诗在楞伽峡，韩愈碑留燕喜亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"骆安基","text":"扪萝探得云根路，直入云山最深处。\n主人心似青山閒，云亦无心自来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其七","author":"骆罗宪","text":"天开万象真图画，日照千林古锦机。\n立马溪边看不足，夷犹直待月生辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其六","author":"骆罗宪","text":"数声猿叫闽山月，千里思家欠羽翰。\n疑怪五更衾枕冷，霜壶凛凛逼人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其二","author":"骆罗宪","text":"世上平生懒所更，有怀真欲仿渊明。\n无端唤作铅山尉，刚替渠人负弩行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其十","author":"骆罗宪","text":"驿路新安掌面平，扬尘从此去朝京。\n清风只欠苍松立，留待他时我种成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其八","author":"骆罗宪","text":"楼前山色古今景，楼外溪声日夜雷。\n静坐焚香读周易，丁宁莫放俗人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其五","author":"骆罗宪","text":"勉强驱驰力不堪，笋车肱曲睡方酣。\n思归梦逐来时路，无奈杜鹃声两三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其九","author":"骆罗宪","text":"端明遗爱在南台，百万乔松手自栽。\n欲唤清风满江左，峥嵘头角且安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其一","author":"骆罗宪","text":"山路相随步步高，忘怀携手上嵯峨。\n掀髯长啸青云去，回首跻攀有许劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其三","author":"骆罗宪","text":"山从顶上分闽越，四面群峰簇仗齐。\n自是心同天广大，不妨眼趁地高低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与廖检法同行口占分水岭诗 其四","author":"骆罗宪","text":"尽道今年雨意稠，踏歌芒时偏东畴。\n微官祇有年丰愿，一饱高眠万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西园席上记事","author":"骆适正","text":"花随春尽觅无痕，尚续馀欢索侑尊。\n一曲未终人已去，西园灯火欲黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]