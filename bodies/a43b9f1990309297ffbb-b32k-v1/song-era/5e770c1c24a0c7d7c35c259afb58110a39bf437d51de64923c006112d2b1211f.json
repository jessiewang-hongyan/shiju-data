[{"title":"送赴省诸先辈","author":"王十朋","text":"国朝人物盛温陵，秋赋呦呦鹿食苹。\n人倍平原门下士，文联韩愈榜中名。\n丹墀何止三千字，云翼行看九万程。\n劝驾龙钟老太守，篮舆准拟出郊迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵夔漕赵若拙见寄 其一","author":"王十朋","text":"去秋移郡近家乡，便殿狂言拜手扬。\n何敢许身为稷契，偶因论事及尧汤。\n民虽屡试如冯翊，诏未能焚愧益昌。\n乞得祠宫养衰病，梦中依旧坐黄堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵夔漕赵若拙见寄 其二","author":"王十朋","text":"夔门邂逅恨匆匆，君驾重来我已东。\n陈迹徒劳长者记，清樽那复故人同。\n光华持节花溪上，老病分符佛国中。\n吾辈栖栖不黔突，此生休更问天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭令人","author":"王十朋","text":"三十年间共苦辛，忽然惊断梦中因。\n钟情正是我辈事，鼓缶忍同方外人。\n熊胆未酬平昔志，牛衣犹是向来贫。\n闽山满眼同来路，木落风号泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贡院车水筑基诸公惧伤鱼鳖活之别沼","author":"王十朋","text":"塞沼增基大厦成，群鲜亦免校人烹。\n洋洋圉圉诸公赐，要与吾君广好生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出郊劝农 其一","author":"王十朋","text":"六年四郡劝农耕，自欲归耕尚未成。\n游宦何如在家好，一廛从此愿为氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出郊劝农 其二","author":"王十朋","text":"守臣忧国愿年丰，半刺双凫此念同。\n安得时旸时雨若，有生均在泰和中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出郊劝农 其三","author":"王十朋","text":"小麦含花大麦黄，一年春事已相将。\n篮舆遍入三精舍，拨得公家半日忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出郊劝农 其四","author":"王十朋","text":"一千石俸窃南州，老病馀生厌宦游。\n已上祠章即归去，一犁烟雨事西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题灵秀峰禅院","author":"王十朋","text":"小小精蓝亦自奇，一峰灵秀蕴幽姿。\n无缘细听山僧话，太守偷闲止片时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送九座讷老 其一","author":"王十朋","text":"禅老遥从九座来，一言为我洗尘埃。\n飘然又向山中去，白首相逢更几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送九座讷老 其二","author":"王十朋","text":"至乐亭中半月留，溪山杖屦饱寻幽。\n见师忽起庐山梦，梦向旧时游处游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崔肃之自湖至泉迁二亲之丧归葬诗以送之","author":"王十朋","text":"鄱水同僚旧，遥从霅水来。\n异乡欣觌面，清话洗衔哀。\n葱郁佳城就，勤劳孝子回。\n不应淹榷酤，中外正须才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜闻子规痛念亡者","author":"王十朋","text":"梦觉音容杳莫追，子规声里涕沾衣。\n催归无计同归去，耘后耕前事已非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南宫揭榜温陵得人为盛提舶马寺丞有诗赞喜次韵","author":"王十朋","text":"龙虎乡邦地最灵，鲲鹏相继上南溟。\n已闻元凯宾虞国，行见渊骞冠孔庭。\n帝遣伏波持使节，天教平海会文星。\n铃斋忽报捷音至，一炷清香千佛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸公廷对甫迩复用前韵","author":"王十朋","text":"清源紫帽发英灵，万斛词源水注溟。\n遥想恩袍动草色，定知喜气彻天庭。\n名高虎榜唐文杰，人半云台汉列星。\n累月笞儿几翁妪，夜深灯火督穷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵知宗春阴","author":"王十朋","text":"行人怨雨农忧旱，永叔元之事可明。\n不叹花前无客饮，且欣郊外有农耕。\n知公兴已烟霞重，顾我心尤势利轻。\n天意稍佳民事急，总将行乐付宗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵知宗游北山","author":"王十朋","text":"州北有山幽更幽，皇天阁雨为公游。\n登高如入上下竺，宴坐疑临大小湫。\n扫地焚香烟缕袅，煎泉瀹茗乳花浮。\n观诗起我家山兴，身在闽南梦在瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼亡 其一","author":"王十朋","text":"燕寝焚香老病身，细君相对坐如宾。\n而今一榻维摩室，唯与无言法喜亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼亡 其二","author":"王十朋","text":"不见音容忽三月，无从涕泗已千行。\n家山准拟欲归隐，堪叹相随无孟光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼亡 其三","author":"王十朋","text":"偕老相期未及期，回头人事已成非。\n逢春尚拟风光转，过眼忽惊花片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼亡 其四","author":"王十朋","text":"夤缘偶作于飞侣，梦寐相随到数州。\n泥上迹留鸿已去，舟中刻在剑难求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵知宗酴醾","author":"王十朋","text":"万斛虬珠眩眼明，傲春迟吐冠园英。\n诗因居士价方重，酒赐名臣花遂荣。\n香异竹间吹细细，韵如堂上出盈盈。\n芳姿自可友兰蕙，惜不当时遇独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游承天寺后园登月台赠潜老 其一","author":"王十朋","text":"三径荒芜未许寻，篮舆来访小园林。\n因知燕寝凝香地，不似禅房花木深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游承天寺后园登月台赠潜老 其二","author":"王十朋","text":"月台无屋有空坛，空处观空眼界宽。\n不惹世间尘一点，冰轮心镜两团团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送贾岩老还乡 其一","author":"王十朋","text":"闽江艰险岭崔嵬，不惮冲寒冒雪来。\n留我铃斋两三月，扁舟载得义风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送贾岩老还乡 其二","author":"王十朋","text":"堂上慈亲数月违，片心遥逐白云飞。\n伤心尽听秭归鸟，难弟言归秭不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送贾岩老还乡 其三","author":"王十朋","text":"乃翁贤德冠吾乡，伯氏声名蔼上庠。\n更喜君如里曾子，少年孝义已非常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送岩老出北门 其一","author":"王十朋","text":"暮春送客北山门，厌坐黄堂喜见村。\n麦熟秧青农事急，十分归兴在田园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送岩老出北门 其二","author":"王十朋","text":"客欲东归出北门，又闻联骑过西村。\n慇勤为遣十从事，莫惜醉吟祇树园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送傅兴化","author":"王十朋","text":"五马躬迎八十亲，甘棠如旧治惟新。\n欢传此日来廉范，记得当时借寇恂。\n江海聊淹把麾手，庙堂无是荐贤人。\n送君为守泉南守，政拙才疏藉宝邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹梦良寄柑闻诗闻礼辈取以祭母哭泣不已","author":"王十朋","text":"嘉果遥来自故乡，去冬初熟记同尝。\n尔衔怀橘无穷恨，我亦传柑念不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四月八日贡院上梁","author":"王十朋","text":"广厦初成万柱标，脩梁巍跨玉虹腰。\n况逢此日生千佛，定引群仙上九霄。\n下笔蚕声纷战艺，出林莺友竞迁乔。\n清源人物从今盛，孝子忠臣满圣朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸公和诗复用前韵 其一","author":"王十朋","text":"脩梁欲举綵先标，声撼春雷鼓百腰。\n溪蛰蛟龙欣得雨，桐栖鸾凤合冲霄。\n清源水接南溟阔，紫帽山齐泰岳乔。\n学不负人宜自勉，前贤勋业著三朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸公和诗复用前韵 其二","author":"王十朋","text":"梁脊连年姓误标，两州骚客瘦吟腰。\n月河月满燕贺厦，佛国佛生虹挂霄。\n多士颜欢歌杜老，一轮香满赋张乔。\n此途不止为科第，名节崔嵬看立朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼亡 其一","author":"王十朋","text":"伤哉无复见，老矣不成偕。\n牢落凝香地，同谁话此怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼亡 其二","author":"王十朋","text":"相勉惟清白，囊如四壁空。\n难忘将绝语，劝我莫言穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"薛士昭主管母夫人加封送酒为寿薛有诗谢次韵以酬","author":"王十朋","text":"庆事公家奕世传，生封锦告出甘泉。\n荣亲行有千钟禄，为寿惭无百斛船。\n喜气在颜窥贵客，清风满枕扇高眠。\n朝廷指日先封薛，归侍萱堂冕有蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴宪知叔","author":"王十朋","text":"出郊闻好语，尽道宪车贤。\n郡不留三宿，人皆仰二天。\n荐章先白屋，贡宇给青钱。\n上正开宣室，公归席定前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈雨未应提舶知宗道观焚香明日遂雨提舶有诗次韵","author":"王十朋","text":"一雨谁之力，因公发善心。\n同为上公请，小作傅岩霖。\n高廪行将实，南风日已骎。\n涓辰祈善利，感应亦犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵知宗贺雨","author":"王十朋","text":"云飞初类愈随郊，珠忽跳空室舞蛟。\n但愿农多大田稼，不愁风捲少陵茅。\n才疏政事由来拙，天远精诚未易交。\n三日祷祈才一雨，自知无处避讴嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陆倅贺雨","author":"王十朋","text":"目注云霓为国忧，何心肥马更轻裘。\n庶民愁恨旱无雨，三日滂沱农有秋。\n且喜上公容我请，不辞大白共君浮。\n人言太守无才术，端藉士龙监此州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏四月不雨守臣不职之罪也将有请于神雨忽大作陈贺州有诗赞喜次韵以酬 其一","author":"王十朋","text":"不是寻常喜雨诗，言存轨物类臧僖。\n相将归贺天朝雨，定有忠言结主知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏四月不雨守臣不职之罪也将有请于神雨忽大作陈贺州有诗赞喜次韵以酬 其二","author":"王十朋","text":"郡人方切望云霓，忽见高田水入低。\n正好归田饱黄犊，不须骑马听朝鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏四月不雨守臣不职之罪也将有请于神雨忽大作陈贺州有诗赞喜次韵以酬 其三","author":"王十朋","text":"贺州贺雨句如何，不减夔州梦得歌。\n更有一犁江上曲，它年传诵出金坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏四月不雨守臣不职之罪也将有请于神雨忽大作陈贺州有诗赞喜次韵以酬 其四","author":"王十朋","text":"政拙年年厌祷祈，心香一炷逐云飞。\n老农问我何良苦，薄有田园胡不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏四月不雨守臣不职之罪也将有请于神雨忽大作陈贺州有诗赞喜次韵以酬 其五","author":"王十朋","text":"刺桐抽叶张青盖，紫帽蒙霞丽锦笼。\n今岁家家定高廪，多苗宁复羡吴侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蒋教授喜雨","author":"王十朋","text":"我来遥自东瓯东，贤非朱邑乡守桐。\n半年为郡治亡状，四月不雨心忧农。\n水田龟拆秧已老，云霓望断天穹隆。\n少学春秋老欲用，区区愿请应上公。\n真人不待瓣香祷，紫帽已有微云蒙。\n沛然一雨四境足，眼见䆉稏青连空。\n皇天爱民恕守罪，有始其赐宁无终。\n既令地免晋国赤，亦不水似尧时洪。\n广文先生坐绛帐，忧国心与黄堂同。\n挥毫作诵继吉甫，开卷穆穆生清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"知宗游延福有诗见怀次韵以酬","author":"王十朋","text":"向来云榭倚阑干，兴已遥驰郭外山。\n风伯如嫌俗驾至，禅房疑为病夫关。\n铃斋倦卧眼界寂，诗社免陪心境闲。\n蜡屐何时破吾愿，与君舒啸翠微间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"提举延福祈风道中有作次韵","author":"王十朋","text":"雨初欲乞下俄沛，风不待祈来已薰。\n瑞气遥看腾紫帽，丰年行见割黄云。\n大商航海蹈万死，远物输官被八垠。\n赖有舶台贤使者，端能薄敛体吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中食火山荔枝","author":"王十朋","text":"前年夔州食荔支，同僚共赋新红诗。\n妃子名园世所贵，不似诗史堂前奇。\n去冬分符来南土，半月身行荔支圃。\n三州嘉木皆眼见，更阅君谟向来谱。\n临漳一种名火山，品虽云下熟则先。\n从今渐入荔佳境，陈江未擘先流涎。\n老病馀生怯嘉果，日啖那能三百颗。\n慇勤为破绛纱囊，心火惊添火山火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸公和诗再用前韵","author":"王十朋","text":"屏间观画颐频支，想像风味哦新诗。\n火山太早反遭骂，陈紫未显谁称奇。\n气禀南方君子土，不近长安帝王圃。\n安排名字知何人，误与牡丹同入谱。\n泉南老守思故山，荔熟我去谁后先。\n但愿丁香一株熟，添入药裹痊痰■。\n平生梦寐南州果，瘦腹如蝉消几颗。\n明年何处饤杯盘，雁荡山前月流火。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漳州石教授寄火山荔支","author":"王十朋","text":"炎方摘实走筠笼，千颗遥遥寄病翁。\n未啖吾州法石白，且尝邻郡火山红。\n搀先趁得杨卢雨，珍重来从芹藻宫。\n我欲细论香色味，一尊何日广文同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东湖小饮","author":"王十朋","text":"微凉散梅润，浓绿敷桐阴。\n送客出东郊，驾言事幽寻。\n湖光照我眼，荷香清我襟。\n平畴入远望，岁有其自今。\n牛眠种已毕，蛤吠苗初深。\n古亭怀二公，遥望罗千岑。\n邂逅得良友，欣然契予心。\n乔松喜客来，风枝出清音。\n手持荷叶杯，共对莲花斟。\n东湖异西湖，有诗不妨吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东湖","author":"王十朋","text":"二公亭插芰荷间，绿盖红妆四面环。\n若把西湖比西子，东湖自合比东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"爱松堂","author":"王十朋","text":"炎炎畏日爱浓阴，穆穆清风爱好音。\n不独爱松兼爱竹，此君亦有岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食瓜呈知宗","author":"王十朋","text":"荔子劳民疏伯游，蒲萄酿酒博凉州。\n何人传得东陵种，大胜家封万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题节推纳凉轩","author":"王十朋","text":"有客游莲幕，开轩更傍莲。\n披襟风未赋，递啸句先联。\n境净凉偏乏，心清暑自蠲。\n快哉谁与共，广厦集群仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"州宅即事","author":"王十朋","text":"泉南古州宅，草木有遗芳。\n鹰爪冬犹绿，阇提夜更香。\n佛桑朝暮异，荔子岁年长。\n惟有松并竹，青青似故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"修鹰爪花架","author":"王十朋","text":"有花藤蔓生，封植傍州宅。\n状类鸷禽爪，叶作翻风翮。\n酸分含笑香，黄带薝卜色。\n架倒吾为扶，清凉纳朝夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹰爪花","author":"王十朋","text":"谁把名鹰爪，天然状不殊。\n无心事搏击，中有鸟相呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长生草","author":"王十朋","text":"草有长生者，无根叶自抽。\n秦皇不知此，误向海山求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"榕木","author":"王十朋","text":"南国有乔木，老非梁栋材。\n清阴可以覆，亦足报栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安静堂","author":"王十朋","text":"前贤治迹尚堪寻，留得堂名直至今。\n若欲斯民尽安静，要须安静自家心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中和堂","author":"王十朋","text":"堂前老木几经春，阅遍泉南旧守臣。\n尽向中和堂上坐，中和为治有何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云榭","author":"王十朋","text":"山生取地榭侵云，土木多应役鬼神。\n好向危栏高著眼，闾阎无限困穷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二山亭","author":"王十朋","text":"连年行役厌间关，踏遍千山见二山。\n欲识泉南山面目，群山总在一亭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清暑堂","author":"王十朋","text":"九夏炎方气郁蒸，沉沉广厦有凉生。\n仁风未慰黎民意，何忍堂中暑独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贡院纳凉分韵得湖字","author":"王十朋","text":"突兀千间屋，清凉五月湖。\n人才此涂出，暑气坐中无。\n虎榜唐文杰，雄风楚大夫。\n相期游广厦，慷慨论唐虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]