[{"title":"寄酒与阳翟诸弟","author":"吕本中","text":"奔走黄尘小说归，诸郎坚坐各能诗。\n略无梦去寻消息，谩有书来道别离。\n但得阮公连月醉，不嫌王湛半生痴。\n遥知共饮北窗下，自胜乌衣全盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晋康逢师厚","author":"吕本中","text":"藤江合贺江，浮荡苍梧云。\n我如老饿鹤，忍饥啄蛮尘。\n二更客入户，月黑雨翻盆。\n坐久始惊省，两翁非昔人。\n一别二十年，家国忍复论。\n岂知半暗眼，再见忠宣孙。\n君负济世美，实识治乱根。\n宁同二三子，但粥父祖名。\n心岂燕丘壑，屡召终逡巡。\n新年愤忠极，决意去脩门。\n龙鬼亦妒贤，翻舟使回奔。\n呜呼天下事，敢笑不敢言。\n师尹实令弟，高义横乾坤。\n政坐才卓荦，亦使身奇屯。\n人说龚州居，胜事专江村。\n未赴结社约，长耿怀友心。\n君归兄弟语，况我应殷勤。\n二子岂隐者，中兴要甫申。\n勉哉赤松子，善事黄中君。\n我欲北渡岭，江西老耕耘。\n子房但强饭，勿道绮与园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初十日王震秀才家探梅","author":"吕本中","text":"不问主人聊一来，水亭风榭小徘徊。\n春风大似私南土，未腊江梅半欲开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王园观梅主人置酒莫归 其一","author":"吕本中","text":"临溪照影若自爱，犯雪看花宁怕寒。\n百绕蜂儿缘底事，痴心犹作蜜房看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王园观梅主人置酒莫归 其二","author":"吕本中","text":"日没未没雾索山，古寺松门欲上关。\n尚有香风泛衣袖，儿童知我探春还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭花光店是日立春","author":"吕本中","text":"采胜缯幡安在哉，客行巾帽只风埃。\n东西水畔冻全坼，南北枝头春已回。\n故国音书黄耳断，馀生光景白驹催。\n山村谁道全荒陋，也有畦蔬入馔来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清隐及欧园赏梅 其一","author":"吕本中","text":"亭边竹外影疏疏，恼客清香半有无。\n不共东君苦交涉，只缘冰雪作肌肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清隐及欧园赏梅 其二","author":"吕本中","text":"枮丛冻蘖两交加，中有仙人萼绿华。\n会挽一枝供越使，莫令三弄发胡笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清隐及欧园赏梅 其三","author":"吕本中","text":"向人一笑真粲者，出屋数枝殊瘦生。\n刚肠妙句两无语，始觉诸孙愧广平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酴醾 其一","author":"吕本中","text":"绝去人间浅俗香，染成天上羽衣黄。\n绿窗拟倩纤纤手，收拾春风入枕囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酴醾 其二","author":"吕本中","text":"掩冉攲垂千万条，始知天女是青腰。\n轻衫曾立花阴下，三日馀香尚不销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其一","author":"吕本中","text":"三年羁旅逢寒食，万里江山隔故园。\n坟墓荒凉谁拜扫，东风吹泪湿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其二","author":"吕本中","text":"淮南江北半胡兵，想见春风战血腥。\n无复良辰修祓禊，空将新火发兜零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其三","author":"吕本中","text":"野哭行歌满道边，纸灰飞处落乌鸢。\n墦间祭肉能多少，只恐齐人意缺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其四","author":"吕本中","text":"病夫只欲闭柴荆，客至从嗔不出迎。\n未恨家贫无历日，紫桐花发即清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其五","author":"吕本中","text":"松坞云窗睡足时，溪藤闲展试毛锥。\n薄才岂敢追能事，寒食江村合有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿嵩前","author":"吕本中","text":"火云如鹏骞，簸翮赴山谷。\n独含片雨归，故故喧涧竹。\n野亭桂空起，入夜鸟争宿。\n我行亦已殆，况此弛担仆。\n倒床不复呼，烂熳听自足。\n人生浪游世，世网未易触。\n好学还山云，终焉宿幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客说嵩顶松实甚佳","author":"吕本中","text":"飘飖山中女，绿毛以为衣。\n但食青松子，不死亦不饥。\n昼想此仙人，夜或梦见之。\n客云嵩高顶，长松乱纷披。\n拔地起霜干，盘空缺虬枝。\n惜无长臂人，挽此须与鬐。\n但闻云间子，时被天风吹。\n愧我一食身，何由揖仙姿。\n欲学餐松法，人间了无师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送苏龙图知明州 其一","author":"吕本中","text":"知君乡味忆吴馂，便逐轻鸥下急湍。\n更使烟云有佳思，莫驱鼓吹傍湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送苏龙图知明州 其二","author":"吕本中","text":"宇宙之间得几人，平生季子最相亲。\n一麾出守三千里，去觅风流贺季真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尘外亭","author":"吕本中","text":"宁饮山中泉，勿食城中米。\n尘埃苦着人，何翅虱与蚁。\n爬搔十指秃，败褐未易洗。\n缅怀佳公子，珠璧不受浼。\n藏身着幽处，阖户谢纨绮。\n君看罗曲旃，何似容燕几。\n不辜文字眼，未负钟鼎耳。\n长安游侠窟，未晚看参觜。\n纷纷万马蹄，门外自千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题晁以道新居","author":"吕本中","text":"小阮东来语太誇，为传新构甲千家。\n气冲雪野群山过，光转云空一水斜。\n闻道洗心求净观，不妨合掌读楞枷。\n个中富贵还君子，莫爱群奴日两衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"星月枕屏歌","author":"吕本中","text":"雪涵疏星月既望，老桧长松倚千丈。\n田夫渔父不爱惜，落向公家枕屏上。\n枕屏映研连春冰，主人中夜卷寒藤。\n诗成不写坐叹息，长松老桧无颜色。\n海陵掾曹来作歌，却忆洞庭秋水多。\n洞庭水多秋亦晚，如此枕屏星月何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"吕本中","text":"夭夭桃李花，春到已成蹊。\n主人不好事，居然作藩篱。\n容华坐消歇，芳心端为谁。\n风雨日衰谢，覆水难再期。\n物有幸不幸，难用一理推。\n不见浣溪女，嫁与陇头儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明如皋道中五首 其一","author":"吕本中","text":"万顷曾经一苇航，旧缨如可濯沧浪。\n簿书窘束尘埃里，犹见当时玉树郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明如皋道中五首 其二","author":"吕本中","text":"王李风华旧得名，颇容偏左去求盟。\n从来量比江河大，不取人间盆盎清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明如皋道中五首 其三","author":"吕本中","text":"不嫌众里衣冠古，自觉人前礼法疏。\n已似羲之弃官后，近逢安石赴京初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明如皋道中五首 其四","author":"吕本中","text":"醉别江南久未还，至今犹梦雨馀山。\n少留白发三千丈，胜取黄金十二镮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵尧明如皋道中五首 其五","author":"吕本中","text":"侯喜学诗新有声，坐中忽遇老弥明。\n故知麦饭与藜藿，不识虞卿醒酒鲭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别才仲","author":"吕本中","text":"忆子丱角时，单衣小襦褂。\n见我不能拜，笑语多自误。\n初看读孝经，旋即绝文字。\n先姑谓我言，尔曹颇相似。\n悠悠二十年，历历眼中事。\n江河坐乖隔，清□谩佳句。\n堂堂曾定州，许尔天下士。\n自尔忧患多，颇复慰漂寓。\n故人薄□肠，子犹披情素。\n胸次磈礧尽，皆是济世具。\n从来人中英，俗子眼中刺。\n子行多邅回，无与此曹遇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"臞庵","author":"吕本中","text":"伊洛富山水，家有五亩园。\n花竹绕瀍涧，不让桃花源。\n清时足真赏，户门开层轩。\n一朝胡尘暗，故家希复存。\n莽苍走万里，始及吴市门。\n庵庐据形胜，冰壶贮乾坤。\n亭榭着仍稳，不见斧凿痕。\n主人更超迈，云梦八九吞。\n植杖邀我坐，笑语清而温。\n坐令车马客，稍识山林尊。\n十年老朝市，渐见两目昏。\n求田与问舍，姑置不复论。\n但愿从我公，不使世谛诨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨","author":"吕本中","text":"吟魂不饮觉惺惺，那更宵眠得雨晴。\n遍地乱沾霜叶碎，随风斜上纸窗明。\n暗欣石罅添泉脉，几回檐牙认雪声。\n明日梅边曾有约，西郊泥泞未堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"暮雨","author":"吕本中","text":"暮燕翻雷天作云，一声归鸟万村昏。\n荒城寂寞无堪宿，月下支颐雨打门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谷隐堂","author":"吕本中","text":"汝州城南二十里，栖亩山前足山水。\n老人中开谷隐堂，草屋疏檐对山起。\n南横秀岭石官道，想像此堂容此老。\n堂前茂林浮春烟，堂后池溏多白莲。\n前池红莲开更早，正与茂林相对好。\n开轩看莲看不足，远望少室如碧玉。\n碧玉如屏掩此堂，老人与世已相忘。\n胡马扬尘不容驻，万里奔波失归路。\n客舟不顾生事窘，所至有堂名谷隐。\n大榜灰飞小榜存，至今长在对衡门。\n涧上丈人肯已冷，中原旧事空销魂。\n老人本是山中客，四海为家无住宅。\n家人清坐已忘贫，何曾更问堂宽窄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日涉园次韵五首 其三 丹桂轩","author":"罗愿","text":"丹枝近岁出深宫，合向严宸伴晚枫。\n珍重幽轩无俗物，月中根垡日边红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松","author":"吕本中","text":"一依风霜万木枯，岁寒惟见老松孤。\n秦皇不识清高操，强欲烦君作大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其一","author":"吕本中","text":"造物何繁敷，杂然呈万变。\n潜飞惬会心，显藏亦递见。\n人生事机巧，雕凿失性善。\n碌碌尘寰事，轮环走精电。\n萧散眄庭柯，商意集微霰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其二","author":"吕本中","text":"晴枝飐小鸟，啁啾振毛羽。\n凉飙堕寒花，静中有真趣。\n倚槛看浮云，随时成散聚。\n世变无常境，心定自安遇。\n棐几杂图书，幽事能毕具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其三","author":"吕本中","text":"朝拥群书坐，所乐常自足。\n圣贤重出处，理本无偏曲。\n志行道合尊，安贫未为辱。\n压架富卷帙，纵情无蹐局。\n穷达各有时，此意当勉勖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其四","author":"吕本中","text":"东园有乔木，翳翳凌霄汉。\n岁月变虬枝，雨露潫霜干。\n浓阴书屋□，伴我同昏旦。\n根株视百草，秋风已萎烂。\n良材际时用，未忍付樵爨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其五","author":"吕本中","text":"抱璞沦岩阿，失怀亦自宝。\n岂无用世心，遇合贵得道。\n连城重白珩，声价先倾倒。\n瑕瑜混沙砾，莫讶荆山老。\n会当游勋华，元圭赞熙皞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其六","author":"吕本中","text":"日奭久不作，依然三代民。\n一善孚万端，不难风俗淳。\n上士贵抱负，修己在立身。\n进退各有据，宇宙任屈伸。\n愿言励厥修，学以答君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其七","author":"吕本中","text":"门外一渠水，清光自泠泠。\n濯缨偕素侣，须发无遁形。\n春风起层波，鹍化失南溟。\n縠纹乱星斗，泥沙混窅冥。\n澄清当有志，天地还虚灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其八","author":"吕本中","text":"智者尚明察，不为物理宥。\n吾儒任学术，精力事研究。\n至人邈难继，得亦瞠乎后。\n庸盲终溟漠，全天亦自厚。\n大化无殊途，何事朴与秀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其九","author":"吕本中","text":"寒气生户牖，草木变轻黄。\n南郊询秋畦，丰稔荐涤场。\n八口娱妻孥，温饱乐岁康。\n箪瓢亦自得，忧乐各两忘。\n所以常忻忻，安问无储粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋窗遣兴 其十","author":"吕本中","text":"我生事柔翰，中怀异好尚。\n潇洒逼嵇阮，功成薄瑜亮。\n白衣本山人，置身岂疏放。\n途逢醉尉呵，未且对侯相。\n亭亭千仞松，当破万里浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱逊叔泛舟虹桥","author":"吕本中","text":"半篙春涨绿平溪，二月江城草色齐。\n舟比蜉蝣千顷外，□同斥鴳一枝栖。\n野桥柳线斜风软，曲槛花光夕照低。\n却讶探骊人不至，清樽画航倩分题。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春暮渡江 其一","author":"吕本中","text":"霁色春江上，沧茫一棹通。\n水随天地阔，山入画图工。\n薄霭凝新碧，轻风随乱红。\n片帆迎返照，叠嶂路疑穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春暮渡江 其二","author":"吕本中","text":"间移书画舫，一叶足浮家。\n潮涨添春雨，山明放野花。\n绕烟依树断，飞鸟受风斜。\n翻讶江潭客，尘容改岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荷珠","author":"吕本中","text":"谁倩亭亭着意擎，风中零乱月中明。\n浑无定处光偏润，正值圆时影最清。\n曲槛落江攲一串，横塘点碧梦三更。\n绝怜荡漾波心里，添得连宵细雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"吕本中","text":"槿篱临古涧，苍然来书幄。\n垂钓涧鱼清，衔杯山醪浊。\n三径草既深，一庭鸟剥啄。\n绳床竹翠阴，石几苔藓驳。\n游方庄老书，抱琴陶家乐。\n山水洗尘嚣，百年好一觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家漫兴 其一","author":"吕本中","text":"巷陌交道近，茅檐接复疏。\n岸榆容系艇，篱竹许封蔬。\n地僻常远市，檐卑牧鸡豕。\n绕村杨柳花，沿溪芦荻水。\n野老随分过，商榷桑与梓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家漫兴 其二","author":"吕本中","text":"参星瞻谷日，水影量元夕。\n旱潦种早晚，老农从定策。\n催耕鸣鸠起，护竿乌鹊去。\n秋成不餍怀，暑雨不告劳。\n岁时社酒会，扶醉有年高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游白省寺看画壁","author":"吕本中","text":"古径接长松，旷观碧殿逢。\n巉岩山巘立，浩渺海涛冲。\n尽啖寰中胜，尤瞻天外峰。\n世尘何日埽，五岳遍扶筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋游埭山游新庵中路却过头陀雪野","author":"吕本中","text":"秋云历乱日光微，山色萧疏木叶飞。\n旅梦空遗鹤唳恨，羁情思听牧吟归。\n荒凉旧院深溪远，解后江湖逸士稀。\n却作头陀谈越事，不堪楚客泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪栖贤山读书","author":"吕本中","text":"迟日欣欣山景妍，携琴吟咏翠微前。\n行厨烧笋粉铺色，高阁看梅雪白天。\n午罢抛书曳短杖，雨来拥卷听幽泉。\n一春洒落韶光足，他日芳怀得复然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴 其一","author":"吕本中","text":"平畴一望黍禾稀，远树峰峦天外微。\n水国虾留当鲙鲊，乡园桑尽典秋衣。\n连翩羽檄荒林下，绎络徵书塞上飞。\n可是三分才溢额，那知鸿雁野号归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴 其二","author":"吕本中","text":"西郊一夕叶初稀，原野荒凉草具腓。\n荷锸耕夫闲箬笠，从戎火伴急军机。\n闺中泪雨征衫剪，塞外惊风夜柝依。\n莫是羽毛零落尽，不堪燕燕颉颃飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴 其三","author":"吕本中","text":"浸满溪烟枫叶纷，嵚崎苍弁入青云。\n捲堂宋室由来事，逐客秦都曾有文。\n兔苑圃田间可耨，豹林笔研笑须焚。\n莫嘲寂寞秋风士，于越当年君子军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴 其四","author":"吕本中","text":"清秋风景昼平分，江外波涛惊夕曛。\n谁误唐家门架史，却来蓬户市租文。\n树禽惋惜一枝借，野兔何心三窟闻。\n只恐东南马力尽，祇应契伴驻寒云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日康山东归","author":"吕本中","text":"整楫凌晨问所之，乡园迢递水东迟。\n归舟但信溪红蓼，别梦还牵山翠眉。\n安稳秋风三径竹，踌躇行李一囊诗。\n解维犹有留题处，瓜葛萦怀不自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋 其一","author":"吕本中","text":"雨云初霁放晴空，乍捲珠帘望月宫。\n夜静□篁何处发，玉楼犹记月明中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋 其二","author":"吕本中","text":"泱泱秋水荻芦轻，徙倚楼头待月明。\n红烛烧残白堕醒，秋风飒飒独关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海上篇","author":"吕本中","text":"天风万里起，海水高十寻。\n中有都人士，拔剑拯陆沉。\n素甲三十里，朱縢万千垒。\n誓身殉家国，援抱常切齿。\n东连海上兵，天挺三世英。\n艨艟山岳高，军储沧海倾。\n纵横长江动，军威千里空。\n拊手功可立，名姝何足惜。\n痛饮伫黄龙，酣醉实狼籍。\n一朝肘腋变，惊雷还自敌。\n鸟兽散何为，岛上复卖国。\n叹息复叹息，燕市文山即。\n海外多君子，至今长恨水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]