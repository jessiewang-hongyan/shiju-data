[{"title":"岁晚","author":"张侃","text":"水敛风生壑，云深雪满天。\n寒光怜袖薄，瑞色向梅妍。\n浅酌生春酒，閒赓馈岁篇。\n吹灯看家信，独步到窗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拙轩偶书三首 其一","author":"张侃","text":"归来开一室，复以拙为名。\n道在何妨小，身閒不用荣。\n柳丝愁断续，花靥笑轻盈。\n只此观天运，逢时物自成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拙轩偶书三首 其二","author":"张侃","text":"廊深人罕到，益友两三人。\n得意文章妙，相忘情味真。\n蜂来窥砚水，燕去润香芹。\n如此逍遥过，胸中无点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拙轩偶书三首 其三","author":"张侃","text":"侵晨门外立，山色已浮春。\n斫竹流溪水，提篮择细鳞。\n柳浓将作絮，梅小未生仁。\n自拆红泥酒，歌呼到北邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"足轩","author":"张侃","text":"人爵何须恋，翛然郭外居。\n随缘常二满，散帙富三馀。\n劖石梅花赋，堆庭柿叶书。\n呼儿邀客至，反棹或巾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"定轩","author":"张侃","text":"门前流水竞，洗尽市尘交。\n秉我中心正，从渠异说譊。\n向来多肘柳，近已去心茅。\n隐几观天地，晨曦动翠梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月初五日自白门之丹阳宿于驿亭中是夕风雪大作","author":"张侃","text":"辗转耿不寐，青灯遥夜阑。\n关河千里远，风雪一窗寒。\n旅食腰围减，征鞍髀肉酸。\n想知双鹤发，朝夕望平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感昔","author":"张侃","text":"先君年壮日，邂逅郑当时。\n把酒对今月，弹琴论古诗。\n眼前多俗韵，徽外少人知。\n除却瑶山老，无繇访断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月尾雪","author":"张侃","text":"今岁春来晚，晴寒比旧添。\n云深天欲雪，风定瓦堆盐。\n幽艳迷琼屑，前山隐翠尖。\n诗人疑是瑞，就唤野人占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观芗林堂帖","author":"张侃","text":"功名落落俟天时，险阻艰难定汉基。\n老子挂冠从早岁，诸公颂德尽良规。\n既知中夏驰清誉，合去芗林赋好诗。\n事到百年方始定，晴窗细与拂乌丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新晴","author":"张侃","text":"披披云阵从东去，薄薄晨光向北开。\n花态最娇依宿霭，柳枝无力辊香埃。\n心清更觉虚檐远，事少缘无俗客来。\n野鸟互吟閒自在，三三两两啄莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"张侃","text":"青灯点粟伴窗幽，检尽诗篇倦即休。\n万事如云同舞燕，此心似水羡飞鸥。\n客来不过谈閒事，我壮须当办小舟。\n雨杂风声欺客枕，清眠无梦两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久雨","author":"张侃","text":"今年梅雨已淋漓，梅尽多时雨意痴。\n漫说池荷能润色，岂知岸柳亦颦眉。\n一天黯黮云阴殢，六月清凉客子宜。\n兀坐小楼香半线，纷纭万事只心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁湖夜望","author":"张侃","text":"秋带凉风叶互鸣，风随潮汐候时生。\n导源甚远纹微起，乘势初来花转轻。\n白鹭几枝閒可画，晴山数点晓犹明。\n偶来又作诗中计，久矣难成五字城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和中秋韵","author":"张侃","text":"月魄诗魂两斗清，却嫌歌管揭危亭。\n遥知山鬼形难遁，谁洗天公眼暂明。\n物外风光何皛皛，人间爝火谩荧荧。\n酒狂径欲骑鲸去，一拂鸿蒙散窅冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉寄曾舜卿二首 其一","author":"张侃","text":"我与懒翁非浅交，向来寓止在西郊。\n绕庭草际绿浮色，满槛花梢红解苞。\n只要同心胜胶漆，岂缘一字倩推敲。\n四年会面休深叹，辛苦扬雄述解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉寄曾舜卿二首 其二","author":"张侃","text":"一幅吴笺秋满天，几回书字欠人传。\n知君性懒存吾道，顾我官閒只旧年。\n诗句鍊成犹未稳，酒杯空泛未曾传。\n庭前柏子西来意，近日能明若个禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曾兄","author":"张侃","text":"富贵功名莫问渠，閒中气味复何如。\n年来格外添新句，夜静灯前理旧书。\n用拙不妨存我性，得时未免驾高车。\n君家文献人难比，会见芳名上玉除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次王子元韵二首 其一","author":"张侃","text":"眼看珠玉混泥涂，奇货何人解与居。\n卖剑买牛知已晚，坏车杀马计何疏。\n卑飞莫辨鸡群鹤，高义难兼熊掌鱼。\n却羡临川王介甫，爱君独上万言书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次王子元韵二首 其二","author":"张侃","text":"皮骨三年走道涂，移文良负北山居。\n甘贫我固轻诸阮，勇退吾犹耻二疏。\n好著短衣看射虎，休弹长剑为无鱼。\n人生识字多忧患，饱睡从今莫读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用秦少游韵二首 其一","author":"张侃","text":"春风花草绣林皋，索莫谁怜止酒陶。\n晚学文章真末技，早知州县亦徒劳。\n年光可叹石中火，人事休磨笑里刀。\n分外更须贪富贵，如求兔角与龟毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用秦少游韵二首 其二","author":"张侃","text":"未工射雉怯如皋，欲挂衣冠慕老陶。\n莫为功名多戚戚，须知身世两劳劳。\n求鱼切戒空缘木，买犊不妨先卖刀。\n未有田园作归计，年来留滞感潘毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏用东坡先生韵二首 其一","author":"张侃","text":"冠世文章李翰林，掀天功业汉淮阴。\n抹靴捧砚荣虽甚，受钺登坛眷益深。\n远窜夜郎挥老泪，生擒云梦负初心。\n穷泉二子应追恨，不解君前早脱簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏用东坡先生韵二首 其二","author":"张侃","text":"倦看冠盖闹如林，梦想扁舟破晚阴。\n步月南楼情不浅，卧风北牖味殊深。\n朱旂黄纸非吾事，木板青衫负壮心。\n游宦半生成底事，鬓丝零落不胜簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"豚犬夜诵东坡赠王子直诗坚索次韵余率然成章可笑深不自量也","author":"张侃","text":"年来典尽鹔鹴裘，远宦深惭马少游。\n痛哭恨无裨国论，偷安终不为身谋。\n谁怜饥虎空摇尾，却羡寒龟暗缩头。\n但得渭川千亩竹，也胜霜鬓取封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田元长和烟字韵诗见寄复用前韵","author":"张侃","text":"几年无梦到凌烟，身似春蚕已再眠。\n寡合荆人和白雪，独醒蜀道上青天。\n渔樵好去任争席，富贵傥来羞执鞭。\n见说高真足官府，不妨长作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用文伯起韵","author":"张侃","text":"老人痴钝性可憎，微子谁与为友朋。\n久废未容收颡马，一呼宁复责饥鹰。\n无缘下榻留徐孺，好去登门访李膺。\n吾道不行吾已矣，短桴浮海要同乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和曾舜卿秋日偶成","author":"张侃","text":"久无名酒共君倾，静对溪山悦我情。\n雨沁荷花多退色，风穿梧叶强成声。\n乾坤纳纳从来大，岁月堂堂未用惊。\n甚欲著书传后世，只愁议论太平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楼源清叔旧有诗云树冷鸦啼月天寒雁带云曾舜卿足成四韵又有咏雪诗云来从天外无非雨散在人间尽是花亦佳句也清叔死已数月因用后二句为诗吊之","author":"张侃","text":"见说楼君用志佳，曾吟雪句被人誇。\n来从天外无非雨，散在人间尽是花。\n偶到铜陵寻旧友，归由宣郡弃生涯。\n碧云暮合愁偏聚，孤冢累累日易斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甬东","author":"张侃","text":"侵晨风雨闇城楼，渺渺蒲帆海尽头。\n远景暂烦双目送，清游不负此生谋。\n半杯绿蚁冲寒色，几个白鸥分客愁。\n相近梅开迟雪舞，肯容兴尽剡溪舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池边","author":"张侃","text":"簿书才了听蜂衙，閒到池边景渐佳。\n云亦有心时散影，风都无力晚生花。\n劳神空觅三年艾，妄想休乘八月槎。\n睡思全清还解否，歙瓶新瀹建溪茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书考 其一","author":"张侃","text":"二年薄宦在金台，墙角双扉向晚开。\n罕有金貂来换酒，且看野马共浮埃。\n已书下考甘平进，久律吾身愧不才。\n却喜清贫如昨日，知心相识自然来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书考 其二","author":"张侃","text":"负丞虞水恰年馀，谁信官居似野居。\n乍起柳风清午枕，久因梅雨理残书。\n眼前毁誉何须较，酒里功名定不虚。\n只把廉勤替疏拙，翻嫌苦苦学悬鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红梅","author":"张侃","text":"天然标致出群品，绿叶青枝说太狂。\n卯酒醺酣红玉软，春风触拨瑞龙香。\n清臞尚馀山泽相，淡薄强随时世妆。\n更道北人初不识，杏花应不敢承当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春时","author":"张侃","text":"两日閒为汗漫游，溪边长是唤扁舟。\n杯盘草草同真率，笑语悠悠得细酬。\n别墅桥攲泥没膝，东园亭小雨沾头。\n不知桃李都开遍，更趁残花一醉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨","author":"张侃","text":"一片云飞雨趁来，常年此候捷如雷。\n满天尽黑都吹散，俄顷还明又复回。\n准拟却无真失望，等閒易有竟难猜。\n化工若念农辛苦，早赐倾盆亦快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巧夕前一日雨","author":"张侃","text":"天时人事逐番新，转盼初秋感慨频。\n月傍银河移扇影，天留丝雨洗香尘。\n民间但欲逢丰岁，酒里何妨换好春。\n一笑且随吾意适，燕支菱芡伴盘珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书","author":"张侃","text":"事业从教下泷舠，一年窃禄在江皋。\n腥污砧几憎蝇赋，爱护文书却鼠刀。\n风约浮萍云叠岫，日藏老桧雨翻涛。\n深惭无补公家事，只愿年丰弓载櫜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻方孚若寺丞讣二首 其一","author":"张侃","text":"清时补外驾朱轓，德政碑成达帝阍。\n都把功名垂竹帛，尽留官职付儿孙。\n生前花药千株在，身后词章几卷存。\n履道宅边云黯黯，知谁挂剑酹清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻方孚若寺丞讣二首 其二","author":"张侃","text":"忆昨家君出帅时，惟公英气少人知。\n要除五事心常在，费尽千言气不卑。\n渺渺淮波纷棹楫，晶晶霜日照旌旗。\n论功未尽还知否，应有名贤为立碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"收潘廷亨逵讯","author":"张侃","text":"旧年浙右水连天，闻说闽中水亦然。\n官里劝分虽遍及，民间悭籴为无钱。\n大风拔木扬尘土，细雨打花空媚妍。\n甲子一晴差可喜，农家只愿屡丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题萧照渔樵对语图","author":"张侃","text":"世人大半爱渔樵，不道渔樵心志凋。\n漫钓溪鱼临月夕，每沽村酒怕霜朝。\n檀栾男女衣蓝缕，澹泊生涯舟荡摇。\n偷得片时相对语，从头至尾尽无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒中忆曾舜卿知丞","author":"张侃","text":"官舍如舟近古河，隔河老木尚新峨。\n森罗星象萤分度，经纬水纹鱼掷梭。\n月满秋容随处好，风含凉意向人多。\n香蒲泉石供清玩，遥忆骚翁在涧阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿等慈僧房","author":"张侃","text":"小小禅房若个宽，氎巾楮帐护幽閒。\n贪看天外云千变，忘数檐前竹几竿。\n老衲咒经祈雨切，臞翁煮粥当晨餐。\n早知一念能持静，不学槐安蚁走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姑恶","author":"张侃","text":"一双姑恶屋边啼，飞入垂杨伴夕晖。\n不悟形骸非昔日，但思怨恨没休期。\n妇闻懒语犹翻悔，汝得佳名免此讥。\n事事直须存分义，从今缄口莫相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬晚","author":"张侃","text":"冬晴日暖如春天，墨云忽过雨生寒。\n定飞柳絮呈农瑞，未放梅花到酒樽。\n历尾无多更旧岁，笔端不韵祇陈言。\n须臾刮地风声壮，吹折南墙老竹根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬后书事","author":"张侃","text":"兀坐茅檐意自閒，哦诗因得数苔斑。\n一番雨过归寒水，数片云浮叠晚山。\n近日阴晴多不定，自来冷暖不相关。\n春深泛棹清溪上，稳钓渔村三两湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天机","author":"张侃","text":"汎观物理任天机，莫泥春残事遽非。\n蝶粉莺衣阴处泊，燕泥鸥雪雨中归。\n装成閒景真堪玩，写入清吟细解围。\n一榻凉风清午暑，拙翁睡起理絺衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同乡人别朱希文察判于咏春亭","author":"张侃","text":"今春醵饮咏春亭，水阔山遥眼界清。\n前度来时多值雨，今番到此却逢晴。\n蚕方三幼餐乾叶，燕喜双飞泊短楹。\n小别诸君休作恶，阳关四叠不须成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家园二首 其一","author":"张侃","text":"当年迂叟圃初成，野草閒花不记名。\n康节巾车临小径，东坡诗板照高楹。\n久知气象归前辈，拟学规模愧后生。\n惟有至公能格物，莫将险躁起心兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家园二首 其二","author":"张侃","text":"堪笑吾家五亩园，新添石岸筑云轩。\n眼看流水清无底，面揖群山翠欲奔。\n拂拂好风凉入座，娟娟明月影侵门。\n弟兄岁晚团栾处，自摘青蔬荐酒尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵韦中实雨闷","author":"张侃","text":"与世相违愿不才，春残花底尚衔杯。\n诗从碧雾愁边得，门向青山好处开。\n东里沈君投檄去，西邻韦叟趁閒来。\n喜无俗驾知予懒，坐看庭阴閟古槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"张侃","text":"前朝晴暖昨朝寒，细雨催花声不閒。\n处处闭门扫蚕蚁，家家垂柳隐绵蛮。\n东湾泛艇看人渡，北埭扶筇向晚还。\n惟有群山怕陈迹，轻烟冉冉薄螺鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虚庭","author":"张侃","text":"虚庭幽阒日阴移，旋拂藤床近小池。\n云自悠扬峰叠叠，风常和暖日漪漪。\n青衫漫仕安愚分，白酒初篘满屈卮。\n竹外流萤三两个，微光犹足映书帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西村","author":"张侃","text":"篮舆轧轧过西村，小麦青青雨露恩。\n山色无穷开远近，民家守分度昕昏。\n僧精持课归林下，客自携尊醉竹根。\n每日尘氛牵百念，要须结屋浸溪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南村","author":"张侃","text":"郁李花开春渐残，海棠犹自映杯柈。\n燕随风舞迎人暖，鸠唤雨来连夜寒。\n两水中分清可烛，群山环揖秀堪餐。\n儿童成队逢寒食，纸剪飞鸢贴雾端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起","author":"张侃","text":"秋深雨意转连绵，声到枯荷清未眠。\n久悟是非姑掩卷，且看童稚互摊钱。\n园蔬土润青堪馔，径竹行疏翠可怜。\n剩喜病夫今已健，碧腴膏莫问人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"象山住持僧于修求诗戏题五十六字","author":"张侃","text":"的知前圣定曾来，山脉深长景渐开。\n霜干都无新气象，风幡不染旧尘埃。\n渔樵虽过何尝问，父老相传莫浪猜。\n惭愧修公坚有请，依前题作小天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"催雪次韵韦中实","author":"张侃","text":"海隐方搜催雪诗，韦郎落笔补新辞。\n云边花舞琼千点，座上风流玉一枝。\n如许寒光宜应瑞，不胜幻色又添奇。\n政须瀹茗清灵府，尽把文章润色之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪上","author":"张侃","text":"水痕依绿四无边，雨脚垂檐细更妍。\n杨柳不遮愁处眼，牡丹犹倚醉时肩。\n纷纷灯火疑星灿，汩汩声名类蚁旋。\n閒凭蓬窗仍感旧，开箱重为整诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题剡溪图","author":"张侃","text":"欲识诗清处，须来天尽头。\n可人一溪雪，催我上扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别","author":"张侃","text":"野树参差绿，山花零乱红。\n夕阳一樽酒，聊与故人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中","author":"张侃","text":"寒山草木疏，苍翠因雨湿。\n日暮来不来，前溪借蓑笠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花珠二绝 其一","author":"张侃","text":"雨细成珠琲，纷纷入绿花。\n绿花无不湿，倾处又成波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花珠二绝 其二","author":"张侃","text":"阶远滴成声，荷深圆又碎。\n风动水银收，亭亭开翡翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"智果院","author":"张侃","text":"前辈经行处，壁间题小诗。\n梅花还好否，要见出尘姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]