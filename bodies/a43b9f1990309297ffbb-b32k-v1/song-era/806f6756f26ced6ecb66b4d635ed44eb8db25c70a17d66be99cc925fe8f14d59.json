efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅倅梅岩之什 其一","author":"陈宓","text":"云间老干几千年，清婉仍推百卉先。\n铁石心肠能妙赋，广平端似此花然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅倅梅岩之什 其三","author":"陈宓","text":"看花长是盛时来，飞雪从渠到玉杯。\n天惜国香尘土涴，故应偏向石间开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅倅梅岩之什 其二","author":"陈宓","text":"照雪凌霜夹径开，谁教千树昔人栽。\n要将金鼎和羹事，尽付君家岩上梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅倅梅岩之什 三瀑","author":"陈宓","text":"银河有派九霄来，翻手为霖费一杯。\n风雨时闻桥下急，烟云元自晓天开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅倅梅岩之什 梅开","author":"陈宓","text":"人间飞叶送残年，篱落逢春此地先。\n虽有柴门无锁钥，唐时竹洞岂其然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅倅梅岩之什 清浅","author":"陈宓","text":"方池凿石似天开，谁把霜英傍水栽。\n月白波清无觅处，祇知疏影是寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和喻景山","author":"陈宓","text":"一榻无尘便觉凉，半生场屋鬓将黄。\n而今已办还山计，对卷烧香爱日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘舍人","author":"陈宓","text":"不能百里马牛风，千日相思一日逢。\n四月仙舟发漳水，恍然笑语在芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岭上见梅","author":"陈宓","text":"桃溪蜂蝶醉红裙，度岭冰姿尚卧云。\n不独山川限闽浙，由来天意亦区分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建阳道","author":"陈宓","text":"五月平畴不得犁，青秧老处坼于龟。\n乾坤惠爱无遗物，仰乳婴儿可使饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往溪源祈雨赓李司法韵 其一","author":"陈宓","text":"欲见高田翻䆉稏，不辞廿里陟崎岖。\n早禾已失三之一，便雨还能救得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往溪源祈雨赓李司法韵 其二","author":"陈宓","text":"一春雨脉发清泉，何以平畴旱欲然。\n太守自惭无善政，铃斋朝夕谩祈天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承刘学录示三山佳咏兼欲下旬仙鲤湖宿约以诗谢之 其三","author":"陈宓","text":"秋声又向耳边鸣，转眼平头六十人。\n最是读书难久坐，不甘空负百年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承刘学录示三山佳咏兼欲下旬仙鲤湖宿约以诗谢之 其二","author":"陈宓","text":"六年作意观仙鲤，未得清闲自在身。\n近日孙归娱膝下，拟拚三日奉高人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承刘学录示三山佳咏兼欲下旬仙鲤湖宿约以诗谢之 其一","author":"陈宓","text":"诵君盈轴三山咏，唤起前回二纪游。\n老我无因重一到，时将佳句洗昏眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承刘学录示三山佳咏兼欲下旬仙鲤湖宿约以诗谢之 其四","author":"陈宓","text":"藤床竹簟称羸身，独卧空斋绝点尘。\n更有池台堪却暑，一生清苦愧先人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承同安宰惠朱文公祠堂记辄以小诗为谢","author":"陈宓","text":"紫阳仙伯昔曾来，陈迹何人恋碧苔。\n为爱同安毛令尹，恩勤祠宇奉尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放生池产双莲 其一","author":"陈宓","text":"不作风流时样妆，月明宫殿舞霓裳。\n须知并立慇勤意，为祝吾皇圣寿长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放生池产双莲 其二","author":"陈宓","text":"年来仙实两呈祥，衮衮公侯讵可量。\n劳力更宜勤积善，天公元自爱词章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试潘衡墨","author":"陈宓","text":"胶煤鸾麝号潘衡，老剂尤令举世惊。\n点漆未能绳纯黑，令人字字挟霜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"陈宓","text":"滴滴鸣乾叶，萧萧过短篱。\n山房攲枕夜，听尽去来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨晴见山","author":"陈宓","text":"经旬不见嶙峋面，雨施云行到九州。\n春政已成无一事，却扶红日翠峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南安观社会","author":"陈宓","text":"山蔽晴空望自遥，树开小道紫骝骄。\n沿溪飞盖传清荫，四野欢声拥海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园","author":"陈宓","text":"水气胜风凉，星辉当月光。\n渔舟在何处，欸乃一声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园杂咏 松亭","author":"陈宓","text":"天生栋梁质，挺挺自幽伦。\n斧斤浑不施，绕柱起龙鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园杂咏 壶中日月","author":"陈宓","text":"观书友古人，不羡胡公仙。\n新功坐有得，寸阴长如年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园杂咏 清风亭","author":"陈宓","text":"薰炉驱俗氛，茗椀破尘虑。\n披襟六月凉，乘此欲归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康郡圃","author":"陈宓","text":"三沼流通作一家，清风偏趁夕阳斜。\n我来退食知怀愧，敢对波心莲子花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康食芡梨","author":"陈宓","text":"吴头楚尾将三载，芡觜梨腮又一秋。\n岂为鲈鱼觅归去，在家饮水百无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日到小园 其一","author":"陈宓","text":"屹立虚亭跨野塘，萧萧爽爽似潇湘。\n从教密种千竿竹，不蔽山光与水光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日到小园 其二","author":"陈宓","text":"东郊无地不苍苍，日气融和自有香。\n最是游人行乐处，不寒不暖昼偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春半桃李盛开","author":"陈宓","text":"缟裙练帨映丹霞，默默无言不自誇。\n陌上行人重回首，一年春事数朝花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暮","author":"陈宓","text":"春暮见花空有恨，病馀怯酒谩重温。\n紫骝踏尽垂杨影，可笑书生独掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日纳凉","author":"陈宓","text":"艳艳银河冷欲流，纤纤新月皎于眸。\n天街已觉清无暑，时有飞萤点缀秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜四鼓玩月 其二","author":"陈宓","text":"琅玕衣袂竹方床，热恼肝脾顿得凉。\n谁送苕溪来枕畔，轻裘短棹水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜四鼓玩月 其一","author":"陈宓","text":"露气盘空月堕烟，开轩移榻卧檐前。\n近来不虑消磨尽，空洞胸怀但贮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荔子 其二","author":"陈宓","text":"天垂甘露绛纱囊，要作南方一味凉。\n解□世间烦热恼，华峰有藕未能强。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴官安溪回与柯东海同宿闲吟","author":"陈宓","text":"道逢酒舍定迟回，无奈诗篇费剪裁。\n忽得好风还自喜，那知细雨隔溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵君惟谊清文介行坚苦笃实远来见访以救科举弊为说可无一语言谢 其一","author":"陈宓","text":"菜根惯咬著芒鞋，便是津梁一世材。\n六月雨行缘底事，一身不惜惜人才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵君惟谊清文介行坚苦笃实远来见访以救科举弊为说可无一语言谢 其二","author":"陈宓","text":"我把尊贤榜旧堂，怀人忽至喜如狂。\n缘何不肯留城府，虚著新成八尺床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘学录之建阳 其一","author":"陈宓","text":"马蹄千里踏春风，为爱河阳制锦工。\n首重儒宗新像设，不妨特地拜文公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘学录之建阳 其二","author":"陈宓","text":"宝剑韬藏久未伸，天生南浦一文人。\n好将玉匣呈岩电，洗出寒光万丈新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送怀安林知丞之官仍谢佳句 其三","author":"陈宓","text":"剑津初筮著能名，大府今看佐属城。\n愧我赠行无好语，祇将戒惧与明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送怀安林知丞之官仍谢佳句 其二","author":"陈宓","text":"读书岂但资闻见，穷理方能识重轻。\n孔孟格言如日月，更须师友与详评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送怀安林知丞之官仍谢佳句 其一","author":"陈宓","text":"艾轩门第多诸父，尚想高斋讲诵时。\n谁道风流今已泯，亲篇三复起予诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送抚州李兄武伯归乡 其二","author":"陈宓","text":"我恨逢师较已迟，羡君早岁独先知。\n归时剩把遗书读，莫道□峰永别离。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送抚州李兄武伯归乡 其一","author":"陈宓","text":"少年文学已精深，更向周程一派寻。\n千里求师宁惮远，殷勤要识圣贤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林知丞赴石城任 其二","author":"陈宓","text":"赣上贫民最可怜，唯凭令佐予安全。\n正人况值为侯牧，抚字催科审后先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林知丞赴石城任 其一","author":"陈宓","text":"往时吾里有师儒，受业穷年邹鲁如。\n今日喜君求益友，萤窗共究圣贤书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵司直赴常德倅 其二","author":"陈宓","text":"当年好礼一河间，今日躬行倍誉难。\n三百威仪皆曲中，胸中冰雪照人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵司直赴常德倅 其一","author":"陈宓","text":"武陵佳处是桃源，谬说伊谁为探原。\n会得桃花流水意，归来休向俗人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九前一日刘学录以诗招潘杨二丈登高二丈辞之刘以诗见寄仍和之","author":"陈宓","text":"一秋好处黄叶节，自昔名言不浪传。\n八日登高胜九日，今年不饮便明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻延平水沴 其三","author":"陈宓","text":"我是延平旧史君，忍闻水沴欲销魂。\n人言辛酉溪流涨，更减今年丈二痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]