[{"title":"效孟郊体七首 其二","author":"谢翱","text":"移参窗北地，经岁日不至。\n悠悠荒郊云，背植足阴气。\n新雨养陈根，乃复佐药饵。\n天涯葵藿心，怜尔独种参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效孟郊体七首 其五","author":"谢翱","text":"越禽惜羽毛，不向恶木栖。\n木奴重踰淮，爱尔巢其枝。\n巢枝不食实，中有二老棋。\n乳子月明中，梦绕东南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁如意","author":"谢翱","text":"仙客五六人，月下斗婆娑。\n散影若云雾，遗音杳江河。\n其一起楚舞，一起作楚歌。\n双执铁如意，击碎珊瑚柯。\n一人夺执之，睨者一人过。\n更舞又一人，相向屡傞傞。\n一人独抚掌，身挂青薜萝。\n夜长天籁绝，宛转愁奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避暑池上拟古","author":"谢翱","text":"游子渺天末，晨光东南驰。\n良时不易晤，胡为徒来兹。\n丛柏结夏塔，轻蒲生夕飔。\n空有齐纨扇，团团手中持。\n持此欲永久，但感颜发衰。\n爱尔云中鸟，浴彼道上池。\n馀翎委弱藻，飞去犹沦漪。\n极目送不返，将以穷所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避暑城西观吴道子画老君像","author":"谢翱","text":"湿烟挂龙天海头，角城溽暑如炎州。\n白氛翳景失楼阁，蓬莱缥缈不可求。\n解衣挥麈子城下，地涌青莲邻古社。\n卷帘看画人犹龙，矫首见龙还见画。\n碧幢发雪垂过耳，弄笔者谁吴氏子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芭蕉雨","author":"谢翱","text":"吴楚灯前侣，芭蕉海上身。\n凉宵知过雨，病叶与羁人。\n白屋愁看晓，沧洲宿语贫。\n西南多苦竹，应与越禽邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆少年 寒食","author":"谢懋","text":"池塘绿遍，王孙芳草，依依斜日。\n游丝卷晴昼，系东风无力。\n蝶趁幽香蜂酿蜜。\n秋千外、卧红堆碧。\n心情费消遣，更梨花寒食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风入松","author":"谢懋","text":"老年长忆少年狂。\n宿粉栖香。\n自怜独得东君意，有三年、窥宋东墙。\n笑无落花红影，醉眠芳草斜阳。\n事随春梦去悠扬。\n休去思量。\n近来眼底无姚魏，有谁更、管领年芳。\n换得河阳衰鬓，一帘烟雨梅黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风流子 行乐","author":"谢懋","text":"少年多行乐，方豪健、何处不嬉游。\n记情逐艳波，暖香斜径，醉摇鞭影，扑絮青楼。\n难忘是，笑歌偏婉娩，乡号得温柔。\n娇雨娱云，旋宽衣带，剩风残月，都在眉头。\n一成憔悴损，人惊怪，空自引镜堪羞。\n谁念短封难托，征雁虚浮。\n念夜寒灯火，懒寻前梦，满窗风雨，供断闲愁。\n情到不堪言处，却悔风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石州引/石州慢 别恨","author":"谢懋","text":"日脚斜明，秋色半阴，人意凄楚。\n飞云特地凝愁，做弄晚来微雨。\n谁家别院，舞困几叶霜红，西风送客闻砧杵。\n鞭马出都门，正潮平洲渚。\n无语。\n匆匆短棹，满载离愁，片帆高举。\n京洛红尘，因念几年羁旅。\n浅颦轻笑，旧时风月逢迎，别来谁画双眉妩。\n回首一销凝，望归鸿容与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杏花天 春思","author":"谢懋","text":"海棠枝上东风软。\n荡霁色、烟光弄暖。\n双双燕子归来晚。\n零落红香过半。\n琵琶泪揾青衫浅。\n念事与、危肠易断。\n馀酲未解扶头懒。\n屏里潇湘梦远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 其一 中秋呈徐叔至","author":"谢懋","text":"霁天湛碧。\n正新凉风露，冰壶清彻。\n河汉无声光练练，涌出银蟾孤绝。\n岩桂香飘，井梧影转，冷浸官袍洁。\n西厢往事，一帘清梦凄切。\n肠断楚峡云归，尊前无绪，知有愁如发。\n此夕常娥应也恨，冷落琼楼金阙。\n禁漏迢迢，边鸿杳杳，幽意凭谁决。\n阑干星斗，落梅三弄初阕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武陵春 惜别","author":"谢懋","text":"门掩东风人去后，愁损燕莺心。\n一朵梅花淡有春。\n粉黛不忺匀。\n我亦青楼成倦客，风月强追寻。\n莫把恩情做弄成。\n容易学行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画堂春 秋思","author":"谢懋","text":"西风庭院雨垂垂。\n黄花秋闰迟。\n已凉天气未寒时。\n才褪单衣。\n睡起枕痕犹在，鬓松钗压云低。\n玉奁重拂淡胭脂。\n情入双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞仙歌 春雨 春雨","author":"谢懋","text":"愁边雨细。\n漠漠天如醉。\n摇扬游丝晚风外。\n酿轻寒、和暝色，花柳难胜，春自老，谁管啼红敛翠。\n关情潜入夜，斜湿帘栊，几处挑灯耿无寐。\n念阳台、当日事，好伴云来，因个甚、不入襄王梦里。\n便添起、寒潮卷长江，又恐是离人，断肠清泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令","author":"谢懋","text":"黄道雨初乾。\n霁霭空蟠。\n东风杨柳碧毵毵。\n燕子不归花有恨，小院春寒。\n倦客亦何堪。\n尘满征衫。\n明朝野水几重山。\n归梦已随芳草绿，先到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪","author":"谢懋","text":"厌厌睡起，无限春情绪。\n柳色借轻烟，尚瘦怯、东风倦舞。\n海棠红皱，不奈晚来寒，帘半卷，日西沈，寂寞闲庭户。\n飞云无据。\n化作冥濛雨。\n愁里见春来，又只恐、愁催春去。\n惜花人老，芳草梦凄迷，题欲遍，琐窗纱，总是伤春句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解连环","author":"谢懋","text":"雁空辽邈。\n衬鱼鳞浪浅，护霜云薄。\n念故人、千里音尘，正山月朦胧，水村依约。\n见说瑶姬，拥十二、碧峰如削。\n倚孤芳澹伫，冷笑岁华，可堪寂寞。\n情多为谁瘦弱。\n爱吹芗弄粉，斜搴珠箔。\n自然林壑精神，想回首东风，万花羞落。\n梦绕南楼，对皓月、忍思量著。\n但销凝、夜阑酒醒，数声画角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 七夕","author":"谢懋","text":"钩帘借月，染云为幌，花面玉枝交映。\n凉生河汉一天秋，问此会、今宵孰胜。\n铜壶尚滴，烛龙已驾，泪浥西风不尽。\n明朝乌鹊到人间，试说向、青楼薄幸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜天晓角 桂花","author":"谢懋","text":"绿云剪叶。\n低护黄金屑。\n占断花中声誉，香与韵、两清洁。\n胜绝。\n君听说。\n是他来处别。\n试看仙衣犹带，金庭露、玉阶月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"越娘","text":"一自东君去后，几多恩爱暌离。\n频凝泪眼望乡畿。\n客路迢迢千里。\n顾我风情不薄，与君驿邸相随。\n参军虽死不须悲。\n幸有连枝同气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题来安县兴国寺","author":"遇僧","text":"三千里地孤寒客，七十年前富贵家。\n泛海玉龙驾雪浪，权藏头角混泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵隐寺","author":"道谏","text":"长吟游古寺，九里入青松。\n鸟向花间语，僧从月下逢。\n阴廊连碧殿，清磬杂疏钟。\n回首夕阳晚，烟霞锁乱峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三句外","author":"道禅师","text":"当人如举唱，三句岂能该。\n有问如何事，南岳与天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三句颂 函盖乾坤","author":"道禅师","text":"乾坤并万象，地狱及天堂。\n物物皆真见，头头用不伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三句颂 随波逐浪","author":"道禅师","text":"辩口利舌问，高低总不亏。\n还知应病药，诊候在临时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三句颂 截断众流","author":"道禅师","text":"堆山积岳来，一一尽尘埃。\n更拟论玄妙，冰消解瓦摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抬荐商量","author":"道禅师","text":"相见不扬眉，君东我亦西。\n红霞穿碧落，白日绕须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上秋夜","author":"释道潜","text":"雨暗苍江晚未晴，井梧翻叶动秋声。\n楼头夜半风吹断，月在浮云浅处明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"释道潜","text":"高岩有鸟不知名，款语春风入户庭。\n百舌黄鹂方用事，汝音虽好复谁听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：诗三句","author":"苏轼","text":"青山南，白石北，此地嵯峨人不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其二","author":"释了一","text":"清净行者不涅槃，破戒比丘无地狱。\n天台相接到西川，总是自家亲眷属。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十三","author":"释了一","text":"殿上从来好功德，如何侍者却疑惑。\n赵州露出赤心肝，问著依然墨漆黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十二","author":"释了一","text":"礼佛无端撞赵州，却将知见作冤雠。\n如今四海平如掌，云自高飞水自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十九","author":"释了一","text":"杨岐金圈与栗蓬，吞跳依前事不同。\n大海都来一口吸，更无南北与西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十","author":"释了一","text":"檀越家中作水牛，收来放去任优游。\n不曾犯著人苗稼，何必南泉对赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其四","author":"释了一","text":"清源佛法意如何，米价酬来太老婆。\n眨上眉毛行大道，莫于平地起风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其九","author":"释了一","text":"甘贽设粥念摩诃，致见南泉打破锅。\n万事但将公道断，任教四海动干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十五","author":"释了一","text":"的的古帆已挂后，小鱼吞却大头鱼。\n虽然李广运神箭，自古张颠解草书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十一","author":"释了一","text":"大地是眼没处屙，衲僧到此便聱讹。\n须知别有安身诀，会得安身事更多。\n咄，锹子安著在甚么处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其一","author":"释了一","text":"外道殷勤来问佛，有言不问及无言。\n大雄不费纤毫力，良马何曾用举鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十八","author":"释了一","text":"钟楼上念赞，床脚下种菜。\n猛虎当路蹲，时人俱不会。\n黄檗花开自有时，明州有个憨布袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其五","author":"释了一","text":"心不是佛，智不是道。\n举得十分，未敢相保。\n携条拄杖闲行，切忌回头转脑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十四","author":"释了一","text":"钟鼓未鸣先托钵，雪峰平地成饶舌。\n当时一径入僧堂，且看岩头有何说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其八","author":"释了一","text":"须知天地共同根，万物从来元一体。\n未审南泉庭下花，几人看了梦相似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十七","author":"释了一","text":"竹篦举起成生杀，岂肯容人乱札锥。\n劈脊一挥如荐得，银山铁壁也光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其七","author":"释了一","text":"乌臼分明棒有眼，这僧直是眼无筋。\n假饶打著百千个，切莫将伊挂齿唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其十六","author":"释了一","text":"春有百花夏有热，秋有凉风冬有雪。\n若无閒事挂心头，便是人间好时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其三","author":"释了一","text":"白日街头独自行，夜间屋里独自卧。\n山高不碍白云飞，竹密不妨流水过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十首 其六","author":"释了一","text":"南泉特地指瓶，隐峰便来泻水。\n两人自不识羞，掘地深埋自己。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释了心","text":"佛之一字孰云无，木马泥牛满道途。\n倚遍栏干春色晚，海风吹断碧珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释了朴","text":"灵云一笑见桃花，三十馀年始到家。\n从此春风春雨后，乱随名字落天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三首 其一","author":"释了朴","text":"酷暑如焚不易禁，炎炎赫赫欲流金。\n夜明帘外无人到，灵木超然转绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈无示和尚","author":"释了朴","text":"赤脚波斯入大唐，一家有事百家忙。\n而今四海清如镜，率土普天归我王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三首 其三","author":"释了朴","text":"德山入门便棒，临济入门便喝。\n临济喝处，德山棒头耳聋；德山棒时，临济喝下眼瞎。\n虽然一搦一抬，就中全生全杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三首 其二","author":"释了朴","text":"牛皮鞔露柱，露柱啾啾叫。\n灯笼佯不知，虚明还自照。\n殿脊老蚩吻，闻得呵呵笑。\n三门侧耳听，就上打之绕。\n譬如十日菊，开彻阿谁要。\n呵呵呵，未必秋香一夜衰，熨斗煎茶不同铫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其四","author":"释了朴","text":"观音岩玲玲珑珑，太白石丁丁东东。\n西园菜蟥似不堪食，东谷花发却无赖红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其三","author":"释了朴","text":"桃花红，李花白，东君怯寒辨未得。\n且令蝴蝶舞三台，啄木和成十八拍。\n呵呵呵，可怜陌上游人，开眼堂堂著贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其二","author":"释了朴","text":"洞山麻三斤，赵州庭前柏。\n滞货卖不行，未免著润色。\n五彩画牛头，便道是极则。\n七宝络象身，此个更奇特。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其一","author":"释了朴","text":"清白传家，赤穷到骨。\n心似寒灰，口如木突。\n纵有些儿葛藤，尽机也拈不出。\n凭何接待方来，聊与一掴一咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释了性","text":"一苇江头杨柳春，波心不见昔时人。\n雪庭要识安心士，鼻孔依前搭上唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨偈 其一","author":"释了思","text":"熇熇炎威遍野飘，流金烁石土山焦。\n精诚不作轩雷转，孰与人间济槁苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读政黄牛","author":"释了悟","text":"清旷情怀世莫羁，放心异类乐斯时。\n千山万水无穷意，只许滩头白鹭知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其四","author":"释了悟","text":"倒岳倾湫与么来，小根魔子谩疑猜。\n神驹一跃三千界，空说门前下马台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释了悟","text":"试问钟声披七条，轻轻击著无明发。\n买来糊饼是馒头，苦哉观世音菩萨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其五","author":"释了悟","text":"昨日栽茄子，今日种冬瓜。\n一声河满子，和月落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其三","author":"释了悟","text":"一即三，三即一，碧眼胡僧数不出。\n少林面壁九年，大似抱赃叫屈。\n屈屈，黄檗树头，讨甚木蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其一","author":"释了悟","text":"今朝七月半，丛林解制忙。\n当头老水牯，筋骨不堪当。\n大家团栾礼三拜，栴檀薝卜一般香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其二","author":"释了悟","text":"今朝开炉向火，诸方说禅浩浩。\n灵山一字也无，普请大家證据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一翁","author":"释了惠","text":"朕兆未分初，都卢只老夫。\n包羲太多事，胡处又添须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海眼光赞 其三","author":"释了惠","text":"玉腕指尖新，力能提万钧。\n上他篮子里，未必是金鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]