[{"title":"再和湖上晚归 其二","author":"释道潜","text":"云披雾卷仰昭回，试望翻经古石台。\n应有秋香生桂树，吹风肯傍暮船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子容同圣功见过 其一","author":"释道潜","text":"檀栾小径閟阴阴，解鞅停骖步更深。\n知我山栖久牢落，故留佳句比南金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子容同圣功见过 其二","author":"释道潜","text":"桃李君家世布阴，棣华雍穆义还深。\n浮云百变何须怪，张耳陈馀旧断金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"续许元裕梦中作 其一","author":"释道潜","text":"北窗支枕梦幽微，隐隐神明发暗机。\n未可病中惊老去，会须花底唤春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"续许元裕梦中作 其二","author":"释道潜","text":"琉璃虽破彩云飞，演庆高门未易衰。\n既有嘉祥能兆梦，定须他日产熊罴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其一","author":"释道潜","text":"泽畔蒹葭萧瑟，露华落日珠浮。\n抚事少陵多感，万端独立怀忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其二","author":"释道潜","text":"禅馀偶登绝巘，据石聊为欠申。\n眼界谩分畦畛，谁知大道无邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其三","author":"释道潜","text":"楚客当年何苦，愁怀缭转非舒。\n赖有管城公子，离骚万恨能书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其四","author":"释道潜","text":"西湖发挥有素，最盛唯誇乐天。\n遗爱到今不朽，长堤一道如弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其五","author":"释道潜","text":"处士尚馀陈迹，断碑横卧林塘。\n婉约梅花秀句，骚人万古传香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其六","author":"释道潜","text":"草蔓行将溃茂，菊英稍稍敷金。\n南浦愁窥去燕，海山莽苍云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其七","author":"释道潜","text":"江城秋至几日，风物斗觉凄凉。\n邻女机丝何有，夜闻促织悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其八","author":"释道潜","text":"人物年来衰谢，背绳追曲周容。\n嗟尔得时蝘蜓，故能嘲哂龟龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其九","author":"释道潜","text":"凉月娟娟清媚，舒光巧入帘栊。\n万籁声同比竹，细窥一一空中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复湖上秋日六言 其十","author":"释道潜","text":"可怪狙公巧黠，犹迷暮四朝三。\n老我身如枯蘖，兀然不动幽岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观宗室赵明发使君所画访戴图并二小诗因次其韵 其一","author":"释道潜","text":"水石追摩诘，风骚类小山。\n每来窥二妙，恋恋欲忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观宗室赵明发使君所画访戴图并二小诗因次其韵 其二","author":"释道潜","text":"巉绝千峰玉，清妍五字诗。\n胸中盘爽气，彷佛几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵楼试可承议见招","author":"释道潜","text":"东州羁旅迹谁亲，夫子端能给我贫。\n默识松筠霜后操，静看桃李梦中春。\n嵩阳胜绝高天下，县令风流迈古人。\n待得芳菲开烂熳，去随行乐后车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵秦少游学士 其一","author":"释道潜","text":"数幅生绡上，形容万态心。\n坐窥天下胜，何用远登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵秦少游学士 其二","author":"释道潜","text":"漠漠云披岫，班斑雨弄晴。\n横江舟一叶，注目使人惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵秦少游学士 其三","author":"释道潜","text":"阳秋閟肝膈，无处见微茫。\n时作丹青戏，风流冠帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵秦少游学士 其四","author":"释道潜","text":"参差山接野，渺莽水连空。\n笠钓沙头客，真宜避世翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴","author":"释道潜","text":"浮云易作雨无端，未放春泥十日乾。\n须信杏园憔悴煞，从来花骨不禁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯言明发登西楼望桃花 其一","author":"释道潜","text":"江南梅子已生仁，京国桃花始放春。\n气候不齐虽可恨，一枝犹得见墙闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送伯言赴姑苏上幕","author":"释道潜","text":"都城公子海，贤否良难会。\n从容翰墨场，班班知所诣。\n超然三四公，词学昔人配。\n源流出苏黄，汲引功岂细。\n斯人固才华，气节复远迈。\n一官从幕府，未觉簿书碍。\n投刃却凫行，岸巾依物外。\n凝香久寂寞，清绝今可继。\n初辞广陌尘，笑鼓春江枻。\n楚岫与吴山，相望挹空际。\n莫唱渭城歌，临流增叹喟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠欧阳季默承议","author":"释道潜","text":"先公跨箕尾，摇曳旋天关。\n于今二纪馀，肯复来人间。\n时时对遗编，彷佛窥一斑。\n梦寐思见之，何从暂追攀。\n迩来都城里，忽睹庭中兰。\n方寸实惊喜，典刑斯可观。\n抱疴一榻上，骨瘦清琅玕。\n为余设幽几，气貌徐以宽。\n微词落玉麈，文彩真孔鸾。\n棣华惜未识，妙誉闻朝端。\n先公德未泯，四海共仰叹。\n愿言付百世，清风嗣门阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘延中廷直见赠","author":"释道潜","text":"刘郎世胄子，苦学穷渊源。\n羞为一掬清，欲效千丈浑。\n君看长鲸质，涧壑岂所存。\n操觚妙述作，斧凿无纤痕。\n钟牙不世出，审音谁复论。\n鹓雏理劲翮，云汉思孤鶱。\n上追鸾皇游，下弃燕雀喧。\n建安誇七子，壮气君可吞。\n九衢苦昏霾，槐阴蔽重门。\n良辰为我饭，满案馀芳荪。\n软语夜达旦，未觉罢神魂。\n须知名教乐，不羡富贵尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬刘巨载舍人见赠所画山水扇","author":"释道潜","text":"冰纨玉粉净无尘，墨妙扶疏更绝伦。\n试问挥毫底人物，不言从可识天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观明发画李贺高轩过图","author":"释道潜","text":"唐年茂宗枝，时平多俊良。\n长吉尤震曜，春林擢孤芳。\n退之于孔门，屹屹真栋梁。\n笔力障百川，风澜息其狂。\n破衣系麻鞋，右顾生辉光。\n一朝与湜辈，命驾惊煌煌。\n贺初为儿童，随父事迎将。\n须臾命赋诗，英气加激昂。\n长安众词客，声问争推扬。\n风流垂异代，尚想古锦囊。\n君今亦宗英，韵胜斯人方。\n少年肯事事，苦学志独强。\n风骚拟屈宋，妙处相颉颃。\n丹青出戏弄，配古犹擅场。\n形容示往事，彷佛如在旁。\n一径入幽远，古垣缭林庄。\n平桥跨渌水，丛薄含葱苍。\n晴窗为披拂，佳兴杳难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵东坡居士过岭","author":"释道潜","text":"一时迁客尽难堪，二老高怀默自甘。\n造物定知还岭北，暮年宁许丧天南。\n安排拄杖寻庐阜，斗薮征衣洗瘴岚。\n他日相逢长夜语，残灯飞烬落毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵代岭上老人答","author":"释道潜","text":"闲持箕帚扫崔嵬，夹道松阴尽我栽。\n人去人归真一笑，坏空成住互轮回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子由侍郎书事二首 其一","author":"释道潜","text":"七年依岭外，遇物即防闲。\n宿负初偿毕，他生岂复还。\n飘飘疑鹤骨，奕奕蔼童颜。\n自许乔松寿，玄机密锁关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子由侍郎书事二首 其二","author":"释道潜","text":"直材不易得，于国实长城。\n造父还能御，骅骝岂惮行。\n买田邻少室，为计老馀生。\n居士来何晚，江淮遣候迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵试可见访峻极遇雨","author":"释道潜","text":"都城尘土倦茫茫，独喜西来策甚长。\n避暑禅房依亢爽，可人溪雨作清凉。\n飞蚊斗绝檐间闹，乳燕时拳砌下篁。\n县令风流真晋客，谈馀玉麈自挥扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"揖仙亭","author":"释道潜","text":"崧阳古令尹，制锦誇妙手。\n鸣弦对高堂，坐使风俗厚。\n政成思考槃，觞豆宴宾友。\n开亭面缑岭，佳致昔未有。\n云烟霭葱昽，青壁冠星斗。\n王子果真仙，揖君千载后。\n鸾车驻缥缈，彷佛容暂偶。\n天风吹箫笙，凄响落户牖。\n纷纷惊坐客，往往为回首。\n相顾勿复言，且进杯中酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵试可同游法王岳寺","author":"释道潜","text":"两山脩径尽榛芜，谩诧当年幸翠舆。\n空睹宸文藏宝构，不逢衲子话真如。\n林深想见灵根茂，地胜宜多隐者居。\n凉月照人归路好，傍溪嘉树影扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵试可喜雨","author":"释道潜","text":"东阡北陌久黄埃，天遣神龙讵用媒。\n云似涛头山半起，雨如银竹望中来。\n奔输涧谷时颓岸，喷激龟鱼或曝腮。\n民物有秋真可喜，池莲从此更须栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"峻极夏夜","author":"释道潜","text":"广庭无凡株，郁郁两佳树。\n扶疏饶美荫，盘错根本固。\n朝披叶底风，夜泫衣上露。\n禅馀自循绕，百匝未忍住。\n月华中天来，左右发晖素。\n清景非人间，泠然洗吾虑。\n缅彼大梁下，炎蒸毒朝暮。\n朱门晓未开，马足已驰骛。\n摧眉事权要，幸彼一盼顾。\n素标插君头，扰扰独不悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观宗室曹夫人画 其一","author":"释道潜","text":"野水平林眇不穷，雪翻鸥鹭点晴空。\n洞房岂识江湖趣，意象冥将造化同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观宗室曹夫人画 其二","author":"释道潜","text":"华屋生知世胄荣，谁教天付与多能。\n西风白草牛羊晚，隐见横冈一两层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观宗室曹夫人画 其三","author":"释道潜","text":"临平山下藕花洲，旁引官河一带流。\n雨棹风帆有无处，笔端须与细冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵试可岳祠祭土宿斋","author":"释道潜","text":"神祠斋馆卧耽耽，五鼓星河屡起瞻。\n剑佩森森趋帝右，衣冠肃肃奉宸严。\n风传远壑松千树，人拥回廊月一帘。\n四岳旌幢初会散，晨乌声动庙竿尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠宗室德强团练","author":"释道潜","text":"造物赋象质，于余颇能名。\n琼瑶琢其骨，冲和擅其清。\n公生华屋贵，好学从妙龄。\n才高岂容遏，卓然以文鸣。\n厚德滋善养，雍容无暂矜。\n区区草茅人，未必真尔能。\n家藏三万轴，插架连屋楹。\n牙签示题目，探赜手不停。\n微言固澹泊，嗜好如饴饧。\n祖宗开鸿基，累圣致太平。\n诜诜既蕃衍，绰绰亦见称。\n裕陵喜人物，教率从典刑。\n联翩试文艺，议论参公卿。\n公材实杞梓，落落非杉柽。\n愿言勤著书，会当补朝廷。\n他时树勋业，彝鼎信可铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋声","author":"释道潜","text":"古槐花落小中庭，夜半风来捲叶鸣。\n颍水先生如尚在，呼儿应问此何声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵天选寄逍遥庵黄居士","author":"释道潜","text":"收得词场举子身，拂衣高卧傍嶙峋。\n休言白日壶中胜，且看红颜镜里春。\n富贵群争虽有路，山林独往岂无人。\n恐君未识陶彭泽，故约篮舆访采真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵试可同谒子晋祠 其一","author":"释道潜","text":"古柏连冈三万株，朝烟破日翠扶疏。\n投鞭下马得幽径，共谒宾天帝子居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵试可同谒子晋祠 其二","author":"释道潜","text":"遗荣少海猛无双，便逐浮丘出帝乡。\n可笑而今居富贵，亦思高举上苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭少游学士 其一","author":"释道潜","text":"江左有豪英，超骧世无伦。\n妙龄已述作，识造穷天人。\n儒林老先生，相与为友宾。\n客来叩治乱，亹亹披霜筠。\n波澜与枝叶，犹足誇后尘。\n青衫入仕初，十手争扶轮。\n孤嘲可敌众，志郁不得信。\n造物念流落，荐收付洪钧。\n干将不许就，中昼如有神。\n七年投炎荒，日与山鬼邻。\n妻孥各异土，相望同参辰。\n秋风吹黄茅，八月瘴雾新。\n回车婴重疠，茕茕无与亲。\n中原尚杳隔，坟陇怀棘薪。\n凄凉浯水头，魂逝归无因。\n精爽竟了了，挽章见情真。\n流传到京阙，悲读闻缙绅。\n斯人傥不亡，光华国之珍。\n彼苍未易晓，三叹鼻酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭少游学士 其二","author":"释道潜","text":"念子少年日，豪气吞九州。\n读书知穾奥，游刃无全牛。\n当时所献策，考致第一流。\n论高追贾谊，气胜凌马周。\n胜理非空文，灼可资庙谋。\n危根易摇动，谓子不好脩。\n呜呼一齐人，柰彼众楚咻。\n孔门馀四科，士岂一律求。\n区区事屠钓，崛起为公侯。\n数奇信有命，君亦忘怨尤。\n平生所著书，字字铿琳球。\n子道决不泯，千载传芳猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭少游学士 其三","author":"释道潜","text":"瓶盂客京口，彷佛熙宁末。\n君方驾扁舟，归来自苕霅。\n中泠忽相值，倾盖忘楚越。\n禅挥庞老锋，辩鼓子贡舌。\n连宵极名谈，江阁倚清绝。\n扣槛出鼋鼍，时取一笑发。\n邗沟介淮海，济济多俊杰。\n良辰苦招要，结好从此设。\n堂堂紫髯翁，道德冠前烈。\n风流广文先，烱烱事脩洁。\n老禅魁丛林，冠盖趋杂遝。\n三豪相继往，墓木叶屡脱。\n子今复云亡，枯棋愈残缺。\n相逢旧好间，悲诧那忍说。\n明年东下船，系缆竹西月。\n茗奠蜀冈南，弹指当永诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王晋卿都尉","author":"释道潜","text":"主第耽耽冠北城，位居侯伯固尊荣。\n肯将踏月趋朝脚，来伴穿云渡水行。\n池上红蕖应渐老，山中紫笋尚抽萌。\n嵩阳迤逦川原胜，闻说它时卜钓耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与田承君宗丞话旧","author":"释道潜","text":"赤日下西谷，松门敛馀晖。\n萧萧征马鸣，客子来者谁。\n故人田子方，六月并州归。\n崎岖千里道，问子来何为。\n君命不俟驾，讵敢辞炎曦。\n禅庭梵呗歇，软语同逶迤。\n梧桐挂凉月，清润含裳衣。\n人生实萍梗，同附一渺瀰。\n惊风或暂先，波定还相依。\n昔我在南兖，识君英妙时。\n轩轩勇气节，凛凛如熊罴。\n声名固已早，时命殊淹迟。\n今兹向魏阙，骥足将腾夷。\n圣君隆至治，谏诤求瑕玼。\n尝闻至人语，子可补拾遗。\n一言开尧聪，四海风俗移。\n无为外重失，蹇谔当自持。\n赠言古者事，吾岂忘前规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登岳顶呈试可邦直","author":"释道潜","text":"伟哉中国擅五岳，巍巍崧高据其尊。\n四时百辟尽朝会，云幢烟盖来追奔。\n自馀众阜何足数，扰扰罗列真儿孙。\n秋霖乍开原野净，隆曦破海浮朝暾。\n渊明旷达不事事，胜日结客游山樊。\n山腰下马蹑风磴，杖屦诘曲跻巑岏。\n窗经玉女猿鸟寂，石漱飞浏鸣潺湲。\n长松吟风和哀响，肌肤凛栗凄神魂。\n行穷绝顶已晡侧，云烟为我开馀昏。\n昂头去天惊尺五，星斗历历俯可扪。\n超然拟与人世绝，彷佛有路通昆崙。\n洛阳奇峰三十六，领略并入一眼吞。\n平生方寸喜壮观，兹游气豁殊轩轩。\n二豪词笔有馀地，请赋杰句留山巅。\n风流便可付千载，欧梅尹谢相与传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王彦龄承务还河内","author":"释德洪","text":"武陵王郎高韵度，鞍马四方在定住。\n眼随泉石便吟哦，咳唾珠玑不计数。\n我亦悠悠事不羁，浪萍风梗随安之。\n少室山前石兰若，邂逅便与同襟期。\n兴来岸帻一长啸，清声激越穿云峤。\n竹林故事独未泯，人物如君独高调。\n秋风猎猎促鸣蝉，归路千山入马鞭。\n白袍乌袖宜图画，不羡襄阳孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宗室周臣观察","author":"释道潜","text":"帝胄天孙多茂良，似公人物更难方。\n诗书自负青云器，风月能收古锦囊。\n科斗雷文陈几席，鳞衣蚁食耀杯觞。\n都城邂逅倾迟素，崧少归来一梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宗室公震防禦画后","author":"释道潜","text":"错莫江云结暝阴，归飞宿翼半浮沉。\n毫端领略无遗种，想见雍容物外心。\n蒹葭照雪含馀润，古木欃天气老成。\n山谷不来居士死，何人为子一题评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同赵伯充防禦观东坡所画枯木 其一","author":"释道潜","text":"经纶志业终不试，晚岁收功翰墨林。\n偶向僧坊委陈迹，每经风雨听龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同赵伯充防禦观东坡所画枯木 其二","author":"释道潜","text":"萧然素壁倚枯枝，行路惊嗟况所思。\n惆怅骑鲸天上去，却来人世恐无期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大年观察许作从驾出南薰门雪霁图因以诗督之","author":"释道潜","text":"南薰门外照初阳，宝马雕鞍从玉皇。\n千丈雪云开远野，万枝琼树斗新妆。\n笔端妙处君先得，老去闲情我未忘。\n乞与山林资玩好，高悬素壁烂生光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与廖明略学士赋馀干县白云亭一首呈吴明府","author":"释道潜","text":"白云翔太虚，时来傍孤城。\n超然此荣观，常恐鸾鹤迎。\n能赋自畴昔，骚人遗典刑。\n嗣音竟有属，异代逢渊明。\n挥毫无停缀，临流有馀清。\n光风转洲渚，爽气生轩楹。\n况复廖常州，吐辞皆正声。\n跂予浪续貂，坐想徒摇旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 大裘轩","author":"释道潜","text":"经纶志四海，龃龉不得申。\n大裘纵千丈，姑覆洛阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]