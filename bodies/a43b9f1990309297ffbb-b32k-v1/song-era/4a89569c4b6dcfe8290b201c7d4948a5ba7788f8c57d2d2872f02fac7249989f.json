[{"title":"次韵米元章壮观","author":"饶节","text":"晓色村村澹，春风树树秾。\n八窗中夜月，千里隔江峰。\n酒道穷通乐，诗原左右逢。\n客来应下榻，石铫煮长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午日二首 其一","author":"饶节","text":"艾叶斜枝短，菖蒲瘦节长。\n绿云依鬓乱，红雪落杯香。\n风物江淮似，功名岁月忙。\n泽间人吊屈，应有泪浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午日二首 其二","author":"饶节","text":"异代多同俗，千秋饷楚魂。\n人才终可惜，祀事故常存。\n赤卤丰禾黍，闲民长子孙。\n怜渠身世拙，满眼暮云屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居二首 其一","author":"饶节","text":"小径深通竹，疏篱巧过藤。\n冷猿啸古木，饥鹭啄寒冰。\n贵客终难屈，蓬门不用应。\n此中有佳处，黄卷短檠灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居二首 其二","author":"饶节","text":"门拥深深草，溪明衮衮沙。\n冷烟浮菜甲，小雨荐茅牙。\n老兴元无系，春工竟自华。\n邻翁却相可，步屧过渠家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王长元同弟次元赴官","author":"饶节","text":"梁苑春未竞，隋河冻尚肥。\n鬓毛开老境，甲子运天机。\n华鄂君方仕，樵苏我未归。\n凭将汝南麈，慎对可人挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒲适正挽歌","author":"饶节","text":"吾道何多蹇，苍天呼不闻。\n楩楠初有待，泾渭竟难分。\n阅世中庸行，随时俗下文。\n想君九原恨，著草露纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"息虑轩诗","author":"饶节","text":"雨暗藤经屋，春深草到门。\n客来非问字，鹤老不乘轩。\n花气翻诗思，松声撼醉魂。\n呼儿换香鼎，趺坐竟黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮","author":"饶节","text":"浩荡生涯计，凄凉客子心。\n岁从官历尽，忧入鬓毛深。\n月气含窗户，汤声转釜鬵。\n馀生无所慕，持此卧山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宿州晁祖禹签判","author":"饶节","text":"一见晁公子，雍容前辈风。\n规模俗吏外，步作古人中。\n环佩千官合，梯航九驿通。\n空虚循吏传，谁为荐诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日发淮康","author":"饶节","text":"九日非吾事，黄花亦谩生。\n未倾彭泽酒，还背汝阳城。\n细雨秋天近，西风白葛轻。\n山村远城市，可有笑歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日游城南展氏园登阁","author":"饶节","text":"金灯奋髯阶砌宽，杨柳缓带楼阁闲。\n我来不为春事促，西风斜日面前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"制药","author":"饶节","text":"身如逆旅无非我，岂谓昌阳信引年。\n南北未能忘世故，药囊随处却安禅。\n万金良药吾何用，九转丹砂世谩传。\n草木精华如可贳，未妨巾屦地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麻城道中","author":"饶节","text":"拱道新松无数青，晚风十里撼江声。\n栋梁不是寻常度，宜有长材待老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过淮","author":"饶节","text":"淮山漠漠水潭潭，落日孤云自不堪。\n今夜月明风更急，凭吹魂梦到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从人觅山水扇二首 其一","author":"饶节","text":"少壮崎岖山水间，短衣楚制略胜寒。\n年来疲病归期堕，只乞君家便面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从人觅山水扇二首 其二","author":"饶节","text":"爱君才气耻言兵，欲倚诗书继老成。\n手里林泉当付我，恐妨抽板揖公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"饶节","text":"广离骚罢独支颐，万里江山座上归。\n门外不知蛮战触，满窗蚊子刺明飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自简","author":"饶节","text":"错龟数策愿分疑，筮短龟长一是非。\n但把故吾重简练，不须分画见郊圻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以太学灯笼遗陈松老","author":"饶节","text":"君有传家三尺檠，巨编长轴称经营。\n时文今是蝇头字，遗子终南捷径行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻说","author":"饶节","text":"闻说南方仍岁旱，十家生事九家空。\n君王分寄二千石，避寝何人舍盖公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邻鸡","author":"饶节","text":"邻鸡振羽非恶声，北斗倒挂玉绳横。\n朋来劳苦饥寒解，客去悠飏羽翼成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨偶晴见日","author":"饶节","text":"浓阴百日漫西东，汹汹隋河夜欲洪。\n但得望尧常拜手，谁能畏盾辄逃空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵元达久不至池上作诗戏之","author":"饶节","text":"雨后新荷拥岸青，菰蒲相向立蜻蜓。\n此中佳处君知否，应对文君赋小星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵","author":"饶节","text":"杨柳池塘表里青，鱼儿偷眼畏蜻蜓。\n夜来雨过菖蒲静，倒浸中天四五星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书天源河上友人壁","author":"饶节","text":"春色撩人不奈渠，红尘无处可飞凫。\n悬知桃李付流水，来看垂杨十万株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答陈考城","author":"饶节","text":"袖里楞伽非世书，了知乾没未殊途。\n会携他日已漫刺，归谒南山五大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为谢无逸赋梅花二首 其一","author":"饶节","text":"顿有亭前春耐寒，年年扶杖雪中看。\n不知谢子题诗处，比得王家第几般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为谢无逸赋梅花二首 其二","author":"饶节","text":"闻道香寒卧雪枝，琼楼玉户巧相依。\n可怜今日移根处，王谢堂前燕子飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赵元达","author":"饶节","text":"竹木王孙不嗣音，老夫多病转侵寻。\n可怜一息绝缨会，破坏经年设醴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日书谢氏园壁","author":"饶节","text":"瓦缶藏春土脉乾，嫣香已谢菊花团。\n履声绕尽栏干曲，肃肃松风作暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卧云堂","author":"饶节","text":"补牢初未益亡羊，聊伴闲云卧草堂。\n君解入官云作雨，未应舒卷却相妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听松轩","author":"饶节","text":"老龙偃蹇据岩壑，匠石营材城市中。\n自有幽人不相负，解凭曲几听秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观鱼阁","author":"饶节","text":"纷纷乾没可怜渠，小阁诗书自有馀。\n日背竹林风过柳，试扶松槛看浮鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"快目亭","author":"饶节","text":"文字遮人窗闭蝇，无人传与卫生经。\n我愁烂漫不可写，须上君家快目亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中两绝句 其一","author":"饶节","text":"芒鞋藜杖世缘轻，无妄谁令水火争。\n造物小儿莫相苦，此中无物可亏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中两绝句 其二","author":"饶节","text":"暑湿相乘势益昌，呼童煮药不知方。\n悬知草木皆凭藉，聊为形骸作主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日即事二首 其一","author":"饶节","text":"人言春事经桃李，我欲要之病未任。\n昨日强随年少去，看花那复故时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日即事二首 其二","author":"饶节","text":"风光竟岁宜人少，乐事惟春取数多。\n果下小骝君借我，一鞭随意掠烟莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送同舍葛茂达还浙东二首 其一","author":"饶节","text":"岂无强醉阳司业，固有无钱郑广文。\n三请未能勤问道，一归今日愿从君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送同舍葛茂达还浙东二首 其二","author":"饶节","text":"隋河东下一千里，僮仆未知行李劳。\n闻道杞苗今结子，凭君饱食赋离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕原明侍讲欢喜四绝句 其一 麦熟","author":"饶节","text":"黄云千顷起邱山，瓶缶村村自往还。\n悬知大作今年社，我欲从渠季孟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕原明侍讲欢喜四绝句 其二 拾麦","author":"饶节","text":"撝镰霍霍穟纷纷，多谢遗馀畀后人。\n负载归来对妻子，始知身是太平民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕原明侍讲欢喜四绝句 其三 蚕熟","author":"饶节","text":"丝在机头角未乾，儿孙衣褐眼中完。\n茅檐翁妪自相寿，饱暖浑家感县官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕原明侍讲欢喜四绝句 其四 盗获","author":"饶节","text":"似闻有盗起空舍，闻说驱除唾手间。\n枹鼓不惊鸡自午，先生闭户养三关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寻梅二首 其一","author":"饶节","text":"闻道香寒犯雪开，驼裘絮帽探春来。\n立春恰在王正朔，次第群芳不待催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寻梅二首 其二","author":"饶节","text":"乐事何如忧患多，寻梅不厌数经过。\n从今直到杨花尽，终始春风亦几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曾伯容","author":"饶节","text":"岂是从前踪迹疏，三年不送一行书。\n襄山傥有陪邻地，为问洲中种木奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕居仁共二首 其一 望山","author":"饶节","text":"文章二子东西汉，人物诸何大小山。\n四海有家归未得，眼看寸碧便怡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕居仁共二首 其二 榴花","author":"饶节","text":"安石榴花作意开，杖藜聊复为渠来。\n何人风味更不浅，屐齿峥嵘付绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞姬墓","author":"饶节","text":"风悲月黑楚歌闻，泣下虞兮夜未分。\n千骑星飞向前死，不知谁为闭荒坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霸王城","author":"饶节","text":"百年父老不知兵，楚汉相持尚有营。\n日暮牛羊归虎落，野鸡飞过霸王城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起观垂丝海棠感慨作二绝句 其一","author":"饶节","text":"迟日暖风逼春事，海棠垂丝转娇羞。\n分明绰约若处子，桃杏尘凡非此流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起观垂丝海棠感慨作二绝句 其二","author":"饶节","text":"卖花担上誇桃李，顿使春工不值钱。\n莫怪海棠不受折，要令笄珥绝凡缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用海印和尚韵和吴提刑游山颂","author":"饶节","text":"白崖老将卧遥岑，苗裔分明祖少林。\n遂有乐天来问道，不妨黄檗为传心。\n绳床斜月坐秋晚，石铫寒泉语夜深。\n一枕竹风清未晓，堂堂鱼鼓现观音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵示谢公定学士","author":"饶节","text":"买金须是识真金，学道先防邪见林。\n切忌随言因作解，直须见色便明心。\n大圆觉海波澜阔，优钵罗花根蒂深。\n只者若还亲荐得，十方俱现海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵示官人","author":"饶节","text":"古路玄微难谩寻，古人须要饱丛林。\n待闻墙壁炽然说，方见风幡便是心。\n鼻孔易随人事去，鬓毛空觉岁华深。\n儿啼女唤君知否，尽是频伽美妙音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵示同参","author":"饶节","text":"谈玄说妙隔千岑，过取诸方荆棘林。\n三界有谁教学道，十方无法谩求心。\n老胡生下家先破，达磨西来病转深。\n却问谁知第一句，恒沙诸佛未知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答惠海首座五首海乃圆照禅师小师 其一","author":"饶节","text":"闹市丛边荆棘侵，旃檀独秀旧园林。\n俊驹昔是吾家瑞，老鹤今犹万里心。\n短笛凄清秋水阔，乱山高下白云深。\n当年得力分明处，伫听炉香演一音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答惠海首座五首海乃圆照禅师小师 其二","author":"饶节","text":"龙生龙子气骎骎，拄杖横担遍宝林。\n果得云门函盖句，肯忘黄檗老婆心。\n扶疏绿树西风薄，零落黄花秋意深。\n若问宗风竟谁嗣，请将消息问威音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答惠海首座五首海乃圆照禅师小师 其三","author":"饶节","text":"莫叹宗师久屈沉，赵州八十尚丛林。\n脚跟点地便无事，鼻孔撩天非有心。\n落笔满堂嗟敏妙，谈玄终日见精深。\n丁宁佛法无多子，三角泥牛演梵音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答惠海首座五首海乃圆照禅师小师 其四","author":"饶节","text":"瓶钵随缘访古今，皎如玉树倚寒林。\n投机不碍多玄辩，寄宿何曾有执心。\n禅板蒲团人已静，博山沈水观方深。\n从来大器宜成晚，王国公卿多赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答惠海首座五首海乃圆照禅师小师 其五","author":"饶节","text":"流辈推高不独今，当年成笋便平林。\n白云纵有为霖意，流水曾无恋影心。\n问道故人归雨后，供香童子立更深。\n青山不免露头角，短幅斜封更嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜官人悟道","author":"饶节","text":"白崖峰顶绝跻攀，到者方知到者难。\n闻道裴公才一喏，便从偃老破三关。\n人生有限随流去，佛法无多掣电间。\n喜见伽陀辨端的，倒骑驴子上幡竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阆人蒲君锡提举参老师悟道唱和四首 其一","author":"饶节","text":"一喏推翻十二峰，三乘四库当时通。\n自闻百丈下堂句，已破提婆外道宗。\n画角晓吹深径雪，寒梅晴放小塘风。\n孤峰顶上他年事，又是筹盈石室中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阆人蒲君锡提举参老师悟道唱和四首 其二","author":"饶节","text":"魔法年来逞独雄，不令人说悟圆通。\n傥无上士已亲證，争识吾家是正宗。\n饱腹岂因餐画饼，开花须是得春风。\n从今同道方相委，九尾乌龟啸月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阆人蒲君锡提举参老师悟道唱和四首 其三","author":"饶节","text":"东西南北本来同，自有时人碍不通。\n了后何妨三藏教，悟来那有五家宗。\n学飞雕鹗雄吞野，出腹麒麟要弄风。\n到底输他真鼻孔，痴人空坐黑山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阆人蒲君锡提举参老师悟道唱和四首 其四","author":"饶节","text":"老胡入草太无穷，直指仙人那一通。\n今日大颠回吏部，他年李勃嗣归宗。\n华夷元共一轮月，今古曾无两样风。\n从此牧牛真石巩，肯令信脚犯苗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别用韵寄诸同参","author":"饶节","text":"好笑多知一老翁，须言妙用及神通。\n我无佛说并魔说，谁问南宗与北宗。\n粗饭有时聊饱腹，破衣随分且遮风。\n他年同道如相过，沙铫煨茶竹叶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄夏均父二首 其一","author":"饶节","text":"好雪春来番更番，思君未说几时还。\n有心便欲辞彭泽，更懒聊须到鲁山。\n酒肉异时相煦湿，功名他日已斓斑。\n故人若问别来事，举似云门第二关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄夏均父二首 其二","author":"饶节","text":"四海交情未有君，解衣推食见情真。\n平生烂漫如一日，万里周旋觉更亲。\n我已山林新祝发，君犹州县故随人。\n而今官意知何似，早晚归来洗世尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海印生日","author":"饶节","text":"优钵罗花此日开，法王真子异凡材。\n平生极力参耆旧，晚岁倾心接后来。\n得意篇章浑简易，忘情风境自徘徊。\n儿孙只么酬恩德，倒挽沧溟作寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]