[{"title":"次韵叶希虞秘校同游天竺寺五绝句 其五","author":"苏颂","text":"槛前常有施生台，窗隙都无野马埃。\n掩室道人偏得意，经年未省入城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶希虞秘校同游天竺寺五绝句 其三","author":"苏颂","text":"山半僧轩四面开，下看城市一浮埃。\n此间真趣谁能辨，飞鸟空中自往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶希虞秘校同游天竺寺五绝句 其一","author":"苏颂","text":"蜡屐终朝践石苔，飞鸢不动绝尘埃。\n片云忽作人间雨，尽道灵山应祷来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵阳孝本游翟家湾书院二首又一绝 其三","author":"苏颂","text":"谩誇三岛冠灵鳌，咫尺龙冈去靡劳。\n若使南阳人独卧，风云宁隔海山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李公择送新赐龙团与黄学士三绝句 其二","author":"苏颂","text":"黄金芽嫩先春发，紫碧团芳出焙来。\n闻说采时争节候，喊山声动甚惊雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李公择送新赐龙团与黄学士三绝句 其三","author":"苏颂","text":"团团龙镜未磨开，馥馥新香满座来。\n试酌灵泉看饽沫，犹疑盏底有风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李公择送新赐龙团与黄学士三绝句 其一","author":"苏颂","text":"红旗筠笼过银台，赤印囊封贡茗来。\n社后三旬颁近列，须知邮置疾奔雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李公择谢黄学士惠文潞公所送密云小团一绝","author":"苏颂","text":"小团品外众茶魁，宅相分从宰相来。\n南省同僚得传玩，朵颐终日味山雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丹阳裴如晦学士寄示与蔡子直陈述古唱酬五篇 其四","author":"苏颂","text":"当年二邑弦歌洽，所幸诸生簦蹻随。\n此日毗陵流美化，风流应似赞皇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丹阳裴如晦学士寄示与蔡子直陈述古唱酬五篇 其一","author":"苏颂","text":"登瀛忝继唐词客，补郡仍陪汉望郎。\n政事将何攀邵杜，声名空贵蹑王杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丹阳裴如晦学士寄示与蔡子直陈述古唱酬五篇 其二","author":"苏颂","text":"三贤领剧缘才选，拙者求閒属倦飞。\n幸得汝阴当僻左，无能尸禄众应讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丹阳裴如晦学士寄示与蔡子直陈述古唱酬五篇 其五","author":"苏颂","text":"惠爱昔曾留二浙，能声行复表三河。\n更传骚雅联编富，可是江山助思多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丹阳裴如晦学士寄示与蔡子直陈述古唱酬五篇 其三","author":"苏颂","text":"紞鼓吴门彻曙开，郡人还喜邓侯来。\n政成岁稔庭无讼，谁伴南园举宴杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新馆罕见居人","author":"苏颂","text":"引弓风俗可伤嗟，满目清溪与白沙。\n封域虽长编户少，隔山才见两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过摘星岭","author":"苏颂","text":"路无斥堠惟看日，岭近云霄可摘星。\n握节偶来观国俗，汉家恩厚一方宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"补和王深甫颍川西湖四篇 其一 甘棠湖","author":"苏颂","text":"为湖始何人，人贤物亦久。\n所以甘棠名，百年犹不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"补和王深甫颍川西湖四篇 其四 明月舫","author":"苏颂","text":"明月照寒宵，湖水白如昼。\n纵览泊中流，清光应可就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和土河馆遇小雪","author":"苏颂","text":"薄雪悠扬朔气清，冲风吹拂毳裘轻。\n人看满路琼瑶迹，尽道光华使者行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文太尉第一无双绝句","author":"苏颂","text":"未遂退休时望系，再烦居守主恩优。\n自缘齿德高群牧，须在山河最上流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲巽过古北口杨无敌庙","author":"苏颂","text":"汉家飞将领熊罴，死战燕山护我师。\n威信仇方名不灭，至今奚虏奉遗祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲巽奚山部落","author":"苏颂","text":"千里封疆蓟霫间，时平忘战马牛閒。\n居人处处营耕牧，尽室穹车往复还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和安上弟雨雪应祷绝句","author":"苏颂","text":"霰雪为霖近浃旬，江湖清气压冬温。\n应时岂是诚能感，作物宜同易画坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和安上弟雪中登介亭","author":"苏颂","text":"滴沥泉池乱蕊珠，悠飏僧壁点赪糊。\n登高偏见远山好，万瓦参差篆玉符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和安上弟游湖山诸寺二首 其二","author":"苏颂","text":"十里湖山绕四门，游人朝暮隘重闉。\n楼台远近连郊郭，到处皆为水石邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和安上弟游湖山诸寺二首 其一","author":"苏颂","text":"四百僧居胜沃洲，