[{"title":"擢第南归道中早发","author":"宋庠","text":"紫汉回天斗柄横，萧萧羸马困遄征。\n南归昼绣恩偏厚，应有乡人笑夜行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日南阳与诸公会","author":"宋庠","text":"憭慄霜华六幕空，丹萸成佩菊芬丛。\n香浮彭泽仙巾酒，影落龙山宴帽风。\n诗笔娱情真泣豆，舞腰回节更惊鸿。\n夕阳峣榭愁重顾，不见舂陵旧郁葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入朝感旧","author":"宋庠","text":"二纪便蕃冒主恩，归来荣感两惊魂。\n昌辰尽见群龙出，急景俱随骇驷奔。\n史册褒贤空汗竹，山丘馀泣已陈根。\n此身不减灵光殿，遗老班中岿独存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日夜坐有感","author":"宋庠","text":"城头吹角乱昏鸦，坐敞空楼感岁华。\n遥电不知何处雨，狂风还送一年花。\n洛桥禊席随流水，箕岭仙巢倚暮霞。\n出处半生虽未决，归心常傍故侯瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久客怀故里","author":"宋庠","text":"汉枌遗产接东陂，舒啸行吟失旧期。\n岭上孤猿惊别久，山中芳草怨归迟。\n鲋波希润宁堪待，龙断求丰忍自欺。\n负郭已荒金未佩，天涯浩叹满隆墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕雨","author":"宋庠","text":"春溜檐声细，层波幕影斜。\n雷车陈后馆，云枕楚王家。\n桂凝霞杯蚁，莲空蜜炬花。\n莫漂枝上蝶，幽梦在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园春昼","author":"宋庠","text":"日永春残陋巷深，四邻萧寂小山林。\n张罗门外人惊爵，仰秣槽中马听琴。\n燕坐角巾移竹影，野谈争席占墙阴。\n灌园本是三公事，俋俋閒舒傲世心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园秋思","author":"宋庠","text":"年华摇落自骚骚，衰境牵人更畔牢。\n月里惊乌愁夜永，箧中团扇恨风高。\n烟霏曲霤蜘蛛织，气袭空阶蟋蟀号。\n恩重才疏归计晚，可怜身世一鸿毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小圃雨霁","author":"宋庠","text":"风雨残秋罢，年芳遂悄然。\n黄花沉暮蝶，苍柳啸孤蝉。\n霁日高弥淡，曛霞冷不鲜。\n忽闻双鹤唳，心断故溪田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桥","author":"宋庠","text":"野水危梁渡，凌虚一径横。\n郑车求代涉，汉棹且专行。\n濠咏观鱼乐，圯书跪履情。\n斜阳葭菼岸，鸥鸟为谁惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小疾","author":"宋庠","text":"旧疹感春阳，岑岑体正尪。\n双胧便貉睡，一息寄龟肠。\n味减轑羹釜，心疑照弩觞。\n药苗行可采，更验太清方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小隐春日","author":"宋庠","text":"小隐非吾土，幽怀属暮春。\n人忧原宪病，鬼笑子龙贫。\n草合看迷路，篁抽欲过邻。\n俗嘲慵自解，鼷弩惜千钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己巳孟春二十六日作","author":"宋庠","text":"纠缠空惊祸福频，沈舟未拯更摧轮。\n山头枉是轻廷尉，天上何容著蹇人。\n南国祭牺堪畏楚，东门猎犬尚尤秦。\n当涂莫竦支离诮，坐受朝家十束薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马上见梅花初发","author":"宋庠","text":"瞥见江南树，繁英照苑墙。\n无双春外色，第一腊前香。\n云叶遥惊目，琼枝昔断肠。\n莫吹羌坞笛，容易损孤芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五鼓度洛水谒九龙祠祷雨马上作","author":"宋庠","text":"跨陌津桥十里亭，前驺横绝犯严更。\n银河荡漾斜垂地，瑶斗阑干倒倚城。\n苑阔树头迷阙影，川长烟外认滩声。\n农畴闵雨心祈切，上尽丛祠日未明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从猎晚归马上默成奉呈承旨端明王学士","author":"宋庠","text":"天子乘冬校猎回，钩陈平野转瑶魁。\n万蹄未暮先追日，叠鼓非春已作雷。\n得俊风毛随禁仗，犒勤霞液出仙杯。\n词臣定有长杨赋，翰墨能销几许才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天禧诏罢寄王贯之","author":"宋庠","text":"裂繻无路学西游，衡木为扉恋一丘。\n阮籍自多回辙泪，虞卿长有著书愁。\n江边客素沈惊鲤，海上机心失故鸥。\n借问骚人才几许，莫因鶗鴂枉悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屯田任君数以歌诗授余感叹不足因成答赠","author":"宋庠","text":"绿发仙郎藻思新，就中诗语更通神。\n清襟逗兴初无滓，綵笔呈华别有春。\n顾我风期情背俗，感君官职命欺人。\n汤汤听尽流波曲，终愧衰聋赏未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"宋庠","text":"西峙东流意欲分，紫箫呼凤隔烟闻。\n书因屡答机无素，梦为频惊峡费云。\n羽帐枕寒晨未转，玉楼衣冷夜还薰。\n琴乌一曲何曾听，七十鸳鸯失旧群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"世事","author":"宋庠","text":"世事悠悠未遽央，虚名真意两相忘。\n休誇失马曾归塞，未省牵牛解服箱。\n四客高风轻楚汉，五君新咏弃山王。\n秋来数有渔樵梦，多在箕峰颍水旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东方欲晓","author":"宋庠","text":"乌渴催宵漏，鸡鸣引曙光。\n山西河闇淡，天北斗低昂。\n银烛香犹烬，瑶琴冷未张。\n何须开宝鉴，容鬓定苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"主荐后喧讼不已","author":"宋庠","text":"昔贲丘园聘，今嗟势利趋。\n何尝轻九九，自欲较铢铢。\n钩百劳筋败，朝三怒气粗。\n因声谢乡校，真赏愧非夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书寄奉宁枢密直谏议学士","author":"宋庠","text":"故秋尝假道，倏忽改芳年。\n三叠黄河上，千花白发边。\n冰消牛口渡，山绿虎牢天。\n东望无人会，荥阳太守贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬行西圃溪上","author":"宋庠","text":"故柳樊官圃，新禾上野场。\n晚烟林外紫，昏日水中光。\n菊晚香犹在，橙寒味不长。\n萧然成隐趣，况复近山阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬霁","author":"宋庠","text":"夜枕鸿违汉，霜天雀噪园。\n回车长者辙，曝背野人暄。\n墨溜沈寒沼，松醪湛冻樽。\n谁能穿雪履，待诏鲁班门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北台 其一","author":"宋庠","text":"远日春风外，韶光晚思前。\n短青平野树，斜碧半楼天。\n芝朮参云岭，桑麻冒蕨田。\n诗成无所况，题作咏怀篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北台","author":"宋庠","text":"古丘危磴接云梯，远目临高意自迷。\n千里绿芜平野北，半边红日乱峰西。\n台倾邺苑多残瓦，凤没漳河失故堤。\n近塞春郊无胜事，跛䍧风马满山溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北台 其二","author":"宋庠","text":"城堞俯漳湍，关河远近看。\n晓山天外紫，秋日雾中寒。\n短鬓却成葆，孤心转似丹。\n萧家穷僻地，归去养衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北亭","author":"宋庠","text":"旧壁横空苑，危亭纳夕霏。\n野虫多各韵，倦鸟忽同归。\n木落惊秋晏，人愁念昨非。\n生平嵩颍志，尚或拂尘衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北楼三首 其三","author":"宋庠","text":"危槛倚孤城，风襟俗虑醒。\n天高鸿类?，云散日如萍。\n叠巘斜衔岫，回川曲抱汀。\n骚愁千古地，椒醑吊遗灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北楼三首 其二","author":"宋庠","text":"孤堞神坰畔，平原岁琯阴。\n惊麇时易薮，倦鸟即投林。\n日舍翻车恨，天旄伏枥心。\n蓬池八十首，半是为登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北楼三首 其一","author":"宋庠","text":"地迥楼堪倚，天长日更劳。\n何须云渺渺，况自叶骚骚。\n脱兔横冈远，冥鸿避弋高。\n四愁休遍咏，俱是一沾袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北楼晚景","author":"宋庠","text":"脩曲少城偏，临秋坐眇然。\n残阳鸦翅外，新月鸟行边。\n隐轸齐侵地，苍茫鲁狩田。\n登高何必赋，归意自悁悁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去秋九日置酒今秋复喜兹会诗呈通判比部并诸幕府","author":"宋庠","text":"城上凌氛百尺台，晚秋重喜宴楼开。\n汎樽露菊疑相识，吹帽霜风是再来。\n宝瑟丁宁催客饮，丹萸烂漫辟谁灾。\n莫惊银烛先为具，天际残阳唤不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叹张縡","author":"宋庠","text":"峤外归来白发新，胸中无物有经纶。\n局当辕下骅骝足，倚著门边肮脏人。\n风雪又残梁苑岁，烟萝谁管楚山春。\n由来荣悴多如此，莫为前薪怨后薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十五日晚出溪上留连不能去","author":"宋庠","text":"偶来寻晚景，便觉涤嚣烦。\n岸柳相搀绿，风荷各自翻。\n归云何处宿，惊鹜或时喧。\n不奈沧波阔，鸠山有故源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月","author":"宋庠","text":"萧寂东轩坐，徘徊月驭来。\n风休凉晕缺，旬破晚弦开。\n紫汉沈星树，仙茎逼露杯。\n谁怜故林鹊，终夕自惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日作","author":"宋庠","text":"迎春才十日，应月已三蓂。\n池面开新素，山光复旧青。\n灰飞空玉琯，醅动涨金瓶。\n剩作寻芳具，当筵忌独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永兴端明王左丞寄示见训长句因为后答","author":"宋庠","text":"西风书驿到河津，且喜开筒丽句新。\n安石风流高映世，君房言语妙惊人。\n公怀远略须经国，我愧华颠未乞身。\n惟有论交方寸地，岁寒留得比松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永阳登楼怀阙下知己","author":"宋庠","text":"西北楼边路欲分，神皋不见见浮云。\n晋邮尺牍波中断，洛客归心笛里闻。\n丽赋有情伤桂魄，劳歌无节怨兰薰。\n汉家续食催西上，忍逐江鸥狎旧群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉上春雪呈郡太守","author":"宋庠","text":"春草江南瑞霰霏，溪山千叠共清辉。\n林繁不辨妆梅落，川秀空疑月蚌归。\n夕苑萦丛聊自舞，横塘拂水更低飞。\n民畴脉偾农祥近，壤有尧歌绝晋饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉滨北楼","author":"宋庠","text":"一水东流阔，诸峰右转深。\n蟾规欲破晕，天杵不盈寻。\n浦逗分风席，洲喧避缴禽。\n凭高机事息，并为汉川阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲戌冬属疾赐告二首 其二","author":"宋庠","text":"恩告偃衡荜，年华飞琯灰。\n右眠安佛胁，深息养仙胎。\n数犯稽违禁，谁怜游落材。\n使轺均病粟，更自冁然咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲戌冬属疾赐告二首 其一","author":"宋庠","text":"行年三十九，病脑剧中乾。\n目界空花眩，脾仓宿滓寒。\n未灯攲夕枕，欲食进朝丸。\n惟有披书乐，依稀及士安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"宋庠","text":"底处春来早，依依傍日华。\n年光随宝胜，阳律犯鸣笳。\n冰沼应潜坼，风枝已自斜。\n江南无驿骑，何计赏梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日置酒郡斋因追感三为郡六迎春矣呈坐客","author":"宋庠","text":"闰章馀历气先回，腊尾新阳已暗催。\n三改使符惊岁往，六倾宾酒驾春来。\n枝头剪綵仙葩折，胜里宜年宝字开。\n更听美人金缕曲，从兹争合舍尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春前二日嘉雪应祈呈昭文相公","author":"宋庠","text":"皇心精祷动昭回，嘉雪乘时弭岁灾。\n先作飞霙随腊舞，便含膏泽趁春来。\n天渊百顷移星汉，禁籞千枝傲岭梅。\n一曲巴人虽下里，愿持欢意助康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后一日凉风萧瑟便若感人","author":"宋庠","text":"倏忽徂炎罢，惊秋自此辰。\n残蜩空爱露，孤扇欲辞人。\n嵩少千寻岭，沧浪万里津。\n如何一乘兴，烟策弄飙轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日","author":"宋庠","text":"弥旬出沐道山头，僦庑萧萧避俊游。\n枉是胸中无块垒，可能皮里有阳秋。\n驾车款段惭乡品，托乘鸱夷笑客愁。\n曲突无烟宾坐冷，时闻庭雀一啁啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤死马","author":"宋庠","text":"辨道曾资智，嘶风忽绝音。\n故蹄休践雪，朽骨讵酬金。\n附尾谗蝇散，投鞍啮鼠侵。\n弃帷宜一报，尽力有前箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"关外","author":"宋庠","text":"关外峥嵘岁，河边寂寞洲。\n寒云能不雨，高柳强先秋。\n野静狐狸出，沙长雁鹜留。\n登临虽信美，无赋可销忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再经行庆","author":"宋庠","text":"行李才踰郑，关门已及周。\n山支抱巩合，洛尾贯河流。\n驿骑迎朱毂，封人讶白头。\n往来何太数，惭恨见嵩丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同万秀才宴杨侯别墅","author":"宋庠","text":"苑路轻骖拂晓霞，斗城南畔列侯家。\n临邛贵客倾中坐，漳水词人记后车。\n一石蒲桃先载酒，万株金谷正交花。\n风光不减兰亭会，醉墨凭君纪岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年庞汝弼赴宰临贺见过叙别因成感咏","author":"宋庠","text":"朋好日寥落，征骖那忍闻。\n先成数日恶，更负十年薰。\n客棹秋泷水，官邮暮岭云。\n图南尚良食，少作吊湘文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年胡宿自江外寄遗诗笔杂文","author":"宋庠","text":"万仞青云接翼翔，江南离思满雕章。\n轻投暗路珠无胫，骤濯迷魂玉有浆。\n奏记诸公多感慨，拟骚前哲剩凄凉。\n寄怀何止三年字，留秘传家古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后池春水初满","author":"宋庠","text":"水从云表济祠来，春冻初消旧堰开。\n岸侧浅黄先映柳，石边新绿便成苔。\n就深整顿吴歈桨，因曲安排洛禊杯。\n莫道使君无野兴，把竿常到月中回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后园新水初满坐高明台远眺","author":"宋庠","text":"济渠冰解逗奫沦，花柳兼催近郭春。\n城外天形低合野，水边楼影倒倾人。\n趁晴鱼意双游乐，助闹禽声百种新。\n老倚芳樽从外诮，且将吟啸代经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因览镜照见衰年状貌有感","author":"宋庠","text":"拂槛清晨念老馀，只堪丘壑便悬车。\n暗围廓落频移眼，坐况苍华不满梳。\n綟绶转惭龟钮印，土膏空负鹤头锄。\n人生出处真难决，羡杀贤哉汉二疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏城上北眺","author":"宋庠","text":"万汇竞摇落，临高伤旅魂。\n惊飙无定响，寒日有馀昏。\n路转平台苑，天降覆盎门。\n惓惓心未已，曷月报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏思归五首 其五","author":"宋庠","text":"世有功名羡，人将躁静殊。\n冥鸿专避弋，斗鹖喜捐躯。\n驾败谁矜巧，山移却信愚。\n白云无诮我，归意本区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏思归五首 其四","author":"宋庠","text":"颍曲多成濑，茨山亦有村。\n不知荣革履，便欲返衡门。\n邵圃瓜畴熟，陶庐菊径存。\n敢言轻宠禄，知退是酬恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏思归五首 其三","author":"宋庠","text":"昔宠尘三事，今怀念一丘。\n稻粱争鹜饱，章服裹狙愁。\n心与蘧非化，年惊赵语偷。\n欲将知止意，归谢汉恩侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏思归五首 其二","author":"宋庠","text":"碌碌真邀宠，容容谢致君。\n短凫生愧胫，狂鹿老思群。\n急节惊流水，浮名伴薄云。\n归欤堪击壤，况复值唐勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏思归五首 其一","author":"宋庠","text":"岁晏坐伊川，孤襟日惘然。\n无功堪载策，有路即妨贤。\n宠辱丹心寸，年光素发边。\n含毫虽踯躅，自欲赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晏感怀寄吴侍郎","author":"宋庠","text":"百虑静相寻，萧萧芳岁阴。\n感君辞剧日，休我冒荣心。\n历块疲东道，巢枝忆故林。\n霜毛秋更短，持底受华簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚饯客南亭二首 其二","author":"宋庠","text":"淮壤穷南界，亭皋坐渺然。\n平窥京口树，斜落海门天。\n重雾多藏日，寒潮不送船。\n江山宁有助，私作楚骚怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚饯客南亭二首 其一","author":"宋庠","text":"偶作津亭饯，还惊岁物非。\n苍葭无际合，黄叶有声飞。\n别恨随人远，乡心著酒微。\n犹欣见山色，纡辔暂忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]