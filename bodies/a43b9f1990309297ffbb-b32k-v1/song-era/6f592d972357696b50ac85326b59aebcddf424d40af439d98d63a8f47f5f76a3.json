[{"title":"羊角风","author":"刘敞","text":"我似灵鲲初化鹏，径辞北海向南溟。\n可烦更借扶摇力，已度皋兰望紫庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观梅樱桃","author":"刘敞","text":"梅花欲落樱桃盛，白雪彤霞各自愁。\n肠断黄峰与粉蝶，东园来去不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潞河","author":"刘敞","text":"饮马长城行且谣，雕鞍金勒映春朝。\n潞河正月冰都尽，不惜障泥走度桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈胜","author":"刘敞","text":"夥涉矜豪欣据陈，力崇司过督群臣。\n欲将燕雀轻天下，自使侯王不复亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客寄天台月桂子","author":"刘敞","text":"天上仙人月里栽，无端飘逐海风来。\n可能种作千寻树，岁看高花烂漫开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛卯十二月同持国游会灵观各曾赋诗后一年会灵烧高下俱尽天子为先朝所为不忍废复治集禧略放渭阳帝祠制度五岳同宇毋乏事而已不能如向之钜丽也戊戌十二月以事过谒祠下作七言寄持国","author":"刘敞","text":"白玉五城十二楼，还曾同作采真游。\n重来无复壶中景，惟见苍林锁碧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏成一首","author":"刘敞","text":"参差翠嶂坐中分，断续流泉尽日闻。\n何异高唐与巫峡，梦馀真复有朝云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗三首 其一","author":"刘敞","text":"大梁公子乐邯郸，爱士能从市井间。\n虽诧平原倾食客，鲁连犹蹈海滨还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗三首 其二","author":"刘敞","text":"季长诞节薄拘儒，俳笑纷纭绛帐居。\n为问从来三辅士，几人门下撇衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗三首 其三","author":"刘敞","text":"天禄先生空白头，时时好事载书游。\n滑稽不及鸱夷辈，寂寞端成淑德侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭城先辈未披奇采早饮隽声遗诗寄答二首 其一","author":"刘敞","text":"清门早日映朝端，俊域于今有二难。\n虹气韫来徒想玉，国香闻处已知兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭城先辈未披奇采早饮隽声遗诗寄答二首 其二","author":"刘敞","text":"剑池夜久光芒紧，梦草春深景象宽。\n寄惠新诗仍过此，濡毫容易报琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝日偶作呈友人","author":"刘敞","text":"渐知春意入城来，向午池冰已半开。\n和气满天真可望，凭君须上最高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花洞","author":"刘敞","text":"熏风四月群芳歇，火玉烧枝拂露华。\n偶坐清阴人不到，白须道士进流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔宿斋太庙闻莺二韵","author":"刘敞","text":"碧树凋零满眼秋，黄鹂飞去使人愁。\n翰林仙老斋房客，犹恨人间岁月流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题庭前药栏","author":"刘敞","text":"宿雨初晴晓尚寒，土膏欲动未全乾。\n碧萱红药饶情态，世漏春光已满栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壶公祠送别","author":"刘敞","text":"尘世纷纷多别离，一攀庭树欲沾衣。\n不知何故壶中叟，能弃人间不复归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中作","author":"刘敞","text":"空山日午东风起，积雪半消岩下池。\n逐胜不知芳草远，长谣石上失回期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净土院从王伯初饮呈座人","author":"刘敞","text":"雪满春城幽兴长，放歌起舞尽君觞。\n幸怜犀首饮无事，不怪次公醒亦狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮子华家醉翁不来因令鸾英弹醉思仙","author":"刘敞","text":"翠眉红袖拜尊前，撩弄春声入四弦。\n坐少车公还不乐，为君重奏醉思仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月下","author":"刘敞","text":"蟾蜍滴露侵石垣，松桧吟风如涧泉。\n夕梦未穷山路远，自疑乘月弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉池","author":"刘敞","text":"绿华清盖满方塘，雨洒风吹著处香。\n净埽钓矶双树下，醉攲凉枕弄秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆和","author":"刘敞","text":"楚泽茫茫白芷生，春风红树语流莺。\n高楼不见千岩路，落日空含万里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啸亭雨后","author":"刘敞","text":"风捲高花舞成雪，雨湿芳草绿侵云。\n层轩独立时惆怅，淮北春光过五分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西楚","author":"刘敞","text":"楚割淮西自不轻，元王宾客亦洪生。\n重捐醴酒迷高士，末路翻亡五千城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁本初","author":"刘敞","text":"横刀长揖紫廷中，健者宁须属董公。\n郿坞然脐直假手，始知天下有英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏文帝","author":"刘敞","text":"江水由来一带横，魏文何事畏疑城。\n不应天意分南北，自是无人敢请缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武皇","author":"刘敞","text":"武皇英气古无俦，解道平城遗朕忧。\n汗血龙媒十八万，单于台下猎清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后土庙琼花","author":"刘敞","text":"繁香簇簇三株树，冷艳飘飘六出霙。\n移植天中来几月，欲看憔悴老江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张奕进士归广德省亲","author":"刘敞","text":"南北旅游三十年，相逢依旧孝廉船。\n千钟不洎今吾老，羡尔归安二顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琼花","author":"刘敞","text":"海内无双玉蕊花，异时来自八仙家。\n鲁人得此天中树，乞与春风赏物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董相","author":"刘敞","text":"江都治后徙胶西，衰老诸侯等弃之。\n为问平津相天下，尚开东阁欲宾谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锁宿礼部中夜口号","author":"刘敞","text":"浮云不动月微明，锦帐香寒梦易惊。\n犹觉春风花未发，独闻宫漏出重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题送客亭别任迥","author":"刘敞","text":"北飞鸿雁南飞燕，扰扰俱非自在身。\n莫向孤亭南北望，野花江草最愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送魏广秘校同年","author":"刘敞","text":"羡君归著老莱衣，风雨纷纭欲别时。\n会是东堂许为友，自怜扶路不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"刘敞","text":"人生老去自多忧，索索逢春却似秋。\n过尽百花初不省，何须风雨更添愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山光寺","author":"刘敞","text":"隋家昔日歌舞地，荒草满庭烟雾深。\n犹有老松长百尺，悲风来动海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张安内翰见赠二绝 其一","author":"刘敞","text":"云鹏自合纵天池，蒿鴳宁嫌寄一枝。\n适往蚤闻仙老辨，解嘲聊慰俗人嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张安内翰见赠二绝 其二","author":"刘敞","text":"玉螭阶侧凤池边，接武严徐愧昔贤。\n天骥绝尘方万里，知君不顾绕朝鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答阮逸中允","author":"刘敞","text":"天后天先隐姓名，曾闻注易动公卿。\n穷愁不得无编述，惭愧删诗取正声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小桃","author":"刘敞","text":"鸣鸠唤雨天色变，迟日烘云花意催。\n一日出游三日醉，自知惭负小桃开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵七得屯田郎","author":"刘敞","text":"童稚闻君赋上林，校雠偏愧接华簪。\n朝廷礼乐推先进，莫叹郎潜佩肘金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄢陵兴国寺题壁","author":"刘敞","text":"寂寞空堂欲暮时，钟声断续雨千丝。\n此中会有西来意，正复庭前柏树知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"刘敞","text":"本是昌家，又为非类。\n但有雄声，唯闻艾气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出长芦口","author":"刘攽","text":"涛翻鹭羽连天白，山叠屏风到海青。\n客路浮生两如寄，万重波里一浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芍药","author":"刘敞","text":"溱洧洵吁乐，维阳厥草夭。\n传闻多失实，看尽谩无聊。\n婉娩春阳谢，中开道路遥。\n谁移化工巧，忽是物华饶。\n跗萼晴相照，芳春暖并飘。\n波翻蜀江锦，霞萃赤城标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荼蘼二首 其一","author":"刘敞","text":"琼林殿侧玉钩栏，雪覆新花四月闲。\n密影酡容千客坐，柔条何啻万龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荼蘼二首 其二","author":"刘敞","text":"明红暗紫竞芬菲，送尽东风不自知。\n占得馀香慰愁眼，百芳无得似荼蘼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木香花","author":"刘敞","text":"粉刺丛丛斗野芳，春风摇曳不成行。\n只因爱学宫妆样，分得梅花一半香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金钱花","author":"刘敞","text":"披沙百炼贵，济世五铢圜。\n侔色都疑似，颁行适自然。\n萧萧秋意早，采采露华鲜。\n贫谢侏儒甚，烦君慰眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"笋","author":"刘敞","text":"龙孙春吐一尺芽，紫锦包玉离泥沙。\n金刀璀璨截嫩节，铜钱不与大梁赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯花","author":"刘敞","text":"火中有芝，殊干连叶。\n顷刻三秀，烂其煜煜。\n孰为而生，孰为而滋。\n既富且寿，君子正之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古风","author":"刘敞","text":"子欲富矣，何用为富。\n农不苦工，工不若贾。\n子欲贵矣，何用为贵。\n德不若名，名不若势。\n粹兮纯兮，三五之人兮。\n终窭且贫兮，孰知其珍兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗 其五","author":"刘攽","text":"齐有梁丘据，晋有乐王鲋。\n据能爱晏婴，鲋欲残叔誉。\n二臣嬖两朝，事君为悦豫。\n景有尚贤志，据逆以为助。\n平失宥善心，鲋乃速其去。\n毋以据为贤，易地则同趣。\n丈夫处世间，必有遇不遇。\n岂无觉者乎，正色君亦悟。\n区区嬖幸徒，何忍就朋附。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重伤胡二","author":"刘敞","text":"今日寝门侧，涕流予不堪。\n伊人竟长逝，回使返空函。\n如觉知音绝，深怀挂剑惭。\n仍闻身后事，生女不生男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采蓝寄王深甫","author":"刘敞","text":"采采泽中蓝，制为金翠衣。\n春风为君舞，婉转有光辉。\n良辰古易失，丽色世云希。\n嗟嗟不盈掬，日暮空来归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观陕西图","author":"刘敞","text":"乘槎汉使者，聚米马将军。\n关塞他年阻，河山此座分。\n悠悠伤战骨，处处怒妖氛。\n未分儒生老，深希笔砚焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周节推移曹州","author":"刘攽","text":"珠履幕中客，行行亦倦游。\n劳歌一长铗，历聘五诸侯。\n捧檄为亲喜，问程轻旅愁。\n遥怜在陈士，无友重悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张六丈尉新安","author":"刘敞","text":"新安好江水，往复似桐庐。\n吏隐应相称，官卑还自如。\n洛尘趋走里，周俗战争馀。\n会自求知己，频飞一鹗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芷亭","author":"刘敞","text":"籍甚离骚后，芬芬楚泽滨。\n移根烦老圃，比兴得佳人。\n秀色谁与玩，清香不自珍。\n吾庐故可爱，况及物华春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚凉","author":"刘敞","text":"楚山何处雨，天气晚来凉。\n返照原野静，清风松桂香。\n高楼半云雾，远水入沧浪。\n幽意惊飞动，真凭酒散狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉同永叔于刘功曹家听杨直讲女奴弹啄木见寄之作","author":"刘敞","text":"空林多风霜霰零，啄木朝饥悲长鸣。\n口虽能呼心不平，谁弹琵琶象其声。\n雌雄切直相丁嘤，欲飞未飞皆有情。\n琵琶八十有四调，此曲独得传玄妙。\n翠鬟小女眉目殊，能承主欢供客娱。\n转关挥拨意澹如，坐人虽多旁若无。\n醉翁引觞不汝馀，歌诗弹铗归来乎。\n两君韵高尚如此，何况枥上之马渊中鱼。\n我生不晓世俗乐，顷卧江城更寂寞。\n园中有时闻啄木，虽有高下无宫角。\n木声梨然当人心，猋氏之风殆可学。\n渊明无弦非无意，白发秋来自少乐。\n得公新诗濯我愁，因问杨子更借不，我欲醉听江城楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汾州有唐大历中崇徽公主嫁回鹘时手迹在石壁上李山甫作七言诗并刻之子华永叔内翰皆继其韵亦同赋","author":"刘敞","text":"锦车西去水东流，汉节何年送解忧。\n独上青山自惆怅，强歌黄鹄少淹留。\n遗踪不逐哀笳断，丽句空增北渚愁。\n君念平城三十万，谋臣奇计已堪羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自入北界虏人候迓供帐每进益恭少尝至契丹者皆云异他日示陈副使希元","author":"刘敞","text":"和亲虽复用诸儒，圣德由来北服胡。\n天子今成大父行，匈奴自号儿单于。\n女真守燎羯圉马，渤海西道奚前驱。\n塞外始知汉使贵，留犁挠酒直区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔禁中对月","author":"刘敞","text":"珠宫银阙閟金銮，独得清辉尽夕看。\n冷夺雪霜深刺骨，瑩分毫发凛冲冠。\n通中梦觉炉香断，方底封馀玉滴乾。\n佳句冠传天上景，世人空仰白云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月初五日杜城集","author":"刘敞","text":"雪霁春容满旧都，寻春写鞚杜城隅。\n冰消流水相萦带，日出南山半有无。\n往事废兴悲故老，扁舟沿溯想江湖。\n路人应笑山公醉，此兴由来属我徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙申闰月领扬州与京师诸公别戊戌十一月受诏还阁首尾仅三年尔然原叔伯庸隐甫子奇公南清卿之翰昌言八人者皆已徂谢感之怆然作七言寄滑州正臣密学给事","author":"刘敞","text":"冠盖如云笑别时，亦知陈迹易伤悲。\n归来未似钟山醉，零落多于邺下诗。\n人事可怜驹过隙，秋风几许鬓成丝。\n何须更听山阳笛，欲近西州涕自垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集禧斋宫雨后","author":"刘敞","text":"雨馀风露似清秋，灯烛愔愔十二楼。\n高枕江湖时独往，卷帘河汉正西流。\n人间浪逐颠冥客，物外初知汗漫游。\n拂露却趋青阁路，蓬莱回顾五云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听女奴弹胡琴","author":"刘敞","text":"女奴能为马上曲，一弹一弹复一弹。\n我醉已眠都不醒，半天落月微霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭前菊花","author":"刘敞","text":"翠叶金花刮眼明，薄霜浓露倍多情。\n谁人正苦山中醉，借与繁香醒宿酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏作二首 其一","author":"刘敞","text":"仙家千载亦何长，人世空惊日月忙。\n洞里桃花莫相笑，刘郎今是老刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏作二首 其二","author":"刘敞","text":"文章落笔有谁先，坐上诗成海外传。\n明日帝京应纸贵，开帘却扇有新编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"刘敞","text":"苍茫六合外，渺莽三皇初。\n近既未必有，远亦未必无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"农父 其一","author":"刘敞","text":"入水作田，上山伐薪。\n人世几何，终岁苦贫。\n安有灵药，化为羽人。\n呼吸光景，为君外臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]