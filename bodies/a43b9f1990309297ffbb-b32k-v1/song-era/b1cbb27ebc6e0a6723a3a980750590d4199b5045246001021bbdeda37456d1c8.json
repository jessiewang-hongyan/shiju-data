[{"title":"十二月十八日海云赏山茶","author":"范成大","text":"追趁新晴管物华，马蹄松快帽檐斜。\n天南腊尽风晞雪，冰下春来水漱沙。\n已报主林催市柳，仍从掌故问山茶。\n丰年自是驩声沸，更著牙前画鼓挝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月朝开炉偶书余病归二年未能拜埽松楸曩常以此日侍先兄游洞庭并写悲感之怀","author":"范成大","text":"圃芋今年紫，篱枫昨日丹。\n开炉修故事，听雨说新寒。\n橘社重游阻，楸行再拜难。\n此时西望眼，衰涕不胜弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏吴中二灯 其二 万眼罗","author":"范成大","text":"弱骨千丝结，轻毬万锦装。\n綵云笼月魄，宝气绕星芒。\n檀点红娇小，梅妆粉细香。\n等閒三夕看，消费一年忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十三日海云摸石","author":"范成大","text":"劝耕亭上往来频，四海萍浮老病身。\n乱插山茶犹昨梦，重寻池石已残春。\n惊心岁月东流水，过眼人情一鬨尘。\n赖有贻牟堪饱饭，道逢田畯且眉伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十九日夜极冷","author":"范成大","text":"谁勒馀寒不放回，春深犹煖地炉灰。\n乡心忽向灯前动，夜雨先从竹里来。\n鶗鴂已如莺百啭，酴醾那复雪千堆。\n调糜煮药东风老，惭愧茶瓯与酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三次喜雨诗韵少伸嘉颂","author":"范成大","text":"向非贤牧政通灵，几负松陵耒耜经。\n天籁侵晨占少女，雨师连夜檄玄冥。\n作霖岂必求商野，召见谁能右汉庭。\n闻有追锋传好语，从今侧耳为君听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳日万岁池上呈程咏之提刑","author":"范成大","text":"浓春酒煖绛烟霏，涨水天平雪浪迟。\n绿岸翻鸥如北渚，红尘跃马似西池。\n麦苗剪剪尝新面，梅子双双带折枝。\n试比长安水边景，只无饥客为题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳前一日学射山万岁池故事","author":"范成大","text":"北郊征路记前回，三尺惊尘马踏开。\n新涨忽明多病眼，好风如把及时杯。\n青黄麦垄平平去，疏密桤林整整来。\n游骑不知都几许，长堤十里转轻雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元有感","author":"范成大","text":"岳树五千仞，莲花千万枝。\n宛然明月夜，非是少年时。\n已自欢悰少，那堪官绪羁。\n人言急行乐，何以且迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元观灯","author":"范成大","text":"万家罗绮竞喧阗，乐事能并在锦川。\n兰烛连衢千对烂，冰轮此夕十分圆。\n喜逢蜀国寻春日，正是摩陀供佛天。\n人物熙熙醒醉里，却思风景似当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上方寺","author":"范成大","text":"舣棹古销夏，支筇新上方。\n珠湾锁员折，冰镜沉空光。\n枫缬醉晴日，橘黄明蚤霜。\n閒门松竹径，随处有清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上沙田舍","author":"范成大","text":"更无云物起微阴，垄亩人家各好音。\n岁晚阳和归稻把，夜来霜力到枫林。\n儿童笑里丰年面，乌鸟声中落日心。\n酿秫炊粳都入手，剩拚腰脚办登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上清宫","author":"范成大","text":"历井扪参兴未阑，丹梯通处更跻攀。\n冥濛蜀道一云气，破碎岷山千髻鬟。\n但觉星辰垂地上，不知风雨满人间。\n蜗牛两角犹如梦，更说纷纷触与蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下岩","author":"范成大","text":"畴昔中岩一梦残，下岩风景亦高寒。\n峡中无处堪停棹，雨后今朝始凭阑。\n不用苦求毫相现，祇教长挂水帘看。\n山僧劝我题苍壁，坡谷前头未敢刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与正夫朋元游陈侍御园","author":"范成大","text":"沙际春风捲物华，意行聊复到君家。\n年年我是曾来客，处处梅皆旧识花。\n官减不妨诗事业，地寒犹办醉生涯。\n城中马上那知此，尘满长裾席帽斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与长文正夫游北山","author":"范成大","text":"柳岸松门胜处通，马蹄踏雾入空濛。\n春寒有力欺游子，天色无情没断鸿。\n雨脚远连山脚暗，杏梢斜倚竹梢红。\n驼裘拥鼻吾衰矣，年少犹嫌料峭风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与胡经仲陈朋元游照山堂梅数百株盛开","author":"范成大","text":"九陌缁尘满客襟，钱塘门外有园林。\n胡床住处梅无限，酒旆垂边柳未深。\n晴日暖风千里目，残山剩水一人心。\n元方伯始皆吾党，解后清游直万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与游子明同过石湖","author":"范成大","text":"契阔相逢一笑欢，当年森桂共骖鸾。\n试谈旧事醒村酒，仍趁新晴暖客鞍。\n梅粉都皴啼宿雨，柳黄不展噤春寒。\n从今鼎鼎多幽事，仍喜蛙声不在官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"习閒","author":"范成大","text":"习閒成懒懒成痴，六用都藏缩似龟。\n雪已许多犹不饮，梅今如此尚无诗。\n閒看猫暖眠毡褥，静听猧寒叫竹篱。\n寂寞无人同此意，时时惟有睡魔知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大厅后堂南窗负暄","author":"范成大","text":"万壑无声海不波，一窗油纸暮春和。\n醉眠陡觉氍毹赘，围坐翻嫌榾柮多。\n水暖玉池添漱咽，花生银海费揩摩。\n端如拥褐茅檐下，袛欠乌乌击缶歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大热泊乐温有怀商卿德称","author":"范成大","text":"暑候秋逾浊，江流晚更浑。\n瘴风如火焮，岚月似烟昏。\n城郭廪君国，山林妃子园。\n故人新判袂，得句与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大雪书怀","author":"范成大","text":"天将奇赏发清欢，畴昔登临插羽翰。\n梅下寻诗骑马滑，松梢索酒倚楼寒。\n闭门老子愁无赖，返棹归来兴已阑。\n聊掬玉尘添石鼎，自煎鱼眼破龙团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小溪县","author":"范成大","text":"刈麦千平垄，横槎一小溪。\n梓花红绽碎，粟穗绿垂低。\n村妇犹多跣，山猿遂少啼。\n东川虽已过，锦里尚云西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己丑中秋寓宿玉堂闻沈公雅大卿刘正夫户部集张园赏月走笔寄之","author":"范成大","text":"笑看收云捲雨忙，沉沉宫树纳空光。\n夜长来伴玉堂宿，天近似闻丹桂香。\n鳷鹊楼栏浮瑞气，凤凰城阙带新凉。\n遥知胜绝西园会，也忆车公对举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己丑五月被召至行在遇周畏知司直和五年前送周归弋阳韵见赠复次韵答之","author":"范成大","text":"分袂悠悠尔许年，莫嗔蓬鬓两萧然。\n酒槽不奈青春老，经笥空供白昼眠。\n暗绿千章新活计，软红三尺旧尘缘。\n相逢且作西湖客，山绕荷花舣画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巾子山又雨","author":"范成大","text":"百日篮舆困局跧，三晨泥坂兀跻攀。\n晚晴幸自垫江县，今雨奈何巾子山。\n树色于人殊漠漠，云容怜我稍班班。\n如今只忆雪溪句，乘兴而来兴尽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马当洑阻风居人云非五日或七日风不止谓之重阳信","author":"范成大","text":"拍岸回流逆上矶，枯杨折苇静相依。\n趁墟渔子晨争渡，赛庙商人晚醉归。\n重九信来风未慭，大千行遍昨俱非。\n羁愁万斛从头数，带眼今秋又减围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月复次韵","author":"范成大","text":"屋山从捲杜陵茅，门径慵芟仲蔚蒿。\n澹澹白虹风晕壮，纷纷苍狗雨云高。\n凌空累箸仙无术，半夜撞钟句谩豪。\n枵腹题诗将底用，真成兔角与龟毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌戍密印寺","author":"范成大","text":"青堆溪上水平堤，绛瓦参差半掩扉。\n我与圣公俱客寓，人传帝子尚灵威。\n胜缘龃龉三重障，志士辛勤十载归。\n花木禅房都不见，但馀蝙蝠昼群飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予寓邑中与诸子讲学巨山侄孙转示初冬书事因用韵","author":"范成大","text":"霜风几夕报初寒，蟋蟀归来已四迁。\n旧物有毡眠软暖，讲堂逢鳝馈新鲜。\n功名久已遗清老，征戍何由及晚年。\n暴客更缘贫见外，时危身老亦悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云露","author":"范成大","text":"饮少尝遭大户嗤，病中全是独醒时。\n三年鲁望自怜赋，万祀渊明真止诗。\n破戒忽传云露法，赏心仍把雪梅枝。\n一杯未问长生事，先罥蛛尘药裹丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕后连阴","author":"范成大","text":"问讯东风几日来，冷烟寒雾锁池台。\n扫空积雪翻成雨，收尽残灯未见梅。\n夜饮厌厌非老伴，春阴漠漠是愁媒。\n谁能腰鼓催花信，快打凉州百面雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕呈冲卿侍郎","author":"范成大","text":"人间胜事不常有，自古年华无重回。\n半夜飞云并行月，平明微雨拂轻埃。\n莲花正在山头发，桃树应从洞里开。\n寄语夫君急行柬，省闱看是辟书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"范成大","text":"老来百味絮沾泥，期会关身尚火驰。\n几夜乡心欹枕处，今年脚力上楼时。\n酒缸幸有乾坤大，丹鼎何忧日月迟。\n莫道神仙无可学，学仙犹胜簿书痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"范成大","text":"屋角峥嵘斗柄移，案头萧索烛花垂。\n与时消息评新药，若节春秋忆旧诗。\n饥饭困眠全体懒，风餐露宿半生痴。\n尊前现在休嫌老，最后屠苏把一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日立春感叹有作二首 其二","author":"范成大","text":"元日兼春日，閒身是老身。\n行年申直戊，交运丑支辛。\n岂敢綦安佚，聊希刮钝屯。\n童儿看书户，把笔已如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日立春感叹有作二首 其一","author":"范成大","text":"元日兼春日，霜寒又雪寒。\n并烦传菜手，同捧颂椒盘。\n叠膝稀穿履，扶头懒正冠。\n五年如此度，宁得讳衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日奉呈项丈诸生","author":"范成大","text":"节物阴涔里，人情冷淡中。\n百忧寻老大，一笑属儿童。\n雪意愁饥雀，风声入断鸿。\n新衣满闾巷，终日自西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日钟山宝公塔","author":"范成大","text":"雪后江皋未放春，老来犹驾两朱轮。\n归心历历来时路，官事驱驱病里身。\n未暇鸡窠寻古佛，且防鹤帐怨山人。\n君看王谢墩边地，今古功名一窖尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夜忆群从","author":"范成大","text":"愁里仍蒿径，閒中更荜门。\n青灯聊自照，浊酒为谁温。\n隙月知无梦，窗梅寄断魂。\n遥怜好兄弟，飘泊两江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公安渡江","author":"范成大","text":"食罢雨方作，起行泥已深。\n伴愁多楚些，吟病独吴音。\n莫怨马蹄滑，须愁蚕事侵。\n梅黄时节是，未可决晴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公退书怀","author":"范成大","text":"昨者腾章奏发仓，今兹飞檄议驱蝗。\n四无告者仅一饱，七不堪中仍百忙。\n皦日自能临俯仰，浮云宁解制行藏。\n求田问舍亦何有，岁晚倦游思故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公辨用前韵见赠复次韵","author":"范成大","text":"先生笔力玉山鳌，气压明堂一柱蒿。\n雪椀涤毫词绝妙，朱弦缩瑟调弥高。\n心兵不起无三粲，坐客常多似四豪。\n喜有过从南北巷，苏兰薪桂瀹溪毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公辨再赠复次韵","author":"范成大","text":"书生活计极萧骚，爝火微明似束蒿。\n犬子地寒徒壁立，元龙身懒谩楼高。\n笔端未办誇三绝，酒里犹能扫二豪。\n又向诗坛蕲借一，强磨铅钝齿吹毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午窗遣兴家人谋过石湖","author":"范成大","text":"云日初收破柱雷，小窗坐稳兴悠哉。\n熏炉花气朝酲解，茶鼎松风午梦回。\n谢客门阑风动竹，惜春时节雨肥梅。\n画船破浪亦一快，闻道湖光如泼醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天平先陇道中时将赴新安掾","author":"范成大","text":"霜桥冰涧净无尘，竹坞梅溪未放春。\n百叠海山乡梦熟，三年江路旅愁生。\n松楸永寄孤穷泪，泉石终收漫浪身。\n好住邻翁各安健，归来相访说情真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太上皇帝灵驾发引挽歌词六首 其六","author":"范成大","text":"文德尧新庙，威灵禹旧山。\n海门宾羽卫，地轴启云关。\n无路攀仙驾，当年拱圣颜。\n小臣衰疾泪，空望帝乡潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太上皇帝灵驾发引挽歌词六首 其五","author":"范成大","text":"帝业虽天广，皇心本谷虚。\n神应游混沌，梦不返华胥。\n挍德难涯涘，铭功总绪馀。\n谁能言大道，第入四坟书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太上皇帝灵驾发引挽歌词六首 其四","author":"范成大","text":"传圣家人礼，凝神象帝先。\n勋华今历数，汾社古山川。\n众父尊归父，中天更有天。\n寿宫何所厌，亟上白云仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太上皇帝灵驾发引挽歌词六首 其三","author":"范成大","text":"箫勺妖氛静，甄陶叶气还。\n春回慈殿驾，天作祐陵山。\n开辟风云惨，登平日月閒。\n艰难虽独瘠，寿域遍人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太上皇帝灵驾发引挽歌词六首 其二","author":"范成大","text":"自将吴津骑，谁婴泰一锋。\n旄头连夜落，京观隔江封。\n舞武三成备，书文九译重。\n修攘遗策在，嗣圣续车攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太上皇帝灵驾发引挽歌词六首 其一","author":"范成大","text":"绍运钟阳九，兴王抚半千。\n断鳌娲立极，翔凤汉中天。\n宵旰三星纪，希夷十闰年。\n声容弥宇宙，浯石不胜镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平瑞圣花","author":"范成大","text":"雪外扪参岭，烟中濯锦洲。\n密攒文杏蕊，高结綵云毬。\n百世嘉名重，三登瑞气浮。\n挽春同住夏，看到火西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太保节使赵公挽词","author":"范成大","text":"结发险艰会，捐躯跳荡功。\n鬓凋犹陛戟，心在惜韬弓。\n剑履三槐次，楼台四壁中。\n诸郎竞文武，不朽是清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴东峡口","author":"范成大","text":"水宿频欹侧，徒行又险艰。\n舟危神女峡，马瘦鬼门关。\n照夜烧畬陇，缘云种笮山。\n催成头雪白，休说鬓丝斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巴蜀人好食生蒜臭不可近顷在峤南其人好食槟榔合蛎灰扶留藤一名蒌藤食之辄昏然已而醒快三物合和唾如脓血可厌今来蜀道又为食蒜者所薰戏题","author":"范成大","text":"旅食谙殊俗，堆盘骇异闻。\n南餐灰荐蛎，巴馔菜先荤。\n幸脱蒌藤醉，还遭胡蒜熏。\n丝莼乡味好，归梦水连云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆昔","author":"范成大","text":"铅刀曾齿莫邪铦，游倦归欤雪满髯。\n柳带受风元不结，荷盘承露竟无黏。\n逢场鼓笛如灰冷，送老齑盐似蜜甜。\n留得本来真面目，行藏何假问龟占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水乡酌别但能之主管能之将过石康","author":"范成大","text":"南郭河桥市井喧，绿荷香处有江天。\n一帘梅雨炉烟外，三叠阳关烛泪前。\n马耳西风君并海，船头北渚我归田。\n后期只恐参商似，且醉金槽四十弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王仲行尚书录示近诗闻今日劝农灵岩次韵纪事","author":"范成大","text":"馆娃宫殿压云头，自昔登临隘九州。\n雪浪长风三万顷，苍烟古木二千秋。\n宾僚谁伴作诗苦，父老竞传敷政优。\n想见归骖穿夜市，月边灯火满西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王希武通判挽词二首 其一","author":"范成大","text":"当代名臣后，惟公奕世贤。\n及亲三釜养，遗子一经传。\n药石探奇字，芸香缉断编。\n堂堂今不见，尘迹自依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王季海秘监再赋成园复次韵","author":"范成大","text":"云庄风榭对东西，清暑光阴近竹迷。\n一斗正缘诗兴尽，两眉休为客愁低。\n披开豹雾寻陈迹，扫尽蛛尘看旧题。\n健往莫愁骑马滑，阑珊梅雨不成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王南卿母挽词","author":"范成大","text":"栉縰称纯孝，笄珈蚤隐忧。\n病中心已化，身外世如浮。\n闻道悲风木，谁能驻壑舟。\n佳儿行古道，足以贲潜幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长至日与同舍游北山","author":"范成大","text":"岁晚山同色，湖平雾不收。\n寒云低阁雪，佳节静供愁。\n竹柏森严立，蒲荷索莫休。\n瘦筇知脚力，政尔耐清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午新正书怀十首 其十","author":"范成大","text":"殊方节物记吾曾，海北天西一瘦藤。\n乌榄鸡槟尝老酒，酥花芋叶试新灯。\n瘴云度岭浓如墨，边雪窥窗冷欲冰。\n閒展两乡图画看，卧游何必减深登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]