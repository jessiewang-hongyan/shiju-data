[{"title":"偈颂一百零二首 其一○一","author":"释慧远","text":"来日书云节，新阳岁月更。\n泥牛光影乱，石女肚膨脝。\n迤逦蛇吞瓮，相将虎眼横。\n春风一阵至，敢与百花争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福胜寺香风堂","author":"释慧远","text":"袭袭闻天都，飘飘满衣䙔。\n高出威音前，平超楼至后。\n不堕四时春，肯与百花斗。\n鼻观岂能收，河神安可诟。\n陶然水镜空，云冷香风透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大慧禅师赞","author":"释慧远","text":"参禅阙典，学佛无功。\n破杨岐道，灭临济宗。\n直下单提，佛祖不犯令。\n掣颠掣狂，住双径峰。\n等闲拈却衲僧定命索，将错就错，名闻九重。\n阿呵呵，见也么？\n竹篦触背，失钱遭罪。\n天道不放还，骊珠绝瑕颣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不显名大檀越请偈 其二","author":"释慧远","text":"逆顺机中总是禅，在家不碍出家缘。\n庞公父子团圞坐，顿觉无生话已圜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门大师赞","author":"释慧远","text":"倒著睦州破蒲鞋，横辊雪峰烂毬子。\n鸩鸟飞空草不生，毒龙入水鱼皆死。\n单提独掇验人关，逆顺双行绝往还。\n遗烈尚馀风凛凛，至今犹有一斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木平和尚赞","author":"释慧远","text":"岳耸渊深，貌古神清。\n渴有米汁，馔无佳珍。\n龙床头卖弄草鞋两脚，御舟前突出云衲半身。\n举棹迷源兮檈索已露，移舟别水兮眼倒生筋。\n敢道不劳斤斧，夫是之谓木平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王知县求颂","author":"释慧远","text":"无一法与人，岂有二种语。\n居士门墙高，逢人恁么举。\n石梁踏断眼皮横，师子游行无伴侣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长髭和尚赞","author":"释慧远","text":"突兀神光万寻，??髭须百结。\n声冤瑞应峰前，解道红炉片雪。\n我今稽音问行踪，敢向虚空钉铁橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东阳光化士乞颂","author":"释慧远","text":"古殿烧残不记年，冷光相射斗牛寒。\n投机会有挥斤手，碧瓦朱甍翠插天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其三","author":"释慧远","text":"坐，往来凡圣如推磨。\n罢休休，相招不肯过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其一","author":"释慧远","text":"行，日午归来打八更。\n荒草里，结舌话无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其四","author":"释慧远","text":"卧，精进谁知成懒惰。\n念摩诃，不如还忍饿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其二","author":"释慧远","text":"住，和声塞断来时路。\n斗柄垂，风云常满肚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋和尚赞恭依圣上韵","author":"释慧远","text":"布袋挨开，猿啼晓月。\n海岳逃形，佛魔路绝。\n列列挈挈，翘翘杰杰。\n大机兮棒打不回头，大用兮利剑流鲜血。\n别别，出海昆崙头戴雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉皓和尚赞","author":"释慧远","text":"倒施逆用，独掇单提。\n乌飞兔走，虎骤龙驰。\n晷运推移兮日南长至，布裈不洗兮无来换替。\n从教撒土抛沙，自在碗鸣?沸。\n我今稽首楼至如来，揭谛揭谛波罗揭谛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示化士 其四","author":"释慧远","text":"拄杖生根挑不上，钵盂无底满盛归。\n净名何用空惆怅，哭罢香严也不知。\n头蓬松兮郡辨，耳卓朔兮莫窥。\n渡口船回人借问，寒山南畔石桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示禅人 其四","author":"释慧远","text":"六尘不恶机难测，三昧无声妙莫穷。\n脱体顿抛忘朕迹，瞎驴何处觅行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示僧","author":"释慧远","text":"两个童儿舁木鼓，左边打了右边舞。\n刹那变现百千般，分明示君君记取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱伯可求颂","author":"释慧远","text":"凤凰山下方求隐，摩竭城中又转身。\n星电交驰何处是，旋机倒用若为陈。\n居士门高无异说，山僧行处脱根尘。\n风作伴，月为邻，三眼摩醯笑似瞋。\n佗年策杖重倾盖，抵掌掀眉一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音大士赞","author":"释慧远","text":"大哉观世音，功德不思议。\n来说是非人，是非人便是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"志公和尚赞","author":"释慧远","text":"一据独龙冈，三朝扬圣化。\n擘破老面皮，索尽辽天价。\n当时误杀张僧繇，谁料而今转更遥。\n描不成，画不就，三个骰儿抛十九。\n一段风光何处有，曲尺剪刀并扫帚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李抚干牧牛图","author":"释慧远","text":"道是沩山水牯牛，输佗黑子却赢筹。\n不是沩山水牯牛，赢佗白子却输筹。\n黑白未分头角露，输赢不是遮头牛。\n绳已断，鼻无钩，掉尾昂头得自由。\n云山无限青青草，香水和烟细细流。\n饥时放，饱时收。\n临风轰起一声笛，回首家山万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨岐和尚赞","author":"释慧远","text":"劄杨岐，独脚寨。\n嚇临济，小厮儿。\n栗棘金圈输货价，土旷人稀卖与谁。\n只将破草鞋泥弹子，向十字街头换得眼睛三百担。\n人亦不觉，鬼也不知，噫嘻嚱，半夜归来日卓午，虚空依旧画娥眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"典午和尚赞","author":"释慧远","text":"濯锦之源，怒涛汹涌吞三峡。\n合浦之渊，巨浪腾空接五湖。\n夺双标随手便掷，考丹霞复得贤无。\n颅顶方衣，踞死心席面而饱饮鸩毒。\n雕眉象准，造湛堂虎穴而断命丧躯。\n彻黄龙三关巴鼻，脱临济十世规模。\n牛头马头出没，佛病祖病痛除。\n稽首瞎驴，非横灭族。\n水无鳞介，岩有涂毒。\n义断情忘，亲承付嘱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国清振锡桥","author":"释慧远","text":"五峰翠挼蓝，双涧声振锡。\n中有老频螺，倒吹无孔笛。\n不许行云作伴归，谁来蹋破苍苔迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金华圣者赞","author":"释慧远","text":"禦兵戈刀，斧不能斫。\n经大劫水，火不能著。\n姊夫小舅有来由，佛面猪头何处求。\n二百年来龟岭下，三山依旧水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济和尚赞","author":"释慧远","text":"吹毛未举，鲜血淋漓。\n涂毒才挝，遍界横尸。\n机如劈竹，口似鼓槌。\n二百年前江西湖南杀人放火，三千里外山东河北夺鼓搀旗。\n掀翻大海，倒坐须弥。\n青草步头行正令，白拈手里觅便宜。\n咄咄！\n小厮儿㘞，我且问你，瞎底正法眼分付阿谁？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴鸿福示众","author":"释慧远","text":"十处住山今已老，半生云水未忘机。\n今朝又作浮山梦，暗写愁肠寄与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送之书记","author":"释慧远","text":"大用现前全体是，圣凡情尽影难留。\n钵盂根底三千界，拄杖头边四百州。\n云作伴，月为俦。\n到家别有通天路，把定牢关辊绣毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨高士归蜀","author":"释慧远","text":"龙驰虎骤道何存，肯转灵丹奉至尊。\n令下家山言下准，瓢中日月掌中分。\n昔年握手登金殿，今日擎拳出禁门。\n我欲送君迷旧隐，桃源流水杏花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送惠冲禅客","author":"释慧远","text":"老冲问法如春雷，忿怒那吒挽不回。\n龙驰虎骤劈箭催，暴风狂雨山岳摧。\n我亦随分圆机应，出必取也战必胜。\n如珠走盘盘走珠，星飞电转了无馀。\n佗年呵风骂雨，巍巍独坐妙峰顶。\n伫看杀人放火，烱烱双眸烁太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香林远和尚赞","author":"释慧远","text":"十八年参甚么禅，云门奥旨要人传。\n蓦然合著大石调，斩新腊月火烧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盐官和尚赞","author":"释慧远","text":"老倒放，不会事。\n扇破觅，犀牛儿。\n尚有遗风馀烈，㗶吒哒哩嚤呢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释慧远","text":"静鞭声里驾头来，紧握双拳打不开。\n打得开，云压香尘何处是，静鞭声里驾头来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其九","author":"释慧远","text":"你爱我笊篱，我爱你木杓。\n主山才放高，案山又岌嶪。\n居士大同师，将错便就错。\n归去来兮天地宽，一对铁槌何处著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其七","author":"释慧远","text":"起模画样弄精魂，拂迹除踪更见人。\n行到水穷山尽处，满天云散月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其三","author":"释慧远","text":"良哉观世音，旋闻与声脱。\n犬吠驴鸣休未休，世出世间活鱍鱍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十五","author":"释慧远","text":"赵州狗子无佛性，石牛不怕师子吼。\n午夜云腾浪接天，海门一阵狂风扫。\n茫茫大地参玄人，眼里无筋一世贫。\n掣电机关何处讨，头角峥嵘出荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十七","author":"释慧远","text":"案头获敕令行时，阃外全提杀活机。\n回首华山孤顶望，巨灵神亦竖降旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十三","author":"释慧远","text":"雾卷云收，雷奔电烁。\n眼暗耳聋，此错彼错。\n错不错，何处著。\n去兮住兮大匆匆，寂兮寥兮活鱍鱍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十一","author":"释慧远","text":"梵志有钱时，能肥又能白。\n梵志无钱时，能瘦又能黑。\n十字街头立，被人唤作贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十七","author":"释慧远","text":"两阵交锋笑似瞋，双眉倒卓眼生筋。\n溪山云月谁为侣，南北东西绝近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十一","author":"释慧远","text":"韶阳一击最新奇，闹市门头直面提。\n倒岳倾湫全正令，电光石火去难追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十二","author":"释慧远","text":"登坛道士羽衣轻，咒力虽穷法转新。\n拇指破开天地暗，蛇头攧落鬼神惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二","author":"释慧远","text":"毗蓝园里丧佳声，分手徒劳布恶名。\n果是一文偷不得，至今虚作不良人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十三","author":"释慧远","text":"门里有，门外有，不作严平犯牛斗。\n师子嚬呻野犴鸣，抉出离娄眼里筋。\n伸一手，缩一手，重阳决定九月九。\n相唤相呼独自归，赤骨贫穷露双肘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十九","author":"释慧远","text":"塞破太虚空，关津更不通。\n文殊与网明，自西还自东。\n眉间拔剑频相顾，女子瞿昙立下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其五","author":"释慧远","text":"才拈折箭断弦弓，随手双雕落碧空。\n打鼓看来君不见，万年松在祝融峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十二","author":"释慧远","text":"尊位如何，澄潭影里探秋波。\n日面月面，铁眼铜睛安可辨。\n君不见一声霹雳兮雾罩长空，千眼顿开兮云收岳面。\n还见马师么？\n病在膏肓，切须忌口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十六","author":"释慧远","text":"唱拍相随特地新，舞衣歌版不须呈。\n云间独有箫韶曲，未肯流传取次人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其六","author":"释慧远","text":"马面驴腮无处雪，海竭山摧天地裂。\n老古锥，太孤绝。\n龟毛拂去眼中尘，兔角杖敲空里月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三","author":"释慧远","text":"十万众前无出路，冬瓜印子印何人。\n迦叶只因曾冷笑，至今陷在涅槃城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十五","author":"释慧远","text":"去若丘山重，来如一羽轻。\n去来无别路，倾盖白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十九","author":"释慧远","text":"因我得礼汝，乾坤粟粒许。\n若要除三害，无过问周处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十四","author":"释慧远","text":"短帽轻衫宫样窄，舞遍胡笳十八拍。\n曲罢酒阑犹未归，归来月色和云白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十三","author":"释慧远","text":"抟风展翅拿沧海，直取龙吞也大奇。\n八臂那吒拦得住，和声扑碎五须弥。\n风前截断，句后全提。\n高出祖师三要印，不落云门第一机。\n噫！\n卢陂卢陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其七","author":"释慧远","text":"闹处莫出头，冷地著眼看。\n明暗不相干，彼此分一半。\n一种作贵人，教谁卖柴炭。\n向你道，不可毁，不可赞，体若虚空没涯岸。\n相唤相呼归去来，记取明年正月半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其六","author":"释慧远","text":"好是仲春渐暖，那堪寒食清明。\n万叠云山耸翠，一天风月为邻。\n在处华红柳绿，湖天浪稳风平。\n山禽枝上语谆谆，再三琐琐碎碎，嘱付叮叮咛咛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其四","author":"释慧远","text":"自小出家，横草不拈，竖草不把。\n路转山回君自看，南不龟头北不厦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其一","author":"释慧远","text":"道绝名言，法离闻见。\n打破虚空，成七八片。\n直饶锢鏴完全，也是由基副箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十七","author":"释慧远","text":"如是如是，脑门著地。\n不是不是，叉手长跪。\n是与不是，转无巴鼻。\n北人运至南方，货易获其厚利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十四","author":"释慧远","text":"咄咄牯牛儿，森森头角露。\n恣贪肥腻草，胀杀娘生肚。\n忆昔未离群，已作牛王步。\n今既离群去，触讳没回互。\n没回互病最堪忧，灌澉依前是好牛。\n有时喜，未跨门栏先撒?。\n有时瞋，掉尾昂头不顾人。\n有时好，舌端揽尽千峰草。\n有时恶，掣断鼻头双服索。\n而今风和日暖，江南江北去何之，伫看深耕浅种拖犁拽杷正当时。\n稍乖角，觅便宜。\n老夫不惜操刀手，生捉归来活剥皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十四","author":"释慧远","text":"直下犹难会，寻言转更赊。\n若论佛与祖，特地隔天涯。\n看看，普济拄杖子，化作天龙夜叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○四","author":"释慧远","text":"学道如学射，久久自中的。\n一句透天关，万机俱丧迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十八","author":"释慧远","text":"年年腊月三十日，家家门首钉桃符。\n苦菜澹齑随分有，残杯冷炙阿谁无。\n大丈夫，德不孤，醋酸不用挂葫芦。\n收白牯，放狸奴。\n地碓舂粳光似玉，沙瓶煮豆软如酥。\n穷鬼子嘴，卢都一饱，但知忘百念，更有何人得似渠。\n从此华山图籍上，更添潘阆倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十八","author":"释慧远","text":"元正启祚旧时事，万物咸新今日春。\n自是天机超妙化，何须更捋鬼头巾。\n攀北斗，倚南辰，唱拍相随特地新。\n引得水轮风轮火轮金轮相磨俱不动，执持世界等空手，面皮厚三寸，眉毛重八斤。\n有时无事倚门立，十字街头等个人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○○","author":"释慧远","text":"三世诸佛转法轮，一大藏教说不尽。\n象骨当机正令行，玄沙见机行正令。\n或说或听闻不闻，电卷星飞谁与论。\n拨转那边关捩子，眉毛留得数茎有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十四","author":"释慧远","text":"迦叶不闻闻，如来无说说。\n父子不相传，神仙无秘诀。\n君不见谢豹花开雨后春，杜鹃啼破梢头月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]