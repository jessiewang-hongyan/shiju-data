[{"title":"净远亭午望二首 其二","author":"杨万里","text":"竹径殊疏欠补栽，兰芽欲吐未全开。\n初暄乍冷飞犹倦，一蝶新从底处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净远亭午望二首 其一","author":"杨万里","text":"城外春光染远山，池中嫩水涨微澜。\n回身小却深檐里，野鸭双浮欲近栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净远亭晚望","author":"杨万里","text":"鸂鶒娇红野鸭青，为人浮没为人鸣。\n忽闻风起仍波起，乃是飞声与落声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧治斋夜坐","author":"杨万里","text":"今年一雪遍江淮，半月晴光冻不开。\n孤坐郡斋人寂寂，一枝红烛两瓶梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧治斋盆池","author":"杨万里","text":"旧来菰叶已全衰，旋买新荷带藕栽。\n看得荷花作莲子，可怜时节被花催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丁端叔菊花","author":"杨万里","text":"忽忽还重九，匆匆又岁华。\n不妨将白发，剩与插黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子上弟春雹","author":"杨万里","text":"雹子何孤竹屋声，只于花事较无情。\n青春已在残红里，更著渠侬何似生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元举叔见谢载酒之韵二首 其二","author":"杨万里","text":"南溪溪北北山边，风月公何得独专。\n挈榼惭无桑落酒，赠诗如得汉阴鳊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元举叔见谢载酒之韵二首 其一","author":"杨万里","text":"雪久自消犹半在，雨来正密更无休。\n硬黄字里真添瘦，重碧杯中且避愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和冯倅投赠韵二首 其二","author":"杨万里","text":"茧纸松煤细作行，两诗字字可珍藏。\n书生伎俩成何事，只博虚名万古香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和冯倅投赠韵二首 其一","author":"杨万里","text":"先生弹铗冻吟时，此岂求他一世知。\n只怨送穷穷不去，元来却不怨工诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良分送柚花沉三首 其三","author":"杨万里","text":"鹤骨龙筋金玉相，诗人十袭几年藏。\n已惊好手夺天巧，更遣馀芬恼楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良分送柚花沉三首 其二","author":"杨万里","text":"锯沉百叠糁琼英，一日三薰更九烝。\n却悔香成太清绝，龙涎生妒木犀憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良催看黄才叔秀才南园牡丹","author":"杨万里","text":"愁雨留花花已阑，作晴犹喜两朝寒。\n山城春事无多子，可缓黄园探牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴监丞景雪中湖上访梅四首 其四","author":"杨万里","text":"闻君踏雪访梅花，不怕苏堤十里赊。\n老子怯寒那敢出，地炉榾柮是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴监丞景雪中湖上访梅四首 其三","author":"杨万里","text":"雪与梅花两逼真，不知谁好复谁新。\n无端更入吴融手，剪取西湖半段春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴监丞景雪中湖上访梅四首 其二","author":"杨万里","text":"七字全胜五字城，清于庾信及钟嵘。\n君诗妙绝端何似，不似梅花似么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴监丞景雪中湖上访梅四首 其一","author":"杨万里","text":"朔风敢傍贵人严，约束天花莫入檐。\n药玉船宽初潋潋，销金帐暖政厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其八","author":"杨万里","text":"横斜影里惜花残，忘却人间一鼠肝。\n莫怨梅残看不足，请君明岁早来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其六","author":"杨万里","text":"约斋句子已清圜，更赋梅花分外妍。\n不饮销金传玉手，却来齧雪耸诗肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其十","author":"杨万里","text":"老子年来不愿馀，祇惭霜鬓入金铺。\n故山自有梅千树，梦绕横枝撚断须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其四","author":"杨万里","text":"淡淡梅花不要装，真珠楼阁水精乡。\n骚人词客犹愁冷，紫蝶黄蜂更敢忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其三","author":"杨万里","text":"不是春光不早回，却缘春雪勒疏梅。\n诗人纵有催花手，有雪堪推花只推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其七","author":"杨万里","text":"道是梅兄不解琴，南枝风雪自成音。\n玉绳低后金盆落，独与此君谈此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其九","author":"杨万里","text":"要与梅花巧斗新，恨无诗句敌黄陈。\n约斋诗好人仍好，不怕梅花赛却人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其二","author":"杨万里","text":"道山堂后数株梅，为底偏于雨里开。\n到得晴来无一朵，乱飞白雪点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其五","author":"杨万里","text":"东皇岁岁驾苍龙，只许仙妃万玉从。\n天上冰霜清入骨，人间桃李若为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梅诗十绝句 其一","author":"杨万里","text":"今岁柴车总未巾，孤山龙井不曾行。\n老无半点看花意，遮莫明朝雨及晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其七","author":"杨万里","text":"湖边花底旧论诗，再要寻盟今若为。\n道是莺啼无点泪，教莺闻此也垂洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其二","author":"杨万里","text":"古来官职妒诗篇，二物双违不肯全。\n君被诗篇折官职，如何又寄一新编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其五","author":"杨万里","text":"问讯南湖作么生，日撞金玉奏英茎。\n无人打杀净饭子，放出渠头七步行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其四","author":"杨万里","text":"金华不敢比东坡，此后东坡尔许多。\n扰扰胸中百周孔，不愁柳柳笑人何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其八","author":"杨万里","text":"断当湖山我与公，问公别后却谁同。\n一生海内金石友，万事人间牛马风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其三","author":"杨万里","text":"与子相望天一方，有书无使倩谁将。\n归鸿欲下还飞去，不作书邮有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其一","author":"杨万里","text":"约斋太瘦古仙真，寄我诗篇字字新。\n受业陈三能几日，无端参换谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张寺丞功父八绝句 其六","author":"杨万里","text":"新岁南湖春又浓，海棠旧入我诗中。\n别来若有相思字，寄与江西花信风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张倅子仪送鞓红魏紫崇宁红醉西施四种牡丹二首 其二","author":"杨万里","text":"洛花移种到松江，国色天香内样妆。\n老里懒边无好思，为渠觅句却穷忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张倅子仪送鞓红魏紫崇宁红醉西施四种牡丹二首 其一","author":"杨万里","text":"朱墨勾添眼底尘，今年春尽不知春。\n鞓红魏紫能相访，西子崇宁更可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其十","author":"杨万里","text":"台家搜遍北山莱，倾国如君不用媒。\n次第幽人出空谷，鹤书即傍日边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其六","author":"杨万里","text":"不随俗子作蝇营，深入书林寄此生。\n已与杜郎争笔阵，更传侯喜有诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其九","author":"杨万里","text":"学成不必要心斋，眼到前脩脚自偕。\n挽住春风还独笑，更无一物可装怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其八","author":"杨万里","text":"老夫端欲买江天，抹月批风咽圣贤。\n他日君来相问当，南溪溪北北山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其七","author":"杨万里","text":"漏黄官柳已垂墙，针水公畦未种秧。\n多谢诗人来得得，踏开三径雨中荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其二","author":"杨万里","text":"向来一别十番秋，消息中间风马牛。\n只道故人霄汉去，不应林壑小淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其四","author":"杨万里","text":"我自穷愁坐缀文，何堪见子可怜生。\n两穷政好同诗社，一战犹须倩酒兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其三","author":"杨万里","text":"谁云涸辙困波臣，合脱青鞋立缙绅。\n寄与有司高著眼，后来文格待渠新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张器先十绝 其五","author":"杨万里","text":"散尽千金买尽书，短檠雨夜趁三馀。\n相如自倚多文富，不问家无担石储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其八","author":"杨万里","text":"南丰每见每津津，茧纸松煤幻好春。\n幸与李侯成二妙，更添杨子作三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其七","author":"杨万里","text":"谪仙下笔不曾休，句似金盘柘弹流。\n我欲将渠卜邻著，对披蓑笠刺渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其六","author":"杨万里","text":"守臣闵雨几曾欣，两月天高叫不闻。\n黄纸带将今雨至，分明端为圣明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其五","author":"杨万里","text":"苏湖元以水为乡，春早偏欺润与常。\n一雨忽来三昼夜，两公卷入八诗章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其四","author":"杨万里","text":"梦中檐溜作滩声，幼竹新荷总解鸣。\n晓色满城浑是喜，更无一寸旱时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其三","author":"杨万里","text":"雨早些时打麦残，雨迟许日即秧乾。\n阿谁会得天公意，只道今年乞雨难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其二","author":"杨万里","text":"尘涨街头不识泥，朝来也解滑霜蹄。\n两公玉句惊风雨，把玩都忘日脚西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李子寿通判曾庆祖判院投赠喜雨口号八首 其一","author":"杨万里","text":"雷起嘉山半点苍，乖龙无地著身藏。\n莫嫌白雨来差晚，但遣黄云作大穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟秋怀五绝句 其一","author":"杨万里","text":"漫浪归来岁又秋，依然风月替人愁。\n奉酬只么随缘句，懒更雕肝与探钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟秋怀五绝句 其四","author":"杨万里","text":"缀玉联珠辱见投，要知词客解悲秋。\n侬家幸自无烦恼，却被新诗嫁许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟秋怀五绝句 其三","author":"杨万里","text":"小立南溪暮未还，略容老子照衰颜。\n颇惊暝色来天外，未必秋声在树间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟秋怀五绝句 其二","author":"杨万里","text":"双井无人后山死，只今谁子定传灯。\n老夫言语浑无味，不但秋来面可憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟秋怀五绝句 其五","author":"杨万里","text":"夜把新诗百遍开，句如红药与苍苔。\n如何作许无端甚，押尽车斜始送来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲容春日二绝句 其二","author":"杨万里","text":"端忧更贫病，不分又花时。\n只说春何好，犹堪入小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲容春日二绝句 其一","author":"杨万里","text":"春半花全退，诗人尚道迟。\n惟应读书苦，声调作吾伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和严州添倅赵彦先寄四绝句 其三","author":"杨万里","text":"昌歜佳辰风自南，黄梅酿出雨鬖鬖。\n绮琴绣段能分似，报不如仪独不惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和严州添倅赵彦先寄四绝句 其一","author":"杨万里","text":"不见王孙今九春，新词丽曲爽心神。\n只言风月平分破，却是江湖一散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和严州添倅赵彦先寄四绝句 其二","author":"杨万里","text":"自抟苍壁自抄书，雪乳一瓯香一炉。\n有得俸钱无吏责，如公官况世间无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和严州添倅赵彦先寄四绝句 其四","author":"杨万里","text":"雏凤今年又一鸣，芝兰秀发不曾停。\n州前争探黄金榜，却报城隅最冷厅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范至能参政寄二绝句 其二","author":"杨万里","text":"梦中相见慰相思，玉立长身漆点髭。\n不遣紫宸朝补衮，却教雪屋夜哦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范至能参政寄二绝句 其一","author":"杨万里","text":"生憎雁鹜只盈前，忽览新诗意豁然。\n锦字展来看未足，玉虫挑尽不成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和侯彦周知县招饮","author":"杨万里","text":"乘兴山阴更灞桥，人间此事久寥寥。\n客心也欲将归去，小为故人留一宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和段季承左藏惠四绝句 其三","author":"杨万里","text":"道是诗坛万丈高，端能办却一生劳。\n阿谁不识珠将玉，若个关渠风更骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和段季承左藏惠四绝句 其四","author":"杨万里","text":"四诗赠我尽新奇，万象从君听指麾。\n流水落花春寂寞，小风淡日燕差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和段季承左藏惠四绝句 其一","author":"杨万里","text":"个个诗家各筑坛，一家横割一江山。\n祇知轻薄唐将晚，更解攀翻晋以还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和段季承左藏惠四绝句 其二","author":"杨万里","text":"遮莫蟠胸书似山，更饶落笔语如泉。\n阴何绝倒无人怨，却怨渠侬秘不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和皇太子雨中赏梅偶成二首 其二","author":"杨万里","text":"玉渊堂下一梢长，倚赖春风压众芳。\n妙句忽从天上落，千花从此总无香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和皇太子雨中赏梅偶成二首 其一","author":"杨万里","text":"日到青宫分外长，梅兼白雪一时芳。\n储皇更著琼瑶句，句里天葩别样香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和皇太子梅诗二首 其二","author":"杨万里","text":"梅仙踏雪步生尘，储后梅诗雪共新。\n玉句金章云锦字，问天觅得隔年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]