[{"title":"菊","author":"赵蕃","text":"蔓菊伶俜不自持，细香仍著野风吹。\n少年踊跃岂复梦，明日萧条休更悲。\n潭水解令胡广寿，夕英何补屈原饥。\n我今漫学浔阳隐，晚立寄怀空有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊残有感","author":"赵蕃","text":"病骨支寒政觉难，莫惊蒲柳望秋残。\n凄凉不但叹荒菊，寂寞更堪伤败兰。\n有鬓已霜那得制，无英可落若为餐。\n玉山禾远竹迟实，天骥长饥愁凤鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒赵文鼎墓","author":"赵蕃","text":"君卧青山久，余今白发新。\n秋风对摇落，旧事入悲辛。\n此世宁长世，吾身岂久身。\n萧萧闻鹤夜，耿耿待鸡晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒孺子祠 其一","author":"赵蕃","text":"务创西都弊，宁知此一时。\n忠邪争愤嫉，基业竟陵迟。\n岂曰忘五就，哀哉逢百罹。\n严陵亦同趣，始盛及终衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴城外作","author":"赵蕃","text":"风动云昏月，橹鸣鸥避船。\n秋清生既夕，客意怯幽眠。\n滞尔江行驶，病余人事牵。\n府公仍仲举，白屋定谁贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐山寺梁昭明题额","author":"赵蕃","text":"山深不知暑，五月冷如冰。\n寂寞前朝寺，风流帝子能。\n田荒空野水，树老半枯藤。\n不尽怀人兴，钟楼日暮登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中四诗 其四","author":"赵蕃","text":"疫疠潜攘却，埃氛一洗苏。\n相看即阳复，何必待傩驱。\n未暇议薪水，且同歌裤襦。\n有年如再得，卒岁可无虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中四诗 其二","author":"赵蕃","text":"茅檐元未觉，竹瓦偶先知。\n被冷浑忘寐，窗明得屡窥。\n鸡鸣因误早，犬吠极惊疑。\n我亦胡为者，侵寒要索诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中四诗 其一","author":"赵蕃","text":"岁既遭连旱，天恩锡屡丰。\n匪霜伊作雪，因燠遂成风。\n信岂朝夕际，谁云反覆中。\n寒厅苦无事，冷语却惭工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中用俞克晦丈公择唱酬之韵呈克晦","author":"赵蕃","text":"幽雀徐行破绿苔，不嫌寂静肯频来。\n款门不是才因竹，琢句何妨更有梅。\n要作灞桥冲雪去，恐成剡曲棹舟回。\n寄声闲止老居士，好对春风酌冻醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中寄怀公昭丈","author":"赵蕃","text":"问讯先生江上村，雪中高兴与谁论。\n乍明不厌鸡啼昼，忽散应憎鹊踏翻。\n闻道为梅新作圃，更期因竹别开门。\n老来孰愈幽居趣，愧我飘流不自存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后二首 其二","author":"赵蕃","text":"麦茁犹藏绿，梅苞尚掩红。\n祇言晴作病，何意雪争功。\n拥褐朝慵起，扶藜晚渐通。\n林行语鸦舅，溪立漾凫翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后二首 其一","author":"赵蕃","text":"幽径朝披雪，寒村晚对晴。\n眼边多意属，诗里欠天成。\n一宦犹赊禄，多田肯借耕。\n邻家竞春务，客子动羁情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后三首 其三","author":"赵蕃","text":"一雪岂戏我，顿晴还起予。\n寺逢东野古，梅误北枝疏。\n发兴清无极，深行画不如。\n冰泥渐融释，却恐污衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后三首 其二","author":"赵蕃","text":"阴巘犹施白，朝林已沐青。\n坠乌飞蔌蔌，射日粲荧荧。\n便恐归无迹，聊须记所经。\n耳声并目色，佳处若为形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后三首 其一","author":"赵蕃","text":"松竹夜枕听，窗扉朝起看。\n虽成见睍喜，敢废履冰难。\n照映形知秽，嘘呵诗故寒。\n要能穷极览，安得振飞翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪多矣岂窭人歉岁之所宜哉复用韵呈沅陵丈","author":"赵蕃","text":"雪已伤多尚积阴，风仍助虐屡号林。\n市人祇喜青帘近，木食应悲黄独深。\n不但茅茨忧冻死，更闻巢穴作哀音。\n此诗萧瑟谁能听，有愧当年寒地吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪既未已霰且间作再用林字韵呈在伯沅陵并属德章","author":"赵蕃","text":"云物昏然尚压阴，霰声琤若更过林。\n凭陵竹叶淡仍薄，埋没梅花幽更深。\n屡枉高辞成楚调，独怜晚岁欲南音。\n勿多扰扰求周孔，欠一躬耕梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴","author":"赵蕃","text":"启户犹飞雪，披衣忽报晴。\n慵为踞炉坐，喜作出门行。\n草冻袍争色，梅残玉堕英。\n未能忧旱苦，聊复快诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄昏骤寒","author":"赵蕃","text":"过午风犹怒，及昏寒骤增。\n衣皆袷无絮，被只楮非缯。\n所赋端如此，谁令病不胜。\n更怜馀习在，挟册自篝灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜公择之归兼怀子崧三首 其三","author":"赵蕃","text":"建德老斯立，近来双鲤鱼。\n殷勤数称子，交友未惭予。\n多病谁如我，微官政浼渠。\n吾君方锐治，何乃缓徵车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜公择之归兼怀子崧三首 其二","author":"赵蕃","text":"子去吾谁与，诸孙共此悲。\n几经行役苦，还读寄来诗。\n事要规摹立，宁忧寒饿为。\n安知造物意，于尔不吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜公择之归兼怀子崧三首 其一","author":"赵蕃","text":"曾因避仇去，竟作倦游归。\n梅蕊经青眼，缁尘染素衣。\n湖山新有得，岁月旧成非。\n小定能来否，柴关夜启扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜见周司法和诗有赠仍用元韵","author":"赵蕃","text":"路绝岭梅赠，江摇沅茝春。\n敢云倾盖故，喜甚诵诗新。\n刀笔非吾事，文章可致身。\n江陵法曹掾，宁久滞斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜俞玉汝见过","author":"赵蕃","text":"秋风起我友朋思，倚树谈君语未移。\n祇道穷年上湖海，那知今日会茅茨。\n病多止酒家无酿，贫乏赢粮甑罕炊。\n作底勤渠相劳苦，倒囊共出别来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪投王守","author":"赵蕃","text":"千骑朝祈仙佛祠，玉花夜散答诚思。\n守惟民虑知何德，天不人违固可知。\n拟效联诗家契阔，念将乘兴体清羸。\n歌呼且与邻翁醉，乐我邦君政不疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴","author":"赵蕃","text":"地虽湖北稻为乡，岁比曾微一报穰。\n望望雨晴求屡告，欣欣守尉德俱良。\n共期负笼争晴割，敢爱当檠滴夜凉。\n更拟年丰酒初贱，钩藤免饮涩如棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富阳道中遇风感叹作","author":"赵蕃","text":"回首江山旧，他年来往频。\n人谁无一饱，汝独值多辛。\n泛泛将何往，悠悠愧此身。\n怀哉松与菊，白露及时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食前一日发黄堰明日抵定誇连日逆风吹沙不可渡湖","author":"赵蕃","text":"故人留我过寒食，意重宁同所历家。\n苦信长年贪道里，翻成五日滞风沙。\n拟从塔上占铃语，又见云间起炮车。\n立遍津头无数柳，乱丝频摆失栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食前一日伯永相约过陈氏茅轩蕃亦载酒共往与者常宁尉曹明叔伯和蕃赋诗","author":"赵蕃","text":"茅轩临水自谁开，况有荼蘼玉作堆。\n佳节愁孤一百五，可人共约两三杯。\n轻雷淡雨林间过，落日清风座上催。\n更喜经行远城市，不妨杖屦晚方回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓舍书怀","author":"赵蕃","text":"还乡一过年，借屋两成迁。\n旧阁爱晚碧，今居因地偏。\n居然阙生理，复尔办行缠。\n四十今如此，修名后若传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓舍遭雨漏甚","author":"赵蕃","text":"无计补天漏，宁关以瓦为。\n昼居衣数燎，宵卧枕频移。\n愦闷长凭酒，穷愁更有诗。\n何须偻句问，可向穴居知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散庵即事","author":"赵蕃","text":"屋冷频添火，窗深远炷香。\n荆榛白堕境，杖履黑甜乡。\n晚日谁云短，閒身得暂长。\n畏人成免俗，治药屡传方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯远徐兄携李丈子永去冬江上诗卷来成四十字寄李","author":"赵蕃","text":"建邺复当涂，征行岁又徂。\n青山奠椒桂，白鹭泊菰蒲。\n人物豪三国，文章到两都。\n因君俾传诵，使我不枝梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴晚立田间二首 其二","author":"赵蕃","text":"负稻赪肩已，腰镰裹饭归。\n犬能迎别径，儿亦候幽扉。\n共说去年熟，却愁今岁饥。\n及閒还治圃，促妇更鸣机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴晚立田间二首 其一","author":"赵蕃","text":"落日明深坞，微流咽断桥。\n牛童肩滞穗，汲妇抱遗樵。\n谁谓居田贱，殊胜处富骄。\n归哉各其所，吾亦饫吾瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑甚有怀山居","author":"赵蕃","text":"风不能清友病人，睡常忘起更疲神。\n世间自有宽凉处，胸次休怀偪仄嗔。\n腕倦不胜持羽扇，头童端欲垫纶巾。\n归欤旧隐连脩竹，幽鸟窥檐席有尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾郢州携和诗见过次韵谢之","author":"赵蕃","text":"家世风流翰墨林，政和佛祖务传心。\n浮辞肯作齐梁体，古调直谐韶濩音。\n入社敢期陪唱属，赠言从此得参寻。\n惠然更辱高轩过，不问春溪绿涨深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾耆英自太和携所录谢民师观妙诗文副以长句见惠次韵酬答","author":"赵蕃","text":"别时黄落问山风，见日清霜鸣哑钟。\n二谢有诗皆可诵，七言兼与见传宗。\n举幡故异司隶救，右袒徒闻吕氏从。\n君独凄凉能过我，逢迎敢作谬为恭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾耆英录先提举著述及屠龙禾谱与先世志文见贶副以长句次韵为谢","author":"赵蕃","text":"试用初如江发源，斯人欠使百其年。\n有孙解保书如束，过我不嫌寒乏毡。\n郡守旧闻曾奏疏，乡人今日有经筵。\n纵云录后有前例，循吏艺文应并编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"植梅一株于厅事之后招丞及明叔同观倪严二先辈送酒陈簿送茶因以成集","author":"赵蕃","text":"有竹似吾家，无梅觉欠花。\n移将香索莫，来伴绿交加。\n好事适馈酒，诗情仍得茶。\n相过况非远，胜处莫令赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游太平寺","author":"赵蕃","text":"一水萦纡渡，千松高下栽。\n童师空有塔，皖伯已无台。\n似为寻山至，那因问法来。\n茶香从汝供，诗味遣谁陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游石壁寺怀禅月","author":"赵蕃","text":"一棹夷犹石壁来，寺门杂树向溪开。\n七言粗可供诗本，十幅谁能致袜材。\n想见高情澹云水，未嗟陈迹掩莓苔。\n倦游到处浑如昔，欲住还成破雨回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游齐山","author":"赵蕃","text":"借马访齐山，奔行不待衔。\n旧来闻若渴，今日嗜如馋。\n故喜地殊胜，却嫌僧近凡。\n谁能一除洗，更出万嵌岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游妙香院","author":"赵蕃","text":"说似桃花寺，逢人举旧题。\n山门循古磴，阁槛枕清溪。\n三老催人去，孤筇得暂携。\n龟峰仍不远，触热未能跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游宋衡送示登明录诗卷次韵并呈同赋诸公","author":"赵蕃","text":"赤气排空势且然，簿书何急又堆前。\n忽来疏雨微云句，置以清冰寒露边。\n想见坐中皆玉雪，更知眼界足风烟。\n虽然此乐宜输我，公等谈经合细旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游茶山广教寺","author":"赵蕃","text":"在昔鸿渐宅，当年东野诗。\n两贤虽可象，二士岂难追。\n汩汩泉鸣谷，青青竹守墀。\n平生志独往，晚岁敢乖期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游浮洲寺","author":"赵蕃","text":"久客浑忘赖，群山得细看。\n身如悟浮没，诗喜助波澜。\n塑象观殊诡，作钟怀叛干。\n东湖空壮丽，芝岭漫林峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游彰法寺打擢秀阁诗以行","author":"赵蕃","text":"四海擢秀阁，兹晨彰法游。\n名随寺俱徙，地入道家流。\n尚喜黄诗在，仍容墨本求。\n从今茅屋底，自有皖山幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游管历院用乔子迁韵","author":"赵蕃","text":"北沙一勺浅沙泉，三日弯跧厌客船。\n指似殿楼知有寺，经行陂泊见多田。\n清泉方斛快新浴，草屦葛衣便晚天。\n阅遍题名重惆怅，越州何许但云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖州亲旧 其一","author":"赵蕃","text":"去住两无由，终成上客舟。\n香如添酒病，雨亦带离愁。\n两岸青青柳，空江点点鸥。\n总堪添鬓白，不必问春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖州亲旧 其二","author":"赵蕃","text":"搔首对青波，萧萧半欲皤。\n不关年运迫，政为别离多。\n落魄空长恨，飘零谩短歌。\n残春与倦客，已矣更如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖州赠刘二弟兼呈伯瑞昆仲二首 其二","author":"赵蕃","text":"流落又穷岁，漂零悲此生。\n诗才元自窘，日近转销声。\n后会未可必，离怀空作惊。\n平生愿交意，为我谢诸兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖州赠刘二弟兼呈伯瑞昆仲二首 其一","author":"赵蕃","text":"人物称吾弟，空疏愧老兄。\n别来书更数，相见眼增明。\n行李虽亡恙，艰危实饱更。\n到家春已动，政可及农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖洲赠别刘叔骥昆仲","author":"赵蕃","text":"吴楚相望信不通，谩凭双眼送归鸿。\n岂知留落江湖外，又得从容笑语同。\n剩把诗篇摅别恨，莫辜杯酒对秋风。\n明朝径问吴松路，恨不与君俱短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琛卿坐上作","author":"赵蕃","text":"负郭有佳处，昔时来未曾。\n梅高居竹表，石瘦倚兰层。\n置酒能要我，哦诗更得朋。\n醉挥君勿怪，明日吊溪藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登李叔器家见一亭","author":"赵蕃","text":"别驾当年蚤见几，郎君久亦弃文闱。\n闭门幽径滋苍藓，杖策高亭接翠微。\n试问丘园返初服，定胜风雨盖征衣。\n一官政为饥寒计，未免饥寒故不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登清音堂访介庵壁间留题已有漫去之者偶成长句","author":"赵蕃","text":"十日溪行雨雾深，晓晴催我强登临。\n壁间变灭龙蛇字，海内流传金玉音。\n欲为废兴聊下语，不堪山水感人心。\n何时遂此扁舟志，占断鸥波得细吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登愚卿无尽藏再用韵呈愚卿","author":"赵蕃","text":"白云故绕青原寺，青竹深藏白鹭洲。\n物外未能穷往迹，眼中欣复对诗流。\n功名邂逅何嗟晚，岁月侵寻直漫遒。\n拟尽崎岖仍窈窕，几时扶策更挐舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程士和和诗送酒复用韵","author":"赵蕃","text":"半夜诗成疾置看，甚思走笔退知难。\n我如枫叶非关伐，君比梅花不带酸。\n岂是独醒羞众醉，政由尚白惧朱丹。\n一尊重辱相料理，不尔何缘罄一欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程季仪沈俭夫携酒见饯于湘中馆借用季仪所次五峰先生旧韵见怀之作","author":"赵蕃","text":"拟和题诗略未成，卒然风雨暗前津。\n高秋政应凉如水，馀溽胡为暖似春。\n载酒肯来真好事，舣舟聊为驻行人。\n异时怀玉山前过，一访耕桑老病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程阁学知建宁府入对二首 其二","author":"赵蕃","text":"湖山十里芰荷香，稳送朝天一夜航。\n前席固应思见贾，留行政不待徵黄。\n悬知笔下三千字，小试囊中一二方。\n自笑侯芭今白首，弹冠何敢企王阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程阁学知建宁府入对二首 其一","author":"赵蕃","text":"日边飞下诏黄新，大府潜藩属老成。\n一代儒宗还北阙，十年法从对延英。\n从容定有回天力，咫尺重闻曳履声。\n便觉儿童语音好，谢公今起慰苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗前葵萱皆吐花成诗二首 其二","author":"赵蕃","text":"落去梅堪裹，乍开台更重。\n老怀非我独，幽质为谁容。\n短发簪犹惜，高轩咏可供。\n还愁早衰歇，无以慰疏慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗前葵萱皆吐花成诗二首 其一","author":"赵蕃","text":"僮能去蓬藋，手自植葵萱。\n叠石就为砌，启窗因当轩。\n后先殊早晚，开敛共朝昏。\n长夏曷以度，幽花相与言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筋竹之新居僧居邠录寄寺中留题次孙温叟所用赵南雄韵寄邠","author":"赵蕃","text":"梦向清江不见涯，觉来身乃太行车。\n新居寄我山中集，倦枕浑忘午后茶。\n爱此好风当北牖，待来明月望西斜。\n但怜独鹤归何晚，不问满林先暝鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]