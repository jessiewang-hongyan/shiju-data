[{"title":"题翠轩","author":"王十朋","text":"渊明旧隐名栖真，中有栖真闲道人。\n庐山咫尺脚不到，开轩种竹清且新。\n我到山中越三宿，似与道人缘分熟。\n皇恩若许归故乡，拭眼重来看修竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓栖真四宿时二儿寓上庠未知去留又祠命未下颇以为怀","author":"王十朋","text":"白帝知何处，黄山且少留。\n心惭陶靖节，政愧范饶州。\n桑下越三宿，江边将半秋。\n家书及祠命，何日解吾忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望大孤山","author":"王十朋","text":"鄱阳古渡留遗冢，湖口烟鬟露淡妆。\n九女何由从童子，两姑那肯嫁彭郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题湖口驿","author":"王十朋","text":"芦花洲渚江人邦，我来把酒临西窗。\n五祖六祖山照眼，清流浊流水同江。\n孤山大小各崭绝，钟石上下相舂撞。\n千帆出没烟雨里，何如鸥鹭飞双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至江州","author":"王十朋","text":"遥与齐侯会，江人故国存。\n夷吾嗟不见，北望是中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和叔奇见寄","author":"王十朋","text":"荔子黄甘岂不香，路经九折叹王阳。\n羡君松竹吟哦处，橘在怀中母在堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读赵果州诗","author":"王十朋","text":"眉宇胸襟两不尘，唾成珠玉更清新。\n惜哉不使苏仙见，题品宁先赵德麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读王文正遗事","author":"王十朋","text":"太平宰相王文正，盛德真宜有子孙。\n旧国今馀几乔木，三槐阴满宋乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题庾楼呈唐守立夫","author":"王十朋","text":"遥望香炉气欲烟，坐观湓浦浪舂天。\n山川满目古今迹，云水千帆名利船。\n万点白鸥家浩渺，一声赤壁酹婵娟。\n诗篇细读张耘叟，倚遍阑干思黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿太平兴国宫 其一","author":"王十朋","text":"此来端不为行春，欲向庐山访隐沦。\n圣主如容食祠禄，愿为主管太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿太平兴国宫 其二","author":"王十朋","text":"九天使者号真王，圣治峰前古道场。\n五百年间圣君出，太平治效过明皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿东林赠然老","author":"王十朋","text":"儒服方袍两秃翁，两家元是一家风。\n归田我欲效元亮，结社师真如远公。\n雁荡此生看未足，虎溪一笑偶然同。\n清风明月处处共，宁间江西与浙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白公草堂","author":"王十朋","text":"庐阜双林寺，炉峰几瓣香。\n日烘烟袅紫，敬为白公堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莲社","author":"王十朋","text":"渊明修静不谈禅，孔老门中各自贤。\n送别虎溪三笑后，白莲流水两凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东林聪明泉","author":"王十朋","text":"远公白莲社，旁有聪明泉。\n饮此谁聪明，社中十八贤。\n尧舜不曾饮，聪明本诸天。\n我辈虽饮之，聪明不加前。\n为爱此水清，一酌涤尘缘。\n却恐愚此水，愚名自今传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游圆通","author":"王十朋","text":"夹径森森郁老松，烟霞深处忽闻钟。\n虎溪水隔侯溪水，马耳峰联石耳峰。\n遗像人犹思后主，开山僧不畏先锋。\n明朝杖屦山南去，喷沫飞流看玉龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠讷老","author":"王十朋","text":"路入侯溪无故侯，梵王祠宇占清幽。\n语言文字真吾病，喜共维摩大士游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题至乐亭 其一","author":"王十朋","text":"双阁壮缁林，一亭馀古屋。\n庭垂祖师柏，风动禅房竹。\n山禽语昼寂，岩花吐秋馥。\n此乐本来无，行人慕幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题至乐亭 其二","author":"王十朋","text":"石散山形在，池乾水意存。\n游心山水外，至乐不容言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胜书记蜀僧也和予游玄通一诗用赠讷老韵酬","author":"王十朋","text":"未向夔门访武侯，禅房杖屦谩通幽。\n题诗况有诗僧和，深喜庐山得胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵唐立夫以日者命状见寄","author":"王十朋","text":"天下名山欲遍看，未能高卧愧陈抟。\n山人误说潜夫命，只慕冥鸿不慕官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵果州致羊酒走笔戏酬","author":"王十朋","text":"十日庐山游，蔬肠作雷鸣。\n对食有长铗，论文无曲生。\n清净似斋戒，迟留欲修行。\n翩翩佳公子，怜我厌藜羹。\n鱼酒致远意，诗篇慰西征。\n姜新微带糟，鲊美香流罂。\n今宵羊踏园，魂梦定须惊。\n回首白莲社，姑作陶渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题讷庵","author":"王十朋","text":"休论摩诘与文殊，试把庵名扣大儒。\n君子于言端欲讷，贤人终日只如愚。\n乐山自昔称仁者，利口由来恶啬夫。\n听法双峰空耸耳，老禅惟要一言无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题康王观","author":"王十朋","text":"趣在烟霞世味轻，天将庐阜慰西征。\n且须细看康王谷，未用遥寻白帝城。\n星子地分天上宿，谷帘泉占酒中名。\n凌云仙客知多少，肯向风波世路行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤泉","author":"王十朋","text":"占得乾坤造化炉，地中沸出巧工夫。\n泉犹自作炎凉态，休说众生垢有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿归宗寺","author":"王十朋","text":"好山无数不知名，路入禅林气更清。\n岩石有时开镜面，溪流入夜作鸾声。\n临池墨客馀风韵，拭眼高僧避宠荣。\n安得清风生两腋，紫霄峰顶望寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简寂观","author":"王十朋","text":"萦迂草径少人行，忽有黄冠洞口迎。\n自笑荒芜陶靖节，更寻简寂陆先生。\n朝真惟有坛前石，流水犹馀弦上声。\n欲听金鸡上金阙，紫霄峰际白云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游开先寺观香炉瀑布诸峰读李苏二仙诗知庐阜之胜在是记以十韵","author":"王十朋","text":"庐山何处好，胜地有开先。\n瀑水漱寒玉，香炉生紫烟。\n紫霄长近日，黄石不知年。\n雁荡灵湫合，酆城宝剑连。\n龟行似朝斗，鹤唳欲冲天。\n马尾只自洗，牛头奚用穿。\n雄词惟太白，妙句更苏仙。\n寺占星流处，桥飞月出边。\n碑方阅华藏，梦已到栖贤。\n明日游三峡，归心定决然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游万杉院 其一","author":"王十朋","text":"谁栽沙苑千株柳，争似庐山万本杉。\n如欲岁寒长不改，更栽松柏满幽岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游万杉院 其二","author":"王十朋","text":"庐山三百六十所，长有神光照万杉。\n借问山中有何宝，仁宗飞白字非凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游万杉院 其三","author":"王十朋","text":"一水遥分瀑布馀，万杉深处散明珠。\n不知散却珠多少，能买人间富贵无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"飞桥","author":"王十朋","text":"苏仙诗里见飞桥，欲看虹霓踏玉腰。\n我到山中虹始见，杨辉有月印青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三峡桥 其一","author":"王十朋","text":"三峡桥边杖屦游，此身疑已到夔州。\n题诗欲比真三峡，深愧词源不倒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三峡桥 其二","author":"王十朋","text":"滟滪瞿塘在眼前，便应从此上青天。\n秋风脱叶随流下，疑是十帆出峡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五老峰","author":"王十朋","text":"投老山林兴已浓，庐山欣与老人逢。\n定须容我来同老，五老峰边更有峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉渊","author":"王十朋","text":"谁决银河落半天，飞流溅沫五峰前。\n山中草木皆光润，知有含辉玉在渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游楞伽 其一","author":"王十朋","text":"涉水穿云一径迂，朱砂峰下访僧居。\n鸟鸣蝉噪更幽处，中有人藏万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游楞伽 其二","author":"王十朋","text":"老僧元不服朱砂，境静心灰寿自遐。\n庐阜招提三百所，只馀折桂与楞伽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游楞伽 其三","author":"王十朋","text":"藏书阁在已无书，山色依然满旧居。\n留得妇人三墨竹，金钟声里尚扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游南山入康谷以不观谷帘泉为恨南康李守致上尊乃此泉名也戏成一绝","author":"王十朋","text":"不饮谷帘山下水，徒观瀑布下长川。\n使君破我游山恨，酒寄人间第一泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石镜溪","author":"王十朋","text":"山中有镜石为台，云雾深藏未肯开。\n别有一溪清似镜，不须人为拂尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐山纪游四十韵","author":"王十朋","text":"我性好山水，思向庐山庐。\n五老招我游，有约芝山初。\n兹行适所愿，孰曰非天与。\n入眼庾公楼，兴已先篮舆。\n云开圣治峰，石扣仙人居。\n香炉望烟霭，净社观芙蕖。\n虎溪聊自笑，天池步宜纾。\n半月圆通留，幽亭乐有馀。\n趣如六一翁，境似山环滁。\n侯溪煮月泉，石耳供岩蔬。\n破戒戏鱼酒，踏园梦羊猪。\n贤关得家音，天恩拜新除。\n抗章复辞免，行色仍踌躇。\n遂作南山游，首过荆林虚。\n凌云入康谷，临流清可渔。\n欲饮第一水，山深足趑趄。\n汤泉本何来，忽从龙口嘘。\n鸾溪寻故家，墨沼波犹潴。\n石镜不可见，悬崖照谁梳。\n寻真到简寂，入观惊丘墟。\n缅怀黄与陆，何处飘霞裾。\n眼明见飞瀑，涧壑鸣琼琚。\n何落句思李，练飞诗陋儒。\n新桥跨虹霓，出月明蟾蜍。\n两州劳五马，同日传双鱼。\n神光照万杉，飞白留天书。\n遥瞻星子城，青山点舂锄。\n我行未及西，三峡知何如。\n登桥阅天险，奋地轰雷车。\n壮哉五丁力，凿此千尺渠。\n群峰列耆老，深渊蓄璠玙。\n古刹依朱砂，穿林骇猿狙。\n万卷已空阁，三竹犹扶疏。\n肩舆足茧卒，传诗手疲胥。\n佳境尚无穷，雅兴良已摅。\n身随禽往还，兴逐云卷舒。\n重寻讷庵老，细论无言予。\n节物变炎凉，迟留费居诸。\n在路何悠悠，归梦频蘧蘧。\n秋风雁还荡，缄封寄乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归宗枞老言庐山有对云简寂观中甜苦笋归宗寺里淡咸齑予因以汤泉石镜戏成一绝","author":"王十朋","text":"参禅得味咸齑淡，学道忘忧苦笋甜。\n石镜与时为显晦，汤泉涉世有凉炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开先僧赠石菖蒲","author":"王十朋","text":"结根拳石伴孤僧，对我还同道眼青。\n莫遣尘埃侵九节，会须重作玉衡星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别庐山","author":"王十朋","text":"山北山南已遍游，又移行李向西州。\n身如孟子论行止，心愧渊明任去留。\n峰顶今宵应好月，人间明日是中秋。\n天池一塔遥相送，深喜浮云为我收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题天华院","author":"王十朋","text":"游遍庐山寺，兹山亦自佳。\n数宵缘石耳，一饭为天华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋宿瀼溪驿 其一","author":"王十朋","text":"半月游庐阜，中秋宿瀼溪。\n祠寻元子隐，树认赤乌栖。\n坐待云开月，行愁雨作泥。\n鄱人应话我，身在九江西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋宿瀼溪驿 其二","author":"王十朋","text":"浪士旧游处，旅人今两宵。\n赤乌曾纪瑞，银杏敢兴妖。\n照眼水名瀼，回头山忆尧。\n男儿四方志，宁惮蜀天遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞昌李宰赠元次山集","author":"王十朋","text":"苍然山色泠然声，次山之文读可惊。\n令君赠我有深意，欲以漫浪更吾名。\n我虽有官真漫耳，谁遣夔门称刺史。\n开卷欣逢子元子，尤爱清泠瀼溪水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋思乡用瀼溪韵","author":"王十朋","text":"今夜中秋月，还应满故溪。\n遥知千里共，深羡一枝栖。\n岁月飘如梦，年时醉似泥。\n可怜佳节里，兄弟各东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿多福院","author":"王十朋","text":"古刹名多福，初来宿上方。\n蜂窠悬败壁，燕垒满空梁。\n蝙蝠沸盈室，尘埃堆满床。\n香烧数炷柏，移下小僧房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨日饭金城观今日饭石田驿","author":"王十朋","text":"城纵是金非愿得，田虽有石尚堪耕。\n欲随秋雁荡中去，却向杜鹃啼处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞昌永兴道中作","author":"王十朋","text":"蜀道青天手未摩，肩舆从此上危坡。\n永城朝过路方永，多福夜眠僧不多。\n冈畔泥深愁欲雨，渡头舟小喜无波。\n青山满眼森高木，正为人稀免斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿真如寺 其一","author":"王十朋","text":"迢迢脩岭踏朱红，林壑深藏古梵宫。\n一阁摩云锁宸翰，神光长照大江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿真如寺 其二","author":"王十朋","text":"白帝孤城在何许，遥想西风急砧杵。\n我行初至渫泉山，御书阁下眠秋雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至兴国军 其一","author":"王十朋","text":"一宿真如饮渫泉，钟声催上渡头船。\n夜来一雨湖光好，拟把穷愁洗富川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至兴国军 其二","author":"王十朋","text":"近涵州郭远连天，明月清风不计钱。\n欲比西湖及西子，品题须唤旧苏仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题怀坡阁赠王景文国正 其一","author":"王十朋","text":"穷途喜见富川波，已觉兹行所得多。\n杭颍西湖堪鼎足，兼怀六一与东坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题怀坡阁赠王景文国正 其二","author":"王十朋","text":"眼中十里是烟波，天遣江山助子多。\n自是玉堂挥翰手，不应此处久怀坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陶永州","author":"王十朋","text":"云作愁天风怒号，遥瞻白帝梦犹劳。\n口吟太白路难蜀，心慕渊明人遇陶。\n富水已厌家食久，浯溪行看石崖高。\n人生五马何曾贵，堪叹相逢各二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王景文赠行四绝 其一","author":"王十朋","text":"圣主龙飞白首郎，误蒙亲擢与南床。\n言多妄发汲长孺，心不敢邪苏世长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王景文赠行四绝 其二","author":"王十朋","text":"天涯行客正悲秋，况向鹘孙愁处愁。\n歌听竹枝刘刺史，诗怀庆朔范饶州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王景文赠行四绝 其三","author":"王十朋","text":"吾道从来自不孤，果蒙好语慰榛芜。\n孜孜相勉惟名节，官职何须校有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王景文赠行四绝 其四","author":"王十朋","text":"君年方壮我颜苍，敢以宗盟论雁行。\n孝子忠臣公论在，送行诗似少陵章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题谋野堂","author":"王十朋","text":"满目江山富一堂，公馀身在水云乡。\n遥岑更作有无色，西子为谁浓淡妆。\n荷有香能清燕寝，缨无尘可濯沧浪。\n使君坐此谋何事，境静心清百虑忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻诗闻礼不赴秋试以七月二十五日离太学八月二十六日至兴国军喜其来也因作是诗","author":"王十朋","text":"不将蜗角与人争，走侍双亲蜀道行。\n免为家书忧子美，饱闻情话悦渊明。\n一名所得知多少，万事真宜审重轻。\n更愿相随且归去，田园薄有要同耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"途中遇雨","author":"王十朋","text":"夜宿佛图市，晓穿山障中。\n泥愁行滑滑，雨厌落濛濛。\n晚稻短长熟，野花深浅红。\n江西又湖北，马首几时东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿大冶县","author":"王十朋","text":"隔岸呼舟子，湖山日欲曛。\n人家数点火，风物一川云。\n小渡渔人占，中流县界分。\n秋深山驿冷，萧瑟夜深闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东方寺","author":"王十朋","text":"大冶迢迢接武昌，西征踰月到东方。\n白莲智印蟠桃朔，仙佛同归一道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]