[{"title":"水心先生挽章二首 其一","author":"释元肇","text":"归自金陵后，情疏狎隐沦。\n身缘忧国瘦，家为著书贫。\n江海星沈夜，池塘草不春。\n门生天下是，椽笔付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水心先生挽章二首 其二","author":"释元肇","text":"孤屿秋风寺，三过夫子家。\n古心坚铁石，软语带烟霞。\n别岭栖双径，逢人问永嘉。\n重看送行句，殒泪墨攲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方蕙岩常簿二首 其一","author":"释元肇","text":"名教非无乐，何缘事上眉。\n不闲因接物，先老为忧时。\n两郡垂棠荫，东园长桂枝。\n用公浑未尽，一世有馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方蕙岩常簿二首 其二","author":"释元肇","text":"夙昔住山缘，来吴已八年。\n独怜寒塔影，时到碧岩前。\n埋玉亡何日，愁云过别天。\n东风减回首，家学子能传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张廉州奏院","author":"释元肇","text":"合浦归来久，迟敲月下门。\n今朝隔生死，无处问乾坤。\n斜日寒天短，愁云远水吞。\n湖趺溪畔石，空忆系舟痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴荆溪大监","author":"释元肇","text":"遥辞下石桥，南岳阻招邀。\n五载未相见，三除不入朝。\n玉楼催作记，琼阙伴吹箫。\n叹世无知己，文章竟寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵东阁奏院","author":"释元肇","text":"东阁王孙贵，才名似谪仙。\n可怜颁郡下，不及盖棺前。\n家乏千金计，诗应万古传。\n生来同四柱，岂料哭君先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周伯弜明府","author":"释元肇","text":"昨过扬州日，知君病已侵。\n殊非折腰具，竟作断弦吟。\n远信逢秋笛，惊哀彻树禽。\n有才无命者，从古至于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"印佥判","author":"释元肇","text":"才业魁多士，英声早岁驰。\n宦涂将晚达，贤路有深知。\n月借山城白，风飘鼓角悲。\n用公浑不尽，珠树照清时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆税院","author":"释元肇","text":"甫里云间谱，知几类计然。\n本期抛旧宅，岂料见新阡。\n宦远无年及，门高有子传。\n乡音何处认，哀泣似淮堧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈孺人","author":"释元肇","text":"静正成家道，贤明训子孙。\n园林冬出笋，霜露早摧萱。\n有泪瞻遗像，无言似倚门。\n伤心夜台月，不照再承恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁少耘","author":"释元肇","text":"逢师竹涧旁，岁惨下归航。\n我独疑深隐，僧来说坐亡。\n草墟曾住寺，尘锁别营房。\n渺渺吴中道，无因过上塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟别浦禅师塔","author":"释元肇","text":"诸老凋零尽，江湖转忆君。\n人经十年换，寺革一番焚。\n庭冷池来月，山空塔裹云。\n惟应有游衲，时到炷炉薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其一","author":"释元肇","text":"道丧几千载，不复还其淳。\n强者用诈力，弱者伤夷沦。\n芒芒大块中，何人得其真。\n已矣难重陈，吾将谁与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其二","author":"释元肇","text":"千山万山中，翠薜相交罗。\n春风来何迟，积雪常峨峨。\n折木有清响，采薇闻远歌。\n不因寻石桥，长年无人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其三","author":"释元肇","text":"面对香炉峰，朝昏起云雾。\n飘飘无定形，忽被风吹去。\n去去还复留，半挂长松树。\n悠然会我心，政自有佳趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其四","author":"释元肇","text":"四时多幽禽，日日鸣前林。\n呼唤烟树重，应答山水深。\n静中无别响，独听有馀音。\n载歌仍载吟，半晴还半阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其五","author":"释元肇","text":"涧底有清泉，日夜鸣涓涓。\n风声过树头，月色当窗前。\n起坐不成寐，白发悲流年。\n向来称达人，两耳何缘溅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其六","author":"释元肇","text":"山中产灵药，四望清蔼蔼。\n神仙久不逢，世上何人采。\n桃源路岂遥，蓬莱非隔海。\n惟有天地根，古今常独在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其七","author":"释元肇","text":"兰生在深林，众草相陆沈。\n微承雨露滋，积受霜雪侵。\n幽芗时一吹，樵牧空见寻。\n采采当我前，远此违世心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其八","author":"释元肇","text":"红红白白花，万万千千树。\n开亦不知名，落亦不知数。\n幽禽来上啼，野鹿衔将去。\n可望不可攀，四向高无路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其九","author":"释元肇","text":"野草纷其类，托根孤高地。\n谁荣谁瘁之，动摇春风至。\n凄迷烟雨中，碧满闲庭际。\n王孙归不归，山深易寒气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台山中十首 其十","author":"释元肇","text":"为爱檐前竹，特立万竿玉。\n萧萧送雨声，沈沈照窗绿。\n风雪凌压之，可摧不可曲。\n澹然如幽人，长年在空谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许来亭","author":"释元肇","text":"猗欤观石桥，境物皆天趣。\n山高碍鸟飞，瀑响惊龙睡。\n真流半千尊，只在云中住。\n验尽世间人，到此煎茶去。\n昙猷昔何为，苦苦欲相遇。\n饼峰忽面墙，石上穿双泪。\n他年许重来，老却青松树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山吴下庵居","author":"释元肇","text":"一昨离天台，事事皆不会。\n西风信杖藜，吹落齐关外。\n主人新卜筑，林塘倏苍荟。\n埤堄隐周遭，市声隔繁碎。\n出门与入门，朝昏随向背。\n浮图一两尖，云际忽相对。\n雁阵拽如绳，鸦唤斜阳队。\n有僧来扣门，路跨田翁耒。\n人应笑我疏，我笑人多昧。\n古今佳遁情，可在此庵内。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨梅山人渭川图","author":"释元肇","text":"不识山人面，今见山人竹。\n鹅溪半幅间，渭川千亩足。\n细细穿石泉，猗猗动寒绿。\n望之意已凉，况当亲㩜触。\n贤哉怀隐居，畴能继高躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗汉树","author":"释元肇","text":"人生天地间，飘然无根蒂。\n贵贱寿夭形，总被造物戏。\n达者常晏如，不作包桑计。\n如何閒草木，刚受人妩媚。\n寒松作大夫，枯木号居士。\n便有徼福人，未免斧斤至。\n孤高本无心，反以名疣赘。\n此树亦岁寒，婆娑立苍翠。\n著子秋累累，何啻五百位。\n颅圆从谁度，身紫何人赐。\n问之无人说，法门入不二。\n乔特不世情，与我却相类。\n许我折一枝，幽窗浸缶器。\n辞柯漏已空，森然遂生意。\n荏苒三暑寒，傲睨万物悴。\n翻思阴阳家，水木推生利。\n但存节操坚，莫讶垛根异。\n雁荡与天台，泉石平生志。\n木上座脱洒，竹尊者风味。\n何当笑相逢，同归第一义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"县胥归耕","author":"释元肇","text":"笼中无乐鸟，槛外无乐兽。\n何尝费饮啄，不忘念翔骤。\n子今既知此，欲拂事公袖。\n不将无事眉，闲为鞭笞皱。\n社瓮虽浊醪，胜醉歌楼酎。\n妇馌虽糗粝，胜冷书案豆。\n门前有追胥，皂衣皆我旧。\n布谷鸣春深，斯言诚可复。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高鼓院桃村","author":"释元肇","text":"举头见青山，高与天齐平。\n俯首鉴灵泉，派分天池清。\n是中十亩园，烂若红霞蒸。\n夫差昔不国，舞榭歌台倾。\n风惊柳腰折，雨集蛙部鸣。\n霭霭墟里烟，纷纷鸡犬声。\n寂寥千载后，公来畅幽情。\n手种桃千株，草架屋数楹。\n厥壤宜芬芳，昭俭易落成。\n子孙相追随，日夕生遐征。\n公今云台仙，轻强垂百龄。\n支筇歌紫芝，倚松诵黄庭。\n绿阴长蟠实，白莲闯池生。\n客从何方来，略不通姓名。\n自云多昔人，食之能飞升。\n更老上所尊，只恐蒲轮徵。\n公乎笑而已，客言曾不听。\n归来向人说，洞口云纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二虫诗","author":"释元肇","text":"蛛螫包祸心，满腹皆素丝。\n补缀曾无功，贪伤不知疲。\n谁云禁网密，施设近茅茨。\n旦暮待游蚋，所得亦已卑。\n蝎虎誇捷巧，缘壁行跂跂。\n蛜蝛青蝇辈，苦遭暗中窥。\n失身在蛛网，竟日秋檐垂。\n蛛犹惧蝎绐，睥睨不敢为。\n蛛网既已裂，蝎命不亦危。\n嗟哉复嗟哉，诚大黠小痴。\n纷纷事争夺，复何异于斯。\n我闵为解粘，蝎去何所知。\n但令嬉饱日，莫忘倒县时。\n感彼两物情，成此一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和上官右史韵","author":"释元肇","text":"夫子作春秋，大义明素王。\n至于游夏辈，一字不敢当。\n文风下秦汉，诗体更晋唐。\n世道有隆替，人才随翕张。\n致君与泽民，夷险公备尝。\n山川寻谢屐，风月归奚囊。\n满城风雨朝，采采篱下黄。\n临风怀美人，在彼天一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上水心先生三首 其一","author":"释元肇","text":"文字滔滔江汉东，早从伊洛定宗风。\n中兴之后数人物，北斗以南唯此公。\n闻道治平犹草奏，向来持论不和戎。\n匪伊再入脩门去，只有孤忠与昔同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上水心先生三首 其二","author":"释元肇","text":"华发萧骚减带围，可胜忧国更伤时。\n乐天名位微堪酒，灵运池塘不废诗。\n架上牙签烧烛短，窗间花影转春迟。\n天教惜取如椽笔，要勒磨崖大字碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上水心先生三首 其三","author":"释元肇","text":"十年瓶钵走天涯，四海声名一永嘉。\n不趁新霜尝橘柚，了无归梦到蒹葭。\n江头来往春强半，门外推敲月又斜。\n换骨夺胎如得妙，愿从勾漏问丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄上制使贾端明二首 其一","author":"释元肇","text":"洛阳声贾自传胪，三十专城总要涂。\n黄鹤楼中纳云梦，碧油幢下重江都。\n争誇国士无双杰，堪对琼花独一株。\n王事只消谈笑了，好吟佳句继欧苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄上制使贾端明二首 其二","author":"释元肇","text":"天台山压众峰高，极胜穷幽是石桥。\n在昔一诗留翠壁，至今万壑响青霄。\n淮南草木皆沾润，塞北烟尘即便销。\n将相功名古来有，可曾江上问渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江心春日","author":"释元肇","text":"江边春日正迟迟，岸草汀蒲绿涨肥。\n有户不扃僧懒出，种花无地客来稀。\n破烟白鸟成双下，度堑昏鸦接翅归。\n流转自怜乡国异，风光随处不相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次吕教授游江心韵","author":"释元肇","text":"鱼龙吹浪雪霏霏，更著青山倚落晖。\n一幅风帆到烟寺，十年尘土愧征衣。\n渔家蓑笠应堪换，老宿瓶盂未可依。\n回首谢公楼上去，池塘春草昔人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上","author":"释元肇","text":"五年踏破几芒鞋，山色湖光识再来。\n鱼鸟散时浮鼓吹，烟云缺处见楼台。\n白绵飞尽苏公柳，青豆初尝处士梅。\n小立东风争渡急，句中无地著尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庵中牡丹","author":"释元肇","text":"谁将根底种灵丹，开处凡花比亦难。\n胜赏莫嫌僧院僻，久长留到子孙看。\n有时垂泪伤多雨，未肯扶头怯晓寒。\n自笑色空俱照了，也来随例并阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春郊有感","author":"释元肇","text":"用舍行藏只自伤，五年留滞在江乡。\n青松远引来南塔，白发犹欣见北堂。\n麦浪有时迎燕舞，菜花无赖学莺黄。\n骑驴又打津头过，杨柳飞绵出短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中","author":"释元肇","text":"三月长安似梦中，回头春事已成空。\n桑麻暗锁村村雨，蒲稗新翻浦浦风。\n燕子不知家远近，杜鹃长怨客西东。\n篱根竹外无人见，犹有残花堕晓红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日书怀","author":"释元肇","text":"静倚晴窗笑此生，出游归隐两无成。\n故园小作三春梦，倦翼长垂万里情。\n庭树欲红闻鸟闹，郊原新绿见人耕。\n湖山旧友如相问，只向梅花说姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪窦","author":"释元肇","text":"上尽崎岖脚力微，毳袍零碎染烟霏。\n妙高峰顶见日出，千丈岩前看雪飞。\n寒木著霜山衣锦，清池得月镜交辉。\n翩然又作东南去，肯落台温第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雁山夏夜","author":"释元肇","text":"浮岚空翠湿衣襟，合涧流泉奏玉琴。\n古殿芗寒起僧定，莫楼烟重咽钟音。\n随风萤火光明灭，得雨芭蕉语浅深。\n猛省南来二千里，不应翻作兔投林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张宰湖山堂","author":"释元肇","text":"别来萍梗浙东西，得向湖山手重携。\n风定波间鸥出没，云深天阔雁高低。\n拟将脩竹题归隐，长恐扁舟路欲迷。\n明日棹歌回首处，苇花蘋叶冷凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"狼山池上有感","author":"释元肇","text":"池上凉多生万松，登临怀感兴何穷。\n催诗不雨云空黑，结社无人莲自红。\n翡翠得鱼忙蘸水，蜻蜓避燕巧低风。\n灵龟未解蒙庄意，慇慇时来乱叶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡守监丞得祠次韵送之","author":"释元肇","text":"墨行儒名固可麾，愧无织锦别梭机。\n隔林喜听黄鹂语，离岸愁看画鹢飞。\n松菊未荒三径在，山川都是几人非。\n只应父老千行泪，立尽斜阳未肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和杨节使登径山","author":"释元肇","text":"阊阖门西湖水临，深深院落见春心。\n梨花风弄影来去，燕子日长谈古今。\n起早每缘朝玉阙，归迟多是宴琼林。\n肯将吹竹弹丝耳，来听重云钟鼓音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过无怀故庐","author":"释元肇","text":"壮岁无心预祖图，莫年卜筑伴林逋。\n閒名已在羲皇上，诗句曾将岛可奴。\n尚想风流悲断柳，更无人共致生刍。\n自怜淮海飘零客，也向春风听鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和白玉蟾韵","author":"释元肇","text":"蓬莱仙客兴无酬，汗漫来游海上州。\n明月满山歌踏踏，红尘入市笑休休。\n钓竿不用空遮日，诗句时能一掉头。\n醉后抱琴归去也，人间知是几春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中雪","author":"释元肇","text":"扁舟泊晚橹咿哑，飘洒随风整复斜。\n照夜初疑篷背月，隔溪遥认树头花。\n村深浦远人迷路，苇折荷倾雁著沙。\n渔父披蓑归去后，带烟茅屋两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日","author":"释元肇","text":"晓烟和露湿秋光，幽鸟声声在翠篁。\n世事又随明日别，菊花只作去年香。\n风前落帽人千古，云外惊寒雁一行。\n脱木萧疏砧杵急，倚筇无语到斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻边报","author":"释元肇","text":"高皇宏远立规模，建武犹能复壮图。\n闻道烟尘暗淮海，梦成风雨落江湖。\n可无归雁传家信，定有非熊出钓徒。\n目断关河正愁绝，东风吹绿入平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠画僧之金陵","author":"释元肇","text":"澹薄轻云横素秋，缓行篱落菊香浮。\n我今已是沟中断，君去还同水上鸥。\n钟磬僧敲烟际寺，管弦人在夕阳楼。\n一江风月浑依旧，六代英雄画得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别心首座","author":"释元肇","text":"四面湖山展画屏，故人相见眼偏青。\n迎风春鸟语犹滑，过雨山花睡欲醒。\n出处既分南北海，别离空恨短长亭。\n明朝又作松江去，几棹烟波月满汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲子平下第二首 其一","author":"释元肇","text":"直道干时徒尔劳，归来门径长蓬蒿。\n朱研玉露点周易，灯拨金花读楚骚。\n时把渔竿钓烟雨，閒同僧饭荐溪芼。\n儿曹不会个中意，只管区区问绿袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲子平下第二首 其二","author":"释元肇","text":"不是云林胜市朝，都将名利等鸿毛。\n床头纸被今年破，林外霜风昨夜高。\n虚白室无儋石计，清新诗有十分豪。\n黄花时节明朝是，冷眼相看栗里陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次陈平甫提干晚春韵","author":"释元肇","text":"莫云岂特看江东，朋旧如今四海中。\n花落不禁三日雨，颜衰消得几春风。\n檐前雏竹娟娟粉，阶下樱桃滴滴红。\n辛苦广骚将底用，弋人何处慕冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次柳倅见寄","author":"释元肇","text":"是中空洞任天游，去住飘然百不忧。\n黄独有苗师懒瓒，碧云无语继汤休。\n才名如此分千里，道术相忘混九流。\n寄得诗来乘月看，满身风露一庭秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见海门韩宰","author":"释元肇","text":"心远遥知地自偏，杖藜随处有云泉。\n朝来原上一犁雨，春到淮南二月天。\n短短菰蒲初弄水，依依杨柳欲摇烟。\n渊明自是无为者，能使懦夫怀凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐丞见一堂","author":"释元肇","text":"菊长新丛春事成，先生归赋见深情。\n麻衣草座自行乐，明月清风人不争。\n郡榻莫留青眼旧，客星闲傍紫微明。\n个中万象浑无碍，门外何妨车马声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]