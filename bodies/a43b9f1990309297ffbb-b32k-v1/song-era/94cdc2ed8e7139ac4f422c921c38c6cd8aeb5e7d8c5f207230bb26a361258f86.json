[{"title":"送赵学士陕西提刑","author":"王安石","text":"遥知彼俗经兵后，应望名公走马来。\n陛下柬求今日始，胸中包畜此时开。\n山西豪杰归囊牍，渭北风光入酒杯。\n堪笑陋儒昏鄙甚，略无谋术赞行台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵燮之蜀永康簿","author":"王安石","text":"蜀山万里一青袍，石栈天梯箠辔高。\n多学似君宁易得，小官于此亦徒劳。\n行追西路聊班草，坐忆南州欲梦刀。\n他日寄声能问我，应从锦水至江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送逊师归舒州","author":"王安石","text":"山川相对一悲翁，往事纷纷梦寐中。\n邂逅故人恩意在，低徊今日笑言同。\n看吹陌上杨花满，忽忆岩前蕙帐空。\n亦见桐乡诸父老，为传衰飒病春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送项判官","author":"王安石","text":"断芦洲渚落枫桥，渡口沙长过午潮。\n山鸟自呼泥滑滑，行人相对马萧萧。\n十年长自青衿识，千里来非白璧招。\n握手祝君能强饭，华簪常得从鸡翘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送真州吴处厚使君","author":"王安石","text":"江上斋船驻彩桡，鸣笳应满绿杨桥。\n久为汉吏知文法，当使淮人服教条。\n拱木延陵瞻故国，丛祠瓜步认前朝。\n登临莫负山川好，终欲东归听楚谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陶氏妇兼寄纯甫","author":"王安石","text":"云结川原暗，风连草木萎。\n遥瞻季行役，正对女伤悲。\n梦事中千变，生涯老百罹。\n更惭无道力，临路涕交颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送崔左藏之广东","author":"王安石","text":"怪石巉巉上泬寥，昔人于此奏箫韶。\n水清但有嘉鱼出，风暖何曾毒草摇。\n今日淹留君按节，当时嬉戏我垂髫。\n因寻旧政询遗老，为作新诗变俚谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梅龙图","author":"王安石","text":"子真家世子云乡，风力才华岂易当。\n回首古人多隐约，致身今日独辉光。\n谟明久合分三府，治剧聊须试一方。\n从此政成何所报，百城无事祇耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章宏","author":"王安石","text":"道合由来不易谋，岂无和氏识荆璆。\n一川浊水浮文鹢，千里轻帆落武丘。\n身退岂嫌吾道进，学成方悟众人求。\n西风乞得东南守，杖策还能访我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送萧山钱著作","author":"王安石","text":"才高诸彦故无嫌，兄弟同时举孝廉。\n东观外除方墨绶，西州相见已苍髯。\n灵胥引水清穿市，神禹分山翠入帘。\n好去弦歌聊自慰，郡人谁敢慢陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送董传","author":"王安石","text":"悠悠陇头水，日夜向西流。\n行路未云已，归人空复愁。\n文章合用世，颜发未惊秋。\n一听秦声罢，还来上国游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送道光法师住持灵岩","author":"王安石","text":"灵岩开辟自何年，草木神奇鸟兽仙。\n一路紫苔通窅窱，千崖青霭落潺湲。\n山祇啸聚荒禅室，象众低摧想法筵。\n雪足莫辞重趼往，东人香火有因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送福建张比部","author":"王安石","text":"画船箫鼓出都时，万里惊鸥去不追。\n却望尘沙应驻节，会逢山水即吟诗。\n长鱼俎上通三印，新茗斋中试一旗。\n只恐远方难久滞，莫愁风物不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧无惑归鄱阳","author":"王安石","text":"晚扶衰惫寄人间，应接纷纷祇强颜。\n挂席每谙东汇水，采芝多梦旧游山。\n故人独往今为乐，何日相随我亦闲。\n归见江东诸父老，为言飞鸟会知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送熊伯通","author":"王安石","text":"岁暮欣逢盖共倾，川涂南北岂忘情。\n事经官路心应折，地入家山眼更明。\n江上月华空自照，梅边春意恰相迎。\n关河不锁真消息，野客犹能听治声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送裴如晦宰吴江","author":"王安石","text":"青发朱颜各少年，幅巾谈笑两欢然。\n柴桑别后馀三径，天禄归来尽一廛。\n邂逅都门谁载酒，萧条江县去鸣弦。\n犹疑甫里英灵在，到日凭君为舣船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送潘景纯","author":"王安石","text":"东都曾以一当千，场屋声名十五年。\n晚赐绿衣随宦牒，始操丹笔事戎旃。\n明时正欲精蒐选，荣路何当力荐延。\n赖有史君能好士，方看一鹗在秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赞善张轩民西归","author":"王安石","text":"柴荆雀有罗，公子数经过。\n邂逅相知晚，从容所得多。\n百忧生暮齿，一笑隔沧波。\n早晚西州路，遥听下坂珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游草堂 其二","author":"王安石","text":"僧残尚食少，佛古但泥多。\n寒守三衣法，饥传一钵歌。\n宽闲每迸竹，危朽漫牵萝。\n怊怅庭前柏，西来意若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游草堂 其一","author":"王安石","text":"垣屋荒葛藟，野殿冷檀沈。\n鹤有思颙意，鹰无恋遁心。\n禅房闭深竹，斋钵度遥岑。\n寂寞黄尘里，金身倚一寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游草堂 其三","author":"王安石","text":"野寺真兰若，山僧老病多。\n疏钟挟谷响，悲梵入樵歌。\n水映茅篁竹，云埋茑女萝。\n拂尘书所见，因得拟阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重登宝公塔复用前韵二首 其二","author":"王安石","text":"碧玉旋螺恍隔霄，冠山仙冢亦寥寥。\n空馀华构延风月，无复灵踪落市朝。\n帐座追严多献宝，供盘随施有操瓢。\n他方出没还如此，与物何心作迩遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重登宝公塔复用前韵二首 其一","author":"王安石","text":"空见方坟涌半霄，难将生死问参寥。\n应身东返知何国，瑞像西归自本朝。\n遗寺有门非辇路，故池无钵但僧瓢。\n独龙下视皆陈迹，追数齐梁亦未遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山西庵白莲亭","author":"王安石","text":"山亭新破一方苔，白帝留花满四隈。\n野艳轻明非傅粉，秋光清浅不凭材。\n乡穷自作幽人伴，岁晚谁为静女媒。\n可笑远公池上客，却因松菊赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻和甫补池掾","author":"王安石","text":"遭时何必问功名，自古难将力命争。\n万户侯多归世胄，五车书独负家声。\n才华汝尚为丞掾，老懒吾今合钓耕。\n外物悠悠无得丧，春郊终日待相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乘日","author":"王安石","text":"乘日塞垣入，御风塘路归。\n胡皆跃马去，雁却背人飞。\n烟水吾乡似，家书驿使稀。\n匆匆照颜色，恨不洗征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜舟中颇凉因有所感","author":"王安石","text":"扁舟畏朝热，望夜倚桅樯。\n日共火云退，风兼水气凉。\n未秋轻病骨，微曙浣愁肠。\n坚我江湖意，滔滔兴不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射亭","author":"王安石","text":"因射构兹亭，序贤仍阅兵。\n庶民观礼教，群寇避威声。\n城垒前相壮，溪山势尽倾。\n宜哉百里地，桴鼓未尝鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽舜元胡著作郎","author":"王安石","text":"德行文章里闬宗，姓名朝野尽知公。\n侍亲存没皆全孝，报政初终必竭忠。\n性直不从花县乐，分安求逸郁堂空。\n从今永别人间去，笑入蓬瀛阆苑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题微之廨中清辉阁","author":"王安石","text":"故人名字在瀛洲，邂逅低徊向此留。\n鸥鸟一双随坐啸，荷花十丈对冥搜。\n水涵樽俎清如洗，山染衣巾翠欲流。\n宣室应疑鬼神事，知君能复几来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离北山寄平甫","author":"王安石","text":"日月沄沄与水争，披襟照见发华惊。\n少年忧患伤豪气，老去经纶误半生。\n休向朝廷论一鹗，只知田里守三荆。\n清溪几曲春风好，已约归时载酒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致仕邵少卿挽辞二首 其二","author":"王安石","text":"杯酒邗沟上，纷纷已十年。\n音容常想见，风迹每流传。\n老去元卿位，新开太守阡。\n庆门当更大，子弟固多贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致仕邵少卿挽辞二首 其一","author":"王安石","text":"谢朓城中守，梁鸿墓下归。\n素车驰吉路，丹旐卷寒辉。\n抚几虚容在，瞻图实貌非。\n无因置一酹，空此叹长违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致仕虞部曲江谭君挽辞","author":"王安石","text":"同时献赋久无人，握手悲欢迹已陈。\n它日白衣霄汉志，暮年朱绂水云身。\n虚容剑几今长夜，小隐山林祇旧春。\n岂惜埋辞追往事，齿衰才尽独伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛溪驿","author":"王安石","text":"缺月昏昏漏未央，一灯明灭照秋床。\n病身最觉风露早，归梦不知山水长。\n坐感岁时歌慷慨，起看天地色凄凉。\n鸣蝉更乱行人耳，正抱疏桐叶半黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫疑","author":"王安石","text":"莫疑禅伯未知禅，莫笑仙翁不学仙。\n灵骨肯传黄檗烬，真心自放赤松烟。\n莲华世界何关汝，楮叶工夫浪费年。\n露鹤声中江月白，一灯岑寂拥书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史","author":"王安石","text":"自古功名亦苦辛，行藏终欲付何人。\n当时黮闇犹承误，末俗纷纭更乱真。\n糟粕所传非粹美，丹青难写是精神。\n区区岂尽高贤意，独守千秋纸上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读诏书","author":"王安石","text":"去秋东出汴河梁，已见中州旱势强。\n日射地穿千里赤，风吹沙度满城黄。\n近闻急诏收群策，颇说新年又亢阳。\n贱术纵工难自献，心忧天下独君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读眉山集次韵雪诗五首 其五","author":"王安石","text":"戏摇微缟女鬟鸦，试咀流酥已颊车。\n历乱稍埋冰揉粟，消沉时点水圆花。\n岂能舴艋真寻我，且与蜗牛独卧家。\n欲挑青腰还不敢，直须诗胆付刘叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读眉山集次韵雪诗五首 其四","author":"王安石","text":"寄声三足阿环鸦，问讯青腰小驻车。\n一一照肌宁有种，纷纷迷眼为谁花。\n争妍恐落江妃手，耐冷疑连月姊家。\n长恨玉颜春不久，画图时展为君叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读眉山集次韵雪诗五首 其三","author":"王安石","text":"惠施文字黑如鸦，于此机缄漫五车。\n皭若易缁终不染，纷然能幻本无花。\n观空白足宁知处，疑有青腰岂作家。\n慧可忍寒真觉晚，为谁将手少林叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读眉山集次韵雪诗五首 其二","author":"王安石","text":"神女青腰宝髻鸦，独藏云气委飞车。\n夜光往往多联璧，白小纷纷每散花。\n珠网纚连拘翼座，瑶池淼漫阿环家。\n银为宫阙寻常见，岂即诸天守夜叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读眉山集次韵雪诗五首 其一","author":"王安石","text":"若木昏昏末有鸦，冻雷深闭阿香车。\n抟云忽散筛为屑，剪水如分缀作花。\n拥帚尚怜南北巷，持杯能喜两三家。\n戏挼弄掬输儿女，羔袖龙钟手独叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读眉山集爱其雪诗能用韵复次韵一首","author":"王安石","text":"靓妆严饰曜金鸦，比兴难工漫百车。\n水种所传清有骨，天机能织皦非花。\n婵娟一色明千里，绰约无心熟万家。\n长此赏怀甘独卧，袁安交戟岂须叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读秦汉间事","author":"王安石","text":"秦徵天下材，入作阿房宫。\n宫成非一木，山谷为穷空。\n子羽一炬火，骊山三月红。\n能令扫地尽，岂但焚人功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贾生","author":"王安石","text":"汉有洛阳子，少年明是非。\n所论多感概，自信肯依违。\n死者若可作，今人谁与归。\n应须蹈东海，不但涕沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高魏留","author":"王安石","text":"魏留十七助防边，埋没盐州十八年。\n衣屦穷空委胡妇，糗粮辛苦待山田。\n关河旧路频回首，腹背他时两受鞭。\n邂逅得归耶战死，母随人去亦萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成二首 其二","author":"王安石","text":"怀抱难开醉易醒，晓歌悲壮动秋城。\n年光断送朱颜去，世事栽培白发生。\n三亩未成幽处宅，一身还逐众人行。\n可怜蜗角能多少，独与区区触事争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成二首 其一","author":"王安石","text":"渐老偏谙世上情，已知吾事独难行。\n脱身负米将求志，勠力求田岂为名。\n高论颇随衰俗废，壮怀难值故人倾。\n相逢始觉宽愁病，搔首还添白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿土坊驿寄孔世长","author":"王安石","text":"烧夜郊原百草荒，弊裘朝去犯严霜。\n残年意象偏多感，回首风烟更异乡。\n往返自非名利役，辛勤应见友朋伤。\n章江犹得同游处，最爱梅花蘸水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿北山示行详上人","author":"王安石","text":"都城羁旅日，独许上人贤。\n谁为孤峰下，还来宴坐边。\n是身犹梦幻，何物可攀缘。\n坐对青灯落，松风咽夜泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿定林示无外名务周","author":"王安石","text":"天女穿林至，姮娥度陇来。\n欲归今晼晚，相值且徘徊。\n谁谓我忘老，如闻虫造哀。\n邻衾亦不寐，共尽白云杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿雨","author":"王安石","text":"绿搅寒芜出，红争暖树归。\n鱼吹塘水动，雁拂塞垣飞。\n宿雨惊沙尽，晴云昼漏稀。\n却愁春梦短，灯火著征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄友人","author":"王安石","text":"飘然羁旅尚无涯，一望西南百叹嗟。\n江拥涕洟流入海，风吹魂梦去还家。\n平生积惨应销骨，今日殊乡又见花。\n安得此身如草树，根株相守尽年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄友人三首 其三","author":"王安石","text":"一别三年各一方，此身漂荡只殊乡。\n看沙更觉蓬莱浅，数日空惊霹雳忙。\n渺渺水波低赤岸，濛濛云气淡扶桑。\n登临旧兴无多在，但有浮槎意未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄友人三首 其二","author":"王安石","text":"水边幽树忆同攀，曾约移居向此间。\n欲语林塘迷旧径，却随车马入他山。\n飞花著地容难冶，鸣鸟窥人意转闲。\n物色可歌春不返，相思空复惨朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄友人三首 其一","author":"王安石","text":"万里书归说我愁，知君不忘北城幽。\n一篇封禅才难学，三亩蓬蒿势易求。\n欲与山僧论地券，愿为邻舍事田畴。\n应须急作南征计，漠北风沙不可留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄无为军张居士","author":"王安石","text":"南阳居士月城翁，曾习禅那问色空。\n卓荦想超文字外，低徊却寄语言中。\n真心妙道终无二，末学殊方自不同。\n此理世间多未悟，因君往往叹西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王回深甫","author":"王安石","text":"少年倏忽不再得，后日欢娱能几何。\n顾我面颜衰更早，怜君身世病还多。\n窗间暗淡月含雾，船底飘飖风送波。\n一寸古心俱未试，相思中夜起悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王补之","author":"王安石","text":"平居相值晚，况复道涂留。\n今我思挥麈，逢君为舣舟。\n人情方慕贵，吾道合归休。\n吏责真难塞，聊为泮水游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄平甫","author":"王安石","text":"少时为学岂身谋，欲老低徊各自羞。\n乘马从徒真扰扰，求田问舍转悠悠。\n弦歌旧国平生乐，鞍马新年几日留。\n坐想摇鞭杨柳路，春风先我入皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄石鼓寺陈伯庸","author":"王安石","text":"鲸海无风白日闲，天门当面险难攀。\n尘埃掉臂离长陌，琴酒和云入旧山。\n仁义未饶轩冕贵，功名莫信鬼神悭。\n郭东一点英雄气，时伴君心夜斗间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄孙正之","author":"王安石","text":"南游忽忽与谁言，共笑谋生识最昏。\n万事百年能自信，一箪五鼎不须论。\n友中惟子长招隐，世上何人可避喧。\n千里秋风相望处，皖公溪上正开樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄朱昌叔","author":"王安石","text":"清江漫漫绕城流，尚忆城边系小舟。\n射虎未能随李广，割鸡空欲戏言游。\n云埋塞路惊尘合，霜入春风满鬓愁。\n此日君书苦难得，谩多鸿雁起南洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄余温卿","author":"王安石","text":"云散风流不自禁，天涯无路盍朋簪。\n空驰上国青泥信，谁和南山白石音。\n平日离愁宽带眼，讫春归思满琴心。\n终回一命翩翩驾，独过嵇山锻树阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]