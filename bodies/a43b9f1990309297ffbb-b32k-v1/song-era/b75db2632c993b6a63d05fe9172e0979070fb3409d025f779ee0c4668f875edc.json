[{"title":"嚼梅","author":"顾逢","text":"冷灶无烟过午时，可怜童鹤望邻炊。\n饥来细把梅花嚼，不信梅花不疗饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嚼菜根","author":"顾逢","text":"口体累人终不免，菜根能嚼乐无穷。\n吾儒食惯知真味，谁信犹便几富翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浚耕云敬得方丈","author":"顾逢","text":"耕云老子久相期，同赋山中莺燕诗。\n可惜我来迟数日，牡丹过了有花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下竺寺金鱼","author":"顾逢","text":"黄金成一片，雨过唼方池。\n想尔浮沉乐，如吾爱傲时。\n水声频拨剌，人影不惊疑。\n中有成龙者，腾空未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞来峰猿","author":"顾逢","text":"天竺如巴峡，画图无此奇。\n挂藤伸黑臂，剥果喂黄儿。\n孤影池中夜，三声月下时。\n倚阑僧不去，应是苦于诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云边偶成 其一","author":"顾逢","text":"彭殇皆定数，万事转头非。\n不悟身如寄，安知死是归。\n世情趋马首，道眼识鹑衣。\n堪笑磻溪老，皤然立钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云边偶成 其二","author":"顾逢","text":"达者由来少，机心肯暂停。\n几家才富贵，中道又凋零。\n白发人间宝，黄金水上萍。\n无钱陶靖节，醉眼不曾醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天竺道中","author":"顾逢","text":"冲开秋色去，深入万松间。\n风月无边乐，乾坤几个闲。\n断云难掩日，急水不流山。\n树杪忽然响，斜飞过白鹇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方竹杖","author":"顾逢","text":"直节老犹坚，棱分四角全。\n自缘生处别，不逐世情圆。\n夜倚闲看月，春扶醉上船。\n只愁规漆者，本体失天然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无心","author":"顾逢","text":"世态真堪笑，机深祸亦深。\n多谋还损己，有寿必无心。\n呕肺因诗苦，开怀遇酒斟。\n平生随造物，不暇问升沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无弦琴","author":"顾逢","text":"三尺孤桐古，其中趣最优。\n只须从意会，不必以声求。\n袖手时横膝，忘言自点头。\n孙登犹未悟，多却一丝留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜泛舟","author":"顾逢","text":"晴湖浮素练，芦苇冷秋霜。\n四望皆空阔，孤舟泛渺茫。\n水纹星动影，云缝月流光。\n不似渔翁乐，终身鸥鹭乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王巨卿御史西塾","author":"顾逢","text":"乌台清要地，门户少曾开。\n俗客无由入，诗人不惮来。\n闲云行碧落，倦马卧苍苔。\n再约中秋夜，同倾月下杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王质观棋","author":"顾逢","text":"弈边忘日月，况复遇神仙。\n石上无多著，人间几百年。\n指枰如料敌，落子欲争先。\n想尔腰柯烂，回头亦骇然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东陵方丈纳凉","author":"顾逢","text":"爱入高明处，云扉策杖登。\n暑威消宿雨，清话听高僧。\n骤马风檐铁，残星晚殿灯。\n山中凉可喜，涧水一泓冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜闻蛩","author":"顾逢","text":"尚有一蛩在，悲吟废草边。\n想于深夜里，自忆早秋前。\n胜负皆成梦，孤寒似可怜。\n晚年飘泊老，此况亦同然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢进斋湖上韵","author":"顾逢","text":"潦倒江湖上，光阴梦里过。\n黄金消酒债，白发苦诗魔。\n风细松琴慢，天晴柳絮多。\n断桥斜阳里，一路听笙歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厉杭云袖诗见访","author":"顾逢","text":"此心无所著，閒散似神仙。\n每日三餐饭，谁家一熟田。\n健吟输少俊，起思忆衰年。\n安得同携手，倘徉泉石边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古圆镜","author":"顾逢","text":"翠剥青铜面，年深入手轻。\n似教藏美恶，不欲大分明。\n细雨波心碎，浮云月底行。\n便令无点翳，谁解照前生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史紫微徐容斋阎静轩过潘阆巷所居","author":"顾逢","text":"门外喧车马，欢声震四邻。\n争疑来陋巷，不道访诗人。\n枉驾屈三老，开樽愧一贫。\n逍遥祠宇近，容邈亦精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"申屠雪矶见寄韵","author":"顾逢","text":"潘阆祠前住，天教得此邻。\n百年传盛事，一巷两诗人。\n老境羞磻水，高风想富春。\n但教樽有酒，不必更言贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发","author":"顾逢","text":"一茎白一茎，两鬓忽然更。\n难把黄金买，从教青镜明。\n染来还似旧，镊去又重生。\n多少人无此，相看未可轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白莲花","author":"顾逢","text":"种向东林得，此花真个希。\n芳心能自洁，玉体静相依。\n每讶鸥将浴，犹疑鹭不飞。\n月明无处认，香气袭人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石堂上人房夜坐","author":"顾逢","text":"秋夜坐来清，禅房静掩扃。\n希贤思益语，爱国读忠经。\n香篆行微蚓，灯花落小萤。\n西风怜寂寞，一曲奏檐铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖山居 其三","author":"顾逢","text":"越来溪上望，雨涨一篙深。\n折苇眠枯叶，老莲生苦心。\n水连孤屿远，山入半湖阴。\n喜近行春路，时于月下吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石湖山居 其二","author":"顾逢","text":"幽居入翠微，乐似在松时。\n野景俱成画，山行总是诗。\n黠禽争浴水，戏鹊倒悬枝。\n此意谁能识，徜徉只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再过悟竹庭房","author":"顾逢","text":"两度客僧庐，交情密似初。\n墨云胶冻砚，鬓雪落寒梳。\n鸣鹤声高下，盘鹰羽疾徐。\n此时亲老念，重读寄来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘萧云水阁","author":"顾逢","text":"亭台入画图，石怪树萧疏。\n池上多佳致，城中无此居。\n垂杨偏称鹤，宿鹭不惊鱼。\n酒罢出门去，云棱月一梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同吴心云避暑","author":"顾逢","text":"寺在深山里，轩窗面面嘉。\n画图看水石，僧供款茶瓜。\n台蚁搬生饭，池鱼喷落花。\n何人溪上住，竹林两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"字耕","author":"顾逢","text":"此田无水旱，只在砚池中。\n善作诸家体，能成八法功。\n墨痕生夏雨，笔颖熟秋风。\n蓑笠辛勤者，常忧岁不丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋湖上","author":"顾逢","text":"藕花香里去，独步自寻诗。\n秋意在何处，夕阳将下时。\n鸟幽忘立久，山好觉行迟。\n饮兴忽然动，桥边有酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤信卿新移书塾","author":"顾逢","text":"又见荣迁去，门多客往还。\n别开新缝帐，重对旧青山。\n孤塔秋风里，闲云远树间。\n西窗堪夜坐，有月不须关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤婆子","author":"顾逢","text":"皤然一器微，有用在冬时。\n永夜寒如许，孤衾暖不知。\n少年皆见弃，老者最相宜。\n却恨无情处，春来便别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牟少卿夫妇七十求诗","author":"顾逢","text":"未当求致仕，知命已先归。\n举案能同寿，如公者亦稀。\n庞眉天下老，绿发镜中希。\n吕望真堪笑，高年尚钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百舌","author":"顾逢","text":"得意春风里，山林异样鸣。\n虽无三寸舌，解作百禽声。\n巧处难求色，听时可辨名。\n金笼容不得，应是愧流莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹石园堂酒边即事","author":"顾逢","text":"到此须终日，相忘醉不成。\n一天惟有月，万籁绝无声。\n鱼口萍吞吐，萤光草晦明。\n夜阑重秉烛，犹对石棋枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红梅","author":"顾逢","text":"寿阳曾点额，脂粉带馀馨。\n晴雨看如醉，冰霜冻不醒。\n溪清羞洁白，色艳易飘零。\n桃杏休相忌，东君眼自青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老桂","author":"顾逢","text":"分得蟾宫种，凡葩岂足论。\n古香吹不尽，生意至今存。\n秋晚花三色，年深树半根。\n更无攀折日，此恨向谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖书院重建三贤堂 其二","author":"顾逢","text":"堂上瞻三像，衣冠各俨然。\n两朝贤太守，一代老诗仙。\n棠影春风里，梅花夜月边。\n西湖新学校，千载后同传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观斗蟋蟀有感","author":"顾逢","text":"徼虫亦可伤，何事苦争强。\n百胜终归死，一秋空自忙。\n吟残庭际月，冷怯草根霜。\n不入儿童手，谁能较短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访王文质西塾","author":"顾逢","text":"独对梅花坐，枝头数点开。\n画中无此景，雪里有僧来。\n饥鹤窥流水，行龟落冻苔。\n茶边清话处，一字共敲推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访金荪壁山居","author":"顾逢","text":"徐行策瘦筇，不觉过层峰。\n隐者在何处，白云知几重。\n细泉鸣碎石，远籁起高松。\n只恐南天竺，夕阳催暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过下竺清古源房","author":"顾逢","text":"草堂人别久，今日特相过。\n转觉交游少，徒增感慨多。\n岩花香宿雨，春叶暗庭柯。\n窗下破孤寂，幽禽啼翠萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过叶苔矶故居有感","author":"顾逢","text":"天井坊中过，令人忆故知。\n几回上心处，诸老倚楼时。\n犹记负暄稿，谁传咏史诗。\n坐间年最小，今已白髭眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过沈东林所居","author":"顾逢","text":"屋破深山里，门无车马尘。\n谁知青竹坞，中有白莲人。\n坐上长留客，诗中不见贫。\n池塘园圃乐，花木四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过秀邸赐第","author":"顾逢","text":"往年珠履客，独有老夫存。\n触目景非昔，伤心事莫论。\n楼台新白屋，瓦砾旧朱门。\n却忆朝回日，山堂共酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过净慈傅无文竹院退居","author":"顾逢","text":"李涉题诗处，轩窗一室明。\n游人闲半日，老子乐馀生。\n碧落云无影，清风竹有声。\n自言身后事，龛塔已圆成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过林石田湖上所居","author":"顾逢","text":"第一桥边住，柴扉傍钓矶。\n天晴扶杖出，寺近与僧归。\n梁燕穿帘去，沙鸥入屋飞。\n几回吟苦处，独立对斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过林和靖祠","author":"顾逢","text":"入得梅村去，烟云锁废祠。\n我来迟几日，花已过多时。\n童鹤看如活，山川变不知。\n游人休著句，不比暗香诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过林忠甫山房","author":"顾逢","text":"虽是无猿鹤，何殊林麓间。\n从教居近市，不必入深山。\n白日窗如炙，清风门自关。\n留连诗酒乐，坐久竟忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过僧房","author":"顾逢","text":"一饱听钟鱼，浮生百念疏。\n不知门外事，长对案头书。\n白日闲中过，青山深处居。\n老天怜供薄，夜雨长园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严月涧同饮湖边","author":"顾逢","text":"斗酒复斗酒，高歌山水边。\n世间无此乐，我辈即神仙。\n狂发花前笑，醉来松下眠。\n行人相偶语，堪作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劳心","author":"顾逢","text":"多少劳心者，青春已白髭。\n百年皆醉日，一死是醒时。\n天地蜉蝣化，江湖杜宇悲。\n此身元自赘，况复有妻儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听赵碧澜操琴","author":"顾逢","text":"弹来三尺桐，知用几年功。\n听到希声处，凉生不语中。\n断霞明似日，急雨过如风。\n曲罢炉香在，还思敏仲翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿吕浩翁端明","author":"顾逢","text":"寿乐长生宴，欢声满座频。\n华灯留五日，今夕庆千春。\n且作山中相，直诚天上人。\n儿孙列庭下，冰玉更相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵隐观风亭雪矶小酌","author":"顾逢","text":"林峦深密地，怪石紫苔存。\n留得巉岩势，全无斧凿痕。\n浮云沉水底，落叶走山根。\n最喜倾杯处，高僧遇老温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸鸢","author":"顾逢","text":"祇是凭风力，飞腾自不知。\n转来高处去，肯顾此身危。\n云外摇双翼，空中寄一丝。\n每愁吹断后，欲觅意何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花市","author":"顾逢","text":"卖声喧市巷，红紫售东风。\n祇说春无价，谁知雨有功。\n蝶随群檐出，莺恨故园空。\n松柏何人爱，甘心岩壑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳所堂赏桂杨顺斋酒边赋","author":"顾逢","text":"秋风芳所地，把酒又重来。\n种有仙凡异，花分早晚开。\n满簪乌帽去，如入月宫回。\n莫说郤诜事，功名念已灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居杂兴 其一","author":"顾逢","text":"满眼皆诗料，诗成稿自添。\n好山长在眼，终日不垂帘。\n风度云行水，鸟随花堕檐。\n炉香窗下坐，飞絮上书签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居杂兴 其二","author":"顾逢","text":"萧然一弊庐，门巷似樵渔。\n鸡犬情相得，山林乐有馀。\n霜浓黄木叶，雨过绿园蔬。\n独坐寒窗下，时看未见书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和文本公先生赠许端甫","author":"顾逢","text":"世上无难事，难中独有诗。\n看来都说易，吟到苦方知。\n潭影三年句，蝉声一字师。\n古人如此癖，刻烛未为奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吴中友人见寄韵","author":"顾逢","text":"孤踪水上萍，岂料过希龄。\n药圣贫难疗，钱神祷不灵。\n行云风断续，蜕叶雨飘零。\n半世知心者，书灯一点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林平山见寄韵","author":"顾逢","text":"劳劳终日者，少见白头时。\n过去事皆梦，未来人不知。\n偷生贫是福，真病药难医。\n学得巢由隐，无愁可上眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和移家春洲寄韵","author":"顾逢","text":"家具与妻儿，知经几处移。\n不堪多病日，顿忆少年时。\n犬吠风行叶，鱼惊月在池。\n人生俱是寓，无我重流离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山问梅","author":"顾逢","text":"欲扣陇头信，侵晨踏雪来。\n不知今夜里，先放几花开。\n地有孤根在，春从何处回。\n向人如解语，约我办樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山梅后","author":"顾逢","text":"晴雪白漫漫，山中几树残。\n但知开处好，谁向落时看。\n影不随流水，香犹在曲阑。\n飞来和靖鹤，相对立前滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上","author":"顾逢","text":"俗念枕边灰，晨钟又唤回。\n若无红日出，方免白头催。\n花不多时好，人谁百岁来。\n死生弹指顷，有酒且衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上怀卢进斋","author":"顾逢","text":"三载吴庠住，何由再合并。\n老来情不舍，枕上梦频成。\n撼树风终夜，敲窗雨数声。\n每思湖上酒，无日不同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨边对菊","author":"顾逢","text":"一片东篱菊，凄凉风雨边。\n花虽黄似旧，发更白于前。\n把酒伤今日，登高忆去年。\n渊明曾作令，相对亦无钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨窗即事","author":"顾逢","text":"羞将铁砚磨，万事总谈何。\n断酒除狂兴，看书起睡魔。\n霜林秋色惨，山馆雨声多。\n安得乘渔艇，空江挂绿蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]