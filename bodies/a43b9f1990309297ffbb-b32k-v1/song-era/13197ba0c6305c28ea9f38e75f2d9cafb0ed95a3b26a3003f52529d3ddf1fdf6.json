[{"title":"同广德和尚及诸禅伯游山有作次其韵","author":"饶节","text":"扪萝挽石复穿云，却叹公侯走世尘。\n碧嶂回眸三界小，红崖移步百花春。\n长沙只解随芳草，王老犹难避鬼神。\n不道游山末后句，瘦藤遥指牧牛人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次前韵","author":"饶节","text":"芒鞋短杖访松筠，未许痴禅继后尘。\n碧嶂烟岚千顷润，红崖花草四时春。\n林中傥遇狻猊兽，日下休看舜若神。\n却笑子湖穷鬼子，犹将消息问时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答吕居仁","author":"饶节","text":"向来相许济时功，大似频婆饷远空。\n我已定交木上座，君犹求旧管城公。\n文章不疗百年老，世事能磨双颊红。\n好贷夜窗三十刻，胡床趺坐究幡风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次前韵","author":"饶节","text":"曾将千古较穷通，芥孔能容几许空。\n借问折腰辞五斗，何如折臂取三公。\n四时但觉风雨过，一饭奚须刀匕红。\n要识坏魔三昧力，更培根垡待春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾友汪信民博士近闻参道甚力昨日得书云丧其偶其言耿耿有不释然者因寄此颂开之且挽其进","author":"饶节","text":"悼亡应作断肠声，此恨从来不易平。\n堕泪要知非转物，鼓盆政恐未忘情。\n疏亲憎爱无非妄，生死存亡但有名。\n著力早须无底钵，优昙在火更晶明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龟山戏赠谐文章","author":"饶节","text":"水母潭边窣堵波，下头有个老禅和。\n蒲鞋旧日曾供母，宝寿平生不渡河。\n衣钵三千旧风景，形模十二古头陀。\n是凡是圣人休问，门外寒松卷薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吕无求入山会宿北窗","author":"饶节","text":"驻车决遣底匆匆，求宿西湖北面峰。\n旋掩竹窗移短榻，徐敲冰瓮瀹长松。\n名高政恐为深累，道大由来自不容。\n顾我与公无二患，孤灯相对两疏慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无求用前韵作雪诗见寄亦次其韵","author":"饶节","text":"一夜花飞殿暮冬，晓惊银色现前峰。\n增肥幻质饶冰柱，埋没虚名叹瓦松。\n素纸不书思雪老，白圭无玷忆南容。\n知君岂乏扁舟兴，哦罢新诗兴已慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠灵岩德云庵主","author":"饶节","text":"道人遍历五家宗，归隐林间事事慵。\n棐几有时吟夜雨，杖藜随意倚寒松。\n插天户牖险更险，拔地楼台重复重。\n借问师庵在何处，巍巍坐断妙高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德云庵诗","author":"饶节","text":"岩下虚通上入云，众山围绕一山尊。\n德云只在此峰顶，童子何妨问法门。\n已种稚松三百本，待移苍竹一千根。\n不须更学药山老，月下啸声惊远村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵鉴碧轩","author":"饶节","text":"当轩方鉴碧溶溶，无事道人居此中。\n弟子来参洗钵话，朋游旧识钓鱼翁。\n一奁深渌桃花雨，数尺寒漪竹叶风。\n个处好怀谁共委，俯青飞鸟过晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次前韵","author":"饶节","text":"不待山腰转箨龙，一函寒碧自深中。\n未容濠上观鱼客，聊许双林照影翁。\n雨后蜗牛群饮月，春馀水马竞追风。\n井蛙海鳖难栖泊，会看长虹下晚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨梅","author":"饶节","text":"五月杨梅正满林，初疑一核价千金。\n味方河朔蒲桃重，色比泸南荔子深。\n飞碇似闻新入贡，登盘不见旧供吟。\n诗成欲寄山中旧，恐起头陀爱渴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵","author":"饶节","text":"南山北岭总成林，野妪名园独擅金。\n实熟每忧风雨横，根蟠谁念岁华深。\n品题可配荔枝谱，风味能忘庄舄吟。\n食罢蜜脾聊殿后，半钩新月在房心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏乞石菖蒲","author":"饶节","text":"古涧灵苗不易遭，寸根拳石著身牢。\n齐如秧稻刺春水，小似神龟负绿毛。\n未与幽人供寿考，曾随迁客赋离骚。\n阿师垂手入廛去，应许珍奇付我曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵卿山主梅花","author":"饶节","text":"岁事功成雪洗尘，化工著意制清新。\n遂教天下无双色，来作人间第一春。\n未许调羹傅岩老，聊从牵兴杜陵人。\n遥知月下绕千匝，桃李成蹊未是频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送广上人","author":"饶节","text":"师住匡庐南面山，飞来峰下略开单。\n时情淡薄知音少，吾道彫零行路难。\n何必善书须学卫，未应解义必师安。\n丈夫不用寻尘迹，自向虚空著羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵关子开","author":"饶节","text":"我初诖误辈簪缨，君亦前生失念僧。\n得意那知蚁旋磨，反身方悟鼠侵藤。\n高才自合参廊庙，朽质聊须活斗升。\n已破小团盟异日，速来相就凿春冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵答吕无求","author":"饶节","text":"聪明强健不聋丞，时出高言欲作僧。\n客至解衣挥玉麈，诗成落笔扫溪藤。\n园如靖节不难去，座比维摩岂易升。\n退食略无声色累，自磨煤麝写阳冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵答湛长老","author":"饶节","text":"阿师歌咏过腾腾，岂是寻常粥饭僧。\n自了木平三担土，何须寂子四挥藤。\n新诗似锦谁能濯，高论如天不可升。\n饭罢关门香一豆，净琉璃钵泛轻冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙向仲自灵隐归馀杭二首 其一","author":"饶节","text":"淡月晴风奏晓凉，春回草木被馀香。\n溪桥村落牛羊散，竹坞人家桑柘忙。\n大树稍疑经枥社，群鸡端恐过尸乡。\n年来课最何须问，翁媪茅檐话短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙向仲自灵隐归馀杭二首 其二","author":"饶节","text":"冷泉亭下漱甘凉，十里犹馀齿颊香。\n入境自知风俗厚，到家应觉簿书忙。\n好依名教穷真乐，莫指温柔是旧乡。\n此理不疑何用卜，谁论筮短与龟长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送以照上人","author":"饶节","text":"三年坐夏饱湖山，梦绕江南身未还。\n一见道人知妙质，暂闻乡语破衰颜。\n朱轮华毂何曾乏，白拂长藤自不闲。\n特立如师世无几，为君出户立潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵灵隐小轩","author":"饶节","text":"小轩容膝趣清深，只有溪风夜月侵。\n络石静移春后蔓，凌霄危露雨中心。\n松窗旧草秋蛇帖，棐几谁赓雪子吟。\n他日幽人问佳致，茂林修竹似山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答刘通判二首 其一","author":"饶节","text":"补牢初未益亡羊，始悔出山谋不臧。\n求志已甘长贸贸，应缘何苦自皇皇。\n曾更世上风涛阔，方悟闲中气味长。\n富贵如公非我比，春兰秋菊各馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答刘通判二首 其二","author":"饶节","text":"何事先生倦世荣，非贪水碧与山青。\n乞身高节恐难遂，捷径浮言固不经。\n闻道金丹能化鹤，岂同腐草止为萤。\n宰官本是随缘现，不碍他年叩玉扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晁以道赠杨中立诗有谈禅诋毁之语盖以讽予因用其韵解嘲且开之云","author":"饶节","text":"西来碧眼困津梁，只要教渠识旧乡。\n常恐佛魔相蹂躏，故提邪正为平章。\n好随鱼化禹门去，莫学蝇钻窗纸忙。\n诵帚忘苕解成道，可怜楚些漫沉湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用曾伯容韵赠不愚兄","author":"饶节","text":"丛林随处便安身，龙象何曾辈六群。\n盛德若愚常宴默，佳言如屑间缤纷。\n蒲团石上坐明月，茗椀松间打乱云。\n无限青山元属我，而今不免为中分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠伯容","author":"饶节","text":"放牛归马老将军，直道从来不党群。\n妙唱挥毫飞衮衮，高谈奋麈堕纷纷。\n文章千古陶元亮，笔札平生谷子云。\n惟有丁宁一大事，颇遭魔罥每瓜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和不愚兄庵颂三首 其一","author":"饶节","text":"此庵俄坏复俄成，步屧相从了此生。\n鹤不乘轩方自舞，莺非求友为谁鸣。\n冬菹弄色应分瓮，春荠闻香莫戛铛。\n月下相寻记低语，松间乌鹊恐飞惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和不愚兄庵颂三首 其二","author":"饶节","text":"四海归来坐太平，莫令华雨恼空生。\n归云无事朝犹卷，老马休心夜不鸣。\n胜处林泉九节杖，闲中日月二升铛。\n晓来乞火打庵户，想见春风一梦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和不愚兄庵颂三首 其三","author":"饶节","text":"常恨山居寡弟兄，阿师庵就可怜生。\n辅车岂但图相倚，独掌从来不浪鸣。\n野老献谋脩水硙，山童相唤借茶铛。\n年来活计浑成就，猿鹤安栖定不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用朱元方韵寄深明郎中二首 其一","author":"饶节","text":"当时冠盖集祇园，大似农夫值有年。\n庞老一言投马祖，陆侯彻底见南泉。\n古今已自融三际，语默何曾落二边。\n父子并为同社客，团栾应话老婆禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用朱元方韵寄深明郎中二首 其二","author":"饶节","text":"刹那念念转光阴，已过方来不住今。\n身似虚舟从不系，魔如敌国谩相侵。\n未能以幻还脩幻，岂暇将心更用心。\n以说为宗遍天下，思公一笑白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾伯容还汉上","author":"饶节","text":"轧轧篮舆来者谁，朝廷遗此一男儿。\n襟怀朗朗百间屋，局量汪汪万顷陂。\n异日小生端欲吏，迩来至德益堪师。\n赠行一句西来意，雨后春江渌渺瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵镜上人三首 其一","author":"饶节","text":"妙处从来自不传，少时喜乐似初禅。\n为山何止不成篑，掘井于今未及泉。\n自了一生同作梦，频麾万事付苍烟。\n因师聊作逢场戏，老马为驹不受鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵镜上人三首 其二","author":"饶节","text":"色声香味心缘触，忍进户檀般若禅。\n但识曹溪一滴味，始知天下别无泉。\n乳衣百浣犹闻气，城郭非遥早见烟。\n到底输他真定力，暮途快马亦须鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵镜上人三首 其三","author":"饶节","text":"相见无言意已传，不谈名利不谈禅。\n静如秋浦翘双鹤，清似寒岩落瀑泉。\n隐逸妄人居妙室，功名渠辈画凌烟。\n二流淼淼追难及，老大难挥马腹鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改德士颂五首 其一","author":"饶节","text":"自知祝发非华我，故欲毁形从道人。\n圣主如天苦怜悯，复令加我旧冠巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改德士颂五首 其二","author":"饶节","text":"旧说螟蛉逢蜾蠃，异时胡蝶梦庄周。\n世间物化浑如梦，梦里惺惺却自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改德士颂五首 其三","author":"饶节","text":"德士旧尝称进士，黄冠初不异儒冠。\n种种是名名是假，世人谁不被名谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改德士颂五首 其四","author":"饶节","text":"衲子纷纷恼不禁，倚松传与法安心。\n瓶盘钗钏形虽异，还我从来一色金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改德士颂五首 其五","author":"饶节","text":"少年曾著书生帽，老大当簪德士冠。\n此身无我亦无物，三教空名何处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法门复故圣恩深厚矣自此恐云巢不能久栖当为众一起承示佳句因用韵备载之","author":"饶节","text":"佛日光芒忽再悬，欢呼万国戴尧天。\n不须菩萨行求钵，自是如来许覆肩。\n云汉飞腾新放鹤，江湖游泳不烹鲜。\n云巢从此栖难稳，圭玉今逢丰富年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不愚兄再示佳句如璧亦重用来韵","author":"饶节","text":"圣慈何事辄翻然，日月从来本丽天。\n食座千冠□扫迹，禅堂百衲便差肩。\n朝三暮四浑堪笑，秋菊春兰岂斗鲜。\n但得时和汤饼足，不材从此尽天年。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比复僧相不愚戏作三颂恐傍观以谓吾徒实有喜愠故复次来韵不免道破兼寄祖禹同参道人","author":"饶节","text":"圣主生知本解禅，故教勘破普周天。\n一原大似东西水，同体何殊左右肩。\n把定丝毫浑沮丧，放开顷刻便芳鲜。\n衲僧败阙知多少，且笑髯舒三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵且召游山","author":"饶节","text":"劳生扰扰苦推迁，拟疏行藏细问天。\n壮岁同尊曲阜履，老来几拍洪崖肩。\n自闻新泽春雷动，喜见清诗蜀锦鲜。\n莫怪招呼玩花草，要回皓首作丁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"适承再示佳句亦强勉再成一首","author":"饶节","text":"摆落红尘罢作缘，从渠早晚离西天。\n何妨展轴卧翘足，未暇随人笑胁肩。\n但许南泉到痴钝，莫依投子觅新鲜。\n佛魔一扫双无用，陋矣庄生大小年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日一诗乃是见赠亦复次韵为报","author":"饶节","text":"阿师卧处白云连，几外千峰秀接天。\n渐畏声名收虎视，何尝骨相露鸢肩。\n雄风高论鹢飞退，皓雪新诗鹤夺鲜。\n老眼熨摩今有待，徵书同到起延年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复用韵成一首特作狡猾尔勿诮吾作梦也想当一笑","author":"饶节","text":"忆昔儿曹气尚全，逢人箕踞辄谈天。\n摄衣便欲探龙颔，唾手何辞举彘肩。\n自免敝冠归落寞，便磨馀墨坏华鲜。\n如今事事皆慵退，大似黄杨厄闰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复用韵自咏倚松一首","author":"饶节","text":"庵外无人谁过前，老松千丈独参天。\n煮茶春水渐过膝，却虎短墙才及肩。\n已退晚云归浩浩，未分芽菊竞鲜鲜。\n客来问我何时住，笑指松枝数岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日承佳赠浮实甚矣谨再用韵酬赠","author":"饶节","text":"尝遍诸方五味禅，不须鼻孔便撩天。\n自应猊座长垂手，只许巢云暂息肩。\n世外岂无羊氏鹤，人间多滞禹门鲜。\n便当勉为众生起，趁取灵芝三秀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复用前韵寄伯容兼其三子","author":"饶节","text":"高阁巍临汉水边，从来谈舌自摩天。\n华公不用徒辞位，哙等何堪复比肩。\n他日屡藏闾里骨，而今时纵校人鲜。\n庞公父子皆知道，试问王家三少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵戏作二庵图","author":"饶节","text":"人说双庵鹘壁巅，妙高峰顶四禅天。\n梦魂似亦曾招手，千里犹堪论比肩。\n渌水白云同一妙，苍松翠竹自相鲜。\n谁能为作虎头画，传与人间五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不愚兄示上元佳句谨次韵为笑","author":"饶节","text":"溪云酿雪展还收，数日春严罢出游。\n月竹萧萧香转座，瓶汤隐隐被蒙头。\n一灯聊破上元梦，半夜稍增涂足油。\n说妙谈玄吾不会，从教高挂雪峰毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次前韵","author":"饶节","text":"佳节山家事事休，一庵容膝自优游。\n残梅韵胜窥篱落，满月光寒上陇头。\n不待玄沙行乞火，何须投子更携油。\n夜深自倚蒲团困，谁问渠侬马打毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵戏纪山中之胜","author":"饶节","text":"人既无心境自幽，问渠何事世间游。\n连云自种兰千本，带雪新栽橘数头。\n已架酴醾连外户，便留薝卜压香油。\n明年不怕春寒重，收拾东风柳絮毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵奉赠巢云兄","author":"饶节","text":"南有雪峰北赵州，横担拄杖遍曾游。\n四方丛席闹如市，几个衲僧真到头。\n万里山川困行李，三冬文史费膏油。\n何如了事巢云老，解打湍流水上毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老懒一首亦次元韵","author":"饶节","text":"枕石眠云漱碧流，胸中元自有天游。\n庄生达士方疑梦，演若狂夫正怖头。\n未了色空鱼畏絖，不忘念慧钵持油。\n老夫无此闲家具，一任年华若转毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"均父约去年十月还襄阳今已二月矣尚未闻汉上消息因诵旧寄渠诗二首用其韵寄之 其一","author":"饶节","text":"闻道祁阳已赐环，春来何事未言还。\n移书汉上二三友，寄梦湖南千万山。\n顾我幸缘樗散老，知侬真坐虎文斑。\n归来此度心应死，不待丸泥封汉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"均父约去年十月还襄阳今已二月矣尚未闻汉上消息因诵旧寄渠诗二首用其韵寄之 其二","author":"饶节","text":"归期小雪已中春，常恐传言远未真。\n慎莫锱铢论得丧，政须平等视冤亲。\n悬知江海山林士，不中功名富贵人。\n闻道扁舟期访我，来时莫带庾公尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵承之殿撰二首 其一","author":"饶节","text":"第一流中能几人，瑶林琼树恐无邻。\n恬游事外缘闻道，忧到眉端止为民。\n出处不哗浑入妙，文章无意自通神。\n头青面雪关渠事，要作菖蒲几研春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵承之殿撰二首 其二","author":"饶节","text":"晚辞富贵功名士，竟作东西南北人。\n早岁衣冠如昨梦，平生笔墨累闲身。\n时情尺水翻千丈，世故秋毫寓一尘。\n自有使君天上士，新诗挥扫唤人频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]