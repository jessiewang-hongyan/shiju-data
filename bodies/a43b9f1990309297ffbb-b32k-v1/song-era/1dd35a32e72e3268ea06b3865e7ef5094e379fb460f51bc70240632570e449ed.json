[{"title":"钓台","author":"范师道","text":"乾坤交泰重弥纶，当日严陵道最淳。\n大汉中兴得英主，先生高退作闲人。\n滩头风月遗千古，台上纶竿寄一身。\n今日病夫祠下过，独知疲懦长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题隐圃赠蒋希鲁","author":"范师道","text":"勇退人难事，明公识虑长。\n波涛济舟楫，霜雪见松篁。\n林下开前圃，花间撤亚枪。\n二疏良宴会，老杜好篇章。\n道向清来胜，机于静处忘。\n当除印如斗，试一较閒忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天平山","author":"范师道","text":"万物天地间，或有奇胜迹。\n见赏能几人，不止今与昔。\n吴门多好山，天平为峻极。\n旦暮常白云，表里皆珍石。\n烟岚十里光，松桂四时色。\n我因一纵游，烦襟为开释。\n感古怀君子，翻然长太息。\n乐天赏云泉，诗章何历历。\n垂今数百年，继者漠然寂。\n间遇希文来，双旌守乡国。\n行春三让原，吟哦尽所得。\n子美天与才，寻幽多采摭。\n赋百五十言，平地黄金掷。\n三贤固有名，山亦资辉赫。\n此去还几年，不逢好事客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一篙","author":"范成大","text":"一篙新绿浦东西，雪絮漫江雁不飞。\n宿雨才晴风又转，片帆那得及时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七十二冢","author":"范成大","text":"一棺何用冢如林，谁复如公负此心。\n闻说群胡为封土，世间随事有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七里店口占","author":"范成大","text":"分手暮江寒，徘徊立马看。\n寻常相见易，倍觉别离难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日忆菊坡","author":"范成大","text":"菊坡长恨隔横塘，城郭山林自不双。\n放棹松江花已远，涛江之外更鄞江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十日南山见梅","author":"范成大","text":"五斗留连首屡回，来寻南涧濯尘埃。\n春风直恐渊明去，借与横斜对菊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月五日晴暖步后园","author":"范成大","text":"海气烘晴入断霞，半空云影界山斜。\n轻罗小扇游蜂畔，只比东风有菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九盘坡布水","author":"范成大","text":"莫惜萦回上九盘，洗心双瀑雪花寒。\n野翁酌水煎茶献，自古人来到此难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入城","author":"范成大","text":"十里清风一饷间，片帆真欲解人颜。\n林家庄近闻鹅鸭，船到阊门尽未关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入崇宁界","author":"范成大","text":"桑间三宿尚回头，何况三年濯锦游。\n草草郫筒中酒处，不知身已在彭州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月二十二日寓直玉堂雨后顿凉","author":"范成大","text":"雨意蒸云暗夕阳，浓薰满院落花香。\n题诗弄笔北窗下，将此工夫报答凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月大雾中自胥口渡太湖","author":"范成大","text":"白雾漫空白浪深，舟如竹叶信浮沉。\n科头晏起吾何敢，自有山川印此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十六日三偈 其二","author":"范成大","text":"有个安心法，无时不可行。\n只将今日事，随分了今生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十六日三偈 其一","author":"范成大","text":"声闻与色尘，普以妙香薰。\n昔汝来迷我，今吾却戏君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十六日三偈 其三","author":"范成大","text":"窗外尘尘事，窗中梦梦身。\n既知身是梦，一任事如尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二日北门马上","author":"范成大","text":"新街如拭过鸣驺，芍药酴醾竞满头。\n十里珠帘都捲上，少城风物似扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月四日骤煖","author":"范成大","text":"日脚融晴晚气暄，睡馀初觉薄罗便。\n如何柳絮沾泥处，煖似槐阴转午天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三江亭观雪","author":"范成大","text":"阴山阳朔雪中回，行到天西玉作堆。\n乘兴却游东海上，白银宫阙认蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自晨至午起居饮食皆以墙外人物之声为节戏书四绝 其四","author":"范成大","text":"起傍东窗手把书，华颠种种不禁梳。\n朝餐欲到须巾裹，已有重来晚市鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自晨至午起居饮食皆以墙外人物之声为节戏书四绝 其一","author":"范成大","text":"巷南敲板报残更，街北弹丝行诵经。\n已被两人惊梦断，谁家风鸽斗鸣铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自晨至午起居饮食皆以墙外人物之声为节戏书四绝 其三","author":"范成大","text":"北砦教回挝鼓远，东禅饭熟打钟频。\n小童三唤先生起，日满东窗煖似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自晨至午起居饮食皆以墙外人物之声为节戏书四绝 其二","author":"范成大","text":"菜市喧时窗透明，饼师叫后药煎成。\n閒居日出都无事，惟有开门扫地声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上沙","author":"范成大","text":"水边犬吠隔疏林，篱落萧森日半阴。\n繁杏锁红春意浅，晚梅飘粉暮寒深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上沙舍舟","author":"范成大","text":"村北村南打稻声，竹舆随处款柴荆。\n斜阳倒景天如醉，明日山行更好晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上沙遇雨快凉","author":"范成大","text":"刮地风来健葛衣，一凉便觉暑光低。\n云头龙挂如垂箸，雨在中峰白塔西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书樊子南游西山二记后 其二 大面","author":"范成大","text":"春晚娑罗百叶开，仙翁精舍长蓬莱。\n朝元未罢门深闭，不管人间有客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与现寿二长老游寿泉因话去年林屋之游题赠 其二","author":"范成大","text":"松风放浪入云关，二衲相从一士閒。\n人与瘦筇俱老健，去年今日在包山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与现寿二长老游寿泉因话去年林屋之游题赠 其一","author":"范成大","text":"何年锡杖斸清甘，天遣深源寿此庵。\n金靥万枝浮倒影，为君题作菊花潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与郑少融赵养民二使者访古訾家洲归憩松关二君欲助力兴废戏书此付长老善良以当疏头","author":"范成大","text":"飘飘竹雨润轻裘，袅袅松风系小舟。\n安得从容兴废手，越人重上訾家洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨地湿","author":"范成大","text":"汗础经旬未肯乾，破窗随处有蜗涎。\n只今不耐春阴得，想见黄梅细雨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"于潜","author":"范成大","text":"邑居官寺两凄清，晚市都无菜可羹。\n何处直能令鬼怕，祗今犹自有人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口号","author":"范成大","text":"我是苏州监本呆，与爷上寿献棺材。\n宗室元来是皇族，雨下水从屋上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风","author":"范成大","text":"春晴虽好恨多风，到眼花枝转眼空。\n晴不与花为道地，争如云淡雨濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大风","author":"范成大","text":"飓母从来海若家，青天白地忽飞沙。\n烦将残暑驱除尽，只莫颠狂损稻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大宁河","author":"范成大","text":"梨枣从来数内丘，大宁河畔果园稠。\n荆箱扰扰拦街卖，红皱黄团满店头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大扶?","author":"范成大","text":"身如鱼跃上长竿，路似镜中相对看。\n珍重山丁扶我过，人间踽踽独行难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大波林","author":"范成大","text":"湖路荒寒又险艰，大千空水我居间。\n篙师晚始分南北，指点青青汉口山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大通界首驿","author":"范成大","text":"愚悃无华敢自欺，寸诚珍重吏民知。\n东风重倚庭前树，送别人情似到时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大雪送炭与芥隐","author":"范成大","text":"无因同拨地炉灰，想见柴荆晚未开。\n不是雪中须送炭，聊装风景要诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大黄花","author":"范成大","text":"大芋高荷半亩阴，玉英危缀碧瑶簪。\n谁知一叶莲花面，中有将军剑戟心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小春海棠来禽","author":"范成大","text":"东君好事惜年华，偏爱荒园野老家。\n一任西风管摇落，小春自管数枝花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小涧","author":"范成大","text":"石碍珠旒溅，滩平雾縠铺。\n小童能好事，系马斸菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山径","author":"范成大","text":"云根新径络山腰，暗绿交阴宿露飘。\n行到竹深啼鸟闹，鹁鸠老怨画眉娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山顶","author":"范成大","text":"翠屏无路强攀缘，我与枯藤各半仙。\n不敢高声天阙近，人间漠漠但寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马迹石","author":"范成大","text":"跨马凌空亦快哉，龙腰鹤背谩徘徊。\n游人欲识仙踪处，但觅苍崖白塔来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月三首 其一","author":"范成大","text":"儿女无悰坐客稀，今年孤负隔年期。\n谁从天上牢遮月，不管人间大欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月三首 其二","author":"范成大","text":"扑地痴云欲万重，家家帘幕护房栊。\n世间第一无情物，谁似中秋雨与风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月三首 其三","author":"范成大","text":"一生露下风前客，两岁愁边病里身。\n姑置阴晴圆缺事，药寮灯火正相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋后两日自上沙回闻千岩观下岩桂盛开复舣石湖留赏一日赋两绝 其一","author":"范成大","text":"金粟枝头一夜开，故应全得小诗催。\n篮舆缓缓随儿女，引入天香洞里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋后两日自上沙回闻千岩观下岩桂盛开复舣石湖留赏一日赋两绝 其二","author":"范成大","text":"千岩观下碧瑶林，岁晚青青共此心。\n隐士归兮花未老，每年来把一杯深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋清晖阁静坐因思前二年石湖四明赏月","author":"范成大","text":"前年银界接天迷，去岁金盘涌海低。\n漂泊相逢重一笑，秦淮东畔女墙西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二绝再送文季高兼呈新帅阎才元侍郎 其一","author":"范成大","text":"剑关云栈守非难，函谷泥封久未刊。\n今日汉中谁国士，莫教春草上斋坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二绝再送文季高兼呈新帅阎才元侍郎 其二","author":"范成大","text":"西出阳关有旧知，薰风渌水泛莲时。\n烦君传语诗书帅，更寄台城别后词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书樊子南游西山二记后 其一 牡丹瓶","author":"范成大","text":"仙山草木锁卿云，不到花平不离尘。\n十丈牡丹如锦盖，人间姚魏却争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云间湖光亭","author":"范成大","text":"微风不动敛涛湍，组练晶晶色界寒。\n斜照发挥犹未尽，月明残夜更来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云露堂前杏花","author":"范成大","text":"蜡红枝上粉红云，日丽烟浓看不真。\n浩荡光风无畔岸，如何锁得杏园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月闻莺二首 其二","author":"范成大","text":"一声初上最高枝，忙杀呕哑百舌儿。\n老尽西园千树绿，却怜槐眼正迷离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月闻莺二首 其一","author":"范成大","text":"桑阴净尽麦头齐，江上闻莺每岁迟。\n不及晓风鹎鵊子，迎春啼到送春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从巨济乞蜡梅","author":"范成大","text":"寂寥人在晓鸡窗，苦忆花前续断肠。\n全树折来应不惜，君家真色自生香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从宗伟乞冬笋山药","author":"范成大","text":"竹坞拨沙犀顶锐，药畦粘土玉肌丰。\n裹芽束缊能分似，政及莱芜甑釜空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以狨坐覆蒲龛中","author":"范成大","text":"蠹蚀尘昏度几年，蒙茸依旧软如绵。\n且来助煖乌皮几，莫忆冲寒紫绣鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕四首 其四","author":"范成大","text":"落梅秾李趁时新，枯木崖边一任春。\n尚爱乡音醒病耳，隔墙时有卖饧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕四首 其三","author":"范成大","text":"药炉汤鼎煮孤灯，禅版蒲团老病僧。\n儿女强修元夕供，玉蛾先避雪鬅鬙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕四首 其一","author":"范成大","text":"粉痕红点万花攒，玉气珠光宝月团。\n帘箔通明香似雾，东君无处著春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕四首 其二","author":"范成大","text":"不夜城中陆地莲，小梅初破月初圆。\n新年第一佳时节，谁肯如翁闭户眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕大风雨二绝 其一","author":"范成大","text":"东风无赖妒华年，一夜凄寒到酒边。\n放尽珠帘遮画炬，莫教檐雨湿青烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕大风雨二绝 其二","author":"范成大","text":"河倾海立夜翻盆，不独妨灯更损春。\n冻涩笙簧犹可耐，滴皴梅颊势须嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夕泊舟霅川","author":"范成大","text":"莲炬光中月自圆，人情草草竞华年。\n最怜一夜旗亭鼓，能共钟声到客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日马上二绝 其一","author":"范成大","text":"泥絮心情雪样髯，诗囊羞涩酒杯嫌。\n年来万事都消减，惟有床头历日添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日马上二绝 其二","author":"范成大","text":"筋骸全比去年非，骑吹声中忆钓矶。\n待得江风欺老病，何如闻健一蓑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内丘梨园","author":"范成大","text":"汗后鹅梨爽似冰，花身耐久老犹荣。\n园翁指似还三笑，曾共翁身见太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刈麦","author":"范成大","text":"麦头熟颗已如珠，小阨惟忧积雨馀。\n丐我一晴天易耳，十分终惠莫乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双庙","author":"范成大","text":"平地孤城寇若林，两公犹解障妖祲。\n大梁襟带洪河险，谁遣神州陆地沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双燕","author":"范成大","text":"底处飞双燕，衔泥上药栏。\n莫教惊得去，留取隔帘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]