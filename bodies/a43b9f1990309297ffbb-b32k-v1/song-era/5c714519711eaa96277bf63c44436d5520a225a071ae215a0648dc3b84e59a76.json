repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和四兄清泉香饼子","author":"晁冲之","text":"清绝端因柏子香，风流特可付文房。\n如何石火须臾顷，得尽人间一日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和集津兄谢王立之红丝花","author":"晁冲之","text":"故园桃李秋摇落，扫地无花可恼公。\n近说城南王子妓，亦持红拂剧西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和新乡二十一兄华严水亭五首 其三","author":"晁冲之","text":"嗜酒不知淹岁月，好闲久欲弃簪缨。\n暂游莲社同陶令，终向瓜田学邵平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和新乡二十一兄华严水亭五首 其二","author":"晁冲之","text":"池水泠泠渌未深，丛篁低草背庭阴。\n晚来欲别龟鱼去，更向轩西独瞰临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和新乡二十一兄华严水亭 其一","author":"晁冲之","text":"近市危楼通野寺，隔溪高柳接京华。\n荡舟不怕风波急，看尽芙蓉十里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞道二十三弟","author":"晁冲之","text":"千载风流贺秘书，也知今有此人无。\n吾家父子真相似，不愧朝廷乞鉴湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜伯武丈山寺","author":"晁冲之","text":"松门石磴隐山家，钟鼓萧然一院花。\n斋罢老僧来施食，阶前驯雀趁饥鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚圃田道中三首 其三","author":"晁冲之","text":"君王重老降褒书，特赐宣阳宅一区。\n闻说会稽人不识，鉴湖还肯借臣无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚圃田道中三首 其二","author":"晁冲之","text":"酒酣驰马笑弯弓，便拟长驱向虏中。\n但恐老儒无骨相，不堪剑履画南宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚圃田道中三首 其一","author":"晁冲之","text":"度柳穿桥听午鸡，一沟春水国门西。\n行人不用伤新别，看取尘间万马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人游江南","author":"晁冲之","text":"涌金门外断红尘，衣锦城边着白蘋。\n不到西湖看山色，定应未可作诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送韩温父","author":"晁冲之","text":"东风未晓放船行，卧唱阳关发渭城。\n老去与人浑惜别，不知何处可忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫春书事","author":"晁冲之","text":"少年犹在老书生，酒后思家夜起程。\n自佩弓刀防不测，独随骡驮雨中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读陈平传","author":"晁冲之","text":"刘郎白首尚多疑，百战功臣迹转危。\n致使文成谢封邑，未如还荐魏无知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中","author":"晁冲之","text":"北风吹雨不能晴，羸病人骑瘦马行。\n须发向来浑白尽，半缘忧患半多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谩兴","author":"晁冲之","text":"苻郎传檄度江南，谢老风流倚翠岚。\n但自围棋君莫问，顾轮别墅乞羊昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春","author":"晁冲之","text":"溅溅流水曲穿沙，林叶深深不过鸦。\n自恨春来浑不识，殷勤着地拾残花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题超化寺壁","author":"晁冲之","text":"曲池风定碧澜平，小白鱼如镜里行。\n水竹再来应试我，壁间不用更题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠江端本子我","author":"晁冲之","text":"亸免鸡豚今日债，断除妻子宿生缘。\n丰登便是人天供，努力东皋自种田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小魏买马久不至以诗寄之","author":"晁冲之","text":"闻说黄金厩，骐驎惜别群。\n犹来果下马，不必五花纹。\n骏骨愁时晚，芗萁念夕矄。\n老夫慵杖屦，待汝入嵩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤心","author":"晁冲之","text":"沙路朱轓想驭轩，伤心岁月似星奔。\n平泉有墅空流水，绿野无人但绕垣。\n九老画图传盛事，四朝书史载殊恩。\n如何圬者持镘过，已向比邻问子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再至都成","author":"晁冲之","text":"峥嵘花萼西，清晓望犹迷。\n御路红尘合，宫槐碧瓦齐。\n夹城知辇过，复道觉香低。\n中使传宣入，千门避马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次四兄韵效李义山雪","author":"晁冲之","text":"莫冬一丈长安雪，壮士临风独慨慷。\n门巷岂无骑马客，江湖犹有捕鱼郎。\n夜平蔡贼兵轻敌，晓入梁园赋擅场。\n载酒欲寻谁与饮，江梅头白自悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次君表韵答叶少蕴甥","author":"晁冲之","text":"老去幽栖谁比数，传君诗一邑人惊。\n敢叨礼亦推甥舅，借问年犹愧弟兄。\n今日蓍龟真有望，终身木雁两无成。\n凡才那可供□去，目送飞霞向赤城。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵再答少蕴知府甥和四兄长句并见寄二首 其二","author":"晁冲之","text":"尘埃自与青云断，岁月谁令白发来。\n数口无归关外客，一春多病几登台。\n常閒水上鸥从远，只老笼中鹤任开。\n日日避愁无处脱，直须到手不停杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵再答少蕴知府甥和四兄长句并见寄二首 其一","author":"晁冲之","text":"锦袍昔是诗成得，别墅今非棋赌来。\n山蔚蓝光交抱舍，水桃花色合围台。\n通人竹坞深深入，谢客松扉远远开。\n定与西湖争胜负，只应惟欠使君杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵江子我见寄","author":"晁冲之","text":"敢恨新居僻，深怀故国尊。\n耕耘得遗物，版筑尚颓垣。\n溪隔城南寺，崖通市北门。\n他时如访我，但认语音存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵集津兄怀嵩少示王立之","author":"晁冲之","text":"早闻三十六峰前，愿寄茅茨一涧边。\n谷转马蹄山缭绕，嵓开虎口树婵娟。\n阳坡日煖宜瓜地，阴岭天寒熟芋田。\n便好与公相隐去，不宜相对尚茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自然诗","author":"晁冲之","text":"先生手不废经营，白屋凭虚结此亭。\n燕夌兔丝侵密坐，南箕北斗挂疏棂。\n青松夹日交倾盖，翠柏分风倚列屏。\n莫道君家无长物，案头灯火有流萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日","author":"晁冲之","text":"短晷催长至，新晴改故阴。\n风霜游子鬓，节序异乡心。\n合坐呼卢转，分曹举白深。\n百年家魏阙，存没一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至东里次前韵","author":"晁冲之","text":"茂陵家四壁，不必在成都。\n老矣招魂苦，伤哉问影孤。\n市中宁有虎，屋上岂无乌。\n四海皆行路，吾何必此途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行武涉田中","author":"晁冲之","text":"惯习儿童喜，从容父老欢。\n桔槔看俯仰，稼穑愧艰难。\n荷叶生池岸，蒲萄落井干。\n求田如得此，当为驻征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行泌水上","author":"晁冲之","text":"肃肃郊原静，牛羊草树间。\n石矶寒不扫，水阁静常关。\n故里无消息，孤城绝往还。\n多愁独来此，犹得见河山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陈无己墓","author":"晁冲之","text":"以我怀公意，知公待我情。\n五年三过客，九岁一门生。\n近访遗文录，重经故里行。\n寄书无郑尹，谁为葬彭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问讯次九日韵","author":"晁冲之","text":"问讯西南戍，提封莫远开。\n休传通蜀道，端可弃轮台。\n拟上平戎策，惭无属国才。\n何须千里马，远自渥洼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初来东里","author":"晁冲之","text":"乘流从此去，河汉失清都。\n送骑沙边散，征帆雨外孤。\n挟雌栖陇雉，生子哺巢乌。\n宇宙将安往，飘飘尽畏途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别饰道二十弟","author":"晁冲之","text":"少傅三朝老，文章壮九州。\n赋诗资政殿，赐字太清楼。\n拔烛辞轩陛，簪花近冕旒。\n庆门吾老矣，华国汝能不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别饰道二十弟","author":"晁冲之","text":"飘零南北一衰门，知是澶渊五世孙。\n嗟我独无兄弟在，怜君尚有典型存。\n老身素苦贫常瘦，病目仍缘哭转昏。\n他日汝归驰驷马，访吾肯过浣花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别昭德弟怆然伤怀","author":"晁冲之","text":"吾庐去汝到何期，四十年间此别离。\n合抱树元从旧种，几丛菊始自新移。\n老无兄弟飘零日，远有公卿旷绝时。\n努力不思勤负米，欲求三径可从谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别息道士二十弟","author":"晁冲之","text":"中令有清德，风流二百年。\n举家惟食粥，绝口不言钱。\n里闬容吾老，庭闱赖汝贤。\n陶丘过范蠡，莫泛五湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀王立之","author":"晁冲之","text":"不到城南久，黄梅几度新。\n忽看人日作，泪尽大和春。\n翰墨犹如在，壶觞不复陈。\n常思醉风度，花底岸纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀苏门山","author":"晁冲之","text":"昔在新中日，苏门岁一游。\n石连沙凿凿，水绕竹悠悠。\n丘壑从兹得，江山及此不。\n吾衰思卜筑，城阙恨淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人游李文和园","author":"晁冲之","text":"北李园池推甲第，西冈人物复诸生。\n乘鸾此地回缑岭，走马何人出大明。\n六月火云无复暑，百年水木有馀清。\n敢陪宾客追前辈，知子能诗近得声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶甥少蕴内翰重开西湖见寄二首 其二","author":"晁冲之","text":"一麾偃蹇江湖去，五马侵寻观阙来。\n就日金波通汉苑，望云玉涧断苏台。\n自迎楫立看时渡，手种花行到处开。\n笑语风流韩别驾，莫令鹦鹉诉馀杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶甥少蕴内翰重开西湖见寄二首 其一","author":"晁冲之","text":"使君重凿西湖罢，也复封诗寄我来。\n洲上新题花岛处，苑中旧体柏梁台。\n风烟直觉钟山近，鱼鸟浑疑涧水开。\n挥翰玉堂还有日，行春停骑且留杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和四兄闲居感叹有作","author":"晁冲之","text":"掩卷忽不乐，扪心空浩叹。\n家声畏沦坠，世态属艰难。\n月倒迎门屣，风弹挂壁冠。\n萧然对孤竹，一笑共衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和寄叶甥少蕴内翰见招","author":"晁冲之","text":"翰林赫奕今如此，莫道人惟旧雨来。\n庞老终身远州府，刘郎何面向春台。\n园宜杏子非时结，溪阔梅花过日开。\n两地声闻无百里，相望一覆手中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞道二十三弟","author":"晁冲之","text":"向别已复久，此怀谁与明。\n书来慰吾意，诗重识君情。\n放鹤惜未到，飞鸿今尚横。\n何由一随汝，端为薄浮名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范元章惠然相过见问奇章公服钟乳三千两事因为长句戏之","author":"晁冲之","text":"君家文物冠先朝，破甑生尘久寂寥。\n借有三千两钟乳，定无八百石胡椒。\n湘妃暗鼓卦边瑟，秦女高吹月下箫。\n不待青春行乐了，直持玉检上宸宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亭成","author":"晁冲之","text":"故里佗年隐，新亭此日成。\n江山俱有助，草木尽知名。\n圃菊黄浮酒，汀莼紫泛羹。\n松风如与便，愿许从诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用韵","author":"晁冲之","text":"史奏德星今复聚，乡评月旦昔何惊。\n颍川人望须公守，荀氏家声付此兄。\n湖影龟鱼同聚散，棠阴燕雀半生成。\n若为修禊无丝竹，古调新诗唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复和少蕴内翰甥兼谢伯蕴通判兄再赠","author":"晁冲之","text":"西湖波浪还佳色，风物悲人老可惊。\n游接竹林公对叔，梦迷春色我思兄。\n酒沽鹦鹉杯行尽，诗傍蟾蜍研立成。\n壮思不逢韩吏部，高名谁伴谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客有驽马不肯借诗诮之","author":"晁冲之","text":"胡儿少欲立奇功，贵买西宛玉面骢。\n金躞蹀微鸣蹑影，锦连钱不动追风。\n庭槐洗立清阴下，沙路调行返照中。\n出郭借人乘岂肯，自誇骑入大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼寝","author":"晁冲之","text":"闻说齐州路，遥通古睡乡。\n云岩迷傅说，风峡宴襄王。\n日月星辰静，山川草木长。\n不知三代贵，何似一张床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨感事","author":"晁冲之","text":"苦雨荒秋宅，寒生木叶悲。\n半垂藤护壁，中缺蔓穿篱。\n书校时开帙，壶提日系丝。\n儒冠吾已误，何责五男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荥泽驿阻雪","author":"晁冲之","text":"去年冬不雪，今雪太匆匆。\n轻薄愁兼雨，攲斜怯受风。\n雁依寒浦静，鸦噪暮林空。\n憔悴西征客，惟应白发同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王敦素","author":"邓深","text":"龙蟠山色引衡庐，霜落江清影碧虚。\n鼓枻厌骑沙苑马，行厨饫食武昌鱼。\n缓歌玉树翻新曲，趣入金銮续旧书。\n官达故人稀会面，君来相见肯如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送惠纯上人游闽","author":"晁冲之","text":"蚤听闽人说土风，此身尝欲到闽中。\n春沟水动茶花白，夏谷云生荔子红。\n襟带九江山不断，梯航百粤海相通。\n北窗夜展图经看，手自题书寄远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]