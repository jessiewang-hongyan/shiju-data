[{"title":"次韵朱少章芦桥柳桥二首 其一","author":"晁冲之","text":"芦桥复柳桥，芦枯柳可爱。\n不厌春与秋，主人客有待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵江子我蜡梅二首 其二","author":"晁冲之","text":"江城仍似锦城无，半额轻黄笑越姝。\n我亦少花如杜老，舍南为乞两三株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵江子我蜡梅二首 其一","author":"晁冲之","text":"步屧穿花醉晓风，翻枝摘叶兴何穷。\n他年上苑求佳种，越白江红扫地空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈叔易芦桥柳桥二首 其二","author":"晁冲之","text":"桥阔狭如马，芦高低似人。\n白蘋洲上客，枉恨洞庭春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈叔易芦桥柳桥二首 其一","author":"晁冲之","text":"落日河梁上，迟留客去时。\n近邻无远送，莫说最长枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过王立之故居","author":"晁冲之","text":"酴醾架倒花仍发，薜荔墙摧石亦移。\n此地与君凡几醉，年年同赋蜡梅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陈无己墓","author":"晁冲之","text":"锁门脱落封将尽，题壁污漫字不分。\n我亦尝