[{"title":"了明上人","author":"释祖钦","text":"了明明了，孤光皎皎。\n夜永月寒，云开天晓。\n二浙江山拄杖头，脱略根尘静悄悄。\n大明当空，无幽不照。\n如是行脚，行脚事了。\n百炼精金，由指而绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"了恩典座","author":"释祖钦","text":"十二时中，承谁恩力。\n俯仰折旋，不须外觅。\n著衣吃饭，一了便了。\n开眼天明，是谁不晓。\n大地沙门只眼睛，丈六金身一茎草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马郎妇","author":"释祖钦","text":"谩说教人学诵经，胸中泾渭甚分明。\n金沙影里无穷数，散作一滩流水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"允宽上人","author":"释祖钦","text":"初无允诺，宽著程限。\n一似跳黄河，尽力要合眼。\n跳过跳不过，直要横担板。\n南北天高云淡淡，渔歌秋色晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元觉上人","author":"释祖钦","text":"妙觉明净，元无所觉。\n如鄱阳湖，秋波不作。\n亦若匡庐，云平月壑。\n笠顶西风闲去来，拄杖头边空索索，打碎灵龟壳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞","author":"释祖钦","text":"六年饥饿，半夜痴狂。\n贫儿拾得锡，赤脚走忙忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释祖钦","text":"一笑生春风，双瞳湛秋水。\n日月拄杖头，乾坤布袋里。\n弥勒忽然下生，何处寻你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"本来上人","author":"释祖钦","text":"本不曾来亦不去，百二十日如是住。\n昨夜西风忽转头，花开阑畔木犀树。\n收拾行囊话起单，集云东湖来去间。\n双桂枝头冷消息，却与荷花香一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"本善上人","author":"释祖钦","text":"本来面目，善自参详。\n六般神用，昼夜放光。\n不须拟议，切忌承当。\n风前一阵木犀香，金粟花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"传义上人","author":"释祖钦","text":"直指之道，义不可传。\n不立文字，昭昭现前。\n万里不挂片云，一亘白日青天。\n声前有意，句后无言。\n理事双遣也，木头碌碡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如山上人","author":"释祖钦","text":"绝毫绝釐，如山如岳。\n万里高飞，遥空一鹗。\n见不到处，天涯海角。\n智不及处，大圆满觉。\n西风萧条黄叶落，古殿深沈撼金铎，却悔当初赚行脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如珠上人","author":"释祖钦","text":"等闲剔出影团团，一一如珠走玉盘。\n风前灿灿宝光寒，落落谁从转处看。\n当随机括动，休被眼睛瞒，鱼目光生也一般。\n天上蟾蜍水底浴，明暗不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师亮禅者","author":"释祖钦","text":"忆昔西山亮座主，曾有虚空解讲语。\n唤得回头是马师，规鉴丛林照千古。\n上人学禅不学教，禅教初无二门户。\n一拳打破太虚空，知音不在频频举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆一上人","author":"释祖钦","text":"识得一，万事毕，庆快平生是今日。\n佛祖单传无二心，生死洞然空四壁。\n匆匆闻讣来归，不碍独行特立。\n群峰叠乱青，远水漾虚碧。\n寥寥天地间，来去有何极，韶华自转春无迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行坦上人","author":"释祖钦","text":"细行循循，大道坦坦。\n得处至要，用处至简。\n从上一千七百人，七纵八横，大机大用。\n肩上无过担片横版，顶门只具一只正眼。\n譬如斩一握丝，一斩俱斩，一切尽斩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞二首 其二","author":"释祖钦","text":"以耳返观，夜涛传别谷之声。\n以眼返听，甘露散垂杨之碧。\n所返既忘，观听亦寂。\n夫是之谓救苦慈悲愿力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞二首 其一","author":"释祖钦","text":"鳌翔海运，地迥天空。\n一瓶净水，五浊恶风。\n安得众生界具證圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"克圆上人","author":"释祖钦","text":"克期取證，功行已圆。\n湘南潭北，一月在天。\n五峰深处，万象皎然。\n相见不须抚背，痛与肋下三拳，掣风掣颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"志满上人","author":"释祖钦","text":"夫志在谦毋自满，勿以其长跨人短。\n海因有量天亦聋，人未有德休恃聪。\n君不见水涸山枯物憔悴，春暖风和蝶蜂至。\n欲在丛林立此身，学以成其志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宗正上人","author":"释祖钦","text":"金襕之外传何物，应道门前倒刹竿。\n亘古亘今全提句，好向声前著眼看。\n衲僧衣钵只者是，汝今已得正宗旨。\n寄集云单号别传，枚数英才先屈指。\n忽来告假归清江，窗前梅早春渐芳。\n一枝横出苍烟外，泉声喷雪岩流香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法立上人","author":"释祖钦","text":"万法无根，从何而立。\n一念心坚，银山铁壁。\n发大誓愿，大解脱幢。\n万木生秋风自凉，庭前一阵桂花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法茂上人","author":"释祖钦","text":"野鸟山花能说法，茂林脩竹是参徒。\n时常举一个心字，觌面当机见也无。\n云埋夜月，冰透玉壶。\n明暗双忘，理事一如，差乎缘木求鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍隆上人","author":"释祖钦","text":"行以德绍，道以时隆。\n浮薄在彼，端确在躬。\n衣单下事还一同，道德言行诚明中。\n语默动静昭日月，折旋俯仰生春风。\n上人夏在集云峰，倏起湘江归兴浓。\n庭前索索飘井桐，赤肩担瘦筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鱼篮妇赞二首 其二","author":"释祖钦","text":"篮里清风，手头生活。\n要将鱼目换明珠，岂是慈悲菩萨。\n有智慧人，不消一劄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鱼篮妇赞二首 其一","author":"释祖钦","text":"行步轻盈，梳装济楚。\n示大慈悲，救众生苦。\n智眼堪怜尽不明，只道篮中卖锦鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济赞","author":"释祖钦","text":"眼生三角，头峭五岳，三遭瞎棒折驴腰。\n一喝当空，星斗落错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭如长老请","author":"释祖钦","text":"海印发光，昭然如日。\n曾对大元圣主，默说不二法门。\n默而说，说而默。\n中兴大仰丛林，天下第一法窟。\n见者是谁，石头古佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉初上人","author":"释祖钦","text":"灵觉之初，廓然太虚。\n巘云平岳顶，海月照珊瑚。\n描不如，画不如，咏不如，一段灵光今古无。\n元是兜率桥头，三生藏里夜明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉圆居士请","author":"释祖钦","text":"妙觉圆明，离诸闻见。\n才涉安排，云遮日面。\n若言即此是山僧，三尺竹篦如掣电，好好看方便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送光后堂","author":"释祖钦","text":"春风恶，春风恶，一夜梅花尽吹落。\n人来话别欲游吴，踏断东南天一角。\n春风恶，春风恶，八千里外望西川，从前都是错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送契宁上人","author":"释祖钦","text":"道契佛祖，身自康宁。\n行笃言寡，名香德馨。\n一尘不染，千里前程。\n番阳浩浩，集云青青。\n稳泛扁舟短棹，西风浪平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德富藏主之衡","author":"释祖钦","text":"集云云外小睡虎，毛色金斑威百步。\n顶门正眼烁乾坤，等闲亦或生风雨。\n拂晓出门去何处，衡阳城中访亲故。\n记之早晚即归来，震雷一喝了此末后句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真惠上人","author":"释祖钦","text":"将谓如来，惠戒三昧。\n此语虽真，此意未在。\n正似湘江两半晴，岳面不开云叆叇。\n一日升天四海明，杖头掀转却头轻。\n不移跬步到潭城，相逢历历话前程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释祖钦","text":"九九八十一，穷汉受罪毕。\n才拟展脚眠，蚊虫獦蚤出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六","author":"释祖钦","text":"栽田且博饭，随分煮藜苋。\n一任少丛林，佛法不怕烂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○三","author":"释祖钦","text":"湛湛澄澄，孤明历历，未是到家消息。\n直饶尽底掀翻，不留朕迹，其奈参天荆棘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十七","author":"释祖钦","text":"父母未生前，毕竟是什么。\n当体没踪由，求之即蹉过。\n不蹉过，南北东西岂非我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十八","author":"释祖钦","text":"无忧树下，右胁诞生。\n已是造妖捏怪，那堪七步周行。\n云门一棒打杀，未为剿绝。\n看来只好活葬，解脱无底深坑，依前日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十九","author":"释祖钦","text":"九龙吐水，七步周行。\n云门一棒打杀，正是摩顶授记。\n葛藤枝蔓重生，从教遍地纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十一","author":"释祖钦","text":"天寒人寒，五蕴山头仔细看。\n风动幡动，明眼人前休说梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一六","author":"释祖钦","text":"个事本成现，觅则不可见。\n白圭本无瑕，琢磨乃成玷。\n执之以实法，空中生闪电。\n视之以等闲，脚下添红线。\n若是学道人，好好看方便。\n莫看仙人手中扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十五","author":"释祖钦","text":"眼空东鲁，口吸西江。\n机锋峻捷，不让老庞。\n仰山遮里别无禅道佛法，只有一口吹毛利剑凛凛如霜。\n要为人剪除毛病，换骨洗肠。\n长忆江南三月里，鹧鸪啼处百花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十九","author":"释祖钦","text":"坐本无拘，何必曰放。\n动静但见一如，日用自然虚旷。\n鹊噪鸦鸣，水绿山青。\n腾腾任运不知名，也是错认定盘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○四","author":"释祖钦","text":"指天指地，点胸点肋。\n将谓六识未具初生孩儿，元来通身是胆白拈正贼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○七","author":"释祖钦","text":"九旬禁足，三月护生。\n逗到功成行满，依前日午三更。\n龙渊水风恬浪静，獭径桥雾锁云横。\n去者自去，住者自住，坐者自坐，行者自行。\n杖头纵有通霄路，且共扶持折脚铛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○六","author":"释祖钦","text":"禅，树止叫喧喧。\n道，门前风浩浩。\n冷地思量真可笑。\n笑什么，等闲拾得一颗苏州梨，看来却是青州枣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十五","author":"释祖钦","text":"一切法离分别相，依前诸相自如如。\n春风影里乾坤大，无限江山开画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十二","author":"释祖钦","text":"解语非干舌，能言不是声。\n碧班班碧剥，当滴帝都丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一一","author":"释祖钦","text":"觅起处不得，寻觅处无地。\n见色元来见心，见了元来不是。\n是不是，镜不照镜兮水不洗水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十一","author":"释祖钦","text":"春雨溟濛，春云叆叇。\n忽然杲日当空，天不能遮，地不能载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十七","author":"释祖钦","text":"露地白牛黑黑，是处寻他不得。\n山青水绿，似有如无。\n眼见耳闻，依稀彷佛。\n全不顾时，蹄角却在。\n才动著时，踪由已没。\n月下闲将短笛吹，风前休把长绳勒。\n阿呵呵，也奇特，如今趁亦不去，自在东西南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○一","author":"释祖钦","text":"岁旧年新，夜暗昼明，未尝移易。\n日迁月化，山青水绿，依旧寻常。\n小尽二十九，大尽三十日，也是镇州萝卜，汉地生姜。\n休咬嚼，没商量。\n梅花纸帐一炉香，衲被蒙头春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十二","author":"释祖钦","text":"休拟议，莫商量。\n无朕兆，绝承当。\n君不见江路野梅无主，自开自落，分外馨香。\n一枝横亚清波上，引得游蜂上下忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十二","author":"释祖钦","text":"集云一关，似乎等闲。\n看时容易，透时即难。\n森罗万象，从教侧目，三世诸佛，迥绝跻攀。\n一径古松苔藓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三十二","author":"释祖钦","text":"佛法本无多子，堂堂日用之间。\n只因自信不及，却于易处艰难。\n今夜不免作些方便，为诸人豁开户牖拶碎疑团。\n星在秤兮不在盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一三","author":"释祖钦","text":"澄潭月影，静夜钟声。\n不留而照，不待而鸣。\n而亦离闻绝见，非色非声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其三","author":"释祖钦","text":"春日晴，烧痕青，布谷催耕处处鸣。\n虽然底事最分明，只是不得将眼看并耳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十一","author":"释祖钦","text":"是法非思量分别之所到，是义非见闻觉知之所造。\n三冬和气暖烘烘，半夜日头红杲杲。\n搭著便回，点即不到，已是无端入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十五","author":"释祖钦","text":"晕入灵犀，胎含老蚌。\n正好修行，正好供养。\n有人于此拂袖便行，脚跟下已吃三十拄杖。\n何以见得，禅归海，经归藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其二","author":"释祖钦","text":"人天眼目，佛祖纲维。\n千差万别，一以贯之。\n克宾法战不胜，南泉斩却猫儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一○五","author":"释祖钦","text":"久雨不晴，浸烂衲僧鼻孔。\n如何是衲僧鼻孔，浮云散尽碧天宽，赫赫金盆海里涌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其一一二","author":"释祖钦","text":"法逐心生，心随法变。\n心法双忘，千化万变。\n扇子?跳上三十三天，?著帝释鼻孔。\n盏子扑落地，楪子成七片。\n虽是一期方便，闻名不如见面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其十八","author":"释祖钦","text":"秋风萧萧，夜雨飘飘。\n孤峰绝顶，转见寂寥。\n旷劫前头时节，看来不异今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八","author":"释祖钦","text":"乳燕飞华屋，梅子正香熟。\n连核和皮，一咬百杂碎，元来祖意教意。\n雪瀑挂层崖，月狖啼寒木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其八十七","author":"释祖钦","text":"成龙者升天，成蛇者撺草。\n将谓随一切性任其所适，谁知愤愤悱悱却成烦恼。\n集云峰高日杲杲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七","author":"释祖钦","text":"天悠悠，云悠悠。\n辊底浪花翻雪，竞龙舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其七十三","author":"释祖钦","text":"人从兴化来，接得剑州信。\n说道淩霄峰顶棋盘，元是钱王石镜。\n二十年前一共看，今日重逢，有何照證。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其四","author":"释祖钦","text":"无解无结，犹是空中钉橛。\n有修有證，何异捕风捉月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其五十八","author":"释祖钦","text":"秋气凄清，秋光淡荡。\n鹭鸶飞下遥天，明月芦花一样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]