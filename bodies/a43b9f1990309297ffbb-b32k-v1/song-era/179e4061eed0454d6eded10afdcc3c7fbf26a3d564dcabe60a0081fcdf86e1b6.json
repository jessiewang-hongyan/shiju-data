[{"title":"太令人田氏挽辞二首 其二","author":"杨万里","text":"家食初偕隐，君羹晚得尝。\n金花千轴告，玉树五枝香。\n咫尺相山室，葱昽瓦庙冈。\n真令淮水绝，依旧庆源长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太令人田氏挽辞二首 其一","author":"杨万里","text":"天竺琼为岫，西湖锦作春。\n轻轩过微雨，小宰太夫人。\n游览年年好，恩封日日新。\n如何君氏赗，忽费水衡银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太宁郡夫人张氏挽词二首 其二","author":"杨万里","text":"我忆定斋老，壶觞父子间。\n西湖梅半落，东馆月初弯。\n俄顷王姑酒，嵚岑杜母山。\n升堂迟一拜，作诔费频删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太宁郡夫人张氏挽词二首 其一","author":"杨万里","text":"盖世金瓯谱，传家象笏囊。\n藁砧八叶相，桂子一枝香。\n葱岭参西学，兰陔掩北堂。\n能诗饱经史，个是女班扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"引见前一夕寓宿徐元达小楼元达招符君俞胡季永小集走笔和君俞韵","author":"杨万里","text":"主宾呼酒卷沧溟，我亦何人与德星。\n高阁连云压潮白，前山倒影入杯青。\n细哦秀句清无底，匹似疏梅寒更馨。\n不惜坐间作颓玉，只愁宫漏又须听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文远叔挽词","author":"杨万里","text":"气爽尘埃外，川行翰墨间。\n匆匆未白首，去去忽青山。\n琴在弦安用，人亡鹤不还。\n竹林有前约，欲语泪先潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方虚日斜再行宿乌山二首 其二","author":"杨万里","text":"多稼村村过，垂杨店店迎。\n偶然逢客子，问得好山名。\n投宿欣犹早，斜阳落更明。\n仆人休进扇，得似晚风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方虚日斜再行宿乌山二首 其一","author":"杨万里","text":"日已衰容去，风仍劈面来。\n征徒歇得醒，老子不须催。\n绿荫凉过伞，黄泥晒作埃。\n欣然片云起，半霎又吹开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其一","author":"杨万里","text":"恰则天方暮，如何月正中。\n一年无此热，今夕绝无风。\n早藕凝松雪，新菱剥酽红。\n醉乡堪避暑，只合著衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下闻笛","author":"杨万里","text":"天色镕成水，蟾光鍊出银。\n碧香三酌半，玉笛一声新。\n小婉还清壮，多欢忽苦辛。\n何人传此曲，此曲怨何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月台夜坐二首 其二","author":"杨万里","text":"日落片时许，星才数点明。\n须臾玉棋子，遍满碧瑶枰。\n向晚垂垂雨，通宵得得晴。\n秋蛩伴侬语，苦底是谁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月台夜坐二首 其一","author":"杨万里","text":"秋日非无热，秋宵至竟清。\n老夫连数夕，露坐到三更。\n风急星明灭，云行月送迎。\n追驩追不得，驩却偶然成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜阻风泊舟太湖石塘南头四首 其四","author":"杨万里","text":"新年乘兴看春风，来过垂虹东复东。\n谁有工夫寒夜底，独寻水月五湖中。\n今宵顿觉乾坤大，下笔惟愁造化穷。\n太白青山谢公海，可怜一笑偶然同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜阻风泊舟太湖石塘南头四首 其三","author":"杨万里","text":"过湖未得匹如闲，何幸湖心泊画船。\n宇宙中间都是月，波涛外面更无天。\n谁知造物将奇观，不与伧人付谪仙。\n管领渠侬无一物，镂冰剪雪作新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜阻风泊舟太湖石塘南头四首 其二","author":"杨万里","text":"动地颠风政打头，吴江未到且维舟。\n五湖波起众山动，一片月明千里愁。\n且更放迟些子睡，看它盛怒几时休。\n阳侯要与诗人敌，未必诗人输一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜阻风泊舟太湖石塘南头四首 其一","author":"杨万里","text":"到得松江每不欣，何曾晴快遇清真。\n此行作意追胜境，入夜阻风还闷人。\n万里青天一轮月，三更雪浪太湖春。\n若教白日来经此，不见新镕万顷银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀初发呈张功父","author":"杨万里","text":"尘世何曾识桂林，花仙夜入广寒深。\n移将天上众香国，寄在梢头一粟金。\n露下风高月当户，梦回酒醒客闻砧。\n诗情恼得浑无那，不为龙涎与水沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六首 其六","author":"杨万里","text":"帝城底里有山林，桂树团团烟雾深。\n玉臂折来数枝月，银髯羞插满头金。\n谈间千首有此客，空外一声何处砧。\n酒亦销愁亦生病，不须不醉不须沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六首 其五","author":"杨万里","text":"老子江西有故林，万松围里桂花深。\n忆曾风露飘寒粟，自领儿童拾落金。\n割蜜旋将揉作饼，捣香须记不经砧。\n一枝未觉秋光减，灯影相看万籁沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六首 其四","author":"杨万里","text":"约斋诗客坐诗林，派入江西彻底深。\n缝雾裁云梭织锦，明堂清庙玉摐金。\n已呼毛颖哦齑臼，更约姮娥聘槁砧。\n细咏新来木犀句，一灯明灭夜沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六首 其三","author":"杨万里","text":"端能小脱簿书林，招唤诗流卜夜深。\n老我愁隤半山玉，凭君浅酌一荷金。\n水边赏桂秋围坐，雨后摘蔬香满砧。\n乘醉却来湖上戏，手翻波月看浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六首 其二","author":"杨万里","text":"分得吴刚斫处林，鹅儿酒色不须深。\n系从犀首名干木，派别黄香字子金。\n衣溅蔷薇兼水麝，韵如月杵应霜砧。\n馀芬薰入旃檀骨，从此人间有桂沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六首 其一","author":"杨万里","text":"诗人家在木犀林，万顷湖光一径深。\n夹路两行森翠盖，西风半夜散麸金。\n邀宾把酒香浮玉，擘水庖霜脍落砧。\n掇取仙山入京洛，不妨冷眼看升沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水西野店皆不著宿夜抵石山虚","author":"杨万里","text":"不著官人宿，无如野店何。\n见容幸有此，虽陋更嫌它。\n头虱妨归梦，邻鸡伴寤歌。\n此生眠食尔，行路总蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王式之直阁不远千里来访野人赠以佳句次韵奉谢","author":"杨万里","text":"君才陆海与潘江，句里芒寒万丈长。\n雪椀冰瓯翻笔墨，锦机绣段出肝肠。\n王家龙凤重英特，谢砌芝兰让耿光。\n相国登庸衣钵在，郎君努力续前芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王龟龄挽词","author":"杨万里","text":"佛以偏师胜，天能一手回。\n横空立万仞，不为作三魁。\n道大身无著，人亡世却哀。\n溪梅那解事，寂寞为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见王宣子侍郎二首 其二","author":"杨万里","text":"老去浑多难，愁来敢怨天。\n生遭文字误，更结簿书缘。\n苦忆悬间榻，难回雪后船。\n三年才一见，百岁几三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见王宣子侍郎二首 其一","author":"杨万里","text":"不作伾文客，投闲可得辞。\n高名真自累，了事竟成痴。\n到底须良匠，非渠更阿谁。\n莫嫌风雪恶，要试岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见张钦夫二首 其二","author":"杨万里","text":"不见所知久，有怀何许开。\n百书终作恶，千里为渠来。\n邹鲁期程远，风霜鬓发催。\n不应师友地，只么遣空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见张钦夫二首 其一","author":"杨万里","text":"克己今颜子，承家小吕申。\n只愁无好手，不道欠斯人。\n一别时飞几，重来事总新。\n祥琴声尚苦，可更话酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见周子充舍人叙怀","author":"杨万里","text":"三年再谒一番逢，两舍相望几讯通。\n便有好怀安得尽，不知造物底相穷。\n公今贫贱庸非福，我更清愁恶似公。\n误辱相期千载事，云泥政自未应同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见潭帅刘恭父舍人二首 其二","author":"杨万里","text":"道合宁嫌晚，心期不用多。\n于公犹未见，此恨独如何。\n颇辱谈间问，端须雪里过。\n门阑当欠士，许寄病身么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见潭帅刘恭父舍人二首 其一","author":"杨万里","text":"云雾开衡岳，波涛息洞庭。\n是邦谁岳牧，西掖一文星。\n有眼难人物，斯人尚典刑。\n如何闲处著，不遣肃朝廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丘母太硕人臧氏挽诗二首 其二","author":"杨万里","text":"共伯松楸后，宗文玉雪初。\n吹灯躬夜绩，听子读残书。\n帅阃方兰膳，王畿又版舆。\n药成人不见，月里踏蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丘母太硕人臧氏挽诗二首 其一","author":"杨万里","text":"行乐潘慈母，荣封卫硕人。\n金花五色诰，雨叶六番春。\n白露凋萱惨，青山拱木新。\n九龄真上寿，一子更名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙申岁朝","author":"杨万里","text":"椒盘又颂一年初，多拜犹欣未要扶。\n山色长供青箬笠，春光不为白髭须。\n仙家风土闲中是，岁后莺花较早无。\n人事驰驱不须叹，倦来添得睡工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东寺诗僧照上人访予于普明寺赠以诗","author":"杨万里","text":"故人深住白云隈，欲到何因只寄梅。\n岁晚观山吾独立，泥中骑马子能来。\n转头不觉三年别，病眼相看一笑开。\n说似少陵真句法，未应言下更空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东宫讲退触热入省倦甚小睡","author":"杨万里","text":"承华下直直几廷，新暑醺人睡不成。\n到得曲肱贪梦好，无端急雨打荷声。\n起看翠盖如相戏，乱走明珠却细倾。\n归路关心最凉处，水风四面一桥横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书呈张功父","author":"杨万里","text":"不见子张子，令人梦亦思。\n只应依旧瘦，近作几多诗。\n联句平生事，看花去岁时。\n海棠今好不，传语并酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代贺郊祀庆成二首 其一","author":"杨万里","text":"圣主勤民岁自丰，德威怀远塞尘空。\n郁金祼鬯周茅屋，瑄玉亲郊汉竹宫。\n已刺六经新作制，却追三代与同风。\n鸡竿更霈如天泽，殿柳宸梅雪正融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代贺郊祀庆成二首 其二","author":"杨万里","text":"天为君王幸泰禋，飞雵疏雨净香尘。\n金波玉李浮苍璧，风马云车降紫旻。\n万宝丰年贞上瑞，八方和气蔼成春。\n受釐未肯专宣室，鸿号还将寿两亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后贺皇太子及平阳郡王","author":"杨万里","text":"长乐钟声搅梦惊，建章星影照人行。\n千官灯语听残点，一夜霜寒在五更。\n金钥玉?开北阙，银鞍丝控谒东明。\n青宫朱邸环天极，五色祥云覆帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至称贺紫宸殿及德寿宫","author":"杨万里","text":"宫烛奔忙下玉除，晨曦拂掠丽储胥。\n东西班动云开合，警跸声来电卷舒。\n隆准衣裳红一点，御香烟雾碧千庐。\n勋华二圣天齐寿，亚岁年年贺帝居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至霜晴","author":"杨万里","text":"油帘雪白日华红，老子良图策隽功。\n自晒绵裘并衲裤，谁知衣桁是薰笼。\n绝怜寒菊枯根底，留得残霜过日中。\n旧说冬乾年定湿，试将今岁试南翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬暖","author":"杨万里","text":"小春活脱是春时，霜熟风酣日上迟。\n晚蝶频移猎残蕊，惊禽冲过倒垂枝。\n暂闲何似长闲好，无事非关了事痴。\n三径一筇人不见，假山以外菊花知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出北关门送李舍人使虏","author":"杨万里","text":"同寮缓辔出承华，又送双星水北涯。\n霜外汀洲芦叶晓，雪馀园圃竹梢斜。\n只惊睡起犹残月，不觉归时已落霞。\n白首鸳行徒索米，故山今日政梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出横山江口","author":"杨万里","text":"白壁当江岸，青旗定酒家。\n断崖侵屋窄，细路入门斜。\n县近瞻双塔，洲横隔一沙。\n何须后来客，如信此诗嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"加餐","author":"杨万里","text":"脱发星星遍，加餐日日新。\n二升卧龙玉，一斗谪仙春。\n云子恐称屈，曲生能笑人。\n吾方有公事，公等不须嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北风","author":"杨万里","text":"山雨无休歇，江云政郁葱。\n如何急滩水，更著打头风。\n草作伤心碧，花能可意红。\n一年春好处，却在道涂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去岁四月得淋疾今又四月病犹未愈","author":"杨万里","text":"去岁四月病，如今一岁来。\n越吟三百日，凉剂二千杯。\n极痛过于割，通身总是灾。\n花时久断酒，红药为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发中桥二首 其二","author":"杨万里","text":"新雨丰今岁，初晴屏积阴。\n猛收千疋练，微露一棱金。\n天熨粉青嫩，山描愁黛深。\n谁言残剩暑，卓午不相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发中桥二首 其一","author":"杨万里","text":"湿轿乘凉入，斜灯借路明。\n柳欹元不倒，桥阔自多惊。\n宿霤停残滴，朝曦放快晴。\n溪流太无赖，不作一声声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发乌山入溧水县中山驿","author":"杨万里","text":"雨脚依山见，风头触树回。\n泥深行不去，轿兀睡还来。\n栩栩情微适，喧喧眼竟开。\n梦残那可续，续得转悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发杨港渡入交石夹四首 其四","author":"杨万里","text":"荻岸何时了，松舟几日停。\n波来全蜀白，树去两淮青。\n柔橹殊清响，征人自厌听。\n不知谁子醉，垂手瞰江亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发杨港渡入交石夹四首 其三","author":"杨万里","text":"山断情相接，江同派暂分。\n无风犹细浪，有日却轻云。\n生熟衣中半，阴晴气两熏。\n还家浑欲早，徐棹也堪欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发杨港渡入交石夹四首 其二","author":"杨万里","text":"入夹宽中窄，临流慢处深。\n朝阳明众岫，西崦自多阴。\n脱裤嗔人俭，提壶侑我斟。\n老来除饮外，半点没春心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发杨港渡入交石夹四首 其一","author":"杨万里","text":"朝雨匆匆霁，春山历历嘉。\n老青交幼绿，暗锦出明花。\n渔艇十数只，鸡声三五家。\n人生须富贵，此辈亦生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发枫平","author":"杨万里","text":"谷暗迷窗晓，山鸣报雨来。\n畦丁绝须喜，菜甲正新栽。\n倦路愁何那，冲泥惯岂才。\n吾诗未大好，也辱片云催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发赵屯得风宿杨林池是日行二百里","author":"杨万里","text":"动地风来觉地浮，拍天浪起带天流。\n舞翻柳树知何喜，拜杀芦花未肯休。\n两岸万山如走马，一帆千里送归舟。\n出笼病鹤孤飞后，回首金笼始欲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发银树林","author":"杨万里","text":"莫过溪桥银树林，溪深未抵路泥深。\n清风一阵掠人面，晴色半开关客心。\n远岭惹云秋里雪，淡天刷墨晓来阴。\n几多好句争投我，柳夺花偷底处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗召还京题江西道院","author":"杨万里","text":"病身祇要早投闲，乞得高安政小安。\n山水秋来浑是画，楼台高处自生寒。\n登临未足还辞去，老大重来毕竟难。\n碧落翠微好将息，清风明月梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶叔羽集同年九人于樱桃园钱袭明何同叔即席赋诗追和其韵二首 其二 和何同叔韵","author":"杨万里","text":"天门金榜出槐宸，四海同年骨肉亲。\n走马看花才几日，晓星残月半无人。\n谈间平叔元如玉，句里司勋别有春。\n欲把清新比梅雪，却愁梅雪未清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶叔羽集同年九人于樱桃园钱袭明何同叔即席赋诗追和其韵二首 其一 和钱袭明韵","author":"杨万里","text":"八座能分一日光，题名犹记榜间黄。\n看渠超出金闺彦，顾我曾为同舍郎。\n高会九人寻水石，纵谈一笑间宫商。\n越王孙子琼瑶句，细把重吟恐脱忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶教授镐乃翁致政一百三岁屡加封仍锡朱银取告命之词名其堂曰介寿","author":"杨万里","text":"兰玉初攀桂，朱银降自天。\n堂中有一老，物外百三年。\n紫诰行充栋，霜毛尽满颠。\n仁人元自寿，端不羡臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四十九叔祖母朱氏孺人挽词","author":"杨万里","text":"忆哭清湘掾，诸孤未裹头。\n盛年能素节，凛气却清秋。\n眼底生刍奠，身前汎柏舟。\n无龄还有德，此母不应愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]