[{"title":"示寿宁长老如晓 其二","author":"邹浩","text":"三关谁复识黄龙，大施门开振祖风。\n无限人天无限眼，一齐回向岭云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示寿宁长老如晓 其三","author":"邹浩","text":"师在兴安我在昭，几年相望但云霄。\n谁知小出忽大遇，共折青柴带叶烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示崇宁长老善资 其一","author":"邹浩","text":"五色云中有和烟，天长地久祝斯年。\n太平一曲凭师唱，响彻乾坤万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示崇宁长老善资 其二","author":"邹浩","text":"独秀峰前是宝坊，坐令热恼变清凉。\n人人认得长安路，珍重旃檀一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与叶适正资长老同宿觉华山安福寺","author":"邹浩","text":"觉华山下古禅宫，鼎足蒲团午夜同。\n但有鸡声替钟鼓，更无僧影到帘栊。\n真情迥出忘情外，多语都归妙语中。\n转首是谁南与北，庭前桧柏亦生风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜登台光亭示主人莫亢","author":"邹浩","text":"亭据炎方第一州，旌旗曾向此中留。\n台光不逐春光改，花影长随桂影浮。\n谁谓岭云收白雨，偶然莎径入青眸。\n它年南北遥相望，应记匆匆秉烛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别兴安唐叟元老推官 其一","author":"邹浩","text":"天绘亭边三载梦，石灰铺里一时情。\n个中不是同参得，胸次峥嵘何日平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别兴安唐叟元老推官 其二","author":"邹浩","text":"风前火烈逢真玉，雪后大寒见老松。\n携得此心归北去，与君无处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别兴安唐叟元老推官 其三","author":"邹浩","text":"幽居不许穿云到，宝阁仍忘破晓登。\n多少从来疑着处，一齐分付打包僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别龙城山主怀义 其一","author":"邹浩","text":"阳朔千山复万山，最深山处是松关。\n新诗吟罢无馀事，一片真心云共閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别龙城山主怀义 其二","author":"邹浩","text":"仙阁龙城一望间，每来过我不如还。\n汀鸥犹集栏干外，应怪从今气象閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别龙城山主怀义 其三","author":"邹浩","text":"好事如师岂易逢，不辞趼足访行踪。\n挥残麈尾知难再，目断碧莲峰外峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别龙城山主怀义 其四","author":"邹浩","text":"青天无碍本来同，休向江边动别容。\n师似碧潭吾似月，东西南北总相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别龙城山主怀义 其五","author":"邹浩","text":"三车黄叶止儿啼，一句何人妙得知。\n今日为师重说破，满轩风静月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄巡铺温■侍禁乃杲之弟也","author":"邹浩","text":"几日长亭复短亭，霜梅夹路喜相迎。\n风光总属君家管，霁色偏随马足生。\n老酒盈杯谁款曲，少陵佳句谩分明。\n回头安福前山晓，八桂苍苍无限情。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行示同游","author":"邹浩","text":"碧云堆里共徜徉，莫厌扪天带夕阳。\n游遍桂州岩穴后，更无閒梦到南方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山 其一","author":"邹浩","text":"我是来仙阁上仙，天教飞鹤过山颠。\n松篁为我生清韵，一似薰风初入弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山 其二","author":"邹浩","text":"七星峰顶绝纤埃，不负烟霞双眼开。\n昨日湘南遥指处，飞腾今向此中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题妙峰阁慧照堂","author":"邹浩","text":"妙峰阁外云收翳，慧照堂中日放光。\n大地山河都见了，此心聊寄一垆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶筠元礼留饮 其一","author":"邹浩","text":"天造移居汉水湄，岭边欣与故人期。\n红灯暖照金波动，全胜来仙阁上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶筠元礼留饮 其二","author":"邹浩","text":"殷勤留我共清樽，无限情怀子细论。\n天色亦如人意好，晚来星斗满前轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓寿宁方丈州人求识面继来焚香作礼戏呈晓老","author":"邹浩","text":"维摩丈室一张床，暂寄清宵梦几场。\n却被閒人作禅看，竞来合掌要焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏灵川令王洵仁仲","author":"邹浩","text":"长官贪着祖师禅，有甚心情问我船。\n一只逃归两只破，谩凭江槛望灵川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示仁仲 其一","author":"邹浩","text":"槎头一别十经年，月照黄茅梦不圆。\n今日北归恩赐与，相逢如在四禅天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示仁仲 其二","author":"邹浩","text":"一根烧笋共分甘，彷佛当年汉水南。\n红柿鸟残无此意，前三三与后三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和仁仲滑石铺泉轩","author":"邹浩","text":"长官心事古人前，碧玉峰峦碧玉泉。\n洗出北归烟瘴眼，光明欣睹太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"假寐灵川报恩寺","author":"邹浩","text":"故人犹在驿亭边，暂向云房借榻眠。\n漏泄祖师多少意，松声都到小窗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示舂陵顾林宗","author":"邹浩","text":"寇公楼下钓鱼船，横绝晴波已七年。\n邂逅莲宫论往事，恍疑同在夜摩天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见鲁直题陶商翁碑后有感","author":"邹浩","text":"石上犹新墨，忘情亦叹嗟。\n殊恩但归骨，冷迹尚平沙。\n愿力消尘垢，瞻依盛宝花。\n人间几行泪，空洒玉川家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其一","author":"邹浩","text":"踏着湖南境界新，展开天宇净无尘。\n增添喜色知多少，满眼雪峰如故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其二","author":"邹浩","text":"北风吹满乱山云，山顶皑皑色尚新。\n怪得几朝寒暝日，元来留雪迓归轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其三","author":"邹浩","text":"一自潇湘见雪飞，炎氛遮眼暗渔矶。\n今朝才入湖南界，便睹玉光生翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其四","author":"邹浩","text":"北风吹面过如冰，也胜南风瘴水滨。\n莫向知亭嫌太冷，主人元是铁心人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其五","author":"邹浩","text":"薄薄阴云淡淡天，北风迎路彻重绵。\n从教捲起轿帘子，吹尽几年岚瘴烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其六","author":"邹浩","text":"重重叠叠拥遥峰，总在轻烟薄雾中。\n疑是李成初画了，生绡千幅挂晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其七","author":"邹浩","text":"淡描深拂百千般，终日抬头不厌观。\n造物始初谁与样，定应曾得古图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其八","author":"邹浩","text":"一等乾坤一等山，才分湖岭便多般。\n何如洗尽昏昏瘴，都作晴天万仞寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其九","author":"邹浩","text":"折得梅枝插轿帘，路人惊怪簇巉岩。\n从教大担担将去，深入三家村里谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其十","author":"邹浩","text":"短箫长笛鼓鼕鼕，簇纸为船棹晚风。\n送了鬼神无一事，大家赢得醉颜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其十一","author":"邹浩","text":"鸡未鸣时整客衣，行行只恐日斜晖。\n米塘过了全州近，恰遇村人趁市归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入湖南界 其十二","author":"邹浩","text":"赤脚蛮中新出来，湖南逢着尽银钗。\n虽然未得凌波样，已会人人着草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示崇宁长老允和","author":"邹浩","text":"安心得髓遇升平，不似云门不解行。\n聊与祖师分半座，湘山顶上放光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示澄庵庵主炳著 其一","author":"邹浩","text":"又向全州现此身，澄庵犹是旧时人。\n相逢休说途中事，且点茶来吃一巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示澄庵庵主炳著 其二","author":"邹浩","text":"澄来澄去不知年，一片澄光月样圆。\n照破十方三世黑，大家同集世尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示澄庵庵主炳著 其三","author":"邹浩","text":"不肯南来伴我閒，若来何法可心安。\n直饶参得龄铁觜，也被昭州烟瘴漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示张道人","author":"邹浩","text":"几年龙虎自相随，南斗延生恩赐归。\n霄汉路通鸾鹤在，不妨高蹑紫云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙高亭","author":"邹浩","text":"四望山头老比丘，笑他思大浪经由。\n巧将三十三天好，都向青云青处收。\n金翅远投云际歇，银河低绕砌边流。\n高高更有堪行路，骑取沩山水牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六一岩","author":"邹浩","text":"造物有所待，巉岩从此通。\n千峰豁前障，万象欻来同。\n涤览进江水，啸晴生虎风。\n谁知不朽事，成在笑谈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜长老永文方自外归","author":"邹浩","text":"荆棘丛中自在人，不知何处是埃尘。\n岩前逢着笑绝倒，也似炎荒金色身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文长老云山有训狐鸣即客至夜来鸣更异常","author":"邹浩","text":"我入山来亦偶然，初无消息与人传。\n训狐缘底潜知得，隔夜飞鸣报老禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自淡山过暗岩","author":"邹浩","text":"淡中有味味真味，暗里有明明更明。\n不是同来三大士，有谁能识此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观真珠花留戏陈瑩中","author":"邹浩","text":"古观无人花自开，真珠颗颗映莓苔。\n留教合浦居士看，何似海边新蚌胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示法轮长老景齐","author":"邹浩","text":"问碑碑已化为尘，却得同生庚子人。\n聊把此心论此事，颇疑前日是前身。\n云间岣嵝峰回礼，庭下娑罗花献春。\n更欲纵横见端的，夜来飞雨洗金轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示云溪长老文庆","author":"邹浩","text":"与师应有缘，相见便欣然。\n径出牧牛室，共扪垂雨天。\n一真谁境界，万物自山川。\n放手无馀事，归来汨碖眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示方广长老从誉","author":"邹浩","text":"五百阿师何处来，天堂初不隔天台。\n灵泉飞作人间雨，法鼓腾为山下雷。\n对现此身谁彷佛，上方重阁正崔嵬。\n只应永劫观空眼，总向峰前欢喜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题誉老无住阁","author":"邹浩","text":"不二门开刹海中，十方世界本来同。\n四威仪竟无所着，千手眼应如是通。\n弥勒当年曾示现，善才于此悉参同。\n而今我亦逢师处，聊击栏杆问祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自方广冒雨过高台示德澜长老","author":"邹浩","text":"云烟犹暝晓，杖屦已高台。\n眼向不危去，景从无外来。\n巧将新水墨，洒出旧尘埃。\n携得还天北，晴时阔展开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定林长老首座自合浦来以此示之","author":"邹浩","text":"已入高楼见弥勒，却寻旧路礼文殊。\n谁知垢腻衲衣内，总是摩尼无价珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示万寿长老道琮","author":"邹浩","text":"万寿阁中逢故人，万年松下偶穿云。\n凭将五分真香爇，长对南山祝圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示衡岳寺善果庵道成庵主","author":"邹浩","text":"游了诸山问了禅，却来庵里坐安然。\n何如一瓣焚香去，飞作祥云遍九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示胜业寺长老有馀 其一","author":"邹浩","text":"韶阳一曲有谁知，拍手相逢笑几时。\n偶向悦亭杉外立，元来传在最高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示胜业寺长老有馀 其二","author":"邹浩","text":"八桂苍苍湘水南，师乡我客饱曾谙。\n五年不见今年见，犹得寒炉一夜谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过洞庭风作","author":"邹浩","text":"洞庭波面忽如雷，万斛楼船舞一杯。\n为报冯夷莫相嚇，尽曾经着暴风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答八十三外翁见招","author":"邹浩","text":"乃翁心事别，璧月到寒塘。\n攲枕三竿日，横经一炷香。\n尚思同燕麈，还欲对胡床。\n行矣拿舟去，金钟亦自将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招俞清老并简康远禅师 其一","author":"邹浩","text":"腰钱骑鹤上扬州，妄想空来事事休。\n惟有三竿风月在，待君同理钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招俞清老并简康远禅师 其二","author":"邹浩","text":"欲知何处是生缘，问取维摩室内天。\n渠若口钳无答语，竹西坚卧许安全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招俞清老并简康远禅师 其三","author":"邹浩","text":"石塔迢迢两闰馀，潜知骨瘦夺松枯。\n烦君为把公凭判，同过江来伴老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗送晦叔先生 其一","author":"邹浩","text":"先生带花六十年，青春不老花长妍。\n金杯停手便索去，一片閒云飞上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗送晦叔先生 其二","author":"邹浩","text":"知是初平几代孙，双携日月弄乾坤。\n人间有眼谁窥得，笑出常州西郭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗送晦叔先生 其三","author":"邹浩","text":"疾卧几为万鬼邻，金丹一粒遇高真。\n此身从此无他事，长作升平击壤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗送晦叔先生 其四","author":"邹浩","text":"一别相逢复几时，东西南北酒盈卮。\n天机深远犹须决，莫便飞腾不我期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗送晦叔先生 其五","author":"邹浩","text":"万里来归荷圣恩，焚香趺坐欲无言。\n群仙若问谁堪度，为说冥心到本元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄和庵主","author":"邹浩","text":"自从衡岳得高风，南北东西久未逢。\n惟有旃檀知此意，为传消息到中峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简俞子恭","author":"邹浩","text":"东郭名园步可过，病馀犹以路为多。\n何当略彴通新径，日日从君击壤歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏简钱济明 其一","author":"邹浩","text":"雨雪相仍势未休，禦寒惟酒胜重裘。\n谁知旱久犹乾涸，不见玉泉东向流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏简钱济明 其二","author":"邹浩","text":"载酒无如君最频，年来缘底断音尘。\n只应咫尺谯门住，也学兵厨不送人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]