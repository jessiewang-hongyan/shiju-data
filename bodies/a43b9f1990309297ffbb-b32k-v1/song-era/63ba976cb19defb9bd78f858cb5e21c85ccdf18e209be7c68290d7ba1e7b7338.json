[{"title":"访何茂恭于南湖作三绝句 其二","author":"喻良能","text":"南湖绿发居士，恰少磬湖八年。\n掀雷抉电杰句，出月穿天大篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茂恭见和再用前韵奉酬 其一","author":"喻良能","text":"朗朗百间羊肸，森森千丈长舆。\n一身宜著台阁，半生流落江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茂恭见和再用前韵奉酬 其三","author":"喻良能","text":"少陵时时醉里，子山日日愁边。\n白发新来满镜，故人万一能怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茂恭见和再用前韵奉酬 其二","author":"喻良能","text":"忆昔永新番水，俱吏江左三年。\n不作载苡马援，聊为留犊苗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李通判断桥图 其二","author":"喻良能","text":"桥上笋舆岌岌，桥下浪波沄沄。\n但觉往来无恼，不知观者伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李通判断桥图 其一","author":"喻良能","text":"平生心地夷坦，一旦足跟崄巇。\n不是篮舆安稳，只应神物护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"磬湖居士得片石于斗坡山其长五尺其广一尺有咫耸拔孤秀缜密温润绝不类此间石疑自他山飞来因目之曰飞来石","author":"喻良能","text":"六丁驱石日本，堕落斗坡山中。\n一片苍圭紫玉，几回秋雨春风。\n不假镌镵刻削，自然巧妙嵌空。\n居士置之朝爽，是谓飞来小峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连理枝","author":"喻良能","text":"紫荆斜倚磬湖隈，并干连枝锦作堆。\n犹记太虚坛上木，舞风双影并徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"喻峙","text":"我是山中万户侯，明知骑马胜骑牛。\n晚来马上看山色，不似骑牛得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅香","author":"喻陟","text":"晓日初长，正锦里轻阴，小寒天气。\n未报春消息，早瘦梅先发，浅苞纤蕊。\n揾玉匀香，天赋与，风流标致。\n问陇头人，音容万里。\n待凭谁寄。\n一样晓妆新，倚朱楼凝盼，素英如坠。\n映月临风处，度几声羌管，愁生乡思。\n电转光阴，须信道、飘零容易。\n且频欢赏，柔芳正好，满簪同醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎丘","author":"富严","text":"缭绕禅关锁翠微，游人到此便忘归。\n古今不尽春风恨，一剑清泉浸落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游灵岩","author":"富言","text":"闻说灵岩境最幽，乘閒舣棹共追游。\n飞泉翠滴半空雨，古树阴连万壑秋。\n缥缈香烟笼梵榻，嵯峨山势枕江流。\n登临眺望关河远，惹起乡思恋国愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫微山","author":"富临","text":"凿石诛茅四十年，棱层宝构出诸天。\n更逢地胜惊游客，不负身披坏衲田。\n别郡坐看云散后，平湖下压鸟飞前。\n还知老令忘归否，为惜难移近县廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尧夫先生示秋霁登石阁之句病中聊以短章戏答","author":"富弼","text":"高阁岧峣对远山，雨馀愁望不成欢。\n拟将敛黛强消遣，却是幽思苦未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁在癸丑年始七十正旦日书事 其一","author":"富弼","text":"人生七十古来稀，今日愚年已及期。\n从此光阴犹不测，只应天道始相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁在癸丑年始七十正旦日书事 其三","author":"富弼","text":"先圣明明许纵心，山川风月恣游寻。\n此中若更论规矩，籍外闲人不易禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁在癸丑年始七十正旦日书事 其二","author":"富弼","text":"亲宾何用举椒觞，已觉闲中岁月长。\n不学香山醉歌舞，只将吟啸敌流光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁在癸丑年始七十正旦日书事 其四","author":"富弼","text":"今年始是乞骸年，我向年前已挂冠。\n都为君王怜久疾，肯教先去养衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弼观罢走笔书后卷","author":"富弼","text":"黎民于变是尧时，便字尧夫德可知。\n更览新诗名击壤，生生全道略无遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弼窃览长篇断章有十二人中第二人之句又赋一绝上呈","author":"富弼","text":"顾我年龄虽第一，在公勋德自无双。\n不推行业终难敌，富贵康宁亦可降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嵩巫亭","author":"富弼","text":"平地烟霄此半分，绣楣丹槛照清汾。\n风帘暮捲秋空碧，剩见西山数岭云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题范希文手书伯夷颂墨迹","author":"富弼","text":"夷清韩颂古皆无，更得高平小楷书。\n旧相嘉篇题卷后，苏家能事复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十四日早始见雪登白云台闲望乱道走书呈尧夫先生","author":"富弼","text":"气候随时应，初寒雪已盈。\n乾坤一色白，山水万重清。\n是处人烟合，无穷鸟雀惊。\n忻然不成下，连把玉罍倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台上再成乱道走书呈尧夫","author":"富弼","text":"密雪终宵下，晨登百尺端。\n瑞光翻怯日，和气不成寒。\n天末无织翳，云头未少乾。\n四郊闻击壤，农望已多欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邵尧夫先生","author":"富弼","text":"先生自卫客西畿，乐道安閒绝世机。\n再命初筵终不起，独甘穷巷寂无依。\n贯穿百代尝探古，吟咏千篇亦造微。\n珍重相知忽相访，醉和风雨夜深归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄裴士林","author":"富弼","text":"渤澥宣和旅翮飞，不堪朱邸负前期。\n东城晓骑思行乐，南浦春波怨别离。\n对竹岂能忘旧主，折麻方喜遇深知。\n冕旒正注方臣重，应许州人借一期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弼承索近诗复贶佳句辄次元韵奉和诗以语志不必更及乎诗也伏惟一览而已 其一","author":"富弼","text":"出入高车耀缙绅，从来天幸喜逢辰。\n道孤常恐难逃悔，性拙徒能不失真。\n风雨坐生无妄疾，林泉归作自由身。\n岁寒未必输松柏，已见人间七十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答郑州祖龙图见寄原韵","author":"富弼","text":"坐拥双旌甫浚郊，总戎曾未属鞬櫜。\n千金寡妙方移疾，二府交修敢惮劳。\n处世机牙都不竞，摄生权柄急须操。\n他时病起君恩报，始信林泉属我曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睢阳五老图","author":"富弼","text":"休官致政老年閒，庙堂尝享著袍冠。\n调和鼎鼐施霖雨，燮理阴阳佐武桓。\n念国不忘先世烈，归乡岂念旧庐寒。\n我辈若从亲炙授，仪容如在使人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留守太尉相公就居为耆年之会承命赋诗","author":"富弼","text":"西洛古帝都，衣冠走集地。\n岂惟名利场，骤为耆德会。\n大尹吾旧相，旷怀轻富贵。\n日与退老游，台阁并省寺。\n予惭最衰老，亦许预其次。\n遂俗肖仪容，烂然彤绘事。\n闽峤访精华，鲛绡布绝艺。\n令复崇宴衎，聊以示慈惠。\n幽居近铜驼，荒敝仍湫庳。\n塞路移君庖，盈车载春醴。\n献酬互相趣，欢处不知止。\n商岭有四翁，晋林惟七子。\n较我集诸贤，盛衰何远尔。\n兹事实可矜，传之足千祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄欧阳公","author":"富弼","text":"滁州太守文章公，谪官来此称醉翁。\n醉翁醉道不醉酒，陶然岂有迁客容。\n公年四十号翁早，有德亦与耆年同。\n意古直出茫昧始，气豪一吐阊阖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题醉翁亭","author":"富弼","text":"偏州地狭民事简，醉翁自放山水中。\n琅琊倚天色苍翠，逊泉落石声玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涵虚阁","author":"富弼","text":"画阁高连百雉城，涵虚应不愧标名。\n门前柳色兼旗色，座上琴声杂佩声。\n肯羡五湖归范蠡，未饶三径隐渊明。\n我来恰值初晴后，山影波光分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弼承索近诗复贶佳句辄次元韵奉和诗以语志不必更及乎诗也伏惟一览而已 其二","author":"富弼","text":"赋分萧条只自如，生平常向官情疏。\n亡功每叹孤明主，得谢何妨作老夫。\n官品尚叨三事贵，世缘应信一毫无。\n病来髀肉消几尽，尤觉阴阳系惨舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定州阅古堂","author":"富弼","text":"朔方之兵，劲于九土。\n尤劲而要，粤惟定武。\n兵劲在驭，用则罴虎。\n失驭而劲，骄不可举。\n曰保曰贝，闭壁连阻。\n武爵新守，束手就虏。\n皇帝曰噫，汝武曷取。\n有敝必革，以儒于抚。\n公来帅定，始以威怒。\n有兵悍横，一用于斧。\n连营怛之，胆栗腰伛。\n既惧而教，如餔如乳。\n以刺以射，以钲以鼓。\n无一不若，师师旅旅。\n列城自刺，靡不和附。\n阴沴为梗，降此大雨。\n大河破泄，在河之浒。\n民被黜垫，田入莽污。\n流离荡析，不得其所。\n公戚曰吁，予敢宁处。\n乃大招来，乃大保聚。\n乃营帛粟，寒衣饥茹。\n民归而安，水下孰禦。\n强弱死生，由公复虑。\n曰义曰仁，震肃春煦。\n合和蒸天，天顺以序。\n公境独稔，爰麦爰黍。\n公俗独乐，夫耕妇杼。\n人虽曰康，公亦奚豫。\n谓此一方，民与兵具。\n务剧任重，稽古其裕。\n人皆谓公，与古为伍。\n公文化民，公武禦侮。\n何思古人，公不自许。\n遂择奇匠，绘于堂宇。\n列其行事，指掌可数。\n前有古人，在我门户。\n后有来者，依我墙堵。\n斯堂勿坏，有堂有故。\n堂之不存，来者曷睹。\n宏乎焕乎，千载是矩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"富弼","text":"遗德被生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"府舍西轩作","author":"刘概","text":"昔年曾作潇湘客，憔悴东秦归未得。\n西轩忽见好溪山，如何尚有楚乡忆。\n读书误人四十年，有时醉把阑干拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偈","author":"富弼","text":"执相诚非，破相亦妄。\n不执不破，是名实相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多丽 寿刘帅","author":"富㩋","text":"淡云收、晓来春满湘中。\n柳如烟、花枝如糁，万红千翠织浓。\n照帘旌、微穿丽日，动罗幕、轻转香风。\n天上良辰，人间淑景，生贤和气显殊钟。\n映时表、南山北斗，相并两穹崇。\n须知道、英明罕比，文武谁同。\n奉慈亲、承颜戏彩，更闻吉梦占熊。\n扫蛮氛、遂清三楚，定徐方、行策元功。\n趣召遄归，康时佐主，指挥谈笑虏巢空。\n寿觞举、器舟斟海，不用水精钟。\n休辞醉，千龄会遇，美事重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"强幼安","text":"山僧不解数甲子，一叶落知天下秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日有感二首 其二","author":"强至","text":"忆昨方陪上相筵，召书忽到菊杯前。\n主人举酒勤令饮，一醉秋风恰二年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日有感二首 其一","author":"强至","text":"每岁登高尽醉归，未曾轻负菊花期。\n今年枕上酬佳节，感泪双痕落似丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十日龙兴寺饮饯蹇磻翁赴梁门酒半题名南轩因偶书屋壁","author":"强至","text":"昨日曾来把酒卮，隔宵已过菊花期。\n回头一笑成陈迹，不独秋香有盛衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十六日偶书","author":"强至","text":"旧年把酒对花频，酒气花香日傍人。\n今岁酒疏花未见，惟将感泪湿青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又自和二首 其二","author":"强至","text":"好把悲欢付一卮，明朝北客有行期。\n劝君莫听骊驹曲，只恐催人两鬓衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又自和二首 其一","author":"强至","text":"万事人间若漏卮，喜情常满固难期。\n却将昨日樽前菊，零落金钿己觉衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十日作","author":"强至","text":"一病十日不出门，坐销芳意疏清樽。\n今朝骑马探花去，枝上十空无一存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上诗惠酒有谢","author":"强至","text":"登高无具结欢悰，狂写愁吟叩主翁。\n遽荷兵厨均美酿，却将酩酊谢西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上见庭竹","author":"强至","text":"玉圆碧瘦与谁期，只待丹山綵凤饥。\n生傍短墙真失所，可怜直节众人窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书香山寺壁","author":"强至","text":"精蓝孤绝乱云间，云外疑无路可还。\n顾我尘喧非白傅，缘何今日到香山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公度惠花走笔戏谢","author":"强至","text":"二月都城未见花，不知春色落谁家。\n满盘折惠情何重，略嗅生香思已嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勾院偶书","author":"强至","text":"一坐閒窗百虑清，门前宠利自营营。\n官书既少人喧息，唯有严风戛竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"升甫旋和答复走笔酬之","author":"强至","text":"嫩箨斑斑玳点匀，圆肤细细玉条新。\n渭川美实容先食，却向秋风懒忆莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太阳岭","author":"强至","text":"高侵寥廓势盘纡，倦足登时每一吁。\n方寸人心犹有险，况教广地尽平涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开元寺仁王院见丛竹偶书","author":"强至","text":"一别琅玕数亩阴，七年飞梦绕家林。\n北僧好事犹能种，偶向尘埃洒寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文通复用旧韵相示仍走笔和之","author":"强至","text":"花前直判醉酬春，饮量惭非刘伯伦。\n折去也应颜色在，不知谁是戴花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢申之以惠山泉二斗为赠因忆南仲周友二首 其二","author":"强至","text":"文园病渴酒难浇，望见南泉意已消。\n买得茶来无铫煮，只将清泠送箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢申之以惠山泉二斗为赠因忆南仲周友二首 其一","author":"强至","text":"旧年拂石坐松阴，曾与周郎共访寻。\n沦落人间少知味，一逢瓶榼便伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲寅立春夜雪","author":"强至","text":"迎得新年送腊回，一朝生意动寒荄。\n玉尘后夜笼金阙，元是春风带雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"穴泉","author":"强至","text":"泠泠西穴间，终日滴甘乳。\n道傍渴者多，切莫饮豺虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春二首 其二","author":"强至","text":"菜丝生叶落雕盘，欲去春衣怯晓寒。\n惟有多情双彩燕，不须风暖舞钗端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春二首 其一","author":"强至","text":"待得春来解病颜，东风犹细北风顽。\n未全青帝行新令，腊去元须浃日间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏书保安院壁","author":"强至","text":"僧言此寺从唐建，冠盖无人一到来。\n还似长官居僻邑，不逢使者枉行台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有待","author":"强至","text":"来时帘捲昼，坐久竹移阴。\n有待无消息，南窗睡兴深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朱郎中以梅花衣香分惠诸君皆有诗谢依韵和之","author":"强至","text":"百和慇勤出省郎，清真似有雪中香。\n风流不在金炉煖，自转馀薰到锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和纯甫游宝掌遇雨","author":"强至","text":"游骑来逢雨，宁全是折磨。\n山神应洗路，恐惹俗尘多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游山雨中","author":"强至","text":"飞飞烟雨恼春游，几许馀花水上流。\n独有佳人折残艳，归来满插凤钗头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬礼之见赠","author":"强至","text":"为吏淮壖岁欻周，不如当日傲公侯。\n君今亦欲折腰去，遇好云山且胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过伯乐庙","author":"强至","text":"庙下孤坟偿是非，坏檐仄柱若凭依。\n门前过马空骧首，那得当年一顾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别户部勾院竹","author":"强至","text":"一来省户两春晖，今日飘然襆被归。\n直节贞心惟我爱，此君相别似依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]