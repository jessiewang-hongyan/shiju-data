[{"title":"牧童歌十首 其三","author":"蒲寿宬","text":"隔溪骑度水，浮去似鸱夷。\n莫话五湖事，且看牛背儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其二","author":"蒲寿宬","text":"软坡便伫犊，凉荫聚群髫。\n一竖忽然起，恐牛残豆苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童歌十首 其一","author":"蒲寿宬","text":"荷笠小苍头，犊裈乘水牛。\n扬鞭自叱咤，度陇复凭沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青霞","author":"蒲寿宬","text":"百尺长松岩下风，一轮明月屋西峰。\n梦回细数登山路，知在青霞第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青霞西亭","author":"蒲寿宬","text":"长松被薜荔，怪石生烟霞。\n檐牙木杪见，上有山人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓闻禽","author":"蒲寿宬","text":"唤回春梦几声禽，涧草岩花动此心。\n搔首偶然自失笑，不知何处是山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游武夷偶成棹歌一首","author":"蒲寿宬","text":"一派弯环九曲溪，溪深溪浅净无泥。\n鹭鸶不作窥鱼计，飞入屏风也似迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺意","author":"蒲寿宬","text":"聘得深村玉雪姿，力胜杵臼案齐眉。\n笑他老大专房宠，犹把房帏比旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻鸡","author":"蒲寿宬","text":"无数穷檐苦夜悠，一声惊散枕边愁。\n天家合把黄金铸，置向竿头赦九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻泉","author":"蒲寿宬","text":"山椒一雨过，石罅百泉鸣。\n应接都不暇，更兼秋月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻蝉","author":"蒲寿宬","text":"闭息含真抱叶枯，春风将尽蜕寒肤。\n绿槐忽作仙人啸，长曳一声山日晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涧亭麈尾泉","author":"蒲寿宬","text":"泉挥玉麈尾，岫拥翠云裘。\n尽日看不足，倚阑生古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读可翁閒坐偈","author":"蒲寿宬","text":"夜久风浪息，骊龙弄颔珠。\n水怪不敢动，明月满江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酒量减","author":"蒲寿宬","text":"少年一日几鸱夷，瓦甓而今力不支。\n莫笑杯中酒量减，至和全在半醺时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石隐","author":"蒲寿宬","text":"闭门十日雨，破屋砌生苔。\n此意何人会，抱琴来不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食有感","author":"蒲寿宬","text":"杏粥因怀旧，榆羹岂为春。\n凭将禁火事，说与乞墦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棹歌","author":"蒲寿宬","text":"鼓枻归去来，蓑风鸣策策。\n明月倾我壶，沧浪天一碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锡老弟山居","author":"蒲寿宬","text":"君住南山我北山，隔溪斜照见炊烟。\n相寻懒趁溪边路，村酒时沽上钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题叶寄杨芸夫","author":"蒲寿宬","text":"吟得秋风老，敲窗意转深。\n凭将林下事，为寄与知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题西山灵峰感应寺","author":"蒲寿宬","text":"路入灵峰西复西，桄榔叶暗古招提。\n山僧更在云深处，花落苍苔幽鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题纯阳洞","author":"蒲寿宬","text":"道士当年九日山，侧身西望翠云间。\n一枝乞倚纯阳洞，万仞崔嵬不可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题武夷","author":"蒲寿宬","text":"九曲诸峰向背殊，丹青虽巧不能模。\n堂堂标致高如许，灵迹何须问有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题画竹扇寄友","author":"蒲寿宬","text":"明月二千里，清风一万竿。\n相思写不得，写出梦来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照画山水渔父四轴 其四","author":"蒲寿宬","text":"野航偶繫梅花下，人在梅花与雪俱。\n直钓情知鱼不食，一丝终日挂冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照画山水渔父四轴 其一","author":"蒲寿宬","text":"裂石断崖如赤壁，暗想当年学士苏。\n巨口细鳞新网得，一樽惟有月相娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照画山水渔父四轴 其二","author":"蒲寿宬","text":"轻蓑短棹下沧浪，不是寻常黄帽郎。\n料应江上青山色，肯博人间白玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照画山水渔父四轴 其三","author":"蒲寿宬","text":"火云收尽天逾阔，野艇归来日未斜。\n秋思满江禁不得，又吹长笛出芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赠枯崖","author":"蒲寿宬","text":"玉麈无心试出拈，山房春静燕窥檐。\n相思独上青霞顶，閒倚栏干望塔尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠老溪孚上人","author":"蒲寿宬","text":"玉涧双盘略彴过，对人扪虱坐鸡窠。\n煮茶与客早归去，落日前山路更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠林愚庵墨梅","author":"蒲寿宬","text":"色空已解花光意，香影难随逋老踪。\n此叟芒端不著蜜，几回曾误壁间蜂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瀑上见梅有怀老溪上人","author":"蒲寿宬","text":"野水横斜最老枝，一生心事雪霜知。\n世人重眼不重鼻，祇爱花光与补之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕前二日与窥堂庄使君江横观水望霓怅然","author":"蒲寿宬","text":"倚阑人不识，怀古尚心惊。\n坐想瀰漫意，卧闻鞺鞳声。\n浪翻京口寺，潮打石头城。\n莫说南柯事，相宽老大情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九日登山","author":"蒲寿宬","text":"日月百年宽，良辰天不悭。\n秋来常对菊，情适便登山。\n户外无尘鞅，篱边有酒颜。\n当时老彭泽，幽事独相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十三夜道士湖汎月","author":"蒲寿宬","text":"万事廓悠悠，因贫得纵游。\n天悭一样月，人有几中秋。\n短笛芙蓉浦，芳尊杜若洲。\n清狂欠拘束，谁恕道家流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三叠泉庐山简寂观十五里一名撷泉","author":"蒲寿宬","text":"此岂凡间物，神人疑属餍。\n踏翻云母碓，放出水精帘。\n娥女愁遗佩，冰虬或弄髯。\n鲛绡一百丈，织出浪纹纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与小儿助子游江横作","author":"蒲寿宬","text":"葺荷偶忆湘累句，筑屋还寻杜若汀。\n孤树每留残日白，片帆徐度远山青。\n海鸥知我断机虑，渔父与谁分醉醒。\n何处扁舟横短笛，月明风袅不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与兴福老枯崖乘月观涛","author":"蒲寿宬","text":"无心携起碧筇条，偶尔来从渔父招。\n山色多情似吴越，涛声牵梦到金焦。\n鱼龙一任风云便，鸥鹭不知天海遥。\n共倚栏干秋月白，岂期真乐在今宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小儿生日","author":"蒲寿宬","text":"今年二十八，细忆始生时。\n渐喜山多树，尤怜水满池。\n相宽吾老大，自教尔童儿。\n佛诞明朝是，然香共展眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山园芍药忽有花喜而赋","author":"蒲寿宬","text":"披草篱根问旧花，一番春事又萌芽。\n非因老态逢时感，祗怨昏瞳作雾遮。\n何处而今寻烂熳，不图于此见英华。\n翻阶自合流芳咏，可惜飘零野客家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人余兄归小诗寄胡苇航","author":"蒲寿宬","text":"别去又梅时，夷涂岂倦驰。\n能存二顷事，宁畏十年迟。\n耐冷心如铁，因吟鬓欲丝。\n犹嫌夜来梦，不解说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人若木余兄告归诗以送之","author":"蒲寿宬","text":"两年游海国，一半在山扉。\n政喜沙鸥狎，忽惊辽鹤归。\n苦吟黄叶落，凝睇白云飞。\n志已坚亲养，难分薜荔衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心泉","author":"蒲寿宬","text":"来寻万古意，聊结此生缘。\n久视都无物，中间只见天。\n灵根何处觅，露液晓初鲜。\n白发今如此，扪松忆少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨终夜独坐不寐","author":"蒲寿宬","text":"风雨潇潇到夜终，夜寒一室坐虚空。\n何当乐与二三子，免使凄其六一翁。\n老大自甘为老大，穷通休苦较穷通。\n此心不作窥园想，流水落花春梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柬曾梅坡二首音弃 其二","author":"蒲寿宬","text":"靡靡秋已驶，眇焉幽思殷。\n美人百尺楼，修帽千丈云。\n白驹古难絷，寒蛩今畏闻。\n得酒且共陶，莫惑纸上文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柬曾梅坡二首音弃 其一","author":"蒲寿宬","text":"终岁不相见，相逢倾肺肝。\n堪嗟半生事，安得旧时欢。\n梅蕊先春白，桂华清露寒。\n帽云行雨意，薄暮倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用老竹与子晦韵","author":"蒲寿宬","text":"冰清玉洁好风襟，老屋凄凉兴味深。\n身世已非尘外迹，语言犹是竹边音。\n且陪此日莺花乐，休忆当年灯火心。\n白发相看能几许，樽前须要惜光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用翁雪舟送春韵三首 其三","author":"蒲寿宬","text":"底事黄鹂唤不休，出门欣见绿阴稠。\n残花满地无人扫，芳草连天起客愁。\n泪落田间闻牧笛，醉归江上问渔舟。\n杜鹃也合催春去，何处而今孟浪游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用翁雪舟送春韵三首 其二","author":"蒲寿宬","text":"隙驹如箭未堪怜，晴雨悲欢付自然。\n九十春光能几日，一番花信又明年。\n残红数点心终在，垂柳千丝意许妍。\n说与游人莫惆怅，绿阴幽草一般天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用翁雪舟送春韵三首 其一","author":"蒲寿宬","text":"锦衣年少不知愁，风雨无端恼客游。\n万点残红空过眼，一番新绿又从头。\n夕阳细草堪横笛，野渡垂杨可系舟。\n三百六旬浑是醉，饯春何用苦绸缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田园秋兴","author":"蒲寿宬","text":"草屋柴门风露凉，寒瓜收蔓力锄荒。\n新栽莙荙恰逢雨，欲剪芹蓝犹待霜。\n牧竖归来煨芋熟，田翁相就泼醅香。\n里胥偶报徵苗急，自辟閒畦早筑场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石潭观鱼","author":"蒲寿宬","text":"拂石支颐久，閒心寂似初。\n不知浑是水，宁觉我非鱼。\n欲数犹疑幻，相看若在虚。\n星星双鬓影，何事入方诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵和苇航","author":"蒲寿宬","text":"长江不直一杯宽，自笑狂生笔力悭。\n有酒何须誇戏马，绕篱岂必强登山。\n世无刘表谁知已，人说渊明我厚颜。\n风雨满城都过了，多簪黄菊出松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题江横","author":"蒲寿宬","text":"一榻虚明怀抱幽，水天无际望悠悠。\n潮来不觉沙洲没，浪打只疑茅屋浮。\n何处渔人横短笛，有时嫠妇泣孤舟。\n忘机何必曾相狎，说与江边群白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回谒蓝主簿道傍见梅偶成","author":"蒲寿宬","text":"谁家一树铁斜攲，的皪疏花出短篱。\n黄叶久随风捲地，幽姿当与雪同时。\n白头朔漠穷苏武，瘦骨西山饿伯夷。\n三嗅清芬一杯水，徘徊无语笑掀眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁旦勉田邻","author":"蒲寿宬","text":"岁律从新泰道亨，出门欣见麦青青。\n已无关外石壕吏，遥望城头紫气星。\n往事莫追由世数，宽恩频下为生灵。\n而今颇觉农为重，说与村村父老听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮度朋山岭登山庵追慕先人不胜悲怆因用杨敬夫韵","author":"蒲寿宬","text":"岁寒霜露感，况复度高深。\n云木犹如此，苔矶不忍临。\n溪流一线碧，门对两山岑。\n含涕危亭曲，遗言尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次清老弟韵","author":"蒲寿宬","text":"恐负东风约，清唫野步迟。\n淡烟杨柳外，微雨海棠时。\n远寄千杯绿，多情两鬓丝。\n閒愁须遣尽，蜂蝶不堪羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江横暮景","author":"蒲寿宬","text":"独倚阑干对落霞，垂杨古渡欲栖鸦。\n渔翁何处烟藏浦，白鹭成群月浸沙。\n泪落西风叫黄鹄，酒阑深夜听琵琶。\n谁人得似鸱夷子，一叶浮云总是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"约赵委顺北山试泉","author":"蒲寿宬","text":"拟寻青竹杖，同访白云龛。\n野茗春深苦，山泉雨后甘。\n鸟声尘梦醒，花事午风酣。\n静趣期心会，逢人勿费谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西岩","author":"蒲寿宬","text":"石路层层碧藓花，矮窗低户足烟霞。\n愁闻独鹤悲寒角，静阅群蜂凑晚衙。\n野菜旋挑奚待糁，石泉新汲自煎茶。\n炉熏销尽抛书卷，閒倚阑干看日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"蒲寿宬","text":"江楼人卧病，寂寞更谁怜。\n有子常离抱，无家可祝先。\n雕墙笑茅屋，沧海幻桑田。\n昨听东邻讣，浮华亦梦然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席用委顺听甘师琴韵","author":"蒲寿宬","text":"独抱琴声感岁年，搜趣外欲无弦。\n广陵寂寂嵇生去，秋木幽幽鸣犊贤。\n一点山泉岩窦雨，数声瑶佩泬寥天。\n音徽千载何人会，愿和薰风殿阁前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近重阳作","author":"蒲寿宬","text":"满城风雨近重阳，梧竹萧萧欲断肠。\n敢望白衣来送酒，拟将黄菊去为粮。\n系萸安得山堪避，落帽岂无人在旁。\n千载风流心独会，饮泉亦足慰凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒坐海观兴致悠然是时月白如昼","author":"蒲寿宬","text":"一笑灵龟尾曳涂，扁舟聊复寄菰蒲。\n潮生潮落帆来去，云卷云舒山有无。\n风定若教胥怒息，月明空忆蠡游孤。\n渔翁不识人间事，白发青蓑酒满壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阿助守岁诵杜工部四十明朝是之句请足成","author":"蒲寿宬","text":"四十明朝是，瞻天祇乞閒。\n自惭身计拙，早觉鬓毛斑。\n守岁从儿喜，搀春借酒颜。\n盍簪喧马意，清梦五云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵寄呈林城山","author":"蒲寿宬","text":"邻蛩深夜语幽幽，犹此尘埃一敝裘。\n甘菊已荒归栗里，蒲萄堪醉胜凉州。\n知心海上千年鹤，极目云间五色楼。\n白发正殷松柏念，不因泉石老斯丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨芸斋送枯崖住兴福韵","author":"蒲寿宬","text":"一夜春光到竹门，东风拂拂动閒云。\n钳锤粗了人间债，瓶锡暂抛林下群。\n烟塔忽惊当户立，霜钟犹记旧山闻。\n高谈亹亹天花落，老衲廊头意自欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡竹庄韵","author":"蒲寿宬","text":"脱落皮毛尽，而今肠亦无。\n泣非缘楚玉，声不叶齐竽。\n举目云天迥，论心水月孤。\n祇应饮美酒，跳入费公壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和倪梅村","author":"蒲寿宬","text":"偶携琴册傍林泉，坐对梅花记往年。\n鸿燕何心成巧避，夔蚿无语自相怜。\n才唫瘦影黄昏月，又见残红细雨天。\n拟把楚骚重载酒，掀髯抵掌话前缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜闻邻笛","author":"蒲寿宬","text":"幽梦初回漏未央，起闻邻笛倍凄凉。\n不知何处石崖裂，忽送一声江水长。\n短棹清风怀赤壁，断垣斜月隐山阳。\n犹疑吹到梅花落，不见梅花空搅肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"委顺赵君见遗千里小景鸦鹊图有诗将之用韵为谢","author":"蒲寿宬","text":"朝拂扶桑影，暮寻明月枝。\n群飞心共远，三匝意犹迟。\n相向无声里，应思落笔时。\n寸程千里阔，惟可与君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]