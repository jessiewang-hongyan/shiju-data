[{"title":"山中吟七首 其二","author":"毛珝","text":"采薇作庭实，纫兰作筐篚。\n持以荐王公，谓可蘋藻比。\n王公龋齿谢，王门何用此。\n问客姓与名，或是孤竹子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中吟七首 其三","author":"毛珝","text":"山中夜读书，山鬼来相试。\n隔窗问疑难，颇及尧舜事。\n予非卯金人，安能动星纬。\n划然一推窗，馀音入空翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中吟七首 其四","author":"毛珝","text":"山翁不能文，亦免时流笑。\n早爱沧浪歌，知词不知调。\n长年山水间，所业只耕钓。\n偶得千龄龟，遂通八卦兆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中吟七首 其五","author":"毛珝","text":"山花开满枝，山鸟啼无时。\n君胡欲弃此，自取尘污为。\n山猿齧君屦，山鹿衔君衣。\n挽君君不留，去去终何归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中吟七首 其六","author":"毛珝","text":"槲叶可以衣，松实可疗饥。\n骑鹿下山去，儗说高人知。\n高人不可得，纷纷却语谁。\n晓窗白云过，且自相同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中吟七首 其七","author":"毛珝","text":"题笺寄亲友，早早山中来。\n紫芝既可采，蟠桃行当开。\n持书托南风，北风复吹回。\n爱之不可见，落日令人哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己酉客淮","author":"毛珝","text":"烽燧春尤急，人才叹寂寥。\n恨无黄石略，难致碧幢招。\n守堑宵仍甲，防城晓未桥。\n又传经一雪，残哨亦萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过黄山法华寺","author":"毛珝","text":"积雪满松岗，兹行为悼亡。\n本非求吉地，祇欲近禅坊。\n外物心如水，流年鬓已霜。\n只应双卜宅，永此礼空王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送田耕月游吴 其一","author":"毛珝","text":"衣笈诗囊外，身轻费亦轻。\n不妨船眼窄，时上岸头行。\n橘里逢霜信，松江问水程。\n吴中闻岁稔，新籴想须平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送田耕月游吴 其二","author":"毛珝","text":"登桥仍问渡，迢递到吴中。\n倩仆挑茶灶，移船避钓筒。\n月生林屋洞，潮接馆娃宫。\n得句人传去，苏笺价益穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送田耕月游吴 其三","author":"毛珝","text":"此去姑苏郡，都无五日程。\n仍闻新太守，最重旧交情。\n有句梅边索，无田月下耕。\n双亲方待养，吾亦勉君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其一","author":"毛珝","text":"去年一涝失冬收，逋债于今尚未酬。\n偶为灼龟逢吉兆，再供租约赁耕牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其二","author":"毛珝","text":"竹罾两两夹河泥，近郭沟渠此最肥。\n载得满船归插种，胜如贾贩岭南归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其三","author":"毛珝","text":"到处车声转水劳，东乡人事独逍遥。\n一堤滟滟元非雨，总是吴江淡水潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其四","author":"毛珝","text":"今年田事谢苍苍，尽有瓶罂卒岁藏。\n只恐主家增斛面，双鸡先把献监庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其五","author":"毛珝","text":"主家租入有常规，十月开仓不许违。\n占得头筹先众了，绕身红綵送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其六","author":"毛珝","text":"西乡本是最高乡，今岁收成亦倍常。\n瓦鼓綵亭连日闹，谁家不谢白龙王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其七","author":"毛珝","text":"村村鼓笛乐秋成，露未凝霜水未冰。\n无赖酒家偏罔利，隔年早挂上元灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其八","author":"毛珝","text":"田家少妇最风流，白角冠儿皂盖头。\n笑问傍人披得称，已遮日色又遮羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其九","author":"毛珝","text":"长襟侈袖若僧衣，闲荡扁舟入郭嬉。\n好是醉归村舍晚，声声耳畔阿郎儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴门田家十咏 其十","author":"毛珝","text":"主家文榜又围田，田甲科丁各备船。\n下得桩深笆土稳，更迁垂柳护围边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘寺","author":"毛珝","text":"曾住昭阳殿里头，何年香骨掩荒丘。\n虚传碧落归仙去，谁见苍梧从帝游。\n鸾阁粉销尘影暗，蜃炉香冷石人愁。\n风前不敢梅花折，犹恐君恩宠未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿广果寺","author":"毛珝","text":"寺门初掩夜沉沉，风逼灯寒桧影深。\n满屋异香僧入忏，一瓯新茗客搜吟。\n云归古殿闻龙气，月照空池见佛心。\n坐久恰眠眠未稳，屋头钟起鹊惊林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵","author":"毛珝","text":"虎踞龙蟠在目前，依前行阙锁寒烟。\n津头鼓角增新戍，陌上笙箫减旧年。\n高塔直看淮对境，断碑闲忆晋诸贤。\n我来尚喜秋成日，鱼蟹堪赊满市边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拄杖","author":"毛珝","text":"数节坚如玉削成，几年出入伴闲身。\n扶持衰老非无术，变化虚空亦有神。\n药笼倒挑同入市，酒壶斜挂共寻春。\n虽然未作颠危用，闲指迷津与路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数椽","author":"毛珝","text":"梅有清香竹有阴，数椽于此寄幽深。\n旧看归雁抛孤旅，新听啼螀悔苦吟。\n几卷书皆先世迹，一张琴是古人心。\n柴门未必无知己，何必江湖在远寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈藏一山房","author":"毛珝","text":"一室焚香即太初，万人如海尽从渠。\n第于心上曾无着，何必山中始可居。\n垂箔护花嫌引蝶，连筒汲井怕生鱼。\n草玄政不妨人事，问字敲门未可疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日寓越之三江","author":"毛珝","text":"客里元正最可怜，就他香案礼苍天。\n懒拈蓍草占新岁，频对菱花忆去年。\n仅有邸翁分席拜，不如野老着衣鲜。\n百年草草浑如此，且醉残梅了目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂","author":"毛珝","text":"天上分来种异常，年年花占菊前黄。\n堆将龙麝应难敌，隔尽屏帷亦透香。\n此日且饶秋富贵，全家疑在月中央。\n明朝酒醒风吹尽，赢得黄金满步廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沧浪亭","author":"毛珝","text":"濯缨人去水空寒，事属明时欲问难。\n日暮客归园馆闭，鹭鸶飞上石棋盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石湖","author":"毛珝","text":"一片湖光接薜萝，功名馀事属吟多。\n至今鱼鸟皆堪敬，曾见乌巾照碧波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旴江舟中联句","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南台舟中联句","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疏山舟中联句","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟浮石寺前有善士百馀辈拜迎因联句于水滨民居之壁","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏联食?体取其骨糜肉化之义","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏联仄字体","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏联平字体","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏联叠韵体","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏联回文体","author":"黄春伯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访白玉蟾值其出题壁","author":"黄春伯","text":"怪访怪，怪不在。\n茅君山，来相待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句","author":"黄春伯","text":"半篙春水一蓑烟，抱月怀中枕斗眠。\n说与时人休问我，英雄回首即神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景德观枕流","author":"白玉蟾","text":"寒泉泻破青山腹，青山不改寒泉绿。\n幽人一心泉石心，倚溪著此数椽屋。\n窗外飘喷万斛珠，枕边玲珑一片玉。\n山涧金龙啸欲飞，涧底银蟾清可掬。\n敲磬愁惊晓鹭眠，停经坐看昏鸦浴。\n香浮茗雪滋肺腑，响入松涛震崖谷。\n清净耳观绝弦琴，广长舌相无生曲。\n客来坐此亦忘归，溪南溪北千竿竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得友人书","author":"白玉蟾","text":"千里如天远，三年不此来。\n书从云外至，手把月中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步自玉乳峰归 其二","author":"白玉蟾","text":"月映山头秃，云迷路口叉。\n仰天方索句，一鹤立松丫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起雨作","author":"白玉蟾","text":"一枕梦云过，半空诗雨来。\n新蝉吟不了，尽晚自衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵永兴王宰游钟成观 其二","author":"白玉蟾","text":"眼力招回西去山，风蘋烟蓼白鸥闲。\n归舟满载斜阳返，欸乃一声空翠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜夕吟月 其一","author":"白玉蟾","text":"神飘骨竦影悠扬，独撚吟须恼醉肠。\n霜月慰人于冷寞，溪梅挑我以清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚","author":"白玉蟾","text":"玉殿朝回夜已深，三千世界静沉沉。\n微微花雨粘琪树，浩浩天风动宝林。\n烟锁昆崙山上顶，月明娑竭海中心。\n步虚声断一回首，十二楼台何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日同白玉蟾联句","author":"王枞","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯花联句","author":"王枞","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪窗联句","author":"王枞","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯花联句","author":"张云友","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪窗联句","author":"张云友","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯花联句","author":"刘希古","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪窗联句","author":"刘希古","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中与白玉蟾联句","author":"谢紫壶","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棹歌联句","author":"黎盘云","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜船与白玉蟾联句回文","author":"黎盘云","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百五十首 其六十二","author":"释心月","text":"凛凛孤风藏不得，倒骑角虎出山来。\n大唐国里人无数，谷酒谷糟唤不回。\n唤得回，笑容未动，牙爪先开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百五十首 其八十六","author":"释心月","text":"于食等者，于法亦等。\n于法等者，于食亦等。\n法食双运，平等普熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百五十首 其一四○","author":"释心月","text":"月五日亦五，那堪时正午。\n采药药最灵，问疾疾即愈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古十六首 其十三","author":"释心月","text":"问处赤心片片，答处不负来机。\n今有问灵隐，如何是实际理地。\n天长地久，海晏河清，恁么则事同一家。\n自天祐之，吉无不利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示圆阇梨偈","author":"释心月","text":"我有明珠一颗，久被尘劳关锁。\n而今尘尽光生，照破青山万朵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧过金山","author":"释心月","text":"不见德云闲古锥，淡烟寒日水涟漪。\n风行雷动他山上，也好低头问讯伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送保慧大师 其二","author":"释心月","text":"少林佛国不再见，台山大会堪凭□。\n彼何人哉我何人，眨起眉毛宜猛省。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题豫章台","author":"周弼","text":"何日遗踪锁断岗，更谁曾望旧台荒。\n百年南渡频秋雨，一片西山几夕阳。\n石碍老松攲径险，岸随乾苇出江长。\n斗间可是无佳气，又见飞乌绕去樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻雁","author":"周弼","text":"此是衡阳第几群，寂寥偏杂雨声闻。\n如今远道多矰缴，莫厌高飞入暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自戒","author":"徐元杰","text":"震畏四知，我畏我知。\n心之所畏，天不可欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯刘恭父二首 其二","author":"徐元杰","text":"乐事迟回致岁丰，几多遗爱在湘中。\n须知楚水枫林下，不似初闻长乐钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝山","author":"赵汝唫","text":"犬入五云音信绝，凤楼凝碧悄无声。\n焚香古洞步虚夜，露湿松花空月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦雨吟十首呈同官诸丈 其十","author":"吴潜","text":"老守最忧农，往来思虑忡。\n半时半刻里，一饭一茶中。\n饥溺真犹己，恫■在厥躬。\n天高元听下，一念岂难通。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水西村","author":"徐宝之","text":"又过江头黯淡时，野梅初见雪前枝。\n水霞错落书秦篆，烟树凄迷画楚辞。\n山店灯残人亦睡，寒洲月上雁先知。\n自题秋叶寻前梦，薄酒残蔬当夕炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风入我户","author":"徐宝之","text":"秋风入我户，翩翩动床帷。\n咄唶中夜起，奈何我心悲。\n四海岂不大，伤哉无己知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕湖上","author":"葛绍体","text":"云边雁影半浮沉，一片征帆万里心。\n水月光涵疑雪夜，小舟乘兴欲山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"猗澜即事","author":"葛绍体","text":"雨馀涨水欲浮空，云影中间著钓筒。\n小棹轻舟往来急，古槐斜日嫩荷风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]