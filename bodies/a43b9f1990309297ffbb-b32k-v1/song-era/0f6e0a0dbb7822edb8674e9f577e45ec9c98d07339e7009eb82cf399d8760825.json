[{"title":"雪溪塔","author":"释月涧","text":"六月炎天飞片雪，山河大地冷凄凄。\n三年祇道消融尽，冻合侯家水一溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄净慈愚极老叔","author":"释月涧","text":"见说翁翁老更颠，为人单只用粗拳。\n近来发得无明甚，打破虚空没半边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送俊侍者","author":"释月涧","text":"爷看千丈岩前瀑，顶雪遥应瀑雪同。\n石虎溪边倾石耳，要听铁锡响寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渊侍者自幻智塔所来就见翠岩木翁","author":"释月涧","text":"人从村草步头来，毒气经年不受埋。\n散作西山千嶂雨，毒花毒果几根荄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送肃庵长老归北","author":"释月涧","text":"倒跨金狮别五台，峨嵋庐岳眼中埃。\n袖藏小白花归去，人道亲提东海来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建育王塔","author":"释月涧","text":"越水新营窣堵波，与他玉几不争多。\n从今客路三千里，又累奔驰刘萨诃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新僧堂","author":"释月涧","text":"荐福重开地狱门，要从衲子结生冤。\n若还将胁沾他席，热铁烧身又一番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"番阳大浸","author":"释月涧","text":"本来清净无一物，大地山河忽渺瀰。\n童子不须抛瓦砾，老僧定观正斯时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"矶亭","author":"释月涧","text":"一亭新立雪矶头，漫向空中抛直钩。\n几度无风浮子动，老僧终是懒抬眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道者化栽树","author":"释月涧","text":"倒握仰山锹在手，掀翻大地觅知音。\n纵饶济北阴凉树，入土也须三尺深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送鹅湖挽侍者","author":"释月涧","text":"笑穿无耳破芒鞋，赐得高低百丈摧。\n月涧有拳当赠汝，只今忙甚别时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圣旨看藏经","author":"释月涧","text":"于一微尘出此经，万象森罗著眼听。\n殷殷春雷撼天地，同是三呼万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人","author":"释月涧","text":"青山立玉水粘䒶，祖意明明在目前。\n短堠长亭何所许，处处春风啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄天童日东岩","author":"释月涧","text":"村草步头草几深，从教埋没祖师心。\n也应曾不著眼觑，觑著还应恨拍襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题可长老寿塔","author":"释月涧","text":"汝今未老早安排，窣堵波从此地开。\n胜处笑曾舒老眼，好一矗矗送青来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谦侍者之天童","author":"释月涧","text":"长庚峰顶展炊巾，白日青天海岳昏。\n痛棒当机连架打，低声道我是师孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送才首座 其一","author":"释月涧","text":"冤家别去幸相疏，不拟重来胆气粗。\n三十乌藤不轻恕，也知年老觉心孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送才首座 其二","author":"释月涧","text":"海国山山叫子规，不知何处卸征衣。\n拳头自是娘生底，莫向诸方肋下挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天童化五凤楼","author":"释月涧","text":"太白峨峨峙碧霄，百千诸佛欠遮头。\n愿君施五凤楼手，成我山中五凤楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顺维那归仰山","author":"释月涧","text":"近日传闻小释迦，恣施瞎棒与盲枷。\n再参通我一转语，春至山山桃自花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送住禅人归疏山","author":"释月涧","text":"住住住，眨眼白云飞去。\n杜鹃声在最高处，春风花满甜桃树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送亲宗古住西山崇报 其一","author":"释月涧","text":"满天花雨忽毵毵，定起闲将鼻观参。\n却是西山山下寺，古薇枝上绽优昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送亲宗古住西山崇报 其二","author":"释月涧","text":"法道如今危未危，老眸近觉泪沾颐。\n期君硬著腕头力，一发千钧在此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中道者","author":"释月涧","text":"笑问殷勤求底事，却言近离古杭州。\n开口便作佛法会，老来无力举藤条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙禅人","author":"释月涧","text":"一人半人之所在，吴越从头验一回。\n三尺炊巾襟袖里，向人只道看山气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寂林","author":"释月涧","text":"我国从来本晏然，萧条活计自忘年。\n无端一阵微风过，万树苍松竞说玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"镜清塔","author":"释月涧","text":"阿师活葬此江皋，障却钱塘几度潮。\n可是髑髅乾不尽，蛙声依旧响春宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东黄龙雪村","author":"释月涧","text":"一别龙峰五十年，堪嗟尘世事茫然。\n门前旧日长松树，恨杀春风啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书明月山房","author":"释月涧","text":"猗欤大块中，有此赤肉团。\n曾无生与死，从渠暑复寒。\n炽然常说法，风动万琅玕。\n了然无一物，满目是青山。\n以幻观吾幻，以闲乐吾闲。\n世态自消长，日月长循环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出山相赞","author":"释月涧","text":"正觉山中与么来，惭惺满面是尘埃。\n未曾空却众生界，添得人间一祸胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨赞","author":"释月涧","text":"开口触著梁王讳，举步踏翻扬子江。\n比似者般底粗行，西天东土更无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音赞 其一","author":"释月涧","text":"蒙却头，入正定。\n定眼忽开，有何所證。\n杨柳枝头春雨暝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音赞 其二","author":"释月涧","text":"抱膝坐盘陀，以耳观无碍。\n一匊悲心海样深，何时空却众日界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释月涧","text":"曲江矶头，奉化县里。\n拖泼囊落落魄魄，刚道一生欢喜。\n不知月在云中笑你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释月涧","text":"无端抛却率陀天，奉化江头恣掣颠。\n拄杖夺来还痛与，我侬要结下生缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒山赞","author":"释月涧","text":"山河大地，犹一点埃。\n面前扫却，背后成堆。\n呆，呆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拾得赞","author":"释月涧","text":"台云万丈，犹一菜滓。\n收拾筒中，如金自誇。\n差，差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丰干指虎与闾丘说赞","author":"释月涧","text":"所指是何物，所说是何言。\n心毒不如口毒，合成生死深冤。\n闾丘老，惜尊拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒山拾得赞","author":"释月涧","text":"忘却自家心，却指天边月。\n更言无物比伦，分明话作两橛。\n生苕帚，何不摵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝阳赞","author":"释月涧","text":"浑无针劄处，为君道线路。\n夜半三足乌，飞上珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对月赞","author":"释月涧","text":"白白是脱空，刚言标月指。\n便恁么回向，堕佗光影里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赞罗汉共一轴","author":"释月涧","text":"成群作队，指东话西。\n造妖捏怪，诳惑愚痴。\n神通妙用有谁知，天台月皎，南岳云垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赞丰干寒拾虎四睡图","author":"释月涧","text":"虎依人，人靠虎，一物我忘亦汝，肚里各自惺惺。\n且作团打觉睡，谁管人间今与古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赞童科安医师","author":"释月涧","text":"惟吾一指，造大极玄。\n视天下人，咸若小儿。\n起膏肓疾，犹谈笑然。\n貌可丹青，玄孰传焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇宁可长老请赞","author":"释月涧","text":"参无所参，悟无所悟。\n空手捏双拳，要起破沙盆。\n门户用尽拍盲，少喜多怒。\n也有一分长，甜瓜生苦瓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇报洪长老请赞","author":"释月涧","text":"跳出黄龙三重关，撞破天童生铁网。\n量太虚空为十尺，秤须弥山作八两。\n信缘随处住院，为人处惟拳与掌，当机佛祖难近傍。\n粗行拍盲，尽直北直南数来，更无此样。\n崇报切自知机，莫学渠侬个伎俩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"印甥请赞","author":"释月涧","text":"行脚见淳祐诸老，住院历南北两朝。\n不守黄龙活业，不传太白箕裘。\n为人处惯向弓弦上结丝，横机时每于险处断桥。\n设出古老文章，解教夫子咂舌。\n举示杜撰提唱，刚要达磨点头。\n长处全无，拙处偏优。\n是为杨岐十一世孙月涧比丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家兄同帧寿容","author":"释月涧","text":"有发兮谁兄，无发兮谁弟。\n不说道与禅，不谈仁与义。\n澹然相对各成翁，谁管两朝经乱治。\n丹青写出付升彪，大似空中插标记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景德遂长老请赞","author":"释月涧","text":"禅学全无拍盲，第一住山活计。\n竹篦三尺，怒发时鞭得虚空粉碎，编辟时拶得石人脑裂。\n更有一般没思忖处，陈年破砂盆，却要向景德镇里重新烧出。\n从头至尾数来，大元国里长老，烈烈挈挈无如你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇都寺请赞","author":"释月涧","text":"貌若宽闲，性尤刚急。\n不以佛法当人情，不以慈悲为利益。\n为人处热喝嗔拳，雪霜中有春消息。\n正崇为子却孝顺，见斧担重重添石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"源侍者请赞","author":"释月涧","text":"渠似我，我似渠。\n子相似，恰相如如处。\n毕竟何如，甜瓜生得苦葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇胜东源长老请赞","author":"释月涧","text":"苍苔裹枯松，白云抱幽石。\n面目俨然□，易见还难识。\n临济未是白拈贼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荐福鲁山长老请赞","author":"释月涧","text":"大江以东非生缘，大江以西非受经。\n行脚见宋朝三十七员恶知识，末后撞入天童布丝网里。\n折倒平生，视佛祖若大寇雠，视衲僧若大冤憎。\n五处住山，百无一能。\n无补宗教，不上传灯。\n效尤佛照授秀岩之法席，鲁山其克荷负，而道德深愧乎五宿观堂之老僧。\n谁费丹青，点涴太清。\n只好钓雪矶头，终朝笑看远山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐静空岩长老请赞","author":"释月涧","text":"受经黄龙，而不以为家。\n亲见天童，而不传其道。\n生宋绍定，阅七十历，有雪盈颠。\n住番荐福，踰二十年，无功可考。\n以棒喝结衲子深冤，以懒拙当人间至宝。\n隐静无端，凭妙峰邈出，类焉个枯桥。\n似者般无禅无道无能为底长老，尽直北直南何处讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"旌德道中即事","author":"汪梦斗","text":"天气才晴便不同，轻轻拂面有和风。\n溪边春事关心处，杨柳深青杏浅红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泾县琴台","author":"汪梦斗","text":"石台突兀倚晴空，一带春江泻玉虹。\n千古佳名唤行客，骑鱼何处访琴公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"当途道中社","author":"汪梦斗","text":"鹊信占新霁，朝暾起树东。\n春衫欺客冷，社瓮忆乡红。\n溪长杏花水，路蒸兰草风。\n午餐羹枸杞，扶弱有神功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过江陵镇登秦申王坟读决策元功精忠粹德碑文有感近事而赋","author":"汪梦斗","text":"力成和议得休兵，痛骂犹烦诸老生。\n拘执行人招覆灭，幸逃诛死罚殊轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵上王焕卿提刑","author":"汪梦斗","text":"英荡观风下帝旁，六条察吏立台霜。\n中原自古闻王猛，一道而今有范滂。\n园馆日和归燕乐，江城春透露桃香。\n公馀无限离骚兴，故许吟人拜下床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奥屯周卿提刑去年巡历绩溪回日有诗留别今依韵和呈","author":"汪梦斗","text":"皇华曾为歙山留，笑杀扬人汎汎舟。\n偶话后天非定位，悬知此辈固清流。\n一灯雪屋虫声细，疋马晴川草色秋。\n倚杖儒宫桥下水，梦魂须忆旧来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵僦舟渡江至仪真登陆 其一","author":"汪梦斗","text":"风冷知日落，水宽得天多。\n金陵怀古句，绝唱是西河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵僦舟渡江至仪真登陆 其二","author":"汪梦斗","text":"寒波白似面，远岫劣于眉。\n江上无多作，淮南正要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵僦舟渡江至仪真登陆 其三","author":"汪梦斗","text":"事以诗书立，国惟仁义昌。\n当年衣带水，元不管兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵僦舟渡江至仪真登陆 其四","author":"汪梦斗","text":"舟人忽惊问，春事已平分。\n江水浸钩月，晴空横疋云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵僦舟渡江至仪真登陆 其五","author":"汪梦斗","text":"风顺帆心饱，潮平棹尾收。\n拥书人自卧，一息到真州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵僦舟渡江至仪真登陆 其六","author":"汪梦斗","text":"天围春涨阔，水展夕阳红。\n已是淮南客，常吟江左风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明","author":"汪梦斗","text":"他乡逢冷食，故国隔长江。\n薄雨膏犹腻，落红香满腔。\n客游如梦醒，愁事被春降。\n正说扬州鹤，俄来雪一双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枕上漫成","author":"汪梦斗","text":"偶涉长江向北来，时寒江北较花迟。\n一春十日九风雨，百岁半生多别离。\n佛刹疏钟催客睡，酒楼戏鼓挠人诗。\n幽燕尚在黄云外，偻指何时是到期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈孝先制机论学","author":"汪梦斗","text":"词章记览固虚文，兀坐枯禅亦异闻。\n万事当如炉上雪，一心莫起镜中云。\n知行互进方为学，理欲相参及早分。\n吾道但从平实看，求之空寂便纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝应城北门外登崖散步","author":"汪梦斗","text":"夹道繁阴千步强，支筇聊当踏春阳。\n野花不识兴亡事，故故撩人为送香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山阳寄陈月观","author":"汪梦斗","text":"匆匆分手向天涯，便忆高斋聚首时。\n绕榻图书春睡醒，一灯风雨夜谈迟。\n幽州此去三千里，行客当归六月期。\n窗枕那堪秋思澹，瀹茶细与说相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风帆夜汎清河","author":"汪梦斗","text":"风饱晴川十幅蒲，月明乘兴泛玻璃。\n舟人生路须加谨，却道今非比旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟次比屋","author":"汪梦斗","text":"当年图上看中原，欲渡长淮梦断魂。\n今日绝淮载诗去，轻舟已自入桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃园县过雀杼镇即事","author":"汪梦斗","text":"草舍三家市，芦林半里城。\n滩乾去船涩，溪净露沙明。\n鸟迹不见过，蚌胎随处生。\n水心石人立，遥望似相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]