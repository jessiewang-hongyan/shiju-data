[{"title":"官况 其二","author":"虞俦","text":"触手逢人怒，低头与俗同。\n一惭那可忍，百巧固应穷。\n酒有兼旬绿，花无百日红。\n悲欢真破甑，堕地并成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝阁尚书凌公挽诗 其二","author":"虞俦","text":"未识嵇中散，今无元鲁山。\n宦游真恨晚，逸驾竟难攀。\n阅月推评旦，闻风尚起顽。\n九原那可作，苍弁亦推颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝阁尚书凌公挽诗 其一","author":"虞俦","text":"新学轻馀子，忠怀策万言。\n治安犹涕泣，师友故渊源。\n日曳尚书履，风生刺史轓。\n汉庭谁第一，殊未逊公孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往瓜州护使客回程","author":"虞俦","text":"寒天短日少晶辉，薄暮边城鼓角悲。\n外使方将接踵至，淮民未有息肩期。\n吁嗟道路频牵挽，表里河山几合离。\n闻道遗黎尚思汉，中原恢复定何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往瓜洲护使客回程","author":"虞俦","text":"北使朝京阙，东淮领计台。\n舟师虽夙戒，顿食更频催。\n州县愁劳费，风霜困往来。\n和盟终不赞，旧好政无猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枕上再赋","author":"虞俦","text":"折桂东堂又一回，秋花此外祇凡才。\n千岩万壑幽深处，玉露金风烂漫开。\n有客挥犀纷入坐，几时清燕小持杯。\n作诗且与留花住，青女繁霜未要催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枕上偶得数语呈林子长","author":"虞俦","text":"碧梧翠竹日相高，怀想家山魂梦劳。\n钟鼎故知非我事，箕裘犹可冀儿曹。\n眼中谁是真犀角，池上君今有凤毛。\n直探牛心屠狯耳，能安贫贱乃英豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林子中知府挽诗 其二","author":"虞俦","text":"畴昔因难弟，夤缘幸识君。\n宦途俱别日，苕水再披云。\n劳苦惊多病，悲凉惜离群。\n斗金峰下路，铎挽不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林子中知府挽诗 其一","author":"虞俦","text":"彩棒初行志，华途蚤策勋。\n旋闻凫舄召，径有虎符分。\n叹息谁为党，推求误到君。\n天公还愦愦，玉石竟俱焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林子长见访泊舟姑苏台下有诗因次其韵","author":"虞俦","text":"怀人玉树向风前，明月中秋动隔年。\n胜处杯中忘尔汝，几回纸上落云烟。\n已能命驾来吴苑，未许回舟指霅川。\n顾我从来无此客，渔蓑那得恋江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正甫与子中春并命为御史正甫按刑浙东道别去兼旬而予衔命按视宫陵经越上获一再款语临行有诗因次其韵 其一","author":"虞俦","text":"乌台当日选名流，佥谓君才与我优。\n公议略伸君便去，上恩未报我宁留。\n自怜秦缓难为疾，岂意良霄尚有莸。\n况是亲年当喜惧，欲将归计问扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正甫与子中春并命为御史正甫按刑浙东道别去兼旬而予衔命按视宫陵经越上获一再款语临行有诗因次其韵 其二","author":"虞俦","text":"衔命宫陵偶一回，山阴道上得徘徊。\n溟鹏好在思抟击，乘雁何尝计去来。\n万壑千岩况秋色，明珠白璧更尘埃。\n相逢未稳还为别，一段诗愁费剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正甫察院出示送刘德修都运殿院诗并德修和章人事好乖置之勿复道也第一见倾盖如平昔而万里远别又不能一面得非皆有不偶然者存乎勉强继韵一写胸中磊块而结恋之怀又有诗所不能尽者 其一","author":"虞俦","text":"吾道艰难孰使然，忧来真欲问诸天。\n方看骢马避桓典，遽为虾蟆赋玉川。\n去国身轻宁絜絜，爱君意在故卷卷。\n瞿塘滟滪风波恶，百丈孤骞上濑船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正甫察院出示送刘德修都运殿院诗并德修和章人事好乖置之勿复道也第一见倾盖如平昔而万里远别又不能一面得非皆有不偶然者存乎勉强继韵一写胸中磊块而结恋之怀又有诗所不能尽者 其二","author":"虞俦","text":"弹劾生风笔有神，天教末路得相亲。\n从来名下无虚士，今见朝端第一人。\n销印不知谁发难，投珠那得谓无因。\n何妨弭节潼江上，我亦归欤伴隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欧公诗有云俸优食饱力不用官閒日永睡莫兴因广之","author":"虞俦","text":"日长官事少，食饱俸钱优。\n宴坐香凝篆，欲眠书枕头。\n莫知斯我贵，此外更何求。\n毕竟归田是，他乡莫久留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祈晴","author":"虞俦","text":"何许龙蟠雨应求，参天老木古灵湫。\n投诚已自刲鹅颈，激怒宁烦掷虎头。\n南亩有人朝负耒，绝潢无客夜行舟。\n寄言神物须终惠，为挽天河使倒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦雨","author":"虞俦","text":"经时梅熟雨翻盆，老我无聊正杜门。\n日焙衣巾留白醭，年侵腰脚倦黄昏。\n扫除云雾风无力，点滴轩楹漏有痕。\n入市乘船虽未验，溪流已涨几番浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘劝农 其二","author":"虞俦","text":"风月联翩别驾分，双凫飞舄总能文。\n苔痕点绿山头石，花影浮红水面云。\n一舸鸱夷聊尔尔，千岩啼鸟自欣欣。\n徘徊斗粟归田缓，堪笑痴顽老使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述情","author":"虞俦","text":"间阔忻逢诸葛丰，不应阮籍哭途穷。\n拟留重客倾家酿，更喜贤郎有父风。\n诗思凭陵烟雨上，宦情抖擞簿书中。\n击鲜下舍聊乘兴，未许黄堂舍盖公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郁簿行年四十有九读李太白浔阳感秋诗慨怀有作次韵勉之","author":"虞俦","text":"清德如公畏四知，流光底事感圆蓍。\n日边丹凤聊栖棘，月下惊鸿尚拣枝。\n五十知非惭漏尽，百年彊半怪驹驰。\n买臣富贵犹堪待，莫诵浔阳落魄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中偶成呈天任","author":"虞俦","text":"久雨苦不乐，吾庐亦未贫。\n十旬兼美酝，千亩长脩筠。\n睡蝶频来梦，歌莺皆恼人。\n得君新唱和，懒病起精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青山买舟","author":"虞俦","text":"落日千乌外，青山一望中。\n买舟群仆喜，兀坐与谁同。\n旅店孤烟起，田家曲港通。\n鸥盟暂时乞，又踏软尘红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顷尝将漕淮东林子长今膺是选因以小诗述怀庶几古人赠言之意云 其二","author":"虞俦","text":"淮边陈迹试重论，走遍西途落木村。\n依旧江山连北固，承平池馆羡东园。\n中原入望堪垂涕，古汴无情尚有痕。\n岁漕东南六百万，云何异域得游魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顷尝将漕淮东林子长今膺是选因以小诗述怀庶几古人赠言之意云 其一","author":"虞俦","text":"德星天遣出淮濆，玉节光华委十分。\n可但筹边专馈饷，直须旷土尽耕耘。\n向来我已惭无效，此去君当勉策勋。\n尚有龟山风浪恶，得无遗恨雁离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾御带欲载糯米入城先以诗叙情因次韵只此便当执状也","author":"虞俦","text":"种秫诗人也未穷，百篇欲就醉颜红。\n却思白堕相逢晚，不分青铜一笑空。\n卧瓮更须防吏部，抱琴应不问新丰。\n何当乞与青田核，圣处时时任一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临安泛舟","author":"虞俦","text":"雨送行人上短篷，东君更借一帆风。\n桃源春水半篙稳，锦谷清溪几曲通。\n远岫天边凝晚碧，夕阳波面泛微红。\n舟行又胜山行好，两岸芳菲一顾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前诗谓思索诗句可以度日第恐终无益再赋一首以广之","author":"虞俦","text":"年来世味一毫轻，宿契诗书尚有情。\n魔事从教双眼赤，内观还觉寸心明。\n思量诗句嗟无补，检校医方恐未精。\n俗学可怜誇口耳，何如默坐息营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至天目登高岭","author":"虞俦","text":"天近初凝目，云横便蹑梯。\n前瞻千嶂列，回首一川低。\n雨过黄梅尽，风来翠剡齐。\n灵源穷不到，晴昼挂虹霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至富阳","author":"虞俦","text":"宦路初无定，吾行有底忙。\n江清鱼不聚，天远雁南翔。\n整棹须平进，回澜亦太狂。\n平生湖海意，何梦到凝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思归","author":"虞俦","text":"风雨连朝作伴牢，只堪痛饮读离骚。\n谁知老境侵腰脚，早是多情惜鬓毛。\n杖屦出门还有碍，簿书堆案敢辞劳。\n年来俯仰终无补，尚欠归田一著高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故安国夫人挽诗 其一","author":"虞俦","text":"雅趣工书画，高怀陋鼎钟。\n家声推两大，壸范见三从。\n贤得鲁侯配，荣开安国封。\n平生耽静胜，宸翰焕鸾龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故安国夫人挽诗 其二","author":"虞俦","text":"阀阅联蝉冕，台郎有凤毛。\n美形彤管旧，节视柏舟高。\n南涧夫人藻，西池阿母桃。\n哀荣生死是，诏墨看重褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故奚公学长挽诗","author":"虞俦","text":"诗酒平生兴，人琴毕竟空。\n儒冠成晚岁，尺牍到诸公。\n忽叹群无鹤，谁留目送鸿。\n竹林家世事，清节见君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春大阅呈郡僚","author":"虞俦","text":"青油谈笑坐生风，便觉湖山气象雄。\n霁色喜浮旌旆上，欢声争入鼓鼙中。\n中军合用诗书帅，上马空惭矍铄翁。\n横槊赋诗君等事，何妨寓目此时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春大阅望郡圃齐云楼悼亡","author":"虞俦","text":"官事谁能了，浮生迹易陈。\n齐云连绿荫，和泪送青春。\n缓带空凝月，凭栏不见人。\n只应曾到处，愁极倍精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日书怀","author":"虞俦","text":"吴兴太守也堪怜，十日斋厨九不烟。\n索漠清怀寒食夜，颠狂风雨落花天。\n流莺百啭还求友，化鹤重来不是仙。\n待得麦秋民足食，君恩万一许归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚汉老弟不来有怀南坡","author":"虞俦","text":"如麻密雨不收脚，妒花恶风常打头。\n那无一日好天气，只有千山供客愁。\n垂杨未系金袅娜，隔叶倦听黄栗留。\n南坡是处堪欣赏，把酒还曾酹我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴 其一","author":"虞俦","text":"万里阴云一战收，怪生和气袭兼裘。\n昆山龙过初衔烛，旸谷乌飞不傍舟。\n曝背爬搔疑挟纩，冻躯伛偻快伸钩。\n老农扶杖閒相过，一味丰年说不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨夜雨又作方此祈祷辄得数语述怀","author":"虞俦","text":"淫雨天公不肯晴，区区香火屡哀鸣。\n两年苦潦民何罪，千里分忧责匪轻。\n已幸早禾方露积，正怜秋稼与云平。\n蓱号莫败西成好，捩手从来易覆羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"是夜三鼓后睡起月色满庭","author":"虞俦","text":"幽人睡起已三更，始信今宵不浪晴。\n天宇元来如许净，月华别是一般明。\n风前雁断应无信，露下蛩吟岂不平。\n无赖姮娥肯留照，疾驱蟾魄度前荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋大阅呈郡僚","author":"虞俦","text":"横槊何人解赋诗，东方千骑出郊时。\n天高霁色旌旗上，地迥秋声鼓角悲。\n漫授一编黄石老，相从千载赤松期。\n据鞍矍铄非吾事，惭愧江湖把一麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀 其一","author":"虞俦","text":"登楼何处不陈诗，况是秋高木落时。\n极目但随归雁远，老怀犹作故乡悲。\n毋宁觞咏须前辈，有底功名亦后期。\n试问沈郎那得瘦，此心元不慕州麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀 其二","author":"虞俦","text":"结发从来数亦奇，人言猿臂不遭时。\n诗成杜曲何多兴，赋旧兰台只浪悲。\n松菊不关年少事，冰霜曾与岁寒期。\n君看昨日凉风起，瓜上青蝇岂待麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚矣菊犹未开小诗速之 其一","author":"虞俦","text":"问讯东篱菊，如今开未开。\n不应辜酒伴，宁是欠诗催。\n屈指秋将尽，关心日几回。\n霜风不相借，何意尚徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚矣菊犹未开小诗速之 其二","author":"虞俦","text":"酒为多多办，花须早早开。\n已愆重九约，犹待两番催。\n明日还何益，西风定肯回。\n游言空自解，蜂蝶笑徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋释奠于学万舍人示诗次韵以酬","author":"虞俦","text":"昔年泮水忽专城，文会何妨一再盟。\n已愧簿书成俗吏，却陈俎豆见诸生。\n一时同队鱼犹在，千载重来鹤更清。\n况有卞峰青眼旧，试登杰阁快双明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝市无糯旋挼青穗日熬以酿戏成","author":"虞俦","text":"种秫无多望岁穰，无功何日果还乡。\n尚无彭泽五十亩，安得谪仙三万场。\n挼穗昔闻今始见，拨醅未熟且先尝。\n今年太岁还非酉，惭愧邻家仅得浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴吴兴初入境","author":"虞俦","text":"诏书催发太频频，千骑东来喜望尘。\n不为寻芳宁较晚，固应入境便颁春。\n风和渐觉旌旗转，野旷遥闻钲鼓新。\n千里嗷嗷方待哺，自惭何以慰斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送万舍人将漕江东","author":"虞俦","text":"左螭玉立耸朝端，底事飘然便挂冠。\n简记起家千载遇，光华持节万人看。\n溪山好处宁终恋，鸥鹭盟前莫遽寒。\n已是诏书催上道，却烦尺鲤问平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓舍人将漕西淮用舍人坐上诗韵 其二","author":"虞俦","text":"醉里谁分主与宾，离觞到手莫辞频。\n感怀今日知何日，屈指三春破二春。\n北郭忍教风送客，江湖犹赖雨留人。\n晚晴依旧山光好，稳稳移舟傍玉津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓舍人将漕西淮用舍人坐上诗韵 其一","author":"虞俦","text":"西湖烟柳胜阳关，遮断淮南大小山。\n诗好固应倾座上，酒行犹喜到花间。\n君王纳谏宁容去，风雨愁予岂坐悭。\n未用疾驱催上道，锋车有诏径须还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱宰 其一","author":"虞俦","text":"畴昔鸣琴子贱堂，至今弦诵尚悠扬。\n农桑乐岁千家足，桃李春风几度芳。\n疾恶政缘同伯厚，爱民何止一桐乡。\n乌台此去真朝夕，剑履还须去尚方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汤倅二首 其二","author":"虞俦","text":"别乘词锋不费磨，江山得助想经过。\n离情柳色长亭暮，愁绪梅腮细雨多。\n渭北论文须细与，洛南问业念如何。\n有时尺素频相寄，莫负东来锦鲤波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汤倅二首 其一","author":"虞俦","text":"青衫试吏古桐川，识面池阳别驾贤。\n但喜论交时一笑，不知为客度三年。\n新来怀抱愁分袂，此去功名好著鞭。\n未必九华清绝地，更能留滞玉堂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别王诚之给事","author":"虞俦","text":"袅袅酸风吹客衣，冥冥芳树揽愁思。\n谁教宦路分南北，自是人生足别离。\n送岸飞花何太急，留人夜雨故来迟。\n眼前他日凫鸿堕，莫作情疏不寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张伯子尚书帅隆兴 其一","author":"虞俦","text":"舂容听履上星辰，玉笋班中第一人。\n暂藉威名分阃寄，剩留风采照廷绅。\n何人重记西山雨，老我空伤南浦春。\n此去莫贪为郡乐，紫枢黄阁待经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张伯子尚书帅隆兴 其二","author":"虞俦","text":"十年沉落困推挤，出处于公恨不齐。\n本谓重来酬契阔，岂期一见又分携。\n风吹渭水波声小，春压阳关柳色低。\n老矣销魂难语别，且须倒尽玉东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林子长赴姑孰泮宫","author":"虞俦","text":"绿波风驶引征帆，九万扶摇入羽翰。\n诗句最怜云不定，宦情况与月同寒。\n襟期莫作别时恶，出处须留晚岁看。\n漫道江东怀李白，清才应合在金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送颜尚书知泉州","author":"虞俦","text":"听履星辰最上头，一麾得请暂南州。\n高风凛凛推前辈，政路骎骎却倦游。\n地近枌榆同衣锦，天低雨露密承流。\n只今廊庙须公等，燕寝凝香莫久留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除日失步诗以自解","author":"虞俦","text":"双脚平生不踏空，谁教仰面看飞鸿。\n娱亲正要同莱子，烂醉何曾过阿戎。\n已分折腰营五斗，恐因折臂作三公。\n妻孥不用閒惆怅，得失从来塞上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除兵部侍郎赐带趁朝参","author":"虞俦","text":"幸叨持橐侍甘泉，敢意恩荣慰暮年。\n紫绶金章光照地，丝鞭玉勒喜朝天。\n儿曹莫起无鱼叹，人世难为跨鹤仙。\n报国无功还自愧，直须及早决归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜书怀","author":"虞俦","text":"吴楚乡风异，悲欢物态多。\n岁华惊晚暮，吾道恐蹉跎。\n莫唱黄鸡曲，宁为白石歌。\n明年六十一，不醉待如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食洞庭橘有感","author":"虞俦","text":"洞庭霜橘偶明珠，磊落堆盘照坐隅。\n九颂固应原取友，千头宁与李为奴。\n佳名自昔南邦贵，丹实由来北地无。\n此日满怀三叹息，茕然天地一身孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]