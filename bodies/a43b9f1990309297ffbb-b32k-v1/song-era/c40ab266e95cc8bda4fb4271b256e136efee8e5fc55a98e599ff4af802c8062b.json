[{"title":"得药谢竹溪一首","author":"刘克庄","text":"不觉昏眵过十旬，谒之先圣祷之神。\n室生虚白稀来客，驿致空青累故人。\n病尚研寻书外意，耄犹贪爱梦中身。\n从前计孛俱辞去，献岁明朝已发春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得閒","author":"刘克庄","text":"准敕放还山，祈閒果得閒。\n直令舂庑下，也胜乞墦间。\n子美虽存阙，渊明且闭关。\n遥怜早朝者，推枕恐催班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家讯一首","author":"刘克庄","text":"不觉离乡久，南来驿使疏。\n羁臣一掬泪，慈母两行书。\n租税闻输毕，田园说歉馀。\n何时真宦达，处处奉潘舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得曾景建书一首","author":"刘克庄","text":"闻君别后买倾城，酒戒中年亦放行。\n远使忽来知病起，近书全未说丹成。\n莫嫌身去依刘表，曾有人甘杀祢衡。\n何日断原荒涧畔，一间茅屋对寒檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翛然亭","author":"刘克庄","text":"每到阑干畔，徘徊暮始还。\n为怜临水寺，尽见隔城山。\n墙缭青苔里，舟藏绿树间。\n松扉宜步月，只是限重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼阿升","author":"刘克庄","text":"宝惜吾儿如拱璧，那知变灭只须臾。\n畏啼尚宿通宵火，涂囟犹残隔日朱。\n坐客相宽云梦幻，故人来吊讶清癯。\n荒山岁晚无行迹，心折原头树影孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼秦医","author":"刘克庄","text":"最晓阴阳證，于身独不灵。\n有妻持旧肆，无子学遗经。\n虫蚀抄方箧，莎生晒药庭。\n城中医绝少，堪惜尔彫零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜笋二首 其二","author":"刘克庄","text":"手移孤竹氏，遍地长孙枝。\n挺挺堪传嫡，疏疏欲咎谁。\n汝馋犹可忍，吾俗恐难医。\n虽有监临法，宽柔不忍施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜笋二首 其一","author":"刘克庄","text":"主人尤爱竹，老病鲜窥园。\n粟鼠竞携子，箨龙空长孙。\n化为玉版去，留得锦绷存。\n虽有监临者，贪眠昼闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"教授方君孺人刘氏哀诗二首 其二","author":"刘克庄","text":"伯姊真贤妇，闺门行可师。\n虽从合祔礼，似欠悼亡诗。\n壁已空遗挂，碑谁补色丝。\n嗟乎何及矣，托此识余悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"教授方君孺人刘氏哀诗二首 其一","author":"刘克庄","text":"古昔尊年德，今谁问孝廉。\n空烦推毂荐，不合相轮尖。\n郕叟行歌乐，台卿自志谦。\n嗟予老而秃，何以发幽潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚出","author":"刘克庄","text":"晚出别村干，夜深徒步归。\n饭犹悬早稼，衣尚在邻机。\n关塞秋防急，田园岁入微。\n喟然投耒叹，事事与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"刘克庄","text":"花事匆匆了，人家割麦初。\n雨多田有鹳，潮小市无鱼。\n秃笔回僧简，褒衣看古书。\n经年稀见客，磬折转生疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚悟","author":"刘克庄","text":"晚悟才为祟，深居学养生。\n乃知景升子，差胜少游兄。\n绝涧携瓶汲，空山抱耒耕。\n儿孙听苦语，世世勿谈兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚意","author":"刘克庄","text":"鸡报东方欲白时，林林群动起飞驰。\n匹居岘上入城少，颇怪淮南拔宅迟。\n惊饵何妨潜密藻，安巢谨勿托危枝。\n末年慕用寒山子，不是行家本色诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨起","author":"刘克庄","text":"鸡唱鸦啼搅晓眠，起煨田舍火炉边。\n天寒雪闭袁安户，岁恶江通鲁望田。\n已返山林全晚节，勿烦郡国礼高年。\n老臣久不陪朝谒，犹记称觞玉座前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹孟德","author":"刘克庄","text":"精舍观书二十年，偶窥沸鼎出馋涎。\n小豪已草黄巾檄，老大遭烧赤壁船。\n半夜宫嫔和泪诀，当时汉禅只心传。\n后来仍有朱三辈，欲比英雄恐未然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹路分赠诗次韵一首","author":"刘克庄","text":"古来诗律推曹氏，不数河梁与董逃。\n唐季三家松最胜，建安七子植尤高。\n短檠尚课儿精选，老笔真堪仆命骚。\n极欲留君横槊赋，舟人苦报粤江涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅州重建中和堂","author":"刘克庄","text":"中和堂昔隳于火，今剪荒榛再落成。\n博士尊师重演说，史君存古不更名。\n渐摩伋学三风熄，流布褒诗五瘴清。\n天子金声兼玉振，会徵褚大与儿生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"刘克庄","text":"木落山空独占春，十分清瘦转精神。\n雪疏雪密花添伴，溪浅溪深树写真。\n三弄笛声风过耳，一枝筇影月随身。\n吟罢欲断相逢处，恐是孤山隐逸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花一首","author":"刘克庄","text":"造化生尤物，居然冠众芳。\n东家傅粉白，西域返魂香。\n真可婿芍药，未妨妃海棠。\n平生恨欧九，极口说姚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅雨隳城自用前韵","author":"刘克庄","text":"叠石黏灰事尚新，忽因沾渍减嶙峋。\n晋阳昔仅存三板，瓠子今谁助束薪。\n恃陋窃忧难禦寇，加工却恐倍劳民。\n狂生亦岂前知者，曾是边城荷杵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦丰宅之二首 其二","author":"刘克庄","text":"斯人古少况于今，每恨诸贤识未深。\n朝给赙钱方掩骨，家无馀帛可为衾。\n向来夫子真知己，近世门生喜负心。\n惟有天涯华发掾，独挥衰涕望山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦丰宅之二首 其一","author":"刘克庄","text":"一别茫茫隔九京，梦中慷慨语如生。\n老犹奋笔排和议，病尚登陴募救兵。\n天夺伟人关气数，时无好汉共功名。\n残胡仍在王师老，宝剑虽埋愤未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦方孚若二首 其二","author":"刘克庄","text":"寤寐中原独著鞭，往来绝域几餐毡。\n封侯反出李蔡下，成佛却居灵运先。\n八百里烹飨军炙，九千缣辇作碑钱。\n祇今谁是田横客，回首荒丘一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦方孚若二首 其一","author":"刘克庄","text":"仙鬼微茫果是非，不如辽鹤有归期。\n铸成范蠡何嗟及，绣作平原未必知。\n歌扇舞裙风雨散，野田荒草古今悲。\n可怜一觉寒窗梦，犹记联鞍出塞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦回","author":"刘克庄","text":"跳出槐安有底忙，何须更待熟黄粱。\n牙签载返善和宅，手板抽回政事堂。\n效玉川生称锐汉，爱杨处士号憨郎。\n山中岂不差岑寂，犹胜人间臭腐肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦赏心亭","author":"刘克庄","text":"梦与诸贤会赏心，恍然佳日共登临。\n酒边多说乌衣事，曲里犹残玉树音。\n江水淮山明历历，孙陵晋庙冷沉沉。\n晓钟呼觉俱忘却，独记千门柳色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"检校樗庵花木二首 其二","author":"刘克庄","text":"林密山深客少过，暮年杖履此婆娑。\n桂开香□□□窟，桧长高于窣堵坡。\n不记玄晖红芍药，且栽□□□蓑荷。\n圣丘未必知为圃，何似姑师郭橐驼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"检校樗庵花木二首 其一","author":"刘克庄","text":"我与兹山殆有缘，手栽一一已参天。\n主林神黠□□佛，老树精乖意是仙。\n留客看花聊席地，课僮种树频浇泉。\n丹成未可匆匆吃，且向溪边住十年。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮捷一首","author":"刘克庄","text":"扫地南来蜂出窠，裔夷谋夏欲如何。\n传闻挞览毙一矢，惊走单于骑六骡。\n匹马只轮番部曲，寸天尺地汉山河。\n晋公幕府多名士，不欠寒儒作凯歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明","author":"刘克庄","text":"挟弹飞觥迹已陈，赏心事去负芳辰。\n数经风雨花尤厄，试说关山柳亦颦。\n人到苍皤方觉老，天无红绿不成春。\n近来未有池塘梦，谁道先生意尚新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清凉寺","author":"刘克庄","text":"塔庙当年甲一方，千层金碧万缁郎。\n开山佛已成胡鬼，住院僧犹说李王。\n遗像有尘龛坏壁，断碑无首立斜阳。\n惟应驻马坡头月，曾见金舆夜纳凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清惠庙","author":"刘克庄","text":"来访古祠宫，迢迢过水东。\n一条溪不断，数里竹方通。\n巫拜分馀胙，商行祷顺风。\n妆楼空百尺，半仆夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔村林太渊相访","author":"刘克庄","text":"不但亲传亦鲍参，妙年青乃过于蓝。\n一斑昔已窥而见，三顾吾何德以堪。\n之子凤兮真有种，汝曹犊耳可无惭。\n自嫌老病难留客，只伴樗翁数刻谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔梁","author":"刘克庄","text":"春泥滑滑雨丝丝，一路阴寒少霁时。\n水入陂渠喧似瀑，云从山崦上如炊。\n燎衣去傍田家火，炙烛来看野店诗。\n落尽梅花心事恶，独搔蓬鬓绕残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"猫捕燕","author":"刘克庄","text":"文采如彪胆智非，画堂巧伺燕雏微。\n梁空宾客来俱讶，巢破雌雄去不归。\n莺闭深笼防鸷性，蝶飞高树远危机。\n主人寘在花墩上，饱卧徐行自养威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理故书二首 其二","author":"刘克庄","text":"难窥一字脚，空皱两眉头。\n孤露无三乐，凄凉有四愁。\n诗疵撚须改，丹走出神求。\n元不离禅榻，当年遍九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理故书二首 其一","author":"刘克庄","text":"轴犹插高架，檠已弃低墙。\n可惜亡三箧，安能读一箱。\n自惭伯仁退，不及阿宜长。\n但忆初强记，谁知晚健忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盖竹庙","author":"刘克庄","text":"借榻丛祠日已曛，瓣香频此谒灵君。\n傥来梦事休重卜，向去诗材进几分。\n明主不消人谏猎，故山空使客移文。\n寄书报与荆妻说，十袭荷衣莫要焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盗发蔡端明墓一首和竹溪韵","author":"刘克庄","text":"忠惠松楸过者钦，谁知藏伏祸机深。\n英魂久向兹埋玉，佛面今为汝削金。\n下马三号空抆泪，磔蟆万段亦甘心。\n迩来野外无全冢，谩使闲人愤满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"第三龙湫","author":"刘克庄","text":"绝顶谒龙公，森寒石作宫。\n路盘青壁上，瀑泻白云中。\n僧说闻雷出，人疑与海通。\n几时阴晦夜，来此看拿空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绳技","author":"刘克庄","text":"公卿黠似双环女，权位危于百尺竿。\n身在半天贪进步，脚离实地骇傍观。\n愈悲登华高难下，载却寻橦险不安。\n谁与贵人铭座右，等闲记取退朝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绵亭林逸人扁所居室曰藏晖求诗","author":"刘克庄","text":"先生读易注参同，筑室云山第几重。\n昔遇壶丘疑见怪，今于老子信犹龙。\n方灵有物司丹灶，符验无妖血剑锋。\n只恐欲藏藏未得，世人往往或知踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翌日宫教惠诗次韵二首 其二","author":"刘克庄","text":"即令身在水云间，不著斯人玉笋班。\n子美步归犹恋阙，浩然肩耸径还山。\n人情薄似平原酒，世路危于滟滪滩。\n华栋把茅皆幻假，祝君黄发映朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翌日宫教惠诗次韵二首 其一","author":"刘克庄","text":"忘机沤鸟日相亲，鼻祖曾言畏四邻。\n幸有山林容此老，不将篱落寄他人。\n谁能交结今韩吕，犹记周旋昔郑陈。\n晞发中庭蹻足卧，绝胜雅拜望车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊","author":"刘克庄","text":"性迟故故待霜天，珠蕾金苞带露鲜。\n曾有餐之充雅操，又云饮者享高年。\n骚留楚客芳菲在，史视胡公粪土然。\n莫道先生真鼻塞，幽芗常在枕囊边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萤蚁","author":"刘克庄","text":"萤微化因草，蚁聚国于槐。\n缪析封侯爵，僭为思子台。\n九泉谋蛰处，十月有霜来。\n穹壤大如许，尔曹小矣哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野性","author":"刘克庄","text":"野性无羁束，人间毁誉轻。\n客言诗惹谤，妻谏酒伤生。\n窗纳邻峰碧，瓢分远涧清。\n近来尤少睡，打坐到钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野望","author":"刘克庄","text":"稍有西风起，孤筇挟自随。\n名山多著寺，古木必为祠。\n鸟过投林急，樵归度嶂迟。\n相寻惟有月，搔首待移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铭座一首","author":"刘克庄","text":"□□幸已逃忧责，铭座犹思儆耄荒。\n平日何曾欺闇室，暮年不会议明堂。\n重金身宠生无益，赐扇恩深死未忘。\n扈跸老臣开九帙，感今怀旧独凄凉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"刘克庄","text":"衰桐无叶报萧飕，卧听窗声作许愁。\n檠暗冷光侵砚几，瓦疏飞片落香篝。\n病思结客游梁苑，狂爱提军入蔡州。\n也欲访梅湖畔去，黄尘满袖欲盟鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪观顾夫人哀诗二首 其二","author":"刘克庄","text":"吾母尤高洁，夫人亦步趋。\n书窗共残烛，禅几对团蒲。\n不愧顾家妇，能存赵氏孤。\n郎君奉鸾诰，聊足报亲劬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪观顾夫人哀诗二首 其一","author":"刘克庄","text":"贞烈过男子，当于简册求。\n剪鬟众宾款，断臂六臣羞。\n防墓铭旌远，泷冈宰树秋。\n可怜彤管废，史笔未曾收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪峰寺","author":"刘克庄","text":"七里深林集暮鸦，插空金碧被林遮。\n华堂何止容千衲，菜地犹堪置万家。\n虎去有灵知伏弩，僧来叙旧约分茶。\n世人要识峰头冷，六月重绵坐结跏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄天谷赠诗次韵二首 其二","author":"刘克庄","text":"世无仙则已，有必属斯人。\n丹熟将分友，云游每念亲。\n小窗时读易，静室夜修真。\n符篆皆馀事，题诗亦出尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄天谷赠诗次韵二首 其一","author":"刘克庄","text":"浪迹遍齐州，曾从剑侠游。\n尚嫌秦政臭，肯要郅支头。\n客礼朝三殿，儿嬉弄五侯。\n吾犹看不破，何况道家流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄宽夫示诗不已自和前二首答之 其二","author":"刘克庄","text":"精思巧斲诗家事，缪敬阳尊市道交。\n杜说新诗犹费改，韩评推字不如敲。\n衣传曾饮先师乳，弦绝今无异域胶。\n欲引蔺卿怀内璧，吾贫未免以砖抛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄宽夫示诗不已自和前二首答之 其一","author":"刘克庄","text":"冥搜藻思殊精鍊，细读蓬心稍豁开。\n我窃高年惭绿竹，君持半偈试黄梅。\n肯为唐季小家数，须做僧中大辨材。\n吸尽鱼龙虾蟹子，不妨一蹴至如来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄檗山","author":"刘克庄","text":"出县半程遥，松间认粉标。\n峰排神女峡，寺创德宗朝。\n鹳老巢高木，僧寒晒堕樵。\n早知人世淡，来住退居寮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄檗寺一首","author":"刘克庄","text":"犹记垂髫到此山，重游客鬓已彫残。\n寺经水后增轮奂，僧比年时减钵单。\n绝壑云兴潭影黑，疏林霜下叶声乾。\n平生酷嗜朱翁字，细看荒碑倚石栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"傅谏议和予所赠傅监仓诗复用前韵一首","author":"刘克庄","text":"谏草如山不论兵，当年出处最分明。\n中朝安可无耆旧，故事犹应问老更。\n敢与凤毛评句法，素知牛耳执文盟。\n诗坛亦合先生筑，遥望偏师已拔营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜大渊至二首 其二","author":"刘克庄","text":"敕尾词头老不任，偶逢寸暇惜如金。\n进赓圣制董弦曲，退伴君联石鼎吟。\n晓漏闻钟犹共话，雪泥蹑屐每相寻。\n而今不辨人颜色，坐久琅琅认语音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜大渊至二首 其一","author":"刘克庄","text":"乾鹊查查得许忙，弓寮越境访溪堂。\n故交有约过安道，季世无人吊卜商。\n聊为先儒增管见，不烦太乙下藜光。\n要知韩孟新吟否，此则赓酬第一章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜六二弟生子","author":"刘克庄","text":"邵子生男四十五，弟今方邵过三年。\n莫随夷甫举遗逸，且教伯温成大贤。\n洛下耆英为汝喜，河南闻见待渠传。\n会当杨柳芙蓉下，快与翁抄击壤编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜仲晦除江西宪二首 其二","author":"刘克庄","text":"厌闻桑孔工掊克，少见龚黄出拊循。\n官吏但知行白简，壮丁多去入红巾。\n昔阳和少千村瘴，今福星来一路春。\n闻说崆峒方麦熟，幕中有作凯歌人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]