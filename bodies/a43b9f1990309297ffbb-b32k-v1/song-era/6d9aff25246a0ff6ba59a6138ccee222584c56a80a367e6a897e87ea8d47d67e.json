[{"title":"次韵马参议同游蒋山","author":"叶梦得","text":"华屋惊随劫火飞，江山空自绕邦圻。\n灵踪可便超千载，妙解谁从寄一微。\n著屐尚堪穷碧落，据床聊伴俯清辉。\n追寻会识关心处，未怪衰翁苦忆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵","author":"叶梦得","text":"颓垣败屋落花飞，草草春光亦故圻。\n但爱野塘输渌净，不知风景转清微。\n帐空尚忆猿惊晓，基废犹传凤览辉。\n女几自无平贼意，坐来休笑久忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三次韵","author":"叶梦得","text":"荒林寂寂鸟飞飞，旧事那容数一圻。\n山色自怜云泱莽，暮寒犹作雨霏微。\n谈馀故喜珠仍在，境胜端知玉有辉。\n问取塔中黄面老，此生何处是真归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四次韵","author":"叶梦得","text":"雨厌残云暝不飞，乱红犹欲点春圻。\n蒋陵路绝人谁到，萧寺庭荒迹已微。\n偃蹇松篁空自老，参差观阁旧相辉。\n令威等是千年客，想有辽东独鹤归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶至刘少师园二首 其一","author":"叶梦得","text":"叶底黄鹂一再鸣，故知久住识人情。\n习家池馆元无禁，应笑山公自懒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶至刘少师园二首 其二","author":"叶梦得","text":"老木参天拱十围，何妨桃李间相依。\n却怜韩令功如许，不为山丹少霁威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡子因相过留踰月","author":"叶梦得","text":"解作江山一月留，仲文儒雅更风流。\n欲知爵跃心能喜，正爱蝉连语不休。\n筑室君方论并舍，归山我已办扁舟。\n交亲四海今馀几，万事伤心付白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵再答子因","author":"叶梦得","text":"人事纷纷去不留，客心空感大江流。\n已拚瓠落真何用，那得钟鸣尚不休。\n邻里朱陈无别社，江山李郭有同舟。\n若为便觅苕溪路，六月明珠剥芡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡子因前韵留别再答二首 其一","author":"叶梦得","text":"早时物望冠陈留，晚悟禅心更不流。\n安用前身真阮籍，久知此道得孙休。\n千年会有归来鹤，万事元同不系舟。\n邂逅一庵随地有，不妨衲被对蒙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡子因前韵留别再答二首 其二","author":"叶梦得","text":"已议营屯列上留，稍欣群盗障横流。\n三时旧业终应在，万里长征亦少休。\n和策但令均挟纩，壮图何用辄焚舟。\n东都自是兴王地，虎踞宁须问石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘太保招抚淮北刘马军屡奏捷","author":"叶梦得","text":"先声已起故将军，卧治何劳病使君。\n冠带岂能忘旧俗，山河自亦恶妖氛。\n羽书奏捷无留敌，舆地论封有策勋。\n横槊赋诗非我事，车书会复见斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题子因双鸠百叶桃画","author":"叶梦得","text":"百叶缃桃照眼明，繁枝似见雨新晴。\n故知睡足聊相并，不作林间逐妇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐惇立罢吏部郎官出守天台待次卞山旧居因寄","author":"叶梦得","text":"嵇康不作绝交书，出处萧然两裕如。\n锦帐不妨游省户，草堂还得赋郊居。\n倾崖溅水青云上，夹道轻阴落絮馀。\n亦记旧游聊待我，未须催驾赤城车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈子高移官浙东戏寄","author":"叶梦得","text":"幕府陈琳老，官身恋故溪。\n解谈孙破虏，那厌庾征西。\n未拟烦刀笔，聊应谢鼓鼙。\n登临如得句，小字与亲题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏示幕客","author":"叶梦得","text":"不用黄金更筑台，一时倾盖尽奇材。\n关中岂是穰侯物，浪怕诸侯客子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章几道将归小饮怀谢城父","author":"叶梦得","text":"中年甚畏别交亲，况复云山旧结邻。\n涧谷何时同笑语，干戈已老更风尘。\n少留对榻聊分坐，多病持杯漫几巡。\n贾傅长沙知健否，洞庭波浪渺无津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻边报示诸将","author":"叶梦得","text":"插羽惊传赤白囊，胡行如鬼尚跳梁。\n颇闻庙算无遗策，但遣封人谨豫防。\n送死定知天悔祸，追奔宁使汝争彊。\n将军剩有封侯印，尽扫无令一镞亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虏酋复过河王师出讨","author":"叶梦得","text":"羽檄初徵天下兵，误惭一阵守王城。\n秦兵出项终何得，汉将征辽会扫平。\n便遣幽燕驱号令，久怜河洛污膻腥。\n书生岂解论几事，讵信平凉有劫盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣晁公昂按行濒江营垒","author":"叶梦得","text":"他日传烽望夕烟，重来老更负戎旃。\n我言固自平平耳，王事那辞数数然。\n转饷未应劳木马，摧锋犹或要戈船。\n天威本自无多杀，万一征和属此年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻兀朮将过淮再遣晁公昂觇师","author":"叶梦得","text":"狂酋屡惯骋长驱，未省新军有被庐。\n快饮勿辞金凿落，先声须破铁浮图。\n䞤官尔自疲千里，飞将吾宁较一夫。\n试向八公山上望，当关何用守濡须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登南城","author":"叶梦得","text":"大江南渡是长干，北望清淮岁已寒。\n废垒至今闻鹤唳，苍山从古自龙蟠。\n鬓毛白尽空看镜，髀肉销来尚据鞍。\n折箠不能笞黠虏，遗民犹有汉衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与陈子高夜话","author":"叶梦得","text":"鼓角开东道，山川壮别京。\n病慵怜窃食，幽愤敢论兵。\n废简铅黄暗，驰囊赤白惊。\n褒衣聊自喜，时见鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送马参议观国从辟刘太保","author":"叶梦得","text":"伏波老自厌壶头，壮志诸孙凛未休。\n稍喜烽烟从绝塞，即闻貔虎静中州。\n先声早已传推毂，婉画聊烦佐运筹。\n好去刘公书一纸，无忘老子上南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵马参议留别","author":"叶梦得","text":"戎车百两去难攀，秣马前驱矢石间。\n析木旧津吞朔易，神都新令愯完颜。\n传声已报连三捷，触热那辞冒百艰。\n束缚会看擒颉利，灰钉何待执戎蛮。\n清谈一笑时能共，妙语千篇未可删。\n缓带且从黄阁老，峨冠行奉紫宸班。\n分携坐叹虚悬榻，老病怀归祇故山。\n他日小舟能过我，万峰深处有柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄潭州谢城父","author":"叶梦得","text":"南国波涛已过春，稍清群盗剪荆榛。\n孰知贾傅倾多士，但说番君得远民。\n痛饮千钟应可强，传书一纸未能频。\n台评袖里犹多在，莫枉汀洲咏白蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久不饮酒厨人献白醪却之","author":"叶梦得","text":"老大无堪百不能，年来但可饮三升。\n斋厨何用须佳酿，莫遣征南误见称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋二首 其一","author":"叶梦得","text":"江上西风万里秋，际空高浪汹回流。\n他时誉贼真非策，此日摧锋盍有谋。\n天险漫能凭故国，陆沉端复恨神州。\n将军竞绾封侯印，谁为吾君更解忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋二首 其二","author":"叶梦得","text":"萧关陇水隔天区，壮士何人是破奴。\n一日顿传三节度，十年空斗五单于。\n坐谈激烈心犹在，疲俗彫残喘未苏。\n安得仓箱盈百万，少令天下足军储。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋高申戒诸屯示幕府","author":"叶梦得","text":"草枯马健已高秋，堂上应须早伐谋。\n传箭犹闻聚蜂蚁，控弦那得犯貔貅。\n书生会击单于颈，壮士谁舂长狄喉。\n快使营平归印绶，貂蝉敢望出兜鍪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄顺昌刘节使","author":"叶梦得","text":"四海胡尘久未清，遥闻苦战有奇兵。\n妖氛尽扫人谁敌，捷奏初传我亦惊。\n授钺已欣传帝泽，挥戈终见静王城。\n轩台固有英灵在，更遣将军得令名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月六日虏兵犯历阳方出师客自吴江来有寄声道湖山之适趣其归者慨然写怀","author":"叶梦得","text":"松江浪静如镜平，菰蒲长春秋水生。\n晴沙回雁久未到，坐想白鸥增眼明。\n五年辜负钓船约，故人疑我真逃盟。\n岂知尘缨不易濯，正想沧浪之水清。\n朝来铁马暗江北，中流叠鼓云涛倾。\n楼船十万下采石，旗纛灭没天戈横。\n书生事业今乃尔，授钺孰敢辞专征。\n岂无传檄走飞骑，漫复长啸登高城。\n文思天子民父母，大度未忍鏖奇兵。\n澶渊一矢安五世，明日傥或传诸营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮西军大破贼兵连六告捷喜成口号二首 其一","author":"叶梦得","text":"一战聊麾十万师，西来捷报走黄旗。\n六骡壮骑终须去，九虎将军亦谩为。\n面内疲民元不改，从中胜算自无遗。\n临轩想见天颜喜，百辟欢声动玉墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮西军大破贼兵连六告捷喜成口号二首 其二","author":"叶梦得","text":"蛇豕何知阚近坰，且欣鏖战扫膻腥。\n寄声急走破羌帖，归路还经征虏亭。\n多难兵间头更白，放怀物外眼终青。\n花残不负岩边约，更看前焚老上庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为山亭后有小池丛石间得石螭因以斛汲水导注之","author":"叶梦得","text":"微流自作小潺湲，底处奔崖落迸泉。\n骤喜忽闻飞雨过，却疑惊起老龙眠。\n凭轩但遣时醒耳，裂岸何须去拍天。\n索寞归心谁与寄，家山不到已三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为山亭移植冬青等近遂成阴","author":"叶梦得","text":"一寸苍根手自锄，年来绕屋亦扶疏。\n客来但爱清阴好，不见幽人涧下居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小饮示幕府","author":"叶梦得","text":"边书日夜急，王旅方徂征。\n我非刘越石，长啸徒登城。\n缅想豺与虎，行当筑鲵鲸。\n传车日边来，风雷走天声。\n黄旗三面至，捷奏纷纷横。\n天险限南北，长江正东倾。\n诸君亦良苦，唾口争请缨。\n谁云凌烟阁，自昔无书生。\n卮酒安足辞，勉当建雄名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐惇济书报尝过余石林","author":"叶梦得","text":"绕涧新添数百竿，故人书为报平安。\n似闻谡谡山风响，正想阴阴夏簟寒。\n老大不能穷蠹简，归来便拟挂尘冠。\n一杯且觅林间约，莫枉山王废旧欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜听莫抚干弹琴流水操","author":"叶梦得","text":"故山不在眼，远想流水声。\n佳人南风手，起我涧谷情。\n十载厌鼙鼓，嚣尘乱鸣钲。\n萧然洗病耳，为鼓一再行。\n度险微断续，奔前忽琮琤。\n凄风拉远响，薄月当微明。\n乱石拱高下，回环亦峥嵘。\n吾归正自尔，猛士方西征。\n年少勇过我，犬羊膻王城。\n请更平戎操，尽扫洛河清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沈传曜","author":"叶梦得","text":"卞峰摩青空，东望乌氐墩。\n岂忘宿舂粮，终愧一款门。\n邂逅此相过，倾怀得徐论。\n人言解牛刀，要使治剧烦。\n未悟清庙器，朱弦列罍尊。\n我衰百虑息，但念三亩园。\n王师肃西征，万马先云屯。\n何力偿赐履，缅惭羡归轩。\n寄声舴艋舟，想见浮雁村。\n清冷尚可钓，无使霅水浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月二十日","author":"叶梦得","text":"渐觉凉风入，轩窗自亦幽。\n漫能持麈尾，终忆钓槎头。\n故我从添老，愁予不为秋。\n新醅知熟未，衰谢若为酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书为山亭五首 其一","author":"叶梦得","text":"为山亭下小巑岏，只欠萧萧竹数竿。\n但遣飞流时漱玉，且将归思为翁宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书为山亭五首 其二","author":"叶梦得","text":"微风似与洗庭除，石枕蛮藤不负予。\n八尺方床聊已足，可须仍要读残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书为山亭五首 其三","author":"叶梦得","text":"僚吏相哀白事稀，抱琴时自弄清徽。\n何妨共倒樽中渌，不怕鸣驺问道归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书为山亭五首 其四","author":"叶梦得","text":"膻秽初闻颍水清，东君更复过蒙城。\n应须鄂渚兵同入，贼垒聊烦尽刬平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶书为山亭五首 其五","author":"叶梦得","text":"使节交驰数路分，颇知旰食念前军。\n疾须图上金城策，一见真堪胜百闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程伯禹赠宗室赵朝请","author":"叶梦得","text":"人物相望不并时，使君水鉴有真知。\n未论理窟倾三语，只斗诗坛自一奇。\n扰扰干戈犹战伐，纷纷簿领更喧卑。\n应须便作高轩过，好德何人佐我仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程伯禹用时字韵见寄二首 其一","author":"叶梦得","text":"衰病侵寻岂故时，暮年怀抱祇公知。\n彊论出处初无意，底有文章更好奇。\n王气山川元自壮，归心茅竹敢嫌卑。\n中原趣下王正历，尽使遗民复汉仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程伯禹用时字韵见寄二首 其二","author":"叶梦得","text":"汉道中兴此一时，虞亡不腊尔何知。\n地中鸣角无多怪，堂上论兵固有奇。\n梦栎那求梁栋远，抢榆正羡羽翰卑。\n淮阳汲直犹高卧，愿看箫韶集凤仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送表弟晁公耄沿海师幕","author":"叶梦得","text":"岩邑相望数寄声，十年湖海最关情。\n谈锋尚忆倾甥舅，鬓雪何堪数弟兄。\n饱读父书聊自足，深知民事却须评。\n扬旗且逐楼船下，万里波涛本不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题晁公耄惠崇溪山","author":"叶梦得","text":"荒林翳宿莽，脱木寒无烟。\n不知三间茅，中有几醉眠。\n山远尚见雪，江空欲吞天。\n归舟定何许，沧波方渺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋","author":"叶梦得","text":"惠崇残笔老尤奇，袖里溪山每自随。\n欲识沧波无限意，此间惟许当家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观化堂编校旧书 其一","author":"叶梦得","text":"赫日真能永，微风亦自凉。\n故应便北户，何敢厌东墙。\n汲水聊为戏，翻书却未忙。\n平生閒与懒，并觉味兼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观化堂编校旧书 其二","author":"叶梦得","text":"翰墨他生业，山林晚岁心。\n那知身已老，但觉意增深。\n捉麈谁能话，扶筇可细寻。\n晚来庭鹊喜，似恐有归音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆朱氏西涧 其一","author":"叶梦得","text":"涧下流泉涧上松，清阴尽处有层峰。\n应知六月冰壶外，未许人间得暂逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆朱氏西涧 其二","author":"叶梦得","text":"忆向中流置竹床，万钱无处买清凉。\n只今路断无来客，自拨新篘醉几场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后为山亭独卧","author":"叶梦得","text":"过雨虚檐气稍清，卧闻刁斗起连营。\n几看薄月当轩过，惊见阴虫绕砌鸣。\n汹汹南江浮静夜，寥寥北斗挂高城。\n白头心事今如许，惭愧儿童话请缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"叶梦得","text":"七夕仍残暑，三年记此宵。\n傍檐依岭月，攲枕听江潮。\n瓠大何妨拙，槎回未觉遥。\n何须论乞巧，河汉望星桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王升归知果州","author":"叶梦得","text":"何处西南是果州，黄柑殊胜木奴洲。\n使君自喜乡闾近，骚客仍怜井邑幽。\n盗贼燕秦犹未息，山川楚越已先秋。\n原头兵马今多少，更与将军论木牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈雨 其一","author":"叶梦得","text":"老农酣歌望扪腹，旱魃何为敢予毒。\n九渊再拜款神龙，仰空但见屯云簇。\n天公爱民亦自惜，我愧无功神弗福。\n愿看一洗注天瓢，未须震暴如车轴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈雨 其二","author":"叶梦得","text":"今年淮西蹙胡骑，王师尽扫无馀类。\n武王伐纣报丰年，今者骄阳岂天意。\n东求三茅西采石，塔中至人肯徒视。\n明朝掣电骇翻盆，妇子犹能饱遗滞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再任后遣模归按视石林四首 其一","author":"叶梦得","text":"岩石三年别，君恩未许归。\n从谁寻草径，为我款荆扉。\n旧绕山千叠，新添竹一围。\n故人如见问，端欲挂朝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再任后遣模归按视石林四首 其二","author":"叶梦得","text":"白发萱堂上，孩儿更共怀。\n弄孙那得见，将母竟难谐。\n已绝功名望，犹疑出处乖。\n此心终未稳，何处复安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再任后遣模归按视石林四首 其三","author":"叶梦得","text":"插架环千轴，传家有旧书。\n展舒惭几案，凉曝阙庭除。\n破屋防悬溜，残编足蠹鱼。\n好须重检校，扃锁莫令疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再任后遣模归按视石林四首 其四","author":"叶梦得","text":"细路穿南岭，新松几许长。\n毋庸驰马足，祇拟转羊肠。\n便作高亭好，初非乱石妨。\n两溪浑在眼，似欲见帆樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]