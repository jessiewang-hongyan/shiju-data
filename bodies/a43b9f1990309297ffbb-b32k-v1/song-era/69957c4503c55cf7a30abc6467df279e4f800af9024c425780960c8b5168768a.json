[{"title":"湘西暮归","author":"释德洪","text":"笋舆鼓角背层城，湘水涸尽行沙汀。\n岳麓雪云献楼阁，橘洲烟雨学丹青。\n此生多艰付跛挈，投老馀闲到寂惺。\n苍鬣万身门窈窕，归来风叶扫空庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效李白湘中体","author":"释德洪","text":"夕光江摇鱼尾红，何处扁舟开晚篷。\n雁字初成春有信，烟鬟空好雨无踪。\n荒寒数苇橘洲岸，领略半窗湘寺钟。\n浦口行人已争渡，林下归僧欣一逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王舍人兰室","author":"释德洪","text":"起爇清香试返魂，松花闲泛刷丝纹。\n幽斋事业谁同办，小斛兰丛手自分。\n家世到今犹玉食，交朋强半在青云。\n笑谈麈尾延僧宿，要听清言洗俗氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵熏堂","author":"释德洪","text":"无言桃李已垂阴，小雨南风自满襟。\n佳客偶来持茗盌，宝书看罢整瑶琴。\n未容丝竹陶闲适，尽把云山付醉吟。\n图画麒麟他日事，不将行乐负初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵寄傲轩","author":"释德洪","text":"道夫飞鸟倦知还，一钵安巢又故山。\n无累自然增逸兴，有名终恐废长闲。\n背时生计风烟上，随意园林指顾间。\n应笑市朝争夺者，暗惊清镜失朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吏隐堂二首 其一","author":"释德洪","text":"拄笏西山爽气新，万人如海一闲身。\n堂中自蜡登山屐，门外从增没马尘。\n美禄方辞缘肆志，华轩偶羡见清真。\n遗编半掩思标致，未必今人愧古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吏隐堂二首 其二","author":"释德洪","text":"此堂华构面层城，意趣追回万古情。\n落帽被嘲真有道，买金偿谤亦求名。\n黄庭卷掩凝香缕，画戟门深列卫兵。\n安用山林笑朝市，戏将轩冕寄馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵集虚堂","author":"释德洪","text":"从来鲍靓有仙风，脑满方知气自冲。\n万事收藏微笑里，十虚俱集一尘中。\n乾城不碍丹青色，天女何殊大小空。\n满地落花春寂寂，岸巾时倚曲栏东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宿东安","author":"释德洪","text":"淡云缺月两微茫，独酌沽来竹叶香。\n已把功名比鸡肋，更惊世路似羊肠。\n心情老去俱消尽，诗律年来觉倍强。\n解诵东坡北归曲，此身安处是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宿黄沙","author":"释德洪","text":"无计遮拦岁月飞，岁除江寺老垂垂。\n自围红火堆危坐，熟读黄沙感叹诗。\n已笑因山论肥瘠，更惊逢水说分离。\n重湖去国三千里，想见残缸梦断时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵双秀堂","author":"释德洪","text":"窗户青红花木繁，午阴脩径接深关。\n人如巢许逃名迹，山学娥英露髻鬟。\n采菊悠然常独见，望云时复对僧闲。\n夜闻松雨惊飞瀑，疑宿匡庐黄石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵垂金馆","author":"释德洪","text":"风檐负日背胡床，千颗初惊昨夜霜。\n噀雾香争和露擘，过墙枝作照林光。\n佳名曾用题书尾，小字仍呼背药囊。\n先与儿曹为美兆，读书窗映笏头黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赠庆代禅师","author":"释德洪","text":"莲峰千叶吐晴烟，玉颊遥知一粲然。\n梅坞雪消香错莫，庵僧老尽气完全。\n暗惊梦蝶人间世，回看醯鸡瓮里天。\n谁见清言横麈尾，满庭风露竹娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宿清修寺","author":"释德洪","text":"湘山也学庐山好，落瀑声飞绣谷风。\n正欲来归向儿说，戏将收拾入诗中。\n浪惊醉枕寒松响，春满茶铛活火红。\n清景骨飞嗟未到，故应唯许梦魂通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵自清修过大沩乱山间作","author":"释德洪","text":"行尽湘南尽处山，爱公高韵不容攀。\n会当拭目瞻双阙，应笑寻幽到百蛮。\n甚欲解鞍休荦确，更能揎手弄潺颜。\n定知醉看千岩晓，大字题名石壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郴江有作","author":"释德洪","text":"持节南来喜欲狂，弄舟时得棹清湘。\n然膏独宿牵牛洞，枕玉曾眠锦瑟傍。\n未可便寻闲作伴，不须先以醉为乡。\n金城驰至陈方略，要指先锋一破羌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题罢徭亭","author":"释德洪","text":"闻君新构罢徭亭，邂逅河源又报清。\n郡郭不输天子赋，溪山偏协野人情。\n唐虞暇日饶耕凿，秦汉当年浪战争。\n风月倚栏如可借，待携斗酒话升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题西林廓然亭","author":"释德洪","text":"堂堂叶脱露遥天，自炷临轩一穗烟。\n贵客独游聊尔耳，道人相见亦欣然。\n是身已悟浮沤久，万象中观宝镜圆。\n寄语横机莫相试，刻舟甘作小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题方广灵源洞","author":"释德洪","text":"万峰剔卓起孤峰，惭愧灵源与世通。\n花异空怀上林苑，梦清疑宿广寒宫。\n泄云吐雨遮金地，溅雪跳珠落石□。\n忙里为君成妙语，丰碑正欲就崖砻。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题高台","author":"释德洪","text":"午梵知藏释梵宫，危台遥喜石桥通。\n下无俗驾攀缘至，中有高人笑语同。\n解执易为摩诘语，经行难续德云风。\n千岩万壑吹松雨，替说侬家胜义空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题上封","author":"释德洪","text":"天柱唯连紫盖峰，路危不与众峰通。\n瓢沽狭径疑相值，芋火何人想此风。\n借榻醉魂窥冻蚁，凭栏诗眼送飞鸿。\n空嗟千偈出山去，半摺遗编看未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵邵陵道中书怀","author":"释德洪","text":"邵陵山水丽风光，游遍归来夜话长。\n秋翠等闲开雉堞，惊湍哀怨韵笙簧。\n随鞍此景凭诗写，他日尘纷一笑忘。\n上阁与谁同小立，坠金拄笏说三湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵雨中书怀","author":"释德洪","text":"剩雨残晴暴所长，客窗花气噀馀香。\n每怀追逐云泉惯，无计遮拦岁月忙。\n谁谓伐冰连戚里，年来尽室泛沅湘。\n诏书行看椎门至，已觉眉间一点黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题化鹤轩","author":"释德洪","text":"当年举网得双舄，想见胎仙风度幽。\n朱顶顾吾今未识，长身意子是其流。\n山家趣味无人共，王事经过作意游。\n千里帝城何日去，不妨佳处且迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题澹山岩","author":"释德洪","text":"华屋张灯展画屏，当年纤手指岩扃。\n宦游那料重湖隔，醉里空惊叠嶂青。\n绣口词章人复见，笔华声价梦通灵。\n诗成独立西风晚，满眼归心插羽翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵游浯溪","author":"释德洪","text":"浯溪山水今无恙，浪士曾为烂熳游。\n大字中兴馀断碣，小舟空此醉垂钩。\n词源不减无双誉，人品当时第一流。\n地坐摩挲增叹息，高标想见尚横秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题南明山凌云阁","author":"释德洪","text":"独上凌云百尺楼，栏干一曲一迟留。\n丁丁樵斧空山里，泛泛渔舟古渡头。\n蔽日绿阴鸣好鸟，际天芳草牧青牛。\n回头城市分尘土，堪笑王孙取次游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵言怀","author":"释德洪","text":"此身已觉此生浮，去作云山老比丘。\n古寺闲门人莫问，寒绡蒙首涕慵收。\n道林风月心能了，子美工夫志未酬。\n为问太原王处士，一瓯春露可同不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宿圣溪庄","author":"释德洪","text":"家声十辈拥朱轮，更畜青牛解斗奔。\n应念高楼闲舞袖，故凭山月洗吟魂。\n助舂泉落量云谷，输税人归吠甑村。\n被冷夜晴成好梦，马随香雾入修门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵拉空印游芙蓉","author":"释德洪","text":"翰墨平生气吐霓，诗成先喜示筠溪。\n山中见客应偏好，笔力知公不肯低。\n夜寂据梧饥鼠出，岩空同听怪禽啼。\n上方闻说非人世，更陟缘云第几梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵纵目亭","author":"释德洪","text":"高情与客凭栏处，便觉身藏语笑中。\n已许此生当乐死，不辞老去坐诗穷。\n遥知兵卫戎衣盛，只欠花轮小袖红。\n绝境天藏今日献，千峰登睫岂人工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵游鹿头山","author":"释德洪","text":"吐词秀似出盆丝，好古幽情八咏思。\n论字来寻鲁公碣，因诗曾访少陵祠。\n留题楚俗争传去，懒赋山灵必有词。\n定价文章比珠玉，此篇不独慰吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题清风亭","author":"释德洪","text":"特筑飞台丈室傍，便惊形胜发天藏。\n登临时作一声啸，已觉翛然两袖凉。\n待月拭除昏雾色，看云入得野花香。\n君看抖擞铃幡意，欲替禅翁为举扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵法林禅寺","author":"释德洪","text":"闻道高人愿力深，幽居端与法为林。\n风泉松雨随宜说，密室晴轩共一音。\n意妙故应人不荐，地偏还喜我相寻。\n夜阑更入诗三昧，消尽平生未死心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵凭栏有作","author":"释德洪","text":"金殿谁焚南海香，霭然芬馥扑回廊。\n数枝银烛高低照，两个清萤上下光。\n风度素秋惊宿鸟，水舂碧涧濯游舫。\n栏干独倚无人问，细细孤吟月满堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵渡江有作","author":"释德洪","text":"弃舟植杖首重回，隔岸遥闻津鼓催。\n淮上梅传春信至，江南山逐笑声来。\n行瞻瑞雾笼双阙，更看神光发五台。\n王事幸陪方外乐，为君点笔走风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题善化陈令兰室","author":"释德洪","text":"种性难教草掩藏，苍然小室为谁芳。\n槲培几案轩窗碧，坐款宾朋笑语香。\n糁地露英犹洁白，快人风度更纤长。\n议郎嗜好清无滓，独有幽兰可比方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"快亭","author":"释德洪","text":"太丘作邑付弦歌，剩得清闲可奈何。\n满地棠阴惊昼永，小亭诗眼觉天多。\n佳眠夏簟便光滑，醉耳松风喜再过。\n想见句成书棐几，侍儿浓笑出微涡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郤子中学句游岳山携怪石归","author":"释德洪","text":"衡岳乘春著意游，诗词不独锦囊收。\n又携峰顶云房石，归致闲斋夏簟秋。\n尘下笑谈且同梦，胸中泾渭自分流。\n忽惊几案寒层出，卧看令人忆故丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周达道运句题怪石韵","author":"释德洪","text":"爱山心志如君少，王事何妨陟翠微。\n怪石方欣典刑在，新诗仍写画图归。\n客来一室烟光满，掌上千岩眼力稀。\n颇怪周郎赏音者，独于此境尚弹机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵见寄喜雨","author":"释德洪","text":"议郎诗胆久崔嵬，敏句无烦急雨催。\n玉局波澜嗟已绝，少陵风力赖追回。\n荡晴香雾吹红藕，迥地花茵叠紫苔。\n静极凉生闻剥啄，渡湘知有道人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题方圆庵","author":"释德洪","text":"比物曾闻知姓名，树间斛悬林百升。\n此庵外圆似盂覆，其地中方如镜平。\n善不近名真有道，高非绝俗更幽情。\n会当目击维摩老，端作毗耶问法行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠许彦周宣教游岳彦周参机道者","author":"释德洪","text":"一幅纱巾九节筇，翛然生计似庞公。\n孤云野鹤登空去，万壑千岩堕笑中。\n岣嵝晴披应独往，懒瓒醉卧与谁同。\n遥知勘破痴禅老，想见临机面发红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵游南岳","author":"释德洪","text":"天迥游丝百尺轻，水寒时觉縠纹生。\n琢磨佳句输吾弟，文点春眠付老兄。\n山寺独来无一事，竹轩相对有馀清。\n永怀东院成千古，寂子难忘叔侄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵彦周见寄二首 其一","author":"释德洪","text":"诗先春色附湘船，来与幽人结净缘。\n句好空惊碧云合，韵高疑在白鸥前。\n君应归诵陶彭泽，我亦南寻率子廉。\n想见江头同握手，采茶时节雨馀天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵彦周见寄二首 其二","author":"释德洪","text":"归思啼禽日夜催，宝书临罢意徘徊。\n榆钱满地买春去，岳色渡江排闼来。\n行乐风光清梦晓，卧披烟雨曲屏开。\n兴来敏速诗千首，落笔人惊挟怒雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彦周借书","author":"释德洪","text":"湘上清山爽气浮，开轩相对亦风流。\n但工酣寝成疏懒，甚拙谋生太谬悠。\n数笔江村供晚望，一蓑烟雨助诗愁。\n借书知子能医国，有志常先天下忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彦周法地弟作出家庵又自为铭作此寄之","author":"释德洪","text":"迂阔庵成又自誇，要令妙语发天葩。\n未容临济终仆地，正赖云门已出家。\n少日浪曾参泐水，暮年端合在丹霞。\n赠君革屣游山去，勘破诸方一笑哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月大雨江涨晚晴作三首 其一","author":"释德洪","text":"春寒作意搅吟魂，欲出云涛已溅门。\n入画潇湘连雉堞，落梅烟雨暗江村。\n依蒲觅句壮心在，附火抄书老眼昏。\n一掬幽怀收拾得，谩题窗纸与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月大雨江涨晚晴作三首 其二","author":"释德洪","text":"我在湘西画牒中，时高时作送飞鸿。\n事治山翠经旬雨，印可春晴尽日风。\n引步幽探聊自适，满怀疏快与谁同。\n东君倾写无馀蕴，都放山茶称意红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月大雨江涨晚晴作三首 其三","author":"释德洪","text":"投老归来楚水滨，水清聊可濯衣尘。\n拚心乐事都还汝，入手清闲不与人。\n尚有笑谈消白昼，更无情绪管青春。\n暗惊少日王城外，走马争先看宝津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈大夫见和春日三首用韵酬之 其一","author":"释德洪","text":"咏君好句欲消魂，想见朱轓画戟门。\n解组正当强健日，载书归老水云村。\n虚堂风撼牙签响，密室岚蒸画牒昏。\n偶在湘山最佳处，旧游闲与野僧论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈大夫见和春日三首用韵酬之 其二","author":"释德洪","text":"无复搜诗惨淡中，便能落笔敏惊鸿。\n高情不在两疏后，句法追回二谢风。\n倾盖未论桑梓旧，忘年先喜唱酬同。\n朱颜长觉清光溢，不学东坡是醉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈大夫见和春日三首用韵酬之 其三","author":"释德洪","text":"诗轴来寻寂寞滨，把看字字蜕埃尘。\n江南家世休相问，陈氏文章不乏人。\n岳色渡江长自好，桃花满县不胜春。\n克家有子如麟凤，骨相吾惊是要津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过沩山陪空印禅师夜话","author":"释德洪","text":"浓翠湿衣三十里，渡溪知背几重云。\n忽惊宝构从空堕，便觉风光与世分。\n夜久天香凝错莫，庭闲花雨自缤纷。\n他生曾伴安禅地，此夕楼钟复共闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空印以新茶见饷","author":"释德洪","text":"喊山鹿蓛社前摘，出焙新香麦粒光。\n撼树师应怀大仰，传瓯我欲学南阳。\n要看雪乳急停筅，旋碾玉尘深住汤。\n今日城中虽独试，明年林下定分尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空印见招住庵时未能往作此寄之","author":"释德洪","text":"独立天衣四世孙，作家手段典刑存。\n大沩路峻诸方让，空印风高四海闻。\n有愿欲依龙象众，无求羞逐鹜鸡群。\n此生一聚灰中骨，终葬千峰顶上云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空印见和用韵答之","author":"释德洪","text":"棋布诸方尽子孙，道缘浑似雪峰存。\n全提盖色骑声句，直要临机以眼闻。\n围绕千僧名冠世，指挥万象语惊群。\n独能收此无家客，分占沩源一坞云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙兴禅师大阳的孙居枯木堂新植楚竹余爱其家风为赋之","author":"释德洪","text":"门外追奔没马尘，堂中安顿自由身。\n脩筠有泪知谁恨，枯木开花为我春。\n隔岸云山犹可借，满怀风月未全贫。\n小诗勿笑清如画，聊为高人戏写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题德明都护熏堂","author":"释德洪","text":"占丛浓碧绕虚堂，堂上仙郎戏比芳。\n香并蕙兰终漏泄，色同草木浪遮藏。\n过墙山泼轩窗翠，吹鬓风生燕寝凉。\n敏豆才高家法在，要看落笔拥红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题季长冰壶轩","author":"释德洪","text":"闲轩清似冰壶水，轩上人如元紫芝。\n坐觉秋光漱毛发，客来春色满谈词。\n宝书读罢依蒲久，玉麈经行曳履迟。\n卷挂一声林叶动，黄昏月出雪消时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明应仲出季长近诗二首次韵寄之 其一","author":"释德洪","text":"露叶朝阳沃枣桑，暑风吹鬓荡莲香。\n已欣点水蜻蜓款，更觉营巢燕子忙。\n翠浪舞翻争涨垄，黄云割尽想登场。\n小楼楯瓦谁庭院，弱柳多情故掩藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明应仲出季长近诗二首次韵寄之 其二","author":"释德洪","text":"偶寻邻叟问桑麻，踏尽山矾糁径花。\n传得新辞春烂熳，更惊行草醉攲斜。\n遥知小县少公事，想见高情照物华。\n尚念无家甘露灭，一蓑烟雨似玄沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]