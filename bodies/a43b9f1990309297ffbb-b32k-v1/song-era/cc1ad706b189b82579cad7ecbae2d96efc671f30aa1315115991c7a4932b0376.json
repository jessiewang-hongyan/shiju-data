e":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题程氏菊庄 其五 涪翁","author":"马廷鸾","text":"瓮里醯鸡千岁灭，天边苍狗万重云。\n长生阅世凭何术，欲制颓龄藉此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题程氏菊庄 其二 陶令","author":"马廷鸾","text":"一觞浥露餐英美，八表同昏履运艰。\n芳节不随篱下老，悠悠嘉气眼中山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅岩","author":"马廷鸾","text":"卓哉青壁插晴空，古貌棱棱列士风。\n人物山川相与重，是间知有植鳍翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢龙山惠柱杖并求石铫四首 其四","author":"马廷鸾","text":"砖炉石铫竹方床，何必银瓶为泻汤。\n苦茗只堪浇菜肚，春风却负太官羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢龙山惠柱杖并求石铫四首 其三","author":"马廷鸾","text":"捷径新来竞朵颐，登山有道只逶迟。\n瘦藤独立西风上，看尽坡头万马驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢龙山惠柱杖并求石铫四首 其二","author":"马廷鸾","text":"读书未把壮心降，瀹雪烹云听煮汤。\n浇我胸中过秦论，笑渠臧谷两忘羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢龙山惠柱杖并求石铫四首 其一","author":"马廷鸾","text":"山窗闲笏倦支颐，出户犹嗟拟步迟。\n万事一条横楖栗，缘坡穿径走如驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢洁斋惠炉瓶 其二","author":"马廷鸾","text":"宴坐浑如槁木枝，垆烟瓶蕊小窗宜。\n书慵捲起閒今古，回向心源不动时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢洁斋惠炉瓶 其一","author":"马廷鸾","text":"午梦惊残拨白灰，满盘云篆拂轻煤。\n金猊对舞轮囷吐，曾挹天香鼻观来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感二李","author":"马廷鸾","text":"渡海归来一炷香，八斋早欲卧僧房。\n平泉免向崖州死，博得生前万口羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感时寄钟信甫","author":"马廷鸾","text":"子陵滩下立多时，鸥鹭悠悠自识机。\n春事都来无半月，一声鶗鴂劝人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬县教徐志友","author":"马廷鸾","text":"二十五宗诗有派，九成宫帖字名家。\n何须奠去无人识，政自吟来与舅誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦鸡","author":"马廷鸾","text":"照水栖山自一奇，绛冠雪羽岂人牺。\n明明在上今□望，是汝箪瓢捽茹时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题老学道院 其一","author":"马廷鸾","text":"天典民彝圣得知，斯文千岁以为期。\n试看涑水三雍赞，何必兰陵赋诡诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张氏勤有堂","author":"马廷鸾","text":"世间义理尽无涯，桃李春风总一家。\n最恨一般浮浅学，卖花担上漫看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨妃唾壶图","author":"马廷鸾","text":"三郎好女思倾国，一霎沉酣四海奔。\n汉业巍巍英主事，内庭供奉孔家孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题芳洲诗集 其二","author":"马廷鸾","text":"虎踞已知王气尽，鹃啼谁感帝魂哀。\n怪渠册后诗情苦，曾到留都丰镐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题芳洲诗集 其一","author":"马廷鸾","text":"采采芹甘不自谋，慇勤直欲奉王羞。\n可怜斜日三千字，曾献当年十二旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林彦潜诗编","author":"马廷鸾","text":"快读诗人七钜编，前身端合是逋仙。\n村翁溪老开吟社，愧我犹撑上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵君画竹","author":"马廷鸾","text":"霜竿操尚特幽奇，直节端如正士姿。\n高拂九霄无曲处，古来惟有老天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠刊字汤生德清","author":"马廷鸾","text":"岐阳雨渍镌功石，浯水苔昏颂德碑。\n渺渺昊天须有定，烦君椎凿待明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠地理李生","author":"马廷鸾","text":"昆崙宇宙一株石，拄地撑天日夜浮。\n万古青山青未了，西风斜日黯凝眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张君 其二","author":"马廷鸾","text":"人生识字忧患始，底用区区更出奇。\n我欲扫空閒笔墨，只凭老腕把锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张君 其一","author":"马廷鸾","text":"世间草隶是云礽，汲冢深埋唤不应。\n五百年间徐骑省，一千年后李阳冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士二首 其二","author":"马廷鸾","text":"处仲恰如王眼目，了翁旧识蔡精神。\n尽教识尽公卿相，不愿公卿属个人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士二首 其一","author":"马廷鸾","text":"人物渺然吁可叹，凭谁指出植鳍翁。\n勤伊急向傅岩看，当在君王梦寐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相者非常眼","author":"马廷鸾","text":"已分山林著此臞，一科端不补遗馀。\n朝来忽遇非常眼，废却窗前半日书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]