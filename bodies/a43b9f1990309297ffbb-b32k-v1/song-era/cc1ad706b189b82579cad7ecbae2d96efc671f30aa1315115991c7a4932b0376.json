[{"title":"减字木兰花","author":"马光祖","text":"多情多爱。\n还了平生花柳债。\n好个檀郎。\n室女为妻也不妨。\n杰才高作。\n聊赠青蚨三百索。\n烛影摇红。\n记取媒人是马公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题武夷","author":"马合麻","text":"石鼓溪边渡，门前一叶舟。\n雨滋千壑翠，风动万岩秋。\n仙去云常在，山空水自流。\n九天烦紫诏，借我此中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游金庭观","author":"马并","text":"右军学业隐林丘，世隔年馀景尚幽。\n苔锁一泓残墨沼，云遮三级旧书楼。\n欣逢羽客开金阙，快睹仙童侍玉旒。\n自怪今朝脱凡骨，飞身得向洞天游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月十九夜纪梦","author":"马廷鸾","text":"堪嗟劫运永嘉末，忽梦清风乾道初。\n二十年间閒处士，可能身世得同渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月十二夜梦南冠旧友感泣有赋","author":"马廷鸾","text":"麦秀渐渐禾黍新，清宵梦断泣遗民。\n只怜肝脑输宗社，不负当年第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十日 其一","author":"马廷鸾","text":"太乙宫前戎马乡，思成门外野蒿场。\n山中一瓣心香在，独遣孤臣病著床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十日 其二","author":"马廷鸾","text":"强提簪笏睇觚棱，再拜焚蕤泪雨零。\n千古陈桥仁圣事，不堪重勘旧编青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中梅花 其二","author":"马廷鸾","text":"霜崖雪壁花千树，玉骨冰魂月一痕。\n芳洁不为尘土涴，琼英跕跕堕云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中梅花 其一","author":"马廷鸾","text":"欲为山严作好歌，旧时挟册向山阿。\n我无缝雾裁云句，奈此层梯苏磴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方氏临清堂二首 其二","author":"马廷鸾","text":"陶翁归计已成迟，未折腰前好赋诗。\n到底尚称千载士，高人拈向此中题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方氏临清堂二首 其一","author":"马廷鸾","text":"割取风烟归此堂，尘缨更好濯沧浪。\n青山屋上下流水，永日翻书乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四友相陪亭","author":"马廷鸾","text":"谁伴幽人饱岁寒，霜葩雪干翠琅玕。\n眼前交道如渠少，好作长年耐久看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用清秋鹤发翁韵赋小书招洁堂 其五","author":"马廷鸾","text":"庭草无言绿，林花取意红。\n因之酌茅柴，招唤西邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初冬宿直玉堂凄风小雨次日即承先帝晏驾之变距今二十年矣大忌前一日孤臣独眠山庵景象正似当年挑灯危坐闻田家鼓笛之声凄其有感二首 其二","author":"马廷鸾","text":"云黯天低结暝阴，孤灯对影夜沉沉。\n可怜一曲村田乐，犹是尧民击壤音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲子初冬宿直玉堂凄风小雨次日即承先帝晏驾之变距今二十年矣大忌前一日孤臣独眠山庵景象正似当年挑灯危坐闻田家鼓笛之声凄其有感二首 其一","author":"马廷鸾","text":"无限都人哭鼎龙，年多泽久似仁宗。\n愁来一样黄昏雨，天上人间自不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示程介夫 其二","author":"马廷鸾","text":"羊肠路险百千转，云梦胸吞八九宽。\n豆饭芋羹才足欲，水边林下即心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示程介夫 其一","author":"马廷鸾","text":"流年何必共君参，九琐青山老一庵。\n试检乐天诗集看，明年半百又加三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仰和皇太子殿下明禋庆成诗韵 其一","author":"马廷鸾","text":"圣主精禋格，明廷对月深。\n元良赞宸极，盛德享天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仰和皇太子殿下明禋庆成诗韵 其三","author":"马廷鸾","text":"鸣銮回紫禁，步玉捧宸旒。\n肆眚遵虞典，欢传十二州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仰和皇太子殿下明禋庆成诗韵 其二","author":"马廷鸾","text":"夕宿犹疏雨，昕朝睹大明。\n重光符景贶，熙事庆升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊柴道士","author":"马廷鸾","text":"老子犹龙不可亲，庄周与蝶孰为真。\n补还石鼎吟边句，飞作临皋梦里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪梦","author":"马廷鸾","text":"白日青天一钜儒，清宵入梦忽蘧蘧。\n觉来猛省戊申疏，曾说中原乱易除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"求菖蒲于李叔翔","author":"马廷鸾","text":"风饕雪虐岁峥嵘，寸草寒窗独宁馨。\n长恐出山泉水浊，尘埃到汝失青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎新仓守曾悦心道间偶赋","author":"马廷鸾","text":"黄旂红帜走踆踆，晓出闉阇奔迓新。\n车盖如云骑如水，山头牛背有閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近闻在旧京卖缦笠子","author":"马廷鸾","text":"蚤岁葫芦依画本，暮年台笠养閒身。\n如