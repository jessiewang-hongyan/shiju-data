[{"title":"燕居十六首 其八","author":"彭龟年","text":"竞索驾高车，吾宁守户枢。\n安能念荣悴，且欲辨贤愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其七","author":"彭龟年","text":"事事皆由命，穷通各有时。\n穷通吾顺处，虽命亦何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其六","author":"彭龟年","text":"好语噤难出，卑词强应酬。\n只云逃口祸，却恐遂成偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其五","author":"彭龟年","text":"迂辔不难为，长愁与我违。\n忍贫胜忍辱，免被好人嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其四","author":"彭龟年","text":"荆棘不须栽，须容驷马来。\n面前如路窄，何地不蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其三","author":"彭龟年","text":"酒尽或容求，恩伤不可收。\n伟哉王相国，沈默孰与侔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其二","author":"彭龟年","text":"多贪缘纵欲，多欲必伤生。\n来日应难料，空留不善名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕居十六首 其一","author":"彭龟年","text":"事以义为本，尤须礼作舆。\n有时当致曲，切勿背吾初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代张京尹贺皇太子生辰三首 其三","author":"彭龟年","text":"青禁罗鸡戟，朱明出虎闱。\n布宣当浩穰，简乐著精微。\n有志窥成画，无材守一圻。\n徒能歌圣子，重润更重晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代张京尹贺皇太子生辰三首 其二","author":"彭龟年","text":"神光开甲观，寰海作重阳。\n世尽占人瑞，天应发子祥。\n山河涵玉露，象纬泻银潢。\n有道如三代，宁须不老方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代张京尹贺皇太子生辰三首 其一","author":"彭龟年","text":"问寝随天子，论经有帝孙。\n千年几神圣，四世一乾坤。\n盛德从心远，灵源自古存。\n欲知天意近，九月似春温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元戊午临江劝驾多士凡由进士科进者皆预焉且沿乡人饮酒之意叙坐以齿酒半使君又出杰句宠其行某陈人也偶睹盛事思有以记之敬嗣严韵二首极愧不工尚几镌削 其一","author":"彭龟年","text":"太守兴贤隘九州，劝为之驾盛炎刘。\n方今神圣四门辟，即日英雄一网收。\n在藻久观鳣发发，食苹又听鹿呦呦。\n来年候对春风仗，企首同趋晓月浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆元戊午临江劝驾多士凡由进士科进者皆预焉且沿乡人饮酒之意叙坐以齿酒半使君又出杰句宠其行某陈人也偶睹盛事思有以记之敬嗣严韵二首极愧不工尚几镌削 其二","author":"彭龟年","text":"党里情疏孰继周，义年仅署竹冠刘。\n燕毛不见三王盛，古意惊从一日收。\n已许陈人观易易，再赓宵雅咏呦呦。\n试将旅语从头记，七字应无一字浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵教授兄友惠柑","author":"彭龟年","text":"泮宫老潘贤且仁，分义浓如手足亲。\n悬知故人在千里，健步远来缄墨新。\n黄柑霜后愈精好，香味宛如包贡珍。\n分赏且用涤烦渴，不救莱芜炊甑尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别袁州司户司马行二首 其二","author":"彭龟年","text":"一见已草草，那堪更别离。\n事当防快意，学亦进潜思。\n此道今谁语，如公岂我私。\n何时一窗下，重与论心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别袁州司户司马行二首 其一","author":"彭龟年","text":"四海司马氏，大州从事贤。\n剸裁无剧务，抑郁已三年。\n人在甘棠里，梦回春草边。\n知音有当路，何日践英躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李东老韵","author":"彭龟年","text":"胸中尘虑厌多多，强把诗书细刮摩。\n幸有长官怜拜起，苦无公事碍吟哦。\n自惭俗驾争相逐，不识高轩肯见过。\n天阔雁寒人又远，一杯相属意如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和临江丙午鹿鸣宴诗韵","author":"彭龟年","text":"暖日轻霜作小春，冥冥鸿雁正来宾。\n异时大比兴贤礼，今日元侯劝驾身。\n西汉循良知贾谊，菑川父老送平津。\n眼中俱是青云客，著我空惭迹已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和临江庚子鹿鸣宴诗韵","author":"彭龟年","text":"风流蕴藉足仪型，小屈旌旗镇列城。\n笔下雄深过班马，胸中洒落似张程。\n载赓宵雅推多士，宁许皇荂继大声。\n闻说河南诗有序，从今亦有口传名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和袁州张守鹿鸣宴韵","author":"彭龟年","text":"太守兴贤极选抡，奏书飞上帝王阍。\n几年雾隐南山豹，今日风抟北海鲲。\n得士不孤天子诏，赠行仍有古人言。\n向来劝驾应无此，且喜成周礼乐存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉和御赐进士诗","author":"彭龟年","text":"昭回云汉揭天章，忽到人间足宠光。\n必有飏言兴率作，不须击筑叹飞扬。\n湛恩汪濊倾多士，密意绸缪际万方。\n何幸小臣陪俊造，一如丰草在成康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送牛守赴藤州二首 其二","author":"彭龟年","text":"半世几契阔，今年又别离。\n我应嗟去远，人已恨来迟。\n宿草青无限，野花红欲窥。\n藩车行有诏，山路且逶迤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送牛守赴藤州二首 其一","author":"彭龟年","text":"五马南中去，脩途一月宽。\n暮年忧国切，今日爱民难。\n志大人无小，政平人自安。\n端能扫蛮瘴，莫作偶然看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁宪易节漕蜀二首 其二","author":"彭龟年","text":"峡口大江急，剑门天下奇。\n不因逢使节，安得入公诗。\n万里轻来去，一心无险夷。\n可怜门下士，犹惜别离私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁宪易节漕蜀二首 其一","author":"彭龟年","text":"雨露收江上，星辰下益州。\n有贤容在外，为国岂无谋。\n德旨频将远，君心顿减忧。\n不然那有此，定自启金瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九","author":"彭龟年","text":"露下风高足感伤，天君著意写重阳。\n建安能赋推诸子，楚国悲秋又九章。\n我为催租阁诗思，谁能送酒沃愁肠。\n黄花不解知人意，开遍篱根数百行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽尤尚书二首 其二","author":"彭龟年","text":"天子青宫友，清时法从贤。\n典型诸老旧，人物中兴前。\n锁闼堆黄纸，金华叠细旃。\n夺公何太速，谁与问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽尤尚书二首 其一","author":"彭龟年","text":"太史病已革，君王意尚疑。\n欲为宣室召，深动画堂思。\n共起云亡叹，空嗟大用迟。\n九原如可作，愿赋百身诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽无为军王守","author":"彭龟年","text":"再分符竹向淮濆，只得除书下帝阍。\n不见使车随邸吏，忽传鸣马蹙都门。\n丰碑未尽平生恨，哀些谁招天末魂。\n木落山空风猎猎，不堪俛首奠黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱彦博二首 其二","author":"彭龟年","text":"对语窗飞雪，横舟月在滩。\n西湖今会少，里社此盟寒。\n诸子齿犹稚，慈堂寝未安。\n俱成无尽恨，一见一辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱彦博二首 其一","author":"彭龟年","text":"重惜夫君去，哀吟思不穷。\n江淮经画里，风雨笑谈中。\n志大长违俗，才高无近功。\n盖棺公论出，谁不羡豪雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽余丞相四首 其四","author":"彭龟年","text":"畴昔危疑日，尝为根本谋。\n不缘公一语，谁识我深忧。\n分阃因重见，忘言只对愁。\n无穷千古意，有泪付东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽余丞相四首 其三","author":"彭龟年","text":"三绝今非少，元功人未知。\n岂云公有憾，时恐世传疑。\n谁解吟成史，宁忧罪到诗。\n诗成终自愧，空恨一年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽余丞相四首 其二","author":"彭龟年","text":"慨惜三朝老，忠勤一代师。\n冕裳亲奉日，鼎鼐手调时。\n揖逊承三节，安危系一辞。\n世平今似水，却叹哲人萎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽余丞相四首 其一","author":"彭龟年","text":"忆昨随南史，常窥侍帝垣。\n负墙须密命，垂涕进忠言。\n恳恳精诚到，巍巍庙社尊。\n至今天下诵，功业在调元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽杨邦宁","author":"彭龟年","text":"心事谁能识，交游得细论。\n有居多水竹，此世老丘园。\n遗恨成千古，无人作九原。\n晚来风政恶，不忍赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽沈漕宜之父主管","author":"彭龟年","text":"蝉蜕轩裳早，冰融义理深。\n但知捐世累，谁复识公心。\n宇宙终埋玉，哀荣有赐金。\n遥怜九原上，烟雨暗寒林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈迪功","author":"彭龟年","text":"一念超然与世违，新蔬剪雨自甘肥。\n只因堕雁能忘味，不使惊鸥尚见机。\n有子明经那不寿，如公积善未应非。\n从教天定知何似，果见贤孙擢第归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽欧阳幼立","author":"彭龟年","text":"行辈多名宦，乡闾爱老成。\n身名了无恨，韦布却为荣。\n久矣追谈笑，居然隔死生。\n朔风搜宇宙，何日闭佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽益阳县丞赵参议","author":"彭龟年","text":"一种银潢秀，清名仰太虚。\n甲科尝擢第，午夜尚观书。\n已觉身非我，那堪丞负余。\n斯人无复见，掩涕一欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽傅德芳主簿","author":"彭龟年","text":"亭亭梁木遽然倾，吾里诸生失典型。\n已向东维次箕宿，定知南斗厌文星。\n书盈故箧墨犹湿，影挂虚堂灯自青。\n忍听咿呜哀挽罢，一川东去杳冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽虞夫人","author":"彭龟年","text":"欲说夫人事，谁能与世论。\n诸郎名节立，千古妇言尊。\n共此伤心日，怀哉锡类恩。\n佳城何处是，烟雨政黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽熊仲贤监酒二首 其二","author":"彭龟年","text":"举世嗟浮薄，谁堪寄死生。\n空馀交友恨，不见急难情。\n我昔为游子，公方作远征。\n那知成永诀，洒泪闭佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽熊仲贤监酒二首 其一","author":"彭龟年","text":"叹息熊公子，胸中亦自奇。\n典衣缘客至，沽酒趁花期。\n满眼皆知己，平生却数奇。\n一官终未试，回首不堪思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄黄商伯兼简詹元善","author":"彭龟年","text":"今日蛮荒好，逢人说桂林。\n祇应一片雪，端在两公心。\n祈望罗明月，生黎斸水沈。\n滔滔迷所往，莫望指南针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鄂渚和章同年元荣邓教授友龙微字韵 其一","author":"彭龟年","text":"愚鲁何妨与俗违，夷途方始识心归。\n源源自是渊泉出，杲杲宁关庭燎辉。\n莫向天涯寻墨客，须知海内有公非。\n一杯何得如前日，竹杖芒鞋语翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鄂渚和章同年元荣邓教授友龙微字韵 其二","author":"彭龟年","text":"世情如水与天违，谁识春从岳麓归。\n衮衮源流知有自，纷纷华鄂看相辉。\n今人得似古时少，我拙从教俗子非。\n且倒一樽寻乐事，奇章台上晚风微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日分韵得去字","author":"彭龟年","text":"昔从招提游，岸柳擘新絮。\n那知再到时，叶落满庭署。\n争如青青松，寒暑了不与。\n古干屈龙蛇，依然旧游处。\n触物转多时，何以消百虑。\n陶潜早解此，撒手赋归去。\n纷纷世俗流，何用苦欢饫。\n试问皎然师，茶香得谁助。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其十","author":"彭龟年","text":"德意遍岩谷，纯心对云天。\n办此一爇香，从公作丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其九","author":"彭龟年","text":"天时不可齐，天心不可违。\n君子能知天，手转丰凶机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其八","author":"彭龟年","text":"羸然一老翁，一病一伤和。\n寒暑不可测，奈此根本何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其七","author":"彭龟年","text":"饥民日嗷嗷，汹汹溃堤水。\n痛决未可知，无易此一蚁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其四","author":"彭龟年","text":"文移急征输，追逮及圭撮。\n安得语里胥，反手逐旱魃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上帅漕闵雨十首 其二","author":"彭龟年","text":"九雨当一晴，燥湿未应革。\n那知平畴间，已作龟兆坼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"土缶","author":"彭龟年","text":"土缶寡讥诮，白璧多瑕疵。\n毁誉未必公，名起谤亦随。\n天下有真是，不在爱恶时。\n青青荆棘场，拍拍蝴蝶飞。\n不如岁且寒，更试松柏姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘宗元索余赋愚谷古人以愚自命及命人者多矣余不暇辨姑以二绝言愚之理云 其一","author":"彭龟年","text":"以愚名谷意何如，肯以愚溪认作吾。\n天地中间有真我，萧然陋巷不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同陈秘监诸丈送黄商伯守常州石叔访守上饶会于艮山门张园以人生五马贵莫受二毛侵分韵得贵字","author":"彭龟年","text":"惠山滋华池，玉山润百卉。\n二贤竞出守，山水亦自慰。\n人生别离难，朋旧走相谓。\n尅期会南湖，肯托简书畏。\n敬酌万石君，欲叹不敢忾。\n愿如玉山高，物物饱生气。\n又酌双井公，一举大白既。\n愿如惠山清，滴滴濯腑胃。\n择侯须择贤，无乃拔其汇。\n帝城人欲入，竞进去乃贵。\n谁无蝼蚁心，早去亦有味。\n朝家急贤秋，人物欠经纬。\n想当分符时，欲遣意犹未。\n幸无疾其驱，有诏傥可暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别刘寺簿子澄赴岳州倅","author":"彭龟年","text":"新蝉鸣高柳，轻鸥弄晴川。\n浮家作远游，触热岂所便。\n武昌古都会，形胜两国肩。\n貔貅杂民居，烽火照敌边。\n朝廷重牧守，尤需治中贤。\n君侯文章家，班马不敢先。\n墨庄一种子，落实今几年。\n瞠乎出其后，独得道学传。\n诚身自孝悌，玩理潜天渊。\n悠然静中春，汹汹风涛前。\n四海满誉望，诸公争挽牵。\n容台志不舒，别驾用未专。\n去就抑何心，行可吾亦然。\n余也沟渎质，误辱青黄妍。\n工夫恳切切，习气犹拘挛。\n居然作别离，欲别思绵绵。\n归鸿几时来，江树底晚烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别孙隐甫","author":"彭龟年","text":"君家金石台，我家富寿冈。\n十驲苦不远，半世成相望。\n我为一贫驱，触热来帝乡。\n尘垢面未颒，郁结志不强。\n下马忽见君，喜剧几欲狂。\n未语心已倾，既坐形俱忘。\n醒我醉梦中，祓我冰雪旁。\n主人知客深，对著夜雨床。\n犹恐客意短，渠渠罗酒浆。\n蟹螯擘新肥，荔子含生香。\n晚归候月影，早游趁湖光。\n都城六月中，公卿簿书忙。\n而我乃与君，专此风露凉。\n笑语虽杂乱，理到味自长。\n平生区区愿，恰此一月偿。\n遽然委我去，令人热中肠。\n儿女惜别离，丈夫重行藏。\n敢因杯酒行，感慨徒悲伤。\n君去起我思，綵衣拜重阳。\n愿言各努力，白发行中堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别张袁州五首 其五","author":"彭龟年","text":"平生学不力，莫移资禀偏。\n疏愚寡周防，戆直绌巧谝。\n出身仕官府，何幸依仁贤。\n朴樕本无庸，刻画几成妍。\n江湖政浩荡，云汉难攀缘。\n何以慰我思，一语当韦弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别张袁州五首 其四","author":"彭龟年","text":"弦急无和声，行疾多窘步。\n从容应万变，乃有天下度。\n先生经纶才，所至祛百蠹。\n一州直易耳，治者弗敢措。\n弱翁霁威严，犹被功名误。\n孰知观过仁，一蹴超圣处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别张袁州五首 其三","author":"彭龟年","text":"袁人思君侯，事事皆甘棠。\n君侯亦念之，疾苦如己伤。\n向来趣引输，诏许仍旧章。\n抗疏论不足，古人所未尝。\n此请久不下，公归奏明光。\n渠侬未知公，尸祝无相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别张袁州五首 其二","author":"彭龟年","text":"富贵不可求，名节可不修。\n韩公三上书，所愿略不酬。\n柳子百世文，莫洗一日羞。\n要须外无累，乃免罟获忧。\n青青最高松，藤萝所绸缪。\n繁阴岂足羡，试看风露秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别张袁州五首 其一","author":"彭龟年","text":"爱民有诚心，发用非己私。\n齐王累己见，乃以小大移。\n冠履自贵贱，痛痒一体随。\n万事有定理，应之当坦夷。\n傥以我好恶，定非真是非。\n光风霁月中，宁许栽藩篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别周侍郎五首 其五","author":"彭龟年","text":"创平痛方定，醉甚忽解酲。\n乃作翻然思，遽能免心惊。\n君子足远虑，小人无隐情。\n有言傥可吐，守口何如瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]