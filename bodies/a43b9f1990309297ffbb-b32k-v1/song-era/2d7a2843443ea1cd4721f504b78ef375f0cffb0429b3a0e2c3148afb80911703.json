[{"title":"破虏凯歌二十四首 其一","author":"周麟之","text":"可笑狂胡到死狂，欲投马箠渡长江。\n始知人语符天意，东向南朝作鬼降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌六首 其六","author":"周麟之","text":"捷书日日到甘泉，使者联翩出劳旋。\n将士欢呼拜君赐，雕衔宝带鹄袍鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌六首 其五","author":"周麟之","text":"江花閒队晓霏开，争看官军打贼回。\n十万羌胡今已破，不烦天子六飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌六首 其四","author":"周麟之","text":"将军羽扇自临戎，帐下健儿争立功。\n铁马莫来淮上牧，汉家旗纛半天红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌六首 其三","author":"周麟之","text":"山川千里战尘清，不负当初齧指盟。\n从此胡儿敢欺我，江淮草木已知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌六首 其二","author":"周麟之","text":"莫怕南来生女真，皂幡罽马漫如云。\n黄头碧眼惊相语，切勿前逢八字军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破虏凯歌六首 其一","author":"周麟之","text":"夜半江风金鼓声，拔营初起石头城。\n虏情不料诸军渡，一战淮西唾手平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其七","author":"周麟之","text":"烟霞缥缈认骊山，远想楼台紫翠间。\n尚欲神游太真院，不知身过鬼门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其一","author":"周麟之","text":"长安回首战尘中，马背行吹一笛风。\n寄恨翻成谪仙怨，始知深负曲江公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其三","author":"周麟之","text":"向来花萼弄春辉，曾把宁王玉笛吹。\n乐事已随风烛过，如今横笛不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其八","author":"周麟之","text":"阿瞒按舞长生殿，妃子洗妆端正楼。\n此去恰如巫峡梦，相望千里事悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其二","author":"周麟之","text":"锦囊留得玉环香，不见佳人空断肠。\n北望秦川烟草满，尚疑飞燕舞昭阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其五","author":"周麟之","text":"雨声鸣栈不堪听，尽日穿云上杳冥。\n羯鼓催花浑不记，曲中空唱雨霖铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其六","author":"周麟之","text":"渔阳千帜扫空来，满目妖氛斗不开。\n为问玉京何日复，伤心黄屋几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望秦川歌 其四","author":"周麟之","text":"蜀山春动锦江流，水绿山青总是愁。\n愁绝不堪山上望，无人解与月宫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇太后阁六首 其六","author":"周麟之","text":"方开八帙庆修龄，又捧榴杯拜紫庭。\n一岁一添长命缕，拟将万缕献慈宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇太后阁六首 其四","author":"周麟之","text":"凉生浴殿蔼兰芳，玉宇深沈昼漏长。\n试诵琼章开蕊笈，御炉风袅辟邪香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇太后阁六首 其三","author":"周麟之","text":"覆户双人艾，浮樽九节蒲。\n更闻天子孝，瑞箑扇尧厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇太后阁六首 其二","author":"周麟之","text":"柳映金铺丽，菰黏玉俎香。\n六宫随凤辇，来献九霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇太后阁六首 其一","author":"周麟之","text":"皋月乘天数，慈闱奉母仪。\n灵芝三万岁，乐府有新词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇后阁五首 其四","author":"周麟之","text":"不贪斗草事诗书，漫采香芸辟蠹鱼。\n永日挥毫自忘暑，滴残宫砚玉蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇后阁五首 其三","author":"周麟之","text":"甘霔令年应祷祈，屏除荤茹与君齐。\n化行自是恩波远，何止春郊雨一犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇后阁五首 其二","author":"周麟之","text":"绕臂长生缕，无非柘馆丝。\n还因袗絺绤，深念葛覃诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇后阁五首 其一","author":"周麟之","text":"瑞霭浮龙鉴，凉飔拂燕钗。\n瑶钟献冰醴，暑殿雪盈怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇帝阁六首 其六","author":"周麟之","text":"碧琳宫殿昼翻书，时见龙鸾落宝跗。\n一念清非能却暑，不须更展北风图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇帝阁六首 其五","author":"周麟之","text":"西湖雨歇鉴奁开，江面银涛一线来。\n自有云山供四座，圣君元不事池台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇帝阁六首 其四","author":"周麟之","text":"槐绿乍迷青羽盖，樱红已荐赤瑛盘。\n太平节物年年好，又见浮菖与浴兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇帝阁六首 其三","author":"周麟之","text":"日永三星正，风薰万宇凉。\n要知垂艾意，期与庶民康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇帝阁六首 其二","author":"周麟之","text":"祝网汤仁布，垂裳舜德敷。\n五兵浑不用，安事赤灵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午贴子词 皇帝阁六首 其一","author":"周麟之","text":"赤伏题皇运，朱明敞帝宸。\n休符知有相，此月是天申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与苏州守十诗以兵卫森画戟燕寝凝清香为韵 其三","author":"周麟之","text":"馆娃宫院秋沈沈，采香芳径花委金。\n吴王旧事久寂寞，此地犹怀千古心。\n黄堂高兴动樽俎，三百画桥丝管音。\n吴侬但识宴会乐，那知绕屋棠阴森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与苏州守十诗以兵卫森画戟燕寝凝清香为韵 其十","author":"周麟之","text":"盖公论治齐相堂，穆生酌醴元王觞。\n古人好士乃如此，名重千载尊而光。\n我公风度冠今昔，龙门冠盖春云翔。\n微才讵敢充旨味，药笼庶容芝桂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太庙观芝草 其一","author":"周麟之","text":"九庙宁神蔼德馨，煌煌又见产芝英。\n香凝荐斝椒兰润，色映雕梁日月明。\n绍复祖宗全达孝，感通天地契精诚。\n试披瑞牒占休应，看取皇家万叶荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太庙观芝草 其二","author":"周麟之","text":"晓开疏屏望荣光，仰见威灵烛下方。\n二本同楹真盛事，三年叠秀是殊祥。\n好图瑞采增旗帜，更诵灵华续乐章。\n拜舞共陈归美颂，喜浮春殿九霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见张运使郎中 其二","author":"周麟之","text":"野鹤摩云万里心，一枝聊复寄高林。\n愁边举目江山异，客里登楼岁月深。\n长铗誓为知己用，短檠空伴读书吟。\n龙门不拒通家子，应许来听正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见张运使郎中 其一","author":"周麟之","text":"风度颙颙白首郎，清朝趋奏久含香。\n东南德望龙津阔，甲乙科名雁序长。\n使节不辞骊驾远，卿家重见戟门光。\n愿公早入承明去，一试囊中活国方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏呈珉禅师","author":"周麟之","text":"我来何幸识支郎，百丈峰头宝月光。\n质薄自怜非燕颔，途穷谁信是龟肠。\n渐看鬓底千丝白，敢说眉间一点黄。\n坐见锦溪秋水阔，不知何日理归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初除西掖士华兄以诗贺喜次韵为谢","author":"周麟之","text":"向来归卧白云边，忽拜君王诏墨鲜。\n谁借羽翰超弱水，又随簪橐过甘泉。\n酒同今夕兄酬弟，诗比当年圣得贤。\n润色正须燕许手，小儒那有笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨国夫人赵氏挽章","author":"周麟之","text":"猗兰奕叶神明胄，四德宜家绰有馀。\n盛事可稽彤笔史，当年曾梦紫函书。\n子登虎榜朝辉弁，夫握龙韬拱殿庐。\n长乐宫中称万寿，犹思翟茀拥軿车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其十","author":"周麟之","text":"忆昔春官试，唯公季子俱。\n别来成永诀，返哭恸诸孤。\n忍预吹箫列，空怀解剑趋。\n新阡閟长夜，雪涕堕平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其九","author":"周麟之","text":"久玷平津馆，叨陪北海尊。\n轩腾期远到，刻苦记前言。\n稚榻恩难报，韦经业自存。\n孤踪初筮仕，此志与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其八","author":"周麟之","text":"绿野裴公趣，东山谢傅心。\n林泉幽梦断，花柳旧溪深。\n瀹茗风生腋，飞觞月满襟。\n向来亲几杖，犹想听高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其七","author":"周麟之","text":"四老延清会，连年乐故乡。\n誉腾花萼集，光动德星堂。\n今独三荆茂，居然一鉴亡。\n庆流知有在，兰玉蔼遗芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其六","author":"周麟之","text":"晚岁游真馆，分符莅别京。\n九关留管钥，千骑按屯营。\n天上金瓯覆，江边玉节明。\n伤心游宴地，怅望北山横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其五","author":"周麟之","text":"自领一麾出，旋更五镇雄。\n政追栖凤迹，民戢带牛风。\n鉴水恩波外，西山爽气中。\n棠阴随处是，绕屋自茏葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其四","author":"周麟之","text":"出入纡宸眷，龙光溢帝阍。\n赐书奎画烂，分剂宝奁存。\n尚拟陪三接，俄悲筑九原。\n遗忠当厚报，岂但辍瓜恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其三","author":"周麟之","text":"一马龙骧后，中朝草创初。\n秉枢登政路，扈跸拥宸裾。\n像入云台画，名标玉府书。\n太平资旧德，不及驾安车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其二","author":"周麟之","text":"德望三朝老，才华一代宗。\n伟名高附凤，馀事富雕龙。\n异刻惊黄玉，仙游问赤松。\n忽骑箕尾去，云路杳无踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"参政大资毗陵张公挽诗十首 其一","author":"周麟之","text":"淝上英游远，江南庆系长。\n二卿双戟贵，七叶一门光。\n早负鹏天阔，先分桂籍香。\n中兴谁第一，勋烈在旂常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元革叔无闷斋","author":"周麟之","text":"家在涛江欲尽头，结茅宁为乐休休。\n达人自得一经趣，游子空怀千岁忧。\n坐对圣贤唯酒适，身凭形影以诗酬。\n公今非遁元无闷，要把韦编续圣丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"表兄知府郎中张公挽诗三首 其一","author":"周麟之","text":"自昔三珠树，如兄最早成。\n握兰沾剩馥，搴桂阻高程。\n健笔三江泻，英标一鹗横。\n崦嵫惊电谢，坐失剑峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三首 其三","author":"周麟之","text":"江远莼鲈晚，径荒松菊寒。\n近知秋信好，更觉旅怀宽。\n远杵风催急，横琴夜向阑。\n飘零莫惆怅，吾道久艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三首 其二","author":"周麟之","text":"燕去帘帷静，蛩鸣机杼忙。\n凄风万籁息，夜月一奁光。\n自喜襟怀豁，宁为景物伤。\n幽窗有佳致，坐挹桂花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀三首 其一","author":"周麟之","text":"雨沐秋容净，云横天宇高。\n溪流走城堑，木叶下亭皋。\n兴引渊明酒，寒侵范叔袍。\n清愁不能已，高枕诵离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡夫人挽诗 其二","author":"周麟之","text":"晚岁根尘净，端由志节隆。\n敛身遵七诫，弹指悟三空。\n此日伤朝露，何人赋凯风。\n我方司汗简，盍载女师中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡夫人挽诗 其一","author":"周麟之","text":"阃范三从正，家声两大馀。\n义高黄鹄操，恩叠紫鸾书。\n涧沼登蘋藻，园林映板舆。\n忽乘飞凤去，应傍素台居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡夫人挽诗 其三","author":"周麟之","text":"旧倚韩康伯，高堂坐累茵。\n曩先归厚夜，今又失灵椿。\n族党千车会，阶庭五鼎陈。\n季能当大事，无负玉堂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王时亨舍人帅蜀诗二首 其二","author":"周麟之","text":"一从雁塔缀英游，又见功名得志秋。\n丹阙万人窥榜眼，碧幢千骑拥遨头。\n锦城日暖茕鳏舞，玉垒烟深铠仗收。\n它日中和闻善政，一琴宁复久淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王时亨舍人帅蜀诗二首 其一","author":"周麟之","text":"煌煌大笔照坤维，忽见文星下紫微。\n万里江山浑改观，九重绅笏更争辉。\n占松不假刀形梦，换马端期鹄趁飞。\n试问郫筒故乡酒，路人应唱踏花归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧大通还山一首","author":"周麟之","text":"三年虎卧白云关，谁念穷猿失故山。\n野客已拚花自落，道人今与鹤俱还。\n厖眉皓首双松老，白氎青丝一室閒。\n何日得追尘外趣，听君击钵翠微间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政大夫胡公挽诗五首 其五","author":"周麟之","text":"末绪惭非偶，孤踪托契深。\n委禽申旧好，奉屦负初心。\n已矣升堂拜，潸焉雪涕吟。\n四郊烟树惨，引绋堕哀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政大夫胡公挽诗五首 其四","author":"周麟之","text":"碧落承先训，青冥屈壮图。\n珠悬三树秀，鉴舞一鸾孤。\n逝水嗟何及，佳城谶不诬。\n江山蟠秀气，此地卜青乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政大夫胡公挽诗五首 其三","author":"周麟之","text":"燕寝追遗事，沈痾叹积年。\n未扶鸠杖起，已报鹿车悬。\n显服登三品，荣名谢九迁。\n英姿宁复见，归伴玉台仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政大夫胡公挽诗五首 其二","author":"周麟之","text":"西帅乘迟日，趋庭正妙年。\n飞书腾白羽，曳綵汎红莲。\n晚伏追风骥，长嗟堕水鸢。\n卷舒安义命，何恨及重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致政大夫胡公挽诗五首 其一","author":"周麟之","text":"赫奕三公胄，高华百笏门。\n义风倾里社，名德老丘园。\n不起东山卧，空馀北海尊。\n已随飞剑逝，犹记刻舟痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋张参政四老堂 其一","author":"周麟之","text":"散策相从倚玉鸠，不须更伴赤松游。\n林塘在眼供舒啸，花鸟催诗好劝酬。\n一座几盈三百岁，四翁宜寿八千秋。\n堂前风物如伊洛，尚欠香山与石楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋张参政四老堂 其二","author":"周麟之","text":"西望斜川烟霭低，荆溪东下泛清漪。\n夜来风雨秋怀共，春草池塘昼梦迟。\n江左便传花萼集，曲中休奏紫芝词。\n安车不日联镳至，银角桃枝上玉墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上王吏部","author":"周麟之","text":"人物南州望，风流一代英。\n夙传天上誉，早梦月中名。\n车载三千牍，鹏飞九万程。\n向来辞泮水，端合上仙瀛。\n接武虞廷邃，含香汉殿清。\n渐看丹极近，首冠列星明。\n准拟陪三接，周旋位六卿。\n鉴分金背重，橐并紫荷轻。\n未见恩纶出，那知谤箧盈。\n去朝云路杳，归侍綵衣荣。\n地借徽之竹，楼吹子晋笙。\n赤心何所负，白眼不须惊。\n自顾衔恩厚，亲逢较艺精。\n妍媸归藻鉴，高下见文衡。\n梦绝怀蛟异，词非吐凤成。\n赋能窥小小，经漫说铿铿。\n误玷春官籍，终惭月旦评。\n抢榆几类鴳，出谷仅同莺。\n志慕青钱士，名参玉笋生。\n别深秋鹤怨，归问海鸥盟。\n未作河西尉，聊为江上行。\n夜沈滩月钓，晓压陇云耕。\n岁暮人初返，天寒雨未晴。\n久稽从杖履，且复卧柴荆。\n后见含深恧，微吟写至情。\n伫听宣室召，凤阁继家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与苏州守十诗以兵卫森画戟燕寝凝清香为韵 其一","author":"周麟之","text":"吴山濯濯烟鬟青，湖水练练光绕城。\n城中主人目如电，爽气坐纳山水清。\n千门鸣弦夜月静，四野垂颖秋云平。\n试占古语咏侯德，一贤可当百万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]