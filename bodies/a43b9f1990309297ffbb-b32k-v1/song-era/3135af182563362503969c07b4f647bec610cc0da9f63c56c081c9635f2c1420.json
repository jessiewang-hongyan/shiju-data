[{"title":"岳阳送管顺甫还清湘","author":"李曾伯","text":"度岭来荆又戍西，惊涛险栈尽同之。\n七年相与犹一日，万里偕还分两岐。\n苕隐我归终此世，宝坊君到出何时。\n交情果未轻捐弃，回首毋忘赠别诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚子祈雨蒋山赠月老","author":"李曾伯","text":"欲知计寺金谷吏，便是钟山粥饭头。\n尔欲朝朝动鱼鼓，我期日日饱貔貅。\n几为晓灶炊烟喜，又作秋田渴雨忧。\n自有宝公能办供，元凭心上细推求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申七月自桂归资寿作","author":"李曾伯","text":"三载烟岚在岭陬，几番清梦到松楸。\n每怜老子身关塞，长忆童时某水丘。\n今得归来访渔隐，不妨高卧老菟裘。\n据鞍矍铄成何事，徒愧平生马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌赴荆阃舟过湘江","author":"李曾伯","text":"湘流得雨掌来平，艇子乘风羽样轻。\n过眼千山才岭粤，转头一水又衡荆。\n大江东下怀乡国，落日西边是戍城。\n鸣鴂数声青嶂晚，客心如铁也关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌题雪观用方孚若韵","author":"李曾伯","text":"才见春从沙际归，堂堂背我迅于飞。\n病馀窥圃心成怯，老去登楼力苦微。\n岸柳含烟犹绿瘦，海棠裛雨正红肥。\n山川信美非吾土，强作清吟祗遂非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招里巷诸友和韵","author":"李曾伯","text":"小有家林适，归来已恨迟。\n引杯怀楚舞，饱饭和陶诗。\n慷慨多新语，绸缪半旧知。\n夜深桥雪滑，亟命短筇支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枕上偶成","author":"李曾伯","text":"官辙驱驰遍四郊，老来于此尚投胶。\n绸缪先事心为碎，展转中宵睫不交。\n贪鼠驱无容出穴，惊乌疑恐弗安巢。\n灯残衾薄新寒力，听彻更筹五五敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘舍人咏鞦韆","author":"李曾伯","text":"院落阴阴捲昼帘，綵绳高挂矗青天。\n纤腰对蹴争先起，香汗交流倦欲眠。\n花畔惊呼簪珥坠，柳梢时出綵罗鲜。\n可怜墙外行人恼，应费长安酒价千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯章漕乐语口号","author":"李曾伯","text":"来湘话浙倍绸缪，天路风高借莫留。\n不俟驾行何惮暑，适逢圭觐恰当秋。\n登仙堪羡星辰履，归老终寻雪夜舟。\n公到甘泉陈大计，毋忘膏雨泽南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯管制干","author":"李曾伯","text":"画诺三边赖一贤，怜余东下病缠绵。\n驱驰不惮数千里，缱绻相于十二年。\n我老已辜康乐屐，君行快著祖生鞭。\n祗惭无力堪吹送，雪意垂垂饯去船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣公祠","author":"李曾伯","text":"公不生唐世，贞元事若何。\n主恩思报切，臣罪忤时多。\n佞舌攻何忍，刚肠死不磨。\n倚兰凝伫久，一鹭点沧波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至桂林戒弗作诗饮酒","author":"李曾伯","text":"误领元戎太乙旗，提封四履镇南篱。\n旄倪争向道涂看，名姓亦为蛮徼知。\n时务正殷毋事酒，春光虽好莫言诗。\n经营都了家山去，此是从容觞咏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将到永州宿村舍","author":"李曾伯","text":"野宿孤村迥，山行十里荒。\n犊眠衰草壤，马踏落梅香。\n入眼春晴薄，打头风势扬。\n莫嗟登陟苦，明日看潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思归偶成 其一","author":"李曾伯","text":"春来便拟问归津，转眼江流若许深。\n六十岁翁穷塞客，八千里路故乡心。\n鹃啼月树添征思，鹊语风檐误好音。\n只有云山遮不断，梦随栩蝶过家林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思归偶成 其二","author":"李曾伯","text":"杜鹃一自听天津，南北纷纷患转深。\n备谨彻桑征戍事，忧形恤纬老臣心。\n惊闻边信多蛮语，喜动乡情带楚音。\n若得君王放归去，便陪莲社访东林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日领僚属游龙隐岩","author":"李曾伯","text":"久卧苍崖底，风雷为擘开。\n蜕形犹挂石，鳞迹不沾埃。\n一水将清贯，数峰推爽来。\n浑疑负舟去，烟雨肯低佪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭君溪","author":"李曾伯","text":"巴峡向来惟屈姊，汉宫奚事出明姬。\n当时本有平戎术，中国难容绝世姿。\n忍死定仇娄敬策，惜生不遇武皇时。\n后人却恨毛延寿，断送春风入远夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭口占","author":"李曾伯","text":"舟子方将北，封姨不肯南。\n去帆冲急浪，古寺隐晴岚。\n远渚鸦千百，中流鸥两三。\n短篷聊徙倚，底用客程贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸卯制参黎用之为八仙领客和韵","author":"李曾伯","text":"扑面惊埃扫不开，都忘柳色暗章台。\n偏饶玳席嘉宾乐，特遣瑶池仙子来。\n自分铁心徒自苦，相逢玉兔莫相陪。\n樽前休讶清香少，待约琼花共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日登楼眺望","author":"李曾伯","text":"徙倚上危梯，云空望眼迷。\n雁声秋信北，鸦背夕阳西。\n岸远舟逾小，水高山陡低。\n家乡天际是，何日赋归兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋霖喜霁适睹庙堂酬唱相去数千里而阴晴同之因用韵","author":"李曾伯","text":"明良相正体坤乾，感格时旸本致虔。\n坐使群方皆见日，谁言千里不同天。\n只将精白承休德，岂在缁黄结善缘。\n更得北风无羽檄，不妨举酒乐康年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荆阃宴交代贾尚书乐语口号","author":"李曾伯","text":"底事元戎辍上流，扬州势更重荆州。\n要酬棠笏中原志，坐释枫宸北顾忧。\n白羽一挥新玉帐，朱帘半捲旧红楼。\n此行整顿乾坤了，公衮莱衣正黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荆阃宴吕马帅乐语口号","author":"李曾伯","text":"海风吹月近中秋，碧玉天高灏气浮。\n文武对开王俭幕，主宾同上仲宣楼。\n棋边正要看新著，酒畔何妨话旧游。\n了却经营宛洛事，入登枢筦赞帷筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荆阃偶成","author":"李曾伯","text":"一出峤南道，重来国北门。\n词源因老涸，心鉴以忧昏。\n可厌惟官事，难忘是主恩。\n衷怀谁共语，流得枕边痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子守衡州","author":"李曾伯","text":"雁峰自昔号名州，尔既难辞我莫留。\n临政毋忘宣上德，持身谨勿遗亲羞。\n当令民诵循良守，罔俾人讥恩泽侯。\n国事正殷宜黾勉，明年吾自问归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送八窗叔归","author":"李曾伯","text":"归来百事付休休，又向空山断送秋。\n整叠衣篝双赤脚，携持拄杖一苍头。\n儒书梵语相参看，酒柱诗盟自献酬。\n客有可人留不住，夜长谁与话清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子倅当涂","author":"李曾伯","text":"久历家庭役，今欣羽翼成。\n此行为别驾，平步可颛城。\n常整韦弦佩，要持冰檗声。\n山林佚吾老，有子足光荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子倅宜春 其一","author":"李曾伯","text":"已佐当涂郡，春台再往临。\n勿言官是赘，常以国为心。\n勉勉思全璧，频频寄抵金。\n史君天下士，澡雪奉规箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子倅宜春 其二","author":"李曾伯","text":"爱子喜能仕，恋亲犹欲留。\n肯堂斯室就，不稼曷禾收。\n持此一廉往，绰然千里游。\n彼邦存学记，熟复勿贻羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送书记雷宜叔造朝","author":"李曾伯","text":"五色云边昔稚圭，军戎万里已周知。\n趋朝岂止重凭广，出幕聊为送适诗。\n行李羽轻清涨稳，交情珍重岁寒期。\n君王若问荆州事，白玉阶前细数之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送石首傅宰","author":"李曾伯","text":"石首邑易治，难山政可师。\n弦歌聊戏耳，谈笑以为之。\n省德多餐饭，勤官少作诗。\n交情毋恃旧，公事定相规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送交代董矩堂赴召 其三","author":"李曾伯","text":"溯风绣节洞庭滨，作噩重逢未识真。\n不谓颓龄来岭海，乃承华武接星辰。\n公捐累印轻于叶，我愧满襟皆是尘。\n从此庙堂医国去，好留肘后遗陈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送交代董矩堂赴召 其二","author":"李曾伯","text":"渡泸已定葛巾北，分陕既成周衮东。\n二者于斯皆上意，群然以此望明公。\n香名千载梅边雪，归路三秋桂子风。\n百万民夷休恋恋，公方柄用福无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送交代董矩堂赴召 其一","author":"李曾伯","text":"渊源正学富经纶，炳炳如丹一片心。\n中外久期还荷橐，江湖所至是棠阴。\n威声足使戎心慑，边腹何虞客气侵。\n指日玉阶清问及，盍思长策济当今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送扬州胡倅赴堂召 其二","author":"李曾伯","text":"里社久相于，深知我计疏。\n壮怀方磊磊，别语又渠渠。\n竟日犹传箭，何时可荷锄。\n烦君看三径，松与菊何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送扬州胡倅赴堂召 其一","author":"李曾伯","text":"击楫同呼渡，勤公佐此州。\n边防新绩用，湖学旧源流。\n未了平戎檄，还催向阙舟。\n君王方仄席，樯燕勿迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送制机丰德馨赴堂召 其二","author":"李曾伯","text":"奇章昔送牧之行，旧事今亲见广陵。\n一叟栖栖嗟孑立，诸贤衮衮庆偕升。\n事来推与参前著，公去吾其失右肱。\n我俟兵休归决矣，断无清梦到觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送制机丰德馨赴堂召 其一","author":"李曾伯","text":"元祐丰家几世孙，依然风概至今存。\n著鞭自许河南逖，举酒相期洛北温。\n联句有诗留月观，禦戎何策告天阍。\n切毋饮却西湖水，齿颊冰霜置勿论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周炳仲大卿归江西","author":"李曾伯","text":"中外周旋阅几年，清忠一节可笺天。\n历阶而上公卿易，拂袖以归韦布然。\n霅上人稠难买屋，江头路稳好行船。\n梦回落月应相忆，犹有征人在汉边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗季能赴江陵幕 其一","author":"李曾伯","text":"淳熙公论盛槐门，文献依然故笏存。\n晋世昔闻期毕万，鲁人今喜见臧孙。\n交游半是清流望，趋向难为俗子论。\n久客诸侯宁郁郁，公卿元自出藩垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗季能赴江陵幕 其二","author":"李曾伯","text":"留台雄峙渚宫边，江汉中间别一天。\n号令半皆归后务，规模几不减中权。\n况从席上分邹湛，细向楼头访仲宣。\n为报荆人好相庆，幕中无事帅垣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季辙制参赴堂召 其二","author":"李曾伯","text":"君见淮头尚可为，勿言蚌鹬正相持。\n再三国计当加备，第一人材最切时。\n面目山林还尔我，精神帷幄舍渠谁。\n登楼若也披舆地，为借前筹试及之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季辙制参赴堂召 其一","author":"李曾伯","text":"怪得檐头鹊语频，好音催召幕中宾。\n唤回鸡塞三更梦，趁取莺花二月春。\n车法阵图留后效，囊封谏草看前陈。\n退朝若访孤山去，尚有疏梅可寄人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵鼎臣赴召 其二","author":"李曾伯","text":"师旅之馀旱继之，可为太息此何时。\n江头人类鱼鳞集，局面忧深虎口危。\n国事不应分尔汝，边防岂特固藩篱。\n茂弘若问金陵事，说与江东米价知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵鼎臣赴召 其一","author":"李曾伯","text":"几载江湖负隽声，秋风千里起弓旌。\n石渠喜得今刘向，宣室应知旧贾生。\n台阁致身将贵显，朝廷论事且和平。\n更须记取申公语，不在多言在力行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郭靖父还金陵 其二","author":"李曾伯","text":"忆昨相从戎马间，屡披锦诰慰苍颜。\n烟尘历遍疆陲役，风雪同谙道路艰。\n子负此名心已白，我成何事鬓徒斑。\n一杯握手无它祝，归为移文问北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郭靖父还金陵 其一","author":"李曾伯","text":"慈恩得隽绿衣归，凡客南来罕似之。\n名氏已标希吕第，文华要继幼安诗。\n行登衮衮诸公上，毋鄙区区一尉卑。\n踏雪同来子先去，梦随鞭影过江湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送清湘蒋尉 其二","author":"李曾伯","text":"昔插金莲醉五泉，与君抵掌共谈天。\n蜀山历遍数千里，荆渚重逢八九年。\n子为丹砂行作吏，我无金鼎可求仙。\n更怜不是春风手，雪意垂垂送去船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送清湘蒋尉 其一","author":"李曾伯","text":"我学言诗诗不奇，蒋君言命却能诗。\n岁寒如许松不改，春信未来梅已知。\n丘壑何如归去好，江湖终匪老来宜。\n辰州极去湘南近，办取柴桑三径资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送焦吏部造朝 其二","author":"李曾伯","text":"火云赫赫汗衣流，人望公来望有秋。\n契托棣华承缱绻，辞陈桑土愿绸缪。\n行为霖雨千畴足，坐解西风一段忧。\n从此江头波浪息，柳边赢得伴沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送焦吏部造朝 其一","author":"李曾伯","text":"向来借箸在筹帷，今趣魁缠入太微。\n汉郡奚劳汲生守，洛人喜见范公归。\n要持真是明公论，莫急同心济事机。\n见说九重勤侧席，细陈长策慰宵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送翟简卿制参赴南安 其二","author":"李曾伯","text":"自屈星屏佐碧油，艰危同济此风舟。\n平山杨柳留佳话，庾岭梅花想胜游。\n公到玉阶宜抗论，我寻画舸便归休。\n他时若访无真里，野水中间一白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送翟简卿制参赴南安 其一","author":"李曾伯","text":"渡江华阀尚毡青，人物林中早有声。\n官辙久更谙世路，边筹熟试洞戎情。\n整镳向阙人多羡，出幕持麾古所荣。\n盍为王言留禁闼，美才何止仅专城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送糟蟹遗制幕","author":"李曾伯","text":"江乡霜后饱珍肴，万里持来仅带糟。\n虽惜横戈酣白蚁，尚知解甲护红膏。\n开樽祗觉牵归兴，作赋犹当继老饕。\n油幕晚寒梅影静，亟持大白荐双螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃木樨开第二花","author":"李曾伯","text":"苍苍仙种自谁栽，一度秋光两度开。\n故遣宝花装世界，重教金粟见如来。\n香于月下开樽对，意似霜前把菊催。\n生怕重阳风雨近，亟须领略莫迟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重过岳阳","author":"李曾伯","text":"远役数千里，重来十四春。\n山城风景旧，人物岁时新。\n官舍多陈迹，君山是故人。\n楼头一杯酒，聊涤客襟尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳登益昌锦屏山","author":"李曾伯","text":"徙倚阑干目送间，山容如我亦苍颜。\n恍思戏马登吴会，拟逐飞鸿度汉关。\n草木与俱嗟岁月，古今无恙只江山。\n天公幸自无风雨，一笑黄花分也悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食河豚鲈鱼席间口占","author":"李曾伯","text":"午食河豚晚食鲈，两鱼风味绝悬殊。\n怀归未必因兹品，适口何能计此躯。\n春岸荻芽常喜有，秋风莼菜不愁无。\n笑他俗子甘鳅鳝，为此杯羹戒不虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"首夏而有秋意","author":"李曾伯","text":"才过清和候，凄然感旅怀。\n新蛩吟古砌，落叶满前阶。\n榴火春仍驻，槐屯午自佳。\n凭诗记风土，归以语朋侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴广西丰宪乐语口号","author":"李曾伯","text":"帝遣星轺入桂州，雨馀凉嫩一天秋。\n绣衣翠节皇华远，碧玉青罗喜气浮。\n犹昔孺文同此酒，喜今师德在吾舟。\n相期办却平蛮事，公向三阶我一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴四川余制置乐语口号","author":"李曾伯","text":"分弓辍自侍臣班，来拥貔貅设汉关。\n胆落毡裘千里外，指呼羽扇一麾间。\n共期朴实工夫到，会见承平气象还。\n荆益论盟如此酒，从今西顾释天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴湖南洪漕乐语口号","author":"李曾伯","text":"仗节来从玉笋班，福星甫照举欢颜。\n持荷自盍登尧陛，挽粟宁容久汉关。\n庆集正当萸菊际，交盟喜在芷兰间。\n定王台小难留住，祗恐天边即予环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴湖南章漕乐语口号","author":"李曾伯","text":"使星一点寿星边，惠我三湘两阅年。\n既付龟符还楚垒，便持犀节上尧天。\n何参接踵新规在，侨札论心旧识然。\n入对丹墀访南事，细陈霜颊障蛮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴嘉兴谢守乐语口号","author":"李曾伯","text":"辄从荀玉镇扶风，政事龚黄一样同。\n白发归田嗟我老，黑头入相属之公。\n萧然旧菊荒芜里，欣在甘棠蔽芾中。\n诏下鸳湖天咫尺，好风行送画船东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]