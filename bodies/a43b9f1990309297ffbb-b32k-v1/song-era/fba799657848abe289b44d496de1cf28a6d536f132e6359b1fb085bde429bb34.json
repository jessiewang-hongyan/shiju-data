[{"title":"送谢刑部使君赴召 其一","author":"胡仲弓","text":"擿奸方喜俗无哗，一札飞来墨敕斜。\n职业已升金掌贵，吏民空拥綵旗遮。\n绛车趣召二千石，舆颂欢传十万家。\n桃李竞随春脚去，仅留遗爱在桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"选官图","author":"胡仲弓","text":"百年穷仕宦，尽在此图中。\n真假名虽别，升沉理则同。\n前程如漆黑，末著满盆红。\n时采毋虚掷，平迁至上公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九日法轮庵次凤山韵 其一","author":"胡仲弓","text":"野眺逾高阪，钟传响外幽。\n僧从孤寺出，客倚一林秋。\n池上烟飞去，亭皋影尚留。\n远风山下起，吹我上层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九日法轮庵次凤山韵 其二","author":"胡仲弓","text":"竟日延荒寺，秋声不可歌。\n磬中闻午至，石上见寒过。\n野鸟心常肃，孤僧鬓已皤。\n欲归情不尽，门外夕阳多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕寄弟","author":"胡仲弓","text":"年华今告老，人事亦如斯。\n汉殿藏钩戏，戎家守岁时。\n世情方役役，雨意正垂垂。\n强作屠苏醉，椒盘欲颂谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚栏","author":"胡仲弓","text":"倚栏商好句，云散海山青。\n风急天无恙，人惊心地灵。\n潮头迎日月，帆片落沧溟。\n夜静涛声息，龙吟得细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚窗诗","author":"胡仲弓","text":"倚窗成小立，风伯为清尘。\n帘捲梅当户，云开月闯人。\n疏钟来远寺，落叶度吟身。\n无限关心事，栖迟寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"胡仲弓","text":"楼高天一握，山入白云根。\n寺在牛鸣地，人行犬吠村。\n晴窗薰野马，寒木下孤猿。\n吟罢月初上，诗僧来扣门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凌霄塔","author":"胡仲弓","text":"浮图山尽处，八表浩无涯。\n脚踏雷轰石，眼生阳艳花。\n天围连海岱，云气杂烟霞。\n如此真孤绝，学仙能几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭杜立斋先生","author":"胡仲弓","text":"凤鸟才看刷羽仪，胡为遽报哲人萎。\n可怜如晦遄归日，不及唐朝既效时。\n善类固知难著脚，小人未可便扬眉。\n老天欲寿斯文脉，后死当为继绝思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭芸居","author":"胡仲弓","text":"锦囊方络绎，忽报殒吟身。\n泉壤悲千古，江湖少一人。\n病怀诗眷属，医欠药君臣。\n脂岭西风急，兴思暗怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭赵吏部","author":"胡仲弓","text":"篇诗曾送耻斋行，岂料存亡隔此生。\n早控危衷敷鲠论，晚留遗爱在羊城。\n惜无金辂封同姓，空有玉棺归九京。\n箧笥旧藏君杂藁，令人一读一伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悟枯崖将过莆城参访后村书此赠行","author":"胡仲弓","text":"吟单何日起，持钵倚刘墙。\n莲社招师入，松阴去路长。\n白云迷眼界，明月照诗囊。\n莫吸西江水，风波不可当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行即事","author":"胡仲弓","text":"贪看梅花短作程，吟鞭不动马蹄轻。\n村庄到处如知己，物色于人亦有情。\n去雁远连潮水落，乱山低与暮云平。\n倚栏无语閒商略，此景谁能画得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源图","author":"胡仲弓","text":"桃源分二种，半在此源栽。\n向为逃秦去，今还归赵来。\n山川犹古昔，人物不尘埃。\n刘阮何为者，无言空自回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐江舟中","author":"胡仲弓","text":"推篷纳山色，愁坐对黄昏。\n雨过天无翳，舟行水有痕。\n钟声来远寺，犬吠隔烟村。\n柳下渔人屋，收罾早闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后呈芸居","author":"胡仲弓","text":"病骨清于鹤，临风直欲飞。\n閒多酬病债，吟苦费心机。\n带缓腰围减，囊空药裹稀。\n未能全谢客，扶杖扫林扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离家","author":"胡仲弓","text":"大笑出门去，江湖天地宽。\n耐贫为客易，生计靠诗难。\n日月双车毂，功名百丈竿。\n上林有嘉树，且择一枝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘江待潮","author":"胡仲弓","text":"潮至千艘动，涛喧万鼓鸣。\n江翻晴雪卷，海涨石塘平。\n帆影林端见，波光屋上明。\n青山自吴越，相峙两含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄月塘","author":"胡仲弓","text":"怀人看皓月，清梦落梅边。\n书债閒销日，吟魂飞上天。\n为贫驱宦牒，习懒坐寒毡。\n但得投簪去，何须二顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄水竹","author":"胡仲弓","text":"吴江江上望，平处少波涛。\n冬日思鲈鲙，天风落凤毛。\n二难并四美，独立仰三高。\n秀野曾招隐，清名不可逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王道源","author":"胡仲弓","text":"南来趋斗禄，出处最分明。\n不受吏尘触，常依古道行。\n宦情云样薄，心事水边清。\n待洗巢由耳，攲风听凤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄朱静佳明府","author":"胡仲弓","text":"十载江湖叹不遭，识君岁月漫蹉跎。\n文书南去静边省，山水西来佳处多。\n琴调本高缘抚字，诗逋未了欠催科。\n骚人标致清如许，制锦机中制芰荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄舟中诸吟友","author":"胡仲弓","text":"溪流何太急，画桨去如飞。\n诗垒才无敌，愁城醉解围。\n日斜帆影亚，风细乐声微。\n误入桃源去，月明犹未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄西涧叶侍郎","author":"胡仲弓","text":"拟立门前雪，来时春又深。\n望尘思北面，因病负初心。\n形役犹甘分，肠枯费苦吟。\n升堂定何日，洗耳听规箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴警斋 其二","author":"胡仲弓","text":"豸冠风采动簪绅，天子如何不得臣。\n去后赤心常体国，从前冷语颇冰人。\n好官尽属时贤做，近事看来局面新。\n轮辙深依梅竹下，一僮一鹤伴吟身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴警斋 其一","author":"胡仲弓","text":"去国翩翩又许时，爱君何日不攒眉。\n二贤出处分明甚，四谏声名今似之。\n朝奏一封排佞疏，暮收千首饯行诗。\n山林若问朝廷事，宝剑年来正倒持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀玉","author":"胡仲弓","text":"别去未多时，征尘又满衣。\n忧时阍屡叩，避俗手频挥。\n病有诗堪疗，贫无家可归。\n半生湖海上，莫忘北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李希膺二首 其二","author":"胡仲弓","text":"绿玉樽前笑语嬉，青灯影里坐弹棋。\n交情又属后来者，乐事何如初见时。\n山寺论文辞太苦，海楼握手句尤奇。\n岁寒不见梅花面，辜负暗香疏影诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李希膺二首 其一","author":"胡仲弓","text":"醉倚危栏望海鲸，乍看潮落又潮生。\n眼中世界粟来大，身外乾坤叶样轻。\n鸥鹭行藏无俗迹，鱼龙变化讵虚声。\n冥搜误入蛮烟去，祇恐梅花句未清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李适安","author":"胡仲弓","text":"懒踏门前没马尘，适安亭上坐吟身。\n慇勤风月一樽酒，斟酌湖山十里春。\n柳叶未舒先妩媚，梅花虽老更精神。\n白鸥似会冥搜意，来往忘机欲傍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄沈迂叟","author":"胡仲弓","text":"雁飞不到瘴江边，别去而今又一年。\n放下客愁非为酒，抬高诗价莫论钱。\n从来富贵皆尤物，休把行藏问老天。\n世味料君如嚼蜡，白云堆里且安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄芸居","author":"胡仲弓","text":"京尘方衮衮，君独此安居。\n竹简编科斗，芸香辟蠹鱼。\n眼空湖海士，儿读圣贤书。\n一样吟樽乐，公卿未必如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄容老","author":"胡仲弓","text":"抖擞征衣著，京尘点涴深。\n羡君有丘壑，愧我未山林。\n卜隐中年事，怀人静夜心。\n何时遂归兴，杯酒共清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄抱拙","author":"胡仲弓","text":"割席坐春风，清谈滋味浓。\n齐门听鼓瑟，长乐忆闻钟。\n道等千钧重，诗轻万户封。\n梅花今在望，载酒几时重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄松坡","author":"胡仲弓","text":"别去京华又一霜，怀人心事暮云长。\n高楼不见青山面，明月偏来照屋梁。\n湖海最深难久驻，乾坤许大任行藏。\n书生空抱忧时愤，何日与君同较量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林可山 其一","author":"胡仲弓","text":"相去各天涯，江湖会面迟。\n数年不通问，一见便言诗。\n近世无和靖，今人说项斯。\n孤山梅已熟，滋味独君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林可山 其二","author":"胡仲弓","text":"可人期不至，日日望山孤。\n不是招吟侣，多应觅酒徒。\n虚名付蕉鹿，清兴动莼鲈。\n见说同川好，能通一苇无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄姚省斋","author":"胡仲弓","text":"笑俯修栏一欠伸，年来踪迹尚埃尘。\n几曾只字商量酒，强把篇诗料理春。\n风雨无情莺口噤，江山有恨柳眉颦。\n不知桃李成阴未，我欲行吟避醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赵西岩","author":"胡仲弓","text":"自分男儿未著鞭，龙驹伏枥更多年。\n张仪舌在堪谋国，阮籍途穷只问天。\n弹铗空歌云梦句，焚香静读楚骚篇。\n吟魂常绕江湖上，莫道闽中无杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄适安","author":"胡仲弓","text":"别来不作故人书，堪笑痴翁懒有馀。\n世路每于平处险，交情多是密中疏。\n梅花至老香犹在，竹节虽高心本虚。\n门对青山无一事，便教草长不须锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄适安朝宗","author":"胡仲弓","text":"桐阴湖水绿，清气日盈门。\n室迩人何远，官卑道更尊。\n诗吟唐律语，琴写古人言。\n三妙堪名世，无因得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄顺适","author":"胡仲弓","text":"标格因诗总不群，眼前馀子漫纷纷。\n江头社里新知己，文字行间旧识君。\n心事正须豪杰道，吟声莫遣鬼神闻。\n岁寒消得梅花伴，肯共扁舟载白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄敏斋","author":"胡仲弓","text":"地隔马牛风，村居野兴浓。\n宦情随蝶梦，吟鬓觉龙钟。\n竹外琴三叠，梅边信一封。\n怀人不可耐，山水几千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄颐斋","author":"胡仲弓","text":"蛙声喧夜枕，买静入林居。\n好句敲唐响，清谈笑晋虚。\n素馨和月种，山药带云锄。\n閒里多忙事，篝灯课子书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄鲈乡主人","author":"胡仲弓","text":"天北天南独雁飞，别君动是隔年期。\n尺书久欠鲈乡便，寸步难邀马足驰。\n池草惊回春梦句，梅花开到岁寒枝。\n江湖诸老凋零尽，从此逢人懒说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄默庵","author":"胡仲弓","text":"剩得吟身漫浪游，机心犹在莫盟鸥。\n一枰棋里乾坤大，九节筇边岁月流。\n涉世间关如履险，忧时感慨似悲秋。\n但营二顷閒田地，却笑区区万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄戴石屏","author":"胡仲弓","text":"子入天台我入闽，归来又见六番春。\n雁书乏便通安道，鹤颈长延望叔伦。\n吃药未逢医国手，听琴谁见赏音人。\n年来屡作江湖梦，细嚼君诗当问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄藏叟","author":"胡仲弓","text":"版扉常半掩，人静少经过。\n禅思夜来得，吟情秋后多。\n月高幡影直，风定磬声和。\n何日同携手，云山访薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇福寺次枯崖韵","author":"胡仲弓","text":"觉城向东际，寺在古松湾。\n流水意俱远，白云僧共閒。\n新吟呈绣佛，旧梦绕囊山。\n勘破赵州话，犹疑隔一关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得阙越州冷掾","author":"胡仲弓","text":"寒毡才入手，便动帝乡心。\n千古兰亭在，三年芹水深。\n文排昆体作，诗对越人吟。\n自得高山趣，何当遇赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚眺 其一","author":"胡仲弓","text":"数点寒鸦过别村，晚来秋色眼中分。\n木从阙处留残照，山欲昏时杂乱云。\n两岸草深虫语话，一汀沙白鸟耕耘。\n林间僧舍知何处，回首钟声远近闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚眺 其二","author":"胡仲弓","text":"几度徘徊对暮天，怀人珍重寄诗篇。\n古今上下几千首，天地中间八九椽。\n唤醒吟魂归浊酒，移将杰句上华颠。\n南来诸老凋零尽，回首斜阳倍黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花窠子","author":"胡仲弓","text":"园丁藏密室，不许雪霜欺。\n火气十分燠，春风第一枝。\n横斜无定影，屈曲漫趋时。\n人力夺天巧，东君未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清泉院用柱间韵","author":"胡仲弓","text":"僧居一路曲通村，日落层巅生暮云。\n白石巧于山背出，清泉时向涧边闻。\n钵盂未信承龙化，锡杖曾经解虎纷。\n归去鹤猿应笑我，稚圭何必更移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者 其二","author":"胡仲弓","text":"种药满山巅，山衣木叶联。\n有时扶杖出，只到洞门前。\n击石求鲜火，敲冰引滞泉。\n深居聊避世，不为学神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐真岩次翁景辅韵","author":"胡仲弓","text":"山林营小隐，此隐未为真。\n遗粟浑閒事，因金却误人。\n洞迷归去路，羽化本来身。\n后此岩居者，犹言寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴","author":"胡仲弓","text":"云解雪初晴，青山依旧青。\n水涵霜夜月，梅落晓天星。\n造物无今古，人生几醉醒。\n倚楼吟未足，更上武林亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜郭吉甫擢第调尉八柱还里","author":"胡仲弓","text":"一第全家待，君今衣锦归。\n折来新月桂，忘却故山薇。\n禄近鸂呈瑞，官清马不肥。\n海门西去路，归鸟故飞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富沙水后次壁间韵","author":"胡仲弓","text":"聚落成墟空白烟，乱鸦飞绕夕阳边。\n大江东去有遗恨，流水西来无渡船。\n青女魂游花委地，王孙肠断草连天。\n一樽欲酹故人酒，知是瑶池第几仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食雨中用李希膺韵","author":"胡仲弓","text":"平明风雨酿春寒，试把饧和杏酪餐。\n野祭人来悲冷节，郊行谁肯共吟鞍。\n煮茶有约泉堪品，禁火无条燧莫钻。\n一百五朝全戒酒，定知梦不到邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散策郊行有怀社友","author":"胡仲弓","text":"散策寻诗料，过从野老家。\n水宽蛙世界，花暖蝶生涯。\n翠箔风为捲，青山云半遮。\n怀人千里外，搔首夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游承天寺偶成","author":"胡仲弓","text":"人间热恼正匆匆，才入山门便不同。\n云板声中僧出定，月台影里佛观空。\n堂阴岑寂常如夜，殿角清凉不见风。\n才得浮云閒半日，明朝马迹又西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖","author":"胡仲弓","text":"独坐过湖船，凉生欲暮天。\n鸥眠汀草乱，鱼跃浪花圆。\n足迹烟霞外，吟声风月边。\n万缘无所欠，只欠买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖边","author":"胡仲弓","text":"乍过黄梅雨，湖边物色饶。\n水深宜鸟浴，藻密碍鱼跳。\n露重荷倾盖，风高柳折腰。\n道人勤借问，此地好渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答青山阁见寄","author":"胡仲弓","text":"诗人无俗事，侵晓访僧居。\n山近市声远，楼空松影虚。\n耕云虽有地，种药恐无锄。\n但学观心法，何须课佛书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答晚香","author":"胡仲弓","text":"一巢如燕寄，来傍主人居。\n著脚须教实，图名却是虚。\n髭因吟尽摘，愁遣酒能锄。\n乾鹊檐前报，天边有吉书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答颐斋并呈诸友","author":"胡仲弓","text":"阴晴千古事，落在醉吟中。\n佳句何人续，清樽此日同。\n幕天浮大白，绣地缬残红。\n江上峰如旧，湘灵曲未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]