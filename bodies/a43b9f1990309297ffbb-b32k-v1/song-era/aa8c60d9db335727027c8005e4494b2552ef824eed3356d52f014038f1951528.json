[{"title":"偈颂二百零五首 其六十一","author":"释正觉","text":"灵云却解见桃华，老眼如今冷淡些。\n拈却面前案山子，柱门路直不横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七八","author":"释正觉","text":"吃粥了，洗钵去，法尔圆成正规矩。\n可怜叶氏怕真龙，却怪谢郎欺猛虎。\n本常路，真实语，这僧且问如何悟。\n从来鼻孔大头垂，不用安排兮自著处所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十四","author":"释正觉","text":"巢知风，穴知雨。\n不用安排，自成规矩。\n历历靡缘，閒閒何偶。\n乐哉林鸟渊鱼，一笑相忘尔汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○二","author":"释正觉","text":"演出一大藏，明明超过诸缘上。\n随曲随直也流水转山，随高随下也虚舟驾浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九二","author":"释正觉","text":"释迦自是释迦，然灯莫要添些。\n不用烧钱引鬼，何须勾贼破家。\n你那里针劄不入，我这里石上栽华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○○","author":"释正觉","text":"宿雨洗去山面尘，东君料理山家春。\n浩劫壶中勿新岁，枯木岩前有古人。\n寒暑不到以法界为处，齿发不老以虚空为身。\n坐间默有相传意，川上乾无逝去津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十三","author":"释正觉","text":"几许欢心几许愁，好看野老两眉头。\n家风平贴清如镜，水瘦山空一样秋。\n手段通变，身心自由，不怕风涛雪拥舟。\n海上三山颓一掣，六鳌连落上金钩。\n华岳连天秀，黄河辊底流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十四","author":"释正觉","text":"不居功，不合伴，脱体其间过一遍。\n梦觉船浮明月波，眼寒雪拥芦华岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十一","author":"释正觉","text":"爱结成身，想澄成界，从此漂流生死海。\n照彻灵源湛不浑，方知幻泡同无碍。\n六门气秋，四大缘坏，了了一真常自在。\n明月混融兮雪芦眼迷，清风相送兮夜船归快。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四三","author":"释正觉","text":"世梦短，劫壶宽，底人退步里头看。\n豹变文而雾重，龙不卧而潭寒。\n欲使人人双眼冷，要须先沥髑髅乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十二","author":"释正觉","text":"灵机未动，道环先入。\n极理也妙得穷通，顺事也聊分借借。\n无象无私，何固何必。\n娟娟印水之月魂，冉冉在华之春律。\n巍巍堂堂兮炜炜煌煌，三千大千兮周行独立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一三","author":"释正觉","text":"世尊无说说，迦叶不闻闻。\n默默到时良自庆，家山元在白云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三一","author":"释正觉","text":"道契如如，非有非无。\n静也神之在谷，应也像之在珠。\n了无所住，照不失虚，无影杖子两人扶。\n清华临于至鉴，深密守于元枢，机轮文彩妙穷初。\n霁色廓澄兮秋怀月满，秀棱重叠兮云卷山癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十七","author":"释正觉","text":"忒团圞，不相瞒。\n冬不寒，腊下看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十九","author":"释正觉","text":"不习禅，不论义，铺个破席日里睡。\n想料上方兜率天，也无如此日炙背。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十一","author":"释正觉","text":"玉麒麟，铁昆仑。\n金绳在渠手，归步月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七七","author":"释正觉","text":"清净性空水，光明法界身。\n依俙辨白处，便是诞生人。\n不洗体，不洗尘，妙触宣明悟水因。\n借问当年向去事，如何今日却来亲。\n二千年前此时候，指天指地师子吼。\n云门居乱思太平，打杀不妨将喂狗。\n指东话西，将无作有。\n恶水泼君君莫嗔，而今看你如何受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八三","author":"释正觉","text":"作么生行，履得十成，去功业力争英雄。\n刘项时，将太平。\n坐亨朴懋，羲轩世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○六","author":"释正觉","text":"若于一切法上通，身去亦是有所得。\n若于一切用处豁，落去亦是有所得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十一","author":"释正觉","text":"你也住，我也住，十方三世一时捏。\n聚月醉云酣离水犀，转身触倒珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九○","author":"释正觉","text":"无人接得渠，贵逼马相如。\n果来桥上也，记得柱头书。\n无人识得渠，棋局醉樵夫。\n回头斧柯烂，大海一成枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二五","author":"释正觉","text":"唯心唯识，平出平入。\n金刀之齐，玉尺之直。\n你唤甚么作三界，真个不曾遗颗粒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十九","author":"释正觉","text":"檐头雨滴声，问你要惺惺。\n直下成己事，途中作主盟。\n刹刹见佛，尘尘出经。\n擘开华岳连天色，放出黄河到海声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十三","author":"释正觉","text":"露，超宗越祖。\n人言渠爇返魂香，我道伊挝涂毒鼓。\n苦苦，更若咬文嚼字，规行矩步。\n上唱下随，前瞻后顾。\n张三裹帽新有钱，富汉不是恁么做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十","author":"释正觉","text":"五月五日天中节，百草头上看生杀。\n甘草黄连自苦甜，人参附子分寒热。\n薰莸难昧双垂爪，滋味那瞒初偃月。\n圆明了知心念閒，摩诃迦叶能分别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六○","author":"释正觉","text":"难难难是遣情难，情尽圆明一颗寒。\n大法眼，不相谩。\n面前不破案山碍，直下无津识浪乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八二","author":"释正觉","text":"却请和尚道，三世诸佛也靠倒。\n释迦师，净名老，毗耶摩竭心相照。\n倦鹤夜移巢，灵蛇寒入草，正偏转侧兮妙圆兼到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十七","author":"释正觉","text":"肉团无主，空劫有家。\n清白十分活计，丕平一段生涯。\n月户风高兮云凝古路，星河浪静兮夜泛灵槎。\n唯心成万法，化佛现千华。\n快须拽鼻回香象，切忌当头触死蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十八","author":"释正觉","text":"眼里拈却翳，空中那有华。\n路不拾遗君子事，民无侵扰太平家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十三","author":"释正觉","text":"人平不语，水平不流。\n风定华犹落，鸟啼山更幽。\n只么天真无少剩，莫于里许著丝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一九","author":"释正觉","text":"一人之父，百王之师。\n道机有馀兮，动若四时。\n寿域无疆兮，量同二仪。\n大功不宰，至化无为。\n妙兮虽喻，智也不知。\n权挂垢衣云是佛，却装珍御复名谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十六","author":"释正觉","text":"身非尘聚，卓卓妙存。\n心非情缘，冥冥独尊。\n其体也出诸障碍，其用也得大自在。\n无去无来，非显非晦。\n应色应声，亡对亡待。\n馒头胡饼观世音，还我当行家卖买。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六四","author":"释正觉","text":"玉壶著脚四围宽，妙处其中转侧看。\n顾鉴功忘鼻孔直，津流识尽髑髅乾。\n夜横河汉白，霜洗斗牛寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二一","author":"释正觉","text":"寒林濡露，明月濯波。\n时节恁么，衲僧如何。\n廓一念不见有自，极十方不见有它。\n遍界通身无背面，莫教丝绪落机梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九八","author":"释正觉","text":"一著能回一局棋，仙即妙处只些儿。\n点开活眼分生杀，不作穷忙死马医。\n倒却门前刹竿著，一把推出谁藏缩。\n工夫磨琢老成人，圆陀陀地无棱角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六二","author":"释正觉","text":"只者便是，非像非镜。\n谁主谁宾，何偏何正。\n缝罅莫我欺无孔之槌，锱铢莫我定无星之秤。\n聊将柱杖搅沧溟，令彼鱼龙知水为命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十五","author":"释正觉","text":"不可得而有，不可得而无。\n寂寂十方坐断，寥寥一境清虚。\n妍丑那能瞒净镜，青黄莫我染明珠。\n刹海不能关锁月，夜来流影在珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六","author":"释正觉","text":"溶溶曳曳山上云，潺潺湲湲山下水。\n试问其间云水人，更于何处求诸己。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十二","author":"释正觉","text":"春雨洗园林，春风动帘箔。\n百城人已归，弹指开楼阁。\n入门俱是佛家风，帝网光明相映夺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五三","author":"释正觉","text":"默默相投时节，灯灯不断光明。\n其间著脚浑无地，望尽玉壶连底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一○","author":"释正觉","text":"百草头上平生事，闹市门前百亿身。\n及尽如许闲影响，体明空劫那边人。\n那边人，何所有，白云断处青山秀。\n绝他缘，唯自守，结夏须教醭生口。\n有说便是野干鸣，无说自然师子吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○四","author":"释正觉","text":"莺弄歌喉华弄妍，如许春事在门前。\n道冲而用亡机者，买尽风流不著钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○九","author":"释正觉","text":"岭头功德眼，倦足等闲垂。\n红炉一点雪，直下廓亡依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二九","author":"释正觉","text":"功勋消，阶级尽。\n尊贵不知名，威严莫得近。\n子退步而就父，臣转身以合君。\n机转玉轮侧，妙叶正当风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十九","author":"释正觉","text":"夤缘心，和合相，傀儡棚头呈伎俩。\n打破画屏归去来，家山田地还清旷。\n扫断情尘，沥乾识浪。\n虚明游践兮风月一壶，梦冷转身兮雪云万丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四○","author":"释正觉","text":"净不涉缘，照不对物。\n用无去来之相，混无彼我之心。\n稳稳密密，玲玲珑珑。\n宛转虚玄事不彰，明暗只在影中圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五八","author":"释正觉","text":"百城游遍，遍诣文殊。\n不见其身，唯摩其顶。\n老眼就看青嶂骨，败鞋行到白云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五四","author":"释正觉","text":"句里明宗则易，宗中辨的则难。\n也须是到个时节，始得色转不见身。\n功亡不知位。\n绝怜大匠一斲泥，不犯祖师三尺鼻。\n儿孙去后阿谁共守清贫，臣庶退时独自难称尊贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○一","author":"释正觉","text":"生灭夤缘不著人，一年才尽又逢春。\n森罗借得为他用，法界浑仑是我身。\n不受杂毒，自然纯真。\n拈却千差亡彼此，打成一片没根尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十四","author":"释正觉","text":"青山不用白云朝，白云不用青山管。\n云常在山山在云，青山自闲云自缓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○七","author":"释正觉","text":"心心智通，佛佛道同。\n十方圆满，八面玲珑。\n施时也三乘教备，坐处也一切法空。\n应供而来有不受之受，度世而出得无功之功。\n动而常静，用时弥冲。\n处处不乖兮水中夜月，物物斯应兮华上春风。\n因缘和合而生，生不可生生。\n影生于形，响生于声。\n森罗万像从峥嵘，虚空廓落无亏盈。\n杳杳冥冥，灵灵明明。\n是其中之精，非其外之情。\n见本家旷古之佛，得自己广大之经。\n湛兮若存无迹像，善恶不我相随行。\n物物现成观自在，人人具足常不轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十六","author":"释正觉","text":"鉴像谷神，云心月影。\n閒閒不宰于功，历历无私于应。\n莫问正偏，谁论动静。\n自方自圆，谁欠谁剩。\n能来异类中行，常处那伽大定。\n云水丛林自恣人，果如是也须相庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十四","author":"释正觉","text":"大而无外，小而无内。\n合虚空而无欠无馀，混万象而成团成块。\n不出不在，不失不坏。\n我不与物争，物不为我碍。\n路逢达道人，不将语默对。\n三千界里放光明，双六盘中休喝彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八五","author":"释正觉","text":"不得讳，有头底。\n当时你带累别人，而今别人带累你。\n来生我家，作业相似，针线穿联细中细。\n迦叶阿难不相知，人人各自住三昧。\n里许转功勋，这边得游戏，到底还须彻根蒂。\n望断冥鸿没处秋，苍苍一色天连水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一七","author":"释正觉","text":"端公问处来，径直勿迂回。\n善财处处逢弥勒，弹指作声楼阁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八○","author":"释正觉","text":"一色是须转，大功不我居，珠走碧盘盘走珠。\n直下沧溟取明月，吾家自有昆崙奴。\n天宇豁空云卷雨，溪容澄澈水怀秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七二","author":"释正觉","text":"一头白发几回春，方信闲身似痴人。\n直下放教平稳去，更将何法作根尘。\n法无根尘，心无向背。\n心无向背，道合自然。\n道合自然也，日日好日，年年好年。\n东君刀尺裁华木，付与过头杖子禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四八","author":"释正觉","text":"差之毫釐，失之千里。\n会也打草惊蛇，不会也烧钱引鬼。\n荒田不拣老俱胝，只今信手拈来底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十五","author":"释正觉","text":"心心相印，叶叶联芳，自己光明不覆藏。\n刹刹尘尘如是说，广长舌相解敷扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三八","author":"释正觉","text":"岁朝坐禅，万事自然。\n心心绝待，佛佛现前。\n清白十分江上雪，谢郎满意钓渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十九","author":"释正觉","text":"一雨一晴，盖载生成。\n桃华濯锦而丽，杨柳弄风而轻。\n决决野泉发响，关关林鸟和鸣。\n历历见闻中得妙，更嫌何处不分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十","author":"释正觉","text":"主中主，须辨取。\n动犯威严，细看规矩。\n贵不可得其名，寿不可穷其数。\n四溟潮落露仙山，万里云开廓天宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○六","author":"释正觉","text":"清彻性空水，圆明净智身。\n个中不洗体，直下了无尘。\n有成佛，有降神。\n有彼岸，有迷津。\n哆哆和和此其始，胶胶缀缀此其因。\n底时节，释迦文，恶水蓦头浇莫嗔。\n何须念彼观音力，自然还著于本人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一","author":"释正觉","text":"阴极而阳生，力穷而位转。\n苍龙退骨而骧，玄豹披雾而变。\n要将三世佛髑髅，穿作数珠子一穿。\n莫道明头暗头，真个日面月面。\n直饶你斗满秤平，也输我卖贵买贱。\n槃里明珠，不拨自转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十五","author":"释正觉","text":"蛇钻不入，鸟飞不度，我道人人在里许。\n三更明月下西山，一阵清霜脱寒树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十六","author":"释正觉","text":"云门老子能施设，胡饼佛祖俱超越。\n哆哆和和两片皮，狤狤獠獠三寸舌。\n不是特地展家风，也非投机应时节。\n生铁铸成无孔锤，忒团圞兮难下楔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]