[{"title":"送任文荐归闽","author":"顾禧","text":"意气深投倾盖时，惜君才大爱君痴。\n应知摩诘诗中画，都是将军画里诗。\n放眼莫嫌吴地窄，探奇偏向禹陵迟。\n片帆千里悬明月，不屡滔滔九曲思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游翠微山看桃","author":"顾禧","text":"梅花才落见桃花，欲问桃源路转赊。\n直上翠微开眼界，饱餐赤饭养心芽。\n句留客屐诗中画，烂漫天真阁外霞。\n面壁老僧曾悟否，山猿已报夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐稚山林出诗见示因书其后","author":"顾禧","text":"论交常忆少年时，耐久如君倍足思。\n金马不移孺子节，石麟肯负志公期。\n经霜傲菊依幽径，漾月修篁种曲池。\n六客衔笺烂似锦，莫嫌野鹤故来迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偕谭子钦惟寅游西樵","author":"顾禧","text":"江西美景闻天下，君上湖亭意若何。\n吞吐晴光千浪暖，卷舒云气两峰多。\n阳春有脚归花柳，芳草无心恋绮罗。\n力倦翻嫌花路浅，振衣再拟一同过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作","author":"顾禧","text":"弹铗复尔尔，登楼向落曛。\n烟深横白鹭，枫老宿彤云。\n松牖寒威入，琳宫远磬闻。\n自然能远俗，无复赋离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作","author":"顾禧","text":"日暮悲笳起，孤衾入梦寒。\n沙飞桐鹊隐，草蔓石鲸残。\n龙战知何极，乌栖转未安。\n幽燕多老将，壮气满桑乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿徐稚山斋中","author":"顾禧","text":"已将夙昔志，抵掌为君陈。\n笳鼓悲吴地，须眉忆汉臣。\n梅花凭夜发，柳色司年新。\n此夕关河客，应输夜卧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀阎安中","author":"顾禧","text":"金门射策尽名贤，谁似江南阎子然。\n白虎谈经知独步，苍松入梦已多年。\n凌云赋笔雄千古，倒峡词源倾百川。\n若忆古人愁绝处，西陵花柳日芊眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野眺 其二","author":"顾禧","text":"一径多幽色，孤云护短扉。\n閒阶竹影瘦，低岸稻花肥。\n委翠秋林晚，伤弓宿鸟稀。\n何时携斗酒，掬水弄清晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野眺 其一","author":"顾禧","text":"遂惬耽幽兴，披襟坐水湾。\n松枯涛不作，鸥澹梦常闲。\n漏月宽樵径，吞星避钓环。\n年来悲局蹐，聊此破愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野眺 其三","author":"顾禧","text":"缓步沿溪曲，幽寻惬赏心。\n散烟依瘦竹，开网活枯鲟。\n短袖仍牵树，秋声半捣砧。\n农谈喧隔岸，不畏世机深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野眺 其四","author":"顾禧","text":"乱世功名易，幽人愧素餐。\n草深迷乳兔，弓燥泣飞鸾。\n燐火排窗入，溪声带雨寒。\n行吟殊足乐，回首羡弹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答谭子钦惟寅","author":"顾禧","text":"束发鄙章句，清狂天下闻。\n戋戋招隐赋，草草送穷文。\n扪虱轻王猛，驱车揖范云。\n皇家疏结网，麟凤自为群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩小峨嵋","author":"顾禧","text":"偶上峨嵋岭，悠然对夕曛。\n孤峰擎落日，古殿宿寒云。\n石暗松涛作，天空鹤唳闻。\n幽寻惬素抱，世态自纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠行省任古","author":"顾禧","text":"帝廷咨牧拥金瓯，南顾应宽万里忧。\n自是书屏多异绩，何劳仰屋叹无筹。\n六桥垂柳萦苍佩，三竺飞花拂翠裘。\n遥望云山千里隔，福星欣照□□楼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠洪善庆兴祖和壁閒沈□□韵","author":"顾禧","text":"高卧烟萝饮上池，姓名独许古人知。\n我来欲补洪家传，入坐先寻沈约诗。\n舒卷閒云看不厌，参差玉蝶放偏迟。\n殷勤送客过方井，古道真堪照一时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠蓼庵上人","author":"顾禧","text":"曲径通禅室，藜床独著书。\n玄心栖物外，高论接皇初。\n雨过苔退淡，窗虚梅影疏。\n年年愁作客，为尔一停车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠谭子钦惟寅","author":"顾禧","text":"临风长忆听涛吟，携铗重来感慨深。\n白首如新交自古，丹砂欲就老偏侵。\n猎微阁上传佳句，宿影亭前话夙心。\n花萼虽零月正朗，斗中元气待君斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小春词","author":"顾禧","text":"玉霜斜舞桐枝湿，析木荧荧石鲸泣。\n芙蓉子夜卸秾妆，药雨纷糅琼饮急。\n琼楼玉宇微寒生，氤氲暖气出元英。\n白鹿观中香粉散，灵女祠前箫鼓鸣。\n木奴千树绽浓绿，太济粼粼黑鸟浴。\n真腊灯光射紫薇，汉宫齐唱凤来时。\n彩虹不逐天驷流，公子初成狐腋裘。\n尚衣日日颁红锦，挟纩犹深边士愁。\n五凤习习起兰泽，龙篆新盘大府历。\n黍臛松醪次第陈，野老欣然爱冬日。\n暖炉高会乐未央，鸿雁南飞百草黄。\n东君欲逗春消息，独遣桃花斗橘阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感","author":"顾禧","text":"不与渔樵狎，宁知世事非。\n功成枯战骨，发端误儒衣。\n风雨槐阴梦，仓黄斗柄微。\n东邻瓜正熟，把酒裛清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑行","author":"顾禧","text":"男耕女蚕治有馀，使君何不思。\n使君策马城南隅，妾归深阁缫新丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑行","author":"顾禧","text":"蚕者不得衣，不蚕者得衣。\n长安富贵家，上锦下襦，作苦不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑行","author":"顾禧","text":"日高高，蚕蠕蠕。\n蚕能衣被天下，不遑自保其躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑行","author":"顾禧","text":"罗敷深闺女，出入有常仪。\n何为乎度陌越阡，执筐踌躇。\n执筐而踌躇，夫婿虽真，岂能不蚕而衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪善庆兴祖偕访升上人即景次韵","author":"顾禧","text":"地僻僧栖隐，茆庵曲径通。\n云浮秋水白，霞夺蓼花红。\n野鸟当窗下，疏烟入画中。\n采菱人未散，归棹且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠秋","author":"顾禧","text":"春风荡漾花如织，排摈深岩天地窄。\n桃李芳菲斗艳阳，嫣痕尽染胭脂色。\n含丹欲吐娇不胜，獭髓遥分点琼额。\n杨妃睡足口无语，嫁作游丝怨风雨。\n花神泣罢还欲诉，不愿柔枝荐繁市。\n愿得常亲君子傍，秋深静绾紫绡妆。\n孤桐独立擎素月，芙蕖零落无辉光。\n瑶枝重整临秋水，蓼蒲历历羞无香。\n赏心况有双凫仙，琴声夜夜醉婵娟。\n碧霞觞泛海棠醉，曲栏丽影何蹁跹。\n君不见南朝百里花无数，郁郁纷纷吐烟雾。\n载岁无人禁采樵，丹干琼姿尽摧仆。\n兰蕙当门动见锄，草间惟叹璇霓卧。\n兹花胜植瀛蕊苑，一承顾盼犹未晚。\n冉冉临窗如有心，嬛舞清歌乐事远。\n蔓露凝霜色倍妍，夔州何独无诗篇。\n兹花有诗便不朽，吁嗟托根良不偶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"震泽行","author":"顾禧","text":"襟吴控越莽无幅，银涛漂磕青山蹙。\n水底隆隆晴亦雷，鲸鲵凭之鸠提取族。\n大者为蛟小为蛤，吐光便欲凌日月。\n地纬夜拆霜镜枯，触山飞沫天地白。\n芳饵频施巧不吞，云输雾委长儿孙。\n撼岳吞舟逞大力，日月已坠爝火尊。\n昨闻渔人谋其曹，整罩施网瀰江皋。\n药程倾湖湖不流，涸智殚技将安逃。\n蛟子虾孙泣如雨，沈虎泅鹿惨无语。\n吁嗟河伯灵何存，鸣鼓聚市遂若此。\n就中大鱼最有神，夜入深宫控紫宸。\n竭泽而来拂帝意，浩荡乾坤雨露新。\n千秋万岁颂乃公，鳄鲸无所施其雄。\n延津灌莽饮大泽，鱼安于下鸟翔空。\n君不见然犀烧燕水族寒，咫尺之水多危澜。\n活女诲女恩无极，枯鱼何事泣河干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑行","author":"顾禧","text":"三府三起，作苦何辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元符二年二月七日按部过邛州火井县三友堂小酌杨公天隐尝令此邑令此邑以山水竹为三友余益以风月为五贤云","author":"顿起","text":"七盘一何高，苍翠净寥廓。\n夜雨濯杉桧，春风散芝药。\n细云散岩色，细径度危笮。\n邑改井已泥，空馀汉城郭。\n土瘠漫生茶，人稀时走玃。\n苔藓囹圄空，尘埃簿书閤。\n县圃何萧条，半樱半零落。\n偃蹇大夫松，委蛇君子鹤。\n试登三友堂，借问何人作。\n皆云杨先生，好诗心淡泊。\n乘兴山水间，此君共献酢。\n琅玕无俗韵，仁智有真乐。\n取友信可人，自待宜不薄。\n我来宴坐久，寂寥无唯诺。\n明月来徘徊，清风自萧索。\n因留风与月，相对成清酌。\n蟾光照金尊，馀辉射杯酒。\n轻飔入朱弦，彷佛奏箫勺。\n醺然造忘形，神交通博约。\n醉号五贤堂，醒来资一噱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠广都寓舍贤妇二喻诗","author":"顿起","text":"尝闻赵清献，恤孤慰亡友。\n至今西蜀人，谈美不容口。\n二喻出儒家，清贫一无有。\n零丁依老姑，破屋僧堂后。\n相对诵诗书，未尝窥户牖。\n圭折玉弥方，山寒松更茂。\n县宰初闻名，咨嗟为之久。\n从容语其配，夫人曾见否。\n长者二十三，次亦十八九。\n青裾长蔽膝，荆簪短在首。\n我欲效清献，言不为人取。\n近于吾邑中，选婿得豪右。\n夫人相宰意，鱼蔬荐樽酒。\n屈致二喻来，呼名老与寿。\n女子当有行，诗称远父母。\n饥寒日月长，蓬荜风雨漏。\n大喻前致词，洒泪湿衣袖。\n荷德固已深，缄情亦须剖。\n上言亲未葬，心欲土自负。\n下述妹未笄，??无傅姆。\n还家复献书，自叙贫且陋。\n铅华世所悦，铜臭非吾偶。\n肯效闾闬间，碌碌逐鸡狗。\n世无梁伯鸾，应嫌孟光丑。\n孔明若再生，承女甘箕帚。\n陈义一何高，夫人惊拊手。\n至今书稿在，光辉射星斗。\n董子慕高风，喜曰真吾妇。\n吾亲双白发，吾弟室未授。\n眷言姊妹贤，可以相先后。\n五两币虽轻，意则千金厚。\n辎轩双造门，观者竞奔走。\n女子尚能尔，男儿宜自守。\n重聘或不来，岂欲终畎亩。\n畜德尚未充，高位亦虚受。\n寄语事君者，慎勿轻去就。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"高之美","text":"四郡甘棠清到底，一枝丹桂庆流芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题碧落洞","author":"高卫","text":"翠窦连空跂可攀，飞仙时下五云端。\n公车不暇频游此，今日才来可谓难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 庆朱察推","author":"高子芳","text":"葱葱佳气，人都道、今日垂弧令旦。\n怪得欢声如鼎沸，准拟华堂开宴。\n三虎容仪，二乔态度，争捧金杯劝。\n瑶池王母，何妨引领仙眷。\n况有道骨仙风，灵丹秘诀，钟鼎何心恋。\n却笑玉阶轩冕客，难脱功名羁绊。\n萧散陶篱，徜徉裴野，风月堪为伴。\n拳拳祝颂，寿龄期等龟算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 寿夫人","author":"高子芳","text":"去年曾祝夫人寿。\n今岁也又还依旧。\n鬓绿与颜朱。\n神仙想不如。\n骨相真难老。\n疑是居蓬岛。\n那更舞霓裳。\n笙歌溢画堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙池","author":"高子洪","text":"九朵芙蓉天琢开，烟霞静处翠成堆。\n鹿衔花向林边过，龙带云从树杪来。\n最爱山中閒日月，何须海上访蓬莱。\n翛然自觉清风爽，直欲临风翘上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"讲教洞","author":"高予文","text":"一官羁绊混黄埃，壮抱雄怀久未开。\n我若有山如此好，挂冠即日赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题凤林桥","author":"高仁邱","text":"一道长虹跨北河，往来凭此涉清波。\n帆从宝相丛中度，人向金鳌顶上过。\n此日高车题字少，昔年驱石叙功多。\n凤凰已去无遗响，只此江鸥答棹歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小晦岭","author":"高元之","text":"路自崎岖心自平，云扃无锁但徐行。\n松风石溜含悲怨，中有樵夫度岭声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪窦寺","author":"高元之","text":"雪窦深云处，相携到乳泉。\n沙田春事晚，山寺野花妍。\n香饭饥南烛，丹房记景天。\n仙居应六八，更欲上风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大小晦山","author":"高元之","text":"大晦出小晦，过尽山峰翠。\n寒云抱幽石，枯卉老壖濑。\n沿流路偪侧，当道屋破碎。\n却立重回首，瀑布泻云背。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长汀即事","author":"高元之","text":"杨花剩得晴方好，榆荚其如世上贫。\n花向喜中看更好，分明春色解欺人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题雪窦飞雪亭","author":"高元之","text":"危亭上拂烟雾光，苍崖深到蛟螭穴。\n天河飞来破山翠，寒入疏林风自发。\n翻珠错玉无时歇，岩前散作千秋雪。\n寒声萧萧凛毛发，白云朵朵翔空灭。\n飞流溅沫入毫端，天与一诗为题绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"高元之","text":"洒窗蚕食叶，入竹蟹行沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"高元矩","text":"鸟掠琴弦穿静院，吏收诗草下閒庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴中羊肉价高有感","author":"高公泗","text":"平江九百一斤羊，俸薄如何敢买尝。\n只把鱼虾充两膳，肚皮今作小池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡塾讲中庸第二章","author":"高公泗","text":"滔滔逝者若斯夫，不有耆儒孰共扶。\n昭揭五条皆达道，由来一本不殊途。\n圣经奥义难穷尽，老笔名言妙写模。\n我欲研朱同看易，先生肯往此中无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"港口野步怀归","author":"高公泗","text":"天宇空青晚更佳，溪头滑石路攲斜。\n山深苦竹方抽笋，日暖甘菘始放花。\n莎草墙垣沾燕屎，棘针篱落聚蚕沙。\n预知半夏当归去，栀子开时应到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵江朝宗梅花 其一","author":"高文虎","text":"新新数点照疏篱，又折今生第一枝。\n只为知心无著处，雪中独立最多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵江朝宗梅花 其二","author":"高文虎","text":"踏雪归来水路长，亲曾相见白云乡。\n风来风去都无那，分付行人一点香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪馆山茶","author":"高文虎","text":"江南嘉木蔚苍苍，能与山梅次第芳。\n叶厚耐擎三寸雪，飞初怯受一番霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人海棠","author":"高文虎","text":"富贵天姿锦里人，高华全比玉堂臣。\n绿娇红嫩精神是，肯折园林两树春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"集高亭","author":"高文虎","text":"山亭十月晏温朝，倚槛一声婆饼焦。\n舌涩力微寒气早，不成清亮却成娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞香花","author":"高文虎","text":"云岑深处独翘翘，香逐吴山一梦销。\n味入禅心清透澈，锦熏篝暖不容招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水仙","author":"高文虎","text":"朝朝暮暮泣阳台，愁绝冰魂水一杯。\n巫峡云深迷昨梦，潇湘雪重写馀哀。\n菊如相得无先意，梅亦倾心敢后开。\n恼彻会心黄太史，他花从此不须栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和曾原伯寄超化举长老","author":"高文虎","text":"文声宫祉韵鸾和，素履冰霜凛节柯。\n鹏翼扶摇惊斥鴳，凤翔寥廓舞灵鹅。\n参玄问学渊源远，友许游从日月多。\n谁袖新篇来古剡，夜寒不觉耸肩哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾花","author":"高文虎","text":"羽盖珠幡上下蒙，倚栏碧动舞蛟龙。\n谁怜澹素朝天面，自现光明满月容。\n杨柳风柔沾絮湿，蔷薇露重染衣浓。\n典型犹带醺酣力，酝得馀春百倍醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨少云桂花","author":"高文虎","text":"溶溶漠漠秋光淡，耿耿寥寥夜色清。\n不是灵根函爽气，如何酝得此香成。\n玉兔捣霜千万粒，凄风折作四花凝。\n广寒惯识朝真趣，一笑秋空意欲凌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种菊","author":"高文虎","text":"菊载种农经，不见诗三百。\n周官叙鞠衣，一言仅可摘。\n黄华纪吕令，落英餐楚客。\n伯始饮得寿，桐君书探赜。\n移根候萌动，需时当甲拆。\n我羡柴桑里，敢希履道宅。\n不种儿女花，朱朱与白白。\n阅谱品虽多，求栽地恐窄。\n揠苗助其长，抱瓮溉以泽。\n朗咏黄为正，流播风传格。\n寒香紫茁兰，晚节铜柯柏。\n相继早梅芳，一笑巡檐索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送台倅赵叔明趋朝","author":"高文虎","text":"羲轮正弭节，别驾忽扬鞭。\n游从亦雨暑，朋盍知何年。\n欲叙情缱绻，难得形周旋。\n谱系玉为牒，辉华珠在渊。\n汉家子骏才，今世德麟贤。\n荐倅丹丘地，平分刺史天。\n婉画迈前辈，阴功培后缘。\n人或得其一，君亦几于全。\n微凉起天末，触热趋日边。\n石桥礼尊者，琼台访遗仙。\n高张天姥盖，稳泛雪溪船。\n稽山万塍稻，镜湖千顷莲。\n行庖击小鲜，触境乱鸣蝉。\n应酬图画中，怀想冕旒前。\n早渡月千里，晴帆风一川。\n清都郁佳气，绛阙锁祥烟。\n放朝上閤后，投谒岩廊先。\n诸公竞罗致，百辟会班联。\n托契荷倾盖，为僚因赘员。\n犹凭六六鱼，寄问我沈绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"红梅花","author":"高似孙","text":"带雪匆匆别楚云，天寒依约见湘君。\n只疑不合瑶池去，引得春风八九分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日","author":"高氏","text":"雁已有归心，雪深春未深。\n花风才一信，人日故多阴。\n诗作平生梦，香添昨夜衾。\n不干书册事，自怕薄愁侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]