[{"title":"答陜府春卿资政","author":"韩琦","text":"蓬山曾许挹浮邱，踰纪光阴一瞬休。\n朔塞风霜人易老，申湖歌舞景长留。\n我临宾席频先醉，君对仙棋几自讴。\n千里诗来还感旧，不堪斜日凭边楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答","author":"韩琦","text":"一从西北困边尘，瀛馆仙游更莫亲。\n只惯弯弧挥太白，几曾横槊赋青春。\n晴郊按猎长侵暮，夜橐飞邮不待晨。\n多羡某棠阒无讼，时将佳句恼粗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题览胜亭","author":"韩琦","text":"极目知何胜，东西矗万岑。\n天虽限夷夏，人自失喉襟。\n远木已秋色，乱云犹夕阴。\n清风谁会我，太息抚霜镡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题养真亭","author":"韩琦","text":"新葺公居北，虚亭号养真。\n所期清策虑，不是爱精神。\n满目林壑趣，一心忠义身。\n吏民还解否，吾岂苟安人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和致政王子融侍郎归休述怀二首 其一","author":"韩琦","text":"周旋通显竭忠勤，勇退翩然得谢身。\n鸣玉乍辞天上贵，挥金长示里中仁。\n满床黄卷閒为伴，一枕清眠任过晨。\n六十九归今昔少，万年青史纪高人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和致政王子融侍郎归休述怀二首 其二","author":"韩琦","text":"礼称七十还君事，岂必如期许退身。\n臣子引年虽审分，朝廷图旧合推仁。\n晓登文石方延刻，暮挂危冠不待晨。\n窃惜圣神求治意，未宜轻去老成人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和真定李侍郎新创流杯","author":"韩琦","text":"不有浮觞乐，谁知爱客深。\n投醪当席意，修禊昔贤心。\n自至疑仙术，虚来协道襟。\n去留虽任物，斟酌孰窥阴。\n阻挹斋中酒，空劳塞上吟。\n清潭时一望，搔首莫能簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和机宜陈荐请游城北池馆二首 其一","author":"韩琦","text":"只恨无才济阻饥，北塘因尔失春期。\n民心方喜稻禾熟，秋色不关台榭隳。\n一派芰连输水鸟，几船烟雨卧风旗。\n佳辰赖有诗人觉，较得红芳又变衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和机宜陈荐请游城北池馆二首 其二","author":"韩琦","text":"去岁饥流待抚循，日忧疲瘵苦伤神。\n细民沟壑方援手，别馆莺花任送春。\n举目山河生壮气，经时台榭极芳尘。\n秋来幸有丰年兆，还作偷安乐事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕二首 其一","author":"韩琦","text":"大暑丧馀酷，凉秋袪众瘥。\n歊氛随雨断，素景入宵多。\n雁影穿池月，蛩声出砌莎。\n披襟予自快，楚泽任悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕二首 其二","author":"韩琦","text":"此夕何清旷，新秋乍夺炎。\n凉飙来似旧，熏暑逝如潜。\n露重翻香芰，疏云点素蟾。\n放怀殊不寤，箕斗转前檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日出郊","author":"韩琦","text":"疆野压雄边，乘秋行此田。\n万峰朝巨岳，多稼入平天。\n农饱忘饥后，童嬉逼社前。\n僚贤须共乐，举白尽歌筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月","author":"韩琦","text":"清商才过半，皓魄最宜圆。\n自是秋光好，非缘人意偏。\n一宵歌吹地，万里雪霜天。\n忍见西楼下，佳期又隔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙恩加职寄馀杭希文资政","author":"韩琦","text":"燕石宁参楚璧珍，六膺君桨共言纶。\n老聃道大谁同传，千古韩非是罪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九次韵答真定李密学","author":"韩琦","text":"琴瑟烦更化，椒兰喜望邻。\n致仪惭蚁酬，申好忝莩亲。\n惜此登高节，难偕逐胜宾。\n遥知潭上酌，多少插花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政宫保杜公","author":"韩琦","text":"无劳迁职此何名，只有惭羞敢自荣。\n抚俗未能宣上意，治边徒欲振天声。\n邱山莫副推恩重，铢两唯忧效死轻。\n高句不须期任旧，已求三载奏官成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依前韵再答","author":"韩琦","text":"不与皇家致太平，康宁时节便遗荣。\n寰中自乐乔彭寿，海内空流邴魏声。\n一品坐来恩固重，万钟抛去禄何轻。\n朝廷欲继姬周盛，会向磻溪问老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送省副崔刑部","author":"韩琦","text":"此去参邦计，时才固异伦。\n富民知有道，言利不违仁。\n馀帐无情日，归途适意春。\n前期对清问，牺阁近槐宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪","author":"韩琦","text":"六花来应腊，望岁一开颜。\n歌舞喧侯第，风沙杂戍关。\n馀芳留草树，清兴入江山。\n后夜高楼月，萧然昆阆间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发白有感","author":"韩琦","text":"区区边朔有何成，三失流年只自惊。\n无一事来头尚白，白人头处岂堪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步后园觉有春色","author":"韩琦","text":"桃李知春意，阳和到嫩萌。\n风霜谁自困，莺蝶始多情。\n终入芳菲赏，休论早晚荣。\n穷边何所负，轰鼓醉金觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北楼望春","author":"韩琦","text":"良畴芳圃汩飞埃，生意颙颙望震雷。\n北岭有云空自绕，几时为雨出山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食","author":"韩琦","text":"塞上逢寒食，郊园此重临。\n一时行乐意，万室欲春心。\n节物随人好，风光得处深。\n只思民尽适，守鬓忘霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感事","author":"韩琦","text":"一来边障地，走马过三秋。\n万绪事常扰，九分春又休。\n莺花谁在目，霜雪只侵头。\n从得风光住，风光可奈忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳北塘席上","author":"韩琦","text":"修禊春塘上，谁知物趣深。\n万花开喜色，众乐出和心。\n雨意随人住，杯情逐胜斟。\n从兹穷塞地，佳节似山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"韩琦","text":"晚雷驱雨协春雩，谁识天工用意殊。\n不许繁花私润泽，独教嘉谷足膏腴。\n群心有答方思报，寸草无求亦自苏。\n始信云龙施美利，岂劳功力费毫铢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北塘春雨","author":"韩琦","text":"叶叶轻云帐薄罗，坐看膏泽洒庭柯。\n风前芳杏红香减，烟外垂杨绿意多。\n声落檐牙飞短瀑，点匀池面起圆波。\n晴来西北凭栏望，拂黛遥峰濯万螺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再谢真定李密学惠牡丹","author":"韩琦","text":"牡丹京洛艳，惠我见新邻。\n一与樽前赏，重生塞上春。\n衰荣存主意，深浅尽天真。\n却似登兰室，清香暗袭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新植花开","author":"韩琦","text":"去岁栽花遍小栏，只忧芳艳不禁寒。\n年来醉赏春风里，无限边人见牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹二首 其一","author":"韩琦","text":"真是群芳主，群芳更孰过。\n艳新知品少，开晚得春多。\n几日瑶姬梦，平生金缕歌。\n寒边今幸活，风雨莫相魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹二首 其二","author":"韩琦","text":"青帝恩偏压众芳，独将奇色宠花王。\n已推天下无双艳，更占人间第一香。\n欲比世终难类取，待开心始觉春长。\n不教四季呈妖丽，造化如何是主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花二首 其一","author":"韩琦","text":"妖艳凭谁主，春光去不停。\n离魂乱飞絮，生意逐浮萍。\n钱荚偷馀态，茵芜袭旧馨。\n年年芳信在，慎勿叹飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花二首 其二","author":"韩琦","text":"一夜残芳泣露痕，晓来红雨点兰荪。\n对人终有风流在，几片斜飞在酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡甫初夏","author":"韩琦","text":"池馆何无赖，青春几日回。\n酒随花谢减，心为水凉开。\n幽鸟闲鸣和，清风自往来。\n峰峦新在目，天与白云裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏暑北塘","author":"韩琦","text":"一夕轻云卷怒雷，回塘经雨绝纤埃。\n莲房倒盏挥人饮，柳幄牵丝待席开。\n未必鸥飞知客意，莫嫌蝉噪是风来。\n歊烦尽涤宜无累，奈有诗情费剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览刘易诗集感其游赏江山放怀自适","author":"韩琦","text":"区区西北十经春，强力今为老病身。\n白发丹心论底事，清风明月属闲人。\n千钧未免嗤鼷鼠，一篑犹思抑孟津。\n早晚粗酬忠国志，五湖烟水乐吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上闻蝉","author":"韩琦","text":"柳际一蝉鸣，停樽忽自惊。\n所伤非节物，未立是功名。\n默默悲时事，区区徇世情。\n不须争噪急，衰鬓旧霜茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和国信赵内翰北口见寄","author":"韩琦","text":"时得不可失，时乎况得天。\n蔓图非易力，鸩毒是安眠。\n庙胜两楹决，壶浆一檄传。\n临关休发咏，归议主当然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题广信军四望亭","author":"韩琦","text":"西北云高拂女墙，危亭虚豁望中长。\n田间堤陌成新险，天外江山是旧疆。\n古道入秋漫黍稷，远坡乘晚下牛羊。\n凭栏多少无言恨，不在归鸿送夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与馀杭希文资政经时两绝音问忽得讯正与近致书同日因以诗寄","author":"韩琦","text":"闰首邮音得到无，使来还喜发双鱼。\n却思塞上经时问，恰是吴中当日书。\n人邈江山神自照，道存忠义信从疏。\n昔年元白慈恩事，诗意虽同志未如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一志","author":"韩琦","text":"一志事边徼，难甘景物催。\n流年花易落，久戍雁频回。\n细叶未成幄，飞蚊还聚雷。\n颠毛从自变，肯使壮心摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其一 牡丹","author":"韩琦","text":"极塞将何奉燕娱，牡丹池馆一株无。\n谁人会我栽培意，欲见吴宫小阵图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其二 芍药","author":"韩琦","text":"从来良守重农桑，何事栽花玷此堂。\n已爱昔贤形藻绘，更移嘉卉伴馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其三 垂柳","author":"韩琦","text":"东君于此最多情，先与黄金撚画成。\n何似亚夫坚壁地，因人千古得嘉名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其四 叠石","author":"韩琦","text":"叠叠云根渍古苔，烟峦随指在庭阶。\n主人未有铭功处，日视崔嵬激壮怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其五 药圃","author":"韩琦","text":"堂下开畦植药苗，更将灵种悉名标。\n吾心尽欲医民病，长得忧民病不销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其六 沟泉","author":"韩琦","text":"遥派分流过近阶，潺潺终日泻琼瑰。\n谁知到此幽闲地，多少馀波润物来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其八 芭蕉","author":"韩琦","text":"边俗稀曾识此科，南方地暖北寒多。\n孤芳莫念违天性，无奈深恩爱育何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答承旨王端明","author":"韩琦","text":"禁扃清切拟仙都，多病年年绝塞居。\n四海风雷归旧笔，二垂霜霰乃吾庐。\n道同今古犹相照，事役鳞鸿不计疏。\n莫谓安恬道留滞，是非终有史臣书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕同末伏会众春园","author":"韩琦","text":"七夕今同末伏辰，方塘陶暑集珍群。\n娇莺万啭风前曲，秀岭千层水上云。\n幽鹭倚蒲真入画，香荷擎酒不须熏。\n天孙莫衒机头巧，倒载归来岂羡君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初秋塘上","author":"韩琦","text":"池塘凉意早，秋色动边关。\n酷暑不终暴，清风来自闲。\n畏螳蝉屡起，辞幕燕将还。\n尽日当轩卧，看云归故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答渭帅王龙图","author":"韩琦","text":"十年西北保疆垂，只恐非才误委毗。\n报国心诚虽慷慨，背时踪迹极孤危。\n欲求褒贬明千古，直把穷通托二仪。\n多谢高篇远相劳，召南风格本王基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览渭帅王龙图西行诗集","author":"韩琦","text":"久陟风骚上将坛，更持旄钺抚边关。\n山川满目吟虽苦，戈甲藏胸意自闲。\n威望昔尝流塞外，雅歌今复奏兵间。\n禁中日夜思颇牧，四牡看随杕杜还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘易归洛","author":"韩琦","text":"满怀经术欲谁传，却忆西归治洛田。\n富贵苟求诚损义，圣贤难遇亦推天。\n春风始入花王国，夜月长涵宓女川。\n岩谷弓旌如未及，且凭诗酒作闲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答侍读张龙图索阅古堂诗石本","author":"韩琦","text":"千年贤迹一堂间，日企英风敢自安。\n争似公陈无逸义，君王图入殿屏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂前植菊二本九月十八日花犹未开因以小诗嘲之","author":"韩琦","text":"只趁重阳选菊栽，当栏殊不及时开。\n风霜日紧犹何待，甚得迎春见识来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北塘重九","author":"韩琦","text":"堪嗤唐彦鄙连疆，不信重阳草木霜。\n樽里有花荷万叶，三年酣赏好风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试猎","author":"韩琦","text":"试猎秋原亦治戎，飘然豪气满秋风。\n饥鹰猘犬争为用，不在人知指纵功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祷雪有感","author":"韩琦","text":"灵岳祠宫尚未回，六花随祷下琼瑰。\n只忧风力狂无定，最喜云容重不开。\n但得馀滋周畎亩，敢求娇意助樽罍。\n夜深犹使家人探，平地依稀几寸来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答留台春卿集贤侍郎","author":"韩琦","text":"闻说西台遂恳章，一何钦耸一何伤。\n赤松世外诚先觉，白首兵间是不祥。\n得失两忘祛病术，利名相贼溺人乡。\n几时微立疆垂效，去伴公闲亦道光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答","author":"韩琦","text":"拙者奔驰智者藏，细论朝体岂无伤。\n苍生困敝谁更化，贤弼优游自考祥。\n四海唐虞终我事，三川风月且吾乡。\n军中不识阳春赠，几按青萍骇夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答","author":"韩琦","text":"久抛儒掖禦戎疆，每忆青毡只自伤。\n马上文章终是俗，胸中戈甲亦非祥。\n哇声误入离韶耳，藻衮轻投被毳乡。\n赖得高贤时借誉，不然幽迹转无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后园闲步","author":"韩琦","text":"池圃足高趣，公馀事少关。\n幽禽声自乐，流水意长闲。\n近竹花终俗，过栏草费删。\n心休谁似我，官府有青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北塘探春","author":"韩琦","text":"大钧将首化，微物亦先知。\n草木色皆得，禽鱼意自怡。\n和风无不到，馀凛欲何为。\n会与斯民乐，熙台兴未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观稼回北园席上","author":"韩琦","text":"郊原飞隼拂晴霓，秋入丰年未惨悽。\n尝酒管弦先社集，捺弮禾黍极云齐。\n雪铺荞麦花漫野，黛抹蔓菁菜满畦。\n区脱狴牢无一事，山翁赢得醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕遇雪席上","author":"韩琦","text":"此夕仙花降羯陀，万灯光里雪花和。\n天心要足良农望，人世常多好事魔。\n云际未应成霢霂，风前疑欲助婆娑。\n阴晴况是民俱乐，无奈嘉宾惜醉何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政杜公小诗见戏","author":"韩琦","text":"塞上区区罄拙勤，回头芳岁已三旬。\n何须更殢中山酒，日日忧边似醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政杜公以迁职惠诗","author":"韩琦","text":"满岁穷边喜未还，飞尘犹拟助高山。\n一年愿借虽惭寇，万里思归却笑班。\n紫塞风烟长冷淡，赤松光景正安闲。\n何时少奉挥金宴，免役劳魂梦寐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种树","author":"韩琦","text":"一守中山四载馀，栽成芳树满郊衢。\n州民如有某棠念，惜取清阴万万株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]