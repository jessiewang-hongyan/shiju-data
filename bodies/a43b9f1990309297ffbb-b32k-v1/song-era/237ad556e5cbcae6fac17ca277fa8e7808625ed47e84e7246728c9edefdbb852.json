[{"title":"洞天穴","author":"李纲","text":"沈沈幽穴閟云烟，玉宇琼楼锁洞天。\n自向壶中飞日月，更于物外起山川。\n刘公隐后今谁继，张湛仙来不记年。\n紫府若容幽客到，诛茅欲卜隐屏前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"换骨岩","author":"李纲","text":"玄化升真十六天，灵仙蝉脱翠岩前。\n金坚玉润留馀骨，密锁烟霞几百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙潭","author":"李纲","text":"百丈清潭合两溪，澄波瑩滑碧琉璃。\n神龙端向潭中睡，何事能容网罟垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"狮子峰","author":"李纲","text":"奇石腾拿竹树苍，奋髯矫首据崇冈。\n山深怪底无豺虎，端畏溪头百兽王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音岩","author":"李纲","text":"铢衣珠珞宝花冠，宴坐翛然山水间。\n应为武夷泉石好，不殊海岸补陀山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兜担石","author":"李纲","text":"仙人戏睹翠蛾眉，空有花馀照夕晖。\n云月娟娟风袅袅，尚疑玉质在帘帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三女石","author":"李纲","text":"粲粲三英傍碧溪，玉肌云鬓晓参差。\n想因巫峡行云日，记得湘江解佩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"学堂岩","author":"李纲","text":"仙官读彻蕊珠篇，几案岩中自寂然。\n昆阆图书藏策府，谁言孤陋解成仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"船场岩","author":"李纲","text":"仙艇何年插翠微，云篷烟棹尚依依。\n凌虚欲鼓天边柁，唤取双龙背负飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸡窠岩","author":"李纲","text":"磔磔天鸡啼晓烟，仙家风景镇芳妍。\n自从彩翼飞仙后，只有遗栖寄岭巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大小藏岩","author":"李纲","text":"玉棺插遍两岩傍，石罅开如小洞房。\n鍊就阳魂归紫府，空馀灵骨此中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙迹石","author":"李纲","text":"当年天姥戏溪边，二石遗踪膝宛然。\n却笑茂陵缑氏迹，只凭方士口中传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大小二廪石","author":"李纲","text":"仙家何事亦赢粮，廪石团团峙道傍。\n应驾斑龙耕紫石，深储芝玉廪中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鼓楼岩","author":"李纲","text":"洞天击鼓集群仙，石作高楼锁翠烟。\n万籁不鸣霜月晓，鼕鼕犹听鼓声传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丹灶","author":"李纲","text":"金鼎丹成透碧天，尚留丹灶在层巅。\n一丸五色光腾夜，乞取从教作散仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙掌","author":"李纲","text":"玉指纤纤烟霭中，挥云映日掌微红。\n只疑华岳留踪后，更向闽山映碧峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三层峰","author":"李纲","text":"三层灵峰气象豪，喷云泄雨不崇朝。\n悬崖峭壁无人到，只恐峰头是碧霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画鹤","author":"李纲","text":"谁画千年老令威，丹青今古照清辉。\n玄裳朱顶苍崖畔，岂忆冲天万里飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅庵岩","author":"李纲","text":"虎啸猿啼月满天，山僧宴坐正安禅。\n不知只履归何处，尚有庵岩名字传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙机岩","author":"李纲","text":"云去仙机杼轴空，报章何日已成功。\n天孙织就烟霞锦，吹落溪山夕照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏王峰","author":"李纲","text":"危峰孤峭与天通，犹有当时羽化踪。\n仙驭自随鸾鹤远，玉楼金锁白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎啸岩","author":"李纲","text":"昔年雕虎啸幽岩，千里清风皱碧潭。\n虎去岩空风自远，一林花雨落毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台石","author":"李纲","text":"钓石峨峨枕碧溪，仙人于此亦垂丝。\n想当月白风清夜，正是寒鱼食饵时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试剑石","author":"李纲","text":"鍊气为金铸剑成，且将顽石试青萍。\n光铓郁郁冲牛斗，斩尽妖魔若发铏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"折笋岩","author":"李纲","text":"玉府锵锵玉笋林，谁将移种翠岩阴。\n斓斑犹带当时箨，照水笼烟几百寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙接石","author":"李纲","text":"天风吹折碧琅玕，神化茫茫接岂难。\n凤髓鸾胶天上有，世人休作等闲看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柴岭","author":"李纲","text":"林花不逐岁寒凋，半岭烟光媚远霄。\n须信仙家风景好，四时峰岫紫岧峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"车钱峰","author":"李纲","text":"尘缘洗尽便神仙，泉石幽奇即洞天。\n我欲云崖结茅屋，侍从天姥借车钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛竹洞","author":"李纲","text":"洞生毛竹绿猗猗，枝干扶疏满洞垂。\n传是群仙游息地，蔽藏不许世人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睎真馆","author":"李纲","text":"小溪诘屈巧萦回，行到睎真景更奇。\n路转山回疑不见，此中凝望却参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙橘","author":"李纲","text":"岩畔阴森橘树垂，青青亦有岁寒姿。\n我来恨在秋风后，不见霜包结实时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙竹","author":"李纲","text":"阴崖翠竹自檀栾，瘦节疏枝特地寒。\n虽未化龙归洞府，正宜和月扫天坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泛舟至睎真馆遇雪 其一","author":"李纲","text":"云散天开一饷中，依前飞雪落层空。\n琼花巧缀岩端树，玉屑飘随洞里风。\n溪浅且游仙掌石，云深不见幔亭峰。\n斯游清绝平生少，图画方知未是工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泛舟至睎真馆遇雪 其二","author":"李纲","text":"行到清溪六曲头，森然峰岫照人幽。\n雪花拂水轻轻舞，石濑依岩浅浅流。\n不尽清光常在目，未穷幽兴且回舟。\n追寻欲遍神仙窟，须向他时卜再游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访李道士 其一","author":"李纲","text":"青山中有一道士，独卧烟霞昼掩扉。\n踏雪叩关知意重，拥炉相与话真机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访李道士 其二","author":"李纲","text":"诛茅独占溪一曲，时有白云来伴宿。\n自言身在此山中，暮暮朝朝看不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪旧梦","author":"李纲","text":"清梦先曾到武夷，玉峰积雪倍幽奇。\n小舟游罢寻归路，恰似翛然梦觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿栖真馆夜雪大作诘旦遂行","author":"李纲","text":"一夜武夷三尺雪，岩壑无声闻竹折。\n云峰烟岫望都迷，玉树瑶林寒更发。\n山中道士毛骨奇，劝我留宿山前斋。\n轻装冒雪非得已，仙赏更待他年来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题栖真馆三十六韵","author":"李纲","text":"武夷古洞天，奇峰三十六。\n一溪贯群山，清浅萦九曲。\n溪边列岩岫，倒影浸寒绿。\n翩如鸾凤翔，矫若虬龙蹙。\n楼观耸岧峣，屏帏互重复。\n蜕仙骨遗金，游女肌削玉。\n鸡栖层岩巅，船插断崖腹。\n学馆存几案，仙机馀杼轴。\n蓝光瑩澄潭，虹影挂飞瀑。\n翠竹荫天池，苍苔封石屋。\n绘禽顶长丹，遗迹指如掬。\n峨峨天柱峰，幔亭连翠麓。\n传闻武夷君，尝此会仙俗。\n飞桥几千丈，绝顶亘山足。\n障以翠云屏，藉以紫霞褥。\n瑶樽倾沆瀣，玉豆脯麟鹿。\n仙妃奏宾云，金鼓间丝竹。\n酒酣歌夕晖，叹息光景促。\n曾孙谁复在，往事空遗躅。\n至今风月夜，笙箫响虚谷。\n地灵饶泉石，山润秀草木。\n坐使七闽人，荫此仙灵福。\n嗟予真散材，性爱山水酷。\n仙经与地志，名字久已熟。\n薄宦方区区，仙赏宜碌碌。\n神游先梦寐，幽觌寄图录。\n宁知因谪宦，乃得厌所欲。\n沿溯穷幽深，应接劳耳目。\n开襟豁怀抱，壮观慰幽独。\n却邀白云归，伴此岩下宿。\n夜寒梦魂清，晓发轻装速。\n仙游须再来，何当谢羁束。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠舅氏吴子和","author":"李纲","text":"契阔从来叹岁阴，幸因谪宦款清襟。\n犯颜逆耳事已往，问舍求田意转深。\n岂有声名惊海宇，且忻山水共登临。\n渭阳情重知何赠，玉佩琼琚称我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自建阳泛舟至建安","author":"李纲","text":"一叶轻舠漾碧流，却怜舟子解操舟。\n急滩乱石疑难渡，短楫轻桡反自由。\n去国飘零同泛梗，凌波超忽逐飞鸥。\n建溪百里才终日，过尽千岩万壑幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建溪再得雪乡人以为宜茶","author":"李纲","text":"闽岭今冬雪再华，清寒芳润最宜茶。\n泛瓯欲斗千金价，著树先开六出花。\n圭璧自须呈瑞质，旗枪未肯放灵芽。\n传闻龙饼先春贡，已到钧天玉帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天宁老齐珏录庆馀师开堂疏见示","author":"李纲","text":"一别闽山三十年，重来相见两依然。\n烦师录示当时语，犹喜曹溪一派传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花二首 其一","author":"李纲","text":"寒梅昨夜泄春光，标格依然压众芳。\n袅袅露枝团玉白，轻轻烟蕊簇金黄。\n瑶妃谪堕溪村寂，雪片飘残月径香。\n却笑汉宫争宠女，竞将娇额学新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花二首 其二","author":"李纲","text":"数枝玉雪小溪滨，先得阳和一点春。\n冷艳幽姿难与并，暗香疏影孰为邻。\n广平不害心如铁，和靖须知句有神。\n亦对寒芳动诗兴，却嫌标格太清真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑浦道中二首 其一","author":"李纲","text":"宿雾霏霏隐翠岚，傍溪幽石自巉岩。\n樵歌递响来危径，渔网连舟集小潭。\n野渡无人閒寂寂，林花著雨落毵毵。\n谁知逐客凄凉意，岁宴南迁剑浦南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑浦道中二首 其二","author":"李纲","text":"此去平津路匪遥，岭云溪雨自萧萧。\n山深泻涧泉长响，地暖凌寒草不凋。\n放逐却教穷水石，登临因得狎渔樵。\n谁怜泽畔人憔悴，更把骚辞赋大招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自建安陆行至剑浦","author":"李纲","text":"闻道延平黯淡滩，舟行至此惨愁颜。\n千金素佩垂堂戒，九折宁辞去路艰。\n涉险虽知凭信义，藏幽须信足神奸。\n劳生自取那惆恨，只羡飞云自在閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑潭","author":"李纲","text":"当时神剑埋丰城，郁郁光气冲斗星。\n千年古狱斸幽扃，下得至宝双青萍。\n雌雄不知谁与名，拭以异土聊发铏。\n龙文星彩愈晶荧，正昼无影魑魅惊。\n雄飞霄汉随雷霆，雌跃渊水归延平。\n没人下瞰风涛生，天矫化作虬龙形。\n茂先博识非无凭，神物终合信有徵。\n沈沈潭影含虚明，宝气久秘必复呈。\n会当探取搜元精，佩服坐能驱百灵。\n奸谀膏血纷膻腥，与尔相携游太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双溪阁","author":"李纲","text":"凌虚高阁枕双溪，四出飞檐鸟翼齐。\n山锁烟光青合匝，水分丁字碧凄迷。\n蟠虬旧化张公剑，翥凤今留鲁国题。\n放逐因能穷胜赏，登临那惜醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沙阳","author":"李纲","text":"沙阳虽僻左，风土冠闽城。\n谁知乱山里，有此膏壤平。\n邑屋号华丽，溪山倍澄明。\n七峰转月色，十里无滩声。\n民俗素康阜，士夫多俊英。\n食饶鱼稻美，荫有松竹清。\n筦库职易办，尘劳念尤轻。\n萧然飘泊迹，忘此羁旅情。\n忽忽岁改律，欣欣木向荣。\n何当脱拘缚，春亩得躬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平津晚望","author":"李纲","text":"春入沙阳花满林，七峰倒影碧沈沈。\n饥鸢掠水盘旋久，戏鸭浮溪演漾深。\n风景只添流落恨，烟光遥锁别离心。\n浙西三月无消息，始信家书抵万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余抵沙阳之夕民居延火几爇官局因念以论水得罪复以火惊殊可笑叹戏成此诗","author":"李纲","text":"囊封论水谪天涯，才到沙阳火复随。\n本为玄冥遭放逐，却因回禄更惊疑。\n生辰端是穷申未，学易何曾悟坎离。\n烂额焦头那足惜，只愁蓬迹久飘移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夜","author":"李纲","text":"年来三百六十日，忽忽过尽唯今宵。\n天涯远谪罪未解，家问久缺心无聊。\n强倾浊酒慰愁独，坐对寒灯尤寂寥。\n钟鸣漏尽不成寐，世事又属明年朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日","author":"李纲","text":"去年元日朝明堂，对立玉皇香案傍。\n今年元日谪沙阳，独在天涯家一方。\n君恩未报已飘泊，亲老欲养徒徬徨。\n东风回首帝乡远，白云望断吴天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春日","author":"李纲","text":"春风吹到海南边，气候浑如二月天。\n幡胜戴来聊应节，鼓箫鸣处已祈田。\n花梢柳眼争明媚，溪色山光愈翠鲜。\n生菜春盘谁与送，玉人纤手自婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其一","author":"李纲","text":"一树梨花傍小轩，结根幽寂更芳妍。\n东君有意怜流落，故遣瑶姿堕目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其二","author":"李纲","text":"晚来急雨作轻寒，只恐梨花落点残。\n唤起小童窗外看，玉妃何事泪栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其三","author":"李纲","text":"花开好鸟晓关关，惊觉幽窗小梦残。\n宿酒未醒慵起早，透帘红日上三竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其四","author":"李纲","text":"萧萧槛外翠琅玕，瘦节疏枝特地寒。\n谁谓幽居太寥闲，此君长此结清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其五","author":"李纲","text":"春光淡荡一番新，花气氛氲恼杀人。\n只恐花飞春又老，须将酩酊对芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其六","author":"李纲","text":"清晨开卷坐幽窗，深注炉烟一缕香。\n汲水养花颜色好，向人端似炫新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其七","author":"李纲","text":"春日迟迟午睡浓，梦魂飞过浙江东。\n无端花底间关舌，唤起搔头两鬓蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其八","author":"李纲","text":"寂寂春林杜宇啼，劝人只道不如归。\n我今归思何须劝，借尔翩翻两翅飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其九","author":"李纲","text":"春色困人浑似酒，花枝照眼恰如人。\n东君若解怜愁客，莫使花飞减却春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十","author":"李纲","text":"漠漠轻烟度短墙，春寒料峭怯罗裳。\n惜春只怕多风雨，云影披离漏日光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十一","author":"李纲","text":"幽禽百啭舌如簧，院宇深深花木香。\n飘泊伤春惟泥酒，不知林外已斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十二","author":"李纲","text":"谁使鸣禽自在啼，感春端似惜芳时。\n一枝暂寄休饶舌，静处须防挟弹儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十三","author":"李纲","text":"春来南国蔼韶光，百卉嫣然竞早芳。\n语燕啼莺将婉娈，游蜂舞蝶已颠狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十四","author":"李纲","text":"青鸟飞来动槛花，翠衿绀趾哢交加。\n向人自解传消息，疑是来从阿母家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十五","author":"李纲","text":"微月笼云黯淡明，忽闻索索雨来声。\n可怜窗外梨花老，一夜飘残雪片轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春词二十首 其十六","author":"李纲","text":"聒聒鸣鸠唤雨来，萧萧寒响滴空阶。\n不知逐客伤春恨，多少残英点翠苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]