[{"title":"菩萨蛮 玉楼春 答紫竹","author":"方乔","text":"绿阴扑地莺声近。\n柳絮如绵烟草衬。\n双鬟玉面碧窗人。\n一纸银钩青鸟信。\n佳期远卜清秋夜。\n桐树梢头明月挂。\n天公若解此情深，此岁何须三月夏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 复答紫竹","author":"方乔","text":"秋风即拟同衾枕。\n春归依旧成孤寝。\n爽约不思量。\n翻言要打郎。\n鸳鸯如共耍。\n玉手何辞打。\n若再负佳期。\n还应我打伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行 约方乔不至","author":"紫竹","text":"醉柳边莺，懒风熨草。\n约郎暂会闲门道。\n粉墙阴下待朗来。\n藓痕印得鞋痕小。\n花日移阴，帘香失袅。\n望郎不到心如捣。\n避人愁入倚屏山，断魂还向墙阴绕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"紫竹","text":"绣阁锁重门，携手终非易。\n墙外凭它花影摇，那得疑郎至。\n合眼想郎君，别久难相似。\n昨夜如何绣枕边，梦见分明是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"紫竹","text":"约郎共会西厢下。\n娇羞竟负从前话。\n不道一暌违。\n佳期难再期。\n郎君知我愧。\n故把书相诋。\n寄语不须慌。\n见时须打郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"紫竹","text":"与郎眷恋何时了。\n爱郎不异珍和宝。\n一定百金偿。\n算来何用郎。\n戏郎郎莫恨。\n珍宝何须论。\n若要买郎心。\n凭他万万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行 投方乔誓书","author":"紫竹","text":"笔锐金针，墨浓螺黛。\n盟言写就囊儿袋。\n玉屏一缕兽炉烟，兰房深处深深拜。\n芳意远穷，花笺难载。\n帘前细祝风吹带。\n两情愿得似堤边，一江渌水年年在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 其一","author":"紫竹","text":"晨莺不住啼，故唤愁人起。\n无力晓妆慵，闲弄荷钱水。\n欲呼女伴来，斗草花阴里。\n娇极不成狂，更向屏山倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 其二","author":"紫竹","text":"思郎无见期，独坐离情惨。\n门户约花开，花落轻风飐。\n生怕是黄昏，庭竹和烟黮。\n敛翠恨无涯，强把兰缸点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南","author":"王氏（宇文绶妻","text":"公孙恨，端本笔俱收。\n枉念歌馆经数载，寻思徒记万馀秋。\n拓拔泪交流。\n村仆固，闷独驾孤舟。\n不望手勾龙虎榜，慕容颜老一齐休。\n甘分守闾丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"宇文绶","text":"足蹑云梯，手攀仙桂。\n姓名高持登科记。\n马前喝道状元来，金鞍玉勒成行缀。\n宴罢归来，恣游花市。\n此时方显平生志。\n修书速报凤楼人，这回好个风流婿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙","author":"黄妙修","text":"稽首大罗天。\n法眷姻缘。\n如花玉貌正当年。\n帐冷帏空孤枕畔，枉自熬煎。\n为此建斋筵。\n追荐心虔。\n亡魂超度意无牵。\n急到蓝桥来解渴，同做神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"申纯","text":"试问兰煤灯烬，佳人积久方成。\n殷勤一半付多情。\n油污不堪自整。\n妾手分来的的，郎衣拭处轻轻。\n为言留取表深诚。\n此约又还未定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉楼春","author":"申纯","text":"晓窗寂寂惊相遇。\n欲把芳心深意诉。\n低眉剑翠不胜春，娇转樱唇红半吐。\n匆匆已约欢娱处。\n可恨无情连夜雨。\n枕孤衾冷不成眠，挑尽残灯天未曙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"申纯","text":"绿窗深贮倾城色。\n灯花送喜秋波溢。\n一笑入罗帏。\n春心不自持。\n雨云情已乱。\n弱体羞还颤。\n从此问云英。\n何须上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"申纯","text":"甥馆睽违已隔年。\n重来窗儿尚依然。\n仙房长拥云烟瑞，浮世空惊日月迁。\n浓淡笔，短长篇。\n旧吟新诵万愁牵。\n春风与我浑相识，时遣流莺奏管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐","author":"申纯","text":"尖尖曲曲。\n紧把红绡蹙。\n朵朵金莲光夺目。\n衬出双钩红玉。\n华堂春睡深沉。\n拈来绾动春心。\n早破六丁收拾，芦花明月难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲","author":"申纯","text":"情若连环终不解。\n无端招引傍人怪，好事多磨成又败。\n应难挨。\n相看冷眼谁瞅睬。\n镇日愁眉如敛黛。\n阑干倚遍无聊赖。\n但愿五湖明月在。\n权宁耐。\n终须还了鸳鸯债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"申纯","text":"一自识伊来，便许绾同心结。\n天意竟辜人愿，成几番虚设。\n佳期近也想新欢，遣我空悬绝。\n莫忘花阴深处，与西窗明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"王娇娘","text":"君去有归期，千里须回首。\n休道三年绿叶阴，五载花依旧。\n莫怨好音迟，两下坚心守。\n三只骰儿十九窝，没里须教有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"王娇娘","text":"郎今去也抛奴去。\n恨共离舟留不住。\n扶病别江头。\n沾襟泪雨流。\n路远终须别。\n一寸肠千结。\n此会再难逢。\n相逢只梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"王娇娘","text":"莲闺爱绝。\n长向碧瑶深处歇。\n华表来归。\n风物依然人事非。\n月光如水。\n偏照鸳鸯新冢里。\n黄鹤催班。\n此去何时得再还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令 其三","author":"张舜美","text":"漏滴铜壶声咽。\n风送金猊香烈。\n一见彩鸾灯，顿使狂心烦热。\n应说。\n应说。\n昨夜相逢时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令","author":"刘素香","text":"邂逅相逢如故。\n引起春心追慕。\n高挂彩鸾灯，正是儿家庭户。\n那步。\n那步。\n千万来宵垂顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子","author":"贺怜怜","text":"勉强赠行装。\n愿尔长驱扫夏凉。\n威镇雷霆传号令，轩昂。\n万里封侯相自当。\n功绩载旂常。\n恩宠朝端谁比方。\n衣锦归来携两袖，天香。\n散作春风满洛阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青玉案 其四","author":"张道南","text":"缟衣仙子来何处。\n咫尺近、桃源路。\n说是武陵溪畔住。\n玉纤微露。\n金莲稳步。\n只恐莺花妒。\n邂逅刘郎垂一顾。\n何事匆匆便归去。\n临别叮咛频属付。\n柳亭花馆，月窗云户。\n休把春辜负。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过龙门","author":"郑意娘","text":"尽日倚危阑。\n触目凄然。\n乘高望处是居延。\n忍听楼头吹画角，雪满长川。\n荏苒又经年。\n暗想南园。\n与民同乐五门前。\n僧院犹存宣政字，不见鳌山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"郑意娘","text":"往事与谁论，无语暗弹泪血。\n何处最堪怜肠断，是黄昏时节。\n倚楼凝望又徘徊，谁解此情切。\n何计可同归雁，趁江南春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 赠刘金坛","author":"韩师厚","text":"玉貌何劳朱粉，江梅岂类群花。\n终朝隐几论黄芽。\n不顾花前月下。\n冠上星簪北斗，杖头经挂南华。\n不知何日到仙家。\n曾许彩鸾同跨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"刘金坛","text":"标致清高不染尘。\n星冠云氅此霞裙。\n门掩斜阳无一事，抚瑶琴。\n虚馆幽花偏惹恨，小窗闲月最消魂。\n此际最教还俗去。\n谢天尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"添声杨柳枝 其二","author":"潘必正","text":"尊姑久矣情疏阔。\n呼酬酢。\n留连杯酒灯前酌。\n身如缚。\n归来残月窥窗角。\n星初落。\n几回欲把朱扉啄。\n人知觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"潘必正","text":"羽翼将成，功名未遂。\n偶然撞入鸳鸯会。\n当初望折桂枝香，不期又作桃源媚。\n月下幽欢，星前伉俪。\n分明犯了风流罪。\n大开罗网选英贤，伫看鹄立丹墀内。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"潘必正","text":"卸下星冠作玉容。\n宛如仙女下巫峰。\n霎时云雨欢娱罢，无限恩情两意浓。\n轻搂抱，款相从。\n时间一度一春风。\n若还得遂平生愿，尽在今宵一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"陈妙常","text":"松舍清灯闪闪，云堂钟鼓沉沉。\n黄昏独自展孤衾。\n未睡先愁不稳。\n一念静中思动，遍身欲火难禁。\n强将津液咽凡心。\n争奈凡心转甚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摊破浣溪沙","author":"陈妙常","text":"寂寂云堂斗帐闲。\n炉香消尽爇沉烟。\n烘却布衾图睡暖，转生寒。\n霏霏细雨穿窗湿，飒飒西风透枕珊。\n此际道心禁不得，故思凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"陈妙常","text":"相府潭潭数十重。\n入门马上气如虹。\n俨然端坐黄堂上，忧国忧民俯仰中。\n蒙下顾，谢姑容。\n仙禽从此脱樊笼。\n当初只说常清净，羞对先生满面红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"陈妙常","text":"眉如云开初月，纤纤一搦腰肢。\n与君相识未多时。\n不知因个甚，裙带短些儿。\n茶饭不思常是病，终朝如醉如痴。\n此情犹恐外人疑。\n特将心腹事，报与粉郎知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"朱端朝","text":"梅正开时雪正狂。\n两般幽韵孰优长。\n且宜持酒细端详。\n梅比雪花输一白，雪如梅蕊少些香。\n东君非是不思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮","author":"阮华","text":"玉箫一曲无心度。\n谁知引入桃源路。\n邂逅曲阑边。\n匆匆欲并肩。\n一时风雨急。\n忽尔分双翼。\n回首洛川人。\n翻疑化作云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"淡画眉儿斜插梳。\n不忺拈弄绣工夫。\n云窗雾阁深深处，静拂云笺学草书。\n多艳丽，更清姝。\n神仙标格世间无。\n当时只说梅花似，细看梅花却不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滴滴金 其一","author":"无名氏","text":"几回见你帘儿下。\n佯不采、把人斜抹。\n问着他、插地推聋哑。\n到学三郎改话。\n不也。\n不和我巧时休，和我巧时、都不怕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"无名氏","text":"幽花带露红，湿柳拖烟翠。\n花柳分春各自芳，惟有人憔悴。\n寄与手中书，问肯归来未。\n正是东风料峭寒，如何独自教人睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叠青钱 作垒","author":"无名氏","text":"夏日正长，无奈如焚天气。\n火云耸、奇峰天外。\n未雨先雷。\n畏日流金，六龙高驾火轮飞。\n纹簟纱厨，风车谩搅，月扇空挥。\n金炉烟细。\n午风轻转，堪避炎威。\n渐凉生池阁，卷起帘幕珠玑。\n娇娥美丽。\n天然秀色冰肌。\n玉栏深径，荷香旖旎。\n玉管声齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"城中酒楼高入天。\n烹龙煮凤味肥鲜。\n公孙下马闻香醉，一饮不惜费万钱。\n招贵客，引高贤。\n楼上笙歌列管弦。\n百般美术珍羞味，四面阑干彩画檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆瑶姬","author":"无名氏","text":"姑射真人，宴紫府、双成击破琼苞。\n零珠碎玉，被蕊宫仙子，撒向空抛。\n乾坤皓彩中宵。\n海月流光色共交。\n向晓来，银压琅玕，数枝斜坠玉鞭梢。\n荆山隈，碧水曲，际晚飞禽，冒寒归去无巢。\n檐前为爱成簪箸，不许儿童使杖敲。\n待效他、当日袁安谢女，才调咏嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜游宫","author":"无名氏","text":"四百四病人皆有。\n只有相思难受。\n不疼不痛在心头，魆魆地教人瘦。\n愁逢花前月下，最怕黄昏时候，心头一阵痒将来，一两声咳嗽咳嗽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"无名氏","text":"快活无过庄家好，竹篱茅舍清幽。\n春耕夏种及秋收。\n冬间观瑞雪，醉倒被蒙头。\n门外多栽榆柳树，杨花落满溪头。\n绝无闲闷与闲愁。\n笑他名利客，役役市廛游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"无名氏","text":"是水归于大海，闲汉总入京都。\n三都捉事马司徒。\n衫褙难为作主。\n盗了亲王玉带，剪除大尹金鱼。\n要知闲汉姓名无。\n小月旁边匹土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 泪","author":"无名氏","text":"碎似真珠颗颗停。\n清如秋露脸边倾。\n洒时点画湘江竹，感处曾摧数里城。\n思薄幸，忆多情。\n玉纤弹处暗销魂。\n有时看了鲛绡上，无限新痕压旧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"无名氏","text":"年少争夸风月，场中波浪偏多。\n有钱无貌意难和。\n有貌无钱不可。\n就是有钱有貌，还须著意揣摩。\n知情识趣俏哥哥。\n此道谁人赛我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉楼春","author":"无名氏","text":"名花绰约东风里。\n占断韶华都在此。\n芳心一片可人怜，春色三分愁雨洗。\n玉人尽日恹恹地。\n猛被笙歌惊破睡。\n起临妆镜似妖羞，近日伤春输与你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"凛冽严凝雾气昏。\n空中瑞雪降纷纷。\n须臾四野难分别，顷刻山河不见痕。\n银世界，玉乾坤。\n望中隐隐接昆仑。\n若还下到三更后，直要填平玉帝门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时乐 其一 春","author":"李公麟","text":"桃李花开春雨晴。\n声声布谷迎村鸣。\n家家场头酹酒觥。\n为告庄主东作兴。\n黄犊先破东南村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时乐 其二 夏","author":"李公麟","text":"火云蔽日当空浮。\n田头耨草汗欲流。\n绿竹人寂鸟声休。\n暂来歇午乘清幽。\n山妻送饷扇遮头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时乐 其三 秋","author":"李公麟","text":"黄云万里秋有成。\n村村酒熟家家迎。\n封羊赛社人未醒。\n醉后鼓腹歌升平。\n欣然同乐仓满盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四时乐 其四 冬","author":"李公麟","text":"寒风十月雪欲飞。\n居人木榻添纸帏。\n地炉活火酒频煨。\n瓦杯不设羊羔肥。\n醉来曲肱歌声微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇","author":"无名氏","text":"美满生离，据鞍兀兀离肠痛。\n旧欢新宠。\n变作高唐梦。\n回首孤城，依约青山拥。\n西风送。\n戍楼寒重。\n初品梅花弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"无名氏","text":"玉臂宽环，纱衫缓扣。\n乡窗针线无心久。\n豹头枕冷麝兰轻。\n虾须帘静尘埃厚。\n紫燕风头，黄梅雨后。\n柳条乱拂长江口。\n但言幂柳如烟，谁知摇曳如柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行","author":"无名氏","text":"红叶空传，朱绳未绾。\n天涯可见人难见。\n绿窗病起落梅繁，玉箫梦断行云短。\n波眼将穿，柳腰似刬。\n寂寥偏与东管。\n水仙愁绝翠围寒，春云空谷兰香远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"苏轼","text":"十五年前，我是风流帅，花枝缺处留名字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗百花近拍","author":"仲殊","text":"九凤啸歌宛转。\n鹤舞长生排遍。\n彩衣朱绂，醉挹绮园彭羡。\n香在云头，星宫寿纪重新，东斗瑞光昏见。\n嘉庆留西宴。\n酒乍醒时，便拥一封归传。\n雨露旧恩，长沙再膺天眷。\n还了宫符，前席受取丁宁，功业算来何晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊踏枝 其一","author":"仲殊","text":"几日中元初过复。\n七叶蓂疏，佳气生晴昼。\n称庆源深流福厚。\n天精储粹干星斗。\n喜入高堂罗燕豆。\n风弄微凉，帘幕披香绣。\n暂倩灵龟言永寿。\n蟋桃花送长生酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 赵文鼎生日","author":"芮煇","text":"翠屏罗幕遮前后。\n舞袖翻长寿。\n紫髯冠佩御炉香。\n看取明年归奉、万年觞。\n今宵池上蟠桃席。\n咫尺长安日。\n宝烟飞焰万花浓。\n试看中间白鹤、驾仙风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 饯腊","author":"方岳","text":"太乙东皇欲转钧。\n玄冥连夜碾归轮。\n冰痕不动玉粼粼。\n酒气力消寒气力，梅精神是雪精神。\n相将好去转头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二 迎春","author":"方岳","text":"看见娇黄拂柳芽。\n狠银幡谁亸髻蟠鸦。\n一帘睛色满天涯。\n冰缕未醒连夜酒。\n雪篱留得去年花。\n东风也肯过吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其三 守岁","author":"方岳","text":"暖入屏炉一笑融。\n灯花成穟缀钗虫。\n醉微微莫睡匆匆。\n宝炷烧残银鸭暖，雪花飞起玉麟红。\n春风不等五更钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]