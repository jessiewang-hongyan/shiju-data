[{"title":"金陵怀古","author":"周密","text":"远岸商歌不忍听，恨随纤草满沙汀。\n春归王谢空堂燕，风散齐梁废苑萤。\n紫盖黄旗人寂寞，琼枝璧月事飘零。\n新亭风景时时异，惟有垂杨似旧青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵玉台体二首 其一","author":"周密","text":"一点伤春恨，东风罨画楼。\n不知缘底事，敲碎玉搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵玉台体二首 其二","author":"周密","text":"柳阴随意绿，花片恼人香。\n静院无来客，游丝百尺长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烟脂井","author":"周密","text":"急奏留床下，君王醉未看。\n应嫌江表窄，不及井中宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西余秋晚","author":"周密","text":"丰年鸡犬饱，斜日闭柴荆。\n父祖自三代，耕桑了一生。\n病梨山蚁聚，落叶野禽惊。\n喜客来城市，新蔬荐早粳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽顾徵君","author":"周密","text":"白发苍眉古典刑，著书未省出山扃。\n尝从康节传三易，颇效河汾续五经。\n方喜朝颁遗逸诏，忽闻月犯少微星。\n大书谁草徂徕传，丰碣新添贞曜铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王茂悦提舶二首 其一","author":"周密","text":"清气钟全蜀，风流压盛唐。\n骚香薰屈宋，笔艳映钟王。\n麾节平生梦，人琴一旦亡。\n卜居方有赋，埋玉重堪伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王茂悦提舶二首 其二","author":"周密","text":"洛社忘年契，惟公最己知。\n诵言司马赋，喜说项斯诗。\n问字时携酒，钩玄共订碑。\n岂期三日别，遽作百年悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽赵子真别驾","author":"周密","text":"赫奕诸王后，清贫一士同。\n楼成召长吉，山裂梦虚中。\n及子员郎泽，能诗伯氏风。\n琅玕嗟早折，魂不到安东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻鹃","author":"周密","text":"帝魂应识少陵忧，十二山高万里愁。\n一自海棠妖血染，玉垣移治在渝州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游下竺示僧","author":"周密","text":"野褐芒鞋六尺藤，好溪山处几番登。\n明朝又复归城市，百亩松风属老僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阊门夜发","author":"周密","text":"春露沾衣夜气浓，吴波不动柳无风。\n倚篷觅句清无寐，一片蛙声月色中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"紫霞翁觞客东园列烛花外秋林散影高堂素壁皆粲然李成韦偃寒林画图发新奇于摇落前所未有因作歌以纪之","author":"周密","text":"隋园剪綵未足奇，秋林烛彩光参差。\n龙蛇四壁不可捕，颠张醉墨惊淋漓。\n齐奴金谷珊瑚树，如意击碎光陆离。\n阿环锦院织绡手，连机隐出千花枝。\n迷楼镜屏照前后，宫钗舞袂相纷披。\n月中老桂冷轇轕，山河影满玉兔悲。\n江潭无风映云树，水藻漾日浮涟漪。\n初疑营丘擅工妙，细玩自笑真儿嬉。\n世间无物非幻化，露电泡影何足疑。\n谁能唤起洪谷子，写此清绝图屏帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泛舟","author":"周密","text":"老火浊不流，热恼无可避。\n驾言清溪滨，濯缨税尘辔。\n扁舟无定游，放缆任其至。\n荡桨三汇交，空明发清思。\n摘鲜得野实，钓水投香饵。\n碧筒注芳酒，湘奁荐新芰。\n主宾略酬酢，冷暖随所嗜。\n须臾月轮上，烟水合空翠。\n清风真可人，意厚万金施。\n露叶生辉光，水华多妩媚。\n欲拍洪崖肩，欲挽湘君帔。\n虽无管弦乐，一洗世俗伪。\n清弹发邻舸，暗搅潜虬睡。\n应作蜩蛙观，亦足助幽致。\n岂惟家山乐，要是会心地。\n热官岂办此，未易轻拟议。\n我年未四十，齿发已憔悴。\n往者不可追，来者何可觊。\n富贵难幸求，岁月不少置。\n于此贫贱中，此乐已不啻。\n鹤长与凫短，造物正儿戏。\n功名类蚁梦，身世等萍寄。\n百年几良晤，何暇计荣悴。\n纵有身后名，不博今夕醉。\n高歌未知晓，坐见斜河坠。\n谪仙宫锦舟，继者仅一二。\n老坡赤壁游，始尽阐天閟。\n我后二百年，乃默契此意。\n会当歃斯盟，勿使等闲弃。\n高咏三百言，聊用谂同志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘲少年","author":"周密","text":"步障飞鞯事俊游，锦围箫鼓按凉州。\n海棠枝上千枝蜡，肯信人间有暮愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塘西秋晚","author":"周密","text":"野市维梢处，长天弄夕阴。\n蟹寒依客柁，鸦晚集神林。\n苕老飘吴雪，橙香坠楚金。\n浩然湖海思，重赋故山吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春寒","author":"周密","text":"柘叶烟浓乍起蚕，楝花风冷已闻鹃。\n病来应被垂杨笑，三月春衣未褪绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕被雨病中有感 其一","author":"周密","text":"病怀惟与静相便，尽把欢游乞少年。\n沉水一炉诗一卷，细听春雨枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕被雨病中有感 其二","author":"周密","text":"邻箫街鼓远相闻，犹忆天街五夜春。\n二十年间游冶事，青灯闲照白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沈仁可惠看灯蟹","author":"周密","text":"君不见天上妖蟆食天目，怪语空号玉川客。\n万古何伤明月明，可笑妖蟆终受磔。\n又不见人间痴蝶掩夜灯，焦头烂额恃己能。\n烹煎不免取奇祸，亏蔽徒取人之憎。\n二虫何知乃至此，飞走不能逃一死。\n附炎触热正可怜，喘杀人间褦襶子。\n草泥夜黑溪火明，挺矛衷甲方横行。\n举烽止博褒姒笑，投阱何异长平坑。\n我怜公子本无罪，人之不仁非自致。\n便为移封到酒泉，唤取曲生同一醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题惠崇并禽图","author":"周密","text":"雪尽江南二月初，并禽高下自相呼。\n静中乐意无人见，一片春声在画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽吴承务二首 其一","author":"周密","text":"种德勤穮蓘，终能穫岁康。\n经传韦氏业，善著郑公乡。\n议论参诸老，功名付二郎。\n美哉天目水，流作庆源长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽吴承务二首 其二","author":"周密","text":"道义真堪贵，弓旌不受招。\n五全洪范福，四见太平朝。\n问绝趋庭对，愁闻祖道箫。\n哀荣无一憾，丰碣在山椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"写怀偶成二首 其一","author":"周密","text":"少不如人奈老何，早衰多病鬓双皤。\n无亲可共耕绵上，有子堪同读善和。\n妄想不生骑鹤梦，高情时有饭牛歌。\n钓游闲事无人见，长剪渔竿短结莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"写怀偶成二首 其二","author":"周密","text":"梦里区区较短长，鸡虫得失最堪伤。\n不知贞观凌烟阁，何似南柯审雨堂。\n暮四朝三齐得丧，左蛮右触几兴亡。\n正须痛饮中山酒，细读南华第二章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花朝溪上有感昔游 其一","author":"周密","text":"枕上鸣鸠唤晓晴，绿杨门巷卖花声。\n探芳走马人虽老，岁岁东风二月情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花朝溪上有感昔游 其二","author":"周密","text":"画舫笙箫张水嬉，小红娇翠斗新眉。\n多情赖有河桥柳，犹认当年杜牧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人话京都旧游戏成","author":"周密","text":"江湖落魄忆芳年，曾赋名都结客篇。\n九陌舞香元夜烛，六桥歌月禁烟船。\n红帘顾曲缠头锦，紫陌寻芳买笑钱。\n老去风情浑减尽，一窗听雨对花眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔台山","author":"周密","text":"枫叶芦花外，闲矶带短汀。\n风翻荷浅白，霜陨柳残青。\n机事鸥浮没，生涯酒醉醒。\n暮榔和夜笛，馀韵最堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其一","author":"周密","text":"亲郊诏下半年前，正是咸淳第二年。\n执玉奉璋来万国，息烽归马静三边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其二","author":"周密","text":"别殿斋居极敬严，外庭职祭亦精虔。\n事天以实无科扰，应办全支内帑钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其三","author":"周密","text":"上界钩陈护属车，绣衣卤簿列旌旟。\n驾头已近鸣鞭急，一路迎銮奏起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其四","author":"周密","text":"行门赞唱似吹笙，号诺连珠绕禁城。\n五使按临严柝静，夜深初听警场声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其五","author":"周密","text":"和气排冬午夜春，列星呈瑞午阶明。\n千官执玉萧芗远，静听登歌奏六成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其六","author":"周密","text":"苍璧黄琮藉白茅，圜坛八陛际云高。\n景光下烛天心享，万岁三呼祝圣尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其七","author":"周密","text":"瑞霭烘春夜不寒，骏奔冠佩拥回环。\n景钟奏彻升烟起，又报端诚立贺班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其八","author":"周密","text":"黄道宫罗瑞脑香，衮龙升降佩锵锵。\n大安辇奏乾安曲，万点明星簇紫皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其九","author":"周密","text":"一夜东风斗柄回，紫坛葱茜若春台。\n熙熙万宇风光暖，尽入君王饮福杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十","author":"周密","text":"衙前口号奏谐和，日映龙颜喜气多。\n六辔暂停鸾辂稳，凤韶新奏庆成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十一","author":"周密","text":"锦幕千家尽贵豪，万花呈晓翠帘高。\n数声掣电惊清跸，一点红云认御袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十二","author":"周密","text":"喜看回仗自青城，十里东风五色云。\n露布西来天一笑，舆图新复广安军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十三","author":"周密","text":"万骑云从簇锦围，内官排办马如飞。\n九重阊阖开清晓，太母登楼望驾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十四","author":"周密","text":"换辇登门捲御帘，侍中承制舍人宣。\n凤书乍脱金鸡口，一派欢声下九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十五","author":"周密","text":"祝史无私本为民，大和丕应泰阶平。\n昕庭未受群臣贺，先过东朝谢礼成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十六","author":"周密","text":"启蛰而郊月建寅，新元颁赦又颁春。\n端闱拜了熙成表，朝会移班贺紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十七","author":"周密","text":"子云无分从甘泉，留滞犹胜叙史迁。\n瑞应可书郊祀志，熙功宜被奉常弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十八","author":"周密","text":"曾闻宝庆老人言，不见亲郊四十年。\n何幸圣时瞻盛举，咏歌留作画图传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其十九","author":"周密","text":"我将清庙周诗颂，泰畤汾阴汉史书。\n献赋可无徐穆伯，贡谀何取马相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南郊庆成口号二十首 其二十","author":"周密","text":"太平寰海扇皇风，千载风云喜际逢。\n行见版图恢旧宇，泰山父老徯东封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙谣为赵子固赋","author":"周密","text":"九歌讨群珍，遗此横道宝。\n雪光射初月，静夜纤裳缟。\n云护白珊瑚，风蜚碧龙脑。\n招得湘娥魂，千年化瑶草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次李秋崖见寄韵","author":"周密","text":"东风过雁带春声，半纸依然旧雨情。\n生事就荒抛橘隐，交情耐久有梅兄。\n鹤归不记千年表，马老空惭万里名。\n闲想蘋花溪上笛，扁舟应许白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次程仪父游清溪","author":"周密","text":"溪上垂垂雨又晴，泪荷颦柳满沙汀。\n水声不洗千年恨，山色空馀六代青。\n感慨有诗怀故国，英雄无泪泣新亭。\n孤忠耿耿人谁会，酹酒钟山试乞灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒋山次徐君寅韵","author":"周密","text":"佛屋千年古木中，遗民犹有六朝风。\n骑驴宰相何人见，试问玄关十八公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"半山次韵","author":"周密","text":"吹香照影白溪湾，觅句逃禅去复还。\n晚岁既知三字误，终身只合两山间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀","author":"周密","text":"浩浩门外尘，今古无二岐。\n车痕遍九陌，得丧何已时。\n商飙动地来，万叶辞故枝。\n游子感摇落，忽起流年悲。\n玄发日以槁，素衣日以缁。\n天衢九万里，加以刚风吹。\n岁月不我私，壮志安可期。\n激昂赋七启，清壮歌五噫。\n采采秋原花，对酒聊自怡。\n佳人隔明河，相望长相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋晚怀归","author":"周密","text":"摇落江空雁影沉，楼高愁近怕登临。\n双溪秋晚碧苕老，三径雨多红叶深。\n灯火未忘年少梦，莼鲈偏恼客中心。\n且寻篱下黄花约，莫倚西风学楚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种花五言","author":"周密","text":"花发一朝喜，花落一夕愁。\n不如不种花，不喜亦不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖亭雨后","author":"周密","text":"罨画楼台著色山，雨馀濯锦未全乾。\n游船醉眼迷歌舞，不似閒人静处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日感怀寄修门从游","author":"周密","text":"华年锦瑟事谁论，燕社鸥盟半不存。\n三月莺花张绪宅，十年诗酒孟尝门。\n东风不染吴霜鬓，旧雨难招楚水魂。\n欲把清愁换沉醉，月明花落几黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人山房","author":"周密","text":"自笑劳劳尘满襟，羡君卜隐在山深。\n清溪过雨知鱼乐，秋汉无云快鹤心。\n与世相忘千日酒，谋生甚简一弦琴。\n不须物外求知己，明月清风自赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别三首 其一","author":"周密","text":"岁晚日云暮，朔吹鸣枯枝。\n迢迢万里道，游子奚所之。\n前置酒一樽，于以纾别离。\n人生尽岐路，流转勿自悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别三首 其二","author":"周密","text":"野梅发崇冈，寒日惨不舒。\n单车骋长道，怅怅无安居。\n梦寐日以劳，晤语日以疏。\n边城足飞雁，因寄江南书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别三首 其三","author":"周密","text":"行行重行行，送子江之涯。\n把手不忍分，涕泪俱涟洏。\n客途无西东，良会胡可期。\n努力为功名，世道多崄巇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿感慈僧舍","author":"周密","text":"刻刻数残更，依依梦未成。\n不堪孤客耳，当此万蛩声。\n霜叶矜秋色，风林碎月明。\n旅怀多自感，景物况关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中","author":"周密","text":"一番春又老，长日病厌厌。\n黄馘从清减，华颠任白添。\n鼠顽翻药灶，蛛嬲罥书签。\n门巷无来客，冠簪亦懒拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚简溪友","author":"周密","text":"楚烟新百五，汉禊古重三。\n节序正如此，情怀自不堪。\n蜜香蜂蜕蛹，绵老柳飘蚕。\n有约溪边去，观鱼共剧谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游法华瑶阜蜃洞以糁径杨花铺白毡点溪荷叶叠青钱分韵余既有作复各赋古诗一以纪游事 其一","author":"周密","text":"青旂倏南指，洒洒风日澹。\n伯劳与飞燕，相对如有憾。\n馀春在何许，青苔缀红糁。\n繁华逐流水，使我意殊惨。\n把酒延孤芳，举之不盈揽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游法华瑶阜蜃洞以糁径杨花铺白毡点溪荷叶叠青钱分韵余既有作复各赋古诗一以纪游事 其二","author":"周密","text":"此身如虚舟，所至不维碇。\n闻奇即勇往，岂暇寻捷径。\n同行二三子，委曲逐孤磬。\n甘清嗽寒齿，醉梦为苏醒。\n眷眷泉石幽，归榜烟欲暝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]