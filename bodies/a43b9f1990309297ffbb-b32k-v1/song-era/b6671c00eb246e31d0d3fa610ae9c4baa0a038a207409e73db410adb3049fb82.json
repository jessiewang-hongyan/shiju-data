[{"title":"闻曾幼度近况于陈择之作二诗觅使寄之 其一","author":"赵蕃","text":"自辱缄书报，于今岁有秋。\n飘流闻客语，消息解人忧。\n荐牍新频上，诗声旧得优。\n君归定蓬阁，我去复炎州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻曾幼度近况于陈择之作二诗觅使寄之 其二","author":"赵蕃","text":"夜醉江天阁，赋诗殊未央。\n自兹悲契阔，谁复慰凄凉。\n有抱何由写，因诗得寄将。\n丁宁赣江水，莫惮溯流长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倪先辈送水仙一科数花","author":"赵蕃","text":"倪郎知我愁无度，故遣水仙来叩关。\n悄悄如逢度相远，亭亭似直待夫还。\n飘流歌舞馀杯斝，脱略簪笄失佩环。\n寒眼何堪重对此，一轩风月闭穷山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭蔡西山","author":"赵蕃","text":"鹃叫春林复递诗，雁回霜月忽传悲。\n兰枯蕙死迷三楚，雨暗云昏碍九疑。\n早岁力辞公府檄，暮年名与党人碑。\n呜呼季子延陵墓，不待镵辞行可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"娱山亭","author":"赵蕃","text":"嗜好虽同辙，贤愚本异岐。\n箪瓢乐吾道，钱马昧真痴。\n吾舅端何以，名亭不在兹。\n登临如有得，勿用语群儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐丈大雅有诗赠子畅尉曹用韵呈子畅兼柬徐丈","author":"赵蕃","text":"谢子姿野鹤，耸然常自昂。\n贪留故人饭，忘踏板桥霜。\n举世谬为敬，从吾醒亦狂。\n交游有徐庶，头白尚东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱通判","author":"赵蕃","text":"堆胜题诗尚可怀，异时吴楚渺何哉。\n传闻屡作南州佐，政自不妨三径开。\n准拟归舟成再见，惊嗟玉树有新摧。\n要知盛德亡穷处，连璧光辉看后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽余正叔","author":"赵蕃","text":"半生初未识，一见骤相亲。\n九曲泛舟日，紫溪沽酒晨。\n我曹俱蹇薄，吾子固真醇。\n竟尔萦何疾，胡为遽没身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李子永二首 其二","author":"赵蕃","text":"封侯寂寞空飞将，佳句流传自谪仙。\n半世作民才六考，他年垂世有千篇。\n箧中酬唱都无恙，天外音书不复传。\n五岭三苗底处所，千岩万壑若何边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李子永二首 其一","author":"赵蕃","text":"灵山山下初逢处，溧水水边重见时。\n草草犹传出山句，勤勤更枉送行诗。\n传闻恍惚疑升报，问讯凄凉自越医。\n略计别离能几日，谁知生死遂分岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李舒州二首 其二","author":"赵蕃","text":"一跌竟不起，两州空复更。\n台纲元振举，物论甚分明。\n遂绝朝天骑，空传跨海鲸。\n遥知流涕者，岂但一门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李舒州二首 其一","author":"赵蕃","text":"忽报舒州逝，深同海内伤。\n平泉无草木，北海漫文章。\n要作人琴叹，空怀道路长。\n临风为之恸，发色变苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽杨茂原二首 其二","author":"赵蕃","text":"松老成哀吹，天高惨暮云。\n如何岁时隔，便作死生分。\n经纪无家事，编藏有旧文。\n周侯诚义士，节概过非君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽杨茂原二首 其一","author":"赵蕃","text":"玉美终怀璞，兰香竟死林。\n名期百世后，恨独九原深。\n夜雨长形梦，秋风遂绝音。\n扁舟载孤旐，行路亦沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽汪养源舍人二首 其二","author":"赵蕃","text":"公作庐陵掾，先君官赣州。\n书邮时问讯，江驿几淹留。\n抚事今安在，临风涕莫收。\n谁为耆旧传，好寄竹林游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽汪养源舍人二首 其一","author":"赵蕃","text":"要识公兄弟，当年蜀两苏。\n文章到宗匠，人物见规模。\n谩有词垣用，终迟政府须。\n世缘殊未了，忽复返清都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽沈夫人","author":"赵蕃","text":"夫子家齐政，夫人实并贤。\n女能坚素节，儿亦嗣青编。\n往日僧房寓，曾亲寿酒边。\n吁嗟难重拜，奠哭亦无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周畏知二首 其二","author":"赵蕃","text":"目疾初传剧，犹思碍读书。\n那知遽至是，此恨合何如。\n我已鬓俱白，宁能世久居。\n吾人门户责，骥子总怜渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周畏知二首 其一","author":"赵蕃","text":"乡里虽诸彦，情亲不数人。\n比年成屡哭，将老怆吾身。\n问学文辞外，追随寂寞滨。\n有怀终不遂，回首倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周畏知母俞夫人二首 其二","author":"赵蕃","text":"卜兆虽自古，迩来闻见殊。\n一言福后嗣，百计走愚巫。\n用意非流俗，惟贤毕此涂。\n徐看好兄弟，玉立骋天衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周畏知母俞夫人二首 其一","author":"赵蕃","text":"夫人不佞佛，平日事何如。\n临死无贫苦，与常同起居。\n巫医空睥睨，孝敬谩勤渠。\n性识真明达，油然悟本初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周德友","author":"赵蕃","text":"不作玉堂仙，犹宜入道山。\n予才无乃厚，赋命一何悭。\n此日骑鲸去，它年化鹤还。\n委疏仍嗣野，芳桂杂榛菅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽俞克晦丈二首 其二","author":"赵蕃","text":"好官堪底用，厚禄竟如何。\n诗可传家集，名能继世科。\n流风亲党竞，馀庆子孙多。\n挽送归无策，凄凉谩拟歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽俞克晦丈二首 其一","author":"赵蕃","text":"忆昨陈平相，乡闾例荐延。\n蓬山渝奏墨，岩邑漫铨员。\n祠馆归求志，周行数选贤。\n那知终不偶，幕府遂终焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽南涧先生三首 其三","author":"赵蕃","text":"寂寞溪南路，于今忍重经。\n东来待樽俎，南去哭丹青。\n四裔传碑版，谁人作志铭。\n屏山空矗矗，涧水暗泠泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽南涧先生三首 其二","author":"赵蕃","text":"曾吕兼晁郑，吾州夙所尊。\n流风嗟日远，耆旧赖公存。\n见必询诗卷，闻仍置酒樽。\n从今入州府，寂寞向谁门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽南涧先生三首 其一","author":"赵蕃","text":"唐室文公裔，国朝桐树家。\n学探和静蕴，文嗣一门华。\n尚拟咨黄发，居成后白麻。\n公身宁有憾，物论自兴嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽施文叔三首 其三","author":"赵蕃","text":"资福我跨蹇，智门分命车。\n那知毕世隔，但惜数年疏。\n此士岂复有，馀生谁与居。\n遗文好收拾，骥子记怜渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽施文叔三首 其二","author":"赵蕃","text":"小作王官试，还为幕府留。\n绮歌偶意改，散号觅归休。\n屈贾当重作，潇湘漫一游。\n胡为车未发，已报病难瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽施文叔三首 其一","author":"赵蕃","text":"岂但吾州少，端如四海稀。\n儒林据根柢，玉德著光辉。\n不遇宁渠戚，传亡始谓非。\n及今何所语，徒有泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵丞相汝愚","author":"赵蕃","text":"吾王不解去三思，石显端能杀望之。\n未到浯溪读唐颂，已留衡岳伴湘累。\n生前免见焚书祸，死后重刊党籍碑。\n满地蒺藜谁敢哭，漫留楚些作哀辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵路分善应三首 其三","author":"赵蕃","text":"惟我先君子，相于出自同。\n年推大父行，议笃古人风。\n薄宦曾怜我，经行阻见公。\n讣闻仍葬日，恸哭匪途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵路分善应三首 其二","author":"赵蕃","text":"公就专城养，我安陶令庐。\n几因州府入，得侍笑谈馀。\n课诵列童稚，戚休询里闾。\n高堂朝夕望，宁复象平居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵路分善应三首 其一","author":"赵蕃","text":"世俗纷为伪，躬行率以诚。\n拳拳将母念，侃侃友于情。\n济物岂求报，得仁非近名。\n谁为太史传，独行有宗英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽徐提举夫人卢氏","author":"赵蕃","text":"进已后师说，中犹亲母仪。\n百年蕲未已，一病乃无医。\n令子高交友，韩公直笔辞。\n是为能不腐，虽死亦期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽黄参议","author":"赵蕃","text":"给事勋庸太史诗，凛然人物见家规。\n霜须同老岂无种，孝友深根真得师。\n治行所居皆可纪，人亡于此叹吾衰。\n旧闻有道碑无愧，今见云孙无愧词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曾仲躬侍郎三首 其三","author":"赵蕃","text":"好在茶青竹，青青十百竿。\n风烟饱持护，鸟雀静嘲欢。\n父子当年趣，声名后代看。\n兴怀非一事，愁绝更思韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曾仲躬侍郎三首 其二","author":"赵蕃","text":"政报朱轓起，旋惊丹旐归。\n死生何忽忽，闻见悉依依。\n献纳名元在，吟哦事已非。\n清风端可继，黄发独成违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曾仲躬侍郎三首 其一","author":"赵蕃","text":"昔者嘉禾郡，曾容谒长公。\n已焉地官宅，还获见今翁。\n识面虽先后，陈诗匪异同。\n如何一再恸，祇向十年中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曾达臣二首 其二","author":"赵蕃","text":"江右曾为氏，南丰与赣州。\n推其本儒素，夫岂异源流。\n迩日过遗宅，有逢皆好脩。\n公侯生积善，天道非悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽曾达臣二首 其一","author":"赵蕃","text":"丘壑岂遗物，市朝宁污尘。\n士当明大节，天下弃斯民。\n玉笥游仙梦，浮云阅世身。\n襄阳独耆旧，他国顾无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽游迪功","author":"赵蕃","text":"通学元分族，渊源信有馀。\n二龙名屡贡，一老庆悬车。\n义利过庭训，兴哀迂叟书。\n他时家国事，蕲不负幽墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽谢景英丈二首 其二","author":"赵蕃","text":"不见遂历载，寄书宁写心。\n凄凉叹垂白，索寞远知音。\n只道成乖隔，那知遂古今。\n赤城何许日，云物渺难寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽谢景英丈二首 其一","author":"赵蕃","text":"尚友固十载，过江真一时。\n信曾前辈及，宁后古人为。\n竟作东山卧，漫传康乐诗。\n荆州人物论，夫岂惜吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅食有作","author":"赵蕃","text":"旅食频年倦，田居乐事遥。\n春馀桑柘静，波泛鹭鸥骄。\n折竹深防笋，撑船满载苗。\n新诗随见写，旧发不胜凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓浴昭真观逢方元直诵仆旧诗","author":"赵蕃","text":"泉落千岩雨，松鸣万壑风。\n徘徊岂人世，清绝况秋中。\n就浴能除垢，催行觉未穷。\n逢人举旧句，已似宿生同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源道中用邢子中丈旧韵","author":"赵蕃","text":"山川曾是避秦馀，何得真成画不如。\n想象曾闻昔所赋，经行为记我今初。\n欲知赋役无逃遁，看取耕桑映密疏。\n雨笠烟蓑春正好，盍抛手板便从渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涧铺岭","author":"赵蕃","text":"登山自不恶，飞雪况相仍。\n照映惭非璧，攀援笑引绳。\n向来闻矻矻，今日上层层。\n可但长安道，骑驴觅句能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓶梅","author":"赵蕃","text":"骤逢初粲粲，俨立更亭亭。\n汲井洗醉尽，倦谭挥麈停。\n搜诗未穷妙，能画孰遗形。\n风日人间苦，飞仙不假翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别子肃子仪三首 其三","author":"赵蕃","text":"一别动五载，人生都几何。\n谈端方间起，行色又奔波。\n剩欲摅离语，不成翻醉歌。\n飞腾与流浪，已矣两无那。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别子肃子仪三首 其二","author":"赵蕃","text":"长年梦黄堰，今日饮红灰。\n径绿无多草，庭阴半是梅。\n海棠留雨醉，杨柳傲风媒。\n对此浑无事，一杯重一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别子肃子仪三首 其一","author":"赵蕃","text":"度桥遵野径，夹树启篱门。\n剥啄传呼疾，周旋色笑温。\n万金才到几，一棹复过村。\n却恨侬来独，飘零说在原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别在伯","author":"赵蕃","text":"准拟梅花共赋诗，那知人事有乖离。\n交情自谓惟君厚，世态于今犹我知。\n尽室飘飘虽匪计，此心烱烱幸无欺。\n一官谩浪端何以，从此归耕已自迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别折子明丈二首 其二","author":"赵蕃","text":"行橐何轻重，新诗得卷藏。\n犹须与先集，并为补山房。\n更欲询言行，持将益废忘。\n匆匆语难尽，莽莽恨空长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别折子明丈二首 其一","author":"赵蕃","text":"久作湘中客，数从林下游。\n契繇先世叙，谊向古人求。\n我敢逃黄绶，公宁卧白头。\n庙堂有北客，人物想中州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别陈明叔兼属胡仲威五首 其五","author":"赵蕃","text":"汲汲求交友，良由不敏姿。\n风流伯始后，文献澹庵师。\n此士世亦寡，因君交不疑。\n倡酬凡几纸，别后慰相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别陈明叔兼属胡仲威五首 其四","author":"赵蕃","text":"我觅祠官俸，君携异县书。\n一穷直若此，五字果何如。\n底用频看镜，终当老荷锄。\n未知渠作计，颇亦似侬无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别陈明叔兼属胡仲威五首 其三","author":"赵蕃","text":"簿领三年吏，江天百里居。\n我非拘雁鹜，君乃傲樵渔。\n得誉且得谤，似高仍似疏。\n襄阳耆旧传，书子定联予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别陈明叔兼属胡仲威五首 其二","author":"赵蕃","text":"论事从违数，题诗窜定频。\n客君徒得重，爱我不言贫。\n薄俗无兄弟，我曹相主宾。\n别觞终作恶，别语要须真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别陈明叔兼属胡仲威五首 其一","author":"赵蕃","text":"我去孰君友，君留谁我游。\n定应缘宿契，不待分今投。\n年事鬓俱白，时名诗独优。\n未知兹日别，重见又何由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别叔骥和叔","author":"赵蕃","text":"一见梅花醒病昏，重逢双璧竞清温。\n占风占雨行未已，看水看山心故存。\n亹亹爱渠谈绪远，班班觉我鬓丝繁。\n江天何处不须买，亩蕙畹兰期并门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别周参政诗二首 其二","author":"赵蕃","text":"故意还叨累十觞，诸家所历信踰常。\n黄尘倦马久非地，野水白鸥终是乡。\n勾漏不惟兼采药，长沙更欲访沉湘。\n凭虚便谓神仙近，却觉仕途真渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别周参政诗二首 其一","author":"赵蕃","text":"元祐登瀛盛古今，祇今衰冷愧诸任。\n圣朝既有徐州相，得路仍知异日心。\n龌龊更无微价市，鹪鹩自爱一枝深。\n故同坎轲荆蛮徙，昔所悲歌今放吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别周愚卿兄弟","author":"赵蕃","text":"四海虽云皆弟昆，怅兹薄俗与谁论。\n平生泛爱老逾厌，独觉君家久更敦。\n百里阑干山作几，数家篱落竹为村。\n异时相忆相思处，明月清风同酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别俞孝显孝扬","author":"赵蕃","text":"生事平生非我谋，饥寒长是费君忧。\n相如自厌游成倦，曲逆人知老不侯。\n尽室经年曾未厌，一官千里去难留。\n异时安否如相忆，一问溪头上水舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别赵南纪","author":"赵蕃","text":"少时未识庐山好，老去知山却远山。\n白鹿何繇与弦诵，紫霄还复共跻攀。\n林峦有失君何意，松菊犹存我得还。\n俱是江东巡管内，异时书札愿无悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别徐季纯","author":"赵蕃","text":"隐墅夙未到，扁舟空屡经。\n滩长石璧寺，洲绕縠波亭。\n厚禄头空白，新知眼倍青。\n虽云遽离阔，也足慰飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别徐斯远时斯远将赴朱晦庵之约三首 其三","author":"赵蕃","text":"事变将酬万，身分若化千。\n凄凉辞古寺，辛苦问江船。\n秋得村村雨，凉生树树蝉。\n重哦五七字，还约四三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]