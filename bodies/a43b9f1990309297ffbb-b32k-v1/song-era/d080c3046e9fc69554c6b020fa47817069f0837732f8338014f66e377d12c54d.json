[{"title":"上王公明寿四首 其一","author":"王质","text":"缑氏吹箫远，王家奕叶光。\n昔多称建业，今独盛安阳。\n泰华何曾老，江河各自长。\n一名重两火，与宋大休祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上王公明寿四首 其二","author":"王质","text":"正统承周后，元臣在邺昌。\n治平扶嗣圣，乾道作兴王。\n指日恢中土，何时过故乡。\n新堂标昼锦，门下有欧阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上王公明寿四首 其三","author":"王质","text":"稷契伊周后，功名事业谁。\n眼惊希世杰，心喜太平时。\n不老池边凤，长生印上龟。\n旂常书不尽，太庙有宗彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上王公明寿四首 其四","author":"王质","text":"风起云飞志，包含具善邻。\n试看公出手，毋谓我无人。\n挥羽思平魏，登场决并秦。\n功成身莫退，小驻八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"采石道中","author":"王质","text":"闻说前年事，分明是偶然。\n群雄誇好手，万事有苍天。\n浪沫埋椿木，波声撼战船。\n萧条苦斗者，挥泪立江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏城道中","author":"王质","text":"冈背车痕乱，崖阴马足黏。\n地炉茶带苦，幔店酒多甜。\n水减溪身瘦，冰凝树角铦。\n衣篝都已尽，无可更重添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青阳道中二首 其一","author":"王质","text":"今日青阳路，行行不忍过。\n人家茅屋少，原野稻田多。\n树木连苍色，陂塘湛碧波。\n斜阳攲半岭，将奈镜亭何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青阳道中二首 其二","author":"王质","text":"一路皆平坦，今朝稍屈盘。\n仆饥争小店，桥断拣枯滩。\n处处山都好，家家酒不酸。\n人生各有地，所乐是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿石溪寺","author":"王质","text":"落日寒山里，荒烟野寺中。\n僧垣水衣白，佛座藓花红。\n舍后蜂糖熟，门前雁米丰。\n夜长难早睡，拥被听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敕局同年相饯是日谢遣婢子春饶者还其家同年大不然之共怅然也","author":"王质","text":"已恨此身多，将如之子何。\n自甘吾潦倒，真恐汝蹉跎。\n身老便孤睡，家贫喜自歌。\n辎軿他日见，各想旧婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"发家书","author":"王质","text":"别乘非为辱，江陵稍近家。\n牙绯虽滞色，头白亦增华。\n见说堂前竹，胜如屋角花。\n脱身归到得，馀事总尘沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上亭","author":"王质","text":"雨色昏何在，铃声怨阿谁。\n一朝人世改，万事帝心知。\n西去身虽脱，东边势更危。\n祇应南内里，不似上亭时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨花台","author":"王质","text":"乱草踏秋碧，斜阳立晚红。\n天低昏海雾，江阔渡淮风。\n台有馀基壮，碑无旧观丰。\n愁人惜倦眼，不敢送归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见九华峰有四十馀其最秀者不知孰为九也因作是诗","author":"王质","text":"稍稍云气散，溶溶山态回。\n翠旌千丈立，宝障百重开。\n此地真堪老，何时遂得来。\n海中蛟蜃恶，吾不问蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送虞丞相孙运干诗三首 其一","author":"王质","text":"祖予尚闭户，景文当入山。\n未能黄绮外，姑在尚彭间。\n眼到风尘暗，头依树石斑。\n曹溪有正路，飞倦要知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送虞丞相孙运干诗三首 其二","author":"王质","text":"尚象子生子，高风新又新。\n昔看三桧戏，今见一槐春。\n父祖有家法，典型如老人。\n傍观应自肯，自肯乃方亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送虞丞相孙运干诗三首 其三","author":"王质","text":"曲肱真事业，袖手大文章。\n想子归家急，如吾舍世忙。\n何时见丞相，几日上瞿唐。\n见问宜多说，不言君亦忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东林姚贵高书屋","author":"王质","text":"岛屿深沉碧，溪花淡薄红。\n连山收宿雨，当户进凉风。\n暮霭孤村外，斜阳一笛中。\n西山起明月，未放酒杯空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪景伯得江亭二首 其一","author":"王质","text":"眸子发孤照，太空无阻修。\n万波争赴海，一嶂直当楼。\n渺渺怜身小，茫茫觉世浮。\n斜阳攲埤堄，随意数行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪景伯得江亭二首 其二","author":"王质","text":"主去朝行在，花留伴此亭。\n别催心衮衮，春搅思冥冥。\n此事须丘壑，何人嗣典型。\n但当添种竹，相对北山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题舫轩","author":"王质","text":"一舸江湖外，风涛有是非。\n著身安实地，冷眼看危机。\n烟树何曾远，鸥群故自飞。\n若人能转物，满载月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题施大任双桂轩","author":"王质","text":"濯濯双引干，盘盘同结根。\n人知灵草木，天与好儿孙。\n妩媚花窥眼，婆娑秀此轩。\n门中福未艾，绕树更兰孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题孤山寺","author":"王质","text":"窈窕孤山寺，光明大士龛。\n佛香时缥缈，茶味亦清甘。\n竹挺森千百，僧房并两三。\n全无兵火气，不似在淮南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王充道夜坐二首 其一","author":"王质","text":"索索风呼叶，萧萧雨打窗。\n遥思双白发，相对一残缸。\n梦落湘南浦，身浮浙右江。\n漏穷钟未断，犹自咽微撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王充道夜坐二首 其二","author":"王质","text":"风雨连三日，晨昏共一窗。\n天寒怜翠袖，夜永对青缸。\n有泪挥吴月，无船上楚江。\n梦寒元易断，钟静不须撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和孙仲甫","author":"王质","text":"浦溆清溪绕，人家绿树围。\n竹墩森翠葆，莲荡乱红衣。\n薄雨生朝润，斜阳隐暮霏。\n桃花流水意，不在鳜鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和姚明之","author":"王质","text":"草色动秋绿，松阴留晚清。\n日烘蝉吻燥，风助燕身轻。\n苍莽家千里，飘零酒一觥。\n客愁销不尽，还与暮烟生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陶茂安赴湖南二首 其一","author":"王质","text":"礼乐华今日，江湖得此天。\n绣衣开使指，锦帐卷郎毡。\n峻岳车帷外，清湘簜节前。\n何如归禁籞，花柳自风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陶茂安赴湖南二首 其二","author":"王质","text":"飘泊年家子，依归父执尊。\n不知分此袂，还更蹑谁门。\n欲语无言诉，相期有意存。\n何时凭水槛，凉夜倒清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送韩总二首 其一","author":"王质","text":"斗绝重关险，星驰四牡騑。\n昕朝三劳遣，昼锦再光辉。\n距踊欢趋死，权奇饱欲飞。\n羌儿还解事，早送版图归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送韩总二首 其二","author":"王质","text":"飘泊春馀絮，孤寒岁晚松。\n谁知文有虎，祇道士无龙。\n湓浦城相别，蚕丛国再逢。\n论心能几许，山水又重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郑德初归吴中","author":"王质","text":"相识虽非昔，相知不似今。\n岁寒三益友，金断两同心。\n半子来归叶，孤儿维事任。\n此间拈鼓笛，那更有凡音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送清坚老人宰辰阳四首 其一","author":"王质","text":"黔郡随山壤，卢溪上水舟。\n双眸长不夜，两鬓未全秋。\n制锦宁伤手，鸣琴自点头。\n武陵花赏遍，安稳上瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送清坚老人宰辰阳四首 其二","author":"王质","text":"苦楝风方作，桃花水未生。\n逢村宜早住，趁路莫宵行。\n且止青春酒，频添碧涧羹。\n槐根并马骨，切勿厌官清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送清坚老人宰辰阳四首 其三","author":"王质","text":"却背五城关，旁连七宝山。\n楚臣经夕宿，汉代入辰湾。\n花县成阴了，桃源觅路还。\n功名归晚节，矍铄上清班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送清坚老人宰辰阳四首 其四","author":"王质","text":"穴出丹砂粒，川呈晕角辉。\n向来曾画诺，此去稍斜飞。\n若不吟红药，还应对紫薇。\n太公虽白发，西伯要同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽李平仲二首 其一","author":"王质","text":"杳杳归无极，茫茫恨有馀。\n九原那可作，万事总成虚。\n汀草何尝歇，云山亦自如。\n此回真定别，无雁可传书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽李平仲二首 其二","author":"王质","text":"穷达皆昨梦，死生同一波。\n幻身非我有，薄俗奈渠何。\n霜树柯茎少，江湖洲渚多。\n老来不禁泪，未忍过怀坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽吴节夫二首 其一","author":"王质","text":"古道在今世，今人离古心。\n延陵存一老，元祐得遗音。\n乐善稻粱熟，忧民江海深。\n二毛方五马，当代阻为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽吴节夫二首 其二","author":"王质","text":"生死一大事，圣贤三致思。\n朝闻应夕可，春叶又秋枝。\n高眼世无比，点头人有谁。\n朔风吹槁野，天地亦含悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠程元鼎二首 其一","author":"王质","text":"邂逅识程子，牵连怀老坡。\n山林深自引，琴剑肯来过。\n春事已如许，客情将若何。\n舟行相风色，江面水方波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠程元鼎二首 其二","author":"王质","text":"杜宇正呼急，程君来告辞。\n自怜吾老矣，敢问子何之。\n起柁指行在，求官鸣有司。\n归来定何日，秋事以为期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆张安国","author":"王质","text":"天上足官府，舍人何处归。\n世情伤幻化，道眼羡空飞。\n易合谁终始，难言有是非。\n九原如可作，来共立斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李南卿西归求语以赠行山谷偈云八万四千关捩子与君一个锁匙开仆亦有一个锁匙谨以奉赠","author":"王质","text":"之子何方去，荆江上渚宫。\n颇知君笔力，能嗣我宗风。\n境熟拈来是，心圆触处通。\n赠之一转语，收了万年功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠同省访别","author":"王质","text":"咳唾相闻地，江湖各一天。\n所思无物似，此去有人怜。\n身远何能近，心宽自觉便。\n难言知几许，回首意茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠日者","author":"王质","text":"自堕胞胎里，难逃造化中。\n一毫皆有数，三昧即无穷。\n消息深深见，机缄了了通。\n君能希八九，亦足问元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏芦","author":"王质","text":"高致想江湖，当庭植小芦。\n清风时自至，绿竹兴何殊。\n溉灌情偏重，琴尊赏不孤。\n朗吟应有趣，潇洒十馀株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡秉彝归毗陵","author":"王质","text":"千林秋叶深，此际有行人。\n握手恨无语，出门愁始新。\n殷勤一枝柳，聚散百年身。\n眺远情何极，兹来迹已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西斋落成呈荣茂世","author":"王质","text":"主人乞我短窗明，推挽清风堕两楹。\n千里坐安双脚稳，万金难买一轩清。\n扫除旧念无遗恨，收拾新工上短檠。\n幸有诸郎共料理，紧催灯火赴功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽居","author":"王质","text":"春跗秋萼以时开，尔自野生吾懒栽。\n有饭故须间菘韭，无羹安用著盐梅。\n云苍云白变复变，雨旧雨今来不来。\n杉露松霜皆我酒，竹根木瘿尽吾杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜读书三首 其一","author":"王质","text":"不须薄浣少纤尘，时复閒行更脚轻。\n树有凉声常摵摵，灯无热意但荧荧。\n土松瘦菜从头长，地净幽泓澈底清。\n月化日迁人不觉，却于草木见先惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜读书三首 其二","author":"王质","text":"縠纹绝似瀼西生，霜沫全如漱玉清。\n稍定心源渟夜气，即开耳界度秋声。\n旁观事有千端异，返照身无一点轻。\n一醉等閒千日过，清江安用白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜读书三首 其三","author":"王质","text":"无嫌乌帽走黄尘，尘外尘中总有人。\n口但轻轻吹鸟毳，肠休轧轧转车轮。\n漫张明月清风眼，试玩游丝落絮身。\n半夜妙心花忽发，十方一刹现浑银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀野亭观雪","author":"王质","text":"不见湘娥十二鬟，谁移白发上青山。\n云开上界珠宫阙，风堕游仙玉佩环。\n洄曲城孤千骑入，山阴兴尽一蓑还。\n万松岭下寒溪口，遥想梅花露半斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从陈阜卿游翠岩","author":"王质","text":"马轻人健有秋容，飞到千岩万壑中。\n古殿含风寒佛骨，峻屏揭水注龙宫。\n行深野屦沾空翠，睡醒僧檐转晚红。\n弹指山川变光景，横江旌吹拥元戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张安国闻捷","author":"王质","text":"两京乔木久秋风，甘露棠梨非汉宫。\n铁凤雕零周庙古，玉鱼流落汉陵空。\n朝催战鼓云埋阵，夜发戈船月照篷。\n宣德楼前清御道，明年元会纳群工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡湖过大浩寺","author":"王质","text":"乱莎茁茁水皴皴，红叶黄花各自春。\n隔竹歌呼知叟醉，倚松疏懒见僧真。\n有时柏子捎衣落，无数松枝刺眼频。\n山顶斜阳才惨淡，草颠多露已横陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李平仲出郊","author":"王质","text":"渡头脆柳不堪攀，岭背彫枫尚见斑。\n店小青旗低拂马，寺荒苍藓暗封关。\n但知鱼乐如吾乐，未必僧閒似我閒。\n忽忆去年今日处，楚山欲尽见秦山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张元亮见访留和坐客","author":"王质","text":"杯盘仓卒但随家，所赖龙山得孟嘉。\n略以诗声知律吕，敢于学海望津涯。\n精神霜后千头橘，风味新时一颗瓜。\n发白未应馀子识，汗青当有后人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江西道中","author":"王质","text":"落日平西树起烟，乱山缺处水连天。\n城楼突兀栖云表，树影参差落眼前。\n倒引归心缠客病，欲随飞鸟渡平川。\n不辞茧足投微径，慰藉征行有晚蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林溪中阻风","author":"王质","text":"扁舟西去苦匆匆，底事天回柂尾风。\n仓卒未应旗转脚，殷勤聊借浦栖鸿。\n半山烟雨骎骎暗，两岸霜林故故红。\n得意轻帆休笑我，去来等是一孤篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代虞枢密宴晁制置口号二首 其一","author":"王质","text":"合奏元和鼓吹声，旌幢交映两辕门。\n中台上相官仪重，大国诸侯礼数尊。\n一会星辰朝北极，八方风雨聚西坤。\n今朝宾主周旋地，千古英豪气象昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代虞枢密宴晁制置口号二首 其二","author":"王质","text":"陈雷胶漆自平生，申甫藩宣共此行。\n夷则黄钟相律吕，南箕北斗对高明。\n蛟螭鳞甲摇千纛，虎豹牙须立万兵。\n千载难逢今日会，一杯且为故人倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和虞相喜雪二首 其一","author":"王质","text":"缟夜寒辉花雨天，洒空飞羽箭离弮。\n普开薝卜诸天供，大展兜罗万里绵。\n见在十方惟此佛，后来千古说今年。\n乾坤正赖君调理，未用轻寻范蠡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和虞相喜雪二首 其二","author":"王质","text":"六花飞堕九重天，冻折旌竿裂弩弮。\n不夜尝衔九龙烛，未春先贡八蚕绵。\n暂开晴色供前日，复作奇祥饯故年。\n留得馀生食贱麦，杨林江上海楼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别虞丞相二首 其一","author":"王质","text":"太仓宇宙久陈陈，合与英豪共作新。\n修造凤楼须有手，住持乌寺可无人。\n千官礼绝三司贵，一士心归万国春。\n藉与八风吹六翮，飞腾意度不无神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留别虞丞相二首 其二","author":"王质","text":"禹迹茫茫海会同，有谁管领自西东。\n侧身江汉归无所，开眼乾坤见有公。\n隐几三思筹去住，历阶再拜叩穷通。\n朝家有意寻幽侧，人在风烟惨淡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题山亭","author":"王质","text":"马喜名山去不停，半鞭驰度两峰青。\n飞来山鸟能言语，老去江梅尚典型。\n溪女半扉撩倦客，野僧三肃上孤亭。\n百滩流水苍烟上，倚尽斜阳且更听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]