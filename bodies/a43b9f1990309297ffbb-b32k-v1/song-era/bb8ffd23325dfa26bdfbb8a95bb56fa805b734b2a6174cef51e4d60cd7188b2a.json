[{"title":"洛头书事","author":"陈与义","text":"纶巾古鹤氅，日暮槲林间。\n谁使翁迎客，应闻屐响山。\n占年又得熟，劝我不须还。\n村酒困壮士，水风吹醉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴陈留二首 其二","author":"陈与义","text":"马上摩挲眼，出门光景新。\n鸦鸣半陂雪，路转一林春。\n旧岁有三日，全家无十人。\n平生鹦鹉盏，今夕最关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕钦问监酒受代归","author":"陈与义","text":"以我千金帚，逢君万斛船。\n要知穷有自，未觉懒相先。\n盆盎三年梦，篇章四海传。\n匆匆秣归马，离恨满霜天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张迪功赴南京掾 其二","author":"陈与义","text":"岸阔舟仍小，林空风更多。\n能堪几寒暑，又作隔山河。\n看客休题凤，将书莫换鹅。\n功名大槐国，终要白鸥波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张迪功赴南京掾 其一","author":"陈与义","text":"士固难推挽，君其自宠珍。\n诗成建安子，名到斗南人。\n晚岁还为客，微官只为身。\n向来书尽熟，去不愧张巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客出城西","author":"陈与义","text":"邓州谁亦解丹青，画我羸骖晚出城。\n残年政尔供愁了，末路那堪送客行。\n寒日满川分众色，暮林无叶寄秋声。\n垂鞭归去重回首，意落西南计未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送善相僧超然归庐山","author":"陈与义","text":"九叠峰前远法师，长安尘染坐禅衣。\n十年依旧双瞳碧，万里今持一笑归。\n鼠目向来吾自了，龟肠从与世相违。\n酒酣更欲烦公说，黄叶漫山锡杖飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送熊博士赴瑞安令","author":"陈与义","text":"衣冠衮衮相逢地，草木萧萧未变时。\n聚散同惊一枕梦，悲欢各诵十年诗。\n山林有约吾当去，天地无情子亦饥。\n笑领铜章非失计，岁寒心事欲深期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适远","author":"陈与义","text":"处处非吾土，年年备虏兵。\n何妨更适远，未免一伤情。\n石岸烟添色，风滩暮有声。\n平生五字律，头白不贪名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳","author":"陈与义","text":"去岁重阳已百忧，今年依旧叹羁游。\n篱底菊花唯解笑，镜中头发不禁秋。\n凉风又落宫南木，老雁孤鸣汉北州。\n如许行年那可记，谩排诗句写新愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻王道济陷虏","author":"陈与义","text":"海内堂堂友，如今在贼围。\n虚传袁盎脱，不见华元归。\n浮世身难料，危途计易非。\n云孤马息岭，老泪不胜挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜","author":"陈与义","text":"畴昔追欢事，如今病不能。\n等闲生白发，耐久是青灯。\n海内春还满，江南砚不冰。\n题诗饯残岁，钟鼓报晨兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜二首 其一","author":"陈与义","text":"城中爆竹已残更，朔吹翻江意未平。\n多事鬓毛随节换，尽情灯火向人明。\n比量旧岁聊堪喜，流转殊方又可惊。\n明日岳阳楼上去，岛烟湖雾看春生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"陈与义","text":"远游万事裂，独立数峰青。\n明月照山木，荒村饶夜萤。\n翻翻云渡汉，历历水浮星。\n遥舍灯已尽，幽人门未扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜 其一","author":"陈与义","text":"闲弄玉如意，天河白练横。\n时无李供奉，谁识谢宣城。\n两鹤翻明月，孤松立快晴。\n南阳半年客，此夜满怀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓发杉木","author":"陈与义","text":"古泽春光淡，高林露气清。\n纷纷世上事，寂寂水边行。\n客子凋双鬓，田家自一生。\n有诗还忘记，无酒却思倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翁高邮挽诗","author":"陈与义","text":"万里功名路，三生翰墨身。\n暮年铜虎重，浮世石羊新。\n天地悭豪杰，山川泣吏民。\n空传四十诔，竟不识斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪粹翁举酒于君子亭下海棠方开","author":"陈与义","text":"世故驱人殊未央，聊从地主借绳床。\n春风浩浩吹游子，暮雨霏霏湿海棠。\n去国衣冠无态度，隔帘花叶有辉光。\n使君礼数能宽否，酒味撩人我欲狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿资圣院阁","author":"陈与义","text":"暮投山崦寺，高处绝人群。\n远岫林间见，微泉舍后闻。\n阁虚云乱入，江阔野横分。\n欲与僧为记，今年懒作文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄季申","author":"陈与义","text":"雨歇城南泥未乾，遥知独立整衣冠。\n旧时邺下刘公干，今日辽东管幼安。\n绿阴展尽身犹远，黄鸟飞来节已阑。\n安得一樽生耳热，暂时相对说悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄信道","author":"陈与义","text":"衡山未见意如飞，浩荡风帆不可期。\n却忆府中三语掾，空吟江上四愁诗。\n高滩落日光零乱，远岸丛梅雪陆离。\n剩欲平分持寄子，白头才尽只成悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄新息家叔","author":"陈与义","text":"风雨淮西梦，危魂费九升。\n一官遮日手，两地读书灯。\n见客深藏舌，吟诗不负丞。\n竹林虽有约，门户要人兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄德升大光","author":"陈与义","text":"君王优诏起群公，也寘樵夫尺一中。\n易著青衫随世事，难将白发犯秋风。\n共谈太极非无意，能系苍生本不同。\n却倚紫阳千丈岭，遥瞻黄鹄九霄东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"康州小舫与耿伯顺李德升席大光郑德象夜语以更长爱烛红为韵得更字","author":"陈与义","text":"万里衣冠京国旧，一船风雨晋康城。\n灯前颜面重相识，海内艰难各饱更。\n天阔路长吾欲老，夜阑酒尽意还倾。\n明朝古峡苍烟道，都送新愁入橹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得长春两株植之窗前","author":"陈与义","text":"乡邑已无路，僧庐今是家。\n聊乘数点雨，自种两丛花。\n篱落失秋序，风烟添岁华。\n衰翁病不饮，独立到栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得张正字诗","author":"陈与义","text":"送老茅屋底，天寒人迹稀。\n一觞犹有味，万事已无机。\n岁暮塔孤立，风生鸦乱飞。\n此时张正字，书札到郊扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得席大光书因以诗迓之","author":"陈与义","text":"十月高风客子悲，故人书到暂开眉。\n也知廊庙当推毂，无奈江山好赋诗。\n万事莫论兵动后，一杯当及菊残时。\n喜心翻倒相迎地，不怕荒林十里陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"陈与义","text":"畎亩意不释，出门聊散忧。\n雨馀山欲近，春半水争流。\n众籁夕还作，孤怀行转幽。\n溪西篁竹乱，微径杂归牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步顺阳门外","author":"陈与义","text":"六尺枯藜了此生，顺阳门外看新晴。\n树连翠筱围春昼，水泛青天入古城。\n梦里偶来那计日，人间多事更闻兵。\n只应千载溪桥路，欠我媻姗勃窣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明","author":"陈与义","text":"雨晴闲步涧边沙，行入荒林闻乱鸦。\n寒食清明惊客意，暖风迟日醉梨花。\n书生投老王官谷，壮士偷生漂母家。\n不用鞦韆与蹴游，只将诗句答年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食","author":"陈与义","text":"草草随时事，萧萧傍水门。\n浓阴花照野，寒食柳围村。\n客袂空佳节，莺声忽故园。\n不知何处笛，吹恨满清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓居刘仓廨中晚步过郑仓台上","author":"陈与义","text":"纱巾竹杖过荒陂，满面东风二月时。\n世事纷纷人老易，春阴漠漠絮飞迟。\n士衡去国三间屋，子美登台七字诗。\n草绕天西青不尽，故园归计入支颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散发","author":"陈与义","text":"百年如寄亦何为，散发清狂未足非。\n南涧题诗风满面，东桥行药露沾衣。\n松花照夏山无暑，桂树留人吾岂归。\n藜杖不当轩盖用，稳扶居士莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾徽言运判出张生所画马","author":"陈与义","text":"槃礴解衣处，胸中应不群。\n未呈千里足，空见五花文。\n良乐世难有，骥驽谁与分。\n高才喜能事，故遣画兰筋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"棋","author":"陈与义","text":"长日无公事，闲围李远棋。\n傍观真一笑，互胜不移时。\n幸未逢重霸，何妨著献之。\n晴天散飞雹，惊动隔墙儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡江","author":"陈与义","text":"江南非不好，楚客自生哀。\n摇楫天平渡，迎人树欲来。\n雨馀吴岫立，日照海门开。\n虽异中原险，方隅亦壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游八关寺后池上","author":"陈与义","text":"落日生春色，微澜动古池。\n柳林横绝野，藜杖去寻诗。\n不有今年谪，争成此段奇。\n殷勤雪颅老，随客转荒陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登岳阳楼 其一","author":"陈与义","text":"洞庭之东江水西，帘旌不动夕阳迟。\n登临吴蜀横分地，徙倚湖山欲暮时。\n万里来游还望远，三年多难更凭危。\n白头吊古风霜里，老木沧波无恨悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答元方述怀作","author":"陈与义","text":"不见圆机论九流，纷纷骑鹤上扬州。\n令之敢恨松桂冷，君叔但伤蒲柳秋。\n汝海蛇杯应已悟，襄陵驹隙竟难留。\n来牛去马无穷债，未盖棺前盍少休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢杨工曹","author":"陈与义","text":"借屋三间稍离尘，携书一束谩娱身。\n客居最负青春好，世事空随白发新。\n造化小儿真薄相，市朝大隐亦长贫。\n独无芋粟供宾客，虚辱先生赋北邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋任才仲画两首 其一","author":"陈与义","text":"远游吾不恨，扁舟载幅巾。\n山色暮暮改，林气朝朝新。\n野客初逢句，薄暮欲生春。\n因知子任子，胸怀非世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道山宿直","author":"陈与义","text":"离离树子鹊惊飞，独倚枯筇无限时。\n千丈虚廊贮明月，十分奇事更新诗。\n人间路绝窗扉语，天上云空阁影移。\n遥想王戎烛下算，百年辛苦一生痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中","author":"晁冲之","text":"雨子收还急，溪流直又斜。\n迢迢旁山路，漠漠满林花。\n破水双鸥影，掀泥百草芽。\n川原有高下，随处着人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中寒食","author":"陈与义","text":"飞絮春犹冷，离家食更寒。\n能供几岁月，不办了悲欢。\n刺史蒲萄酒，先生苜蓿盘。\n一官违壮节，百虑集征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中寒食","author":"詹慥","text":"斗粟淹吾驾，浮云笑此生。\n有诗酬岁月，无梦到功名。\n客里逢归雁，愁边有乱莺。\n杨花不解事，更作倚风轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中","author":"陈与义","text":"醉中今古兴衰事，诗里江湖摇落时。\n两手尚堪杯酒用，寸心唯是鬓毛知。\n稽山拥郭东西去，禹穴生云朝暮奇。\n万里南征无赋笔，茫茫远望不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愚溪","author":"陈与义","text":"小阁当乔木，清溪抱竹林。\n寒声日暮起，客思雨中深。\n行李妨幽事，栏干试独临。\n终然游子意，非复昔人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀","author":"陈与义","text":"少日争名翰墨场，只今扶杖送斜阳。\n青青草木浮元气，渺渺山河接故乡。\n作吏不妨三折臂，搜诗空费九回肠。\n子房与我同羁旅，世事千般酒一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览 其二","author":"陈与义","text":"鸟语知公乐，晴山及我游。\n尽排物外事，拚作酒中浮。\n菊蕊离双鬓，林声隐四愁。\n骚人例喜赋，政自不关秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览 其四","author":"陈与义","text":"一笑聊开口，千忧不上眉。\n林深受风得，柏老到霜知。\n小憩逢筠洞，幽寻及枳篱。\n愿公勤秉烛，裁咏枣离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览 其一","author":"陈与义","text":"岁月移文外，乾坤杖屦中。\n铿然五字律，健在百夫雄。\n秋入池深碧，寒欺叶递红。\n此间兼吏隐，端不减游嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谨次十七叔去郑诗韵二章以寄家叔一章以自咏 其三","author":"陈与义","text":"镜中无复故人怜，却愧谋生后计然。\n叔夜本非堪作吏，元龙今悔不求田。\n怀亲更值薪如桂，作客重看栗过拳。\n万事巧违高枕卧，忧来一夕费三迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寥落","author":"陈与义","text":"寥落洞庭野，微风泛客裾。\n袁宏咏史罢，孙登清啸馀。\n月明流水去，夜静芙蓉舒。\n城郭方多事，野兴一萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫郎","author":"陈与义","text":"漫郎功业大悠然，拄笏看山了十年。\n黑白半头明镜里，丹青千树恶风前。\n星霜屡费惊人句，天地元须使鬼钱。\n踏破九州无一事，只今分付结跏禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾","author":"陈与义","text":"雨过无桃李，唯馀雪覆墙。\n青天映妙质，白日照繁香。\n影动春微透，花寒韵更长。\n风流到尊酒，犹足助诗狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题小室","author":"陈与义","text":"暂脱朝衣不当闲，澶州梦断已多年。\n诸公自致青云上，病客长斋绣佛前。\n随意时为师子卧，安心懒作野狐禅。\n炉烟忽散无踪迹，屋上寒云自黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东家壁","author":"陈与义","text":"斜阳步屧过东家，便置清樽不煮茶。\n高柳光阴初罢絮，嫩凫毛羽欲成花。\n群公天上分时栋，闲客江边管物华。\n醉里吟诗空跌宕，借君素壁落栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题甘泉书院","author":"陈与义","text":"甘泉坊里林影黑，吴氏舍前书榜鲜。\n床座略容摩诘借，桂枝应待小山传。\n兵横海内犹纷若，风到湖南还穆然。\n勉效周生述孔业，赋诗吾独愧先贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题许道宁画","author":"陈与义","text":"满眼长江水，苍然何郡山。\n向来万里意，今在一窗间。\n众木俱含晚，孤云遂不还。\n此中有佳句，吟断不相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡岳道中 其一","author":"陈与义","text":"野客元耕崧岳田，得游衡岳亦前缘。\n避兵径度吾岂忍，欲雨还休神所怜。\n世乱不妨松偃蹇，村空更觉水潺湲。\n非无拄杖终伤老，负此名山四十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠傅子文","author":"陈与义","text":"渔子牧儿谈笑新，先生胜日步湖漘。\n沙边忽见长身士，头上仍攲折角巾。\n豺虎不能宽远俗，山川终要识诗人。\n芦丛如画斜阳里，拄杖相寻无杂宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠漳州守綦叔厚","author":"陈与义","text":"过尽蛮荒兴复新，漳州画戟拥诗人。\n十年去国九行旅，万里逢公一欠伸。\n王粲登楼还感慨，纪瞻赴召欲逡巡。\n绳床相对有今日，剩醉斋中软脚春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行晚兴","author":"陈与义","text":"曾听石楼水，今过邵州滩。\n一笑供舟子，五年经路难。\n云间落日淡，山下东风寒。\n烟岭丛花照，夕湾群鹭盘。\n生身后圣哲，随俗了悲欢。\n淹旅非吾病，悠悠良足叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自五月二日避寇转徙湖中复从华容道乌沙还郡七月十六日夜半出小江口宿焉徙倚柁楼书事十二句","author":"陈与义","text":"回环三百里，行尽力都穷。\n巴丘左移右，章华西转东。\n江声摇斗柄，秋色弥葭丛。\n群木立波上，芙蕖披月中。\n镜湖应足比，剡溪那可同。\n世将非识事，孤啸聊延风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题兖州孙大夫绝尘亭二首 其一","author":"陈与义","text":"不读远游赋，放怀兹地宜。\n云山绕窗户，万态争纷披。\n世故日已远，风水方逶迤。\n倚杖夜来雨，东山烟散迟。\n人间许长史，不与此心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴野望","author":"陈与义","text":"洞庭微雨后，凉气入纶巾。\n水底归云乱，芦丛返照新。\n遥汀横薄暮，独鸟度长津。\n兵甲无归日，江湖送老身。\n悠悠只倚杖，悄悄自伤神。\n天意苍茫里，村醪亦醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]