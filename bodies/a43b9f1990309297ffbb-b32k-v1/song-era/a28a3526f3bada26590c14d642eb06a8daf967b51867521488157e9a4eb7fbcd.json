[{"title":"禅人并化主写真求赞 其一四○","author":"释正觉","text":"秋山癯而清，秋水瘦而净。\n万法自齐观，一音还普应。\n方圆之器著虚空，随来随与无馀剩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十一","author":"释正觉","text":"痴坐颓然，山空壑乾。\n离微出入，偏正往还。\n千年琥珀之松兮鹤巢梦冷，半夜珊瑚之月兮鲸?波寒。\n全功及尽，借路何难。\n转步而回丛林也津津和气，放口而说河汉也浩浩翻澜。\n道逢作者，谁敢相谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九○","author":"释正觉","text":"灵灵而空，了了而融。\n正偏之机转，佛祖之道同。\n玉井有月，冰壶无风。\n儿孙得力成家事，影现诸尘三昧中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五四","author":"释正觉","text":"视物眼深，说禅口快。\n一点不著虚空，万化谁分器界。\n应众缘而閒六根，入诸尘而住三昧。\n其小无内，其大无外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十二","author":"释正觉","text":"发白寒山有雪，眼深秋井澄波。\n混沌凿那亡大道，昆崙源自发长河。\n一笑十方三世事，不妨随处萨婆诃。\n山高早雪，水深先秋。\n功勋极处退一步，黑白前时赢一筹。\n相随来也还知否，南北东西得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三六","author":"释正觉","text":"岩岩之骨兮山癯，靡靡之姿兮水腴。\n心无住而乃久，德有邻而不孤。\n虚空说法，顽石听徒。\n互换證明还了了，何烦佛祖费工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九三","author":"释正觉","text":"幻起有形，智空无名。\n秋生月窟，云变乾城。\n摩娑百战胝瘢旧，向道而今老太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八二","author":"释正觉","text":"贫眉似促，饥眼觉大。\n口噤禅游，鼻通气快。\n心不萌个处转机，卦未兆阿谁来买。\n应世随缘，龊家得彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八○","author":"释正觉","text":"画者不相出脱，转见面皮丑恶。\n蜂采百华春不饥，兔饮长河夜不渴。\n无事而禅，待缘而作。\n一机一警谁与知，百发百中弦衔筈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十四","author":"释正觉","text":"须发衰白，雪点寒林。\n眉目冷青，秋生古涧。\n应之有馀，用之何限。\n风浪不管兮闲似浮鸥，水天相连兮远随归雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二四","author":"释正觉","text":"霜洗斗魁，秋生河汉。\n形夭矫而长松参云，气澄明而馀潦退岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八九","author":"释正觉","text":"默握犛尾，谁撩虎须。\n天水连秋色，魁杓夜转枢。\n应兮鉴像，答兮谷呼。\n森罗万像，纵横也俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十四","author":"释正觉","text":"心空月高，发白雪饶。\n气吞百川兮其口如海，浪卷万里兮其舌翻潮。\n一句直指，三乘独超。\n忽雷破蛰起平地，赤脚踏虹登九霄。\n影草笑无术，烂柯知有樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六一","author":"释正觉","text":"曹洞宗乘，老难发兴。\n秋波摇眼角，春雪点眉棱。\n一步跨空劫，孤心相续灯。\n西母之桃兮秀结三千年实，北冥之鲲兮蜕翔九万里鹏。\n珊瑚枝枝撑著月，出格云门跛脚僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三四","author":"释正觉","text":"说得一尺，行得一尺。\n身非肉团，心如墙壁。\n用光眉十方，照世眼双碧。\n诸尘三昧兮在我自然，万像森罗兮与渠平出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四一","author":"释正觉","text":"寒岩著雪，老木含春。\n独灵空劫眼，不碍肉团身。\n枯禅三椽兮自守其默，豁净四壁兮谁管其贫，森罗万像兮根根尘尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○六","author":"释正觉","text":"形骸槁如，林壑深居。\n衰发雪松白，閒情霜竹虚。\n智游空劫珠胎蚌，妙应因缘井觑驴。\n豹雾之虎，龙雷之鱼。\n黄梅衣钵绳绳信，卢老心传不识书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五五","author":"释正觉","text":"木老春何晚，山寒秋最先。\n渊默有佳处，湛存天地前。\n静亡所住，动解随缘。\n黄芦淮上东西岸，明月渡头南北船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十九","author":"释正觉","text":"凄然而秋，眼冷心休。\n温然而春，口笑眉伸。\n了了无分别智，恢恢不思议仁。\n亡机返朴，得用还淳。\n图画之巧，那有其神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六三","author":"释正觉","text":"颠毛如许白，面孔较些肥。\n寒松偃蹇兮雪在顶，枯山癯瘠兮春添衣。\n据床握杖，雷吼电飞。\n光痕已露也，是谁见几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八五","author":"释正觉","text":"枯槁形骸，虚明性怀。\n秋河夜月，老树苍崖。\n一机色前自宛转，万像头上谁安排。\n云门拄杖，赵州草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○三","author":"释正觉","text":"形声幻为，闻见智随。\n自然出碍，平等何疑。\n瑩明而绝累，圆应而无疵。\n而今问你，且道是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七","author":"释正觉","text":"身閒类莫收，心静情不流。\n片月自炯炯，孤云长悠悠。\n颠毛衰白高山雪，眉目寒清古涧秋。\n把似春风些子妙，施于草木十方周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四","author":"释正觉","text":"渊默湛存，道超见闻。\n真照本有，妙尽新勋。\n虚谷之神兮大千界满，明月之影兮百亿身分。\n无住也浮萍流水，自由也飞鸟行云。\n得之有据，用之不勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八八","author":"释正觉","text":"肌骨瘦寒，气貌衰残。\n坐冷秋生河阔，心空月堕潮乾。\n善财游历百城了，楼阁门开指一弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三二","author":"释正觉","text":"发雪毵毵，心老憨憨。\n指南话北，破二作三。\n守宗风之符节，握佛祖之锤钳。\n陶形铸器模楷妙，迸火流金炉鞴炎。\n光明不断，灯灯夜龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六○","author":"释正觉","text":"额高耸骨，眼深藏神。\n诸缘㳷合，一默真醇。\n自得混成物我，谁能碎折根尘。\n不来而来不见见，会有知音彼上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七四","author":"释正觉","text":"眉眼分明，风柳柔青。\n心胆纯一，野华吐赤。\n了无物碍自由人，还得观音妙智力。\n连城不割谁肯休，相如却夺秦王璧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九九","author":"释正觉","text":"湛存不浑，灵明不昏。\n派分河汉底，流决昆崙源。\n见闻了成一相，影响应空六根。\n体本真如，能来生灭之界。\n用随生灭，却入真如之门。\n丛林参饱三条篾，云梦等闲八九吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九六","author":"释正觉","text":"松老皮皴，竹癯节棱。\n发白远山雪，心明长夜灯。\n回机历历，随用腾腾。\n因缘妙触初无碍，个是玲珑岩下僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四九","author":"释正觉","text":"理极非身，智明自神。\n三缘未作，一默含纯。\n回途异类，出历诸尘。\n弯弯月下涟漪水，剪剪风斜杨柳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一六","author":"释正觉","text":"目瞳秋炯炯，颠发雪毵毵。\n饭塞肚皮饱，茶湔舌颊甘。\n龊家有彩，机事无堪。\n白牯釐奴却知有，而今赢得放痴憨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九八","author":"释正觉","text":"野雪发须，秋山肌肤。\n物齐芳蝶梦，情尽露蝉枯。\n迹弭水归海，光回星转枢。\n言前荐得犹封壳，喝下承当又触途。\n天上天下，只个规模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六三","author":"释正觉","text":"妙而不有，空而不无。\n坐寒床下板，步转劫前壶。\n返色光初发，知音德不孤。\n流长信是盈科水，盘走端如受影珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六九","author":"释正觉","text":"坐忘是非，默见离微。\n佛祖之陶冶，天地之范围。\n髑髅眉底眼，空劫句中机。\n青原赭色麒麟步，药峤金毛师子威。\n相逢捉手，大道同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九四","author":"释正觉","text":"五叶之华，三斤之麻，外无棱角兮中无孽芽。\n箭石不是虎，酒弓不是蛇，千里之失兮毫釐之差。\n得非思议兮自谓一曲之士，望绝涯畛兮人称大方之家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五九","author":"释正觉","text":"云水孤藤，丛林老僧。\n澜翻口角，雪点眉棱。\n长春时节相联蕊，破夜光明自照灯。\n内无丝而系蚁，外无糁而聚蝇。\n不起灭定，能应繁兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九五","author":"释正觉","text":"雪颠未乾，秋波更寒。\n云门舌不短，百丈鼻犹酸。\n心传一灯自光燄，口翻四海看波澜。\n间关半世，经历百难。\n报道头家休喝彩，而今双六已居盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五三","author":"释正觉","text":"明白无根，茫茫月魂。\n清虚不浑，苍苍秋痕。\n青天固可背负，诸佛等闲口吞。\n情空超物物，妙触应门门。\n了知初不由心念，金色头陀灭意根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八八","author":"释正觉","text":"据胡床，握麈柄。\n句中起倒，机头偏正。\n真得出思议，妙应亡眺听。\n彻二仪万象根源，识诸佛历代性命。\n曲直逆顺兮任纵任横，长短方圆兮何少何剩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"超然居士得得问道于宝峰祥禅师且欲归歌长篇以谢予偕其行见挽以和渍笔说句继之","author":"释正觉","text":"门门通彻长安道，信手拈来还恰好。\n脚跟踏著赵州关，丈六金身一茎草。\n我初相会个中人，法法圆通见怀抱。\n杖屦追随来道场，不学痴禅事关扫。\n青山白云一径通，行行鸟道谁寻讨。\n宝峰师是马馰儿，相得而今恨不早。\n吸尽西江居士庞，唤回竖指俱胝老。\n泥牛力耕空劫春，木人捧出形山宝。\n罢捋虎须归去来，荆棘林中任起倒，午日丽天光杲杲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"像维那写老病阿师像请赞","author":"释正觉","text":"芙蓉之枝，丹山之儿。\n一丝联自信，三昧约谁知。\n珊瑚寒月堕影，琥珀老松流滋。\n诸缘豁净兮山空秋壮，万态变通兮华丽春脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解兄之雪峰礼本师","author":"释正觉","text":"南山去见雪峰师，古涧寒泉瞪目时。\n彻底无痕才识己，转身有路复名谁。\n子归父处那求顾，云向山来不待吹。\n西舍机鸣聊织锦，梭脐阴阴细飞丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解首座职事书记相招以偈力辞","author":"释正觉","text":"原鸰能作归呼音，暮风堕叶秋在林。\n路沙漠漠水潏潏，夜色冉冉山阴阴。\n坐冠多士自省短，挽袂乃友相知深。\n乞与高閒偿夙歉，闭门稳卧舒疲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端禅人丐盐求颂","author":"释正觉","text":"红炉焰里结冰霜，收拾侬家妙有方。\n舌本要资云水味，鼻端相助蕨薇香。\n扫归茅舍閒堆雪，坐照金盘净发光。\n去去道人成底事，芳滋许我沃枯肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"箨庵颂","author":"释正觉","text":"玉龙退残鳞，编庵事枯兀。\n禅栖锦凤巢，道履霜蟾窟。\n饮兹明月津，濯彼微尘骨。\n五叶少林春，家风未湮没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"璋监寺写师像求赞","author":"释正觉","text":"杳杳冥冥，寒雁影没而秋远烟青。\n寂寂惺惺，老蚕茧就而风高叶零。\n天机静时活，道环虚处灵。\n瀛之涵，崧之镇。\n乾之健，坤之宁。\n海运鹏抟，气宇扬扬而吞舟鱼蜕。\n雾披豹变，文章炳炳而啸风虎猛。\n少林之灯未续兮，洛阳人腰齐雪庭。\n黄梅之衣欲传兮，狤獠祖步移碓程。\n物不当情而冰凌脚快，鳞或烧尾兮电火气腥。\n诸尘峥嵘乎影响，三昧游戏于眺聆。\n跛跛挈挈也其行自信，哆哆和和也其言不轻。\n家法冷淡，子孙宁馨。\n心岁寒而松柏试雪，色清白兮河汉含星。\n鸣阴之鹤癯而寿，巢莲之龟小而龄。\n棋局未散，柯烂樵丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薄了固保义写予真请赞","author":"释正觉","text":"灵灵而真，默默而神。\n眉毛低盖眼，鼻孔直欺唇。\n千华上何须问佛，百草头自然有春。\n一微尘里也来说法，三千界内不碍分身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞芙蓉师祖真","author":"释正觉","text":"凤眼鹤形，宗门伟匠。\n量外提撕，声前敲唱。\n据令兮长剑倚天，应机兮明珠在掌。\n太虚有月兮老兔含霜，大海无风兮华鲸吹浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞法云升律师","author":"释正觉","text":"云容閒而未收，月魄湛而不流。\n严净身器也依律而住，虚明神宇也唯道而游。\n凛凛清姿兮颠毛覆雪，寥寥霁色兮心鉴含秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙湛大师求颂","author":"释正觉","text":"妙则不粗，湛则不浑。\n妙湛而照，瑩然亡痕。\n云山是主，水月无根。\n瘦坐一默，虚融六门。\n窍作风籁，华含春恩。\n相承个事，子子孙孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其四十二","author":"释正觉","text":"鸟之行空，鱼之在水。\n江湖相忘，云天得志。\n拟心一丝，对面千里。\n知恩报恩，人间几几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其十六","author":"释正觉","text":"大地火发，间不容发。\n南海昆崙，天寒不袜。\n祖祖相传，一头搕?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其十二","author":"释正觉","text":"识法者惧，欺敌者亡。\n水中辨乳，须是鹅王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二十一首 其一","author":"释正觉","text":"如今推也，是子是贼。\n买帽相头，食鱼去骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九三","author":"释正觉","text":"诸见若尽，慎勿追寻。\n才有是非，纷然失心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十七","author":"释正觉","text":"生灭去来，本如来藏。\n清净妙明，虚融通畅。\n六门我绝，攀缘三界。\n渠无身相，无生路上。\n底人识取，万回和尚。\n持钵归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十九","author":"释正觉","text":"渊默之得，不可文墨。\n流应之功，不可形容。\n秋入野水，月行霁空。\n影像名字，且唤天童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○一","author":"释正觉","text":"龟兮蓍兮，祛执决疑。\n师兮范兮，扶斜理差。\n定彻其底，慧穷其涯。\n箭撞筈破，珠旋影随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六八","author":"释正觉","text":"识得本真，不随生灭。\n霁云磨空，秋波濯月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○二","author":"释正觉","text":"默成其性，慧润其定。\n虚应六窗，观通三径。\n善巧开权，触机堕阱。\n怪杀者僧，药多成病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三印颂示众 其三","author":"释正觉","text":"印水印泥印空，谁传祖称家风。\n梦眼影迷一色，转身体合全功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三印颂示众 其一","author":"释正觉","text":"印空印水印泥，无言桃李成蹊。\n随分纳些税赋，牧牛溪水东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三印颂示众 其二","author":"释正觉","text":"印泥印空印水，疾雷不及掩耳。\n豁然楼阁门开，消得轻轻弹指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与嵩禅人","author":"释正觉","text":"乌石岭头相见，长生路上常逢。\n正是游山时节，落华芳草蒙茸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]