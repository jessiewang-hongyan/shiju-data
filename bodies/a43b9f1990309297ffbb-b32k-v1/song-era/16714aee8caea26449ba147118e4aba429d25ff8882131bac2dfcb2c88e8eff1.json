[{"title":"春尽遣怀","author":"陆游","text":"袅袅炉香昼掩扉，残年真是解尘鞿。\n青?旋捣通邻好，白葛新裁制暑衣。\n避日小鱼穿藻去，倚风轻燕拂帘飞。\n要知名宦非初意，三十年前已念归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春老","author":"陆游","text":"春色垂垂老，山家处处忙。\n园丁卖菰白，蚕妾采桑黄。\n候雨占秧信，催儿筑麦场。\n醉眠官道上，人为护牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行","author":"陆游","text":"九日春阴一日晴，强扶衰病此闲行。\n猩红带露海棠湿，鸭绿平堤湖水明。\n酒贱柳阴逢醉卧，土肥稻垄看深耕。\n山翁莫道浑无用，解与明时说太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行","author":"陆游","text":"箬帽丝丝雨，芒鞋策策泥。\n柳斜风带北，花敛日平西。\n社酒誇新压，春芜喜遍犁。\n深村无客过，父子自扶携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"陆游","text":"数间茅屋傍枫林，常负平生万里心。\n老去逐年增老病，春来无日不春阴。\n曲尘蘸岸波初涨，猩血团枝色已深。\n欲到东园还懒起，却和残睡听鸣禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"陆游","text":"老境三年病，新春十日阴。\n孤舟镜湖客，万里玉关心。\n出岫云多态，呼风鸟独吟。\n读书惟恐尽，倾酒却愁深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"陆游","text":"窗昏不见字，今日罢观书。\n迹寄浮生内，心游旷劫初。\n太山均蚁垤，圣域亦蘧庐。\n兀坐还成倦，荒畦去荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"陆游","text":"春风浩荡作春阴，弱燕归来不自禁。\n白塔昏昏才半露，青山淡淡欲平沉。\n裘茸细雨初惊湿，屐齿新泥忽已深。\n直怕楼高生客恨，不因病起倦登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴溪上小轩作","author":"陆游","text":"午醉初醒倚钓轩，悠然无与共清言。\n风微仅足吹花片，雨细才能见水痕。\n杳杳暝钟浮远浦，离离烟树识孤村。\n故人万里岷山下，安得书来慰断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春来食不足戏作","author":"陆游","text":"饥卧谁能羡属餍，高怀饱食岂容兼。\n分司禄在终难取，束帛恩深独不沾。\n衰谢形容无药驻，奔驰日月久胶黏。\n儿童拍手看翁醉，山杏溪桃簇帽檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春来食不继戏作","author":"陆游","text":"久卧穷阎困负薪，何妨扫尽太仓陈。\n瘦如饭颗吟诗面，饥似柴桑乞食身。\n牺象未应殊断木，江湖底处有穷鳞。\n大冠长剑人看好，不换茅檐一幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春社有感","author":"陆游","text":"憔悴前朝白发郎，祠庭赋禄玷恩光。\n寸心未与年俱老，万事惟凭酒暂忘。\n穿仗两曾观揖逊，扶犁独幸返耕桑。\n耆年凋落还堪叹，社饮推排冠一乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春近","author":"陆游","text":"历授人时后，天回斗柄初。\n农畴兴耒耜，家塾盛诗书。\n缥缈双凫舄，咿哑一鹿车。\n山翁喜春近，随处狎樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春近","author":"陆游","text":"开禧忽见第三春，身寄枫林野水滨。\n吾道幸逢天道在，物华又与岁华新。\n郊原处处堪行乐，道路人人可问津。\n剩办青鞋并布袜，若耶已报绿生鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春近","author":"陆游","text":"短褐枯筇老病身，龙钟也复喜新春。\n已知不解多年住，且作都无一事人。\n檐角鸟声呼醉梦，室中花气袭衣巾。\n朝来更有欣然处，一箸山蔬胜八珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春近山中即事三首 其二","author":"陆游","text":"节物贫家有故常，春盘腊粥逐时忙。\n悠悠岁月催双鬓，草草鸡豚荐一觞。\n人意自殊平日乐，梅花宁减故时香。\n小园新展西南角，挂树青萝百尺长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春近山中即事三首 其一","author":"陆游","text":"乞得松楠手自栽，结茅聊喜避风埃。\n百年孰与梦长短，万事只如云去来。\n雪后梅花初半吐，身闲樽酒盍频开。\n锦官城外青羊路，常记当年小猎回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春近山中即事三首 其三","author":"陆游","text":"世乱王孙泣路隅，时平野老醉相扶。\n种桤正可三年大，爱竹何曾一日无。\n细路迢迢上云雨，轻舟渺渺入菰蒲。\n暮归剩欲谈幽胜，安得丹青为作图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜","author":"陆游","text":"老惫生如寄，春寒梦亦孤。\n灯花时自坠，枭语迭相呼。\n万里书难得，三年病未苏。\n窗深不知晓，但觉动林乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜","author":"陆游","text":"客向灯前老，愁从枕上生。\n雨声添好睡，花气散馀酲。\n旧事谈谁听，新诗鍊不成。\n惟当速归老，邻父待同耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜读书","author":"陆游","text":"枉是儒冠遇太平，穷人那许共功名。\n枯肠不饱三升稷，皓首犹亲二尺檠。\n寓世已为当去客，爱书更付未来生。\n夜阑抚几愁无奈，起视离离斗柄倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨三首 其一","author":"陆游","text":"狼藉残花满地红，拥衾孤梦雨声中。\n人生十事九堪叹，春色三分二已空。\n但有老盆倾浊酒，不辞衰鬓对青铜。\n长贫博得身强健，久矣无心咎化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨三首 其三","author":"陆游","text":"自笑平生懒是真，闭门高枕动兼旬。\n海棠千片已随水，杜宇一声无复春。\n绿酒盈樽足忘老，朱樱上市正尝新。\n今朝雨止通溪路，又向沙头岸幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"陆游","text":"细雨吞平野，馀寒勒早春。\n未增豪饮兴，先著苦吟身。\n幽径萱芽短，方桥柳色新。\n闭门非为老，半世是闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨二首 其一","author":"陆游","text":"苦雨何时止，微云又作阴。\n傍檐时小立，隐几复微吟。\n枝重残红湿，堤平涨绿深。\n物华元自好，老病负登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"陆游","text":"倚阑正尔受斜阳，细雨霏霏渡野塘。\n本为柳枝留浅色，却教梅蕊洗幽香。\n小沾蝶粉初何惜，暂涩莺声亦未妨。\n造物无心宁遍物，凭谁闲与问东皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨二首 其二","author":"陆游","text":"春愁无处避，春雨几时晴。\n黯黯阴连月，萧萧滴到明。\n窗昏减书课，弦缓咽琴声。\n何以娱幽独，新醅手自倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨三首 其二","author":"陆游","text":"药炉茶灶淡生涯，听雨犹能惜物华。\n蘸岸顿添三尺水，沾泥不贷一城花。\n闲摩病眼开书卷，时傍危栏弄钓车。\n稚子孤行八千里，喜闻炊熟可还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"陆游","text":"午夜听春雨，发生端及期。\n世忧殊未艾，天意固难知。\n士节承平日，人材南渡时。\n后生闻见狭，抚枕叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"陆游","text":"春阴不肯晴，春雨断人行。\n惨澹柴荆色，萧条鸡犬声。\n香分豆子粥，美啜芋魁羹。\n犹胜梁州路，蒙毡夜下程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨中偶赋","author":"陆游","text":"老子年来百事慵，不妨诗课尚能供。\n残花已觉胭脂淡，煮酒初尝琥珀浓。\n羸病不堪连日雨，孤愁偏怯五更钟。\n旧交只有乌藤在，且伴禅床莫化龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨示邻曲","author":"陆游","text":"春来天气苦萧森，如缕云升便作霖。\n寒溜何曾住一滴，绿阴忽已遍千林。\n莼丝箭茁垂垂老，蓼浦菱塘滟滟深。\n闻道南山花尚在，约君携酒试同寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨复寒遣怀","author":"陆游","text":"去日堂堂挽不回，新年又傍鬓边来。\n雨声欲作海棠祟，书卷只为春睡媒。\n村舍瘦蔬供薄酒，地炉微火伴残灰。\n浩然忽起金鞭兴，漾水嶓山安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春思","author":"陆游","text":"七十老翁身退耕，可怜未减旧风情。\n典衣取酒那论价，秉烛看花每到明。\n江浦时时逢画楫，寺楼处处听新莺。\n此生无复阳关梦，不怕樽前唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春思","author":"陆游","text":"兀兀治聋酒未醒，霏霏泼火雨初晴。\n愁看入户桃花片，闲听争巢燕子声。\n百疾侵陵成老大，一春转盼又清明。\n兰亭禹庙浑如昨，回首儿时似隔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春残","author":"陆游","text":"老堕空山里，春残白日长。\n庸医司性命，俗子议文章。\n烛映一池墨，风飘半篆香。\n个中有佳处，袖手看人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春残","author":"陆游","text":"石镜山前送落晖，春残回首倍依依。\n时平壮士无功老，乡远征人有梦归。\n苜蓿苗侵官道合，芜菁花入麦畦稀。\n倦游自笑摧颓甚，谁记飞鹰醉打围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夏之交风日清美欣然有赋三首 其三","author":"陆游","text":"芳润园林不似贫，年光无尽逐番新。\n来禽颜色不禁雨，抟黍语言如惜春。\n身外岂关吾辈事，镜中已换昔时人。\n神仙定未超尘俗，犹插金貂侍帝晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夏之交风日清美欣然有赋三首 其二","author":"陆游","text":"天遣残年脱絷鞿，功名不恨与心违。\n绿陂细雨移秧罢，朱舫斜阳擘纸归。\n花市丹青卖团扇，象床刀尺制单衣。\n白头曳杖人争看，共叹浮生七十稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夏之交风日清美欣然有赋三首 其一","author":"陆游","text":"日铸珍芽开小缶，银波煮酒湛华觞。\n槐阴渐长帘栊暗，梅子初尝齿颊香。\n户户祈蚕喧鼓笛，村村乘雨筑陂塘。\n年光何预衰翁事，伴蝶随莺也解狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夏之交衰病相仍过芒种始健戏作","author":"陆游","text":"药裹关心百不知，可怜笔砚锁蛛丝。\n倒壶犹有莫春酒，开卷遂无初夏诗。\n户外逢人惊隔阔，灯前顾影叹支离。\n痴顽未伏常愁卧，鼓缶长谣乐圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓","author":"陆游","text":"喔喔鸡号野，昏昏月挂楼。\n梦随残漏断，愁伴宿酲留。\n壮志看清镜，春寒著弊裘。\n拂窗新柳色，最忆锦江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓","author":"陆游","text":"强寻残梦苦难成，推枕支藤绕舍行。\n新涨生波渔艇活，晨曦送暖客衣轻。\n烟迷芳草苍茫色，鹊占高枝嚄唶声。\n老病自怜犹嗜学，诵书家塾羡诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓","author":"陆游","text":"初见天窗一点明，旋看晓色到檐楹。\n衾裯温暖留残梦，鸟雀呼鸣报快晴。\n虽喜心随年愈老，却愁事与日俱生。\n平川漫漫烟芜绿，筋力犹堪给耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春耕","author":"陆游","text":"去蜀归吴会，真成万里行。\n穷通竟安在，恩怨两皆平。\n文字妨求道，杯觞害养生。\n馀年犹有几，买犊事春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"陆游","text":"雨足人家插稻秧，蚕生邻女采桑黄。\n万花扫迹春将暮，百草吹香日正长。\n闲觅啼莺穿北崦，戏随飞蝶过东冈。\n飘然且喜身彊健，不怪儿曹笑老狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚二首 其一","author":"陆游","text":"门巷萧条老病侵，春晴方快又春阴。\n啄吞自笑如孤鹤，导引何妨效五禽。\n雨洗杏花红欲尽，日烘杨柳绿初深。\n雏莺宁有平生旧，也傍茆檐送好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"陆游","text":"五十六翁身百忧，年来转觉此生浮。\n山川信美故乡远，天地无情双鬓秋。\n社后燕如归客至，春残花不为人留。\n一觞一咏从来事，莫笑扶衰又上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚二首 其二","author":"陆游","text":"正见山陂草木芽，狂风忽扫万枝花。\n病怀久已忘春事，老眼犹能惜物华。\n枕上有诗频自改，尊中无酒不妨赊。\n昔人漫道伤幽独，野鹤分巢即是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"陆游","text":"新绿成阴小雨时，幅巾萧散与闲宜。\n燕归赴诉经年别，莺晚分疏出谷迟。\n晓枕呼儿投宿酒，暮窗留客算残棋。\n翛然此意风尘表，正恐羲皇未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"陆游","text":"南陌东阡自在身，黄尘不污接䍦巾。\n无方可染星星鬓，有酒能留盎盎春。\n下豉已添莼菜美，衔泥又见燕巢新。\n作公何益辛毗事，且是人间九十人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"陆游","text":"落絮飞花又满城，年光大半付春酲。\n蹇驴闲后诗情减，阵马抛来髀肉生。\n少日雕虫真小技，暮年画饼更虚名。\n囊中幸有黄庭在，安得高人与细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"陆游","text":"萍叶青浮水，蛙声闹彻明。\n川云时聚散，天气半阴晴。\n杏子争梅结，鸠巢后鹊成。\n吾侪亦有役，过社更深耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚二首 其一","author":"陆游","text":"寂寞又过桃李时，东园微雨草离离。\n破囷食外有馀粟，残发白中生黑丝。\n小疾已能忘药石，馀年宁复问蓍龟。\n饰巾待尽从来事，闭户烧香更不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚小饮","author":"陆游","text":"病卧虚斋一味慵，今年春事又成空。\n箨龙奋迅风雷际，木笔凋零雾雨中。\n平野草深黄犊健，断溪水长画船通。\n小儿偶得官楼酒，鲎醢鳅乾一醉同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚书怀","author":"陆游","text":"万里西游为觅诗，锦城更付一官痴。\n脱巾漉酒从人笑，拄笏看山颇自奇。\n疏雨池塘鱼避钓，晓莺窗户客争棋。\n老来怕与春为别，醉过残红满地时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚书怀三首 其二","author":"陆游","text":"经春淹泊锦官城，作个归期苦未成。\n老向轩裳增力量，病于风月减心情。\n官闲有味缘高卧，酒贵无忧为细倾。\n忆探梅花如昨日，西斋榆荚与阶平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚书村落间事","author":"陆游","text":"千古会稽城，闾阎乐太平。\n丰年观米价，霁色听禽声。\n俗俭憎浮侈，民淳力钓耕。\n豳诗有七月，字字要躬行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚风雨中作","author":"陆游","text":"箕踞藜床岸幅巾，何妨病酒住湖滨。\n驾风浪作连三日，扫地花空又一春。\n乐事清宵当秉烛，畏途平地有摧轮。\n颓然耐辱君无怪，元是人间澹荡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚杂兴六首 其六","author":"陆游","text":"青梅荐煮酒，绿树变鸣禽。\n处世已如客，伤春无复心。\n焚香惟默坐，曳杖亦幽寻。\n一日悠然过，深惭惜寸阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚杂兴六首 其二","author":"陆游","text":"泽国固多雨，暮春犹薄寒。\n儿童葺茶舍，妇女赛蚕官。\n阅世年虽往，为农兴未阑。\n穷途得一饱，亦足慰艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚杂兴六首 其三","author":"陆游","text":"池面萍初紫，墙头杏已青。\n携儿撑小艇，留客坐孤亭。\n相法无侯骨，生年直酒星。\n正须遗万事，莫遣片时醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚杂兴六首 其四","author":"陆游","text":"小市湖桥北，幽居石埭西。\n蒲深姑恶哭，树密秭归啼。\n山茗封青箬，村酤坼赤泥。\n平生汗简手，投老惯扶犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚杂兴六首 其一","author":"陆游","text":"寂寂野人家，柴扉傍水斜。\n僧分晨钵笋，客共午瓯茶。\n燕户添新土，蛛丝罥落花。\n悠然便终日，惟此送年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚杂兴六首 其五","author":"陆游","text":"病疡无意绪，闭户作生涯。\n草草半盂饭，悠悠一碗茶。\n笑穿居士屩，闲看女郎花。\n莫问明朝事，忘家即出家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚自近村归","author":"陆游","text":"山阴道上柳如丝，策蹇悠悠信所之。\n曲水已过修禊集，馀寒不减试灯时。\n贫犹自力常谋醉，病不能闲日赋诗。\n谁道茅檐苦幽独，一钩新月是相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚至山中因访陈道人","author":"陆游","text":"一春衰病集残骸，太息流尘覆酒杯。\n僧钵始知莼菜老，佛瓶初见杏花开。\n蘋溪小雨成幽讨，松院斜阳又独来。\n不为爱闲从野叟，年来万事学低摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]