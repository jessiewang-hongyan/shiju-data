[{"title":"久客感怀","author":"张守","text":"自笑行藏愧古人，归与有意坐长贫。\n霜毛不种自生鬓，云路无梯宁致身。\n春韭秋菘聊当肉，冬裘夏葛听悬鹑。\n何当即买扁舟去，醉兀五湖烟雨春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐观书","author":"张守","text":"青灯只影夜迢迢，赖有尘编洗郁陶。\n此事长惭作吏废，少功又笑为儒劳。\n行藏老骥思千里，用否九牛亡一毛。\n端为鲈鱼挽幽兴，拟飞烟艇破秋涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"睡起戏书呈葛鲁卿席大光周举同舍诸兄","author":"张守","text":"午梦初残日未西，人情节物睡偏宜。\n花开花落纷无定，春到春归漫不知。\n香缕细萦环堵室，槐阴清翳一枰棋。\n此间粗有超然处，雕琢天真却坐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚即事","author":"张守","text":"风条日萼半披残，不用登临意惘然。\n宿麦吐芒风卷浪，垂杨吹絮暖生烟。\n送春莺友分明语，并水凫雏取次眠。\n触眼风光浑有味，人生行乐且加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早秋书事","author":"张守","text":"江城暑退叶惊秋，环堵萧萧草树幽。\n扫净尘心清似水，静看人态曲如钩。\n一尊楚醴醇无敌，半榻湘波冷欲流。\n午枕日斜呼不省，梦魂还上五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵曾天猷赠知宗赵端礼展钵诗","author":"张守","text":"几人能信见前因，满意肥甘豢色身。\n曾是鼎钟华贵胄，肯同瓶钵苦空人。\n招呼善友明初地，降伏心魔净六尘。\n翻笑花间沾醉客，空看高冢卧麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送德远枢密初召赴经筵","author":"张守","text":"长驱敌骑傍淮淝，又是忠贤许国时。\n扶义东吴回日毂，宣威西蜀正参旗。\n暂逢贝锦辞黄阁，却续金华上赤墀。\n联事乌台馀病骨，仰看麟阁写英姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舍弟寄和送行诗有倦游之叹因勉之","author":"张守","text":"几年头角翳蒿莱，今日宁辞尽一杯。\n好向明时聊自试，莫缘荒径忆归来。\n白头休叹从人后，青眼多应为汝开。\n老去岂堪频作恶，风帆目断首空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人晚秋白菊","author":"张守","text":"漙漙清露洗残妆，静倚疏篱暗吐芳。\n不逐黄花候秋节，笑看殷叶陨风霜。\n寒潭谁致南阳种，晚景宜登靖节堂。\n我对冰姿赓雪唱，骑骡无计度飞黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游凤池寺","author":"张守","text":"凤去池荒今几年，碧梧翠竹故依然。\n鸣檐流水涓涓下，排闼群山衮衮前。\n幸有清风继莲社，不堪斜日近虞渊。\n归途满眼春耕了，劝课无功愧力田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"友人惠猩猩毛笔一枝秃甚作诗戏之","author":"张守","text":"猩毛意重鹅毛赠，老不中书一怅然。\n宜付削毫贫郑灼，政堪握笔晋僧虔。\n判冥即合防抛失，瘗冢宁甘便弃捐。\n瓦研蓬窗吾臭味，秃翁相对且忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"婢子翻羹","author":"张守","text":"杯羹卓午荐朝餐，一饱龟肠亦尔难。\n穷鬼还来调韩愈，夫人真欲试刘宽。\n尚馀食案韭三种，早悟官亭鲙两盘。\n传语厨人莫轑釜，不应饿死悔儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李似矩尚书挽词二首 其一","author":"张守","text":"元礼清门有四龙，云孙远跨旧家风。\n持荷入侍声名早，仗钺宣威节制雄。\n晚岁独抛尘鞅外，高怀聊寄药炉中。\n堂堂玉树埋黄壤，何事凌烟欠此公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李似矩尚书挽词二首 其二","author":"张守","text":"只今耆旧几晨星，又失三朝一老成。\n许国忠规关社稷，绝尘奇表照簪缨。\n秖应鼎里金丹就，无复廷中革履声。\n才大故难供世用，空馀拱木翳佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡进彦挽词","author":"张守","text":"剸烦馀刃发硎刀，使节藩符久漫劳。\n腰绶六朝知寿考，悬车一纪足清高。\n光阴不用悲驹隙，温凊无违有凤毛。\n晚缀葭莩公已病，送行无路首空搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠彦光挽词","author":"张守","text":"声驰太学俊游先，膏火穷年味绝编。\n百战收名丹桂籍，一麾送老白云边。\n心闲要路门无辙，岁恶穷阎爨有烟。\n全福略无毫发恨，更馀身后一经传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵约不远千里命驾相过中道寄示三诗姑和答一篇","author":"张守","text":"霅水论交今有谁，两翁华发映朝衣。\n功名晼晚君流落，衰病栖迟我倦飞。\n叔夜相思能肯顾，子猷乘兴却言归。\n人生动是参商别，三复清诗对落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题明皇联镳图","author":"张守","text":"风流谁复似三郎，并辔春风辇路香。\n漫说宫中行乐秘，画图千古记兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其一","author":"张守","text":"四老堂中四老人，饱经丧乱始收身。\n苍颜鹤发团栾坐，知是时平有幸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其二","author":"张守","text":"兄弟当年七业兴，精神如鹤齿如冰。\n升沈存没今如许，且作随堂粥饭僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其三","author":"张守","text":"已是平头六十人，江湖身老寸心存。\n明窗净几翻经卷，深炷炉香答主恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其四","author":"张守","text":"一派荆溪过枕前，喜从人境得幽偏。\n直疑身在烟波上，卧送飞帆落照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其五","author":"张守","text":"堂后堂前竹与梅，老人多半手亲栽。\n何时更作闲花草，亦遣群芳次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其六","author":"张守","text":"四时花草逐时新，衮衮年华过眼频。\n景物无穷人自老，新花应解笑迎人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其七","author":"张守","text":"系舟长傍柳堤阴，曳杖时穿竹径深。\n薙草浇花课僮仆，更无馀事可关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其八","author":"张守","text":"多病经时不著冠，岸巾长对倦云闲。\n年来衰谢交游绝，靖节柴门不用关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其九","author":"张守","text":"鹤养丹成鹿养茸，群呦对舞傍衰慵。\n待看仙骨他年就，同访蓬莱第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题四老堂十首 其十","author":"张守","text":"商岭偷生计已疏，橘中乐事亦区区。\n洛阳耆旧今黄壤，会有人传四老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题荔枝亭","author":"张守","text":"色味清香美莫名，更怜圆树碧亭亭。\n结根得所天然胜，为对三台第一星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹亭诗和韵","author":"张守","text":"直上烟霄碧玉抽，静摇月露冷光浮。\n堂堂劲节冰霜后，元老如今有壮猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答钱文高四首 其一","author":"张守","text":"闭门不复过高轩，梦蝶悠扬栩栩然。\n睡起杖藜经略彴，静看鸥鹭浴晴川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答钱文高四首 其二","author":"张守","text":"毣毣精思愧鲍宣，如如不动契金仙。\n回观争夺纷华地，已老吴蚕不复眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答钱文高四首 其三","author":"张守","text":"迹抛朝市不妨清，心照空华故自明。\n但忆沧浪时鼓枻，肯从金谷听鸣筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答钱文高四首 其四","author":"张守","text":"觅句高攀孟浩然，藏经远慕汉韦贤。\n深林小隐成幽趣，我得为邻愧子先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答诸兄弟四首 其一","author":"张守","text":"昔向丹墀侍玉轩，略无裨补发苍然。\n元非食肉封侯相，合抱遗经老玉川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答诸兄弟四首 其二","author":"张守","text":"三州皇化未能宣，山水清奇记九仙。\n白首弟兄长挂梦，喜听夜雨对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答诸兄弟四首 其三","author":"张守","text":"门对芙渠碧沼清，萧萧五柳似渊明。\n远听林壑风鸣籁，戏看儿童草鼓筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答诸兄弟四首 其四","author":"张守","text":"通塞升沈亦偶然，山林高卧更称贤。\n似闻小筑西湖上，择胜浑输一著先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"族叔祖示四绝句次韵 其一","author":"张守","text":"摧颓病鹤怕乘轩，归路风帆任渺然。\n环堵故能容两膝，扫除荒径老斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"族叔祖示四绝句次韵 其二","author":"张守","text":"不乐从军学仲宣，那能辟谷慕飞仙。\n直缘衰病干明主，乞得南窗一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"族叔祖示四绝句次韵 其三","author":"张守","text":"衰怀底物能陶写，社舞村歌眼暂明。\n谁似玉人供巧笑，不劳长笛与哀筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"族叔祖示四绝句次韵 其四","author":"张守","text":"追陪杖履已悠然，把玩诗篇更觉贤。\n局上频烦问瓜葛，吟边端不敢争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送客","author":"张守","text":"南渡登舟即水仙，西垣有客思悠然。\n因君相问为官意，不买毗陵附郭田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双莲阁","author":"张守","text":"小阁幽深枕浅波，直疑湘水见英娥。\n不将诗酒频料理，奈此风前二妙何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花坞","author":"张守","text":"意匠潜符造物工，笑谈花坞出榛丛。\n风条日萼随时看，须信春藏指掌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂斋","author":"张守","text":"月里移根傍小斋，不惟收子看花开。\n捣香筛辣归春瓮，准拟高人胜士来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兰室","author":"张守","text":"分得骚人九畹香，时人不服更幽芳。\n小窗低户维摩室，苒苒奇芬春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦室","author":"张守","text":"笑取功名指顾间，归来心与倦云闲。\n闭关不作南柯想，睡起香凝金博山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圭沼","author":"张守","text":"方锐新池卧介圭，水光如玉夜腾辉。\n不应只作韩侯觐，更喜姬公著衮衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人惠方竹杖","author":"张守","text":"多病扶筇老自便，得君方竹更轻坚。\n平生正以方为累，拟付山僧任削圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菖蒲涧","author":"张守","text":"蟠根带石傲年芳，秋雨春风拂水长。\n不用引年劳服食，相公勋业似汾阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题崔悫画","author":"张守","text":"风折枯荷芦苇秋，萧萧鸂鶒上沙洲。\n关心满眼江湖趣，何日扁舟得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相吕忠穆公退老堂诗 其一","author":"张守","text":"大老归周庆有源，中兴吾宋属云孙。\n五龙夹日三辰正，一虎当溪百兽奔。\n何事云山遽招隐，向来金鼎厌调元。\n追锋早晚求黄发，三径还荒靖节园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建炎丞相吕忠穆公退老堂诗 其二","author":"张守","text":"闻道抽身向急流，海边暂舣济川舟。\n功存社稷推元老，人向渔樵识故侯。\n绿野江山供笑傲，赤松俦侣伴淹留。\n闲棋小酌怀畴昔，清梦时追杖履游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"席大光邀同赋墨梅花 其一","author":"张守","text":"镂冰斲雪赋精神，不受丹青一点尘。\n施粉故应嫌太白，谩凭水墨见天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"席大光邀同赋墨梅花 其二","author":"张守","text":"骚人洗砚试松烟，造化炉锤贮笔端。\n春破南枝入诗眼，句成祇许画中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"席大光邀同赋墨梅花 其三","author":"张守","text":"笑挥墨妙当铅华，真是天然玉雪花。\n月冷霜清春不管，一枝寒影堕溪斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"席大光邀同赋墨梅花 其四","author":"张守","text":"墨白何妨俗眼疑，写真妙处足天机。\n横斜疏影黄昏月，貌尽西湖处士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"席大光邀同赋墨梅花 其五","author":"张守","text":"墨竹文翁旧写真，墨梅颜子更超群。\n我家幸有筼筜谷，乞取冰姿伴此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"席大光邀同赋墨梅花 其六","author":"张守","text":"故园雪树想彫零，却向毫端见典型。\n梦破江南愁绝处，前村烟迥雨冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鱼乐亭","author":"张守","text":"乃公倦经纶，结□俯沧浪。\n风波不到处，修鳞自徜祥。\n一与芳饵辞，此乐殊未央。\n借问那得知，吾人亦相忘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张君墨竹","author":"吕本中","text":"张卿画竹今成癖，笑语挥毫不作难。\n欻见高标起萧瑟，坐令炎暑变荒寒。\n笔头似有千年韵，胸次犹须万斛宽。\n岁晚雪霜君记取，此君怀抱要重看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阴","author":"吕本中","text":"凉风森爽遽如许，天气萧条殊未佳。\n密径留阴□□竹，败畦藏雨斗蛙蟆。\n碧云莫合人千里，丹凤□□天一涯。\n唯有双丛庭下菊，殷勤还作去年花。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"符离诸贤诗","author":"吕本中","text":"穷居日荒凉，杜门与世绝。\n亲故日夜疏，诗书固宜缺。\n符离虽陋邦，贤士稍罗列。\n德操青云器，议论辈前哲。\n外貌发英华，中心瑩冰雪。\n介然特立士，劲气刚于铁。\n攘臂辩是非，孰能逃区别。\n信民粹而和，名利诚难悦。\n汩没稠人中，独抱云松节。\n伟哉二三子，实乃邦家杰。\n我来从之游，内顾惭疏拙。\n欣然对三益，放怀歌数阕。\n已矣不须言，渠当为君说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德操充之皆约九月间见过今皆未至扶杖出门悠然有感","author":"吕本中","text":"病着文书懒出门，偶扶藜杖看行云。\n屋头日在转花影，水面风来散縠纹。\n不厌莫城千嶂合，稍令明月万家分。\n小庭留得清秋在，已见霜红未见君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游刘氏园","author":"吕本中","text":"暖日温风破浅寒，短青无数簇幽兰。\n三年止酒偿春意，可忍花梢带面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元","author":"吕本中","text":"步屧荒园日已昏，呼儿当径扫苔痕。\n春愁不作游人地，细雨残梅过上元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳","author":"吕本中","text":"含烟带雨过平桥，袅袅千丝复万条。\n张令当年缘底事，风流才似女儿腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨","author":"吕本中","text":"天乞幽人一夜凉，故教微雨送斜阳。\n暝阴笼树山更好，爽气侵人土自香。\n多病不眠唯药裹，居闲长坐只绳床。\n五年谬作江湖客，几对鲈鱼忆故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舍东旧有花数百株自去岁大雨道路阻绝不复可寻感叹成诗","author":"吕本中","text":"无数新花替旧丛，兔葵高卧占春风。\n向来桃李成蹊处，今在陂塘渺莽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送文潜归因成一绝奉寄","author":"吕本中","text":"水天空阔片帆开，野岸萧条送骑回。\n重到张公泊船处，小亭春在锁青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人送牡丹","author":"吕本中","text":"晚风初染嫩鹅黄，小雨仍添百和香。\n折与病夫元不称，玉瓶留待冶游郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]