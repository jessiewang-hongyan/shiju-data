[{"title":"谒金门","author":"曾纡","text":"风淅沥。\n窗外雪花初积。\n梦破小窗人寂寂。\n寒威无处敌。\n强起饮君涓滴。\n清泪醉来沾臆。\n歧路即今多拥隔。\n弟兄无信息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送越帅程公辟","author":"曾孝宗","text":"虎符分镇浙江东，舣棹都门使旆雄。\n双桨徘徊枌社日，高牙摇曳剡溪风。\n蓬莱阁宴公书简，贺监湖浮狱榜空。\n行听越民歌德政，亟还青琐见旌忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云溪寺","author":"曾宋珍","text":"溪水年年自浅深，山云日日半晴阴。\n溪山好处划开眼，看水看山悟此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏胡季昭贬象州","author":"曾宏父","text":"湘山冷焰冰四海，寒蔽天晴日昼阴。\n朝路偷生尽缄口，瘴乡投死犹甘心。\n里闾节义绍襄简，史册姓名光古今。\n天定胜人公议在，褒忠录后上恩深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题凤山书院修禊图","author":"曾宏父","text":"暮春浴罢振春衣，正是流觞修禊时。\n世事藏机应落落，人情忘我总熙熙。\n醉能辞醉原非醉，诗到无诗乃是诗。\n伟矣兰亭众君子，不将文字立藩篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 临桂水月洞","author":"曾宏正","text":"风月无尽藏，泉石有膏肓。\n古今桂岭奇胜，骚客费平章。\n不假鬼谋神运，自是地藏天作，圆魂镇相望。\n举首吸空翠，赤脚踏沧浪。\n惊龙卧，攀栖鹘，翳鸾凰。\n秋爽一天凉露，桂子更飘香。\n坐我水精宫阙，呼彼神仙伴侣，大杓挹琼浆。\n主醉客起舞，今夕是何乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制玉津园宴射 其一","author":"曾怀","text":"名园佳气霭非烟，冠佩朝宗似百川。\n五品并令陪宴射，四鍭端欲序宾贤。\n恩涵春意鱼翻藻，威入秋声雁落弦。\n竣事更容窥典雅，宸章应陋柏梁篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制玉津园宴射 其二","author":"曾怀","text":"江山秋日冠轻烟，别苑风光胜辋川。\n位设虎侯恢盛典，枝穿杨叶校名贤。\n礼均湛露宣飞斝，乐奏钧天着发弦。\n圣主经文与纬武，全胜巡幸射蛟篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八功德水","author":"曾极","text":"数斛供厨替八珍，穿松漱石瑩心神。\n中涵百衲烟霞色，不染齐梁歌舞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三十六陂","author":"曾极","text":"渺然三十六陂春，石黛潮生岁岁新。\n杨柳杏花浑好在，吟边只欠跨驴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三十六宫","author":"曾极","text":"曲阁便房三十六，欲回舞袖不容身。\n黄金壁带今安有，笑杀宣和大内人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三段石","author":"曾极","text":"凛然皇象法书存，重屋应无野火焚。\n割据英雄馀一念，断碑千载尚三分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大茅君像","author":"曾极","text":"面如赪玉碧矑寒，散发垂腰槲叶乾。\n不向大茅峰顶见，时人多作伏羲看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中主像","author":"曾极","text":"乘时草窃岂无人，三主相传事有因。\n毕竟老天怜一念，据敖为粥活饥民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌衣巷","author":"曾极","text":"吴兵曾驻黑云都，江左夷吾此卜居。\n休把乌衣轻马巷，悬鹑结驷总丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五马渡","author":"曾极","text":"仲达欺孤与操同，岂能长世抚提封。\n瑶图暗换君知否，班特浮江自化龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤州柳","author":"曾极","text":"蜀主函封遣使时，芳根元自凤州移。\n柔荑醽醁今安在，唯有青丝拂地垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"升元阁铎","author":"曾极","text":"摩挲石柱藓痕斑，亡国如鸿去不还。\n无复切云三百尺，祗传风铎在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卞将军墓","author":"曾极","text":"握节颜公拳透爪，归元先轸面如生。\n晋陵发掘今无主，独有忠魂占冶城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天门山","author":"曾极","text":"鲸翻鳌负倚江潭，天险由来客倦谈。\n高屋建瓴无计取，二梁刚把当殽函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文孝庙","author":"曾极","text":"德隐前星民已和，山隈水曲庙何多。\n皇孙不得承天统，犹使而翁恨蜡鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方山","author":"曾极","text":"人间底事有方壶，剑截青摇界碧虚。\n试上殊庭瞻醉葛，仙云垂带护储胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木围","author":"曾极","text":"寝殿重重设木围，崎岖天位不胜危。\n高人巢许应知此，占得箕山最坦夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水精大珠","author":"曾极","text":"冰玉摩尼如鹄卵，大千世界倒悬中。\n何人提向江头照，照见神州一半空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长干塔","author":"曾极","text":"十丈祥光起相轮，铁浮屠镇法王坟。\n只愁西域神僧至，夜捧长干刹入云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东晋","author":"曾极","text":"断简残编迹可寻，诸贤兴复不关心。\n未应全罪王夷甫，一任神州自陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐官山","author":"曾极","text":"城破辕门宴赏频，伶伦执乐泪横巾。\n骈头就戮缘家国，愧死南归结绶人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古龙屏风","author":"曾极","text":"乘云游雾过江东，绘事当年笑叶公。\n可恨横空千丈势，剪裁今入小屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"台城","author":"曾极","text":"紫盖横天整复斜，兴亡接翅似昏鸦。\n旧时石阙摩云处，荻屋荆扉一两家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四太子河","author":"曾极","text":"上东门啸本同科，天诱金人智诈多。\n刁斗夜鸣兵四合，五更平陆已成河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄武湖","author":"曾极","text":"当日湖光澈镜心，龙旗凤吹此登临。\n而今铁马回旋地，斜照黄尘一尺深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉树后庭花","author":"曾极","text":"结绮临春成草莽，繁华都入暮烟中。\n后庭玉树迎秋色，犹带张妃脸上红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹭洲","author":"曾极","text":"江水悠悠绿染衣，淮山渺渺翠成围。\n南朝鹭序归何处，唯见沧洲白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石步道中有石麒麟数十","author":"曾极","text":"地悴天荒丘陇平，难从野老问衰兴。\n苍烟落日低迷处，折足麒麟记坏陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石麒麟","author":"曾极","text":"短樊长堑起寒烟，知是何人古墓田。\n千岁石麟相对立，肘騣膊焰故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙洞","author":"曾极","text":"江流远引背烟岚，平陆何年重举帆。\n断岸插天危欲坠，六朝龙去祗空岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"决囚灯","author":"曾极","text":"五详三覆始施刑，明灭兰膏岂足凭。\n可惜当年杀严续，无人为益决囚灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘莎衣庵","author":"曾极","text":"佛狸麾骑饮长江，呼吸安危阖国忙。\n南北两家都换主，从容一语悟高皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华林园","author":"曾极","text":"羽葆来临鼓吹停，华林畅饮倒长瓶。\n万年天子瞢腾眼，错认长星作酒星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同泰寺","author":"曾极","text":"布萨开斋涕泗挥，大通基在昔人非。\n此身终属侯丞相，谁办金钱赎帝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙陵鹅眼钱","author":"曾极","text":"六代初终几变迁，孙陵无树起寒烟。\n青蚨细薄如榆荚，犹是当年买笑钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江南录","author":"曾极","text":"自古婴鳞或似狂，按诛潘佑事堪伤。\n凭谁寄语徐常侍，不杀忠臣国未亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行廊","author":"曾极","text":"负矢前驱敌未擒，虎侯高揭意何深。\n文皇决拾精天下，偏爱良工辨木心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西原","author":"曾极","text":"衰草寒云雁一行，牵愁水似九回肠。\n游人欲问千官事，翁仲无言卧夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西浦","author":"曾极","text":"珠珰错落江皋佩，罗袜轻盈洛浦妆。\n欲采蘋花掷春信，停桡难觅杜兰香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冶城楼","author":"曾极","text":"袅袅疏林集晚鸦，钟山云气入檐牙。\n何人乘月吹长笛，夜看云陵百万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴大帝庙","author":"曾极","text":"曾将一剑定全吴，斗大祠庭泣楚巫。\n故国神游应抚掌，芦花枫叶几年无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴大帝陵","author":"曾极","text":"老瞒虎裂横中州，何物生儿作仲谋。\n四十帝中功第一，坏陵无主使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋兴寺","author":"曾极","text":"晋至昌明祚已终，谶文犹有两昏童。\n桓玄偷得宫中玺，却属新河伐荻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋受禅坛","author":"曾极","text":"赤纸藤书宋鼎归，寄奴柴燎告功时。\n普天大庆交新主，唯有徐公双泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张丽华墓","author":"曾极","text":"伴侣声沉王气销，香魂血涴有谁招。\n蓬科三尺光尘在，犹作台城花月妖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李氏宫","author":"曾极","text":"埋愁无地奈君何，可是黄垆饮恨多。\n玉镜台前弃脂水，深泉流汞尚盈科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"没字碑","author":"曾极","text":"漫漫荒池浸绿芜，残碑一丈载龟趺。\n当年刻画书勋阀，雨打风吹字已无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李璧凌丹亭","author":"曾极","text":"思陵宸翰丽昭回，阁下金□长紫苔。\n试向凌丹寻妙墨，何时真见白云来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝公井","author":"曾极","text":"一片当街百尺深，行人环辙免苔侵。\n尘容俗状暂窥影，欲汲寒泉洗此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝公塔","author":"曾极","text":"六帝园陵堕劫灰，独馀灵骨葬崔嵬。\n行人指点云间鹤，唤得齐梁一梦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松","author":"曾极","text":"汇进群奸卒召戎，萌芽培养自熙丰。\n当时手植留遗爱，只有岩前十八公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"板桥","author":"曾极","text":"轮鞅千年路欲迷，板桥名在市朝非。\n玄晖太白微吟处，独酌悠然命驾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泼墨池","author":"曾极","text":"二酉珍储已遍窥，仙班宁肯列愚痴。\n注经穴石须勤苦，留得千年泼墨池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采石渡","author":"曾极","text":"石琢浮屠遍水滨，兴亡岁久已成尘。\n长江静夜芦花月，莫信牵愁拨棹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵","author":"曾极","text":"凿地破除函谷帝，埋金厌胜郢中王。\n兴亡总不关君事，五百年前枉断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨华台","author":"曾极","text":"昼可骑虹夜摘星，山根万瓦碧磷磷。\n雨台不为云光老，一洗南朝战伐尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"养种园","author":"曾极","text":"百花堂里赏芳菲，江左霸臣泪溅衣。\n肠断上林桃李树，春风一半未全归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南轩","author":"曾极","text":"剑磨驴膊倦征途，三岁南轩客寓居。\n建业水甘供日饮，波间亦有武昌鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南唐金铜香炉","author":"曾极","text":"制作元从建业宫，形模奇古杂金铜。\n烟昏尘暗君休笑，曾在红罗扇影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南唐宫中残獐","author":"曾极","text":"周庐巡徼列千兵，那得残獐堕禁庭。\n鹿走棘生先有象，天文未必直狼星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南唐遣使","author":"曾极","text":"谈锋亹亹折强邻，专对当年亦有人。\n国老胸中兵百万，不将全力靠江神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南烛草木","author":"曾极","text":"驻采还年枉费功，羞将老色照青铜。\n仙方石䭀无消息，南烛垂珠颗颗红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆公祠","author":"曾极","text":"霜筠雪竹古精蓝，投老归与志自甘。\n一食万钱终忍垢，鱼羹饭美忆江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆公墓","author":"曾极","text":"误把清标犯世纷，平生忠业自超群。\n如何今代麒麟阁，只道诗名合策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟山番人窟","author":"曾极","text":"千群铁骑远来侵，凿穴钟山用意深。\n天堑连空遮不断，烟尘直到海中心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌丹亭","author":"曾极","text":"路转峰回杳霭中，石坛幡影表真风。\n凭谁貌取清虚老，与对濂溪太极翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"射雉场","author":"曾极","text":"不整军容北射狐，却资媒翳取欢娱。\n山梁饮啄关何事，浪费君王金仆姑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"展上公","author":"曾极","text":"浩劫循环无始终，年年玉李杲春空。\n初成未占兹山顶，古老唯传展上公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晋元帝庙","author":"曾极","text":"茅茨绵蕝寄江东，陵庙回看渫血红。\n右衽危冠才自保，未能无责敢言功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"校官碑","author":"曾极","text":"风摧雨剥校官碑，集古先生竟不知。\n同是光和千岁刻，未容苦县独称奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃叶渡","author":"曾极","text":"裙腰芳草抱长堤，南浦年年怨别离。\n水送横波山敛翠，一如桃叶渡江时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦淮","author":"曾极","text":"凿断山根役万人，祖龙痴绝更东巡。\n石城几度更新主，赢得淮流尚系秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胭脂井","author":"曾极","text":"寒泉玉甃没春芜，石染胭脂润不枯。\n杏怨桃羞娇欲堕，犹将红泪洒黄奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁塔寺","author":"曾极","text":"逝水无情去不回，黄帘窣地隔风埃。\n摩挲铁塔堪流涕，此是先皇思子台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]