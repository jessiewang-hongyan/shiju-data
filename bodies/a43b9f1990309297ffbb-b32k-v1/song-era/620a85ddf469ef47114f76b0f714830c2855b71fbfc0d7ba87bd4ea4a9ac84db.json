[{"title":"壬寅立春 其一","author":"张镃","text":"经旬寒雨正霖霪，才转东风便肯晴。\n我自西畴心念熟，不须学稼始归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬寅立春 其二","author":"张镃","text":"蓼醯蔬饼媚晨羞，一饱宁知老到头。\n但听儿童语声喜，黑头青角看泥牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天声馆","author":"张镃","text":"鸾鹤纷来下，天风驾月明。\n语言难道断，不堕世间声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆南湖","author":"张镃","text":"暖云台观绕歌弦，花底吹香翠鬓船。\n闹处如今浑懒去，可能心绪数年前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆夏墟山园","author":"张镃","text":"松处筑亭何日见，霜时开径去年行。\n速排忙事成幽事，已觉贪山浪得声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶","author":"张镃","text":"春在壶中晚更长，众仙相命醉霓觞。\n戏将龙脑真珠网，搭上周回碧玉廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水边","author":"张镃","text":"翠藤萦树夕花明，无数圆荷贴乱萍。\n酒力半销来照影，晚风轻澹鹤梳翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水栀 其二","author":"张镃","text":"汲水埋盆便当池，水栀花旺雪盈枝。\n江湖万里何曾远，祗在先生托兴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水栀 其一","author":"张镃","text":"拳石泓泉媚浅沙，孤根蟠窟养清华。\n细看六出瑶英小，薝卜分明是雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水阁即事二首 其二","author":"张镃","text":"今岁春来我亦来，折花犹未见花开。\n新春况有四十日，莫怪幽人空手回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水阁即事二首 其一","author":"张镃","text":"水阁开窗景不偏，断桥堤柳尽横前。\n平生到处居人后，已有貂珰泊画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水蕉","author":"张镃","text":"笼丛旧爱溪边树，路转清风尽日阴。\n窗下不生分别相，石盆秋水养蕉林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王倅德远有诗谢送菊因酬二绝 其二","author":"张镃","text":"爱竹君家有子猷，黄花君复向人求。\n不妨官事兼幽事，应笑侬归两过秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"车中闻人说溪涧如水晶色口占一绝","author":"张镃","text":"涧水流如活水晶，道傍一语唤人醒。\n山林未必渠能说，说著山林便可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"写扇","author":"张镃","text":"世间功业任差殊，心地明时自有馀。\n若道必从勤学得，当年稷卨读何书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城二首 其二","author":"张镃","text":"扁舟初上一声雷，两岸浓云乱欲堆。\n堪笑此时晴太早，篷遮未定雨先来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城二首 其一","author":"张镃","text":"只道南湖没样奇，出关又有许多诗。\n便须抄取天然句，才下工夫走却伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其九","author":"张镃","text":"寮寀招邀胜引多，旷怀真语当弦歌。\n联翩逸驾知难及，乞我扁舟著钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其五","author":"张镃","text":"赐沐山行策最长，游人此日却相妨。\n洞天只得东边赏，开过灯花断杀肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其四","author":"张镃","text":"饭馀飞盖北山来，上苑虚堂柳际开。\n系马林间宁复散，却容拄杖卓青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其一","author":"张镃","text":"自得城隅水北居，西湖幽讨句全疏。\n今朝掩簿抽身出，更向谁边不一书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其三","author":"张镃","text":"卖龟船小样漪涟，折得蘋花亦当钱。\n我自沧洲隔三载，此花风调只依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其六","author":"张镃","text":"夹堤全少露桃红，独许垂杨翠拂空。\n千古苏仙几曾死，骑鲸时或下亭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其七","author":"张镃","text":"茭葑茸茸展翠毡，六桥分舞燕翎纤。\n撑船捷出苍湾去，要看山围玉镜奁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其十","author":"张镃","text":"丰乐楼前未夕晖，可堪鱼钥限城扉。\n诗成快向归时写，丹墨明朝与兴违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其八","author":"张镃","text":"喜逐刍荛禁苑东，舜弦调处剩薰风。\n戎葵学得宫衣缬，不作人间锦样红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月上浣日同寮约游西湖十绝 其二","author":"张镃","text":"清晓溟濛雨气浓，出关晴色便葱茏。\n层云特为诗人喜，添起山头四五峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月初四日听新乐成绝句 其二","author":"张镃","text":"治音安乐绍熙初，试听咸韶可并驱。\n鼗武磬襄奚足数，作成从此不愁无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月初四日听新乐成绝句 其一","author":"张镃","text":"鳌抃钧天沸广场，渡江何翅纪铿锵。\n频年遏密无悰绪，乐叟閒来说泰皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照东西两轩有红梅及千叶缃梅未经题咏倒用前韵各赋五首 其五","author":"张镃","text":"方诸台耸日边云，望拜青童上相君。\n侍女百千皆绛服，恰如檐外树纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照东西两轩有红梅及千叶缃梅未经题咏倒用前韵各赋五首 其四","author":"张镃","text":"海棠曾把比朝眠，妃子妆慵玉镜前。\n若似此花颜色好，定教天宝画师传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照东西两轩有红梅及千叶缃梅未经题咏倒用前韵各赋五首 其三","author":"张镃","text":"一粒丹砂换骨来，移根闻自浙东栽。\n市门古巷留遗迹，问讯仙翁定姓梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照东西两轩有红梅及千叶缃梅未经题咏倒用前韵各赋五首 其二","author":"张镃","text":"虽嫌绿叶与青枝，入格依前自欠诗。\n几向斜阳溪畔见，犹将桃杏误猜疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照东西两轩有红梅及千叶缃梅未经题咏倒用前韵各赋五首 其一","author":"张镃","text":"昔游尝到海中光，我与诸公各醉狂。\n同向尘中三十载，朱颜应笑鬓丝长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂次韵茂洪古梅","author":"张镃","text":"天教萼绿伴羊权，羞对尘颜粉黛妍。\n不必修真事灵诀，与花端合共长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其二十","author":"张镃","text":"高窠依约百年馀，蠹蘖重重艾衲铺。\n亲见主人来买地，遮番添得白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十九","author":"张镃","text":"风调花常逐岁新，苦惭诗思只陈陈。\n吟成不敢分明举，生怕渠知鄙薄人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十八","author":"张镃","text":"杯行才到莫留残，要向梅边露肺肝。\n今日正晴还有雪，谓予不信试遥看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十七","author":"张镃","text":"喜客能挥白玉琴，此花端解古时音。\n只防老鹤来偷听，引起翻云万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十六","author":"张镃","text":"今夕悬知月未圆，照梅已自不胜妍。\n冰姿玉色谁堪比，除是姮娥敢并肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十五","author":"张镃","text":"九节筇枝休化龙，佳时朝暮且相从。\n枯条岂但敲令尽，鸟雀冲花定不忪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十四","author":"张镃","text":"苍帝妃嫔总素装，胜游常是遍江乡。\n玉楼谪堕迟归去，冷淡工夫笑我忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十三","author":"张镃","text":"鹎鵊呼人晓梦回，霁光催赏百株梅。\n轻车不管沾泥滑，童子从来自惯推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十二","author":"张镃","text":"正煖休嫌夜雨来，恐花乘煖一齐开。\n不然何事东风意，容易吹香与碧苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十一","author":"张镃","text":"萧然日月岸纶巾，春满幽园肯倦行。\n一事尚须烦造物，看松微雨看梅晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其十","author":"张镃","text":"别开庭院近莲塘，油榭栏干小扇窗。\n更取梅花瓶内插，放教清梦月横江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其九","author":"张镃","text":"山际楼台水际村，见梅常是动吟魂。\n全身此日清芬里，篱落疏斜不喜论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其八","author":"张镃","text":"醉上轻舟泛渌漪，细穿桥柱独行迟。\n风前抚掌催花发，惊起群飞五色儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其六","author":"张镃","text":"六日新春一再来，直须登树赏花开。\n攀翻径上枝梢外，不负东风是此杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其五","author":"张镃","text":"群芳非是乏新奇，或在繁时或嫩时。\n唯有南枝香共色，从初到底绝瑕疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其四","author":"张镃","text":"纵横遥衬碧云端，林下铺毡坐卧看。\n不但归家因桂好，为梅亦合早休官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其三","author":"张镃","text":"生怕高花易过春，隔年先早著精神。\n冰绡旋买连三幅，剩与溪山并写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其二","author":"张镃","text":"映竹依松望最宜，如无似有乍开时。\n思量切比幽人语，不著工夫格自奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其一","author":"张镃","text":"一笑林间说向春，宿缘三世岂无因。\n半生忧患摧残损，却与梅花作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二十首 其七","author":"张镃","text":"从来嫌用和羹字，才到诗中俗杀人。\n一片彩云溪上暖，兴随芳草夕阳新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂梅花飘落如雪","author":"张镃","text":"阵阵翻空回旋飞，缀巾沾袖却横吹。\n东风秘授看花诀，不在开时在落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰仲冬八日元衡携两诗过访及归次韵酬送后篇兼寄张武子 其一","author":"张镃","text":"每将幽事当功名，唯欠能诗竹里僧。\n径写此篇为疏引，庵成来往岂无凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰仲冬八日元衡携两诗过访及归次韵酬送后篇兼寄张武子 其二","author":"张镃","text":"合处畴能證不疑，吾宗神秀岁寒姿。\n无书寄便今犹懒，说似应须倩老师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白头翁鸟","author":"张镃","text":"桧丛幽啭惬新晴，巧好春林百鸟声。\n羽辈误教推皓首，细听多是少年情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白杨梅","author":"张镃","text":"兴高团雪缀珍丛，弹火烧林一洗空。\n驿骑不供妃子笑，冰姿犹胜荔枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石门小泊","author":"张镃","text":"近村非少茂林枝，十二乌巢一树栖。\n应恐此间难觅句，预先留作我诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后一日池上杂兴 其四","author":"张镃","text":"冰轮艳艳涌东墙，鱼触波纹破碎光。\n十万人家眠正熟，谁知凉满一胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后一日池上杂兴 其一","author":"张镃","text":"渔舟閒上揭疏篷，倚遍苕华岸岸红。\n两日新秋凉便觉，费人诗句是西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后一日池上杂兴 其二","author":"张镃","text":"船舷何事若轻雷，荡叶冲莲一道开。\n莫待归时方命酒，径从花上递金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋后一日池上杂兴 其三","author":"张镃","text":"小娃犹记喜归时，故唱前年自赋词。\n但得池边鸥鹭听，更须门外野人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记雪三首 其三","author":"张镃","text":"无月无灯夜自明，模糊何啻瓦沟平。\n不拖藜杖高桥去，那得金龙背上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记雪三首 其二","author":"张镃","text":"直教日色避寒光，世界移来玉海藏。\n何事连年无此景，老天游戏不循常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记雪三首 其一","author":"张镃","text":"清晓疏篱尚露根，饭馀俄复拥柴门。\n南湖水色君知否，万斛鹅黄贮玉盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙井山主送腊梅","author":"张镃","text":"风落松钗满涧桥，野蜂移蜜上枯条。\n道人参得山中语，不是涂黄一样娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙瑞宫","author":"张镃","text":"阳明古罅閟灵宫，祷雨传闻见活龙。\n可是高人不留我，却从归路数杉松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任道源转示玉艳亭探梅诗卷未暇属和闰月十一日偶自北山塔院过亭下枝间已花因次元韵三首 其三","author":"张镃","text":"占断林家一种春，隔湖茅舍羡渔人。\n折枝弄蕊年年手，生怕长安揖马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任道源转示玉艳亭探梅诗卷未暇属和闰月十一日偶自北山塔院过亭下枝间已花因次元韵三首 其二","author":"张镃","text":"细看孤标迎腊瘦，争如繁艳遇春酣。\n古来节士功名薄，剩欲裁诗问水南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任道源转示玉艳亭探梅诗卷未暇属和闰月十一日偶自北山塔院过亭下枝间已花因次元韵三首 其一","author":"张镃","text":"因花不作等閒来，屐印苔纹酒便回。\n明日窗前追昨梦，似逢姑射不逢梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过莺脰湖","author":"张镃","text":"晓雾濛鸿合，山藏岸绝痕。\n浩波吞日去，金晃玉乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游 其二","author":"张镃","text":"天风吹我落人间，暂入青山又促还。\n待得霜林收柿栗，却来重扣白云关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王梦得夜坐","author":"张镃","text":"何处起香云，清谈我与君。\n雨来临水坐，鱼跃隔窗闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回至泰阳村得家信二首 其二","author":"张镃","text":"桂隐闻知得雨来，榴花应对竹光开。\n归家早见南湖月，饮水犹胜举酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]