[{"title":"王岐公挽辞 其一","author":"黄裳","text":"世事今朝了，天阍昨夜开。\n自当骑鹤去，谁更作霖来。\n宝座扶初日，灵光落上台。\n管弦空怅望，重盖几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王岐公挽辞 其二","author":"黄裳","text":"贰车登第日，秉轴盖棺时。\n未掩西陵土，先埋上相碑。\n白麻人已化，黄壤客空悲。\n岁晚林间趣，归侯想恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王岐公挽辞 其三","author":"黄裳","text":"鼎味难求和，龙髯忽许攀。\n应随先帝仗，已立太师班。\n人散沙堤悄，恩收客馆閒。\n风神岩兢秀，千古画图间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王岐公挽辞 其四","author":"黄裳","text":"富贵风波静，文章态度清。\n有缘登相府，无日出都城。\n彝鼎垂行止，金珠照死生。\n百年留不住，广阜暮烟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞 其一","author":"黄裳","text":"三封皆大国，一子已重金。\n位到西枢重，春归寸草深。\n荣华缘忽断，寂寞路难寻。\n愁入韦沟境，回头月满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞 其二","author":"黄裳","text":"偕老人惆怅，秋深雁独哀。\n西风何处问，北首几时回。\n白日晞朝露，黄埃掩夜台。\n已辞班第一，内殿不须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦国夫人挽辞 其三","author":"黄裳","text":"慰使来三殿，浇觞走百官。\n送行千乘富，归宿万家宽。\n自今腾空往，谁能入定观。\n晓堂终不见，谁展佛书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安康郡夫人挽辞 其一","author":"黄裳","text":"未满中身寿，尤虚大国封。\n德明埋玉篆，魂冷卧银龙。\n漳水恨涵月，秋风悲入松。\n尘寰应不住，无处访遗踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安康郡夫人挽辞 其二","author":"黄裳","text":"俄抛中馈世缘空，君子休悲老未同。\n不负大宁身后计，道山人出凯风中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安康郡夫人挽辞 其三","author":"黄裳","text":"堂堂归处魏公家，才饰笄珈日未斜。\n蒿里数声留不得，丰安松下早闻鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭将军挽辞 其一","author":"黄裳","text":"新里秋声不忍闻，黄埃千古宋将军。\n东兵二百今何在，犹有西人想似云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭将军挽辞 其二","author":"黄裳","text":"赳赳汾阳十世孙，胸中奇业与谁论。\n盖棺虽愧淩烟阁，犹有蕃豪说旧恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭将军挽辞 其三","author":"黄裳","text":"佛书看尽更何忧，不怨生前未是侯。\n日到中天春梦断，御风归去玉华秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顾学正挽辞","author":"黄裳","text":"行人缘断绝，吊客泪纵横。\n白发双亲重，青衫一命轻。\n仙丹谁际会，禅颂自分明。\n去住无寻处，今生与后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人陈氏挽辞 其一","author":"黄裳","text":"晓来悲接夜来欢，安不人惊梦不还。\n已御翔鸾天上去，委形空寄古楼山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人陈氏挽辞 其二","author":"黄裳","text":"宝奁人去月空寒，百岁荣华忽盖棺。\n万叶遗经香一篆，日华帘下与谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人陈氏挽辞 其三","author":"黄裳","text":"北堂旁立两青衫，六十春风惬笑谈。\n追远亭前思不见，怨随霜露满山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝议挽辞 其一","author":"黄裳","text":"箫鼓声中远远归，只因千里有庭闱。\n彭城君在今休望，黄发樽前看綵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝议挽辞 其二","author":"黄裳","text":"六拥旌麾一梦阑，陈公桥上小棠间。\n挂冠桑梓情尤厚，谁愧遗形葬客山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝议挽辞 其三","author":"黄裳","text":"从来风义不忧贫，累行才踰七十春。\n世上荣枯沤影散，进阶空有帝纶新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝议挽辞 其四","author":"黄裳","text":"信到温陵不忍闻，使君何往尽沾巾。\n最高仙桂君家物，更起黉堂遗里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝议挽辞 其五","author":"黄裳","text":"未及归来且胜游，忽闻庭木已经秋。\n罗源三十年遗爱，今作还山一日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞法曹挽辞 其一","author":"黄裳","text":"一息秋来误壮图，扬名身后喜诸孤。\n平生乐易归何处，恐逐清风落有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞法曹挽辞 其二","author":"黄裳","text":"樽前故旧欢尤少，世上光阴惜未终。\n去岁书来曾说梦，攀龙应御九天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈达野母氏恭人挽辞 其一","author":"黄裳","text":"百度韶华少一年，有谁堂上可争先。\n锦衣养志归来早，报了春晖已独贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈达野母氏恭人挽辞 其二","author":"黄裳","text":"眼明身健莫扶持，遽向华堂看綵衣。\n已共月明无认处，孝思休踊盖棺时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方彦稽母安仁县太君黄氏挽辞 其一","author":"黄裳","text":"文科名峻归宁日，卿部官高致养时。\n罔极是恩谁报得，更缘霜露有馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方彦稽母安仁县太君黄氏挽辞 其二","author":"黄裳","text":"八十三年妇德成，綵衣欢笑过浮生。\n含虚台上寻仙侣，濑口愁人月自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方彦稽母安仁县太君黄氏挽辞 其三","author":"黄裳","text":"来处缘应异，归时寿已稀。\n校雠孙继子，无限是春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方彦稽母安仁县太君黄氏挽辞 其四","author":"黄裳","text":"数终还是福，道尽更何言。\n子到康民处，方知鞠育恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿安太君挽辞","author":"黄裳","text":"荣知随养去，恨向盖棺归。\n故里三千远，浮生七十稀。\n晓台空匣鉴，秋露谩沾衣。\n相伴勤田上，残蟾与夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章银青挽辞","author":"黄裳","text":"八十六年尽，灶中丹未成。\n贰车归去勇，辟谷老来清。\n寂寂水天境，悠悠春露情。\n扬名尤有子，身后许谁争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼张公实","author":"黄裳","text":"六十三年素自知，人生如此更何疑。\n调诙常为供狂笑，骚雅偏能斲小诗。\n悼子杳冥归往路，悔予轻易别离时。\n水云村记相期事，虽到家山已恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼陈伯修殿院 其一","author":"黄裳","text":"尘劳常共笑，匆遽忽相违。\n已失重归约，应无再见时。\n短长前事定，来去几人知。\n阴籍更何累，惟馀身后悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼陈伯修殿院 其二","author":"黄裳","text":"喜从杨子过江湄，惹起浮生一段悲。\n不见武林吟笑侣，却来京口看铭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼陈伯修殿院 其三","author":"黄裳","text":"少年科第少能攀，未及登庸梦已阑。\n岂意盖棺尤有地，于飞同在戏鱼山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼陈先之博士","author":"黄裳","text":"五行才悟已忘筌，妙旨知谁更得传。\n梦幻去时无别苦，旌幢归处有前缘。\n寂寥月伴松楸室，悽怆人逢雨露天。\n尚记辱书来见报，春回寒谷未踰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼李承议","author":"黄裳","text":"去后家山宴未阑，已闻忙盖旅中棺。\n几多言笑情先断，些小穷通梦已残。\n友爱方嗟离别易，子贤休恤继承难。\n曾相从处应留恨，未结松庵弃外观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭陈商老","author":"黄裳","text":"浮云前事定，壮志此生休。\n梦冷水中月，文高天上楼。\n冥冥谁造物，衮衮自封侯。\n南国一缄破，西风双泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其一 初祖","author":"黄裳","text":"一花迦叶离尘果，四卷楞伽助道书。\n莫谓竺乾天样远，片云归去祇须臾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其二 初祖","author":"黄裳","text":"谁知花叶一中生，二气相催果自成。\n体了色空无觅处，有时人说见还婴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其三 初祖","author":"黄裳","text":"大乘气象已相扶，吾意方终道不孤。\n秀出五峰尘下少，中华先许到真如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其四 初祖","author":"黄裳","text":"日用中来体已亲，平常是道岂须陈。\n得吾髓处无他事，拟议三人且觅真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其五 初祖","author":"黄裳","text":"安心惟在觅心时，后世支尘两自欺。\n寄语禅林休歇去，古来仙圣本无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其六 初祖","author":"黄裳","text":"本来无一亦无华，都向真空是一家。\n闻说一花还共笑，宁甘鬼窟作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其七 初祖","author":"黄裳","text":"如意珠，舍利子，建立法身无二理。\n发明道果独为师，长养圣胎谁得旨。\n六物名同实非异，微妙如来出尘计。\n一念中含一点来，太无根种岂须猜。\n谁尸五运催神化，忽见天花五叶开。\n含万类，贯三界，无无无有非私解。\n法轮如我神气精，尘世通他来去在。\n九年转了大还丹，世间无价人难买。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其八 初祖","author":"黄裳","text":"参禅须向坐禅人，本末相通可了真。\n二念回机都扫尽，乾坤犹在一微尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其九 初祖","author":"黄裳","text":"精传神气一传精，性命于中附会成。\n道世浑沦窥不破，更从何处觅无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其十 初祖","author":"黄裳","text":"精传神气一传精，含作真空万化行。\n是物此中来与去，莫持偏性作圆成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其十一 初祖","author":"黄裳","text":"天游杳杳海漫漫，无有无无是道观。\n大法药兼心地要，两门都作混成看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其十二 初祖","author":"黄裳","text":"神光中见一还婴，非外非中已混成。\n忽向玉炉飞上去，数声灵鹊夜来惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其十三 初祖","author":"黄裳","text":"万枝灯，千江月，一灯传，一月摄。\n莫知根种有虚空，祇见祥光无断绝。\n三千世界掌中知，百亿化身天下说。\n秘密岂当容易谈，一臂尤轻冷欺雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其一 二祖","author":"黄裳","text":"有地有花空具色，无花无种色含空。\n混成一物谁圆就，但向无言一化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其二 二祖","author":"黄裳","text":"受果时来合见仙，香山禅定想多年。\n少林得旨圆融了，不在中间与两边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其三 二祖","author":"黄裳","text":"华岂曾生种亦无，迩来何事得神珠。\n尘凡不悟无为旨，但笑高人一似愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其四 二祖","author":"黄裳","text":"曾穷庄易到源渊，三教从来共本根。\n自到少林应已悟，后来谁为晓宗门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其五 二祖","author":"黄裳","text":"宿来缘累尚相拘，何事圆成未自如。\n十地三乘谁便了，了时犹待到无无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其一 三祖","author":"黄裳","text":"入道从来自有缘，许谁心地是金仙。\n如来止止教休说，妙法难思莫妄传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其二 三祖","author":"黄裳","text":"衣法曾传莫己知，两山禅定了何疑。\n本无一物非何有，大道宁嫌得小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其三 三祖","author":"黄裳","text":"地种精华总是无，无中和会一神珠。\n前缘谁是传衣子，水月如心可上图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其一 四祖","author":"黄裳","text":"万宝收还万合中，更寻心地亦还空。\n紫云盖下已呈瑞，佛法一枝谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其二 四祖","author":"黄裳","text":"路上相逢即是缘，心知衣法有人传。\n真成净土含诸种，直到生生始得仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其三 四祖","author":"黄裳","text":"解脱门中宿已知，种花生性岂须期。\n诏书四反终难起，不要浮名不待时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其一 五祖","author":"黄裳","text":"情种俱收入混成，还并四事得无生。\n字虽不识人休笑，壁上留题已可惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其二 五祖","author":"黄裳","text":"无生无种菩提就，非佛非心混沌成。\n欲说性空何处觅，可怜禅律谩相争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其三 五祖","author":"黄裳","text":"形生收摄出尘笼，一颗圆光色与空。\n槽厂有人来作祖，自然吟入太无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其四 五祖","author":"黄裳","text":"尘埃可佛是修时，无物无修秀也知。\n欲说菩提符祖意，圆明来处想曾窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其一 六祖","author":"黄裳","text":"顿悟花情有几人，源流相远却非真。\n须知佛性无南北，芥子中藏万法轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其二 六祖","author":"黄裳","text":"泰定犹忘相行深，种华当向此中生。\n坐禅只恐人无證，得旨须教矿作金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其三 六祖","author":"黄裳","text":"下种人来地有因，若非因地若轻陈。\n曾将此子教谁种，安解参同向吕真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其四 六祖","author":"黄裳","text":"从来生灭本因心，旁出纷纷没处寻。\n无性无心方是道，执空谁可脱浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其五 六祖","author":"黄裳","text":"法身行止本来无，叶落归根是幻躯。\n生灭已除还寂灭，有情相感莫踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其六 六祖","author":"黄裳","text":"曾戒观空与坐禅，惟因唐使说真筌。\n九年面壁谁能少，秘密先当得祖传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其七 六祖","author":"黄裳","text":"妙了形神更有人，不须捐下梦中身。\n逍遥便作丹台客，谁悟三丹有二真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖传付偈颂 其八 六祖","author":"黄裳","text":"大事从来夙有因，太空全是气精神。\n牟尼莫怪无人问，作用皆云已得真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]