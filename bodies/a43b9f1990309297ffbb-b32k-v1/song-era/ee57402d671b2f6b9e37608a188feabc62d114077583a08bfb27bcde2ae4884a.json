[{"title":"新安四咏 其四","author":"崔鶠","text":"我爱新安好，新安度岁华。\n风烟迷郡阁，浦溆带人家。\n南亩元多黍，丘中亦种麻。\n更逢飘皂盖，疆埸视新瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾依柏引蔓上冒其颠","author":"崔鶠","text":"春风亦已老，自厌丹采媚。\n独留白雪花，洒此千尺翠。\n嵯峨珠笼冠，缥缈冒佛髻。\n幽香勿袭人，恐为真色累。\n但愿保明姿，终日奉清对。\n要之万物夥，污洁自有类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潜心斋","author":"崔鶠","text":"双扉掩馀香，一榻下凉幔。\n前人嗟不死，万古映黄卷。\n时时撷英华，一一诣微远。\n鼎食姑置之，此味良不浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"崔鶠","text":"伯鸾下吴越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"崔鶠","text":"西山横身映吴甸，意将万里倾衡霍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"崔鶠","text":"清明烟火尚阑珊，花信风来第几番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"崔鶠","text":"遥知金刹近，林表飏幡尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"崔鶠","text":"团脐紫蟹初欲尝，染指腥盐还复辍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"崔鶠","text":"翠裘锦帽初相识，鱼虎弯环略岸飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"崔鶠","text":"老去未觉跻攀难，一表独立青冥里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"崔鶠","text":"小艇元从天上来，白云自向杯中落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"崔鶠","text":"一从台倾苑树死，空馀飘瓦裁纹鸳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次杨梦锡雪后古梅正芳韵兼呈李史君","author":"常不轻","text":"郭相谋深古来少，词翰升堂为君扫。\n忆君诵诗神凛然，相逢苦觉人情好。\n歌词自作风格老，百壶且试开怀抱。\n皂盖能忘折野梅，浣花溪里花饶笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游■山寺","author":"常令孙","text":"薝卜花中燕子飞，旌旗小队到招提。\n客车陆续毡重席，僧馔雍客藿间藜。\n文奕已先元墅夺，诗坛渐压鲁山低。\n归来醉步谁扶杖，月在牛栏西复西。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兰江","author":"常均","text":"波翻雪浪养云涛，亭压兰江意气高。\n楚国兴亡何处问，佩兰人去有离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送举人","author":"常祎","text":"革去颓风靳选抡，翕然公论一时伸。\n棘围共试三千士，海郡联飞二十人。\n竞说马群空冀野，好看鲲化上云津。\n从来自有湖平谶，由此公卿稳致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贾司仓祠堂","author":"常勉","text":"自古才难达，司仓与世乖。\n官虽为言谪，名不共身埋。\n龛像尘昏壁，诗魂月满斋。\n孤坟没秋草，客到重伤怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺东道","author":"常挺","text":"隆暑赫炎曦，门弧庆左垂。\n东君来出世，西斗降临时。\n二子麒麟种，三孙鸑鷟儿。\n称觞门下士，愿祝寿期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽想庵和尚","author":"常挺","text":"想庵住世大玲珑，脱壳谁知脱屣同。\n现相维尘非是病，到头法喜本真空。\n一尘顿灭灵台上，万劫都销烈焰中。\n从此尺丘藏卵塔，白云流水任西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡久轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗送别得汉字","author":"常挺","text":"庆元道学家，紫阳诸弟冠。\n正印君得之，理窟讲深贯。\n雄文摛玉堂，直笔插东观。\n粹然中和容，清庙古圭瓒。\n遁翁上封事，犹或以蓍断。\n君袖秋月章，直造紫皇案。\n赤手搏长鲸，未能分万段。\n白华久无诗，清风可激顽。\n去身似叶轻，来事如麻乱。\n帝忧大江东，所至有水旱。\n列宿选郎闱，福星下霄汉。\n祇恐席未温，宣室夜将半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视师颂","author":"常挺","text":"岷山穹隆，岷水浺瀜。\n气郁葱葱，至和所钟。\n秀毓临邛，笃生英雄。\n绰有祖风，唐之郑公。\n进思尽忠，王臣靡躬。\n万壑奔洚，砥植在中。\n退思固穷，为时儒宗。\n启迪颛蒙，如金在镕。\n王明泰通，虎啸风从。\n入觐九重，天子改容。\n时谨边烽，命公抚戎。\n大江西东，隐若长墉。\n甲兵藏胸，樽俎折冲。\n万年之功，寿与天同。\n聊述鄙悰，以侑乐工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日词","author":"常某","text":"庭院深深春日迟，百花落尽蜂蝶稀。\n柳絮随风不拘管，飞入洞房人不知。\n画堂绣幕垂朱户，玉炉消尽沉香炷。\n半褰斗帐曲屏山，尽日梁间双燕语。\n美人睡起敛翠眉，强临鸾鉴不胜衣。\n门外鞦韆一笑发，马上行人断肠归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书园契上赵尚书","author":"常省元","text":"乾坤到处是吾亭，机械从来未必真。\n覆雨翻云成底事，清风明月冷看人。\n兰亭禊事今非晋，桃洞神仙也笑秦。\n园是主人身是客，问君还有几年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"常秩","text":"冻杀汝阴常处士，也来骑马听朝鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩宫偶成","author":"常楙","text":"松风朝来入梦频，公馀乘兴去寻真。\n红尘物外长清境，白日壶中不老春。\n柏子灰寒烟寂寂，桃花风暖水粼粼。\n逍遥羽士闲如许，愧我浮名役此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西湖水阁","author":"常颛孙","text":"倚湖松竹拥楼台，景物招人得得来。\n谁识我身非俗物，洞门深锁不容开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"可惜","author":"康与之","text":"帘幕重重下玉钩，隔帘春在柳梢头。\n东风著意相料理，吹去杨花不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉虹洞二首 其二","author":"康与之","text":"满山一夜风篁响，透屋三更月露寒。\n自掩残书推枕睡，江湖秋梦水云宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉虹洞二首 其一","author":"康与之","text":"睡起疏帘一半开，更无人迹过青苔。\n须臾苍狗风前变，雷雨驱潮出海来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严陵怀古","author":"康与之","text":"建武中兴宝运开，股肱俱是济时才。\n汉家鼎祚如磐石，此老方图拂袖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游慧力寺 其二","author":"康与之","text":"江上浓阴晓未开，瘦筇支我上苍苔。\n春寒前日去已尽，今日又从何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徽宗宸翰","author":"康与之","text":"玉辇宸游事已空，尚馀奎藻绘春风。\n年年花鸟无穷恨，尽在苍梧夕照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹭","author":"许志仁","text":"春暗汀洲杜若香，风标公子白霓裳。\n碧天片雪忽飞去，何处人家水满塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僻居","author":"康与之","text":"巷僻过从少，柴门尽日关。\n莺声常在柳，云影不离山。\n有道难言□，虽贫未厌閒。\n川原烟四暝，春思有无间。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招真词","author":"康与之","text":"白鹤巢兮丹井空，蓬山杳兮烟霞濛。\n陵谷变兮今古，木叶下兮秋风。\n飞仙去兮朝太微，黄冠野服兮以游以嬉。\n餐霞卧月兮世不我违，与世涤映兮天门可驰。\n苍龙嘷兮云漫扉，石泉冽兮山芋肥。\n俯仰宇宙兮日月蔽亏，灵秀回薄兮野芳呈姿。\n山中之乐兮万化莫移，仙人不来兮隐者曷归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"康与之","text":"越王山下千树梅，逐客年年走马来。\n寒玉满枝风色里，不受暖霭轻烟催。\n故人千里复万里，折香欲寄生徘徊。\n孤吟独醉常夜半，山月野风骑马回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶","author":"康与之","text":"夜深琵琶声似裂，一曲霓裳一庭月。\n曲终人影在西阶，困倚东风步摇折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤舒台","author":"康与之","text":"白云深处路崎岖，鹤去台空景物殊。\n山展翠屏连紫幕，泉分清溜滴明珠。\n道人祇问丹砂井，隐客犹寻九节蒲。\n试问葛仙仙去后，至今遗迹事何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游慧力寺 其一","author":"康与之","text":"天涯芳草尽绿，路旁柳絮争飞。\n啼鸟一声春晚，落花满地人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子","author":"康与之","text":"潮生浦口云，潮落津头树。\n潮本无心落又生，人自来还去。\n今古短长亭，送往迎来处。\n老尽东西南北人，亭下潮如故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑奴儿令 其二 自岭表还临安作","author":"康与之","text":"红楼紫陌青春路，柳色皇州。\n月淡烟柔。\n袅袅亭亭不自由。\n旧时扶上雕鞍处，此地重游。\n总是新愁。\n柳自轻盈水自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑奴儿令/采桑子 其一 促养直赴雪夜溪堂之约","author":"康与之","text":"冯夷剪碎澄溪练，飞下同云。\n著地无痕。\n柳絮梅花处处春。\n山阴此夜明如昼，月满前村。\n莫掩溪门。\n恐有扁舟乘兴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年游 元夕应制","author":"康与之","text":"双龙烛影，千门夜色，三五宴瑶台。\n舞蝶随香，飞蝉扑鬓，人自蕊宫来。\n太平箫鼓宸居晓，清漏玉壶催。\n步辇归时，绮罗生润，花上月徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆秦娥","author":"康与之","text":"春寂寞。\n长安古道东风恶。\n东风恶。\n胭脂满地，杏花零落。\n臂销不奈黄金约。\n天寒犹怯春衫薄。\n春衫薄。\n不禁珠泪，为君弹却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思 游西湖","author":"康与之","text":"南高峰，北高峰，一片湖光烟霭中。\n春来愁杀侬。\n郎意浓，妾意浓。\n油壁车轻郎马骢，相逢九里松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松","author":"康与之","text":"画桥流水欲平阑。\n雨后青山。\n去年芳草今年恨，恨香车、不逐雕鞍。\n红杏墙头院落，绿杨楼外秋千。\n谢娘别后忆前欢。\n泪滴春衫。\n柔荑共折香红处，劝东风、且与流连。\n早是相思瘦损，梅花谢了春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松 其二 闺思","author":"康与之","text":"碧苔满地衬残红。\n绿树阴浓。\n晓莺啼破眉心事，旧愁新恨重重。\n翠黛不忺重扫，佳时每恨难同。\n花开花谢任东风。\n此恨无穷。\n梦魂拟逐杨花去，殢人休下帘栊。\n要见只凭清梦，几时真个相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风流子","author":"康与之","text":"结客少年场。\n繁华梦，当日赏风光。\n红灯九街，买移花市，画楼十里，特地梅妆。\n醉魂荡，龙跳撝万字，鲸饮吸三江。\n娇随钿车，玉骢南陌，喜摇双桨，红袖横塘。\n天涯归期阻，衡阳雁不到，路隔三湘。\n难见谢娘诗好，苏小歌长。\n漫自惜鸾胶，朱弦何在，暗藏罗结，红绶消香。\n歌罢泪沾宫锦，襟袖淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"康与之","text":"玉楼人静。\n高卷疏帘情迥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 慈宁殿元夕被旨作","author":"康与之","text":"云海沈沈，峭寒收建章。\n雪残鳷鹊。\n华灯照夜，万井禁城行乐。\n春随鬓影，映参差、柳丝梅萼。\n丹禁杳，鳌峰对耸，三山上通寥廓。\n春衫绣罗香薄。\n步金莲影下，三千绰约。\n冰轮桂满，皓色冷浸楼阁。\n霓裳帝乐，奏升平、天风吹落。\n留凤辇、通宵宴赏，莫放漏声闲却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春令/玉楼春","author":"康与之","text":"青笺后约无凭据。\n误我碧桃花下语。\n谁将消息问刘郎，怅望玉溪溪上路。\n春来无限伤情绪。\n拟欲题红都寄与。\n东风吹落一庭花，手把新愁无写处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子","author":"康与之","text":"南溪二月雨初晴。\n四郊明。\n暖风轻。\n一雨一风，铺地落红英。\n枝上流莺啼劝我，春欲去，且留春。\n登临行乐慰闲情。\n过长亭。\n暮潮平。\n四面青芜，中是越王城。\n信马行吟归路晚，山簇簇，柳阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"康与之","text":"名与牡丹联谱，南珍独比江瑶。\n闽山入贡冠前朝。\n露叶风枝袅袅。\n香玉满苞仙液，绉红圆戚鲛绡。\n华清宫殿蜀山遥。\n一骑红尘失笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应天长 闺思","author":"康与之","text":"管弦绣陌，灯火画桥，尘香旧时归路。\n肠断萧娘，旧日风帘映朱户。\n莺能舞，花解语。\n念后约、顿成轻负。\n缓雕辔、独自归来，凭栏情绪。\n楚岫在何处。\n香梦悠悠，花月更谁主。\n惆怅后期，空有鳞鸿寄纨素。\n枕前泪，窗外雨。\n翠幕冷、夜凉虚度。\n未应信、此度相思，寸肠千缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杏花天 慈宁殿春晚出游","author":"康与之","text":"帝城柳色藏春絮。\n嫩绿满、游人归路。\n残红剩蕊留春住。\n无奈霏微细雨。\n南陌上、玉辔钿车，怅紫陌、青门日暮。\n黄昏院落人归去。\n犹有流莺对语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其二 长安怀古","author":"康与之","text":"阿房废址汉荒丘。\n狐兔又群游。\n豪华尽成春梦，留下古今愁。\n君莫上，古原头。\n泪难收。\n夕阳西下，塞雁南飞，渭水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其一 登郁孤台，与施德初同读坡诗作","author":"康与之","text":"郁孤台上立多时。\n烟晚暮云低。\n山川城郭良是，回首昔人非。\n今古事，只堪悲。\n此心知。\n一尊芳酒，慷慨悲歌，月堕人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卖花声 其一 闺思","author":"康与之","text":"蹙损远山眉。\n幽怨谁知。\n罗衾滴尽泪胭脂。\n夜过春寒愁未起，门外鸦啼。\n惆怅阻佳期。\n人在天涯。\n东风频动小桃枝。\n正是销魂时候也，撩乱花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卖花声 其二 闺思","author":"康与之","text":"愁捻断钗金。\n远信沈沈。\n秦筝调怨不成音。\n郎马不知何处也，楼外春深。\n好梦已难寻。\n夜夜馀衾。\n目穷千里正伤心。\n记得当初郎去路，绿树阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"康与之","text":"晚来一霎风兼雨，洗尽炎光。\n理罢笙篁。\n却对菱花淡淡妆。\n绛绡缕薄冰肌莹，雪腻酥香。\n笑语檀郎。\n今夜纱厨枕簟凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金菊对芙蓉 秋怨","author":"康与之","text":"梧叶飘黄，万山空翠，断霞流水争辉。\n正金风西起，海燕东归。\n凭栏不见南来雁，望故人、消息迟迟。\n木樨开后，不应误我，好景良时。\n只念独守孤帏。\n把枕前嘱付，一旦分飞。\n上秦楼游赏，酒殢花迷。\n谁知别后相思苦，悄为伊、瘦损香肌。\n花前月下，黄昏院落，珠泪偷垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌令/洞仙歌","author":"康与之","text":"若耶溪路。\n别岸花无数。\n欲敛娇红向人语。\n与绿荷、相倚恨，回首西风，波淼淼、三十六陂烟雨。\n新妆明照水，汀渚生香，不嫁东风被谁误。\n遣踟蹰、骚客意，千里绵绵，仙浪远、何处凌波微步。\n想南浦、潮生画桡归，正月晓风清，断肠凝伫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷叶铺水面 春游","author":"康与之","text":"春光艳冶，游人踏绿苔。\n千红万紫竞香开。\n暖风拂鼻籁，蓦地暗香透满怀。\n荼蘼似锦裁。\n娇红间绿白，只怕迅速春回。\n误落在尘埃。\n折向鬓云间、金凤钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花","author":"康与之","text":"杨花飘尽。\n云压绿阴风乍定。\n帘幕闲垂。\n弄语千般燕子飞。\n小楼深静。\n睡起残妆犹未整。\n梦不成归。\n泪滴斑斑金缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望江南 重九遇雨","author":"康与之","text":"重阳日，四面雨垂垂。\n戏马台前泥拍肚，龙山路上水平脐。\n淹浸倒东篱。\n茱萸胖，黄菊湿齑齑。\n落帽孟嘉寻箬笠，漉巾陶令买蓑衣。\n都道不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"康与之","text":"弱柳小腰身。\n双双蛾翠颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮令 其一 长安怀古","author":"康与之","text":"秦时宫殿咸阳里。\n千门万户连云起。\n复道亘西东。\n不禁三月风。\n汉唐乘王气。\n万岁千秋计。\n毕竟是荒丘。\n荆榛满地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]