"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和资政侍郎雪后书事","author":"梅尧臣","text":"风旗冷落偏欺酒，众树芳菲欲并梅。\n人意不知南亩望，只惊鸿雁向川来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和资政侍郎雪后登看山亭","author":"梅尧臣","text":"湖上晴烟冻未收，湖中佳景可迟留。\n更临危树看群岫，雪色岚光向酒浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和通判八月十五夜招玩月二章 其二","author":"梅尧臣","text":"一年一见最堪惜，百岁百夕能几多。\n纵有明年似今夕，明年同会复如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和通判八月十五夜招玩月二章 其一","author":"梅尧臣","text":"寻常圆魄岂不好，竞爱今宵分外明。\n明极只知无隔碍，谁言桂树向中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和通判太博雪后招饮二首 其二","author":"梅尧臣","text":"邀饮奏醴醪，案杯烹蟹螯。\n吾非独醒者，莫诵楚人骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和通判太博雪后招饮二首 其一","author":"梅尧臣","text":"雪晴何所乐，乐趣在杯中。\n况复君家美，雕盘脍缕红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和钱深推官见寄","author":"梅尧臣","text":"无才不敢学阳秋，嗜酒时能问大酋。\n前日偶从河上饮，文章何可并英游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和梅龙图观小录","author":"梅尧臣","text":"四百鸾皇羽翼成，高低轻重出权衡。\n他时俱作公卿去，誇是王家门下生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答范天民","author":"梅尧臣","text":"古今冠佩立朝人，多作北山松下尘。\n我爱蟠桃种来久，开花结子不由春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其一 静舍","author":"梅尧臣","text":"野木扶疏重复重，塘蒲涵水绿茸茸。\n琴书尤古得为乐，休问前山有戴颙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其七 移竹","author":"梅尧臣","text":"远爱檀栾碧径开，荷锄乘雨破秋苔。\n直须探作阮家趣，更向烟林缺处栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其九 绵桧","author":"梅尧臣","text":"翠色凌寒岂易衰，柔条堪结更葳蕤。\n松身柏叶能相似，劲拔缘何不自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其二 西斋","author":"梅尧臣","text":"静节归来自结庐，稚川闲去亦多书。\n请君架上添芸草，莫遣中间有蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其八 花坞","author":"梅尧臣","text":"杂芳春发浅深丛，曲坞逶迤紫间红。\n色贱格微应不数，少添兰菊待秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其十 新井","author":"梅尧臣","text":"浅浅清泉自鉴开，鳞鳞寒甃未生苔。\n山中亭午野禽渴，不畏人惊欲下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其三 北轩","author":"梅尧臣","text":"冬日迎暄此未宜，苦吟那对朔风时。\n祇誇砌下留残雪，不看檐间斗柄垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其五 松阜","author":"梅尧臣","text":"勾引风声已可听，高阴仍更接岗形。\n知君久欲平心气，早晚根傍长茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其六 小舫","author":"梅尧臣","text":"小舫闲撑莫厌迟，比于刳艇劣相宜。\n漕河有处通陂水，深入荷花人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刁太博新墅十题 其四 丛杉","author":"梅尧臣","text":"植干森然美在庭，更怜相倚自青青。\n翠姿且有干云势，岂是孤生向远坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和十一月八日圃人献小桃花二绝 其二","author":"梅尧臣","text":"前占寒食一百六，算到其时未合开。\n丹艳已先灰管动，不由人力与栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和十一月八日圃人献小桃花二绝 其一","author":"梅尧臣","text":"当时开向杏花后，今日绽当梅萼前。\n不畏雪霜何太甚，繁英如火满枝燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和十一月十二日与诸君登西园亭榭怀旧书事 其二","author":"梅尧臣","text":"莎径依然见莎叶，莲塘无复有莲花。\n更看白水满城下，说著当时龙骨车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和十一月十二日与诸君登西园亭榭怀旧书事 其一","author":"梅尧臣","text":"冬日萧条公府清，独将诸吏上高城。\n而今何处异畴昔，铁墓下闻狐夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和公仪龙图小桃花","author":"梅尧臣","text":"三分春色一分休，始见桃花著树头。\n霰雪斗来如约勒，为公留作上林游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和公仪龙图戏勉","author":"梅尧臣","text":"五公雄笔厕其间，愧似丘陵拟泰山。\n岂意来嘲饭颗句，忙中唯此是偷闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和公仪龙图新居栽竹二首 其二","author":"梅尧臣","text":"都城有地谁栽竹，只见寒樗与老槐。\n闻种琅玕向新第，翠光秋影上屏来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和公仪龙图新居栽竹二首 其一","author":"梅尧臣","text":"八月竹根移要雨，逢阴便向阮家求。\n请公静听萧萧叶，斗变江南一夜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王待制出郊马上口占寄兄道损次韵","author":"梅尧臣","text":"日暖寒郊不起风，使君车骑出城中。\n遥知望处思兄弟，鸿雁连连下远空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔六篇 其一 详定幕次呈同舍","author":"梅尧臣","text":"苑树天边雨露匀，群公偷看锦丛新。\n眼穿欲折无由折，赏到人间不是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔六篇 其五 和邻几学士桃花","author":"梅尧臣","text":"深殿有春人到稀，武陵虽说昧当时。\n踌躇莫忆人间世，恐至尘中悔却迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔六篇 其四 禁中鞓红牡丹","author":"梅尧臣","text":"与公同是洛阳客，今日论年皆作翁。\n一见此花知有感，衰颜不似旧时红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔郡斋闻百舌","author":"梅尧臣","text":"响舌能令百鸟羞，听时丹杏发山邮。\n春云不定雨来急，湿翅苍茫高树头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔琅琊山六咏 其二 琅琊溪","author":"梅尧臣","text":"枯藤垂溪水已消，溪水溅溅石间乱。\n潭静鸟呼人渡时，鸟惊人语来还散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和永叔琅琊山六咏 其三 班春亭","author":"梅尧臣","text":"林下鸣鸠坼晴杏，田间水漫春溶溶。\n使君固自足风美，时傍青山去问农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言以蜀笺南笺答松管之什","author":"梅尧臣","text":"青松抽干龙鳞细，秋兔束毫鸡距尖。\n杨子拟经聊以赠，蜀麻江楮报何嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言学士官舍十题 其八 水红","author":"梅尧臣","text":"江天淡淡江水平，江岸有花红作穗。\n今日特向都城开，昼时只合衔鱼翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言学士官舍十题 其十 兰","author":"梅尧臣","text":"楚泽多兰人未辩，尽以清香为比拟。\n萧茅杜若亦莫分，唯取芳声袭衣美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言学士官舍十题 其九 甘菊","author":"梅尧臣","text":"世言此解制颓龄，便当园蔬春竞种。\n到秋犹得泛其英，烂醉莫辞官有俸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言学士官舍十题 其四 石兰","author":"梅尧臣","text":"言石曾非石上生，名兰乃是兰之类。\n疗痾炎帝与书功，纫佩楚臣空有意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言学士官舍十题 其五 萱草","author":"梅尧臣","text":"人心与草不相同，安有树萱忧自释。\n若言忧及此能忘，乃是人心为物易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和石昌言学士官舍十题 其三 薏苡","author":"梅尧臣","text":"叶如华黍实如珠，移种官庭特葱茜。\n但蠲病渴付相如，勿恤谤言归马援。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张簿宁国山门六题 其三 夕阳岩","author":"梅尧臣","text":"日脚射空金缕直，下映壁间棱未织。\n野老先知雨又风，明朝望此重云黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张簿宁国山门六题 其四 朝阳洞","author":"梅尧臣","text":"洞门虽向扶桑开，洞深不放阳乌入。\n古来道士今莫逢，石壁乳流苔正湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨秘校得糟鲌","author":"梅尧臣","text":"食鱼何必食河鲂，自有诗人比兴长。\n淮浦霜鳞更腴美，谁怜按酒敌庖羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范景仁王景彝殿中杂题三十八首并次韵 其二十九 再观牡丹","author":"梅尧臣","text":"闻说偷观近玉栏，肠如车毂走千盘。\n无人忆著洛阳日，走马魏王堤上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范景仁王景彝殿中杂题三十八首并次韵 其三十一 紫牡丹","author":"梅尧臣","text":"叶底风吹紫锦囊，宫炉应近更添香。\n试看沉色浓如泼，不愧逢君翰墨场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范景仁王景彝殿中杂题三十八首并次韵 其三十七 再赋","author":"梅尧臣","text":"谁人重咏大刀头，只顾长明不愿流。\n纵使西倾必东出，宁同寒水泻宫沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范景仁王景彝殿中杂题三十八首并次韵 其三十二 七宝茶","author":"梅尧臣","text":"七物甘香杂蕊茶，浮花泛绿乱于霞。\n啜之始觉君恩重，休作寻常一等誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范景仁王景彝殿中杂题三十八首并次韵 其三十八 殿中飞","author":"梅尧臣","text":"玉几当中宝作床，无端絮惹御袍香。\n群公唱第鱼龙化，列侍金阶若堵墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范景仁王景彝殿中杂题三十八首并次韵 其三十三 庖烟","author":"梅尧臣","text":"羃历庖烟出綵油，欲通云雾未能周。\n湿薪烧尽日停午，试问霏霏何处浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]