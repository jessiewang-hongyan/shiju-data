[{"title":"好女儿令/好女儿","author":"欧阳修","text":"眼细眉长。\n宫样梳妆。\n靸鞋儿走向花下立著。\n一身绣出，两同心字，浅浅金黄。\n早是肌肤轻渺，抱著了、暖仍香。\n姿姿媚媚端正好，怎教人别后，从头仔细，断得思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖念语","author":"欧阳修","text":"昔者王子猷之爱竹，造门不问于主人，陶渊明之卧舆，遇酒便留于道士。\n况西湖之胜概，擅东颍之佳名。\n虽美景良辰，固多于高会。\n而清风明月，幸属于闲人。\n并游或结于良朋，乘兴有时而独往。\n鸣蛙暂听，安问属官而属私。\n曲水临流，自可一觞而一咏。\n至欢然而会意，亦傍若于无人。\n乃知偶来常胜于特来，前言可信。\n所有虽非于己有，其得已多。\n因翻旧阕之辞，写以新声之调，敢阵薄伎，聊佐清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"欧阳修","text":"去年今日落花时。\n依前又见伊。\n淡匀双脸浅匀眉。\n青衫透玉肌。\n才会面，便相思。\n相思无尽期。\n这回相见好相知。\n相知已是迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"欧阳修","text":"雪霜林际见依稀。\n清香已暗期。\n前村已遍倚南枝。\n群花犹未知。\n情似旧，赏休迟。\n看看陇上吹。\n便从今日赏芳菲。\n韶华取次归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其三","author":"欧阳修","text":"玉肌花脸柳腰肢。\n红妆浅黛眉。\n翠鬟斜亸语声低。\n娇羞云雨时。\n伊怜我，我怜伊。\n心儿与眼儿。\n绣屏深处说深期。\n幽情谁得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"欧阳修","text":"浓香搓粉细腰肢。\n青螺深画眉。\n玉钗撩乱挽人衣。\n娇多长睡迟。\n绣帘角，月痕低。\n仙郎东路归。\n泪红满面湿胭脂。\n兰房怨别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"欧阳修","text":"落花浮水树临池。\n年前心眼期。\n见来无事去还思。\n而今花又飞。\n浅螺黛，淡燕脂。\n闲妆取次宜。\n隔帘风雨闭门时。\n此情风月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"欧阳修","text":"刘郎何日是来时。\n无心云胜伊。\n行云犹解傍山飞。\n郎行去不归。\n强匀画，又芳菲。\n春深轻薄衣。\n桃花无语伴相思。\n阴阴月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"系裙腰","author":"欧阳修","text":"水轩檐幕透薰风。\n银塘外、柳烟浓。\n方床遍展鱼鳞簟，碧纱笼。\n小墀面、对芙蓉。\n玉人共处双鸳枕，和娇困、睡朦胧。\n起来意懒含羞态，汗香融。\n素裙腰，映酥胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其一","author":"欧阳修","text":"歌时眉黛舞时腰。\n无处不娇饶。\n初剪菊、欲登高。\n天气怯鲛绡。\n紫丝障，绿杨桥。\n路迢迢。\n酒阑歌罢，一度归时，一度魂消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其二","author":"欧阳修","text":"离怀酒病两忡忡。\n欹枕梦无踪。\n可怜有人今夜，胆小怯房空。\n杨柳绿，杏梢红。\n负春风。\n迢迢别恨，脉脉归心，付与征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 眉意","author":"欧阳修","text":"清晨帘幕卷轻霜。\n呵手试梅妆。\n都缘自有离恨，故画作，远山长。\n思往事，惜流芳。\n易成伤。\n拟歌先敛，欲笑还颦，最断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎春乐","author":"欧阳修","text":"薄纱衫子裙腰匝。\n步轻轻、小罗靸。\n人前爱把眼儿札。\n香汗透、胭脂蜡。\n良夜永、幽期欢则洽。\n约重会、玉纤频插。\n执手临归，犹且更待留时霎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行船","author":"欧阳修","text":"轻捧香腮低枕。\n眼波媚、向人相浸。\n佯娇佯醉索如今，这风情、怎教人禁。\n却与和衣推未寝。\n低声地、告人休恁。\n月夕花朝，不成虚过，芳年嫁君徒甚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行船","author":"欧阳修","text":"忆昔西都欢纵。\n自别后、有谁能共。\n伊川山水洛川花，细寻思、旧游如梦。\n今日相逢情愈重。\n愁闻唱、画楼钟动。\n白发天涯逢此景，倒金尊、殢谁相送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行船","author":"欧阳修","text":"满眼东风飞絮。\n催行色、短亭春暮。\n落花流水草连云，看看是、断肠南浦。\n檀板未终人去去。\n扁舟在、绿杨深处。\n手把金尊难为别，更那听、乱莺疏雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行船","author":"欧阳修","text":"闲把鸳衾横枕。\n损眉尖、泪痕红沁。\n花时良夜不归来，忍频听、漏移清禁。\n一饷无言都未寝。\n忆当初、是谁先恁。\n及至如今，教人成病，风流万般徒甚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其一","author":"欧阳修","text":"把酒花前欲问他。\n对花何吝醉颜酡。\n春到几人能烂赏。\n何况。\n无情风雨等闲多。\n艳树香丛都几许。\n朝暮。\n惜红愁粉奈情何。\n好是金船浮玉浪。\n相向。\n十分深送一声歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其二","author":"欧阳修","text":"把酒花前欲问伊。\n忍嫌金盏负春时。\n红艳不能旬日看。\n宜算。\n须知开谢只相随。\n蝶去蝶来犹解恋。\n难见。\n回头还是度年期。\n莫候饮阑花已尽。\n方信。\n无人堪与补残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其三","author":"欧阳修","text":"把酒花前欲问公。\n对花何事诉金钟。\n为问去年春甚处。\n虚度。\n莺声撩乱一场空。\n今岁春来须爱惜。\n难得。\n须知花面不长红。\n待得酒醒君不见。\n千片。\n不随流水即随风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其四","author":"欧阳修","text":"把酒花前欲问君。\n世间何计可留春。\n纵使青春留得住。\n虚语。\n无情花对有情人。\n任是好花须落去。\n自古。\n红颜能得几时新。\n暗想浮生何时好。\n唯有。\n清歌一曲倒金尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其六","author":"欧阳修","text":"对酒追欢莫负春。\n春光归去可饶人。\n昨日红芳今绿树。\n已暮。\n残花飞絮两纷纷。\n粉面丽姝歌窈窕。\n清妙。\n尊前信任醉醺醺。\n不是狂心贪燕乐。\n自觉。\n年来白发满头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定风波 其五","author":"欧阳修","text":"过尽韶华不可添。\n小楼红日下层檐。\n春睡觉来情绪恶。\n寂寞。\n杨花缭乱拂珠帘。\n早是闲愁依旧在。\n无奈。\n那堪更被宿酲兼。\n把酒送春惆怅甚。\n长恁。\n年年三月病厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武陵春","author":"欧阳修","text":"宝幄华灯相见夜，妆脸小桃红。\n斗帐香檀翡翠笼。\n携手恨匆匆。\n金泥双结同心带，留与记情浓。\n却望行云十二峰。\n肠断月斜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其五","author":"欧阳修","text":"何人解赏西湖好，佳景无时。\n飞盖相追，贪向花间醉玉卮。\n谁知闲凭阑干处，芳草斜晖。\n水远烟微，一点沧洲白鹭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二","author":"欧阳修","text":"春深雨过西湖好，百卉争妍。\n蝶乱蜂喧，晴日催花暖欲然。\n兰桡画舸悠悠去，疑是神仙。\n返照波间，水阔风高扬管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其一","author":"欧阳修","text":"轻舟短棹西湖好，绿水逶迤，芳草长堤。\n隐隐笙歌处处随。\n无风水面琉璃滑，不觉船移。\n微动涟漪，惊起沙禽掠岸飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其九","author":"欧阳修","text":"残霞夕照西湖好，花坞蘋汀。\n十顷波平，野岸无人舟自横。\n西南月上浮云散，轩槛凉生。\n莲芰香清，水面风来酒面醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其六","author":"欧阳修","text":"清明上巳西湖好，满目繁华。\n争道谁家。\n绿柳朱轮走钿车。\n游人日暮相将去，醒醉喧哗。\n路转堤斜。\n直到城头总是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其七","author":"欧阳修","text":"荷花开后西湖好，载酒来时。\n不用旌旗。\n前后红幢绿盖随。\n画船撑入花深处，香泛金卮。\n烟雨微微。\n一片笙歌醉里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其一","author":"欧阳修","text":"平生为爱西湖好，来拥朱轮。\n富贵浮云，俯仰流年二十春。\n归来恰似辽东鹤，城郭人民。\n触目皆新，谁识当年旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其三","author":"欧阳修","text":"画船载酒西湖好，急管繁弦。\n玉盏催传，稳泛平波任醉眠。\n行云却在行舟下，空水澄鲜。\n俯仰流连，疑是湖中别有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十三","author":"欧阳修","text":"十年前是尊前客，月白风清。\n忧患凋零，老去光阴速可惊。\n鬓华虽改心无改，试把金觥。\n旧曲重听，犹似当年醉里声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十一","author":"欧阳修","text":"画楼钟动君休唱，往事无踪。\n聚散匆匆。\n今日欢娱几客同。\n去年绿鬓今年白，不觉衰容。\n明月清风。\n把酒何人忆谢公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其四","author":"欧阳修","text":"群芳过后西湖好，狼藉残红，飞絮濛濛，垂柳阑干尽日风。\n笙歌散尽游人去，始觉春空。\n垂下帘栊，双燕归来细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其十二","author":"欧阳修","text":"十年一别流光速，白首相逢。\n莫话衰翁。\n但斗尊前语笑同。\n劝君满酌君须醉，尽日从容。\n画鹢牵风。\n即去朝天泛舜聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其八","author":"欧阳修","text":"天容水色西湖好，云物俱鲜。\n鸥鹭闲眠，应惯寻常听管弦。\n风清月白偏宜夜，一片琼田。\n谁羡骖鸾，人在舟中便是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中花令","author":"欧阳修","text":"千古都门行路。\n能使离歌声苦。\n送尽行人，花残春晚，又到君东去。\n醉藉落花吹暖絮。\n多少曲堤芳树。\n且携手留连，良辰美景，留作相思处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其二","author":"欧阳修","text":"记得金銮同唱第，春风上国繁华。\n如今薄宦老天涯，十年歧路，空负曲江花。\n闻说阆山通阆苑，楼高不见君家。\n孤城寒日等闲斜，离愁难尽，红树远连霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一","author":"欧阳修","text":"柳外轻雷池上雨，雨声滴碎荷声。\n小楼西角断虹明。\n阑干倚处，待得月华生。\n燕子飞来窥画栋，玉钩垂下帘旌。\n凉波不动簟纹平。\n水精双枕，畔有堕钗横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子","author":"欧阳修","text":"好个人人，深点唇儿淡抹腮。\n花下相逢、忙走怕人猜。\n遗下弓弓小绣鞋。\n刬袜重来。\n半亸乌云金凤钗。\n行笑行行连抱得，相挨。\n一向娇痴不下怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子","author":"欧阳修","text":"浅浅画双眉。\n取次梳妆也便宜。\n洒着胭脂红扑面，须知。\n更有何人得似伊。\n宝帐烛残时。\n好个温柔模样儿。\n月里仙郎清似玉，相期。\n些子精神更与谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其二","author":"欧阳修","text":"雨后斜阳。\n细细风来细细香。\n风定波平花映水，休藏。\n照出轻盈半面妆。\n路隔秋江。\n莲子深深隐翠房。\n意在莲心无问处，难忘。\n泪裛红腮不记行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其一","author":"欧阳修","text":"翠密红繁。\n水国凉生未是寒。\n雨打荷花珠不定，轻翻。\n冷泼鸳鸯锦翅斑。\n尽日凭阑。\n弄蕊拈花仔细看。\n偷得袅蹄新铸样，无端。\n藏在红房艳粉间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子","author":"欧阳修","text":"凤髻金泥带，龙纹玉掌梳。\n去来窗下笑相扶，爱道画眉深浅、入时无。\n弄笔偎人久，描花试手初。\n等闲妨了绣功夫，笑问鸳鸯两字、怎生书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令","author":"欧阳修","text":"渐素景。\n金风劲。\n早是凄凉孤冷。\n那堪闻、蛩吟穿金井。\n唤愁绪难整。\n懊恼人人薄倖。\n负云期雨信。\n终日望伊来，无凭准。\n闷损我、也不定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怨春郎","author":"欧阳修","text":"为伊家，终日闷。\n受尽恓惶谁问。\n不知不觉上心头，悄一霎身心，顿也没处顿。\n恼愁肠，成寸寸。\n已恁莫把人萦损。\n奈每每人前道著伊，空把相思泪眼和衣揾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恨春迟","author":"欧阳修","text":"欲借江梅荐饮。\n望陇驿、音息沈沈。\n住在柳州东，彼此相思，梦回云去难寻。\n归燕来时花期浸。\n淡月坠、将晓还阴。\n争奈多情易感，风信无凭，如何消遣初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼锦堂","author":"欧阳修","text":"昔憩甘棠长旧围，重来城郭叹人非。\n随车仍是为霖雨，被衮何如衣锦归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洛阳春","author":"欧阳修","text":"红纱未晓黄鹂语。\n蕙炉销兰炷。\n锦屏罗幕护春寒，昨夜三更雨。\n绣帘闲倚吹轻絮。\n敛眉山无绪。\n看花拭泪向归鸿，问来处、逢郎否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞天春","author":"欧阳修","text":"莺啼绿树声早。\n槛外残红未扫。\n露点真珠遍芳草。\n正帘帏清晓。\n秋千宅院悄悄。\n又是清明过了。\n燕蝶轻狂，柳丝撩乱，春心多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌令/洞仙歌","author":"欧阳修","text":"情知须病，奈自家先肯。\n天甚教伊恁端正。\n忆年时、兰棹独倚春风，相怜处、月影花光相映。\n别来凭谁诉，空寄香笺，拟问前欢甚时更。\n后约与新期，易失难寻，空肠断、损风流心性。\n除只把、芳尊强开颜，奈酒到愁肠，醉了还醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌令/洞仙歌","author":"欧阳修","text":"楼前乱草，是离人方寸。\n倚遍阑干意无尽。\n罗巾掩，宿粉残眉、香未减，人与天涯共远。\n香闺知人否，长是厌厌，拟写相思寄归信。\n未写了，泪成行、早满香笺。\n相思字、一时滴损。\n便直饶、伊家总无情，也拼了一生，为伊成病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看花回","author":"欧阳修","text":"晓色初透东窗，醉魂方觉。\n恋恋绣衾半拥，动万感脉脉，春思无托。\n追想少年，何处青楼贪欢乐。\n当媚景，恨月愁花，算伊全妄凤帏约。\n空泪滴、真珠暗落。\n又被谁、连宵留著。\n不晓高天甚意，既付与风流，却恁情薄。\n细把身心自解，只与猛拼却。\n又及至、见来了，怎生教人恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝影/添声杨柳枝","author":"欧阳修","text":"白雪梨花红粉桃。\n露华高。\n垂杨慢舞绿丝绦。\n草如袍。\n风过小池轻浪起，似江皋。\n千金莫惜买香醪。\n且陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凉州令/梁州令 东堂石榴","author":"欧阳修","text":"翠树芳条飐。\n的的裙腰初染。\n佳人携手弄芳菲，绿阴红影，共展双纹簟。\n插花照影窥鸾鉴。\n只恐芳容减。\n不堪零落春晚，青苔雨后深红点。\n一去门闲掩。\n重来却寻朱槛。\n离离秋实弄轻霜，娇红脉脉，似见胭脂脸。\n人非事往眉空敛。\n谁把佳期赚。\n芳心只愿长依旧，春风更放明年艳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴瑶池/越江吟","author":"欧阳修","text":"恋眼哝心终未改。\n向意间长在。\n都缘为、颜色殊常，见馀花、尽无心爱。\n都为是风流㬠。\n至他人、强来厮坏。\n从今后、若得相逢，绣帏里、痛惜娇态。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人","author":"欧阳修","text":"碧纱影弄东风晓。\n一夜海棠开了。\n枝上数声啼鸟。\n妆点愁多少。\n妒云恨雨腰支袅。\n眉黛不忺重扫。\n薄倖不来春老。\n羞带宜男草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人 其一 一名虞美人影","author":"欧阳修","text":"梅梢弄粉香犹嫩。\n欲寄江南春信。\n别后寸肠萦损。\n说与伊争稳。\n小炉独守寒灰烬。\n忍泪低头画尽。\n眉上万重新恨。\n竟日无人问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人 其二","author":"欧阳修","text":"莺愁燕苦春归去。\n寂寂花飘红雨。\n碧草绿杨歧路。\n况是长亭暮。\n少年行客情难诉。\n泣对东风无语。\n目断两三烟树。\n翠隔江淹浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其五","author":"欧阳修","text":"青杏园林煮酒香。\n佳人初著薄罗裳。\n柳丝摇曳燕飞忙。\n乍雨乍晴花自落，闲愁闲闷昼偏长。\n为谁消瘦损容光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其七","author":"欧阳修","text":"翠袖娇鬟舞石州。\n两行红粉一时羞。\n新声难逐管弦愁。\n白发主人年未老，清时贤相望偏优。\n一尊风月为公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其八","author":"欧阳修","text":"灯烬垂花月似霜。\n薄帘映月两交光。\n酒醺红粉自生香。\n双手舞馀拖翠袖，一声歌已釂金觞。\n休回娇眼断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":30559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]