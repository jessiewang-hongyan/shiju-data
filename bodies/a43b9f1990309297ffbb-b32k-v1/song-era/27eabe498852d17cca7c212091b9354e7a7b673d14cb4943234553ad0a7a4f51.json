[{"title":"壬辰寒食众春园","author":"韩琦","text":"寒食郊园此会稀，吏民随意赏芳菲。\n樽前有乐人还去，墙外无花蝶乱飞。\n众里鞦韆应是騃，岸边鸥鸟却忘机。\n黄昏易觉春醪散，细雨迎风洒西归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"释奠庙中作","author":"韩琦","text":"舍奠修彝礼，斋诚致吉蠲。\n普天同日祀，圣道几人传。\n穷厄当时教，雅崇万世贤。\n蒙然如可寤，朝夕在拳拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬辰重九即席","author":"韩琦","text":"中山风物有前缘，经赏重阳第五年。\n莫为素毛悲晚岁，且吹黄菊酌芳筵。\n退求僻郡疑邀宠，甘老穷边似好权。\n笑问此身何计是，不如嘉节倒垂莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答留台春卿集贤侍郎见寄","author":"韩琦","text":"十稔违谈燕，区区混浊流。\n经时无一信，度夕是三秋。\n友会此难约，君恩尚未酬。\n何人伴高兴，洛棹与嵩楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬辰岁除喜雪","author":"韩琦","text":"祈雪经冬未应人，岁除方喜六花匀。\n解苏民望终为腊，要入时宜不在春。\n欲使休祥同节贺，更教生物及年新。\n明朝元会排天仗，万玉相辉拜紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宾雁","author":"韩琦","text":"候时宾雁觉秋分，便委胡霜溯楚氛。\n一片画屏横远岫，几行书字帖轻云。\n信通离阔诚虚语，声到英雄似不闻。\n莫趁衡阳恋闲暖，南儿矰缴正纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答致政杜公以加节见寄","author":"韩琦","text":"西北连忧寄责深，十年回首失光阴。\n丹心报国期输尽，白日当天荷照临。\n赐钺何劳诚腼面，捍边虽久即甘心。\n孤根只有衰危甚，不得终身被傅霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答留台春卿侍郎以加节见寄二首 其一","author":"韩琦","text":"一落粗官伍哙曹，清流甘分绝英髦。\n建牙恩有丘山重，捍塞功无尺寸高。\n许国壮心轻蹈死，殄戎豪气入横刀。\n只期名遂扁舟去，掉臂江湖掷锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答留台春卿侍郎以加节见寄二首 其二","author":"韩琦","text":"洛下安然塞下劳，公持霜简我持旄。\n忧无虚日三垂重，闲入芳春万事高。\n病虎厌风摧汉节，卧龙悭雨涩吴刀。\n遥知啸傲烟霞外，肯把仙袍换战袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明获鹿道中","author":"韩琦","text":"尺雪征涂已倦行，那堪寂寞过清明。\n农居近古鞦韆野，县堞成虚睥睨平。\n只见靓妆矜节服，更无闲地匝春耕。\n山川寓目皆形胜，可惜虚屯百万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过井陉淮侯庙","author":"韩琦","text":"破赵降燕汉业成，兔亡良犬日图烹。\n家僮上变安知实，史笔加诬贵有名。\n功盖一时诚不灭，恨埋千古欲谁明。\n荒祠尚枕陉间道，涧水空传哽咽声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离天威驿","author":"韩琦","text":"早发天威驿，深春尚薄寒。\n龙蛇盘道路，波浪卷峰峦。\n古人萌常晚，新流势未端。\n忠臣方叱驭，更险不辞难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过故关","author":"韩琦","text":"春入并州路，群芳夹故关。\n前驺驱弩过，别境荷戈还。\n古戍馀荒堞，新耕入乱山。\n时平民自适，白首乐农闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百井路山桃盛开","author":"韩琦","text":"漫岭夭桃树，无人亦自开。\n云霞深隐洞，锦绣远成堆。\n生意惊樵斧，芳情谢宴杯。\n莫迷行客路，不似武陵回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黑砂岭路","author":"韩琦","text":"诘曲榆关道，终朝险复平。\n后旌缘磴下，前骑半天行。\n举目自山水，劳生徒利名。\n报君殊未效，何暇及归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过侧石驿","author":"韩琦","text":"二月春光薄，川寒驿路长。\n虎蹲难动石，龙矫已刳桑。\n岭狭居多险，耕勤地少荒。\n山农骇车骑，儿女满庄墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山口","author":"韩琦","text":"待晓出山口，溟濛雨乍晴。\n始知经尽险，终得坦然平。\n草树开春意，川原豁眼明。\n吏民当自信，竹马不须迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送门人曾宏秘校登第南归","author":"韩琦","text":"十载辞乡志，登科一旦伸。\n青纶归养客，白发倚门人。\n家酿难禁蟹，江鲈正得莼。\n之官如自立，吾馆有贤宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕景初殿院被召归阙","author":"韩琦","text":"迩臣清举世推公，驿召归驰御史骢。\n不独危言开正道，更将高节激颓风。\n严霜透骨寒威重，健鹘盘空杀气雄。\n朝选虽精知尚薄，济时才业满胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初伏柳溪","author":"韩琦","text":"万柳笼溪借碧涟，涤烦高会喜僚贤。\n人间酷暑病庚伏，世外清风有洞天。\n一枕易醒西峤雨，满筵思醉北池莲。\n棠阴讼阒边烽静，谁信榆关作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九以疾不能主席因成小诗劝北园诸官饮","author":"韩琦","text":"病襟深惜好重阳，莫接郊园醉晚芳。\n豪饮直输无比户，清欢全落少年场。\n感时萧索休成咏，中酒无流不是伤。\n猛战巨觥吹嫩菊，且陶佳节趁康强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"并塞晚秋","author":"韩琦","text":"莫赋悲哉学楚骚，寒庭秋色一时高。\n霜严猎卫鹰权峻，风入弓胶士气豪。\n对月清吟森玳瑁，吹花芳酌醉葡萄。\n汾波照骨银河淡，晓夕寒光助帐刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过太原旧城","author":"韩琦","text":"车书从此九区同，雉堞隳云百载空。\n欲把金汤角天命，却惊禾黍满秋风。\n虽馀墟落人烟悄，不改山河气象雄。\n何必坏城心可坏，祖宗恩德浸无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晋祠","author":"韩琦","text":"唐叔祠推晋域雄，乘春来谒想遗风。\n前庭树古圭曾剪，近垄禾新颖未同。\n山峻尚存维翰德，泉深长泻及人功。\n愚民不识邦君重，岁岁西神酒食丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狮子柳","author":"韩琦","text":"柳出狻猊首，天然瘿赘高。\n枫瘤嗤鬼伏，松干让龙豪。\n根耸伸狞爪，丝轻被毳毛。\n三眠汉宫树，人状可同褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长生蘋","author":"韩琦","text":"奇种定仙草，长生晋水蘋。\n采芳曾著咏，荐洁可供神。\n万卉衰何速，三冬色自新。\n大年如欲较，吾岂愧庄椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过甘泉寺","author":"韩琦","text":"甘泉穿石磴，山腹启禅扉。\n自笑逃尘境，翻来触静机。\n花开松色淡，歌咽磬声微。\n十里蔷薇路，香风送马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲午冬阅","author":"韩琦","text":"练士当时阅，临高共一观。\n势凭朝气锐，令入晓霜寒。\n事重三军国，形存八阵滩。\n烧烘旗帜动，雷吼鼓鼙乾。\n画守谁能犯，循环莫见端。\n赴溪驱稚子，飘石走惊湍。\n弹压提封静，周旋四野宽。\n机深天地秘，知少古今难。\n寨巧花齐出，营新月未圆。\n全师充国慎，坚卧亚夫安。\n鹅鹳行虽卷，貔貅伎要殚。\n撒缰驰铁骑，叠箭取银盘。\n避槊身藏镫，扬尘足挂鞍。\n弩飞三刃剑，炮掷百星丸。\n铙管喧归队，肴觞足犒餐。\n父兄人自卫，凫藻众胥欢。\n有志铭燕石，无劳误汉坛。\n壮心徒内激，神武正胜残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺宫师杜公增秩","author":"韩琦","text":"汉唐二傅推疏白，高退当时叹莫如。\n虽有清风传旧史，不闻优宠及安车。\n直缘贤迹光君辅，更约师模在帝储。\n何似诏公还庙席，万灵和乐浃堪舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺观文富公迁职","author":"韩琦","text":"秘殿班崇极迩联，九重思旧及高贤。\n虽知荣宠公非乐，且喜孤忠帝尚怜。\n惠物裤襦联一境，得时霖雨即敷天。\n万方翘首皋夔入，待见唐虞致治年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺春卿加大资政职","author":"韩琦","text":"别殿深严峻宠班，再烦开府扼秦关。\n棠郊阴满修前治，蕙帐香销在故山。\n天意未容贤者乐，官方唯许老时闲。\n苍生况结为霖望，岂要穷边俗吏攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔戏呈机宜著作与诸同席","author":"韩琦","text":"不草边书绝塞氛，英僚高会喜同群。\n朋间射鹄虽连中，坐上飞觥不五分。\n烈士感时何晚岁，男儿行乐是从军。\n速挥大白申严令，多得红心即战勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳柳溪席上次韵答机宜张吉甫判官劝饮","author":"韩琦","text":"天意如何未应人，蛟龙犹得戢乖鳞。\n民间望极经时雨，塞上寒深几日春。\n麦脚埋尘难自展，柳眉低水只乾匀。\n西溪不在浮觞乐，且慰群心祓禊辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳溪嘲莲","author":"韩琦","text":"清香奇色匝芳洲，只得公馀一见休。\n道是好花堪谑问，几时曾上美人头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答永兴安抚文公","author":"韩琦","text":"建牙非称冢司官，正是宸襟注意安。\n即日太平归辅翼，侍祠重陟岱宗坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和都运崔谏议寄示立春前一日宿岚谷山程","author":"韩琦","text":"绝塞风霜正树威，不知韶律起从微。\n十千酒且迎春酌，五九寒须半腊归。\n破屐好山连日上，费诗娇雪著人飞。\n属封所过皆蒙惠，民吏应如挟纩衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄大资政春卿侍郎","author":"韩琦","text":"霄躔将欲正三台，促召深思辅翼才。\n只听燮调光玉铉，若为封駮滞银台。\n殿帷延纳君恩厚，经席敷陈圣虑开。\n命相几时符众望，递中看录白麻来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月六日雨后过岳庙游从封寺观稼席上","author":"韩琦","text":"暑雨频经信宿休，近郊方出释潜忧。\n虽妨麦始二停穫，且见苗知一半收。\n神岳怖民藏电雹，老松凭寺偃蛟虬。\n佳游况遇从丰谶，好饰千仓待有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自和","author":"韩琦","text":"鄣泥何惜出郊游，始霁才宽望岁忧。\n郁若山光疑是活，飘然诗思尽难收。\n隈林杏颊红初抹，拂砌莎髯绿自虬。\n禾黍坐看云四合，有年将乞载春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待制崔峄给事移守圃田","author":"韩琦","text":"使台凝绩大河东，荣圃更临辅镇雄。\n鸾省要资虽锡命，牺图清职未推公。\n满天秋色增诗骨，一路欢谣入岁丰。\n会取朝家精选意，陪京今是汉扶风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊觞","author":"韩琦","text":"九日陪嘉客，金英泛酒船。\n拨醅时上下，浮蚁自周旋。\n香逐榴花发，甘嗤柏叶先。\n坐中宜醉挹，仙录载延年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园秋雨","author":"韩琦","text":"轻雨来秋晚，郊园对客樽。\n暂和春气味，将冷雪胚浑。\n声入关榆苦，阴缠塞岭昏。\n黄花应自笑，摇落独承恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中喜雪","author":"韩琦","text":"天地久闭塞，气和方一开。\n花从无象出，泽蕴太虚来。\n庆可万区浃，丰宜百瑞魁。\n病襟虽粗释，欢意阻宾罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"属疾","author":"韩琦","text":"一纪三垂虑，中疲病早侵。\n人生何苦甚，世事愈思深。\n冬漏长难过，霜风峭不禁。\n几时抛组绶，芝朮老云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答运使杨畋舍人","author":"韩琦","text":"轺车勤按问，并部此先行。\n籴重伤农业，年丰报力耕。\n几时苏俗困，异日复民兵。\n公策方经远，提封可坐清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至和乙未元日立春","author":"韩琦","text":"元日难逢是立春，普天谁不喜佳辰。\n一年气候均诸节，万卉芳菲实九旬。\n柏叶始倾为寿酒，土牛随示力耕人。\n故阴尽革无馀腊，端朔阳来庆共新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕","author":"韩琦","text":"万家灯火彻重闉，通夕熙然本顺民。\n谁道升平无可状，请观丰稔及兹辰。\n月随游骑何曾动，莲嫁春风不是真。\n半病使君心未伏，欲驱歌吹逐香尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒","author":"韩琦","text":"春寒著人骨，病躯殊未堪。\n雁慵难溯北，花怯不开南。\n诗笔少新兴，战觥思旧酣。\n边垂何事乐，寂寞月将三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后园春日","author":"韩琦","text":"并塞园林古，春来似不知。\n雨轻成冻易，树老发花迟。\n剧事随年倦，欢悰入病衰。\n芳时期强赏，宴鼓揭天搥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙未寒食西溪","author":"韩琦","text":"三月鞦韆节，西郊菡萏洲。\n塞寒春尚浅，俗乐政同优。\n赏惬杯忘算，歌妍饵失钩。\n黄昏垂柳岸，人意共迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳西溪同日清明","author":"韩琦","text":"拍堤春水展轻纱，元巳清明景共嘉。\n人乐一时看开禊，饮随节日发桐花。\n红芳雨过妆新拂，绿柳含风带尽斜。\n欲继永和书盛事，愧无神笔走龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水嬉","author":"韩琦","text":"巧匠矜能作水嬉，偶形千状拟真为。\n机关自谓无知者，手足其如有见时。\n钧叟投竿鱼自出，舞姬挥□□□□。\n□□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"韩琦","text":"晋阳封守远睢阳，空有驰魂若侍傍。\n处世少容虽凿枘，与公相协自宫商。\n冥鸿愈适知难慕，疲驾将颠失预量。\n新句暗投频骇目，少陵光焰极辉煌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢宫师杜公寄示诗编","author":"韩琦","text":"百讽新篇百忘劳，直将渊旨质风骚。\n闲观景物辞终巧，意到安恬格自高。\n三代正声传雅乐，千年嘉味入蟠桃。\n谁知八十归休相，字体诗情日日豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵谢宫师杜公惠诗庆富公为代","author":"韩琦","text":"彦国贤推不世奇，两谐交政辱公诗。\n如袖事契诚多幸，欲并才名敢固辞。\n疏傅退来光汉史，周公归已静淮夷。\n须知病守荣非浅，日对乡枌拥郡麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寺底遇大雨寄呈二运使","author":"韩琦","text":"怒雷倾雨洒无垠，天意须臾复至仁。\n比屋士民平叹息，一川和黍长精神。\n彻犁农喜通新种，隔辙人谁谓不均。\n大利岂当论小害，路泥深尺没征轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"韩琦","text":"冒暑行宜早，修途不困人。\n远风清逐睡，微露湿低尘。\n好月看无尽，高吟意益新。\n未鸡知渐晓，天角下星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"褫高道中农居","author":"韩琦","text":"山脚林成簇舍窠，门前流水养嘉禾。\n森森松柏围先陇，濈濈牛羊满近坡。\n官赋已供馀岁备，村歌无节得天和。\n安全尽责廉平吏，三岁齐民更孰过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"韩琦","text":"山路何曾倦，官程幸不赊。\n片云无定雨，香草逐时花。\n暑序秋天气，农居古室家。\n乡关勤一望，峰翠列高牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过微子领","author":"韩琦","text":"崎岖微子道，行路始知难。\n峻岭万千叠，纡途百十盘。\n地硗民力薄，天旱谷苗乾。\n未寤苍苍意，平川雨泽宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过吴儿谷","author":"韩琦","text":"晓入吴儿谷，危涂信不虚。\n千峰疑绝路，一径俯容车。\n山鸟过云语，田夫半岭锄。\n时平尽周道，天险欲何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过涉县熊耳山","author":"韩琦","text":"我从团柏历山岐，秀绝唯于熊耳知。\n芳草经年被重席，轻云无日展时旗。\n羊头有黍名终俗，壶口称关类亦卑。\n何似半天留鹤驭，此来凭轼与仙期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至昭德","author":"韩琦","text":"出却千山与万山，坦途由引达乡关。\n边垂未减宵衣念，闾里徒矜昼锦还。\n忧国敢忘经日虑，治身能得几时闲。\n遥知上冢光荣处，只在州城一舍间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拜坟","author":"韩琦","text":"欲知为郡宠，昼锦入家村。\n自古拜松槚，几人如子孙。\n麾幢新俗观，牛酒饫乡尊。\n儒者荣斯甚，将何报国恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"韩琦","text":"垂稔良田雨信愆，三农忧死只呼天。\n应时滂洽真无价，数日淹迟误有年。\n立解焦枯非甚力，不知神化此谁权。\n何妨四序均膏泽，长使生灵得自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观稼二首 其一","author":"韩琦","text":"尺雨滂然涤旱灾，行田因得过家来。\n催成禾黍拖泥秀，长就枌榆揭冻栽。\n三组不矜聊问俗，一廛虽陋且容杯。\n郊原跃马都忘病，随目山川气象开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]