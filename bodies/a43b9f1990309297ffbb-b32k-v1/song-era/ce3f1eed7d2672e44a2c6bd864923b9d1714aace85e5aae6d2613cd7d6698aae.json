[{"title":"法驾导引 其一","author":"陈与义","text":"朝元路，朝元路，同驾玉华君。\n千乘载花红一色，人间遥指是祥云。\n回望海光新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"陈与义","text":"高咏楚词酬午日，天涯节序匆匆。\n榴花不似舞裙红。\n无人知此意，歌罢满帘风。\n万事一身伤老矣，戎葵凝笑墙东。\n酒杯深浅去年同。\n试浇桥下水，今夕到湘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 夜登小阁，忆洛中旧游","author":"陈与义","text":"忆昔午桥桥上饮，坐中多是豪英，长沟流月去无声，杏花疏影里，吹笛到天明。\n二十余年如一梦，此身虽在堪惊！\n闲登小阁看新晴，古今多少事，渔唱起三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 塔院僧阁","author":"陈与义","text":"矫矫千年鹤，茫茫万里风。\n阑干三面看秋空。\n背插浮屠千尺、冷烟中。\n林坞村村暗，溪流处处通。\n此间何似玉霄峰。\n遥望蓬莱依约、晚云东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 紫阳寒食","author":"陈与义","text":"寒食今年，紫阳山下蛮江左。\n竹篱烟锁。\n何处求新火。\n不解乡音，只怕人嫌我。\n愁无那。\n短歌谁和。\n风动梨花朵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"陈与义","text":"送了栖鸦复暮钟。\n栏干生影曲屏东。\n卧看孤鹤驾天风。\n起舞一尊明月下，秋空如水酒如空。\n谪仙已去与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 木犀","author":"陈与义","text":"黄衫相倚。\n翠葆层层底。\n八月江南风日美。\n弄影山腰水尾。\n楚人未识孤妍。\n离骚遗恨千年。\n无住庵中新事，一枝唤起幽禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 福建道中","author":"陈与义","text":"今日山头云欲举。\n青蛟素凤移时舞。\n行到石桥闻细雨。\n听还住。\n风吹却过溪西去。\n我欲寻诗宽久旅。\n桃花落尽春无所。\n渺渺篮舆穿翠楚。\n悠然处。\n高林忽送黄鹂语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 荷花","author":"陈与义","text":"南轩面对芙蓉浦。\n宜风宜月还宜雨。\n红少绿多时。\n帘前光景奇。\n绳床乌木几。\n尽日繁香里。\n睡起一篇新。\n与花为主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人","author":"陈与义","text":"扁舟三日秋塘路。\n平度荷花去。\n病夫因病得来游。\n更值满川微雨、洗新秋。\n去年长恨拿舟晚。\n空见残荷满。\n今年何以报君恩。\n一路繁花相送、过青墩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 邢子友会上","author":"陈与义","text":"超然堂上闲宾主。\n不受人间暑。\n冰盘围坐此州无。\n却有一瓶和露、玉芙蕖。\n亭亭风骨凉生牖。\n消尽尊中酒。\n酒阑明月转城西。\n照见纱巾藜杖、带香归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 亭下桃花盛开，作长短句咏之","author":"陈与义","text":"十年花底承朝露。\n看到江南树。\n洛阳城里又东风。\n未必桃花得似、旧时红。\n胭脂睡起春才好。\n应恨人空老。\n心情虽在只吟诗。\n白发刘郎孤负、可怜枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 大光祖席，醉中赋长短句","author":"陈与义","text":"张帆欲去仍搔首，更醉君家酒。\n吟诗日日待春风，及至桃花开后却匆匆。\n歌声频为行人咽，记著尊前雪。\n明朝酒醒大江流，满载一船离恨向衡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈与义","text":"老对白桂花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈与行","text":"椒兰平酒酌，簠簋散香箕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"陈义","text":"平生只被今朝误。\n今朝却把平生补。\n重午一年期。\n斋僧只待时。\n主人恩义重。\n两载蒙恩宠。\n清净得为僧。\n幽闲度此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"陈义","text":"天生体态腰肢细。\n新词唱彻歌声利。\n出口便清奇。\n扬尘簌簌飞。\n主人恩义重。\n宴出红妆宠。\n便要赏新荷。\n时光也不多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"陈义","text":"包中香黍分边角。\n彩丝剪就交绒索。\n樽俎泛菖蒲。\n年年五月初。\n主人恩义重。\n对景承欢宠。\n何日玩山家。\n葵蒿三四花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"陈义","text":"去年共饮菖蒲酒。\n今年却向僧房守。\n好事更多磨。\n教人没奈何。\n主人恩义重。\n知我心头痛。\n待要赏新荷。\n争知疾愈么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石千里来自昆山陈阔未几倏尔言别辄成诗少舒恋恋 其二","author":"陈之茂","text":"乌鹊巢空坛，鸾凤伏荆杞。\n怀抱发永叹，感深念君子。\n斯人在空谷，弗御纨与绮。\n松柏培不荣，芝兰种不起。\n浩浩岁月移，日暮雪霜底。\n物理固非常，循环有终始。\n但保千金躯，清尊倾绿蚁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石千里来自昆山陈阔未几倏尔言别辄成诗少舒恋恋 其一","author":"陈之茂","text":"零露滋百草，灼灼黄花披。\n眷此忘忧物，一杯谁共持。\n人生岂无好，所乐在所知。\n开门望三益，邂逅得所思。\n鸣弦咏绸缪，岁暮以为期。\n倏驾不可留，良会复何时。\n不愁道路隔，但恐人事违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"陈之贤","text":"炎精昌运，庆天为笃生，中兴人杰。\n横臆甲兵三百万，要扫群胡妖孽。\n抚弱怜贫，排奸击暴，所至人推服。\n飘飘志气，伟哉一代英特。\n预信衮衮公侯，名闻英胄，素有阴功积。\n腾踏从天上去，笑作龙头奇客。\n相印重封，将符再绾，尽履青毡物。\n寿杯满泛，年年长醉正月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红","author":"陈之贤","text":"人物英雄，更独抱、无双才气。\n年正壮，文章武略，尽曾留意。\n破胆欲凭胸内甲，清原宴启舟中誓。\n笑区区、燕雀不能知，青云志。\n封侯貌，神人比。\n社下手，须荣试。\n况相门出相，君家常事。\n斗印垂金他日贵，寿杯浮玉今朝醉。\n看年年、南极倍明时，春明媚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈士泰","text":"阆州苍翠与云齐，阆水连城碧渺瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广荫亭诗","author":"陈士徽","text":"唐翁静者闭门饮水啜粥无知音，我能发尔一片冰清心。\n巨风吹天振海浪如屋，此翁林中眠正熟。\n中天渴乌吐火六合新开窑，此翁两鬓秋飕飕。\n小儿烂羊瓜果尽青紫，此翁临水洗双耳。\n蜩蟾蛙蚓聒乱昕夕雷无声，此翁宴坐观黄庭。\n编茅斲室大如斗，苍雪丝丝翳窗牖。\n忍饥学得西山夫，胸中有道癯不枯。\n木榔始花赤已实，百亩沉沉如栉密。\n露结风高霜气寒，润如美竹馨如兰。\n翁居巷南我巷北，况有薇郎能主客。\n书篚几杖皆清风，相看荫我冰雪容。\n琼州岁月不可度，此境中州亦稀遇。\n苦茗满碗谈兴亡，日长归来月满堂。\n明朝一舸崖州去，世事茫茫隔烟雾。\n袖携毫楮觅扁题，鸿飞冥冥留爪泥。\n为书广荫扁翁室，淡墨攲轻醉中笔。\n乘醉更作广荫诗，千载留与知音知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万寿观","author":"陈大方","text":"石林和月俯清流，一点红尘不许留。\n青鸟岂传金母信，彩鸾应返玉皇楼。\n苔铺翠点仙桥滑，松积香梢径路幽。\n午夜鹤翻松顶露，道人睡觉满天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐隐士袁宣墓","author":"陈大方","text":"茅山东北燕山前，翁仲遗墟几百年。\n时有吴人来问隐，不知唐树已啼鹃。\n山童解指看碑路，野衲分耕祭墓田。\n厚夜肯教黄壤晓，悲风偏动夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝笔","author":"陈大雅","text":"胡柳陂中过，令人念战功。\n兵交千骑没，血染一川红。\n朱氏皆豚犬，唐家尽虎龙。\n壮图成慷慨，掷剑向西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"陈大震","text":"有湖光处有山多，独此平坡玉一窝。\n天下比来几西子，水中曾见百东坡。\n不随巨浸熏为瘴，肯为飞廉鼓作波。\n莫作无根潢潦看，两支流出万囷禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈大震","text":"海滨推老大，粹行比珩璜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"陈子予","text":"柳岸风条顿老，橘林露叶犹香。\n门对一天秋色，人行十里斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"军中寄内","author":"陈子全","text":"一望潇湘遍露迷，胡笳吹月夜凄凄。\n回天无力心难死，矢日同仇志应齐。\n但使首阳存汉地，不教阴塞牧羌羝。\n声名一堕谁能赎，珍重雌雄剑化蜺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题武夷","author":"陈子浩","text":"武夷山水称奇绝，历历仙源路可通。\n人古道尊精舍在，曾玄世隔幔亭空。\n万年宫接青冥上，九曲溪流碧嶂中。\n几欲相期游汗漫，披图陡觉驭天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"井田封建图","author":"陈子常","text":"为成者十复为终，终十还为百里同。\n祇为诸儒泥方法，不知起数总皆纵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒麻衣祠","author":"陈山泉","text":"雨晴泥路滑，杖履岂徒劳。\n双桧塔前老，一峰天外高。\n锡泉通殿砌，岩瀑起波涛。\n欲问麻衣意，风林作怒号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壶公山","author":"陈中","text":"深涧无人草自斑，独随流水入深山。\n隔林岚气青烟润，满地松阴白昼闲。\n野鸟听经当户入，洞龙带雨自天还。\n登高试望莆城景，一骑斜阳晚度关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗丛岩","author":"陈中","text":"矗矗山光映，团团树影重。\n断猿啼午夜，孤鹤唳秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"茶岭","author":"陈中孚","text":"天柱峰头拨晓云，灵芽一寸得先春。\n紫芹绿笋方知贵，雷发鎗旗未足珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题亚愚江浙纪行集句诗","author":"陈书?","text":"未于诗上著工夫，争把疏愚敌亚愚。\n只盍金沙分半席，归舟能用几钱租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"陈云龙","text":"野趣成閒散，青山即故知。\n竹生踰砌笋，花引隔墙枝。\n舞蝶翻风乱，閒云出坞迟。\n倚栏无一事，俄有客传诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春","author":"陈云厓","text":"琼奴家与章台并。\n路远可怜归梦近。\n波头浪语脸红潮，镜面频思眉翠晕。\n年年花月年年病。\n花月无情人有恨。\n欲将此恨寄湘流，又恐湘流流不尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"陈云厓","text":"春昼永。\n接叶鸣禽相应。\n风定落红香一径。\n疏疏窗竹影。\n寂寞年时酒病。\n远笛悠悠吹醒。\n闲上层楼天又暝。\n云山青不尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"陈仁玉","text":"天柱峰头叠紫烟，遥看万玉耸相连。\n云深九锁疑无路，翠豁一区俄有天。\n爽气袭人森石树，嗔雷飞雨响山泉。\n倏然不类人间世，今日自惊平地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙都山独峰大雪歌","author":"陈仁玉","text":"仙居仙人游仙都，帝遣滕六为先驱。\n天花撩乱缤纷舞，秉圭植璧仙灵趋。\n削瓜青玉一万仞，拔地挺挺撑元虚。\n人言黄帝此轻举，上有莲花开碧湖。\n我疑此是广成子，守道特立万万古。\n我来有问辄不应，窈窈冥冥谁与语。\n丹邱赤城我所栖，任意逍遥了无伍。\n老君牧龙种芝田，草莽向人萦网罟。\n人间逼窄知奈何，桑田沧海无回波。\n吞腥啄腐竞晷刻，角牙触齧伤天和。\n从旁掀髯每大笑，仙都峰头更观妙。\n甚欲点铁成黄金，却恐黄金误后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚歌","author":"陈仁玉","text":"仙之来兮驾五龙，霓旌绛节泠然风。\n谁欤擘脯金盘供，垂要绿发颜如童。\n五百馀载一瞬中，蓬莱水浅来何从。\n蔡翁得鞭与道通，云间遗臼堕半空。\n九井丹液藏甘潼，赤明浩劫传无穷。\n坐阅成坏此故宫，宫前山色知仙踪。\n月明笙鹤归长松，修身洁行傥可逢。\n屑然为我达帝聪，流杯□□袪盲聋。\n卿云甘露常岁丰，神仙岂必私此躬，八荒寿域仙之功。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南峰寺蓝光轩怀吴直翁","author":"陈仁玉","text":"怀佳人兮山扃，蹑烟霏兮步轻。\n蹇独立兮山上，空山无人兮寒松自声。\n怀佳人兮何许，白云封关兮猿鹤看户。\n羌有怀兮曷愬，风虚徐兮檐铎语。\n迟佳人兮未来，聊逍遥兮容与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苏端明书乳泉赋后","author":"陈仁玉","text":"坡翁谪海上，人传已仙去。\n道逢章子厚，遄复返尘路。\n至言想世惊，犹閟乳泉赋。\n遥怜嵩山丘，千古不可驻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过浯溪","author":"陈从古","text":"小憩?亭上，悠然倚一枝。\n云埋漫郎宅，水落鲁公碑。\n兴废悲前古，登临记昔时。\n重来头已白，忍看旧题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴辛巳秋过浯溪诵简斋诗因用其韵","author":"陈从古","text":"浯溪一股寒流碧，耸起双峰如削壁。\n两公文墨照溪津，到今草木增颜色。\n想当忠愤欲吐时，尽把江山供笔力。\n我来吊古不胜情，岂但登临爱泉石。\n渔阳旧事忍再论，仅赖令公安反侧。\n书生百感夜不眠，起读新诗转悽恻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花","author":"陈从古","text":"日借轻黄珠缀露。\n困倚东风，无限娇春处。\n看尽夭红浑谩语。\n淡妆偏称泥金缕。\n不共铅华争胜负。\n殿后开时，故欲寻春去。\n去似朝霞无定所。\n那堪更著催花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"陈从古","text":"礼部又开南省榜，卖花羞听叫文官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈从古","text":"多情今夜月，送我到衡州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈从古","text":"半夜打篷风雨恶，平明已失系船痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小孤山","author":"陈从易","text":"山称孤独字，庙塑女郎形。\n过客虽知误，行人但乞灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题北海","author":"陈从易","text":"闻道荆王废池馆，化为徐湛好亭台。\n江山形胜周遭见，花木芬芳次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题华林书院","author":"陈从易","text":"世居江表卧烟霞，致政官资美莫加。\n圣代旌门崇孝义，御书堆阁绝生涯。\n衣冠济济皆稽古，儿侄熙熙尽克家。\n我忝转输巡按暇，因留诗句记荣华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金丹","author":"陈以庄","text":"凤箫一去几经年，古木青萝锁洞天。\n黠鬼不量曾窃药，真人岂碍作飞仙。\n细看丹灶凝烟地，知有清朝应世贤。\n欲下苍崖却回首，何时著我弄云泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春兴","author":"陈以庄","text":"轻衫短帽久尘埃，零落香篝愧麝煤。\n春半工夫花绣了，社边消息燕衔来。\n岂无绿野供千骑，幸有黄封可一杯。\n明日清明能出否，凭谁先为扫莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 记钱塘之恨","author":"陈以庄","text":"晚来江阔潮平，越船吴榜催人去。\n稽山滴翠，胥涛溅恨，一襟离绪。\n访柳章台，问桃仙浦，物华如故。\n向秋娘渡口，泰娘桥畔，依稀是、相逢处。\n窈窕青门紫曲，茜罗新、衣翻金缕，旧音恍记，轻拢慢捻，哀弦危柱。\n金屋难成，阿娇已远，不堪春暮。\n听一声杜宇，红殷绿老，雨花风絮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 和刘潜夫韵","author":"陈以庄","text":"晓梦莺呼起。\n便安排、诗家厨传，酒家行李。\n点检花边新雨露，春在万家生齿。\n道官似、锦溪清驶。\n但便有人耕绿野，正不妨、鼓吹频来此。\n方觅句，且夷俟。\n画桥西畔多春意。\n记年年、曾来几度，落花流水。\n行到水穷云起处，依约辋川竹里。\n兴未属、王孙公子。\n料想明年端门里，有传柑宴罢黄封醉。\n肯回首，万杉底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 寿种春翁","author":"陈以庄","text":"亭兰风蕙，昨日山阴曲。\n又过五峰来，听华堂、管弦丝竹。\n今年风物，著意庆生朝，□鹤舞，黑猿吟，花下眠青鹿。\n九龄五福，盛事人皆祝。\n谁识种春翁，等浮云、飞蚊过目。\n上方渴士，忠节起闻孙，金坡近，玉堂深，莫羡春田绿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓鱼台","author":"陈允升","text":"罗浮山崒嵂，安有钓鱼台。\n台居观东隅，此名从何来。\n昔时爨下童，辛勤水与柴。\n岁久功行完，豹变山阴霾。\n一朝采幽涧，恍然江海涯。\n篙师舣舟在，相与语诙谐。\n爨童有行计，篙师相与偕。\n得鱼馈主翁，辞去挽不回。\n傍者蹑其踪，扁舟往岩崖。\n始信武陵源，有路通尘埃。\n回视所遗鱼，化作沟中材。\n古有恒真人，事岂欺我哉。\n太公渭水滨，白头佐□□。\n子陵七里滩，清风永可怀。\n爨人去几秋，鱼台尚崔嵬。\n此名照青史，此石封苍苔。\n我来笔其事，灵踪救沈埋。\n山中胜事多，对此空徘徊。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":14493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]