[{"title":"乌夜啼 题月海星天观，即宋武所居故地","author":"郑熏初","text":"春江一望微茫。\n辨桅樯。\n无限青青麦里、菜花黄。\n今古恨，登临泪，几斜阳。\n不是寄奴住处、也凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"氐州第一","author":"郑熏初","text":"开遍来禽，春事过也，江南倦客心苦。\n料理花愁，销磨酒病，还是年时意绪。\n寒浅香轻，早一霎、朝来微雨。\n柳曲闻莺，河桥信马，旋题新句。\n漫道而今无贺铸。\n尽肠断、满帘飞絮。\n说似风流，除非小杜，妙绝夸能赋。\n黯相逢，俱有恨，空流落、江山好处。\n猛拍阑干，诉天知、声声杜宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过周静轩别墅","author":"郑蔼","text":"残雪犹在屋，园林已半春。\n客情盈一舫，幽事杂诸邻。\n地有忘忧草，池无赪尾鳞。\n公荣殊自胜，樽酒肯同人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"郑德普","text":"山蒸云气晴能雨，泉挟风声夏亦寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题玉岩次韵 其一","author":"郑蕴","text":"乱山环绕疑无路，却望人家岭上村。\n古寺性耽泉石趣，孤城不见水烟昏。\n早行携杖雪初起，夜诵挑灯景尚暄。\n遥问隐居何处是，满岩松竹至今存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆南别贾制书东归","author":"郑起","text":"来时秋雨满江楼，归日春风度客舟。\n回首荆南天一角，月明吹笛下扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山采药","author":"郑樵","text":"一掬金丹向晚风，山前草木尽龙宫。\n诗书便是神仙味，更笑行冲问药笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北山岩","author":"郑樵","text":"西风曳曳片云閒，一夜寒泉卧北山。\n倚杖岩头秋独望，稀疏烟垄是人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百丈山","author":"郑樵","text":"叠嶂联屏飞远近，风情物色有馀涯。\n回头四顾东西地，多少砺山壮帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵龟潭","author":"郑樵","text":"泉心漱玉开心孔，山色挼蓝熨眼花。\n著手摩娑溪上石，他年来访汝为家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭君解","author":"郑樵","text":"巫山能雨亦能云，宫丽三千杳不闻。\n延寿若为公道笔，后人谁识一昭君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"福宁州蓝溪寺前蒙井","author":"郑樵","text":"静涵空碧色，泻自翠微巅。\n品题当第一，不让慧山泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芗林閒居 其一","author":"郑樵","text":"芗林苍翠甚，极目可□诗。\n梅子风前落，杏花雨后移。\n清溪过半郭，孤月隐疏篱。\n寂寂云山外，萧然独自知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过桃花洞田家留饮","author":"郑樵","text":"偶促沼渚过山家，灼灼桃花噪暮鸦。\n是处竹篱环草屋，人间鸡黍话桑麻。\n抱琴静听涛声急，对酒閒观月色奢。\n可笑南阳刘子骥，欲寻风土滞京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村雨","author":"郑樵","text":"荒村常寂寂，小雨自涓涓。\n寒气侵人急，野花入目妍。\n看山频当户，听鸟倍难眠。\n万事萧条尽，空馀日暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"郑樵","text":"夜雨潇潇至，天寒拥敝裘。\n空床听幻响，独咏解深忧。\n次第园蔬润，参差渔火幽。\n长江风浪息，何日放舟游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建炎初秋不得北狩消息作","author":"郑樵","text":"昨夜西风到汉军，塞鸿不敢传殷勤。\n几山衰草连天见，何处悲笳异地闻。\n犬马有心虽许国，草茅无路可酬君。\n微臣一缕申胥泪，不落秦庭落暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送芹斋","author":"郑樵","text":"千载清风去不留，何人能伴赤松游。\n乞骸直到骸归日，告老须临老尽头。\n元亮园田何处有，向平昏嫁几时休。\n湖州别驾发深省，挂却朝冠便自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其五","author":"郑樵","text":"佻达凭豪族，疏狂自克家。\n看人呼狗窦，纵我泛渔槎。\n凿穴安蜂豕，穿篱避管笳。\n如能痴胜黠，寒食贺骝骅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其四","author":"郑樵","text":"读书经百卷，见影岂须惊。\n中夜山精笑，寒灯草魅争。\n脱冠神采足，掷樏眼光明。\n面壁吾常事，庵题天耐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其一","author":"郑樵","text":"天下轻黄宪，居邻孰戴良。\n暴田安足较，散绢未为狂。\n失剑羞余里，还牛让古乡。\n家风留不坠，少贱自翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其三","author":"郑樵","text":"每恨纨绮子，交游半博徒。\n弃家寻有道，舍命事名儒。\n风雅非难及，今人贵与殊。\n夜深何所嘱，嘱汝似狂夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其八","author":"郑樵","text":"只身空后死，千卷未酬恩。\n不辱看来世，贪生托立言。\n无家称马粪，何史世龙门。\n负石今愁晚，中宵吊屈原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其二","author":"郑樵","text":"竹床读史惯，土锉勿粘尘。\n洒扫王维德，浇锄郭太仁。\n使才看著屐，有道验时薪。\n小物汝知谨，同心作古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其七","author":"郑樵","text":"学俭诚佳事，悭名岂足居。\n写多崇厚论，读废绝交书。\n结客饶倾产，破贫累卖车。\n前人家训在，孙孔未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽通判黄子方","author":"郑樵","text":"歌成薤露悲，秋草正离离。\n昔异修文事，今同鬼伯司。\n盾衰双日落，夷惠两风遗。\n衰俗吾无恨，亲曾识紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涧雨","author":"郑樵","text":"飘飘雨色乱，终日误闻声。\n钓客呼持笠，牧童喜啜羹。\n轻香树下满，馀响谷中清。\n为谢登临者，枕流洗耳倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨雨","author":"郑樵","text":"东方斜未彻，暝色淡初分。\n宿鸟林中噪，凄风叶上闻。\n钟鸣催过雨，星落避行云。\n独立草堂内，涓涓群动纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题夹漈草堂 其二","author":"郑樵","text":"堂后施柴堂上烧，柴门终日似无聊。\n蓼虫不解知辛苦，松鹤何能慰寂寥。\n述作还惊心力尽，吟哦早觉鬓毛彫。\n布衣蔬食随天性，休讶巢由不见尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题夹漈草堂 其一","author":"郑樵","text":"堂后青松百尺长，堂前流水日汤汤。\n西窗尽是农桑域，北牖无非花葛乡。\n罢去精神浑冉冉，看来几案尚穰穰。\n不知此物何时了，待看临流自在狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题溪东草堂","author":"郑樵","text":"春融天气露微微，药草葱芽脉脉肥。\n植竹旧竿从茂谢，栽桃新树忽芳菲。\n天寒堂上燃柴火，日暖溪东解虱衣。\n兴动便携樽到岭，人生真性莫教违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊采石渡头将军","author":"郑樵","text":"石头城下何纷纷，将军疋马气如云。\n金鼓死兮弓矢休，势失英雄不自由。\n风淅淅兮月沉沉，荻花满岸江水深。\n千年江水留明月，一片将军报国心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芗林閒居 其二","author":"郑樵","text":"芗林苍翠甚，霁色绕吾庐。\n四面鸟声寂，一庭月影疏。\n有山皆入坐，无日不安居。\n好向墙东卧，看人献子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观除夕火爆","author":"郑樵","text":"驹隙光阴岁已残，门门竹爆共团栾。\n烧成焰焰丹砂瑰，碎尽琅琅碧玉竿。\n唤转韶光新景燠，辟除恶魅旧时寒。\n主人从此占佳瑞，再入为霖洒旱乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"负耒歌","author":"郑樵","text":"烟冉冉兮雨纷纷，负耒耜兮出柴门。\n出柴门兮踏行云。\n茫茫山色天未分，相率歌吟兮乐耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谷城山松隐岩","author":"郑樵","text":"青嶂回环画屏倚，晴窗倒入春湖水。\n村村丛树绿于蓝，列列行人去如蚁。\n新秧未插水田平，高低陇麦相纵横。\n黄昏倦客忘归去，孤月亭亭云外生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采茶行","author":"郑樵","text":"春山晓露洗新碧，宿鸟倦飞啼石壁。\n手携桃杖歌行役，鸟道纡回惬所适。\n千树朦胧半含白，峰峦高低如几席。\n我生偃蹇耽幽僻，拨草驱烟频蹑屐。\n采采前山慎所择，紫芽嫩绿敢轻掷。\n龙团佳制自往昔，我今未酌神先怿。\n安得龟蒙地百尺，前种武夷后郑宅。\n逢春吸露枝润泽，大招二陆栖魂魄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋水歌","author":"郑樵","text":"年年秋水崩江石，秋水年年连天碧。\n山中草木尽号呼，江外鱼龙轻虚掷。\n既怜茅屋化飞蓬，又叹虾蟆共枕席。\n人生变化不可知，且听秋风吹萝薜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饷馌歌","author":"郑樵","text":"提筐兮阡陌，花红兮衣白，步迟迟兮心迫迫。\n行至止兮嗟于役，低声相劳兮日其夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日题王右丞冬山书屋图","author":"郑樵","text":"壁间飒飒松涛起，□□□□□冰冽。\n呼灯始见王右丞，毫毛矜贵逞奇杰。\n挥洒冬山书屋图，岩壑幽棂坐高哲。\n数笔萧瑟天貌寒，不尽枯枝不尽雪。\n高崖崛曲形凄肃，驱禽逐兽但松竹。\n傍有一水白于峰，千顷奔茫日难昱。\n绢外似觉风惨激，大江尽断船相逐。\n室中之人淡如菊，长年手携一卷读。\n窗外苍虬恣飞瀑，欲夺造化齐冷燠。\n天下无几焦孝然，当世宁更有梅福。\n苦吟抱膝此何人，乃肯萧条立炼谷。\n古今书画技总微，贵有嵚崎生眼目。\n我闻孙登居北山，隆冬披发以自覆。\n又闻昔贤暑重裘，六月御车鄙王侯。\n二公气岸皆千里，朗月白霜胸际浮。\n名士逆天天不怒，冬景能暖夏能秋。\n千载斯人不可致，我于画间得其意。\n揆向高飙远远至，笔光墨汁俱吐弃。\n但悬此幅清吾心，千岩炎伏曦景炽，布褐推车我不避。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园示弟槱 其六","author":"郑樵","text":"谁使余为墨，朝朝哭染丝。\n猎鹰才子累，杀虎古人痴。\n早信山宜面，休嫌谷可移。\n日光图史满，炳烛却惊迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其四","author":"郑樵","text":"修身以为弓，矫思以为矢。\n立义以为的，亦云善拟议。\n呜呼彼鸿渐，进德亦犹水。\n我如驾其说，木舌畅所指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其二","author":"郑樵","text":"天命既倒悬，将身费椒糈。\n朝行畏日薄，暮行畏龃龉。\n娵娃虽见珍，众嫭心未许。\n展转溷餔歠，敢俟庆云举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其五","author":"郑樵","text":"八荒有礼乐，涂民以耳目。\n五政不得加，七赋不能育。\n古今贵天常，最厌彼婴犊。\n嗟哉生不辰，沾顶滋觳觫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其八","author":"郑樵","text":"贤者不饱食，何为仕与农。\n圣人不诡时，何为世所宗。\n显晦既有因，盛衰亦偶逢。\n先秋而后春，俄顷自雍容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其三","author":"郑樵","text":"孤凤落鹰巢，啼麟坠虎穴。\n未能脱蒙茸，安得出轩凸。\n迢递空自倬，耀灵久已灭。\n褆身入三门，黾勉成吾拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其十","author":"郑樵","text":"嗟余本固陋，湛身入花渚。\n未制芙蓉裳，已习离骚语。\n绰约虽多姿，涕零何如雨。\n季夏遭繁霜，天寒不可禦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其六","author":"郑樵","text":"潜天以不策，潜心以不手。\n天人既和同，飞潜均不朽。\n吾生既病劳，未敢轻俯首。\n久幽不改操，旦夕谋杯酒。\n岷峨自沉冥，丘壑难为后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其一","author":"郑樵","text":"枳棘何榛榛，猿狖不敢下。\n芳苓何烨烨，雹霜不敢洒。\n骅骝驰曲艰，举足难宽假。\n所以古之人，犁锄聊自把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其九","author":"郑樵","text":"金革久不息，遐方徒惮指。\n谁为民请命，皇天犹未喜。\n茂德自不绥，眷眷我梓里。\n伤哉古王道，樵夫亦冷齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涤愫 其七","author":"郑樵","text":"德行尊颜闵，股肱卑萧曹。\n明哲知寝伏，文章亦弁髦。\n纵彼攀龙鳞，何如棹小舠。\n人生一世间，慎勿轻自豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"插秧歌","author":"郑樵","text":"漠漠兮水田，袅袅兮轻烟。\n布谷啼兮人比肩，纵横兮陌阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘妃怨","author":"郑樵","text":"黄埃游辇毂，翳日冷旌旗。\n龙去攀髯远，鸾孤对影微。\n魂沉江缥渺，泪染竹依稀。\n枯树空千载，寒松已十围。\n芦花深月色，燐火剧萤飞。\n横笛潇湘暮，哀猿何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南山书堂","author":"郑樵","text":"一泓澄澈照人间，明月团团落古湾。\n不向奔流随浪击，独持高洁伴云閒。\n禅房夜静留清鉴，阆苑仙归坠碧环。\n每到轩前心转逸，了无纤翳可相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其四","author":"郑樵","text":"今古去来有数，乾坤阖辟无涯。\n人生行云流水，处世运瓮搬柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其七","author":"郑樵","text":"空山无人坚卧，冷灶有饭晚餐。\n安得原宪与语，雪霜不受天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其一","author":"郑樵","text":"野鸟日啼户外，凉风时入帘间。\n老夫梦后攲枕，稚子病中解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其八","author":"郑樵","text":"花下閒倾浊酒，人前莫道清贫。\n残生全无奢愿，岁月徙倚竹筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其三","author":"郑樵","text":"门前半亩禾苗，日午翠色可描。\n笑问耦耕沮溺，何劳蓑笠终朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其十","author":"郑樵","text":"邻沽数盏微醉，坦腹北窗短眠。\n风送松涛聒耳，惊回梦蝶翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其二","author":"郑樵","text":"陋巷颜回早死，柴桑陶令长生。\n达观千载儿戏，厌见一时利名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其五","author":"郑樵","text":"初秋一雨新凉，子夜长吟未央。\n阶下花枝冷艳，堂前佛火微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其九","author":"郑樵","text":"临水时思下钓，闭门聊学吞膻。\n一身苦乐无定，万事安危有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴 其六","author":"郑樵","text":"壶山八面苍翠，兰水一泓涟漪。\n容我放歌问渡，凭谁拄杖支颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭君怨","author":"郑樵","text":"长谢椒房草，终为薄命身。\n那教兰蕙质，翻与雪霜亲。\n脸腻匀脂浅，妆残促恨颦。\n故知关北夜，无分汉南春。\n红泪残胡月，轻衣半洛尘。\n琵琶凄切语，愁杀路傍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郑樵","text":"官似冯唐能老去，节如苏武不生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入涿州","author":"郑獬","text":"饮马桑乾流水浑，燕山未晚已黄昏。\n衣襟犹带长安酒，不分江湖浣旧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月","author":"郑獬","text":"三月江南梅子青，春游已过画船横。\n酒怀索寞人初倦，已喜金杯弄水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上朝","author":"郑獬","text":"秋风御路冠盖满，晓月画楼钟鼓迟。\n卧听传呼丞相入，可怜正是上朝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下第游金明池","author":"郑獬","text":"骑杀青都白玉麟，归来狂醉后池春。\n人间得丧寻常事，不避郎君走马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]