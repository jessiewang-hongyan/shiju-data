[{"title":"题巽亭","author":"韩维","text":"薄阴散秋曦，爽气来孟月。\n慨然登兹亭，嘉观非远涉。\n径幽出深竹，栈峻跻危堞。\n身腾尘境外，心与空界接。\n前临潩波泛，却视隗峰列。\n来远得清飙，洒迥想飞雪。\n君家兄弟贤，问学继先业。\n横经咨老师，置醴延大耋。\n方从贤者乐，岂为游子设。\n诗人亦有言，佻达在城阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕诸生于内集堂作诗以勉之","author":"韩维","text":"济济众君子，庠序之冠冕。\n来燕升我堂，良用慰衰蹇。\n清言屏丝竹，善意陋肴膳。\n兹藩实故国，贤哲世多显。\n荀陈没已远，馀迹竟未践。\n顾惭为政久，儒道不加阐。\n云飞乏孔翠，庙荐阙瑚琏。\n非期宠禄光，或虑志业浅。\n惟天傥有待，在己固当勉。\n临觞无以侑，相敦在诚善。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠在己上人","author":"韩维","text":"人生天地间，万物同一理。\n子今名已是，智要独在己。\n乞诗东南归，固已谢尘滓。\n东南美林壑，佛刹净如水。\n勉当穷吾言，将有大于此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠昌言太中","author":"韩维","text":"春风吹袂踰嵩岭，秋雨随轩过颖亭。\n达理偶同无剩语，论交虽晚便忘形。\n两株枯木同危坐，数朵寒花伴独醒。\n鸭子陂头好光景，几时重见聚华星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窊樽","author":"韩维","text":"闲坐闲行水际，自吟自啸云根。\n过尽春风秋月，无人共醉窊樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其一","author":"韩维","text":"轻云薄雾。\n散作催花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其二","author":"韩维","text":"兄弟对举杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月 席上呈子华","author":"韩维","text":"早岁相期林下，高年同在尊前。\n风花绣舞乍晴天。\n绿蚁新浮酒面。\n身外虚名电转，人间急景梭传。\n当筵莫惜听朱弦。\n一品归来强健。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步月","author":"韩维","text":"初阳夺残凛，和气不待春。\n况兹华月白，光彩清路尘。\n整我巾与屦，迢遥步城闉。\n仰观众星色，收芒避孤轮。\n虚无一境间，岂复知吾身。\n嗟哉御风者，有待奚足珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡捣练令/胡捣练","author":"韩维","text":"夜来风横雨飞狂，满地闲花衰草。\n燕子渐归春悄。\n帘幕垂清晓。\n天将佳景与闲人，美酒宁嫌华皓。\n留取旧时欢笑。\n莫共秋光老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令","author":"韩维","text":"饱食日□□。\n□上危亭。\n东风昨夜入□□。\n□□雪晴云□□，□遍银屏。\n回首叹劳生。\n□鼎相承。\n皇恩早晚□□□。\n□□陂边垂钓手，不负幽情。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 颍州西湖","author":"韩维","text":"和风动□。\n□□新年□入手。\n世事尘□。\n□□□情近酒□。\n水开湖□。\n□□笙歌波面起。\n相与排□。\n□□□胜特地□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"踏莎行 次韵范景仁寄子华","author":"韩维","text":"归雁低空，游蜂趁暖。\n凭高目向西云断。\n具茨山外夕阳多，展江亭下春波满。\n双桂情深，千花明焕。\n良辰谁是同游伴。\n辛夷花谢早梅开。\n应须次第调弦管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"韩维","text":"剡溪柔弱难争强，紫岩紧实为最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"韩维","text":"两君旷度皆吾党，红烛迎舟尽醉还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"韩维","text":"一笛西风吹落日，满帆行客背孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅古堂八咏 其七 小桧","author":"韩琦","text":"小桧新移近曲栏，养成隆栋亦非难。\n当轩不是怜苍翠，只要人知耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳絮二阕 其二","author":"韩琦","text":"絮雪纷纷不自持，乱愁萦困满春晖。\n有时穿入花枝过，无限蜂儿作队飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳絮二阕 其一","author":"韩琦","text":"惯恼东风不定家，高楼长陌奈无涯。\n一春情绪空撩乱，不是天生稳重花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北塘避暑","author":"韩琦","text":"尽室林塘涤暑烦，旷然如不在尘寰。\n谁人敢议清风价，无乐能过白日閒。\n水鸟得鱼长自足，岭云含雨只空还。\n酒阑何物醒魂梦，万柄莲香一枕山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡圃春晚","author":"韩琦","text":"溶溶春水满方塘，栏槛风微落蕊香。\n尽日杨花飞又歇，有时林鸟见还藏。\n沈疴不为闲来减，流景知从静处长。\n欲战万愁无酒力，可堪三月去堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安阳好/忆江南 其一","author":"韩琦","text":"安阳好，形势魏西州。\n曼衍山川环故国，升平歌吹沸高楼。\n和气镇飞浮。\n笼画陌，乔木几春秋。\n花外轩窗排远岫，竹间门巷带长流。\n风物更清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇","author":"韩琦","text":"病起恹恹，画堂花谢添憔悴。\n乱红飘砌。\n滴尽胭脂泪。\n惆怅前春，谁向花前醉。\n愁无际。\n武陵回睇。\n人远波空翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南","author":"韩琦","text":"维扬好，灵宇有琼花。\n千点真珠擎素蕊，一环明玉破香葩。\n芳艳信难加。\n如雪貌，绰约最堪夸。\n疑是八仙乘皓月，羽衣摇曳上云车。\n来会列仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维扬好","author":"韩琦","text":"二十四桥千步柳，春风十里上珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以蜀笺寄弟洎","author":"韩溥","text":"十样蛮笺出益州，寄来新自浣溪头。\n老兄得此全无用，助尔添修五凤楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉扬英公大师诗匠","author":"韩溥","text":"悟解真空始壮年，两朝供奉近炉烟。\n故乡梦断三湘远，应制诗高四海传。\n晴望野云生紫阁，夜吟兰烛滴花笺。\n应愁内殿徵书至，恐向东林负昔缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉亲两载为民祈蚕作竞渡于此以五十六言即事","author":"韩煜","text":"中巴旧说古刀州，环壁依城水自流。\n鱼米岂殊京洛在，人民轻向死生不。\n我来二载无青眼，心叹三农空白头。\n修禊何妨书即事，放怀杯酒问田畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"韩缜","text":"剑外吾能说，山川大抵同。\n君行在巴徼，民俗半夷风。\n火田租赋薄，盐井岁时丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"韩缜","text":"地里舆星直，江流汉水通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤箫吟","author":"韩缜","text":"锁离愁连绵无际，来时陌上初熏。\n绣帏人念远，暗垂珠泪，泣送征轮。\n长行长在眼，更重重、远水孤云。\n但望极、楼高尽日，目断王孙。\n消魂，池塘从别后，曾行处、绿妒轻裙。\n恁时携素手，乱花飞絮里，缓步香茵。\n朱颜空自改，向年年、芳意长新。\n遍绿野、嬉游醉眼，莫负青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子八月八日再游东山寺","author":"韩缜","text":"蜀师当日戍黄金，此地由来险阻深。\n漾水东流自纡直，泰山北望正嵚崟。\n凉风肃物初秋意，膏泽愆期旦昼阴。\n同是天涯未归客，荒烟斜日正登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇法寺","author":"韩缜","text":"久闻云际山，中有古招提。\n新秋喜远览，锐意穷攀跻。\n出郭值微雨，凉风晓萋萋。\n陂陀越大岭，沙路净无泥。\n野沃稻田秀，耒耜沿沟畦。\n登岑复入谷，渐过西山西。\n举首望华屋，双岸郁相携。\n虚桥驾烟霭，峻闼排虹霓。\n下马踏危级，褰裳涉修梯。\n超然层阁外，仰视穹苍低。\n俯眺亦何有，森森乔木齐。\n喧嚣从吏语，嘲唽惊禽啼。\n既饭复搜讨，林间得幽蹊。\n岩阿访灵迹，大士常高栖。\n古殿蚀苔藓，丹青暗尘㙠。\n俯身践危蹬，侧足缘深溪。\n老树阴潭黑，风修乱蝉嘶。\n悬泉洗阴壁，瑩色如玻瓈。\n佳观诚可恋，迟留惧颠挤。\n扪萝出天险，始免魂神睽。\n缓步淩巀嵲，双旌随杖藜。\n回瞻花雨地，已被烟云迷。\n顿辔下平陆，晴川留马蹄。\n新篁映碧宇，野寺临长堤。\n乘倦驻归策，荒园步柔荑。\n婆娑两高树，磊落垂红离。\n汲井漱甘液，拂尘观旧题。\n出门尚斜日，隐隐闻城鼙。\n胜概亦陈迹，茫然失端倪。\n为诗记彷佛，吾友无诃诋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游东山寺","author":"韩缜","text":"久有东林约，因乘暇日游。\n眼明初出郭，神王欲凌秋。\n野旷鶱孤隼，江清飏远鸥。\n近山青嶂合，多稼绿云浮。\n鸡犬声相接，沟塍水乱流。\n度桥喧从骑，环树转鸣驺。\n问俗惊尧壤，寻僧到沃洲。\n深沈开宝闼，磅礴?华辀。\n像设严珠殿，经声隐绛帱。\n仰看香刹直，徐步画廊修。\n遇物皆周览，逢轩即少留。\n前庭初显豁，后径转深幽。\n野岭苍筠丽，霜枫赤叶稠。\n隔墙闻好鸟，循沼玩游鯈。\n翠干棕才剥，红芒稻半收。\n凌虚登陛道，匝境对岑楼。\n暗谷藏危栈，平沙际别州。\n川原同聚沫，身世剧浮鸥。\n回首飘乡思，临尊浣客愁。\n清闲资善奕，决胜在冥搜。\n影动穰苴表，风生曲逆筹。\n归鞍不敢缓，斜日照文楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游贾氏南园","author":"韩缜","text":"江堤杨柳碧毵毵，闲访名园郡郭南。\n垄麦生齐知雨足，海棠开遍觉春酣。\n门前幽径通芳蕙，竹里虚亭对远岚。\n风物有情应笑我，不携歌酒只清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"韩缜","text":"君恩未报身何有，且寄扁舟梦想中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"韩缜","text":"唐蒙谕巴蜀，通道至邛僰。\n列郡徼西南，夷居半岩壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"韩缜姬","text":"香作风光浓著露。\n正恁双栖，又遣分飞去。\n密诉东君应不许。\n泪波一洒奴衷素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉漏迟","author":"韩嘉彦","text":"杏香消散尽，须知自昔，都门春早。\n燕子来时，绣陌乱铺芳草。\n蕙圃妖桃过雨，弄笑脸、红筛碧沼。\n深院悄。\n绿杨巷陌，莺声争巧。\n早是赋得多情，更遇酒临花，镇辜欢笑。\n数曲阑干，故国谩劳凝眺。\n汉外微云尽处，乱峰锁、一竿修竹。\n间琅玕，东风泪零多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六经阁","author":"韩漪","text":"小楼灯火夜青荧，风撼梧桐客梦惊。\n谁家更理琴乌曲，误听壁间丝竹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"韩履常","text":"李门弟子饶门友，渭水年龄泗水心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 向伯恭韵木犀","author":"韩璜","text":"秋光如水。\n酿作鹅黄蚁。\n散入千岩佳树里。\n惟许修门人醉。\n轻钿重上风鬟。\n不禁月冷霜寒。\n步障深沈归去，依然愁满江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"韩璜","text":"愿为靖节妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长相思 其二","author":"韩疁","text":"杜娘家。\n谢娘家。\n楼压官桥柳半遮。\n帘波漾彩霞。\n拾飞花。\n怨飞花。\n望断郎来日又斜。\n东风吹鬓鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长相思 其三","author":"韩疁","text":"夜萧萧。\n梦萧萧。\n又趁杨花到谢桥。\n凤沈明月箫。\n来迢迢。\n去迢迢。\n枉把吟笺寄寂寥。\n飞鸿不受招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长相思 其一","author":"韩疁","text":"郎恩深。\n妾思深。\n祗为恩深便有今。\n回纹辜旧吟。\n云沈沈，水沈沈。\n一点坚如百炼金。\n郎应知妾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 其二 丰乐楼","author":"韩疁","text":"裙色草初青。\n鸭绿波轻。\n试花霏雨湿春晴。\n三十六梯人不到，独唤瑶筝。\n艇子忆逢迎。\n依旧多情。\n朱门只合锁娉婷。\n却逐彩鸾归去路，香陌春城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 其一","author":"韩疁","text":"莫上玉楼看。\n花雨斑斑。\n四垂罗幕护朝寒。\n燕子不知人去也，飞认阑干。\n回首几关山。\n后会应难。\n相逢祗有梦魂间。\n可奈梦随春漏短，不到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高阳台 除夜","author":"韩疁","text":"频听银签，重燃绛蜡，年华衮衮惊心。\n饯旧迎新，能消几刻光阴。\n老来可惯通宵饮，待不眠、还怕寒侵。\n掩清尊。\n多谢梅花，伴我微吟。\n邻娃已试春妆了，更蜂腰簇翠，燕股横金。\n勾引东风，也知芳思难禁。\n朱颜那有年年好，逞艳游、赢取如今。\n恣登临。\n残雪楼台，迟日园林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题崇明寺","author":"鲁千之","text":"心情稍觉难如旧，胜迹依然日月新。\n鹤怨猿惊嗟往事，再来山色似迎人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"鲁少师","text":"百雉城头难却月，五云峰顶欲乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"鲁少师","text":"吴头楚尾祗咫尺，斗盛牛明直古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"鲁仕能","text":"万劫灰中存世界，千层浪里惜儒珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘彦炳","author":"鲁交","text":"征旆遥分苑路西，马蹄春去弋阳溪。\n相思欲和乌啼曲，一拂瑶弦意总迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游安乐山","author":"鲁某","text":"苔径傍岩斜，林间是道家。\n夜潭鱼戏月，春地鹿眠花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大雪","author":"鲁交","text":"万象晓一色，皓然天地中。\n楚山云母障，汉殿水精宫。\n远近梅花信，高低柳絮风。\n吟魂清不彻，和月上晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼晴望","author":"鲁交","text":"江干一雨收，霁色染新愁。\n远水碧千里，夕阳红半楼。\n笛寒渔浦晚，山翠海门秋。\n更待牛津月，袁宏欲泛舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经战地","author":"鲁交","text":"西边用兵地，黯惨无人耕。\n战士报国死，寒草迎春生。\n沙飞贼风起，昼黑阵云横。\n未持天下帚，何以反欃枪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经秦皇墓","author":"鲁交","text":"祖龙何事苦东巡，仙驾归来冢草新。\n项籍已飞三月火，子婴犹醉六宫春。\n元来沧海殊无药，却是芒砀暗有人。\n自古乾坤属真主，骊山山下好沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烛","author":"鲁交","text":"暖烟红炬两飘香，珠箔沈沈下建章。\n有燄只凭心一寸，无愁虚滴泪千行。\n流苏帐里回残梦，白玉台边映宿妆。\n若到蓬山留夜直，金莲应照佩锵锵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清夜吟","author":"鲁交","text":"露华清八极，吟上小楼东。\n月色水铺地，雁声秋满空。\n明河欲泻浪，瘦竹自生风。\n坐久心骨爽，此怀谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游华山张超谷","author":"鲁交","text":"太华锁深谷，我来真景分。\n有苗皆是药，无石不生云。\n急瀑和烟泻，清猿带雨闻。\n幽栖未忍别，峰半日将曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有寄","author":"鲁交","text":"思君又是东风起，楼倚浮云目千里。\n芳草不知人断肠，带烟带雨连春水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"鲁交","text":"烟萝梓郡东，莲梵白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"鲁某","text":"万仞青崖碧玉寒，岩萝相引彻仙坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同庆府","author":"鲁百能","text":"山占仇池地，江分白马氐。\n潭深龙自蛰，亭迥凤曾栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉仙崖","author":"鲁百能","text":"高倚青冥插酒星，山崖谁作醉仙形。\n从来天地为衾枕，应笑人间有独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题龙华僧院放怀阁","author":"鲁君锡","text":"公馀闲步山阴寺，小阁临崖面竹开。\n我欲放怀□□□，故乡消息未曾来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":24564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]