[{"title":"自海至楚途次寄马全玉八首 其三","author":"张耒","text":"高城欲去更徘徊，病眼登临强一开。\n风物尽为愁里景，山川疑是梦中来。\n此身双鬓何劳白，未老尘心可得灰。\n欲把烦愁付杯酒，祇应清梦待尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其二","author":"张耒","text":"萧萧柳岸野风秋，虹挂前山晚雨收。\n回首孤城空绿树，满川斜日放归舟。\n年来双泪供愁尽，去去劳生几日休。\n试问故人思我否，梦魂犹在海边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自海至楚途次寄马全玉八首 其一","author":"张耒","text":"迂疏怀抱独君知，杖拂亲依即我师。\n一句未能参妙道，数篇空复寄新诗。\n子方奋迅云间翮，我厌追随世上儿。\n安得岩坰两如志，铜瓶乌几为君携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日有感二首 其二","author":"张耒","text":"一卧孤村两见冬，独搔华发思无穷。\n荒山极目漫汗雪，老树当庭昼夜风。\n佳节妻儿具樽酒，茅斋斟酌慰愁翁。\n未央晓贺瞻天冕，正在炉烟缥缈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日有感二首 其一","author":"张耒","text":"两逢至日惊身老，远寄周南览物悲。\n佳节风烟长惨惨，他乡人物自熙熙。\n荆榛崤渑秦关破，草树芳华隋苑隳。\n怅望高歌一回首，兹辰尊酒莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至安化驿先寄淮阳故人","author":"张耒","text":"萧条安化驿，倦客思悠哉。\n积水连天阔，青山送客来。\n疏篱风捲叶，败屋雨生苔。\n寄语淮阳旧，人今放逐回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中晓思","author":"张耒","text":"树色未啼鸟，桨声初度航。\n客灯青映壁，城角冷吹霜。\n飘泊年来甚，羁游情易伤。\n年丰清颍尾，吾计亦差良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观洛涨","author":"张耒","text":"雨锁山川昼不开，洛波一夕涨如催。\n西来势蹴诸山动，东转声包厚地回。\n一片晓光吴阵甲，万桴南响会稽雷。\n何人共此乘桴志，直到蓬瀛亦壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访人汴上有感","author":"张耒","text":"万尾鳞鳞汴岸舟，汴流日夜去悠悠。\n舟行水去常如旧，世事纷纷何日休。\n落日昏昏沙际晚，白云片片碧天秋。\n□□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过孝感县十里所望一土山下有渔舟呼之不来委舟负鱼径去不顾俄有一舟不待呼自拿舟直前取舟中美鱼致之求价甚贱予倍与之值卒辞倍值而去予语之曰尔不待招而赴人之求仁也售不求厚价廉也子岂有道者乎兹楚境也昔有劝屈大夫以餔糟啜醨者岂非子耶为作一篇","author":"张耒","text":"有道隐屠钓，仁廉非偶然。\n倾筐出紫鳜，挥手谢青钱。\n昔有离骚客，名高楚国贤。\n独醒遭尔笑，吾幸醉终年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过泗州推官王永年致仕还乡王年四十而致仕士大夫所少也","author":"张耒","text":"为忆田园便拂衣，休官退勇似君稀。\n尘埃摆脱青衫去，闾里惊嗟白发稀。\n南亩稻粱仍岁熟，旧山芝朮入秋肥。\n百年从此皆閒日，寄语人间浪是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐安今秋酒殊恶对岸武昌酒可饮故人潘主簿时惠双榼","author":"张耒","text":"军城晓鼓已蓬蓬，城下秋云卷暮江。\n祇有老鸡能换卧，更无佳客可倾缸。\n冲风时动萧萧叶，晚日斜窥寂寂窗。\n犹喜江南有佳客，怜贫时致玉壶双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐安食蒌蒿根菊茁","author":"张耒","text":"故园蔬甲又逢春，想见雕槃巧斗新。\n强掘蒌根槃郁屈，故挑菊茁嚼芳辛。\n春来小疾妨杯切，老去怀乡役梦频。\n堪笑吴伧恋莼鲙，素衣愁化洛阳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处春深好二首 其二","author":"张耒","text":"何处春深好，春深居士家。\n荒园几畦菜，环堵数株花。\n自蜡登山屐，仍驱下泽车。\n时时客问字，醉帽任倾斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何处春深好二首 其一","author":"张耒","text":"何处春深好，春深禅宿家。\n茶炉寒夙火，佛案晓添花。\n坏宅无妖火，通途有宝车。\n院深人不到，幡影逐风斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入试院","author":"张耒","text":"莫叹匆匆襆被行，赖逢数子美如英。\n已看明月同为客，应犯初寒复入城。\n白日有书追睡思，青灯无梦听秋声。\n直无剔甲逍遥地，几日疑公太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬小园寓目","author":"韩琦","text":"独树翘寒色，闲云淡落晖。\n新霜黄橘重，久雨翠梧稀。\n暝雀鸣还啄，高乌定更飞。\n敝貂犹故在，卒岁免无衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋对雨","author":"张耒","text":"闭户理残编，疏慵得自便。\n朝凉清病思，秋雨对高眠。\n屋冷深藏燕，槐疏混抱蝉。\n所欣堂下菊，芳意已鲜鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别外甥杨克一二首 其一","author":"张耒","text":"东南秋雨足，泽国水连天。\n日出数声雁，风高何处船。\n寒菹初获韭，野饷屡烹鲜。\n吾事无淹速，悠悠得醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"张耒","text":"雨蘖生朝菌，秋墙长若邪。\n槐榆蔽穷巷，藜藋接邻家。\n但愿好事酒，无劳长者车。\n御冬须旨蓄，吾亦问生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋","author":"张耒","text":"只合门如野叟家，市朝声利苦喧哗。\n但知得醉频沽酒，何处逢春不见花。\n暗树五更鸡报晓，晚庭三叠鼓催衙。\n知君宰邑端无事，吟笑何妨到暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孝感县","author":"张耒","text":"萧索江干县，林端见客樯。\n山川错吴楚，人物混荆杨。\n风略寒芦阵，云迷夕鸟行。\n故乡同见月，谁记白头郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿安怀古","author":"张耒","text":"萧王积甲事空传，子晋吹笙去不还。\n千里荒芜山色在，百年兴废水声间。\n雉飞陇麦新耕地，花落丛祠旧战关。\n旅宦远游仍吊古，苦无樽酒奈愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿阳楼下泊舟有感","author":"张耒","text":"寿阳楼下清淮水，帆去帆来何日休。\n浮世十年多少事，风烟依旧别离愁。\n楼头夜静行人绝，楼下影斜淮月秋。\n不道孤吟不能寐，一声羌笛怨谁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张夫人挽词","author":"张耒","text":"世德簪缨贵，家风孝友传。\n承夫知不忌，爱子故亲贤。\n飘忽人间梦，生平物外缘。\n诸天清净报，可但閟重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李少卿挽词","author":"张耒","text":"青云旧驰誉，白发早辞荣。\n谈笑惟诗酒，交游尽老成。\n支离病中见，潇洒旧时情。\n已矣不可问，九原松柏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李处道都曹丈挽词","author":"张耒","text":"凄凉正始后，尚复有斯人。\n恸哭亦云已，伤心难重陈。\n传家双令器，怀德万遗民。\n尚想典刑在，萧然老鹤身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李赞皇画像","author":"张耒","text":"管乐久寥阔，兴王一士多。\n平生自龙虎，功业在山河。\n公子悲黄犬，骚人赴汨罗。\n当年阅川恨，流落复如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沟泥二首 其二","author":"张耒","text":"不嫌泥潦巷，自扫寂寥居。\n雨已标新杏，春犹遗老樗。\n风光习暖事，云物或寒除。\n颇复撩诗句，时时漫与书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沟泥二首 其一","author":"张耒","text":"沟泥不可步，况复雨清晨。\n下直休半日，闭门闲晚春。\n著书聊尔耳，隐市笑徒云。\n买酒待新月，奈兹千里云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛江偶成","author":"张耒","text":"扁舟漾寒水，暂使客心清。\n天与秋阴合，江连野色平。\n洪波回赤壁，苍野带孤城。\n更想孙郎战，临风动壮情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芳华阁","author":"张耒","text":"玉仗无踪辇路摧，旧名犹得榜高台。\n月斜晓树鸣鹎鵊，日暖春芜放雉媒。\n清洛夜声萦谷转，锦屏晴色照人来。\n悽凉满眼兴亡恨，谁是芜城作赋才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近清明二首 其二","author":"张耒","text":"冉冉春向老，昏昏日复斜。\n鲜欢常止酒，不睡更烹茶。\n幡起烟中刹，鸡鸣林外家。\n陈王斗鸡道，风柳不胜斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近清明二首 其一","author":"张耒","text":"斜日去不驻，好风来有情。\n江城过风雨，花木近清明。\n水树閒照影，山禽时引声。\n吾年行老矣，淹泊蹇何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连昌宫","author":"张耒","text":"长安王气已消磨，吊古遗墟恨怆多。\n宫殿成尘新草木，丘陵无主故山河。\n雨馀耕陇寻遗宝，夜静溪泉响细波。\n才子已销泉下骨，百年独讽旧时歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迟日","author":"张耒","text":"迟日花光乱，东风酒浪深。\n天边为客恨，老去惜春心。\n起舞狂犹在，悲歌病不禁。\n高楼见千里，不醉莫登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈履常惠诗有曾门一老之句不肖二十五岁谒见南丰舍人于山阳始一书而褒与过宜阳有同途至亳之约耒以病不能如期后八年始遇公于京师南丰门人惟君一人而已感旧慨叹因成鄙句愿勿他示","author":"张耒","text":"南丰冢木已萧萧，犹有门人守一瓢。\n文彩自应传壶奥，典刑犹可想风标。\n纷纷但见侏儒饱，寂寂谁歌隐士招。\n十载敝冠弹未得，簪缨知复为谁彯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"驱马","author":"张耒","text":"骎骎驱马去，秋晚思悠哉。\n日暖禾黍熟，霜晴鸿雁来。\n晚篁经雨出，幽菊犯寒开。\n官冷无拘束，寻山首易回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京师废宅","author":"张耒","text":"当道朱门白昼扃，高堂歌吹久无声。\n古窗积雨昏残画，朽树经阴长寄生。\n门下老人时洒扫，旧时来客叹平生。\n艳姬骄马知何处，独有庭花春正荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和范三登淮亭","author":"张耒","text":"身如客雁寄汀洲，北望休登王粲楼。\n残雪朔风惊岁晚，早梅新柳动春愁。\n免遭斤斧甘无用，敢向波涛较善游。\n奔走尘埃欲归去，勒移恐作故山羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和晁十七见招之什","author":"张耒","text":"断送春光酒万壶，敢辞羸马为君驱。\n桑田日暖鸠呼妇，杨柳叶深莺哺雏。\n诗冷有情寻水石，年丰无盗起萑蒲。\n河阳潘令风骚客，醉倒樽前许我无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵奉酬慎思兄夜听诵诗见咏之作","author":"张耒","text":"昔遇晁公淮水东，士衡已听语如钟。\n五车讲学知无敌，十载论文喜再逢。\n古匣剑光疑鬼泣，夜天虎啸有风从。\n许侯破的由来事，杜老裁诗晓墨浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧病月馀呈子由二首 其二","author":"张耒","text":"风叶鸣窗已复朝，唤回归梦故山遥。\n酒壶暗淡浮尘集，药鼎青荧败叶烧。\n闭户独依寒蟋蟀，移床近就雨芭蕉。\n雪深更请安心术，长日如年未易消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧病月馀呈子由二首 其一","author":"张耒","text":"蔀室悠悠昏复朝，强披庄子说逍遥。\n四禅未到风犹梗，九转无功火不烧。\n学道若为调鹿马，是身不实似芭蕉。\n丹砂赤箭功何有，想听清言意自消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捲帘","author":"张耒","text":"捲帘新月上，林影散微茫。\n庭草鸣虫近，风灯秋幌凉。\n长年惟有病，晚岁苦多伤。\n身世竟何就，吾将问蜀庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和上维道祈雨有应","author":"张耒","text":"江乡长夏亢阳骄，太息秋原稻穗焦。\n暑气暮收秦地火，雨声秋响浙江潮。\n夜斋凉送檐间滴，晓枕清闻竹上飘。\n椒醑礼神惭德薄，圣朝当宁四时调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和小雨","author":"张耒","text":"入夜雨声急，坐愁衾枕单。\n春归千里恨，梦断五更寒。\n遣兴芳樽满，惊心节物残。\n山城近野水，半夜有归翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和门下相公从驾幸学","author":"张耒","text":"继圣文明举旧章，儒宫传跸驻胶庠。\n地疑阙里弦歌宅，经奏周书隶古行。\n遣子东夷思入学，受成西旅伫来王。\n鲁侯在泮犹歌诵，盛事须刊孔子堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和见梦","author":"张耒","text":"青山将白发，奔走倦埃尘。\n与物拙难合，惟君心独亲。\n相思成夜梦，得句寄游鳞。\n未得亲谈笑，书来莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和出山","author":"张耒","text":"晓别招提去，春风信马行。\n路幽皆竹影，山远尚松声。\n岭断晴天阔，川横绿野平。\n不因泉石好，安觉利名轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和北寺","author":"张耒","text":"寺倚苍崖古，僧閒昼掩扉。\n晓云辞岭去，夕鸟占林归。\n悟理观幡动，临风想锡飞。\n寄怀玄观外，更觉此生微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吕与叔秘书省观兰","author":"张耒","text":"千里猗猗谁取将，忽惊颜色照文房。\n每怜坠露时施泽，更许光风为汎香。\n独秀已先梁苑草，托根宁复楚天霜。\n坐令黄菊羞粗俗，只合萧条篱下芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和西斋","author":"张耒","text":"山色供开镜，溪光照掩扉。\n暗虫先夜响，萎叶近秋飞。\n灌垄晴蔬出，开笼暮鹤归。\n鸣琴坐朗月，轻露点秋衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和即事","author":"张耒","text":"溪如圆堑木如城，鱼鸟从游信此情。\n啅雀踏枝飞尚袅，仰荷承雨侧还倾。\n弹琴废久重寻谱，种药求多旋记名。\n于世久判无妙策，直应归学老农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宋二上元迎驾","author":"张耒","text":"拜揖清光咫尺间，彫舆欲动更移班。\n蓬莱不动鳌头稳，阊阖未开天上閒。\n老去一官羞简策，春来归梦满淮山。\n自惭衰病独随俗，醉逐游人月下还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应之永日","author":"张耒","text":"多病倦烦暑，幸兹山水幽。\n惜芳悲鷤䳏，占雨听鸣鸠。\n池影澄当户，山阴暮转楼。\n黄昏萤点点，秋信与堪愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应之石涧","author":"张耒","text":"麦气朝含露，溪光夕照烟。\n斗麋苍角老，雏雉绛毛鲜。\n葵折红缯绉，莲香水麝燃。\n敢辞幽僻处，直恐负林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应之灯蛾","author":"张耒","text":"万物皆畏死，尔生何独愚。\n由来附炎热，鲜不丧其躯。\n浅浅权利客，跹跹轻薄夫。\n高门甚烈火，相劝以奔趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应之细雨","author":"张耒","text":"朝烟和细雨，病眼暗难分。\n有润物皆泽，无声人不闻。\n绿连平野稼，翠杂乱山氛。\n晚霁复何有，飘飘神女云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应之雨中见怀之作","author":"张耒","text":"官居苦岑寂，容易过花时。\n绿暗野初秀，红乾风更吹。\n燕游心未展，归去意犹迟。\n浩荡云山外，新诗寄我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和应之盛夏","author":"张耒","text":"驱马畏炎暑，杜门常鲜欢。\n吴绡朝扇薄，越布夜衾单。\n饮沼山禽渴，沾泥雨果残。\n二年薇与蕨，实厌野人餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张提举","author":"张耒","text":"刺举威寒江国东，自惭多病幸优容。\n喜来丈室谈何妙，往拜高轩愿莫从。\n宛水春生初绉縠，钟山雪尽见蟠龙。\n新年强起寻芳物，零落宫梅白一重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李令放税","author":"张耒","text":"晚田既废麦初耕，冠盖侵星独出城。\n但见饥寒号岁晚，不闻箫鼓赛秋成。\n仓无农父千斯庆，税比周人什一轻。\n抚字从来须守令，莫辜圣世念疲氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏仲南邵湖会饮三首 其三","author":"张耒","text":"新亭当绝岛，景物更清妍。\n耳热风前酒，心澄水底天。\n观鱼方有得，荐味肯烹鲜。\n默坐吟春草，知君似惠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏仲南邵湖会饮三首 其二","author":"张耒","text":"交友不在眼，逢君怀抱开。\n主人容客醉，樽酒犯寒来。\n老境侵霜鬓，羁愁付酒杯。\n身闲不易得，相与且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和苏仲南邵湖会饮三首 其一","author":"张耒","text":"老病倦岑寂，燕游聊与俱。\n开樽当胜地，飞盖渡平湖。\n落日晚明灭，烟林远有无。\n归来灯火夜，人影乱栖凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]