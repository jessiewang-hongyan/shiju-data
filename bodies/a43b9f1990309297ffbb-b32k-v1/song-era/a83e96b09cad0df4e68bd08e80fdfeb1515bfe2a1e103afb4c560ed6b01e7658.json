[{"title":"草堂","author":"陆游","text":"南出湖壖有废堤，草堂只在鹳巢西。\n清风满榻眠初起，落叶平沟路欲迷。\n新酒已知迎社熟，秋莺犹作傍檐啼。\n邻翁相遇饶言笑，共喜年丰米价低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草堂","author":"陆游","text":"幸有湖边旧草堂，敢烦地主筑林塘。\n漉残醅瓮葛巾湿，插遍野梅纱帽香。\n风紧春寒那可敌，身闲昼漏不胜长。\n浩歌陌上君无怪，世谱推原自楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荐饥之馀复苦久雨感叹有作","author":"陆游","text":"道傍襁负去何之，积雨仍愁麦不支。\n为国忧民空激烈，杀身报主已差池。\n属餍糠麧犹多愧，徙倚柴荆只自悲。\n十载西游无恶岁，羡他村野足蹲鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虾蟆碚","author":"陆游","text":"不肯爬沙桂树边，朵颐千古向岩前。\n巴东峡里最初峡，天下泉中第四泉。\n齧雪饮冰疑换骨，掬珠弄玉可忘年。\n清游自笑何曾足，叠鼓鼕鼕又解船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览镜","author":"陆游","text":"白头渐觉黑丝多，造物将如此老何。\n三万里天供醉眼，二千年事入悲歌。\n剑关曾蹴连云栈，海道新窥浴日波。\n未颂中兴吾未死，插江崖石竟须磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览镜有感","author":"陆游","text":"齿如败屐鬓成丝，七十之年敢自期。\n阅世久应书鬼录，强颜那复乞山资。\n绯衫荫子踰初望，下泽还乡负圣时。\n回首堕沟元有命，不须深计巧丸儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴成都泛舟自三泉至益昌谋以明年下三峡","author":"陆游","text":"诗酒清狂二十年，又摩病眼看西川。\n心如老骥常千里，身似春蚕已再眠。\n暮雪乌奴停醉帽，秋风白帝放归船。\n飘零自是关天命，错被人呼作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵彦肤修撰挽辞","author":"陆游","text":"朝路英声早，宗盟宿望尊。\n宴谈推酝藉，大笔擅雄浑。\n许国心犹壮，安边策具存。\n凄凉故时客，痛哭望秋原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追怀胡基仲","author":"陆游","text":"高洁胡徵士，当时已绝无。\n门庭谢残客，薪水斥常奴。\n遗稿何由见，英魂不可呼。\n谁怜墓上草，又是一年枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追凉至安隐寺前","author":"陆游","text":"枕石何妨更漱流，一凉之外岂他求。\n寺楼无影月卓午，桥树有声风变秋。\n残历半空心悄怆，岸巾徐步发飕飗。\n定知从此清宵梦，常在沙边伴白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追感梁益旧游有作","author":"陆游","text":"西游万里倚朱颜，肯放尊前一笑悭。\n蜀苑妓围欺夜雪，梁州猎火满秋山。\n晚途忽堕尘埃里，乐事浑疑梦寐间。\n浮世变迁君勿叹，剧谈犹是诧乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"退居","author":"陆游","text":"溪烟漠漠弈棋轩，笕水潺潺种药园。\n医为疾平新扫迹，客知睡美罕敲门。\n谈馀白拂悬床角，饮散空樽卧壁根。\n赐帛更蒙优老诏，此生何以报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送七兄赴扬州帅幕","author":"陆游","text":"初报边烽照石头，旋闻胡马集瓜州。\n诸公谁听刍荛策，吾辈空怀畎亩忧。\n急雪打窗心共碎，危楼望远涕俱流。\n岂知今日淮南路，乱絮飞花送客舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送十五郎适临安","author":"陆游","text":"求禄亦常事，出门宁自由。\n苦留虽惜别，细语却生愁。\n雨急投村市，钟残过寺楼。\n祇应今夕梦，先汝到江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子坦","author":"陆游","text":"老境宁容别，诸儿仕为贫。\n一春多卧病，几度送行人。\n五斗方须禄，千金且爱身。\n长安虽可乐，怜汝正思亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子坦赴盐官县市征","author":"陆游","text":"父子团栾笑语哗，岂知云散各天涯。\n长亭结束秋将晚，别酒凄凉日易斜。\n我坐耄年艰就养，汝非仰禄肯离家。\n游山尚有平生意，试为闲寻一鹿车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子修入闽","author":"陆游","text":"士生万里合鹏抟，憔悴青衫且自宽。\n薄禄及亲虽共喜，远途将父亦诚难。\n关山可厌风尘恶，蓬荜应思菽水欢。\n只道耄年心似铁，诗成也作鼻辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子遹","author":"陆游","text":"隔一涛江路岂遥，踌躇不觉欲魂销。\n寄书勿遣过三日，发渡何曾无两潮。\n睡少不关茶作祟，愁多却赖酒时浇。\n柯桥西畔斜阳岸，谁为离人惜柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子遹至梅市而归","author":"陆游","text":"梅市长堤怆别情，鲁墟归路当闲行。\n日沉菱浦看鱼跃，烟合菰丛闻獭鸣。\n蘸水门扉初半掩，拥桥炬火已先迎。\n停桡不奈清愁得，独倚阑干待月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王龟龄著作赴会稽大宗丞二首 其一","author":"陆游","text":"有越逾千载，何人不宦游。\n向来惟一范，真足壮吾州。\n高躅今谁继，先生独再留。\n登堂吊兴废，想像气横秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王龟龄著作赴会稽大宗丞二首 其二","author":"陆游","text":"大将上兵符，军容备扫除。\n恭惟陛下圣，方采直臣书。\n忽报分司去，还寻入幕初。\n宗藩虽旧识，莫遣得亲疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王景文","author":"陆游","text":"张公遂如此，海内共悲辛。\n逆胡犹遗种，皇天夺老臣。\n深知万言策，不愧九原人。\n风雨津亭暮，辞君泪满君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王嘉叟编修出佐南昌","author":"陆游","text":"玉殿求衣早，鸾台退食迟。\n君看多故日，宁是弃言时。\n小作南州计，方观急诏追。\n归来上霄汉，莫遣此心移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送仲高兄宫学秩满赴行在","author":"陆游","text":"兄去游东閤，才堪直北扉。\n莫忧持橐晚，姑记乞身归。\n道义无今古，功名有是非。\n临分出苦语，不敢计从违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘戒之东归","author":"陆游","text":"去国三年恨未平，东城况复送君行。\n难凭魂梦寻言笑，空向除书见姓名。\n残日半竿斜谷路，西风万里玉关情。\n兰台粉署朝回晚，肯记粗官数寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送华师从剑州张秘书之招","author":"陆游","text":"三年相伴锦江头，一日翩然不可留。\n官冷蓬门无客恋，时清剑阁有僧游。\n关山默数来时路，风月悬知别后愁。\n禅版经龛有馀暇，频登高处望西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕彦升参谋","author":"陆游","text":"楚塞萧条久宿师，参谋承诏上丹墀。\n苦言到口真当发，圣度如天莫自疑。\n万里寄声长不达，一尊相属岂前期。\n遥怜霜晓朝衣冷，深愧江城睡足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李宪被召旧与其先侍郎游从","author":"陆游","text":"早谒龙门鬓未秋，暮年乃复接英游。\n海濒已幸见公子，瓜垄仍烦访故侯。\n霖雨即陪诸老进，德星肯为一方留。\n西城柳色青如许，欲挽长条特地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李德远寺丞奉祠归临川","author":"陆游","text":"送骑拥东城，烟帆如鸟轻。\n道行端有命，身隐更须名。\n旰食烦明主，胡沙暗旧京。\n临分一襟泪，不独为交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜起莘殿院出守遂宁","author":"陆游","text":"羽檄联翩昼夜驰，臣忧顾不在边陲。\n军容地密宁当议，陛下恩深不忍欺。\n白简万言几恸哭，青编一传可前知。\n平生所学今无负，未叹还乡两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送芮国器司业二首 其二","author":"陆游","text":"往岁淮边虏未归，诸生合疏论危机。\n人材衰靡方当虑，士气峥嵘未可非。\n万事不如公论久，诸贤莫与众心违。\n还朝此段宜先及，岂独遗经赖发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送芮国器司业二首 其一","author":"陆游","text":"此心知我岂非天，双鬓皤然气浩然。\n曾见灰寒百僚底，真能山立万夫前。\n洛城霜重听宫漏，霅水云深著钓船。\n拈起吾宗安乐法，人生何处不随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送苏赵叟赴省试","author":"陆游","text":"关路谁非观国宾，此君肝胆独轮囷。\n故家遗俗欲坠地，博士议郎方要人。\n久矣扁舟弄江月，往哉骎马踏京尘。\n敕中墨色如鸦湿，日待东归一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈吏部还朝","author":"陆游","text":"邂逅稽山许揽须，尘埃时得近冰壶。\n不辞我老鸡豚社，且喜公归樱笋厨。\n满室琴书怀燕几，一川风雨送行舻。\n勉哉早了功名债，要画骑牛第二图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈怀叔赴上皋酒官却还都下","author":"陆游","text":"奇才初试发硎刀，疋马秋风到上皋。\n地近虽同三辅重，时平无复五陵豪。\n极知稳步烟霄路，却要微知郡县劳。\n归去平津开首燕，吐茵应复忤西曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范西叔赴召二首 其二","author":"陆游","text":"欲驾征车劝小留，南山南畔更逢秋。\n数声过雁催行色，一盏昏灯话别愁。\n自昔文章关治道，即今台阁要名流。\n白头尚作书痴在，剩乞朱黄与校雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范西叔赴召二首 其一","author":"陆游","text":"天涯流落过重阳，枫叶摇丹已著霜。\n衰病强陪莲幕客，凄凉又送石渠郎。\n杜陵雁下悲徂岁，笠泽鱼肥梦故乡。\n便恐从今长隔阔，旧交新贵例相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客","author":"陆游","text":"长亭柳渐柔，送客当闲游。\n江近闻津鼓，云开见戍楼。\n簿书来衮衮，岁月去悠悠。\n闭眼寻归路，春芜满故畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客至江上","author":"陆游","text":"多事经旬不出城，今朝送客此闲行。\n郊原远带新晴色，人语中含乐岁声。\n天际敛云山尽出，江流收涨水初平。\n故园社友应惆怅，五岁无端弃耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客至望云门外","author":"陆游","text":"冬温频作雨，晨冷顿催晴。\n嫩日满江驿，淡烟笼郡城。\n忧民怀凛凛，谋己耻营营。\n投檄真须决，邻翁约耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客城西","author":"陆游","text":"倦客凭鞍半醉醒，秋光满眼叹颓龄。\n日斜野渡放船小，风急渔村摊网腥。\n客思不堪闻断雁，诗情彊半在邮亭。\n归来更恨城笳咽，烟火昏昏独掩屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送施武子通判","author":"陆游","text":"初入修门鬓未秋，安期千里接英游。\n退归久散前三众，迈往欣逢第一流。\n只道升沉方异趣，岂知气类肯相求。\n龙钟不得临江别，目断西陵烟雨舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送查元章赴夔漕","author":"陆游","text":"柳色西门路，看公上马时。\n亦知非久别，不奈自成悲。\n白发刘宾客，青衫杜拾遗。\n分留端有待，剩赋竹枝词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钱仲耕修撰","author":"陆游","text":"姑孰溪边识胜流，十年重见岂人谋。\n自应客路难为别，不是阳关作许愁。\n儤直公看鳌禁月，倦游我梦镜湖秋。\n殷勤为报中朝旧，睡足平生是建州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁谏议","author":"陆游","text":"湖海还朝白发生，懒随年少事声名。\n极知忧国人谁及，细看无心语自平。\n归访乡人忘位重，乍辞言责觉身轻。\n篮舆避暑云门寺，应过幽居听水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩立道守池州","author":"陆游","text":"千里江山控上流，省郎怀绶去为州。\n才华故在诸公右，谈笑遥分圣主忧。\n月堕丽谯喧鼓角，雨馀绿野遍锄耰。\n万家歌舞春风里，秋浦如今不似秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送猷讲主赴李明府姜山之招","author":"陆游","text":"贯花签帙压车辕，惟子穷探到本源。\n听法鬼神环麈尾，质疑英俊集龙门。\n孤舟此日轻为别，尺素何时远见存。\n坐想文殊对摩诘，高谈无碍九河翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送霍监丞出守盱眙","author":"陆游","text":"淮浦鳞鳞浸碧天，即今谁料作穷边。\n空闻瓯脱嘶胡马，不见浮屠插霁烟。\n亭障久安无檄到，杯觞频举有诗传。\n长城万里英雄事，应笑穷儒饱昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适闽","author":"陆游","text":"春残犹看少城花，雪里来尝北苑茶。\n未恨光阴疾驹隙，但惊世界等河沙。\n功名塞外心空壮，诗酒樽前发已华。\n官柳弄黄梅放白，不堪倦马又天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逃暑小饮熟睡至暮二首 其二","author":"陆游","text":"槐影桐阴欲满廊，纶巾羽扇自生凉。\n新篘玉瀣陈双榼，平展风漪可一床。\n驰骑远分丹荔到，大盆寒浸碧瓜香。\n湖边谁谓幽居陋，也爱迢迢夏日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逆旅书壁二首 其二","author":"陆游","text":"骑驴万里行，岁一过秦城。\n下杜贳春酒，新丰闻晓莺。\n绿槐新巷陌，白骨几公卿。\n欲觅曲江水，连云禾黍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逆旅书壁二首 其一","author":"陆游","text":"驴鞍悬酒榼，僮背负衣囊。\n但说市朝变，不知岐路长。\n下程先施药，拂榻静焚香。\n明旦又西去，河桥秋叶黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逆境","author":"陆游","text":"步步常由逆境行，极知造物欲其成。\n磨砻久已尽芒角，烹煮岂容重发生。\n死到面前犹觉小，事于身外孰非轻。\n出门不必名山去，但见风烟已眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋偶书三首 其三","author":"陆游","text":"江堕清笳月，霜严画戟门。\n滩声寒更壮，山气旦常昏。\n摇落悲徂岁，羁游忆故园。\n无劳空窃食，何以报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋偶书三首 其二","author":"陆游","text":"翠岭当城起，清江擘硖流。\n轲峨商客艑，嘈囋酒家楼。\n丰岁人元乐，残年我独愁。\n秦吴环万里，感槩故貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋偶书三首 其一","author":"陆游","text":"白首奉鱼书，萧然一事无。\n吏闲晨已散，人醉暮相扶。\n卷野收禾黍，连江下舳舻。\n山城君勿诮，东北是皇都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九不出遣怀","author":"陆游","text":"人生各自适飞潜，鱼腹熊蹯岂得兼。\n并舍晚风传药杵，小窗残日射书签。\n昏瞳但怪花争坠，衰鬓应无白可添。\n采菊泛觞终觉懒，不妨闲卧下疏帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九会饮万景楼","author":"陆游","text":"粲粲黄花手自持，登高聊答此佳时。\n纤云不作看山祟，斗酒聊宽去国思。\n落日楼台频徙倚，西风鼓笛倍凄悲。\n彭城戏马平生意，强为巴歌一解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九怀独孤景略","author":"陆游","text":"昔逢重九日，初识独孤君。\n并辔洮河马，联诗剑阁云。\n已悲吴蜀远，更叹死生分。\n安得持卮酒，浇君丈五坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重示","author":"陆游","text":"笃学仁何远，穷居道亦行。\n能充气刚大，谁蔽性光明。\n家世艰难业，乡闾宿昔情。\n岁残相劳苦，惟是语春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻角","author":"陆游","text":"小阁柴门近，黄昏画角声。\n时时逐风散，袅袅伴愁生。\n天地清秋暮，关河残月明。\n湖南贼未破，独立久含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻武均州报已复西京","author":"陆游","text":"白发将军亦壮哉，西京昨夜捷书来。\n胡儿敢作千年计，天意宁知一日回。\n列圣仁恩深雨露，中兴赦令疾风雷。\n悬知寒食朝陵使，驿路梨花处处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虏乱","author":"陆游","text":"运数群胡尽，烟尘北道昏。\n百年身易老，万里志空存。\n杨柳摇驰道，樱桃奉寝园。\n南公忠义薄，此恨与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虏乱代华山隐者作","author":"陆游","text":"满谷松风枕石眠，中原战血又成川。\n但思秦铸铜人日，不记齐成柏寝年。\n大药一炉暾晚日，孤桐三尺写秋泉。\n何妨狂舞旗亭下，乞与人间画醉仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虏政衰乱扫荡有期喜成口号二首 其一","author":"陆游","text":"正朔今年被百蛮，遥知喜色动天颜。\n风雷传号临春水，貔虎移军过玉关。\n博士已成封禅草，单于将就会朝班。\n孤臣老抱周南恨，壮观空存梦想间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻虏政衰乱扫荡有期喜成口号二首 其二","author":"陆游","text":"遗虏游魂岂足忧，汉家方运幄中筹。\n天开地辟逢千载，雷动风行遍九州。\n刁斗令严青海夜，旌旗色照铁关秋。\n功名自是英豪事，不用君王万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]