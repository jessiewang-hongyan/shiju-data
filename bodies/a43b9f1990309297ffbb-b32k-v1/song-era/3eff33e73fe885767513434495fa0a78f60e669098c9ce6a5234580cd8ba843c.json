[{"title":"东溪夜泊","author":"赵崇鉘","text":"雪满汀洲风满林，霁光空澈夜深深。\n推篷恰受梅花月，自喷横箫调楚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙思 其一","author":"赵崇鉘","text":"水殿风清急景斜，灵君初下五云车。\n碧罗宝扇双题字，记是谁人咏落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙思 其二","author":"赵崇鉘","text":"麻姑擗麟不肯食，飞猿岭上餐松实。\n月冷天空涵曙光，露色凝烟白如蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壮节亭二松","author":"赵崇鉘","text":"壮节亭前野碧滋，髯龙飞去忽经时。\n祇应黄犊苍藤路，尚有清泉白石知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有赠","author":"赵崇鉘","text":"别意参差绕碧栏，外头斜月逼人寒。\n钩帘恐碍双栖鹊，乍可桃花隔雾看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴 其二","author":"赵崇鉘","text":"日日西风坐石苔，手扪苍壁倚云开。\n却来平地观空色，不信碧虚天际来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"赵崇鉘","text":"清露初生红蓼秋，爽风先到木兰舟。\n钓丝不捲波痕稳，梦入芦花数白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至后","author":"赵崇鉘","text":"愔愔云气绕江城，至后寒轻讵可凭。\n两日南风将雪信，床前蝙蝠夜翻灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐","author":"赵崇鉘","text":"自炷芳萧读道书，玄文豁落走龙鱼。\n松梢露色挂北斗，一夜风前学步虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松下","author":"赵崇鉘","text":"松梢凉露警孤鹤，潭面北风蟠老蛟。\n蛟老涎腥波浪恶，独吟碎月看松梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南内","author":"赵崇鉘","text":"已剪诸郎百虑轻，骄儿长大又生狞。\n祇愁南内无归日，南内归来万古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸卯除夕客中","author":"赵崇鉘","text":"膝下传觞事已非，瓣香千里隔庭闱。\n摧心远忆新阡上，寂寂低松雪乍晞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食化","author":"赵崇鉘","text":"海食多诡心，豢食令人鲁。\n山中食荠人，幽吟肺肠苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起","author":"赵崇鉘","text":"雨漂窗纸湿成瑕，风压瓷瓶卧枕沙。\n晓起无悰饧粥冷，自添新水救梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"破褐","author":"赵崇鉘","text":"生松郁寒灰，破褐出残絮。\n童儿不耐烦，微吟起身去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调渔者","author":"赵崇鉘","text":"山明松雪水明沙，一曲清溪著钓槎。\n我已浮湛君漫浪，谩煎我水试君茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野园","author":"赵崇鉘","text":"野园对客无杯勺，共坐茅檐理钓车。\n片月渐低风露冷，隔墙山鬼啸梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颇爱","author":"赵崇鉘","text":"颇爱乐天齐物我，梦随吟赏洛中桥。\n桃花细马载杨柳，半面春潮红未消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖中","author":"赵崇鉘","text":"汀蒲猎猎起凉飔，碧藕香中独立时。\n机事两忘吾丧我，扁舟吟过水仙祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答维溪","author":"赵崇鉘","text":"维溪插架三千轴，葺茝纫兰得自娱。\n会须握手论活法，静看碧水生玄珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答碧山","author":"赵崇鉘","text":"欲种梅花无古根，手移兰茁上瓷盆。\n却忧偪仄伤兰性，自下清招为返魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"数日","author":"赵崇鉘","text":"数日东风欺病骨，侵凌晓色作轻寒。\n客来坐久无谈柄，共看游丝上井栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新堤","author":"赵崇鉘","text":"淡烟衰草雨丝丝，小醉微吟倒接篱。\n吟到水西云影北，莞然一笑已无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简云卧","author":"赵崇鉘","text":"忆君心事如流水，流向江头作暮潮。\n想得潮平沙有雪，自铿铁版和吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壁间韵 其四","author":"赵崇鉘","text":"半髧婵娟垂两鸦，惊潮微隐宝簪斜。\n客愁政自游丝乱，莫戴钗头百结花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壁间韵 其二","author":"赵崇鉘","text":"山月溪风两自由，紫兰绿桂等离忧。\n狂歌郁郁成何事，一片夕阳芦荻秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壁间韵 其三","author":"赵崇鉘","text":"海棠开尽故清寒，漠漠梨花暮色闲。\n酒满绿樽愁满酒，醉凭枕障认巫山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壁间韵 其一","author":"赵崇鉘","text":"雨又入帘风又斜，东风吹客客思家。\n浣纱西去谁家子，青绢围裙插杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都昌书事","author":"赵崇鉘","text":"世事可无酒，春藤还有花。\n山云欲到地，街鼓又催衙。\n风紧鱼休市，官贫饭带沙。\n天机不得问，暮色欲栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大孤","author":"赵崇鉘","text":"大孤溶溶决眼青，小孤江色春冥冥。\n隔江淮壖几千里，枯荻萧椮朔风起。\n佳人何在遥相望，我无羽翼从君翔。\n为君暗整真珠裳，绿蘅翠芷参差香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事","author":"赵崇鉘","text":"东邻老翁寒不寐，百结悬鹑抆悲涕。\n自云子孙学灌园，不识江湖与风水。\n大儿里胥缚送州，小儿遁逃卒未休。\n老夫忍饥特未死，犁耙典尽春无牛。\n身为王民合徭役，运米操舟操不得。\n江湖风水未足愁，楫丧樯倾误人国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东风","author":"赵崇鉘","text":"东风吹梅梢，飘摇泣香雪。\n下有野草根，崭然竞时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东风吹桃花","author":"赵崇鉘","text":"东风吹桃花，花光射春林。\n相看各媚妩，艳冶摇人心。\n憩蝶下新绿，游鱼上清浔。\n百年一须臾，冥观契飞沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻真夕对","author":"赵崇鉘","text":"春云弄月黄金丝，春山草木皆仙姿。\n松根对坐日西夕，群峰当前列青壁。\n铿铿虚壑含古音，静听宛是商山吟。\n洞石微开月当户，剪水弦冰心手语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴 其一","author":"赵崇鉘","text":"潮平烟敛月明高，霁宇涵空见羽毛。\n我自无能君了了，樯杆独倚调离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"学诗","author":"赵崇鉘","text":"神仙不可学，愿学长不死。\n学诗如学仙，吞霞洁尘滓。\n渚花流水香，烟霏暮山紫。\n凉飔入脩竹，一笑鸣绿绮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往体 其一","author":"赵崇鉘","text":"积雪久不解，下有希世珍。\n志士缊袍间，苦心终不伸。\n安得白日光，能照清夜颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往体 其三","author":"赵崇鉘","text":"志士惜流光，游子念长道。\n流光如奔霆，长路漫浩浩。\n饥人忽梦饱，百忧悉倾倒。\n真妄安足论，荣名以为宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往体 其二","author":"赵崇鉘","text":"皓彩青云端，飞光落溟渤。\n浑河与清沚，同受明月魄。\n勿以清浊殊，天光本无隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓮天名贤集下有天字","author":"赵崇鉘","text":"不见瓮天人，但见石上字。\n谁能负瓮去，夺我寥天思。\n瓮破奚有馀，瓮在奚不足。\n吟作瓮天辞，摩挲石苔绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"空城雀","author":"赵崇鉘","text":"空城雀，黄口莫啾啾。\n空城无人种禾黍，饮啄飞鸣由得汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青阳","author":"赵崇鉘","text":"青阳满芳蕤，流连度丘园。\n眄睐不忍折，恐伤造物恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狭斜","author":"赵崇鉘","text":"吴姬凌寒吹玉笛，手彊误作迟迟声。\n却来抛眼调行客，中有二月东风情。\n东风二月杨花满，伯劳朝啼芳思乱。\n狭斜绣毂易为愁，解后相逢莫肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"赵崇鉘","text":"新阳斡坤轴，枯朽皆光荣。\n棱层冰雪中，复见天地精。\n姑射神所为，伯夷圣之清。\n太白抱轗轲，灵均拥芳馨。\n是子心魂间，不受纤芥萦。\n独立万化先，皎皎非近名。\n溪流鉴寒柯，游风吹落英。\n山明雾气湿，月落参旗横。\n群虚妙香发，一洗万虑轻。\n纷纷儿女姿，惭愧东风情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雀","author":"赵崇鉘","text":"短翅遍斓贝花紫，逐食飞行晓霜里。\n祇知嘴爪求自肥，肥甘累人心弗知。\n天寒日暮向何处，前路多山慎勿去。\n吴儿织网连素空，一落牢笼腥血红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月二绝同韵 其一","author":"赵崇槟","text":"几度开樽宴画楼，月华孤负好中秋。\n姮娥也厌笙歌沸，云幕重重不上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋无月二绝同韵 其二","author":"赵崇槟","text":"何处人登庾亮楼，痴云特地妒中秋。\n试凭弦管吹将散，江静天空月满钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大廷","author":"赵崇嶓","text":"大廷新革晋春秋，王气宁知在荻洲。\n泉下髯参心独快，不教司马恨枋头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小窗","author":"赵崇嶓","text":"小窗风定曲肱眠，骨冷魂清梦易圆。\n蝴蝶不飞花自落，海棠枝下月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小窗对客","author":"赵崇嶓","text":"纸帐梅花自一真，小窗对语坐无裀。\n诗家供给惟风月，病与诗疏始觉贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广寒宫","author":"赵崇嶓","text":"碧海沉沉桂殿幽，满天风露四时秋。\n寒宫白兔参差老，一种凄凉各自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝农","author":"赵崇嶓","text":"边头几日静干戈，见说朝家已讲和。\n犹惜人家有汤镬，攒眉终日为催科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天宝禁中","author":"赵崇嶓","text":"外庭班退寿王归，别有骄儿侍禁闱。\n解事老奴宁及远，君恩如许政忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家","author":"赵崇嶓","text":"鸡豚白酒乐丰年，饱即高眠不问天。\n少长有恩相尔汝，淳风应似伏羲前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"赵崇嶓","text":"舞罢歌停岁月深，当时胜迹尽销沉。\n飞云捲雨人争赏，留得佳名尚到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西施捧心图","author":"赵崇嶓","text":"吴苑风光越水春，两山眉里笑颦分。\n腹心别有堪忧处，狂杀君王藐不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖","author":"赵崇嶓","text":"洞府烟霞锦绣丛，车如流水马如龙。\n东风烂熳花时节，也有人行九里松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折柳词","author":"赵崇嶓","text":"行人须折柳，折取最长条。\n明日天涯路，无人看舞腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凭远亭","author":"赵崇嶓","text":"莎庭日日报平安，幽处依然绝往还。\n平野四围天一幅，有人踏雪看南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏张丽华","author":"赵崇嶓","text":"陈事分明属绮罗，香尘吹尽井无波。\n行军长史何劳怒，次第论功妾更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲词","author":"赵崇嶓","text":"别浦潮生花梦寒，片红飞下粉痕乾。\n预知妾面如花面，泣向西风不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临汝道中","author":"赵崇嶓","text":"野水平田稻正青，肩舆轧轧趁新晴。\n髼头奴子无拘束，牛背醉眠歌太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽意","author":"赵崇嶓","text":"开帘野水声，倚杖青山色。\n幽意在人间，人间不相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春宫","author":"赵崇嶓","text":"小苑风酣雨露香，红情绿意为春忙。\n五云独绕琼花梦，三十六宫清漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春朝偶书","author":"赵崇嶓","text":"一夕春归桃李根，清寒犹勒艳阳魂。\n雪霜雨露年年事，惟有梅花地位尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独立","author":"赵崇嶓","text":"片云收雨入西山，望极苍茫杳霭间。\n荡荡太虚无一事，祗应日月不曾闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵飞燕姊妹","author":"赵崇嶓","text":"甲帐初停燕子飞，小雏相趁共差池。\n春风吹水粼粼长，又有披香博士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送还吴山稿","author":"赵崇嶓","text":"万卷文书一幅巾，不将风鉴落埃尘。\n桂花未绿槐花谢，独佩江蓠有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺词","author":"赵崇嶓","text":"恨杀庭前鹊，难凭卜远期。\n朝朝来报喜，误妾画双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"赵崇嶓","text":"平楚连天独倚楼，楼头日日望行舟。\n相思飞尽梅花雪，江上晴云片片愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读陶诗罢","author":"赵崇嶓","text":"一山秋意入柴扉，细读渊明采菊诗。\n读罢依然成一莞，闲拈野草调儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚立","author":"赵崇嶓","text":"古径苔深昼掩关，外头尘土不曾闲。\n雨晴天气明如镜，静倚孤松看远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮河水","author":"赵崇嶓","text":"秋风淮水白苍茫，中有英雄泪几行。\n流到海门流不去，会随潮汐过钱塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移梅","author":"赵崇嶓","text":"邻家争乞丽春栽，玉手轻分带月培。\n窗下老翁迂入骨，清斋三日为移梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗前","author":"赵崇嶓","text":"窗前寻丈地，种得一株梅。\n明月清风我，红尘不复来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月","author":"赵崇嶓","text":"腊月二十五，人家祓旧年。\n山人无可祷，睡著不知天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"痴猫","author":"赵崇嶓","text":"爱汝斑斓任汝痴，了无杀意上须眉。\n通宵鼠子喧人睡，政尔相忘也大奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谯楼","author":"赵崇嶓","text":"霜满谯楼报五更，道人睡稳几曾听。\n金街应有朝天客，佩马禁寒望晓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日云安道","author":"赵崇嶓","text":"元日度巴云，时逢朐䏰人。\n野梅空自落，山鸟暗知春。\n不醉新年酒，徒悲异域身。\n无穷倦行意，亭柳漫风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]