[{"title":"柳梢青 和张元晖清明","author":"王庭圭","text":"兰亭丝竹。\n高会群贤，其人如玉。\n曲水流觞，灯前细雨，檐花蔌蔌。\n舞雩初试春衣，听咏歌、童子五六。\n泽畔行吟，沙汀拾翠，满江新绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其二 上元鼓子词并口号","author":"王庭圭","text":"玉漏春迟，铁关金锁星桥夜。\n暗尘随马。\n明月应无价。\n天半朱楼，银汉星光射。\n更深也。\n翠娥如画。\n犹在凉蟾下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其三","author":"王庭圭","text":"春入西园，数重花外红楼起。\n倚阑金翠。\n人在非烟里。\n风月佳时，蓬岛开平地。\n笙歌沸。\n画桥灯市。\n一夜惊桃李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其一","author":"王庭圭","text":"花外红楼，当时青鬓颜如玉。\n淡烟残烛。\n醉入花间宿。\n白发相逢，犹唱当时曲。\n当时曲。\n断弦难续。\n且尽杯中醁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 辰州泛舟送郭景文、周子康赴行在","author":"王庭圭","text":"催花一霎清明雨。\n留得东风且住。\n两岸柳汀烟坞。\n未放行人去。\n人如双鹄云间举。\n明夜扁舟何处。\n只向武陵南渡。\n便是长安路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 次韵向芗林","author":"王庭圭","text":"九里香风动地来。\n寻香空绕百千回。\n错惊秋色上崔嵬。\n谁识芗林三昧手，能令花落又花开。\n返魂元学岭头梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"王庭圭","text":"薄薄春衫簇绮霞。\n画檐晨起见栖鸦。\n宿妆仍拾落梅花。\n回首高楼闻笑语，倚栏红袖卷轻纱。\n玉肌微减旧时些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"王庭圭","text":"翠袖卷轻纱。\n玉腕慵遮。\n蕊珠宫殿倚彤霞。\n不愤江南梅信早，争下香车。\n月露洗凝华。\n艳压群葩。\n暗传春信到天涯。\n试问东风谁第一，先到人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"王庭圭","text":"武陵西上沅陵渡。\n扁舟忘了来时路。\n花外有人烟。\n相逢疑是仙。\n清尊留夜语。\n醉倒知何处。\n归去客心惊。\n金鸡嘲哳鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 梅","author":"王庭圭","text":"溪风紧。\n溪上官梅整整。\n万木寒痴吹不醒。\n一枝先破冷。\n梦断香云耿耿。\n月淡梨花清影。\n长笛倚楼谁共听。\n调高成绝品。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其二","author":"王庭圭","text":"羸马怯征鞍，骎骎欲骤。\n昨夜文星动南斗。\n广寒宫近，欲上烟霄携手。\n素娥不奈冷，凄凉久。\n知是谪仙，肝肠锦绣。\n天半清风动襟袖。\n而今西笑，且饮新丰美酒。\n悠然还独酌，谁为寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其三","author":"王庭圭","text":"一叶下西风，寒生南浦。\n椎鼓鸣桡送君去。\n长亭把酒，却倩阿谁留住。\n尊前人似玉，能留否。\n醉中暂听，离歌几许。\n听不能终泪如雨。\n无情江水，断送扁舟何处。\n归时烟浪卷，朱帘暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其一","author":"王庭圭","text":"飞雪满貂裘，马蹄轻骤。\n笔下文章焕星斗。\n凌云才调，尽是夺标高手。\n况闻场屋里，知名久。\n金榜篆云，银鞍披绣。\n归去天香满衣袖。\n莫辞今夕，且尽一尊芳酒。\n为君歌一曲，为君寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二 戊辰上元黄子余席上，时未有月","author":"王庭圭","text":"宿雨初收，晚风微度，万家帘卷青烟。\n暗尘随马，人物似神仙。\n试问天公借月，天须放、明月教圆。\n应移下，广寒宫殿，灯火接星躔。\n卢川。\n元古郡，当时太守，宾从俱贤。\n到如今井邑，歌吹喧阗。\n花下红妆卖酒，时相遇、曲水桥边。\n谁知道，山城父老，重见中兴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一","author":"王庭圭","text":"颓玉成山，倾江作酒，醉来莫问升沈。\n少年狂怪，应笑老婆心。\n也会东涂西抹，行穿过、柳陌花阴。\n诚何用，腰龟左顾，犹待铸黄金。\n如今。\n回首处，青楼缥缈，朱箔重深。\n叹江海飘零，离恨难禁。\n好在铜梁玉垒，将车骑、他日重临。\n归来看，文君未老，相对抚鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 辰州上元","author":"王庭圭","text":"城东楼阁连云起。\n冠绝辰州市。\n莲灯初发万枝红。\n也似江南风景、半天中。\n花衢柳陌年时静。\n刬地今年盛。\n棚前箫鼓闹如雷。\n添个辰溪女子、舞三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解佩令佩令 本意","author":"王庭圭","text":"湘江停瑟。\n洛川回雪。\n是耶非、相逢飘瞥。\n云鬓风裳，照心事、娟娟山月。\n剪烟花、带萝同结。\n留环盟切。\n贻珠情彻。\n解携时、玉声愁绝。\n罗袜尘生，早波面、春痕欲灭。\n送人行、水声凄咽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行","author":"王庭圭","text":"云静天高，山明水阔。\n一年待个中秋月。\n十分魄少一分圆，今宵已觉蟾光别。\n且尽金尊，遥瞻玉阙。\n更深江水沙如雪。\n来宵风雨不相关，重须买酒追佳节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"殢人娇","author":"王庭圭","text":"小院桃花，烟锁几重珠箔。\n更深后、海棠睡著。\n东风吹去，落谁家墙角。\n平白地教人，为他情恶。\n花若有情，情应不薄。\n也须悔从前事错。\n而今夜雨，念玉颜飘泊。\n知那里人家，怎生顿著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"王庭圭","text":"罨画楼中人已醉。\n别院微闻，笑语帘垂地。\n催唤倾城香雾起。\n翠帷双卷春风里。\n妆样尖新歌妙丽。\n满酌金尊，不信人憔悴。\n饥客眼寒谁管你。\n主人见惯浑闲事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三 赠丁爽、丁旦及第","author":"王庭圭","text":"桂树新生都几许。\n兄弟骑龙，双入蟾宫去。\n一日两枝同折处。\n姮娥拍手都分与。\n杨柳江头春色暮。\n白马青衫，两郡文章主。\n只恐远方难久住。\n高宗梦觉思霖雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"王庭圭","text":"月落灯残人散后。\n忽到尊前，但觉眉儿皱。\n数日不来如许瘦。\n裙腰减尽君知否。\n公子风流应自有。\n占断春光，肯落谁人手。\n已是许多时做就。\n重教舞彻双罗袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其一","author":"王庭圭","text":"红尘紫陌春来早。\n晚市烟光好。\n灯发万枝莲，华月光中，天净开蓬岛。\n老人旧日曾年少。\n年少还须老。\n今夕在天涯，烛影星桥，也似长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其三","author":"王庭圭","text":"月娥昨夜江头过。\n把素衫揉破。\n冷逐晓云归，留与东风，吹作千千朵。\n云残香瘦春犹可。\n玉笛愁无那。\n倚著画楼人，且莫教他，吹动些儿个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其二 梅并鼓子词","author":"王庭圭","text":"玉妃谪堕烟村远。\n犹似瑶池见。\n缺月挂寒梢，时有幽香，飞到朱帘畔。\n春风岭上淮南岸。\n曾为谁魂断。\n依旧瘦棱棱，天若有情，天也应须管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉桃源","author":"王庭圭","text":"朱门映柳画帘垂。\n门前闻马嘶。\n主人新著绿袍归。\n天恩下玉墀。\n凭翠袖，捻花枝。\n劝教人醉时。\n请君听唱碧云词。\n倒倾金屈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寰海清 上元","author":"王庭圭","text":"画鼓轰天。\n暗尘随宝马，人似神仙。\n天恁不教昼短，明月长圆。\n天应未知道，天天。\n须肯放、三夜如年。\n流酥拥上香軿。\n为个甚、晚妆特地鲜妍。\n花下清阴乍合，曲水桥边。\n高人到此也乘兴，任横街，一一须穿。\n莫言无国艳，有朱门、锁婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴庆池禊宴","author":"王庭扬","text":"宗臣上巳宴东池，雅俗嘉宾盛集时。\n禊席临川花照耀，游车分路水逶迤。\n赏心唯欲居民乐，纵饮犹虞坐客疲。\n独愿我公归柄用，尽令天下洽春熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨柳枝","author":"王恽","text":"密叶阴阴汉将营，春风吹断鼓鼙声。\n少年不说封侯事，柘弹铜丸落晓莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王拱辰","text":"圣神深意念遐方，前后皆驰谕蜀郎。\n从此邮亭为盛事，乘轺相继有三王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史院席上奉和吴相公原韵","author":"王拱辰","text":"累圣千春统，编年四纪馀。\n官归柱史笔，经约鲁麟书。\n班马才长矣，仁英道伟欤。\n恩招宴东观，酾酒荷盈车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老苏先生挽词","author":"王拱辰","text":"气得岷峨秀，才推贾马优。\n未承宣室问，空有茂陵求。\n玩易穷三圣，论书正九畴。\n欲知歆向学，二子继弓裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尧夫先生安乐窝中好打乖吟","author":"王拱辰","text":"安乐窝中名隐君，腹藏经笥富多闻。\n一廛水竹为生计，三径琴觞混世纷。\n婉画旧尝辞幕府，少微今已应星文。\n了心便是栖真地，何必烟霞卧白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送会稽何从事","author":"王拱辰","text":"行行岐路出尘閒，从事犹胜执戟间。\n景象遍经江左地，封疆全得浙中山。\n侯藩暂列谈宾位，纶阁看随墨客班。\n到郡莫为经岁计，诏书非久急徵还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耆英会诗","author":"王拱辰","text":"西都山水天下奇，神嵩景室环清伊。\n甫申间气秀不绝，生贤会圣昌明时。\n衣冠占数盛文雅，台符卿月光离离。\n魏京雄奥压幽朔，游宫御府严天威。\n膏田千里翳桑柘，犀甲万旅驯熊罴。\n公当缓带名三镇，悬赤继轸承保釐。\n追推契遇最深旧，加复雍孟交旌麾。\n仁皇一庄龙虎榜，桂堂先后攀高枝。\n宦游出处五十载，鸾台骥路俱腾夷。\n三公极位固辽隔，五年以长犹肩随。\n公今复主凤门钥，仆亦再抚铜台圻。\n二京相望阻河广，三径不克陪游嬉。\n忽闻干步踵门至，投我十二耆英诗。\n整冠肃貌讽章句，若坐宝肆罗珠玑。\n为言白傅有高躅，九君结社真可师。\n欲令千载著风迹，亟就僧馆图神姿。\n词宗端殿序篇目，滂洒大笔何淋漓。\n眷言履道靡充诎，菟裘近邑将营归。\n敢云绘素得精笔，愿列霜壁如唐规。\n退居旧相国元老，十年还政瀍之涯。\n康宁富贵备五福，灵宝盛气如虹霓。\n昔年大对继晁董，登科赐第同一期。\n紫垣步武既通接，金沙里闬还邻比。\n探禅论道剧训对，摩轧太古穷天机。\n二贤勋业冠朝省，爵齿官学谁依稀。\n今将图画表来世，讵可下客联缨緌。\n既蒙月品定人物，不敢循避违风期。\n况承开阁厚宾客，富有景物佳园池。\n铜驼坊西福善宅，修竹万个笼清漪。\n天光台高未百尺，下眺林岭如屏帷。\n花王千品尽殊胜，风光绣画三春晖。\n六相街中潞公第，碧瓦万木烟参差。\n左隅庙室本经礼，右阁宸翰尊星奎。\n婆娑青凤舞松柏，焕烂素锦薰酴醾。\n石渠飞溜漱寒玉，昼夜竽瑟鸣阶墀。\n伊予陋宇治穷僻，姑喜地广为环溪。\n楼名多景可旷望，台号风月延清晖。\n四时花蘤不外假，拿舟傲帻联嬉怡。\n怀归抚事若饥渴，恨无羽翼西南飞。\n人生交旧贵伦辈，情亲意接心相知。\n岂无晚秀负才蕴，高谈大笑拘礼仪。\n洛中故事名义燕，二毛第一年相推。\n洒冠登仕荷天宠，尊君报国当百为。\n既嗟大耋盍知止，纳禄谢事皆所宜。\n顾方北道倚烦剧，未许解绂披荷衣。\n长篇不令负花约，为指风什歌式微。\n如羹甘露爽心骨，似柄玉麈亲颜眉。\n兰丛虽未长罗宅，菊英似亦思陶篱。\n子山已著小园赋，彦伦犹愧钟山移。\n聊摅短引谢招隐，肯使猿鹤常惊啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春","author":"王拱辰","text":"华发青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王拱辰","text":"棋墅风烟清早夏，禊亭兰茝暗残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至道初元六月不雨为民冒暑乞灵龙湫投辞未竟云气已作雷雨继之","author":"王挺之","text":"欲呼云雨沃焦田，袅袅篮舆入翠烟。\n万仞孤高随鸟道，一潭澄碧快龙眠。\n浮丘黄帝真成道，汉武秦皇谩学仙。\n但愿甘霖慰枯槁，岂知衰朽得神怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄山二首 其二","author":"王挺之","text":"地灵通十洞，山邃宅诸仙。\n怪似龙逢霹，高疑剑倚天。\n岩端锁丹灶，石罅逗温泉。\n却忆登楼堞，徒能见巨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄山二首 其一","author":"王挺之","text":"叠巘障南国，攒峰顶半空。\n朝昏长见日，晴晦预知风。\n树蘖千年在，岚光四面通。\n名山今日睹，奇秀两无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王昭宇","text":"明朝山北山南路，各自逢人话胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌驻道中","author":"王显世","text":"蹲鸱用事谢黄独，木奴弄色陵乌椑。\n落日人行桑柘里，西风雁过稻粱时。\n故山秋晚正如此，游子天寒何所之。\n一笑沙禽忽惊去，水边的皪早横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三闾大夫赞","author":"王柏","text":"爱国忧民感慨深，沅湘浩浩魄沈沈。\n怀沙哀郢成何事，日月争光只此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三衢纪所闻","author":"王柏","text":"青幕红裾忠懿孙，如今流落不堪听。\n丹书铁券山河誓，却与春闺赎滥刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋","author":"王柏","text":"中秋天气似重阳，幸有庭前桂子香。\n书册根边无一事，任他风雨送凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书补之梅","author":"王柏","text":"玉质敷腴宫样妆，风流终愧水云乡。\n一村飞落人间世，添却逃禅百倍香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕独坐","author":"王柏","text":"颇闻灯火闹荧荧，何似书窗一点青。\n尚喜今年民意乐，一般箫鼓两般听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元正 其二","author":"王柏","text":"吟诗犹是少年情，要复当初赤子心。\n心出入时何以御，手持一卷敬斋箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元正 其一","author":"王柏","text":"开正又展一年期，霞脸醺醺酒半卮。\n独坐晴窗无一事，呼童和墨写梅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韦轩游山遇雨","author":"王柏","text":"踏碎羊山黄叶堆，天飞细雨相车回。\n二皇应讶来何晚，不忍听君话别杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰亭记","author":"王柏","text":"风流盛集数兰亭，刻石纷纷岂有真。\n嗟老感时何足慕，千年谁记浴沂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶西庐惠冬菊三绝 其三","author":"王柏","text":"谁知造化用工深，处士陶潜独返魂。\n白发书生留晚节，从今岁岁典刑存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶西庐惠冬菊三绝 其一","author":"王柏","text":"风紧东篱长旧荄，主人杖屦日徘徊。\n后时独立应无恨，少待梅花相伴开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶西庐惠冬菊三绝 其二","author":"王柏","text":"霜天无物不彫残，忽见青蕤羽葆攒。\n欲制颓龄须耐冷，一阳定有落英餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归舟三绝 其三","author":"王柏","text":"幸脱尘氛入帝城，又携幽恨满归程。\n雁行不整关心事，深愧汉人千虑轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归舟三绝 其二","author":"王柏","text":"波声拍枕不成眠，拥被推篷月尚圆。\n霜下夜深人正悄，数声飞雁度林颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归舟三绝 其一","author":"王柏","text":"江边踏月入孤舟，水月流光一片浮。\n夜静海门雷怒吼，潮头冻杀未甘休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白荷花","author":"王柏","text":"玉娥独自到书屏，不管人间暑气深。\n待得诗成花已谢，应无好句惬花心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过赵清献故居","author":"王柏","text":"隐隐数间清献宅，只在城东竹树中。\n龟鹤不知何处去，谁将白鹿继高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其十","author":"王柏","text":"七弦之外数联诗，袅袅炉烟酒半卮。\n岂独对床堪听雨，不如话到月斜时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其九","author":"王柏","text":"楼头小圃径斜通，种竹休教势倚空。\n好是故庐犹在眼，未应脩筱障西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其八","author":"王柏","text":"月满阑干风满衿，浪因景物动清吟。\n钟惊老鹤翻金刹，角引栖鸦投暮林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其七","author":"王柏","text":"未说楼居即是仙，自然高处隔尘寰。\n谁家双鹤鸣清晓，声在东边竹树间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯兄新楼十首 其六","author":"王柏","text":"林间塔影郁苍苍，向晚风传供佛香。\n灯焰万龛时炯炯，恍然文笔吐光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]