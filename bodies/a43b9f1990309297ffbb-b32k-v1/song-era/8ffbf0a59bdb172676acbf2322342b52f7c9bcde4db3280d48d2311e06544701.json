[{"title":"仙游县","author":"刘克庄","text":"不见层岗与复岩，眼中夷旷似江南。\n烟收绿野连青嶂，树阙朱桥映碧潭。\n丞相无家曾住寺，聘君有字尚留庵。\n荒山数亩如堪买，径欲诛茆老一龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰","author":"刘克庄","text":"深林不语抱幽贞，赖有微风递远馨。\n开处何妨依藓砌，折来未肯恋金瓶。\n孤高可挹供诗卷，素淡堪移入卧屏。\n莫笑门无佳子弟，数枝濯濯映阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至二首 其二","author":"刘克庄","text":"慈颜幽翳几星霜，犹记斑衣共举觞。\n老弟颇怜伯仁短，小孙突过阿宜长。\n亲朋不至谙时态，儿女无知竞晓妆。\n老退尚馀忧国念，朝来云物果灾祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至二首 其一","author":"刘克庄","text":"病逢佳节径投床，卧听群儿笑老苍。\n仅可六藏数龟息，安能三黜入鹓行。\n脉微药焙常储火，足冷茅檐定有霜。\n多谢天公相煖热，起披败絮负朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山作","author":"刘克庄","text":"骨法枯闲甚，惟堪作隐君。\n山行忘路脉，野坐认天文。\n字瘦偏题石，诗寒半说云。\n近来仍喜聩，闲事不曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北来人二首 其二","author":"刘克庄","text":"十口同离北，今成独雁飞。\n饥锄荒寺菜，贫著陷蕃衣。\n甲第歌钟沸，沙场探骑稀。\n老身闽地死，不见翠銮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北来人二首 其一","author":"刘克庄","text":"试说东都事，添人白发多。\n寝园残石马，废殿泣铜驼。\n胡运占难久，边情听易讹。\n凄凉旧京女，妆髻尚宣和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北耗","author":"刘克庄","text":"京师渠敢泄边机，北耗传讹果是非。\n不见红旗加露布，颇传黄屋尚宵衣。\n南风不竞师将老，春水方生虏必归。\n何日灵台真偃伯，更无一点战尘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去春","author":"刘克庄","text":"去春烽火照江边，曾草军书夕废眠。\n万里旌旗真属命，一丘耕钓且随缘。\n偶然谢客元非病，间亦寻僧不为禅。\n尚有惜花情味在，铜瓶终日玩芳妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史稿","author":"刘克庄","text":"虽有隆乾手泽传，空疏岂敢望谈迁。\n春秋笔绝经谁续，光岳气分材少全。\n老去汗颜惭巧斲，向来执手付遗编。\n文名史学都休矣，追诵尧言一泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶桂发助教从李用之秘监于潮阳李持节使广部叶辞归福唐小诗话别","author":"刘克庄","text":"贺监空多惜别情，木绵花得似三荆。\n打包便是参禅客，垂橐何须使鬼兄。\n小郭今宁无赵子，四门古亦有欧生。\n南辕不涉贪泉境，归去诗肠彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司令为牡丹集次坐客韵","author":"刘克庄","text":"古人曾道四并难，酒量黄花顿觉宽。\n谁与蔡欧脩旧谱，且为姚魏煖春寒。\n饮狂尚欲簪巾舞，漏尽何妨秉烛看。\n国色老颜不相称，世间何处有还丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叹老","author":"刘克庄","text":"口惟两齿鬓双皤，百计无如耄及何。\n少壮未尝参姹女，衰残始欲养黄婆。\n原鸰逝去床谁对，辽鹤归来冢渐多。\n客笑侬诗真滞货，太平典册要声和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其一","author":"刘克庄","text":"一橐萧然五鬼随，竟缘名盛与文奇。\n可曾天下无麟凤，何必山中有虎罴。\n蜂虿尾犹如许毒，蜘蛛腹得几多丝。\n圣贤不校吾家法，车及蒲骚岂足师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其二","author":"刘克庄","text":"临渊细味心亨坎，卜筑先占地势坤。\n说易何妨遇于野，谈玄亦入妙之门。\n赐金莫惜娱宾客，堆笏犹堪遗子孙。\n不比酸寒杜陵老，破茅草屋傍江村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其二","author":"刘克庄","text":"谁谓斯文无定价，独怜之子坐虚名。\n主司头与笔俱点，宰物心如秤样平。\n骏马却还国西域，病鸱堕落屋东坑。\n老夫谢绝人间事，亦为诸贤喜且惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和","author":"刘克庄","text":"乱书案上慵料理，长物斋中悉屏除。\n乍可假□□□甫，安能佞佛把随如。\n虎皮晚岁羞争席，豹尾当年扈属车。\n冬煖无冰村酒贱，肯来溪上共叉鱼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其三","author":"刘克庄","text":"丁宁僮可沽佳酒，戒饬阍毋纳恶宾。\n种杞菊非求饱者，思莼菜是见几人。\n食甘鲊饭安排易，出驾鸡栖受用贫。\n却笑曹瞒遗令侈，黔娄殓不待衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其一","author":"刘克庄","text":"汉末名臣推北海，邺中才子逊东阿。\n老勤未辍吾伊读，烂醉时为尔汝歌。\n一滴何妨卢行少，五车安重惠施多。\n客来问话巴巴说，君不回头可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其二","author":"刘克庄","text":"白公自号老居士，疏傅史称贤大夫。\n脍鲫不妨留客饮，擘麟何必享天厨。\n清池澡沐端溪石，素壁彰施洛社图。\n帝赐后村奎画在，作堂安用扁青涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和","author":"刘克庄","text":"昔年东观接英游，岁晚南柯各拜州。\n炊黍有时成幻梦，著书自古要穷愁。\n散花魔女聊相恼，□□□□□□仇。\n诏募佽飞求跅弛，与公投笔去防秋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其一","author":"刘克庄","text":"鲸吸仙人饮兴浓，尤嫌恶客懒迎逢。\n逆风弱水三万里，梦雨高唐十二峰。\n诗派相邀容入社，酒泉虽远愿移封。\n葑田毕竟胜高仰，犹可躬耕佐大农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和 其二","author":"刘克庄","text":"删后元来尽有诗，此言莫遣邵程知。\n匹如东土生三叶，横向西江出一枝。\n俚曲俗方尊郢市，古音今少奏咸池。\n谁云老子无呵导，塘上蛙声鼓吹随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和二首 其二","author":"刘克庄","text":"朱门画鼓舞宫靴，应笑狂歌似采和。\n露坐一生无步障，春游是处有行窝。\n绍兴谠议谁当续，元祐全人本不多。\n办取九年同面壁，未应末后话头蹉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和二首 其一","author":"刘克庄","text":"梦魂久不到清朝，纵遣巫咸未易招。\n塞北今惟一韦睿，江南前此几陈乔。\n扶颠个个无长策，排闷时时引大瓢。\n它日松根深掩骨，何须竹帛有名标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四和林卿槟榔韵一首","author":"刘克庄","text":"似椰内贮杯中物，非曲谁篘瓮面春。\n百粤姻盟常主约，三彭谗舌竟无神。\n浪云软饱元枵腹，暂借酡颜戏写真。\n此遣两行红袖去，锦潮亭下草如茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圣贤","author":"刘克庄","text":"圣贤自牧极卑谦，后学才高胆力兼。\n悔赋不妨排贾谊，谤诗遂至劾陶潜。\n取人最忌规模狭，绝物常因议论严。\n君看国风三百首，小夫贱隶采何嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失猫","author":"刘克庄","text":"饲养年深性已驯，攀墙上树可曾嗔。\n击鲜偶羡邻翁富，食淡因嫌旧主贫。\n蛙跳阶庭殊得意，鼠行几案若无人。\n篱间薄荷堪谋醉，何必区区慕细鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失猫一首","author":"刘克庄","text":"周遭闇室工诃夜，偃息朝檐喜曝晴。\n?跳似猴难摄伏，纵擒无鼠敢从横。\n侬贪梦蝶防闲弛，汝薄鱼餐去住轻。\n赤脚苍头俱失察，主君姑息不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对卷","author":"刘克庄","text":"妙在心通与理融，卓然有见是英雄。\n大儒晚作韩考异，往哲曾非墨尚同。\n折角争希郭有道，剃眉求似狄梁公。\n可怜老学孤无助，月落参横读未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"左目","author":"刘克庄","text":"已盲犹赤痛，久不出鸡窠。\n丹荔曾遗毒，青灯亦一魔。\n抛书无味甚，节腹柰馋何。\n二癖依然在，徒劳问眼科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平床岭","author":"刘克庄","text":"一动非容易，三年议始成。\n倩人挑旅橐，买纸劄山程。\n下岭峰如拜，登崖树若迎。\n暂无尘事汩，便觉长吟情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午元日二首 其二","author":"刘克庄","text":"败絮萧然拥病身，久疏朝谒作閒人。\n公卿各趁黄麾仗，宾客谁看乌角巾。\n菱照无情难讳老，杏梢作意已撩春。\n卧闻儿女夸翁健，诗句年光一样新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午元日二首 其一","author":"刘克庄","text":"过去光阴箭离弦，河清易俟鬓难玄。\n再加孔子从心岁，三倍周郎破贼年。\n耄齿阻陪鸠杖列，瞽言曾献兽樽前。\n磻溪淇澳吾何敢，且学香山也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未开梅","author":"刘克庄","text":"老树天机早，潜回一点春。\n寒梢方蓓蕾，玉骨已精神。\n冷淡看前辈，芳菲总后尘。\n更须香共色，未是览花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永嘉曹君赠诗次韵一首","author":"刘克庄","text":"开卷沉吟首屡搔，想提诗律比戎韬。\n清于学士茶烹雪，壮似将军弩射涛。\n再茜三纁由染渍，勺泉卷石可深高。\n蜗庐自笑无卮酒，不得浇君道路劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永嘉黄九万见访","author":"刘克庄","text":"避暑惟高卧，柴门闭不通。\n子来佩明月，予起濯清风。\n有墅犹当赠，无城可得攻。\n灵舒如见问，今作灌园翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉蕊花","author":"刘克庄","text":"竹院过僧话，山门扫地迎。\n英雄犹有迹，般若太无情。\n玉蕊春阴密，琅玕晚暑清。\n半生来往屡，也合送人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜洲城","author":"刘克庄","text":"先朝筑此要防边，不遣胡儿见战船。\n遮断难传河朔檄，修来大费水衡钱。\n书生空抱闻鸡志，故老能言饮马年。\n惭愧戍兵身手健，箔楼各占一间眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日和竹溪二首 其二","author":"刘克庄","text":"暮年量减怯杯深，客饷村醪且浅斟。\n衰惰仅存已残锦，清贫安得未挥金。\n朱弦有味馀三叹，丹扆无阶献六箴。\n留取平生一筇竹，约公遍访大丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生日和竹溪二首 其一","author":"刘克庄","text":"宿昔银鞍狨覆鞯，今骑秧马垦荒田。\n学神仙者丹多坏，立事功人传少全。\n谁管灵均初度日，都忘弥勒下生年。\n新皇早晚开宣室，定有英才对席前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用王去非侍郎韵二首送林元质提干秩满造朝并呈侍郎 其二","author":"刘克庄","text":"叔季滔滔未见刚，每闻健论意差强。\n向来曾劾灯笼锦，老去聊凝画戟香。\n世运横流安所止，圣朝未舍岂容藏。\n几回欲上铃斋谒，衰病无因可去乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用王去非侍郎韵二首送林元质提干秩满造朝并呈侍郎 其一","author":"刘克庄","text":"戍满归来薇亦刚，策名不觉十年彊。\n素无沂国三场志，曾有西山一瓣香。\n晁董未能免科举，孔颜方可语行藏。\n要为天下奇男子，宁论区区国与乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用旧韵赠瑩上人","author":"刘克庄","text":"飞锡应来从鹫岭，卓茅浑未有蜂窠。\n输他灵运先成佛，笑杀僧伽改姓何。\n一半芋甘堪共饱，六如语妙不须多。\n珍公棒喝方行用，肯著诗仙挂搭么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用石塘二林韵 其一","author":"刘克庄","text":"夜绩旁边映隙光，忆曾参扣遍诸方。\n扫眉众女偏谣诼，开口群儿亦谤伤。\n后有知音分雅郑，今谁协律谱宫商。\n戏衫欲脱无人付，诸子披襟直下当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用石塘二林韵 其二","author":"刘克庄","text":"少狂浪走无寻处，晚向深山得悟门。\n火候足时丹始熟，国工琢了玉尤温。\n低头欲下追随拜，摩顶无忘付授恩。\n大有名山要行脚，未甘瓶钵老荒村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其四","author":"刘克庄","text":"辞大丛林卓小庵，岂知捷径在终南。\n狂歌不晓花十八，饿死休贪芧四三。\n汉有子云尤苦思，晋惟逸少不清谈。\n君看尼父生知者，问了苌弘又问聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其三","author":"刘克庄","text":"了无杰句似平庵，谩有高年企渭南。\n铁汉堂堂才望八，铜人嘿嘿久缄三。\n曾传鸿宝枕中诀，厌听狙丘稷下谈。\n画史貌予殊不似，清臞安得耳如聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其七","author":"刘克庄","text":"是处皆堪结草庵，宁论塞北与江南。\n上林远赋讽才一，光范门书献至三。\n麟获鲁西终圣笔，马浮江左坐玄谈。\n古书疑信常相半，何必深疑禦寇聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其一","author":"刘克庄","text":"老禅和筑退居庵，识路何须待指南。\n野叟得年今九九，星翁布算更三三。\n有诗入梦撩灵运，无藁藏山愧史谈。\n愚智同归一抔土，管他后世传非聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其十二","author":"刘克庄","text":"懒访半山云顶庵，且撑一叶泛溪南。\n花间渐觉同游少，桑下何曾作宿三。\n古有刘伶呼不醒，今无卫玠共谁谈。\n五千言是家人语，长笑诸家误注聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其二","author":"刘克庄","text":"先皇亲为扁溪庵，奎画煌煌阳世南。\n多病安知年望九，归耕何幸岁登三。\n新诗有弟聊相属，前事无人与共谈。\n作饮中仙殊不恶，何须苦淡学瞿聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其十三","author":"刘克庄","text":"素昧清真与顺庵，偶然爱唱望江南。\n世因玉佩轻秦七，天把蓑衣贵谢三。\n郢可忧虞成永叹，汉方隆盛勿多谈。\n古今大瞻惟蒙叟，不但诬丘又谤聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其九","author":"刘克庄","text":"无住先生独住庵，得朋犹冀自西南。\n丹心事国忠无二，白首尊师谊在三。\n诗少古风惟近体，学惭实践谩虚谈。\n退之未离乎儒者，坐井观天错议聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其六","author":"刘克庄","text":"岁晚归休老学庵，敢嗟白首滞周南。\n在廷不欠秃翁一，开径宁无益友三。\n地岂长房之可缩，天非邹衍所能谈。\n桓郎狭小胶师说，未必雄书远过聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其十","author":"刘克庄","text":"把茅容膝强名庵，宜夏宜冬户向南。\n雪厄黄精饥杜二，花欺白发笑陈三。\n尔侬柏下已骨朽，此老橘中犹手谈。\n惟有子长赞深远，诸家类以浅求聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其八","author":"刘克庄","text":"临池苫盖钓鱼庵，却笑温生起水南。\n林下休官谁见一，岁寒取友不过三。\n点黄岂有眉间喜，坚白都无舌本谈。\n柱下首阳孰工拙，东方元未识夷聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其十一","author":"刘克庄","text":"春困齁齁卧蝶庵，欠伸跳出大槐南。\n漂摇不借乌栖一，迂拙羞营狡窟三。\n投辖孟公方痛饮，惊筵焦遂勿高谈。\n谷神若果能无死，秦失何由却吊聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用厚后弟强甫韵 其五","author":"刘克庄","text":"不腆先畴与破庵，在汾水曲管岑南。\n幽栖晚节巢林一，戆草当年及□三。\n酒瓮有期春共酌，书囊无底晓犹谈。\n吾悯紫气难瞻瞩，未暇攀迎柱下聃。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用洪君畴韵送徐仲晦赴乡郡二首 其二","author":"刘克庄","text":"传闻君相奖清修，印节移来某水丘。\n范孟博非私奏劾，祁大夫不避亲雠。\n青黄未接宜开廪，红腐无多谩唱筹。\n事尚可为君努力，明时未好说归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用洪君畴韵送徐仲晦赴乡郡二首 其一","author":"刘克庄","text":"君于外物一毫轻，七聚争看锦昼行。\n昔苦缿筒无路达，今欣蜡烛照天明。\n潢池赤子思重活，青社饥民待再生。\n前哲贵分人以德，独清不若众皆清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用曹帅侍郎韵赠曹路分","author":"刘克庄","text":"曹侯书满腹，非以剑防身。\n马上檄尤速，橐中诗不贫。\n虏情工变诈，时论主和亲。\n旗鼓何时建，方知国有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其十","author":"刘克庄","text":"先生拟把衣冠挂，稚子能操杖履从。\n叔夜只堪伴鱼鸟，子云何至况蛇龙。\n豹皮尚欲留名死，鸡肋安知与怒逢。\n老去自鸣还自止，篑桴何敢间金钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用强甫蒙仲韵十首 其九","author":"刘克庄","text":"已傍先庐敞便斋，善和万卷与君偕。\n少时岁月真驰隙，圣处工夫未涉涯。\n海浅蓬莱疑可近，云深阊阖不容排。\n信书至老成何事，有酒聊浇磊块怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]