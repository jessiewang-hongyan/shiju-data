892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谭贺州勉赋水仙花四绝 其三","author":"曾丰","text":"高固难为太素容，卑还恶紫又羞红。\n柔黄软白交相混，色一归于正与中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谭贺州勉赋水仙花四绝 其四","author":"曾丰","text":"玉女琼姬暂谪居，水中无可与为徒。\n莲花固与六郎似，贞女终轻贱丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谭贺州勉赋水仙花四绝 其一","author":"曾丰","text":"会逢青帝欲回春，先与梅花清路尘。\n自别其衣黄一点，示吾不敢与兄均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谭贺州勉赋水仙花四绝 其二","author":"曾丰","text":"与水相蒸暖盎春，湘妃洛女是前身。\n乘风香气凌波影，挑弄眠冰立雪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章上游江中有道观盖尸坚吾游仙之地 仙州","author":"曾丰","text":"弱水空传三万里，瀛洲只隔一重关。\n渡船莫傍梅花岸，岸上吾疑是世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章上游江中有道观盖尸坚吾游仙之地 涌月","author":"曾丰","text":"水色月华俱受清，藏中各自有光明。\n夜来相遇影相射，幻我黄冠老眼晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章上游江中有道观盖尸坚吾游仙之地 濯风","author":"曾丰","text":"净蜕凡身一羽轻，安排两脚踏长鲸。\n忽逢一阵风吹送，直溯紫虚凌太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三生图","author":"曾丰","text":"闲去闲来自在嬉，故人不记问于谁。\n都来一个真消息，安用频更可漏为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题水牯庵 其二","author":"曾丰","text":"三十馀年不踏泥，其如犹有角和蹄。\n何当纪渻重驯养，四十日间如木鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题水牯庵 其一","author":"曾丰","text":"尧自牵牛舜著鞭，虽劳未必适牛天。\n君今驯养犊成牯，饱卧太虚游自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邓保章真 其二","author":"曾丰","text":"费尽精神星斗间，若为犹剩落毫端。\n吾真更在此真外，收拾清明反自观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邓保章真 其一","author":"曾丰","text":"旧以书生新保章，衣冠法合改其常。\n中年不觉青衫好，暇日宁从野服强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨补之梅 其二","author":"曾丰","text":"竹篱茅舍养吾清，正恐人间识姓名。\n毛颖传神偶相似，争先快睹辄倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨补之梅 其一","author":"曾丰","text":"风流青帝欲回春，先遣玉妃清路尘。\n过眼被渠偷笔写，虽忙犹得九分真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐子比独秀亭 其二","author":"曾丰","text":"之子于人第一流，于山也独拔其尤。\n高亭未与山相称，直起元龙百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题徐子比独秀亭 其一","author":"曾丰","text":"邻山三五百为曹，气伏心降让我高。\n独秀不知为独秀，退然自视一秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题悟性寺卧云堂呈源上人 其三","author":"曾丰","text":"渠侬高卧傲吾徒，不道吾徒反傲渠。\n渠不得云无卧处，吾元自与太空俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题悟性寺卧云堂呈源上人 其二","author":"曾丰","text":"一片闲云逗半空，僧闲况复与云同。\n梦中不向华胥路，直出无何入大通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题悟性寺卧云堂呈源上人 其一","author":"曾丰","text":"僧与白云同住山，梦同云出觉同还。\n勿移枕席下堂去，堂下吾疑是世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儒家子刘宗庆发披戴愿赠二绝句俾藉之以谒乐于成人之美者 其一","author":"曾丰","text":"走俗何如学步虚，出家犹欠护身符。\n凭谁成就奇男子，径自归投大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儒家子刘宗庆发披戴愿赠二绝句俾藉之以谒乐于成人之美者 其二","author":"曾丰","text":"未得黄冠换白襕，不妨持钵乞坛间。\n要还少室山人愿，须破多金长者悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠术士","author":"曾丰","text":"相主吕公医主卢，色身色相莫逃渠。\n新离有色入无色，果到吾前口自呿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠玉牒道人 其二","author":"曾丰","text":"过情君勿许迁除，屈指吾年六十馀。\n晚景固犹多暇日，全工仅可了残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠玉牒道人 其一","author":"曾丰","text":"神融气会李淳风，收拾乾坤风鉴中。\n莫怪人前言者中，何逃物外眼之空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠庐陵笔工萧昶","author":"曾丰","text":"作成大小几毛公，妙出毫釐入大通。\n贮雾含云策勋后，藏锋戢颖豹囊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠画工怀玉","author":"曾丰","text":"撙斋一味好哦诗，试看传神笔是非。\n虽得掀髯搜句状，更参会意点头机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠画师韩晖 其二","author":"曾丰","text":"工于绘事讳言工，韩滉心宁与俗同。\n恶语发挥非敢惜，所疑不是子家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠画师韩晖 其一","author":"曾丰","text":"史遑法外有遗机，难弟难兄似得之。\n信意麾毫无点误，蝇成于点误还奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]