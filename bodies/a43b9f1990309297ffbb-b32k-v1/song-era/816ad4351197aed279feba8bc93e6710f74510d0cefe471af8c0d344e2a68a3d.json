[{"title":"赵虞仲过仙岩以诗见寄答之","author":"许景衡","text":"十年归梦在江湖，今日南飞塞雁孤。\n已觉登临多感慨，固应吟咏转荒芜。\n近闻仙岭寻先友，亦有诗筒及老夫。\n还许追随白莲社，横塘今已结茅庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"焚香蓝帐中酷似梅花","author":"许景衡","text":"江南腊雪不到地，六出枝头也逼真。\n万里塞垣从簿领，五年驿使绝音尘。\n谁知斗帐回残梦，却有炉烟作早春。\n草木无情聊假合，谢他知有个中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵戴禹功父子游灵隐","author":"许景衡","text":"闻道飞来太怪生，薄游聊与问山名。\n陀罗布影于中好，笃耨飘香分外清。\n猿在僧呼虽旧事，鹤鸣子和亦真情。\n晚来归路还潇洒，袅袅青烟十里城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和戴尧卿游灵隐","author":"许景衡","text":"云房相与话浮生，此乐须知未易名。\n释子命题良有自，老人琢句得能清。\n倚天楼殿三吴胜，落日湖山万古情。\n诗社若容追故事，未饶五字有长城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰春作","author":"许景衡","text":"香火祠庭即隐沦，谁知未许作閒人。\n一抛夜雨横塘宿，三见东风石液春。\n当宁照临齐日月，馀生报效绝涓尘。\n尚宽九死怜多病，乞与江湖自在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡继道伤春","author":"许景衡","text":"游车轣轣不停轮，红日迟迟展得春。\n莫问年光催老速，且看风月逐时新。\n田园未信无来客，云水从今愿卜邻。\n预想渔村往还处，野航何止两三人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上时相寿五首 其一","author":"许景衡","text":"閒看暖律几时回，已觉阴云四面开。\n万物定知春色近，三台今引岁星来。\n竞拈彩笔题诗句，端为苍生祝寿杯。\n师保从来周召事，直须两两位公槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上时相寿五首 其二","author":"许景衡","text":"年年燕喜倍光荣，兰玉称觞满相庭。\n信宿尚馀元夜月，上台却是老人星。\n包荒度量侔河岳，盖世功名在典刑。\n一语堪为我公寿，圣贤相与合千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上时相寿五首 其三","author":"许景衡","text":"清净端为物外仙，经纶犹有世间缘。\n坐令四海浑无事，付与群生大有年。\n南极老人今日见，西楼明月夜来圆。\n吾君万寿公同德，绿发朱颜照冕蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上时相寿五首 其四","author":"许景衡","text":"槐庭三入妙经纶，百度分明又一新。\n上欲无为成至治，天教难老为斯民。\n川涂荡荡初消冻，草木欣欣各自春。\n谁信尘埃尚羁旅，四年企首望洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上时相寿五首 其五","author":"许景衡","text":"上帝分明悯下民，挺生贤杰在斯辰。\n莲华叶上青髯老，萱草堂前艳蕊春。\n尽阅搢绅归藻鉴，频教动植入陶钧。\n古来多少调羹手，独见缁衣有世臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄敏叔寺簿诗","author":"许景衡","text":"海角纷纭祇簿书，朅来不觉一年馀。\n自嗟扰扰无休息，犹及匆匆问起居。\n前日先生官独冷，而今主簿意何如。\n应怜小女犹痴在，只喜腰间已佩鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺生日诗","author":"许景衡","text":"庆系来从沁水园，勋门妇德众称难。\n旧闻孟母无欺语，新得嫦娥不老丹。\n行见綵衣添衮绣，更饶文砌拥芝兰。\n却须剩种黄金菊，留待年年献寿看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德起惠酒","author":"许景衡","text":"横塘今作小塘居，斋几萧然一卷书。\n心事蹉跎嗟老矣，天涯流落念归欤。\n尚烦亲好频携酒，多谢园人日饷蔬。\n此境从来无远近，祇应在处是吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韦尉画孙倅宝冠山图","author":"许景衡","text":"问著蜡屐到何处，直在宝冠山上头。\n碧涧坐来元洒落，彩毫画得便风流。\n公方得志人间世，我亦长思物外游。\n一幅须寻好东绢，閒人亭畔倩韦侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仲焕入颍诗","author":"许景衡","text":"好个石城无分到，问君此去意如何。\n一江春水竹叶酒，万点青山佛髻螺。\n闻道楚宫俱泯灭，祇应郢邑亦疑讹。\n直须索取图经看，莫只听他白雪歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送西京宗博林茂南赴乌程","author":"许景衡","text":"才名自昔等三张，阅骏无人似九方。\n金谷园中辞绮席，水晶宫里奏清商。\n割鸡正好师言偃，歌凤多应笑楚狂。\n未信江湖留得住，凌云头角老昂藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"敏叔浮梁诗有放教明月上扁舟之句因成小诗","author":"许景衡","text":"几年浪作红尘客，明月扁舟不自随。\n忽得浮梁好诗句，却思望柱旧家时。\n烟蓑雨笠多应在，利径名场两不知。\n会有功成身退日，不烦猿鹤怨归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与言叙己卯之别","author":"许景衡","text":"放逐归来梅子真，江边无限送行人。\n千钟桑落开新酿，十里梅花正早春。\n邂逅喜君方筮仕，经过嗟我倍思亲。\n惊回十二年前梦，陈迹依然泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兄长省试下第还乡以不及顾拊景衡于此情见于诗谨次韵","author":"许景衡","text":"江边送我赴瀛洲，风物萧萧又见秋。\n百岁能禁几回别，此生已是十年愁。\n塞鸿自觉东南远，汴水谁教日夜流。\n泪湿西风知有寄，尘沙漠漠漫回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刚巽还乡","author":"许景衡","text":"问君谒告还乡曲，来往涂程得几时。\n莫怪杯盘能草草，只缘行李弗迟迟。\n路从雁荡灵山好，秋入鸰原草树衰。\n京国艰难同旅食，而今莫遣老人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵戴禹功游净梵退居","author":"许景衡","text":"泮宫人物最清修，杖履时寻水石幽。\n已听老僧谈出处，更邀逐客共赓酬。\n浮云过眼空千古，巨浸观身袛一沤。\n风彼舞雩宜有得，圣门更欲与公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宁节上寿紫宸退诣相国寺祝寿宴尚书省","author":"许景衡","text":"霜天宫阙九门开，共献君王万寿杯。\n善祝歘来倾宝刹，赐筵还许燕中台。\n乐连百戏鸳鸯集，花覆千官锦绣堆。\n说与伶伦逢此日，年年长赋醉蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈文仲嘲梦","author":"许景衡","text":"天公真个解撩人，不独虚名老搢绅。\n闻道高眠閒白日，也教幽梦落红尘。\n此生出处元无意，平日文章漫有神。\n百岁都来如一觉，却须嘲取自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳八月二十九日宿内府梦过村落循溪而行问路旁人家此云何曰士村也涉溪入山崦谓同行曰此可赋诗因得鸠燕二句既觉足之以为异日之观","author":"许景衡","text":"杖策徐行山水间，天然新句得非难。\n鸣鸠报雨天欲晓，紫燕哺雏春尚寒。\n物外胜游方自适，枕边幽梦忽惊残。\n士村他日寻陈迹，却记曾为内府官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦诗郭荀卿见和次韵","author":"许景衡","text":"溪水泠泠溪上轩，登临谁道四并难。\n当年髣髴梦仙坞，今日分明在广寒。\n还忆鸠鸣云色重，似闻鸡唱漏声残。\n刻舟已有新诗句，流落何妨作外官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋冬思家","author":"许景衡","text":"钩帘危坐思悠悠，疏雨知人特地收。\n明月清风孤馆夜，寒砧短笛异乡秋。\n我生志气谁相许，何日身心得自由。\n极目长天山隔断，吾家不见白云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李仔主木场寨","author":"许景衡","text":"塞垣人物岂寻常，推择而今属庙堂。\n戚里从来有名将，家声当复振诸郎。\n古陂解冻干顷碧，官柳惊春一拂黄。\n下马也知无个事，蓼花诗兴自难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵曾光叔昙县尉","author":"许景衡","text":"我今自笑菌生庵，才读君诗舌本甘。\n未暇清修齐腊八，要陪游冶趁春三。\n极知世外交从好，却厌尘中富贵酣。\n溪老绝无名利念，不谋耕凿即渔蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张县丞贺三贡士","author":"许景衡","text":"贡籍初登郡学生，海隅草木也欣荣。\n一乡三秀真希阔，大笔千言岂猥并。\n乐育从来推绛帐，作新何止换丹楹。\n会看腾跃如夫子，淡墨高高揭姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世綵堂","author":"许景衡","text":"菜子斑衣祇一身，未如今日剑溪滨。\n一门纯孝非无种，百岁高堂更有人。\n饶得云孙千指盛，知他间世几番新。\n太平佳话君休惜，洗我从来两耳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈仲山 其一","author":"许景衡","text":"当年抱疾题新句，老岁支离已可嗟。\n官学半生浑似梦，尘埃两眼渐生花。\n相从杖屦非无意，归去田园亦有涯。\n袛许刀圭振疲苶，与公白首醉流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈仲山 其二","author":"许景衡","text":"劳劳苒苒任年华，何用逢春苦叹嗟。\n但得千钟倾竹叶，不妨一笑为桃花。\n麒麟莫问行天路，鱼蟹从今饱海涯。\n祇恐爱閒成痼疾，却须妙手泛丹霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈仲山 其三","author":"许景衡","text":"昏昏烟土客京华，节物惊心祇自嗟。\n一饱徒饕太仓粟，十年不见故园花。\n躬耕舒啸今方决，卜筑横塘尚未涯。\n夫子元无疗饥药，待从方士饭朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张敏叔","author":"许景衡","text":"寿春太守紫髯翁，忆得当年笑语同。\n应为江山尽诗助，更无音信问途穷。\n簿书觑著钤斋静，棋局拈来蜡炬红。\n也待去为樽俎客，却怜身世尚漂蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴行可","author":"许景衡","text":"忆昨扬旌过水滨，一樽灯火夜相亲。\n边城喜有笑谈顷，乡路谁知梦寐频。\n山驿梅花初破腊，池塘草色稍回春。\n新年持节经行处，亦许孤灯续后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王经国","author":"许景衡","text":"曾陪诞节祝尧年，过眼星霜岁又迁。\n谁信江湖閒钓艇，却来霄汉听钧天。\n锦筵乐事今何似，蓬鬓苍颜独惘然。\n还戴赐花残照里，九衢尘土醉摇鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄文通","author":"许景衡","text":"俗流指笑漫喧喧，好古初心自惘然。\n已分平生有书癖，况堪此日识碑颠。\n万金尽散英豪外，千卷仍存六一编。\n洗眼何时拂尘箧，待将点画较精研。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄薛克勤","author":"许景衡","text":"高才犹佐古诸侯，樽俎时时好献酬。\n万物也知皆有役，此身安得不言休。\n烹鲜未觉民难治，炊黍犹忻客少留。\n会看曲台须旧德，讨论文物尽从周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄敏叔","author":"许景衡","text":"匆匆候馆陪欢笑，别去而今又几年。\n冠盖由来在天上，音书还肯寄江边。\n也知官长多诗句，未省谁人与酒钱。\n近日频频看除目，诸公要路亦腾骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴鄞县","author":"许景衡","text":"吴郎人物最雍容，不坠家声浙水东。\n辇寺昔曾酬雪唱，道山今独倚秋风。\n簿书又报三年满，樽俎何当一笑同。\n卷尽暮云天更阔，放教醉眼送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旧有诗寄左与言兼呈刘元礼今因寓此仍用前韵寄刘","author":"许景衡","text":"东行长忆过新楼，衣綵题诗赠李舟。\n千里尚歌公惠政，十年谁念我重游。\n雨馀三洞云俱散，水落双溪月自留。\n莫恋城南好泉石，斯民属意富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"左崇见寄以郑虔张籍见况","author":"许景衡","text":"忆向栖霞宫里宿，论文独喜子相过。\n酒酣尚觉初心在，岁晚其如别思何。\n官比广文还较冷，诗疑司业不争多。\n友生许予尝如此，更问旁人果似么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄左经臣","author":"许景衡","text":"二年南邑好相看，谁道忘形最较难。\n别去光阴惊倏忽，春来书讯喜平安。\n如何柳市多时住，不向横塘一笑欢。\n节物悭人诗兴懒，多应閒处凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依虞仲韵寄刘元礼","author":"许景衡","text":"先友相从古所惇，杖藜当日喜盘桓。\n云泉何啻千年别，尘土长怀一笑欢。\n但扫劳心身后事，何须天地掌中观。\n果容怜念如前约，卜筑从今始苟完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李彦益过景城以诗寄之","author":"许景衡","text":"闻说安仁过东县，却撩梅福欲归心。\n画船长是半日到，秋水而今几尺深。\n人散渡头飞鹭下，月明波底老龙吟。\n一杯相属知何日，驿路蝉声急暮林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵寄卢行之三首 其一","author":"许景衡","text":"万叠遥山锁暮烟，一江秋水渺连天。\n凭栏正是滕王处，下榻谁知孺子贤。\n闻道白鱼方切玉，更饶黄雀正披绵。\n一樽吟啸无馀事，说著尘埃却可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵寄卢行之三首 其二","author":"许景衡","text":"莫厌喧哗近市廛，且欣空阔对江天。\n挥毫曾不靳珠玉，列斝何须问圣贤。\n南浦西山云漠漠，夕阳芳草思绵绵。\n飞笺远寄京尘里，多谢星轺尚见怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵寄卢行之三首 其三","author":"许景衡","text":"扑扑金猊嘘白烟，峨峨画阁插青天。\n杯盘洒落有馀韵，翰墨风流追昔贤。\n远岫长堆翠羽被，晚霞碎拍胭脂绵。\n铜章更有诗家子，横写绪馀犹可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李圣与","author":"许景衡","text":"李侯自是金闺客，奔走人间三十年。\n未信簿书能老我，何妨诗酒自陶然。\n江山满眼应相助，风月关心最可怜。\n解道清陂新过雨，也教别乘愧前篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄成正仲","author":"许景衡","text":"画绣初乘八月槎，肯来一笑子真家。\n狂吟取次还成轴，戏酌无多已过花。\n陈迹悠悠惊梦寐，劳生扰扰叹长沙。\n遥知高会还思我，共唱江天一抺霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄行之 其一","author":"许景衡","text":"城南城北长嫌远，卜得甘泉坊里居。\n笑语不愁归去晚，往还可似向来疏。\n二毛自觉身将老，一别谁怜岁又除。\n定是乌银正忙里，怪生没个寄来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄行之 其二","author":"许景衡","text":"问讯卢家大小僧，忆渠旅思为消凝。\n春禽言语得能好，秋水精神更乞增。\n今日垂髫且嬉戏，他年鼓翼看飞腾。\n悬知父党无能解，头白丝丝面有棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄仲山","author":"许景衡","text":"城郭长时厌还往，却来郊外饱经过。\n故人一别已多日，春色三分今几何。\n山鸟无端劝沽酒，林莺取次亦能歌。\n花边欲作当年醉，望断东风十里坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄俞清老","author":"许景衡","text":"寒栖岩谷古浮邱，曾约同为汗漫游。\n十载光阴如梦觉，半生簿领尚桴浮。\n楼头红日半规晚，眼里青山万点愁。\n淮水悠悠从此去，试凭双鲤到扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄木尉君任","author":"许景衡","text":"江湖萍梗漫流连，邂逅天涯独慨然。\n老去鲍昭非俊逸，古来梅福是神仙。\n一樽笑语浑如梦，两地音尘动隔年。\n有底楼台堪寓目，平芜千里夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宋国宝 其一","author":"许景衡","text":"问君何日过留都，想见初寒尚在涂。\n一去尘埃事奔走，归来门巷更荒芜。\n声名尽欲倾时辈，贫贱今方见丈夫。\n勉矣此生忠与孝，扁舟未好问江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宋国宝 其二","author":"许景衡","text":"画船重过谷城闉，撞著人人问子真。\n闻道诗书元有意，莫嫌州县尚劳神。\n一樽何日能如约，五斗而今亦为贫。\n关塞尘沙骑瘦马，故园花柳一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题叶家双莲亭","author":"许景衡","text":"鸳鸯也是池中物，何似芙蕖出水新。\n独蕊应惭今夜月，群花空占别时春。\n恭惟陶冶归元圣，闻道丹青忆老臣。\n更向东郊看合颖，我曹今作太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代书寄福清王居士","author":"许景衡","text":"前日匆匆问起居，此心耿耿复何如。\n身从驿骑三千里，人在天涯八十馀。\n自是浮云有南北，谁知明月满空虚。\n半生俯仰今尘土，安得从容扣草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈节秀才失目赠之兼简卓罗源","author":"许景衡","text":"何事诗翁遽失明，朋游相对泪纵横。\n祇应药石犹能疗，肯与风光便隔生。\n老去篇章方得意，春归梅柳最关情。\n风流密令云孙在，雪唱何妨屡寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐寿驿诗","author":"许景衡","text":"迢迢古驿倚城隈，使者当年几往来。\n慨慷谁无致君意，急难方见济时才。\n自知敌气终须慑，更觉天书不浪开。\n堂上遗尘何处去，太平父老独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和侄邦彦登道山亭诗","author":"许景衡","text":"缥缈三山海上州，登临便觉压鳌头。\n风云出没千寻塔，烟雨溟濛几叶舟。\n嶷嶷朱颜方照日，萧萧霜鬓独惊秋。\n人间荣悴何须较，且把吟笺敌酒筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]