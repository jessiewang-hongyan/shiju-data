[{"title":"醉中戏次师言韵兼简少逸 其三","author":"李彭","text":"往日风流京兆眉，却穿习薄败荷衣。\n新诗浑作莺花语，只欠天街便面归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中戏次师言韵兼简少逸 其四","author":"李彭","text":"愧乏金椎控颐手，偷儿何苦向人来。\n囊空四壁亦云静，祇有丹铅勘玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟过炭妇兼怀微公之句 其一","author":"李彭","text":"阿连冲晓绝江濆，惊起江汀鸥鹭群。\n不为营巢祇觅句，真成拄颊玩幽云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟过炭妇兼怀微公之句 其二","author":"李彭","text":"头陀云外见遥岑，争似欧峰云物深。\n想见伊蒲欲为供，波生茗盌憩墙阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟幽园即事 其一","author":"李彭","text":"万事向来元不理，非关轩傲故相违。\n幽园把菊初无恙，未叹将芜胡不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟幽园即事 其二","author":"李彭","text":"孰知卜筑野人居，饱听邻钟与粥鱼。\n便觉悠悠云入座，只无㶁㶁水鸣除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵正平见赠道予游山北胜处 其一","author":"李彭","text":"山南山北似壶天，雨宿风餐近日边。\n噭噭猿啼石门路，此身浑是谢临川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵正平见赠道予游山北胜处 其二","author":"李彭","text":"佳句全胜顾虎头，千岩万壑斩新秋。\n归来把玩无穷意，始信遥天寄客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟五绝句 其一","author":"李彭","text":"远韵会须真迈往，高怀那用太分明。\n病夫阅世盖多矣，说病由来非妄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟五绝句 其二","author":"李彭","text":"草际窗间蟋蟀鸣，愁来无路敌方城。\n却怜郢客悲秋赋，强使微云滓太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟五绝句 其三","author":"李彭","text":"谷水为帘映暮山，珂珠贝玉妥天关。\n传闻小陆同支遁，游戏苍崖钜壑间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟五绝句 其四","author":"李彭","text":"沙鸥日日满蘋汀，白发忘机不复惊。\n何处暮帆来浦口，背人飞带唤雏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵九弟五绝句 其五","author":"李彭","text":"橘花漠漠玉花深，屡起微霜落瓜心。\n喜有青黄著篱落，千头未羡满寒林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭尚书墓 其一","author":"李彭","text":"过家上冢非无子，宿草孤坟独可悲。\n赖有立朝庄语在，不劳谀墓作铭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭尚书墓 其二","author":"李彭","text":"种竹当年语尚新，藏山万卷总成尘。\n牙签知落谁家去，往事凄凉欲损神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居四首 其一","author":"李彭","text":"鸡林磨衲度帻沟，海外风烟在上头。\n箴孔线蹊谁善幻，千岩万壑斩新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居四首 其二","author":"李彭","text":"悬崖怒瀑落龙湫，恰似王师破蔡州。\n续蔓沈竿空莫测，石鱼酒舫未应求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居四首 其三","author":"李彭","text":"坏衲槃跚玉涧翁，负霜秃鬓颊暾红。\n时时口占东坡语，顿觉曹刘力未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游云居四首 其四","author":"李彭","text":"冉冉山云低度墙，涓涓流水响长廊。\n不缘抱病关鬲冷，早赋式微缘底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄郑禹功魏虞卿 其一","author":"李彭","text":"杖藜徐步倚柴扉，园柳青青马尾垂。\n日暖游丝萦落絮，黄鹂衔得上高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄郑禹功魏虞卿 其二","author":"李彭","text":"众草风来俱掩冉，惊红骇绿斗年芳。\n崇兰秀发北窗下，燕坐时闻自在香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄郑禹功魏虞卿 其三","author":"李彭","text":"苦忆苕溪郑广文，足惊豪翰独超群。\n山南饱看懒行县，笑杀无心出岫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄郑禹功魏虞卿 其四","author":"李彭","text":"虞卿再见封万户，三语掾曹驹伏辕。\n北海会须加慰荐，横空一鹗看腾骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧子植寄建茗石铫石脂潘衡墨且求近日诗作四绝句 其一","author":"李彭","text":"宝犀新胯面岩冷，碾出壑源春雪花。\n何用纤纤捧渠椀，绝胜片片勺流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧子植寄建茗石铫石脂潘衡墨且求近日诗作四绝句 其二","author":"李彭","text":"良工刻削类方城，煮茗细看秋浪惊。\n未许儿曹轻度量，岂容奴辈笑彭亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧子植寄建茗石铫石脂潘衡墨且求近日诗作四绝句 其三","author":"李彭","text":"苍崖绝壁长琼腴，灵府烦蒸藉扫除。\n老楮群鸡甘下箸，乖龙左耳避珍蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧子植寄建茗石铫石脂潘衡墨且求近日诗作四绝句 其四","author":"李彭","text":"远灶积烟烟更多，绝人妙手不同科。\n萧郎饷我客卿辈，远愧山阴书换鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川诸旧兼悲二谢 其一","author":"李彭","text":"晏如雅赡志沈郁，诗语松风万壑哀。\n皮里阳秋能刺举，眼边青白兔嫌猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川诸旧兼悲二谢 其二","author":"李彭","text":"董侯本是古沈冥，风味澹然云水深。\n见说修门和气满，何用涉江歌采菱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川诸旧兼悲二谢 其三","author":"李彭","text":"何侯嗜学黄鹄举，谢客哦诗丹凤鸣。\n急雪异时登拟岘，放歌何日酌宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄临川诸旧兼悲二谢 其四","author":"李彭","text":"半岳摧峰怜二谢，孤坟宿草已蒙茸。\n自叹蔡邕今老矣，铭言独不愧林宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄何氏兄弟 其一","author":"李彭","text":"病语无心复惜秦，护持白业五台宾。\n往时赤壁好风月，俱助两郎诗句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄何氏兄弟 其二","author":"李彭","text":"青州从事懒行县，白水真人不造门。\n时作药山遮眼计，寻僧煮茗过祇园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵山谷寄贺铸 其一","author":"李彭","text":"平生贺监毛发古，风流啸咏付衔杯。\n赖尔云孙亦不恶，山阴气味唤仍回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵山谷寄贺铸 其二","author":"李彭","text":"淮海维扬万人杰，松吟宰上不能杯。\n虽无横州过秦论，犹有清歌慰九回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客庐山道中寄中上座 其一","author":"李彭","text":"溪山轩豁逐时新，草树欣欣雨后春。\n弄水看山添野兴，可怜鱼鸟自相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客庐山道中寄中上座 其二","author":"李彭","text":"著行官柳拂人低，勾引风光挽客衣。\n正是斜川春事起，翻思戴月荷锄归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客庐山道中寄中上座 其三","author":"李彭","text":"紫霄独立冠遥岑，静爱云无出岫心。\n见说危梁耿大壑，欲招惠远与同寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颜鲁公祠","author":"李彭","text":"心正能令笔不攲，银钩犹冠古今奇。\n凛然一代英灵气，犹似当年骂贼时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻寺遣兴三绝句 其一","author":"李彭","text":"蛮花簟冷春气分，午醉醒寻野寺门。\n黄落远林供倚杖，却疑残照是朝暾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻寺遣兴三绝句 其二","author":"李彭","text":"映阶駮藓漫层层，古柏连蜷上老藤。\n梵鼓粥鱼今落莫，半归官焙半残僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻寺遣兴三绝句 其三","author":"李彭","text":"修源一带碧湾环，上有江西淡伫山。\n便觉心尘双寂寞，不愁骑省鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴兼寄豫章二弟 其一","author":"李彭","text":"国士无双有山谷，斗南独步忆秦郎。\n鹦鹉洲前多胜日，古藤阴下夜何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴兼寄豫章二弟 其二","author":"李彭","text":"独持杯杓酹先酒，遗我此物忘百忧。\n乞灵鲍谢共倾倒，况复隔窗悬玉钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴兼寄豫章二弟 其三","author":"李彭","text":"龙沙季子在原乐，不肯附书黄耳来。\n滕王阁上觅佳句，铁柱观头行几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其一","author":"李彭","text":"倦听戍鼓击铜龙，卧待当轩叶底风。\n暝鸟忽穿明月去，直疑便面写归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其二","author":"李彭","text":"左界明河夜未央，轻风洒面作微凉。\n藏舟枉渚者谁子，欸乃歌声短复长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其三","author":"李彭","text":"纷纷著作能上马，衮衮紫微俱斲窗。\n韩侯遽绾铜章去，岂坐双流带二江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其四","author":"李彭","text":"我觏之子秉周礼，要使诸儒识汉仪。\n侧席求贤天子圣，未容泽畔吊湘累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事 其五","author":"李彭","text":"眼看花雾共衣霏，已有群莺窗上飞。\n心事但随春事尽，钟声更伴鸟声微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉书 其一","author":"李彭","text":"酴醾夺目表春馀，閒雅雍容亦甚都。\n睥睨园林众芳歇，持觞耐久作欢娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉书 其二","author":"李彭","text":"稚子满林春笋生，残花老境尚多情。\n潇洒封侯真有自，奇姿未让惑阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉书 其三","author":"李彭","text":"湛湛胸中万顷陂，翻疑浅器是牛医。\n从来未许愁知处，顾肯因愁移面皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送淳轼二上座 其一","author":"李彭","text":"密掩柴门断还往，道人履迹破苍苔。\n青灯相对语离夜，况复打窗风雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送淳轼二上座 其二","author":"李彭","text":"上人定自有佳处，眉宇翠气连湖山。\n烟边候雁著行急，力挽不留相与还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫兴 其一","author":"李彭","text":"真牧堂前花草新，舍南移就一番春。\n非关瘠鲁欲肥杞，直恐强齐将弱秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫兴 其二","author":"李彭","text":"梅花冷蕊发疏枝，云断天南放日晖。\n乱折寒柯有双鹊，衔将缀作百家衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翻经台","author":"李彭","text":"五千馀卷在高台，内史翻时腊屐来。\n梦断池塘人不见，年年春草绿成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽园风雨","author":"李彭","text":"妙手春工如画史，鹅溪百幅挂城隅。\n却将李成骤雨笔，掩映边鸾花鸟图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹间两绝句 其一","author":"李彭","text":"鸟声催得青春老，花气浑忘白发新。\n谁复能寻三径友，信知真是五台宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹间两绝句 其二","author":"李彭","text":"何许晚钟烟雨馀，花间蛱蝶舞蘧蘧。\n莫将绝壑漱流齿，戏诵文园封禅书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自西林投宿归宗","author":"李彭","text":"江都著足写馀酣，颇怪朝晖变夕岚。\n我与诸峰俱是画，解随归鸟过山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏鍊师四松画轴","author":"李彭","text":"四松在涧壑，岁晚乃更奇。\n萧然如黄绮，傲岸不可追。\n谁将谈天口，掉舌聊见移。\n由来拂东绢，写此霜雪姿。\n便有松上雨，催我窗间诗。\n翻思斸青冥，采药堪扶衰。\n当年丹青手，开辟造化随。\n既有圯下约，子行何后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐叔明校书篆笔奇古复善丹青为予作汉江暮霭扇材极妙力求鄙句作此以赠","author":"李彭","text":"曩时徐骑省，篆古逼秦相。\n后来得仍孙，毫端溟渤壮。\n能回顿挫姿，丹青生意匠。\n馀酣写便面，万里烟莽苍。\n何许捕鱼郎，落日荡双桨。\n无劳剪吴淞，安用买叠嶂。\n真欲老是间，尘境孰非妄。\n怜君俱入妙，简远复清旷。\n定为造物嗔，觅句聊分谤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"唐明皇夜游图","author":"李彭","text":"开元御极垂衣裳，登三咸五凌羲皇。\n白环重译银瓮出，卜夜遨游离未央。\n香车斗风秦与虢，罗帕覆鞍真乘黄。\n赭袍错落缀北斗，步辇优游含缕觞。\n宁王玉笛上霄汉，御路花光争月光。\n汝阳羯鼓绢帽稳，打彻参旌低建章。\n太真沾醉玉攲侧，力士传呼声渺茫。\n翠钗挂冠红粉妆，金貂贳酒白面郎。\n君臣玩狎乐莫比，清禁喜闻宫漏长。\n若令姚宋坐庙堂，袖中谏疏神扬扬。\n万里桥边行幸处，后世龟鉴怀苞桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题驹父家江干秋老图","author":"李彭","text":"江风飕飗江水寒，芦洲雁下生微澜。\n渔翁夫妇不能语，津吏醉倒船著滩。\n其旁病夫坐箕踞，持竿万事那复顾。\n悬知宁断娇儿乳，不及冥鸿及飞鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望西山怀驹父","author":"李彭","text":"去岁湖湘赋凛秋，闻君江国大刀头。\n百年会面知几遇，十事欲言还九休。\n照眼遥岑落怀袖，过眉拄杖立汀洲。\n莫言青山淡吾虑，谁料却能生许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢朓登三山还望京邑寄六弟","author":"李彭","text":"驱车背郊园，殊乡复异县。\n春色满上都，杂遝眩闻见。\n危楼日辉辉，绛阙云练练。\n那思赴修畛，岂复忆遥甸。\n佳人戛鸣瑟，开怀具芳宴。\n但愿酒如渑，讵计花如霰。\n缅怀弃繻志，彬蔚期豹变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹","author":"李彭","text":"溪友提携紫蟹肥，形模郭索就羁縻。\n抱黄斫雪老饕事，看碧成朱露醉时。\n大嚼故知羞海镜，嗜甘易误食蟛蜞。\n欲将磊落轻周雅，委顿深怜蔡克儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谨次高韵酬禹功司录博士","author":"李彭","text":"烟霞痼疾自藏身，刮膜频窥佳句新。\n学博还同杜侯库，才悭深愧庾郎珍。\n倚风终日扫松径，披雾何时对玉人。\n西掖銮坡须妙手，如公那复困无津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽诗","author":"李彭","text":"周南留滞登封日，鲁国逍遥曳杖时。\n海内时流今略尽，不知谁作蔡邕碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读山谷文","author":"李彭","text":"折玉摧兰事竟空，贮云含雾思无穷。\n仙阶忽列通明观，人世犹称太史公。\n绛帐老生悲湜籍，传灯嫡子有徐洪。\n以那为首聊披拂，三绝韦编对晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东翻经台","author":"李彭","text":"枉渚映寒林，野航飞鸟急。\n不见康乐侯，衡门烟际入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"李彭","text":"满朝以诗鸣，何独遗大雅。\n平生黄叶句，摸索便知价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"李彭","text":"却笑思鲈脍，应须持蟹螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]