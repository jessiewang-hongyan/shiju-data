[{"title":"杭州鹿鸣宴示诸秀才","author":"赵抃","text":"秋闱贤诏出严宸，郡国详延在得人。\n豹变文章重君子，鹿鸣歌咏集佳宾。\n初闻素履称乡闬，终起英名动缙绅。\n预想帝庭俱唱第，宠光荣宴杏园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游元积之龙图江湖堂","author":"赵抃","text":"高堂游赏兴无厌，况是江湖两得兼。\n白傅阁危犹下视，子胥涛远更前瞻。\n盘桓鼓吹风光盛，掩映烟波气象添。\n太守老来难久恋，柯山朝暮欲归潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事登蓬莱阁偶成","author":"赵抃","text":"蓬阁下临千嶂起，戟扉前对五云开。\n誇诗旧属元之宅，叶气今同老氏台。\n月满夜疑仙子降，风恬春喜故人来。\n近缘冗剧怀清旷，梦里东游到几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次前人游鉴湖","author":"赵抃","text":"湖治谁能继后尘，马侯祠阁至今存。\n穷源上达仙翁井，引派旁通吏部园。\n红旆遍游偿素志，画桡归去近黄昏。\n别怀屈指期将半，况属乡州役梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次前人越州鹿鸣宴","author":"赵抃","text":"郡国秋闱吁俊辰，行修经治以名闻。\n芳筵缥缈开三岛，大乐諠哗彻五云。\n高桂折香期月窟，祥星垂彩应天文。\n集英唱第麻衣脱，得志无忘贤使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次前人赠奉使高丽安焘密学","author":"赵抃","text":"为嘉航海北徂南，双节勤劳帝命衔。\n日下亟驰传诏使，江边遥讶过洋帆。\n才谋锐若金曾砺，德操刚同玉更镵。\n机务须贤应并用，诗人莫惜咏岩岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次前人游梅山寺","author":"赵抃","text":"上方金碧冠诸峰，知是蓬莱第几宫。\n画舫去寻湖面阔，危亭登望海门通。\n梅仙旧说为真隐，佛子新传倡祖风。\n我忆前春曾遍览，至今来往梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡斋成寄前人","author":"赵抃","text":"退公真静独披襟，尚愧前贤探道深。\n零落交游难屈指，崇高轩冕不关心。\n未还印绶饶乡梦，犹倚湖山助老吟。\n讼缿虚空人事简，钱塘安得似山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屡乞致政诏答未允述怀","author":"赵抃","text":"自愧孤忠荷圣慈，恩荣恳向九天辞。\n于今蒲柳衰残日，好是云烟放旷时。\n玉阙累章烦赐诏，瀫江两桨蹉归期。\n宵征自有高人笑，漏尽钟鸣晓未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同毛维瞻度支游烟霞洞","author":"赵抃","text":"洞有烟霞寺挂牌，武林奇处称吟怀。\n出城旌骑非虚往，同里交朋喜得偕。\n鹢首西征随浪远，雁行南过入云排。\n恩隆魏阙朝天日，寒晚鸣珂上禁街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武林阅兵","author":"赵抃","text":"吴天霜晓弄寒晖，金鼓喧阗大阅时。\n帐下万兵听号令，军中诸将肃威仪。\n采侯命中连三箭，花阵分排卓五旗。\n愧乏韬钤当重寄，儒林初是学书诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程给事同孙觉学士杨宪景略游天衣寺","author":"赵抃","text":"元是玉皇香案吏，等閒吟笑即成文。\n松廊驻节排千骑，山径寻真步五云。\n谏院高风矜共赏，宪台清论喜同闻。\n三贤一会诚难有，归暮休辞酒十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游戒珠寺悼右军故宅","author":"赵抃","text":"因山盛启浮屠舍，遗像仍留内史祠。\n笔冢近应为塔冢，墨池今已作莲池。\n书楼观在人随远，兰渚亭存世几移。\n数纸黄庭谁不重，退之犹笑博鹅诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次赵少师叙感叹老","author":"赵抃","text":"禀灵南极老人星，贵得三公论道名。\n被旨入陪郊祀礼，放怀来听海潮声。\n朋从自古悠长少，势利令人鄙吝生。\n公独久要中外伏，直将金玉比纯诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题孤山寺湖上阁","author":"赵抃","text":"孤峰诸寺耸云楼，寺脚周环枕碧流。\n和靖久居勤赋咏，乐天临别叹勾留。\n拿舟直度閒千骑，佩印重来仅十秋。\n预约前春挂冠去，湖山阁好换休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次程给事题法云寺方丈","author":"赵抃","text":"府公清眼照孤心，结构仍誇壶奥深。\n师悟赵州庭柏境，我知青岭震雷音。\n粟粘便是三千界，草用曾为丈六金。\n一滴曹源谁可测，海门腾起浪千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬蔡仲偃都官","author":"赵抃","text":"守蜀思无羽翼飞，所思东向瀫江湄。\n山林适意君先手，轩冕辞荣我后时。\n道阻八千通远信，年迎七十是归期。\n故人恩意如金玉，新得邮中数首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别周元忠秀才","author":"赵抃","text":"吾里推高节行孤，诸生师帐是规模。\n穷经不治五亩宅，教子已为千里驹。\n暂出林泉飞两桨，且陪风月赏西湖。\n了知富贵傥来物，谁向浮云问有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张侨庆毛维瞻得谢","author":"赵抃","text":"里人迎候巷居稀，未老先休世所奇。\n两颊朱颜公退速，满头霜鬓我归迟。\n优游岂顾千钟禄，收拾如终一局棋。\n饮食节调资寿祉，愿同山下有雷颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武林冬至日即事","author":"赵抃","text":"况是东吴大有年，晨兴佳气满平川。\n鲁台纪瑞光诸史，汉殿称觞庆九天。\n銮辂肃还禋礼毕，鸡竿高揭赦书传。\n勾萌竞达人知否，占得群阳一日先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张著作过李虞部旧居","author":"赵抃","text":"美璞藏山宝在沙，急贤飞诏落幽遐。\n直庐去讲先儒业，斸径空存旧隐家。\n魏阙当时蒙雨露，衡门今日锁云霞。\n鸣珂一顾踟蹰过，山掩寒林夕照斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠讲僧遇清","author":"赵抃","text":"松桧成阴夹径寒，喧卑无路得相关。\n因嗟势利方为市，故掩庵扉独占山。\n薄俗性随红叶变，上人心与白云閒。\n慇勤约我休官后，深筑邻斋数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信笔示诸弟侄子孙","author":"赵抃","text":"进欲安舒退欲恬，要将高行与文兼。\n吾门自昔传清白，圣世于今重孝廉。\n孔氏性情归利正，仲舒仁义事摩渐。\n人生试看无闻者，徒尔区区岁月添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄程汝玉秀才","author":"赵抃","text":"乡闾推服孝廉名，谢绝辞闱乐太平。\n黄卷不忘穷古圣，白头无倦诲诸生。\n安车未召人为晚，束帛重来世所荣。\n况有知音贤太守，恳章三度荐遗英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵梁浃瑞芝","author":"赵抃","text":"圣旦求贤野不遗，如公诸子定逢时。\n默期苑里留丹桂，喜向门前获紫芝。\n香已与兰盈一室，饵当同术有三枝。\n昔年书牖曾呈瑞，报为登科众所知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十八男屼温㞦迎于雁荡温守石牧之以诗见寄次韵","author":"赵抃","text":"自谙趋拜力惟艰，柯岭归休远帝寰。\n抱瓮不能师老圃，驱车犹足访名山。\n鱼书入手慇勤后，雁字排空杳霭间。\n多荷主人期我意，谢公遗迹愿跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵台州姚舜谐见赠二首 其一","author":"赵抃","text":"解印全吴二载馀，近来人楷事何如。\n寻真遍赏台山后，假道行观雁岭初。\n把酒幸陪登帢帻，泛舟忻得缓徒车。\n别来早获鱼中素，两首新诗一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵台州姚舜谐见赠二首 其二","author":"赵抃","text":"过婺游台又倦勤，路旁驰看两州民。\n也知胜处青山旧，自恨来迟白发新。\n暂憩瀛宫求道侣，载瞻方广想仁邻。\n贰车章句犹怜我，为是云泉无事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游雁荡将抵温州寄太守石牧之","author":"赵抃","text":"霜风双鬓雪鬖鬖，物外寻真顿离凡。\n子舍若非叨别乘，我车安得到灵岩。\n碧窥秋瀑心同洗，红嚼山杷口似馋。\n多谢贤侯见招意，数贻嘉咏与珍函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自温将还衢郡题谢公楼","author":"赵抃","text":"雁荡周游遂此过，永嘉人物竟如何。\n三贤籍籍风流守，一宿匆匆證道歌。\n城脚千家具舟楫，江心双塔压涛波。\n因留子舍欣踰月，归去事知所得多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将还三衢呈温守石郎中","author":"赵抃","text":"寻山初为子来迎，乘兴随潮入郡城。\n心赏皆如逸老愿，礼隆仍尽主翁情。\n綵舟笳鼓双双闹，金地楼台处处明。\n风物虽嘉难久恋，安车朝夕且西行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑琰大夫赴建昌军","author":"赵抃","text":"三拥朱轮志少酬，忠怀曾不为身谋。\n桐江郡政居优课，柯岭乡评占上游。\n里彦昔陪公共荐，帝俞今幸我先休。\n分携莫惮炎威盛，到日清风一变秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次毛维瞻溪庵","author":"赵抃","text":"退访云山远世尘，结庵台上古溪滨。\n围棋每放争先手，隐几能安自在身。\n鸥鹭后前如旧物，龟鱼游泳不疑人。\n曲肱饮水真贤乐，何用渊明漉酒巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又白云庵偶题","author":"赵抃","text":"红尘无迹到山家，留待诗人大笔誇。\n坐石与僧谈翠竹，开樽邀客醉榴花。\n鸥随钓叟孤舟远，牛载村童一笠斜。\n占尽神仙潇洒地，清风明月有谁遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖北运使学士十二弟扬生日","author":"赵抃","text":"原上分飞羡鹡鸰，今遥荆渚昔离青。\n诞辰一纪阻良会，庆席百杯新永龄。\n对局每思樵客斧，爇香长奉老人星。\n辛勤五福康宁术，见说时看内景经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送穆舜宾承议致政还乡","author":"赵抃","text":"清修平日得无惭，学道勤行肯妄谈。\n轩冕諠哗公始悟，林泉潇洒我先谙。\n曾怜避弋云中雁，每念缠丝茧里蚕。\n画舫西归时节好，春山如黛水如蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送十七侄嶙承事赴任贵溪","author":"赵抃","text":"百里嚣繁不易为，乘时今去是镃基。\n直令尔邑成良俗，况自吾家有吏师。\n却扇凉飙惊热夺，下车和气觉春熙。\n綵衣迎养双亲志，此乐人间更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送任浩朝散赴鄱阳景德镇","author":"赵抃","text":"十年留滞尚为郎，乐道无愁解到肠。\n去路溪山排古嶂，满囊金玉贮新章。\n休论富贵可求事，况得神仙不死方。\n官罢钱塘好归矣，濯缨清自有沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范伯玉奉议赴阙","author":"赵抃","text":"富贵于身有重轻，平生忠鲠世知名。\n不须勇事归田计，况有常推报国诚。\n通籍官联分帝念，庆门恩赏作亲荣。\n一帆西上瞻天去，九月霜风壮客程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生日高斋晓起示诸弟妹子孙","author":"赵抃","text":"荣途四纪历艰难，宦政天恩许赐还。\n晓起焚香清一室，夜来飞雪满群山。\n诗筒远到披邮置，寿斝交行醉席间。\n弟妹五人三百岁，喜吾霜鬓尚朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题濯缨亭","author":"赵抃","text":"静处高斋昼杜门，溪亭来往间开樽。\n钓台逸老心非傲，浮石仙人迹尚存。\n对岸烟林双佛寺，隔滩风笛一渔村。\n濯缨岂独酬吾志，清有沧浪示子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题叶坂梁氏南斋","author":"赵抃","text":"我爱黉堂用意精，义方垂训为趋庭。\n学攻白玉须成器，教积黄金不似经。\n满架简编终岁乐，拥门松竹四时青。\n诸生有遂登荣者，一月光能掩众星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会燕溪亭示同席","author":"赵抃","text":"新构园亭好客过，尘缘都不问如何。\n爱吟潇洒封侯句，耻咏沧浪濯足歌。\n莫笑杯盘常藉草，且观舟楫半随波。\n子知此乐无涯否，尽是天恩与幸多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭康守赵师旦","author":"赵抃","text":"五月炎方祲气浮，贼锋残忍入康州。\n肯抛孤垒偷生去，誓禦群蛮竟死休。\n没世不名贤者耻，长年为辱古人羞。\n嗟嗟潜叔今何恨，愤血忠魂劲草秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄处州太守徐大夫","author":"赵抃","text":"潜山西畔紫溪边，林下相逢岂偶然。\n抚掌急于云里电，回头还似火中莲。\n黄花翠竹年年色，明月清风夜夜天。\n谁谓故人相去远，好溪长与慎江连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题真岩寺","author":"赵抃","text":"一炷清香一解颜，几生修得到林间。\n朝无事也夕无事，坐看山兮行看山。\n梅玉破香供宴坐，松风奏曲度禅关。\n静思四海五湖客，虽有黄金无此閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杨鸿渐察判见赠","author":"赵抃","text":"县令于是袭汉唐，震雷为治制封疆。\n得人固可恩千室，无状须忧病一方。\n愚品昔蒙登仕籍，薄材今幸预朝纲。\n但欣孤迹辞丘壑，岂有深谋赞庙堂。\n万里山川来陇蜀，十分风物类江乡。\n存心抚俗图归正，顾己临民敢不庄。\n莲幕似君诚慷慨，兰言遗我极芬芳。\n自嗟寸善无裨补，更辱长篇盛播扬。\n投李莫嫌迟报赠，解琴终拟效更张。\n若孤朋照宜身愧，冠弁峨峨佩玉苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵前人见赠","author":"赵抃","text":"惟公治迹峤之南，增秩颁金出帝佥。\n蛮獠望风安畛域，城闉兴筑赖韬钤。\n恩行稚耋增和乐，令下奸豪尽伏潜。\n抚俗上宽当宁念，扬风深副远民瞻。\n潮阳鳄去因诚祷，合浦珠还表性廉。\n五岭盛传威德著，九天俄下诏书严。\n紫宸入觐输忠谠，青琐归来发滞淹。\n謇謇去为中国使，皇皇宁许外夷觇。\n河冰日度疑铺玉，朔雪时逢类撒盐。\n持节塞垣先正席，过涂溪馆尽穷阎。\n光华不辱熙朝命，诽讪因知黠虏憸。\n去路冬迎风若箭，还朝春早月如镰。\n论勋已出庭臣右，得礼应须史笔添。\n赐对预陈官政致，称褒亲被德音恬。\n天人密语依旒冕，风日微和满扇帘。\n得请乡州心且适，暂违黼座义无嫌。\n都门客况千钟饯，禁掖诗仍二府兼。\n巨舰解维桃浪紧，高楼夹岸柳丝纤。\n经途驻节频开旆，密宴喷香似展奁。\n会友樽罍醅泼蚁，渡淮诗什砚磨蟾。\n居常志气惟中立，虽久淹徊肯附炎。\n夜泊每窥渔父火，晓行遥认酒家帘。\n吴江橘柚津偏美，茂苑鲈莼味正甜。\n上冢朋从空里巷，过家车马拥门檐。\n邻邦饷劳迎旌棨，乐榭歌欢散綵缣。\n渡越一潮催叠鼓，去杭千骑拥行襜。\n抑强抚弱恩先被，宣化承流泽下沾。\n鉴水渔樵随业乐，秦山草木尽仁渐。\n想经岁月须膺召，纵有蓍龟不在占。\n屡寄诗筒追故事，亲挥墨宝见劳谦。\n冰清气谊同初淡，胶固情怀未比粘。\n何日西归容迓礼，莫辞吟醉夜厌厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题马伏波庙二首 其一","author":"赵抃","text":"壮敌无前老未休，赏功销得到封侯。\n印归新息不还葬，似与诸蛮一报仇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题马伏波庙二首 其二","author":"赵抃","text":"平生忠勇建殊勋，薏苡疑珠竟不分。\n光武明如辩谗者，肯教千古负将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈太博见贻","author":"赵抃","text":"待得清明已半春，幕中何许可娱宾。\n堵观不是穿杨手，珍重贤侯诲尔频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈太博会春晚归","author":"赵抃","text":"未醉樽前未可归，青春九十日芳菲。\n名园一夜狂风雨，苔上残花点绿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何推官见招游岳麓以郡中事冗弗克偕行口占二绝以谢 其一","author":"赵抃","text":"送客江亭一望间，隔江奇胜有千山。\n江头未必无舟子，自是名缰不暂閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何推官见招游岳麓以郡中事冗弗克偕行口占二绝以谢 其二","author":"赵抃","text":"麓苑崟岑对橘洲，山如屏嶂水清流。\n谁能向此孤寻胜，案牒装怀不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈太博小圃偶作二首 其一","author":"赵抃","text":"名园雨后百花繁，人倚危楼十二兰。\n园里芳菲楼上客，一般情绪怕春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈太博小圃偶作二首 其二","author":"赵抃","text":"日烘薄雾开柔陌，风罥游丝著柳条。\n语燕啼莺自撩乱，惊人残梦是春朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不与祠岳再呈通判沈侯","author":"赵抃","text":"蔡侯不是不寻仙，俗骨由来欠玉鞭。\n待得麻姑重前约，只应瀛海已桑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵见和","author":"赵抃","text":"古祠灵镇会真仙，一夕春霖激电鞭。\n待得归航已新暑，小荷江上绿田田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代寄刘信臣","author":"赵抃","text":"无憀情绪满眉头，去后方知有别愁。\n翠幰雕鞍杳何所，相望重上夕阳楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前人见寄 其一","author":"赵抃","text":"此去山重水复重，登临无复叹途穷。\n应将往事閒追忆，疑是邯郸梦枕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前人见寄 其二","author":"赵抃","text":"下马邮亭夕照天，独凭离绪问蓍圆。\n故人此去无多地，何事销魂重黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和何节推重九","author":"赵抃","text":"喜陪佳客上高台，醉策骅骝薄暮回。\n黄菊满头堪自笑，朱颜何必为人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄里中亲友","author":"赵抃","text":"上尽危梯望社榆，乱山千叠隔吾庐。\n四方尽是男儿志，敢叹离群与索居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]