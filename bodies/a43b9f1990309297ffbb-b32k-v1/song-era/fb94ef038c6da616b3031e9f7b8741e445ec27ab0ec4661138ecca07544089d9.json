[{"title":"老将效唐人体","author":"陆游","text":"宝剑夜长鸣，金痍老未平。\n指弓誇野战，抵掌说番情。\n已矣黑山戍，怅然青史名。\n和亲不用武，教子作儒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老甚自咏二首 其二","author":"陆游","text":"羡生常笑古人痴，俯仰那知迫耄期。\n镜里鬓无添白处，尊前颜有暂丹时。\n客瞋终岁常称疾，儿讶经旬懒赋诗。\n枉却愁过强健日，身闲何往不熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老甚自咏二首 其一","author":"陆游","text":"残年真欲数期颐，一事无营饱即嬉。\n身入儿童斗草社，心如太古结绳时。\n腾腾不许诸人会，兀兀从嘲老子痴。\n亦莫城中买盐酪，菜羹有味淡方知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老健","author":"陆游","text":"年垂九十身犹健，竹屋荆扉不厌低。\n挈榼自沽深巷酒，拥衾遥听别村鸡。\n家添豚栅还堪赋，路认牛栏每不迷。\n惟恨穷秋开霁少，晚来小雨又成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老健","author":"陆游","text":"才智不足狂有馀，此身老健更谁如。\n齿牢尚可决乾肉，目瞭未妨观细书。\n不怪模棱嗤了了，但惊紾臂劝徐徐。\n晓看瓜垄初牵蔓，一笑呼儿勿废锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老病","author":"陆游","text":"湖上归耕一病翁，此心非复少年同。\n读书初恨岁时速，闻道始知身世空。\n匠石不能材社栎，弋人何意慕冥鸿。\n新春愈觉支离甚，又付生涯药裹中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老病无复宦情或者疑焉作此示之","author":"陆游","text":"病思萧条岂独今，十年前已鬓霜侵。\n旧交略尽形吊影，薄宦宜休口语心。\n老骥已甘当伏枥，穷猿况是急投林。\n别君径入乱云去，后日相思何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老病谢客或者非之戏作","author":"陆游","text":"病侵腰膂两经秋，欲下绳床不自由。\n客至难令三握发，佛来仅可小低头。\n安禅还我闲蒙衲，怒气从渠勇挟辀。\n亦欲署门还懒去，死生贵贱两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老翁","author":"陆游","text":"老翁睡少知遥夜，贫士衾单怯苦寒。\n闷里不嫌村酒薄，瘦来偏觉旧衣宽。\n篱门遇健时能出，书卷乘闲亦取看。\n深愧野人怜寂莫，放锄相唤共朝餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老翁","author":"陆游","text":"老翁垂七十，不复叹头颅。\n浩荡新渔艇，凋零旧酒徒。\n严徐元衮衮，管葛亦区区。\n独有欣然处，登山未用扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老景","author":"陆游","text":"老景虽无几，为农尚有馀。\n曾传种鱼术，新得相牛书。\n黍酒时留客，菱歌或起予。\n平生湖海志，高枕看严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老景","author":"陆游","text":"老死知无日，天公偶见宽。\n疾行逾百步，健啖每三餐。\n身瘦短裁褐，发稀低作冠。\n年来更小黠，不据伏波鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老境二首 其二","author":"陆游","text":"今日霜殊重，衰翁老可怜。\n朝晡两炊火，覆藉一床毡。\n人客容称疾，儿童不搅眠。\n云开见残日，更爱小窗妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老境二首 其一","author":"陆游","text":"白发短欲尽，人嗤心尚孩。\n埋盆池潋滟，累瓦塔崔嵬。\n软饭三舂米，醇醪九酝醅。\n忽然拈笔起，记著早梅开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老境","author":"陆游","text":"平生百不遂，惟有老如期。\n眼涩观书夜，心衰把酒时。\n僧分新掘药，客诵旧题诗。\n四十年前我，回看定是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老境","author":"陆游","text":"一生幸免践危机，老境还山饱蕨薇。\n智士固知穷有命，达人元谓死为归。\n临窗蜀纸誊诗草，出户郿绦系褐衣。\n堪笑街头小儿女，问予君是伯休非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老鳏","author":"陆游","text":"水际山前有老鳏，终年无事亦非闲。\n渊源师友简编上，土木形骸鱼鸟间。\n零落断云依钓濑，连涓新月照柴关。\n葵羹稗饭悠然过，一饱元非造物悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗皇帝挽词三首 其二","author":"陆游","text":"代邸膺图日，临朝涕泗横。\n诚心非外饰，至孝化群生。\n高庙联龙衮，思陵接柏城。\n平生奉亲意，一理贯幽明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗皇帝挽词三首 其一","author":"陆游","text":"大道本生知，崇高志不移。\n凝神超事物，观妙极希夷。\n访药三山远，遗弓万国悲。\n神孙昔钟爱，天作太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝宗皇帝挽词三首 其三","author":"陆游","text":"便殿咨询早，深宫宴乐稀。\n欲颁传位诏，犹索未明衣。\n寿损名方永，身癯国愈肥。\n孤臣泣陵柏，心折九虞归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其一","author":"陆游","text":"桐帽絁裘拥半酣，肩舆咿轧转城南。\n牛过野水将新犊，女采柔桑起稚蚕。\n遗老年光垂九十，故乡春事及重三。\n种花筑室知难办，借地犹能结草庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其五","author":"陆游","text":"我来恰值暮春初，昼漏微长小雨馀。\n苔蚀秦碑亡旧刻，龙归禹穴护遗书。\n燕巢已垒泥犹湿，花片虽残叶尚疏。\n到处不妨俱可乐，诗人为底爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其七","author":"陆游","text":"点点桃花糁绿苔，入门倚杖意悠哉。\n数声茶饭斋初散，一片溪云雨欲来。\n老宿龙钟嗟独在，高松磊砢忆新栽。\n世间万事俱难料，未死重游更几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其三","author":"陆游","text":"老子无心老尚狂，山程随处寄伥伥。\n云归岫穴初收雨，水入陂塘正下秧。\n野客就林煨燕笋，蚕家负笼采鸡桑。\n远游万里知何乐，却喜东归住故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其二","author":"陆游","text":"细雨如丝映晚晖，店家小憩换征衣。\n春农耕罢负犁去，村社祭馀怀肉归。\n黄犊自依残照卧，白鸥争傍小滩飞。\n道边旧识凋零尽，谁记辽天老令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其六","author":"陆游","text":"舆似鸡栖寄两竿，山程三月尚春寒。\n麦苗吐穗初成实，梅子生仁已带酸。\n买饭犹胜乞墦客，看耕僭学劝农官。\n还家莫道虚怀袖，笋蕨随宜亦满槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其八","author":"陆游","text":"我行随处叩岩扉，觅得生薪旋燎衣。\n道士已骖鸾鹤去，山僧初自水云归。\n瓮头酒压松肪熟，盘里蔬供药汞肥。\n老觉论心须世外，溪阴回首尚依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自九里平水至云门陶山历龙瑞禹祠而归凡四日八首 其四","author":"陆游","text":"老子山行肯遽回，直穿荦确上崔嵬。\n未誇脚力如平昔，且喜眉头得暂开。\n庙后故梁龙化去，山前遗箭鹤衔来。\n囊钱已尽君无笑，草草犹能把一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自上灶过陶山","author":"陆游","text":"宿雨初收见夕阳，纵横流水入陂塘。\n蚕家忌客门门闭，茶户供官处处忙。\n绿树村边停醉帽，紫藤架底倚胡床。\n不因萧散遗尘事，那觉人间白日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自上清延庆归过丈人观少留","author":"陆游","text":"再到蓬莱路欲平，却吹长笛过青城。\n空山霜叶无行迹，半岭天风有啸声。\n细栈跨云萦峭绝，危桥飞柱插澄清。\n玉华更控青鸾住，要倚栏干待月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自云门之陶山肩舆者失道行乱山中有茅舍小塘极幽邃求见主人不可意其隐者也","author":"陆游","text":"陂池幽处有茅堂，井臼萧条草树荒。\n小鸭怯波时聚散，病蔬伤蠹半青黄。\n童儿冲雨收鱼网，婢子闻钟上佛香。\n我亦暮年思屏迹，数椽何计得连墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自开岁阴雨连日未止","author":"陆游","text":"江云漠漠雨昏昏，归老山阴学灌园。\n十里羊肠仅通路，三家铛脚自成村。\n应时馎饦聊从俗，耐久钟馗俨在门。\n近县传闻颇多盗，呼儿插棘补颓垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自开岁略无三日晴戏作长句","author":"陆游","text":"新年暗曀觉春悭，变化相乘一瞬间。\n雨脚稍收初见日，风花忽起又遮山。\n欲行幽圃还成阻，未脱重裘自笑孱。\n桃李会开君勿恨，清尊且用破衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自东冈缭出舍北","author":"陆游","text":"年光岂不好，老境独无欢。\n百步未为远，一尊聊自宽。\n泽枯波尚绿，霜薄叶初丹。\n矫首问来雁，中原应苦寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自东泾度小岭闻有地可卜庵喜而有赋","author":"陆游","text":"小岭西南烟水间，颇闻有地百弓宽。\n谁其云者两黄鹄，何以报之双玉盘。\n竹坞未昏先晻暧，莲汀当暑亦清寒。\n一庵何日从吾好，会约高人共倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自叹","author":"陆游","text":"恶杀常根食，安贫但缊袍。\n消摇敢言达，简默本非高。\n入剡逢飞雪，游吴看怒涛。\n平生笑渔父，苦语劝餔糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自汉州之金堂过沈氏竹园小憩坐间微雨","author":"陆游","text":"修修万竹压康庄，碧玉椽围一尺彊。\n雪节烟梢谁暇赏，马蹄车辙可怜忙。\n帽边忽堕吹香句，肘后旧传医俗方。\n更觉清游天所惜，坐来飞雨度横塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自立秋前病过白露犹未平遣怀二首 其一","author":"陆游","text":"门冷荒车辙，囊空别醉乡。\n懒行眠亦好，倦话默何伤。\n野叟占幽梦，山僧送秘方。\n病怀虽忽忽，随事答年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自立秋前病过白露犹未平遣怀二首 其二","author":"陆游","text":"饥能坚志节，病可养精神。\n不动成罴卧，微劳学鸟伸。\n功名知幻境，忧患笑前身。\n药裹吾何厌，秋灯作梦新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自合江亭涉江至赵园","author":"陆游","text":"政为梅花忆两京，海棠又满锦官城。\n鸦藏高柳阴初密，马涉清江水未生。\n风掠春衫惊小冷，酒潮玉颊见微赪。\n残年飘泊无时了，肠断楼头画角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自江源过双流不宿径行之成都","author":"陆游","text":"断笮飘飘挂渡头，临江立马唤渔舟。\n少城已破繁华梦，老境聊寻汗漫游。\n斜日驿门双堠立，早霜风叶一林秋。\n诗材满路无人取，准拟归骖到处留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自讼","author":"陆游","text":"家弊须微禄，年衰尚远游。\n未逃朋友责，更遣吏民羞。\n采药思长往，传书却小留。\n微风入桐叶，分我一帘秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自励","author":"陆游","text":"中年已惧小人归，况是骎骎耄及时。\n气惰欲归思友助，学衰不进赖儿规。\n无功追愧清时禄，有命何忧晚节饥。\n羸病今年能未死，潜心更下董生帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自妙相归将至杜浦堰舟中作","author":"陆游","text":"斜阳发东郭，初夜转西城。\n寺阁疏钟动，渔村远火明。\n苍茫林霭灭，扑漉水禽惊。\n渐喜吾庐近，遥闻过埭声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自局中归马上口占","author":"陆游","text":"幼舆只合著山岩，误被恩光不盖惭。\n人怪衰翁烦尺一，心知造物赋朝三。\n飞腾岂少摩云鹘，蹙缩方同作茧蚕。\n安得公朝闵枯朽，早教归卧旧茆庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自来福州诗酒殆废北归始稍稍复饮至永嘉括苍无日不醉诗亦屡作此事不可不记也","author":"陆游","text":"尊酒如江绿，春愁抵草长。\n但令闲一日，便拟醉千场。\n柳弱风禁絮，花残雨渍香。\n客游还役役，心赏竟茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自芳华楼过瑶林庄","author":"陆游","text":"春晚江边草过腰，雨馀楼下水平桥。\n名花未落如相待，佳客能来不费招。\n栏角峭风罗袖薄，柳阴斜日玉骢骄。\n此身醉死元关命，敢笑闻鸡趁早朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒","author":"陆游","text":"一廛东近会稽城，凿破烟芜俋俋耕。\n上药养神非近效，善言铭座要躬行。\n论书尚欲心先正，学道宁容气不平。\n天付吾侪元自足，满园春荠又堪烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒","author":"陆游","text":"荒圃风烟入荷锄，孤村巷陌看骑驴。\n少年曾纵千场醉，老境惟存一束书。\n作意买山虽已矣，忍惭乞米独何欤。\n所欣肺病秋来减，白发萧萧可自梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒二首 其一","author":"陆游","text":"病中看周易，醉后读离骚。\n不解书驴券，安能问马曹。\n身随游宦困，气为屏居豪。\n清旦南堂坐，稽山秋更高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒","author":"陆游","text":"健忘闲何害，贪眠老正宜。\n本心惟泥酒，馀习略存诗。\n未废春农业，犹堪幼学师。\n微官何所恋，请老五年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒二首 其一","author":"陆游","text":"足蹇须人惯，颜衰著黡多。\n饭迟惟静卧，酒至亦高歌。\n蝗死繁蔬甲，霜清长药窠。\n经旬邻父病，且喜复来过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒二首 其一","author":"陆游","text":"愈老愈知生有涯，此时一念不容差。\n身如病鹤长停料，心似山僧已弃家。\n高枕时时闻解箨，卷帘片片数飞花。\n饭馀解带摩便腹，自取风炉煮晚茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒二首 其二","author":"陆游","text":"莫笑幽栖僻，谋生亦未疏。\n残囷具薄粥，半俸补残书。\n均节贫无患，安恬疾可除。\n虽云苦寒近，随手蓄薪樗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒二首 其二","author":"陆游","text":"行年耄及卧蜗庐，山水登临亦已疏。\n无可奈何犹食粟，未能免俗学浇蔬。\n蓬门时接渔樵话，尘几聊存种树书。\n强欲入城还自笑，世间那有鹤乘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自诒二首 其二","author":"陆游","text":"庄语畏如俳，端居要若斋。\n清虚集心腑，枯槁见形骸。\n自计愚无用，何伤老不谐。\n人生须广大，勿作井中蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自近村归","author":"陆游","text":"雪晴村路尚残泥，茅屋清寒正要低。\n野渡船虚飞鸟集，烟村路近蹇驴嘶。\n坚顽那复愁空橐，老健犹能伴架犁。\n蹴榻不僵君会否，更须百瓮享黄齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自闵","author":"陆游","text":"破帽羸骖厌垢氛，挂冠归伴故溪云。\n年光疾病占强半，日景睡眠居七分。\n庐冢萧条频霣涕，交朋零落久离群。\n残年岂复行孤学，自闵犹尊昔所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自闵","author":"陆游","text":"主人元是客，儒士却成僧。\n垂老贫如昔，经春醉未曾。\n褰衣身伛偻，顾影发鬅鬙。\n忽忆东冈路，扪萝试一登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏二首 其一","author":"陆游","text":"纷纷世态但堪悲，一念萧然我亦奇。\n醉里猖狂醒自笑，梦中虚幻觉方知。\n江湖重复风波恶，齿发凋零岁月驰。\n安得中原路如砥，渭川钓伴待多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏","author":"陆游","text":"宦游畴昔遍天涯，万里东归岁月赊。\n古道泥涂居士屩，荒畦烟雨故侯瓜。\n园公溪父逢皆友，野寺山邮到即家。\n病思渐轻重九近，又将乌帽插黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏","author":"陆游","text":"生草覆蜗庐，长须驾鹿车。\n贫犹思施药，老不废观书。\n登览携童稚，歌呼和里闾。\n躬耕亦何得，聊以遂吾初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏","author":"陆游","text":"万事不挂眼，终年常避人。\n荒畦荷锄晚，环堵结茆新。\n病马何劳斥，轻鸥未肯驯。\n虽惭市门卒，聊作葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏","author":"陆游","text":"平生万事付憨痴，兀兀腾腾到死时。\n夜踏乱云过略彴，晓分寒溜注军持。\n束薪山客招烹石，渡海蕃僧乞制碑。\n作个生涯君勿笑，拄天勋业亦儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏二首 其二","author":"陆游","text":"谢事客谁过，闲游吏不诃。\n家人争稗粥，邻叟和畬歌。\n静夜诗成祟，新春睡有魔。\n年光本无尽，未用叹蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]