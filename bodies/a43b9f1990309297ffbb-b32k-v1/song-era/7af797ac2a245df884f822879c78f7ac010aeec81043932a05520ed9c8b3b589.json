[{"title":"和万舍人折赠蜡梅韵 其一","author":"虞俦","text":"问讯江梅意未回，少林横出不知裁。\n争先赖有园夫报，折赠空惊驿使来。\n疏影暗香宁是伴，蜡言栀貌未须媒。\n主人闻说归朝近，且趁眉间喜色开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子长县尉林同年立春后十日风雪大作访客不值","author":"虞俦","text":"一束乌薪抵百金，外间风雪政愁阴。\n履穿东郭先生病，梅老西湖处士吟。\n青帝未教春满目，玄冥还有岁寒心。\n蹇驴不踏长安道，恐落泥涂迹愈深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和劝农诗 其二","author":"虞俦","text":"节物常流转，人情作异同。\n颇期千载后，宁忍一朝穷。\n隔叶饶晴哢，游丝罥堕红。\n老春何足恨，结习本来空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太守","author":"虞俦","text":"岂弟循良守，功成意益谦。\n寻求七字律，想见一生廉。\n活火烹茶蕊，消愁媚酒帘。\n南楼月华好，吹笛指须纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和木犀","author":"虞俦","text":"岩桂无人也自芳，月宫仙子道家妆。\n露漙仙掌三秋色，风动枝头十里香。\n先世栽培虽地僻，近年卜筑发天藏。\n后堂元有文犀贵，可但腰金照地光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和木犀再开","author":"虞俦","text":"东堂留得最高枝，向道重开果有时。\n仙掌露漙秋气重，山头月照晚妆宜。\n层层黄色眉间见，拂拂清香鼻观知。\n更约菊花为老伴，四难并处可无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和主簿喜雨二首 其二","author":"虞俦","text":"年来事事与心违，墨绶尘劳莫我知。\n慷慨归田虽有赋，殷勤喜雨漫赓诗。\n谁怜饭颗山头瘦，却想松江水面肥。\n一笑桑榆收已暮，向来膏润太踰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和主簿喜雨二首 其一","author":"虞俦","text":"龙眠熟处雷呼醒，蚁战酣时雨趁来。\n凉入稻云青漠漠，润添田水白皑皑。\n但期家给皆红腐，莫管庭空长绿苔。\n老令催科知自拙，推挤不法谓何哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉老弟牛尾狸韵","author":"虞俦","text":"堂馈流涎玉面狸，也知臭腐出神奇。\n分无竹叶浮酥面，尚想梅花映雪肌。\n渠幸腊前能漏网，人言春后亦非时。\n吾侪口腹真馀事，莫倚雄豪浪赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉老弟立春","author":"虞俦","text":"吹葭六管候频频，眉寿先储酒十旬。\n鞭到土牛休袖手，斗回天驷已驰神。\n花梢綵胜翻新样，镜里朱颜只故人。\n生菜玉纤能细缕，大家醉赏满盘春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉老弟迎春","author":"虞俦","text":"青旂小队唤渠频，新历先看早二旬。\n羯鼓催花誇敏捷，舞腰回雪斗精神。\n燕飞欲傍钗头月，雁过才归陌上人。\n谁道土牛鞭不动，也能脚底散阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉老弟雪下不聚","author":"虞俦","text":"剪水飞花散又收，天人袖手翠云裘。\n待滋宿麦须连陇，政虑流民醉覆舟。\n村店浪誇沽酒旆，寒窗谁上钓诗钩。\n玄冥岂是痴儿子，且与天工了事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉老弟雪诗","author":"虞俦","text":"大皞行春未有闻，六花连夜舞缤纷。\n落梅未晓惊三弄，宿麦先秋定十分。\n飞上綵幡怜我老，映来书幌慰儿勤。\n四时代谢从来事，造物何心更策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉老弟喜雪","author":"虞俦","text":"为瑞虽多却不宜，谁怜孤坐拨灰时。\n兴添竹叶蛆浮瓮，瘦损梅花雀抱枝。\n闭户从教行迹断，裹裘犹怯暮寒欺。\n天工似欲还三白，冷淡家风合有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙尉登空翠堂鼓琴酌茗有怀冷令二首 其二","author":"虞俦","text":"花满芳洲月满楼，留连从事到青州。\n巧分茗椀消磨睡，静拂琴徽断送愁。\n寒食烟花知有几，上元灯火恰才收。\n冷官已办江头费，烂醉春风典破裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙尉登空翠堂鼓琴酌茗有怀冷令二首 其一","author":"虞俦","text":"楼畔晴岚翠拂空，天教我辈一尊同。\n只愁杨柳归来绿，却叹桃花去后红。\n春事又还觞咏里，人生正堕别离中。\n不堪搔首东南望，独立惊风叹断鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安抚王诚之给事重九日登高诗韵 其三","author":"虞俦","text":"眼横秦望接云高，不独诗豪酒亦豪。\n岂是过呼韩吏部，未应轻比汉功曹。\n尊空北海怀文举，菊绕东篱念老陶。\n只恐诏归天尺五，直须秉烛与公遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安抚王诚之给事重九日登高诗韵 其二","author":"虞俦","text":"秋雁初飞几点高，卧龙送目十分豪。\n且容司马吹纱帽，莫向参军问骑曹。\n饮吸百川从酩酊，诗驱万象入甄陶。\n菊花开日重阳是，有暇何妨更一遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和安抚王诚之给事重九日登高诗韵 其一","author":"虞俦","text":"登临兴引越山高，醉眼何曾识二豪。\n戏马向来誇胜饯，卧龙此去记吾曹。\n风前短发还羞杜，笔底新诗欲和陶。\n赖有蛤蜊风味在，固应居士笑卢遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和巩使君释奠韵","author":"虞俦","text":"畴昔东家一亩宫，推尊昭代比天崇。\n弦歌未辍文斯在，俎豆亲陪献有终。\n采藻载歌思泮水，浴沂行咏舞雩风。\n自惭谬玷诗书走，未羡诸儒舍盖公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汤倅七夕","author":"虞俦","text":"目断银河婉娈期，綵云香雾转馡馡。\n天孙无赖能专巧，世俗由来亦妄祈。\n稚子唤人占蟢网，老妻怜我泣牛衣。\n客星若就君平卜，更问金穰与木饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汤倅春雪","author":"虞俦","text":"雪瑞元来竟不空，丰年消息喜潜通。\n故怜梅老扶衰白，未放桃夭嫁小红。\n夜动檐花犹带雨，晴看陇麦待摇风。\n强颜追逐新年事，倍费天人剪水工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汤倅留别","author":"虞俦","text":"官冷门前可设罗，高轩多谢肯相过。\n别离渐近那堪说，觞咏从今莫厌多。\n风月平分聊尔耳，云霄咫尺奈君何。\n汉庭行且迎枚乘，南浦从教恨绿波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汤倅梅花韵","author":"虞俦","text":"玉奴端不负花期，乞得东皇一笑归。\n淡扫娥眉怜虢国，半匀妆面妒徐妃。\n有情立马留新恨，无赖啼禽送落晖。\n金铉政须和鼎实，莫嫌笛里浪惊飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴守赋秋阅之什","author":"虞俦","text":"秋郊小队暂徘徊，谁信儒门出将才。\n千骑控弦吴月满，一声鸣角楚天开。\n赋诗已是誇横槊，看剑何妨更引杯。\n收取中原报明主，凌烟事业正相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴守韵送木犀","author":"虞俦","text":"珍重黄堂遗送来，淮南未数小山才。\n分从月里双株在，趁得风前一笑开。\n秋著屏帏蟾弄影，春生酒面蚁浮杯。\n姮娥自与花为约，不爱人间羯鼓催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋宰立春雨 其二","author":"虞俦","text":"镜里朱颜一寸埃，感时怀抱向谁开。\n典衣饾饤盘心菜，贳酒留连眼底梅。\n三月莺花劳问讯，几家幡胜带能回。\n新来不作温柔梦，有底诗情似玉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋宰立春雨 其一","author":"虞俦","text":"怪生淑气静氛埃，知是东君一笑开。\n膏雨任能滋宿麦，香风先已上寒梅。\n交情太薄莺犹懒，远信难凭雁却回。\n闻道君家春最胜，十分眉妩画章台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨仲才归途秋郊即事","author":"虞俦","text":"马上西风著面凉，翩翩乌帽更低昂。\n晚晴是处鸦声喜，秋熟连阡禾穗香。\n稚子候门应自语，征夫指路未渠忙。\n歇鞍野店谁为伴，自买村醪一举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汪倅","author":"虞俦","text":"城头杖屦恣延缘，终日看山也自贤。\n浮蚁酿来堪把盏，飞鸿送尽且挥弦。\n捲残帘幕千家雨，倚遍阑干四角天。\n渭北江东何处是，谪仙诗兴政飘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和沈祭酒韵","author":"虞俦","text":"诗思花前发，春光眼底来。\n一区聊自适，三径为谁开。\n圣主方求旧，清时况急才。\n凤池波自暖，鸥鹭勿多猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈德章春日送客 其四","author":"虞俦","text":"岁月斜川路，风流杜曲天。\n过墙红杏雨，低户绿杨烟。\n鸿鹄今千里，莺花又一年。\n阳春惭属和，五字得珠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈德章春日送客 其三","author":"虞俦","text":"胜事壶觞里，韶华杖履中。\n歌情千里月，花信几番风。\n取友须三益，论文笑五穷。\n含含歌麦秀，庑下老梁鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈德章春日送客 其一","author":"虞俦","text":"年华看鬓上，春事转头中。\n羯鼓催花雨，虹桥送客风。\n未须愁酒债，政复坐诗穷。\n谁识挥弦意，寥寥寄远鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈德章春日送客 其二","author":"虞俦","text":"花柳无多事，阴晴不必天。\n急舂村外雨，并舍晚来烟。\n白堕先春手，红妆最妙年。\n庞翁虽不出，门巷得相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和使君巩大监秋阅","author":"虞俦","text":"金钲鼙鼓肃秋声，画戟油幢照座明。\n千骑夹营横槊气，六花簇队焕新晴。\n雍容坛上看儒将，潦倒尊前愧老兵。\n横槊赋诗豪杰事，澄江休数谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和林子长分赠丹桂韵","author":"虞俦","text":"月桂天应惜，溪堂人与清。\n五枝蒙折赠，双目喜增明。\n红药羞丹禁，彤霞避赤城。\n剩闻烧烛赏，有底置公荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和林卿盘隐诗 其二","author":"虞俦","text":"倘佯三径里，陶冶一家春。\n笔下文为富，胸中道不贫。\n穷通知有命，行止信非人。\n第恐归田计，翻成要路津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和绍兴钱参政贡院落成","author":"虞俦","text":"能为君王猎隽英，区区循吏笑西京。\n忽看广厦千间辟，蚤觉先春万木荣。\n有客囊中来露颖，何人垄上去佣耕。\n知公造化无遗物，咫尺龙门雷电生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郁簿","author":"虞俦","text":"先生雅意在垂虹，底事鸾栖枳棘中。\n几欲上书排北阙，却应举扇障西风。\n官清高枕梦魂好，兴动长吟诗句工。\n琐琐升沉何足道，只凭心地与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和俞孚仲游南坡 其一","author":"虞俦","text":"列岫峥嵘栋宇连，平栏曲砌俯氓廛。\n坐谈风月三千里，直傍云烟咫尺天。\n栗里尚怀陶靖节，竹林还想杜樊川。\n冷官幸有田园乐，笑谢苏公乞酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和俞孚仲游南坡 其二","author":"虞俦","text":"平昔相期汗漫游，杖藜还肯访林丘。\n君来便觉客不恶，我醉无言山自幽。\n柏子乍燃香拂袖，酪奴初试雪浮瓯。\n慈亲眉寿閒居好，谁道周南叹滞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和总管姜知阁","author":"虞俦","text":"下笔梅山漫不休，诗筒倏寄置书邮。\n分符我亦惭铜虎，问俗人谁忍佩牛。\n已洗圜扉亡久系，更教彩棒息群偷。\n年来况是催科拙，聚敛平生笑冉求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郡人汤倅中秋月","author":"虞俦","text":"怪底今宵眼界宽，银潢不动蘸金盘。\n未应天上追时好，无奈人间别样看。\n酒盏飘零惊鹤唳，笛声哀怨起龙蟠。\n经年不复南楼梦，且作三人取次欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和闻杜鹃","author":"虞俦","text":"万里归飞怪底迟，岂缘鸟道崄而奇。\n尚怀旧国初来日，偏恨群芳欲尽时。\n回首暮山宁久住，论心残月漫相知。\n何人远道长为客，为尔声声劳梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和闻莺","author":"虞俦","text":"度柳穿花故故迟，黄金新刷羽毛奇。\n惊回午梦花梢日，啼破春愁柳絮时。\n老去上林空好语，向来幽谷有谁知。\n纷纷云雨成翻覆，求友唯君慰我思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耘老弟木犀诗韵且督汉老弟同赋","author":"虞俦","text":"团饼秋光入好枝，一天风露最清时。\n管窥豹雾岩前隐，杯泛鹅黄月下宜。\n子落谁赓沧海咏，丛生应有小山知。\n惠连更喜姮娥近，底事观书却废诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耘老弟冬夜闻雨有怀","author":"虞俦","text":"蒲团睡思欲濛濛，珍重贤人酒一中。\n夜静喜听悬霤雨，寒多更怯战窗风。\n檐花细落浑疑梦，诗句频催政未工。\n雪拥红炉愁不寐，此时怀抱想君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耘老弟庆太安人恩封","author":"虞俦","text":"天上恩荣逮我亲，日边消息趁蕤宾。\n光生花诰宜多寿，喜动莱衣别有春。\n须信庆源能衮衮，故教乐事愈频频。\n明年不但郊封止，八秩重看宠渥新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耘老弟南坡芙蓉","author":"虞俦","text":"簇簇坡头锦绣丛，几番消息问来鸿。\n素商未遣先惊绿，青女何妨更染红。\n向日壅培曾覆篑，有时灌溉亦连筒。\n年来羁宦成离索，却欠看花一醉同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耘老弟得铜龟韵","author":"虞俦","text":"神龟又复化顽铜，块处潭心智莫穷。\n岂悔刳肠游梦里，还羞曳尾向涂中。\n波摇金色连山赤，星动瑶光彻夜红。\n网送吾家占瑞应，向来左顾与今同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和耘老弟喜雪","author":"虞俦","text":"天怜好景付君收，一笑春生紫绮裘。\n赋就兔园争授简，酒酣鲸海快吞舟。\n怪来柳絮穿帘额，舞上花裀衬袜钩。\n画饼丰年赊一醉，腊前三白讵应休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和探菊南坡","author":"虞俦","text":"春来自分菊成坡，秋晚何妨日一过。\n喜色忽看眉上见，霜华应向掌中多。\n一枝须索蚁浮瓮，三径从教雀可罗。\n坡下有泉唯可饮，西风吹鬓未应皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍倅同汤欧二倅春日郊行","author":"虞俦","text":"别驾联镳喜在坰，不妨修禊继兰亭。\n雅知社结池莲白，况复诗成水荇青。\n问讯梅花才半树，渐看柳絮又浮萍。\n风光流转须时赏，烂醉从今莫放醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍倅首夏闻莺","author":"虞俦","text":"芳草池塘晚，垂杨院宇清。\n梦回初恨蝶，春去懒闻莺。\n翠幄何须恋，金丸恐见惊。\n一枝栖更稳，好去凤凰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍倅暴雨大水之作","author":"虞俦","text":"坳堂方笑芥为舟，骤雨俄惊汇众流。\n天漏不知何处补，地卑转觉此生浮。\n会须击水扶摇上，政想乘风汗漫游。\n宦海陆沉聊尔耳，诗人休咏白蘋洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和潘接伴韵","author":"虞俦","text":"久矣闻名忻识面，哦诗一字果何难。\n笔端风月窥天巧，句里冰霜饱岁寒。\n自昔登坛须老将，祇今握节愧粗官。\n相逢忽有新篇赠，病眼摩挲得细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和潘簿旅怀","author":"虞俦","text":"朔风动关塞，羁人先自知。\n忘情须我辈，了事岂儿痴。\n雁信凭谁寄，蛩吟暗自悲。\n遣排消底物，不饮复何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜舟过龟山","author":"虞俦","text":"长淮东下月西流，起视龟山势若浮。\n砢岸崎岖须列炬，波涛汹涌更行舟。\n今秋暴涨尤堪畏，去岁坚冰亦合忧。\n有底往来能屑屑，痴儿了事几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐书怀 其一","author":"虞俦","text":"看镜功名不用频，醉乡境界几由旬。\n何妨走马来为问，纵未成龙亦有神。\n生计一丝宁挂眼，閒居百事不如人。\n惊鸿亦有高飞意，姑傍花前过却春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐书怀 其二","author":"虞俦","text":"梦觉谁呼小玉频，分灯魔女笑波旬。\n暮年禅悦浑知味，少日文章岂有神。\n赤脚玉川容老婢，绿珠金谷漫佳人。\n玄冥不是梅花主，开尽南枝付与春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜来四鼓枕上闻雨声喜而不寐","author":"虞俦","text":"雨声天外倒银潢，枕上才闻喜欲狂。\n鼓吹不须教两部，稻粱行庆有千仓。\n青缸照影花无睡，红袂行云梦有香。\n最好空阶泻檐溜，却疑并舍压糟床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"委长洲赵丞祷雨阳山龙祠有应","author":"虞俦","text":"不向龙祠小乞灵，连宵那得雨冥冥。\n势方聚处中心喜，声渐微时侧耳听。\n便觉田头秧稻绿，更誇陇首麦苗青。\n丰登自此无公事，只有棠阴蔽广庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学录李诗翁以诗访予于乳溪之上且求县学积俸偶值窘匮恨不能满其意漫以数语送之第饥来不堪煮耳","author":"虞俦","text":"二月江南花气昏，锦囊诗话喜重温。\n百篇换去东湖骨，一醉招来北海魂。\n投老黄尘真左计，半生青眼向谁论。\n学宫乞俸能多少，骥子怜渠蚤候门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]