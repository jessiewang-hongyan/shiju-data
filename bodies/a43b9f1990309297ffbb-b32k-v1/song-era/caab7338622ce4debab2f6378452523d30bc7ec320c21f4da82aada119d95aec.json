[{"title":"明发西馆晨炊蔼冈四首 其四","author":"杨万里","text":"何须名苑看春风，一路山花不负侬。\n日日锦江呈锦样，清溪倒照映山红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发西馆晨炊蔼冈四首 其三","author":"杨万里","text":"也知水碓妙通神，长听舂声不见人。\n若要十分无漏逗，莫将戽斗镇随身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发西馆晨炊蔼冈四首 其二","author":"杨万里","text":"人家争住水东西，不是临溪即背溪。\n拶得一家无去处，跨溪结屋更清奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发西馆晨炊蔼冈四首 其一","author":"杨万里","text":"盘蔬盂饭趁朝饥，争指枯肠作地基。\n不觉南山新笋蕨，搀先占却未多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发阶口岸下","author":"杨万里","text":"破晓篙师报放船，今朝不似昨朝寒。\n梦中草草披衣起，爱看轻舟下急滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发房溪二首 其二","author":"杨万里","text":"青天白日十分晴，轿上萧萧忽雨声。\n却是松梢霜水落，雨声那得此声清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发房溪二首 其一","author":"杨万里","text":"山路婷婷小树梅，为谁零落为谁开。\n多情也恨无人赏，故遣低枝拂面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发泷头","author":"杨万里","text":"黑甜偏至五更浓，强起侵星敢小慵。\n轮与山云能样懒，日高犹宿夜来峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发祁门悟法寺溪行险绝六首 其六","author":"杨万里","text":"已是山寒更水寒，酸风苦雨并无端。\n诗人瘦骨无半把，一任残春料理看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发祁门悟法寺溪行险绝六首 其五","author":"杨万里","text":"山行政好又逢溪，况是危峰斗下时。\n知与此溪有何隙，遣它不去祗相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发祁门悟法寺溪行险绝六首 其四","author":"杨万里","text":"溪行尽处却穿山，忽有人家并有田。\n幸自惊心小宁贴，误看田水作深川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发祁门悟法寺溪行险绝六首 其三","author":"杨万里","text":"山不人烟水不桥，溪声浩浩雨萧萧。\n何须双鹭相温暖，鹭过还教转寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发祁门悟法寺溪行险绝六首 其二","author":"杨万里","text":"一派泉从千丈崖，轰霆跳雪泻将来。\n无论惊杀行人著，两岸诸峰震欲摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发祁门悟法寺溪行险绝六首 其一","author":"杨万里","text":"右缘绝壁左深溪，头上春霖脚底泥。\n溪里仰看应落胆，闭窗关轿不教知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发青泥冲雪刺船三首 其三","author":"杨万里","text":"红玉麒麟未作灰，自温琼液写银杯。\n雪花万片江千顷，更欠人间底物来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发青泥冲雪刺船三首 其二","author":"杨万里","text":"碧玉波头绿锦絪，玉妃踏舞袜生尘。\n先生奇观谁分却，不分孤舟独钓人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发青泥冲雪刺船三首 其一","author":"杨万里","text":"冰棹风船雪满篷，诗人醉卧水晶宫。\n追程未到君休问，且启琼窗看玉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发海智寺遇雨二首 其二","author":"杨万里","text":"可惜新年雨未多，不妨剩与决天河。\n农人皱得眉头破，无水种秧君奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发海智寺遇雨二首 其一","author":"杨万里","text":"枉教一月费春风，不及朝来细雨功。\n草色染来蓝样翠，桃花洗得肉般红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发窄溪晚次严州","author":"杨万里","text":"夕照落帆乌石滩，朝来解缆窄溪边。\n篙师好语君知否，一日风行两日船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发鸭步","author":"杨万里","text":"两岁春船各一时，今年船快去年迟。\n青山面目何曾改，清晓看来别样奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发梅州","author":"杨万里","text":"市小山城寂，船稀野渡忙。\n金暄梅蕊日，玉冷草根霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明发韶州过赤水渴尾滩","author":"杨万里","text":"船下惊滩浪政喧，花汀水退走沙痕。\n一峰忽自云端出，只见孤尖不见根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松关","author":"杨万里","text":"竹林行尽到松关，分付双松为把门。\n若放俗人来一个，罚渠老瓦十分盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松阴小憩","author":"杨万里","text":"不但先生倦不苏，仆夫也自要人扶。\n青松数了还重数，只是从前八九株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松声","author":"杨万里","text":"哦诗口角恰微鸣，唤得风从月胁生。\n端为先生醒醉耳，绕山搜出万松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊光口","author":"杨万里","text":"风平浪静不生纹，水面浑如镜面新。\n忽有暗流江底出，衮翻水面作车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟无锡雨止遂游惠山","author":"杨万里","text":"天教老子不空回，船泊山根雨顿开。\n归去江西人问我，也曾一到惠山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊流潢驿潮风大作二首 其二","author":"杨万里","text":"潮来潮去有何功，费尽辛勤办一风。\n若使无风潮自至，信他海伯有神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊流潢驿潮风大作二首 其一","author":"杨万里","text":"忽看草树总离披，记得沙行昨日时。\n除却潮来无别事，海风动地亦何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊鸭步","author":"杨万里","text":"江流自在水风轻，云去天来半欲晴。\n两岸东西三十里，李花独树隔江明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊船百花洲登姑苏台二首 其二","author":"杨万里","text":"客里逢春了不知，牡丹剩买十来枝。\n东风动地从渠恶，吹尽杨花无可吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊船百花洲登姑苏台二首 其一","author":"杨万里","text":"二月尽头三月初，系船杨柳拂菰蒲。\n姑苏台上斜阳里，眼度灵岩到太湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浅夏独行奉新县圃","author":"杨万里","text":"我来官下未多时，梅已黄深李绿肥。\n只怪南风吹紫雪，不知屋角楝花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炬火发誓节渡勇家店二首 其二","author":"杨万里","text":"昨午秋阳尚壮哉，今晨莫待日光催。\n麻蒸一照三十里，底用金莲花炬来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炬火发誓节渡勇家店二首 其一","author":"杨万里","text":"飘炉飞空落晓星，随风入草化秋萤。\n莎虫误认天明了，却变寒声作暖声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盱眙军无梅郡圃止有蜡梅两株二首 其二","author":"杨万里","text":"腊里花开已是迟，西湖十月见琼肌。\n岭头犹说南枝暖，却向淮南觅北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盱眙军无梅郡圃止有蜡梅两株二首 其一","author":"杨万里","text":"只道横枝春未回，又疑不肯犯寒开。\n逢人问讯花消息，不识江梅只蜡梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直宿南宫三首 其三","author":"杨万里","text":"秋热连宵睡不成，移床换枕到天明。\n今宵不热还无睡，却为宫檐泻雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直宿南宫三首 其二","author":"杨万里","text":"今年秋暑更禁它，无计商量奈热何。\n一霎飘萧凉一日，雨来销得几多多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直宿南宫三首 其一","author":"杨万里","text":"独直南宫午独吟，祥云淡淡竹阴阴。\n小风慢落鹅黄雪，看到槐花一寸深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"练湖放闸二首 其二","author":"杨万里","text":"水簟南舒去转虚，天檐北卸望来无。\n相传一万四千顷，老眼初惊见练湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"练湖放闸二首 其一","author":"杨万里","text":"满耳雷声动地来，窥窗银浪打船开。\n练湖才放一寸水，跳作冰河万雪堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"细雨","author":"杨万里","text":"孤闷无言独倚门，梅花细雨欲黄昏。\n可怜檐滴不脱洒，点点何曾离旧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗溪望夫岭二首 其二","author":"杨万里","text":"行役家家寄刀尺，谁将枯骨带心头。\n惟有望夫心志苦，甘霖偏为七娘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗溪望夫岭二首 其一","author":"杨万里","text":"藁砧不寄大刀头，化作峰头石也愁。\n岂有心情管风雨，向人弹泪绕天流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪登舟","author":"杨万里","text":"深于池沼浅于河，动地风来也不波。\n只道东来行役苦，胡床面面是菱荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒三首 其三","author":"杨万里","text":"冰和菜把菜和冰，心喜冬菹齿却憎。\n且忍牙车寒一点，教他胸次雪千层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒三首 其二","author":"杨万里","text":"添尽红炉著尽衣，一杯方觉暖如痴。\n人言霜后寒无奈，春在瓮中渠不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒三首 其一","author":"杨万里","text":"畏暑长思雪绕身，苦寒却愿柳回春。\n晚来斜日无多暖，映著西窗亦可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其二 虎川","author":"杨万里","text":"居士欹黄帽，曾来照晚晴。\n至今流㶁㶁，犹学咏诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表弟周明道工于传神而山水亦佳久别来访赠以绝句二首 其二","author":"杨万里","text":"侬家有轴郭熙山，堕在冰溪雪岭间。\n有弟新来眼如月，为侬洗手拾将还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表弟周明道工于传神而山水亦佳久别来访赠以绝句二首 其一","author":"杨万里","text":"笔端人物更江山，外弟周郎两不难。\n可把吴松半江水，博他头上进贤冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗情","author":"杨万里","text":"只要雕诗不要名，老来也复减诗情。\n虚名满世真何用，更把虚名赚后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诚斋步月 其二","author":"杨万里","text":"桂树何曾不长枝，月轮却有不圆时。\n若教桂树只管长，拶拆月轮谁补伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诚斋步月 其一","author":"杨万里","text":"先生散发步庭中，孤月行天露满空。\n已入广寒宫里去，如何别觅广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诚斋待月","author":"杨万里","text":"红稠碧秀暗山园，只有诚斋眼界宽。\n月近竹梢偏不上，要人不看要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郎石峰","author":"杨万里","text":"四旁不与众山连，特地孤尖立半天。\n碧落诸峰非不好，让它郎石一峰先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金凤花","author":"杨万里","text":"细看金凤小花丛，费尽司花染作工。\n雪色白边袍色紫，更饶深浅四般红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金鸡石在玉山东二首 其二","author":"杨万里","text":"头高尾下翠毵毵，却恐相传是妄谈。\n十七里头徐老店，檐东道北北桥南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金鸡石在玉山东二首 其一","author":"杨万里","text":"相传石里两金鸡，不记胡商凿取时。\n一只遭擒一飞去，至今月落不曾啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵官舍后圃散策二首 其二","author":"杨万里","text":"旋种花窠二百株，不知种了有花无。\n阿谁便向春工说，急捣红蓝染玉酥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵官舍后圃散策二首 其一","author":"杨万里","text":"江梅未落杏先繁，萱草都齐柳半匀。\n却是浅寒花较耐，东风未要十分温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金溪道中","author":"杨万里","text":"野花垂路止人行，田水偏寻缺处鸣。\n近浦人家随曲折，插秧天气半阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金罂花联句","author":"杨万里","text":"两日风狂雨更颠，取将暖去正衣单。\n金罂花发关谁事，何用夜来如许寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓雪舟倦睡","author":"杨万里","text":"小阁明窗半掩门，看书作睡政昏昏。\n无端却被梅花恼，特地吹香破梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中入城送赵吉州器之二首 其二","author":"杨万里","text":"村店农忙半不开，入城客子去还来。\n阿耶乌伞儿青笠，卖却松柴买菜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中入城送赵吉州器之二首 其一","author":"杨万里","text":"拂溪杨柳缕生金，栏路山矾香杀人。\n不是冲泥送行客，外头放过若干春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中出湖上送客","author":"杨万里","text":"细雨轻烟著地昏，湖波真个解生尘。\n净慈灵隐君休觅，失却诸峰不恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中过沙滩二首 其二","author":"杨万里","text":"烟雨新图学不成，烟能明晦雨能声。\n莫教一点春风起，卷尽空濛写晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中过沙滩二首 其一","author":"杨万里","text":"常州草虫天下无，可怜枉却许工夫。\n濛濛拂拂沙滩艇，别是荆溪烟雨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中远望惠山二首 其二","author":"杨万里","text":"诗人也是可怜生，不及穿云渡水僧。\n不是惠山看不见，只教遥见不教登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中远望惠山二首 其一","author":"杨万里","text":"准拟归时到未迟，归时不到悔来时。\n惠山不识空归去，枉与常州作住持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中梅花","author":"杨万里","text":"霜晴三日不胜佳，忽作阴霖送岁华。\n客里清愁自无奈，却教和雨看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中道旁丛竹","author":"杨万里","text":"竹色岂不好，道旁端可嗔。\n只教寒雨里，将冷洒行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中遣闷","author":"杨万里","text":"船篷深闭膝难安，四面千峰不得看。\n莫厌霏微闷人雨，插秧怕热爱轻寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中酴醾","author":"杨万里","text":"翡翠堆头乱不梳，梅花脑子糁肌肤。\n夜来急雨元无事，晓起看花一片无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中懒困","author":"杨万里","text":"城头欲上苦新泥，暖气薰人软欲痴。\n睡又不成行不是，强来看打洛神碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]