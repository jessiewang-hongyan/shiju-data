[{"title":"宫词 其六十四","author":"张公庠","text":"殿琯吹灰报载阳，内家相庆互飞觞。\n绣工未必能终日，昼景谁知一线长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二","author":"张公庠","text":"朱字衙香伴玉炉，丁丁莲漏月来初。\n文龙画烛摇红影，准拟君王夜读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十八","author":"张公庠","text":"西苑春深奉翠华，朱栏千万护珍葩。\n不如直上红楼去，尽见琼林十里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十一","author":"张公庠","text":"南交司令已清和，满殿薰风日未斜。\n院院迎凉帘尽捲，金槃初赐御园瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十六","author":"张公庠","text":"仙韶一部选轻盈，独得君王记姓名。\n中使忽来催侍宴，匆匆不许暂调笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十四","author":"张公庠","text":"闹紫繁红裹绿枝，一番风雨尽离披。\n瑞香独占深闺暖，帘外春寒都不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三","author":"张公庠","text":"秘阁新开别殿西，玉蟾蜍对玉狻猊。\n奏书未惬君王意，内省夫人看御批。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十九","author":"张公庠","text":"圣主忧勤览万机，日高前殿步舆归。\n太官进膳传呼速，御合翩翩入禁扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十九","author":"张公庠","text":"柳放金丝搭矮槐，御沟清影见楼台。\n落花流出宫城去，不似武陵容客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十","author":"张公庠","text":"踏青来往殊无倦，斗草输赢且少休。\n更上琼楼三十级，待看春色满皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十七","author":"张公庠","text":"佳人唯是惜韶年，懒向红窗理管弦。\n锦席安排胡蝶局，深宫不忌赌金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十七","author":"张公庠","text":"月上觚棱进钥初，持更卫士匝千庐。\n动筒忽自银台人，把烛君王看捷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十七","author":"张公庠","text":"宜春苑傍夹城东，从驾宫嫔乐亦同。\n偶会不须张锦幕，游人已在百花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十一","author":"张公庠","text":"过腊愆阳陇麦低，御封香合奉精祈。\n君王晓入凝华殿，远近楼台看雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十四","author":"张公庠","text":"清旦宫中候上番，银潢轻淡玉钩残。\n山茶破萼江梅发，尽倚朱栏不避寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十三","author":"张公庠","text":"仙籞梅开淡淡春，夜来微雨渗轻尘。\n风和日暖难凋落，不怕倚楼吹笛人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十二","author":"张公庠","text":"欲下金阶剪牡丹，夜来风雨怯轻寒。\n腰如束素天然细，不为伤春带自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十二","author":"张公庠","text":"阊阖门开晓色回，禁涂迢递接银台。\n华簪簇簇呼班后，黄伞亭亭过殿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十八","author":"张公庠","text":"仙籞春妍奉宴嬉，楼台偏与柳梢宜。\n鸣鞘声入千花去，黄伞低斜步步移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十一","author":"张公庠","text":"鸾帐薰衣赐御香，花阴未动日初长。\n人闲相约寻芳去，春困不禁千步廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十二","author":"张公庠","text":"学士承宣到玉堂，中官锁院月侵廊。\n白麻诞告千官喜，皇子初封一字王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十","author":"张公庠","text":"北斗回杓欲建寅，宫嫔排备立春时。\n镌花贴子留题处，只待金銮学士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十八","author":"张公庠","text":"萱草初长花未开，共知青帝领春回。\n珠帘卷上琼钩稳，不碍薰风满殿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十九","author":"张公庠","text":"浴兰佳节共欢娱，亭午香飞鹊尾炉。\n万里开疆元不战，金奁犹进辟兵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十六","author":"张公庠","text":"度腊深宫暖未回，半天金碧照楼台。\n百花须待东风发，只有寒梅傲雪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十六","author":"张公庠","text":"显谟延阁照西清，玉轴牙签各有名。\n圣略秘机贻万世，君王垂拱致升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十六","author":"张公庠","text":"小宴轻阴挑菜时，才人来进赏春诗。\n翔鸾台下梅先萼，射鸭池边柳未丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十九","author":"张公庠","text":"绮袖时宜不甚宽，自拈刀尺勘双鸾。\n锦茵拂掠春宵静，怯见飞蛾傍烛盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十七","author":"张公庠","text":"过社馀寒迤逦消，东风送暖燕营巢。\n皇都春色宜登览，十二楼高出柳梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十二","author":"张公庠","text":"天津一望碧泱泱，宫女移舟逐晚凉。\n只见平波红影动，不知莲艳间新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十","author":"张公庠","text":"晓漏初传第一筹，碧霄零露滴清秋。\n常娥收拾金波尽，不向鸳鸯瓦上流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十二","author":"张公庠","text":"菊吐金英媚晚秋，紫宸朝退幸西楼。\n内家排设珠帘捲，铁网珊珊十二钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十三","author":"张公庠","text":"杨花飞去落谁家，紫禁人闲惜岁华。\n谩向园林觅春色，折残枝上两三花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十八","author":"张公庠","text":"长乐疏钟常送月，灵和垂柳只从风。\n还知天上人难老，颜色年年不减红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十六","author":"张公庠","text":"倦饮情怀春晼晚，宫槐新叶未成阴。\n和风习习帘帘捲，轻絮翩翩院院深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十二","author":"张公庠","text":"雨罢莓苔聊点砌，风停杨柳暂藏楼。\n明朝同奉昭阳宴，左右分明试彩毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十九","author":"张公庠","text":"天语放朝春雨急，浓云偏傍禁城低。\n喧呼万马争归路，落絮飞花半作泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七","author":"张公庠","text":"月落银台初勘契，一声金锁禁门开。\n千官耸辔争朝路，驺士笼街宰相来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九","author":"张公庠","text":"赫日炎风昼鼓迟，中官宣问到黄扉。\n传呼宰相槐街静，青盖摇摇未午归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十七","author":"张公庠","text":"选进良家备六宫，仙姿时得本从容。\n由来真色生人世，不在巫山十二峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十七","author":"张公庠","text":"西苑池台驾幸时，内家朱毂尽陪随。\n满宫学士多题咏，不减词臣应制时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八","author":"张公庠","text":"晨光初动阁门开，百辟匆匆避路回。\n千步画廊敲杖子，朱衣双引相公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十八","author":"张公庠","text":"牡丹花品最为尊，内苑栽培特地繁。\n宫女多情看未足，不离雕槛到黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十","author":"张公庠","text":"上林随驾赏芳辰，曲赐黄封腊味醇。\n供帐不须劳幕士，垂杨为盖草为茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一","author":"张公庠","text":"学士经筵论古今，花塼日上两三寻。\n天颜有喜人知否，认得唐虞用意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六","author":"张公庠","text":"八月金茎露有华，晨曦才上散馀霞。\n朱书十字黄封酒，先赐王公执政家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十一","author":"张公庠","text":"年华先到未央宫，嬉赏班班四序中。\n潇洒梅花元耐雪，轻狂柳絮不嫌风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十","author":"张公庠","text":"诞圣嘉辰卜万年，寿觞初进起炉烟。\n仙韶才奏齐天曲，三十六宫人尽传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十五","author":"张公庠","text":"银汉横斜近建章，九重深静闭兰房。\n六更未觉晨光动，自是仙家日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十六","author":"张公庠","text":"黄罗双幅裹除书，新拜昭容称意无。\n真色不劳施粉黛，香闺虚挂十眉图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十三","author":"张公庠","text":"残晖未落两三竿，放散笙歌晚思闲。\n暂上层楼聊一望，红尘多处是人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十六","author":"张公庠","text":"禁园春去偶同行，杏子垂垂叶底青。\n烧酒初尝人乐饮，绿槐阴下倒银瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十一","author":"张公庠","text":"绣幕盘龙四面开，清和时候已春回。\n五弦调畅宸衷乐，坐觉薰风万里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一○○","author":"张公庠","text":"朝退人归亚禁扃，金吾收仗暂纵横。\n诸郎入省鸣驺闹，低帽扬鞭一字行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十九","author":"张公庠","text":"已过清明侍宴稀，绿窗春睡绉罗衣。\n残红并逐狂风去，只有桐花不解飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十三","author":"张公庠","text":"自昔丰穰为上瑞，万箱腾颂奏君前。\n史臣螭陛闻宣付，日历先书大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十四","author":"张公庠","text":"红芳渐少绿阴多，留得韶光满内家。\n不用金炉添麝炷，深闺剩挂木香花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十一","author":"张公庠","text":"冉冉残晖画阁西，宫人行乐恋芳时。\n遥闻索辇开黄伞，不尽花前半局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春途中","author":"张公庠","text":"一年春事又成空，拥鼻微吟半醉中。\n夹路桃花风雨过，马啼无处避残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡斋宴坐","author":"张公庠","text":"为州容散诞，真慰野人情。\n撼膝禅初悟，摇头句未成。\n试香秋院静，斗墨午窗明。\n已有东归计，柴扉掩姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游白鹤山","author":"张公庠","text":"初眠宫柳未成阴，马上聊为拥鼻吟。\n远宦情怀消壮志，好花时节负归心。\n别离长恨人南北，会合休辞酒浅深。\n欲把春愁闲抖擞，乱山高处一登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十四","author":"张公庠","text":"月澹中官放钥回，倚云宫殿掖门开。\n綵床百步黄罗帕，于阗名王进玉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十三","author":"张公庠","text":"六宫称贺各依班，庆诞遥瞻紫气间。\n中贵推排龙喜宴，大臣分奏两郊坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十","author":"张公庠","text":"清秋皓月正婵娟，的历华星亦遍天。\n欲上层楼须稳步，不同平地有金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十五","author":"张公庠","text":"宴起昭阳索辇时，炉香偏上赭红衣。\n金门玉砌明如昼，宫女三千把烛归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十一","author":"张公庠","text":"共惜流芳甚掷梭，初移夏琯已清和。\n百花飞尽酴醾发，留得春光数日多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四","author":"张公庠","text":"宿麦葳蕤绿未回，恶风惟解卷尘埃。\n平明瑞雪深三尺，万岁声中贺表来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十七","author":"张公庠","text":"中使传呼喜复忙，尽催歌舞到昭阳。\n薰炉烟穗须臾散，无奈衣轻不受香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十","author":"张公庠","text":"过苑中官排办时，江梅初绽两三枝。\n春寒呵手晨妆罢，帘外人催从驾迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十二","author":"张公庠","text":"端礼门开班已齐，金茎双立动晨晖。\n君王欲上逍遥辇，玉指纤纤整御衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十三","author":"张公庠","text":"翩翩红叶舞霜秋，紫禁人闲约胜游。\n手把金英思泛酒，登高还上去年楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张公裕","text":"马谙旧路行来滑，琴遇知音尚不弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 金石萃编云：郡丞晋陵张友仁仲父，以绍定庚寅二月十六日游澹岩，赋水调歌","author":"张友仁","text":"石屋势平旷，峭壁几巉岩。\n妙哉天造地设，谁复谓神剜。\n畴昔涪翁题品，曾说人寰稀有，岂特冠湘南。\n趁取脚轻健，相与上高寒。\n避秦者，君莫问，意其间。\n祖龙文密，至今草木尚愁颜。\n赢得功成丹鼎，久矣乘风而去，跨鹤与骖鸾。\n犹有白云在，镇日绕禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才大师归天台 其二","author":"张友道","text":"久陪译馆清流集，吟苦霜添两颔髭。\n厌驻王成思旧隐，年来却赴白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才大师归天台 其一","author":"张友道","text":"诗律密闻高九释，倦游归老旧烟霞。\n朝中半是名臣友，时寄新吟壁罩纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳阳","author":"张天启","text":"天入平湖远，楼深纳霁华。\n青山藏福地，碧树记人家。\n水落鱼龙蛰，风高雁鹜斜。\n古来形胜地，何事忆长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同顾状元玉文登瑞岩","author":"张天翼","text":"迢迢何处觅仙关，翠竹苍崖夕照间。\n倦鸟依依穿石磴，落花历历点苔斑。\n春残几负屑霄约，首白宁辞绝壁攀。\n乘兴相携遥蹑屐，一樽聊与赋青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张斗南","text":"辞得官来性又便，恰如病马解缰牵。\n虽无白日三声喏，赢得清宵一枕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]