[{"title":"雪中迎驾","author":"楼钥","text":"都人久不望威颜，惊喜鸣鞘风雪间。\n万井欢声迎晓仗，九天和气下人寰。\n龙楼笑启瑶池宴，鹓序欣趋玉笋班。\n道上峰头皆见日，绝胜衔烛照昆山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪窦道中","author":"楼钥","text":"城居久矣厌尘劳，来访名山写郁陶。\n客路行随流水远，征人与坐白云高。\n千林舞翠吹蓬鬓，二麦摇青照纻袍。\n努力共登天尺五，要看飞雪喷云涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿夫人挽词 其一","author":"楼钥","text":"内外言无间，初终志不移。\n白头供妇职，彤管著贤规。\n庆衍珠三树，芳先桂一枝。\n凤岑归去路，含笑不应悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹿夫人挽词 其二","author":"楼钥","text":"庆霈疏封日，姑慈不忍违。\n人方侈君赐，我独避恩辉。\n孝笃神应劳，风高家愈肥。\n新传快女婿，亦复挂冠归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨次甄云卿监簿韵","author":"楼钥","text":"四郊苗槁勃然兴，顿觉欢声满郡城。\n行且刈云成岁事，敢因喜雨记亭名。\n昔如鱼在釜中活，今见龙从地上行。\n忧国愿丰同此乐，读君佳句欲风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨次韵并呈郡守吴居父 其一","author":"楼钥","text":"一旱祷而雨，此心天与通。\n为霖三日足，起舞万家同。\n破块朝方爽，翻盆夜正中。\n随车真响应，巫觋又何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雪","author":"楼钥","text":"晓风吹起雪漫漫，来兆丰年喜有端。\n玉树琼枝无限好，雪窗高阁不胜寒。\n直疑天上梅花落，莫作人间柳絮看。\n我欲乘风游汗漫，倚栏空自羡飞翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"婺女极目亭","author":"楼钥","text":"危楼雄据郡城东，扫尽秋云快碧空。\n目力不容山隔断，诗情长与酒无穷。\n先分楼下双溪水，高挹人间万里风。\n兴逸不知真近远，五弦声里送归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富览亭","author":"楼钥","text":"城郭占佳胜，眼高贞白鼍。\n霜天开浩荡，云屋涌嵯峨。\n四面山总好，东窗江最多。\n脚跟盘巨石，吞吐任风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食","author":"楼钥","text":"辅政无功日歉然，佳时攽赉屡传宣。\n已蒙授粲仍分茗，既荷贻牟更击鲜。\n酒号流香盛宝榼，烛然新火散青烟。\n孙儿不识君恩重，但觅东宫则剧钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭宜义挽词 其二","author":"楼钥","text":"籍甚清湘守，脩名所在闻。\n宦途资畏友，家训仰严君。\n归路飞丹旐，长空惨白云。\n生刍不成奠，挥涕想江濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭宜义挽词 其一","author":"楼钥","text":"种德不在大，至诚天所亲。\n但能存一念，何用活千人。\n经笥儒风远，香山句法新。\n功名付儿辈，不必在吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾无逸郎中名燕居曰和三续社有诗次韵","author":"楼钥","text":"通地通天祇个中，千岐虽别大都同。\n两家偶尔流传盛，一贯临之内外融。\n欲境扫开心在我，浮云散尽月当空。\n感而通者从来话，不感须知自有通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾侍郎挽词 其一","author":"楼钥","text":"文献南丰裔，源流曲阜公。\n岩岩双法从，凛凛旧家风。\n金玉方交映，人琴忽并空。\n平生心地直，流庆尚无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾侍郎挽词 其二","author":"楼钥","text":"紫陌寻春日，惟公最少年。\n鳣堂惭隗始，熊轼愧卢前。\n寄我书犹湿，思君迹遽仙。\n同登今有几，挥泪抚遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝退","author":"楼钥","text":"谢事不得去，趋朝愈更难。\n谁怜八旬老，日冒五更寒。\n指冻怯持笏，腰酸强踞鞍。\n细思谁缚汝，只合挂衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游大梅山梅仙岩","author":"楼钥","text":"为忆西京梅子真，人言羽化匪沉沦。\n海濒古岙已无迹，山外高峰宁有神。\n鲠论至今光汉传，清风犹足荡秋旻。\n何须更说神仙事，终老市门良可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游西山次范丞韵","author":"楼钥","text":"东风吹我上西冈，更觉僧房白昼长。\n草色已翻新岁碧，梅花祇是去年香。\n好山围绕屏三面，野竹萧森玉数行。\n千里同游逢范叔，绨袍他日未相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游径山","author":"楼钥","text":"起看海日晓团团，更挹神灯照夜阑。\n百万杉松双径杳，三千楼阁五峰寒。\n蛰龙何在渺难问，古井于今竟不眢。\n但觅灵泉归洗眼，谁能故把细书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄宫","author":"楼钥","text":"宿雨顽云拨不开，紫霄佳处访楼台。\n青山九锁固奇甚，古洞一深如此哉。\n拔地千林俱秀润，擎天一柱最崔嵬。\n出山爽气尚相属，数里清溪送我回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游香山次王正言韵","author":"楼钥","text":"四山过雨翠光流，境胜心閒自点头。\n野鸟叫春多格磔，晚风吹鬓故飕飗。\n三年几作旧山梦，一笑喜成今日游。\n独叹寒泉本无意，强随机械走溪沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游隐清 其二","author":"楼钥","text":"瀑泉奔放石坡陀，回首清游岁几何。\n脚力不如前日健，诗盟还喜故人多。\n滕王阁上无韩子，还景楼中欠老坡。\n不谓鄙言成宿谶，偶因晚涖得波波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游隐清 其一","author":"楼钥","text":"簿领丛中偷得閒，轻舆相与出乡关。\n乱流先已登孤屿，采蕨还来上北山。\n藤绕龟身增赑屃，水涵虹影照孱颜。\n老农拥道迎人笑，今日使君来破悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游隐清 其三","author":"楼钥","text":"穷冬吏鞅解纷缠，重入兹山忆少年。\n千里幸同丰岁乐，三生曾结郡人缘。\n几番山色望空外，今日水声来耳边。\n坐上何须听丝竹，与君啸咏和风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游惠山","author":"楼钥","text":"石径萦回入翠林，廿年故步喜重寻。\n千山直上云扉启，万木阴中古殿深。\n泉水泓澄风拂拂，洞门幽杳昼沈沈。\n调琴瀹茗清无限，倦客忘归到夕阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上次袁起岩安抚韵","author":"楼钥","text":"同年紫陌再寻春，力主斯盟赖尹京。\n山外斜阳湖外雪，夜来阴霭晓来晴。\n平波滟滟新添绿，冻木欣欣欲向荣。\n此日此身清洁甚，软红何苦太忙生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖亭观竞渡","author":"楼钥","text":"涵虚歌舞拥邦君，两两龙舟来往频。\n闰月风光三月景，二分烟水八分人。\n锦标赢得千人笑，画鼓敲残一半春。\n薄暮游船分散去，尚馀箫鼓绕湖滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登蕺山","author":"楼钥","text":"晚步蕺山上，休辞脚力穷。\n八松不碍眼，万里欲乘风。\n逸兴浮沧海，高歌彻太空。\n羲之不可见，犹得想胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程文简公挽词 其三","author":"楼钥","text":"设卦探羲画，随山究禹谟。\n仰天真见象，画地可成图。\n健笔凌前辈，残膏浃万夫。\n登门嗟最晚，犹得觇宏摹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程文简公挽词 其二","author":"楼钥","text":"太上崇耆旧，龙鳞手可攀。\n胡为遁荒野，竟复老商山。\n汉阁颁纶渥，瀛壖拥旆还。\n灵光遂陈迹，西望涕空潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"程文简公挽词 其一","author":"楼钥","text":"论著大哉尧，英声早已昭。\n横飞钦远业，特立仰高标。\n言议超千载，风猷耸四朝。\n惜乎经世学，不及珥金貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊月二十五日大人生朝","author":"楼钥","text":"去年沙岸倚归舟，今日驱车古涿州。\n綵服难陪莱子戏，巴词应付雪儿讴。\n客途行及五千里，寿宴须开十二楼。\n南望飞云天样远，太行山外久凝眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋慈溪挽词 其二","author":"楼钥","text":"下笔欲生风，磨砻日有功。\n推敲诗益鍊，骈俪语尤工。\n经问南雷叟，家传十八公。\n词人谁可继，文阵滑稽雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋慈溪挽词 其一","author":"楼钥","text":"伊昔丹丘去，相逢意气倾。\n楼前巾子秀，山下育泉清。\n敬梓情逾厚，交梨论益明。\n凄凉千古意，潮落又潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋德尚棋会展日次韵","author":"楼钥","text":"棋社经年能几回，身闲深幸屡参陪。\n一旬又见朋簪集，三径还因听履开。\n休苦索居徒面壁，何如相遇且衔杯。\n虽由药裹宽初约，不碍重寻旧雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢太守送雪次韵","author":"楼钥","text":"一冬祇见晓霜寒，未得飞霙万里看。\n多谢黄堂赠圭璧，欲从乳窦倚栏干。\n檐高安有冰成柱，坐久空馀水在盘。\n岁晚愿呈三白瑞，要观积玉满林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢王粹中惠白鹤山麟川观斑竹杖并竹舆","author":"楼钥","text":"麟川仙馆翠琅玕，荷子携来白鹤山。\n未效葛陂龙种化，绝胜湘浦泪痕斑。\n裁为拄杖一寻许，巧作轻舆四尺悭。\n儿子门生俱努力，病夫欲过虎溪还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢陆伯业通判示淮西小藁","author":"楼钥","text":"四海诗名老放翁，遗编俱在迹成空。\n忽从淮右传诗卷，近比剑南真父风。\n暂向壶头追马援，何当甫里访龟蒙。\n江山为助多佳句，莫惜南来寄断鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢剡中沈元龙惠诗","author":"楼钥","text":"东阳何事到东州，百语曾无一语酬。\n深羡松筠无改叶，自言蒲柳已先秋。\n千金既觉成虚掷，双璧还惊又暗投。\n别后未知何日见，但将吾道付沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢黄汝济教授惠建茶并惠山泉","author":"楼钥","text":"几年不泛浙西船，每忆林间访惠泉。\n雅好谁如广文老，亲携直到病夫前。\n细倾琼液清如旧，更瀹云芽味始全。\n或问此为真品否，其中自有石如拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢景英送郑景元篇末见属次韵","author":"楼钥","text":"张罗清似翟公门，门外都无野雀喧。\n可但风流追鲍谢，直教高论到羲轩。\n绝怜父子为知己，时把文章得细论。\n个里是非何足较，乍贤乍佞一王尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢蒋行之送菊","author":"楼钥","text":"秋老情怀尽自宽，眼前只欠菊花团。\n分来三径双株秀，先得重阳两日看。\n玉软金轻无限态，风高露冷不胜寒。\n幽人相对成清伴，正尔落英供夕餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢雷季仲枢密惠社饼","author":"楼钥","text":"宠分饼卷荷深情，割肉烹鲜不厌精。\n潭府始知严社祭，衰门又得诧侯鲭。\n洗杯用荐逡巡酒，下箸如餐谷董羹。\n回首枌榆未能去，欲随秋燕问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢僧道全惠诗并菖蒲","author":"楼钥","text":"楚楚芳荪诗样清，翠苗低护小峥嵘。\n一泓功借幽根润，六月能令凉意生。\n雁荡浑如梦边事，龙湫顿觉眼中明。\n閒窗坐对思无限，何日随君绕涧行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢滕宰彦可惠诗","author":"楼钥","text":"与君相遇海东头，明月如何忽暗投。\n自愧重来千岁鹤，永怀静对五湖鸥。\n新编不觉成三复，妙思诚堪比四愁。\n还肯来游鄮山否，与君携手上东楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢颜乐閒篆离骚","author":"楼钥","text":"乐閒下笔素推高，攻愧耽书老更饕。\n顾我好看秦小篆，烦君为作楚离骚。\n晚年应悟成歪匾，痛饮犹堪写郁陶。\n喜剧但知藏十袭，琼瑶无以报投桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲁少卿挽词 其二","author":"楼钥","text":"前辈风流泯，灵光独岿然。\n指囷推甲族，跪履记丁年。\n有子伤埋璧，惟翁亦蜕蝉。\n功名虽已矣，千载尚遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲁少卿挽词 其一","author":"楼钥","text":"棣萼仪鸳缀，翛然两鬓斑。\n时清嗟岁晚，游倦得身闲。\n人在羲皇上，经传伯仲间。\n桂枝芳未已，何止倍燕山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"携家再游姚江","author":"楼钥","text":"又作泛舟行，浮家一叶轻。\n潮生江外晚，月比夜来明。\n云尽天容彻，风高水气清。\n五湖乘兴去，何苦慕功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"粮料院葵向亭","author":"楼钥","text":"结屋苍崖昼不哗，崚嶒乱石绕帘牙。\n涛江渺莽三千顷，烟瓦参差百万家。\n雉堞环山馀暮雪，龙楼耸阙焕朝霞。\n登临可是望都省，但有葵心向日华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"群从泛湖次叔韶弟韵","author":"楼钥","text":"倚遍瀛洲十二栏，老蟾推出烂银盘。\n绝怜千顷波澜阔，更觉满身风露寒。\n境胜能令诗兴逸，夜深自喜酒肠宽。\n离离挂影清如许，莫惜终宵作意看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"肆赦小雨","author":"楼钥","text":"端门宣赦乐欢然，膏泽还应降九天。\n始觉耳边鸣摵摵，渐看笏上溜涓涓。\n我班金阙鸡竿侧，君侍玉皇香案前。\n雨立固知同陛楯，一言犹幸赖优旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦镜","author":"楼钥","text":"两溪赴壑若奔虬，此地端能截众流。\n三版放开千丈雪，一奁清彻四山秋。\n几年空自存公案，今日重新指路头。\n珍重老师成胜事，清名当与此山留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲍潮州挽词 其二","author":"楼钥","text":"客授壬辰岁，巍科盛永嘉。\n芹宫屡挥麈，竹院几烹茶。\n假守深交谊，清谈及道家。\n犹怀郡斋晚，群雀噪檐蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲍潮州挽词 其一","author":"楼钥","text":"三试皆前列，一官何后时。\n低佪广文舍，龃龉使君麾。\n遇事有如烛，卫生宁及葵。\n旧游成隔世，流涕读新碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士王公挽词 其一","author":"楼钥","text":"片言寤主上亨途，几向专城佩左鱼。\n羊陆遐冲虽坐折，高文宿愤竟谁摅。\n平时屡草千言奏，垂绝犹腾八难书。\n汉殿履声今已矣，两州遗老倍欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士王公挽词 其二","author":"楼钥","text":"短檠铁研用功深，万卷蟠胸不辍吟。\n故国遁身来济岱，壮年发藻向儒林。\n爱民利物平生事，忧国忘家一片心。\n史馆顷年陪润色，挽公无路涕盈襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士张公挽词 其一","author":"楼钥","text":"天分已高明，乐哉贤父兄。\n勋名希葛亮，问学本诸程。\n襟满英雄泪，琴亡手足情。\n相从九泉下，何处觅三英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士张公挽词 其三","author":"楼钥","text":"英略古无对，外庸今最良。\n众方期共政，人已叹云亡。\n不听尚书履，犹怀太守章。\n康庐星忽堕，丹旐袅清湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士张公挽词 其四","author":"楼钥","text":"昔幸参朝列，于公更有连。\n规模包世界，风义薄云天。\n送别诗犹在，贻书墨尚鲜。\n伟人无复见，惟务宝青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士张公挽词 其二","author":"楼钥","text":"籍甚张京兆，精神满腹中。\n才高解牛刃，手敏运斤风。\n河浒恩波远，廛间狡穴空。\n章台旧时柳，无复映金狨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士汪公挽词 其三","author":"楼钥","text":"道学不尽试，功名祇绪馀。\n立朝惟正色，荐士有遗书。\n百赎嗟无及，九京谁与居。\n莫酬推毂意，衰涕湿巾裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士汪公挽词 其一","author":"楼钥","text":"制阃诗书帅，公朝侍从臣。\n身能全进退，人可得疏亲。\n曳履声犹在，持衡迹遂陈。\n从今几百载，更复见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明殿学士汪公挽词 其二","author":"楼钥","text":"蚤岁声名大，婆娑始遇时。\n难兄屏隔坐，令子桂芳枝。\n人望还为用，天胡不慭遗。\n成蹊堪喻大，堕泪不须碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缪伯恭挽词","author":"楼钥","text":"我实由汪出，垂髫托外门。\n非惟拜先德，犹及见新婚。\n谨厚推乡曲，恩慈笃弟昆。\n善人今已矣，馀庆在儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"臧温叟挽词","author":"楼钥","text":"白首行逾恭，乡评敬此翁。\n心开上池水，气袭舞雩风。\n礼貌诸公厚，声华一瞬空。\n臧孙知有后，三世著阴功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]