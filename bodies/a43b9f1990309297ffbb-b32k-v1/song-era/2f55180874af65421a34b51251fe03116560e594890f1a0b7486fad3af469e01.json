[{"title":"蝶恋花 其八","author":"程垓","text":"小院菊残烟雨细。\n天气凄凉，恼得人憔悴。\n被暖橙香羞早起。\n玉钗一任慵云坠。\n楼上珠帘钩也未。\n数尺遥山，供尽伤高意。\n伫立不禁残酒味。\n绣罗依旧和香睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其九 月下有感","author":"程垓","text":"小院秋光浓欲滴。\n独自钩帘，细数归鸿翼。\n鸿断天高无处觅。\n矮窗催暝蛩催织。\n凉月去人才数尺。\n短发萧骚，醉傍西风立。\n愁眼望天收不得。\n露华衣上三更湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其六","author":"程垓","text":"画阁红炉屏四向。\n梅拥寒香，次第侵帷帐。\n烛影半低花影幌。\n修眉正在花枝傍。\n殢粉偎香羞一饷。\n未识春风，已觉春情荡。\n醉里不知霜月上。\n归来已踏梅花浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其七","author":"程垓","text":"楼角吹花烟月堕。\n的皪韶妍，又向梅心破。\n钗上彩幡看一个。\n赏心已觉春生坐。\n莫恨年华风雨过。\n人日嬉游，次第连灯火。\n翠幄高张金盏大。\n已拼醉袖随香亸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"程垓","text":"满路梅英飞雪粉。\n临水人家，先得春光嫩。\n楼底杏花楼外影。\n墙东柳线墙西恨。\n撷翠揉红何处问。\n暖入眉峰，已作伤春困。\n归路月痕弯一寸。\n芳心只为东风损。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"程垓","text":"晴日溪山春可数。\n水绕池塘，知有人家住。\n寻日寻花花不语。\n旧时春恨还如许。\n苦恨东风无意绪。\n只解催花，不解催人去。\n日晚荒烟迷古戍。\n断魂正在梅花浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其三 春风一夕浩荡，晓来柳色一新","author":"程垓","text":"寒意勒花春未足。\n只有东风，不管春拘束。\n杨柳满城吹又绿。\n可人青眼还相属。\n小叶星星眠未熟。\n看尽行人，唱彻阳关曲。\n心事一春何计续。\n芳条未展眉先蹙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄 赋石榴花","author":"程垓","text":"夏围初结。\n绿深深处红千叠。\n杜鹃过尽芳菲歇。\n只道无春，满意春犹惬。\n折来一点如猩血。\n透明冠子轻盈帖。\n芳心蹙破情尤切。\n不管花残，犹自拣双叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"程垓","text":"晚凉时节。\n翠梧风定蝉声歇。\n有人睡起香浮颊。\n倚著阑干，笑拣青荷叶。\n如今往事愁难说。\n曲池依旧闲风月。\n田田翠盖香罗叠。\n留得露痕，都是泪珠结。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄/一斛珠 别少城，舟宿黄龙","author":"程垓","text":"风催雨促。\n今番不似前欢足。\n早来最苦离情毒。\n唱我新词，掩著面儿哭。\n临行只怕人行远。\n殷勤更写多情曲。\n相逢已是腰如束。\n从此知他，还减几分玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"程垓","text":"木落江空又一秋。\n天寒几日不登楼。\n红绡帐里橙犹在，青琐窗深菊未收。\n新画阁，小书舟。\n篆烟熏得晚香留。\n只因贪伴开炉酒，恼得红儿一夜讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其二 寄少城","author":"程垓","text":"泪湿芙蓉城上花。\n片飞何事苦参差。\n锁深不奈莺无语，巢稳争如燕有家。\n情未老，鬓先华。\n可怜各自淡生涯。\n桃花不解知人意，犹自沾泥也学他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"程垓","text":"昨夜思量直到明。\n拂明心绪更愁人。\n风披露叶高低怨，冷雨寒烟各自轻。\n休赖酒，莫求神。\n为谁教尔许多情。\n如今早被思量损，好更当时做弄成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜天晓角 其一","author":"程垓","text":"几夜锁窗揭。\n素蟾光似雪。\n恰恨照人欹枕，纱橱爽、簟纹滑。\n迤逦篆香裛。\n好坏谁共说。\n若是知人风味，来分取、半床月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霜天晓角 其二","author":"程垓","text":"玉清冰样洁。\n几夜相思切。\n谁料浓云遮拥，同心带、甚时结。\n匆匆休惜别。\n还有来时节。\n记取江阴归路，须共踏、夜深月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉送丞相讷斋程先生二首 其二","author":"程洙","text":"公相胸中蕴识几，中和不假佩弦韦。\n人心未免自强弱，公论何尝无是非。\n岁到寒时知劲节，事当难处见圆机。\n便须再出扶宗社，未许从容恋翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉送丞相讷斋程先生二首 其一","author":"程洙","text":"先生富贵本无心，冰节从来照士林。\n三载调元名愈重，七章告老意何深。\n九重屡挽音形玉，一念难回归散金。\n此是吾邦真伟事，清风万古孰追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚怀友","author":"程洙","text":"长亭一樽酒，犹记别时斟。\n碧草思前梦，黄花见此心。\n关河秋北望，天地日西沈。\n遥想山中桂，何人月下吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨晴","author":"程洙","text":"溪雨生流水，山晴出白云。\n花来风逐逐，泥遣燕纷纷。\n客路犹千里，春光已十分。\n归从都下者，相遇说新闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月三日度白际","author":"程珌","text":"日望黄尖杪，今登白际巅。\n千山皆委地，一臂独擎天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小憩许由亭","author":"程珌","text":"历数河南去，乾坤一草亭。\n一亭犹是累，千古尽浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋无月","author":"程珌","text":"常时斗暗犹闲事，无月中秋可若何。\n我欲梯云千万丈，取光还月谢羲娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五鼓梦中作觉而成之 其二","author":"程珌","text":"当时千驷已无闻，宁说牛羊上冢行。\n同是博陵评古者，肯令千载尚龈卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五鼓梦中作觉而成之 其一","author":"程珌","text":"人生万幻一氂轻，须筑铜驼万里城。\n莫道斜阳光不远，断霞收尽十分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出南郊清甚","author":"程珌","text":"春风吹屣到南园，著酒涂酥花正繁。\n更喜满前无俗物，横塘疏竹渭南村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊子正旦贺寿慈宫 其二","author":"程珌","text":"凤驾回天仗，鸳班集露门。\n须臾趋魏阙，杲日正中暾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊子正旦贺寿慈宫 其一","author":"程珌","text":"曙色浮丹栱，春风煖禁街。\n微澜迷秀石，纤草荫新槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘将军庙","author":"程珌","text":"沙寒日薄水云愁，贼魏王吴一夜休。\n自是英雄元不死，至今犹占大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乔松","author":"程珌","text":"风细吹吟凤，雷惊起蛰龙。\n几年卧空谷，今日享真封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早入","author":"程珌","text":"紫薇浥露翠条深，捷捷灵乌振好音。\n全似冰岩亭上坐，四屏烟霭奏春禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱生论天","author":"程珌","text":"不知占得几躔星，阅尽人间聚散萍。\n今日重来桥上望，依然杨柳两行青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观史有感","author":"程珌","text":"纷纷宾客趋骠骑，何事任安太朴疏。\n却笑君非王太傅，不容朝士不回车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"两炬并花","author":"程珌","text":"双莲合蕊更开花，报道金銮日未斜。\n已草禁中新凤诏，趣君十日觐东华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别金陵官舍双柏","author":"程珌","text":"手自移时尺许长，三年拂拂及宫墙。\n愿言勿负栽培力，保此坚贞傲雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈时柏","author":"程珌","text":"陈未亡时柏已苍，风来历历说兴亡。\n世臣元不如乔木，阅尽中原几战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨","author":"程珌","text":"玄机粗透古人胸，每说匡来晚未工。\n珍重芭蕉前夜雨，为传消息到墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孟夏廿一东作秩然","author":"程珌","text":"不见东耕四十年，兹晨蓑笠去翩翩。\n从今数过三蓂朔，史笔当年大有篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拥炉","author":"程珌","text":"已甘灰冷竹窗前，那意移来近绣毡。\n唯有幽人一寒暑，闭门高卧雪深天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直庐多暇新绿郁然信笔二绝 其二","author":"程珌","text":"壁右方壶浸碧天，依然全似太湖边。\n清风一夜生新兴，好把渔竿上钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直庐多暇新绿郁然信笔二绝 其一","author":"程珌","text":"朝绝倖恩除目少，边清妖祲檄书希。\n饭馀摩腹闲行立，一抹墙东新翠薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直庐閒赋 其二","author":"程珌","text":"紫宸朝退晓光寒，百吏奔曹一吏闲。\n便可云卿称散秩，柰何名籍尚人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直庐閒赋 其一","author":"程珌","text":"一陪鸾凤入仙台，四见薰风舞禁槐。\n自笑平生无梦到，那知今日以身来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"脩玉牒官阁子坐屏甚古诘吏亦不知曷始数语纪之 其二","author":"程珌","text":"吴绡一幅苦无多，中涵大华及黄河。\n偶然乘风山下坐，紫烟翠霭坐中过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复朱教授 其一","author":"程珌","text":"诗成催雪岂无功，今果装严七宝公。\n休说春花那解舞，也教耳热慰新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复朱教授 其二","author":"程珌","text":"朝来照眼百琼瑰，为有诗筒打雪来。\n不止梁园许分简，诗坛高筑比云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春帖","author":"程珌","text":"轻烟薄雾锁平川，全似江南二月天。\n昨夜溪头新雨过，分明洗出太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭明太子宫","author":"程珌","text":"千章乔木烟苍苍，一帙遗文字字香。\n梁鼎西沉何处问，至今戟手看兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栀花","author":"程珌","text":"青琅削叶玉花钿，独占炎皇第一天。\n未羡冰桃垂夏后，且看金子粲秋前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送松煤十丸与叶秀才","author":"程珌","text":"云溪深处万松林，烟起晴天自作尘。\n根向九华分结处，与君同是墨仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李侍郎安抚浙东 其二","author":"程珌","text":"夜来天阙望文昌，移在藩臣斗极旁。\n千尺涛江元不远，公当早晚对明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李侍郎安抚浙东 其一","author":"程珌","text":"通明殿上紫芝仙，乞得闲身下九天。\n今日都门临祖处，几人惊叹著鞭先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽太府丞知徽州韩公","author":"程珌","text":"翊运勋臣第一家，却于翰墨掇英华。\n谁知忠孝千年事，不逐春风落水花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚发富池","author":"程珌","text":"甘王楼下一帆风，猎猎舟旗照日红。\n酾酒三江饮龙腹，摩挲冠冕是谁功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪霁玉堂晓眺","author":"程珌","text":"当年银界隔鲸江，今日分明玉作堂。\n不是琼林宫树密，也应白虎接明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筑径","author":"程珌","text":"入门一径小纡回，百本芙蓉手自栽。\n寄语后来须善护，三年犹及见三开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书富阳普照院 其二","author":"程珌","text":"祇爱招提古，那知俗更醇。\n寺虽炎汉代，人尚葛天民。\n僧定都忘客，林深自锁春。\n我来千载后，更有后题人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书富阳普照院 其一","author":"程珌","text":"境胜由盘古，闻名自谪仙。\n一从江国后，又到老坡年。\n山顶烟仍紫，楼头月故圆。\n继今知几劫，风物更依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王母致语","author":"程珌","text":"青鸟衔饵海边来，报道群仙浴佛回。\n玉侍双成开翠箔，云冠七胜下银台。\n万年黎角丹方转，千岁冰桃花欲开。\n更待丹成桃熟后，却来亲奉紫宸杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣节致语","author":"程珌","text":"雉尾差参宝扇开，九霞双阙耸蓬莱。\n霜清法驾黄金殿，云拥仙班紫玉杯。\n天上剖符初绕电，人间作颂已鸣雷。\n长生纪箓知多少，瓠子澄清一万回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁宗皇帝挽诗","author":"程珌","text":"圣德同天运，神功并日升。\n鞑真怀慄慄，齐鲁格烝烝。\n复古周图盛，中宗汉业升。\n未饶元结辈，磨笔诵中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用丘枢密韵","author":"程珌","text":"起自澄江应梦求，天还河北百馀州。\n嵩瀍处士归罗致，淮蔡奇谋入彀收。\n午夜金陵瞻斗极，千年胡昴灭旄头。\n会须再作中兴历，还许诸生执笔不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光宗皇后挽诗","author":"程珌","text":"玉锁辞椒禁，瑶宫问广寒。\n人间方祝鳦，天上忽飞鸾。\n弱水三山鬲，华胥一梦残。\n圣情凝望处，仙御景云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆元丁巳十月奉亲如临安宿西菩寺表弟吴克仁俱焉 其二","author":"程珌","text":"安车未向都门移，且揽西菩一段奇。\n路入山腰须种树，泉流石齿莫开池。\n重来坡老今谁是，出世参寥不记时。\n结束匆匆出门去，白云明月旧相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆元丁巳十月奉亲如临安宿西菩寺表弟吴克仁俱焉 其一","author":"程珌","text":"熙宁相望百馀年，又有人如古铁顽。\n日落尚怜今夕路，月明无恙旧时山。\n朱红野实堆盘里，粉白诗牌满壁间。\n欲为慈颜供一笑，更留数语任渠删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"作堂六桂之东命之曰桂生取汉人招隐篇桂树丛生之语也诗以记之","author":"程珌","text":"几年列植擅清芳，今日标题始作堂。\n远向松冈分老荫，近于菊畹借寒香。\n地虽未离人间世，心已全然物外乡。\n最好夜来清绝处，飞霜带月下南塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜登钓石","author":"程珌","text":"颇忆严君濑，还寻钓石缘。\n邻鸡方叫月，边雁恰书天。\n句秀来仙白，声和应乐全。\n展编真一快，如放五湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建康春教致语","author":"程珌","text":"朝来百鼓殷军门，知是元戎肃万屯。\n杀气直摧龙尾垒，英风远薄斗场村。\n从今吴卒精成勇，却看燕兵脆可掀。\n好入庙堂裨圣略，指麾诸将定中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建康鹿鸣宴致语","author":"程珌","text":"河南贡士紫萄诗，不比寻常贡士时。\n一老堂堂强国栋，四筵济济瑞庭芝。\n传闻座主趋璜召，恰与诸生赴诏期。\n宴罢琼林如谒谢，请君怀刺凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊祀庆成诗 其五","author":"程珌","text":"谓圣惟能飨，由心克致虔。\n天心今答圣，圣意更祈天。\n冲性犹勤德，搜求愈任贤。\n愚臣输至款，端在赋甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊祀庆成诗 其二","author":"程珌","text":"涓洁先原庙，纯忱历太宫。\n八神开列阙，万骑拥丰隆。\n轨道清风肃，洪颐丽日红。\n康衢听细语，八彩更重瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊祀庆成诗 其四","author":"程珌","text":"紫畤祗堂陛，苍龙奉驾回。\n边尘知电扫，岁稔十年开。\n丹凤覃天泽，东朝奉玉杯。\n楼前呼万岁，砰隐动春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊祀庆成诗 其一","author":"程珌","text":"粹古皆频岁，炎刘或异祠。\n有唐方定制，我宋遂因仪。\n列圣馨明德，皇穹答显祺。\n恭惟圣天子，大典应昌期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]