[{"title":"隆州 其三","author":"员兴宗","text":"众山环环万山过，骈首三峰当道卧。\n斗分蛇鼠旧何人，绘入麒麟今几个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆州 其四","author":"员兴宗","text":"语我冯公有味哉，巨灵恰续断鳌回。\n从今东道君公贵，免唤西州市令来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠休上人","author":"员兴宗","text":"碧眼不输岩下电，清诗迸出陇头泷。\n何须更下牢关铁，出没无心月在江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽归颍川喻夫人","author":"员兴宗","text":"夫人不讶容发暮，八十解将杯酒度。\n不见岁寒今浩亭，花开花落悲行路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清贤堂","author":"员兴宗","text":"夫子宦游三十年，乞身归老旧林泉。\n须知朝路抽簪后，不要乡人负弩前。\n儒素生涯图史富，官清门户子孙贤。\n羡君此去浑无事，满眼青山剑外天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天府","author":"员兴宗","text":"渊渊西土，惟天之府。\n昔际大吏，以貙以虎。\n不宽如之何，民亦仇止。\n不俭如之何，人亦悴止。\n有羡其输，有丰其橐。\n左公右卿，则觊我得。\n厥佐联联，乃翼乃前。\n嗟我君子，则噤不言。\n戾极而倾，疾用不宁。\n既殛既锄，伊我皇明。\n皇曰西土，惟我有痌。\n其守自今，惟宽俭是庸。\n格其难顽，慰其嚬呻。\n皇言载恩，侯心载仁。\n孰是远斯，而不率驯。\n瞻彼江梁，我民我阜。\n惟皇之德，惟侯之守。\n敢耻于词，以诏不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将军树","author":"员兴宗","text":"细马轻裘缓缓归，一樽原野亦光辉。\n如今更讶将军树，土木如何衣锦衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清风洞 其一","author":"员兴宗","text":"晚冲白鸟几飞回，夜度清猿一啸哀。\n洞閟何人获幽践，可须高李共登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清风洞 其二","author":"员兴宗","text":"万壑森寒如泼水，也复萧萧吹醉耳。\n飞乘何处觅莲莱，试唤茶颠玉川子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝霞洞 其一","author":"员兴宗","text":"欲落未落天疏星，东方作矣绛楼明。\n人间但眩长春洞，此地真如不夜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝霞洞 其二","author":"员兴宗","text":"何事杯深若邀月，端有空明供眼缬。\n朝霞□合当朝餐，绝胜石髓坚如铁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻春","author":"陈丰","text":"尽日寻春不见春，杖藜踏破几山云。\n归来试把梅花看，春在梅稍已十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春夜","author":"徐蒇","text":"斜光月映纱窗小，美荫云连翠竹高。\n花露染成香地暖，隔帘轻吹晚骚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漾花池","author":"徐蒇","text":"咽咽声残吐水龙，玉炉烟断宝樽空。\n窗前尽日无人到，只有荷花满意红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题颜鲁公祠","author":"蔡楠","text":"太师骂贼眼欲裂，由来大刚不获阙。\n堂堂忠义八十年，与贼共生宁共灭。\n泰山可摧地可陷，不可夺者公之节。\n奸邪卢杞知不知，舌舐忠臣头上血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏军山","author":"蔡楠","text":"远岫回环碧四围，一峰清绝万峰低。\n浮云复作人间雨，天上长晴世不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题秋雨堂","author":"蔡楠","text":"太宗之治万国新，梯山航海来珠珍。\n当时宝藏尽充溢，暇日从容延近臣。\n君无骄吝臣不谄，博哉仁言吾所闻。\n乃知不能正君者，虽有议论徒纷纷。\n至今华堂扁秋雨，衮衮积善归云仍。\n谁能岁晚事斯语，堂中主人丞相孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题广昌县平西台","author":"蔡楠","text":"层台跨青空，溪水出其侧。\n千峰竞神秀，万里无限隔。\n王侯贤令尹，心匠巧经画。\n平生不凡处，眼高四海窄。\n坐令荆棘场，化作山川国。\n登临有胜集，而我非佳客。\n听候妙谈兵，四座皆辟易。\n冰霜绕牙齿，韬略贯胸臆。\n乃知杜元凯，不特有传癖。\n风尘犹澒洞，早试平戎策。\n当沉岘山铭，更效燕然勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题崇觉寺","author":"蔡楠","text":"溪云障微阴，竹风消午暑。\n行穷紫翠间，金榜开梵宇。\n残僧四五辈，衣破貌淳古。\n碧筒?寒泉，屋角挂飞雨。\n高堂俨遗像，丹青烂圭且。\n当时立廊庙，兄弟皆接武。\n谁知百世士，今作一丘土。\n石麟卧斜阳，断碣枕庭庑。\n悟此笑世人，微荣何足数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登稽古阁晚眺","author":"蔡楠","text":"檐外川原迥，烟中草树微。\n山城暮吹角，客子泪沾衣。\n岁月经身老，行藏与愿违。\n归禽带落日，渺渺背人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊钓台","author":"蔡楠","text":"高台百尺凌云碧，维舟夜久霜月白。\n瘿木窣窣摇枯藤，寒濑潺潺落苍石。\n先生退隐知几年，汉家钟鼎徒凌烟。\n高风千古磨不尽，山水照映长明鲜。\n我来俯仰惭羁旅，冲寒愁怕玄冬暮。\n此身不负白鸥盟，暂此迟留亦何预。\n起来搔首江茫茫，孤篷却逐雁随阳。\n人生游行岂易得，惟有此夕难相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏新荷","author":"蔡楠","text":"朱栏桥下水平池，四面无风柳自垂。\n疑是水仙吟意懒，碧罗笺卷未题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泸江亭","author":"虞允文","text":"映水林峦影颠倒，济川舟楫势峥嵘。\n东行万里欲乘兴，更待一篙春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以笔墨送周子允发策玉堂","author":"刘仪凤","text":"腹囊英物吐长虹，翰墨区区有底功。\n也要同盟作旗鼓，三山直上一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏范志玄","author":"刘仪凤","text":"谁家游冶郎，闯首窥幽闼。\n但见脸如花，不知心似铁。\n一夕变其躯，雪姿映云发。\n昔为桃李姿，今作松篁节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饮王龟龄瑞白堂秉烛观跳珠分韵得珠字","author":"刘仪凤","text":"别来世故朝昏殊，相与言之汗模糊。\n两翁得酒促坐席，感深念极气欲苏。\n箨龙亦解作水供，细绎寻丈如渴乌。\n衣巾生秋背毛竖，金石相印环佩趋。\n江山豪壮旁尊俎，醉中频贯累累珠。\n此时一事复挂口，为乐未竟成喑呜。\n夔州忧民困汤火，润泽有志无坦途。\n眼前焦熬十万户，欠伸戏笑皆沾濡。\n自操量鼓入官廪，不输一钱分水符。\n读书功名无表畔，久矣俗吏轻吾儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自归州陆行至夔州 其一","author":"刘仪凤","text":"户口村无几，犁锄力不堪。\n林荒樗栎寿，月黑虎狼贪。\n幽绝云眠稳，清閒谷饮甘。\n故山深未极，壤断盖茅庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自归州陆行至夔州 其二","author":"刘仪凤","text":"旷野无人宿，危亭犯雨过。\n岭云堆屃赑，刹海现兜罗。\n酒触秋怀壮，天留暮色多。\n不胜行役苦，裁入竹枝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"刘仪凤","text":"嘉陵从东来，水上山突兀。\n松竹相蔽亏，烟霞互明灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和曾几留客亭 其一","author":"沈度","text":"汩汩多尘事，长怀鸠杖游。\n每因门可款，岂为醉相留。\n静契竹林胜，幽非草树秋。\n公今国耆艾，砥柱屹中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和曾几留客亭 其二","author":"沈度","text":"持节推仍世，林园记昔游。\n深藏事幽讨，长辔讵淹留。\n已见山无盗，欣同岁有秋。\n时容一啸咏，窃比晋名流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠陈常翁","author":"谢天民","text":"一经教子足三冬，议论孤高有孟公。\n学到内融多乐地，心无外慕自春风。\n我惭言偃弦歌化，君在周公礼乐中。\n三百三千烦指示，许谁蹊径一源通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"殷仲堪读书堂二首 其一","author":"向子贲","text":"云藏山色水连空，楼阁参差一望中。\n重作书台继前迹，几回池上想遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"殷仲堪读书堂二首 其二","author":"向子贲","text":"山绕溪潭碧涧开，人言中有读书堂。\n仲堪出处君休问，且对溪山酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈开善道谦禅师","author":"释吴十三","text":"元来无缝罅，触著便光辉。\n既是千金宝，何须弹雀儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"曹泳","text":"偏宜滴漏春朝雨，尤近裴公盛德堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曹泳","author":"厉德斯","text":"断尾雄鸡不畏牺，凭依掇祸复何疑。\n八千里路新州瘴，归骨中原是几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观古鱼凫城","author":"孙松寿","text":"野寺依修竹，鱼凫迹半存。\n高城归野垄，故国霭荒村。\n古意凭谁问，行人谩苦论。\n眼前兴废事，烟水又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过张白云先生故居","author":"孙松寿","text":"世外烟霞未易期，可人平野淡秋曦。\n篮舆出郭梦差好，竹杖临流意共迟。\n已觉此怀飞缥渺，不须明月问盈亏。\n仙翁骑鹤归来否，旧隐林高绿更奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋成都张氏蜀锦园 其一","author":"孙松寿","text":"池南池北蜀宫春，红湿花枝压锦城。\n袖手纵观花似笑，相看一脉话尤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋成都张氏蜀锦园 其二","author":"孙松寿","text":"乾坤开关记王春，剑阁峥嵘拱帝城。\n不许此花归阆苑，锦台南畔古今情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋成都碧鸡坊李氏石君","author":"孙松寿","text":"造化小儿斲山骨，几年流落蛟龙窟。\n太湖一碧浸玻璃，澜吞浪吐穷奔突。\n瑰奇未许困泥沙，漂出江皋空㟮屼。\n清寒偃蹇如高人，肯向蓬蒿念埋没。\n曩闻上苑饶奇珍，千形万状高嶙峋。\n当年搜索困山海，毡包席裹车辚辚。\n规模岂但肖五岳，气象直欲凌三神。\n一朝胡马窥城下，例随矢石荒荆榛。\n怜君分落幽人手，不逐尔辈污尘垢。\n首阳寂寞伯夷清，潇湘冷落三闾瘦。\n李侯胸中饱云梦，得君不用斯琼玖。\n馆之旧隐与周旋，竹士松宾三益友。\n相看一洗名利心，眉宇更清元德秀。\n君今几世德未衰，霜寒玉立癯而寿。\n咄嗟世眼多嗜好，玩形忘理十八九。\n奇章所蓄森琅玕，名标甲乙空纷然。\n到溉奇礓高崒嵂，一掷徒为负进钱。\n石君于汝非不厚，较其所得无何有，愿公世济此君为不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋张白云先生故居溪上菊","author":"孙松寿","text":"金衣绿裳仙，不嗅春风馀。\n飘摇清江练，服佩玄圃珠。\n欲骖冲霄鸾，鞭起横海鱼。\n天游浩无际，妙寄良可娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋蘧仙观古楠","author":"孙松寿","text":"风雨纵横八面看，巍然此柱欲擎天。\n壮心已与云龙会，弹指消摩八百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪申提学高行","author":"孙松寿","text":"忆昔儿童饱梨栗，斑衣偃伏先君侧。\n每闻正色说我翁，口口奇奇长太息。\n先君墓草今芊芊，尚想遗言过庭日。\n恨无佳传掬芳馨，洗我肝心百非僻。\n一朝幽镌晃入手，刓忍如怀夜光璧。\n男儿大节要奇伟，一日成就天所锡。\n我翁当年鸾鹤雏，一别旧巢无处觅。\n桑弧射处掩蓬蒿，独把窅窊飞俊翮。\n杨宗不绝仅如线，大义欲归归不得。\n凝香夜半祷灵空，愿杨有子归宫室。\n果然天助两飞鸿，翁喜当兴子云宅。\n绛霄回首拟归来，抚我恩深重嗟惜。\n弃官十载营旨甘，送死养生无一失。\n寸心安矣指白云，百拜双亲泪濡席。\n茅檐虽陋生处所，此心不以万钟易。\n几年夜泪湿衾裯，今作儿啼情自适。\n登堂悲喜动行人，里巷喧呼手加额。\n珠还合浦已无憾，老蚌沙泥忍遗逸。\n穷檐忽见相抱持，孺慕丹心始云毕。\n一子来归咏白华，三家孝爱融春色。\n雍容去就良可观，无乃扶持有神物。\n始知造化惜颓波，畀以难能令一出。\n玉堂丈人风教手，一日得之几折屐。\n何不荐之陛下圣，蜀有孝子声藉藉。\n奇人异行感至尊，凤诏褒华宠其实。\n人间一日传万口，坐使浇风四方激。\n佥谋方欲置廊庙，病卧王州嗟易箦。\n短生梦幻何足悲，此念未随生死隔。\n百身莫赎叹朝露，端合天公任其责。\n真人慨念录其孤，椽笔大书光史策。\n丈夫乃尔亦何憾，鬼哭人号空怨忆。\n萧萧绿野长安道，万里羁魂动行客。\n只今四海归宗议，字字秋霜凛寒日。\n一言我欲招翁魂，香骨有灵宜可格。\n圣朝当今以孝治，好树丰碑旌洁白。\n磨崖百丈置岩阿，当有山灵夜呵诘。\n诸郎况是足风规，请叩帝阍为此策。\n长使千秋孝子碑，屹与岷峨对翁室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"萧肃","text":"钟声出峡口，塔影落潭心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其一","author":"释元妙","text":"黄昏鸡报晓，半夜日头明。\n惊起雪狮子，瞠开红眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其二","author":"释元妙","text":"南泉肚里饱齁齁，庄主虽饥解点头。\n侍者只闻歌乐响，不知洪饮在高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释元妙","text":"万卷诗书，一时头角，才跨宗门，便施谋略。\n古归宗，真老作。\n只顾满弯弓，不知谁见双雕落。\n绝毫绝釐，如山如岳。\n堂堂气宇冠儒林，浩浩清风播寥廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释元妙","text":"常侍举笔，万事皆吉。\n直下承当，急急如律。\n米胡参官，忘前失后。\n且告贵人，为我相救。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"姚小彭","text":"山接衡湘多爽气，湖如杭颍共佳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗浮","author":"郑康佐","text":"泰华端培塿，罗浮霄汉邻。\n俯视云烟飞，冠盖摩星辰。\n凝神想至道，窈窕难具陈。\n未究访安期，伫立空逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卓锡泉","author":"郑康佐","text":"大士西方来，诛茆老幽麓。\n振锡风云上，飞泉涌山腹。\n一泓自清甘，千里田畴足。\n源深而流长，何必贵川渎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蓬莱阁","author":"郑康佐","text":"独占林泉胜，金碧耀青冥。\n凭阑俯八极，缥缈降玉京。\n群仙日往还，箫韶闻九成。\n鸾凤为君导，恍然游蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铁桥","author":"郑康佐","text":"青蜺跨两山，龙凤互撑拄。\n颉颃来双凫，孰云通步武。\n壶中杳霭閒，遐想神仙侣。\n梦锡九霞丹，翩翩游紫府。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水帘洞","author":"郑康佐","text":"仙人开碧户，玉溜泻潺淙。\n飞流散珠玑，洒落随天风。\n三伏不知暑，有如水晶宫。\n平生丘壑性，歌啸翠微中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石楼","author":"郑康佐","text":"危桥横碧汉，隐约山之巅。\n下窥沧海大，宇宙相连延。\n天风吹寒水，恍惚游飞仙。\n飘飘吹凌虚，还为尘俗牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜乐池","author":"郑康佐","text":"清籁起虚壑，笙竽惊夜眠。\n音调自谐畅，恍如奏钧天。\n真仙聚临赏，鸾鹤舞蹁跹。\n凌晨日杲杲，濯缨弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邝仙骑牛石","author":"郑康佐","text":"横笛骑青牛，岩扉自开辟。\n倏然乘风驭，云收烟灭迹。\n真人不可见，空遗旧泉石。\n我来独徘徊，日暮千山碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛仙祠","author":"郑康佐","text":"乘云朝太清，烟霞锁故宅。\n逍遥十洲上，遂与人寰隔。\n泉石独泠泠，遗灶粲朱碧。\n欲追汗漫游，安得生羽翮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄野人庵","author":"郑康佐","text":"至人隐洞天，苍苔满涧石。\n长啸响空岩，咫尺云雾隔。\n白鹤未归来，何以慰晨夕。\n流泉自涓涓，秋宵山月白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白云庵谒先君寺丞诗","author":"郑康佐","text":"清癯野鹤姿，问道羽衣客。\n白云濯飞泉，青霞窥裂石。\n閒猿啸清晓，药鸟鸣日夕。\n幽人不可见，百拜访遗迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雍千秋有东岩诗信师古和之矣次其韵","author":"侯宾","text":"洼山插曾云，古诗荫修柏。\n琅玕缭疏垣，为供窗户碧。\n地灵轻俗驾，尽扫尘埃迹。\n一新堂殿容，共诧今胜昔。\n朅来厕嘉践，深衣曳方舄。\n荒□障□风，积润藓侵壁。\n可人茶供甘，乳窦出寒液。\n□龛明石像，断碑摸铁画。\n湍江激崩岸，道路几更易。\n群山碧参差，眼境多克获。\n穷幽老不能，负我登山屐。\n狂歌击唾壶，醉墨纷狼藉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和元微之春游韵寄洪景伯","author":"李端民","text":"东阁经年别，穷愁客路难。\n望尘惊岳峙，怀旧各云散。\n茵醉恩逾厚，樯敧兴未残。\n冯唐嗟已老，范叔敢言寒。\n玉烛调魁柄，阳春在笔端。\n应怜扫门役，白首滞江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]