[{"title":"句 其九","author":"王禹称","text":"佳人方素面，对镜理新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"王禹称","text":"身后声名文集草，眼前衣食簿书堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十四","author":"王禹称","text":"秋近草虫乱，夜遥霜月寒。\n扇声犹泛暑，井气忽生秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十","author":"王禹称","text":"泽畔骚人正憔悴，道旁山鬼莫揄揶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王禹锡","text":"打叶雨拳随手去，吹凉风口逐人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登绮霞亭","author":"王秬","text":"危亭临霁景，金碧迥纷纷。\n天映中原气，山横万古云。\n夕阳寒未敛，孤鹜远犹闻。\n俯仰怀前哲，清樽为苾芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王龟龄詹事祠堂","author":"王秬","text":"当时孤论偶相同，终始知心每愧公。\n才见安车延绮季，遽嗟石室祀文翁。\n百年公议分明在，一饷纷华究竟空。\n白发旧交衰甚矣，尚能留面对高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题不欺室张魏公为王龟龄书也何子应赋诗","author":"王秬","text":"君不见开元名相张九龄，岁寒松柏森苍鳞。\n胡尘澒洞言始验，世间回首思忠臣。\n堂堂魏公忠贯日，志欲平戎奖王室。\n归来无地展经纶，馀事文章挥健笔。\n玉节朱轓两君子，不以交情变生死。\n共将新句纪遗编，留与山林续诗史。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王秬","text":"何时五亩成归计，来作邻翁伴艺林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王秬","text":"柳色知春浅，钟声觉寺深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王秬","text":"避虎连村静，分鱼一市腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王秬","text":"羊角洞开风浩荡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"王胜之","text":"蛙鼓鸣时月满川，断萤飞处草迷烟。\n敲门欲向田家宿，犹有青灯人未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晏起","author":"王说","text":"入夏酣眠醒较迟，幽人事事佔便宜。\n闲来培灌经纶种，念起澄清贤圣基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王贻永","text":"河朔雪深思爱月，并门春暖咏甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王轸","text":"南篇司马青衫湿，北句郎官白发生。\n堪与江黄永传唱，离骚经外此歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古","author":"王郡守","text":"有唐曾拥万家兵，节度西南十二城。\n此地得人无盗贼，昔之为守便公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红","author":"王重","text":"烟雨江城，望中绿暗花枝少。\n惜春长待醉东风，却恨春归早。\n纵有幽情欢会，奈如今、风情渐老。\n凤楼何处，画阑愁倚，天涯芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"王重","text":"去岁花前曾记有。\n坐醉嬉游，花下携纤手。\n粉面与花相间斗。\n星眸一转晴波溜。\n一见新花还感旧。\n泪眼逢春，忍更看花柳。\n春恨厌厌如永昼。\n□□寂寞黄昏后。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"觉林寺","author":"王钦若","text":"暂拂尘襟思倍清，竹风山色乱泉声。\n安民功浅君恩重，又策羸蹄向古城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送天柱冯先生","author":"王钦若","text":"郁萧空殿倚云霓，玉气珠辉冠紫微。\n暂到帝城朝斗会，却思岩窦负琴归。\n日奔内景乾坤静，泉漱清音杞菊肥。\n却到水乡深邃住，晴岚掩映簇春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏华林书院","author":"王钦若","text":"文明尊北极，孝友播南昌。\n礼法儿孙睦，雍和道路扬。\n地灵浮喜气，山近接岚光。\n投辖添宾榻，鸣鼙启食堂。\n纸窗刍酒响，竹径焙茶香。\n克己甘藜藿，矜贫济稻粱。\n时平安九族，家计庆千箱。\n每听游僧说，神清鬓未霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台山","author":"王钦若","text":"天台琼台标奇状，赤城瀑布悬千丈。\n中有高人混姓名，不向迷涂随得丧。\n闲寻棋侣过清溪，静拨云根种紫芝。\n八卦炉中调姹女，三田宫里守婴儿。\n太平天子秉乾箓，内宁外肃均百福。\n直符受事紫微宫，三捧灵文降黄屋。\n冲漠玄台集九真，清净洪基化兆民。\n祥风拂袂来幽谷，志士乘蹻朝玉宸。\n相见开怀忘岁月，因论微言鉴毫发。\n万壑流泉岸不枯，四时春煦花常发。\n却避红尘思旧麓，空羡冥鸿归势速。\n囊中御制宠行歌，好与黄庭同诵读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王钦若","text":"九重天阙梦掉臂，黄鸡白酒邻舍恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王钦若","text":"忆念西山玉隆友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"王钦若","text":"龙带晚烟归洞府，雁拖秋色入衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王钦若","text":"石城松柏锁烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"王钦若","text":"须知尧历初釐正，玉烛初从献岁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣化堂","author":"王闻诗","text":"圣主端居念远民，尽将休戚寄斯文。\n时来宣化堂中坐，应念田中正苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长淮晚望","author":"王卿月","text":"目断长淮渺莽中，孤城突兀倚层空。\n寒砧几许递秋信，渔笛一声横晚风。\n龙吐晴云岚气白，鸦翻落日水天红。\n扁舟今夜宿何许，赤壁断矶芦苇丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游浯溪","author":"王壶","text":"□□□□□□□，□值凄凉八百秋。\n入院伽蓝先稽首，题诗神鬼暗添愁。\n几章镌石珠玑灿，一带临江泉石幽。\n读罢中兴碑去后，逢人便举伴茶瓯。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登第诗","author":"王容","text":"天上催班晓色晴，五星伏尽极星明。\n奎章读罢三千字，胪唱传来第一声。\n名实两言虽朴语，始终一节悉真诚。\n圣恩深厚难图报，愿罄愚衷毕此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题兰亭帖","author":"王容","text":"昭陵永閟千年迹，定武相传几样碑。\n此是中原旧时本，石今焉往落东夷。\n君家何处得此纸，刻画烂然犹可喜。\n六丁神物好护持，更有诸君题姓字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净圣庵","author":"王宾","text":"乐道岩前沙路平，淡烟和月照人行。\n林端仙馆千山合，石罅灵泉一派清。\n蕴藻竞严朝斗意，琳琅惟听步虚声。\n青书奏罢黄冠睡，独有滩雷彻夜鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗二首 其二","author":"王恕","text":"忆昔韩退之，南征过吾州。\n持觞看叉鱼，妙句落芳洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗二首 其一","author":"王恕","text":"地高风易作，天漏雨偏多。\n访橘苏仙井，看碑义帝坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王恕","text":"太守班春五岭边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王悦","text":"鸡犬数声云一坞，春阳桃李渺成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王悦","text":"觚棱脱脱风尘表，峭壁垂垂日月低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙居寺","author":"王敖道","text":"灵刹倚山光，无尘染洞房。\n云笼金地暖，龙喷玉泉香。\n松竹分幽径，楼台耸上方。\n蓬壶人到此，僧伴绕回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鹿伯可致仕归天台兼简致政龙学给事吴明可丈","author":"王晓","text":"握兰肯受二毛侵，高节须知映古今。\n烟阁云台辞帝阙，风裘雪帽返家林。\n殿庭不待新鸣玉，里舍聊挥旧赐金。\n猿鹤不须惊与怨，道人轩冕本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三河道中 其一","author":"王晖","text":"龙丘风土类中原，雨势山开百里川。\n白鹭水田摩诘画，桃花溪洞武陵船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙游道中闻雁","author":"王晖","text":"避寒来热稻粱肥，水远山长结伴稀。\n已是江湖远行客，双双犹是向南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三河道中 其二","author":"王晖","text":"路入龙游不见山，纵横阡陌濲江边。\n穿篱残笋如攒槊，夹道寒花似火燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"王浻","text":"桃李清明旧著行，门旌高映郤诜堂。\n乌衣里巷钦风化，曲水杯盘乐羽觞。\n客馆早邻徐孺宅，仙居今似武夷乡。\n家声传得缃缣事，后裔扬名道更光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南涧寺阁","author":"王涤","text":"上阁便见海，入门方是山。\n塔高端似笔，城转曲如环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀潮士吴子野","author":"王涤","text":"旅悰牢落怆离群，叠翠楼前日渐曛。\n金饼光茫升海月，玉龙鳞甲护霜云。\n星星淡火随堤见，历历樵歌隔水闻。\n马足车音在何处，嶂南歧路锁烟氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠子野归潮时会大名府","author":"王涤","text":"河朔频河地早寒，城烟牢落水回环。\n几番夜雨涨新岸，一片秋云归旧山。\n君驷渐腾梅岭外，我车犹枕菊篱间。\n潮人若问何如守，病骨支撑两鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝林寺","author":"王润之","text":"支公曾驻锡，规矩旧丛林。\n飞鼠殿堂古，灵鳗井穴深。\n磬声来竹外，塔影卧池阴。\n幸有相知客，时时过我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中作","author":"王珩","text":"舂罢鸡□□，□行犬吠难。\n溪深水马健，霜重橘奴肥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅公仪留题重光寺罗汉院赠宪上人","author":"王益","text":"晓剃吟髭雪半零，海窗曾咒钵龙醒。\n蚤知西竺能持法，应笑南僧不会经。\n云气昼闲侵麈柄，藓痕春老上铜瓶。\n近来禅观都无语，手指馀花满寺庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题清凉院","author":"王益","text":"背倚青峰面枕溪，濡毫新向壁间题。\n善根不挠金莲合，净界无尘水月齐。\n会启苾刍真乐境，花开檐卜远香畦。\n因思祖塔尝游处，更在龙蟠虎踞西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅公仪新繁县显曜院","author":"王益","text":"梵宇萧条白日长，苦空谭麈接藤床。\n云章酷爱休诗丽，莲柄慵思远社香。\n石发雨梳鸡苑寂，风梭春织鹫山凉。\n劫灰心火销平尽，又听钟声下讲堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新繁县东湖瑞莲歌","author":"王益","text":"火云烁尽天幕腥，水光弄碧凉无声。\n荷华千柄拂烟际，杰然秀干骈双英。\n天敕少昊偏滋荣，宵零仙露饶金茎。\n袅袅飘风起天末，绿华珰佩来琤琤。\n觥觞式宴资击赏，何人掞藻飞笔精。\n越国亭亭八百里，木兰泛咏称明媚。\n争如锦水派繁江，孤根擢翠葩分腻。\n紫清合曜流霞晖，楚台无梦朝云飞。\n韩虢佳人新侍宠，温泉宫里赐霞衣。\n赫赫曦阳在东井，珍房萃作皇家庆。\n流火初晨复毓灵，连璧更疑唐杰盛。\n眇观熙政接元和，嘉谷重荣田野歌。\n高宗昔庆刘仁表，五色卿云世甚少。\n我今取喻进德流，优哉祥莲出池沼。\n草莱泥滓俱弃捐，致君事业殊商皓。\n归作皋夔稷卨臣，同心一德翊华勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令","author":"王益","text":"烧残绛蜡泪成痕。\n街鼓报黄昏。\n碧云又阻来信，廊上月侵门。\n愁永夜，拂香茵。\n待谁温。\n梦兰憔悴，掷果凄凉，两处销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王益","text":"不逢星汉使，谁识是灵槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"王益柔","text":"紫绂黄金太守章，旌旗遥指五云乡。\n若耶溪上朝风快，宛委山中六月凉。\n政事雍容多润泽，诗情閒淡合宫商。\n羡君一入蓬莱阁，吟醉萧然未遽央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招提院静照堂","author":"王益柔","text":"构堂幽僻断尘踪，静照为名我所通。\n一室可知天下事，十方齐见定心中。\n清朝云散层峰出，后夜潮回涨海空。\n槜李禦儿多旧迹，几时烟舸访支公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉答尧夫先生金雀石砚诗","author":"王益柔","text":"般阳有山名金雀，山发清辉产奇璞。\n望气尝言玉宝藏，贾胡几遣良工度。\n金刚宝钻竞穷搜，百里青苍困镵凿。\n琼瑰未获得研材，温润还将六美学。\n有若玉徽琴面瑩，有如金弹陶轮著。\n规天矩地形制毓，中或辟流外圭角。\n晴窗气暖墨花春，笺襞毫奔光照灼。\n吾生特好惟四物，累载裒鸠盈几格。\n先生闭户日著书，朝餐每不餍藜藿。\n高闳粱肉虽有馀，孰敢就门赒隐约。\n先生固自尝有言，不忍将身作沟壑。\n先生崖岸高莫攀，持此谓宜无见却。\n一留为惠固已多，敢冀新诗旋踵作。\n精深雅健迫风骚，使我忧荒忽惊矍。\n还如甘露醒心昏，更似神篦除眼膜。\n先生精义已入神，准易时容见涯略。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莱石茶酒器寄邵先生作诗代书","author":"王益柔","text":"宝刀切石如春泥，雕剜成器青玻璃。\n吾尝阅视得而有，惜不自用长提携。\n前时过君铜驼陌，门巷深僻无轮蹄。\n呼儿烹茶酌白酒，陶器自称藿与藜。\n爱君居贫趣閒放，一语不涉青云梯。\n嗟予都城走尘土，日远樽杓愁盐齑。\n缄封不启置墙角，顿撼时作琼瑶嘶。\n争如特寄邵高士，书帙几杖同幽栖。\n荷锄剩治田间秽，抱瓮勤灌园蔬畦。\n明年春酒或共酌，为我扫石临清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遥题钱公辅众乐亭","author":"王益柔","text":"四明旧说南湖好，岁久濒厓变涂潦。\n建旟一日得贤侯，千里山川真再造。\n偃月堤成车马道，湖光如截天如抱。\n鸳鸯瓦影乱凫鹥，绿柳环堤花映岛。\n珠宫贝阙竞来还，泉客鲛人争献宝。\n春风浩荡波涛起，彷佛仙人骑赤鲤。\n金盘下箸饱鲈鱼，尘事茫茫隔烟水。\n都人士女从如云，丝竹清音两岸闻。\n饮酣落笔歌绿水，烂漫天葩飘远芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜长新","author":"王益柔","text":"秋云朔吹晓徘徊。\n雪照楼台。\n梁王宴召有邹枚。\n相如独逞雄才。\n明烛薰炉香暖，深劝金杯。\n庭前粉艳有寒梅。\n一枝昨夜先开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题资福院平绿轩","author":"王益祥","text":"丈室无馀地，生涯小有天。\n推窗成旷阔，俯槛绕清涟。\n载酒日边客，闻歌柳外船。\n隔墙人易与，剩著买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴皮题壁 其一","author":"王真人","text":"东老回仙跨鹤归，同庵卜筑继其馀。\n自缘不睹榴皮字，想像祇园蔓草书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴皮题壁 其二","author":"王真人","text":"惟知自己贫无谄，不羡他人富有馀。\n白酒会能延羽客，清名赢得著仙书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日本僧寂照礼天台山诗","author":"王砺","text":"沧波泛瓶锡，几月到天朝。\n乡信日边断，归程海面遥。\n秋泉吟里落，霜叶定中飘。\n为爱华风好，扶桑梦自消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凉轩","author":"王秠","text":"异政丰馀暇，新轩雅构成。\n云成檐外落，魂自座中清。\n尽日松风响，通宵花月明。\n琴觞暂舒啸，才用即登瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重修山河堰","author":"王素","text":"画隼精明破晓暾，恰逢寒食过江村。\n轻烟飞絮汉中道，白苇黄茅渭上屯。\n人力万工支水派，天心两邑溉川原。\n柳营一饱源头看，夜雨新肥拍岸痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠馆人顾梅山","author":"王素行","text":"前朝相补一官归，东海僧传五字诗。\n今日蒲轮徵不去，逢人笑指鬓边丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]