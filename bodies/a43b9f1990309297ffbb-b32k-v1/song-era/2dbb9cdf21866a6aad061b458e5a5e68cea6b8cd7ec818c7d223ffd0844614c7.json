[{"title":"丽秋花","author":"张镃","text":"疏翠巧装丹凤尾，素绡轻纽玉虫须。\n春花莫把秋丛薄，若比娇妍总合输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何氏书堂","author":"张镃","text":"谁云学宦不同源，人镜风流百世存。\n想见当年临案牍，必无书限误成根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余以雪牡丹歌呈诚斋回柬云只得籍没是兵家不传之妙谓不和答也又尝以来日立夏问诚斋所谓风月库中当作何措置蒙绝句示报因次韵致谢并破前说云","author":"张镃","text":"春风欲去难留住，措置无如信野人。\n但解有诗随手和，自然日日是青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初闻湖南蛙声成三诗 其二","author":"张镃","text":"竞喜蒿蓬月到时，莫嫌喧噪没新奇。\n凭谁试问波神看，定诵南湖近日诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初闻湖南蛙声成三诗 其一","author":"张镃","text":"杏花杨柳傍清明，淡沲风光画不成。\n春到此时须急赏，绕堤今夜有蛙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初闻湖南蛙声成三诗 其三","author":"张镃","text":"皇恩汪濊及虫鱼，尔得安心大泽居。\n科斗未生休纵乐，吴侬倾听且防渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即目","author":"张镃","text":"偶然看树过平桥，老尽墙边杞术苗。\n不分蛛丝与蜗壳，也随残照集芳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其三","author":"张镃","text":"竹院桥廊未放晴，一凉生处绿交横。\n隔林休厌荷池小，风叶时传泼雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"张镃","text":"旋买花栽得野香，浴兰天气日偏长。\n槐龙或跃无人见，净扫风尘置竹床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"张镃","text":"池通幽涧碧如油，试水新鹅小拍浮。\n行过板桥花片落，被风邀上采菱舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吟诗","author":"张镃","text":"一日吟成九首诗，旁人都爱少瑕疵。\n直须作到无人爱，始是我诗长进时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听莺亭","author":"张镃","text":"墙头正对南湖柳，湖柳迎风翠扫空。\n最喜音声为佛事，乱蝉赓唱夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听琵琶","author":"张镃","text":"四弦么凤杂雏莺，不作商船塞路声。\n花影透帘清昼夜，细将拢撚说多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中口占二首 其二","author":"张镃","text":"石楠花似碎琼花，只就香中便点茶。\n欲识此堂奇绝处，山林朝暮不离家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中口占二首 其一","author":"张镃","text":"荇带荷钱渐满池，吹香隔岸尽荼蘼。\n潜鱼忽掷金梭起，补足今朝未了诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中杂书四首 其二","author":"张镃","text":"大田非但仰梅霖，百亩园中受赐深。\n著子榴梢珠迸火，放花栀树玉抽金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中杂书四首 其四","author":"张镃","text":"初生科斗聚如拳，鼓吹骎骎聒夜眠。\n料得鱼蛮生妄想，曲车那解口流涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中杂书四首 其一","author":"张镃","text":"春云天上白成行，春草人间绿自香。\n罨岸桃花三百树，碧溪休问短和长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中杂书四首 其一","author":"张镃","text":"因病经旬不赋诗，无诗病思转难支。\n今朝诗句未成了，已觉全无病可医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中杂书四首 其四","author":"张镃","text":"黄昏桥上据胡床，青霭濛笼总是香。\n未说居閒南面乐，且乘北面十分凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中雪夜二首 其二","author":"张镃","text":"急傍栏干唤酒杯，却嫌红烛炫高台。\n新图水墨兼凝粉，展向冰溪镜面开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中雪夜二首 其一","author":"张镃","text":"箫鼓喧阗乐夜堂，宝灯初试杂花光。\n欲知富贵天然处，尽把园林脑子装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园步杂兴 其二","author":"张镃","text":"豆篱黄叶被蔬田，静极情怀似黯然。\n居舍又从东壁看，柳梢浓处起厨烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园步杂兴 其四","author":"张镃","text":"池心谁放叶舟横，莲蘤还如入夏生。\n病起一天云意好，浅坡閒让鹿先行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园步杂兴 其三","author":"张镃","text":"无风寒色自凄迷，晚日低笼一径微。\n竹里鸠藏初未觉，小车行过忽横飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv