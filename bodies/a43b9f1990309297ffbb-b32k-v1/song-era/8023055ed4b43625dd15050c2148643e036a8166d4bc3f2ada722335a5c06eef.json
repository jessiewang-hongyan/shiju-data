[{"title":"偈颂九十三首 其六十六","author":"释梵琮","text":"日日途中行，夜夜家里坐。\n日日与夜夜，自然成日课。\n咄，一串数珠数不过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十四","author":"释梵琮","text":"今朝九月九，物物尽知有。\n黄花散金钱，茱萸开口笑。\n五老絮帽落风前，陶公醉石翻筋斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十三","author":"释梵琮","text":"突出山前古寺基，赵州闻得便攒眉。\n寥寥今古无人共，一片断云天外飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十一","author":"释梵琮","text":"出丛林与入丛林，一句当机绝古今。\n不涉流清到底，九江江水未为深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十","author":"释梵琮","text":"学道先须有指归，闻声见色不思议。\n九旬黑白分明处，如似盘中一片棋。\n纵横十字，一著当机。\n有眼则活，无眼则输。\n烂柯山上，空自踌躇。\n正好和盘翻却，直教脱尽规模。\n解不可得，结亦无拘。\n髑髅识尽，江海乾枯。\n憍梵波提吐舌，西天胡子无须。\n色里胶青只些子，王维妙手亦难图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十九","author":"释梵琮","text":"忻逢四老，头白如新。\n喙长百尺，鼻重千斤。\n眼随青嶂合，眉带野花颦。\n迎来送去，以表慇勤。\n为何如此，远亲不如近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十七","author":"释梵琮","text":"豁开万仞崖，劈面通消息。\n一条白练飞，界破青山色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十六","author":"释梵琮","text":"不离家舍，常在途中。\n途中家舍，触处相逢。\n人从明州来，却入庐山去。\n云间逢五老，因问途中事。\n难难，狂风吹入拆船湾。\n易易，扬澜左蠡平如砥。\n也不难，也不易，仰面看天，低头取气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十四","author":"释梵琮","text":"根从江西来，还向江西爇。\n一笑掀天只自知，天上拈来成漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十一","author":"释梵琮","text":"当门有路，冲开碧落。\n转少移身，将错就错。\n一槌打碎赵州关，空里磨盘生八角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十","author":"释梵琮","text":"赤手为提纲，豁开善法堂。\n灯笼开口笑，露柱放毫光。\n去即印住，住即印破。\n不去不住，玄关金锁。\n放开一线，无可不可。\n五老暗点头，东湖轻抹过。\n唱个月弯弯，调古无人和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十八","author":"释梵琮","text":"炳然字义，文彩希奇。\n夫子不识，达磨不知。\n同风千里，笑展双眉。\n八十翁翁入场屋，真个不是小儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十七","author":"释梵琮","text":"片纸展信旗，舒卷通消息。\n其中一个字，今古无人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十六","author":"释梵琮","text":"九月尽，十月初。\n山下开田，山上开炉。\n开田要博饭吃，开炉暖热身躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十五","author":"释梵琮","text":"白云无定，明月有期。\n欲出未出，似归不归。\n秋山呈锦绣，红叶满林飞。\n瞥不瞥，知不知。\n镜里无尘閒处照，柴头有火暗中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十四","author":"释梵琮","text":"普天迎瑞气，遍界庆生辰。\n水有朝宗意，葵倾向日心。\n衲僧随日转，林下仰天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十三","author":"释梵琮","text":"求道如求雨，乾枯日夜愁。\n忽然风雨至，万壑尽争流。\n直得天下万物沾润，三井龙王出头。\n云南如劈箭，云北似倾湫。\n激石怒雷吼，翻空雪浪浮。\n忽然风雨息，平地一时休。\n衲僧家，骑个水牯牛。\n多快活，百无忧。\n健即行，困即歇。\n布袋头，亲解结。\n钉打钉，铁打铁。\n寒道寒，热道热。\n此是诸佛心宗，亦名单提妙诀。\n七峰峰顶滑如苔，寒山拾得相拖拽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十二","author":"释梵琮","text":"今朝当八月旦，衲僧眼亲手辨。\n放出金刚箭，射落天边雁。\n蒸不熟，煮不烂。\n捏不聚，拨不散。\n解空不解深藏，惹得空中赞叹。\n休赞叹，换却天下眼睛，只消一个木槵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十一","author":"释梵琮","text":"一切即一，一即一切。\n者也之乎，鸡豚狗彘。\n蓦忽擘破面皮，喝退德山临济。\n黄檗施财，甘贽密契。\n财法二施，等无差别。\n指鹿为马，唤龟作鳖。\n说时点，点时说。\n要作破家儿孙，宜把祖灯吹灭。\n上下三指，彼此七马，如何分雪。\n休分雪，檐□细雨何曾歇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十","author":"释梵琮","text":"十五日已前是结，十五日已后是解。\n结也著，解也著，开眼合眼，伸脚缩脚。\n佛祖老婆，应病与药。\n而今正体全安，药病一时扫却。\n赤条条，空索索，月下风前啸一声，惊起松梢千岁鹤。\n错错，风吹殿角摇铃铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十九","author":"释梵琮","text":"佛如展手，道似握拳。\n全提正令，无党无偏。\n蟭螟眼里放夜市，大虫舌上打秋千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十七","author":"释梵琮","text":"三世诸佛不知有，颠狂普化翻筋斗。\n狸奴白牯却知有，寒拾相逢开笑口。\n野干鸣，师子吼。\n八两半斤，十升一斗。\n不从他觅，须还自有。\n犬不择家贫，子不嫌母丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十六","author":"释梵琮","text":"夜来无一事，天晓报上堂。\n幸好一盘饭，何用糁椒姜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十五","author":"释梵琮","text":"今朝四月初十，衲僧独行特立。\n等闲瞥转玄关，捏碎虚空出汁。\n电光里?跳，微尘里出没。\n崄峻崖前百步阶，一级自然高一级。\n脚头脚尾不争多，千里乌骓追不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十三","author":"释梵琮","text":"了知生死本来同，无数深红间浅红。\n堪笑衲僧无用处，尽将衣钵付春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十二","author":"释梵琮","text":"今朝二月二十五，等闲触发千钧弩。\n一箭中红心，大地无寸土。\n四围上下绝遮栏，露出太白庵中主。\n去岁因丧本师归，未免声声叫冤苦。\n苦中乐，乐中苦。\n喝退慈明旧日婆，移凶就吉改坟墓。\n南溪流水青如螺，深居落花红似雨。\n先师面目俨然存，分付老坚坚收取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十一","author":"释梵琮","text":"春雪消，春水足。\n春风吹起洞天云，落梅点破苍苔绿。\n言发非声，色前不物。\n百草头露眼睛，虚空里揣出骨。\n林间衲子乐无为，晓来唱个太平曲。\n新岁相逢，伏惟万福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十七","author":"释梵琮","text":"三通鼓罢，长老升堂。\n两班问信，侍者烧香。\n未曾启口，各各举扬。\n道从信入，信能主张。\n以长就短，以短从长。\n有客云外至，设供饱枯肠。\n恢恢有馀刃，别有好商量。\n暗中信手才拈得，赢得呵呵笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十五","author":"释梵琮","text":"月不过五，今日亲到。\n知时识节，随宜爱道。\n不说向上宗乘，不抛东山暗号。\n露柱与灯笼，撞著呵呵笑，韩信放铁鹞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十四","author":"释梵琮","text":"元正启祚，万物咸新。\n不劳拟议，觌体全真。\n到此更须进步，却来拂子头上翻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十二","author":"释梵琮","text":"七峰无可分岁，抖擞多年活计。\n拂子摆尾摇头，解作狮子游戏。\n等闲哮吼一声，直得惊天动地。\n东村老彻夜烧钱，地炉神不敢瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十","author":"释梵琮","text":"晴明冬至，吉无不利。\n坐卧经行，焚香扫地。\n祖师眼睛，衲僧巴鼻。\n八节四时，各安本位。\n拂子点头，欢欢喜喜。\n洞天优游，欣逢节序。\n君子道长，小人回避。\n时添一线长，光阴不虚弃。\n把定乾坤，据何道理。\n磉下藏黄金，丰城埋剑气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十八","author":"释梵琮","text":"分冬时节，一物不违。\n大家出手，各各提持。\n白糍片片打硬，山果大小随宜。\n衲僧家，牙如剑树，口似龙池。\n入齿下咬著，吞吐唾雾霏霏。\n蓦忽撞著栗棘，直得暗里攒眉。\n飏在粪扫堆上，千圣从来不知。\n洞山掇转处，丧却目前机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十七","author":"释梵琮","text":"安居九十日，閒中滋味长。\n幸好一盘饭，何用糁椒姜。\n升堂重举话，雪上更加霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十五","author":"释梵琮","text":"打鼓槌锣竞上竿，几人平地足心酸。\n七峰有个安身法，袖手无言冷处看。\n看即易，上即难。\n搭索上横身，刹竿上斗走。\n蓦忽转身，打个筋斗。\n佛祖当场，各出标手。\n微笑因拈华，一时成漏逗。\n洞山麻三斤，云门乾屎橛。\n德山入门棒，临济入门喝，阳焰何曾止得渴。\n衲僧别有条章，今日对众分雪。\n珠称夜光，剑号巨阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十四","author":"释梵琮","text":"世尊拈花，迦叶破颜。\n只因学步，失却邯郸。\n斫却庭前树，放出云外山。\n行人才眨眼，身在画图间。\n鸟飞不到处，今古绝跻攀。\n洞天人去后，谁解倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十三","author":"释梵琮","text":"赵州南，石桥北，观音院里有弥勒。\n祖师遗下一只履，直至而今觅不得。\n赵州老子，信手栽荆棘，当门种蒺藜。\n四方人不到，徒自暗攒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十二","author":"释梵琮","text":"禁足不定足，居中不住中。\n去来无挂碍，踢踏活虚空。\n射杀南山虎，翻身控角弓。\n上无攀仰，下绝己躬。\n孤迥迥一尘不立，清寥寥目断千峰。\n白云片片，流水重重。\n蓦忽和盘掇转，却要唤西作东。\n生铁团上，迸开罅缝。\n枯河道里，露出鱼踪。\n不是妙用，亦非神通。\n大家无别事，平等主人翁。\n咄，老来双耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十一","author":"释梵琮","text":"今朝正当端午节，衲僧倒用真妙诀。\n转圣作凡，点金成铁。\n却把山茶，以替竹叶。\n角黍满盘，菖蒲细切。\n虽然俗气未除，也要大家暖热。\n百草头边，艾人欢悦。\n千峰影里笑不休，野猿时把藤萝拽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十","author":"释梵琮","text":"东山水上行，乾元利贞亨。\n誵讹一个字，才子竞头争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八","author":"释梵琮","text":"太白禅师，全无伎俩。\n一锡飞来，占断千嶂。\n以中心树，建立圣像。\n合水和泥，根生土长。\n不用换骨脱胎，不须起模打样。\n一段真实身心，脑后圆光万丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四","author":"释梵琮","text":"一两三四五，六七八九十。\n坐断顶?头，千圣望不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三","author":"释梵琮","text":"据此丈室，无可不可。\n要行即行，要坐便坐。\n漆桶相挨，一时打破。\n三脚虾䗫透九垓，笑倒嵩山破灶堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄台州瑞岩高原禅师住灵隐","author":"释梵琮","text":"水出在高原，源深到冷泉。\n饮者秃却舌，嗅者鼻孔穿。\n口鼻两俱丧，妙用绝正偏。\n侧耳与招手，听猿同呼猿。\n藤萝影里石磊磊，双涧合流波涟涟。\n南来北来脚下过，欲知冷暖待驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄灭翁禅师","author":"释梵琮","text":"老去隐如虎，难瞒在一班。\n入林最容易，上树极艰难。\n舌底千溪水，眉间万叠山。\n年深拽不动，草种转痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"率庵歌","author":"释梵琮","text":"三间茅屋堪投老，草草生涯随分好。\n月池当户镜光寒，竹径绕檐通大道。\n风吹叶叶自成堆，信手拈来一茎草。\n贱如泥，贵似宝，要用便用不须讨。\n辽天鼻孔被渠穿，来往行人俱绊倒。\n阿呵呵，会也么，问取前村张四哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阐提歌","author":"释梵琮","text":"无住著，老禅魔。\n欢喜少，恶性多。\n三毒花中结苦果，蒺藜园里养蜂窠。\n说调普贤卖白象，呼唤儿童填黄河。\n戏弄南山老虎，踏翻北海沧波。\n洗尽佛祖冤，法战罢干戈。\n五千文字拭抹布，一会灵山粪扫箩。\n谩将无义语，唱起阐提歌。\n调古不堪听，声极透岩阿。\n能妙转，绝扪摩。\n六用机中抽线，电光影里撺梭。\n织成无缝袄，绣出没底靴。\n三台舞罢呵呵笑，笑倒多年黑老婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲","author":"释梵琮","text":"笑看体上衣，断云欲飞走。\n朝阳忽相逢，针眼已通透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虾子赞","author":"释梵琮","text":"斗里跳出，手中捏定。\n不入水泥，丧却性命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十六","author":"释梵琮","text":"千说万说，只是一说，春寒秋热。\n千句万句，只是一句，小出大遇。\n两段不同，收归上科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十五","author":"释梵琮","text":"旧店重开，全无买卖。\n拟欲近前，知君纳败。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十三","author":"释梵琮","text":"据此座者，说无味话。\n上下三指，彼此七马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五十二","author":"释梵琮","text":"方丈门中，了无罅缝。\n维摩文殊，相逢鼓笼。\n昨夜三更，打失鼻孔。\n普请诸人，各摸索著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其四十九","author":"释梵琮","text":"灭门刺史，破家县令。\n一句全提，头正尾正。\n塞却耳根，谛听谛听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十八","author":"释梵琮","text":"赵州庭柏，说向禅客。\n物是实价，钱须足陌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十六","author":"释梵琮","text":"百丈野狐，石女无夫。\n一回泪下，沧海乾枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七","author":"释梵琮","text":"今朝结制，事事超诣。\n问讯烧香，衲僧巴鼻。\n人事上下，巡堂次第。\n无位真人，蓦忽喷嚏。\n布袋头结，吉无不利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二","author":"释梵琮","text":"指地指天，草贼大败。\n入草求人，聊展三拜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其一","author":"释梵琮","text":"直进直出，直行直用。\n瞥转玄关，百发百中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十一","author":"释梵琮","text":"因睹明星悟道，未免全身入草。\n带累后代儿孙，却把白衣染貌。\n七峰当日见他，劈面一拳打倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六","author":"释梵琮","text":"打破虚空无缝，衲僧随处受用。\n却因圣制入山，云北云南做梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其七","author":"释深","text":"昨夜三更转向西，明眼宗师为指迷。\n若于话下寻端的，未免泥中又洗泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其三","author":"释深","text":"大家在里许，南山焦尾虎。\n牙爪利如锋，日轮正当午。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六首 其六","author":"释深","text":"东村王老夜烧钱，百万雄兵带甲眠。\n四塞八蛮皆镇静，大家拊掌贺尧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古八首 其八","author":"释深","text":"不点自行，不拨自转。\n伎俩天然，机轮如箭。\n如今分付当行家，百岁光阴已不多。\n若能直下猛提取，天上人间争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]