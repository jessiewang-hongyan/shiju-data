[{"title":"送僧之育王","author":"释慧空","text":"一庵卧病死无异，放发齐眉老更颠。\n相送无信茶一椀，江山岸下浙东船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘世美宅新架诗礼堂莱衣阁来薰台游息轩养心斋以五偈赠之 其一","author":"释慧空","text":"蚤闻彭城子，诗礼为专门。\n只今青云上，粲然见诸昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘世美宅新架诗礼堂莱衣阁来薰台游息轩养心斋以五偈赠之 其二","author":"释慧空","text":"我愿天下士，奉亲皆若此。\n家家父母前，人人老莱子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘世美宅新架诗礼堂莱衣阁来薰台游息轩养心斋以五偈赠之 其三","author":"释慧空","text":"客有跛其足，莫登主人台。\n愿为南来风，长满主人怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘世美宅新架诗礼堂莱衣阁来薰台游息轩养心斋以五偈赠之 其四","author":"释慧空","text":"窗下羲皇人，酒中桃源路。\n客非伶与潜，我醉卿且去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘世美宅新架诗礼堂莱衣阁来薰台游息轩养心斋以五偈赠之 其五","author":"释慧空","text":"心惑由多技，养之先欲正。\n纷然万化涂，廓尔大圆镜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庵前蜂去数日复返因作 其一","author":"释慧空","text":"向闻刮责抽单去，今见时难领众归。\n岁晚萧条单位在，汝饥犹可主人饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庵前蜂去数日复返因作 其二","author":"释慧空","text":"蜜岩所统众如云，客至还开甘露门。\n三扣蜜流人不荐，却言蜂子解人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庵前蜂去数日复返因作 其三","author":"释慧空","text":"无多鼓吹恼比邻，且看梅梢欲放春。\n尔辈只如前日乐，老僧何似去年贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒙庵自东山寄龙眠画寒山拾得图来令作颂寒山著屐把帚作舞拾得腰筒拍手而笑丰干骑虎搔痒视之戏书其后云","author":"释慧空","text":"二子相逢舞笑时，此翁痒发似因之。\n坐间一虎低头觑，觑著三人总是伊。\n龙眠画出意不浅，空也言之恐未然。\n更向蒙庵问端的，榴花洞口笑掀天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钝庵雪颂","author":"释慧空","text":"试看而今是甚时，文殊无地得游嬉。\n衲僧眼目难瞒处，把定乾坤未许伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钝庵见留 其一","author":"释慧空","text":"我来临汝问黄龙，君已空中定鸟踪。\n从此和君不唧?，至令同饭五华峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钝庵见留 其二","author":"释慧空","text":"虽是同居元自住，若言自住又交参。\n十成有转移身句，倒跨须弥一二三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钝庵见留 其三","author":"释慧空","text":"作伴才消木上座，同流初未许寒山。\n而今却向天台去，击动寒岩莫与闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用靖兄韵送义兄","author":"释慧空","text":"妙德熏天富，空生彻骨穷。\n同将一点雪，煅出太虚空。\n少待鹍鹏化，聊资九万风。\n殷勤问行李，一箭过辽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和讷庵送秀上人之湖湘","author":"释慧空","text":"君山清绝吾未庐，坐想寒水连汀蒲。\n公今因行得掉臂，扁舟独载如轻凫。\n凭高乞与眼界大，重磨古镜开平湖。\n潜龙无声霜月冷，白鸟出没丛芦枯。\n烟渺明边奯公渡，岳阳句里萧湘图。\n作诗模写但彷佛，佳处付公聊自娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用询山堂韵寄澹庵 其一","author":"释慧空","text":"泥牛石女本同宗，一个惟聪一个聋。\n问著威音已前事，总言裴楷号精通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用询山堂韵寄澹庵 其二","author":"释慧空","text":"休论他家种性邪，惠崇芦雁赵昌花。\n不知真假争多少，且尽杯中苦涩茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢卢居士法衣 其一","author":"释慧空","text":"鸡足山中藏不得，黄梅夜半负将归。\n而今卢老重拈出，便是山僧肩上衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢卢居士法衣 其二","author":"释慧空","text":"长者施法衣，山僧肩上搭。\n有口今懒开，只凭衣说法。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与隐上人","author":"释慧空","text":"一庵老兮藏百拙，隐不隐兮吾何说。\n空心曾食梅州梅，赤脚又踏雪山雪。\n归去来兮何似生，一朝云突辽天鹘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与正信庵吴居士","author":"释慧空","text":"心外有佛不名信，自心是佛亦非信。\n信尽心亡佛亦非，那吒手把金刚印。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与纯尧二上人","author":"释慧空","text":"东山不会禅，只解拈饭椀。\n方来英俊流，苦苦攻渠短。\n袖中出幅纸，当面换渠眼。\n不是东山痴，且要客心满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送觉允之东禅","author":"释慧空","text":"了了了，觉觉觉，万里岷峨何处著。\n全身梦入蛊毒乡，滴水石沾随饮啄。\n觉觉觉，了了了，金鸡一拍扶桑晓。\n眼开还是觉城东，急打翻身个筋斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰夏热澹庵为设招凉感而有作","author":"释慧空","text":"丹山之松有如此，猎猎苍髯自风雨。\n是中便是无烦天，咫尺人间困蒸煮。\n怜我窗轩苦未深，解枝减翠分清阴。\n我初则喜久乃愧，秀润未赴人之心。\n欲尔直为临济树，一道阴凉天下住。\n我宁独受焦灼休，无以枝叶为我忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送雪窦化士","author":"释慧空","text":"雪窦性化士，得得访空生。\n粗茶吃一椀，淡话说两声。\n贫无钱注疏，懒作偈送行。\n只有霜空月，相随到四明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧行脚","author":"释慧空","text":"两两三三独自行，风前大好水云僧。\n神光万里杖头眼，出入飞猿似不曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送岸上座出队","author":"释慧空","text":"道人自嫌不安住，四年三走黄尘路。\n那知扰扰黄尘中，暗去明来皆当处。\n观音闹市开普门，弥勒鱼行弘六度。\n道人笑我勿多谈，出门烟雨遥山渡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送延福专使 其一","author":"释慧空","text":"金身荷去万钧重，千里持来一物无。\n且喜重关俱透彻，浩歌归路倒骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送延福专使 其二","author":"释慧空","text":"剪剪江风雪应时，雪中春在老梅枝。\n朝来折作江南信，戏蝶游蜂总未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送锅头","author":"释慧空","text":"白云生处疏山寺，无水无柴世得知。\n若问道人今日事，木蛇钻破铁锅儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和草堂送通直岁归龙舒","author":"释慧空","text":"个是群中穴鼻牛，去无所犯住无留。\n须弥南畔封疆阔，水草纵横得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送实兄入闽 其一","author":"释慧空","text":"病夫不钓龙江月，倒指于今已十秋。\n君过合沙烦问讯，芦花深处旧渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送实兄入闽 其二","author":"释慧空","text":"钵饭元无那免乞，家山既有要须还。\n莫愁剑水急于箭，入得飞猿总不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠龄首座主庵 其一","author":"释慧空","text":"三关透罢复何言，一派银河落九天。\n摩竭鱼吞南海浪，扶桑人种陕西田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠龄首座主庵 其二","author":"释慧空","text":"旴水尽头居士宅，白云深处法王家。\n谁知长就无根树，便有人寻腊月花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠龄首座主庵 其三","author":"释慧空","text":"南方浩浩正谈禅，谁问君家博饭田。\n待我寒衣都补了，袖茶来访钁头边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠龄首座主庵 其四","author":"释慧空","text":"飞猿关外路纵横，云水多年取次行。\n今日有人亲坐断，往来公验要分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠龄首座主庵 其五","author":"释慧空","text":"说圆不觉拖泥水，立悟分明落二三。\n要得不移毫发许，宝云山里宝云庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与海上人","author":"释慧空","text":"信步南来谓行脚，袖手群居头似杓。\n自视初无一线长，君独喜之无乃错。\n偶北布衲翻转披，惊起黄龙跌折角。\n海兮海兮知不知，西山走入滕王阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送永兄游浙 其一","author":"释慧空","text":"峨嵋山脚蓬蒿箭，射中虚空成两片。\n惊起当年陈老师，通身是眼何曾见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送永兄游浙 其二","author":"释慧空","text":"湖南穿过来江南，无师不道无禅参。\n云门坐卧了一夏，涧水松风共对谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送永兄游浙 其三","author":"释慧空","text":"秋来射入吴中去，寄语吴人好相遇。\n承言便是过新罗，孤负东山出门句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与南雄明上人","author":"释慧空","text":"马祖接得大雄峰，一喝当机三日聋。\n近来丛林无此作，多是活埋文字中。\n君不见鬻薪客，特石坠腰供七百。\n一字不能人为书，继续衣盂是伊得。\n又不见周金刚，满车载疏游南方。\n纸灯忽灭眼睛出，白棒一挥吾道昌。\n玄中人，甚眼目，指金成鍮石作玉。\n圣凡命在渠手中，凛凛威风谁敢触。\n直得如斯未称渠，尔曹何苦犹贪书。\n是间纵得不为贵，天外出头方丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西平石蛇蛇庵 其一","author":"释慧空","text":"一段风光出当家，真成象骨与金沙。\n游人拟路庵前石，照顾南山鳖鼻蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西平石蛇蛇庵 其二","author":"释慧空","text":"头枕南山尾北山，风雪陡顿落人间。\n五台拍手峨嵋笑，此外都卢是赤斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送天衣化士","author":"释慧空","text":"化人生里家常钵，细大投之总不遗。\n今我助缘维一偈，且烦持以供天衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其一","author":"释慧空","text":"千差路上寻人，没底盂中取足。\n虽非格外风规，且是瞿昙目录。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其二","author":"释慧空","text":"诸方多是双行，疏山纯用一著。\n乞食且要及时，佛法不怕烂却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其三","author":"释慧空","text":"门外斜风细雨，窗间禅版蒲团。\n不有高人猛利，那容老者安闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其四","author":"释慧空","text":"达幻方能应物，忘心乃可循门。\n在昔我尝用此，而今持以赠君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其五","author":"释慧空","text":"直为江西老宿，便忘世路间关。\n千里一辞闽岭，四年三到疏山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其六","author":"释慧空","text":"饭在千门万户，僧离古寺名山。\n七佛已前仪式，一时顿觉追还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其七","author":"释慧空","text":"达士相逢即出，衲僧似有如无。\n上门上户讨得，堆山积岳破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其八","author":"释慧空","text":"调心不易安心易，离世非难应世难。\n要识诸君三昧力，莫辞同队到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其九","author":"释慧空","text":"人间岐路事何如，小大荣枯有万殊。\n但愿家传无底钵，尽情收拾不论渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其十","author":"释慧空","text":"秘在形山元是碍，散于人世亦非真。\n还从是碍非真处，收取归来要见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其十一","author":"释慧空","text":"收得归来一破颜，两肩荷负几多般。\n当堂放下元无物，打鼓从教普请看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其十二","author":"释慧空","text":"堂中宴坐山含月，尘里分身珠走盘。\n但得此心无住著，世间那有路行难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其十三","author":"释慧空","text":"此钵传从诸佛，大缘今在汝身。\n尽力尽心持去，上门上户寻人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化士 其十四","author":"释慧空","text":"迫促空生说偈，顿送普化上街。\n三日两日要供，十日五日要斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其一","author":"释慧空","text":"空生曾乞临江市，日与云居打饭钱。\n老入华峰无用处，君今行乞记当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其二","author":"释慧空","text":"吉山真心成抑逼，僧至参禅令乞食。\n误他多少禅家流，入不得处争著力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其三","author":"释慧空","text":"明知曰空具足器，向里得时无不是。\n及至归来放下时，笑倒南山老鳖鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其四","author":"释慧空","text":"袖里深藏大吉山，逢人拈出好生观。\n不嫌贫富僧兼俗，价数高低试著看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其五","author":"释慧空","text":"昔人遣化曾垂示，三步五步一蹙鼻。\n从缘入得即不无，七佛之仪殊未备。\n今日吉山分化人，岂在途中方瞥地。\n千差一印靡有遗，万善同归宁自利。\n不自利，非利他，家家门启通霄路，处处莲开火里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其六","author":"释慧空","text":"堆堆危危是什么，生铁馒头千万个。\n无心椀里盛将来，有眼禅人俱咬破。\n吉山安众饭亦无，终是不教渠忍饿。\n烦君普告信心人，一句当阳莫嗟过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其七","author":"释慧空","text":"空生曾乞临江市，恰似君今无别理。\n只将千圣不曾传，到处逢人水投水。\n持来满满复是谁，把得便行何拟拟。\n虽然末后有牢关，踏著归来不相似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其八","author":"释慧空","text":"一偈普送诸禅客，万化门中等慈力。\n门门对现没遮拦，箭箭离弦俱中的。\n因记芭蕉曾遣化，未出门时先话霸。\n而今更不论亲疏，收功尽在华峰下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送化主 其九","author":"释慧空","text":"少年入众先行乞，最初一步须牢实。\n多见时流昧此心，施受之间两无益。\n信心人，一粒米，重似丘山曾不止。\n持来岂是得便宜，未了分明著他底。\n贤禅贤禅宜努力，诸佛众生从此出。\n逆行顺行忽相当，户户门门成大吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泐潭化主往泉南","author":"释慧空","text":"马驹霜蹄疾如电，过处千人万人见。\n于中有个见得亲，也似不虚行一转。\n古来佛国号漳泉，此去逢人呈旧面。\n不须更拣亲与疏，是有是无都一串。\n看看激起南海波，流入西江为瀚漫。\n江西老宿问空生，但道而今成老健。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送通功二化士造大际藏经","author":"释慧空","text":"大经本无文，唐梵错翻译。\n瞿昙宣一字，至今犹未毕。\n历世痴圣人，出头竞分析。\n要使其光明，转见黑似漆。\n若入衲僧手，自是不费力。\n拈出大际山，般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]