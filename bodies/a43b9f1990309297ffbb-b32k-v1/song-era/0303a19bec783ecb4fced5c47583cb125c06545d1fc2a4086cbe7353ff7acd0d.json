[{"title":"郴江百咏 其四十五 郴江口","author":"阮阅","text":"扁舟斗转急如飞，对此令人忆退之。\n不但郴江有佳句，叉鱼祷雨尽留诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十九 乾明寺","author":"阮阅","text":"寺古僧残丈室空，我来试问老禅翁。\n直松曲棘都休道，庭下山茶为甚红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十三 兜率岩","author":"阮阅","text":"泉如铅汞流丹灶，石似珊瑚出海涛。\n不会当时融结意，区区虽巧亦何劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其四十八 崇德河","author":"阮阅","text":"楚俗声音误最多，近来方證桂门讹。\n分明流向郴人道，此水今名崇德河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十八 崇毅寺","author":"阮阅","text":"城外招提竹隐门，更无一点利名尘。\n蒲团纸帐松窗下，却有安禅藏卷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七 清淑堂","author":"阮阅","text":"三仙一相有遗风，清淑谁言到此穷。\n寄与郴阳忠信士，得名端合谢韩公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十八 绿净堂","author":"阮阅","text":"绿如青草净如渊，远近山光上下天。\n有客凭栏若相问，为言此处似蒸川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十四 黄相山","author":"阮阅","text":"东带连山接五羊，西分郴水下三湘。\n路人到此休南去，岭外千峰尽瘴乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其六十二 寒泉","author":"阮阅","text":"春欲为霜夏欲冰，一山寒气逼人清。\n应知炎冷难同处，甘与汤泉各自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其七十七 尊胜寺","author":"阮阅","text":"老僧不复识丛林，只说幽栖是息心。\n可惜一溪东去水，更无轩石称登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十一 景星观","author":"阮阅","text":"圣世休祥见景星，曾闻瑞日庆云生。\n羽人中夜来朝斗，透过松梢一点明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十六 温泉","author":"阮阅","text":"谁将炎热换清凉，可使澄泓作沸扬。\n从赐骊山妃子沐，人间处处重温汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十一 紫芝亭","author":"阮阅","text":"和气薰蒸庶草灵，昔年闻有紫芝生。\n史官不绝书祥瑞，几欲图形献此名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十一 辉松台","author":"阮阅","text":"灵寿峰前路有苔，松门依旧对山开。\n幽人野叟寻僧至，时有辉辉大旆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十四 愈泉","author":"阮阅","text":"未载人间肘后书，此名直恐是相诬。\n古人诗病知多少，试问从来疗得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八 筼筜亭","author":"阮阅","text":"娟娟细细两三丛，却厌桃花相近红。\n已有数枝湘浦月，不消千亩渭川风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十九 蒙泉","author":"阮阅","text":"流出山根无尽时，潜深不似瀑泉飞。\n此时非净还非垢，欲洗须知是钝机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其八十七 漏天","author":"阮阅","text":"从古常闻有漏天，此言恐是里人传。\n山深自合常多雨，不是娲皇补未全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十六 碧虚亭","author":"阮阅","text":"筇竹枝弯屐齿摇，登临身觉在烟霄。\n千峰险似三川峡，一水深如八月潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十 骡穴观","author":"阮阅","text":"朝辞湘楚暮山东，今在蓬莱第几峰。\n可笑时人空扰扰，武昌山下问骡踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十二 撷芳园","author":"阮阅","text":"万萼千枝二月春，只愁风雨便成尘。\n不知谁撷香英去，自有寻芳拾翠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十一 潮井","author":"阮阅","text":"朔月盈亏已可疑，随泉上下更难知。\n钱塘江在吴山外，谁见来时与落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其九十四 题春波亭","author":"阮阅","text":"数叶荷衣一短藜，春波亭上倚斜晖。\n无人会得诗中画，凭尽阑干又独归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十三 橘井","author":"阮阅","text":"苏仙旧隐已藤萝，橘井空来岁月多。\n摘叶汲泉皆朽骨，郡人犹说愈沉疴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十二 燕堂","author":"阮阅","text":"山有香炉水有瓶，斋无尘榻阁无铃。\n胡床尘拂枯藜杖，门对江山日夜扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其三十七 雕玉山","author":"阮阅","text":"㟝嵝崎岖面碧霄，何曾温润似琼瑶。\n一堆顽石郴江上，纵有昆刀不可雕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五 藏春亭","author":"阮阅","text":"百紫千红一径深，胭脂为地粉为林。\n有人来问春何在，向道花间无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十九 露仙观","author":"阮阅","text":"寂寞荒坛枕水边，长沙施药已千年。\n松间风露如前日，何事无人更得仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其五十八 醽醁泉","author":"阮阅","text":"玉为曲糵石为垆，万榼千壶汲未枯。\n山下家家有醇酒，酿时皆用此泉无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高亭山","author":"阮阅","text":"苍苍黄叶满闲亭，门对南山数点青。\n过客不知兴废事，犹言汉县是高亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿路口驿","author":"阮阅","text":"孤猿啼处宿山村，读尽离骚自掩门。\n寓意偶成长短句，半窗灯火月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄徐季秉","author":"阮阅","text":"小窗杯酒恨匆匆，别后谁来旅梦中。\n寒食东风归去后，寻盟须过蒜山东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萍乡绝句","author":"阮阅","text":"春尽江南归已迟，湘南风雨度花时。\n无因剪取湘江色，携看江屏画竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄花渡","author":"阮阅","text":"晓渡黄花溪水湍，鸣榔身在小沙滩。\n盘斜曲踏畬田去，露下星稀霜月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游紫微观","author":"阮阅","text":"春来犹未到金庭，桃杏离披柳已青。\n直待斜阳方兴尽，一筇独立紫微亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘东驿至萍乡","author":"阮阅","text":"萍乡路与醴陵通，溪上长亭草木中。\n行尽江南有山处，门前隔水是湘东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禅慧寺","author":"阮阅","text":"老僧支竹面如灰，门闭寒云冷不开。\n车马纷纷多少客，端知不是爱山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谩成三首 其三","author":"阮阅","text":"太白仙人白玉篇，逸才清思两难全。\n如今貂尾容相续，只恐巴吟不足传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谩成三首 其二","author":"阮阅","text":"心若金兰过耳馀，春来还共客东都。\n几时却泛清河水，已约荆溪共卜居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谩成三首 其一","author":"阮阅","text":"蓬池旧草绿茸茸，爱酒清谈隐者风。\n纵似步兵成底事，啸台依旧夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宣风驿","author":"阮阅","text":"浅浅泸潇水，粼粼碧玉光。\n马蹄飞电疾，突过板桥霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濡须寺","author":"阮阅","text":"筇杖芒鞋上小蓬，半篙春水饱帆风。\n两关三寺山无数，藏在濛濛烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无讼堂","author":"阮阅","text":"欲为袁人弭谤声，因将无讼榜堂名。\n他时茇舍棠休剪，近日环扉草已生。\n自是索瘢求大察，却疑束矢听难明。\n要知本乐农桑处，请看东郊垄上耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游虎丘","author":"阮阅","text":"踏石青鞋滑，西风系小舟。\n浅塘疏荇水，高树老藤秋。\n行柳乱馀兴，衰芜铺远愁。\n萧萧晚城角，排日下林头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任元受耿时举有和篇谨用韵写寄","author":"阮阅","text":"射策明光最上游，干霄直气接云浮。\n平生所闻任定祖，十年坚卧岩壑幽。\n胸中经济几韬略，价高连城人不酬。\n急流勇退莫予武，旁观谁为君王留。\n归来万事了无愧，罪我知我惟春秋。\n海沂之康谈笑事，分毫未展帷幄筹。\n倒屣能延吾党士，此客标置高南州。\n翰墨从容千万字，韵高不作河西讴。\n各持吾素报吾主，为公不必须孙刘。\n嗟我已衰人不数，去来乘雁双凫鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过萍乡","author":"阮阅","text":"悠悠休问渡江萍，山人毛人丹已成。\n路入潇湘向西去，暮云寒日下孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其二十八 成仙观","author":"阮阅","text":"仙去寥寥几百春，隐居依旧在湖濒。\n枝头禽语人难会，石上骡踪事已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其九十 龟峰铺","author":"阮阅","text":"山似龟形古戍西，路人到此欲稽疑。\n刳肠钻灼犹难信，顽石何缘解有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其十九 湖亭","author":"阮阅","text":"城外高堂俯碧湾，山如螺黛水如环。\n有时鼓棹来寻胜，直到斜阳未欲还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴江百咏 其九十一 蔡伦宅","author":"阮阅","text":"竹简韦编写六经，不知何用捣枯藤。\n自从杵臼深藏后，采楮舂桑事已更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郑良佐","author":"阮阅","text":"书生著书贪日课，文士卖文救穷饿。\n青楼歌酒属富儿，不意此名君乃荷。\n风波平地自谁始，一倡从知百人和。\n东鲁男子旧修谨，南郡诸生底逋播。\n平安敢烦街吏报，洁白长赓楚人些。\n流言不计两曾参，机上慈亲枉惊堕。\n阮舍尤须办南北，杜冠可无分小大。\n宁知宋玉笑登徒，或指宣尼作阳货。\n璧亡误使张仪去，兵利徒为少卿祸。\n违从兄食祇厚诬，偿同舍金聊引过。\n无黥可息劓可补，未信白璧青蝇涴。\n君不见吾宗孟公士所倾，亦有俗子惊人坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 赠宜春官妓赵佛奴","author":"阮阅","text":"赵家姊妹，合在昭阳殿。\n因甚人间有飞燕。\n见伊底，尽道独步江南，便江北、也何曾惯见。\n惜伊情性好，不解嗔人，长带桃花笑时脸。\n向尊前酒底，得见些时，似恁地、能得几回细看。\n待不眨眼儿、觑著伊，将眨眼底工夫，剩看几遍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 冬至","author":"阮阅","text":"晓云舒瑞。\n寒影初回长日至。\n罗袜新成。\n更有何人继后尘。\n绮窗寒浅。\n尽道朝来添一线。\n秉烛须游。\n已减铜壶昨夜筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"阮阅","text":"楼上黄昏杏花寒。\n斜月小栏干。\n一双燕子，两行征雁，画角声残。\n绮窗人在东风里，洒泪对春闲。\n也应似旧，盈盈秋水，淡淡春山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 闰上元","author":"阮阅","text":"芝检下中天，春寒犹浅。\n馀闰银蟾许重看。\n满城灯火，又遍高楼深院。\n宝鞍催绣毂，香风软。\n憔悴慢翁，萧条古县。\n随分良辰试开宴。\n且倾芳酒，共听新声弦管。\n夜阑人未散，更筹转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦堂春/锦堂春慢 留合肥林倅","author":"阮阅","text":"江入重关，山围翠巘，湖边自古巢阳。\n正梅残林坞，冰泮池塘。\n闻道当年父老，记梅福、曾隐南昌。\n有长堤万柳，映□参差，尽是甘棠。\n共夸金斗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 和田守","author":"阮阅","text":"驿使初回，新阳才报。\n时和倍觉青春早。\n华灯和月拥朱轓，花间万点寒星小。\n团扇歌清，重裀舞妙。\n游人只恐归来悄。\n明年亲侍辇舆行，未应肯记濡须好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"阮阅","text":"万壑深连郴水出，千山高拥石门开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"阮阅","text":"无水不如三峡险，有山皆似七闽深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范公同章推官登承天寺竹阁","author":"阮逸","text":"竹石寒相倚，云窗晓共开。\n闲身方外去，幽意静中来。\n坠响风随箨，移阴日上苔。\n迟留秋更夜，待月露盈杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"阮逸","text":"易立泰山石，难枯上林柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花心动 其二 春词","author":"阮逸女","text":"仙苑春浓，小桃开，枝枝已堪攀折。\n乍雨乍晴，轻暖轻寒，渐近赏花时节。\n柳摇台榭东风软，帘栊静、幽禽调舌。\n断魂远、闲寻翠径，顿成愁结。\n此恨无人共说。\n还立尽黄昏，寸心空切。\n强整绣衾，独掩朱扉，簟枕为谁铺设。\n夜长更漏传声远，纱窗映、银缸明灭。\n梦回处，梅梢半笼淡月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大江乘/念奴娇 郭县尹美任","author":"阮槃溪","text":"东阳四载，但好事、一一为民做了。\n谈笑半闲风月里，管甚讼庭生草。\n瓯茗炉香，菜羹淡饭，此外无烦恼。\n问侯何苦，自饥只要民饱。\n犹念甘旨相违，白云万里，不得随昏晓。\n暂舍苍生归定省，回首又看父老。\n听得乖崖，交章力荐，道此官员好。\n且来典宪，中书还二十四考。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦宗氏子来兄舍寄生九月初七果生侄子","author":"阳伯高","text":"昔年曾梦宗家郎，受生所自言其详。\n髼松有发重覆顶，梦里恍然如在旁。\n大人占之兆惟吉，惟熊惟罴男之祥。\n今朝诞庆果如梦，始生三日逢重阳。\n啼声已觉是英物，一门四子诚生光。\n小鱼嬉戏已成队，雏雁飞腾终作行。\n晓来搔首搜句喜，奋笔仓惶书弄獐。\n端由乃祖积德厚，诗礼有传应异常。\n新醅喜酦蒲萄绿，开樽共对篱花黄。\n揿髯一笑共引满，拜贺箕裘宗派长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下沱张西叔牡丹号奇品以诗寄花因用韵谢 其二","author":"阳枋","text":"主人骨相花难比，折赠双花副丽辞。\n为报此花香第一，何须铅粉巧妆褫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下沱张西叔牡丹号奇品以诗寄花因用韵谢 其一","author":"阳枋","text":"天香吹落五云来，满眼浮花只浪开。\n国色不关朝得酒，妆台漫饮紫金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为清溪邓茂林督工筑室","author":"阳枋","text":"欲话秋宵度两三，被人閒与担来担。\n鸠工夜夜思筹北，命仆时时费指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云游","author":"阳枋","text":"走遍天涯地角来，流沙弱水接蓬莱。\n风轮空坐观浮世，明镜亭亭不用台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"井口镇石牛诗","author":"阳枋","text":"巨石如牛溯绿漪，象名为物本无知。\n休言神禹忘疏凿，付与冯夷日箠笞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文昌醮灯牌","author":"阳枋","text":"牡丹枝上先春蕊，翠杏坛边未雨虹。\n知有文章光万丈，钟成佳气满黔中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"包家园","author":"阳枋","text":"众绿争齐敷夏荫，老红犹自驻春妆。\n閒红浪绿俱休问，争似岩松一色苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古木","author":"阳枋","text":"古木撑空万丈青，铺排峡险与江深。\n浓岚欲滴春烟暝，画出骚人一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]