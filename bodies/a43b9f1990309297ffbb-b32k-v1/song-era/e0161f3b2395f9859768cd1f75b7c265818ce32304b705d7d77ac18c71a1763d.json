[{"title":"直夜二首 其二","author":"杨亿","text":"垆销香篆霭馀芬，晏坐氍毹日易曛。\n虎圈微凉生夕籁，鹤天新霁见归云。\n通中梦稳春寒薄，肃唱声沈夜漏分。\n误濯尘缨成底事，岩阿千古有移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直夜二首 其一","author":"杨亿","text":"月魄生宵晕，风乌送晚凉。\n飞蝇随镂管，浮蚁溢清觞。\n负郭春耕废，钧天晓梦长。\n玉签声未断，落宿半宫墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦热","author":"杨亿","text":"极目长天度鸟稀，纤萝不动转晨晖。\n已裁圆月班姬扇，更换轻云子产衣。\n河朔一时觞对举，临淄万井汗交挥。\n冰丸雪散成虚设，欲借飙轮羾紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范仪下第东归","author":"杨亿","text":"君住武夷乡，思归便促装。\n溪鳞丝缕细，园茗露牙香。\n雷火悲三上，金钱困一囊。\n长缨尘土满，会待濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表弟廷评章得象知信州玉山县","author":"杨亿","text":"怀玉烟霞接武夷，我思祖德涕沾衣。\n县斋制锦留遗爱，庭树藏镮长旧围。\n彭泽公田今已废，辽东邑子半应非。\n津亭送别空搔首，籍在金门未得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"信道人归西京","author":"杨亿","text":"寝邱遗业废多年，衣裓空藏命说篇。\n北阙上书陈祖德，上林结社会时贤。\n风尘不肯留京邑，龙象重归启梵筵。\n闻有道安虽未识，定应谈论已弥天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南朝","author":"杨亿","text":"五鼓端门漏滴稀，夜签声断翠华飞。\n繁星晓埭闻鸡度，细雨春场射雉归。\n步试金莲波溅袜，歌翻玉树涕沾衣。\n龙盘王气终三百，犹得澄澜对敞扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"威上人","author":"杨亿","text":"五蕴已空诸漏尽，冢间行道十年馀。\n吟成南国碧云句，读遍西方贝叶书。\n清论弥天居士伏，高情出世俗流疏。\n问师心法都无语，笑指孤云在太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"威道人归乡","author":"杨亿","text":"闻法灵山真佛子，驰名南国本诗流。\n二林曾有香灯约，一钵因为辇毂游。\n尘土化衣慵驻锡，江湖收潦忆归舟。\n何年应制登麟殿，犀柄谈空对冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣召赴龙图阁观太宗御书应制","author":"杨亿","text":"非烟葱蔚苍龙阙，紫府深沉大帝居。\n群玉中天开策府，神龟温洛荐图书。\n珠宫岑寂经行处，金简荧煌拭目初。\n曾是先朝受恩者，因探禹穴涕涟如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"度支梁谏议请病告以诗寄之","author":"杨亿","text":"经旬不谒未央宫，宴坐将谁笑语同。\n蜀郡相如非避事，净名居士欲谈空。\n门前宾客窥行马，箧里方书拾蠹虫。\n西省旧僚疏会面，顿惊鄙吝满胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故比部李郎中挽歌四首 其四","author":"杨亿","text":"美疢漳滨卧，营魂东岱归。\n故人空渍酒，侍史罢薰衣。\n画像留家庙，铭旌出帝畿。\n浮生除寿考，享福似君稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故比部李郎中挽歌四首 其三","author":"杨亿","text":"雁序分台阁，春卿有职司。\n云屏三殿宴，绵蕝一王仪。\n风韵灵和柳，襟怀叔度陂。\n善人无复见，执绋泪空垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故比部李郎中挽歌四首 其二","author":"杨亿","text":"睦族衣无主，传家鼎有铭。\n沙堤连里巷，玉树接阶庭。\n北海樽常满，西山药不灵。\n肯堂归棣萼，含笑入泉扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故比部李郎中挽歌四首 其一","author":"杨亿","text":"陇右华宗贵，朝端懿范存。\n哀乌光列宿，驷马庆高门。\n谒帝承明署，娱宾金谷园。\n人生忽至此，天道亦难论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故枢密宋给事挽歌三首 其三","author":"杨亿","text":"永辞温室地，长别谏书帷。\n玉恨埋黄壤，星愁析紫微。\n薤歌偏怨咽，衮敛更光辉。\n可惜岑文本，辽阳不共归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故枢密宋给事挽歌三首 其二","author":"杨亿","text":"六龙初展义，七圣尽陪游。\n塞外狼烟起，军中羽檄稠。\n汉帷方借箸，庄壑忽沉舟。\n不奈良臣死，秦医亦漫求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故枢密宋给事挽歌三首 其一","author":"杨亿","text":"宸游方扈从，移疾废枢机。\n步辇亲临问，肩舁遽告归。\n忽闻号左毂，旋见泣中闱。\n城郢遗言切，忠魂定有依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故蕲州王刑部阁老挽歌五首 其五","author":"杨亿","text":"奏稿应盈箧，藏书复几车。\n门人谁渍酒，天子想投瓜。\n旅榇关山阔，铭旌道路赊。\n趋庭有令子，清白自传家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故蕲州王刑部阁老挽歌五首 其四","author":"杨亿","text":"楚客离骚怨，子牟江海心。\n积忧偏损寿，多病未妨吟。\n野鸟俄窥舍，甘棠已结阴。\n郡中应罢市，遗爱在人深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故蕲州王刑部阁老挽歌五首 其三","author":"杨亿","text":"近署罹官谤，清淮绾郡章。\n平生不佞佛，晚岁尚为郎。\n得疾因卑湿，为文足感伤。\n才蒙宣室召，奄忽叹云亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故蕲州王刑部阁老挽歌五首 其二","author":"杨亿","text":"鸡省曾三入，鳌峰近十旬。\n命书批凤尾，谏疏逆龙鳞。\n按部朱轓远，悲秋素发新。\n茂陵终不起，遗札满埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故蕲州王刑部阁老挽歌五首 其一","author":"杨亿","text":"东观未绝笔，西垣俄解龟。\n罢裁青纸诏，重入白云司。\n流落成三黜，联翩换一麾。\n黄岗与滁上，应立去思碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊即事","author":"杨亿","text":"黄鹂百啭宿烟疏，近郭行春独驻车。\n垄上劝耕聊问讯，棠阴听讼且踌躇。\n远林桑尽蚕成茧，野水萍开獭趁鱼。\n几处路旁垂苦李，游人不折意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳絮","author":"杨亿","text":"琼蕊飘英逐吹繁，建章飞舞入千门。\n羌人自怨残梅曲，庄叟还迷梦蝶魂。\n汉苑风光随猎骑，洛城花雪扑离樽。\n锦帆蔽日隋堤远，枉逐东流箭浪翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洛意","author":"杨亿","text":"蘅皋驻马独依依，寄恨微波带减围。\n泪迹不成双玉箸，身轻谁赋六铢衣。\n穿针静夜星榆出，摆手清晨雪絮飞。\n目断风帘旧巢燕，新看先傍杏梁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞户","author":"杨亿","text":"洞户飞甍接绮寮，一春幽恨寄兰苕。\n书题枉是藏三岁，壶矢谁同赛百娇。\n水国风霜凋社橘，仙山云雾隔江潮。\n东城剑骑何曾出，祇为离愁髀肉销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞溪庆道人归上都","author":"杨亿","text":"精庐宴坐十经秋，瓶钵近为千里游。\n又是浮杯过沧海，便应飞锡入皇州。\n弥天谈论降时彦，结社因缘背俗流。\n此去定知诸念息，只除魂梦到东瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独怀","author":"杨亿","text":"独依青桐听鼓声，参旗历落上三更。\n凉风捲雨忽中断，明月背云还倒行。\n赖有清吟消意马，岂无美酒破愁城。\n是非人世何须较，方外吾师阮步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狱多重囚","author":"杨亿","text":"铁锁银铛众，金科伏念频。\n绝闻空狱奏，深愧片言人。\n清颍黄公接，甘棠邵伯邻。\n怀贤不能继，多辟岂由民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中当直书怀呈诸同舍","author":"杨亿","text":"太微西掖凤池边，阿阁凌空瓦起烟。\n綵笔时批尺一诏，直庐深在九重天。\n早朝螭陛炉香近，昼寝鸡人漏唱传。\n只恐承明难久恋，长安桂玉苦相煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日有怀乡国","author":"杨亿","text":"长安久客逢摇落，不独悲秋更忆乡。\n潘岳二毛行欲变，渊明三径已应荒。\n书裁尺素鸿难托，梦绕重湖蝶自狂。\n游宦十年归未得，尘缨却悔濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨有怀李寺丞","author":"杨亿","text":"润气先从柱础知，寒宵滴滴助秋悲。\n桐圭绕树多黄落，苔锦缘阶更碧滋。\n爽彻衾裯慵就枕，凉生笺管欲题诗。\n高阳旧侣相思否，此景谁同把酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡小著克顺知泉州惠安县兼过南昌别墅","author":"杨亿","text":"平明束简下兰台，海县鸣琴亦滞才。\n厌说风尘住京洛，贪看雪浪架蓬莱。\n楚江归思鲈鱼鲙，随岸离筵竹叶杯。\n通德旧居旌阙在，辽东鹤驭少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡秘丞知浔州","author":"杨亿","text":"兰台进秩通闺籍，熊轼临民奉诏条。\n风俗重寻南越志，乡关犹隔浙江潮。\n悬知坐啸讴谣洽，更想行春意气饶。\n远宦逢秋少悲吒，潘郎玄鬓恐先凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺资政学士王侍郎","author":"杨亿","text":"沥恳青规动帝心，秋曹月殿宠光深。\n论思东序清閒宴，偃息西昆翰墨林。\n私第藏书皆有副，公庭种竹待成阴。\n卧龙禁闼应非久，救旱还须起作霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵殿丞知河南县","author":"杨亿","text":"鼎邑闾阎有古风，清谈为治自从容。\n官联殿省通朝籍，路过津桥入县封。\n柳荫天街时案辔，云生少室好支筇。\n龙门旧有题名处，石壁苍苔駮几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送石枕与参政王给事","author":"杨亿","text":"千古碧潭秋水骨，琢成孤枕冷于冰。\n因为江外朱轮守，得自林閒白足僧。\n月幌光寒吞桂魄，暑轩气爽压梅蒸。\n奇章好尚非流俗，愿向萧斋代曲肱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴航","author":"杨亿","text":"井臼荒凉旅鬓班，经年索米住长安。\n囊中卖赋金都尽，衣上悲秋泪不乾。\n客路飘蓬殊未定，侯门置醴岂成欢。\n担簦忽起东游兴，庭树西风昨夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台山","author":"杨亿","text":"小隐琼台布水边，独披金诰味重玄。\n晨凫化舄趋轩室，秋鹭翻涛逐楚船。\n养鹤七年知善舞，种芝三秀旧成田。\n飙轮不驻劳宸眷，犀管裁章与世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张蜕秀才","author":"杨亿","text":"许由流寓因相识，岁历今移十二辰。\n别墅已荒三径草，素衣犹化九衢尘。\n悬瓢颜巷安贫久，泣玉荆山失意频。\n莫向明时便招隐，重来须醉杏园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张彝宪归乡","author":"杨亿","text":"处处春波满稻畦，海棠零落子规啼。\n一麾远郡方留滞，十里长亭又解携。\n后夜滩声妨客梦，初晴云物入诗题。\n到家为问田园事，桃李犹应有旧蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵梁秀才","author":"杨亿","text":"君家罨画溪，岁晚忽思归。\n密雪不献赋，流尘空化衣。\n购书藏屋壁，温席奉庭闱。\n清世莫招隐，垂天待一飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高学士知越","author":"杨亿","text":"万壑千岩古剡中，锦旗朱毂此临戎。\n酒厨岁取公田秫，樵舸朝分射的风。\n阁吏蒸青藏史牍，席宾簪玳奉谈丛。\n海邦讼息多幽赏，禹穴奇书为一空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章四十舅翁东归","author":"杨亿","text":"乡党共推贤，干名二十年。\n早怀荆岫璞，迟下祖生鞭。\n敢谏书无报，徒行履欲穿。\n圣朝公道在，搔首赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章安世赴举","author":"杨亿","text":"萤烛辛勤十载馀，蔼然高价满州闾。\n一枝未折仙人桂，千里又随乡老书。\n梁苑雪花成赋后，禹门雷鼓化鳞初。\n山城日日望春榜，莫遣南来音信疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章頔寺丞之巴陵","author":"杨亿","text":"涔阳从事有嘉声，外计封章荐姓名。\n再命便为千室宰，于飞又出九重城。\n腰悬铜墨才犹屈，吟对江山思转清。\n楚客十年偏遂意，秋风满箸紫莼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送韩永锡归阙","author":"杨亿","text":"缙云六载掌关征，学得阳冰小篆成。\n逋客几人曾识面，仙山到处便题名。\n桑郊又是乘轺去，铃阁虚烦解榻迎。\n旧读春秋究微旨，何须苦说不知兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧之大名府谒长城侍郎","author":"杨亿","text":"东吴旧寺寄岩隈，驻锡神州久未回。\n琴曲谁知流水意，诗篇自占碧云才。\n庐峰已结白莲社，邺下暂寻铜雀台。\n仙殿主人偏好事，春风铃阁且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧之棣州谒王工部","author":"杨亿","text":"雪晴河水正流澌，风卷惊蓬满眼飞。\n客路飘飘携一锡，禅房寂寂掩双扉。\n曹溪衣钵何年得，庐阜香灯几日归。\n贤守相逢膜拜后，都人争劝施珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归天宁万年禅院","author":"杨亿","text":"暂别云山几度瓜，方袍初日耀兰芽。\n吟诗池上生春草，说法庭中散宝华。\n桂楫去依随岸柳，松轩归赏赤城霞。\n御书满箧新颁得，应向三吴到处誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归苏州","author":"杨亿","text":"说法雄音敌海潮，一栖京寺叶频凋。\n水田三事衣将敝，香积多年饭顿销。\n忽忆虎丘飞梦到，更闻莲社寄书招。\n好传祖印归南土，莫遣宗风渐寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归越","author":"杨亿","text":"中林宴坐赤髭繁，水月禅心出世间。\n说法音同海潮震，随缘身比岳云閒。\n曹溪嫡嗣多参见，碧落仙卿遍往还。\n归去旧房秋色晚，涧松枝偃雨苔斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归越州","author":"杨亿","text":"旧房稽岭锁春苔，猿鸟欢迎振锡回。\n花雨六时飘讲席，樵风千里送浮杯。\n一乘了义刳心学，三藏真文盥手开。\n迹似孤云本无滞，飘飘新到帝乡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳日忆远","author":"杨亿","text":"逆旅重阳节，穷秋万里身。\n金英浮酒盏，珠泪湿衣巾。\n为客飘蓬远，思家落叶频。\n只应蝴蝶梦，夜夜得相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻扬州柴给事有弄璋之庆寄诗贺之","author":"杨亿","text":"华堂何夕梦熊罴，卫氏如今有一儿。\n三日悬弧应是喜，十年结实未为迟。\n预知驷马门闾盛，暗想天麟骨法奇。\n曾忝门墙摄齐者，待看孔鲤学闻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻李四光丞频游北园因有怀寄","author":"杨亿","text":"汉相沙堤连甲第，石家金谷有名园。\n雍容陌上临邛骑，潋滟斋中北海樽。\n过闰已惊春色早，离城殊少俗尘喧。\n无由一寄南窗傲，相望迢迢西掖垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"首座升大师赴西京知教门事","author":"杨亿","text":"高论弥天四海闻，久为龙象主空门。\n雪峰传法称开士，麟殿谈经奉至尊。\n香满赐衣归洛社，苔封文室寄梁园。\n梵书贝叶应携去，斋罢与谁相对翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅中重阳有怀乡国","author":"杨亿","text":"嘉节临重九，羁游托异乡。\n萸房谁系臂，菊蕊懒浮觞。\n野渡宾鸿急，村田晚稻黄。\n悲秋更怀土，只恐鬓成霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晏殊奉礼归宁","author":"杨亿","text":"垂髫婉娈便能文，骥子兰筋迥不群。\n南国生刍人比玉，梁园修竹赋凌云。\n堵墙看试三公府，反哺知千万乘君。\n赐告归宁来别我，亭皋木叶正纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别桐城主簿","author":"杨亿","text":"早曾兔苑传词赋，屈在桐乡勾簿书。\n薄宦交朋嗟绊骥，清贫人吏说悬鱼。\n二年领郡睽离久，一夕当樽鄙吝袪。\n苦恨秋风动行色，徘徊无计驻征车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题张彝宪池亭","author":"杨亿","text":"潇洒危亭枕碧池，昔年飞盖此追随。\n正逢五綵承颜日，兼是三荆并秀时。\n夜坐不知银汉没，春游长诉玉杯迟。\n如今罢郡重登赏，喜见扶风旧白眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题南源院","author":"杨亿","text":"路入藤萝十里馀，松窗潇洒竹房虚。\n燕巢新旧金人殿，虫网纵横贝叶书。\n当昼风雷生洞穴，欲斋猿鸟下庭除。\n昔年曾此题诗句，犹拂流尘认鲁鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题黄山院","author":"杨亿","text":"禾黍离离一径通，游人揽辔即过从。\n趁斋幽鸟闻疏磬，出定高僧见偃松。\n夜静龛灯凝古殿，雨馀岩溜迸前峰。\n昔年曾此题名处，素壁攲斜翠藓重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秘阁舒职方知舒州","author":"杨亿","text":"西昆册府控千庐，铅笔多年校鲁鱼。\n厌享双鸡太官膳，贪乘五马使君车。\n明光画省辞青琐，天柱仙坛访紫书。\n只恐政成抛印绶，携家深入白云居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":70948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]