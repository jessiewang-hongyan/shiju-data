[{"title":"虎丘和孙少述","author":"刘敞","text":"昆阆乘沙不可攀，蓬莱涉海去无还。\n宁知胜绝神仙境，近在青林绀宇间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画屏二首 其一","author":"刘敞","text":"滔滔江湖万千顷，何为飞来入轩屏。\n大涝不增旱不减，静听无声视无影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画屏二首 其二","author":"刘敞","text":"六月炎蒸百虑烦，举目一见心暂閒。\n市人悠悠那得识，此意高山流水间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自西桥至紫温载酒作乐即事呈府公四首 其一","author":"刘敞","text":"欲暖水流初泛泛，半閒人意正悠悠。\n清觞自可轻捐日，高管无端吹暮愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自西桥至紫温载酒作乐即事呈府公四首 其二","author":"刘敞","text":"澹烟苍翠笼高树，密竹交加隐曲堤。\n水调向终人欲醉，夕阳稍近戍楼西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自西桥至紫温载酒作乐即事呈府公四首 其三","author":"刘敞","text":"潜鳞畏乐勿复跃，舒雁避船争乱飞。\n乘兴正须勤一到，会令鱼鸟见忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自西桥至紫温载酒作乐即事呈府公四首 其四","author":"刘敞","text":"主人宿望功名际，下客素心江海中。\n舟楫由来归傅说，沧浪元自属渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷琴","author":"刘敞","text":"三百年中天下工，密移山水入号钟。\n世间会有孙枝在，自是知音不可逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步城上寄贡甫","author":"刘敞","text":"雨过行寻旧履綦，江南山色远相随。\n池塘芳草新无限，还引新诗入梦思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后见山楼","author":"刘敞","text":"春寒天气似江南，閒倚高楼酒半酣。\n尽借前山作屏障，更烦佳雪洗烟岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人游苏州","author":"刘敞","text":"莫倚春风烂漫游，姑苏台上特多愁。\n倾城人逐鸱夷去，惟有空江日夜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重登见山楼有感","author":"刘敞","text":"高轩送目万重山，不尽东西千里间。\n长啸何由生羽翼，径排云雾看人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答钟元达觅藕栽二首 其二","author":"刘敞","text":"渐点青钱浮水面，犹将素节混泥沙。\n送君百顷风潭上，莫笑元非十丈花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新年","author":"刘敞","text":"雪消冰解漏青春，醉眼惊看物物新。\n已识年华似飞鸟，直将身世委天均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"果园巷访杨寺丞","author":"刘敞","text":"雪霁江城气色春，果园巷口静无尘。\n林间水上俱通马，径入谁能问主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻江十吴九得洛相酒戏呈二首 其一","author":"刘敞","text":"洛城春酒碧霞光，东阁遥分东观郎。\n陈侠应嗤伯松拙，魏侯元惜次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻江十吴九得洛相酒戏呈二首 其二","author":"刘敞","text":"众人皆醉屈原醒，天禄寥寥白发生。\n束缊君当游相国，那能我自胜公荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝谒武信殿三首 其一","author":"刘敞","text":"旌旗千里自天来，投策黄河饮马回。\n圣主醳兵方外服，东巡日观望蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝谒武信殿三首 其二","author":"刘敞","text":"原庙衣冠渭北游，侍臣世世祀春秋。\n敌马何由向南牧，万神相与卫轩丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝谒武信殿三首 其三","author":"刘敞","text":"天下安危寄老臣，幄中谈笑静胡尘。\n丹青未备云台像，笳管犹悲道路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"檐下","author":"刘敞","text":"檐下渠泉朝暮声，楼头山色四时青。\n此中故有无穷意，正要悠悠醉复醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"围棋调邻几","author":"刘敞","text":"华发仙翁共奕棋，樵柯烂尽忘归时。\n洞中日月迟如此，世上荣枯讵得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见召西阳池泛舟仍示雅章因成二绝希笑览也 其一","author":"刘敞","text":"画舫欲随波上下，行人先似水西东。\n翠萍却是多情物，漂泊不离芳沼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见召西阳池泛舟仍示雅章因成二绝希笑览也 其二","author":"刘敞","text":"习池几度共芳菲，烂醉池头到落晖。\n临去主人虽不召，山公能不少依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顺州马上望古北诸山","author":"刘敞","text":"平原不尽对群峰，翠壁回环几万重。\n背日映云何所似，秋江千丈碧芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯劳","author":"刘敞","text":"伯劳东去燕西归，可惜春光相见稀。\n惟有歌声留别恨，画梁三日更尘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同河中府签判刘状元廷平访华阴云台观陈搏先生故居是日云雾不尽见诸峰","author":"刘敞","text":"平舒道上望诸峰，翠出浮云几万重。\n过客仍迷五里雾，真人与致二茅龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题戚化源画清济贯浊河图","author":"刘敞","text":"浊河清济坐中分，沙浪澄波两逼真。\n自画壁来多少日，能知清浊几何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西楼","author":"刘敞","text":"西楼独上不能回，绕郭新花正盛开。\n谁信不曾骑马出，春光自到眼前来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴庆池送江淮陈度支是日微凉","author":"刘敞","text":"芙蕖满地水浮空，不意江湖入望中。\n独把一杯送归客，可怜羁思满秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九疑山图","author":"刘敞","text":"苍梧南岸碧嵯峨，直上云衢不甚多。\n天使九峰迷万世，可怜虞舜不悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送智慈","author":"刘敞","text":"海上忘机是白鸥，暂来非为稻梁谋。\n乘风又作沧浪别，怊怅居人浪得愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西掖闻莺","author":"刘敞","text":"宫树阴阴翠盖成，熏风尽日语流莺。\n秪应欲助归田兴，故作林间旧友声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龙山","author":"刘敞","text":"七泽高秋霜叶红，龙山一望夕阳中。\n愁来乘兴时时往，楚老相疑是孟公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出城","author":"刘敞","text":"水映朱扉树绕城，午天暄煦仆姑鸣。\n马蹄款魂春泥燕，自爱乘凉半日行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琵琶亭","author":"刘敞","text":"江头明月琵琶亭，一曲悲歌万古情。\n欲识当时胁断处，只应江水是遗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过湖城诵隽不疑传作","author":"刘敞","text":"北阙公卿如堵墙，谁持一语判兴亡。\n若知京兆人无及，正用春秋侍帝旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"刘敞","text":"城头雪色连云色，池面冰光乱日光。\n泥滑应须劳杖履，幽期恐后野梅芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石牌矶","author":"刘敞","text":"长江激水成飞电，苍石横波起疾雷。\n自觉心能仗忠信，布帆无恙御风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张岳同年","author":"刘敞","text":"长安道侧风尘里，倾盖相逢许白头。\n误在卢前已深愧，莫随时态作沈浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答刘同年寄青䭀术煎松汤并诗","author":"刘敞","text":"自无金骨凌风相，心愧仙翁度世方。\n一听山中白云曲，已如挥手谢华阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣思","author":"刘敞","text":"淮上秋光凝客恨，城头暮色滞斜晖。\n独醒未必能胜醉，远望山来可当归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨无敌庙","author":"刘敞","text":"西流不返日滔滔，陇上犹歌七尺刀。\n恸哭应知贾谊意，世人生死两鸿毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中诣相国寺","author":"刘敞","text":"西风卷雪白如沙，索漠空林开白花。\n病僧迎客兴不浅，自启轩窗煎越茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳河","author":"刘敞","text":"相望不容三日行，多岐无奈百长亭。\n欲知河柳春来绿，正似山松雪后青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神山","author":"刘敞","text":"林立众峰俱到天，传闻此地有神仙。\n名山三在蛮夷国，方土之书犹信然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早春野泊寿宁观","author":"刘敞","text":"小径连村行几曲，垂杨未绿草成蹊。\n门前野水还如带，恐是仙源使客迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵奉和梅尧臣四首 其一","author":"刘敞","text":"阴云著地无精光，细雨翳日看微茫。\n千里江山在何处，心怜社燕冲风翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵奉和梅尧臣四首 其二","author":"刘敞","text":"而今四海虽休兵，犹有防秋在戌城。\n征妇裁衣欲寄远，时将蚁子侯阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵奉和梅尧臣四首 其三","author":"刘敞","text":"春草更绿春林衰，长安游客未成衣。\n凄凄计欲变寒色，一夜无语看灯辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵奉和梅尧臣四首 其四","author":"刘敞","text":"欲埽鹏翅还北溟，欲引羲辔来东瀛。\n从兹阴翳永绝灭，康衢不使泥涂生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春草","author":"刘敞","text":"春草绵绵不可名，水边原上乱抽荣。\n似嫌车马繁华处，才入城门不见生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王阁使","author":"刘敞","text":"忆醉离亭舞翠娥，举觞同听渭城歌。\n故人却出阳关见，愁问行云奈若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴化寺花","author":"刘敞","text":"蟠桃浪占三千岁，琪树虚传十二城。\n争似此花常在眼，风吹日炙四时荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古北口","author":"刘敞","text":"束马悬车北度燕，乱山重复水潺湲。\n本羞管仲令君霸，无用俞儿走马前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直舍竹下残雪二首 其一","author":"刘敞","text":"阿阁三阶敌井干，宫墙十仞逼云端。\n故留残雪侵春事，欲伴孤篁老岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"直舍竹下残雪二首 其二","author":"刘敞","text":"重叠空阶委玉尘，萧疏碧筱束浮筠。\n地寒自称孤高节，不共阳林竞早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十一月十五日朝拜章武殿雪中口占呈圣民学士","author":"刘敞","text":"原庙衣冠月出游，侍祠义比汉诸侯。\n应有海神朝绛阙，勿惊飞雪满昆丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮雪中寄隐直前年季冬与隐直相会京师凡十馀日","author":"刘敞","text":"长安积雪深三尺，穷巷相看共一樽。\n物色岁华还彷佛，异方回首重消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜见月","author":"刘敞","text":"微风送雨江南去，凉月衔云海上来。\n暑气顿除秋暗入，忽疑浮汉弄昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别彦文","author":"刘敞","text":"兔园风物共追游，直自霜秋到麦秋。\n何故临岐犹有恨，未曾携手上商丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登新河桥诗","author":"刘敞","text":"朝阳破雾水浮空，极目江湖一望中。\n三十六陂冰雪解，鱼龙鳞鬣动春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小园","author":"刘敞","text":"弱柳低花俱有意，浅沙深竹总无尘。\n从今不恨交游绝，还倚东风作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪霁行小园","author":"刘敞","text":"力埽墙根通野径，少留林下访初春。\n魂翻眼眩看梅杏，几处攀条辄误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月二日雪后到小园","author":"刘敞","text":"新年已觉有春光，宿雪无多映夕阳。\n竹箭晴来依旧碧，柳条暖去不胜黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纳凉明教台","author":"刘攽","text":"台上井泉冰冷滑，城隅川色剑光芒。\n多惭簿领相宽假，全得南风一日凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻张隐直率范十九佑之游边寄之三首 其一","author":"刘敞","text":"莫怪黄河来积石，又疑弱水隔昆崙。\n若嫌古记难全信，他日君归与细言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻张隐直率范十九佑之游边寄之三首 其二","author":"刘敞","text":"未甘海上乘桴去，犹托隆中竟日眠。\n努力英雄树功业，鄙夫洗耳太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻张隐直率范十九佑之游边寄之三首 其三","author":"刘敞","text":"红旂白羽尚纷纷，渭北洮河十万军。\n历览山川穷胜负，朝廷肯弃奉春君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题净严观春波亭","author":"刘敞","text":"满目烟芜蘸绿漪，江淹遗恨楚江湄。\n仁人四海皆兄弟，何必东风怅别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初雪","author":"刘敞","text":"冥冥浓雪半空黑，烈烈北风吹日回。\n海水翻从九天落，龙沙却渡五湖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答杜九重过东门船戏作","author":"刘敞","text":"共醉江南日落春，悲歌一曲思离人。\n却寻陈迹愁先乱，况复青青柳色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹三首 其一","author":"刘敞","text":"刻成红玉万枝香，排出华灯四照光。\n闻道阆风有琪树，可能一二敌芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹三首 其二","author":"刘敞","text":"宫女妆花不必匀，浅红深紫自争新。\n已能含笑惊愁眼，枉是无言对暮春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹三首 其三","author":"刘敞","text":"密密芳华乱夕晖，碧油幕下觉春迟。\n何时谢绝人间事，看尽东风烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题慧礼师双树院","author":"刘敞","text":"双树婆娑三百年，江南秀色上参天。\n不知昔日谁来种，正为道人开法缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬州闻歌二首 其一","author":"刘敞","text":"淮南旧有于遮舞，隋俗今传水调声。\n白雪阳春长寡和，著书愁绝郢中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬州闻歌二首 其二","author":"刘敞","text":"半夜暖风吹朔雪，东城南陌晓来春。\n郊光野气望不极，柳意梅香愁向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]