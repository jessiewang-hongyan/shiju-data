[{"title":"读刘丈元畸四传戏题二首 其一","author":"周孚","text":"使长河作酥酪，真赤手揽象犀。\n斯文谁解捉搦，此老大能滑稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读刘丈元畸四传戏题二首 其二","author":"周孚","text":"知音止老柳州，如君亦奚斯流。\n真复烦管城子，端不数下邳侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙戌重五后一日予与同舟三人游虎丘庚寅岁予亦以是日至枫桥望虎丘塔迫日莫叹息而去","author":"周孚","text":"百丈寒岩塔，孤篷倦客船。\n来迎十里外，相识五年前。\n天迥方斜日，林深忽暝烟。\n平生戒三宿，为汝复凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送鉴老住禾山二首 其一","author":"周孚","text":"破壁荒垣谁解新，渠侬方向阿师勤。\n遥知竖拂拈椎处，不负青山起白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送鉴老住禾山二首 其二","author":"周孚","text":"黄流渺渺独浮杯，俊鹘冲天亦快哉。\n玉麈谈玄他日事，不妨兼带此山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独游因胜有怀苏丈信臣时任衡州幕予明年亦官淮上矣","author":"周孚","text":"力田不罪岁，吾犹识斯人。\n气清色坦夷，可畏还可亲。\n五年鹿门游，莫辨主与宾。\n老屋每下榻，寒庖屡分珍。\n人生会合难，朝吴莫燕秦。\n忽随湖雁去，坐见江梅春。\n沧波与天连，音问何由频。\n向来燕居室，萧然淡无尘。\n簿书换清谈，叹息生一贫。\n新阳革故岁，我复效此颦。\n吾人亦何事，政愧祁孔宾。\n何时此山南，得与翁并邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄仲微杜丈","author":"周孚","text":"小雨催春杏半红，转头庭户已秋风。\n刘桢昔病虽差愈，侯喜今诗竟未工。\n瘦马羸僮还自笑，绿尊黄菊定谁同。\n十年塞耳人间语，剩欲从公一破聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题后山集后次可正平韵 其一","author":"周孚","text":"嶷嶷陈夫子，高名天壤间。\n读书能妙斲，行己有深闲。\n句法窥唐杜，文章规汉班。\n九原埋玉树，遗简仰高山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题后山集后次可正平韵 其二","author":"周孚","text":"甚美元非恶，嗟公堕此间。\n真为四君次，可厌七年闲。\n汴泗空千载，晁何仅一班。\n凄凉大阳履，埋没若河山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭员著作","author":"周孚","text":"每憎鸡荩谷，自许凤鸣冈。\n论事方刘向，修文遽卜商。\n高名宁泯没，老意自凄凉。\n叹息褚中惠，此生那可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登普照山有怀宛陵陈丈侍郎二首 其一","author":"周孚","text":"登临才昨日，时序亦匆匆。\n败幕无巢燕，寒空有断鸿。\n老怀空对月，病骨不禁风。\n远水澄寒练，令人忆谢公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登普照山有怀宛陵陈丈侍郎二首 其二","author":"周孚","text":"遥闻宛陵老，犹寄梵王宫。\n穫稻虽终亩，诛茅未毕工。\n斯文元有托，吾道岂终穷。\n莫作居东想，君王识郑崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓才卿同年两顾敝庐病睡不克见别后次庭藻送行韵谢之","author":"周孚","text":"富贵移人或望尘，独于衰病却情亲。\n澜翻未听渠侬语，肮脏悬知我辈人。\n正续黄粱今日梦，敢寻紫陌向时春。\n三年两踏蓬蒿径，此客他时不是新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘元畸解官归宣城兼问讯侍郎陈丈","author":"周孚","text":"群书讽诵不离口，君才岂止王季友。\n力探千载自青眼，智效一官今白首。\n三年拄颊京江上，车如鸡栖马如狗。\n旁人窃叹君则笑，一鬨从来有奇偶。\n椎鼓发船忽复去，聚散匆匆一翻手。\n泾川绿涨三百里，试脱征衣濯尘垢。\n人间至计只樗栎，身外虚名本箕斗。\n君归更问且过翁，富贵何如一杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄史伯强","author":"周孚","text":"一日抵三岁，子行踰十旬。\n昔如宫应商，今若参与辰。\n力挽殊未来，叹息寒江滨。\n附书双鲤鱼，沧波正奫沦。\n平生金石交，如子不数人。\n饱更松桂秋，不羡桃李春。\n向来相期处，可但髯绝伦。\n一朝忽去眼，那能不酸辛。\n悠悠世网中，双鬓各已新。\n岂无耦耕约，奈此离别频。\n富贵朝露耳，莫负头上巾。\n归来建德国，与子同问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题小庵画轴三首 其一 寒林平远","author":"周孚","text":"扁舟渺渺入平湖，秋叶经霜半已无。\n不是幽林欠残雪，为君题作剡溪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题小庵画轴三首 其二 猿","author":"周孚","text":"一落絷维中，永别啸云友。\n秋月耿寒林，时来梦中否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题小庵画轴三首 其三 獐","author":"周孚","text":"当时饿鸱箭，惊皇无复魂。\n困卧阶下草，深愧主人恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵侯彦康","author":"周孚","text":"箪瓢从古亦山雌，叹息渠侬定可师。\n挽士真难九牛尾，酬君谁可五羊皮。\n过逢政自艰难际，感慨俱非少壮时。\n樗散郑虔官益冷，得钱沽酒不须疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱毅夫挽词","author":"周孚","text":"卖药长安市，退藏三十秋。\n来从阿戎语，始与德公游。\n一别俄黄壤，遥怜尚黑头。\n心知漆灯在，应为此翁留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送辛幼安","author":"周孚","text":"西风掠面不胜尘，老欲从君自濯薰。\n两意未成还忤俗，一饥相迫又离群。\n只今参佐须孙楚，何日公卿属范云。\n节物关心那可别，断红疏绿正春分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦康","author":"周孚","text":"读书策新功，子久勖此课。\n蒲梢籋寒云，了不见坎轲。\n深怀浃背耻，但欲袖手坐。\n新诗忽来辱，快读起疲懦。\n还疑正始在，欲突黄初过。\n斯文未易到，吾党真可贺。\n向来豫章法，政复如此作。\n钮头三寸泽，子质况黄糯。\n只今百尺的，已见一矢破。\n更期十载后，凛凛谁子奈。\n耆年日凋丧，我亦老寒饿。\n奇穷不自惜，乃复珍此货。\n但恐黄禾空，子驹谁秣莝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠顿昂伯高兼简王丈公瑞顿尝识先君","author":"周孚","text":"凄凉元祐几遗民，邂逅京江两病身。\n阮籍莫年唯可醉，扬雄平日固当贫。\n久知丘壑须吾党，晚喜箪瓢有若人。\n同识嵇公更谁在，仲任虽健鬓如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄辛滁州","author":"周孚","text":"江皋追送仅踰旬，节物俄惊一度新。\n西涧潮生还值雨，南山雪尽正逢春。\n遥知风韵如前辈，可有篇章忆故人。\n拟向琅琊问幽事，两翁遗迹未埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵庭藻留王用宾韵别赵楚才","author":"周孚","text":"落魄山阳市，悲歌独子听。\n相过常出日，小住亦翻星。\n此际心还折，何方鬓解青。\n一杯寒食酒，相与记沉冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离山阳戏次庭藻韵简叔异二首 其一","author":"周孚","text":"匆匆掠面只黄沙，行尽孤城不见花。\n政是江南好时节，暖风吹柳欲藏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离山阳戏次庭藻韵简叔异二首 其二","author":"周孚","text":"去日寒亭尚有梅，归来已过海棠开。\n叩门剥啄家人笑，惊怪安西老友回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄朝美","author":"周孚","text":"君才秀吾乡，真可歌大雅。\n疏通信而静，少有似君者。\n十年卧墙东，樲棘笑梧槚。\n摩挲怀中璧，顾我知者寡。\n一朝籋云去，始骇天下马。\n宁如不祥金，未铸先跃冶。\n煌煌汉家业，条画待董贾。\n皇文阅石室，秘署向金马。\n飞腾吾敢羡，拙艺真毁瓦。\n出处判殊涂，归耕弋阳野。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠王南仲","author":"周孚","text":"妙语富停蓄，高标邈巉岩。\n半面逆旅中，知子固不凡。\n语离今几时，岁月如惊帆。\n南谯再相遇，黄尘扑征衫。\n握手互叹息，白发不可芟。\n吾侪与世疏，触事俱殽函。\n饥鹰久已疲，狡兔方自毚。\n二顷可以休，此意神所监。\n纵复落痴钝，犹应免贪馋。\n一语子可思，病马愁辔衔。\n寄语同社人，吾将老寒岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道士刘先觉之金陵","author":"周孚","text":"挽袂小徘徊，秋风菊正开。\n方惊鸥可狎，忽与雁同回。\n老干元如腊，衰怀久已灰。\n丹砂未得诀，伫子寄方来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答李清宇姜德光","author":"周孚","text":"匆匆一席地，劳子数追寻。\n厚意嗟虚辱，衰年愧不任。\n高怀元淡薄，妙语不崎嵚。\n老桧千寻直，寒泉百尺深。\n世方憎落落，吾自畏骎骎。\n生计贫非病，羁穷古亦今。\n未须悲龃龉，直可付呻吟。\n谁复明兹事，深思话此心。\n空垂老任钓，莫辩伯牙琴。\n试采南山蕨，同君洁釜鬵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵奉答杨判官继甫","author":"周孚","text":"向君官升今复滁，十年两地无此儒。\n喧啾蹇吃方一区，君自鹄白渠自乌。\n士安门人有挚虞，斯文灰冷今复苏。\n胸次与古真合符，鄙夫濩落世所无。\n逃禅政自萦瓠壶，岂有笔力凌三都。\n老伧人方笑玄谟，愧君清坐客歌呼。\n君才如鲁我则邾，气味莫间沂与洙。\n甲辰虽俱那得如，苍髯直干霜不枯。\n归来破屋从绳枢，飞腾付君吾敢谀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢端砚辛滁州幼安","author":"周孚","text":"君家即墨君，不与世同调。\n紫云覆寒冰，色与质俱妙。\n谁知穷荒地，尤物来越徼。\n探囊忽见畀，此事出吾料。\n隋珠暗投处，叹息真可吊。\n物生各有用，瑚琏荐清庙。\n君才两汉馀，妙句出长啸。\n吾衰亦粗尔，老语世不要。\n摩挲冰玉质，自庆还自谯。\n愿君为追琢，勿令研空笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵史伯强","author":"周孚","text":"金陵望京江，与子俱异乡。\n以胶投漆中，非子吾谁望。\n平生山林愿，儿乳宁可断。\n招子独不来，同谁弋凫雁。\n乖离念存没，一饭再三歇。\n往者十年梦，在者千里别。\n寄声问平安，此去何时还。\n炽火暖浊酒，此盟安可寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵漕生日 其一","author":"周孚","text":"治世才难得，公生瑞圣朝。\n高怀元稷契，异骨更松乔。\n骥騄须千里，鹓雏合九霄。\n明年东府宴，相与记今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵漕生日 其二","author":"周孚","text":"名族仍前辈，高才更望郎。\n经年滞龙节，数日冠鹓行。\n白鹤开新历，青黏屏旧方。\n春风柳条绿，传赐看勾芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山海书记寄七骑","author":"周孚","text":"两骑并驱争欲前，两骑舍矢俱应弦。\n一骑挥挝一负箭，一骑力挽弓初圆。\n寒风潇潇沙漠漠，封豨可擒熊可搏。\n汉家飞将未出关，政使渠侬专此乐。\n君不见往年胡瑰写此图，宛陵诗翁最爱渠。\n戏将醉墨作长句，岁月政当嘉祐初。\n故家文物今星散，老笔凭谁辩真赝。\n胡儿走马大梁城，对君此画空三叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赣州知府陈侍郎二首前篇寄幼安后篇寄季陵 其一","author":"周孚","text":"乘轺西去定何人，惊倒吴侬政要君。\n平日比肩空绛灌，此行知已有华勋。\n不令残孽终烦国，信是高才可冠军。\n锋猬斧螗当著语，病夫今岁懒于文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赣州知府陈侍郎二首前篇寄幼安后篇寄季陵 其二","author":"周孚","text":"朝班数日待归来，又醉凌虚百尺台。\n两岁虽为汝曹福，一州那尽此翁才。\n只今音问踰千里，何日登临共一杯。\n宣室受釐知已久，问公藏缩独何哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高邮知军觅芍药一枝五花三绝 其一","author":"周孚","text":"芒种逢花已自难，瑞云攒处凭栏干。\n烦君问取同州例，一干三花奏牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高邮知军觅芍药一枝五花三绝 其二","author":"周孚","text":"蜀锦团圞照眼明，游蜂乍见亦须惊。\n君知此种来何处，花萼楼中五弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高邮知军觅芍药一枝五花三绝 其三","author":"周孚","text":"泾川游女汉宫妃，压倒渠侬金带围。\n吾府只今虚席在，栈羊酾酒送公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄辛幼安","author":"周孚","text":"飞鸢跕跕瘴烟中，叹息渠侬伎已穷。\n攲壑老松真耐久，燎原荒草易成空。\n危机可畏浑如此，庄语能听只有公。\n已识柴车胜朱毂，快来相就北窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈唐卿尉繁昌二首 其一","author":"周孚","text":"一贫那可忍，子亦老夫如。\n晚岁难忘禄，生平误信书。\n相逢搔首处，共是折腰初。\n莫作高常侍，狂歌忆孟诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈唐卿尉繁昌二首 其二","author":"周孚","text":"老笔倦场屋，今年方自如。\n无为堕丹墨，可便废诗书。\n妙质嗟谁似，修涂记此初。\n摩挲和氏璧，吾语亦礛诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题彭氏韦经堂 其一","author":"周孚","text":"鲜卑语熟更琵琶，渠向人前亦自誇。\n棐几明窗那可负，喜君能记鲁东家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题彭氏韦经堂 其二","author":"周孚","text":"公圭侯印照乡闾，到了扶阳只汉儒。\n不向师门论官阀，未知回赐可无殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天宁寺清宇壁间韵","author":"周孚","text":"风历寒窗竹自鸣，老谈还得片时醒。\n挽君小住君知否，恐有楞伽未了经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与王南仲李清宇夜坐十二月八日大雨","author":"周孚","text":"急景不可驻，十年无好怀。\n飘流还此日，团聚且吾侪。\n短日衣衫尽，寒云雨雪偕。\n昏灯照清夜，安得酒如淮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜清宇伯强自外县归","author":"周孚","text":"不见尊前两友生，流年欲尽不胜情。\n寒窗孤坐风初定，短策同来雪正晴。\n浊酒只今俱入务，新诗从此试寻盟。\n黄尘掠面无佳思，乞得逢君眼便明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题滁倅燕丈文伯蘧庐","author":"周孚","text":"浮云过眼只斯须，兀兀粘黐政笑渠。\n万事悟来俱蚁穴，一官随处是蘧庐。\n已知要路真聊尔，试问高怀竟孰如。\n老树扶疏真可爱，因君又欲感归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以黄公金华伯五字为韵上黄仲秉侍郎 其一","author":"周孚","text":"求道固多岐，我马玄以黄。\n耳闻老叔度，欲聚三月粮。\n今日复何幸，得上君子堂。\n医门不拒疾，请试囊中方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以黄公金华伯五字为韵上黄仲秉侍郎 其二","author":"周孚","text":"先朝盛文物，最盛元祐中。\n我生百年后，深思附冥鸿。\n人欲天不违，今复识此翁。\n何以知其然，风味如长公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以黄公金华伯五字为韵上黄仲秉侍郎 其三","author":"周孚","text":"古货不易售，八荒孰知音。\n零落子云书，尘埃伯牙琴。\n我戆久病此，属公听呻吟。\n可笑朱汗漫，屠龙费千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以黄公金华伯五字为韵上黄仲秉侍郎 其四","author":"周孚","text":"硬语斡地轴，奇辞拔鲸牙。\n向来豫章公，一洗空百家。\n此灯不可传，公实优昙华。\n银河会可穷，从公丐灵槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以黄公金华伯五字为韵上黄仲秉侍郎 其五","author":"周孚","text":"名如九鼎重，笔有万钧力。\n甘从颍川最，厌就承明直。\n顷时未承颜，既见有矜色。\n归语同舍生，吾几类河伯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠杨文伯","author":"周孚","text":"匆匆永阳城，别我正月尾。\n当时已念子，山路石磊磈。\n只今再相见，霜风凋百卉。\n长年走道路，煖席能得几。\n信知书作祟，可但穷有鬼。\n殚精谩屠龙，适周终履豨。\n攲危不少慑，叹息子亦伟。\n倒囊欲振子，吾事真不避。\n西州老次公，采掇到葑菲。\n肯令霜雪干，凋丧杂蒲苇。\n子才正牢落，我意空愤悱。\n勉旃无多谈，寒醅绿如蚁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送杜仲微知容州","author":"周孚","text":"丁年不负短檠灯，中岁危涂屡折肱。\n自古诗人固屯蹇，喜公今日少骞腾。\n遥知去路方收秫，预约来书定凿冰。\n勾漏丹砂能寄否，据床扶病发鬅鬙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问杜叔异觅藤州簟","author":"周孚","text":"旧识藤州簟，清寒惬病夫。\n深宜荐黄妳，真可配青奴。\n绝境无由致，衰年政此须。\n漫肤仍复汗，君记法曹无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈曾秀州原伯二首 其一","author":"周孚","text":"叹息茶山老，知名四十年。\n惊看二龙在，喜有一灯传。\n厚礼惭虚左，微材许诣前。\n形神见公妙，闭口敢言禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈曾秀州原伯二首 其二","author":"周孚","text":"古人不可见，此恨与生俱。\n平日轻馀子，今年识大巫。\n迷涂方此困，羸瘵待公苏。\n换骨宁无法，聊烦举一隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次前韵答原伯二首 其一","author":"周孚","text":"食蓼不知厌，雕签踰十年。\n唯蕲一语契，不必万人传。\n凛凛元刘上，骎骎晋魏前。\n须烦三昧手，为变小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]