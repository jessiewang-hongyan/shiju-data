[{"title":"次韵中散兄二首 其二","author":"葛胜仲","text":"遍游湖寺棹舟还，重理残书逼小寒。\n衰鬓迎风似蒲柳，贫炉无火取槐檀。\n毫铢利禄回头笑，翻覆人情洗眼看。\n痴钝老人堪底用，故应衡宇自偷安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友卿弟见和复赋二首 其一","author":"葛胜仲","text":"岁律峥嵘又欲还，鸣条风急作清寒。\n菊英媚日犹呈秀，梅蕊包香未吐檀。\n江水过门兼汐到，乡山当面带云看。\n是身已觉都无事，只有空飧不自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友卿弟见和复赋二首 其二","author":"葛胜仲","text":"门无杂客往仍还，趺坐澄心定水寒。\n清净苦嫌千日酒，萧閒惟事一铢檀。\n眼中金屑全无用，髻里明珠得自看。\n作止更能除任灭，已无禅病自轻安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵维心二首 其一","author":"葛胜仲","text":"萧衣无柰客愁多，日饮那知酒有戈。\n松径崎危羊石卧，筠筒屈曲虎泉过。\n懒寻丹灶山名葛，且供禅龛人姓何。\n共看今年龙集酉，穰穰蕃熟庆时和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵维心二首 其二","author":"葛胜仲","text":"侧席求贤岁又除，如君德盛孰仪图。\n轶材共仰人之杰，谠议悬知帝曰都。\n岂有箦中终去魏，未妨庑下略居吴。\n蒲轮不日来徵聘，禅句休誇雪点炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶少协泛舟","author":"葛胜仲","text":"水风斜日惬新晴，初解铜章病骨轻。\n远寺藏烟增晻霭，寒峰带雪更鲜明。\n寻幽屡办扬舲出，辱访惭乖倒屣迎。\n烟艇遥遥逐鸥飏，渊明从此得浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题拙台","author":"葛胜仲","text":"讲罢公堂得少休，下帘清兴与天悠。\n书空怪事知无益，为圃机心逝不留。\n四至九卿空士笑，一当万乘岂人谋。\n先生独有摛词巧，夺尽人间重锦裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和小室韵","author":"葛胜仲","text":"一味伽那已默传，随机任运且忘年。\n翻经不落摩腾后，成佛仍居谢客前。\n教海就舟方见圣，宗门得髓始通禅。\n萧斋一炷寒沈水，了尽因缘与自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朝隐招饮二首 其一","author":"葛胜仲","text":"千古兴亡马食槽，醉乡真可寄廉高。\n功名戏事何须挂，富贵危机讵肯饕。\n幸有碧筒消暑溽，休誇白堕执逋逃。\n牢愁滞恨知多少，准拟都将付浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朝隐招饮二首 其二","author":"葛胜仲","text":"何须逻逤响檀槽，独喜杯中酒浪高。\n芰实深酬屈到嗜，鲈鱼仍足季鹰饕。\n加笾亹亹情尤厚，醉舞僛僛罪敢逃。\n我亦头巾漉家酿，明当相速醉芳醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招中散兄饮","author":"葛胜仲","text":"飘零羁旅苦摧颓，旬日希逢笑口开。\n炉冷难施文武火，气寒聊杂圣贤杯。\n牛鸣地去无多远，羊胛熟时宜便来。\n闻说家山动归兴，预愁叠鼓起高桅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵卿任赋立春","author":"葛胜仲","text":"阳和协气起寒灰，席上清歌听落梅。\n煖逐日华惊岁换，夜占天象觉星回。\n书筹屡点蟾蜍砚，命釂连催鹦鹉杯。\n愿敛春祺锡黎庶，熙熙一镜似登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵道祖赋立春","author":"葛胜仲","text":"棠华靴韡绮筵开，何用三行粉面回。\n金鸭香残知漏永，土牛色重喜春来。\n飘霙著树狂欺柳，剪綵装花巧斗梅。\n俛仰光阴惊岁换，谁将蓝尾更衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜晴","author":"葛胜仲","text":"补陁香供走人天，赴感随缘旧所传。\n霖雨方忧困桑户，晚晴俄喜赋樊川。\n阶庭旋见收黄潦，斋壁何因上绿钱。\n多谢化工哀老子，遨游不复更祈年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝桧","author":"葛胜仲","text":"拿云老桧欲千春，几阅人间旦复曛。\n风里樛枝喧过雨，月中清影碎流云。\n蟠根不愿郎官谷，耸干宜参君子军。\n须信英灵神物护，频经兵寇惜挥斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春昼偶作次元述韵","author":"葛胜仲","text":"屏居岑寂似禅关，顾笑初无素与蛮。\n昼栋差池宁识燕，绮窗葱翠旧游山。\n时危谩自怀颇牧，境静聊欣接尹班。\n二纪家园逋细履，身閒今得一时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元述","author":"葛胜仲","text":"漂泊身如不繫舟，芙蓉湖上懒回头。\n干戈时幸逃新鬼，岩壑人能识故侯。\n已觉功名真破甑，却惊岁月甚奔流。\n仙庭五载空浮食，恩重丘山岂易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事 其一","author":"葛胜仲","text":"五载投閒隐薜萝，眼看时事只悲歌。\n家贫不畏鬼来笑，世变难教佛柰何。\n髀肉生缘痴坐久，带围减为客愁多。\n他年莫忘菁山寺，百口啼饥两鬓皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事 其二","author":"葛胜仲","text":"青云那肯羡雄飞，前料山边习遁肥。\n名教固应多乐地，贱贫聊幸脱危机。\n齑无萍韭何妨醉，羹有菰莼自合归。\n格外一官垂欲满，便从神武挂冠衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事 其三","author":"葛胜仲","text":"诸公衮衮上岩廊，济世无能分退藏。\n所止先名大隐洞，平生本望秘书郎。\n画成顾失一卮酒，箭蹶空穿百步杨。\n幻界光阴凛无几，养生从此学长桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村人写予像即景山饭道僧祈祷为会颇盛","author":"葛胜仲","text":"单车去位五年强，初乏恩襦庇一方。\n大姓殷勤携老稚，精蓝祈祝饭缁黄。\n此时美稷勤邀迓，他日桐乡必奉尝。\n为报庚桑相俎豆，不如道术永相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夕郊居书怀","author":"葛胜仲","text":"晚涂萧飒寄渔樵，梦亦无因到上朝。\n书在床头脱复看，客逢野外偶相要。\n敢嗟禄薄难糊口，大胜官粗每折腰。\n六十七年明日是，亦逢村酿也浮椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德升颐轩书怀","author":"葛胜仲","text":"烟霄飞步欲青春，未信论甘肯忌辛。\n三仕固应无喜色，一鸣今复见惊人。\n射如关尹方知中，画若元君始识真。\n早晚奏篇来拭目，清涂聊为洗荒榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄庆立方赐第","author":"葛胜仲","text":"儿曹春榜预言扬，窃吹知难服士乡。\n黄绢未能摛好语，青毡偶幸继前芳。\n穿杨喜共东床客，攀桂同标北寺房。\n圣世选材如华岳，积尘曾不弃毫芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵边公明放鱼","author":"葛胜仲","text":"小鲜无数命临危，邂逅云庄扩大悲。\n巨浸何劳长者水，亲临尤胜校人池。\n依蒲俯视还真乐，贯柳充庖那复知。\n圉圉介鳞俱得所，道人因得一伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵颜孝立同年","author":"葛胜仲","text":"亦识韶华不肯留，时危那更事嬉游。\n羁怀不办愁花雨，空廪惟知望麦秋。\n顾我端忧宜燥吻，如公无事合扶头。\n曲生漫助齐眉饷，清洗钱塘两玉舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和必先龙图谢酒兼呈沈次律大学士","author":"葛胜仲","text":"台阁高贤卧里门，清扬乖隔阻寒温。\n尚赊宴豆陪三雅，聊即烟邮寓一尊。\n乱后官居同幕燕，春来香味忆河豚。\n溪亭午夜衔杯处，应对梅花淡月昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠史德谦","author":"葛胜仲","text":"不入城闉已十年，足音何幸听跫然。\n杯觞共乐三更后，书史相从一世前。\n鸟倦尚飞惭我老，鸿冥何慕觉公贤。\n锱铢得失何须算，闻健惟当数击鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠鲍钦止二首 其一","author":"葛胜仲","text":"锦窠朱绂亦何荣，辞剧求閒责自轻。\n聊喜青葱供俯仰，未应红腐较奇赢。\n久知飞鸟有真意，谁信鸣鸡非恶声。\n只恐朝端阙司隶，又将敛手避威名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠鲍钦止二首 其二","author":"葛胜仲","text":"红尘衮衮厌朝班，官寺深藏洛尾湾。\n识擢早惊郎位峻，招寻今见水仙閒。\n高标自置羲皇上，俗眼从教季孟间。\n仓氏一官宁久困，禁途供奉政才难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽致政奉议鲁公歌词","author":"葛胜仲","text":"翛然丈室老维摩，不愧家声旧曲阿。\n事阅七朝推寿俊，庆钟六子半文科。\n白莲入社尘缘息，朱绂通闺圣渥多。\n空唱已闻生净域，可须薤露起悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张子蒙令君挽歌词二首 其一","author":"葛胜仲","text":"赋归州里半年间，岂料循题哭二难。\n屡荐尝为趋幕客，数奇终困字民官。\n清谈竟日师夷甫，寝瘵连年痛士安。\n身后华名知不朽，几多墨妙翠珉刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张子蒙令君挽歌词二首 其二","author":"葛胜仲","text":"文义游从四十春，艰难契阔见情亲。\n少年涟上初倾盖，末路云阳拟卜邻。\n万室讴吟依恺悌，一生志气负经纶。\n渭阳岂特儿曹恸，老送佳城泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大卿表兄莫公挽歌词二首 其一","author":"葛胜仲","text":"露奏求閒猛挂冠，忽惊卿月堕云端。\n中年屡揽澄清辔，末路坚辞矍铄鞍。\n自卜寿藏松已拱，亲裁幽刻墨方乾。\n映溪清远楼前月，后夜登门忍独看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大卿表兄莫公挽歌词二首 其二","author":"葛胜仲","text":"游从五纪荷勤渠，白首来依霅水居。\n郡閤箴规言有补，家林书疏月无虚。\n方期老验长桑药，忽见神升广柳车。\n兄姊同时封吉壤，不堪清泪屑衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先兄中散挽歌词四首 其一","author":"葛胜仲","text":"昂昂鹤骨素康彊，微疢生朝罢举觞。\n尚冀魂随香釜反，那知人逐绮琴亡。\n禁方不验三茅洞，遗墨空留二老堂。\n从此幽栖风雨夜，一翻姜被一凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先兄中散挽歌词四首 其二","author":"葛胜仲","text":"德与才高位不酬，大钧杳默向谁尤。\n剖符政化传沂水，握节威名振宛丘。\n心悟三乘真合觉，学该九域独推优。\n雁行影拆元龟丧，泪洒西风不忍收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先兄中散挽歌词四首 其三","author":"葛胜仲","text":"粉闱当日正逢辰，兴在沧洲猛乞身。\n袖手旁观真得计，急流勇退更何人。\n翱翔词馆全无累，笑傲丘园不计春。\n鼎鼐百年均此路，惟公达识夐谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先兄中散挽歌词四首 其四","author":"葛胜仲","text":"流年八帙庆初开，驹隙那知二竖催。\n书聚五车缘嗜学，家徒四壁为轻财。\n幻身梦蝶自云适，曲路增蝇何处来。\n深恨滞留暌属纩，此生赍恨在天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀范卿学士弟","author":"葛胜仲","text":"万卷胸中学已优，安恬当向古人求。\n有财谩说驹千里，此路何殊貉一丘。\n儒馆芸香今寂寂，亲闱芝检竟悠悠。\n悬知箫鼓江村路，茂柏深松结暮愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨彦安大夫挽歌词","author":"葛胜仲","text":"英猷卓跞世无多，用不酬材可柰何。\n庀邑颂声空制锦，阜财智算谩熬波。\n鳣堂积学家传庆，蟾窟登荣子继科。\n下里有车催遣奠，上池无药起沈痾。\n心期于我勤知过，肺腑从公久切磋。\n十载飘流隔生死，东风吹泪寄滂沲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其一 王嘉","author":"葛胜仲","text":"王嘉冤死有由缘，峻节忠言照史篇。\n最是一条堪恨处，临刑犹道孔光贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其二 马融","author":"葛胜仲","text":"为梁草奏枉忠臣，李固夤缘遂杀身。\n南郡何须施绛怅，应无面目见时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其三 陈蕃","author":"葛胜仲","text":"阉尹流凶遍海隅，飞章露奏计诚疏。\n黄门诏狱空忠鬼，天下何因遂扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其四 邓伯道","author":"葛胜仲","text":"贼掠家储岁阻饥，将儿系树后无儿。\n林回轻弃千金璧，始信皇天是有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其五 法真","author":"葛胜仲","text":"奖鉴人伦重法真，亲庭曾遗助求人。\n牖间占察曾何补，只得庸庸番土臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其六 王戎","author":"葛胜仲","text":"儿时黠慧岂寻常，苦李徒教结道傍。\n何事季年痴更甚，为财钻核长膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其七 沈约","author":"葛胜仲","text":"革运称梁出秘谋，寿光不许范云留。\n赤章夜奏称非已，合向人间谥隐侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史八首 其八 王维","author":"葛胜仲","text":"子昂文律唱唐家，摩诘诗声未易加。\n场屋有谁深荐达，坐令入彀赖琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泮水","author":"葛胜仲","text":"半璧清波势自然，鸾声旂色想当年。\n野芹不识兴亡恨，犹自牵风漾碧涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庙宅","author":"葛胜仲","text":"素王遗庙屋渠渠，老桧阴浓耀碧虚。\n无复升堂闻古乐，尚传开瓮得丹书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵光故基","author":"葛胜仲","text":"蟠螭宛转谩承楣，东序西厢只废基。\n终与建章同圯坏，浪言神力有支持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望岳亭","author":"葛胜仲","text":"迤逦群山不识名，天门日观远峥嵘。\n地灵不见二宫迹，圣作时闻万岁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿庆二丘","author":"葛胜仲","text":"巍巍宝甃耸青冥，轩后开基向此生。\n云瑞已随仙驭远，电光犹绕北枢明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙文中县丞以诗送苦笋走笔六首为谢 其一","author":"葛胜仲","text":"豹皮羊角食无冤，烦助先生苜蓿槃。\n便敕佐饔淹苦酒，春馀调笔要多酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙文中县丞以诗送苦笋走笔六首为谢 其二","author":"葛胜仲","text":"张衡愁坐政烦冤，下箸南烹炤午槃。\n老作禅痴多不肉，每观觳觫鼻辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙文中县丞以诗送苦笋走笔六首为谢 其三","author":"葛胜仲","text":"爨无烟火叹厨贫，嘉蔌蒙颁胜八珍。\n苦口片时终隽永，端如药石尽规人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙文中县丞以诗送苦笋走笔六首为谢 其四","author":"葛胜仲","text":"茂林髡取未应贫，政恐书材窘伯珍。\n更请作桥通夜盗，可怜辛苦涉沟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙文中县丞以诗送苦笋走笔六首为谢 其五","author":"葛胜仲","text":"公圃荒凉此物无，畦丁遣饷十馀枝。\n他年京下憎羊酪，莫忘溪亭点酒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙文中县丞以诗送苦笋走笔六首为谢 其六","author":"葛胜仲","text":"碧润那忧盛夏无，骈头聊取供斋枝。\n辟疆园暗新苍玉，未害青柯贯四时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月八日蒙文中饷黑饭作诗二首纪谢 其一","author":"葛胜仲","text":"热际初经四月八，磨香灌佛晓泉寒。\n丞公忽致槃游饭，儿辈惊看欢喜丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月八日蒙文中饷黑饭作诗二首纪谢 其二","author":"葛胜仲","text":"方叹流尘生范甑，何图香黍溢颜箪。\n将军尚未封侯贵，推去那容学井丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比作黑饭新茶二首未蒙文中县丞宠和走笔再赋以助一笑 其一","author":"葛胜仲","text":"点漆饭蒙清净供，翻匙那敢配羊寒。\n独欣法味盈斋钵，尚欲诗辞看弹丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比作黑饭新茶二首未蒙文中县丞宠和走笔再赋以助一笑 其二","author":"葛胜仲","text":"三叹属厌阎没腹，十方皆满净名箪。\n定中不敢逃禅饭，卑景何因醉脸丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从仁叔求楷笏四首 其一","author":"葛胜仲","text":"异种初从弟子栽，东家宰木郁泉台。\n谁知当日勤封植，只作人间手板材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从仁叔求楷笏四首 其二","author":"葛胜仲","text":"好事频求阙里堂，文房裁斲已盈床。\n讲郎乞与非抛却，已办棼丝结紫囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从仁叔求楷笏四首 其三","author":"葛胜仲","text":"横斜文理秀斓斑，分饷閒官尚独悭。\n准拟遣人来检料，欲将拄颊望西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]