[{"title":"凉雨 其二","author":"韩淲","text":"陂池浮月影，桥闸泻风声。\n远雨收还施，行云翳忽明。\n襟期看我醉，谭笑待君倾。\n凉夜玉溪曲，行歌咏太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨凉","author":"韩淲","text":"暑雨常忧缺，秋霖莫厌多。\n夜雷声复厉，朝雾气方和。\n积润花岩桂，横流穗亩禾。\n酒閒吟解秽，茶熟困驱魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"韩淲","text":"山外黄云晚，溪头白雪深。\n不知岚气重，但觉水痕侵。\n老眼转愁坐，孤怀聊醉吟。\n樵声随远近，钓影任浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后霜结未释","author":"韩淲","text":"苦雨翻明雪，酸风结暗霜。\n晚烟留积冷，晓日度微阳。\n茶灶薪难拾，诗笺笔易僵。\n粗官对穷腊，何事不谋长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪再作冻甚","author":"韩淲","text":"春雪不可赏，草树方萌芽。\n从渠灭万径，徒自负千花。\n兀坐地炉侧，困眠山枕斜。\n浑忘瓶粟尽，吟复厌浮誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后如春","author":"韩淲","text":"雪消春意动，楼外已东风。\n兰佩新输绿，梅瓶久荐红。\n人生虽向老，岁事岂终穷。\n青琐黄扉地，西湖一望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对雪","author":"韩淲","text":"有雾光殊惨，无风势转豪。\n形攲天已近，气积地还高。\n上下何其别，周回任所遭。\n虚缘诗悄悄，幻灭酒陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪望","author":"韩淲","text":"山黯荒荒雾，溪凝恻恻风。\n乍明收髣髴，欲暮起曚昽。\n岸窄丛梅发，楼高老树空。\n归来煖杯酒，炉火夜深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风雪见山林佳绝","author":"韩淲","text":"烟浓山渐白，风急树还青。\n鹘落飞鸢径，鸥浮宿雁汀。\n周遮迷叠嶂，疾泻快中泠。\n敝褐舆篮兀，村醪饮易醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨雪","author":"韩淲","text":"雨雪春将半，山寒涧溢时。\n谁题五字句，我得一篇诗。\n淡泊情何远，绸缪味愈迟。\n閒中且陶写，治国有安危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪天","author":"韩淲","text":"寒色摇窗纸，瓶梅静吐香。\n小楼深坐稳，矮屋欠伸长。\n雪意垂垂白，云容淡淡黄。\n西湖林处士，侑食水仙王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春分后一日雪","author":"韩淲","text":"尚觉梅花发，元知柳絮飞。\n舞回风荡激，洒急雨霏微。\n解冻群芳盛，馀寒百卉稀。\n小窗还附火，买酒典春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初八日雪","author":"韩淲","text":"江国春来浅，新年雪未阑。\n雨霏初急急，霰集复漫漫。\n固喜成三白，宁忧已十寒。\n微吟窗色晚，清听落声乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"连日大雪","author":"韩淲","text":"年后犹仍腊，时閒即便春。\n飞花殊恼我，惹絮却随人。\n天地多奇观，江湖独老身。\n瓦沟填已遍，弹压万红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪作 其一","author":"韩淲","text":"腊里春前雪，江南瘴疠清。\n隔林应得趣，一壑岂忘情。\n已喜疏梅发，遥知细麦生。\n易疏何易密，积厚转无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪作 其二","author":"韩淲","text":"开明三景净，幻化十方清。\n此日扁舟景，古人高卧情。\n不知朝气重，但觉夜寒生。\n漫漫疑无色，绵绵如有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山","author":"韩淲","text":"指点东山路，松林一望中。\n芙蓉争弄日，杨柳半凋风。\n我到吟何比，人閒兴偶同。\n只宜携妓饮，名宦付诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄巡检摄官八房场闻西岩有龙湫光怪","author":"韩淲","text":"秋好西岩胜，閒身惜未游。\n桂花香乱石，枫叶暗长流。\n蜡屐输君适，锦囊牵我愁。\n定知风雨夕，龙电震深湫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹭鸶林","author":"韩淲","text":"一段寒烟上，云行断复低。\n明中山映树，暗处水平溪。\n村落篱门短，人家草屋齐。\n风回听幽绝，鸣午有荒鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坎石渡","author":"韩淲","text":"春风送春雨，细细湿舆篮。\n过水航寒渌，横山触晓岚。\n草芽时簇簇，梅片未毵毵。\n问友于何处，田砻坎石南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滩头","author":"韩淲","text":"溪头滩背狭，高下两三家。\n风叶山衔日，烟莎路湿沙。\n傍船初落雁，隔屋已栖鸦。\n何处吹崖蜜，满园荞麦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月岩","author":"韩淲","text":"本意游云洞，因行过月岩。\n西风低细竹，初日上长杉。\n尘外多仙隐，人间易谤谗。\n逍遥且黄帽，憔悴付青衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐影涧流","author":"韩淲","text":"篱落梧桐月，情人语夜深。\n露华垂近叶，烟翳失前林。\n茶果随宜设，琴尊不用寻。\n山虚鸣络纬，幽涧亦流音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅月台 其一","author":"韩淲","text":"渺渺凉风起，木犀相次开。\n举家空自住，过客有谁来。\n已是冰溪棹，更寻禅月台。\n郁乎湖海气，鸥鸟莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅月台 其二","author":"韩淲","text":"僧清知野逸，禅月有高台。\n自是登山去，谁非入寺来。\n孤花明密叶，落絮起荒苔。\n香篆茶瓯久，昏钟我未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花台","author":"韩淲","text":"耸壑连天碧，危台照水红。\n何年仙子宅，今日梵王宫。\n勾漏人虽远，凌云话亦空。\n徘徊羡真隐，吟写分诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵推官求久斋诗项平甫有句","author":"韩淲","text":"万好庵中主，今谁记此人。\n久斋诗固在，晏叟意尤新。\n已逸决科步，要持为学身。\n尚贤而尚德，馀事了通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵斯远过风月斋 其一","author":"韩淲","text":"老去亲朋少，相过夜达晨。\n百年俱逆旅，千载欠閒人。\n经隔情虽旧，绸缪意转新。\n板桥篱竹净，不著世红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵斯远过风月斋 其二","author":"韩淲","text":"地偏心愈远，彼自物争妍。\n屋宇山围匝，池塘水接连。\n持醪留野饭，推食有溪鲜。\n风月斋曾宿，施村阿那边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵主簿辟书室因喜三世两中科举","author":"韩淲","text":"喜辟书窗好，高垂雁塔名。\n孙谋端有自，祖业信能宏。\n山木郁争秀，檐花香最清。\n太霞仙袂远，老眼为双明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林堂 其一","author":"韩淲","text":"山林堂总好，六十有馀年。\n转变人常尔，兴亡事亦然。\n僧庐虽一坐，道院尚相连。\n弹指三家住，苍茫起白烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山林堂 其二","author":"韩淲","text":"山林君已得，丘壑我犹居。\n地在名徒换，年深景自如。\n舍人诗可玩，丞相事堪书。\n领略无轻负，交游本未疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芙蓉堂和严丈韵","author":"韩淲","text":"绿遍小池头，胡床一日幽。\n乍晴人意惬，欲暮鸟声流。\n只道耽閒趣，那知接胜游。\n红尘飞不到，城府亦山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西山岳祠","author":"韩淲","text":"西山桥外路，傍水去穿林。\n石柱岧峣起，溪流宛转深。\n清音成小立，爽气入孤斟。\n晻霭丛祠处，归涂月已侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净居院","author":"韩淲","text":"薄晚经禅悦，深更宿净居。\n急滩鸣断岸，绝磴下荒墟。\n茗椀僧同把，诗篇我谩书。\n快欤闻梵呗，解榻见钟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花庵次君实韵","author":"韩淲","text":"居山仍在涧，生事本无多。\n老圃初收芋，穷檐待补萝。\n逃虚惟独往，入俗也相过。\n语默行藏外，衰荣奈汝何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇福庵","author":"韩淲","text":"蓊郁千山曲，周游一径斜。\n老身多岁月，闲地少风沙。\n度密来尤迥，凭高望更赊。\n小庵含法界，不待野僧茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白莲庵分韵","author":"韩淲","text":"好客不常遭，登临眼自高。\n湖山起烟雾，江海暗风涛。\n酒美情尤畅，诗清气本豪。\n相从真可乐，左手记持螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大明寺","author":"韩淲","text":"小泊大明寺，伤怀复叹谁。\n黄花风未折，赤叶露空垂。\n已往更何说，相望只有诗。\n城南人亦客，数日梦行期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尹山寺","author":"韩淲","text":"风净绿阴合，山明清昼长。\n钵单浮野润，龛座閟幽香。\n鸟哢集初夏，鹤飞迎夕阳。\n离人何用饮，有客又成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱卿约余倅涧上招昌甫次韵昌甫","author":"韩淲","text":"春雨得晴明，山扉涧道清。\n朋来何以报，雅集偶然成。\n柳暗枝枝重，花疏片片轻。\n经年不相见，好事满壶倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"市远","author":"韩淲","text":"市远尘埃少，村虚烟雨多。\n极知九日近，无奈一秋何。\n扫径寻僧话，关门待友过。\n岩香送篱艳，尽可伴婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"稻田","author":"韩淲","text":"秋深耕稼熟，绿浪起黄云。\n纵却牛羊践，难驱鹅鸭群。\n断乾根易拨，摧压穟频分。\n烟露未全冷，村村晴气曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"飏糠","author":"韩淲","text":"飏糠新出米，打谷旋推禾。\n健妇行茶椀，痴儿守饭箩。\n一秋能饱未，终岁得閒么。\n农事无终极，人生可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种树","author":"韩淲","text":"种树拥墙隙，伐茅开地偏。\n老衰常问禄，贫窘失求田。\n晴热山前日，阴凉涧底泉。\n贤哉陶五柳，只爱北窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韵紫芝留句寄之","author":"韩淲","text":"一柱观能好，臞仙须讨寻。\n从渠有丘壑，何处没山林。\n乍惜灵舒试，或矜庄可吟。\n飒然秋气冷，清梦水之心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏堤芙蓉","author":"韩淲","text":"烂熳芙蓉发，霜前城北花。\n因君话书室，使我出山家。\n风雨三杯后，烟云一望赊。\n石丁馀兴在，相与醉生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观柳见桃","author":"韩淲","text":"柳已看看暖，桃仍恰恰开。\n叶间惊甚雨，花外合轻雷。\n不分青春半，其如素发催。\n官閒惟可句，心醉也寻杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹外荷花","author":"韩淲","text":"雨竹翻山翠，风荷漾水香。\n我行三步远，人饮一杯长。\n不以扶头去，其如扫迹藏。\n柳花才露白，梅子又传黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌父梅花","author":"韩淲","text":"山水孤根畔，行吟不尽情。\n花为天下白，人比圣之清。\n冬日真无对，春风合主盟。\n可怜香浩荡，岁岁落还生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅","author":"韩淲","text":"霜风小摇落，梅已到南枝。\n要识人间事，须从物理推。\n虚缘看影动，昭彻待香吹。\n此后唯愁酒，从来未欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野趣轩见梅花","author":"韩淲","text":"相逢暗香底，又见一年梅。\n枝既尔许瘦，花犹如此开。\n桥横红叶径，山晚白云堆。\n冻雨时吹洒，人閒寒事催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅径","author":"韩淲","text":"扫叶去宿草，园空起碧苔。\n晚烟收未了，初日又还来。\n老树幸无恙，新花应有开。\n年年到寒月，全望数枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西轩","author":"韩淲","text":"闻道西轩整，登临识自今。\n溪山虽郭外，楼殿接池阴。\n旧观赵岐发，新诗尹喜深。\n水南如此胜，吾老复关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题水鹊","author":"韩淲","text":"水鹊冲冲过，山鸦扑扑飞。\n涧深应得趣，树密自能归。\n古路人行少，家寒客到稀。\n世途多轗轲，邻里且相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山鸟","author":"韩淲","text":"春晚雨时晴，隔檐山鸟鸣。\n留连因共话，拓落又閒行。\n不选呢喃语，从教格磔声。\n酒来谁可饮，吾亦小诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雁度","author":"韩淲","text":"雁度南楼雪，寒声裂纸窗。\n身虽回五岭，影亦落千江。\n抱膝吟诸葛，全家隐老庞。\n冥冥避矰缴，一往信难双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高雁","author":"韩淲","text":"高雁承云薄，参差去复齐。\n水村连落岸，山寺迫浮溪。\n风定转宜远，日斜元未栖。\n一声归两眼，不负拄枯藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至看杜诗分古语妙语老语甚精微","author":"韩淲","text":"刺骨分三语，刳心就一编。\n古来虽简短，妙处实绵延。\n飞动徐陈外，淋漓刘柳边。\n泉溪有底急，老乃更精研。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张祐孤山寺诗","author":"韩淲","text":"岚光涌翠岑，寺影照波心。\n风月明春晓，云霞起夕阴。\n两山幽草合，中道绿杨深。\n谁与寻诗句，空怀处士林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绿筠轩观坡翁诗刻","author":"韩淲","text":"野寺馀诗石，谁移榜县斋。\n閒来得寻句，小立为兴怀。\n人俗真难疗，言高不可埋。\n窗前有疏竹，大嚼对吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读魏仲先处士诗有感偶成二首 其一","author":"韩淲","text":"顾影自婆娑，食贫如我何。\n不嫌知己少，常畏识人多。\n过涧耿独立，看山行自歌。\n衡茅湿馀雪，风叶乱烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读魏仲先处士诗有感偶成二首 其二","author":"韩淲","text":"涧泉韩仲止，生计聊复尔。\n无钱向谁嗟，有酒徒自喜。\n尽日览形容，流年惊发齿。\n夜夜犹早眠，寒来更慵起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晁家观叶少蕴朱希真诗帖尹家诸贤书尺","author":"韩淲","text":"摩挲石林帖，太息岩壑诗。\n竹院茶话久，方斋酒行迟。\n南游耆旧尽，北客子孙知。\n聚集麦秋日，飘流槐夏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫以平生诗藁俾赵家净录因见题后","author":"韩淲","text":"藁不随时废，诗须以藁传。\n老身犹在涧，旧话只章泉。\n箨笋看成竹，藕荷将出莲。\n居然閒摸索，久矣奉周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居图","author":"韩淲","text":"閒居本在我，山林皆画图。\n百世有新旧，一朝非卷舒。\n薰风入窗牖，晚雨过庭除。\n小醉同杯者，幽偏得自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夔一翁灵溪古松","author":"韩淲","text":"邂逅灵溪水，东风二月辰。\n其谁留象驾，为我出龙鳞。\n等是人间幻，聊分物外真。\n知心莫弹指，笑杀个中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金焦二山雪望图","author":"韩淲","text":"京口酒可饮，江山开画图。\n幻成清落索，要识雪模糊。\n不用袁安卧，只消渔父居。\n几回烟浪远，落木堕寒芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题江南","author":"韩淲","text":"邂逅江南景，萧萧小桂丛。\n不知春已过，常得晚能同。\n冉冉尘寰偪，劳劳色界空。\n飞潜与幽显，同是一樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡教授送行诗","author":"韩淲","text":"小作高溪泛，滩光又满眸。\n新春才两日，残岁忽扁舟。\n契阔思良觌，吟哦合共游。\n掀蓬闻送句，一片雨初收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶送番江酒次韵谢之","author":"韩淲","text":"荐福湖边酒，能来为一中。\n傃庵知祖道，鄱郡见家风。\n治县聊绥抚，诗坛更长雄。\n名章敢酬唱，雨后夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]