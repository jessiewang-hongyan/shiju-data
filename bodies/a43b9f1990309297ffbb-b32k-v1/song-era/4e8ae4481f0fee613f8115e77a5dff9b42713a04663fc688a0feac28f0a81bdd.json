[{"title":"思归","author":"宋祁","text":"去国倏三岁，颇知归思纷。\n南心晓城斗，北眼暮楼云。\n珥笔行将脱，朝珂冷不闻。\n莫论持帅节，畎亩尚思君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"按务东桥驻望","author":"宋祁","text":"岸峻双旌驻，桥横一水长。\n冻舟真欲住，低雁正成行。\n发发天含籁，棱棱野雨霜。\n停骖重回首，直北是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"按行府城通判张太博有诗美山川风俗因继作","author":"宋祁","text":"百尺谯城一凭栏，提封占尽古常山。\n公私雨足耕畴遍，赤白囊空寒候閒。\n拨剌河鲂供大嚼，含糊赵瑟劝酡颜。\n正应此地从军乐，先播辞人丽藻间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夕","author":"宋祁","text":"捲幔星河近，严城钟漏迟。\n飞虫集暗牖，栖鹊忌明枝。\n弱柳兼风困，高花战露危。\n回肠正无赖，仍此卧遥帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夕雨歇","author":"宋祁","text":"江云夜雨过前墀，菌阁微凉縠雾披。\n戒井漏残银箭促，青天笑罢玉壶欹。\n文波弱荇浮清濑，珍树惊禽绕暗枝。\n纵使何郎诗笔在，未应幽恨抵兰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夕闻雁","author":"宋祁","text":"声繁知并举，阵急想斜分。\n臆饱江南稻，身随代北云。\n足书烦远寄，箭道怯虚闻。\n口噤悲黄鹄，相望不及群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日出浣花溪","author":"宋祁","text":"侧盖天长荡晓霏，暖风才满使君旗。\n水通江渚容鱼乐，草遍山梁报雉时。\n场雨灭尘盘马疾，楼云碍曲进觞迟。\n少陵宅畔吟声歇，柳碧梅青欲向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊晓望","author":"宋祁","text":"睡足犹欹枕，欢沉即掩樽。\n风花飞有态，烟絮坠无痕。\n野色兼山远，溪流涨雨浑。\n渊明有归意，惟是对桐孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春宴行乐家园","author":"宋祁","text":"园芿初乾小雨泥，饮壶游屐况亲携。\n身轻早蝶千回舞，技痒新禽百种啼。\n乘暖草茵侵坐软，畏风桃绶向林低。\n阳晖自有留人意，衔照高楼未遽西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晏北园三首 其三","author":"宋祁","text":"日晏休尘虑，中园眷物华。\n惊禽曳啼去，弱柳受吹斜。\n暝早月沈碧，凉生水进涯。\n悠然望层堞，千翅度昏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晏北园三首 其二","author":"宋祁","text":"天意歇馀芳，人閒日始长。\n落花风观阁，睡鸭雨池塘。\n稍倦持螯手，犹残婪尾觞。\n春归无所预，羁客自回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晏北园三首 其一","author":"宋祁","text":"春物在无几，景随人意閒。\n笋生迷坞缺，花尽失林殷。\n坠絮来何所，轻云久未还。\n持杯问流照，肯信有朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晏病体少悰退卧北斋有寄","author":"宋祁","text":"小有负薪疾，早成憔悴姿。\n无人来迓跛，赖酒与扶衰。\n朴斲知林短，腥膢厌席卑。\n西山一丸药，何忍独相遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓感别","author":"宋祁","text":"楼外疏钟落晓河，天涯感别思烟波。\n三年客鲤传书远，五丈星机得素多。\n沟水东流劳想像，峡灵西去隔嵯峨。\n良辰自古难并乐，不独骊驹送客歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晖寓目二首 其二","author":"宋祁","text":"春意都无几，还持欢绪归。\n游蜂抱蕊去，惊燕失泥飞。\n风下幡幡影，霞留暝暝霏。\n既知瑶席恨，不减欲沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晖寓目二首 其一","author":"宋祁","text":"春序倏云晚，高台芳意多。\n花成风地缬，鸟作暝林歌。\n树气薰繁幄，池文叠细波。\n夹城归骑散，烟絮遍铜驼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚写望","author":"宋祁","text":"不觉春芳晏，翻成客望劳。\n草平天一色，风暖燕双高。\n击轊争轻幰，书旗衒缥醪。\n随宜歌白纻，都士半云袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚官舍呈幕中","author":"宋祁","text":"万点飞花拂路尘，行春罢后惜残春。\n雨催菖叶全成甲，风播榆钱不算缗。\n多病已惭官绶束，长年惟共酒杯亲。\n坐题吏诺君何怪，只是涟漪素食人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春野观农事","author":"宋祁","text":"茂气回鲜野，寒姿换故林。\n败防溪响急，新圳耒痕深。\n乳雉嬉原隩，歌牛下浦阴。\n吾庐堪学稼，将老有初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪","author":"宋祁","text":"银砾欺春乱眼来，重阴万里压平台。\n光沈后牖将飞瓦，艳补南枝已落梅。\n池曲平翻冰共泮，山腰未积玉争颓。\n长安并长旗亭价，蜀女当垆自涤杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪寄郑府尹","author":"宋祁","text":"风御凭空揽玉尘，急飘斜舞碎霙匀。\n九重阙里都无夜，五出花前自作春。\n剩借薄寒添雁夕，强留馀晦恼鸾晨。\n须知柳絮纷纷态，迷杀章台便面人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春霁","author":"宋祁","text":"一雨初晴小雾披，海天羊胛报晨晖。\n寒消艳雪沈楼唱，暖入重帘御袷衣。\n柳外轻黄纷漠漠，梅梢残白怅微微。\n烟皋笑电无穷乐，行御鲸牙逐锦翚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼寝","author":"宋祁","text":"静拂藜床藉蠹书，曲肱聊与古为徒。\n梦柯尚费论荣辱，讼鹿何烦竞有无。\n庭下细光风泛蕙，隙中斜影日低梧。\n宰墙不塓嵇胞转，宁觉人间有畏途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柔上人","author":"宋祁","text":"行年踰八十，安坐布金园。\n指柏仍馀树，栽桐遂见孙。\n岩泉晨自濯，经叶夜能翻。\n顾我生多病，劳师默遣言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳花","author":"宋祁","text":"休誇濯濯映高楼，枝里征花自不收。\n回雪有风尝借舞，落梅无笛可供愁。\n白门暝早随鸦背，京兆情多拂马头。\n莫惜馀温添翠被，有人凝绝在孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残月","author":"宋祁","text":"阴光随落宿，有意待朝阳。\n晕缺灰馀影，潮平鹭息狂。\n残兵骄子国，隐语大刀郎。\n此夜方诸泪，宁能减数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残花","author":"宋祁","text":"林下感馀欢，流芳逐雨残。\n香归蜜房尽，红入燕泥乾。\n梦短休成蝶，肠回却掩鸾。\n故应成异果，持去掷潘安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残秋霁景","author":"宋祁","text":"霜旻初毕雨，日气上熹微。\n寒水流无急，高云薄未归。\n书閒仍积箦，琴燥乍移徽。\n负郭泥妨辙，翻劳急掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"段释之客都下作诗道其怀","author":"宋祁","text":"密雪天街客履穿，更将羁思敌彫年。\n无人载酒谁同乐，有物烧愁便许燃。\n腷臆文章千牍上，萧条光景二毛边。\n我能知子今何赖，无用长于马腹鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉","author":"宋祁","text":"容与下层岑，飞流界百寻。\n记方谁辨玉，杂溜自成琴。\n细浪浮烟阔，回波逗月深。\n我来聊挹注，嚼药有初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸酉六月奉诏修耤田记十一月诏罢赋诗","author":"宋祁","text":"三时受诏拥缇油，曲笔无功苦思抽。\n不得成书同太史，须知非我异春秋。\n空言自合因人废，残藁犹应盖瓿留。\n归卧私庭深阁笔，饱尝鸡膳太悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省判李度支硕相过叙别兼述感怀","author":"宋祁","text":"君趋召节向中台，我滞边州未得回。\n头白羞论天下事，眼青欣举故人杯。\n池蛟得雨鳞先动，霜隼乘风翅始开。\n见上若询颇牧将，为言儒帅果非才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看雪","author":"宋祁","text":"惨淡繁云密霰狂，结瑶城堞俨相望。\n偷寻柳絮思隋岸，误折藜光认洛阳。\n斜透绮帘欺翡翠，旋迷楼瓦失鸳鸯。\n平台宾客今何在，谁继邹枚从孝王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗役邻郡道中晓发","author":"宋祁","text":"故园回眼隔云罗，野马征尘拂袂过。\n息影有时悲恶木，回车无暇避朝歌。\n风号万响天衢籁，山矗千头佛国螺。\n游子行行归计晚，庾心一寸奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗役道中二首 其二","author":"宋祁","text":"絮乱东风急，花飞杂树稠。\n离家王粲恨，赠妇彦先愁。\n樵浦连樯度，旗亭数盖留。\n痴人了官事，归钓误楂头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗役道中二首 其一","author":"宋祁","text":"濩落无容物，嵚埼可笑人。\n唯当荷农笠，不称荐华绅。\n宦味真缰锁，生涯累水薪。\n穷途计安出，祗是有沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答公序相国二兄见寄二首 其二","author":"宋祁","text":"壮引朱颜往，衰招白发生。\n危心几何折，劳尾自然赪。\n把酒天涯恨，搔头岁暮情。\n将何献康乐，衰思顿如酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答公序相国二兄见寄二首 其一","author":"宋祁","text":"前时同出守，星鬓各萧萧。\n蹊李伐不食，原禽行自摇。\n棹前饶沸浪，蓬处但惊飙。\n素愿山林隐，公乎不在招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答天平庞相公","author":"宋祁","text":"白玉堂中旧演纶，赤帷裳底老班春。\n攫煤自省非尝饭，投杼徐知不杀人。\n常恐虚名遭嚇鼠，宁防平路解摧轮。\n由来辨谤须君宰，收得江鱼未葬身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答天平相国庞公追记旧游见寄","author":"宋祁","text":"把酒同为花下宾，东风一十五回春。\n欢情坠若瓶边绠，感绪多干臼里辛。\n枚马老能持从笔，夔龙今已避鸿钧。\n附尘旧好公须忆，憔悴惟残厌次人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答太傅邓国张相公","author":"宋祁","text":"鸭陂清浪撼城隅，此地班春忝细书。\n琪树老来抛禁省，玉绳低处认皇居。\n君轩恋结萧萧马，客素愁凭六六鱼。\n相阁裁章怜旧物，为曾簪笔从雕舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答延州安抚吴宣徽","author":"宋祁","text":"共看仙山玉树秋，从簪朝笏记同游。\n调元遂庆登三府，抱帙惟堪读九丘。\n重印垂腰荣拥节，征鞍摩体忝为州。\n如何却舐投残笔，敢与阳春接唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答洛台资政房春卿侍郎","author":"宋祁","text":"青绫襆罢歇徐薰，粗吏多年叹不文。\n病合避贤抛内署，老堪为帅忝中军。\n声名已愧空如饼，富贵原知薄似云。\n多谢翔鸾念笼鹄，不然谁信旧同群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答相国庞公将至并部马上垂寄","author":"宋祁","text":"大旆前驱拂晋云，寒天迎望静无氛。\n幄中旧借留侯箸，麾下今分邓禹军。\n驰属櫜鞬随指顾，卖残刀剑事耕耘。\n据鞍抒思真馀力，又占风骚第一勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祗答提举观文丁右丞","author":"宋祁","text":"恳辞金殿得班春，藁箧相从素濑滨。\n坐阁仍题修史笔，去乡犹是受经人。\n浮云富贵心知厌，淡水交游老更新。\n三叹来章深意在，肯容冠绶久生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕不寐","author":"宋祁","text":"槭槭始遥夜，骚骚无寐时。\n啼螀思岁晚，寒叶伴人衰。\n白发生将遍，丹砂化苦迟。\n多情是残月，通晓共遥帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕池上","author":"宋祁","text":"楚江枫老树无烟，池上悲秋一惘然。\n素蚌亏盈长伴月，戏鱼南北各依莲。\n风驱野燐寒争出，露警皋禽怨不眠。\n伏槛临流未成下，紫荷声外转珠躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日与天章侍讲王原叔曾明仲正言余安道三学士集普光院","author":"宋祁","text":"长廊尽北到禅扃，宴坐林间共褫缨。\n秋气只知双鹤唳，尘喧已去一牛鸣。\n晨钟暮磬无时歇，翠竹黄花相间明。\n妙墨仙郎题爵里，他年为寄此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀","author":"宋祁","text":"风头日萧索，爽气自西岑。\n暝戍有传鼓，寒城无罢砧。\n未论乡思苦，且念岁华侵。\n目羡高高雁，先时到上林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀","author":"宋祁","text":"秋旻荡喧浊，茂宰属高情。\n水绕溪初浪，林乾籁自声。\n醉茵留剩暖，欢瑟泛馀清。\n尚念江湖守，其如华发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日四首 其四","author":"宋祁","text":"秋气飒然爽，宴居差有情。\n蝇休几案洁，蝉罢亭皋清。\n溪水照心碧，云山刮眼明。\n其如岁云晏，天地莽峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日四首 其三","author":"宋祁","text":"禁林成宿忝，愚谷负深归。\n未识前途远，容知昨日非。\n巧劳真物役，静胜乃天机。\n君看琴中意，何尝在玉徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日四首 其二","author":"宋祁","text":"客心惊暮节，天意歇馀芳。\n莲罢池收子，榴成露罅房。\n绨袍亲故暖，纨扇委空凉。\n庾信真愁否，仍能用斛量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日四首 其一","author":"宋祁","text":"短影悠扬日，薄寒憀慄天。\n林声蝉后老，陂影雁宾联。\n悽感客自尔，变衰时适然。\n何须问容鬓，所遇是凋年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日咏庭树","author":"宋祁","text":"庭树报秋归，萧然芳意衰。\n露危阴处叶，风劲暝前枝。\n嘒嘒蝉嘶早，梢梢鹊定迟。\n江潭正摇落，司马不无悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日射堂寓目呈应之","author":"宋祁","text":"射圃云堋枕庾园，危亭虚白敞南轩。\n霜柯橘嫩金衣薄，风沼荷倾钿扇翻。\n谢枕吟魂迷带草，嵇襟真虑属堂萱。\n岸巾昼日聊相对，坐听凝笳出缭垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其二","author":"宋祁","text":"遥夕何曾寐，孤怀有为忧。\n谋多真逗挠，师老但诛求。\n朔雾摩边垒，羌风殷战枹。\n吾生诚用寡，叹罢只搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其一","author":"宋祁","text":"天地西风遍，亭皋衰意生。\n寒云终不雨，危叶自多声。\n晚蟪犹嘶树，啼鸦稍著城。\n默然孤客思，年序共峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴 其三","author":"宋祁","text":"先日二毛生，秋来无复惊。\n南风随楚俗，北斗望都城。\n坞栗霜开罅，池莲雨折茎。\n停樽问天意，何适付枯荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋阴","author":"宋祁","text":"拥栋溪云暝夕霏，萧辰寥落意多违。\n寒蝉自为齐王怨，归燕长逢阿母飞。\n杜若汀洲残绿暗，芙蓉池沼坠红稀。\n流尘满席宾綦绝，谁问西河战胜肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热","author":"宋祁","text":"风物连南国，炎威逼早秋。\n堕飞波上翼，误喘月中牛。\n云杼衣全解，冰壶渴未瘳。\n此时班女怨，虚为素纨愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚溪上","author":"宋祁","text":"积水增波润，苍霞变露馀。\n断烟随鸟远，寒叶向人疏。\n萍老犹迎日，莲衰尚戏鱼。\n临川方病涉，谁借郑卿舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋霁二首 其二","author":"宋祁","text":"气爽无馀暑，天高不住阴。\n霞残仍是绮，风冷即名金。\n烟沼双鱼乐，霜郊一鹗心。\n此时灵运唱，无复答愁霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋霁二首 其一","author":"宋祁","text":"晓河回北陆，夕雨净西郊。\n水足鱼忘喣，林寒鸟恋巢。\n阁苔浮绿晕，社橘老丹包。\n谁与同真想，清风是淡交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝荤","author":"宋祁","text":"多年卧病厌腥膢，香饭初依竺国流。\n宣父蒲菹真可学，钟岏蚶蛎更无求。\n炉销午篆天花泊，几隐宵灯偈叶留。\n割肉炰羔非我事，此身今悟一浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡氏迟客亭观诗","author":"宋祁","text":"石磴松蹊自不尘，亭名迟客客回轮。\n山中桂好虽留隐，岭上云多肯寄人。\n梦草数残康乐夜，禊杯閒记永和春。\n共游弭盖争摛藻，剩破林烟炙翠筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡同年恢信州弋阳簿","author":"宋祁","text":"笼樱沈醵宴，津鼓怆离群。\n道出东南水，心留西北云。\n秫田供酝剂，练幅换书裙。\n熛阙方呼俊，归来伫献文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡寅赴明州慈溪尉","author":"宋祁","text":"久困天官调，东南亦第如。\n客篙新溜急，春树杂花馀。\n越?丰池鸭，吴袍竞库綀。\n还音与归梦，并附浙江鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]