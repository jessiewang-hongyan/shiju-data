[{"title":"寓兴十首 其五","author":"张至龙","text":"种鞠一百丛，九月开盈枝。\n莫言无好花，好花开较迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答黄芳洲","author":"张至龙","text":"抱膝书楼望太清，一生心事月同明。\n因过邻寺分茶供，闲取高僧史传评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上曲","author":"张至龙","text":"匣里干将午夜鸣，碧油幢下梦魂惊。\n沙场燐火风吹起，半在骷髅眼底明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚节西塘省鞠","author":"张至龙","text":"鞠胎绿蕊未曾成，百种丛中半忘名。\n试检记花牌字看，春篱醉墨欠分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"槎","author":"张至龙","text":"槁形冷度几晨昏，不受东风一点恩。\n却有仙人求作伴，浪游星渚到天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其四","author":"张至龙","text":"猩猩陨机阱，鹦鹉锁金笼。\n言笑适为累，缄嘿斯保躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其三","author":"张至龙","text":"雀食野人田，燕栖公子堂。\n野情饥亦乐，依人难久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其一","author":"张至龙","text":"麒麟感世出，凤凰览德至。\n人苟常见之，应不指为瑞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北津","author":"张至龙","text":"独立长桥喜近城，半阑斜日又催行。\n船过别浦波痕没，堠立当涂里界明。\n古木云边僧住处，落花风里鸟啼声。\n青山莫道浑无事，日与行人管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱柏岩约南归","author":"张至龙","text":"忍闻秋管悲，犹未定归期。\n吟咏穷边长，艰难老后知。\n水寒鱼上少，月闰雁来迟。\n不作膏粱梦，长令一剑随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江常庵出武夷","author":"张至龙","text":"厌居京洛说行持，袖裹青蛇上武夷。\n仙为写真供御览，天怜病眼召神医。\n江中白石差龙斲，洞里苍松带鹤移。\n无事出山衣屦湿，满城风雨鞠花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐云寺","author":"张至龙","text":"雨疏分点下，略彴界横塘。\n接竹通生水，搴萝补坏墙。\n字涂窗眼黑，香染佛衣黄。\n未晚萤先出，萧然两画廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李梅涧雪夜留饮","author":"张至龙","text":"拥炉收案牍，市远隔諠哗。\n妓唱新填曲，僮分旋碾茶。\n花枝承雪重，烛焰受风斜。\n僦屋为官舍，更深酒更赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武夷山","author":"张至龙","text":"九折沧江转苇航，花间流水自宫商。\n岩开天线登无路，殿锁仙金拜有光。\n曝背龟从平石上，避人猴向险枝藏。\n断桥盍有重红日，狂欲乘风扣魏王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡口","author":"张至龙","text":"峡深犹有路，泉远不知源。\n禽学乡谈语，山填野烧痕。\n晚风樵笛坞，春日酒旗村。\n茆舍人耕罢，凫雏浴水浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点史","author":"张至龙","text":"水草山花各自春，闲居常谨坐船身。\n忠言似药偏医国，好句如金不疗贫。\n王霸兴亡难讳史，彭殇寿夭不由人。\n感来莫计更深浅，祇见苍头换烛频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送镜山僧游雪峰","author":"张至龙","text":"海风迎铁锡，半是水为程。\n故国往来熟，空门宿食清。\n旧房云借住，早路月同行。\n象骨最高处，师今履似平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄宝林僧","author":"张至龙","text":"磨折英雄辈，无停日月梭。\n达人愁梦少，明主直言多。\n药试单方验，碑评近本讹。\n吟成无爱者，寄与病僧哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄苕川故人","author":"张至龙","text":"千古长情祇翠岑，休谈点石化黄金。\n秋来国事方尝胆，病后禅机忽上心。\n老眼看书嫌字细，乾喉饮酒喜杯深。\n几回空检斑衣箧，望断白云天外阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄胡竹洲","author":"张至龙","text":"野菜生根土亦香，寒林晴久漏春阳。\n山临古画开当户，蜗学名书篆满墙。\n密竹旋删嫌碍月，青柑迟摘待经霜。\n儿童闲取池头水，剜破琉璃绿一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步寄刘澄斋","author":"张至龙","text":"纵横屐齿印苍苔，梦笔山高翠作堆。\n日带晚光归海去，风传秋信下天来。\n竹开小路通萤过，松守空巢待鹤回。\n蚋瓮乾坤还自乐，何须金屋玉楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜杨琴隐至","author":"张至龙","text":"世涂多不平，择地度吾生。\n风静花迟落，云移月倒行。\n自抄闲作改，客借古琴评。\n凡事虚空里，何劳苦著情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登东山怀朱静佳","author":"张至龙","text":"布石行山涧，云封竹洞名。\n照池传古貌，借箸数同庚。\n禽斗巢几覆，蛛闲网半成。\n冬深犹见菊，还忆晋渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简胜上人","author":"张至龙","text":"林深岚气重，一犬吠寒烟。\n高思天云外，新房柏树边。\n爱蒲寻石种，惜茗滤泉煎。\n昔创如来殿，老于师一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横峰感事","author":"张至龙","text":"石角多情挽布衣，候虫送响出林微。\n文章首面趋时好，字学偏傍徇俗非。\n绿水被风吹作白，密花因雨打教稀。\n归鸦路熟知巢近，直望松林尽翅飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题白沙驿","author":"张至龙","text":"雾裹峰头薄似巾，路逢水后误行人。\n山泉酿酒力偏重，石铫煎茶味最真。\n燕不传家犹教子，梅才有肉便生仁。\n枕边学梦人方悟，未到钟声梦更频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠刘介庵","author":"张至龙","text":"一心忧道不开眉，懒扣黄扉谒故知。\n有累祇因难弃鹤，无疑何用苦求龟。\n常厨饮食夷齐辈，晚笔文章汉魏时。\n冷笑富家钱塞屋，兰亭谁更有真碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古别离","author":"张至龙","text":"扶上花骢酒半醺，望沉鞭影暗销魂。\n离情恐被行人觉，背拂菱花补泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其九 小实","author":"张至龙","text":"青青长朱裳，小摘脆不堕。\n勿欺如豆微，中怀仁已大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其四 半开","author":"张至龙","text":"五出稍敷露，不受尘目爱。\n鲜鲜著精神，独于此时最。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其七 半谢","author":"张至龙","text":"旋随琼霙飞，绕我茆屋角。\n结子意渐浓，岂为羌管落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其五 全开","author":"张至龙","text":"昨夜东风多，花神莫之禦。\n玉立对幽人，十分尽情吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其八 全谢","author":"张至龙","text":"冰花不留丁，收香尽藏白。\n一朝作陈人，逊与桃李出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其一 梅梢","author":"张至龙","text":"根清条不肥，影落明月地。\n凄凄欲寒时，胚腪已生意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其三 欲开","author":"张至龙","text":"凝成姑射姿，幽洁世所独。\n春近迫芳心，羞涩破唇玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其六 欲谢","author":"张至龙","text":"垂垂雪中枝，暗里度香远。\n忽动调羹机，黏枝花力软。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十咏 其二 蓓蕾","author":"张至龙","text":"历历衔冰霜，缀作珠的皪。\n香色俱浑然，花中之太极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其十","author":"张至龙","text":"十年插柳枝，今与高树齐。\n垂条绿春风，上有流莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其九","author":"张至龙","text":"夏月灌鞠根，见花在秋日。\n先时不施工，临花已何及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其七","author":"张至龙","text":"草虫设细网，小阱不可见。\n日日朝露中，群白草间现。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其四","author":"张至龙","text":"迟月上深夜，新蟾不终夕。\n何如月圆时，通宵照无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其三","author":"张至龙","text":"东日照瓦霜，西向界馀白。\n莫言日不到，日光来未及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其二","author":"张至龙","text":"日夜江水流，不海水不止。\n孰谓流去者，不是海中水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴十首 其一","author":"张至龙","text":"孤灯照长夜，膏尽灯影灭。\n划见窗户间，鲜鲜有明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫微阁赠凌丹士","author":"张至龙","text":"风林叶叶带新寒，匕箸齑盐客味酸。\n兔抱粟眠传道石，鹿衔花上拜章坛。\n沿崖取水和冰嚼，扫壁题诗当画看。\n尽日玄房无俗话，山钟敲月上阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其十","author":"张至龙","text":"墨鱼黑覆形，火萤明照身。\n拙于用显晦，踪迹徒自陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其九","author":"张至龙","text":"犬眠苍玉地，猫卧香绮丛。\n倘无鼠与盗，猫犬命亦穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其八","author":"张至龙","text":"饥鹰健搏兔，馋鹭勤捕鱼。\n各为口腹累，不闻有驺虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其七","author":"张至龙","text":"江鳞行比目，沙鸳睡交颈。\n不知山兔寒，清夜顾蟾影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其六","author":"张至龙","text":"鹊鸣人共怜，乌鸣人共嫉。\n祇因声妍媸，何心报凶吉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其五","author":"张至龙","text":"蚕饱办丝课，蜂忙供蜜工。\n役役为人劳，衣食还自空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演雅十章 其二","author":"张至龙","text":"櫩蛛巧经网，林鸠拙营巢。\n孰知拙反胜，网坏巢独牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题隐者壁","author":"张至龙","text":"寒著麻衣馁食薇，乐山清兴只琴知。\n蛛经圆网当中立，蜂徙新厨出外飞。\n山脊倚天无改日，草根埋雪有青时。\n莫言鸿燕多相背，去去来来共一机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴江甘泉","author":"张达明","text":"桥下四㮬水，人间六品泉。\n松陵无鲁望，山茗为谁煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耆英会诗","author":"张问","text":"槐庭二老乐尧仁，盛集高年洛水滨。\n华衮具瞻虽礼绝，白头序齿却情亲。\n清闲几席同禅院，山野巾裘似隐沦。\n尊酒椒香才过节，池塘草色已催春。\n白公酣畅吟哦内，卫武康强笑语频。\n岂独丹青传不朽，潜欣风俗欲还淳。\n芝田鹤戏调形健，莲叶龟游纳息匀。\n商皓寂寥拘小隐，汉疏局促止家人。\n莫因气貌疑丹灶，自有光阴寄大椿。\n复得兼谟为重客，恐遗元爽在编民。\n神仙可学今方信，道术相忘久益真。\n满座交欢祝眉寿，群生五福托鸿钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"礼法门寺真身塔","author":"张问","text":"众生瞻窣堵，回向大觉身。\n内顾六尺躯，一雨无诸尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华清宫","author":"张齐贤","text":"当时不是不穷奢，民乐升平少叹嗟。\n姚宋未亡妃子在，尘埃那得到中华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答西京留守惠花酒","author":"张齐贤","text":"有花无酒头慵举，有酒无花眼倦开。\n好是西园无事日，洛阳花酒一齐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石将军南征赋赠","author":"张齐贤","text":"五花密布生门出，三令重宣夙将听。\n划地岂能容贼窟，指天不许见妖星。\n醪投汉水期分饮，石削巴丘待勒铭。\n洗尽甲兵安草木，君山依旧望中青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自警诗","author":"张齐贤","text":"慎言浑不畏，忍事又何妨。\n国法须遵守，人非莫举扬。\n无私仍克己，直道更和光。\n此个如端的，天应降吉祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豫章胡氏华林书堂","author":"张齐贤","text":"一百年来烟爨同，衣冠江左慕家风。\n儿孙歌舞诗书内，乡党优游礼让中。\n孝弟筠编争纪录，门闾天语赐褒崇。\n莫将六阙方朱氏，叶叶蒸尝奉始终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御书飞白玉堂之署三体宸章并宣禁苑睹兹盛事辄动斐然","author":"张齐贤","text":"宠深仙署降新牌，御笔亲题重俊才。\n四字千龄悬日月，两篇三体琢琼瑰。\n登科郤桂皆同树，入室丘门尽仰回。\n寓直静封芝检去，密宣荣对玉泉来。\n职清望峻人稀见，地贵扃严画罕开。\n多幸谬持黄阁柄，烟霄时得遂游陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致仕后戏赠故人","author":"张齐贤","text":"午桥今得晋公庐，花竹烟云兴有馀。\n师亮白头心已足，四登两府九尚书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠贺兰栖真","author":"张齐贤","text":"日耕云耨杂芝田，洞府游多隐奉仙。\n耸秀万寻连翠峤，澄明一派接灵泉。\n凤书昔降幽居侧，鹤驾曾朝瑞日边。\n四海高名谁可并，赤松黄石好齐肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"视旱田赋呈上元簿杨明卿","author":"王信","text":"轮蹄旦旦风尘表，入眼群山青未了。\n刺藤迎日子先红，荞麦得霜花渐老。\n丛祠诡怪画村疃，古寺骞腾出林杪。\n征衫多次逐飞鸢，下担有时随宿鸟。\n初晴得去恨迟迟，独夜不眠忧悄悄。\n公如老骥暂伏枥，我类游鳞终屈沼。\n一朝王事有期会，百里民情同探讨。\n详于禹贡辨等级，明似离娄烛幽眇。\n高依丘垄或微收，低近陂塘翻尽槁。\n凶荒有数合均一，报应于中又分晓。\n不能究实害非浅，傥使从宽恩岂小。\n兹行到处欲春风，批放莫教分数少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七里滩","author":"张伯玉","text":"漱玉鸣珠七里滩，到今犹照客星寒。\n卢奴有水徒千顷，未得高贤一瞬看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官新定寓兴三首 其三","author":"张伯玉","text":"溪山千古绝浮埃，时拂朝衣上钓台。\n却恐被它渔父笑，糟醨不啜又閒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官新定寓兴三首 其二","author":"张伯玉","text":"汴水东浮不系舟，到官无事只轻鸥。\n不才自古侥天幸，请却俸钱溪上游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官新定寓兴三首 其一","author":"张伯玉","text":"关山雨雪征人泪，京洛风尘倦客心。\n谁信子陵溪上去，一川秋净涤烦襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五云溪醉归","author":"张伯玉","text":"每日溪头醉脸红，归来庭院夕阳中。\n依稀听得家人语，扶起五云溪上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏小小墓","author":"张伯玉","text":"小小仙踪去不还，空标遗冢落人间。\n钱塘门地家何在，回首临平隔断山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送花赵提刑","author":"张伯玉","text":"蓬莱阁上牡丹开，尽日凭栏望外台。\n不敢登门谒樽酒，且教山仆送花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿普光寺","author":"张伯玉","text":"无端未得归林下，又向南方拥使麾。\n夜宿禅关更萧洒，一轩寒月照清池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]