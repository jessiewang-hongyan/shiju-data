[{"title":"次韵方教采芹亭 其三","author":"方岳","text":"竹外清溪溪外峰，谁搴薜荔采芙蓉。\n所思渺渺隔何许，我欲从之骑九龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其六","author":"方岳","text":"客怀老去向谁开，白雪茎茎不用栽。\n只有爱书馀习在，待携残藁过溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其五","author":"方岳","text":"莫问秋风八月槎，一蓑欲老水之涯。\n笔床茶灶肯同住，毕竟吾宗是作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其四","author":"方岳","text":"终日看山自一奇，寒溪更与月相宜。\n采芹人去夜岑寂，政是先生得意时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其八","author":"方岳","text":"山自西来玉作层，千峰住处一溪萦。\n宜晴宜雨乍明灭，不是老天无十成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其一","author":"方岳","text":"手斸风烟不占多，春来物物是阳和。\n极知山与诗为地，老去无诗奈若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其十","author":"方岳","text":"研朱滴露月三更，见说群书作堵环。\n君自苦于经传癖，不如借我去看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方教采芹亭 其七","author":"方岳","text":"默坐焚香尽自佳，莫随俗眼乱空花。\n古今人物不相及，元只中间隔一些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵方蒙仲高人亭 其九","author":"方岳","text":"相从文字盟，不与如此酒。\n他日有移文，毋令猿鹤受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶宗丞湘梅 其一","author":"方岳","text":"双娥洒泣凝春竹，粉落脂残不忍妆。\n开作疏花寄幽独，雪中仍作楚骚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶宗丞湘梅 其二","author":"方岳","text":"庾岭以南非楚产，离骚不载亦堪嗟。\n行吟傥见灵均否，且与辛夷定等差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵牟监簿 其一","author":"方岳","text":"几携笔砚傍书林，吟到更寒月未沈。\n有客忽从天禄至，人间便隔五云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵牟监簿 其二","author":"方岳","text":"秋声满院有谁来，亦欲从君话老怀。\n隔竹已敲茶臼雪，不知何日又清斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵至能湖上","author":"方岳","text":"春山如染费人诗，骤马新堤拂柳丝。\n杜宇一声春欲暮，海棠睡去未曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵别友","author":"方岳","text":"长汀草色恨连天，一片飞红涨绿川。\n寒入湘帘君又去，只随燕子过年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵别友","author":"方岳","text":"砚香不肯与山留，雨浥寒花断送秋。\n后夜酒醒诗更好，淡烟荒草并渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵君用寄茶","author":"方岳","text":"茅舍生苔费梦思，竹炉烹雪复何时。\n北山怕有移文在，谨勿便令猿鹤知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其十一 木瓜坞","author":"方岳","text":"与山作计未为疏，尽有奇功可屡书。\n但得相寻双脚健，不须论报计琼璩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其十五 东斋","author":"方岳","text":"佳木扶疏漏晓暾，书床留得夜来云。\n幽经谈尽无功课，自理东窗芝朮熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其十三 正己亭","author":"方岳","text":"少日横刀属两鞬，玉花曾几试戎鞯。\n归来聊复观仁耳，不在惊鸿落劲弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其三 竹径","author":"方岳","text":"此君老去更风猷，冰雪生寒我辈流。\n穿径略容携客共，交情畴昔雅相投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其六 烂柯台","author":"方岳","text":"玉行敲断欲生尘，翻手那知局面新。\n到了不妨饶一著，旁观自有识机人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其九 卧云庵","author":"方岳","text":"半坞云侵藓石床，向来忧乐已俱忘。\n墙西有竹曾留鹤，梦亦相携入帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其二 金沙荼蘼径","author":"方岳","text":"露浥晴光对洗妆，柔条无力不成行。\n阿环淡伫阿娇丽，一种风流各自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其七 茶岩","author":"方岳","text":"壑底云香不等雷，便携石鼎与俱来。\n鹁鸠唤得西溪雨，顿得春从齿颊回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其五 海棠径","author":"方岳","text":"酒泻银壶莫近傍，怕惊花睡损残妆。\n拟题报答春风句，也恐春风未敢当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其十 梅坡","author":"方岳","text":"风雪灞桥篱落间，寒驴乘兴寄曾攀。\n三生习气除难尽，也许渠分一半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其四 清音亭","author":"方岳","text":"净洗从前两耳埃，溪声并逐雨声来。\n此奇赖有诗能领，一笑钟期安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居十五咏 其十四 紫阳阁","author":"方岳","text":"隔岸烟云一望间，夜深笙鹤与俱还。\n不缘曾识谪仙面，未必烟云住此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 ?然堂","author":"方岳","text":"心亦元如止水渊，断无尘想到诸贤。\n左蜗不断追?梦，说与青山恐未然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 日涉园","author":"方岳","text":"老石山苔手自治，爱閒诗最与山宜。\n园官莫惜频来往，破费春风又几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 见南山亭","author":"方岳","text":"能令诗腹化神奇，香到黄花秋力微。\n我醉悠然山亦醉，竹深啼鸟自忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 亦乐堂","author":"方岳","text":"分得山云老一瓢，梦寒不记紫宸朝。\n无人画出閒中味，吟入梅花雪径遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 息斋","author":"方岳","text":"尘途长逐众人忙，不抵斋扉一枕凉。\n世路巇岖吾倦至，底须辛苦为膏粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 虚静堂","author":"方岳","text":"世事鸥忘句肯卑，云深料理旧花枝。\n了无一鸟传幽意，只对青山自解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 赋梅堂","author":"方岳","text":"夜草春笺奏玉皇，横波曾识水曹郎。\n砚香留得东风在，一吐嵬崔冰雪肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋尚书山居 醉陶轩","author":"方岳","text":"时复中之兴已高，是非一付与春醪。\n向来醉眼略四海，粗记柴桑人姓陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李山窗","author":"方岳","text":"一船明月秋江冷，曾与梅花有约来。\n谁唤雪溪回短棹，宁孤何逊莫孤梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杜监簿 其二","author":"方岳","text":"杜曲无边风露秋，瓮头酒熟了无忧。\n一诗连夜穿兵卫，略似齐城战火牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杜监簿 其三","author":"方岳","text":"赢得萧萧两鬓秋，山城斗大转多忧。\n人间纵有万钱鹤，身外何如十具牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杜监簿 其四","author":"方岳","text":"不须把浅不防秋，底事山樵亦过忧。\n说与诸公那解此，但知两角战蜗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杜监簿 其一","author":"方岳","text":"风雨重阳又一秋，白衣人至复何忧。\n东篱只此黄花是，未必渊明风马牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵牡丹 其二","author":"方岳","text":"娇红深倚翠云团，髣髴三生吴綵鸾。\n诗眼顿惊春富贵，雨侵衫袖不知寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵牡丹 其一","author":"方岳","text":"银壶贮雪褪轻红，费尽思量句不工。\n若使春风但桃李，春风殊未可雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈帐管秋思 其二","author":"方岳","text":"人家一样捲湘帘，惹起新愁到酒边。\n久客不知诗瘦损，小楼孤倚月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈帐管秋思 其一","author":"方岳","text":"秋风吹裂旧荷衣，自读离骚倚落晖。\n已觉芦花洲渚冷，水天归雁著行飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈侍郎谢送牡丹 其二","author":"方岳","text":"手斸苍苔玉一栏，山家初见眼犹寒。\n移根莫厌凡红紫，只做春风一样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈侍郎谢送牡丹 其一","author":"方岳","text":"人在金华殿角头，诗情却遣为花留。\n春风不入癯仙眼，六六峰寒隔几州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑省仓 其二","author":"方岳","text":"归去来兮月一船，世途难似上青天。\n烟蓑自与轻鸥狎，却在风涛阿那边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郑省仓 其一","author":"方岳","text":"买鱼聊复醉?船，万事从来付老天。\n欲办把茅无计可，不量吾力更筹边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚监丞斫鲙 其一","author":"卓田","text":"冰盘飞缕落芳馨，雪色微红糁玉霙。\n唤起笭箵十年梦，诗肠手截鹭波清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚监丞斫鲙 其二","author":"卓田","text":"旋捣金齑捣玉葱，半盂膏酒洗冬烘。\n吴中风物今犹尔，说与厨人宁舍熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵客饟鲈蟹","author":"方岳","text":"江鲈淮蟹不论钱，肯到湖边明月船。\n玉鲙雪螯新煮酒，桂花香后菊花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵佥为赵宰画野水多于地春山半是云盖宰之尊公诗也","author":"方岳","text":"竹屋无人肯见过，寒云自傍钓船多。\n老仙更在云深处，奈此春山野水何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵尉","author":"方岳","text":"世于吾道转崎岖，是与非耶一子虚。\n借得祁山两间屋，一间分与月明居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵尉梅句 其一","author":"方岳","text":"冰雪之晨草木屯，南枝亦有未招魂。\n一愁泥就孤山骨，正恐诗谈太不根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵尉梅句 其二","author":"方岳","text":"疏花不受世间寒，得圣之清自可餐。\n今日湖山人已朽，何如茅屋雪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵端明万花园 其四","author":"方岳","text":"玉箫吹断知何许，柳径日长娇燕舞。\n鹤城半掩人未归，数点春愁杏花雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵端明万花园 其二","author":"方岳","text":"和气能消塞上寒，却于边事颇相干。\n酒旗歌鼓秋千外，新绿柔红又几般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵端明万花园 其三","author":"方岳","text":"风逗湘帘雪絮飞，池痕雨过曲尘肥。\n扬州十里春犹在，细柳营深解铁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵端明万花园 其一","author":"方岳","text":"万花锦绣同民乐，不比青山独乐园。\n办得春风共花醉，尽教蝶闹与蜂喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐宰集珠溪","author":"方岳","text":"瀑煮春风生意长，梅花吹雪入诗香。\n夜寒记得僧房梦，脩竹半窗云一床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵斋宿 其一","author":"方岳","text":"可是诗边欠老干，藓床相对话灯残。\n秋城一夜江湖晚，风雨重阳菊自寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵斋宿 其二","author":"方岳","text":"黄花白发两关情，并入斋房长短更。\n久客自知秋意思，底须蛩雨做寒声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵梁倅","author":"方岳","text":"把住新花做好看，伤春时共倚阑干。\n醉中不记暮烟碧，杨柳楼深燕子寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵梁倅秋日白牡丹","author":"方岳","text":"自掩窗纱护夕阳，碧壶深贮溜晴光。\n可曾见此春风面，净洗铅华试晓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵清脩老墨梅新茗","author":"方岳","text":"此诗合让简斋老，尽洗世间声色尘。\n我更凿空难著语，蹇驴粗记雪桥春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵菖蒲","author":"方岳","text":"瓦盆犹带涧声寒，亦有诗情几砚间。\n抱石小龙鳞甲老，夜窗云气故斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程兄投赠 其一","author":"方岳","text":"北里南邻尽往还，那知有客住云间。\n相过肯作乡人面，问讯春溪两岸山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程兄投赠 其二","author":"方岳","text":"知无燕颔可封侯，索米长安亦强留。\n输与鲈肥菰叶滑，吴中风味老孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其十","author":"方岳","text":"此腹宁须文字香，漫淹齑瓮半青黄。\n午窗一枕齁齁睡，世上何人最得忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其九","author":"方岳","text":"鱼鸟相忘不世情，浮生于我一丝轻。\n夜凉月色光如水，莫遣微云滓太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其一","author":"方岳","text":"一船月自不嫌贫，伴我荒湾理钓缗。\n归去莫横深夜笛，怕惊溪友与山宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其二","author":"方岳","text":"三径风烟手自开，春猿秋鹤几徘徊。\n松根石铫烹鱼眼，老子行山又一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其四","author":"方岳","text":"眼中转觉可人稀，得似孤云自在飞。\n花落花开俱有意，略于閒处见几微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其三","author":"方岳","text":"槿援茅茨隐者家，底须日历记年华。\n山花山草无终极，秋后寂寥春自葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其五","author":"方岳","text":"草堂四壁一瓢空，举世无人与我同。\n黄犊山南又山北，犁春犹有古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程弟 其七","author":"方岳","text":"垒曲成台糟筑丘，衰迟无复少年游。\n君看烟草离离外，不问人间第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]