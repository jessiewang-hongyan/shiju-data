[{"title":"感皇恩 其二 寿","author":"张元干","text":"年少太平时，名园甲第。\n谈笑雍容万钟贵。\n姚黄重绽，长对小春天气。\n绮罗丛里惯，今朝醉。\n台衮象贤，元枢虚位。\n壮岁青云自曾致。\n流霞麟脯，难老洛滨风味。\n谢公须再为，苍生起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其三 寿","author":"张元干","text":"荔子著花繁，清微庭院。\n贺厦双飞画梁燕。\n绮罗丛里，百和炉烟祝愿。\n愿从今日去，身长健。\n檀板竞催，榕阴初转。\n舞袖风前翠翘颤。\n明年开府，锡宴金钟宣劝。\n寿星朝北斗，君王眷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼上曲 其一","author":"张元干","text":"楼外夕阳明远水。\n楼中人倚东风里。\n何事有情怨别离。\n低鬟背立君应知。\n东望云山君去路。\n断肠迢迢尽愁处。\n明朝不忍见云山。\n从今休傍曲阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼上曲 其二","author":"张元干","text":"清夜灯前花报喜。\n心随社燕凉风起。\n云路修成宝月时。\n东楼怅望君先归。\n沆瀣秋香生玉井。\n画檐深转梧桐影。\n看君西去侍明光。\n杯中丹桂一枝芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 自豫章阻风吴城山作","author":"张元干","text":"春水迷天，桃花浪、几番风恶。\n云乍起、远山遮尽，晚风还作。\n绿卷芳洲生杜若。\n数帆带雨烟中落。\n傍向来、沙觜共停桡，伤飘泊。\n寒犹在，衾偏薄。\n肠欲断，愁难著。\n倚篷窗无寐，引杯孤酌。\n寒食清明都过却。\n最怜轻负年时约。\n想小楼、终日望归舟，人如削。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其三 为赵西外寿","author":"张元干","text":"玉叶联芳，天潢分润，寿筵长对熏风。\n间平襟度，濮邸行尊崇。\n忠孝家传大雅，无喜愠、一种宽容。\n芝兰盛，彩衣嬉戏，亲睦冠西宗。\n丝纶，膺重寄，遥防迁美，本镇恩隆。\n应萱堂齐福，诞月仍同。\n花蕊香浓气暖，凝瑞露、满酌金钟。\n龙光近，星飞驿马，宣入嗣王封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二 寿富枢密","author":"张元干","text":"韩国殊勋，洛都西内，名园甲第相连。\n当年绿鬓，独占地行仙。\n文彩风流瑞世，延朱履、丝竹喧阗。\n人皆仰，一门相业，心许子孙贤。\n中兴，方庆会，再逢甲子，重数天元。\n问千龄谁比，五福俱全。\n此去沙堤步稳，调金鼎、七叶貂蝉。\n香檀缓，杯传鹦鹉，新月正娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一 寿","author":"张元干","text":"梁苑春归，章街雪霁，柳梢华萼初萌。\n非烟非雾，新岁乐升平。\n京兆雍容报政，金狨过、九陌尘轻。\n朝回处，青霄路稳，黄色起天庭。\n东风，吹绿鬓，薄罗剪彩，小绾流莺。\n比渭滨甲子，尚父难兄。\n满泛椒觞献寿，斑衣侍、云母分屏。\n明年会，双衣对引，谈笑秉钧衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙 其一 寿","author":"张元干","text":"倚格天峻阁。\n舞庭槐阴转，盆榴红烁。\n香风泛帘幕。\n拥霞裾琼佩，真珠璎珞。\n华阳庆渥。\n诞兰房、流芳秀萼。\n有赤绳系足，从来相门，自然媒妁。\n游戏人间荣贵，道要元微，水源清浊。\n长生大药。\n彩鸾韵，凤箫鹤。\n对木公金母，子孙三世，妇姑为寿满酌。\n看千龄，举家飞升，玉京更乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙 其二 寿","author":"张元干","text":"喜西园放钥。\n对燕寝香润，棠阴寒薄。\n东风夜来恶。\n禁烟时天气，莺啼花落。\n新晴共约。\n怕韶光、容易过却。\n把铜壶、缓浮金杯，禊游行乐。\n弦索。\n笙簧声里，还记兰房，正垂罗幕。\n初眠柳弱。\n梅如豆，玉如琢。\n向凤凰池上，鸳鸯影里，他年何啻紫橐。\n看流芳，继踵韦平，盛传巩洛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹧鸪 其一","author":"张元干","text":"雏莺初啭斗尖新。\n双蕊花娇掌上身。\n总解满斟偏劝客，多生俱是绮罗人。\n回波偷顾轻招拍，方响底敲更合?。\n豆蔻梢头春欲透，情知巫峡待为云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹧鸪 其二 彭德器出示胡邦衡新句次韵","author":"张元干","text":"白衣苍狗变浮云，千古功名一聚尘。\n好是悲歌将进酒，不妨同赋惜馀春。\n风光全似中原日，臭味要须我辈人。\n雨后飞花知底数？\n醉来赢取自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪","author":"张元干","text":"一番小雨，陡觉添秋色。\n桐叶下银床，又送个、凄凉消息。\n故乡何处，搔首对西风，衣线断，带围宽，衰鬓添新白。\n钱塘江上，冠盖如云积。\n骑马傍朱门，谁肯念、尘埃墨客。\n佳人信杳，日暮碧云深，楼独倚，镜频看，此意无人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其三","author":"张元干","text":"菊坡九日登高路。\n往事知何处。\n陵迁谷变总成空。\n回首十年秋思、吹台东。\n西窗一夜萧萧雨。\n梦绕中原去。\n觉来依旧画楼钟。\n不道木犀香撼、海山风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"张元干","text":"开残桃李春方到。\n谁送东风早。\n杖藜幽径踏馀花。\n却对绿阴青子、问年华。\n迢迢云水横清浅。\n不遣愁眉展。\n数竿修竹自横斜。\n犹有小窗朱户、似侬家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其一","author":"张元干","text":"广寒蟾影开云路。\n目断愁来处。\n菊花轻泛玉杯空。\n醉后不知星斗、乱西东。\n今宵入梦阳台雨。\n谁忍先归去。\n酒醒长是五更钟。\n休念旧游吹帽、几秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 其二","author":"张元干","text":"西郊追赏寻芳处。\n闻道冲寒去。\n雨肥红绽向南枝。\n岁晚才开应是、恨春迟。\n天涯乐事王孙贵。\n花底还君醉。\n有人风味胜疏梅。\n醉里折花归去、更传杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"张元干","text":"靓妆艳态，娇波流盼，双靥横涡半笑。\n尊前烛畔粉生光，更低唱、新翻转调。\n花房结子，冰枝清瘦。\n醉倚香浓寒峭。\n雏莺新啭上林声，惊梦断、池塘春草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑶台第一层 其一","author":"张元干","text":"宝历祥开飞练上，青冥万里光。\n石城形胜，秦淮风景，威凤来翔。\n腊馀春色早，兆钓璜、贤佐兴王。\n对熙旦，正格天同德，全魏分疆。\n荧煌。\n五云深处，化钧独运斗魁旁。\n绣裳龙尾，千官师表，万事平章。\n景钟文瑞世，醉尚方、难老金浆。\n庆垂芳。\n看云屏间坐，象笏堆床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑶台第一层 其二","author":"张元干","text":"江左风流钟间气，洲分二水长。\n凤凰台畔，投怀玉燕，照射神光。\n豆花初秀雨，散暑空、洗出秋凉。\n庆生旦，正圆蟾呈瑞、仙桂飘香。\n肝肠。\n掞文摛锦，驾云乘鹤下鹓行。\n紫枢将命，紫微如绋，常近君王。\n旧山同梓里，荷月旦、久已平章。\n九霞觞。\n荐刀圭丹饵，衮绣朝裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其二","author":"张元干","text":"燕去莺来春又到。\n花落花开，几度池塘草。\n歌舞筵中人易老。\n闭门打坐安闲好。\n败意常多如意少。\n著甚来由，入闹寻烦恼。\n千古是非浑忘了。\n有时独自掀髯笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"张元干","text":"窗暗窗明昏又晓。\n百岁光阴，老去难重少。\n四十归来犹赖早。\n浮名浮利都经了。\n时把青铜闲自照。\n华发苍颜，一任傍人笑。\n不会参禅并学道。\n但知心下无烦恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴","author":"李弥逊","text":"翠箔阴阴笼画阁。\n昨夜东风恶。\n香径满春泥，南陌东郊，惆怅妨行乐。\n伤春比似年时觉。\n潘鬓新来薄。\n何处不禁愁，雨滴花腮，和泪胭脂落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 其一","author":"张元干","text":"紫枢泽笏趋龙尾。\n平入钧衡位。\n春殿听宣麻，争喜登庸，何似今番喜。\n昆台宜有神仙裔。\n奕世貂蝉贵。\n玉砌长兰芽，好拥笙歌，长向花前醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其一","author":"张元干","text":"浮家泛宅。\n旧游记霅溪踪迹。\n此生已是天涯隔。\n投老谁知，还作三吴客。\n故人怪我疏髯黑。\n醉来犹似丁年日。\n光阴未肯成虚掷。\n蜀魄声中，著处有春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其三","author":"张元干","text":"一枝冰萼。\n鬓云低度横波约。\n醉扶曾罥乌巾角。\n长是春来，肠断宝钗落。\n罗衣乍怯香风薄。\n夜深花困遮垂幕。\n不堪往事寻思著。\n休问尊前，客恶主人恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其四","author":"张元干","text":"云鸿影落。\n风吹小艇敧沙泊。\n津亭古木浓阴合。\n一枕滩声，客睡何曾著。\n天涯万里情怀恶。\n年华垂暮犹离索。\n佳人想见猜疑错。\n莫数归期，已负当时约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其二","author":"张元干","text":"绿枝红萼。\n江南芳信年年约。\n竹舆路转溪桥角。\n晴日烘香，的皪疏篱落。\n玉台粉面铅华薄。\n画堂长记深罗幕。\n惜花老去情犹著。\n客里惊春，生怕东风恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉蓬莱 寿","author":"张元干","text":"对小春桃艳，曲室炉红，乍寒天气。\n七叶蓂开，应金章通贵。\n梦草银钩，灿花珠唾，是素来风味。\n满腹经纶，回天议论，昆台仙裔。\n秘殿升华，紫枢勋旧，退步真祠，简心端扆。\n迎日天元，听正衙宣制。\n尽洗中原，遍为霖雨，宴后堂歌吹。\n柏子千秋，丹砂九转，今宵长醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"张元干","text":"不怕微霜点玉肌。\n恨无流水照冰姿。\n与君著意从头看，初见东南第一枝。\n人散后，雪晴时。\n陇头春色寄来迟。\n使君本是花前客，莫怪殷勤为赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张阐","text":"玄鲫随钩诚养亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醴泉歌","author":"张元孝","text":"君不见齐城城西范公泉，曾照当年范公影。\n范公一去不复返，异时此地成佳景。\n先贤口泽气尚存，甘棠遗爱谁能并。\n貌公遗像龛公泉，千年恒对佗山岭。\n惟有此山见此公，后乐不废林泉景。\n古来豪杰宦辙经，山川草木皆引领。\n不独照耀翰墨光，抑且品题丹青炳。\n顾予昔忝宗伯省，谐世无术伤骨鲠。\n一年谪官此羁栖，数向寒泉挽修绠。\n冰壶日日漱琼液，涓滴解使心常醒。\n平生颇味海内水，此与金山可并骋。\n膏泽定有鬼神护，清流自与乾坤永。\n忽复飘然当去兹，泉声引韵若为哽。\n坎洼讵测源流深，鸟鹊空噪梧桐冷。\n君不见古人饮水必廉泉，临流洗耳须清颍。\n嗟哉此水可洗心，往来祠下宜深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不如归去","author":"张元道","text":"岷峨路远万重云，锦水繁华一聚尘。\n帝子但知归去好，故家城阙已他人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春深见雁","author":"张元道","text":"杜若生洲荻已芽，随阳片影向天涯。\n如今不用思归去，江北江南是一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋意","author":"张元道","text":"古铎摇风语夜凉，露漙莎径咽寒螀。\n更长展转难成寐，拟问希夷觅睡方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春愁","author":"张元道","text":"烟翠饱青实，雨红黏绿苔。\n杨花随梦去，莺语唤愁来。\n吟事春三月，风光酒一杯。\n芳心久消歇，已作蕙炉灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摇落","author":"张元道","text":"摇落梧桐恨，哀吟络纬愁。\n星河横静夜，天地入新秋。\n冉冉岁云迈，滔滔江自流。\n惊风和雁影，吹梦过南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五","author":"张公庠","text":"玉虚新殿势巑岏，谁见壶中日月闲。\n消尽晓霞无一缕，数声清磬落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十四","author":"张公庠","text":"晓雾溟濛似有无，半残红烛动金铺。\n黄莺不语梨花上，错认徐熙旧画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十","author":"张公庠","text":"百花成锦柳飞绵，才度清明上巳前。\n绣盖徐徐红日永，六宫游幸不鸣鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十八","author":"张公庠","text":"玉堂催下葳蕤锁，除授唯容学士知。\n丞相捧麻宣读了，百僚欣惬拜丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十三","author":"张公庠","text":"三月韶妍赏牡丹，更宜疏雨湿阑干。\n隔帘催唤陪春设，不道新妆粉未乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十五","author":"张公庠","text":"四部韶音进玉卮，千官倾望柘黄衣。\n舞头再拜金阶远，画鼓连催卷队归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十三","author":"张公庠","text":"月华浮动上阶棱，侍宴归来掩绣屏。\n子夜酒醒兰烛暗，碧纱窗外度流萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十一","author":"张公庠","text":"承露双盘插碧空，楼台更在月明中。\n何人传得花奴曲，羯鼓声高满六宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十八","author":"张公庠","text":"影娥池面碧溶溶，荡桨佳人夕照中。\n云髻不饶荷叶绿，罗裙未减石榴红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十二","author":"张公庠","text":"御苑名花约万栽，芳心俱愿日华来。\n春风已暖梅先绽，长恨江南冒雪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十四","author":"张公庠","text":"再坐千官花满头，御香烟上紫云楼。\n万人同向青霄望，鼓笛声中度彩毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十五","author":"张公庠","text":"禁掖人闲小小风，弹棋围坐柳阴中。\n正怜美酒杯中绿，又叹飞花席上红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十九","author":"张公庠","text":"后苑宸游炎日长，宫中彊半坐回廊。\n鵁鶄鸂鶒银塘静，杨柳梧桐水殿香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十五","author":"张公庠","text":"治道精深日讲求，唐虞功德本优游。\n欲知兆姓千官意，万岁常瞻十二旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十","author":"张公庠","text":"清晓传宣赐御题，日华初动露华晞。\n集英殿上天香散，飞入千人白纻衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十七","author":"张公庠","text":"尽道今来花信迟，凌晨宫女探春归。\n寒梅一朵金槃小，已有清香拂御衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十八","author":"张公庠","text":"池北池南柳对黄，翠华游幸昼初长。\n宫娥从驾知多少，十里朱轮半日香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十九","author":"张公庠","text":"御柳丝长挂玉栏，不须惆怅百花残。\n还知三月春虽晚，好从金舆看牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十五","author":"张公庠","text":"掖庭初选即知名，新学吹箫数曲成。\n天上仙姝元不识，人间安得咏倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十七","author":"张公庠","text":"东君回驭已春残，红日长时人意闲。\n玉鼻琵琶声正急，更怜莺语亦绵蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十二","author":"张公庠","text":"万字阑干菊半开，更怜清露点莓苔。\n仙韶使副呈新谱，得旨重阳侍宴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十五","author":"张公庠","text":"交直归来绣幕开，红炉互劝辟寒杯。\n谁知飞雪轻狂意，倒学佳人舞袖回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十五","author":"张公庠","text":"太皞祠坛数级红，青旂摇曳日朦胧。\n人间未觉东风至，先入宜春小院中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十九","author":"张公庠","text":"碧瓦鸳鸯势欲飞，禁门深静日迟迟。\n玉箫吹遍新传谱，坐看黄鹂数换枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十四","author":"张公庠","text":"自古诗人咏具瞻，官仪丞相独尊严。\n三衙扣杖一声喏，只是朱衣略揭帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词","author":"张公庠","text":"牡丹尊贵出群芳，销得宸游奉玉觞。\n侍宴佳人相与语，姚黄争及御袍黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十四","author":"张公庠","text":"雪罢严寒殆不禁，紫宸朝退禁门深。\n君恩委曲人知否，数盏香醪抵百金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十六","author":"张公庠","text":"夹城西畔小毬场，彩仗弯弯人对行。\n一样骅骝三百疋，金羁更伴绿游缰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]