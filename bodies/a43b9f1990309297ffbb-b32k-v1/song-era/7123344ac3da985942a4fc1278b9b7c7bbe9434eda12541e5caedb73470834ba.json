[{"title":"鹧鸪天 其三","author":"石孝友","text":"别后应怜信息疏。\n西风几度到庭梧。\n夜来纵有鸳鸯梦，春去空馀蛱蝶图。\n烟树远，塞鸿孤。\n垂垂天影带平芜。\n凭谁写此相思曲，寄与冯川郑小奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"石孝友","text":"家在东湖湖上头。\n别来风月为谁留。\n落霞孤鹜齐飞处，南浦西山相对愁。\n真了了，好休休。\n莫教辜负菊花秋。\n浮云富贵何须羡，画饼声名肯浪求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其五","author":"石孝友","text":"花漏声乾月隐墙。\n琯灰迎晓透新阳。\n物情渐逐云容好，欢意偏随日脚长。\n山作鼎，玉为浆。\n寿杯丛处艳梅妆。\n醉乡路接华胥国，应梦朝天侍赭黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 冬至上李漕","author":"石孝友","text":"万里羁孤困一箪。\n平头四十误儒冠。\n舜弦广播薰风暖，邹律潜消黍谷寒。\n楼谩倚，剑休弹。\n看君行复上金銮。\n凤池波里求馀润，蚖肆泥中岂久蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 旅中中秋","author":"石孝友","text":"露叶披残露颗传。\n明星著地月流天。\n不辞独赏穷今夜，应为相逢忆去年。\n辜窈窕，负蝉娟。\n谁知两处照孤眠。\n姮娥不怕离人怨，有甚心情独自圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其六","author":"石孝友","text":"玉烛调元黍律匀。\n迎长嘉节属芳辰。\n云如惜雨钩牵雪，梅不禁风漏泄春。\n天意好，物华新。\n偷闲赢取酒边身。\n太平朝野都无事，且与莺花作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其九","author":"石孝友","text":"屏幛重重翠幕遮。\n兰膏烟暖篆香斜。\n相思树上双栖翼，连理枝头并蒂花。\n敧凤髻，亸乌纱。\n云慵雨困兴无涯。\n个中赢取平生事，兔走乌飞一任他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水帘洞","author":"石应孙","text":"珠帘巧费水晶裁，万古垂垂浅碧苔。\n几度月钩钩不上，孤云能入此中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花洞","author":"石应孙","text":"桃花五色四时开，片片香随涧水来。\n况是轩辕曾手植，紫烟深处有楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题南山","author":"石应孙","text":"孤鹜去边天浩渺，万家穷处水湾环。\n岭外此州为道院，风烟殊弗类南蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石花洞","author":"石应孙","text":"我试问阳和，洞间谁是主。\n尽日立东风，百花无一语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游黄山","author":"石应孙","text":"山川形胜雄江东，九华辉映天都峰。\n传闻早已荡胸臆，恨不插翼长相从。\n朅来随牒官秋浦，城郭奔驰厌尘土。\n絜家捧檄过临城，偷閒两作烟霞主。\n黄山登览原无由，何期易地太平游。\n清池轩豁日舒丽，突兀楼观撑深幽。\n凭高徙倚敞心目，绝壁半天横碧玉。\n回溪千里指顾间，螺髻分明三十六。\n壮怀高向紫霄悬，俯视培塿真一拳。\n古今秀色餐不尽，笔端收拾生云烟。\n萍踪倘未逐流水，古刹相望二三里。\n暇时风月得交游，鸥鹭同眠勿惊起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武夷","author":"石建见","text":"拂散征尘曳素袍，小鞍乘兴过林皋。\n溪山九曲云烟合，宫阙万年星斗高。\n天柱插空留鹤驾，仙船横石待鲸涛。\n玉笙吹彻金鸡叫，落尽岩前几树桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集峰名","author":"石建见","text":"大王高住碧云间，玉女风鬟相对看。\n画鹤有年游瀚海，钓鱼何日起波澜。\n工添一线仙机就，酒尽三杯茶灶乾。\n醉听鼓楼声已远，幔亭环佩响珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹娥江","author":"石林","text":"一点冥通未兆前，乾坤虚鉴已昭然。\n烂银宫里擎尸出，万古传声浪拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙岩山","author":"石泳坚","text":"茫茫天地老洪崖，太朴何年此凿开。\n一派灵源流不尽，教人疑是九天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"石牧之","text":"越绝江东第一州，邦人相庆得贤侯。\n已知和气先春到，伫听欢谣混海流。\n去醉湖山无贺老，坐吟风月揖浮丘。\n此行定奉丁宁诏，更老归来侍冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石梁寺","author":"石郊","text":"行破白云山几重，僧床投宿幸相容。\n泉声到枕夜无寐，时听隔林方广钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"石姥寄客","text":"水暖眠秧珥，风香竖茗旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"石屋","text":"八峰春到了，双涧雨晴初。\n小室钩帘坐，人间无画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"石待问","text":"平生无女只生儿，三子登科一子随。\n家在白云青嶂里，不求闲散待何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游黄山","author":"石待问","text":"轩皇曾把浮丘袂，驻跸兹山遂得名。\n迤逦乍登随步胜，巍峨一上觉身轻。\n烟云日变百千态，猿鹤时闻三两声。\n截断杳冥秋势隔，数州各自见阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"石待问","text":"何常为柱石，同立太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢梵才惠茶","author":"石待举","text":"郡园名荈制犹新，分惠眠云跂石人。\n色斗琼瑶因地胜，香殊兰茝得天真。\n开时好对棱棱月，碾处应飞瑟瑟尘。\n寄语高僧宜郑重，能诗方遣雨前春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季子庙","author":"石祖文","text":"夫子南游不到吴，殷勤题识寄嗟吁。\n干戈扰扰怜诸夏，季子流风过耳无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君山","author":"石祖文","text":"远迩朝宗势拱辰，名高岂特为春申。\n孤峰堆阜无多地，一水仙凡隔几尘。\n簪履三千谁念楚，山河百二漫誇秦。\n云烟胜概无今古，俯仰休悲迹已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝宗门","author":"石祖文","text":"楼阁峥嵘古垒门，日随潮汐谨晨昏。\n奠川禹绩勤沟洫，学海雄词识本源。\n演迤众流唯北拱，委蛇万折肯西奔。\n时人有问朝宗义，落笔诗成不待言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"石耆翁","text":"半夜六龙飞海峤。\n滉漾鳌波，露出珊瑚小。\n玉粉枝头春意早。\n东风未绿瀛洲草。\n姑射仙人真窈窕。\n净练明妆，如伴商岩老。\n梦入水云闲缥缈。\n一楼明月千山晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"石耆翁","text":"借问枝头昨夜春。\n已传消息到柴门。\n频看秀色无多艳，拖得清香不见痕。\n山矗矗，水粼粼。\n村南村北冷销魂。\n人间不识春风面，羞见瑶台破月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天津桥","author":"翁逢龙","text":"下马过天津，听传禁漏频。\n惟怜一桥月，曾照六朝人。\n金剥宫门字，红飞粉壁尘。\n中官来宿内，因问帝乡亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过齐山人居","author":"翁逢龙","text":"自说住居年，山灵夙有缘。\n看经医病鹤，祭土凿新泉。\n食相过饥岁，眠蓑度雪天。\n所言非释老，难与世人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官满借居","author":"翁逢龙","text":"尽装家具已回京，便觉身如片叶轻。\n近市借居人语杂，闭门独处自心清。\n雨中蹑屣青苔滑，烛下梳头白发明。\n余亦傍人檐底住，新来巢燕不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东掖四绝句 其一 入天台","author":"石象之","text":"溪岑萦绕红尘外，殿阁攲危翠霭间。\n我见老僧无一事，老僧更羡白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东掖四绝句 其二 不见如师","author":"石象之","text":"洗除尘垢访名蓝，不得相逢益自惭。\n松桂阴森香火冷，乱云空锁白莲庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东掖四绝句 其四 白莲庵","author":"石象之","text":"结社当年号白莲，师心应欲继前贤。\n有时中夜初回定，清磬一声秋月圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东掖四绝句 其三 隔尘亭","author":"石象之","text":"山椒亭榭适徘徊，病膜烦襟斗顿开。\n若有尘埃何处隔，此中自是少尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏愁","author":"石象之","text":"来何容易去何迟，半在心头半在眉。\n门掩落花春去后，窗窥残月酒醒时。\n柔如万顷连天草，乱比千寻匝地丝。\n除却五侯歌舞地，人间何处不相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水濂洞","author":"石?","text":"洞门千尺挂飞流，碎玉联珠冷喷湫。\n万古无人能手捲，紫萝为带月为钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游北山","author":"石?","text":"春色著人如酒浓，我来却值雨濛濛。\n千岩磊落风尘表，万井参差罨画中。\n游子三三仍五五，落花白白更红红。\n须知满目皆真理，面壁何劳学苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章安祥符寺御坐","author":"石?","text":"章安古县治，湫隘仍嚣尘。\n何为金玉舆，下游江海滨。\n奸臣肆欺诞，明主怀忧勤。\n祸乱防未然，斯言可书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"石敦夫","text":"窥檐蟾影白，照坐烛花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎赵清献公游雁荡","author":"石景立","text":"雁荡天台路险艰，多应特地隔尘寰。\n不辞登陟来千里，为是东南第一山。\n争望台星从海上，方知蓬岛在人间。\n武林二老图中见，重惜官师远莫攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"任仙公台","author":"石赓","text":"衰年脚手倦跻攀，今日凭高一解颜。\n驱得江山来目下，化将楼殿出云间。\n真人炼药仙都近，释子焚香佛界闲。\n尘事数来宁易得，后歌须尽夕阳还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岳阳楼观洞庭","author":"石赓","text":"洞庭白波如雪山，九月颠风初作寒。\n乾坤荡沃漫无际，岳阳楼中方好看。\n居人习惯占天色，短艇高樯绝行迹。\n一点君山乍有无，鱼龙作坏三闾宅。\n楼上观湖壮思生，巴陵酒熟香出瓶。\n倾壶快饮为君尽，醉杀谪仙诗始成。\n二年持节临荆部，扁舟此地常来去。\n今日凭高觉胆惊，归欤莫与风涛遇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"石道士","text":"敲开败箨露新竹，拾上落花妆旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"石道士","text":"春来不是人慵扫，为惜苍苔衬落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"石羲叟","text":"云房春锁赤城边，荣著兰芽谢胜缘。\n銮殿暂来趋玉陛，石桥重去埽金田。\n窗喷瀑布千岩雪，炉爇栴檀一炷烟。\n此处深居更谁见，腊高松偃旧峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 寿","author":"石麟","text":"九叶仙茅秀，旬浃一阳生。\n中山瑞气和暖，融作玉壶春。\n昨夜洪临跨鹤，翌早绿华骖凤，今日岳生申。\n须信神仙侣，引从降蓬瀛。\n文中虎，寿中鹤，酒中鲸。\n一门盛事相继，桥梓奋鹏程。\n应羡华堂燕处，许大规摹涵养，大器晚方成。\n醒后宫花句，伫看赋琼林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 寿致政叔，时又得孙","author":"石麟","text":"日暖唐宫绣，云绚鲁台观。\n九叶仙茅方茂，瑞气霭中山。\n逸老堂前戏彩，新抱玄孙弥月，红字写眉间。\n八十庆公寿，添撇更成千。\n寿中星，人中杰，酒中仙。\n功名富贵，事业分付子孙贤。\n赢得濠梁真乐，剩有陶园佳趣，杖屦日安闲。\n第恐非熊兆，好事逼新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金缕词/贺新郎 寿南楼","author":"石麟","text":"欲上南楼寿。\n记当年、祥占玉燕。\n一阳生候。\n今数书云犹七日，宫线未添刺绣。\n便草就、寿词盈袖。\n合捧金荷称鹤算，想华堂、剩醉眉春酒。\n惭斐句，为觞侑。\n功名八稚年方少。\n自归来、陶庐蒋径，菊松为友。\n轩筑易安栽花药，不坠家声五柳。\n况满砌、芝兰争秀。\n岁岁斑斓衣戏处，老人星、一点辉南斗。\n顾对此，共长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 寿处州刘守","author":"石麟","text":"一骑飞来速。\n报平山、将颁凤检，宠分符竹。\n自是平淮勋名在，姓字屏风纪录。\n正欲革、潢池风俗。\n古括久思贤太守，待东山、一起苍生福。\n唐李段，追芳躅。\n横舟竹下凭青鹿。\n庆生朝、称觞蔼蔼，履珠簪玉。\n争奈回溪民望切，计日带牛佩犊。\n便合早、秣驺脂毂。\n圣眷处公犹未惬，俟朱幡、才下锋车趣。\n符已兆，台星六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 寿逸老堂主人，年八十二","author":"石麟","text":"欲寿中山不老仙。\n寿词更拟办千篇。\n九蓂日秀尧阶地，五色云祥鲁观天。\n吟逸老，醉逃禅。\n香传丹桂子孙贤。\n莫言大器韬藏久，犹是梁魁擢第年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"石麟之","text":"鹿轓龙节上恩华，衣绣先归士论嘉。\n琐闼暂虚元老席，蓬莱还属侍臣家。\n旌旗天上浮文鹢，鼓角江头拥将牙。\n东越又新南越治，到时歌咏已諠哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登立鱼山","author":"艾丑","text":"杳杳灵岩洞府深，有人岩下振潮音。\n龙天耸听生欢喜，留得神鱼立到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋风雨","author":"艾可叔","text":"一年佳节又虚逢，恼杀江湖白发翁。\n滴梦欲残蕉叶雨，吹愁不断蓼花风。\n阴晴明晦天无准，离合悲欢态不同。\n聊买香醪作清赏，烛光閒对木犀红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木棉","author":"艾可叔","text":"收来老茧倍三春，匹似真棉白一分。\n车转轻雷秋纺雪，弓弯半月夜弹云。\n衣裘卒岁吟翁暖，机杼终年织妇勤。\n闻得上方存节俭，区区欲献野人芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东上拜罗首墓","author":"艾可叔","text":"驿道百年墓，征衣四世孙。\n冲风行木叶，藉雪拜松根。\n老觉貂裘敝，贫惟铁砚存。\n倘徼先世福，犹足醉丘原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月晦日西归舟中作","author":"艾可叔","text":"宦情一片莫云浮，归兴双溪春水流。\n惜别长官携酒盏，送行诗友候津头。\n人方挟弹窥黄雀，我不知机愧白鸥。\n数夕打篷风更雨，并无明月载空舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵绣使题金鳌稳处","author":"艾可叔","text":"突兀霜崖俯雪洲，时时登览唤渔舟。\n溪分南北地初合，月在山间天共流。\n三两可人曾此会，百千年后复谁游。\n桑田不变金鳌健，祇恐吟翁白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南归附后不仕述怀","author":"艾可叔","text":"舟在中流进退难，发虽种种此心丹。\n死为元亮终书晋，生是留侯本事韩。\n贫贱不忧知有道，乱离最幸是无官。\n岁寒谁似东篱菊，禁得投簪日日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"穷达","author":"艾可叔","text":"穷达宁无分，逢迎费折腰。\n人情剡溪纸，世事浙江潮。\n冻井和冰汲，寒山带雪樵。\n子云虽寂寞，庄叟得逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵晚眺","author":"艾可叔","text":"星移物换千年事，虎踞龙蟠万雉城。\n归巷乌衣秋缥缈，点州白鹭雪分明。\n江分南北天为限，淮接东西地最平。\n目断青峰是何处，单于吹角莫云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江褒忠庙题","author":"艾可叔","text":"忆昔狼烽谍报忙，空拳支敌出仓惶。\n齿寒谁解婴城守，舌在公还骂贼亡。\n秦伯早能怜楚使，张君未必死睢阳。\n西风吹起英雄恨，断础凄烟泪两行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮梁金鳌山","author":"艾可叔","text":"鳌骨分明露浅洲，登临几度泛虚舟。\n人生天地蜉蝣寄，世事江河日夜流。\n前后朗吟坡老赋，逍遥终羡漆园游。\n子真谷口今成趣，不为红尘枉白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋归自京","author":"艾可叔","text":"红尘两脚几时休，此度真成浪漫游。\n倦买夜船过钓濑，渴呼腊盏试龙游。\n菊前疏雨重阳信，天际孤云万里愁。\n昨夜江头乡国梦，已随明月度西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡鉴潭望郑宜之白雪别墅","author":"艾可叔","text":"小驱满砄是尘埃，逢好江山眼为开。\n贺老生涯鉴湖曲，希夷别墅白云堆。\n欲寻溪叟挐舟去，却被山灵勒驾回。\n忆共吟边曾有约，夜深应晤抱琴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]