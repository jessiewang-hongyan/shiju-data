[{"title":"宜人史氏挽词","author":"楼钥","text":"阀阅冠三朝，尊公两珥貂。\n夫贤能尽礼，家贵肯期骄。\n教子门风振，澄神性地超。\n悼亡无可憾，直笔付孙樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宜人杨氏挽词 其二","author":"楼钥","text":"梦入枌榆社，心游水竹湾。\n丐归期拜寿，近侍望承颜。\n一昨闻微恙，宁知竟大还。\n佳城无路到，夫妇泪俱潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宜人闻人氏挽词","author":"楼钥","text":"四郡歌贤牧，鱼轩从隼旟。\n深闺无里谒，色养谨安舆。\n故里称家法，诸郎读父书。\n美哉彤史笔，三诵为欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书尤公挽词 其三","author":"楼钥","text":"旧学方登用，公来领从臣。\n末光依日月，听履上星辰。\n共政将图旧，腾章屡乞身。\n甘盘终罔显，雨露未沾新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书尤公挽词 其一","author":"楼钥","text":"敏甚五行下，豪釐耻不知。\n千人挥笔阵，万卷纳须弥。\n有夏传追蠡，先秦拾断碑。\n邺侯书插架，分付称家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书尤公挽词 其四","author":"楼钥","text":"北面愿师承，东台拜老成。\n忘年容末至，叙契若平生。\n风月吟千首，雷霆寄一名。\n送车无路到，寒涕为君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书汤公挽词 其一","author":"楼钥","text":"先正真良弼，彤墀四拜麻。\n决科承奕世，摛藻擅传家。\n禁路优持橐，侯藩几建牙。\n相门宜出相，恨不见堤沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书汤公挽词 其二","author":"楼钥","text":"奏邸崇先契，周旋古括州。\n殿庭观唱第，海郡继承流。\n方快飞腾上，俄闻汗漫游。\n凤凰山下路，丹旆想悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书张公挽词 其一","author":"楼钥","text":"文靖饶风度，高皇记曲江。\n贤孙真是似，才气号无双。\n几见持英簜，终看拥碧幢。\n诚斋主诗社，到此亦心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尚书张公挽词 其二","author":"楼钥","text":"抚字推循吏，论思领从班。\n宏才名北阙，高兴属东山。\n同岁叨崇笃，比邻足往还。\n旧游成昨梦，衰涕不胜潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放鹤送潘恭叔司理","author":"楼钥","text":"冲霄六翮困蓬蒿，清唳时时发九皋。\n鹄立固应能独出，鸡群未免叹徒劳。\n相从顾我怜冰玉，欲去知君刷羽毛。\n幸脱樊笼随所适，平平飞去不须高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正惠公挽词 其四","author":"楼钥","text":"百辟素归重，三朝俱受知。\n风棱振台省，名字落戎夷。\n召节叨同命，几廷踵旧规。\n隧铭书不尽，归泣岘山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正惠公挽词 其三","author":"楼钥","text":"凛凛古循吏，堂堂真巨公。\n死生忘度外，邪正烱胸中。\n忧世心诚切，筹边事已空。\n龟潭山下水，流庆与无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正惠公挽词 其二","author":"楼钥","text":"去国名逾重，还朝道益尊。\n清虚怀骨鲠，严冷带春温。\n公绰真无欲，臧孙尚立言。\n骑箕虽永隔，精爽俨如存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林正惠公挽词 其一","author":"楼钥","text":"爱直赵清献，忠文范景仁。\n累朝推旧德，今日见斯人。\n正色欲劘上，敢言宁顾身。\n紫枢方大用，惜不究经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枢密谢公 其一","author":"楼钥","text":"臣主一意合，风云平地生。\n立朝专论谏，为国总枢衡。\n行矣登三事，悲哉奠两楹。\n辍瓜恩意重，终始备哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枢密新府 其一","author":"楼钥","text":"平生苦欲住山间，每恨家居不傍山。\n游倦忽来参宥密，公馀却得对孱颜。\n援琴万壑自同响，缓步一丘犹可攀。\n信美终非吾久处，乞身惟待老乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枢密新府 其二","author":"楼钥","text":"门号签书府，心存攻愧斋。\n倚栏临曲沼，扶杖看悬崖。\n槁叶鸣轻雨，残山拥半阶。\n退公成吏隐，足以畅幽怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泗州道中","author":"楼钥","text":"宿雪助寒色，相看汴水滨。\n轻车兀残梦，群马溅飞尘。\n行役过周地，官仪泣汉民。\n中原陆沈久，任责岂无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"环村踏雪 其二","author":"楼钥","text":"笋舆冲雪过溪桥，流水方东未晚潮。\n白里不知梅夺色，青边尤喜麦成苗。\n烟深带雨参差下，空阔随风自在飘。\n可是忍寒诗更切，故求野路踏琼瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"环村踏雪 其一","author":"楼钥","text":"一冬求雪雨还晴，剩喜春朝见玉霙。\n不为偶同佳客到，谁能深入乱山行。\n云窗雾阁知何限，玉树琼枝到处明。\n更唤轻舟同稳泛，小溪何似剡溪清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"织锦棋盘","author":"楼钥","text":"锦城巧女费心机，织就一枰如许齐。\n彷佛回文仍具体，纵横方罫若分畦。\n烂柯未易供仙弈，画纸何须倩老妻。\n如欲拈棋轻且称，当求白象与乌犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范叔刚舍人示文正公象笏","author":"楼钥","text":"千载威名文正公，忽瞻遗笏照双瞳。\n敢从象齿窥清裁，屡批龙鳞奋大忠。\n秉立定知端若植，至今犹想气如虹。\n舍人接武登廊庙，宜宝甘棠振祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范致政挽词 其一","author":"楼钥","text":"义侠久无迹，吾乡见此翁。\n紫微欣税驾，飞将许同功。\n银茜联恩渥，金兰蔼义风。\n虽增嬴博恨，犹喜桂成丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范致政挽词 其二","author":"楼钥","text":"酒后升平曲，闲中安乐窝。\n千金曾累致，一醉竟无何。\n老骥志空在，孤鸾悲亦多。\n相望才岁许，托体共山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅夫人挽词","author":"楼钥","text":"清心玉映许谁同，更有飘飘林下风。\n政尔高情协宗老，故宜嘉遁乐庞公。\n远谋蚤识身为重，晚境还知性亦空。\n已拟张林碑妇德，合归彤史巨编中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘","author":"楼钥","text":"望望古招提，兹游恨已迟。\n池深惊地裂，野旷觉天垂。\n听法人千数，谈空松一枝。\n从谁访遗迹，惟有石头知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎冢","author":"楼钥","text":"辛勤玉柙更珠襦，或见叉牙出骨须。\n鸷兽一心能护法，敝帷千载尚全躯。\n馀威凛凛空埋骨，遗像眈眈若负嵎。\n及见当年梅子熟，自应惊倒老妖狐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表兄陈安行迁右司仲兄迁大理丞余迁太府丞寄诗为贺次韵 其一","author":"楼钥","text":"东塾谈经岁月轻，外家生长复何营。\n王生此舅若无有，杨恽一书安得成。\n首寄新诗钦厚意，却思往事念平生。\n当时更荷外祖母，幼惠尤怜盛氏甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表兄陈安行迁右司仲兄迁大理丞余迁太府丞寄诗为贺次韵 其二","author":"楼钥","text":"为亲敢说宦情轻，公退委蛇懒自营。\n朝路一时偕寸进，适斋新句已先成。\n圉师况复今同里，武子非惟爱外生。\n旧日阿重今欲冠，此恩更欲到弥甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑司法挽词 其一","author":"楼钥","text":"襟袍空无碍，精神老不衰。\n家传司业学，句逼简斋诗。\n荒瘠留阴德，平反有去思。\n功名赍志没，回施称家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑司法挽词 其二","author":"楼钥","text":"倾盖欢如故，相从沧海隅。\n方将理诗社，忽已閟泉途。\n归路孤飞旐，交情一束刍。\n梅霖将客泪，凄澹洒平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑华文挽词 其三","author":"楼钥","text":"兄弟忝同登，论交最有情。\n颓波知劲节，彻底叹真清。\n正尔寻姻好，胡然丧老成。\n抱痾难执绋，挥涕望佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑华文挽词 其二","author":"楼钥","text":"籍甚柯山政，儿童识贵温。\n欢谣闻魏阙，殊宠镇吴门。\n就养家传子，休官泽及孙。\n吾乡耆旧传，千载德弥尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑华文挽词 其一","author":"楼钥","text":"蚤擅春秋学，贤关第一流。\n少公清泽国，赞府著神州。\n试邑人交荐，还朝誉更优。\n如何急流退，不使上瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顷游龙井得一联王伯齐同儿辈游因足成之","author":"楼钥","text":"路入风篁上翠微，老龙蟠井四山围。\n水真绿净不可唾，鱼若空行无所依。\n胜处虽多终莫及，旧游谁在事皆非。\n祇今匏系何由到，徒羡联镳带月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞通判挽词 其二","author":"楼钥","text":"象邑推三俊，灵光赖此贤。\n老成俄已矣，远迩为潸然。\n孝敬心何极，公平录尚传。\n佳城隔风浪，忍赋薤歌篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俞通判挽词 其一","author":"楼钥","text":"强仕赋归去，频年亦漫行。\n宦情虽淡泊，官事极精明。\n赞画王公幕，监州亚父城。\n佳儿守遗训，清白胜金籯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信国夫人秦氏挽词","author":"楼钥","text":"夫人富贵出怀绷，择配和鸣得仲卿。\n鸾诰蚤能封大国，鱼轩不及伴双旌。\n肥家得法晚无倦，教子登科新有声。\n难息南溪未成屋，凤凰山下启佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山广莫轩","author":"楼钥","text":"广莫乘风隘九州，乱山无数点平畴。\n一千里外在吾目，三十年来无此游。\n地下天高俱历历，鸢飞鱼跃两悠悠。\n昌黎费尽南山句，旷望还能似此不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南江酒家","author":"楼钥","text":"南江舟楫饱经行，桥外人家最可人。\n剩种寒杉映修竹，快沽村酒趁鲜鳞。\n潮痕落草橹声动，日脚衔山凉意新。\n酷爱老樟横卧处，他时来此坐垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姚江高风阁","author":"楼钥","text":"不从文叔作三公，归著羊裘大泽中。\n石濑钓台非故地，云山江水自高风。\n烟迷宿草古遗恨，树拥危楼新奏功。\n仙驭飘飖疑不远，翩然独鹤度寒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜总管挽词 其二","author":"楼钥","text":"富盛俄遭变，艰难却起家。\n田园新活计，诗礼旧生涯。\n仙桂应传秀，庭兰更茁芽。\n真归了无恨，超彻妙莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜总管挽词 其一","author":"楼钥","text":"及见开元盛，曾闻正始音。\n雕虫徒壮岁，冠鹖岂初心。\n论事风生席，疏恩带锡金。\n精神空满腹，愁绝病沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜钟离挽词 其一","author":"楼钥","text":"门户期兴起，交朋务琢磨。\n反身求大学，决意取儒科。\n赞府声尤著，邻封惠亦多。\n伤心濠上路，无复听弦歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜钟离挽词 其二","author":"楼钥","text":"别去期三载，伻来痛一书。\n死生诚大矣，力量果何如。\n平日真知我，遗言苦问予。\n作铭虽不愧，回首倍欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜秘监挽词 其二","author":"楼钥","text":"久闻政绩最淮淝，鄮岭循良亲见之。\n梓里尚遗前日爱，棠阴还长旧年枝。\n钓璜方兆非熊卜，曳杖俄兴梁木悲。\n千里佳城空望断，他时归哭岘山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姜秘监挽词 其一","author":"楼钥","text":"文笔无劳巧剪裁，一时妙斲冠兰台。\n王杨仕宦曾相接，游夏渊源有自来。\n治狱心知有阴德，立朝人叹有馀才。\n功名回施与孙子，公亦何为不豫哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"娄忠简公挽词 其三","author":"楼钥","text":"共政三年久，蜚英四海尊。\n色词无假借，风裁靡嚣喧。\n但欲持公道，宁容启幸门。\n经纶终未究，犹有典刑存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"娄忠简公挽词 其二","author":"楼钥","text":"边事衅初开，惟公论不回。\n深谋比娄敬，极力阻王恢。\n儿戏何堪用，冰山忽已摧。\n朝廷始更化，大老盍归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"娄忠简公挽词 其四","author":"楼钥","text":"寮寀侍储闱，如公久任稀。\n载欣商皓起，终惜汉疏归。\n问字烦参订，谈经赖发挥。\n一书真总要，星日重光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"娄忠简公挽词 其五","author":"楼钥","text":"得姓共东楼，同朝两故侯。\n文编叨二序，诞日颂千秋。\n老矣俱宜去，公乎不少留。\n来书墨犹湿，展读泪空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"娄忠简公挽词 其一","author":"楼钥","text":"壮岁志先定，耆年气不衰。\n治高为县日，名重佐州时。\n雅望登朝著，忠言彻帝墀。\n亨途日千里，阔步不容迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客目中次韵 其一","author":"楼钥","text":"三年此月绮筵开，盛意勤拳不待催。\n预约行人须已集，先欣数客肯俱来。\n诗筒才到先赓韵，酒兴方浓莫算杯。\n更欲秋深穷胜践，邹枚后乘可容陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客目中次韵 其二","author":"楼钥","text":"花若开时定自开，芳心深靓不容催。\n主人又有新诗出，佳客应寻旧雨来。\n楼上已闻香扑鼻，堂前尽放酒盈杯。\n高烧银烛照花睡，更到更深亦愿陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游遇雨","author":"楼钥","text":"公子喜青春，欢游弗厌频。\n久晴都不问，好雨却成嗔。\n桃杏红方入，禾苗绿未匀。\n请君停杖履，俯念耦耕人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"相州道中","author":"楼钥","text":"千古兴亡一梦惊，就中物理似持衡。\n茜花空染朝歌血，荒草犹祠羑里城。\n但见反身知自咎，谁言修政欲相倾。\n知音只有昌黎操，臣罪当诛主圣明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祝通判挽词 其二","author":"楼钥","text":"花县弦歌化，莲城水竹居。\n旧寮情义厚，近别信音疏。\n不作三刀梦，空垂别驾车。\n新阡何处是，东望倍欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日怀国仲观","author":"楼钥","text":"四明耸秀一溪流，曾记经行十里秋。\n行李今从何处住，宦游自笑几时休。\n儿时故旧今谁在，老去光阴不借留。\n赢得东归访丘壑，约君同上钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋意次林致甫宗丞韵","author":"楼钥","text":"河汉秋来净，飞星一点过。\n好风吹暑尽，疏雨送凉多。\n纨扇收团月，桃笙捲细波。\n自知恩到骨，攲枕梦无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡监岳挽词","author":"楼钥","text":"赋就八叉手，文高三折肱。\n青衫双鬓雪，黄卷短檠灯。\n梦断采芹水，神凄下马陵。\n诸郎追五桂，洗眼看飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺雪八盘岭上作","author":"楼钥","text":"平时卧雪似袁安，谁肯凌晨犯苦寒。\n百辟班中因族贺，八盘岭上得遥看。\n层层观阙琼楼耸，纳纳乾坤玉宇宽。\n怅望仙山何处是，欲从此地径骖鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵司户挽词","author":"楼钥","text":"奕奕佳公子，词场早策勋。\n愿为新进士，终屈病参军。\n旧事成清梦，高标想断云。\n伤心桑落酒，无复到孤坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵左司挽词 其二","author":"楼钥","text":"淮甸争钱币，夔城辩戍兵。\n诏归南郡近，公去北门轻。\n避宠若将浼，求闲竟不成。\n亦齐无适莫，一笑老于行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵左司挽词 其一","author":"楼钥","text":"行谊高馀子，文章自一家。\n岳神均客礼，敌国叹才华。\n直节曾无苦，全瑜更不瑕。\n儒流有遗恨，不见草黄麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵左司挽词 其三","author":"楼钥","text":"许国终无挠，居家不愿馀。\n深蒙明主眷，未觉故人疏。\n高论三千牍，阴功四一书。\n佳儿承积庆，端可大门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵左司挽词 其四","author":"楼钥","text":"乡贡蚤驰誉，郎潜方比肩。\n求仙容我学，成佛叹君先。\n天癸年将暮，金丹语未圆。\n忽传长别偈，天阔散云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵安国梅坡","author":"楼钥","text":"隆暑倦行役，梅坡得暂閒。\n卷帘南浦岸，终日对成山。\n竹里清风远，棋边夕照还。\n岁寒重卜醉，觅句暗香间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":25278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]