[{"title":"次酬胡编校","author":"刘黻","text":"癯然同旦过，一饭鼓鱼音。\n对俗情全懒，忘言道亦深。\n斜阳浮野马，明月照栖禽。\n谁续梅花赋，相期铁石心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬胡编校赋竹屋 其二","author":"刘黻","text":"紫气曾临屋有光，老僧相对说修藏。\n貌癯渐觉衣冠古，交淡谁知道谊常。\n文类锦机君独艳，才如袜线我无长。\n近来悟得安心法，菜饭蒲团一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬胡编校赋竹屋 其三","author":"刘黻","text":"一屋中含万象光，掩关独坐类龟藏。\n梧桐弄月思康节，枫柞吟秋忆履常。\n事到中年心更懒，人从多难识应长。\n几回梦觉南窗下，闻得邻家煮稻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬胡编校赋竹屋 其一","author":"刘黻","text":"癖为看书借壁光，肯随鹏鴳论行藏。\n听僧鱼鼓斋粮办，留客茶杯礼数常。\n小屋槃姗贪巷静，矮檐伛偻笑身长。\n黄花也识人寥落，不待重阳已吐香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此意","author":"刘黻","text":"此意苍苍晓不难，罚令狂士受饥寒。\n春风纵好惟贪坐，夜月虽明亦懒看。\n杜老却因贫得句，陶潜非为拙辞官。\n世情一味嫌清淡，多刈幽兰种牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西际","author":"刘黻","text":"一径寒松老，因来采茯苓。\n水禽鸣杞涧，野鹿卧棕亭。\n瀑近云根湿，仙遗石井灵。\n守庐青道者，不厌客频经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖","author":"刘黻","text":"沧波混碧空，杨柳路皆通。\n列岫疑奔马，新桥学跨虹。\n东风香迹满，西日乐声丛。\n总是游观者，幽人趣不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访石门洞","author":"刘黻","text":"洞中谁是主，一树野桃开。\n仙驾青牛去，瀑疑碧汉来。\n门閒云阖辟，山好客徘徊。\n已拟归休日，临溪筑钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙","author":"刘黻","text":"出郭才数里，片景尽渔家。\n夜静惟闻犬，潮平不见沙。\n寒风欺槿叶，淡月让芦花。\n世路几销歇，一翁常施茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过柘溪得西字","author":"刘黻","text":"晴雨春无定，东风忽转西。\n地肥桑眼大，天暖麦须齐。\n食顿寻幽所，舟行畏恶溪。\n野禽如避客，飞上半山啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过富阳","author":"刘黻","text":"是非终有定，世路苦多屯。\n山色难留客，江湖亦送人。\n牛羊寒日晚，桑柘一阳新。\n早悟深矰缴，山中合隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问鼠","author":"刘黻","text":"只影投荒阅两秋，汝曹何苦侮畸囚。\n诗书尽啮从谁愬，冠履俱伤重我羞。\n相国溷人宁处垢，永州某氏未轻投。\n翻盆搅瓮何时了，肯事张汤法吏不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冷泉亭","author":"刘黻","text":"两峰相对立，佛屋住中央。\n有水地偏洁，无风心自凉。\n林虚猿应谷，人定月归廊。\n造物馀清供，山栀一树香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别修门","author":"刘黻","text":"晓发别修门，湖山雾气昏。\n百年培正脉，今日罪忠言。\n死节关宗社，生还赖圣恩。\n问天天不语，愿及见亲存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别闻益谦大有","author":"刘黻","text":"岁事十分九，吾为梅岭行。\n人皆忧路滑，天独惜霜晴。\n公论无今古，忠臣有死生。\n玉溪一杯酒，话别若无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈径畈徐左司","author":"刘黻","text":"五载相违一日过，巷无车迹有樵歌。\n因嗟世上深危證，合住山中养太和。\n蔓草不知春事去，梅花曾识岁寒多。\n予今问道三千里，白发双亲可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈赣守陈千峰先生","author":"刘黻","text":"此行滩最险，犹幸拜先生。\n身与天俱远，心惟月共明。\n家书何日到，世路几时平。\n岁晚嗟寥落，春风独满城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园翁","author":"刘黻","text":"租得西山数亩园，自甘学圃竟穷年。\n芟锄如秉太史笔，种接应分造化权。\n编竹为防邻犬践，蟠花不碍树禽眠。\n圣朝徵士惟科目，束帛无因到尔前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿胡编校","author":"刘黻","text":"岭根逢诞日，相对意如何。\n直道遭时少，清贫得寿多。\n仙茅丹已熟，邻秫味方和。\n休说南冠事，穷通付浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿赵使君计院求仁先生","author":"刘黻","text":"西江郡以梅花重，无愧梅花有此翁。\n学到静边皆实地，仁常熟处更春风。\n吏看判笔如神异，民拟生祠与佛同。\n愿为八荒开寿域，欢声何但鲤城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投赵玉堂使君","author":"刘黻","text":"銮坡荣拜锦袍新，雁荡行春作守臣。\n无扰可回民气脉，有才能振国精神。\n柝沈海峤三更月，草长池塘一雨春。\n闻道铃斋少公事，肯分吟席与樵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旱","author":"刘黻","text":"一雨连三月，当秋乃亢晴。\n不知老天意，何忍误民生。\n川竭无云起，山凉有月明。\n忧时心欲折，空听海鳝声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜工部","author":"刘黻","text":"禾黍秋深泣乱离，尽将岁月付于诗。\n天高有语云霾隔，夜半无眠神鬼知。\n心抱孤忠生已晚，身逢多难死应迟。\n自从大雅收声后，赖有篇章续楚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沧浪阁为王宪使赋","author":"刘黻","text":"独得萧台趣，心清不受尘。\n我多临水屋，谁是濯缨人。\n波渺涵天阔，沙渟印月真。\n忘机有鸥鹭，浑不厌相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵岩","author":"刘黻","text":"千岩围一寺，入境便无尘。\n古木犹知己，高崖若正人。\n山灵袪虎迹，石髓幻龙身。\n上有通天窍，民愁独未伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒步","author":"刘黻","text":"出门俱寂寞，短褐步东皋。\n语简反疑傲，诗枯亦近骚。\n水轮寒碓急，山寨晚烟高。\n邈矣飞来雁，令人赋折刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱运筦郊行","author":"刘黻","text":"扁舟随处泊，山影动清波。\n柳惜春风老，花嗔宿雨多。\n野棋惊鹤梦，僧磬答渔歌。\n灵运经行地，今年几度过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何明府爱莲诗","author":"刘黻","text":"濂溪题品非轻许，祗爱亭亭臭味同。\n日晚色归霞照里，夜凉香在月明中。\n独惭冬叶留寒翠，却笑春花学醉红。\n天付清姿尝净植，曾闻结社有陶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和帚斋见寄","author":"刘黻","text":"栖栖惯听鼓鱼声，心印相传第几灯。\n江有白鸥閒似我，地惟苍藓懒于僧。\n吟难用世皆东野，穷亦忧时祗少陵。\n多谢故人相厚意，一笺当暑敌凝冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和南涧叔见寄","author":"刘黻","text":"五年风雨别，家信忆浮沈。\n独隐金仙屋，谁明铁汉心。\n粤邻蛮瘴恶，蜀急客忧深。\n此地无黄犬，朝朝说寄音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵友竹呈求仁使君","author":"刘黻","text":"贤哉太守即长城，领客郊行天放晴。\n鸥鸟不惊知政静，樵夫相对说官清。\n骚坛突兀谁劘垒，学海苍寒敢濯缨。\n世事无如一杯酒，龙门谨勿太标名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵寺丞忆鹤吟","author":"刘黻","text":"既名仙者物，何恙亦沈冥。\n吊月怜孤影，埋云惜瘦形。\n琴中空作操，诗外不消铭。\n叶落鸣皋处，犹疑昨夜听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郭帚斋咏龟泉","author":"刘黻","text":"镕出形模造化工，石龟中有冽泉通。\n来从西峡虾蟆碚，静镇南源玛瑙宫。\n润泽一城消众渴，澄波千古照孤忠。\n贪廉名氏俱标榜，无涸无盈道不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和康节三诗 其一 安分","author":"刘黻","text":"所寓即为乡，萧萧竹护房。\n山中观造化，世上任炎凉。\n鴳莫攀鹏大，凫难比鹤长。\n荣枯从堕地，全不著商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和康节三诗 其二 晨起","author":"刘黻","text":"一日事在寅，晨兴宜自今。\n天澄万古气，人醒半生心。\n残月留僧阁，寒烟度石林。\n营营何所得，白发易相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和酬刘监岳","author":"刘黻","text":"四十馀程到庾关，到来无日不看山。\n誓持冰雪松筠操，肯学春风桃李颜。\n一饭不忘三祝处，瓣香何慊二忠间。\n梵宫咫尺骚坛近，犹愿奚囊续往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和酬黄霞砀见寄","author":"刘黻","text":"此心难与俗人言，终日深居养浩然。\n学到苦时方见道，数当厄处不由天。\n烟霞约客成三友，风雨忧时及四边。\n珍重故人相劳苦，器之元与铁同坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏桂呈张贰车","author":"刘黻","text":"昨夜秋风吹作花，异香早已满天涯。\n蓬莱深处两三树，风月分来第一家。\n绰约道妆如侍案，婆娑醉影欲乘槎。\n广寒莫遣痴蟆食，留取芬芳与世誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜气","author":"刘黻","text":"夜气不盈握，浩然天地清。\n风行石不动，云走月常明。\n陋巷颜回乐，深山大舜耕。\n此心无旦昼，万物自生生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中和酬贾君宝","author":"刘黻","text":"廉纤花雨送残春，不出书楼动数旬。\n閒梦有鱼占乐岁，瘦形如鹤耐清贫。\n漏欺白屋添苔晕，泽浊青林长树身。\n惟忆西湖旧游夕，光风霁月几精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯别郭帚斋游湘南","author":"刘黻","text":"扁舟今日去，昨夜月添愁。\n诗满湘波上，名高庾岭头。\n友朋千载事，今古一般秋。\n石鼓多遗刻，君能寄雁不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯张都巡","author":"刘黻","text":"有梅横石涧，庾岭树还同。\n名更因诗重，心常与月通。\n期君坚老节，愧我作颓翁。\n此去天风便，吹归馆阁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯梅提刑","author":"刘黻","text":"梅花山下送先生，持节西江衣锦荣。\n国步正巇须砥柱，边尘方涨待澄清。\n来时野草知春暖，去路山禽语日晴。\n不怕风寒今满地，摩挲浯石记勋名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮啄","author":"刘黻","text":"饮啄天之分，吾何泣远涂。\n落身近南粤，结梦屡西湖。\n雇仆知乡谊，依僧免屋租。\n新栽窗外竹，明月照同癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山龙门","author":"刘黻","text":"山椒谁立石，人说有龙居。\n此地终招隐，何年定结庐。\n云封秋嶂老，瀑倒夕林虚。\n不似膺门峻，为谋恐未疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城中有高树","author":"刘黻","text":"城中有高树，与我相为邻。\n薄味生古道，静坐疏今人。\n渊明酷爱菊，张翰勤思莼。\n莼菊我何有，一杯天地春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思西弟","author":"刘黻","text":"栖栖梅岭下，禁足老僧如。\n白发双亲泪，青灯一纸书。\n应门犹看汝，强饭莫思予。\n何事成乖隔，低头愧荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思弟","author":"刘黻","text":"久客知秋早，近湖秋更多。\n以予眠不稳，知汝夜难过。\n岁俭山空粟，门閒路没莎。\n归期毋太晚，亲老鬓俱皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思亲","author":"刘黻","text":"拟著青衫归拜亲，青衫未著已危身。\n鸦山地阻无书到，雁荡峰高有梦频。\n节物荒凉嗟远客，家庭笑语愧乡人。\n葵心但秉丹衷在，冬极从来又有春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜无垢先生祠","author":"刘黻","text":"中兴遗此老，梦寐亦中原。\n泣血两朝事，披肝一万言。\n名方登禁掖，身已谪南源。\n苦学无寒暑，双趺片石存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪和谭知县韵酬北枝","author":"刘黻","text":"雪到南边不论春，倚阑万象纵横陈。\n模糊世界山川老，轩豁人心宇宙新。\n镜沼窥鸾应眩眼，蓝关拥马最伤神。\n功名悟到空花处，输与当年高卧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贵溪道中","author":"刘黻","text":"自昔输忠多贾祸，逢人何敢说抨弹。\n三杯村酒逐时醉，五里堠碑随处看。\n行李无金童仆叹，深林有虎路涂难。\n流行坎止吾儒事，但把胸中易自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵坟","author":"刘黻","text":"客愁同路入，行不尽青松。\n水去成双瀑，山来竖一峰。\n土坟存旧垒，木主上新封。\n勿谓寻龙贵，苍姬积在农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剡县呈何视履","author":"刘黻","text":"剡为山水宅，中有隐沦居。\n未续戴逵赞，閒寻支遁书。\n云深丹井远，城老古州馀。\n何事频来往，愧看人钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭菊庐舅氏","author":"刘黻","text":"舅甥三十年，生别且潸然。\n书落雁来处，病深秋到边。\n故人伤远道，孤子伴归船。\n定有焚黄日，西山松树阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨砥轩录参","author":"刘黻","text":"讣落乡山各泪倾，世间难泯是贤名。\n一生官正为州掾，到死人称似砥平。\n夜烛已残宾馆寂，晓梅空点墨池清。\n祗应养得丹砂熟，却向金华洞里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈太傅","author":"刘黻","text":"由来安澹泊，人叹历官迟。\n两邑犹思宰，诸生共哭师。\n文名如日在，心事只天知。\n未竟经纶业，传家有桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽妻母郑夫人 其二","author":"刘黻","text":"幸婿名门仅两年，一编心事苦难笺。\n袖因哭妇痕犹湿，觞未登堂讣已传。\n自悟浮生如泡幻，渠知党祸炽株连。\n墓头片石垂千古，亦把蛮烟姓字镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽妻母郑夫人 其一","author":"刘黻","text":"诗礼传家耦吉人，雍雍完得性中仁。\n乡评莫识生前面，堂影惟悲死后身。\n孀节虎号坟柏夜，妇仪鱼忆涧头春。\n九泉寂寂应无憾，双璧分明作世珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵少卿","author":"刘黻","text":"班升金掌擢清才，苦欲归田挽不回。\n浙右尚思菩萨去，荆南空望使星来。\n苔侵书阁秋山静，竹锁吟庭夜鹤哀。\n路出箫台多巷祭，几人和泪折寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病鹭","author":"刘黻","text":"得汝相依若友朋，无端鸣啄顿伶俜。\n莫亲野水应生梦，几立斜阳不整翎。\n肩耸可齐工部瘦，神清犹逐楚臣醒。\n人言气习多濡染，却笑吾今鬓亦星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸葛武侯","author":"刘黻","text":"高卧曾吟梁父诗，痛无针石活当时。\n天公未坠炎刘祀，心事能令先主知。\n八阵尚存惊对垒，一星才落便无师。\n勋忠遗舄藏岷蜀，老柏苍苍万古思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逢腊","author":"刘黻","text":"一岁忽逢腊，倚阑清气浮。\n雪飞浙山上，月照楚江头。\n家远易成梦，酒悭难散愁。\n读书果何补，自笑不骑牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱塘观潮","author":"刘黻","text":"此是东南形胜地，子胥祠下步周遭。\n不知几点英雄泪，翻作千年愤怒涛。\n雷鼓远惊江怪蛰，雪车横驾海门高。\n吴儿视命轻犹叶，争舞潮头意气豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偕剡中诸友游明心寺","author":"刘黻","text":"一春风雨掩柴扉，今日相羊竟晚晖。\n山远从谁寻古迹，水高何处认渔矶。\n衣冠揖逊禽鱼悦，觞咏流行草树馡。\n共出戴公亭下路，邑人疑是舞雩归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"刘黻","text":"暮云漠漠数行鸦，心事凄凉正忆家。\n不向孤山留谏草，那能庾岭见梅花。\n峒丁嗜斗牙成血，楚俗趋蛮发半髽。\n明日绝粮难早计，好?流水嚼胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作","author":"刘黻","text":"四十一年身，天南作逐臣。\n病居僧却到，淡饭仆犹嗔。\n州浅稀高木，山荒阙伏神。\n退藏还有味，所憾远双亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶得","author":"刘黻","text":"淡饭清茶处处安，学儒容易识真难。\n风无形迹通群窍，日有光明阻覆盘。\n竹色满庭留夜气，柳阴夹径怯秋寒。\n世间万象俱呈露，输与山人自在看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]