[{"title":"自笑","author":"郭祥正","text":"自笑姑溪客，还投瘴海边。\n不才无进路，多病复残年。\n欲种千竿竹，将求二顷田。\n人生底事足，且爱酒涓涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜晴","author":"郭祥正","text":"瘴乡仍久雨，生事念樵渔。\n江海云归尽，乾坤日上初。\n短垣张浣服，幽圃理残蔬。\n佐国知无术，聊欣病体舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城上","author":"郭祥正","text":"危步欲何适，城头独杖藜。\n水归沧海后，云散暮天时。\n秋色长空淡，笳声迥野悲。\n泥沙埋熟稻，一穗亦无遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独醒","author":"郭祥正","text":"野性惟怜酒，无聊遂独醒。\n风尘双白鬓，天地一青萍。\n鵩鸟宁须赋，离骚未是经。\n回头付陈迹，终欲醉冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邸报","author":"郭祥正","text":"立法新三省，论材只数公。\n簿书期会正，风俗见闻同。\n边塞疮痍后，朝廷气概中。\n不才思献赋，天路恐难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宦情","author":"郭祥正","text":"宦情聊落甚，况在九溪边。\n瘴雾易成雨，飓风偏覆船。\n水残馀盗贼，村迥少人烟。\n欲达中州信，迢迢路六千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自遣","author":"郭祥正","text":"骨相殊屯贱，无官只有阶。\n半生萍梗过，两鬓雪霜排。\n去国肠空断，求田心未谐。\n新交莫相笑，中立一枝柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西庵","author":"郭祥正","text":"一庵丹荔下，更与画桥邻。\n不许尘埃到，每期风月亲。\n好音闻度鸟，斜影辨疏筠。\n拂拭白藤榻，攲眠稳病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨过","author":"郭祥正","text":"雨过添幽事，褰裳步暖沙。\n竹梢含净雾，藤刺罥轻槎。\n鸂鶒双随浪，蜻蜓对觅花。\n老夫诗思惬，颇觉日沉车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野寺","author":"郭祥正","text":"野寺盘山腹，高秋雨霁天。\n拂檐云漫漫，穿竹水涓涓。\n接食怜驯鸟，支筇慕老禅。\n经年无客到，门巷叠青钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晴","author":"郭祥正","text":"川涨那堪雨，今朝喜晚晴。\n幽花萦露重，浊水止蛙鸣。\n圩稻应全刈，村醪可强倾。\n吾虽无一亩，亦足慰馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏迹","author":"郭祥正","text":"屏迹已恨晚，疲躯今自由。\n百年无七十，一日有千忧。\n觅酒开青眼，凭诗遣白头。\n莫言宾客少，池上两三鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"却卧","author":"郭祥正","text":"晓起梳头毕，开窗却卧时。\n素烟收枕席，红日上藩篱。\n仰面看书卷，移床近酒池。\n纷纷万方事，安用老夫知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无客","author":"郭祥正","text":"病久人情厌，经旬客不来。\n帘因风力卷，门待月华开。\n柳上新蝉咽，城头暮角哀。\n劳生随物化，孰免葬蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"门巷","author":"郭祥正","text":"肃肃秋容净，萧萧门巷深。\n荆榛元自合，车马少过寻。\n问婢催蔬熟，呼儿取酒斟。\n藤床未成寐，野鸟噪归林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋分","author":"郭祥正","text":"赋分从来薄，明时敢妄干。\n六年悲对狱，五十速休官。\n水送云天净，山开洞壑寒。\n一枝能息影，何暇北溟宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"农事","author":"郭祥正","text":"三岁悲农事，官仓亦已贫。\n敕书虽赦狱，恩泽未苏民。\n南国供输大，中宵涕泗频。\n一心随草木，无复念沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野望","author":"郭祥正","text":"暑雨收残候，秋云结薄阴。\n山光翠兼紫，水影净还深。\n竹密群鸦入，天空一雁沈。\n兴来搔白首，衰飒愧儒林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮","author":"郭祥正","text":"倚杖孤亭久，无心辨俗讹。\n暮山青扫淀，秋汉白浮波。\n岸震归船鼓，村喧刈稻歌。\n未收西望眼，问罪有干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归燕","author":"郭祥正","text":"天外秋风劲，梁间燕羽稀。\n营巢雏未老，何地汝成归。\n蜃泽多楼阁，茅堂无阱机。\n故园春色动，还趁社前飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣怀","author":"郭祥正","text":"节物惊心事，抟金菊放花。\n潜鱼防饵钓，高雁避城笳。\n南浦秋风冷，西江夕照斜。\n异乡消息断，林外更闻鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣衣","author":"郭祥正","text":"清秋送残暑，隔屋忽闻砧。\n远震星河夜，遥兴关塞心。\n欲知针缕密，即是泪痕深。\n他日功成后，逢人寄好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"植杖","author":"郭祥正","text":"独往怜渔艇，群飞爱暮鸥。\n谁云天地窄，自伴水云游。\n荇叶青争老，蓼花红半收。\n江头人事绝，植杖我何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空囊","author":"郭祥正","text":"床有牛衣卧，厨供石髓餐。\n此身知是幻，卒岁不为难。\n冰合潜蛟冷，云深病鹤寒。\n青钱无得选，空挂一囊看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋笛","author":"郭祥正","text":"清秋闻笛弄，独立露沾衣。\n天外云留住，水中龙未归。\n悠扬声益苦，感激思何微。\n不似前春听，梅花片片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄山二首 其一","author":"郭祥正","text":"秋物已潇洒，临高念岁穷。\n阵收群雁没，峰断片云空。\n月色山川内，笛声关塞中。\n西人未柔服，长策在诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄山二首 其二","author":"郭祥正","text":"秋晚陟浮丘，西临古渡头。\n钟声沉断岸，桥影散中流。\n雪让芦花密，云排稻穗稠。\n乾坤均帝力，草木岂能酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柴门","author":"郭祥正","text":"水落烟村迥，柴门四五家。\n晚风回断雁，寒雨侧幽花。\n世事纷无已，人生自有涯。\n鲸鳌真可钓，吾兴欲乘槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复寒","author":"郭祥正","text":"三月闽南国，阴寒变惨凄。\n市楼添酒价，山雨勒莺啼。\n田父忧春种，商人怯路泥。\n何当好风日，稚子浴清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆携酒见过三首 其一","author":"郭祥正","text":"永日门常掩，欣闻五马过。\n社馀巢燕入，花散蜜蜂多。\n望断千山绿，愁来两鬓皤。\n肝肠思一濯，须藉酒为河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆携酒见过三首 其二","author":"郭祥正","text":"酒味年来美，携觞约屡过。\n交情贫始见，诗思老仍多。\n许国心常赤，思家发任皤。\n诵君新得句，秀色揽山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆携酒见过三首 其三","author":"郭祥正","text":"沉毅陈夫子，谈兵孰与过。\n运筹知必胜，善将不论多。\n汉阵千重黑，胡沙万里皤。\n如闻洗戈甲，谁为挽天河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中喜君仪要温老希圣同见过二首 其一","author":"郭祥正","text":"萧萧山寺雨，漠漠暮云寒。\n不恨麻衣薄，深愁酒盏乾。\n离披花刺眼，容易雪冲冠。\n要客能相遇，宁辞湿锦鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中喜君仪要温老希圣同见过二首 其二","author":"郭祥正","text":"万里乡园别，一春风雨多。\n乱蛙声斗急，归燕舞缘何。\n石榻昏苔藓，柴门暗薜萝。\n橛株方自笑，忽枉故人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢君仪携酒要客慰唁愁寂二首 其一","author":"郭祥正","text":"佳客过穷巷，良朋复可要。\n静缘棋局乱，愁逐酒杯销。\n花底莺声度，林间雨点飘。\n晚春频一醉，何必拟松乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢君仪携酒要客慰唁愁寂二首 其二","author":"郭祥正","text":"谗人未投北，君子独相亲。\n岁月惊春晚，壶觞慰我贫。\n松声风外急，山色雨中新。\n一醉无归梦，宁论寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白莲启日上人退避长老之命以四韵高之","author":"郭祥正","text":"结宇古城边，能诗复悟禅。\n钵分摩诘饭，池种远公莲。\n竹飐春烟静，禽歌夜月圆。\n洁身吾有趣，回首谢尘缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李绛伯华户曹","author":"郭祥正","text":"国士苟微禄，携家千里行。\n乡关寒食节，邮舍冷猿声。\n落日和云尽，离觞与泪倾。\n衔冤仍送别，何以慰浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石声叔留题君仪基石亭二首 其一","author":"郭祥正","text":"高才摅远趣，凿石架危亭。\n宿鸟依林白，春苗接海青。\n云光随帚乱，泉响置琴听。\n况得少陵句，宜镌座右屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石声叔留题君仪基石亭二首 其二","author":"郭祥正","text":"因山基大石，华榜揭高亭。\n畦稻翻新绿，山岚浮远青。\n鸟行云际度，松籁雨馀听。\n安得吴生画，为予传小屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢君仪寄新茶二首 其一","author":"郭祥正","text":"建溪春物早，正月有新茶。\n得自参军掾，分来居士家。\n辗开黳玉饼，汤溅白云花。\n一啜清魂魄，醇醪岂足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢君仪寄新茶二首 其二","author":"郭祥正","text":"北苑藏和气，生成绝品茶。\n岂宜分旅馆，只合在仙家。\n点处成云蕊，看时变雪花。\n琳琅得新句，又胜玉川誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓起闻禽寄元舆","author":"郭祥正","text":"幽鸟语清晨，窗间宅禁人。\n只知添白发，不觉度青春。\n救过须三省，观空止一尘。\n贤交如未弃，时送浊醪醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食感怀示子焘二首 其一","author":"郭祥正","text":"柳暗青春暮，莺啼静院阴。\n乡关隔寒食，父子共沾襟。\n未举鹏天翼，聊为鵩舍吟。\n惊魂招不得，时节感人深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食感怀示子焘二首 其二","author":"郭祥正","text":"寒食金波泪，他乡此日心。\n草连天际色，泉断陇头音。\n先冢三年别，飞埃万里侵。\n只凭攲枕梦，时到谢山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食元舆见要南楼把酒","author":"郭祥正","text":"五马登城堞，平分载酒船。\n无家寒食客，小雨惜花天。\n循抚恩何厚，飘零命最邅。\n閒愁不用遣，一醉暂成仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨感怀二首 其一","author":"郭祥正","text":"夜雨霪难霁，沟塍复乱蛙。\n轻寒侵病骨，馀响答空阶。\n杜子嗟沾湿，庄生失渚涯。\n通宵不成寐，归思泻长淮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨感怀二首 其二","author":"郭祥正","text":"羽毛零落易摧伤，父子同幽瘴疠乡。\n归梦不成残夜雨，空阶滴滴到愁肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆小子鼎","author":"郭祥正","text":"元朝别家去，音信隔三春。\n读易应终卷，端居莫患贫。\n定交疏燕雀，养节慕松筠。\n冤狱何时辨，思儿泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"排闷呈元舆","author":"郭祥正","text":"交态非今薄，人情自古难。\n敝裘甘我老，雄剑请君弹。\n魂逐云峰断，心依酒海宽。\n百年能几许，日月似跳丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀天骘","author":"郭祥正","text":"筑室君先隐，穷途我正难。\n流莺春谷暖，别鹤玉琴寒。\n泉响经时听，云光抵暮看。\n异方空泪眼，何日共幽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆三月三十日致酒","author":"郭祥正","text":"衰病仍为客，相依过一春。\n和篇惊韵险，把酒沃愁频。\n紫燕巢方稳，黄鹂语尚新。\n何时公赴召，终欲托车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆试北苑新茗","author":"郭祥正","text":"建溪虽接壤，春末始尝茶。\n旋汲邻僧水，同烹北苑芽。\n月圆龙隐鬣，云散乳成花。\n贡入明光殿，分来王谢家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别南楼","author":"郭祥正","text":"寄榻六十日，朝朝上碧城。\n云光随近远，山色变阴晴。\n濠静鱼频跃，楼空燕不惊。\n他时那复到，欲去重含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月一日","author":"郭祥正","text":"有瘴从今始，斯须雨复晴。\n草蒸蛇肆毒，榛密鵩尝鸣。\n晚食宜防饱，村醪可强倾。\n何时击归镫，高视叹浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别濠上","author":"郭祥正","text":"自得庄生乐，观鱼近碧濠。\n触萍时鼓鬣，防饵不投刀。\n柳挹春风静，鸥眠夜月高。\n舍旃吾有适，沧海钓鲸鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻旧居教乐","author":"郭祥正","text":"昔作幽人宅，今为舞女场。\n燕惊弦管杂，草避绮罗香。\n諠静虽殊致，兴衰自有常。\n遥怜岩桂下，谁拂读书床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登清音亭二首 其一","author":"郭祥正","text":"已别城楼景，还登树杪亭。\n地高邻北斗，山远接南溟。\n蟾影依云断，樵歌隔浦听。\n客愁安用遣，此处可忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登清音亭二首 其二","author":"郭祥正","text":"薄暮杳何适，高高登古亭。\n地无南国瘴，帘卷半空星。\n石瘦长人立，潭春皓雪停。\n短才吟不就，终欲付丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中怀元舆","author":"郭祥正","text":"暂阻龙山雨，还思凤阁人。\n凌云曾献赋，薄雾岂藏身。\n酒酿公田秫，羹调紫豉莼。\n稍晴应见过，酬唱莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨晴都按口号呈元舆","author":"郭祥正","text":"雨为华筵止，晴牵饮兴长。\n管弦随昼永，罗绮散风香。\n卫仗留春碧，宫衣想赭黄。\n明年今日事，归捧祝尧觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆怜我复有漳南之行以曲局不可出遂置一樽托公域弟酌发眷眷之情于此可见矣以四韵谢元舆并呈公域弟","author":"郭祥正","text":"怜我万里别，南荒多瘴埃。\n身为官事隔，酒托故人开。\n饮德知难报，论欢默可猜。\n宗家有毛女，冰洁胜寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与元舆论诗而风雨骤至","author":"郭祥正","text":"一作城头饮，重论别后诗。\n倏然云雨至，应有鬼神悲。\n叙事公偏富，求声我最知。\n赓酬三百首，馀韵付咸池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆近诗加妙用寄四韵","author":"郭祥正","text":"谁识子昂孙，新诗霭暮云。\n体兼诸谢备，名与少陵分。\n今去知无敌，从来自出群。\n南山能射虎，只许李将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢元舆送鲜鲤煮酒","author":"郭祥正","text":"鲜鲤江湖味，香醪日月春。\n抚循时有赠，饱暖遂忘贫。\n玉缕空投箸，金波漫入唇。\n交情今乃见，晚节共松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招孜祐二长老尝茶二首 其一","author":"郭祥正","text":"无物滋禅味，来烹北苑茶。\n碾成云母粉，香溅碧松花。\n消渴梅何俗，安神术谩誇。\n清谈尝数椀，莫笑老卢家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招孜祐二长老尝茶二首 其二","author":"郭祥正","text":"昔人多嗜酒，今我酷怜茶。\n软玉裁成饼，轻云散作花。\n石泉助甘滑，肠胃涤烦邪。\n却怪少陵客，曾无新句誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追和故友袁世弼酬孜老四韵","author":"郭祥正","text":"坐讽汤休句，闽南朱夏时。\n碧云生海峤，清吹散松枝。\n救物宁论报，安禅不履危。\n江东饱芹蕨，肯赴野人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题建阳王祖圣朝奉南涧楼","author":"郭祥正","text":"郎省辞荣早，楼居鹤发翁。\n响分南涧水，清占北窗风。\n紫府云常近，黄尘路不通。\n何当陪杖屦，有意学冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壶公山方卿墓亭","author":"郭祥正","text":"鄞国棠阴在，壶山墓草黄。\n庆源长不竭，善训永无忘。\n燕雀春风里，烟云碧瓦傍。\n命书何日下，潜德发幽光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]