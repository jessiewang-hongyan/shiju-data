[{"title":"初冬山居即事十首 其五","author":"吴芾","text":"节物随时变，斜阳一望中。\n暮云重叠碧，远树浅深红。\n菊色滋寒露，芦花荡晚风。\n一樽谁与共，独立意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬山居即事十首 其四","author":"吴芾","text":"自笑谋生拙，空惊岁月除。\n年衰惟藉药，发少不禁梳。\n尽日扃蓬户，无人过草庐。\n晚来闲策杖，缓步当柴车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬山居即事十首 其三","author":"吴芾","text":"归来非计失，事少得心宽。\n村落年方稔，庭闱病复安。\n诗当随景赋，酒莫放杯乾。\n插架书还在，仍容子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬山居即事十首 其二","author":"吴芾","text":"屋角营书室，新成八九椽。\n开林延爱日，甃石截流泉。\n山近岚光逼，窗疏月色穿。\n寒梅何日吐，我欲醉花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬山居即事十首 其一","author":"吴芾","text":"我爱山居好，冬来惬野情。\n檐前朝日暖，谷口暮云横。\n柏子当轩堕，蕉花傍槛生。\n自堪安朴拙，何苦慕尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏登城上有感","author":"吴芾","text":"来守孤城忽两期，可堪登眺又斜晖。\n经春不见流莺语，终日唯看乳燕飞。\n风舞新荷青袅袅，烟笼细柳绿依依。\n此邦纵美非吾土，莫怪山翁只念归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿元伯母太夫人八秩","author":"吴芾","text":"七十康强自古稀，年登八秩有谁宜。\n寿钟贤母人难及，庆袭佳儿世共知。\n荣养已为人子范，清规还作女流师。\n綵衣更戏兰阶下，遥想慈颜笑解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"志道相见和前韵","author":"吴芾","text":"每忆湖山动老怀，今朝始作故乡回。\n正惭行李匆匆去，忽报轺车得得来。\n幸对清谈挥玉麈，肯辞痛饮倒金杯。\n我归已遂终焉计，何日重逢笑口开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀归有作","author":"吴芾","text":"一病兼旬百不禁，愈牵归梦绕家林。\n向来岂有功名念，此去断无人我心。\n但愿天怜将就木，许从人欲便投簪。\n若蒙不靳清闲福，尚惜馀年尽寸阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀梁丈陈丈","author":"吴芾","text":"不见高标动浃旬，寸心如渴欲生尘。\n春深渐觉梅花老，风暖还惊柳色新。\n对景想题诗句满，开怀应把酒杯频。\n扁舟前后空相望，安得从容笑语亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李子仪喜津改秩作诗相庆因次韵 其二","author":"吴芾","text":"有屋依山复面湖，幽栖试问有谁如。\n门前更种千竿竹，堂上还堆万卷书。\n每恨暮年方卜筑，岂知今日得安居。\n鲤庭况有新桃李，莫惜时来长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李子仪喜津改秩作诗相庆因次韵 其一","author":"吴芾","text":"懒复从人问里评，纵今得誉亦虚声。\n有儿第使传儒业，改秩何期冒宠荣。\n敢望芝兰如谢氏，但亲松菊学渊明。\n烦君慰藉来佳句，读罢欣然酒一倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李仓子长按行偶成四韵奉呈 其一","author":"吴芾","text":"强把州麾楚水东，星轺临按偶相逢。\n平居已是同闾里，岁晚还来托部封。\n千里江山多契阔，一樽风月且从容。\n我将投绂林泉去，拭目公归侍九重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟归自郡中舟中偶成 其一","author":"吴芾","text":"寒流清更浅，短棹去仍来。\n山色侵书帙，波光映酒杯。\n龟鱼应旧识，鸥鹭莫相猜。\n全胜山阴路，空船载月回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟归自郡中舟中偶成 其二","author":"吴芾","text":"薄日烘云影，轻风溅浪花。\n数峰排绝岸，一雁落平沙。\n冉冉寒生袖，悠悠梦到家。\n前村谁有酒，试遣小童赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贡院落成郡庠诸生毕集因作诗以勉之","author":"吴芾","text":"多士如林古豫章，不应较艺寓僧房。\n一朝尽辟荆榛地，万础俄新翰墨场。\n文笔要同孤塔耸，词源宜与两湖长。\n会看从此飞鸣去，九万鹏程未易量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远老自和前诗再寄复次韵","author":"吴芾","text":"雪到梅开恰欲漫，扶藜得得绕湖山。\n折将冷蕊疏枝去，浸在明窗净几间。\n一见已堪资琢句，细看还足助怡颜。\n只愁冰艳相侵逼，映得衰翁鬓愈斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远老惠雪中观梅诗次韵以谢","author":"吴芾","text":"山头飞雪已漫漫，云散须臾复见山。\n踏雪不辞来野外，爱梅须遍走林间。\n为怜孤艳思经目，拟索疏枝笑解颜。\n师肯相过宜及早，预愁花点绿苔斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈时中法台得郡而归喜而成诗","author":"吴芾","text":"去岁秋风话别离，今秋俄报有归期。\n自应冠豸登三院，何遽凭熊把一麾。\n治行伫为千里最，才猷已是九重知。\n莫辞小憩留仙隐，伴我花前倒玉卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到双胜匆匆不及款舟中成小诗寄良器兼简杨宰","author":"吴芾","text":"海滨何处足春风，尽在王孙小圃中。\n雨洗山光供几席，日移花影上帘栊。\n扁舟回首烟波隔，尊酒何时笑语同。\n若对扬雄赏幽胜，杯行应亦话衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人见寄","author":"吴芾","text":"高义如君举世无，贤关十载会琴书。\n匆匆边马来时别，郁郁乱山深处居。\n天外风尘仍断绝，人间豪杰正萧疏。\n何时樽酒论文去，千里相思寄望舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十五侄见寄","author":"吴芾","text":"草庐高卧几经春，被褐深藏席上珍。\n已自闭门甘澹泊，不妨琢句自清新。\n我惭老去同流俗，日念归来作野人。\n此后埙篪酬唱罢，因风见寄莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十五侄韵","author":"吴芾","text":"无补公家祇主臣，但思高卧故山云。\n宦游耻蠹太仓粟，归去贪羹碧涧芹。\n喜得醇醪堪饮客，还惊妙句更超群。\n速来共为梅花醉，趁取枝头香正芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子仪同赏荷花","author":"吴芾","text":"晚凉领客泛涟漪，境胜形容颇费诗。\n人自红莲丛里过，舟从绿柳岸边移。\n兴来滞思俄然豁，坐久烦襟顿觉披。\n佳客要须拚一醉，莫辜风细月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天予即席咏岩桂","author":"吴芾","text":"衰病无悰日日加，喜君来自帝王家。\n素娥正驾一轮玉，老桂方开双树花。\n置酒虽欣陪重客，侑樽还愧乏名娃。\n莫辞今夕如泥醉，须念明朝各一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天予孺子亭三首 其三","author":"吴芾","text":"我来湖上访前贤，正值清秋欲暮天。\n十顷败荷攲浅水，千章古木锁寒烟。\n遍寻陈迹俱亡矣，独立幽亭祇黯然。\n清德照人增我愧，暮年独未返林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天予孺子亭三首 其二","author":"吴芾","text":"东汉诸公孰最贤，南州高士独推先。\n蒲轮徒枉当年聘，尘榻从教尽日悬。\n吾道固应天未丧，此时争奈木将颠。\n栖栖尔辈成何事，那似清风万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天予孺子亭三首 其一","author":"吴芾","text":"南州高士务躬行，不事王侯祇力耕。\n西岭已如刚节峻，东湖还似古心清。\n正惭老拙非良牧，安有仁恩及庶氓。\n若也当年能逐迹，他时容或可齐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尹少稷席上韵","author":"吴芾","text":"每恨千山隔，俄欣一日同。\n交游非比众，人物少如公。\n正欲扶公道，端期振此风。\n不须深退避，风雨要帡幪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方叔载留别","author":"吴芾","text":"临别殷勤赠我诗，一披何喜得如之。\n怪来笔下能高妙，元是胸中自崛奇。\n长恨顷时才一面，方欣今岁展双眉。\n明年莫负论文约，要向新元副所期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方叔载读小集","author":"吴芾","text":"江城留滞两经年，强把诗篇拟昔贤。\n岂有高歌翻白雪，祇凭短句问青天。\n优人献伎徒供笑，丑妇添装岂解妍。\n君欲学诗须学古，不应读此向窗前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王夷仲至日有感","author":"吴芾","text":"葭灰管里气初浮，阳长阴消不自谋。\n吾道穷耶当复泰，此身老矣不禁愁。\n得闲正好寻诗社，乘兴何妨上钓舟。\n拟待梅开同胜赏，且宽归兴少迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王夷仲雪中见贻","author":"吴芾","text":"岁晚端居寂寞滨，雪花零乱更愁人。\n捲帘已觉青山老，入座仍添白发新。\n写景自怜佳句少，论交还喜宿心亲。\n来诗况复清如雪，想见吟成泣鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王夷仲韵","author":"吴芾","text":"洒落胸襟有古风，日临清泚面巃嵷。\n不堪世路千重险，直与溪流万折东。\n刮眼相看言有味，倾怀一笑兴无穷。\n何时同访连樯老，快意觥船一棹空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王夷仲韵","author":"吴芾","text":"故人声气合，交契久弥深。\n不弃荒村陋，来分古木阴。\n意倾陈笃论，兴发出高吟。\n岂料逃空谷，犹闻正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王龟龄待制贡院落成二首 其二","author":"吴芾","text":"主盟湖学属何人，赖有公来为作新。\n士俗似闻衰也久，文场今见美哉轮。\n挈还旧观人争睹，赋就新诗笔有神。\n苕霅儒风从此振，文翁端恐是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王龟龄待制贡院落成二首 其一","author":"吴芾","text":"扁舟犹记拂洲蘋，转眼年华几度新。\n愧我今成双白鬓，喜君来驾两朱轮。\n一时令下从如水，千里威行敬若神。\n拟访旧游观盛事，一官何苦绊吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王致君见寄望海亭诗","author":"吴芾","text":"领客闲登木杪亭，坐来四面对峥嵘。\n野田散漫高低绿，湖水瀰茫远近清。\n览胜喜穷千里目，放怀笑引百壶倾。\n酒阑未用忙归去，更看亭前海月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王瞻叔泉字韵","author":"吴芾","text":"暮年亦复侍甘泉，每对青铜只自怜。\n宁忍忧疑探虎穴，且将得失付鱼筌。\n归来但欲无身累，老去那能徇世缘。\n若得优游全晚节，从人唤作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和世同见怀","author":"吴芾","text":"君去经春未得还，老夫幽恨满春山。\n海棠花过乖同赏，杨柳阴成阻共攀。\n对月有谁陪笑傲，临流惟影伴清閒。\n何时策杖来过我，把酒论文一解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶先生见寄","author":"吴芾","text":"春到山城花木深，兴来谁与共登临。\n空惊节物催人老，强对芳菲索酒斟。\n已喜筠筒先见寄，更闻藜杖欲相寻。\n劝君未用忙归去，要向樽前话寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶先生韵 其二","author":"吴芾","text":"杯酒忘怀不计巡，少年行乐肯输人。\n年来性复便疏懒，老去谁能浪苦辛。\n春暖园林花放早，月长庭院燕来频。\n物华正尔撩诗思，况得诗翁好句新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶先生韵 其一","author":"吴芾","text":"三分春色一分强，风雨忧愁莫见妨。\n何幸山城官事少，且看溪路野花香。\n丝丝嫩绿垂流水，片片飞红逐去樯。\n一日要须拚一醉，百年能醉几千场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶性之喜雨","author":"吴芾","text":"去岁饥荒特异常，那知今日便丰穰。\n田畴雨足经时润，院宇风生着处凉。\n老去我方辞五斗，秋来谁解积千仓。\n从今闾里无艰食，会见家家酒熟香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和四二侄用林道叟见寄字韵","author":"吴芾","text":"华发萧萧日夜疏，奔驰不止欲何如。\n得抛印绶心方适，归见湖山气始舒。\n世事转头如蝶梦，人生到此似蘧庐。\n我今已作终焉计，却悔当年赴鹤书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和四哥钱塘思归韵","author":"吴芾","text":"郁郁羁怀久欲东，故园何日割蒿蓬。\n可堪世路尘缨缚，却使云山蕙帐空。\n待价深藏非左计，汗颜为斲岂良工。\n须知吕望严陵辈，亦是沧浪一钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和左达功春日见寄二首 其二","author":"吴芾","text":"万方多难日，千里故人心。\n酒社知谁在，诗盟阻重寻。\n莺啼空日暮，花落又春深。\n我去惭无计，何年许见临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和左达功春日见寄二首 其一","author":"吴芾","text":"良觌弥年阻，相思入梦迷。\n性疏仍寡合，世乱且幽栖。\n极目苍山北，伤心白水西。\n书空愁坐处，还是暮云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和左达功春日即事二首 其二","author":"吴芾","text":"春色还如旧，吾生愧此心。\n功名嗟晼晚，时序忆追寻。\n万国豺狼满，重城草木深。\n西湖真赏处，空想旧登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和左达功春日即事二首 其一","author":"吴芾","text":"世途虽反侧，春草自萋迷。\n独树花仍发，何枝鹊可栖。\n犬羊终逐北，貔虎未征西。\n回首长安路，茫茫日欲低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和田伯清见寄 其二","author":"吴芾","text":"落笔摛辞烂有章，故应往岁擅文场。\n身登霄汉声猷著，兴寄湖山气味长。\n无计盍簪同把酒，尚怀扫地对焚香。\n依然日暮碧云合，相望回头各一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和田伯清见寄 其一","author":"吴芾","text":"可叹人生有限身，终朝长是困嚣尘。\n向来每愧为人役，今日方能保我真。\n幸有一丘堪避俗，何妨百岁作閒人。\n更烦妙句相褒借，顿觉柴门暖似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和任漕开宴值雨","author":"吴芾","text":"正是千花万卉开，一时景物亦佳哉。\n良辰已幸陪龙节，盛宴仍容饫豹胎。\n虽喜风光环几席，其如烟雨暗池台。\n明朝天宇应澄霁，尚拟寻芳一再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和任漕罗溪道中韵","author":"吴芾","text":"揽辔驰原隰，行行四牡骄。\n风烟方入眼，雷雨忽连宵。\n官事终期了，征途岂惮遥。\n经旬怀笑语，嗟我亦何聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和任漕韵","author":"吴芾","text":"耆英持漕节，一稔百无忧。\n心计唯丰国，文移罕到州。\n泽流千嶂雨，效见万家秋。\n早晚趋严召，雍容侍冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘与几悟昔","author":"吴芾","text":"先生岂是傲当时，知向名场早识机。\n扰扰半生蝴蝶梦，休休今日绿蓑衣。\n笔端信有江山助，醉里从教日月飞。\n应笑蘧生回首晚，才知四十九年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘正夫见寄 其二","author":"吴芾","text":"已是龙钟七十人，故应告老上章频。\n九重垂念如慈父，一旦容归作幸民。\n今我可怜非故我，此身才喜是吾身。\n花前幸有尊中醁，且醉湖山几度春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘正夫见寄 其一","author":"吴芾","text":"揽辔澄清慕古人，观风问俗按行频。\n振荒已视饥由己，畜水犹思利及民。\n美意共推君体国，高怀还喜我抽身。\n名章下逮情何厚，和气薰然暖似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱文卿见赠","author":"吴芾","text":"簿书终日叹徒劳，俄喜相看有故交。\n抱道尚稽怀印绶，安贫还不厌衡茅。\n草庐谁识真龙卧，阿阁行看彩凤巢。\n归去不妨深闭户，静听修竹晚风敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱文卿春雪韵","author":"吴芾","text":"春来何事尚凝严，一夜空庭霰雪兼。\n坐久罗衣惊顿薄，更阑杯酒觉频添。\n旋消疏滴檐间雨，更看平堆地上盐。\n谁道东风回暖律，韬霞掩日不容觇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱文卿落解后书怀","author":"吴芾","text":"先生英气欲横秋，唾手功名岂待求。\n共指层霄看展翼，谁知平地亦沉舟。\n箦中宰相宁嫌辱，胯下将军未足羞。\n有志会须腾踏去，莫将富贵羡王侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱世同见寄","author":"吴芾","text":"门外青山玉作堆，山前一水更萦回。\n归来虽喜风烟好，老去还惊岁月催。\n不见故人增寂寞，尚怀往日共徘徊。\n何时轩盖重相过，伴我花前醉百杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱世同咏梅","author":"吴芾","text":"竹篱茅舍旧同居，不见冰姿恰岁馀。\n别后有谁亲几席，朝来忽喜映阶除。\n雪中有酒宜相就，月下无人肯自疏。\n端与岁寒长有约，不须青帝更吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱世同夜坐待月","author":"吴芾","text":"新凉初入我庭中，满座清风孰与同。\n已喜故人来聚首，那堪明月更当空。\n满倾浊酒休辞醉，剩作新诗莫讳穷。\n屈指如今诗酒社，有谁胸次得如公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]