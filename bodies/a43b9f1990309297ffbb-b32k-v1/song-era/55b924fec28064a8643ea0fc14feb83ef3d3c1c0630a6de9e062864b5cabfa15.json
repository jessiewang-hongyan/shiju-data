ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁元帝二首 其二","author":"陈造","text":"中外谁非肉骨恩，颙颙帝子亦王孙。\n君王日握金银笔，忍署兵威极六门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁元帝二首 其一","author":"陈造","text":"慢藏已重阿琳忧，君道平时况未优。\n冀北羊肠各亡社，浪言建业胜荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隗嚣","author":"陈造","text":"诸父论情是至亲，若为见卖苟全身。\n发崔冤魄旋无憾，眼见君侯杀伯春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨二首 其二","author":"陈造","text":"招宝山邻娑竭宫，县峰仍接补陀峰。\n晴晴雨雨皆如响，谬挹池鳗拜土龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨二首 其一","author":"陈造","text":"永宁开善皆留宿，梦破阶除急雨倾。\n人道行车定膏泽，我知龙伯念春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其十二","author":"陈造","text":"雨后郊原小杖藜，行人相语各伸眉。\n即今极目如云稼，曾是蝗虫盖地皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其十一","author":"陈造","text":"岁收粗足蛰饥雷，不赖门生送酒杯。\n坐遣将军扪腹笑，端知此惠有从来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其十","author":"陈造","text":"得句聊将颂作霖，开樽亦复陋孤斟。\n南亭旧约何时践，志喜从公更一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其九","author":"陈造","text":"邦人苦旱日呻呼，公比邦人更瘠臞。\n贺雨归来人竞问，邦君今日解颜无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其八","author":"陈造","text":"疠疾流时囊探丸，羸癃十九得安全。\n再烦起死回生手，挽作山城大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其七","author":"陈造","text":"使君手有垂云帚，虐魃妖螟扫不馀。\n十顷飞蝗戴蛆死，已濡银笔为君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其六","author":"陈造","text":"钱轻币重病吾农，未有奇方起困穷。\n粗遣年丰官籴粟，少令钱币各通融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其五","author":"陈造","text":"货绝交通腹殷雷，人家一雨便春台。\n即看商贩接踵集，已有米船衔尾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其四","author":"陈造","text":"醮坛初上水沉烟，甓社龙公敢晏眠。\n为建清泠三万斛，坐令翠密舞中田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其三","author":"陈造","text":"未明出作夜深归，敢怨今年雨后时。\n岂独旱杷全好在，晚秧不死尚堪移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其二","author":"陈造","text":"共说邦君祷雨时，衋如疾痛切肤肌。\n公心一片秋空月，可但圆通大士知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨口号呈陈守伯固十二首 其一","author":"陈造","text":"旱风虫孽久挻灾，好雨如今陆续来。\n谁道天人不相与，青章解挽帝心回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其十","author":"陈造","text":"平时觞咏妨生理，此去狂疏托上官。\n但使推敲贷冲节，不烦排日报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其九","author":"陈造","text":"禹益咨俞俨紫庭，藩星仍映使星明。\n鄙夫少日三千牍，尽付诗情写治平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其八","author":"陈造","text":"稚子浪忧陶令老，山妻终誉仲卿贤。\n虎头试写经行处，龙具宁甘未死前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其七","author":"陈造","text":"日日烟林野市间，路人应作老狂看。\n排门赏竹宁辞骂，踏雪寻梅苦耐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其六","author":"陈造","text":"兴阑猛辍凌江棹，重看莺花茂苑春。\n归自乘流留亦好，浙风淮俗总宜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其五","author":"陈造","text":"向来勇策著书勋，一刻曾将白璧论。\n老去光阴都不惜，静看乌兔役朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其四","author":"陈造","text":"溪翁园客问何如，可讳浮生百计疏。\n不惮典衣规得酒，长因乞米衒能书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其三","author":"陈造","text":"诸公念我闲无食，粟继舆台扣户频。\n眼底梅花还索笑，酒肠诗胆已轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其二","author":"陈造","text":"官卑责薄得徜徉，漫仕归来味更长。\n它日故人多好事，笼鸡载酒未吾忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓吴门十首 其一","author":"陈造","text":"一寒驱去还干禄，万虑纷然祇爱山。\n阅世恍如清梦觉，求田聊计白头闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"循资赵宰有贺诗次韵三首 其三","author":"陈造","text":"反唇馀子轻玄白，属目耆儒上紫清。\n老境我甘追汗漫，明时君合订章程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]