[{"title":"陈州杂咏 其一","author":"刘攽","text":"历说诸侯七十馀，绝粮桑落尚欢娱。\n不容而后知君子，方笑南冠驾乘驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈州杂咏 其二","author":"刘攽","text":"郑庄推士古无伦，置驿诸郊日日新。\n去病魏公俱改节，一生惆怅杜陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈州杂咏 其三","author":"刘攽","text":"固安功次异萧陈，深怪材官亦致身。\n高卧闭钳天下口，不忧圣主责愚臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄橙寄黄翁","author":"刘攽","text":"江南碧树映霜秋，丹实清香破客愁。\n常恨忌辛消俗口，为评蠲愤诧齐州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将过孔处士庄闻处士往许昌不果往","author":"刘攽","text":"鹿门隐士肯浪出，荷蓧丈人行不逢。\n朝阳昼雨霁复暝，香山无路云重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和原甫谒武信殿 其一","author":"刘攽","text":"紫气东迎太一峰，翠华飞御猎回中。\n玄女授符开上策，河宗献宝告成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和原甫谒武信殿 其二","author":"刘攽","text":"愿借前筹敢决疑，斡回天地耸当时。\n旧传太尉条侯策，今见宣王六月诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望庐山","author":"刘攽","text":"苍山去郭三十里，日暮云收独立时。\n应是尘埃能眯眼，几人曾有望山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王待制绝句 其一","author":"刘攽","text":"病躯何处识君恩，卧地无令四体勤。\n客诵舍人诗句好，几将笔砚一时焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王待制绝句 其二","author":"刘攽","text":"无年何日苏凋瘵，死市空嗟费杖笞。\n旧尹告新应有意，若为閒暇得游嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王待制绝句 其三","author":"刘攽","text":"蔡邕倒屣贵公子，阮籍清谈林下游。\n人事差池不如古，祇将朱墨继为州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄韩玉汝待制 其一","author":"刘攽","text":"南云不到飞狐口，朔雪来从累雁门。\n仗节仍烦凿空使，乘槎径取浊河源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄韩玉汝待制 其二","author":"刘攽","text":"嫖姚不复顾家为，谁谓东山久未归。\n卷耳幸容携婉娈，皇华何啻有光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋尽野次 其一","author":"刘攽","text":"丹椒结子菊花黄，山路秋高草木香。\n日出鸡鸣下乔树，人来犬吠透疏篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋尽野次 其二","author":"刘攽","text":"湖水弥天未觉秋，暂辞鞍马寄扁舟。\n菰蒲无禁鱼无税，谁似溪翁得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄献淮西大哥给事","author":"刘攽","text":"千里提封盛府开，照淮红旆晚徘徊。\n地灵固有壶公旧，时泰不同唐相来。\n韦断陈编占药喜，珠挥新什咏兰陔。\n阿连今羡南飞翼，酒影犹能入寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题古画山水障子","author":"刘攽","text":"应是尘外境，不随陵谷迁。\n江山犹旧日，松柏又千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山水屏","author":"刘攽","text":"吾家古屏来江南，白昼水墨渍烟岚。\n我行北方未尝见，众道巫峡仍湘潭。\n山头老树长参天，水上衰公撑钓船。\n青蓑拥身稚子眠，得鱼不卖心悠然。\n久嫌时世趣向狭，颇思种药依林泉。\n桃源仙家不可到，但愿屏上山水置眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"于秘校示郊园棠木连理图偶题长句","author":"刘攽","text":"昨得伻图与赋诗，野棠并干上交枝。\n始疑和气偏回复，可是常情悦附离。\n爱树去思吾岂敢，高门阴德子应知。\n济南固有终军辨，传布仍烦老画师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壁画古槎歌","author":"刘攽","text":"南山大树枫与樗，百年不到生理枯。\n老枝错落麋奋角，病根蟉结龙垂胡。\n风霜不知春不改，古苔悬蔓相萦带。\n岂知高堂素壁上，画图能令观者爱。\n野夫晨兴坐树边，偶说此槎来上天。\n暂乘西风犯牛斗，却看东海成桑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和江邻几梅圣俞同蔡学士观宋家书画","author":"刘攽","text":"中郎石经天下传，江翁说诗当世贤。\n南昌子真亦禄仕，读书养性希神仙。\n雄豪相遇古莫及，所至衣冠争愿焉。\n贵公子孙谁是胜，广平家书盈万千。\n当时交友皆父行，贾生论议欺老先。\n开门迎客车结辙，而此三士相周旋。\n牙签插架尘土绝，宝轴出囊瑶玉联。\n前秦篆籀颇磨灭，中世粉墨仍新鲜。\n咨嗟古人不可见，但觉能者心意专。\n知音自昔贵一遇，千岁相望犹比肩。\n况有清诗纪实事，豪壮入耳如哀弦。\n鄙夫观书识难字，古文愈野心谓然。\n要当乘兴过君所，刮膜一使头风痊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨寺丞书画","author":"刘攽","text":"杨侯古书数十轴，草隶缺残犹可读。\n古书流传动千岁，书可仿摹古容伪。\n爱君苦心能辨之，等捐千金不为费。\n世尝售名不售真，物可见形难见神。\n重令志士一惆怅，念有遗宝随埃尘。\n东墙西墙画满屋，瑟琶小儿理新曲。\n鄙夫长安交游少，骑马能来与君熟。\n万事好恶我自知，不作浮沈为人更耳目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许州寒食","author":"刘攽","text":"灌婴台畔路憧憧，寒食追游喜退公。\n堤柳媚烟行细绿，野桥横水阵残红。\n鞦韆冷飏梨花雨，蹴鞠高腾燕子风。\n几处笙歌几家哭，却愁回马夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁烟游园","author":"刘攽","text":"寒食风光雨敛尘，病馀寒极强颁春。\n传呼广陌双摇旆，乘兴名园一柅轮。\n列座宾寮皆俊雅，绕池花木尽奇珍。\n长吟浅醉归时晚，蜡炬荧煌改火新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画蟹","author":"刘攽","text":"后蚓智不足，捕鼠功岂具。\n一为丹青录，能使万目顾。\n气凌龟龙蛰，势经沧海渡。\n微物亦有动，将非逢学误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蟹","author":"刘攽","text":"稻熟水波老，霜螯已上罾。\n味尤堪荐酒，香美最宜橙。\n壳薄胭脂染，膏腴琥珀凝。\n情知烹大鼎，何似莫横行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宜城酒","author":"刘攽","text":"九酝宜城酒，人传岘首碑。\n古今情不别，更问习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郢州","author":"刘攽","text":"但见苍山插霄汉，石城古木高崔嵬。\n城头层楼又清绝，尚有遗音名白雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄州淳于髡墓","author":"刘攽","text":"微言动相国，大笑绝冠缨。\n流转有馀智，滑稽全姓名。\n师儒空稷下，衡盖尽南荆。\n赘婿不为辱，旅坟知客卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别茶娇","author":"刘攽","text":"画堂银烛彻宵明，白玉佳人唱渭城。\n唱尽一杯须起舞，关河风月不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔枝 其一","author":"刘攽","text":"南州积炎德，嘉树凌冬绿。\n薰风海上来，丹荔逾夏熟。\n煌煌锦绣林，亭亭翡翠屋。\n鹊头烂晨霞，天酒瑩寒玉。\n流声感中华，采掇如不足。\n开元百马死，汉堠五里促。\n君王玉食间，此荐知不辱。\n迨今糟粕馀，犹足惊凡目。\n忆初成上林，四方会奇木。\n使臣得安榴，天马来首蓿。\n拔芽自幽遐，托地幸渗漉。\n我欲咎真宰，喟兹限荒服。\n将非名实雄，百果为羞缩。\n区区化工意，聊尔存众族。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔枝 其二","author":"刘攽","text":"锦筵火齐砌金柈，五月甘浆破齿寒。\n南国已随朱夏熟，北人犹指画图看。\n烟岚不续丹樱献，玉座空悲羯鼓残。\n相见任誇双蒂美，多情莫唱水晶丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"橄榄","author":"刘攽","text":"南珍富奇异，畴昔颇穷览。\n夷荒无书传，从古陋铅椠。\n苞封走中土，天序异离坎。\n有香已变衰，有色多黯谫。\n今君此堂上，珍物惟橄榄。\n青肤镂琼瑩，翠颗森菡萏。\n若为幽人贞，久见君子淡。\n甘怀彼包羞，日新此刚敢。\n清泉荐芳茗，臭味独潜感。\n澡雪清烦酲，涤除瑩玄览。\n灵均采时菊，西伯嗜昌歜。\n庙鼎实调梅，壮士仍尝胆。\n由来超俗好，诸绝不言惨。\n殷勤谢凡口，薤白空三啖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题招提院静照堂","author":"刘攽","text":"千金买境欲辞喧，长日观心复照昏。\n多少胜缘从静起，为师无意入都门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖诗 其一","author":"刘攽","text":"湖波微涨日初长，水面花香柳绿黄。\n沙鸟喧嘲随笑语，鯈鱼惊跃近舟航。\n春心处处迷芳草，醉眼依依乱夕阳。\n信似习池风物好，偷闲剩醉两三场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖诗 其二","author":"刘攽","text":"一樽芳酒数篇诗，坐待南湖夕景低。\n日照杏花堆火齐，水涵天色湛玻璃。\n静中鱼鸟浑相忘，醉里风光时易迷。\n还有渔舟澹客兴，谁言不似武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颍水作寄陈州诸故人","author":"刘攽","text":"不知颍水清如此，欲比蓬莱似是非。\n察见渊鱼宁有意，往来鸥鸟已忘机。\n济川便乐风波息，洗耳都疑世事违。\n甚悔衡门临沁水，还思冠者试春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏列子","author":"刘攽","text":"禦寇卧郑都，子阳归之粟。\n固辞得无受，妻子怨窘束。\n君非自知我，人事故反覆。\n俛仰未及终，类傌首邦族。\n始知至人心，避荣乃避辱。\n如何当路子，扰扰事干禄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还馆 其一","author":"刘攽","text":"步向端门足力迟，仰瞻双阙隔缡褷。\n三年江海都如梦，老态今朝始自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还馆 其二","author":"刘攽","text":"下马呼人问直庐，归墙因读旧时书。\n黄花绿叶庭槐影，噪雀鸣蝉宛自初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王四馆宿 其一","author":"刘攽","text":"雪残梧竹夜犹寒，春入林花露已团。\n绝境自宜仁者静，寤歌非为硕人宽。\n不眠红烛停俄顷，刻意新书计若干。\n等是前贤游集地，似君尤更觉才难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王四馆宿 其二","author":"刘攽","text":"蓬莱宫阙冠云霓，月出丹渊日堕西。\n和暖时花元有信，黄昏归翼自无迷。\n读书难字存雌蜺，落笔雄辞在碧鸡。\n五十衰年融过二，强颜何计可思齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王四馆宿 其三","author":"刘攽","text":"天星出屈势阑干，五夜传呼禁漏残。\n虎豹深沉九关远，鹪鹩栖息一枝安。\n病亲黄卷怜灯闇，老厌青绫怯岁寒。\n长有江湖未归梦，更将衰白镜中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王四馆宿 其四","author":"刘攽","text":"月白天虚星斗横，夜深高阁势峥嵘。\n怪来耳冷人声绝，会是斋居近太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初秋馆中呈诸公","author":"刘攽","text":"掖垣星宿上清居，金马文章次石渠。\n雨定枫槐含秀爽，秋还楼阁长空虚。\n上知景伯无人事，恩许黄香未见书。\n不奈客嘲聊自解，下流仍复愧应璩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题平山马铺","author":"刘攽","text":"长亭前望势崔嵬，地坼东南宇宙开。\n韦杜去天真五尺，行人新自日边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕","author":"刘攽","text":"烧灯陶永夜，击鼓劝沽酒。\n清月不作霜，微风乍摇柳。\n忽忽车转毂，戢戢人举首。\n欢乐聊及时，与谁论薄厚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王舍人灯夕见寄","author":"刘攽","text":"南陌东城乐赏同，翠华雕辇度香风。\n春催火树无穷外，天压歌声不尽中。\n侍宴君归青琐阁，倦游身作白髯翁。\n凭将酒客鸱夷颂，并谢张松与孟公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕陈大夫来会张承议以病不出有诗赠陈次韵和之","author":"刘攽","text":"千灯光影彻春宵，红日明霞晃绮寮。\n上客欢娱得惊坐，佳人歌笑敌蓝桥。\n雪花带雨尘都埽，寒色兼风酒易消。\n一去章街尽眉妩，臂围犹怯月边朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯夕寄呈张学士","author":"刘攽","text":"东风一雨解萌芽，暖景重城有万家。\n霁后灯光犹妒月，春迟火树却催花。\n数声水调矜遗俗，十里珠帘胜馆娃。\n璧府谪仙归未得，会将骑鹤向人夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三峡桥","author":"刘攽","text":"三峡桥西路不通，水深石怪自蟠龙。\n一闻马足皆惊起，倏忽云遮五老峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄荆公","author":"刘攽","text":"青苗助役两妨农，天下嗷嗷怨相公。\n惟有蝗虫偏感德，又随台旆过江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长芦寺","author":"刘攽","text":"越舶吴商倚万桡，绀园金刹起中宵。\n鱼龙听法多因雨，江海归心每上潮。\n林黑夜深灯影白，川平天阔梵声遥。\n心知水怪俱调伏，惜取灵犀不用烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"刘攽","text":"寒食年年必上公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"刘攽","text":"泻汤夺得茶三昧，觅诗还窥诗一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"刘攽","text":"山形雄北固，江势逼东渐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"刘攽","text":"秋高千里月，暮景一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"刘攽","text":"岘首习池屡能到，大堤花艳一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"刘攽","text":"王师破金陵，兵自水窗入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"刘攽","text":"不负兴公遂初赋，更传中散绝交书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"刘攽","text":"秋桐不识春风面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十四","author":"刘攽","text":"君为逍遥游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"刘攽","text":"怀人棠蔽芾，招隐桂窅窊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"刘攽","text":"炎日似流金，火云如匹绛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十七","author":"刘攽","text":"解愠薰南风，截雨横东虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题处州直厅壁","author":"李观","text":"十谒朱门九不开，利名渊薮且徘徊。\n自知不是公侯骨，夜夜江山入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父二首 其一","author":"李观","text":"八月九月芦花飞，南溪老人垂钓归。\n秋山入帘翠滴滴，野艇倚槛云依依。\n却把鱼竿寻小径，閒梳鹤发对斜晖。\n翻嫌四皓曾多事，出为储王定是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父二首 其二","author":"李观","text":"村寺钟声渡远滩，半轮残月落前山。\n徐徐拨棹却归湾，浪叠朝霞锦绣翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东湖","author":"李观","text":"万象城东雅入诗，半湖云霭捲残晖。\n老龙惜雨慵离蛰，迷鹭逢人惯不飞。\n岸僻自宜安钓石，水清谁碍濯尘衣。\n使君公退便游此，却恐吾皇急诏归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题翠微亭","author":"李观","text":"竹根穿石嘴，松影入泉心。\n不致玄玄处，白云徒自深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出宰清江省亲秀水","author":"李观","text":"天阙抵清江，萍泛七千里。\n心目驻庭闱，恍如寻尺耳。\n河伯念微衷，风师荐嘉祉。\n澄澜协顺飙，天际堪屈指。\n归欤膝下欢，奚独老莱子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]