[{"title":"食生荔子五首 其二","author":"周紫芝","text":"著枝犹有露华腴，谁把红纱罩玉肤。\n龙眼也随君并熟，一生空作荔枝奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食生荔子五首 其三","author":"周紫芝","text":"小队将军过五溪，相看犹作梦中疑。\n回头欲问罨摩勒，乞得微甘是几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食生荔子五首 其四","author":"周紫芝","text":"瘴岭蛮村万里赊，可怜生不近京华。\n荔枝犹想南中树，末利先看近世花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食生荔子五首 其五","author":"周紫芝","text":"东来坐见玉肌丰，识面中郎旧谱中。\n绝胜诗翁红万颗，暮年流落到泸戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共见和前诗次韵为谢 其一","author":"周紫芝","text":"当日梨园寿太真，荔枝香曲赐名新。\n麻姑萼绿双回袖，舞彻遥知不动尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共见和前诗次韵为谢 其二","author":"周紫芝","text":"禁中分赐尽甘腴，旋琢壶冰积雪肤。\n闻道风流黄阁老，长须遗送玉川奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共见和前诗次韵为谢 其三","author":"周紫芝","text":"人把江瑶比荔枝，枇杷楟奈更何疑。\n桄榔叶外和烟树，想得青红半熟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共见和前诗次韵为谢 其四","author":"周紫芝","text":"樽前风味要人誇，瘴雨蛮烟度岁华。\n乞得水晶三百颗，绉红时看眼生花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共见和前诗次韵为谢 其五","author":"周紫芝","text":"雾縠囊悬小树红，芳香应入笑谈中。\n世间绝韵须真赏，人物当先数阿戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共闻余赋五诗犹未之见以三诗见索因次其韵 其一","author":"周紫芝","text":"闽岭今年荔子迟，生枝入眼可无诗。\n诵君胜句须衔璧，老将何由更出奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共闻余赋五诗犹未之见以三诗见索因次其韵 其二","author":"周紫芝","text":"梦对清樽看玉山，荔枝空嚼水中寒。\n心知不与公同味，始信人生一笑难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共闻余赋五诗犹未之见以三诗见索因次其韵 其三","author":"周紫芝","text":"杨梅卢橘自成双，敢与冰纨作雁行。\n莫怪老翁频著句，书生说食是膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"米元晖待制岁以赐冰及荔子分遗季共而今年荔枝不至有诗次韵三首 其一","author":"周紫芝","text":"诗老盟成恐未寒，今年荔子不同餐。\n空排白玉千峰雪，却忆红砂九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"米元晖待制岁以赐冰及荔子分遗季共而今年荔枝不至有诗次韵三首 其二","author":"周紫芝","text":"销得銮坡荔子香，玉郎言语似君房。\n金盘何日分新果，五线先看补舜裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"米元晖待制岁以赐冰及荔子分遗季共而今年荔枝不至有诗次韵三首 其三","author":"周紫芝","text":"醉墨犹多御府珍，访求公后出华勋。\n知君家有荔枝帖，不减当年王右军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢陈仲襄主簿惠诗卷","author":"周紫芝","text":"霜雪频欺老，芝兰日斗芳。\n官犹似仇览，句拟学韦郎。\n郊岛无前辈，曹刘可雁行。\n他年尚相见，此地必升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李太白画像二首 其一","author":"周紫芝","text":"欲与天仙论等差，短长何止但词华。\n谁人解屈将军手，为脱乌皮六缝靴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李太白画像二首 其二","author":"周紫芝","text":"少陵诗瘦平生苦，太白才高一醉间。\n投得江心波底月，却归天上玉归仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共置酒酒间出龙眠数马以示坐客最后出起云妙甚为赋长句","author":"周紫芝","text":"君侯酌客黄金杯，六龙下食慈明催。\n醉开画苑出天马，远自大宛西极来。\n起云礧碨最后出，真龙八尺高崔嵬。\n青天欲雨雨未作，怒云泼墨乌成堆。\n长鸣自怪两耳立，路转欲从双镫回。\n王良造父眼未识，骅骝骕骦天与才。\n朝从燕代暮南粤，万里一息何辽哉。\n公今此画何处得，外家中郎李公客。\n人间英物有护持，世上丹青少颜色。\n双花蜀锦青丝囊，还公此画公须藏。\n天寒夜半黑风起，邂逅恐逐飞云翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩干画郭家师子花此画本江南故家物自腕而下绢素烂脱李伯时得之马忠肃家补足之蔡天启貌本以传其甥王季共","author":"周紫芝","text":"神驹堕地无渥洼，象龙不复来流沙。\n开元画手老韩干，为作郭家师子花。\n当年故物不堪看，踣铁四蹄俱脱腕。\n英姿逸态犹精神，仿佛风鬃血流汗。\n龙眠画足不画蛇，意象异世同一家。\n由来四大各假合，得此三昧无等差。\n中郎名高自年少，画工如山不同调。\n人间意气惊薾云，笔下风流尔得妙。\n王家人物小安丰，作诗论画公所同。\n一洗万古凡马空，九原谁唤杜陵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共以师子花见借作诗归之而报甚宠且言隆近为余作数马奇甚乃作此诗以见愿借之意","author":"周紫芝","text":"画史俗士非画者，支郎好马能画马。\n为君肯作数骅骝，班郎应歌天马下。\n前人妙笔俱绝伦，后人骨冷唤不闻。\n试借云衢千里足，洗我眼中凡马群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季共以隆师四马见示后三日作长句以归之","author":"周紫芝","text":"少陵说马谁擅场，老韩曹霸江都王。\n只今传法谁得妙，支郎为爇龙眠香。\n沙平草细春日长，何人识此真乘黄。\n归君蓬斋君卷藏，似君千里方腾骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之木犀六首 其一","author":"周紫芝","text":"拂色青衫不是妆，蕊珠宫里淡鹅黄。\n紫罗裳亦元无用，薝卜花应自有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之木犀六首 其二","author":"周紫芝","text":"高树层阴作翠云，月华霜晕醒馀薰。\n人间韵少花俱俗，天上香来世未闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之木犀六首 其三","author":"周紫芝","text":"西湖南北两边山，牢落孤芳不奈闲。\n好遣长须挽黄粟，付他桃叶伴云鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之木犀六首 其四","author":"周紫芝","text":"故国幽姿想自妍，只今谁与著诗怜。\n竹篱茅舍花开处，望断江西眼欲穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之木犀六首 其五","author":"周紫芝","text":"留香欲住正须阴，远引山林却要侵。\n绝韵有谁能画得，郎潜诗妙最知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之木犀六首 其六","author":"周紫芝","text":"玉折兰摧事已休，倡条无数绿阴稠。\n此花独与苍岩桂，风雨平分万壑秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吕晞朴九日见示","author":"周紫芝","text":"敢乞兰金作诏泥，年今已是古来稀。\n一天细雨家何在，十载黄花客未归。\n万事可怜俱老境，故人犹欲借馀晖。\n但当洗眼秋风里，饱看云鹏作意飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈簿席上见和","author":"周紫芝","text":"黄鹄摩霄未易知，倦飞寒雀本来卑。\n颇惭陶令归田早，政坐穰侯见事迟。\n偶有酒供鸲鹆舞，苦无人唱鹧鸪词。\n秋来湖上山方好，食蛤重为汗漫期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"河伯小史白事歌","author":"周紫芝","text":"冯夷宫中地无土，五更排衙朝击鼓。\n大官拥旆呵马归，小史白事当前语。\n自言赋命颇奇穷，一生自足风波苦。\n船须把缆始敢放，雾可藏身亦时吐。\n防危虑患岂不至，往往不知遭网罟。\n河神笑谓小史言，祸福不计愚与奸。\n恢恢天网自不失，琐琐尔曹何足论。\n小史速退卷舌走，顾视俦列图前奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"峡守秦德久楚塞楼成索诗为作长句异时鲁直迁涪江过之命此名且书牍今亡矣二首 其一","author":"周紫芝","text":"使君才气号无双，千骑新来绾汉章。\n此日楼台新楚塞，当年翰墨记黄香。\n民安乐岁州何事，江入清樽客满床。\n十二巫山应在眼，定无遗事说襄王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"峡守秦德久楚塞楼成索诗为作长句异时鲁直迁涪江过之命此名且书牍今亡矣二首 其二","author":"周紫芝","text":"淮上声名彻冕旒，几年边鼓卧清秋。\n五花未从甘泉驾，百尺聊新楚塞楼。\n暮雨已随烟佩去，长江空抱峡山流。\n客来欲吐窗闲句，莫把城南比阆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题苏养直画像三首 其一","author":"周紫芝","text":"先生初出后湖时，日落山寒醉不知。\n更上蹇驴何处去，灞桥风雪要渠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题苏养直画像三首 其二","author":"周紫芝","text":"名满人间未足多，胸中万顷著烟波。\n松江风月无人见，谁与玄真画钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题苏养直画像三首 其三","author":"周紫芝","text":"水上柴扉闭不开，苍山羔雁九天来。\n玉京已有神仙籍，莫怪青山唤不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月九日霁色可喜三首 其一","author":"周紫芝","text":"屋角梅花欲弄晴，耐寒庭草尚晶瑩。\n护霜云重知何事，留得芭蕉作雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月九日霁色可喜三首 其二","author":"周紫芝","text":"朱门深闭得香多，晓日烘帘气自和。\n此地有窗无一席，固应宜著病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月九日霁色可喜三首 其三","author":"周紫芝","text":"江上南枝暖欲妍，小春时节又经年。\n谁知一点还乡梦，直到梅花树子边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共蓬斋新梅","author":"周紫芝","text":"王郎巧催花，妙语起槁枯。\n譬如返魂香，能使死者苏。\n诗成花亦开，小草时卷舒。\n颇如风前柳，胜韵花中无。\n蓬斋姑射仙，不待折简呼。\n芳姿倚醉玉，未用须人扶。\n自君作周旋，此德良不孤。\n移根始山中，一笑烦王都。\n坐令桃李花，浅俗皆凡夫。\n棐几滑以净，云窗窈而虚。\n酽白夺寒雪，软红空九衢。\n我久离山中，问花今何如。\n殷勤培弱干，何日课獠奴。\n于花苟得计，于我亦何愚。\n此意倘复遂，瘦地良可锄。\n诵君种花句，抚卷长嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻朱虚真请老二首 其一","author":"周紫芝","text":"平生恨未识朱游，每得清诗慰客愁。\n泛宅清苕真得句，挂冠神武更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻朱虚真请老二首 其二","author":"周紫芝","text":"久厌朱袍裹玉仙，幅巾藜杖老山间。\n从今鱼鸟缘应熟，只恐鸳鸯债未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵范元卿题友山堂","author":"周紫芝","text":"人间南北无同异，四海苍生俱一世。\n借令卖友取封侯，一掷成卢亦儿戏。\n东平风度人所难，不将白眼看青山。\n少年结客知无益，老唤南山相与闲。\n人情自是有新故，相好乃能保朝暮。\n故人落井已下石，红袖弹筝未移柱。\n玉峦排秀天清明，乱峰入眼心先倾。\n向来刎颈或蹀血，此地一笑终忘形。\n平生爱山心愿见，喜色津津应满面。\n宁愁偃蹇不受招，一鹗孤飞谁可见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无住庵主为余写真报之以诗","author":"周紫芝","text":"骅骝固绝足，韩干真画者。\n傥欲万口传，当画千里马。\n吾才如跛鳖，子不解腾跨。\n初无籋云姿，何劳人摹写。\n支郎妙人物，名声遍日下。\n事苟不当急，操笔有用舍。\n一逢菘韭翁，终安陋朴野。\n无盐元自丑，强欲相纷赭。\n至技不可名，厚意徒久假。\n我欲报之诗，有作非大雅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤山之颠旧有开氏四照阁次年部使者献西湖图神庙阅图久之问开氏四照阁安在部使者失对其知名如此昨跋马过下山见赭衣荷锸数百人问之则军中藏冰于此也","author":"周紫芝","text":"出头杰阁想峥嵘，当日佳名达裕陵。\n岂料生存华屋处，将军于此窖寒冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵相之见过口占雪中新句且许约季共携山谷书伯时画过敝庐","author":"周紫芝","text":"寒欺玉树雪横斜，遥想诸郎拟玉华。\n更借蟾蜍千里月，细看薝卜一林花。\n公名已在曹刘上，我辈裁堪屈宋衙。\n闻道高轩开二妙，竹坡犹有雪煎茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共和相之前作二首 其一","author":"周紫芝","text":"谁从玉阙蓬莱殿，吹下仙人萼绿华。\n风急有时翻柳絮，月寒无数著梅花。\n时开病眼看三径，胜着青衫趁两衙。\n欲煮南屏山下雪，问谁能点老谦茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共和相之前作二首 其二","author":"周紫芝","text":"雪意鬖鬖整复斜，似人霜鬓不胜华。\n只今瘦骨攲风帽，空忆寒江钓浪花。\n妙舞正看回激楚，两峰旋欲战彭衙。\n不将盐絮轻相比，似我南窗玉色茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题强常州乌墩新作濯缨亭二首 其一","author":"周紫芝","text":"使君如冰壶，不受古俗尘。\n何为解豸冠，濯发天地津。\n开门纳沧波，自与云水亲。\n知谁分清流，照此千载人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题强常州乌墩新作濯缨亭二首 其二","author":"周紫芝","text":"濯缨须沧浪，弹冠必新沐。\n昏昏不可受，皓皓亦易辱。\n借令困一尘，未易涴冰玉。\n勿从渔父谈，恐自成窘束。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送孙求仁官黄冈","author":"周紫芝","text":"黄冈古淮邦，其大不如斗。\n谁知隔岸山，万马日奔走。\n有数着诗人，此地实林薮。\n顷来当盛年，王公号贤守。\n三年江上杯，快饮竹楼酒。\n东坡营雪堂，始种坡前柳。\n至今有遗迹，过者为回首。\n后来老门生，词翰玉堂手。\n谪官茅三间，门巷无鸡狗。\n孙郎饱文艺，贫病亦已久。\n着履知有土，捉衿乃见肘。\n抱经官残州，一饱亦难偶。\n论文有馀日，为我访白叟。\n遗事倘可书，尚足寄衰朽。\n慎勿止寒温，作书问安否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢吴司户寄舂陵四石 其一","author":"周紫芝","text":"何年山崭岩，化作龙起伏。\n安得挽天河，著龙吐飞瀑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢吴司户寄舂陵四石 其二","author":"周紫芝","text":"往穴城南窗，分山得遥碧。\n谁持列玉峰，来照蜗牛席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢吴司户寄舂陵四石 其三","author":"周紫芝","text":"吴山非不佳，故山终眼明。\n南来一拳石，似我小峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢吴司户寄舂陵四石 其四","author":"周紫芝","text":"孤峰真崛奇，凝目见太古。\n便悲江上山，培塿不足数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共蓬斋夜坐三首 其一","author":"周紫芝","text":"幽人怀故乡，夜坐听秋雨。\n耿耿不成寐，悽悽亦良苦。\n酒白应自斟，茶甘为谁煮。\n喜意入寒灯，诗成看花吐。\n乐饥焰短檠，玉虫缀钗股。\n当亦念衰翁，秋风卧何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共蓬斋夜坐三首 其二","author":"周紫芝","text":"寒斋秋意高，夜久群籁息。\n眼前无一尘，谁与共此席。\n平生乐虚旷，颇怪言不食。\n遥知高世意，仰面看屋脊。\n秋虫曾何知，悲鸣乱胸臆。\n君亦意不眠，佳月良可惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共蓬斋夜坐三首 其三","author":"周紫芝","text":"露井飞彫梧，碧月借秋色。\n颇闻遭鼠辈，恼睡成反侧。\n君岂劾鼠手，姑缓藁街磔。\n我亦见事惯，流年反多历。\n谁能与此物，更较胜负敌。\n一笑谓狸奴，无乃尔不职。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读韦庄浣花集戏题二诗 其一","author":"周紫芝","text":"春风吹绉一池波，付与蛾眉席上歌。\n试倩韦郎追正始，风流犹不似元和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读韦庄浣花集戏题二诗 其二","author":"周紫芝","text":"晚唐风月一番新，弄粉调膏点注匀。\n谁与花材诗宰相，聘将花蕊作夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"相之季共各携李伯时画轴见过分韵得人字","author":"周紫芝","text":"人生不相知，白头反如新。\n知心不在久，觌面还成亲。\n况我五安师，二妙俱可人。\n元龙百尺楼，人物谁与邻。\n风流小安丰，玉树高嶙峋。\n联翩两竹舆，访我南坡春。\n遂遣小叔雅，娱此照坐宾。\n王春三月雨，浸浸如游尘。\n是日天为喜，霁色明清晨。\n各携古锦囊，共出画苑珍。\n太邱重千载，高标澹风神。\n丹铅表丘壑，制度殊冠巾。\n渊明撷秋菊，醉面玉色匀。\n龙眠赋远游，濯发天池滨。\n二老不并世，异世真同论。\n当年天厩马，调御皆服驯。\n绝域来象龙，地行俱麒麟。\n老眼阅神骏，摩挲得逡巡。\n客意亦复悦，领我杯中醇。\n尚苦江夏帖，入我幽梦频。\n倒箧倘有意，叩门君勿嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文若自华亭携家来游西湖袖出新诗其归乃和前篇聊以当别","author":"周紫芝","text":"黄郎满袖出新诗，别后篇章欲造微。\n老骥但含千里意，翔鸾还带九雏归。\n如君好事真前辈，笑我为生尽昨非。\n小别不堪频作恶，灞桥杨柳亦依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵林察院贺章正言得子","author":"周紫芝","text":"海中仙果著新枝，可是香山得子迟。\n雏凤远从丹穴至，神驹初出渥洼时。\n平生种德无遗恨，他日传家有是儿。\n闻道长庚曾入梦，已应能作上楼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]