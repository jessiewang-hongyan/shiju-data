[{"title":"舟次卷雪楼四首 其一","author":"陶梦桂","text":"簿书期会不相关，老眼如何不得闲。\n景物无端故勾引，淮山尽处又庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀帅书黄先生余时次万安先生开阁九江檄莫底","author":"陶梦桂","text":"碧落班中出镇时，红莲幕里我栖迟。\n四年两地无消息，好倩西风为寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸平亲郊八首 其二 皇帝升降用《隆安》","author":"郊庙朝会歌辞","text":"礼备乐成，乾健天行。\n帝容有穆，佩玉锵鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李","author":"陶梦桂","text":"仙李栽培旧满门，归来仅有一株存。\n年年碧实和烟摘，老子未尝先乞孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤松","author":"陶梦桂","text":"傲睨风霜老更臞，旁边著我未为孤。\n向来元亮盘桓后，试问曾逢我辈无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦竹","author":"陶梦桂","text":"住近幽人善卜邻，少陵诗句岂虚文。\n平生清苦过于我，祇合呼为苦节君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金灯花","author":"陶梦桂","text":"紫磨真金百炼成，花神妆点似灯明。\n胆瓶盛取当书案，白首韩公对短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柘","author":"陶梦桂","text":"老矣能消几许衣，一株休论几钩丝。\n垂杨舞彻莺歌歇，且看东风舞柘枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种梅","author":"陶梦桂","text":"矮窗元向竹边开，竹已森然只欠梅。\n新种一株花尚少，暗香早逐细风来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九与坚大师登坟庵新阁因忆癸巳岁此日同在益昌道中行役之劳遂成一绝","author":"陶梦桂","text":"茱萸笑把登高阁，菊蕊才堪荐一觞。\n却忆当年关表路，无花无酒更凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重次龚子辉平塘韵三首 其三","author":"陶梦桂","text":"家园指拟似淇园，惜笋兼存上下番。\n若与此君情分薄，应无风月到吾门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重次龚子辉平塘韵三首 其二","author":"陶梦桂","text":"白发多时精力少，绿樽疏后简编亲。\n本无世上荣华分，莫作山间懒惰人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重次龚子辉平塘韵三首 其一","author":"陶梦桂","text":"梦觉归来涉旧园，共寻幽事有梅仙。\n乍穿绿竹教成径，莫踏苍苔破却钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃","author":"陶梦桂","text":"谁从王母觅来栽，等得花开结子来。\n我种数株能几久，有花如锦子如杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桑","author":"陶梦桂","text":"密叶柔条绿更腴，几年培植费工夫。\n牡丹剩费医治力，曾有丝毫利益无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梧桐","author":"陶梦桂","text":"妆点山居要碧梧，向来培植费工夫。\n一株随风成仙去，留得孙枝乞凤雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登胡氏楼 其一","author":"陶梦桂","text":"草际露华白，天边云浪开。\n好风何处起，和月入帘来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登胡氏楼 其二","author":"陶梦桂","text":"水将罗带绕，山展画图开。\n二十年前客，身闲又此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀五首 其五","author":"陶梦桂","text":"每忆间关离陷阱，一年剡壁一番新。\n虽无毫髦私于己，岂有涓埃及得人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀五首 其四","author":"陶梦桂","text":"心力较衰于少日，园池差胜似前原。\n畦蔬绕舍苔侵径，棘刺编篱竹打门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀五首 其三","author":"陶梦桂","text":"佐岳归来得自如，依然服色似芙蕖。\n儿童痴绝牵衣问，腰下如何不见鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀五首 其二","author":"陶梦桂","text":"忆昔身章两度新，庭闱恨不拜双亲。\n虽然累赠光泉壤，还是酬恩未了人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀五首 其一","author":"陶梦桂","text":"记得当年宴杏园，旁人尽道似神仙。\n全家自此废耕织，枉费公家多少钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"稚梅","author":"陶梦桂","text":"更好轩中几报春，幽人去后化为薪。\n向来花在孙枝上，一笑相看似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩兴","author":"陶梦桂","text":"图书丛里清癯老，山水光中潇洒家。\n除却栽花栽竹外，更将何事作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠神眼相士","author":"陶梦桂","text":"边檄烟尘日涨天，天教老病唤归田。\n从君试问平塘水，更照衰容得几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠眼科舒医士","author":"陶梦桂","text":"此老年来医有灵，病眸才洗便增明。\n教侬还尽读书债，头白依然对短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登江湖伟观矩堂董先生时帅九江慰劳甚至","author":"陶梦桂","text":"琵琶亭下北风狂，浩荡江天接大荒。\n亟舍扁舟登伟观，旋呼官酒作重阳。\n故人一见惊头白，寒菊新开满眼黄。\n底用四弦如裂帛，异乡游览自悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十三夜月","author":"陶梦桂","text":"人情何待十分圆，满目金波已浩然。\n明到杜陵头上发，寒侵郑老客中毡。\n中秋未必似今夕，好景其如又隔年。\n多谢望舒知此意，冰轮缓碾不加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与弓王二尉谈诗二首 其二","author":"陶梦桂","text":"雀罗门巷驻高车，霭霭停云满眼时。\n惟有故情来得得，却搜诗句步迟迟。\n北窗不放渊明卧，南涧同看子厚诗。\n要识吾侪长久处，此心如月镇相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与弓王二尉谈诗二首 其一","author":"陶梦桂","text":"从来造物只儿嬉，用舍行藏各一时。\n玉兔金乌元去速，晓猿夜鹤怪归迟。\n幸然三径菊如旧，且与两梅仙说诗。\n试问钓车茶具外，当时谁予伴天随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"陶梦桂","text":"明时容我老山林，病骨那禁岁月侵。\n破屋仅存容膝地，短檠唤起读书心。\n三生习气磨难尽，一饷荣华去莫寻。\n苦学吟诗终不近，信知前辈用工深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示次儿柔中出赘","author":"陶梦桂","text":"诲汝汝知乎，家贫乃赘居。\n奉身须节约，接物要谦虚。\n勿以清樽污，而于黄卷疏。\n只须铭此语，一任命何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"记初第时赠相士诗","author":"陶梦桂","text":"觅得荷衣亦偶然，三壬三甲莫虚传。\n知无皂盖朱幡分，奈有清泉白石缘。\n今日为贫行作吏，他时有路即归田。\n头颅自断祇如许，但问闲居得几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先茔之左得生圹喜而示儿","author":"陶梦桂","text":"鼓楼冈上旧坟头，又有山灵献寝邱。\n万里归来生处乐，一心甘向死前休。\n尽捐世事兼家事，但把嬉游当宦游。\n粝饭藜羹而办得，吾衰此外更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次弓天锡送胡儒文韵","author":"陶梦桂","text":"不论朝市与山林，两鬓难禁白发侵。\n物外休论天下事，书中要见古人心。\n老来酒债浑无有，公等诗名尽可寻。\n吟料从来无尽藏，江湖万里水云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵二首 其二","author":"陶梦桂","text":"平塘古木带馀霞，清荫周遭水四涯。\n在世能消几两屐，恼人无奈四时花。\n好随彩笔题诗句，笑入青帘卖酒家。\n却忆当年杜陵老，有谁相伴醉长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵二首 其一","author":"陶梦桂","text":"倦倚栏杆对暮霞，展君吟卷喜无涯。\n圆如掌上黄金弹，清比梅梢白玉花。\n试问山林无我辈，却将景物付谁家。\n风檐把玩徘徊久，烟在平林月在沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵友人","author":"陶梦桂","text":"只将梦幻视浮生，志念俱消岂复增。\n竹杖芒鞋轻胜马，布衣蔬饭淡于僧。\n睡魔为祟勤呼茗，病眼羞明懒近灯。\n好把金鎞轻掠削，近来知有阿谁能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵毛幼声","author":"陶梦桂","text":"人生自得即逍遥，到底声名不用高。\n心地一朝收汗马，泰山万仞等秋毫。\n处囊脱颖君非晚，为米折腰余惮劳。\n喜得新诗当文选，何须痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王衡甫","author":"陶梦桂","text":"野径溪桥取次行，山青水秀眼增明。\n身居尘外年年健，心到灰时事事轻。\n文阵挥戈吾退舍，诗坛歃血子同盟。\n直将修月拿云手，拾得人间句见成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同舟诸丈","author":"陶梦桂","text":"古岸留云色，晴江老日华。\n捉船人上水，挝鼓客还家。\n已自身如叶，何堪眼更花。\n摇摇强招饮，茅店酒旗斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张彦谟","author":"陶梦桂","text":"沧海张公子，秋来会面稀。\n携诗晓相访，话旧夜忘归。\n德劭吾身润，道行天下肥。\n穷通都莫问，一炷篆烟微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汪子与","author":"陶梦桂","text":"生来骨相不如人，那更心空似此君。\n一见好书惟恐尽，每逢佳客怕言分。\n自知原宪贫非病，莫问琴张达是闻。\n吟罢不知身已老，莫教万里净无云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汪山园 其二","author":"陶梦桂","text":"急雨声中夜漏长，晓来嫩水涨平塘。\n试扶竹杖穿三径，自折梅花荐一觞。\n我纵撚须难得句，君才开口便成章。\n偃旗仆鼓退三舍，且逊元戎十乘行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汪山园 其一","author":"陶梦桂","text":"泉石相干兴味长，梦魂飞不到钱塘。\n病来弘景难忘药，老去渊明不御觞。\n旧馆溪山勤检校，新收风月懒平章。\n读书事业依然在，一目犹惭不十行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵良佐","author":"陶梦桂","text":"回也逍遥只寓言，参乎三省道真传。\n明知荣悴何由我，谁道修为亦属天。\n朝市山林皆寄耳，简编灯火故依然。\n穷年矻矻人休讶，山宅臞儒便是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵良佐歇心歌三首 其三","author":"陶梦桂","text":"鸟窠看了看蜂窠，才上坡来又下坡。\n松竹径中逢野老，芰荷香里唱渔歌。\n归来不见香风改，老去何愁明月多。\n况有句文供布施，僧来也唤作檀那。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵良佐歇心歌三首 其二","author":"陶梦桂","text":"随意栽培花几窠，梅坡安稳即銮坡。\n土尊岂胜茅柴酒，法曲何如欸乃歌。\n著意事无虚事有，快行时少坐时多。\n闲身散诞休惊去，尘世光阴等刹那。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵良佐歇心歌三首 其一","author":"陶梦桂","text":"一生受用燕营窠，百岁光阴马驻坡。\n晚境喜无干己事，故人远寄歇心歌。\n君开经卷尘缘了，我辟山林诗料多。\n得句却愁成绮语，何如一意向禅那。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵龚子辉","author":"陶梦桂","text":"身计平生尽付天，归来环堵更萧然。\n君于客里怀新绂，我愧斋中祇旧毡。\n一见便论千古事，定教迟了十馀年。\n驽骀强欲追高躅，病骨摧颓怕受鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵粲上人","author":"陶梦桂","text":"飞锡来寻避俗翁，不辞劈面受霜风。\n因君发被诗催白，知我颜须借酒红。\n秀谷几年千里隔，空寮今夕一灯同。\n恨无日暮碧云句，编入文通杂绶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵德脩弟","author":"陶梦桂","text":"一笑相逢在眼前，底须尺素付邮传。\n池塘生草寻残梦，风雨连床了宿缘。\n遮暮雪霜侵两鬓，倚云梨枣出丹田。\n从今不愿重分手，粝饭团栾满百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵德脩弟","author":"陶梦桂","text":"自古贤名隐魏亭，老夫底用更专城。\n得闲且看云来往，不饮休论酒浊清。\n险阻备尝知世味，消磨不尽是诗情。\n西堂不作惠连梦，共听茅檐夜雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约客","author":"陶梦桂","text":"家在青山绿水间，柴门虽设亦常关。\n稠花浪蕊随时有，乐事赏心从古悭。\n世上人多为物役，眼前谁肯掣身还。\n君能不负平生约，袖有新诗慰病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自述","author":"陶梦桂","text":"每与溪山对，自然怀抱开。\n不愁明日事，何用即时杯。\n一任头如雪，孤眠鼻有雷。\n早间巾履润，池上看鱼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陶梦桂","text":"桂花香处麝脐破，枫叶丹时锦帐开。\n天遣年华随水去，山将野色入帘来。\n镊残白发愁无迹，割尽黄云酒有材。\n不负小园佳景致，乘闲与客共徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"极高明楼饮散次韵二首 其二","author":"陶梦桂","text":"江练紧缠山脚白，露珠密簇草头明。\n一天秋意凄凉甚，几日西风酝造成。\n新月光中新雁过，暮云深处暮钟鸣。\n得君吟卷呼儿读，吹竹弹丝无此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"极高明楼饮散次韵二首 其一","author":"陶梦桂","text":"有景可观无远近，新楼真是极高明。\n水因雨过多新进，枫到年来独老成。\n万顷烟波鱼得计，一天风月雁能鸣。\n醉馀客散清愁入，嘹亮渔舟笛数声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"良佐留别诗颇悽惋次韵叙闲居之乐以释之二首 其二","author":"陶梦桂","text":"腾腾晓日夕还沉，浅浅秋江春又深。\n消息既知由造化，忧愁那得到山林。\n已吟有兴犹重和，未醉开樽任满斟。\n浮利浮名都莫问，只将诗酒送光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"良佐留别诗颇悽惋次韵叙闲居之乐以释之二首 其一","author":"陶梦桂","text":"困人天气昼沉沉，饭罢茶瓯尽放深。\n笑领故人游竹洞，因寻诗句到梅林。\n已教儿去将诗写，又唤孙来把酒斟。\n行乐既知明日少，合如吾祖惜分阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳楼","author":"陶梦桂","text":"朱栏独倚晚天晴，唤起江湖万里情。\n风撼君山波浩荡，云归衡岳月分明。\n飘飘杜老乘槎兴，杳杳轩皇奏乐声。\n好把天瓢盛此水，涤除旱魃作秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青山夹","author":"陶梦桂","text":"天宇秋来淡，江流急处鸣。\n小风旗脚活，晴日鼓声清。\n岁晚冬归客，时危北望情。\n沿江十万户，流寓若为生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追次前韵","author":"陶梦桂","text":"清泉白石故依然，俚语当时已浪传。\n千里归来寻旧约，一生鞅掌任前缘。\n身强只欠登山屐，老去何须负郭田。\n金石旧交半沦谢，新松嫩竹是忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送坚大师往云盖兼简隆老","author":"陶梦桂","text":"梅月廉纤雨，麦秋清润天。\n几程云盖路，一叶石山船。\n瓦砾犹能说，葫芦自去缠。\n到时应问我，为道只高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范之侄谒留守别先生","author":"陶梦桂","text":"不待吹嘘送上天，凌云意气自飘然。\n长江秋色将征旆，半夜霜威袭客毡。\n淝水功名须尔力，斜川风月了吾年。\n师门念旧如相问，为道衰颓怕着鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡上人游浙","author":"陶梦桂","text":"大别山头访早梅，梅边邂逅笑颜开。\n十年一梦看看老，万水千山得得来。\n马祖话中心即佛，卢能偈里镜非台。\n即今了却此公案，便是公门及第回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送饶守万仲衡葬次山园韵","author":"陶梦桂","text":"尘埃满面雪蒙头，只合沧洲把钓钩。\n乡里故人今日少，山川英气一时收。\n绝怜逝者成千古，谁念凄其老一邱。\n野店相逢聊举酒，潸然苦泪落瓷瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送敞上人游湖湘","author":"陶梦桂","text":"分手仍携手，南昌更武昌。\n细论文畅序，重忆赞公房。\n衡岳云如故，曹溪水更香。\n不须论远近，秋尽却还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]