[{"title":"南都二月二日忆杭州去岁之游","author":"强至","text":"去岁江头对此辰，花边弄笔咏青春。\n异乡愁绪还随客，今日风光不著人。\n蹭蹬宦名侵绿发，飘飖生理托洪钧。\n湖堤草软辜游屐，空踏平台陌上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客有貌吾陋容者以诗谢之","author":"强至","text":"野姿瘦骨逼吾真，处士毫端合有神。\n正色未尝移势位，苦吟自觉远风尘。\n渐惊老态侵双鬓，犹逐时名系一身。\n可是封侯须燕颔，恨无勋业上麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将渡扬子风雨忽作","author":"强至","text":"南徐景物古愁人，薄宦扁舟更水滨。\n不识浊醪倾北固，独随寒雨出西津。\n连天风浪声兼厉，当路鼋鼍气亦振。\n吾道屈伸非一日，世情未要责江神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庭前梨桃二花方盛为暴风所吹感事成篇","author":"强至","text":"梨白桃红才可嘉，风前乱雪趁残霞。\n提壶有口只唤酒，鸣鴂何心专妒花。\n九陌乐游非往昔，五陵豪气漫尘沙。\n清樽倒尽却兴感，席上馀春天畔家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"待次陛对已再见春感怀成篇","author":"强至","text":"旅食一朝还一朝，紫宸前对转迢迢。\n青云事业应全误，绿发光阴已半销。\n始爱古人轻禄仕，拟将生理付渔樵。\n春风又入长安陌，依旧闲愁绊柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"急棹趁吴门","author":"强至","text":"寒日山尖落，孤烟树杪屯。\n水流天欲动，舟急岸如奔。\n缥缈穿云角，苍茫望郭门。\n片心争宿鸟，去去近黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挺山道中早行有感二首 其二","author":"强至","text":"山驿孤灯尽，霜天片月低。\n还家人自喜，恋枥马频嘶。\n野水分微白，巢禽惊稳栖。\n前村应曙色，依约数声鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挺山道中早行有感二首 其一","author":"强至","text":"晨兴事行役，寸禄此时轻。\n扑面风霜紧，隔林鸡犬鸣。\n遥天分淡色，残月露微明。\n便欲投簪去，无田可力耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日山中感怀","author":"强至","text":"春中酣酣破宿霾，春心衮衮泻长淮。\n无情草树相看久，得意亲朋一笑乖。\n世俗冰霜谁暖眼，古人金石已枯骸。\n愁来独对青山坐，唯有东风入旧怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日兴庆池上作","author":"强至","text":"韦杜风光掠眼明，南山秀色入重城。\n林端衮衮晴烟起，冰底溅溅乱水鸣。\n载酒小舟聊晚泊，隔花幽鸟忽春声。\n汉唐壮观今何在，惟有新蒲细草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日送王明远","author":"强至","text":"马蹄乘兴急离秦，轻雪初消塞外尘。\n谈笑暂来趋幕府，文章犹记从车茵。\n雍雍妙画平边徼，衮衮清言服座人。\n诗句不须论别意，临岐探破故都春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日感怀","author":"强至","text":"壮年不觉登三纪，正月如今过一旬。\n人寿短长难定准，春期九十更逡巡。\n纵当簿领无馀暇，自合眉头且强伸。\n况值山城公事简，不谋笑饮是痴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽","author":"强至","text":"江花飘去不留春，海燕飞来独语人。\n局促年光花过眼，飘飖生理燕谋身。\n壮怀已入双蓬鬓，乐事还成一窖尘。\n唯有浊醪存妙趣，不容忧喜扰吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春色","author":"强至","text":"浅深花面染，来去柳边浮。\n雨气那能洗，年光亦共流。\n浓浓交野绿，拂拂上朱楼。\n转恐纷华眼，萧条不爱秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨一篇呈纯甫贤僚县庠诸彦","author":"强至","text":"漠漠阴常结，垂垂势未收。\n润多宜土脉，落久验溪流。\n与物知无间，于花似有雠。\n少年车马客，惆怅为君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨日以鄙诗示王君遽辱赠篇过有推饰辄依元韵奉答","author":"强至","text":"未有功名与世传，且驱怀抱向诗篇。\n昔曾篆刻工童伎，今敢风骚领将权。\n愧匪穷经臻圣处，妄推闻道在君先。\n还知苦意微吟否，不已犹云博奕贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼眠","author":"强至","text":"酣酣枕上息吾形，日过南窗第几棂。\n所得高眠容幕府，为无深责系朝廷。\n苦遭浮蚁催来熟，忽被幽禽唤得醒。\n却整葛巾寻晚酌，竹间呼客尽吾瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某不度轻僭始以鄙句尘献判府安抚司徒侍中特屈威尊过赐宠和伏读荣荷谨成律诗一首代启上谢","author":"强至","text":"司马当年侍兔园，只摅秘思奉清樽。\n岂如下客吟飞雪，继屈三公赐雅言。\n句揣物形虽有迹，笔镵天巧独无痕。\n岂惟一府誇荣玩，犹得他时耀子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某为府曹伏蒙吴先生以诗见寄谨依韵奉酬","author":"强至","text":"瘦马风埃里，萧疏分亦安。\n閒趋京兆尹，冷甚广文官。\n锦绣颁诗句，松筠映岁寒。\n天边师坐阔，南望祇长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某伏睹判府司徒侍中置酒宴客即时雪作谨成七言律诗一首上献","author":"强至","text":"相君东閤冒寒开，朔雪贪随乐事来。\n腊信未通先漏泄，台光欲近却迟回。\n势轻漫拟凌歌袖，片小才能缀酒杯。\n寂寞相如孤客在，定应授简属邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某近与和叔游景爱之不足因吟短篇以赠","author":"强至","text":"夫子南州杰，相逢出肺肝。\n平生潜圣阃，壮岁尚儒冠。\n鸱鴳霄垠击，蛟龙井底蟠。\n耻将孤愤剑，容易向人弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某承乏东阳周亲惠然顾访未几告别以诗饯之","author":"强至","text":"亲戚富贵合，贱贫宜见疏。\n独君从远道，为我枉高车。\n相得未逾月，薄言还故庐。\n风霜正凄暮，临别尚踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某前日以鄙诗叙谢通判国博特垂宠和谨复依韵上答","author":"强至","text":"夫子文章却异端，横流遏尽见平湍。\n间于风雅能臻极，粹甚圭璋不假刊。\n累句辄尝论盛美，赐篇还与作荣观。\n起予自愧无商学，何敢言诗向杏坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某尝约才甫游双溪以连雨多事因循未果辱诗督行谨依韵和","author":"强至","text":"共君曾约访烟霞，欲趁芳时物物嘉。\n宿诺古人尝有诫，春游今我果成赊。\n眼看日下无穷事，肠断风前已落花。\n天气清明当趣驾，此诗先寄谪仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某数年前蒙集仙盛公慰荐今方用是改官近以启事论谢伏辱长笺垂答因成短篇少抒感臆","author":"强至","text":"淮边曾以此身归，每见尝宽使者威。\n一昨荐章蒙首上，十年坠翼恰重飞。\n功名未果时看剑，报效犹乖夜揽衣。\n聊向短笺论感慨，更烦尊教宠寒微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"某蒙太守卢公惠酒因作诗以谢公子仇香遽赐光和复次韵叙事酬答","author":"强至","text":"予怀天地惠何悭，赖有仁侯念拙艰。\n尘土未尝轻俗状，风霜多为霁严颜。\n兵厨美酿才嘉贶，子舍清吟继宠颁。\n诗酒而今谐素嗜，更兼春雪满群山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪君然太博以元日刺字交驰卒不一见作诗相遗依韵和答","author":"强至","text":"知君元日趁鹓行，双观云边耸百常。\n拜表归来乘逸兴，跨鞍相就搅吟肠。\n还同皇甫寻僧孺，却笑山公顾葛强。\n我亦及门空刺字，不容高论听琅琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日咏楼感怀二首 其二","author":"强至","text":"摇落秋旻一望长，浮空颢气白如霜。\n楼头待月郡城晚，水底有天江国凉。\n却恨人生如寄客，未容年少即衰郎。\n除非烂醉酬清景，莫惜千金换斗浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日咏楼感怀二首 其一","author":"强至","text":"公逾四十气方强，未怕秋风作鬓霜。\n人物此时仍富乐，襟怀无事可悲凉。\n严涂行取青毡物，末路宁同白首郎。\n满目溪山宜旷望，醉提北斗挹霞浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋试甫期辄成短篇呈马公节裴进士光世","author":"强至","text":"妙誉相高耸一乡，士林注目看轩翔。\n玉蹄骏欲腾先路，金距雄思擅旧场。\n只待秋闱排甲乙，稳携晓砚写文章。\n如今老将虽无勇，忆拔蟊弧尚激昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种药","author":"强至","text":"百药吾谁辨，农皇旧有经。\n倾金购善种，按谱验真形。\n易地防根瘦，他时欲剂灵。\n天时纵不雨，灌溉赖园丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荣归堂二首 其二","author":"强至","text":"嫩柳浓花围旧圃，朱甍碧瓦照春池。\n黄金腰下还乡印，翠琰胸中报国诗。\n乘驷长卿羞志浅，怀章公子恨名迟。\n知公触事须尊主，揭榜新堂是训辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荣归堂二首 其一","author":"强至","text":"堂就新纡上相车，名尊为出紫泥书。\n清杯燕喜三春半，黄阁归来一纪馀。\n香径生辉荣草木，画檐垂荫乐禽鱼。\n官轻可笑江东老，也漫怀章诧里闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺吴枢府诗","author":"强至","text":"治声一月满长安，直上星枢耸具观。\n空策危言惊主易，能施行事似公难。\n诏辞浩荡留邦国，庙略纵横出肺肝。\n拜庆亲闱双白首，更传盛事入衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵龙图自西川携鹿儿至秦相惠","author":"强至","text":"软毛金缕暗，细点雪花匀。\n林下远思母，阶前愁傍人。\n涧声微可听，野性渐能驯。\n公惠成愚好，他年伴幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人还阙","author":"强至","text":"谈笑三年陪主帅，文章二纪在公卿。\n莫辞别酒倾秦地，且听离歌唱渭城。\n鞍马入关侵腊尾，宫莺到阙破春声。\n朝廷拔擢贤才急，合有当涂荐姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送大名府签幕吴都官几复移倅安肃","author":"强至","text":"相公樽俎纳豪英，使者封章荐姓名。\n落日送愁离幕府，翔云随眼入边城。\n万蹄宛马休南牧，一啸燕姬慰北征。\n敌颈愤来还请系，雒阳前后有书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送子立荣侍南归","author":"强至","text":"有客就征骖，风前别酒酣。\n慈颜依膝下，归意满江南。\n去路草初歇，到家梅正含。\n短书无惜寄，别后抵清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马特失荐还苏回舟中作","author":"强至","text":"一客空归颜色低，众人气亦丧虹蜺。\n泪添酒盏霜天阔，目断帆樯海日西。\n交臂散零如木叶，别肠萦转似山蹊。\n遥知名在乡书者，雨洗秋街跃马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送公度赴诏归阙","author":"强至","text":"两京三仕并交游，有道从来慕太丘。\n白日声名随诏召，青云家世踵飙流。\n数程去路朱蹄骏，一曲离筵翠黛愁。\n材力如君当拔擢，敢辞幕府独淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送公济还阙下","author":"强至","text":"不候关征满岁归，邑人徒尔挽行衣。\n肯将泪对残花落，应自心先去鸟飞。\n官向长安多富贵，君当即日享轻肥。\n绿槐阴合天街后，恰缀宸班拱帝晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王天常太祝诗","author":"强至","text":"雨洗春枝冷，莺愁晚更啼。\n感时双泪落，送客片帆西。\n淮隰逢鸰羽，京尘纵马蹄。\n有才无殿课，安稳步通闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王文玉归浙","author":"强至","text":"插旗打鼓放船头，二纪蓬莱一梦游。\n回首谁能顾庭鹭，收心自可近江鸥。\n盘堆玉缕鲈初脍，盏溢金波酒旋篘。\n摩诘定怀廊庙弟，新诗未免到皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王仲贤郎中游天平山","author":"强至","text":"近来好事数中郎，笑指秋山学楚狂。\n绝顶去天应咫尺，回头平楚祗毫芒。\n步侵猿鸟双藜杖，吟蓄云烟一锦囊。\n日并尘游疏逸驾，自怜丘壑意空长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王明叟起秀州法掾","author":"强至","text":"去去持丹笔，当官议是非。\n壮心低仕路，恋涕湿亲衣。\n汲浪樯乌急，吴霜稻蟹肥。\n论文杯酒后，从此故人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王敏夫判官赴举京师","author":"强至","text":"郤公门下识羲之，风骨无尘耸秀姿。\n壮气海鲲翻碧浪，逸才天马脱金羁。\n旋凭辞律趋明试，首听文衡中有司。\n太学旧游应刮目，青衫事业盛当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送长安佥判鲜于子骏还阙","author":"强至","text":"相望蜀父老，应嫌驷马迟。\n三冬辞幕府，千里走京师。\n富贵那能滞，文章自有知。\n关山含雪意，别酒对秦姬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送史正孚","author":"强至","text":"再提试笔入南宫，落纸文章近更工。\n一第声名光昼日，十年意绪散春风。\n眼惊梁苑花枝静，心豁秦川酒盏空。\n材大莫嫌关赋冗，青云知己有诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送石亢之节推赴庐州幕府","author":"强至","text":"执政昔曾祖，滞才今令孙。\n三迁才大幕，万石已高门。\n阮瑀妙草檄，毛公深雅言。\n相从宾主乐，淮月共清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送乔岑","author":"强至","text":"世俗谁誇昼锦归，乡人应笑旧儒衣。\n一言许与经词伯，三道声名出礼闱。\n好在青云须远步，莫愁黄鹄不高飞。\n还家便养轩腾志，当使闾阎见面稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送传宣李子范供奉归阙","author":"强至","text":"曾共征西幕府来，相逢今日魏王台。\n喜情重把论交袂，感泪频添话旧杯。\n此别情怀无限恶，他时谈笑尚容陪。\n马蹄归趁春风急，应有花先禁苑开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘伯寿团练致政归洛阳旧隐","author":"强至","text":"几年笑傲负缑云，一日重寻麋鹿群。\n归老慢贤疏太傅，不侯谁念李将军。\n霜天剑气闲中见，月岭笙声醉里闻。\n回首功名今似梦，逢人懒说守边勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘嗣复都官赴辟秦州幕府四首 其四","author":"强至","text":"入秦乘夏颇相宜，笑拂征鞍尽别卮。\n鹦鹉陇西迎赋笔，芙蓉幕里近花期。\n祖琨清发能长啸，老杜冥搜有杂诗。\n君去定应兼二美，军书暇日戍楼时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘嗣复都官赴辟秦州幕府四首 其三","author":"强至","text":"几载关西任醉醒，一朝意绪属青冥。\n舌端江海倾谈韵，掌内风云指阵形。\n乌府中丞知国器，鸿枢学士纳边庭。\n二公远近观成效，莫使旄头尚有星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘嗣复都官赴辟秦州幕府四首 其二","author":"强至","text":"十万强弓略未弯，妖氛渐灭贺兰山。\n元侯把诏开新府，上客随书出故关。\n诗酒不妨行乐外，功名只在立谈间。\n主人待勒燕然石，谁道能铭独姓班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘嗣复都官赴辟秦州幕府四首 其一","author":"强至","text":"安西幕府蔼声华，礼币迎门促去家。\n长日壮图看剑气，隔宵喜信报灯花。\n轻装度陇由来惯，逸辔追尘不待挝。\n宾主禦戎俱有策，只陪谈笑却边沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年张正臣赴海陵幕","author":"强至","text":"早年登甲选，从事又东藩。\n地与淮流绝，城连海气昏。\n好山供健笔，暇日乐清樽。\n多著太平策，归来奏帝阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年周涛赴吉幕","author":"强至","text":"庐陵风物素称繁，幕府雄誇列郡间。\n从事有才诗笔健，平时无警檄书闲。\n清吟良足偿风月，曲宴应频醉髻鬟。\n行矣功名及年少，未宜留意属江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕贯中","author":"强至","text":"陋邑相逢乐且敖，一枰才了又丹醪。\n酒因校户知君大，棋为论饶觉我高。\n忽对溪山挥别袂，却忧棋酒寡同袍。\n勉哉各努当年力，无使功名见二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕监簿归淮南侍下","author":"强至","text":"花边把酒趁晴晖，春去花空兴尽归。\n白发亲庭宽北望，青帘客舫喜南飞。\n京埃衮衮休回首，淮月娟娟好振衣。\n年少身名当自立，不须裘马事轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送成都旧尹赵龙图至骊山作","author":"强至","text":"阻傍严公住浣花，喜从秦地见高牙。\n致君前去心逾赤，抚俗归来发未华。\n路出锦江乘夜月，骑停绣岭揖朝霞。\n自怜二纪游门下，今日聊能托后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱传道推官赴刑部详覆","author":"强至","text":"文章自老齿独壮，富贵偶迟名最先。\n冷落官曹按丹笔，风流幕府别红莲。\n高谈倾座迥无敌，清骨照人长欲仙。\n好在胸中书万卷，校雠四库续登贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱郎中得谢归淮南二首 其二","author":"强至","text":"天香犹在入朝衣，早见都门解绶归。\n晚岁高风增慷慨，今宵列宿动光辉。\n谁供白酒开谈笑，自向沧洲洗是非。\n从此淮禽相看喜，沙边不复背公飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]