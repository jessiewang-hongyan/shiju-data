[{"title":"句 其十一","author":"王琪","text":"鱼寒不食清池钓，鹭静频惊小阁棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉荆王墓","author":"王琮","text":"落落庙碑摹瘗鹤，阴阴宰木宿神鸦。\n可怜宝剑凌云气，散作金灯满地花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春有怀","author":"王琮","text":"十千呼酒醉长安，犹记年时客里欢。\n有约南山南畔去，只挑野菜当春槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过孤山","author":"王琮","text":"寂寞梅花处士坟，竹围岩脚一泉深。\n隃瞻翠辇曾游处，水钥年年护绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观潮","author":"王琮","text":"旗彩斜飞一命轻，舟人却立万舟迎。\n不应当日将军事，犹到如今气未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客中从厚禄故人乞米","author":"王琮","text":"范甑欲尘贫亦甚，陶腰未折计何如。\n小窗独对萧萧雨，临得唐人乞米书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅兴","author":"王琮","text":"经年客食向京华，懒对春风祇忆家。\n觉道近来全俗了，略无一语及梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秘省金鱼池一首","author":"王琮","text":"落叶阑干小立时，诸公慨想到腰围。\n但知官饼堪为饵，不识人间有钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"献可约游北山阻雨","author":"王琮","text":"共约湖边唤短篷，晓来何事雨兼风。\n山林只合闲人到，不入时官眼界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题多景楼","author":"王琮","text":"秋满阑干晚共凭，残烟衰草最关情。\n西风吹起江心浪，犹作当时击楫声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三岩","author":"王琮","text":"闲携一壶酒，来对雪岩斟。\n秋老瀑飞瘦，石寒云宿深。\n坐无僧共话，行有鹤随琴。\n此处尽不俗，令人生隐心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与刘天游伯仲夜话霅中戏赠","author":"王琮","text":"水亭新得月，坐对白蘋洲。\n共说一夜话，惜无多日留。\n手抄诗许借，口诵咒如流。\n最羡同吟处，对床风雨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邺中书怀","author":"王琮","text":"苦无官况莫来休，羞见傍人说宦游。\n九十日秋蛩共语，两三夜雨雁供愁。\n腐红只有虚名在，坚白难将实意酬。\n驿路梅花归正好，苦无官况莫来休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山访僧晚归","author":"王琮","text":"吟僧山北住，又买过湖船。\n半日得闲话，一生无此缘。\n波光□酒兴，竹色带茶烟。\n归路斜阳里，徐行听乱蝉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵项君玉","author":"王琮","text":"惠然乘兴访幽栖，细雨冥冥湿杖藜。\n七尺身强于鹤瘦，一生心不向人低。\n日寻灵药行寒麓，时有新诗付小奚。\n欲解貂金同一醉，酒垆闻只在前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京华病中","author":"王琮","text":"自移药鼎在床头，桂玉令人分外愁。\n因病始知归计好，虽贫不向俗人谋。\n僧曾带雨来看脉，仆为伤风懒上楼。\n赖有壁间新买画，寒灯相对两山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客里有怀徐太古","author":"王琮","text":"近来真倦客，怕蹋软尘红。\n独向一楼坐，静观诸境空。\n官河添夜雨，宫树带秋风。\n还忆能吟者，襟期何日同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客南徐一首","author":"王琮","text":"秋来客里几蹉跎，醉铗唯堪浩浩歌。\n盛世未应知己少，诸公自是阅人多。\n潮生瓜步风犹急，苔满浯溪石欠磨。\n忆昔祖生忠愤后，更无一楫是如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭潘令","author":"王琮","text":"河阳桃李树，惆怅不逢春。\n官为吟诗折，家因好客贫。\n故山归去远，遗像挂来真。\n谁向江头哭，共乡三数人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何耐轩","author":"王琮","text":"调度如儒素，相门中所难。\n一心唯好佛，半世懒求官。\n星近缇屏落，坟依宰木寒。\n遗恩满溪麓，鱼鸟亦辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜赵居父赴班","author":"王琮","text":"西台自是旧相知，来了为山一篑亏。\n入幕虽无多日在，改官已是十年迟。\n金闺接武人争羡，玉牒能文世所奇。\n此去锦乡才两宿，仙茅绿景正堪诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答友人","author":"王琮","text":"秋山曾是共登临，感慨兰亭后视今。\n炎热不过能炙手，笑谈未必到知心。\n前言衮衮风波去，后约寥寥岁月深。\n室迩岂应人自远，酒盟诗社要重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓬莱","author":"王琮","text":"一棹三万里，何修入窈深。\n水痕涵雨意，岩影带秋阴。\n虽愧无仙骨，终能长道心。\n古人殊错计，空向海中寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题独醒小亭","author":"王琮","text":"退食多留此，翛然一散襟。\n凉从晓来觉，秋向雨中深。\n墙竹侵山色，檐茅杂柳阴。\n有谁能载酒，过我共幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐献可兼别重巽","author":"王琮","text":"谁怜范叔恋袍寒，犹有徐卿二子看。\n大率率中多物忤，相知知到此心难。\n最怜风雪分吟笔，安得江山共倚栏。\n后夜小窗怀素帖，挑灯应忆我同观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城西即事","author":"王琮","text":"清晓离家去路遥，绝怜寒景太萧条。\n松深渐觉风声紧，云动还知雪意销。\n沙嘴客担鱼种卖，山头人拾树枝烧。\n梅华多处谁家酒，斜舞青帘隔小桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独醒午坐","author":"王琮","text":"小槽停溜务厅闲，幕府文书省却难。\n竟日裴回无俗意，祇因竹外有秋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜有怀醉书十韵","author":"王琮","text":"秋风从何来，飒飒入窗牖。\n残镫耿不寐，照我客颜厚。\n故园岂不佳，亦颇兴怀否。\n黄金桂百树，碧玉池十亩。\n猿鹤响空山，亭台映疏柳。\n觥筹杂野蔌，笔砚得佳友。\n愁无弹鹊句，隽有持螯手。\n人生行乐耳，功名有时有。\n点检屐几两，土苴米五斗。\n浩然归去来，万事不如酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读书楼作","author":"王琮","text":"近来闲过日，幽事颇相关。\n远树开晴昼，归云当晚山。\n宦情随处薄，诗稿逐时删。\n骨若无仙分，何因住此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答外","author":"王琼奴","text":"茜色霞笺照面赪，玉郎何事太多情。\n风流不是无佳句，两字相思写不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游天平山 其二","author":"王疏","text":"胜景奇踪烂漫游，归鞍欲上重回头。\n山禽于我情何厚，逐马声声似见留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游天平山 其一","author":"王疏","text":"春雨新晴上翠微，三年两过洞天扉。\n尘踪不得多时住，又向云间一宿归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劳拙堂歌","author":"王谦","text":"民吾同胞兮，抚之不得不劳兮。\n拙虽获罪，庸可逃兮。\n伪不能以终朝兮，作之亦徒劳兮。\n拙虽未败，久乃昭兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"王赏","text":"凌寒低亚出墙枝。\n孤瘦雪霜姿。\n岁华已晚，暗香幽艳，自与时违。\n化工放出江头路，沙水冷相宜。\n东风自此，别开红紫，是处芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿朝宗驿游洞天 宿朝宗驿","author":"王越石","text":"炎洲望处云南北，峣阙归时路屈盘。\n喜得夜深清枕簟，月华斜白洞天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿朝宗驿游洞天 游洞天四首 其四","author":"王越石","text":"清泉流急响珊珊，丹灶无烟玉石寒。\n拂石坐来心虑息，气清冰在玉精盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿朝宗驿游洞天 游洞天四首 其三","author":"王越石","text":"乱峰如展画屏看，老蔓纡根虺斗盘。\n飞步寻真尽深处，乳花凝雪逼人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿朝宗驿游洞天 游洞天四首 其二","author":"王越石","text":"药盆丹灶石床閒，龙虎当年向此盘。\n云驭久登天穴路，仙风依旧拂衣寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿朝宗驿游洞天 游洞天四首 其一","author":"王越石","text":"静然华烛扣灵关，云路登寻过几盘。\n溪水定流何处去，一条沈碧练光寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览翠亭","author":"王辉","text":"亭倚古台边，环亭翠蔚然。\n芝兰深雨露，梧竹老风烟。\n窗户香霏湿，阑干爽气连。\n登临忘世虑，逸兴发林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"口伐","author":"王遂","text":"口伐归来战马闲，诗书只守一编残。\n治安策里多流涕，莫作兴亡异代看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以台柑寄漫塘报以诗用韵谢之","author":"王遂","text":"屈平作颂独称渠，曾比西山立懦夫。\n君子得舆知有待，高林硕果未尝无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丈壁读胡邦衡书草","author":"王遂","text":"僧房高揭谏和书，知是高人意不虚。\n我亦今年三十七，闭门畏祸独何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁考神御奉安原庙 其四","author":"王遂","text":"俭慈三十一年主，已不自知其至尊。\n时向道傍逢故老，但能垂泪不能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁考神御奉安原庙 其一","author":"王遂","text":"经旬风雨陡新晴，一夜蟾光直到明。\n清晓衣冠原庙去，分明眷佑似平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁考神御奉安原庙 其二","author":"王遂","text":"卤簿萧萧鼓吹鸣，属车前导乘舆轻。\n□□殿里朱门閟，无复传呼辇路声。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁考神御奉安原庙 其三","author":"王遂","text":"太室祼将严体荐，景灵朝献荐牙盘。\n九重黼坐盘盂固，四海苍生奠枕安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁考神御奉安原庙 其五","author":"王遂","text":"禁殿薰风传赐敕，宫门晓日缓催班。\n小臣未报君恩重，耿耿孤君入梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题胡淡庵谏和书后","author":"王遂","text":"溪翁死后谏书焚，怪得和戎近有孙。\n寄语岳家新宰士，当时谢表几行存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中诵陶诗及诸葛传 其一","author":"王遂","text":"扣舷细读渊明句，出听还疑是水神。\n江上只逢名利客，人间无复有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中诵陶诗及诸葛传 其二","author":"王遂","text":"隆中气象接莘磻，心术精微日月寒。\n学到圣贤无尽处，一毫人力不容安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻杜鹃有感","author":"王遂","text":"人物同为气所乘，良心露处即良能。\n天津有此惊康节，西蜀无之感少陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顺宁忆弟","author":"王遂","text":"犹怜膝下竞儿嬉，岁月光阴去若驰。\n闲倚阑干思旧事，却如故老话淳熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读天宝诸公事 其二","author":"王遂","text":"忠贤赴国方忧北，奸党全身却落南。\n祸福难从当世问，是非时有老农谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读天宝诸公事 其一","author":"王遂","text":"当时群枉误朝廷，血染长安草木腥。\n四罪不诛三宅去，依前肝脑是生灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读文公壬子闻雷诗","author":"王遂","text":"五阳未决尚存阴，底事先王卧竹林。\n绝口不谈当世务，对天惟有格君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读武侯传","author":"王遂","text":"马踏渭滨春草乱，鸟啼白帝夕阳深。\n汉家浑是皇天做，渠是通天一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堂后梅","author":"王遂","text":"阿母亲栽白玉堂，分明雪色变青黄。\n不须徙倚横枝看，留作江南第一香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒子真祠 其一","author":"王遂","text":"汉朝容默独危言，吴市逃名耻自全。\n千古无人知此意，浪将姓字作梅仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登县圃小楼","author":"王遂","text":"山有青黄臼纻山，谢公已起谪仙还。\n至今犹有文章焰，放入高楼户牖间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登杨府风云阁","author":"王遂","text":"杰阁入风云，分明是得君。\n湖山尽行乐，愁杀岳将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢赵庐州送淮白 其一","author":"王遂","text":"淮源千古贯中州，南北分来九十秋。\n欲放此鳞归纵壑，要留佳瑞入王舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道上","author":"王遂","text":"夹道香烟笑语欢，老翁扶立小儿观。\n书生未有丝毫力，定忆前回去长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞香","author":"王遂","text":"晓见花开意味长，夜深放出紫荷囊。\n须知睡里真香足，犹锡佳名号瑞香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题卷舒堂竹","author":"王遂","text":"月淡星疏子夜清，独骑黄鹤下吹笙。\n当时只许风听得，学与行云佩玉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁庵","author":"王遂","text":"千章松桧护泉台，无复牛羊日下来。\n安有良心亲付授，却教容易着尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁窗 其二","author":"王遂","text":"云从西去又还东，不逐天回却逐风。\n春日岂无晴昼永，扫除阴翳出长空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁壁 其四","author":"王遂","text":"小日寒窗共赋文，一时洛下看机云。\n自知只道归耕手，不比斯人解致君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁壁 其二","author":"王遂","text":"墓道深衣自涕洟，分明入耳似闻诗。\n月征日迈求无忝，尽是临深履薄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁壁 其三","author":"王遂","text":"膝下当年忆教忠，此身卜与弃捐同。\n睿思夜半忧民切，羞见东窗日半红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁壁 其五","author":"王遂","text":"宿草初生木未阴，自栽松柏待成林。\n后来剪伐应无忍，记取当时怵惕心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁壁 其七","author":"王遂","text":"江东山望说茅庐，庵为康家孝子居。\n岂肯人间名教地，却容释老说清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺宁壁 其一","author":"王遂","text":"养得翔鸾舞凤枝，不知雨露几含滋。\n但同栎社长无用，留作明堂柱石姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题游默斋词后","author":"王遂","text":"游公已去今安在，学步虚声过午清。\n最喜高谈言太极，一轮放下月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠肖岩 其二","author":"王遂","text":"居住梁溪古道傍，分明木石最堂堂。\n丹青能染成形貌，犹有心源未易量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]