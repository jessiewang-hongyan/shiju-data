[{"title":"雨中过临平湖","author":"沈括","text":"绿蒲浅水清回环，浪头雨急声珊珊。\n画桡惊起远近雁，宿霭欲乱高低山。\n败蓬半漏野更好，短缆数断迟转闲。\n溪翁此日乘浩渺，搔首坐哨烟云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"沈括","text":"渔钓非良业，相期逐姓名。\n太平虽不仕，故旧岂无情。\n七里林泉好，三公位貌轻。\n片帆湍石下，谁不仰先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙都山","author":"沈括","text":"苔封辇路上青山，鹤驭辽天去不还。\n惟有银河秋月夜，鼎湖烟浪到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠天台冲寂道人","author":"沈括","text":"闻说能文山阁老，比年幽兴著林泉。\n自开鹿苑知何日，不向虎溪今十年。\n寥寥清言坐中士，皎皎寒月山间天。\n不堪世俗看支遁，曾有篇章忆惠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十松亭","author":"沈括","text":"空堂无人日长哦，风松助我涧云和。\n苍颜古木喜相似，爱子亦有淩云柯。\n欢然相对默终日，意得那须言强多。\n我身未得从心老，嗟尔系此成蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游山门","author":"沈括","text":"溪水激激山攒攒，苍崖腹封壁四环。\n一门中嚂俯惊澜，造物为此良有源。\n坡颠窍塞沦九渊，吐吞龙螭殆非然。\n又疑猛将血战还，斩此欲守规为门。\n至今惨恻风夜寒，杀气袭水为屈盘。\n山重地僻道路偏，此境安得与祸连。\n反复不得意所安，将必有理愧莫原。\n山川幽深适素尚，辙蹂万坚穷跻骞。\n生平所更了可记，怪特若此殆未观。\n崆峒地首久茫昧，自此稍欲信所传。\n排云径上淩巀薛，力弱盛恐乘以蹎。\n西光戛戛下岩壑，取酒更为山留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延州柳湖 其一","author":"沈括","text":"萧洒征西府，青林隐万家。\n楼高先见月，山近不藏花。\n雨急喧流水，溪深噪乱鸦。\n笙歌乘酒兴，可复问天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延州柳湖 其二","author":"沈括","text":"汉使雕阴道，秦关白翟宫。\n山川红旆里，日明翠微中。\n社后寒犹峭，春残草木浓。\n花前江国兴，并觉此时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延州柳湖 其三","author":"沈括","text":"日暖闲园草半薰，不堪春兴蝶纷纷。\n山烟梦松成微雨，关月帘纤出断云。\n三弄倚楼喧晚操，六花分队驻新军。\n终年不见江淮信，吟向胡笳永夜闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄜延凯歌 其一","author":"沈括","text":"先取山西十二州，别分牙将打衙头。\n回看秦塞低如马，渐见黄河直北流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄜延凯歌 其二","author":"沈括","text":"天威略地过黄河，万里羌人尽汉歌。\n莫堰横山倒流水，从教西去作恩波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄜延凯歌 其三","author":"沈括","text":"马尾胡琴随汉车，曲声犹自怨单于。\n弯弓莫射云中雁，归雁如今不寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄜延凯歌 其四","author":"沈括","text":"灵武西凉不用围，番家总待纳王师。\n城中半是关西种，犹有当时轧吃儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄜延凯歌 其五","author":"沈括","text":"旗队浑如锦绣堆，银装剑背打回回。\n先教净扫安西路，待向河源饮马来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光化道中遇雨","author":"沈括","text":"望远初翻叶，随风已结阴。\n雨蓬宜倦枕，乡梦入寒衾。\n蓑笠侵郧俗，溪山动越吟。\n烟波千里去，谁识魏牟心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉东楼","author":"沈括","text":"野草粘天雨未休，客心自冷不关秋。\n寨西便是猿啼处，满目伤心悔上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽命","author":"沈括","text":"山木啸兮云幽幽，秣我归马兮无为久留。\n江鼯翔兮雨漫漫，回予车兮水渐幰。\n仲何为兮中野，澹将洋兮疏驾。\n目逝兮形留，郁逍遥兮日下。\n泻慕兮流观，抚节兮浩望。\n驷黄戾兮靡骋，旋吾辑兮焉往。\n不我虚兮斯辰，思何为兮鞅掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佚老堂为江州陶宣德题","author":"沈括","text":"暂来林下问栖迟，已觉绦然悟昨非。\n卧起见山宁用买，门墙无物可人挥。\n茵连细草才容藉，淀染浓岚欲堕衣。\n佳士要当怜寂寞，不应全为折腰归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游秀州东湖","author":"沈括","text":"柳色青天雨乍晴，鸭头细草绕堤生。\n林间野日依依见，水底春光寸寸明。\n犹喜乱花时入眼，可能万事顿忘情。\n无端景物相料理，屡欲颠狂兴不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀州秋日","author":"沈括","text":"草满池塘霜送梅，林疏野色近楼台。\n天围故越侵云尽，潮上孤城带月回。\n客梦冷随风叶断，愁心低逐雁声来。\n流午又喜经重九，可意黄花是处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏小小墓","author":"沈括","text":"古木寒鸦噪夕阳，六朝遗恨草茫茫。\n水如香篆船如叶，咫尺西陵不见郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金山","author":"沈括","text":"楼台两岸水相连，江北江南镜里天。\n芦管玉箫齐送夜，一声飞断月如烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游花山寺","author":"沈括","text":"经旬飘雨喜新晴，病马缘畦取次行。\n老态只应随日至，春心无意与花争。\n山川满目浮烟合，楼板侵天暮霭横。\n嗟我有身无处用，强携尊酒入峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望海楼","author":"沈括","text":"雨声林外尽，秋色望中添。\n落日挂疏柳，远江横暮檐。\n好风疑有意，堕叶故争帘。\n为问楼中客，胡为尽日淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈丞相故宅","author":"沈括","text":"丞相旌旗久不归，虚堂宁止叹伊威。\n绿槐楼阁山蝉响，青草池塘野燕飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹阳楼","author":"沈括","text":"碧城西转拂苍烟，日绕阑干一握天。\n青草暮山歌扇底，美人瑶瑟瞑鸿边。\n吹声隐隐江都月，弄影翩翩建业船。\n流尽古来东去水，又将秋色遇楼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝茶","author":"沈括","text":"谁把嫩香名雀舌，定知北客未曾尝。\n不知灵草天然异，一夜风吹一寸长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"图画歌","author":"沈括","text":"画中最妙言山水，摩诘峰峦两画起。\n李成笔夺造化功，荆浩开图论千里。\n范宽石澜烟树深，枯木关仝极难比。\n江南董源僧巨然，淡墨轻岚为一体。\n宋迪长于远与乎，王端善作寒江行。\n克明已往道宁逝，郭熙遂得新来名。\n花竹翎花不同等，独出徐熙入神境。\n赵昌设色古无如，王友刘常亦堪并。\n黄筌居寀及谭宏，鸥鹭春葩蜀中景。\n艾宣孔雀世绝伦，羊仲甫鸡皆妙品。\n惟有长沙易元吉，岂止獐鹿人不及。\n雕鹰飞动羡张泾，番马胡瑰屹然立。\n濠梁崔白及崔悫，群虎屏风供御幄。\n海州徐易鱼水科，鳞鬣如生颇难学。\n金陵佛像王齐翰，顾德谦名皆雅玩。\n老曹菩萨各精神，道士李刘俱伟观。\n星辰独尚孙知微，卢氏楞伽亦为伴。\n勾龙爽笔势飘飖，锦里三人共辉焕。\n西川女子分十眉，宫妆撚■周昉肥。\n尧民击壤鼓腹笑，滕王蛱蝶相交飞。\n居宁草虫名浙右，孤松韦偃称世希。\n韩干能为大宛马，包鼎虎有惊人威。\n将军曹霸善图写，五花聪马今传之。\n驭人相扶似偶语，老杜咏入丹青持。\n少保薛稷偏工鹤，杂品皆奇惟石恪。\n戴蒿韩滉能画牛，小景惠崇烟漠漠。\n唐僧传古精画龙，毫端想与精神通。\n拿珠奋身奔海窟，鬣如飞火腾虚空。\n忠恕楼台真有功，山须突出华清宫。\n用及象坤能画鬼，角嘴铁面头蓬松。\n侯翼曾为五侯图，海山聚出风云乌。\n尔朱先生著儒服，吕翁碧眼长髭须。\n恺之维摩失旧啧，但见累世令人模。\n探微真迹存一本，甘露板壁狻猊枯。\n操蛇恶鬼衔火兽，鉴名道子传姓吴。\n僧繇殿龙点双目，即时便有雷霆驱。\n仙翁葛老渡溪岭，潇洒数幅名移居。\n辋川弄水并捕鱼，长汀乱苇寒疏疏。\n予家所有将盈车，高下百品难俱书。\n相传好占雅君子，睹诗观画言无虚。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽人篇 其一","author":"沈括","text":"幽人步影啭春阳，情多无那不成章。\n恨楼未高着鞭望，南陌无人但垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽人篇 其二","author":"沈括","text":"天边梦来情满床，梦短数觉宵苦长。\n起坐作琴舞闺倡，占珑水中月茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽人篇 其三","author":"沈括","text":"蜘蛛做网着屠苏，蜻蜓故来晕罗襦。\n醮君柏酒情莫疏，无情可能学哺鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归计","author":"沈括","text":"住山人少说山多，空只年年忆薜萝。\n不是自心应不信，眼前归计又蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叹老","author":"沈括","text":"为觅少年心不得，当时感旧已潸然。\n情怀此日君休问，又老当时二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中红梅盛开折送李野夫","author":"沈括","text":"轻苞满槛簇花钿，云幕低垂黯淡天。\n巫峡人归街暮雨，阿溪家远隔非烟。\n少分山客红云破，拟夺星郎锦帐鲜。\n未上春风惜寒晚，故教开向众芳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵辛著作兴化园池诗 其一","author":"沈括","text":"能文骑省幸邻船，多病中散自萧然。\n□桥鸟啼深竹里，晴渚梦绕杨花边。\n难分桃杏春满目，不断水月波如烟。\n□须移居速相就，已有的的新生莲。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵辛著作兴化园池诗 其二","author":"沈括","text":"东来重见郭翻船，目极沧洲似渺然。\n浪信小桡穿竹去，不知佳景向谁边。\n白头赵将心仍在，多病莱芜灶不烟。\n惟有王家风月地，时时客看满池莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄永嘉王博士","author":"沈括","text":"十万櫜鞬临易水，五营旗鼓出中山。\n去年今日西岑别，回首吴山梦寐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浩燕堂","author":"沈括","text":"西堂昔时冷萧条，使君名高堂为高。\n流虹碎□勤镌雕，粉黛翕倏随挥毫。\n太守浩燕觞九牢，门前过客罗百艘。\n檐褕晔晔烂亭皋，切云危冠控豪曹。\n秋鹤霜毛飞锦袍，六鹊曳地横金腰。\n轻罗韬烟媚中宵，缓歌阁舞萦云髾。\n赵人手提千牛刀，目视大犗如鸿毛。\n太守巨笔驱波涛，指画风云惨动摇。\n佩牛带犊如销膏，区区古人无是超。\n吴粳如脂敢百筲，连车折轴弃道交。\n釜区争先走名豪，旋鲈掣酒飞千舠。\n杜伯称觥酾醲醪，翳翳禾黍藏笙箫。\n太守浩燕乐岁饶，岂徒割烹盈大庖。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"沈括","text":"百辟九霄环帝座。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"沈括","text":"艇子隔溪语，水光冰玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"沈括","text":"白差乌鬼作鹧鹚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"沈括","text":"黄金碾畔绿尘飞，碧玉瓯中翠涛起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"沈括","text":"四蹄双翻惊草头，飞入平原不沾土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"沈括","text":"鸾台倦直出黄扉，鱼浦双旌入翠微。\n阁老清规三省旧，使君高兴五湖归。\n却从江海瞻青琐，聊过丘园戏锦衣。\n一拂京尘浩南望，蓬莱阁静簿书稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠舒州徐处土","author":"沈括","text":"昔爱灊川游，青林覆幽石。\n道人携手行，萧然名山客。\n谁知隋世路，譬如羁飞翮。\n林皋未脱去，纷纷头欲白。\n轻负皇人经，犹怀稚川策。\n幸已弃韦带，远谢功名迹。\n聊希闭关士，正苦身为役。\n别来二千日，还丹应有术。\n毋忘绛囊赠，使我升仙籍。\n将酬金镮脆，青绫三万尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游二禅师道场","author":"沈括","text":"胜境东西白，高僧一二禅。\n只知行道处，不记住山年。\n涧月中分照，林花各自妍。\n披云寻旧址，犹在绛峰边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题孤岭","author":"蒋之奇","text":"蛟绡剪下碧双垂，归挹清流背紫微。\n北向更登孤岭去，此身还入白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春帖子","author":"蒋之奇","text":"昧旦求衣向晓鸡，蓬莱仗下日将西。\n花添漏鼓三声远，柳映春旗一色齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲍娘题兑溪驿","author":"蒋之奇","text":"尽日行荒径，全家出瘴岚。\n鲍娘诗句好，今夜宿江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和兄之翰宠换苏印 其一","author":"蒋之奇","text":"久次含香厌粉闱，恳求茂苑得州麾。\n却寻旧日池台胜，犹忆当年几杖随。\n入里下车修敬日，过家上冢致哀时。\n应怜二弟犹羁绊，万里边沙远帅熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和兄之翰宠换苏印 其二","author":"蒋之奇","text":"早同侍宦向长洲，今拥旌麾访旧游。\n自古风流诗酒地，韦苏州后蒋苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠海陵天庆观乐子长真人碑","author":"蒋之奇","text":"瑶坛三级满苍苔，想像真人饮赤杯。\n飒飒仙风动杉桧，只应飙驭暂归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和秘阁曝书会","author":"蒋之奇","text":"宴豆追儒雅，簪缨成礼容。\n中天开璧府，左海见鳌峰。\n汗简陈三馆，仙游列玉京。\n丹青浮象魏，盛典照蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄米元章","author":"蒋之奇","text":"京城汨没兴如何，归棹翩翩返薜萝。\n尽室生涯寄京口，满床图籍锁岩阿。\n六朝人物东流尽，千古山河北固多。\n为借文殊方丈地，中间容个病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游朝阳岩遂登西亭","author":"蒋之奇","text":"昔游不在远，幽岩临治城。\n嵚岑俯潇碧，庨豁延阳明。\n绿涧可径八，滑路偪仄行。\n泉源自何来，涓涓玉锵鸣。\n疑穿云雷窟，常带鱼龙腥。\n寒江净泻镜，怪石坐开屏。\n幽鸟驯可罗，潜蛟深莫罾。\n梯险接层栈，冠颠耸危亭。\n俯睨极玄窞，仰攀穷青冥。\n蹇旷出物表，高虚挹玄英。\n惜哉非吾土，不得憩此生。\n旧业寄阳羡，故园依晋陵。\n秋风滆湖白，春色颐山青。\n一从绅笏去，遂使猿鹤惊。\n迂疏暗时机，孱琐叨官荣。\n谪弃分所宜，愧恧颜已盈。\n人生讵有几，世累吾方轻。\n愿言解羁绁，上疏还簪缨。\n宁居召魂魄，恬养休性情。\n纷华屏外慕，冲澹严中扃。\n穷年伴农圃，毕志先畴耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹岩","author":"蒋之奇","text":"零陵水石天下闻，澹山之胜难具论。\n初从崖口入地底，始见殿阁开重门。\n乃知兹洞最殊绝，洞中金碧开祇园。\n宽平可容万人坐，仰视有若覆盎盆。\n虚明最宜朝日照，阴晦常有黑云屯。\n盘虬夭矫垂乳下，巨兽突兀巨石蹲。\n木香一株在岩壁，人迹峭绝不可扪。\n灵仙飞游享此供，常驾飙驭乘云轩。\n我来正逢春雨霁，氛翳开廓阳景温。\n呀然双穴露天半，笼络万象将并吞。\n只疑七窍混沌在，五窍忘失两窍存。\n神奇遗迹未泯灭，至今犹有斧凿痕。\n云床石屏极隈隩，昔有居士常潜蟠。\n避秦不出傲徵召，美名遂入贤水源。\n咸通曾为二蛇窟，元畅演法蛇辄迁。\n从兹其中建佛刹，栖隐不复闻世喧。\n惜哉此景久埋没，但与赤子安枯禅。\n次山子厚爱山水，探索幽隐穷晨昏。\n朝阳迫迮若就狴，石角秃鬝如朝髡。\n豪篇矜誇过其实，称誉珉石为玙璠。\n环观珍宝欲奄有，不到胜处天所悭。\n嗟予至此骇未睹，不暇称赞徒惊叹。\n恨无雄文压奇怪，好事略与二子班。\n芜词愿勒岩上石，勿使岁久词灭漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清光亭","author":"蒋之奇","text":"郑圃仆射陂，汉阳郎官湖。\n郎官何为名，张谓佩使符。\n泛觞江城南，乃与太白俱。\n明月一万顷，清光天下无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萍乡即事","author":"蒋之奇","text":"地接长沙近，乡名自古闻。\n毛山千嶂雪，玉女一堆云。\n拱木扶霄上，飞泉触石分。\n霜风萍实老，目断楚江濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重湖阁","author":"蒋之奇","text":"宫亭彭蠡接扬澜，浩荡横空六月寒。\n试问风波何以险，老僧只管倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水西示刘尉","author":"蒋之奇","text":"役役尘埃倦客情，偶逢佳节得闲行。\n凭君为把如椽笔，便向苍崖记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题到氏田舍","author":"蒋之奇","text":"六朝冠盖俱尘土，到氏今无苗裔存。\n当时任昉过田舍，野老犹记查林村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南雄昌乐驿","author":"蒋之奇","text":"城东浈水碧渊洄，杨仆楼船向此来。\n我亦编蓬今下濑，拟寻韶石上崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]