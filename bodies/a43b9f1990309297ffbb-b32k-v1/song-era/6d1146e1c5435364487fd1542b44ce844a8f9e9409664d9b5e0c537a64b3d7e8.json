[{"title":"颂古十首 其九","author":"释慧空","text":"叵耐沩山老鬼精，垂钩便要钓鲲鲸。\n几多头角为龙去，虾蟹依前努眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其六","author":"释慧空","text":"连马连人劈一刀，虚空迸血涌波涛。\n千千万万人争看，谁解分开盖胆毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其八","author":"释慧空","text":"法法本来法，无法无非法。\n何于一法中，有法有不法。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢丹山秀首座竹筇 其一","author":"释慧空","text":"老身一衲百无营，病骨人惊太瘦生。\n多谢枝筇解扶我，松阴石上听溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧知微以布衫送寿昌可师有偈答之戏成四首 其四","author":"释慧空","text":"普贤高系象王裤，妙德长拖师子衫。\n遣向寿昌为侍者，一人不肯一人甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧知微以布衫送寿昌可师有偈答之戏成四首 其三","author":"释慧空","text":"寸丝不挂鱼游网，万善严身月入云。\n若是寿昌端的处，明年一领更烦君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧知微以布衫送寿昌可师有偈答之戏成四首 其二","author":"释慧空","text":"著时人显衫还隐，不著人亡衫却存。\n隐显存亡是何物，黄金铸出铁昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧知微以布衫送寿昌可师有偈答之戏成四首 其一","author":"释慧空","text":"一物全无尽力担，相逢江北又江南。\n向来贴肉那堪语，更著渠侬一布衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与郛郎作骨董羹四首 其二","author":"释慧空","text":"诗人说尽山中佳，一原春色秦人家。\n松自宫商竹自羽，空明楼观溪明霞。\n微言到耳万世事，香气熏人百种花。\n同栏立尽听吾语，蟹眼汤成催客茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与梦石分岁","author":"释慧空","text":"岁尽人人有可分，翁今分岁亦随群。\n饼翻溪上团团月，鲙缕檐间细细云。\n漱壑醴泉春万斛，堆槃珠柳雪千斤。\n两翁一饱风颠在，倦仆饥僮总未闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与皓副寺","author":"释慧空","text":"衲僧之勇惟法战，铁作浑身犹百炼。\n不知谁是取雠家，直入南方行一转。\n上门上户眼如铃，有么有么机如电。\n剔起便行何处寻，声前句后新罗箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日示众","author":"释慧空","text":"青帝一微笑，恩光遍刹尘。\n如何百草上，刚有未明人。\n人人当节令，合故竟开新。\n东山拄杖子，也自黑粼皴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送可师归西山兼简法华无證","author":"释慧空","text":"半世几离合，翛然无住身。\n又为一去客，元是再来人。\n野宿风鸣雪，江行梅破春。\n两翁如问我，为话鬓毛新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪堂仍旧老师和予送可师新字韵见招复作五首寄之兼呈无證 其二","author":"释慧空","text":"不触波澜手，而彰名句身。\n向来天上寺，得此眼中人。\n一别湘湖路，三回岭海春。\n何时清夜坐，听我话韶新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪堂仍旧老师和予送可师新字韵见招复作五首寄之兼呈无證 其五","author":"释慧空","text":"木蛇头带角，古路独横身。\n大有傍观者，初无踏著人。\n病来思自养，此去或同春。\n送老须何物，窗明贝叶新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪堂仍旧老师和予送可师新字韵见招复作五首寄之兼呈无證 其三","author":"释慧空","text":"干戈平定日，湖海倦游身。\n况得君为社，招呼我辈人。\n初无家似燕，宜有喜如春。\n悬想西山下，雨馀钟鼓新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪堂仍旧老师和予送可师新字韵见招复作五首寄之兼呈无證 其四","author":"释慧空","text":"妙湛清虚理，芭蕉立井身。\n惟君俱得地，独我不如人。\n书辱寒温问，茶分安乐春。\n殷勤拜佳赐，自汲井花新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪堂仍旧老师和予送可师新字韵见招复作五首寄之兼呈无證 其一","author":"释慧空","text":"梦历百城路，笑翻床上身。\n惟应个些子，所以见吾人。\n玉蕴西山重，花开南浦春。\n异时冰雪里，仍旧一枝新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞草堂老师归闽","author":"释慧空","text":"短筇初把探深深，展尽神机被陆沉。\n搦杀未偿当日恨，翻身谁识此时心。\n不离左右金为土，别有生涯土作金。\n既去后来应请问，莫言曾到此山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静香轩","author":"释慧空","text":"种竹竹既立，艺兰兰亦芳。\n炉熏安用许，静极自生香。\n十客九常在，古人今不忘。\n如何杜陵老，独喜赞公房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又用前韵送僧","author":"释慧空","text":"空王子，出空门，敏于选佛讷于言。\n老少同科无异学，尽倾阿耨作词源。\n龙虎榜，辉乾坤，一字元无作么分。\n汝见是汝为第一，我见是我作状元。\n有惊群，有独脱，可中丹桂和根拔。\n把作枯柴灶里烧，谁能更著空王褐。\n只如剑，成家活，不犯锋铓有生杀。\n莫似章分句解徒，望却龙门头蘖蘖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又送出闽","author":"释慧空","text":"老人入我闽中居，如山有玉渊有珠。\n老人一日出山去，崖不自灵渊亦枯。\n我问天冠千眷属，如何不留老尊宿。\n飞鸾水急海天横，一道清辉照四明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与沔上人","author":"释慧空","text":"参禅无悟处，如何得安乐。\n置之空劫前，即为空劫缚。\n任运日用中，拶著无不错。\n懵然百不理，奈此一络索。\n勇猛积勋修，翻成大过恶。\n端坐审思惟，不如更行脚。\n东山老病汉，闻之为喜跃。\n愿尔发足时，出门便蹈著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与性上人","author":"释慧空","text":"汝知东山空，胸中无窖子。\n说禅瞎人眼，书偈污人纸。\n不知禅家流，于空何所取。\n脚要汝自行，死要汝自死。\n道不假他成，佛岂离自己。\n唯有老赵州，平生一则语。\n既是其中人，东山与之举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与郛郎作骨董羹四首 其四","author":"释慧空","text":"上天既雨晴亦佳，黄云满垄金满家。\n政须与子加餐饭，何苦预人三咽霞。\n今年明年吾自老，十日五日梅当花。\n岂无诗力禦强敌，已作睡魔闻酽茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与郛郎作骨董羹四首 其三","author":"释慧空","text":"寒士百菹食藉佳，敢比八珍五侯家。\n分甘长贫体生粟，谁能一饱面发霞。\n自羹青松烧芦菔，更杂石耳相天花。\n愿留佳士宿清昼，细引炉香深炷茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与郛郎作骨董羹四首 其一","author":"释慧空","text":"诗人例穷无可佳，借蔬贷粟东西家。\n胸中一字不疗馁，奈此满箧皆云霞。\n郛郎之贫亦相似，眼高视世如空花。\n两翁相值且相煦，薄糁藜羹终胜茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与虚上人","author":"释慧空","text":"止渴须是水，止饥须是饭。\n参禅须是悟，成佛不待旦。\n伽陀有底急，休来问老汉。\n既来无奈何，拄杖蓦头撺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大士讲经","author":"释慧空","text":"两口明明一无舌，同死同生为吾决。\n那吒顶上吃蒺藜，金刚脚下流出血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝德上人莫作言语","author":"释慧空","text":"凡物得其时则鸣，鸣之大者唯雷霆。\n使雷常鸣不以节，人忘修省孰震惊。\n往时耆年深此旨，十度发言九度已。\n更有宝云多口师，每见僧来面壁耳。\n岂似而今文字禅，骈头并驾争后先。\n愿公藏此千钧重，等闲不射射必中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尤溪补陀岩","author":"释慧空","text":"岩下溪声倾法雨，岩头云树耸华冠。\n游人不入普门境，只作青山绿水看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巨风行 其一","author":"释慧空","text":"海山一雨三日风，折木举屋如飞蓬。\n路人惊窜居人泣，平地乃是洪涛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巨风行 其二","author":"释慧空","text":"有生何处得安稳，方寸是为风火本。\n看来出尔方寸间，雨霁风休海天远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无规矩","author":"释慧空","text":"赫日光中强作主，忽然霹雳声中死。\n仰观不见太虚空，俯视分明无寸土。\n跨瞎驴，追猛虎，百战场中有文武。\n老来信手斫方圆，从教人笑无规矩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至","author":"释慧空","text":"冬后一阳生，东君曾未睹。\n百草总不知，梅花先漏泄。\n钟声出远林，雁阵横残月。\n更拟问如何，弄巧翻成拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其七","author":"释慧空","text":"坐，鼻孔婪巉眼睛大。\n也有人，一见横趋过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其一","author":"释慧空","text":"行，忘其粗操得人憎。\n一举足，趯倒佛前灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其五","author":"释慧空","text":"行，两袖清风一瘦藤。\n人见玩，南寺打斋僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其四","author":"释慧空","text":"卧，合眼乾坤都盖过。\n没人知，晨鸡刚说破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其八","author":"释慧空","text":"卧，鼻息雷鸣撼邻座。\n忽翻身，铁蛇横大道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其三","author":"释慧空","text":"坐，入夏嚫钱无一个。\n催免丁，县里公人到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其六","author":"释慧空","text":"住，五合黄陈半瓢醋。\n见客来，般般皆要做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四威仪 其二","author":"释慧空","text":"住，对火浩歌敲火筋。\n有客来，炉中出煨芋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四景 其一","author":"释慧空","text":"沙寒雪后天，凫雁将俦侣。\n独怪蓑笠翁，维舟一归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四景 其四","author":"释慧空","text":"快霁初无象，豁然千里间。\n十年归客眼，一点沃洲山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听雨亭","author":"释慧空","text":"我行台雁之中途，一年两憩安公庐。\n不知昔人去此远，但见水石清而虚。\n向来颇读有则语，悬水潇潇日夜举。\n道人似欲暗投明，故立此亭名听雨。\n客如镜清老更痴，入流截流谁得知。\n愿公竹扉且常启，我或发兴来无时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟山居","author":"释慧空","text":"古人缚屋山头住，十年不行山下路。\n终朝两眼挂枯松，不忧无米但觅句。\n满屋风声合雨声，半壁山云杂山雾。\n于中只么过此生，犹胜时人三五步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泐潭暹上人出示延福颂古三首索鄙语因用其韵赠之 其一","author":"释慧空","text":"马驹踏杀天下人，炙地熏天气转腥。\n百岁翁翁开口笑，江西从此足人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泐潭暹上人出示延福颂古三首索鄙语因用其韵赠之 其二","author":"释慧空","text":"引鼻牵回野鸭儿，升堂卷席便高飞。\n后来要识吾宗旨，试看而今是甚时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泐潭暹上人出示延福颂古三首索鄙语因用其韵赠之 其三","author":"释慧空","text":"千年滞货无人顾，拈起从教著价看。\n一口直饶酬得过，泐潭山更过西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和无在木蛇歌","author":"释慧空","text":"小小蛇儿大大身，曾吞众象空巴陵。\n归蟠故山骨欲槁，混入草木人更徵。\n瞎屡生，甚手脚，不善提持休捉摸。\n枯木形骸似等闲，触著伤人毒无药。\n寿昌师，怜老病，远远遣来相问讯。\n拟欲庵头伴老夫，预忧十月霜风劲。\n著把火，津送渠，依旧令教侍坐隅。\n重告之曰，蛇乎蛇乎，当如云门应机忽突出，莫学严阳到老安其庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和直指春日未众 其一","author":"释慧空","text":"庵前乌龟久不见，一夜雷雨忽然出。\n东山老汉眼■痴，近前问讯定光佛。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和直指春日未众 其二","author":"释慧空","text":"直指示众重说偈，瞿昙舍身得其半。\n东山和出一字无，擘破面门君自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和慧知微雪韵","author":"释慧空","text":"覆盖乾坤似有功，洞然明白却无踪。\n其如未识无踪意，屑玉霏霏落眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋直指因吃粽与兄弟论铁酸豏金刚圈栗棘蓬话作三偈见寄合为一偈酬之","author":"释慧空","text":"直指吃粽被粽赚，吐出多年铁酸豏。\n俊鹰才见插天飞，饿狗床根争咂啖。\n忽然变作蒲与圈，鹰也迷踪狗也奔。\n百年滞货无人要，千里持来访我门。\n象牙不出老鼠口，富贵或生穷相手。\n倒把春风二月花，满劝松斋一杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空王子","author":"释慧空","text":"空王子之空而灵，拈起钵饭忘了羹。\n一生看经不识字，总十二部为一句。\n一生说禅不动口，喷嚏也成师子吼。\n阿呵呵，黄面瞿昙争奈何。\n咄咄咄，是甚衲僧臭皮袜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南华利侍者持炳和尚语至疏山请校入版乃作偈送之谒序于徐大资","author":"释慧空","text":"曹溪大士出现世，谁其侍者道人利。\n雷轰电激槌拂间，涓滴无遗水传器。\n而今底事难覆藏，盖是火后茎茅长。\n未言字字负此老，且要浩浩流诸方。\n最初有个譊讹处，遍示知音著何语。\n东山有语人未知，请问东湖老居士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南询歌","author":"释慧空","text":"南询士，标致殊，发言落落中疏疏。\n瘦藤一握铁相似，孤身万里云不如。\n作者前，致一问，分明直得绳床震。\n失脚踏翻楼阁门，通身不挂毗卢印。\n佛祖言，甚热椀，一剑当头百非刬。\n大展禅宗定古今，火里蝍蟟三只眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽岩头陀求化","author":"释慧空","text":"火后幽岩山，中有四在句。\n院在要人兴，钟在要人铸。\n道在要人行，佛在要人做。\n头陀寒拾流，四句尽分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽岩禅师真赞","author":"释慧空","text":"一字不著划，古锦写回文。\n寒山指拾得，斗柄插雷门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某得银杏不食种之庵前见者曰是三十年乃生公老矣能待之乎某不答作曰","author":"释慧空","text":"蟠桃一实三千年，银杏著子三十载。\n老僧只作旦暮看，汝莫匆匆宜少待。\n阶前始芽今出屋，便是携篮走僮仆。\n伴我东园看菜归，与汝煎茶剥柔玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂老师真赞","author":"释慧空","text":"随随昔昔，是这个贼。\n簸土扬尘，驰南走北。\n一棒打杀，狗也不吃。\n后来不肖儿孙，个个一模脱出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览印无在语","author":"释慧空","text":"老胡遗下一则语，匝地普天无不举。\n倾湫倒岳是家常，物义不伤多莽卤。\n螗螂莫笑夏蜩痴，甘草酷似黄连苦。\n黄连苦，南泉不打盐官鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览妙喜和尚衡阳示众","author":"释慧空","text":"海蚌直儱侗，不类海蠡儿。\n开口便见胆，也好与一槌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览赵州语","author":"释慧空","text":"赵州借得空生口，便自纵横师子吼。\n问其佛性狗子无，问其甲子苏州有。\n而今此口还空生，古佛依前成漏逗。\n掀翻海岳觅知音，个个看来日中斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送二僧之衡阳 其二","author":"释慧空","text":"衡阳老子一僧耳，打雨骂风无别伎。\n海上禅流未识渠，将谓三头仍六臂。\n两川迈往初不然，我喜其行重说偈。\n披秀庵前癞狗儿，要见衡阳只这是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送二僧之衡阳 其一","author":"释慧空","text":"闽蜀同风果同风，袈裟拔出鞋袋中。\n相逢古寺话俄顷，怪我称锤落深井。\n不忧佛日居衡阳，不忧无人振颓纲。\n却忧秋高霜月冷，铁牛夜度飞猿岭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送巾扇街坊","author":"释慧空","text":"华巾未解心中结，阿难有理难伸说。\n犀牛扇破索牛儿，盐官为物心偏切。\n上人幸是手眼亲，独用双拈此时节。\n一条秋水净无痕，八面清风消恼热。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]