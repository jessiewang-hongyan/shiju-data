[{"title":"春荫","author":"方岳","text":"玲珑碧树巧临池，影在窗前作么移。\n水墨画图春淡淡，莺花庭院日迟迟。\n不妨明月重相忆，怎许浮云浪得知。\n一片舞裀攲弱柳，风来时复托腰肢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨","author":"方岳","text":"茅斋坚坐日日雨，竹杖长閒处处苔。\n半面不曾梅别去，四愁无奈草生来。\n好山能费几两屐，胜日须倾三百杯。\n说与海棠毋造次，不论蚤晚待晴开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浇花","author":"方岳","text":"篱落花无赖，春寒手自治。\n但留根本在，终有发生时。\n雨露曾何择，山林未易移。\n吾知勤抱瓮，一任化工为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独往","author":"方岳","text":"黄冠野服随孤鹤，竹径松冈共往还。\n不肯避人当道笋，相看如客对门山。\n穷居作计未为左，造物于吾本不悭。\n径扫石床供昼寝，自怜诗骨尚坚顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸丑人日","author":"方岳","text":"上七日为人，云蒸涧壑春。\n入山从此始，得句不知贫。\n宿雨行泉脉，归禽隐树身。\n无人闲似我，野荠共时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晓登山","author":"方岳","text":"发兴在丘林，其如老见寻。\n身馀持蟹手，脚负看山心。\n秋色苍厓暝，晓篱黄叶深。\n惟应负苓者，来往古松阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种松先公墓下","author":"方岳","text":"一壑风衰二十秋，俛行诘曲翳松楸。\n冢前无路草欲没，泉下有知山亦愁。\n翁仲不言关气运，衣冠如在想神游。\n何年夹道虬龙侣，泪湿春泥儿白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种桂","author":"方岳","text":"山翁不办碧油幢，办与秋风斸老桩。\n嚼雪未论香世界，眠云已惬月轩窗。\n谁分兔臼玉千杵，不费鸿门璧一双。\n蚤晚乘槎问银汉，呼童多酿酒成缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种瑞香","author":"方岳","text":"自种幽香傍短棂，荷锄政用雨冥冥。\n山家安得瑞龙脑，春事不专红鹤翎。\n持向东风论甲乙，与遮西日费丁宁。\n何年得似熏笼锦，茗盌时时为乞灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡得唯索写近诗","author":"方岳","text":"生涯未办阔疏酒，书册相携检点梅。\n过眼事真如堕甑，向人口合且衔枚。\n昨窥古镜十分瘦，病起晴窗一砚埃。\n举世好竽吾好瑟，故人犹索写诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵龙学寄阳羡茶为汲蜀井对琼花烹之","author":"方岳","text":"三印谁分阳羡茶，自煎蜀井瀹琼花。\n数间明月玉川屋，两腋清风银汉槎。\n团凤烹来奴仆等，老龙毕竟当行家。\n相思几梦山阴雪，搜搅平生书五车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵制使宴吴宣参致语口号","author":"方岳","text":"二老风襟了不群，笑谈自可却尘氛。\n词臣旧奏平淮颂，里老今传谕蜀文。\n吴国隐然如一敌，赵边足以张三军。\n英辞整顿乾坤酒，捷羽飞来共策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵尉送菜 其一","author":"方岳","text":"岂可常贫料此翁，斋盂顿有玉珑松。\n春山药草能同饭，夜雨茅堂未缺供。\n杞菊共传寒绿赋，柴桑不隔紫霄峰。\n冰瓷嚼出宫商羽，一洗人间芥蒂胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵尉送菜 其二","author":"方岳","text":"山云一坞住山翁，菘韭成畦带雪松。\n飞食肉奚关我事，乳蒸豚亦为谁供。\n衡茅高枕人间世，蓑笠归锄雨外峰。\n曾读坡公菜羹赋，断无尘土到奇胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵尉催筑秋崖","author":"方岳","text":"只尔三间屋，吾贫未易云。\n与山先定谥，有客屡移文。\n竹喜今年活，梅从隔坞闻。\n犹嫌灌园力，多为读书分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子用弟游学番昜","author":"方岳","text":"顿觉溪流滑，番湖草欲春。\n船轻携砚易，家近寄书频。\n山雨同离别，寒窗自宠珍。\n但于灯火夜，报子倚门亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王尉归觐 其二","author":"方岳","text":"不以登朝急，归欤有母慈。\n新炊甘野荠，秋思老江蓠。\n薄宦惟琴在，孤征与月随。\n几时湖上去，吾欲报鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王尉归觐 其一","author":"方岳","text":"喜有吟诗癖，吾侪得往还。\n客惟依竹语，官只似僧閒。\n夜雨灯谁共，秋厓藁未删。\n柴门黄叶下，别后正须关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史子贯归觐且迎妇也","author":"方岳","text":"久住西湖梦亦佳，鹭朋鸥侣自烟沙。\n江行枫叶几何里，春到梅梢次第花。\n尽有好山容对榻，却因吾子转思家。\n青灯书册夜深雨，莫为乘鸾学画鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘子范倅宜春","author":"方岳","text":"一念到吾亲，人间万事轻。\n邻州才半刺，行李只诸生。\n问路重阳雨，迎家两日程。\n笑谈灯火夜，边雁自秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕提干并简谢泉","author":"方岳","text":"山云一夜雨，稳放过阊船。\n坑发宁遗圹，民贫不为钱。\n范碑秋寺古，楚观暮江前。\n寄谢东山老，灵砂并欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送寺丞韩君守新安 其二","author":"方岳","text":"吾州可但佳山水，薰沐诗书自不同。\n牧守曾留今相国，郡人况有我文公。\n诸贤雅欲相俎豆，一念底须多缿筒。\n三十六峰吟更笔，只将无事过年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送寺丞韩君守新安 其一","author":"方岳","text":"君家集有陆参序，老笔誇张歙大州。\n三百年来非昔比，二千石喜得今侯。\n早田已槁曾关念，旧石虽奇不到收。\n沃沃桑麻山雨外，归欤氓亦买羸牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别史佥","author":"方岳","text":"二月寒如此，君胡不少留。\n夕阳随水去，春草泥人愁。\n江上三年别，诗边两鬓秋。\n折腰贫尚尔，天地一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别季观","author":"方岳","text":"山留迁客秋风寺，想得梧桐怨夜长。\n正欠蹇驴相就语，其如征燕欲归忙。\n蘋花思与晴江渺，桂树寒生老月香。\n一路有诗烦拾取，寄书犹及雁前霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别赵尉","author":"方岳","text":"细草轻烟画出愁，一船明月大刀头。\n苔痕欲暗蓝田记，枫叶正寒江渚楼。\n无酒可浇鹦鹉赋，有山频典鹔鹴裘。\n功名正恐不免耳，拄笏练溪南北秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别薛丞 其一","author":"方岳","text":"肯为祁山住，晴浮草木春。\n溪晴随砚转，心远与鸥亲。\n几佐弦歌旧，宁矜硎刃新。\n萧规元好在，传语憩棠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别薛丞 其二","author":"方岳","text":"题遍南墙玉，与春相伴归。\n花明晴岸阔，帆转暮江肥。\n鹃老催红药，云香近紫微。\n樯竿两燕子，也带笑声飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送应武谕倅庐陵","author":"方岳","text":"乞倅庐陵郡，予为第一人。\n天悭终未肯，人好自相亲。\n诸老诗书在，平园草木春。\n鸥朋嘲薄分，山屐蚀京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客","author":"方岳","text":"瘦马孤征雪满衣，山长谁不念庭闱。\n灯寒竹屋无人共，月到梅花有梦归。\n抵掌相逢连夕语，转头顿觉十年非。\n武夷人老君行矣，莫待墨池春浪肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春","author":"方岳","text":"不等薰风已问津，小楼无处认蹄轮。\n极知中岁难为别，未必明朝不是春。\n黄鸟闹时山寂寂，绿阴深处水粼粼。\n老来宁与芳菲竞，俯仰人间迹已陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送留圯父寺簿倅严","author":"方岳","text":"才立班行便佐州，九年回首不渠留。\n千峰榭与柯山对，七里滩从严子游。\n未用笑谈惊五马，只销诗句狎双鸥。\n团纲殿最非吾事，夜半一编归借筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章监丞守广信 其二","author":"方岳","text":"勇去何为者，寻盟少可人。\n雁声江国晓，梅蕊雪篱春。\n同舍谁如子，为州独有亲。\n月岩吟处碧，物物是吾仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章监丞守广信 其一","author":"方岳","text":"近世无佳郡，中朝有此公。\n再三疑坏證，第一是贪风。\n野雪深耕耒，春苔蚀缿筒。\n龚黄只如此，为问玉山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程伯茂佥书武昌","author":"方岳","text":"平时浪说笔如杠，谁不玉堂云雾窗。\n采石月明才夜讲，武昌鱼美又春江。\n洲横鹦鹉天为限，灶列貔貅阵未降。\n重国西门烦老檄，秋风莫倚暗埋桩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蔡子奇节推之官庐陵","author":"方岳","text":"春不多寒风已柔，数君到日正红稠。\n庵藏澹叟诗成集，山护醉翁书满楼。\n岸柳欲眠维鹢首，幕莲俱起看鳌头。\n无忘晓殿三千字，一洗公孙富贵羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送滕广叔铨试","author":"方岳","text":"矮屋曾分雪夜灯，相期各已上青冥。\n得官谁谓非黄甲，如我今犹祇白丁。\n别久不论清浊酒，情亲或梦短长亭。\n一生科目十名上，自有君家旧典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡宅旧有飞泉湮废不治予接竹重理之","author":"方岳","text":"竹泉重理旧潺湲，能费亭前玉几竿。\n云卧半檐晴亦雨，雪飞六月午犹寒。\n野人久有烟霞癖，官屋何如天地宽。\n白傅极知儿戏耳，一生水石作奇观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳","author":"方岳","text":"古岸维舟夜，萧萧秋叶丹。\n野烟连竹暗，江雨洒灯寒。\n亦喜重阳健，谁知行路难。\n吾亲应念我，更把菊花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重题钓台","author":"方岳","text":"落帆曾傍芦花宿，借得先生月一滩。\n鸥鸟未忘吾道在，江山肯作故人看。\n树昏断岸潮声急，雪洗孤台石罅寒。\n最喜吾宗诗有派，每依苍石插樯竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻罢","author":"方岳","text":"面骨岩棱不入流，放归何止四宜休。\n束书自可供儿读，斗酒聊须与妇谋。\n旧藁如山应有误，老夫于世本无求。\n一犁春雨平生事，莫与诸公作话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其八","author":"方岳","text":"守岁团栾谢两侯，堆盘水陆有珍投。\n鲟香透白琼瑶片，虾醉殷红玛瑙钩。\n湩酪远分闽峤雪，枝柑犹带石桥秋。\n老饕兀兀陶陶外，一笑人间百事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其一","author":"方岳","text":"生菜春盘草八珍，灯前殊未觉家贫。\n几多荼垒中间事，第一屠苏最后人。\n衰病不图今夕健，须臾又是隔年春。\n东风自此无閒暇，万里乾坤一夜新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其十","author":"方岳","text":"追风逐月费攀跻，苒苒流光欲乳羝。\n命薄最于穷鬼厚，气高不为贵人低。\n交情安得玉连琐，世路真同铁蒺藜。\n未及龙钟且行乐，池塘吹绿又萋萋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其七","author":"方岳","text":"家世无年事可知，况吾久矣叹吾衰。\n玉丸不住岁华老，铁砚未穿筋力疲。\n一笛跨牛终寂寞，万钱骑鹤两参差。\n年年此夕椒花颂，能费先生几首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其四","author":"方岳","text":"当年意气亦堪悲，岁晚胸怀只自知。\n十有九分天不管，百无一遂老如期。\n灯寒夜雪渔蓬屋，春共梅花野竹篱。\n衰白东风那解绿，底须苦向鬓边吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其六","author":"方岳","text":"一枝紫竹两青鞋，只么穷年亦自佳。\n理乱不知閒世界，浮休自若老情怀。\n竹居可使食无肉，草具宁须菜与鲑。\n春入灯花供别岁，葛巾随分对荆钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其三","author":"方岳","text":"一牛西崦又东皋，独宿中年共作劳。\n世事略如云变灭，人生未抵玉坚牢。\n山林性气与时背，霜雪髭须得酒豪。\n野屋难为春帖子，自研冰雪写离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其五","author":"方岳","text":"薄薄村醪旋旋篘，一杯又了一年愁。\n化为道士前身鹤，驱向禅林露地牛。\n今我何如惟老圃，古人安在亦荒丘。\n牡丹且莫相孤负，已为春风著小楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其九","author":"方岳","text":"短发萧萧老侍祠，夜坛三上华封辞。\n皇储天启重轮日，帝座春环万寿卮。\n材具不供当世用，林居亦望太平时。\n羽衣舞手香如雾，报答空餐但祝釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕 其二","author":"方岳","text":"梅花绕屋柳遮门，不是闾阎不是村。\n归寄柴桑人自老，就荒松菊径犹存。\n事关时命才何与，技止文章道未尊。\n灯火半生堪底用，只将黄犊教吾孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除日雪甚约客不至乃拥貂骤马于郊外独饮摘星楼举鞭谢客曰未可使城中诸公知之但当誇与灞桥驴子上郑五耳","author":"方岳","text":"扬州二十四桥月，莫作灞桥同调看。\n诗果位登银色界，酒风流倚玉阑干。\n六花比似琼花巧，一岁翻成两岁寒。\n明日屠苏催短鬓，过从更觉欠袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其一","author":"方岳","text":"年华三百六十日，尘劳八万四千门。\n高眠茅屋人亦老，相对梅花灯欲昏。\n静中颇窥造物意，极处是为天地根。\n生菜春盘一杯酒，明朝花柳又村村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜","author":"方岳","text":"雪瓮冰齑了岁除，停杯且听话迂疏。\n山居虽窄可无竹，家计甚贫犹有书。\n但觉是非惊化鹤，不将喜怒等群狙。\n耦耕久与邻翁约，春雨宁辞手拮据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其二","author":"方岳","text":"挑尽寒灯岁又残，一年弹指几悲欢。\n人情何啻吴江冷，世路从来蜀道难。\n春酒正须今夕共，梅花并作百年看。\n团栾但得吾亲健，未办生涯意自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜宿桐庐","author":"方岳","text":"才有佳山便歇程，岛烟汀雨正关情。\n世于吾道亦聊尔，我与梅花各瘦生。\n无处不曾供夜话，有田谁肯废春耕。\n年华俱在客中过，只为天公乞一晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食猫笋","author":"方岳","text":"此君乃有宁馨儿，犀角丰盈玉不如。\n老去烟姿元耸壑，生来风骨已专车。\n诗肠惯识猫头笋，食指宁知熊掌鱼。\n莫遣匆匆上竿绿，一春心事政关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其十","author":"方岳","text":"吾亦爱吾贫，樵山采堕薪。\n百年双短鬓，九职一閒民。\n秋蔓茶僧老，春泓酒母淳。\n两生谁可致，此外不关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其九","author":"方岳","text":"谷口岂其卿，胡然朝市争。\n远山长晚色，幽鸟乍春声。\n老觉人情薄，閒于世累轻。\n早红香可饭，何必又鱼羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其八","author":"方岳","text":"寂寞断过从，行山又一重。\n烟村秋色画，茅屋夕阳舂。\n得句多题竹，观书半倚松。\n心閒身已老，悔不早归农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其七","author":"方岳","text":"经月魃为妖，连宵雨似潮。\n山田禾侧耳，野涨树平腰。\n古语天难做，民生日不聊。\n忍饥吾亦惯，古色一箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其五","author":"方岳","text":"捲雨对遥岑，诗寒不自禁。\n猿猱三径小，虎豹九关深。\n道眼虚空界，閒身自在心。\n荷锄今亦倦，年与病相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其四","author":"方岳","text":"松露滴深幽，山寒草径秋。\n蔓藤行伏兔，野竹上牵牛。\n日月双车毂，乾坤一传邮。\n功名成底事，何苦觅封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其三","author":"方岳","text":"有客共攒眉，蚕丛事可悲。\n渡泸诸葛表，哀汴老韩诗。\n谁又青冥钺，吾方白接䍦。\n神谟自坚定，豺虎莫恫疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其二","author":"方岳","text":"尽日此徘徊，青粘两屦苔。\n鸟声穿户去，暝色过溪来。\n象齿劙鞭茁，银刀罾绘材。\n空山人自老，醉眼向谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其一","author":"方岳","text":"云木上苍冥，行藏只草亭。\n雁随秋到早，山入市来青。\n投老馀渔具，能诗例鹤形。\n发根风露入，肺渴喜初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐律十首 其六","author":"方岳","text":"老去脚犹轻，吟边不杖行。\n孤亭深野色，高木易秋声。\n岁事才中熟，山居亦太平。\n不辞遭泥饮，谨勿杀能鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]