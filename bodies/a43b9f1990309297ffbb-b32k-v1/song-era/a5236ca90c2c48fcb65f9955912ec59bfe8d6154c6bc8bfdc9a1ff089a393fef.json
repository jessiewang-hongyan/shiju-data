[{"title":"量力吟","author":"邵雍","text":"量力动时无悔吝，随宜乐处省营为。\n须求骐骥方乘马，亦恐终身无马骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事吟","author":"邵雍","text":"蛇头蝎尾不相同，毒杀人多始是功。\n风月四时无限好，莫将闲事挠胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感雪吟","author":"邵雍","text":"旨酒嘉肴与管弦，通宵鼎沸乐丰年。\n侯门深处还知否，百万流民在露天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁烟留题锦屏山下四首 其四","author":"邵雍","text":"春半花开百万般，东风近日恶摧残。\n可怜桃李性温厚，吹尽都无一句言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁烟留题锦屏山下四首 其三","author":"邵雍","text":"无涯桃李待清明，经岁方能开得成。\n不念化工曾著力，狂风何故苦相凌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁烟留题锦屏山下四首 其二","author":"邵雍","text":"寒食风烟锦屏下，凭高把酒兴何如。\n满川桃李方妍媚，不忍重为风破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁烟留题锦屏山下四首 其一","author":"邵雍","text":"满川桃李弄芳妍，不忍重为风所残。\n忍使一年春遂去，尽凭高处与盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窥开吟 其十","author":"邵雍","text":"物理窥开后，人情照破休。\n止堪初看望，不可久延留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四皓庙四首 其四","author":"邵雍","text":"田横入海犹能得，商至长安百里强。\n能使四人成美节，始知高祖是真王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四皓庙四首 其三","author":"邵雍","text":"汉皇傲物终难屈，太子卑辞方肯出。\n虽老犹能成大功，至今高义如星日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四皓庙四首 其二","author":"邵雍","text":"灞上真人既已翔，四人相顾都无语。\n徐云天命自有归，不若追踪巢与许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题四皓庙四首 其一","author":"邵雍","text":"强秦失御血横流，天下求君君不有。\n正是英雄较逐时，未知鹿入何人手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其十","author":"邵雍","text":"若履暴荣须暴辱，既经多喜必多忧。\n功成能让封王印，世世长为列土侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其九","author":"邵雍","text":"韩信恃功前虑寡，汉皇负德尚权安。\n幽囚必欲擒来斩，固要加诸甚不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其八","author":"邵雍","text":"汉家基定议功勋，异姓封王有五人。\n不似淮阴最雄杰，敢教根固又生秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其七","author":"邵雍","text":"若非韩信难除项，不得萧何莫制韩。\n天下须知无一手，苟非高祖用萧难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其六","author":"邵雍","text":"虽则有才兼有智，存亡进退处非真。\n五湖依旧烟波在，范蠡无人继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其五","author":"邵雍","text":"韩信事刘元不叛，萧何惑汉竟生疑。\n当初若听蒯通语，高祖功名未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其四","author":"邵雍","text":"一时韩信为良犬，千古萧何作霸臣。\n彼此并干名教罪，罪犹不逮谓斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其三","author":"邵雍","text":"生身既得逢真主，立事何须作假王。\n谁谓祸阶从此始，不宜回首怨高皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其二","author":"邵雍","text":"据立大功非不智，复贪王爵似专愚。\n造成四百年炎汉，才得安宁反受诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题淮阴侯庙十首 其一","author":"邵雍","text":"一身作乱宜从戮，三族全夷似少恩。\n汉道是时初杂霸，萧何王佐殆非尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄河","author":"邵雍","text":"谁言为利多于害，我谓长浑未始清。\n西至昆崙东至海，其间多少不平声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"懒起吟","author":"邵雍","text":"半记不记梦觉后，似愁无愁情倦时。\n拥衾侧卧未忺起，帘外落花撩乱飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瀍河上观杏花回","author":"邵雍","text":"瀍河东看杏花开，花外天津暮却回。\n更把杏花头上插，图人知道看花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"簪花吟","author":"邵雍","text":"簪花犹且强年少，诉酒固非佯小心。\n花好酒嘉情更好，奈何明日病还深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十九日依韵和洛阳陆刚叔主簿见赠","author":"邵雍","text":"一霎萧萧晚雨馀，凤凰楼下偶驱车。\n郤诜片玉知能忆，乐广青天幸未疏。\n相阔夏秋闻甚事，可亲灯火读何书。\n恨无束帛嘉程子，徒自悁悁返弊庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十五日依韵和左藏吴传正寺丞见赠","author":"邵雍","text":"上阳光景好看书，非象之中有坦途。\n良月引归芳草渡，快风飞过洞庭湖。\n不因赤水时时往，焉有黄芽日日娱。\n莫道天津便无事，也须闲处著功夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月吟","author":"邵雍","text":"林下故无知，唯知二月期。\n酒尝新熟后，花赏半开时。\n只有醺酣趣，殊无烂漫悲。\n谁能将此景，长贮在心脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人生长有两般愁","author":"邵雍","text":"人生长有两般愁，愁死愁生未易休。\n或向利中穷力取，或于名上尽心求。\n多思唯恐晚得手，未老已闻先白头。\n我有何功居彼上，其间掉臂独无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六日依韵酬福昌令有寄","author":"邵雍","text":"道义相欢岂易亲，古称难处是知人。\n文章不结市朝士，荣辱非关云水身。\n话入精详皆物理，言无形迹尽天真。\n他时洛社过从辈，图牒中添又一邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十分吟 其二","author":"邵雍","text":"所谓十分人，须有十分事。\n事苟不十分，终是未完备。\n事父尽其心，事兄尽其意。\n事君尽其忠，事师尽其义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又旋风吟二首 其二","author":"邵雍","text":"自是尧夫不善琴，非关天下少知音。\n老年难做少年事，年少不知年老心。\n将养精神便静坐，调停意思喜清吟。\n如何医药不寻访，近日衰躯有病侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又旋风吟二首 其一","author":"邵雍","text":"近日衰躯有病侵，如何医药不求寻。\n轩前密叶自成幄，砌下黄花空散金。\n闲看蜜蜂收蜜意，静观巢燕垒巢心。\n非关天下知音少，自是尧夫不善琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三十年吟","author":"邵雍","text":"三十年间更一世，其间堪笑复堪愁。\n天生天杀何尝尽，人是人非殊未休。\n善偶鸳鸯头早白，能啼杜宇血先流。\n须知却被才为害，及至无才又却忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上寺看南山","author":"邵雍","text":"叠叠是峰峦，西连梁雍宽。\n与其行里看，不若坐中观。\n包括经唐汉，并吞历晋韩。\n消沉事难问，唯尔尚巑岏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞笛竹栽于李少保宅","author":"邵雍","text":"浪种闲花占地生，未尝容易暂留情。\n奈何苦爱凌霜节，况是犹存镂管名。\n待凤至时当有实，学龙吟处岂无声。\n幽人愿乞数枝种，得自君家又更荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小车吟","author":"邵雍","text":"自从三度绝韦编，不读书来十二年。\n大?子中消白日，小车儿上看青天。\n闲为水竹云山主，静得风花雪月权。\n俯仰之间无所愧，任他人谤似神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小春天","author":"邵雍","text":"八月小春天，如人强少年。\n偷生诚有谓，却老固无缘。\n既有神仙术，能回草木妍。\n安知太平日，不得似尧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小圃睡起","author":"邵雍","text":"门外似深山，天真信可还。\n轩裳奔走外，日月往来间。\n有水园亭活，无风草木闲。\n春禽破幽梦，枝上语绵蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"川上观鱼","author":"邵雍","text":"天气冷涵秋，川长鱼正游。\n虽知能避网，犹恐误吞钩。\n已绝登门望，曾无点额忧。\n因思濠上乐，旷达是庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"川上怀旧四首 其四","author":"邵雍","text":"地迥川原阔，村孤烟水闲。\n雷轻龙过浦，云乱雨移山。\n田者荷锄去，渔人背网还。\n伊予独沾湿，犹在道途间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中和吟","author":"邵雍","text":"性亦故无他，须是识中和。\n心上语言少，人间事体多。\n如霖回久旱，似药起沉痾。\n一物尚不了，其如万物何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋月","author":"邵雍","text":"一年一度中秋夜，十度中秋九度阴。\n求满直须当夜半，要明仍候到天心。\n无云照处情非浅，不睡观时意更深。\n徒爱古人诗句好，何堪千里共如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为人吟","author":"邵雍","text":"为人须是与人群，不与人群不尽人。\n大舜与人焉有异，帝尧亲族亦推伦。\n人心龃龉一身病，事体和谐四海春。\n心在四支心是主，四支又复远于身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为客吟 其三","author":"邵雍","text":"忽忆东吴为客日，当年意气乐从游。\n登山未始等闲辍，饮酒何尝容易休。\n万柄荷香经楚甸，一帆风软过扬州。\n追思何异邯郸梦，瞬息光阴三十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为客吟 其二","author":"邵雍","text":"忽忆东朐为客日，壮心初见水云乡。\n岛夷居处邻荒服，潮水来时杂海商。\n卧看苍溟围大块，坐观红日出扶桑。\n虚生虚死人何限，男子之称不易当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为客吟 其一","author":"邵雍","text":"忽忆南秦为客日，洛阳东望隔秦川。\n云山去此二千里，岁月于今十九年。\n柳色得非新婀娜，江声应是旧潺湲。\n衰躯设使能重往，畴昔情怀奈杳然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为善吟","author":"邵雍","text":"人之为善事，善事义当为。\n金石犹能动，鬼神其可欺。\n事须安义命，言必道肝脾。\n莫问身之外，人知与不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事吟","author":"邵雍","text":"他山有石能攻玉，玉未全成老已催。\n有限光阴随事去，无涯衰朽逐人来。\n陶镕情性诗千首，燮理筋骸酒一杯。\n六十六年无事日，心源方始似昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁者吟","author":"邵雍","text":"仁者难逢思有常，平居慎勿恃无伤。\n争先径路机关恶，近后语言滋味长。\n爽口物多须作疾，快心事过必为殃。\n与其病后能求药，不若病前能自防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六十二吟","author":"邵雍","text":"行年六十二康强，况复身居永熟乡。\n道德生辰非易得，浅斟低唱又何妨。\n无涯岁月难拘管，有限形骸莫毁伤。\n多少英雄弄才智，大曾经过恶思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六十三吟","author":"邵雍","text":"行年六十有三岁，齿发虽衰志未衰。\n耻把精神虚作弄，肯将才力妄施为。\n愁闻刮骨声音切，闷见吹毛智数卑。\n珍重至人尝有语，落便宜是得便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内乡兼隐亭","author":"邵雍","text":"兼隐诧来书，于时特起予。\n民淳无讼听，县僻类山居。\n簿领杯盘外，官联谈笑馀。\n不知当此际，傍邑更谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天地吟","author":"邵雍","text":"天人之际岂容针，至理何烦远去寻。\n凶焰炽时焚更烈，恩波流处浸还深。\n长征戍卒思归意，久旱苍生望雨心。\n祸福转来如反掌，可能中夜不沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天宫小阁倚栏","author":"邵雍","text":"六尺残躯病复羸，况堪日日更添衰。\n满怀可惜精明处，一语未能分付时。\n沙里有金然索拣，石中韫玉奈何疑。\n此情牢落西风暮，倚遍栏干人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天津闲步","author":"邵雍","text":"天子旧神州，葱葱气象浮。\n园林闲近水，殿阁远横秋。\n浪雪暑犹在，桥虹晴不收。\n人间无事日，此地好淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天津幽居","author":"邵雍","text":"予家洛城里，况复在天津。\n日近先知晓，天低易得春。\n时光优化国，景物厚幽人。\n自可辞轩冕，闲中老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天道吟","author":"邵雍","text":"天道不难知，人情未易窥。\n虽闻言语处，更看作为时。\n隐几功夫大，挥戈事业卑。\n春秋赖乘兴，出用小车儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无行吟","author":"邵雍","text":"无行少年子，京都来往频。\n功名一生事，歌酒十年春。\n有数黄金尽，无情白发新。\n朋从消散尽，赢得病随身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无苦吟","author":"邵雍","text":"平生无苦吟，书翰不求深。\n行笔因调性，成诗为写心。\n诗扬心造化，笔发性园林。\n所乐乐吾乐，乐而安有淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜","author":"邵雍","text":"雨霁风自好，秋深天未寒。\n移床就阶下，看月出林端。\n有酒欲共饮，无宾可同欢。\n他时遇良友，此景复求难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月窟吟","author":"邵雍","text":"月窟与天根，中间来往频。\n所居皆绰绰，何往不伸伸。\n投足自有定，满怀都是春。\n若无诗与酒，又似太亏人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毛头吟 其二","author":"邵雍","text":"忧国心深为爱君，爱君须更重于身。\n口中讲得未必是，手里做成方始真。\n妄意动时难照物，俗情私处莫知人。\n厚诬天下凶之甚，多少英才在下尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长子伯温失解以诗示之","author":"邵雍","text":"儒家所尚者，行善与文章。\n用舍何尝定，枯荣未易量。\n干求便黾勉，得失是寻常。\n外物不可必，其言味甚长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长忆乍能言","author":"邵雍","text":"长忆乍能言，朝游父母前。\n方行初下膝，既老遂华颠。\n在昔四五岁，于今六十年。\n却看儿女戏，又喜又潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世上吟","author":"邵雍","text":"世上偷闲始得闲，我生长在不忙间。\n光阴有限同归老，风月无涯可慰颜。\n坐卧绕身唯水竹，登临满目但云山。\n醉眠只就花阴下，转破花阴梦始还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩消梅初开劝客酒二首 其二","author":"邵雍","text":"春色融融满洛城，莫辞行乐慰平生。\n深思闲友开眉笑，重惜梅花照眼明。\n况是山翁差好事，可怜芳酒最多情。\n此时不向樽前醉，更向何时醉太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩消梅初开劝客酒二首 其一","author":"邵雍","text":"为爱消梅胜早梅，数枝先发日徘徊。\n若教岭表腊前尽，安有洛阳正后开。\n香逐暖风初出谷，艳随芳酒正浮醅。\n佳宾会取东君意，莫负乘春此际来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄广信李遵度承制","author":"邵雍","text":"蓟北更千里，汉唐为极边。\n奈何今境土，不复旧山川。\n虎帐兵家重，雕弓嗣子传。\n他年勒功处，无使后燕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄友人","author":"邵雍","text":"当年有志高天下，尝读前书笑谢安。\n岂谓此身甘老朽，尚无闲地可盘桓。\n棋逢敌手才堪着，琴少知音不愿弹。\n非止不才能退默，古贤长恨得时难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]