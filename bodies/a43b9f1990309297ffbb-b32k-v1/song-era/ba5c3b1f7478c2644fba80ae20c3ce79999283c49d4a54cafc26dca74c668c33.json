[{"title":"次韵李得善学录需酒纳妇","author":"周必大","text":"合好须凭曲米春，分甘那暇问醨醇。\n遥知北海招嘉客，共贺东床得好姻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀 其二","author":"周必大","text":"傅粉施朱淡复浓，不辞沐雨更梳风。\n岂知命似佳人薄，不在吾公乐事中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵芮国器正字馆中木樨三首 其三","author":"周必大","text":"怪底花开已两回，先生儤直未衔杯。\n若犹不领渠侬意，犹向阶前一再开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵芮国器正字馆中木樨三首 其二","author":"周必大","text":"晓翻汗简因遮眼，午对枯枰辄烂柯。\n天遣幽香一唤起，醒然顿作出瓶鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵芮国器正字馆中木樨三首 其一","author":"周必大","text":"多生定自为黄卷，一念无如鱼蠹何。\n今度前身散金粟，芸香从此不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程泰之正字奉祠惠照院咏雪五首 其五","author":"周必大","text":"剥啄朝来送好音，唱妍酬丽自书林。\n柴门未扫檐垂溜，笔退谁知抱膝吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程泰之正字奉祠惠照院咏雪五首 其四","author":"周必大","text":"吻燥谁濡翰墨场，绝思齿烦漱甘芳。\n粉身莫惜归汤鼎，要与团龙发暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程泰之正字奉祠惠照院咏雪五首 其三","author":"周必大","text":"方丈仙人定好奇，行吟合璧作琼蕤。\n兔园且就如今赋，凤沼重看异日诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程泰之正字奉祠惠照院咏雪五首 其二","author":"周必大","text":"造化平心混万殊，高低一色眩离朱。\n如何尚爱南枝瘦，偏以凝脂助曼肤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程泰之正字奉祠惠照院咏雪五首 其一","author":"周必大","text":"天女飞花现化城，禅房深处想神清。\n斋心正使无低唱，拥鼻何妨效洛生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程泰之驾部送猴","author":"周必大","text":"团团扰扰便生憎，谁暇徐观棘刺能。\n驾部犹嫌无骏马，他人须用土牛乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徽州胡推官旅中遇雪且约同登雨花台三首 其三","author":"周必大","text":"天女来参彼上人，逆知君动雨花心。\n故令六出缤纷下，免使荒台更重临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徽州胡推官旅中遇雪且约同登雨花台三首 其二","author":"周必大","text":"传道诗仙折简来，破卷雪屋为君开。\n要将好句誇张籍，故放歌谣吏部才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徽州胡推官旅中遇雪且约同登雨花台三首 其一","author":"周必大","text":"岁晚相逢古帝乡，长松百尺傲冰霜。\n青鞋踏遍江南岸，更赋名花似漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江西美录示新旧诗一篇戏赠二十字于后","author":"周必大","text":"梦笔异文通，诗篇总自工。\n长哦三伏里，句句是清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江西漕张送大有年堂酒百壶戏答小诗","author":"周必大","text":"无何日饮口流涎，大有年堂酒满船。\n孔圣百觚谁敢比，仲由嗑嗑且希贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池阳四咏 其二","author":"周必大","text":"天遣江山助牧之，诗材犹及杜筠儿。\n向来稍喜唐风集，今信樊川是父师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池阳四咏 其三","author":"周必大","text":"君葺城楼望九峰，我能遍踏九芙蓉。\n飞云捲雨输贤守，透月穿天乞老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池阳四咏 其一","author":"周必大","text":"夜泊清溪弄水亭，棹讴徐起月华明。\n水晶宫畔西湖上，除却两邦无此清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池阳四咏 其四","author":"周必大","text":"地占齐山最上头，州城宛在水中洲。\n蜿蜒正作长虹堕，吸住江河万里流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西昌陈诚之送黄楼芍药仍枉长篇老懒不能次韵戏答二绝句连岁许红都未至末章及之 其二","author":"周必大","text":"六一先生旧帅扬，分宁太史尹西昌。\n只缘未睹红都胜，便似参谋待海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西昌陈诚之送黄楼芍药仍枉长篇老懒不能次韵戏答二绝句连岁许红都未至末章及之 其一","author":"周必大","text":"芍药名先记郑风，那因嘉木辨雌雄。\n姚黄后出今亡矣，合把黄楼列上公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许陆务观馆中海棠未与而诗来次韵","author":"周必大","text":"莫嗔芳意太矜持，曾得三郎觱篥吹。\n今日若无工部句，慇勤犹惜最残枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访胡邦衡庭前四菊茂甚因赋二绝 其二","author":"周必大","text":"挥毫曾对沈郎花，好事今同元亮家。\n看即槐庭满桃李，霜枝留与野人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访胡邦衡庭前四菊茂甚因赋二绝 其一","author":"周必大","text":"大杓亲分两玉瓶，东篱手植万金英。\n荒园有酒愁无菊，拟乞繁华助眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邬子湖","author":"周必大","text":"万顷湖光似镜平，蜿蜒得得导舟行。\n从来仕路风波恶，却是江神不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过馀干吴师中秀才以小诗惠歙砚次韵谢之","author":"周必大","text":"旧曾起草向明光，独与罗文近赭黄。\n三载瓦池研灶墨，因君聊复梦仪凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严宽桂岩堂二绝句 其二","author":"周必大","text":"卜筑华堂已八年，花因旧植有新添。\n广寒何待中秋到，明月清风即步蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严宽桂岩堂二绝句 其一","author":"周必大","text":"岩桂标名本在山，城居翻以桂为岩。\n香浮仙籍书生事，早拜恩袍映彩衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春岩桂著花诗人太和令君首赋佳篇才臣伯和仲和三友继作句法高妙不容措辞姑述四句","author":"周必大","text":"蟾窟云根夜夜新，天台子落四时荣。\n君看月桂閒花草，犹似长春窃此名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴斗南架阁求梦芳亭诗 其一","author":"周必大","text":"屈平流放楚江皋，萧艾丛中思郁陶。\n君是国香人服媚，诗情端合反离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴斗南架阁求梦芳亭诗 其二","author":"周必大","text":"枕中莫问熟黄粱，梦里何妨集众芳。\n芸省翻书慵辟蠹，兰闱起草会含香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庐陵道士罗尚逸能医眼善弈自湘中归写予真求赞复游湘中","author":"周必大","text":"黄冠多艺从仇仙，处士围棋伴乐天。\n我不即师师即我，胡为邀我泛湘船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张孜仲寅写予真倚松而立戏题","author":"周必大","text":"曾陪汉幄运前筹，也忝分封万户留。\n未问家传黄石法，且来閒伴赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时久阙雨回西美柬就附小诗","author":"周必大","text":"君能多益办，我鼓再而衰。\n安得催诗雨，心摇毕月离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李子西乙卯秋试毕携家兄旧诗相过索次韵","author":"周必大","text":"三日挥毫迥出群，贰师西伐有奇勋。\n便从蟾窟升金掌，休恋江东赋暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李卿月子西记予七十七岁之颜求赞","author"