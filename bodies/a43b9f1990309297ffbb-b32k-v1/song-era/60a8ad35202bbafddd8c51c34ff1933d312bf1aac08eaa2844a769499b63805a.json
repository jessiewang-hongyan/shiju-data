[{"title":"实录院与道山隔墙堂后修竹仆饮馀必曳杖婆娑其下时闻奉常阅乐之声故诗中有云韶之语","author":"周紫芝","text":"风条无叶自萧骚，玉立修篁不受凋。\n咫尺蓬瀛横雪观，依稀丝竹度云韶。\n天怜人老悲双鬓，官似僧闲占一寮。\n日日杖藜摩饱腹，未知何以答清朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王参猷用前韵见寄","author":"周紫芝","text":"文字何当仆命骚，馀年虽在鬓全凋。\n元无旧曲能三叹，为借新章作九韶。\n千里奉祠犹去国，一官何地可同僚。\n吹嘘直上青天去，谁挽斯人入圣朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢曾使君惠丹邱集","author":"周紫芝","text":"旧说江西一派禅，公家得法自当年。\n回风流雪何人似，宝钵天衣几世传。\n后学安能窥制作，老夫犹喜奉周旋。\n寒窗读罢无人语，只有灯花欲斗妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吸川亭","author":"周紫芝","text":"三峰拥中州，二水俱北汇。\n状如吸川鲸，有屋负鲸背。\n主人颂酒德，量与刘阮对。\n会令百川流，入我三尺喙。\n回视瓮间人，无乃真鼠辈。\n天风驾鲸波，风静水可爱。\n想当持翠螺，时依太白酹。\n尔曹固何知，此意有君在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题控鳌亭","author":"周紫芝","text":"神仙邈何许，仿佛在中天。\n弱水不可渡，况乃风引船。\n六鳌戴三山，来此知何年。\n上有百尺楼，缥缈翔飞烟。\n平生持巨钓，一举遂可连。\n以手控六鳌，于此相周旋。\n可恨世俗眼，未识方壶仙。\n绝境不可到，望望空惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘尉雪后东冈寻梅","author":"周紫芝","text":"雪压东冈千树梅，忍寒谁肯为渠来。\n却愁花底人如玉，羞得南枝不敢开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵德庄","author":"周紫芝","text":"赫奕宗枝秀，棱层玉树新。\n相逢又残岁，话酒几青春。\n病不妨诗否，家应入望频。\n少宽归去日，去别易愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其一","author":"周紫芝","text":"从来建邺是王都，天产皋夔为帝谟。\n可笑晋人无眼目，渡江惟笑见夷吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二","author":"周紫芝","text":"绣衮貂冠举世荣，阴功难报本难名。\n令公清德流无尽，依旧秦淮绕故城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其三","author":"周紫芝","text":"秦汉功由百战成，庙堂何代不谈兵。\n凌烟阁上从头数，谁解垂衣致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其四","author":"周紫芝","text":"向来诸将各云屯，一折渠魁世自分。\n但见鹰扬称尚父，不闻跋扈有将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其五","author":"周紫芝","text":"梯山蕃使入疆频，岁捧瑶觞奉至尊。\n申观万年方祝圣，王春正月更朝元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其六","author":"周紫芝","text":"万骑边声久不闻，蓬莱宫殿日长春。\n君王勤俭无行乐，闲作宸奎赐近臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其七","author":"周紫芝","text":"黄帕蒙鞯御坐来，临戎久不按龙媒。\n内前沙路平如掌，玉辂观成试辇回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其八","author":"周紫芝","text":"绍兴天子圣神孙，明道宣和典故存。\n曾与诸生迎御辇，又瞻青耜载耕根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其九","author":"周紫芝","text":"当年轮奂落成均，法驾天临近至尊。\n万国儒生瞻圣化，一声清跸在桥门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十","author":"周紫芝","text":"天禄初成幸翠华，隆儒恩意日尤加。\n只应东壁图书府，便是瀛洲学士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十一","author":"周紫芝","text":"仲春之日祀高禖，天仗亲临晓雾开。\n坛下百官称贺了，钧天声里带花回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十二","author":"周紫芝","text":"双阙傍边是玉津，禁园花柳一时新。\n乐游原上无行幸，分作慈宁殿里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十三","author":"周紫芝","text":"谁移蓬岛在人寰，诏赐新居五百间。\n紫塞无兵清似洗，丹楼不动屹如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十四","author":"周紫芝","text":"御墨亲书六字牌，阁名新赐属元台。\n内前夹道炉烟里，争看翔鸾舞凤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十五","author":"周紫芝","text":"御府分香寿老人，紫皇亲赐玉壶新。\n圣恩无极年无尽，恰似长生殿里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十六","author":"周紫芝","text":"大事因缘意未深，知公济物自初心。\n聊将石室岩前雨，来作商家旱岁霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十七","author":"周紫芝","text":"一语能平百战尘，两朝赤子尽归仁。\n十年困卧边亭鼓，同祝公年是几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十八","author":"周紫芝","text":"南北交欢万国宁，不将黔首比金缯。\n时人未会新盟意，要与思陵作中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其十九","author":"周紫芝","text":"时相论功固自贤，真儒一出定千年。\n能回銮御归长乐，何止龟阴得旧田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十","author":"周紫芝","text":"北海来归几过年，朱颜依旧照貂冠。\n不将一节更夷险，谁解如公耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十一","author":"周紫芝","text":"知公清德自天然，犹复游心到简编。\n应笑向来张相国，后堂宾客少彭宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十二","author":"周紫芝","text":"黄金新铸景钟鸣，公作铭诗纪告成。\n从此圣朝郊祀典，文章无复数西京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十三","author":"周紫芝","text":"衮衣调鼎春光轩，经术传家侍禁筵。\n试问一门三画戟，何如隔座两貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十四","author":"周紫芝","text":"四海文衡孰主张，半随西路擅词章。\n三君八俊今何处，知有宗师在庙堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十五","author":"周紫芝","text":"太平和笔一番新，瑞表丹邱亦异闻。\n不遣枫榆作连理，谁知六合已同文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十六","author":"周紫芝","text":"葆旅占星固异常，闽山竹秀米千囊。\n天公已遗鸾凤食，便恐双飞入建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十七","author":"周紫芝","text":"胸中治国计谁良，只有休兵是秘方。\n肯为八荒开寿城，能仁须号大医王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十八","author":"周紫芝","text":"住世神仙五百年，长生本出笑谈间。\n不从方士论炉鼎，自有阴功解驻颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时宰生日诗三十绝 其二十九","author":"周紫芝","text":"帝城春近俗熙熙，师宰功高不事知。\n天上中人传诏日，御前蕃使贺年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁抄四绝 其一","author":"周紫芝","text":"湖上青山一水边，暮云楼阁九重天。\n春幡影里迎新岁，爆竹声中送旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁抄四绝 其二","author":"周紫芝","text":"天寒细雨还成雪，日暖晴云却护霜。\n可惜梅花残腊月，十分天色似江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁抄四绝 其三","author":"周紫芝","text":"此生无事不随缘，世路何心更著鞭。\n年尽未归真偶尔，春来若健亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁抄四绝 其四","author":"周紫芝","text":"端门行欲贺新元，窃食无功只厚颜。\n可笑腐儒黄卷客，亦随朝士紫宸班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虚飘飘 其一","author":"周紫芝","text":"虚飘飘，虚飘飘，姮娥临月榭，神女渡仙桥。\n风撼花浮水，霜吹叶落条。\n飞云转眼下三峡，密雪满空来九霄。\n虚飘飘，虚飘飘，比人生命犹坚牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虚飘飘 其二","author":"周紫芝","text":"虚飘飘，虚飘飘，水边看海市，云际现天桥。\n弱柳绵吹径，嫣花锦缀条。\n卧云雌霓饮沧海，过眼夕阳低碧霄。\n虚飘飘，虚飘飘，比人生世犹坚牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰除夜四绝 其一","author":"周紫芝","text":"千里家山一望间，白头夫妇且樽前。\n诗中游戏无三昧，客里光阴又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰除夜四绝 其二","author":"周紫芝","text":"七年长梦采江蓠，此夜樽前倒接篱。\n莫问年来何岁月，诸孙言语似吴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰除夜四绝 其三","author":"周紫芝","text":"无功饱食愧侏儒，赢得霜添白颔须。\n已是再逢新太岁，何须羞饮后屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊辰除夜四绝 其四","author":"周紫芝","text":"新春皓薄晓钟声，残烛晶荧守岁檠。\n年向白驹光里度，诗随蓝尾酒中成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春前五日史馆对雪二绝 其一","author":"周紫芝","text":"九天飞下玉花繁，喜入长安十二门。\n独醉且须温腊酒，迎新又欲带青幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春前五日史馆对雪二绝 其二","author":"周紫芝","text":"昔年踪迹寄江头，雪屋梅村自一邱。\n醉里却疑身是梦，烂银楼阁看瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩信","author":"周紫芝","text":"韩信功高世共知，区区安用假王为。\n固应渫血长安日，已在荥阳蹑足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"范增","author":"周紫芝","text":"西楚兴王亦有人，半扶炎祚作谋臣。\n老生不解归明主，事去方知是失身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子绍立春二首 其一","author":"周紫芝","text":"自息中山斗，长安几见春。\n司天得南正，迎日法高辛。\n送老年华速，催耕雨意新。\n又闻宽大诏，飞舞下天津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子绍立春二首 其二","author":"周紫芝","text":"客久悲残岁，春生尚薄寒。\n簪花人似梦，卷白意先阑。\n黄犊还惊眼，青菹已入盘。\n新年有行乐，老去逐君难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻西湖梅尽桃花已有开者 其一","author":"周紫芝","text":"不到西湖忽换年，今朝欲挂杖头钱。\n催成柳色多如许，落尽梅花最可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻西湖梅尽桃花已有开者 其二","author":"周紫芝","text":"日日湖边踏浅沙，西湖久住已成家。\n刘郎去后空肠断，忆著玄都观里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送叶泉州二首 其一","author":"周紫芝","text":"近日泉南守，新除武部郎。\n汉廷多长者，循吏得惟良。\n海国蛮珍聚，兵厨腊酒香。\n不妨聊卧治，未要薄淮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送叶泉州二首 其二","author":"周紫芝","text":"天上星郎贵，人间五马荣。\n倒樽知客满，闭阁自诗成。\n闽岭千山隔，吴船一水轻。\n九重宣密诏，何日问归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送冯均州二首 其一","author":"周紫芝","text":"闻说京西道，均房虎更多。\n定须叹来暮，政欲饮无何。\n过客虚厨传，饥氓费抚摩。\n君看归谏议，为郡拙催科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送冯均州二首 其二","author":"周紫芝","text":"从事持三尺，将军控万弦。\n庙堂应记忆，江汉久流传。\n又复分新垒，归来更几年。\n他时休怪我，今日自华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓宿省直有怀方元伯","author":"周紫芝","text":"古屋颓墙久寂寥，寒厅依旧长芭蕉。\n主人应在花深处，独对东风醉小桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子绍题竹坡二首 其一","author":"周紫芝","text":"孙郎忽唾寒窗玉，来过当年玉川屋。\n更作纵横一尺书，为榜南坡两三竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子绍题竹坡二首 其二","author":"周紫芝","text":"结庐归卧今尚无，白头寄食犹中都。\n移栽自种短墙底，他时此计知何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其一","author":"周紫芝","text":"五十九年蘧伯玉，家无担石居无屋。\n喜君马上风前诗，似我南坡月中竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其二","author":"周紫芝","text":"寒窗有意过我无，雍容车骑子甚都。\n更当为作子虚赋，王郎文彩今相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其三","author":"周紫芝","text":"乌衣诸郎美如玉，笑我秋风卷茅屋。\n才高渠是判花人，头白吾羞汗青竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其四","author":"周紫芝","text":"此君那可一日无，桃花不复怨玄都。\n得公明月千斛珠，我羞鱼目真不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其五","author":"周紫芝","text":"无方可试蓝田玉，空想云庵卧玉屋。\n赖有人间百尺楼，下临此地千寻竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其六","author":"周紫芝","text":"衰翁久已一故无，聊睇逸骥方过都。\n公是风流小摩诘，我为无用长侨如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其七","author":"周紫芝","text":"铅刀不可切坚玉，敝筐岂能持大屋。\n强驱跛鳖当前锋，看公诗成如破竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其八","author":"周紫芝","text":"君房言语举世无，射策未许蒙帝都。\n巴人下里不足数，云韶九奏方纯如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其九","author":"周紫芝","text":"蕴石知公似荆玉，谁作玙璠荐王屋。\n白髯应笑虎头痴，青衫谩把鱼须竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其十","author":"周紫芝","text":"老此安能为有无，曹会岂可当大都。\n弹丸脱手盘走珠，句然如此今谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其十一","author":"周紫芝","text":"平世欲献初无玉，何尝生存梦华屋。\n苦遭田父亦与饮，不问主人时看竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其十二","author":"周紫芝","text":"十事如意八九无，暮年犹喜见子都。\n那能从公得三绝，但可一身观六如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季共月夜见怀竹坡用子绍韵 其十三","author":"周紫芝","text":"鲈鱼忆鲙松江玉，船作浮家当渔屋。\n寒窗梦著雨中蓑，长钓复垂波上竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]