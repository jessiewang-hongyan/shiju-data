[{"title":"送董煟归鄱阳","author":"项安世","text":"沙随程子九州闻，独拥经纶谢世纷。\n传业只今惟董祀，爱人于古似鄱君。\n活民鸿宝方书备，寿国灵枢脉络纷。\n欲服上医何物是，他时种杏满青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒋舍人知利州","author":"项安世","text":"乙未临轩赐敕头，左班詹监右君侯。\n两翁今止一翁健，万里去为千里州。\n不向殿岩提虎士，亦应帷幄运鸿筹。\n阜陵人物今馀几，况是当年第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送楼国正罢荆幕东归","author":"项安世","text":"一江秋水散芙蕖，笑买扁舟下五湖。\n北学自怜非楚产，东归安得与公俱。\n同年进士今丞相，六馆诸生旧讲徒。\n朱橘白鱼留不住，洞庭橙熟有新鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送虞司理赴官辰州二首 其二","author":"项安世","text":"当年有虞氏，初作理官名。\n正以蛮兼寇，须烦允与明。\n云孙今筮仕，溪子正称兵。\n淑问端能继，淮夷不足平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送虞司理赴官辰州二首 其一","author":"项安世","text":"窈窈辰溪路，秦人此避秦。\n子孙为洞户，世系本王民。\n问淑桑鸮变，言忠黍貊亲。\n此心能勿舍，何地不归仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潜江令徐盈","author":"项安世","text":"汉江西畔蜀江东，中有荆王古县公。\n蔿艾猎来民见德，谷于菟去士传忠。\n肝肠可奈平生苦，机杼胡庸抵死穷。\n君宠亲恩俱望报，直须平易与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潭州陈运使二首 其二","author":"项安世","text":"惜分频卜夜，此意我知公。\n古事多疑信，今人足异同。\n何年操棐几，三月坐春风。\n但记匆匆字，深题大带中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潭州陈运使二首 其一","author":"项安世","text":"薄命真如此，兹行如识公。\n从来半生愿，不畀数旬同。\n官事埋头过，江船转眼空。\n可能倾盖地，直作急流中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送醇甫","author":"项安世","text":"怕听槌鼓发船声，桑梓葭莩两系情。\n病有千回烦访问，贫无一事扰聪明。\n循良只为乡人惜，离别偏令老大惊。\n不记归来多少岁，儿童三见令君行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送襄阳成统制移建康","author":"项安世","text":"日日梦长干，真成下碧湍。\n雍郊辞鹿隐，钟阜看龙蟠。\n百胜传家学，三司践世官。\n谁知弓剑里，曾带腐儒酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送夔帅杨校书解印还乡二首 其二","author":"项安世","text":"清秋丹凤下蓬莱，惊倒瞿唐滟滪堆。\n监国入堂催议事，相公开馆梦翘材。\n未甘直上青云去，更欲斜飞锦水回。\n一片芦帆楚江岸，新春蓑笠候高桅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送夔帅杨校书解印还乡二首 其一","author":"项安世","text":"高闲风度澹无营，静密工夫久自增。\n太息家林惟独鹤，向来西海说三鹏。\n桥冲不动千原穫，鼛鼓无声万杵登。\n道在阴阳公自到，向来河洛此绳绳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重午饮赵园再和","author":"项安世","text":"香玉尊前剥嫩金，已逢佳节又逢霖。\n从教岁月催华发，谁识乾坤有赏心。\n家在山林仍近市，手栽花木渐成阴。\n更开石井依桐叶，我欲时来作一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过鄂州","author":"项安世","text":"南柯梦散不知年，东海骑鲸作醉仙。\n我自偶经前赤壁，谁言曾倚旧青毡。\n辕门甲马三更发，古寺钟鱼一夏眠。\n惭愧白棠花下叟，当时刍狗尚流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳复晴再次前韵","author":"项安世","text":"一天云物护轻寒，阵阵清风约雨乾。\n造物有情聊作戏，诗家无赖强寻欢。\n吾人已办泥沾帽，晓色还教日照盘。\n咫尺龙山君莫负，草枯霜野正平宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重到东斋二首","author":"项安世","text":"人生底事非前定，我与东斋似有缘。\n别去风光只如昨，重来花木已经年。\n曾将问答趋参席，愧把才名据郑毡。\n却忆西堂旧诗友，几番风雨对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顺风至岳州危甚","author":"项安世","text":"黑云将雨向巴邱，白浪奔雷送客舟。\n一路逆风才得顺，百年何日是无愁。\n神林浦外飞沙恶，道士矶头乱石稠。\n系缆南津闻笑语，船船鸡酒谢神休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食角黍怀江陵","author":"项安世","text":"经年不食三闾饵，一日相逢似故人。\n旋剥青菰香满手，试餐黄颗软粘唇。\n蔗浆下箸甘无敌，昌本浮杯小作巡。\n正是乡人行乐处，画旗鼍鼓隘江津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乘月入城","author":"项安世","text":"水落千原净，天高七泽空。\n征人秋色里，骑马月明中。\n故国山川在，承平气象雄。\n西风多感慨，敲损玉玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜入城","author":"项安世","text":"巾栉侵残夜，衣裳谒上官。\n市心偏得热，堤面自生寒。\n水阔江湖小，川平象纬宽。\n篮舆得佳梦，摇兀又惊残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐一之从智子行","author":"项安世","text":"有士才如此，流光驶若何。\n笔端风雨快，胸次古今多。\n止止杯中物，呜呜耳后歌。\n低头聊小忍，唾手即高科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽汤丞相夫人二首 其二","author":"项安世","text":"贱子无天幸，平生望六珈。\n偶然同断梗，已复叹悲笳。\n泪落升堂日，神驰送客车。\n空惭名义重，桂省近年家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽汤丞相夫人二首 其一","author":"项安世","text":"册府连天汉，恩荣四十年。\n山河开象服，夙夜赞台躔。\n鸾鹄诸孙峙，箕裘令子传。\n夫人无一恨，可以见重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽利路章运诗二首 其二","author":"项安世","text":"宝屏峰上两先生，照见廉贪立懦情。\n八百万钱同弃屣，四麾一节但空籯。\n扫除身世朝和暮，分付儿孙白与清。\n持此横山原畔去，少师秦国有馀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽利路章运诗二首 其一","author":"项安世","text":"畴昔吾乡主簿君，今年丹旐过江浔。\n老僧尚记辞菹笋，旧吏犹闻却顾金。\n玉节朱轮行万里，清冰寒露炯初心。\n南风轧轧鸣归橹，似相蒿城薤管音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陆运使诗 其二","author":"项安世","text":"八秩公何憾，淋浪我自悲。\n向来淮士里，最得阜陵知。\n故国人谁识，长身帝所思。\n竟随龙驭去，应赴白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陆运使诗 其一","author":"项安世","text":"爰自微官日，能令巨力摧。\n青刍回使节，红粟抗公台。\n淮右恩波阔，畿西禁网恢。\n平生希曲令，今得吏民哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽枝江朱学谕","author":"项安世","text":"身受傃轩诗，儿修涑水仪。\n百年生也直，三叹古之遗。\n处易疑孤峭，因难见惠私。\n此风今远矣，吾涕自涟洏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽荆南帅张左司诗 其五","author":"项安世","text":"世已憎吾属，天宜赦此贤。\n忍教名百代，不使寿中年。\n兰谢无传业，蘋荒久绝弦。\n凄凉楚江上，鸿影独翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽荆南帅张左司诗 其二","author":"项安世","text":"自古谁无死，斯人有重轻。\n诸生望模楷，吾道倚权衡。\n一发千钧挽，中流砥柱倾。\n平生忧国事，何意作身名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽荆南帅张左司诗 其四","author":"项安世","text":"昔者登帘阁，先生病已瘳。\n从容当世事，反复万端忧。\n力尽千家活，身疲十日留。\n向来天下士，端为一城休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽荆南帅张左司诗 其一","author":"项安世","text":"霄汉占贤辅，乾坤失大儒。\n斯文断命脉，识者叹穷途。\n独拥全名去，谁供一世须。\n空馀千载事，不尽惜良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽荆南帅张左司诗 其三","author":"项安世","text":"吾道竟如此，苍生将奈何。\n名声垂白日，身世逐沧波。\n宜世堂堂去，犹胜奄奄过。\n所嗟非一死，良愿恐蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽善化沈令 其二","author":"项安世","text":"夔门逢令季，湓浦接贤兄。\n幸甚交三沈，兹焉共一城。\n解诗谈到髓，听讼笔如倾。\n豪快今安有，哀哉不久生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽善化沈令 其一","author":"项安世","text":"十八年前梦，宜都簿即君。\n沙头能遇我，客里暂论文。\n久别欣同事，方驩叹失群。\n隔宵犹一见，千古遂相分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽程尚书词","author":"项安世","text":"人间一日履声藏，天上文昌落正芒。\n直谅无朋今魏汲，师承有法古韦康。\n思陵册府严招聘，孝庙经帷盛表章。\n岁晚山林谁得似，十年高卧乐羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花菊","author":"项安世","text":"花神得与换新妆，不著仙家金缕裳。\n也学时人尚红粉，依前风味带黄香。\n微醺有意随风舞，独立无言任雨荒。\n唤作桃红元未称，桃花那解傲秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"爱秋","author":"项安世","text":"生憎词客并诗客，只解悲秋不爱秋。\n玉作花肌娇不柰，金妆宝靥笑无休。\n桂香夜夜薰罗袖，蕣彩朝朝艳醉眸。\n脱尽画桥千尺柳，舞腰如束更风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"监利许知县见示诗卷","author":"项安世","text":"哦君五十四篇诗，燃尽青藜杖一枝。\n长韵屈平经里思，短章介甫集中辞。\n只因云梦曾游耳，便把江山尽得之。\n割我锦机君已甚，不须更遣世人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢智子衡州亲迎","author":"项安世","text":"初闻永嘉叟，招唤作师生。\n又见金华伯，扳联作弟兄。\n双峰真有子，二老总关情。\n所愿勤诗礼，无令负甲庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读三国志","author":"项安世","text":"曹刘有志混华戎，无奈吴儿两炬红。\n赤壁焰烧云梦泽，夷陵光照永安宫。\n人间自此鼎三足，天上无由日再中。\n惟有葛公心未死，夜深寒月照孤忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读杜贤良文卷","author":"项安世","text":"举公售浅戒深钩，学士谈根讳末流。\n万古斯文真一发，百年逢子散千愁。\n气雄声正师韩集，格重词妍似柳侯。\n天遣孤穷应有意，未追彖系莫轻休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读撄宁诗集效其体寄荆门赵守二首 其二","author":"项安世","text":"多谢君侯尊古德，新开诗集向春风。\n隔生始见斯文贵，未死谁邻此老穷。\n纸上岁时犹可数，句中恩怨已成空。\n若为唤得撄宁起，看破浮云合更工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读撄宁诗集效其体寄荆门赵守二首 其一","author":"项安世","text":"玉州政事荆州说，邻叟欢呼病叟闻。\n转地光风芽甲暖，照天寒鉴骨毛分。\n花村犬睡沈抱柝，秧地人归劝耦耘。\n安得旌旗来北梦，放教恩泽到南云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辱井","author":"项安世","text":"寺前蔬圃是台城，寺后寒泉入柳营。\n玉甃多年无旧物，银瓶终日有哀声。\n游童走卒争嗤点，弱水贪泉共姓名。\n不似冶城三尺土，钟山回首让峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下次韵谢松阳沈术人二首 其二","author":"项安世","text":"下帘读易沈君平，老向人间识世英。\n戏把年龄聊复问，从来富贵不须评。\n联翩诗笔粗豪甚，矍铄精神顾盼明。\n我欲求田古松邑，君言此计几时成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下次韵谢松阳沈术人二首 其一","author":"项安世","text":"向来定远太平平，自殿银袍五百英。\n觜距不堪誇试席，齿牙无复近乡评。\n重探虎穴颜何厚，忽见稽山眼暂明。\n赖有东阳老居士，相逢一笑又诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下呈叔表兄","author":"项安世","text":"相望五千里，话别十三年。\n知我到江左，烦兄来日边。\n朋游俱健否，须发已卷然。\n共说儿童事，分明在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下送外舅任知县赴茶马司辟","author":"项安世","text":"皇华万里赴临洮，亲向君王乞骑曹。\n合为圣朝修马政，可容穷邑试牛刀。\n横驱旌节半天下，自许才名一世豪。\n早晚西来八千匹，九重何以答贤劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高通直挽诗 其一","author":"项安世","text":"赤手开荒径，朱门照广津。\n两班通印绂，三桂袭簪绅。\n寿考尊乡曲，光华劝邑人。\n我生当恨晚，犹及望灵椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高通直挽诗 其二","author":"项安世","text":"甲子诸孙行，丁年北梦行。\n归来古于越，友事晋参卿。\n旋展升堂拜，方瞻赐绂荣。\n故山耆旧少，萧瑟更佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶吟","author":"项安世","text":"近市心如水，居贫道未穷。\n关门度梅雨，攲枕受槐风。\n问学十年事，文章百世公。\n读多书有味，吟少句无工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"项安世","text":"暗水斜穿橘坞凉，回波直下藕塘香。\n似牙如背白羊岸，已叠又湾青草傍。\n闸里放船思槜李，石间行酒认天章。\n一时唤起平生梦，江北江南道路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿东林寺","author":"项安世","text":"借宅星江上，山南已遍寻。\n犹馀湓浦路，未快白公心。\n属国陈三表，归帆拂二林。\n远师堂上酒，可以恣狂吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄承甫兄","author":"项安世","text":"不见夫君岁月过，举头相望隔山河。\n人来人去书长到，江北江南情若何。\n铁砚功名当自许，锦囊诗句不须多。\n家风正待吾曹振，莫漫寻常费琢磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗主管四首 其四","author":"项安世","text":"客有甄卿子，师行八面奇。\n谈禅兼学道，爱酒更能诗。\n闻说今同事，长怀旧接辞。\n无人自娱戏，多病欠医治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗主管四首 其三","author":"项安世","text":"可惜经年别，都能两日留。\n别来长似梦，书到暂忘忧。\n老子无公事，长安足俊游。\n时时论人物，江汉有轻沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗主管四首 其二","author":"项安世","text":"把酒东南望，关心歙水边。\n三君同别我，小友不论年。\n贾虎风行地，王珠月映川。\n州人亦惊倒，此客定能贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄罗主管四首 其一","author":"项安世","text":"四海罗夫子，乾坤识此心。\n貌真南似北，人是古居今。\n老大胸怀苦，优游岁月深。\n诸公用之武，莫待二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄郑荐玉","author":"项安世","text":"郑公身与我同寒，陆子泉头隔几山。\n为客盖头无一瓦，何时开眼见千间。\n非干世俗人情薄，自是书生命运悭。\n三邑未随燔肉废，先师心事几曾还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄南唐吴监岳兼白鹿书院","author":"项安世","text":"诛茅一亩竹三椽，绕舍畦蔬满屋荃。\n掷廪峰前新庙令，勘书台上老儒仙。\n西山草木归吟藁，东汇烟云入瓮天。\n合与平庵管风月，便称行守莫称权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄胥直夫","author":"项安世","text":"江上岁云暮，风波无定时。\n天寒归鹤早，水阔到船迟。\n老去颇谙事，病来仍废诗。\n愿君逢驿使，寄赠小梅枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩丈","author":"项安世","text":"送别扁舟上，相望一水间。\n酒杯思共把，棋局定长閒。\n雅量容陂阔，私心岂石顽。\n梦随沤鸟去，时过紫金山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩丈兄弟 其一","author":"项安世","text":"兄弟真连璧，文章自一家。\n祠庭聊燕息，使节最光华。\n后会春应好，相思日又斜。\n遥知北堂上，把酒插梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄韩丈兄弟 其二","author":"项安世","text":"岁月惊游子，江山隔故园。\n感时虽有恨，适意自忘言。\n土锉晨炊饭，茅檐昼负暄。\n病来诗思减，东望想词源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄潘致虚","author":"项安世","text":"长忆潘居士，相望今几州。\n生涯温饱未，故旧往还不。\n问讯凭双鲤，观身渺一沤。\n湖南元好住，吾欲具扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]