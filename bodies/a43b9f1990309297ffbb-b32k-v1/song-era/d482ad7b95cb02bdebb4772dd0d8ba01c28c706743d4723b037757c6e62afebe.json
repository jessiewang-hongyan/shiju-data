[{"title":"古渔父词十二首 其三","author":"王铚","text":"万里号风雪满山，黄芦晻霭水汪湾。\n九衢朝马愁泥滑，不识渔翁兴未閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古渔父词十二首 其二","author":"王铚","text":"雨中渔艇一声歌，夹岸青林照碧波。\n跃马更谁思往事，红尘千丈奈人何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古渔父词十二首 其一","author":"王铚","text":"渔父家风我所知，家风要与道相宜。\n不怀贪饵吞钩意，常似丝纶未下时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意","author":"王铚","text":"歌声怨极珠难续，琴韵愁深水易分。\n公子何须赋巫峡，梦中真复有朝云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归鸿阁","author":"王铚","text":"初离江渚荻生芽，飞到龙荒雪满沙。\n寄语不须传信远，将军忧国不忧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其十 山馆","author":"王铚","text":"穷涂游子年华晚，折赠无人信手题。\n留恋清香忍回首，五更立马断桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其四 月下","author":"王铚","text":"樽前旧厌繁多态，雪里曾嫌淡少情。\n何似天容开夜色，数枝寒玉转轻盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其七 水边","author":"王铚","text":"雪后溶溶嫩水通，满枝烟雨暗春风。\n试看照影横斜处，浑似靓妆清镜中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其三 风前","author":"王铚","text":"清香自满不因风，花气迷人处处同。\n祇与吹开又吹落，春愁已在笛声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其一 半开","author":"王铚","text":"一枝开破一年春，斗蕊稠花总后尘。\n却恨无媒怜独夜，月偷清影向何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其九 江村","author":"王铚","text":"竹篱茅屋江郊路，未肯斗妆尘市间。\n小朵飘零水风晚，又随残月落关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其八 竹外","author":"王铚","text":"枝上淡烟笼白雪，此君高节助清真。\n要知谢女姿容别，林下孤标迥出尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其六 雨中","author":"王铚","text":"水泛残香不可寻，更堪烟雨锁花心。\n祇知赐浴恩波重，未识和戎怨泪深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其十二 欲谢","author":"王铚","text":"零落斜枝雪未乾，且垂薄暮护微寒。\n大都荣悴人情别，我为残英特倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其二 清晨","author":"王铚","text":"晓色宜春露蕊鲜，玉人斜插斗清妍。\n新花更映新妆面，无限风光在鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋梅花十二题 其十一 薄暮","author":"王铚","text":"寒欺雪勒未逢春，照影今宵借月魂。\n可惜孤山吟已尽，后来幽绝几黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙庭观用东坡韵 其一","author":"王铚","text":"侍宴瑶池更不归，茂陵千古挂馀悲。\n祇今山下传遗姓，应守琼田旧玉芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其一","author":"王铚","text":"玉人半醉晕丰肌，何待武陵花下迷。\n记得鞦韆归后约，黄昏新月粉墙西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜晴","author":"王铚","text":"雨脚初收天意晴，西风摇落夜寒清。\n披衣自起开窗户，落月一山高下明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明觉寺折梅","author":"王铚","text":"遥山天际敛眉峰，清浅溪边淡粉容。\n薄暮寺桥人独立，一灯明灭数声钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨夜","author":"王铚","text":"去国襟怀离别情，夜眠雨驿叹孤征。\n转头三十年前恨，犹听当时枕上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南岩悟禅老见于山中同烹玉糁羹","author":"王铚","text":"我家峰头最高层，落叶苍苔不可登。\n清坐与师烹玉糁，千岩风雨夜深灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊 其二","author":"王铚","text":"碧飞红断正伤春，万里天涯一病身。\n芳草路长楼百尺，楼中更有凭栏人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊 其一","author":"王铚","text":"不断烟芜起暮愁，无穷杨柳拂东流。\n一声歌罢香轮去，只有斜阳伴画楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉声","author":"王铚","text":"娟娟山月半岩明，霜重楼台夜气清。\n谁把玉琴来写取，松风吹断夜泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送淳上人游九岩","author":"王铚","text":"残菊孤花留暮秋，劳师问路乱山头。\n九岩只望孤云去，舒卷如云得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剡坑探梅","author":"王铚","text":"岭上寒梅自看栽，山斜一半似屏开。\n春寒点点枝头雨，为有东流水过来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓发石牛","author":"王铚","text":"匆匆车马出清晨，日淡风微已仲春。\n松竹阴中山未尽，梅花林外有行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿华岳观","author":"王钦臣","text":"凌空老树云垂叶，压屋梨花雪照人。\n深愧地仙教俗客，殷勤留看华山春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄和邢子屑孙肖之始春见寄 其二","author":"王铚","text":"海山雪后海天宽，群玉参差万里寒。\n岩谷无人共清夜，倚栏独向月中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄和邢子屑孙肖之始春见寄 其三","author":"王铚","text":"山林老去万缘休，只有情钟旧辈流。\n芳草无穷山四向，断肠人在最高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄和邢子屑孙肖之始春见寄 其一","author":"王铚","text":"东风初到乱山头，无数残梅雨未收。\n何待伤春对晴景，暝云横尽古今愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄南岩悟禅师","author":"王铚","text":"雪后千峰玉刻成，琼瑶寒照寺楼明。\n遥知禅老开窗坐，指点烟村看晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望","author":"王铚","text":"春浓已伴客愁浓，门掩雨馀江上峰。\n莫道夕阳无一事，远颦眉黛更千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴閒渡西溪","author":"王铚","text":"雪后孤村一段烟，晴光远射玉山川。\n酒旗隔岸招閒客，独上西溪渡口船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪溪亭观雨","author":"王铚","text":"晚雨廉纤正满空，万峰多在暝云中。\n风回变态何深浅，坐看天施水墨工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜","author":"王铚","text":"淡月新霜似旧时，更怜秋与夜迟迟。\n梦回一枕凄凉恨，帐外青灯不得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普惠寺","author":"王铚","text":"镜里形容水底天，定将何物喻真禅。\n心安便是毗卢界，尽日添香伴兀然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其十 忆昔","author":"王铚","text":"匡庐古寺暗松藤，曾宿寒岩最上层。\n火煖炉温四山静，前溪风雪后窗灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其一 弄雨","author":"王铚","text":"一段风烟笔下开，小枝带雨思萦回。\n障风一袖如相向，说与嫦娥泪落来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其九 夜风","author":"王铚","text":"倚竹佳人生暮愁，那知情伴夜蝉幽。\n一山风月龙吟罢，声入江云袅袅秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其六 迸石","author":"王铚","text":"渭水侯多失旧封，平泉池馆乱来空。\n青青石上何人赏，孤映暮山风雪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其八 雪梢","author":"王铚","text":"第五桥边一径遥，满林野竹立江郊。\n鸳鸯浮破水涵影，翡翠压斜风舞梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其七 欺雪","author":"王铚","text":"爱竹高风已自贤，兴来更泛剡溪船。\n枝间清响风惊雪，忆得东林夜宿年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其二 藏岩","author":"王铚","text":"小年轻别庐山道，林下微吟夜更幽。\n影落人行半岩月，五更风露一山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其四 霜节","author":"王铚","text":"春花秋月不同时，高节偏于墨色宜。\n莫遣世间丹绿笔，等閒俗却岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨君十咏 其三 露叶","author":"王铚","text":"秀色娟娟自出尘，晓枝更带露华新。\n清风一至如相语，从此开帘来故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月中旬书戴溪亭","author":"王铚","text":"天上东风转斗星，天涯羁客尚飘萍。\n道涂况复经残岁，风雪那堪宿旅亭。\n春到怯添双鬓白，夜寒愁对一灯青。\n残年万古凄凉恨，不计樽前一醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日送韩简伯","author":"王铚","text":"门户荀陈士论佥，却随王谢老江南。\n一官傲世妨才命，万事承家任苦甘。\n渔艇我将还旧隐，僧窗谁与对清谈。\n落花风雨西陵渡，佳节可怜三月三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与郭寿翁俱客钱塘寿翁归吉州追饯至龙山白塔寺惜别怅然终日始登车而去既行旬日予得请庐山太平观将归隐浙东山中寄诗奉怀","author":"王铚","text":"江边孤寺旧曾经，重枉骊驹当短亭。\n落日催人心去住，东风回首泪飘零。\n魂归但觉枫林黑，书就终期汗简青。\n归隐我无冲斗气，相思时望少微星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋山间观月","author":"王铚","text":"月出云开天宇閒，幽居真赏异尘寰。\n冰轮孤挂夜千丈，玉露密零秋一山。\n莫望乡关起愁色，胜居沙漠惨离颜。\n桂娥应恨无佳句，不识幽人到老閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋招叶子谦","author":"王铚","text":"堂上月已满，樽中酒更空。\n故人眇何许，出门惟清风。\n不如一夕饮，所至皆能同。\n悄然望玉杵，无声桂影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意","author":"王铚","text":"有恨匆匆别，无期缓缓归。\n天涯作孤客，楼上对斜晖。\n目断路不断，魂飞花更飞。\n无多清滴泪，恐损别时衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵寄洪驹父 其二","author":"王铚","text":"江山霜落木，千里一身归。\n去国怜张翰，回舟为陆机。\n烟林无际远，寒叶有声飞。\n何必少陵老，悲伤未拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雪声","author":"王铚","text":"天上威仪地岂知，六花寒路夜偏宜。\n半空环佩朝元罢，满地珠玑按舞时。\n簌簌初随风更急，萧萧却杂霰俱迟。\n房公松竹分清俗，除却天声总未奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁杪道中","author":"王铚","text":"岩风号万木，天意自悲伤。\n野店逢残岁，危峰半夕阳。\n吾生犹道路，此恨付杯觞。\n正是凄凉极，寒梅逗晚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋寄昔慧老且吊慈受老师之亡","author":"王铚","text":"昔日禅河早预流，老寻支许剡中游。\n一枝数粒同过夏，万壑千岩相映秋。\n眼看珠沈沧海底，心伤塔就乱峰头。\n不须月落龙天泣，万古白云无去留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行扶病访王文孺曜庵且蒙和赐佳章次韵为别","author":"王铚","text":"西风过雨冷孤云，客路衰骸与病亲。\n烟渚好横今夜笛，云林还忆旧时人。\n凌空丹药传岩客，照水红莲赋洛神。\n老泪数行伤别尽，自怜无可更沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访关子开兄弟于馀姚怀先世旧契","author":"王铚","text":"山嵇交契自当年，重到同乡各怆然。\n百里山川清自旧，两家子弟老于前。\n疏梅开处数枝玉，小雨来时一段烟。\n岁晚不调相会数，溪头尚趁有归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别张自彊","author":"王铚","text":"燕子低飞入坏檐，柳条轻拂绿毵毵。\n故园更在北山北，佳节可怜三月三。\n万古愁多凭浊酒，九原事往落清谈。\n都门别恨终难写，满眼风光思不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别故人张孝先","author":"王铚","text":"平生尝叹少陵诗，岂谓残年尽见之。\n共脱兵戈身偶在，各怀乡国语尤悲。\n又寻芳草春风路，犹听孤舟夜雨时。\n避地海山周万里，此行无处寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秀远亭","author":"王铚","text":"镜似冰壶表里清，我来閒伴白云行。\n四山迤逦青围野，一水蜿蜒绿绕城。\n试问春来观秀色，何如雨后听泉声。\n昔人飞驭烟霞外，落日空怀万古情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"王铚","text":"六曲栏干院宇深，影连苔色昼沈沈。\n已将虚实论因果，尤称风流写醉吟。\n梦短不禁帘外雨，愁多常怯槛边阴。\n可怜今古无穷恨，卷在凋零如寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆左丞夫人郑氏挽词四首 其四","author":"王铚","text":"貌燬栾栾棘，心伤蓼蓼莪。\n断机慈训在，怀橘孝思多。\n露草沾寒泪，云山翠涌波。\n悲风感行路，楚挽不成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆左丞夫人郑氏挽词四首 其三","author":"王铚","text":"轩冕三从盛，门庭五福优。\n凄凉孝子泪，悲恸故山秋。\n杨子新阡启，班昭旧史留。\n空堂对萱草，无复更忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆左丞夫人郑氏挽词四首 其二","author":"王铚","text":"寒日明丹旐，流尘暗綵衣。\n那知长夜去，无复逝川归。\n方士言终误，神丹事已非。\n出门寻吊客，惟有鹤双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和明上人见赠 其二","author":"王铚","text":"六见月华亏又盈，却来松下笑相迎。\n事销腊雪浑非旧，人似寒梅独有情。\n香火旧缘生理足，烟霞新志著书成。\n明朝又入千峰去，犹恐时人识姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和明上人见赠 其一","author":"王铚","text":"西湖梅蕊暗香浮，锡杖凌空过沃洲。\n后会重寻人更老，颓光不驻水争流。\n夕阳天际青山出，暝色烟中白鸟留。\n此境只曾支遁赏，剡溪今始得汤休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵德麟","author":"王铚","text":"故国春浓懒纵观，强寻幽境步蹒跚。\n风酣蕙草清香煖，烟湿杏花红粉寒。\n但觉时光自催换，可怜人事几悲酸。\n百年未必长于梦，虚作邯郸枕上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"王铚","text":"夜久灯花自吐红，岁华已尽尚飘蓬。\n身游百越风波外，路入千山雨雪中。\n失马旧知无得丧，拂龟那更问穷通。\n懒将今古从头数，几度邯郸梦不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定光院","author":"王铚","text":"兵戈几载剧波翻，去住优游僧自閒。\n已熟机缘到真际，久将生死断人寰。\n沙明寒水月窥涧，露湿晓烟秋在山。\n一佛镜中那是别，孤云不离乱峰间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顷在庐山与故友可师为诗社尝次韵和予诗云空中千尺堕柳絮溪上一旗开茗芽绝爱晴泥翻燕子未须风雨落梨花重江碧树远连雁刺水绿蒲深映沙想见方舟端取醉酒酣风帽任攲斜后三十年避地剡溪山中时可师委蜕亦二纪矣灵隐明上人追和此为赠感念存没泪落衣巾因用韵谢之","author":"王铚","text":"昔访庐山惠远家，寻春草木未萌芽。\n自从柳折烟中色，不寄梅开雪后花。\n事往泪多添海水，诗来恨满算河沙。\n惊回三十年前梦，放鹤峰头日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]