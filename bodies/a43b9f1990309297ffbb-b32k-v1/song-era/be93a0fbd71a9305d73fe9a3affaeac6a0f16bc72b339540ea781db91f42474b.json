[{"title":"君子吟","author":"邵雍","text":"君子之去，亦如其来。\n小人之来，亦如其去。\n既有恩情，且无怨怒。\n既有憎嫌，且无思慕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"君子饮酒吟","author":"邵雍","text":"父慈子孝，兄友弟恭。\n家给人足，时和岁丰。\n筋骸康健，里闬乐从。\n君子饮酒，其乐无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听天吟","author":"邵雍","text":"上天生我，上天死我。\n一听于天，有何不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应龙吟","author":"邵雍","text":"龙者阳类，与时相须。\n首出庶物，同游六虚。\n能潜能见，能吸能呼。\n能大能小，能有能无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忧梦吟","author":"邵雍","text":"至人无梦，圣人无忧。\n梦为多想，忧为多求。\n忧既不作，梦来何由。\n能知此说，此外何修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"把手吟","author":"邵雍","text":"富贵把手，贫贱掣肘。\n贫贱把手，富贵掣肘。\n金石之交，死且不朽。\n市井之交，自难长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时吟","author":"邵雍","text":"骐骥壮时，千里莫追。\n及其衰也，驽马先之。\n时与事会，谈笑指挥。\n时移事去，虽死奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灾来吟","author":"邵雍","text":"灾自外来，犹可消除。\n灾自内来，何由支梧。\n天人之间，内外察诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忠厚吟","author":"邵雍","text":"小人斯须，君子长久。\n斯须倾邪，长久忠厚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"性情吟","author":"邵雍","text":"君子任性，小人任情。\n任性则近，任情则远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"性情吟","author":"邵雍","text":"践形治性，践迹治情。\n贤人践迹，圣人践形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"所学吟","author":"邵雍","text":"人之所学，本学人事。\n人事不修，无学何异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治心吟","author":"邵雍","text":"心亲于身，身亲于人。\n不能治心，焉能治身。\n不能治身，焉能治人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟","author":"邵雍","text":"君子小人，亦常相半。\n时止时行，或治或乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟","author":"邵雍","text":"财利为先，笔舌用事。\n饥馑相仍，盗贼蜂起。\n孝悌为先，日月长久。\n时和岁丰，延年益寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟五首 其四","author":"邵雍","text":"火能胜水，火不胜水，其火遂灭。\n水能从火，水不从火，其水不热。\n夫能制妻，夫不制妻，其妻遂绝。\n妻能从夫，妻不从夫，其妻必孽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"治乱吟五首 其一","author":"邵雍","text":"乱多于治，害多于利。\n悲多于喜，恶多于美。\n一阴一阳，奈何如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓮牖吟","author":"邵雍","text":"有客无知，唯知自守。\n自守无他，唯求寡咎。\n有屋数间，有田数亩。\n用盆为池，以瓮为牖。\n墙高于肩，室大于斗。\n布被暖馀，藜羹饱后。\n气吐胸中，充塞宇宙。\n笔落人间，晖映琼玖。\n人能知止，以退为茂；我自不出，何退之有。\n心无妄思，足无妄走；人无妄交，物无妄受。\n炎炎论之，甘处其陋。\n绰绰言之，无出其右。\n羲轩之书，未尝去手。\n尧舜之谈，未尝虚口。\n当中和天，同乐易友。\n吟自在诗，饮欢喜酒。\n百年升平，不为不偶。\n七十康强，不为不寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经世吟","author":"邵雍","text":"羲轩尧舜，汤武桓文；皇王帝伯，父子君臣。\n四者之道，理限于秦。\n降及两汉，又历三分。\n东西俶扰，南北纷纭。\n五胡十姓，天纪几焚。\n非唐不济，非宋不存。\n千世万世，中原有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诧嗟吟","author":"邵雍","text":"昨日炙手，今日张罗。\n人间常事，何诧何嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贪义吟","author":"邵雍","text":"贪人之恶，其过莫大。\n贪人之善，是亦为罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽明吟","author":"邵雍","text":"明有日月，幽有鬼神。\n日月照物，鬼神依人。\n明由物显，幽由人陈。\n人物不作，幽明何分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思省吟","author":"邵雍","text":"仲尼再思，曾子三省。\n予何人哉，敢忘修整。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思虑吟","author":"邵雍","text":"思虑未起，鬼神莫知。\n不由乎我，更由乎谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"是非吟","author":"邵雍","text":"是短非长，好丹非素。\n一生区区，未免爱恶。\n爱恶不去，何由是非。\n爱恶既去，是非何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"畏爱吟","author":"邵雍","text":"人有正性，事事皆齐。\n人无正性，事事皆隳。\n失于用恩，以非为是。\n失于用威，以是为非。\n恩威既失，畏爱何知。\n不知畏爱，何用恩威。\n喜怒不节，鲜不至斯。\n妇人男子，宜用戒之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盆池吟","author":"邵雍","text":"有客无知，唯知不为。\n不为无他，唯求不欺。\n我有人是，人无我非。\n因开瓮牖，遂凿盆池。\n都邑地贵，江湖景奇。\n能游泽国，不下堂基。\n帘外青草，轩前黄陂。\n壶中月落，鉴里云飞。\n既有荷芰，岂无?茨。\n既有蝌蚪，岂无蛟螭。\n亦或清浅，亦或渺瀰。\n亦或渌净，亦或涟漪。\n风起蘋藻，凉生袖衣。\n林宗何在，范蠡何归。\n密雪霏霏，轻冰披披。\n垂柳依依，细雨微微。\n可以观止，可以忘机。\n可以照物，可以看时。\n不乐乎我，更乐乎谁。\n吾于是日，再见伏羲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫子吟","author":"邵雍","text":"鸡能警旦，马能代行。\n犬能守禦，牛能力耕。\n人禀天地，万物之灵。\n妒贤嫉能，不如不生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵贱吟","author":"邵雍","text":"系自我者，可以力行。\n系自人者，难乎力争。\n贵为万乘，亦莫之矜。\n贱为匹夫，亦莫之凌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"费力吟","author":"邵雍","text":"事无巨细，人有得失。\n得之小心，失之费力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迷悟吟","author":"邵雍","text":"君子改过，小人饰非。\n改过终悟，饰非终迷。\n终悟福至，终迷祸归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家国吟","author":"邵雍","text":"邪正异心，家国同体。\n邪能败亡，正能兴起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宽猛吟","author":"邵雍","text":"宽则民慢，猛则民残。\n宽猛相济，其民自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恩义吟","author":"邵雍","text":"恩深者亲，义重者君。\n恩义两得，始谓之人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恩怨吟","author":"邵雍","text":"人之常情，无重于死。\n恩感人心，死犹有喜。\n怨结人心，死犹未已。\n恩怨之深，使人如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"能寐吟","author":"邵雍","text":"大惊不寐，大忧不寐，大伤不寐，大病不寐，大喜不寐，大安能寐。\n何故不寐，湛于有累。\n何故能寐，行于无事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书 其四","author":"邵雍","text":"才高命寡，耻居人下。\n若不固穷，非知道者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书 其二","author":"邵雍","text":"贤德之人，所居之处。\n如芝如兰，使人爱慕。\n凶恶之人，所居之处。\n如虎如狼，使人怕怖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"邵雍","text":"天生万物，各遂其一。\n唯人最灵，万物能并。\n芝兰芬芳，麒麟凤凰。\n此类之人，鲜有不臧。\n狼毒冶葛，枭鸩蛇蝎。\n此类之人，鲜有不孽。\n臧唯思安，孽唯思残。\n日夜无息，相代于前。\n天无私覆，地无私载。\n俱能含养，始知广大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书 其三","author":"邵雍","text":"妻强夫殃，奴强主殃，臣强君殃。\n尾大于身，冰坚于霜。\n辩之不早，国破家亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶得吟","author":"邵雍","text":"皋陶遇舜，伊尹逢汤。\n武丁得傅，文王获姜，齐知管仲，汉识张良。\n诸葛开蜀，玄龄启唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奢侈吟","author":"邵雍","text":"侈不可极，奢不可穷。\n极则有祸，穷则有凶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"娶妻吟","author":"邵雍","text":"人之娶妻，容德威仪。\n傥或生子，不皋则夔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庶几吟","author":"邵雍","text":"以圣责人，固未完备。\n以人望人，自有馀地。\n责人无难，受责非易。\n其殆庶几，犹望颜子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得失吟","author":"邵雍","text":"人有贤愚，事无巨细。\n得不艰难，失必容易。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳于髡酒谏","author":"邵雍","text":"赐酒于君，饮不知味。\n执法在前，恐惧无既。\n当此之时，一斗而醉。\n宗族满堂，既孝且悌。\n尊卑以亲，少长有齿。\n当此之时，二斗而醉。\n宾之初筵，跄跄济济。\n献酬百拜，升降有礼。\n当此之时，三斗而醉。\n里闬过从，如兄如弟。\n时和岁丰，情怀欢喜。\n当此之时，五斗而醉。\n朋友往还，讲道求义。\n乐事赏心，登山临水。\n当此之时，八斗而醉。\n男女杂坐，杯觞不记。\n灯烛明灭，衣冠倾圯。\n当此之时，一石而醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清和吟","author":"邵雍","text":"清而不和，隘而多鄙。\n和而不清，慢而鲜礼。\n既和且清，义无定体。\n时行则行，时止则止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盛衰吟","author":"邵雍","text":"克肖子孙，振起家门。\n不肖子孙，破败家门。\n猗嗟子孙，盛衰之根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"善人吟","author":"邵雍","text":"良如金玉，重如丘山。\n仪如鸾凤，气如芝兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"善恶吟 其二","author":"邵雍","text":"尧舜无子，瞽鲧有嗣。\n福善祸淫，何故如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"善恶吟 其一","author":"邵雍","text":"瞽鲧有子，尧舜无嗣。\n馀庆馀殃，何故如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"趋向","author":"邵雍","text":"舍我灵龟，观我朵颐。\n背义从利，人无远思。\n贲于丘园，束帛戋戋。\n既能图大，小在其间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"意外吟","author":"邵雍","text":"事出意外，人难智求。\n自非妄动，恶用多愁。\n既有误中，宁无暗投。\n能知此说，天下何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"意尽吟","author":"邵雍","text":"意尽于物，言尽于诚。\n矫情镇物，非我所能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解字吟","author":"邵雍","text":"人言为信，日月为明。\n止戈为武，羔美为羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疑信吟","author":"邵雍","text":"人无轻信，事无多疑。\n轻信招衅，多疑招离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"影论吟","author":"邵雍","text":"性在体内，影在形外。\n性往体随，形行影会。\n体性不存，形影安在。\n影外之言，曾何足怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薰莸吟","author":"邵雍","text":"善恶之间，薰莸可究。\n近薰必香，近莸必臭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一等吟","author":"邵雍","text":"欲出第一等言，须有第一等意。\n欲为第一等人，须作第一等事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小车六言吟","author":"邵雍","text":"昔人乘车是常，今见乘车仓皇。\n既有前车戒慎，岂无覆辙兢庄。\n将出必用茶饮，欲登先须道装。\n轸边更挂诗帙，辕畔仍悬酒缸。\n轮缓为移芳草，盖低因碍垂杨。\n水际尤宜稳审，花间更要安详。\n朝出频经履道，晚归屡过平康。\n春重纵观明媚，秋深饫看丰穰。\n五凤楼前月色，天津桥上风凉。\n金谷园中流水，魏王堤外脩篁。\n静处光阴最好，闲中气味偏长。\n所经莫不意得，所见无非情忘。\n或见农人拥耒，或见蚕女求桑。\n或见蘼芜遍野，或见蒺藜满墙。\n或见荆棘茂密，或见芝兰芬芳。\n或见鸡豚狗彘，或见雕鹗鸾凰。\n恶者既不见害，善者固无相伤。\n华岳三峰岌嶪，黄陂万顷汪洋。\n不为虚作男子，无负闲居洛阳。\n天地精英多得，尧夫老去何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐物吟","author":"邵雍","text":"物有声色气味，人有耳目口鼻。\n万物于人一身，反观莫不全备。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得失吟","author":"邵雍","text":"时难得而易失，心虽悔而何追。\n不知老之已至，不知志与愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"爽口吟","author":"邵雍","text":"爽口之物少茹，爽心之行少虑。\n爽意之言少语，爽身之事少做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双头莲","author":"邵雍","text":"汉室婵娟双姊妹，天台缥缈两神仙。\n当时尽有风流过，谪向人间作瑞莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观棋长吟","author":"邵雍","text":"院静春深昼掩扉，竹间闲看客争棋。\n搜罗神鬼聚胸臆，措致山河入范围。\n局合龙蛇成阵斗，劫残鸿雁破行飞。\n杀多项羽坑秦卒，败剧符坚畏晋师。\n座上戈鋋尝击搏，面前冰炭旋更移。\n死生共抵两家事，胜负都由一着时。\n当路断无相假借，对人须且强推辞。\n腹心受害诚堪惧，唇齿生忧尚可医。\n善用中伤为得策，阴行狡狯谓知机。\n请观今日长安道，易地何尝不有之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"邵雍","text":"遂令高卧人，欹枕看儿戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"邵雍","text":"始信画前原有易，自从删后更无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"邵雍","text":"水光连夜白，雪意共云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙州","author":"邵稽仲","text":"峭壁阴森古木稠，乱山深处指龙州。\n猿啼鸦噪溪云暮，不是愁人亦自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁国寺","author":"邵輶","text":"地胜千岩秀，名高万古存。\n丹崖纪灵躅，绀宇蔽祇园。\n树老垂藤影，池幽浸藓痕。\n会心多兴趣，随意坐林樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鉴轩","author":"邵輶","text":"池光开净镜，山影展修眉。\n石冷映碧色，烟轻生翠漪。\n乞湖思贺监，观水咏宣尼。\n照坐心神瑩，徜徉殊复奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辞世","author":"邹希衍","text":"戊亥重逢日，乾坤透迥时。\n幻身今已脱，明日有丹梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游宝林寺","author":"邹应龙","text":"乳燕啼鸠三月暮，淡云疏雨午时天。\n金雀花落无人管，断送韶光又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游宝盖岩","author":"邹应龙","text":"夙有斯岩约，今朝喜践盟。\n路从支涧入，人在半空行。\n六月如霜候，四时长雨声。\n愿求容膝地，著我过浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]