[{"title":"汪德邵挽诗","author":"洪适","text":"监郡能名播，分符治行高。\n俄惊驹过隙，不见鹤鸣皋。\n三径宾朋散，重楼柱石牢。\n伤心丹旐举，旧事记松醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭叔容挽诗","author":"洪适","text":"襟宇无畦町，乡评有誉言。\n宦途材智出，名阀典刑存。\n未试牛刀手，俄招马鬣魂。\n有怀尊酒日，挥泪北山昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章令人挽诗","author":"洪适","text":"肥家尊淑范，阅世悟浮沤。\n风棘慈颜隔，堂萱子舍忧。\n六珈齐上寿，一剑跃中流。\n绋路倾邻曲，凄其松露秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁竑夫挽诗二首 其一","author":"洪适","text":"材高易盘错，语妙出波澜。\n和气如春暖，交情耐岁寒。\n牧民千里治，奉使五刑宽。\n杖屦怀陈迹，琴亡曲罢弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁竑夫挽诗二首 其二","author":"洪适","text":"向来持国秉，贡禹合弹冠。\n予节缘心计，飞章或面谩。\n开陈疑已释，腾跃事非难。\n覆餗长缄恨，何知便盖棺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏彦诚挽诗三首 其一","author":"洪适","text":"星文推独步，风采偃先声。\n沉虑千人废，高谈一坐倾。\n苏枯崇治效，去草折奸萌。\n春雾新阡暗，裁诗泪睫横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏彦诚挽诗三首 其二","author":"洪适","text":"偃月欺天日，淫刑及反唇。\n程论传学者，粤岭作流人。\n贻后端无憾，瞻前讵有邻。\n太刚终龃龉，袖手老江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏彦诚挽诗三首 其三","author":"洪适","text":"昔年同揽辔，累日到门阑。\n题竹飞松管，观鱼走玉槃。\n著鞭颜有愧，推毂力何难。\n翻坐葭莩累，尘凝贡氏冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汪枢使挽诗二首 其一","author":"洪适","text":"两朝尊辅拂，一德赞规恢。\n简劾人所畏，囊封天可回。\n指挥兵事密，谈笑塞氛开。\n尺五魁三象，俄惊山岳颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汪枢使挽诗二首 其二","author":"洪适","text":"天陛黄麻出，同时拜宠荣。\n荐贤窥汲引，谋国冀升平。\n睽阔仍寒暑，吁嗟隔死生。\n门人有碑诔，不数汉公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荣国李夫人挽诗","author":"洪适","text":"斗枢光梓里，壶德讲鱼轩。\n教子诗书足，齐家礼法尊。\n相随双剑逝，来吊一刍存。\n松雾铭旌暗，悲歌塞墓门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许硕人挽诗","author":"洪适","text":"敬兰光相阀，采藻助儒宗。\n偕老金犀贵，增封石窌重。\n川深双剑合，壤吉万家容。\n遥想铭旌举，悲风喝雾松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向侍郎挽诗二首 其一","author":"洪适","text":"策足王城日，声名显妙年。\n剸裁无肯綮，施置不拘牵。\n惊坐瞻挥麈，丰财赖算鞭。\n中兴良吏盛，佳传压甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向侍郎挽诗二首 其二","author":"洪适","text":"沃辔环天下，澄清今范滂。\n带牛奸破穴，问马智盈囊。\n踰七春秋足，尊三爵德光。\n乡闾失耆旧，绋路送车忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余文特挽诗","author":"洪适","text":"决科荣彩服，诺仕振芳埃。\n金玉胸怀好，珠玑言语堆。\n一麾临白首，八载厄黄能。\n情话今陈迹，悲悰衮衮来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张待制挽诗","author":"洪适","text":"松关辞旧隐，平步汉甘泉。\n破虏资长策，丰财简细旃。\n救荒阴德大，尚齿达尊全。\n觞豆怀陈迹，风悲马鬣阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭仲光挽诗","author":"洪适","text":"吉德传乡党，家声企大儒。\n九霄欣得路，五马议分符。\n叹息人琴逝，凄凉邻曲孤。\n霜风丹旐举，松雾暗黄垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢弟挽诗三首 其一","author":"洪适","text":"少小犹朋友，陈编昼夜开。\n同时题雁塔，旬月聚麟台。\n词掖君先达，台阶我后来。\n伤心今古隔，楚挽不胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢弟挽诗三首 其二","author":"洪适","text":"投老开三径，联翩北郭门。\n嘲花诗插架，对竹酒盈尊。\n叹息千秋宅，荒凉十亩园。\n谈丛铛折脚，云暗脊令原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢弟挽诗三首 其三","author":"洪适","text":"静镇多遗爱，存桥有远谋。\n禁林传大册，宥地简前旒。\n疾也劳心得，生乎撒手休。\n三年棠棣径，倚杖泪争流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈公秀吏部挽诗","author":"洪适","text":"顷陟词坛日，初瞻雁塔名。\n坐毡甘独冷，揭节守真清。\n蜂虿能阴中，骅骝使却行。\n佳城千里外，无处送铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张龙学挽诗二首 其一","author":"洪适","text":"今代风云会，何人善论兵。\n丹墀凝睿想，黄石踵家声。\n瑞国仪千仞，筹边妙两楹。\n重泉有遗恨，不见复神京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张龙学挽诗二首 其二","author":"洪适","text":"中台双挈橐，重镇四分符。\n井地观佳政，林蛮铄异图。\n犁添长乐犊，鞭截豫章蒲。\n处处甘棠泪，黄童白叟俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周尚书挽诗二首 其一","author":"洪适","text":"九师迷易说，皇极倡先天。\n学苦韦编绝，名高雁塔悬。\n朱轓多惠露，紫橐表甘泉。\n叹息佳城闭，乔松锁暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周尚书挽诗二首 其二","author":"洪适","text":"忆昨登瀛日，官曹幸接联。\n再来闻国论，及见上经筵。\n渊识窥灵宪，嘉谟凑细旃。\n生刍千里奠，觅句一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姚参政挽诗二首 其一","author":"洪适","text":"发轫词坛日，曾同萧寺盟。\n望洋吞渤澥，历块指幽并。\n不竞二三策，难淹九万程。\n君王颛赐第，千佛漫联名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姚参政挽诗二首 其二","author":"洪适","text":"晋昼光三接，霜台肃纪纲。\n栽培指佞草，重叠上书囊。\n笔橐留施设，钧枢忆赞襄。\n伤心左溪路，松桧已成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周知郡挽诗","author":"洪适","text":"德比圭璋润，言如布帛温。\n休心驰官路，寓意傲家园。\n侯国思遗爱，吾乡欠达尊。\n佳城邻别墅，松雾望中昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶提刑挽诗","author":"洪适","text":"冠带桥门拥，曾披星斗文。\n属鞬寻耿贾，投笔远渊云。\n献纳频三接，平反自一欣。\n凄凉真率会，鸥鹭也离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彭叔阳挽诗","author":"洪适","text":"买邻乔木近，不隔一牛鸣。\n甲第夸新作，高楼待落成。\n未教长纵壑，亦合且专城。\n矫首天难问，伤哉挽铎声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"参议弟挽诗","author":"洪适","text":"新筑久同隐，崇桃存旧栽。\n壶中春漫别，花下我频来。\n议幕三年隔，丧舟千里回。\n琴亡情话绝，泪落有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"台州会太守致语口号","author":"洪适","text":"子墨声名满上都，同时曾喜得相如。\n二年宁俟棠阴久，一日先看薤本除。\n已向云霄班玉笋，却思风月佩铜鱼。\n百川莫靳长鲸吸，会即泥封虎爪书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋阅致语口号","author":"洪适","text":"使星两两下人间，南伯来临黄木湾。\n盖海旌幢龙户集，折冲樽俎豹韬閒。\n铦锋似雪摇银海，美酒如渑倒玉山。\n宾主一时皆伟望，璇霄不日侍天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又归路","author":"洪适","text":"风动旌旗熊虎开，喧轰鼓吹隐晴雷。\n襟裾夹道邦人出，介胄填郛方伯来。\n按辔传声真烜赫，铺茵呈舞少徘徊。\n林蛮洞蜑皆心詟，共看威伸讲武台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"设蕃乐语口号","author":"洪适","text":"海山楼下水朝东，此去瀰漫拍太空。\n稛载宁寻蕞尔国，舟行好趁快哉风。\n往来云汉经星外，出入鱼龙巨浪中。\n拜手君王零湛露，举觞须似吸川虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会肇庆新守乐语口号","author":"洪适","text":"元戎好客过当时，喜报江头鹢首飞。\n款曲西宾香作阵，安排南食妓分围。\n甘醪不必金貂换，清话频看玉麈挥。\n祇隔嵩台衣带水，未须轻赋醉言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会肇庆旧守乐语口号","author":"洪适","text":"再岁专城屈令才，西江人至说清埃。\n瓜时解组飘飘去，雪夜乘舟得得来。\n一笑坐间桑落酒，几声乐奏越王台。\n元戎预起阳关恨，不放谯门玉漏催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会黄雷州乐语口号","author":"洪适","text":"二难辞藻琢琼瑰，入洛当年擅轶才。\n五岭达官今寂寞，九龄高躅久尘埃。\n分符有此二千石，投辖中之三百杯。\n衣绣还乡真罕见，戏鱼同队几驽骀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平齐孙致语口号","author":"洪适","text":"山越逋诛岁屡更，元戎指纵有奇兵。\n长歌壮士归三箭，必胜良筹妙两楹。\n兔窟已空春草碧，鲸波无事暮潮平。\n干戈便挽天河洗，桴鼓从今不复鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会南恩守傅侍郎致语口号","author":"洪适","text":"向来烽火起边尘，肤使南翔誉益振。\n肯为鱼符临海角，合归鹭序映朝绅。\n高情如泛阴山雪，喜气能添泽国春。\n一斗百篇推敏捷，醉中端有语惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩提舶解印致语口号","author":"洪适","text":"万户封侯识面难，南来清誉落诸蛮。\n指挥浪舶风帆了，谈笑木牛流马间。\n回牡言归光帐饯，一杯相属看弓弯。\n行行日远长安近，平步逍遥玉笋班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韩提舶饯行致语口号","author":"洪适","text":"激浊扬清有渭泾，鞭鸾归去侍天庭。\n文星持节光南斗，巨翼摩空击北溟。\n黄木湾头波湛碧，阳关声里柳吹青。\n莫辞更尽一杯酒，明日相思过短亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"众官饯提舶乐语口号","author":"洪适","text":"泰山英誉冠当时，五岭人人说绣衣。\n平步便应持紫橐，它年何止到黄扉。\n迟迟暖日离筵启，渺渺澄江画航归。\n若问越装无一物，箧中宝唾尽珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东春教致语口号","author":"洪适","text":"高管嗷嘈叠鼓忙，春云轻覆飨军堂。\n二星光动狐狸伏，六纛威腾貔虎良。\n海孽向来如薙草，射夫无有不穿杨。\n时平已卧边庭鼓，不废蒐田谨旧章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归路致语口号","author":"洪适","text":"辕门返旆到康庄，甚宠传呼实鲜双。\n丽锦轻翻青玉案，高牙旁耸碧油幢。\n令行遐峤真无事，盗息潢池不受降。\n会见追锋归禁密，独留威誉纪南邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天申节道场所回栏阶白语口号","author":"洪适","text":"濯冠沐浴意能虔，已萃缁黄介万年。\n乐备八音浮喜气，香飘九陌凝祥烟。\n双旌未用催茸纛，四牡何妨款著鞭。\n夹道邦人方属目，试教舞袖略回旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前筵祝圣致语口号","author":"洪适","text":"帝晖咫尺照龙楹，绕殿嵩呼若震霆。\n朝士班齐鸾步武，仙官瑞集鹤仪形。\n奉觞亦有单于使，秉笔应书南极星。\n遐峤莫瞻天日表，愿将湛露等沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对厅致语口号","author":"洪适","text":"时逢化国日舒长，解愠风来宇宙凉。\n飞鹢闿祥瞻北极，颁鱼锡宴暨南方。\n纷纷人赞元侯德，两两星舒使者光。\n来岁广庭班玉笋，斯辰同奉万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王母队祝圣致语口号","author":"洪适","text":"六幕纷纷启瑞篇，非烟深处下芝軿。\n穆王扰扰不谋治，武帝区区空学仙。\n今代一人真间世，昔时五老与疑年。\n欢呼亦有南山颂，谁解吹嘘上九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对厅致语口号","author":"洪适","text":"天街蹀躞跨连钱，帝念遐萌辍隽贤。\n玉节绣衣三绝席，翠樽琼斝再开筵。\n管弦声动宫商叶，雨露恩均草木妍。\n定有千秋金鉴录，明年亲奏御床前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广西春教致语口号","author":"洪适","text":"元戎堂上有奇兵，楼堞旌旗未易名。\n光接二星瞻使节，令行八桂畅军声。\n指挥已定熊罴肃，什伍才分鹅鹳成。\n威烈远超铜柱外，雕题交趾尽魂惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道上致语口号","author":"洪适","text":"广陌无风柳絮藏，轻尘不起整戎装。\n洞丁累化青春寂，师乙谐声白昼长。\n无数冠裳云塞道，两行鈇钺雪摇光。\n英英如此桂林伯，便令腰金上玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归府致语口号","author":"洪适","text":"凝笳叠鼓压天南，从此邦人作美谈。\n北里声名皆擢秀，东州歌舞总怀惭。\n轻裘坐啸青油幕，积甲高齐碧玉簪。\n闻道家家卖钗钏，武夫归去亦醺酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水教致语口号","author":"洪适","text":"元戎肤使憩胡床，寓目舟师夏日长。\n捷比黄头能辑濯，勇于长鬣取馀皇。\n水中剑影蛟龙避，帐下兵威狐兔藏。\n见说潢池毁多□。\n新来归去事耕桑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归路致语口号","author":"洪适","text":"油幢红旆届通衢，共听歌诗我不诬。\n弭盗初无沈命法，应时谁用辟兵符。\n翻然奋袖回罗绮，观者骈肩足裤襦。\n早晚天书颁瑞锦，好书乐石遗番禺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会肇庆黄通判乐语口号","author":"洪适","text":"古锦衔标户户知，瀛洲准拟上云逵。\n当今便便五经笥，自昔汪汪千顷陂。\n肯向江边留鹢首，莫辞花底罄鸱夷。\n康沂成咏颁归诏，剥啄相寻后会期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会郑韩二守乐语口号","author":"洪适","text":"江别东西说二贤，鱼书同拜喜联翩。\n稚卿风采齐龚遂，延寿规模载颍川。\n玉麈挥谈飞玉屑，金龟换酒泛金船。\n莫辞痛饮娱清夜，对此中秋璧月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东秋教致语口号","author":"洪适","text":"清秋大试斧寻柯，噭咷谁言用楚歌。\n帅阃威名传籍籍，使台材业办多多。\n兵机总是师黄石，酒令同看卷白波。\n见说邻偷蜂蚁聚，远闻军政已投戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归路致语口号","author":"洪适","text":"旌旗猎猎战西风，介胄精明霜与同。\n拥道共瞻元帅至，折冲谁许十贤功。\n夸银拖綵征师喜，回袖垂螺舞女工。\n已向黄枢赞筹画，便应归侍大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"设蕃致语口号","author":"洪适","text":"舻人指日欲开樯，洽此需云宠远商。\n奇物试求师子国，去帆稳过大蛇洋。\n银杯更尽金杯饮，黑暗仍兼白暗将。\n方伯使华清澈底，不闻私有橐中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会广西田提刑致语口号","author":"洪适","text":"北斗南边云物明，烨然天节仰祥星。\n朝端獬豸曾张胆，道上狐狸已匿形。\n欲奉三章仁远峤，定知五管迓虚囹。\n迂程肯顾交情厚，莫惜花前倒绿醽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广东春教致语口号","author":"洪适","text":"豪竹繁弦振粤台，斗场雨过净纤埃。\n台符款曲三挥麈，军令分明屡举杯。\n兔窟久空春草出，鲸波无事早潮来。\n已知樽俎遐冲折，且欲班劳激趫材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归路致语口号","author":"洪适","text":"旌旆摇摇卷碧云，元戎振旅入城闉。\n蜚腾广誉孚朝野，讲肄强兵动鬼神。\n无数冠裳声聒昼，两行罗绮艳娇春。\n看看夜半朝宣室，便把金犀换玉麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f7968