[{"title":"塞外冬至","author":"彭汝砺","text":"今年至日是今朝，日影方长路更遥。\n霜雪辛勤白榆塞，鹓鸿怅望紫宸朝。\n阴冥丘壑云长暗，阳触渊泉冻欲销。\n欲问春来消息近，几多垂柳在溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻驾幸太学","author":"彭汝砺","text":"四海承平正右文，君王昨日幸成均。\n三千缝掖星辰拱，十二旗常日月新。\n万里去持山国节，六龙阻望属车尘。\n上心直欲窥尧禹，咫尺谁能席上珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君时宿直","author":"彭汝砺","text":"天寒不归汝安否，日暮有怀如此何。\n丈室全如在林壑，重云漫不见星河。\n高风侧听雍雍雁，濡露长悲蓼蓼莪。\n不是不知诗废事，相思不寐自成歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁池","author":"彭汝砺","text":"池水人言是雁池，池边兀坐久忘归。\n蓬瀛仙子红莲出，湖海幽人白鹭飞。\n杨柳垂阴留客佩，沧浪泼翠点人衣。\n故园一别头今白，目断江边旧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万安道中","author":"彭汝砺","text":"上下鸡笼牛口滩，滩头濯濯雨声寒。\n气蒸晓日云无间，波漾春风雪未乾。\n落絮并花浮远水，飞鸥随鹭落惊湍。\n扁舟稳泛沧浪远，珍重严陵一钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和佛印","author":"彭汝砺","text":"供佛堂中香积饭，度人门外白牛车。\n参禅长老或雪涕，说法虚空时雨花。\n灵鹫御风朝海渎，飞翚撒水抗烟霞。\n老师住处即安乐，祇恐卧龙生叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"执中学士以蔬菜见贶戏寄小诗","author":"彭汝砺","text":"贷粟监河公自贫，蔬菹投我觉情亲。\n不须乞饭去香积，谁会献芹如野人。\n维笋及蒲全似古，式歌且舞恰当春。\n投闲即拟同公醉，莫道无鱼可及宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与文渊游聘君亭分题和文渊亭字韵","author":"彭汝砺","text":"东湖九日水如冰，画舫还寻孺子亭。\n雨后断云归冉冉，天寒孤雁去冥冥。\n兰苕散漫池塘远，松竹参差岛屿青。\n贪惜上恩归未得，自怜双鬓欲垂星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内乡","author":"彭汝砺","text":"山谷生云作风雨，楼台映日贴烟霞。\n危峰熊耳倍千丈，废堞虎遥今数家。\n野外小桥丹作水，潭边仙菊雪开花。\n隆寒大热三经涉，世事催人早鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子开侍郎出守徐州","author":"彭汝砺","text":"彭城事事似南都，顷岁曾分刺史符。\n吏治甚惭前有召，民谣更愧昔无襦。\n最思凤沼凤凰集，还见雁池鸿雁孤。\n万事我今无一乐，扁舟归梦满江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蜀公家居","author":"彭汝砺","text":"平湖三月水犹寒，霜鉴冰壶照玉颜。\n柳暗何如江上路，云深不碍海中山。\n春风凫雁窥青琐，晚日波涛在白间。\n景物会招山简醉，时时倒着接䍦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖","author":"彭汝砺","text":"篇章芜漫不中看，误得先生一解颜。\n明月何为投暗室，阳春不意在穷山。\n平时借以齿牙论，今日见之眉睫间。\n自笑鸤鸠为计拙，谁知鸿雁及时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答蜀公奉酬 其一","author":"彭汝砺","text":"叠石栽花作小园，庭柯顾盼足怡颜。\n尽捐势利随流水，多占声名似泰山。\n细雨凫雏浮水际，微风燕子语梁间。\n竹冠筇杖篮舆好，认得公从湖上还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答蜀公奉酬 其二","author":"彭汝砺","text":"逍遥今是地行仙，无事全胜药驻颜。\n早岁风流都翰苑，他时文字出名山。\n修竿养竹千馀亩，小屋诛茅八九间。\n颍水可怜归未得，不如云鹤会飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答蜀公奉酬 其三","author":"彭汝砺","text":"丛条润泽无瞋胆，芳杜将迎失厚颜。\n陶令葛巾曾漉酒，谢公蜡屐惯寻山。\n观鱼恰似濠梁上，结宇浑如冈曲间。\n楚醴满觞知意惬，胡香细炷觉神还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中奉寄","author":"彭汝砺","text":"水涉山行歧路长，思亲一夜鬓毛霜。\n纷纷枝上慈乌宿，肃肃云中鸿雁行。\n活计一行随梦幻，生涯好去老耕桑。\n知君合续南陔赋，万里因风数寄将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武冈路中","author":"彭汝砺","text":"复岭重冈烟霭深，晚年多病觉难任。\n他乡一日如三岁，远路家书抵万金。\n流水可怜君未息，白云谁似尔无心。\n天寒日暮双飞鸟，寂寂归栖只旧林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张大夫友兄","author":"彭汝砺","text":"尘土无人慰病怀，篇章一见觉心开。\n风高昨夜冥鸿去，水涩何时画鹢来。\n天上旧传公子贵，江东还见步兵才。\n老成合有言为赠，倚马相望故凤台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周朝议赴郢 其一","author":"彭汝砺","text":"岩石沧洲一水涯，画船几夜宿芦花。\n芭蕉山谷灵峰寺，龟鹤池塘梅福家。\n今日岂应无白雪，当时亦未见皇华。\n兵厨且善为冰酒，当为公浮八月槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周朝议赴郢 其二","author":"彭汝砺","text":"驱马悠悠何所之，岘山南去习家池。\n莲花可爱肌如雪，鸥鸟何为鬓亦丝。\n一叶林头秋到处，片云溪上雨来时。\n公方紫绶金章贵，可要山公白接䍦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城上","author":"彭汝砺","text":"孤城纵目尽南东，山转溪回翠且重。\n云际静浮滨汉水，林端清送上方钟。\n今时汉北无雏凤，当日襄南有卧龙。\n万事废兴无足问，登临吾乐正从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人答周朝议生辰赠章","author":"彭汝砺","text":"我辰邂逅得朱明，一离阴邪一点生。\n蓬矢尚存随薄宦，龙驹已老怯修程。\n鬓毛久似安仁白，神气初惭卫玠清。\n南郭丈人慈爱并，远分珠玉助光荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谷城溪亭","author":"彭汝砺","text":"谷国有亭溪水边，税车安寝不无缘。\n芰荷苒苒双飞鸟，芦苇深深一钓船。\n故国寄声无去雁，他乡催泪有啼蝉。\n江山亦为行人动，六月寒风正凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答孙荆州颃","author":"彭汝砺","text":"凤林清淑郁扶舆，五马当年数驻车。\n故老作歌今未已，大贤为政法何如。\n二碑岘首窥馀烈，一纸荆州得近书。\n缩项槎头知未羡，龙州闻说更多鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中寄君时","author":"彭汝砺","text":"可怜平生不堪处，未有一朝无病时。\n患难寻常心欲折，尘埃四十发如丝。\n倦游司马多闻友，现病维摩大导师。\n筋力尚堪游乐在，不应空废百花期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠","author":"彭汝砺","text":"离群已是四年秋，昔是少年今白头。\n旧日雁池应好在，多情睢水会东流。\n更贫尚有箪瓢在，已见谁能度数求。\n三径渊明多种菊，五湖范蠡有归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈叶提举","author":"彭汝砺","text":"自笑肩舆钝似椎，不如马足快如鵻。\n驱驰祇似江西日，懒病全非年少时。\n熟睡疑空净石室，沈思若下董生帷。\n道途不独输公敏，凡事相方总较迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马太守五首 其一 寒林","author":"彭汝砺","text":"平林十里看深秋，疏影横斜翠欲流。\n日晚小舟维别浦，天寒飞鸟浴沧洲。\n傍山畦径村村远，近水轩楹事事幽。\n欲赋祇惭非太白，酒卮独觊一朝酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马太守五首 其二 翠玉","author":"彭汝砺","text":"平湖如鉴见寒林，谁作高亭据静深。\n到海水源终有本，从龙云影自无心。\n芰荷一片随幽赏，鸂鶒双飞近醉吟。\n顾我倦游归欲早，寒门独觊数窥临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马太守五首 其三 水云","author":"彭汝砺","text":"万竹娟娟一径开，禅师当日为谁栽。\n本支间出为龙去，秀实长留待凤来。\n挥袂好风能应接，杖藜栖鸟误惊猜。\n公游岂得如嵇阮，禁省方归治剧材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马太守五首 其四 五老峰","author":"彭汝砺","text":"不到匡庐今几年，幽亭纵目意茫然。\n苍颜想像重湖外，翠色参差落照前。\n润泽为霖功及物，坚高作柱势参天。\n使君笔墨真能赋，不必须凭绘画传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和马太守五首 其五 澄心亭","author":"彭汝砺","text":"逸老初开池上亭，使君钟鼓乐新成。\n宝林自有湖山助，定水何曾风浪生。\n雨过淡云迷岛屿，日长幽鸟下檐楹。\n扁舟远泛沧浪碧，可避时人笑独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和念一弟","author":"彭汝砺","text":"冈陵盘泊土湖深，蛟蜃伏藏山鸟吟。\n大雪埋云冬寂寞，乔松夹竹昼阴森。\n百年身逐无涯智，万斛愁中方寸心。\n昨日汝诗催泪落，暴添溪水两三寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江道中人家多植竹","author":"彭汝砺","text":"远远平山浅浅溪，人家栽竹当藩篱。\n雪霜尽腊青如昨，风月乘春绿更滋。\n淡薄冷光浮莽苍，招摇清影落涟漪。\n故园所富今几顷，会有归来筑隐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和毛正仲","author":"彭汝砺","text":"风雨登危奚壮哉，见书三赋彼崔嵬。\n细缘狗脊仆肩病，曲转羊肠车辙摧。\n晨鹊卜知书信到，夜星占见使华来。\n爱君最识思亲意，取次枯肠夜九回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄提举朝议丈","author":"彭汝砺","text":"安稳青云喜得舆，寂寥穷巷忆回车。\n灌畦搰搰知同病，游刃恢恢想自如。\n暇日会驰千里驾，好风时寄一行书。\n爱公有似能鸣雁，顾我还同喣湿鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河东桥亭以久废置不用欲移菜畦以为老之游息之地因以诗就公权乞之","author":"彭汝砺","text":"全家归住白云中，旧地新成半亩宫。\n簇簇要添垂柏翠，纷纷已出小花红。\n自知北海恩怀厚，况是东邻路径通。\n到得落成应不负，携壶先约醉春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏一首","author":"彭汝砺","text":"小林幽径自春华，不似城头望处佳。\n山色倚云千万里，蓬门穿水两三家。\n声闻翠筱纷纷叶，香落寒梅细细花。\n更上幽亭望南北，欲随幽鸟到天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病告诗上侍读","author":"彭汝砺","text":"诗句亲题慰下僚，清心洗尽渴心焦。\n云移星月来幽隐，风转英茎下寂寥。\n肝胆尘生知几日，齿牙病久起今朝。\n篇章尽出樵苏鄙，不识鳌宫路径遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄史司理","author":"彭汝砺","text":"日就妻孥问药囊，镜中自笑鬓毛苍。\n诗编欲乞闲方记，茶面亲题病未尝。\n饮量无涯倾北海，风情不薄念东阳。\n终篇未尽相望意，洗耳风前迟报章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睦仲乞诗用其韵谢之","author":"彭汝砺","text":"郁郁胸怀百未伸，道途容易学参辰。\n桂科今日须吾子，鼎食当时况所亲。\n景物依依吟晓色，讴谣细细问途人。\n春风写寄南淮地，萧洒文章自细陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔兄书斋言志 其一","author":"彭汝砺","text":"子夏今为河上居，诸生从此望夷涂。\n圣贤事业长难合，仁义生涯未至迂。\n盛德固能苏弊俗，明时安忍作潜夫。\n鞭驽欲副新诗念，争奈曾参性质愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔兄书斋言志 其二","author":"彭汝砺","text":"常因多病泣途穷，性命于今亦少通。\n贵贱固宜常厥德，死生岂足动吾中。\n游心自有诗书学，扶病须凭药石功。\n否剥亦留归泰复，天时安得久屯蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔兄书斋言志 其三","author":"彭汝砺","text":"旅人汲汲赴前程，奔走川途不暂停。\n踪迹无如今困蹇，才谋不似旧精灵。\n雍容可羡云中雁，浩荡来随水面萍。\n富贵功名皆外物，艰难险阻亦须经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔兄书斋言志 其四","author":"彭汝砺","text":"未得临流一醉观，江山应是怨无端。\n苦吟夜月横诗笔，烂醉秋风把钓竿。\n溪濑最宜霜后听，峰峦曾向雨中看。\n输君瞬息穷千里，苒苒羁怀几万般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓学芝山","author":"彭汝砺","text":"鲸鹏未得遂南飞，翻学鹪鹩寄一枝。\n翠石碧泉无尽处，冷蛩鸣雁不胜悲。\n驱除穷困知何计，收拾功名竟几时。\n穹昊不言难遽问，性情无奈祇吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初秋晓起","author":"彭汝砺","text":"云影冥蒙雨细飘，风传秋意又经宵。\n苍溪岸侧千峰翠，高树枝头一叶凋。\n病久亦伤光景速，起来尤爱暑威销。\n徐徐步向亭中立，逸兴飘浮酒气骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中作","author":"彭汝砺","text":"晓日新晴三月天，征途令我一悽然。\n谋身独愧声名浅，得地安辞道里千。\n匹马荒山嗟困矣，扁舟浊水喜安然。\n桐庐虽远今伊迩，魂梦先归绛帐前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张子直 其一","author":"彭汝砺","text":"常愿从君授古书，血诚沥尽更无馀。\n漂流岂意来深野，系滞无由后从车。\n踪迹浸违南郡帐，梦魂长绕武侯庐。\n仁人有意收庸贱，时寄声音一起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张子直 其二","author":"彭汝砺","text":"性质迂回趣向卑，此身敢望圣门归。\n趋时已愧雕虫陋，学古还忧画虎非。\n材近蓬蒿难自立，目无松柏竟谁依。\n重嗟踪迹匏瓜系，翻羡苍蝇附尾飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子直见和前韵因复之 其一","author":"彭汝砺","text":"平时祇畏才无敌，今日方知器有馀。\n一第已多新宦况，潜思犹入旧田庐。\n凤凰固合栖阿阁，骐骥谁令驾鼓车。\n千里青云今至矣，愿倾深画尽传予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子直见和前韵因复之 其二","author":"彭汝砺","text":"淹延未得共山居，愁积胸肠万斛馀。\n致远自伤无巨翮，临危谁肯借安车。\n油幢金印男儿事，碧水青山隐者庐。\n穷达计谋今已决，故人天际亦思予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈子直","author":"彭汝砺","text":"步入松筠水石间，回眸方觉世途难。\n蒙茸草色萦行径，淩乱花阴覆钓湾。\n暇日还能邀我醉，清时未肯纵君闲。\n烹鲜酌酒且行乐，北圃春容今又残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄献教授友兄","author":"彭汝砺","text":"焦心犹觊就功名，痛惜长为疢疾婴。\n欲起病躯思扁鹊，未知穷命问君平。\n道途辽邈何由及，田壤萧条不复耕。\n好学岂能几亚圣，受经从此愧丘明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千乘先生有草堂之吟而人或讥之因次其韵","author":"彭汝砺","text":"世俗无轻好遁讥，先生岂是爱山扉。\n圣人固重潜龙诫，君子安为即鹿非。\n白水会来朝草径，红尘不敢傍麻衣。\n金舆应有商岩梦，即听东南一诏飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次道济韵","author":"彭汝砺","text":"吾材未及明时用，来傍师门静养蒙。\n多病因知妨力学，潜思犹是觊成功。\n松心并老凝寒后，玉色相看烈火中。\n天意欲令更患难，诗辞何必议穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病居婺女","author":"彭汝砺","text":"荡漾扁舟冒晓征，此身何日得安停。\n穷途敢恨身无托，多病惟思药有灵。\n气谊腹心双古剑，江湖踪迹一浮萍。\n尘埃易使羁容黑，仁义难邀俗眼青。\n乡思浪凭歌笑解，微辞不是楚骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子直友兄秘书","author":"彭汝砺","text":"碧水青山一万寻，不量无力强登临。\n辛勤亦觊功名就，痛惜长为疾患侵。\n憔悴已成今日态，英豪不复旧时心。\n归期未遂家千里，空对秋风泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕与莘老俱宿斋因寄莘老","author":"彭汝砺","text":"零雨其濛春始和，明星有烂夜如何。\n笙篁故与风声远，灯火疑添月色多。\n渐老自能忘世味，欲明更起看天河。\n定留太一青藜照，愿寄荆人白雪歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知常三十一致其政迁通直郎遇郊恩以亲之封封其祖父母以妻之封封其父母其外舅知府龙图安中以诗美之提刑大夫信叔和之俾某属和","author":"彭汝砺","text":"立节秉心诚与俱，至诚少日慕颜徒。\n荣名及祖亲仍与，盛事超今古亦无。\n番国山川元润泽，吴园鱼鸟亦驩虞。\n冰翁星使诗酬唱，在昔尝闻德不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承臬山毅夫提点学士有游会庾楼因用元韵","author":"彭汝砺","text":"拥旃昔过赵州关，剖竹今邻四祖山。\n问法几生成密记，焚香曷月礼慈颜。\n知天稍似三无愠，易地何如五不还。\n邂逅晦堂聊寄意，而今事事祇如闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"按涝","author":"彭汝砺","text":"瘦马扁舟迹已勤，三乡行尽独伤神。\n湖边围涨鱼龙富，野外田乾燕雀贫。\n岂有异能裨此理，试留馀泽遗斯民。\n东南步武丰凶别，却笑天心似未均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄钱穆父","author":"彭汝砺","text":"忠义文章见一门，风流窃喜得诸孙。\n古人事业非无意，天下几微定有言。\n寒斗雪霜松老大，高飞霄汉凤腾轩。\n治功今日俱无补，尘土相看畏素飧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]