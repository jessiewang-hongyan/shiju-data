[{"title":"偶题","author":"俞德邻","text":"身世厌漂零，衣冠愧典刑。\n乾坤开阖户，日月短长亭。\n水阔连天白，山高拥岸青。\n扬雄中有宅，垂老太玄经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"村居即事二首 其一","author":"俞德邻","text":"地僻村深过客稀，数家生聚突烟微。\n鱼虾入网忙呼酒，鹅鸭栖池静掩扉。\n唤妇索绹苫屋角，课儿斫竹补篱围。\n沟东积水通前浦，也有蒲帆带雨归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"村居即事二首 其二","author":"俞德邻","text":"漠漠平畴接远沙，一浜寒水浸梅花。\n儿挑苦芺供鹅食，妻撷葫荽荐客茶。\n榾柮火残寒尚力，茅柴酒熟夜能赊。\n岁时伏腊歌呼处，三世儿孙共一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠良常山人","author":"俞德邻","text":"青岁迂疏厌市廛，诛茅结屋北山巅。\n泉冷阴洞猿分饮，草软阳坡鹿伴眠。\n三径烟云浑是画，四时风月不论钱。\n忽逢野老谈庚甲，笑指乔松不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富安田舍二首 其一","author":"俞德邻","text":"风饕雪虐驾扁舟，又作田家数日留。\n雁逐稻粱飞远浦，犬惊杖屐吠荒丘。\n三杯薄酒延僧话，一盏寒灯伴客愁。\n白水漫漫妨麦事，催钱县吏亦宜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富安田舍二首 其二","author":"俞德邻","text":"漠漠寒云接断芜，平畴积水入长湖。\n犊眠篱下霜埋草，雁宿汀边月满芦。\n戟吻苦茶连叶煮，胶牙酸酒带糟餔。\n数朝已觉人情熟，识字耕田著我无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"田家喜雪","author":"俞德邻","text":"漫空飞雪岁云徂，独坐閒吟粟满肤。\n廓落江山千态迥，浑沦天地一尘无。\n寒声夜吼松筠裂，和气朝回荠麦苏。\n说与田家判一醉，明年宁复虑官租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕二首 其一","author":"俞德邻","text":"十旬为客思凄然，返樛言归又覈田。\n榾柮煨炉销永夜，屠苏浸井迫新年。\n人生半是忙中过，农事偏于隐者便。\n将老菟裘何处卜，九龙泉畔锡山边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕二首 其二","author":"俞德邻","text":"买田阳羡笑东坡，三黜穷荒两鬓皤。\n瘴雾蛮烟添老色，寒灯夜雨强悲歌。\n百年富贵欢悰少，一日清閒乐事多。\n说与故人休大噱，省曹阍者面如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郭元德閒居二首 其一","author":"俞德邻","text":"万事梦中梦，百年身后身。\n黄尘空没马，白发不饶人。\n鲈美莼波净，螯肥菊露新。\n相思须命驾，莫厌子舆贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郭元德閒居二首 其二","author":"俞德邻","text":"弋篡冥鸿远，城荒去鹤还。\n万缘俱是幻，百计不如閒。\n人在羲黄上，时当晋宋间。\n委心乘物化，何地不蓬山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后平叔母夫人挽辞二首 其一","author":"俞德邻","text":"十载干戈四海同，几人徐庶几陈宫。\n阿奴侍母但膝下，潘令弃官归洛中。\n生死总归蝴蝶梦，哀荣何啻马牛风。\n送车千乘谁能致，我亦潸然泪洒空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后平叔母夫人挽辞二首 其二","author":"俞德邻","text":"昔年烽火隔江津，指痛呻吟夜彻晨。\n旁置万家空有冢，禄营三釜已无亲。\n鸾回紫诰承恩旧，牛卧青冈卜兆新。\n送死养生无一憾，老怀缘此重沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯杨少监","author":"俞德邻","text":"白发苍颜自在仙，流行坎止任天然。\n江山得意俓携酒，家世为官不爱钱。\n天与清閒娱晚景，人看富贵出长年。\n传闻尺一来阊阖，匹马春风快着鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨刚中分教京口有司以冗员罢去作诗为别就次韵以饯其行二首 其一","author":"俞德邻","text":"冲霄志气合雄飞，谁遣谈经坐绛帏。\n夜雨檐花聊痛饮，秋风莼菜竟思归。\n一官岂为吾曹冗，五斗政嫌儿辈讥。\n去去草玄从尚白，丈夫元不羡轻肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨刚中分教京口有司以冗员罢去作诗为别就次韵以饯其行二首 其二","author":"俞德邻","text":"公车指日召严徐，友道从渠自耳馀。\n浮世功名蕉覆鹿，冷官滋味釜生鱼。\n百年荏苒醒还醉，一气循环惨复舒。\n归去湖山多乐事，故人休枉绝交书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠程秀才","author":"俞德邻","text":"莎径莓墙枳棘篱，藜床六尺卧书帷。\n门前剥啄谁惊梦，马上推敲客有诗。\n北牖清风聊共语，夜梁落月重相思。\n宾鸿此去过京岘，应遣新吟慰旧知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天竺山","author":"俞德邻","text":"鹫岭旧寻诗，重来十载期。\n蛩吟僧定榻，猿挂鹤栖枝。\n山月穿窗入，溪云傍竹移。\n一声清磬发，应悔出家迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游金山寺次壁间韵","author":"俞德邻","text":"水国微茫境物閒，洪涛九派护禅关。\n帆樯下上淮连浙，楼殿高低寺裹山。\n潮驾金鳌来海上，天留玉府在人间。\n凭阑落日芦风起，时有鱼龙听法还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中偶书","author":"俞德邻","text":"落花流水两无依，梦入桃源觉已非。\n尊酒阑珊山月落，片帆摇曳浦风微。\n云横北固朱楼远，烟暝西湖画舸归。\n别易会难今古恨，鳞鸿来往莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘露寺火后登多景楼故基有作","author":"俞德邻","text":"西风散屧步崔嵬，霁色浮空望眼开。\n江势乱奔沧海去，天形低约众山回。\n一卷狠石埋焦土，百尺危楼付劫灰。\n惟有沙鸥知我意，相亲相近不惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵道","author":"俞德邻","text":"楼头凝望处，落日帝王州。\n下有朝宗水，滔滔日夜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓行沙上","author":"俞德邻","text":"宿雨浥轻尘，沙平草树春。\n远山千万叠，空翠欲沾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客中雨","author":"俞德邻","text":"风雨正潇潇，孤灯伴寂寥。\n关心多少事，一一付芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻春","author":"俞德邻","text":"日日寻春到水涯，今朝篱落见梅花。\n折梅欲问春消息，春在桥南卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日山行","author":"俞德邻","text":"山北山南日几回，半山山舍更传杯。\n一声羌笛山云裂，二月山花有落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚醉","author":"俞德邻","text":"兀兀馀酣漱晚汀，古牺香雾入疏棂。\n捲帘归坐月弦上，隔岸远山青更青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何山白水田","author":"俞德邻","text":"离离远树接山低，白水田头杜宇啼。\n昨夜前村新雨过，桔槔閒在石桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题米友仁远景","author":"俞德邻","text":"蒙蒙树隐山，渺渺波横海。\n其中一叶舟，岂有陶朱在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为石民瞻题风雨溪桥手卷","author":"俞德邻","text":"烟林雨气昏，行客苦迢递。\n谁知渡溪桥，风尘满天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访徐叔咏教授山庵迷道而作","author":"俞德邻","text":"上山下山山历历，松篁不改路非昔。\n杖藜聊欲问山翁，山空叶落无行迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"到徐叔咏居","author":"俞德邻","text":"攀藤蹑石访幽客，茆屋参差松树隔。\n山童闻语不应门，古木千章鸣格磔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周遗直京城苦雨五首 其一","author":"俞德邻","text":"天地黯黪云气繁，淤泥没胫蜗书门。\n长安米升钱五百，忍饥茹芝谁绮园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周遗直京城苦雨五首 其二","author":"俞德邻","text":"浊醪梨枣亦易求，鸡鸣檐溜还交流。\n亲宾纵谈天下乐，藜杖谁肯过苏侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周遗直京城苦雨五首 其三","author":"俞德邻","text":"古今浩浩多诗流，清辞丽句谁能高。\n大历饥寒少陵杜，义熙归去彭泽陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周遗直京城苦雨五首 其四","author":"俞德邻","text":"半年京国囊无储，饭我豆粥羹寒蔬。\n翻江黑雨弥两月，却忆溪翁留白鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周遗直京城苦雨五首 其五","author":"俞德邻","text":"云壑布衣贤亦愚，玉阶紫衣妾亦夫。\n书三十乘须饱读，鹏九万里从南图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六言","author":"俞德邻","text":"贪夫寻梦穴蚁，可人閒爱沙鸥。\n一生能消几屐，十年浪走三州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题瘦马图","author":"俞德邻","text":"一十五条瘦肋，八千万里脩程。\n春草明年又绿，朝趋夜秣幽并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为徐彦昌题画扇","author":"俞德邻","text":"峭壁倚层霄，长松荫幽壑。\n荒径一樵归，平沙群雁落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为陈登父题画扇","author":"俞德邻","text":"古涧横小桥，竟日无人渡。\n红尘隘九衢，来往不知数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题兰亭图","author":"俞德邻","text":"昔上会稽探禹穴，曾留此地听潺湲。\n茂林脩竹今何在，叹息三原坱莽间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题王吉甫居壁二首 其一","author":"俞德邻","text":"晓出西关访直溪，西风掠地草萋萋。\n低迷岐路无人问，邢坞转东东转西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏题王吉甫居壁二首 其二","author":"俞德邻","text":"没马黄尘倦入城，杖藜聊复畅幽情。\n却嫌村近山林远，一望三茅与四平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游鹤林即席分韵代率上人赋日字","author":"俞德邻","text":"松声度暖风，花气薰迟日。\n乘兴问三三，何劳邀七七。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广信道中留别故人二首 其一","author":"俞德邻","text":"疏疏杨柳拂平沙，白鹭缡褷立水涯。\n徙倚阑干吟未稳，澹云笼月落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广信道中留别故人二首 其二","author":"俞德邻","text":"天涯沦落偶相逢，路转灵溪事又空。\n从此万山并万水，暮云飞处望江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题明皇卧吹箫图二首 其一","author":"俞德邻","text":"羯鼓催花事已奇，一枝媚玉卧犹吹。\n何如端拱岩廊上，九奏箫韶付一夔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题明皇卧吹箫图二首 其二","author":"俞德邻","text":"吹断箫声禁漏迟，华胥一枕梦醒时。\n梨花院落沉沉静，更有人偷玉笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣怀六言四首 其一","author":"俞德邻","text":"巧语屡遭薏苡，丽辞空赋梅花。\n岁晚菟裘可筑，不妨痼疾烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣怀六言四首 其二","author":"俞德邻","text":"涉世性多物忤，畏人分合幽栖。\n通德能谈飞燕，儿曹从厌家鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣怀六言四首 其三","author":"俞德邻","text":"元龙高卧楼上，孔明抱膝隆中。\n天下士忧天下，此时此意谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居遣怀六言四首 其四","author":"俞德邻","text":"贺毅刺舌诫口，郭舒掐鼻灸眉。\n对客瞪视不答，士廉已悟无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过高邮新开湖","author":"俞德邻","text":"新湖渺渺接张沟，露冷菰丛一雁秋。\n十幅蒲帆风力饱，回头烟雨暗文游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮阴侯庙三首 其一","author":"俞德邻","text":"鹿走沙丘二世亡，重瞳隆准正奔忙。\n将军果是无双士，何用区区觅假王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮阴侯庙三首 其二","author":"俞德邻","text":"兔死从来狗亦烹，楚亡安得有韩彭。\n封留便约赤松去，已愧当年鲁两生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮阴侯庙三首 其三","author":"俞德邻","text":"诛秦蹙项奠乾坤，三杰勋名万古存。\n一笑淮阴年少客，不如漂母识王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漂母墓二首 其一","author":"俞德邻","text":"露冷芦洲楚水平，荒坟三尺近甘城。\n当年不进王孙饭，千古谁知漂母名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漂母墓二首 其二","author":"俞德邻","text":"裤下包羞气未伸，寄身亭长更遭嗔。\n不图他日千金报，漂母应非世俗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮安天庆观夜坐","author":"俞德邻","text":"边城寂寞岁将阑，浊酒频斟醉不欢。\n一点青灯霜月白，野凫风起石窗寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事二首 其一","author":"俞德邻","text":"一朝天险失长江，肉食诸公竞卖降。\n受禅碑中无姓字，祇今谁忆鹿门庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事二首 其二","author":"俞德邻","text":"投阁先生著剧秦，陇西降将欲全身。\n沙场无万沈冤骨，却是周嫠与杞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花三首 其一","author":"俞德邻","text":"蝶隐蜂藏寂众芳，一枝寥落小溪傍。\n林逋仙去无知己，明月清风自主张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花三首 其二","author":"俞德邻","text":"洗尽铅华见玉肌，可人风味半开时。\n胆瓶谁汲寒溪水，带月和烟簪一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花三首 其三","author":"俞德邻","text":"沙岸萦回一水通，补陀仙子静相逢。\n缟衣不染人间色，寂寞清香度晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"扬州天庆观作","author":"俞德邻","text":"日转梧桐影密，月明杨柳阴疏。\n经阁磬声??，闯然风马云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其一","author":"俞德邻","text":"十年南国足风埃，锦绣湖山得再来。\n醉里不知人世改，更从云气望蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其二","author":"俞德邻","text":"襄城七圣云迷泽，槐里三原草合烟。\n今古兴亡元有数，福华当日为谁编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其三","author":"俞德邻","text":"万户千门达曙开，管弦啁哳沸楼台。\n祇今明庆钟声动，已报巡灯响铎来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其四","author":"俞德邻","text":"杖藜乘兴不辞遥，行尽苏堤过断桥。\n白发老翁依古柳，相逢挥泪说前朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其五","author":"俞德邻","text":"水秀山明仙佛国，天开地辟帝王家。\n欲穷胜赏人非昔，独立西风夕照斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其六","author":"俞德邻","text":"衮绣三朝迈等伦，曾将双美绘麒麟。\n当年早共赤松去，未必清漳见逐臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸未游杭作口号十首因事怀旧杂以俚语不复诠择 其七","author":"俞德邻","text":"黄门飞鞚赐厨珍，翠舞珠歌度十春。\n今日败垣荒草合，近前那复相君嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]