[{"title":"即席二首 其一","author":"周紫芝","text":"凋尽朱颜年少春，不堪柳下对离樽。\n刘郎已是无肠断，更唱阳关恼客魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即席二首 其二","author":"周紫芝","text":"旧家明月醉归时，夜静朱楼歌折枝。\n只有杜娘真好事，樽前犹唱后山词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将归白湖而雨","author":"周紫芝","text":"世间那得此间身，恐是前生贺季真。\n白水窗闲频入梦，黄梅雨细却留人。\n重听欸乃烟中曲，净扫离骚几上尘。\n但得南风送归棹，未应幽独解伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中元日雨中录所见","author":"周紫芝","text":"颠风急来万木萎，迅雷不听人掩耳。\n南山栖鸟失故巢，北山翔龙卷湖水。\n翔龙掉尾不肯收，眼看沧波接云起。\n想当舟楫避惊涛，无数鱼虾趁龙尾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读张载扬所示近诗颇怀其人","author":"周紫芝","text":"眼中人物欠曹刘，老矣逢君接胜游。\n诗与漫郎推行辈，字从坡老得源流。\n羸骖又踏千山去，黄菊空催九日愁。\n横槊想多秋后句，诗成须着锦囊收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲照秋怀四绝 其一","author":"周紫芝","text":"日斜楼阁暮云中，黄菊红蕖满院风。\n酒熟未酬花烂熳，诗来时听玉丁东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲照秋怀四绝 其二","author":"周紫芝","text":"老去篇章谁与酬，秋来又喜与君游。\n遗音固自成三叹，妙语不应惭四愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲照秋怀四绝 其三","author":"周紫芝","text":"白发新愁满眼中，骚人零落怨秋风。\n年来诗思成何事，聊伴寒螀泣露丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲照秋怀四绝 其四","author":"周紫芝","text":"秋在幽人行乐中，好山欲尽更须穷。\n花姑水绕几时到，罨画溪遥路欲通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋雨连日","author":"周紫芝","text":"老鬓风吹急，愁云带雨飞。\n白添平岸水，红掩傍幽扉。\n力尽方谋食，天寒未授衣。\n此身惭社燕，秋晚亦能归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵罗仲共教授闲居三首 其一","author":"周紫芝","text":"为米要令陶令出，无毡今坐广文穷。\n悬知嚼蜡世味薄，未抵扑衣山色浓。\n大盖且从渠自拥，小槽当与客频中。\n家谈安得从三老，华萼同编是古风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵罗仲共教授闲居三首 其二","author":"周紫芝","text":"了事痴儿不到诗，间中鼓吹自应奇。\n莫教句法惊人甚，便恐功名入手迟。\n性癖雅宜嵇叔懒，官闲只有漫郎知。\n庭梧想得西风急，秋意微生楚些悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵罗仲共教授闲居三首 其三","author":"周紫芝","text":"拟筑扬雄宅一区，碧鸡坊外且成居。\n湖江君尚作浮宅，风雨我当无敝庐。\n平日梦游嗟路远，新凉见面恰秋馀。\n便须载酒相从去，要识平生未见书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白湖闻雁三首 其一","author":"周紫芝","text":"斗落参横天雨霜，梦残灯尽客思乡。\n丁宁莫作叫云去，老眼不禁秋夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白湖闻雁三首 其二","author":"周紫芝","text":"晚向濒湖寄一椽，只凭沙雁与周旋。\n北来南去莫惆怅，我亦飘零那记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白湖闻雁三首 其三","author":"周紫芝","text":"华人流落几秋风，南望中原信不通。\n好寄书来苏属国，君王方射上林中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日风雨终日用怀载扬韵","author":"周紫芝","text":"九日清尊强挽秋，满庭风雨复谁游。\n俗人言下无三语，此老胸中有九流。\n白发不妨欺短帽，黄花应解笑痴愁。\n客情老去何曾好，双鲤书来几日收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日不出","author":"周紫芝","text":"白发谁怜我，黄花最忆渠。\n酒杯今日把，筋力去年殊。\n身远秋如梦，谋疏老更愚。\n客愁浇不下，强欲醉茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桥成","author":"周紫芝","text":"尚忆防秋日，疏渠转曲城。\n万方知盗息，此地看桥成。\n拄杖知频过，游鱼莫漫惊。\n明朝趁虚去，画柱晓霜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪夜","author":"周紫芝","text":"病眼怕遥夜，宿炉依小温。\n酒醨嫌雪厚，书细苦灯昏。\n残腊归时梦，他乡尽处村。\n可怜双白鬓，深闭一蓬门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读蔡中郎传","author":"周紫芝","text":"人生无先知，颇欲邀后福。\n自言苟依违，安得有颠覆。\n伯喈英伟资，高义甚敦笃。\n不为左回天，辄作流水曲。\n立朝有公言，谁能保家族。\n朝奏皂囊封，暮就洛阳狱。\n晚节不自守，一跌变前躅。\n起依千里草，九徙如转轴。\n卓死固已久，安得复嚬蹙。\n琴中知杀气，此理反未烛。\n陋哉王司徒，避谤私欲戮。\n公忠信安在，志操等流俗。\n何能起颓纲，此辈真碌碌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"责鸡","author":"周紫芝","text":"豢犬欲司夜，畜鸡要鸣晨。\n二物一失职，遂辜畜养恩。\n嗟我笼中鸡，芥羽光照人。\n峨冠事饮啄，缄口随晨昏。\n我怒欲尔烹，鸡笑复自陈。\n君看多言者，以忠获怒嗔。\n台评与幕辨，呶呶常杀身。\n幸此北窗卧，颇似羲皇民。\n五起笑朝士，三号惊梦魂。\n使子卧红日，谢客扃柴门。\n此意殊不恶，诮我无谆谆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客舍二首 其一","author":"周紫芝","text":"日日湖边路，频来我不嗔。\n故山无百里，客舍遂三春。\n红落含桃过，青垂小杏新。\n光阴花委地，飘泊燕依人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客舍二首 其二","author":"周紫芝","text":"畴昔江湖意，儿曹总不知。\n幅巾沾雨过，拄杖看云移。\n凤子飞应远，莺儿语最迟。\n闲从梅雪后，直到麦秋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张颠东归","author":"周紫芝","text":"张颠佳处是清高，不但诗狂酒亦豪。\n自说平生耽翰墨，未尝名讳落官曹。\n书工耻作云间榜，画好能添颊上毛。\n早信人间苦荆棘，不嫌门外长蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"薄暮二首 其一","author":"周紫芝","text":"物外无馀子，愁边有是翁。\n梦回惊日脚，雨罢看云峰。\n天与长闲处，湖供不断风。\n犹嫌太多事，身落乱书丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"薄暮二首 其二","author":"周紫芝","text":"睡熟不知雨，梦残无限凉。\n莺飞时到眼，鹭起不成行。\n瓜熟分苍玉，莲香擘翠房。\n扫门还待月，近水更移床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静夜二首 其一","author":"周紫芝","text":"家与重湖近，门当永夜开。\n鹭随波浩荡，人共月徘徊。\n晓色催星落，飞云带雨来。\n长须汲水去，小艇淂鱼回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静夜二首 其二","author":"周紫芝","text":"湖影入散发，晚沙横断汀。\n冠攲从自落，门设未尝扃。\n鬼着林边火，萤翻水上星。\n时闻有船过，月黑夜冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨晴望青山","author":"周紫芝","text":"世间尤物如异人，青山不入诸山群。\n晚来浓翠欲成滴，雨后数鬟高切云。\n人言兹山下埋玉，太白祠扉落岩谷。\n至今樵牧无斧斤，馀润油然归草木。\n往岁小生来酹公，秋山未霜叶尚绿。\n是时落日在屋梁，彷佛如照公眉目。\n今我不乐湖水滨，青山到眼无朝昏。\n更欲再拜望拱木，公已乘鸾上天门。\n帝乡渺渺不知处，谁能为我招清魂。\n死生夜旦何足道，不敢复作湘累文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仆去岁作湖居十二诗向开叔有诗次韵乃为谢","author":"周紫芝","text":"三年湖雨一茅茨，坐遣幽人识面迟。\n遗恨忽从愁里尽，交情先向句中知。\n重寻故里空劳梦，亟买归舟会有期。\n何日剧谈听亹亹，满倾春酒细论诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得木犀","author":"周紫芝","text":"三年身在菰蒲里，手把岩花意惘然。\n折得秋芳香满袖，梦魂常绕故山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜苦秋蚊达旦不寐","author":"周紫芝","text":"昔年记淮邦，茅庐蔚秋草。\n两耳无晨昏，秋蚊困飞绕。\n利吻极惨伤，群飞固轻矫。\n悬知孀女祠，未可较多少。\n至今梦中雷，客枕疑已晓。\n那知三家村，复此终夕挠。\n青烟郁蒿艾，横空益奔扰。\n手倦劳扑缘，眼病恶薰燎。\n谁言天宇大，微物吝除剿。\n何必养嘉羞，便可付丹鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归自白湖舟中作","author":"周紫芝","text":"客舍三寒暑，扁舟八往还。\n残年不如意，老色日凋颜。\n暗谷鸣珊佩，晴峦结翠鬟。\n江禽浑识面，似欲唤人闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄家龙溪寺小阁初成","author":"周紫芝","text":"三年波浸白湖门，佛屋新分水北村。\n窗可近书真窈窕，室才容榻颇深温。\n妻孥共社同香火，鱼鼓催人作晓昏。\n雪颔已疏怜我老，云踪无定与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雷飞卿送其女兄南归","author":"周紫芝","text":"兰皋飞佩一凄然，别酒深倾玉满船。\n谁唤孤帆落天际，尽驱秋色到愁边。\n燎须心在人能说，拟絮才高墨未乾。\n莫向南湖频着眼，断鸿疏影在云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈季陵阅猥藁见寄","author":"周紫芝","text":"相思一日九回肠，多谢来书细作行。\n镜里有霜怜我老，鼎中无脔付君尝。\n衰颜本自羞连璧，佳句仍惊得夜光。\n五凤楼高无此手，曹刘真是及肩墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵文殊老人题宝顶寺","author":"周紫芝","text":"门连弱水不可渡，山似妙高知几寻。\n得雨僧分香积饭，行檀人施袅蹄金。\n重新佛屋龙天喜，已退魔军岁月深。\n老去愿随君共隐，谁能拥膝更长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨次公侍讲得古印于洪井其文云东海开国次翁之子德润以赠徐伯远伯远有诗次韵","author":"周紫芝","text":"王谢风流本自长，天教洪井发珍藏。\n定知东海新金斗，可继文安旧印章。\n龟去岂无江上恋，鹊来今得石中黄。\n传家已作他年兆，莫把功名付锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雷飞卿游山时余以病不往","author":"周紫芝","text":"一病能令百念阑，霜蓬零乱照衰颜。\n心知只可开三径，炙手何劳叩八关。\n老喜社中多臭味，梦思方外有跻攀。\n劝君莫放寻山屐，嬴取浮生半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡陂南用斜川韵","author":"周紫芝","text":"万物自有得，吾生感行休。\n及兹天气佳，步寻水南游。\n青板得野航，竟渡一苇流。\n乘流本无心，岂有不下鸥。\n开口月有几，百年终一邱。\n与世似异趋，此行谁我俦。\n村醪亦足醉，对影自献酬。\n未知垂老日，能遂此乐不。\n事定会当谐，不复怀预忧。\n但愿营自安，孰是都无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归陂北用斜川韵","author":"周紫芝","text":"薄游不尽兴，归卧当少休。\n曲水虽陈迹，斜川有新游。\n浩歌独长往，岂亦惭此流。\n侨寓三家村，飘如浮水鸥。\n屡争渔樵席，共守狐鼠邱。\n削迹屏冠服，索居谢朋俦。\n樽中有馀滴，子献复父酬。\n殷勤问稚子，汝复乐此不。\n稚子掉头笑，老夫豁深忧。\n但令常复尔，过是吾何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中次韵飞卿赠别长句","author":"周紫芝","text":"早岁从田叹不逢，老随乘雁听西东。\n青山约在何时了，白发欢成一笑空。\n昨夜清歌催别酒，只今寒月上孤蓬。\n相逢莫怪长相忆，举世交游无此风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后望文脊诸峰哦韦苏州门对寒流雪满山之句得两诗 其一","author":"周紫芝","text":"雪压寒林春未回，晚山犹带玉崔嵬。\n谁将旧日韦郎句，貌取郭熙平远来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后望文脊诸峰哦韦苏州门对寒流雪满山之句得两诗 其二","author":"周紫芝","text":"新来袅袅娉娉雪，犹在重重叠叠山。\n莫作故时峰岭看，玉京今不是人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送方元相宰钱塘","author":"周紫芝","text":"云路飞腾合到君，不应犹现宰官身。\n未分东观消长日，聊为西湖作主人。\n天近得声知亦易，民饥当念可须嗔。\n簿书丛里江山在，了事何妨得句频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向开叔借陈公诗卷以诗奉寄且易乙藁 其一","author":"周紫芝","text":"谁言静寄是穷儿，尽得陈公晚岁诗。\n一读便醒双泪眼，头风更拟倩谁医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"向开叔借陈公诗卷以诗奉寄且易乙藁 其二","author":"周紫芝","text":"平生不识陈惊坐，传得新诗喜失床。\n闻道明珠犹满眼，烦君为我一倾囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟过道场山下将往游舟师告以雪涂不可行而止","author":"周紫芝","text":"风蒲饱朝航，霁色急新涨。\n云山绕平湖，水墨澹屏障。\n夷犹柂初回，突兀山入望。\n何妨倾寸眸，便足了千嶂。\n想像钟磬音，隐约霄汉上。\n我欲一往游，遐瞻兹可畅。\n暮雪犹在涂，遗事不得访。\n人生蜡屐缘，一世能几两。\n登山追胜游，脚力须少壮。\n重来定何时，吾策今可杖。\n老愿复尔违，抚事一惆怅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老日","author":"周紫芝","text":"老日那容惜，晴光到眼休。\n蚕知今日浴，麦复几时收。\n黄犊分青草，花凫趁绿沟。\n谁能更归得，已是一春留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西湖山下梅花坞行可里许至陈御史园亭","author":"周紫芝","text":"倦客厌卑栖，白日坐飘忽。\n呼我同舍郎，缓策扶勃窣。\n缘山得人家，附影蔽深樾。\n湖水一镜明，梅花千树发。\n扶疏弄清影，仿佛见罗袜。\n凄迷香雾中，身已在月窟。\n穷探意未已，取径无诘屈。\n谁家歌舞园，花乱竹复密。\n御史投绂馀，课竖种梨栗。\n吾曹不解事，尚此学操瑟。\n当从汉阴人，抱瓮日搰搰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食前五日作二绝 其一","author":"周紫芝","text":"杜鹃新听晓来声，暖气催花一夜成。\n寒食只今无几日，故乡何处不关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月二十二日春雨终日","author":"周紫芝","text":"此情谁与问天公，幽事全归白发翁。\n袖手寻诗红烛里，卷帘听雨绿阴中。\n杯盘眼见樱桃熟，时节心惊柳絮空。\n谁为羁栖到三月，还家犹及舞雩风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬德庄见和","author":"周紫芝","text":"横飞衮衮见诸公，着眼何由到此翁。\n胡粤相忘千里外，金兰投分一言中。\n诗缘渐熟情难洗，老色来煎念已空。\n销尽客愁知底事，爱君回雪与流风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酌六一泉颇怀昔游","author":"周紫芝","text":"孤山屹中流，长堤转湖尾。\n泯然怀昔游，踊跃尚壮齿。\n道人引清甘，一掬托分似。\n重来固依然，岁月今有几。\n华堂失雄观，缺甃久未理。\n谁令走蛙黾，投笔便如鬼。\n龙宫空一炬，狗盗忽四起。\n佳处不负人，环山自湖水。\n并游适相契，况我二三子。\n少留当何之，再来吾老矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄文若携秦别驾侍儿像见过戏题二绝 其一","author":"周紫芝","text":"能事空传王右丞，句如徐庾转难名。\n明眸正似溪光样，自古无人画得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄文若携秦别驾侍儿像见过戏题二绝 其二","author":"周紫芝","text":"谢家林下小梅花，不着红蓝染绛纱。\n莫笑画师无国手，玉肌元不受铅华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄文若春日山行过秦德久六首 其一","author":"周紫芝","text":"百金聊作杖头沽，旋剪春苗荐野蔬。\n便可且倾陶令酒，未须真忆季鹰鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄文若春日山行过秦德久六首 其二","author":"周紫芝","text":"眼前风物一番新，江上桃花恼杀人。\n可笑草玄窗下客，满庭吹絮不知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄文若春日山行过秦德久六首 其三","author":"周紫芝","text":"阶前春草唤愁生，屋上鸣鸠报晚晴。\n忽有好诗来照眼，似逃空谷听人声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄文若春日山行过秦德久六首 其四","author":"周紫芝","text":"不作林间曳履行，老来春日总无情。\n还惊柳上风催燕，又见花边雨弄晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄文若春日山行过秦德久六首 其五","author":"周紫芝","text":"樱桃花下小窗扉，闻说婵娟是柳枝。\n茗椀已烦罗袖捧，篆香仍借好风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄文若春日山行过秦德久六首 其六","author":"周紫芝","text":"鸟啼花发未春阑，日饮无何意自闲。\n更唤小蛮娱醉客，主人风味似香山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追和向苏州罢吴门作","author":"周紫芝","text":"幕北传烽飞夕埃，庙堂今日要真才。\n肯将身向急流退，要问客从何处来。\n宝墨光翻银汉落，画船恩重锦帆开。\n胸中丘壑公元有，便恐鸱夷挽不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]