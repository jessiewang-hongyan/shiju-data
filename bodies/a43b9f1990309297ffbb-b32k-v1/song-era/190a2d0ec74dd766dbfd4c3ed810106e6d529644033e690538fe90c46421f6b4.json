6858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其六","author":"陆游","text":"杜鹃血尽啼未歇，蝴蝶梦残心更狂。\n我自人间少情者，老来十倍惜年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其四","author":"陆游","text":"买得新船疾似飞，蚕饥遥望采桑归。\n越罗蜀锦吾何用，且备豳人卒岁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其一","author":"陆游","text":"纷纷红紫已成尘，布谷声中夏令新。\n夹路桑麻行不尽，始知身是太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其三","author":"陆游","text":"稻未分秧麦已秋，豚蹄不用祝瓯窭。\n老翁七十犹彊健，没膝春泥夜叱牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其九","author":"陆游","text":"渺渺荒陂古埭东，柳姑小庙柳阴中。\n放翁老惫扶藜杖，也逐乡人祷岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其五","author":"陆游","text":"槐柳成阴雨洗尘，樱桃乳酪并尝新。\n古来江左多佳句，夏浅胜春最可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其八","author":"陆游","text":"隋家古寺郡西南，寺废残僧只二三。\n藜藿满庭尘闇佛，时闻铙鼓赛春蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其二","author":"陆游","text":"剪韭腌齑粟作浆，新炊麦饭满村香。\n先生醉后骑黄犊，北陌东阡看戏场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏十首 其十","author":"陆游","text":"老翁卖卜古城隅，兼写宜蚕保麦符。\n日日得钱惟买酒，不愁醉倒有儿扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书叹","author":"陆游","text":"历尽危涂井与参，鬓毛饱受雪霜侵。\n平生不可俗子眼，后世谁知吾辈心。\n河洛方行胡正朔，山林虚度醉光阴。\n浩歌未阕先投枕，衰病常忧感慨深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别严和之二首 其一","author":"陆游","text":"器之魂逝已难招，尚有和之慰寂寥。\n今夜月明空叹息，想君孤棹泊溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别严和之二首 其二","author":"陆游","text":"千里风烟行路难，旅舟应过子陵滩。\n人间富贵知何物，莫负君家旧钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别建安三首 其一","author":"陆游","text":"三十年来云水僧，常挑钵袋系行縢。\n信缘不作痴巢窟，即是吾家无尽灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别建安三首 其二","author":"陆游","text":"楚泽吴山已惯行，武夷从昔但闻名。\n北岩小寺长汀驿，且喜游山第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别建安三首 其三","author":"陆游","text":"攲帽扬鞭晚出城，驿亭灯火向人明。\n多情叶上萧萧雨，更把新凉送客行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陆游","text":"组绣纷纷衒女工，诗家于此欲途穷。\n语君白日飞升法，正在焚香听雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其二","author":"陆游","text":"鸿冥固自辞矰缴，樗散犹能谢斧斤。\n况是溪山幽绝地，有人高卧百重云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其一","author":"陆游","text":"翁自析薪儿负薪，一生不似此年贫。\n折除却得常强健，天定方知果胜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其五","author":"陆游","text":"鱼鳅群出天将雨，蛙黾争鸣草满庭。\n莫道归休便无事，时时袯襫伴园丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其一","author":"陆游","text":"老来百事似婴儿，美睡甘餐只自知。\n陋屋略如营窟世，淳风不减结绳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其四","author":"陆游","text":"有人叩户皆吾友，得屋施床即我家。\n缓步东西行饭耳，元非看竹探梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其六","author":"陆游","text":"幽鸟飞鸣翠木阴，小鱼游泳绿波心。\n满前好句无人领，堪笑寒窗费苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其二","author":"陆游","text":"草衣木食更何求，穴处巢居过即休。\n尚恨未能全省事，一竿风月钓沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事六首 其五","author":"陆游","text":"了事如何省事奇，无心始觉有心痴。\n三更急雨打窗破，正是拥炉危坐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其八","author":"陆游","text":"幽鸟呼人出睡乡，层层露叶漏朝阳。\n临池只欲消残醉，无奈鹅儿似酒黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其七","author":"陆游","text":"小阁凭栏望远空，天河横贯斗牛中。\n他年鼓角榆关路，马上遥看与此同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其四","author":"陆游","text":"生来骨相本酸寒，天遣沙头把钓竿。\n但称山人擪耳帽，敢希楚客切云冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事八首 其三","author":"陆游","text":"烟雨凄迷晚不收，疏帘曲几寄悠悠。\n一双蛱蝶来何许，点尽青青百草头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]