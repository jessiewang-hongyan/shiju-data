[{"title":"豆花","author":"董嗣杲","text":"西风篱落草虫鸣，唤起书生啜菽心。\n雨瓣霏霏成晚荚，霞英蔼蔼烁秋阴。\n三年得谪非无乐，七步燃茸谩有吟。\n请看种分红白色，南山山下此苗深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎春花","author":"董嗣杲","text":"破寒乘暖迓东皇，簇定刚条烂熳黄。\n野艳飘摇金雀嫩，露丛勾引蜜蜂狂。\n万千花事从头起，九十韶光有底忙。\n岁岁阳和先占取，等閒排日趱群芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近苦多故坐病乏药","author":"董嗣杲","text":"江郊雪冱莫知津，客泪双垂怅此身。\n魔障在前无妄想，饥寒随处肯言贫。\n畏途日有风波恐，病骨时需药石频。\n屏息支吾心已扰，眼前谋绝故乡亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈石泉送诗走笔次韵","author":"董嗣杲","text":"依刘殊乏仲宣才，方重相逢笑口开。\n恶况败人佳思尽，寓公贻我好诗来。\n夜寒归梦迷松菊，灰冷尘踪混草莱。\n别后莫裁驰恋意，寄梅须带雪枝苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈朝柏","author":"董嗣杲","text":"枯株独寿忆双栖，谁想天嘉蓊郁时。\n坡老诗成无继笔，阜陵书此有遗碑。\n日摇槎影龙蛇断，雪缀花痕鸟雀疑。\n化日可期人莫讶，柏堂不复辨荒基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸡冠花","author":"董嗣杲","text":"晴芳掩映宋窗曛，丑瓣攒鳞斗野云。\n艳挺双头谁立异，名侪五德自为群。\n丹裳浥露承秋重，赤帻临风唱晓分。\n函谷关前如有此，不鸣惟恐误田文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麦花","author":"董嗣杲","text":"轻花细细复猗猗，何止青荧秀两枝。\n万顷雪光抽夏日，一天翠浪弄秋时。\n暖风覆野看摇燕，晨气笼晴想韵鹂。\n有实可祈催食麨，昼长村疃不攒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"参寥泉","author":"董嗣杲","text":"湖曲春风正禁烟，试茶味此石间泉。\n坡仙忽忆黄州梦，潜老初拈智果禅。\n几客醉游三月里，一联诗兆七年前。\n题梁妙墨如新染，合与云崖浅井传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周孚与高伯庸同游王氏庵归而闾丘仲诗至因次韵贻显庵主以纪一时事 其一","author":"董嗣杲","text":"寂寞城西寺，重来已素秋。\n未霜芳草合，欲雨暮云稠。\n浊酒羸方戒，新诗困复休。\n翻然会心处，烟径有归牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周孚与高伯庸同游王氏庵归而闾丘仲诗至因次韵贻显庵主以纪一时事 其二","author":"董嗣杲","text":"法水堪湔垢，僧庐自辟尘。\n饭炊云子熟，茶泛乳花匀。\n草草情何厚，匆匆迹易陈。\n他年辋川上，为画两纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呼猿洞","author":"董嗣杲","text":"小隐灵山莫计年，此猿清啸洞门前。\n当时不有胡僧唤，今日应无野迹传。\n寒挂枯条申右臂，晚藏碧树忆西天。\n云岩烟谷多遗种，月下三声醒客眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和楼恪斋自述","author":"董嗣杲","text":"碧树前林合，黄云百里迷。\n月高溪水定，风逆漏签低。\n列宿来花邑，凉秋入菊畦。\n比闾回善誉，招得颂声齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和靖先生墓","author":"董嗣杲","text":"诏旨天颁起卧龙，首丘甘老水云东。\n一联香影孤山月，两架茅茨万古风。\n有鹤有童家事足，无妻无子世缘空。\n清标卓绝何人继，表表仙宫垄树中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和翟建大见寄","author":"董嗣杲","text":"乡人谊槩如公少，彭泽辞归过永兴。\n合向校雠争地步，屈于监当负声称。\n故家吴苑频回首，新治淮山任曲肱。\n见说冱寒移足懒，只凭红粉胜扶藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"董嗣杲","text":"西原阴接树，东浦暝沉篱。\n月落溪沙走，星飞岸柳移。\n鲜萤萦浅草，幽鸟择深枝。\n背水中宵坐，愁多病莫支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山","author":"董嗣杲","text":"缥缈蓬莱拥翠寒，百年营取屋千间。\n黄庭殿矗烟霞老，瀛屿堂幽日月閒。\n水泛花阴藏辇路，墙分柳色护仙关。\n林家梅冢陈家柏，万古流芳镇此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山路","author":"董嗣杲","text":"翠微四绝载蓬瀛，柳引游人入画屏。\n诗借乐天传得久，山因和靖隐来灵。\n半空梁驾桥阑赤，一道腰分草界青。\n妆点风光如此盛，藕花香里又三亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"官舟上富池二首 其二","author":"董嗣杲","text":"荒舟可隘守，难供渺茫泛。\n忽罹风水高，愁睹帆脚蘸。\n凉薄有身纪，平白虑此陷。\n闻说所侨地，昼夜演空梵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"官舟上富池二首 其一","author":"董嗣杲","text":"富池溯流上，险在登官船。\n浮动不堪伏，薄命危丝悬。\n枫叶舞片轻，芦花袅漪鲜。\n晚景自可写，肯想涛头颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"官舍病中","author":"董嗣杲","text":"古剑秋埋匣，昏钟冷压楼。\n吟情临晚锐，归计待春谋。\n鸡绕村墟捕，鱼空薮泽收。\n敛将筋骨悴，所恃有新篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝相花","author":"董嗣杲","text":"谁趱珍芳态度呈，风香露色谩敷荣。\n纵矜百媚留春色，难压群花殿晚名。\n暗绿园林黄鸟静，嫣红篱落粉机明。\n禁持光景无多日，冶艳随飘逐雨晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳园醉宿二首 其二","author":"董嗣杲","text":"名园独步欲谁群，午醉醒时坐夕曛。\n暝色移花侵几暗，野香带酒隔窗闻。\n远山翠蓊春初老，落月弦消夜已分。\n杜宇苦催濡滞客，晓愁相并落归云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳园醉宿二首 其一","author":"董嗣杲","text":"荼蘼叶暗石床平，醉倚池台午影清。\n洗酌更尝桑落味，推窗忍听栗留声。\n能仁寺里塔孤立，见易园中人独行。\n此地酬春谁得共，东方月上酒船横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳鄂王墓","author":"董嗣杲","text":"将军魂梦绕旌旃，偃月谋成尚忍言。\n一旦风波谁左袒，八陵荆棘自中原。\n更无雁带边头信，惟有天知地下冤。\n郁郁栖霞霞外树，墓门不掩雀巢喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠勇庙","author":"董嗣杲","text":"才接军符便起程，此行要并铁山名。\n孤忠解得孤城急，一勇判来一死轻。\n堂屋依湖空柳色，庙门当路枕松声。\n丈夫对著褒荣典，誓挽天河洗甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抵北新桥","author":"董嗣杲","text":"指出飞梁是北新，羁怀冰释返吾真。\n归逢乡井心才稳，羞对湖山迹已陈。\n彻钥要芟三径草，怀人空睨一汀蘋。\n满头残发凝霜腻，达旦梳云却爱频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拙寄","author":"董嗣杲","text":"岑寂风烟异，荒寒梦寐危。\n择交贫可久，为吏拙难医。\n大阃粮艘上，孤营竹笛悲。\n快沽桑落酒，浇此满怀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杯泉","author":"董嗣杲","text":"古甃澄泓照胆清，画龙壁暗挂瓢轻。\n汲来不疗相如渴，掬处难供太白倾。\n傍屋四围埋石色，侵山一溜走溪声。\n钵盂可揽江湖阔，参取诗禅放眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枇杷花","author":"董嗣杲","text":"种接他枝宿土乾，花开抵得北风寒。\n蛹须负雪疑蜂蛰，毛叶粘霜若猬攒。\n蕤破极冬悬蜡蒂，果收初夏摘金丸。\n冻香便觉饴如蜜，树掩卢村月色宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林檎花","author":"董嗣杲","text":"树枝高坠展霞绡，妆点清明景物饶。\n帖上幸联青李字，花头不似海棠娇。\n英英褪雨新红淡，瓣瓣零风蝶粉绡。\n光景无多成实易，冰奁催荐泛凉桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枨花","author":"董嗣杲","text":"秾芳比似橘花肥，当日曾从细雨移。\n老有绉颜羞晚出，清无柔性结春知。\n雪香四月蜂攒处，风味重阳蟹健时。\n院落彩妆人最巧，搀先茉莉簇凉枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武康邑中刘王庙","author":"董嗣杲","text":"水围聚落蔼藤缠，灵纪金刀祀典专。\n碑语谁非年月误，神功自托道途传。\n三乡捐廪祈多福，百里赍香卜有年。\n争怪野云头上起，村村先欲雨公田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武康姓丁人号生魂神合邑骚动","author":"董嗣杲","text":"世降多淫祀，时荒扇盗区。\n妖丁肆荒诞，结甲走昏愚。\n揭帜营祠庙，椎锣誷市衢。\n大夫清似水，剿绝莫踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊安庆得郭澹溪书","author":"董嗣杲","text":"客檐停坐久，军递接程初。\n狂醉舒城酒，欣将建业书。\n宦游空叹老，吟思未应疏。\n举网谁家子，欢然饷巨鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊庐江县界几遭寇掠","author":"董嗣杲","text":"酒兴那如归兴浓，此行谁信破囊空。\n扁舟小舣庐江外，雨夜深埋虎穴中。\n独客痛心无可说，何人料事偶相同。\n昏时抛过铜陵去，不管长江起北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊李家渡","author":"董嗣杲","text":"雁字书空极劲遒，江流东去不流愁。\n梦归破屋南山下，身落寒沙古渡头。\n雪意已坚狂问酒，风威未厉懒添裘。\n土人识得沧浪客，特地相期剧醉留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊杨港 其一","author":"董嗣杲","text":"蒲帆发处渺回程，杨港渔家晚饭晴。\n日转江空风势紧，水浮树秃雪枝明。\n饥肠恋酒垂涎觅，愁眼供诗就口成。\n天念奚囊向艰涩，故令岁晚迓春行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊杨港 其二","author":"董嗣杲","text":"龙华寺北板桥平，几户淮民结屋成。\n屡向封疆窥版籍，独游淮海陋功名。\n去年过此曾寻胜，今日逢人似隔生。\n怀抱激昂无可制，埋篷心折听江声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊贵池驿","author":"董嗣杲","text":"琴书湓浦担，风雪贵池船。\n问酒临津醉，添衣入驿眠。\n渔翁寒补网，邻女夜调弦。\n何日齐山去，寻僧学说禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊接泥渡","author":"董嗣杲","text":"笑泊虚寒古渡沙，沉晖远衬楚山霞。\n江乡酒薄难支日，客路诗多转忆家。\n金弹耀林悬橘柚，翠绡萦浦泛蒹葭。\n船窗掩定身如石，篱落何人有菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊黄茅潭","author":"董嗣杲","text":"唳雪沧洲雁，嘘云碧浪鲸。\n茅深淮渡远，日落海潮平。\n庙树摇灯影，船风送鼓声。\n劳思于此泊，无地趁春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊雁汊寄主簿","author":"董嗣杲","text":"穷通归造化，踪迹易参商。\n自画新居样，谁传旧稿香。\n寒沙埋虎坂，晚烧起龙冈。\n相望风尘阔，愁怀不可量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊雷江","author":"董嗣杲","text":"沽酒难浇傀儡胸，风平浪息卧孤篷。\n寒知僵舣雷江口，醒落狂吟雪店中。\n劳去有身侔病鹤，愁回无耳听哀鸿。\n行人那比淮人逸，豆饭藜羹乐岁终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊韶村","author":"董嗣杲","text":"汎然归息苦冬阴，小泊烟塍却旧寻。\n荷叶久空晴浦近，麦芒还吐晚村深。\n鲙鲈雨压还吴兴，寄雁云迷客楚心。\n便可放怀天地外，揽将奇思援孤琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"环碧园","author":"董嗣杲","text":"绕舍晴波聚钓仙，五龙祠畔柳洲前。\n清虚不类侯家屋，轮奂曾资母后钱。\n三面轩窗秋水观，四时箫鼓夕阳船。\n揽将山北山南翠，独有黄昏得景全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蘋花","author":"董嗣杲","text":"花明五出绣汀州，自在沉沉自在浮。\n古有楚童谣可信，今无越女采为羞。\n江清得实谁能剖，风起虚根不复留。\n晚向水乡回野棹，一规西日落湖州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茉莉花","author":"董嗣杲","text":"雪缀柔枝冷未融，暗销尘境暑威隆。\n根从海国分灵种，花逐仙娥下蕊宫。\n珠络香悬风紧处，玉壶人在月明中。\n直须第四番开过，都洒秋愁落翠丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎跑泉","author":"董嗣杲","text":"广福山灵托兽传，甃边依约爪痕坚。\n噬人虽负平时口，跑地能开一掬泉。\n不遇下车冯妇勇，都因脱屣性空禅。\n大慈坞内腥风起，善结丛林渴饮缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"表忠观","author":"董嗣杲","text":"钱子欣然著羽衣，何须学赋鉴湖诗。\n帝俞清献垂情疏，人读文忠叙事碑。\n五庙衮圭荣祖节，千年香火托孙枝。\n云林阁上西风起，吹落龙山宰树悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郁李子花","author":"董嗣杲","text":"劲条馥卉冒仙荄，殿取东皇艳杏开。\n茜瓣吐须凝露态，白英粘萼晕春腮。\n自知此树无人指，谁问他蹊有种栽。\n插取瓦瓶聊补空，不期粗俗误蜂来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金凤花","author":"董嗣杲","text":"花仙五色自迎逢，翅翼翔霞湿翠笼。\n娇萃九苞攒露萼，秀离丹穴舞秋风。\n埋丛还绕萧台胜，绚彩应怀舜殿空。\n曾见毗陵遗便面，善描开谢不相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金灯花","author":"董嗣杲","text":"弱瓣坚须灿野光，成丛灼灼斗丹妆。\n风葩净蕴商天艳，霞朵轻摇月夜凉。\n沈透柔柯难受雨，冷零嫩叶不禁霜。\n通明可使书窗透，肯拾秋萤聚作囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金沙井","author":"董嗣杲","text":"沙漾金星涌活泉，虚堂龙染德馨悬。\n朱绳汲冷梅林外，翠甃围凉桂洞前。\n石鼎煮茶非异事，井阑镌字是何年。\n西南云拥仙人屋，品酌今谁想乐天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金沙花","author":"董嗣杲","text":"暖倚青墙揉紫绵，绛葩淡染露花鲜。\n花遗颜色祇如此，名借酴醾得并传。\n伴直自应留故事，谩栽聊可殿春妍。\n年年满架东风艳，梦断词林视草仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中宿洞霄","author":"董嗣杲","text":"青青九锁山，步步听潺湲。\n雨重精神倦，云深意绪閒。\n禽声依石树，泉溜出岩关。\n落落仙踪在，何能见大还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后","author":"董嗣杲","text":"一雨收残暑，新凉夜顿添。\n秋声满落叶，虫语傍虚檐。\n衰疾便高卧，游程叹久淹。\n山林虽寂寞，亦足养吾恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨窗夜感","author":"董嗣杲","text":"风窗停暑雨，竹簟展寒波。\n酒醒乾坤小，林昏鸟雀多。\n凉堂喧管钥，秋戍淬弓戈。\n殊感征行苦，悲蛩咽楚莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保叔塔","author":"董嗣杲","text":"咸平曾有募缘僧，遍走街坊负叔称。\n定力一坚无外想，窣波七级可中兴。\n愚夫春日烧冥?，道者昏时炙梵灯。\n祗怪青龙行雨过，烟云遍护最高层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南天竺花","author":"董嗣杲","text":"粉红朵子不胜簪，何日移根鹫岭深。\n碎颗绿攒知暑过，栾枝红透得霜侵。\n凉分细叶犹张盖，秀结枯条可架禽。\n忆着花开花谢处，假山亭畔石池阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南屏山","author":"董嗣杲","text":"南有屏山掩翠霏，齐云亭子漫寻基。\n雨淋米老琴台字，火烈温公易卦碑。\n回首金鱼谁抚槛，销魂白骨自污池。\n春风不管游人老，愁落朝昏法鼓悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南高峰塔","author":"董嗣杲","text":"谁舍尘身石骨巅，浮屠突兀拂霄躔。\n方隅端拱明离位，梯级高营石晋年。\n土穴有龙嘘重雾，草庵无衲坐空禅。\n虚危直视烟霞路，镗鞳风铃到处传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客久","author":"董嗣杲","text":"衣裳敝尽客游阑，三月江城雨更寒。\n小店有翁赊酒易，名园无主看花难。\n驱驰尘土身千里，荏苒光阴指一弹。\n种种旧愁归杜宇，青山碧树带愁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中拟游庐山","author":"董嗣杲","text":"依违春梦破，悲壮晓鸡鸣。\n旅舍邻淮士，家书附递兵。\n东风吹浦树，落月下江城。\n办取游山具，天池听水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客次狂吟","author":"董嗣杲","text":"野服支离号散仙，望晴閒倚柁楼前。\n江山风月多寻酒，芦荻汀洲几泊船。\n水路愁疑孤障雁，野庐清隔雨溪烟。\n来春不负筇枝去，杨柳桥西听管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客江城归期尚阻","author":"董嗣杲","text":"晴坂桑麻绿，春溪蘋藻香。\n家林方歉岁，身纪且殊乡。\n澒洞时机密，淹留日计长。\n此生归造物，不必殢行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客约游山久未践盟","author":"董嗣杲","text":"居安怀蔀屋，处约客雄藩。\n风日山川媚，城池草木蕃。\n花时贫久减，春醉约多番。\n顾我留情极，怜君苦事繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]