[{"title":"次韵答璧侍者五首 其四","author":"陈造","text":"为向诗翁致命回，定应禅老笑颜开。\n盘餐要是随宜饱，略具油葱市海苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答璧侍者五首 其二","author":"陈造","text":"狮子窟中狮子子，孤群慑怯更清孤。\n当场不作春雷吼，底用吟诗压老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答璧侍者五首 其一","author":"陈造","text":"佛屋连延跨翠微，看云手版向曾持。\n重游不是寻春去，冷眼漂花捲絮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赠郭侯","author":"陈造","text":"郭侯智勇两俱长，驿骑何时诏检黄。\n胡运于今已灰囗，看君万旅出渔阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次魏知元韵三首 其三","author":"陈造","text":"江城半月从游乐，别去知君剩有诗。\n相望置邮三舍便，幸能时寄慰相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次魏知元韵三首 其二","author":"陈造","text":"魏郎日共无喧酒，旧学新诗得细论。\n可见高情重离别，又同一舸宿烟村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次魏知元韵三首 其一","author":"陈造","text":"客中把酒挹江山，更藉诗人为解颜。\n自是交游十年旧，向来相得立谭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行四首 其四","author":"陈造","text":"帆桅飞去划空明，人倚东风两翼生。\n世事快人如此否，日斜三百不留行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行四首 其三","author":"陈造","text":"远近青山不办看，翩翾征雁敢争先。\n船头起浪风头孰，不假骖鸾自半仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行四首 其二","author":"陈造","text":"舟鹢凌乘著羽翰，摊钱三老喜安闲。\n江豚白?欺人甚，喷浪跳波帆影间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行四首 其一","author":"陈造","text":"帆饱舟轻去若梭，平生忠信傲风波。\n忽然隐几惊摇兀，知是那吒石畔过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约徐吕二友访净慈老二首 其二","author":"陈造","text":"人间机巧厌相亲，南道吾今有主人。\n谁与清游联此辔，吕兄孺子最真醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约徐吕二友访净慈老二首 其一","author":"陈造","text":"魏紫千葩压曲栏，问君何似檐头看。\n城西更有芳菲地，旧约重寻莫作难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观山四首 其四","author":"陈造","text":"道人动作千年调，京兆才馀五日留。\n此去浮图桑下意，得无追忆费冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观山四首 其三","author":"陈造","text":"山如豪俊略方隅，傲睨骄蹇未受拘。\n为著孤亭凌缥渺，至今端委正衙趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观山四首 其二","author":"陈造","text":"每从迫隘面孱颜，劣比缘墙见髻鬟。\n好在此亭同把酒，与君全体看南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观山四首 其一","author":"陈造","text":"晴春载酒小徘徊，倏作冲泥冒雨回。\n毕竟山灵嫌俗驾，即今还殷阿香雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吕仙洞四首 其四","author":"陈造","text":"尘踪了鸟病催残，梦谒真人九转丹。\n已熟浮生枯骨观，更悲凡质遇天难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吕仙洞四首 其三","author":"陈造","text":"嵌岩中有玉为壶，不作嵇生守煅炉。\n玩世肯尝东老酒，翻身时过洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吕仙洞四首 其二","author":"陈造","text":"天人蜕迹便天飞，混迹尘凡世得知。\n岁历七朝踰六百，朝朝冷眼阅行尸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过吕仙洞四首 其一","author":"陈造","text":"神游八极此焉归，紫府天宽石作扉。\n倦客重来炷沉燎，转头六十七年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其一","author":"陈造","text":"隥围山拥碧崚嶒，二载房陵冷似冰。\n今日皇皇空载质，令人翻忆在房陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事二首 其二","author":"陈造","text":"形容肮脏水云宜，心意阑残欲语谁。\n不作贵人炎冷面，北山逋客最相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟诗自笑用前韵 其二","author":"陈造","text":"退归我欲学真长，君定才名江夏黄。\n考父旧尝睎吉甫，陵阳端的嗣黔阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟诗自笑用前韵 其一","author":"陈造","text":"文字光腾万丈长，锦官老杜豫章黄。\n投荒忍死经人鲊，讨饭充肠上岳阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈程帅五首 其五","author":"陈造","text":"一樽规度雪寒朝，小辍鸣弓抗射雕。\n未用军书送巾帼，故人祭灶有佳招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈程帅五首 其四","author":"陈造","text":"客间久欲赋归欤，归去何人为起予。\n平日呕心空子墨，羡公落笔便黄初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈程帅五首 其三","author":"陈造","text":"不将杯酒破衰颜，轹月凌风取鬓班。\n隽永要同无味味，雕搜聊乐不闲闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈程帅五首 其二","author":"陈造","text":"景物横前祇费才，何妨折简唤邹枚。\n连朝积雨前宵雪，总为催诗陆续来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈程帅五首 其一","author":"陈造","text":"平?陆海吸潘江，羽扇雍容筑受降。\n许蔡衡湘全楚地，了知邾郐不在邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守有和章复次韵三首 其三","author":"陈造","text":"闲舒侧理题长句，漫与胎仙纪往回。\n花径宿莺楼著燕，因思如愿赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守有和章复次韵三首 其二","author":"陈造","text":"接翼鸿冥聊尔尔，大书麟获更仪仪。\n雄边仙伯横琴处，应道苏耽兴尽归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守有和章复次韵三首 其一","author":"陈造","text":"一骨万金知未惬，五云七字不妨赊。\n此翁久断扬州梦，径付凝香旧主家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守送羊羔酒将以三绝次韵答之 其三","author":"陈造","text":"瓮中别作一家春，羒羜微生得效珍。\n少贷陶家煎雪水，更论徐邈对贤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守送羊羔酒将以三绝次韵答之 其二","author":"陈造","text":"小槽清凝带膻香，酿法知非羸角羊。\n拜赐未辞乾讲舌，呼儿留得荐蒸尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守送羊羔酒将以三绝次韵答之 其一","author":"陈造","text":"生尝跪乳资名教，死去遗芳谥碧香。\n洗盏开尝吾未敢，称冤肯入菜羹肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居二首 其二","author":"陈造","text":"卷书揩目小披襟，睡起初便茗椀深。\n一缕碧檀无与语，坐窗闲看竹移阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居二首 其一","author":"陈造","text":"五风十雨梅破夏，三青两黄麦欲秋。\n山禽谇语野花笑，瘦筇随客下西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其六","author":"陈造","text":"酒边凉意雨馀生，望夜重期看月明。\n安得水仙会事发，巧随人意作阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其八","author":"陈造","text":"寻得诗人到醉乡，银壶玉麈倍增光。\n小囊赋就鸳鸯锦，一路荷花别漾香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其七","author":"陈造","text":"底许行庖旋不空，小舟如织浪花中。\n盘珍俎实随供给，亦有红衣载短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其十","author":"陈造","text":"楼前行客竞昂头，楼上齐声唱石州。\n衮遍实催犹未彻，暑风晴月各新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其五","author":"陈造","text":"桃叶相逢但交臂，李鬟何许费凝眸。\n尔曹岂解文字饮，应道吾侪输此筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其九","author":"陈造","text":"玉人罢浴试梅妆，诗客挥毫落夜光。\n因病覆觞今破戒，为渠豪饮为君狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其一","author":"陈造","text":"荷面跳珠小溅衣，酒边团扇已停挥。\n湿云收尽人间暑，却度西山载雨归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其二","author":"陈造","text":"浦溆楼台远近殊，樽罍随处小踟蹰。\n高郎颇胜高常侍，解把西湖敌孟诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其三","author":"陈造","text":"银笔曾烦赞此君，即今墨色俨如新。\n因君细数登龙日，十九年前入幕宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖十绝句 其四","author":"陈造","text":"嫩绿摇漪红藕香，雨膏烟腻午供凉。\n西湖到眼真西子，莫信温柔别有乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩道中二首 其二","author":"陈造","text":"涉涧登山倦不胜，松间敲户有人应。\n竹帘琐细炉烟直，小作蒲团入定僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩道中二首 其一","author":"陈造","text":"过尽南山过北山，幽花好鸟翠霏间。\n满前风物牵诗兴，可是平生马上闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其十","author":"陈造","text":"寒食清明一箭过，晚晴庭院绿阴多。\n兔葵燕麦易轻脱，红药碧桃须孰何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其九","author":"陈造","text":"桃李争先不待催，梅花转首已青苔。\n即今蜀种胭脂树，压倒群芳尚懒开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其八","author":"陈造","text":"病减还思近曲生，嚼花嗅蕊对空瓶。\n不应斗酒钱三百，犹惜春衣耐独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其七","author":"陈造","text":"闭关不为赏心阑，咫尺东园到自难。\n斟酌东君惜春色，破除十九作阴寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其六","author":"陈造","text":"步屧归来未觉劳，迎门喧笑问儿曹。\n笑翁浑似鱼千里，小圃周围日几遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其五","author":"陈造","text":"破晓东风尚作寒，孤筇随客已媻姗。\n绝知蚤起非吾事，要趁梨花带露看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其四","author":"陈造","text":"仙仙弄影俯琼瑶，月地香红苦见撩。\n清梦定为蝴蝶去，杏花繁处宿良宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其三","author":"陈造","text":"春来敢自贷衰慵，正要檀栾间白红。\n爱竹少留枝策径，灌花分破著书功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其二","author":"陈造","text":"种桃接李不辞勤，旋作花前把酒人。\n羡杀文禽映花语，飞来趁得见成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居十首 其一","author":"陈造","text":"雪云脱坏漏朝阳，风物横前引兴长。\n红糁紫蕤今次第，迁莺来燕费商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈君美许仲和赴省病不能出饯以二绝句 其二","author":"陈造","text":"何人把酒送扬舲，定复从容柳下亭。\n共说归时柳阴合，与君衫色斗青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈君美许仲和赴省病不能出饯以二绝句 其一","author":"陈造","text":"修程快著祖生鞭，胜日同乘李郭船。\n自愧不能扶病去，郭南亭上看登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","po