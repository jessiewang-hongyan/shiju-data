[{"title":"观刘孝嗣写真","author":"李昭玘","text":"程生高价传两都，刘子骨相真丈夫。\n呼儿当轩试一展，噱噱指点相惊呼。\n此应前日坐头客，何乃不语严襟裾。\n胸中豪气不可状，但见粉墨无纡馀。\n虎头食肉亦天赋，尺面封侯宜不诬。\n须知中令有真相，忽效香山悲故吾。\n凌烟功臣易磨灭，贞观学士犹传模。\n当时人物不易得，曾看风神有此无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观画","author":"李昭玘","text":"梦泽正天寒，南峰带秋色。\n诗人句不尽，馀意传粉墨。\n年来两眼昏，吏牍苦侵迫。\n明窗展横素，刮膜谢砭石。\n往时蓬莱宫，图画灿东壁。\n拾遗老阴峭，思训丽春碧。\n经年一过眼，行绕不暇食。\n太行逢李生，笔势妙思索。\n未成真营丘，不俗已高格。\n安得十万钱，尽致鹅溪白。\n不须念衣裘，䃜灰日滋殖。\n写我江湖心，浩荡满千尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深山","author":"李昭玘","text":"日出敛苍霭，雨馀生晓凉。\n鸟啼人不见，花落树犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"李昭玘","text":"托身深秋困泥沙，鼓腹垂颐暴水涯。\n天上月轮劳注想，草中咫尺有长蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中顶","author":"李昭玘","text":"策足穿云表，都无几尺天。\n人寰莽何在，万里一荒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回马岭","author":"李昭玘","text":"缓辔不可度，疾驱应更危。\n平生几两屐，解有慰人时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"李昭玘","text":"日边雁带腊寒去，雪里梅将春信来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临安自述 其一","author":"赵期","text":"尘生宫阙雾濛濛，万骑龙飞幸越中。\n在野三闾君不顾，乘轩卫鹤懿何功。\n虽知四海同文久，未合中原武备空。\n星落夜原妖气满，汉家麟阁待英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临安自述 其二","author":"赵期","text":"临安皓月色如圭，清景伤时一惨悽。\n未见山前归牧马，犹闻江上带征■。\n鲲为鱼队潜鳞困，鹤处鸡群病翅低。\n正是四郊多垒日，波涛早晚静鲸鲵。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感时","author":"赵期","text":"谁人共挽天河水，尽洗中原犬虏腥。\n角巾私第不复言，兵迨留守宗泽疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自述 其一","author":"赵期","text":"万木阴中一草庐，溪风山月弄清虚。\n主人静坐心无物，读尽人间未见书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自述 其二","author":"赵期","text":"高山流水兴无穷，杖策携琴踏软红。\n莫怨子期呼不起，请君一曲奏南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"赵期","text":"早向江南征义旅，星驰千里自嫌迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昆山夜泊舟中遣怀","author":"胡峄","text":"念昔扶衰别故城，敢期身见稍休兵。\n连年防患秋更急，此节浮家夜亦行。\n梦里不应追昨梦，生前聊复且偷生。\n空中鸟迹谁能记，万古由来一妄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊昆山","author":"胡峄","text":"疾风欺雨透蓬船，拥被和衣昼亦眠。\n儿女登临馀脚力，更随明月绕山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同仲南弟游慧聚寺","author":"胡峄","text":"政欲相携紫翠间，不堪风雨径催还。\n何时更上月华阁，细认真山与假山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过百家瀼","author":"胡峄","text":"风雨留人阻去程，扶衰上冢过清明。\n百家瀼里犹掀簸，那得江神不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题衡岳观","author":"张兟","text":"灵岳峰前游古观，此中何别蕊珠宫。\n五云仙客形皆异，十洞烟花景不同。\n鍊药炉香金石气，醮星坛冷薜萝风。\n因闻大道修真诀，咫尺三清路可冲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五峰岩","author":"张茂先","text":"五峰岩窦倚层峦，偷暇登临到此山。\n泉石静中无俗客，楼台深处锁禅关。\n凭高林野依稀尽，望阔云天缭绕还。\n回首夕阳归去路，红尘随马转溪湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"张茂先","text":"重衾无暖气，挟纩如怀冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"张茂先","text":"德輶如羽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"张茂先","text":"熠熠宵流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"张茂先","text":"焕若春华敷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南禅寺","author":"熊浚明","text":"老榕挹翠拂双垣，流水相通郭外村。\n一竹便堪胜谓亩，千花应不羡桃源。\n渔樵小径斜通市，鸡犬谁家半掩门。\n最好风光孤坐处，亭亭海月破黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"熊浚明","text":"卓笔一峰当殿阁，合围千嶂锁林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还家涂中","author":"曾绎","text":"疏林残岭起昏鸦，腊尽行人喜近家。\n江北江南春信早，傍篱穿竹见梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"曾绎","text":"已无丑扇几边乱，空见春锄天际飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斗南楼","author":"朱师服","text":"危构参寥廓，星躔耿北窗。\n战馀尘没马，鱼散月澄江。\n迟暮怜孤客，宽閒乐此邦。\n坐中诗有待，端欲受谁降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"朱师服","text":"子牟心未老，愁上越王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题灵康庙","author":"章凭","text":"山边清气拥祥氛，遗迹流传汉史存。\n金殿已颁新号美，剑崖犹隐旧痕昏。\n据檐焚鼎惊鱼市，浮盖呼风过海门。\n千里阴功诚不浅，纷纷馀事岂须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凝真宫","author":"章凭","text":"昔人腾碧落，馀地扫岩隈。\n石壁云长在，松梢风自来。\n暗扉通浩荡，古蔓接崔嵬。\n更欲穷幽隐，仙源路已回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"流花亭","author":"章凭","text":"亭榜得佳名，山鬟拥翠闉。\n风流传晋客，谈笑忆秦人。\n水出桃源路，花浮洞府春。\n未应迷俗驾，行处是通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥","author":"章凭","text":"昔闻天台山，方广寺尤胜。\n石梁元自成，茶花随所应。\n见此绝世踪，嗟我拘三乘。\n更听寒泉声，不独发清兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"吴臧","text":"葛巾竹杖閒来此，可是心清迹亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄龙洞","author":"林同叔","text":"黄龙一洞与天通，仰视星辰目睫中。\n人去坛虚今已矣，祇留手植七株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七星坛","author":"林同叔","text":"十年客梦忆南徐，玉案曾看绿篆书。\n今日星坛香一瓣，恍如身再到冲虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九眼井","author":"林同叔","text":"幽人凿井住罗浮，暇日吾伊兴自由。\n仙鸟避吟来照影，九龙飞动碧云秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫道人","author":"林同叔","text":"万古烟霞隐石门，洞中别是一乾坤。\n仙翁自不知年岁，山下于今几代孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题栝苍洞宫","author":"刘光（袭明","text":"古洞藏真不记年，翠崖苍壁故依然。\n怪来一夜清无梦，身在仙家第十天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题南峰蓝光轩","author":"刘光（袭明","text":"百尺擎空窣堵波，群峰奈此独高何。\n鼓钟鸣处是非外，天地望中苍翠多。\n閒看野云披玉柱，醉眠秋浪捲银河。\n问师乞取窗前月，一榻清风许我么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"刘光","text":"满地残红惊不见，晓风吹上石榴枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"刘光","text":"仙馆无人春寂寂，一林红日鍊樱丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"刘光","text":"晓来多谢梁间燕，尽把春愁举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"刘光","text":"山翁何事冲寒往，知有梅花在隔溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"刘光","text":"归路夕阳收，山翠染襟袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙香堂","author":"郑敦芳","text":"山势巍巍千万重，来游仍觉思无穷。\n峰峦合匝溪如断，岩谷回旋径忽通。\n石屋凄凉飞瀑布，竹窗虚寂洒香风。\n开轩无限峥嵘景，尽日閒观属远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀杨冲远","author":"雍冲","text":"积雪盖重峰，岩松迷翠影。\n扶筇启静扉，耐此茅檐冷。\n幽涧冻鸣泉，钓翁立舴艋。\n伊人不可即，忧怀结怲怲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澹山岩 其一","author":"张昭远","text":"试将□恳种青霄，遂话田畴万里焦。\n不是湫龙解兴雨，元来滴滴是心苗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"蹇汝明","text":"我闻敬亭无足取，岑寂况在东南崖。\n声名一日遍宇宙，正以谢守诗瑰奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题翰林滩","author":"蹇汝明","text":"滩崖犹刻翰林名，凿凿寒波漱玉声。\n游子凄其感今昔，临流不敢濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎己酉冬自婺女携家至临海岁首泛舟憩天柱精舍谒吴君文叟山林感泉石之胜叹城邑之人沈酣势利不知山中之乐也","author":"苏迟","text":"列嶂峥嵘植翠屏，寒泉绿净浸轩楹。\n衣巾清润玻瓈上，窗牖疏明图画成。\n尘世正趋名利域，山居不识鼓鼙声。\n莫年忧患将何适，暂喜沧浪可濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释杲","text":"归宗会斩蛇，禾山解打鼓。\n万象与森罗，皆从这里去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景阳井","author":"王元甫","text":"动地隋兵至，君王尚晏安。\n须知天下窄，不及井中宽。\n楼外锋交白，溪边血染丹。\n无情是残月，依旧照阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送外","author":"谢氏","text":"此去唯宜早早还，休教重起望夫山。\n君看湘水祠前竹，不是男儿泪染斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予至寿阳道因访造华严论李长者旧居","author":"杨谟","text":"方山百里路崎岖，按部因寻长者庐。\n伏虎已归天女去，陇头新见万松株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琵琶泓","author":"杨谟","text":"晋城出郭十里馀，嫩柳山花满岩麓。\n苍苔蹭蹬步亦艰，百丈悬崖挂层屋。\n老僧正睡门不闭，习习阴风起幽谷。\n耳聩不闻琵琶声，但见一泓春水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感春","author":"慕容彦逢","text":"桥门并驰道，车毂声摩空。\n重廊隔嚣鬨，阒若林峦中。\n黎明寮寀集，联骑纷蹄鬃。\n交情金兰契，晤语药石攻。\n翰墨时间作，辞气争豪雄。\n微踪幸接武，徒愧劳无功。\n轩窗鉴晴日，檐外鸣春虫。\n沉迷惊节物，饮啄嗟樊笼。\n沂风渐澹荡，璧水初冲融。\n坐想名园花，芳菲衒青红。\n儒宫异拘窘，胡为苦匆匆。\n来时招客醉，驾言与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜深偶成","author":"慕容彦逢","text":"同舍诸稚子，初更坦腹眠。\n须臾起鼻息，汹汹如奔泉。\n而我忧且病，欲卧辄迁延。\n坐久觉疲倦，就枕如临渊。\n展转复长吁，情绪更凄然。\n睡思暂彷佛，征雁鸣九天。\n使我不能寐，体气宁不便。\n身心贵摄理，事累宜弃捐。\n而我无所答，泣涕但涟涟。\n是时月当午，素影隙中圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼卧偶成用前韵","author":"慕容彦逢","text":"我如边孝先，性爱日昼眠。\n眠眠曷能寐，愁思如涌泉。\n东风穆穆和，午影迟迟延。\n忧多首自旋，犹如瞰面渊。\n人皆喜春色，而我今犹然。\n叱奴启南窗，攲枕望青天。\n浮云来飘飘，飞鸟去还还。\n望眼无穷极，移卧窗之前。\n焉能梦栩栩，徒自腹便便。\n悠思慕范蠡，心形得两捐。\n轻舟泛五湖，短棹鼓清涟。\n规矩不我制，所意成方圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读扬子","author":"慕容彦逢","text":"子云不偶时，晏如在空屋。\n席有玄虚文，门无权倖牍。\n法言讥异户，解嘲惧赤族。\n忿悱赋长杨，羞愧登天禄。\n立俗思徇道，制行依圣读。\n身死名不朽，馨香蔼兰菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读陶渊明集","author":"慕容彦逢","text":"晋末何所似，波心跃长鲸。\n生民畏扰攘，蹙頞视欃枪。\n渊明当此时，弃爵务躬耕。\n葛巾漉家酎，杯乾壶再倾。\n恢然聊寄傲，无心事将迎。\n眼底不足语，笔下漫摅情。\n襟怀有佳趣，落纸字字清。\n有如碎寒冰，贮之琉璃罃。\n又如湛秋水，含兹霜月明。\n秀气如可掬，妙理不可名。\n辞中有馀意，此致尤更精。\n班豪诚可厌，曹侈无足评。\n斯文孰比拟，诵之清风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月雨霁游寿圣寺","author":"慕容彦逢","text":"新霁泽国净，禽声落云天。\n精庐巧营构，重扉锁春妍。\n檐楹曳晴丝，池沼鸣细泉。\n卉木互凌没，铅华刷澄鲜。\n桧枞屹如削，榴樱开欲然。\n零蕊莓苔鲜，幽香杂兰荃。\n俛仰欣所遇，尘埃坐自捐。\n云何写轩旷，松风鸣素弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题圣寿院","author":"慕容彦逢","text":"休征日欲沉，晚风薄虚翠。\n深秋景物清，莲宫有佳致。\n疏林速凄凉，黄花弄明媚。\n山烟入寥廓，螽声失幽邃。\n翻经瞥闻音，扫叶不待彗。\n危轩逗寒色，飞禽示真意。\n勤役何足辞，妙观良可秘。\n归欤诚未央，尔耳悲所志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题觉慈寺","author":"慕容彦逢","text":"勤役大无悰，驾言从胜游。\n萧萧野色净，行行村径修。\n逶迤转隈隩，初见岩峦幽。\n乔木耸霄汉，风籁凌清秋。\n税鞅得精舍，云绕空中楼。\n檐楹列清障，下有百丈湫。\n红尘不到处，俛仰销百忧。\n喟然问圆顶，有此能乐不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题智者寺","author":"慕容彦逢","text":"天工剖山腹，翻然纳虚秀。\n环冈插修荫，斜巅倚寒溜。\n危轩列层级，横梁跨深窦。\n浮烟羃轻缕，飞禽引鸣脰。\n冲襟得清盼，佳致绝纤垢。\n梦想脱冠来，尘缘苦相逗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题婺州智者寺","author":"慕容彦逢","text":"宿雨虽乍晴，轻云犹出岫。\n春深卉木繁，千岩衒芳秀。\n谁云山径幽，涓涓响寒溜。\n时禽助好音，百啭引鸟脰。\n老僧邀客留，蒲帘捲圭窦。\n侧耳石鼎傍，蝇声辩汤候。\n茶品颇自修，击拂振襟袖。\n勤劬爇炉香，挹试殆三嗅。\n稍定与之言，飘然出尘垢。\n坐久月华生，澄潭明列宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴显道","author":"慕容彦逢","text":"泽国破秋仲，景物兆冬索。\n回飙卷林尾，宿雾泛寥廓。\n泮水还阛阇，层峦瞰篱落。\n启牖挹茜葱，开径徒参错。\n齑盐虽寂寥，文史欣博约。\n论古到鸿荒，谈经愧穿凿。\n逸志想鸿冥，腼颜羞雉啄。\n于焉得真趣，豁若解其缚。\n环窗惟载籍，一视等糟粕。\n了了见本来，端如契圆觉。\n冲襟游汗漫，高步趋广莫。\n同心有名儒，摄官在戎幕。\n学识造渊醇，词章臻炳铄。\n良骥服盐车，白驹絷场藿。\n念昔始倾盖，考正于狐貉。\n韵宇凛可钦，标致湛无著。\n觞豆陪馀欢，翰墨时间作。\n晨嬉风力劲，夜语霜威虐。\n屈指两炎凉，流年信回薄。\n九重跻帝德，四海绝民瘼。\n南征奠蛮侮，西戍弭戎掠。\n吾道斯为亨，君才顾何怍。\n行当坐天禄，看书资笔削。\n不然冥成均，阐教助飞跃。\n冠绶追英游，林泉谢远诺。\n胡为怀故乡，逝将依负郭。\n古都富城市，比屋丽金雘。\n甲第临江壖，胜槩夺云壑。\n曲沟环渌塍，激涧度危彴。\n升高或扪萝，厉急辄遗屩。\n驯禽栖几席，幽花堕杯杓。\n渔樵频问讯，童稚杂欢噱。\n寻步陟兰屿，选胜望菌阁。\n此虽美无度，乌知乖所学。\n待时既韫玉，税驾宜振铎。\n忠告冀毋忽，投分匪轻托。\n野芹称美献，行潦资远酌。\n眷言效悃愊，岂止事嘲谑。\n知君须多暇，过我当如昨。\n茗饮无俗情，疏餐有真乐。\n论文穷九畴，议武贯三略。\n谁主复谁宾，此意良不恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]