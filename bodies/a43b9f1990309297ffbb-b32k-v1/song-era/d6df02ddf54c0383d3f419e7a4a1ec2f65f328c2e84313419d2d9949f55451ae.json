[{"title":"送楚南","author":"刘攽","text":"心寄江湖上，乐闻游子归。\n送君从此去，脱叶正秋飞。\n云水聊破浪，风尘今振衣。\n山僧不善饮，定负蟹螯肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送袁生","author":"刘攽","text":"巴蜀穷天险，惊君便向西。\n长年劳贾勇，悬度约轻赍。\n行止千金子，艰危万丈梯。\n自怜倾盖旧，即事复睽携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘四畋二首 其一","author":"刘攽","text":"四海皆兄弟，吾宗加老成。\n好书如子政，饮酒胜公荣。\n今日鲈鱼脍，羡君乘兴行。\n秋风峡中度，快意听潮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘四畋二首 其二","author":"刘攽","text":"肥水不能远，祇今行子东。\n高秋千里月，暮景一帆风。\n时节迎黄菊，汀洲下早鸿。\n江天多胜事，无术与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山阳送王中甫","author":"刘攽","text":"弱扇避风澜，卑飞岁复单。\n君行反阊阖，人望接鹓鸾。\n斋日容台峻，书签策府寒。\n谁言今昔异，王贡本弹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送某","author":"刘攽","text":"词曹大府掾，谁谓诏恩轻。\n遗爱念诸父，司存从汝兄。\n男儿贵壮志，子弟习家声。\n努力自勉励，吾衰观尔成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王同年殿丞知鄞县","author":"刘攽","text":"结爱愧同年，君先予著鞭。\n稍迁钩盾省，历试武城弦。\n越岭霞明日，南溟水浸天。\n微官等不遂，欲治子猷船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江亭后池","author":"刘攽","text":"清江长望极，馀兴曲池深。\n俯视游鱼族，仰嬉乔木阴。\n通津厌离会，胜地有登临。\n暮雨寒潮急，归飞闻水禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡因甫知湘乡县","author":"刘攽","text":"云水长沙国，铜章邑大夫。\n俗传鸮似鵩，仙化舄为凫。\n卑湿加餐饭，弦歌岂壮图。\n洞庭见归客，书信不宜无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"季夏雨过小有秋气","author":"刘攽","text":"雨过犹长夏，秋深从洞庭。\n江涵郭门白，山到戍楼青。\n天意怜卑湿，吾谋有醉醒。\n柴门夜不掩，高枕看流星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观云","author":"刘攽","text":"江上秋多雨，山中昼出云。\n太虚终日曀，叠嶂不时分。\n半觉蛟龙气，皆成虎豹群。\n微风动阊阖，暂喜见西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"刘攽","text":"危涂烦侧足，积水向吹襟。\n云树参天直，风湍殷地深。\n翠香秋后草，巧语霁来禽。\n信美非人境，无为久滞淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟","author":"刘攽","text":"野境寻不尽，幽欢良自如。\n犹疑梦为鸟，谁谓子非鱼。\n岸树绿已合，渚蒲长且疏。\n逍遥此中意，何减漆园书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夜","author":"刘攽","text":"海气三阴早，秋宵一刻长。\n凉风吹树动，疏雨过云忙。\n寂寂庭槐落，微微径竹香。\n蛩声畏人寝，故故近眠床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜三首 其一","author":"刘攽","text":"积水浮南极，流沙聚客亭。\n暝闻渔父曲，秋揖老人星。\n初月霜华薄，孤山石黛青。\n天高多影响，彷佛见湘灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜三首 其二","author":"刘攽","text":"凉风吹素月，深夜欲眠时。\n露自入秋白，漏从前日迟。\n河光如剑直，萤影似星移。\n多少流年感，闻蛩辄易悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜三首 其三","author":"刘攽","text":"流云卷残雨，初月净中宵。\n秋色河汉白，凉风星斗摇。\n暗萤犹奕奕，高树独萧萧。\n客鬓非松柏，何时得后凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题康州陈氏连理木诗","author":"刘攽","text":"陈家聚德星，累世若同生。\n天事知常象，林珍独应诚。\n相传殖嘉树，不复羡名卿。\n坐使炎荒化，何如谷口耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭吴道粹学士","author":"刘攽","text":"结束并州骑，雍容使者车。\n乃心长象阙，称旨得金鱼。\n熊鸟空遗术，龙蛇有谶书。\n平生一笑乐，回首涕盈裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬盛秘丞黑桃二首 其一","author":"刘攽","text":"度索方殊域，昆崙起素封。\n几人曾白眼，吾子幸先容。\n晦迹煤炱暗，含滋沆瀣浓。\n上林求异木，诏使会寻踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬盛秘丞黑桃二首 其二","author":"刘攽","text":"春华各自媚，秋实顿能殊。\n悴貌从黎黑，丹心固硕肤。\n榴花随使者，荔子赐匈奴。\n寄语玄都客，相疑失味腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨夜三首 其一","author":"刘攽","text":"急雨吹乔木，孤灯瞑小轩。\n神伤徒隐几，梦极不招魂。\n老泪悲朝雉，摧肠怯夜猿。\n旧惟眸子亮，一月遂全昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨夜三首 其二","author":"刘攽","text":"孟夏树木长，夜凉风雨时。\n明灯扫尘榻，散帙坐书帷。\n旷野波涛合，中宵虎豹悲。\n形骸吾丧我，隐几向为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨夜三首 其三","author":"刘攽","text":"云闇黄昏雨，风凄九月秋。\n老便安坐久，用即置书休。\n知命应无念，虚心自不愁。\n三年同此兴，中夜一灯留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"季夏雨夜","author":"刘攽","text":"烈暑殊未艾，更筹初少添。\n电光金作屋，雨气瀑吹帘。\n巢燕密谇语，闇蛩争出潜。\n何由扫氛翳，试使祝蜚廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵壁张氏园亭二首 其一","author":"刘攽","text":"落帆杨柳渚，步屧松竹园。\n丛石千岩秀，凉风万叶翻。\n主人昔傲吏，燕翼此衡门。\n略看题诗客，空令悲九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵壁张氏园亭二首 其二","author":"刘攽","text":"密竹换啼鸟，清池添放鱼。\n悬藤林下坐，响石洞中居。\n兴趣自无尽，传闻那得虚。\n如何仲长子，刻意但成书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十五日秋分是日又社","author":"刘攽","text":"秋分当月半，望魄复宵中。\n难得良辰并，仍将吉戊同。\n高楼连卜夜，浊酒任治聋。\n注想乘槎客，何如击壤翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送裴太博","author":"刘攽","text":"莱子头垂白，斑衣欢过人。\n官知为亲屈，禄足代家贫。\n归雁江南远，芳兰雪后新。\n仙舟兴不浅，致意越乡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夕阳","author":"刘攽","text":"骤雨无多润，残阳不复迟。\n阴凉庭树老，点缀石苔滋。\n斗雀轻投地，悬虫剩倚丝。\n林樱供口实，美味及童儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马氏中隐庵","author":"刘攽","text":"千岁知名士，文渊与少游。\n平生款段马，晚岁伏波侯。\n乡里足称善，功名仍可收。\n闻君事中隐，叹息此孙谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望荆山","author":"刘攽","text":"宿云收叠岭，初日上危岑。\n黤黮千重黛，光芒一线金。\n秋高怨摇落，野旷快登临。\n谁怪欣然乐，山林慰此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李太博知梓州郪县","author":"刘攽","text":"亦有飞凫舄，那知蜀道难。\n峡山从剑尽，江水向浯宽。\n近邑输盐井，连城接锦官。\n清风足富俗，唯寄七弦弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邵中允知华亭县","author":"刘攽","text":"一登文石陛，立拜紫泥书。\n省户方通籍，弦歌想下车。\n飞凫来不远，唳鹤听何如。\n莫作陶彭泽，田园与世疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦日自荐福泛舟泊女郎台下又泛东湖","author":"刘攽","text":"雪解寒生水，平湖照眼新。\n扁舟徐送客，绝境渐无人。\n径草芳菲浅，沙禽羽翼驯。\n佳辰数携酒，晦日已疑春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨兴","author":"刘攽","text":"宿露寒犹重，升曦旦尚昏。\n高秋凋众木，百里见平原。\n水涸看鱼族，田收长稻孙。\n冥山不可望，那复更南辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将游吴中寄原父","author":"刘攽","text":"久宦减仲产，行歌非五噫。\n归来问长铗，习水看吴儿。\n弱丧殊可恨，傥来今自知。\n江山不我厌，有意卜居之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和梁郎中咏太一碑","author":"刘攽","text":"翠琰盘螭近玉题，芝书光彩贲雄辞。\n方从薄忌真如在，事绝鸿都岂易窥。\n幼妇色丝辉锦组，银钩金错照琉璃。\n暮年无望青藜烛，时就祠官效祝釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和郭固太保留别长句","author":"刘攽","text":"关西兵马盛车邻，君向吴门望缇群。\n聚米山川都掌内，折胶天气及秋分。\n大将军令穷青海，三受降城起拂云。\n壮士不甘文学老，应须一剑取功勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"年三十三","author":"刘攽","text":"年光过眼日复日，世事无成三十三。\n尚子几时当毕嫁，仓公殊恨不生男。\n老知尚白书无益，贫作归田计不堪。\n传剑由来笑逢掖，簿书何必减清谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨起汴上口占寄韩玉汝","author":"刘攽","text":"戍鼓邻鸡催启关，繁星未坠重愁颜。\n云含雪意朝寒外，河带冰光曙色间。\n去远不堪登灞涘，言归时复念东山。\n梁台客在文章盛，修竹何当复共攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢霍丘静乐亭","author":"刘攽","text":"河阳种花春已滋，彭泽酿酒醉无期。\n宣城家声故未泯，单父弦歌方尔为。\n会知丘壑潜高兴，新作池塘出梦思。\n多惭嵇吕相思意，空寄羊何共和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海陵","author":"刘攽","text":"楚江葭苇带青枫，小市鱼盐一水通。\n度日冥茫吹冻雨，欲晴撩乱起凉风。\n秋花舞蝶苍烟里，古木啼鸦返照中。\n扶杖阶除搔白首，可怜卑湿负衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈和叔内翰","author":"刘攽","text":"六十衰迟祇自宽，读书无味细书难。\n一麾已愧腰银印，百选何由及治官。\n潮过石城如雪白，山从钟岭似虬蟠。\n元龙豪气逾坚壮，投辖能同客醉欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄杨元素内翰","author":"刘攽","text":"四世清名悉上公，看君羽翮势陵空。\n戏成炉鼎誇方士，妙夺蓍龟执鬼中。\n家有秦声居自乐，书非尚白智无穷。\n华光讲罢承明直，墨客无烦赋射熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同诸公晚游开宝寺福圣院","author":"刘攽","text":"微雨吹凉晚更清，老人牵强逐君行。\n纵谈灰烬疑烧劫，指顾楼台似化城。\n盘屈庭槐为狡狯，扶持山薜喜纵横。\n偷閒光景易侵夜，十二街头坊鼓鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉诏再任诸掾曹有诗因次其韵","author":"刘攽","text":"天下英雄将相才，自铭重石画云台。\n老夫不薄淮阳守，明诏幸缘黄霸来。\n岂有豹文容雾隐，更惭鹏翼待风培。\n诸卿相与望此府，诗笔纵横武库开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感事","author":"刘攽","text":"误以雄名荐九重，天书待诏未央宫。\n白衣不召崔亭伯，赋笔犹残亡是公。\n魂惊晚出芙蓉辇，泪堕春生杨柳风。\n衰鬓迩来元自白，可堪回首望遗弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建业华藏院此君亭","author":"刘攽","text":"何可幽栖无此君，层轩高下绝嚣尘。\n金声玉色三千士，雪戟蛇矛丈六身。\n定有霜飙惊长夏，兼疑寒谷近比邻。\n阿戎风味真难得，好事由来我辈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答张屯田朝退过阁下诸公","author":"刘攽","text":"紫宸归路接银台，复阁重门相望开。\n浮俗共讥惟寂寞，高贤独肯少裴回。\n照人珠玉惊尘骨，落笔埙篪写逸才。\n白日自嫌天上乐，不应沧海隔蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衰羸","author":"刘攽","text":"衰羸因底病相和，留滞俄然去日多。\n却是天怜令寿考，任从人会作风波。\n宽心总与欢欣受，述意无妨慷慨歌。\n更有南华书数纸，鹏声蜗角奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途次马上晨起寄章运判","author":"刘攽","text":"去年候客燕赵魏，今岁述职青兖徐。\n无穷道路不相舍，将老光阴仍暗除。\n官烛邻鸡常晓色，林花巢燕总春馀。\n未知前古才士意，为底愿乘万乘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伤梅圣俞直讲都官","author":"刘攽","text":"论兵自负纵横略，献赋端从迟暮年。\n筐箧成书莫知数，田园生计独无钱。\n郎官列宿为时贵，博士三科不待迁。\n已向九原悲蔓草，尚疑吴市有神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘长官桂府掌机宜","author":"刘攽","text":"桂林风物旧宜人，雪片梅花五岭春。\n心喜大江流瘴雾，眼看南极异星辰。\n军中羽檄时无警，徼外明珠日献珍。\n酒量问君能几许，越猿蛮鸟易伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后向景亭","author":"刘攽","text":"春泥软熟步成黏，水外风光一顿添。\n境为偶来生喜色，情缘久住失憎嫌。\n黄鹂惯习沙鸥野，古木粗疏径草纤。\n更向樽中得真趣，天然柔旨不因甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬送吴潜朝奉","author":"刘攽","text":"衰翁同岁喜相收，同病同心同白头。\n委吏除官俱逆旅，瘴烟香草等荒州。\n六千里外抛机略，二十年来谨校雠。\n工拙是非无会处，下陂红日若为留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬送罗朝奉 其一","author":"刘攽","text":"二年流窜逐卑栖，归奉蓬丘颜向低。\n病到钧天都是梦，老如濛汜已平西。\n两轓更忝鱼符宠，双鬓谁怜鹤发齐。\n相愧清诗无以报，回将燕石塞县黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬送罗朝奉 其二","author":"刘攽","text":"老去光阴若电惊，此身已复愧扶行。\n归田悔不如元亮，毕娶犹能似尚平。\n曩岁荐贤终未效，太音从古竟希声。\n最怜闾里人相语，北部威名动帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至登楼","author":"刘攽","text":"泽国风光早早催，阳生已复似春回。\n不妨野史书云物，会伴南公进寿杯。\n尘世光阴俱短日，客心冥漠过潜灰。\n此心未厌隆中卧，亦任东风起蛰雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高士敦成都钤辖","author":"刘攽","text":"使君出守腰铜虎，东第归来上濯龙。\n四姓礼容均马邓，三刀形胜梦巴賨。\n军中乐事随谈笑，徼外威声待指纵。\n壮岁勋名当自致，舅家恩泽不成封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别苏安上","author":"刘攽","text":"高閤横霄梧十寻，回廊曲槛昼阴阴。\n期年不就长杨赋，晚岁空为梁甫吟。\n童稚相亲俱白发，风波失所更情深。\n沧溟极目云涛壮，相见胸中快病襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与顾子惇同为秘书少监今年余以病求守汝南子惇亦除河东漕作诗纪事亦用送别","author":"刘攽","text":"蓬莱阁下枕书眠，一日除官不后先。\n并土山河多马地，汝南粳稻濯龙渊。\n壮心自喜谈兵策，暮齿长惭守乘田。\n别后天中相望处，参旗横注太行边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡楼望雪","author":"刘攽","text":"绕郭苍山高复重，东风朔雪曙云浓。\n层楼已出红尘境，到客宁知群玉峰。\n万树羽仪翔白鹭，四原鳞甲动真龙。\n玉樽清酒留终夕，更看山明霁后松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判裴库部城楼雪后","author":"刘攽","text":"数刻又移半日閒，倚楼朝雪正怡颜。\n委蛇原色苍龙甲，宛转城阴玉带环。\n曾是茵凭偕出处，聊于木雁得中间。\n伤春一振曹风陋，不羡淮南大小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复雪","author":"刘攽","text":"九江旧瘴冬无雪，三峡悲风近有冰。\n山岳出云寒处处，楼台倚玉照层层。\n不忧鸿雁飞无力，直畏蛟龙病莫兴。\n冻酒一杯还自劝，夜窗飘洒读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵宋职方雪","author":"刘攽","text":"梵天银界谈非想，仙府瑶台恨隔尘。\n何事同云移绝境，不知高宴即良因。\n林芳散漫装珠蕊，粉面光辉照玉人。\n别举一樽邀老伴，迎春送腊祇三旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵裴库部雪二首 其一","author":"刘攽","text":"小雨驻云风借威，回眸千里玉山辉。\n涂人竟比麻衣色，野老时惊白雁飞。\n梁苑正应延上客，齐宫遥想辟重闱。\n谁云自郐无讥者，一曲阳春可见微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]