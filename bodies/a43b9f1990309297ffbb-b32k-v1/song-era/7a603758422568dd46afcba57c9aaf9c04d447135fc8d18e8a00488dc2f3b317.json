[{"title":"题天彭鲍郎中南楼","author":"赵抃","text":"彭门于蜀最无双，人悦南楼重叹降。\n㶁㶁鸣泉漱金玉，森森佳木拥旌幢。\n仙飙出洞清来坐，峦雪排岩冷透窗。\n太守瞻云日登向，巴江迢递隔吴江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠玉局李垂应太师","author":"赵抃","text":"坐观山水地幽清，恬淡冲虚乐性情。\n迹混光尘宗老氏，术通仙俗似君平。\n欣逢真侣论根本，耻向权门叩利名。\n济世金丹得传授，先生高隐在青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都转运翠锦亭","author":"赵抃","text":"群木依亭翠锦开，主人吟燕日徘徊。\n青帏照坐初疑染，绀障铺檐不是裁。\n蚁酌对倾金斝满，鸭头前引五溪来。\n劝公勿用迟留赏，早暮须贤即召回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提刑邢梦臣度支连理荔枝","author":"赵抃","text":"嘉阳天远被薰风，荔子呈祥郡馆中。\n庇本莫将慈竹较，媚时宁与瑞莲同。\n并柯昼耸烟光动，异干霄空月影通。\n奇木幸逢真赏笔，谁誇丹实一庭红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苏采刑部赴召","author":"赵抃","text":"有诏西来亟治装，古今威望重痴床。\n不烦右蜀专飞挽，直为南台正纪纲。\n豸角风霜秋肃肃，鹤形环佩晓锵锵。\n忠贤得用朝廷美，礼法匡时事业光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张唐民都官道中有怀","author":"赵抃","text":"言念离情积有年，朋心金石孰为坚。\n殿庐未入承明直，郡阁先传太守贤。\n且向天涯行五马，不妨神液溉三田。\n闻公比悟庄生指，于此纷华已泊然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再经江原县有作","author":"赵抃","text":"徙命乘轺入锦川，岷沱寒霁好人烟。\n弹琴旧治俄三政，持斧重来未十年。\n欲去民忧同乐只，敢孤朝寄独恬然。\n邑城东望踟蹰久，魏阙天遥里数千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招运判霍交回辕","author":"赵抃","text":"自邛之雅渐高丘，所过从容尽胜游。\n白鹤山头云里寺，金鸡关外雨中州。\n公今南按蠲民瘼，岁已西成辍上忧。\n江渎荷花开似锦，且同归去采莲舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游青城山","author":"赵抃","text":"山到青城险复奇，地平孤起压坤维。\n直通一径岧峣上，俯觉千山迤逦卑。\n为访隐贤题古壁，因观幽境过荒祠。\n白云深处逢岩老，醉酌松醪满鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张唐英秘校桂香亭","author":"赵抃","text":"月中新得桂香清，归向斯亭立美名。\n作赋仗前登第好，拜恩堂下到家荣。\n晓羞兰膳亲心乐，春照蓝袍俗眼惊。\n跬步不宜轻自待，青云岐路坦然平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蜀倅杨瑜东归","author":"赵抃","text":"倅郡优游得治声，代还东出锦官城。\n一州和气三年迹，万里寒威十月行。\n江外预通乡信喜，仗前归拜帝恩荣。\n逢今佥用良材日，好使明堂大厦成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张唐英司理赴渝州","author":"赵抃","text":"不用咨嗟怆别离，听吾持酒祝公词。\n少年得第人谁似，纯孝于亲里共推。\n姓字已通丞相梦，才名须结圣君知。\n岳情要在平生允，容驷高门自有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题运判霍交瞻岷阁","author":"赵抃","text":"阁外风光满意新，诸公同上看梁岷。\n蜀天六月云如火，夷界千峰雪似银。\n岩叟近传多得寿，羽人曾此数登真。\n夫君不为神仙事，早暮孜孜泽远民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张唐英太博","author":"赵抃","text":"蜀卿荣耀跂光尘，忠孝兼全到古人。\n万乘累年闻奏牍，双亲同日拜恩纶。\n志侔鸾鹄风仪远，文得岷峨气象新。\n圣政于今急贤者，肯教留滞蜀江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬梓路运使赵諴度支","author":"赵抃","text":"东川使者驻前旌，西念邻邦眷旧情。\n屐齿峻登云顶寺，诗筒遥寄锦官城。\n民间乐矣原田稔，境上熙然岳犴平。\n闻说提封足和气，我心欢快为宗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡仲偃都官南归留别","author":"赵抃","text":"留诗为别重依依，春浪桃花晓弄晖。\n柯岭峥嵘何处所，兰桡安稳送将归。\n与君志有云泉约，顾我身无羽翼飞。\n浮石仙今遗迹在，吾庐江畔忆渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙直言书怀","author":"赵抃","text":"四十惊霜入鬓新，道光休叹守官贫。\n荣涂渐快青云步，宠禄方酬白首亲。\n此日文词誇世俗，异时才术济吾民。\n功名立去何忧晚，要得相期到古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青州劝学","author":"赵抃","text":"学欲精勤志欲专，鲁门高第美渊骞。\n文章行业初由己，富贵荣华只自天。\n一篑为山先圣戒，寸阴轻璧古人贤。\n沂公庠序亲模范，今日诸生为勉旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述怀","author":"赵抃","text":"三十年前一布衣，烂柯山下骤鸣飞。\n梦刀蜀国青天上，衣锦杭州白昼归。\n曾预机衡蒙帝眷，自同葵藿向晨晖。\n东斋事少愚知幸，终日平岚面翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏末喜雨","author":"赵抃","text":"灵湫祈祷酌樽罍，稽首精神敢惰哉。\n民意欲从千里雨，天威为动一声雷。\n预期多稼如云去，且免飞蝗入境来。\n酷暑骤祛还自喜，清风朝夕上楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孔宗翰水磨园亭","author":"赵抃","text":"南洋一派通机磨，更引馀波绕曲池。\n高柳碧阴无酷暑，小莲红老惜芳时。\n临流共赏休辞醉，按辔重来未可期。\n从此邦人为胜事，范公亭榭孔君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王居卿提刑游云门山","author":"赵抃","text":"千里峥嵘到忽平，兀然如觉梦魂醒。\n石通幽室心生白，径拥寒云步入青。\n一水下窥疑绝线，两山前列似开屏。\n重城归去仍堪喜，岁稔人家户不扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王宪中秋不见月","author":"赵抃","text":"一城歌管中秋乐，薄暮楼台六幕垂。\n明月幸无亏损处，浮云应有敛收时。\n聊因表海今宵醉，却起钱塘去岁思。\n有美堂前如白昼，练铺江面镜须眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄馀庆讲僧思辩","author":"赵抃","text":"年光已占六十四，七十归来尚六年。\n顾我久惭迷利禄，与师同约老林泉。\n政为岂弟聊康俗，心放逍遥自到仙。\n身寄东州梦南去，山堂依约艮庵前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孔宪重九出巡未回","author":"赵抃","text":"东望迢迢百尺台，清风徒念故人来。\n幸空讼缿澄心坐，喜得诗筒盥手开。\n不觉登高佳节到，未期行旆几时回。\n尧山虽与民同乐，阻共车公把酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬孔宪将还","author":"赵抃","text":"待月登高悉后时，还辕今喜近郊岐。\n再圆光彩蟾升汉，未谢馨香菊满篱。\n乘暇寻山应有得，许陪观海不知谁。\n感君按辔澄清外，遗我琼瑶两首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送十二弟太博扬倅潭州","author":"赵抃","text":"我忆初筵湖外日，于今三十八年间。\n无缘再得游潭府，有梦还应到岳山。\n屈指春秋惊老大，满头霜雪欲归閒。\n之官莫惮长沙远，行业于人不愧颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王宪表海亭赏雪","author":"赵抃","text":"开樽表海最高亭，正是纷纷雪态轻。\n比屋万层琼室遍，夷涂千里玉沙平。\n因风起絮先春意，与月交光后夜清。\n共喜丰登有佳兆，结成和气在民情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再登亭偶作","author":"赵抃","text":"气象三齐古得名，时登表海最高亭。\n河源一水下青嶂，人物两城如画屏。\n邑报有秋期俗阜，守惭无术济民灵。\n从来狱市并容地，且向樽前任醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄酬旧交吴中复龙图","author":"赵抃","text":"我昔梦刀惭乐土，群今叱驭信贤哉。\n芝兰旧友三年别，金玉新诗万里来。\n石室清风期俗变，锦城珍宴为民开。\n中和有颂朝廷喜，行看春光拥诏回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬越守孔延之度支","author":"赵抃","text":"君诗感别我依依，言念朋怀与愿违。\n京口落帆初醉后，江心登寺复分飞。\n回思二浙风烟好，来喜三齐狱讼稀。\n旧里未归徒仰羡，小蓬莱上占春辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青社有怀杭州","author":"赵抃","text":"早暮涛声绕郡衙，湖山楼阁衬烟霞。\n浑疑出处神仙地，不似寻常刺史家。\n假守半年无惠爱，退公连日不諠哗。\n东州久发同归梦，却念重来未有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再有蜀命别王居卿","author":"赵抃","text":"穆陵关望剑门关，岱岳山连蜀道山。\n自顾松筠根节老，谁怜霜雪鬓毛斑。\n离家讵谓虞私计，过阙尤欣觐帝颜。\n叱驭重行君莫讶，古人辞易不辞难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入蜀先寄青城张遨先生","author":"赵抃","text":"踰年青社得徘徊，一日皇华下诏催。\n蜀道五千驰驿去，秦关百二拂云开。\n不同参政初时入，也似尚书两度来。\n到日先生应笑我，白头犹自走尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题刘诏寺丞槛泉亭","author":"赵抃","text":"泉名从古冠齐丘，独占溪心涌不休。\n深似蜀都分海眼，势如吴分起潮头。\n连宵鼓浪摇明月，当暑迎风作素秋。\n亭上主人留我语，只将尘事指浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过铁山铺寄交代吴龙图","author":"赵抃","text":"暂留山驿又晨兴，西望旌麾想旧朋。\n三院华簪曾对直，两川兵印复交承。\n年光头鬓华如雪，世态心情冷似冰。\n境上凭诗驰远意，青泥寒晓入云登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过左绵偶成","author":"赵抃","text":"东南再守二年间，徙蜀何须问险艰。\n入觐已违龙尾道，出麾还过鹿头关。\n与民共约三春乐，顾我都忘两鬓斑。\n岁满乞骸何处好，仙棋一局烂柯山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵吴龙图别后言怀","author":"赵抃","text":"言念朋游二纪间，离樽前对鬓丝斑。\n告新剑外皆遗爱，道旧台中共解颜。\n我固无辞来蜀国，公闻有命镇秦关。\n西东接畛三千里，莫厌诗筒数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至成都有作二首 其一","author":"赵抃","text":"四十年间利禄身，平生疏拙任天真。\n惭无治迹留青社，喜奉恩华觐紫宸。\n去国早逢关右雪，下车还入剑南春。\n为怜锦里风光好，不倦从来作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至成都有作二首 其二","author":"赵抃","text":"西指梁岷路屈盘，犹能矍铄据征鞍。\n大庭临遣皇恩重，还俗传闻睿诏宽。\n峰耸云妆银世界，江深春动锦波澜。\n遨头老矣民知否，莫作风流太守看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵提刑张广民度支射中金钱","author":"赵抃","text":"百发秋毫不少偏，宜应佳兆中青钱。\n鸣弦迅发心先正，破的劳观眼欲穿。\n赏劝坐添杯上桂，咏歌宾许幕中莲。\n古人一箭功名立，岂止文章独炳然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题江原张著作善颂堂","author":"赵抃","text":"构堂宾族聚于斯，屈指高风剑外稀。\n七十年尊君乐隐，二千石重子荣归。\n溪流石上来清响，岩洞檐前耸翠微。\n旧令尹今西处望，江原闾巷正光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送运判韩宗道赴阙","author":"赵抃","text":"去岁间关到蜀时，闻君早作促装期。\n初疑倾盖无多日，今幸分携已及期。\n晓栈直登云里路，腊梅还见雪中枝。\n紫宸入觐从容对，剑外民灵荷帝慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别张宪唐民","author":"赵抃","text":"三年持节按刑章，岂弟其谁不叹降。\n才者设施功第一，使乎光彩竟无双。\n宣风蜀右成新法，易拜秦东得旧邦。\n欲识远人留恋意，陇泉幽咽下巴江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵运使荣諲学士游净众寻梅","author":"赵抃","text":"飞盖城西探早梅，僧园栏榭燕游陪。\n微寒始报冬初信，清艳应留腊后开。\n子美英词誇雪色，赵昌精笔写香腮。\n此花自有天容意，迎得春阳次第来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送茂守吴彦先郎中赴阙","author":"赵抃","text":"汶山为郡数逢春，被诏还都岁又新。\n惠政久通蛮徼外，怆怀初去蜀江滨。\n邛崃古未兼忠孝，宣室今非访鬼神。\n制禦羌夷知有术，上前章牍为开陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黎守毛抗屯田见寄","author":"赵抃","text":"岷峨还是一川雄，我愧行春与欲同。\n乐国比年丰衍后，嘉朋终日笑谈中。\n沈黎太守初成政，蕃诏诸蛮悉向风。\n圣世唐虞流泽远，启行无复用元戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送左绵孙圭职方赴阙","author":"赵抃","text":"三年遗爱被西州，供帐民情岂易留。\n险道若天春气近，雄关如剑晓光浮。\n禁中曾上台僚荐，使者仍书郡课优。\n去矣青云岐路稳，不须回首越王楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钤兵李左藏厅赏梅","author":"赵抃","text":"岁晏珍林发素葩，樽前奇赏著诗誇。\n惊逢腊去已三日，喜见春初第一花。\n照水冷容酥点缀，摇风香片雪纷拿。\n主宾莫作寻常看，锦里名园只两家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵荣学士按简州见寄","author":"赵抃","text":"我昔坤维滥使权，简池行部属丰年。\n盘桓郡驿留单骑，徙倚江亭按七弦。\n今愧高贤传丽藻，远闻清思涌寒泉。\n置藏巾衍光华甚，不使珠玑只媚川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钤兵王閤使素芳亭赏梅花","author":"赵抃","text":"素萼清香并酒卮，主人勤意嘱留诗。\n为逢蜀国新开日，却忆江南旧赏时。\n春密未通桃李信，腊残都放雪霜姿。\n先公旧植亭栏外，肯构重来见本枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答彭守鲍叔轲郎中","author":"赵抃","text":"白云东向日瞻凝，连掞封章写至诚。\n八十亲高思就养，二千石贵退辞荣。\n兰陔得志趋吴分，棠芾留阴在蜀城。\n腰印还乡人子乐，锦衣光动綵衣明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬剑守王嘉锡郎中","author":"赵抃","text":"登科三十四年春，五百人中有几人。\n顾我虚名惭过分，得公佳句读惊神。\n初疑暗里双珠掷，自喜怀间万玉陈。\n预卜铃斋论仕契，入关聊为驻车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周源屯田祷雨二首 其一","author":"赵抃","text":"城东野老告予知，四载凶荒语益悲。\n远水又成千里涸，阔天无复寸云垂。\n仓箱势绝丰登望，道路人为殍死期。\n刺史至诚天若应，愿留遗爱入生祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周源屯田祷雨二首 其二","author":"赵抃","text":"炎曦禾稼猛于烧，试问灵龟兆已焦。\n雨意几时随气协，雷威何日胜氛妖。\n汉朝八使烦敦遣，周室三公重燮调。\n有祷愿将明德荐，芳馨何必在兰椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答江钺都官见招","author":"赵抃","text":"风波岐路益驰奔，疏静嗟谁得似君。\n乐矣夜觞西岭月，傲然秋钓北溪云。\n诗章有趣为千首，利禄无心顾一分。\n鸡黍辱招来慰意，俗拘何计入兰薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵江原方任太博见寄","author":"赵抃","text":"锦城之别重吁嗟，人事缤纷走岁华。\n遗我诗篇来有意，忆君魂梦去无涯。\n秋惊蜀岭更书近，云掩闽山故国赊。\n闻说政成风俗好，又添和气乐人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李元方即事","author":"赵抃","text":"壮岁胸怀独感时，肯随寒暑似民咨。\n能思损益长开卷，任有閒心不负诗。\n趣向已为污俗笑，声名须共古人期。\n茅斋寂坐生秋思，无语西风夜月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻岭外寇梗","author":"赵抃","text":"惊说炎飙烟瘴时，洞蛮蜂起寇南陲。\n家书万倍金难得，远梦千回路不知。\n刺史没身专捍禦，谏官衔命救疮痍。\n伏波死去今谁继，大笔铭勋压海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠东川曹道人","author":"赵抃","text":"养生非谓独存神，功行须令日日新。\n高睨鹏抟风万里，静怜龟息寿千春。\n物无凝滞心无积，名已逍遥道已醇。\n命不在天须力信，世间多少未知人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝成都府学诸生","author":"赵抃","text":"学初心勿动华纷，须念文翁昔日勤。\n事业直教名不朽，声猷堪畏世无闻。\n平居乡党终传道，得位朝廷必致君。\n为语诸生期远到，天衢亨处有青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题府庭海棕","author":"赵抃","text":"海棕根干出栟榈，双势凌空剑外无。\n长锁荆榛嗟庙柏，不禁风雨笑庭梧。\n胡僧过识已千岁，蜀守来观只两株。\n离立峨峨同壮士，侧身东望拱皇都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵文同学士春雪","author":"赵抃","text":"东皇欲报丰年信，千里同云六幕阴。\n遇景大吟诗将手，与民偕乐使君心。\n锦城阔暖无多积，岷岭高寒旋觉深。\n最是西园花木好，晓来妆点作瑶林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]