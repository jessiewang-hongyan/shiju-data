[{"title":"渡淮","author":"许及之","text":"照眼清淮笑力微，家人应喜近庭闱。\n兹行莫道无勋绩，带得星星白发归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德久舟行阻风","author":"许及之","text":"昨日颠风鸟雀喧，牵夫寸步不能前。\n今朝收缆张帆坐，世事乘除只偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡江","author":"许及之","text":"扬子江头渡晓风，一舟掀舞浪花中。\n江神似恨频将币，不许和戎出汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题金山寺","author":"许及之","text":"水月光中全体现，波涛涌处定珠圆。\n每因王事参差过，更羡仙山晻霭边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿南京城下县","author":"许及之","text":"虚说胡屯五万兵，凄凉无复旧南京。\n中天王气终当复，千古封疆只宋城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台","author":"许及之","text":"敢将出处较秋毫，未报君恩感二毛。\n七里滩头停短棹，细看渔父亦清高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过马当山","author":"许及之","text":"彭郎矶头晚更凉，扁舟瞥过鲚鱼香。\n买鱼斫鲙初传酒，顷刻风帆过马当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登第一山 其一","author":"许及之","text":"登临休作楚囚悲，遮莫人心知汉思。\n畴昔百闻今一见，勉旃报国在男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登第一山 其二","author":"许及之","text":"几因护客数登临，怅望神州久陆沉。\n今日登临身是客，经行应切此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净社山中即事二首 其一","author":"许及之","text":"拾得閒身傍佛庐，吟边不解著工夫。\n晚来好处无人领，净社山中闻鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净社山中即事二首 其二","author":"许及之","text":"家童裹饭就僧家，饭了僧来共点茶。\n听雨轩中无一事，蔷薇却有旋开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游三茅忽得佳处留赠乡黄冠师","author":"许及之","text":"三茅观里仙为宅，七宝山头玉作堆。\n不尽经行奇特处，只教留作等閒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为山","author":"许及之","text":"叠石为山底用高，经丘蓦岭欲平桥。\n青林屈曲崎岖过，疑有碧花无数桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵薛奉常清凉山灵潭寒瀑二绝句 其一","author":"许及之","text":"清凉山中冷难宅，中有灵渊人莫测。\n划开神秘奉常君，万丈寒泉贮穹壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵薛奉常清凉山灵潭寒瀑二绝句 其二","author":"许及之","text":"田家要雨随即雨，岂识潜珍在中止。\n霏微不绝自成霖，万古禾头不生耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和奉常灵潭寒瀑韵甚有同游之意 其一","author":"许及之","text":"奉常如僧逃火宅，天与渊泉谁识测。\n我今亦是閒散人，何日跻攀临峭壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和奉常灵潭寒瀑韵甚有同游之意 其二","author":"许及之","text":"对床盍听风雨情，同胞兄弟亦何止。\n试于如梦境中听，雨声水声风过耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其一","author":"许及之","text":"诗翁作意与春期，寒食翁来春合知。\n不是春工浑忘却，好题诗是雨游时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其二","author":"许及之","text":"晴即飞尘雨即泥，乍教泥滑得行迟。\n贪看花处篮舆舞，静得句时流水知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其三","author":"许及之","text":"可是前身住寺僧，未经行处恰如曾。\n松杉夹径当前导，莫惜纶巾冒雨行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其四","author":"许及之","text":"惊人诗句任人嫌，诗得春来思转添。\n莫道诗翁太奇崛，思如春溜泻层檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其五","author":"许及之","text":"天竺精庐晻霭中，篮舆初歇袖初通。\n回时管胜来时节，屋角微微转相风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其六","author":"许及之","text":"不比寻常梦阿连，山中真个著行缠。\n野花已放名花未，回施风光与少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其七","author":"许及之","text":"山花压溜水通池，时有幽禽自在飞。\n日脚忽随云脚露，钟声恰与梵声齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其八","author":"许及之","text":"溪流来自宝峰头，流到栏边不复流。\n拔闸放泉聊戏剧，怒湍平后一齐休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其九","author":"许及之","text":"老僧雪顶接霜髭，并日楞严手自题。\n见得眉间多喜色，定应行处有新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十","author":"许及之","text":"布地黄金间碧疏，归依大士摄心初。\n功名骨相元何有，身口业中除得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十一","author":"许及之","text":"晴岚羃羃水潺潺，归步花光夹道间。\n中竺已游游下竺，冷泉亭畔更登山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十二","author":"许及之","text":"红满园亭绿满郊，愁风愁雨岂天教。\n留将画舫临湖侧，认取青帘出杏梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十三","author":"许及之","text":"不枉皇都九十春，春春行乐有谁贫。\n休论旧雨兼新雨，何限今人念昔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十四","author":"许及之","text":"诗句才成雨又催，酬时只倚十分杯。\n诚斋笔下诗何数，不祇晴来雨更来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十五","author":"许及之","text":"明时与物总为春，乐处陶陶即是真。\n胜赏不妨閒信马，名园莫问属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵诚斋寒食日雨中游上天竺 其十六","author":"许及之","text":"玉勒金鞍问宝装，少年有意竞春忙。\n不妨系日宽门禁，安得长绳尔许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"车行诗","author":"许及之","text":"稳如江海迎潮上，险似虚空逐电行。\n纵使中原平似掌，我车只作不平鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈留道中","author":"许及之","text":"雍丘纡路到陈留，积雨瀰漫涨畎畴。\n道左流民形似鬼，能无百里为分忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵壁道傍石","author":"许及之","text":"花石纲成国蠹盈，贼臣卖国果连城。\n陵迁谷变犹横道，反作傍人座右铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝歌城","author":"许及之","text":"鲁墙丝竹千年在，寂寞朝歌莽一丘。\n突有浮屠延望眼，何因驻得墨家流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羑里城","author":"许及之","text":"扁公墓下艾犹荣，羑里城中草不生。\n岂是圣贤遗恨在，只应天自不能平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵故城","author":"许及之","text":"丛台意气俄销歇，故垒歌钟几劫尘。\n只有蔺卿生气在，坟前衰草镇如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涿州","author":"许及之","text":"蓦直中原掌似平，范阳巢穴奈天成。\n未能太古全无事，黄帝如何不治兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卫州","author":"许及之","text":"河决从来国隐忧，卫州那在水边头。\n伤心中土沦胥久，可但堪嗟一卫州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栾城县","author":"许及之","text":"寂寞栾城顿食迟，令君跪告簿尤危。\n固非鸾绶身栖棘，可忍鸱巾首告笞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆都县","author":"许及之","text":"庆都将过过唐河，欲访灵台去路赊。\n试问车夫能指点，好峰无数碧莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淮阴县","author":"许及之","text":"甘罗古篆娑罗刻，岂但淮阴妙二罗。\n胯下桥边有男子，追亡拟问汉萧何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁同年接伴赓从客陆成父至淮阴县韵","author":"许及之","text":"日月光中尽彻侯，独全终始是封留。\n可怜胯下奇男子，虽愧淮阴不愧刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁同年接伴赓从客陆成父至宝应县韵","author":"许及之","text":"雨洗秋光滴夜凉，斗牛河汉绚文章。\n明时不宝埋光瑞，应有真贤为发祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过相台","author":"许及之","text":"胡儿吹笛醉秦楼，月白风清只共愁。\n魏国九京如可作，锦衣能复故乡留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过陈桥见太行","author":"许及之","text":"驱车夜半出都城，策马陈桥已半程。\n回首白云南阙下，太行何事马前迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过龙德宫","author":"许及之","text":"龙德宫中旧御园，缭墙栽柳俨然存。\n秋光更向墙头发，似与行人溅泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过常山村店中见菊","author":"许及之","text":"黄菊娟娟媚晚秋，等閒野店亦藏幽。\n国香何恨成沦落，秋月春风不解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过赵州石桥","author":"许及之","text":"桥梁显刻认中朝，仙迹遗风不可招。\n唤作沃州人不识，今朝只过赵州桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夺玉石桥","author":"许及之","text":"辇却民财积上京，民贫政自不关情。\n琼台要筑犹馀事，何况桥成夺玉名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漳河","author":"许及之","text":"出郭安阳漾碧波，黄流汩汩泛漳河。\n河滨饮水令人瘿，岸石其如腹疾何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琉璃河","author":"许及之","text":"黄河九曲固难穷，六里琉璃未长雄。\n眼底坳堂君勿诧，使华来自水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"护龙河","author":"许及之","text":"门题善利遏朝宗，一水何从更护龙。\n菱角鸡头教偪仄，可堪游女折芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"魏河","author":"许及之","text":"过却黄河有魏河，燕山直下有通波。\n不须图写山川势，它日因粮省橐驼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"易河","author":"许及之","text":"车辚辚逐马萧萧，易水无声泻泬寥。\n只听琴声已萧瑟，更行霜月更闻箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滹沱河","author":"许及之","text":"逋诛狂寇釜中鱼，未免真人驾六飞。\n千古石人虽暧昧，一时河伯太机微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归途观芦沟新桥","author":"许及之","text":"长虹如玉跨长川，下马摩挲得细看。\n他日燕郊如旧识，芦沟桥下古桑乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归途感河南父老语","author":"许及之","text":"河南民力已无堪，泣诉王人语再三。\n勤苦遗黎姑少忍，北人何止弃河南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有感","author":"许及之","text":"宋卫绵延接赵燕，古来争战可胜论。\n细思醉把乾坤掷，蛮触区区匪大言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文王庙","author":"许及之","text":"圣贤多难古来同，易数身更羑里中。\n甲子既周屯既复，不应天数竟终穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"光武庙","author":"许及之","text":"真人祠殿柏乡边，下马焚香我谒虔。\n思汉民心今戴宋，密祈兴运早中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题萧相国庙","author":"许及之","text":"古庙凄凉古镇边，酂阳户口更凄然。\n封侯当日如今日，越使萧公剩买田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题曹娥庙","author":"许及之","text":"当日曹娥念父心，千年江水有哀音。\n可怜七尺奇男子，忍使神州半陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒曹娥祠","author":"许及之","text":"昔因淑节叹男儿，今愧男儿竟未奇。\n携累乞灵无可祷，只求晴霁乐丰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹操冢","author":"许及之","text":"舜葬苍梧的可知，九疑犹是后人思。\n阿瞒不作瞒心事，何用累累多冢为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓居婺倅厅秋夜观书有感四首 其一","author":"许及之","text":"虚庭摵摵撼梧楸，黄卷青灯字字愁。\n说与西风莫萧瑟，年来诗思不禁秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓居婺倅厅秋夜观书有感四首 其二","author":"许及之","text":"每当剧暑忆秋期，暑退凉生喜可知。\n不奈寒蛩促机杼，等閒催得鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓居婺倅厅秋夜观书有感四首 其三","author":"许及之","text":"子城高处易为秋，密点催更响更幽。\n掩卷不眠阶下坐，淡云东去月西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓居婺倅厅秋夜观书有感四首 其四","author":"许及之","text":"四十男儿不自怜，求田问舍计茫然。\n一官未办君亲报，纵有田园亦舍旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申岁题玉牒所壁 其一","author":"许及之","text":"担上看梅不是梅，孤山消息限蓬莱。\n仙源圃里逢人日，雪色怜随霁色开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申岁题玉牒所壁 其二","author":"许及之","text":"雪坞霜窗合断魂，仙姿元住水边村。\n园丁莫讶盆池小，留得疏疏澹月痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申岁题玉牒所壁 其三","author":"许及之","text":"空餐无补愧侏儒，茗碗香炉细读书。\n还被梅花勾引破，又哦新句步庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申岁题玉牒所壁 其四","author":"许及之","text":"冷蕊疏疏开可数，香风羃羃远能闻。\n不因脩竹遮拦得，一夜清寒定忆君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申岁题玉牒所壁 其五","author":"许及之","text":"数日清寒不肯开，枝头阁雪冷皑皑。\n霜禽飞去花身动，一片清香在绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊申岁题玉牒所壁 其六","author":"许及之","text":"直舍孤吟未过清，梅花相与有诗情。\n寒鸦真似随人好，写就新诗啼数声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书潘德久版壁","author":"许及之","text":"故人有诗仍有屋，囷里无禾鼎无肉。\n可怜驱去傍人门，阶下苍苔孕寒玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]