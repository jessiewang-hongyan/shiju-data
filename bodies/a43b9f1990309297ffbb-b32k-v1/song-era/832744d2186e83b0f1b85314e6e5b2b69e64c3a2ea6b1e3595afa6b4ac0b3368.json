[{"title":"古有所思","author":"吴泽","text":"我思至人，游心唐虞之帝廷。\n上下数千载，迥如云霄畴与京。\n皋夔礼乐表世则，克绍周孔流芳声。\n斯文在兹幸不坠，亘古永怀惟六经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叩棺歌","author":"吴秉信","text":"信叟归去来，三界无安不可住。\n西方净土有莲胎，愿去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉定十六年题陶公惜阴处","author":"吴绍","text":"幽房翠竹笼苍藓，更有流泉溅石硔。\n莫道尘埃人易涴，试来摇足濯清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过郭店谒文靖公墓","author":"吴育","text":"汉相岩岩真国英，门庭曾是接诸生。\n阳秋谈论四时具，河岳精神一座倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重建羊太傅祠和王原叔句","author":"吴育","text":"羊公千载得清吟，芳迹虽遥契昔心。\n更与岘山为故事，凛然风格照来今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟雨楼","author":"吴育","text":"一上危楼七泽分，胜游平日此怡神。\n荆台芜没千年地，楚望云披四面春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉和给事中","author":"吴育","text":"律上阳和虽始煦，樽前人意已生春。\n濠梁且欲观鱼乐，淮郡何能致鹿驯。\n为访心朋犹纵棹，况逢时隽与均茵。\n别车岂必辞沉醉，更有高阳倒载人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才上人归天台","author":"吴育","text":"几年瓶钵帝城栖，看尽尘劳息尽机。\n诗妙偶因馀力到，名高却与本心违。\n云深路入千山去，岁晚身携一锡归。\n林下应逢旧猿鹤，得无惊见紫檀衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"承原父以凤凰篇为况谨用来韵和酬","author":"吴育","text":"丹山郁世表，岩岩千仞巅。\n自非常雏辈，安得参周旋。\n胡为此弱羽，越簉祥仪鲜。\n飞鸣过所据，飙骇俄翻然。\n退则安栖地，翔风娱楚天。\n始病孰俦侣，乃与朱鸾攀。\n英英日相照，老翮徒愧前。\n少别正倾听，览辉当圣年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴育","text":"石存裴令老臣心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思刘改之","author":"吴英父","text":"襄阳刘子谪仙俦，挥斥尘寰却寓游。\n醉眼芒羊天地窄，吟魂凄荡鬼神愁。\n生来不带封侯骨，老去徒深活国谋。\n旦暮风尘起河朔，未容埋没委山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉翠楼","author":"吴虎","text":"玉楼高倚汉昌城，处士閒居不可名。\n天际山青疑泰岱，云边木落见长庚。\n开帘晓挹晴光满，策杖秋吟爽气迎。\n我欲巢云向西竺，何时风月话三生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过至孝墓","author":"吴城","text":"过为世希氏，史牒鲜著名。\n孰谓吾之邦，有以至孝称。\n想其事双亲，诚恪通神明。\n身后一抔土，世犹不敢轻。\n乐公诚乐善，记名誓遗氓。\n偶读灵禽碑，得之嘉不胜。\n吾邦有盛德，岂宜久沉冥。\n恨不访遗冢，下拜涕泣零。\n又恨失名字，无以附汗青。\n自伤无赢赀，傍建旌孝亭。\n当使孝者见，事亲坚其诚。\n且令顽悖儿，内愧面颊赪。\n因兹或改行，为国省繁刑。\n徒将拙言句，颂咏播芳馨。\n蒿茨莫浪剪，牛羊勿妄登。\n过者宜下马，呵护烦山灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐令/清平乐","author":"吴城小龙女","text":"帘卷曲栏独倚。\n江展暮天无际。\n泪眼不曾晴，家在吴头楚尾。\n数点雪花乱委。\n扑漉沙鸥惊起。\n诗句欲成时，没入苍烟丛里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛五云溪游照湖归","author":"吴奎","text":"樵风漾归舟，飘然一叶轻。\n曲岸忽超逸，远山回抱明。\n幽禽淡容与，荷芰相低倾。\n野田足收穫，村叟时逢迎。\n驩言无物役，得我游览情。\n日脚暮云起，湖面蓼烟生。\n秋光湛空碧，彷佛见重城。\n候吏津亭外，稍闻笳鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛照湖游天章 其二","author":"吴奎","text":"愁霖不肯已，阴结弥二旬。\n吾游欲及时，秉烛出城门。\n泛泛一舫航，密坐环亲宾。\n爽气忽侵袂，重云稍逡巡。\n俄顷万里晴，鬼魅伏清晨。\n日光溜水态，照灼无涯垠。\n轻烟缅以没，微风飙然振。\n菰蒲动幽响，拨剌惊潜鳞。\n浮沈戏鸥鹭，荡漾开萍蘋。\n榜人发棹歌，渔翁理罾缗。\n激越自成态，潇洒何其真。\n清辉不可状，野思徒纷纭。\n弭棹山之阿，行行问吾民。\n莓苔粘侧径，马足绝纤尘。\n青溪曲折度，茅屋经过频。\n川涂斗开阔，夷路夹松筠。\n右转耸云构，广除砻翠珉。\n佛殿烁金碧，标榜自玉宸。\n脩廊盘磴道，等级华堂新。\n最后敞高阁，扃藏帝室珍。\n冥心一薰拂，璨璨罗星辰。\n大哉三圣笔，天纵妙入神。\n名家数几百，较古谁为邻。\n山头见塔影，树杪排嶙峋。\n直上遽登造，爱奇忘艰辛。\n秋容媚虚旷，蔼蔼扬奇芬。\n群峰出圭角，万象皆缕陈。\n森爽翠欲滴，苍茫寒袭人。\n远心穷碧海，逸兴凌高旻。\n踌躇下烟麓，盻眄行复询。\n僧言王右军，遗迹永和春。\n兰亭有曩基，墨池含漪沦。\n书室閟灵像，五亭馀圆囷。\n次第与探历，毕景颐厥因。\n简累脱纷滓，遗荣终幅巾。\n逍遥自得场，此节固离伦。\n愤耻以寄傲，则非吾所遵。\n凉飙拂脩竹，暮霭起长津。\n缨佩顾为忝，城郭宜尔亲。\n回首已遥碧，恍然尘世分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛照湖游天章 其一","author":"吴奎","text":"秦望奇峰北，天章野寺东。\n石桥跨惊濑，云屋丽层穹。\n片段磨砻密，高低结构雄。\n盘基深凿岸，飞势耸凌空。\n迥却熙蒸日，虚含自远风。\n溪山形胜聚，川陆往来通。\n竹影摇轩外，松声逼坐中。\n孤烟惹樵叟，轻浪溅渔翁。\n气象清无比，登临杳莫穷。\n直须图画看，安得入神工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和欧阳永叔送龙学赴陕府酌饮赠别","author":"吴奎","text":"陕郡太守来告别，翰林主人为置酒。\n急唤寻常诗酒伴，要誇此会为难有。\n席间骋辩何快哉，恰似纵丸临坂走。\n诙谐往往笑绝倒，同异时时瞋掉手。\n共怜奇伟出尘冥，却欲昏愚浪枯朽。\n从来豪举必兼包，击节齐侯容九九。\n我实鄙钝不晓事，贤公采取宁非偶。\n择之文行众所珍，昔日乘槎犯牛斗。\n年将老矣又分符，莫遣安排用庄叟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游云门寺留题灵运上人房","author":"吴奎","text":"云门入云深，树密山转幽。\n溪亭脩竹里，激激玉泉流。\n仁智所遐想，古今为胜游。\n我乘休沐至，穷览殊难周。\n金碧楼殿午，寒香松桂秋。\n清风动高兴，飘越不可收。\n禅师索题诗，捉笔事冥搜。\n欲速驰思远，顷刻历九州。\n象外有真物，惝恍难为求。\n徒形陈熟言，羞涩为尔留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴奎","text":"奚车一牛驾，朝马两人骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"升平乐","author":"吴奕","text":"水阁层台，短亭深院，依稀万木笼阴。\n飞暑无涯，行云有势，晚来细雨回晴。\n庭槐转影，纱厨两两蝉鸣。\n幽梦断枕，金猊旋热，兰炷微薰。\n堪命俊才俦侣，对华筵坐列，朱履红裙。\n檀板轻敲，金樽满泛，纵交畏日西沉。\n金丝玉管，间歌喉、时奏清音。\n唐虞景，尽陶陶沈醉，且乐升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西岩院","author":"吴宣德","text":"幽村分野径，胜地绝浮埃。\n殿闭烟霞静，门临水石开。\n日斜山影背，泉落雨声来。\n故里经年别，祇园首重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙潭石","author":"吴彦夔","text":"云山隐隐草芊芊，水色迷离怪石边。\n百啭黄鹂消永日，千寻白练映长天。\n竹垂清露添诗砚，燕蹴飞花落舞筵。\n林外不知春雨歇，正宜携酒望前川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题鹿苑寺壁间记鲁简肃公罗汉见梦事","author":"吴思齐","text":"是法本平等，无怠亦无敬。\n如何證无生，却来见参政。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟古","author":"吴思齐","text":"平原一遗老，九重未知名。\n临危观劲节，相视胆为惊。\n折陊犹举手，吁天闵无成。\n九陨期报国，万古犹光晶。\n亦有布衣人，烈烈死弥贞。\n回风惜往日，辉映岂独清。\n滔滔肉食辈，泚颡徒吞声。\n我闻同志士，野祭激高情。\n配享遗斯人，忧心每如酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南","author":"吴昭淑","text":"今夜永，说剑引杯长。\n坐拥地炉生石炭，灯前细雨好烧香。\n呵手理丝簧。\n君且住，烂醉又何妨。\n别后相思天万里，江南江北永相忘。\n真个断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天柱峰","author":"吴某","text":"孤峰斗绝矗云浮，俯视群山若蚁丘。\n倚住东南天一角，笑它芑国谩多忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟亭","author":"吴某","text":"苍崖决水下雷霆，掉尾蜿蜒不暂停。\n榜作翠蛟犹未称，不如唤作舞蛟亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云根石","author":"吴某","text":"白云触石起油然，倏忽从龙遍九天。\n多谢丰隆留一叶，至今遗迹在岩前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"吴某","text":"剪罗幡儿，斜插真珠髻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多丽","author":"吴某","text":"几声天外归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其一","author":"吴某","text":"楼台里、东风淡荡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其二","author":"吴某","text":"乍卷珠帘新燕入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲","author":"吴某","text":"鶗鴂一声初报晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柴门春昼","author":"吴柔胜","text":"深巷寂无人，鸟声花坞春。\n荜门长日掩，天地一闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送林明府","author":"吴柔胜","text":"拟续宣城志，难忘令尹贤。\n庭空无狱讼，斋静有诗篇。\n心比秋云远，政如霜月悬。\n活人最多处，饥岁作丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三友图","author":"吴柔胜","text":"髯龙嘶风山石裂，玉人影断横斜月。\n一声翠羽琅玕东，罗浮梦断微茫中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牧亭秋色","author":"吴柔胜","text":"丹枫酣霜压林丘，黄叶老尽岩西头。\n不应蔓草烟漠漠，并作粉绘苍山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐人挟弹图","author":"吴柔胜","text":"啮膝嘶风径奔駻，花前挟弹回头看。\n一鸟不鸣春昼闲，野水清清绿阴暗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游道岩","author":"吴栋","text":"玄都重到拂题尘，屈指于今十四春。\n白石烟消丹灶冷，苍崖日永画楼新。\n山中自笑黔驴技，天外谁知海鹤身。\n洞口桃花莫相笑，刘郎犹是少年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"吴洞明","text":"瘦尽红英绿已肥，杜鹃何事苦催归。\n未甘淑景堂堂去，更挈壶觞上翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章清隐山居","author":"吴洞明","text":"物外无寒暑，从教岁月深。\n虚閒浑属我，宠辱不惊心。\n贫乐知书味，诗豪借酒吟。\n山居何所有，万籁奏清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留春","author":"吴洞明","text":"柴门深闭莫嫌猜，为怕春归不敢开。\n几树好花风?去，一池新水雨添来。\n冥搜秀色增诗料，款挹晴光入酒杯。\n试问东君来复去，何如休去且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙人隐迹 其三","author":"吴洞明","text":"游人摩苍崖，满手闻异馨。\n不垂身后芳，何以知仙灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙人隐迹 其二","author":"吴洞明","text":"长生玄牝门，目击而道存。\n班班实可考，老涧生云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙人隐迹 其一","author":"吴洞明","text":"上古有神仙，一去无消息。\n峨峨碧岩前，独遗隐仙迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栏边","author":"吴济","text":"潮信栏边见，人家树杪分。\n笋鞭遮过蚁，蛛网碍飞蚊。\n松古藏灵药，山高落冷云。\n吾庐远城市，花草故欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野外即事","author":"吴济","text":"横木渡前溪，藤深路欲迷。\n瘦筇谙乱石，老屐带新泥。\n尽日绿阴合，有时黄鸟啼。\n多情双蛱蝶，飞傍帽檐低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲍家田","author":"吴济","text":"摇旆家家酒，收犁处处村。\n草深迷井口，槿密拥篱根。\n绿水明秧本，青山失烧痕。\n多应忌蚕事，畏客掩柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题甘露寺","author":"吴济","text":"云阙漏微照，长江得半明。\n心随帆影远，鸥似我身轻。\n今古几兴废，山川无变更。\n倚栏吟未断，拍拍又潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴","author":"吴济","text":"伤秋愁不断，邻杵已鸣霜。\n宝扇鸾收影，篘蚁带疏香。\n疏花停懒蝶，细草庇寒螀。\n落叶无人扫，庭空下夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颜孝子乌墓","author":"吴炯","text":"人伦风化自孝始，我怀义乌颜氏子。\n昔从书传闻其名，今来浙东入其里。\n未入里先见路碑，高冢巍然云树里。\n犹有群乌绕墓飞，或者神乌长不死。\n衔土伤吻土亦亦，乌血凝成墓山紫。\n今古人人皆有亲，负土葬者岂独此。\n如何感召到山禽，须就人心推物理。\n生前服劳情自苦，亡后附身哀靡已。\n天地悯怜鬼神泣，无知羽族有所使。\n父子茔域永相依，白云深处精灵起。\n风吹草卉即莱衣，溪浮蘋藻为甘旨。\n千秋万古此经过，谁人眼不泪如水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠刘羲仲","author":"吴炯","text":"束带真成屈壮图，宁思饱死叹侏儒。\n便拈手版还丞相，却觅芒鞋踏故庐。\n少日萦心但黄奶，暮年使鬼勾青奴。\n他时有客来载酒，解道欲眠卿去无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴炯","text":"谁知吾子汉棱粥，压倒东坡玉糁羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题徐熙牡丹图","author":"吴皇后","text":"吉祥亭下万年枝，看尽将开欲落时。\n却是双红有深意，故留春色缓人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题徐熙芍药","author":"吴皇后","text":"秾李夭桃扫地无，眼明惊见玉盘盂。\n扬州省识春风面，看尽群花总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"集君山","author":"吴竽","text":"生平豪气老难降，南北中分叹此江。\n多病能消山屐几，清游幸尾使旌双。\n天连远水碧千里，云护夕阳红半窗。\n缱绻主人留客意，船头昏鼓又逢逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东岩","author":"吴衍","text":"满壁云涛倚太空，双崖一线路微通。\n几年胜概埋荆棘，好事山翁始发蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟亭","author":"吴衍","text":"一峰擎天维，下有万斛水。\n委蛇到涧壑，遇坎亦不止。\n鸣鼍忽动地，涛怒生足底。\n得非坤轴裂，惊视坐为起。\n盆倾溅珠胎，鼎沸翻玉髓。\n长蛟躩连卷，救首复救尾。\n吾庐枕清浅，徙倚每自侈。\n及兹睹奇观，目眩颡有泚。\n便欲逃世纷，置身岩穴里。\n蓬瀛渺溟渤，对面不遗咫。\n嗟余闻道晚，今始忘仕已。\n重来三十年，恍若游故里。\n壮颜日凋瘁，浩志亦颓靡。\n载歌蜀仙诗，此老元不死。\n至今斯亭上，清风盈棐几。\n观水必观澜，是中存妙理。\n源泉何混混，有本故如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴觉","text":"燕颔英姿宜食肉，羊肠险韵宜剪茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠退斋同年贡举","author":"吴语溪","text":"看花携手鬓俱青，一转头来昨梦惊。\n四海同年今有几，相逢此日得无情。\n著书君已名千载，废学吾方悔半生。\n离合升沉何足计，相期进德是功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十三日灰池炎灼得混沌胚腪","author":"吴误","text":"灰池炎灼定浮沈，见了方知造化深。\n世上本来无此物，人间终是少知音。\n濛濛恍恍离宫本，杳杳冥冥坎户金。\n得一莫誇能事毕，要勤功行合天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月十八日开炉得先天铅因纪其实","author":"吴误","text":"配合阴阳法自然，得成此物号先天。\n妙中妙妙妙真妙，渊处渊渊渊又渊。\n下手工夫终百日，夺他造化几千年。\n从头细试渔庄录，方信神仙不浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书渔庄邂逅录卷末","author":"吴误","text":"丹中神水与华池，学者如麻悟者稀。\n但指气精为造化，岂知铅汞有深微。\n迷途到底生邪见，大道何人为指归。\n今日相逢皆宿契，与君容易泄天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义节夫人传 其一","author":"吴说","text":"国步阽危古所稀，旷无仗节不胜讥。\n得夫人辈戡多难，拨乱兴衰亦庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]