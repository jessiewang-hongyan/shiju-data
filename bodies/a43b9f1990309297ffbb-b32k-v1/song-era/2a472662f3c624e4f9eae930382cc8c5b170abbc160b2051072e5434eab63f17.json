[{"title":"偈颂七首 其二","author":"释南雅","text":"百岁光阴弹指顷，万缘休处是良谋。\n文章盖世今何在，到了还归土一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真觉禅师","author":"释南雅","text":"德山棒下桶底脱，又被岩头轰一喝。\n悬崖万丈放全身，松山撑破秋空月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释南雅","text":"紫蕨伸拳笋破梢，杨花飞尽绿阴交。\n分明西祖单传句，黄栗留鸣燕语巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释南雅","text":"大机贵直截，大用贵顿发。\n纵有啮镞机，一锤须打杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒守净禅师","author":"黄公度","text":"十方同聚会，个个学无为。\n此是选佛场，心空及第归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其六","author":"释南雅","text":"去年今月正今日，北高峰前，冷泉亭畔。\n悬羊头，卖狗肉，秤头斤两惜如玉。\n几多高价来相酬，尽力相酬酬不足。\n今年今日正今时，竹山顶上，栖风亭边。\n饥即餐，困即眠，石头为枕草为毡。\n永日萧然无个事，白云深处不朝天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其五","author":"释南雅","text":"瞎驴灭却正法眼，临济宗风始大张。\n的的单传至今日，绳绳不断愈光扬。\n有价数，没商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其三","author":"释南雅","text":"生而无生，一片浮云点太清。\n灭而无灭，万里寒空沈晓月。\n个些儿，佛不知，拟心栖处隔山迷。\n直饶不拟栖心处，犹落吾家第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七首 其一","author":"释南雅","text":"葛陂化杖谁为力，陶壁飞梭事有因。\n好是风云相际会，峥嵘头角自惊群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和无著赞大慧齿发舍利","author":"释咸杰","text":"背触全提话已圆，孤风凛凛播皇天。\n无端更把闲毛齿，惹得丛林口耳传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"径山出乡舟中寄二偈示众 其一","author":"释咸杰","text":"三冬水上打鞦韆，百尺竿头棹钓船。\n寄语满堂龙象众，无劳掘地觅青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送权维那归道场","author":"释咸杰","text":"风搅平林万木秋，临歧送别思悠悠。\n也知八德池中水，不比寻常溪涧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送昂维那出岭兼呈应庵 其二","author":"释咸杰","text":"云黄山下老禅庵，凌蔑宗风罪过多。\n君若到门深问讯，看渠伎俩复如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送珣禅人还海坛","author":"释咸杰","text":"家乡到日许谁知，默默相逢绝路岐。\n莫谓海门风浪恶，干戈元是太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送雪峰化主","author":"释咸杰","text":"手托庵门便放憨，千钧重担要人担。\n寥寥坐断孤峰顶，云衲相从昼夜参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送聪首座兼简陈寺丞","author":"释咸杰","text":"十载相从话岁寒，刀山剑树惯跻攀。\n风云会合机轮转，行看知音笑展颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其十一","author":"释咸杰","text":"屋里贩扬州，水深山更幽。\n终年无客到，明月自相投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其十","author":"释咸杰","text":"百战场中舞纛旗，将军立处十分危。\n游人只看锥头利，失却吹毛总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其九","author":"释咸杰","text":"天高地厚人难见，海阔山遥只自知。\n勘破却回休借问，得便宜是落便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其八","author":"释咸杰","text":"大海波涛阔，千峰气象雄。\n古今无间断，南北路头通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其七","author":"释咸杰","text":"西江一吸了无馀，突出堂堂大丈夫。\n尽道世间胡须赤，须知更有赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其四","author":"释咸杰","text":"粥了令教洗钵盂，铁船无底要人扶。\n片帆高挂乘风便，截海须还大丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其二","author":"释咸杰","text":"狗子无佛性，杀人便偿命。\n楚痛百千般，因邪却打正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其六","author":"释咸杰","text":"有问冬来事，京师出大黄。\n贪他一粒粟，失却半年粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其五","author":"释咸杰","text":"腊月莲花菡萏香，三回赏手不寻常。\n直饶会得须眉落，早是龟毛数丈长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其三","author":"释咸杰","text":"一桡劈脑没遮拦，大海波涛彻底乾。\n尽谓单传并直指，谁知总被祖师谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其二","author":"释咸杰","text":"贤圣法来未曾杀，而今断这一刀休。\n果然葛怛胸中落，笑杀灵山老比丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其一","author":"释咸杰","text":"三处移场定是非，顽心全不改毫釐。\n胡言汉语凭谁会，铁额铜头也皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十三","author":"释咸杰","text":"二千年前旧公案，今日拈来重剖判。\n任是铁眼与铜睛，也须更入红炉煅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十一","author":"释咸杰","text":"四年居此日波波，累及禅和不奈何。\n今感圣恩林下去，一轮秋月照天河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十七","author":"释咸杰","text":"只此见闻非见闻，无馀声色可呈君。\n个中若了元无事，体用何妨分不分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十","author":"释咸杰","text":"虎骤龙骧与么来，蓦然平地起风雷。\n棒头正眼明如日，凛凛清风廓九垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十七","author":"释咸杰","text":"修造未逾两个月，丛林便觉日荒凉。\n今朝重整旧洪范，铁佛须教尽放光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十五","author":"释咸杰","text":"昔年相见谈真谛，今日升堂话去来。\n一念廓然无向背，春光铁树自花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其四十四","author":"释咸杰","text":"吞却与吐却，算来无处著。\n要见滑稽人，便是黄幡绰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十八","author":"释咸杰","text":"辅弼宗门有老成，一番提掇一番新。\n咬姜呷醋知咸淡，便是丛林过量人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十三","author":"释咸杰","text":"莫除荆棘建伽蓝，七佛常来此处参。\n地久天长功不坠，天花时复雨毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其三十一","author":"释咸杰","text":"方脱钟山阶级难，却来遮里养残躯。\n那知踪迹难遮掩，又见驱驰走使符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其十一","author":"释咸杰","text":"一叶飘空万木秋，翻思光境急川流。\n若人识得其中意，坐断千差向上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其八","author":"释咸杰","text":"云开千嶂出，木落一枝分。\n相见又无事，不来还忆君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五","author":"释咸杰","text":"幽禽噪破那伽定，便见文星入寺来。\n倒屣门迎开笑面，林泉陡觉起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其九十","author":"释祖钦","text":"有物先天地，无形本寂寥。\n能为万象主，不逐四时凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四首 其四","author":"释咸杰","text":"一年三百六十日，今宵正是结交头。\n移身换步无多子，六合清风来未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送拙庵住洪福","author":"释咸杰","text":"瞎驴生得瞎驴儿，龌龊声名彻四维。\n更把少林无孔笛，逢人应是逆风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠闽清黄释褐初赴上庠","author":"释咸杰","text":"蓦劄相逢笑脸开，也知平地起风雷。\n好将一滴梅溪水，为雨为霖遍九垓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祥符建僧堂周都料求颂","author":"释咸杰","text":"妙处如何论浅深，应之于手得于心。\n方圆不用机谋力，长短休将语默寻。\n一斧便成真活计，三思始就费光阴。\n山僧直截重重说，须信真鍮不博金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送如水头","author":"释咸杰","text":"如如方解说，此说若为通。\n戳瞎摩醯眼，掀翻宇宙空。\n枯柴聊作用，活火展家风。\n去去休言别，智音一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示智悟道人","author":"释咸杰","text":"智悟悟自心，不在一切处。\n回首时观瞻，便是佛国土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示曾秘校","author":"释咸杰","text":"天童得力句，不摇三寸舌。\n父母未生前，令已行摩竭。\n直下便承当，敢保犹未彻。\n放下百不知，脑门重著楔。\n唯是过量人，一拳无二说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"约斋张直阁画师顶相请赞","author":"释咸杰","text":"挨开不二门，千圣须却步。\n直下便承当，略通一线路。\n佛也不奈何，谁敢当头道。\n道著头角生，一点黑如皂。\n尽情分付约齐大居士，一等人间任扬播。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛日常长老请赞","author":"释咸杰","text":"赤手全提，金圈栗棘。\n跳出三要三玄，破荡佛祖窠窟。\n试问有何神通，尽力吐露不出。\n咄咄，佛日长老，与么拈出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张直阁请升座末后说偈","author":"释咸杰","text":"一句全提法界宽，大千收拾掌中观。\n横该竖抹超三际，迦叶徒劳强破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和璧书记","author":"释咸杰","text":"掷剑挥空不住空，空轮无迹剑无锋。\n无锋无迹凭谁会，会得金沙堕眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"径山出乡舟中寄二偈示众 其二","author":"释咸杰","text":"大丈夫儿合自知，得便宜是落便宜。\n无心用处急回首，莫待天明失却鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"径山茶汤会首求颂二首 其二","author":"释咸杰","text":"有智大丈夫，发心贵真实。\n心真万法空，处处无踪迹。\n所谓大空王，显不思议力。\n况复念世间，来者正疲极。\n一茶一汤功德香，普令信者从兹入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇太子妃请就径山升座末后说偈","author":"释咸杰","text":"佛身无为，不堕诸数。\n随机示现，应无所住。\n如月行空，光照寰宇。\n廓彻信心，庄严福聚。\n记得先贤曾有言，皇天无亲，唯德是辅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送先知客","author":"释咸杰","text":"万里南来川藞苴，奔流度刃扣玄关。\n顶门戳瞎金刚眼，去住还同珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送昂维那出岭兼呈应庵 其一","author":"释咸杰","text":"福城得得来相访，象骨岩前话别时。\n惊起石人开铁眼，倚筇遥听老猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送恢侍者","author":"释咸杰","text":"戴角擎头与么来，当机一拶顶门开。\n行行勿谓无知己，阃外威权善自裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送璘首座住定水","author":"释咸杰","text":"一棒一条痕，一掴一掌血。\n不是向上机关，亦非单传妙诀。\n佛祖见之攒眉，魔外闻之胆折。\n建立此纲宗，当阳贵直截。\n璘侍吾十年，气宇迥超绝。\n信手斫方圆，初不泥唇舌。\n青天霹雳轰，风云会时节。\n行看定水起波涛，始信来源出处高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送慧知客还蜀","author":"释咸杰","text":"踏破剑门关，十方无壁落。\n信步复南来，将错还就错。\n霜风刮面寒，梅梢初破萼。\n去去又何言，宁负孤云约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真际道人请赞","author":"释咸杰","text":"一句全提，了无向背。\n临济正宗，恣意破碎。\n弥天过犯，不容忏悔。\n丹青画出向人前，他家自有通人爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其六","author":"释咸杰","text":"五百生前失却，五百生后太错。\n错错，谁道祥麟只一角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其五","author":"释咸杰","text":"一顿浑家尽灭门，更加两顿累儿孙。\n银山铁壁俱穿透，万里无云宇宙分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其三","author":"释咸杰","text":"出得何如未出时，瞎驴成队丧全机。\n而今四海平如砥，芦管迎风撩乱吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十一首 其一","author":"释咸杰","text":"斫却月中桂，清光转更多。\n狐狸俱屏迹，狮子奋金毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其四","author":"释咸杰","text":"蓦就膏肓打一针，当时无处著浑身。\n呵呵笑入严阳去，蛇虎为邻不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其九","author":"释咸杰","text":"今朝六月十五，祝圣升堂击鼓。\n木童火里吹笙，石女云中作舞。\n也大奇，也大奇，天无四壁，地绝八维。\n五湖四海来入贡，衲僧闻见眼如眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十五","author":"释咸杰","text":"日日是好日，时时是好时。\n惟有十月二十二，吉星垂照最希奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十四","author":"释咸杰","text":"居于富贵中，不为富贵误。\n赤手挨开解脱门，四方八面俱独步。\n佛祖不知由，凭谁立本据。\n咄咄咄，力叻希，闻见觉知齐合掌，铁牛生得凤凰儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十二","author":"释咸杰","text":"去年八月间，得旨与安闲。\n摆动水云性，纵步到阳山。\n元宅诸子弟，忻然力追攀。\n庵居三个月，开怀宇宙宽。\n忽接四明信，来书意盘桓。\n天童虚法席，使君语犹端。\n迢迢遣专使，不问路行难。\n山僧临晚景，不敢自相瞒。\n搥鼓乐与行，四众亦欣欢。\n先师未了底，应是起波澜。\n一回饮水一回噎，临济德山俱汗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其六十","author":"释咸杰","text":"一个葫芦才倒地，满地葫芦尽倾倒。\n欲识单传直指禅，今日斗凑得恰好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十九","author":"释咸杰","text":"达磨不来东土，二祖不往西天。\n石室行者蹈碓忘却移步，玄沙讨鱼卖峭蹈翻钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十五首 其五十八","author":"释咸杰","text":"即心即佛也揖出，非心非佛也揖出。\n地转天回岂等闲，即知此物非他物。\n以此显追崇，决定当超越。\n次回阴骘保家堂，自然福寿永无双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]