[{"title":"顺昌即事","author":"白玉蟾","text":"笔下千机锦，胸中一滴金。\n乾坤春瓮阔，风月夜楼深。\n世绝夫君操，人谁梁父吟。\n只寻云外路，谁复听寒砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倪敬父柯山","author":"白玉蟾","text":"暮云横翠夕阳斜，啼罢歌楼林外鸦。\n绿竹弄摇风里影，碧桃开遍雨中花。\n三杯淡酒邀明月，一局残棋惊落霞。\n人在柯山山上咏，笑挥管笔走生蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏五即事 其一","author":"白玉蟾","text":"惊心节物读齐谐，迎面南风汎歜杯。\n池畔雨荒灵运草，庭前云酿洞宾槐。\n藕丝冰水敌时暑，臂綵钗符付女孩。\n遐想湘沅歌楚些，兰魂桂魄不归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜宿水馆","author":"白玉蟾","text":"松脂明灭已更寒，蛙市无声万籁沉。\n千里清风孤馆梦，一轮明月故人心。\n欲眠还醒推藤枕，骤热仍寒弄楮衾。\n搔首起来顾清影，断烟低锁荻花林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上偶成呈主簿兄","author":"白玉蟾","text":"原气推宗分不疏，一相思一检舆图。\n三生骨肉几回别，万里音书半字无。\n风雨每思君对榻，江湖长只影为徒。\n春城烟锁南台暮，两地襟情片月孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悟空寺","author":"白玉蟾","text":"迷则僧祇悟刹那，遍将此事勘禅和。\n春深未解桃花旨，日永其如燕语何。\n晓殿冷凝山色重，夜楼阔占月华多。\n西来祖意凭谁委，只有门前窣堵波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽知宫王月谷三章 其三","author":"白玉蟾","text":"去年五月访丹元，月谷先生与我言。\n将谓此生共茅舍，不知何事速云轩。\n亲书数卷空悬壁，旧隐三间半掩门。\n雪魄冰魂无处觅，秋烟秋雨暗孤村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣药禽","author":"白玉蟾","text":"灵禽悲噪白云边，人到天台古洞天。\n点化春愁三月暮，唤回晓梦五更前。\n有如捣药洒泪响，非杵非舂自戛然。\n毛羽也知仙可学，声声要结炼丹缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栩庵以冰字韵求大风诗口占","author":"白玉蟾","text":"山高万籁作秋声，六月胡床冷似冰。\n浩浩拍窗人不寐，飕飕到枕梦难成。\n掀开云幕飞苍絮，推出蟾轮碾素璚。\n幸有许多闲气力，何如吹我上瑶京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源祠","author":"白玉蟾","text":"因访翟仙傍柳隈，不堪风景把人推。\n松杉十丈入斤斧，夏屋数间俱劫灰。\n道士潜心隐丹灶，儿童劝我举霞杯。\n谁知自有长生诀，独步白云归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏山书怀","author":"白玉蟾","text":"桐柏山头避俗嚣，篇诗斗酒自逍遥。\n九峰野草迷丹灶，三井飞泉喷石桥。\n万顷白云蒸绿野，一声黄鹤唳青霄。\n人言华顶高高处，东望蓬莱浸海潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐柏观留别","author":"白玉蟾","text":"身落天台古洞天，蒲团未暖又飘然。\n如何庵不琼台地，想是吾非桐柏仙。\n无复得餐三井水，未曾深结九峰缘。\n杖头挑月下山去，空使寒猿啸晓烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泰定庵","author":"白玉蟾","text":"太极函三性，千灯共一光。\n猿啼庐阜月，雁叫洞庭霜。\n夜半冰生水，风前麝出囊。\n吾师知个事，念念守中黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海丰道中","author":"白玉蟾","text":"海近疑无地，山长尽有天。\n蛇岗岚雾湿，鱼市水风膻。\n苔色陪岩草，榕阴冒浦莲。\n由来金翠盛，遮莫酌贪泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别铁柱宫叶法师","author":"白玉蟾","text":"不嫌来往日诗筒，春兴无穷我欲东。\n一雨放行三尺水，万松回纳半帆风。\n且将南浦难题景，寄在西山绝顶峰。\n柳处酒家花处寺，并留他日款游从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别鹤林诸友","author":"白玉蟾","text":"千林凉叶颤秋声，前庭后庭新月明。\n聚头举酒固自乐，秉烛游园聊适情。\n此去寒衾仙骨冷，可堪清夜泪珠倾。\n人生聚散浑无据，相约同游白玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绣香亭招饮","author":"白玉蟾","text":"海棠开后雨冥绵，寒食清明又一年。\n胜赏挨排三月朔，嫩晴将息百花天。\n水光山色供图障，燕语莺声助管弦。\n我自吟边闲拄颊，笑人陌上拾花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"轿中","author":"白玉蟾","text":"红轮荏苒向西颓，笋乘鸱蹲手拄腮。\n摇兀形神生睡思，按行水石得诗媒。\n山光走向檐前拱，溪响飞从闼畔来。\n遥见青山如雪白，心知个是数枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪王仙卿登楼","author":"白玉蟾","text":"身在烟霞缥缈间，此心已学白云閒。\n遣怀把酒自酌月，无事捲帘常看山。\n老去棋冤休死战，年来诗债逐时还。\n于今养鹤多栽竹，缚住时光且驻颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪庄岁寒夜坐小酌","author":"白玉蟾","text":"偶然气分颇相同，道院新移喜毕工。\n坐把诗吟中夜月，笑将酒洒一窗风。\n博山香篆浮青蚓，古壁灯光吐玉虫。\n君已酕醄吾酩酊，化为蝴蝶入槐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"假山","author":"白玉蟾","text":"一林幽竹几时栽，怪石花砖砌绿苔。\n羽客游岩乘雨至，仙翁采药破云来。\n天台犹在眉毛耸，雁荡依然眼睫开。\n昨夜摘珠人报道，海中失却小蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"白玉蟾","text":"倚蓬小立拂征衣，沙上渔翁理钓丝。\n举世更谁闲似我，只今何事未如伊。\n莫将水动疑天动，且道舟移是岸移。\n家在神霄归未得，钓周钓汉笑人痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄苏侍郎","author":"白玉蟾","text":"往古来今如换肩，我疑公便是坡仙。\n满城都没个伯乐，一日可能无乐天。\n方且论文俄判袂，不知握手又何年。\n忽然铁笛一声响，响到金华古洞边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郑天谷","author":"白玉蟾","text":"况此三晴二雨天，孤村寒绾缠苍烟。\n客来长是有蝴蝶，春去不堪闻杜鹃。\n汉蕨可羹今已晚，胡麻未饭必须仙。\n九江城里郑天谷，许结焚香瀹茗缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄泉州□侍郎","author":"白玉蟾","text":"海山迢递信音稀，静对斜阳独倚扉。\n回首八千馀里路，觉今二十一年非。\n白云流水聊相伴，绛阙清都未得归。\n昨夜乐丘残梦觉，窗前明月照鹑衣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄桂隐","author":"白玉蟾","text":"指点篇书说向谁，武侯之后独公奇。\n许瓢却大尧天小，严濑应高汉座卑。\n夙世已偿霖雨债，我身今结水云知。\n何人桂树中间隐，莫作南阳一睡骊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得鹤林书","author":"白玉蟾","text":"东望吾彭耜，晴窗坠一蛛。\n万金何足抵，尺纸寄来迂。\n夜后灯花喜，朝来鹊语符。\n手中舒复卷，久别可长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悠然堂","author":"白玉蟾","text":"一池寒碧浸红鳞，芍药方花春后春。\n烟阁晓垂天幕静，风帘夜上月钩新。\n闲云流水无穷意，绛阙清都被谪身。\n不向悠然堂上饮，篇诗斗酒付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"白玉蟾","text":"损之又损玉精神，松竹新来渐卜邻。\n月夜一枝香暗度，溪楼数点影横陈。\n直须何逊为知己，始信张良似妇人。\n从此东风还入手，管教桃李十分春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花二首寄呈彭吏部 其一","author":"白玉蟾","text":"一自花光为写真，至今冷落水之滨。\n惟三更月其知己，此一瓣香专为春。\n清所以清冰骨格，损之又损玉精神。\n雪中好与谁为伴，只有竹如君子人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花二首寄呈彭吏部 其二","author":"白玉蟾","text":"冰玉丰姿不可双，霜前雪后想凄凉。\n绝怜夜气浑如水，而况笛声堪断肠。\n以月照之偏自瘦，无人知处忽然香。\n从今桃李皆门士，谁道花中有孟尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅窗","author":"白玉蟾","text":"南窗屋数楹，一点阳和生。\n枝上雪妆瘦，墙头风作清。\n霜天酒自暖，月夜梦难成。\n何处人吹笛，黄昏送几声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中得五十六字","author":"白玉蟾","text":"醉醒曳杖访松关，正在黄昏杳霭间。\n既去复来秋后暑，似无还有雨中山。\n涧边几叶晚花落，天际一钩明月弯。\n自觉馀烟埋屐齿，行行印破藓痕班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淡庵倪清父","author":"白玉蟾","text":"地僻人闲春昼长，了然物我两相忘。\n薄披明月归诗肆，细切清风入醉乡。\n蜡味溪山闲里嚼，齑羹松竹静中尝。\n把琴弹破世间事，净几明窗一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清听堂","author":"白玉蟾","text":"白龙过涧玉琮琤，涧外松声击戛鸣。\n烟锁檐牙春二月，月移帘额夜三更。\n琴弹白雪阳春调，曲转高山流水声。\n清听堂中杳无梦，我将乘兴跨长鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明","author":"白玉蟾","text":"新除小垒燕方谋，又拜晴蜂万户侯。\n占破清明三五日，实封芍药一千头。\n花间作梦碧蝴蝶，柳外谈禅黄栗留。\n物物是题吟不尽，却烦酒作钓诗钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清贫轩","author":"白玉蟾","text":"一味逍遥不管天，日高丈五尚闲眠。\n溪鱼村酒别般味，野蔌山肴不用钱。\n瓮牖荜门关小径，乾柴白米煮清泉。\n有时拄杖青松畔，便是人间快活仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒雩都灵济大师","author":"白玉蟾","text":"雪里僧伽已寂然，不知香火几何年。\n殷勤琢雪雕冰语，忏悔嘲风弄月愆。\n林壑烟霞容有分，庙堂钟鼎得无缘。\n天池旧拜金灯了，却裹兜罗一袖绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒鹅湖大义禅师","author":"白玉蟾","text":"古塔寒龛几岁华，粥鱼斋鼓响岩丫。\n满湖春水浸明月，一带晚山横彩霞。\n石鹿至今空卧草，金鹅终不再衔花。\n寥寥此意无人委，欲界无禅果是耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄刑部仓部陈宗博招饮","author":"白玉蟾","text":"暇日联镳共暑鏖，冰吾瓜李雪吾醪。\n楼前一水佳人士，眼底千山儿女曹。\n朝士西湖正絺绤，将军北塞更弓刀。\n道人万丈英雄气，不信胥台便是高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄岩舟中","author":"白玉蟾","text":"满船明月浸虚空，绿净无痕夜气浓。\n诗思浮沉樯影里，梦魂摇曳橹声中。\n星辰冷落碧潭水，鸿雁悲鸣白蓼风。\n一点渔灯依古岸，断桥垂露滴梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"博罗县驿","author":"白玉蟾","text":"虎啸月生海，猿啼风撼山。\n梦回三鼓尽，身自九天还。\n云气浮窗外，泉声入枕间。\n问心宜富贵，为复要清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓息庵送春","author":"白玉蟾","text":"笔下自然诗料饱，天工饤出好山溪。\n鱼知水暖不胜跃，莺见花飞只管啼。\n树头鸠使妇唤雨，屋后竹教孙出泥。\n太白十杯人酕?，碧桃洞口日衔西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悲秋","author":"白玉蟾","text":"庭皋一叶夜来秋，拍塞乾坤爽气浮。\n有客放船芳草渡，何人吹笛夕阳楼。\n鲈鱼莼菜季鹰兴，鸿雁芦花宋玉愁。\n碧水映天天映水，淡云如幕月如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景泰山送友人","author":"白玉蟾","text":"白云影里话三生，起坐相从夜共行。\n谊与云天高也薄，道于泰华重邪轻。\n酒非贪饮惟知己，诗不求工贵适情。\n但使忘年成莫逆，何须肉袒负渠荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景泰晚眺","author":"白玉蟾","text":"海岸孤绝处，晴沙露远汀。\n潮花人鬓白，山色佛头青。\n夕照雌黄笔，秋烟水墨屏。\n天空杉月冷，鹤梦几回醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暂别游德声监税","author":"白玉蟾","text":"风樯小舣水中央，接袖交肩话柄长。\n贷粟庄周轻得失，倚楼杜甫重行藏。\n情知此去无多远，未别一声先断肠。\n排办新诗消遣酒，高吟大笑渡番阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑夕有怀","author":"白玉蟾","text":"幽人避暑海城西，西北浮屠尽得栖。\n更漏有无风逆顺，纸窗明暗月高低。\n石泉未到秋先冷，野虎偏从夜即嘶。\n记得去年常德府，武陵今夕况桃溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山","author":"白玉蟾","text":"庐山山下倒芳樽，八九人家烟水村。\n千尺云崖春上藓，几重月树夜啼猿。\n人骑黄鹤去不返，草没丹炉今尚存。\n携子高歌醉归去，一溪寒碧绕山根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翛然轩","author":"白玉蟾","text":"不著人间一点尘，翛然一室贮幽人。\n清宵瓮下酒中圣，白昼笔头诗泣神。\n芳草惜锄怜绿净，落花慵扫爱红匀。\n棋声隔断华胥路，自把博山烧暮春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢鹤林见访","author":"白玉蟾","text":"我方一枕午风眠，君正然香未解船。\n知问无为三不答，广咨王母几寥然。\n分明翠竹黄花意，何必红铅黑汞篇。\n寄语鹤林老居士，甚时叱鹤过西川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋月同鹤林酌别奉似紫琼友","author":"白玉蟾","text":"婀娜姮娥处玉宫，秋来梳洗越当空。\n阴晴圆缺天何意，离合悲欢事与同。\n好去画楼歌舞地，莫来清馆别愁中。\n应知人不能如月，月且团圆月月逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋诗二首呈懒翁 其一","author":"白玉蟾","text":"惊秋镜里鬓边星，到处溪山皆洞庭。\n怒雨打莲攲沼绿，颠风掣竹过墙青。\n趁船紫燕辞芹渚，缩颈白鸥眠蓼汀。\n荷笠欲寻懒翁去，带些爽气入疏棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋梅奉呈陈太博","author":"白玉蟾","text":"霜清木脱嫩寒森，惊见孤英吐竹林。\n不负雪期如有信，偶先春事本无心。\n月横瘦影池塘浅，风递微香院落深。\n莫问调羹并止渴，枝枝且惬醉来簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感物","author":"白玉蟾","text":"月生看柳瘿，风起笑花痫。\n事业三杯酒，勋名九转丹。\n神凄身外蝶，梦黯镜中鸾。\n为问金堪带，如何玉可餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"携友生诣桐柏","author":"白玉蟾","text":"篮舆过尽几山丫，夜宿天台仙子家。\n我昔岩前种芝草，尔来云表饭胡麻。\n金前错落枫犹叶，玉靥飘零菊更花。\n霜露逼人心兴倦，无穷旧事散天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡起","author":"白玉蟾","text":"眼瞌蚊方谒，灯微蛾更来。\n汗珠流似雨，鼻息响如雷。\n蝶魄游仙去，猿声惊梦回。\n梦回嫌簟湿，怒把枕头推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓝琴士赠梅竹酬以诗","author":"白玉蟾","text":"手补天工笔法奇，笑将造化作儿嬉。\n胸中夜雨浇龙干，纸上春风舞玉蕤。\n云水一生无别好，琴心三叠有谁知。\n今宵松殿相期会，弹到西山月落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬蒋知观所惠诗","author":"白玉蟾","text":"新雁飞来一朵云，读之毛骨耸寒鳞。\n展开大句几钩墨，存想先生满面春。\n榻上宾朋谈盛德，山中冠褐混凡身。\n来朝盥手炷香去，恐是蓬莱相识人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"靖通庵","author":"白玉蟾","text":"靖通庵外锁晴云，壁瑩飞琼瓦叠鳞。\n野鸟无心一声晓，岩花有意四时春。\n凿开风月长生地，占断烟霞不老身。\n虚靖当年仙去后，不知丹诀付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉定甲申闰月五日闻皇帝升遐","author":"白玉蟾","text":"唳鹤啼猿怨满怀，烟葵露槿泪盈腮。\n一钩桂月千林黯，半夜松风万壑哀。\n不御六龙昌宝祚，遽骖八骏驻瑶台。\n小臣泉石膏肓了，无任冰肝玉胆摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮抵懒翁斋醉吟","author":"白玉蟾","text":"旋开白酒买莲房，满泻桐膏炤玉缸。\n月女冷窥青斗帐，风神轻撼碧纱窗。\n公疑我是今皇甫，我恐公为昔老庞。\n醉后唾珠粘纸面，笑将笔力与人扛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"演教堂","author":"白玉蟾","text":"洞霄大涤扈神京，玉佩金珰会百灵。\n天柱一尖凌碧落，云关九锁叠苍屏。\n前峰后峰烟漠漠，东洞西洞风泠泠。\n见说坡仙诗墨在，约君同坐翠蛟亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潮阳谒灵山大颠禅师","author":"白玉蟾","text":"天地神祇不可诬，小人君子费分疏。\n我无其事初何恤，自揆于心或未如。\n岂是大颠留乃服，只闻刺史造吾庐。\n谁能脱略形骸外，孟简尚书谩寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中赋别","author":"白玉蟾","text":"话别应知太去匆，明朝马首定东风。\n镜中人瘦如花瘦，湖上春浓似酒浓。\n行色已如天色好，道情不与世情同。\n如今老眼浑无泪，醉颈当筵似玉虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]