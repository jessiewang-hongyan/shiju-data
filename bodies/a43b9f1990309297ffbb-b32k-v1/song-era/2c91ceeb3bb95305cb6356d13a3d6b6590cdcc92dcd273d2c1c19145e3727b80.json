[{"title":"次江文韵 其五","author":"许景衡","text":"平生有志慕前修，叹息因循渐白头。\n端向岁寒看松柏，始知凡木不禁秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温岭界上","author":"许景衡","text":"岭北无端去抱关，岭旁便是旧家山。\n回头试觅归时路，只在行人顷步间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪桥","author":"许景衡","text":"去去来来今几秋，霜毛渐渐满人头。\n束书匣剑平生事，斜日江山独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归自滨州","author":"许景衡","text":"扶疏弱柳绿初匀，哑咤黄鹂语未真。\n行路逢春浑不觉，却须说似探花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马首石诗","author":"许景衡","text":"世俗亦知千里远，却将凡马被雕鞍。\n何人欲识真龙种，好向岩头子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱深明 其一","author":"许景衡","text":"曾陪杖屦古荆州，十载光阴一转头。\n扰扰红尘长满眼，峨峨三岘独横秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱深明 其二","author":"许景衡","text":"当年一笑得英游，共吊沉碑汉水头。\n回首鹿门高遁去，人间姓字亦千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠江左司","author":"许景衡","text":"先生见告汉江上，居士归从庾岭头。\n白日火珠无玷翳，閒花野草是春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和经臣阁上思彦章","author":"许景衡","text":"登赏犹欣诗友俱，不知赵子更来无。\n暮天好处须同赋，乞与人间作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和江左司","author":"许景衡","text":"新麦纷纷落硙时，旋看片片作银丝。\n先生自足醍醐味，恻隐犹怜稚子饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖夜归口占送李泰发","author":"许景衡","text":"山上徜徉湖上归，月明千顷浸玻瓈。\n明朝有客朝天去，多少红尘在马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戴浚秀才需堂","author":"许景衡","text":"客到需堂日已曛，从容樽酒话情亲。\n欲来却去知何事，笑杀当年访戴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清陂堂 其一","author":"许景衡","text":"簿领他年解印归，尚怜江上子鱼肥。\n扁舟不学鸱夷子，只要清陂作钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清陂堂 其二","author":"许景衡","text":"午枕攲时睡思迟，含风百顷碧琉璃。\n人生适意当如许，莫遣尘埃外客知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清陂堂 其三","author":"许景衡","text":"取次题诗留屋壁，从他传唱落渔家。\n禅翁好事还堪笑，枉却青青一尺纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过吴子厚和酬杨时可壁间新句","author":"许景衡","text":"主人还往多佳客，小阁逢迎不计时。\n蘸甲一杯梅福醉，挥毫半壁子云诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题紫膏院壁","author":"许景衡","text":"雪消溪谷已含春，雷动枪旗一簇新。\n解道人间最仙景，风流无复杜陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望湖楼示世厚","author":"许景衡","text":"楼头满眼是湖山，瑟瑟清风燕坐间。\n三伏长涂走尘土，他年记取此时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄卢中甫四首 其一","author":"许景衡","text":"霜风猎猎动旌旄，月落天低锦帐高。\n旋放洮河三尺水，洗磨十万血腥刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄卢中甫四首 其二","author":"许景衡","text":"九月都门风薄衣，夜砧声里雁南飞。\n野人不识长安乐，且趁鲈鱼一棹归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄卢中甫四首 其三","author":"许景衡","text":"朝米暮盐何日休，尘埃满面霜满头。\n草堂竹阁压秋水，几时和月弄扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄卢中甫四首 其四","author":"许景衡","text":"制胜关头雪未融，崆峒山下又春风。\n此身不及泾川水，漾絮飘花日向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄笔墨纸兄长绝句三首 其一","author":"许景衡","text":"最怜修贡自峨岷，拜赐中天雨露新。\n好为先生载嘉句，却愁纸价涌京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄笔墨纸兄长绝句三首 其二","author":"许景衡","text":"潘生地下骨应朽，妙技犹藏天府中。\n刀笔未应当好赐，不如分付与诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄笔墨纸兄长绝句三首 其三","author":"许景衡","text":"刑名去取漫忉忉，惭愧官家五色毫。\n老矣弟兄无用处，只应警锐属儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寸碧亭","author":"许景衡","text":"杖履寻常行乐处，不论小径与幽亭。\n谁知苍莽千峰外，尚有仙山一点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江","author":"许景衡","text":"江边问舟子，潮落几时回。\n野店无灯火，还须明月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"繁叔见和再依韵谢之 其一","author":"许景衡","text":"曾录新诗数百章，简编从此有辉光。\n当年俱是江边客，今日早为天上郎。\n竹叶一樽鱼似玉，梅花三弄月如霜。\n边城乐事还随分，莫教终朝有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"繁叔见和再依韵谢之 其二","author":"许景衡","text":"分明喜色满眉间，谁怕霜毛作老颜。\n况有杯盘留客醉，不教风雨为人悭。\n子真最爱横塘水，居士新迁巾子山。\n唯有诗坛小工部，吾君未可放教闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鉴湖","author":"许景衡","text":"贺老旧时宅，平湖照眼明。\n鱼虾无远近，菱芡自生成。\n历历疑犹见，纷纷尽肆耕。\n斯民日牢落，无路问鱼并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅花三绝 其一","author":"许景衡","text":"园林飒飒正飞沙，欻见东风第一花。\n画里有诗还会么，分明竹外一枝斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅花三绝 其二","author":"许景衡","text":"柔条乱蕊照人寒，多少冰姿在笔端。\n迥出暗香疏影外，诗人莫作一般看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅花三绝 其三","author":"许景衡","text":"冰茧连槽无点翳，忽惊雪片满寒枝。\n须知造物生成处，也似毫端拂淡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先兄旧作梅花觅张先生画因览之怆然辄次其韵","author":"许景衡","text":"茂陵雪片追方好，乱点铅华却不宜。\n多少人间春色在，未有写尽向南枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示师言民表","author":"许景衡","text":"二子追凉古寺东，阴阴绿叶散清风。\n荜门蜗舍日亭午，试问此风同不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张帅进职再留敏叔有诗贺之次韵","author":"许景衡","text":"忆昔初辞九棘班，齐坛授钱气桓桓。\n边民惯见平安火，天子新除侍从官。\n此去一年聊许借，从来五裤不愁寒。\n进贤自是平生志，看取他年头上冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"论学","author":"许景衡","text":"咨尔学者，学古之道。\n惟古善教，有伦有要。\n其学维何，致知格物。\n对身而诚，物我为一。\n匪曰我私，推之斯行。\n亲亲长长，而天下平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铭刘安节墓","author":"许景衡","text":"温温刘子其美璞，斯文有传与敦琢。\n始乎致知物斯格，沈涵充积卒自得。\n众人巧智独敦朴，众人迫隘独恢廓。\n众人利欲独淡泊，洞然无碍油然乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观书有感","author":"罗从彦","text":"静处观心尘不染，闲中稽古意尤深。\n周诚程敬应粗会，奥理休从此外寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自警","author":"罗从彦","text":"性地栽培恐易芜，是非理欲谨于初。\n孔颜乐地非难造，好读诚明静定书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示书生","author":"罗从彦","text":"知行蹊径固非艰，每在操存养性间。\n此道悟来随寓见，一毫物欲敢相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颜乐斋","author":"罗从彦","text":"山染岚光带日黄，潇然茅屋枕池塘。\n自知寡与真堪笑，赖有颜瓢一味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邀月台","author":"罗从彦","text":"矮作垣墙小作台，时邀明月写襟怀。\n夜深独有长庚伴，不许庸人取次来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送南剑王守归 其一","author":"罗从彦","text":"三年政化被生民，甘雨祥风溢剑津。\n解组幡然赋归去，攀辕无计可留恂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送南剑王守归 其二","author":"罗从彦","text":"未把阳关三叠吟，且将谬句写离心。\n千寻浩浩镡溪水，别恨不知谁浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉李愿中五首 其一","author":"罗从彦","text":"圣道由来自坦夷，休迷佛学惑他岐。\n死灰槁本浑无用，缘置心官不肯思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉李愿中五首 其二","author":"罗从彦","text":"不开鸡犬闹桑麻，仁宅安居是我家。\n耕种情田勤礼义，眼前风物任繁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉李愿中五首 其三","author":"罗从彦","text":"今古乾坤共此身，安身须是且安民。\n临深履薄缘何事，祇恐操心近矢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉李愿中五首 其四","author":"罗从彦","text":"彩笔书空空不染，利刀割水水无痕。\n人心但得如空水，与物自然无怨恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉李愿中五首 其五","author":"罗从彦","text":"权门来往绝行踪，一片闲云过九峰。\n不似在家贫亦好，水边林下养疏慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自述","author":"罗从彦","text":"松菊相亲莫厌频，纷纷人世只红尘。\n自怜寡与真堪笑，赖有清风是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题一钵庵","author":"罗从彦","text":"可怜萱草信无忧，谁谓幽兰解结愁。\n欲得寸田断荆棘，只消长伴赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吉溪吴助教 其一","author":"罗从彦","text":"室富真儒业，门多长者车。\n明经方教子，得第已荣家。\n性守仍知分，天然不爱奢。\n百年成古昔，行路亦咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吉溪吴助教 其二","author":"罗从彦","text":"新生誇踯躅，旧德叹凋零。\n冷带商岩月，光凌处士星。\n布衣难得禄，白首易穷经。\n追想今何在，溪流对洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颜乐亭用陈默堂韵","author":"罗从彦","text":"平时仰止在高山，要以亭名乐内颜。\n颠倒一生浑是梦，寻思百计不如闲。\n心斋肯与尘污染，陋巷宁容俗往还。\n坚守箪瓢心不改，恐流乞祭向墦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄傲轩用陈默堂韵","author":"罗从彦","text":"自嗟踽踽复凉凉，糊口安能仰四方。\n目送归鸿心自远，门堪罗雀日偏长。\n家徒四壁樽仍绿，侯户千头橘又黄。\n我醉欲眠卿且去，肯陪俗客语羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"濯缨亭用陈默堂韵","author":"罗从彦","text":"十载犹缁京洛尘，归欤那复厕朝绅。\n君今谈笑青油幕，我但巍峨乌角巾。\n江汉更从尼父濯，衣冠宁羡屈原新。\n欲赓孺子沧浪咏，会意须还舍瑟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题静亭","author":"罗从彦","text":"鼎创新亭静更幽，四时景象镇长留。\n端如和气里谈笑，恍若春风中泳游。\n排闼山供蓝色重，凭栏水拥壁光浮。\n我来登赏无穷趣，好把篇诗与唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送延年行","author":"罗从彦","text":"圣言天远海潭潭，独在潜心久泳涵。\n猥念百家非己好，妄将一贯与君谈。\n贤如赐也才知二，学若陈亢只得三。\n此道误来因自足，却随鹏鸟话图南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用韵送延年","author":"罗从彦","text":"心源寂静映寒潭，每欲操存更养涵。\n顾我日思攀剧论，荷君时与得高谈。\n眼前旧识知多少，物外深交没二三。\n幸久相亲频握手，遽成分别又东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和延年岩桂","author":"罗从彦","text":"几树芬芳檀与沉，枝枝若占郤家林。\n风摇已认飘残菊，日照浑疑缀散金。\n仙窟移来成美景，东堂分去结清阴。\n我今不愿蟾宫折，待到蟾宫向上吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题德士退庵","author":"罗从彦","text":"牛头山顶锁烟霞，檐月松风即我家。\n筏渡有情新活计，袋空无物旧生涯。\n已将黄叶分双手，却捃白茅占一窊。\n会得懒慵归去路，索然忘鸟更忘花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺田溪张公迁居","author":"罗从彦","text":"华构经营占地灵，浓岚环合数峰青。\n苟完公子方成室，趋训儿孙已过庭。\n岂止一时誇壮丽，定知百世享安宁。\n顾惟善颂非张老，祇贡汤盘往日铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张公叙别古风","author":"罗从彦","text":"良工创新第，潇洒侔洞府。\n经营未毕工，四面方兴渚。\n蛟龙忽夜徙，空中震雷雨。\n亲旧贺于门，主人迎孔户。\n连唤凤儿来，藏书几多部。\n为我张广筵，酬宾酌以旅。\n人谓主公贤，敦朴嗤峻宇。\n规模出心匠，务卑由乃祖。\n欲图久安逸，勿辞暂劳苦。\n忠孝阐门家，诗礼光族绪。\n居室云苟完，谦冲弥自处。\n玉石不分别，鹤鸡谩为侣。\n顾予局促辈，乡评少推许。\n尝游庄岳间，喜作齐人语。\n何幸天相之，幡然交邹鲁。\n早年钦大名，驰书聊以序。\n比来揖清风，谈笑挥玉麈。\n见之名利尽，久侍岂无补。\n素志以深酬，青眼犹相与。\n默念汤盘颂，未为倾肺腑。\n何当惠古风，锦绣施笺楮。\n妙曲诚寡和，取则凭柯斧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠云岩次陈默堂韵","author":"罗从彦","text":"济渡游丹洞，穿林惹翠云。\n迩来多野趣，殊觉少尘纷。\n笑日花迎客，临岩鸟唤群。\n真机皆自得，此道与平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲茶山","author":"葛胜仲","text":"吴兴紫笋，实产顾渚。\n唐昔底贡，阚山芽吐。\n隼旟出临，虎岩亲驻。\n邻邦刺史，金匏相遇。\n木瓜堂前，穿云浥露。\n烹蒸包发，及春未暮。\n天子称珍，分甘当路。\n今则不然，名毁势去。\n金沙弗湘，玉食弗御。\n敷荣穷山，牢落谁顾。\n如女失宠，空闺自嫭。\n请以千金，买长门赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶山解嘲","author":"葛胜仲","text":"众万之生，于世暂寓。\n一偾一兴，孰知其故。\n退黜奚戚，进升奚慕。\n岂以通塞，顾改常度。\n有如我翁，昔尝掀翥。\n戴纚垂缨，去天尺五。\n今屏山城，亦皆时数。\n左右佩剑，畴可笑侮。\n翁具退省，前言大误。\n用与不用，智力何预。\n幸同此邦，邂逅承晤。\n结为金兰，安此贫素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅讼诉忽疲起卧少顷复视事","author":"葛胜仲","text":"平明坐早衙，投缿来相踵。\n讼牍鼠雀暗，吏行凫鹜拥。\n外台竦风棱，檄至亟须捧。\n以身为形役，劾去顾未勇。\n病骨瘦栾栾，衰发希种种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓宁民罢瑕丘簿","author":"葛胜仲","text":"火云烧晴空，大暑金石流。\n行人口生烟，千里无停辀。\n胡为趣遵路，僚好挽莫留。\n自言为升斗，往日辞亲游。\n儿嬉膝前欢，三载不可求。\n所得较所失，轻重真不侔。\n于兹满秩归，子职冀稍修。\n微官亦何乐，触事有庶尤。\n米盐聒双耳，簿领昏两眸。\n畏首复畏尾，人役不得休。\n岂无读书暇，顷刻但少偷。\n幸此案上历，数日获到头。\n白云已在眼，喜色津津浮。\n我亦厌羁官，如苦南冠囚。\n羡子有行色，去若登昆丘。\n更书纵未下，投劾行当谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]