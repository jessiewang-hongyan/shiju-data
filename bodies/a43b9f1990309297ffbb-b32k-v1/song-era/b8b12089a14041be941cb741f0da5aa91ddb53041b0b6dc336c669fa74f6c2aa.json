[{"title":"和陈子思晚出崇因","author":"毕仲游","text":"两山夹路郁崔嵬，云缕飞空似剪裁。\n此日定须相别去，瓮中残酒待谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子思马上口占令益师携茶纸赴会之作二首 其一","author":"毕仲游","text":"几时曾买建溪芽，小箧深藏品必嘉。\n豫约今朝狂醉后，须烦同泛一瓯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子思马上口占令益师携茶纸赴会之作二首 其二","author":"毕仲游","text":"早携数幅过山隅，明日诗情各有馀。\n案上罗文如已少，金花银叶也堪书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈子思","author":"毕仲游","text":"每到题诗偏得趣，自怜把酒不能歌。\n他时若有相思意，寄我千篇不是多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈子仪","author":"毕仲游","text":"临行又探北园芳，且欲相延伴酒觞。\n不似春花少颜色，只看蜂蝶逐风狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈子思留别","author":"毕仲游","text":"上马同寻旧路行，风林日暖自无声。\n此时话别难为语，山水淙淙聒耳鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵十一舅留别","author":"毕仲游","text":"莫说他时招我易，须知此日别翁难。\n还家何似偏相忆，却检残书独自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻题文周翰郭熙平远图二首 其一","author":"毕仲游","text":"窗间咫尺似天边，不识应言小辋川。\n闻说平居心目倦，暂开黄卷即醒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子瞻题文周翰郭熙平远图二首 其二","author":"毕仲游","text":"木落山空九月秋，画时应欲遣人愁。\n因思梦泽经由处，二十年间若转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋开叔监簿解榜","author":"毕仲游","text":"衣冠相见虽甥舅，场屋同游若弟兄。\n今日青云皆有意，他时白首见功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和夷仲兄舟次苍陵","author":"毕仲游","text":"苍陵每过怯舟还，闻说蛟龙在水间。\n今我到来都不问，一声鸣橹见青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宋宁道太祝简陈济翁","author":"毕仲游","text":"从吾坦率任吾真，每到花时得意新。\n但恐诗人足离别，此生何处不逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某在洛中蒙朝请惠书促归兼录示赏家园芍药两绝比离洛中芍药已阑矣因次元韵追和二首 其一","author":"毕仲游","text":"花开次第剪繁枝，先后争妍各是时。\n谩和新篇随尺素，何须亲见始题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某在洛中蒙朝请惠书促归兼录示赏家园芍药两绝比离洛中芍药已阑矣因次元韵追和二首 其二","author":"毕仲游","text":"看花不觉过花时，香草才馀十数枝。\n闻说残樽犹可倒，晓风吹袖已披披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和魏圣源","author":"毕仲游","text":"市朝虽近是閒官，诗句清新酒量宽。\n料得还家霜满地，赠袍应有故人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄颍川欧阳仲纯兄弟","author":"毕仲游","text":"早来檐雨泻空阶，投晚阴云四向开。\n最好西湖今夜月，不知谁在女郎台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蔡州欧阳仲纯","author":"毕仲游","text":"东西相去若比邻，肥马轻裘有故人。\n美酒如霞花似锦，莫令辜负汝阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄成都宇文裘","author":"毕仲游","text":"春深相别已秋深，日戴乌巾绕竹林。\n斫得鱼竿长十丈，无由同钓锦江心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答杨二十器之简后见贻之作","author":"毕仲游","text":"门外曾留长者车，醉如白也骑鲸鱼。\n恨无车骑堪生计，不得长安买酒垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵","author":"毕仲游","text":"散发行歌意自如，不须身作蠹书鱼。\n相逢酌酒弹棋外，共杵丹砂试药垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠济阴令罗正之","author":"毕仲游","text":"饮酒不论彭泽令，草书浑学右将军。\n更知近日诗为苦，未及襄阳有几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和僧圆益","author":"毕仲游","text":"山峰望处人难到，草径行来马自知。\n多谢山僧扫尘壁，我今有意不能题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏留僧圆益","author":"毕仲游","text":"城头云景晓漫漫，未雪先惊特地寒。\n明夜若能沽美酒，诗僧应不问归鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和僧圆益先到灵泉","author":"毕仲游","text":"无烟远数三千嶂，有马同驱十二蹄。\n却喜山前堪洗耳，水声激激听寒溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞泉","author":"毕仲游","text":"飞泉喷薄万珠圆，宛似骊山十月间。\n好作汤池浴寒月，醒人心处是潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神泉","author":"毕仲游","text":"神泉题字若鱼鳞，短句长篇数十人。\n试向壁间寻作者，李师中后有黄莘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书轩","author":"毕仲游","text":"书轩东向木栏干，寒食相招对酒盘。\n日色带阴春竟晚，幽花未落蝶成团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事二首 其一","author":"毕仲游","text":"屋破风斜漏不休，布衾无里卧穷秋。\n贫家未说田家苦，狼籍残书湿自收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事二首 其二","author":"毕仲游","text":"溪回带树弯弯绿，山远迎人步步高。\n春水满塘颓岸去，也如江上见风涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题","author":"毕仲游","text":"拄杖行行去路遥，城荒树老色萧条。\n颍州寺里僧知否，夜梦常游飞盖桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自嘲","author":"毕仲游","text":"箸下尝来新蟹美，瓮中篘得旧醅浑。\n只今醉倒君休笑，便是当时吏部孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自怜","author":"毕仲游","text":"自怜贫病也为儒，灯火相亲十岁馀。\n昔作儿童今已老，案头犹有未看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中","author":"毕仲游","text":"閒后题诗醉后歌，身名官业任蹉跎。\n不知老境何形状，但觉新来病痛多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五更有感","author":"毕仲游","text":"杯酒虽同兴自殊，夜来不寤自嘻吁。\n五更月落窗还暗，愁听山禽叫勃姑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放鱼","author":"毕仲游","text":"续缦沉钩钓水滨，众鱼拨拨锦为鳞。\n却将鲜鲤池中放，待倩传书付远人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"社鼓","author":"毕仲游","text":"社鼓鼕鼕南北村，老人相倚话柴门。\n自从嘉祐初年后，直至元丰有稻孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天磨石","author":"毕仲游","text":"玉京传诏下南山，镌凿高崖使转旋。\n大匠不知人世用，未施轮轴便升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金错刀","author":"毕仲游","text":"倾囊倒箧皆珍怪，中有如刀两大钱。\n不是美新能制作，为怜今近一千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉刀","author":"毕仲游","text":"镜台杵臼昔尝有，何人更以玉为刀。\n已觉空堂走魑魅，却缄虹气授儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离蒲中简游景叔知府少卿","author":"毕仲游","text":"经岁思归偶得归，清歌未彻醉如泥。\n篮舆径遂西城过，鹳鹊楼高不及题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芭蕉","author":"毕仲游","text":"水痕天影淡相宜，露坐秋凉乍快时。\n桐叶芭蕉最多事，晓昏风雨报人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李白水西诗韵","author":"释守讷","text":"泾水秋更清，清波照城郭。\n谓言寻胜游，步蹑秋霜阁。\n诗人昔仙游，江左苦飘泊。\n壮志负青云，浩气横碧落。\n邈矣不可追，苔封辨遗作。\n珠玉湛冰壶，琅玕脱锦箨。\n千载挹清风，万虑都空廓。\n长啸寄幽怀，山灵亦然诺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释守讷","text":"野夫生长仁皇世，再见仁皇御太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题御制听琴图","author":"蔡京","text":"吟徵调商灶下桐，松间疑有入松风。\n仰窥低审含情客，似听无弦一弄中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诏赐南园示亲党","author":"蔡京","text":"八年帷幄竟何为，更赐南园宠退师。\n堪笑当时王学士，功名未有便吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答童师敏","author":"蔡京","text":"闻说群花烂漫开，知君醉赏不能来。\n临风对酒空惆怅，不得相从把一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与范谦叔饮西园","author":"蔡京","text":"一日趋朝四日閒，荒园薄酒愿交驩。\n三峰崛起无平地，二派争流有激湍。\n极目榛芜惟野蔓，忘忧鱼鸟自波澜。\n满船载得圭璋重，更掬珠玑洗眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蔡攸征燕","author":"蔡京","text":"老懒身心不自由，封书寄与泪横流。\n百年信誓当深念，三伏征涂盍少休。\n目送旌旗如昨梦，心存关塞起新愁。\n缁衣堂下清风满，早早归来醉一瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别宠姬","author":"蔡京","text":"为爱桃花三树红，年年岁岁惹东风。\n如今去逐它人手，谁复尊前念老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制己亥十一月十三日南郊祭天斋宫即事赐诗 其一","author":"蔡京","text":"雪晴至日日初南，帝举明禋祀事严。\n万瓦沟中寒色在，一轮空外晓光暹。\n云和龙轸开冰辙，风暖鸾旗拂冻檐。\n共喜天心扶圣德，珠玑更误宠恩沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制己亥十一月十三日南郊祭天斋宫即事赐诗 其二","author":"蔡京","text":"展采齐明拱面南，浓云深入夜更严。\n风和不放琼英落，日暖高随玉漏暹。\n照地神光临午陛，鸣皋仙羽下重檐。\n五门回仗如天上，看举鸡竿雨露沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制己亥十一月十三日南郊祭天斋宫即事赐诗 其三","author":"蔡京","text":"衮龙朱履午阶南，大辇鸾鸣羽卫严。\n玉轸乍回黄道稳，金乌初上白云暹。\n五门晓吹开旗尾，万骑花光入帽檐。\n已见神光昭感格，鹤书恩下万邦沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭和御制己亥十一月十三日南郊祭天斋宫即事赐诗 其四","author":"蔡京","text":"饮福初回八陛南，凝旒裒对百神严。\n睍消尘入康衢润，神应光随北陆暹。\n丹槛雉开中扇影，朱绳鹤下五门檐。\n群生鼓舞明禋毕，却忆花飞舞袖沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题神霄宫 其一","author":"蔡京","text":"下马神霄第一回，晴空宫殿九秋开。\n月中桂子看时落，云外仙軿特地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题神霄宫 其二","author":"蔡京","text":"参差碧瓦切昭回，绣户云輀次第开。\n仙伯九霄曾付托，得随真主下天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题保和殿壁","author":"蔡京","text":"琼瑶错落密成林，桧竹交加午有阴。\n恩许尘凡时纵步，不知身在五云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至玉真轩奉诏赓补","author":"蔡京","text":"保和新殿丽秋晖，诏许尘凡到绮闱。\n雅燕酒酣添逸兴，玉真轩内看安妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见安妃像","author":"蔡京","text":"玉真轩槛暖如春，只见丹青未有人。\n月里常娥终有恨，鉴中姑射未应真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍圣春宴口号 其一","author":"蔡京","text":"牙牌晓奏集英班，日照云龙下九关。\n红蜡青烟寒食后，翠华黄屋太微间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍圣春宴口号 其二","author":"蔡京","text":"三春乐奏三春曲，万岁声连万岁山。\n欲识君臣同乐意，天威咫尺不违颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"蔡京","text":"三十六宫人第一，玉楼深处梦熊罴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"蔡京","text":"龙烛影中犹是腊，凤箫声里已吹春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"蔡京","text":"人主主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"蔡京","text":"万镒黄金手化铁，五色綵云神授丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"蔡京","text":"菊英九日万龄黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"蔡京","text":"君臣燕衎升平际，属句论文乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"蔡京","text":"姑射神仙犹饮露，龟台王母未忘桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潭岚院","author":"李孝博","text":"堆积岚光照碧潭，山前一寺号潭岚。\n四时想见无穷景，借问老僧能尽谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别惠山赠璋山主","author":"萧渊","text":"三年爱山来几回，携筇蹑履真悠哉。\n片石可枕云可偎，愆期不到萦吾怀。\n中藉高僧还有才，能与佳胜为良媒。\n汲泉煮茗何欢咍，松边竹下容琴杯。\n我嗟官满今还台，欲去不忍须重来。\n慇勤慇勤孰与偕，寒猿老鹤声相哀。\n山有情兮韫琼瑰，愿泉无穷兮滋九垓。\n它时再赏登崔嵬，约师把手忘形骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题共乐堂","author":"柳安道","text":"平波数顷万峰前，一片丹青画不全。\n幽榭小桥横翠水，茂林修竹锁轻烟。\n绮罗弦管追欢地，雪月风花烂醉天。\n争奈及瓜归觐去，湖山无复苦留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"谢慥","text":"越山岝㟯凌苍穹，北山独秀誇卧龙。\n集贤学士辞青琐，高牙新拥千骑雄。\n昼看卧龙峰，夕隐蓬莱宫。\n双旌倒影射日红，心闲不厌来山中。\n排虚屏障环四封，翠积琉璃千万重。\n乍见烟霞西复东，倏听海鼓鸣鼕鼕。\n照湖一望光悠溶，寒波百里秋瞳眬。\n茂林修竹交青葱，峥嵘楼阁疑天通。\n使君况复气摩空，高吟万字才不穷。\n醉倒犹索黄金钟，下笔凛凛生清风。\n幸当圣世民俗丰，莫惜樽俎频雍容。\n但忧政成被追锋，白云幽鸟不得长相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"毕仲愈","text":"已招明月移歌扇，更倩春风试舞腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"毕仲愈","text":"明灯数点林中见，横笛一声烟外闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李籍","text":"三公历拜皆无敌，二府更居贵莫伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王鲸","text":"时辟西湖作胜游，使君元是济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题忠烈侯庙","author":"万规","text":"王事多艰险不移，委身先敌大江湄。\n临危授命生前勇，列爵封侯死后祠。\n龚寇已随湍下没，子规无复夜深悲。\n欲知幽显存忠义，勋业重光两石碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]