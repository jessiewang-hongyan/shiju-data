[{"title":"湖上八首 其七","author":"方岳","text":"游人抵死爱春韶，风暖花香酒未消。\n须向先贤堂上去，画船无数泊长桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上醉题","author":"方岳","text":"山知吾亦以诗豪，畴昔于山只淡交。\n清得不多赢得瘦，一生悔读楚离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖山纪游 其一","author":"方岳","text":"两山南北诗三百，付与秋风赵倚楼。\n忽忆老逋坟下路，梅花夜雪上孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖山纪游 其二","author":"方岳","text":"凤凰城里花如海，选集诸人守部门。\n此老久渔双脚浪，岛烟湖雾又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫虚观","author":"方岳","text":"小炷炉熏待瀹茶，瓦盆添水养蒲芽。\n江南地暖得春早，开尽雪篱无数花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢人致蟹 其三","author":"方岳","text":"雪砍双螯玉一壶，樵中曾有此奇无。\n始知张翰思归意，不为秋风只为鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢人致蟹 其一","author":"方岳","text":"樵岚无蟹有监州，已负诗肠过一秋。\n莫怪渊明便归去，得渠自合老菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢人致蟹 其二","author":"方岳","text":"此去江头只两程，寒蒲解缚便横行。\n无肠政要空虚腹，满贮芦花与月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢人致蟹 其四","author":"方岳","text":"除却金齑霜后枨，更无一物可诗情。\n诚斋配以彭生脔，岂不冤哉五鼎烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋至能所书西湖洞天事 其二","author":"方岳","text":"圮上老人亲堕履，衡山道士共联诗。\n向来此事亦多矣，我故于君了不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋至能所书西湖洞天事 其一","author":"方岳","text":"西湖天下奇绝处，定有老仙时下观。\n重来俯仰已陈迹，但见孤山烟雾漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其二","author":"方岳","text":"家人不寄扊扅诗，直恐藁砧官尚微。\n到了不过相爱耳，未论此语是耶非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其十三","author":"方岳","text":"剡溪船后灞桥驴，著我荒村一笋舆。\n却后几年俱作画，未知雪句定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其七","author":"方岳","text":"对灶何妨客燎衣，溪翁且莫键柴扉。\n日之夕矣樵风冷，觳觫一牛将犊归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其十","author":"方岳","text":"野涨平溪已断桥，悔将辛苦上岧峣。\n朝来雨断才堪厉，依旧绿杨山径遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其五","author":"方岳","text":"荦确连云路不分，云侵衫袖白纷纷。\n亦知云自青山出，不见青山只有云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其六","author":"方岳","text":"冲雨冲风莫管渠，晨炊蓐食便巾车。\n能无几日到茅舍，睡到日高相折除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其四","author":"方岳","text":"梅已飘零尚典刑，断魂篱落野烟青。\n灵均憔悴乃知此，到老可人宁独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其九","author":"方岳","text":"画中亦爱雨中山，连雨山行却厌看。\n一夜东风吹作雪，问谁画我访袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其十一","author":"方岳","text":"晨光漏日鸟深春，况此泥行雨宿人。\n夜半瓦鸣惊梦觉，悔将蓬笠当劳薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其八","author":"方岳","text":"上到春山顶?头，更携烟雨入吾州。\n梅花便作乡人看，飞落酒杯相劝酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其三","author":"方岳","text":"十日山寒雨不休，仆其痡矣得无愁。\n老夫自爱归程好，肯为春泥怨鹁鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其一","author":"方岳","text":"春泥滑滑欲溅裾，肯为梅花顾草庐。\n唤作诗人看得未，雨籉笠雪一肩舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁来红 其二","author":"方岳","text":"秋入山篱叶正丹，老天浑误作花看。\n不知宋玉今何似，雁欲来时霜正寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁来红 其一","author":"方岳","text":"是叶青青花片红，剪裁无巧似春风。\n谁将叶作花颜色，更与春风迥不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪店回文","author":"方岳","text":"啼莺几处垂垂柳，乳燕双飞片片花。\n溪浅度云山带雨，岸崩攲树草连沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简徐宰 其四","author":"方岳","text":"俗吏相传作县难，及民那有一分宽。\n闻君犹逮从诸老，说到民贫鼻亦酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简徐宰 其三","author":"方岳","text":"西山有蕨北山薇，荷雨锄烟不疗饥。\n但得县官如卓鲁，此言只恐未曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简徐宰 其二","author":"方岳","text":"自织春蓑学治田，山寒辛苦不逢年。\n摩挲此腹何时饱，黄犊夕阳相对眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简徐宰 其一","author":"方岳","text":"雨外茅茨黄叶村，老农相语一灯昏。\n山深未识新官姓，但说无人夜打门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩予祠 其二","author":"方岳","text":"月明弄影雪巅癯，只似胡僧不似吾。\n忽予牙绯称羽客，道官儒黻释头颅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩予祠 其一","author":"方岳","text":"坚卧牛庵饱岁寒，恩书初许作黄冠。\n孙仙彭老如相问，筋力犹堪上醮坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赪桐花 其二","author":"方岳","text":"似子圆红不似花，绿丛擎出野人家。\n亦知吟骨今当换，火候初成独体砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲鹭","author":"方岳","text":"曾有诗矜白鹭閒，一生诗眼乞山漫。\n朝来更觉忙于我，雪冱苍溪不道寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题八士图 其一","author":"方岳","text":"雅闻八士春俱秀，未觉三贤迹已陈。\n投分不论曾识面，此图到手便情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题八士图 其二","author":"方岳","text":"飞絮游丝芳草路，淡烟疏雨落花天。\n偶然画出寻诗意，未必新诗待画传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题甘露寺中峰 其一","author":"方岳","text":"六朝晴树一江秋，尽入风烟顶?头。\n老手更擎江色出，小亭景却胜于楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题甘露寺中峰 其二","author":"方岳","text":"金焦两点自东西，著我于中亦一奇。\n菰叶蘋花秋共晚，山寒未必白鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郑尉爱山楼 其二","author":"方岳","text":"三间屋与佛同住，纸帐梅花烟雨寒。\n有客肯来清话否，上楼借与好山看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郑尉爱山楼 其一","author":"方岳","text":"青山不入俗士眼，谁肯著楼招唤渠。\n径草不锄花又老，一帘新雨了残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵漕小蓬莱 其二","author":"方岳","text":"老夫曾到道家山，太乙青藜夜叩关。\n著作承明今付子，仙壶元不隔人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵漕小蓬莱 其一","author":"方岳","text":"乾坤不尽一蘧庐，方寸中间几太虚。\n办著海涛三万里，乃翁底用费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题致堂新州坐石 其一","author":"方岳","text":"苍寒瘴面新州石，直不话头传不休。\n秦负儒耶君误矣，二书今与大江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题致堂新州坐石 其二","author":"方岳","text":"棱层不隔梅花岭，万里相从识两翁。\n却怪牧牛亭下路，石麟咫尺卧秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郭氏继一堂 其二","author":"方岳","text":"渔蓑钓艇越中居，底处烟波不属渠。\n一曲鉴湖须敕赐，却令鸥鸟费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题偶爱 其二","author":"方岳","text":"长汀宜日山宜雨，尽在鸥看鹭听中。\n想见夜寒留客醉，倚阑拍手唤渔篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题偶爱 其一","author":"方岳","text":"每评吾郡佳山水，当以水西为最奇。\n径向水西非具眼，不眠偶爱不渠知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题偶爱 其四","author":"方岳","text":"溪云莫怪尘埃面，更与青山把一杯。\n未省此诗容写否，闻渠曾识谪仙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题偶爱 其三","author":"方岳","text":"随行茶灶曾同宿，看尽朝岚与夕霏。\n一片诗愁秋渺渺，树林深处见僧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题雄观","author":"方岳","text":"送出青山点点愁，数声柔橹隔沧洲。\n白鸥不受人间暑，明月一江天地秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写照吴生 其一","author":"方岳","text":"山须未压棱层骨，诗不能平磊磈胸。\n烦画雪溪诗意思，梅花苍石一横筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写照吴生 其二","author":"方岳","text":"几人堪画麒麟阁，万事不如鹦鹉杯。\n只谓故吾诗瘦耳，寒沙鸥鹭莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠诗僧 其二","author":"方岳","text":"从来佛法无多子，底用芒鞋半九州。\n赢得诸人诗满袖，草深一丈法堂秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠诗僧 其一","author":"方岳","text":"瀑泉癞可能诗最，毕竟难为本色僧。\n要识庐山真面目，一溪明月冷于冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士","author":"方岳","text":"老来学剑已无成，眼底边尘猝未清。\n此辈束之高阁耳，且容黄犊伴春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谈命苏秦","author":"方岳","text":"一蓑牛背饱看山，扣角前冈烟雨寒。\n客自纵横三尺觜，与吾烟雨不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谈命者赵生自号千两金","author":"方岳","text":"人间万事一杯酒，之子五行千两金。\n听我自穷诗自老，半江明月苇花深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠算数汪生 其二","author":"方岳","text":"貂蝉勋业麒麟画，自有夔龙向上人。\n数本不为吾辈设，风烟之句水云身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠算数汪生 其一","author":"方岳","text":"十年不读床头易，山雨鸣蓑为口忙。\n行矣公无落吾事，水田漠漠正移秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"擘蟹","author":"方岳","text":"秋来何但食无鱼，老去宁须腹有书。\n空洞略容君几辈，草泥郭索一从渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹭","author":"方岳","text":"耸两吟肩似我愁，菰蒲叶下一身秋。\n溪风昨夜吹鱼落，飞过前滩看水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"羹莼","author":"方岳","text":"烟雨中间几白鸥，藕花菱叶小亭幽。\n紫莼共煮香涎滑，吐出新诗字字秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙酉岁游浙中道闻盗起霅川遂寓珠溪","author":"方岳","text":"未到山阴兴已阑，相传道路正间关。\n故人坐隔月千里，老宿肯分云半间。\n有客谁家无白酒，能诗何处不青山。\n一声啼鸟长廊静，花落花开春自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"方岳","text":"明河此夕会双星，滓秽圆清太不经。\n牛岂其然耕觳觫，女何为者嫁娉婷。\n閒中但觉人间巧，老去谁邀帝子灵。\n千古文章柳州事，解将蹇拙说惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕郑文振席上姬有楚云者为作三弄","author":"方岳","text":"帝子经年别，秋风远客情。\n断云含宿雨，古木落寒声。\n河汉低逾润，江潮夜未平。\n巫云莫吹笛，吾意正凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕潘宰招不往","author":"方岳","text":"投老归欤拙独存，剖瓜亦欲问天孙。\n故人有约夜堂醉，老子不禁秋暑袢。\n却恐长绳縻日月，政须高枕问乾坤。\n北窗风好难为客，未辨冠巾数候门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"方岳","text":"把住秋云绕菊篱，野情未觉老垂垂。\n古今不遇岂惟我，风雨相过莫问谁。\n未郭索前空有酒，自陶潜后久无诗。\n底须计较明年健，只么悠然自一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"方岳","text":"逢人提菊卖，方省是重阳。\n山晓雨初霁，江秋树亦凉。\n年华犹故我，烽火更殊乡。\n有客那无酒，令人忆草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日与同年沈贯卿饮月墅","author":"方岳","text":"自摘黄花插满头，谁怜白发不禁秋。\n同年肯过卢仝屋，九日共登王粲楼。\n天气政为吾辈设，酒香莫对俗人篘。\n渠侬尽把茱萸看，更与渊明风马牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日道中","author":"方岳","text":"重阳却喜无风雨，野菊迎人亦自花。\n年去年来秋又老，江南江北鬓将华。\n离骚如此那无酒，羁旅虽谙不似家。\n但得东篱堪种菊，尽容吾子岸乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日集清凉佳处","author":"方岳","text":"老笔盘空墨未乾，最佳处与著危栏。\n江山分与诸贤管，风雨专为九日寒。\n白发自惊秋节序，黄花曾识晋衣冠。\n未须计较明年健，别做茱萸一等看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二日即事","author":"华岳","text":"春潮昨夜没平滩，一雨催花色半含。\n雁唤元宵归塞北，燕衔新社到江南。\n无欢不必游花树，有病何须置药篮。\n只把公忠答天地，从教儿女闹冠簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日 其二","author":"方岳","text":"赖有空山著此翁，不然高论与谁同。\n百年会尽玄尚白，一气不停春又红。\n诗卷每随烟水外，鸟声多在夕阳中。\n年丰已卜晴人日，亦是平生?亩忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日吴明辅招不往","author":"方岳","text":"江湖老我百无堪，懒过紬书太史谈。\n雨脚又连人日暗，酒肠那似少年酣。\n一生出处龟藏六，万事乘除狙赋三。\n且试半篙春水绿，南山之北北山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入局","author":"方岳","text":"雁鹜行馀纸尾钳，岸湖老屋压题签。\n印文生绿空藏匮，草色蟠青欲刺檐。\n茶话略无尘土杂，荷香剩有水风兼。\n官曹那得閒如此，亦奉一囊惭属厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入歙","author":"方岳","text":"野竹吾乡路，逢人似故知。\n社寒催燕早，夜雨勒花迟。\n草入思连梦，山邀到歙诗。\n客中春一半，煞是负春彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十四月食中秋遂无月","author":"方岳","text":"妖蟆不为中秋地，老兔先奔昨夜寒。\n世事相违剧晴雨，人生何苦许悲欢。\n云窗自照青藜杖，月户重修白玉盘。\n坐想西风万袍鹄，政飞健笔写琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]