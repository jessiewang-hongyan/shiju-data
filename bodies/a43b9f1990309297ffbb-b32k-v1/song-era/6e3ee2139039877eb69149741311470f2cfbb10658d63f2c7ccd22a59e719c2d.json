[{"title":"减字木兰花","author":"程垓","text":"双双相并。\n一点红边偏照映。\n玉剪云裁。\n不比浮花共蒂开。\n几回心曲。\n选胜摘来情自足。\n插向云鬟。\n要与仙郎比并看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南/忆江南 夜泊龙桥滩前遇雨作","author":"程垓","text":"篷上雨，篷底有人愁。\n身在汉江东畔去，不知家在锦江头。\n烟水两悠悠。\n吾老矣，心事几时休。\n沈水熨香年似日，薄云垂帐夏如秋。\n安得小书舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望秦川/南歌子 其三","author":"程垓","text":"翠黛随妆浅，铢衣称体香。\n好风偏与十分凉。\n却扇含情独自、绕池塘。\n碧藕丝丝嫩，红榴叶叶双。\n牵丝摘叶为谁忙。\n情到厌厌拼醉、又何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望秦川/南歌子 其一 早春感怀","author":"程垓","text":"柳弱眠初醒，梅残舞尚痴。\n春阴将冷傍帘帷。\n又是东风和恨、向人归。\n乐事灯前记，愁肠酒后知。\n老来无计遣芳时。\n只有闲情随分、品花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望秦川/南歌子 其二","author":"程垓","text":"竹粉翻新箨，荷花拭靓妆。\n断云侵晚度横塘。\n小扇斜钗依约、傍牙床。\n蘸蜜分红荔，倾筒泻碧香。\n醉时风雨醒时凉。\n明月多情依旧、过西厢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其四","author":"程垓","text":"绿深红少。\n柳外横桥小。\n双燕不知幽梦好。\n惊起碧窗春晓。\n起来瞢多时。\n玉台金镜慵移。\n多少春愁未说，却来闲数花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其一","author":"程垓","text":"山城桃李。\n催促春无几。\n日日为花须早起。\n犹□惜花无计。\n阿谁留得春风。\n长教绕绿围红。\n莫遣十分芳意，输他万点愁容。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其二 酬王静父红木犀词","author":"程垓","text":"秋香谁买。\n散入琉璃界。\n点缀小红全不碍。\n还却铅华馀债。\n夜来月底相期。\n一枝未觉香迟。\n恰似青绫帐底，绛罗初试裙儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 其三 咏雪","author":"程垓","text":"疏疏整整。\n风急花无定。\n红烛照筵寒欲凝。\n时见筛帘玉影。\n夜深明月笼纱。\n醉归凉面香斜。\n犹有惜梅心在，满庭误作吹花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲 其二","author":"程垓","text":"独木小舟烟雨湿。\n燕儿乱点春江碧。\n江上青山随意觅。\n人寂寂。\n落花芳草催寒食。\n昨夜青楼今日客。\n吹愁不得东风力。\n细拾残红书怨泣。\n流水急。\n不知那个传消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲 其一 彭门道中早起","author":"程垓","text":"野店无人霜似水。\n清灯照影寒侵被。\n门外行人催客起。\n因个事。\n老来方有思家泪。\n寄问梅花开也未。\n爱花只有归来是。\n想见小乔歌舞地。\n浑含喜。\n天涯不念人憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措","author":"程垓","text":"一枝烟雨瘦东墙。\n真个断人肠。\n不为天寒日暮，谁怜水远山长。\n相思月底，相思竹外，犹自禁当。\n只恐玉楼贪梦，输他一夜清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其七","author":"程垓","text":"夜来花底莺饶舌。\n把人心事分明说。\n许大好因缘。\n只成容易传。\n春阑无好计。\n唯有归来是。\n从此玉台前。\n晓妆休太妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十四","author":"程垓","text":"晓烟笼日浮山翠。\n春风著水回川媚。\n远近碧重重。\n人家山色中。\n野花香自度。\n似识幽人处。\n安得著三间。\n与山终日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"程垓","text":"小窗荫绿清无暑。\n篆香终日萦兰炷。\n冰簟涨寒涛。\n清风一枕高。\n有人团扇却。\n门掩庭花落。\n少待月侵床。\n教他魂梦凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其五 正月三日西山即事","author":"程垓","text":"山头翠树调莺舌。\n山腰野菜飞黄蝶。\n来为等闲休。\n去成多少愁。\n小庭花木改。\n犹有啼痕在。\n别后不曾看。\n怕花和泪残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"程垓","text":"春回绿野烟光薄。\n低花矮柳田家乐。\n陇麦又青青。\n喧蜂闲趁人。\n野翁忘近远。\n怪识刘郎面。\n断却小桥溪。\n怕人溪外知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十五","author":"程垓","text":"扶犁野老田东睡。\n插花山女田西醉。\n醉眼眩东西。\n看看桃满溪。\n耕桑山下足。\n纨绮人间俗。\n莫管旧东风。\n从教吹软红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十一","author":"程垓","text":"去年恰好双星节。\n鹊桥未渡人离别。\n不恨障云生。\n恨他真个行。\n天涯消息近。\n不见乘鸾影。\n楼外鹧鸪声。\n几回和梦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"程垓","text":"平芜冉冉连云绿。\n斜阳衬雨明溪足。\n小鸭睡晴沙。\n翠烘三两花。\n春光闲婉娩。\n尽日无人见。\n试著小屏山。\n图归云际看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其九 回文","author":"程垓","text":"暑庭消尽风鸣树。\n树鸣风尽消庭暑。\n横枕一声莺。\n莺声一枕横。\n扇纨低粉面。\n面粉低纨扇。\n凉月淡侵床。\n床侵淡月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"程垓","text":"和风暖日西郊路。\n游人又踏青山去。\n何处碧云衫。\n映溪才两三。\n疏松分翠黛。\n故作羞春态。\n回首杏烟消。\n月明归渡桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其三 访江东外家作","author":"程垓","text":"画桥拍拍春江绿。\n行人正在春江曲。\n花润接平川。\n有人花底眠。\n东风元自好。\n只怕催花老。\n安得万垂杨。\n系教春日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"程垓","text":"东风有意留人住。\n熏风无意催人去。\n去住两茫然。\n相逢成短缘。\n平生花柳笑。\n过后关心少。\n今日奈情何。\n为伊饶恨多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十三","author":"程垓","text":"客窗曾剪灯花弄。\n谁教来去如春梦。\n冷落旧梅台。\n小桃相次开。\n人间春易老。\n只有山中好。\n闲却槿花篱。\n莫教溪外知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"程垓","text":"罗衫乍试寒犹怯。\n妒花风雨连三月。\n灯冷闭门时。\n有愁谁得知。\n此情真个苦。\n只为当时语。\n莫道絮沾泥。\n絮飞魂亦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其十二","author":"程垓","text":"浅寒带暝和烟下。\n轻阴挟雨随风洒。\n翠幕护重帘。\n篆香销半奁。\n平生风雨夜。\n怕近芭蕉下。\n今夕定愁多。\n萧萧声奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其三 陪苏子重诸友饮东山","author":"程垓","text":"乌帽侧。\n行遍杏花春色。\n野意青青分陇麦。\n人家烟水隔。\n春事莫催行客。\n弹指青梅堪摘。\n醉倚暮天江拍拍。\n雨晴沙路白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其四 病起","author":"程垓","text":"花半湿。\n一霎晚云笼密。\n天气未佳风又急。\n小庭愁独立。\n酒病起来无力。\n懊恼篆烟锁碧。\n一饷春情无处觅。\n小屏山数尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其二 荼","author":"程垓","text":"花簇簇。\n触眼万条垂玉。\n小院春深窗锁绿。\n水沈风断续。\n明月又侵楼曲。\n羞向枕囊拘束。\n只待夜深清影足。\n醉来花底宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其五","author":"程垓","text":"春夜雨。\n催润柳塘花坞。\n小院深深门几许。\n画帘香一缕。\n独立晚庭凝伫。\n细把花枝闲数。\n燕子不来天欲暮。\n说愁无处所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其六","author":"程垓","text":"风阵阵。\n吹落杨花无定。\n酒病厌厌三月尽。\n花檀红自隐。\n新绿轩窗清润。\n月影又移墙影。\n手捻青梅无处问。\n一春长闷损。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其一 杏花","author":"程垓","text":"春悄悄。\n红到一枝先巧。\n酒入半腮微带卯。\n粉寒香未饱。\n芳意枝头偏闹。\n困尽蜂须莺爪。\n拟倩玉纤和露拗。\n情多愁易搅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其七","author":"程垓","text":"浓睡醒。\n惊对一帘秋影。\n桐叶乍零风不定。\n半窗疏雨影。\n愁与年光不尽。\n老入星星双鬓。\n只拟上楼寻远信。\n雁遥烟水暝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪狮儿","author":"程垓","text":"断云低晚，轻烟带暝，风惊罗幕。\n数点梅花，香倚雪窗摇落。\n红炉对谑。\n正酒面、琼酥初削。\n云屏暖，不知门外，月寒风恶。\n迤逦慵云半掠。\n笑盈盈、闲弄宝筝弦索。\n暖极生春，已向横波先觉。\n花娇柳弱。\n渐倚醉、要人搂著。\n低告托。\n早把被香熏却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最高楼","author":"程垓","text":"旧时心事，说著两眉羞。\n长记得、凭肩游。\n缃裙罗袜桃花岸，薄衫轻扇杏花楼。\n几番行，几番醉，几番留。\n也谁料、春风吹已断。\n又谁料、朝云飞亦散。\n天易老，恨难酬。\n蜂儿不解知人苦，燕儿不解说人愁。\n旧情怀，消不尽，几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其四 咏三十九数","author":"程垓","text":"真游六六洞中仙。\n骑鹤下三天。\n休道日斜岁暮，行年方是韶华。\n相逢一笑，此心不动，须待明年。\n要得安排稳当，除非四十相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其二 茶词","author":"程垓","text":"华筵饮散撤芳尊。\n人影乱纷纷。\n且约玉骢留住，细将团凤平分。\n一瓯看取，招回酒兴，爽彻诗魂。\n歌罢清风两腋，归来明月千门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其一","author":"程垓","text":"矮窗西畔翠荷香。\n人在小池塘。\n何事未拈棋局，却来闲倚胡床。\n金盆弄水，玉钗亸鬓，妆懒何妨。\n莫道困来不饮，今宵却恨天凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其三 汤词","author":"程垓","text":"龙团分罢觉芳滋。\n歌彻碧云词。\n翠袖且留纤玉，沈香载捧冰垍。\n一声清唱，半瓯轻啜，愁绪如丝。\n记取临分馀味，图教归后相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 其五","author":"程垓","text":"片花飞后水东流。\n无计挽春留。\n香小谁栽杜若，梦回依旧扬州。\n破瓜年在，娇花艳冶，舞柳纤柔。\n莫道刘郎霜鬓，才情未放春休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愁倚阑/春光好","author":"程垓","text":"春犹浅，柳初芽。\n杏初花。\n杨柳杏花交影处，有人家。\n玉窗明暖烘霞。\n小屏上、水远山斜。\n昨夜酒多春睡重，莫惊他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"意难忘","author":"程垓","text":"花拥鸳房。\n记驼肩髻小，约鬓眉长。\n轻身翻燕舞，低语转莺簧。\n相见处，便难忘。\n肯亲度瑶觞。\n向夜阑，歌翻郢曲，带换韩香。\n别来音信难将。\n似云收楚峡，雨散巫阳。\n相逢情有在，不语意难量。\n些个事，断人肠。\n怎禁得恓惶。\n待与伊、移根换叶，试又何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摊破江城子/江城梅花引","author":"程垓","text":"娟娟霜月又侵门。\n对黄昏。\n怯黄昏。\n愁把梅花，独自泛清尊。\n酒又难禁花又恼，漏声远，一更更，总断魂。\n断魂。\n断魂。\n不堪闻。\n被半温。\n香半温。\n睡也睡也，睡不稳、谁与温存。\n只有床前、红烛伴啼痕。\n一夜无眠连晓角，人瘦也，比梅花，瘦几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摊破南乡子","author":"程垓","text":"休赋惜春诗。\n留春住、说与人知。\n一年已负东风瘦，说愁说恨，数期数刻，只望归时。\n莫怪杜鹃啼。\n真个也、唤得人归。\n归来休恨花开了，梁间燕子，且教知道，人也双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摸鱼儿","author":"程垓","text":"掩凄凉、黄昏庭院，角声何处呜咽。\n矮窗曲屋风灯冷，还是苦寒时节。\n凝伫切。\n念翠被熏笼，夜夜成虚设。\n倚阑愁绝。\n听凤竹声中，犀影帐外，簌簌酿寒轻雪。\n伤心处，却忆当年轻别。\n梅花满院初发。\n吹香弄蕊无人见，惟有暮云千叠。\n情未彻。\n又谁料而今，好梦分胡越。\n不堪重说。\n但记得当初，重门锁处，犹有夜深月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 其一 忆别","author":"程垓","text":"门掩垂杨，宝香度、翠帘重叠。\n春寒在，罗衣初试，素肌犹怯。\n薄霭笼花天欲暮，小风送角声初咽。\n但独褰、幽幌悄无言，伤初别。\n衣上雨，眉间月。\n滴不尽，颦空切。\n羡栖梁归燕，入帘双蝶。\n愁绪多于花絮乱，柔肠过似丁香结。\n问甚时、重理锦囊书，从头说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红","author":"程垓","text":"葺屋为舟，身便是、烟波钓客。\n况人间元似，泛家浮宅。\n秋晚雨声篷背稳，夜深月影窗棂白。\n□满船诗酒满船书，随意索。\n也不怕，云涛隔。\n也不怕，风帆侧。\n但独醒还睡，自歌还拍。\n卧后从教鳅鳝舞，醉来一任乾坤窄。\n恐有时、撑向大江头，占风色。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 其二","author":"程垓","text":"水远山明，秋容淡、不禁摇落。\n况正是、楼台高处，晚凉犹薄。\n月在衣裳风在袖，冰生枕簟香生幕。\n算四时、佳处是清秋，须行乐。\n东篱下，西窗角。\n寻旧菊，催新酌。\n笑广平何事，对秋萧索。\n摇叶声声深院宇，折荷寸寸闲池阁。\n待归来、闲把木犀花，重薰却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 时在临安晚秋登临","author":"程垓","text":"南月惊乌，西风破雁，又是秋满平湖。\n采莲人尽，寒色战菰蒲。\n旧信江南好景，一万里、轻觅莼鲈。\n谁知道，吴侬未识，蜀客已情孤。\n凭高，增怅望，湘云尽处，都是平芜。\n问故乡何日，重见吾庐。\n纵有荷纫芰制，终不似、菊短篱疏。\n归情远，三更雨梦，依旧绕庭梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 其二 春日南园","author":"程垓","text":"门前杨柳绿成阴。\n翠坞笼香径自深。\n迟日暖熏芳草眼，好风轻撼落花心。\n无多春恨莺难语，最晚朝眠蝶易寻。\n惟有狂醒不相贷，酿成憔悴到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 其一 瑞香","author":"程垓","text":"东风冷落旧梅台。\n犹喜山花拂面开。\n绀色染衣春意静，水沈熏骨晚风来。\n柔条不学丁香结，矮树仍参茉莉栽。\n安得方盆载幽植，道人随处作香材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪","author":"程垓","text":"老来风味，是事都无可。\n只爱小书舟，剩围着、琅玕几个。\n呼风约月，随分乐生涯，不羡富，不忧贫，不怕乌蟾堕。\n三杯径醉，转觉乾坤大。\n醉后百篇诗，尽从他、龙吟鹤和。\n升沈万事，还与本来天，青云上，白云间，一任安排我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"程垓","text":"轻红短白东城路。\n忆得分襟处。\n柳丝无赖舞春柔。\n不系离人、只解系离愁。\n如今花谢春将老。\n柳下无人到。\n月明门外子规啼。\n唤得人愁、争似唤人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 秋日寄怀","author":"程垓","text":"角声吹月，风声落枕，梦与柔肠俱断。\n谁教当日太情浓，飏不下、新愁一段。\n黄花开了，梅花开未，曾约那时相见。\n莫教容易负幽期，怕真个、孤他泪眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑶阶草","author":"程垓","text":"空山子规叫，月破黄昏冷。\n帘幕风轻，绿暗红又尽。\n自从别后，粉销香腻，一春成病。\n那堪昼闲日永。\n恨难整。\n起来无语，绿萍破处池光净。\n闷理残妆，照花独自怜瘦影。\n睡来又怕，饮来越醉，醒来却闷。\n看谁似我孤令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧牡丹","author":"程垓","text":"睡起情无著。\n晓雨尽，春寒弱。\n酒盏飘零，几日顿疏行乐。\n试数花枝，问此情何若。\n为谁开，为谁落。\n正愁却。\n不是花情薄。\n花元笑人萧索。\n旧观千红，至今冷梦难托。\n燕麦春风，更几人惊觉。\n对花羞，为花恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酷相思","author":"程垓","text":"月挂霜林寒欲坠。\n正门外、催人起。\n奈离别、如今真个是。\n欲住也、留无计。\n欲去也、来无计。\n马上离魂衣上泪。\n各自个、供憔悴。\n问江路梅花开也未。\n春到也、须频寄。\n人到也、须频寄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其四 自东江乘晴过蟆颐渚园小饮","author":"程垓","text":"晴带溪光春自媚。\n绕翠萦青，来约东风醉。\n云补断山疏复缀。\n雨回绿野清还丽。\n拄杖不妨舒客意。\n临水人家，问有花开未。\n江左风流今有几。\n逢春不要人憔悴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其五","author":"程垓","text":"翠幕成阴帘拂地。\n池馆无人，四面生凉意。\n荷气竹香俱细细。\n分明著莫清风袂。\n玉枕如冰笙似水。\n才亸横钗，早被莺呼起。\n今夜月明人未睡。\n只消三四分来醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"程垓","text":"日下船篷人未起。\n一个燕儿，说尽伤春意。\n江上残花能有几。\n风催雨促成容易。\n湖海客心千万里。\n著力东风，推得人行未。\n相次桃花三月水。\n菱歌谁伴西湖醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]