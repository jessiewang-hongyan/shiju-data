[{"title":"临江仙 尉姜补之托疾卧家作","author":"葛胜仲","text":"郊外黄垓端可厌，归来移病香闺。\n象床珍簟共委蛇。\n耆婆寻草尽，天女散花迟。\n小雨作寒秋意晚。\n檐声与梦相宜。\n冷侵罗幌酒烟微。\n试评书五朵，何似画双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙","author":"葛胜仲","text":"千古乌程新酿美，玉觞风过粼粼。\n歌声未办起梁尘。\n九天持斧客，来作绣衣人。\n夙有辞华惊乙览，传闻献颂东巡。\n未应握节久宾宾。\n一封驰诏旨，却醉上林春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 二月二十二日锦薰阁赏花","author":"葛胜仲","text":"槛外奇葩江外种，娇春未减鞓红。\n画楼晴日敛云峰。\n佛香来海岸，蜀锦荐灯笼。\n今夜那忧杀风景，酒花来斗妖浓。\n江梅冷淡避春风。\n明朝来纵赏，应醉绮罗丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 章圃赏瑞香二首 其一","author":"葛胜仲","text":"二月风光浓似酒，小楼新湿青红。\n碧琉璃色映群峰。\n更携金凿落，来赏锦薰笼。\n调客旧留□月旦，此花清软纤秾。\n未饶兰蕙转光风。\n赤阑呈雅艳，翠幕护芳丛。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 九日黄刚定再索席间作","author":"葛胜仲","text":"秋水莹精神。\n靖节先生太逼真。\n谈麈生风霏玉屑，津津。\n爽气泠然欲侵人。\n一座尽生春。\n满引琼觞已半醺。\n更把黄花寿彭祖，盈盈。\n数阕新声又遏云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 其二 九日","author":"葛胜仲","text":"拂槛晓云鲜。\n销暑楼危竦半天。\n曾是携宾当荐九，开筵。\n度水萦山奏管弦。\n黄菊映华颠。\n千骑重来已六年。\n楼下东流当日水，依然。\n更对周旋旧七贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 其一 九日用玉局翁韵作呈坐上诸公","author":"葛胜仲","text":"晴日乱云收。\n人在蘋香柳恽洲。\n溪上清风楼上醉，飕飕。\n共折黄花插满头。\n佳客献还酬。\n不负山城九日秋。\n苕碧下青供酩酊，休休。\n楚客当年浪自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 三月望日与文中诸贤泛舟南溪作","author":"葛胜仲","text":"柳岸正飞绵。\n选胜斋轻漾碧涟。\n笑语忘怀机事尽，鸥边。\n万顷溪光上下天。\n菰苇久延缘。\n不觉遥峰霭暮烟。\n对酒莫嫌红粉陋，婵娟。\n自有孤高月妇仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇 县斋愁坐作","author":"葛胜仲","text":"秋晚寒斋，藜床香篆横轻雾。\n闲愁几许。\n梦逐芭蕉雨。\n云外哀鸿，似替幽人语。\n归不去。\n乱山无数。\n斜日荒城鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"葛胜仲","text":"通白轻红溢万枝。\n浓香百和透丰肌。\n丹山威凤势将飞。\n玉镜台前呈国艳，沈香亭北映朝曦。\n如花惟有上皇妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 赏酴醾","author":"葛胜仲","text":"一夜狂风尽海棠。\n此花天遣殿群芳。\n芝兰百濯见真香。\n劝客淋浪灯底韵，恼人魂梦枕边囊。\n一枝插不□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"葛胜仲","text":"东道殷勤玉斝飞。\n华灯倾国拥珠玑。\n玉奴嫌瘦玉环肥。\n缥缈幸闻缑岭曲，参差犹隔夏侯衣。\n放开云月出清辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 赏梅","author":"葛胜仲","text":"东阁郎官巧写真。\n西湖处士妙传神。\n嫣然一笑腊前春。\n斗好虽无冰骨女，相宜幸是雪髯人。\n且烦疏影入清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"葛胜仲","text":"今夜风光恋渚蘋。\n欲教四角出车轮。\n金钗离立座生春。\n神女恍惊巫峡梦，飞琼原是阆风人。\n诏封后院宠儒臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二 小饮","author":"葛胜仲","text":"盘里明珠芡实香。\n尊前堆雪脍丝长。\n何妨羌管奏伊凉。\n翠葆重生无复日，白波不釂有如江。\n壁间醉墨任淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 赏芍药","author":"葛胜仲","text":"楼子包金照眼新。\n香根犹带广陵尘。\n翻阶不羡掖垣春。\n不分与花为近侍，难甘溱洧赠闲人。\n如羞如怨独含颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"葛胜仲","text":"溪岸沈深属泛蘋。\n倾城容貌此推轮。\n可怜虚度二年春。\n暮暮来时骚客赋，朝朝新处后庭人。\n天留花月伴羁臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 木芍药词","author":"葛胜仲","text":"可惜随风面旋飘。\n直须烧烛看娇娆。\n人间花月更无妖。\n浓丽独将春色殿，繁华端合众芳朝。\n南床应为醉陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙","author":"葛胜仲","text":"斗鸭栏边晓露沾。\n华堂醉赏轴珠帘。\n插花人好手纤纤。\n遮护轻寒施翠幄，标题仙品露牙签。\n词人遗恨独江淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 十月十九夜赏菊","author":"葛胜仲","text":"我爱菊花枝。\n浥露偏宜。\n旋移佳种一年期。\n照眼黄金三径烂，可但东篱。\n秋老摘花吹。\n敢恨开迟。\n只愁一夜便香衰。\n待插满头年大也，且泛芳卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 九月十八日与千里赏菊三首 其一","author":"葛胜仲","text":"又见菊花新。\n色浅香匀。\n老人衰病卧漳滨。\n虽是无聊仍止酒，幸有嘉宾。\n不用怨萧辰。\n不似芳春。\n请看金蕊照金尊。\n今夜花前须醉倒，直到黎明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"葛胜仲","text":"歌阕斗清新。\n檀板初匀。\n画堂新筑太湖滨。\n好是黄花开应候，聊宴亲宾。\n上客即逢辰。\n况是青春。\n上林开宴锡尧尊。\n今夜素娥真解事，偏向人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 其三","author":"葛胜仲","text":"娱老小亭新。\n丹垩初匀。\n万枝金菊绕溪滨。\n折向华堂遮醉眼，聊用娱宾。\n红烛夜香辰。\n广坐生春。\n月波新酿入芳尊。\n好向花前拚烂醉，不负承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙令 将去南阳作","author":"葛胜仲","text":"步屧对东风。\n细探春工。\n百花堂下牡丹丛。\n莫恨使君来便去，不见鞓红。\n雾眼一衰翁。\n无意芳秾。\n年来结习已成空。\n寄语国香雕槛里，好为人容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其二 病起不见杏花作","author":"葛胜仲","text":"杏花零乱。\n拟把百觚来判断。\n病卧漳滨。\n不见枝头闹小春。\n吾衰老矣。\n一醉花前犹不遂。\n情绪厌厌。\n虚度韶光又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其一 公弼侄初授官，以此劝酒","author":"葛胜仲","text":"辛勤场屋。\n未遇知音甘陆陆。\n诏录遗忠。\n一札天书下九重。\n鹅城初命。\n此去青云应渐近。\n解褐恩新。\n今岁吾家第四人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 薛肇明同二侍姬至葛山观梅，薛公会作","author":"葛胜仲","text":"葛山仙隐。\n尚有馀膏留旧鼎。\n十里梅花。\n夹道争看衮绣华。\n人间妙丽。\n并侍黄扉开国贵。\n僻壤孤芳。\n羞涩尊前不敢香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲 其一 初创真意亭于南溪，游陟晚归作","author":"葛胜仲","text":"岩壑萦回云水窟。\n林深路断迷烟客。\n茅屋数椽携杖舄。\n人寂寂。\n侵檐万个琅玕碧。\n倦客羁怀清似涤。\n更无一点飞埃迹。\n溪涨慢流过几席。\n寒湜湜。\n凫鹥点破琉璃色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔家傲 其二","author":"葛胜仲","text":"叠叠云山供四顾。\n簿书忙里偷闲去。\n心远地偏陶令趣。\n登览处。\n清幽疑是斜川路。\n野蔌溪毛供饮具。\n此身甘被烟霞痼。\n兴尽碧云催日暮。\n招晚渡。\n遥遥一叶随鸥鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭霜/满庭芳 任昉尝为西安太守，风流名迹，图经史牒具载，感今怀古作","author":"葛胜仲","text":"百不为多，一不为少，阿谁昔仕吾邦。\n共推任笔，洪鼎力能扛。\n不为桃花禄米，雠书倦、一苇横江。\n招寻处，徒行曳杖，曾不拥麾幢。\n山川，真大好，鱼矶无恙，密岭难双。\n听讼诉多就，樵坞僧窗。\n岁月音容远矣，风流在、遐想心降。\n云烟路，搜奇吊古，时为酹空缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 和通判送别","author":"葛胜仲","text":"两年人住岂无情。\n别乘辞华四水清。\n何事千钟勤饮饯，故知一别未能轻。\n解龟虽幸樊笼出，挂席还愁海汐平。\n江草江花都是泪，骊驹休作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 工部七月一日生辰","author":"葛胜仲","text":"火云欲避金风至。\n秀气充闾初降瑞。\n去家丁令却归来，还燕悬弧当日地。\n金章紫绶身荣贵。\n寿福天储昌又炽。\n怪来一岁四迁官，还过当生元太岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪 送李彦时","author":"葛胜仲","text":"出门西笑。\n千里长安道。\n不用引离声，便登荣、十洲三岛。\n画船珠箔，苹末水风凉，随柳岸，楚台人，景与人俱好。\n应嗟见晚，玉殿生清晓。\n正是妙年时，步承明、谋身须早。\n轺车肤使，新逐凯歌回，恩绋重，彩衣轻，嘉庆知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪 其二","author":"葛胜仲","text":"春风野外。\n卵色天如水。\n鱼戏舞绡纹，似出听、新声北里。\n追风骏足，千骑卷高冈，一箭过，万人呼，雁落寒空里。\n天穿过了，此日名穿地。\n横石俯清波。\n竞追随、新年乐事。\n谁怜老子，使得暂遨游，争捧手，乍凭肩，夹道游人醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓦山溪 天穿节 和朱刑掾二首 其一","author":"葛胜仲","text":"望云门外。\n油壁如流水。\n空巷逐朱幡，步春风、香河七里。\n冶容炫服，摸石道宜男，穿翠霭，度飞桥，影在清漪里。\n秦头楚尾。\n千古风流地。\n试问汉江边，有解佩、行云旧事。\n主人是客，一笑强颁春，烧灯后，赏花前，遥忆年年醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 题灵山广禅院","author":"葛胜仲","text":"灵山法会何曾散。\n此地神光满。\n丁公潭下百雷霆。\n疑是银河挽下、一齐倾。\n高桥飞观连云起。\n槛外惊湍水。\n大矶才过小矶来。\n应有天孙灵驭、月中回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其二","author":"葛胜仲","text":"一轮丹桂窅窊树。\n光景疑非暮。\n天公著意在兹时。\n扫尽微云点缀、展清池。\n樽前金奏无晨露。\n只有君房语。\n骊驹客莫赋归诗。\n东道留连应赋、不庸归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 自兰陵归，冬夜饮严州酒作","author":"葛胜仲","text":"严陵滩畔香醪好。\n遮莫东方晓。\n春风盎盎入寒肌。\n人道霜浓腊月、我还疑。\n红炉火热香围坐。\n梅蕊迎春破。\n一声清唱解人颐。\n人道牢愁千斛、我谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其一 酬卫卿弟兄赠","author":"葛胜仲","text":"三年曾不窥园树。\n辛苦萤窗暮。\n怪来文誉满清时。\n柿叶书残犹自、日临池。\n春秋新学卑繁露。\n黄卷聊堪语。\n家人不用寄龟诗。\n行看升平楼外、化龙归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 七夕","author":"葛胜仲","text":"鹊桥仙偶，天津轻渡，却笑嫦娥孤皎。\n平时五夜似经年，问何事、今宵便晓。\n云车将驾，神夫留恋，更吐心期多少。\n支机休浪与闲人，莫倚赖、芳心素巧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙 七夕","author":"葛胜仲","text":"凉飙破暑，清歌萦坐，缺月稀星庭户。\n瓜华草草具杯盘，喜共浥、初筵零露。\n天孙东处，牵牛西望，劝汝一杯清醑。\n精灵何必待秋通，为一洗、朦胧今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"葛胜仲","text":"已过春分春欲去。\n千炬花间，作意留春住。\n一曲清歌无误顾。\n绕梁馀韵归何处。\n尽日劝春春不语。\n红气蒸霞，且看桃千树。\n才子霏谈更五鼓。\n剩看走笔挥风雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 章道祖倧生日","author":"葛胜仲","text":"安石榴花浓绿映。\n解愠风轻，乍改朱明令。\n衮绣元臣门户盛。\n童孙此日悬弧庆。\n夜宴华堂添酒兴。\n□□除书，远带天香剩。\n欲浥苕波供续命。\n不须龙护江心镜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其三 再次韵千里照花","author":"葛胜仲","text":"百紫千红今烂熳。\n举烛辉花，莫厌烧令短。\n酒里逢花须细看。\n人生谁似英雄半。\n安得红颜为老伴。\n妙舞花前，杨柳夸身段。\n已倒玉山回竹院。\n清香不断风吹面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 和王廉访","author":"葛胜仲","text":"风过涟漪纹縠细。\n十指香檀，惊破交禽睡。\n野蔌溪毛真易致。\n风流未减兰亭会。\n击汰千艘供洛禊。\n映水垂杨，万缕拖浓翠。\n小海一声波上戏。\n殷勤留客千金意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 二月十三日同安人生日作二首 其一","author":"葛胜仲","text":"雨后春光浓似醉。\n著柳催花，节物侵龙忌。\n绣褓香闺当日佩。\n紫兰宫堕人间世。\n歌管停云香吐穗。\n碧酒红裳，共祝鱼轩贵。\n天上阿环金箓秘。\n龟龄鹤寿三千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"葛胜仲","text":"只恐夜深花睡去。\n火照红妆，满意留宾住。\n凤烛千枝花四顾。\n消愁更待寻何处。\n汉苑红光非浪语。\n栖静亭前，都是珊瑚树。\n便请催尊鸣釂鼓。\n明朝风恶飘红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"葛胜仲","text":"共乐堂深帘不卷。\n恻恻寒轻，二月春犹浅。\n续寿竞来歌舞院。\n龙涎香衬鲛绡段。\n画栋朝飞双语燕。\n端似知人，著意窥金盏。\n柳外花前同祝愿。\n朱颜长在年龄远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 其一 次韵张千里驹照花","author":"葛胜仲","text":"二月春游须烂漫。\n秉烛看花，只为晨曦短。\n高举蜡薪通夕看。\n红光万丈腾天半。\n寄语平时游冶伴。\n不负分阴，胜事输今段。\n灯火休催归小院。\n殷勤更照桃花面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉花阴 次韵印师","author":"葛胜仲","text":"东皇已有来归耗。\n十里青山道。\n冻蘖万株梅，一夜妆成，似趁鸣鸡早。\n年时清赏曾同到。\n先仗游蜂报。\n抖擞旧心情，一笑酬春，不羡和羹诏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉蓬莱 天宁节作","author":"葛胜仲","text":"望葱葱佳气，虹渚祥开，斗枢光绕。\n析木天津，正灵晖腾照。\n鹭缀分班，象胥交贡，奉御觞清晓。\n玉殿寒轻，金徒漏永，瑞炉烟袅。\n万宇均欢，示慈颁燕，寿祝南山，庆均凫藻。\n缥缈红云，望九重天表。\n舞兽锵洋，抃鳌欣戴，度管弦声杳。\n历草长新，蟠桃永秀，与天难老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 新春","author":"葛胜仲","text":"玉琯还飞换岁灰。\n定山新棹酒船回。\n年时梁燕双双在，肯为人愁便不来。\n衰意绪，病情怀。\n玉山今夜为谁颓。\n年时梅蕊垂垂破，肯为人愁便不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"葛胜仲","text":"婆律香深气味佳。\n玻璃仙碗进流霞。\n凝膏清涤高阳醉，灵液甘和正焙芽。\n香染指，浪浮花。\n加笾礼尽客还家。\n贯珠声断红裳散，踏影人归素月斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 赏菊二首 其一","author":"葛胜仲","text":"黄菊鲜鲜带露浓。\n小园开遍度香风。\n自篘玉酝酬秋色，旋洗霜须对晚丛。\n香在手，莫匆匆。\n寻芳今夜有人同。\n黄金委地新收得，莫道山翁到底穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其一 九月十三日携家游夏氏林亭燕集作，并送汤词","author":"葛胜仲","text":"小榭幽园翠箔垂。\n云轻日薄淡秋晖。\n菊英露浥渊明径，藕叶风吹叔宝池。\n酬素景，泥芳卮。\n老人痴钝强伸眉。\n欢华莫遣笙歌散，归路从教灯影稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"葛胜仲","text":"采采黄花鹄彩浓。\n吹开一夜为霜风。\n已邀骚客陶元亮，不用歌姬盛小丛。\n秋易老，莫匆匆。\n齐山高兴古今同。\n欲知此地花多少，一眼金英望不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留友人","author":"葛郛","text":"良友间何阔，春事遽如许。\n劳君下鸥沙，一叶系春渚。\n昨梦坠前世，再见欣欲舞。\n聊呼花底杯，酒面点红雨。\n狂歌谢贯珠，清论杂挥麈。\n骊驹未可歌，妙句须君吐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"葛郛","text":"玉屑装龙脑，云衣覆麝■。\n何堪夜来雪，香色两凄迷。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"深院","author":"葛起文","text":"深院人閒酒浅斟，日长帘幕自沉沉。\n梅花可是因春瘦，洗雨梳风太不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窖岭道中","author":"葛起文","text":"屦穿苍藓滑，水复更山重。\n有圃春偏晚，无人碓自舂。\n乱云生峭壁，一鸟没高峰。\n随处桃花发，仙源似可逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏竹阁","author":"葛起文","text":"岁寒编竹阁，蜗缩度穷年。\n日暴南窗纸，风垂北户帘。\n炉深全火气，铛小聚茶烟。\n为索梅花笑，微醺步矮檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"葛起文","text":"止水澄胸次，萧然远俗氛。\n静求徽外趣，时策酒中勋。\n风马檐前乐，香猊帐底云。\n破黄临小草，咄咄逼鹅群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]