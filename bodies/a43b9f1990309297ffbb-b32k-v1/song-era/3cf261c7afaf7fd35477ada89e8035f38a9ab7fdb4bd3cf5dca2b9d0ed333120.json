dynasty":"宋"}},{"title":"吴兴舟中有作","author":"王之道","text":"一水濡须百里间，举头遥见水西山。\n微波不动又终日，安得扁舟送我还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时雨二绝和赵积中韵 其二","author":"王之道","text":"白江州熟人炊玉，竞说前年斗万钱。\n何事农夫太庸鄙，欲将豚酒谢苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时雨二绝和赵积中韵 其一","author":"王之道","text":"稻花时候一犁雨，天意从人无间然。\n我亦摧颓穷甚矣，烦君试考小行年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芭蕉","author":"王之道","text":"秋风鸣玉雨疏疏，嫩绿临窗半卷舒。\n似是相知慰牢落，朝来肯寄一缄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其六","author":"王之道","text":"宿雨飞花阻撷芳，寄题端欲为增光。\n何时登揽快晴日，瀹茗挥毫看瑞香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其五","author":"王之道","text":"雨馀东北望银屏，一带寒山映骨清。\n谁道西风能换物，染红枫树亦多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其四","author":"王之道","text":"疏懒常嫌束带劳，年来见客强垂条。\n不知此病容医否，沥沥真珠出小槽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其三","author":"王之道","text":"一龛灯火夜凄清，壁下秋虫断续声。\n细把新诗等风味，易牙元不乱淄渑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其二","author":"王之道","text":"乱插黄花趁节宜，年华休向镜中悲。\n已知和气回春谷，横管临风更一吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其一","author":"王之道","text":"潇洒湖东小小亭，一时酬唱有三明。\n亭前澄练无边际，应助诗人写物情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟九日登魏文振亭园七首 其七","author":"王之道","text":"官道千秋坐小车，仙随阮肇饭胡麻。\n男儿正患无津耳，千古留侯事可嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟冬至即事","author":"王之道","text":"天容如鉴地无尘，阳气依稀动紫荆。\n日晷渐长端可爱，霜华增重不胜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟春日见寄三首 其三","author":"王之道","text":"十里西畴马送曛，晚风依约度溪云。\n悬知今夜桃花雨，一洗焦枯慰使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟春日见寄三首 其二","author":"王之道","text":"一鞭春色去迢迢，溪上红妆笑语娇。\n酒醉不知行客避，竞眠芳草斗裙腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子厚弟春日见寄三首 其一","author":"王之道","text":"睡起晴窗正忆渠，老兵声喏到前除。\n新诗价重连城璧，便觉贫家富不虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和卞养直见示三绝简圣书 其一","author":"王之道","text":"看君落笔走云烟，想见新丰醉少年。\n龙脊旧堆骐骥种，义方今服乃翁贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和卞养直见示三绝简圣书 其二","author":"王之道","text":"杨柳阴中乳燕飞，马头寒峭怯单衣。\n胡麻知有谁人种，应怪东游未即归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和卞养直见示三绝简圣书 其三","author":"王之道","text":"迟日轻风过雨天，笑声何处送鞦韆。\n清明已逼长安近，寄语先生快着鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和历阳守张仲智观梅五首 其五","author":"王之道","text":"出车何日劳师还，二圣归来喜见颜。\n乞得此身终芰制，乱山茅屋两三间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和历阳守张仲智观梅五首 其四","author":"王之道","text":"夜烧红烛照梅花，刺史风流自一家。\n待得残英上丹脸，韶华端复到山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和历阳守张仲智观梅五首 其三","author":"王之道","text":"谁似樊侯哲且明，解将勋业佐中兴。\n自怜汨没毛锥子，空对东风咏使能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和历阳守张仲智观梅五首 其二","author":"王之道","text":"万事当从酒到休，子山那得许多愁。\n绿樽翠杓梅花夕，不醉翻令恶客羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和历阳守张仲智观梅五首 其一","author":"王之道","text":"一霎轻风过雨稀，满庭春色碎珠玑。\n使君载酒花前醉，更有新诗为发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天衣聪老五首 其五","author":"王之道","text":"绿杨芳草自年年，人老逢春重喟然。\n六入傥能除旧习，三乘端许结新缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天衣聪老五首 其四","author":"王之道","text":"达磨东来不记年，一灯然处百灯然。\n愿从清净求明了，应喜晨斋学省缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天衣聪老五首 其三","author":"王之道","text":"法华灵应著当年，今古何曾有间然。\n不见后身房次律，却因和璞记前缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天衣聪老五首 其二","author":"王之道","text":"老怀归去几何年，吴越宗风久寂然。\n闻说近来狮子吼，应将驴脚问生缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天衣聪老五首 其一","author":"王之道","text":"师去无为十五年，重来猿鹤亦忻然。\n此生不负今朝祝，冀结龙华会里缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]