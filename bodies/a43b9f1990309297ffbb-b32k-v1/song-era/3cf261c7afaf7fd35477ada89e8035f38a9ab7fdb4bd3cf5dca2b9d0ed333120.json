[{"title":"虞美人 石光锡会上即席和李举之韵","author":"王之望","text":"鸳鸯碧瓦寒留雪。\n玉树先春发。\n小楼歌舞夜流连。\n月落参横、一梦绕梅边。\n尊前酒量谁能惜。\n都是高阳客。\n十分莫厌羽觞传。\n半醉娉婷、云鬓亸金钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴 生日","author":"王之望","text":"弧门此日犹能记。\n叹居诸难系。\n弹指片声中，不觉流年，五十还加二。\n儿童寿酒邀翁醉。\n笑欣欣相戏。\n休画老人星，白发苍髯，怎解如翁似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 台州倚江亭即席和李举之，时曹功显、贺子忱同坐","author":"王之望","text":"撩乱江云雪欲飞。\n小轩幽会酒行时。\n佳人喜得鸳鸯侣，豪客争题鹦鹉词。\n歌舞地，喜追随。\n歙州端恨外迁迟。\n谪仙狂监从来识，七步初看子建诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王之望","text":"雪班远岫明苍鬓，春秀奇峰拥翠鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王之望","text":"神灯点点光可烛，星斗荧荧低欲扪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"应雪木","author":"王之渊","text":"木名应雪匪辞誇，比似灵蓍总不差。\n从昔到今凡几验，一番飞雪一番花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕苦旱望雨","author":"王之道","text":"田禾吐白将就槁，野草垂黄几欲燃。\n来日天孙嫁河鼓，洗车今喜有夤缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又送道者王法圆作丐","author":"王之道","text":"誓将三寸舌，求结万人缘。\n宝刹成功日，当期道法圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下阁道中","author":"王之道","text":"小桥流水数家村，春入川原日自暾。\n马上不知岚气重，误惊征袖湿啼痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山西庄舍赠信上人和彦时兄四首 其四","author":"王之道","text":"寒鸦成阵下遥村，冰合回塘镜一番。\n㶁㶁溪流响何处，乱山无数不知源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山西庄舍赠信上人和彦时兄四首 其三","author":"王之道","text":"一枝清瘦早梅春，风味高如郭泰巾。\n襟袖归来香未歇，要将佳句属诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山西庄舍赠信上人和彦时兄四首 其二","author":"王之道","text":"四壁萧然犬自驯，年来食粥甑生尘。\n相逢未暇寒温语，请效参寥作故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山西庄舍赠信上人和彦时兄四首 其一","author":"王之道","text":"十里西畴路半砠，短辕无力困瘏痡。\n支筇预作渊明具，瓮有乌程不用沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山茶","author":"王之道","text":"开花不与众芳期，先得江梅破白时。\n犀甲鹤头微带雪，画屏曾见两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌江道中闻杜鹃有感","author":"王之道","text":"麻叶蓬蓬小麦肥，杨花风里杜鹃啼。\n故园尚阻归来赋，惭愧东坡雨一犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书子莱丙戌登科题名小录后","author":"王之道","text":"屈指宣和岁在辰，于今四十有三春。\n吾家又得莱追继，丛桂从兹不乏人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书来上人房","author":"王之道","text":"十里清风水拍天，老僧斋罢抱头眠。\n丹楹画栋看摧压，好为僧伽作胜缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书源上人壁","author":"王之道","text":"丹枫黄槲壮秋容，诘曲僧房一径通。\n塔似道人飞白笔，开窗还见倚晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风雨损花","author":"王之道","text":"雨多南国惜春归，多谢诗人赋采菲。\n堕白残红无处着，漫随风絮作团飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丘城道中","author":"王之道","text":"翠巘中间白水边，野梅官柳似当年。\n正看绕树下残日，便觉前村生晚烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日出郊二首 其二","author":"王之道","text":"一鞭乘兴上山头，雨脚随风湿破裘。\n冬日有情还可爱，忽开云雾见林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日出郊二首 其一","author":"王之道","text":"覆块青青麦欲齐，田家篱落柘冈西。\n岁饥冬暖聊相补，抉藕归来饷莱妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出合肥北门二首 其二","author":"王之道","text":"断垣甃石新修叠，折戟埋沙旧战场。\n阛阓凋零煨烬里，春风生草没牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出合肥北门二首 其一","author":"王之道","text":"淮水东来没踝无，只今南北断修涂。\n东风却与人心别，布暖吹生遍八区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北去安丰","author":"王之道","text":"问言何处是安丰，人指湖光柳影东。\n欲识淮西真使者，一鞭追骥有诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永丰道上阻水","author":"王之道","text":"路穷得水欲何为，立马逢人问所之。\n十里归来同小愒，一鞭南去不踰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉树花","author":"王之道","text":"几年埋没乱荆榛，轩槛移来特地新。\n何事临风忍相对，伤心一曲旧亡陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵赠湖塘来上人二首 其二","author":"王之道","text":"湖水瀰瀰浸绿苔，湖边衰柳两三栽。\n游鱼得意潜还跃，幽鸟多情去复来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵赠湖塘来上人二首 其一","author":"王之道","text":"望外荆榛蔽辋川，我来何必为逃喧。\n乱馀村疃鸡豚尽，秋到江湖藻荇繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合寨陪诸公观月","author":"王之道","text":"一樽相对夜厌厌，风捲浮云见玉蟾。\n凌乱请看矛作舞，清光炯炯已窥檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回峰寺和浮屠坦然韵","author":"王之道","text":"昼睡醒来日过中，山光入座水函空。\n绿杨堤外荷花富，招致清香赖有风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c0