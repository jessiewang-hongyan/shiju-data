[{"title":"藏头诗","author":"魏二翁","text":"火田心主须防慎，慎行方成后世传。\n传守坎离为要妙，妙趋名利作忧煎。\n前程若识丹霞法，法路应归紫府仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"魏二翁","text":"我今入山，避此嚣烦。\n卫以卒史，聘以达官。\n岂易我乐，物外清闲。\n养真存气，七返九还。\n金丹既就，遂陟仙坛。\n蓬莱绛阙，玉户金关。\n有能学我，云路非难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花洞","author":"魏万","text":"江山巧秀入禅扃，四望仙源画未真。\n万叠好峰侵碧落，一条流水隔红尘。\n涧边鹿迹知何代，洞口榴花镇似春。\n自恨声名尚牵锁，无因长对社中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子","author":"魏子敬","text":"愁盈镜里山，心叠琴中恨。\n露湿玉阑秋，香伴银屏冷。\n云归月正圆，雁到人无信。\n孤损凤皇钗，立尽梧桐影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"魏元吉","text":"去来无踪迹，大块一飞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒显应观崔真君","author":"魏元若","text":"磁州惠政泽流长，翊运于今有耿光。\n金甲护迁驰白马，绛衣诞圣拥红羊。\n久劳宵旰筹中土，为祝英灵监下方。\n唾手幽燕应默相，弯弧万里射天狼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和叠山先生韵 其一","author":"魏天应","text":"万叠青山只么青，从容时止又时行。\n斯文未丧予何畏，举世随流我独清。\n日月精忠今古在，丘山道义死生轻。\n吾翁铁脊文翁似，无愧渊明与孔明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和叠山先生韵 其二","author":"魏天应","text":"先生心事炳丹青，顾影何曾愧独行。\n商岭芝能如橘隐，首阳粟不似薇清。\n纲常正要身扶植，出处端为世重轻。\n安得寒泉来会宿，参同极论到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"好事近","author":"魏夫人","text":"雨后晓寒轻，花外早莺啼歇。\n愁听隔溪残漏，正一声凄咽。\n不堪西望去程赊，离肠万回结。\n不似海棠阴下，按凉州时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江城子 春恨","author":"魏夫人","text":"别郎容易见郎难。\n几何般。\n懒临鸾。\n憔悴容仪，陡觉缕衣宽。\n门外红梅将谢也，谁信道、不曾看。\n晓妆楼上望长安。\n怯轻寒。\n莫凭阑。\n嫌怕东风，吹恨上眉端。\n为报归期须及早，休误妾、一春闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮郎归","author":"魏夫人","text":"夕阳楼外落花飞。\n晴空碧四垂。\n去帆回首已天涯。\n孤烟卷翠微。\n楼上客，鬓成丝。\n归来未有期。\n断魂不忍下危梯。\n桐阴月影移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"系裙腰","author":"魏夫人","text":"灯花耿耿漏迟迟。\n人别后、夜凉时。\n西风潇洒梦初回。\n谁念我，就单枕，皱双眉。\n锦屏绣幌与秋期。\n肠欲断、泪偷垂。\n月明还到小窗西。\n我恨你，我忆你，你争知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卷珠帘/蝶恋花","author":"魏夫人","text":"记得来时春未暮。\n执手攀花，袖染花梢露。\n暗卜春心共花语。\n争寻双朵争先去。\n多情因甚相辜负。\n轻拆轻离，欲向谁分诉。\n泪湿海棠花枝处。\n东君空把奴分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定风波","author":"魏夫人","text":"不是无心惜落花。\n落花无意恋春华。\n昨日盈盈枝上笑。\n谁道。\n今朝吹去落谁家。\n把酒临风千种恨。\n难问。\n梦回云散见无涯。\n妙舞清歌谁是主。\n回顾。\n高城不见夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武陵春","author":"魏夫人","text":"小院无人帘半卷，独自倚阑时。\n宽尽春来金缕衣。\n憔悴有谁知。\n玉人近日书来少，应是怨来迟。\n梦里长安早晚归。\n和泪立斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"点绛唇","author":"魏夫人","text":"波上清风，画船明月人归后，渐消残酒。\n独自凭阑久。\n聚散匆匆，此恨年年有，重回首。\n淡烟疏柳。\n隐隐芜城漏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"魏夫人","text":"落花飞絮。\n杳杳天涯人甚处。\n欲寄相思。\n春尽衡阳雁渐稀。\n离肠泪眼。\n肠断泪痕流不断。\n明月西楼。\n一曲阑干一倍愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"魏夫人","text":"西楼明月。\n掩映梨花千树雪。\n楼上人归。\n愁听孤城一雁飞。\n玉人何处。\n又见江南春色暮。\n芳信难寻。\n去后桃花流水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"魏夫人","text":"红楼斜倚连溪曲。\n楼前溪水凝寒玉。\n荡漾木兰船。\n船中人少年。\n荷花娇欲语。\n笑入鸳鸯浦。\n波上暝烟低。\n菱歌月下归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"魏夫人","text":"溪山掩映斜阳里。\n楼台影动鸳鸯起。\n隔岸两三家。\n出墙红杏花。\n绿杨堤下路。\n早晚溪边去。\n三见柳绵飞。\n离人犹未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题妙庭观","author":"魏仲恭","text":"九转凡成吞绛雪，霓旌缥缈升丹阙。\n瑶池因到阿母家，笑傲壶中闲日月。\n蟠桃一熟千年久，为君持献流霞酒。\n不应移种上林春，红颜聊驻人间寿。\n回首桑田几翻覆，世上黄粮犹未熟。\n暂来仙馆拂尘埃，静对吟风几竿竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽薛艮斋 其一","author":"魏兴祖","text":"奥学传伊洛，平生尽此心。\n多闻推子贡，一唯妙曾参。\n知识皆文武，才猷冠古今。\n斯人苦斯疾，吾党恨尤深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽薛艮斋 其二","author":"魏兴祖","text":"至理穷微妙，经纶特绪馀。\n鄂城资豫备，淮甸得安居。\n慨慷陆公奏，详明贾谊书。\n今辰恨埋玉，恸哭满乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早朝","author":"魏吉甫","text":"鸣珂晓入奉天门，仰见宸居气象尊。\n斗转星回新岁月，龙盘虎踞旧乾坤。\n国威震叠边陲肃，帝泽汪洋浪井温。\n雒邑镐京相对峙，万年周业付神孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过玉林","author":"魏庆之","text":"一步离家是出尘，几重山色几重云。\n沙溪清浅桥边路，折得梅花又见君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶题","author":"魏庆之","text":"庭夜酣红杏，墙阴染碧苔。\n吟翁醉未醒，啼鸟去还来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张敬仲寒岩瀑泉","author":"魏庆之","text":"朱弦莫余和，落指空琅然。\n天风远送将，去作碧岩泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答玉林示","author":"魏庆之","text":"一吟一咏一相思，满纸银钩满纸诗。\n深院沈沈人悄悄，落花片片雨垂垂。\n蹉跎二月还三月，点检新枝□□□。\n愁绝问春春不语，见君何地会何时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"魏庆之","text":"今宵方对月，何日结忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题四明张氏南园","author":"魏汝贤","text":"修篁曲折绕墙东，风景辋川孰与同。\n过雨凉生千树外，乱山青入一楼中。\n高人尔日联吟社，逐客当年作寓公。\n别后新诗又多少，双鱼应许寄邮筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光华亭","author":"魏伯恂","text":"亭高爽垲耸牙檐，万种森罗共一川。\n坐使江山归旧观，欣看童稚望邮船。\n柳烟烘日尘迷渚，麦浪降风翠拍天。\n民物熙熙乐康阜，可无诗酒与君传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄登秀楼","author":"魏克愚","text":"暝色秀林霏，危楼挹翠微。\n静中知必寿，乐矣自忘归。\n道话清堪对，尘襟净欲飞。\n金丹在何许，我欲扣玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄登蓬山隐居","author":"魏克愚","text":"仙境孰为真，蓬山隐独清。\n树林阴上下，楼观影峥嵘。\n雨送流泉响，禽供捣药声。\n何须天柱顶，身已在空明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"它山堰次永嘉薛叔振韵","author":"魏岘","text":"一朝堰此水，千载粒吾民。\n只仰溪为雨，何劳旱望云。\n四时人饮碧，六月稻尝新。\n流出心源泽，年年惠我鄞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回沙闸成用可斋陈公韵","author":"魏岘","text":"一堰限溪江，七乡利耕稼。\n卤汐回东溟，多水流仲夏。\n仁哉王长官，一劳贻永暇。\n长输不尽泽，绝胜晴雨乍。\n旱魃纵肆威，恃此不足怕。\n滴水一滴金，欲买真无价。\n年来沙作祟，耄倪忧日夜。\n役夫锸方举，贤帅车已下。\n丰赀发公储，严祀阐神舍。\n临流肃旌骑，问瘼穷隙罅。\n买地开一吭，纳水通百汊。\n山判不可移，石级谁敢跨。\n董正有赞府，相视皆别驾。\n仍忧竭尾闾，置栅抵立坝。\n即此是商霖，何必骄阳化。\n它山不可磨，钱秦特其亚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延庆寺","author":"魏杞","text":"开山何日事，断碣卧荒榛。\n食尽僧行脚，兵来佛舍身。\n烧痕侵殿址，租额累山邻。\n可是天魔盛，谁能问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵送汪尚书致政还乡","author":"魏杞","text":"诸贤投绂孟前期，愧我需章独厚时。\n勉徇礼经聊弭谤，敢贪荣禄计迁资。\n归兮陶令惟三径，去矣君严有二宜。\n处世功勋忘厚飨，人生知止要能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到岩豅寺劝农","author":"魏杞","text":"王事忽来此，今朝天气新。\n溪山浑是句，樽酒可无人。\n幽鸟空惊梦，残花不当春。\n飘然又归去，明月满衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送左彦武归乡","author":"魏杞","text":"折桂归来日，西风万里秋。\n锦衣天上客，红叶渡头舟。\n把酒难为别，题诗更欲留。\n明朝山水隔，何日是重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送袁朝奉芳秩满趋朝","author":"魏杞","text":"壮年鼓箧上神京，叹息惊人未一鸣。\n白发尚堪谈世事，青衫原不坠诗名。\n簿书堆案三年梦，风月张帆午夜程。\n去矣飞腾九霄上，莫忘瞻衮话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欲饭野人家见拒甚力","author":"魏杞","text":"山崦筠车转屈蟠，欲寻野店具盘餐。\n主人变色行蚕忌，客子包羞坐虱官。\n早见此生真寄寓，更知行役是艰难。\n逡巡揽袂来旁舍，晓月朦胧春梦残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴佥判之官濠州","author":"魏杞","text":"举觞属明月，送君江上舟。\n王事知有程，翩然不可留。\n濠梁古佳郡，观鱼记庄周。\n年来边徼清，桑麻被田畴。\n有诏蠲民租，拊摸赖郡侯。\n乐入芙蓉幕，君其赞嘉猷。\n佥曹簿领馀，拄颊兴未休。\n淮山千万叠，丐君回青眸。\n才命各有时，行止非人谋。\n主公方拔士，入奉甘泉游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 夜泛镜湖","author":"魏杞","text":"一叶鉴中来，两岸青山起。\n送我红蕖万柄香，疑在蓬壶里。\n天地莹无尘，巾袂凉如水。\n白浪无声月自高，不是人间世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"魏杞","text":"冰肤玉面孤山裔。\n肯到人间世。\n天然不与百花同。\n却恨无情轻付、与东风。\n丽谯三弄江梅晓。\n立马溪桥小。\n只应明月最相思。\n曾见幽香一点、未开时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊罗庙","author":"魏良臣","text":"清白声华正直风，数千馀载誉增隆。\n侯封忠洁缙绅外，庙外汩罗烟霭中。\n新宇有功脩已顿，旧碑无字读难穷。\n他年我若官湘楚，愿采遗言问钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖贤山访戴叔伦隐处","author":"魏良臣","text":"峰列洪都秀，名贤隐此间。\n乱烟横古木，啼鸟恋深山。\n我亦寻诗到，人谁访戴还。\n高吟今不见，流水自潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小园梅未尽放叔用府教以诗索和勉用韵以谢","author":"魏近思","text":"造化机缄莫恨迟，须知开谢各因时。\n物华未分随春意，梅蕊先饶露玉肌。\n雪里精神千万态，水边潇洒两三枝。\n何当携酒浇花去，且遣诗筒为报知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大谏诗笔因题绝句","author":"魏闲","text":"文如吐凤笔如龙，珍重华林墨尚浓。\n清气已销名迹在，世间谁复继仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三冈湖观月","author":"魏叔介","text":"波月互吐吞，清光忽下上。\n风来山影开，空水相磨荡。\n烟树映交加，碎入渔家网。\n仿佛华子冈，吟诗独来往。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥","author":"魏宗","text":"闻说招提景，昙花结翠云。\n晴光朝更合，岚气晚来分。\n梵语微茫韵，钟声杳霭闻。\n无由问禅法，坐对柏炉薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游君山","author":"魏宝光","text":"海角天高月满山，新亭清泪洒斓斑。\n春风吹断兴亡梦，潮落潮生小石湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 饮芜湖雄观亭","author":"魏庭玉","text":"璧月挂银汉，冷浸一江秋。\n天公付我清赏，仙籍桂香浮。\n极目江山如画，际晚云烟凝紫，秋色豁羁愁。\n领看上雄观，波影动帘钩。\n雁排空，渔唱晚，楚天幽。\n湖阴一曲千载，成败倩谁筹。\n试问谪仙何处，唤起于湖同醉，小为作遨头。\n老子欲起舞，摆脱利名休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎 赠送行诸客","author":"魏庭玉","text":"暮雨初收霁。\n凭阑干、一江新绿，远山凝翠。\n漠漠春阴添客思，怅望天涯无际。\n又猛省、平生行止。\n楚尾吴头多少恨，付吟边、醉里消磨矣。\n浮世事，只如此。\n阳关三叠徒劳耳。\n也何须、琵琶江上，掩青衫泪。\n一斗百篇乘逸兴，要借青天为纸。\n儿辈诧、龙蛇飞起。\n今夜月明呼酒处，待明朝、酒醒帆千里。\n且为我，唱新制。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越中怀古","author":"魏庭坚","text":"句无亭下驻骖騑，鉴水寒光照客衣。\n张翠鄂君舟上去，浣纱西子网中归。\n禹祠草树空春色，秦望风烟半夕晖。\n王谢胜游何处问，茂林修竹尚依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见远亭","author":"魏某","text":"金山鳌耸压蓬宫，见远堂开万象空。\n心与天游身世外，眼随云到有无中。\n岭头树接苍梧北，海面帆来日本东。\n此景舂容吟不尽，丹青图写愧宗工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"它山堰和应煟韵","author":"魏洽","text":"几何水作四时雷，试去寻源棹懒回。\n欲看泽民千古样，我来不是等闲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头","author":"魏顺之","text":"人世斗南瑞，天上璧东星。\n谁分佳种，钟作间世玉麒麟。\n本是南阳相种，来应瑞龙间气，试听即英声。\n若问贤相敌，君去问参军。\n质金浑，标玉立，气冰清。\n梅花时候，结子便可鼎调金。\n人谓丹山苞凤，天产渥洼骏骨，德毓窦家椿。\n来作汤饼客，何幸厕嘉宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范公希文怀庆朔堂","author":"魏兼","text":"使君去后堪思处，庆朔堂前独到来。\n桃李无言争不怨，满园红白为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"魏兼","text":"茗泛绿云收北苑，稻炊红玉取西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆门别张天觉","author":"魏泰","text":"秋风十驿望台星，想见冰壶照坐清。\n零雨已回公旦驾，挽须聊听野王筝。\n三朝元老心方壮，四海苍生耳已倾。\n白发故人来一别，却归林下看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"魏掞之","text":"挂天师，撑著眼，直下觑。\n骑个生狞大艾虎。\n闲神浪鬼，辟惵他方远方，胡底，更敢来、上门下户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大安铺","author":"魏梅我","text":"又望前村里，深溪快渡槎。\n牛羊半山坞，鸡犬几人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次前韵兼乞鹤","author":"魏野","text":"君去华亭鹤又殂，眼前空见众禽雏。\n欲凭转乞为閒伴，许史多情许我无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府大同王太尉六首 其六","author":"魏野","text":"子细曾看九老图，科名官职尽难如。\n更思吕望同君岁，犹自磻溪坐钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府大同王太尉六首 其五","author":"魏野","text":"荐士满朝称弟侄，教民到处过儿孙。\n就中治陕偏清净，不似侯门似道门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府大同王太尉六首 其四","author":"魏野","text":"健拥旌幢七十馀，苦吟还似在山居。\n腹中万卷犹嫌少，更待邻州借僻书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]