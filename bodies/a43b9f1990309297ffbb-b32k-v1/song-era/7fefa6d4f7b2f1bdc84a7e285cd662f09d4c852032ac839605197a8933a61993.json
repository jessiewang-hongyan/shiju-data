[{"title":"秋日闲居二首 其一","author":"潘玙","text":"诗困权时卧竹窗，梦闲随雁到衡阳。\n觉来落日窥帘影，茶鼎松风泼鼻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"爱柳","author":"潘玙","text":"万紫千红锦织成，一宵风雨尽飘零。\n争如杨柳全春色，不管春归色自青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花二首 其一","author":"潘玙","text":"雪中独爱此花开，莫笑花飞委绿苔。\n骨里有香吹不散，明年依旧领春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野人家二首 其二","author":"潘玙","text":"映门绿叶长桑麻，满地深黄菜著花。\n祇道春风恋城市，也留情向野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼","author":"潘玙","text":"凉桐叶叶按秋声，搔首危楼百感生。\n天欲尽头烟水阔，雁拖残日下芜城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道宫夜醮","author":"潘玙","text":"五云宫阙拥霓旌，子夜誊章扣玉清。\n星月满坛尘不动，天风吹落步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁","author":"潘玙","text":"岁岁来宾似有期，此心非恋稻粱肥。\n不怜不带中原信，空对西风作字飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲杜鹃","author":"潘玙","text":"把握年光属大钧，花开花落不由春。\n杜鹃若是知机早，归去何须苦劝人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薝卜花","author":"潘玙","text":"未说司花刻玉工，人知名与佛相同。\n可怜结了黄金子，依旧身归色界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九里松路上","author":"潘玙","text":"联骑松边路，天将晓色分。\n涧鸣泉溅石，山暗树栖云。\n诗梦迎风醒，钟声想寺闻。\n只嫌搅清思，乌鹊噪纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丈亭","author":"潘玙","text":"今古此行路，往来无了期。\n荒亭尘压旁，废庙土侵碑。\n日落空江暮，山遥去鸟迟。\n待潮潮未长，沽醉且吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小窗","author":"潘玙","text":"小小明窗瞰水开，惜花常是手亲栽。\n春山欲晓听莺语，社雨才晴认燕来。\n自涤砚砖闲试墨，笑持茗椀胜衔杯。\n有时细鍊推敲字，搔首斜阳立几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小窗即事","author":"潘玙","text":"小窗秋色静，云影弄斜阳。\n山带雨馀翠，菊存霜后香。\n诗情多冷澹，酒态强轩昂。\n近得梅为友，相看风味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山处","author":"潘玙","text":"浮云富贵不关心，只向闲中寄此生。\n山色四时仁者静，梅花万古圣之清。\n惯临风月搜吟趣，无复江湖梦客程。\n独爱邻僧常过我，一瓯茶罢事棋枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山圃梅","author":"潘玙","text":"旧种梅盈圃，山居未是贫。\n腊前春讯息，林下玉精神。\n水月西湖梦，风霜晚岁身。\n分明隐君子，不肯惹红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书寓居壁","author":"潘玙","text":"家枕官河住，楼闲春已深。\n水风清燕语，帘日碎桐阴。\n煮茗降书困，焚香启道心。\n浮云轻富贵，城市即山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书道者庵","author":"潘玙","text":"心与道相安，幽居远市廛。\n分花栽别圃，煮茗试新泉。\n地僻全成隐，身闲半是仙。\n金丹非易鍊，此法向谁传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆舍弟","author":"潘玙","text":"汝向下邳去，吾犹上国居。\n几番曾入梦，十月不收书。\n血满干戈地，尘飞盗贼墟。\n无人问消息，生死竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王岩幽隐居","author":"潘玙","text":"一片清闲福，山间结小庐。\n此身为隐计，有地学农锄。\n午饮煎溪茗，朝羹摘野蔬。\n无人知姓字，可以避徵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家","author":"潘玙","text":"田事收成了，仓箱积万千。\n鸡鸣秋屋外，牛卧夕阳边。\n溪树争收果，村醪不值钱。\n幸无征役苦，一醉乐丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华藏云海亭","author":"潘玙","text":"一亭突兀出湖边，惯与渔翁系钓船。\n吴越兴亡今已矣，山川流峙只依然。\n诗情空寄千年恨，眼力谁穷万里天。\n独有缁郎闲似我，却于鸥鹭结清缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寺中","author":"潘玙","text":"春深寺逾静，云伴小窗闲。\n客思落花里，鸡声疏竹间。\n昼全无一事，身似坐空山。\n幽意何人会，吟僧时往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冷泉亭和贾秋壑韵","author":"潘玙","text":"重到古招提，青松旧□围。\n泉声流涧远，亭影带云微。\n小雨随风去，残花逐絮飞。\n白猿呼不应，人世几斜晖。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听子规有感","author":"潘玙","text":"客边听子规，忍见百花飞。\n唤得春先去，如何汝未归。\n蜀山仍旧在，世事觉今非。\n只合三缄口，空林伴夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听雁有感","author":"潘玙","text":"怕听云间雁，新愁上客眉。\n尖风欺破褐，落日迫残棋。\n菊老休赊酒，梅开又费诗。\n鸰原千里隔，谁与话心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居","author":"潘玙","text":"厌于奔走乐闲居，湖海交游任阔疏。\n燕去又为千里客，雁来谁寄一行书。\n青山对面如相识，白发无情亦懒梳。\n屋外有园三数亩，春风尽可学耕锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮张一斋月台","author":"潘玙","text":"同上最高台，山头晚色开。\n风才驱雨去，月渐出云来。\n世事悲秋扇，吟情付酒杯。\n谁家砧杵动，寒计又相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捲帘","author":"潘玙","text":"捲帘迎霁色，双鹊噪庭柯。\n时节清明过，园林绿荫多。\n拂鸾挥画扇，织翠试轻罗。\n欲困思煎茗，敲门有客过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和潮韵","author":"潘玙","text":"海若驱车到浙江，西风吹起水云乡。\n雷轰万鼓不成雨，雪驾千峰祇荐凉。\n犀手谩持吴弩射，貂珰空走伍祠香。\n登楼且作川鲸饮，总付兴亡与夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怕上楼","author":"潘玙","text":"凭高多感慨，怕上夕阳楼。\n云阁四山雨，江分两岸秋。\n雁来惊客意，枣熟动边愁。\n醉里看长剑，英雄志未酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招信道上","author":"潘玙","text":"岁晚行人少，兵馀败□多。\n边风鸣晓雁，淮水浴天鹅。\n昔梦所不到，今来无奈何。\n翩然策归骑，烟月自渔蓑。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枕上闻钟","author":"潘玙","text":"酒醒残月明，攲枕听钟声。\n风露秋将晚，家山梦辄惊。\n客尘侵老鬓，官职借虚名。\n却羡僧无事，此心如水清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中九日","author":"潘玙","text":"破帽西风急，寒窗败叶飞。\n重阳今日是，三径几时归。\n檐上多黄菊，门前少白衣。\n吟情淡如水，一雁叫斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居","author":"潘玙","text":"数椽依碧嶂，飞瀑溅藤萝。\n地僻行人少，夜凉明月多。\n生涯安澹薄，乐事在吟哦。\n病后惟便睡，秋蛩聒砌莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日江居","author":"潘玙","text":"家枕沧江住，西风捲暮秋。\n云行天欲动，潮长屋如浮。\n落叶悬渔网，斜阳满客舟。\n吟成谁管领，拍手唤沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览镜","author":"潘玙","text":"览镜颜如改，登楼足尚疲。\n惜于多病里，过了少年时。\n对月能忘酒，看花间有诗。\n独馀豪气在，频把剑尘吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送朱静佳簿君归","author":"潘玙","text":"武夷山下路，此去几时程。\n检历冬将暮，驱车月正明。\n客边聊话别，吟里莫寒盟。\n只怕除书到，中途趣入京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吟卷还赵万里","author":"潘玙","text":"吟中蜚隽声，太白是前身。\n风月无非我，江山得主人。\n冰梭织古锦，庙瑟奏阳春。\n洗眼观新稿，客怀清绝尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宣昭子游淮","author":"潘玙","text":"几年携剑过边城，非但谭兵善用兵。\n果是胸中抱材气，肯于纸上立功名。\n事当著力机须敏，人匪知心语莫轻。\n况有故交能刮目，此行端不负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送胡月山游浙西","author":"潘玙","text":"西湖摽隽名，谁不缔吟盟。\n长说贫为累，犹嫌思未清。\n残编饥鼠齧，破壁乱蛩鸣。\n一棹松江去，故人应动情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送柴仲山归里","author":"潘玙","text":"长台在何处，俄听话归期。\n雪霁千山月，梅开一路诗。\n京尘随地尽，春色到家知。\n欲把西湖酒，重来是几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷叶浦","author":"潘玙","text":"残照明衰草，斜风掠小船。\n虽过荷叶浦，不是藕花天。\n雁影浮寒水，鸦声落暮烟。\n年丰时节好，清兴满吟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看剑有感","author":"潘玙","text":"开匣看长剑，功名志莫酬。\n中原何日复，世事与谁谋。\n豪杰多相忘，干戈卒未休。\n斜阳照青野，雁过亦含愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"停鞍","author":"潘玙","text":"古驿晚停鞍，西风客帽寒。\n山昏云气湿，秋老叶声乾。\n昔为作诗苦，今嗟行路难。\n铃音边报急，醉里亦眉攒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄适园朱表兄","author":"潘玙","text":"适园分袂后，又复半年馀。\n笑我多行役，无书话起居。\n溪山虽地隔，兄弟可情疏。\n办得归耕计，相依结小庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹娥堰打船","author":"潘玙","text":"曹娥庙前路，平日几经行。\n浦浅舟难入，月斜潮始生。\n牛随堰索转，犬吠燎盆明。\n上得官河去，心安睡可成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花二首 其二","author":"潘玙","text":"冰玉丰姿夐绝尘，山林谁伴岁寒盟。\n腊前有雪曾相约，天下无花似此清。\n不待春风施造化，只嫌晚角说平生。\n月香水影吾家事，却被诗人掠美名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨山李王祠","author":"潘玙","text":"白玉楼成阅几春，今瞻祠貌俨如生。\n一麾出守唐朝旧，八字封王宋爵荣。\n花发梨山存故迹，水流柘浦响清声。\n传闻有祷须形梦，能使人知桂籍名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野人家二首 其一","author":"潘玙","text":"枯藤伴棕屦，行到野人家。\n细雨肥梅实，轻风动菜花。\n村深难贳酒，客至旋煎茶。\n笑说生涯事，栽桑与种麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上寺","author":"潘玙","text":"西湖风物好，每被寺僧分。\n榻卧通宵月，窗开叠嶂云。\n天宽多境界，地静隔嚣氛。\n忆昔陪清话，平生所未闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖边","author":"潘玙","text":"久不到湖边，春风忆去年。\n看来游览地，难值艳阳天。\n花柳矜新态，溪山际宿缘。\n逢僧知寺近，索茗且谭禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖居","author":"潘玙","text":"旋营小屋并湖滨，最喜闲身叶样轻。\n俗子过门令我病，好山到眼觉心清。\n新开白地多栽竹，怕惹红尘少入城。\n鱼鸟忘机自飞泳，酒边尽可助吟情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖船分得行字韵","author":"潘玙","text":"三月莺花烂熳春，寻芳谁不趁清明。\n要为终日看山计，只买扁舟载酒行。\n老柳半枯存古意，浮云多变类人情。\n何时结屋西湖上，雨笠烟蓑寄此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲雁","author":"潘玙","text":"羽族无如尔列行，于时底事较炎凉。\n应嫌塞北多风雪，却向江南恋稻粱。\n春到但知归计急，火明不料祸机藏。\n自从寄了苏卿信，此后传书竟渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横舟亭","author":"潘玙","text":"与世浮沉者，中流几失维。\n此舟聊寓意，之子免乘危。\n夜雨蓬为屋，秋风钧不丝。\n莫嫌长舣岸，终有济川时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠白云道人","author":"潘玙","text":"白云堆里缚茅庐，活计无多乐有馀。\n午灶旋添烧药火，夜檠频勘养生书。\n门无过客常笼鹤，园凿新池学钓鱼。\n身远利名心似水，梦闲时复到华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠道士王玉壶","author":"潘玙","text":"屦不染凡尘，云深竹屋春。\n安心能学道，屋指别无人。\n丹熟玄机透，琴清古乐真。\n前缘君悟否，老子是龙身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山馆","author":"潘玙","text":"山馆坐秋雨，风吹霁景开。\n夕阳明远水，落叶走空阶。\n白发人谁健，黄花节又催。\n看云动孤酌，聊以尉吟怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听弹归去来辞","author":"潘玙","text":"渊明昔赋归去辞，后世寄声焦桐丝。\n先生弹罢和者谁，春山花落啼子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采桑曲","author":"潘玙","text":"东采桑，西采桑，春风陌上罗裙香。\n为怕蚕饥急归去，回头忽见薄情郎，如何富贵却相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春花吟","author":"潘玙","text":"春未来时花未觉，春欲去时花又落。\n莫言世事无始终，春亦于花太情薄。\n我今问花并问春，司花司春者何人。\n空中髣髴有神语，此当问之于大钧。\n不如再作问钧赋，赋成直上天门去。\n扣天乞与花长春，免使花飞怨春暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧铁山见赵山台","author":"潘玙","text":"山台惯与吟僧接，新剖澄江太守符。\n前日相逢曾有约，今番一见必如初。\n固知海里难为水，须认衣中自蕴珠。\n握手只谭风与月，莫因名利复踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倚栏","author":"潘玙","text":"酒醒思往事，搔首倚危栏。\n夜静风鸣树，天凉月满山。\n客情怜去燕，秋思入幽兰。\n抚剑发长啸，此身空自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读少陵近体诗","author":"潘玙","text":"少陵近体诗，其间备众体。\n鍊语发英华，立意为根柢。\n如击常山蛇，应处贯首尾。\n今人一体看，而不究其理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄翁石龟","author":"潘玙","text":"惯呼风月入毫端，人作神仙以上看。\n天赋此清梅亦逊，地因所寓稿随刊。\n符分半刺于今易，诗得全名自古难。\n洗去淫哇追大雅，能于文海障狂澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚菊","author":"潘玙","text":"可惜重阳已过期，黄花无数绕山篱。\n政缘懒作趋时态，多少幽香人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移种菖蒲","author":"潘玙","text":"谁剪苍龙髯，种之水边石。\n不与草争春，四时挺幽碧。\n余心具静观，而爱此正色。\n一朝移香根，古瓷手亲植。\n疏之以泠风，沐之以甘泽。\n得此伴闲身，凡花何足惜。\n呼童汛净室，寘彼芝兰侧。\n如参物外人，利名念俱释。\n如亲诗中仙，冷澹趣相得。\n人物本一体，清浊霄壤隔。\n物以类而聚，人于交贵择。\n人为物之灵，讵可乏真识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑渭滨归里","author":"潘玙","text":"十年学道客长安，鍊得丹成返故山。\n剩带锦囊诗料去，肯嫌黄叶路程寒。\n梅边月照人千里，竹下云封屋两间。\n此后旦评声价重，不将旧日阿蒙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬朱适园访见诗","author":"潘玙","text":"曾同山友过江湄，何处清游晚未归。\n沽酒□羊来好语，开笼放鹤在何时。\n云方卷叶收春雨，柳未吹花点客衣。\n京洛相逢宜少驻，东风杖屦好追随。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洞霄宫","author":"潘良正","text":"石坛风冷露华凝，群玉峥嵘簇画屏。\n水赤久传丹作井，山高时借翠为庭。\n鹤迎仙驭迷三岛，云入洞天朝百灵。\n回首武陵归去路，碧桃零落晚峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]