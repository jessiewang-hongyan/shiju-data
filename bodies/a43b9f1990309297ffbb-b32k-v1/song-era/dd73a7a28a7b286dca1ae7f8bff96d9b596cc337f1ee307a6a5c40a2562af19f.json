[{"title":"临桂白云洞","author":"李时亮","text":"□崖高瞰白云溪，洞穴通天路崄巇。\n雨未作霖天下旱，玉龙蟠此少人知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万里波光外，孤城南极西。","author":"李时亮","text":"数点晴明天外国，一帆风信舶家舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元喜雪","author":"杨齐","text":"灵感手擎苍龙鞭，和风一道飞腾天。\n天公欲报大有岁，六花助与芳菲权。\n紫姑云辇归时节，太光碾碎桄榔叶。\n晓来楼阁万家春，白玉鸳鸯为新叠。\n垄头耕父被单褐，望岁欣欣掉歌舌。\n王孙却恨此宵寒，兰膏冻黑香轮滑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食野外","author":"杨齐","text":"寒食人家事踏青，偶躯羸马出郊坰。\n禽声唤雨娇相语，天色和春困不醒。\n芳草碧来丝作毯，好花红处锦为屏。\n回头画角江城晚，人倚秋千月半庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食雨","author":"杨齐","text":"一片春阴一倍寒，万家春色寂无烟。\n冷催杜宇朝相唤，寒逼嫦娥夜不圆。\n添得僧家浇药水，负他公子赏花天。\n东君欲助之推怨，泪湿垂杨恨不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋后有感","author":"杨齐","text":"一雨助凉天气醒，夜来残叶报秋声。\n人歌曼倩书重发，客笑相如赋未成。\n惊破鹤心宵露重，送他鸿翼晚风清。\n功名未了男儿事，争遣心头系得旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和中秋对月","author":"杨齐","text":"素籥中分漏箭迟，玉盘飞上绛河涯。\n自缘人意誇今夜，岂是蟾光胜旧时。\n千里放开天地景，一轮题尽古今诗。\n吴刚树下遥相许，来岁春风此处期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋不见月","author":"杨齐","text":"八月露沉天气秋，霜轮何事苦淹留。\n一宵老兔不成魄，几处诗人却下楼。\n水部阶前闻细雨，袁宏渚上见归舟。\n明年未必无仙桂，何用厌厌此夜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至夜旅怀","author":"杨齐","text":"乱霜如叶扑窗寒，愁到心如欲断弦。\n凤管阳才一声起，蟾轮月已九分圆。\n拥炉酌冻酒相对，攲枕背残灯未眠。\n乞得晓钟西拜望，露中香为祝亲燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下岩避暑留题","author":"杨迈","text":"古寺重来兴转添，舟中午暑正炎炎。\n野僧引客登山阁，稚子穿云映水帘。\n热得清凉身暂健，老便闲静意难厌。\n人间劫火方撩乱，法雨如何为普沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登南山塔","author":"曹棐","text":"平生登塔与登楼，乱尽乡心送尽愁。\n试上南山山下塔，依前怀古复悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隆庆","author":"陈鹏","text":"五丁尽力路通泉，百货东来蜀道贫。\n不以粪牛欺远俗，安知指虎有强臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绵州乡贤堂","author":"陈鹏","text":"潼山高兮潼水清，厥钟秀兮乡之英。\n之人已去兮逖听风声，我怀孔切谁仪刑。\n有美张公兮开明庭，作新宫兮州之黉。\n著其为人兮加丹青，貌惟肖兮如生。\n或桐挺而孤高，或芝荂而九茎。\n或兰生兮春华，或菊秀兮秋馨。\n或凤跃而蛟翔，或凫将而鹤迎。\n使人咨嗟叹息而追惟兮，至其子孙又呜咽流涕而咿嘤。\n恍若接兮謦咳之音，内怀劝惧兮若从使令。\n亦瞻像兮昭昭，而起福兮冥冥。\n百年兮历时虽多，非张公兮谁与铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陈鹏","text":"桔柏江声犹在耳，木瓜园路已侵山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题白鹤泉","author":"田稹","text":"相仪始融结，中有灵岩川。\n佛现青莲相，山分白鹤泉。\n澄清通舜井，湛洁滉尧天。\n鞠氏留题后，菲才继此篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙氏池亭","author":"陆于城","text":"断崖青松林，林下覆烟草。\n一径扪绿萝，数里寻芳藻。\n岩开野人屋，结构凭孤岛。\n石断寒泉流，亭幽翠巘绕。\n攫拿龙虎状，宛若鬼神造。\n隔崖闻湍声，当窗见夕照。\n巴南绝景处，胜似东溪好。\n万籁清心胸，孤云豁烦恼。\n樽邀骢马客，写物穷探讨。\n琴匣闲时开，柴门不须锁。\n孰云造化工，永与天地保。\n长揖谢王侯，尘氛徒浩渺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙氏池亭得小字","author":"董英","text":"冥冥造化意，似见元气兆。\n不然此中石，诡怪安能了。\n刻划如为人，幽奇若争巧。\n虎卧溪势长，龙存鼎形小。\n诛茅得此地，胜概纷夭矫。\n东南引一水，又出人意表。\n泻溜无冬春，漰奔极昏晓。\n跳波骇潜虬，溅珠湿飞鸟。\n主人去城市，崖谷情悄悄。\n涧户云溶溶，山窗风袅袅。\n孤城重颜谢，柱史才江鲍。\n共美崖壑游，题诗石林杪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大云洞","author":"释绍崇","text":"十年踪迹住湟关，占得幽奇水石间。\n纵使王孙多富贵，有钱无处买江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居","author":"释显忠","text":"竹里编茅倚石根，竹茎疏处见前村。\n闲眠尽日无人到，自有清风为扫门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过溪口广慈院","author":"释显忠","text":"五马重来溪口寺，惟将属吏与门僧。\n盘云野径行千里，送目危台上百层。\n岩桧影寒犹带雪，溪流声涩未销冰。\n寻常地远无因到，空愧躬良二老朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其一 三生像","author":"释显忠","text":"胜域将垂迹，先闻钟梵声。\n术陀犹未降，宣老已三生。\n山接天门险，岩开月殿明。\n善财何处去，楼阁自峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其二 三层阁","author":"释显忠","text":"像身高百尺，阁道耸三层。\n欲得亲瞻向，还须最上登。\n烟霞封宝墄，星斗挂觚棱。\n已自甘香火，人閒去不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其三 隐岳岩","author":"释显忠","text":"融结自何时，曾为几陵谷。\n不见昔贤踪，空遗此岩腹。\n一径斸烟蓁，千里老云木。\n寻常人到稀，虎豹暗栖宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其四 石城山","author":"释显忠","text":"溪尽见石城，寺在石城里。\n崖缺露遥村，门开对寒水。\n况非雉堞成，无以金汤比。\n梵众此安栖，俗驾来有几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其五 白云庄","author":"释显忠","text":"堪爱仙庄近翠岑，杖藜时得去游寻。\n牛羊数点烟云远，鸡犬一声桑柘深。\n高下闲田如布局，东西流水若鸣琴。\n更听野老谈农事，忘却人间万种心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其六 夹溪塘","author":"释显忠","text":"南溪北溪深，横塘截流过。\n清影照人寒，澄耀分鉴破。\n沙明鸥鹭驯，草密牛羊卧。\n不见直钩翁，狂歌遣谁和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其七 柔亭","author":"释显忠","text":"孤亭枕长溪，溪光照亭槛。\n无人弄潺湲，终日对平淡。\n猿鸟去难呼，藤萝垂可揽。\n薄暮众山昏，霜风起葭菼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其八 石狻猊","author":"释显忠","text":"亭除两狻猊，一仰复一俯。\n告天与叩地，似欲诉忧苦。\n世传知顗死，二兽来瞻睹。\n逡巡化为石，堙没在深土。\n事怪固难诘，但见形可取。\n风雨驳苍苔，万古万万古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其九 齐相井","author":"释显忠","text":"南明山足势欲尽，正是新崖东胁隈。\n不知泉自那峰出，皆谓井因齐相开。\n甘滑堪预郦经载，渊渟疑俟桑苧来。\n神蛟往往此潜蛰，旱岁莫测生风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其十 齐相书堂","author":"释显忠","text":"异代终难问，遗名不可穷。\n山中丞相去，林下学堂空。\n映雪功休比，冲天志莫同。\n故基兰蕙满，犹自起华风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其十一 白莲庵","author":"释显忠","text":"谁将白莲子，固向峰顶栽。\n非学远公社，兼无陶令来。\n去世迹何旷，诛茅心已灰。\n不知岁月改，但见此花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其十二 石缝梅","author":"释显忠","text":"根埋山骨几百载，但怪生物偏有私。\n春前受气地犹冷，雪里暗开人未知。\n自将孤石比坚性，不与众木争芳姿。\n惆怅无言为真赏，栏干独倚觉多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其十三 锯解峰","author":"释显忠","text":"苍山巍不倚，中裂势难图。\n始铸阴阳锯，谁开造化炉。\n藤摇疑落屑，树折若分符。\n漏出飞泉影，长垂一带孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其十四 仙髻峰","author":"释显忠","text":"首出众峰间，盘龙势孤耸。\n云映鬓光浮，月生梳影动。\n可握谓新沐，未巾疑乍拢。\n幸免旦斯理，谁复惭种种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南明山宝相寺十五题 其十五 白鹇坞","author":"释显忠","text":"朝看白鹇从坞出，暮看白鹇从坞归。\n森森绿树两峰下，片片白云初日飞。\n因知野性恋山谷，咫尺之间还见稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释显忠","text":"咄咄咄，海底鱼龙尽枯竭。\n三脚虾蟆飞上天，脱壳乌龟火中活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答无为居士杨杰","author":"释本嵩","text":"情智何尝异，犬吠蛇自行。\n终南的的意，日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠欧阳?","author":"刘秘","text":"妙笔君今第一人，心欺造化夺天真。\n精明形骨从来一，移入青缣作两身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"朱适","text":"烧残红烛客未起，歌断一声尘绕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留壁诗","author":"邵琥","text":"往往来来三十年，更无踪迹在西川。\n功成行满升天去，回首山头月正圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"邵琥","text":"碧桃红杏神仙府，粉壁朱门将相家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶感呈苏先生","author":"濮本","text":"好手不甘袖，日对棋一枰。\n雄争汉楚垒，秘逞孙吴兵。\n偾着还自错，先机非偶赢。\n古今多少事，落尽此空声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"黄曦","text":"春风桃李凤翔台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石井联句","author":"傅概","text":"山川百千景，斯并诚夐绝。\n灵源若神涌，怪石肖天裂。\n不与浊流并，恐是众泉杰。\n银汉河分派，玉壶冰借洁。\n中夜声激怆，四时光秀澈。\n泾渭耻淆杂，潢潦愧涸竭。\n润如周孔教，清比夷齐节。\n观鱼思文望，对岩梦武说。\n我欲断谄佞，汲此洗剑血。\n我欲安庙社，磨此镂勋碣。\n诗以志本心，书之非诡说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"买山","author":"刘煇","text":"顶摩霄极根盘溪，买得入手空家赀。\n回环四面终日看，埋没几年知者谁。\n剔除冗土洁且快，布列诸峰高复卑。\n时人应笑狂生僻，不喜金珠喜怪奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洗山","author":"刘煇","text":"蟠根耸翠压坤柔，纵有连城价莫酬。\n萝蔓几年尝满目，途人今日始回头。\n尘埃已逐双溪去，风月来供一境幽。\n欲识主人营创苦，壮龄先备赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题鹅湖恭上人山亭","author":"刘煇","text":"斸险得形胜，破荒成敞虚。\n四山秋月午，万里晓晴初。\n远日去无限，清风来有馀。\n溺迷纷扰者，登此亦消除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与客游太平僧舍","author":"刘煇","text":"两道翠阴迎骑合，四围清气逼人来。\n林端有路云千级，物外忘机酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石井联句","author":"程逵","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏裕老庵前老松","author":"王韶","text":"绿皮皱剥玉嶙峋，高节分明似古人。\n解与乾坤生气概，几因风雨长精神。\n装添景物年年换，摆捭穷愁日日新。\n惟有碧霄云里月，共君孤影最相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南城","author":"王韶","text":"南城古要地，险隘接闽区。\n国家建昌垒，镇守东南隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东林泉","author":"王韶","text":"晋朝危乱有遗贤，陶谢宗雷总学禅。\n释殿夜深神运木，社堂秋后玉成莲。\n泉喷绣谷长时雨，云拥香炉白昼烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投机颂","author":"王韶","text":"昼曾忘食夜忘眠，捧得骊珠欲上天。\n却向自身都放下，四棱塌地恰团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"王韶","text":"草堂旧集三千首，莲社遗踪七百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"王韶","text":"鄂陵事稀简。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"王韶","text":"涂山广大纳万国，帝禹于此分江河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋待月夜分乃见","author":"范百禄","text":"十二周流数，经行自不迟。\n长圆非物理，暂晦亦天时。\n人欲终宵玩，云残逐簇移。\n祇应逢此景，无足累心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"范百禄","text":"馀事诗名夐绝尘，琐闱仙殿老成人。\n虏庭上座衣冠壮，庾岭南州雉堞新。\n太白山云旬日雨，若邪溪水四时春。\n吾皇倚待唯三九，不用夸乡诏买臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剑阁","author":"范百禄","text":"山从开辟以来有，关是王公设险名。\n直上剑门千万仞，中开门阙数重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"范百禄","text":"携月入上清，一览无馀山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"范百禄","text":"门外清冷百社潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"范百禄","text":"山环襟带连秦岭，地控烟喉限蜀城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其一","author":"释元祐","text":"为僧六十鬓先华，无补空门愧出家。\n愿乞封回礼部牒，免孤蜁老衲袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其二","author":"释元祐","text":"凡见圣见，春云掣电。\n真说妄说，空花水月。\n翻忆长髭见石头，解道红炉一点雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其三","author":"释元祐","text":"龟毛为箭，兔角为弓。\n那吒忿怒，射破虚空。\n虚空扑落，倾湫倒岳。\n墙壁瓦砾放光明，归依如来大圆觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈 其四","author":"释元祐","text":"月色和云白，松声带露寒。\n好个真消息，凭君子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释道圆","text":"不落不昧，僧俗本无忌讳。\n丈夫气宇如王，争受囊藏被盖。\n一条概栗任纵横，野狐跳入队。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释道圆","text":"不是风兮不是幡，白云依旧覆青山。\n年来老大浑无力，借得忙中些子闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚空无内外，事理有短长。顺则成菩提，逆则成烦恼。灯笼常瞌睡，露柱亦懊恼。大道在目前，更于何处讨。","author":"释子琦","text":"四面亦无门，十方无壁落。\n头髼松，耳卓朔。\n个个男儿大丈夫，何得无绳而自缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读书","author":"刘挚","text":"西风入梧桐，白露下云汉。\n洒洒晚秋色，清凉复神观。\n岁月不我与，料理前日慢。\n念此平生心，所乐在黄卷。\n太羹与玄酒，梨楂及俎籑。\n滋味要足口，更复恨未见。\n灯火夜可亲，巾箱字甚惮。\n纷纷事是非，碌碌世治乱。\n千古守糟粕，未免斲轮叹。\n圣贤有堂奥，大道堪夷坦。\n是为名教乐，足以了衰晏。\n惜日营珠金，投身醟歌管。\n彼志各自言，难以一理贯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":44070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]