[{"title":"和张功父闻子规","author":"杨万里","text":"久雨今朝忽作晴，老人怀抱不胜清。\n仲宣久作登楼赋，望帝更吟当殿声。\n春去春来浑是梦，花开花落若为情。\n归心不用渠催唤，自有江鸥与狎盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父桤木巴榄花韵","author":"杨万里","text":"南湖窠木已交加，种榄栽桤更北涯。\n生眼错呼为夜合，新莺知不是桃花。\n绿阴四合藏云屋，翠浪全机织素纱。\n桂隐主人臞见骨，不餐酥酪却餐茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父病中遣怀","author":"杨万里","text":"人自穷通诗自诗，管渠人事与天时。\n鹤长未便贤凫短，梅早那须笑杏迟。\n公子近来忺说病，老夫秋至不曾悲。\n人生随分堪行乐，何必兰亭与习池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父梦归南湖","author":"杨万里","text":"一生两事苦相关，从仕居贫并作难。\n顾我雪穿行脚袜，羡君身作在家官。\n晓分京兆月半璧，夕问南湖水几竿。\n桃李能言春满坐，向人犹自诉霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李与贤投赠之韵","author":"杨万里","text":"云海不教鹏怒飞，玉阶也合凤来仪。\n如何天下李元礼，未遇人间钟子期。\n夜诵子虚无路达，梦生春草只心知。\n愿君更奏三千牍，金榜青衫染柳丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟二首 其二","author":"杨万里","text":"句法天难秘，工夫子但加。\n参时且柏树，悟罢岂桃花。\n要共东西王，其如南北涯。\n肯来谈个事，分坐白鸥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李天麟二首 其一","author":"杨万里","text":"学诗须透脱，信手自孤高。\n衣钵无千古，丘山只一毛。\n句中池有草，子外目俱蒿。\n可口端何似，霜螯略带糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陆务观用张季长吏部韵寄季长兼简老夫补外之行二首 其二","author":"杨万里","text":"别去公怀我，诗来我梦公。\n半轮笠泽月，一信镜湖风。\n岂有诗名世，而无鬼作穷。\n管城言晓事，犹欲策元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陆务观用张季长吏部韵寄季长兼简老夫补外之行二首 其一","author":"杨万里","text":"今代老龟蒙，无书遗子公。\n也能将好句，特地寄西风。\n迟暮甘三已，飘零笑两穷。\n绝怜张与陆，百战角新功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陆务观惠五言","author":"杨万里","text":"官缚春无分，髯疏雪更欺。\n云间堕词客，事外得心期。\n我老诗全退，君才句总宜。\n一生非浪苦，酱瓿会相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈蹇叔郎中乙巳上元晴和","author":"杨万里","text":"御柳梢头晚不风，官梅面上雪都融。\n如何阊阖新春夜，顿有芙蕖满眼红。\n十里沙河人最闹，三千世界月方中。\n买灯莫费东坡纸，今岁鳌山不入宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周子中病中代书之韵兼督胡季文季永游山之约","author":"杨万里","text":"吟外今何病，愁边我索居。\n昔无今样懒，新欠故人书。\n只说游山去，谁令作计疏。\n衡庐负我辈，我辈负衡庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周子中韵","author":"杨万里","text":"清愁政尔喜逢兄，一笑那知客帝城。\n海气不曾晴色好，梨花半落嫩寒生。\n刑书夜诵端何苦，诗句春来想不平。\n我亦有怀无处说，对床只欲为渠倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周元吉左司郊祀庆成韵","author":"杨万里","text":"八觚泰畤六郊天，一柱明堂再飨先。\n日月旂常寒映雪，冕旒珠玉暖生烟。\n风回韶濩龙鳞外，花覆貔貅凤阙前。\n喜溢天颜应未了，又迎庆寿入新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周元吉左司梦归之韵","author":"杨万里","text":"半似清狂半白痴，不须人笑我心知。\n烟霞平日真成癖，山水中年却语离。\n错计浪随云出岫，感君能遣雨催诗。\n居然唤起还家梦，橘刺藤梢隔槿篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周元吉省中新竹","author":"杨万里","text":"青士何年下大荒，羽仪禁省立如墙。\n锦绷半脱娟娟玉，粉节新涂拂拂霜。\n带雨小酣三日后，出林忽喜一梢长。\n今年秋闰防多暑，剩供先生格外凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲觉三首 其三","author":"杨万里","text":"春在梅边动，寒从月外来。\n贫于萤不暖，心与烛俱灰。\n此意悠悠著，从谁细细开。\n病来更忧患，泪尽只馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲觉三首 其二","author":"杨万里","text":"月淡犹明树，霜严不剩云。\n天寒一雁叫，夜半几人闻。\n诗只令吾瘦，清聊与子分。\n频来仍恨少，此去更离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲觉三首 其一","author":"杨万里","text":"书懒聊遮眼，诗穷只掉头。\n寒醒非不睡，薄醉奈何愁。\n火细霜还重，风停叶自投。\n半生灾疾里，谁遣未休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲容春日二律句 其一","author":"杨万里","text":"饥民日夜去，也有不荒田。\n旧雨仍新雨，今年胜去年。\n未嫌诗得瘦，只苦茗妨眠。\n花气薰人醉，来从若个边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和周仲容春日二律句 其二","author":"杨万里","text":"今晨晴颇懒，昨夜雨犹声。\n欲社燕先觉，半春莺未鸣。\n诗非一字苦，句岂十分清。\n参透江西社，无灯眼亦明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和昌英主簿叔久雨","author":"杨万里","text":"积雨今晨也解休，殷勤日脚傍花流。\n半明衣桁烘梅润，全为农家放麦秋。\n更著好风堕清句，不知何地顿闲愁。\n新晴佳处无人会，隔柳一声黄栗留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和昌英主簿叔社雨","author":"杨万里","text":"愁已春相背，诗仍债未还。\n雨声宜小睡，竹户且深关。\n梦钓鸥边雪，衰忘镜里颜。\n起来聊觅句，句在眼中山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和昌英主簿叔送花","author":"杨万里","text":"去岁归时正牡丹，亲庭上寿撚花看。\n共知春好毋虚掷，更复杯深肯剩残。\n谁料今兹千万感，强从叔也两相宽。\n风颠雨急关侬事，时序撩人只暗叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和昌英叔夏至喜雨","author":"杨万里","text":"清酣暑雨不缘求，犹似梅黄麦欲秋。\n去岁如今禾半死，吾曹遍祷汗交流。\n此生未用愠三已，一饱便应哦四休。\n花外绿畦深没鹤，来看莫惜下邳侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其九","author":"杨万里","text":"且爱灯檠短，宁论剑铗长。\n芝兰照春紫，编简著人香。\n贺监聊吴语，昌黎岂楚狂。\n豹文元炳蔚，未信雾能藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其六","author":"杨万里","text":"花柳春全盛，池塘燕学飞。\n晚晴还小立，暮色不能归。\n草远天无壁，苔深水有衣。\n山居自清绝，不必扣禅扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其五","author":"杨万里","text":"园花皆手植，梅蕊独禁寒。\n色与香无价，飞和雪作团。\n数枝横翠竹，一夜绕朱栏。\n不惜吟边苦，收将句里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其一","author":"杨万里","text":"世方争速化，渠独请真祠。\n意在升沉外，官无冷热宜。\n山如辋川画，地似习家池。\n若道闲居懒，如何有十诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其七","author":"杨万里","text":"酒客来中散，诗僧约惠勤。\n共听茅屋雨，添炷博山云。\n万事休多问，三杯且一醺。\n君看醉中语，不琢自成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其四","author":"杨万里","text":"漫浪真堪老，丁宁勿语人。\n屐痕浑似齿，巾角小于纶。\n从事固不恶，贤人也似醇。\n空瓶未应卧，只恐恼比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其十","author":"杨万里","text":"眼底无群子，毫端有百川。\n脩名如揭月，馀事亦凌烟。\n剩欲携藤去，相从听雨眠。\n恐渠即霄汉，泉石罢潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济山居十咏 其二","author":"杨万里","text":"老子朝慵起，春风苦唤行。\n晴边犹著雪，寒后未闻莺。\n偶见千峰翠，偏令两眼明。\n倦来浑欲睡，无处避溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济教授雪二首 其二","author":"杨万里","text":"飞来须面旋，欲堕更横斜。\n不遣诗人懒，惟禁酒力加。\n镂冰初试手，剪水便成花。\n谁会欧苏律，吟边别一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和罗巨济教授雪二首 其一","author":"杨万里","text":"天悭聊尔落，地暖未教深。\n犹放遥岑碧，偏鸣密竹林。\n似供愁里眼，小恼客边心。\n诗卷开还阖，清寒溢素襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姜邦杰春坊再赠七字","author":"杨万里","text":"可笑诗人死爱名，吻间长作候虫声。\n鍊成九转丹砂著，赢得千茎白雪生。\n政使古今传不朽，不知身世竟何成。\n老夫老去真休去，一听梅山主夏盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和济翁见寄之韵二首 其二","author":"杨万里","text":"四海皆兄弟，何如真弟兄。\n吾今有弟在，眼只为渠横。\n剩欲驱涛壮，犹应倒峡清。\n青春不可又，未欲傍长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和济翁见寄之韵二首 其一","author":"杨万里","text":"只有高为累，元无俗可离。\n正缘隔少面，添得许多诗。\n杜老吟边树，山公醉处池。\n犹须谋一笑，天许又何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和济翁弟惠诗二首 其二","author":"杨万里","text":"相思何所似，饥者食仁频。\n此客非常客，诗人太逼人。\n黄初那足过，子建巧能亲。\n台阁俱知己，谁能荐子真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和济翁弟惠诗二首 其一","author":"杨万里","text":"竟岁不得面，移书焉用频。\n我方得吾弟，今岂有斯人。\n海内友非少，谈间子独亲。\n醉馀无浪语，尤见醉中真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和济翁惠诗","author":"杨万里","text":"语妙浑忘夜，杯行未厌频。\n平生憎俗子，胜处要吾人。\n已结诗中社，仍居族里亲。\n酒边不著句，何许见天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和祝汝玉作举子语之句","author":"杨万里","text":"玉奴何必减花奴，省识春风作画图。\n临水隔花看走马，翻身射雁落彫弧。\n词场君擅倾城色，诗社侬凋觅句须。\n摩垒致师仰馀勇，政惭连叔答肩吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡运干投赠","author":"杨万里","text":"诗似离骚与国风，一襟尘土为君空。\n来从月胁天心外，堕在冰瓯雪椀中。\n判却青灯穷活计，早归紫禁策元功。\n曲生未怕愁城峻，聊遣渠侬为九攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡侍郎见简","author":"杨万里","text":"花边雪里撚霜髭，怪底诗来妙一时。\n聊复小吟开后悟，便应大用到前疑。\n先生此曲难先和，著句如棋且著持。\n每望南云尺有咫，其人甚远只嗟咨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡季永赴季文游园良集之韵聊以致私怨于独往云","author":"杨万里","text":"有酒招元亮，无浆馈子居。\n何曾三不速，焉用一行书。\n乞饮殊无分，干时不已疏。\n犹应慰大嚼，玉轴到吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和贺升卿云庵升卿尝上书北阙既归去岁寄此诗今乃和以报之","author":"杨万里","text":"贺子胸中自有山，结庵山底更云间。\n遗才只道今无许，此士如何尚著闲。\n未应万言直杯水，向来九虎守天关。\n莫嫌久不还诗债，诗债从来隔岁还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵彦德旅怀是夕渠诵诗鼓琴","author":"杨万里","text":"客间眼暗可逢人，公子诗琴却有神。\n频掉乌纱知得句，快挥绿绮更留尘。\n飘零不问今何夕，邂逅相欢意便亲。\n作许生涯浑不恶，只愁我辈转须贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵鼎辅府判投赠贺雪之句","author":"杨万里","text":"登城放目雪光中，万水千山一色同。\n逗晓月华犹在地，未春柳絮已随风。\n忽传别驾赠佳句，道是频年当屡丰。\n撚断冰须愁寡和，玉花飞绕正濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵稷臣惠诗轴","author":"杨万里","text":"今代宗英政骏贤，同居江介更同年。\n别来十载长相忆，新听千诗喜欲颠。\n爽似月华秋艳艳，韵如荷叶夏田田。\n吹灯把玩舒还卷，老眼惺松夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和闽漕傅安道郎中送毛平仲诗韵寄谢惠书及诗","author":"杨万里","text":"宣城讯后忽年馀，闽水风来又岁除。\n人品只今推正始，诗声何止过黄初。\n岂无天上同朝友，不寄山中半纸书。\n珍重故人多问我，鬓毛半脱齿全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和徐衡仲惠诗","author":"杨万里","text":"风骚坛上径雄趋，不作俳辞笑矣乎。\n纸落云烟看醉旭，气含蔬笋薄僧殊。\n夜来霜月千家满，雨后风埃半点无。\n安得与君幽讨去，一觞一咏恼西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和益公见谢红都胜芍药之句","author":"杨万里","text":"江西春好不关渠，只说平园绝世无。\n牡丹百种移洛苑，海棠千树赛成都。\n坐令浮花并浪蕊，谁敢涂铅更抹朱。\n不应一朵翻阶艳，博得龙宫八十珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和袁起岩郎中投赠七字二首 其二","author":"杨万里","text":"道场山下弄山泉，餐菊纫兰万物先。\n送眼飞鸿高四海，补天健笔震三川。\n池塘碧草回春梦，衣钵黄梅肯夜传。\n雨不饶人有新句，怨渠未许见全篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和袁起岩郎中投赠七字二首 其一","author":"杨万里","text":"故人一别两相思，不但平生痛饮师。\n胸次五三真事业，笔端四六更歌诗。\n闭门觅句今无己，刻意伤春古牧之。\n卧雪高人家谱在，春风政著紫兰枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章汉直","author":"杨万里","text":"宛水吹波解舫斋，南徐吊古上高台。\n岸巾过我灯前语，赠句清于月底梅。\n对著酒船手持蟹，管渠秋井骨生苔。\n壁间挂舌那能许，一斗百篇真快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和章德茂少卿拉馆学之士四人访王德脩提干","author":"杨万里","text":"西玉南金价则同，帝城相对落花风。\n人如天上珠星聚，谈到尊中竹叶空。\n白纻乌纱青宝玦，紫鸾黄鹄碧梧桐。\n千龄此遇还孤往，恨杀灯前欠老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和符君俞卜邻","author":"杨万里","text":"朱崖柳色欲春风，庾岭梅花尚雪容。\n念子南归骑瘦马，只今谁解好真龙。\n吾乡端是山水窟，何日来同丘壑胸。\n白鹭青原不妨拣，诛茅结屋看何从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧伯和韵","author":"杨万里","text":"桃李何忙开又零，老怀易感扫还生。\n略无花片经人眼，谁道春风不世情。\n睡去恐遭诗作祟，愁来当遣酒行成。\n子能觅句庸非乐，未必胸中有不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧伯振见赠","author":"杨万里","text":"愁里真成日似年，懒边觅句此何缘。\n雨荒山谷江西社，苔卧曹瞒台底砖。\n顿有珠玑开病眼，旋生羽翼欲俱仙。\n车斜韵险难为继，聊复酬公莫浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧伯振祷雨","author":"杨万里","text":"云气微升又霍然，虚疑数点长三川。\n渚东粳稻今无雨，社曲桑麻莫问天。\n饿死何愁更平籴，野夫半去只荒田。\n未辞托命长镵柄，黄独那能支一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和傅景仁游清凉寺","author":"杨万里","text":"旧时月过女墙头，风雨摧颓废不脩。\n地老天荒无处问，松声滩响替人愁。\n祥刑使者来何暮，吊古诗篇清更幽。\n收拾江山入怀袖，却归讲席进鸿畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和御制琼林宴赐进士余复等诗","author":"杨万里","text":"圣主临轩士袖然，曲江花底宴群贤。\n九天日月开清照，四海豪英看广延。\n祗合致君上尧舜，不应侔德止宗宣。\n草莱忧国从今始，记取云章第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾无疑赠诗语及欧阳公事","author":"杨万里","text":"乌帽红尘愧子陵，绿蓑青笠晚寻盟。\n三千里外还家后，七十二回看月生。\n与子两人长对酌，笑渠万古浪垂名。\n醉翁若是真个醉，皂白何须镜样明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日周丞相少保来访敝庐留诗为赠和谢","author":"杨万里","text":"相国来临处士家，山间草木也光华。\n高轩行李能过李，小队寻花到浣花。\n留赠新诗光夺月，端令老子气成霞。\n无论藏弆传诒厥，拈向田夫野老誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谢石湖先生寄二诗韵 其二","author":"杨万里","text":"康鼎才来顿解颐，卢能自笑未经师。\n分无枫落吴江句，博得池生春草诗。\n木李抛将引琼玖，诗筒从此走符移。\n蛤蜊龟壳非难办，只问先生汗漫期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]