[{"title":"感事六言八首 其四","author":"陆游","text":"麦熟与人同喜，虏骄为国私忧。\n身似五更春梦，家如一宿山邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事六言八首 其二","author":"陆游","text":"黑犊养来纯白，睡蛇死后安眠。\n但有漉篱可卖，不妨到处随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事六言八首 其七","author":"陆游","text":"李白嵚崎历落，嵇康潦倒粗疏。\n生世当行所乐，巢山喜遂吾初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事六言八首 其三","author":"陆游","text":"五尺童知大义，三家市有公言。\n但使一眠得熟，自馀万事宁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一丛花 其一","author":"陆游","text":"尊前凝伫漫魂迷。\n犹恨负幽期。\n从来不惯伤春泪，为伊后、滴满罗衣。\n那堪更是，吹箫池馆，青子绿阴时。\n回廊帘影昼参差。\n偏共睡相宜。\n朝云梦断知何处，倩双燕、说与相思。\n从今判了，十分憔悴，图要个人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一丛花 其二","author":"陆游","text":"仙姝天上自无双。\n玉面翠蛾长。\n黄庭读罢心如水，闭朱户、愁近丝簧。\n窗明几净，闲临唐帖，深炷宝奁香。\n人间无药驻流光。\n风雨又催凉。\n相逢共话清都旧，叹尘劫、生死茫茫。\n何如伴我，绿蓑青箬，秋晚钓潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一落索 其一","author":"陆游","text":"满路游丝飞絮。\n韶光将暮。\n此时谁与说新愁，有百啭、流莺语。\n俯仰人间今古。\n神仙何处。\n花前须判醉扶归，酒不到、刘伶墓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一落索 其二","author":"陆游","text":"识破浮生虚妄。\n从人讥谤。\n此身恰似弄潮儿，曾过了、千重浪。\n且喜归来无恙。\n一壶春酿。\n雨蓑烟笠傍渔矶，应不是、封侯相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 咏梅","author":"陆游","text":"驿外断桥边，寂寞开无主。\n已是黄昏独自愁，更著风和雨。\n无意苦争春，一任群芳妒。\n零落成泥辗作尘，只有香如故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上西楼/相见欢","author":"陆游","text":"江头绿暗红稀。\n燕交飞。\n忽到当年行处、恨依依。\n洒清泪。\n叹人事。\n与心违。\n满酌玉壶花露、送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大圣乐词","author":"陆游","text":"电转雷惊，自叹浮生，四十二年。\n试思量往事，虚无似梦，悲欢万状，合散如烟。\n苦海无边，爱河无底，流浪看成百漏船。\n何人解，问无常火里，铁打身坚。\n须臾便是华颠。\n好收拾形体归自然。\n又何须着意，求田问舍，生须宦达，死要名传。\n寿夭穷通，是非荣辱，此事由来都在天。\n从今去，任东西南北，作个飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其五","author":"陆游","text":"素意幽栖物外，尘缘浪走天涯。\n归来犹幸身强健，随分作山家。\n已趁馀寒泥酒，还乘小雨移花。\n柴门尽日无人到，一径傍溪斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其六","author":"陆游","text":"园馆青林翠樾，衣巾细葛轻纨。\n好风吹散霏微雨，沙路喜新乾。\n小燕双飞水际，流莺百啭林端。\n投壶声断弹棋罢，闲展道书看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其二","author":"陆游","text":"檐角楠阴转日，楼前荔子吹花。\n鹧鸪声里霜天晚，叠鼓已催衙。\n乡梦时来枕上，京书不到天涯。\n邦人讼少文移省，闲院自煎茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其一","author":"陆游","text":"金鸭馀香尚暖，绿窗斜日偏明。\n兰膏香染云鬟腻，钗坠滑无声。\n冷落秋千伴侣，阑珊打马心情。\n绣屏惊断潇湘梦，花外一声莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其八","author":"陆游","text":"纨扇婵娟素月，纱巾缥渺轻烟。\n高槐叶长阴初合，清润雨馀天。\n弄笔斜行小草，钩帘浅醉闲眠。\n更无一点尘埃到，枕上听新蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其七","author":"陆游","text":"从宦元知漫浪，还家更觉清真。\n兰亭道上多修竹，随处岸纶巾。\n泉冽偏宜雪茗，粳香雅称丝莼。\n翛然一饱西窗下，天地有闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其四","author":"陆游","text":"世事从来惯见，吾生更欲何之。\n镜湖西畔秋千顷，鸥鹭共忘机。\n一枕蘋风午醉，二升菰米晨炊。\n故人莫讶音书绝，钓侣是新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼八首 其三","author":"陆游","text":"我校丹台玉字，君书蕊殿云篇。\n锦官城里重相遇，心事两依然。\n携酒何妨处处，寻梅共约年年。\n细思上界多官府，且作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双头莲","author":"陆游","text":"风卷征尘，堪叹处、青骢正摇金辔。\n客襟贮泪。\n漫万点如血，凭谁持寄。\n伫想艳态幽情，压江南佳丽。\n春正媚。\n怎忍长亭，匆匆顿分连理。\n目断淡日平芜，望烟浓树远，微茫如荠。\n悲欢梦里。\n奈倦客、又是关河千里。\n最苦唱彻骊歌，重迟留无计。\n何限事。\n待与丁宁，行时已醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双头莲 呈范至能待制","author":"陆游","text":"华鬓星星，惊壮志成虚，此身如寄。\n萧条病骥。\n向暗里、消尽当年豪气。\n梦断故国山川，隔重重烟水。\n身万里。\n旧社凋零，青门俊游谁记。\n尽道锦里繁华，叹官闲昼永，柴荆添睡。\n清愁自醉。\n念此际、付与何人心事。\n纵有楚柂吴樯，知何时东逝。\n空怅望，鲙美菰香，秋风又起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时/添声杨柳枝","author":"陆游","text":"竹里房栊一径深。\n静愔愔。\n乱红飞尽绿成阴。\n有鸣禽。\n临罢兰亭无一事，自修琴。\n铜炉袅袅海南沉。\n洗尘襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆秦娥","author":"陆游","text":"玉花骢。\n晚街金辔声璁珑。\n声璁珑。\n闲敧乌帽，又过城东。\n富春巷陌花重重。\n千金沽酒酬春风。\n酬春风。\n笙歌园里，锦绣丛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月上海棠 其一 成都城南有蜀王旧苑，尤多梅，皆二百馀年古木","author":"陆游","text":"斜阳废苑朱门闭。\n吊兴亡、遗恨泪痕里。\n淡淡宫梅，也依然、点酥剪水。\n凝愁处、似忆宣华旧事。\n行人别有凄凉意。\n折幽香、谁与寄千里。\n伫立江皋，杳难逢、陇头归骑。\n音尘远，楚天危楼独倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月上海棠 其二 成都城南有蜀王旧苑，尤多梅，皆二百馀年古木","author":"陆游","text":"兰房绣户厌厌病。\n叹春酲、和闷甚时醒。\n燕子空归，几曾传、玉关边信。\n伤心处、独展团窠瑞锦。\n熏笼消歇沈烟冷。\n泪痕深、展转看花影。\n漫拨余香，怎禁他、峭寒孤枕。\n西窗晓，几声银瓶玉井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月照梨花 其一 闺思","author":"陆游","text":"霁景风软，烟江春涨。\n小阁无人，绣帘半上。\n花外姊妹相呼。\n约樗蒲。\n修蛾忘了章台样。\n细思一饷。\n感事添惆怅。\n胸酥臂玉消减，拟觅双鱼。\n倩传书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月照梨花 其二 闺思","author":"陆游","text":"闷已萦损。\n那堪多病。\n几曲屏山，伴人昼静。\n梁燕催起犹慵。\n换熏笼。\n新愁旧恨何时尽。\n渐凋绿鬓。\n小雨知花信。\n芳笺寄与何处，绣阁珠栊。\n柳阴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花慢 夜登青城山玉华楼","author":"陆游","text":"阅邯郸梦境，叹绿鬓、早霜侵。\n奈华岳烧丹，青溪看鹤，尚负初心。\n年来向浊世里，悟真诠秘诀、绝幽深。\n养就金芝九畹，种成琪树千林。\n星坛夜学步虚吟。\n露冷透瑶簪。\n对翠凤披云，青鸾溯月，宫阙萧森。\n琅函一封奏罢，自钧天帝所有知音。\n却过蓬壶啸傲，世间岁月骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花/玉楼春 立春日作","author":"陆游","text":"三年流落巴山道。\n破尽青衫尘满帽。\n身如西瀼渡头云，愁抵瞿塘关上草。\n春盘春酒年年好。\n试戴银幡判醉倒。\n今朝一岁大家添，不是人间偏我老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 荣南作","author":"陆游","text":"樽前花底寻春处，堪叹心情全减。\n一身萍寄，酒徒云散，佳人天远。\n那更今年，瘴烟蛮雨，夜郎江畔。\n漫倚楼横笛，临窗看镜，时挥涕、惊流转。\n花落月明庭院。\n悄无言、魂消肠断。\n凭肩携手，当时曾效，画梁栖燕。\n见说新来，网萦尘暗，舞衫歌扇。\n料也羞憔悴，慵行芳径，怕啼莺见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 春日游摩诃池","author":"陆游","text":"摩诃池上追游客，红绿参差春晚。\n韶光妍媚，海棠如醉，桃花欲暖。\n挑菜初闲，禁烟将近，一城丝管。\n看金鞍争道，香车飞盖，争先占、新亭馆。\n惆怅年华暗换。\n黯销魂、雨收云散。\n镜奁掩月，钗梁拆凤，秦筝斜雁。\n身在天涯，乱山孤垒，危楼飞观。\n叹春来、只有杨花和恨，向东风满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 多景楼","author":"陆游","text":"江左占形胜，最数古徐州。\n连山如画，佳处缥渺著危楼。\n鼓角临风悲壮，烽火连空明灭，往事忆孙刘。\n千里曜戈甲，万灶宿貔貅。\n露沾草，风落木，岁方秋。\n使君宏放，谈笑洗尽古今愁。\n不见襄阳登览，磨灭游人无数，遗恨黯难收。\n叔子独千载，名与汉江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思 其一","author":"陆游","text":"云千重。\n水千重。\n身在千重云水中。\n月明收钓筒。\n头未童。\n耳未聋。\n得酒犹能双脸红。\n一尊谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思 其五","author":"陆游","text":"悟浮生。\n厌浮名。\n回视千钟一发轻。\n从今心太平。\n爱松声。\n爱泉声。\n写向孤桐谁解听。\n空江秋月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思 其三","author":"陆游","text":"面苍然。\n鬓皤然。\n满腹诗书不直钱。\n官闲常昼眠。\n画凌烟，上甘泉。\n自古功名属少年。\n知心惟杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思 其四","author":"陆游","text":"暮山青。\n暮霞明。\n梦笔桥头艇子横。\n蘋风吹酒醒。\n看潮生。\n看潮平。\n小住西陵莫较程。\n莼丝初可烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思 其二","author":"陆游","text":"桥如虹。\n水如空。\n一叶飘然烟雨中。\n天教称放翁。\n侧船篷，使江风。\n蟹舍参差渔市东。\n到时闻暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松","author":"陆游","text":"十年裘马锦江滨。\n酒隐红尘。\n万金选胜莺花海，倚疏狂、驱使青春。\n吹笛鱼龙尽出，题诗风月俱新。\n自怜华发满纱巾。\n犹是官身。\n凤楼常记当年语，问浮名、何似身亲。\n欲寄吴笺说与，这回真个闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风流子 一名内家娇","author":"陆游","text":"佳人多命薄，初心慕、德耀嫁梁鸿。\n记绿窗睡起，静吟闲咏，句翻离合，格变玲珑。\n更乘兴、素纨留戏墨，纤玉抚孤桐。\n蟾滴夜寒，水浮微冻，凤笺春丽，花砑轻红。\n人生谁能料，堪悲处、身落柳陌花丛。\n空羡画堂鹦鹉，深闭金笼。\n向宝镜鸾钗，临妆常晚，绣茵牙版，催舞还慵。\n肠断市桥月笛，灯院霜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"陆游","text":"飞上锦裀红皱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 其一 张园赏海棠作，园故蜀燕王宫也","author":"陆游","text":"浪迹人间。\n喜闻猿楚峡，学剑秦川。\n虚舟泛然不系，万里江天。\n朱颜绿鬓，作红尘、无事神仙。\n何妨在、莺花海里，行歌闲送流年。\n休笑放慵狂眼，看闲坊深院，多少婵娟。\n燕宫海棠夜宴，花覆金船。\n如椽画烛，酒阑时、百炬吹烟。\n凭寄语、京华旧侣，幅巾莫换貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 其二 初自南郑来成都作","author":"陆游","text":"羽箭雕弓，忆呼鹰古垒，截虎平川。\n吹笳暮归野帐，雪压青毡。\n淋漓醉墨，看龙蛇、飞落蛮笺。\n人误许、诗情将略，一时才气超然。\n何事又作南来，看重阳药市，元夕灯山。\n花时万人乐处，敧帽垂鞭。\n闻歌感旧，尚时时、流涕尊前。\n君记取、封侯事在，功名不信由天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉胡蝶/玉蝴蝶 王忠州家席上作","author":"陆游","text":"倦客平生行处，坠鞭京洛，解佩潇湘。\n此夕何年，来赋宋玉高唐。\n绣帘开、香尘乍起，莲步稳、银烛分行。\n暗端相。\n燕羞莺妒，蝶绕蜂忙。\n难忘。\n芳樽频劝，峭寒新退，玉漏犹长。\n几许幽情，只愁歌罢月侵廊。\n欲归时、司空笑问，微近处、丞相嗔狂。\n断人肠。\n假饶相送，上马何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二","author":"陆游","text":"梁空燕委巢，院静鸠催雨。\n香润上朝衣，客少闲谈麈。\n鬓边千缕丝，不是吴蚕吐。\n孤梦泛潇湘，月落闻柔橹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一","author":"陆游","text":"还山荷主恩，聊试扶犁手。\n新结小茅茨，恰占清江口。\n风尘不化衣，邻曲常持酒。\n那似宦游时，折尽长亭柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其三 次宇文卷臣歆","author":"陆游","text":"客路苦思归，愁似茧丝千绪。\n梦里镜湖烟雨，看山无重数。\n尊前消尽少年狂，慵著送春语。\n花落燕飞庭户，叹年光如许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其九","author":"陆游","text":"小倦带馀酲，澹澹数棂斜日。\n驱退睡魔十万，有双龙苍璧。\n少年莫笑老人衰，风味似平昔。\n扶杖冻云深处，探溪梅消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其五","author":"陆游","text":"华表又千年，谁记驾云孤鹤。\n回首旧曾游处，但山川城郭。\n纷纷车马满人间，尘土污芒屩。\n且访葛仙丹井，看岩花开落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"陆游","text":"混迹寄人间，夜夜画楼银烛。\n谁见五云丹灶，养黄芽初熟。\n春风归从紫皇游，东海宴旸谷。\n进罢碧桃花赋，赐玉尘千斛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其四","author":"陆游","text":"岁晚喜东归，扫尽市朝陈迹。\n拣得乱山环处，钓一潭澄碧。\n卖鱼沽酒醉还醒，心事付横笛。\n家在万重云外，有沙鸥相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其一 寄张真甫","author":"陆游","text":"羁雁未成归，肠断宝筝零落。\n那更冻醪无力，似故人情薄。\n瘴云蛮雨暗孤城，身在楚山角。\n烦问剑南消息，怕还成疏索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其十","author":"陆游","text":"觅个有缘人，分付玉壶灵药。\n谁向市尘深处，识辽天孤鹤。\n月中吹笛下巴陵，条华赴前约。\n今古废兴何限，叹山川如昨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其八 登梅仙山绝顶望海","author":"陆游","text":"挥袖上西峰，孤绝去天无尺。\n拄杖下临鲸海，数烟帆历历。\n贪看云气舞青鸾，归路已将夕。\n多谢半山松吹，解殷勤留客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其十一","author":"陆游","text":"平旦出秦关，雪色驾车双鹿。\n借问此行安往，赏清伊修竹。\n汉家宫殿劫灰中，春草几回绿。\n君看变迁如许，况纷纷荣辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其十二","author":"陆游","text":"秋晓上莲峰，高蹑倚天青壁。\n谁与放翁为伴，有天坛轻策。\n铿然忽变赤龙飞，雷雨四山黑。\n谈笑做成丰岁，笑禅龛榔栗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其二","author":"陆游","text":"风露九霄寒，侍宴玉华宫阙。\n亲向紫皇香案，见金芝千叶。\n碧壶仙露酝初成，香味两奇绝。\n醉后却骑丹凤，看蓬莱春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其六","author":"陆游","text":"挥袖别人间，飞蹑峭崖苍壁。\n寻见古仙丹灶，有白云成积。\n心如潭水静无风，一坐数千息。\n夜半忽惊奇事，看鲸波暾日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其七","author":"陆游","text":"湓口放船归，薄暮散花洲宿。\n两岸白蘋红蓼，映一蓑新绿。\n有沽酒处便为家，菱芡四时足。\n明日又乘风去，任江南江北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 闺思","author":"陆游","text":"独倚博山峰小。\n翠雾满身飞绕。\n只恐学行云，去作阳台春晓。\n春晓。\n春晓。\n满院绿杨芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安公子","author":"陆游","text":"风雨初经社。\n子规声里春光谢。\n最是无情，零落尽、蔷薇一架。\n况我今年，憔悴幽窗下。\n人尽怪、诗酒消声价。\n向药炉经卷，忘却莺窗柳榭。\n万事收心也。\n粉痕犹在香罗帕。\n恨月愁花，争信道、如今都罢。\n空忆前身，便面章台马。\n因自来、禁得心肠怕。\n纵遇歌逢酒，但说京都旧话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐 其二 三荣人日游龙洞作","author":"陆游","text":"客中随处闲消闷，来寻啸台龙岫。\n路敛春泥，山开翠雾，行乐年年依旧。\n天工妙手。\n放轻绿萱牙，淡黄杨柳。\n笑问东君，为人能染鬓丝否。\n西州催去近也，帽檐风软，且看市楼沽酒。\n宛转巴歌，凄凉塞管，携客何妨频奏。\n征尘暗袖。\n漫禁得梅花，伴人疏瘦。\n几日东归，画船平放溜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":13571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]