[{"title":"方广奉怀定叟","author":"朱熹","text":"偶来石廪峰头寺，忽忆画船斋里人。\n城市山林虽一致，不知何处是真身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方广圣灯次敬夫韵","author":"朱熹","text":"神灯照夜惟闻说，皓月当空不用寻。\n个里忘言真所得，便应从此正人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗汉果次敬夫韵","author":"朱熹","text":"目劳足倦登乔岳，吻燥肠枯到上方。\n从遣山僧煮罗汉，未妨分我一杯汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"壁间古画精绝未闻有赏音者","author":"朱熹","text":"老木樛枝入太阴，苍崖寒水断追寻。\n千年粉壁尘埃底，谁识良工独苦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方广版屋","author":"朱熹","text":"秀木千章倒，层甍万瓦差。\n悄无人似玉，空咏小戎诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泉声次林择之韵","author":"朱熹","text":"空岩寒水自悲吟，遥夜何人为赏音。\n此日团栾都听得，他时离索试追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"霜月次择之韵","author":"朱熹","text":"莲花峰顶雪晴天，虚阁霜清绝缕烟。\n明发定知花蔌蔌，如今且看竹娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枯木次择之韵","author":"朱熹","text":"百年蟠木老聱牙，偃蹇春风不肯花。\n人道心情顽似汝，不须持向我侬誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿方广闻长老守荣化去敬夫感而赋诗因次其韵","author":"朱熹","text":"拈椎竖拂事非真，用力端须日日新。\n只么虚空打筋斗，思君辜负百年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莲花峰次敬夫韵","author":"朱熹","text":"月晓风清堕白莲，世间无物敢争妍。\n如何今夜峰头雪，撩得新诗续旧篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方广睡觉次敬夫韵","author":"朱熹","text":"风檐雪屋澹无情，巧作寒窗静夜声。\n倦枕觉来听不断，相看浑欲不胜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感尚子平事","author":"朱熹","text":"翩然远岳恣游行，慨想当年尚子平。\n我亦近来知损益，只将惩窒度馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"残雪未消次择之韵","author":"朱熹","text":"脚底悲风舞冻鸦，此行真是蹑苍霞。\n仰头若木敷琼蕊，不是人间玉树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自方广过高台次敬夫韵","author":"朱熹","text":"素雪留清壁，苍霞对赤城。\n我来阴壑晚，人说夜灯明。\n贝叶无新得，蒲人有旧盟。\n咄哉宁负汝，安敢负吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石廪峰次敬夫韵","author":"朱熹","text":"七十二峰都插天，一峰石廪旧名传。\n家家有廪高如许，大好人间快活年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行林间几三十里寒甚道傍有残火温酒举白方觉有暖意次敬夫韵","author":"朱熹","text":"千林一路雪毰堆，吟断饥肠第几回。\n温酒正思敲石火，偶逢寒烬得倾杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林间残雪时落锵然有声","author":"朱熹","text":"青鞋布袜踏琼瑶，十里晴林未觉遥。\n忽复空枝堕残雪，恍疑鸣璬落丛霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至上封用择之韵","author":"朱熹","text":"畴昔朱陵洞，如今白帝城。\n天高云共色，夜永月同明。\n万象争回巧，千峰尽乞盟。\n登临须我辈，更约羡门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福严寺回望岳市","author":"朱熹","text":"昨夜相携看霜月，今朝谁料起寒烟。\n安知明日千峰顶，不见人间万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福严读张湖南旧诗","author":"朱熹","text":"楼上低回掺别袖，山中磊落见英姿。\n白云未属分符客，已有经行到处诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登祝融峰用择之韵","author":"朱熹","text":"今年缘底事，浪走太无端。\n直以心期远，非贪眼界宽。\n云山于此尽，风袂不胜寒。\n孤鸟知人意，茫茫去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"穹林阁读张湖南七月十五夜诗咏叹久之因次其韵","author":"朱熹","text":"南岳天下镇，祝融最高峰。\n仰干几千仞，俯入一万重。\n开辟知何年，上有释梵宫。\n白日照雪屋，清宵响霜镛。\n极知瑰特观，仙圣情所钟。\n云根有隐诀，读罢凌长风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚霞","author":"朱熹","text":"日落西南第几峰，断霞千里抹残红。\n上方杰阁凭栏处，欲尽馀晖怯晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过高台携信老诗集夜读上封方丈次敬夫韵","author":"朱熹","text":"十年闻说信无言，草草相逢又黯然。\n借得新诗连夜读，要从苦淡识清妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠上封诸老","author":"朱熹","text":"夜宿上封寺，翛然尘虑清。\n月明残雪里，泉溜隔窗声。\n楮衲今如许，绨袍那复情。\n炉红虚室暖，聊得话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自上封登祝融峰绝顶次敬夫韵","author":"朱熹","text":"衡岳千仞起，祝融一峰高。\n群山畏突兀，奔走如曹逃。\n我来雪月中，历览快所遭。\n扪天滑青壁，俯壑崩银涛。\n所恨无十犗，一掣了六鳌。\n遄归青莲宫，坐对白玉毫。\n重阁一徙倚，霜风利如刀。\n平生山水心，真作货食饕。\n明朝更清澈，再往岂惮劳。\n中宵抚世故，剧如千猬毛。\n嬉游亦何益，岁月今滔滔。\n起望东北云，茫然首空搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十五日再登祝融用台字韵","author":"朱熹","text":"江流围玉界，天影抱琼台。\n拄杖烟霄外，中岩日月回。\n箕山藏遁许，吴市隐仙梅。\n一笑今何在，相期再举杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡丈广仲与范伯崇自岳市来同登绝顶举酒极谈得闻比日讲论之乐","author":"朱熹","text":"我已中峰住，君从何处来。\n莫留岩底寺，径上月边台。\n浊酒团栾坐，高谈次第开。\n前贤渺安在，清酹寄馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉下祝融峰作","author":"朱熹","text":"我来万里驾长风，绝壑层云许荡胸。\n浊酒三杯豪气发，朗吟飞下祝融峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十六日下山各赋一篇仍迭和韵","author":"朱熹","text":"绝顶来还晚，寒窗睡达明。\n连床眇归思，三宿怅馀情。\n云合山无路，风回雪有声。\n岳祇珍重意，只此是将迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和敬夫韵","author":"朱熹","text":"蜡屐风烟随处别，下山人事一番新。\n世间不但山中好，今日方知此意真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和择之韵","author":"朱熹","text":"仰止平生旧，今年得得来。\n举头天一握，倚杖雪千堆。\n讲道心如渴，哦诗思涌雷。\n出山遗语在，归骑莫徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二诗奉酬敬夫赠言并以为别 其一","author":"朱熹","text":"我行二千里，访子南山阴。\n不忧天风寒，况惮湘水深。\n辞家仲秋旦，税驾九月初。\n问此为何时，严冬岁云徂。\n劳君步玉趾，送我登南山。\n南山高不极，雪深路漫漫。\n泥行复几程，今夕宿槠洲。\n明当分背去，惆怅不得留。\n诵君赠我诗，三叹增绸缪。\n厚意不敢忘，为君商声讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二诗奉酬敬夫赠言并以为别 其二","author":"朱熹","text":"昔我抱冰炭，从君识乾坤。\n始知太极蕴，要眇难名论。\n谓有宁有迹，谓无复何存。\n惟应酬酢处，特达见本根。\n万化自此流，千圣同兹源。\n旷然远莫禦，惕若初不烦。\n云何学力微，未胜物欲昏。\n涓涓始欲达，已被黄流吞。\n岂知一寸胶，救此千丈浑。\n勉哉共无斁，此语期相敦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读林择之二诗有感 其一","author":"朱熹","text":"笋舆随望入寒烟，每诵君诗辄黯然。\n今夜定知连榻梦，一时飞堕锡山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读林择之二诗有感 其二","author":"朱熹","text":"竹舆傲兀听呕哑，合眼归心已到家。\n游子上堂慈母笑，岂知行李尚天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马上赠林择之","author":"朱熹","text":"与君归思渺悠哉，马上看山首共回。\n认取山中奇绝处，他年无事要重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅溪陂下作","author":"朱熹","text":"野牛浮鼻过寒溪，落木梢椮水下陂。\n俗手定应摹不得，无人说与范牛知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题李东老渊乎斋","author":"朱熹","text":"东老幽栖地，渊乎亦妙哉。\n空山无客到，流水有花开。\n句律今谁敌，诗仙旧所陪。\n朱弦悄馀韵，绮席澹浮埃。\n竟日门多掩，长沙岁一来。\n端能负猿鹤，归计莫徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿梅溪胡氏客馆观壁间题诗自警二绝 其一","author":"朱熹","text":"贪生莝豆不知羞，腼面重来蹑俊游。\n莫向清流浣衣袂，恐君衣袂涴清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿梅溪胡氏客馆观壁间题诗自警二绝 其二","author":"朱熹","text":"十年湖海一身轻，归对黎涡却有情。\n世路无如人欲险，几人到此误平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"择之所和生字韵语极警切次韵谢之兼呈伯崇","author":"朱熹","text":"不是讥诃语太轻，题诗只要警流情。\n烦君属和增危惕，虎尾春冰寄此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再答择之","author":"朱熹","text":"兢惕如君不自轻，世纷何处得关情。\n也应妙敬无穷意，雪未消时草已生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十一月二十六日宿萍乡西三十馀里黄花渡口客舍稍明洁有宋亨伯题诗亦颇不俗因录而和之","author":"朱熹","text":"鼎足炉边坐，陶然共一樽。\n道心元自胜，世味不须论。\n安稳三更睡，清明一气存。\n虽无康乐句，聊尔慰营魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十七日过毛山铺壁间题诗者皆言有毛女洞在山绝顶问之驿吏云狐魅所为耳因作此诗","author":"朱熹","text":"人言毛女住青冥，散发吹箫夜夜声。\n却是邮童解端的，向侬说是野狐精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次择之韵聊纪秦事","author":"朱熹","text":"不知四海已扬汤，舞殿歌台乐未央。\n五帝威神等牛马，六王子女尽嫔嫱。\n仙心久已攀姑射，辨口从教泣华阳。\n行客讵明千古意，虚疑霞佩响琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题雪梅二阕奉怀敬夫后自是不复作矣","author":"朱熹","text":"久恶繁哇混太和，云何今日自吟哦。\n世间万事皆如此，两叶行将用斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之听话","author":"朱熹","text":"语道深惭话一场，感君亲切为宣扬。\n更将充扩随钩索，意味从今积渐长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯崇自警二首 其一","author":"朱熹","text":"十载相期事业新，云何犹叹未成身。\n流光易失如翻水，莫是因循误得人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯崇自警二首 其二","author":"朱熹","text":"诵君佳句极优柔，未得明彊是所忧。\n若悟本来非木石，保君弘毅不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉答择之四诗意到即书不及次韵 其一","author":"朱熹","text":"为闵人疲上马行，此时消息尽分明。\n更怜跣足无衣苦，充此直教天下平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉答择之四诗意到即书不及次韵 其二","author":"朱熹","text":"君看灞桥风雪中，南来北去莽何穷。\n想应亦有还家客，便尔讥诃恐未公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉答择之四诗意到即书不及次韵 其三","author":"朱熹","text":"东头不见西头是，南畔唯嫌北畔非。\n多谢圣门传大学，直将絜矩露天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉答择之四诗意到即书不及次韵 其四","author":"朱熹","text":"安肆真同鸩毒科，君言虽苦未伤和。\n解嘲却是生回互，政恐纷纷事转多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答择之","author":"朱熹","text":"长言三复尽温纯，妙处知君又日新。\n我亦平生伤褊迫，期君苦口却谆谆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之见路傍乱草有感","author":"朱熹","text":"世间无处不阳春，道路何曾困得人。\n若向此中生厌斁，不知何处可安身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"到袁州二首 其一","author":"朱熹","text":"马蹄今日到袁州，山木萧椮四面愁。\n多谢晚来风力劲，朔云寒日共悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"到袁州二首 其二","author":"朱熹","text":"袁州刺史几何人，韩李流芳独未泯。\n道丧时危今日意，九原遗恨一时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十二月旦袁州道中作","author":"朱熹","text":"今朝已是腊嘉平，我独胡为在远行。\n白发倚闾应注想，青山联骑若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同林择之范伯崇归自湖南袁州道中多奇峰秀木怪石清泉请人赋一篇","author":"朱熹","text":"我行宜春野，四顾多奇山。\n攒峦不可数，峭绝谁能攀。\n上有青葱木，下有清泠湾。\n更怜湾头石，一一神所剜。\n众目共遗弃，千秋保坚顽。\n我独抱孤赏，喟然起长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋归云洞","author":"朱熹","text":"人生信多患，吾道初不穷。\n云何感慨士，伏死嵁岩中。\n宜阳古道周，窍石何嵌空。\n穷幽历肺腑，履坦开房栊。\n颇疑有畸人，往昔寄此宫。\n岁月讵云几，井灶无遗踪。\n我来记清秋，归涂渺穷冬。\n兴怀重幽讨，永啸回长风。\n风回云气归，洞口春濛濛。\n信美非人境，出门吾欲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人言石乳洪羊之胜不及往游作此","author":"朱熹","text":"人道归云未足誇，洪羊石乳更谽谺。\n连环入梦难纡轸，回首西风又日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分宜晚泊江亭望南山之胜绝江往游将还而舟子不至择之刺船径渡呼之予与伯崇伫立以俟因得二绝 其一","author":"朱熹","text":"寒水粼粼受晚风，轻舠来往思无穷。\n何妨也向溪南去，徙倚空林暮蔼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分宜晚泊江亭望南山之胜绝江往游将还而舟子不至择之刺船径渡呼之予与伯崇伫立以俟因得二绝 其二","author":"朱熹","text":"一棹翩然唤不回，两筇江畔久徘徊。\n早知君有如神技，同下中流亦快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新喻西境","author":"朱熹","text":"北岭苍茫雨欲来，南山腾踯翠成堆。\n稚杉绕麓千旗卷，野水涵空一鉴开。\n客路情怀元倥偬，今晨游眺却徘徊。\n自然触目成佳句，云锦无劳更剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道间厌苦泥淖思亟还家安坐讲习用择之韵呈二贤友","author":"朱熹","text":"客路泥涂正所忧，可堪云物更油油。\n向来结友轻千里，此去还家且一丘。\n妙处自应从我得，躬行肯使叹吾犹。\n两贤定许相提挈，厚意何胜杂佩酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和油字韵","author":"朱熹","text":"楚山黄落正离忧，喜见寒杉卷碧油。\n倦客今年真白发，羽人何日定丹丘。\n奇兵捷出吾当避，狭路争先子不犹。\n个里竟能无一语，应惭二鸟起相酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之怀张敬夫","author":"朱熹","text":"往时联骑向衡山，同赋新诗各据鞍。\n此夜相思一杯酒，回头犹记雪漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别韵赋一篇","author":"朱熹","text":"踏雪凌霜眼界新，举鞭遥指玉嶙峋。\n回头此日成千里，横槊思君少一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿新喻驿夜闻风铎","author":"朱熹","text":"倦枕攲眠到五更，却嫌风铎久悲鸣。\n恍疑絺绤南邻夜，寒铁丁东客梦惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题野人家","author":"朱熹","text":"茅檐竹落野人家，只么悠悠阅岁华。\n田父把犁寒雨足，牧儿吹笛晚风斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]