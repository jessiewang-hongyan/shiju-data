[{"title":"禅人写真求赞 其十二","author":"释正觉","text":"默默家风，云摩霁空。\n露月夜爽，天水秋同。\n人传眉目好，我道骨头穷。\n华须凝粉蜂房蜜，桂毂流魂犀角通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五","author":"释正觉","text":"黄瘦厌厌，风规冷严。\n万机閒暇，一味清恬。\n心宗提简默，手段扫廉纤。\n岁寒不变兮虚怀若竹，道妙难传兮有口如钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十九","author":"释正觉","text":"只个家风，穷而却通。\n于其间内绍外绍，在里许转功借功。\n至游而默，妙用而冲。\n气温温而春活，心湛湛而秋空。\n相随来也兮，头头契同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三","author":"释正觉","text":"阿侬是谁，恰恰相随。\n眉毛垂眼尾，鼻孔压唇皮。\n默默机轮何处转，玉人踏破吠琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十二","author":"释正觉","text":"閒兮无寄，用也不痕。\n月虽能现影，云自不生根。\n活卓卓诸尘莫混，明历历旷劫长存。\n相随闹市堆中去，普光三昧发门门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十","author":"释正觉","text":"貌古骨癯，云閒月孤。\n相随似有，认著还无。\n三千界内谁相外，双六盘中不到输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十八","author":"释正觉","text":"太虚之心，万象之身。\n濯濯水中月，英英华上春。\n而今到处相逢也，眼里无筋一世贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十二","author":"释正觉","text":"一色功回，雷云冻开。\n万机俱罢，风月转夜。\n空空谷有神，欣欣木有春，而今何处不分身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十三","author":"释正觉","text":"虚空借得作身，万象相随为伴。\n纵横人道十成，点检谁知一半。\n看看青山峥嵘，白云零乱。\n里许牧童归未归，铁牛一掣金绳断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十五","author":"释正觉","text":"面孔风埃，身心冷灰。\n鲸饮海乾而珊瑚露，龟藏泥暖而芙蓉开。\n向去却来，其间变态也掣电轰雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十一","author":"释正觉","text":"云树苍苍，泉石凿凿。\n倚杖坐其间，此心自空廓。\n秋月濯沧溟，春风在林薄。\n游鱼下藻玉溪寒，字雁没烟天宇阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十九","author":"释正觉","text":"发白星星，心鉴灵灵。\n随机说法，应物现形。\n天与之清，地与之宁。\n野云曳曳兮，山月亭亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十七","author":"释正觉","text":"胡床小小身，握麈默而神。\n唤醒旷劫之梦，沥乾沧海之津。\n霁空摩尘，风月重轮。\n群机活活物中眼，一点英英华上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十七","author":"释正觉","text":"双奋拳空，一担肩重。\n材本不堪，心元无用。\n莺院华香，蜂房蜜冻。\n喝时耳朵三日聋，扭处鼻头连岁痛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十","author":"释正觉","text":"家风贫自惭，面孔恶人嫌。\n点漆之眼有角，截筒之鼻无尖。\n颠毛寒覆雪，项瘿暗消盐。\n说妙谈玄兮迟钝口觜，呵佛骂祖兮诳嚇闾阎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其一","author":"释正觉","text":"默默传真，如何指陈。\n性月不夜，心华长春。\n净有容兮海印，应无爽兮谷神。\n觌面相呈讳不得，烦君为我洗清贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十一","author":"释正觉","text":"伎俩俱无，身心淡如。\n霁月自分照，閒云从卷舒。\n疋上不足，疋下有馀。\n少室谩传衣钵，曹溪不识文书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十九","author":"释正觉","text":"看看静，见其端。\n星河斗湿，月窟蟾寒。\n体无棱缝，用绝痕瘢。\n不须喝彩还赢也，已见双双六在盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十五","author":"释正觉","text":"画得似谁，胡床黪衣。\n默游彷佛，去就依稀。\n洞山锦开缝，云岩绢下机。\n功亡妙尽看消息，野水磨秋白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十五","author":"释正觉","text":"发将雪白，面作茶黄。\n触动眼三角，忘言口四方。\n明月松头鹤梦，香风莲底龟藏。\n净极发光光自照，虚空鸟印不成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十","author":"释正觉","text":"赤肉穿多孔，臭骨裹闲皮。\n已是不著便，更将描画伊。\n一柄拂聊为伴手，三世佛谁敢称师。\n鲸怒饮乾沧海水，月明烂烂珊瑚枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其九","author":"释正觉","text":"床倚杖藜，权名住持。\n久默钳口，一笑伸眉。\n云水谁相问，家风自不知。\n明白宁居兮河空月转，寂寥无象兮雨霁天垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十八","author":"释正觉","text":"口方鼻直，眉棱眼深。\n未填沟壑，还碍丛林。\n万象无得剩法，三世不见閒心。\n字雁没而寒烟淡淡，华鳞潜而秋水沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十五","author":"释正觉","text":"白云之身，寒月之心。\n性灵麋鹿，气韵山林。\n不堕两头兮匪明匪暗，全超三际兮谁古谁今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十九","author":"释正觉","text":"瘦削而黄，惯穷不忙。\n闲情许淡，默味能长。\n灵犀之通一点晕，老蚌之蕴千年光。\n而今到处相随去，头头的的露堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十六","author":"释正觉","text":"恬然正观，山空水寒。\n河汉横而斗润，云雾敛而秋宽。\n如仇学子兮怒眼三角，无位真人兮赤肉一团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十","author":"释正觉","text":"大一无外，小一无内。\n一兮一兮，靡所不在。\n心地净亡尘，肉山闲弗碍。\n道环中，绝端倪。\n空印里，何文彩。\n风凄凄兮秋落远山，波烂烂兮月浮沧海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十二","author":"释正觉","text":"双眉低垂，两目清冷。\n著于万象森罗，更没一丝欠剩。\n秋霜鹤老梦寒，霁月夜摩松顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十四","author":"释正觉","text":"枯坐清严，真宗剧谈。\n一明无异相，万化是同参。\n牛头转觉病懒，鸟喙不用华衔。\n甘分住山三束篾，等闲对客七斤衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十","author":"释正觉","text":"画工出脱它，精神较得些。\n草不萌，藏香象。\n匣无缝，吼青蛇。\n春雷开众蛰，暖律发千华。\n想是平江人见笑，去年才去又来耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十二","author":"释正觉","text":"眼空毛芥不立，心空海岳可容。\n便与打成一片，尚犹笑道疏踪。\n虚空那挂剑，死水不藏龙。\n转色转功家法子，芦华明月后相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十九","author":"释正觉","text":"谁能目眴眉扬，每笑手乱脚忙。\n守鲁祖之简默，得南泉之平常。\n明心秋月，活物春阳。\n铸机器也模范大小，据丛林也规矩圆方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十八","author":"释正觉","text":"握筇之像，对机之身。\n六根摄一处，三昧起诸尘。\n蚌肠孕于月明之夜，蛰户开于雷动之春。\n个般手段兮，分付善应之人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十八","author":"释正觉","text":"眉低不愁，眼深非恶。\n鼻孔累垂，口唇龌龊。\n月明破夜兮野水怀秋，霁色摩霜兮閒云投壑。\n能错落纵横十字兮，妙提一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十八","author":"释正觉","text":"胸中事简，面上气和。\n白头随我老，青眼见人多。\n一身幸且惭愧，千钵相从奈何。\n曲木床头坐不语，玉蟾推月过星河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十","author":"释正觉","text":"春山似肥，春雪才晞。\n默中有句，用也无机。\n不来而来兮非三界之笼络，无住而住兮是二仪之范围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十三","author":"释正觉","text":"坐曲木床，握乌藤杖。\n铸佛祖之楷模，活丛林之气象。\n你莫来虎口撩须，谁更敢蛇头揩痒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十七","author":"释正觉","text":"只者赤肉一块，说甚清奇古怪。\n平生懒似牛头，度世憨如布袋。\n不空而空，无在而在。\n法法唯心，尘尘三昧。\n问渠是假是真，两彩而今一赛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四","author":"释正觉","text":"情閒口快，眼深鼻隆。\n有时对云水，无可展家风。\n梦鹤卧寒兮月魂泣露，冥鸿望断兮秋色摩空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十六","author":"释正觉","text":"骨气能朴，精神愈憨。\n闲身无所系，冷眼莫相瞒。\n远霁摩秋兮天河斗转，清霜结夜兮月窟蟾寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十三","author":"释正觉","text":"画得几成，精神许清。\n秋高月转，天淡河横。\n出家如有以，处世似无情。\n而今闹里相将去，拨动眉毛眼更明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十三","author":"释正觉","text":"怒眉嗔目，枯肠空腹。\n面冷莫触，气清可掬。\n乘仙槎而棹星河，握玉斧而修月毂。\n真见法以唯心，妙契神于即物。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十四","author":"释正觉","text":"是处分身，如谷之神。\n有应之月，无私之春。\n行将五路开双手，一切门头只个人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十一","author":"释正觉","text":"曲木床稳，刺藜杖横。\n揽五宗之家法，据万象之主盟。\n秋半风清，霁空月明。\n水云模楷兮无禅可说，丛林规矩兮不令而行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十五","author":"释正觉","text":"虚而通，用而冲。\n默游量外，直照环中。\n云水一身瘠，家风四壁空。\n相逢有知己，点指识渠侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十一","author":"释正觉","text":"默默蒲禅，空空世缘。\n谁赓白雪，我得青毡。\n万法之机开两拳，千僧之檐著一肩。\n戏蝶栩栩兮物齐春梦，飞鸿冥冥兮字没秋烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十七","author":"释正觉","text":"鹤老松孤，泉寒石癯。\n镜之对像，谷之答呼。\n万缘杂错不是有，一点灵明不是无。\n湛存妙应兮机轮活枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十二","author":"释正觉","text":"眼低眉棱，骨寒肩耸。\n道情閒不羁，禅胆老能勇。\n流水清而月随，青山瘦而云拥。\n诸缘廓净兮拈却头皮，一句妙圜兮好看鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十五","author":"释正觉","text":"笑含口角，喜在眉棱。\n一默照源底，三乘空葛藤。\n清白濯秋之月，光明破夜之灯。\n柱杖有时横膝上，个般面觜得人憎。\n动而静，虚而应。\n专气致柔，湛神如凝。\n一住天童，十分没兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十四","author":"释正觉","text":"天童比丘，还相识不。\n白发寒岩雪，青瞳古涧秋。\n现身不堕类，分影也随流。\n它日果能窥顶相，晴云似放去山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十三","author":"释正觉","text":"且道是何面觜，刚地无风浪起。\n默默閒自照心，了了倚谁传髓。\n白鸥暮落烟沙秋，寒卧芦华明月里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十四","author":"释正觉","text":"乔乔楚楚，丛林规矩。\n萎萎羸羸，枯木风姿。\n宗乘壁挂口，师友雪生眉。\n住山事拙束三篾，对月机鸣度一丝。\n颠毛间白发，眉睫裹青瞳。\n食指一肩重，门风四壁空。\n诸根亡偶宗家妙，万虑不摇心匠工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十三","author":"释正觉","text":"不以律拘，不以禅缚。\n说法口窄，默游步阔。\n草木阳春来，池塘明月落，何妨处处相安著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十一","author":"释正觉","text":"禅床默默，无得之得。\n寒淡赋心，清贫入骨。\n秋彻鲛人之家，霜摩老兔之窟。\n万象影中兮自纵自横，百草头上兮随出随没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十二","author":"释正觉","text":"棱眉眼自深，阔口笑吟吟。\n峥嵘一片胆，疏豁十方心。\n默默春回万象，星星雪点孤岑。\n恁么来也兮，不用相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十一","author":"释正觉","text":"器宇潭潭，风骨岩岩。\n云梦之气吞八九，嵩少之道落二三。\n守一爻生成之机纽，秉诸祖烹锻之锤钳。\n捏聚放行也肖岳蓄而海涵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十八","author":"释正觉","text":"觉之微妙，未痕朕兆。\n彻造化之源，据生杀之要。\n至虚而独存，当明而隐照。\n筑筑磕磕兮鼻孔累垂，哆哆和和兮舌头狤獠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十四","author":"释正觉","text":"鼻孔脩直，眉毛低垂。\n閒来一默，净扫馀思。\n秋水连天摩霁色，春风著木见游丝，撒开捏聚兮只个些儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二","author":"释正觉","text":"古涧退潦，寒林著秋。\n山空云自在，水净月相投。\n向道底心非世用，更嫌何处不风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七","author":"释正觉","text":"似与不似，毫釐千里。\n真与不真，大方一尘。\n理无生兮如梦事，妙不死也如谷神。\n彻见渊源方是我，了知变态无别人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其二十二","author":"释正觉","text":"不是恁么形像，刚地起模画样。\n从来万法同根，究竟虚空等量。\n可中二浙说禅，分外三河口强。\n深藏那里也烟蓑卧云，大用现前也风舟驾浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十四","author":"释正觉","text":"秋生木老，水退沙隆。\n眉骨阴晴轻重，鼻筒子丑疏通。\n身心霁月，踪迹流蓬。\n默坐胡床兮不欲说黑道白，闲倚柱杖兮谁能画西指东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十一","author":"释正觉","text":"胡床寒，坐卓卓，只个虚空唱兮万象和。\n道契环中有智游，言满天下无口过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八","author":"释正觉","text":"身心廓如，手段卷舒。\n似华作蜜，如井觑驴。\n外不痕兮空印普应，中无象兮道环常虚。\n亡机孤坐兮自不为碍，把臂同行兮谁敢相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十八","author":"释正觉","text":"画手未相识，默心谁与知。\n千峰敛云脚，一月濯风漪。\n墙面袖双手，对缘横两眉。\n惊龟之缩兮愧有其兆，逸鸟之翔兮情亡所羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十九","author":"释正觉","text":"眉棱棱，眼烱烱。\n自爱情閒，人嫌面冷。\n片云出岫之心，孤月濯潭之影。\n绝怜百亿分身，恰满三千化境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十一","author":"释正觉","text":"曲木床头，心空默游。\n沙寒黄苇雪，风细白蘋秋。\n静可久兮山瘠树老，动无羁兮云行水流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十七","author":"释正觉","text":"閒云卷雨，野水怀秋。\n一心绝待，六处不收。\n是个面觜兮，还相识不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]