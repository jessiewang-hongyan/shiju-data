[{"title":"宫词一百首 其二十八","author":"岳珂","text":"金根载耜赴斋宫，晓日东郊望六龙。\n肯为三推便回辇，直须终亩劝耕农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其五十一","author":"岳珂","text":"玉辇三朝奉至尊，并开朱邸傍金门。\n绿车日日朝慈寿，亲见含饴庆弄孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其九十九","author":"岳珂","text":"金城十仞据阳池，三镇高扃死不随。\n自是天恩浃肌髓，不关左衽限戎夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其八十一","author":"岳珂","text":"寿星频见大河清，宫殿金芝产九茎。\n乐府词臣初应制，敕催院使按新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其五","author":"岳珂","text":"雉扇双分识圣颜，紫宸上閤正催班。\n退朝花底纷归骑，春在金门万柳间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其八十七","author":"岳珂","text":"□宫璧柱带金缸，复道横虹结绮窗。\n半道牙牌奏人办，御舟才过□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其七","author":"岳珂","text":"黎明新火下龙墀，御柳青烟冷食时。\n别殿焚香催赐宴，传宣教进谢恩诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其三十三","author":"岳珂","text":"属车望幸隘东方，珠㠹金吾夹道旁。\n却笑氓黎惊卤簿，只知官是绿衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其五十五","author":"岳珂","text":"仙源瓜瓞庆绵绵，玉叶金枝亿万年。\n天意睦亲流圣泽，已增宫院讲书员。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其四十四","author":"岳珂","text":"塞垣战罢五单于，北驿吹尘捧国书。\n欲识天声震夷貊，契丹新进九龙车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其七十一","author":"岳珂","text":"宰相初除司马家，正衙昨日听宣麻。\n京都百万人欢喜，争筑新堤十里沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其四十","author":"岳珂","text":"东华银榜丽卿云，资善新开列近臣。\n昨夜清台占上瑞，乐章已奏月重轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其四十九","author":"岳珂","text":"治定功成第四朝，八音纯绎度英韶。\n仪凰舞兽今千载，还见安安似帝尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其八十五","author":"岳珂","text":"翠麓连绵气属天，岧峣艮岳绕芝田。\n瑞禽可是曾迎驾，万岁山头识静鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其九十一","author":"岳珂","text":"追成栗玉□□冠，网缀红丝七宝襕。\n□□宫前看进辇，天旋地□□□欢。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其四十八","author":"岳珂","text":"狄家天使夜行边，穆卜亲占百字钱。\n五岭共看蕃落马，便将时雨洗蛮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其三十二","author":"岳珂","text":"五原塞上款呼韩，春草新迷拜将坛。\n从此车书三万里，边臣日日奏平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其三十六","author":"岳珂","text":"注辇衣冠听九胪，周家王会看新图。\n仪鸾扇筤瞻朝退，扫得金莲撒殿珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其十三","author":"岳珂","text":"夜深雪压内门前，一榻还惊四璧天。\n上相传觞妻拥炭，归来鼾息顿安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其八十三","author":"岳珂","text":"午夜红光照禁中，贡金铸鼎效神工。\n群臣称瑞频腾奏，又见祥云鹤舞空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其五十七","author":"岳珂","text":"圣心如镜静蝉蜎，欲仗元龟监已然。\n通志一编新进御，汉宫五夜剪金莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其六十一","author":"岳珂","text":"先传陕右定天都，西域新来汗血驹。\n旧府折冲三十六，尽依铜虎铸兵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其八十","author":"岳珂","text":"未央楼殿倚天开，东北偏高是月台。\n驰道都人浑惯识，星毬争指大家来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其九十八","author":"岳珂","text":"金花诏纸夜封芹，首录先朝社稷臣。\n贯日精忠格天业，狂胡勿谓汉无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其六十五","author":"岳珂","text":"真珠鞍辔蹙双龙，西母颁来庆寿宫。\n闻道先朝开国日，降王曾服尚方工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其三十五","author":"岳珂","text":"龙鳞鸾路祀汾脽，玉检重开焕上仪。\n莫诧汉家躬武节，祇今千里亘旌旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其二十六","author":"岳珂","text":"升龙门内屋千楹，玉宇金题映紫庭。\n卷帙异书三十万，至今光彩动奎星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其九十四","author":"岳珂","text":"黄门紫诏下蒿莱，一札风雷众正开。\n四海倾心比葵藿，黄金已报筑燕台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其四十七","author":"岳珂","text":"把麻宣读趁朝参，百辟争传两相衔。\n便觉太平元有象，肯教梦卜羡商岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵山二绝 其二","author":"岳珂","text":"江南閒杀老尚书，自是承平一事无。\n送客折腰书脱腕，试从驼巘看登涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵山二绝 其一","author":"岳珂","text":"驱车结束趁晨暾，水乐帘前共一尊。\n二十二年如掣电，软红依旧暗脩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中午后登山閒步遥见园亭有翠帟张栏处久而识之为张孝显成趣轩盖与缇屏油幕高会予病不得冲宴怅惘移时因以中孚泽所网鲜鳊侑以棠漪家酝并成四绝呈在席诸人 其一","author":"岳珂","text":"九折登山倚瘦筇，杏蹊眼缬早冬烘。\n翠云遮断神仙客，不许其间著倦翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中午后登山閒步遥见园亭有翠帟张栏处久而识之为张孝显成趣轩盖与缇屏油幕高会予病不得冲宴怅惘移时因以中孚泽所网鲜鳊侑以棠漪家酝并成四绝呈在席诸人 其三","author":"岳珂","text":"小池玉尺跃清波，病不开尊奈尔何。\n更倩棠漪吹柳岸，为君小发醉颜酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中午后登山閒步遥见园亭有翠帟张栏处久而识之为张孝显成趣轩盖与缇屏油幕高会予病不得冲宴怅惘移时因以中孚泽所网鲜鳊侑以棠漪家酝并成四绝呈在席诸人 其四","author":"岳珂","text":"冲席丞郎酒斛筹，不关无面见春鸥。\n五鲭见说妨斋禁，留待明朝大白浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中午后登山閒步遥见园亭有翠帟张栏处久而识之为张孝显成趣轩盖与缇屏油幕高会予病不得冲宴怅惘移时因以中孚泽所网鲜鳊侑以棠漪家酝并成四绝呈在席诸人 其二","author":"岳珂","text":"满山桃李闹红霞，曾约香山白鹿车。\n堪笑东风欺病客，搀先且到别人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中散步六绝 其二","author":"岳珂","text":"池上荷花绿净时，岸头杨柳插天垂。\n倦翁纵步聊行散，早有龟鱼圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中散步六绝 其六","author":"岳珂","text":"绝怜倦翼晚风高，解绁归来得故巢。\n物态随人也欢喜，游丝不住舞蟏蛸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中散步六绝 其三","author":"岳珂","text":"朝随粥鼎蝉腹润，夜掩书帷鳏目眠。\n无奈暑威侵病骨，起来搔首斗垂天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中散步六绝 其四","author":"岳珂","text":"平头奴子初茸鹿，利口啬夫双部蛙。\n二物何关人静躁，不妨卧听步随车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中散步六绝 其五","author":"岳珂","text":"病疏酒盏傍茶瓯，一独醒中起百忧。\n七尺之躯三寸舌，问渠小大若为谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中散步六绝 其一","author":"岳珂","text":"一年无病缘官事，一病兼旬为燕居。\n自是素餐天所厌，可能竖子解乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读刘琨传","author":"岳珂","text":"古来万事无真实，赖有区区史笔存。\n士雅闻鸡偶同被，至今起舞说刘琨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宫词一百首 其四十三","author":"岳珂","text":"清晓鸣鞭下禁除，迎阳红日耀金铺。\n辅臣赐坐宣儒馆，同阅观文鉴古图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起三绝 其一","author":"岳珂","text":"睡起东窗日已红，扶头宿酒未惺松。\n南阳一梦何关醉，自爱终身作卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起三绝 其二","author":"岳珂","text":"天色今晨已放晴，鸟乌亦觉有欢声。\n幅巾自是便疏懒，饭了花间取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起三绝 其三","author":"岳珂","text":"五更展转待晨光，到晓瞢腾入睡乡。\n却是金门早朝客，千金不博枕中方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舞鹤四绝 其四","author":"岳珂","text":"一川翠毯浅芜平，上有莺簧百啭声。\n万里烟霄看鹭振，一池鼓吹谩蛙鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舞鹤四绝 其二","author":"岳珂","text":"曾见中庭舞素衣，夜凉桂殿玉笙吹。\n梦回一曲天风杳，正是华亭振万时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舞鹤四绝 其三","author":"岳珂","text":"临皋亭下翩跹客，缟袂玄裳忆旧游。\n推户惘然寻不见，笛声犹认紫貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舞鹤四绝 其一","author":"岳珂","text":"九皋仙子老芝田，小立清池阿那边。\n忽作霓裳羽衣舞，天机未信祇鱼鸢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薛道祖荼蘼诗帖赞","author":"岳珂","text":"夹路浓阴野兴长，荼蘼想见竞年芳。\n至今四月花如雪，犹带河东翰墨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日发广德至建平感事有作","author":"岳珂","text":"西风吹著白髭须，嘉节催侬老道涂。\n无菊傍篱真漫与，有松扫径故应芜。\n登龙路近心谁赏，戏马台成足已瘏。\n怅望杜陵正搔首，一枝不得赐茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十四日夜月明如昼敬想合宫竣事志喜而作","author":"岳珂","text":"纤尘不动月流空，云绕昆仑想合宫。\n蝉冕侍祠三事列，鸡竿赐赦九州同。\n裁仪丙巳尊容典，肇祀庚寅识圣功。\n田野老臣察天意，夜深频起候西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十七日复有旨除帅江西一旬之间两奉除音再赋二首 其二","author":"岳珂","text":"郊廛不隔马牛风，枌梓环阴跬步通。\n湖带江襟邦畛接，雨帘云栋物华同。\n未须豫计荒三径，幸有需章达四聪。\n尚想东湖海棠闹，祇今未改旧时红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十七日复有旨除帅江西一旬之间两奉除音再赋二首 其一","author":"岳珂","text":"披腹忱词久未呈，浃旬两诏下宸京。\n老臣何路通忱悃，圣主无私烛物情。\n鹤陇未渝耕陇志，牛衣空换锦衣荣。\n九重自是真知己，莫惜捐糜负此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入芜湖港过吉祥寺","author":"岳珂","text":"昔时曾访后山松，天道那令霸业穷。\n夹岸人观新太守，拥门僧认旧诗翁。\n隐矶漫指六朝事，鲁港尝淹五宿风。\n从此片帆湖际去，只应日在瑞云东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二日诹吉受通议大夫告再书述怀二首 其二","author":"岳珂","text":"五云瞻观阙，百印写纶丝。\n有愧陪貂尾，何功复雁踦。\n精镠肦紫磨，实匪咏缁宜。\n圣德知难报，规铜笑白髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二日诹吉受通议大夫告再书述怀二首 其一","author":"岳珂","text":"圣代论思秩，中朝博议官。\n尚纡郡邸绶，空著侍臣冠。\n岁月惊驰隙，功名尽画墁。\n髀销今已复，半世愧狨鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月廿五日有诏以予班六卿赐对衣金带鞍马二首 其二","author":"岳珂","text":"非念蹉跎马少游，几年田野任沈浮。\n衣章不称麒麟楦，袍缊谁惭狐貉俦。\n试问嗫嚅常束带，何如款段自经丘。\n感恩一念惟忧国，莫笑隐居金络头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月廿五日有诏以予班六卿赐对衣金带鞍马二首 其一","author":"岳珂","text":"缀迹中朝十四春，精镠两锡带围新。\n赐袍又见光蹄袅，沃辔不妨翔苑麟。\n有马可乘存史阙，无衣谩赋感君仁。\n轻肥岂是平生志，髀肉何堪豢此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又赋双莲","author":"岳珂","text":"一舸归来喜未涯，天教奇产瑞吾家。\n交枝各倚青罗盖，并蒂俱酣红玉葩。\n湘女月裳疑共浴，越姬风袂忆同车。\n人生所欠惟閒适，且酌清尊对物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三江口过舟时方四鼓","author":"岳珂","text":"棹鹢收金柅，钗虫缀玉缸。\n地邻今七泽，名袭古三江。\n岷漾虽分派，荆扬却异邦。\n晨光犹未发，早认白鸥双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三塔寺寒光亭张于湖书词寺柱吴毅夫命名后轩二首 其二","author":"岳珂","text":"云烟千嶂远，风月四时新。\n笠泽昔鲁望，镜明今季真。\n何时脱尘绊，来此寄垂纶。\n一艇苇间宿，寒光长是邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三塔寺寒光亭张于湖书词寺柱吴毅夫命名后轩二首 其一","author":"岳珂","text":"竹里逢僧院，残碑不记年。\n雁题三崒堵，龙化两魁躔。\n宝正号应纪，元丰墨尚鲜。\n寒光定何似，谁放五湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三塔渰圩下二首 其二","author":"岳珂","text":"深不堪桴浅不浮，百艘鳞戢贾胡留。\n如泥乘橇禹行水，以力婴天奡荡舟。\n生息便疑吹野马，陂陀正恐见渊虬。\n君行迟速何须问，且为斯民耻内沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳约客总宜一病不及往二诗呈陈元履王渊道诸人自酌 其二","author":"岳珂","text":"我是棠矶旧钓徒，天教生与水云俱。\n兰亭正值人修禊，柳岸还添浪拍湖。\n幸有丈人观笔法，可无嘉客醉兵厨。\n直须去跃城东马，更与留春作后图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳约客总宜一病不及往二诗呈陈元履王渊道诸人自酌 其一","author":"岳珂","text":"总宜阁畔小帘栊，碧浸平湖面面风。\n别馆柳阴聊系马，便桥红影正垂虹。\n流觞有序传诗客，在席无人称倦翁。\n侬自醉归翁自倦，风光流转不须同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与高紫微雪溪饯客虽已预盟然坐次予每居上为之踧踖寄此见意","author":"岳珂","text":"碧梧正耐雪溪秋，况是西风送客舟。\n华宴虽思奉婪尾，粗官何敢作遨头。\n达尊谅识诗囊意，负约仍输酒斛筹。\n想见尊前列红袖，可怜无分听梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园双竹呈瑞二首 其二","author":"岳珂","text":"曲槛红阑小圃西，平池影浸碧玻璃。\n便同双剑看龙化，未许孤奁舞凤栖。\n连袂纵观金谷妓，联篇频付锦囊奚。\n使符永拟章江去，且听平安报帐犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园双竹呈瑞二首 其一","author":"岳珂","text":"锦绷玉立纪双清，瑞牒千年重得名。\n龙竹高标俨元致，熊湘素节凛皇英。\n质同陇麦两歧秀，奇并庭柯连理荣。\n却羡此君尤特立，虚心直道不孤生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小春六花 小桃","author":"岳珂","text":"霜晴著物利于刀，漏泄阳和是小桃。\n春色已看九重醉，秋风不管十分饕。\n青枝似惬乌栖月，红浪不翻龙化涛。\n秾艳自同时节异，夫君于此见清高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":26809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]