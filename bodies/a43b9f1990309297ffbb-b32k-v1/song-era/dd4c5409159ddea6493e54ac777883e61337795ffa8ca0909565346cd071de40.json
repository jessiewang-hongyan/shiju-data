[{"title":"和赵仲白 其二","author":"陈宓","text":"寤寐曹刘不解忘，双眸烱烱月中霜。\n高吟出轴茧丝富，雅思萦春柳絮香。\n后进推排唯我拙，前人准拟觉君长。\n祇今天下多名士，深谢新篇掷夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵仲白 其一","author":"陈宓","text":"不踏人间桃李场，要看梅蘤带严霜。\n敷成妙赋飘飘意，吐出新诗字字香。\n爽致青山期取友，高情春昼与俱长。\n苏黄不作希佳士，被褐怀珠夺月光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和饶司理","author":"陈宓","text":"往年曾识老名儒，今日方欣拜履初。\n小试不妨三语掾，平生何止五车书。\n词源已作泉初注，德性仍知玉不如。\n自古活人由小利，会看囹圄著园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和翁子雅","author":"陈宓","text":"积中顺和发英华，咳唾珠玑擅百家。\n圆似广场驰小弹，熟于夷路驾轻车。\n绮词新濯蜀江锦，险韵难追河汉槎。\n怪见春归不游赏，由来笔下有奇葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄喻景山","author":"陈宓","text":"朱门到老几人还，赢得阶庭著藓班。\n曾似高人无俗累，解将碧巘照朱颜。\n趣超今古沉酣外，句入云烟缥缈间。\n白首纷纷自名利，天公最惜是清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅监仓南园游船","author":"陈宓","text":"小舟初具似渔家，一曲清溪便可誇。\n垂钓便能升跃鲤，归篙时复带栖鸦。\n园亭不扫心长静，水竹无多镜自华。\n暇日傥来同笑语，书囊诗卷未应涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅监仓祷雨","author":"陈宓","text":"五月秧针尚未匀，忍看沟底欲生尘。\n祷祈已久劳州邑，禳禬终当徇士民。\n天道岂云难感格，人心无过定恭寅。\n新诗见宠非吾事，霖雨须还岩筑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和喻景山赋梅韵","author":"陈宓","text":"质白偏能照玉船，体轻终爱舞蹁跹。\n眼前欲赋半妆额，梦里须携五色椽。\n愁对素蟾寒寂寞，故烧红蜡暖清娟。\n寄声青女休相妒，不学海棠酣夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘瓜山游山韵","author":"陈宓","text":"直上通天只一门，千寻璧玉荐洼尊。\n低头直笑海堪挹，举手常惊斗可扪。\n有月襟怀增洒落，无风衣袂自飞翻。\n山灵想见开颜笑，日暮游人列炬喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘侯觅荔子","author":"陈宓","text":"中郎厨品在，诗老合先尝。\n尘骑将星戴，筠笼柰雨妨。\n空遗黄绢句，莫致绛香囊。\n此愿何当续，薰风竟一偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赞府赵师洪韵","author":"陈宓","text":"明珠颗颗映寒骊，六月清风满袖知。\n祇觉衰容增老愧，空烦妙语为嘘吹。\n三年刻楮成何事，一日哦松剩得诗。\n从此年丰公事少，夕阳桥上赋涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏荔子","author":"陈宓","text":"天垂甘露绛绡囊，凝作清冰更有香。\n偏与荷花妒颜色，不教卢橘见容光。\n蔡公笔妙曾分品，坡老名高合得尝。\n最喜不为妃子污，千年风月水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官松","author":"陈宓","text":"团团翠盖中圆规，风雨精神壮两仪。\n一日不戕凌雪操，千年留得入云枝。\n长垂道路清凉荫，更有神仙洒落姿。\n南国至今忠惠泽，往来那更诵坡诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往行都至严州乌驻馆阻水留二日","author":"陈宓","text":"村馆通宵冷，江乡五月秋。\n野梅酸味足，陇麦饵香浮。\n水满迷行径，澜扬遏去舟。\n亨衢如可待，莫厌小淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往桐城会傅侍郎葬次苏教思恭韵","author":"陈宓","text":"一别清凉十二秋，仙翁已作九霄游。\n急披龙具壶山麓，来会牛眠苏岭头。\n事业直须关宇宙，身名莫使负山丘。\n临分相勉无它语，道学难收岁不留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往濑溪西重山观瀑分韵得还字","author":"陈宓","text":"来自昆崙派，全胜庐岳山。\n桩云何日息，注海几时还。\n翠碧倚锋锷，青冥振佩环。\n主人专一壑，那得鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抵邑示景山","author":"陈宓","text":"四望坡陀百里平，群峰相顾最多情。\n船从碧玉堆中度，人向黄雩阵里行。\n访道几朝成夜饮，思君何日再晨征。\n暂时分袂休言别，遇有人来数寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招刘学录","author":"陈宓","text":"去年八月登高集，今岁依然共此筵。\n莫讶霜毛成种种，且欣露蕊已鲜鲜。\n小桥拟换香山版，曲岸新成范蠡船。\n少年青春还易度，不如来看晚秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放鹧鸪","author":"陈宓","text":"有生惟万类，好恶与人参。\n以彼刳肠苦，为吾悦口甘。\n蔬餐人所尚，肉食我诚惭。\n放汝飞翔去，腾云更宿岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松","author":"陈宓","text":"擎天端作柱，度汉可为梁。\n不受红尘涴，长依皦日光。\n风行扬远韵，雨过发真香。\n偏向闽中道，炎时散午凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安送郑左藏 其一","author":"陈宓","text":"华发萧然入帝城，如何直道尚迂迟。\n从来白璧称和氏，安得黄金到不疑。\n归骑正须誇疾速，慈颜想见倍欢怡。\n人生最是团栾乐，况值薰风荔子时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安送郑左藏 其二","author":"陈宓","text":"还家香稻荐新红，乐岁佳辰定不空。\n绿醑好邀山月饮，紫鳞长与海潮通。\n不妨香火寻高士，祇恐经纶欠此翁。\n我亦欲归归未得，相逢端的是西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园小船","author":"陈宓","text":"五年前具一扁舟，四岁枯乾水绝流。\n今日重将篷竹理，暇朝聊作芰荷游。\n十分清浪堪飞棹，廿里长沟足下钩。\n七帙有亲颠欲华，人生舍此更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园荔子熟名曰魏紫盖是陈家紫种以先公赐封大名地冠之","author":"陈宓","text":"先世栽来四十年，南园魏紫始名传。\n丁香乍翠兰芬烈，龙脑初开玉色鲜。\n可踵蔡家名翰苑，谁誇乌石擅山前。\n追思往事浑如昨，食罢无言意惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园新舟成呈同游诸友 其二","author":"陈宓","text":"暑汗俄沾背，山云已半腰。\n雷轰舟不动，电划岸将摇。\n历乱笑谭杂，空蒙只尺遥。\n浓阴难蔽月，清兴得中宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园新舟成呈同游诸友 其一","author":"陈宓","text":"虚舟当画桥，解缆绿杨腰。\n月白天相近，风清水不摇。\n浮图明突兀，略彴誇虚遥。\n解逅成真赏，初晴第一宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南园新作小舟与客游白湖柯某东海有诗次韵","author":"陈宓","text":"好著西湖藕似船，青秧绿水正相缘。\n漫从略彴无人处，唤得婵娟欲雨天。\n云意爱随双桨动，山光祇在短篷边。\n小园暇日频来往，老竹乔松看岁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南剑值雪","author":"陈宓","text":"一夜茅檐冻雨声，晓来千岫照人明。\n真同煮海盐花瑞，不见因风柳絮轻。\n游子不愁衣短薄，农夫剩喜岁丰成。\n竹篱草舍犹堪赏，况映镡津一水清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南剑鹿鸣","author":"陈宓","text":"嘉宾卅七燕公堂，吾道方亨值一阳。\n学力早知深孔孟，乡风端可继陈杨。\n云霄九万朝天阙，礼乐三千染御香。\n老守尚能观盛事，春深时节喜如狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南剑道中示友人","author":"陈宓","text":"坐见漫山有生意，因知此日更年华。\n风和已作二月景，日煖欲破三春花。\n菜撷青青山店圃，酒沽薄薄野人家。\n吾行有涯我独喜，杯盘虽菲君无嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康喜雪","author":"陈宓","text":"万里乾坤一玉山，新春都作腊前寒。\n满园柳眼未曾破，何处梅花如许残。\n蔌蔌每惊穿屋至，疏疏偏称隔帘看。\n自惭老守无恩惠，空叹编氓出户难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城山松隐岩","author":"陈宓","text":"谷城岩穴似飞来，十里湖光镜面开。\n夜雨松窗僧榻静，秋风柳岸钓船回。\n寻幽便扣生云洞，乘兴还登呼月台。\n每对西湖吟咏处，令人偏忆故山梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复堂独坐","author":"陈宓","text":"漫道清明僎，真成首夏天。\n南风回础汗，小雨驻炉烟。\n花柳无心对，诗书隐几眠。\n杯茶时猛省，事业愧先贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将还家书寄社中","author":"陈宓","text":"萦纡一带本乎漫，碓碓依村自作滩。\n卷却片帆舟转急，斟残斗酒雨犹寒。\n从教稚子嗔归晚，祇为良朋得会难。\n佳景无穷吟不尽，还家携与社中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暮书房","author":"陈宓","text":"春晴无十日，秉烛亦须游。\n冷笑鲰生面，黐粘蠹简头。\n方殚义理乐，蚤觉鬓髯秋。\n几欲抛书坐，痴成不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳絮","author":"陈宓","text":"人道杨花浑似雪，那知雪不似杨花。\n春深解送馀寒去，昼永偏依丽日斜。\n点缀楼台成绘画，发挥桃李作奢华。\n多情不忍轻离别，笑杀飞霙便委沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉南道中","author":"陈宓","text":"乍寒忽暖初冬候，已熟慵收大有年。\n社鼓呼人鸣坎坎，山童待月舞跹跹。\n旅行可饱鱼虾味，疾步不惊鸡犬眠。\n外户夜开今已见，何时斗米直三钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"陈宓","text":"水清沙浅见鱼鳍，雪净天空数雁飞。\n白月无瑕呈佩玦，黄花有露缀珠玑。\n西风劝我翻书叶，促织催人送戍衣。\n最喜蚊雷中夜静，长檠容得一灯微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋酌","author":"陈宓","text":"不饮踰时心已灰，黄花忽破杪秋来。\n初无雅兴酬佳节，谩把霜英浸玉醅。\n免俗未能聊复尔，清时端可赋康哉。\n明年此日知何处，好遣诗筒数往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺权郡雨应祷","author":"陈宓","text":"衡山开霁雨回风，正直心期自感通。\n顿使沾濡千里足，都由精白寸诚中。\n谁知忧国丹心在，不与农夫喜色同。\n四海正须膏泽润，岂容别驾最民功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵户自任所抵乌驻用前韵见示和之","author":"陈宓","text":"自昔桐城别，于今两阅秋。\n暌违嗟地远，聚散似萍浮。\n独发皇都道，同登乌驻舟。\n人生非苟合，谁谓雨能留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王丞","author":"陈宓","text":"二王声价重清漳，久合翱翔画省郎。\n再转哦松人谓屈，一同制锦我师长。\n纤毫不扰民怀德，三载宽征惠及商。\n此去天庭承雨露，书来须及晚秋凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王推赴调 其一","author":"陈宓","text":"俯视庸流四海空，纵横万卷贮胸中。\n兰台不日看登用，莲幕三年肯奏功。\n松径未荒心已动，雪舟谁办兴先穷。\n帝城春事需春到，讵许□菲褪白红。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王推赴调 其二","author":"陈宓","text":"青春初破未容深，趁得清明到武林。\n官柳野花供醉瞩，版桥山石惬归心。\n长才凛凛恢游刃，善政优优得理琴。\n好去天朝鸣佩玉，海边童叟谩歌吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送圭子赴淮南总所排岸任","author":"陈宓","text":"久叨簪绂裔，初筮帝王州。\n祖德期无忝，君恩要力酬。\n存心惟敬谨，律己必清脩。\n千里书频寄，重亲鬓已秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孙生季蕃归浙水","author":"陈宓","text":"平生行止都无著，恰似孤云自在闲。\n四十馀年倦江浙，二千里外择溪山。\n穷愁元不上双鬓，秀句仅能窥一班。\n与子暂分非久别，西风时节赋刀镮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师道弟守德庆","author":"陈宓","text":"乃父高皇侍从臣，汝今潜邸牧疲民。\n天低日近偏临照，土旷人稀费抚循。\n得暇诗书休释手，先公法律自治身。\n舟来勿寄南方物，只寄平反惬老亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师道弟赴官靖州","author":"陈宓","text":"去佐湖阴郡，炎征六十程。\n东南疆尚狭，朝暮骑仍轻。\n民困恩宜厚，蛮骄隙易生。\n廉勤先训在，迟汝振家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师道弟调选","author":"陈宓","text":"三年试邑似从军，救过何心望策勋。\n但得当时无愧怍，便知后日有芳芬。\n身名莫叹行将老，学业由来进在勤。\n子到长安谨交友，杜门切勿混莸薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送延平二堂长","author":"陈宓","text":"延平学术号渊源，端的名师四代传。\n连岁朋来多秀士，一朝归去两高贤。\n休言道统追千载，但淑人心直几钱。\n见说新侯真好学，弓旌不日定招延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李倅","author":"陈宓","text":"太末先生道德尊，朅来闽底佐雄藩。\n两年不作如弦急，千里真成挟纩温。\n南亩但闻农击壤，列城那得吏敲门。\n胸中久蕴经纶业，盍上星辰侍紫垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈国正","author":"陈宓","text":"美誉清名世所推，南州曾作几人师。\n不迟班鬓登台省，却喜青云得路岐。\n节义定高东汉士，文章须复董生时。\n郡芳非久沾霖雨，且看儒宫习少仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姚佥判","author":"陈宓","text":"杜门三载疑无缘，不似当年在剑川。\n衰病可曾同酒盏，俗氛那得和诗篇。\n枫宸领袖三千士，莲幕徊翔十七年。\n荣进在公真素定，槎溪嫡派看初传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡仲方西归","author":"陈宓","text":"后进无因见老成，一觇风采快平生。\n南来幸有同寮契，西去宁无惜别情。\n五载官联亲懿德，远夷君长慕清名。\n明时用取真才具，休使诗声祇自鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡提干","author":"陈宓","text":"奇琛瑰赆满桐城，中有清冰一段明。\n静室只知心可养，当官底患志难行。\n三年两度承嘉话，百里无因诉别情。\n预想山阴溪畔雪，扁舟访戴定寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵主簿","author":"陈宓","text":"簿领官居小似船，清溪深处隐三年。\n才华警敏恢牛刃，行李萧疏跨鹤仙。\n罗渡分携虽有恨，西湖相见岂无缘。\n殷勤记取临岐语，金玉精神更节宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵右史至西禅赵允中有诗和之","author":"陈宓","text":"送客此凭栏，僧闲鱼更闲。\n尘劳聊一释，乐意更相关。\n诱我皆为物，怡人独有山。\n何时重到此，著履点苔班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵纠之潮州任","author":"陈宓","text":"昔佐仙游县，声称已胜喧。\n几年加问学，名郡事平反。\n犴狱情难察，鳏嫠志勇冤。\n惟将明与谨，用表赠行言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送莆田黄宰","author":"陈宓","text":"松竹林中一钜儒，逢人开口是玑珠。\n三年讼简狱生草，百里刑清鞭用蒲。\n直节正当裨黼扆，高情何事忆枌榆。\n送公归后慵回首，尺素西风恐雁孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送榷院侄之官","author":"陈宓","text":"积善门逢八十春，慈兄蕴德复温醇。\n旧恩未报乾坤大，新渥仍沾雨露匀。\n博洽始能为国计，清忠方不负廷绅。\n我今衰病知何用，访有书来访海漘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九","author":"陈宓","text":"长年佳节近重阳，到骨深恩一味凉。\n凤尾有心堪悦目，鸡头当谷可充肠。\n凌云穿月开丹桂，映日排空数拒霜。\n莫与春光较先后，请君晚节玩秋芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九与刘学录","author":"陈宓","text":"休暇常难值，招邀愧已频。\n暂辞霜际菊，终作雨来人。\n适意能迂访，秋芳正错陈。\n桂兰供俯仰，况有拒霜新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九日登道山亭柱间有陈休斋题词曰师相者先君也予既感时之用师而怀先君之去此已垂卅年慨然流涕归而赋之","author":"陈宓","text":"道山亭上看秋光，万里长安在夕阳。\n数点难收周顗泪，一冠莫效孟嘉狂。\n浮岚尽作襟期爽，嫩蕊能令肺腑香。\n三十年前童稚日，不堪回首一凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开新池拟就僧僦地未遂","author":"陈宓","text":"一盆堪作沼，寻丈讵非塘。\n底用荷花盛，方能心境凉。\n忍将禾黍地，凿出水云乡。\n极目平畴阔，时看白鹭翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方处士","author":"陈宓","text":"早岁功名摘颔毛，盛年丘腹壮心豪。\n宁知天上台躔贵，不换山中处士高。\n满架诗书供夜话，一园花柳送春醪。\n年开八帙诚何憾，无奈亲姻自惨骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]