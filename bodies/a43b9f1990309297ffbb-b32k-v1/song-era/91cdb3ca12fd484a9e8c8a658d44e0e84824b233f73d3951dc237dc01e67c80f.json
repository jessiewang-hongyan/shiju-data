[{"title":"次韵见怀","author":"李之仪","text":"林泉废疾固难除，杳杳觚棱寄梦馀。\n已到东山知不免，须由北海本来疏。\n功名漫笑乘轩鹤，事业终归种树书。\n闻道江楼巢已稳，未应长铗叹无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵病起","author":"李之仪","text":"天时人事不相寻，遽食蒸豚废古吟。\n谁感亲颜前约短，常知圣日后缘深。\n风云亹亹天边路，霜露愔愔壁上琴。\n我亦临风频拭目，看悬金印到山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿见寄","author":"李之仪","text":"一逢佳节一消魂，青彻江山绿满园。\n又把锄犁聊自遣，却嗟身世独难论。\n三钟切幸资三径，九奏时犹梦九门。\n胜处何能偏见忆，便应佳思袭香荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿同关圣源吴思道赠董无求有怀米元章","author":"李之仪","text":"海岳仙人不我期，碧云幽恨独心知。\n坐间优孟已难别，笔下羊欣更出奇。\n自是人才空立异，当知臣叔本非痴。\n重轻到了存公议，挥扇何劳强执葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵思道子椿题仲强樗亭","author":"李之仪","text":"王门平昔早相求，几向樗亭得趣幽。\n从别风光应似旧，每怀胜丽只搔头。\n麈毛抗论倾终日，玉指挼花泛晚秋。\n老尽邹阳还忆否，密移空自感藏舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿九日登高见怀兼呈君俞相约寻春","author":"李之仪","text":"重阳曾记客京埃，江国相逢又七回。\n感旧只如春梦断，登高未许壮心摧。\n方嗟陈迹何时见，底事新诗到眼来。\n便好扶携披节物，犹胜落木对空罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵关圣源送董无求","author":"李之仪","text":"何劳楚些为招魂，是处春风似僻园。\n可复京尘难共乐，却应江月要深论。\n灯花昨夜占行馆，鹊语今朝报里门。\n想见慈颜问行李，一樽浮蚁侑芳荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵圣源无求兼怀元章","author":"李之仪","text":"羡门不见见安期，流水高山独我知。\n门径踏穿行复尔，灵丹救活信能奇。\n换虽得辨才三纸，借恐终还是两痴。\n不用艰难成发冢，红楼亲共赋烹葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵思道送董无求兼寄思道","author":"李之仪","text":"肮脏从来不易俦，低徊身世亦悠悠。\n离群断雁虽难偶，得两明珠岂待求。\n强挹馀尘时琢句，问寻陈迹自经丘。\n清时醉尉知何在，似是人多识故侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人腊日","author":"李之仪","text":"又听村村腊鼓鸣，年丰物阜庆清平。\n星霜陡觉岁华晚，时序祇伤今古情。\n装景雪花飞点点，催诗云叶乱英英。\n自惭伏腊尤多误，和语烦公子细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题寿椿轩","author":"李之仪","text":"江左风流不乏人，能将佳思洗埃尘。\n坐中炜烨当时士，庭下扶疏上古椿。\n日永清阴怒鹏翼，月明翠影闹龙鳞。\n云泥路绝无由到，犹欲乘槎一问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵米元章","author":"李之仪","text":"蹭蹬生涯可否间，强扶衰绪欲观澜。\n蓬生虽托麻方直，器就宁嗟木是蟠。\n晚寄乡闾端有谓，时容鸡黍共论欢。\n连城未荐难为璞，莫与坚珉一眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春季泽远来相访感往念今怅然有怀","author":"李之仪","text":"异乡流落十三年，老日从谁寄往还。\n久叹断蓬飘世外，忽惊连璧下云间。\n生涯已约同他日，词笔端能慰暂颜。\n准拟新秋便相见，为君终日倚柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书王子重閒轩壁","author":"李之仪","text":"经年问疾漫持想，今日登轩念自空。\n不能碌碌遽如许，定应剪剪将无同。\n人喧渡口似瓜步，木落沙头疑渚宫。\n莫辞眼力遍沙界，回首腊尽还春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同子重望长芦寺","author":"李之仪","text":"窣堵波寒对水东，坐来初报夕阳钟。\n回环桑柘疑无际，咫尺云烟隔几重。\n听讲有心陪寂寞，杖藜何日许从容。\n主人境界诸缘尽，应笑规规着画龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪子重游长芦寺","author":"李之仪","text":"行来思住觉城东，粥饭随缘早晚钟。\n安得心田荒万有，便惊眼界失千重。\n笑谈喜接真摩诘，衰病休嗟老曼容。\n馊饮残羹应不惜，聊分水墨为成龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德山方老退院索诗送行即席口占","author":"李之仪","text":"应供都城今几春，屡陪香火是前因。\n偶来清瀵堤边住，重见东林社里人。\n青眼略容谈近事，白头同喜得閒身。\n自言此去寻思大，便好乘时继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱伯宣才英昆仲见过曲相慰藉因留饮得花字","author":"李之仪","text":"新春穷巷几伤嗟，联璧俄来照蔀家。\n意厚旋倾新酿酒，眼明初见未开花。\n百寻自是松难老，什袭终惭玉有瑕。\n便觉赋成无用处，漫劳憔悴叹长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题僧道符天游斋","author":"李之仪","text":"六凿相攘不暂休，超然谁复与天游。\n醯鸡瓮里自歌舞，野马窗间空赘疣。\n妙境果从拈处得，生涯须向个中求。\n逢场作戏由来事，可笑区区问髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜寄王性之","author":"李之仪","text":"老恋穷年怯五更，可堪爆竹响新声。\n但惊灯火如残梦，岂有心情敌后生。\n饧竞胶牙空对白，酒期分岁独怜清。\n赐袍应有天香在，想见明朝奉九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又寄性之二首 其一","author":"李之仪","text":"霜髯雪鬓十分侵，举盏常思蘸甲深。\n虽约依刘同汉上，犹虚访戴似山阴。\n文章歆向传家日，事业韦平奕世心。\n冰玉相辉方自表，何妨佳思屡追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又寄性之二首 其二","author":"李之仪","text":"平日鹓鸾接武中，汪汪每叹不能穷。\n暂烦朱毂图遗爱，方信清时是至公。\n千载难期人物盛，一时休叹马群空。\n何妨坐啸追陈迹，应有新诗袭素风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听惠师琴","author":"李之仪","text":"牛斗淹时两耳昏，偶陪沈祝共僧轩。\n数声抑按披香雾，双屦分明在晓原。\n物节不堪催我老，赏心聊复为谁论。\n初年记得山阴旧，又见夷中几世孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"李之仪","text":"芊芊芳草望中迷，传火楼台丽日西。\n飞絮轻翻遮柳陌，落花乱点暗桃溪。\n琉璃波净沈鱼藻，玳瑁帘疏阻燕泥。\n百五良辰最葱茜，绿阴行马过莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉老求诗","author":"李之仪","text":"江南江北久相望，常负灵山一炷香。\n会上拈花虽未笑，坐中持钵顿生光。\n投针技俩空诸有，弹指庄严自一方。\n何必汤池能离垢，入门心地已清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觉老见和复次韵报之时雨行未得","author":"李之仪","text":"去陇回冈翼两傍，旧缘来继鹤林香。\n随时解致留客雨，涉世圆能出定光。\n运用投机疑有象，纵横垂手固无方。\n倦游累接通宵语，时觉杨枝洒面凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真师约过寄老庵雨不止两日不得往小霁辄涉淖以契前约次其所示韵庵壁有孙莘老秦少游刘贡父诸君诗","author":"李之仪","text":"一接深言一点头，离骚致处未为幽。\n不嫌坏路容连步，且欲他年作旧游。\n翰墨抑扬虽已晚，林泉栖止会终收。\n孤云祗恐元无定，候我归来共此丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈致君题朱砂汤","author":"李之仪","text":"造化工夫岂偶然，一池如沸自澄鲜。\n论功但可资沐浴，有理不须深究研。\n流落未妨供净社，升沉何用较温泉。\n更宜场稼犹能就，凡占馀波尽美田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同祖灯过陈氏书斋主人留饭遂求诗","author":"李之仪","text":"一牛吼地得林坰，邂逅经行眼暂明。\n挟策读书虽未暇，杀鸡炊黍喜相迎。\n依依高柳来栖鹊，炯炯黄花弄晚晴。\n自是主人能好事，非关秋日解多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石碛朱希仲馆谷甚勤因题壁间","author":"李之仪","text":"主人好客久闻名，曾约江鱼对酒烹。\n邂逅相逢同一笑，逡巡不觉到三更。\n屠龙手段元非策，画虎工夫浪有声。\n便欲与君论卒岁，却忧舟子报潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清凉寺觉海召饭出数帖相示览之怆然求诗为记","author":"李之仪","text":"潮去潮来知几年，依然城郭带山川。\n连虚玉骨元如虎，布地金沙旧种莲。\n垂手鼎开香积供，传家仍是乳峰禅。\n珠庭月角人何在，赖有遗踪契宿缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇宁求诗时正初老住为初祖","author":"李之仪","text":"乌衣人物已成空，窣堵才能记宝公。\n请祝骤开新福地，全提还振旧家风。\n千岩日上春初到，万里云收月正中。\n欲识投机无意尽，江流入海几时穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范倅置酒雨花台","author":"李之仪","text":"流传胜致有无间，投老方能一倚栏。\n千里江山来极目，万家烟雨锁初寒。\n奸雄几许埋蓁莽，笑语何妨拥蕙兰。\n便觉寸阴真可惜，须将酒户为君宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵仰之","author":"李之仪","text":"倾盖逢君亦偶然，埙篪今日似当年。\n仙风宛是金华旧，诗句分明历水传。\n故国江山聊徙倚，深灯歌笑屡迁延。\n相思果许重相见，豫约严装报此缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵邦老见贶","author":"李之仪","text":"高风畴昔在烟霞，末路芝兰属当家。\n一句转身元的确，千条差路任纷华。\n才疏意广虽难契，语款情真特见嘉。\n只恐平明便分手，相看更待月西斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿无锡寿圣院赠明祖禅老","author":"李之仪","text":"灵山相别已多年，重把圆光信有缘。\n愧我天涯真断梗，喜君居处似诸天。\n元无浮世多般事，只说我家一味禅。\n软语绸缪霜夜永，停灯温火共留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元白拿舟相访出纸求书因书此以归其纸","author":"李之仪","text":"小篷不卸远相寻，顿喜忘年得断金。\n便觉雨华随脱麈，更能操笔问来禽。\n投怀方寄朱弦直，掺袂还惊白发深。\n独幸南游慰真赏，他年会见好丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同熙绩侄登有美堂","author":"李之仪","text":"雪晴时节腊穷天，湖海光浮万井烟。\n胜槩尚能惊老眼，旷怀无复似当年。\n难堪塞雁终联翼，赖有龙驹特象贤。\n已约一廛须卜筑，不妨当此共迁延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘教授宅饭眠斋次其韵","author":"李之仪","text":"饥时齧饭困时眠，任运腾腾信自然。\n岂谓故人投此况，先来佳处作閒仙。\n寓怀何必开三径，得句胜如食万钱。\n只恐里门惊内史，不容同占好山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱塘节士见寄","author":"李之仪","text":"平日刳心欲致君，异时携手但论文。\n兴来只有归田赋，老去何如背水军。\n占胜已惊无不尽，卜邻应许镇相温。\n形容岂敢轻酬酢，谢傅风流自出群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阿滥堆 其一","author":"李之仪","text":"铁作骄幢不易摧，望林谁免渴趋梅。\n院门报钥人初断，天气才阴日又开。\n倦路已先衰鬓雪，思家难遣寸心灰。\n冲风正起还飞下，何物元非阿滥堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阿滥堆 其二","author":"李之仪","text":"年来未觉壮心摧，昨夜偏伤三弄梅。\n不惯离家遽如许，自然昏眼亦慵开。\n萧条寂寞思樗荫，细绎华严谢劫灰。\n少味童山莫分别，直须真峭比离堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食牛炙","author":"李之仪","text":"西来谁为炙牛心，惜事拘文不敢寻。\n岂谓邻邦无百里，骤令馋口得千金。\n登台未论前人比，扪腹翻惊用思深。\n从此耒阳休吊古，便思白酒与同斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐末宿秋试院曾和王敏父四诗是时以疾先出院方欲出而未得况味有类今日追用前韵再赋四首 其一","author":"李之仪","text":"阶除又见日将斜，若此奔驰尚可誇。\n敢觊阴功踵定国，未应和药困王嘉。\n门前祷雨频催鼓，眼底无人但见花。\n不比贡闱当日锁，病来有许便还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐末宿秋试院曾和王敏父四诗是时以疾先出院方欲出而未得况味有类今日追用前韵再赋四首 其二","author":"李之仪","text":"兼材莫作尹翁归，自鬻崎岖不畏非。\n妄役土龙宁得雨，可堪刍狗强蒙衣。\n移文不报如沉井，行路皆疑镇掩扉。\n早悟垂头供立仗，好随四牡去騑騑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐末宿秋试院曾和王敏父四诗是时以疾先出院方欲出而未得况味有类今日追用前韵再赋四首 其三","author":"李之仪","text":"沉沉深锁出无涯，白尽于思岂复华。\n准拟归期叩端午，那知此地见葵花。\n幽忧未论如阴府，倏忽翻惊走电车。\n久病元来最欺眼，蝇头只觉似栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐末宿秋试院曾和王敏父四诗是时以疾先出院方欲出而未得况味有类今日追用前韵再赋四首 其四","author":"李之仪","text":"十年三拜东门敕，长是寻灯濯污裾。\n赢得平安题报历，不妨朋友校残书。\n歌传鹊鼠非行路，咏入乌狐愧大车。\n物物背驰将老矣，定知身世欲何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"若禔告行再寄二诗 其一","author":"李之仪","text":"前日报君明日行，强凭诗句写离情。\n悬知北海经旬别，须滞韶山半日程。\n环席已甘搀上首，馀罍应不负同倾。\n预期一笑东门外，剩记樽前醉里声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"若禔告行再寄二诗 其二","author":"李之仪","text":"醉里新声解记无，祗应琴意似相如。\n近来公道偏难得，从此佳期敢妄图。\n玉室金堂有阻隔，兔葵燕麦恨扶疏。\n冥鸿不比寻常雁，试觅萧娘一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阳翟道中有怀存之二首 其一","author":"李之仪","text":"顽阴将腊袭衣褠，倦辔临风愧白头。\n一事无成还岁晚，百年过半尚人谋。\n天边漫铸黄金印，月下何时紫绮裘。\n拟借东邻分一径，未应人物谢羊求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阳翟道中有怀存之二首 其二","author":"李之仪","text":"夕阳风里得君心，常约清香带月寻。\n红萼似披经几嗅，绿条如弄已难禁。\n野狂不惯娉婷醉，蓬鬓偏宜蓓蕾侵。\n准拟归时更浮动，琼樽宁谢十分斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵梅花 其一","author":"李之仪","text":"送腊迎春亦是常，独高梅蕊报年芳。\n风来彷佛逢荀令，月下分明见寿阳。\n开遍漫誇千种韵，天然别是一般香。\n从今漏泄东君意，直到霜前菊蕊黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵梅花 其二","author":"李之仪","text":"岭上才分一寸光，群花次第促来妆。\n绝胜群玉山头见，须信昭仪体自香。\n妙赏不逢徒老去，佳期难得为谁芳。\n定应痒处无人会，空怨相邀客姓王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"智臣相过成小诗","author":"李之仪","text":"绀发朱颜气吐虹，峥嵘头角振家风。\n千金自晦邹王后，一笑时游管郭中。\n老子已应终汩没，诸儿聊为指穷通。\n他年朱紫相辉地，莫惜高轩访此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑛侍者欲再游方作此勉之","author":"李之仪","text":"精神秀发真狮子，耸壑昂霄似出林。\n击竹有声先了悟，拈花微笑已知音。\n新诗富健疑披锦，妙字清奇不换金。\n往往秋高又飞锡，白云来去本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有送梅花者而彦行适在君俞来","author":"李之仪","text":"来时点滴才彷佛，今日烂漫将飞扬。\n春事不知尚多少，客怀空自成悲伤。\n新名侯喜足诗思，旧病维摩难药方。\n共饮节食冷相对，少须陈子同飞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其一","author":"李之仪","text":"结束轻装趁晓风，崎岖行李偶难同。\n他年谁谓双成老，今日翻为无是公。\n秪恐穰侯迟见事，固应原宪本非穷。\n洛阳烟霭因缘在，鸡黍相期定不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其二","author":"李之仪","text":"上番新梢与旧齐，啄残红腐半成泥。\n画船似觉去已晚，丽句犹堪手自题。\n气候相催虽迅速，笑歌赢得暂招携。\n红舒绿卷分前后，全胜当年白集西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其三","author":"李之仪","text":"君方陵愈我惭郊，大瓠为舟浪自要。\n老矣独期云駃便，归与长负桂丛招。\n峥嵘红橘迎风密，点滴安榴掠望烧。\n多谢□萌滋味永，便思飞步到杨寥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其四","author":"李之仪","text":"佳禽百啭不惊风，午日濛濛睡眼中。\n几片犹飞残腊白，数枝初见出墙红。\n低回节物怜迁客，漂泊生涯难老翁。\n多谢春光相击拂，一樽倾倒许谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其五","author":"李之仪","text":"窥豹曾容见一斑，孤高凛凛固难攀。\n早应拔宅朝元去，犹有遗踪在世间。\n舒啸款谈虽可想，赏风吟月未终閒。\n诸郎莫为功名老，须信移文下北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题九首 其六","author":"李之仪","text":"映月临灯万萼披，喜随宾客宴芳菲。\n诸姨队合骊山晓，猎骑夜从云梦归。\n须把玉觞酬胜丽，徒劳彩笔强依稀。\n回头便见飘红雨，莫惜频歌金缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]