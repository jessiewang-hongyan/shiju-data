try","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶怀普照经寮附火寄夷白老","author":"吴则礼","text":"北湖头白懒觅官，只办诸方寻衲子。\n要拥经寮一丈炉，烦渠好作来苏水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄公卷","author":"吴则礼","text":"荻花枫叶秋江晚，底事扁舟不肯留。\n浊酒共沽清夜月，空馀小字落沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得友人诗因寄之","author":"吴则礼","text":"鸟语茅檐午梦回，柴荆寂寂掩苍苔。\n落红万点春江绿，归雁空传秀句来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探梅","author":"吴则礼","text":"梅花元不怕春寒，想见垂垂雪作团。\n藤枝芒屩犹堪在，试为吾人料理看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚饭龟山","author":"吴则礼","text":"半生藜糁只么过，铁作脊梁真自强。\n偶烦衲子分斋钵，惭愧龟山春笋长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢曹公善酒","author":"吴则礼","text":"归来脱帽但苍华，一段风流属外家。\n犹有故时从事在，银钩仍落小流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋魏相之所收花光老小景","author":"吴则礼","text":"湖北湖南天水宽，道人付此一毫端。\n魏郎得之不自供，要遗西山老眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简友人 其三","author":"吴则礼","text":"江山端无适俗韵，曳屐出门忘负痾。\n林花工办作红雨，其奈一年春老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简张子伟","author":"吴则礼","text":"轩轩秃发谷城孙，有底天寒不出门。\n肯说今年閒贵贱，只将丘壑共人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简承天琛老","author":"吴则礼","text":"攀缘梦境欲何为，身相从渠现五衰。\n任运腾腾只么过，休论跛蹶与痿羸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三堂道中寄公卷","author":"吴则礼","text":"久坐懒成癖，谁令老作魔。\n逢人说江海，著处是关河。\n陇底烽燧暗，海门鸿雁多。\n西楼云水白，犹奈酒樽么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元寄鲁侯道辅时二公在真定","author":"吴则礼","text":"留连京洛未成归，行及北潭花絮时。\n楼外孤蟾吐华月，帐前小队簇春旗。\n夜阑白雪回歌扇，舞彻红灯照酒卮。\n更有风流岘山客，明珠百斛坐题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不奈","author":"吴则礼","text":"不奈淮南热，遥知秋可怜。\n乌皮垂老事，白发半生禅。\n井水从儿汲，茶铛姑自煎。\n何时决明好，堂下晚鲜鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事 其一","author":"吴则礼","text":"小雨浑晴不作泥，老年浇舌要如饴。\n应怜长日只么过，故遣飞英如许奇。\n涧底涓涓催着屐，屋头聒聒唤支颐。\n孰云乌几独少味，看尽朱朱白白时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日呈王长元次元关圣功","author":"吴则礼","text":"是身久付一蒲团，半世读书真画墁。\n唤取平生三语掾，来分投老五辛盘。\n犹堪白堕樽边笑，端奈红梅花底寒。\n莫问侏儒饱欲死，从教霜雪映南冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝耕神堂快活林","author":"吴则礼","text":"凝笳作悲壮，细马载婵娟。\n可是杏花晚，只教杨柳眠。\n酒盏汉旌底，清歌春雁边。\n不须催部曲，聊欲酌寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书寄净明道人","author":"吴则礼","text":"净明端可人，日用一僧钵。\n觅句殊未休，平生个中活。\n眷我梁宋游，茗椀屡浇泼。\n淮南霜露寒，转柁何由达。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城道傍决明甚开可喜","author":"吴则礼","text":"篱落秋逾晚，鸡豚地更偏。\n何时有蓬户，无处著金钱。\n芒屦林边石，茶铛涧底泉。\n心知鸿雁到，老子爱江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发陈留寄智夫侄","author":"吴则礼","text":"五斗莫作籴太仓，幽事关人殊未央。\n白雁撩人下清洛，黄花唤梦著都梁。\n平生浪喜得诗瘦，投老相从要酒狂。\n欲到淮南先一笑，蟹螯浑已饱新霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发金陵","author":"吴则礼","text":"湖海归来近钓筒，此身南北一飘蓬。\n船头已压三山浪，樯尾初回五雨风。\n天淡鼓声催落日，云高帆影趁飞鸿。\n道林窣堵自崷崒，隐几寒光连暮空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王子和过张氏小园","author":"吴则礼","text":"永夏追凉得午阴，扶藜仍有小丛林。\n应怜老子腰脚健，可是禅房花木深。\n卷帘高竹与佳色，隐几黄鹂供好音。\n更遣惊人十样锦，并浇宿昔江湖心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坰寄黄济川五首 其五","author":"吴则礼","text":"斋盂随处有，阿堵半生无。\n不作论文杜，姑为踏硙卢。\n清言韵舌本，残雪著头颅。\n请说楚州菜，白菘如臂粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坰寄黄济川五首 其四","author":"吴则礼","text":"甘作华颠老，聊寻颍上梅。\n长须唤舟楫，赤脚洗尊罍。\n白日要可挽，清香不受摧。\n若为教騕袅，载得阿川来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坰寄黄济川五首 其三","author":"吴则礼","text":"今年一尺雪，大盎想春沽。\n乌帽有何好，青鞋绝世无。\n老泓元有韵，瘦颖要时呼。\n跛跛没伎俩，归来真老卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坰寄黄济川五首 其二","author":"吴则礼","text":"平生黄卷里，老罢白鸥边。\n莫作惊人语，深参饱睡禅。\n随堂姑一钵，唤客或三鳣。\n宁要苏司业，时时与酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坰寄黄济川五首 其一","author":"吴则礼","text":"饭饱团栾坐，前身或姓庞。\n痴云黏楚甸，小雪著荆江。\n尚要评诗律，何因唤酒缸。\n归来底处好，脱屐弄艂艭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同澄之器博饭浮玉","author":"吴则礼","text":"畴昔清都步武联，轩轩鹤骨称癯仙。\n君横七弦可忘老，我得一丘端尽年。\n白首终成裹饭去，青灯更作曲肱眠。\n步虚声里云旗下，病眼心知有胜缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀介然偶作因寄之","author":"吴则礼","text":"此生端与衲僧期，折脚茶铛能解颐。\n君对幽人洗银毂，我书春事有毛锥。\n唤醒饱睡真痴绝，惊倒群儿要语奇。\n想为梅花从定出，横担拄杖傍疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次毛泽民曾公卷韵","author":"吴则礼","text":"毛侯曾子有新句，鸣籁素秋相与清。\n我若邶鄘甘退舍，君如秦楚正连衡。\n一尊鸿雁到时酒，万里江湖别后情。\n鱼目骊珠固非敌，搴旗况已慑先声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次李德充别刘长因韵","author":"吴则礼","text":"悬榻有妙致，脱冠论古情。\n羁愁一杯尽，好句万人惊。\n谈麈初未厌，樯乌俄小征。\n遥怜柁楼底，别夜月孤明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林初心先辈 其二","author":"吴则礼","text":"倦客无人问，逢人祗自嗟。\n孤舟在江汉，老梦绕京华。\n听雨閒扉掩，看云短帻斜。\n固穷吾已定，莫向五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林初心先辈 其一","author":"吴则礼","text":"太史滞周南，醇儒去广川。\n功名欺白发，风雨送流年。\n故国悲歌里，沧洲醉梦边。\n平生心似铁，相对肯凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至洪泽寄吕少冯介然","author":"吴则礼","text":"来往都梁真有期，瘦藤挈挈要追随。\n独怜老子蒙头睡，不见梅花如雪时。\n经炉饱附僧伽火，斋钵长分庾氏糜。\n岁暮东窗好晴日，传声阿遁正相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行对菊寄智夫侄","author":"吴则礼","text":"洛水微寒澹晚秋，从教风雨打船头。\n莫嗔宿昔爱霜菊，可是平生怕督邮。\n未办作诗论句法，且当贳酒消人忧。\n白眉清眼见小阮，共卧淮山百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过智海呈陈无己","author":"吴则礼","text":"暂展经奁试茗芽，共怜日日困尘沙。\n木鱼梦觉响晴景，铁凤雨馀翔落霞。\n漠漠清香萦暮竹，萧萧晏几近幽花。\n道人槌拂总无用，身世俱忘鬓已华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈余清老","author":"吴则礼","text":"俛仰塞境断，追随春事幽。\n碧山朝曳屐，白浪晚维舟。\n钟鼓鸣江渚，烟云暗郡楼。\n下帘煮新茗，聊为道人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈曾侯","author":"吴则礼","text":"滹沱流水抱城斜，旌节重来鬓欲华。\n春雨一溪藏钓艇，秋风十里对荷花。\n铜符旧总山西将，铁骑还吹塞北笳。\n鱼蟹初肥稻粱熟，他时归向楚人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀关圣功","author":"吴则礼","text":"破除午梦晴鸟呼，起唤奴人转辘轳。\n半世奇奇兼怪怪，一春白白与朱朱。\n生憎张仪舌尚在，大笑香岩锥也无。\n矻矻休论抱关事，快来相对说江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀彭志南因寄之","author":"吴则礼","text":"年光六马去骎骎，末路漂流愧此心。\n玉佩金貂自钟鼎，纶巾羽扇本山林。\n舟横落月梅花淡，雁贴寒云春水深。\n漠漠东风闭蓬户，相思华发忽盈簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"閒居","author":"吴则礼","text":"自断馀生更不疑，三间茅屋大江垂。\n会降前代李长吉，只有后身韩退之。\n群羊正饱官厨肉，野饭宁忘环堵葵。\n能事阿穰今落寞，何人便捉画沙锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到朱方寄智夫智夫时为户部官","author":"吴则礼","text":"逐客藜糁大官羊，蓬庐画省遥相望。\n囊中锥处吾罢矣，地上钱流君未央。\n一身投老鸡豚社，百战平生翰墨场。\n拍拍水天高著眼，海门乞与雁随阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人梅诗","author":"吴则礼","text":"玉妃从以万玉女，正倚广寒琪树柯。\n端怜横笛陇头罢，不恨落梅江上多。\n翠袖清尊知老矣，薰炉茗椀奈侬何。\n梦惊篷背遽如许，会唤阳春有艳歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘坰并简杨虞卿","author":"吴则礼","text":"少日负书笈，老年看战车。\n此生浑觅句，随处有烹茶。\n乞我炊黍米，烦君问蕨芽。\n斓斑赤铜椀，渠辈久名家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和至之秋宴感怀时至之已有归休意","author":"吴则礼","text":"纷纷举世事轻肥，三径萧条独可依。\n壮志未随黄发改，故山将伴白云归。\n林泉定落幽人手，尘土空侵病客衣。\n明月满帆秋水碧，扁舟去逐雁南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和魏道辅铜雀砚","author":"吴则礼","text":"寂寞漳河绕故宫，悠悠千古付飞蓬。\n当时流落干戈际，今日埋藏尘土中。\n楚岫月明芒屩远，湘江春尽草堂空。\n提携愿逐先生去，閒咏滩头一笛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"性之以团茶赠行并遗新诗因次其韵","author":"吴则礼","text":"年年御焙试春风，白玉宫人拆绛封。\n畴昔饥肠知脱粟，即今老眼见翔龙。\n笑持俊逸无双句，去上东南第一峰。\n却倚柁楼搔短发，回头青阙五云浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"放船先寄普照老夷白","author":"吴则礼","text":"柁楼澹沲冬日斜，半世三钟并五车。\n处处谈禅作居士，年年行脚见僧伽。\n偶然摩腹船鸣鼓，聊复捐书雁聚沙。\n先遣毛锥交说似，即今镜里有霜华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客有自南徐来者云红梅已开作此","author":"吴则礼","text":"十日天寒守圭窦，今朝对客何佳哉。\n春催江上红梅发，雪唤淮南青子来。\n从儿作相论句法，乞我浇馋持酒杯。\n半世儒冠今种种，端须拽取鼻头回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣老示寂有怀","author":"吴则礼","text":"暮年流落偶相亲，握臂难忘一语真。\n茗椀斋盂成昨梦，蒲团禅板记前身。\n尘埃云衲翛翛敝，岁月霜毛种种新。\n游戏诸天无复返，自嗟青眼更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴大舟投老斋","author":"吴则礼","text":"枕边梦事忽蘧蘧，起着青鞋唤竹舆。\n投老惟堪听斋鼓，此生端愧坐儒书。\n十年枵腹犹堪在，一钵连床便有馀。\n蓦直从来大舟路，横担拄杖正怜渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子仁兄赴定武倅","author":"吴则礼","text":"杳杳东风吹雁行，淡烟疏柳暗河梁。\n边笳忽起暮天远，塞雁不鸣春草长。\n野馆梦回花似霰，戍楼诗就月如霜。\n应怜投老尚漂泊，白鸟青山堪断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]