[{"title":"慈林讲师顶相","author":"释绍昙","text":"气宇兮春温，风标兮凛然。\n律虎出林兮，裂破开遮持犯。\n经龙搅海兮，探穷顿渐偏圆。\n句法清新兮，吟彻山庄梅竹。\n胸襟妙蕴兮，包罗丘壑风烟。\n友缙绅兮，非权门炙手。\n荷佛法兮，思重负赪肩。\n煨芋香兮，无心收涕。\n卧云深兮，岂意朝天。\n邈真容兮，明镜绘像。\n付箕裘兮，神珠藏渊。\n夫是之谓慈林克家之子，真鸾胶而续弦者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"煨芋","author":"释绍昙","text":"山房不识春风面，地炉宿火煨红软。\n寒涕垂颐午梦醒，饥肠殷殷晴雷转。\n霜猿剥啄启岩扉，漏泄天香入翠微。\n雾幕烟笼收不得，等闲勾引白云归。\n破藤床上生涯足，和土和灰擘柔玉。\n放憨一饱万缘空，口唱山歌手扪腹。\n可中真味与谁论，脯麟脍凤徒腥膻。\n向使懒残知有此，肯把虚名眩天子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"痴绝和尚赞","author":"释绍昙","text":"淳乎淳，没机心。\n撮茎草作翳睛药，锻黄丹成绕指金。\n发汾阳怒骂伤人语恶，中曹源蛊毒刻骨冤深。\n扫狐兔露苍鹰牙爪，咬猪狗添老虎精神。\n是师真，非师真。\n僧繇描不得，阁笔几沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简州性上人求语","author":"释绍昙","text":"春山杜鹃啼，苦劝人归去。\n声碎竹林风，血染花梢雨。\n我老无家可得归，萝窗睡饱云黏衣。\n山童推枕破残梦，报道有僧开竹扉。\n何方圣者来寻讨，解包飏下青龙钞。\n便欲庭前纵火焚，净地岂容狼藉了。\n问渠何日离飞来，两月奔驰未到家。\n好劝急归休歇去，春风落尽武林花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"裴相国参黄檗图赞","author":"释绍昙","text":"大小痴禅，对谈甚底。\n背后人听，不能夺耳。\n切莫求安古佛名，当头便触贤侯讳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靠布袋看髑髅不开口笑赞","author":"释绍昙","text":"笑不露唇，见不透脱。\n布袋靠得虽牢，髑髅枯眼再活。\n若要活奉化，肚肠尽情拈却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靠布袋常思惟赞","author":"释绍昙","text":"赤骨律穷，单靠布袋。\n子细思量，大有事在。\n平地要升兜率天，你这汉是颠是騃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题兰蕙 其二","author":"释绍昙","text":"一茎四花，挺然拔萃。\n其臭如兰，其标如芷。\n檀喙簇烟而不繁，劲节疾风而不倚。\n是以昂山有山林轩昂之志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题兰蕙 其一","author":"释绍昙","text":"色淡而清，节香而贞。\n隐德不耀，咀华含英。\n君子同其芳洁，写真不堕丹青。\n宜乎孕潇湘幽楚之灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题许由弃瓢图","author":"释绍昙","text":"视尧天下一瓢轻，厌听风梢历历声。\n飏下不须频顾恋，始终存取隐沦名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题披云亭","author":"释绍昙","text":"大地黑漫漫，日月久韬□。\n山藤聊一挥，神与境相会。\n八纮净无尘，万象镜中翳。\n天外出头看，笑擘阑干碎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其三 雨","author":"释绍昙","text":"娥英吊舜于九疑，泣泪如雨。\n佩玉零乱，半委尘泥。\n愚恐离骚九歌，曲尽其哀，香魂冷而卒难拈也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其二 晴","author":"释绍昙","text":"久居深林幽寂中，虽隐德不耀。\n遇春阳姁妪，笑弹玉指，十倍精神。\n所虑楚俗尚芳，纫而为佩，使不克终其天矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其四 雪","author":"释绍昙","text":"大雪申威，万木摧拉，独能擢芳于凝冱中，虽百折不委。\n非素有所养，宁不为外侮凭凌者欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其一 风","author":"释绍昙","text":"灵均侈山林之乐，薄笼绡裤，幽放檀心。\n娇舞春风身醉香，力难扶也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞华长老真","author":"释绍昙","text":"华胄兮天随故家，清名兮应庵再来。\n穷教兮佛陇精华，逃禅兮苏州思呆。\n爱梅兮冰雪襟怀，结茅兮泉石亭台。\n搜吟兮西湖巧裁，好客兮东閤大开。\n乐归隐兮百鸟衔花，尸净土兮九莲夺胎。\n瞻遗像兮瑶林琼树之葩，挺孙枝兮雕梁画栋之材。\n作是赞兮无乃绘太虚之五采，点明镜之纷埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞延庆谦山主寿像","author":"释绍昙","text":"谦德有光，慈心摄物。\n等冤亲不与较量，混尘俗初无间隔。\n熙熙然气融冰谷之春，汪汪乎胸吞云梦之泽。\n乐羲皇世，含饴弄孙。\n下陈蕃榻，倒屐迎客。\n眼睛头烨烨光明幢，脚跟下尘尘清泰国。\n卜邻陋巷，慕孔圣人获麟作传之风规。\n摵碎明珠，有郁山主骑驴过桥之标格。\n诚所谓入廛垂手，我自调心。\n继百世凛然，见古道之颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞国清灵叟和尚真入北□祖师会","author":"释绍昙","text":"貌古神清，气融性漫。\n用无准麻皮头，瞎临济正法眼。\n瘗焦山鹤，不假蓬尘。\n缚丰干虎，只消钱贯。\n八怪七乔，十马九乱。\n趁入群牛队里行，一年一度教人看。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对月了残经赞","author":"释绍昙","text":"五教三乘，之绕葛藤。\n一言道尽，玉兔东升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"团栾说无上话图赞","author":"释绍昙","text":"夙世冤憎，聚头合脑。\n面面相看，说个甚么。\n低声切莫使人知，竹石无情须笑倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"居士问马祖不与万法为侣图赞","author":"释绍昙","text":"万法本空，与谁为侣。\n道得十成，难为共语。\n饶伊一口吸西江，也是芭蕉深夜雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八","author":"释绍昙","text":"蛇头揩痒，虎口拔牙。\n拚得性命，始是作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十七","author":"释绍昙","text":"狗舐油铛，鼠咬甑箅。\n用尽机思，吃没滋味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十八","author":"释绍昙","text":"路透清波，山横翠壁。\n楼阁门开，从这里入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十七","author":"释绍昙","text":"古桧吟风，寒鸦布阵。\n不落见闻，几人错认。\n不错认，道士擎拳，阇梨问讯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十二","author":"释绍昙","text":"无量劫来，七颠八倒。\n打破虚空，全身入草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十二","author":"释绍昙","text":"有亦不管，无亦不管。\n饭来开口，睡来合眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五","author":"释绍昙","text":"山舍春深，生涯日贫。\n桃花烂熳，不见灵云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十六","author":"释绍昙","text":"我有一机，极尽玄微。\n饥来吃饭，寒来著衣。\n我有一句，包罗今古。\n犬吠枯桩，猫捉老鼠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十九","author":"释绍昙","text":"老倒住山，全无伎俩。\n揖客低腰，逢僧合掌。\n虽然俯顺时宜，不碍当机收放。\n鲲化鹏飞羽翼齐，抟扶一举青霄上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十六","author":"释绍昙","text":"紫芝峰下，小小山居。\n家风淡薄，堂供萧疏。\n茭粽叶包蒸米饭，野山茶点石菖蒲。\n天中令节，不用书符。\n百怪千妖自扫除，张道士、李师巫。\n望崖争却步，遗下药胡芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝阳穿破衲赞","author":"释绍昙","text":"断线无蹊，折针缺鼻。\n提得完全，金乌西坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其二 晴","author":"释绍昙","text":"湘英整佩，楚衣告纫。\n羲黄荐馥，采采疑真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其四 雪","author":"释绍昙","text":"幽石封白，深林掩芳。\n隐德不耀，何矜色香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其一 风","author":"释绍昙","text":"指玉弹晓，喙檀噀春。\n倏尔生妒，阴飙不仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋堂四兰 其三 雨","author":"释绍昙","text":"纷披佩玉，仆委苔痕。\n檐花写恨，难拈楚魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为昌州月上人赞布袋","author":"释绍昙","text":"拄杖不能倚靠，稳跨布袋打坐。\n莫怪喷嚏不成，鼻孔元来无窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其八","author":"释绍昙","text":"两耳炉焚柏子，一拳不养菖蒲。\n客至莫谈尘事，略寒温外跏趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其五","author":"释绍昙","text":"石涧霜凝松粉，竹篱雪点梅肤。\n春到山家日远，愧贫管领全无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其九","author":"释绍昙","text":"得失心无半点，圣凡机裂千差。\n终日山禽聚集，且无个去衔花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其六","author":"释绍昙","text":"晓径旋除榛翳，午厨要款邻僧。\n童子扫云归晚，忍饥趁□娇藤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其二","author":"释绍昙","text":"积雪封无过路，乱云堆满空庭。\n我也谁能扫得，掩关且读残经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其十","author":"释绍昙","text":"香醉人寻梅坞，马嘶声度云坳。\n急把柴门深掩，从教小外推敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其四","author":"释绍昙","text":"粉芋头煨软火，懒黄菁煮沙瓶。\n饭后乌藤用事，小奚忙启岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其一","author":"释绍昙","text":"野菜花飞胡蝶，古藤枝挂清猿。\n闲倚柴门看倦，枕肱高卧云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其三","author":"释绍昙","text":"盘石新封翠藓，破龛重绕青萝。\n唤起惊回残梦，月筛林影婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六言山居 其七","author":"释绍昙","text":"香雾晓垂帘幕，幽禽春弄笙簧。\n谁料贫无一物，迩来富敌君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台三隐赞","author":"释绍昙","text":"门钩弗解开扃，苕帚不能扫地。\n解说杜撰文书，背后有人切齿。\n将谓寒山听信他，不知笑里暗藏刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别源","author":"释绍昙","text":"不续曹溪正脉，支分一派朝宗。\n弘满清凉窟宅，春雷变化鱼龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十六","author":"释绍昙","text":"生平说大脱空，今受活地狱报。\n一片无骨舌头，数日和根烂了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 戒刀","author":"释绍昙","text":"恶钳锤下番身，未必锋芒发露。\n不惟斩得猫儿，也解煞佛煞祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 纸被","author":"释绍昙","text":"通身不挂寸丝，单明一色边事。\n要知结角罗纹，径问床分枕子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 拂子","author":"释绍昙","text":"才得柄霸入手，便要呵佛骂祖。\n还他本色真棕，不比寻常谈麈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 拄杖","author":"释绍昙","text":"格外丛林选出，生缘不在天台。\n虽然乌律卒地，力扶多少人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 香印","author":"释绍昙","text":"要识分明古篆，一槌打得完全。\n烧炷旃檀牛粪，衲僧鼻孔楔穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 钵盂","author":"释绍昙","text":"做处全无渗漏，用时开口向天。\n尽大地人饫饱，只图个不知恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 痒和子","author":"释绍昙","text":"既就良工雕琢，何妨出手扶持。\n抓著衲僧痒处，赏伊一枚荔枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 禅板","author":"释绍昙","text":"要成片段工夫，须是全身倚靠。\n虽然只见一边，未许睦州担荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 蒲团","author":"释绍昙","text":"百草头边荐得，何妨打块成团。\n直下千差坐断，无心犹隔重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅房十事 蒲龛","author":"释绍昙","text":"百匝千重包裹，未免黑山里坐。\n古今多少生盲，引得全身入草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靠袋睡赞 其二","author":"释绍昙","text":"弄尽千般死伎，布袋全身靠倚。\n寻思总是虚花，不如打觉瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靠袋睡赞 其一","author":"释绍昙","text":"自与尘劳交辊，肚里千机万变。\n虽然靠布被头，疑你睡得未稳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"举赵州访二庵主公案颂","author":"释绍悟","text":"一重山尽一重山，坐断孤峰子细看。\n雾卷云收山岳静，楚天空阔一轮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口占","author":"释绍嵩","text":"谷口残春黄鸟稀，野梅山杏暗芳菲。\n百千幽胜无人见，红白路花相杂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见张明府 其五","author":"释绍嵩","text":"江表人材独数公，南朝台阁是家风。\n景星但欲争先睹，还许从容广座中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见张明府 其二","author":"释绍嵩","text":"善政忻闻老父评，甘棠不剪向来荣。\n伫看孤洁成三考，千古无人继盛名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见张明府 其四","author":"释绍嵩","text":"雅淡天姿固可知，能除疾瘼似良医。\n道涂誇客无他语，道是徵黄有近期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见张明府 其三","author":"释绍嵩","text":"宏博自居韩柳前，素王妙道况亲传。\n圣朝未有徐州相，莫读当时归去篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见张明府 其一","author":"释绍嵩","text":"声采当年陆士龙，为官古雅少人同。\n柱天勋业须君了，更用文篇续国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙嵓江口","author":"释绍嵩","text":"淅淅寒流涨浅沙，小桥通去路横斜。\n因寻野渡逢渔舍，夹路松开黄玉花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游道场","author":"释绍嵩","text":"万仞峰头古道场，重来败叶带飞霜。\n感时偏动骚人兴，橘柚园篱近半黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再登蓬莱阁 其二","author":"释绍嵩","text":"野水瀰漫绿涨川，乱云如兽出山前。\n天生一本徐熙画，全是蓬莱十月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再登蓬莱阁 其一","author":"释绍嵩","text":"不到蓬莱又几时，且支筇杖看云移。\n等闲遇事成歌咏，人道新诗胜旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同周湛二上人游西湖之北山天竺晚归得十绝 其九","author":"释绍嵩","text":"幽刹寻春傍翠微，幡竿残日迥依依。\n西湖两岸千株柳，何似先教画取归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]