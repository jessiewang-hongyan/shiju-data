[{"title":"蝶恋花    其一 送祐之弟","author":"辛弃疾","text":"衰草残阳三万顷。\n不算飘零，天外孤鸿影。\n几许凄凉须痛饮，行人自向江头醒。\n会少离多看两鬓。\n万缕千丝，何况新来病。\n不是离愁难整顿，被他引惹其他恨！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其二 赋木犀","author":"辛弃疾","text":"弄影阑干，吹香岩谷。\n枝枝点点黄金粟。\n未堪收拾付薰炉，窗前且把离骚读。\n奴仆葵花，儿曹金菊。\n一秋风露清凉足。\n傍边只欠个姮娥，分明身在蟾宫宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 春日有感","author":"辛弃疾","text":"萱草齐阶，芭蕉弄叶。\n乱红点点团香蝶。\n过墙一阵海棠风，隔帘几处梨花雪。\n愁满芳心，酒潮红颊。\n年年此际伤离别。\n不妨横管小楼中，夜阑吹断千山月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其一 庚戌中秋后二夕带湖篆冈小酌","author":"辛弃疾","text":"夜月楼台，秋香院宇，笑吟吟地人来去。\n是谁秋到便凄凉？\n当年宋玉悲如许！\n随分杯盘，等闲歌舞，问他有甚堪悲处？\n思量却也有悲时，重阳节近多风雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 赋稼轩，集经句。","author":"辛弃疾","text":"进退存亡，行藏用舍。\n小人请学樊须稼。\n衡门之下可栖迟，日之夕矣牛羊下。\n去卫灵公，遭桓司马。\n东西南北之人也。\n长沮桀溺耦而耕，丘何为是栖栖者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行   其三 和赵国兴知录韵","author":"辛弃疾","text":"吾道悠悠，忧心悄悄，最无聊处秋光到。\n西风林外有啼鸦，斜阳山下多衰草。\n长忆商山，当年四老，尘埃也走咸阳道。\n为谁书到便幡然？\n至今此意无人晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏歌","author":"辛弃疾","text":"攧厥。\n看精神、压一庞儿劣。\n更言语、一似春莺滑。\n一团儿、美满香和雪。\n去也。\n把春衫、换却同心结。\n向人道、不怕轻离别。\n问昨宵、因甚歌声咽。\n秋被梦，春闺月。\n旧家事、却对何人说。\n告弟弟莫趁蜂和蝶。\n有春归花落时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉太平 春晚","author":"辛弃疾","text":"态浓意远。\n眉颦笑浅。\n薄罗衣窄絮风软。\n鬓云欹翠卷。\n南园花树春光暖。\n红香径里榆钱满。\n欲上秋千又惊懒。\n且归休怕晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉花阴","author":"辛弃疾","text":"黄花谩说年年好。\n也趁秋光老。\n绿鬓不惊秋，若斗尊前，人好花堪笑。\n蟠桃结子知多少。\n家住三山岛。\n何日跨归鸾，沧海飞尘，人世因缘了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉翁操","author":"辛弃疾","text":"长松。\n之风。\n如公。\n肯余从。\n山中。\n人心与吾兮谁同。\n湛湛千里之江。\n上有枫。\n噫，送子东。\n望君之门兮九重。\n女无悦己，谁适为容。\n不龟手药，或一朝兮取封。\n昔与游兮皆童。\n我独穷兮今翁。\n一鱼兮一龙。\n劳心兮忡忡。\n噫，命与时逢。\n子取之食兮万钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"糖多令/唐多令","author":"辛弃疾","text":"淑景斗清明。\n和风拂面轻。\n小杯盘、同集郊坰。\n著个簥儿不肯上，须索要、大家行。\n行步渐轻盈。\n行行笑语频。\n凤鞋儿、微褪些根。\n忽地倚人陪笑道，真个是、脚儿疼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十一 祝良显家牡丹一本百朵","author":"辛弃疾","text":"占断雕栏只一株。\n春风费尽几工夫。\n天香夜染衣犹湿，国色朝酣酒未苏。\n娇欲语，巧相扶。\n不妨老干自扶疏。\n恰如翠幕高堂上，来看红衫百子图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 席上吴子似诸公和韵","author":"辛弃疾","text":"翰墨诸君久擅场。\n胸中书传许多香。\n苦无丝竹衔杯乐，却看龙蛇落笔忙。\n闲意思，老风光。\n酒徒今有几高阳。\n黄花不怯秋风冷，只怕诗人两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八","author":"辛弃疾","text":"自古高人最可嗟。\n只因疏懒取名多。\n居山一似庚桑楚，种树真成郭橐驼。\n云子饭，水晶瓜。\n林间携客更烹茶。\n君归休矣吾忙甚，要看蜂儿趁晚衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八 用前韵和赵文鼎提举赋雪","author":"辛弃疾","text":"莫上扁舟向剡溪。\n浅斟低唱正相宜。\n从教犬吠千家白，且与梅成一段奇。\n香暖处，酒醒时。\n画檐玉箸已偷垂。\n笑君解释春风恨，倩拂蛮笺只费诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 和人韵有所赠","author":"辛弃疾","text":"趁得东风汗漫游。\n见他歌后怎生愁。\n事如芳草春长在，人似浮云影不留。\n眉黛敛，眼波流。\n十年薄幸谩扬州。\n明朝短棹轻衫梦，只在溪南罨画楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 峡石前用韵答子似","author":"辛弃疾","text":"叹息频年廪未高。\n新词空贺此丘遭。\n遥知醉帽时时落，见说吟鞭步步摇。\n乾玉唾，秃锥毛。\n只今明月费招邀。\n最怜乌鹊南飞句，不解风流见二乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十三 再赋","author":"辛弃疾","text":"浓紫深红一画图。\n中间更著玉盘盂。\n先裁翡翠装成盖，更点胭脂染透酥。\n香潋滟，锦模糊。\n主人长得醉功夫。\n莫携弄玉栏边去，羞得花枝一朵无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 离豫章别司马汉章大监","author":"辛弃疾","text":"聚散匆匆不偶然。\n二年遍历楚山川。\n但将痛饮酬风月，莫放离歌入管弦。\n萦绿带，点青钱。\n东湖春水碧连天。\n明朝放我东归去，后夜相思月满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九 徐衡仲惠琴不受","author":"辛弃疾","text":"千丈阴崖百丈溪。\n孤桐枝上凤偏宜。\n玉音落落虽难合，横理庚庚定自奇。\n人散后，月明时。\n试弹幽愤泪空垂。\n不如却付骚人手，留和南风解愠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八 寿子似，时摄事城中","author":"辛弃疾","text":"上巳风光好放怀。\n忆君犹未看花回。\n茂林映带谁家竹，曲水流传第几杯。\n摛锦绣，写琼瑰。\n长年富贵属多才。\n要知此日生男好，曾有周公祓禊来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 鹅湖归病起作","author":"辛弃疾","text":"著意寻春懒便回。\n何如信步两三杯。\n山才好处行还倦，诗未成时雨早催。\n携竹杖，更芒鞋。\n朱朱粉粉野蒿开。\n谁家寒食归宁女，笑语柔桑陌上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"困不成眠奈夜何！\n情知归未转愁多。\n暗将往事思量遍，谁把多情恼乱他？\n些底事，误人哪，不成真个不思家。\n娇痴却妒香香睡，唤起醒松说梦些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 席上再用韵","author":"辛弃疾","text":"水底明霞十顷光。\n天教铺锦衬鸳鸯。\n最怜杨柳如张绪，却笑莲花似六郎。\n方竹簟，小胡床。\n晚风消得许多凉。\n背人白鸟都飞去，落日残□更断肠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十三 送元省干","author":"辛弃疾","text":"敧枕婆娑两鬓霜。\n起听檐溜碎喧江。\n那边玉箸销啼粉，这里车轮转别肠。\n诗酒社，水云乡。\n可堪醉墨几淋浪。\n画图恰似归家梦，千里河山寸许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 睡起即事","author":"辛弃疾","text":"水荇参差动绿波。\n一池蛇影噤群蛙。\n因风野鹤饥犹舞，积雨山栀病不花。\n名利处，战争多。\n门前蛮触日干戈。\n不知更有槐安国，梦觉南柯日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 代人赋","author":"辛弃疾","text":"晚日寒鸦一片愁，柳塘新绿却温柔。\n若教眼底无离恨，不信人间有白头。\n肠已断，泪难收，相思重上小红楼。\n情知已被山遮断，频倚阑干不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"樽俎风流有几人。\n当年未遇已心亲。\n金陵种柳欢娱地，庾岭逢梅寂寞滨。\n樽似海，笔如神。\n故人南北一般春。\n玉人好把新妆样，淡画眉儿浅注唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五","author":"辛弃疾","text":"病绕梅花酒不空。\n齿牙牢在莫欺翁。\n恨无飞雪青松畔，却放疏花翠叶中。\n冰作骨，玉为容。\n当年宫额鬓云松。\n直须烂醉烧银烛，横笛难堪一再风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 代人赋","author":"辛弃疾","text":"陌上柔桑破嫩芽，东邻蚕种已生些。\n平冈细草鸣黄犊，斜日寒林点暮鸦。\n山远近，路横斜，青旗沽酒有人家。\n城中桃李愁风雨，春在溪头荠菜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十一","author":"辛弃疾","text":"发底青青无限春。\n落红飞雪谩纷纷。\n黄花也伴秋光老，何事尊前见在身。\n书万卷，笔如神。\n眼看同辈上青云。\n个中不许儿童会，只恐功名更逼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 和陈提干","author":"辛弃疾","text":"剪烛西窗夜未阑。\n酒豪诗兴两联绵。\n香喷瑞兽金三尺，人插云梳玉一弯。\n倾笑语，捷飞泉。\n觥筹到手莫留连。\n明朝再作东阳约，肯把鸾胶续断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其七 送廓之秋试","author":"辛弃疾","text":"白苎新袍入嫩凉。\n春蚕食叶响回廊。\n禹门已准桃花浪，月殿先收桂子香。\n鹏北海，凤朝阳。\n又携书剑路茫茫。\n明年此日青云去，却笑人间举子忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八 三山道中","author":"辛弃疾","text":"抛却山中诗酒窠。\n却来官府听笙歌。\n闲愁做弄天来大，白发栽埋日许多。\n新剑戟，旧风波。\n天生予懒奈予何。\n此身已觉浑无事，却教儿童莫恁么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"辛弃疾","text":"欲上高楼去避愁，愁还随我上高楼。\n经行几处江山改，多少亲朋尽白头！\n归休去，去归休，不成人总要封侯。\n浮云出处元无定，得似浮云也自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五 有感","author":"辛弃疾","text":"出处从来自不齐。\n后车方载太公归。\n谁知孤竹夷齐子，正向空山赋采薇。\n黄菊嫩，晚香枝。\n一般同是采花时。\n蜂儿辛苦多官府，蝴蝶花间自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十二 元溪不见梅","author":"辛弃疾","text":"千丈清溪百步雷。\n柴门都向水边开。\n乱云剩带炊烟去，野水闲将日影来。\n穿窈窕，历崔嵬。\n东林试问几时栽。\n动摇意态虽多竹，点缀风流却少梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"一片归心拟乱云，春来谙尽恶黄昏。\n不堪向晚檐前雨，又待今宵滴梦魂。\n炉烬冷，鼎香氛，酒寒谁遣为重温？\n何人柳外横斜笛？\n客耳那堪不忍闻！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 鹅湖寺道中","author":"辛弃疾","text":"一榻清风殿影凉。\n涓涓流水响回廊。\n千章云木钩辀叫，十里溪风䆉稏香。\n冲急雨，趁斜阳。\n山园细路转微茫。\n倦途却被行人笑，只为林泉有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 鹅湖归病起作","author":"辛弃疾","text":"翠竹千寻上薜萝。\n东湖经雨又增波。\n只因买得青山好，却恨归来白发多。\n明画烛，洗金荷。\n主人起舞客齐歌。\n醉中只恨欢娱少，明日醒时奈病何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 重九席上再赋","author":"辛弃疾","text":"有甚闲愁可皱眉。\n老怀无绪自伤悲。\n百年旋逐花阴转，万事长看鬓发知。\n溪上枕，竹间棋。\n怕寻酒伴懒吟诗。\n十分筋力夸强健，只比年时病起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 败棋赋梅雨","author":"辛弃疾","text":"漠漠轻云拨不开。\n江南细雨熟黄梅。\n有情无意东边日，已怒重惊忽地雷。\n云柱础，水楼台。\n罗衣费尽博山灰。\n当时一识和羹味，便道为霖消息来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"辛弃疾","text":"指点斋尊特地开。\n风帆莫引酒船回。\n方惊共折津头柳，却喜重寻岭上梅。\n催月上，唤风来。\n莫愁瓶罄耻金罍。\n只愁画角楼头起，急管哀弦次第催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十四 登一丘一壑偶成","author":"辛弃疾","text":"莫殢春光花下游。\n便须准备落花愁。\n百年雨打风吹却，万事三平二满休。\n将扰扰，付悠悠。\n此生于世百无忧。\n新愁次第相抛舍，要伴春归天尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"木落山高一夜霜。\n北风驱雁又离行。\n无言每觉情怀好，不饮能令兴味长。\n频聚散，试思量。\n为谁春草梦池塘。\n中年长作东山恨，莫遣离歌苦断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十四 不寐","author":"辛弃疾","text":"老病那堪岁月侵。\n霎时光景值千金。\n一生不负溪山债，百药难治书史淫。\n随巧拙，任浮沈。\n人无同处面如心。\n不妨旧事从头记，要写行藏入笑林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五 石门道中","author":"辛弃疾","text":"山上飞泉万斛珠。\n悬崖千丈落鼪鼯。\n已通樵径行还碍，似有人声听却无。\n闲略彴，远浮屠。\n溪南修竹有茅庐。\n莫嫌杖屦频来往，此地偏宜著老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六 子似过秋水","author":"辛弃疾","text":"秋水长廊水石间。\n有谁来共听潺湲。\n羡君人物东西晋，分我诗名大小山。\n穷自乐，懒方闲。\n人间路窄酒杯宽。\n看君不了痴儿事，又似风流靖长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六 送欧阳国瑞入吴中","author":"辛弃疾","text":"莫避春阴上马迟。\n春来未有不阴时。\n人情展转闲中看，客路崎岖倦后知。\n梅似雪，柳如丝。\n试听别语慰相思。\n短篷炊饭鲈鱼熟，除却松江枉费诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五 郑守厚卿席上谢余伯山，用其韵","author":"辛弃疾","text":"梦断京华故倦游。\n只今芳草替人愁。\n阳关莫作三叠唱，越女应须为我留。\n看逸韵，自名流。\n青衫司马且江州。\n君家兄弟真堪笑，个个能修五凤楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 送人","author":"辛弃疾","text":"唱彻阳关泪未乾。\n功名馀事且加餐。\n浮天水送无穷树，带雨云埋一半山。\n今古恨，几千般。\n只应离合是悲欢。\n江头未是风波恶，别有人间行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十七 寄叶仲洽","author":"辛弃疾","text":"是处移花是处开。\n古今兴废几池台。\n背人翠羽偷鱼去，抱蕊黄须趁蝶来。\n掀老瓮，拨新醅。\n客来且尽两三杯。\n日高盘馔供何晚，市远鱼鲑买未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 和张子志提举","author":"辛弃疾","text":"别恨妆成白发新。\n空教儿女笑陈人。\n醉寻夜雨旗亭酒，梦断东风辇路尘。\n骑騄駬，籋青云。\n看公冠佩玉阶春。\n忠言句句唐虞际，便是人间要路津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十六 博山寺作","author":"辛弃疾","text":"不向长安路上行。\n却教山寺厌逢迎。\n味无味处求吾乐，材不材间过此生。\n宁作我，岂其卿。\n人间走遍却归耕。\n一松一竹真朋友，山鸟山花好弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 重九席上作","author":"辛弃疾","text":"戏马台前秋雁飞。\n管弦歌舞更旌旗。\n要知黄菊清高处，不入当年二谢诗。\n倾白酒，绕东篱。\n只于陶令有心期。\n明朝重九浑潇洒，莫使尊前欠一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"石壁虚云积渐高。\n溪声绕屋几周遭。\n自从一雨花零乱，却爱微风草动摇。\n呼玉友，荐溪毛。\n殷勤野老苦相邀。\n杖藜忽避行人去，认是翁来却过桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十二 赋牡丹，主人以谤花索赋解嘲","author":"辛弃疾","text":"翠盖牙签几百株。\n杨家姊妹夜游初。\n五花结队香如雾，一朵倾城醉未苏。\n闲小立，困相扶。\n夜来风雨有情无。\n愁红惨绿今宵看，却似吴宫教阵图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 和昌父","author":"辛弃疾","text":"万事纷纷一笑中。\n渊明把菊对秋风。\n细看爽气今犹在，惟有南山一似翁。\n情味好，语言工。\n三贤高会古来同。\n谁知止酒停云老，独立斜阳数过鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六","author":"辛弃疾","text":"一夜清霜变鬓丝。\n怕愁刚把酒禁持。\n玉人今夜相思不，想见频将翠枕移。\n真个恨，未多时。\n也应香雪减些儿。\n菱花照面须频记，曾道偏宜浅画眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"点尽苍苔色欲空。\n竹篱茅舍要诗翁。\n花馀歌舞欢娱外，诗在经营惨澹中。\n听软语，笑衰容。\n一枝斜坠翠鬟松。\n浅颦轻笑谁堪醉，看取萧然林下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十二 和赵晋臣敷文韵","author":"辛弃疾","text":"绿鬓都无白发侵。\n醉时拈笔越精神。\n爱将芜语追前事，更把梅花比那人。\n回急雪，遏行云。\n近时歌舞旧时情。\n君侯要识谁轻重，看取金杯几许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]