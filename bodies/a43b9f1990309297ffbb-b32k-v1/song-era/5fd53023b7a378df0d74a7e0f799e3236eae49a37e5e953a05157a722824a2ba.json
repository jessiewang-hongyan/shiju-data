[{"title":"句 其四","author":"林月香","text":"可怜几幅通神画，只入桓玄夹道中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玩月有感","author":"谢钥","text":"入夜茶瓯苦上眉，眼花摧落石床棋。\n举头却恨天边月，颠倒山河作树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送袁明府衡任满入都","author":"王应凤","text":"吉甫清风作诵初，圣门宓子又焉如。\n四郊无复容成鹤，一室惟空尘釜鱼。\n笙谱由庚乡饮酒，凤来榆次帝徵书。\n得人自古称嘉政，会见三公命贲庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次寒山寺","author":"赵必瞻","text":"可惜邯郸梦未成，数闻僧舍木鱼声。\n寒鸡有意催人起，早解孤舟晓月行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"通问蒙古羁留自述","author":"赵必瞻","text":"丈夫辞上国，千里为封侯。\n志似冲天鹄，身如系缆舟。\n终同刘敬返，暂作子卿留。\n戈鼓从伊竞，客心岂倦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"赵必瞻","text":"生平许国惭无补，化作东风扫虏尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游九锁","author":"俞煜","text":"万山低伏天柱起，郁郁琳宫锁幽邃。\n泉声泻入松风寒，山光滴破云根翠。\n仙人不归白日暮，箬下还丹已千岁。\n天高辽鹤不可呼，梦魂夜落青山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪措置夫丁一","author":"邵君美","text":"习书来自浒黄州，南北相关事可忧。\n弓手寨兵差发了，民丁个个是貔貅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪镇静有功二","author":"邵君美","text":"官船只只离巴城，邻境如何免得惊。\n镇日爱人堂上坐，夜更朝鼓转分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪存恤流民三","author":"邵君美","text":"南阳过渡尽流移，携子携妻那处依。\n兴化寺中都住满，俵钱俵米给他归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪犒遣过军四","author":"邵君美","text":"客军过县没公凭，百姓惊移怕起争。\n犒物犒钱皆望外，秋毫无犯奔程行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪置栅关防五","author":"邵君美","text":"县方忧北又忧南，无寨无城么障拦。\n近县路头都置栅，哨鞭直突也应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪钉截县江六","author":"邵君美","text":"县江日日过车船，传是官军或不然。\n截断县江教莫入，民舟方始得安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪劝谕发粜七","author":"邵君美","text":"米舟米担尽无来，有米有家户不开。\n急把公文行劝粜，贫民生意挽将回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪出俸钱权当八","author":"邵君美","text":"库家不典更愁人，作么经营米与薪。\n自出俸钱权抵当，雪霜时候反如春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪杜绝草窃九","author":"邵君美","text":"盗猪何足挠官刑，却恐因兹草寇萌。\n押向市心搥去手，金场窑卒敢纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪团集民舟十","author":"邵君美","text":"居民苦要买船般，甲在前湖作一团。\n好个规模如水寨，风波无恐况风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪置安报旗十一","author":"邵君美","text":"朝朝探报晓民间，犹更讹传百十般。\n旗上大书安与急，展开安字一齐安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪帮给官军十二","author":"邵君美","text":"官司调卒过千馀，帮请那知廪帑虚。\n一发券头支五日，这般调画有谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪关防县界十三","author":"邵君美","text":"巴湘二界缺关防，不是隅官不说详。\n费得琴堂数杯酒，南阳一度胜金汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪哨马伏地十四","author":"邵君美","text":"黄花市路苦无多，长乐街头几度过。\n哨骑欲来先自伏，邦人喜不见兵戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵侯保民惠政纪实诗 纪百姓感恩十五","author":"邵君美","text":"花欢柳喜劝耕夫，綵帜如云拥轿前。\n万口一辞何以祝，福王坐处有青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贾似道入相","author":"理宗庚申士人","text":"收拾乾坤一担担，上肩容易下肩难。\n劝君高著擎天手，多少傍人冷眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咸淳乙丑良月同张彭二寅契游七星岩因以纪胜","author":"苏良","text":"杖屦追随入翠蓬，玲珑一窍彻心胸。\n山罗斗宿英灵萃，地镇龙潜气势雄。\n碑藓犹涵周子泽，涧松仍有老包风。\n岁寒共约吾三友，要把清规踵二翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再咏星岩","author":"苏良","text":"曾闻娲氏补天漏，也记春秋石陨星。\n却讶端岩星错落，何时漂坠数峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓鳌台","author":"苏良","text":"汗漫孤槎到海滨，荒阡触目尽忧薰。\n休粮未遇赤松子，采蕨终惭孤竹君。\n甚欲去寻东道主，只愁见谕北山文。\n秋风吹动归与兴，又隔扶胥一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹隐精舍","author":"苏良","text":"千古仪型竹隐堂，此身虽晦道弥光。\n轩裳不入山林梦，尘土难侵冰雪肠。\n清影雅宜梅共瘦，高风堪与菊同芳。\n斯文一派流传远，羞把庭槐祝二郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其一","author":"释月涧","text":"东邻西舍，隔壁深冤。\n真语实语咒诅语，分明为我重宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二","author":"释月涧","text":"随师三年，咳嗽相似。\n山僧随这老汉六年，相识还同不相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三","author":"释月涧","text":"一切众生，本曾不迷。\n悟之一字，甚处得来。\n堪笑老瞿昙，镜上又添埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四","author":"释月涧","text":"生铁网，布丝网，弄尽乞儿泼伎俩。\n天下衲僧皆乞命，至今杀气填穹壤。\n我幸当时不入头，今日思量也好骂伊一上。\n休休，他是蓬莱山里人，只消饶蓬莱香供养。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其五","author":"释月涧","text":"迷不自迷，对悟立迷。\n悟不自悟，因迷说悟。\n悟乃迷之体，迷乃悟之用。\n青天白日，切忌说梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其六","author":"释月涧","text":"天无门，地无户，山僧有个通霄路。\n一步两步，三四五步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其七","author":"释月涧","text":"八十种好，三十二相。\n丑恶容止，喂狗不噇。\n正好烧香供养。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其八","author":"释月涧","text":"即心即佛，狐狸恋窟。\n非心非佛，当机放出辽天鹘。\n马大师等闲向虚空里抛个题目，经今五七百年，更无一人描写得著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其九","author":"释月涧","text":"记得鹅峰相聚日，嗔拳热喝当慈悲。\n而今含恨重相见，只得开颜陪笑，欢喜接伊。\n何为如此，为怕粗心捋虎须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十","author":"释月涧","text":"古佛心，无背面。\n泥团土块，砖头瓦片。\n是汝诸人，每日于土木场中，何止行一遍两遍，三四五遍。\n因甚足踏不著，眼觑不见。\n令人长忆谢玄晖，解道澄江净如练。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十一","author":"释月涧","text":"六阴剥尽，鄱阳湖尽底乾枯。\n一阳复生，蠙州门暗通一线。\n长一线，一线长，个事分明不覆藏。\n有般汉闻与么告报，便道一生二，二生三，三生万物。\n如斯领会，笑倒街头石敢当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十二","author":"释月涧","text":"见见之时，见非是见。\n只如灵云见桃花，毕竟是见非见。\n玉兔挨开碧海门，金乌啄破琉璃殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十三","author":"释月涧","text":"布袋头，今日结。\n上三星，下半月。\n观著重添眼中屑。\n没理会，易分别。\n若要通身冷汗流，嚼碎通红块生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十四","author":"释月涧","text":"诸佛的旨，诸祖玄机，分明觌面为提持。\n是汝诸人，因甚觑著眼如眉。\n易填巨壑，难满漏卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十五","author":"释月涧","text":"佛祖格外机，衲僧向上著。\n著眼觑不是，举步踏不著。\n拟之即差，不拟尤错。\n是汝诸人，九十日如鹰在韝，如鱼在箔，有甚快乐。\n山僧今日出手，为诸人解拈去缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十六","author":"释月涧","text":"横十尺，竖十尺。\n潦倒鞠多尊者，三千里外斫额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十七","author":"释月涧","text":"结虚空，捏定如生铁。\n解圣凡，普请出阴界。\n西天此土，南岳天台，总不出师僧陈年破草鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十八","author":"释月涧","text":"圆陀陀，明历历。\n堪笑老瞿昙，六年犹不识。\n蓦忽眼皮绽，喜欢三七日。\n直得东湖尽力赞叹，也赞叹不及。\n毕竟赞叹个什么，乞儿拾得锡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其十九","author":"释月涧","text":"塞云点点阵云高，黑面将军衣白袍。\n夺得贼鎗并贼马，凯歌归去醉春醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十","author":"释月涧","text":"无端尽把泼众私，摊向人前谁点痴。\n对面不能掀倒去，满天风雨谩凄其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十一","author":"释月涧","text":"若人生百岁，不善诸佛机。\n未若生一日，而得决了知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十二","author":"释月涧","text":"岁在子，月在子，一阳生在子。\n惟有衲僧家，佛不知有释迦老子，祖不知有达磨老子。\n又谁管你天翻地覆，阴消阳长一著子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十三","author":"释月涧","text":"骤雨涨溪高数尺，失却捣衣平正石。\n明朝水落石依然，老夫一夜空相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十四","author":"释月涧","text":"威音未生已前，有此清凉大木。\n根蟠无阴阳地上，影藏叫不响山谷。\n枝枝叶叶，婆婆娑娑，荫覆天下人。\n彷佛当年黄檗会中，吃蒿枝底尊宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十五","author":"释月涧","text":"定乾坤句，雷厉风飞。\n提佛祖令，厓崩石裂。\n法主大宝，自然而至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十六","author":"释月涧","text":"九十日内，山河大地一布袋。\n九十日外，是圣是凡无挂碍。\n朝南岳，暮天台。\n饭钱即且置，还我草鞋钱来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十八","author":"释月涧","text":"天地红炉郁且蒸，万岳清撼寒涛声。\n六月卖无价，奈此松风清。\n拊阑一笑大江横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其二十九","author":"释月涧","text":"天边有月生云际，木人石人眼卓竖。\n瞥转玄机那边睹，三个孩儿抱花鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十","author":"释月涧","text":"是亦刬，非亦刬，尽法无民。\n山僧今日，曲为指陈，幽州江口石人蹲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十一","author":"释月涧","text":"从他节序又迎新，衲被蒙头总不闻。\n清晓偶然台上立，几多人错认观云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十二","author":"释月涧","text":"旷大劫来明历历，缘何此夜眼方开。\n六年痴坐无折合，谩诳众生出岫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十三","author":"释月涧","text":"美如西子离金阙，娇似杨妃下玉楼。\n十二金钗颠倒插，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十四","author":"释月涧","text":"有准的，没窠臼。\n有时觑捕全无，无时觑捕还有。\n取不得，舍不得，饶州城里一分钞，买柄芭花帚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十五","author":"释月涧","text":"鸟鸣芳树，蛙闹葑池。\n最亲最切，总为提持。\n不如三更枝上，一声声是杜鹃啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十六","author":"释月涧","text":"西江十八滩声，太白峰头同一眼听。\n东海泼天涛澜，集云峰顶同一耳观。\n眼耳俱忘，观听皆灭。\n三十年后重新举，舜若多神惊吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十七","author":"释月涧","text":"一年将尽是今宵，自觉丛林未寂寥。\n莫莫堂前香蔼蔼，十分春色上梅稍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十八","author":"释月涧","text":"昔日玲珑岩顶上，无端日午现妖星。\n黑光照耀四天下，眩惑蠢动并含灵。\n人人尽指为太白，山僧亲识破，元却是长庚。\n诸人只今要见么，此去明州十万程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其三十九","author":"释月涧","text":"等闲拈起一茎草，贵如泥土贱如金。\n活能死兮死能活，那个师僧病最深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十","author":"释月涧","text":"云开万里乾坤阔，玉漏声沈夜未央。\n一片灵明轻发现，满天满地撒寒光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十一","author":"释月涧","text":"两堂首座，一人拈出照乘之珠，一人拈出连城之璧。\n临济寻常喝似雷奔，者里下得一喝，何止价增十倍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十二","author":"释月涧","text":"一机不露，万机寝削。\n今日当阳，提者一著。\n荆山之玉轻抵鹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十三","author":"释月涧","text":"如佛见佛，佛无异见。\n如法说法，法无异说。\n只如鸦鸣鹊噪，莺啼燕语，是有异说，是无异说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十四","author":"释月涧","text":"子得其用，父得其体。\n互呈丑恶，挂人唇齿。\n至今茶树上，叶叶哭春雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十五","author":"释月涧","text":"世尊拈花，南泉指花，灵云桃花，智门莲花，总是空花，添得衲僧眼中花。\n诸人若要发明心花，直须铁树开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零三首 其四十六","author":"释月涧","text":"世尊有密语，今古无人举。\n等闲举得最分明，夜来滴滴檐头雨。\n诸人睡著不曾知，付与村农自歌舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]