[{"title":"逍遥咏 其十八","author":"赵炅","text":"真空达得便须休，二起生三一上求。\n谩说希夷来遂古，还知造化不同流。\n伏藏密旨机关内，合会非常本自由。\n若遇逢师亲口诀，才年返少保千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"我达逍遥理，阴阳运五行。\n道从初一变，德合混三清。\n圣境堪依仗，狐疑事不成。\n异端违雅淡，返祸自轻生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"时人不识理深玄，细意精修补业牵。\n幻化杳冥随物性，虚无岂是乱相迁。\n龙飞入位真堪仰，虎伏休闲有自然。\n洞里烟霞何缥缈，神仙景致没休年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十九","author":"赵炅","text":"虚无知者少，秘默在丹田。\n铅化金根树，鼎光玉液泉。\n相宗难且易，绝妙理深玄。\n真境犹来是，依经学昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"人心多是少相投，非识尘中上品流。\n不见真宗归物理，难知妙道后先休。\n生前内鼎宜烹鍊，殊胜华池好渐修。\n但见完全凭土德，能调火候药皆秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十一","author":"赵炅","text":"逍遥通大道，物象古从今。\n一气无穷极，三才妙更深。\n愚迷皆自缚，圣境可周寻。\n消息存亡理，先忧力不任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"梦寐其中物，常人何得知。\n阴寒三数变，阳暖两相宜。\n宿世终皆有，无缘勿强为。\n真铅归至道，龙虎笑华池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十六","author":"赵炅","text":"交结从头有顺违，方知雾散若云飞。\n超凡入圣含金体，抛弃迷蒙挂紫衣。\n细认消停无远近，分明意外隐玄机。\n相逢配偶为闲事，谁解调持得一归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"一法归千法，真如即是真。\n迷情终不见，达了悟知因。\n海纳分他境，心平故可亲。\n但明修鍊路，善业尽随身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"灵芝出见少人知，此是含玄故不疑。\n隐逸大同非妄想，精诚自化岂参差。\n翱翔碧落乘云驾，宛转虹霓入室时。\n至道就中升降等，凡田日用有盈亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"世界无穷尽，论之远更深。\n阴阳分皂白，瓦砾变黄金。\n报应终还有，邪求不易寻。\n匆忙谁正定，须是合天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十","author":"赵炅","text":"逍遥抱一岂相差，方便门开智慧花。\n神室分形添石髓，华池巨燄隐灵砂。\n穹隆务实归宗旨，释意从容不是赊。\n滋味勿教贪过度，必然混世老天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十六","author":"赵炅","text":"铅汞精修鍊，阴阳协物情。\n花开黄道正，药就紫烟轻。\n海峤浮云合，神光照室明。\n彩霞高丽日，细意话长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"仙经无限意，龙虎返丹砂。\n采缀阴阳理，终期岁月赊。\n求来皆有应，不信固难誇。\n忙说闲清境，真诚悟几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"灵草灵砂起自然，却将非外乱烹煎。\n黄牙成土堪名药，秋石为胎本是铅。\n乐道逢来忻且喜，周知体认更完全。\n阳施阴授宜消息，不识时人在眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十六","author":"赵炅","text":"栖心隐逸故非常，大约恒持要久长。\n清净好为皆是益，周旋理度审安详。\n法乾驭物须平稳，顺日成功自酌量。\n倏忽之间堪疋配，临时巧拙见圆方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"还知受气禀天然，百法方为事理全。\n假合都来归至道，修持远大理通玄。\n二仪交感成祥瑞，八卦刚柔被俗牵。\n何谓此中生恍惚，直须款曲细精研。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"逍遥心自乐，清净保长生。\n至道归玄理，真空造化成。\n辉华扬日彩，偃仰顺风声。\n里外有何物，刚柔鍊始精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"天地含清泰，阴阳道所成。\n冲和玄妙术，勿讶说长生。\n起信何疑误，迷来却谤轻。\n摄心归正念，淡薄恶销声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"天上与人间，贤愚不暂闲。\n精修归至理，道大隐玄关。\n圣境皆奇绝，凡情岂易攀。\n群仙宽坦荡，却老尽童颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十八","author":"赵炅","text":"知之修鍊但辛勤，若志由来离六尘。\n金鼎乍分红燄火，月魂高锁碧潭津。\n深思五岭凡间路，好作三天物外人。\n万里州通宽世俗，清虚境象善求真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十六","author":"赵炅","text":"还丹百数细须寻，以验从来道理深。\n火候混成如白屑，水中凝结是黄金。\n循环复始周旋鼎，造化驱驰要用心。\n消息玄门穷八卦，飞腾自在远山岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"形影随人得，精修道不迷。\n研穷深理路，造化隐端倪。\n云引龙吟穴，风生虎啸溪。\n少知愚岂解，南北与东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其六","author":"赵炅","text":"口称千岁少年颜，不是天人即地仙。\n四海五湖皆遍历，十洲三岛去周迁。\n道高举措何优劣，精彩非常语更贤。\n物理开襟通象外，未知几许达深玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十九","author":"赵炅","text":"不争多气力，容易可成功。\n意马须调伏，如尘幻梦中。\n任持从雅淡，乐道定雌雄。\n修鍊知勤苦，因缘自合同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"脱空谩语莫知真，诳惑愚蒙呼杀人。\n爱者拟求名利用，被他误赚怕论申。\n唯言草异生岩谷，更说天涯泛海津。\n有甚相干争道理，几家烧鍊几家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"愚痴常似醉，何异梦中人。\n欲达终无见，怀疑道岂亲。\n非为贪闭口，那是益于身。\n先生堪寂默，种福不传因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二","author":"赵炅","text":"雅澹玄中得，常人故不知。\n幽深无远近，道外细推之。\n碧落神仙境，烟霞日月随。\n参详寰宇内，邪正岂相离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"含元得一本真宗，误者平论总是空。\n万象都来皆备数，千言譬谕了然通。\n才高俊彦优堪赏，窃禄偷安有异同。\n唯愿他心如似我，不教陷恶罪身中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"燕雀不生凤，阴阳一气全。\n无穷深可及，境象理推迁。\n奚益其形化，平章语默玄。\n终身何所役，道本岂私焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十","author":"赵炅","text":"乾坤之内隐长生，药变还丹道已成。\n救世神方堪自秘，乐耶语话勿相轻。\n眠云卧水通玄识，点石为金谁辩明。\n黄才身心皆得所，登坛善听步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"虚无知大道，极意思悠然。\n摩日云中雁，潇湘水似天。\n孤峰高远近，宝月瑩团圆。\n信解明开悟，青霄在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"无名踪迹故难兴，智者消详冷似冰。\n廓落异端随日变，乖违法度受天惩。\n机关勿使招他谤，亮直温和自举升。\n好事相宗堪轨范，方言内外一般称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"逍遥知语默，境外见真空。\n有位皆玄感，无缘不用功。\n义说三才理，幽深万事通。\n因依堪法则，答谢向旻穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十五","author":"赵炅","text":"自在无拘束，逍遥里外安。\n顽情终不见，圣境类乎端。\n机智将何用，幽深大道宽。\n区分能解意，四季一周看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"丹丘雾彩好林峦，尽是天宫不死仙。\n常与神人为窟宅，能兴风雨秀山川。\n溪头云出摇红叶，谷口村稀伴碧烟。\n题品洞门房密秘，隐藏踪迹恐相传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"道法穷来理甚玄，知之修鍊口亲传。\n栖真有象藏乌兔，自在遨游本地仙。\n赤水华池须是秘，黄牙宝鼎要精研。\n灵胎变化无相剋，龙虎升腾论汞铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"八风雷动绕炎洲，巨海波浪四畔流。\n鼠向此中毛骨异，布成将旧火燃休。\n白银绛阙光霞丽，紫玉黄芝瑞气浮。\n圣境山林人莫讶，延年皆是众仙游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十一","author":"赵炅","text":"岂将容易话长生，辛苦徒劳业未精。\n安肯便教贪上得，先须礼让后纯诚。\n绛霄音旨人难解，白雪消停竖有横。\n象外仙山诸境趣，若非修鍊蹑三清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十四","author":"赵炅","text":"发愿行平等，天观必照知。\n贪嗔常不见，善恶岂相规。\n利益恒将正，勿教乱所思。\n因缘如响合，变化杳无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"紫陌红尘里，贪名利好争。\n世情皆扰攘，大道甚纵横。\n弦直终无曲，心邪自不平。\n若能如遂意，后学法先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其一","author":"赵炅","text":"白日众生见，几来得意人。\n萍蓬如似梦，丹鼎妙清神。\n红树非花影，青松压海津。\n入玄龙虎伏，大道许相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"气类须相假，阴阳造化成。\n离凡知有圣，得外更求精。\n先秘庚辛理，后传戊己名。\n真铅归一体，交感自长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二十","author":"赵炅","text":"铅汞丹方不谩论，同归一体有玄门。\n刚柔产取黄牙树，远近先明赤水魂。\n化质昭然清日月，纵横无碍杳乾坤。\n龙吟虎啸真非是，雾散云飞似雨奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十七","author":"赵炅","text":"昭宣形体思悠然，那是愚夫那是仙。\n不识饶教非远近，误来何事苦相悬。\n含容里外无诸物，象法其由语话诠。\n品格调高奔世界，任从他宝四周迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"达取真空性，成名有后先。\n智劳如似梦，恬澹不论年。\n闭口恒持默，精修更是玄。\n消停须在意，安稳上清天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"刚柔得所自安宁，五色霞光景象清。\n龙倚穴吟云雨至，虎依岩啸涧风生。\n从容海峤非遥远，倏忽烟萝别有情。\n谁到真空闲密地，火轮玉阙镇常明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"恍惚人难晓，天仙语默玄。\n修心无道理，终日自忙然。\n我命真中趣，长生认宿缘。\n机权饶使用，圣事不虚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"清静人安乐，恒持要久长。\n秋天澄皓色，春日发辉光。\n一气从初立，三才位不忙。\n群生如似梦，甚处得馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"刚气纵横合，无人到所思。\n浮生看即易，至理杳难知。\n返覆因兴念，恒持入远期。\n孤云霄汉外，花见晚霜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"逍遥我命在玄穹，鹤宿霞栖景致中。\n自得安宁兼养道，更将利益屏群雄。\n渊深引古知今用，劈斫区分尽可通。\n和畅五音从豁达，乾坤之内霭溟濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"南来北去及东西，万物难归一等齐。\n倏忽争知兴变易，幽玄恬澹不昏迷。\n区分有截无邪见，轨范如空咏好题。\n天且岂容私辅德，功成自竖入云梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"离男坎女甚清廉，金鼎分毫上火炎。\n莫把馀心怀利用，古先学士诫无厌。\n深藏异宝参详理，已渐成形旋要添。\n运转但教经岁月，光扬溢目众人瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其二","author":"赵炅","text":"遁迹深岩谷，身闲未是闲。\n研穷堪语默，寂静杳冥间。\n秘密逢邪见，难开大道关。\n金丹无效用，弗可返童颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"逍遥人控鹤，碧落压天津。\n达理通含识，虚无即是真。\n河车谁肯信，铅汞本相亲。\n造化皆如此，今缘论宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其九","author":"赵炅","text":"户牖常开闭，升沈倏忽中。\n龙吟深邃理，虎啸语言通。\n南北思长远，东西道不穷。\n炎光收月魄，桂树发花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"玄机圣境谩劳心，何似穷研道理深。\n升降自然随我命，莫教虚度向光阴。\n几人达得幽闲趣，如树争高力不任。\n闇里差殊终坠堕，神仙尚恐有飞沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十二","author":"赵炅","text":"神水华池妙更精，非铅非汞妄干名。\n河车本是延龄药，戊子从教配类成。\n朱雀坎蛇安在后，青龙白虎免交争。\n若使真金全二八，何忧住世不长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其三","author":"赵炅","text":"停腾火候诘炎山，九转方能济世间。\n玉蕊花开真可爱，红炉鼎内境幽闲。\n人逢药就延长久，羽驾仙迎返少颜。\n尽在目前非是远，定知时日好登攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"青松本不树萧条，学士因何智自劳。\n金水朗然明皎洁，雪山堆积就中高。\n志心但觅三神药，凡目难观万里毫。\n我独闲吟谁解意，悠哉丽日压灵鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十三","author":"赵炅","text":"飞腾自在莫教赊，坎女离男共一家。\n无碍逍遥通智慧，将求利乐勿须誇。\n灵根就看和春雪，神室之中有绛砂。\n彼是彼非堪可重，常娥倚树笑唅呀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其四","author":"赵炅","text":"清虚闲静得，奉道见真归。\n契合皆堪用，因缘事好依。\n精诚求谛信，须有是兼非。\n豁达幽深远，奥妙入玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其七","author":"赵炅","text":"真一生天地，因依认宿缘。\n智高通理性，凡下少周旋。\n语默何奇绝，幽深隐圣贤。\n谁人解我意，大道寸心玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其十","author":"赵炅","text":"乾关万象审消停，子母相传日月精。\n产药要教千日化，玄门全藉五行清。\n灵胎脱体方知圣，铅汞梯媒不是名。\n金鼎就来从变质，阳和阴气两俱生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其八","author":"赵炅","text":"逍遥名有理，得一便知空。\n道本皆深邃，凡为不易穷。\n品流才雅淡，格致意潜通。\n救世传相益，因成顺八风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"皇天无不照，福业重来轻。\n背正堪何益，归真道自成。\n本元宗一体，功行录三清。\n几许解吾意，慈悲利益平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥咏 其五","author":"赵炅","text":"逍遥里外混诸天，澹荡其中四叙间。\n拂拭尘埃明印月，遍驱神鬼锁骊山。\n装添出没何奇异，秘隐藏真未是闲。\n但好消详清景内，勿生疑虑动机关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]