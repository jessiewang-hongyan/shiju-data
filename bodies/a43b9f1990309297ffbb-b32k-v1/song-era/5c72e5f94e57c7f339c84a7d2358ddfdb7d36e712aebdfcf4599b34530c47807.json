[{"title":"偈颂三十八首 其二十五","author":"释如净","text":"大海汪洋，须弥突兀。\n现在说法不思议，稽首光明最奇特。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十四","author":"释如净","text":"解却禅和布袋头，虚空豁达逞风流。\n去亦得，住亦得，大用现前无轨则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十三","author":"释如净","text":"天苍苍，地皇皇。\n钟馗元是鬼，赤口并消亡。\n衲僧八面无门户，今古寥寥白昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十二","author":"释如净","text":"灯点点，月团团，游人歌鼓闹中看。\n咫尺凤楼开雉扇，玉皇仙仗紫云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十一","author":"释如净","text":"天得一以清，元正启祚。\n地得一以宁，万物咸新。\n且道衲僧得，一合作么生，太平歌有道，和气笑迎春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二十","author":"释如净","text":"雨打虚空乾剥剥，日明大地黑漫漫。\n个中开得金刚眼，生死何尝有异端。\n须弥山，大海水，衲僧顶上波涛起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十九","author":"释如净","text":"涅槃堂里死功夫，风衮葫芦水上浮。\n恁么点开参学眼，释迦弥勒是他奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十八","author":"释如净","text":"独瞎顶门眼，大人具大见。\n掀翻瓮里天，大智具大机。\n以大入小，万化普施。\n莺迁乔木调新舌，梅吐清香发旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十六","author":"释如净","text":"清净法身卢舍那，衲僧队里乾罗卜。\n逐日呼来打一槌，万像森罗转辘辘。\n知恩以此报深恩，大家赢得噇斋粥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十三","author":"释如净","text":"风飒飒，雨霖霖。\n圣人不曾灭度，演出清净妙音。\n若将耳听终难会，一句机先透古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十二","author":"释如净","text":"云漫漫，雨漫漫。\n中秋当此夜，漫漫黑漫漫。\n个般真境界，赢得倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十一","author":"释如净","text":"四月十五日结夏，老鼠入饭瓮。\n七月十五日解夏，乌龟上竹竿。\n诸方恁么，净慈不然。\n翻身透出竿头路，开眼掀翻瓮里天。\n咄，两段不同休寐语，机先鹞子隔驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其十","author":"释如净","text":"结夏已过了，解夏犹未来。\n中间一句子，莲花照水开。\n因甚落草止啼，元只为婴孩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其八","author":"释如净","text":"檐声不断前旬雨，电影还连后夜雷。\n麦怕水侵秧怕冷，蚕桑犹要暖来催。\n众生没在苦，苍天良可哀。\n咄，杲日当空慧眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其七","author":"释如净","text":"不曾生，不曾死，洞里桃花红照水。\n可怜开眼被渠瞒，人间天上风波起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其六","author":"释如净","text":"霖霪大雨，豁远大晴。\n虾蟆啼，蚯蚓鸣，古佛不曾过去，发挥金刚眼睛。\n咄，葛藤葛藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其五","author":"释如净","text":"今朝二月初一，拂子眼睛凸出。\n明似镜，黑如漆。\n蓦然?跳，吞却乾坤一色。\n衲僧门下，犹是撞墙撞壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其四","author":"释如净","text":"一言相契，万古不移。\n柳眼发新条，梅花满旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其三","author":"释如净","text":"截断千差，单提一著。\n那边放下龟毛，者里拈起兔角。\n咦，敲开欢喜妙楼阁，瑞霭祥云充碧落。\n转入梅花烂熳看，春风撼动玉栏干。\n人天普会，佛祖透关。\n发大机，显大用，铁锤混队骨毛寒。\n四海五湖皇化里，太平无象有来端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其二","author":"释如净","text":"黄金殿上一转语，烜赫红轮照万方。\n草木丛林成正觉，砖头瓦砾放毫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十八首 其一","author":"释如净","text":"净慈门下，牛栏马厩。\n一拶透关，豁开宇宙。\n咦，切忌追风捕影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三十四","author":"释如净","text":"糁径杨花铺白毡，点池荷叶叠青钱。\n两彩一赛，其或未然。\n竹根稚子无人见，沙上凫雏傍母眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三十三","author":"释如净","text":"金刚宝剑入红炉，煅出杨岐三脚驴。\n到处沙场鏖死战，髑髅交衮血模糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三十二","author":"释如净","text":"船无底，米无粒，积岳堆山，洪波直入。\n恁么归来得自由，清凉门下尽点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三十一","author":"释如净","text":"活刬群牛脑后毛，风吹日炙转腥臊。\n不堪狼藉薰天地，罪恶重将业火烧。\n切忌死灰寻舍利，臭烟蓬㶿燄头高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三十","author":"释如净","text":"大地平沈，侧布黄金。\n虚空透阔，高架栴檀。\n依稀马厩，彷佛牛栏。\n鹘眼鹰睛不许看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十九","author":"释如净","text":"一滴不息，两滴三滴。\n滴滴沥沥，连朝至夕。\n变作滂沱勿奈何，山河大地衮风波。\n总不出衲僧喷嚏一激，直得云开日出。\n朗朗晴空吞八极，若还依旧水漉漉，浑家飘堕罗刹国。\n稽首释迦，南无弥勒。\n能救世间苦，观音妙智力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十八","author":"释如净","text":"瞿昙打失眼睛时，雪里梅花只一枝。\n而今到处成荆棘，却笑春风缭乱吹。\n诸方说禅，清凉念诗。\n烧香点烛拜泥团，脑后辽天鹞子飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十七","author":"释如净","text":"天地一指，万物一马。\n二由一有，一亦放下。\n然后向者里拈起，谓之衲僧火柴头。\n大海波心轻?动，须弥顶上汗通流。\n今朝以此开炉，无宾主话勘破赵州。\n拟归暖处，箭过髑髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十六","author":"释如净","text":"昨日一线短，今朝一线长。\n针眼里过，尺寸上量。\n短长蓦劄断，巧绣出鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十五","author":"释如净","text":"清凉大火聚，炎炎没回互。\n衲僧赤骨律，通身是剑树。\n在里许相挨厮拶，在里许放行把住。\n放行把住逞风流，总是冤家笑点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十四","author":"释如净","text":"当堂不露，主人翁元是旧时。\n借影全彰，第一座屈烦今日。\n雪夜金乌历堂，炎天玉兔转怀。\n妙叶儿孙，全该祖父。\n木人执板云中拍，石女含笙水底吸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十三","author":"释如净","text":"云散秋空，即心见月。\n家家门前照明月，处处行人共明月。\n骑鲸捉月，撑船载月。\n忽然月落夜沈沈，笑杀胡僧齿门缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十二","author":"释如净","text":"白圭无玷，顽石点头。\n转关一拶，佛祖仇雠。\n咦，咬猪狗汉转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十一","author":"释如净","text":"龙生龙，凤生凤，指天指地独称尊，老鼠养儿巡屋栋。\n共将恶水蓦头浇，万两黄金也合消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二十","author":"释如净","text":"瞿昙夜半翻筋斗，万像平沈大地空。\n赢得波旬拍手笑，灯笼露柱暗搥胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十九","author":"释如净","text":"无面目汉，面目全该。\n日烘杨柳眼，烟抹杏花腮。\n黄莺啼不尽，特地下枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十八","author":"释如净","text":"髑髅前，脑盖后，一点洞明光影里走。\n咄，然灯古佛转誵讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十七","author":"释如净","text":"今朝正月初一，一举上上大吉。\n吉无不利，春风和气。\n散入花梢百草头，尘尘刹刹转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十六","author":"释如净","text":"六年落草野狐精，跳出浑身是葛藤。\n打失眼睛无觅处，诳人刚道悟明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十五","author":"释如净","text":"一叶落，空索索。\n天下秋，乾剥剥。\n霹雳一声，滂沱大霔，笑看乌藤倒上树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十四","author":"释如净","text":"云开山岳露，雨过色新鲜。\n翟昙不出世，败阙未生前。\n天上天下，贼是小人。\n三拜起来浇恶水，谩将掩彩当慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十三","author":"释如净","text":"三分光阴二早过，迟日江山丽。\n灵台一点不揩磨，春风花草香。\n贪生逐日区区去，泥融飞燕子。\n唤不回头争奈何，沙暖睡鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十二","author":"释如净","text":"春风轻，春日晴。\n柳眼青，黄莺鸣。\n郁郁葱葱生瑞气，世上老人天上星。\n释迦赞叹，弥勒證明，蟠桃仙果笑中呈。\n林下衲僧将何酬献，手中千古一枝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十一","author":"释如净","text":"梅花清晓香，烂熳而借功。\n柳线早春浓，日暄而转位。\n非那边去，从者里来。\n哆哆和和兮主宾妙叶，跛跛挈挈兮偏正全该。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其十","author":"释如净","text":"过去然灯佛，相牵弄业识。\n现在漏灯盏，光影瞒人眼。\n未来乾纸撚，贼赃无处典。\n咄，髑髅前点破，鼻孔里看见。\n衲僧门下黑漫漫，历劫不分通一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其九","author":"释如净","text":"拔断毒蛇尾巴，穿住黑牛鼻孔。\n虚空背上牵来，大地六番震动。\n甚恶毒兮甚仇雠，屎尿腥臊汗血流。\n拟将眼觑无踪迹，个是清凉第一头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其八","author":"释如净","text":"一举首登龙虎榜，太平亲到凤凰池。\n全生全杀超言象，更透机先向上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其七","author":"释如净","text":"露柱怀胎，忽然爆裂。\n突出无孔铁槌，历劫都卢败缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其四","author":"释如净","text":"笔头秃尽一毫通，至治寥寥静极中。\n点起风云传号令，雷霆泼墨振纲宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其三","author":"释如净","text":"抉出达磨眼睛，作泥弹子打人。\n海枯彻过底，波浪拍天高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其二","author":"释如净","text":"开殿见佛，眼中毒刺。\n咄，拔却刺。\n礼拜烧香，颠倒钝置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释如净","text":"大病现前，乾坤一默。\n老而不死，是谓之贼。\n贼贼，春风啼鸟花狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普化赞","author":"释如净","text":"者汉走从何处来，鼓合临济白拈贼。\n铎声摇撼动风雷，至今大地俱狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"源山主求赞顶相","author":"释如净","text":"个是净慈毛和尚，口言祸福有定当。\n逐日随缘去赴斋，是谓两脚功德藏。\n彫装千佛，布砌两廊。\n判断一切魍魉鬼，主管五百罗汉堂。\n至于修桥造路，与夫浴主街坊。\n闻一切善事如蝇见血，闻一切恶事似蟹落汤。\n有时随搂搜，若万回老子欢喜。\n有时放歇蹶，若布袋和尚颠狂。\n得一文钱不曾落地，合十爪掌常乃谢天。\n只一味朴直，无些子壒尘。\n所以打动好事檀那，画出这般面觜。\n且道如何比拟，八月十五中夜凉，一轮月照西湖水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞世颂","author":"释如净","text":"六十六年，罪犯弥天。\n打毬?跳，活陷黄泉。\n咦，从来生死不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠僧","author":"释如净","text":"喝声霹雳震晴空，白棒飞星化活龙。\n不入这般儿女队，乱花翻袖舞春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济赞","author":"释如净","text":"捏个空拳，嚇杀天下。\n这般祖师，畜生驴马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其五","author":"释如净","text":"有问有答，屎尿狼藉。\n无问无答，雷霆霹雳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其四","author":"释如净","text":"炉炭为床，镬汤为座。\n口吐黑烟，弥天罪过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其十","author":"释如净","text":"元正启祚，万物咸新。\n伏惟大众，梅开早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其二","author":"释如净","text":"饥来吃饭，困来打眠。\n炉鞴亘天，倒退三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其五","author":"释如净","text":"净慈法座，木头一棚。\n横撑竖撑，黑漆光生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其六","author":"释如净","text":"大地平沈，此座高广。\n千变万化，无功受赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十四首 其五","author":"释如净","text":"瞿昙顶骨，夫子眼睛。\n两彩一赛，玉振金声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听松风布袋赞 其二","author":"释如净","text":"靠个布袋瞌睡，平地突出毒刺。\n有人一踼踼翻，天下脚跟出气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其九","author":"释如净","text":"跳出净慈牛栏，撞入太白马厩。\n一团罪业黑漫漫，风吹日炙薰天臭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其三","author":"释如净","text":"坐断维摩方丈，发露阎罗地狱。\n千古万古黑漫漫，剑树刀山转辘辘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十六首 其一","author":"释如净","text":"灵灵而时时昧，不得月随流水。\n历历而处处混，不得雨逐行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释如珏","text":"诸佛出身处，千般谩度量。\n东山行水上，眨眼过扶桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧问","author":"释如珏","text":"如何是佛烂冬瓜，咬著冰霜透齿牙。\n根蒂虽然无窖子，一年一度一开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"继天童颖禅师席后上堂说偈","author":"释如珏","text":"新岁新击鼓，普施新法雨。\n万物尽从新，一一就规矩。\n普贤大士忻欢，乘时打门户。\n放出白象王，遍地无寻处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释如胜","text":"人人领略释迦，个个平欺达磨。\n及乎问著宗纲，束手尽云放过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]