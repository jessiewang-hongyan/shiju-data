[{"title":"次韵君俞四首 其二","author":"李之仪","text":"合浦圆光降下胎，豫章千尺本天材。\n未能海运参抟翼，聊复舟行共覆杯。\n白发情怀虽草莽，青春消息自条枚。\n何妨接武穷幽致，莫待风光却见催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞四首 其三","author":"李之仪","text":"语解惊人固有神，始知无不是虚名。\n方观去接天边翼，何事犹谐爨下声。\n齐晋近能通歃血，江黄讵敢议鏖兵。\n老来肺腑都荆棘，顿欲薅锄不计程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞四首 其四","author":"李之仪","text":"熊掌如何得豹胎，弃常嗜异信难材。\n端能不学邯郸步，正可同尝沆瀣杯。\n有意良图休我老，他年吉卜伫君枚。\n云间日下容相契，且置燃萁特地催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"堤上閒步二首 其一","author":"李之仪","text":"风旌江木信漂浮，散策腾腾亦谬悠。\n未必萦回能擢胜，却疑平远解供愁。\n年衰易感难留日，机尽应无不下鸥。\n渡口舟横晚潮急，一番佳意忆苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"堤上閒步二首 其二","author":"李之仪","text":"暖风轻蹙浪花浮，留滞江城愧谢悠。\n吟苦空多屈原恨，赋残犹剩庾郎愁。\n渐因卜筑投归鹭，聊托潺湲习戏鸥。\n可笑粗官杀风景，满船丝管载凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韦深道寄傲轩","author":"李之仪","text":"南窗何似北窗凉，寄傲来风各有方。\n千古光辉如昨日，一时收拾付新堂。\n已惊盏里醅初绿，更觉篱边菊渐黄。\n就使主人官即显，此门高兴定难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞兼简少孙六首 其一","author":"李之仪","text":"连璧兼金尽出伦，雪髯霜鬓信陈人。\n能忘枘凿方圆异，许接风云变化新。\n绝韵淹时劳极目，虚斋穷日但凝尘。\n何当一笑披环堵，赖月吟哦未厌贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞兼简少孙六首 其二","author":"李之仪","text":"残编弊藁掩还开，好意经年不暂来。\n伏枥已应真款段，脱鞲终拟谢低回。\n颇传共坐侵斜月，更想微吟荐罚杯。\n居士从来少风味，独将愁眼望初梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞兼简少孙六首 其三","author":"李之仪","text":"莫羡财多石季伦，任从闾里笑长人。\n五湖浪迹名终在，六印悬腰眼暂新。\n且乐歌呼随沥斝，不妨文字洗留尘。\n年来顿觉珠玑富，万户侯家却是贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞兼简少孙六首 其四","author":"李之仪","text":"愔愔怀抱不曾开，忽忽还添一岁来。\n灯火香花随赞祝，儿孙幡胜共徘徊。\n休誇路寝当前拜，谁得屠苏最后杯。\n何物相期同一醉，为君催发槛前梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞兼简少孙六首 其五","author":"李之仪","text":"定应春到今日几，但觉耳边多醉人。\n已分馀生不如旧，却应佳句渐能新。\n悲来徒有萦心泪，情尽空惊满眼尘。\n到得锥无真我辈，一箪犹是作家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞兼简少孙六首 其六","author":"李之仪","text":"书空懒作咄咄语，催老祗怪骎骎来。\n断梦已将愁共远，离魂不觉泪惊回。\n病馀想见崭岩玉，欢处犹怀宛转杯。\n能伴晴和着屐否，深山应有未凋梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观东坡集","author":"李之仪","text":"今朝又读东坡集，记得原州鞫狱时。\n千首高吟赓欲遍，几多强韵押无遗。\n固知才气原非敌，独有心期老不欺。\n泪尽九原无路见，冰霜他日看青枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵奉送禹钦且坚再来之约 其一","author":"李之仪","text":"涔涔梅雨涨江滨，耿耿僧房借钵人。\n秀色惊回随念到，孤怀赢得暂时新。\n何妨一笑空诸有，更觉三摩净六尘。\n忧患年来倍伤感，送君衰泪不容贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵奉送禹钦且坚再来之约 其二","author":"李之仪","text":"相逢怀抱各全开，蔚结才舒倏又来。\n倾倒已辜将进酒，追随休赋上林回。\n临分莫作楚愁叹，故事须询河朔杯。\n看取滁翁宜自警，空将遗恨感苏梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袭前韵再简少孙四首 其一","author":"李之仪","text":"由来气类即天伦，孰谓刘琨独可人。\n稍隔相从更无味，几因拈起又还新。\n席间谁致龙皮异，雪里常怀鹤羽尘。\n祗欲期君拾瑶草，庾郎三韭未为贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袭前韵再简少孙四首 其二","author":"李之仪","text":"雪意埋云蔚不开，新春还傍故春来。\n未堪肮脏倚门立，聊复差池接羽回。\n得丧但知求失马，盛衰赢取付传杯。\n风流二妙天怜我，种玉秧中更插梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袭前韵再简少孙四首 其三","author":"李之仪","text":"子默清真本绝伦，羊昙仍是个中人。\n林泉不作南风竞，旗帜还因对垒新。\n金矿跃垆元有艳，冰壶瑩月旧无尘。\n何妨再葺昆阳战，寻邑师行固不贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袭前韵再简少孙四首 其四","author":"李之仪","text":"记得金樽特地开，举头新岁又重来。\n银潢已分经年隔，玉节犹期旧腊回。\n千汲浪迷云表梦，百分愁寄烛残杯。\n醉乡谁谓无消息，已觉歌声傍落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵雪","author":"李之仪","text":"腊日频年未尝雪，今春雪与腊俱来。\n暖归白傅金蕉叶，寒逼温郎玉镜台。\n几处欢声动丝竹，一番佳思近离堆。\n新诗不以寻梅见，万里丰登气已回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张约之长春阁","author":"李之仪","text":"江山信美亦人同，寒暑随时兴易穷。\n寓意果能超物境，养花长欲占春风。\n何须户外屦常满，自乐尊中酒不空。\n可笑道人犹有恨，一番红尽一番红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后圃","author":"李之仪","text":"鹁鸠呼妇天欲雨，杏子退花莺未雏。\n庭前已觉绿半毯，酒面忽有红双凫。\n芳物恋客不忍去，主人好贤谁复如。\n会应百岁享此乐，何妨画作重屏图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题子椿野轩","author":"李之仪","text":"江山秀气表吾人，辇下开轩得趣新。\n不拟旧游离几席，常令每况隔埃尘。\n客来谈笑无非楚，纸上文章近过秦。\n分我一枝频见约，乘槎行欲问通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避暑无地偶过君俞聊资华屋广荫以揖主人之胜绸缪礼意遂至抵暮君俞有诗因次韵二首 其一","author":"李之仪","text":"无功卫鹤偶乘轩，虐暑从谁解倒悬。\n顿觉御风凌绝境，似逢调瑟认华年。\n回光已幸参东壁，裂地何须得酒泉。\n自惜抑扬非瓦砾，倦途终愧失陶甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避暑无地偶过君俞聊资华屋广荫以揖主人之胜绸缪礼意遂至抵暮君俞有诗因次韵二首 其二","author":"李之仪","text":"十轮杨恽旧轩轩，四壁相如似磬悬。\n岂谓投怀忘晚节，每容佳处共流年。\n笑谈璀璨风生坐，翰墨纵横思涌泉。\n土苴固难重就器，转钧尤幸识精甄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归自钱塘伏蒙君俞特枉佳句钦叹不已聊赋来韵","author":"李之仪","text":"吴山陈迹已飞埃，投老还惊病眼开。\n似泛灵槎海边去，却因华表鹤归来。\n情移客枕收残梦，恨着江梅恋故台。\n便觉新篇资六翮，飘飘真是子虚才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠金陵荣天和","author":"李之仪","text":"生涯已定不干时，收拾工夫且作诗。\n濑水方来吊东野，同安初喜识丘迟。\n兼将佛事资三昧，又喜风骚出一枝。\n投老相逢能几许，何堪得句每相期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘君以地里之学各邂逅相遇求诗为别因赋长句","author":"李之仪","text":"久闻秘术独超群，肯向青囊学景纯。\n解使山川如在掌，须知祸福不由人。\n论功合附天仙籍，底事犹随客路尘。\n满眼峰峦应有待，何妨裁剪出精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯镇客居伤春佳句辄赋元韵二首 其一","author":"李之仪","text":"休论莫莫与休休，老眼逢春且暂留。\n未必馀寒更能久，祇因残蕊易为揉。\n及时行乐何妨剩，感物兴怀漫自愁。\n南北生涯等羁旅，定应无着是清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯镇客居伤春佳句辄赋元韵二首 其二","author":"李之仪","text":"纷纷到底不如休，空把閒心见便留。\n昨日白消行处去，今朝绿遍定谁揉。\n且从寂灭翻千偈，安用深湛咏四愁。\n我坐言多欲无语，每惭佳思枉诗流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵夹竹桃花","author":"李之仪","text":"料理愁怀落那边，桃花烘日竹含烟。\n墙红密约连昌晓，夏木深藏绣岭天。\n篮舆造门如会面，渔舟失路想当年。\n因君咏出黄筌笔，从此风光生彩笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻笛","author":"李之仪","text":"涓涓水咽众山泉，隐隐雷惊二月天。\n共喜春工能应候，方知节物似烹鲜。\n倦途所欠无多子，胜日相逢又一年。\n好是群花应竞发，不须留待柳三眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郭功甫赠陈待制致仕二首 其一","author":"李之仪","text":"十年朝马望前程，晚作琳宫物外人。\n彻骨清风真有韵，醉心常德本来淳。\n新栽松菊开三径，旧检方书备六陈。\n不是诗翁形美颂，丹青难写自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郭功甫赠陈待制致仕二首 其二","author":"李之仪","text":"南北纷纷不觉尘，鸳鸯湖水解留人。\n乳浮香焙谁同试，蚁泛家篘分外淳。\n禅寂久因师粲可，婚姻便可继朱陈。\n莫从旧路寻归梦，占取东篱采菊身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人三首 其一","author":"李之仪","text":"昂昂野鹤固难群，皎皎冰壶不受尘。\n一笑每逢青眼旧，多情空愧白头新。\n西风未用高纨扇，东道应容岸角巾。\n珍重长谣倚云瑟，潇湘谁是赏音人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人三首 其二","author":"李之仪","text":"经年牢落别离群，准拟归来拂路尘。\n妙语独从书上得，欢悰犹欠坐中新。\n颇闻洛下传佳句，更喜嵩阳识垫巾。\n几欲军门示巾帼，老来犹更不如人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人三首 其三","author":"李之仪","text":"荆溪风物记当时，吹絮河豚下箸迟。\n绿满金田朝应供，红残朱槛夜论诗。\n幅巾已托遗民后，杓柄犹怀象骨疑。\n早晚云间见金臂，空悬翠竹漫抽枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵采莲","author":"李之仪","text":"闻道栽成十亩莲，便思挑出杖头钱。\n定知荇菜参差处，不是决明颜色鲜。\n红日半移芳草岸，清歌低泛木兰船。\n惊心未得同真赏，空愧诸豪白玉篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复次韵 其一","author":"李之仪","text":"国西华丽占池莲，曾记开樽奉赐钱。\n几欲漂流劳滞念，又惊红绿映澄鲜。\n主人无间容联步，胜日何妨更买船。\n满挹香风振归袂，更烦佳思出新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复次韵 其二","author":"李之仪","text":"幕府风流旧泛莲，裔孙家世掩青钱。\n别开眼界霞争烂，分得秋光菊未鲜。\n灯阵有心欺醉帽，珠盘何日泻归船。\n锦囊示我锵金句，空愧巴吟缀后篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子椿庄居述怀","author":"李之仪","text":"偶因秋蕊记初春，增损元无尔自贫。\n病骨萧条惊岁晚，新诗来往愧情亲。\n未应谢傅终垂涕，谁为刘公是可人。\n艾火呻吟对摇落，不堪庭草又还新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵早秋","author":"李之仪","text":"冲冲时序一邮亭，睡美从今气不蒸。\n便好心期金叶酒，乍惊梦在玉壶冰。\n栽松种竹来三径，效策输龟待十朋。\n百尺楼高谁与共，倦途初喜接陈登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同子椿游三品石诗井寻三阁故基久之因以次韵","author":"李之仪","text":"桑柘丘墟辇路长，景阳依旧在山阳。\n石标官品名常在，井记胭脂迹半荒。\n吊古漫劳兴感慨，寄怀聊以共彷徉。\n相看等是未推枕，何日同惊梦后粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪曾延之泛舟历湖至苦竹寺次韵陈致君席上所赋","author":"李之仪","text":"已凉时节未霜前，十里平湖共酒船。\n岩岫涌寒清澈水，芰荷翻浪绿连天。\n百年过眼真聊尔，一笑投怀岂适然。\n独有黄花似回避，定缘红粉不能先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿大乘赠祖灯","author":"李之仪","text":"倦游知止未知还，平日生涯只在山。\n金碧喜逢云外境，文章重见管中斑。\n篆烟萦晓留无寐，宝铎吟风笑不閒。\n他日归栖虽有地，胜游终寄梦魂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏心亭","author":"李之仪","text":"赏心亭角倚栏杆，虎住龙蹲自屈蟠。\n无复埋金销胜气，空馀飞鹭识前滩。\n百年名在人何处，万里潮平雨送寒。\n几向后庭更白纻，不堪残照下鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延之云累日把酒止在相近处殊不快人意坐间命遍索城内外可以延处之地将往因之得城南张氏园秋花斑駮可喜遂剧饮待月上戴花作乐而归市犹未彻观者如堵次致君韵","author":"李之仪","text":"累日相看似处阴，今朝乘兴共追寻。\n曲栏方沼争留步，秀色新啼总会心。\n酒面屡从罗绮发，花心休被雪霜侵。\n烛城醉路凌初月，但觉人山一径深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书二首 其一","author":"李之仪","text":"闭门只欲浑无事，门外何尝有事来。\n生计不须忧水旱，仕途休更问梯媒。\n身安种种皆三乐，客到时时共一杯。\n此外华岩是归处，眼前楼阁竟谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书二首 其二","author":"李之仪","text":"小山相对数椽地，乐与心期境自多。\n有酒未妨同客醉，无情到了任君魔。\n采薇行歌亦劳矣，饮水曲肱还会么。\n只恐时来把不住，更看究竟事如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠人","author":"李之仪","text":"落得清閒与物疏，扃门终日似山居。\n案头新有归田赋，架上元留纬世书。\n紫府未须穷秘简，丹山重见引名雏。\n诏恩咫尺来相继，还许频为贺客无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和两翁轩","author":"李之仪","text":"何处又传金椀出，几人争看玉山颓。\n幽情不是风期旧，异境难从指顾开。\n猿鹤已回尘外驾，烟云休造眼中衰。\n未妨一老同巾履，香火终年谢劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵圭首座","author":"李之仪","text":"阴重炉红欲雪天，氤氲香篆不藏烟。\n南游步步如同历，西竺层层有旧缘。\n未觉鸦声惊户外，似传梅信到窗前。\n老来酒量无消息，负此佳时一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和锦绣亭","author":"李之仪","text":"漂泊生涯寄一萍，胜游长记锦花亭。\n山来已讶天能巧，春到方知地更灵。\n虽许登临追曳尾，却应颜色未忘形。\n何妨共保千年约，白帽回头笑管宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴思道相送同宿崇因二首 其一","author":"李之仪","text":"端门风月十年抛，垂老山林寄一瓢。\n可得故人来市脚，共寻陈迹到江郊。\n麦黄且置尘中累，眉白欣投世外交。\n只恐话长清夜短，明朝去路不相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴思道相送同宿崇因二首 其二","author":"李之仪","text":"形单影只久相抛，鼎食端能胜饮瓢。\n已分馀材辜北阙，元非不雨自西郊。\n求田聊复同中隐，玩世宁嫌渎下交。\n千古平泉有遗恨，漫劳精爽畏文饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄僧","author":"李之仪","text":"得皮得髓漫多门，实际圆融理自存。\n谕意当时才一笑，还卿千日见三孙。\n维持佛法元无事，建立家山尽有文。\n占断乾坤今鼎足，会多哮吼慰传闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题吴思道横翠堂","author":"李之仪","text":"红尘扰扰功名地，不碍诗人得趣幽。\n何必千岩连万壑，能令六月似三秋。\n茶瓯变乳随汤泛，香篆萦云尽日浮。\n时觉东城添纸价，应知得句胜封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简刘君秉","author":"李之仪","text":"刘郎本是风尘外，画舸新从越上来。\n闻说露芽如爪活，更多溪楮截肪开。\n雪消鼎面声频涌，鹅转池心首屡回。\n洗涤睡魔临二景，敢辞瓦砾换琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十一日九月六日二十四日三梦过赵仲强家坐中人物笑语一一如平时因寄长句庶蒙藻思见酬因投一会面之慰也","author":"李之仪","text":"忆陪金盏醉红颜，回首风光杳霭间。\n老去未忘三级浪，近来频梦八重关。\n云烟旧路到何日，灯火虚堂真似山。\n只恐断魂收不得，更须佳句与招还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水中登王德循月阁","author":"李之仪","text":"龙宫海藏固闻誇，偶袭初凉泛客槎。\n层槛迥高临落日，洞房无数尽浮家。\n闾阎可想知何在，天水相连杳莫涯。\n借我华严记残帙，欲将因地付袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德循诗律甚佳方幸拭目因作拙句以勉之","author":"李之仪","text":"唐人好诗乃风俗，语出工夫各一家。\n前辈相因多自任，后来无复更相誇。\n半山老子偏游戏，真一仙人每叹嗟。\n傍出豫章登一格，凭君细与辨龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]