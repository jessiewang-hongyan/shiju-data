[{"title":"赋王立之承奉园亭 载酒堂","author":"释道潜","text":"子云草玄时，载酒客常满。\n君今慕若人，竹户谁来款。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 漱醉亭","author":"释道潜","text":"潭潭百尺井，汲引鸣飞澜。\n惊回午醉客，一漱齿颊寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 介庵","author":"释道潜","text":"一庵容宇宙，介意安在哉。\n珍重庵中人，空洞无纤埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 顿有亭","author":"释道潜","text":"君家十亭观，棋置宛相望。\n是中富墨妙，伟哉苏与黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 亦爱亭","author":"释道潜","text":"扶疏荫佳木，五月风来徐。\n渊明方偃卧，亦自爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 永日亭","author":"释道潜","text":"长安贵富人，岁月马上迁。\n岸巾怡永日，心事独翛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 求定斋","author":"释道潜","text":"南华鉴止水，炯然见须眉。\n夫子果能定，物岂逃妍媸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 泠然斋","author":"释道潜","text":"虚室昼生白，清风袭衣屦。\n圆蒲燕坐人，泠然欲仙去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋王立之承奉园亭 赋归堂","author":"释道潜","text":"王郎英妙年，功名固堪勉。\n浩然赋归欤，持操真可羡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送慈义称师游嵩少","author":"释道潜","text":"道人家住锦溪头，衣裓常含爽气浮。\n偶踏尘埃经北阙，却寻云水过西州。\n冰销阴壑兰芽动，柳岸长条春意柔。\n少室峰前无异路，莫将陈迹苦追求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其一","author":"释道潜","text":"造物周千载，真材得豫章。\n经纶等伊吕，辞学过班杨。\n德厚倾蛮貊，名高震虏羌。\n数奇终不偶，难与问苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其二","author":"释道潜","text":"博学无前古，雄文冠两京。\n笔头千字落，词力九河倾。\n雅量同安石，高才类孔明。\n平生勋业志，郁郁閟佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其三","author":"释道潜","text":"少年持国论，不羡洛阳人。\n抗疏忘机骫，危言骇搢绅。\n丹衷那有谓，康济在斯民。\n竟谪江湖去，端居寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其四","author":"释道潜","text":"初复中原日，人争拜马蹄。\n梅花辞庾岭，甘溜酌曹溪。\n梁木倾何速，椿年竟不齐。\n灵輀向崧洛，行路亦悽悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其五","author":"释道潜","text":"一时英俊附门墉，兄弟从来号两龙。\n雄辩未饶端木赐，题评肯下郭林宗。\n精神烱烱风前鹤，操节棱棱雪后松。\n无复胜游参杖屦，追云弄月更雍容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其六","author":"释道潜","text":"群惊投老窜炎荒，瘴雨蛮烟岂易当。\n焘气内全真自葆，铁心无动亦何妨。\n海山出处凭谁共，蜑叟追随乐未央。\n准易著书人不见，微言分付有诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其七","author":"释道潜","text":"羽扇纶巾拥帅权，高才大纛拂云烟。\n初闻父老诵嘉语，绰有风流似昔贤。\n谪籍数年居瘴海，功名无分勒燕然。\n空馀雪浪斋中石，留与邦人万古传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其八","author":"释道潜","text":"当年吴会友名缁，尽是人天大导师。\n拔俗高标元自悟，妙明真觉本何疑。\n篮舆行处依然在，莲社风流固已衰。\n它日西湖吊陈迹，断桥堤柳不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其九","author":"释道潜","text":"德政从来主意宽，奋髯时怒岂容奸。\n傥逢大事能谈笑，未必风流劣谢安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其十","author":"释道潜","text":"峨冠正笏立谈丛，凛凛群惊国士风。\n却戴葛巾从杖屦，直将和气接儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其十一","author":"释道潜","text":"大河当日决澶渊，横被东徐正渺漫。\n城上结庐亲指顾，敢将忠义折狂澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其十二","author":"释道潜","text":"文登五日召公归，海市奇观与愿违。\n已蛰鱼龙能再起，人间异事古来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其十三","author":"释道潜","text":"西湖卷葑拓漪涟，十里横吞碧玉天。\n自谓前身真白傅，至今陈迹尚依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其十四","author":"释道潜","text":"临淮大士本无私，应物长于险处施。\n亲护舟航渡南海，知公盛德未全衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东坡先生挽词 其十五","author":"释道潜","text":"画图虽不上凌烟，道德芬芳满世间。\n辽鹤已归东海去，列仙风骨若为攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孔子韶方平与其侄处度相访于香山作此诗以赠之","author":"释道潜","text":"洙泗芬芳远，高材尚可求。\n二难俱韵胜，小阮更风流。\n语款时容接，诗豪未易酬。\n平生喜人物，邂逅此相投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孔平子书閤所藏石菖蒲","author":"释道潜","text":"寒溪之滨，沙石之窦。\n产此灵苗，蔚然而秀。\n有美君子，采持而归。\n文石相并，滀涵清漪。\n根盘九节，霜雪不槁。\n置之幽斋，永以为好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送处度赴试","author":"释道潜","text":"异哉曲阜几世孙，白玉受性良且温。\n诗书礼义祖家学，扰扰自馀何足论。\n良辰往往专吟讽，远压曹刘攀屈宋。\n肯与齐梁作后尘，秋月春花恣嘲弄。\n我方杖策过西州，指点云山结胜游。\n已有诏书催去兴，岂宜泉石更淹留。\n征车晓送登长陌，月没参横河汉白。\n期君安稳上龙门，不怕临流遭点额。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其一","author":"释道潜","text":"万事年来即罢休，心萦云水尚追求。\n草堂早晚投君宿，纸帐蒲团不用收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其二","author":"释道潜","text":"菊丛稍稍敷金蕊，荞麦芃芃放雪花。\n榆柳缭墙苍霭密，谁知中有隐人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其三","author":"释道潜","text":"白头幕府尚崎岖，南亩归休盍早图。\n滍上山川要佳句，安排风月待相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其四","author":"释道潜","text":"舍南舍北尽云山，此处躬耕有底难。\n社饮鸡豚好邻里，一杯相属百忧宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其五","author":"释道潜","text":"马蹄逐逐走埃尘，官府宁容自在身。\n夜宿南溪孔居士，青灯相对话悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其六","author":"释道潜","text":"爱君檐外萧萧竹，翠干扶疏一样齐。\n莫道此君无俯仰，惊风坠雪亦须低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其七","author":"释道潜","text":"端居终日少逢迎，佳客时来一座倾。\n不见诸郎事弦管，幽窗唯有读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其八","author":"释道潜","text":"肝胆未应分楚越，高曾元共水云乡。\n爱君善作离骚语，清警殊非俗肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其九","author":"释道潜","text":"仲尼道德高千古，老子微言冠百家。\n馀泽风流俱擅美，那云玉树倚兼葭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李端叔题孔方平书斋壁 其十","author":"释道潜","text":"吾党从来迹易亲，只缘同是个中人。\n滍川鱼鸟浑相识，来往沙头肯厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行歌亭 其一","author":"释道潜","text":"自古山林浪得名，欲要人爵谩逃形。\n唯馀滍上行歌者，独免移文勒户庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行歌亭 其二","author":"释道潜","text":"先生本自负经纶，志在丘园世莫亲。\n不信请看门下客，尽为金马玉堂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行歌亭 其三","author":"释道潜","text":"尝闻箕颍卧巢由，振荡高风冠九州。\n欲识当年孔宁极，依稀堪与若人俦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行歌亭 其四","author":"释道潜","text":"滍川胜气蔼葱葱，远访先生旧隐风。\n阅礼敦诗见犹子，故知馀泽未终穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孔处度李荣期同游汝阳城西等慈寺溪堂","author":"释道潜","text":"汝阳介崧洛，郡邑古且幽。\n出郭才数里，招提据清流。\n千章郁古木，中有百尺楼。\n循梯到朱栏，眼接万象游。\n二豪俱才华，笔力胜九牛。\n佳辰同览眺，高怀肯悲秋。\n轩渠发笑语，辽乱惊凫鸥。\n平生读书要，取用不假钩。\n想当援毫初，应手如见投。\n挹子明月光，泠然洗吾眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方平见寄","author":"释道潜","text":"黄花弄色近重阳，山果红梨迥得霜。\n节物撩人兴不浅，交情如子味何长。\n终期雾豹栖岩穴，且作宾鸿寄野塘。\n它日西湖能过我，胡麻供饭煮芹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题南阳刘氏松堂","author":"释道潜","text":"南阳自古誇雄都，山川淑气无时无。\n中间豪杰相间出，卧龙光武兴王图。\n有唐昌黎百世士，布衣奋起为师儒。\n风流异代骨虽朽，馀泽尚可濡焦枯。\n刘郎先子挺奇质，志业文史称乡闾。\n词场较蓺一不售，掉头便卜溪山居。\n朋云友月终岁事，挟册教子犹区区。\n青松寸根手自植，气概今已凌凡株。\n虬髯龙甲拂天籁，飒若风雨来江湖。\n悲哉孝思论罔极，新构永与甘棠俱。\n西州骚人竞与赋，盛事相诧无贤愚。\n续貂自昔人所诮，诗成出袖增踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同韩子苍游黄山观约高寿朋张公硕不至","author":"释道潜","text":"驼裘跃马去翩翩，一舍逡巡箭脱弦。\n仙事未须穷传记，胜游聊为好山川。\n穿林络石惊寒浏，缭白萦青对篆烟。\n惆怅能文二三子，操觚安得共周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子苍见和二篇再用前韵酬之","author":"释道潜","text":"涉世伊余实强颜，伤弓困翼尚惊弦。\n论文已失李太白，采药行寻葛稚川。\n请置黄公新石研，归磨潘子古松烟。\n幽窗写就经纶志，它日风云去斡旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王潜翁题王孝孙所藏摩诘听松图","author":"释道潜","text":"辋川奇处固难评，眼里瞳人要自明。\n落落信为霜后操，萧萧那虑世间声。\n忘言我已输三士，妙曲渠宁羡九成。\n此去黄尘沙漠底，时时开匣睹余清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游叶城韩氏东园","author":"释道潜","text":"曾台累榭蔚相望，古木连云出缭墙。\n可但陶朱能计略，须知猗顿亦材良。\n松风菊露滋清夜，楚舞吴歌奉宴觞。\n好在诸郎俱挟册，起家儒术未应忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过张公硕廷直息轩","author":"释道潜","text":"涪翁六蓺学，力可当万人。\n施州亦英特，文武备一身。\n风味真颉颃，宛然喜相亲。\n诗坛尝屡战，妙誉倾缙绅。\n涪翁往播迁，风义颇凋沦。\n施州奋不顾，伏腊赒且勤。\n霜雪槁群木，凛然见松筠。\n施州归夜台，遗编照青春。\n嗟我独不识，览卷徒悲辛。\n有子绍门户，飘飘气方振。\n能文得父风，作语殊不陈。\n流源日疏凿，岂易量涯津。\n结庐依通衢，隔墙闹蹄轮。\n颓然小轩上，息偃全天真。\n男儿功名志，蠖屈终一申。\n谁能效急急，俛仰车马尘。\n涪翁为子名，高意庶可循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静舍与蔡秀如承事会话","author":"释道潜","text":"浮云无根蒂，合散不可拘。\n忽然随高风，千里各须臾。\n吾生共天壤，出处良亦如。\n忆昔淮水滨，与君倾盖初。\n翘翘两弟昆，文彩照冰壶。\n门阑本世胄，折节胜寒儒。\n扁舟倚高岸，为我饭伊蒲。\n清谈落犀麈，鄙吝惊扫除。\n一别今四载，相忘寄江湖。\n朅来过汝颍，吊旧投生刍。\n夤缘访山水，岁晚倦回车。\n萧萧古寺底，彷佛日已晡。\n闻君户外音，倒屣迎前趋。\n胡为乎来哉，吏牒颇驰驱。\n高材困所役，何似林间樗。\n清寒凛败屋，猛燄焚枯株。\n胡床坐相对，气貌温以舒。\n明朝各异县，那得同蘧庐。\n无烦叹离索，且尽一笑娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠耿纯叔秘校二令侄","author":"释道潜","text":"高门知积庆，堂上有诸郎。\n礼乐非童子，诗书见义方。\n经营羞弱羽，腾踏羡飞黄。\n富贵由勤苦，五车安可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读子苍诗卷 其一","author":"释道潜","text":"蜀国奇男子，能文到古人。\n淳源稽大雅，妙曲和阳春。\n节物惊摇落，僧坊断四邻。\n看君新著述，时与短檠亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读子苍诗卷 其二","author":"释道潜","text":"大册雄文未许窥，百篇先读海陵诗。\n疲驽伏枥空骧首，飞兔流星作么追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠贤上人","author":"释道潜","text":"恒山道人弃妻孥，坏衣祝发从浮图。\n爱缠欲网岂易脱，慧剑划断真须臾。\n飘然云水出乡国，力学生死来东都。\n心猿意马就羁束，肯逐万境争驰驱。\n回看旧事真一梦，清渭浊泾良自殊。\n楚山岁晚俄邂逅，雪屋对语依圆蒲。\n劝子南游下吴越，小航短棹寻西湖。\n我家住处湖岸北，如椽翠竹森千株。\n竹间扣扉试访我，定有猿鹤声相呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵高寿朋殿直喜雪 其一","author":"释道潜","text":"俄顷风云变物华，撒盐飞絮斗轻花。\n只应陋巷无贫者，玉户瑶阶共一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵高寿朋殿直喜雪 其二","author":"释道潜","text":"挟风穿箔打窗纱，窗里人看窗外花。\n喷玉流珠君岂羡，从来自是五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书申正己秀才所藏雀竹图后 其一","author":"释道潜","text":"荒园古堑雪溟濛，细竹枯条共一丛。\n寒雀喧饥正无赖，输他孔翠食樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书申正己秀才所藏雀竹图后 其二","author":"释道潜","text":"樊笼得食暂时优，身世经年类楚囚。\n何似东阡与南陌，暖风晴日恣遨游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过韩氏庄登小阁 其一","author":"释道潜","text":"缭墙千堵气雄深，小构亭亭出数寻。\n刈穫一空云水白，阑干注目见遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过韩氏庄登小阁 其二","author":"释道潜","text":"玉秀兰芬好弟昆，时来挟册视田园。\n囷场古木千章合，彷佛秦人避世村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑元规秀才内乐庵","author":"释道潜","text":"内乐名庵谁所择，涧上文人题榜额。\n想见风流庵内人，定匪纷华域中客。\n纡朱怀金何足誇，箪食瓢饮真生涯。\n了无忧患到心境，得失鸡虫良可嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李荣期秀才杞菊轩","author":"释道潜","text":"草木助盘餐，纷纷固多品。\n精英唯竹萌，香软独楮菌。\n杞菊于其间，甘清有馀韵。\n达人忘口体，道德自滋润。\n天随与东坡，风味实相近。\n穷通均一致，了不见喜愠。\n春苗共采撷，秋英配兰纫。\n后先属文词，金声而玉振。\n李子妙穷经，屡遭有司摈。\n奔军未云怯，再举当决阵。\n开轩植杞菊，澹泊守定分。\n回头语世俗，未用诮饥困。\n二豪勉跻攀，孔圣故许进。\n长卿亦何人，区区能慕蔺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄潘仲升秀才","author":"释道潜","text":"汉唐誇汝南，豪杰不胜数。\n山川有灵蓄，郁郁久不吐。\n迩来见潘子，秀色实眉宇。\n是家贤伯仲，学术本邹鲁。\n他时俱特立，肯与哙等伍。\n浪为叶城游，邂逅得晤语。\n异乡逢岁晏，越鸟思南举。\n江湖结后期，细与论今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵方平送李南仲赴试春闱","author":"释道潜","text":"四溟凫雁集天池，十目先看俊翮飞。\n养气有馀吞大敌，穷经无缪识玄微。\n尘埃旧服辞阿緆，雨露新袍授楚衣。\n拜命还家春尚好，桃花流水涨渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]