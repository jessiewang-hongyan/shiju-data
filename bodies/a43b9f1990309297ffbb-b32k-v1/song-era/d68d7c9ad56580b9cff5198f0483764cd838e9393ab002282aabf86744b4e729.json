[{"title":"次韵黄无悔惜梅","author":"陈师道","text":"雪拥寒门鹊不来，江南春信小迟回。\n遥知诗力生春早，一抹江梅趁眼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答邢居实二首 其二","author":"陈师道","text":"秋来为客意何如，千里山河信不疏。\n昔日老人今则少，不妨红叶闭门书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答邢居实二首 其一","author":"陈师道","text":"汉庭用少公何在，不使群飞接羽翰。\n今代贵人须白发，挂冠高处未宜弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答学者四首 其四","author":"陈师道","text":"太阿无前锋不缺，铅刀不堪供一切。\n至柔绕指刚则折，善而藏之光夺月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答学者四首 其三","author":"陈师道","text":"暗中摸索不难知，眼里轮囷却见稀。\n行地径须先八骏，刺天终不羡群飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答学者四首 其二","author":"陈师道","text":"黄尘投老得何郎，准拟明年共我长。\n熏沐不为杯酒污，飞扬未许老夫量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答学者四首 其一","author":"陈师道","text":"津津爽气贯眉目，十五男儿万里身。\n笔下倒倾三峡水，胸中别作一家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖堂","author":"陈师道","text":"莫爱西湖好，涓涓去不回。\n无情是江水，犹解及时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西郊二首 其二","author":"陈师道","text":"攒眉敛目抵风沙，暗度城西十里花。\n历肆侧听长短句，缘溪斜著两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西郊二首 其一","author":"陈师道","text":"红绿相催春事阑，可能无意待人看。\n不因送客那能出，衰病经年一据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何郎中出示黄公草书四首 其四","author":"陈师道","text":"当年阙里与论诗，晚岁河山断梦思。\n妙手不为平世用，高怀犹有故人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何郎中出示黄公草书四首 其三","author":"陈师道","text":"四海声名何水曹，新诗旧德自相高。\n一官早要称三字，二鬓何须著两毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何郎中出示黄公草书四首 其二","author":"陈师道","text":"此诗此字有谁知，画省郎官自倔奇。\n罪大从来身万里，政成今有麦三岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何郎中出示黄公草书四首 其一","author":"陈师道","text":"龙蛇起伏笔无前，江汉渊回语更妍。\n好事元须一赏足，藏家不必万人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"陈师道","text":"老觉山林可避人，正须麋鹿与同群。\n却嫌鸟语犹多事，强管阴晴报客闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟汉宫词三首 其三","author":"陈师道","text":"帐底吹烟香自薰，镜前含笑意生春。\n经年不道君恩薄，却是恩深更误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟汉宫词三首 其二","author":"陈师道","text":"月与秋期特地圆，花随人意作春妍。\n却因姊弟争珠凤，更欲君王意外怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟汉宫词三首 其一","author":"陈师道","text":"叶叶霜林著意红，翩翩行骑语墙东。\n黄金拟买长门赋，未信君恩属画工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟李义山柳枝词五首 其五","author":"陈师道","text":"莫解丁香结，从教长苦辛。\n却因千种恨，别作一家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","comm