[{"title":"生查子 其十二","author":"洪适","text":"子月到盘洲，日影长添线。\n水退露溪痕，风急寒芦战。\n终日倚枯藤，细看浮云变。\n洲畔有圆沙，招尽云边雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其七","author":"洪适","text":"六月到盘洲，水阁盟鸥鹭。\n面面纳清风，不受人间暑。\n彩舫下垂杨，深入荷花去。\n浅笑擘莲蓬，去却中心苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 收灯日次李举之韵","author":"洪适","text":"廉纤小雨来，噤瘆轻寒乍。\n丝竹送迎时，灯火阑珊夜。\n铜壶漏故迟，银烛花频灺。\n怀我独醒人，健笔方飞洒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二","author":"洪适","text":"正月到盘洲，解冻东风至。\n便有浴鸥飞，时见潜鳞起。\n高柳送青来，春在长林里。\n绿萼一枝梅，端是花中瑞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其六","author":"洪适","text":"五月到盘洲，照眼红巾蹙。\n句引石榴裙，一唱仙翁曲。\n藕步进新船，斗楫飞云速。\n此际独醒难，一一金钟覆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一 盘洲曲","author":"洪适","text":"带郭得盘洲，胜处双溪水。\n月榭间风亭，叠嶂横空翠。\n团栾情话时，三径参差是。\n听我一年词，对景休辞醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其十一","author":"洪适","text":"十月到盘洲，小小阳春节。\n晚菊自争妍，谁管人心别。\n木末簇芙蓉，禁得霜如雪。\n心赏四时同，不与痴人说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子","author":"洪适","text":"桃疏蝶惜香，柳困莺惊絮。\n日影过帘旌，多少愁情绪。\n红惨武陵溪，绿暗章台路。\n春色似行人，无意花间住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其十三","author":"洪适","text":"腊月到盘洲，寒重层冰结。\n试去探梅花，休把南枝折。\n顷刻暗同云，不觉红炉热。\n隐隐绿蓑翁，独钓寒江雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其十四","author":"洪适","text":"一岁会盘洲，月月生查子。\n弟劝复兄酬，举案灯花喜。\n曲终人半酣，添酒留罗绮。\n车马不须喧，且听三更未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其九","author":"洪适","text":"八月到盘洲，柳外寒蝉懒。\n一掬木犀花，泛泛玻璃盏。\n蟾桂十分明，远近秋毫见。\n举酒劝嫦娥，长使清光满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一 姚母寿席，以龟游莲叶杯酌酒","author":"洪适","text":"碧涧有神龟，千岁游莲叶。\n七十古来稀，寿母杯频接。\n绣衣牵彩衣，喜庆相重叠。\n龟紫看孙曾，鹤发何须镊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一","author":"洪适","text":"九月到盘洲，华发惊霜叶。\n缓步绕东篱，香蕊金重叠。\n橘绿又橙黄，四老相迎接。\n好处不宜休，莫放清尊歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其四","author":"洪适","text":"三月到盘洲，九曲清波聚。\n修竹荫流觞，秀叶题佳句。\n红紫渐阑珊，恋恋莺花主。\n芍药拥芳蹊，未放春归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二 枕上作","author":"洪适","text":"贪看端木花，难办销金帐。\n庭下舞琼瑶，飞到须眉上。\n衰病不禁寒，对景频惆怅。\n梦寐到凌风，倚著青藜杖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其三","author":"洪适","text":"二月到盘洲，繁缬盈千萼。\n恰恰早莺啼，一羽黄金落。\n花边自在行，临水还寻壑。\n步步肯相随，独有苍梧鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"洪适","text":"春意渐盈盈，窗外小桃堪折。\n若问得人怜处，是轻颦时节。\n主人特地出红妆，不要云心月。\n三径虽然冷淡，有采莲舟楫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 席上用景裴咏黄海棠韵","author":"洪适","text":"睡足淡梳妆，喜见诗人元白。\n不学艳红妖紫，环花仙标格。\n须知玉骨本天然，不是借人力。\n准拟小春重看，望秋灰无射。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 为钱处和寿","author":"洪适","text":"缥酒颂青春，不减宜城桑落。\n楼下玉人凝笑，散万英千萼。\n绣衣当日帝王州，横飞看雕鹗。\n闻道赐环书下，向金门持橐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"洪适","text":"小阁过重阳，愁对轻篁团色。\n喜得蛮笺新唱，似夜光明月。\n萸房菊蕊定相怜，酩酊误蕉叶。\n犹记去年今夜，听歌声清切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 东湖席上次曾守韵，时幕曹同集","author":"洪适","text":"风细晚轩凉，妙句初挥新墨。\n绿水池中宾佐，对嫩荷擎绿。\n坐看微月上云头，清臂映寒玉。\n只恐朝来酒醒，有文书羁束。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近","author":"洪适","text":"烂漫海棠花，多谢东君留得。\n眉寿堂边风景，与蓬瀛咫尺。\n桃红李白竞争妍，绿野尽春色。\n只欠樱唇清唱，怕行云南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 别傅丈","author":"洪适","text":"柳岸碧漪深，底事催人行色。\n无计曲留情话，只别愁如织。\n小蛮樊素两倾城，几度醉狂客。\n明日扁舟西去，听歌声不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正宫导引","author":"洪适","text":"重华天子，长至奉神虞。\n九奏会轩朱。\n星晖云润东方晓，拜贶竹宫初。\n归来千乘护皇舆。\n瑞景集金铺。\n鸡竿高唱恩书下，惠露匝中区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 赠举之","author":"洪适","text":"冥冥云屿两经秋。\n落霞收。\n断烟留。\n小阁凉生，清馥凝金虬。\n乘兴开颜那草草，烦玉腕，举琼舟。\n明年此日楚江头。\n极层楼。\n望丹丘。\n只恐溪山，千里碍凝眸。\n重倚阑干相忆处，寻过雁，作书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 其一 饯黄魁","author":"洪适","text":"当年提笔上词坛。\n琢琅玕。\n涌波澜。\n晁董声名，一日满人间。\n底事远烦骐骥足，梅岭外，砚台边。\n元戎倾盖有馀欢。\n酒杯宽。\n语离难。\n只恐江边，明日起青翰。\n暂去平分风与月，迎细札，步金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子 其二 黄宪生日代作","author":"洪适","text":"江如罗带抱山青。\n好风轻。\n五云横。\n北斗南边，烨烨使华星。\n两路平反多少事，培吉德，赍长生。\n当年乌府振冠缨。\n稔英声。\n起鹏程。\n垂上丹霄，回首志澄清。\n雪片深深梅著子，归路近，看和羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二 再作","author":"洪适","text":"席上酒杯难减，鼎中药味频加。\n老人争得脸如霞。\n镜里衰容人怕。\n檐溜尽成冰柱，前村变却梅花。\n琼瑶破碎为行车。\n冻雀盈枝堪画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一 雪中","author":"洪适","text":"小室坐毡重叠，红炉兽炭交加。\n一卮村酒吸流霞。\n窗外寒威可怕。\n心在盘洲种柳，眼看密雪飞花。\n银杯缟带不随车。\n江上渔蓑难画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归","author":"洪适","text":"澄清阁下藕如船。\n扁舟曾采莲。\n向来辛苦叠青钱。\n而今知几年。\n人去也，客凄然。\n酒泉添泪泉。\n一杯今夜且留连。\n断肠芳草边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉禋歌","author":"洪适","text":"吹葭缇籥气潜分。\n云采宜书壤效珍。\n长日至，一阳新。\n四时玉烛和匀。\n物欣欣。\n造化转洪钧。\n郊之祭，孤竹管，六变舞云门。\n自古严禋。\n牺牲具，粢盛洁，豆笾陈。\n衮龙陟降，币玉纷纶。\n彻高阍。\n灵之斿，神哉沛，排历昆仑。\n九歌毕，盈郊瞻槱燎，斗转参横将旦，天开地辟如春。\n清跸移轮。\n阗然鼓吹相闻。\n籋祥云。\n欢胪八陛，厘逆三神。\n圣矣吾君。\n华封祝、慈宫万寿，椒掖多男，六合同文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"降仙台","author":"洪适","text":"漏残柝静鸡声远，到高燎。\n入层霄。\n云裘蟠瑞霭，天步下嘉坛，旗旆飘摇。\n黄麾列仗貔貅整，气压江潮。\n导前从后盛官僚。\n玉佩间金貂。\n望扶桑，日渐高。\n阴霾霜雪，底处不潜消。\n辇路祥飙。\n披拂绛纱袍。\n云间瑞阙仰岧峣。\n播春泽、喜浃黎苗。\n礼成大庆，鳌三抃、受昕朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其六 寿周材","author":"洪适","text":"瓜瓞绵绵储庆远，闲平代有名人。\n一襦五裤说朱轮。\n云逵鸳缀近，雷社虎符新。\n正是泗滨浮磬日，潘舆一粲欣欣。\n鸾歌飞起杏梁尘。\n巢莲龟问岁，介寿酒融春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 盘洲饯汉章","author":"洪适","text":"两载绣衣频驻节，金莲曾印青苔。\n匆匆归去寿琼杯。\n曲终挥别泪，江上片帆开。\n记得秋宵山吐月，酒酣同上层台。\n杖藜何日解重来。\n相思凭过雁，飞送一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其三 稚川生日","author":"洪适","text":"钓濑怀珠山韫玉，谪仙至自蓬莱。\n它年勋业上云台。\n棣华开幕府，莲沼屈英才。\n南极逢秋光烂烂，门阑香雾萦回。\n须将寿卉荐琼杯。\n篱东明日菊，借取一枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其五 傅丈生日","author":"洪适","text":"干吕青云垂宝露，结邻恰挂初弦。\n瑞光腾踊杂非烟。\n骑箕瞻鼻祖，孕昴控胎仙。\n勋业子卿全汉节，壮怀久寄林泉。\n举觞低唱脸舒莲。\n寿高人七十，果熟岁三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其二 会黄魁","author":"洪适","text":"北斗南头云送喜，人间快睹魁星。\n向来平步到蓬瀛。\n如何天上客，来佐海边城。\n方伯娱宾香作穗，风随歌扇凉生。\n且须滟滟引瑶觥。\n十年迟凤诏，万里寄鹏程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其七 送罗倅伟卿权新州","author":"洪适","text":"远驾星屏临百粤，康沂户户歌功。\n使君五马去乘骢。\n卖刀无旷土，赠扇有仁风。\n莫唱渭城朝雨曲，片帆时暂西东。\n促归行拜紫泥封。\n九霄先步武，三接未央宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其一 郑盐生日","author":"洪适","text":"向日鹓行瞻凤彩，共期直上金銮。\n却来持节海云边。\n身兼三使者，名是一仙官。\n汉室中兴高密冠，千年苗裔蝉联。\n左弧嘉庆舞祥烟。\n橘中招四老，同醉酒如泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 其四","author":"洪适","text":"烟凑横岚霞抱日，望中衰草稠稠。\n西风吹恨著扁舟。\n马卿多病后，方寸不禁秋。\n颇念银壶行绿醑，共听渔子清讴。\n梦魂飞过海山楼。\n人随秋易老，情寄水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其一 雪中和景裴韵","author":"洪适","text":"闰岁饶光景，中旬始打春。\n拥炉看雪酒催人。\n梁上不曾飞落、去年尘。\n未暇巾车出，何妨举盏频。\n斜川日月已成陈。\n想得前村仙子、晚妆匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其四 喜晴用前韵","author":"洪适","text":"住得如筛雪，方欣有脚春。\n谁云三尺不须循。\n若是诗僧月下、许敲门。\n钜竹多中断，残梅竞小颦。\n畦丁说与主林神。\n扫洒板桥前径、待吾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其二 呈叶宪","author":"洪适","text":"多病都缘老，寒阴可惜春。\n栽桃种竹怕因循。\n移转篮舆藤杖、未开门。\n真率须如约，安排欲效颦。\n莫将筝笛损精神。\n自有啼莺舞鹤、解随人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其五 示裴弟","author":"洪适","text":"强作千年调，难逾五度春。\n脊令继踵漫相循。\n休要关心药裹、也扃门。\n蕙帐银杯化，纱窗翠黛颦。\n烧香试问紫姑神。\n一岁四并三乐、几多人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 童岭作","author":"洪适","text":"云拂山腰过，风吹雨点来。\n田园好处有池台。\n记著相逢时节、海棠开。\n蝴蝶那无梦，鸳鸯亦有媒。\n藏钩解佩两三杯。\n明日水边沙际、首空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其六 寄景卢","author":"洪适","text":"南浦山罗列，东湖水渺弥。\n主人好客过当时。\n斗转参横时候、醉如泥。\n莫管莺声老，从它柳絮飞。\n野园春色别无奇。\n船上有花多酒、未须归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其三 示景裴弟，时叶宪明日真率","author":"洪适","text":"顽健输村老，嬉游付后生。\n七旬才有五清明。\n须趁良辰美景、绕园行。\n云意将飞雪，天心未肯晴。\n难将性命作人情。\n只合拥炉清坐、阅医经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思佳客 次韵蔡文同集钱漕池亭","author":"洪适","text":"花信今无一半风。\n芙蓉出水几时红。\n看成弱柳阴阴绿，自在迁莺巧语中。\n风傍户，月留空。\n金尊相对醉珠栊。\n归鞭欲指江南去，回首霞标忆旧峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 别帅宪","author":"洪适","text":"天末相逢，醉中不讶车茵污。\n一声鸣橹。\n惊散眠沙鹭。\n我是行人，却送行人去。\n听金缕。\n莫辞甘醑。\n别泪飞寒雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"选冠子","author":"洪适","text":"雨脚报晴，云容呈瑞，夜雪萦盈连昼。\n千岩曳缟，万瓦堆琼，稍稍冷侵怀袖。\n鹤氅神仙，兔园宾客，高会坐移清漏。\n想灞陵桥畔，苦吟缓辔，耸肩寒瘦。\n向此际、色映堂阴，香传梅影，寒力更欺尊酒。\n左符词伯，蛮笺巧思，不道起风飞柳。\n舞态弓弯，一声低唱，蛾笑绿分烟岫。\n任杯行潋滟，为公沈醉，莫教停手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"洪适","text":"邦伯今推第一流。\n几因歌席负诗筹。\n一时文采说台州。\n雨脚渐收风入牖，云心初破月窥楼。\n翠眉相映晚山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 以鸳鸯梅送曾守，是日，曾守携家游南园","author":"洪适","text":"报道倾城出洞房。\n水边疏影弄清香。\n风流更有小鸳鸯。\n蝉鬓半含花下笑，蛾眉相映醉时妆。\n梦魂不到白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 席上别王巨济。先是，两姬免冠，王夺两秩，继以章罢","author":"洪适","text":"丹桂飘香已四番。\n杖藜携手自今难。\n黯然离恨满江干。\n壁上两冠元是谶，花前双韵几时弹。\n中秋后夜与谁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 寿方稚川","author":"洪适","text":"占得登高一日先。\n跨云来作地行仙。\n天将黄菊助长年。\n健笔已凌枚叟赋，高怀欲著祖生鞭。\n骎骎彯组向甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三 以鸳鸯梅送钱漕","author":"洪适","text":"玉颊微醺怯晚寒。\n可怜凝笑整双翰。\n枝头一点为谁酸。\n只恐轻飞烟树里，好教斜插鬓云边。\n淡妆仍向醉中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 景卢以米书眉间一点黄之曲饯送郑宪，因用其韵","author":"洪适","text":"举目霜林叶叶黄。\n使星归骑未须忙。\n烟鬟千叠弄残妆。\n内殿恩光承雨露，外台风力挟冰霜。\n应怀三径杂花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 饯范子芬行","author":"洪适","text":"整顿春衫欲跨鞍。\n一杯相属少开颜。\n愁眉不似旧时弯。\n未见两星添柳宿，忍教三叠唱阳关。\n相思空望会稽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其四 席中答钱漕","author":"洪适","text":"忆得熙春晓立班。\n使星曾入紫微垣。\n归来小饮友芝兰。\n投辖风流今复见，开尊礼数自来宽。\n更看宝唾写乌阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 席上再作","author":"洪适","text":"不见丹丘三十年。\n青山碧水想依然。\n自惊绿鬓已苍颜。\n月在柳梢曾径醉，雨荒院菊有谁怜。\n绣衣归与古人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"番禺调笑 其九 沉香浦","author":"洪适","text":"深浦。\n停舟处。\n只恐越装相染污。\n奇香一见如泥土。\n投著水中归去。\n令公早晚回朝著。\n无物迟留鸣橹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"番禺调笑 其三 海山楼","author":"洪适","text":"奇货。\n归帆过。\n击鼓吹箫相应和。\n楼前高浪风掀簸。\n渔唱一声山左。\n胡床邀月轻云破。\n玉麈飞谈惊座。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"番禺调笑 其八 贪泉","author":"洪适","text":"饮器。\n贪泉水。\n山乳涓涓甘似醴。\n怀金嗜宝随人意。\n枉受恶名难洗。\n真清方伯端无比。\n未使吴君专美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"番禺调笑 其五 朝汉台","author":"洪适","text":"音乐。\n传佳作。\n盖海旌幢开观阁。\n绮霞飞渡青油幕。\n好是登临行乐。\n当时朝汉心倾藿。\n望断长安城郭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 其一 破子","author":"洪适","text":"渔父饮时花作荫。\n羹鱼煮蟹无它品。\n世代太平除酒禁。\n渔父饮。\n绿蓑藉地胜如锦。\n渔父醉时收钓饵。\n鱼梁晒翅闲乌鬼。\n白浪撼船眠不起。\n渔父醉。\n滩声无尽清双耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]