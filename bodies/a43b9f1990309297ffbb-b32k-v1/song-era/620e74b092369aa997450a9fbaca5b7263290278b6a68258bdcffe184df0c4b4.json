[{"title":"跋东坡木石","author":"张元干","text":"玉局老仙天下人，平生爱与石传神。\n长江绝岛风涛里，千古常令墨色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋江天暮雨图","author":"张元干","text":"千山忽暗雨来时，天末浓云送落晖。\n老眼平生饱风浪，犹怜别浦钓船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋江贯道绝笔古松","author":"张元干","text":"石根盘屈老苍官，绝笔殷勤记岁寒。\n万里风云欲飞化，君家留得壁间看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋赵唐卿所藏访戴图 其二","author":"张元干","text":"王孙胸次足丘壑，幻出山阴访戴图。\n草屋柴扉闭风雨，客来空去得知无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋赵唐卿所藏访戴图 其一","author":"张元干","text":"万壑千岩一剡溪，漫天云冻雪风飞。\n人踪鸟迹俱沉绝，独有扁舟兴尽归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"艅艎斋","author":"张元干","text":"人间日日有风波，不系虚舟奈若何。\n袖取平生济川手，行藏终与祖同科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雍熙堂","author":"张元干","text":"鼎彝勋业推元老，文采风流及后昆。\n家世从来耐官职，百年犹见典刑存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘图","author":"张元干","text":"落日孤烟过洞庭，黄陵祠畔白蘋汀。\n欲知万里苍梧眼，泪尽君山一点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑶真馆","author":"张元干","text":"广陵祠里寻常见，又向山阳楼外开。\n须信月明风露下，飞仙玉节有时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨菊","author":"张元干","text":"老眼惊花暗，斜枝落纸愁。\n晚来闻冷雨，幻出一篱秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题六代祖师画像","author":"张元干","text":"一苇浮江双履归，花开震旦共传衣。\n本来心印无文字，画到卢能足是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题忠上人墨梅","author":"张元干","text":"寒梢的皪点昏鸦，雪后风前皎月华。\n结习未除羞老眼，更看淡墨幻空花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题独爱轩","author":"张元干","text":"此君风味极不浅，户外俗人来未曾。\n老石寒藤同一笑，我知公是在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其十","author":"张元干","text":"簪绂久已弃，行装今甚疲。\n买山如略办，毕娶更奚为。\n小筑开三径，躬耕趁一犁。\n赖公霖雨手，忍赋语离诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其九","author":"张元干","text":"罪放丙午末，归来辛亥初。\n不谈天下事，犹诵古人书。\n利病明诸掌，危疑儆后车。\n他时果无悔，载籍定欺予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其八","author":"张元干","text":"贱子居闾里，明公总帅权。\n姓名谁比数，礼遇每周旋。\n老去无三窟，闲中有二天。\n知音何日报，愿见中兴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其七","author":"张元干","text":"衮绣春秋富，旂常事业新。\n三迁推孟母，一德表商臣。\n任重能知止，功成合保身。\n傥容陪几杖，同访赤松人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其六","author":"张元干","text":"国士多孤愤，君侯特长雄。\n玉墀曾复辟，铁券会论功。\n宇宙尊文物，华夷界土风。\n力扶炎运正，此意合苍穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其五","author":"张元干","text":"蠢尔天骄子，中原祸太深。\n野心殊叵测，内地任频侵。\n日昃那常晦，阳生自剥阴。\n德光非不僭，终识杀狐林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其四","author":"张元干","text":"百六古今有，两宫开辟无。\n兴师诚刷耻，奋袂竞捐躯。\n必挟三灵助，能令万国孚。\n九宫驱六甲，何患五单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其三","author":"张元干","text":"活国勋奇甚，平戎志未衰。\n肯从时论屈，自许世人知。\n豹尾遥临镇，蝉冠暂祝釐。\n天将擒颉利，露布舍公谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其二","author":"张元干","text":"广汉家山远，临川道路旁。\n安舆怀故垒，同气听甘棠。\n雪后风烟润，春归草木香。\n丹心驰魏阙，梦想万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上张丞相十首 其一","author":"张元干","text":"闽粤诸侯地，春风尽去思。\n三年歌德政，万户绘生祠。\n位极聊方伯，谋深必帝师。\n待公安社稷，四海被恩私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与富枢密","author":"张元干","text":"和气从容一笑春，如公今是暂闲身。\n伊蒲馔设无多客，薝卜花繁正恼人。\n已遣炉熏通鼻观，更分茗碗瀹心尘。\n僧房长夏宜幽僻，杖屦频来愿问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子立昆仲垂和游天宫诗既工且敏义不虚辱再此见意","author":"张元干","text":"华裾绿发等青春，诗似机云定后身。\n家学乃翁真具眼，祖风当代岂凡人。\n字中仙爪便搔痒，句里灵犀解辟尘。\n万壑争流君看取，西兴从此是通津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"才元思如涌泉愈和愈好晨兴遣骑扣门披衣疾读走笔再酬严韵","author":"张元干","text":"阳和生发验葭灰，但见江梅欠蜡梅。\n风味向人忘冷落，岁寒乘月重徘徊。\n从来对酒遭花恼，何独题诗被雨催。\n公子唾珠无限思，更看铁画写离堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"止戈堂 其一","author":"张元干","text":"谯门直北望燕山，乙巳年来例破残。\n可但中原仍祸结，谁令东粤独偷安。\n西师有请君侯力，南顾无忧圣虑宽。\n恶少至今犹胆落，云台须入画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"止戈堂 其二","author":"张元干","text":"八州贤牧喜休兵，千骑重来竹马迎。\n万瓦连甍存比屋，十年回首赖长城。\n举觞谈笑精明甚，缓带登临步武轻。\n多是门墙旧宾客，愿公黄发佐升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙午春京城围解口号","author":"张元干","text":"戎马来何速，春壕绿自深。\n要知龙虎踞，不受犬羊侵。\n九庙安全日，三军死守心。\n傥为襄汉幸，按堵见于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上张丞相生朝四首 其四","author":"张元干","text":"将相兼文武，谦光接下僚。\n舆情争快睹，善颂适生朝。\n勋业当兴宋，谋猷永佐尧。\n千秋迎寿母，忠孝称金貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上张丞相生朝四首 其三","author":"张元干","text":"坤维标厚载，任重出宗臣。\n眉宇如虹气，仪形似玉人。\n中兴真有相，命世必逢辰。\n霖雨聊均逸，馀波润七闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上张丞相生朝四首 其二","author":"张元干","text":"奇勋施社稷，万世许忠嘉。\n宾日扶神器，回天坐正衙。\n貂蝉峨上衮，鼗鼓拥高牙。\n暂屈临闽粤，重闻降白麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上张丞相生朝四首 其一","author":"张元干","text":"上相生坤位，中兴运泰开。\n德威加异域，文武属全才。\n南极星躔焕，东方骑气来。\n下车逢诞日，喜色照樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上折枢彦质生朝二首 其二","author":"张元干","text":"秋水为神吉梦随，上公冠佩俨朝仪。\n风云感遇千龄会，日月依光四海知。\n笔阵词锋明藻色，龙韬豹略系安危。\n顽金从此归炉锤，岁岁门阑献寿诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上折枢彦质生朝二首 其一","author":"张元干","text":"天扶王室挺生申，瑞启中兴社稷臣。\n樽俎折冲常自任，庙堂康济更何人。\n秋风玉帐军容肃，冷月铃斋夜宴新。\n愿扫妖氛开寿域，衮衣端为转洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰溪舟中寄苏粹中","author":"张元干","text":"气吞万里境中事，心老经年江上行。\n三径已荒无蚁梦，一钱不直有鸥盟。\n云收远嶂晚风熟，浪打寒滩春水生。\n鸿雁北飞知我意，为传诗句濮阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜书怀呈富枢密","author":"张元干","text":"耳聋无用问新闻，矫首何妨目作昏。\n痴绝已甘投老境，背驰宁受乞怜恩。\n难陪年少从渠薄，赖得春回为我温。\n京洛交游频检校，渡江今有几人存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜有怀柯田山人四首 其四","author":"张元干","text":"雅欲赋招隐，何堪吊战场。\n独看星错落，久立夜苍茫。\n羽檄来东越，风烟隔下塘。\n安闲随处有，冠盖莫相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜有怀柯田山人四首 其三","author":"张元干","text":"客里了无况，乱来何止贫。\n淹留频换岁，老大更思亲。\n泥饮思田父，供粮乏故人。\n自怜归未得，不是白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜有怀柯田山人四首 其二","author":"张元干","text":"坐阅干戈扰，输公已定居。\n生涯今易足，世态莫嗔渠。\n晷短全疏客，窗晴好对书。\n故山常入梦，何日到吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜有怀柯田山人四首 其一","author":"张元干","text":"闻说新居好，山樊卜筑深。\n药囊能济物，龟策少知音。\n四海忧黔首，中原尽绿林。\n直须期雪屋，夜棹去相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜痴坐似闻才元作集有日矣因和前韵奉呈","author":"张元干","text":"拥炉书帙易尘灰，览古临窗独对梅。\n未寤径须呼子慎，常奴何得比方回。\n虚名到底将安用，能事从来不受催。\n似许相过陪客醉，胸中那复有愁堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶少蕴生朝三首 其三","author":"张元干","text":"元戎玉帐凛霜威，谈笑何妨羽扇挥。\n平日丹心驰象阙，长年綵服奉慈闱。\n谁无五马人生贵，独有三奇命世稀。\n志在麟经成事业，颇闻天子诏公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶少蕴生朝三首 其二","author":"张元干","text":"绿发翱翔翰苑春，升平三辅已朱轮。\n诗成山谷句中眼，名应石林天上人。\n耆旧政须廊庙具，蕃宣聊寄股肱臣。\n生朝剩欲为公寿，醉里蘋花度曲新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶少蕴生朝三首 其一","author":"张元干","text":"绛节霓旌下九天，括苍初识地行仙。\n桃华海上三千岁，凤历人间五百年。\n可但彤弓寻节制，要知黔首望陶甄。\n香凝燕寝森兰玉，会见貂冠总附蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"左举善人物高妙才具敏特要当为世用而乃携孥抚孤以不二价从事丹壶中其胸次讵可窥耶一日出示诸公篇轴邀老夫同赋义不可辞","author":"张元干","text":"小隐丹壶时凭栏，它年兴在跨黄班。\n不妨游戏橘中乐，政尔经营湖上山。\n谁识胸怀容万顷，聊将身世寓三间。\n故人有子犹流落，我辈逢渠转厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊辰春二月晦日同栖鸾子送所亲过宝积题壁间","author":"张元干","text":"春江因送客，云峤更登临。\n精舍经行地，征人去住心。\n猿啼清梦断，花落晓窗阴。\n胜践成三宿，俱来此意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用折枢韵呈李丞相二首 其二","author":"张元干","text":"莫问蒲萄出月支，不缘瓜枣访安期。\n轻红满地人慵扫，空翠沾衣雨足时。\n松荫晴泉听落涧，蝉嘶晚吹助裁诗。\n公乎此去归廊庙，无用山中怨鹤为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用折枢韵呈李丞相二首 其一","author":"张元干","text":"参陪仍许瘦筇支，长者登临敢后期。\n钟断白云飞雨过，月生青嶂夜凉时。\n心知胜地都忘睡，喜听连床共和诗。\n莲社风流增荔子，馀生长健更何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"申伯有行色会宿东禅次元韵","author":"张元干","text":"真成风雨夜，精舍对床眠。\n去住非无数，行藏莫问天。\n十年濒瘴海，一棹破春烟。\n君自足归兴，不妨啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵重哭德久贤使君","author":"张元干","text":"风撼棠梨对殡宫，中郎谈笑孰形容。\n不居上界神仙府，当在补陀孤绝峰。\n至论每符磁石铁，长生空问茯苓松。\n九原可作还知否，底处返魂香最浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵哭德久","author":"张元干","text":"女无美恶妒深宫，盛德如公果不容。\n何遽盖棺临禹穴，未应藏骨在秦峰。\n论文平日樽中酒，挂剑它年冢上松。\n点检交亲祇解少，存亡悲感老情浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵奉留聪父","author":"张元干","text":"长饥方朔笑侏儒，岁晚还惊大小馀。\n客里论文聊把酒，闲来会面胜通书。\n薄寒欺醉悲清夜，孤月流光怅碧虚。\n何苦相逢又相别，不如供米寓僧居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再次前韵即事","author":"张元干","text":"太一游行遍九宫，世间无地可宽容。\n坤维莫傍剑门阁，衡岳何依天柱峰。\n睨柱傥能回赵璧，思鲈安用过吴松。\n群羊竞语遽如计，欲息兵戈气甚浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和李丞相游山","author":"张元干","text":"海山幻出化人宫，楼观新崇万指容。\n云雾入檐银色界，藤萝昏雨妙高峰。\n放怀久已参黄檗，雅志无疑伴赤松。\n欲去更闻狮子吼，忘归桥下兴犹浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人书怀 其一","author":"张元干","text":"此生无意入修门，粗饱鸡豚短褐温。\n卜筑几椽临水屋，经营数亩傍山园。\n酒杯剩喜故人饮，书帙能遮老眼昏。\n身世颇同猿择木，功名谁问鹤乘轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人书怀 其三","author":"张元干","text":"布谷催春惜雨乾，白鸥江上未盟寒。\n且倾客子酴醾酒，共享先生苜蓿盘。\n我已悬车羞碌碌，公当鸣佩称珊珊。\n休文才思虽多病，可是空吟红药阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人书怀 其二","author":"张元干","text":"肠断春风杨柳花，中原何日再京华。\n将军未报歌三箭，乐府徒传舞两娃。\n会见敌营如竹破，不应淮甸又兵加。\n频年寒食常为客，强索芳樽乐有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人寒食书怀韵二首 其二","author":"张元干","text":"孤生投老急菟裘，万里云山已倦游。\n共喜石交逢异县，更陪綵笔赋春愁。\n无心俯仰犹多事，与世浮沉己拙谋。\n冷雨吹花作寒食，三杯软饱且眠休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人寒食书怀韵二首 其一","author":"张元干","text":"往昔升平客大梁，新烟然烛九衢香。\n车声驰道内家出，春色禁沟宫柳黄。\n陵邑祇今称虏地，衣冠谁复问唐装。\n伤心寒食当时事，梦想流莺下苑墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次江子我迁居韵","author":"张元干","text":"平生自省宜三黜，老去何心望九迁。\n避地湖山聊复尔，脱身兵火想当然。\n浮家泛宅非无计，坎止流行本信缘。\n犹恐惊涛翻四海，直须化鹤作飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次江子我闻角韵","author":"张元干","text":"夫差故国萦寒水，铁马南来忽振缨。\n城上昏鸦争接翅，舟中逐客谨逃名。\n胡笳怨处风微起，浊酒醒时梦易惊。\n飘泊似闻山寺近，真成夜半听钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次折枢留题雪峰韵","author":"张元干","text":"轩冕本无意，烟霞如有期。\n故人容野老，胜践见新诗。\n谁办兼忘世，公当急济时。\n春归仍送别，好在出山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次赵次张见遗之什韵","author":"张元干","text":"海边游子日思归，新句劳君更置规。\n莫问人间多贝锦，正如天上有参旗。\n寄书只欲凭黄耳，去路谁能畏赤眉。\n定与故巢猿鹤老，此生无愧北山移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次钱申伯游东山韵二首 其二","author":"张元干","text":"扫榻开轩走寺宫，吾曹终日得从容。\n夕阳初落鳣溪路，云气半遮狮子峰。\n试问丹砂回白发，何如瀑布煮枯松。\n暮年纵有壮心在，归意已胜山色浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次钱申伯游东山韵二首 其一","author":"张元干","text":"东麓坡陀尽梵宫，我来泉上照衰容。\n解衣又作茶瓜客，倚槛同看烟雨峰。\n何用苦吟凌鲍谢，要须高节配乔松。\n海冰永閟锥沙画，绝叹故人遗墨浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵元功才友道中见贶因以解嘲","author":"张元干","text":"当时勇决径归休，更有人愚似我不。\n何许置锥宁免累，直须毕娶始无忧。\n频遭白眼伤流俗，谁向青门念故侯。\n客里题诗相慰藉，羡君椽笔合螭头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]