[{"title":"鹧鸪天 其十三 和傅先之提举赋雪","author":"辛弃疾","text":"泉上长吟我独清。\n喜君来共雪争明。\n已惊并水鸥无色，更怪行沙蟹有声。\n添爽气，动雄情。\n奇因六出忆陈平。\n却嫌鸟雀投林去，触破当楼云母屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"辛弃疾","text":"老退何曾说著官。\n今朝放罪上恩宽。\n便支香火真侍俸，更缀文书旧殿班。\n扶病脚，洗衰颜。\n快从老病借衣冠。\n此身忘世浑容易，使世相忘却自难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九","author":"辛弃疾","text":"桃李漫山过眼空。\n也宜恼损杜陵翁。\n若将玉骨冰姿比，李蔡为人在下中。\n寻驿使，寄芳容。\n垄头休放马蹄松。\n吾家离落黄昏后，剩有西湖处士风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六 黄沙道中","author":"辛弃疾","text":"句里春风正剪裁。\n溪山一片画图开。\n轻鸥自趁虚船去，荒犬还迎野妇回。\n松菊竹，翠成堆。\n要擎残雪斗疏梅。\n乱鸦毕竟无才思，时把琼瑶蹴下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九 再赋牡丹","author":"辛弃疾","text":"去岁君家把酒杯。\n雪中曾见牡丹开。\n而今纨扇薰风里，又见疏枝月下梅。\n欢几许，醉方回。\n明朝归路有人催。\n低声待向他家道，带得歌声满耳来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 东阳道中 其五 代人赋","author":"辛弃疾","text":"扑面征尘去路遥。\n香篝渐觉水沈销。\n山无重数周遭碧，花不知名分外娇。\n人历历，马萧萧。\n旌旗又过小红桥。\n愁边剩有相思句，摇断吟鞭碧玉梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九 寻菊花无有，戏作","author":"辛弃疾","text":"掩鼻人间臭腐场。\n古来惟有酒偏香。\n自从归住云烟畔，直到而今歌舞忙。\n呼老伴，共秋光。\n黄花何事避重阳。\n要知烂熳开时节，直待西风一夜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其七 有客慨然谈功名，因追忆少年时事，戏作","author":"辛弃疾","text":"壮岁旌旗拥万夫，锦襜突骑渡江初。\n燕兵夜娖银胡䩮，汉箭朝飞金仆姑。\n追往事，叹今吾，春风不染白髭须。\n却将万字平戎策，换得东家种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天    其十五 戏题村舍","author":"辛弃疾","text":"鸡鸭成群晚不收，桑麻长过屋山头。\n有何不可吾方羡，要底都无饱便休。\n新柳树，旧沙洲，去年溪打那边流。\n自言此地生儿女，不嫁金家即聘周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天    其一 和子似山行韵","author":"辛弃疾","text":"谁共春光管日华，朱朱粉粉野蒿花。\n闲愁投老无多子，酒病而今较减些。\n山远近，路横斜，正无聊处管弦哗。\n去年醉处犹能记，细数溪边第几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天    其一 读渊明诗不能去手，戏作小词以送","author":"辛弃疾","text":"晚岁躬耕不怨贫，只鸡斗酒聚比邻。\n都无晋宋之间事，自是羲皇以上人。\n千载后，百篇存，更无一字不清真。\n若教王谢诸郎在，未抵柴桑陌上尘！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天    其十一 游鹅湖醉书酒家壁","author":"辛弃疾","text":"春入平原荠菜花，新耕雨后落群鸦。\n多情白发春无奈，晚日青帘酒易赊。\n闲意态，细生涯，牛栏西畔有桑麻。\n青裙缟袂谁家女？\n去趁蚕生看外家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天    其六 鹅湖归病起作","author":"辛弃疾","text":"枕簟溪堂冷欲秋，断云依水晚来收。\n红莲相倚浑如醉，白鸟无言定自愁。\n书咄咄，且休休，一丘一壑也风流。\n不知筋力衰多少，但觉新来懒上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 赤壁","author":"辛弃疾","text":"雪堂迁客。\n不得文章力。\n赋写曹刘兴废，千古事、泯陈迹。\n望中矶岸赤。\n直下江涛白。\n半夜一声长啸，悲天地、为予窄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角","author":"辛弃疾","text":"暮山层碧。\n掠岸西风急。\n一叶软红深处，应不是、利名客。\n玉人还伫立。\n绿窗生怨泣。\n万里衡阳归恨，先倩雁、寄消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 旅兴","author":"辛弃疾","text":"吴头楚尾，一棹人千里。\n休说旧愁新恨，长亭树、今如此！\n宦游吾倦矣，玉人留我醉。\n明日万花寒食，得且住、为佳耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"辛弃疾","text":"身为参禅老，家因赴诏贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"辛弃疾","text":"酒肠未减长鲸吸，诗思如抽独茧丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"辛弃疾","text":"多情为我香成阵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓬莱山","author":"连三益","text":"蓬莱一境最奇哉，门外坑流傍石隈。\n巨竹不知何日裂，乔松总是昔年栽。\n石移莫匪神功运，岩筑更无山鬼来。\n料得众僧行道处，天花馥郁遍苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微亭 其一","author":"连久道","text":"涌壁千寻古面颜，仰凭天柱俯仙关。\n松间雕镂轩墀月，未许诗人见一□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微亭 其二","author":"连久道","text":"行迹年来酬□希，独□岩壑有深期。\n□□道士能相属，请和空山木落诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄琳宫 其一","author":"连久道","text":"玲珑万状石欺玉，开阖千层秀结峰。\n尚有炎蒸疑夏日，未令新爽洗秋容。\n龙翔凤舞来天目，水秀山明巩帝封。\n新见钱塘王气好，中原我欲指迷踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄琳宫 其二","author":"连久道","text":"栖真已得寻西洞，神应谁能辨雨钟。\n水奏五音鸣玉凤，山回九锁踞苍龙。\n古杉疑复天台去，怪石时从福地供。\n它日重游应更好，拟登天柱最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白云歌赠白云道人","author":"连久道","text":"君不见白云万顷还□去，来去谁能留得住。\n去处放他秋月明，来时寒破太虚路。\n等闲为雨复为晴，玄空一点元青青。\n道人何异白云意，此心了然游杳冥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 渔父","author":"连久道","text":"阵鸿惊处。\n一网沈江渚。\n落叶乱风和细雨。\n拨棹不如归去。\n芦花轻泛微澜。\n蓬窗独自清闲。\n一觉游仙好梦，任它竹冷松寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雪次北客韵","author":"连文凤","text":"丰年佳瑞此先知，莫恨无多莫恨迟。\n若使纷纷犹未已，梅花冻杀又多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山云","author":"连文凤","text":"去如断雁失群飞，来是高僧出定归。\n无去无来林下客，吟魂一片共依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己丑元宵","author":"连文凤","text":"不因灯火有元宵，彊把时光慰寂寥。\n十四年来无此兴，三更踏月过河桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋夜坐","author":"连文凤","text":"寂寞无如此夜坐，西窗剪烛读离骚。\n可怜尘世多风雨，天柱峰头月正高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋夜坐","author":"连文凤","text":"读罢残书听雁声，西风一榻一青灯。\n老来清思浑如许，自笑前生莫是僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬午观火地","author":"连文凤","text":"烧尽长安市上花，何时重见此繁华。\n独怜几处堂前燕，失却新巢过别家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆赵右之","author":"连文凤","text":"羞见梅花照客身，梅花长好客长贫。\n江天摇落年华晚，何处青山有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题 其一","author":"连文凤","text":"学书学剑两茫然，空过浮生五十年。\n拟向烟波深处住，王租已及钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜独坐","author":"连文凤","text":"坐久不闻人语喧，风枝吹动宿禽翻。\n几家负却三更月，未到钟声已闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王昭君","author":"连文凤","text":"使者相随出汉宫，辞君上马去匆匆。\n只因自恃好颜色，不把金钱买画工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪梦","author":"连文凤","text":"薰风一榻卧南窗，无事萦心暑亦凉。\n半夜忽生乡土梦，屋前屋后荔枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀杭道中晓行","author":"连文凤","text":"晓雾溟濛未见天，山光水影白相连。\n馀杭不似西川路，六月中旬叫杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕易","author":"连文凤","text":"身世相忘象外天，清风一枕几千年。\n有时默默焚香坐，閒看白云心自玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"费壶天人一理堂","author":"连文凤","text":"高高下下两无穷，尽在壶天一色中。\n俯仰不堪供一笑，何当相与问洪濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人归越 其二","author":"连文凤","text":"吴越青山犹好在，古今明月不长圆。\n可堪老大重离别，一片愁心落照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人归越 其一","author":"连文凤","text":"把手西风晚菊天，梦魂唤醒十年前。\n未能扪虱谈时事，且与持螯上酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高继伯分教湖之德清","author":"连文凤","text":"此时不忍抱遗材，欲把文章扇冷灰。\n见说读书堂尚在，瓣香寄与谒东莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩仲文归京口 其一","author":"连文凤","text":"有客京口号竹坡，苍然碧玉横清波。\n凄凉驼陌走风雨，游尘飞扑征衫多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"项籍","author":"连文凤","text":"盖世英雄冠古今，干戈未定日相寻。\n帐中一夕悲歌处，霸气难降儿女心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流杯亭","author":"连文凤","text":"流杯亭下水无声，满地牛羊野草腥。\n何事当时贪宴会，至今帝醉未能醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读文丞相宋瑞诗 其一","author":"连文凤","text":"宰相临危不辱身，晋周惟有两忠臣。\n国亡八载身方死，今古更无第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读文丞相宋瑞诗 其二","author":"连文凤","text":"身后声名满世间，孤魂万里朔风寒。\n何年得见忠臣传，且把君诗当史看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史","author":"连文凤","text":"满道累累尽赭衣，含冤相语泣相随。\n不因今日身亲见，只说先秦事可疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作 其二","author":"连文凤","text":"少年场屋苦奔波，每对书檠读不多。\n三十年来书好读，可怜老眼费摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶作 其一","author":"连文凤","text":"春风跃马看花时，肯信秋风鬓易衰。\n富贵百年皆长物，老来方悔读书迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿珠","author":"连文凤","text":"忍将死别季伦家，百丈楼前日色斜。\n一片香魂随笛散，却疑吹落玉梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铜雀台","author":"连文凤","text":"月正明时星正稀，邺城风雨忽凄凄。\n荒台深锁残春色，半夜寒鸦绕树啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄高士山房","author":"连文凤","text":"绝无一语到人间，但把瑶琴续续弹。\n夜鹤归来山月白，松花吹落石林寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上","author":"连文凤","text":"东风残柳旧烟青，不见长亭共短亭。\n几处王孙芳草地，胡僧相对坐看经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋椰子吸月杯","author":"连文凤","text":"壳似悬匏护玉房，谁人剖玉注天浆。\n有时吞却杯中兔，带得长生药气香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋黑兔","author":"连文凤","text":"昔日蟾宫捣药时，桂花树下影依依。\n一朝误落人间世，却被缁尘染素衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午","author":"连文凤","text":"相传楚俗试兰汤，一枕南薰日正长。\n门掩绿阴无个事，起来烧过午时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画","author":"连文凤","text":"娇红淡粉逞春姿，好手移来一两枝。\n见说此花三十种，只消莫画醉西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题胭脂骢图","author":"连文凤","text":"世上纷纷驽与骀，分明此种是龙媒。\n雪毛尚带胭脂湿，想是扶桑作浴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤泉为丁君瑞赋","author":"连文凤","text":"为厌缁尘污缟衣，閒身甘共水相依。\n尘间那得清泠水，何似瑶池饮夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠卖花湖妓","author":"连文凤","text":"客来不惜买花钱，客醉青楼月在天。\n欲尽樽前歌舞意，湖头已有早开船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐士","author":"连文凤","text":"不隐山林隐市廛，半生活计此书田。\n可怜世上无扬子，谁识雄心在太玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月晦日怀林处士","author":"连文凤","text":"相思忽成梦，久不到茶窝。\n飞去羽毛短，别来风雨多。\n杏花一夜发，春事二分过。\n百尺龙潭上，知君意若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月病中","author":"连文凤","text":"此病从何得，蹉跎过六年。\n家贫无长物，药债似随肩。\n衰飒形如鬼，清臞骨不仙。\n死生俱一梦，吾自乐吾天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三省斋为洪中行赋","author":"连文凤","text":"机巧日相寻，谁能自警深。\n惟君学夫子，此意即曾参。\n钟破平生梦，灯明半夜心。\n遥知读书处，松桂已成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居","author":"连文凤","text":"无名亦无利，非隐又非仙。\n逐兽机心息，闻禽野性便。\n俗淳犹近古，人老不知年。\n此是山居乐，山中别一天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞云亭","author":"连文凤","text":"越山眇何许，孤影更依依。\n每见无心出，因思齧指归。\n随风游泮水，带雨湿斑衣。\n应想巴陵地，春馀寸草晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋玩月","author":"连文凤","text":"此夜月如昼，有人同倚楼。\n山河万古色，天地一轮秋。\n尽赏兴不足，醉看身欲浮。\n因思旧年处，风雨未能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋偶病","author":"连文凤","text":"中秋不见月，扶病倚阑干。\n故国愁心远，西风瘦骨寒。\n纵无今夕醉，容有别时看。\n且作南飞鹊，一枝聊自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六和塔访陈右司","author":"连文凤","text":"空山木落欲何归，渺渺黄尘污客衣。\n自叹冯唐今已老，世无刘表孰堪依。\n炉中丹火工夫浅，篱下文章气燄微。\n幸识贞元旧朝士，钱塘江上语残晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题 其二","author":"连文凤","text":"华毂高轩傲世尘，一枝筇竹喜相亲。\n精神我愧鸿都客，甲子谁同绛县人。\n悠远山川终古在，鲜妍花草逐时新。\n故交霜叶凋零尽，欲话当年记不真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙戌送李元晖归","author":"连文凤","text":"剑影悠悠出故都，酒边临别重踌躇。\n吴江霜早愁闻雁，楚泽天宽老钓鱼。\n瑶草春风香未歇，美人秋水意何如。\n西湖莫忘閒鸥鹭，彊健不妨频寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":2393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]