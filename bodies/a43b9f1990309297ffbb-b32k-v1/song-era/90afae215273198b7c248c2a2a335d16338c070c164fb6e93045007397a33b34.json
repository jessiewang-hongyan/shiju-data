[{"title":"食盘兔","author":"萧立之","text":"猎户初登网，庖丁亦奏刀。\n毛皮尽剥落，风味足烹熬。\n喜有开樽适，谁知逐野劳。\n微吟供一笑，尔狡谩称豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越一月复以宪檄按死事于抚之溪暑中望疏山不得往归宿永兴寺拜象山先生墓而后行兼旬得诗如前之数可发一笑为后山行云 七夕","author":"萧立之","text":"偃仰当日谩能工，刻楮何如造化功。\n乞巧从渠儿女道，自书拙赋上屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越一月复以宪檄按死事于抚之溪暑中望疏山不得往归宿永兴寺拜象山先生墓而后行兼旬得诗如前之数可发一笑为后山行云 武阳渡","author":"萧立之","text":"落日平江晚最奇，白龙鳞换紫玻璃。\n老兵绝叫客争渡，催得船来失却诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越一月复以宪檄按死事于抚之溪暑中望疏山不得往归宿永兴寺拜象山先生墓而后行兼旬得诗如前之数可发一笑为后山行云 其一 西林寺","author":"萧立之","text":"寻僧闲事为官忙，人指云生是上方。\n少避归牛寻曲径，野田黄雀闹斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越一月复以宪檄按死事于抚之溪暑中望疏山不得往归宿永兴寺拜象山先生墓而后行兼旬得诗如前之数可发一笑为后山行云 其二 西林寺","author":"萧立之","text":"日日北风江倒流，木绵著花人索裘。\n西津渡口半船月，秋在芙蓉十里洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越一月复以宪檄按死事于抚之溪暑中望疏山不得往归宿永兴寺拜象山先生墓而后行兼旬得诗如前之数可发一笑为后山行云 疏山道中","author":"萧立之","text":"昨夕凉飔半点无，也无林影避行车。\n秋云一崦疏山晓，欲往从之畏简书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"越一月复以宪檄按死事于抚之溪暑中望疏山不得往归宿永兴寺拜象山先生墓而后行兼旬得诗如前之数可发一笑为后山行云 方广寺","author":"萧立之","text":"客子入门钟梵喧，菩提树老不知年。\n竹窗有月无人管，一夜秋风落笕泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月以檄至九江杂赋","author":"萧立之","text":"转枕移书就晚风，晴窗云掩树重重。\n如何客里无诗得，日听鸣蝉夜听蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东西林二首 其一","author":"萧立之","text":"庐山山里石头路，我自舍车便杖藜。\n西林云物古时塔，东林秋声堂下溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东西林二首 其二","author":"萧立之","text":"远公与客亦从容，未至当年似懒慵。\n送过虎溪元不恶，不妨门外听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圆通寺","author":"萧立之","text":"江南开山松十围，石耳德色坡翁诗。\n胡孙夜半叫绝壁，宿客梦回风雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"靖节先生祠","author":"萧立之","text":"柴桑祠前松菊秋，清风天地与同流。\n它山之石可攻玉，撺掇先生是督邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太平宫赋听雨","author":"萧立之","text":"仙人喜作狡狯事，幻此溪声成雨声。\n我听以心非以耳，是溪是雨本分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琵琶亭二首 其一","author":"萧立之","text":"天涯偶尔伤流落，聊复吟情寄水云。\n说梦痴儿千载后，邮亭有曲不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琵琶亭二首 其二","author":"萧立之","text":"鲁男子事无人记，此地琵琶更结亭。\n独倚阑干成一笑，晚风低雁著寒汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其一","author":"萧立之","text":"嗔目相如长是怒，它肠卫绾本来无。\n江湖结客知多少，识面微生只蔡谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其二","author":"萧立之","text":"横行颇有壮士气，黄中似是君子人。\n当年水底缘谁怒，此日樽前有许珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其三","author":"萧立之","text":"人间族系遍湖海，岂亦避秦之子孙。\n似是外黄坑向尽，内黄一种至今存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其四","author":"萧立之","text":"诸公俎豆亦风流，肥腯何曾为彘谋。\n欲免镬汤君自择，速营将老有糟丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其五","author":"萧立之","text":"纷纷炙热总成擒，束缚归来若不禁。\n出涸阴乡奚所恨，煌煌堂上祸机深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其六","author":"萧立之","text":"新酒黄花秋满城，看渠觳■可怜生。\n前身岂亦为书误，死则从人五鼎烹。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹九首 其七","author":"萧立之","text":"霜前入市勿增价，斗拣团脐作席珍。\n知味□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失题","author":"萧立之","text":"人事几何千载长，南州一梦亦荒凉。\n浮云忽散秋空晓，双井如今水亦香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛竹山四首 其一","author":"萧立之","text":"租地编茅且数椽，孤悬浮寄亦堪怜。\n山深无复农桑事，别有人间种药田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛竹山四首 其二","author":"萧立之","text":"山围水匝径百里，树老苔封知几春。\n谁遣五丁开栈径，当时疑有避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛竹山四首 其三","author":"萧立之","text":"云间樵子罕曾逢，时有携镵采药翁。\n树树山猿摇落日，榧林无实老秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"毛竹山四首 其四","author":"萧立之","text":"道傍虎迹大如盌，落日平林客子惊。\n问宿转湾知有店，山根一路笕泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一翠亭二首 其一","author":"萧立之","text":"隔水山青欲染衣，一檐云影树高低。\n白鸥似笑客尘土，飞过亭前却下溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一翠亭二首 其二","author":"萧立之","text":"缘云觅路石钩衣，山谷曾来尚有碑。\n黄帽打船催客去，一栏秋思是谁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失题 其一","author":"萧立之","text":"涿水茫茫何处边，此台名姓为谁传。\n未论跨鲤当年事，有许溪山意亦仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失题 其二","author":"萧立之","text":"台上秋风草木疏，台前清泚数游鱼。\n谪仙他日骑鲸去，未必三生不是渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题揭梅窗诗卷二首 其一","author":"萧立之","text":"吟得秋痕入鬓髭，梅花窗下一编诗。\n梅花奇处君知否，不在春风烂熳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题揭梅窗诗卷二首 其二","author":"萧立之","text":"金膏水碧须沧海，万里扬帆东更东。\n我辈欲为千岁计，古人还是几生功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东畈陈上舍吟稿二首 其一","author":"萧立之","text":"后山诗法似参禅，参到无言意已传。\n莫以家鸡疏野鹜，短檠疏雨月光前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东畈陈上舍吟稿二首 其二","author":"萧立之","text":"君家诗有简斋翁，南渡流离语更工。\n好继翁诗致华要，墨梅题入御屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题黄立轩西湖百咏三首 其一","author":"萧立之","text":"东南诗境有湖山，爱子敲成百咏看。\n历历眼中都过尽，一檠风雨客窗寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题黄立轩西湖百咏三首 其二","author":"萧立之","text":"欲雕好句老经行，读子清吟客梦醒。\n意象见前无笔力，一如前辈说西铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题黄立轩西湖百咏三首 其三","author":"萧立之","text":"王气随潮到海壖，出湖车马下湖船。\n可怜万事如春梦，艳舞清歌过百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题危定之芳洲吟卷","author":"萧立之","text":"篝灯细读芳洲卷，清似江南雪外枝。\n吟到蛾灯最奇崛，猩毛笔后有君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题穆叔晦雨净风香亭三首 其一","author":"萧立之","text":"压檐秋影玉参差，小小游亭面面诗。\n扁著净香堪一笑，渠香元不要人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题穆叔晦雨净风香亭三首 其二","author":"萧立之","text":"风标王谢佳子弟，气岸夷齐旧典刑。\n骑马纷纷尘及腹，几人爱此竹间亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题穆叔晦雨净风香亭三首 其三","author":"萧立之","text":"别久重来有此亭，鸣球敲筑碎风棂。\n却怜客鬓垂垂白，不奈霜枝冉冉青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老叹","author":"萧立之","text":"学不前人生谩前，老来嫌怕占人先。\n只便岁晚屠苏酒，后饮翻成最少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题邹氏观梅亭二首 其一","author":"萧立之","text":"岁晚才花花已迟，于春何意独先知。\n由来迟底应偏耐，不看南枝看北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题邹氏观梅亭二首 其二","author":"萧立之","text":"诗人爱梅说道理，弄影团香未觉难。\n枝上乾坤参得透，不妨来此倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑琴山并谢中书君之贶三首 其一","author":"萧立之","text":"诗来执热濯寒淙，剪剪西风破玉蓉。\n二十年间四方恨，不教东野化为龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑琴山并谢中书君之贶三首 其二","author":"萧立之","text":"我屋梅花为客栽，吟梅君独未能来。\n山中欠了连床约，却对西湖笑口开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑琴山并谢中书君之贶三首 其三","author":"萧立之","text":"落笔何能观堵墙，山间只合傲羲皇。\n惭君遗我湘枝束，愁与吟䯲一样霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送雪溪徐高士之越三首 其一","author":"萧立之","text":"清吟未了又成行，是处青山入瘦藤。\n两袖晓风荷叶露，自摇明月渡西兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送雪溪徐高士之越三首 其二","author":"萧立之","text":"雁雁欲啼江上秋，旧题诗在水边楼。\n潮风一夜移帆去，明日书来是越州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送雪溪徐高士之越三首 其三","author":"萧立之","text":"团扇应堪障夕晖，晓凉犹嫩且綀衣。\n去时宽著秋风担，留贮千岩万壑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨达可梅楼二首 其一","author":"萧立之","text":"何掾向来吟有阁，杨家今日筑为楼。\n看他压尽凡花倒，只放诗人出一头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨达可梅楼二首 其二","author":"萧立之","text":"先生豪气元龙似，眉骨凛凛闽山秋。\n从渠俗子卧地下，不是梅花不上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其一","author":"萧立之","text":"十日工夫不到诗，绳床兀兀夕阳低。\n黄昏几点敲窗雨，又是西风趱木犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其二","author":"萧立之","text":"旧嫌诗被西湖隔，一笑谁教却此同。\n为有简书闲不得，不知吟鬓又秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其三","author":"萧立之","text":"西山南浦住经时，又住吴山送落晖。\n燕子不知家近远，年年秋社一番归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其四","author":"萧立之","text":"独自携文校短长，隔帘人静雨沧浪。\n龙公倒捲西湖水，一夜满城荷气香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其五","author":"萧立之","text":"远枕惊回昨夜秋，月痕依约去年愁。\n移床欲避梧桐去，谁有西风背处楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其六","author":"萧立之","text":"笼鼕饭鼓动回廊，乍换生綀浴晚凉。\n双鹊自闲来又去，不知帘底有人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其七","author":"萧立之","text":"雪绕冰围不可支，轻纨那得敌炎威。\n雷公恶发夜来雨，试问热官何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其八","author":"萧立之","text":"山水宜秋风雨后，坐窗得瘦奈愁何。\n传闻近长湖船价，天气乍凉游子多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其九","author":"萧立之","text":"头脑涔涔醉梦中，起梳短发受西风。\n青綀要换秋来著，自汲寒泉濯软红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"校文京庠呈黄立轩朱南湖十首 其十","author":"萧立之","text":"月过阑干客睡迟，官河桐叶学鸦飞。\n鬓丝不了三千丈，也费秋虫促夜机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题修水黄公端梅溪二首 其一","author":"萧立之","text":"种近春风鼎鼐家，竹篱茅舍亦光华。\n开时不作寻常实，著眼溪头看此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题修水黄公端梅溪二首 其二","author":"萧立之","text":"此地梅花非隐沦，向来双井属诗人。\n如今添著调梅手，却与江南作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句四首 其一","author":"萧立之","text":"月落云窗黑如漆，一纸家书灯下笔。\n不知昨夜秋浅深，五更枕前啼蟋蟀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句四首 其二","author":"萧立之","text":"官河中有去来舟，舟上无人记得愁。\n千年城郭送白日，旧雨客来今雨楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句四首 其三","author":"萧立之","text":"风雨城中秋几家，城根细草亦秋花。\n一声绿树乌啼昼，睡起隔帘人卖茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句四首 其四","author":"萧立之","text":"翠玉玲珑朵朵娇，熟衣裁得替生绡。\n都人不识悲秋苦，只等西风出看潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题仇仁近山村图","author":"萧立之","text":"帝城谁有青山梦，洗眼新图竹树村。\n此地何须户司马，断无人与子争墩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜纳凉","author":"萧立之","text":"竹夫人有专房想，曲秀才难折柬招。\n一卷桐阴风不动，避灯坐过月平桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题傅德藻月湖小舟集","author":"萧立之","text":"龙骧百斛与湖宜，舟小何堪月四围。\n认取坳堂置杯意，漆园此语是诗机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十日府委撞点巡铺马上得四绝 其一","author":"萧立之","text":"更阑持檄走乌衣，立马阶除月上时。\n急唤睡魔君且去，天街聊作看灯嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十日府委撞点巡铺马上得四绝 其二","author":"萧立之","text":"天上斜河星灭明，人间宫漏隔重城。\n老兵几度搀前立，一簇寒灯听点名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十日府委撞点巡铺马上得四绝 其三","author":"萧立之","text":"家家门巷月徘徊，洗净街声鼻观雷。\n几处狭斜和梦过，喝更人逐马蹄来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]