r":28042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾四首 其四","author":"刘子翚","text":"霜蕤薰碧醥，气味已相传。\n终以香为累，无人解倒悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾四首 其三","author":"刘子翚","text":"独立幽亭晚，春风玉一围。\n残英不著地，去作岭云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾四首 其二","author":"刘子翚","text":"斑斑心点紫，叠叠萼承冰。\n除却横枝韵，群芳尽与能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酴醾四首 其一","author":"刘子翚","text":"蒙笼春幰顶，夭矫赤虬身。\n雨蓓犹缄暖，精神照晚春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王岩起乐斋三首 其三","author":"刘子翚","text":"我亦云根结小房，年来与世略相忘。\n定知可蜕纷华事，不及弦歌气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王岩起乐斋三首 其二","author":"刘子翚","text":"怪底愁端生不已，劳心逐事事无穷。\n陶然一点冲融趣，只在清虚淡泊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王岩起乐斋三首 其一","author":"刘子翚","text":"数丛修竹拥斋居，兴味翛然乐有馀。\n午枕睡酣窗寂寂，清风来去自翻书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石井二首 其二","author":"刘子翚","text":"道经兰若偶停鞭，客里逢幽意惘然。\n一把绿萝蒙石窦，梦魂翻愤醒心泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石井二首 其一","author":"刘子翚","text":"玲珑岩穴巧如刳，中贮沧浪百斛馀。\n衰懒自怜游世久，襟怀未及汝常虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵鹫窗","author":"刘子翚","text":"翠合初疑无路往，停鞭邂逅成清赏。\n僧炉坐稳纸窗明，细雨忽来山竹响。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橙子四首 其二","author":"刘子翚","text":"橙齑细缕风韵胜，我不痛饮那知音。\n何如金丸走衾枕，三月梦游薝卜林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕子","author":"刘子翚","text":"燕子营巢得所依，衔泥辛苦傍人飞。\n秋风一夜惊桐叶，不恋雕梁万里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠总上人兼简无求居士二首 其二","author":"刘子翚","text":"多谢徽州吴使君，新诗问劳意何勤。\n无求已得心空乐，更作无心出岫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠总上人兼简无求居士二首 其一","author":"刘子翚","text":"双径山中一衲衣，曳筇远远叩岩扉。\n愧无白璧黄金赠，携取清风满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日登北山","author":"刘子翚","text":"戏马英雄安在哉，閒因九日上崔嵬。\n步穷岩壑身忘倦，望尽乾坤意始开。\n已向晚风伴落帽，可无新菊共浮杯。\n佳时及早须行乐，老境侵人咄咄来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与原仲至交溪桥","author":"刘子翚","text":"倦憩春桥午，回环翠碧重。\n乱溪流背海，新柳色欺松。\n厌市常思野，为官不及农。\n喜逢湖上客，谈话得从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]