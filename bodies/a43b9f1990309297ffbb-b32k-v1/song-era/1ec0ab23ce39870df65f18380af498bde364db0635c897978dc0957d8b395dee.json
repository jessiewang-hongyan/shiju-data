[{"title":"寄题竞秀亭 其二","author":"朱翌","text":"来往人传客寝安，问渠何事驻征鞍。\n只应门外千山好，能使胸中百念宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题竞秀亭 其一","author":"朱翌","text":"吴山越岭老于行，何地诛茅寄此情。\n直使浮云无一点，千岩应接始分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"朱翌","text":"姑射山头冰雪仙，人间一见便丰年。\n却应羞死琴台女，不得乃翁分一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿萼梅","author":"朱翌","text":"不肯雷同自一家，青裙独立水之涯。\n只应夜过许长史，全似当年萼绿华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪见羞","author":"朱翌","text":"白如白雪复何加，岂有寒英胜六花。\n真是岭南稀见雪，花光胜雪喜无差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪霁捕鱼图","author":"朱翌","text":"群鱼何日举舟师，玉海瑶山欲霁时。\n正是严冬当设脍，老翁香饭必先炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠崇芦雁","author":"朱翌","text":"我是江湖一漫郎，鸿飞鹭宿见行藏。\n西风吹尽芦花雪，水驿云程未易量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠杨梅","author":"朱翌","text":"杭州金氏越州楞，撒火飞星五月春。\n百果若重推贡士，风流应不下平津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢谭南恩寄六目龟","author":"朱翌","text":"无了禅师斸草莱，清江使者六眸开。\n我今筑屋虚空里，亦复蹒跚出海来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡轩三首 其三","author":"朱翌","text":"风和日永饱食已，雨急天寒户不开。\n遇此佳时无一事，支床高枕听咍台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡轩三首 其二","author":"朱翌","text":"诸公对奕我高眠，此法非人不可传。\n四脚棋槃皆黑子，孝先从此便争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡轩三首 其一","author":"朱翌","text":"意马心猿不用忙，睡乡深处解行装。\n华山闻有希夷子，安得斯人与对床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡倅羔羊斋 其二","author":"朱翌","text":"尽输精白承休德，政用诗书造太平。\n略为周家推在位，太颠闳夭散宜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山谷姚黄梅花","author":"朱翌","text":"姚花富贵江梅妙，俱是花中第一流。\n戏出小诗花一样，先生下笔与春谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李成山水","author":"朱翌","text":"好山谁定识真形，著白山人眼最亲。\n半夜忽闻遭有力，中书君召主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题搓线图","author":"朱翌","text":"谁言粉白但闲居，纫补尚烦金十奴。\n治得棼丝有条理，却嫌红女未工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题程干燕公山水","author":"朱翌","text":"电眼观山老更真，能分天造一层层。\n直须擘华尊瀛手，始解铺张入剡藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕后一日诸公携酒见过","author":"朱翌","text":"昨夜天孙拥翠軿，馀光犹此照河津。\n且欣大暑去酷吏，更辱诸君为主人。\n庭桂酿花香有信，盆荷迎露绿长新。\n浮云扫尽天无滓，仰面争看月半轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月一日夜坐观星","author":"朱翌","text":"半夜凉生过雨初，起迎秋色扫庭除。\n西牛东女经年会，北客南风一笑疏。\n乾鹊悲鸣桥渡汉，龙泉腾跃气凌虚。\n盆池水面萤飞过，上下天星总一如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十三夜与张检法泛武溪","author":"朱翌","text":"川净波平五板舟，天开地辟一轮秋。\n白银国放黄金色，宫锦袍添紫绮裘。\n坐久星河挂璎珞，夜深风露走珠旒。\n人间意适须乘兴，我是闲人更自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月十四日立冬菊花方盛","author":"朱翌","text":"黄菊一何好，持觞惟尔从。\n名应称晚秀，色岂为人容。\n正似花重九，休论月孟冬。\n霜威占清晓，直欲犯其锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万竹亭","author":"朱翌","text":"气禀元轩玉立身，露幛烟纛晓初匀。\n一时顿有七贤集，千亩今馀万个春。\n能以风流誇后日，政缘名篆得斯人。\n寂寥不见平安报，只有东风为扫尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月五日游刘光世园","author":"朱翌","text":"南高峰下访馀春，霁草浮光暖更薰。\n日转暮山添著色，风旋湖水作回纹。\n飘零大士天花雨，惊顾将军画栋云。\n兴尽不须呼曲友，他时来饭一瓯芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三衢胡定悯祠诗","author":"朱翌","text":"把酒论诗建业城，三年金石见交情。\n罗池忽待中流泊，姑蔑应无剧雨倾。\n直道岂知人负我，英姿如在死犹生。\n炉香销尽丛祠晚，独对西风泪臆横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与罗教授饭园中种栀子","author":"朱翌","text":"园木交阴正可观，壶觞随分却成欢。\n绿钱流地雨当足，飞絮暖空春不寒。\n雪缀酴醾缘屋角，香移薝卜近栏干。\n与君细说炉亭话，强对槟榔蒌菜槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与郭侯饮园中","author":"朱翌","text":"秾李晨兴著缟裙，酴醾首出上瑶簪。\n此时老子兴不浅，旦日将军幸早临。\n敌手对棋消昼永，中心闻射隔墙阴。\n春生夜瓮蓬莱绿，酌我无多劝客深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与钱端修诸公饮兴福","author":"朱翌","text":"积阴解尽可信眉，梵宇仍容款扣扉。\n山净且无尘一点，湖平惟有鹭双飞。\n杯行客恶思传令，劫急棋争看解围。\n招隐不知谁好事，为寻幽处著渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大历寺遇风","author":"朱翌","text":"舟绝清江系老榕，杖藜小住翠阴中。\n萦青缭白千山日，骇绿纷红万窍风。\n足倦要休怜地僻，心闲无事见春工。\n回塘大有田田叶，索酒来倾碧玉筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋示潘子贱","author":"朱昱","text":"云彻通明殿，风涵白玉楼。\n幽人当此夜，满意作中秋。\n念念何曾问，尘尘自不收。\n羁怀忽冰释，天地一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"朱翌","text":"春来何事可相关，拨置书丛得少闲。\n洗砚谛观鸲鹆眼，焚香仍拣鹧鸪斑。\n花开北陌东阡外，人在朝三暮四间。\n俯仰乾坤了无愧，心如枯蘖更谁删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以灵寿杖寄汪内翰","author":"朱翌","text":"一枝灵木坚多节，千里逢人寄永州。\n赐出汉宫尊子夏，封当大县庆邳侯。\n衡山云散迎归骑，湘浦春晴更顺流。\n欲往从公无羽翼，请携上座别愚丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日会凌季文家","author":"朱翌","text":"柏叶椒盘巧试新，大呼珠履集华茵。\n香醪满劝橘为盏，红烛未消梅写真。\n荔子双头归有遗，天花六出静无尘。\n稍晴便合西湖去，寻遍山房洞户春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日登城","author":"朱翌","text":"第一逢春管物华，率先桃李被褒嘉。\n明朝又数日为狗，回首犹惊岁在蛇。\n香聚椒槃萦綵字，春生茶碗结琼花。\n层城独秀东风里，下瞰川流脉脉斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十五日西湖宿斋","author":"朱翌","text":"并湖西去望南屏，但见烟云日日新。\n山色渐争秋气势，荷花全露晓精神。\n洗心用此无边绿，处世端能不染尘。\n惭愧西湖敦夙夜，从今长作境中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"分水县舍夜遇大雪","author":"朱翌","text":"挥扇解衣真早计，果然一夕变春阴。\n屋头瓦裂风掀户，愧上珠跳雪满衾。\n我自不妨高枕卧，人今更有惜花心。\n此行特地非乘兴，明日扁舟兴亦深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方竹杖","author":"朱翌","text":"此君骨相一成矩，气禀坤爻六二全。\n运用四方随手转，操持一节比松坚。\n玉雕界尺疑同样，金作觚棱笑削圆。\n见寄分司真得力，时将缓步与周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更不睡","author":"朱翌","text":"擂罢城头鼓，膏凝烛下槃。\n窗留三尺月，纩挟五更寒。\n事事华巾结，年年纸帐宽。\n梅花正好在，青女莫摧残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邓提举留诗南华予后五日入山次韵","author":"朱翌","text":"有句谁知李似阴，好奇仍许杜犹岑。\n后期五日来圯下，面壁九年参少林。\n瘴鬼安能惊鹤众，地灵何敢著狐任。\n雷车电炽中宵起，看取龙工济物心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙辰人日雨雪","author":"朱翌","text":"此地从来僻，今朝自古阴。\n五年犹作客，一饭敢虚襟。\n春色岂终閟，晨光宜早临。\n国香无恙否，抱雪秀深林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙寅十月游南华","author":"朱翌","text":"五年四转入曹溪，飞盖干霄日为低。\n人定忽闻钟不嗄，饮香休问水流西。\n桄榔子熟旒珠重，豆蔻丛深扇羽齐。\n郁郁苍苍千嶂里，犯寒犹著一蝉嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东津送方务德","author":"朱翌","text":"一年痴雨令人瘦，三日佳晴送子回。\n何以赠之青玉案，我姑酌彼黄金罍。\n寻春出郭非聊尔，下水行舟亦快哉。\n小试平生钓鱼手，老夫合住子陵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后三日与罗楚入倅厅两松下梅花盛开取酒酌石台上思得名手作松梅图 其一","author":"朱翌","text":"老松鳞甲待拿云，俯视梅花意亦亲。\n粉色上参冬岭秀，虬枝下挽越溪真。\n乘闲到此能终日，与我来游尽可人。\n今代华光古韦毕，生绡一幅两传神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后三日与罗楚入倅厅两松下梅花盛开取酒酌石台上思得名手作松梅图 其二","author":"朱翌","text":"匆匆前日贺书云，那似今朝笑语亲。\n年例一来窥雪样，岁寒同此见天真。\n梅间蜂阵长围日，松下鸱蹲反嚇人。\n一碗檑茶未忘本，三杯薄酒不能神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后雪夜","author":"朱翌","text":"腊前梅蕊未斜横，至后醅香试满觥。\n过眼文书开数叶，打窗风雨又三更。\n闭门高卧直差易，拥鼻微吟何似生。\n稍取湿薪供热弄，住山如此不多争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬前雪珠夜下早闻远山皆白","author":"朱翌","text":"夜深真可覆三毡，地僻何因致八绵。\n五岭盛传非昔日，一寒如此怪今年。\n固知渊客难藏宝，倒卷珠池立散天。\n日下有丹能变白，青山休恨早华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城","author":"朱翌","text":"少策经营饱，多方处置闲。\n樵谈消一日，野坐看千山。\n白鹭远飞去，微云时复还。\n展开新乐地，攻破旧愁关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归去来围南邻刘家菜圃近许辟路相通","author":"朱翌","text":"假道趋南浦，排墙度小沟。\n仙人中谪李，邻里外依刘。\n良友经时集，清贫觉我优。\n槟榔初不设，佳茗或相投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自南华诗","author":"朱翌","text":"众绿扬新楚，初晴中薄寒。\n行山无阔步，陟巘有遐观。\n蕨紫拳犹小，松黄粉渐乾。\n无嫌一马瘦，径度两重滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊辰元日到南华诗","author":"朱翌","text":"清晓匆匆贺岁归，又随微雨渡曹溪。\n祷晴愿见五色羽，揭户方占一日鸡。\n沙水半摇新略彴，云烟深护古伽黎。\n曹源激水仍过颡，桃李无言下有蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十日过江氏园","author":"朱翌","text":"宛宛桥虹卧碧涟，深深古屋背长川。\n园官送菜无虚日，溪友留鱼不问钱。\n历数旧交俱老矣，及时行乐且欣然。\n梅花更有黄千叶，携取一杯花下传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十四日西湖留别同舍","author":"朱翌","text":"背淮辕楚过三吴，铁轴膏轮每疾驱。\n千里未能归北客，一觞来此别西湖。\n门门灯火动今夜，步步溪山迎故吾。\n明日归潮君看取，浪花堆里啸樯乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示叶令","author":"朱翌","text":"舟楫三吴客，江湖二月寒。\n交情元自淡，酒味莫嫌酸。\n日者坐何事，君乎能自宽。\n不来同一醉，何以解忧端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示同会","author":"朱翌","text":"无奈春寒老不禁，喜看晴日上窗棂。\n群花半露乾坤巧，百刻平分昼夜停。\n拄杖有时挑菜甲，桔槔无复问畦丁。\n逢春不出何为者，众醉谁知可独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示江子我","author":"朱昱","text":"蝇营狗苟祇贻羞，万事何能著意求。\n自此闭门从所好，不妨高枕得无忧。\n经年不濯子春足，半月才梳叔夜头。\n此味肯教儿辈觉，诵书声里卧黄紬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示张子昭","author":"朱昱","text":"西日未收东雨来，南轩相对北窗开。\n茫茫移穴蚁旋磨，扰扰出檐蚊聚雷。\n三宿定成桑下恋，一篇聊向雨中催。\n忘形赖有张公子，信手围棋到夜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示李令","author":"朱翌","text":"春色遽如许，春愁无柰何。\n看山连楚越，端坐惜羲娥。\n吾子频相见，新诗苦未多。\n试穿一两屐，从我上烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立夏前一日登马氏山亭","author":"朱翌","text":"百忧不到酒三行，万事尽休棋一枰。\n梅子未黄先著雨，樱桃欲熟正防莺。\n忽惊夏向明朝立，便恐春从此地更。\n数蝶飞来花寂寞，乱蛙鸣处水纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙山送客","author":"朱翌","text":"茸茸风草弄春柔，密密桑阴向绿稠。\n江上星居多草阁，波间斗转一渔舟。\n吾行适此心无事，客去何妨刺漫留。\n尚戒奚奴休叱驭，不辞小住看潮头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华干携茶入园晚坐柔桑下","author":"朱翌","text":"光穿两脚间彤霞，声急城头集暮鸦。\n且与凤雏桑下坐，共烹龙焙雨前茶。\n的中薏嫩莲新采，笋上竿成竹已斜。\n读得齐民书熟烂，把锄今作老生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同郭侯僧仲晚至武溪亭议真率会","author":"朱翌","text":"平远寒林暮霭横，右丞不死毕韦生。\n八人过处草齐绿，一日去来花笑迎。\n衲子自知空是色，将军要使酒犹兵。\n尺书相与盟真率，岭海风流似洛京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后两日叶干携酒","author":"朱翌","text":"喜君酾酒吸鲸空，置我飞云卷雾中。\n蒲鸽青浮初落蒂，冰蚕茧就旋开篷。\n小凉已觉生衣怯，短策能寻熟路通。\n直上高台延望眼，万山横浸一溪东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"地僻","author":"朱翌","text":"地僻门常闭，家贫客自疏。\n溪山行老我，风月不欺予。\n谩有书成诵，端无货可居。\n清江千里道，持此问舂锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏同诸子书所见","author":"朱翌","text":"已老犹痴作蠹鱼，出门延望立须臾。\n或深或浅花先后，半霁半阴云有无。\n山月向人俱引领，海风无日不嘘枯。\n论诗各尽诸郎意，篱落之中自可娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏事","author":"朱翌","text":"相逢多戏事，聊以度长年。\n间出诗联句，时因酒合钱。\n歌狂无所择，棋胜亦欣然。\n龌龊好苛礼，逡巡不敢前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有惠益母粉及当归者","author":"朱翌","text":"多病年来叹早衰，试凭草木为扶微。\n关心药裹知多少，系肘方书识是非。\n曾子定应怜益母，曹公端解寄当归。\n从今洗面饶光泽，血气仍充旧带围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有惠曾公逍遥楼字者","author":"朱翌","text":"蒲阪今灰烬，兹楼亦草莱。\n如何三字大，却到百蛮开。\n屋漏真能尔，霜严可畏哉。\n置之当座右，亲手拂尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘美中早朝","author":"朱翌","text":"凤凰山下凤凰城，辇路凌霄溯紫清。\n秋入九天风露冷，云藏五玉佩环声。\n虞渊出日升黄道，织女斜河转启明。\n郁郁安能久居此，君王有意待还京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵江子我病起","author":"朱翌","text":"食不下咽当奈何，千金不惜聘秦和。\n则知有我聊示病，旁若无人正浩歌。\n薄雨过墙醒槛竹，西风吹暑下庭柯。\n但令一局消长日，且乐眼前休问他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]