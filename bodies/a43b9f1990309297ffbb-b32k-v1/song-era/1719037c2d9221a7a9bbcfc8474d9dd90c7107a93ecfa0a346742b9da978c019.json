[{"title":"和李雁湖晚春即事八首 其一","author":"吴泳","text":"琴书澹泊古羲轩，花木幽閒汉绮园。\n碧落青嵩无用买，湖光一曲道真浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江赋梅 其二","author":"吴泳","text":"衣分冰洁佩琼瑰，笑敛溪头月下杯。\n岁晏得朋真乐在，不须青女作行媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洪司令梅花 其一","author":"吴泳","text":"结绮临春贮丽华，吹香偶到野人家。\n霜明月白纱窗净，但见梅诗不见花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洪司令梅花 其二","author":"吴泳","text":"杼云新卷雪泥乾，剪剪轻风薄薄寒。\n莫遣水龙吹别调，放教春在玉栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江赋梅 其八","author":"吴泳","text":"交花煜煜露生香，一味清来浣我肠。\n文字语言今落去，聊吹别调作醒狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江赋梅 其四","author":"吴泳","text":"每对梅花辄解颜，瑶林孤绝迥难攀。\n拟将和靖横枝句，搂入离骚大小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江赋梅 其七","author":"吴泳","text":"不御铅华别是花，丰神高洁自成家。\n含章不解春风意，犹倚残妆隔绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江赋梅 其三","author":"吴泳","text":"青蒲翠草望秋零，乱絮迷春困不醒。\n林下水边时一见，对人应是眼中青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其七","author":"吴泳","text":"酒灯棋雨忆昏黄，那得佳朋话此肠。\n豪气已随烟柳折，未能除得作诗狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其六","author":"吴泳","text":"官事无穷类海潮，寸肠忍使自煎炮。\n橐驼种树安心法，且并閒功子细抄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其五","author":"吴泳","text":"檐花夜落晓还晴，应为农祥一展颦。\n惭愧青裙南亩妇，犁头能得几多春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其四","author":"吴泳","text":"花含别墅无边思，水放长渠自在流。\n别是一般閒富贵，田家那肯让公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其三","author":"吴泳","text":"野寺藏春不一奇，静机还有动机随。\n幽寻往往行终日，未信东风属酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其二","author":"吴泳","text":"梅事匆匆半雨残，李妆羞涩尚春寒。\n人情只道花时好，花未开时正耐看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果山春郊即事七首 其一","author":"吴泳","text":"晴岚扑扑染人衣，和意溶溶接岸陲。\n春事平铺都放着，不应祇认小桃枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂","author":"吴泳","text":"团团玉叶振天芳，清澈琼楼午夜光。\n元是小山分种去，移来西蜀作甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中宿白水","author":"吴泳","text":"触热山行陡顿馀，急携拄杖息禅居。\n老僧不惜山中宝，持出银函贝叶书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其七","author":"吴泳","text":"暧暧人村翠树连，莺拖野色度晴川。\n新诗无限来供眼，才涉思量又不圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其四","author":"吴泳","text":"雨脚垂垂未肯休，舍东流满舍西流。\n八分春种胚胎了，新水才来便彻头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其八","author":"吴泳","text":"醉骑花影少年间，谑弄风光古将坛。\n渐觉年来无补益，祇将春贮在脾肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其十","author":"吴泳","text":"旧谷才登幼妇场，新蚕复出小姑忙。\n书生却弄閒针线，枉学明河织女襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其二","author":"吴泳","text":"无穷官事日装怀，甫及芳时略放开。\n骚仆编排诗社去，酪奴勾管醉乡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其三","author":"吴泳","text":"后霜庭草芳犹茁，承露林花翠欲攲。\n体认乾元何处是，初春天气早晨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其一","author":"吴泳","text":"去年春日百花斑，今岁逢春万竹间。\n花靓竹香宜细看，春风不会一朝閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其九","author":"吴泳","text":"素丝五緎咏羔羊，且是公馀燕日长。\n黄妳味甘逢孔圣，黑甜睡美谒羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郫县春日吟 其五","author":"吴泳","text":"不寒不暖杏花天，争看蚕丛古寺边。\n旧日尚留耕雨具，新年难得买花钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琵琶","author":"吴泳","text":"锦调巴音祇四弦，倚门空抱向谁怜。\n主人一自知音后，传入王孙绮玳筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登罗浮山 其三","author":"吴泳","text":"玉蟾奔月灶炉乾，老鹤巢松殿宇寒。\n里面看山山不见，不如只向外边看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登罗浮山 其二","author":"吴泳","text":"海山半夜失蓬莱，微带云根雨脚来。\n元是道家清绝境，世间妄指作阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登罗浮山 其一","author":"吴泳","text":"要閒终是不曾閒，猛歇当头名利关。\n揩洗一双清净眼，稻花雨里看浮山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙未恭和御制闻喜宴诗","author":"吴泳","text":"圣学希天善牖民，风霆鼓舞气如神。\n转回姚姒文章古，作起殷周礼乐新。\n有限科名非究竟，无穷经术要纷纶。\n事君自昔无他道，不有其身是致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和洪司令春日","author":"吴泳","text":"房湖曾别苦吟身，两度东风似一尘。\n柳外游丝难系日，麦边驯雉亦惊春。\n玄都君子皆通贵，栗里先生祇一贫。\n珍重龙阳贤太守，时将诗句恼陈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰恭和御制闻喜宴诗","author":"吴泳","text":"清问谆谆许尽言，以书为辙道为轩。\n鉴观万古知成法，条析群疑见大原。\n樱苑近颁天上句，燕杯新带雨边恩。\n燃藜夜取云章读，照乘骊珠炳若存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王巽堂三十年不到湖亭丙戌春再来非旧矣用前韵以俟后游","author":"吴泳","text":"庭院深深锁绿苔，扫花无帚半尘埃。\n红霞满树刘郎去，青子垂枝杜牧来。\n乍可放閒宽酒地，不能随俗贮香材。\n醉翁自有山间乐，更取林霏手斫开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日","author":"吴泳","text":"四时平似准，冬日颇伤暄。\n暖骤狂花坼，霜轻野草繁。\n林鸢饥跕水，山鬼暗窥垣。\n便拟悬车计，无人为买园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至","author":"吴泳","text":"閒居罕人事，慵把历头开。\n雷自地中复，风从天末来。\n絪缊初熟酒，的皪未开梅。\n道尽真光景，尧夫好秀才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出关","author":"吴泳","text":"晓带鸡星出，春从鸟道餐。\n雾漫旗彩坏，霜落剑花寒。\n天险今虽在，人谋昔所难。\n临关能虎视，一亮亢曹瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊怀汪尚中代简","author":"吴泳","text":"一春烟雨尽愁端，晴日郊行尚怕寒。\n芳草被堤风信过，杂英满甸雪泥乾。\n刘郎去后花无恙，杜牧来迟春渐阑。\n明日为君开社瓮，莫教人倚玉栏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永嘉鹿鸣宴","author":"吴泳","text":"人间富贵易浮沈，只有斯文无古今。\n义理工夫元坦易，圣贤言语不艰深。\n莫随近世诸儒辙，要识开山一祖心。\n待得了他科举债，梅花月下听瑶琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵谢帅机惠春盘","author":"吴泳","text":"梅柳阴中漫寄家，閒如翠鸨立晴沙。\n瘿藤樽内抄松子，行玉槃中拣蕨芽。\n犹有乡风餐白啖，更无春梦草黄麻。\n郊行莫待芳菲月，花未开时好看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送成都添倅李微之分韵得巫字","author":"吴泳","text":"本住陵阳处士庐，不妨名字落青都。\n题舆带阁添新号，抱史还山只故吾。\n秀水稳宜眠夏簟，惠泉香可煮秋菰。\n劝君莫动骚人曲，椰叶蓪花降女巫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老将","author":"吴泳","text":"一从十五长边城，少见兵戈日太平。\n代马依风都护道，飞鸢熏雾伏波营。\n红雕腊软君王赐，青兕裘轻子女情。\n昨夜点行新部曲，铁衣偏奏苦寒声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日示诸甥侄","author":"吴泳","text":"莫风浩荡忽吹葭，一室阳春病已差。\n把酒认为天一水，见梅题作玉真花。\n燕常会族宁随俭，祭则从先不尚华。\n过此肥冬疆事静，亦呼槃也早还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿史石泉二首 其二","author":"吴泳","text":"露洗秋容一片清，远山高与雪争明。\n贤侯元是岳神降，上相先从佛腊生。\n画戟不妨当燕寝，白囊无复到鸡城。\n新来连日西郊雨，还作山间小太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿史石泉二首 其一","author":"吴泳","text":"胸次玻瓈湛不摇，高风炯炯揭冰条。\n昆墟已泻南轩派，蜀贡犹传北斗杓。\n问学有源天一水，文章无尽海门潮。\n三滩五渡多人物，难得公家月指标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿丞相庆七十五首 其四","author":"吴泳","text":"诞日逢今日，新年胜故年。\n良风宜望岁，甲雨不妨田。\n浙米多堪籴，京交渐直钱。\n隆兴须再见，人道鲁公贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿丞相庆七十五首 其三","author":"吴泳","text":"渤海兵戈静，全淮版籍归。\n红缫蚕茧大，紫擘蟹螯肥。\n柳港添生色，榆关閟杀机。\n君王新御殿，莫使谏书稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿丞相庆七十五首 其二","author":"吴泳","text":"昨夜闻宣锁，虚皇注意深。\n三师分汉制，一尺泻商霖。\n未白忧边发，仍丹报国心。\n黄封留寿酒，且把斗杓斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿安宣相 其一","author":"吴泳","text":"皛然老子本冲夷，起为苍生护北陲。\n边吏皆能问司马，市人曾不识安期。\n拊摩鲐背应耆艾，舒卷龙韬自崛奇。\n九老图中张白后，合添同甲一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿安宣相 其三","author":"吴泳","text":"上谓无官可报卿，延登左棘倍恩荣。\n勋存社稷身俱泰，志在生灵物转轻。\n平蜀以前谁磊落，渡江而后独光明。\n蚤令不作湘潭梦，料得中原已扫清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿张亨泉提刑三首 其三","author":"吴泳","text":"末学纷纷竞为人，公能康济自家身。\n形躯元备人间世，肝肺尽收天下春。\n观我自应知爱重，识心须会起经纶。\n寿觥难著皇华语，抱取峨眉月半轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿张亨泉提刑三首 其二","author":"吴泳","text":"二年烟雨汉皋亭，玉节西来照雪明。\n慷慨报君浑是胆，驰驱将母莫非诚。\n稻禾水足青畴润，烽火宵閒紫逻清。\n鸾凤莫将鹰隼看，及时须为国家鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿张亨泉提刑三首 其一","author":"吴泳","text":"莲花峰下发源深，胸次渟涵几古今。\n事苟及民须著手，文非为道不关心。\n扶持世界归儒效，转斡天机自笔箴。\n主静工夫人不识，火阳五月正根阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿李雁湖 其三","author":"吴泳","text":"起从通德里，出守巽岩州。\n上相先声到，凶徒悍气柔。\n鸿居新劳徕，鸟户旧绸缪。\n已筑沙堤路，归欤赞大猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿李雁湖 其三","author":"吴泳","text":"汹汹风涛卒未清，便提小队按行营。\n一言刑省朝歌盗，单骑恩怀渤海兵。\n丰德自应通绿籍，长年何必饭黄精。\n劝公剩压兰英酒，为作涪川小太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿李雁湖 其二","author":"吴泳","text":"往在黄枢府，璇题护两扉。\n剪除当路棘，纫补坐朝衣。\n风急操舟济，江空掷钓归。\n年年湖上雁，旭旦望南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿李雁湖 其四","author":"吴泳","text":"身驾青牛老子车，行云来去自纾徐。\n精神健好充黄野，骨法清真贯玉庐。\n六十二年康节咏，五千馀卷玉川书。\n石林莫作盘居计，黄纸看看又诏除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿李雁湖 其一","author":"吴泳","text":"当年指李记生辰，柱史疑为法报身。\n鱼鸟泳飞南阁晓，风花经纬石林春。\n手翻万轴谈无底，胸著千年汲愈新。\n试看乔松霜雪后，凛然一节照时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿李雁湖 其二","author":"吴泳","text":"自卷朝衣濯雁湖，勋名籍籍在黄枢。\n时闻走卒称司马，犹有群儿问大苏。\n赴陇尺书驰鹤板，起家万石绾麟符。\n宵衣炯炯思黄发，正藉元勋出手扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿邹都大 其二","author":"吴泳","text":"易言来复甚昭昭，须识阴阳动静交。\n乾德众贤当首画，建炎诸老得中爻。\n水波已动龙难蛰，时运方清凤合巢。\n会得生生无尽意，不须詹尹揲琼茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿邹都大 其三","author":"吴泳","text":"梅花又是隔年看，节节光明雪照山。\n赤蚁玄蜂边徼外，黄鸡白黍野田间。\n鹄头久已书丹版，燕额仍须护玉关。\n独有檀沈烟一穟，明年还绕属车斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿邹都大 其一","author":"吴泳","text":"石虹缭绕气如云，中有胎仙字卯神。\n大宅宽平春满面，一条瑩彻玉为人。\n细看火后交梨熟，不及霜中硕果新。\n六十二年无一事，尧夫端的是前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿邹都大 其四","author":"吴泳","text":"嶰竹吹香子气分，苍苍有意瑞斯文。\n已从嵩岳生申伯，复向西山寿卯君。\n鲐背自宜当职任，虎头曾已策功勋。\n壶中日月春长在，且试犀沈一瓣薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿周提刑二首 其二","author":"吴泳","text":"自乞银符守汉嘉，就持汉节问梅花。\n庭扉讼少閒徽棘，堰水流多沤纻麻。\n论击回邪羝触角，化销彊暴鼠无牙。\n更看植杖扶犁叟，清议依前说使家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿周提刑二首 其一","author":"吴泳","text":"分得濂溪一派清，皇皇仁义不贪名。\n金华学道行持到，禹穴题舆去就轻。\n一节以趋何简易，十年不调转光明。\n匡时富有经纶在，若木华边缓辔行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范洁斋 其一","author":"吴泳","text":"合下金相气质浑，更参诸老遍宗门。\n箕山再得颜回婿，荣国还生孔子孙。\n学问不趋岐路径，文章祇好古罍尊。\n至今尚得诗书力，一气清明中夜存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范洁斋 其三","author":"吴泳","text":"泸水风涛七载还，今年赢得在家山。\n临流领客清溪上，滴露抄书翠竹间。\n晚计作堂应未晚，閒居成赋恐难閒。\n云昏八表边烽息，须得伊人护玉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范洁斋 其二","author":"吴泳","text":"青袍朝士走红尘，公独纫兰结佩绅。\n不事王侯嫌炙手，岂除御史更呈身。\n寒花秋后看名节，乔木霜中见本真。\n吾道天宽连地大，羊沟那得系麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范洁斋 其四","author":"吴泳","text":"忆昨薰风会面时，犹龙老子亶冲夷。\n忠文晚节三年过，上相生辰十日迟。\n内景两篇时点检，中庸一卷晓行持。\n朝来泮水鸮音好，目注西山拟寿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范漕 其四","author":"吴泳","text":"福星一点夜堂深，藻泮花泉共照临。\n歌咏春风曾点瑟，体当生意宓君琴。\n乔松已作参天色，寸草犹持报主心。\n但翼斯文扶寿脉，年年一穗爇犀沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]