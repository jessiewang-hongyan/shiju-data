[{"title":"端午即事","author":"谢薖","text":"卯饮缘佳节，昌阳荐一卮。\n儿咨射团事，妻诵赐衣诗。\n懒检三闾传，争缠五綵丝。\n平生几端午，随分作儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书李元亮真牧堂赋后","author":"谢薖","text":"挥翰眼中元亮，牧牛何处癯仙。\n公择如今不泯，当家诸子俱贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈阳树石二首 其一","author":"谢薖","text":"寒藤骨数百尺，枯木大七八围。\n挽取到公奇石，俱还数幅寒溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈阳树石二首 其二","author":"谢薖","text":"解写枯松润石，陈阳笔意名家。\n弟子蔡规今老，古人王宰何加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭汪信民二首 其一","author":"谢薖","text":"竟欲游梁苑，聊甘食楚萍。\n谈经谢纨裤，植发愬槐庭。\n着镜鬓毛改，横空烟雾冥。\n谁评贞曜谥，更谒退之铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭汪信民二首 其二","author":"谢薖","text":"徐稚生何陋，袁宏辈岂如。\n谁知十斛水，中有百金鱼。\n肘见贫非病，疽成愤不摅。\n铭旌返南国，寥落正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杞菊","author":"谢薖","text":"雨洗幽丛清客襟，厨人采掇独何心。\n根苗扶老或名杖，蓓蕾舒黄无数金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"络纬","author":"谢薖","text":"聒人长向井边啼，在宇丁宁戒授衣。\n织素尽输官事了，秋来工女正投机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倦夜","author":"谢薖","text":"山月斜临帐，山风细拂裳。\n萧萧碧烟静，炯炯白间凉。\n境寂万缘息，心灰千虑亡。\n无端催曙鸟，底事厌宵长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜董之南归","author":"谢薖","text":"乾鹊飞翻噪晚林，阿南归骑果骎骎。\n青衫黄绶沾新命，白石清泉是素心。\n金镊多情洗双鬓，葛巾从此避华簪。\n来年往献东巡颂，今日聊为梁父吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":65000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀祥首座","author":"谢薖","text":"师在羌庐西复东，无心还似鸟飞空。\n月钩云幕今何处，禅板蒲团只眼中。\n未悟竹间鸣瓦砾，拟随童子问铃风。\n前身倘是胡居士，打破虚空对沼公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李商老兼简文若季弓","author":"谢薖","text":"有客春来传尺书，书词字字敌琼琚。\n经时伏枕沉绵甚，异县论交消息疏。\n物外高情想三凤，眼中何物当双鱼。\n遥知小弟凄凉意，骑省归来正望庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昼卧二首 其一","author":"谢薖","text":"书魔才挽睡魔推，鼻息俄惊吼怒雷。\n梦到逍遥大庭馆，不堪檐外鸟惊回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昼卧二首 其二","author":"谢薖","text":"剥剥啄啄无俗客，清清泠泠多好风。\n一枕本无忧乐累，何须游宦大槐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青精饭三首 其一","author":"谢薖","text":"霍山王邓两真隐，驾鹤乘云飞九天。\n当时服饵定何物，同饭青精三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青精饭三首 其二","author":"谢薖","text":"从来见说青精饭，晚遇真人隐诀中。\n长恨闻名不相识，那知俚俗号乌桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青精饭三首 其三","author":"谢薖","text":"南人虽号乌桐饭，过熟翻成作淖糜。\n太极真人方未试，茅山道士寄何迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送酒与晏如居士二首 其一","author":"谢薖","text":"南人酿酒诧深红，注瓦真成琥珀浓。\n与药相投莫宜此，急分多病晏如翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":8,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送酒与晏如居士二首 其二","author":"谢薖","text":"此翁宁把春偿酒，醉插姚黄更乞花。\n多病只今犹解饮，细倾聊为遣生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":9,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示李商老兄弟","author":"谢薖","text":"月夜宜披宫锦袍，定知公辈岂蓬蒿。\n文如修水波澜阔，人与庐山意气高。\n伯氏最于三虎怒，凡儿何翅九牛毛。\n相逢径欲倒家酿，莫厌尊前持蟹螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":10,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日游南湖","author":"谢薖","text":"曲尘裙与草争绿，象鼻筒轻琼作杯。\n可惜小舟横两桨，无人催送莫愁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏金来禽","author":"谢薖","text":"枝上离离金弹丸，宜随玉食荐金盘。\n从来物以远为贵，酷爱闽中荔子丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":12,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀","author":"谢薖","text":"赖有书遮眼，初无客就谈。\n身閒唯取醉，发短仅胜簪。\n学僻今何用，囊空宝不贪。\n老师行驻锡，准拟问前三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次李商老端字韵","author":"谢薖","text":"胸中磊磊夜光寒，霹雳惊飞在舌端。\n梦去幽寻绕山麓，诗来喜色上门阑。\n四时更运不停轨，万物并流皆疾湍。\n两鬓凋零壮心在，忍穷怀抱若为宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":14,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招汪叔野","author":"谢薖","text":"夜语僧窗雪载涂，别来夏木又扶疏。\n两牛鸣处地非远，万竹阴边吾所庐。\n儿能窃听从忘簟，子盍徐行可当车。\n莫讶南邻狂处士，掺挝倾坐一轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"投赠通守陈虚中","author":"谢薖","text":"前驱负弩旆旌忙，凛凛寒风挟晓霜。\n人道奸藏有三穴，公知民病极千疮。\n摇毫端是霹雳手，抵几还惊凫鹜行。\n莫向琳宫坐閒冷，太阿何事匣中藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚晴步塘上","author":"谢薖","text":"漫踏斜阳堤上行，偶逢白叟问年登。\n去年禾乾龟兆拆，今年雨多禾耳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸣鸠","author":"谢薖","text":"云阴解尽却残晖，屋上鸣鸠唤妇归。\n不见池塘烟雨里，鸳鸯相并湿红衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻吕居仁病未差觅使寄问","author":"谢薖","text":"消渴文园苦病多，萧条子美卧江沱。\n士穷不遇古如此，天实欲为人谓何。\n忠义名家本申许，文章秀气望岷峨。\n期君鍊玉煮白石，色比婴童何啻过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种竹","author":"谢薖","text":"辟地种修竹，得方缘秘经。\n成阴向北宇，倒影落中庭。\n直取内含素，岂唯枝斗青。\n龙钟玉川子，犹拟抱添丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季智伯寄茶报酒三解 其二","author":"谢薖","text":"二生相逢妾换马，我今真成酒易茶。\n腐肠销膏亦可戒，与子服雾飧朝霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵季智伯寄茶报酒三解 其三","author":"谢薖","text":"君如张籍学古淡，丽处往往凌阴何。\n长句短章时寄我，为君翻入竹枝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀钟陵旧游","author":"谢薖","text":"五年三度过钟陵，马上春风醉梦醒。\n南浦江波迷眼绿，东湖烟柳半天青。\n从来地域叹卑薄，怪底山川终炳灵。\n又见徐家有高士，他年重作聘君亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤泉泉在法水寺后","author":"谢薖","text":"乱泉如沸出湾环，馀燠犹沾野寺间。\n但与山僧洗尘垢，还胜涨腻在骊山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹四首 其一","author":"谢薖","text":"端为怀黄取醢烹，岂缘多足恣旁横。\n焚脐未用集鼠辈，椎髓方嫌太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":25,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹四首 其二","author":"谢薖","text":"分付厨人苦见嫌，十脐元有九脐尖。\n要知其中未必有，输与蛤蜊如蜜甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹四首 其三","author":"谢薖","text":"论功直与酒杯同，何事生憎在水中。\n不使落汤频下箸，终令骨醉耐春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食蟹四首 其四","author":"谢薖","text":"有国尝忧以味亡，须知有毒味中藏。\n谁能不累口腹事，莫趁秋风衔稻芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以牛胆渍槐子送董之南二首 其一","author":"谢薖","text":"雪霜无赖点君鬓，五十龙钟成老翁。\n急分槐实要脑满，伫见头青双颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以牛胆渍槐子送董之南二首 其二","author":"谢薖","text":"解牛得胆大如斗，投以元槐功更加。\n来岁青袍映绿发，不妨看尽九衢花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王坦夫由淮南入京","author":"谢薖","text":"王郎乘兴上扁舟，数遣书来写我忧。\n奏牍三千待金马，卷帘十里梦扬州。\n桃花水涨理归楫，莲叶杯香消客愁。\n白发倚门长望子，细君应赋大刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游安乐寺陈妙音载酒","author":"谢薖","text":"绕郭寻春未见花，不知春在梵王家。\n林间新翠张裙幄，席上残红当脸霞。\n兴逸持杯睨云汉，饮酣挥翰走龙蛇。\n主人不是陈惊座，投辖归时日已斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻无逸兄下第归","author":"谢薖","text":"丰林分首各消魂，兄弟伤离况玉昆。\n初谓过都留虎脊，又令点额向龙门。\n往闻淮北雪花大，归值江南梅雨昏。\n欲寄短书无别语，年来花柳自村村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李簿家有侍儿妙丽善歌舞诸人惜其死为赋诗予亦赋二首 其一","author":"谢薖","text":"草头朝泣露漙漙，樵歌暮归丘陇寒。\n当时座上客半醉，琵琶不许近帘弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李簿家有侍儿妙丽善歌舞诸人惜其死为赋诗予亦赋二首 其二","author":"谢薖","text":"郎子风流栖枳鸾，枳上单栖泣夜阑。\n窗前邂逅一笑粲，梦中犹作在时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久旱喜雨","author":"谢薖","text":"谁言旱魃虐，敢夺雨师权。\n瀰漫溪流涨，澜翻屋霤悬。\n占年丰䆉稏，快意涤柈筵。\n疏懒知何幸，茅斋稳昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"植菊","author":"谢薖","text":"憔悴灵均老，萧条子美醒。\n餐英谋自洁，摘蕊恨犹青。\n事往成今古，人亡尚典刑。\n鄙夫今白发，赖汝制颓龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":37,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀如璧道人二首 其一","author":"谢薖","text":"道人诗思泻江湍，乞食侯门铗屡弹。\n铺褐卧云何处去，不应投老累儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":38,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀如璧道人二首 其二","author":"谢薖","text":"每忆诗人贾阆仙，投冠去学祖师禅。\n尘埃不染心如镜，妙句何妨与世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":39,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄王立之二首 其一","author":"谢薖","text":"坎壈修门里，萧条处士庐。\n憎人玉川子，愤世竹林书。\n家有来禽帖，门无载酒车。\n诸公生死隔，不是故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":40,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄王立之二首 其二","author":"谢薖","text":"舌本初传强，仍闻右臂枯。\n经春一旬卧，见客二儿扶。\n吾道何寥阒，夫君合洗苏。\n世无湔浣手，药味且时需。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":41,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别董彦速四首 其一","author":"谢薖","text":"人间底处异蘧庐，莫莫堂中岂定居。\n我尚滞留君去速，荒园三亩梦归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":42,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别董彦速四首 其二","author":"谢薖","text":"多谢清风日扫庭，与君同种菊青青。\n开花烂熳君何在，莫忘萧条我独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":43,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别董彦速四首 其三","author":"谢薖","text":"欣同众鸟托吾庐，投杖行当欲索居。\n不是酸寒孟东野，吾言能听果谁欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":44,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别董彦速四首 其四","author":"谢薖","text":"机事都捐忆大庭，茅檐相对眼俱青。\n期君别后文章健，往吊沅湘屈子醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":45,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵无逸兄见寄","author":"谢薖","text":"憔悴谁能赋大招，会将菌桂杂申椒。\n巷南邻里频相过，水北山人讵可邀。\n细酌敢谋长袖舞，苦吟空咏寸岑遥。\n耕耘赖有陶潜妇，不羡孙郎对大桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":46,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次汪信民寄无逸韵","author":"谢薖","text":"诗翁索莫闭门居，珍重山阳信不疏。\n但报七言当玉案，何须千里驾柴车。\n乐天官满应归早，扬子家贫只晏如。\n他日往来随二老，共甘盂饭与盘蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":47,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送酥鱼头酱菜与何之忱三首 其一","author":"谢薖","text":"和蜜煎膏学瓮酥，儿誇甘味比醍醐。\n老夫舌本不知味，强解嘲为羊酪奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":48,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送酥鱼头酱菜与何之忱三首 其二","author":"谢薖","text":"放浪三江又五湖，头颅见醢亦何辜。\n世无刚者不用覆，往侑一觞随蜜酥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":49,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送酥鱼头酱菜与何之忱三首 其三","author":"谢薖","text":"瓮底寒蔬冬作菹，春来把酒必时须。\n庾郎鲑菜二十七，还得何郎下箸无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":50,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立夏日作四绝 其一","author":"谢薖","text":"雨脚连云苦未收，晓惊池面日光流。\n田家甑里封蛛网，即渐歌谣麦有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":51,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立夏日作四绝 其二","author":"谢薖","text":"小簟含风六尺床，竹奴从此合专房。\n吾身匏落都无用，占得山间一味凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":52,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立夏日作四绝 其三","author":"谢薖","text":"熨得絺衣一番新，幅巾轻软最宜人。\n花时气暖长愁夏，竹里风微又胜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":53,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立夏日作四绝 其四","author":"谢薖","text":"学作蒲葵扇未工，手挥聊有古人风。\n君王别用机中练，定被南来长养功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":54,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄刘世基用世基寄之忱韵","author":"谢薖","text":"斲垩谁能鼻不伤，虎贲何取似中郎。\n吾人身健间何阔，昨日书来喜欲狂。\n华屋不存长念昔，金蛇虽在莫干梁。\n几时烧烛留君语，更向东窗置一床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":55,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招李商老兄弟时闻权守陈公留之未听其来","author":"谢薖","text":"十年不见令兄弟，眉宇长怀元紫芝。\n栩栩梦魂成独往，翩翩书札慰相思。\n求船货马事应速，酌醴焚鱼吾岂辞。\n政恐孟公投辖饮，惜君高论解人颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":56,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘世基韵","author":"谢薖","text":"孔世已传三十八，诸孙犹自见长身。\n试将后谢追前谢，岂料今人愧古人。\n华子冈头千叠秀，刘郎诗律一朝新。\n吾家碧涧红泉句，聊欲烦君作后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":57,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵和董彦速","author":"谢薖","text":"得句可传千古意，搜奇攻苦百年身。\n河梁赠别初无对，锦里吟春复有人。\n我已汗颜惊手缩，君犹琼树赏朝新。\n从今习气须磨尽，二字唯当悟客尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":58,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日书事二首 其一","author":"谢薖","text":"苍虬蟠础湿生云，翠竹摇风水有纹。\n凉卧北窗呼不省，虫飞绕鬓梦中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":59,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日书事二首 其二","author":"谢薖","text":"云峰矗立驻金鸦，梦断槐宫影未斜。\n屏翳御风游不返，南山空转阿香车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":60,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余尝会李商老于海昏识吕居仁于符离今已五六年矣偶见二公倡和诗各次其韵一首 寄商老","author":"谢薖","text":"忆昔逢君夜雪中，高谈未了酒尊空。\n清涟绿筱今输我，白璧黄金政负公。\n渭水流清终异浊，池花变碧旧宁红。\n欲评此意君何在，长是苍茫立晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":61,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余尝会李商老于海昏识吕居仁于符离今已五六年矣偶见二公倡和诗各次其韵一首 寄居仁","author":"谢薖","text":"维舟浊汴偶相逢，弹铗归来四壁空。\n耕道十年常九潦，谋身一国自三公。\n似闻讽谕能知白，岂但诗词要比红。\n申国凛然生气在，故知郎子有家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":62,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]