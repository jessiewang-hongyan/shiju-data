[{"title":"次韵陈学士小园即事","author":"王安石","text":"墙屋虽无好鸟鸣，池塘亦未有蛙声。\n树含宿雨红初入，草倚朝阳绿更生。\n万物天机何得丧，百年心事不将迎。\n与君杖策聊观化，搔首春风眼尚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和吴仲庶池州齐山画图","author":"王安石","text":"省中何忽有崔嵬，六幅生绡坐上开。\n指点便知岩石处，登临新作使君来。\n雅怀重向丹青得，胜势兼随翰墨回。\n更想杜郎诗在眼，一江春雪下离堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和甫咏雪","author":"王安石","text":"奔走风云四面来，坐看山垄玉崔嵬。\n平治险秽非无德，润泽焦枯是有才。\n势合便疑包地尽，功成终欲放春回。\n寒乡不念丰年瑞，只忆青天万里开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和甫春日金陵登台","author":"王安石","text":"钟山漠漠水洄洄，西有陵云百尺台。\n万物已随和气动，一樽聊与故人来。\n天边幽鸟鸣相和，地上晴烟扫不开。\n愁眼看春长恐尽，直须去取六龙回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉和蔡枢密南京种山药法","author":"王安石","text":"区种抛来六七年，春风条蔓想宛延。\n难追老圃莓苔径，空对珍盘玳瑁筵。\n嘉种忽传河右壤，灵苗更长阙西偏。\n故畦穿斸知何日，南望钟山一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉酬李质夫","author":"王安石","text":"逸少池边有旧山，几年征泪染衣斑。\n驽骀自饱方争路，騕袅长饥不在闲。\n雪涨江南归浩荡，烟埋河朔去间关。\n劳歌一听皆愁思，况我心非木石顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉酬觉之","author":"王安石","text":"久知乘传入西州，鸡黍从容本不谋。\n户外惊尘尺书至，眼中飞浪片帆收。\n山林病骨烦三顾，湖海离肠欲万周。\n尚有光华贲岑寂，箧中佳句得长留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵昌叔岁暮","author":"王安石","text":"城云漏日晚，树冻裹春深。\n糁密鱼虽暖，巢危鹤更阴。\n横风高彍弩，残溜细鸣琴。\n岁换儿童喜，还伤老大心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵昌叔怀灊楼读书之乐","author":"王安石","text":"志食长年不得休，一巢无地拙于鸠。\n聊为薄宦容身者，能免高人笑我不。\n道德文章吾事落，尘埃波浪此生浮。\n看君别后行藏意，回顾灊楼祇自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵昌叔咏尘","author":"王安石","text":"尘土轻飏不自持，纷纷生物更相吹。\n翻成地上高烟雾，散在人间要路岐。\n一世竞驰甘睬目，几家清坐得轩眉。\n超然祇有江湖上，还见波涛恐我时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舍弟常州官舍应客","author":"王安石","text":"霜雪纷纷上鬓毛，忧时自悔目空蒿。\n桑麻祇欲求三亩，势利谁能算一毫。\n此地旧传公子札，吾心真慕伯成高。\n飘然更有乘桴兴，万里寒江正复艚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舍弟赏心亭即事二首 其二","author":"王安石","text":"霸气消磨不复存，旧朝台殿祇空村。\n孤城倚薄青天近，细雨侵凌白日昏。\n稍觉野云成晚霁，却疑山月是朝暾。\n此时江海无穷兴，醒客忘言醉客喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舍弟赏心亭即事二首 其一","author":"王安石","text":"槛折檐倾野水傍，台城佳气已消亡。\n难披榛莽寻千古，独倚青冥望八荒。\n坐觉尘沙昏远眼，忽看风雨破骄阳。\n扁舟此日东南兴，欲尽江流万里长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵舍弟遇子固忆少述","author":"王安石","text":"归计何时就一廛，寒城回首意茫然。\n野林细错黄金日，溪岸宽围碧玉天。\n飞兔已闻追騕袅，太阿犹恨失龙泉。\n遥知更忆河滨友，从事能忘我独贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵范景仁二月五日夜风雪","author":"王安石","text":"何知此邂逅，谈笑接清扬。\n对雪知春浅，回灯惜夜长。\n密云通炫晃，残月堕冥茫。\n故有临邛客，抽毫兴未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵质夫兄使君同年","author":"王安石","text":"楼堞相望一日程，春风吹急似摇旌。\n莫言乐国无愁梦，赖把新诗有故情。\n客舍五浆非所愿，私田三径会须成。\n青云自致归公等，如我何缘得此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵春日即事","author":"王安石","text":"人间尚有薄寒侵，和气先薰草树心。\n丹白自分齐破蕾，青黄相向欲交阴。\n潺潺嫩水生幽谷，漠漠轻烟动远林。\n病得一官随太守，班春无助愧周任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵祖择之登紫微阁二首 其二","author":"王安石","text":"掖门相对敞铜镮，䡾䡾飞甍在两间。\n润色平生知地禁，登临此日愧身闲。\n浮云倒影移窗隙，落木回飙动屋山。\n忽忆初来秋尚早，紫微花点绿苔斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵祖择之登紫微阁二首 其一","author":"王安石","text":"漠漠秋阴护掖垣，青云祇在两楹间。\n宫楼唱罢鸡人远，门阙朝归虎士闲。\n华盖北瞻夭帝座，蓬莱东想道家山。\n却惭久此随诸彦，文采初无豹一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵送程给事知越州","author":"王安石","text":"千骑东方占上头，如何误到北山游。\n清明若睹兰亭月，暖热因忘蕙帐秋。\n投老始知欢可惜，通宵豫以别为忧。\n西归定有诗千首，想肯重来贲一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵唐公三首 其一 东阳道中","author":"王安石","text":"山蔽吴天密，江蟠楚地深。\n浮云堆白玉，落日泻黄金。\n渺渺随行旅，纷纷换岁阴。\n强将诗咏物，收拾济时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵唐公三首 其二 江行","author":"王安石","text":"材非当世用，毂有故人推。\n使节春冬换，征帆日夜开。\n南游取干越，东望得州来。\n试尽风波恶，生涯亦可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵唐公三首 其三 旅思","author":"王安石","text":"此身南北老，愁见问征途。\n地大蟠三楚，天低入五湖。\n看云心共远，步月影同孤。\n慷慨秋风起，悲歌不为鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐仲元咏梅二首 其二","author":"王安石","text":"旧挽青条冉冉新，花迟亦度柳前春。\n肌冰绰约如姑射，肤雪参差是太真。\n摇落会应伤岁晚，攀翻剩欲寄情亲。\n终无驿使传消息，寂寞知谁笑与颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐仲元咏梅二首 其一","author":"王安石","text":"溪杏山桃欲占新，高梅放蕊尚娇春。\n额黄映日明飞燕，肌粉含风冷太真。\n玉笛悲凉吹易散，冰纨生涩画难亲。\n争妍喜有君诗在，老我翛然敢效颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵耿天骘大风","author":"王安石","text":"云埋月缺晕寒灰，飙发齐如巨象豗。\n纵勇万川冰柱立，纷披千障土囊开。\n鲁门未怪爰居至，郑圃何妨禦寇来。\n终夜不眠谁与共，坐忘唯有一颜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵致远木人洲二首 其二","author":"王安石","text":"杌尔何年客此洲，飘流谁弃止谁收。\n无心使口肝使目，有干作身根作头。\n暴露神灵难寄托，祷祠村落几依投。\n纷纷剪纸真虚负，立槁安知富可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵致远木人洲二首 其一","author":"王安石","text":"迷子山前涨一洲，木人图志失编收。\n年多但有柳生肘，地僻独无茅盖头。\n河侧鲍生乾尚立，江边屈子槁将投。\n未妨他日称居士，能使君疑福可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陪驾观灯","author":"王安石","text":"并筤含风下玉除，宫商挟奏斐然殊。\n福祥周室流为火，恩泽尧樽散在衢。\n伏枕但能知广乐，挥毫何以报明珠。\n愿留巾箧归田日，追咏公欢每自娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵景仁雪霁","author":"王安石","text":"新声生屋霤，残点著垣衣。\n委翳无多在，飘零不更飞。\n坳中馀宿润，暖处自朝晖。\n稍见青青色，还从柳上归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答丁端州","author":"王安石","text":"莫嗟荒僻又离群，且喜风谣岭北闻。\n铜柱虽然蛮徼接，竹符还是汉家分。\n春书来逐衡阳雁，秋骑归看陇首云。\n相见会知南望苦，病骸今似沈休文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答平甫","author":"王安石","text":"高蝉抱壳悲声切，新鸟争巢谇语忙。\n长树老阴欺夏日，晚花幽艳敌春阳。\n云归山去当檐静，风过溪来满坐凉。\n物物此时皆可赋，悔予千里不相将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈正叔二首 其二","author":"王安石","text":"田宅荒凉去复来，诗书颜发两尘埃。\n忘机自许鸥相狎，得祸谁期鹤见媒。\n此道未行身有待，古人不见首空回。\n何当水石他年住，更把韦编静处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈正叔二首 其一","author":"王安石","text":"青衫憔悴北归来，发有霜根面有埃。\n群吠我方憎猘子，一鸣谁更识龙媒。\n功名落落求难值，日月沄沄去不回。\n胜事与身何等近，酒樽诗卷数须开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答彦珍","author":"王安石","text":"手得封题手自开，一篇美玉缀玫瑰。\n众知圆媚难论报，自顾穷愁敢角才。\n君卧南阳惟畎亩，我行西路亦风埃。\n相逢不必嗟劳事，尚欲赓歌咏起哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵董伯懿松声","author":"王安石","text":"天机自动岂关情，能作人间物外声。\n暝聒一堂无客梦，晓悲千嶂有猿惊。\n庙中奏瑟沈三叹，堂下吹箫失九成。\n俚耳纷纷多郑卫，直须闻此始心清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵微之即席","author":"王安石","text":"酿成吴米野油囊，却爱清谈气味长。\n闲日有僧来北阜，平时无盗出南塘。\n风亭对竹酬孤峭，雪径寻梅认暗香。\n江水中?应未变，一杯终欲就君尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬子玉同年","author":"王安石","text":"盛德无心漠北窥，蕃胡亦恐势方羸。\n塞垣高垒深沟地，幕府轻裘缓带时。\n赵将时皆思李牧，楚音身自感钟仪。\n惭君许我论边锁，俎豆平生却少知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬王太祝","author":"王安石","text":"尘土波澜不自期，飘然身与愿相违。\n衰根要路知难植，病羽长年欲退飞。\n高论已嗟能听少，力行还恨赋材微。\n惭君俊少今知我，一见心如客得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬邓子仪二首 其二","author":"王安石","text":"金陵邂逅府东偏，手得新蒲每共编。\n采石偶耕垂百日，青溪并钓亦三年。\n君才有用方求禄，我志无成稍问田。\n一笑欲论心迹事，白头相就且攲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬邓子仪二首 其一","author":"王安石","text":"青溪相值各青春，老去临流辄损神。\n事事只随波浪去，年年空得鬓毛新。\n论心未忍遗横目，干世还忧近逆鳞。\n嘉句感君邀我厚，自嗟才不异常人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬朱昌叔五首 其五","author":"王安石","text":"乐世闲身岂易求，岩居川观更何忧。\n放怀自事如初服，买宅相招亦本谋。\n名誉子真矜谷口，事功新息困壶头。\n知君于此皆无累，长得追随圹埌游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬朱昌叔五首 其四","author":"王安石","text":"白下门东春水流，相看一噱散千忧。\n穿梅入柳曾莫逆，度堑缘冈初不谋。\n世事但如吹剑首，官身难即问刀头。\n长临锻灶真自苦，有兴复来从我游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬朱昌叔五首 其三","author":"王安石","text":"乌榜登临兴未休，共言何许更消忧。\n联裾萧寺寻真觉，方驾孙陵吊仲谋。\n语罢每开欢笑口，诗来仍掉苦吟头。\n已知轩冕真吾累，且可追随马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬朱昌叔五首 其二","author":"王安石","text":"去年音问隔淮州，百谪难知亦我忧。\n前日杯盘共江渚，一欢相属岂人谋。\n山蟠直渎输淮口，水抱长干转石头。\n乘兴舟舆无不可，春风从此与公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬朱昌叔五首 其一","author":"王安石","text":"点也自殊由与求，既成春服更何忧。\n拙于人合且天合，静与道谋非食谋。\n未爱京师传谷口，但知乡里胜壶头。\n嗟予老矣无一事，复得此君相与游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬吴彦珍见寄二首 其二","author":"王安石","text":"篁竹荒茅五亩馀，生涯山蕨与泉鱼。\n家贫殖货羞端木，乡里传书比仲舒。\n白日忆君聊远望，青林嗟我似逃虚。\n春风渺渺乌塘尾，漫得东来一纸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬吴彦珍见寄二首 其一","author":"王安石","text":"君作新诗故起予，一吟聊复报双鱼。\n杖藜高径谁来往，散帙空堂自卷舒。\n树外鸟啼催晚种，花间人语趁朝虚。\n春风处处堪携手，何事临池苦学书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋中散二首 其二","author":"王安石","text":"超然京洛谅难双，处在家庭誉在邦。\n道义门中窥户牖，风骚坛上见麾幢。\n素书款款谁怜杜，彩笔遒遒独胜江。\n信美贤公有才子，笃诚真复类尨降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋中散二首 其一","author":"王安石","text":"初见彤庭赐履双，便参东阁寄南邦。\n时闻正论除疑网，每读高辞折慢幢。\n陈迹欲寻无复日，旧恩思报有如江。\n风流今见佳公子，投老心旌一片降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋玘六首 其六","author":"王安石","text":"山陂畴昔从吾亲，诸父先生各佩纷。\n零落长年谁语此，迟回故地却逢君。\n衣冠偶坐论经术，襁褓当时刺绣文。\n更怪高材终未遇，有司何日选方闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋玘六首 其五","author":"王安石","text":"无能私愿祇求田，时物安能学计然。\n凿井未成歌击壤，射熊犹得梦钧天。\n遥思故国归来日，留滞新恩已去年。\n携手与君游最乐，春风波上水溅溅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋玘六首 其四","author":"王安石","text":"远迹荒郊谢俊豪，春风谁与驻干旄。\n故交重趼恩何厚，新句连篇韵更高。\n美似狂酲初啖蔗，快如衰病得观涛。\n久知坏冶成天巧，岂与人间共一陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋玘六首 其三","author":"王安石","text":"城中灯火照青春，远引吾方避纠纷。\n游衍水边追野马，啸歌林下应山君。\n愁寻径草无求仲，喜对檐花有广文。\n邂逅一樽聊酩酊，声名身后岂须闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋玘六首 其二","author":"王安石","text":"东风渺渺客天涯，病眼先春已见花。\n远欲报君羞强聒，老知随俗厌雄誇。\n穷通往事真如梦，得失秋毫岂更嗟。\n邂逅故人唯有醉，醉中衣帻任攲斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬宋玘六首 其一","author":"王安石","text":"洗雨吹风一月春，山红漫漫绿纷纷。\n褰裳远野谁从我，散策空陂忽见君。\n青眼坐倾新岁酒，白头追诵少年文。\n因嗟涉世终无补，久使高材雍上闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬府推仲通学士雪中见寄","author":"王安石","text":"朝来看雪咏君诗，想见朱衣在赤墀。\n为问火城将策试，何如云屋听窗知。\n曲墙稍觉吹来密，穷巷终怜扫去迟。\n欲访故人非兴尽，自缘无路得传卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬徐仲元","author":"王安石","text":"投老逍遥屺与堂，天刑真已脱桁杨。\n缘源静翳无鱼淰，度谷深追有鸟颃。\n每苦交游寻五柳，最嫌尸祝扰庚桑。\n相看不厌唯夫子，风味真如顾建康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬龚深甫二首 其二","author":"王安石","text":"握手东冈雪满簪，后期惆怅老吴蚕。\n芳辰一笑真难值，暮齿相思岂久堪。\n他日杜诗传渭北，几时周宅对漳南。\n百年邂逅能多少，且可勤来共草庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬龚深甫二首 其一","author":"王安石","text":"恩容楚老护松楸，复得一龚从我游。\n讲肄剧谈兼祖谢，舞雩高蹈异求由。\n北寻五柞故未憖，东挽三杨仍有樛。\n陟巘降原从此始，但无瑶玉与君舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汜水寄和甫","author":"王安石","text":"虎牢关下水逶迤，想汝飘然过此时。\n洒血祇添波浪起，脱身难借羽翰追。\n留连厚禄非朝隐，乖隔残年更土思。\n已卜冶城三亩地，寄声知我有归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上二首 其二","author":"王安石","text":"书自江边使，乡邻病饿稠。\n何言万里客，更作百身忧。\n补败今谁恤，趋生我自羞。\n西南双病眼，落日倚扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上二首 其一","author":"王安石","text":"潮连风浩荡，沙引客淹留。\n落日更清坐，空江无近舟。\n共看蒹苇宅，聊即稻粱谋。\n未敢嗟艰食，凶年半九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":13480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]