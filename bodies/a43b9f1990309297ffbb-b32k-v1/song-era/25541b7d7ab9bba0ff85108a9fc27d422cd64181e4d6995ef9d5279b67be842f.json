[{"title":"送刁秘校授涟水主簿归四明省亲","author":"梅尧臣","text":"桂得常娥枝，妇得黄姑女。\n直归东海头，翁妪笑相语。\n何当却之官，古县入平楚。\n莫嫌簿书繁，百事由区处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刁景纯学士使北","author":"梅尧臣","text":"尝闻朔北寒尤甚，已见黄河可过车。\n驿骑骎骎持汉节，边风惨惨听胡笳。\n朝供酪粥冰生椀，夜卧毡庐月照沙。\n侍女新传教坊曲，归来偷赏上林花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刁景纯知会稽","author":"梅尧臣","text":"前有朱翁子，后经王右军。\n至今风俗美，自昔诵歌闻。\n秦望临丹戟，耶溪漱白云。\n只应丝管去，惊动海鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送万殿丞虔州安远军","author":"梅尧臣","text":"新雷动江雨，百鸟响溪岩。\n逆水送行客，顺风催挂帆。\n过山唯庙敬，团饭与乌衔。\n太守虽怜旧，须妨有嫉谗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送卫真宰晏寺丞罢长安","author":"梅尧臣","text":"舍琴辞苦县，解剑入函关。\n鹊报远人至，马冲春雨还。\n荒榛郊北囿，葱翠国南山。\n归见萧何政，条令旧镐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送广西提刑潘比部","author":"梅尧臣","text":"白麻新拜大丞相，黄纸首除南省郎。\n欲使平刑安远俗，莫辞乘传历炎荒。\n桂林地险通椎髻，阳朔峰奇削剑铓。\n自有王门旧勋业，且须稀作上书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送才上人还雪窦寄达观禅师","author":"梅尧臣","text":"春雪满蓑笠，海边先燕归。\n千林新改叶，百衲旧来衣。\n溪水从何至，山云自解飞。\n报言岩下客，斋钵笋应肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马少卿知襄州","author":"梅尧臣","text":"荆州太守随车雨，昨夜云从岘首生。\n候吏莫辞弓箙重，春泥初著马蹄轻。\n朝穿锦石江滩润，暮入烟堤竹屋鸣。\n却叹当年杜元凯，沉碑空爱异时名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马仲途司谏使北","author":"梅尧臣","text":"每逆龙鳞司谏诤，又持旄节使阴山。\n貂裘不见风霜劲，雁碛遥知道路艰。\n冰脍芥齑非楚味，玉苕兰茁说燕颜。\n单于不敢轻中国，名马新调为送还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马廷评之馀姚","author":"梅尧臣","text":"越乡知胜楚，君去莫辞遥。\n晓日鱼虾市，新霜橘柚桥。\n河流通海道，山井应江潮。\n近邑逢鸥鸟，先应避画桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马行之都官","author":"梅尧臣","text":"昭亭山下送君时，不畏西行剑栈危。\n笮马跨来身更健，吴船乘去计非迟。\n钱塘湖上寻云屋，巾子峰前种槿篱。\n此趣已高天下士，不须功业似鸱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送勾谌太丞通判颍州","author":"梅尧臣","text":"颍川倒湾流，栏船曲转钩。\n吏迎如太守，民望亚诸侯。\n芳圃深通野，寒湖半抱州。\n前贤多旧迹，佳咏听君留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送少卿张学士知洪州","author":"梅尧臣","text":"朱旗画舸一百尺，五月长江水拍天。\n稳去先应望庐岳，暂来谁复见龙泉。\n阁经吏部重为记，山识吴王旧铸钱。\n往迹可寻军事少，剩书遗逸附青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送少卿知宣州","author":"梅尧臣","text":"汴水清明下，宣城太守行。\n鸭头吴荡绿，燕尾楚船轻。\n族本三阳重，诗从小谢清。\n州民还最喜，门下旧通名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王宗说寺丞归南京","author":"梅尧臣","text":"晏岁欲飞雪，满天含冻云。\n犯寒单骑速，猎吹紫裘薰。\n庭鹊还先喜，池鸿去始闻。\n公应问贫贱，善说莫如君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王郎中知江阴","author":"王安石","text":"持归霄汉青绫被，去看吴都白马潮。\n叠鼓渡江寒浪伏，鸣铙入境野云飘。\n鱼穿杨柳誇鲸脍，人采芙蓉学细腰。\n家有三槐为太守，弟兄谁似李文饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王推官宰上洛先归关中","author":"梅尧臣","text":"跨马独归日，春风随度关。\n客裘将欲绽，社燕亦同还。\n洛水源边邑，秦人隐处山。\n君家有凫舄，切莫向云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王著作赴西京寿安","author":"梅尧臣","text":"去作西畿令，当趋大尹庭。\n閒寻前代迹，净扫古槐厅。\n未惯餐周粟，还应忆楚萍。\n但逢花木处，知我昔常经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王景宪奉职","author":"梅尧臣","text":"清羸将家子，苦节自寒儒。\n四壁我何有，一钱君亦无。\n下滩船自急，闻雁日将晡。\n行爱青山口，人烟事网罛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王景彝学士使虏","author":"梅尧臣","text":"持节共知过碣石，衔芦相背有飞鸿。\n地寒狐腋著不暖，沙阔马蹄行未穷。\n陇上牛羊冲密霰，帐前徒御立酸风。\n归时莫问程多少，却到河湟杏萼红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王察推缜之邓州","author":"梅尧臣","text":"昔向南阳忆洛阳，秋橙初熟半林黄。\n车过白水沙痕阔，雁落钳卢稻穟长。\n废垒汉碑金刻字，古原秦冢石为羊。\n太平羽檄何曾有，宾主相欢菊荐觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送长陵清辨师归宁","author":"梅尧臣","text":"山房古柏暗，近在汉陵边。\n天供不为乐，母心常所悬。\n朝途发根冷，暮野鸟行先。\n子道岂殊众，谁云绝世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送乐职方知泗州","author":"梅尧臣","text":"长堤冻柳不堪折，穷腊使君单骑行。\n苏合轻裘霜莫犯，铜牙大弩吏先迎。\n山旁楚贾连樯泊，水上禹书寒磬清。\n试向郡楼东北望，烟波千里月临城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送叶都官赴蜀州倅","author":"梅尧臣","text":"每有人之蜀，先凭问海棠。\n徒知花底醉，不报树头芳。\n上马秋风急，登山古路长。\n西南生片月，遥想见清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送永叔归乾德","author":"梅尧臣","text":"渊明节本高，曾不为吏屈。\n斗酒从故人，篮舆傲华绂。\n悠然目远空，旷尔遗群物。\n饮罢即言归，胸中宁郁郁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送玉汝","author":"梅尧臣","text":"谈笑去拘忌，乃见相与深。\n风骚得往返，但见非知音。\n明日车马北，岂不动离襟。\n春风蘼芜绿，别恨生遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送白珙秀才","author":"梅尧臣","text":"溪上桃花发，山前桂舸移。\n水流过峡急，风逆出江迟。\n南国鱼虾厌，东都梦寐思。\n逢人若有问，不似在朝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送白鹇与永叔依韵和公仪","author":"梅尧臣","text":"致鹇犹恐鹇饥渴，细织筠笼小瓦缸。\n玉免精神怜已久，金銮人物世无双。\n休争白鹤临清沼，且伴鸣鸡向绿窗。\n美羽奇毛有多少，尔身高稳胜他邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送石昌言学士","author":"梅尧臣","text":"混混拍堤瓜蔓水，轩轩衔尾挂樯船。\n使君东下只朝夕，父老走迎无后先。\n古堞秋耕拾铜镞，长淮瀑雨入壕莲。\n鸣猿舞鹤仍持去，不忆承明夜直眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送任太博归省西都","author":"梅尧臣","text":"人言少保持家谨，载见西京万石君。\n子舍今归浣裙切，里门重戒下车勤。\n田园一一能为计，僮仆欣欣亦有闻。\n我负洛阳山水久，试因行色寄嵩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘十往荆渚","author":"梅尧臣","text":"临水一太息，解舟当落晖。\n上楼人已远，极目鸟空飞。\n荆楚时方晏，江湖客未归。\n定知吟忆处，林外月光微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘子思殿丞宰巫山","author":"梅尧臣","text":"千里向巴东，青山不可穷。\n峡猿初入听，蛮语未全通。\n暮雪思梁国，朝云识楚宫。\n吏人迎拜处，嘶马入丹枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘元忠学士归陈州省亲","author":"梅尧臣","text":"芸香閒秘秩，苏合著新裘。\n公子言归日，天王赐问优。\n治分周太宰，礼重汉诸侯。\n拜庆无如乐，黄金作酒舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘比部","author":"梅尧臣","text":"青山夜来雨，溪水已潺湲。\n侵晓桂旗动，伤离蘋渚前。\n百壶临祖道，两桨破春烟。\n旧业西河上，归心向日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘成伯还都","author":"梅尧臣","text":"余昔困川途，今非羡行者。\n离心寄南风，相送过平野。\n既吹莲叶舟，更逐桂条马。\n中州多故人，怀抱幸君写。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘㢸秘校赴婺源","author":"梅尧臣","text":"云木葱茏处，鸡鸣古县城。\n山高地多险，源近水偏清。\n斫漆资商货，栽茶杂赋征。\n案头龙尾砚，切莫苦求精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吉老学士两浙提刑","author":"梅尧臣","text":"重本恤刑天子圣，舟车持诏使臣贤。\n部中汉吏无冤狱，葑上吴人益美田。\n重过故乡逢故老，一闻鸣鹤访山川。\n不须歌管唯诗酒，况有馀杭白乐天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕寺丞希彦邠州签判","author":"梅尧臣","text":"自有仲宣乐，从军仍近亲。\n关河历周郑，风雪过咸秦。\n原上方驱马，鞍傍忽起鹑。\n世家传钓玉，重问渭川滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吕冲之司谏使北","author":"梅尧臣","text":"虏人多窃朝廷礼，译者交传应对辞。\n羊酪调羹尊汉使，毡堂举酒见阏氏。\n曚曚白日穿云出，漭漭黄沙作雾吹。\n知去燕京几千里，胡笳乱动月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送回上人","author":"梅尧臣","text":"云出任西东，飘然意莫穷。\n山川生眼界，巾舄遍区中。\n去去曾无著，劳劳本是空。\n梅溪人可见，重尔似泓公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孙隐之都官通判秀州","author":"梅尧臣","text":"柳条枯落尽，不折意徘徊。\n泛汴趋残水，到吴看早梅。\n无耽听鹤唳，有信寄鸿来。\n闻说闾亭改，灵光化劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱纯臣端公使契丹奠祭","author":"梅尧臣","text":"汉庭遣奠阏氏幕，二月阴山雪未销。\n行尽黄沙春不见，哀缠碧眼魄谁招。\n已将厚礼施殊俗，更录专辞入本朝。\n名马赠归多爱惜，北风嘶处竞萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送毕郎中提点淮南茶场","author":"梅尧臣","text":"汴中春絮乱，淮上鲚鱼时。\n顺水疾奔马，出都犹脱羁。\n拜亲将已近，食脍不言迟。\n到日问茶事，遍山开几旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江东转运杨少卿","author":"梅尧臣","text":"世言楚使者，乃是汉名卿。\n曾欲察黄绶，但能勤列城。\n江山无改故，草树几更荣。\n有意息民甚，不同求羡盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送达观禅师归隐静寺古律二首 其二","author":"梅尧臣","text":"栗林霜下熟，归摘禦穷冬。\n带月涉溪水，过山闻寺钟。\n未嫌云衲湿，已喜野人逢。\n且莫似杯渡，沧波无去踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何都官通判虔州","author":"梅尧臣","text":"楚越封圻接，帆樯上下频。\n商通洲橘熟，信到岭梅春。\n白纻歌脩颈，金盘馈紫鳞。\n同勤太守职，龚遂汉名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送河清贾主簿归任","author":"梅尧臣","text":"不远水云间，悠悠溯鹢还。\n分亭接鸡犬，举酒对河山。\n残雪依荒碛，寒烟入暝湾。\n昔人鸾枳叹，一并在离颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何遁山人归蜀","author":"梅尧臣","text":"春风入树绿，童稚望柴扉。\n远壑杜鹃响，前山蜀客归。\n到家逢社燕，下马浣征衣。\n终日自临水，应知已息机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送馀干李少府","author":"梅尧臣","text":"作尉古来清，况于干越城。\n舟中雨新足，溪上水初生。\n苍獭出还没，素鸥飞且鸣。\n休将五色棒，欲取洛阳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送余中舍知汉州德阳","author":"梅尧臣","text":"匹马易为秣，单车长是轻。\n秋风来栈道，宿雨度关城。\n石上树林暗，山根江水明。\n桐花凤何似，归日为将行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送余少卿知睦州","author":"梅尧臣","text":"青山峡里桐庐郡，七里滩头太守船。\n云雾未开藏宿鸟，坡原将近见烧田。\n养茶摘蕊新春后，种橘收包小雪前。\n民事萧条官政简，家书时问霅溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送余郎中知郑州","author":"梅尧臣","text":"西接都门才百里，压城残雪照牙旗。\n风烟古是诸侯国，雁鹜新来仆射陂。\n馈食且依当日具，铸刑无改昔人为。\n浓薰旧舍青绫被，不越常衙睡足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送余驾部江州","author":"梅尧臣","text":"内史九江行，潦收波已清。\n何时鹢舟上，远见炉峰迎。\n野色连葭菼，秋香荐橘橙。\n寒潮如特送，不肯过湓城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴仲庶殿院使北","author":"梅尧臣","text":"汉朝重结单于好，岁遣名臣礼数增。\n紫鼠皮裘从去著，飞龙厩马借来乘。\n天寒将遇碛中雪，鼻息暗添髭上冰。\n定见南鸿起归思，家书欲寄不堪凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴季野太博移蜀灵泉先至辇","author":"梅尧臣","text":"苇箔蚕齐老，桑林叶更生。\n楚禽多异响，蜀栈未堪行。\n客散岸傍席，马还溪上城。\n过都当有问，为语欲岩耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴辩叔知巩县","author":"梅尧臣","text":"言为西邑宰，本是洛阳人。\n送驲往归魏，迎车来入秦。\n山川成巩固，陵庙壮威神。\n好学河阳政，栽花作县春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送弟良臣归宣城","author":"梅尧臣","text":"乔木句溪边，秋光几曲连。\n将归三亩宅，远寄下江船。\n伴尔唯征雁，悲余有暮蝉。\n亲朋如见问，贫外似当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送弟赴和州幕","author":"梅尧臣","text":"夹河为郡不如古，江北江南作冗官。\n须记长传一经训，虽贫莫改饮瓢欢。\n历阳况与吾庐近，春谷休言问膳难。\n此日停舟聊举酌，明当水驿自加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张子野秘丞知鹿邑","author":"梅尧臣","text":"忽作五年别，相逢双鬓疏。\n不知从此去，当见复何如。\n公秫时为酒，晨庖日有鱼。\n沛谯风物美，聊以乐琴书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张秀才之淮南","author":"梅尧臣","text":"聊为楚客唱，一送淮南行。\n出汴远心喜，移舟孤岫横。\n危帆将进浦，寒雾不分城。\n枚乘旧居处，向来秋草生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张叔展北归","author":"梅尧臣","text":"江南春候早，水暖野芹生。\n北客欲归日，故人持赠行。\n莫嫌为物薄，言采幽兰并。\n休惜临流醉，高帆去棹轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张景纯知邵武军）","author":"梅尧臣","text":"赌却华亭鹤，围棋未肯还。\n方为剖符守，又近烂柯山。\n鱼稻荆杨下，风烟楚越间。\n小君能赋咏，应得助馀闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张遂州","author":"梅尧臣","text":"华省名郎意若西，相如桥柱旧曾题。\n已将符节为邦守，不畏关山入马蹄。\n千里过秦看素浐，三年还蜀度青泥。\n里门锦绶何为乐，外奉严君内阿㜷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张殿丞吉甫知资阳","author":"梅尧臣","text":"单骑欲之蜀，綵衣初过秦。\n王乔凫是舄，陶令酒名巾。\n灞上愁逢雪，褒中喜见春。\n两川风物美，不似走京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送志来上人往姑苏谒元曹","author":"梅尧臣","text":"折取东桥柳，青青向故人。\n欲知问馆处，要识旧溪春。\n旋洒铜瓶水，休沾野寺尘。\n吴门逢隐者，必是汉名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送怀州张从事仲宾","author":"梅尧臣","text":"行色在车马，西亭新雨过。\n移家从上党，佐幕向三河。\n皂荚林初暗，黄粱酒未和。\n七贤无复有，旧迹尚应多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李才元学士知广安军","author":"梅尧臣","text":"杨柳未堪折，柔条时倚风。\n朱轮过灞上，杜宇响褒中。\n危栈憎春雨，晴林发晓红。\n不须言蜀政，当自学文翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]