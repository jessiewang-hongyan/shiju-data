[{"title":"偈颂二百零五首 其四十","author":"释正觉","text":"主中之主天中天，家势金轮万代传。\n退步不居尊贵位，借功却作诞生缘。\n廓虚印上无瑕垢，明白机头有转旋。\n劫数不能知寿量，湛存象外自绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十三","author":"释正觉","text":"菩提无树镜非台，虚净光明不受埃。\n照处易分雪里粉，转时难辨墨中煤。\n鸟归无影树头宿，华在不萌枝上开。\n际会风云底时节，寒梭出蛰一声雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十二","author":"释正觉","text":"九重尊贵位中人，灿灿星图拱北辰。\n活计四时调玉烛，家风万世运金轮。\n区分群象布淳化，囊括二仪怀至仁。\n算数不能穷寿量，南山苍翠镇长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十二","author":"释正觉","text":"途中久客忆家山，一线蹊通入翠寒。\n望处霁云收素练，跨门残月堕金盘。\n十虚俱殒眼方阔，三世齐吞肚觉宽。\n变化鲲鹏底时节，霄程九万看风抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十八","author":"释正觉","text":"阴阳爻象此为宗，杀活机头看变通。\n玉女退身功后位，木人引步异中同。\n一尘不受能虚廓，万像无遗却混融。\n借得因缘成现用，玲珑八面尽家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十五","author":"释正觉","text":"祖华五叶发灵根，端的知恩解报恩。\n大仰未忘东寺会，玄沙相继雪峰存。\n机梭传处难通路，针芥投时有妙门。\n鼻孔放光出气快，当年一斲尽泥痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿覆船山阻雨","author":"释正觉","text":"枝筇同到覆船巅，暂寄筇枝借榻眠。\n山水钩帘知属我，烟霞腻枕梦游仙。\n觉来笋窟投蔬箸，閒把华房入线编。\n想像玲珑岩下雨，春寒犹可卧羊毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄大洪和尚","author":"释正觉","text":"饮茶作别出萝门，相送犹怀握手温。\n断雁几时归缀字，浮萍随处卧生根。\n秋风窗外拥芦雪，梦冷床头堕月魂。\n麈柄年来疲转徙，却思红颗共炊盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石湫童知县","author":"释正觉","text":"溪头茅屋远追陶，斗米而今懒折腰。\n汉水丈人甘抱瓮，箕山居士厌鸣瓢。\n心秋霁月夜相照，鬓雪温风吹不消。\n身世曲肱分付梦，蘧随蝴蝶到华条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戚泽民从新正日供三僧求颂","author":"释正觉","text":"君家炊饭办蔬薇，日供畦衣三阿师。\n海上浮杯登岸后，云间飞锡过门时。\n伊蒲塞作新香气，宾度卢迎老白眉。\n施受等心相称可，月随流水下春池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清上人持钵求颂","author":"释正觉","text":"苕霅溪头柳眼青，食时持钵众香城。\n诸邻定怪颠毛白，久客自怜心境清。\n重念雪寒亲麈语，无忘水暖走鸥盟。\n饱丛林汉深相悉，笋蕨春山次第生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚禅人发心丐田","author":"释正觉","text":"虚廓襟怀作丐游，机缘处处定相投。\n开田大义聊舒手，得意忘言暗点头。\n白牯耕回山月晓，金刀剪断野云秋。\n长连趺坐通身饭，一饱分明百不忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪晴寄刘殿撰","author":"释正觉","text":"半毡半幅一羌床，寒淡家风肖老庞。\n容易著身藏北斗，等闲开口吸西江。\n龛灯梵夹香摇几，茅屋禅蒲雪照窗。\n方外友于思对麈，隐人胸次作舂撞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普渊行者请颂","author":"释正觉","text":"脱尽尘机真出家，平持心地是生涯。\n法堂刬草堕僧数，舂屋传衣联祖华。\n想变石头山下虎，悟空弓影酒中蛇。\n寒枯只么清修去，佛种从今却较些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景禅人求颂","author":"释正觉","text":"混处还须转侧看，底时妙在一丝端。\n闲云卷雨秋空阔，明月流辉夜水寒。\n棹破波光华细碎，梦惊蓬晓影团圞。\n真机分应头头准，却出黄芦把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"森禅人持钵求颂","author":"释正觉","text":"森罗万象本同根，个事虚通有化门。\n历历当机元不爽，头头大用了无痕。\n妙明田地传家祖，参饱丛林委子孙。\n缘就归来墙面坐，秋空连水月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游司真洞","author":"释正觉","text":"桃华濯锦春水寒，洞门窈窕玉勾栏。\n三峰拥翠云吞屋，九井扬波雪溅坛。\n象帝先身元老语，谷神后事阿谁观。\n羽郎清瘦发半白，待乞安期五色丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湛禅人开田求颂","author":"释正觉","text":"衲僧兹欲起家门，老牯鞭催泥水浑。\n混处蹈翻明月影，转时耕断白云根。\n力田辛苦遵吾祖，炊饭馨香饱子孙。\n底事既归蒲坐稳，湛圆心鉴夙忘痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登云庵","author":"释正觉","text":"屠苏对碧溪，霜草露幽蹊。\n顾我丘壑醉，知谁尘土迷。\n萝门窥窈窕，云磴履高低。\n猿鸟未相弃，伴人烟树栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登祥云庵谒东林明首座","author":"释正觉","text":"伐木清哦癖在肠，握筇苍磴履重霜。\n玲珑堕壑乳泉响，萧瑟到门松吹香。\n高寒夜雨冻一色，虚净晓云流五光。\n社散荷枯有遗友，目青须发半沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人发心干钟乞颂","author":"释正觉","text":"木落空山霜，夜楼时一撞。\n随风度林岭，唤月到萝窗。\n响应虚传谷，声飞不碍江。\n梦回天意晓，蝴蝶失双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人发心丐席求颂 其二","author":"释正觉","text":"吉祥长者草茸茸，香软登机棱路通。\n卷去若人呈己事，得来与我展家风。\n默游两岸雪芦外，瘦坐五湖烟水中。\n未许春眠梦蝴蝶，大方引步劫壶空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人发心丐席求颂 其一","author":"释正觉","text":"万指相从作正观，出求卧席著蒲团。\n恬处敛雨野云薄，湛若磨风秋水寒。\n卷去犹知鼻头痛，坐来方信髑髅乾。\n芦花明月阿谁事，人在江湖把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒋新臣秀才告别作句送之","author":"释正觉","text":"雪屋高寒能我过，疏梅清秀雪林柯。\n不悭屈宋楚人语，来试宗雷莲社科。\n后会说盟如有以，此行洗念入无何。\n春风迟立栏干曲，白雪楼前船弄梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢通讲师五偈 其四","author":"释正觉","text":"一昨书来约见过，迟留行李未成那。\n梨黄枣赤秋如许，发白眉庞老奈何。\n相伴采薇云腻袜，不嫌伐木雨濡蓑。\n对床默默香摇篆，霁月夜窗悬女萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢通讲师五偈 其一","author":"释正觉","text":"得得客来窥大方，松间目击揖归堂。\n秋横两眼瞳人碧，云拥三衣栀子香。\n夺席胸襟君隗礧，愕邻须发我沧浪。\n竹床相对夜深语，河汉濯磨星斗光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢通讲师五偈 其二","author":"释正觉","text":"五月人间膏火煎，清风麈对有夤缘。\n点头顽石能明證，借口虚空解讲玄。\n随类佛身分百亿，出尘红卷等三千。\n未闲相约蒲禅稳，作别又趋华雨筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢通讲师五偈 其五","author":"释正觉","text":"乞食因循答教迟，想能心照未相疑。\n三年约友共连璧，千里同风那隔丝。\n鞭笋嫩黄出泥土，槿华寒紫裹藩篱。\n雨驱暑去晚明霁，来雁门头字脚垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢通讲师五偈 其三","author":"释正觉","text":"慰心佛氏未萧条，卓卓缁林有俊髦。\n知见香熏舌本利，名言垢净眼棱高。\n锦云脚踏冷修月，仙峤牵颓閒钓鳌。\n良遂肯从麻谷后，声光矫矫壮吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道禅人发心干田乞颂","author":"释正觉","text":"道人欲乞一囊钱，为我成褫负郭田。\n浅水驾牛披晓月，深云下耒破春烟。\n力耕妙用吾家事，坐照真机自己禅。\n寄语檀那好相助，年年长得饭僧缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勤大师访别作句赠之","author":"释正觉","text":"若子能来过我门，端知良遂志弥敦。\n微尘破处得经卷，万象纷时空眼根。\n与世支离谁恶意，怪人棱瘦自秋痕。\n归兴定到家林稳，山月流明洗夜昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓禅人干田求颂","author":"释正觉","text":"廓虚田地绝蓁荆，望断玉壶冰鉴平。\n素色依稀云拥耒，练光片段月分耕。\n意为衲子延筇履，力丐檀那助饭羹。\n将见金牛笑相唤，丛林气像不多争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满化士与圆通大众出丐说偈送之","author":"释正觉","text":"过门衲子上饶人，破我胡床默味真。\n道活髑髅前有地，用冲赤肉上无尘。\n盟心芦笋白鸥社，梦眼华枝蝴蝶春。\n满著圆通无尽意，四衢处处主中宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙禅人丐麦求颂","author":"释正觉","text":"杖头挂钵丐丹丘，力破清贫一点忧。\n红雨几番华事老，黄云万顷麦家秋。\n对缘手眼通身是，应物机轮转处幽。\n归理韶阳糊饼话，肚皮束篾饱齁齁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鉴维那求月堂颂","author":"释正觉","text":"桂毂谁将玉斧修，风帘收卷许相留。\n虚明窗户不知夜，清白身心长濯秋。\n鹤梦巢寒松挂壁，鱼惊波动水浮钩。\n胡床瘦坐摇香篆，净照壶中一默游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端禅人开田乞颂","author":"释正觉","text":"衲僧田地有来端，底意相携出问檀。\n春坞耕开云锦晓，月津划破练光寒。\n饱期束肚三条篾，功就移身百尺竿。\n恰恰相投看规矩，谷声鉴像一般般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题至游庵兼简庵中道友","author":"释正觉","text":"真实人居遍十方，至游处处露堂堂。\n鹅于水器择其乳，蜂在华房采得香。\n心鉴照中无垢翳，道环虚里见神光。\n能来闹市住三昧，鸟度长空迹不彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题奉化西峰圆觉禅院","author":"释正觉","text":"水流百折山苍苍，古寺秋容横野航。\n明月初濡寒露白，篱花似趁重阳黄。\n道人心已老松石，学子胆须磨雪霜。\n默默澄源坐兀兀，游鱼沙鸟静相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别洪山预和尚","author":"释正觉","text":"般游念未稳，又别住山人。\n雁影水中字，云心江上宾。\n同条如是住，千里亦成邻。\n深翠一枝玺，腐红五合陈。\n回途登鸟道，华木故园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月朔与法上人南谷行 其二","author":"释正觉","text":"一筇双屦征具简，幽讨胜友宾栖深。\n与公半夜丘壑语，慰我平生麋鹿心。\n倒榻雅成山水梦，落泉寒作丝桐音。\n归欤城寺禅肤粟，定是流想来家林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万寿晖长老写师像求赞","author":"释正觉","text":"空而无痕，绵绵体之若存。\n卓而莫群，恰恰用之不勤。\n光明破夜月，淡泞出山云。\n无得而得，不闻而闻。\n少林之传默默，灵山之笑欣欣。\n龙雷相送鱼烧尾，豹雾俄披虎炳文。\n齐物飘飘兮流梦似随蝴蝶去，亡机荡荡兮清閒还与白鸥分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与初禅人","author":"释正觉","text":"洞下家风虚一著，白牛耕断青山脚。\n而今何处不逢渠，鼻孔累垂相撞磕。\n阿剌剌，始信从来无缚脱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与昌国善友","author":"释正觉","text":"驾潮舟涩岸头沙，得与岩僧款语些。\n梦付庄周窗外蝶，疑醒乐广酒中蛇。\n夜堂莫怪云悭月，春峤将知雨促华。\n想像旧山归去路，照门新锦眼迷家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与胨禅人","author":"释正觉","text":"白蘋风作江头秋，青鸟梦随沙水流。\n清兴十分蓬上月，满船载入芦华洲。\n斯适意，去来休。\n六鳌合负归来也，烟浪雪翻收钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大宁悟长老写师像求赞","author":"释正觉","text":"眼睛活，髑髅乾，妙在离微转处看。\n鱼潜水而秋痕愈碧，鹤卧松而月梦犹寒。\n应呼之神居谷，随色之珠走盘。\n影响黏谁眉得用，斲泥馀地鼻无漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师智临禅客写真求赞","author":"释正觉","text":"云石雪松，岁寒之友从。\n晓月霜钟，清白之音容。\n自乐也村歌社舞，平怀也牧笛归农。\n暴雨卒风，潜神堂而避阵。\n吼雷掣电，战禅席而交锋。\n十分闲暇，一等疏慵。\n青山白云之去就，浮萍流水之行踪。\n披雾变文豹，吟云蜕骨龙。\n身老艺孤兮难其授子，智齐德半兮未可传宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌巨光长老写真求赞","author":"释正觉","text":"骨寒气羸，顶雪颔丝。\n牛首之懒，虎头之痴。\n兀兀逃禅处，空空选佛时。\n九万鹏风扶羊角，千年兔月卧蛾眉。\n门门幻起，尘尘智随。\n蝴蝶梦游兮庄生齐物，桃华眼冷兮灵云不疑。\n初无棱缝，浑莫针锥。\n巴陵曾对吹毛剑，珊瑚撑月夜枝枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌墩密印大师仁公真赞","author":"释正觉","text":"唇口能缄，眉目如笑。\n应外而冲，虚中而照。\n全身放下是全身，一点独灵常了了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五王子 朝生","author":"释正觉","text":"雄心脱略战文场，端把烟蓑换龙章。\n葵藿奉君知贵味，肯怀归去见严光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其二","author":"释正觉","text":"偏中正，海云依约神山顶。\n归人鬓发白垂丝，羞对秦台寒照影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其四","author":"释正觉","text":"兼中至，觌面不须相忌讳。\n风化无伤的意玄，光中有路天然异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其三","author":"释正觉","text":"正中来，月夜长鲲蜕甲开。\n大背摩天振云羽，翔游鸟道类难该。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其一","author":"释正觉","text":"正中偏，霁碧星河冷浸乾。\n半夜木童敲月户，暗中惊破玉人眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其五","author":"释正觉","text":"兼中到，斗柄横斜天未晓。\n鹤梦初醒露气寒，旧巢飞出云松倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五祖将禅人求颂","author":"释正觉","text":"东风吹断濡华雨，淮上秀峰青可数。\n束屦欲寻南北山，卷衣又别东西祖。\n渊鱼蒲鸟闹一家，汀笋溪蔬甘两箸。\n处处相逢记得么，夜寒月在珊瑚树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从首座画予于松石间求赞","author":"释正觉","text":"孤坐默默，倚杖沉沉。\n石怀云而无像，松啸风而有音。\n应兮珠盘不拨而自转，湛兮玉井随汲而弥深。\n诸尘不受兮十分清气，三际无寄兮一片閒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师画像赞 二祖大祖禅师","author":"释正觉","text":"立雪齐腰，求法断臂。\n有志忘诸躯，无心契诸己。\n了了常知，其知密微。\n妙不借口，的自传衣。\n全功归父底时节，拈转虚空绝所依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师画像赞 三祖监智禅师","author":"释正觉","text":"道无拣择，宗非促延。\n死生外著，清白家传。\n觅罪性空，廓然大同。\n妙尽亡能境，机回却借功。\n虚明自照靡心识，海月灵犀夜魄通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师画像赞 五祖大满禅师","author":"释正觉","text":"奇女之儿，双峰之嗣。\n传衣世称乎妙龄，栽松我愧乎颓齿。\n前后两身，古今一心。\n孤鸾风舞玻璃镜，长鲸月辗珊瑚林。\n钵盂狤獠人将去，几夜舂坊无碓音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师画像赞 六祖大监禅师","author":"释正觉","text":"广南樵夫，淮西行者。\n明珠走盘，黄金出冶。\n透影像兮凡圣罔得同尘，续光明兮家世自然不夜。\n众星之拱斗之魁，百川之趋海之下。\n弃钵袋而逃，提不起而恳招。\n非风幡之摇，示即物之情超。\n叶落归根兮来时无口，百千三昧兮九牛一毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师画像赞 四祖大医禅师","author":"释正觉","text":"授屈眴衣，秉毗卢印。\n师坐西山，名称东震。\n蜂服之粉兮春蜜之滋，蚌肠之珠兮夜蟾之孕。\n远气呈祥，灵枝发旁。\n牛头接得融居士，华鸟不来庵外忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六代祖师画像赞 初祖达磨禅师","author":"释正觉","text":"西付不了，东行相讨。\n大乘气遥，少林春早。\n九年面壁，求人而急。\n三拜髓传，得嗣而贤。\n芦华明月夜船转，水远天低秋色连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王承事写真求赞","author":"释正觉","text":"苍棱羼颜，璠玙蕴石而辉山。\n老节岁寒，琥珀抱松而永年。\n威音未兴之际，混沌欲凿之前。\n丛林大义兮道尊百丈，刹海平潮兮月现三千。\n我为你说法，你为我开田。\n据坐松根石头上，知音人信默心传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仗锡为长老写真求赞","author":"释正觉","text":"木老春迟，山寒雪早。\n潮退珊瑚林，霁空明月晓。\n守默自如，对缘恰好。\n得往得来，随起随倒。\n龙潭觑破天皇，马祖踏著水潦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]