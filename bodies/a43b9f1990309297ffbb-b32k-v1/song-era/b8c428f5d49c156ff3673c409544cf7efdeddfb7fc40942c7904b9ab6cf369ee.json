[{"title":"千秋岁","author":"高伯达","text":"影摇波动。\n晓日浮华栋。\n庆麟绂，徵兰梦。\n绿擎龟叶小，红拂莲腮重。\n帘幕外，半天仙驭来飞鞚。\n两两骖鸾凤。\n□窣珠衣纵。\n香雾散，祥云拥。\n口传金母信，酒为麻姑送。\n休惜醉，与君更下蟠桃种。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉宫春 寿张安国舍人","author":"高伯达","text":"绛阙朝元。\n倦飞鸾控鹤，来寓人间。\n天教散舒和气，好与春还。\n蓬瀛罢宴，褪仙裳、欲冠貂蝉。\n应是念、潇湘胜概，来与蕃宣。\n宣室向来初见，叹不如、文帝夜半虚前。\n多情吊沉赋罢，莫负留连。\n经纶事叶，向朝廷、谁与争先。\n明岁好，云屏间坐，十分宣劝金船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"高伯达","text":"海上蟠桃月样圆。\n从头屈指几千年。\n双成已报春消息，输与萧郎半月前。\n风露晓，月华鲜。\n兽炉烟袅水沉烟。\n骑鸾驾鹤休归去，留取人间作女仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"高伯易","text":"函颅谨勿为终策，天下英雄暗破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王文公祠","author":"高孝璹","text":"虚名自看数椽庐，流毒于今几卷书。\n拟代周颙报山鬼，移文逋客请先渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题临安西湖","author":"高孝璹","text":"珠帘白舫乱湖光，隔岸龙舟舣夕阳。\n今日欢游复明日，便将京洛看钱塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹤梁观石鱼","author":"高应乾","text":"访胜及春游，双鱼古石留。\n能观时显晦，不逐浪沉浮。\n守介难投饵，呈祥类跃舟。\n胥归霖雨望，千载砥中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"干友人诗","author":"高言","text":"昨夜阴风透胆寒，地炉无火酒瓶乾。\n男儿慷慨平生事，时复挑灯把剑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨作 其二","author":"高定子","text":"诗到眉山自一家，也将正命摄于邪。\n巧裁大涤天成景，戏咏庭蛟与洞鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨作 其三","author":"高定子","text":"两閒洒落无尘著，万象森罗触处逢。\n此意要令儿辈觉，擎天一柱爱中峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨作 其一","author":"高定子","text":"牵丝晨谒玉皇家，唤起慵龙乞井花。\n醒看满山枝叶语，晚唐句子是萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登洪庆观河亭","author":"高昌","text":"霜旄行郡试寻幽，一曲围垣绕县周。\n山色迎人来黛嵋，河声惊梦撼黄流。\n禹门水迥乡关月，济庙烟连草树秋。\n遥指天南嵩洛近，烟云何处望神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏华林书院","author":"高绅","text":"元秀峰前累世居，圣朝旌表振门闾。\n四方来客多登第，一邑为儒喜读书。\n诗阁夜闻吟木狖，水亭晴见戏荷鱼。\n石娇华表溪山里，晚景寒烟尽不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游峡山飞来寺","author":"高绅","text":"古寺清江上，维舟夕照前。\n山根盘到海，塔影直侵天。\n萝月空禅石，霜钟落客船。\n秋风懒回首，送目入云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒阙里 其一","author":"高诩","text":"帝王而下几兴亡，销尽繁华作战场。\n惟有东家诗礼在，子孙万古读书堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪兴","author":"高质斋","text":"湖上人家万木村，白云深护读书门。\n年来不管头颅白，自贺清风酒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田园偶兴","author":"高质斋","text":"绕檐风景接崆峒，生计年年乐岁丰。\n布谷声传红杏雨，□□调起绿杨风。\n桑麻远近千村里，禾黍高低一望中。\n每与邻翁相庆社，醉歌不惜酒樽空。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复和呈莫仲篪","author":"高质斋","text":"溪石绣苔绿，溪风飘晚凉。\n坐久得自若，物外知谁忙。\n渴饮竹泉冷，饥饭松花香。\n春光忽云暮，□□□□阳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日溪亭","author":"高质斋","text":"帘捲柴桑晚，深山俗驾疏。\n荒苔留鹤迹，落叶带虫书。\n竹翠侵香案，泉声漱石渠。\n烟霞便一枕，应笑把犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪石呈李思道","author":"高质斋","text":"共坐溪边石，溪清心自凉。\n鱼惊烟艇过，鸥笑野人忙。\n细草侵衣绿，飞花点鬓香。\n东风尘暂息，拍手送斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉溪晓步","author":"高述","text":"平生丘壑情，得此真忘形。\n抠衣跨石角，开道披林坰。\n日影晓峰翠，猿啼山柿青。\n三潭在何许，已约摸重屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流花亭","author":"高述","text":"翚檐临古岸，玉砌近重闉。\n指点寻仙路，留连劝酒人。\n水流还似旧，花落又逢春。\n客到此亭下，眷言休问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋玉溪寺石菖蒲","author":"高述","text":"玉溪石角尖如锋，山泉喷浸碧玉龙。\n龙髯谁为不可识，石上菖蒲拳碧茸。\n老根密节穿石瘦，细叶如林屯远岫。\n百草烂死事潜萌，纤纤独与冰霜斗。\n玻璃玛瑙春水寒，呼儿捧将持铜槃。\n年来青眼志未丧，喜君绿发能冲冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"高述","text":"谪仙此酹月，郎官亦流风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子","author":"高宣教","text":"去又如何去。\n住又如何住。\n但得山花插满头。\n休问奴归处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜","author":"高彦竹","text":"辘轳梦断金梧井，夜月沉沉风露冷。\n起向庭中独自行，伴人惟有梅花影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡彦龙过金陵","author":"高彦竹","text":"金陵往事已成虚，江水清清只见鱼。\n遗庙空存元帝像，故家多有二王书。\n秋风出塞调生马，夜月吟淮跨蹇驴。\n借问新亭诸老泪，而今烟景复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"高载","text":"拟约沧江异姓兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"右军祠堂","author":"高祖之","text":"一麾东晋守，八体入神书。\n墨水传遗迹，兰亭表旧居。\n挂冠高兴逸，坦腹旧床虚。\n峻岭崇山景，依然想似初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太息","author":"高选","text":"天运逢南度，和成势已移。\n山河怜破碎，草木亦伤悲。\n铁骑驰中土，烽尘隘北陲。\n哀臣双泪眼，岂畏朔风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞安县咏怀","author":"高选","text":"一经逢圣世，衔诏下神州。\n才陋惭无补，官卑得自由。\n刑威存抚字，赋役敢诛求。\n何日乘公暇，溪山策骑游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题家信后","author":"高选","text":"十载慇勤训子情，礼闱今幸占微名。\n彤庭策献三千字，鹏海风抟九万程。\n帽插宫花琼宴罢，身沾仙露赐衣荣。\n瞻云北阙人迢递，空忆高堂雪鬓生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅","author":"高荷","text":"少镕蜡泪装应似，多爇龙涎臭不如。\n只恐春风有机事，夜来开破几丸书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"高荷","text":"妄作非吾事，罢官饥尔曹。\n此心常去住，何日遂孤高。\n雁伴乌疮脱，蝇营狗跛劳。\n不如张仲蔚，门外长蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答山谷先生","author":"高荷","text":"四篇诗得袅蹄金，妙旨初临法语寻。\n要我尽除儿子气，知公全用老婆心。\n平章许事真难可，付嘱斯文岂易任。\n感激面东垂涕泗，高山从此少知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上黄太史","author":"高荷","text":"万里南溪郡，黄香得赐环。\n盛名喧海内，摧翮返云间。\n太史资诚峻，郎官选亦悭。\n朝廷才特起，堂奥援谁扳。\n一梦追前事，群公厄后艰。\n中伤皆死祸，放逐罕生还。\n别驾之戎僰，侨居傍草菅。\n想知谙鸟道，闻说异人寰。\n杨子家元窘，王维室久鳏。\n鵩来心破碎，猿叫泪湲潺。\n达观终难得，羁愁必易删。\n众情相恻悯，灵物自恬憪。\n迥阁澄秋晚，幽窗耸夜跧。\n蜀天何处尽，巴月几回弯。\n坠履魂空断，遗弓涕忽潸。\n石门凄殿楯，铜雀惨宫鬟。\n帝统联仁圣，皇恩感艳顽。\n网罗疏党禁，诛蔓扫朋奸。\n点检金闺彦，凋零玉笋班。\n尚令宗庙器，遥隔鬼门关。\n拊髀咨询及，含香诰命颁。\n笑谈趋赤县，吟咏落乌蛮。\n奏记怀东观，移文颔北山。\n应将九迁待，未补七年闲。\n士愧千钧弩，身谋五两纶。\n退藏欣望气，延仰窃窥斑。\n昌谷词源窄，浯溪笔力孱。\n斲轮深类扁，投斧欲随般。\n鹄卵真能伏，龙鳞敢冀攀。\n不嗔无绍介，试遣略承颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和山谷题李亮功家周昉画美人琴阮图","author":"高荷","text":"丹青有神艺，周郎独能兼。\n图画绝世人，真态不可添。\n却怜如画者，相与落谁手。\n想像犹可言，雨重烟笼柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"高荷","text":"浪头送过皇天荡，夕阳引到乌衣巷。\n恶风退作六鹢飞，清秋不成一鹗上。\n故人情亲在千里，万金不如一番纸。\n望断云边鸿影稀，似听枝间鹊声喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"国香","author":"高荷","text":"南溪太史还朝晚，息驾江陵颇从款。\n綵毫曾咏水仙花，可惜国香天不管。\n将花托意为罗敷，十七未有十五馀。\n宋玉门墙纡贵从，蓝桥庭户怪贫居。\n十年目色遥成处，公更不来天上去。\n已嫁邻姬窈窕姿，空传墨客殷勤句。\n闻道离鸾别鹤悲，藁砧无赖鬻蛾眉。\n桃花结子风吹后，巫峡行云梦足时。\n田郎好事知渠久，酬赠明珠同石友。\n憔悴犹疑洛浦妃，风流固可章台柳。\n宝髻犀梳金凤翘，尊前初识董娇饶。\n来迟杜牧应须恨，愁杀苏州也合销。\n却把水仙花说似，猛省西家黄学士。\n乃能知妾妾当时，悔不书空作黄字。\n王子初闻话此祥，索诗裁与漫凄凉。\n只今驱豆无方法，徒使田郎号国香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸平亲郊八首 其六 饮福用《禧安》","author":"郊庙朝会歌辞","text":"祀帝圜丘，九州献力。\n礼行于郊，百神受职。\n灵祗格思，享我明德。\n天鉴孔章，玄祉昭锡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"高载","text":"自是去凶明国是，毋轻函首启戎奸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下读书","author":"高得心","text":"芸叶满床尘梦稀，空林对雨淡相依。\n閒身不与时荣谢，抱膝惟评古是非。\n蕙帐风寒人未老，松门云静鹤初归。\n青山紫阁原同道，肯羡宫袍耀布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送钤辖馆使王公","author":"高惟几","text":"游宦俱为关外人，与君五看海棠春。\n园林选胜联镳遍，风月相思命驾频。\n大旆先时辞蜀道，短辕何日见京尘。\n子牟又起离群恨，欲操行祛重怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"高惟几","text":"故国庸岷外，孤根楚苑中。\n使梅休妒白，仙杏已饶红。\n旋恐阳城破，寻忧下蔡空。\n几时梦巫峡，独立怨春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"高惟月","text":"岩扃不锁，算空洞深窈，是谁初凿。\n帝遣六丁持月斧，乱把云根镵斫。\n骇目奇观，恍如崩浪，汹涌从天落。\n谪仙何处，翠珉佳句如昨。\n惆怅白首重游，多情还似，与青山有约。\n且对清尊酬胜赏，休想舞衣歌乐。\n景物依然，头颅如许，何事嗟漂泊。\n翩翩归兴，故山无限林壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"心远堂","author":"高晞远","text":"种竹期十年，栽橘盈千头。\n虽云多远虑，无乃为身谋。\n高人绝尘累，俟德居此丘。\n泰宇无畦畛，虚空有天游。\n仁义尚蘧庐，道德成安流。\n结茅依翠微，极目际平畴。\n白云度寥廓，黄鹄下沧洲。\n百世此周览，我志尚可求。\n祇应柴桑翁，真趣共悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"高晞远","text":"梦绕荆溪，蟹肥春瓮满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瀛岩","author":"高袭明","text":"温台万丘壑，走遍成重胝。\n佳山落床头，咫尺反不知。\n我闻野老说，山乃神所移。\n蓬莱本三峰，一峰今失之。\n上干云霓秀，下压鳌背攲。\n夜半见海日，紫晕开咸池。\n魑魅看老木，狂鼯向人啼。\n危亭无遗栋，绝壁无旧题。\n夫子勇我过，竦身敢独跻。\n我病不能从，梦寐常追随。\n秋风海上来，霜清鲈正肥。\n行寻越溪鞅，肃此尘外鞿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登山顶","author":"高辅尧","text":"由径寻山路，登临步步疑。\n纵高终带险，任达亦须危。\n况是多防地，那堪独力时。\n荆榛方栉比，直道拟奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳楼晚眺即事叠韵四首 其二","author":"高善濂","text":"无聊凭眺日西斜，替恨成啼集暮鸦。\n远树云中浮墨障，游鱼镜底动菱花。\n临高每忆登楼赋，遣兴还尝觅句茶。\n到处羁愁多瑟缩，何如烟浦钓人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳楼晚眺即事叠韵四首 其一","author":"高善濂","text":"危楼缥缈倚阑斜，无数残阳噪乱鸦。\n过客扬帆冲雪浪，渔人举网出银花。\n子声落纸閒听奕，舌本留香为别茶。\n巫峡潇湘恣极览，谁言远望当归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞庭晚望七首 其一","author":"高善濂","text":"击汰凉风水面回，偃虹堤上夕阳开。\n含浆老蜌浮光起，迎棹神鸦舞翅回。\n醉唱难寻渔笛乐，羁怀易动暮笳哀。\n何能雪鹭银鸥侣，尽日无愁曲岸隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞庭晚望七首 其二","author":"高善濂","text":"西塞烟痕向晚横，登临聊复上重城。\n湖边汇泽流千派，望里长峦翠一桁。\n归楫江皋频错认，怀人天末最关情。\n散愁商隐还乘兴，只恐风波愁转生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其十三","author":"高斯得","text":"阜录新书幸已成，名山藏去复传人。\n毋令十载编摩苦，竟与家书共厄秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其十二","author":"高斯得","text":"囊封癸酉罄愚惷，第一亲征次守江。\n啼得血流无用处，自怜弱步要丰扛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其十一","author":"高斯得","text":"覆按山陵挈累行，金多季子橐赍轻。\n殿中御史尤堪戮，尽室逃归骇一城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其十","author":"高斯得","text":"乘桴颐浩元无策，进跸丰公妙达权。\n宁死老身终不去，太皇此语可回天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其九","author":"高斯得","text":"督帐行趋建业东，壮哉迎敌气如虹。\n劝君猛舍一腔血，莫学檀公误乃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其八","author":"高斯得","text":"彊买民田自噬肤，大家破尽为催租。\n几多怨气冲霄汉，天欲无诛可得乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其七","author":"高斯得","text":"无罪无辜窜逐人，几经大霈不沾恩。\n更将改正张罗网，结尽千千万万冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其六","author":"高斯得","text":"扫除学法啖诸生，精锐销磨直可坑。\n乞斩三奸亦人尔，汝曹何忍负斋黉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其五","author":"高斯得","text":"国家元气是人材，稍露光芒尽力摧。\n今日举朝皆妇女，邦衡此语亦诚哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其四","author":"高斯得","text":"军功阁束万人多，兵部门前雀可罗。\n悍将武夫心失尽，可知弃甲与投戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其三","author":"高斯得","text":"先帝方归盛德园，龙輴半夜浙江边。\n孤臣泣血无他请，愿把奸臣诉九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其二","author":"高斯得","text":"金缯私许北方盟，君父前头却隐情。\n今日祸胎从此始，罪浮孽桧与权京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤愤吟十三首 其一","author":"高斯得","text":"桧侂当权十五年，始终只被一私缠。\n人心失尽天心怒，燎火炎炎故不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻杨元极去国","author":"高斯得","text":"倾厦难将一木支，微垣累疏亦何为。\n凤凰本自翔千仞，不待区区夺我池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]