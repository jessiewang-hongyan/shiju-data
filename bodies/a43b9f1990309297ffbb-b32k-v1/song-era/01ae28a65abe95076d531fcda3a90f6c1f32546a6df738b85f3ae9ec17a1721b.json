[{"title":"郝泽民主簿赠诗次韵二首 其一","author":"陈造","text":"夫君糠秕视钱神，诗逼黄初论借秦。\n义槩咸推天下士，簿曹聊见宰官身。\n茶香延客自不饱，书币踵门谁可人。\n从古功名多晚节，相逢双鬓未妨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郢州二首 其二","author":"陈造","text":"满慰人间渴雨心，未收云霭定为霖。\n怜渠沾水论涓滴，况我行舟苦滞淫。\n已涨麦田千里碧，更添沙料一篙深。\n小軿会指晴山去，布谷提壶各好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郢州二首 其一","author":"陈造","text":"古郢繁华得少留，披云更喜识贤侯。\n径容拱挹侍谭笑，怪底咄嗟成献酬。\n罗绮香中偷醉眼，蕙兰丛里掉吟头。\n何如白玉堂中客，试问樽前小莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九山阳仪真两使君送酒","author":"陈造","text":"酒会文期兴尚浓，佳辰一笑坐天穷。\n两州各遣六从事，九日俄成一病翁。\n诗不受催空急雨，帽无缘落任西风。\n明朝晴径通行屐，却漫枝筇绕菊丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻师文过钱塘二首 其二","author":"陈造","text":"九堰三江外，攲帆侧柂频。\n海鲜当日箸，雨鹊定随人。\n椒酒须分岁，江梅巧借春。\n团栾多乐事，未沬物华新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻师文过钱塘二首 其一","author":"陈造","text":"行役儿无虑，衰怀自不忘。\n待潮何处泊，听雨共更长。\n指俟乌供哺，先容雁著行。\n更宽三日计，茫苍下归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻盱眙北使信感事再次韵","author":"陈造","text":"猰犬妖狐合故栖，函关底限一丸泥。\n幄中已办吞青海，甲外宁惟馘白题。\n犁老上庭烦指顾，笞中行背问颠迷。\n提封旧物渠须计，一候鞮汗更向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香云寺","author":"陈造","text":"山月明空隙，庭柯下槁乾。\n沈沈僧夜静，漠漠雁天寒。\n梦境愁偏隔，诗情老易阑。\n未容辞水厄，聊复踞蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"頫江楼分韵得春字","author":"陈造","text":"子政文笔劲，武陵豪气振。\n高骞霄汉步，分占燕莺春。\n造化归吟思，樽罍著散人。\n芳时好宾主，载酒未妨频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凌晨复有惠急笔次韵 其二","author":"陈造","text":"仕涂决矣息交游，姑向林泉访胜流。\n短褐直甘乘下泽，异乡终胜赋登楼。\n惊心梦境檀槐战，屈指乡园秫稻秋。\n雉翳龟燋缘有用，未闻金弹中沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凌晨复有惠急笔次韵 其一","author":"陈造","text":"小驻江干接隽游，渭清泾浊可同流。\n假真笑我陈惊坐，造妙推君赵倚楼。\n姓字已高时辈上，功名尤忌鬓毛秋。\n等闲莫学金华伯，碧水如天拟梦鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜饮客","author":"陈造","text":"矻矻官曹兴易穷，得闲何惜一樽同。\n傍愁边到无恶客，从竹间来皆好风。\n胜日诗狂输酒圣，转头渭北复江东。\n雕鞍未作扶携去，更放兰缸子夜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴新守致语口号","author":"陈造","text":"相门贤裔圣门儒，锦席葩罗庆合符。\n天敛沉阴输瑞霭，月衔清影照冰壶。\n鸾胶密应锵金奏，麟脯何妨荐玉腴。\n闻道山城观盛事，一时歌舞溢通衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐陶会","author":"陈造","text":"松底轩窗卸虎鞯，竹帘闲袅石炉烟。\n山间风日小春后，会里杯盘长至前。\n蚁子醪敷能及客，弹圆侯栗不论钱。\n岩栖野啸平生意，失脚尘埃雪满颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽章 其二","author":"陈造","text":"少微前夕欲无光，白首俄传地下郎。\n一代衣冠郭太宅，百年文物郑公乡。\n松烟黯惨空黄壤，芝检纷纶漫紫囊。\n人过新阡应下马，不论知识涕滂浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留交代韦倅","author":"陈造","text":"山城老稚竞攀辕，况复官曹辱后先。\n敢爱一樽追笑语，未妨五日作留连。\n天香国色酡颜去，渭北江东把臂前。\n已办明朝开煮酒，丝桐小置式微篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留行都","author":"陈造","text":"久饫南来饭，长维北去船。\n薰衣子笑韵，入箸望潮鲜。\n意适忘漂泛，吾生计食眠。\n归期何用数，宽待藕花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中书怀二首 其二","author":"陈造","text":"促促浮生忽二毛，安心有法赖禅逃。\n梦知二竖今相避，仇问三彭底许饕。\n世路从今蜗两角，灯窗姑置兔千毫。\n破颜细点功名录，祇许渊明酒处高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中书怀二首 其一","author":"陈造","text":"少日清孤效乐天，谏书未落世间传。\n曾圆八节滩头梦，重了三生石上缘。\n雪竹霜林便老境，蒲团禅板付臞仙。\n诗篇把玩真聊尔，古井无波敢自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起二首 其二","author":"陈造","text":"即病偷闲却自怡，坐凭竹几独多时。\n铜炉烟畔熏风度，药臼声中昼漏迟。\n政自腐肠严酒戒，不应了事悔儿痴。\n净名文惠谁优劣，为问沾沾造化儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起二首 其一","author":"陈造","text":"吏民两两议公痴，簿领空勤笑语稀。\n元亮有诗新止酒，休文多病不胜衣。\n飞尘懒拂孤三绝，止水初澄悟百非。\n窗度凉飔残午梦，闲听喜鹊啅斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起閒步","author":"陈造","text":"瞑绿园亭小雨晴，病翁双眼为谁明。\n柳如张绪不殊昔，竹与子猷相对清。\n门下鸟乌无客到，壁栖蛇蚓又诗成。\n回头溪友千山阻，更向何人话此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盐城阻冰雪赠陈德美三首 其三","author":"陈造","text":"雪意知呈瑞，还欺客鬓星。\n悲欢随处异，艰阻向来经。\n梦境翩蝴蝶，宗盟近脊令。\n盘餐更谭麈，足用慰漂零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盐城阻冰雪赠陈德美三首 其二","author":"陈造","text":"身口真相累，风霜得备尝。\n即今歌匪兕，未慭反屠羊。\n辟谤规闲口，因衰再覆觞。\n不知诗酒外，何计逭悲凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盐城阻冰雪赠陈德美三首 其一","author":"陈造","text":"断港冰初合，穷涂岁欲除。\n临年仍此悔，议道得无疏。\n抚事空搔首，何人为寄书。\n海风吹浩荡，侧望正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸公邀留不及赴次前韵寄谢","author":"陈造","text":"一失浓欢悔可追，故人应念独醒时。\n回思翠幕围香雾，定复长虹起砚池。\n照应鼎来联璧客，风流羞死聚蚊儿。\n当时枉重千金诺，不见芳辰卜夜嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调官归","author":"陈造","text":"穰穰衣冠地，眈眈公辅居。\n云霄有捷径，尘土且长裾。\n老去怀归切，生知与世疏。\n解装漫刺在，况说子公书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其八","author":"陈造","text":"年年汉臣节，春雁与同归。\n番俗尊华服，皇家后武威。\n市中斜毼贱，水外拂庐稀。\n南北皆生息，和亲果是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其七","author":"陈造","text":"向来经世蕴，每作负山驰。\n鬓发不留黑，京尘惭旧缁。\n生涯黄卷在，心事白鸥知。\n回首林泉癖，穷吾不为诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其六","author":"陈造","text":"犬吠葱青里，人家竹径深。\n短篱循石涧，老屋枕烟岑。\n牛瘠知春事，鸠啼认晏阴。\n丰年易为客，杯酒慰幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其五","author":"陈造","text":"路恶惟沙碛，山回忽市廛。\n楼台明晚照，花竹暝寒烟。\n生事知无警，欢声验有年。\n犹嫌武陵遇，不载割淮鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其四","author":"陈造","text":"关塞凄凉处，青徐指顾边。\n如何汉正朔，不尽禹山川。\n将略轻三捷，天威重万全。\n诸公不愒日，老子判留年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其三","author":"陈造","text":"新居得翠微，景趣自幽奇。\n白石群羊卧，脩篁翠葆攲。\n山光衔睥睨，云影傍藩篱。\n席户无车马，禽猿不更疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其二","author":"陈造","text":"天外纤云尽，山巅望眼遥。\n平淮剪绿野，白塔界晴霄。\n客里风光异，吟边物象骄。\n功名它日事，回首兴萧条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁八首 其一","author":"陈造","text":"淮汴朝宗地，孤埤只眼前。\n谯楼西日淡，戍鼓北风传。\n破竹非无计，浇瓜亦自贤。\n客愁浑几许，抚剑倚吴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都梁涂中","author":"陈造","text":"西来行路未妨长，敢指淮山作异乡。\n随处馈浆惊禦寇，有人酬药话韩康。\n柳方弄色新经雨，云似多情巧护霜。\n风俗淳厖节物好，一樽时与倒诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪盱眙王使君东游四首 其四","author":"陈造","text":"风林山阙处，茅舍两三家。\n小驻回鹘队，重寻粟玉花。\n疏烟横暖霭，碧溜漱晴沙。\n野兴未渠尽，数峰明晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪盱眙王使君东游四首 其三","author":"陈造","text":"红旗围皂盖，离迾碧山隅。\n水色涵云树，宾筵著画图。\n香温金凿落，花亚锦屠苏。\n醉里银丝鲙，渔舟不待呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪盱眙王使君东游四首 其二","author":"陈造","text":"缆解鸥飞处，船移柳影中。\n林庐桃李月，浦溆蕙兰风。\n酒浅能无醉，歌长惜有终。\n赋诗聊泚笔，寓意未须工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪盱眙王使君东游四首 其一","author":"陈造","text":"锦席浮波影，牙樯转雾霏。\n飞花窥碧酒，舞蝶傍红衣。\n野日歌前淡，云峰望处微。\n游鱼应与乐，啼鸟莫催归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高头山","author":"陈造","text":"小驻缘云脚，居然睡眼醒。\n楚田衔树阔，汉水挟山青。\n蹀躞初忘倦，巉岩已饱经。\n川原方啖蔗，不拟叹漂零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽章四首 其四","author":"陈造","text":"精一心传后，功隆道固存。\n徐乘仙驭去，往俪玉皇尊。\n典诰无遗意，臣民有断魂。\n嵩灵弓剑望，愁雾惨中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽章四首 其三","author":"陈造","text":"天地重开辟，华夷赴指挥。\n群生欣按堵，三纪仰垂衣。\n凤历虽无极，龙楼忽告违。\n广成谭道处，千古想骖騑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽章四首 其二","author":"陈造","text":"措俗皇风粹，怡神象帝先。\n宝图传圣嗣，金阙觐群仙。\n典训昭如日，华夷痛所天。\n衣冠游历地，一一泪河前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽章四首 其一","author":"陈造","text":"雨露均皇泽，丹青焕帝猷。\n恢图自天运，授圣与神谋。\n方眕脩龄梦，俄偕造物游。\n姑山馀四子，不复候琼辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偕章宰劝农房山 其一","author":"陈造","text":"登临一拟豁心胸，著我松窗竹屋中。\n宛是官曹缚雕虎，不容尘眼到飞鸿。\n绵延天际应平碧，孤负林梢抹嫩红。\n俛仰去年舒啸地，解衣聊复近熏笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿何人家","author":"陈造","text":"步寻松筱款谽谺，忽到孤山处士家。\n十顷苍鳞漾墙角，一钩寒玉插檐牙。\n杯行不乏红丝鲙，饭了仍供白露芽。\n把臂倾舒吾已怯，又分离绪上归槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄丁主簿","author":"陈造","text":"江边聚首偶经旬，自挽园蔬拂甑尘。\n老桧根株官舍古，凉蝉风露贼曹贫。\n斑骓去后情无那，紫燕飞还句更新。\n一舸东浮待秋老，菊花芦叶定留宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄乡中亲友二首 其二","author":"陈造","text":"坐衙随分吏分行，退食还先药探囊。\n已为河鱼废诗酒，彊教笼鸟听宫商。\n老犹苟禄宁良计，病悟休心是秘方。\n想见亲朋迟归楫，为翁补漏斸空荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄乡中亲友二首 其一","author":"陈造","text":"棋酒游从叹离群，酒床吟笔漫飞尘。\n潮乎可奈才力老，甫也尚为南北人。\n安信不随秋雁到，流年倏复野梅新。\n南岗北阜凭高地，引首吴天几怆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄乡中亲旧","author":"陈造","text":"携书忆上上江船，撚指官曹欲二年。\n白傅病多空自叹，老坡仙去却虚传。\n人生脩短庸非命，我判浮休不问天。\n来岁过君定惊笑，尚堪诗酒与周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王仲衡尚书","author":"陈造","text":"世态翻云覆雨间，令人合眼梦还山。\n生平名义非肝膈，岁晚师门要面颜。\n鸥鹭波宽虽有约，凤凰城近可容闲。\n留年看试调元手，未拟安仁赋拙艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王尚书","author":"陈造","text":"一昨家庭拜帝纶，熊轓催去不逡巡。\n小迟绣衮升元辅，复向蓬莱作主人。\n竹马未迎欢意浃，蒲鞭重试教条新。\n诗赓乐职诸生事，笔力谁今斡万钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄幼度主簿","author":"陈造","text":"辞家暑雨溅红蕖，转首荞花已雪如。\n岁月祇随流水逝，笑谈陡与故人疏。\n简书我正罢长道，归棹君行指旧居。\n他日霜风吹梦破，空从旅雁觅来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兴化叶明府进卿二首 其二","author":"陈造","text":"一昨连甍较诈狙，缿筒合斗未良图。\n君来嚬笑民之法，政绝锋铓古与徒。\n俗变身如游建德，时清人不畏萑苻。\n自公日有诗书乐，大府仍无急急符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兴化叶明府进卿二首 其一","author":"陈造","text":"奥学居瞻数仞堂，业文自笑及肩墙。\n平时江月工分影，胜日篝灯约对床。\n身世我方怜枘凿，风期君肯遽参商。\n相忘两舍虽匏系，当有诗筒访士乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兴化徐尉二首 其二","author":"陈造","text":"自折河桥柳，何人慰寂寥。\n一书宁用靳，两舍未为遥。\n瓜戍装应趣，荆扉兴自饶。\n回头五云处，犹肯访渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄兴化徐尉二首 其一","author":"陈造","text":"敬问昭阳尉，餐钱得饱无。\n时方依绛帐，课谢剪萑苻。\n宾俎仍黄雉，书窗了白驹。\n低回自爱惜，才业正时须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄师文二首 其二","author":"陈造","text":"萍梗漂浮已老翁，归来差乐未终穷。\n稻田取足随丰歉，花圃逢春自白红。\n禅老版头容客饱，臧孙鼎足祇墙东。\n更闻名酒新传法，诗外棋边莫放空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄师文二首 其一","author":"陈造","text":"世涂岂必尽笼囚，自是迂疏拙应酬。\n簿领婴心宁素志，梦魂何日不沧洲。\n揆吾温饱儿堪托，平昔行藏妇与谋。\n已判来年拂衣去，寄言亟办钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄师文二首 其一","author":"陈造","text":"父子相为命，淮乡望海隅。\n谁非牛舐犊，心羡燕将雏。\n綵服藏书蠹，青春负隙驹。\n营营温饱计，犹恐未良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄师文二首 其二","author":"陈造","text":"阿泰知何似，无书坐地偏。\n未妨归缓缓，可免意县县。\n肖父仍便酒，如翁不蓄钱。\n况须供老眼，欲说已欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈居仁二首 其二","author":"陈造","text":"尚记诛茅柳外堤，水光摇雾润窗扉。\n桑间曾是僧三宿，海上能忘鹤一归。\n野店樽罍醅脚酽，比邻鸡鹜稿头肥。\n解颜一醉平生事，更向行藏计是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈居仁二首 其一","author":"陈造","text":"鹊语晨檐灯夜花，双鱼随客到寒家。\n交情从昔金可断，别梦即今天一涯。\n风雨对床他日意，雪霜欺鬓与时加。\n阅人半世花开谢，更觉松筠耐岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄侄","author":"陈造","text":"拥衾听良夜，风叶不馀飞。\n天地清霜冷，江湖旅雁归。\n幽人惜短梦，游子念征衣。\n穷老人间世，愁城屡合围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄真州诗社诸友","author":"陈造","text":"畴昔离亭酒一钟，酒杯不比别愁浓。\n羡君联璧方保社，付我耦耕亲老农。\n握手陈雷便胶漆，几时韩孟果云龙。\n自今笔砚还高閤，可是诗情病后慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]