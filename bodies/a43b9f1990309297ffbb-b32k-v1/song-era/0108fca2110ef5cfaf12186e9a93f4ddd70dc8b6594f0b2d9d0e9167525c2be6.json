[{"title":"春行","author":"真山民","text":"短帽轻衫步履迟，微暄天气乍晴时。\n池融嫩碧消残冻，春剪新红缀旧枝。\n岚翠滴衣堪入画，禽声到耳足供诗。\n东风苦欲招人醉，频掉桥西卖酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓园中","author":"真山民","text":"绿阴留我立，清晓小阑东。\n林外一鸠雨，柳边双燕风。\n吟怀愁渺渺，春事去匆匆。\n莫恨芳菲尽，葵榴花又红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓雨","author":"真山民","text":"破晓檐花未放乾，披衣和梦倚阑干。\n酿成苔晕地犹湿，老尽莺声风正寒。\n无客醉敲金镫响，有人睡怯翠衾单。\n牡丹一夜成消瘦，下却珠帘不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游和胡叔芳韵","author":"真山民","text":"春光泼眼明，占胜得新亭。\n棠醉风扶起，柳眠莺唤醒。\n非无杯泛绿，安得鬓皆青。\n且事日为乐，歌声莫暂停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春感","author":"真山民","text":"春光元自好，我却为春愁。\n但见柳青眼，不知人白头。\n一身浮似寄，百岁去如流。\n赖有芳樽在，花前日醉游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐","author":"真山民","text":"寒斋淡无味，孤坐思悠悠。\n时事三缄口，年光一转头。\n有书遮老眼，无药疗閒愁。\n假使丹心在，衰迟也合休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜次叶一山韵","author":"真山民","text":"自笑秋来似转蓬，偶然飞落过山中。\n一灯幽馆菊花雨，孤枕小楼梧叶风。\n涉世悠悠旋磨蚁，怀人杳杳寄书鸿。\n浮生何预光阴事，抵死相催作老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晚","author":"真山民","text":"暮色入江郊，霜风两鬓毛。\n笛声吹月落，诗兴挟秋高。\n谢绝南柯蚁，留连左手螯。\n孤灯竹窗底，危坐一歌骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送云泉入山","author":"真山民","text":"薜萝丛里郁青青，别是幽栖一段清。\n水色山光皆画本，蝉声禽语亦吟情。\n人今不改衣冠古，道重方知富贵轻。\n为语俗交休见问，已从麋鹿订新盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜约张梅境饮","author":"真山民","text":"今日又除夕，君能为我来。\n烛光红照席，酒浪绿摇杯。\n腊带愁吟去，春随笑脸回。\n相看俱健在，莫管岁华催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"真山民","text":"虚窗暑亦凉，境静昼偏长。\n树色烟明灭，蝉声风抑扬。\n家贫书是业，身老睡为乡。\n赤日黄埃客，纷纷为底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留槎阁寓感","author":"真山民","text":"俯仰乾坤为一嗟，西风原上夕阳斜。\n石麟已换延陵冢，银汉今无博望槎。\n前古英雄俱寂寞，黄昏灯火自諠哗。\n不惟人事年年改，近日灵洲水没沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读刘元城言行录","author":"真山民","text":"一扫权奸九十章，七州不惮历炎荒。\n黄粱富贵百年短，青史是非千载长。\n丞相虽存心已死，先生既葬骨犹香。\n向令铁汉常留在，天下何缘有靖康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿宝胜寺","author":"真山民","text":"苦吟吟未了，只向两廊行。\n月去塔无影，风来铎有声。\n禅心随水净，佛眼共灯明。\n安得云边住，与僧分此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿南峰寺","author":"真山民","text":"禅房花木锁深幽，借与诗人信宿留。\n幡影分来半廊月，磬声敲破一林秋。\n僧偏好事能青眼，佛本无心亦白头。\n试问青松峰外鹤，閒边曾见几人游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄郭月篷","author":"真山民","text":"烟波秋草外，活计一渔篷。\n淡月明寒苇，新霜醉晓枫。\n身虽殊出处，道岂有穷通。\n俯仰看人面，何如数过鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春","author":"真山民","text":"有恨青春老，无营白昼长。\n叶新林换绿，花落地生香。\n雨意一番足，人家百事忙。\n为儒竟成误，悔不早农桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明","author":"真山民","text":"清明今日是，原上一经过。\n新葬冢无数，未来人更多。\n此生曾悟否，不乐复如何。\n莫待浇坟土，樽前且醉歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔浦晚秋旅怀","author":"真山民","text":"西风吹梦越中游，剪剪轻寒入短裘。\n雁字不将乡信写，蛩声空和旅吟愁。\n邮亭冷雨孤灯夜，渔市斜阳一笛秋。\n是处山川即吾土，仲宣何用怯登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐怀","author":"真山民","text":"样不趋时合便休，都将往事付东流。\n眼看浮世自今古，迹与孤云同去留。\n泉石定非骑马路，功名不上钓鱼舟。\n有时但得句无问，只与渔歌互唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡江之越宿萧山县","author":"真山民","text":"昨夜大江舟，今宵小驿楼。\n只身千里客，孤枕一灯秋。\n市酒难成醉，乡书莫寄愁。\n胸中无史记，浪作会稽游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道逢过军投宿山寺","author":"真山民","text":"穷途欲焉往，薄暮此相投。\n蟋蟀数声雨，芭蕉一寺秋。\n乡关来枕畔，时事上眉头。\n长叹为僧好，今逢更说愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新春","author":"真山民","text":"馀冻雪初乾，初晴日骤暄。\n人心新岁月，春意旧乾坤。\n烟碧柳生色，烧青草返魂。\n东风无厚薄，随例到衡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新凉","author":"真山民","text":"烟火人幽处，田园秋暮时。\n深村人到少，闰月稻黄迟。\n旋决渠分水，新编竹补篱。\n地炉煨芋栗，莫遣贵人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楼居","author":"真山民","text":"携书来过此，便觉少尘埃。\n檐冷留云宿，窗明报月来。\n閒愁山隔断，幽梦鸟呼回。\n湖海元龙气，从渠俗子猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪行","author":"真山民","text":"春暖溪西路，行吟又几回。\n水清明白鹭，花落失青苔。\n云过日吞吐，树摇风往来。\n渔歌听未了，欲去又徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉题斋壁","author":"真山民","text":"此是閒中安乐窝，从渠忙处为奔波。\n人心少似秋胡妇，世事多参春梦婆。\n但把功名齐蚁蛭，定无荣辱到渔蓑。\n醉乡境界偏宽阔，天地都归一浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济川桥","author":"真山民","text":"十二阑干百尺台，登临洗尽眼中埃。\n沙痕长与水吞吐，桥影不妨船往来。\n两岸楼台随世换，四山图画自天开。\n槎边今古无穷思，都付西风酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"真山民","text":"世上痴儿女，争趋乞巧筵。\n妇鸠甘抱拙，不谄鹊桥仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三峰寺","author":"真山民","text":"寂寞烟林噪乱鸦，青鞋步入野僧家。\n云深不碍钟声出，日转还移塔影斜。\n廊下蜗黏沿砌藓，佛前蜂恋插瓶花。\n竹床纸帐清如水，一枕松风听煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山间次季芳韵","author":"真山民","text":"好山多在眼，尘事少关心。\n风竹有声画，石泉无操琴。\n许猿分野果，留鹤守云林。\n不是閒边客，谁来此地吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘伯山寄隐","author":"真山民","text":"寄隐幽踪何处寻，春风十里薜萝深。\n青山不说是非事，黄鸟自赓长短吟。\n百折畏途休著脚，十分明月是知心。\n不应误放桃花出，惹得渔翁话古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁朝","author":"真山民","text":"画角声中旧岁除，新年喜气满屠苏。\n阳和忽转冰霜后，元气更如天地初。\n晚色催诗归草梦，春光随笔上桃符。\n闭门贺客相过少，静对梅花自看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"真山民","text":"颜不常朱鬓易斑，流光难驻两跳丸。\n一年又是等閒过，百岁只消如此看。\n把酒何曾长在手，种桃能得几凭栏。\n痴人醉梦不知醒，日夜双眉抵死攒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访李延不值","author":"真山民","text":"白云满空山，山空人未归。\n拄杖莫敲门，恐惊白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋道士同游白云关","author":"真山民","text":"扶携方外友，来入白云关。\n八九峰如画，两三人倚栏。\n棋声敲竹外，帘影落花间。\n一曲瑶琴罢，翠阴生昼寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈云岫爱骑驴","author":"真山民","text":"君不学少陵骑驴金华春，一生旅食长悲辛。\n又不学浪仙骑驴长安市，凄凉落叶秋风里。\n却学雪中骑驴孟浩然，冷湿银镫敲吟鞭。\n梅花溪上日来往，身迹懒散人中仙。\n有时清霜松下路，松风萧萧驴耳竖。\n据鞍傲兀四无人，牧子骑牛相尔汝。\n劝君但骑驴，行路稳，姑徐徐。\n九折畏途鞭快马，年来曾覆几人车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤标上人留宿","author":"真山民","text":"山僧留我宿，我亦似山僧。\n香茗半瓯雪，寒齑一箸冰。\n廊风响黄叶，壁雨暗青灯。\n参透诗三昧，何须契一乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行","author":"真山民","text":"东风物物新，花外步清晨。\n蕉叶卷舒雨，鸠声问答春。\n园林三月景，诗酒百年身。\n试数交游侣，如今有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓山行","author":"真山民","text":"风扫连阴作快晴，瘦筇伴我出山扃。\n路从初日红边过，人在野花香里行。\n古木殊无趋世态，幽禽懒作弄春声。\n棕鞋踏遍山南北，只与白云相送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋扇","author":"真山民","text":"人心有炎凉，我心无欢悲。\n箧中重自珍，会有薰风时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏晚江行","author":"真山民","text":"行尽山头路，江空带夕晖。\n风蝉声不定，水鸟影同飞。\n萧散乌藤杖，轻鬖白苧衣。\n试呼垂钓者，分我半苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓行山间","author":"真山民","text":"出门谁是伴，只约瘦藤行。\n一二里山径，两三声晓莺。\n乱峰相出没，初日乍阴晴。\n僧舍在何许，隔林钟磬清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游凤栖寺","author":"真山民","text":"十载重游古凤栖，莲宫新绕绿杨堤。\n欲谈世事佛无语，不管客愁禽自啼。\n苔滑空廊妨散步，尘昏老壁失留题。\n僧家田地邻家种，菜甲春风绿满畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜜蜂","author":"真山民","text":"酿成百花脾，聊尔了口腹。\n人知口中甘，谁料腹中毒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题永嘉梦草堂","author":"真山民","text":"留得斯堂万古名，江山不敢闭英灵。\n池光曾染吟边墨，草色犹如梦里青。\n南浦诗香流未歇，东家魂冷唤难醒。\n当时园柳俱尘迹，惟有鸣禽尚可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真宗奉圣祖玉清昭应宫十一首 其八 亚、终献用《冲安》。","author":"郊庙朝会歌辞","text":"太初非有体，至道本无声。\n降迹临下土，成功陟上清。\n至仁敦动植，丕绪启宗祊。\n紫禁承来格，鸿基保永宁。\n发祥垂诞告，致孝荐崇名。\n广乐伸钦奉，储休固太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上仁宗英宗徽号一首 入门升殿用《显安》。","author":"郊庙朝会歌辞","text":"于穆仁祖，宠绥万方。\n执竞英考，迄用成康。\n图徽宝册，有烈其光。\n庶几亿载，与天无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 送神用《歆安》。","author":"郊庙朝会歌辞","text":"礼仪既备，神保聿归。\n洋洋在上，不可度思。\n神之来兮，肸蚃之随。\n神之去兮，休嘉是贻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 彻豆用《成安》。","author":"郊庙朝会歌辞","text":"濯濯其英，殖殖其庭。\n有来群工，赉我思成。\n嘉肴既将，旨酒既清。\n雍彻不迟，福禄来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 亚、终献用《和安》。","author":"郊庙朝会歌辞","text":"望高六宫，位应四星。\n辅佐君子，警戒相成。\n袆衣褒崇，琛册追荣。\n于以奠之，有椒其馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 退文舞、进武舞用《昭安》。","author":"郊庙朝会歌辞","text":"籥翟既陈，干戚斯扬。\n进旅退旅，一弛一张。\n其仪不忒，容服有光。\n以宴以娭，德音不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 酌献用《明安》。","author":"郊庙朝会歌辞","text":"旨酒嘉栗，有飶其香。\n衎我淑灵，歆此令芳。\n德贻彤管，号正椒房。\n神具醉止，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 升降用《熙安》。","author":"郊庙朝会歌辞","text":"佩玉锵锵，其来雍雍。\n陟降孔时，步武有容。\n恪兹祀事，神罔时恫。\n绥我邦家，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 其四 迎神用《歆安》。","author":"郊庙朝会歌辞","text":"牺牲既成，笾豆有楚。\n摐金击石，式歌且舞。\n追怀懿德，令闻令仪。\n灵兮来格，是享是宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 其三 迎神用《歆安》。","author":"郊庙朝会歌辞","text":"雍雍在宫，翼翼在庭。\n显相休嘉，肃雍和鸣。\n神嗜饮食，明德惟馨。\n绥我思成，式燕以宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 其二 迎神用《歆安》。","author":"郊庙朝会歌辞","text":"吉蠲惟时，礼仪既备。\n奉璋峨峨，群公在位。\n神之格思，永锡尔类。\n展彼令德，于焉来暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 其一 迎神用《歆安》。","author":"郊庙朝会歌辞","text":"笾豆大房，牺尊将将。\n馨香既登，明灵迪尝。\n其乐伊何，吹笙鼓簧。\n灵来燕娭，降福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 册宝升殿用《崇安》。","author":"郊庙朝会歌辞","text":"有犹有言，顺承天则。\n聿崇号名，再扬典册。\n朱英宝函，左右翼翼。\n千秋万岁，保兹无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上册宝十三首 册宝入门用《隆安》。","author":"郊庙朝会歌辞","text":"威仪皇止，庶尹在庭。\n爰举徽章，遹观厥成。\n勒崇扬休，写之琼瑛。\n迄于万祀，发闻惟馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上明达皇后册宝五首 其五 送神用《歆安》。","author":"郊庙朝会歌辞","text":"备成熙事，虚徐翠楹。\n神保聿归，云车夙征。\n鉴我休德，神交惚恍。\n留祉降祥，千秋是享。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上明达皇后册宝五首 其四 彻豆用《成安》。","author":"郊庙朝会歌辞","text":"登献罔愆，俎豆斯彻。\n神具醉止，礼终乐阕。\n御事既退，珊珊佩玦。\n介我繁祉，歆此蠲洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上明达皇后册宝五首 其三 退文舞、进武舞用《昭安》。","author":"郊庙朝会歌辞","text":"秉翟竣事，万舞摐金。\n总干挥戚，节以鼓音。\n礼容有炜，肸蚃来歆。\n淑灵是听，雅奏愔愔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上明达皇后册宝五首 其二 酌献用《明安》。","author":"郊庙朝会歌辞","text":"清宫有严，广乐在庭。\n钟鼓筦磬，九变既成。\n缩茅以献，洁秬惟馨。\n灵游可想，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上明达皇后册宝五首 其一 迎神用《歆安》。","author":"郊庙朝会歌辞","text":"恭俭宜家，柔顺承天。\n德昭彤管，忧在进贤。\n宝册袆翟，追荣寿原。\n四时祼享，何千万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上英宗尊号一首 入门用《正安》。","author":"郊庙朝会歌辞","text":"在宋五世，天子神明。\n群公奉册，乃扬鸿名。\n金书煌煌，遹昭厥成。\n思皇多祜，与天同声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上钦成皇后册宝六首 其六 亚、终献用《和安》。","author":"郊庙朝会歌辞","text":"酌彼玉瓒，有椒其馨。\n鬷假无言，雍容在庭。\n生莫与崇，于赫厥声。\n祀事孔明，神格是听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上钦成皇后册宝六首 其四 升降用《熙安》。","author":"郊庙朝会歌辞","text":"苾苾其芳，殽核维旅。\n陟降孔时，有秩斯所。\n雍容内化，维神之明。\n明则不渝，绥我思成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]