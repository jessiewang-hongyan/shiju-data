[{"title":"偈颂一百三十三首 其一○○","author":"释居简","text":"九旬禁足，是何三昧。\n合火成群，东倒西擂。\n忽若箭锋相拄时，突出眼睛，揭却脑盖，虎岩向他道未在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○一","author":"释居简","text":"今日因甚，作者模样。\n觌面相呈，当仁不让。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○二","author":"释居简","text":"升九仞之上，吾必与之俱。\n极九渊之底，吾亦与之俱。\n吾不见时，何不见吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○三","author":"释居简","text":"谈玄说妙，落在今时，瓠子落苏那得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○五","author":"释居简","text":"尘劫前事，尽在今时。\n当断不断，千驷莫追。\n花须连夜发，莫待晓风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○六","author":"释居简","text":"智不到处，满口道著，与你大书特书。\n屡书于虚空中，不怕风吹日炙，有名不用镌顽石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○七","author":"释居简","text":"久坐大雄峰，寒灰拨不红。\n一星萤火出，孤鹤已辽东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○八","author":"释居简","text":"误将萤火作明星，发得些儿鬼眼睛。\n末代只看王勃记，何殊瘗鹤紫阳铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○九","author":"释居简","text":"姜杏杯深恨未消，罚钱出院不同条。\n等闲放过丹霞后，打折乌藤也不饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一○","author":"释居简","text":"世事悠悠，不如山丘。\n避喧求静，骑牛觅牛。\n黄河合眼跳，特地一场愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一一","author":"释居简","text":"擒虎易，告人难。\n难难。\n铁门限，铁心肝，庞老油麻树上摊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一二","author":"释居简","text":"色不是色，菜花黄梨花白。\n声不是声，紫燕语黄莺鸣。\n观音菩萨，将钱买胡饼，放下手却是馒头。\n洞里春光浑不惜，一时流入武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一三","author":"释居简","text":"佛子生来净无垢，今年洗了明年又。\n顽赖容他五逆儿，劈面淋头誇毒手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一四","author":"释居简","text":"真人梦出大槐宫，直上钧天广乐中。\n百世木支皆玉叶，追还舜禹旧家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一五","author":"释居简","text":"五月五日午时，大书特书屡书。\n不向空中咄咄书，是马何曾唤作驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一六","author":"释居简","text":"三界无法，何处求心。\n何处有法，何处无心。\n白云为盖，流水作琴。\n谁是知音，一曲两曲无人会，惭愧惭愧。\n父母所生口，终不向你道，雨过夜塘秋水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一七","author":"释居简","text":"寿富如天圣嗣多。\n海不扬波长熨帖，雨当指日肆滂沱。\n火无就燥宜潜德，虏嗜残生必倒戈。\n草木昆虫均化育，九州四海听讴歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一八","author":"释居简","text":"老胡今日死日到，四海五天俱太平。\n葱岭又寻归去路，看来只有业随身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一九","author":"释居简","text":"家贼难防，家财必丧。\n只可错捉，不可错放。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二○","author":"释居简","text":"枫落吴江欲冷时，一堂百衲败荷衣。\n凭谁拨取炉中火，莫似沩山眼?痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二一","author":"释居简","text":"断头船子傍人门，七佛威仪可断魂。\n争似国师无伎俩，天津桥看弄胡孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二二","author":"释居简","text":"海云空，海天阔。\n书不来，信不达。\n既是解道本来无一物，因甚不得它衣钵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二三","author":"释居简","text":"千里驹，九肋鳖，九十三年揭日月。\n生既无言死无说，万象森罗广长舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二四","author":"释居简","text":"八月秋，何处热。\n露冷风高，头头漏泄。\n何必三到投子掘地觅天，雪拥鳌山一场败阙。\n踏著秤锤硬似铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二五","author":"释居简","text":"通玄峰顶，不是人间。\n心外无法，壶中有天。\n更于何处觅通玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二六","author":"释居简","text":"仲夏初吉，有好消息。\n露柱灯笼，参学事毕。\n證据则任汝證据，鞭逼则任汝鞭逼。\n当机觌面提，觌面当机疾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二七","author":"释居简","text":"牛头横说竖说，不曾动舌。\n鲁祖见僧面壁，自纳败阙。\n净慈败缺，钉橛向空，熨斗煎茶铫不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二八","author":"释居简","text":"时时具足，日日团栾。\n含元殿里，更问长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二九","author":"释居简","text":"散乱定，随流禅。\n莫将安乐法，容易与人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一三○","author":"释居简","text":"未得黄梅山里信，先开大庾岭头花。\n如何种柏栽松手，流入担柴卖筊家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一三一","author":"释居简","text":"大地及日月，时至皆归尽。\n未尝有一物，不被无常吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一三二","author":"释居简","text":"末上何曾转法轮，只今再转谩劳神。\n路行人不知天晓，犹把灵符执夜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一三三","author":"释居简","text":"倒用横拈眼似眉，憨憨稳放一头低。\n全身辊入草窠里，东倒何妨复擂西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其一","author":"释居简","text":"吹糠著米，翻成特地。\n不因一事，不长一智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其二","author":"释居简","text":"适我昔所愿，今者已满足。\n是玉也大奇，只恐不是玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其三","author":"释居简","text":"色空明暗，各不相知。\n行到水穷处，坐看云起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其四","author":"释居简","text":"弥满清净，终不容他。\n山河大地，万象森罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其五","author":"释居简","text":"结解非殊，存亡无据。\n试问本来宗，当初谁缚汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其六","author":"释居简","text":"翻手为云，覆手为雨。\n业识忙忙，无本可据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其七","author":"释居简","text":"金盘不可动，辘辘转难住。\n停待良久间，圆明湛如露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其八","author":"释居简","text":"三蛇九鼠，一亩之地。\n干木随身，逢场作戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其九","author":"释居简","text":"客舍并州已十霜，归心日夜忆咸阳。\n无端又渡桑乾水，却望并州是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十","author":"释居简","text":"挽弓须挽强，用枪须用长。\n射人先射马，擒贼先擒王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十一","author":"释居简","text":"疾燄过风第二头，不堪惆怅只堪愁。\n一声振鬣长鸣后，万马皆瘖一战收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十二","author":"释居简","text":"当机觌面提，觌面当机疾。\n开眼放痴顽，鞭逼人上壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十三","author":"释居简","text":"去年贫，雷在天上壮。\n今年贫，水出山下蒙。\n家风不与香严别，熨斗煎茶铫不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十四","author":"释居简","text":"爷顽赖，儿还债。\n彻底老婆心，赤土涂牛奶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十五","author":"释居简","text":"绝乳于菟弄爪牙，丹霞去后说丹霞。\n棒头有眼明如日，须是南阳老作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十六","author":"释居简","text":"隔江谁荐箭锋机，直下横趋已是迟。\n惆怅曲终人不见，数峰削玉水瀰瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十七","author":"释居简","text":"三春不是读书天，九夏炎炎且放禅。\n唯有秋冬较些子，不如打睡过残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十八","author":"释居简","text":"才伸劫火光中问，便解随他去复回。\n回到悔来坡下路，乱山依旧碧崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其十九","author":"释居简","text":"剑下十分亲，难藏独露身。\n江流石不转，独有蕴空名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其二十","author":"释居简","text":"总欠韦郎一夜霜，诸方拈出半青黄。\n碧云更不上盘饤，举似诸方笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二十一首 其二十一","author":"释居简","text":"东村王老夜烧钱，不是年穷岁尽禅。\n岁尽年穷消息别，东村王老夜烧钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送济东岩归乡","author":"释居简","text":"一别岩扃岁月深，春风狼藉到如今。\n回头依旧岩前路，百鸟衔花无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送丙上人","author":"释居简","text":"数墨循行不疗饥，南来逴得者些儿。\n从前伎俩人知有，管取者些人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送觉藏主归华藏","author":"释居简","text":"遁庵胸次太湖宽，偃岳旋岚鼓不湍。\n老手惯曾谙水脉，也须观水又观澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送明上人归洞庭","author":"释居简","text":"截流过了复随流，七十二峰横点头。\n拶到无锥无卓处，太湖空阔跨三州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送正法悟无證","author":"释居简","text":"百城烟水渺无涯，一锡南来又北飞。\n楼阁门开当日事，只今毫发不曾移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示照上人","author":"释居简","text":"照用同时诧合盘，衲僧开眼受他谩。\n何如日用当三昧，万象森罗对影寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示鉴上人","author":"释居简","text":"长笑云门顾鉴咦，翻抽顾字土加泥。\n从空掷剑虽无迹，会见虚空有坏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独庵","author":"释居简","text":"四顾寥寥不自欺，白云流水自东西。\n同途同辙人无数，尽逐衔花百鸟迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放塘","author":"释居简","text":"截断众流元止止，踏翻一窍便滔滔。\n休论未达其源底，佛也不知来处高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六解一亡","author":"释居简","text":"六用无功信不通，一时分付与春风。\n篆烟一缕闲清昼，百鸟不来花自红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"化阄拈千手大悲像","author":"释居简","text":"秋澄万水家家月，春入千林处处花。\n为问大悲千手眼，不知明月落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其一","author":"释居简","text":"野逸师僧语带讹，早年成佛老成魔。\n从头至踵无灵骨，奈尔瞻风拨草何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示僧 其二","author":"释居简","text":"相逢便要求禅钞，近日诸方伪钞多。\n慧日钞书无两样，只争些子大誵讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漆匠求颂","author":"释居简","text":"漆桶天然别，休将好处修。\n听他百杂碎，特地一场愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弁净人奉辟支佛牙求度","author":"释居简","text":"错认缘生不自知，退牙今属弁沙弥。\n若还祖弁有灵骨，选得僧成莫学伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书圆正法语后","author":"释居简","text":"三禅天上火星飞，大地山河靡孑遗。\n坏底话头谁领解，小留铁脊镇坤维。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顽极","author":"释居简","text":"计较思量未发机，风尘草动百般疑。\n四棱塌地羞前事，烂了虚空也听伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示如石上人","author":"释居简","text":"直须办得身如石，一线开时石不如。\n自解点头须自肯，待他人肯费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方上人上蒋山兼寄痴绝顽石","author":"释居简","text":"辟初错向诸方求，那堪同来打爷州。\n只今又入钟阜去，从错至错无时瘳。\n待欲商评者两错，只有知非无肯诺。\n痴叟顽翁旧同梦，知我从来无鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出山相赞","author":"释居简","text":"脱屣金轮只等闲，六年痴坐碧孱颜。\n出山不了些儿事，何似当年莫入山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其一","author":"释居简","text":"瞪目谛观时，风丝万绪风。\n一声潮雪响，打入正思惟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其二","author":"释居简","text":"海雾敛，山容开。\n神珠在掌，明镜当台。\n普门无锁钥，俗客不曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其三","author":"释居简","text":"声成文，谓之音。\n作如是观，海底摸针。\n空王至今，悠悠我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其四","author":"释居简","text":"趁队选圆通，无端立下风。\n当时供死款，错说在闻中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]