[{"title":"禅人并化主写真求赞 其九十三","author":"释正觉","text":"寒箸苍山之骨，雪压老松之颠。\n形气清而有像，心迹泯而亡缘。\n诸尘不受，一印周旋。\n大大小小兮方方圆圆。\n神观湛湛，和气津津。\n玉涧流月，琼林发春。\n恰恰相融也何此何彼，堂堂不在也夺境夺人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十七","author":"释正觉","text":"是真是假，谁相描画。\n似我似谁，莫入思惟。\n地方成矩，天圆自规。\n三界更无些法剩，一身还与十方宜。\n眉目炯炯，须发苍苍。\n疏林沾野雪，古涧湛秋光。\n锦缝谁分梭路细，针关初透线芒长。\n鹤梦未晓，鸟行无章。\n平买平卖兮，还他当行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四四","author":"释正觉","text":"须发沧浪，形容寒瘠。\n春林带雪痕，云山染秋色。\n光明一点兮蚌有蕴于月华，清净八弦兮鸟不飞而天碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一三","author":"释正觉","text":"清白传家，湛存授手。\n木落风高，水明月昼。\n双瞳冷用眉，片舌闲摇口。\n宗通也洞水逆流，孝满也曹山颠酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四一","author":"释正觉","text":"默而非缄，辨而罔谈。\n须菩提慧空了了，憍尸迦华雨毵毵。\n更与刹尘分手眼，何妨机用见锤钳。\n个人自得，古佛同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○九","author":"释正觉","text":"碧涧之松，烟巢之鹤。\n野性闲闲，癯身卓卓。\n江含月而练长，水连天而秋阔。\n一点分明兮十方虚豁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八五","author":"释正觉","text":"默默工夫，心田自锄。\n醭生唇上满，泥斲鼻头馀。\n少林何曾说话，曹溪不识文书。\n谁言伎俩浑无巧，自信家风也不疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七三","author":"释正觉","text":"默时说，说时默。\n白云无定心，青山有奇骨。\n半夜月移兮老兔推，百川潮落兮长鲸没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○九","author":"释正觉","text":"你是何人，缁衣裹身。\n静住天无四壁，机回月带重轮。\n梦蝶境中閒有趣，露蝉胸次净无尘。\n相随化事入廛井，百草头上风烟春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九八","author":"释正觉","text":"洞见其颜，拈却案山。\n影流心鉴，智入道环。\n师旷不闻而其声自普，离朱不辨而其色非悭。\n一点自然兮妙超过去现在，十方平等兮全该内外中间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○○","author":"释正觉","text":"秋入眼角，春生鼻筒。\n钳锤坚外，橐籥虚中。\n世机抱瓮之拙，道用斲轮之工。\n蜂采华房兮蜡脾酿蜜，犀酣桂毂兮兔鼻流通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二二","author":"释正觉","text":"默默道游，灵灵破幽。\n斗魁光转夜，河汉气澄秋。\n入世随流，门庭甚休。\n青鞋蹈雨俱胝老，放浪风烟百草头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二○","author":"释正觉","text":"非默而默，不言而言。\n凿混沌朴，决昆崙源。\n万像总持句，诸尘三昧门。\n法法心心成佛事，华华叶叶受春恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一六","author":"释正觉","text":"颠毛衰薄，春山雪作。\n胸襟疏豁，海门潮落。\n眉棱高而眼深，鼻筒直而口阔。\n幽灵绝待兮曾传祖祢之芳，谷神不死兮似得仙家之药。\n相逢别峰，弹指开阁。\n憨皮袋截巷拦街，臭骨头填沟塞壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一七","author":"释正觉","text":"青天无涯，白云不羁。\n流水抱山转，征人踏月归。\n应以比丘得度者，个般形像对来机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三九","author":"释正觉","text":"兀坐涧阴，潭空月沉。\n三乘乘外，一印印心。\n师子循行师子吼，旃檀围绕旃檀林。\n诸尘说法诸尘听，莫道无人为赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○七","author":"释正觉","text":"涧月之孤，岩松之癯。\n秋生眉目，霜侵发须。\n诸法之相了空寂，妙存之性非有无。\n一尘飞巨海，片雪点红炉。\n应事头头俱出碍，自然妙触解回途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○一","author":"释正觉","text":"萎萎羸羸，跛跛挈挈。\n用绵绵而云行，机历历而电掣。\n有时缄口衔枚，也学住山束篾。\n生兮不生，灭兮不灭。\n秋水之月兮，春山之雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○四","author":"释正觉","text":"秋山骨瘦，秋水神清。\n岩松寒更翠，涧月夜还明。\n灵然曲木坐不语，四海九州俱太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十","author":"释正觉","text":"气清山秋，用光月浮。\n一无所寄，六不得收。\n任腾腾而异类，活鱍鱍而随流。\n天上天下，云水自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五○","author":"释正觉","text":"天之空兮星斗寒，海之缩兮潮波还。\n推月之蟾止三脚，养雾之豹窥一斑。\n拈出门门问相识，知音点头应不悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○七","author":"释正觉","text":"须发垂白，面皮淡黄。\n茶醒睡眼，饭塞饥肠。\n情田闲自廓，心地净而光。\n云敛山川雨，月明河汉霜。\n门门得用亡机械，个事十成谁覆藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十八","author":"释正觉","text":"霜缣写病姿，寒木得春迟。\n山居自肯束三篾，尘立每烦颦两眉。\n牛头不懒，虎头不痴，个事十成还自知。\n饭塞饥肠衣补破，不妨唧溜出家儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十七","author":"释正觉","text":"似则不是，是则不似。\n动兮行云，静兮止水。\n能随缘，不堕类。\n百草头上老僧，二仪已前自己。\n莫将此个形骸，枉挂他人唇齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十二","author":"释正觉","text":"岩岩山有秋痕，淡淡云无宿根。\n入极一默之底，出成三昧之门。\n用不勤，湛若存，澄弗清兮搅不浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十八","author":"释正觉","text":"八字眉低，四方口阔。\n发色松雪寒，目光岩电烁。\n橐籥之空，枢机之活。\n其间勿你安排，里许是谁造作。\n影草不彰兮妙触无瘢，没身不殆兮长生有药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○二","author":"释正觉","text":"身心自然，松石亡年。\n春云閒似鹤，秋水远连天。\n虚能外应，默守家传。\n东西南北，一等周旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三四","author":"释正觉","text":"刹刹尘尘，随应现身。\n百川之月，百华之春。\n阿你随宜手眼快，更谁敢议骨头贫。\n道交德邻，主主宾宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十六","author":"释正觉","text":"不寒不枯而秋颓，不净不垢而春来。\n神虚而应，机发而回。\n分身慈氏，合掌善财。\n弹指作声兮楼阁门开。\n身心清恬，面目冷严。\n烟巢寒翠栖鸟梦，风漪绿净游鱼潜。\n荡荡兮眺听自妙，閒閒兮声色不黏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五一","author":"释正觉","text":"真见无形，真得无名。\n全超影响，妙出尘情。\n夜冷露濡而斗湿，天空霁阔而河横。\n无住而住，无生而生。\n相随却到门门底，楼阁关开弹指声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二一","author":"释正觉","text":"了了智空，闲闲色融。\n髑髅常干世界，鼻孔摩触家风。\n湛湛河源翡翠碧，团团海日珊瑚红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九九","author":"释正觉","text":"邈之不真，传之不神。\n得而无得，亲而无亲。\n体离微彻照之智，本盖载生成之仁。\n出一二三之数量，等千百亿之分身。\n用弥光也物中之眼，气专柔也主中之宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三七","author":"释正觉","text":"无明而明，无生而生。\n静枢机活，玄牝象成。\n随缘百亿纵横用，妙触门门出碍情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○六","author":"释正觉","text":"四大无埃，五蕴外来。\n智慧尚归父，因缘初不媒。\n西山寒月下，东海夜潮回。\n一一根尘妙触事，千千手眼随宜开。\n众生世界了如幻，影像那涴吾灵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十五","author":"释正觉","text":"眉目十分，精神一段。\n岩高雪释迟，木老春来缓。\n古涧明月宾，青山白云伴。\n借光何处不分身，刹刹尘尘谁解唤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十六","author":"释正觉","text":"默有心传，休将相观。\n烟巢鹤梦，月窟蟾寒。\n静里万缘藏鼻孔，笑中百事见眉端。\n而今须发点半白，向道丛林历百难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十五","author":"释正觉","text":"形仪淡如，胸腹空虚。\n懒不学佛，钝不知书，静应诸缘而无外，默容万像而有馀。\n齐物而梦蝶，乐性而观鱼。\n渠正是我兮我不是渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十","author":"释正觉","text":"心得而真，物应而神。\n幻住三昧，觉了诸尘。\n洒洒落落不共法，浩浩荡荡无边身。\n明明白白随流月，叶叶华华到处春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八","author":"释正觉","text":"太行盘纡，黄河泄舒。\n肝胆明洁，胸膺廓虚。\n清风未生齿颊，白雪已上眉须。\n少林之默无他说，黄梅之舂不识书。\n彻见本来人面目，名言安敢妄分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一八","author":"释正觉","text":"神定气平，心空智明。\n其机静而自应，其用虚而不盈。\n寒潭月落，霁夜河横。\n绍了亡祖位，借功成佛名。\n建立因缘皆尔尔，刹尘世界与众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十二","author":"释正觉","text":"木石形骸，冰雪肝胆。\n一点妙难名，十方机未感。\n寒林摇落兮谁捋老虎之须，沧海潮乾兮谁探老骊之颔。\n默默湛存，昭昭元鉴。\n发用也连乾断坤，缘应也明离暗坎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十九","author":"释正觉","text":"兀兀之姿，拙钝之师。\n静而亡像，动不知时。\n有口要挂壁，无机不度丝。\n秋气清而星河淡淡，天宇阔而夜斗垂垂。\n是个面目兮，与你相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二四","author":"释正觉","text":"相承次第，皮肉骨髓。\n形分古佛家，气出阿祖鼻。\n一根源既还，三昧尘全起。\n坦坦荡荡平等心，炜炜煌煌自然智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二五","author":"释正觉","text":"发白面黄，鼻直口方。\n云水精神老，丛林气味长。\n青蛇露时星烂烂，白鸟没处烟苍苍。\n印空有据，印泥成章。\n家家门前柏树子，岂独赵州能对扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十六","author":"释正觉","text":"智须转色，净还发光。\n活眼唯自照，喜眉为谁扬。\n巍巍堂堂，炜炜煌煌，莫道侬家兮触事面墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八四","author":"释正觉","text":"老身且懒，居然从简。\n白雪覆颠，乌华乱眼。\n心光传祖灯，手段破家产。\n到不到赵州吃茶，回不回睦州担板。\n借问诸人识也无，青山骨秀闲云散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十三","author":"释正觉","text":"岁寒之姿，衰发丝丝。\n明白之传，湛存绵绵。\n秋空霁而天连水远，夜色冷而河横斗旋。\n平买平卖兮将高就下，中规中矩兮随方逐圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十一","author":"释正觉","text":"默默而知，灵灵者谁。\n无像而独存鼻孔，有句处不挂唇皮。\n夜冷星河阔，霜清斗柄垂。\n从缘应世也，恰恰相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十七","author":"释正觉","text":"看看，气味历艰难。\n百城心胆老，三篾肚皮宽。\n秋晚长河淡，霜清北斗寒。\n哆哆和和兮休嫌冷语，点点闪闪兮定遭热谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二","author":"释正觉","text":"气清水秋，骨寒木槁。\n青眼柳春深，白头山雪早。\n具大人相也空落不惊，有大力量也风吹便倒。\n个些妙处难传，向道画工草草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一","author":"释正觉","text":"云横其肩，雪覆其颠。\n空空养慧，兀兀忘缘。\n月射珊瑚兮海发光而不夜，松生琥珀兮根拥膏而有年。\n性惟平等，道法自然。\n钤锤之在握，杖拂之当拳。\n豹雾披梓树之野，龙雷吼桃华之川。\n云水丛林秋与老成之气韵，溪山草木春曾酝酿于风烟。\n儿孙之力，学佛祖之家传。\n针线之关，度龛灯之焰联。\n向道龙门无宿客，而今龟鹤尽成仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十五","author":"释正觉","text":"舌头肉一脔，口唇皮两片。\n有时说道谈禅，忽地轰雷掣电。\n万机影销，一色功转。\n本来无物镜非台，胡汉不痕何所见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一六","author":"释正觉","text":"岁寒之容，高岩雪松。\n清白之胸，冷月霜钟。\n种田博饭，地藏之春农。\n明镜非台，黄梅之夜舂。\n百草头上闲和尚，而今何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一四","author":"释正觉","text":"寒雪覆颠，闲云拥肩。\n动随尔后，静住其前。\n百草头边老僧句，千华台上古佛禅。\n法法出碍，心心密传。\n百战之疮兮风雨瘢痒，九野之耕兮泥水领穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三三","author":"释正觉","text":"虚空之身兮遍十方，古佛之心兮踰三光。\n得之而藏，兀然如秋兮百念自凉。\n用之而芳，粲然如春兮万像成章。\n德形外徼，道在中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四三","author":"释正觉","text":"形容老癯，须发雪敷。\n体明千劫眼，性静万机枢。\n变通自古门门活，伎俩而今恰恰无。\n一指头禅随处用，拈来百草俱胝俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一八","author":"释正觉","text":"野云半肩，寒雪一颠。\n海树珊瑚月，岩松琥珀年。\n眼合觅不见祖，心空初不留禅。\n森罗万像纵横说，相与證明输我然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○五","author":"释正觉","text":"清白而游，江湖风月之秋。\n变态而神，云烟草木之春。\n体之而真，用之而淳。\n非佛非祖而能佛能祖，非天非人而能天能人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一九","author":"释正觉","text":"蛰梭未飞，肌肤不把。\n老虎似衰，眼力犹威。\n头须霜雪坞，舌颊风雷机。\n气爽秋高河汉阔，霁寒夜永斗牛辉。\n阴阳爻象，天地范围。\n借伴来也，相逢庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九","author":"释正觉","text":"识浪沥乾，肚皮束宽。\n口翻澜而海阔，发垂雪而山寒。\n妙传家法髑髅眼，巧幻神通赤肉团。\n相随来也，搥凿无瘢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六九","author":"释正觉","text":"情态云閒，身心月寒。\n鼻孔气出快，髑髅津沥乾。\n鳞龙游跃兮雨翻雷吼，鲲鹏变化兮海运风抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三一","author":"释正觉","text":"冥冥而觉，全真绝学。\n海口自吞，驷舌须缩。\n圜混有光兮老蚌之胎，空同无物兮枯龟之壳。\n个事而穷通，作家不啐啄。\n语出科模，用无棱角。\n丛林笑相看面也萎萎羸羸，三棒打不回头也龌龌龊龊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一八八","author":"释正觉","text":"默守枯寒，心心见端。\n琉璃井秋光湛湛，珊瑚枝月影团团。\n髑髅活兮，妄识沥乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]