[{"title":"次韵答李子约见赠","author":"孔武仲","text":"江县山奇水亦清，古今贤宰继声名。\n施为岂厌地閒僻，学行久推君老成。\n桂籍掇科论世契，锦囊留句荷交情。\n当年入洛多英俊，文彩谁如陆士衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬昌侠见贶之句","author":"孔武仲","text":"读君诗句骨毛寒，直恐吟来得意难。\n划若震雷惊蛰户，烂如奎宿照云端。\n锋铓剸截昆山玉，意气腾凌大海澜。\n欲识词源最清处，露珠新滴水精盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"孔武仲","text":"万里长江一叶舟，客心萧索已惊秋。\n乱霞影照山根寺，落日光翻水面楼。\n浅浦耀金知跃鲤，前滩点雪见栖鸥。\n少年壮气悲寥廓，未忍沧江下钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上晚行寄介之","author":"孔武仲","text":"廉纤一雨适春閒，击剑悲歌气满颜。\n消破古今惟日月，补完风雅只江山。\n我因为旅成拘滞，君此安居得往还。\n一夕竹窗灯烛照，论文谈易两俱閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自君山还岳阳","author":"孔武仲","text":"云山深处望潇湘，岩石沈沈已夕阳。\n却整舟帆凌浩渺，回看城郭似家乡。\n挥戈径欲回羲驭，散发今知出吕梁。\n不是浮休动归兴，对眠犹可借禅床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自宝丰仓归","author":"孔武仲","text":"岳云成冻把春寒，十里崎岖倦往还。\n马上朔风回系带，雪中微酒见开颜。\n含黄欲坼江边柳，蘸绿相重水上山。\n抛掉一官如粪壤，好随鱼舸此中閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日拜表","author":"孔武仲","text":"绛阙横霄瑞霭重，千官拜表未央宫。\n琤瑽玉佩侵寒漏，缥缈炉烟压晓风。\n汉历敢期随日永，尧龄共祝与天同。\n贱生亦与华封祝，遥望清光斗极中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至白湖驿寄四弟","author":"孔武仲","text":"江头言别颇匆匆，暮止荒陂破屋中。\n散尽烟云无夜雨，唤惊凫雁有春风。\n却思僧舍一少会，坐卷香醪百盏空。\n薄禄牵人非得己，相望秋思浩无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至节小雨","author":"孔武仲","text":"半醉听银漏，轻寒解罽裘。\n新阳万物动，小雨五更收。\n宿润青槐道，晨辉紫禁楼。\n皇恩与天泽，浑逐管弦流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江","author":"孔武仲","text":"滟滟西江水，朝朝伴我行。\n云天初散豁，秋色正分明。\n鱼逝应相得，鸥来故不惊。\n烟波聊寄适，南北久忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园独步二首 其二","author":"孔武仲","text":"官居何以涤冥烦，喜有厅西北涉园。\n白日渐长公事少，红英己尽叶阴繁。\n渌波似镜池能照，巧舌如簧鸟解言。\n风景只随人意好，昔贤何事厌湘沅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过马鞍山","author":"孔武仲","text":"足历黄州百叠山，更无平地只冈峦。\n物皆枯槁非人世，石最崔嵬是马鞍。\n畏日流金红艳艳，乱沙堆雪白漫漫。\n崎岖出尽聊休息，喜有松声六月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过巴河寄经父","author":"孔武仲","text":"当时联盖入东都，回首推迁二纪馀。\n此地山川终不改，浮生光景半成虚。\n清谈剧饮梦寐隔，断羽沉鳞音信疏。\n谁道丰城双宝剑，紫烟长绕斗牛墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过紫极宫感道士卓玘遗迹因赋诗以续诸公哀辞之后","author":"孔武仲","text":"武库精兵接混茫，挥犀馀论意何长。\n丹台此日归仙籍，紫极他年记道场。\n暂别鬓毛浑老大，再来风月愈凄凉。\n不须陨涕悲邻笛，亦对松筠为感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洞庭二首 其二","author":"孔武仲","text":"杳杳湖天极目中，波光日暮两陶镕。\n舟离庙步湾环水，帆指东山缥缈峰。\n昔日南征期饮马，今朝北去想骑龙。\n归来若得醉乡隐，愿化春醪万顷醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洞庭二首 其一","author":"孔武仲","text":"朝来四境宿云披，渐放扁舟入渺瀰。\n漠漠衣襟凌水雾，悠悠帘幕挂天丝。\n波平自喜看书稳，风软翻愁出险迟。\n今夜君山兴不浅，登临应及月明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过淮","author":"孔武仲","text":"积雨虽收霁，清淮更渺茫。\n地形真水府，波面似钱塘。\n云日侵衣淡，天风入袖凉。\n轻舆过南岸，转觉近家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余尝谓北人不知江湖如南人不习边塞时张芸老在坐中因问","author":"孔武仲","text":"张子胸中瑩不疑，江湖边地总曾知。\n波澜沃日漾舟起，霰雪埋空出塞时。\n挂席何妨拾明月，据鞍仍解赋新诗。\n悠然无复拘南北，阵马风樯取次宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初赐幡胜戏和诸公二首 其二","author":"孔武仲","text":"拜赐匆匆早上朝，公卿前列尽金貂。\n日留爱景明双阙，春逐恩辉下九霄。\n灵沼轻凘犹覆水，上林微绿已萦条。\n自惭羽翮非鸾凤，亦预彤庭舞舜韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初赐幡胜戏和诸公二首 其一","author":"孔武仲","text":"镂幡剪胜喜倾朝，不问纡蓝与珥貂。\n群玉参差排晚日，万花琐碎动春霄。\n蕙风已转东郊绿，柳雪犹低北苑条。\n从此恩波与温律，并随歌颂入咸韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县斋偶书","author":"孔武仲","text":"误恩为邑楚江浔，黾勉初疑力不任。\n吏事妄窥如管豹，归心难过是笼禽。\n低回未遂箕山志，慷慨犹希梁甫吟。\n案牍埽空庭院静，只将趺坐当鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县圃有小城环之北面有邱阜耸出乔木蔽其上盖古战棚也到县之三月得荒径攀援而上视其形势可以为亭北望平野乃增筑之度为四楹公事之隙休息其间","author":"孔武仲","text":"堆案盈庭势未休，灰心聊此作天游。\n剪除榛莽成幽径，支架茅篁接古丘。\n叶密风多能庇暑，云开山出更宜秋。\n西园日涉从今始，谁信民官得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君表自西林还城中以诗二首为别 其二","author":"孔武仲","text":"巉巉庐阜秀侵天，有意登临己十年。\n美味君才尝一脔，明珠我欲探重渊。\n他时白首须归隐，此去青云更著鞭。\n扶杖为公寻好处，往来同径得参禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君表自西林还城中以诗二首为别 其一","author":"孔武仲","text":"天上优游侍从臣，还乡昼锦坐生春。\n不矜富贵知馀事，同访溪山有故人。\n方外笑谈无畛域，雨馀泉石长精神。\n西林路口嗟轻别，善护青云万里身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈竹元珍","author":"孔武仲","text":"一室萧然傍禁城，尘埃不到旅怀清。\n水流红片知花落，雨浥苍苔见笋生。\n感物己怜春寂寞，辞家忆是岁峥嵘。\n知君亦有淹留叹，归梦西随杜宇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋履中学士挽词二首 其二","author":"孔武仲","text":"迹忝词场旧，官俱瀛府仙。\n过从常永日，推予更忘年。\n素业期三友，幽途隔九泉。\n春明书史富，贵与弟兄贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋履中学士挽词二首 其一","author":"孔武仲","text":"朝论方知子，哀哉疾不瘳。\n歌闻湘浦些，魂返岱宗游。\n文雅承三世，渊源见九流。\n音容如可接，图像在瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"极目亭有作","author":"孔武仲","text":"浩荡江风动客襟，短亭清晚一登临。\n乱霞藏日半天缬，渌水浸空千顷金。\n壮志未成游学恨，素交将散别离心。\n前山更有难寻景，试为閒来一苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛清溪入齐山","author":"孔武仲","text":"转轿南堤大阻长，不如乘兴泛轻航。\n园林荫翳清如簟，禽鸟将迎语有簧。\n溪是明河天上去，山疑方丈石中藏。\n衣巾散适心閒暇，更胜登临逐杜郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"系舟长芦作","author":"孔武仲","text":"夜泊长芦星满川，晚来吴楚气昏然。\n云雷相会还成雨，江海交流独舣船。\n废室与人喧白浪，荒村何处起青烟。\n文书满眼从抛弃，却倚蒲团学坐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏子瞻雪堂","author":"孔武仲","text":"古县东边仄径开，先生曾此斸蒿莱。\n鸾凰一去应不返，花柳当年皆自栽。\n画壁苍茫留水墨，朱栏剥落长莓苔。\n邻翁笑我来何暮，检点风烟兴尽回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈用之学士挽词二首 其二","author":"孔武仲","text":"小疾谓可起，斯人今则亡。\n溪山迷故国，妻子寄他乡。\n馆阁应留像，朝廷为给丧。\n荣华虽不满，尚胜贾司仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈用之学士挽词二首 其一","author":"孔武仲","text":"礼学康成后，朝廷复有人。\n诗书奏旒扆，轨物锡朱银。\n气象生台阁，光华动搢绅。\n幽途应不憾，朋友自沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龟山寺纳凉呈宗衍师","author":"孔武仲","text":"宝洞然香罢，山堂问话中。\n日将秋共淡，心与境浑空。\n弹指看浮世，披襟纳远风。\n因知宴坐者，白首乐无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"净因院赴浴","author":"孔武仲","text":"汉客疲江海，乘槎万里归。\n重寻象王舍，一浣洛城衣。\n坏壁凝香霭，明轩泛暮晖。\n红尘不相贷，归路骤骖騑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和介之登楼见寄","author":"孔武仲","text":"俯瞰江城十万家，旧居却叹久荒遐。\n秋空云片归飞鹤，古木藤阴屈结蛇。\n卧爱滩声长在耳，望穷山色接无涯。\n凭君命句天然景，流落人间与众誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和四弟夏雨","author":"孔武仲","text":"蚕月雨冥冥，愁云满太清。\n庭阶犹积润，沟港更繁声。\n嫩绿应浮野，馀凉稍及城。\n隋河今不浅，放艇欲南征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹元珍寒食次韵","author":"孔武仲","text":"羁旅看春色，清明客帝乡。\n花开禁苑密，柳袅御沟长。\n玉勒无馀地，钿车有剩香。\n尘埃不可久，归梦楚山傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和竹元珍僧舍牡丹次韵","author":"孔武仲","text":"知到东邻赏牡丹，高僧防客颇艰难。\n鲜妍自是天花种，僻静应无俗眼看。\n叶似蟠桃相隐覆，蕊随飞蝶渐凋残。\n新诗清苦如郊岛，肯羡侯家一醉欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李时发春日见寄","author":"孔武仲","text":"闻道重湖路未通，悠然身在碧湘中。\n崎岖水国犹千里，牢落春花已半空。\n江浪溅寒侵小睡，岳云筛雨响疏篷。\n君诗亦说清幽趣，便觉年来气味同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜归口占示同行者","author":"孔武仲","text":"一天星月明如昼，万树杉篁吟戛秋。\n隐约棹歌闻别浦，青荧渔火见孤舟。\n身居简册三冬学，心入沧溟万里游。\n髣髴重阳正明日，与君携酒豫登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜直东观","author":"孔武仲","text":"萧散爱閒官，因循亦厚颜。\n聊休俗士驾，独宿道家山。\n风幔自舒卷，月窗重闭关。\n其如江海梦，已与雁飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝丰仓秋纳三首 其三","author":"孔武仲","text":"县阔人饶稼，秋成众乐租。\n精粗验丹白，亿万起锱铢。\n足趼谁先到，尻高或妄呼。\n何当寄军令，供亿黑山隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝丰仓秋纳三首 其二","author":"孔武仲","text":"彩筹森列羽门兵，衮衮招呼不断声。\n岁计自当平斗甬，年丰今况有坻京。\n争先杂沓人何冗，应物逍遥我自清。\n白日渐斜亭庑静，却临湘水笑尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝丰仓秋纳三首 其一","author":"孔武仲","text":"次竹编蓬学缺垣，中门以外蚁回旋。\n群呼直欲争风疾，快走浑疑踏地穿。\n朱墨乱挥云落手，尘氛横集雪侵颠。\n新年幸有民输乐，心口相期更勉旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明妃","author":"孔武仲","text":"碧落千万里，轻云何处来。\n仙衣行缥缈，海鹤去徘徊。\n映日低秦岭，随风过楚台。\n茅檐看不足，更欲上崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武仲伏蒙宠寄新篇不忘往事恩谊甚厚谨依严韵和酬伏惟台慈特赐采览","author":"孔武仲","text":"治才优似尹京年，馀思吟哦入彩笺。\n元帅子孙真将种，翰林风格自天仙。\n追随尽腊无留刻，挥染香煤有剩妍。\n尽是从容雅歌事，铭功何苦勒燕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武仲伏蒙知府待制宠示新诗课成短篇以献左右","author":"孔武仲","text":"侍从荣依日月光，更因盘错试锋铓。\n谏书不上时无事，讼缿无留日倍长。\n旧好葭莩容间见，新篇锦绣得家藏。\n自惭思涸无高韵，蒿管何因拟凤凰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泗州","author":"孔武仲","text":"天都佳气郁葱葱，转盼江河万斛通。\n可但临淮称要地，直因排泗有神功。\n僧伽普照灵如在，宝椟都梁翠倚空。\n惭愧使星留客厚，尘埃挥手各西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍之西植竹两丛经岁甚茂","author":"孔武仲","text":"去岁披云自访寻，交加绿玉已成林。\n肯随春圃群芳老，喜对秋庭数亩阴。\n巴峡卢峰声淅沥，渭川斜谷气萧森。\n轩窗咫尺收佳趣，不负东南万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经父云自到京止得一书颇怀忧想因寄","author":"孔武仲","text":"万事峥嵘不自由，年来书信最绸缪。\n雁飞玉塞无多地，人望神都正倚楼。\n祗恐边风多浩荡，故令音驿每迟留。\n何如款段相随出，乡曲长为马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗港","author":"孔武仲","text":"八节滩头驻马蹄，淙淙流水日沉西。\n岁时久己成陈迹，风景全然似此溪。\n兰棹倚洲人竞过，篮舆索笔我閒题。\n桃源仙境今何在，懊恼娇莺向暮啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒","author":"孔武仲","text":"十年被冷东南方，未惯清寒客帝乡。\n碧落有声飞夜霰，轻裘无力拒晨霜。\n鲸依海冻先摧鬣，雁起边沙易失行。\n蒲柳脆肌尤不耐，暂凭杯酒作春阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒","author":"孔武仲","text":"晨风猎猎卷书堂，坐爱松筠耐雪霜。\n岁律峥嵘催暮景，时光宛转逼新阳。\n金卮满引颜虽解，石火深笼焰不长。\n安得仙家却寒术，吸吞霞气赤城傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院书事呈子骏明叔三篇 其一","author":"孔武仲","text":"忆初怀诏下天街，红烛相随御史来。\n场屋喜遵新定格，朝廷思见已成材。\n诛锄险异归平坦，洗濯英华出草莱。\n文藻诸生皆足用，更期儒行比骞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院书事呈子骏明叔三篇 其三","author":"孔武仲","text":"汾阳韦曲尽名臣，邂逅群居得远孙。\n玉琢两圭看德器，河倾千里瞰词源。\n鸳行平日随朝谒，鼎立今朝定讨论。\n只恐门开便分散，追风难认马蹄痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院书事呈子骏明叔三篇 其二","author":"孔武仲","text":"当年场屋未分袍，文阵今将逸对劳。\n紫案飘香还序拜，画堂横幕看挥毫。\n心游造化群嚣静，笔吐虹霓万丈高。\n长育人材今久矣，行看中选尽英豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院书事呈同僚诸公","author":"孔武仲","text":"九衢奔走厌红尘，官舍连朝得闭门。\n瑩静轩窗移白日，青荧灯火送黄昏。\n披衣已爱星辰烂，奉御方瞻斗极尊。\n早晚虞庠誇得士，相随笑语入天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院呈上官御史","author":"孔武仲","text":"当年容与乐虞庠，今日抡才道更光。\n但爱襟怀无岸谷，不知衔位带风霜。\n气钟海上仙山秀，袍拥天边玉树香。\n衡鉴赖公归一律，明朝归马快腾骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗送应子发之官吴兴","author":"孔武仲","text":"又向吴兴去，江湖风雪天。\n莱衣归戏綵，俭幕看依莲。\n伉直不随世，低徊今有年。\n谁将华阴土，一为拭龙泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗答李时发见贺书省除命渠云尝言矣","author":"孔武仲","text":"倾盖相期自有人，赠言先许出埃尘。\n若非清议曾推挽，安得公朝有选抡。\n州县徒劳虽己厌，置邮传命或非真。\n期公莫算人间事，共醉湘江烂漫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金橘","author":"孔武仲","text":"暑岸千株绿，秋庭万点黄。\n明晶能夺目，圆满要经霜。\n瑞露凝肤满，甘泉沃肺凉。\n美沧不解事，金椀荐槟榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鱼石二首 其二","author":"孔武仲","text":"鬐鬣真可辨，精研真入神。\n得非造化境，亦有雕锼人。\n颇疑著妄想，岁久积成真。\n兹理不足怪，方屏藏月轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鱼石二首 其一","author":"孔武仲","text":"人疑鱼托石，我谓石为鱼。\n持以赠君子，端能辟蠹书。\n无情逐波浪，有此璠与玙。\n坐得江湖意，萧然亦起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]