[{"title":"采桑子 其一 罗敷歌","author":"贺铸","text":"高楼帘卷秋风里，目送斜阳。\n衾枕遗香。\n今夜还如昨夜长。\n玉人望月销凝处，应在西厢。\n半掩兰堂。\n惟有纱灯伴绣床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗敷歌/采桑子 其四 罗敷歌","author":"贺铸","text":"自怜楚客悲秋思，难写丝桐。\n目断书鸿。\n平淡江山落照中。\n谁家水调声声怨，黄叶西风。\n罨画桥东。\n十二玉楼空更空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子 其二 罗敷歌","author":"贺铸","text":"河阳官罢文园病，触绪萧然。\n犀麈流连。\n喜见清蟾似旧圆。\n人生聚散浮云似，回首明年。\n何处尊前。\n怅望星河共一天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中吕宫丑奴儿二首 其二 苗而秀","author":"贺铸","text":"吴都佳丽苗而秀，燕样腰身。\n按舞华茵。\n促遍凉州、罗袜未生尘。\n□□□□□□透，歌怨眉颦。\n张燕宜频。\n□□□□、□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 试周郎","author":"贺铸","text":"乔家深闭郁金堂。\n朝镜事梅妆。\n云鬟翠钿浮动，微步拥钗梁。\n情尚秘，色犹庄。\n递瞻相。\n弄丝调管，时误新声，翻试周郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金凤钩","author":"贺铸","text":"江南又叹流寓。\n指芳物、伴人迟暮。\n搅晴风絮，弄寒烟雨，春去更无寻处。\n石城楼观青霞举。\n想艇子、寄谁容与。\n断云荆渚，限潮湓浦。\n不见莫愁归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时七首 其五 钓船归","author":"贺铸","text":"绿净春深好染衣。\n际柴扉。\n溶溶漾漾白鸥飞。\n两忘机。\n南去北来徒自老，故人稀。\n夕阳长送钓船归。\n鳜鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子三首 其三 陌上郎","author":"贺铸","text":"西津海鹘舟，径度沧江雨。\n双橹本无情，鸦轧如人语。\n挥金陌上郎，化石山头妇。\n何物系君心，三岁扶床女。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中花慢","author":"贺铸","text":"回首扬州，猖狂十载，依然一梦归来。\n但觉安仁愁鬓，几点尘埃。\n醉墨碧纱犹锁，春衫白纻新裁。\n认鸣珂曲里，旧日朱扉，闲闭青苔。\n人非物是，半晌鸾肠易断，宝勒空回。\n徒怅望、碧云销散，明月徘徊。\n忍过阳台折柳，难凭陇驿传梅。\n一番桃李，迎风无语，谁是怜才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青玉案 横塘路","author":"贺铸","text":"凌波不过横塘路，但目送、芳尘去。\n锦瑟华年谁与度？\n月台花榭，琐窗朱户，只有春知处。\n碧云冉冉蘅皋暮，彩笔新题断肠句。\n试问闲愁都几许？\n一川烟草，满城风絮，梅子黄时雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"贺铸","text":"暂假临淮东道主，每逃歌舞华筵。\n经年未办买山钱。\n筋骸难强，久坐沐猴禅。\n行拥一舟称浪士，五湖春水如天。\n越人相顾足嫣然。\n何须绣被，来伴拥蓑眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其一","author":"贺铸","text":"秋半雨凉天。\n望后清蟾未破圆。\n二十四桥游冶处，留连。\n携手娇饶步步莲。\n眉宇有馀妍。\n初破瓜时正妙年。\n玉局弹棋无限意，缠绵。\n肠断吴蚕两处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子 其二","author":"贺铸","text":"柳岸舣兰舟。\n更结东山谢氏游。\n红泪清歌催落景，回头。\n□出尊前一段愁。\n东水漫西流。\n谁道行云肯驻留。\n无限鲜飙吹芷若，汀洲。\n生羡鸳鸯得自由。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南柯子/南歌子 别恨","author":"贺铸","text":"斗酒才供泪，扁舟只载愁。\n画桥青柳小朱楼。\n犹记出城车马、为迟留。\n有恨花空委，无情水自流。\n河阳新鬓尽禁秋。\n萧散楚云巫雨、此生休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其二","author":"贺铸","text":"心蹙黄金缕，梢垂白玉团。\n孤芳不怕雪霜寒。\n先向百花头上、探春□。\n傍水添新韵，横墙露粉颜。\n夜来和月起凭阑。\n认得暗香微度、有无间。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 □□□","author":"贺铸","text":"疏雨池塘见，微风襟袖知。\n阴阴夏木啭黄鹂。\n何处飞来白鹭立移时。\n易醉扶头酒，难逢敌手棋。\n日长偏与睡相宜。\n睡起芭蕉叶上自题诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 其一","author":"贺铸","text":"绣幕深朱户，熏炉小象床。\n扶肩醉被冒明珰。\n绣履可怜分破、两鸳鸯。\n梦枕初回雨，啼钿半□妆。\n一钩新月渡横塘。\n谁认凌波微步、袜尘香。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"品令","author":"贺铸","text":"怀彼美。\n愁与泪。\n分占眉丛眼尾。\n求好梦、闲拥鸳鸯绮。\n恨啼鸟、唤人起。\n目断清淮楼上，心寄长洲坊里。\n迢迢地。\n七百三十里。\n几重山，几重水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城里钟/菩萨蛮 城里钟","author":"贺铸","text":"厌厌别酒商歌送。\n萧萧凉叶秋声动。\n小泊画桥东。\n孤舟月满篷。\n高城遮短梦。\n衾藉馀香拥。\n多谢五更风。\n犹闻城里钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小梅花二首 其一 将进酒","author":"贺铸","text":"城下路。\n凄风露。\n今人犁田昔人墓。\n岸头沙。\n带蒹葭。\n漫漫昔时，流水今人家。\n黄埃赤日长安道。\n倦客无浆马无草。\n开涵关。\n闭涵关。\n千古如何，不见一人閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行七首 其七 思牛女","author":"贺铸","text":"楼角参横，庭心月午。\n侵阶夜色凉经雨。\n轻罗小扇扑流萤，微云度汉思牛女。\n拥髻柔情，扶肩昵语。\n可怜分破□□□。\n□□□□有佳期。\n人间底事长如许。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思越人/朝天子 其二","author":"贺铸","text":"怊怅离亭断彩襟。\n碧云明月两关心。\n几行书尾情何限，一尺裙腰瘦不禁。\n遥夜半，曲房深。\n有时昵语话如今。\n侵窗冷雨灯生晕，泪湿罗笺楚调吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思越人/朝天子 其一","author":"贺铸","text":"紫府东风放夜时。\n步莲秾李伴人归。\n五更钟动笙歌散，十里月明灯火稀。\n香苒苒，梦依依。\n天涯寒尽减春衣。\n凤凰城阙知何处，寥落星河一雁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思越人/朝天子","author":"贺铸","text":"京口瓜洲记梦间。\n朱扉犹想映花关。\n东风太是无情思，不许扁舟兴尽还。\n春水漫，夕阳闲。\n乌樯几转绿杨湾。\n红尘十里扬州过，更上迷楼一借山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怨三三","author":"贺铸","text":"玉津春水绿如蓝。\n宫柳毵毵。\n桥上东风侧帽檐。\n记佳节、约是重三。\n飞楼十二珠帘。\n恨不贮、当年彩蟾。\n对梦雨廉纤。\n愁随芳草，绿遍江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"贺铸","text":"一幅霜绡，麝煤熏腻纹丝缕。\n掩妆无语。\n的是销凝处。\n薄暮兰桡，漾下蘋花渚。\n风留住。\n绿杨归路。\n燕子西飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"贺铸","text":"见面无多，坐来百媚生馀态。\n后庭春在。\n折取残红戴。\n小小兰舟，荡桨东风快。\n和愁载。\n缠绵难解。\n不似罗裙带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴调相思引","author":"贺铸","text":"团扇单衣杨柳陌。\n花似春风□无迹。\n赖白玉香奁供粉泽。\n借秀色。\n添春色。\n借秀色。\n添春色。\n云幕华灯张绮席。\n半醉客。\n留醒客。\n半醉客。\n留醒客。\n渐促膝倾鬟琴差拍。\n问此夕。\n知何夕。\n问此夕。\n知何夕。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴调相思引 送范殿监赴黄冈","author":"贺铸","text":"终日怀归翻送客。\n春风祖席。\n南城陌。\n便莫惜。\n离觞频卷白。\n动管色。\n催行色。\n动管色。\n催行色。\n何处投鞍风雨夕。\n临水驿。\n空山驿。\n临水驿。\n空山驿。\n纵明月相思千里隔。\n梦咫尺。\n勤书尺。\n梦咫尺。\n勤书尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋风叹/燕瑶池","author":"贺铸","text":"琼钩褰幔。\n秋风观。\n漫漫。\n白云联度河汉。\n长宵半。\n参旗烂烂。\n何时旦。\n命闺人、金徽重按。\n商歌弹。\n依稀广陵清散。\n低眉叹。\n危弦未断。\n肠先断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆溪咏/渔家傲 荆溪咏","author":"贺铸","text":"南岳去天才尺五。\n荆溪笠泽相吞吐。\n十日一风仍再雨。\n宜禾黍。\n秋成处处宜禾黍。\n坊市万家连岛屿。\n长杨□□□□□。\n□□□□□□□。\n能歌舞。\n刘郎不□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清商怨三首 其三 要销凝","author":"贺铸","text":"雕梁寻巢旧燕侣。\n似向人欲语。\n试问来时，逢郎郎健否。\n春风深闭绣户。\n尽便旋、一庭花絮。\n要自销凝，吟郎长短句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凌歊/金人捧露盘","author":"贺铸","text":"控沧江。\n排青嶂，燕台凉。\n驻彩仗、乐未渠央。\n岩花磴蔓，妒千门、珠翠倚新妆。\n舞闲歌悄，恨风流、不管馀香。\n繁华梦，惊俄顷，佳丽地，指苍茫。\n寄一笑、何与兴亡。\n量船载酒，赖使君、相对两胡床。\n缓调清管，更为侬、三弄斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时七首 其二 唤春愁","author":"贺铸","text":"天与多情不自由。\n占风流。\n云闲草远絮悠悠。\n唤春愁。\n试作小妆窥晚镜，淡蛾羞。\n夕阳独倚水边楼。\n认归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴齐云/南歌子","author":"贺铸","text":"境跨三千里，楼侵尺五天。\n碧鸳鸯瓦昼生烟。\n未信西山台观、压当年。\n野色分禾黍，秋声入管弦。\n闲挥谈麈襞吟笺。\n三十万家风月、共流连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"换追风/浣溪沙 其五","author":"贺铸","text":"掌上香罗六寸弓。\n雍容胡旋一盘中。\n目成心许两匆匆。\n别夜可怜长共月，当时曾约换追风。\n草生金埒画堂空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行七首 其六 晕眉山","author":"贺铸","text":"镜晕眉山，囊熏水麝。\n凝然风度长闲暇。\n归来定解鹔鹴裘，换时应倍骅骝价。\n殢酒伤春，添香惜夜。\n依稀待月西厢下。\n梨花庭院雪玲珑，微吟独倚秋千架。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤栖梧三首 桃源行","author":"贺铸","text":"流水长烟何缥缈。\n诘□□□，□逗渔舟小。\n夹岸桃花烂□□。\n□□□□□□□。\n萧闲村落田畴好。\n避地移家，□□□□□。\n□□殷勤送归棹。\n闲边勿为他人道。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙 其十五","author":"贺铸","text":"楼角初消一缕霞，淡黄杨柳暗栖鸦。\n玉人和月摘梅花。\n笑捻粉香归洞户，更垂帘幕护窗纱。\n东风寒似夜来些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙七首 其一 醉中真","author":"贺铸","text":"不信芳春厌老人，老人几度送馀春。\n惜春行乐莫辞频。\n巧笑艳歌皆我意，恼花颠酒拚君瞋。\n物情惟有醉中真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"贺铸","text":"叠鼓新歌百样娇。\n铜丸玉腕促云谣。\n揭穿飞瓦雹声焦。\n九曲池边杨柳陌，香轮轧轧马萧萧。\n细风妆面酒痕销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"贺铸","text":"翠縠参差拂水风。\n暖云如絮扑低空。\n丽人波脸觉春融。\n缨挂宝钗初促席，檀膏微注玉杯红。\n芳醪何似此情浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"贺铸","text":"云母窗前歇绣针。\n低鬟凝思坐调琴。\n玉纤纤按十三金。\n归卧文园犹带酒，柳花飞度画堂阴。\n只凭双燕话春心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"贺铸","text":"双鹤横桥阿那边。\n静坊深院闭婵娟。\n五度花开三处见，两依然。\n水眄难禁频领□，歌云犹许小流连。\n破得尊前何限恨，不论钱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其三","author":"贺铸","text":"潮涨湛芳桥。\n难渡兰桡。\n卷帘红袖莫相招。\n十二阑干今夜月，谁伴吹箫。\n烟草接亭皋。\n归思迢迢。\n兰成老去转无憀。\n偏恨秋风添鬓雪，不共魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一","author":"贺铸","text":"把酒欲歌骊。\n浓醉何辞。\n玉京烟柳欲黄时。\n明日景阳门外路，相背春归。\n敛泪复牵衣。\n私语迟迟。\n可怜谁会两心期。\n惟有画帘斜月见，应共人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"贺铸","text":"一十二都门。\n梦想能频。\n无言桃李几经春。\n艳粉鲜香开自落，还为何人。\n白纻别时新。\n苒苒征尘。\n镜中消瘦老于真。\n赖有天涯风月在，依旧相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令","author":"贺铸","text":"一叶忽惊秋。\n分付东流。\n殷勤为过白蘋洲。\n洲上小楼帘半卷，应认归舟。\n回首恋朋游。\n迹去心留。\n歌尘萧散梦云收。\n惟有尊前曾见月，相伴人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其四","author":"贺铸","text":"雨过碧云秋。\n烟草汀洲。\n远山相对一眉愁。\n可惜芳年桥畔柳，不系兰舟。\n为问木兰舟。\n何处淹留。\n相思今夜忍登楼。\n楼下谁家歌水调，明月扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海月谣","author":"贺铸","text":"楼平叠巘。\n瞰瀛海、波三面。\n碧云扫尽，桂轮滉玉，鲸波张练。\n化出无边宝界，是名壮观。\n追游汗漫。\n愿少借、长风便。\n麻姑相顾，□然笑指，寒潮清浅。\n顿觉蓬莱方丈，去人不远。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烛影摇红","author":"贺铸","text":"波影翻帘，泪痕凝蜡青山馆。\n故人千里念佳期，襟佩如相款。\n惆怅更长梦短。\n但衾枕、馀芬剩暖。\n半窗斜月，照人肠断，啼乌不管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时七首 其六 爱孤云","author":"贺铸","text":"闲爱孤云静爱僧。\n得良朋。\n清时有味是无能。\n矫聋丞。\n况复早年豪纵过，病婴仍。\n如今痴钝似寒蝇。\n醉懵腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太平时七首 其一 艳声歌","author":"贺铸","text":"蜀锦尘香生袜罗。\n小婆娑。\n个侬无赖动人多。\n是横波。\n楼角云开风卷幕，月侵河。\n纤纤持酒艳声歌。\n奈情何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸳鸯语/七娘子","author":"贺铸","text":"京江抵、海边吴楚。\n铁瓮城、形胜无今古。\n北固陵高，西津横渡。\n几人携手分襟处。\n凄凉渌水桥南路。\n奈玉壶、难叩鸳鸯语。\n行雨行云，非花非雾。\n为谁来为谁还去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸳鸯梦/临江仙 鸳鸯梦","author":"贺铸","text":"午醉厌厌醒自晚，鸳鸯春梦初惊。\n闲花深院听啼莺。\n斜阳如有意，偏傍小窗明。\n莫倚雕阑怀往事，吴山楚水纵横。\n多情人奈物无情。\n闲愁朝复暮，相应两潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令三首 其二 偶相逢","author":"贺铸","text":"彩山涌起翠楼空。\n箫鼓沸春风。\n桂娥唤回清昼，夹路宝芙蓉。\n长步障，小纱笼。\n偶相逢。\n艳妆宜笑，隐语传情，半醉醒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"贺铸","text":"闲情减旧。\n无奈伤春能作瘦。\n桂楫兰舟。\n几送人归我滞留。\n西门官柳。\n满把青青临别手。\n谁共登楼。\n分取烟波一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花","author":"贺铸","text":"簪花照镜。\n客鬓萧萧都不整。\n拟倩东□。\n化作尊前入梦云。\n风香月影。\n信是瑶台清夜永。\n深闭重门。\n牵绊刘郎别后魂。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"贺铸","text":"春容秀润。\n二十四番花有信。\n鸾镜佳人。\n得得浓妆样样新。\n情无远近。\n水阔山长分不尽。\n一断音尘。\n泪眼花前只见春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"贺铸","text":"南园清夜。\n临水朱阑垂柳下。\n从坐莲花。\n潋滟觥船泛露华。\n酒阑歌罢。\n双□前愁东去也。\n回想人家。\n芳草平桥一径斜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花","author":"贺铸","text":"冷香浮动。\n望处欲生胡蝶梦。\n晓日曈昽。\n愁见凝酥暖渐融。\n鼓催歌送。\n芳酒一尊谁与共。\n寂寞墙东。\n门掩黄昏满院风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"贺铸","text":"多情多病。\n万斛闲愁量有剩。\n一顾倾城。\n惟觉尊前笑不成。\n探香幽径。\n好住东风谁主领。\n多谢流莺。\n欲别频啼四五声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字浣溪沙/浣溪沙 其十二","author":"贺铸","text":"浮动花钗影鬓烟。\n浅妆浓笑有馀妍。\n酒醺檀点语凭肩。\n留不住时分钿镜，旧曾行处失金莲。\n碧云芳草恨年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]