[{"title":"题万安野馆","author":"朱熹","text":"身似孤云去复还，投装犹记此窗间。\n只应烟雨苍茫外，即是当时万叠山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万安遇长沙便欲附书不果","author":"朱熹","text":"长沙一别两悠悠，梦想清湘带橘洲。\n欲寄行人数行字，行人不作置书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"不见梅再用来字韵","author":"朱熹","text":"旧岁将除新岁来，梅花长是雪毰堆。\n如何此日三州路，不见寒葩一树开。\n野水风烟迷惨澹，故园霜月想徘徊。\n夜窗却恐劳幽梦，速把新诗取次栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清江道中见梅","author":"朱熹","text":"今日清江路，寒梅第一枝。\n不愁风袅袅，正奈雪垂垂。\n煖热惟须酒，平章却要诗。\n他年千里梦，谁与寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临江买舟","author":"朱熹","text":"征骖聊驻近江楼，南市津头问买舟。\n共说明朝乘雪水，长歌一日到洪州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芗林","author":"朱熹","text":"东皋溅寒水，西崦饶清阴。\n南埭奎壁丽，北垞静且深。\n入门流绿波，竹树何箾椮。\n积石象云壑，高堂杳沉沉。\n左通云水区，右径梅杏林。\n沼沚共回薄，观台郁差参。\n纷吾千里游，发轫南山岑。\n过门得佳赏，慰此夙昔心。\n缅怀企疏翁，岁晚投冠籫。\n婆娑此涧谷，俯仰成古今。\n嗣德世有人，闻道我所钦。\n相见无杂语，晤言写胸襟。\n怀旧复惆怅，命酒聊同斟。\n饮罢我当去，握手清江浔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过樟木镇晚晴二首 其一","author":"朱熹","text":"朝晴遣我看芗林，顷刻浮云万里阴。\n拂袖凌风三十里，依然寒日照长吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过樟木镇晚晴二首 其二","author":"朱熹","text":"飞云极目疑梅岭，落日回头梦橘洲。\n从此不愁东路永，祇应西望转悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赤冈头望远山作","author":"朱熹","text":"晓起清江弄小舟，晚风吹过赤冈头。\n远峰自作脩眉敛，万里那知客子愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之发临江","author":"朱熹","text":"千里烟波一叶舟，三年已是两经由。\n今宵又过丰城县，依旧长江直北流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之漫成","author":"朱熹","text":"落日晴江更远山，远山犹在有无间。\n不须极目伤怀抱，且看渔船近往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹节滩","author":"朱熹","text":"船下清江竹节滩，长烟漠漠水漫漫。\n人家断岸斜阳好，客子中流薄暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中晚赋","author":"朱熹","text":"长风一万里，披豁暮云空。\n极浦三年梦，扁舟二子同。\n离离浮远树，杳杳没孤鸿。\n若问明朝事，西山晻霭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之将近丰城有作","author":"朱熹","text":"老矣身如万斛舟，长风破浪若为收。\n江山若有逢迎意，到处何妨为少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过丰城作","author":"朱熹","text":"渺渺丰城县，回头忆旧游。\n晴江罗远树，宿莽乱中洲。\n宝剑今鳞甲，神光尚斗牛。\n他年还记得，此夜一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中见新月伯崇择之二友皆已醉卧以此戏之","author":"朱熹","text":"舟中见新月，烟浪不胜寒。\n与问醉眠客，岂知行路难。\n残阳犹水面，孤雁更云端。\n篷底今宵意，天边芳岁阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之舟中有作二首 其一","author":"朱熹","text":"一江烟水浩漫漫，昨夜扁舟寄此间。\n共向船头望南北，不知何处是家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之舟中有作二首 其二","author":"朱熹","text":"一席三人抵项眠，心知篷外水如天。\n起来却怪天如水，月落乌啼浦树边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自东湖至列岫得二小诗 其一","author":"朱熹","text":"孺子高风何处寻，东湖台观水云深。\n生刍一束人如玉，此日凄凉万古心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自东湖至列岫得二小诗 其二","author":"朱熹","text":"昨日来时万里阴，长江雪后玉千岑。\n苍茫不尽登临意，重对晴天豁晚襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"列岫望西山最正殆无毫发遗恨滕王秋屏皆不及也因作此诗二首 其一","author":"朱熹","text":"城中望西山，拄颊空朝暮。\n不到列岫亭，讵知亲切处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"列岫望西山最正殆无毫发遗恨滕王秋屏皆不及也因作此诗二首 其二","author":"朱熹","text":"东西水平分，南北山中判。\n妙处毫发间，商略无遗算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚饮列岫","author":"朱熹","text":"危亭披豁对苍霞，策杖重来日未斜。\n满目江山一尊酒，哦诗莫遣太雄誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观上蓝贤老所藏张魏公手帖次王嘉叟韵","author":"朱熹","text":"火风吹散旱天云，肤寸空馀翰墨新。\n拭泪相看渺今古，堂堂那复有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯崇登滕王阁感旧盖闻往时延阁公拜疏于此云","author":"朱熹","text":"金阙银台梦想中，楼前拜舞皂囊空。\n十年殄瘁无穷恨，叹息今人少古风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观西山怀岳麓以为莫能相上下也聊赋此云","author":"朱熹","text":"风月平生意，江湖自在身。\n年华供转徙，眼界得清新。\n试问西山雨，何如湘水春。\n悠然一长啸，妙绝两无伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"进贤道中","author":"朱熹","text":"往辞湘水曲，今过豫章城。\n改岁无多日，到家才几程。\n昼怜春意迫，夜喜月华清。\n此去无淹轨，前涂似掌平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野望","author":"朱熹","text":"登高立马瞰晴川，四面平林接暝烟。\n东望不堪频极目，归心已度鸟飞前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之进贤道中漫成五首 其一","author":"朱熹","text":"白酒频斟当啜茶，何妨一醉野人家。\n据鞍又向冈头望，落日天风雁字斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之进贤道中漫成五首 其二","author":"朱熹","text":"笑指斜阳天外山，无端长作翠眉攒。\n岂知男子桑蓬志，万里东西不作难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之进贤道中漫成五首 其三","author":"朱熹","text":"夜宿林冈月满川，归期屈指正茫然。\n也知地脉无赢缩，只把阴晴更问天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之进贤道中漫成五首 其四","author":"朱熹","text":"谁作窗间拥鼻声，更哦乐府短歌行。\n从教永夜清无寐，只恐晨鸡不肯鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之进贤道中漫成五首 其五","author":"朱熹","text":"日暮重冈上，人劳马亦饥。\n不妨随野雀，容易宿寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之夜宿进贤客舍","author":"朱熹","text":"白日照寒野，缅然千里平。\n驰晖一以没，浩荡惊飙生。\n露彩林表见，月华波上明。\n同行鲁狂士，忽发商歌声。\n洗耳金石奏，信知尘累轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之润陂有作","author":"朱熹","text":"我行欲安适，莽莽穷山陂。\n晨装远林表，午憩通川湄。\n旷望想慈亲，行役嗟吾儿。\n喟然陟屺叹，归心浩无涯。\n晓霜徒御寒，暮雨朋俦悲。\n前期谅非远，无为苦愁思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过润陂日晴意可喜至暮复雨伯崇有诗因次其韵","author":"朱熹","text":"客里岁云暮，我心殊未平。\n悠悠惜往日，郁郁怀平生。\n况复久阴雨，喜兹霜晓明。\n那知不终日，又作潇潇声。\n坐厌泥涂辱，空嗟鸿雁轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山行两日至金步复见平川行夷路计程七日可到家矣","author":"朱熹","text":"行穿侧径度荒山，又踏深泥过野田。\n路转忽然开远望，眼明复此见平川。\n江烟浦树悲重叠，楚水闽山喜接连。\n税驾有期心转迫，棱棱瘦马不胜鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之金步喜见大江有作","author":"朱熹","text":"江头四望远峰稠，江水中间自在流。\n并岸东行三百里，水源穷处即吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之馀干道中","author":"朱熹","text":"寒尽春生草又青，化工消息几曾停。\n因君一咏陵陂麦，恍忆侬家老圃亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安仁晓行","author":"朱熹","text":"夙驾安仁道，行行得自娱。\n荒山围野阔，远树出林孤。\n景晦长烟合，天寒碧草枯。\n归心怀往路，极目向平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十七日早霜晴观日出雾中喜而成诗","author":"朱熹","text":"斜月夜窗白，肃霜朝气清。\n长涂披素锦，寒雾涌金钲。\n已作三冬雨，何妨十日晴。\n天公且相念，莫遣暮云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵","author":"朱熹","text":"久阴冬竟暖，欲霁气先清。\n田舍占烟火，军家候鼓钲。\n风霜千里肃，天地一朝晴。\n明日知何日，阳春又发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之过丫头岩","author":"朱熹","text":"四面晴冈紫石崖，如何浑作白皑皑。\n须知暖入阴泉溜，不是寒封积雪堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章岩","author":"朱熹","text":"豁尔天开宇，呀然夜不扃。\n闲云任栖宿，密雨断飘零。\n破屋僧常住，高轩客屡经。\n古今题写处，一半藓文青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之章岩","author":"朱熹","text":"驱马倦长道，投鞭憩此岩。\n来应六鳌戴，迹是五丁劖。\n泉脉流青润，林稍拥碧巉。\n老禅深闭户，客子且征衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山立春六言二首 其一","author":"朱熹","text":"雪拥山腰洞口，春回楚尾吴头。\n欲问闽天何处，明朝岭水南流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山立春六言二首 其二","author":"朱熹","text":"行尽风林雪径，依然水馆山村。\n却是春风有脚，今朝先到柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次二友石井之作三首 其一","author":"朱熹","text":"一窦阴风万斛泉，新秋曾此弄清涟。\n人言湛碧深无底，只恐潜通小有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次二友石井之作三首 其二","author":"朱熹","text":"联骑君登泉上亭，黄尘双眼想增明。\n篮舆独向溪南路，惆怅不成同队行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次二友石井之作三首 其三","author":"朱熹","text":"泉嵌侧畔一川明，水石萦回更有情。\n闻说近来疏葺好，想应仍是旧溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之铅山道中二首 其一","author":"朱熹","text":"几月高堂阙问安，归涂不管上天难。\n诵君两叠思亲句，也信从来取友端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之铅山道中二首 其二","author":"朱熹","text":"行尽江湘万叠山，家山犹在有无间。\n明朝渐喜登闽岭，涧水分流响佩环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之发紫溪有作","author":"朱熹","text":"明日振衣千仞冈，夜分起看月和霜。\n久知行路难如此，不用悲歌泪满裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵别林择之","author":"朱熹","text":"暂时相别不须悲，楚调凄凉政尔为。\n几曲清溪足相送，一天明月岂曾离。\n上堂嘉庆多为问，缘道风光少赋诗。\n更谢同袍二三子，夜来幽梦满春池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵别范伯崇二首 其一","author":"朱熹","text":"平生罪我只春秋，更作嚣嚣万里游。\n赖有吾人肯相伴，群讥众诋不能忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵别范伯崇二首 其二","author":"朱熹","text":"累月追随今别离，人生离合岂无时。\n愿言更励坚高志，力索穷探慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀南轩老兄呈伯崇择之二友二首 其一","author":"朱熹","text":"忆昔秋风里，寻盟湘水傍。\n胜游朝挽袂，妙语夜连床。\n别去多遗恨，归来识大方。\n惟应微密处，犹欲细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀南轩老兄呈伯崇择之二友二首 其二","author":"朱熹","text":"积雨芳菲暗，新晴始豁然。\n园林媚幽独，窗户惬清妍。\n晤语心何远，书题意未宣。\n悬知今夜月，同梦舞雩边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归报德再用前韵","author":"朱熹","text":"几枝藤竹醉相携，何处千峰顶上归。\n正好临风眺平野，却须入谷避斜晖。\n酒边泉溜寒侵骨，坐上岚光翠染衣。\n踏月过桥惊易晚，林坰回首更依微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中与林择之祝弟登刘园之宴坐岩有怀南岳旧游赋此呈择之属和并寄敬夫兄","author":"朱熹","text":"风雪集岁晏，掩关聊自休。\n今辰展遐眺，倚此寒岩幽。\n同云暗空室，皓彩迷林丘。\n崩奔小涧歇，飞舞增绸缪。\n仰看鸾鹤翔，俯视江汉流。\n乾坤有奇变，澒洞惊两眸。\n三酌不自温，倚杖空冥搜。\n悲歌动华薄，璀璨忽满裘。\n向来一杯酒，浩荡千里游。\n亦复有兹赏，微言寄清酬。\n解携今几许，光景逝不留。\n怀人眇山岳，省己纷愆尤。\n对此奇绝境，一欢生百忧。\n茫然发孤咏，远思谁能收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人游西岩","author":"朱熹","text":"平生壮志浩无穷，老寄寒泉乱石中。\n闲去披襟弄清泚，静来合眼听玲珑。\n不知涧寺晴时雨，何似溪亭落处风。\n吟罢君诗自潇洒，此心端不限西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次知郡章丈游山之韵","author":"朱熹","text":"前峰鸾鹤去无踪，邂逅荒寻得故宫。\n但觉风烟随意好，便惊尘土转头空。\n提壶命驾幽期远，授简哦诗妙处同。\n安得西山一丸药，共随箫鼓向云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题周氏溪园三首 其一 溪亭","author":"朱熹","text":"循涧辟芳园，结亭对虚壁。\n澄潭俯幽鉴，空翠仰寒滴。\n主人心事远，妙寄尘壤隔。\n岂为功名期，而忘此泉石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题周氏溪园三首 其二 雪亭","author":"朱熹","text":"危亭竹柏间，悄茜日幽绝。\n朔风一以厉，爱此枝上雪。\n仰悲玄景驶，俯叹群芳歇。\n不用此时来，那知岁寒节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题周氏溪园三首 其三 嫣然亭","author":"朱熹","text":"手种篱间树，枝繁不忍删。\n新亭最佳处，胜日共欢颜。\n景晏春红浅，雨馀寒翠潸。\n光风回巧笑，桃李任漫山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄林择之","author":"朱熹","text":"故人千里寄书来，三复尘襟顿豁开。\n劝我从容深燕养，莫将佔毕苦沉埋。\n杖藜此日应同趣，挥麈何时得共陪。\n珍重相期俱努力，自惭殊未竭渊才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林择之还乡赴选三首 其一","author":"朱熹","text":"青骊去路欲骎骎，回首犹须话此心。\n一别便成三数月，有疑谁讲过谁箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林择之还乡赴选三首 其二","author":"朱熹","text":"门外槐花似欲黄，高堂应望促归装。\n个中自有超然处，肯学儿曹一例忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林择之还乡赴选三首 其三","author":"朱熹","text":"今朝握手送君归，马上薰风拂面吹。\n不用丁宁防曲学，寒窗久矣共心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题林择之欣木亭","author":"朱熹","text":"危亭俯清川，登览自晨暮。\n佳哉阳春节，看此隔溪树。\n连林争秀发，生意各呈露。\n大化本无言，此心谁与晤。\n真欢水菽外，一笑和乐孺。\n聊复共徜徉，殊形乃同趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]