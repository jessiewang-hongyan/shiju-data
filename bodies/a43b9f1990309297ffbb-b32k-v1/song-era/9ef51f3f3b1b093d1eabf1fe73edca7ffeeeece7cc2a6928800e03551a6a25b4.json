[{"title":"人日出游湖上十首 其六","author":"杨万里","text":"城中雪一尺，山中雪一丈。\n地上都已消，却在松梢上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其五","author":"杨万里","text":"树隐重重竹，溪穿曲曲峰。\n林深那有寺，烟远忽闻钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其四","author":"杨万里","text":"肩舆岂不稳，万象非我有。\n呼童换马来，湖山落吾手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其三","author":"杨万里","text":"旧腊缘多雪，新年未有梅。\n殷勤下天竺，隔水两株开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其二","author":"杨万里","text":"去时数点雨，归时数片雪。\n雨雪两不多，山路双清绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日出游湖上十首 其一","author":"杨万里","text":"放闸冷泉亭，抽动一天碧。\n平地跳雪山，晴空下霹雳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日后归自郡城","author":"杨万里","text":"倦来睡思酒般醲，晓起东园看晓风。\n孤负梅花三四日，新年人事到城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"人日宿味田驿","author":"杨万里","text":"破驿荒凉晚解鞍，急呼重碧敌轻寒。\n南中气候从头错，人日青梅已酽酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"儿啼索饭","author":"杨万里","text":"饱暖君恩岂不知，小儿穷惯只长饥。\n朝朝听得儿啼处，正是炊粱欲熟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入上饶界道中野酴醾盛开二首 其二","author":"杨万里","text":"走上松梢绕却它，为它满插一头花。\n未论似得酴醾否，且是幽香野得些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入上饶界道中野酴醾盛开二首 其一","author":"杨万里","text":"千朵齐开雪面皮，一芽初长紫兰枝。\n一芽来岁还千朵，谁见开花似雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入长安闸","author":"杨万里","text":"船入长安恰五更，归人都喜近临平。\n阴晴天色知何似，篷上惟闻扫雪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入北昭庆寺","author":"杨万里","text":"两岸芙蓉雨洗妆，愁将红泪照银塘。\n抬头不起珠玑重，柳外西风特地狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入城","author":"杨万里","text":"杜鹃有底怨春啼，燕子无端贴水飞。\n不种自红仍自白，野酴醾压野蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入郡城泊文家宅子夜热不寐","author":"杨万里","text":"毒热通宵不得眠，起来弄水绕庭前。\n大星跳下银盆底，翻动琉璃一镜天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入常山界二首 其二","author":"杨万里","text":"昨日愁霖今喜晴，好山夹路玉亭亭。\n一峰忽被云偷去，留得峥嵘半截青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入常山界二首 其一","author":"杨万里","text":"老随千骑赴毗陵，骑吏朝来有喜声。\n未到常山三十里，此身已在浙中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入程乡县界","author":"杨万里","text":"长乐昏岚著地凝，程乡毒雾噀人腥。\n吾诗不是南征集，只合标题作瘴经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月十九日折梅二首 其二","author":"杨万里","text":"也知春向岁前回，不道春前早有梅。\n折得数枝撚归去，蜂儿一路趁人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月十九日折梅二首 其一","author":"杨万里","text":"初爱寒香一朵斜，又逢奇朵出高丫。\n折来折去花多了，忘却前花与后花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十七日大雪中过吉水小盘渡西归三首 其三","author":"杨万里","text":"雪吹醉面不知寒，信脚千山与万山。\n天甃琼街三十里，更飞柳絮与君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十七日大雪中过吉水小盘渡西归三首 其二","author":"杨万里","text":"腊残滕六不归家，白昼乘风撒玉沙。\n旋种琼田茁瑶草，更栽琪树著银花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月二十七日大雪中过吉水小盘渡西归三首 其一","author":"杨万里","text":"风卷寒江浪湿天，斜吹乱雪忽平船。\n碧琉璃上琼花里，独载诗人孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十山歌呈太守胡平一 其九","author":"杨万里","text":"北门今早顿然清，怀璧操金尽夜行。\n却有一般可怜底，群偷枉却费家兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十山歌呈太守胡平一 其十","author":"杨万里","text":"行人满路喜歌呼，小盗何须辱庙谟。\n早个使君归鼎轴，为禽颉利系单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十山歌呈太守胡平一 其七","author":"杨万里","text":"近有村人带血论，使君亲与验伤痕。\n鹜行刚道非行劫，只是行人两作喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十山歌呈太守胡平一 其四","author":"杨万里","text":"说似行人且细听，螺冈门外莫宵征。\n前头石斧韩婆岭，第一单身不要行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十山歌呈太守胡平一 其六","author":"杨万里","text":"王黄二盗久驰声，手棒腰刀白昼行。\n逢著村人持一物，喝令放下敢谁争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十山歌呈太守胡平一 其一","author":"杨万里","text":"豺虎深交雁鹜行，到官管取汝无妨。\n只将剽劫为喧闹，喝放归来尽陆梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月朝补种杏花","author":"杨万里","text":"百株种杏自今春，度夏荣枯不解匀。\n要看补栽新树子，荼糜红刺絓头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十里塘观鱼","author":"杨万里","text":"银塘打尽万银梭，岸上笭箵来正多。\n船载月明犹有月，无船无月欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和二绝句 其二","author":"杨万里","text":"剪剪轻风未是轻，犹吹花片作红声。\n一生情重嫌春浅，老去与春无点情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和二绝句 其一","author":"杨万里","text":"一冬寒不到深山，岂有春来更会寒。\n幸自趁晴行脚好，却嫌沙入破鞋间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和风雨二首 其一","author":"杨万里","text":"东风未得颠如许，定被春光引得颠。\n晚雨何妨略弹压，不应犹自借渠权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和风雨二首 其二","author":"杨万里","text":"风风雨雨又春穷，白白朱朱已眼空。\n拚却老红一万点，换将新绿百千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和梅雨","author":"杨万里","text":"管得天公雨更晴，何关客子病心情。\n得归此意良不恶，且住微躯也自轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又除夕绝句","author":"杨万里","text":"紫陌相逢谁不客，青灯作伴未为孤。\n何须家里作时节，只问旗亭有酒无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又题寺后竹亭","author":"杨万里","text":"行尽空房忽画栏，竹光和月入亭寒。\n壁间题字知谁句，醉把残灯子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万安出郭早行","author":"杨万里","text":"玉花小朵是山矾，香杀行人只欲颠。\n风掠水衣无处去，柳塘著在角头边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万安道中书事三首 其三","author":"杨万里","text":"桃花薄相点燕脂，输与梨花雪作肌。\n只有垂杨不脂粉，缕金铺翠衬腰支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万安道中书事三首 其二","author":"杨万里","text":"携家满路踏春华，儿女欣欣不忆家。\n骑吏也忘行役苦，一人人插一枝花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万安道中书事三首 其一","author":"杨万里","text":"玉峰云剥逗斜明，花径泥乾得晚行。\n细细一风寒里暖，时时数点雨中晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万花川谷","author":"杨万里","text":"无数花枝略说些，万花两字即非夸。\n东山西畔南溪北，更没溪山只有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三三径","author":"杨万里","text":"三径初开自蒋卿，再开三径是渊明。\n诚斋奄有三三径，一径花开一径行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月二十七日送春绝句","author":"杨万里","text":"只馀三日便清和，尽放春归莫恨他。\n落尽千花飞尽絮，留春肯住欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其二","author":"杨万里","text":"草藉轮蹄翠织成，花围巷陌锦帏屏。\n早来指点游人处，今在游人行处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其一","author":"杨万里","text":"暖轿行春底见春，遮栏春色不教亲。\n急呼青伞小凉轿，又被春光著莫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其五","author":"杨万里","text":"游人不是上坟回，便是清湍禊事来。\n最苦相逢无处避，天禧寺及雨花台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其四","author":"杨万里","text":"天公也自喜良辰，上巳风光忽斩新。\n点检一春好天色，更无两日似今晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其七","author":"杨万里","text":"粉捏孩儿活逼真，象生果子更时新。\n输赢一掷浑闲事，空手入城羞杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其八","author":"杨万里","text":"长干桥外即乌衣，今著屠沽卖菜儿。\n晋殿吴宫犹碧草，玉亭谢馆尽黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其三","author":"杨万里","text":"淮山脚下大江横，御柳梢头绛阙明。\n览尽山川更城郭，雨花台上太奇生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其十","author":"杨万里","text":"切忌寻春预作谋，教君行乐定成愁。\n老夫乘兴翩然出，不遣风知雨觉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其九","author":"杨万里","text":"除却钟山与石城，六朝遗迹问难真。\n里名只道新名好，不道新名误后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日上忠襄坟因之行散得十绝句 其六","author":"杨万里","text":"女唱儿歌去踏青，阿婆笑语伴渠行。\n只亏郎罢优轻杀，櫑子双担挈酒瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其五","author":"杨万里","text":"今年春事底匆匆，雨急风颠恼得侬。\n不见一林如许笋，犹嫌三日向来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其二","author":"杨万里","text":"出门著雨不能归，借得青蓑著片时。\n春染万花知了未，云偷千嶂忽何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其三","author":"杨万里","text":"归得茅斋松竹边，看风看雨亦欣然。\n空檐知与阶何故，须把青苔滴似穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其六","author":"杨万里","text":"荒馀只怪不愁声，好语烦君细细听。\n秧早不由田父懒，蚕迟端待柘阴成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其七","author":"杨万里","text":"迟日何缘似个长，睡乡未苦怯茶枪。\n春风解恼诗人鼻，非叶非花只是香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其九","author":"杨万里","text":"报答春光酒一卮，贫中无酒著春欺。\n作诗细与东风道，未必东风肯要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其一","author":"杨万里","text":"行春莫放一日一，修禊仍逢三月三。\n忍遣晴光作阴雨，更将急溅涴春衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其八","author":"杨万里","text":"村落寻花特地无，有花亦自只愁予。\n不如卧听春山雨，一阵繁声一阵疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其十","author":"杨万里","text":"却是春残景更佳，诗人须记许生涯。\n平田涨绿村村麦，嫩水浮红岸岸花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月三日雨作遣闷十绝句 其四","author":"杨万里","text":"旧与酴醾颇不疏，今春半朵未逢渠。\n千花一雨俱红雨，问讯孤芳小住无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日","author":"杨万里","text":"春光九十更三旬，暗准三旬赚杀人。\n未到晓钟君莫喜，暮钟声里已无春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日闲步西园","author":"杨万里","text":"岭南春去尽从伊，元自无花可得飞。\n只有草花偏称意，强留蝴蝶不教归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日游越王台二首 其二","author":"杨万里","text":"越王台上落花春，一掬山光两袖尘。\n随分杯盘随处醉，自怜不及踏青人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日游越王台二首 其一","author":"杨万里","text":"榕树梢头访古台，下看碧海一琼杯。\n越王歌舞春风处，今日春风独自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三江小渡","author":"杨万里","text":"溪水将桥不复回，小舟犹倚短篙开。\n交情得似山溪渡，不管风波去又来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三老董公","author":"杨万里","text":"一色三军雪染衣，拔山气力陡然衰。\n三王事业无多子，却是良平不得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三衢登舟午睡","author":"杨万里","text":"午思昏昏不肯醒，倦投竹枕睡难成。\n晓然有梦疑非梦，听得人声及水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳三首 其三","author":"杨万里","text":"正是春光最盛时，桃花枝映李花枝。\n鞦韆日暮人归尽，只有春风弄彩旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳三首 其二","author":"杨万里","text":"雨冷风酸数日强，老怀不可更禁当。\n春寒幸自归将去，唤取重来是海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳三首 其一","author":"杨万里","text":"上巳春阴政未开，寒窗愁坐冷于灰。\n冻蝇触纸飞还落，仰面翻身起不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其七","author":"杨万里","text":"湖上春游只爱晴，何朝何夕不晴明。\n绝怜疏雨微云里，点缀湖山分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其五","author":"杨万里","text":"篮舆休上马休骑，湿却青鞋也不辞。\n拣取雨丝疏处去，携筇且谒水仙祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]