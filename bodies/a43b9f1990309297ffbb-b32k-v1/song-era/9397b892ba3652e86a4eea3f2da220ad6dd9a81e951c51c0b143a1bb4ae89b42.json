[{"title":"大阳道中","author":"释正觉","text":"耿人胸次佳处，借力床头古藤。\n风树叶颓淅淅，秋山骨瘦棱棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼明安塔二偈 其一","author":"释正觉","text":"老阿师卒无嗣，石浮屠立有年。\n丁宁金针玉线，惭愧鸾胶凤弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼明安塔二偈 其二","author":"释正觉","text":"石床冷卧禅虎，阶芜秋跳草虫。\n有念耿怀陈事，无言凄立西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过王彦与郊居","author":"释正觉","text":"晨露晞时桑柘，宿云敛处溪山。\n摩诘画图未卷，渊明农事初閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即觉庵子中居士来访妙峰之西既去作六言五首送之 其三","author":"释正觉","text":"欲下前时雪磴，重开向日风翎。\n此去丁宁华鸟，莫来狼藉春庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即觉庵子中居士来访妙峰之西既去作六言五首送之 其五","author":"释正觉","text":"世外道人有在，庵中瓶粟无储。\n过客未容空去，挽衣相与分蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即觉庵子中居士来访妙峰之西既去作六言五首送之 其四","author":"释正觉","text":"归来三径春草，梦卧一团雨蓑。\n白发暗移玉烛，昏窗净洗金波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即觉庵子中居士来访妙峰之西既去作六言五首送之 其二","author":"释正觉","text":"梦晓寒松挂月，心秋古井含津。\n至道百家合辙，同风千里成邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即觉庵子中居士来访妙峰之西既去作六言五首送之 其一","author":"释正觉","text":"越境能来访我，扶筇颇肖游僧。\n得与坐间语味，谅其胸底怀冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芭蕉道中","author":"释正觉","text":"雨暗冈头客路，炊烟山里人家。\n映水竹鸡聒聒，飘风字雁斜斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童","author":"释正觉","text":"水牯老行步稳，蓑郎痴歌笑繁。\n物外初无尘滓，胸中别有丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百则 其五","author":"释正觉","text":"太平治业无像，野老家风至淳。\n只管村歌社饮，那知舜德尧仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成示众","author":"释正觉","text":"杨柳斜风力弱，芭蕉击雨声寒。\n莫把见闻作对，谁将声色相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十四","author":"释正觉","text":"棱棱之山早雪，渊渊之水先秋。\n静也虚谷之应，动也闲云之流。\n自怜方外专默，谁与环中至游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○六","author":"释正觉","text":"天苍苍而云閒，水深深而月寒。\n妙一点之自得，纵四辩以奚殚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释正觉","text":"句里明宗则易，宗中辨白则难。\n冻鸡未报家林晓，隐隐行人过雪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人谒柳开","author":"释正缘","text":"柳墙高于花，怒飞方可至。\n奇哉游夏徒，吐辞作雄翅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落叶","author":"释正勤","text":"萧索下疏林，翩翩动客心。\n带烟浮远水，和露逐飞禽。\n近砌凋将尽，前村叠更深。\n年年见衰谢，看即二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云亭","author":"释正韶","text":"白云亭上白云闲，云满危栏雪满山。\n雪似白云云似雪，不知何处是人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠英公大师","author":"释永牙","text":"吾宗何事独称雄，今昔名高继古风。\n王右军书传智永，李阳冰篆付英公。\n墨研天电煤疑绝，砚琢端溪石欲空。\n珍重真踪千载后，谁来三日看无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答僧","author":"释永安","text":"汝问西来意，且过这边立。\n昨夜三更时，雨打虚空湿。\n电影忽然明，不似蚰蜒急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺秋日 其一","author":"释永颐","text":"翠滴千竿湿砌苔，曲廊花木小丛开。\n吴僧爱觅閒吟处，偷向花边竹里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺秋日 其二","author":"释永颐","text":"行绕方池日又斜，青云小注湿秋霞。\n阑干几度浑敲遍，为引游鱼出浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水仙花","author":"释永颐","text":"洛浦香销佩解时，荆台归去峡云迟。\n绿罗湘带无心叠，玉坠头花一半垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答周伯弜信后见寄","author":"释永颐","text":"清茶相对饮山卮，忆在西峰寺里时。\n今日云深无好伴，涧松独看挂猿枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老梅","author":"释永颐","text":"一度开花一度新，莫嫌终老旧花身。\n文君头白空衔怨，不及枝间碧藓春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖日暮","author":"释永颐","text":"渺渺春湖夕霭浮，落花飞燕打兰舟。\n游人半入烟城去，月照笙歌上水楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观小鱼","author":"释永颐","text":"藻间相失复相寻，水面争浮力未禁。\n隔岸木兰船欲去，浪花摇动一时沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观乌鸢山下藤树","author":"释永颐","text":"一株老树蔽荒林，下有藤悬巨蟒身。\n几度日斜乌鸟散，山昏鬼哭断行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过吴门 其二","author":"释永颐","text":"花落春江一夜风，满江烟碧撼垂虹。\n轻舟浮载如天上，况是残云细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过吴门 其一","author":"释永颐","text":"故苑烟花百草香，五湖人去事茫茫。\n浮云几度春阴合，犹见西山白鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过聚景园","author":"释永颐","text":"路绕长堤万柳斜，年年春草待香车。\n君王不宴芳春酒，空锁名园日暮花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听琴","author":"释永颐","text":"蘼芜香散楚江头，湘竹丛边泪不收。\n莫把朱丝写离恨，夜深帘外鬼神愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废宫","author":"释永颐","text":"渺渺笙歌散石筵，霓旌吹断网蛛悬。\n经年不锁青鸾殿，野鹤飞来玉几前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"果熟","author":"释永颐","text":"方池曲沼动林花，竹院僧閒日又斜。\n西崦果园方晚熟，一双乌臼打乌鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨窗","author":"释永颐","text":"江湖春水欲生时，开尽梅花雁北飞。\n风雨满庭人不寐，小窗灯火夜深微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春至 其二","author":"释永颐","text":"朝吟还自酬，暮吟还自酢。\n年光整整来，山房人亦乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春至 其一","author":"释永颐","text":"松鸣山欲浮，昨夜春风过。\n晓户启晴光，早莺啼一个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看梅杂兴 其三","author":"释永颐","text":"青松古院一株梅，寒殿无人花自开。\n日暮老僧清梵罢，夜深偷照月华来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看梅杂兴 其一","author":"释永颐","text":"春动晴山照野扉，早梅开后失归期。\n夕阳无柰山邮路，过尽行人雪满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚","author":"释永颐","text":"拒霜花落碧潭秋，懒向山巅水际游。\n自看夕阳乌臼树，白云红叶乱溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋蝉","author":"释永颐","text":"日落秋蝉噪柳津，为伤风露咽声频。\n送晴送雨江亭外，偏感舟行晚泊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶炉","author":"释永颐","text":"炼泥合瓦本无功，火煖常留宿炭红。\n有客适从云外至，小瓶添水作松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天竺僧还乡","author":"释永颐","text":"月冷云深天上寺，桂花千树绕楼台。\n归时若对閒人说，莫道身从月里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别","author":"释永颐","text":"送别春湖动客心，荇花无浪飐寒金。\n晴山望极连江郡，沙鸟风樯度远林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归茜径","author":"释永颐","text":"吴渚僧归落日曛，故王宫井已无闻。\n水边尚有红蓝草，不染香衣染堑云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓离山隐","author":"释永颐","text":"出山便与山花别，清露丛边不得留。\n去伴水禽船上宿，石溪斜月下沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿永安潭上","author":"释永颐","text":"子规啼在乱山中，废寺春深暮阁重。\n门外永安潭上水，朝昏惟送一楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿村庄","author":"释永颐","text":"蝼蛄偷火照田沟，山鬼移灯上树头。\n枫岸夜深茅屋闭，月明沙鸟自相讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄友","author":"释永颐","text":"闻君萧散在田庐，想见琴书足自娱。\n欲挈瓶盂就茅屋，桃源图上有僧无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄行宫监门王以通 其一","author":"释永颐","text":"中兴天子议攻车，叹息诸公屈壮图。\n行殿不开尘锁合，至今风雨暗金铺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄行宫监门王以通 其二","author":"释永颐","text":"玉钩帘外前朝柳，斗鸭阑边小艳葩。\n莫道君王不曾问，好收银钥护宫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中海棠","author":"释永颐","text":"蜀妃夜谒紫虚皇，玉凤差参促晓妆。\n宴罢瑶台魂未醒，胭脂脸上白云香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游张园观海棠戏作","author":"释绍嵩","text":"春色都将付海棠，群仙会处锦屏张。\n约斋妙出春风手，子美无情为发扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上春晚","author":"释永颐","text":"水边三月芳菲晚，杨柳楼船拥万家。\n浩浩歌钟迷白日，不知烟寺落桐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上","author":"释永颐","text":"休文垄上阴云起，雨涨定安桥下水。\n渔人莫倚满溪流，见说长蛟剑为齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"裴六书堂","author":"释永颐","text":"数峰相对夕阴遮，新占书堂旧竹斜。\n地冷石阶秋菊小，一丛开得两三花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"震父与僧偕至","author":"释永颐","text":"王谢清游带越僧，共携山老坐吴亭。\n身閒不记为官日，落落吟诗读道经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题壁","author":"释永颐","text":"春来日日风兼雨，开户晴轩长翠萝。\n山鹊弄花飞不远，隔檐冲散落梅多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹫峰 其一","author":"释永颐","text":"山后山前行遍了，倚阑不是动秋吟。\n从头自较山中石，烟雨苔痕几片深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹫峰 其二","author":"释永颐","text":"苔峰只就阶基列，卧榻云窗烟翠凉。\n老去山中贪胜赏，只应迢递负三湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨","author":"释永颐","text":"山房十日雨，仰栋看行蜗。\n笋暗风庭竹，萱凝晚砌花。\n罂红留夕火，焙绿荐春芽。\n滴滴西窗下，清泉满石洼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山池早秋","author":"释永颐","text":"荷叶倾香露，山池见早秋。\n石凉幽蟹过，枝脆雨蝉休。\n废堰凭虚涨，荒泉入乱流。\n水花红漠漠，相对渚云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行与伯弜同赋野庙","author":"释永颐","text":"芳草没荒基，终年掩画扉。\n酒台乾旧滴，香殿入斜晖。\n神树枝枝曲，山魈个个归。\n春来歌鼓动，野老荐春薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山村日暮","author":"释永颐","text":"犊背斜阳暖，茅茨石树穿。\n行人识冈路，饥鹊噪沙田。\n远浦生微月，荒皋起暝烟。\n群乌飞散尽，寒水漾渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆旧隐付柔上人","author":"释永颐","text":"遥忆荒阶碧藓生，木兰露重滴归情。\n秋山松桂皆森爽，夜馆星河几晦明。\n溪色乍凉双鹭下，雨声才绝一蝉鸣。\n经房旧掩青枫老，此夜无人月影清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山乐官","author":"释永颐","text":"古来歌舞者，乐极总幽沈。\n山鬼昼无影，春禽歌好音。\n梨园虚宝閟，玉树慢荒淫。\n一曲烟萝外，伤哉悲乐心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汀涨","author":"释永颐","text":"泽国迷春涨，芳洲生绿波。\n净涵汀树小，閒占浦云多。\n风晚低轻燕，川明媚浴鹅。\n望人烟思远，奈此暮山何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙岫南窗书怀","author":"释永颐","text":"茅堂犹未卜，幽兴日迟回。\n带雨听昏笛，和灯看落梅。\n春风三月近，客鬓二毛催。\n忆得初来日，山寒暝叶堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵伯弜值雨见留","author":"释永颐","text":"涧谷饶春雨，烹茶近石池。\n竹鸡鸣野堑，山雉出荒篱。\n草长藏初笋，花空只旧枝。\n旅怀吟不尽，刻竹记幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"防风王庙","author":"释永颐","text":"万国方尊禹，防风殒殿趋。\n应怜舞干戚，独不碍唐虞。\n祭豆侵田鼠，灵幡触井乌。\n椒浆春奠罢，箫鼓舞村巫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初秋忆湖上诸山","author":"释永颐","text":"山中夏日足幽娱，葛帔藤床诵宝书。\n白拂惹云黏几案，清香缘竹上空虚。\n草堂夜月秋花近，水阁晨霞夕霓疏。\n遥忆钱唐旧朝寺，绕湖钟梵早凉初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周令自江夏归郜溪","author":"释永颐","text":"芳草萋迷征骑归，且依张负入书帷。\n家园懒记閒花草，蔬豆重甘旧藿葵。\n崔颢能吟有陈迹，祢衡作赋想当时。\n才能往往为身累，好读渊明饮酒诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜归","author":"释永颐","text":"昨夜溪上归，云下扣松扉。\n老褐启重钥，瘦厖循我衣。\n院静雨声大，气寒灯晕微。\n叨叨听林鸟，春歇诉无依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往龙岫舟中","author":"释永颐","text":"龙山溪上路，短棹腊中行。\n雪霁寒郊阔，春回宿雾生。\n柳摇冰线断，鹭起玉衣明。\n未见晴梅发，先思杖屦轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘","author":"释永颐","text":"山色吴门少，行人爱此游。\n天高云阁晚，石裂剑池秋。\n虎去空陵变，僧栖古塔幽。\n上方曾眺远，落日驻扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日泛舟","author":"释永颐","text":"野外苔矶好，孤舟未可抛。\n碧溪沿谷口，晴柳护塘坳。\n波静鱼吹沫，林深鹊隐巢。\n轻云障暖日，閒思渺春郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]