etry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登舟雨作再作一绝","author":"张嵲","text":"平生过眼无穷景，未省经行有此奇。\n烟雨连山催去棹，不容青壁更题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登胥山赠长老净昙二首 其二","author":"张嵲","text":"诗律遥追璨可流，安禅总不碍闻修。\n劝君着意搜新句，准拟他年有惠休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登胥山赠长老净昙二首 其一","author":"张嵲","text":"白水环村漫漫流，天边浮绿远眉修。\n春晴一试登山屐，愧乏新诗与惠休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登真观遗履池","author":"张嵲","text":"古柏参天鹤不归，空馀池水澹清晖。\n当时遗舄今安在，应作双凫过水飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼对雪二首 其二","author":"张嵲","text":"朔风几夜相回薄，世路秪今多苦辛。\n擒寇可无悬瓠将，泛舟未许剡溪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼对雪二首 其一","author":"张嵲","text":"冰花不省如斯暴，疑是吹沙打夜窗。\n莫遣沉阴增敌气，且将盈尺作农祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f7