[{"title":"闻荒鸡","author":"张嵲","text":"但可摧颓悲失旦，不应风雨误司晨。\n书生久已垂华发，岂是当年起舞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乘舟阻风","author":"张嵲","text":"平生所遇悉堪咍，往返江湖知几回。\n长是扁舟阻风浪，羡他舟楫挂帆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌云见桃花","author":"张嵲","text":"旷却相随不相识，主翁翻作白头新。\n桃花未见不曾失，拈出还成埋没人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唁菊","author":"张嵲","text":"中秋是处已扬芳，篱下朝来欲破黄。\n赖得雨荒兼早没，却能应候作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唁微水","author":"张嵲","text":"水畔平沙如积雪，滩心狠石似群牛。\n如何夏日千雷怒，今作寒宵呜咽流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涧边","author":"张嵲","text":"乔林近水叶阴阴，萦石溪流自浅深。\n隔水群山森夏木，白云楼起媚遥岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疾风伯","author":"张嵲","text":"不雨经时气若焚，共欣疏点夜深闻。\n平明忽捲重阴尽，可是风师待策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竞渡","author":"张嵲","text":"吴俗春来斗画船，疾驱波上若飞烟。\n去春放逐曾观此，伐鼓声中又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读太平广记三首 其三","author":"张嵲","text":"梦里空惊岁月长，觉时追忆始堪伤。\n十年烜赫南柯守，竟日欢娱审雨堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读太平广记三首 其二","author":"张嵲","text":"月下来过徵士门，可怜桃李尽能言。\n其如苦畏春风暴，可为墙东植绛幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读太平广记三首 其一","author":"张嵲","text":"禁苑茫茫尽日吹，桃红李白祗青枝。\n唯馀阿醋偏骄妒，不畏封家十八姨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赵飞燕外传杂诗七首 其四","author":"张嵲","text":"汉武馀威信未穷，单于来见未央宫。\n如何运偶鸿嘉主，樊嫕宫中作女戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赵飞燕外传杂诗七首 其七","author":"张嵲","text":"合德来嫔帝甚欢，温柔乡里胜求仙。\n武皇虽被白云误，犹得垂衣到暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赵飞燕外传杂诗七首 其六","author":"张嵲","text":"赤凤谩言最可伤，君王不谓有他肠。\n并疑池上将仙去，祇恐留连为侍郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赵飞燕外传杂诗七首 其二","author":"张嵲","text":"九回沉水新为髻，故绣裙襦稳称身。\n祸水歘来漂燎火，知几唯有淖夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赵飞燕外传杂诗七首 其三","author":"张嵲","text":"魏宫怅望杨花去，汉掖齐歌赤凤来。\n淫蛊到头成底事，荒田野草但堪哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读赵飞燕外传杂诗七首 其一","author":"张嵲","text":"漫漫积雪被岗坻，宜主当时有暗期。\n忽见梅花照夜发，祇疑犹待射雕儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读崔昭纬传","author":"张嵲","text":"季末慆忧事可嗟，本根已拨尚肥家。\n那堪事异荀文若，空费君王十四车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读楚世家","author":"张嵲","text":"丧归荆楚痛遗民，脩好行人继入秦。\n不待金仙来震旦，君王已解等冤亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成梅咏三首 其三","author":"张嵲","text":"雾态风姿紫府仙，直疑清夜降羊权。\n不知老大心灰久，香气撩人似昔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成梅咏三首 其二","author":"张嵲","text":"故园微路绕江干，常记开时偪岁寒。\n万里临风惊老眼，却疑还是雾中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成梅咏三首 其一","author":"张嵲","text":"开时都不值繁华，结实调羹尚有誇。\n若语当年上春事，总输凡木后开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿归仁寺三首 其二","author":"张嵲","text":"乔林众鸟集，暮气氛氲上。\n好在三巴山，何时正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汉上禅者","author":"张嵲","text":"睡起题诗寄汉滨，几年音信断知闻。\n何人为我持瓶去，满贮虚昙一饷君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄酂里","author":"张嵲","text":"长江依旧循荒垒，零落遗民有几家。\n莫伐城边旧桃李，为怜曾发乱前花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56487,"sha256":"18413bf73b9d113baa963a97950b8