[{"title":"直阁张功甫南湖集","author":"曾丰","text":"百好何尝一徇时，游心上与古相追。\n不容万物移吾学，犹得馀功到此诗。\n玄酒太羹无痛快，光风霁月有长思。\n披吟不足仍含咀，吾坐若忘行若遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"经从两浙","author":"曾丰","text":"渺渺秦航渡，茫茫夏盖湖。\n地形东带越，山势右襟吴。\n胜负心徒热，兴亡骨并枯。\n古今姑弃置，一笑问归途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗子琳来就广漕试予以檄出至西江峡口怀古感兴两篇寄子琳后篇救子琳穷病也 其二","author":"曾丰","text":"摹写闲泉石，雕锼病肺肝。\n得无縻岁月，终不补饥寒。\n上固诏求士，谁将诗得官。\n何如经学熟，随计上长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗子琳来就广漕试予以檄出至西江峡口怀古感兴两篇寄子琳后篇救子琳穷病也 其一","author":"曾丰","text":"自朝连夕去，由海入江来。\n紫石岩前出，青山峡外开。\n秦贪徒郡县，粤僭强楼台。\n陆贾严夫子，千年一倚桅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"英连江口三庙","author":"曾丰","text":"何处丈夫儿，不知名姓谁。\n弟兄三异相，上下两灵祠。\n江海为疆域，风雷听指麾。\n与人作方便，慷慨似生时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"表兄峡山萧伯钧至会昌久之以归欤字韵丐诗为别 其二","author":"曾丰","text":"握手两旬许，归途千里馀。\n继今难得便，及早发回书。\n父祖初深契，儿孙久渐疏。\n朱陈婚嫁约，还可继之欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"表兄峡山萧伯钧至会昌久之以归欤字韵丐诗为别 其一","author":"曾丰","text":"久离空向往，重见少相依。\n款曲论心约，因循与愿违。\n今逢声气是，但觉鬓毛非。\n祸患今相问，几从死处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨霁宿荐福寺遣问寺僧","author":"曾丰","text":"松筠邀我梵王宫，耳目俱醒骨肉融。\n风雨收声禅入寂，烟云敛色法归空。\n出浮沤外不生灭，从浩劫来无异同。\n问数比丘皆卷舌，舌虽不卷亦无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯赵提干次李彦中韵","author":"曾丰","text":"解组图南日，携壶贺下时。\n三杯几绝倒，明日两差池。\n足迹随蓬转，颠毛与雪期。\n我愁行未得，更赋送行诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安主人出冰块佐饮曾簿严宰同赋","author":"曾丰","text":"久在京尘里，仍当伏暑中。\n眼逢银色界，身落水晶宫。\n有客清相似，无人白与同。\n雪儿不可作，随意酒杯空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前仁和郑宰侨富阳与陈宰往还以诗余寓妙山得其所和诗后复寄一篇","author":"曾丰","text":"宣化承流退自公，优柔厌饫有新功。\n先天勘破道玄牝，后社推为诗长雄。\n情性唐虞三代上，篇章韶濩六䪫中。\n河汾所续吾其再，首录东吴两国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南峰寺劝农","author":"曾丰","text":"队吏衙官出劝农，前驱亭午驻南峰。\n香烘贮雾含云鼻，茶荡吞江纳汉胸。\n柳自放慵乘困思，花相学醉弄娇容。\n老人莫答韶光意，尽量相陪酒一钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南浦思归","author":"曾丰","text":"党论开危道，功臣发祸端。\n未投彭泽绂，犹著外黄冠。\n用是颜其厚，言之鼻似酸。\n薄羹鲈鲙好，归兴未应阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南康黎蔡昆仲四君子隆兴乾道间与余为庐陵郡庠同舍淳熙乙巳之元日余赴广东漕属道出南康敬赋一诗书两通分遗之","author":"曾丰","text":"转徙庐陵邂逅间，青灯相照稔相看。\n那知文社春随冷，未放交盟血便寒。\n腰强岂犹便敛板，手閒何不试弹冠。\n山岩倘久奇文塞，我办工夫续子残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用前韵呈黄教授 其二","author":"曾丰","text":"有底杜陵语，不惊人不休。\n笔端非外铄，胸次有天游。\n自发人三叹，而销我四愁。\n忘其舒若疾，何适不犹犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用前韵呈黄教授 其一","author":"曾丰","text":"程子轲而下，韩公汉以还。\n彼非孤所上，人莫夺其间。\n死后虚名满，生前实效悭。\n始吾谋向背，其决不胜艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜感物书怀","author":"曾丰","text":"阁阁蛙鸣夜，嘈嘈鸟语春。\n物情犹任理，世事岂由人。\n时自有迟速，道初无屈伸。\n圣贤得贫力，吾恨不全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夏之交沿途触目","author":"曾丰","text":"往年休叹去骎骎，只数今年且十旬。\n稚绿已争欺旭暑，老红犹强护畸春。\n水平似面因风皱，山远如眉得雨颦。\n物态到前长是笑，不知物态总关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨与余游如陈广元张寿卿江伯纪陈通卿皆上计矣独邹用之邓继高困阨况今相去愈远焉缅我怀因成两诗各书一通寄之 其二","author":"曾丰","text":"章贡三年两到休，况今又落最南州。\n思归梅岭不相梦，惜别葛溪犹涨愁。\n子为坐穷知理道，吾从遭病忆交游。\n明年肯为槐花出，来看海濒天尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昨与余游如陈广元张寿卿江伯纪陈通卿皆上计矣独邹用之邓继高困阨况今相去愈远焉缅我怀因成两诗各书一通寄之 其一","author":"曾丰","text":"枕中肘后为渠空，效验如何小不同。\n失马安知非后福，获麟未必不终穷。\n纪昌已费二年学，造父犹争三日功。\n了却酸辛残事业，从教运塞与时通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸丑秋游疏山首坐玑上人以其尝在五羊相识求诗","author":"曾丰","text":"达磨泉华涌，曹溪水线开。\n何从南派出，而过北宗来。\n眼勘江西破，肩担法窟回。\n少伸龙象蹋，无复说黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"神农冢在茶陵舜冢在道途中行人指似焉","author":"曾丰","text":"康乐神农冢，苍梧大舜邱。\n望望千许里，表表万斯秋。\n御祝书名谨，皇家祀典优。\n行人相指似，若或见松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日途中","author":"曾丰","text":"祝融辞退舍，少皞出专权。\n清气露之独，杀声风所偏。\n林凋光漏日，水落影澄天。\n每出皆秋季，与秋殊有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋途暮息","author":"曾丰","text":"密密初秋雨，蒙蒙欲暮天。\n牛羊争欲下，车马敢求前。\n蟋蟀挑孤咏，梧桐搅独眠。\n及身无一事，梦到汗漫边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋意自适","author":"曾丰","text":"燕方为去计，鸿已报来期。\n老火晨相谢，新凉夜见私。\n耽书灯可眼，渴睡簟宜肌。\n好处分明是，橙黄橘绿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴广东漕属有感","author":"曾丰","text":"草木归根稳，昆虫入蛰深。\n若为吾自觉，犹与世相寻。\n江月幽人态，松风大雅音。\n红尘任相衮，终不点初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴广过赣呈留主管王提干","author":"曾丰","text":"世味不分甘与苦，吾年未老已先尝。\n炉边醉后暖生睡，雪里饥馀寒欲僵。\n出处任缘常梦好，陆沉随分自心凉。\n经过少叙江山旧，鱼鸟多情尚未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴琼州次大蓼滩风雨交作寒未艾也其势欲雪 其二","author":"曾丰","text":"挈家随牒一阳初，视险如夷舟当车。\n赣石罅中渔路寝，楚天包处燕蘧庐。\n木无弃本藏于密，江不辞流受以虚。\n万物外吾诗者少，惜乎南燕久归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送广东赵主管得倅临漳 其二","author":"曾丰","text":"有伟今丞相，犹亏□令君。\n全材拔半刺，白发拥红裙。\n何处分风月，无时上水云。\n莫将车骑去，惊动白鸥群。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送广东赵主管得倅临漳 其一","author":"曾丰","text":"清切分天派，馨香出月宫。\n羊城初白发，莲幕两春风。\n外计方将上，南图又欲东。\n我来犹未晚，几度笑谈同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送中书舍人郑惠叔入国 其二","author":"曾丰","text":"万里出疆车，驰驱过故都。\n离离京国黍，猎猎塞垣榆。\n城邑坚和脆，山川径与迂。\n要归奏天子，潜笔写为图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送中书舍人郑惠叔入国 其一","author":"曾丰","text":"北戎轻用武，西汉重开边。\n币帛毫芒费，生灵百万全。\n几驰衔命使，今辍判花员。\n专对从容道，王君正乐天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送五行家唐克寿","author":"曾丰","text":"初心半信术家流，百诺于兹未一酬。\n一行无非占不验，北平终是命难侯。\n云霄许我乘南鹄，江海教谁伴白鸥。\n季主游方逢贾谊，慇勤勉为汉家谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘薰卿","author":"曾丰","text":"未曾得隽利名场，犹敢犯危烟瘴乡。\n大庾岭高梅挺拔，东莞天远海汪洋。\n其凡饱以史收拾，所异刚于诗主张。\n归数群雄可雌视，麒麟谁得碍康庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张叔介","author":"曾丰","text":"籍甚江西汝水头，功名驱作岭南游。\n当机笔易千人阵，得意诗轻万户侯。\n炫昼江山供泛爱，酣冬风雨送牢愁。\n脚皲莫患无堪软，四海多情涂柳州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送欧阳瑩中往湖南谒卿漕","author":"曾丰","text":"几回双脚为亲轻，未餍其亲锐此行。\n白面书生谁一顾，绣衣使者自多情。\n祝融雨后山归洁，彭蠡秋来水中清。\n收拾还家自金玉，从渠唤我太高生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"曾丰","text":"春来如柅去如流，迟速乘除不自由。\n人道朱明阴见迫，我疑红紫老知收。\n蜂围蝶绕争依恋，燕语莺啼强挽留。\n惟有杜鹃却相亮，声声劝道好归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送段文子之桂阳","author":"曾丰","text":"瘦筇轻拨火云开，前若相招后若推。\n康乐苍梧充史具，祝融彭蠡效诗材。\n况馀湘水故人在，曾为阮家青眼来。\n囊正自枵我辄瘿，好音听与雁俱回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送夏国宝","author":"曾丰","text":"螺山螺水爱其英，属者分之太少生。\n不啻海涵胸次大，犹贤泉涌笔端清。\n百年事已馀长虑，千古功犹欠大成。\n归觅知音振贫悴，重来参我勘希声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送副将胡义民到部复还广东 其二","author":"曾丰","text":"诵史胸翻海，谈兵气拔山。\n奔驰非得已，矍铄未容闲。\n瓜戍开年赴，梅关趁腊还。\n同僚如问我，炊玉待春班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送副将胡义民到部复还广东 其一","author":"曾丰","text":"等是天涯客，同为岭表官。\n曳裾行蹑履，持板立骈冠。\n簿领无多暇，杯盘未尽欢。\n夤缘离复合，烂熳醉长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹伯高 其二","author":"曾丰","text":"笔研为谋左，风霜与岁濒。\n犬呿如不夜，鸡噤似无晨。\n杖屦唤行客，衣冠辞主人。\n愿言偏强饭，涵养窦庭椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹伯高 其一","author":"曾丰","text":"绛帐横经后，青灯曲几前。\n酒杯閒留坐，茶椀几忘眠。\n虚受口三益，平反诗十愆。\n未阑宾主意，相约更明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送董一之之长沙谒周丞相","author":"曾丰","text":"北陆澄彭蠡，南青拔祝融。\n古都为汉郡，今牧得周公。\n访戴休辞远，依刘莫讳穷。\n宽为五旬别，归橐盎春宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送管长源之子光祖往谒周益公","author":"曾丰","text":"齿德两峥嵘，严君汉伏生。\n勖哉恢学力，行矣赫家声。\n一代道宗主，三朝人老成。\n金篦容刮膜，管取眼增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送管廷辉归章贡","author":"曾丰","text":"久别重逢笑脱颐，休谈愁绪杀腰围。\n不如意处人人有，未放心时事事非。\n蔬笋家风难以住，莺花天气速人归。\n归囊强半诗材具，莫怪齐眉不下机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送镇江张禹功献边事未报过建康谋辟","author":"曾丰","text":"边上事千种，袖中书一编。\n曳裾逢白眼，骧首隔青天。\n又辍安刘手，而撑访戴船。\n严公犹欠士，应辟老诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逆旅书怀","author":"曾丰","text":"吾生宜客不宜家，今趁轻舟傍浅沙。\n天拥云堆浮玉乳，波摇日影弄金花。\n诗中已醉那消酒，饭后虽酲可废茶。\n安得长闲棹歌里，清风明月任年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋与济叔薰卿论文","author":"曾丰","text":"著书夫岂易乎云，不自鞭心不策勋。\n望道初犹未之见，言天终可得而闻。\n囿于有极非皇极，概以无文是至文。\n万一未能全免俗，宁为八卦易三坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋与龚济叔刘薰卿谈诗","author":"曾丰","text":"其奈鱼虫草木何，诗之机械也无多。\n气犹动志平心养，声可成文泛口哦。\n玄酒太羹君子淡，蒉桴土鼓圣人和。\n鬼神天地与吾一，相感相通岂在他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九独酌次偶成数韵呈江司法李帐干并同游诸僚兄 其二","author":"曾丰","text":"孙盛龙山集，刘洪凤岭游。\n孰非陪好客，俱不负高秋。\n白发与时背，清风劝我休。\n黄花娇媚意，喜上少年头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九独酌次偶成数韵呈江司法李帐干并同游诸僚兄 其一","author":"曾丰","text":"浓煮茯苓饮，细研松柏脂。\n虽名为节物，未必合时宜。\n旨酒淘茱糁，华颠岸菊枝。\n妻孥争笑我，将老尚儿痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除日送龙涎香与宋评事 其二","author":"曾丰","text":"半载随蓬转，中宵送夜分。\n酒供文字饮，香对圣贤焚。\n羡子迎偏老，呼儿酌细君。\n劝酬交错里，款款鸭炉薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除日送龙涎香与宋评事 其一","author":"曾丰","text":"除夕风霜节，家人锦绮筵。\n舌头馀凤髓，鼻观欠龙涎。\n玉饼聊分饷，金炉试一燃。\n更将国香匹，何似海南烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"项尧章惠二长韵姑赓前篇敬复","author":"曾丰","text":"飘然逸思发于天，三百年间一谪仙。\n歌调谁欤追白雪，颂声行矣擅甘泉。\n山林新筑梦归处，学校旧游愁到边。\n回首不堪更开口，相过聊复茗瓯传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"候潮钱塘渡","author":"曾丰","text":"眼厌纷华久，身离阛阓初。\n市声方较少，春色况犹馀。\n海沸如中热，山浮若内虚。\n坐穷消息理，万事付乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拿舟送使长马少卿既酌别维舟小憩与李彦中各赋一篇","author":"曾丰","text":"宾主相从久，情亲更受知。\n追随船泊处，饯送酒醒时。\n落照关思忆，垂杨管别离。\n非诗愁莫写，愁绝不胜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽上官茂叔","author":"曾丰","text":"读书初有激，知命复何营。\n熊掌酒中趣，鸿毛身后名。\n山川揫宝气，学校戛金声。\n老骥随驹逝，若为泉下情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王抚干","author":"曾丰","text":"江左风流迹已陈，故家馀韵更何人。\n云霄浩荡开雏凤，岁月峥嵘逼老椿。\n三釜未终身大暮，九泉无憾意长春。\n北邙山下重回首，片玉空怀万古尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王诚夫母夫人","author":"曾丰","text":"雍雍瑟配琴，诗礼五青衿。\n四举一门事，三迁平日心。\n桂枝方日长，萱草已春深。\n咫尺青山里，萧然隔古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽庐陵葛孝子母夫人","author":"曾丰","text":"笄珥初归室，缫纫共起家。\n清风依玉树，和气茁兰芽。\n送子归黄壤，收名入白华。\n大书彤史上，谁谓过于夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张郴州 其四","author":"曾丰","text":"鸿渐南中掾，莺乔西外丞。\n华途于此奋，厄算乃吾乘。\n妙学家传钵，殊科世续灯。\n兹其有以死，名死实何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张郴州 其三","author":"曾丰","text":"永平称善状，长乐沸廉声。\n孝史行于世，尚书荐以名。\n匪朝金马去，有顷玉楼成。\n不是文星坠，文星复太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张郴州 其二","author":"曾丰","text":"四海郑元枢，三朝范石湖。\n利光腾鹗表，自足济鹏图。\n芝检岂欺我，朱轓何负余。\n幸而廉吏传，名与泰山俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张郴州 其一","author":"曾丰","text":"轻甘相润泽，清苦自磨磋。\n数矣充周赋，优哉中汉科。\n上分之左竹，公付以南柯。\n天不慭遗意，其如人望何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]