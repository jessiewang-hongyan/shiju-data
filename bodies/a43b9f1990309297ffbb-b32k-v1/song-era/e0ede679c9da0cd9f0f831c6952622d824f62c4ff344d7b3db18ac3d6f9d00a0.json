[{"title":"次韵子瞻太白山下早行题崇寿院","author":"苏辙","text":"山下晨光晚，林梢露滴升。\n峰头斜见月，野市早明灯。\n树暗犹藏鹊，堂开已馔僧。\n据鞍应梦我，联骑昔尝曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻延生观后山上小堂","author":"苏辙","text":"谢公游意未能厌，踏尽登山屐齿尖。\n古殿神仙深杳杳，香炉烟翠起纤纤。\n岩花寂历飘琼片，庭桧萧疏漏玉蟾。\n帝子莫归人不见，微风细雨自开帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻有美堂夜归","author":"苏辙","text":"饮阑钟虡欲移轩，香雾犹残金博山。\n明月飞来松岭外，游人散落马蹄间。\n城严画鼓初传角，路暗山花自落鬟。\n清境暂时都不见，夜深人尽始来还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻初出颍口见淮山","author":"苏辙","text":"清淮此日见沧浪，始觉南来道路长。\n窗转山光时隐见，船知水力故轩昂。\n白鱼受钓收寒玉，红稻堆场列远冈。\n波浪连天东近海，乘桴直恐渐茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻寿州城东龙潭","author":"苏辙","text":"东行取次阅三州，击鼓清晨复解舟。\n车骑纷纭追过客，歌钟凄咽动潜虬。\n宦游底处非巢燕，归计何嫌诮沐猴。\n赖有故人怜远适，慇勤屡劝酒行周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻杜介供奉送鱼","author":"苏辙","text":"天街雪霁初通驷，禁籞冰开渐跃鱼。\n十尾烦君穿细柳，一杯劝我芼青蔬。\n寒樽独酌偶逢客，佳句相酬不用书。\n江海归来叨禁近，空令同巷往来疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻连雨江涨二首 其二","author":"苏辙","text":"客到炎陬喜暂凉，江吹虚阁雨侵廊。\n回看野寺山溪隔，卧觉晨炊稻饭香。\n荔饷深红陋樱枣，桂醅淳白比琳琅。\n思移峤北应非晚，未省南迁日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻连雨江涨二首 其一","author":"苏辙","text":"南过庾岭更千山，烝润由来共一天。\n云塞虚空雨翻瓮，江侵城市屋浮船。\n东郊晚稻须重插，西舍原蚕未及眠。\n独棹扁舟趁申卯，米盐奔走笑当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻饮道者院池上","author":"苏辙","text":"雨气凉侵殿，河流渗入池。\n黄粱瀹鱼子，白酒泻鹅儿。\n风细初生袖，尘清免污眉。\n郊行不易得，拂壁看题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻夜坐","author":"苏辙","text":"月入虚窗疑欲旦，香凝幽室久犹薰。\n清风巧为吹馀瘴，疏雨时来报断云。\n南海炎凉身已惯，北方毁誉耳谁闻。\n遥知挂壁瓢无酒，归舶还将一酌分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻招王蘧朝请晚饮","author":"苏辙","text":"矫矫公孙才不贫，白驹冲雪喜新春。\n忽过银阙迷归路，误认瑶台寻故人。\n访我不嫌泥正滑，留君深愧酒非醇。\n归时九陌铺寒月，清绝空教仆御颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻祈雨","author":"苏辙","text":"世故纷纷谁复闲，蛟龙不雨独安眠。\n人间已厌三秋旱，涧底犹悭一掬泉。\n庙令酒肴时醉饱，田家糠秕久安便。\n忧心未已谁知恤，更把炉香试一燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻雨中督役夜宿水陆寺二首 其一","author":"苏辙","text":"云气连山雨泻盆，莫投僧舍欲关门。\n暂时洒扫宽行役，终夕崎岖入梦魂。\n烦热暗消秋簟冷，烝濡未解夜灯昏。\n二年游宦多劳苦，何日相从得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻雨中督役夜宿水陆寺二首 其二","author":"苏辙","text":"野寺萧条厌客喧，雨披修竹乱纷然。\n已因无食聊从仕，深悟劳生不问禅。\n未至莫忧明日事，偷闲且就此宵眠。\n天明归去芒鞋滑，虽有藤舆懒上肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻南溪微雪","author":"苏辙","text":"南溪夜雪晓来霁，有客晨游酒未消。\n风泛馀花来逐马，光浮断涧不知桥。\n山寒冻合行人息，醉熟宾欢舞意嚣。\n归骑相将踏瑶玉，嗅林闲认早梅条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻相送使胡","author":"苏辙","text":"朔雪胡沙试此身，青罗便面紫狐巾。\n拥旃代北随飞雁，顿足江东有卧麟。\n欺酒壶冰将送腊，照溪梅萼定先春。\n汉家五饵今方验，更愧当年叹息人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻闻不赴商幕三首 其三","author":"苏辙","text":"埙动篪鸣只自知，忧轻责少幸官卑。\n声名谩作耳中瑱，科第空收颔底髭。\n西鄙猖狂犹将将，中朝闲暇自师师。\n近成新论无人语，仰羡飞鸿两翅差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻闻不赴商幕三首 其二","author":"苏辙","text":"南商西洛曾虚署，长吏居民怪不来。\n妄语自知当见弃，远人未信本非才。\n厌从贫李嘲东阁，懒学谀张缓两腮。\n知有四翁遗迹在，山中岂信少人哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻闻不赴商幕三首 其一","author":"苏辙","text":"怪我辞官免入商，才疏深畏忝周行。\n学从社稷非源本，近读诗书识短长。\n东舍久居如旧宅，春蔬新种似吾乡。\n闭门已学龟头缩，避谤仍兼雉尾藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻病中游虎跑泉僧舍二首 其一","author":"苏辙","text":"扫地开门松桧香，僧家长夏亦清凉。\n公庭多事久来厌，净处安眠计甚长。\n修竹填窗藤簟绿，白莲当户石盆方。\n香厨晚饭红粳熟，忽忆烹鸡田舍尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻病中游虎跑泉僧舍二首 其二","author":"苏辙","text":"涧谷新晴草木香，野情萧散自生凉。\n雨添山色翠将溜，日转松阴晚更长。\n病客独来唯有睡，游僧相见亦它方。\n还家烦热都消尽，不信医王与药尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻寄眉守黎希声","author":"苏辙","text":"眼看狂澜倒百川，孤根漂荡水无边。\n思家松菊荒三径，回首讴歌沸二天。\n簿领沉迷催我老，春秋废格累公贤。\n邻居屈指今谁在，一念伤心十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻游富阳普照寺","author":"苏辙","text":"尘埃日已远，斗薮更无馀。\n寺到逢门入，诗成信手书。\n山深僧自乐，路远客终疏。\n访尽前朝景，它年一告予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻赋雪二首 其二","author":"苏辙","text":"点缀偏工乱鹄鸦，淹留欲解恼船车。\n乘春已觉矜馀力，骋巧时能作细花。\n僵雁堕鸱谁得罪，败墙破壁若为家。\n天公爱物遥怜汝，应是门前守夜叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻新城道中","author":"苏辙","text":"春深溪路少人行，时听田间耒耜声。\n饥就野农分饷黍，迎嫌尉卒闹金钲。\n闲花开尽香仍在，白酒沽来压未清。\n此味暂时犹觉胜，问兄何日便归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题长安王氏中隐堂五首 其一","author":"苏辙","text":"秦中胜岷蜀，故国不须归。\n甲第春风满，巴山昼梦非。\n竹深啼鸟乱，花落晚蜂飞。\n我欲西还去，敲门慎勿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题长安王氏中隐堂五首 其二","author":"苏辙","text":"唐朝卿相宅，此外更应无。\n请看庭前树，曾攀屋里姝。\n流传渐失实，遗老不禁徂。\n试问归登物，林间翠石孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题长安王氏中隐堂五首 其三","author":"苏辙","text":"爱君高堂上，有似蜀江壖。\n墙外终南近，檐西太白偏。\n晚梅晴自媚，老竹暗相迁。\n未到遥闻说，吾庐安得然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题长安王氏中隐堂五首 其四","author":"苏辙","text":"官去空留鹤，山浮不见鳌。\n竹林迎日净，槐木拥亭高。\n乌噪知人至，蝉鸣觉口劳。\n谁能饮堂上，解带不穿袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题长安王氏中隐堂五首 其五","author":"苏辙","text":"君看原上墓，坟尽但馀碑。\n谁见生前贵，尘生带下龟。\n高堂幸有酒，一饮岂论赀。\n勉强行乐耳，古人良可悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题仙游潭中兴寺","author":"苏辙","text":"潭边沙水不成泥，潭上孤禽挂崄啼。\n缭绕飞桥能试客，蒙茸翠蔓巧藏溪。\n云为绛帐马融室，石作屏风玉女闺。\n仙果知君今未足，临潭脚战怕长梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题扶风道中天花寺小亭","author":"苏辙","text":"客车来不息，辙迹知成沟。\n莫怪慵登寺，犹宜赏举头。\n独游知忆弟，望远胜登楼。\n处处题诗遍，篇篇谁为收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题泗州监仓东轩二首 其一","author":"苏辙","text":"肩舆袅袅渡浮梁，吏隐知君寄一仓。\n十里遥看飞皂盖，小轩相对有壶浆。\n清霄往往投车辖，永日霏霏散篆香。\n留滞淮南久仍乐，莫年何意复为郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻题泗州监仓东轩二首 其二","author":"苏辙","text":"万斛尘飞日为霾，无心退食自成斋。\n梅生红粟初迎腊，鱼跃银刀正出淮。\n卧病空看帆度碛，诵诗犹记雪填阶。\n夹河南北俱形胜，且借高城作两崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子瞻赠张憨子","author":"苏辙","text":"得罪南来正坐言，道人闭口意深全。\n天游本自有真乐，羿彀谁知定不贤。\n构火暾暾初吐日，飞流滚滚旋成川。\n此心此去如灰冷，肯更逢人问复然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵广州陈绎谏议和陈荐宋敏求二龙图二首 其二 和彦升赴上醴泉","author":"苏辙","text":"琳宫清净思悠哉，颇似山林未肯回。\n五日趋朝真自适，一樽无事得频开。\n董狐执笔何时易，马援征蛮未遽来。\n奔走安闲谁定是，都门携手一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵广州陈绎谏议和陈荐宋敏求二龙图二首 其一 和彦升寓定力","author":"苏辙","text":"曾送飞龙白日翔，未应中路许还乡。\n鹤归仍有当年伴，松老知经几度霜。\n城下宝坊聊寄榻，朝中振鹭旧成行。\n相逢出处何须问，五岭清平十月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵门下刘侍郎直宿寄苏左丞","author":"苏辙","text":"雷雨连年起卧龙，穆然台阁有清风。\n一时画诺虽云旧，此日都俞本自公。\n松竹经霜俱不改，盐梅共鼎固非同。\n一篇和遍东西府，六律更成十二宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵门下吕相公车驾视学","author":"苏辙","text":"未识吾君龙凤章，诸儒望幸久南庠。\n辇回原庙初移跸，鹭集西雍已著行。\n执爵稍前疑问道，献琛不日数来王。\n从官始悟熙宁意，遗我亲临见肯堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵门下吕相公同访致政冯宣猷","author":"苏辙","text":"懒从朝谒事骖騑，此去高眠罢倒衣。\n诏许敲门访耆旧，天教筑室俟来归。\n肩舆尚肯追春色，鼓缶何妨傲夕晖。\n所至成家即安隐，武昌谁乞钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵仇池冬至日见寄","author":"苏辙","text":"身如草木顺阴阳，附火重裘百日强。\n渐喜微和解凝烈，半酣起舞意仓忙。\n吾兄去我行三腊，千里今宵共一觞。\n世事只今人自解，苦寒须尽酒如汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孔武仲到官后见寄","author":"苏辙","text":"举楫同千里，系舟时一言。\n共嗟蓬作屋，愿就席为门。\n行役身先困，征商思益昏。\n仅同登垄断，何止服车辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君九日","author":"苏辙","text":"山脚侵城尽是台，登高处处喜崔嵬。\n手拈霜菊香无奈，面拂江风酒自开。\n幕府尊罍云里集，民家歌吹静中来。\n定知胜却陶彭泽，怅望篱边白日颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君上书求归未报","author":"苏辙","text":"白发忧民带减围，频闻慷慨赋将归。\n近传道士连三咽，久悟禅门第一机。\n夜永庵中诗自得，日高门外客来稀。\n此心素定谁能劝，祗有丁宁诏莫违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君见赠","author":"苏辙","text":"江国骚人不耐秋，夜吟清句晓相投。\n锋藏岂愿囊中脱，尾断终非俎上羞。\n择地何年真得意，餔糟是处可同游。\n南迁尚有公知我，人事何须更预谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君经旬不用鞭扑","author":"苏辙","text":"共喜秋深酒未醇，官曹休假不须旬。\n政宽境内棠阴合，讼去庭中草色新。\n不惜牛刀时一割，已因鼷鼠发千钧。\n岁终谁为公书考，岂止江西第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君将归","author":"苏辙","text":"疏傅思归不待时，孟轲出昼苦行迟。\n新诗尚许留章句，故事谁从问典彝。\n金马尚应堪避世，石泉未信可忘饥。\n不才似我真当去，零落衡茅隔雍岐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君留别","author":"苏辙","text":"问天乞得不訾身，屈指人间今几人。\n鱼纵江潭真窟宅，鹤飞松岭倍精神。\n清风吹雨停归骑，旧圃留花送晚春。\n自号白云知有意，便从丹灶拂埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君病中菊未开","author":"苏辙","text":"病肺秋深雾雨伤，旧缯故絮喜清凉。\n菊花金粟未曾吐，桂酒鹅儿空自黄。\n草木亦知年有闰，风霜渐近月方阳。\n得诗闻道维摩病，欲到毗耶言已忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君偶成","author":"苏辙","text":"年来衰病正相兼，薄宦奔驰尚未厌。\n诗句空多浑漫兴，俗缘已重不须添。\n聱牙向物知难合，疏懒怜公独未嫌。\n时听渊明咏归去，犹应为我故迟淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君清居探菊","author":"苏辙","text":"眼前黄叶畏秋霜，耳畔啼蛩怨夜长。\n佳节欣闻近萸菊，清商试为奏伊凉。\n疏狂久笑谋生拙，贫病应怜为口忙。\n今日共君拚一醉，从教人道亦高阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君游陈氏园","author":"苏辙","text":"增筑园亭草木新，损花风雨怨频频。\n筼筜似欲迎初暑，芍药犹堪送晚春。\n薄暮出城仍有伴，携壶藉草更无巡。\n归轩有喜知谁见，道上从横满醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君感事书怀","author":"苏辙","text":"种棠经岁便成科，秋雨调匀气渐和。\n才力有馀嫌事少，风情无限觉诗多。\n长松更老仍添节，古井虽深自不波。\n宴坐山房人岂识，一尊聊且慰蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩九日同送刘莘老","author":"苏辙","text":"头上黄花记别时，樽中渌酒慰清悲。\n画船牵挽故不发，红粉留连未遽离。\n小雨无端添别泪，遥山有意助颦眉。\n十分酒盏从教劝，堆案文书自此辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩见寄","author":"苏辙","text":"池上轻冰暖却开，迎春送腊仰衔杯。\n君家有酒能无事，客醉连宵遣不回。\n诗就滴消盘上蜡，信来飘尽岭头梅。\n商丘冷坐君知否，瓶罄应须有耻罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩见寄","author":"苏辙","text":"日永官闲自在慵，门前客到未曾通。\n怜君避世都门里，劝我忘忧酒盏中。\n城下柳阴新过雨，湖边荷叶自翻风。\n早须命驾追清赏，大字新诗事事工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩见寄","author":"苏辙","text":"触事如棋一一低，昏然一睡更何知。\n贾生流落南迁后，陶令衰迟归去时。\n去住由人真水母，箪瓢粗足亦山雌。\n年来未省谈尧舜，一吷粗疏岂足吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩代书","author":"苏辙","text":"去年河上送君时，我醉看君倒接篱。\n一笑便成经岁隔，扁舟重到满城知。\n旧传北海偏怜客，新怪东方苦诉饥。\n应笑长安居不易，空吟原上草离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩同饮王廷老度支家戏咏","author":"苏辙","text":"白鱼紫蟹早霜前，有酒何须问圣贤。\n上客远来工缓颊，双鬟为出小垂肩。\n新传大曲皆精绝，忽发狂言亦可怜。\n莫怪贫家少还往，自须先办买花钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩廷评招饮","author":"苏辙","text":"病忆故乡同越舄，性安田野似裨谌。\n都城岁晚不归去，客舍夜寒犹独吟。\n樽酒怜君偏好客，诗篇寄我谬知音。\n会须雪里相从饮，履迹旋平无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪诗八首 其八","author":"苏轼","text":"万石千钧积累成，未应忽此一毫轻。\n寒松瘦竹元清劲，昨夜分明闻折声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩怀刘莘老","author":"苏辙","text":"两都来往太频频，真是人间自在人。\n十载读书同白屋，千金为客买朱唇。\n结交京邑倾心肺，寓思禅宗离垢尘。\n为问西归天禄客，何时同看洛川神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王巩留别","author":"苏辙","text":"决策归田岂世情，网罗从此脱馀生。\n请君速治鸡黍具，待我同为沮溺耕。\n秋社相从醵钱饮，日高时作叩门声。\n茅庐但恐非君处，籍籍朝中望已倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]