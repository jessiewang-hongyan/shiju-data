[{"title":"次韵叔父咏竹二首 其一","author":"苏过","text":"江湖犹在眼，水竹角幽寻。\n故买比邻宅，期分数亩阴。\n影侵书帙乱，色映绿苔侵。\n肃杀秋将至，霜馀出茂林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父咏竹二首 其二","author":"苏过","text":"此君非草木，劲节凛佳宾。\n相对山阴禊，曾陪南阮贫。\n琳琅风叶响，水墨月窗匀。\n何必篮舆出，敲门问主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己卯冬至儋人隽具见饮既罢有怀惠许兄弟","author":"苏过","text":"寂寞三冬至，飘然瘴海中。\n不嫌羁寓远，屡感岁华穷。\n父老怜匏系，肴蔬盛簋饛。\n一欢为子寿，百福与君同。\n已惯鸢飞堕，真忘马首东。\n南间行自变，重译不须通。\n椰酒醍醐白，银皮琥珀红。\n伧狞醉野獠，绝倒共邻翁。\n藷芋人人送，囷庖日日丰。\n瘴收黎母谷，露入菊花丛。\n海蜑羞蚶蛤，园奴馈韭菘。\n槟榔代茗饮，吉内禦霜风。\n怅望怀诸阮，遥知忆小冯。\n客身虽岭峤，逸想在瀛蓬。\n介阶惟偕母，庞团独侍公。\n故山千万里，此意托飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋思","author":"苏过","text":"秋入郊墟早，霜高宇宙宽。\n头风思檄手，髀肉怯征鞍。\n俯伛非吾事，歌呼强觅欢。\n自知毛羽短，松桂不禁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杨良卿秋雨有感二首 其一","author":"苏过","text":"一饱真难得，凶丰特未分。\n连绵窗外滴，惆怅陇头耘。\n雀啅饥谋食，蛙鸣夜作群。\n谁能补天漏，我欲跨重云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杨良卿秋雨有感二首 其二","author":"苏过","text":"电驱瓴建屋，溪涨浪翻查。\n身作三年客，愁随万点鸦。\n家书空系雁，灯信未占花。\n梦里寻归计，柴桑似有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王谨常再和前诗复次其韵 其一","author":"苏过","text":"旅枕何曾睡，恓恓到夜分。\n崎岖世路走，辛苦夏畦耘。\n老弃林泉乐，来居戎马群。\n登高一悲咤，杳杳是燕云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王谨常再和前诗复次其韵 其二","author":"苏过","text":"王子可人处，壁间留短槎。\n自虽疑刻鹄，初不得黔鸦。\n世味真嚼蜡，尘心不染花。\n相逢定相契，一笑共生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙志康书事","author":"苏过","text":"午枕睡方浓，雷车殷地雄。\n弹丸屋瓦坠，云散马牛风。\n神物聊相戏，惊心未解空。\n似催诗句急，添得锦囊丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵朝议追咏其亡友园亭三首 其一","author":"苏过","text":"宿草论交旧，佳亭榜字新。\n平畴烟漠漠，野水碧粼粼。\n挂剑嗟吾晚，悬车叹汝伸。\n西州不忍过，朱户锁埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵朝议追咏其亡友园亭三首 其二","author":"苏过","text":"轩冕真馀事，林泉独我亲。\n扬雄虽有宅，王翰孰为邻。\n披句空遗恨，沾衣想自频。\n睹公怜友作，拟德定其伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵朝议追咏其亡友园亭三首 其三","author":"苏过","text":"引退元非病，归田却患贫。\n躬耕聊自给，知命敢言屯。\n好客还师郑，多金不羡秦。\n犹能化邻里，殆类葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游英州碧落洞","author":"苏过","text":"千尺琅玕翠入动，神仙已去洞仍存。\n寒崖但见悬钟乳，流水无穷泻石门。\n未到朱明真洞府，先看峡口小昆崙。\n舍舟欲问桃源路，安得渔人与共论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送昙秀","author":"苏过","text":"三年避地少经过，十日论诗喜琢磨。\n自欲灰心老南岳，犹能茧足慰东坡。\n来时野寺无鱼鼓，去后闲门有雀罗。\n从此期师真似月，断云时复挂星河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东亭","author":"苏过","text":"闭眼黄庭万想归，此心久已息纷驰。\n幽居正喜门罗雀，晨起何妨笏拄颐。\n自信丹田足梨枣，不忧瘴雨滞茅茨。\n三山咫尺承明远，世路榛芜谁与披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"椰子冠","author":"苏过","text":"玉佩犀簪暗网丝，黄冠今习野人仪。\n著书岂独穷周叟，说偈还应见祖师。\n棕子偶从遗物得，竹皮同使后人知。\n平生冠冕非吾意，不为飞鸢跕堕时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其一","author":"苏过","text":"七年野鹤困鸡群，匪虎真同子在陈。\n四海澄清待今日，五朝光辅属何人。\n从来令尹元无愠，岂独原生不病贫。\n天欲斯民跻仁寿，卧龙宁许久谋身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其二","author":"苏过","text":"未试陵云白日仙，此声固已速邮传。\n阴功何止千人活，法眼要求一大缘。\n枕上轩裳真昨梦，腹中梨枣是归田。\n他时汉殿观遗鼎，犹记曾陈柏寝年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其三","author":"苏过","text":"昔将直道破群纤，出走宁逃此日谗。\n塞马未还非叟病，莫邪偶弃岂铅铦。\n长生有道因辞宠，造物无私独与谦。\n从此轩裳真敝屣，世间出世固难兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其四","author":"苏过","text":"一封已责被敷天，十万饥民粥与饘。\n不待丹砂锡难老，自凭阴德享长年。\n寿绦固已占黄发，珠火还应养寸田。\n况是玉皇香案吏，御风骑气本泠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其五","author":"苏过","text":"勿惊髀减带围带，寿骨巉然正隐颧。\n不待期颐祝难老，固知穮蓘自丰年。\n僵松再蔚千龄叶，眢井新飞百尺泉。\n坐想山神无伎俩，却应造物报其天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其六","author":"苏过","text":"畴昔东华典秘藏，于今晻暧水云乡。\n欲知万里雷霆谴，要与三山咫尺望。\n世上功名那复记，洞中仙籍已难量。\n仇池何用追仙驭，香案仍归侍玉皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大人生日 其七","author":"苏过","text":"穷寓三年瘴海宾，箪瓢陋巷与谁邻。\n维摩示疾原非疾，原宪虽贫岂是贫。\n纺妪固尝占异梦，肉芝还已献畸人。\n世间出世何由并，一笑荣枯等幻尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父小雪二首 其一","author":"苏过","text":"屏帷夜久灰残兽，纸帐寒惊月在窗。\n似听竹声知有雪，便添酒兴欲倾缸。\n西邻正想蒲团稳，古殿遥瞻老柏双。\n自笑穷愁拙生理，不谋升斗待西江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父小雪二首 其二","author":"苏过","text":"夜来小雪犹凝地，睡起扶桑已著窗。\n却喜少陵时炙背，不忧北海屡空缸。\n丰年何时豚蹄祝，薄淖聊烦蜡屐双。\n试走湖边望嵩少，殆如叠嶂在烟江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父上巳二首 其一","author":"苏过","text":"日晏幽人未下床，春风暗度百花香。\n掩关颇得禅家味，却扫从教世路荒。\n绝口谁能论梦幻，逢人聊祇话耕桑。\n翟公门外常罗雀，要放空阶草木长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父上巳二首 其二","author":"苏过","text":"几年零落卧江湖，乐事何人与我俱。\n上巳偶寻流水禊，泛觞聊为小儿娱。\n残杯冷炙惭佳节，草服黄冠慕野夫。\n永谢轻肥追世好，窥园已愧下帷儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父黄门己丑岁除二首 其一","author":"苏过","text":"坐阅星周几变迁，恒河见性但依然。\n求田问舍追三径，面壁灰心过九年。\n早退得闲真玩岁，跏趺数息是安眠。\n从今甲子当须记，异日应无史赵贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叔父黄门己丑岁除二首 其二","author":"苏过","text":"卒岁优哉乐事全，家庭瑞气郁葱然。\n椒花颂酒祈新福，腊雪飞空作有年。\n塞马未归人勿叹，黄粱已熟客犹眠。\n颍滨遗老非虚语，万古巢由不独贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叔父生日 其一","author":"苏过","text":"重耳飘流十九年，我公涉世屡艰难。\n笑看礼至争铭鼎，便学陶宏欲挂冠。\n枕上轩裳何足梦，壶中天地本来宽。\n幅巾从此追巢许，永愧苍生起谢安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叔父生日 其二","author":"苏过","text":"山泽癯仙事渺茫，武陵之说亦荒唐。\n老聃及见东周晚，季子几同鲁史长。\n直以至仁符静寿，固非吉卜予康强。\n汉庭已致商颜叟，宁似初平老牧羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叔父生日 其三","author":"苏过","text":"平生种德在斯民，物理循环付大钧。\n今日里闾惊万石，异时廊庙活千人。\n退藏欲遂箕山志，谈笑归来颍水滨。\n漫效儿童祝难老，楚南灵木不知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叔父生日 其四","author":"苏过","text":"图形未肯上凌烟，欲了人间一大缘。\n心法已传黄檗要，形神自契赤松仙。\n尔来卜筑安悬罄，空使苍生望济川。\n不用丹砂留齿发，见恒河性本依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与王子敏相别十年今在汝见招以书往从之闻其斋素卧病以诗劝之肉食","author":"苏过","text":"已矣君休问十年，相逢定怪两华颠。\n长卿犹作文园令，苏晋长斋绣佛前。\n隐几不堪居士病，在家空学小乘禅。\n隙驹安用徒劳苦，为我西来数击鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵承之寄保德倅王粹公","author":"苏过","text":"王谢风浪不愧前，碧梧翠竹总森然。\n好归禁琐持簪橐，却卧关河阅岁年。\n目送秋鸿凌绝漠，坐传烽火到甘泉。\n笑君坐啸空斋冷，庭下蒲鞭无可鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叶守端阳日湖上宴集","author":"苏过","text":"谬玷英髦齿故乡，西溪云日晓苍凉。\n樽倾北海佳辰至，乐入熏风昼漏长。\n未放巾车陶令去，且容拓戟少陵狂。\n他时傥与安昌客，还许门生到后堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从范信中觅竹","author":"苏过","text":"将军懒著鵔鸃冠，买得林丘小洞天。\n十亩琅玕寒照座，一溪罗带恰通船。\n行当雪夜寻安道，先欲松风借玉川。\n雨洗娟娟君会否，乞分半亩慰垂涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信中见和复以前韵答之","author":"苏过","text":"年来短发不胜冠，终老茅茨敢怨天。\n小筑强追三径乐，远游未遂五湖船。\n竹林诗友欣同社，花坞春风共一川。\n待我西窗荫寒碧，妙香与子试龙涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩华国相约游嵩少","author":"苏过","text":"耕粮已办登山计，积淖车轮四角生。\n勇健无人先接淅，滞留愧我说重盟。\n风回远壑云归岫，雨洗苍苔屐有声。\n刻石题名须绝巘，蓬莱顶上记曾行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后旬日雨止遂行至大成冈初见嵩少","author":"苏过","text":"青山真似有情人，百里相迎列万屯。\n积翠已堪供爽气，群趋如欲避雄尊。\n少宽眼界尘埃外，却视醯鸡井陌喧。\n方信胸中有馀地，青丘云梦不劳吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李方叔挽词二首 其一","author":"苏过","text":"广文流落坐才名，世为长沙惜贾生。\n明主爱才非忍弃，大钧播物岂能争。\n空嗟抱艺频三黜，不待惊人试一鸣。\n赖有遗编照千古，贤于万户写铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李方叔挽词二首 其二","author":"苏过","text":"豪气峥嵘老不除，求田未分赋归欤。\n功名日暮空弹铗，须发霜彫为著书。\n想像柴门延履舄，凄凉滍水但丘墟。\n从今忍过西州路，暮树悲风拥素车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘晦叔挽词二首 其一","author":"苏过","text":"早岁声名耸搢绅，晚途端合付经纶。\n绣衣曾是先朝旧，郎省空惊白发新。\n不羡得车誇贵仕，但令遗爱在斯民。\n德星临处阴功满，高大门闾畀后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘晦叔挽词二首 其二","author":"苏过","text":"泗滨初获拜荆州，颍水欣从杖屦游。\n华发归来慰平昔，邦人共喜见风流。\n里门尚想诸郎下，薤露俄惊素旐秋。\n清德传家无所遗，鹿门真为子孙谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樗隐堂","author":"苏过","text":"果为才名困广文，天涯从仕老仍贫。\n一廛未有归耘处，五斗聊为束带人。\n众弃已甘栖广莫，先容那复慕轮囷。\n幅巾他日衡茅去，纨裤儒冠总误身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁无斁与叶少蕴重开西湖唱酬之诗 其一","author":"苏过","text":"凿开北渚涨痕收，倚杖波吞立鹭洲。\n稍觉蒹葭相与永，直疑汴泗看交流。\n寿公且吸杯中月，清夜频移鉴里舟。\n虽走蓬莱通帝籍，邦人且欲寇公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁无斁与叶少蕴重开西湖唱酬之诗 其二","author":"苏过","text":"危构飞空旧奂轮，澄光爽气压城闉。\n下临曲水山阴禊，不障西风庾亮尘。\n谩拟江南入图画，只凭诗匠扫芜堙。\n少陵有句真堪咏，翠竹江村月色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晁无斁与叶少蕴重开西湖唱酬之诗 其三","author":"苏过","text":"自分锄耰毕此生，不须穷达问君平。\n黄粱正与梦俱熟，环堵典无爨欲清。\n晚客强陪金谷侣，小诗聊学候虫鸣。\n空怀老骥心千里，憔悴穷途敢请缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵姚美叔约寻春之什","author":"苏过","text":"厌看尘土暗春晴，喜见池塘翠浪生。\n曲水会当追逸少，斜川终拟学渊明。\n歌呼且尽杯中物，寂寞何忧身后名。\n况有岑参好奇怪，为君试草渼陂行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次信中韵","author":"苏过","text":"万古溪流去不回，舂撞涧谷石门开。\n寻源不必武陵客，过眼惊看滟滪堆。\n寒碧照人无底宝，铿轰殷地半空雷。\n结茅安得从僧住，自把锄耰辟草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张子先喜雪","author":"苏过","text":"信道东君有化工，剪裁花雨落春风。\n忽惊区脱无馀地，变作瑶池第一宫。\n南亩麦秋先作瑞，西山玉粒未教融。\n旅人共助田夫喜，一饱遥知饼饵丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和清源陈观性喜雪","author":"苏过","text":"斗酒豚蹄语未终，飞花弄态作冲融。\n寒威尚带嘉平腊，和气争先养物风。\n爽入西山千仞色，润添南亩一犁工。\n先生休道催科拙，趁著河东岁屡丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归途次吕居二韵","author":"苏过","text":"胜游喜今六人闲，说有谈空许肆言。\n欲学颦眉追世好，自知捩手触羹翻。\n雄夸颇快平生愿，笑语欣陪十日温。\n却返邯郸寻故步，儿童童态觉卑喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诏中山帅登城口号","author":"苏过","text":"西风卷雨出群山，晓色朦胧未散烟。\n雉堞横空云半隐，旌旂改色日争鲜。\n承平不在山河险，卧护何须铁石坚。\n卖剑决牛从此始，陪公千骑看秋田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵答陈帅和诗","author":"苏过","text":"电扫天骄到海边，长城千里静无烟。\n虚弦固自落惊羽，大手何劳试小鲜。\n收拾风浪开幕府，从容谈笑卧中坚。\n愿观横槊诗千首，锋镝消磨变力田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和新葺南园","author":"苏过","text":"道眼年来等色空，块苏不羡化人宫。\n敢嫌仲蔚蓬蒿陋，久悟邯郸梦幻中。\n瓮牖绳枢知达观，兔葵燕麦任春风。\n箕山咫尺行当隐，巢许高踪蹑二公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵程秀才求作其先人埋铭","author":"苏过","text":"欲载扬雄老一区，清名不耀力难摹。\n但知穮蓘勤吾事，要以凶丰畀后图。\n有子人人壮门户，新诗句句琢珉瑜。\n夜光明月毋轻付，误认空空叩鄙夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家书事","author":"苏过","text":"路入铜鞮草木幽，不堪陇水断肠流。\n稍逢烟火人家住，似有桑麻场圃秋。\n生理艰难何所乐，石田辛苦若为收。\n天公长与丰年好，安得仁人每问牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨良卿","author":"苏过","text":"客愁何处不相寻，节物年年又见侵。\n不为黄花思故国，羞堪白发负初心。\n临风有句空悲咤，独酌无人诉浅深。\n却羡杨卿横槊后，从嘲落帽吐衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯充兄唱酬二首一赠伯充一寄高仲贻 其一","author":"苏过","text":"倦客难堪走世尘，空嗟林下见何人。\n坐令岁月徂清夜，梦想田园趁食新。\n老境已侵无几发，垂堂共爱不赀身。\n一官聊为家山往，要看明年濯锦春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯充兄唱酬二首一赠伯充一寄高仲贻 其二","author":"苏过","text":"家风凛凛嗣前尘，元祐庵中老道人。\n形似子綦独枯槁，诗如开府日清新。\n功名轩冕真馀事，富贵籧篨误此身。\n不有胸中陂万顷，肯教白发负青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李稙秀才归盱眙","author":"苏过","text":"浊流尽处见淮山，水作清罗拥髻鬟。\n顿觉山川无与并，固知人物亦相关。\n妙年肯作小坡客，瓢饮来同陋巷颜。\n不为莼鲈起乡思，重亲方在白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中游柳溪呈志康诸公","author":"苏过","text":"脱我芒鞋与杖藜，强随车盖著荷衣。\n青山绿水苦相唤，细雨斜风不忍归。\n幸有琉璃倾琥珀，何妨粉黛湿珠玑。\n潇湘起我江湖兴，只恐扁舟明日非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]