[{"title":"眼儿媚 其三","author":"无名氏","text":"平生几度怨长亭。\n不似这番深。\n霜收水瘦，风流帆饱，怎忍轻分。\n栏干倚遍慵归去，独自个黄昏。\n荷横钗股，柳垂裙带，总是销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"无名氏","text":"杨柳丝丝弄轻柔。\n烟缕织成愁。\n海棠未雨，梨花先雪，一半春休。\n而今往事难重省，归梦绕秦楼。\n相思只在，丁香枝上，豆蔻梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"无名氏","text":"萧萧江上荻花秋，做弄许多愁。\n半竿落日，两行新雁，一叶扁舟。\n惜分长怕君先去，直待醉时休。\n今宵眼底，明朝心上，后日眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 其一","author":"无名氏","text":"惨云愁雾罩江天。\n呵手卷帘看。\n蒙茸柳絮，万千蝴蝶，飞过危栏。\n后庭一树瑶华缀，零乱暗香残。\n今番桂影，也应寒重，不放新弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绮罗香","author":"无名氏","text":"酒醒后、一枕清风，梦断处、半窗残月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿头鸭/多丽","author":"无名氏","text":"敛同云。\n破腊雪霁前村。\n占阳和、孤根先暖，数枝已报新春。\n如青女、谩同素质，笑姑射、难并天真。\n疏影横斜，澄波清浅，暗香浮动月黄昏。\n山驿畔，行人立马，回首几销魂。\n江南远，陇使趁程，踏尽冰痕。\n有个人人，玉肌偏似，移我常对金尊。\n捻纤枝、鬓边斜戴，嗅芳蕊、眉晕潜分。\n素脸笼霞，香心喷日，寿阳妆罢酒初醒。\n待调鼎、须贪结子，忍见落纷纷。\n霜天晓，愁闻画角，声断谯门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"无名氏","text":"天威乱糁琼蕤密。\n一光吞尽千山碧。\n梅与雪争妍。\n孤香风暗传。\n玉骨从来瘦。\n不奈春僝僽。\n羌管一声残。\n水乡生暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 寿女人五月十五","author":"无名氏","text":"宫样迎春髻。\n玉步金莲细。\n初度是今朝。\n嫦娥降九霄。\n兰玉行荣贵。\n德备共姜义。\n夏半月团圆。\n称觞祝寿筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"无名氏","text":"金风簌簌惊黄叶。\n高楼影转银蟾匝。\n梦断绣帘垂。\n月明乌鹊飞。\n新愁知几许。\n欲似丝千缕。\n雁已不堪闻。\n砧声何处村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"无名氏","text":"黄昏月暗清溪色。\n帘垂小阁霜华白。\n一夜玉玲珑。\n横斜水月中。\n小行孤影动。\n生怕惊花梦。\n半夜得春归。\n屏山人未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 题刀镊行族","author":"无名氏","text":"宝刀迎面摇寒雪。\n琼梳掠鬓横新月。\n红颊驻长春。\n绿鬟轻绾云。\n解飘并括敛。\n到处题名遍。\n飞诏待追还。\n荣居供奉班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"无名氏","text":"衔泥双燕来还去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"无名氏","text":"霜天不管青山瘦。\n轻云浅拂修眉皱。\n烟树隔潇湘。\n隔帆吹异香。\n影残春恨小。\n淡墨敧斜倒。\n无处著消愁。\n笛寒人倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 讽词","author":"无名氏","text":"昔年曾伴花前醉。\n今年空洒花前泪。\n花有再荣时。\n人无重见期。\n故人情义重。\n不忍营新宠。\n日月有盈亏。\n妾心无改移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 寿侄十一月廿六","author":"无名氏","text":"蓂留四叶书云后。\n此日孙枝秀。\n爱他风味似吾人。\n却是笔头能篆、又能文。\n青青两鬓年方壮。\n儿女俱成长。\n要添富寿共荣华。\n教取一庭兰玉，共成家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 夫寿妻","author":"无名氏","text":"秋风扫尽闲花草。\n黄花不逐秋光老。\n试与插钗头。\n钗头占断秋。\n簪花人有意。\n共祝年年醉。\n不用泛瑶觞。\n花先著酒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 寿李侍郎","author":"无名氏","text":"春不老。\n细数花风犹到。\n挥翰玉堂应早早。\n花知中令考。\n词进芳笺才调。\n文饮清樽怀抱。\n一片潇湘供一笑。\n楚山青未了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"无名氏","text":"满地落红千片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"无名氏","text":"休只坐。\n也去看花则个。\n明日满庭红欲堕。\n花还愁似我。\n索性痴眠一和。\n凭个梦儿好做。\n杜宇不知春已过。\n枝头声越大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 赠歌妓","author":"无名氏","text":"真个美。\n水墨观音难比。\n闻道观音谁不害。\n见来须顶礼。\n徐步金莲满地。\n那更兰心聪慧。\n一曲清歌离皓齿。\n梁尘飞不已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 寿士人五月廿五","author":"无名氏","text":"文章士。\n秀气岳神钟聚。\n看雕鹏、秋风高举。\n上青天平步。\n五五日临夏五。\n堂上称觞笑语。\n桂子兰孙齐彩舞。\n祝寿同彭祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"无名氏","text":"江上路。\n依约数家烟树。\n一枕归心村店暮。\n更乱山深处。\n梦过江南芳草渡。\n晓色又催人去。\n愁似游丝千万缕。\n倩东风约住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄莺儿","author":"无名氏","text":"香梢匀蕊先回暖，点点胭脂轻衬。\n红苞隐映疏篁，红翠相间。\n方瑞雪乍晴时，爱日初添线。\n五云楼上遥看，似睹溪边，仙子妆面。\n堪羡。\n影转玉枝斜，艳拂朝霞浅。\n就中妖娆，独得芬芳，偏教容易琼苑。\n闻又报一阳时，不似莺声唤。\n肯与梅脸争春，靓笑群芳晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜团圆","author":"无名氏","text":"轻攒碎玉，玲珑竹外，脱去繁花。\n尤殢东君，最先点破，压倒群花。\n瘦影生香，黄昏月馆，清浅溪沙。\n仙标淡伫，偏宜么凤，肯带栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺","author":"无名氏","text":"芳春天晓。\n听绿树、数声如簧莺巧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 其一","author":"无名氏","text":"南枝向暖。\n乍秀出庾岭，梅英初吐。\n玉颊轻匀，琼腮微抹，姑射冰容相许。\n几回立马凝伫，影映寒光霜妒。\n□尽占，在百花头上，严冬独步。\n芳华春意早，昨夜一番，雪里开无数。\n万蕊千梢，铅堆粉污，总是化工偏赋。\n月明暗香浮动，休使龙吟声苦。\n且留取。\n待时时，频倚阑干重顾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 其二","author":"无名氏","text":"腊残春未。\n正候馆梅开，墙阴雪里。\n冷艳凝寒，孤根回暖，昨夜一枝春至。\n素苞暗香浮动，别有风流标致。\n谢池月，最相宜，疏影横斜临水。\n谁为。\n传驿骑。\n陇上故人，不见今千里。\n寄与东君，徒教知人，别后岁寒清意。\n乱山万叠何在，但有飞云天际。\n故园好，早归来，休恋繁桃秾李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 其三","author":"无名氏","text":"霜凝雪冱，正斗标临丑，三阳将近。\n万木凋零，群芳消歇，禁苑有梅初盛。\n异香似薰沈水，素色端如玉莹。\n人尽道，第一番，天遣先占春信。\n标韵。\n尤耿耿。\n月观水亭，谁解怜疏影。\n何逊扬州，拾遗东阁，一见便生清兴。\n望林止渴功就，不数夭桃繁杏。\n岁寒意，看结成秀子，归调商鼎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺","author":"无名氏","text":"早梅天气，正绣户乍启，琼筵才展。\n鹊渡河桥，云游巫峡，溪泛碧桃花片。\n翠娥侍女来报，莲步已离仙苑。\n待残漏，鸳帐深处，同心双绾。\n欢宴。\n当此际，红烛影中，檀麝飘香篆。\n掷果风流，谪仙才调，佳婿想应堪羡。\n少年俊雅狂荡，蓦有人言拘管。\n镇携手，向花前月下，重门深院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 其四","author":"无名氏","text":"一阳初起。\n渐庾岭梅雪，才苞香蕊。\n品格清高，姿容闲雅，别受化工深意。\n放开独占严景，不使混同凡卉。\n微雨霁。\n似玉容寂寞，无言有泪。\n难比。\n凝素态，不共艳阳，桃杏争妍丽。\n疑是佳人，巧捻香酥，枝上玉纤轻缀。\n前村可惜无赏，好近天庭阶砌。\n成实后，有调和鼎鼐，一般滋味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 贺生双子","author":"无名氏","text":"物中双美。\n惟邺县双凫，禹门双鲤。\n太华双莲，蓝田双璧，剑丰城而已。\n争是一门双秀，又是一朝双喜。\n人总道，机云双陆，同年弧矢。\n希耳。\n会见这，双桂连芳，双鹄冲霄举，鱼诏双金，带横双玉，惟道无双国士。\n但愿双英双戏彩，且直与、双亲儿齿。\n愿岁岁，见东风双燕，满城桃李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜迁莺 庆陈丞在任五月三十","author":"无名氏","text":"生贤时协。\n正炎官直午，日周三浃。\n门左垂弧，眉间喜色，尽道降神嵩岳。\n百里葱葱和气，总向蓝田会合。\n称庆旦，见吏民鼓舞，欢声和洽。\n玉叶。\n斟劝处，一饮流霞，红艳生双颊。\n钜竹槐松吟哦乐，指日荣膺异渥。\n皇上渴思经济，环召为霖作楫。\n快人望，愿长生，须与绛人同甲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御阶行/御街行","author":"无名氏","text":"平生有个风流愿。\n愿长与梅为伴。\n问伊因甚破寒来，只恐百花先绽。\n比兰比麝，比酥比玉，休恁闲撩乱。\n瑶台月下分明见。\n依旧残妆浅。\n不知分得几多香，一片清如一片。\n直须遮断，恐人眼毒，不解轻轻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御街行","author":"无名氏","text":"时康三载升平世。\n恭谢三朝礼。\n群臣禁卫带花回，龊巷儿郎精锐。\n战袍新样团雕拥，重隘围子队。\n绣衣花帽挨排砌。\n锦仗天街里。\n有如仙队玉京来，妙乐钧天盈耳。\n都民观望时，果是消灾灭罪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御街行","author":"无名氏","text":"霜风渐紧寒侵被。\n听孤雁、声嘹唳。\n一声声送一声悲，云淡碧天如水。\n披衣起。\n告雁儿略住，听我些儿事。\n塔儿南畔城儿里。\n第三个、桥儿外。\n濒河西岸小红楼，门外梧桐雕砌。\n请教且与，低声飞过，那里有、人人无寐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御街行","author":"无名氏","text":"夜深无语楼空倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼 寿人七十三","author":"无名氏","text":"蟾宫客、未老得清闲。\n寿算过稀年。\n利名缰锁非关我，浮云富贵付苍天。\n且归休，对松菊，乐林泉。\n比吕望、数犹欠七。\n问师旷、恰符绛一。\n从今遐算更绵延。\n称觞欣近小春候，月当明夜又团圆。\n愿长如，天上月，地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼","author":"刘克庄","text":"司春有序，排次到荼蘼。\n远预报，在庭知。\n蕊珠宫里晨妆罢，披香殿下晓班齐。\n探花正、驱使问，菊花期。\n元不逊、梅花浮月影，也知妒、梨花带雨枝。\n偏恨柳、绿条垂。\n与其向晚包团絮，不如对酒折芳蕤。\n谢东君，收拾在，牡丹时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼 寿翁簿二月初十","author":"无名氏","text":"中和节过，捻指又经旬。\n逢盛旦，诞生申。\n当年昴宿呈佳瑞，今朝南极见箕星。\n寿而昌，年未老，绿袍新。\n宝鸭沉烟堂上袅，珠翠捧、椒觞满斟。\n来庆贺，尽佳宾。\n彩戏斑斓多桂子，更看兰玉列阶庭。\n桓庄椿，祝遐算，八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼","author":"无名氏","text":"却教人，逢春怕，见花羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼","author":"无名氏","text":"南陌踏青游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼 其一","author":"无名氏","text":"梅花好，千万君须爱。\n比杏兼桃犹百倍。\n分明学得嫦娥样，不施朱粉天然态。\n蟾宫里，银河畔，风霜耐。\n岭上故人千里外。\n寄去一枝君要会。\n表江南信相思㬠。\n清香素艳应难对。\n满头宜向尊前戴。\n岁寒心，春消息，年年在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其四 咏九月桃呈□晋侯","author":"无名氏","text":"从来黄菊占秋风。\n红只许芙蓉。\n正是百花浓睡，如何唤起春工。\n小桃破萼，胭脂淡伫，妆粉轻笼。\n为报多情刘阮，武陵消息先通。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 寿太守五月廿八","author":"无名氏","text":"天休令节庆生申。\n喜动满城民。\n十万儿童踊跃，祝公寿等庄椿。\n人生最贵，荣登五马，千里蒙恩。\n只恐促归廊庙，去思有脚阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 贺周姓娶祝氏","author":"无名氏","text":"几年弱水望蓬莱。\n心事喜同谐。\n佳婿欣逢公瑾，新婚喜近英台。\n豪家深意，芙蓉褥隐，金雀屏开。\n但愿门阑多喜，凤楼早寄书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措","author":"无名氏","text":"山城水隘小桥傍。\n竹里早梅芳。\n纵有丹青图画，难描幽韵清香。\n妖娆天赋，偏宜素淡，杨氏宫妆。\n雅态何须艳丽，孤标不在春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其五","author":"无名氏","text":"宦游只欲赋归休。\n花为解离愁。\n看取星星潘鬓，花应羞上人头。\n武陵流水，桃源路远，空误渔舟。\n把住春光一醉，从教风叶悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措","author":"无名氏","text":"征雁不来无信，教人空度重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一 咏秋日牡丹赠严尹父","author":"无名氏","text":"严霜封草树凋红。\n叶落小园空。\n何事洛阳花面，却来冠冕秋风。\n尊前羞损，篱边野菊，池上芙蓉。\n莫放花归昆阆，且留客醉金钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 会郡西齐，欢甚，以词示，调朝中措","author":"无名氏","text":"与君同是饱齑盐。\n先达后何淹。\n任玉东西醉倒，明朝病酒厌厌。\n后年三月，凤池春满，雁塔名添。\n记取西风桂影，一枝先上银蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 寿魏都大","author":"无名氏","text":"郎星初度一旬前。\n瑞雪早蹁跹。\n金节耆祥称寿，一妃宣劝迎年。\n锦天绣地，薰香手祷，福禄如川。\n只恐催呈魏笏，便还紫橐青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其二","author":"无名氏","text":"红鸾飞下绿云中。\n天淡日和融。\n回首小园桃杏，怜伊独困霜风。\n妖姿丽质，天然富贵，不假铅红。\n梦作一双蝴蝶，翻翻绕遍芳丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其三","author":"无名氏","text":"洛阳常见画图中。\n春去只心融。\n国色辉开寒日，天香熏破霜风。\n平生看了，姚黄魏紫，一捻深红。\n莫是神仙韩令，裁成顷刻花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游月宫令","author":"无名氏","text":"当今圣主座龙楼，圣寿应天长，实钱喷香烟，玄宗游月宫。\n海晏河清，盛朝侍，群臣喜呼万岁，万人民，开乐业，愿吾皇、增福寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘灵瑟","author":"无名氏","text":"霜风摧兰。\n银屏生晓寒。\n淡扫眉山。\n脸红殷。\n潇湘浦，芙蓉湾。\n相思数声哀叹。\n画楼尊酒闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罥马索","author":"无名氏","text":"晓窗明，庭外寒梅向残月。\n吴溪庾岭，一枝偷把阳和泄。\n冰姿素艳，自然天赋，品格真香殊常别。\n奈北人、不识南枝，唤作腊前杏先发。\n奇绝。\n照溪临水，素禽飞下，玉羽琼芳斗清洁。\n懊恨春来何晚，伤心邻妇争先折。\n多情立马，待得黄昏，疏影斜斜微酸结。\n恨马融、一声羌笛起处，纷纷落如雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅风/落梅","author":"无名氏","text":"宫烟如水湿芳晨。\n寒梅似雪相亲。\n玉楼侧畔数枝春。\n惹香尘。\n寿阳娇面偏怜惜，妆成一面花新。\n镜中重把玉纤匀。\n酒初醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落梅慢/落梅","author":"无名氏","text":"带烟和雪，繁枝澹伫，谁将粉融酥滴。\n疏枝冷蕊压群芳，年年常占春色。\n江路溪桥谩到，袅袅风中无力。\n暗香浮动冰姿，明月里，想无花比高格。\n争奈光阴瞬息。\n动幽怨、潜生羌笛。\n新花斗巧，有天然闲态，倚阑堪惜。\n零乱残英片片，飞上舞筵歌席。\n断肠忍泪念前期，经岁还有芳容隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遍地花 妓行七小石调","author":"无名氏","text":"元是竹林旧伴侣。\n去人日、偶相遇。\n笑卢仝、狂怪尝茶，问子建、诗成几步。\n忆去年、乞巧同欢，把琴弦、细细与说。\n伤你爱四勾三，生下五男二女。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"愁倚栏/春光好","author":"无名氏","text":"冰肌玉骨精神。\n不风尘。\n昨夜窗前都折尽，忽疑君。\n清泪拂拂沾巾。\n谁相念、折赠芳春。\n羌管休吹别塞曲，有人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 寿翰林十月十四","author":"无名氏","text":"明夜月团圆，小春霜早。\n今日由来佳气好。\n都城传道，翰苑称觞欢笑。\n知是当年，诞生元老。\n新来曾见，金莲送到。\n一任芳樽频醉倒。\n判花西掖，独掞春华词藻。\n召归紫闼，永为师保。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩","author":"无名氏","text":"暖律破寒威，春回宫柳。\n晴景初曦上元候。\n禁城烟火，移下一天星斗。\n素娥凝碧汉，明如昼。\n绣毂电转，锦鞯飞骤。\n九踏笙歌按新奏。\n胜游方凝，忽听晓钟银漏。\n两两归去也，应回首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]