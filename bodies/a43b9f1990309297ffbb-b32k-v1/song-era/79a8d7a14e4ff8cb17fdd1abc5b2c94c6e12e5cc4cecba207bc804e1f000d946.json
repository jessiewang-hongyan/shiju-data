[{"title":"蜀汉","author":"陆游","text":"蜀汉崎岖外，江湖莽苍中。\n冷官家世事，独立古人风。\n已老学犹力，久穷诗未工。\n悠悠千载后，此意与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜀汉","author":"陆游","text":"忆昔遨游蜀汉间，骎骎五十尚朱颜。\n呼鹰雪暗天回路，采药云迷御爱山。\n旧事已无人共说，征途犹与梦相关。\n夕阳不觉凭阑久，待得林鸦接翅还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜀州大阅","author":"陆游","text":"晓束戎衣一怅然，五年奔走遍穷边。\n平生亭障休兵日，惨澹风云阅武天。\n戍陇旧游真一梦，渡辽奇事付他年。\n刘琨晚抱闻鸡恨，安得英雄共著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜀使归寄青城上官道人","author":"陆游","text":"轻别青城十二年，至今客枕梦林泉。\n一杯松屑斋前进，两卷丹经肘后传。\n欲与公为尘外侣，几时身上峡中船。\n世间牛蚁何劳问，输与云窗一粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜀院赏梅","author":"陆游","text":"十里温香扑马来，江头还见去年梅。\n喜开剩欲邀明月，愁落先教扫绿苔。\n跌宕放翁新醉墨，凄凉废苑旧歌台。\n盛衰自古无穷事，莫向昆明叹劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜀僧宗杰来乞诗三日不去作长句送之","author":"陆游","text":"看遍东南数十州，寄船却溯蜀江秋。\n孤云两角山亡恙，斗米三钱路不忧。\n万里得诗长揖去，它年挈笠再来不。\n放翁烂醉寻常事，莫笑黄花插满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜗庐","author":"陆游","text":"蜗庐四壁空，也过百年中。\n葑火朝供爨，芦绵夕禦风。\n不憎穷有祟，自以放名翁。\n但恨村醪薄，衰颜只暂红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜗舍","author":"陆游","text":"蜗舍茨生草，龟肠饱淖糜。\n麦因多雨损，蚕遇闰年迟。\n徙义忧无勇，求仁戒自欺。\n此生虽欲尽，吾志未应衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"解嘲","author":"陆游","text":"一壑栖迟久，多生习气消。\n行藏无愧怍，梦觉两逍遥。\n倩鹤传山信，疏泉洗药苗。\n晚来幽兴极，乘月过溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赖牟镇早行","author":"陆游","text":"孤灯照影听初鸡，揽辔情怀倍惨悽。\n雪作未成云意闹，茅荒无际客魂迷。\n触寒手指藏犹裂，畏崄图书弃不携。\n老去有文无卖处，等闲题遍蜀东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"耆旧日凋谢，将如此老何。\n懑拈如意舞，狂叩唾壶歌。\n郡县轻民力，封疆恃虏和。\n功名莫看镜，吾意已蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"勋业如今莫系怀，开单日日学僧斋。\n谗深只有天堪问，忧极浑无地可埋。\n看镜已成双白鬓，登山犹费几青鞋。\n晚来诗兴谁能那，雀噪空囷叶拥阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"老荷君恩许醉眠，散人名号愧妨贤。\n久叨物外清闲福，粗识诗中造化权。\n风月四时随指顾，乾坤一气入陶甄。\n新秋更欲浮沧海，卧看云帆万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"小麦登场雨熟梅，闭门病眼每慵开。\n酒杯不解为愁敌，书卷才开作睡媒。\n骨朽空名垂断简，冢荒残碣卧苍苔。\n纷纷倾夺知何得，老觉人间但可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"老子从来薄宦情，不辞落魄锦官城。\n生前犹著几两屐，身后更须千载名。\n楼外雪山森晓色，井边风叶战秋声。\n一尊尚有临邛酒，却为无忧得细倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"貂裘破弊色凄凉，塞上归来路更长。\n老骥嘶鸣常伏枥，寒龟藏缩正支床。\n雕零客路新霜鬓，扫洒先师旧草堂。\n九折阪头休绝叹，世间何地不羊肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"学废文章传世少，身闲车马过门疏。\n壮心易尽彘肩酒，义气肯贪熊掌鱼。\n列圣仁恩深雨露，两京宫阙尚丘墟。\n素怀华渭嗟谁问，且作狂歌楚接舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"书生不自怜，老眼付皇天。\n已饱三升稷，宁堆百屋钱。\n红尘忙过日，青嶂醉论年。\n名字元虚幻，从人谤是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"壮年一箭落双雕，野饷如今撷药苗。\n寒与梅花同不睡，闷寻鹦鹉说无憀。\n乌丝阑上诗初就，绿绮声中酒半消。\n老去可怜风味在，未应山海混渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴四首 其二","author":"陆游","text":"湖海元为汗漫游，误恩四领幔亭秋。\n扫空薄禄始无愧，闭上衡门那得愁。\n汤嫩雪涛翻茗碗，火温香缕上衣篝。\n床头亦有闲书卷，信手拈来倦即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴四首 其三","author":"陆游","text":"扫尽衣尘喜不胜，村居终日醉腾腾。\n闲投邻父祈神社，戏入群儿斗草朋。\n幽径有风偏爱竹，虚堂无暑不憎蝇。\n悠然又见江天晚，隔浦人家已上灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴四首 其四","author":"陆游","text":"久矣微官绊此身，柴车归老亦逢辰。\n阮咸卧摘孤风在，白堕闲倾一笑新。\n万里驰驱曾远戍，六朝涵养忝遗民。\n清闲即是桃源境，常笑渊明欲问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"绿发凋零白发多，山林未死且婆娑。\n无端忤俗坐狂耳，甚欲读书如懒何。\n雨过乱蓑堆野艇，月明长笛和菱歌。\n此中得意君须领，莫爱车前印几窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"家住城南剡曲傍，门前山色蘸湖光。\n三朝执戟悲年往，二顷扶犁乐岁穰。\n名姓已随身共隐，文辞终与道相妨。\n子孙勉守东皋业，小甑吴粳底样香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"鹤料无多又扫空，今年真是浣花翁。\n放教绿酒关身事，留得朱颜在镜中。\n挟弹园林芳径雨，投竿窗槛小溪风。\n痴顽自笑归何日，家在东吴更向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"辙迹当年遍九州，晚归始解卧林丘。\n爱身每戒玉抵鹊，养气要如刀解牛。\n柔橹摇残天镜月，短筇领尽石帆秋。\n尽言未办常扃户，竟是吾身得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"失马真成福，移山未必愚。\n故园三径废，馀俸一钱无。\n望道心常渴，观书眼欲枯。\n宦游归自好，不必为莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"侯印从来非所图，赤丁子亦不容呼。\n著低怯对新棋敌，量减愁逢旧酒徒。\n生世岂能常役役，酣歌且复和呜呜。\n扁舟到处皆吾境，莫问桐江与镜湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"莫笑龟堂礌磈胸，此中元可贮虚空。\n尚饶灵运先成佛，那计辛毗不作公。\n采药偶逢丹井客，买蓑因过玉霄翁。\n不须更问归何许，散发飘然万里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"聒聒鸣鸠莫笑渠，百年我亦旋枝梧。\n病知药物难为验，老觉人间不足娱。\n茆屋何妨度寒暑，蔬餐且可遣朝晡。\n钓船一出无寻处，千顷江边雪色芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"前岁峨冠领石渠，即今山市醉骑驴。\n目衰书卷研求懒，心弱诗章锻鍊疏。\n风雨吾庐嗟独破，齑盐每食叹无馀。\n灯前却有欣然处，稚子谈经屡起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"图书鸡犬共扁舟，又续人间汗漫游。\n醉眼本轻千古事，钓竿新赐一滩秋。\n惯看浮世成陵谷，莫露神光上斗牛。\n老病岂堪常作客，梦寻归路傍西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"疗饥惟恃粥，动步已须人。\n欲午犹支枕，经旬不过邻。\n鹊栖寒自稳，鸥没远难驯。\n莫笑谋身拙，黄冠学季真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"莫羡朝回带万钉，吾曹要可草堂灵。\n风来弱柳摇官绿，云破奇峰涌帝青。\n听尽啼莺春欲去，惊回梦蝶醉初醒。\n从教俗眼憎疏放，行矣桐江酹客星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"我是仙蓬旧主人，一生常得自由身。\n退归自合称山长，变化犹应侍帝晨。\n得酒不妨开口笑，学人难作捧心颦。\n尘中且复随缘住，又见湖边草木新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"马迹车尘不到门，暮年万事付乾坤。\n读书浪苦只取笑，识字虽多谁与论。\n骨相元非金马客，梦魂空绕石帆村。\n浊醪幸有邻翁共，莫厌从来老瓦盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"酒量愁翻减，诗声老转低。\n日高羹马齿，霜冷驾鸡栖。\n已判功名迕，宁论簿领迷。\n赖无权入手，软弱实如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"出仕才堪斗大州，初归便拟筑糟丘。\n虚名大似月蟾兔，荣路久如风马牛。\n唧唧悲蛩常吊夜，萧萧蠹叶更禁秋。\n静观世事频兴叹，千载前时有许由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"老向人间怯路岐，感今怀昔不胜悲。\n诗无杰思知才尽，酒有残杯觉气衰。\n县郭灯疏寻店夜，津亭雨细待船时。\n筋骸尚给春耕在，便买乌犍亦未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴四首 其一","author":"陆游","text":"几看人间岁月新，钓船犹系镜湖滨。\n曾穿高帝朝元仗，却作山阴版籍民。\n留病三分嫌太健，忍饥半日未全贫。\n早知画绣能为祟，翁子终身合负薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"壮岁元多病，长年敢自期。\n贱贫交易绝，忧患梦常悲。\n续食叨微禄，宽心赖小儿。\n平生镜湖上，天乞小茆茨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"蓬壶旧隐已微茫，浪迹红尘乐未央。\n纵酒山南千日醉，看花剑外十年狂。\n新诗刻烛惊词客，骏马追风戏鞠场。\n要是世间男子事，不宜台省竞飞翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"老子痴顽惯转蓬，残年懒复问穷通。\n赦书虽未除诗债，盟府犹当策酒功。\n桐岭市回人踏月，柘冈月落鸟呼风。\n浮生触处无真实，岂独南柯是梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其一","author":"陆游","text":"外物元知等一尘，浮生何事最关身。\n江山好处得新句，风月佳时逢故人。\n有酒一樽聊自适，藏书万卷未为贫。\n圣贤自古无如命，君看居东与在陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"翳翳鱼盐市，迢迢桑麦村。\n山家薪炭足，野叟裤襦温。\n罝兔残芜尽，叉鱼积水浑。\n诗书老无效，犹拟付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"兔径游观足，蜗庐卧起宽。\n垂名千古易，无愧寸心难。\n灯火娱清夜，风霜变早寒。\n一经家世事，吾兴未应阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"平生与俗马牛风，落魄人间亦未穷。\n绿绮奏终香缕碧，乌丝书罢烛花红。\n梦中吴蜀山川近，醉后周秦战伐空。\n投老飘然君勿笑，也胜鱼鸟在池笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴二首 其二","author":"陆游","text":"远檐新叶著啼莺，睡起东窗一榻横。\n愁衮衮来疑有约，春堂堂去恨无情。\n鹘飞局上新棋势，龙吼床头古剑声。\n莫叹柴荆无客到，绿尊还对莫山倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"陆游","text":"西州落魄九年馀，濯锦江头已结庐。\n谁遣径归朝凤阙，不令小住奉鱼书。\n尘埃眯目诗情尽，疾病侵人酒兴疏。\n寄语莺花休入梦，世间万事有乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀","author":"陆游","text":"宽袂新裁大布裘，低篷初买小渔舟。\n旧交只有青山在，壮志皆因白发休。\n漫道卧罴吞貉子，安能淅米向矛头。\n山园芋栗秋方熟，一饱今知本易谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀","author":"陆游","text":"秋风策策冷吹衣，谢病经年昼掩扉。\n绝世本来希独立，刺天不复计群飞。\n细思万古名何用，太息九原谁与归。\n葬近要离非素意，富春滩畔有苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀四首 其二","author":"陆游","text":"穷每占周易，闲惟读楚骚。\n病随灾渐退，懒与拙相遭。\n投枕灯初上，披衣日已高。\n清愁亦可剪，无处买并刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀","author":"陆游","text":"许国区区不自胜，秋风空羡下鞲鹰。\n青云夜叹初心误，白发朝看一倍增。\n积愤有时歌易水，孤忠无路哭昭陵。\n头颅自揣今如此，尚欲闲寻紫阁僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀二首 其二","author":"陆游","text":"风月资吟啸，渔樵约往还。\n贫犹能酿酒，病不废游山。\n乱石卧牛马，流泉鸣佩环。\n豁除羁旅日，犹有半生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀四首 其四","author":"陆游","text":"云族初疑雨，风生忽快晴。\n半窗松竹影，绕舍鸟乌声。\n看剑心犹壮，开书眼渐明。\n馀年真已矣，不复问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀二首 其一","author":"陆游","text":"山泽荒寒外，门庭寂寞中。\n厌闻鸠唤雨，常羡鹊知风。\n逆境嗟行遍，闲愁幸扫空。\n今晨有奇事，箫鼓赛年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀四首 其三","author":"陆游","text":"有志师千载，无方起九原。\n山园菜常瘦，村店酒多浑。\n衰疾形诗句，穷愁入梦魂。\n傍观任嘲笑，吾道始应尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣怀四首 其一","author":"陆游","text":"息倦登耕陇，乘闲弄钓舟。\n安能书咄咄，且复送悠悠。\n穷巷谁来往，村醪自献酬。\n何妨晏平仲，岁晚一狐裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遥夜","author":"陆游","text":"遥夜雨声急，愔愔窗户幽。\n开编尧舜在，得句鬼神愁。\n同俗愚儒罪，容身壮士羞。\n灯残不成睡，晓角动南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遥夜","author":"陆游","text":"遥夜凛高秋，萧条念褐裘。\n烟江新雁下，竹坞暗萤流。\n旧友嗟谁在，初心恐不酬。\n一尊桑落酒，聊得洗吾愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬妙湛阇梨见赠妙湛能棋其师璘公盖尝与先君游云","author":"陆游","text":"昔侍先君故里时，僧中最喜老璘师。\n高标无复乡人识，妙寄惟应弟子知。\n山店煎茶留小语，寺桥看雨待幽期。\n可人不但诗超绝，玉子纹枰又一奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鼠屡败吾书偶得狸奴捕杀无虚日群鼠几空为赋此诗","author":"陆游","text":"服役无人自炷香，狸奴乃肯伴禅房。\n昼眠共藉床敷暖，夜坐同闻漏鼓长。\n贾勇遂能空鼠穴，策勋何止履胡肠。\n鱼餐虽薄真无愧，不向花间捕蝶忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧饭","author":"陆游","text":"云碓舂粳白，斋厨爨桂香。\n百穷惭燕颔，一饱慰龟肠。\n举世知心少，平生为口忙。\n何当弃簪笏，终老掩山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧房假榻","author":"陆游","text":"过尽青山唤渡船，晚窗洗脚卧僧毡。\n剩偿平日清游愿，更结来生熟睡缘。\n吞啄渐稀如老鹤，鸣声已断似寒蝉。\n旁观莫苦嘲痴钝，此妙吾宗秘不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉川铺得檄遂行中夜次小柏","author":"陆游","text":"黄旗传檄趣归程，急服单装破夜行。\n肃肃霜飞当十月，离离斗转欲三更。\n酒消顿觉衣裘薄，驿近先看炬火迎。\n渭水函关元不远，著鞭无日涕空横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉川铺遇小雨景物尤奇","author":"陆游","text":"一春客路厌风埃，小雨山行亦乐哉。\n危栈巧依青嶂出，飞花并下绿岩来。\n面前云气翔孤凤，脚底江声转疾雷。\n堪笑书生轻性命，每逢险处更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉阳绝无木犀偶得一枝戏作","author":"陆游","text":"久客红尘不自怜，眼明初见广寒仙。\n只饶篱菊同时出，尚占江梅一著先。\n重露湿香幽径晓，斜阳烘蕊小窗妍。\n何人更与蒸沉水，金鸭华灯恼醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]