"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾谹父还朝十首 其六","author":"曹勋","text":"识公政事在恺悌，接物情文惟至诚。\n天台两岁士民说，要雨雨来晴便晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾谹父还朝十首 其四","author":"曹勋","text":"大参宴客有遗址，栋宇半攲荆棘中。\n一日青红丽云表，因知雅量自相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾谹父还朝十首 其十","author":"曹勋","text":"借寇何能共此邦，离怀未易寸心降。\n惟将老泪逐梅雨，流入玉溪同一江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送腊梅与曾谹父","author":"曹勋","text":"紫烟破萼缀蜂房，薇露浓薰冉冉香。\n寄与赤城贤太守，要知和气入风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新酒糟蟹与贾之奇五首 其五","author":"曹勋","text":"企咏公才绿涨醅，我方破器不成罍。\n词源端并流三峡，薪火何能救一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新酒糟蟹与贾之奇五首 其四","author":"曹勋","text":"新诗慰我胜浮醅，岂待杯盘更举罍。\n但愿车中无折齿，何忧举案乏持杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0