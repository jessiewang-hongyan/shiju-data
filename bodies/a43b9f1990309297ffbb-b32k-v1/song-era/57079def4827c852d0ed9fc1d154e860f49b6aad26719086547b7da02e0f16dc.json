ointer":64939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日偶成六首 其四","author":"曹勋","text":"雨湿云容廓太清，池边向晚喜闲行。\n回溪曲港烟波绿，已有荷花照眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日偶成六首 其三","author":"曹勋","text":"田田秧稻半青黄，比屋人家煮茧香。\n新绿侵人襟袖爽，满川烟水助清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日偶成六首 其二","author":"曹勋","text":"且欣久雨得新晴，水面荷香入座清。\n尽日水塘无一事，夏莺恰恰啭新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日偶成六首 其一","author":"曹勋","text":"梅溽霏微昼景长，竹吹清润著衣裳。\n未妨燕坐连宵雨，且对澄心一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭睹宸制花落尤艳之句自古诗人未有形容及此者使落花不与草木俱委可见天地大德之心小臣不量芜颣仰赓宸韵","author":"曹勋","text":"春事匆匆绿渐秾，林花铺绣晓烟中。\n如何捲上黄金阙，许作华裀舞阆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浙西刈禾以高竹叉在水田中望之如群驼","author":"曹勋","text":"浙西纯种晚秋禾，更得明年雨不多。\n且刈且歌丰岁甚，平洋弥望列明驼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"班婕妤","author":"曹勋","text":"宠移非为妒，花落不因风。\n来往长门月，羞将团扇同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中七夕","author":"曹勋","text":"道涂行役费光阴，节物还撩一寸心。\n百尺烟坛上星斗，笑看儿女竞穿针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其七","author":"曹勋","text":"曾奉清言吐屑霏，岩廊又复仰几微。\n正须国论筹前箸，毋使人间见亦稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其六","author":"曹勋","text":"忠孝传家大府开，苍生久已待盐梅。\n我虽潦倒山林下，会听中天紫诏来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其五","author":"曹勋","text":"相君自是仙山侣，大笔如椽鄙燕许。\n七篇方愧不成章，肆笔相酬语深古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其四","author":"曹勋","text":"露地全牛何湿湿，岂比汉阴负井汲。\n拈出老胡向上机，便知挂一不成十。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其三","author":"曹勋","text":"天一地二数至七，开天之天识量疾。\n荡然独立放全身，莫问诸方悉不悉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其二","author":"曹勋","text":"冰玉无尘彻骨清，世间荣禄一毫轻。\n未论此际通三际，直向今生度此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱大参有和用韵谢之七首 其一","author":"曹勋","text":"瑞峰来现宰官身，清峙岩岩耸搢绅。\n闻道石头时说偈，一堂惊动水云人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巢湖阻风题岸亭","author":"曹勋","text":"病体萦仍未肯安，益嗟气血顿衰残。\n更堪五日守风苦，殊觉一年行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]