[{"title":"春日雪雷并作","author":"赵抃","text":"东君新用少阳时，正月群阴老未归。\n千里雪花铺夜景，数声雷鼓作春威。\n欲开桃李嗟寒勒，尚蛰龙蛇恨力微。\n一挫芳菲一惊物，惘然无处问天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入峡","author":"赵抃","text":"浃江初过三游洞，天气新调二月风。\n樵户人家随处见，仙源云路有时通。\n峰峦压岸东西碧，桃李临波上下红。\n险碛恶滩知几许，晚停征棹问渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过岭回寄张景通先生示邑下同人","author":"赵抃","text":"二年官役愧能名，贤得斯人幸合并。\n几度孝廉交郡辟，一生文行出乡评。\n君庐皂水江头远，我马青泥岭顶行。\n西首胡为书以赠，欲持同邑寄诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下牢津","author":"赵抃","text":"拖舟百丈苦攀跻，一过牢津恍似迷。\n花放乱红迎彩旆，谷传深响答鸣鼙。\n避人幽鸟凌云噪，抱子惊猿走险啼。\n春岫重重春水绿，却疑身在武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同万州相里殿丞游溪西山寺","author":"赵抃","text":"使君呼客入山行，晓径前驱照彩旌。\n蛮女背樵岩侧避，野僧携刺马头迎。\n千层云水迷三峡，一鬨人烟认百城。\n楼阁凭馀清我听，竹风萧瑟涧泉鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄贲赴渭州机宜","author":"赵抃","text":"我愧非才敢赠言，告新今幸接英躔。\n炎威满路千山去，和气流民百口传。\n就捧丝纶天子命，到参帷幄主人贤。\n前筹要使边陲静，报德铭功愿两全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张著作赠讲礼孙秀才","author":"赵抃","text":"丈席横经事讲评，暂开雄辩五河倾。\n十年素蕴胸中吐，一日清风坐上生。\n诸子授来疑顿释，先儒宗后业偏精。\n尘编古有多门学，今喜公能为发明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬杨鸿渐察判见寄","author":"赵抃","text":"进不惊人退不藏，朅来士术惠殊乡。\n疏馀益信琴多乐，拙甚方虞锦重伤。\n顾我未能精俗事，感公偏遗好诗章。\n怀间得胜千金直，莫谓无人识夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送崔度推官任满还长安","author":"赵抃","text":"三岁西州此效官，幕中无事有宾欢。\n瞻云预喜长安近，归骑还惊蜀道难。\n分袂天涯逢腊尽，入关时候正春寒。\n前途应念朋从意，回首秦亭一据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒青城山","author":"赵抃","text":"背琴肩酒上青城，云为开收月为明。\n观宿有诗招主簿，庐空无分遇先生。\n墙留古画仙姿活，石载奇文俗眼惊。\n却念吾乡山亦好，二年孤负烂柯行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙直言正旦马上有感","author":"赵抃","text":"蜀国从官又见春，物华人事两俱新。\n已推才力多馀地，更赋词章妙入神。\n要路我甘无俗迹，夷途公自有通津。\n逢时得用看施设，未止区区庇远民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵佥判俞尚都官寄兄君然中允致政","author":"赵抃","text":"勇退如公世少俦，乐天知命富春秋。\n峨峨去得寒宫桂，泛泛归乘雪水舟。\n举目烟霞中有趣，无心轩冕外何求。\n引高应笑朝闺客，白首龙钟未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和淮上喜雪呈贯之","author":"赵抃","text":"落雪纷纷甚羽毛，相逢淮上系轻舠。\n压低酒力威棱健，助豁诗怀气象豪。\n两岸远山供玉障，一天长水尽云涛。\n归欤喜见丰年瑞，南顾无烦帝力劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颍川见徐学士","author":"赵抃","text":"台阁官资属二贤，岁寒相见颍流边。\n新醪喜泛千钟蚁，永漏惊移数叶莲。\n致主圣神跻舜禹，济时功业企闳颠。\n故人清会俱高论，肯事狂歌学少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵范师道御史","author":"赵抃","text":"昔如李郭去登仙，今复东行并客船。\n夹岸云山千里路，满襟风月九秋天。\n持杯旋斫桐江鲙，觅句频赓蜀国笺。\n君到七闽佳丽地，荔枝红发欲殷然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和见雪","author":"赵抃","text":"惊怪穷冬百物繁，落梅狂絮逐风翻。\n酒无戈甲争酣战，诗似波澜竞讨源。\n且卸帆樯隈断岸，好开屏嶂画孤村。\n知音若问阳春曲，待把琴调细细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新定即事","author":"赵抃","text":"泉高终日听潺湲，花草才佳烂漫看。\n言念君恩得私请，敢于身计学偷安。\n开元刺史名千古，东汉先生钓一竿。\n贤迹勉寻余自愧，牧民犹带触邪冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到睦州寄毗陵范御史","author":"赵抃","text":"前日鹓鸿接羽仪，平生风谊见施为。\n苏台薄暮分襟后，严濑逢佳伫立时。\n归棹岂能忘旧里，去筒犹未寄新诗。\n寒泉绕石山环坐，一弄南风慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范都官述怀","author":"赵抃","text":"人为閒郡我为荣，僚友多欢事少生。\n诗里江山今共乐，籍中龙虎旧传名。\n逢时自可青云致，喜老休将白发轻。\n垂世功名期力到，上方求治急材英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉郡学诸生","author":"赵抃","text":"桐江为守愧颛蒙，来喜衣冠好士风。\n劝学重思唐吏部，教人多谢汉文翁。\n济时事业期深得，落笔词章贵不空。\n道有未充须自立，莫将荣悴汩于中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和彦涂田曹见寄","author":"赵抃","text":"自喜还家入郡闳，久无书简到京城。\n棋观每笑机心巧，琴断还忧曲意生。\n厚禄万钟身外薄，冷泉千尺耳边清。\n来诗咏叹陶然乐，疑梦钧天奏九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范都官","author":"赵抃","text":"莫惜芳樽细细斟，还台诗句满离襟。\n海潮风驾漫幽渚，乡岫云开认故林。\n八月气凉归棹快，三年恩厚在人深。\n紫宸晓拜天光近，宜有封囊悟主心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前人重九日寄","author":"赵抃","text":"丁字溪流甚箭奔，忍看行色夕阳村。\n三吴望远迷烟棹，九日登高泥酒樽。\n诗得琼瑶今有意，感充怀抱更无言。\n归欤一曲桐江好，西北通宵欲梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新定获龟继得梓漕携之赴官","author":"赵抃","text":"买自桐江数岁前，洁中轻外欲巢莲。\n同麟荐世宜为瑞，邀鹤寻真定得仙。\n肯示吉凶贻后悔，祇随呼吸到长年。\n主人幸不烦供养，俾托轺车看两川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过子陵故祠","author":"赵抃","text":"帝念先生素所亲，殊恩终不顾丝纶。\n图勋耻预凌烟像，辞贵甘为掷钓人。\n云水孤高教适意，俗风奔竞使还淳。\n如今丘壑无遗士，天子思贤号圣神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵石温之都官见赠","author":"赵抃","text":"桐江得请上恩荣，孤士惭无善可旌。\n望阙天光惊已远，到家春色喜先迎。\n云边旧念青山隐，鉴里新逢白发生。\n多谢贤朋遗佳句，重于珍璧价连城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆松溪三兄县尉","author":"赵抃","text":"忆别扬州六月中，倏今三已换春冬。\n烟帆去蜀七千里，云岭瞻闽几万重。\n莫为沈迷嗟下邑，要将清白广吾宗。\n天遥最是书难得，早倩来鸿寄一封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郑琰登睦州高峰塔","author":"赵抃","text":"旧迹蒙君丽句誇，昔同峰顶蹑云霞。\n逢秋谒寺留诗笔，薄暮归鞍照月华。\n旋酌香醪浮瓮蚁，斗烹新茗满瓯花。\n心馀更作儒官会，帐内诸生拥绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得守虔州过乡邦赠别衢州太守高赋同年","author":"赵抃","text":"俞请分符入赣川，过家为幸获于天。\n桂宫旧有同年契，梓里今逢太守贤。\n酾酒殷勤供去帐，解囊分耀贮离篇。\n晓来颇觉思君梦，烟水苍茫隔画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"守虔过家登高斋即事","author":"赵抃","text":"旧里徘徊忽四旬，高斋高胜足欢忻。\n当轩晓看山横黛，负郭秋成稼覆云。\n酌酒屡邀朋契乐，弄琴真与俗喧分。\n虔州莫讶迟迟去，乡便恩荣荷圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄永倅周敦颐虞部","author":"赵抃","text":"君去濂溪湖外行，倅藩仍喜便乡程。\n九疑南向参空碧，二水秋临彻底清。\n诗笔不閒真吏隐，讼庭无事洽民情。\n霜鸿已到衡阳转，远绪凭谁数寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虔州即事","author":"赵抃","text":"君恩山重若为酬，补郡都忘乐与忧。\n惶恐滩长从险绝，郁孤台迥足观游。\n赣川在昔名难治，铃閤于今幸少休。\n人谓阔疏予自喜，远民安堵更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何若谷都官灯夕","author":"赵抃","text":"千门灯烛事遨游，车马通宵不暂休。\n幸免烟氛遮皓月，任随笳鼓杂鸣驺。\n金壶漏下丁丁永，玉斝霞生滟滟流。\n帝泽远临人鼓腹，赣川宜有太平讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐师回殿丞捧诏亭听琴","author":"赵抃","text":"讼缿无哗去访真，并游僚友若天伦。\n庭存列宿仙坛古，堂启先生诏墨新。\n膝上挥弦清度曲，席间倾耳静留神。\n泠泠不断绵绵意，追想南风解愠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄知福州范师道龙图","author":"赵抃","text":"十年游雾入兰薰，本末聊同出处均。\n五岭昔将巴蜀远，七闽今与赣川邻。\n雪中始见松难改，火后须知玉是真。\n事业他时公自任，致君尧舜泽吾民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何若谷寒食燕集","author":"赵抃","text":"雨过江城绝点尘，清明佳节正千门。\n舞香扑坐花新戴，歌响盘云曲旋翻。\n几欲为春留日驭，直须同俗醉衢樽。\n因思老氏登台乐，若此斯民未足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱顗喜雨","author":"赵抃","text":"山川灵秀降丰穰，十里油云泽我疆。\n为叩明神虞岁旱，故飘甘泽助春阳。\n征人共解江头缆，游女争誇陌上桑。\n令尹爱民形喜色，作诗先已报丰祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次何若谷上巳游江","author":"赵抃","text":"祓禊追修宴集开，山川聊为霁风雷。\n衣冠恺乐觞传羽，旗鼓号呶笛弄梅。\n画鹢稳移随岸曲，珍禽惊避逐波颓。\n百城锦绣人如织，笑看使君乘兴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱顗见赠入学听讲","author":"赵抃","text":"文翁治蜀泽民深，赣守无堪愧士林。\n长育务先庠序教，讲磨思见圣贤心。\n今兹未肯孤毫善，学者尤宜念寸阴。\n三百馀篇金石奏，席间愿听得遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何若谷寄提刑蔡挺","author":"赵抃","text":"远俗斯年荷德丰，一麾乌足滞才雄。\n朝签寄任非轻外，圣诏丁宁果发中。\n却念松楸还里闬，再驰牛犊恳天聪。\n只应未遂归欤兴，江右澄清已望风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵楚守孙直言职方见寄","author":"赵抃","text":"间关来赣会年丰，十里农桑画障中。\n雨足山川多秀气，暑消台阁有清风。\n人惊地远还同近，谁道江西不似东。\n琴酒从容随分乐，敢将身计事匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵广东转运董仪职方同年见寄","author":"赵抃","text":"赣守无堪出榜中，日闻将漕称才雄。\n感公迢递诗筒至，谓我优游讼缿空。\n高会正遥千障月，羁怀聊寄七弦风。\n何时把酒朋从乐，也待醒狂学次公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄伯度虞部见赠","author":"赵抃","text":"念昔相逢向上方，别来惊已换星霜。\n梦回半是烟波阻，诗寄全篇箧笥光。\n近喜岁丰无剧讼，更多雨足压骄阳。\n施为自顾如何尔，凫鹤奚烦问短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻杜植移使湖南","author":"赵抃","text":"去岁南来幸守麾，故人江上喜新眉。\n十分劝我流霞酒，一曲听公白雪词。\n此后拙疏真有赖，而今谈笑杳无涯。\n惊闻拥节重湖去，凭仗西风寄所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题悦亭因简何若谷都官","author":"赵抃","text":"翠柏环庭数亩间，萧疏仍是枕江干。\n都如君子怜松茂，半为主人谙岁寒。\n素壁留诗多健羡，画船过里暂盘桓。\n因公此景予心喜，亦有高斋待挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送前人过乡还朝","author":"赵抃","text":"景祐贤科昔共登，长沙宾佐复交承。\n三千里外今同郡，二十年前旧得朋。\n赣水帆樯惊远别，玉峰栏槛到先凭。\n朝廷正是求材日，欲恋仙乡算未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵董仪都官见赠","author":"赵抃","text":"海陵余昔嗣英僚，旧尹咨新治有条。\n此别风波嗟各路，但闻名誉籍当朝。\n美夫郡接濒江地，幸矣民多乐岁谣。\n南国故人千里隔，举头云岭郁岧峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同周敦颐国博游马祖山","author":"赵抃","text":"晓出东江向近郊，舍车乘棹复登高。\n虎头城里人烟阔，马祖岩前气象豪。\n下指正声调玉轸，放怀雄辩起云涛。\n联镳归去尤清乐，数里松风耸骨毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南康公馀有作","author":"赵抃","text":"道未中充气未闳，圣神遭遇本寒生。\n廷中入愧言无补，岭下来欣治有名。\n世路计身焉用巧，古人逢物要推诚。\n从容章贡台前望，赣水秋天一样清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周敦颐国博见赠","author":"赵抃","text":"蜀川一见无多日，潮水重来复后时。\n古柏根深容不变，老桐音淡世难知。\n观游邂逅须同乐，离合参差益再思。\n篱有黄花樽有酒，大家寻赏莫迟疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和虔守任满前人香林寺钱别","author":"赵抃","text":"顾我入趋尧阙去，烦公出饯赣江头。\n为逢萧寺千山好，不惜兰船一日留。\n清极往来无俗论，道通何处有离忧。\n分携岂用惊南北，水阔风高万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵衢守陈守言职方招游烂柯山","author":"赵抃","text":"贤侯九日去寻山，牵俗无由得附攀。\n换世昔传仙局久，登高今喜使车还。\n平原丰稔农欢劝，犴狱空虚吏放閒。\n从此烂柯光价起，为留佳句落人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"按狱眉山舟行","author":"赵抃","text":"携琴晓出锦官城，千里秋原一望平。\n放舸急流身觉快，披云孤屿眼增明。\n农田雨后畦畦绿，渔笛风前曲曲清。\n讯狱远邦先涤虑，恤哉休戚在民情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵蔡挺提刑出巡将还","author":"赵抃","text":"榜契推诚积有年，天渊冲跃见鱼鸢。\n方欣友会为愚幸，又辱诗情著意缘。\n庾岭棠阴留远俗，赣川舟御若飞仙。\n明朝预想陪高谊，满座清风盛暑天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会新都孙直言于成都","author":"赵抃","text":"同志同年分若亲，幸从天与岂关人。\n交情旧别江乡晚，客宦今逢蜀国春。\n酌酒强论贤否事，畏涂休说利名身。\n邻封却喜无多远，来往诗筒莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题三泉县龙洞","author":"赵抃","text":"蜀道群山尽可名，更逢佳处愈神清。\n初疑谷口连云掩，入见天心满洞明。\n怪石磷磷蹲虎豹，飞泉落落碎瑶琼。\n嵬巅别有神仙路，又得攀跻向上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都西楼","author":"赵抃","text":"多暇朱栏倚望频，远云开即见峨岷。\n昔贤初尽经营力，今我独为优幸人。\n胜阁帘高惟掩雨，老台民乐只登春。\n争如蜀国西楼好，四序风光日日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张公咏二月二日始游江以集观者韩公绛因创乐俗亭为驻车登舟之所","author":"赵抃","text":"长桥东畔尼朱轮，画栋雕栏锦水滨。\n子美浮槎传大句，乖崖游棹看芳春。\n樽罍泛泛留佳客，鼓吹喧喧乐远人。\n夹岸香风十馀里，晚随和气入城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和交代韩公绛端明别后见寄","author":"赵抃","text":"关山晴晓过绵州，两蜀人思惠爱稠。\n去路旌麾朝日下，驾空桥栈接云头。\n初观妙句离怀释，似酌清泉渴恙瘳。\n孤绪摇摇更东望，西楼千尺止三休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢蒙州守周源屯田","author":"赵抃","text":"念公别后固依然，蜀距炎方里数千。\n剑栈过来才一月，诗筒传得已三篇。\n胸藏忠谊坚于石，口吐文章涌似泉。\n何日解符还阙去，如今朝野不遗贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运使王举元兵部因谈道惠诗次韵","author":"赵抃","text":"初穷文字作阶缘，若得嘉鱼即弃筌。\n堪笑蚊蝇惊八月，岂知龟鹤寿千年。\n无心是处非关境，有命由来不在天。\n自古君臣悉功行，不然终未到神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送前人还都","author":"赵抃","text":"蜀道将输茂绩成，远人安靖岁丰盈。\n发施号令岷山峻，除去贪婪锦水清。\n一旦赐环来日下，九秋乘驿度云程。\n朝廷礼盛荣归好，亲见吾皇讲太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荣諲学士按部未还因寄","author":"赵抃","text":"欲见遐陬尽乐康，沈黎回即按嘉阳。\n寻山举屐三峨峻，度岭驱车九折长。\n坞柏正宜寒后悦，驿梅多向腊前芳。\n锦川遨乐春期近，早著鞭来入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]