[{"title":"唐道人请赞","author":"释宗杲","text":"这尊慈，无摸索。\n忽地喜，忽地恶。\n喜也，和气如春百华开萼，怒也，雷电风云一时俱作。\n似恁么做处，若非阿脩罗王，即是金仙大觉。\n唐道人，紧收却。\n逢人不用展开，卷来送在壁角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悟本禅人求赞","author":"释宗杲","text":"一千七百痴衲子，围绕这个无明叟。\n细腻浑没一星儿，粗糙却有七八斗。\n未尝寂寂入禅定，终日波波廊下走。\n为人巴鼻亦好笑，更不容人谩开口。\n盲枷瞎棒当慈悲，是与不是劈脊娄。\n如斯主法作宗师，枉续牟尼子孙后。\n本禅千万莫学伊，学伊和尔不唧溜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅藏后题智證庵壁","author":"释宗杲","text":"柏子拈来香满庐，蒲团静里结跏呋。\n三年过眼千千卷，此际分明一字无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其三十六","author":"释宗杲","text":"有佛处不得住，生铁称锤被虫蛀。\n无佛处急走过，撞著嵩山破灶堕。\n三十里外莫错举，两个石人相耳语。\n恁么则不去也，此语已行遍天下。\n摘杨华，摘杨华，唵嚤呢哒哩吽㗶吒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一一六","author":"释宗杲","text":"崎崎岖岖平坦坦，平坦坦处甚崎岖。\n蓦地跛驴能蹴蹋，抹过追风天马驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一一四","author":"释宗杲","text":"三世诸佛不知有，老老大在外边走。\n眼皮盖尽五须弥，大洋海里翻筋斗。\n狸奴白牯却知有，瀑布不溜青山走。\n堪笑无端王老师，错认簸箕作熨斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一一二","author":"释宗杲","text":"电光石火尚犹迟，猗死禅和那得知。\n转面回头拟寻讨，夕阳已过绿梢西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一○七","author":"释宗杲","text":"春至自开华，秋来还落叶。\n黄面老瞿昙，休摇三寸舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一○五","author":"释宗杲","text":"独坐许谁知，青山对落晖。\n华须连夜发，莫待晓风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一○四","author":"释宗杲","text":"燕坐道场经十劫，一一从头俱漏泄。\n世间多少守株人，掉棒拟打天边月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一○三","author":"释宗杲","text":"一口吸尽西江水，甲乙丙丁庚戊己。\n咄咄咄，啰啰哩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一○二","author":"释宗杲","text":"云门鉴咦，少有人知。\n咄，无孔铁锤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其九十四","author":"释宗杲","text":"小鱼吞大鱼，直路太萦纡。\n古帆休更问，处处得逢渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其九十三","author":"释宗杲","text":"后园驴吃草，一老一不老。\n蓦地撞出来。\n斗凑得恰好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其九十二","author":"释宗杲","text":"老青原，没缝罅。\n问佛法，酬米价。\n差毫釐，成话把。\n无面目，得人怕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其九十一","author":"释宗杲","text":"杨岐一头驴，只有三只脚。\n潘阆倒骑归，攧杀黄幡绰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其九十","author":"释宗杲","text":"金刚圈，栗棘蓬。\n玄沙三种病，石巩一张弓。\n直截为君说，新罗在海东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其八十九","author":"释宗杲","text":"有时笑兮有时哭，悲喜交并暗催促。\n此理如何举同人，断弦须得鸾胶续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其五十六","author":"释宗杲","text":"全死中全活，全活中全死。\n一个讶郎当，一个福建子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其五十","author":"释宗杲","text":"丹山生鸑鷟，师子彦狻猊。\n棒下摩醯眼，徒誇第一机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其四十五","author":"释宗杲","text":"俊哉一跃透重渊，霹雳追之去不还。\n却笑龙门烧尾者，依前点额在波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其四十四","author":"释宗杲","text":"不落不昧，石头土块。\n蓦路相逢，银山粉碎。\n拍手呵呵笑一场，明州有个憨布袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其三十九","author":"释宗杲","text":"凿坏十方常住地，三钱使尽露尸骸。\n罗山古佛虽灵验，未免将身一处埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其三十八","author":"释宗杲","text":"直饶钉得遮一缝，点检将来非好手。\n可怜两个老禅翁，却向俗人说家丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其三十四","author":"释宗杲","text":"青州七斤衫，尽力提不起。\n打破赵州关，总是自家底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其二十九","author":"释宗杲","text":"赵州有密语，文远不覆藏。\n演出大藏教，功德实难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其二十六","author":"释宗杲","text":"天下禅和说勘破，争知赵州已话堕。\n引得儿孙不丈夫，人人点过冷地卧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其二十四","author":"释宗杲","text":"好一殿功德，总是过去佛。\n百福相严身，不使栴檀刻。\n日日香烟夜夜灯，看来当甚乾萝葡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其十八","author":"释宗杲","text":"五月五日午时书，赤口毒舌尽消除。\n更饶急急如律令，不须门上画蜘蛛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其十五","author":"释宗杲","text":"身上著衣方免寒，口边说食终不饱。\n大唐国里老婆禅，今日为君注破了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其十四","author":"释宗杲","text":"雨散云收后，崔嵬数十峰。\n倚栏频顾望，回首与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其十三","author":"释宗杲","text":"倒腹倾肠说向君，不知何物尚沈吟。\n而今便好猛提取，付与世间无事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其十一","author":"释宗杲","text":"若将此语定纲宗，孤负明招独眼龙。\n笑里忽分泥水路，方知千里共同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其八十三","author":"释宗杲","text":"马驹喝下丧家风，四海从兹信息通。\n烈火焰中挥得月，巍巍独天坐雄峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其八","author":"释宗杲","text":"见得分明识得亲，举来犹自涉涂程。\n直饶不犯毫芒者，也是拈䭔舐指人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其七","author":"释宗杲","text":"出得出不得，是定非正定。\n罔明与文殊，丧却穷性命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其八十二","author":"释宗杲","text":"扯破云门一柄扇，拗折乾峰一条棒。\n二三千处管弦楼，四五百条华柳巷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其八十一","author":"释宗杲","text":"瞎驴一跳众皆惊，正法那堪付与人。\n三要三玄俱丧尽，堂堂摆手出重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其一○一","author":"释宗杲","text":"言无展事，语不投机。\n随言者丧，滞句者学。\n逢人不得错举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其七十六","author":"释宗杲","text":"打破鬼门关，日轮正当午。\n一箭中红心，大地无寸土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其七十三","author":"释宗杲","text":"痴人面前休说梦，生铁团上须寻缝。\n明明说与却佯聋，只管外边闲打鬨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其七十一","author":"释宗杲","text":"古庙里头回避得，纸钱堆畔暗嗟吁。\n闲神野鬼皆惊怕，只为渠侬识梵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其六十八","author":"释宗杲","text":"云门乾屎橛，全超法报化。\n无事出山游，百钱杖头挂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其六十四","author":"释宗杲","text":"和尚不赴堂，庄主谢临屈。\n一字入公门，九牛撤不出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其六十二","author":"释宗杲","text":"夜半明星当午现，愚夫犹待晓鸡鸣。\n可怜自屎不知臭，又欲重新拈似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其六十一","author":"释宗杲","text":"先师会里呈真处，临济堂前吃菜时。\n连此三回露拴索，咄这缘台盘乞儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其六十","author":"释宗杲","text":"以平报不平，王法本无亲。\n临济虽明眼，也是黄龙精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百二十一首 其五十九","author":"释宗杲","text":"一气转一大藏教，顿渐偏圆权与实。\n无边妙义炳然彰，元来一字也不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其六","author":"释宗杲","text":"何必不必，绵绵密密，觌面当机。\n有人续得末后句，许你亲见二尊宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古六首 其一","author":"释宗杲","text":"三千威仪都不修，八万细行全不顾。\n只因闹市里等人，被人唤作破落户。\n兜率内院久抛离，纵归忘却来时路。\n稽首弥勒世尊，得与么宽肠大肚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三四","author":"释宗杲","text":"昨日梦说禅，如今禅说梦。\n梦时梦如今说底，说时说昨日梦底。\n昨日合眼梦，如今开眼梦。\n诸人总在梦中听，云门复说梦中梦。\n驴唇先生开中笑，阿脩罗王打勃跳。\n海神失却夜明珠，擘破弥卢穿七窍。\n三人上座请谈禅，平地无风浪拍天。\n禅禅，不用思量卜度，非干文字语言。\n仰之弥高，钻之弥坚。\n岩头刬之则曰是句非句，临济用之则曰三要三玄。\n禅禅，吞却栗棘蓬，透发金刚圈。\n休论赵老汉庭前柏树子，莫问首山新妇骑驴阿家牵。\n但请一时放下著，当人本体自周圆。\n梦里明明有六趣，觉后空空无大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其四十四","author":"释宗杲","text":"处处真，处处真，尘尘尽是本来人。\n真实说时声不现，正体堂堂没却身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一六一","author":"释宗杲","text":"百杂碎，没缝罅。\n明眼衲僧，盲聋瘖哑。\n金刚水际藏身，非非想天走马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一六○","author":"释宗杲","text":"差之毫釐，失之千里。\n孟春犹寒，终而复始。\n释迦老子是系驴橛，一大藏教是破故纸。\n如我按指，海印发光。\n汝暂举心，尘劳先起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一五七","author":"释宗杲","text":"清净慈门刹尘数，共生如来一妙相。\n一一诸相莫不然，是故见者无厌足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一五六","author":"释宗杲","text":"大根大器大丈夫，不越一念了大事。\n三世诸佛立下风，此人堪作如来使。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一五四","author":"释宗杲","text":"白的的，清寥寥。\n水不能濡，火不能烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一五二","author":"释宗杲","text":"一二三四五，虚空阙处补。\n五四三二一，当门书大吉。\n好手挥斤去鼻泥，衲僧机妙安能识。\n蓦然识，百草头边露消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一五一","author":"释宗杲","text":"丹霞烧却木佛，翠微供养罗汉。\n一人左手抬，一人右手按。\n宾主既历然，吾道一以贯。\n师子独游行，岂复求侣伴。\n团圞擘不开，打鼓普请看。\n虽不直分文，倾国不肯换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一五○","author":"释宗杲","text":"生也不道，死也不道。\n公案两重，一状领到。\n露刃吹毛，截断纲要。\n脱却鹘臭衫，拈了炙腊脂帽，大坐当轩气浩浩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四九","author":"释宗杲","text":"不落与不昧，半明兼半晦。\n不昧与不落，两头空索索。\n五百生前个野狐，而今冷地谩追呼。\n座中既有江南客，休向樽前唱鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四七","author":"释宗杲","text":"冤有头，债有主。\n偶因失脚倒地，至今怨入骨髓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四六","author":"释宗杲","text":"这僧问赵州，赵州答赵州。\n得人一马，还人一牛。\n人平不语，水平不流。\n受恩深处宜先退，得意浓时便好休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四五","author":"释宗杲","text":"行不到处说不难，说不到处行不难。\n行说难到不难到，拈却门前大案山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四四","author":"释宗杲","text":"即心即佛莫妄求，非心非佛休别讨。\n红炉焰上雪华飞，一点清凉除热恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四三","author":"释宗杲","text":"彻骨彻髓道一句，三要三玄绝遮护。\n竺乾四七例皆迷，震旦二三浑未悟。\n我说是言非正邪，当机觌面休回互。\n殷勤为报云台公，俊鹰不打篱边兔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一四二","author":"释宗杲","text":"聊闻举著便承当，好肉无端已剜疮。\n著眼机轮上头看，方知两两不成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三九","author":"释宗杲","text":"俱劄普，日轮午。\n李将军，射石虎。\n虽然透过那边，枉发千钧之弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三八","author":"释宗杲","text":"今早又风起，闹处莫插觜。\n触著阎罗王，带累阴司鬼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三七","author":"释宗杲","text":"真生无可生，真灭无可灭。\n寂灭忽现前，虾蟆吞却月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三六","author":"释宗杲","text":"举一不得举二，放过一著落在第二。\n遇贵则贱，遇贱则贵。\n筑著磕著，没处回避。\n南岳天台去路通，君向西兮我向东，风从虎兮云从龙。\n拈起簸箕别处舂，熨斗煎茶铫不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三二","author":"释宗杲","text":"普贤身相无有二，八万四千毛孔刹。\n一一毛孔一如来，一一如来一塔庙。\n舍利坚固金刚身，虚空可坏此不朽。\n女子陈氏报劬劳，一一塔庙一瞻礼。\n满足八万四千拜，尽诸毛孔无有遗。\n所获功德不可量，正与普贤行愿等。\n用严数父及慈母，遍及法界诸有情。\n永离苦海證菩提，悉得心空超彼岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]