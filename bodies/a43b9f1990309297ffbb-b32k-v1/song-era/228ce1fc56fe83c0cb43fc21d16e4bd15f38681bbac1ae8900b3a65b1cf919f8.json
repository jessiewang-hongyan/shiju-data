:"宋_2.csv","pointer":15820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日寄秦觏","author":"陈师道","text":"疾风回雨水明霞，沙步丛祠欲莫鸦。\n九日清樽欺白发，十年为客负黄花。\n登高怀远心如在，向老逢辰意有加。\n淮海少年天下士，独能无地落乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月九日魏衍见过","author":"陈师道","text":"节里能相过，谈间可解忧。\n致疏君未肯，得此我何由。\n语到君房妙，诗同客子游。\n一经从白首，万里有封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十三日出善利门","author":"陈师道","text":"十载都城客，孤身冒百艰。\n一饥非死所，万里有生还。\n去国吾何意，从人病不间。\n共看双白鬓，似得半生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五夜月","author":"陈师道","text":"向老逢清节，归怀托素晖。\n飞萤元失照，重露已沾衣。\n稍稍孤光动，沉沉众籁微。\n不应明白发，似欲劝人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元致语口号","author":"陈师道","text":"欢声喜气塞康庄，妙舞清歌乐未央。\n此节定知随意好，今宵端复为人长。\n妆成粉白生春色，酒泻鹅黄射烛光。\n报答风光须一醉，从来千骑贵东方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上赵使君","author":"陈师道","text":"老气峥嵘盖九州，治声腾涌逐双流。\n向来置醴蒙殊遇，此日弹冠愧少留。\n千里山连环故国，中秋月好傍黄楼。\n不应为米轻乡里，定复还从马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上晁主客","author":"陈师道","text":"两疏父子共含香，不独家荣国有光。\n剩欲展怀因问疾，孰知相对只衔觞。\n年侵身要兼人健，节近花须满意黄。\n从此竹林须小阮，只今未可弃山王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与寇赵约丁塘看花寇以疾不赴有诗次其韵","author":"陈师道","text":"早年学苦断过从，晚岁逢春意未穷。\n欲共元刘争著语，不堪姚魏已随风。\n坐无上客席虚左，赠有英词囊不空。\n障日长须钓竿手，归来无计驻青骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大行皇太后挽词二首 其一","author":"陈师道","text":"德名三后并，母道两朝尊。\n勇决高千古，危疑定一言。\n先期还政事，隆礼改山园。\n哀挽西郊道，云愁昼亦昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山口","author":"陈师道","text":"重雾真成雨，疏帘不隔风。\n青林拥红树，家鹜杂宾鸿。\n渔屋浑环水，晴湖半落东。\n往来成一老，犹在半涂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山口","author":"陈师道","text":"湖阔疑无地，河回忽见山。\n登临聊自试，衰疾致身闲。\n四壁宁虞盗，多方莫驻颜。\n无风回远笛，有月待人还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从苏公登后楼","author":"陈师道","text":"倏作三年别，才堪一解颜。\n楼孤带清洛，林缺见巴山。\n五月池无水，千年鹤自还。\n白鸥没浩荡，爱惜鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日雪二首 其二","author":"陈师道","text":"度腊阙三白，开正还积阴。\n炊烟茅舍湿，噪雀暮枝深。\n短发千方误，中年万里心。\n成书著岩穴，或有后人寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日雪二首 其一","author":"陈师道","text":"半夜风如许，平明雪皓然。\n帘疏穿琐细，竹压更婵娟。\n窘兔走留迹，饥乌鸣乞怜。\n遥忻炎海上，还复得新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"陈师道","text":"老境难为节，寒梢未得春。\n一官兼利害，百虑孰疏亲。\n积雪无归路，扶行有醉人。\n望乡仍受岁，回首向松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元符三年七月蒙恩复除棣学喜而成诗","author":"陈师道","text":"老作诸侯客，贫为一饱谋。\n折腰真耐辱，捧檄敢轻投。\n早作千年调，中怀万斛愁。\n暮年随手尽，心事许溟鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巨野","author":"陈师道","text":"馀力唐虞后，沉人海岱西。\n不应容桀黠，宁复有青齐。\n灯火鱼成市，帆樯藕带泥。\n十年尘雾底，瞥眼怪凫鹥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王察院挽词二首 其二","author":"陈师道","text":"良贵官何与，长年死不亡。\n身须禦魑魅，气已慑豺狼。\n不尽胸中蕴，犹堪地下郎。\n岂惟吾道庆，编简亦辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王察院挽词二首 其一","author":"陈师道","text":"施报终何在，穷通共一空。\n两言成益友，百代仰高风。\n终始无遗恨，恩荣托至公。\n不应埋直气，会见吐长虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山谒外大父墓","author":"陈师道","text":"土山宛转屈苍龙，下有槃槃盖世翁。\n万木刺天元自直，丛篁侵道更须东。\n百年富贵今谁见，一代功名托至公。\n少日拊头期类我，暮年垂泪向西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]