[{"title":"杜鹃","author":"萧立之","text":"思归言语苦悲辛，啼老江南绿树春。\n莫倚巴西君故土，巴西风景近愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日","author":"萧立之","text":"野店聊为一枕谋，五更归梦入乡愁。\n溪流清浅舂锄晓，篱落荒凉络纬秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅岩","author":"程梦子","text":"进步如升百尺竿，夕阳尽我此跻攀。\n梅花落尽雨初歇，犹有馀香染碧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郊行 其四","author":"潘牥","text":"野店柴门傍水开，凭栏漱罢一裴回。\n云来岭表商量雨，峰绕溪湾物色梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊花","author":"潘牥","text":"露叶霜枝矮作团，淡黄残绿故瓓珊。\n柴门尽日无人到，独自栽花独自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁宗皇帝挽词 其二","author":"赵昀","text":"仙御宾空日，龙飞杳杳间。\n五云呈瑞綵，九虎敞重关。\n宝辇扶苍鹤，云韶拥玉班。\n千年栖佛地，今日睹天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赵昀","text":"芳意饶呈瑞，寒光助照人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花七律 其十三","author":"张道洽","text":"才有梅花便不凡，半依月涧半霜岩。\n斜攲独树疑龙卧，细啄残英笑鹤馋。\n雪里仙姿谁解写，腊前春信可容缄。\n孤山遗下十四字，千载一条冰样衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"御书阁","author":"雍沿","text":"三重神毫曼古稀，龙盘凤戏欲腾飞。\n珍藏今作古山宝，一岁中添一褐衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹤林寺 其二","author":"陈均","text":"竹绕高僧逢话处，花留仙者旧开枝。\n道身虚淡元无著，付与东风烂漫吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苕溪舟次","author":"释斯植","text":"扁舟烟重冷渔蓑，两岸人家浸小河。\n芳草自生春自老，落花随雨晚风多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"翁逢龙","text":"知君游世磨不磷，往作道人之石友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与正父叔王南运上风联句","author":"阳醇","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与阳正父阳存子上风联句","author":"王南运","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江湖伟观","author":"张蕴","text":"堤柳朝朝送酒船，一阑山色越帆烟。\n蓬莱云气东溟外，阊阖星辰北斗前。\n突兀向来无此屋，登临当日有诸贤。\n夕阳过雁慵回首，吟入关河万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺南塘得孙诗","author":"卫宗武","text":"咎消无妄福来宜，喜气津津溢秀眉。\n桂子昨方移别种，桐孙今见长新枝。\n金章鱼佩须传祖，玉果犀钱梦得儿。\n我欲去为汤饼客，却惭未赋老坡诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林弓寮归闽省觐竹溪中书往赴安溪县新任 其二","author":"释文珦","text":"别我重云里，扬舲积雨馀。\n预愁千里道，难寄一缄书。\n暂尔还溪馆，重来任石渠。\n明朝谩凝睇，舟已过桐庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛巳仲冬二日冬至孟冬晦日偶成 其二","author":"释文珦","text":"骎骎近一阳，昼短夜偏长。\n打睡工夫到，潜踪计策良。\n晓霜寒有力，冬日淡无光。\n生怕人相觅，衰翁懒下床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居 其二","author":"释文珦","text":"肯道山居太寂寥，不妨随分自逍遥。\n尽空眼界终无翳，为厌声尘亦去瓢。\n菊老尚能存正色，松孤还自有高标。\n道人乐地唯如此，说与同流意更消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠日者云谷俞喜 其二","author":"释文珦","text":"客身犹卧玲珑石，乡梦长悬岞崿山。\n詹尹自应知我意，为言何日定当还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠云英院","author":"释文珦","text":"贾岛怜无可，都缘数句诗。\n君虽是后辈，我谓过当时。\n溪浪和星动，松阴带鹤移。\n因吟到明坐，此道澹谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽径","author":"释文珦","text":"幽径任蓬蒿，衡门闭亦牢。\n驹寒宜在谷，鹤倦懒鸣皋。\n老树根流髓，重崖石长膏。\n樵童更閒静，听我读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岞崿山","author":"释文珦","text":"岞崿多奇观，人疑是假山。\n松亭藏雾黑，苔壁上云斑。\n栈阁凌空险，岩栖履石艰。\n鹤眠庭树稳，僮汲井泉悭。\n钟磬青冥上，香灯杳霭间。\n志图曾旧览，题咏未经删。\n叠嶂森南面，双溪转北湾。\n飞桥拦水断，古邑带烟閒。\n猿啸穿林远，樵声过岭峦。\n客寻清梵至，僧背夕阳还。\n我亦频来此，柴门不要关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静处","author":"释文珦","text":"常于静处著閒身，别是清虚冷澹人。\n禅里断除千种法，吟中消受一生贫。\n声名岂必存编简，林壑从来有隐沦。\n云月溪山无限景，对余一一意皆真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹居","author":"释文珦","text":"檐外竹珊珊，空房住一间。\n无人曾到此，老子有馀閒。\n土蚀铜壶缺，苔滋粉壁斑。\n于焉自成乐，遮莫笑痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访山家","author":"释文珦","text":"山翁居处僻，野屋盖茅新。\n自得烟霞趣，应无车马尘。\n怪禽啼似鬼，古木变为人。\n不是忘缘者，谁能与子亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晓寻山家","author":"释文珦","text":"石涧寒流不尽，茅檐宿雨初晴。\n幽客眠云未起，四山鸟哢春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江楼闲望怀关内亲知","author":"释文珦","text":"摇落江天欲尽秋，远鸿高送一行愁。\n音书寂绝秦云外，身世蹉跎楚水头。\n年貌暗随黄叶去，时情深付碧波流。\n风凄日冷湖光晚，驻目寒空独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"效陶秋岩韵","author":"释文珦","text":"眼前几富贵，变灭同浮烟。\n举非吾所钦，眷然思古先。\n穷达无二道，彭殇可齐年。\n中心既昭彻，万象皆澄鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次陈芸居问讯后村韵 其二","author":"胡仲弓","text":"清夜万感集，风荡云物空。\n倚楼看星斗，照破泥丸宫。\n静观人世人，颠倒醉梦中。\n佳趣有谁识，睡觉窗前红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"走笔和法石纪游","author":"胡仲弓","text":"赢得工夫卧看山，山中地步较来宽。\n苛留一段乾坤在，耐过几番风雨寒。\n吟思正浓频扫石，醉眸未豁且观澜。\n连鳌已落高人手，却是渔家欠巨竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过桐江三绝 其三","author":"胡仲弓","text":"流水高山得趣时，好音政不要人知。\n绝弦此意谁能会，未必尽因钟子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄黄云心","author":"胡仲参","text":"竹屋少行迹，闭门春昼长。\n天时半晴湿，人意共炎凉。\n苔藓侵阶绿，荼蘼压架香。\n冥搜寻杖屦，不为看花忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄梅臞","author":"胡仲参","text":"别去忽经旬，春风阅二分。\n几番吟对雨，独自暗思君。\n客里加频病，愁边骇近闻。\n倚栏商不得，心目乱于云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧山望城中遗","author":"胡仲参","text":"见说天文变，频占太史台。\n但云星犯月，不料火为灾。\n尽夜看烟灭，逢人问讯来。\n丹心勤恋阙，东向极裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城下闻夷歌","author":"陈羽","text":"犍为城下䍧牱路，空冢滩西贾客舟。\n此夜可怜江上月，夷歌铜鼓不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广陵秋夜月","author":"陈羽","text":"霜落寒空月上楼，月中歌吹满扬州。\n相看醉舞倡楼月，不觉隋家陵树秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐居","author":"陈羽","text":"稚子新能编笋笠，山妻旧解补荷衣。\n秋山隔岸清猿叫，湖水当门白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴城览古","author":"陈羽","text":"吴王旧国水烟空，香径无人兰叶红。\n春色似怜歌舞地，年年先发馆娃宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"红头紫","author":"贾似道","text":"红头紫勇敌刚强，项赤红班腿■长。\n翅紫牙湾如桑剪，此虫名号促织王。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漂泊岳阳汎舟洞庭晚宿君山与丁开联句","author":"张中行","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠老僧","author":"顾逢","text":"众僧尊夏腊，灵岳遍曾登。\n渡水手中杖，行山溪畔藤。\n心空默是印，眉白雪为棱。\n自得巡方道，栖禅老未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠僧","author":"顾逢","text":"繁华举世皆如梦，今古何人肯暂闲。\n唯有东林学禅客，白头闲坐对青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三十四","author":"谌祜","text":"风雨昼酣秦地阔，关河春梦楚云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盛开梅 其二","author":"方蒙仲","text":"十分香色十分清，摇落都从盛处生。\n物理盈虚例如此，世间何事不浮荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以诗句咏梅 孤山山下醉眠处","author":"方蒙仲","text":"佳句天所嗔，谪与水仙偶。\n樽酒酹逋翁，更道香影不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪花梅","author":"方蒙仲","text":"新样巧翻腾，淡妆尤出俗。\n说与莫轻飞，寿阳眠正熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李景异","author":"陈著","text":"剡溪千古雪坡风，收拾寒清入瓮中。\n此味世人那得吮，特将撩拨老诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元宵薇山内弟酒边五首 其五","author":"陈著","text":"一炉榾柮一镫寒，樽酒留连到夜阑。\n惟有冥心伤世变，谁开醉眼看狂澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坐凝光亭看麦","author":"陈著","text":"十日前来翠满腔，重来二麦已摇黄。\n春风亦自知艰食，日夜吹嘘早熟香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新正过沙堤","author":"陈著","text":"朝雨黄鹂静，春风暗蕊低。\n极知来令节，未肯踏深泥。\n狼藉桃无语，侵寻草满蹊。\n还闻骑马客，踯躅向沙堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"至直学士院樊伯撝家","author":"陈著","text":"远树晴堪数，孤云暝欲遮。\n自怜江海迹，能到友生家。\n落日明江色，轻风动麦花。\n相看吾鬓白，不必问年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答樊伯撝","author":"陈著","text":"直以佣为业，何妨睡作魔。\n吟诗终日少，饮酒一生多。\n坐久头鸣籁，行迟脚有鹅。\n林居三十载，一室小维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻樊桂卿初归自镜湖寄之","author":"陈著","text":"短世渊明醉，长愁子美歌。\n高情谁复尔，久别公如何。\n淡月初出浦，好风来飏蓑。\n买田沧海上，耕亦不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樊学士送菊次韵答之","author":"陈著","text":"黄菊有名花，渊明无酒官。\n酒多人自醉，花好月同看。\n老未厌人世，天教共岁寒。\n未应携不去，高步蓬莱山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答直学士院见访","author":"陈著","text":"一春烟雨暗荆扉，系马怜君共落晖。\n酒盏香风吹月桂，砚池清露滴酴醾。\n水中郭索嗔皆是，屋上慈乌爱亦非。\n天道不移人自异，红尘飞上钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答樊伯撝见拉钓","author":"陈著","text":"好共溪山结晚缘，竹枝深夜响渔椽。\n风清月朗沧溟外，鱼跃鸢飞枕几边。\n茶灶烟销回野艇，竹竿霜冷钓秋天。\n少年孟浪东西走，衰病于今耻复然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨方为桑麦说苦今日忽喜得雨","author":"陈著","text":"连日南风雨不成，今朝忽有洗檐声。\n春膏唤起地元气，仁脉流行天本情。\n桑妇惊传二叶迸，田翁痴望两歧生。\n穷阎系命皆蚕麦，最是难供急急征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵弟观晚春风雨","author":"陈著","text":"天正宜晴却又非，云顽未是放开时。\n可曾路滑官移缓，但觉山寒农务迟。\n风雨颠狂如醉汉，乾坤正大亦嬉儿。\n阴阳自有人调燮，牢闭柴门只自规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"似臧伯通","author":"陈著","text":"玉壶冰里见精神，来望芙蓉幕府新。\n放胆担当难处事，立身扶植不平人。\n公家退食门如水，淡处论交面自春。\n不是浑身皆古道，肯分一盼老山民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻丹山主僧德周欲退慈云主僧龄叟留此作","author":"陈著","text":"识破机关便出林，满天劫火可能侵。\n水流不去青山影，风与俱高白鹤心。\n物外弟昆相契合，眼中世界几浮沈。\n是知处处虚西榻，难得慈云一片阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次前韵","author":"陈著","text":"大地山河属司马，云阙岧峣都洛下。\n夕阳亭上已卖国，无与东门长啸者。\n铜驼荆榛不成春，华林转眼为樵薪。\n连墙枯骨若有声，啾啾知是清谈臣。\n中原虽远江东近，典午偏安姑莫问。\n苻坚百万捲淝波，犹有安石能强晋。\n嗟今玉辇竟蒙尘，将相受辱甘帼巾。\n求如西晋已觖望，万世遗笑无人秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苕溪晚泊","author":"程以南","text":"一笑苕溪上，微茫驻日曛。\n鹭沙行个字，鱼水呷圆纹。\n晚色三家市，秋容几树云。\n行藏知有分，莫诵北山文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"采莲曲","author":"徐集孙","text":"朝露湿妾衣，暮霞耀妾瞩。\n一叶小如瓜，去住无拘束。\n兀棹歌采菱，袭袭薰风足。\n芦叶映港清，捉对鸳鸯浴。\n莲中有苦心，欲折手还曲。\n折莲恐伤藕，藕断丝难续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余种竹方成扁其室曰竹所友人以诗至用其韵","author":"徐集孙","text":"屋老苔荒席久虚，近分一榻与云俱。\n梅花未种招蜂怨，竹所虽青欠鹤图。\n无事看山如对客，有时隐几亦忘吾。\n过门除却能吟者，不是高僧即老儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九江庾楼作 其二","author":"章采","text":"结架思梁日，登临忆汉年。\n佳游惊我老，孤思为谁牵。\n春水江湖大，夕阳天地偏。\n萋萋青草外，何处是秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十七字谣","author":"临安里人","text":"光祖做总领，许堪为节制。\n丞相要起复，援例。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笋石","author":"徐霖","text":"玉茗亭西石笋春，偶来相对作閒人。\n千年未烂应还待，化鹤叮咛日未曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔父","author":"吴锡畴","text":"笭箵尽自了生涯，岸尾沙头即是家。\n入夜醉归横短笛，满江明月浸芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋有感","author":"车若水","text":"村屋半蹲鹈鴂晚，吴江一叶鷾鸸秋。\n北边又听寒来信，近日何人万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂庄","author":"姚勉","text":"不求田二顷，只种桂为庄。\n秋满黄金粟，饱餐风露香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠天王长老无著","author":"姚勉","text":"唐有一僧妙医药，得大医王三昧觉。\n雨中盥手瀑檐飞，惊叹病龙腥唾落。\n须臾云雾忽销霁，白发老人来矍铄。\n自言病中困行雨，愿得良针苏脉络。\n授方寸剂应时愈，拜奉仙方效思邈。\n此事今无古信然，说与时人谩惊噱。\n早来忽得绢素轴，挺挺祥龙露头角。\n心知此龙非病者，喷雾洒云天洗濯。\n龙身不病泽四方，万物全生总安乐。\n此龙此医今是谁，天王长老僧无著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]