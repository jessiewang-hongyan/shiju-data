[{"title":"和原甫侍读从幸后苑观稻之什","author":"胡宿","text":"稼殿秋香熟，烟畦早景鲜。\n玉虬乘暇日，铜雀报丰年。\n压地黄云重，含风宝粒坚。\n三登繄帝力，一豫俯天田。\n幸厕标章读，仍陪从跸宣。\n赐禾知礼厚，视草觉恩偏。\n釐席思前问，经帷惜外迁。\n妙诗深雅意，王政食为先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梅尧臣宰建德","author":"胡宿","text":"县枕秋江侧，铜章滞隽旄。\n长安去日远，单父戴星劳。\n秀水遥通楫，岚峰欲妒袍。\n文弦一琴古，仙舄两凫高。\n家树喧朝鹊，乡亭寂夜獒。\n土风清是楚，才意苦于骚。\n讼少停黴索，吟多费健毫。\n平时洛中社，相忆醉含桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘学士出守衡阳","author":"胡宿","text":"需奏登中掖，除书出上台。\n兽随朝带结，隼映使旌开。\n地接朱陵近，人从藏室来。\n蠹蟫侵旧帙，浮蚁入离杯。\n岭势遥连楚，星文却视魁。\n云依苍野住，雁隔楚峰回。\n夕梦惊湘瑟，春心托陇梅。\n南方本宽教，东里复多才。\n驷马荣星驾，千金庆寿罍。\n未应嗟远守，素志在循陔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苏贤良之任豫章","author":"胡宿","text":"三道胶西策，详延俯瑞蓂。\n帝临宣室坐，人拱太微庭。\n捷思谁加点，危言自据经。\n文成洛纸贵，诏下武泥馨。\n起草分宫笔，监州驾屏星。\n心存云气阙，梦绕斧文屏。\n南国标江纪，西山占地灵。\n槛泉通水府，窗户接岩扃。\n凉月依滕阁，孤风泊孺亭。\n案书休犯虑，斋酒且忘形。\n界道宫墙紫，规蒲禁地青。\n归来开院直，鳌顶架沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刁总赴句容簿","author":"胡宿","text":"佳邑控江湄，春来赴牒归。\n波平双桨渡，日上乱莺飞。\n狎野晨耕早，蹊田昼讼稀。\n县图标地肺，家巷接乌衣。\n沼静窥珍羽，楼閒数翠微。\n山香蒸䭀熟，溪蕊摘莼肥。\n有客怀金社，因君拂玉徽。\n嵩云南去远，犹向柳依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘阅东游","author":"胡宿","text":"皋壤乏生涯，羁游越绝赊。\n一区扬子宅，四壁长卿家。\n囷粟知谁指，囊钱苦自嗟。\n秋林惊脱叶，夕枕怨啼鸦。\n海月随孤棹，天风曳落霞。\n山城饶露蔓，水驿遍霜葭。\n孝子兰方秀，先生菊未华。\n楚辕无久滞，把酒待回车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江城立春","author":"胡宿","text":"天上阳幡举，人间漏箭长。\n稍惊池面绿，初觉柳腰黄。\n迟日延三舍，条风振百昌。\n酒凝前腊味，梅带故年芳。\n雪意思王囿，云情忆帝乡。\n青门行乐处，渐近好烟光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏花钓鱼应制","author":"胡宿","text":"平圃回天仗，昆池降帝舆。\n晨葩才隐蝶，新藻复藏鱼。\n露重香英湿，风长钓线舒。\n乳莺迁谷近，朱鲔跃渊初。\n禹律铿金奏，尧樽遍石渠。\n乘时覃惠宴，不是乐观鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛夷","author":"胡宿","text":"百卉迎韶律，辛夷花最先。\n与春宜有旧，造物底无偏。\n棠棣先饶韡，山樱未敢燃。\n倚风遥可爱，犯雪不胜妍。\n影乱梅花地，香迷豆蔻天。\n红啼昨夜雨，紫妒晓来烟。\n上药能全命，灵滋合永年。\n帝家琼圃在，此物未应捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馆中同舍城西小饮","author":"胡宿","text":"信马斗城西，芳郊春渐熙。\n早烟销禁树，初溜入天池。\n桃作新正脸，梅留故腊枝。\n瓮香浮蚁日，村翳浴蚕时。\n聊把今朝臂，同伸即席眉。\n徘徊惜归驭，风晚水生漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲毕周礼诏赐御筵","author":"胡宿","text":"典礼惟周旧，经文在鲁馀。\n西清开缥帙，东面授丹书。\n访道前釐席，崇风厚石渠。\n研覃忘日旰，图绘极霞舒。\n千载逢亨际，三冬罢讲初。\n圣怀轻璧马，慈宴乐蒲鱼。\n妙技通神细，清商按曲徐。\n炉香分汉殿，鼎味出尧除。\n诸老恩同醉，孤臣艺最疏。\n至仁何以报，忠义即琼踞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁巳岁观玉皇册礼","author":"胡宿","text":"宝册尊徽号，香泥洁武都。\n斋心期太乙，恭己答元符。\n玉辂严清制，琅函秘圣谟。\n竹宫陈帝拜，嵩极动神呼。\n彩雾霏三境，祥辉烛九区。\n况当精岁出，仍与上辛俱。\n永接千龄统，长膺五老图。\n清编流景铄，礼自百王无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪竹","author":"胡宿","text":"可爱坛东竹，更笼清浅流。\n行根侵岛屿，脱箨满汀洲。\n夜迥疑筛月，风多欲战秋。\n紫茎同入画，青石伴垂钩。\n叶里藏雌翠，阴中下戏鸥。\n秦松无用笑，千亩更封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆东园","author":"胡宿","text":"越鸟恋南柯，春来怨别多。\n冷风如可御，争奈简书何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫成","author":"胡宿","text":"日醉风酣百卉开，锦鞯争跃大堤来。\n城东有客歌盆久，不敢将春上老台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斋祠小饮资政吴侍郎以真如茶二绝句为寄 其一","author":"胡宿","text":"碧城斋禁放朝元，晚饮偷消白日閒。\n天上高真潜诇得，因将瑶藻掷云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斋祠小饮资政吴侍郎以真如茶二绝句为寄 其二","author":"胡宿","text":"宝刀玉尺裁佳句，雪溜云腴试早芽。\n睡魄顿消清到骨，一成僧味似僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘开府","author":"胡宿","text":"京口刘郎是穆之，风云未作苦栖迟。\n金盘一石槟榔赠，可得当年是讳饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馆娃宫","author":"胡宿","text":"犀甲三千越骑雄，平明来袭馆娃宫。\n君王不得西施去，万户那能住甬东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自嘲","author":"胡宿","text":"雪梅连日碍层阴，昨夜银台瑞霰深。\n待诏多年无屐齿，窗间犹作洛生吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弄云亭","author":"胡宿","text":"自知无业致吾君，只向空山弄白云。\n已共此山私断定，不须转辙重移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"函谷关","author":"胡宿","text":"寂寞函关锁未开，田文车马出秦来。\n朱门不养三千客，谁谓鸡鸣得放回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤春帖子 其一","author":"胡宿","text":"三元凤历当春始，万寿龙卮进御前。\n綵胜朱幡宜此日，金枝玉叶庆新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤春帖子 其二","author":"胡宿","text":"苍玉新旂祀木神，今朝太皞始司春。\n农躔渐觉星辰正，寿历长随日月新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤春帖子 其三","author":"胡宿","text":"剪綵房中新胜出，披香殿里早春回。\n祥云更傍南山起，来对君王万寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤春帖子 其四","author":"胡宿","text":"苑中芳树条风细，天上黄衢杲日迟。\n仙果定生千岁实，祥烟长护万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤春帖子 其五","author":"胡宿","text":"春官青鸟司开启，星舍苍龙主发生。\n甘雨惠风资帝力，杏花蒲叶劝民耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤春帖子 其六","author":"胡宿","text":"玉殿香丝萦綵缕，金盆白雪间红花。\n子孙千亿无疆寿，尽逐东风入帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤春帖子 其一","author":"胡宿","text":"羲仲司旸谷，涂山佐夏王。\n六宫师俭德，四海化躬桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤春帖子 其二","author":"胡宿","text":"中禁千祥集，东方万象新。\n綵幡迎喜气，宝字镂宜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤春帖子 其三","author":"胡宿","text":"东陆韶光先四序，周南风化被群芳。\n资生万物昭坤德，嘉庆千春集紫房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤春帖子 其四","author":"胡宿","text":"东风初入长春殿，碧溜新融太液池。\n社远未当迎燕日，川晴先近浴蚕时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤春帖子 其五","author":"胡宿","text":"白绿仙云杂紫云，长生灵气护元君。\n已膺虎剑司阴教，更佩金珰奏宝文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妃閤春帖子 其一","author":"胡宿","text":"日向阴虬永，春随綵凤归。\n玉京多燕喜，金殿满光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妃閤春帖子 其二","author":"胡宿","text":"宫中玉漏迎迟日，天上珠躔丽次星。\n轩顼圣图光亿载，皇英贤范奉千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妃閤春帖子 其三","author":"胡宿","text":"音官始奏融风至，御水初传晓冻开。\n寒漏催将仙腊尽，春旂飞入贵宫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妃閤春帖子 其四","author":"胡宿","text":"剪綵平明出艺房，长生殿里百花芳。\n书衔燕子青春早，剑拂仙衣白日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤春帖子 其一","author":"胡宿","text":"綵树春芳满，仙蓂昼景长。\n早花依玉砌，初溜漾银塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤春帖子 其二","author":"胡宿","text":"浴种宜蚕事，修禖尽燕祠。\n资生迎木正，蕃衍纳春祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤春帖子 其三","author":"胡宿","text":"酿酒渟神水，延年饮露华。\n八风朝圣日，三境住仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤春帖子 其四","author":"胡宿","text":"雪晴宫树有新梅，来报东郊淑气回。\n春令先从天上起，年芳初向日边开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤春帖子 其五","author":"胡宿","text":"迎气青幡猎晓风，九门佳气郁葱葱。\n日华初在扶桑上，春色先归御柳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其一","author":"胡宿","text":"南极注生气，音官协夏钧。\n良辰五日永，景福四时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其二","author":"胡宿","text":"晓霁澄天宇，离明敞帝阍。\n灵符千福集，神印百邪奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其三","author":"胡宿","text":"刚日逢端始，炎辰属长嬴。\n君王仁且圣，慈旨却枭羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其四","author":"胡宿","text":"殿户还飙入，宫池御水凉。\n綵舟人竞渡，化国日偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其五","author":"胡宿","text":"四时乘大德，五日敞金扉。\n阳晷移南陆，天光盛紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其六","author":"胡宿","text":"商管微阴动，良辰午正端。\n三光扶圣寿，亿载奉皇欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其七","author":"胡宿","text":"三殿兹辰奉御觞，薰风梅雨好年光。\n炎天更作奇峰势，来表南山寿历长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其八","author":"胡宿","text":"后宫?鸟将雏乐，上苑安榴著子新。\n嘉节已将天合数，明离还睹日重轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其九","author":"胡宿","text":"南方炎帝本乘离，长育群生在此时。\n命缕綵花传故事，风光天上更相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其十","author":"胡宿","text":"南方朱鸟司时令，东阙苍龙护禁扉。\n万寿御觞端日举，祥风三殿绕云旂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其十一","author":"胡宿","text":"九霄嘉节重端辰，命缕灵符粲宝文。\n虞舜无为心自正，五弦琴上奏南薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇帝閤端午帖子 其十二","author":"胡宿","text":"宝岐麦色黄云重，御苑榴花丹焰深。\n已显丰年资帝力，更凭佳节悦天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其一","author":"胡宿","text":"川馆亲蚕后，宫房献茧初。\n香缯争点画，綵缕竞垂舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其二","author":"胡宿","text":"楝叶迎新候，菖花发美祥。\n忧勤宣内则，嘉宴助时阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其三","author":"胡宿","text":"灵艾传芳远，仙蓂吐叶新。\n配乾资厚德，介祉集嘉辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其四","author":"胡宿","text":"星火朱光炽，缯丝采物华。\n欢谣宜圣日，王气协皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其五","author":"胡宿","text":"紫禁端辰昼漏长，朱陵生气盛南方。\n长秋此日司阴教，皇极同时纳寿皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其六","author":"胡宿","text":"寿觞百福融甘露，宝索千祥镂彩云。\n五日永逢佳令节，亿年长奉睿明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其七","author":"胡宿","text":"香炉角黍传三楚，丹篆灵符辟五兵。\n更有龟台仙药在，河洲贤德保长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其八","author":"胡宿","text":"灵苗远采三山药，仙篆高飞六甲符。\n此日万神同翼卫，长秋洪算与乾俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其九","author":"胡宿","text":"蕤宾干气盛炎方，坤德资生茂百昌。\n西域葡萄初蔓衍，成周瓜瓞更绵长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇后閤端午帖子 其十","author":"胡宿","text":"楚粽雕盘九子香，綵丝朱索更迎祥。\n坤元此日扶皇极，伟兆先时协寿房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其一","author":"胡宿","text":"五丝通遗问，百草斗输赢。\n神印能袪恶，灵符解辟兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其二","author":"胡宿","text":"天家饶物采，华节有光辉。\n明月裁歌扇，轻霞剪舞衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其三","author":"胡宿","text":"禁苑年光丽，端辰物象华。\n天风结桃实，火德盛榴花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其四","author":"胡宿","text":"莲叶抽芳际，榴房结子初。\n长年斗百草，旧俗祭三闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其五","author":"胡宿","text":"广殿回雕辇，沧池漾綵舟。\n尧心顺时令，不是重嬉游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其六","author":"胡宿","text":"鱼龙曼衍夸宫戏，湘虙浮沈衒水嬉。\n齐上圣皇千万寿，飘然仙乐在瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其七","author":"胡宿","text":"故事顺时羞角黍，旧仪乘节浴兰汤。\n人间凉麦欣时豫，天上薰风爱日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其八","author":"胡宿","text":"续命由来宜綵缕，辟邪相向佩灵符。\n夏钧调乐长生酒，岁岁宫中祝圣图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其九","author":"胡宿","text":"宫中应节垂金缕，天上迎祥捧玉卮。\n更奏开元羽衣曲，年年长愿侍瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人閤端午帖子 其十","author":"胡宿","text":"彩艾相传禳故气，香茅竞爱结灵芳。\n炎洲正觉仙游盛，化国偏知日景长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]