[{"title":"句 其二","author":"方丰之","text":"老夫六贼销磨尽，时为幽香一败禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"方丰之","text":"白是盐埕青是麦，谁云斥卤不堪田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"方丰之","text":"魂梦无金印，生涯有瓦盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"方丰之","text":"汉室虽然和冒顿，贾生终愿系单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江都燕","author":"释正宗","text":"荒城春色里，花溅泪潺湲。\n社燕归无屋，营巢寄客船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观孙司户画壁","author":"释正宗","text":"若人胸次闲，能容书四库。\n馀地著山川，得酒欲飞去。\n摩挲雪色壁，吐作无声句。\n寒屯水际云，瘦立烟中树。\n虽非桃花源，亦自有佳处。\n未休蜗角兵，欲问樵苏路。\n只恐山中人，笑我来何暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蔡坚老秋日登拟岘台","author":"释正宗","text":"秋容淡薄晚烟孤，千里谁开水墨图。\n欲借扁舟乘兴去，卧看月影弄风蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山寺晚归","author":"释正宗","text":"登临兴未尽，落日苦催归。\n扶持出门去，山寒露湿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招福寺作","author":"释正宗","text":"自顾不材同社栎，乘流得坎便为家。\n体中不快思读易，睡思欲来还煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"捲烟阁","author":"释显万","text":"僧屋数椽巢木末，风烟日与翠俱浮。\n自无俗物败人意，况有春江拍岸流。\n艇子得鱼归别浦，凫雏傍母睡芳洲。\n夜晴兔月摩云角，翻作广寒宫殿秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送炭与湘山西堂惠然师","author":"释显万","text":"纷纷向火乞儿多，独有君如择乳鹅。\n万煅炉中寻粲可，一堆灰里拔阴何。\n雪欺败屋闲犀柄，草卧空庭任雀罗。\n亟送乌薪相暖热，恐随春梦入南柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别鹤操","author":"释显万","text":"三山邈何许，烟雾如海深。\n两鹤翅相接，意欲栖瑶林。\n惊风起中路，沙尘扬夕阴。\n哀鸣失俦侣，俯啄何苦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓发山店","author":"释显万","text":"蓐食小人家，寒灯碎落花。\n鸡鸣窗半晓，路暗月西斜。\n世故欺怀抱，风霜迫岁华。\n剧怜诗思苦，悽恻向长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次乔口","author":"释显万","text":"乔口知名久，烟沈水国寒。\n受风帆腹饱，歇雨橹脐乾。\n五渚源流异，长沙气象宽。\n山川济吾胜，待月倚墙竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明溪","author":"释显万","text":"夏木藏崖坞，晴沙抱柳溪。\n茅茨村远近，陇亩路东西。\n野老连樯语，山禽隔竹啼。\n此中风物美，吾欲卜幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日不出","author":"释显万","text":"坐意湘西野客家，诗筒茶灶旧生涯。\n痴云阁雨山腰重，老树冲波岸脚斜。\n避缴冲芦怜雁阵，采花酿蜜厌蜂衙。\n故溪幸可浮茅屋，归听崖翁响钓车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谩兴","author":"释显万","text":"雨沈飞絮绿阴寒，梅子枝头点点酸。\n心事向来吟不尽，梨花院落一春残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日","author":"释显万","text":"窗外晴山竹半遮，竹根流水细鸣沙。\n小园寂寞春无赖，蝴蝶飞来绕菜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庵中自题","author":"释显万","text":"万松岭上一间屋，老僧半间云半间。\n三更云去作行雨，回头方羡老僧闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"义帝陵","author":"释显万","text":"祖龙智昏日月蚀，南公力欲麒麟斗。\n楚虽三户必亡秦，盛德宜然有其后。\n鲁公违约火咸阳，咄嗟击出群雄右。\n豆分瓜剖听指颐，忍使黥徒贼孤幼。\n籍也狐埋狐搰之，项伯宁不为家寇。\n真人如龙翔霸上，缟袒长风起襟袖。\n终据皇图岂力为，雅张赤帜皆天授。\n可怜郴北东上坟，恨碧凄红春不茂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏仙宅","author":"释显万","text":"苏君善养志，以孝格神明。\n一朝蜕尘鞅，通籍赤霞城。\n相看疑梦寐，去若鹅毛轻。\n玉笙堕哀响，烟髦错霓旌。\n丹井愈沈屙，橘叶通仙灵。\n至今华屋底，想像双眉青。\n云装挹飞袖，蕊佩敲风鸣。\n兹事既茫邈，无阶接蓬瀛。\n掬月漱吟齿，餐霞寿颓龄。\n蕴真思远托，何从保长生。\n汉武梓棺朽，秦皇鲍鱼腥。\n空山鹤未归，花发春冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郴阳道中二首 其一","author":"释显万","text":"草荒驿路欲迷人，未见梅花信息真。\n意著旧家烟雨外，犯寒斜放竹篱春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郴阳道中二首 其二","author":"释显万","text":"晓村寒水碧悠悠，雨歇浮云漫不收。\n且缓晨炊三十里，不妨亭午到郴州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"释显万","text":"雨叶工惊梦，春心巧卷愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"释显万","text":"探枝春色墙头朵，阑入风光竹外梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"释显万","text":"河横星斗三更后，月过梧桐一丈高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题独秀山","author":"沈晦","text":"老鹤下遥天，昂昂在林表。\n霜毛临野人，逸气秋天杳。\n矫矫颜始安，不受冠带绕。\n清真自嵇阮，一醉万事了。\n读书空谷中，生刍白驹皎。\n长哦五君咏，极目送飞鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹溪","author":"沈晦","text":"寒流穿清閟，支径入翠微。\n山深古木合，林静珍禽飞。\n居人本避世，游客亦忘机。\n归路晚烟暝，新月照柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游松阳百仞山","author":"沈晦","text":"山头白云如擘絮，竹鸡无声鸠唤妇。\n团团朝日在林梢，寒日梨花溪口路。\n一峰独秀横溪阴，青林倒影千丈深。\n上有白龙蛰幽洞，岁旱往往能为霖。\n如今寂寞空山里，古屋荒坛冷红紫。\n会看前度种花人，他年来作巢居子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹山?岭","author":"沈晦","text":"九月乱山中，崎岖处处同。\n溪流因雨涨，木叶着霜红。\n人迹千岩绝，松声万壑空。\n寻幽自可问，不复欢途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松阳上方山居五首 其一","author":"沈晦","text":"月馀树影穿窗入，雨过山泉绕舍鸣。\n野寺中宵人不睡，蒲团布衲悟无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松阳上方山居五首 其二","author":"沈晦","text":"山中寒早野阴薄，惨惨黄昏欲雨时。\n市远无人与沽酒，地炉松火自烧梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松阳上方山居五首 其三","author":"沈晦","text":"天畔群峰一草亭，半溪烟雨花冥冥。\n老翁投老得此景，日与溪山同醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松阳上方山居五首 其四","author":"沈晦","text":"此生真与世相忘，投老生涯寄上方。\n洗足关门枕书睡，连山松桧雨浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松阳上方山居五首 其五","author":"沈晦","text":"学道空山水月深，丹成初试马蹄金。\n犹馀一勺丹泉水，洗尽人间名利心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侍先人游石桥","author":"沈晦","text":"一别台山四十年，石桥风景尚依然。\n慈颜不见身空老，感恨多如涧底泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题紫岩寺 其一","author":"沈晦","text":"松岭枫冈势接连，梵宫危傍紫岩前。\n夜深钟磬敲清月，日暮楼台锁淡烟。\n大抵登临须有分，不因迁谪到无缘。\n一程已见佳山水，何惮东川路五千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题紫岩寺 其二","author":"沈晦","text":"为爱溪山著意寻，因行每每便登临。\n寒窗夜久陪僧话，一阵西风月满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"沈晦","text":"五岭炎蒸地，从来着逐臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观水磨牌文有省","author":"释法忠","text":"转大法轮，目前包裹。\n更问如何，水推石磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"讽死心禅师","author":"释法忠","text":"莫怪狂僧骂死心，死心结夏破丛林。\n丛林明眼如相委，此话须教播古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示寂颂","author":"释法忠","text":"六十六年，游梦幻中。\n浩歌归去，撒手长空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其一","author":"释法忠","text":"张公吃酒李公醉，子细思量不思议。\n李公醉醒问张公，恰使张公无好气。\n无好气，不如归家且打睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其二","author":"释法忠","text":"今朝正月半，有事为君断。\n切忌两眼睛，被他灯火换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其一","author":"释法忠","text":"秤锤落井，只有秤衡。\n两两相忆，分物不平。\n方始取出乎锤，忽又失却秤衡。\n始去邻家借觅，衡上不曾钉星。\n休休，重者从他重，轻者从他轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释法忠","text":"柳恽江头赏白蘋，小风吹处晓烟轻。\n渔翁坐钓秋亭月，翻忆苕溪说性情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三首 其三","author":"释法忠","text":"二月春光景气浮，少年公子御街游。\n银床踞坐倾杯乐，三个孩童打马毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释法忠","text":"马驹蹴踏非驴事，要使儿孙脚下行。\n三日耳聋犹可怪，谩劳灼卜听虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释法忠","text":"谛观五百生前事，不昧何如不落亲。\n因果历然殊可怕，人人尽道野狐精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释法忠","text":"展开两手当时说，大义流通满世间。\n莫谓入荒田不拣，而今到处草漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释法忠","text":"曾到不曾到，且吃一杯茶。\n待客只如此，冷淡是僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万象亭","author":"富直柔","text":"堂后山川面面通，向来奇观有蒿蓬。\n元戎小试经纶手，万象都归指顾中。\n雨罢捲帘凭爽气，酒酣极目送飞鸿。\n明年凤阁鸾台上，好寄新诗下北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句 其一","author":"富直柔","text":"青衫短簿汝阳天，鹗牍当时误荐贤。\n承乏西枢了无补，还依丈席听韦编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句 其二","author":"富直柔","text":"洛陈花骨巧裁诗，曾把梅篇为玉墀。\n未说他年调鼎事，只今身已凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句 其三","author":"富直柔","text":"陈君谈论席生风，段子文词气吐虹。\n参朮膎胰皆入箧，知人谁过葛仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其一","author":"释法一","text":"衲僧正法眼，照破铁围山。\n四方并八面，尖角更团圞。\n双椎轰法鼓，一击透玄关。\n乾坤收不得，留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其二","author":"释法一","text":"仰面不见天，低头不见地。\n古剑髑髅前，大海波涛沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其三","author":"释法一","text":"今年七十五，归作庵中主。\n珍重观世音，泥蛇吞石虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释法一","text":"世尊只眼通三界，外道双眸贯五天。\n华意正浓桃脸笑，春光不在柳梢边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释法一","text":"背触人难会，凭君子细看。\n片云才出洞，遮却面前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白云洞","author":"王延轨","text":"早向珠囊见，今亲历洞门。\n削成青玉壁，擘破白云根。\n冷射筇□色，浓□古藓痕。\n坐来肌骨爽，□□湿琴樽。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅","author":"董贞元","text":"谀佞盈廷不可闻，那堪世事日侵寻。\n三槐九棘浮云外，一树寒梅寄我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次宋居卿韵寄题灵岩","author":"刘公度","text":"十里灵岩翠路阴，当时登陟到云林。\n佛衣化铁存真迹，锡杖流泉慰渴心。\n山拥精蓝多胜概，松含清籁少繁音。\n归来每厌红尘扰，梦寐犹能去远寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"抱元观","author":"刘希真","text":"龙冈十里秀蟠云，天斲灵墟馆异人。\n柳眼长年驻春色，金精一掬吐寒津。\n田公羽驾随飙远，长史琅函得语真。\n今日我来师接否，半窗飞雪话蒙屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"孟长文","text":"世事无穷贫不尽，人生有著到思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"王仲嶷","text":"白发衰天癸，丹砂养地丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"王仲嶷","text":"老境得为丘壑伴，醉乡还胜子孙扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长安上元","author":"贾宗谅","text":"雍国唯今夜，通衢嘉致新。\n朱楼万家月，芳树一城春。\n远近笙簧韵，往来车马尘。\n星移天欲晓，犹有未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渝南寒食","author":"贾宗谅","text":"异地逢寒食，客情谁与俦。\n心摇陇云下，身寄楚江头。\n落絮丝丝恨，飞花片片愁。\n东风似相念，终日倚扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夜阳口舟中","author":"贾宗谅","text":"一年节律今还尽，犹向天涯寄客舟。\n巫舍箫竽喧竹坞，渔家灯火傍沙洲。\n殷勤共敬新桃醒，弃废堪嗟旧历头。\n守岁通宵欲无寐，煎茶几啜渌瓷瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐云阁","author":"何诚孺","text":"巍阁壮兮翚飞，跳嶕峣兮云齐。\n缓步于斯兮仰者睥睨，青天不远兮尺五其几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登九疑齐云阁","author":"何诚孺","text":"齐□巍阁压山颠，下视冈陵尽窅然。\n岂并奇峰当盛夏，几因呈瑞类非烟。\n夜深星斗垂檐畔，雨霁虹蜺挂□边。\n从此青天平步上，城南尺五更谁□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又一章十二句用臧德次禅老□","author":"何诚孺","text":"□名□事取齐云，挺特孤高似法身。\n永镇洞天□□□，直□画栋□神□。\n□□易见千般态，□□□留一点尘。\n衲帔□须□□□，□□□□□□□。\n□□□道□□得，□□□□□□□。\n□□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"安时","text":"仙骨留来不记春，仙岩石欲化为尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅仙馆","author":"朱粹","text":"书投北阙言无用，吏隐南昌寄此间。\n身陟九霄归紫府，名垂千古寄青山。\n夜坛星斗谁瞻仰，晓殿云烟自往还。\n几叠高峰人罕到，分明真境异尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]