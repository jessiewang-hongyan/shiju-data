[{"title":"九日无酒","author":"喻良能","text":"年年把酒对黄花，一任西风醉帽斜。\n今日无钱还对菊，不知何处酒堪赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日无酒仍不见菊唯岩桂一瓶伴此岑寂","author":"喻良能","text":"白衣不至酒难赊，兀坐晴窗独饮茶。\n今日重阳对岩桂，昔年百本看黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日鞫狱茶山广教院遣兴一绝","author":"喻良能","text":"牧之秋浦峰头饮，王勃南昌阁上吟。\n千古胜游谁复继，只今重九欠登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月八日次韵沈虞卿一首","author":"喻良能","text":"白发苍颜会帝乡，微云淡雨小重阳。\n一樽相属非无意，欲搅胸中书传香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九曲溪 其一","author":"喻良能","text":"扁舟一叶破涟漪，九曲穷时山更奇。\n唤取谪仙来著句，平章佳处要清诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九曲溪 其二","author":"喻良能","text":"十年来往大江东，每为青山引兴浓。\n自到此山寻绝境，悔看五老九华峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十八日周提宫叶致政楼司理过访锦园 其一","author":"喻良能","text":"锦园春色满西东，一笑相欢四老翁。\n八秩总开三百岁，乐天风味此时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十八日周提宫叶致政楼司理过访锦园 其二","author":"喻良能","text":"锦园不减商山乐，四皓中间著此翁。\n今日可无千字作，何人似此一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日道中口占 其二","author":"喻良能","text":"竹篱茆舍水边家，窗牖虚明小径斜。\n草色未多春意好，疏梅映竹两三花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日道中口占 其一","author":"喻良能","text":"初日轻烟溪上桥，远峰积雪未全消。\n东君也是多情思，先遣春光到柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十八日观潮 其一","author":"喻良能","text":"万叠银山出海门，百川渺渺不劳吞。\n晴江斗起黏天浪，一洗忠胥愤屈魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十八日观潮 其二","author":"喻良能","text":"谁遣群儿把綵幡，翩翩惊浪怒涛间。\n不知岸上人皆愕，但觉波心意自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十四日陪同年十有六人游净慈遂饮于水月居坐中即事 其二","author":"喻良能","text":"崇桃秾李亦不恶，一笑海棠尤可人。\n徐熙赵昌俱骨朽，翠袖捲绡谁写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月六日清明节道中","author":"喻良能","text":"清明时候雨初足，白花满山明似玉。\n十里春风睡眼中，小桃飘尽馀新绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳郡宴即事","author":"喻良能","text":"细雨轻阴修禊天，海棠睡足柳初眠。\n凝香帘幕东风煖，小醉清吟锦瑟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上叶参政二绝 其二","author":"喻良能","text":"前世莱公今复见，后身文正更何疑。\n君臣相得同鱼水，剩把勋名镇四陲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上叶参政二绝 其一","author":"喻良能","text":"密幄从容仅五旬，趣专大政转洪钧。\n熙朝未有金华相，创筑沙堤第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上清","author":"喻良能","text":"积雨新晴翠霭浮，好风掖我上清游。\n白头捧檄真聊尔，那忍深文学杜周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小山","author":"喻良能","text":"峰秀因拳石，溪清见发鱼。\n毫釐辨乔梓，咫尺有匡庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丐外得括苍东归侍次 其二","author":"喻良能","text":"十年长客帝王都，五亩田园半欲芜。\n乞得此身犹未老，自摇小艇钓平湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丐外得括苍东归侍次 其一","author":"喻良能","text":"一家满载扁舟里，两桨春风去似飞。\n渐识路人乡树出，世间乐事莫如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书红香堂壁","author":"喻良能","text":"瓦影鳞鳞荫曲塘，疏帘不下纵荷香。\n绿波乍识红妆面，未忍轻将比六郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云锦阁","author":"喻良能","text":"岩花乱落随春水，万丈轻红绕驿楼。\n不是江流似云锦，政应云锦似江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仆不饮久矣今日过宋嗣宗且谈且饮不觉沾醉","author":"喻良能","text":"年来饮酒不濡唇，蘸甲今朝始为君。\n颇似昌黎当日语，人皆劝我若无闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日追次东坡和子由省宿致斋韵","author":"喻良能","text":"五十之年又过三，依然白发照青衫。\n年来大起山林兴，任达从教笑阮咸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十日偕夏卿兄季野孟明仲文季直弟游香山因得小诗书僧堂壁","author":"喻良能","text":"夏木阴阴翠竹疏，相携萧寺馔伊蒲。\n他年细味禅房句，便是香山六老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天申节明庆寺启建","author":"喻良能","text":"两鬓萧萧华发生，欲寻江上白鸥盟。\n皇恩却许陪鹓鹭，重听景阳钟鼓声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少微阁","author":"喻良能","text":"临空瞰阔俯清溪，阁占黄堂西复西。\n我昔曾攀郎宿近，只今人指二星齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文举司理以鸂鶒一双见遗作诗为谢","author":"喻良能","text":"五采斓斑好毛羽，金沙石砾映毰毸。\n我无御史西台望，安用一双鸂鶒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方池","author":"喻良能","text":"四角朱弦直，双桥小霓攲。\n寒星夜稀密，冷浸一枰棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月台","author":"喻良能","text":"青林阙处绿阴开，十里长风送月来。\n妒雨玩云都净尽，素华清影巧裴徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水乐洞","author":"喻良能","text":"近听千丝急，遥闻一磬清。\n恐伤诗肺腑，不作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙隐观费长房故宅旧名灵阳宫观后有葛陂盖竹杖化龙处也","author":"喻良能","text":"松风百步到灵阳，千古风流忆长房。\n竹杖化龙无处觅，空馀陂水绕堤长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北山登高","author":"喻良能","text":"九日红茱紫菊催，相携缓步上飞来。\n酒酣便有龙山趣，不用重寻戏马台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去岁十月六日由番江向安仁今岁十月回自广信复以是日同王蓝田诸公登安仁张古峰","author":"喻良能","text":"去岁兹晨离楚东，今年飞盖上晴空。\n烟云晻霭江天暮，一笑都如梦寐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平远台","author":"喻良能","text":"平远台高俯翠微，海天烟雨正霏霏。\n登临何处明人眼，乌石山前白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永祐陵 其三","author":"喻良能","text":"小臣生长宣和初，深仁浃髓沦肌肤。\n只今白首冯唐似，何幸清斋拜鼎湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永祐陵 其一","author":"喻良能","text":"乘骑导从朝陵日，漫山桃李花如织。\n好风吹散半空云，丽日放将新霁色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"永祐陵 其二","author":"喻良能","text":"森然一径趋高爽，郁葱佳气遥相望。\n松声万壑奏笙竽，山形千叠开屏障。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石扶山","author":"喻良能","text":"玲珑怪石巧相扶，奇绝无人作画图。\n要是飞来嫡孙行，恨君生不近西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石洞","author":"喻良能","text":"此秘昔未睹，斲云今始开。\n苍松临怪石，宜号小飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石钟山","author":"喻良能","text":"坡翁文字妙来今，仙去遗踪杳莫寻。\n惟有石钟还好在，未须霜降自清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石塘","author":"喻良能","text":"野色知何处，松边竹外塘。\n雨馀红菡净，风起白蘋香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞廨之后正瞰城城上有古木十数株盛夏五六月清风徐来萧然有山林之趣尝诵陈后山城荒可当山之句欲作亭对之榜曰当山而三岁之间十捧差檄三摄剧邑猝猝未能也今且去矣乃留诗壁间庶几后之君子会有成吾之志者","author":"喻良能","text":"地静城荒可当山，士衡瓦屋两三间。\n作亭领略吾何暇，留待来贤涉笔间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园四咏 其一 亦好亭","author":"喻良能","text":"亦好新亭小，登临意绪长。\n清流依槛曲，明月逐檐方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园四咏 其三 钓矶","author":"喻良能","text":"只为贪赪鲤，还应爱碧流。\n风来花落饵，云破月沈钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园四咏 其四 菊径","author":"喻良能","text":"小径三秋好，西风百本黄。\n但令频泛酒，日日是重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园四咏 其二 磬湖","author":"喻良能","text":"未用他山错，宁须泗水浮。\n冲风时激浪，清韵乱鸣球。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园初春次韵 其一","author":"喻良能","text":"梅开群玉府，柳试缕金衣。\n过腊山逾瘦，迎风水渐肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园初春次韵 其二","author":"喻良能","text":"初日宜征辔，轻寒怯裌衣。\n蟹黄经雨润，鸭绿得春肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园海红黄香梅著子戏成小诗","author":"喻良能","text":"一枝浓艳倚东风，千叶轻黄点翠丛。\n占得娉婷仍结子，故应花果谱兼通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园菊花盛开为赋二绝 其二","author":"喻良能","text":"穷秋篱落日萧萧，浅笑临风画亦劳。\n彻骨清寒香未了，落英犹更入离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好园菊花盛开为赋二绝 其一","author":"喻良能","text":"风厉霜严了不知，晚来幽独更多姿。\n纶巾细漉柴桑酒，坐对疏篱却始宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亦好亭独坐","author":"喻良能","text":"亭上横看十六峰，峰头烟霭碧连空。\n不须更作游山计，坐遣诗情落酒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任公钓台","author":"喻良能","text":"任公垂钓古来称，千载危台尚可登。\n尺泽只今无处觅，悬知深谷解为陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好溪堂","author":"喻良能","text":"好溪无复怒涛粗，缭绿萦青秀色腴。\n更著华堂临绝境，风流长与岘山俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"州宅","author":"喻良能","text":"势压江峦栋宇雄，使君如在广寒宫。\n微之政以江山助，千首诗成咳唾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏书案上江梅水仙","author":"喻良能","text":"偷将行雨瑶姬佩，招得凌波仙子魂。\n幽韵清香两奇绝，小窗斜月伴黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扫室","author":"喻良能","text":"凝尘昼满室，燕处亦超然。\n扫罢掩关卧，从嘲边孝先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曲水","author":"喻良能","text":"不是山阴画，清流曲更方。\n欲知三面景，绝胜九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王状元晚菊二绝 其一","author":"喻良能","text":"虽晚亦既好，花中无此香。\n谁能识真趣，高隐在浔阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王状元晚菊二绝 其二","author":"喻良能","text":"并与杞同赋，旧尝闻雪堂。\n先生澹无欲，亦复爱清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次槐卿舅咏梅二绝 其一","author":"喻良能","text":"玉肌冰骨不多枝，半映清池半近篱。\n寒雪尚迟新月早，横斜分影到涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次槐卿舅咏梅二绝 其二","author":"喻良能","text":"朔风寒日澹孤芳，冰雪相看有暗香。\n但得横枝临却月，不须斗酒博西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵丁端叔舟中值雪三绝 其一","author":"喻良能","text":"轻舞谢衣端不恶，斜侵潘鬓总堪惊。\n偶思功业聊看镜，自怪年来太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵丁端叔舟中值雪三绝 其二","author":"喻良能","text":"但知才出吴公右，孰识诗堪子建亲。\n不惜剩吟黄竹句，何妨传示白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵丁端叔舟中值雪三绝 其三","author":"喻良能","text":"延和初奏三千牍，畿甸旋移尺五天。\n风格出尘谁可并，争看辽鹤一千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马驹父晚菊五绝 其四","author":"喻良能","text":"不知香靥为谁开，衫染鹅黄巧剪裁。\n但得目成兼色授，何妨顷刻耻樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马驹父晚菊五绝 其二","author":"喻良能","text":"开及梅花未发时，那愁三弄有桓伊。\n何时栗里东篱下，冷蕊寒英伴酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马驹父晚菊五绝 其一","author":"喻良能","text":"朔风吹冷破檀心，浥露匀铺琐碎金。\n喜见鲜鲜长踊跃，只应吏部独知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马驹父晚菊五绝 其三","author":"喻良能","text":"嫩黄初破未凋残，风露相禁晓色寒。\n欲并墨梅兼墨竹，何人为作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马驹父晚菊五绝 其五","author":"喻良能","text":"雾幌褰开秀色明，曲尘半臂亦多情。\n芳菲不拟亲桃姊，萧洒端宜齿石兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制初见虎牙铜柱诗","author":"喻良能","text":"千骑远征夔子国，百篇还赋杜陵诗。\n虎牙突兀撑空出，恰似云开衡岳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其十一","author":"喻良能","text":"腐儒诗胆大于身，所恨陈言老未新。\n何日小舟江上去，一杯聊酹笔端神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其一","author":"喻良能","text":"吞舟尺泽岂能容，此地谁知著卧龙。\n当日春风生笔底，至今山色十分浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其八","author":"喻良能","text":"笔下无非幼妇辞，胸中端拟效安期。\n我生只许拜遗像，不见先生无恙时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其九","author":"喻良能","text":"先生仙去几经年，赤壁依然浪接天。\n去棹来舟相指示，曾游元祐玉堂贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]