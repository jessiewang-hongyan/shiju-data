[{"title":"小立","author":"王同祖","text":"小立危楼望眼遥，晚烟淡处见湖桥。\n梅花落尽寒犹力，留得东风候柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日 其二","author":"王同祖","text":"云集衣冠拜紫宸，榻前除目报来真。\n君恩先到宫门柳，占得人间第一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内前 其一","author":"王同祖","text":"两桁垂杨护九重，翠眉羞画旧隋宫。\n柔条似怕君恩重，低拂朱栏舞晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内前 其二","author":"王同祖","text":"丽正门开晓色鲜，万丝绿柳御沟边。\n禁中恐有题红怨，不放涓流出内前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午窗","author":"王同祖","text":"破午幽禽惊客梦，隔窗疏雨唤离愁。\n浮云得丧知何益，早悟庄周蝶梦休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天津桥","author":"王同祖","text":"行阙千重锁暮烟，山如洛邑水如瀍。\n黄尘障断中原路，忍立桥头听杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太乙宫即事 其二","author":"王同祖","text":"绿阴密处著危亭，佳气葱葱王武林。\n一片红尘飞不入，杜鹃啼处白云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太乙宫即事 其一","author":"王同祖","text":"金殿重重昼不开，盘窠苍柏两行栽。\n角门东畔瞻宸几，仙仗曾迎翠辇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日金陵制幕书事 其二","author":"王同祖","text":"官军闻说定庐州，破虏功成一滴油。\n智勇功名付元凯，王三锡命到康侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日金陵制幕书事 其五","author":"王同祖","text":"三五同寮出幕迟，公馀终日意怡怡。\n归来又被梅花恼，拨冗铜彝插数枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日金陵制幕书事 其四","author":"王同祖","text":"薄晚官军得胜归，家家户户挂旌旗。\n阵前纪律明于日，师入城来半不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日金陵制幕书事 其一","author":"王同祖","text":"督制堂堂两重臣，驻师移府夹江滨。\n资粮屝屦多多办，更有舟车乞与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日金陵制幕书事 其三","author":"王同祖","text":"城中守将方投死，阵面将军已卖降。\n版筑纷纷成底事，那知靠后是长江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚杂兴 其三","author":"王同祖","text":"雨雪霏霏岁又除，鲤庭目断数行书。\n销金帐下羊羔酒，便学粗人也不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚杂兴 其一","author":"王同祖","text":"拨尽寒灰恨转添，不知片雪点疏帘。\n梅花帐冷炉烟歇，架上黄庭信手拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚杂兴 其二","author":"王同祖","text":"时势危棋局转低，丈夫有志竟何为。\n优游输与田家乐，问著朝廷事不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观雨","author":"王同祖","text":"萧萧疏雨逐斜风，三两归鸦暮霭中。\n看到菊花无可看，一年秋事又成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观锡宴宣劝","author":"王同祖","text":"中使传宣内里来，辅臣拜饮九霞杯。\n君王万岁三边静，寿域先从塞北开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阴夕","author":"王同祖","text":"恰则晴明天又阴，霜风如剑二毛侵。\n淮城夜雪深多少，不见擒吴奏捷音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严陵舟中","author":"王同祖","text":"万水千山霁色新，临风一苇捷于神。\n羊裘滩下休停棹，闻说狂奴解笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋","author":"王同祖","text":"晚趁凉飔上小楼，忽看梧叶始惊秋。\n悲怀无奈狂风雨，数尽归鸦懒转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时事感怀 其一","author":"王同祖","text":"壮心如铁气填膺，万里中原尚虏尘。\n一枕西风两行泪，封疆谁是死绥人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时事感怀 其三","author":"王同祖","text":"襄州蹀血荆州乱，千里金汤狐兔凭。\n未定樊城关羽死，汉民何日见中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时事感怀 其二","author":"王同祖","text":"羽书昨夜下长安，胡骑骎骎犯蜀关。\n愁杀闺中年少妇，朝朝空望戍夫还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时事感怀 其四","author":"王同祖","text":"蜀又交侵淮又危，江湖风浪沸潢池。\n连朝云气浓于墨，想是英雄血战时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京口","author":"王同祖","text":"晚风来候过淮舟，闲上南徐多景楼。\n落日寒城伴荒草，江南人指是瓜洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京城元夕","author":"王同祖","text":"鼓吹喧喧月色新，天街灯火夜通晨。\n玉皇不赐传柑宴，散与千门万户春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐 其一","author":"王同祖","text":"独对寒灯客梦孤，数声征雁下平芜。\n古今多少难言事，笑指梅花解语无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜步内门","author":"王同祖","text":"静夜孤灯人未眠，等闲行过内门前。\n一声唱彻连珠喏，碧月朱栏绿柳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庙山道中","author":"王同祖","text":"萧萧疏雨点孤蓬，舟子招呼语顺风。\n小麦青青春恰半，一犁江上看田翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 内前","author":"王同祖","text":"青帷朱簴柳阴旁，玉磬金钟列两行。\n辇路旋添泥细细，鸡竿揭处瑞云黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 天街夜步","author":"王同祖","text":"风不停云月更清，千门绣幕笑歌声。\n御营巡检无拘束，走马天街夜达明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 车驾回太庙","author":"王同祖","text":"瑞霭祥云傍晓开，九重法驾太宫回。\n一声静跸千官肃，卫士传呼御座来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 车驾宿太庙","author":"王同祖","text":"金甲重矛两内臣，阶前对立气英英。\n巡更场内知谁问，听得传呼宰相名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 其二 回龙桥望驾","author":"王同祖","text":"两行卫士锦宫袍，万岁声长彻九皋。\n过尽羽旄风细细，彩云不动御炉高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 其一 回龙桥望驾","author":"王同祖","text":"回龙桥上望龙颜，毅采英英仰视难。\n须信吾皇自神武，何忧中国不尊安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 其二 观景灵宫恭谢","author":"王同祖","text":"膳羞进彻静无哗，宰执斋宫坐赐茶。\n不比常朝添覆奏，报来除目十馀家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 和宁门观驾","author":"王同祖","text":"星斗中天夜向晨，寸云不点月华明。\n六飞过尽灯如昼，宫漏迟迟报五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 尚书省观涖誓","author":"王同祖","text":"中辛㫝吉建斋坛，宰相前期誓百官。\n尊祖敬宗天子孝，仪文莫作等闲看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 肆赦","author":"王同祖","text":"九重夙夜畏天威，何事晴明一夕非。\n不放明堂大朝贺，尽抛坊乐独行归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 其一 端门观习肆赦仪","author":"王同祖","text":"百官常服拱端门，丹凤衔书下九阍。\n宰相近前宣授了，齐班舞蹈谢君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 其二 端门观习肆赦仪","author":"王同祖","text":"两边黄幕护朱檐，中贵当头候捲帘。\n扶起金鸡争抢取，要教天表庶民瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行 其二","author":"王同祖","text":"火云散尽晚风凉，曲涧流空草自长。\n蚕箔成丝秧贴水，数声布谷为谁忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行 其一","author":"王同祖","text":"牧牛童子坐田头，摘草簪花两两讴。\n路绕青山山绕涧，残蝉夕照澹于秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨意 其二","author":"王同祖","text":"曀曀重阴昼不分，归鸦林里认黄昏。\n人间春信知多少，但觉轻寒入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨意 其一","author":"王同祖","text":"春愁如织雨如麻，倦倚吟窗拾落花。\n坐不忍眠心似醉，悠悠身世在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂兴 其二","author":"王同祖","text":"粉墙红杏半离披，春满人间花自知。\n幽鸟不言如有思，等闲飞上海棠枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂兴 其四","author":"王同祖","text":"百花时节燕莺忙，昼日如年懒课香。\n午枕梦回人悄悄，一声啼鸟傍斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂兴 其一","author":"王同祖","text":"迢迢清夜静无哗，月色千门噪乱鸦。\n坐久忽惊寒力重，不知残雪在梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂兴 其三","author":"王同祖","text":"轻寒漠漠雨霏霏，春院人闲半掩扉。\n风力不知多几许，出门只见杏花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春社","author":"王同祖","text":"廉纤雾雨四山昏，寂寂茅檐半掩门。\n客里不知今日社，偶过野庙见分膰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独行","author":"王同祖","text":"终日长廊独自行，幻身未信一丝轻。\n自家心绪忡忡急，枉恨邻墙捣练声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日金陵制幕书事 其四","author":"王同祖","text":"元帅谦谦尽下情，麟堂垂晚更延宾。\n遇风尽是同舟客，肯把秦人视越人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日金陵制幕书事 其一","author":"王同祖","text":"幕府秋来事更多，夜深犹自拟诸窠。\n平安号火新来急，虏骑连宵已渡河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日金陵制幕书事 其五","author":"王同祖","text":"明朝玉帐过江边，骑卒行营一日先。\n出得公庭天向夜，通宵又散起家钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日金陵制幕书事 其三","author":"王同祖","text":"哨马纷纷一水间，渡头分戍要防奸。\n可怜生计渔舟者，官给旗牌禁往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日金陵制幕书事 其二","author":"王同祖","text":"点尽官军点到民，三千新遣殿司兵。\n流移更讲关防策，预结强丁戍列营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋闺 其二","author":"王同祖","text":"满目凄凉只自知，閒将心事寄琴徽。\n无情梁上双双燕，带取秋光一半归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋闺 其三","author":"王同祖","text":"入秋情思可曾忺，深琐朱扉怯捲帘。\n书几无人尘不扫，一钩蛛网挂牙签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋闺 其四","author":"王同祖","text":"江南贾客去忘归，扑面边尘自在飞。\n想得那边寒较早，夜来密地剪征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋闺 其一","author":"王同祖","text":"西风昨夜到庭梧，晓看窗前一叶无。\n秋月照人眠不得，等闲拈弄绣工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋闺 其五","author":"王同祖","text":"零露瀼瀼夜气浮，嫩寒差力五更头。\n邻鸡啼破交加梦，冷浸梧桐月一钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘方石归旴江 其二","author":"王同祖","text":"昨日新闻未忍听，忧时赢得鬓毛星。\n归休高卧西江上，祗恐川原草木腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘方石归旴江 其一","author":"王同祖","text":"岁云暮矣始成行，珍重刘公半月程。\n四海干戈风物改，乱离时节别离轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观白莲 其三","author":"王同祖","text":"掩昼娇春敛恨浓，莲包欲实又成空。\n都缘不肯为云雨，开落非关一夜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观白莲 其一","author":"王同祖","text":"翠盖亭亭映玉裳，临风?彴暗飘香。\n六郎正被繁华困，不爱浓妆爱淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观白莲 其二","author":"王同祖","text":"娇羞处子临妆后，淡净佳人出浴时。\n无语倚栏如有恨，生嫌别岸污胭脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观白莲 其四","author":"王同祖","text":"采菱人散夕阳收，冷落西溪风露头。\n飞入白鸥花一色，暗香来处月如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日金陵制幕即事 其五","author":"王同祖","text":"入夏边烽渐报安，不妨拄笏共观山。\n西风易把江涛涌，整暇规摹肯放闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日金陵制幕即事 其一","author":"王同祖","text":"五更三点造辕门，了却文书日欲昏。\n出入戴星吾岂惮，要须一饭不忘恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日金陵制幕即事 其三","author":"王同祖","text":"荷花池畔竹凉床，一枕闲消夏日长。\n燎过水沉天正午，旋移小艇采莲房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日金陵制幕即事 其四","author":"王同祖","text":"幕府人才不在多，同寅难得是恭和。\n一堂宾主春风里，剩有工夫到切磋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日金陵制幕即事 其二","author":"王同祖","text":"早来留得气清明，吏捧军书课日程。\n秉烛搀先书押了，闲攲凉枕数残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄诗人 其一","author":"王同祖","text":"忆君夜夜看灯花，暗数归期未到家。\n儿女团栾生计足，还知边塞走胡沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄诗人 其二","author":"王同祖","text":"恰回午枕自华胥，忽得周郎一纸书。\n江上春风能几日，莫教门外柳萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚出升州门","author":"王同祖","text":"晚驱羸马出东城，过尽三岗路却平。\n村店夜深人语静，隔桥风递暗潮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋","author":"王同祖","text":"世变无穷客恨长，栏干遍倚怕斜阳。\n满篱黄菊无心看，付与游蜂自在忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋登楼 其一","author":"王同祖","text":"独上危楼望落晖，昏鸦归处远烟微。\n湖光洗得秋容净，争奈江南雁又飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋登楼 其二","author":"王同祖","text":"读罢黄庭倦倚楼，乱云挟雨过湖头。\n年来无复登临思，闲撚黄花送暮秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]