[{"title":"禅人写真求赞 其二十五","author":"释正觉","text":"野水秋自瘦，枯山春复肥。\n胡床放得稳，默默坐亡机。\n电流柄拂，云入田衣。\n位分偏正兮，道出离微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其四十四","author":"释正觉","text":"雨霁云收，山寒水秋。\n心目自照，言象俱休。\n满十方而智应，廓三世以神游。\n虚空那碍东西壁，明月解随南北舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十七","author":"释正觉","text":"圆颅方衣，静枢活机。\n天空云淡淡，潭净月依依。\n十分化事成华木，默默冰壶春信归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六十六","author":"释正觉","text":"说也说不破，画也画不成。\n慷慨鼻气通快，清閒眉棱觉轻。\n静不得像，动不流情。\n十方三世无安处，历历诸缘头上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十六","author":"释正觉","text":"庐陵米价百念升，赵州萝卜半千秤。\n只么郎当住持，洎合殃杀性命。\n省不省，脑后更将楔钉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其三十七","author":"释正觉","text":"老觉雪入鬓，净若秋摩心。\n寒枯坐曲木，缄默饱丛林。\n气韵寥寥兮风清山瘠，性灵湛湛兮月落潭深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其五十六","author":"释正觉","text":"气韵能清，眉目似笑。\n深深入大道之环，默默守群机之要。\n闹里随缘，虚中分照。\n用作家之钳锤，与本分之草料。\n千毳相从兮，俱求参饱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其八十六","author":"释正觉","text":"双目寒青，秋水冷冷。\n半颠衰白，春雪星星。\n山雾霏霏文豹变，松月娟娟梦鹤醒。\n妙应方圜兮了无外法，尘缘俯仰兮初不吾经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其七十四","author":"释正觉","text":"袈娑在肩，柱杖入握。\n未动六爻，全提一著。\n分身是处相随，当面不须讳却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其十三","author":"释正觉","text":"谁道物齐，俱亡品题。\n欺唇一鼻直，盖眼两眉低。\n大千同入印，三世未分畦。\n斫额望之不及，拟心思也还迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七六","author":"释正觉","text":"默默而坐，佛祖勘破。\n水冷鱼潜，天空鸟过。\n半夜失却牛，平明拾得火。\n乍卷乍舒兮，无可不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十八","author":"释正觉","text":"深默而耀，至虚而灵。\n我亡黑白，谁为丹青。\n一点落机纽，万缘分化形。\n月下水而明洁，云出岫而轻盈。\n善应无方果如此，这回随处立门庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十六","author":"释正觉","text":"默默有得，灵灵无依。\n妙穷出没，照彻离微。\n万像齐收一印，三昧遍在群机。\n而今恁么相随去，终日如愚不我违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九九","author":"释正觉","text":"静得其根，动应其门。\n家传从佛祖，机用付儿孙。\n凿开浑沌，派发昆崙。\n借与烟光成草木，华华叶叶气温温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二○","author":"释正觉","text":"二仪同根，万物一源。\n机活静枢之臼，象成玄牝之门。\n幽而不昏，湛而若存。\n用妙触而出碍，体至虚而无痕。\n车辙出门而合度，桃李成蹊而不言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○五","author":"释正觉","text":"面目古怪，气宇深清。\n涧月夜白，松雪寒明。\n舜若之身兮谁前谁后，首罗之眼兮不纵不横。\n相随来也，流水浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十七","author":"释正觉","text":"肃萧而秋，万化潜收。\n英英而春，群汇舒伸。\n天地之间谁造物，枢机之发是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五八","author":"释正觉","text":"默而不凝，照而不流。\n关捩虚而活，机轮转处幽。\n闲云淡而无雨，野水清而有秋。\n要将平等一如相，著在森罗万像头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十","author":"释正觉","text":"三河野人，两浙社宾。\n湛存该理智，妙触出根尘。\n乌藤行脚丛林事，鈯斧住山云水身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五六","author":"释正觉","text":"癯而且老，寒木未春。\n静而愈明，古潭有月。\n天苍苍而无空无缺，云闲闲而乍出乍没。\n二仪同根，万物一体，莫向诸缘分彼此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五四","author":"释正觉","text":"眸子射人，秋涧之津。\n颠毛衰白，霜松之晨。\n赤湖之林，潮涨而长鲸?浪。\n丹桂之影，月寒而老兔推轮。\n明功借位，起幻入尘。\n百草头边有芳信，纵横指点自家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三六八","author":"释正觉","text":"身老而衰，根钝且迟。\n霁冷河阔，天空斗垂。\n圆明三只目，受用两茎眉。\n尘刹大千纵横而妙触，三尺丈六笑语而相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十二","author":"释正觉","text":"净而纯中无一尘，纯而净中有万应。\n眼睛明，鼻孔正。\n更将折箸搅沧溟，令彼龙鱼知水为命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五二","author":"释正觉","text":"眉目古涧秋，须发寒岩雪。\n去就丛林出身，触动葛藤生舌。\n扬拂握拳，破关击节。\n雾变豹而草木光，雷趁蛟而山石裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七二","author":"释正觉","text":"静据胡床，閒握柱杖。\n正念绝机丝，起家无伎俩。\n珠旋翡翠盘中，月在珊瑚枝上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一一","author":"释正觉","text":"是兮不是，别兮不别。\n水冷涵秋，山寒带雪。\n传家之印兮中间无文，常用之针兮两头无穴。\n游世之身云月閒，说禅之口河汉决。\n自然随顺因缘，向道不乖时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二一","author":"释正觉","text":"岩壑之骨洼而隆，烟霞之气温而融。\n其默而通，其应而冲。\n流云出谷，霁月行空。\n十方三世兮，南北西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三五","author":"释正觉","text":"片月在水，孤云出山。\n其静而应，其动而閒。\n体中不欲全露，用处只窥一斑。\n重重楼阁门开也，弥勒不须轻手弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七一","author":"释正觉","text":"说真不真，说似不似，拈转舌头提得鼻。\n空劫家风，衲僧田地。\n心心与祖相传，佛佛见他出世。\n一尘入正受，诸尘三昧起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十九","author":"释正觉","text":"雪浸发根，秋生眼棱。\n明月泉头客，清风楼上僧。\n潮翻麈尾兮蹴踏龙象，风旋羊角兮变化鲲鹏。\n主盟佛事，最得人憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十八","author":"释正觉","text":"静据胡床，久而愈芳。\n默亡痕黑白，贫不觉苍黄。\n住无相兮龟之藏，行无章兮鸟之翔。\n月烂烂而鱼吞光，华菲菲而蜂采香。\n相随来也，触处堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九七","author":"释正觉","text":"一亘清虚，十分明白。\n借兮是功，转兮非色。\n天盖地擎兮体之有馀，雷轰电掣兮用之不测，情未生时如何隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一二","author":"释正觉","text":"发之白兮高峰早雪，目之青兮古涧先秋。\n月炯炯兮自有光通犀角，草苍苍兮谁能硬按牛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二八","author":"释正觉","text":"智静用冲，道明体空。\n清白转色，幽微借功。\n一乘句里那回互，百草头上还疏通。\n虎头之顾，牛头之融。\n且痴且懒，不谋而同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六五","author":"释正觉","text":"寒淡相依，清白住持。\n秋横两目，雪覆双眉。\n老兔推月河汉阔，宾雁没烟星斗垂。\n穷通有自，机用输谁。\n消得而今一瞬，不须别唤沙弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六七","author":"释正觉","text":"妙出名象，非心非相。\n混融古今，是相是心。\n发白晓霜厚，眼寒秋水深。\n寄语山形拄杖子，大家相伴做丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十四","author":"释正觉","text":"发作残雪之白，目带深秋之寒。\n春山未暖，野水无澜。\n家风摩鼻孔，好事上眉端。\n三世因缘兮半身而应，十方刹海兮一吸而乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○二","author":"释正觉","text":"漆点两眼，雪丝半头。\n嗒然亡耦，转处还幽。\n一等高闲兮馀云敛霁，十方清白兮片月摩秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十五","author":"释正觉","text":"月犀得晕，雾豹养文。\n有通有变，或合或分。\n夜寒河濯斗，山润石生云。\n妙湛体前明历历，从交天下乐忻忻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五五","author":"释正觉","text":"天童之师，顶雪颔丝。\n三篾住山计，孤藤横膝时。\n潭寒秋到早，空阔月行迟。\n提起宗家无字印，门门何处不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十一","author":"释正觉","text":"孤身云閒，老发雪白。\n丛林眼孔清，河汉口门窄。\n应时谁外诸缘，转处自消一色。\n峥嵘万像森罗，向道与他平出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十九","author":"释正觉","text":"眉垂而杨，口默而方。\n了见源底，净极发光。\n月魂排夜色，斗气濯秋霜。\n谁嫌眼上瞋生角，我道机前影不章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○七","author":"释正觉","text":"看看，心空骨寒槁木暖，未发髑髅津沥乾。\n秋入眼角，春生鼻端。\n相呼相唤知音会，为我门前倒刹竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三二","author":"释正觉","text":"馀云消于霁虚，片月上于秋壶。\n光清岩壑，影现江湖。\n类中之异，物中之珠。\n虎生三日食牛气，马走千里随母驹。\n赏音有以，德邻不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十七","author":"释正觉","text":"野水秋清，寒蟾夜明。\n气像能虚白，家风自混成。\n鼻快筒直，眼瞋角生。\n太空同体而豁落，万像同用而峥嵘。\n人间有饭饱皮袋，默默憨憨谢太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十三","author":"释正觉","text":"瀛涵崧镇，深兮高兮。\n默默之得，类之不齐。\n一鼻直，两眉低。\n影像尔能半露，语言谁得全提。\n少林九年兮，痴坐凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一三八","author":"释正觉","text":"从身出门，即物契神。\n一机历历，三昧尘尘。\n逢场且了游戏事，向道非无幻化人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○三","author":"释正觉","text":"赤肉一块，臭脓一袋。\n何物著乎中，有应发于外。\n妙入群机兮成三昧，个时撒手断崖前，方见浑仑扑不碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五六","author":"释正觉","text":"默而藏，妙而光。\n月之轮窄，斗之柄长。\n扶来草木春濡绿，夺去山川霜落黄。\n相契可处，自然成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二五二","author":"释正觉","text":"松老有骨，竹癯无肉。\n雪发覆颠，霜眉映目。\n须菩提坐空而谈，维摩诘卷辨而默。\n拈来何处不相逢，日面佛兮月面佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四三","author":"释正觉","text":"衰形老容，瘦竹苍松。\n野食丹山凤，云吟枯木龙。\n对机何似当台镜，扣应恰如随杵钟。\n了无一物，还我卢舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十二","author":"释正觉","text":"山林眉目，水月身心。\n雪何早而古岩棱，秋似先而寒潭深。\n机头锦绪，线尾金针。\n谁云道大兮自有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十七","author":"释正觉","text":"净智而昭昭，体空而寥寥。\n天心河淡月欲下，松顶雪寒春未消。\n三世迁流兮弹指可断，万年长久兮一念全超。\n恁么来也，顺风上潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四二五","author":"释正觉","text":"发皑皑而雪山，目湛湛而秋潭。\n杖拂老伴，丛林饱参。\n万全非一有，二破却成三。\n门门虚而正受，物物各自禅谈。\n春亭不要閒狼藉，华乌而今罢了衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一九","author":"释正觉","text":"云水性调，丛林气高。\n肚皮束篾，版齿生毛。\n十方身虚空样放，二升米拄杖头挑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十八","author":"释正觉","text":"老态垂垂，岁月浸欺。\n半头生白发，瘦骨裹黄皮。\n情闲用而活，句妙默而知。\n河阔斗寒云静夜，天无四壁风披披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其七十","author":"释正觉","text":"无像而像，有许模样。\n不真而真，只个形神。\n豁清也千岩万壑而秋，光丽也诸尘百草而春。\n恁么来兮，处处相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二四四","author":"释正觉","text":"痴钝之师，枯槁之姿。\n鼻寒垂涕，眼老生黐。\n玉怀石而矩，珠养蚌而规。\n长短华枝春次第，东西波棹月相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二十三","author":"释正觉","text":"漆黑眸子，栀黄面皮。\n智静霁月相照，身閒野云不羁。\n该抹把手陈尊宿，细腻点头王老师。\n针兮线兮明联暗缀，音兮律兮自拍独吹。\n你道是谁，芙蓉之孙兮丹出之儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十六","author":"释正觉","text":"道随缘而不变，源赴汲而不枯。\n禅悦之食兮饱其腹，法空之座兮跏其趺。\n青原自喜有麟角，黄檗谁嫌捋虎须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十六","author":"释正觉","text":"风观痴甚，形骸老生。\n眉棱阴觉重，鼻息静还清。\n二仪未兆，一点圆明。\n霜洗斗牛湿，秋晴河汉横。\n莫将毫忽痕空性，向道环中长太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○三","author":"释正觉","text":"青山之主兮体本平等，白云之宾兮用能自然。\n应有馀兮神不可测，得其简兮妙不可传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二○一","author":"释正觉","text":"体之象先，得之自然。\n心空有以，道大谁传。\n蟾在珊瑚之树，蚌蕴明珠之渊，弹指分身兮三千大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八三","author":"释正觉","text":"雪拭晚晴，水受秋清。\n天空四壁，月冷三更。\n湛存而独立，定应而周行。\n二仪之道成且平，万像之印虚不盈。\n鸥鸟情閒机事外，夕阳沙上未寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二六","author":"释正觉","text":"妙明绝思，廓静无涯。\n智空三际，性融二仪。\n借功光历历，借伴老垂垂。\n文彩纵横成底事，机头初不挂梭丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八九","author":"释正觉","text":"古岩老僧，百事不能。\n饱雪筠林野之姿，癯犹高节。\n抱松石岁寒之骨，老更苍棱。\n去就且拙，唱酬可憎。\n慎严逆流洞水道，孝满颠酒曹山曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]