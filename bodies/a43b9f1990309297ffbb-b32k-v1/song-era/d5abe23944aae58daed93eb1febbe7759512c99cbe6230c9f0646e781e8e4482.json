[{"title":"早上过溪报谒林子长承约客回途作 其三","author":"虞俦","text":"伏日当休沐，顽躯困坐曹。\n骤然秋雨至，一洗夏畦劳。\n怀祖何须怒，刘伶亦未豪。\n北窗陶靖节，千载只渠高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又二首 其二","author":"吕祖谦","text":"公未陪经幄，还应典奉常。\n如何便沈没，不使少翱翔。\n幽壤千年闭，名山万卷藏。\n升堂多俊彦，筑室绕高冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又二首 其一","author":"吕祖谦","text":"平生丈人行，每语尽箴规。\n问字扬雄宅，谈经董相帷。\n壶觞陪胜践，杖屦及深期。\n谁料南归日，坟前宿草衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王龟龄詹事挽章二首 其二","author":"吕祖谦","text":"大使交旃日，元戎解甲秋。\n先鸣惊众寐，孤愤压群咻。\n羽翼新鸿鹄，声华旧斗牛。\n断桥亡恙否，落月照寒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王龟龄詹事挽章二首 其一","author":"吕祖谦","text":"诸老收声尽，佳城又到公。\n苍天那可问，吾道竟成穷。\n旌卷莆田雨，箫横霅浦风。\n今年襟上泪，三哭万夫雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王通直挽章","author":"吕祖谦","text":"近来南国冢，半是北人坟。\n异县谁怜我，同乡又失君。\n深居传雅尚，坚坐挹清芬。\n日落长安第，三槐拂暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东阳郭彦明挽章","author":"吕祖谦","text":"小试威名盖一乡，卷藏韬略付农桑。\n传家签轴书盈幄，择婿簪缨笏满床。\n置邑万家开兆域，送车千两塞康庄。\n正须今代如椽笔，尽发潜光著石章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶子山右史父宣义挽章二首 其二","author":"吕祖谦","text":"诸父乌衣集，公时预往还。\n凉秋同出郭，胜日共寻山。\n电掣流年速，舟移古岸閒。\n又成丹旐去，衰涕不胜潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶子山右史父宣义挽章二首 其一","author":"吕祖谦","text":"经笥深无底，高谈一座倾。\n置身初濩落，有子晚光荣。\n命服乡闾贺，安舆里巷迎。\n风枝何不定，忽忽到佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘梧州挽章","author":"吕祖谦","text":"驷马高车照路光，幡然改辙兴何长。\n空山猿鹤惊无恙，同社鸡豚乐未央。\n祗见岁华来冉冉，不知耆旧去堂堂。\n北邙道上麒麟冢，谁得归休十载强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"向运使挽章","author":"吕祖谦","text":"戟衣翻户映庭槐，使节州符未展才。\n文献定知丞相似，渊源还自洛阳来。\n异端惑世浓于酒，古学违时冷若灰。\n从此湖人识丧礼，凛然治命手亲裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巩采若府推母钱夫人挽章二首 其二","author":"吕祖谦","text":"历历称觞地，悲凉骑省园。\n风枝今日恨，露叶去年痕。\n鸾翥昏遗镜，鱼枯泣旧轩。\n曲湖春色满，不到北堂萱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巩采若府推母钱夫人挽章二首 其一","author":"吕祖谦","text":"内助功推冠，名成父子间。\n中原遗俗尽，旧族素风还。\n石窌天开邑，宫门日缀班。\n光华竟何许，夕照在西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次前韵答石秀才","author":"吕祖谦","text":"幽轩返照可窗明，政用高谈答晚晴。\n共听铜瓶秋雨急，不知石鼎晓云生。\n清诗未读心先醉，别日无多梦已惊。\n闻道乌衣盛文史，祇愁异姓后宗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶丞相陈尚书游南园","author":"吕祖谦","text":"乐事良辰古所难，三分春色一分宽。\n润花雨过红裙湿，倚竹风斜翠袖寒。\n自有南堂谁举白，可无东绢为施丹。\n两翁醉墨曾题品，便作平泉草木看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许著作挽章","author":"吕祖谦","text":"清文丽藻百川增，窘步追随愧不能。\n麟趾差肩台岌岌，雁飞联翼塔层层。\n莼鲈归兴都门酒，薤露悲歌大隧灯。\n独向梁间诵遗句，寒松衰菊绕崚嶒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何叔京挽章二首 其二","author":"吕祖谦","text":"倾盖黄亭夜，翛然涧壑姿。\n倚天唯直干，到地绝旁枝。\n亹亹今何许，悠悠只自知。\n寒碑卧风雨，千载有深期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何叔京挽章二首 其一","author":"吕祖谦","text":"濮州以谏死，何氏得其真。\n天下中庸义，人间父子亲。\n再传犹易简，小出复逡巡。\n埋骨虽南土，倾心向北辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何茂恭母王夫人挽章","author":"吕祖谦","text":"南朝人物盛诸何，寿母皤然乐事多。\n堂下无忧萱弄色，天边有信桂交柯。\n黄金籯满经方重，白玉楼成恨未磨。\n空诵安仁旧时赋，版舆零落故山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"应春坊挽章","author":"吕祖谦","text":"铅椠青灯夜，韬钤紫塞秋。\n请缨虽拜疏，投笔未封侯。\n帏白风烟惨，旗丹雾雨愁。\n从来桑梓接，助挽不成讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李粹伯侍御母夫人挽章","author":"吕祖谦","text":"对仗峨冠日，鲸牙汹九渊。\n堂萱不改色，台柏故参天。\n共识吾君圣，今知此母贤。\n丁宁刘子□，□事一时编。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨信伯郎中挽章二首 其二","author":"吕祖谦","text":"并舍游从旧，同朝分义深。\n时时坠书札，得得到山林。\n北去先移棹，南来后盍簪。\n死生离合地，搔首一悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨信伯郎中挽章二首 其一","author":"吕祖谦","text":"象魏三千法，瀛洲十八人。\n南宫占列宿，少海近重轮。\n闻道清羸极，犹有职业亲。\n榴皮馀屋壁，零落独无神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36774,"sha256