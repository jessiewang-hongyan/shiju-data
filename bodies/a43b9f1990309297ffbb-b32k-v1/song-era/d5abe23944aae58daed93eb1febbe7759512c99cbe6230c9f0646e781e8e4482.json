":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周尧夫主管挽章","author":"吕祖谦","text":"五柳传觞地，风流魏晋前。\n曾探孝先笥，惯坐广文毡。\n身世浑如梦，功名莫问天。\n从今风雪夜，不上剡溪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周表卿尚书挽章","author":"吕祖谦","text":"奏篇曾用牍三千，晚岁回翔日月边。\n眼看四朝诸老尽，身兼五福几人全。\n清台课历遗书在，昼寝凝香旧政传。\n竹马馆前寒月白，当时辙迹故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞仲逸初夏怀黄岩村居","author":"吕祖谦","text":"几曲江村雨外明，钓矶渔屋入新晴。\n参天乔木浅深绿，盖水圆荷先后生。\n归梦每烦春鸟唤，故林可忍晓猿惊。\n功成共祖东门道，不负溪山旧主盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑武子删定挽章二首 其二","author":"吕祖谦","text":"古汴豪英海，追随不厌勤。\n廛中识梅福，帘下得严君。\n培养逢原学，堙沈济世勋。\n定知千载后，下马董生坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑武子删定挽章二首 其一","author":"吕祖谦","text":"博洽推诸老，胸中几石渠。\n暮年终反约，精义本无馀。\n羲易忘言后，楞伽绝笔初。\n长归应不憾，旧学尽成书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城楼","author":"吕祖谦","text":"城峻先迎月，帘疏不隔风。\n棋声传下界，雁影没长空。\n岛屿秋光里，楼台海气中。\n登临故待晚，雨外夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣城李君尝游东湖居士之门袖诗见过次韵以谢","author":"吕祖谦","text":"人去湖空古豫章，溪荪水荇换年芳。\n闻风我是通家旧，觅句君犹弟子行。\n须发苍浪休叹老，齿牙沆瀣尚生香。\n宛陵自昔诗人国，今日谁升小谢堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日","author":"吕祖谦","text":"堂下梧桐树，清阴欲满帘。\n风前数叶落，枝外几山添。\n世故真难犯，幽栖不用占。\n新凉入书幌，好在邺侯签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺车驾幸秘书省二首 其二","author":"吕祖谦","text":"紫清丹极与天邻，阖辟乾坤系笑嚬。\n独为斯文回一顾，坐令吾道重千钧。\n先王旧物参差见，列圣明谟次第陈。\n墨客区区感荣遇，岂知深意在彝伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺车驾幸秘书省二首 其一","author":"吕祖谦","text":"麟台高柳识雕舆，共记中兴幸省初。\n黄道再传天子跸，青编重入史臣书。\n需云下际君恩盛，晨露高张乐节舒。\n若写鸿猷参大雅，定非周鼓颂田渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵路分挽章二首 其二","author":"吕祖谦","text":"晨昏生死际，至性极民彝。\n巨孝东都传，劬劳小雅诗。\n固应为世表，何止秀天枝。\n令子传遗绪，累然不自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵路分挽章二首 其一","author":"吕祖谦","text":"鲁卫封虽近，原颜室自贫。\n一家唯四壁，九族自三春。\n子舍龙头贵，佳城马鬣新。\n升堂如昨日，南望涕沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送柳严州解官趋朝","author":"吕祖谦","text":"一叶初秋已趣装，玺书屡下驻归艎。\n少留北阙三年最，多借西州半岁强。\n身外宠荣元自薄，眼前凋瘵故难忘。\n书囊知有朝天草，不是中和乐职章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜","author":"吕祖谦","text":"晚市收声尽，虚堂一味凉。\n炎蒸渠酷吏，閒静我羲皇。\n露沐疏萤湿，风梳细草长。\n典移无定在，随月转胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制秋日幸秘书省近体诗","author":"吕祖谦","text":"麟阁龙旂日月章，中兴再见赭袍光。\n仰观焜耀人文盛，始识扶持德意长。\n功利从今卑管晏，浮华自昔陋卢王。\n愿将实学酬天造，敢效明河织女襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步溪上","author":"吕祖谦","text":"疏疏屐齿印平堤，露著乌纱客未知。\n别浦归舟争占岸，横林宿鸟自分枝。\n开张渔父胸中趣，漏泄骚人句外悲。\n会与清溪约长夏，风帘水簟答涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧果卿祭酒挽章二首 其二","author":"吕祖谦","text":"摩揣诚斯薄，雕镌质自销。\n平生但真朴，直上绝枝条。\n氛雾终澄霁，丘山亦动摇。\n朝阳旧时凤，声入舜箫韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧果卿祭酒挽章二首 其一","author":"吕祖谦","text":"虚心观世态，实行播乡评。\n璧玉中边厚，冰壶表里清。\n家声到萧傅，人望似阳城。\n殄瘁无穷恨，湘江日夜倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游上天竺","author":"吕祖谦","text":"净域何虚寂，居然隔市喧。\n僧来混不语，吾亦欲忘言。\n至乐存箪食，浮名类触藩。\n行行返初服，贲趾老邱樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒋世修秘书父朝奉挽章","author":"吕祖谦","text":"太一青藜子舍光，命书频岁到高堂。\n深居物外风烟老，静看人间日月忙。\n绕舍图书千载韵，映阶兰玉四时芳。\n逝舟休叹东流水，馀庆源流衮衮长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲁少卿挽章","author":"吕祖谦","text":"庆源衮衮接天流，老桂传香次第秋。\n人物西都九卿选，光华南国十州游。\n翛然径下滕王阁，已矣长怀范蠡舟。\n身后楚骚谁著录，灵光旧草合兼收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋睢阳五老图卷","author":"朱熹","text":"同支派别胄遥遥，南渡衣冠尚北朝。\n千载画图文献在，两朝开济政明昭。\n公卿倡和遵皇运，嗣子传家念祖饶。\n幸得庆源流自远，匡扶人世释尘嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端明汪公挽章二首 其二","author":"吕祖谦","text":"四海膺门峻，亲承二纪中。\n论交从父祖，受教自儿童。\n山岳千寻上，江河万折东。\n微言藏肺腑，欲吐与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端明汪公挽章二首 其一","author":"吕祖谦","text":"异时忧世士，太息恨才难。\n每见公身健，犹令我意宽。\n彫零竟何极，回复岂无端。\n此理终难解，天风大隧寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题归庵","author":"吕祖谦","text":"云壁开苍峡，风林卷翠涛。\n诸松皆老大，一嶂独孤高。\n发兴虽公等，寻幽许我曹。\n秋光端可赋，不是楚人骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薛叔云左史母方夫人挽章二首 其二","author":"吕祖谦","text":"往在西雍日，从容许拜亲。\n杏花坛壝古，萱草户庭春。\n曾是升堂客，应为执绋人。\n壶公天一角，吹泪洒车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薛叔云左史母方夫人挽章二首 其一","author":"吕祖谦","text":"彤管传遗范，形容欲付谁。\n初年柏舟赋，晚岁艾轩诗。\n□□□□□，□金□赤墀。\n莆中称寿母，不独蔡三司。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"魏元履国录挽章二首 其二","author":"吕祖谦","text":"群公祖疏傅，多士送阳城。\n短棹非前约，长亭及此行。\n深留移白日，共语只苍生。\n会续山阳赋，邻人笛未横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"魏元履国录挽章二首 其一","author":"吕祖谦","text":"麻衣见天子，拜疏不知休。\n落落山林气，拳拳畎亩忧。\n极知千载遇，政用一身酬。\n绕舍闽溪水，朝宗日夜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效进士作三年通一经","author":"吕祖谦","text":"岁月去如矢，横经徒慨然。\n谁能通一艺，真不负三年。\n用意窥园外，收功刻楮边。\n幽光回蠹简，新意出陈编。\n上相黄金重，诸儒白首鲜。\n同声不同调，叹息伯牙弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与同馆游张氏园分韵得日字","author":"吕祖谦","text":"出门厌嚣尘，入门倦佔毕。\n驾言城北园，滞思顿觉失。\n方池环修篁，广陌卫行栗。\n先雪梅已苞，后霜草犹茁。\n上跻极高明，旁穿复深密。\n主人真喜事，秀句屡盈帙。\n招呼文字饮，及此三馀日。\n山林与钟鼎，零茂本非匹。\n斯游岂偶然，书板记甲乙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方斋行","author":"吕祖谦","text":"世皆尚圆君独方，富贵可取君不忙。\n闭门读书声琅琅，旧书重叠堆在床。\n点勘同异分边旁，运精竭思心力彊。\n十年足不离僧房，荒山野路秋水长。\n客虽欲至嫌路妨，幽兰无人为君芳。\n采菊落英充糇粮，客即不来有馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉铜弩机歌","author":"吕祖谦","text":"甘泉宫中烽火催，武库掣锁殷春雷。\n山西都尉部千弩，意气欲压天山摧。\n朔风惨惨随旗尾，角声满天日色死。\n眼吞单于方发机，南风不竞羽倒飞。\n血视空弮尚思战，边庭无竹可续箭。\n断弦已作塞上尘，零落铜牙时一见。\n土花蚀尽缪篆青，千年遗恨今未平。\n雕鞍过尽不回首，落身几案依书檠。\n藓苔暗淡生古色，中有少卿千斛力。\n从汉至今无大黄，妇玩儿嬉固其职。\n长平箭头豪士怜，赤壁折戟传青篇。\n古来慷慨共如此，脱略形器求天全。\n是机虽缺神凛然，想成风沙射雕天。\n径欲匹马南山边，何必一臂三十絭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许由","author":"吕祖谦","text":"许由不耐事，逃尧独参寥。\n行至箕山下，盈耳康衢谣。\n谓此污我耳，临流洗尘嚣。\n水中见日驭，劳苦如尧朝。\n尧天接山际，尧云抹山椒。\n谁云能避世，处处悉逢尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过九江赠同舍陈伯秀","author":"吕祖谦","text":"异时夫子门，论交心独可。\n晨窗并几案，莫檠共灯火。\n同升大宗伯，道阻山砐硪。\n淡墨湿栖鸦，天开棘闱锁。\n高张三百丈，遍数不及我。\n咫尺判飞沈，鹏抟笑鸢堕。\n音尘两疏阔，岁月悉箭笴。\n风吹樊口帆，雨系浔阳柁。\n故人尚一尉，旌旗穿紫逻。\n相逢话旧游，拨置朱墨夥。\n握手忘寒温，屈指半轗轲。\n官居岸平湖，波涛日舂簸。\n饱看五老面，此计殊未左。\n山房旧闻名，欲往辄不果。\n须君发其藏，万卷书绕坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]