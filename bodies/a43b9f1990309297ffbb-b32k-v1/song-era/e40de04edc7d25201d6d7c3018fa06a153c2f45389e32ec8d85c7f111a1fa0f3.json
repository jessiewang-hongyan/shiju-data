[{"title":"长沙劝耕 其八","author":"真德秀","text":"千金难买是乡邻，恩意相欢即至亲。\n年若少时宜敬老，家才足后合怜贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其一","author":"真德秀","text":"是州皆有劝农文，父老听来似不闻。\n只为空言难感动，须将实意写殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长沙劝耕 其三","author":"真德秀","text":"已看三白兆年丰，更喜春来雨泽通。\n从昔楚邦农事早，好将人力副天工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁端午贴子词五首 其五","author":"真德秀","text":"才过端辰又诞辰，天家风物镇长新。\n六宫竞献长生缕，一缕应期一万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁端午贴子词五首 其四","author":"真德秀","text":"水晶帘捲午风轻，万壑清寒凌室冰。\n閒奏薰弦思解愠，肯教人世独炎蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁端午贴子词五首 其三","author":"真德秀","text":"红榴紫槿映池台，玳席还当水殿开。\n借问天颜何大喜，皇储亲奉万年杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁端午贴子词五首 其二","author":"真德秀","text":"日永坤宁殿，时将万卷看。\n从容聊洒翰，宝扇舞龙鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁端午贴子词五首 其一","author":"真德秀","text":"翠浪两岐麦，冰丝八茧蚕。\n今年收倍好，歌颂满周南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿陈宰 其一","author":"真德秀","text":"花种河阳未十旬，和薰四境蚤如春。\n试看条教频频下，字字无非育物仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿陈宰 其二","author":"真德秀","text":"为民一念彻渊泉，蔬茹馀旬始吁天。\n岁事丰登邻寇熄，乃知感应鼓桴然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"净豁持钵求度为说偈言","author":"真德秀","text":"一真不昧人中佛，五戒俱全俗里僧。\n必待方袍与圆顶，维摩庞老又何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏仁","author":"真德秀","text":"程子精微谈谷种，谢公近似喻桃仁。\n要须精别性情异，方识其言亲未亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇帝阁六首 其五","author":"真德秀","text":"东风昨夜入帘帷，便觉深宫漏影迟。\n一曲凉州花尽放，不须先作报春诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 东宫五首 其五","author":"真德秀","text":"济济儒冠萃讲庭，韦编竟日共研精。\n还将泰象参人事，要使群阳更汇征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 东宫五首 其四","author":"真德秀","text":"鹤驾通宵入问安，龙墀清晚押朝班。\n天颜喜见重轮月，春色先回万岁山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 东宫五首 其三","author":"真德秀","text":"画堂金榜揭居仁，万物知关念虑深。\n一点阳和从震出，助成天地发生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 东宫五首 其二","author":"真德秀","text":"灯市千门月，花时万井春。\n朝来资善议，犹自问穷民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇后阁五首 其五","author":"真德秀","text":"烟花万匝绕坤宁，独把牙签手不停。\n为要八荒皆寿域，彩毫亲跋度人经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇后阁五首 其四","author":"真德秀","text":"谁赞东皇转化钧，宫中尧舜亦深仁。\n祗将一点阳和意，散作乾坤浩荡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇后阁五首 其二","author":"真德秀","text":"金屋春容早，铜楼晓色分。\n奉觞天一笑，圣子似周文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇后阁五首 其一","author":"真德秀","text":"宝胜千春字，琼樽九酝香。\n六宫齐上寿，地久配天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇帝阁六首 其六","author":"真德秀","text":"阳进阴消属此时，凝旒南面盍深思。\n微臣自愧无规谏，愿献元朝学士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇帝阁六首 其四","author":"真德秀","text":"万宇新歌大有年，又看瑞雪粲琼田。\n太平和气随春转，斗米从今三四钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇帝阁六首 其三","author":"真德秀","text":"雉扇开金殿，云韶奏紫庭。\n天颜知有喜，班首是前星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇帝阁六首 其二","author":"真德秀","text":"新岁朝元使，龙荒万里来。\n至仁天广大，朔漠亦春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春贴子 皇帝阁六首 其一","author":"真德秀","text":"嘉定无疆历，才开第五春。\n金穰端有兆，太岁恰居申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其六","author":"真德秀","text":"忆昔文闱创造初，挥毫纪实有鸿枢。\n乃今盛观重辉赫，试问他邦有此无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其一","author":"真德秀","text":"万间贡宇旧巍巍，更辟新楹广旧规。\n岂为儒生决科计，要培宗社太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其八","author":"真德秀","text":"策足巍科亦漫然，当知致远识为先。\n丁宁莫负梅溪祝，名节岧峣共勉旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其五","author":"真德秀","text":"梁脊伊谁姓氏题，梅溪去后有苕溪。\n自惭拙守何为者，强策驽骀继駃騠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其二","author":"真德秀","text":"云斤初运日逢甲，虹影乍横星值奎。\n天相斯文兆先见，不须佳谶指金鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其四","author":"真德秀","text":"明年丹诏下枫宸，定有英材起海濒。\n勉取梁公旧衣钵，从今人说两庚辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其三","author":"真德秀","text":"棘闱曾辟大江东，唤起秦淮两蛰龙。\n况是此邦饶俊彦，何愁盛事不重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉州贡院举梁八咏 其七","author":"真德秀","text":"簪橐联辉三大老，节旄相映四贤侯。\n作成后进须先进，引领时流作胜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁春贴子词五首 其五","author":"真德秀","text":"御沼春融冰半澌，偶观流荇已参差。\n因时有感关雎咏，寤寐难忘窈窕思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁春贴子词五首 其四","author":"真德秀","text":"笙歌北院连南院，景物新年胜旧年。\n梅柳也知天意好，十分妆点斗春妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁春贴子词五首 其三","author":"真德秀","text":"晓来宽大诏初颁，物物咸沾雨露恩。\n共仰生成归帝力，谁知辅佐属坤元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a2