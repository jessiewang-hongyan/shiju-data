[{"title":"刘阮祠","author":"林仰","text":"深树冥冥一径风，溪流应与十洲通。\n仙家日月无人识，只爱桃花二月红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴官武康投宿客邸作","author":"林仰","text":"巾子山头一枕风，皇华亭下水连空。\n山灵不用回俗驾，傥有田园吾欲东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石桥","author":"林仰","text":"空山风露洗秋容，万里阴晴此夕同。\n袖取碧岩邀月手，石桥来谒化人宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金台寺","author":"林仰","text":"苍藓沿阶走细泉，青松翠竹照华轩。\n高人倦作金毛吼，旅客来参玉版禅。\n暖日迟迟晞宿露，微风淡淡逐寒烟。\n茶瓯香秘蒲团稳，始觉林泉思邈然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年游 早行","author":"林仰","text":"霁霞散晓月犹明。\n疏木挂残星。\n山径人稀，翠萝深处，啼鸟两三声。\n霜华重迫驼裘冷，心共马蹄轻。\n十里青山，一溪流水，都做许多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出疆","author":"林仲虎","text":"去时不敢留姓名，一身万里鸿毛轻。\n征鞭不返长淮水，正恐来者愁此行。\n吁嗟此行良独难，出门儿女更辛酸。\n平生崛强身是胆，自许虎口能生还。\n犬羊异种犹人类，惟有肝胆倾相示。\n此语历历端不诬，毕竟言之无二意。\n从前鸥鹭奋不飞，机心一动成惊疑。\n愿言嘻嗑啖儿齿，直到齿落儿不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"林仲雨","text":"万事不成嗟画虎，一官那得似驱羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎溪二首 其一","author":"林仲嘉","text":"山阔青连海，溪长绿绕城。\n规模唐故郡，弦诵鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎溪二首 其二","author":"林仲嘉","text":"白日经檐短，风霜吹客衣。\n梅梢惊岁晚，沙际看春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵奉酬赵校书子直","author":"林光朝","text":"雁塔新题墨未乾，去年灯火向秋阑。\n趣看天禄青藜杖，怕著王孙紫绮冠。\n好在三山寻浩渺，何如一纸问平安。\n觚棱放月无人到，玉糁初成许共餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞猫","author":"林光朝","text":"宁可时时被鼠煎，狂猫一夜不成眠。\n广南六月官军到，见说人家断火烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其一","author":"林光朝","text":"一样官仪汉代新，乘时大手与经纶。\n东南自古衣冠地，桐柏山前淮水春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其七","author":"林光朝","text":"骀荡春风散百城，钓鳌江上棹歌声。\n官军不遣征徭少，烧尽柴炉说太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其二","author":"林光朝","text":"峨峨双阙昼烟横，玉箓金箱记姓名。\n况有曲江家旧渚，小虹桥外柳花轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其五","author":"林光朝","text":"柳堤九曲暗青丝，画戟丛中昼影迟。\n传说姑苏新乐府，只缘太守例能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其十","author":"林光朝","text":"南墙钜竹拂青烟，正在空斋簿领前。\n欲向韩门借馀润，乞将白璧种蓝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其九","author":"林光朝","text":"欲将玉律播平康，长见单于拜未央。\n相国正须如治郡，春风随处有甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其四","author":"林光朝","text":"长陪綵仗下蓬莱，万岁声中霁色开。\n自是北门须卧护，双旌迢递日边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其八","author":"林光朝","text":"天边草木旧知名，为道潢池莫弄兵。\n野市旋收黄犊去，明时火急趁春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代陈季若上张帅 其六","author":"林光朝","text":"铜柱参天桂叶稠，公侯遗爱在南州。\n绳桥竹屋连溪曲，大贝明珠尽海头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别方次云","author":"林光朝","text":"姑苏台上姑苏馆，共说南山竹火炉。\n湖上相逢又相别，不知何处说姑苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴容州仲一挽词","author":"林光朝","text":"竹屋绳桥自有村，牛山箫笛不堪闻。\n碑前更问何年月，为借容州旧使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直甫见示次云乞豫章集数诗偶成二小绝因以自喻 其一","author":"林光朝","text":"修水佳人白玉栏，花前何似妾容颜。\n从来未省伤春意，犹自楼头画远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直甫见示次云乞豫章集数诗偶成二小绝因以自喻 其二","author":"林光朝","text":"莫怪骚人太颉颃，曾闻阿母语刘郎。\n神仙本自无言说，尸解由来最下方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭伯兄鹊山处士蒿里曲 其二","author":"林光朝","text":"长记藜床发问初，翩翩出语自无馀。\n斯翁胸腹平如水，不在尘埃数卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭伯兄鹊山处士蒿里曲 其一","author":"林光朝","text":"残云衰草趁人愁，生即团栾死便休。\n悲泣声中裁此曲，鸡啾山外鹊山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭伯兄鹊山处士蒿里曲 其三","author":"林光朝","text":"桐棺三寸更何疑，却取江枫短作碑。\n惟有一般蒿里曲，长箫欲断更教吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐删定德襄 其一","author":"林光朝","text":"修文巷里莫春前，欲上旗亭问客船。\n忽有短笺无寄处，渔梁却在泪痕边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭徐删定德襄 其二","author":"林光朝","text":"忽然白昼自生哀，立马桥东唤不回。\n惊起河波理残梦，十年灯火上心来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方通判良翰 其二","author":"林光朝","text":"得钱终日走燕寺，抱膝经年动越吟。\n想得长安西望眼，只应黄鹄见归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方通判良翰 其三","author":"林光朝","text":"达者渊明自挽歌，新坟数尺奈愁何。\n鸡林贾客无从问，收拾篇章有几多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方通判良翰 其一","author":"林光朝","text":"楼橹千重铁作门，不堪聚米更重论。\n居延岁月那相似，一听悲歌一断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林通判德溥 其一","author":"林光朝","text":"岂为长者畏时名，梁楚何从得此声。\n只隔螺江衣带水，自应别驾旧廉平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林通判德溥 其二","author":"林光朝","text":"噫呜双柩出平川，五月黄梅欲雨天。\n长愧江南徐孺子，只鸡斗酒是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人问仁者安仁","author":"林光朝","text":"千年古道万年堤，老牯循循不解迷。\n牧子不知何处在，乱山荒草鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答人问忠恕而已矣","author":"林光朝","text":"南人偏识荔支奇，滋味难言只自知。\n刚被北人来借问，香甜两字且酬伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道桐庐有诗示成季","author":"林光朝","text":"此是滩头处士家，我从何日离天涯。\n木棉高长云成絮，瞿麦平铺雪作花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日同出真珠园再用前韵","author":"林光朝","text":"来自清源葛已覃，君王问猎我犹堪。\n百年耆旧如重见，九日登临得纵谈。\n才子不知汾水上，仙人长在大江南。\n明珠照夜应无数，要是层波更好探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十五日道出南昌寄龚帅实之兼呈程泰之刘文潜二漕","author":"林光朝","text":"未应双井即尘埃，似此衣冠得几回。\n国子先生还并驾，洪都新府却重开。\n再三为问滕王阁，第一须登孺子台。\n定向此中脩玩事，江边不道故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上何著作晋之","author":"林光朝","text":"曾向东南识大名，几年怀想浙涛声。\n众人欲杀定谁惜，与世不谐空自清。\n浩气养成天地小，宦情都付羽毛轻。\n三山依约诛茅日，头白归来笑李生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丞相特进观文南阳公挽词","author":"林光朝","text":"一相频虚位，千龄要实才。\n庙谟从此定，边锁未应开。\n东阁尝先到，西州重一哀。\n传家惟俭德，何处著楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅使君安道再有治莆之命取道城外还泉南得来书云已出十里","author":"林光朝","text":"何事风流旧使君，江边听说下朱幡。\n逢迎要问平津邸，准拟来呼垤泽门。\n竹马已喧明月浦，篮舆却出杏花村。\n不知锦瑟流传遍，欲愈头风好细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵","author":"林光朝","text":"却趁秋旻别九韶，扶胥直下听风谣。\n澜翻对酒还终夕，火急催诗在诘朝。\n南国更逢陶令菊，西江莫捍楚人樵。\n自应幕下文书少，节制如今属汉轺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏部尚书林公梅卿挽词","author":"林光朝","text":"百纸梅花赋，声名出渚东。\n向来惟李贺，胜处是扬雄。\n绕屋看书带，逢人说刺桐。\n尚书旧时履，只合步春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵呈胡侍郎邦衡","author":"林光朝","text":"声教从今已远覃，翩翩作者问谁堪。\n石经犹有中郎蔡，金匮曾誇太史谈。\n至竟银钩并铁画，相传海北到天南。\n诸生考古头浑白，禹穴何时更许探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵贺邱国镇致仕","author":"林光朝","text":"桃花流水是家乡，洛下才名四十强。\n自有赤松堪辟谷，那能白首更为郎。\n案头贝叶忘言久，江上莼羹引兴长。\n解后却成香火社，好将诗句细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芹斋诗（并引）","author":"林光朝","text":"春风芹下足迟留，白鸟平田忆旧游。\n说尽轩裳还过眼，读残书卷复从头。\n偶逢隐几何须问，不到投簪便拟休。\n平世声名如皦日，欲将何地置巢由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月九日登越王台次韵经略敷文所寄诗","author":"林光朝","text":"闲陪小队出山椒，为有吴歌杂楚谣。\n纵道菊花如昨日，要看汤饼作三朝。\n千重岭海供横槊，一带风烟听采樵。\n凭仗折冲如此好，不应东去更乘轺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕疾逾旬蒙丞相访问仍辱宠示名篇辄搜枯肠次严韵以塞来使","author":"林光朝","text":"丞相严装似燕居，为怜消渴到相如。\n病多得艾三年远，歌杂成琴十日馀。\n绿野忽传春草句，白头还对朵云书。\n若为追逐园林胜，百转愁肠亦少舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前岁过真阳初识子钦今道出曲江不忍遽分手偶成长句以志两处山川人物之胜亦少慰别来耿耿耳","author":"林光朝","text":"秋崖一夕卷炎蒸，那更挥斤为斲冰。\n碧落旧寻烧药灶，白芒长对读书灯。\n相期大庾何多日，似出浮屠向上层。\n纵有分张吾未老，定从台阁看飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送夹漈先生赴召","author":"林光朝","text":"别墅生涯富古今，凝流梦卜苦追寻。\n一封细札三家市，万卷新书四海心。\n北阙龙吟清昼永，东皋猿啸白云深。\n满怀经济今休靳，闻道苍生渴傅霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别陈侍郎应求知泉州","author":"林光朝","text":"百片牙旗水面长，蔡邕题在刺桐乡。\n十年杯酒开云榭，一样官衔过洛阳。\n我亦携家缘送客，谁能扫地自焚香。\n野桥冲腊寒梅白，莫要登临忆侍郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别奉常林使君黄中易守延平","author":"林光朝","text":"去时胡不到瓜时，上日多应柳絮飞。\n卧辙只缘滕壤少，怀章须要越人肥。\n三千仪礼非绵蕝，五十行春尚綵衣。\n莫爱传经似齐鲁，石渠长是待公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别傅郎中安道持节闽中","author":"林光朝","text":"忽然乡思若为收，莫到三茅最上头。\n二月东瓯看负弩，一天南荡想行舟。\n过家上冢从今数，落絮飞花合昼游。\n料得甘泉来奏计，定应前席莫迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方天贶","author":"林光朝","text":"长者虽云殁，流风尚尔存。\n宗盟修里巷，家法在儿孙。\n马鬣迷新垄，鸠枝恋故园。\n年年春色好，锦障为谁翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽李制干子诚 其二","author":"林光朝","text":"文字纷纷更问兵，秋灯束发尚青荧。\n便令三子成门户，却许诸孙说典型。\n隔水忽传朝露曲，行人长数夕阳亭。\n河东健笔惟诸薛，梅子岗边为勒铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽桂林戴别乘敦常","author":"林光朝","text":"杖屦何年别，杉松古道旁。\n城山秋月尽，南岭暮云长。\n古调愁难合，孤根幸勿伤。\n欲将数行泪，重至郑公乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉题游洋张明府流香亭时以荐章数下涉秋月马首且欲西矣因以寄意云","author":"林光朝","text":"封题青李数绯桃，处分园林意自豪。\n旋出篇章陪乐府，更凭花木续离骚。\n酴醾架下提春榼，薝卜林中滴夜槽。\n却是秋风生马耳，未应老大笑牛刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东宫生日六首 其四 乙未","author":"林光朝","text":"应律随豳雅，旋杓建戌方。\n前星迎霁色，重日丽晨光。\n笙管青霞外，宫庭碧玉傍。\n本支周道盛，羽翼汉图昌。\n左右人皆正，刑名学未遑。\n编年听司马，说礼付高堂。\n天乐来三殿，人心系八荒。\n黄华秋更媚，皓月闰偏长。\n清赏新奎壁，承华旧典章。\n维熊千岁祝，英略似君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东宫生日六首 其六 丁酉","author":"林光朝","text":"仙掌晴烟外，龙楼晓日傍。\n汉图元自定，周历一何长。\n胄席缘三老，奎文在六章。\n高禖曾郁郁，乔桂自苍苍。\n冠屦来储禁，规模出上方。\n名官分庶子，说礼继高堂。\n娈彼黄花月，依然碧玉墙。\n至尊飞寿斝，太上引天香。\n景运千龄协，先秋九日凉。\n铜扉供帐少，俭德似君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东宫生日六首 其一 壬辰","author":"林光朝","text":"北阙云为堞，东明玉作宫。\n猗兰迎晓日，仙掌倚晴空。\n笙律随鸣凤，朝仪趁彩虹。\n黄麾初入仗，青桂自成丛。\n冠屦分前后，图书考异同。\n商盘如目击，羲画自心通。\n慈燕来三殿，驩谣在九功。\n长秋传夜饮，京兆报年丰。\n奕奕还嘉祐，绵绵想建隆。\n庶僚何所祝，再拜续维熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东宫生日六首 其五 丙申","author":"林光朝","text":"正气来嵩岱，祥光集斗牛。\n青葱开玉宇，髣髴见铜楼。\n盘错归三辅，沉潜在九畴。\n有光文字馆，仍系帝王州。\n钟鼓于胥乐，笙鸾独上浮。\n清台天似水，甲观月如钩。\n屡拜椒花夕，长逢桂叶秋。\n孝思维继舜，家法要从周。\n赋为游麟作，官因洗马留。\n愿同眉寿祝，使者敢停辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东宫生日六首 其三 甲午","author":"林光朝","text":"仙掌秋容媚，铜楼晓色迟。\n猗兰成汉殿，苞竹入周诗。\n鼎卜卿云合，郊禖彩仗移。\n隆兴乾道日，建武永平时。\n詹事开新府，长秋缀旧仪。\n礼经犹下问，易道本生知。\n世子家为法，文王我所师。\n诞弥重海润，清赏一天慈。\n九月黄金蕊，千龄白玉卮。\n遥闻三殿喜，高颂走天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东宫生日六首 其二 癸巳","author":"林光朝","text":"昭代璿源远，高秋宝月前。\n神光浮蜀道，瑞气贯秦川。\n银榜应如旧，金茎若个边。\n龙楼清昼出，鹤禁彩云连。\n妙选衣冠薮，旁开道德渊。\n重爻分九六，曲礼尽三千。\n岁闰缘长历，霜清欲上弦。\n每看禖燕日，已入梦熊篇。\n沆瀣通三殿，笙鸾共一天。\n东明到西极，作颂自年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞竹鸡","author":"林光朝","text":"疏篱短短花枝阑，鸠妇不鸣天雨寒。\n鸠妇离家三百日，亦有姊妹依故山。\n黄粮不肯啄，欲去羽衣残。\n主人一见一怜汝，抱取东家竹鸡来戏聚。\n孤村落日不相识，各各哀鸣求其主。\n两鸟勿惊遽，低头听我语。\n鸠妇入我家，必杀入我口。\n床头瓶罂无馀粒，养汝一到十日后。\n东堂数竹夹新蹊，儿童牢落惟爱一竹鸡。\n堂心有眢井，饥则哺其泥。\n主人缘窗安净几，丹碧相依安用此竹鸡。\n竹鸡慎勿傍人飞，我屋三间沉白蚁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":27963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]