[{"title":"次韵别方时父","author":"刘克庄","text":"我于中垒谱相通，君唤玄英作祖翁。\n每恨暮云一樽隔，暂欣夜雨对床同。\n为晨门黍谈清宿，留剡溪舟避逆风。\n众作纷纷鸣瓦釜，黄钟聊复鼓于宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵别宋希仁","author":"刘克庄","text":"四山寂寞南塘死，此事今谁得绪馀。\n耳冷不闻前辈论，眼明犹读后生书。\n我如蒲柳惊秋早，君似芙蕖出水初。\n此别未知重面日，可堪回首送轩车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵君节秘书三首 其三","author":"刘克庄","text":"宁作青袍朝士归，烹羔未必胜羹薇。\n易贪尘世好官职，难泯人心真是非。\n战士未收青野骨，将军谁报白登围。\n可怜鸠鴳藩篱下，岂识垂天翼怒飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵君节秘书三首 其二","author":"刘克庄","text":"又从天禄閤中归，厌太官羊忆苦薇。\n伋瑗昌言忧国事，永钦沽直暴君非。\n贵人高爵悬金印，狎客闲情减带围。\n独有冥鸿惜毛羽，刺天未肯羡群飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵君节秘书三首 其一","author":"刘克庄","text":"甫登鳌顶浩然归，岂是区区较粟薇。\n纵使吠声杂尧桀，可无直笔辨聃非。\n雷音首占第一义，黛色终当四十围。\n想见朝阳鸣未已，在岐山下莫高飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴帅卿宴高年二首 其二","author":"刘克庄","text":"古尊德齿贱功名，叔季徒知外物荣。\n直把舆台烦绛老，绝无几杖赐樊英。\n旄期宜序于乡饮，诗兴尤浓似宦情。\n闻说淹中方起蕝，诏书行致鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吴帅卿宴高年二首 其一","author":"刘克庄","text":"礼重耆年与令名，由来椿菌异枯荣。\n卑辞昔有迎商皓，名画今谁写洛英。\n应共盖公谈治道，素知严丑富□情。\n可怜衰悴难扶曳，不是元戎外老生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张秘丞劝驾","author":"刘克庄","text":"一纸黄书举茂才，使君后挽复前推。\n似闻太史占奎宿，先敕天官起蛰雷。\n唐世科场先进士，汉家郊庙要抡魁。\n白头乡老殷勤处，西望旗铃送喜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张秘丞皱玉诗","author":"刘克庄","text":"雨湿红裳靡待秋，摘来深愧木瓜投。\n祗今陈紫无真本，比昔姚黄胜一筹。\n聊荐金盘蠲渴肺，不烦绮席啭歌喉。\n圣朝仁远停包贡，赖有公诗为拔尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李仓春游一首","author":"刘克庄","text":"秧马从今渐可行，林鸠未好便呼晴。\n敢云使者乘轺传，聊为君王式耦耕。\n有一日留忧职旷，无三宿恋觉身轻。\n此生不复持高论，愿友台佟与尚平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵使君劭农一首","author":"刘克庄","text":"朱幡奉诏省春耕，扫去阴霾旋放晴。\n应有罗敷随马看，不烦桃叶渡江迎。\n棠阴民各为封植，木德侯方体发生。\n少借一年天肯否，要看穑宝得秋成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵实之二首 其二","author":"刘克庄","text":"向来岁月半投闲，莫叹朝朝苜蓿盘。\n身后芬芳聊自诳，眼前腥腐饱曾餐。\n虫鸡一笑何须较，花鸟相疏恐被弹。\n清议自为儒者设，未应羁束老黄冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵实之二首 其一","author":"刘克庄","text":"孤臣去国四经春，迹远安知罪尚新。\n蚤亦曾讥秦氏者，晚为与议濮园人。\n懒笺光范干时宰，且伴田家赛社神。\n醉倒不能愁世事，倩他烟柳替含颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵实之春日二首 其二","author":"刘克庄","text":"梅醭朝衣尘满靴，曾穿细仗对延和。\n角巾久已寻初服，锦帐何须恋旧窝。\n能读书人天下少，不如意事古来多。\n半生寂寂因迂阔，垂老方惊岁月蹉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵实之春日二首 其一","author":"刘克庄","text":"向来文字擅中朝，留落而今赋大招。\n才子左迁追屈贾，相君高蹈友松乔。\n山行或与樵争席，涧饮聊将掬代瓢。\n借使终身无一事，亦令千载仰孤标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵建安章南举投赠","author":"刘克庄","text":"薄有田园兴，闲挑草木情。\n殷勤美年少，存问老书生。\n晚觉论心少，谁堪歃血盟。\n吾衰得吟友，不惮揽衣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林太渊二首 其二","author":"刘克庄","text":"时贤多以刻为明，抚字催科鲜并行。\n闻旧吏民皆向化，喜新令尹不求赢。\n察帘外事非中道，立路傍碑亦近名。\n莫比寻常贵公子，长官清若一书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林太渊二首 其一","author":"刘克庄","text":"齿宿何妨意尚新，向来误认假为真。\n漏名左相门首客，占籍愚公谷里人。\n上知岂无千虑失，下官惟有两眉颦。\n史臣传与颂台谥，未抵杯中物切身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵优奏良爌投赠二首 其二","author":"刘克庄","text":"秃翁无物可将行，在野安能致鲁生。\n曾伏端门攻鬼质，始知中垒是宗英。\n君如丹凤鸣尤伟，彼化黄熊罪尚轻。\n田里诵言仁圣悔，天其或者再升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵优奏良爌投赠二首 其一","author":"刘克庄","text":"不留妄念著胸中，弋者何心更慕鸿。\n畴昔直前焚戆草，即今殿后著谈丛。\n放言遣兴诗瓢满，野史诛奸笔钺公。\n埋骨家山百无恨，圣贤厄蔡更徂东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵寄题建阳马氏亦乐园","author":"刘克庄","text":"匹如迂叟洛中园，花竹依稀五亩宽。\n梧树参天栖凤集，桧根入地蛰龙蟠。\n翁求真乐希颜子，世著清名慕邴丹。\n身是双溪前令尹，胜游蹉过不曾观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵庾使左史中书行部二首 其二","author":"刘克庄","text":"渭树江云春复冬，安知今夕一尊同。\n放还颇有诗招隐，饿死断无文送穷。\n笑我垂车老骑犊，喜公下马气如虹。\n暮年未敢忘忧国，白发丹心每愿丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵庾使左史中书行部二首 其一","author":"刘克庄","text":"朝回暖律变严冬，应念闽风与蜀同。\n丛棘冤皆为洗雪，发棠惠遍及饥穷。\n冰寒吏胆照天烛，泉涌诗肠饮涧虹。\n帝遣二星临七聚，不妨击壤和元丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄户曹问讯二首 其二","author":"刘克庄","text":"残年宜去亦宜休，出处输渠第一流。\n华表归三千岁鹤，具区有四十蹄牛。\n吟薰风殿曾微讽，祖夕阳亭尚隐忧。\n乾鹊噪檐无别喜，书筒诗卷远相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄户曹问讯二首 其一","author":"刘克庄","text":"理窟骚坛两罢休，倒持麈柄让名流。\n向来袒裼欲暴虎，老去短衣聊饮牛。\n敛退始知颜巷乐，迂疏空抱杞天忧。\n名山何处无灵药，长笑痴人入海求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄帐干","author":"刘克庄","text":"瘦马虺隤已卸鞯，纵鞭其后不能前。\n才非应氏惭三入，齿较杨雄长十年。\n发老病馀偏种种，腹空虚甚谩便便。\n故人过矣相称誉，敢挹衰残望昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄景文投赠三首 其三","author":"刘克庄","text":"谁道樗翁未苦衰，强扶鹤膝自支持。\n无闲心力篆雕赋，下死工夫锻鍊诗。\n诸友多迁幽谷木，此郎今借上林枝。\n暮龄喜读君章句，平易中间伏怪奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄景文投赠三首 其二","author":"刘克庄","text":"记闻荒落语詹谆，惭愧吾侪肯问津。\n未必夜深埋雪者，得如春暮舞雩人。\n师扬执戟玄犹白，学卫夫人字逼真。\n跳出䪿门殊未得，堪怜老却苦吟身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄景文投赠三首 其一","author":"刘克庄","text":"身如倦翼晚知还，且免群儿谤务观。\n官酒灰多宁勿饮，监书字大亦难看。\n颂称吉甫宣王美，帖报殷生宰相安。\n近世风流惟贺八，脱朝冠去著黄冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汤熨","author":"刘克庄","text":"汤熨沉绵弥半载，未尝寸步出村居。\n登翘材馆多新贵，归善和坊守旧书。\n有客嘲杨雄拓落，无人问李白何如。\n腐肠端为肥脓尔，且课畦丁力灌蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕","author":"刘克庄","text":"千炬金栀映玉蕖，台城昨梦又年馀。\n断无弦索鸣华屋，惟见炊烟起草庐。\n儿报瓶空因止酒，婢言油尽暂停书。\n蓬窗亦有精勤士，何必然藜向石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕二首 其一","author":"刘克庄","text":"久矣庞公懒入城，偶逢节序尚牵情。\n盛鸱夷酒出行乐，铸袅蹄金难买晴。\n不与贤豪竞华毂，且随儿女看优棚。\n老儒更为明时喜，闻说西南黑祲清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕二首 其二","author":"刘克庄","text":"本子流传自柳荣，著行线綵斗鲜明。\n似从傀儡家传出，又说熙河帅教成。\n边地烽烟差向里，中州灯火尚承平。\n何尝夜夺昆崙隘，真为君王奏凯声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕二首呈刘帅 其一","author":"刘克庄","text":"士女如云服珥鲜，暂陪猎较亦欣然。\n清于坡老游杭市，俭似乖崖在剑川。\n使指何功烦卜夜，遨头此念可通天。\n粤人拥道千层看，不见狨鞍三十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕守舍","author":"刘克庄","text":"百口惟翁懒入闉，欢传画隼出行春。\n冶容淇上多游女，群饮街头有醉人。\n听黑箫韶成假寐，映青藜杖是前身。\n不知谁侍传柑宴，早为君王靖塞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祁阳县","author":"刘克庄","text":"入境少人烟，寒江碧际天。\n小留因买石，久立待呼船。\n笛起渔汀上，鸥飞县郭前。\n若无州帖至，令尹即神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祁阳道中","author":"刘克庄","text":"昨过知岑寂，重来况雪天。\n人居鸡栅里，路在鸟巢边。\n草市开还闭，茅山断复连。\n潇江清似镜，悔不问归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹湖李内翰哀诗二首 其二","author":"刘克庄","text":"自古稀全传，于今独重名。\n羞蒙彼相力，宁伴此君清。\n加璧犹坚卧，支筇或散行。\n过江不大用，汪李两端明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹湖李内翰哀诗二首 其一","author":"刘克庄","text":"鳌顶纶言古，蝇头谏草忠。\n予环犹昨日，赐扇忽秋风。\n貌肃深衣叟，官同秃鬓翁。\n百年会有别，不料许匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪以余得第七孙惠诗次韵一首","author":"刘克庄","text":"衡门忽有满堂宾，皆诧瞿聃抱送麟。\n懒作柳边退朝客，宁为花下弄孙人。\n小年置膝尤钟爱，晚岁含饴当食珍。\n吾万卷书将付汝，胜如制诰水银银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪生日二首 其二","author":"刘克庄","text":"试把过江人物数，溪翁之外更谁哉。\n不争百草群芳长，宁殿千花万卉开。\n周庙瑟曾三叹咏，舜廊琴亦载赓来。\n老人高唱儿童和，眼见蟠桃熟几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪生日二首 其一","author":"刘克庄","text":"两翁虽老殊精悍，笔力纵横可掣鲸。\n晚各为农同保社，昔偕谒帝入承明。\n不嫌华发称遗老，犹冀馀年看太平。\n从古文章家鲜继，弓寮自可主齐盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其七","author":"刘克庄","text":"趁潮生处先抛网，卧月明中不脱蓑。\n晚学铜人缄不语，早知铁汉钝难磨。\n嗫嚅吾欲多长庆，钩画君真逼永和。\n自剔灯花看吟草，夜阑不觉晓牌过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其四","author":"刘克庄","text":"宾戏两翁迂阔甚，金章换得笠并蓑。\n君从老艾传衣钵，仆似元城耐捣磨。\n岁晚石交惟竹伴，古来鼎味待梅和。\n冻泥滑滑村居僻，今雨无人肯见过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其六","author":"刘克庄","text":"尽卸丝鞭并席帽，全装雨笠与烟蓑。\n国南秦畤坛方筑，塞北燕然石未磨。\n本草书难寿炎帝，长绳系不住羲和。\n回仙郎在人间世，万一飘然袖剑过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其三","author":"刘克庄","text":"矍铄翁徒誇被甲，玄真子自爱衣蓑。\n昏花安得金篦刮，荒落犹将铁砚磨。\n雄思湛深空自好，郊鸣寒苦几时和。\n木鱼差异炎凉者，不鄙柴门夜夜过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其五","author":"刘克庄","text":"不羡上公被雉衮，宁为野老著牛蓑。\n素无文思加衰竭，薄有时名合折磨。\n幸老舍人工润色，逢新天子建中和。\n子来犹自商歌在，旧友何须裹饭过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其一","author":"刘克庄","text":"辇路曾联花底辔，钓矶共著雪中蓑。\n璧瑕自是难为掩，言玷谁云不可磨。\n烦锦绣肠施月斧，洗筝笛耳听云和。\n两翁弄此穷生活，户外浑无客屦过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪评余近诗发药甚多次韵 其二","author":"刘克庄","text":"经旬积潦慵扶杖，拂晓新晴喜晒蓑。\n掣电光阴难把玩，浮云富贵易消磨。\n蜗牛庐只依通德，虫蠹书犹在善和。\n除是鬳翁名父子，别无好事者经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪间道至水南不入城而返小诗问讯","author":"刘克庄","text":"牛屋方将同扣角，渔矶亦拟共披蓑。\n即今耆旧多凋谢，从古文章要琢磨。\n一老少曾闻正始，六人五已相元和。\n白头赖有溪翁伴，颇怪高轩不我过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪和予喜大渊至二诗复叠前韵 其二","author":"刘克庄","text":"力绵恩重老难任，箧有龙绡橐有金。\n犹记席前曾见问，安知泽畔自行吟。\n吾闻正始声初吐，子有元和脚可寻。\n今大宗师惟阁老，蝉嘶未必不知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹溪痔后齿痛小诗问讯","author":"刘克庄","text":"天寿斯文嘿护持，区区二竖莫儿嬉。\n炊糜足以留佳客，啖面贤于聘上医。\n渴见紫芝常入梦，共游黄檗屡愆期。\n溪边雨过春泥滑，借问门前裹饭谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"羊毫笔","author":"刘克庄","text":"拔到髯生族，多因兔颖稀。\n只宜茅舍用，难向玉堂挥。\n弄翰虚名似，吹毛本质非。\n儿曹贪价贱，鸦蚓扫如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老大","author":"刘克庄","text":"老大重登聘士台，客怀牢落可曾开。\n临流往往看鸢堕，入署时时见马来。\n有约青山何日去，无根白发是谁栽。\n自嫌不带功名骨，只合眠莎与坐苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老马一首","author":"刘克庄","text":"脊疮蹄蹇瘦阑干，火印年深字已漫。\n野涧有冰朝洗怯，破坊无壁夜嘶寒。\n身同退卒支残料，眼见新驹鞁宝鞍。\n昔走塞垣如抹电，安知末路出门难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老叹一首","author":"刘克庄","text":"少豪扛鼎复搴旗，倏忽才情已竭衰。\n今无百斤金买赋，古有九千缣作碑。\n毛锥尽秃难藏老，麈尾高悬合授谁。\n他日学人求肘后，不消挽些与哀词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老欢","author":"刘克庄","text":"功名幻妄炊粱枕，岁月奔忙下坂轮。\n昔作时来木居士，今为暑退竹夫人。\n白襦裙稳于归衮，黄独苗甘似食珍。\n老汉秃残惟齿发，不妨句子尚尖新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老欢","author":"刘克庄","text":"宿昔髫年忽旄期，登临筋力尚支持。\n酒肠无恙重开禁，药性皆谙懒问医。\n夜漏犹披灯下卷，春风不染镜中丝。\n销磨未尽惟吟癖，锻了新诗改旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老妓一首","author":"刘克庄","text":"籍中歌舞昔驰声，憔悴犹存态与情。\n爱说旧官当日宠，偏呼狎客小时名。\n薄鬟易脱梳难就，半被常空睡不成。\n却羡邻姬门户热，隔楼张烛到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老将一首","author":"刘克庄","text":"昨解兵符归故里，耳听边事几番新。\n偶逢戏下来犹识，欲说辽阳记不真。\n儿觅宝刀偏爱惜，奴吹芦管辄悲辛。\n夜寒忽作关山梦，万一君王起旧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自用台字韵一首","author":"刘克庄","text":"脱了荷衣事将台，羁留又见岭梅开。\n诗因癸水辰山作，讼自雷州电县来。\n架上书从人借读，墙边竹是俸移栽。\n小窗睡起无情味，闲听饥禽啄砌苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和二首 其一","author":"刘克庄","text":"横身久塞杨朱路，洒泣俄悲墨子岐。\n陋矣射钩而中者，壮哉鸣鼓以攻之。\n侍读自无迁府分，中丞还有僦船时。\n八风舞罢君恩歇，赢得闲愁上两眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和二首 其一","author":"刘克庄","text":"□□□间不知裁，老思安能更夺胎。\n九制一挥嗟事在，重□双导系时来。\n拟营草具留连赏，莫放花神取次开。\n堪叹吾门今寂寂，过江曾有两抡魁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]