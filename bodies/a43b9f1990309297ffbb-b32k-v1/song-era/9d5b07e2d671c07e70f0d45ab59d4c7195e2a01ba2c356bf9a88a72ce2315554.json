[{"title":"访紫芝回与子舒集","author":"葛天民","text":"君参唐句法，亲得浪仙衣。\n薄宦因吟苦，高风与世违。\n春寒留夜饮，月黑借灯归。\n共隐知何日，空山老蕨薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访端叔提干","author":"葛天民","text":"月趁潮头上，山随柁尾行。\n大江中夜满，双橹半空鸣。\n雁冷来无几，鸥清睡不成。\n平生师友地，此夕最关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"葛天民","text":"暮年居柳下，终日闭柴门。\n壁为题诗暗，池因洗砚浑。\n闲知真富贵，醉到古乾坤。\n回首长安道，无言只断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀天竺涧梅","author":"葛天民","text":"根在岩边结，枝从水际横。\n此花殊近道，凡木欠修行。\n密雪笼幽片，疏篁倚瘦茎。\n那时香不浅，忆我话无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杏花","author":"葛天民","text":"陌上春泥苦未乾，绛唇渐吐不禁寒。\n海棠尚晚教谁伴，山帽冲风每自看。\n声好最怜清晓卖，味甘长记绿阴团。\n年年过雨胭脂落，时序关心有几般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎燕","author":"葛天民","text":"咫尺春三月，寻常百姓家。\n为迎新燕入，不下旧帘遮。\n翅湿沾微雨，泥香带落花。\n巢成雏长大，相伴过年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子舒冷泉夜坐","author":"葛天民","text":"亭空山尽入，人静夜初分。\n乔木阴遮月，清泉影浸云。\n不题波上叶，只采涧中芹。\n涧水令人忆，何当入郡闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山后写望","author":"葛天民","text":"凭高每叹昔人非，空有群峰碍落晖。\n大雅风流谁举似，长安秋草又衰微。\n寒花负约开犹懒，幽鸟忘机趁不飞。\n来往半生堪记处，西村灯火夜船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山后舟中写望","author":"葛天民","text":"水接遥空分外宽，孤山月出静中看。\n疑从弱水移圆峤，似共姮娥住广寒。\n秋雨秋风初过后，荷花荷叶半凋残。\n西村数点归鸦湿，老子新题墨未乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林间石","author":"葛天民","text":"摩挲只作钓矶看，相伴秦翁且住山。\n霜洗旧棱人共瘦，藓侵孤韵鹤同闲。\n因思樵牧分争处，已过唐虞揖逊间。\n风月满林时憩寂，三生幽事梦中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩蝶","author":"葛天民","text":"粉翅来何许，春风卒未休。\n众芳皆旧识，微雨是新愁。\n斗舞围墙角，贪香缀蕊头。\n与花俱不语，相可自风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊园避暑","author":"葛天民","text":"有暑犹当避，无忧可得忘。\n竹疏身共瘦，湖近意先凉。\n静胜宁须弈，幽酣不待觞。\n还同残梦乐，炙背负朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中","author":"葛天民","text":"梅雨朝仍暮，莲塘夏似秋。\n水高侵树脚，屋漏滴人头。\n歇昼厨烟出，占晴础汗收。\n群山思会面，扶病一登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝青梅","author":"葛天民","text":"疏影横斜处，匆匆入夏看。\n绿阴遮得暗，青子结来酸。\n因病全疏酒，如痴犹凭栏。\n杨花无藉在，风急正漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居","author":"葛天民","text":"远怀日与静相宜，山色窥帘涧撼扉。\n野草自花聊献笑，重云不雨谩垂衣。\n人间事业难争长，睡里工夫独造微。\n却怪蒙庄犹寐语，梦为胡蝶未忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日西湖闲泛","author":"葛天民","text":"雨洗千峰晓，波涵万顷秋。\n菱花开古镜，莲叶度轻舟。\n思远人谁识，身闲世不收。\n望中时得句，倚棹杂吴讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛子舒 其一","author":"葛天民","text":"南渡今何似，中流欲济船。\n虽凭人击楫，要若水行川。\n竹木如山积，桑田与海连。\n吴宫犹可问，白鸟暮推烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛子舒 其二","author":"葛天民","text":"海邑青龙镇，船官野鹤身。\n谁知贵公子，却是苦吟人。\n二陆多遗迹，三高属近邻。\n新篇因吊古，时寄葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛予舒船官","author":"葛天民","text":"忆君江上去，船重载书多。\n学乃从吾好，闲应喜客过。\n薰风新绿树，明月旧沧波。\n自古关情处，相思入咏歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻杜鹃","author":"葛天民","text":"望帝知何苦，催归不自禁。\n窜身依树密，啼血染花深。\n细雨离人泪，游丝荡子心。\n青山明月夜，老耳最知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日","author":"葛天民","text":"晓荷承坠露，晚岫障斜阳。\n树下地常荫，水边风最凉。\n蝉移惊鹊近，鹭起得鱼忙。\n独坐观群动，闲消夏日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日池上","author":"葛天民","text":"微波漾漾雨濛濛，岸脚烟莎间水荭。\n照影已无双鬓绿，关心犹有一丝风。\n鸳鸯对浴红衣扑，菡萏相亲翠盖笼。\n醉舞梦吟皆胜处，个中非异亦非同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答赵紫芝","author":"葛天民","text":"九月离东嘉，长安了岁华。\n未登杨子渡，先访葛翁家。\n天作今朝雪，灯开昨夜花。\n一杯能强饮，不必问丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃花","author":"葛天民","text":"洞里桃花自古初，人间尘事几乘除。\n重来渔父难相觅，前度刘郎未忍疏。\n画楫迎逢春女渡，采符供奉岁朝书。\n嫣然似共幽篁语，占尽风光奈得渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涧泉招饮次日乃生朝","author":"葛天民","text":"平生南涧古遗民，初度招呼我辈人。\n每听谑谈须绝倒，极知老气政轮囷。\n杯盘满坐添灯火，儿女成行劝主宾。\n但愿吾侪似梅柳，年年相见一回新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷叶浦中","author":"葛天民","text":"急雨捎荷分外奇，珠玑狼籍锦纷披。\n下塘六月关心处，西塞扁舟入手时。\n却傍青芦深处宿，还思白石去年诗。\n平生浩荡烟波趣，月淡风微只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"葛天民","text":"始参龙象种，终现马牛身。\n再整冲冠髻，难忘漉酒巾。\n散花天上女，拨草道中人。\n寄语林和靖，非翁不卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿裴庵","author":"葛天民","text":"一径松杉迥，成阴见日稀。\n山晴僧尽出，风暖燕交飞。\n结子花抛树，拦人犬护扉。\n闲看山月上，清坐更添衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"葛天民","text":"寄远含芳别陇头，胡沙漠漠去无休。\n谁招青冢千年魄，散作黄昏万斛愁。\n画角霜清肠屡断，花光墨淡影空留。\n年年最忆前村夜，一段孤明雪亦羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"葛天民","text":"桃李粗疏合负荆，岁寒标格许谁并。\n花中有道须称最，天下无香可斗清。\n倚竹向人如少诉，临流窥影更多情。\n何当唤取湘累起，伴我空山茹落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明前四日泛湖","author":"葛天民","text":"绕岸堆青嶂，游船满绿波。\n楼台临水近，杨柳占春多。\n老去谁同调，尊前且放歌。\n韶华能几日，随棹已新荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后 其一","author":"葛天民","text":"雪中多日静，湖上少人游。\n秃树花为市，断槎鸥当舟。\n一杯残腊酒，万古夕阳愁。\n富贵非吾愿，葛天云正浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上夜归","author":"葛天民","text":"陌上红尘歇，湖中翠霭生。\n定钟山寺迥，新月夜船清。\n蛙乱鸣方急，鸥闲睡不惊。\n儿曹知我到，认得打门声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖村晚兴","author":"葛天民","text":"残霞伴孤鹜，远烧杂斜晖。\n秋向诗中出，人从画里归。\n柳塘双桨急，茅舍一灯微。\n小艇穿篱入，蒲蓬正拥扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖堤晚步","author":"葛天民","text":"照影怜寒水，关情奈夕阳。\n雪悭天欠冷，年近日添长。\n好句谁相寄，浮生各自忙。\n有身聊顿放，亡事可思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊雪","author":"葛天民","text":"片片嘉平瑞，无声有耿光。\n来虽成顷刻，酿亦费商量。\n天阔花无赖，风休絮不狂。\n孤山林处士，魂在陇头香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢文思徐敬伯见访","author":"葛天民","text":"半山徐敬伯，薄宦在中都。\n柳舍偷闲到，村醪就近酤。\n易添诗债负，难得醉工夫。\n却羡渔樵叟，虽贫一事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简赵紫芝","author":"葛天民","text":"紫芝虽漫仕，五字已专城。\n清坐有仙骨，苦吟无宦情。\n囊因诗句重，分与酒杯轻。\n所好煎茶外，烧香过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简道安","author":"葛天民","text":"相将除夜南风起，雁已声声向北飞。\n骤暖定知为雪骨，瘦年终不似冬肥。\n日来病可方开酒，节下春回稍减衣。\n正好伴公湖上去，孤山观里看梅归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓬居咏枇杷","author":"葛天民","text":"早诵相如赋，知渠旧姓卢。\n花香冰里见，风味药中须。\n细雨同梅熟，清声混乐呼。\n山禽嗔老子，拍竹护金珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬画上人石湖春望","author":"葛天民","text":"荡荡春风草木香，茫茫泽国水云长。\n莺来占柳为歌院，蝶去寻花作醉乡。\n闲与物情聊品带，老于文字懒巡行。\n望中别有关情处，几度朝阳又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题谢耕道一犁春雨图","author":"葛天民","text":"耿耿思田舍，攸攸倚钓竿。\n一犁歌短阕，十口饭长安。\n老觉驱驰倦，生知稼穑难。\n画图诗卷在，留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕","author":"葛天民","text":"天街夜鼓彻云霄，一望星河影动摇。\n佳节无如元夕盛，老怀不似少年豪。\n红尘巷陌青丝鞚，明月楼台紫玉箫。\n谁料南坡招野叟，诗肩相对两峰高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月一日同姜白石泛湖","author":"葛天民","text":"六月西湖带雨山，小舟终日傍鸥闲。\n风烟如许关情甚，宾主相推下语难。\n几点送君归大雅，一凉今夜满长安。\n江湖远思知多少，归去风前各倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平居遣兴","author":"葛天民","text":"隔篱人语自喧嘲，紧闭苔扉不许敲。\n谈麈带尘悬屋角，牵牛承露上林梢。\n投闲得计心常足，拟古成编手自抄。\n风雨欲来偏感处，蚁先移穴鹊移巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊辰夏五过抱朴岩","author":"葛天民","text":"北窗隐隐透南薰，老子全身是此君。\n冷入鱼腮池面雨，静连禽语树头云。\n苔因觅句行来破，石为观空坐得温。\n时事自多无耳听，长安虽近不曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"收白匾豆因得二首 其二","author":"葛天民","text":"古香无伴侣，一榻共云分。\n涧水塘头过，樵歌枕上闻。\n余生聊自适，此意与谁论。\n落叶如相委，时敲月下门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"收白匾豆因得二首 其一","author":"葛天民","text":"齿发中年态，丘园素隐心。\n因栽白匾豆，欲当紫团参。\n筐筥收繁荚，窗扉失茂阴。\n萧萧檐外竹，抱蔓替予吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗","author":"葛天民","text":"下竺山前打一遭，丁宁门子看溪桥。\n恐惊绕涧梅花落，莫遣行人语笑高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"葛天民","text":"春涨侵高岸，春云裹乱山。\n倒迁杨柳活，斜倚桔槔闲。\n世味老方淡，花时晴最悭。\n东风嗔懒动，故故撼柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中独酌","author":"葛天民","text":"平生寡合虽竭斗，几曾自饮一杯酒。\n不因风月与湖山，更为松篁与花柳。\n今夕何夕风雨来，知侬渴肺生秋埃。\n曲生三缄忽自荐，请为风雨聊一开。\n老夫呼前呼未了，死生脱帽倾怀抱。\n风雨横斜入坐中，宾主淋漓俱醉倒。\n须臾风止雨亦休，主人送客凝双眸。\n葛天无怀不可状，但觉两耳风飕飕。\n匆匆便是中秋节，更与曲生潜地说。\n此夜宁容著杂宾，一尊只办浇明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春怀","author":"葛天民","text":"向晚一鸠鸣，道人春睡足。\n无处写幽怀，巡檐数脩竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳下即事","author":"葛天民","text":"老柳中间野岸滨，水清常照村边身。\n白鸥黄鸟相忘久，来往如今不避人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"葛天民","text":"夜雨涨波高二尺，失却捣衣平正石。\n天明水落石依然，老夫一夜空相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重访白右","author":"葛天民","text":"长安唯白石，与我最相关。\n每到难逢面，翻思懒下山。\n欲归愁路远，小住待君还。\n尽日看幽桂，无人似我闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻鸠","author":"葛天民","text":"蛰动犹寒在，鸠鸣恰睡馀。\n素传鹰羽化，多占鹊巢居。\n报我晴何用，怜渠拙自如。\n年年偏感处，风急杏花初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄杨诚斋","author":"葛天民","text":"参禅学诗无两法，死蛇解弄活鱍鱍。\n气正心空眼自高，吹毛不动全生杀。\n生机熟语却不俳，近代独有杨诚斋。\n才名万古付公论，风月四时输好怀。\n知公别具顶门窍，参得彻兮吟得到。\n赵州禅在口皮边，渊明诗写胸中妙。\n用则致君尧舜前，舍时便灌庐陵园。\n六十四卦只两画，三百五篇惟一言。\n我与诚斋略相识，亦不知他好官职。\n但知拚得忍饥七十年，脊梁如铁心如石。\n不曾屈膝不皱眉，不把文章做出诗。\n玉川后身却不怪，乐天再世尤能奇。\n隔千里兮共明月，何似寒灰相对拨。\n公亦何须要我知，我只欠公头上发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄辅汉卿","author":"葛天民","text":"忆杀平生辅汉卿，武夷山里话寒更。\n不知新岁还家未，白发冲冠有几茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后 其二","author":"葛天民","text":"冷蕊通幽信，孤山欠几遭。\n杯因寒更满，句到淡方高。\n雪滴晴檐雨，松翻夜壑涛。\n布衾虽似铁，犹念早趋朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶","author":"葛天民","text":"黛拂双眉粉衬毫，翅烘晴日伴相遭。\n戏勾稚子从花远，恐惹游丝莫斗高。\n栩栩倏来仍易散，深深交舞为谁劳。\n吴王花草滕王笔，千载风流敌楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉书酒肆","author":"葛天民","text":"碧床酒盎香拍浮，吴姬粉醉不识愁。\n黄金手挥博歌头，夜半春回杨柳楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题南翔寺","author":"葛天民","text":"南翔建自梁天监，白鹤不归江自转。\n深禅空忆祖师齐，昔有老堪今有远。\n我趁江鸥访远公，远公不有湖天晚。\n七岁驱凫有几房，三百苾刍无半面。\n殿阁参差高入云，一堂可著千僧饭。\n古柏槎牙不记年，柯如屈铁色苍藓。\n古意偏关倦客怀，归舟有句无人遣。\n明日中流遇阿英，连宵细说南翔院。\n少待崇莲宝塔成，春风共看巢梁燕。\n我欲婆娑借数椽，子当力学如吾愿。\n一任江花恼杀人，閒边自数飞花片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏","author":"白玉蟾","text":"城中厌雨过清和，偶出西郊野兴多。\n蚕簇趁晴方摘茧，麦场经润欲生蛾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行春辞 其二","author":"白玉蟾","text":"春来春去不知时，只有诗人冷眼窥。\n夜雨揩磨好山色，晓风抬举旧花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 赠紫云友","author":"葛长庚","text":"剑倚青天笛倚楼。\n云影悠悠，鹤影悠悠。\n好同携手上瀛洲，身在阎浮，业在阎浮。\n一段红云绿树愁。\n今也休休，古也休休。\n夕阳西去水东流，富又何求，贵又何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 其二","author":"葛长庚","text":"古寺枕空山，楼上昏钟静。\n饥鼠偷灯尾蘸油，悄悄无人影。\n长剑匣中鸣，今古深思省。\n此夕行藏独倚楼，风雨凄凄冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 景泰山次韵东坡三首 其一","author":"葛长庚","text":"云散雨初晴，蝉噪林逾静。\n古寺敲钟暮掩门，灯映琉璃影。\n浩气镇长存，昨梦还重省。\n独倚阑干啸一声，毛发萧萧冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]