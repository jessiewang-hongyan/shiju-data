[{"title":"荔枝堂夕眺三首 其一","author":"杨万里","text":"夕峰褪日半钲多，秋汉吹云一絮过。\n寂寂庭松今两月，鹤雏去尽只留窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其十","author":"杨万里","text":"光尧初御六龙天，上直维参大火躔。\n天意分明昌宋德，诞辰三世总丁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其九","author":"杨万里","text":"少阳拜赐太阳旁，黄菊红萸满寿觞。\n阳德重重在初四，不须九日是重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其八","author":"杨万里","text":"禹子汤孙兼圣贤，一身双美古无前。\n愿陈万国元良句，不用金昭玉粹篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其七","author":"杨万里","text":"菊花潭上菊花开，不是花潭是寿杯。\n天赐生朝千斛水，一年一斛送将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其六","author":"杨万里","text":"大安宫里漆园椿，子干孙枝叶叶新。\n今日四株高下碧，相承一样八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其五","author":"杨万里","text":"明河查上有仙翁，犯月撞星到碧穹。\n金阙东边银榜处，大书天地长男宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其四","author":"杨万里","text":"二圣多能似仲尼，储皇家学自庭闱。\n银钩已有淳熙脚，玉句仍传德寿衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其三","author":"杨万里","text":"子晋吹笙未是仙，阿丕横槊少全篇。\n小吟春著梅梢句，一日东风四海传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其二","author":"杨万里","text":"清赏堂中无管弦，凤山楼上有云烟。\n储皇侧畔何人侍，黄卷团栾是圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵村","author":"杨万里","text":"杏花千树洛阳春，白傅年年爱赵村。\n月蕊晴葩风露格，老夫移得在东园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其十","author":"杨万里","text":"葱茏晚色正佳哉，苦被归鞍紧紧催。\n船压浮荷沈水底，须臾船过却浮来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其九","author":"杨万里","text":"风撩太液小荷欹，日丽长杨花影低。\n阑入苑中啼不歇，恨身不及一黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其八","author":"杨万里","text":"行尽孤山碧四围，却寻初路得来时。\n好风借与归船便，吹近琼林却不吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其七","author":"杨万里","text":"和靖先生坟已荒，空馀松竹故苍苍。\n王孙自洗鸬鹚杓，满酌真珠酹一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其六","author":"杨万里","text":"橘花如雪细吹香，杏子团枝未可尝。\n行到陈朝枯柏处，孤山山背水中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其五","author":"杨万里","text":"萍生儿子点疏星，荷捲文书立万丁。\n回首南高峰上塔，手中攀得玉竛竮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其四","author":"杨万里","text":"御池水满苑门开，泥带飞花路带苔。\n到得孤山翻作恶，海棠闹日不曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其三","author":"杨万里","text":"船从咏泽过孤山，径度琉璃一簟间。\n隔岸多情杨柳树，向人招唤俯烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其二","author":"杨万里","text":"画舫侵晨系柳枝，主人生怕客来迟。\n娇云嫩日无风色，幸是湖船好放时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵达明太社四月一日招游西湖十首 其一","author":"杨万里","text":"今日清和和又清，王孙领客出都城。\n好天胜日能多少，三到西湖始一晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送乡僧德璘二首 其二","author":"杨万里","text":"湖上诸峰紫翠间，三年欲到几曾闲。\n侬今去处渠知么，不是南山即北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送乡僧德璘二首 其一","author":"杨万里","text":"衲子向来元士子，诗僧遮莫更禅僧。\n不妨参透诸方得，别有宫墙第一层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送乡僧德璘监寺缘化结夏归天童山二首 其二","author":"杨万里","text":"七百支郎夜忍饥，木鱼闭口等君归。\n还山大众空欢喜，只有诚斋两首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送乡僧德璘监寺缘化结夏归天童山二首 其一","author":"杨万里","text":"一别璘公十二年，故当刮目为相看。\n问侬收得曹溪水，雩下春风吹已乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王无咎善邵康节皇极数二首 其二","author":"杨万里","text":"识尽江淮诸贵人，归来卢水一番新。\n问渠福将今谁子，容我升平作倖民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王无咎善邵康节皇极数二首 其一","author":"杨万里","text":"安乐窝中书一编，君从何许得真传。\n我无杜曲桑麻在，也道此生休问天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送卢山人二首 其二","author":"杨万里","text":"有欠牛眠子为寻，剩将朽胔换华簪。\n家阡只免牛羊到，此外穷通得上心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送卢山人二首 其一","author":"杨万里","text":"行尽千山又万山，山真何好子能然。\n青乌纵妙侬曾问，著眼烟云也自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送幼舆子之官澧浦慈利监税二首 其二","author":"杨万里","text":"素王开国道无臣，一榜春风放十人。\n莫羡榜头年十八，旧春过了有新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送幼舆子之官澧浦慈利监税二首 其一","author":"杨万里","text":"估人耕货不耕田，也合供输饷万屯。\n若道厚征为报国，厚民却是负君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘北秀二首 其二","author":"杨万里","text":"赠我盆花十小诗，菖蒲一咏最清奇。\n洞庭卷入坚昆椀，更卷青天入寸漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘北秀二首 其一","author":"杨万里","text":"刘子过逢二十年，别来风月几千篇。\n黄金卖尽延宾友，囊底何须看一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庆基叔往上犹二绝 其二","author":"杨万里","text":"六十慈亲路一千，郎君归省又何年。\n赠行句子真聊尔，且折垂杨当赠鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨山人善谈相及地理","author":"杨万里","text":"相人何似相山难，惭愧渠侬眼不寒。\n木末凉风无半点，如何又欲跨归鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗永年西归","author":"杨万里","text":"梅莟香边踏雪来，杏花雨里带春回。\n明朝解缆还千里，今日看花更一杯。\n谁遣文章太惊俗，何缘场屋不遗才。\n南溪鸥鹭如相问，为报春吟费麝煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客山行","author":"杨万里","text":"岭云为作小凉天，山店重来忆去年。\n独树丹枫谁不见，何须更立万松前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客归至郡圃残雪销尽","author":"杨万里","text":"三日东风入万家，草间残雪不留些。\n儿童道是雪犹在，笑指梅花作雪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客归登净远亭二首 其二","author":"杨万里","text":"池冰动处水生澜，未觉今朝抵死寒。\n便恐雪销难再得，不辞鞋湿数来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客归登净远亭二首 其一","author":"杨万里","text":"犯寒送客只劳神，上到危亭眼顿新。\n雪汁滴人清入髓，莫将衫袖障头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送残秋","author":"杨万里","text":"梦游帝里送残秋，重九真为帝里游。\n十月初头方赐对，痴儿枉却一生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送相士高元善二首 其二","author":"杨万里","text":"稚子烦君一一看，丁宁莫道好求官。\n老来正要团栾坐，伴我秋风把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送相士高元善二首 其一","author":"杨万里","text":"选官选佛两悠悠，元不关人浪自愁。\n洙泗生涯久春草，老夫作么晚回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送翁志道","author":"杨万里","text":"平生翁子妙谈天，谁爱青山不爱官。\n一笑同看岩下井，秋来能更起微澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谈命曾南翔二首 其二","author":"杨万里","text":"今年见说也无锥，政坐谈天泄密机。\n举世近来憎直语，贵人剩许未为痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谈命曾南翔二首 其一","author":"杨万里","text":"官职牵人也可怜，老来那更问行年。\n渠侬解事无它语，道我慈亲寿八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谈星辰许季升二首 其二","author":"杨万里","text":"连珠合璧转璇霄，也被星家不见饶。\n灾曜元来怯梼杌，福星不是背箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谈星辰许季升二首 其一","author":"杨万里","text":"许子儒冠怨误身，如今投笔说星辰。\n未须道我何时贵，且道何时子脱贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谈星辰吴山人","author":"杨万里","text":"牙筹入手风前快，玉李行天镜里看。\n紫闼青规吾不梦，子言欲试故应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送傅山人二绝句 其二","author":"杨万里","text":"谈天渠外更谁先，聊复怜渠与酒钱。\n富贵不愁天不管，不应丘壑也关天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送傅山人二绝句 其一","author":"杨万里","text":"江山有约未应疏，浪自忙中白却须。\n我昔属官今属我，子能略伴瘦藤无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送德轮行者","author":"杨万里","text":"沥血抄经奈若何，十年依旧一头陀。\n袈裟未著愁多事，著了袈裟事更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送瀛洲先生元举叔谈命郡城","author":"杨万里","text":"谁遣谈天太逼真，取憎造物得辞贫。\n不妨小隐君平肆，戏与人间阅贵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其七","author":"杨万里","text":"村里风回市里声，月中人看雪中灯。\n满城只道欢犹少，不道谯门冷似冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其六","author":"杨万里","text":"雪后楼台欲暮时，游人只道上灯迟。\n月轮贴在梅花背，错认梅枝作桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其五","author":"杨万里","text":"不是东风巧剪裁，如何春夜碧莲开。\n江城寂寞无歌舞，唤得梅花劝一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其四","author":"杨万里","text":"儿时行乐几时愁，老去情怀懒出游。\n市上人家重时节，典钗卖钏买灯毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其三","author":"杨万里","text":"忆昔三衢看上元，玉虹横贯水精帘。\n穷州今夕酸寒杀，老眼看来自不忺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其二","author":"杨万里","text":"北使才归南使来，前船未送后船催。\n元宵行乐年年事，儿女嗔人夜不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡中上元灯减旧例三之二而又迎送使客七首 其一","author":"杨万里","text":"红锦芙蓉碧牡丹，今番灯火减前番。\n雪泥没膝霜风紧，也有游人看上元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃上巳二首 其二","author":"杨万里","text":"寻春不见只思还，却在来仙小崦间。\n映出一川桃李好，只消外面矮青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃上巳二首 其一","author":"杨万里","text":"旋收雨夕放晴晨，禊日风光正可人。\n间白参红方是锦，疏桃散李不成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃小梅一枝先开","author":"杨万里","text":"小窠梅树太尖新，先为东风觅得春。\n后日千株空玉雪，如今一朵许精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃残雪三首 其三","author":"杨万里","text":"城外城中雪半开，远峰依旧玉崔嵬。\n池冰绽处才如线，便有鸳鸯浮过来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃晓步因登披仙阁四首 其四","author":"杨万里","text":"只道春来不见痕，风邀雨勒未忺人。\n暄云淑日消多少，花柳匆匆了却春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃晓步因登披仙阁四首 其三","author":"杨万里","text":"百五佳时更绝晨，园丁犹未放游人。\n瘦藤拄上披仙阁，四面花光照杀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃晓步因登披仙阁四首 其二","author":"杨万里","text":"李花半落雪成堆，末后桃花陆续开。\n白锦地衣红锦障，侵晨供张等侬来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃晓步因登披仙阁四首 其一","author":"杨万里","text":"昨来风日较暄些，破晓来游特地佳。\n也自低头花下过，依前撞落一头花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃雪销已尽惟馀城阴一街雪","author":"杨万里","text":"阳林日暖雪全销，阴径琼瑶尚寸高。\n半疋斜铺白花锦，倩谁裁作水霜袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡斋梅花","author":"杨万里","text":"月朵千痕雪半梢，便无雪月更飘萧。\n不应腊尾春头里，两岁风光一并饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕前一日绝句","author":"杨万里","text":"雪留远岭半尖白，云漏斜阳一线黄。\n天肯放晴差易耳，殷勤剩觅几朝霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜小饮叹都下酥乳不至","author":"杨万里","text":"雪韭霜菘酌岁除，也无牛乳也无酥。\n贫中却富何人会，自有村醪不用沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食老菱有感","author":"杨万里","text":"幸自江湖可避人，怀珠韫玉冷无尘。\n何须抵死露头角，荇叶荷花老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食鸡头","author":"杨万里","text":"龙宫失晓恼江妃，也养鸣鸡报早晖。\n要啄稻粱无半粒，只教满颔饱珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食莲子","author":"杨万里","text":"蜂不禁人采蜜忙，荷花蕊里作蜂房。\n不知玉蛹甜于蜜，又被诗人嚼作霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食莲子","author":"杨万里","text":"绿玉蜂房白玉蜂，折来带露复含风。\n玻瓈盆面冰浆底，醉嚼新莲一百蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]