[{"title":"塞下曲","author":"严仁","text":"漠漠孤城落照间，黄榆白苇满关山。\n千枝羌笛连云起，知是胡儿牧马还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘南","author":"严仁","text":"斑竹萧萧水驿孤，落花吹雨赤沙湖。\n春风二月湘南路，何处青山无鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"看雪","author":"严参","text":"天远正难穷，楼高不堪倚。\n醉梦入江南，杨花数千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"河梁值雨有怀严羽","author":"上官良史","text":"苇岸逢残雨，河桥对暮流。\n停鞭一怅望，客思暂夷犹。\n枫叶满江色，夕阳终古愁。\n遥怜君亦苦，不共故园秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻严丹丘东潭居二首 其一","author":"上官良史","text":"爱子东溪幽，抱被来同宿。\n山家无膏火，然薪代明烛。\n閒窗何所有，古书三五束。\n鸟栖月上时，还见檐前竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻严丹丘东潭居二首 其二","author":"上官良史","text":"山斋棂牖疏，水月连春雾。\n今夕定何夕，清心欣所遇。\n如从天姥游，似得招提趣。\n幽梦出云时，匆匆山鸟曙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"上官良史","text":"春城不尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"上官良史","text":"独树临江古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"上官良史","text":"春富野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"上官良史","text":"霜鸿入夜惊还止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"上官良史","text":"海天腊尽冻初融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其一","author":"赵希焄","text":"门敲石鼓叩神灵，洞府巉岩杳霭深。\n直欲九渊惊睡玉，须凭一炷爇香沉。\n几年曾救桑林旱，今日还书鲁史霖。\n妙句不妨留大涤，要知栖凤也来吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其二","author":"赵希焄","text":"谁挽天河响落山，潮声半夜到江干。\n倒流三峡水何击，捲起千堆雪正寒。\n想是蛟从其下舞，料应龙在此中蟠。\n如君大手留吟笔，千古坡诗可并观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题中兴颂下","author":"卫樵","text":"鼎沸渔阳塞马鸣，中兴鸿业幸天成。\n且为当世邦家计，宁问他时父子情。\n李郭功名无可憾，元颜文字有何评。\n若能铭刻燕然石，方许雌黄此颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澹岩 其一","author":"卫樵","text":"嵌岩洞谷到曾多，无奈冥搜暗索何。\n此处云穿风月透，短筇浑不待扪萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澹岩 其二","author":"卫樵","text":"惭愧州家一事无，薄游还爱小蓬壶。\n若凭妙笔丹青写，应胜从来八景图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"潘时举","text":"老大倦追随，得坐且终日。\n所以见春去，亦不甚爱惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题周南仲正字所藏阎立本画苏李别","author":"朱鼐","text":"少卿昔在河梁别，执手踟蹰不能发。\n万古初传五字诗，努力相期在明德。\n子卿海上毡为食，故人朅来重相觌。\n不觉看羊度岁年，却因射雁传消息。\n人间此是长别离，少卿在虏子卿归。\n归欤尚握汉臣节，留者永衣胡人衣。\n天长地阔半尺绢，满眼云愁风景变。\n一人仰叫头脱冠，一人横涕袖著面。\n阎君国相称画师，未必想像能尔奇。\n前身恐是胡妇子，曾见两公分袂时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗汉寺 其一","author":"韩舜卿","text":"山阴盛事今寥落，千古风流属晋阳。\n况有林泉当列坐，不须弦管送流觞。\n醉挥金椀青春客，自濯尘缨白发郎。\n一笑相看能几许，却怜马首路岐长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗汉寺 其二","author":"韩舜卿","text":"天迥云收霁色空，乔林还绕寺当中。\n阴森小径千重竹，萧飒虚亭四面风。\n暮霭不兴山抹黛，夕阳西下水流红。\n自惭怯懦承庥庇，安得民称几寸葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"阮愈","text":"收拾新诗入锦囊，晴天添得两三章。\n一冬只在梅花里，吟笔入春犹自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访吴","author":"晏乂","text":"平生一语不肯吐，浩然披发行西林。\n美人十日跨驴出，黄叶堆门云雪深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦中","author":"晏乂","text":"春树年年少，寒云浦浦连。\n片帆高浪起，斗酒夕阳偏。\n沙市怀司马，州城哭老边。\n太平冠盖尽，尔敢望诸贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题米元章书迹拓本","author":"董史","text":"书家宝晋殆犹龙，妙用通神五指中。\n墨海波澜无定势，玄云夭矫欲随空。\n格高韵胜存人品，脚阔头空笑俗工。\n建绍圣人精鉴赏，夺真移在玉屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋刘敏叔画杨诚斋先生探梅图二首 其一","author":"李大来","text":"寿骨劲如霜后雪，诗脾写出月中梅。\n如今不爱好官职，得及翁年也乐哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋刘敏叔画杨诚斋先生探梅图二首 其二","author":"李大来","text":"梅发江村觅句天，先生策杖到花前。\n款门有客真能事，为幻精神若个边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游隐屏","author":"蔡杭","text":"悚惧未成立，隐忧道学失。\n修身复补过，庶保馀生责。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同友人过大隐屏即事赋别","author":"蔡杭","text":"脱略尘世虑，仙都共夷犹。\n乘凉得风便，快楫竹扁舟。\n神仙现奇怪，古木横岩陬。\n振衣万仞高，天风动衣抠。\n巍巍隐屏峰，擎天峙中流。\n良朋论心事，抚景悲新秋。\n浩叹复浩歌，一饮还一酬。\n南阳岂终卧，东山谅同忧。\n斟酌素有定，今焉试为筹。\n西风起暝色，归袂不可留。\n去去惜回首，感慨良悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡久轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗送别得风字","author":"陈南","text":"自叹年馀七十翁，道山重上摄高风。\n一封疏奏胆如斗，三请投闲气直虹。\n宪节可能摅蕴抱，男儿到底要英雄。\n江皋父老如相问，为说吾今计亦东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭真西山先生","author":"吴叔告","text":"恍惚精神对大廷，妒贤宰相别孙弘。\n便令身入翘材馆，不忍重过下马陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"谢方叔","text":"罢相归来十七年，烧香礼佛学神仙。\n今朝双鹤催归去，一念无惭对越天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏文笔山","author":"高梦月","text":"西山翠欲滴，奇峰露嵂兀。\n倚天挺巨手，欲写风和月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿游侍郎七十九","author":"王九万","text":"炎凉薄流光，荣悴猾生理。\n芳荃化为茅，嘉橘变成枳。\n谁知古大椿，霜雪自薿薿。\n立身既千仞，骛阴殆百里。\n宜哉富春秋，万物听独止。\n先生一灵椿，耸壑屹山峙。\n纳湖溉其根，后溪拥其址。\n平生学问力，顿在名节里。\n甘泉讵弗贵，东山不为起。\n以身蹈高洁，为世律贪鄙。\n坐令夸夺辈，疾走掩两耳。\n乃知公进退，均为国凭恃。\n恭为陛下圣，雅欲致园绮。\n黄金已九环，丹诏行一纸。\n公心岂轻重，上意实注委。\n嘉平报初度，吉音随燕喜。\n耆英七十九，彷佛富公是。\n行归磻溪载，更咏淇奥美。\n方觉岁寒姿，不随世变靡。\n锦溪入霞觞，城山揖燕几。\n祝公如大椿，明堂栋千祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游灵岩","author":"李茂先","text":"雪岩偶得片时留，倾倒清尊兴未休。\n香积寻常分药水，禅林自昔枕江流。\n羊肠盘转层崖荫，山腹空悬古洞幽。\n谈笑相逢情更厚，何当携手约重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游灵岩 其一","author":"文绅仪","text":"一入灵岩寺，凭栏望眼遥。\n山深云障日，江阔夜生潮。\n古洞遗仙迹，流泉傍石桥。\n醉来搔首咏，得句兴偏饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游灵岩 其二","author":"文绅仪","text":"禅林高耸倚晴空，梯上层峦紫翠重。\n云气下成风雨阵，岚光高接斗牛宫。\n流泉药水瘳民疾，古洞神仙有路通。\n窃欲扪萝登绝顶，细将民隐达天聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟渔浦望吴山作","author":"林希逸","text":"客子孤舟傍晓沙，隔江人说是京华。\n缘山一带烟笼树，中有王侯百万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙湾秋夜","author":"林希逸","text":"旅泊秋将暮，行吟夜向中。\n独星明似月，重露冷于风。\n游历书何有，飞扬醉自雄。\n时闻边耗近，忧愤气填胸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前出塞","author":"林希逸","text":"淮面如江春涨早，猎骑夜归城未锁。\n边头戍将惜官卑，举鞭怒指平安火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后出塞","author":"林希逸","text":"紫金山前数尺雪，三十六洲明似月。\n夜来冲突人不知，但见官军刀带血。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信阳道中次陈守韵","author":"林希逸","text":"古岭才成径，荒林间有家。\n柳眠腰袅娜，桑老骨槎牙。\n野麦三分草，山篱一半花。\n挟书来万里，飘泊负生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安丰作","author":"林希逸","text":"塞北悲笳起，淮南古木疏。\n风高疑唳鹤，水落见叉鱼。\n俗仅传丹鼎，人谁问枕书。\n因吟招隐赋，久客自嗟嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄书后作","author":"林希逸","text":"几度题书客未还，归鸿节节度乡关。\n遥知一纸平安字，慈母灯前阁泪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其一","author":"林希逸","text":"异俗逢钻燧，劳生叹转蓬。\n茅檐疏柳月，草地落花风。\n故国丘坟在，他乡祭祀同。\n奔驰真左计，归梦海云东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食 其二","author":"林希逸","text":"阵阵花风送雨寒，心随风雨到乡关。\n遥知松柏山前路，今日邻人拜扫还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟泊姑苏城外","author":"林希逸","text":"倚郭维孤舟，漠漠见烟渚。\n水宿野鸟归，夜深邻人语。\n远客万斛愁，卧听姑苏雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿西兴渡作","author":"林希逸","text":"古寺鸣钟罢，高林宿鸟忙。\n竹明风弄影，荷净露生香。\n月到中天小，星过野水长。\n江村人寂寂，败叶响银床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临浦秋夜","author":"林希逸","text":"野噪寒枝鹊，村归古寺僧。\n傍阶闻落叶，隔岸数残灯。\n月退频移席，潮高尚倚藤。\n江虚群籁息，人语近渔罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐轩先师挽歌词 其一","author":"林希逸","text":"十年灯火若为情，一日箫笳有底声。\n惆怅门前旧时路，白头扶杖夜深行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐轩先师挽歌词 其二","author":"林希逸","text":"网山遗稿乐轩文，已矣今无识子云。\n千载何人按图问，犀斜南谷两荒坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐轩先师挽歌词 其三","author":"林希逸","text":"晦庵南北象山西，道学年来入品题。\n可惜六经真脉络，红泉三世两幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋闺怨","author":"林希逸","text":"帘幕低垂夜漏深，秋虫唧唧相悲吟。\n回纹织罢空弹泪，未必君心似妾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午斋即事","author":"林希逸","text":"晴窗吾伊罢，风薄清昼永。\n陈编几废兴，适笑心自领。\n青精饭何味，车笠沸尘境。\n伫立共幽怀，虚檐疏竹影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵答友人论诗","author":"林希逸","text":"艺业难精最是诗，千差万别信难知。\n还须倒岳倾湫手，却有惊天动地时。\n鸟迹论书方古雅，龙媒入画始权奇。\n夷然便欲趣平淡，此法谁传我亦疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与陈同舍饮三元楼","author":"林希逸","text":"失身杯酒莫追尤，烂醉生涯尽自由。\n可倚何须鹦鹉赋，相逢且解骕骦裘。\n今无客入扬雄巷，终有人题李白楼。\n却笑三闾太憔悴，独醒犹作畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸巳再入京宿璜溪寄二弟","author":"林希逸","text":"十日离家只四程，白云何处玉融青。\n溪声飒飒如风雨，独对寒灯咏鹡鸰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄源岭半见梅作","author":"林希逸","text":"古岭森森立万松，一株寒玉笑春风。\n恰如钓艇桐江客，画入云台剑佩中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀","author":"林希逸","text":"金莲学士起持衡，玉笋门生仅识名。\n一瓣心香双泪眼，半溪残日暮云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"林希逸","text":"七香宝驾灵谁乞，双眼金针俗不存。\n世态如今机巧遍，堪将馀技献天孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千载","author":"林希逸","text":"千载祇如此，回头迹便陈。\n嘘天遗故我，问月叹今人。\n客授长生诀，僧谈不坏身。\n未应痴准拟，且乐醉乡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼四先生","author":"林希逸","text":"真洪蒋魏继沦终，天肯忧人国欲空。\n众口生憎来论学，诸贤死不解和戎。\n良图已付悲歌外，旧恨祇留奏稿中。\n拟续八哀才思短，剩将双泪洒松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读黄诗","author":"林希逸","text":"我生所敬涪江翁，知翁不独哦诗工。\n逍遥颇学漆园吏，下笔纵横法略同。\n自言锦机织锦手，兴寄每有离骚风。\n内篇外篇手分别，冥搜所到真奇绝。\n颉颃韩柳追庄骚，笔意尤工是晚节。\n两苏而下秦晁张，闭门觅句陈履常。\n当时姓名比明月，文莫如苏诗则黄。\n黔南日月老宾送，白头去作宜州梦。\n官楼家乘谁得之，那知珠玉无散遗。\n生前忍苦琢诗句，飘泊不忧无死处。\n今人更病语太奇，哀公不遇今犹故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"打马","author":"林希逸","text":"九折羊肠片纸间，机心觌面险于山。\n是非喻马一儒墨，得失争蜗两触蛮。\n危似楚兵临汉堑，急如齐客度秦关。\n良图邂逅何分别，莫诧争雄衣锦还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚游遣兴","author":"林希逸","text":"积雨多妨喜晚晴，幽禽足足傍檐鸣。\n迎风远岸松声近，背日阴池树影明。\n亲有馀年方赖禄，国无长算幸渝平。\n此生错料吾犹可，只恐风尘未肯清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"心王","author":"林希逸","text":"易言不动工夫密，书说惟微体段彰。\n仙谩有方求气母，禅非无见指心王。\n灵根本要行藏在，槁木宁于应感妨。\n一语何思千古训，莫言为陆背程张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日用","author":"林希逸","text":"赖得人间念已灰，省身克己问参回。\n事随缘法安排去，病向根源点检来。\n布袜青鞋资懒散，笔床茶灶恣徘徊。\n偷忙不住提撕着，猛可投机亦俊哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答友人论学","author":"林希逸","text":"逐字笺来学转难，逢人个个说曾颜。\n那知剥落皮毛处，不在流传口耳间。\n禅要自参求印可，仙须亲炼待丹还。\n卖花担上看桃李，此语吾今忆鹤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"力学","author":"林希逸","text":"力学求心苦未安，蓬窗赖得小盘桓。\n醉知叉手矜持易，过似科头点检难。\n静定工夫忙里试，和平气象怒中看。\n亨涂失脚人何限，始信颜回乐一箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玄扃","author":"林希逸","text":"君从何处叩玄扃，耳学纷纷莫浪听。\n刬尽念头方近道，扫空注脚始明经。\n见闻日富祇尘积，涉历年深似酒醒。\n不必但疑禅背理，请君细读信心铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"林希逸","text":"佛言法界惟心造，仙说还丹要想成。\n到得冰壶秋月处，轻轻拈出是功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]