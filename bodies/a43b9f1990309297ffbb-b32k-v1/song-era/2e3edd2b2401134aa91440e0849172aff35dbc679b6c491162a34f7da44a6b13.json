[{"title":"送从祖还黄州桃花镇寓居","author":"徐瑞","text":"礼服悠悠岁月深，归来城郭岂堪寻。\n葬防不背先师训，居颍能知前辈心。\n古驿桃花劳远梦，征途柳色动新吟。\n秋风傥有南飞雁，莫惜频频一寄音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送南翁待制北上","author":"徐瑞","text":"生来畏别不堪闻，十四年中三送君。\n挂席压平彭蠡浪，载家喜见太行云。\n对扬入掌丝纶宠，纪颂行看金石文。\n犹有鹅塘遗意在，一麾须早乞江濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姚圣可归旴江 其一","author":"徐瑞","text":"识面三年久，论心此日同。\n相从方款款，索去又匆匆。\n宇宙尘机息，江湖老眼空。\n南枝春信早，归路载东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送姚圣可归旴江 其二","author":"徐瑞","text":"未了区中事，先留方外盟。\n仙才虽有数，大器岂无成。\n白发高堂梦，青山故国情。\n君归相慰藉，未及水初生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送凌霁云赴馀姚州学正","author":"徐瑞","text":"天门振铎声弥远，越上横经任更专。\n颇怪风云纡宦辙，故因山水著名贤。\n圩田秋足先生饭，海月春浮坐客毡。\n闻有世南遗墨在，归鸿傥一寄林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜哭仲孙概 其二","author":"徐瑞","text":"我老那堪哭，吞声泪一襟。\n应门差慰眼，伏枕独伤心。\n白璧归黄壤，孤坟寄古林。\n凄凉重泣痛，临绝有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏五有旨徙豪右郡邑以吾家充数与章正卿同泊舟琵琶洲下","author":"徐瑞","text":"去国羁怀恶，开帆眼界新。\n同为万里客，犹是一乡人。\n浪说王孙富，谁怜郭解贫。\n江妃应笑我，从此素衣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日读陶韦诗偶成","author":"徐瑞","text":"诗道贵和平，由来写性情。\n要知冲口出，绝胜撚髭成。\n理到辞须达，神超韵自清。\n无人融此趣，庭户绿阴生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读画史","author":"徐瑞","text":"子敬因成駮，曹兴偶画蝇。\n初非有意作，竟以绝伦称。\n铸错吾何恨，求全古所惩。\n中年思烂熟，巧力不须矜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄山村仇公","author":"徐瑞","text":"山村老子知何似，想见庞眉鹤骨清。\n千里相望劳远梦，六年不见耿深情。\n云归山翠沾衣湿，雨过湖光照眼明。\n最是湖山图画里，输公吟啸了平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅山周公挽章 其一","author":"徐瑞","text":"才力千钧弩，襟期百尺楼。\n吾生能几见，异世有同流。\n起起悲前梦，堂堂閟一丘。\n哀荣动州里，外此复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪上晚眺","author":"徐瑞","text":"望逐飞云去，天低落景黄。\n江湖流不尽，宇宙事何长。\n帆影行空阔，渔歌出莽苍。\n沙平秋草远，鸥鹭未相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中作","author":"徐瑞","text":"岁月惊虚掷，风霜信饱更。\n蚤知穷有命，惟以饮留名。\n人事宜藏拙，天工亦恶盈。\n浩歌因起舞，月到纸窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王朝英修竹斋","author":"徐瑞","text":"文章虎豹皮，标格雪霜枝。\n孤立天所赋，一清人得知。\n勿论千户等，可忍十年饥。\n会得个中趣，何须汗漫期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题节妇冯氏传后用南翁韵","author":"徐瑞","text":"夫征妇孕判居行，夫没儿存妇节清。\n不背所天终此义，信知有欲甚于生。\n芳名真足留千载，百伪无如仗一诚。\n定谥何人敢当笔，春秋万古自昭明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"门外意行有感书示二孙","author":"徐瑞","text":"门前老树饱风霜，封植良勤不可忘。\n累世衣冠流泽远，百年基绪庆源长。\n稚松怒长堪藏屋，新笋初抽已过墙。\n珍重先人有遗训，读书馀力及耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从弟楚玉来言将有湘阴之役兰玉见寓衡阳甚适求诗送行为赋长句","author":"徐瑞","text":"南岳崚嶒太古色，青湘窈窕千尺深。\n山川绝胜宜嘉客，兄弟相望惬素心。\n共看骅骝誇汗血，从知朝市远云林。\n高堂白发能无念，可是朝朝候鹊音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日题仲退漫游四藁后","author":"徐瑞","text":"夫君汗漫路万里，翰墨游戏诗百篇。\n高歌不觉屡击节，画写似曾亲执鞭。\n奇探马迁作史意，老气杜陵出峡年。\n何当囊笔撰杖屦，与君题遍名山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬寅和谢拙逸寄芳洲韵","author":"徐瑞","text":"尘埃野马谩劳形，远想高标愧此生。\n已许过从陪杖屦，敢辞来往涉途程。\n幔亭山色长如画，破衲秋风自有情。\n更待焚香参太极，朱弦端为发奇声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月湾以路学正摄番江长收租长洲有怀朽钝赋诗远寄次韵为谢","author":"徐瑞","text":"学道如撑上峡船，蹉跎富贵与神仙。\n对床犹记听风雨，讲席何堪数岁年。\n少日朋侪随化尽，晚涂老病有谁怜。\n故人厚问今何似，筋力虽衰尚服田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月湾约游鹅塘不果再约送南翁北上共了庐阜之债以诗订盟","author":"徐瑞","text":"鹅塘阻趁登山屐，庐阜端随下水船。\n况是故人当送远，不乘清兴待何年。\n英雄埋没龙长卧，道学榛芜鹿自眠。\n访古归来春意动，倚峰要了看山缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月湾辟地山中诛茅归隐怡如赋诗次韵赞决 其一","author":"徐瑞","text":"一去山中廿二年，重来有约竟茫然。\n穷居笑我顽同石，文事多君彩印椽。\n今日开山作宗祖，向来弹铗等风烟。\n馀龄剩喜游从乐，更结青乌白鹤缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东绿叔祖得园池之胜于万山深处将拔宅而居焉以诗奉饯","author":"徐瑞","text":"两僮自足负琴书，载具何劳远借车。\n客至未妨投辖饮，地荒正好带经锄。\n欲从隐者归盘谷，尚念先人有敝庐。\n择胜怀居竟谁是，定知明哲笑迂疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用仲退韵别周南翁","author":"徐瑞","text":"薄俗难谐祇自知，百年几见费心思。\n平生鲍叔深怜我，后代扬云不并时。\n春雨情怀惟有酒，男儿岁月但供诗。\n汀洲草长东风软，一笑旗亭又语离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵寄仲退","author":"徐瑞","text":"虚堂宴坐万缘空，疏竹泠泠度晚风。\n政自悠悠随世运，无论愦愦到天公。\n病来茗枕成奇祟，老去蒲团策隽功。\n忽忆乐平吴直学，八年不共地炉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘元辅寄咏史诗六十首赋此为谢","author":"徐瑞","text":"永嘉诸老不可作，史传纷纭孰与评。\n一字不轻严衮钺，千年如见审权衡。\n常忧此道无人识，忽得公诗老眼明。\n雪手焚香三读罢，小楼坐对晚山横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次刘东仲见寄咏","author":"徐瑞","text":"丰姿明玉树，清论泻秋泉。\n雾豹文何泽，风鸾意自仙。\n超然由静悟，妙处可言传。\n倘遂卜邻愿，游从不计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵月湾午坐偶成","author":"徐瑞","text":"年来与世亦婴儿，众欲纷纷看朵颐。\n简策祇留遗事在，英雄空有大名垂。\n斲轮老去谁堪付，弹铗归来未觉迟。\n少约林泉今白发，不偿素愿待何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵仲退木犀一首","author":"徐瑞","text":"门前老树繁秋英，浓香醉客我独醒。\n空山无人境寂寂，萧斋如水风冥冥。\n清标自是欠花谱，远韵差堪著酒经。\n君家刚猛两荒幻，且挹危露培修龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴仲退见贻 其二","author":"徐瑞","text":"天秋分袂后，扰扰似年时。\n竟负梅花约，空哦春树诗。\n断崖粘冻雪，碎石漾流嘶。\n怅望湾头路，扁舟乐泳思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴仲退见贻 其一","author":"徐瑞","text":"瘦竹相随立，轻坚九节青。\n川平云澹澹，风定树亭亭。\n汩没悲流俗，驱驰累有形。\n掩关差有味，危坐玩羲经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寄题严氏寻古斋","author":"徐瑞","text":"马图龟画未是易，龙文鸟章岂其书。\n能穷有象有数外，始识无声无臭初。\n身从浩劫得所赋，神游太虚以为居。\n吾人寻古傥悟此，以后观今非古与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寄题李氏月心精舍","author":"徐瑞","text":"坎阳为心亦为月，妙质一点何玲珑。\n君看灵光湛止水，孰与明镜行秋空。\n万古娟娟不改色，百年忽忽俱成翁。\n盈虚如彼莫消长，试参此语将无同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余自戊子至丁酉十年之间诗不及百首而困穷流落之状历历可见虽然政使岁得百首亦不过流连光景而已焉攸用感叹之馀赋此自警","author":"徐瑞","text":"吾生汩汩何所就，祇送流光添鬓丝。\n起寻诸老已半鬼，回首十年无百诗。\n刻意文章终害道，无心世路任多岐。\n便须擘画三千岁，不住青城即武夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吾族盘石将挟堪舆家出游索诗送行","author":"徐瑞","text":"天星坠地化为石，盘石即是星之精。\n观天必识经纬象，相地始知流峙情。\n豹林将军累世显，龙冈文章千载名。\n古人妙中非浪漫，发抉幽微在此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳洲寄示和章且及方外之学再叠奉谢","author":"徐瑞","text":"前修零落典刑空，堆笔须君振古风。\n敢意严诗编杜集，但希颜咏黜山公。\n区中随顺何妨道，物外佯狂更有功。\n安得相携登岱岳，天门夜看海涛红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中清明","author":"徐瑞","text":"光阴迅速一百六，老境侵寻五十三。\n千里怀人黯风雨，五更归梦到松楠。\n丹炉火足心兵息，茗椀香浓舌本甘。\n次第尽偿芒竹债，结茅归老此山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故友汤景文别六年乃十月廿一寻我松下临别见赠次韵奉答","author":"徐瑞","text":"占气频翘首，青牛忽度关。\n相看双眼碧，剧论寸心丹。\n时俗容迟钝，交情见往还。\n盟言天为听，万一莫辞难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡和卿用所赠王复翁韵见寄叠韵奉谢","author":"徐瑞","text":"世味居然如嚼蜡，贪閒犹爱故丘瓜。\n寸心自欲期千载，一理端能贯百家。\n为山功夫在进篑，穷源消息问乘槎。\n此去相从须有日，裂笺聊当寄梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送表弟王复翁赴武陵教谕","author":"徐瑞","text":"汉朝最贵文学掾，况遇明时早及瓜。\n乡国几年工取友，诗书累世克承家。\n斜飞聊展天南翼，逸兴应随海上槎。\n闻说秦人遗迹在，更寻渔父问桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过钟潭寺月湾有诗次韵","author":"徐瑞","text":"五年三到此，门径怪频移。\n绝壁何年树，空廊异代碑。\n微澜生古濑，浮翠拥修眉。\n煮茗谈时事，山僧总未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜哭仲孙概 其一","author":"徐瑞","text":"阶庭皆秀发，念汝独敦庞。\n处事怯藏勇，临机智若戆。\n痛渠二竖恶，何日片心降。\n砚席凝尘满，依然在北窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏五寄赵菊东","author":"徐瑞","text":"溪堂相望一百里，音问相疏十五年。\n眼底浮华俱已矣，篱东老菊独依然。\n登临不减青山兴，陶写犹怀白石编。\n待得秋风稍凉冷，方壶深处扣真玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涉世","author":"徐瑞","text":"涉世头将白，耽诗貌欲枯。\n晨斋参玉版，夜渴饮冰壶。\n咄咄知今是，栖栖愧故吾。\n穷通端有命，一笑视平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读仲退和胡秀才诗有感斯文用韵","author":"徐瑞","text":"文章圣处无谁语，独立苍茫祇屡膑。\n从渠高眼空四海，自古名家能几人。\n爱乌怒蟹言何浅，画虎雕龙技漫新。\n吾道澹成终隽永，莫矜盛气怨私贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"徐瑞","text":"陶公恒得法外意，张颠独悟书中神。\n口耳不到方是妙，言动可拟皆非真。\n寒泉泠泠出空谷，幽鸟亹亹鸣阳春。\n政索解人不可得，举似俗子翻成嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄芳洲先生","author":"徐瑞","text":"秋入郊原四望空，石梁老树立西风。\n文章子不减班掾，丘壑吾能过庾公。\n池上纷纷成底事，尊前兀兀有奇功。\n山中芋栗今朝熟，万一寻盟榾柮红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周南翁用月湾寒食韵","author":"徐瑞","text":"独梦云千里，清愁雨一林。\n江山空有约，桃李易成阴。\n自是乖幽赏，何由话苦心。\n兴来当径造，剪烛夜堂深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄宗玉弟","author":"徐瑞","text":"日长独坐耿相思，每报平安慰我饥。\n举动岂知遭齿舌，送迎谁念用符移。\n转丸鸣镝应无滞，絅锦韬旌未是痴。\n更著加餐题纸背，晚成在子莫忧迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄徐逢原求墨","author":"徐瑞","text":"北李骨朽呼不起，老石珍藏痴可怜。\n松身镜面徒外美，犀纹玉质知谁传。\n古今赏览那复有，举世缪幻何由湔。\n一螺点漆倘寄我，会见枯笔生春烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅山周公挽章 其二","author":"徐瑞","text":"东阁游从久，西州恸哭频。\n感君敦古谊，待我异他人。\n对酒言犹在，看山迹已陈。\n惟应旧宾客，相对一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅岩","author":"徐瑞","text":"不见此山四十载，岩石相看亦粲然。\n顾我丹心今不改，信渠铁面晚犹坚。\n人生出处无非数，文运昌明自属天。\n尚恨山灵知我浅，小楼呼酒对婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题旧藁","author":"徐瑞","text":"书向愁边著，诗添病后吟。\n不成千古事，空费一生心。\n华发江湖晚，青灯风雪深。\n钟期那可铸，尘网断纹琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题周南甫草窗吟卷后","author":"徐瑞","text":"水中盐味谁能识，铎里宫声未易听。\n正惜无人继风雅，忽传佳句到林坰。\n云开灊岳撑千仞，春入雷江涨四溟。\n遥想清吟得天趣，窗前草色自青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壁侍者来访作此赠之","author":"徐瑞","text":"俗论卑卑不足闻，相从松下慰离群。\n喜师一吸西江水，许我平分华岳云。\n更向锋前来妙悟，莫于纸上泥陈文。\n纯阳石薜黄龙老，肥瘦何曾彼此分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喝水岩","author":"徐锡之","text":"重峦复岭锁松关，只欠泉声入座间。\n我若当年侍师侧，不教喝水过他山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"项亭","author":"徐兢","text":"图秦争汉两无成，霸势先随玉斗倾。\n惟有乌江夜深浪，至今犹作楚歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭城山","author":"徐兢","text":"高馆不知处，游人空往还。\n乱鸦残雪树，荒冢夕阳山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛艮斋二首 其二","author":"徐嘉言","text":"宦游将适郑公乡，众说膺门气味长。\n欲效然明略陈语，那知叔向罢登堂。\n毗坛不试新分竹，霅水空瞻旧茇棠。\n天不憖遗何太早，忍看埋玉向高冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛艮斋二首 其一","author":"徐嘉言","text":"卓荦才名四十秋，屡摅良策动宸旒。\n倾河议论谁能敌，唾手功勋未肯休。\n方快九霄抟鸑鷟，俄惊长坂蹶骅骝。\n天公应叱六丁下，著述文章尽捲收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题金粟寺庵和通判军府周寿韵","author":"徐嘉言","text":"招提敞山岩，新庵隐岩麓。\n石沼引清流，风漪皱文縠。\n晴晖满虚室，一水含自足。\n心明身宴闲，境寂谁寻逐。\n寒林带月行，夜榻和云宿。\n若欲问西来，一斋饱自足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十八日观潮","author":"徐瑞","text":"海门乍见一线白，江下涛头十丈黄。\n数点红旗争出没，千艘飞橹下沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙申二月既望仲退再来山中意行谈旧送别怅望寄两绝句其一云别君乌石冈头路一树梨花照晚烟总是旧来携手处东风回首十三年其二云入山不远六七里老我应行千百回昨日与君谈未了今朝策蹇又重来读之黯然次韵用谢 其一","author":"徐瑞","text":"东风满眼皆陈迹，老树荒园更断烟。\n今昔相看只如此，但拚痛饮过年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙申二月既望仲退再来山中意行谈旧送别怅望寄两绝句其一云别君乌石冈头路一树梨花照晚烟总是旧来携手处东风回首十三年其二云入山不远六七里老我应行千百回昨日与君谈未了今朝策蹇又重来读之黯然次韵用谢 其二","author":"徐瑞","text":"梦中几度寻安道，也似当年泛剡回。\n可是山中缘未断，又从云外寄诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙戌除夜泊舟东湖用白石归苕溪韵书怀 其三","author":"徐瑞","text":"出山归隐计无成，舟泊菰丛胶断冰。\n记取东湖风雪夜，青荧一点隔林灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]