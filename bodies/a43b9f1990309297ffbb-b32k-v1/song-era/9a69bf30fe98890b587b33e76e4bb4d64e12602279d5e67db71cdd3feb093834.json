[{"title":"句 其二十","author":"程师孟","text":"江山自是长生境，城郭今为极乐坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十六","author":"程师孟","text":"谁家楼台梵王宫，桐蕊桑花次第红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十五","author":"程师孟","text":"最爱荔枝初熟后，人间都在赤城间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十四","author":"程师孟","text":"行吟渐出蕉花岭，归梦应先荔子楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十八","author":"程师孟","text":"香焚薝卜岩云院，花发莎罗海山春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二十一","author":"程师孟","text":"每日要忙须一到，夜深长是点灯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其九","author":"程师孟","text":"故国楼台千佛寺，新城歌舞万人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"程师孟","text":"邻家不惜山中景，借与清泉作水帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"程师孟","text":"天香世界荷花白，御果园林荔子丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭君怨","author":"程过","text":"试问愁来何处。\n门外山无重数。\n芳草不知人。\n翠连云。\n欲看不忍重看。\n心事只堪肠断。\n肠断宿孤村。\n雨昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 寿边守","author":"程伯春","text":"功名果何物，天欲付英豪。\n请看襄汉，今日谁驾六灵鳌。\n阅礼崇诗元帅，大纛高牙临塞，砥柱一洪涛。\n百辟拱辰极，欢动赭黄袍。\n策无遗，勋益著，德弥高。\n定知阳报，谢庭兰玉付儿曹。\n秀发如君独擅，浑似当年幼度，文武素兼韬。\n岁岁长为寿，霞液荐蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清心堂为余宰题","author":"程应申","text":"灵台元自与天通，一点尘飞失太空。\n六凿尔时俱偃息，八窗何处不玲珑。\n公田有秫犹难色，暮夜无金即直躬。\n要识此中清入妙，也忘堂上古丝桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春信","author":"程彻","text":"萧条冬事堂堂去，拍塞韶光点点开。\n明月清风遮不断，暗香时入梦中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题唐显孝饶娥墓 其一","author":"程时登","text":"悠悠孤愤倚中流，饱阅川陵四百秋。\n水际丛祠犹昨日，人间抔土几荒丘。\n故乡爱说饶饶姓，往事空传柳柳州。\n满目夕阳凝睇久，桐花飞落钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭郭若虚","author":"程时翼","text":"一枝夭矫摩云操，三尺光芒报国心。\n易水歌残声杳杳，□□月落夜沉沉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"团练统制程公全哀挽 其二","author":"程旸","text":"举宗南渡日，相恃得元戎。\n谱系通江左，家声愧洛中。\n一抔埋宝剑，三锡负彤弓。\n谁念辕门士，哀歌彻昊穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"团练统制程公全哀挽 其一","author":"程旸","text":"江迹留空垒，牙枭谶异徵。\n报君忠贯日，吞虏气填膺。\n死战悲杨业，生降唾李陵。\n哀荣褒典厚，主上已中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西江月","author":"程邻","text":"阶下宝鞍罗帕，门前绛蜡纱笼。\n留连佳客怅匆匆。\n赖有新团小凤。\n琼碎黄金碾里，乳浮紫玉瓯中。\n归来袭袭袖生风。\n齿颊馀甘入梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云岩","author":"程卓","text":"石门一望路迢迢，五老峰高耸碧霄。\n泉挂珠帘当洞口，烟拖练带束山腰。\n香炉捧出仙人掌，辇辂行过织女桥。\n午夜月明天似水，鹤归松顶听吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金焦二山","author":"程卓","text":"扬子长江天际来，中流有山何壮哉。\n深根盘礴千万丈，寸土不受双崔嵬。\n金山屹据上流险，四面佛屋相环回。\n来帆去桨别舻舳，住僧过客烦追陪。\n排空杰阁揖沧海，海山乱点浮纤埃。\n龙潭别耸石峰巧，时立野鹤慵毰毸。\n堂头回首指遗像，坡公印老留青煤。\n其人已去诗尚在，唱酬风月相徘徊。\n再三瞻敬下山去，缥缈又入云涛堆。\n焦山一望祇十里，舟师驾橹如奔雷。\n行行滉荡呼吸顷，系缆荦确登山隈。\n山中僧少竹木古，瘦根迸石穿莓苔。\n幽姿野态随步出，胜处往往多楼台。\n洪崖路转寻瘗鹤，几年浪打风雨摧。\n遗铭破碎石剥落，摩挲细读心眸开。\n同行韵远兴未尽，飞仙亭上倾樽罍。\n酒酣我为发奇绝，底须方外求蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜贺恩减本州绢额","author":"程叔达","text":"山国不栽桑，抱布贸丝藏。\n恩诏光明烛，寒灯织室光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"进敬天图","author":"程叔达","text":"自幸躬逢时盛治，人欣官备掌丝纶。\n频年馆阁更新进，屡世阶墀作近臣。\n忆昔中兴开六位，旋禅历数转双轮。\n祯符龙马南江出，宝箓台垣北极陈。\n端拱明堂时御世，溯源清庙允尊亲。\n无为效舜惟恭己，受摄如尧只布仁。\n四海群生回泰运，万几一日起黎民。\n曾闻洪范平康福，尤守丹书敬胜身。\n昨见江湖虽饮马，将来京洛靖烽尘。\n吾儒所学惟诚正，稽古钦哉有诫询。\n四国八风生万象，九重一语定三辰。\n遥祈天鉴纳遗老，抃舞温和浑是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沁园春 寿竹林亭长","author":"程和仲","text":"呼伯雅来，满进松精，致寿于公。\n况富矣锦囊，吟边得句，森然武库，书里称雄。\n亭长新封，亩宫雅趣，一笑侯王名位穹。\n闲官守，任平章批抹，明月清风。\n年年申庆桑蓬。\n幸至节今晨恰又逢。\n想霭霭其祥，瑞云闿兆，绵绵之算，线日增红。\n一段文章，三千功行，名在长生宝箓中。\n人间窄，待骖鸾驾鹤，上祝融峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小重山","author":"程武","text":"香减鲛绡添泪痕。\n彩云长是恨，等闲心。\n玉笙犹记夜深闻。\n湘水杳，寂寞隔巫云。\n翠被冷重熏。\n做成归梦了，却销魂。\n垂杨浓处著朱门。\n依然是，风雨掩黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 题马嵬图","author":"程武","text":"蜀江城远，想连云危栈，接天穷处。\n惆怅烟尘回首地，双阙觚棱犹故。\n龙扈星联，羽林风肃，未放鸾駣去。\n不堪掩面，泪沾宸袖如雨。\n底事当日昭阳，吹羌鸣羯，涴却霓裳舞。\n三十六宫春满眼，曾把色嗔香妒。\n芳草埋情，飞花陨怨，翻被蛾眉误。\n画图惊见，黯然魂断今古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐","author":"程武","text":"曳云摇玉。\n裙蹙秋绡幅。\n学得琵琶依约熟。\n贪按雁沙新曲。\n曲终满院春闲。\n清颦移上眉山。\n心事怕人猜破，折花背插云鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台陈山夫寄别用韵","author":"程炎子","text":"断烟荒草共幽幽，斜雨抛丝织晚愁。\n鸥鸟似知人乍别，飞来飞去渡船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水乐洞","author":"程炎子","text":"南山水乐洞，窈窈白云深。\n满耳笙歌者，谁能一洗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归日","author":"程炎子","text":"去时雪学杨花舞，归日花如雪样飞。\n何事杨花并雪絮，送人西迈送人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵守独游水西寺","author":"程炎子","text":"吟月歌风酒力微，独寻幽壑叩禅扉。\n泊堤小艇迎人渡，入水闲云伴鹤飞。\n梅落半含冰雪思，石寒长覆薜萝衣。\n水西景物还如旧，恨不相从倒载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登新安五岭","author":"程炎子","text":"五岭崎岖一步难，白云兼雾羃中间。\n行人莫道山多险，更有人心险似山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中杂诗 其一","author":"程炎子","text":"侧耳桥边听，声声在翠微。\n自甘留此坐，何苦劝人归。\n院悄惊春昼，山空恋夕晖。\n得如鸥与鹭，对我欲忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中杂诗 其二","author":"程炎子","text":"昆崙初凿破，大巧夺天真。\n竹锁三更月，桃酣几度春。\n山空闻鹤唳，溪远卜鸥邻。\n为拂留题石，松摇露滴身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古梅","author":"程炎子","text":"水边山脚友渔樵，梅欲窥人故故招。\n树剥龙鳞黏碧藓，枝翘鹤膝糁红椒。\n诗如老杜吟东阁，梦约逋仙过断桥。\n好待月窗清影瘦，传他神子上生绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四安舟中","author":"程炎子","text":"多行三两日，犹在四安舟。\n天正当寒夜，人偏作远游。\n风高云叶动，江阔浪花浮。\n会得幽閒趣，唯应是白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次郡太守刘朔斋秋晚谒谢脁亭小饮三首 其三","author":"程炎子","text":"掀髯一笑倚危阑，面面青山不厌看。\n霜染丹枫秋色绚，日烘紫菊露痕乾。\n鹊炉火慢熏龙脑，蟹眼汤新瀹凤团。\n回簇绛纱城郭晚，老梅吹角雁拖寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次郡太守刘朔斋秋晚谒谢脁亭小饮三首 其二","author":"程炎子","text":"一祷心香雨便晴，万家和气酿成醺。\n时方入到昭亭路，风已吹开叠嶂云。\n话向禅中参冷淡，心于静处息纷纭。\n麦畦邂逅长沮语，想彻黄堂亦喜闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯周东岩之石门访汾阳氏并呈友人","author":"程炎子","text":"漫浪江湖脚，周游到石门。\n能迎徐孺子，知有令公孙。\n话雨灯辉座，酬春酒滟樽。\n况逢朋友在，一见必温存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登高感兴","author":"程炎子","text":"破帽西风里，龙山忆孟嘉。\n白衣谁送酒，黄菊自开花。\n塞远书传雁，天昏墨点鸦。\n凭高穷北望，何处是中华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春","author":"程炎子","text":"花飞檐语恰经旬，强半韶华断送频。\n三月便晴三十日，一年只有一分春。\n酒甘不饮心如醉，诗苦耽吟味越真。\n攲枕北窗清梦觉，落红啼鸟伴幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅","author":"程炎子","text":"画楼人醉烛高烧，滴在寒枝蜡未消。\n蕊撇打莺金弹滑，花悬驱雀綵铃摇。\n歌儿戏拍供檀板，妆女轻裁贴翠翘。\n酒揭黄封诗嚼淡，时匀乳蜜过山腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题如庵","author":"程炎子","text":"脱略机关一散人，清于兰畹抱幽馨。\n抚松细嚼渊明句，瀹茗闲笺陆羽经。\n春对风光秋对月，晓观云气夜观星。\n世间局面多翻覆，著数虽高亦懒听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次郡太守刘朔斋秋晚谒谢脁亭小饮三首 其一","author":"程炎子","text":"鞭摇五马踏沙堤，秋晚除书下紫泥。\n藓壁篆碑猿捧砚，松关吟句鹤分题。\n裴休故宅今为寺，谢脁闲官昔仕齐。\n太守宴归宾客从，数声山鸟日平西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨历岩","author":"程鸣凤","text":"银河底穿不可塞，一泻砰砰下空碧。\n峰高云邃源荒茫，但见岩飞练千尺。\n我来导之赴苍壑，流出凌江散天泽。\n馀波直赴黄木湾，飓卷鳌翻浪花白。\n竟从海若膏乾坤，岂但梅边沃甘液。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明妃","author":"程鸣凤","text":"汉宫粉黛应无数，明妃却向毡城路。\n自怜倾国不用金，翻被一生颜色误。\n世间那有真妍媸，明妃马上休伤悲。\n不信但看奇男子，多少尘埋未见知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦庵亭","author":"程鸣凤","text":"古来何物支乾坤，除四书外旁无门。\n晦翁乘风游混沦，天宇扫扫浮云昏。\n周程扶起周孔尊，只手闸断狂澜奔。\n当时正气横八垠，犹尔不免遭群喧。\n曾几何日班廷鸳，晓梦有栩枌榆村。\n翁已仙去谁招魂，有亭渠渠波沄沄。\n风烟苔径新屐痕，滕侯肯堂之弟昆。\n溪山荏苒更寒暄，空馀碧树吟霜猿。\n人间兴废谁能论，桑田可变海可翻。\n翁之所恃无有焉，斯文不死道常存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一丛花","author":"程垓","text":"伤春时候一凭阑。\n何况别离难。\n东风只解催人去，也不道、莺老花残。\n青笺未约，红绡忍泪，无计锁征鞍。\n宝钗瑶钿一时闲。\n此恨苦天悭。\n如今直恁抛人去，也不念、人瘦衣宽。\n归来忍见，重楼淡月，依旧五更寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 其一","author":"程垓","text":"旧日心期不易招。\n重来孤负，几个良宵。\n寻常不见尽相邀。\n见了知他，许大无聊。\n昨夜梅花插翠翘。\n影落清溪，应也魂消。\n假饶真个住山腰。\n那个金章，换得渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 其二","author":"程垓","text":"小会幽欢整及时。\n花也相宜，人也相宜。\n宝香未断烛光低，莫厌杯迟，莫恨欢迟。\n夜渐深深漏渐稀。\n风已侵衣，露已沾衣。\n一杯重劝莫相违，何似休归，何自同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一剪梅 冬至","author":"程垓","text":"斗转参横一夜霜。\n玉律声中，又报新阳。\n起来无绪赋行藏。\n只喜人间，一线添长。\n帘幕垂垂月半廊。\n节物心情，都付椒觞。\n年华渐晚鬓毛苍。\n身外功名，休苦思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一落索 其一","author":"程垓","text":"门外莺寒杨柳。\n正减欢疏酒。\n春阴早是做人愁，更何况、花飞后。\n莫倚东风消瘦。\n有酴醾入手。\n尽偎香玉醉何妨，任花落、愁依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一落索 其二 歌者索词，名之一东","author":"程垓","text":"小小腰身相称。\n更著人心性。\n一声歌起绣帘阴，都遏住、行云影。\n闻道玉郎家近。\n被春风勾引。\n从今莫怪一东看，自压尽、人间韵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入塞","author":"程垓","text":"好思量。\n正秋风、半夜长。\n奈银缸一点，耿耿背西窗。\n衾又凉。\n枕又凉。\n露华凄凄月半床。\n照得人、真个断肠。\n窗前谁浸木犀黄。\n花也香。\n梦也香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八声甘州","author":"程垓","text":"问东君、既解遣花开，不合放花飞。\n念春风枝上，一分花减，一半春归。\n忍见千红万翠，容易涨桃溪。\n花自随流水，无计追随。\n不忍凭高南望，记旧时行处，芳意菲菲。\n叹年来春减，花与故人非。\n总使、梁园赋在，奈长卿、老去亦何为。\n空搔首，乱云堆里，立尽斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 其三","author":"程垓","text":"几日赏花天，月淡荼小。\n写尽相思唤不来，又是花飞了。\n春在怕愁多，春去怜欢少。\n一夜安排梦不成，月堕西窗晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 其二","author":"程垓","text":"独自上层楼，楼外青山远。\n望到斜阳欲尽时，不见西飞雁。\n独自下层楼，楼下蛩声怨。\n待到黄昏月上时，依旧柔肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 其一","author":"程垓","text":"枕簟暑风消，帘幕秋风动。\n月到夜来愁处明，只照团衾凤。\n去意杳无凭，别语愁难送。\n一纸鱼笺枕底香，且做新来梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上平西/金人捧露盘 其三 惜春","author":"程垓","text":"爱春归，忧春去，为春忙。\n旋点检、雨障云妨。\n遮红护绿，翠帷罗幕任高张。\n海棠明月杏花天，更惜浓芳。\n唤莺吟，招蝶拍，迎柳舞，倩桃妆。\n尽唤起、万籁笙簧。\n一觞一咏，尽教陶写绣心肠。\n笑他人世漫嬉游，拥翠偎香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小桃红/连理枝","author":"程垓","text":"不恨残花妥。\n不恨残春破。\n只恨流光，一年一度，又催新火。\n纵青天白日系长绳，也留春得么。\n花院重教锁。\n春事从教过。\n烧笋园林，尝梅台榭，有何不可。\n已安排、珍簟小胡床，待日长闲坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼","author":"程垓","text":"墙外雨肥梅子，阶前水绕荷花。\n阴阴庭户熏风满，水纹簟、怯菱芽。\n春尽难凭燕语，日长惟有蜂衙。\n沈香火冷珠帘暮，个人在、碧窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼 其一","author":"程垓","text":"杨柳拖烟漠漠，梨花浸月溶溶。\n吹香院落春还尽，憔悴立东风。\n只道芳时易见，谁知密约难通。\n芳园绕遍无人问，独自拾残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼","author":"程垓","text":"静院槐风绿涨，小窗梅雨黄垂。\n欲看春事留连处，惟有夜寒知。\n魂梦长闲消午醉，扫花共坐风凉。\n归来窗北有胡床。\n兴在羲皇以上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼 其三","author":"程垓","text":"绿外深深柳巷，红间曲曲花楼。\n一春想见贪游冶，不道有人愁。\n三月东风易老，几宵明月难留。\n酴醾白尽窗前也，还肯醉来否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌夜啼 其二 醉枕不能寐","author":"程垓","text":"白酒欺人易醉，黄花笑我多愁。\n一年只有秋光好，独自却悲秋。\n风急常吹梦去，月迟多为人留。\n半黄橙子和诗卷，空自伴床头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]