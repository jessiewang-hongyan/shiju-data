[{"title":"午过横林回望惠山二首 其二","author":"杨万里","text":"雪馀官路已生尘，犹喜长河水稍深。\n恨杀惠山寻不见，忽然追我到横林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午过横林回望惠山二首 其一","author":"杨万里","text":"道是冰销快水程，不知青女解藏冰。\n芦花多处竹阴底，砌作瑶堤不计层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午坐卧治斋","author":"杨万里","text":"雨后朝阴到午晴，空斋孤坐纳秋清。\n一蝉也解怜幽寂，柳外飞来叶底鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午热登多稼亭五首 其五","author":"杨万里","text":"御风不必问雌雄，只有炎风最不中。\n却是竹君殊解事，炎风筛过作清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午热登多稼亭五首 其四","author":"杨万里","text":"柳外花边忽飒然，好风一点破愁颜。\n岸巾独倚千寻树，闲看南云度北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午热登多稼亭五首 其三","author":"杨万里","text":"不是城中是甑中，雨馀日色更明红。\n若为飞上金山顶，独立长江万里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午热登多稼亭五首 其二","author":"杨万里","text":"芒鞋葵扇颇萧然，倦倚胡床不是眠。\n避暑无藏身去处，追凉行尽竹旁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午热登多稼亭五首 其一","author":"杨万里","text":"矮屋炎天不可居，高亭爽气亦元无。\n小风不被蝉餐却，合有些凉到老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午睡闻子规","author":"杨万里","text":"睡眼䰒松未爽时，一声杜宇顿开眉。\n不须报道思归乐，今我真归不用思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午憩二首 其二","author":"杨万里","text":"晴边雨后麦秋时，风色轻轻日色微。\n已隔深溪仍蘸水，却教人折野蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午憩二首 其一","author":"杨万里","text":"嫩绿桐阴夹道遮，烂红野果压枝斜。\n日烘细草香无价，况有三枝两朵花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双峰定水璘老送木犀香五首 其二","author":"杨万里","text":"万杵黄金屑，九烝碧梧骨。\n诗老坐雪窗，天香来月窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双峰定水璘老送木犀香五首 其一","author":"杨万里","text":"春得鄞江信，香从定水来。\n今年有奇事，正月木犀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子正月四日后圃行散四首 其四","author":"杨万里","text":"传语春光恰好秾，太秾恐怕恼衰翁。\n日华五色无寻处，只在蛛丝来去中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子正月四日后圃行散四首 其三","author":"杨万里","text":"双鹊营巢浪苦辛，拣条衔折不辞频。\n旧条老硬新条韧，却向篱根拾落薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子正月四日后圃行散四首 其二","author":"杨万里","text":"勃姑偶下小梅枝，要看渠侬褐锦衣。\n柱后藏身教不见，却因不见转惊飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬子正月四日后圃行散四首 其一","author":"杨万里","text":"淡日微舒又急收，兜罗绵隔紫灯毬。\n更将数点无声雨，不湿人衣却湿头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌人日南溪暮景三首 其三","author":"杨万里","text":"翡翠惊飞不作行，沙鸥乱下自成双。\n一天霞绮沉波底，便是西川濯锦江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌人日南溪暮景三首 其二","author":"杨万里","text":"春暖溪暄出小鱼，沉浮上下巧相娱。\n一跳一浪钱来大，开作瑶环忽丈馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬戌人日南溪暮景三首 其一","author":"杨万里","text":"坐看青天起白云，化成龙子钑银鳞。\n霎时塞得青天满，只见龙鳞不见身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬辰别头胡元伯丞公折双梅见赠作一绝以谢之","author":"杨万里","text":"一花怪结双青子，独蒂还藏两玉花。\n薄相春工宁底巧，眼明初见雪枝斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"杨万里","text":"坐看胡孙上树头，旁人只恐堕深沟。\n渠侬狡狯何须教，说与旁人莫浪愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其七","author":"杨万里","text":"人静更深丈室虚，欲眠聊复小踟蹰。\n竹床最冷也成热，羽扇不凉差胜无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其六","author":"杨万里","text":"斜斜花影欲愁予，唧唧虫声亦爱渠。\n月与诗人元不薄，侬于欢伯未应疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其五","author":"杨万里","text":"坐久轻云次第开，月光飞入酒杯来。\n今宵只有半边月，一半桂枝何处栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其四","author":"杨万里","text":"月初生处薄云生，到得云销月政明。\n两处打更如一处，二更还作四更声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其三","author":"杨万里","text":"一年遇暑一番愁，六月梢时七月头。\n今夕追凉还得热，何时遇夏却逢秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下果饮七首 其二","author":"杨万里","text":"酒边无物伴长瓶，一颗新莲一段冰。\n月下不风终是爽，烛光何罪也堪憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下梅花","author":"杨万里","text":"天恐梅花不耐寒，遣将孤月问平安。\n未须一夜都开尽，留取前前后后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月中炬火发仙山驿小睡射亭五首 其五","author":"杨万里","text":"轿中兀得软如痴，逢店投床片子时。\n睡觉不知天晓未，半窗花影木犀枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月中炬火发仙山驿小睡射亭五首 其四","author":"杨万里","text":"长庚初让月先行，不料姮娥也世情。\n趣驾冰轮渡银浦，乱抛玉李掷长庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月中炬火发仙山驿小睡射亭五首 其三","author":"杨万里","text":"月轮已落尚残光，一似西山没夕阳。\n次第长庚都落去，日华犹未出扶桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月中炬火发仙山驿小睡射亭五首 其二","author":"杨万里","text":"踏月何销秉炬行，也防月落未天明。\n果然留下长庚去，更赚行人作晓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月中炬火发仙山驿小睡射亭五首 其一","author":"杨万里","text":"道是宵征即晓光，若言明发未朝阳。\n月华露气山兼水，享尽人间第一凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日午","author":"杨万里","text":"揭竿借日自烘衣，背立晴暄片子时。\n雪后春生人未觉，弄丝蟢子独先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜观雪三首 其三","author":"杨万里","text":"月色还将雪色同，雪光却与月光通。\n都将大地作月窟，仍榜碧天名雪宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜观雪三首 其二","author":"杨万里","text":"月光雪色两清寒，见月初疑是雪团。\n看得雪光还似月，元来雪月一般般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜观雪三首 其一","author":"杨万里","text":"仙人爱雪不嫌寒，挈月来看夜不眠。\n游遍琼楼霜欲晓，却将玉镜挂青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜散策县圃有飞蝶仍闻笛声","author":"杨万里","text":"月明未许人早睡，笛声解与秋争清。\n夜深不应有飞蝶，渠侬似欲伴人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀","author":"杨万里","text":"天将秋气蒸寒馥，月借金波滴小黄。\n不会溪堂老居士，更谈桂子是天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀二绝句 其一","author":"杨万里","text":"只道秋花艳未强，此花尽更有商量。\n东风染得千红紫，曾有西风半点香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀二绝句 其二","author":"杨万里","text":"轻薄西风未办霜，夜揉黄雪作秋光。\n吹残六出犹馀四，匹似天花更著香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀芙蓉盛开","author":"杨万里","text":"先生深住万山村，雾裹云包不见痕。\n也被闲人知去处，芙蓉巷里木犀门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀落尽有感二首 其二","author":"杨万里","text":"姮娥收去广寒秋，太息花中无此流。\n花品已高香更绝，却缘韵胜得清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木犀落尽有感二首 其一","author":"杨万里","text":"一岁秋香又一空，落英憔悴怨西风。\n开时占断西风晓，岂念荷花脱病红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水中山花影","author":"杨万里","text":"闭轿那知山色浓，山花影落水田中。\n水中细数千红紫，点对山花一一同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花四首 其四","author":"杨万里","text":"开处谁为伴，萧然不可亲。\n雪宫孤弄影，水殿四无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花四首 其三","author":"杨万里","text":"韵绝香仍绝，花清月未清。\n天仙不行地，且借水为名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花四首 其二","author":"杨万里","text":"额间拂杀御袍黄，衣上偷将月姊香。\n待倩春风作媒却，西湖嫁与水仙王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花四首 其一","author":"杨万里","text":"江妃虚却蕊珠宫，银汉仙人谪此中。\n偶趁月明波上戏，一身冰雪舞春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水沤二首 其二","author":"杨万里","text":"至宝何缘识得全，骊珠浮没只俄然。\n金仙额上庄严底，只许凡人见半边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水沤二首 其一","author":"杨万里","text":"淡日轻云雨点疏，大沤随雨起清渠。\n跳来走去琼盘里，创见龙宫径寸珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水纹二首 其二","author":"杨万里","text":"初作眉头皱，还成簟面斑。\n小风来不住，织遍一池间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水纹二首 其一","author":"杨万里","text":"池面尖风起，烟痕一拂微。\n无形还有影，掠水去如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水落二首 其二","author":"杨万里","text":"轻寒瑟瑟入船中，闭却船门下却篷。\n要得新晴江水落，不应更恨打头风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水落二首 其一","author":"杨万里","text":"桑椹垂红似荔支，荻芽如臂与人齐。\n夜来水落知深浅，看取芭蕉五尺泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"火阁午睡起负暄二首 其二","author":"杨万里","text":"黄菊霜枝已懒残，瑞香紫笋政团栾。\n盆池影里看题壁，上字还成下字看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"火阁午睡起负暄二首 其一","author":"杨万里","text":"火阁红销雪尚香，睡魔引我入渠乡。\n觉来一阵寒无柰，自掇胡床负太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王式之命刘秀才写予真因署其上","author":"杨万里","text":"浙水东兼浙水西，千岩万壑总遨嬉。\n游山祗欠金华债，乘兴今随王式之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓦店雨作四首 其四","author":"杨万里","text":"近岸人家欲闭门，远林烟树半昏昏。\n鸬鹚白鹭归何晚，今夜定投何处村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓦店雨作四首 其三","author":"杨万里","text":"诗人长怨没诗材，天遣斜风细雨来。\n领了诗材还又怨，问天风雨几时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓦店雨作四首 其二","author":"杨万里","text":"天嫌平野树分明，便恐丹青画得成。\n收入晚风烟雨里，自将水墨替丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓦店雨作四首 其一","author":"杨万里","text":"斜风吹雨打船窗，一阵疏来一阵忙。\n听作山斋声点滴，不知作客在山阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风定过垂虹亭","author":"杨万里","text":"松江未过不胜愁，过了垂虹百不忧。\n忽见石湖山上塔，定知塔背是苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙辰岁朝行东园","author":"杨万里","text":"元日扶衰看早春，嫩苔一径落梅新。\n何人舞罢凌波袜，踏匾真珠满绿絪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园社日","author":"杨万里","text":"风雨摧残桃李枝，东园无树不离披。\n海棠过后残花在，恰似上春初发时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园探桃李二首 其二","author":"杨万里","text":"有花无叶也孤寒，有叶无花草一般。\n最是桃花饶态度，醉红娇绿恼人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园探桃李二首 其一","author":"杨万里","text":"偶逢李径一花开，从此东园日日来。\n更约桃花同坼好，红红白白两相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园晴步二首 其二","author":"杨万里","text":"金沙绕架卧春风，节节新条出嫩丛。\n一色匀排绿瓶子，忽然半缕漏深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园晴步二首 其一","author":"杨万里","text":"浅暖疏寒十日晴，桃花红暗李花明。\n小蜂扑得浑无益，羽扇徒劳不作声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园新种桃李，结子成阴，喜而赋之","author":"杨万里","text":"桃李今春胜去春，添新换旧却重新。\n冥搜奇特根窠底，妙简团栾树子匀。\n移处带花非差事，登时著子亦娱人。\n坡云十载方成荫，未解诚斋别有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东园墙隅双松可爱栽酴醾金沙以绕其上","author":"杨万里","text":"双松树子碧团栾，红锦缠头白锦冠。\n尽放花枝过墙去，不妨分与路人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东窗梅影上有寒雀往来","author":"杨万里","text":"梅花寒雀不须摹，日影描窗作画图。\n寒雀解飞花解舞，君看此画古今无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰溪解舟四首 其一","author":"杨万里","text":"两岸千千万万峰，看来冷白复寒红。\n人言雪岭非银岭，三日晴光晒不融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰溪解舟四首 其四","author":"杨万里","text":"际晚江风刮面来，晓寒已去却重回。\n也知青女嫁滕六，巽二何须强作媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰溪解舟四首 其三","author":"杨万里","text":"只愁滩浅阁行舟，到得江深又不流。\n水鸟避人飞不彻，看他没去看他浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰溪解舟四首 其二","author":"杨万里","text":"日开五色暖征裘，雪满群山爽病眸。\n道是诗人穷到骨，暖边爽里放兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]