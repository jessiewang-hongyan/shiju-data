[{"title":"点绛唇","author":"米友仁","text":"浩渺湖天，酒浮黄菊携佳侣。\n澹烟疏雨。\n去鲁方怀土。\n倾盖相逢，引满哦奇语。\n山围处。\n兕觥频举。\n不醉君无去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴桃源/如梦令","author":"米友仁","text":"蝶梦初回栩栩。\n柳岸几声莺语。\n苹末起微风，山外一川烟雨。\n凝顾。\n凝顾。\n人在玉壶深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"米友仁","text":"柳塘微雨。\n两两飞鸥来复去。\n倚遍重阑。\n人在碧云山外山。\n一春离怨。\n日照绮窗长几线。\n酒病情魔。\n两事春来无奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲","author":"米友仁","text":"从古荆溪名胜地。\n溪光万顷琉璃翠。\n极望荷花三十里。\n香喷鼻。\n我舟日在花间舣。\n向晚馀霞收散绮。\n遥山抹黛天如水。\n满引一尊明月里。\n微风起。\n萧然真在华胥氏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 和晏元献韵","author":"米友仁","text":"郊外春和宜散步。\n百花枝上初凝露。\n福地神仙多外府。\n藏奇趣。\n幽寻历遍溪边路。\n薄宦浮家无定处。\n萍飘梗泛前人语。\n与子未须乡国去。\n来同住。\n且看群岫烟中雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉花阴","author":"米友仁","text":"一阳来复群阴往。\n吾道从今长。\n万事莫关情，月夕风前，依旧须豪放。\n卿云舒卷浮青嶂。\n从古书珍赏。\n满引唱新词，春意看看，又到梅梢上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄","author":"米仲昌","text":"公馀陪侍九锁行，花已凋残莺已老。\n舞蛟亭下泉如奔，伏虎岩前景尤好。\n四围翠巘悉可跻，一点红尘浑不到。\n坐中元白非一人，自愧才疏难压倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望海楼","author":"米芾","text":"云间铁瓮近青天，缥缈飞楼百尺连。\n三峡江声流笔底，六朝帆影落尊前。\n几番画角催红日，无事沧洲起白烟。\n忽忆赏心何处是，春风秋月两茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丑奴儿 见白发","author":"米芾","text":"踟蹰山下濡须水。\n我更委佗，物阜时和，迨暇相逢笑复歌。\n江湖楼上凭栏久。\n极目沧波，天鉴如磨，偏映华簪雪一窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 中秋","author":"米芾","text":"砧声送风急，蟋蟀思高秋。\n我来对景，不学宋玉解悲愁。\n收拾凄凉兴况，分付樽中醽醁，倍觉不胜幽。\n自有多情处，明月挂南楼。\n怅襟怀，横玉笛，韵悠悠。\n清时良夜，借我此地倒金瓯。\n可爱一天风物，遍倚阑干十二，宇宙若萍浮。\n醉困不知醒，欹枕卧江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 秋兴","author":"米芾","text":"溪面荷香粲粲，林端远岫青青。\n楚天秋色太多情，云捲烟收风定。\n夜静冰娥欲上，梦回醉眼初醒。\n玉瓶未耻有新声，一曲请君来听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 海岱楼与客酌别作","author":"米芾","text":"双双鸳鹭戏萍洲，几行烟柳柔。\n一声长笛咽清秋，碧云生暮愁。\n钩月挂，绮霞收，浦南人泛舟。\n娟娟何处烛明眸，相望徙倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情 献汲公相国寿","author":"米芾","text":"薰风吹绽满池莲，晚云楼阁鲜。\n绣閤华堂嘉会，齐拜玉炉烟。\n斟美酒，奉觥船。\n祝华筵。\n宜春耐夏，多福庄严，富贵长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情 思归","author":"米芾","text":"劳生奔走困粗官，揽镜鬓毛斑。\n物外平生萧散，微宦兴阑珊。\n奇胜处，每凭栏。\n定忘还。\n好山如画，水绕云萦，无计成閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 示儿尹仁尹智","author":"米芾","text":"莘野寥寥，渭滨漠漠情何限。\n万重堆案，懒更重经眼。\n儿辈休惊，头上霜华满。\n功名晚，水云萧散，漫就驿亭看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 野眺","author":"米芾","text":"日射平溪玉宇中。\n云横远渚岫重重。\n野花犹向涧边红。\n静看沙头鱼入网，闲支藜杖醉吟风。\n小春天气恼人浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 祝寿○新添。见英光堂帖","author":"米芾","text":"祝寿庆生申。\n德日维新。\n期颐眉寿寿长春。\n五福三灵禄永永，长寿仙人。\n遐算等庄椿。\n□德康宁。\n年年欢会笑欣欣。\n岁岁仰依□寿域，彭祖广成。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 展书卷","author":"米芾","text":"平生真赏，纸上龙蛇三五丈。\n富贵功名，老境谁堪宠辱惊。\n寸心谁语，只有当年袁与许。\n归到辽阳，玉简霞衣侍帝傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 涟水登楼寄赵伯山","author":"米芾","text":"云间皓月，光照银淮来万折。\n海岱楼中，拂袖雄披楚岸风。\n醉馀清夜，羽扇纶巾人入画。\n江远淮长，举首宗英醒更狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 金山","author":"米芾","text":"昔日丹阳行乐里，紫金浮玉临无地。\n宝阁化成弥勒世，龙宫对，时时更有天花坠。\n浩渺一天秋水至，鲸鲵鼓鬣连山沸。\n员峤岱舆更赑屃，无根蒂，莫教龙伯邦人戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 拟古","author":"米芾","text":"蒹葭风外烟笼柳，数叠遥山眉黛秀。\n微雨过江来，烦襟为一开。\n沙边临望处，紫燕双飞语。\n举酒送飞云，夜凉愁梦频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 海岱楼玩月作","author":"米芾","text":"千古涟漪清绝地，海岱楼高，下瞰秦淮尾。\n水浸碧天天似水，广寒宫阙人间世。\n霭霭春和生海市，鳌戴三山，顷刻随轮至。\n宝月圆时多异气，夜光一颗千金贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉太平","author":"米芾","text":"风炉煮茶。\n霜刀剖瓜。\n暗香微透窗纱。\n是池中藕花。\n高梳髻鸦。\n浓妆脸霞。\n玉尖弹动琵琶。\n问香醪饮么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 献汲公相国寿","author":"米芾","text":"暖日晴烘候小春，际天和气与精神。\n灵台静养千年寿，丹灶全无一点尘。\n寿彭祖，寿广成。\n华阳仙裔是今身。\n夜来银汉清如洗，南极星中见老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 漫成","author":"米芾","text":"云液无声白似银，红霞一抹百花新。\n觞多莫厌频频劝，一片花飞减却春。\n蜂翅乱，蝶眉颦。\n花间啼鸟劝游人。\n人生无事须行乐，富贵何时且健身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清风亭","author":"米恁","text":"断碑残画字昏朦，应是山高气似虹。\n我自笔头如许涩，恨无好句傍清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"纪应炎","text":"三年南海清心坐，一任东君冷眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"老农","text":"幸存耕雨地，况值养花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太平兴国寺壁","author":"老妓","text":"曾趁东风看几巡，冒霜开唤满城人。\n残脂剩粉怜犹在，欲向弥陀借小春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"老郎官","text":"猿啼旅思悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"老郎官","text":"下观扬子小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春","author":"衣白山人","text":"一粒金丹，大如黍米，定中降胎。\n运阴阳根本，东龙西虎，结凝金水，择地深栽。\n九载无亏，三田功满，卦气周圆炉鼎开。\n偷元化，用自然宗祖，全在灵台。\n真才。\n休恋尘埃。\n况颖悟明堂婴未孩。\n幸淮滨相遇，灵丹付了，亲留玄旨，期进仙阶。\n此去何时，水云高会，更上烟霞岐路哉。\n人间世，任王侯贵显，同委蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北方馆驲屏风皆画落墨牡丹","author":"许及之","text":"停车京洛净风沙，几见屏开落墨花。\n故国似人犹可喜，秾肌何况谢铅华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白沟河","author":"许及之","text":"艺祖怀柔不耀兵，白沟如带作长城。\n太平自是难忘战，休恨中间太太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白龟","author":"许及之","text":"物有为身累，龟灵却受钻。\n毛公今放汝，珍重保身安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百结","author":"许及之","text":"丁香从百结，恨只满东风。\n未必愁能解，虚传酒有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柏乡县","author":"许及之","text":"昔贤不肯入朝歌，况乃军中忌讳多。\n咄咄衣冠出疆去，迫于人处竟成讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斑竹","author":"许及之","text":"自得湘江种，禽栖不敢弹。\n怕摇枝上露，犹是泪琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋谏长画轴后五王按乐图","author":"许及之","text":"玉笛床头取次横，自吹头管按新声。\n梨园旧谱今何在，一段风流画得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"矮桃","author":"许及之","text":"花叶自低昂，攀折人不舍。\n偷实定短人，朔辩愧黄马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧芦步","author":"许及之","text":"霜叶彫残芰，寒花发旧芦。\n一秋明眼处，落雁惠崇图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"避雨渔阳太守庙","author":"许及之","text":"拂面秋风云漠漠，伤心古汴黍离离。\n不因避雨渔阳庙，争见元丰大观碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百七丈和篇有尽道温柔别有乡谁知绛阙水茫茫之句意有属也再用韵奉酬 其一","author":"许及之","text":"仙凡从昔各为乡，弱水蓬莱隔混茫。\n不见麻姑呈狡狯，空教贺老号清狂。\n两奁心事无人共，万点花飞有底忙。\n说与东风须作主，莫教痴白妒娇黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百七丈和篇有尽道温柔别有乡谁知绛阙水茫茫之句意有属也再用韵奉酬 其二","author":"许及之","text":"休厌黄鹂百啭声，诗翁亦是不平鸣。\n中年怀抱愁离别，暇日亲朋好会并。\n踏损落红无锦袜，吟成白雪有朱英。\n栏杆徙倚空三叹，雨后斜阳写不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百七丈寒食扁舟之盟遽寒姚黄恐成轻负辄赋二篇复以酴醾为约 其二","author":"许及之","text":"连夕惊雷非恶声，池塘閤閤几蛙鸣。\n春程尚有三之一，乐事那能四者并。\n养得苔钱都满砌，足为花地藉残英。\n闻閒不惜冲泥过，架上酴醾玉已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百七丈寒食扁舟之盟遽寒姚黄恐成轻负辄赋二篇复以酴醾为约 其一","author":"许及之","text":"閒中直指醉为乡，寒食扁舟竟渺茫。\n可惜海棠随雨过，犹怜粉蝶伴醒狂。\n游人静后西山好，春事深来老圃忙。\n未必烦公频折简，花时还是负姚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被旨祈祷数至天竺圭僧录求白云堂诗为赋唐律一首","author":"许及之","text":"白云峰下白云堂，堂上高人一办香。\n绕殿持经山四合，缭墙行道木千章。\n众生未免婴时苦，大士宁能与世忘。\n祈雨祈晴来复去，此身却似白云忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲍融州病足叩谒适遇孝若示融州菊诗和篇次韵呈","author":"许及之","text":"不见融州夏涉秋，居然款对豁羁愁。\n犹存尊足怜同病，不系虚舟任打头。\n久待一州当敛惠，终烦诸野要营求。\n我今不啻便应足，独恨于君百未酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白石榴","author":"许及之","text":"花开水晶瓶，叶排青琐窗。\n枝红立白帜，蝶阵垂翅降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋宋朝老再和陶渊明归去来辞","author":"许及之","text":"吾乡说三宋，伯也抱奇伟。\n太学三十年，不作举子语。\n晚当拜特恩，青衫送还官。\n开口论世事，有舌不可扪。\n吾皇开寿域，汪濊泽万国。\n勉公俯而就，如女有正色。\n翻然感际会，千载今一时。\n谁欤俾宿留，再和归来辞。\n渊明归有田，公归徒四壁。\n姑奉祝融祠，胜煮南山石。\n公乎未得第，我辈惭登科。\n空飧了无补，奈此归来何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎","author":"许及之","text":"旧俗传荆楚。\n正江城、梅炎藻夏，做成重午。\n门艾钗符关何事，付与痴儿騃女。\n耳不听、湖边鼍鼓。\n独炷炉香熏衣润，对潇潇、翠竹都忘暑。\n时展卷，诵骚语。\n新愁不障西山雨。\n问楼头、登临倦客，有谁怀古。\n回首独醒人何在，空把清尊酹与。\n漾不到、潇湘江渚。\n我又相将湖南去，已安排、吊屈嘲渔父。\n君有语，但分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别龙隐岩","author":"许子绍","text":"矫首初来北斗峰，直穿山腹作玲珑。\n石间蜕骨痕犹在，渊底藏珠水更通。\n霖雨几时岩墅去，卧龙底处草庐空。\n眼中要识真英物，寓迹何劳想下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涵碧亭","author":"许中应","text":"清泚何妨一整巾，苍崖先自怯登临。\n汎现人物几荣悴，祗有林泉无古今。\n万个倘容参直节，一泓端欲印无心。\n苍颜还许交同老，罗隐书堂尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪邑大夫登西岘峰","author":"许中应","text":"晴暾发轻暑，惠风荡繁林。\n驱车青郊路，举跐西山岑。\n随流玩回转，就阴便清深。\n子规续哀响，仓庚流好音。\n侧径既窈窕，层崖亦岖嵚。\n石泉漱琼瑶，松风戛璆琳。\n云间渺虚旷，恍若韶濩临。\n水乐名其亭，上有坡仙吟。\n泉甘瀹新茗，芹香侑清斟。\n攀跻岂不劳，景胜忘所任。\n夕阳忽在山，清兴浩难禁。\n山灵应有约，何时重来寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕","author":"许介轩","text":"柳影芹香二月春，一巢才定即栖身。\n不应它处无华屋，自是难忘旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄林可山","author":"许介轩","text":"不必孤山是故庐，江湖稳处即安居。\n家贫无料可供鹤，池小有泉能活鱼。\n好客每倾赊到酒，因吟犹读老来书。\n屋头但得梅常在，日月春风自有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城阳祭祖","author":"许元","text":"仙翁醉卧南山头，吸月餐霞听鸟讴。\n丹沼只今留旧迹，云孙千载荐春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"许元","text":"芍药琼花应有恨，维扬新什独无名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风水洞","author":"许元祐","text":"野寺依山立，松桥避石斜。\n坏梁飞白蚁，枯木挂青蛇。\n道路悲蓬转，功名惜鬓华。\n聊将洞中水，试洗眼前花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘磐幕","author":"许元信","text":"山悬翠幕几千丈，我疑山顶即天上。\n扪萝蹑蹬到山巅，犹如平地上青天。\n始知天高应无极，幕阜苍苍一卷石。\n洞庭八百古所传，对此遥看一镜圆。\n当此再上三千丈，那知天下有山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幕阜山","author":"许元信","text":"幕阜山高一千八百丈，二十五洞大元天。\n雪花飞满水冲石，翠嶂拨开风卷烟。\n金鲤一双游碧沼，石田三亩产红莲。\n我来绝顶无他事，为访仙翁葛稚川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴谨微游仙都五首 其五","author":"许尹","text":"桃源归路净无尘，只是当时避世人。\n仙事茫茫类如此，鼎湖辙迹恐非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴谨微游仙都五首 其四","author":"许尹","text":"黄帝得仙从此去，鼎湖传说几经年。\n龙髯堕地成春草，直到如今不上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴谨微游仙都五首 其三","author":"许尹","text":"玉貌仙人老不癯，世间荣辱此中无。\n烟云昨夜微销铄，似怪题舆车骑都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴谨微游仙都五首 其二","author":"许尹","text":"山中鹤怨无寻处，洞口云归未得归。\n忆著仙都旧时路，石梁苔涩履痕稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴谨微游仙都五首 其一","author":"许尹","text":"仙都踪迹想遗书，我欲归时更问途。\n忽得新诗如见画，山蹊野径不须迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝阳岩","author":"许尹","text":"漫作游仙去，灵槎进晚凉。\n悬岩迷日月，倒影浸潇湘。\n风满征帆过，云归度鸟忙。\n相忘物外趣，时许棹相将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"含笑花","author":"许开","text":"献笑佳人绝可怜，姿姿靥辅巧承欢。\n一枝不用千金买，雨洗风吹却粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":40017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]