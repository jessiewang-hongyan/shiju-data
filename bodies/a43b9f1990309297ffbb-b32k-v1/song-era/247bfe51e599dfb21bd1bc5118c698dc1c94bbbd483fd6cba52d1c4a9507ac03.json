[{"title":"题跨湖桥下酒家","author":"陆游","text":"湖水绿于染，野花红欲燃。\n春当三月半，狂胜十年前。\n小店开新酒，平桥上画船。\n翩翩幸强健，不必愧华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题僧庵","author":"陆游","text":"细路穿云坞，危桥渡野塘。\n人稀土花碧，屋老瓦松长。\n忧患双蓬鬓，装资一布囊。\n烧薪藉馀暖，今夜有新霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"儒生","author":"陆游","text":"儒生安义命，所遇委之天。\n用可重九鼎，穷宁直一钱。\n虽云发种种，未害腹便便。\n高卧茅檐下，羹藜法不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩归州光孝寺寺后有楚冢近岁或发之得宝玉剑佩之类","author":"陆游","text":"秭归城畔蹋斜阳，古寺无僧昼闭房。\n残佩断钗陵谷变，苫茆架竹井闾荒。\n虎行欲与人争路，猿啸能令客断肠。\n寂寞倚楼搔短发，剩题新恨付巴娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"懒趣","author":"陆游","text":"谢病掩柴荆，年来懒趣成。\n舌根茶味永，鼻观酒香清。\n已矣驰驱息，悠然磊磈平。\n高眠得三昧，梦断已窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕","author":"陆游","text":"春昼花明映柳纤，燕归胜事始能兼。\n争梁谇语惊幽梦，掠地斜飞避画帘。\n雏食得虫应自喜，巢泥经雨更频添。\n去来要是知时节，常怪人嘲作附炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂东偏一室颇深暖尽日率困于吏牍比夜乃得读书其间戏作三首 其二","author":"陆游","text":"赋性无他好，开编喜欲迷。\n鼕鼕传夜漏，喔喔待晨鸡。\n油减玉虫暗，灰深红兽低。\n悠然抚书叹，无术济黔黎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂东偏一室颇深暖尽日率困于吏牍比夜乃得读书其间戏作三首 其一","author":"陆游","text":"衮衮流年往，匆匆短景过。\n帘深上灯早，地窄贮香多。\n书尽还重读，诗成更自哦。\n向令无此处，将奈旅愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂东偏一室颇深暖尽日率困于吏牍比夜乃得读书其间戏作三首 其三","author":"陆游","text":"永夜东斋里，人声静不哗。\n衣篝起香穗，书几落灯花。\n炉暖听寒雨，窗明送晓鸦。\n文章空自苦，白首不名家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕堂春夜","author":"陆游","text":"南楼紞紞下疏更，一点纱笼满院明。\n映月疏梅入帘影，读书稚子隔窗声。\n呻吟药裹身宁久，汛扫边尘意未平。\n草檄北征今二纪，山城仍是老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羲农","author":"陆游","text":"羲农去不反，释老似而非。\n太息众皆醉，逝将谁与归。\n经时忘肉味，尽日掩柴扉。\n安得同心者，灯前语造微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薄醉遣怀","author":"陆游","text":"局蹐蜗庐迮，萧条鹤发新。\n途穷贫入梦，身老病欺人。\n带索忘三组，羹藜抵八珍。\n蓬窗一杯酒，自觉胆轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡门","author":"陆游","text":"小聚风烟外，衡门水竹间。\n疏沟分北涧，剪木见南山。\n人笑谋生拙，天教到死闲。\n犹存拄杖子，遇兴即跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡门独立","author":"陆游","text":"春归堪笑又匆匆，水白秧青细雨濛。\n溪鸟低飞画桥外，路人相值绿阴中。\n宋清药券贫来积，李贺诗囊病后空。\n惟有剧谈能一洗，芳尊那得故人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衡门晚眺","author":"陆游","text":"幽居端似玉川生，茅屋支撑不更营。\n青旆荒寒增酒兴，锦囊零落负诗情。\n残芜色衬斜阳远，落叶飞如野鸟轻。\n徂岁峥嵘忽如许，雁来又过会稽城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠王伯长主簿","author":"陆游","text":"学诗大略似参禅，且下功夫二十年。\n君要亲尝狮子吼，法须尽吐野狐涎。\n几人错会先师话，吾辈元齐古佛肩。\n天遣放翁穷不死，茶山钵袋未曾传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠石帆老人","author":"陆游","text":"地僻林深客到稀，高舂未起闭柴扉。\n新松郁郁三千本，密竹萧萧一尺围。\n溪叟旋分菰米滑，山童新采蕨芽肥。\n因君更作长闲想，麟阁云台竟是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠传神水鉴","author":"陆游","text":"写照今谁下笔亲，喜君分得卧云身。\n口中无齿难藏老，颊上加毛自有神。\n误遣汗青成国史，未妨著白号山人。\n它时更欲求奇迹，画我溪头把钓缗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠吕次翁","author":"陆游","text":"君得金丹虽未仙，放翁邂逅与忘年。\n空能处处誇诗句，不解时时赠酒钱。\n马骏极知生冀土，鹤飞会见上辽天。\n尔来笔砚尘埃满，剩欲相从乞一联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠成封州","author":"陆游","text":"绿发临边固已奇，不应憔悴客京师。\n极知自有封侯骨，但要无忘耕垄时。\n意气覆毡书捷布，风流横槊赋新诗。\n平生每恨相从少，满眼关山又语离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠西山老人","author":"陆游","text":"生世不把笔，残年惟灌园。\n赁舂来并舍，卖画到前村。\n勤苦供租税，清贫遗子孙。\n从来栖遁志，剩欲与翁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠邢刍甫","author":"陆游","text":"割愁何处有并刀，倾座谁能夺锦袍。\n堪笑陆翁邻鬼录，尚推邢友擅人豪。\n杜门虽少客载酒，落笔已能奴命骚。\n安得相从北窗下，丐君剩馥与残膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠苏召叟","author":"陆游","text":"苏子出俦辈，翩如天际鸿。\n才华刮眼膜，文字愈头风。\n岂止千人见，真当四海空。\n老夫虽耄矣，此论不妨公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠进贤刘令","author":"陆游","text":"簿领尘埃里，超然见凤麟。\n性疏忘顾忌，学大有经纶。\n正论虽频接，高标岂易亲。\n向来相识晚，吾党欠斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陆伯政","author":"陆游","text":"夜窗灯火老徒勤，自悯何时可策勋。\n未丧斯文天寿我，岂无馀子我思君。\n约通残谱言犹在，细读新诗笔欲焚。\n早晚皇恩许归去，相呼同卧石帆云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠拄杖","author":"陆游","text":"历险横空捷有神，得来元自剡溪滨。\n同为万里江湖客，共见三生风月身。\n不怕云中伴凫舄，只愁雨后长龙鳞。\n何妨更悟无生理，露柱灯笼一话新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林使君二首 其一","author":"陆游","text":"使君物外阅年华，厌听奴兵早暮衙。\n双履踏云呼野渡，一瓢邀月醉梅花。\n红炉点汞闲消日，乌几翻经不忆家。\n我亦岷山有归处，约君同载溯三巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林使君二首 其二","author":"陆游","text":"松桧阴中百步廊，我来剥啄叩琳房。\n鱼肠宝剑馀蛟血，鸦嘴金锄带药香。\n弱水蓬莱风浩浩，赤明龙汉劫茫茫。\n何妨付与神丹诀，教跨青鸾到帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠枫桥化城院老僧","author":"陆游","text":"老宿禅房里，深居罢送迎。\n炉红豆萁火，糁白芋魁羹。\n毳衲年年补，纱灯夜夜明。\n门前霜半寸，笑我事晨征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠表弟江参议","author":"陆游","text":"襄州参议真豪杰，熟视华途懒著鞭。\n夺得鸾篦花里活，皎如玉树酒中仙。\n才高狗监无人荐，句好鸡林有客传。\n老去眼边亲旧少，津亭少为系归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵去华","author":"陆游","text":"赵子毫端万斛珠，眼前百辈不枝梧。\n盛名岂待它年见，公论何曾一日无。\n我老杜门惟足睡，君豪折简固难呼。\n此诗强欲相题目，堪笑衰翁胆满躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠猫","author":"陆游","text":"盐裹聘狸奴，常看戏座隅。\n时时醉薄荷，夜夜占氍毹。\n鼠穴功方列，鱼餐赏岂无。\n仍当立名字，唤作小于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐者二首 其二","author":"陆游","text":"力量超终古，光明破积昏。\n独行宁有待，妙用本忘言。\n神定婴儿戏，丹灵竖子奔。\n绪馀应不靳，小出济元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐者二首 其一","author":"陆游","text":"畴昔从君处，玄都太古坛。\n月高幡影直，霜重佩声寒。\n鹤驾三山近，壶天万里宽。\n相逢初未省，但认切云冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠曾温伯邢德允","author":"陆游","text":"发似秋芜不受耘，茶山曾许与斯文。\n回思岁月一甲子，尚记门墙三沐熏。\n卷里圣贤能觌面，人间富贵实浮云。\n二君才气俱超绝，岂待衰翁诵所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠童道人盖与予同甲子","author":"陆游","text":"吾侪之生乙巳年，达者寥寥穷比肩。\n退士一生藜藿食，散人万里江湖天。\n忍贫不变我自许，挟术自营君岂然。\n一事尚须烦布策，几时能具钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道侣","author":"陆游","text":"崎岖世路久知难，准拟丹成玉鍊颜。\n十载寻人遍岩穴，一樽随处对溪山。\n苏门昼寂闻舒啸，函谷秋清候度关。\n剩欲相招同此事，疑君未办一生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道侣","author":"陆游","text":"蕊笈人多有，惟君独造微。\n丹成河自塞，吟罢剑俱飞。\n酒市寻差易，云山觅更非。\n何时醉携手，为我发玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道流","author":"陆游","text":"羽人邂逅饮旗亭，自说经年醉不醒。\n曾伴翰林游赤壁，仍邀内史写黄庭。\n古琴蛇蚹评无价，宝剑鱼肠托有灵。\n太华何时寻此约，九霄风露宿青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道流","author":"陆游","text":"卖药会稽市，不知今几年。\n身常杂庸保，世果有神仙。\n醉帽簪花舞，渔舟听雨眠。\n放翁独识子，肯向俗人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道流","author":"陆游","text":"烟云深处作生涯，回首人间岁月赊。\n留得朱颜凭绿酒，扫空白发赖丹砂。\n七弦指下泠泠久，双袖风中猎猎斜。\n他日相寻不知处，会从渔父问桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠镜中隐者","author":"陆游","text":"小筑林间避世纷，不妨野叟是知闻。\n来游喜有楫迎我，归卧岂无云赠君。\n得鹿梦回初了了，吠獒声恶尚狺狺。\n从今雪夜频相过，纸帐蒲团要策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑近村偶题","author":"陆游","text":"乞得身归荷圣时，登临筋力未全衰。\n楚祠草合三叉路，隋寺苔侵半折碑。\n孤店不妨乘月宿，扁舟频为看山移。\n红尘冠盖真堪怕，还我平生白接䍦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"默坐","author":"陆游","text":"巧说安能敌拙修，焚香默坐一窗幽。\n煌煌炎火常下照，浩浩黄河方逆流。\n气住神仙端可学，心虚造物本同游。\n绝知此事不相负，荆棘剪除梨栗秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羁怀","author":"陆游","text":"羁怀不复耐悲欢，清镜朝朝雪鬓繁。\n谢傅畏逢亲友别，庞公思遗子孙安。\n残骸累岁归民伍，半俸今春上县官。\n闭户惟须学坚坐，不知更败几蒲团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天杂兴三首 其二","author":"陆游","text":"万鼓风声吼屋边，老人裘绔旋装绵。\n晨梳堕发知衰甚，夜枕闻鸡尚慨然。\n身后文章空饱蠹，眼前交旧半沉泉。\n饭蔬饮水平生惯，耻向天公更乞怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天杂兴三首 其三","author":"陆游","text":"少学愚公一味愚，莫年仍似病相如。\n闲吟寄友惟生纸，草具留僧只野蔬。\n雨涩溪流殊未足，霜高木叶已无馀。\n潭州丞相怜衰疾，细字时收尺素书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天杂兴三首 其一","author":"陆游","text":"枫叶全丹槲叶黄，江城残角伴斜阳。\n琴书自足闲中乐，天地能容醉后狂。\n老死山林初不憾，梦游河渭独难忘。\n谷城黄石今安在，取履犹思效子房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晚兴","author":"陆游","text":"薄霜门巷不胜清，小立湖边夕照明。\n红颗带芒收晚稻，绿苞和叶摘新橙。\n闲评琴价留僧话，静听松声领鹤行。\n壮志消磨浑欲尽，西风莫动玉关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜月","author":"陆游","text":"枯草霜花白，寒窗月影新。\n惊鸦时绕树，吠犬远随人。\n出仕谗销骨，归耕病满身。\n世间输坏衲，切莫劝冠巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜风","author":"陆游","text":"十月霜风吼屋边，布裘未办一铢绵。\n岂惟饥索邻僧米，真是寒无坐客毡。\n身老啸歌悲永夜，家贫撑拄过凶年。\n丈夫经此宁非福，破涕灯前一粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜风","author":"陆游","text":"霜风近海夜飕飕，敢效庸人念褐裘。\n关吏虽通西域贡，王师犹护北平秋。\n黄旗驰奏有三捷，金印酬功多列侯。\n愿补颜行身已老，区区畎亩亦私忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜夜二首 其一","author":"陆游","text":"月淡霜清夜漏迟，疏钟杳杳度南陂。\n灯残有恨欲谁语，鸡老无声如我衰。\n使入蜀川方在道，书传淮浦定何时。\n若为可遣闲愁得，独拥寒炉爇豆萁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜降前四日颇寒","author":"陆游","text":"草木初黄落，风云屡阖开。\n儿童锄麦罢，邻里赛神回。\n鹰击喜霜近，鹳鸣知雨来。\n盛衰君勿叹，已有复燃灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜晓","author":"陆游","text":"霜有连甍白，林无一叶青。\n纸衾围栗烈，风响送东丁。\n酒尽尊馀滴，灰深火拨星。\n蓬窗了无事，默坐养黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜晓肩舆行湖上","author":"陆游","text":"去去出柴关，巾车古陌间。\n晨霜染丹叶，宿雾淡青山。\n登览身犹健，歌呼酒每悭。\n殷勤镜湖水，聊为照衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜寒","author":"陆游","text":"霜重晨檐滴，薪乾夜焙温。\n老惟便布褐，病不出柴门。\n瓶里梅花堕，窗间鹊语喧。\n闲人信无事，午睡到黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜寒不能出户偶书","author":"陆游","text":"垂老仍多病，浓霜得快晴。\n犹能挼菊醉，但负探梅行。\n篝火烘裘暖，油窗泼眼明。\n小儿殊可喜，和我读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜晴","author":"陆游","text":"万瓦新霜白，一窗朝日晴。\n破裘身亦暖，细字眼犹明。\n耄喜谵谆语，衰常踸踔行。\n登封书不草，力穑报时平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曝书偶见旧稿有感","author":"陆游","text":"日满晴轩理蠹鱼，壮游回首一欷歔。\n凄凉王粲从军作，零落相如谏猎书。\n歌吹恍思登北固，弓刀谁记渡南沮。\n虎头本欠功名相，归老林间计未疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曝旧画","author":"陆游","text":"故箧开缄一怆情，断缣残幅尚知名。\n翩翩戏鹊如相语，汹汹惊涛觉有声。\n柳暗正当烟未敛，花秾仍值雨初晴。\n百年手泽存无几，虫蠹尘侵祇涕横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羸老","author":"陆游","text":"羸老幸未死，敢嗟生理微。\n牛闲牧童卧，犬吠市船归。\n月落见收网，灯青闻踏机。\n时时语邻里，井臼幸相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羸卧","author":"陆游","text":"羸卧将如老景何，小园风月且婆娑。\n茶因春困论交密，酒为家贫作态多。\n马上元无听鸡句，原头那有饭牛歌。\n自怜远屏犹多事，卖药归来买钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羸疾","author":"陆游","text":"羸疾止还作，已过秋暮时。\n但当名百药，那更谒三医。\n强饭幸如昨，清游元有期。\n新霜宜野店，行矣不须疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蹭蹬","author":"陆游","text":"少慕功名颇自奇，一生蹭蹬鬓成丝。\n市楼酒美贫何预，斗柄春回老不知。\n黑帜游魂应有数，白衣效命永无期。\n鱼梁东畔牛栏北，举世谁能识此悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀昔","author":"陆游","text":"奋迹穷阎本甚微，刺天何敢慕群飞。\n业文仅与驴书券，学射才因鼠发机。\n罟擭纵横真脱命，风波澒洞尚馀威。\n朝冠挂了方无事，却爱山僧百衲衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瀼西","author":"陆游","text":"千载瀼西路，今年著脚行。\n匆匆衰已具，渺渺恨难平。\n绝壁猿啼雨，深枝鹊报晴。\n亦知忧吏责，未忍废诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]