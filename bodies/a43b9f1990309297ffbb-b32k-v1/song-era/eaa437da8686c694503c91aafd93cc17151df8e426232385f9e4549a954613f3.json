[{"title":"霜天晓角","author":"华岳","text":"裙儿六幅，谁染秋波绿。\n一搦柳腰两过，樽前粲粲玉。\n暑气消烦溽。\n日月飞车轴。\n线幕黄帘风露。\n那堪人在天北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 其二","author":"华岳","text":"蒲帆十幅。\n飞破秋江绿。\n天际彩虹千丈，阑干外、泻寒玉。\n一雨收残溽。\n云山开画轴。\n试问故人何处，青楼在画桥北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 其一","author":"华岳","text":"情刀无斸。\n割尽相思肉。\n说后说应难尽，除非是、写成轴。\n帖儿烦付祝。\n休对傍人读。\n恐怕那懑知后，和它也泪瀑漱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿灌头","author":"华岳","text":"淡鱼才煮咸鱼熟，白酒新篘红酒香。\n莫讶杯盘成草草，一年忙处是蚕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题壁","author":"华春娘","text":"燕子楼中燕子飞，芹泥一点误沾衣。\n主人频起嗔嫌意，垂下珠帘不放归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南","author":"华清淑","text":"燕塞雪，片片大如拳。\n蓟上酒楼喧鼓吹，帝城车马走骈阗。\n羁馆独凄然。\n燕塞月，缺了又还圆。\n万里妾心愁更苦，十春和泪看婵娟。\n何日是归年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会稽览古诗 其九 孟桥","author":"华镇","text":"溪上还珠太守家，小桥斜跨碧流沙。\n清风不共门墙改，长与寒泉起浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风流子 郭县尹美任","author":"危西麓","text":"西风吹锦水，朝天路、冉冉两凫飞。\n看父老袅花，苦遮去辙，儿童骑竹，争问归期。\n帐簇马前纷蔽日，实绩纪行碑。\n冰饮三年，从容官事，棠阴百里，悠久民思。\n圣明衿遐远，关山道，应是来骤华丝。\n画绣过家，莱庭彩舞斑衣。\n便稳奉安舆，江南向暖，早传言语，樵曲先知。\n重约旧临，倪耄迎候杭西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积翠楼","author":"危和","text":"著我高远堂，恍若非人世。\n一榻卧白云，清寒不成寐。\n松竹四山秋，飕飕惊客耳。\n谁在隔窗中，朱弦写流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广福院","author":"危固","text":"二月杨花满路飞，莺篁清巧弄晴晖。\n谁知骚雅寻芳客，寂寞东风马上归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"福山寺","author":"危固","text":"覆船山色翠峨峨，栽石藏云不厌多。\n达理禅师超彼岸，莫疑身外有风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归西林院","author":"危固","text":"振锡西林去，清闲称所依。\n高巢孤鹤返，深谷片云归。\n野色供吟笔，秋光射衲衣。\n长亭携别处，落日半沉晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隐居","author":"危固","text":"高士隐居处，迢迢绿水湾。\n数间玉川屋，七里子陵滩。\n出入是非外，醉醒文字间。\n千钟天子禄，不肯换清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 题九里桥","author":"危昂霄","text":"晴云十丈跨杉溪。\n偏称夜凉时。\n我来正值，一滩月朗，万木霜飞。\n谪仙不住人间世，此恨有谁知。\n何人画我，倚阑得句，听水忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永遇乐","author":"危复之","text":"早叶初莺，晚风孤蝶，幽思何限。\n檐角萦云，阶痕积雨，一夜苔生遍。\n玉窗闲掩，瑶琴慵理，寂寞水沈烟断。\n悄无言，春归无觅处，卷帘见双飞燕。\n风亭泉石，烟林薇蕨，梦绕旧时曾见。\n江上闲鸥，心盟犹在，分得眠沙半。\n引觞浮月，飞谈卷雾，莫管愁深欢浅。\n起来倚阑干，拾得残红一片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新月","author":"危拱辰","text":"未审初三月，嫦娥怨阿谁。\n懒开十分镜，祇画一边眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚","author":"危昭德","text":"晴天杨柳丝千绪，淡月梨花玉一庭。\n又是东风去时节，数声啼鸟不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公","author":"危彪","text":"世态纷纷等触蛮，惟公打透利名关。\n八州不作士衡梦，三径谩为元亮还。\n苦淡平生安北巷，孤高一节照西山。\n想应精爽难埋没，只在青松白石间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书灯蛾","author":"危涴","text":"三生炙手权门者，此日趋炎态未除。\n汝自燃脐何所恨，可怜遗臭入诗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公章二首 其二","author":"危骖","text":"巴陵三载掾，太半并棠阴。\n仆守濂溪训，公推靖献心。\n迨更深夜箦，茹纳惜时金。\n引领西山路，天风泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公章二首 其一","author":"危骖","text":"今代平塘老，前身靖节翁。\n直心行杲日，清德照寒空。\n乐道箪瓢外，归真躯壳中。\n政应高扁墓，百世使闻风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上雷漕","author":"危稹","text":"破裘芒履晚山前，手抱乌桐白玉弦。\n闻道知音在高处，一声弹入紫微天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妇叹","author":"危稹","text":"记得萧郎登第时，谓言即日凤皇池。\n而今老等閒官职，日欠人钱夜欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经从丰城谒于房州于令侍姬歌舞进酒二首 其二","author":"危稹","text":"更有佳人在空谷，能唱春风天上曲。\n何时得上金玉堂，一声飞度龙吟竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经从丰城谒于房州于令侍姬歌舞进酒二首 其一","author":"危稹","text":"蛾眉对歌舞凉伊，舞身还逐歌声齐。\n捲花万段忽进酒，斗高蝴蝶飞来低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日有感三首 其三","author":"危稹","text":"情知老却流莺了，争奈狂如蛱蝶何。\n尚有紫薇红药在，佳人休唱怨春歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日有感三首 其二","author":"危稹","text":"看书数叶眼花旋，推过熏炉去打眠。\n五十压头衰白尽，书无灵圣事茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日有感三首 其一","author":"危稹","text":"春入长安百万家，湖边无日不香车。\n一株柳色吾无分，看杀庭前荠菜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事","author":"危稹","text":"麦风翻陇泼浓绿，花露滴枝粘老红。\n小立楼头检春事，一丝暖日坠青虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牵牛花","author":"杨巽斋","text":"青青柔蔓绕修墙，刷翠成花著处芳。\n应是折从河鼓手，天孙斜插鬓云香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘帅归蜀","author":"危稹","text":"万水朝东弱水西，先生归去老峨眉。\n人閒那得楼千尺，望得峨眉山见时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题吴淑妃真子","author":"危稹","text":"海静江澄玉雪腮，何年和月下瑶台。\n卷中不敢端详看，曾得君王一笑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题杨妃牙痛图","author":"危稹","text":"痛入香龈是不禁，三郎心痛亦何深。\n当时更有唇亡处，自是君王不动心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠书肆陈解元 其一","author":"危稹","text":"巽斋幸自少人知，饭饱官闲睡转宜。\n刚被旁人去饶舌，刺桐花下客求诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠书肆陈解元 其二","author":"危稹","text":"兀坐书林自切磋，阅人应似阅书多。\n未知买得君书去，不负君书人几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藕花中未开之荷穿叶而出","author":"危稹","text":"风清宴瑶池，正拥万姬醉。\n忽有青衫人，穿仗献封事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上赵总领","author":"危稹","text":"一见烦公道眼明，悬知彻底五湖清。\n岂期天上张公子，犹记当年刘更生。\n几度夜深流水操，无人心认断肠声。\n平生不面却相识，黄鹤楼前今一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙行之出守衡阳","author":"危稹","text":"日日江头送客行，况闻君去作专城。\n心存臣子无中外，士系朝廷有重轻。\n谏疏满怀催上道，中原万事想关情。\n戎葵到底还倾日，侧耳衡阳来雁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送晁告院得南康","author":"危稹","text":"我是康庐旧冷官，梦魂今尚忆云端。\n山将草色到天碧，泉带松声出谷寒。\n仙观几年留鹤隐，古潭有日起龙蟠。\n史君肯著诗料理，乞我蛮笺半幅看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽月湖二首 其二","author":"危稹","text":"诏书屡趣入承明，黄阁前头不肯登。\n苦欲归休同野老，本来清净是禅僧。\n苔生文塔今成古，影挂山房唤不应。\n犹想经行泉石处，倚岩憔悴一枯藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽月湖二首 其一","author":"危稹","text":"天胡夺我老先生，轩冕丛中玉雪清。\n英石数拳归艇重，月湖千顷世缘轻。\n云山买得无馀俸，句法流将不尽名。\n头白贾生非不遇，所言向已略施行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽同年胡司门","author":"危稹","text":"期集盟惟旧，交承契更深。\n雨声春共酌，灯影夜同吟。\n接武方尧殿，招魂遽楚音。\n尤怜哭君日，来纳惜时金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄真西山","author":"危稹","text":"有美真夫子，平生心泰和。\n令名香宇宙，厚德福山河。\n有客湖湘至，谈公政化多。\n莫侵霜鬓否，书至报如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤","author":"危稹","text":"楚楚雪衣明，烟霞径里行。\n不管陶令野，有节伯夷清。\n一见消尘虑，相亲长道情。\n秋风著梧叶，时作九皋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上隆兴赵帅","author":"危稹","text":"买宅须买千万邻，季雅喜得王僧珍。\n买山百万复谁与，襄阳节度真主人。\n我生兀兀钻蠹简，不肯低头植资产。\n缀名虎榜二十年，依旧酸寒广文饭。\n绿鬓半作星星华，岂堪风雨犹无家。\n大鹏小鴳各自适，只有鸿雁长汀沙。\n弟昆团栾虽足乐，老屋萧条不堪著。\n玉堂便是无骨相，也合专侬一丘壑。\n近来卜筑穷冥搜，十里而近依松楸。\n骊龙塘上邓家丘，半山老人所钓游。\n半山天下文章伯，邓家声名亦辉赫。\n断碑犹在古墙阴，好句曾经写山色。\n买邻得此天所予，独欠山资无觅处。\n平生骂钱作阿堵，仓卒呼渠宁肯顾。\n君侯地位高入云，笔所到处皆成春。\n万间广厦芘许远，岂无一室栖贫身。\n王邓故处为邻曲，更得赵侯钱买屋。\n便哦诗句谢山神，饮水也胜樽酒绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王架阁夙有棋癖尝于和篇中讥其不工架阁颇讳恶其说复次韵戏之","author":"危稹","text":"刘伶耽于酒，渊明玩于菊。\n君乃癖于文，爱棋尤更笃。\n文高新掌故，棋只前秘读。\n我昨却莱兵，书法谨夹谷。\n不知君讳之，护名如护玉。\n耻鼓赵王瑟，欲举渐离筑。\n明发疾呼予，开枰数反覆。\n盛气欲吞敌，厉响亦惊俗。\n失利赪凑颊，得隽喜填腹。\n势固健于常，手终弱于仆。\n君名高天下，此特一不足。\n小负毋重争，旁观有静瞩。\n大明昧于小，月固不胜烛。\n切勿罪刘五，此笔兢所录。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送柴中行出守章贡","author":"危稹","text":"力为君王乞得州，补天未了石还收。\n人才自系国轻重，吾道亦关公去留。\n殿角才辞槐影日，船头便转荻花秋。\n竞誇祖帐都门外，谁识眉攒杜甫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"借诗话于应祥弟有不许点抹之约作诗戏之","author":"危稹","text":"我有读书癖，每喜以笔界。\n抹黄饰句眼，施朱表事派。\n此手定权衡，众理析畎浍。\n历历灿可观，开卷如画绘。\n知君笃友于，因从借诗话。\n过手有约言，不许一笔坏。\n自语落我耳，便觉意生械。\n明朝试静观，议论颇澎湃。\n读到会意处，时时欲犯戒。\n将举手复止，火侧禁搔疥。\n技痒无所施，闷怀时一噫。\n只可捲还君，如此读不快。\n千驷容可轻，君抱亦少隘。\n昨问鸡林人，尚有此编卖。\n典衣须一收，吾炙当痛嘬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭公篇","author":"危稹","text":"郭公郭公，闻尔失国春秋时，何事到此犹悲啼。\n郭公前言亡国故，当时只缘臣子误。\n百年社稷不得归，而今家住柘冈西。\n满目春风都是恨，声声说与齐侯知。\n国亡矣，君勉之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"接客篇","author":"危稹","text":"接客接客，高亦接，低亦接。\n大儿稳善会传茶，小儿踉蹡能作揖。\n家人不用剪髻云，我典唐书充馔设。\n唐书典了犹可赎，宾客不来门户俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 庆齐年诸丈","author":"危稹","text":"洛阳九老图中，当时司马年犹小。\n争如今夕，举杯相劝，十人齐寿。\n已幸同庚，何分雌甲，本无多少。\n但有头可白，无愁可解，只如此、都赢了。\n庆礼十年还又，更十年、依前难老。\n尽教百岁，做人高祖，见孙白首。\n却要从今，探梅脚健，看山眼好。\n赖天公，顿得东园长在，陪歌陪酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 寿许贰车","author":"危稹","text":"籍甚声名，门阑相种，文章世科。\n算当年瑞世，正当夏五，仙家毓德，全是春和。\n底事屏星，著之海峤，奈此腾骧骥足何。\n君知否，看飞来丹诏，径上鸾坡。\n殷勤携酒相过。\n要滟滟浮君金叵罗。\n叹同心相契，古来难觅，二年同处，意总无它。\n如此平分，更教添个，也自清风明月多。\n拼沈醉，任光浮绿鬓，笑满红涡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 和晏虞卿咏侍儿弹箜篌","author":"危稹","text":"老去诸馀情味浅。\n诗词不上闲钗钏。\n宝幌有人红两靥。\n帘间见。\n紫云元在梨花院。\n十四条弦音调远。\n柳丝不隔芙蓉面。\n秋入西窗风露晚。\n归去懒。\n酒酣一任乌巾岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"危稹","text":"梅以白为正，菊以黄为正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"危稹","text":"马嵬路险失妃子，金谷楼高堕绿珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽和靖先生","author":"高闶","text":"身占河南第一功，力行笃信守家风。\n渊源漫说斯文丧，深切今知此道东。\n七日梦楹终有待，三年筑室恨无从。\n嵩伊千古温淳气，收入稽山鉴影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山斋","author":"向子諲","text":"横侧数峰碧，逶迤一径开。\n无人相就宿，时有白云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王文孺臞庵","author":"向子諲","text":"仙翁五十鬓犹青，高卧柴门昼亦扃。\n茅舍已忘钟鼎梦，蒲轮休过薜萝亭。\n阴森门巷先生柳，寂寞江天处士星。\n晚岁田间农事了，闲钞宁戚相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题米元晖横轴 其二","author":"向子諲","text":"向日家居道士，今朝落笔仙乡。\n胸次山高水远，笔端云起风狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题米元晖横轴 其一","author":"向子諲","text":"早为山谷印可，晚陪帝所清闲。\n笔力休论扛鼎，神功更解移山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一落索","author":"向子諲","text":"春风吹断前山雨。\n行云归去。\n暂来须信本无心，回首了无寻处。\n欲问个中玄路。\n阿谁能语。\n澄江霁月却深知，把此意、都分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七娘子","author":"向子諲","text":"山围水绕高唐路。\n恨密云、不下阳台雨。\n雾阁云窗，风亭月户。\n分明携手同行处。\n而今不见生尘步。\n但长江、无语东流去。\n满地落花，漫天飞絮。\n谁知总是离愁做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其二 丙寅中秋对月","author":"向子諲","text":"扫长空、万里静无云，飞镜上天东。\n欲骑鲸与问，一株丹桂，几度秋风。\n取水珠宫贝阙，聊为洗尘容。\n莫放素娥去，清影方中。\n玄魄犹馀半璧，便笙篁万籁，尊俎千峰。\n况十分端正，更鼓舞衰翁。\n恨人生、时乎不再，未转头、欢事已沈空。\n多酌我，风华好处，浩意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其一 中秋前数夕，久雨方晴","author":"向子諲","text":"恨中秋、多雨及晴景，追赏且探先。\n纵玉钩初上，冰轮未正，无奈婵娟。\n饮客不来自酌，对影亦清妍。\n任笑芗林老，雪鬓霜髯。\n好在章江西畔，有凌云玉笥，空翠相连。\n懒崎岖林麓，则窈窕溪边。\n自断此生休问，愿瓮中、长有酒如泉。\n人间是，更谁得似，月下尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子","author":"向子諲","text":"竹里一枝梅，雨洗娟娟静。\n疑是佳人日暮来，绰约风前影。\n新恨有谁知，往事何堪省。\n梦绕阳台寂寞回，沾袖馀香冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]