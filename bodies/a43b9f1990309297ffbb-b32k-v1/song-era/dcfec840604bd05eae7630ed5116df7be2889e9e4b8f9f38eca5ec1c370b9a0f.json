[{"title":"和梅公仪待制 宿西溪寺","author":"文彦博","text":"地占莲华麓，溪环鹫岭巅。\n密林含细籁，巍刹照清涟。\n独赏宁妨醉，幽吟定废眠。\n支郎谙雅尚，扫榻就潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公仆天章书示暂往蓝田兼阅山水以答来贶","author":"文彦博","text":"暂枉观风旆，从容赏物华。\n蓝山青有玉，辋水碧无沙。\n林静闻啼狖，川长见落霞。\n宜寻幽径处，竹里到南坨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪天章雪中游蓝田山悟真寺","author":"文彦博","text":"古寺依山构，高车冒雪游。\n穿林皆玉树，倚槛尽琼楼。\n景胜烦诗笔，财丰缓计筹。\n岩阿聊寄傲，物外恣寻幽。\n缰锁惭羁击，匏瓜叹滞留。\n无因陪雅躅，清唱复难酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄青州田龙图况","author":"文彦博","text":"东秦假手裁经岁，偃息山斋兴味长。\n怪石罅中栽薜荔，碧梧阴里种麻黄。\n吟牵翠蔓秋烟润，醉撷纤英晓露凉。\n内省非才寡遗爱，争教所憩似甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后游华严川马上作","author":"文彦博","text":"雨后城南路，无泥未有尘。\n因观曲江树，更忆杏园春。\n草色遥侵水，山光翠逼人。\n劭农兼访古，揽辔缓朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题中山郎中华严川墅","author":"文彦博","text":"城南风物胜，最胜是华严。\n谢墅偏幽寂，颜郎此退潜。\n流泉清绕砌，列岫翠当檐。\n更爱村桥畔，杨花扑酒帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢公仪待制惠黄石枕","author":"文彦博","text":"得时应在谷城山，蒸栗温姿照席间。\n助我漱流高卧意，曲肱从此不晞颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪隐厅书事","author":"文彦博","text":"迹贵虽轩冕，心闲似隐沦。\n林间新葺宇，公退此颐神。\n藓色青缘砌，池光碧照人。\n爱君高雅趣，琴酒屡相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夕挈新酿并文石酒樽就公仪南湖雅饮","author":"文彦博","text":"桃花石器榴花酿，携就南湖访饮朋。\n雅论清吟凉月满，山翁不惜醉腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和公仪月夕游南湖","author":"文彦博","text":"凉夜南湖饮，林端月上初。\n樽罍既古雅，亭榭复清虚。\n静赏兴无尽，剧谈欢有馀。\n群驺不熹事，应厌久停车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪咏蒲葵扇","author":"文彦博","text":"不取归资厚，仁风藉尔扬。\n论财虽俭薄，应用极清凉。\n六角价非重，九华名未光。\n倾心既已久，安石勿相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和登飞桥观游艇","author":"文彦博","text":"为爱高桥月色多，飞觞捉麈对吟哦。\n轻舠一叶时来往，惊散双鸳动碧荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪重到隐厅偶书绝句","author":"文彦博","text":"重访隐斋留雅咏，将归禁署促东辕。\n晓猿夜鹤君家物，不恋南湖只恋轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪湖上烹蒙顶新茶作","author":"文彦博","text":"蒙顶露牙春味美，湖头月馆夜吟清。\n烦酲涤尽冲襟爽，暂适萧然物外情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与公仪会饮南湖作","author":"文彦博","text":"湖上高楼对远山，一樽清醑且开颜。\n今朝尚作林塘主，明日将归侍从班。\n心向白云虽自乐，身趋丹禁未容闲。\n为君不惜厌厌醉，赏尽银蟾秉烛还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪游太华","author":"文彦博","text":"山水清音步步随，谢家歌舞岂须携。\n深游雾市身应润，直上莲峰路不迷。\n细草舒茵承蜡屐，长松倾盖护云梯。\n岩隈灵药皆堪采，采得盈箱亦自提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见山楼小饮偶作","author":"文彦博","text":"云淡天迷楚，楼高地占秦。\n哀筝一行雁，小字数钩银。\n巷陌三条月，池塘十步春。\n府门初夜闭，多少夜游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邛竹杖","author":"文彦博","text":"孤筠劲质异纤柔，欲假携持助胜游。\n不为凌霜高节在，对公灵寿合包羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀笺","author":"文彦博","text":"素笺明润如温玉，新样翻传号冷金。\n远寄南都岂无意，缘公挥翰似山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阳巾","author":"文彦博","text":"华阳山相遗巾法，蜀国乌纱学制成。\n公厌貂裘今已久，定知野服称高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙顶茶","author":"文彦博","text":"旧谱最称蒙顶味，露牙云液胜醍醐。\n公家药笼虽多品，略采甘滋助道腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近以蜀物寄献复以雅章为报辄课芜音仰酬来贶","author":"文彦博","text":"微物达诚方愧极，雅章流惠见情深。\n野夫自是甘芹味，国老何尝靳玉音。\n伸纸恣窥蓝肆宝，登函频作洛生吟。\n辞清墨妙真双绝，韫椟传家励子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天平相公远寄佳章谨依韵和呈 其一","author":"文彦博","text":"晓辟天阍出帝纶，麾幢误委不才臣。\n六条颁诏专临雍，一道全师别制秦。\n虽受深恩辞北阙，拟将何术抚西人。\n他年遂解簪缨去，乞去伊川号散民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天平相公远寄佳章谨依韵和呈 其二","author":"文彦博","text":"昔年公掌秦中漕，虎节寻提四镇师。\n从此功成为汉相，至今阙内仰萧规。\n新诗远寄音盈耳，累牍频窥喜见眉。\n更问春游何处好，夹城西面景龙池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答平凉龙图王谏议","author":"文彦博","text":"凛然威望詟西戎，十万貔貅节制中。\n从古藩垣谋帅重，于今诗礼得才雄。\n勤归定是推优赏，静胜由来保上功。\n不独韦平称世美，缁衣兼咏武桓公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答王龙图咏山见寄","author":"文彦博","text":"分得鱼符守雍州，垂帷闭阁再经秋。\n眼看岩岫将登览，身似匏瓜苦滞留。\n杜曲朱坡虽已到，圭峰紫阁未曾游。\n却输假道归朝客，上遍终南寺寺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题纪太尉庙","author":"文彦博","text":"死节古来虽有矣，大都死节少如公。\n惟图救主重围内，不惮焚身烈焰中。\n龙准有因方脱祸，猴冠无计复争雄。\n如何置酒咸阳会，只说萧何第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过荥阳玉像院","author":"文彦博","text":"瑞相双刊玉，仁祠侧布金。\n轮蹄一道过，风雨二山嵚。\n密藓苍缘壁，乔松秀出林。\n村僧不可语，难问祖师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过汜水关","author":"文彦博","text":"济世安民主，擒充执窦归。\n山川遗气象，史册动光辉。\n原庙今昭德，群雄昔畏威。\n虎牢名自久，牛口谚应非。\n关塞侔天险，封疆介日围。\n特吟摩诘句，度水柳依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"某伏蒙昭文相公以某方忝瀍洛之寄因有嵩少之行惠赐游山器一副质轻而制雅外华而中坚匪惟便于赍持实为林下之珍玩也辄成拙诗一章报谢","author":"文彦博","text":"上公遗我游嵩具，匜盥杯盂色色全。\n拂拭便须延隐逸，洁清那敢污腥膻。\n行赍每度云岩侧，器使当居蜡屐前。\n林叟溪翁皆窃玩，山厨因此识嘉笾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答青州相公二首 其一","author":"文彦博","text":"非才久玷钧衡重，乞得麟符守洛师。\n圣造如天从素欲，愚衷何地报鸿慈。\n先茔松槚躬时省，私庙萍蘩洁仲祠。\n相国情深最知我，邮筒千里贶新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答青州相公二首 其二","author":"文彦博","text":"雅章追念柏台游，屈指今逾二十秋。\n初奉南床持大宪，后陪东阁告嘉猷。\n心如金石同谋国，路出风波免覆舟。\n闻欲坚随赤松去，拟携灵寿从留侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅公仪见寄华亭鹤一只","author":"文彦博","text":"子真仙裔富高情，远寄仙禽至洛城。\n昔向华亭常警露，今来缑岭伴吹笙。\n稻粱犹忆嘉禾美，竹树应怜履道清。\n已遣吾家伊水墅，旋营莎荐似咸京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游平泉作","author":"文彦博","text":"一崦抱溪斜，前朝辅相家。\n遗基皆瓦砾，古木尚烟霞。\n夙昔东山墅，留连上殿车。\n虽云营退隐，未免逐豪夸。\n事往如飞鸟，林空噪暮鸦。\n池平无旧凤，堤坏有残沙。\n野叟犹能说，樵夫亦共嗟。\n至今岩石下，多长紫薇花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又读平泉花木记 其一","author":"文彦博","text":"历览平泉记，文饶性苦奢。\n如何伊上墅，多是日南花。\n美荫皆奇树，清芬悉异葩。\n安知桃李盛，不及晋公家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又读平泉花木记 其二","author":"文彦博","text":"竹树环青嶂，楼台生碧烟。\n珍奇穷四海，景象冠三川。\n上党夷凶日，太和归国年。\n此时能勇退，应遂老平泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又读平泉花木记 其三","author":"文彦博","text":"吾观李太尉，所失在誇权。\n名遂不知退，膏明惟自煎。\n终身恋华组，何日到平泉。\n徒有思归意，歌诗盈百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游卢溪","author":"文彦博","text":"一径极幽深，清泉响竹阴。\n昔人曾隐雾，衰世偶为霖。\n谋国无长策，论兵肆褊心。\n王师遂不振，物议愈难任。\n仰药身虽殒，攻关盗转侵。\n传家绝诸藐，遗业变双林。\n僧朴俱难问，碑昏尚可寻。\n徘徊念陈迹，不为叹人琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食日早发赴积庆庄拜扫过龙门马上作","author":"文彦博","text":"赫奕晨霞照万灯，路穿阙口势如吞。\n桥边杨柳垂青线，林下鞦韆挂綵绳。\n平地伊流不一抹，半天嵩岳翠千层。\n行行渐入吾疆理，竹坞松阡间绮塍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登阙塞","author":"文彦博","text":"鞅掌公庭暇，登临阙塞秋。\n清谈不废务，远望略消忧。\n二室榄前见，长伊天际流。\n僧归下樵径，客去上渔舟。\n返照明金刹，飞泉响石楼。\n放怀真趣得，纵目滞情休。\n像列三龛密，波翻入节稠。\n怅然高世意，不减冶城游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游潜溪","author":"文彦博","text":"脩竹荫清溪，潺湲阙塞西。\n石床平有藓，沙路润无泥。\n粉白松围古，蓝生草带齐。\n难留批敕字，救旱作云霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登广化阁","author":"文彦博","text":"宝刹层峰上，危栏净界中。\n登临近霄汉，子细见伊嵩。\n谷迥传清梵，川长没远鸿。\n黄昏不忍去，月在石楼东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿少林寺","author":"文彦博","text":"六六仙峰绕静居，俗尘至此暂消除。\n西来未悟禅师意，北去还驰使者车。\n五品封槐今尚在，九年面壁昔何如。\n心知一宿犹难觉，花藏重寻贝叶书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金星观","author":"文彦博","text":"鹤发庞眉二老仙，林间老屋十馀间。\n斋粮不蓄惟栽菊，道眼长明祇看山。\n朋侣过从应绮用，比邻掩映是嵩辕。\n暂游自愧尘劳迹，解帢临溪濯腻颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游岳寺","author":"文彦博","text":"寺占嵩颜景最多，奇峰列刹共嵬峨。\n依岩宝砌砻清础，出谷飞泉逗素波。\n下瞰长川穷渺邈，傍观列岫极陂陁。\n缁林法乐堪随喜，钟磬声清呗梵和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过颍阳山墅作","author":"文彦博","text":"平生箕颍志，未免困名缰。\n赖此营山墅，频年至颍阳。\n相邻紫云洞，不羡白莲庄。\n却愧耕夫问，归轩作底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大名府舍创作茅斋因题八句太师相公太保相公","author":"文彦博","text":"勿谓茅茨陋，栖心即有馀。\n非同诸葛卧，颇类静名居。\n面壁思禅理，向阳观道书。\n回头视华屋，缰琐宿蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留守端明尚书远示赠阇梨渐师诗依韵和成","author":"文彦博","text":"常随净侣叫禅关，熟听潮音丈室间。\n身逐孤云辞陇首，心如皎月照香山。\n儒空两悟言无滞，觉望双除性本闲。\n居守意勤当应现，不须祇到虎溪还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆射侍中荣过潩上小园兼题嘉句谨成十六言仰谢贲饰","author":"文彦博","text":"上相寻芳驻画轮，华貂玉节耀松筠。\n二南雅丽音盈耳，八体遒妍妙入神。\n鲁壁再传科斗字，稽山长咏永和春。\n小园从此增光价，一室荧煌照乘珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小园池上偶作","author":"文彦博","text":"微吟岸帻思悠然，近对方塘远见山。\n恩施洛阳均逸地，莫言此地是偷闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗寄龙门宝应寺證大师","author":"文彦博","text":"山人去作山西将，岫幌岩扉掩翠岚。\n欲问證师求正住，凭师改作潞公庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和答文裕群牧侍郎","author":"文彦博","text":"华轩过陋巷，良宴集西园。\n雅饮金罍耻，高吟墨客喧。\n初晴山色静，早夏木阴繁。\n酷爱君挥麈，清言有会元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼寝梦归洛宅","author":"文彦博","text":"位高才薄困疲癃，竹影泉声梦寐中。\n定去洛城为逸客，近来书翰学扬风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汝州王端明寄示竹亭诗二十章披玩叹赏不能自已辄成四十言仰答来惠","author":"文彦博","text":"窈窕竹间路，清虚池上亭。\n高情爱寂寂，终日玩青青。\n汝水环近郭，箕山开画屏。\n知君于此兴，极目送鸿冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书宿斋偶作 其一","author":"文彦博","text":"斋洁奉祠事，深严宿禁扃。\n露盘云表见，钧奏梦中听。\n慎独虔君命，清心重礼经。\n顾惭温室树，忽此集鹪螟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书宿斋偶作 其二","author":"文彦博","text":"凤阁容栖集，心无外虑侵。\n夜凉秋气早，人静禁门深。\n大政惭无补，微才恐不任。\n歌眠听宫漏，兰焰照青衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太庙宿斋作","author":"文彦博","text":"孟秋严庙飨，公衮摄祠官。\n达向来风迥，方诸溯月寒。\n剪茅重屋峻，丛甓缭墙宽。\n仰念灵台厚，恭思王业难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题龙门临伊堂兼呈奉先寺兴公","author":"文彦博","text":"山僧知我思归意，为我临伊创草堂。\n闻说绕阶丛巨石，更须当槛植脩篁。\n窗间东望乾元刹，门外南趋积庆庄。\n便拟半移生计去，不知何似畅师房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东枢后轩列植花草随时竞秀种类寔繁滋蔓因依未易图也然昔之造化者为不少矣故录其名数榜于北垣意欲后之人勿剪勿伐且无忘于封植也因观其榜偶作小诗三章曰嘲曰解曰断云 其一 嘲","author":"文彦博","text":"百种闲花草，皆非药笼材。\n如何桃与李，曾不预栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东枢后轩列植花草随时竞秀种类寔繁滋蔓因依未易图也然昔之造化者为不少矣故录其名数榜于北垣意欲后之人勿剪勿伐且无忘于封植也因观其榜偶作小诗三章曰嘲曰解曰断云 其二 解","author":"文彦博","text":"勿谓闲花草，色成各有宜。\n君看桃与李，未是岁寒姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东枢后轩列植花草随时竞秀种类寔繁滋蔓因依未易图也然昔之造化者为不少矣故录其名数榜于北垣意欲后之人勿剪勿伐且无忘于封植也因观其榜偶作小诗三章曰嘲曰解曰断云 其三 断","author":"文彦博","text":"天地育万物，物物遂其生。\n何须强分别，不若两忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十日西园会范内翰李紫微已下诸公惠雅章谨成拙诗仰答厚意","author":"文彦博","text":"今日西园集，联裾蜀国英。\n为君聊置醴，念我昔专城。\n丽句皆新意，高谈多故情。\n报君虽拙陋，所应在同声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端明尚书垂访弊居会于西园兼蒙赋诗贲饰辄成四十字奉呈","author":"文彦博","text":"重阳节始过，佳菊色犹亲。\n东篱把酒客，西园飞盖宾。\n共此林下宴，可类商颜人。\n清樽幸未燥，无所献酬频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和副枢吴谏议上元夜从驾至集禧观","author":"文彦博","text":"顺时同乐慰邦民，协气和风应早春。\n斗运帝车遵大路，云从天步绝纤尘。\n民瞻玉色欣游豫，岳峙琳宫望省巡。\n回御端闱张镐饮，兰灯桂魄耀星津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致政侍郎二府诗","author":"文彦博","text":"潭潭相府方高启，岌岌枢闱亦对开。\n棋布司存邻象阙，星分位表拱天台。\n乐天善颂传嘉句，虔命叨居愧薄才。\n仰认圣皇优待意，先时曾枉翠华来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]