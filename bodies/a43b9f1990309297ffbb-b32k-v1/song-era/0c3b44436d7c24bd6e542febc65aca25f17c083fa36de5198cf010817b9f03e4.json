[{"title":"山堂偶书","author":"唐询","text":"在处烟云早晚生，自疑呼吸气皆灵。\n十年梦寐江山里，今见江山入户庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"为杭州日送客舟中","author":"唐询","text":"山雨霏微不满空，画船来往疾轻鸿。\n谁知独卧珠帘里，一榻无尘四面风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游五泄山 其二","author":"唐询","text":"游遍西潭返步迟，乱云随履雨沾衣。\n山形相向还相背，独有溪流共我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其十 三女岗","author":"唐询","text":"淑女云亡久，哀丘尚著名。\n九原谁可作，千载或如生。\n青骨何时化，荒榛此地平。\n空馀图谍在，不复启佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其七 华亭谷","author":"唐询","text":"深谷弥千里，松陵北合流。\n岸平迷昼夜，人至竞方舟。\n照月方诸泣，迎风弱荇浮。\n平波无限远，极目涨清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其九 昆山","author":"唐询","text":"昔有人如玉，兹山得美名。\n岩扃锁积翠，谷水断馀声。\n乔木今无在，高台久已倾。\n如何嵩岳什，独咏甫侯生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其五 秦始皇驰道","author":"唐询","text":"秦德衰千祀，江滨道不脩。\n相传大堤在，曾是翠华游。\n玉趾如将见，金椎岂复留。\n怅然寻旧迹，蔓草蔽荒丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其八 陆机宅","author":"唐询","text":"旧谍传遗趾，悠然历祀深。\n人无令威至，门异下邽箴。\n谷水当年溜，昆山昔日阴。\n鲁堂那复见，丝竹若为寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其六 陆瑁养鱼池","author":"唐询","text":"代异人亡久，滮池即旧居。\n未移当日地，无复故时鱼。\n蒲藻依稀在，风波浩荡馀。\n水滨如可问，一为访庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其一 顾亭林","author":"唐询","text":"平林标大道，曾是野王居。\n旧里风烟变，荒原草树疏。\n湖波空上下，里闬已丘墟。\n往事将谁语，凄凉六代馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其二 寒穴","author":"唐询","text":"绝顶干云峻，寒泉与穴平。\n还同帝台味，不学陇头声。\n夜雨遥源涨，秋风颢气清。\n谁云蔗浆美，才可析朝酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄五峰谏长老","author":"唐询","text":"禅客居山患不深，五峰幽绝杳难寻。\n门前流水朝还暮，堂下閒云古复今。\n月色有时依宴坐，秋声随处伴讴吟。\n期师便作终焉计，忍负平生物外心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游五泄山 其一","author":"唐询","text":"寻彻灵潭第五源，旋攀萝茑至山巅。\n寒声昔谓来天外，巨壑今知在目前。\n峭壁无时长蔽日，重岩不雨亦生烟。\n临观已觉尘心尽，更欲凌云访列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题会稽溪口躬师上人房","author":"唐询","text":"溪口相传地最灵，其间风物与人清。\n钟声夜到江头尽，云气朝从槛外生。\n几副轻绡供画笔，一林脩竹寄閒情。\n闭门终日无尘事，卧看南□自晦明。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曲水阁","author":"唐询","text":"依山营废壤，结宇跨通沟。\n派引平湖远，声分几曲流。\n交阴覆脩竹，照影下轻鸥。\n此日群贤集，宁疏晋世游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其三 吴王猎场","author":"唐询","text":"昔在全吴日，从禽耀甲戈。\n百车尝载羽，一目旧张罗。\n地变柔桑在，原荒蔓草多。\n思人无复见，落日下山坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华亭十咏 其四 柘湖","author":"唐询","text":"世历亡秦远，湖连大海濒。\n柘山标观望，玉女见威神。\n渺渺旁无地，滔滔孰问津。\n何年化鱼鳖，髣髴历阳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬青行二首 其二","author":"唐珏","text":"冬青花，不可折，南风吹凉积香雪。\n遥遥翠盖万年枝，上有凤巢下龙穴。\n君不见犬之年羊之月，霹雳一声天地裂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬青行二首 其一","author":"唐珏","text":"马箠问髐形，南面欲起语。\n野麇尚屯束，何物敢盗取。\n馀花拾飘荡，白日哀后土。\n六合忽怪事，蜕龙挂茅宇。\n老天鉴区区，千载护风雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 浮翠山房拟赋白莲","author":"唐珏","text":"淡妆人更婵娟，晚奁净洗铅华腻。\n泠泠月色，萧萧风度，娇红敛避。\n太液池空，霓裳舞倦，不堪重记。\n叹冰魂犹在，翠舆难驻，玉簪为谁轻坠。\n别有凌空一叶，泛清寒、素波千里。\n珠房泪湿，明珰恨远，旧游梦里。\n羽扇生秋，琼楼不夜，尚遗仙意。\n奈香云易散，绡衣半脱，露凉如水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐天乐 馀闲书院拟赋蝉","author":"唐珏","text":"蜡痕初染仙茎露，新声又移凉影。\n佩玉流空，绡衣剪雾，几度槐昏柳暝。\n幽窗睡醒。\n奈欲断还连，不堪重听。\n怨结齐姬，故宫烟树翠阴冷。\n当时旧情在否，晚妆清镜里，犹记娇鬓。\n乱咽频惊，馀悲渐杳，摇曳风枝未定。\n秋期话尽。\n又抱叶凄凄，暮寒山静。\n付与孤蛩，苦吟清夜永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂枝香 天柱山房拟赋蟹","author":"唐珏","text":"松江舍北。\n正水落晚汀，霜老枯荻。\n还见青匡似绣，绀螯如戟。\n西风有恨无肠断，恨东流、几番潮汐。\n夜灯争聚微光，挂影误投帘隙。\n更喜荐、新篘玉液。\n正半壳含黄，一醉秋色。\n纤手香橙风味，有人相忆。\n江湖岁晚听飞雪，但沙痕、空记行迹。\n至今茶鼎，时时犹认，眼波愁碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摸鱼儿 紫云山房拟赋莼","author":"唐珏","text":"渐沧浪、冻痕消尽。\n琼丝初漾明镜。\n鲛人夜剪龙髯滑，织就水晶帘冷。\n凫叶净。\n最好似、嫩荷半卷浮倩影。\n玉流翠凝。\n早枯豉融香，红盐和雪，醉齿嚼清莹。\n功名梦，曾被秋风唤醒。\n故人应动高兴。\n悠然世味浑如水，千里旧怀谁省。\n空对景。\n奈回首、姑苏台畔愁波暝。\n烟寒夜静。\n但只有芳洲，苹花共老，何日泛归艇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感皇恩","author":"唐致政","text":"君欲问予年，八十有七。\n百岁十分尚留一。\n世间滋味，尝尽酸咸苦涩。\n时今倒食蔗、无甜汁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潮阳尉郑太玉梦至泉侧饮之甚甘明日得之东山上作梦泉记令余作诗为赋此篇","author":"唐庚","text":"入道肯著相，出神得佳泉。\n起寻定中境，谩意山之巅。\n四人蹋??，数里闻潺湲。\n循声到巉绝，满意流甘鲜。\n虽深石可数，太察鱼难筌。\n分为缟练去，溅作珠玑圆。\n一窥宿酲解，三咽沉疴痊。\n恍惚尚疑梦，欢呼欲成颠。\n山间短于井，海饮咸生涎。\n那知道在迩，几作野遗贤。\n事固由人兴，物为知已妍。\n谁陪濠上游，谅携室中天。\n虽无十丈花，中有一滴禅。\n名酒觉殊胜，宜茶定常煎。\n兰亭羽觞冷，鱼腹青筒连。\n新文来远矣，开卷犹潨然。\n径欲抱琴去，临流听未全。\n不但受以耳，庶几神者先。\n写为梦泉操，第入乐府篇。\n将前辄复却，万事付有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"唐梅臞","text":"水落一阶翻碎玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和经略直阁寺丞赠刘升之蛰龙岩二首 其二","author":"唐弼","text":"倚天寒碧锁嵌空，咫尺丹霄有路通。\n莫向明时缩头角，风云只在笑谈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和经略直阁寺丞赠刘升之蛰龙岩二首 其一","author":"唐弼","text":"古人事业不关书，圣处工夫咏舞雩。\n窈窕崖居辱题品，南阳端有卧龙无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三洲岩","author":"唐弼","text":"峒里光阴经几春，峒前苍木垂千寻。\n不知空谷当年事，谁识庞眉处士心。\n残月照人吞远徼，晚风吹梦入幽岑。\n我来须访神仙宅，好听云端环佩音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钗头凤","author":"唐婉","text":"世情薄，人情恶，雨送黄昏花易落。\n晓风乾，泪痕残。\n欲笺心事，独语斜阑。\n难！\n难！\n难！\n人成各，今非昨，病魂常似秋千索。\n角声寒，夜阑珊。\n怕人寻问，咽泪装欢。\n瞒！\n瞒！\n瞒！","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题安阳山翠微寺","author":"唐皞","text":"平地巍然起一峰，历山西畔隔湖东。\n势侵云汉千寻直，影落烟村四面同。\n龙窟正当螺髻顶，僧居端在画图中。\n邦人不独资观赏，旱岁为霖更有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上方","author":"唐皞","text":"佛龛经阁等岩㠂，地在高中此最高。\n日出四楹浮宝气，云开百里见秋毫。\n登临暂得心机静，徙倚翻嫌目力劳。\n况是雄飞先上者，强挥吟笔继诗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游四明留题丹山","author":"唐震","text":"四明光照九霄寒，阆苑神仙日往还。\n瀑布远从银汉落，洞门长锁白云閒。\n深崖瑞木金文润，绝顶灵槎铁色斑。\n无限遗踪人莫识，落花香泛水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"唐籊","text":"偶逐青山无好句，白云相伴过龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古离别","author":"夏之中","text":"郎上孤舟妾上楼，阑干未倚泪先流。\n片帆渐远郎回首，一种相思两处愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句","author":"夏元鼎","text":"崆峒访道至湘湖，万卷诗书看转愚。\n踏破铁鞋无觅处，得来全不费工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁二首 其二","author":"夏元鼎","text":"崆峒访道屈尊乎，万卷丹书看转愚。\n着破铁鞋无觅处，得师全不费功夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁二首 其一","author":"夏元鼎","text":"世学金丹乱似麻，谩将心肾向人誇。\n眼前有药无人识，火里栽莲长道芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷正一真君","author":"夏元鼎","text":"未登龙虎榜，且登龙虎山。\n一见三清易，三年一第难。\n剑埋光射斗，鸡鸣晓度关。\n乾坤谁整顿，拟伴赤松閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其九","author":"夏元鼎","text":"闻道不嫌晚，悟了莫悠悠。\n遇时不炼，今生乌兔恐难留。\n些子乾坤简易，不问在朝居市，达者尽堪修。\n火候无斤两，大药本非遥。\n守旁门，囚冷屋，望升超。\n迷迷相授，生死不相饶。\n未识先天一气，孰辨五行生克，不向眼前求。\n试道工夫易，福薄又难消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"夏元鼎","text":"采取铅须密，诚意辨妍媸。\n休教错认，夺来鼎内及其时。\n二物分明真伪，一得还君永得，此事契天机。\n记取元阳动，妙用在虚危。\n法寅申，行子午，总皆非。\n自然时节，梦里也教知。\n不属精津气血，不是肺肝心肾，真土亦非脾。\n言下泄多矣，凡辈奈无知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其三","author":"夏元鼎","text":"耳目身之宝，固塞勿飞扬。\n存无守有，中间无念以为常。\n把定玄关一窍，视听尽收归里，坎兑互堤防。\n寤寐神依抱，形气两相忘。\n圆陀陀，光烁烁，貌堂堂。\n分明真我，罔象里全彰。\n此即非空非色，自是本来面目，阴鼎炼元阳。\n出世真如佛，馀二莫思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其七","author":"夏元鼎","text":"要蹑天仙步，金丹是法身。\n不知谓气，须还识后自然真。\n大道从花孕子，点出个中阴魄，乌兔合阳魂。\n北斗随罡转，天地正氤氲。\n采依时，炼依法，莫辞勤。\n立跻圣域，从此脱沈沦。\n夜气正当过半，龙虎自然蛰动，势欲撼乾坤。\n片饷工夫耳，庄算八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其六","author":"夏元鼎","text":"擒得铅归舍，进火莫教迟。\n抽添沐浴，临炉一意且防危。\n只为婴儿未壮，全藉黄婆养育，丁老共扶持。\n火力频加减，外药亦如之。\n汞生芽，铅作祖，土刀圭。\n火生于木，炎盛汞还飞。\n要得水银真死，须待阴浮阳伏，杂类降灰池。\n用铅终不用，古语岂吾欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"夏元鼎","text":"要识刀圭诀，一味水银铅。\n驴名马字，九三四八万千般。\n愚底转生分别，刬地唤爷作父，荆棘满心田。\n去道日以远，至老昧蹄筌。\n譬如人，归故国，上轻帆。\n顺风得路，夜里也行船。\n岂问经州过县，管取投明须到，舟子自能牵。\n悟道亦如此，半句不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"夏元鼎","text":"人身藏宇宙，乌兔走西东。\n昼舒夜卷，不拘春夏与秋冬。\n存想非心非肾，吐纳非精非气，子午谩行功。\n一点真灵宝，混合自回风。\n感婴儿，交姹女，爱丁公。\n黄婆匹配，一时辰内上仙宫。\n恍惚无中有象，阳火阴符密契，大道属鸿濛。\n火候能调理，天地与无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其四","author":"夏元鼎","text":"真一北方气，玄武产先天。\n自然感合，蛇儿却把黑龟缠。\n便是蟾乌遇朔，亲见虎龙吞啖，顷刻过昆崙。\n赤黑达表里，炼就水银铅。\n有中无，无中有，两玄玄。\n生身来处，逆顺圣凡分。\n下士闻之大笑，不笑不足为道，难为俗人论。\n土塞命门了，去住管由君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一","author":"夏元鼎","text":"我有一竿竹，偏会取根源。\n从来汲水桔槔，直挈上西天。\n不许常人著手，管定竿头先折，提桶落寒泉。\n拨得机关转，北斗向南看。\n仗回风，乘偃月，勿波澜。\n麻姑此日，西北见张骞。\n选佛妙高峰顶，饮罢醍醐似醉，独坐玩婵娟。\n水湛月明处，太极更无前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"夏元鼎","text":"三三乾妙画，佑圣诞弥辰。\n北方壬癸，水生于坎产元精。\n一数先天有象，元始化生相应，灵气属阳神。\n寿永齐天地，万物尽回春。\n说龟蛇，名黑杀，蕴深仁。\n阴中阳长，要知害里却生恩。\n此意宜参造化，正是金丹大道，不在咽精津。\n富贵公方逼，肯问出人伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其五","author":"夏元鼎","text":"律应黄钟候，天地尚胚浑。\n腾腾一气，家园平地一枝春。\n下手依时急采，莫放中宫芽溢，害里却生恩。\n火候精勤处，加减武和文。\n定浮沈，明主客，别疏亲。\n真铅留汞，造化合乾坤。\n此是身中灵宝，谁信龙从火出，二八共成斤。\n些子希夷法，只在弄精魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其八","author":"夏元鼎","text":"神气精三药，举世没人知。\n气随精化，镇常神逐气无归。\n心地不明天巧，业识更缠地网，背却上天梯。\n今古多豪杰，生死醉如泥。\n树头珠，潭底日，显金机。\n两般识破，性命更何疑。\n活捉金精入木，炼就当初真一，方表丈夫儿。\n信取玄中趣，端的世间稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一 答王和父送□错认水酒","author":"夏元鼎","text":"甘露醴泉天降，琼浆玉液仙方。\n一壶馥郁喷天香。\n曲糵人间怎酿。\n要使周天火候，不应错认风光。\n浮沈清浊自斟量。\n日醉蓬莱方丈。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其四","author":"夏元鼎","text":"举世沈迷大道，傍门小法求丹。\n咽津纳气等成仙。\n真个无知痴汉。\n何异雄鸡抱卵，梦同哑子交言。\n阴阳非类隔天渊。\n总是盲修瞎炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二 送腊茶答王和父","author":"夏元鼎","text":"万汇阳春吐秀，争如雀舌含英。\n先天一气社前升。\n啖出昆崙峰顶。\n要得丁公煅炼，飞成宝屑窗尘。\n蜜脾神用脱金形。\n送与仙翁体认。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其九","author":"夏元鼎","text":"几载鸡窗求道，费他兔楮铅丹。\n经书子史尽蹄筌。\n鹿走徒嗟秦汉。\n百代兴亡瞬息，徒留纸上陈言。\n谁知太始道常存。\n乌兔仙家修炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其三","author":"夏元鼎","text":"太一画前是道，全凭龙虎成丹。\n九还七返保长年。\n好个逍遥闲汉。\n日诣金门玉殿，青衣引赞无言。\n回风混合万神安。\n功向虚无中炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其六","author":"夏元鼎","text":"大隐居尘奉道，衰颜能返朱丹。\n要须有主种三田。\n方免驱驰淮汉。\n天下江山第一，昆崙景胜何言。\n希夷妙处集真仙。\n默默重帘修炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其七","author":"夏元鼎","text":"万里担簦访道，要知一点灵丹。\n日乌月兔在朝元。\n岂在迢迢云汉。\n罔象求珠易得，离明契后难言。\n五金八石是虚传。\n争似阳修阴炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"夏元鼎","text":"四十修真学道，金鱼要换金丹。\n龟龄鹤算不知年。\n行满身冲霄汉。\n此事希夷玄奥，功参造化难言。\n眼前有药耀山川。\n好把元阳修炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其五","author":"夏元鼎","text":"不死谷神妙道，杳冥中有还丹。\n坤牛乾马运无边。\n却是修行真汉。\n脱去名缰利锁，金童玉女传言。\n工夫片饷彻玄关。\n水火从教法炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其八","author":"夏元鼎","text":"达磨西来说道，十年面壁安丹。\n争知水火不交煎。\n因果谩成罗汉。\n仰箭射空力尽，依然坠地何言。\n虚空拶破强参禅。\n肯把金丹烧炼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]