[{"title":"存没口号 其二","author":"苏泂","text":"百川衮衮东赴海，学者皆知孔氏宗。\n六籍湮微吾道丧，武陵山下泣寒蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"存没口号 其二","author":"苏泂","text":"紫荆一树花连枝，近以手抓动辄随。\n毋忘在莒孔怀日，可咏陟冈何怙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有钱咏","author":"苏泂","text":"树头榆叶水圆荷，黄菊青苔鼓铸多。\n莫把诗家作穷相，四时浑不奈钱何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"苏泂","text":"滞不求通任布衣，山阴道上玩春晖。\n每逢到处花开谢，转觉人生万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴四首 其四","author":"苏泂","text":"琵琶亭下维舟处，水落江空夜雪残。\n记得长官邀我醉，县衙当面玉为山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴四首 其三","author":"苏泂","text":"兰佩其如楚客悲，年年谁作感秋辞。\n不应白骨苍苔后，更爱西风落叶时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"苏泂","text":"秋衾薄薄换吴绫，灯焰无多一半青。\n却忆旧时荆楚岸，夜深风雨泊船听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"苏泂","text":"满地秋声鼓吹同，草根无赖更寒蛩。\n情知万事终摇落，忍见霜林一叶红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人韵 其一","author":"苏泂","text":"时事纷纷一笑中，卧看墙外石榴红。\n谁怜楚客当年意，与把离骚继国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次友人韵 其二","author":"苏泂","text":"先生休恨易俱东，弟子方欣色笑同。\n早晚朝廷议恢复，请看裴度在军中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵九兄秋吟五首 其五","author":"苏泂","text":"江平无意作波澜，野旷山多入画栏。\n一段秋吟到幽渺，回头三伏也风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵九兄秋吟五首 其四","author":"苏泂","text":"为爱秋风吹弊庐，忽然诗思满江湖。\n橙香梦泽团脐蟹，莼老吴江巨口鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵九兄秋吟五首 其三","author":"苏泂","text":"凉稻翻翻卧满畦，壶浆相劳各相携。\n村南有底连绵雨，一夜船高树叶齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵九兄秋吟五首 其二","author":"苏泂","text":"醉挽银河续寿杯，冰娥亦怕老相催。\n三更自倚秋香立，待得灵㕙送药来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵九兄秋吟五首 其一","author":"苏泂","text":"不于乌鹊桥边见，定向笙箫鹤上逢。\n淅淅萧萧到荷叶，今年秋不属梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父上巳日同游朱园四首 其四","author":"苏泂","text":"柳长沙白草离离，万物东南渐絜齐。\n自折桃花玩春水，人生修短总成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父上巳日同游朱园四首 其三","author":"苏泂","text":"饮散墦间祭肉残，林深终日闭幽兰。\n重来野客朱邢我，坐久摩挲马柱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父上巳日同游朱园四首 其二","author":"苏泂","text":"野水青山非昔祠，奠觞那复计醇醨。\n抛梁有咏谁其续，除却灵均世不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刍父上巳日同游朱园四首 其一","author":"苏泂","text":"朱园好在竹平安，地主相携到不难。\n记取今年修禊日，三人于此向风湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕清父录参","author":"苏泂","text":"雨脚如麻数日悬，家贫上漏复旁穿。\n天工却与人争气，赐得青苔百万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵邢季允梅花","author":"苏泂","text":"怀想西湖一树冰，有谁人似此花清。\n何当共泛波微绿，更得同看月正盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵知县兄","author":"苏泂","text":"露坐仙人餐沆瀣，水行渔父烛须眉。\n民间阖户纷纷是，如此清凉睡不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵知县兄秋怀三首 其三","author":"苏泂","text":"灵均心事少陵诗，青竹林边白竹篱。\n自把寒花看新雁，今年强似去年衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵知县兄秋怀三首 其二","author":"苏泂","text":"秋花秋水两相宜，白发于秋更有期。\n三十年来无世味，清修除是老僧知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵知县兄秋怀三首 其一","author":"苏泂","text":"便腹应难饱以书，今年田谷未宽纾。\n朋从相过无祗待，自起园中摘我蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其七","author":"苏泂","text":"贫甚谁传辟谷方，闭门饮水自徜徉。\n无求无欲无魔恼，月白庭空一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其六","author":"苏泂","text":"山外情知更有山，几多突兀共巑岏。\n一从梦到天坛后，转觉丘陵不足看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其五","author":"苏泂","text":"忽然镜里一丝丝，老却英雄不自知。\n夜半闲来看青史，百年有尽此身危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其四","author":"苏泂","text":"植立不徒当日计，颠冥忍受一饥驱。\n吟成拙赋何曾拙，唤作愚溪岂是愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其三","author":"苏泂","text":"幸是安心无可病，不曾为米底须归。\n养成乳鹿充神驾，散拾残云补道衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其二","author":"苏泂","text":"客醉如何我独醒，山空时落涧泉声。\n年来不踏长安市，赢得诗书一味清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵去华提干夏日杂兴七首 其一","author":"苏泂","text":"老子轩冕总相忘，归办芙蓉制作裳。\n多少隐沦天下士，无人知我亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟耕堂杂兴六首 其六","author":"苏泂","text":"珍重新来十绝诗，末章砥柱不能移。\n因思唐代诸公子，故少撞钟得意时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟耕堂杂兴六首 其五","author":"苏泂","text":"已芸何似与人芸，水旱螟蝗不可闻。\n必欲糠粞饱鸡鹜，明年余作劝农文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟耕堂杂兴六首 其四","author":"苏泂","text":"莫怪庞公不入城，都缘无事可牵萦。\n客来遇酒饮何害，客去投床梦亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟耕堂杂兴六首 其三","author":"苏泂","text":"吴蜀归来兴寄遐，天将清气与贫家。\n双双蝶舞宜男草，个个蜂衔附子花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟耕堂杂兴六首 其二","author":"苏泂","text":"缭绕州城带雨长，雨馀云气亦飞扬。\n小楼别有幽欣处，时复风吹荷叶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵颍叟弟耕堂杂兴六首 其一","author":"苏泂","text":"莫求名字满乡闾，且读平生万卷书。\n青箬笠边无不可，黄金带后欲何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵詹仲信梅花","author":"苏泂","text":"莫教一片复随波，月底风前许细哦。\n花与吾人本无负，吾人自负此花多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江头曲","author":"苏泂","text":"青山何似越山青，年少经行得老生。\n欲结茅庵江上住，却嫌山水太分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江次","author":"苏泂","text":"舟阁山横水见沙，黄尘为客鬓初华。\n江春寂寂归无计，一树临风落杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅 其一","author":"苏泂","text":"游仙一曲梦初回，依旧江南鼎鼐才。\n岁晚应嫌太孤寂，未妨随俗引三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅 其四","author":"苏泂","text":"空墙碧水芳菲处，泣尽胭脂恨不销。\n不遣二妃陪舜葬，故应泪沁雪枝条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅 其三","author":"苏泂","text":"等观非白亦非红，开落那知色自空。\n落叶成阴花又子，几将心事托东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅 其二","author":"苏泂","text":"天与清高孰我过，岁寒只合老岩阿。\n无端自学闲桃杏，只恐情多事亦多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自判此生非醉杀则睡杀耳未知天公肯见容否作续醉睡句 其一","author":"苏泂","text":"采石江边踏鲤鱼，华山县里自骑驴。\n世间非醉亦非睡，白堕黄粱莫笑渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自判此生非醉杀则睡杀耳未知天公肯见容否作续醉睡句 其二","author":"苏泂","text":"兀兀蘧蘧也大奇，眼花花处蝶飞飞。\n先生饱惯人间事，只么残年是解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中 其二","author":"苏泂","text":"小睡醒来欲二更，村深那听鼓钟声。\n舟中反覆无穷事，只道寒天不会明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中 其一","author":"苏泂","text":"夜色随人上小舟，舟中攲枕梦悠悠。\n桡歌听得偏幽怨，不觉天明到越州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"苏泂","text":"一叶舟中宿，风高浪亦高。\n回头人世事，真觉细如毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行宫","author":"苏泂","text":"先帝乘龙厌九州，行宫花柳不胜愁。\n伤心更有秦淮水，故绕宫墙日夜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西兴渡口雪","author":"苏泂","text":"岸侧枯杨卧玉龙，卸残鳞甲趁天风。\n明年更作垂垂绿，会率莺花入汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西百官宅池上诗","author":"苏泂","text":"一架荼蘼覆水开，游鱼架底自徘徊。\n如何知道人来看，故触流花去不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖早秋","author":"苏泂","text":"明知有热不多时，可喜秋清又可悲。\n四十九年蘧伯玉，西湖一阵桂风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过馀姚","author":"苏泂","text":"柔橹轻飞过别滩，老夫吹帽受风寒。\n江流屈曲如蛇转，赢得青林四面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金陵四首 其四","author":"苏泂","text":"高资店里主人婆，万福官人问讯和。\n安稳在家能几日，别时不似见时多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金陵四首 其三","author":"苏泂","text":"飞鸿渺渺衬蒹葭，蓼岸红饶小穗花。\n此是秋光最佳处，江湖何处不思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金陵四首 其二","author":"苏泂","text":"老树前头柿叶红，又骑瘦马立西风。\n江山未必侬能认，却被江山认得侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金陵四首 其一","author":"苏泂","text":"豆田无数老鸦飞，枣熟菰香稻子垂。\n未说前年那有此，今年还似去年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"苏泂","text":"秋风凉冷自天生，瘦骨吹来便觉轻。\n数日因忙偏蹉事，不知庭户减蝉鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈永老","author":"苏泂","text":"衲子心情处士衣，今年参到地无锥。\n江乡一棹闲来往，只有明州数首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈许从道省元","author":"苏泂","text":"都城握手意弥温，少小追随莫更论。\n一别江湖重十载，偶然相见欲无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巫山峡","author":"苏泂","text":"山木无端又一秋，夕阳和影上扁舟。\n旧时十二峰前路，惟是猿声共客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"报宁寺 其一","author":"苏泂","text":"相业平时既讲明，得君当国有难能。\n周公礼乐寥寥意，馀子随时未可憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"报宁寺 其二","author":"苏泂","text":"为爱先生所赋诗，半生参学老犹迷。\n如今数卷钟山草，步步相随处处携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更赋一首","author":"苏泂","text":"纸阁新糊拥乱书，青灯依旧照诗癯。\n隔城经月疏相见，却忆金陵瞌睡图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜字","author":"苏泂","text":"望帝城中住，春宵血沁花。\n何乡真万里，还忆梦中家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"穷","author":"苏泂","text":"已著风帆似马奔，雪花无数入船门。\n诗穷到处无医治，愁绝湘江浸楚魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花月二首 其二","author":"苏泂","text":"金英玉树斗玲珑，九十秋光聚此中。\n人世等闲诸热恼，一时消杀付虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花月二首 其一","author":"苏泂","text":"月边那复有炎光，望月疏花意已凉。\n吴质不须仍倚树，老来无柰许多香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花槛","author":"苏泂","text":"石榴窗下乱红堆，借宅今年适此来。\n知是主人知是客，亦逢时节自花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"足赵丈句 其一","author":"苏泂","text":"跨湖楼好客闲行，身远红尘步亦轻。\n月在波心流不去，蒹葭影里一舟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"足虞叟兄句 其二","author":"苏泂","text":"云里仙人不解愁，人间肺渴望凉瘳。\n更深倚杖前除立，一见银河认得秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"足虞叟兄句 其一","author":"苏泂","text":"六月还当月尽休，今年节令却齐头。\n萧萧不待听梧叶，一见银河认得秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到马塍哭尧章 其二","author":"苏泂","text":"南宫垂上鬓星星，毕竟襕衫不肯青。\n除却乐书谁殉葬，一琴一砚一兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到马塍哭尧章 其一","author":"苏泂","text":"初闻讣告一场悲，写尽心肝在挽词。\n今日亲来见灵柩，对君妻子但如痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到马塍哭尧章 其四","author":"苏泂","text":"儿年十七未更事，曷日文章能世家。\n赖是小红渠已嫁，不然啼碎马塍花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到马塍哭尧章 其三","author":"苏泂","text":"花桉空空但满尘，乐章起草遍窗身。\n孺人侍妾相持泣，安得君归更肃宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周家步","author":"苏泂","text":"儿时下上老翁家，常记维舟岸有沙。\n今日沙移吾亦壮，此翁居处只桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]